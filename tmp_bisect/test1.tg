# Tangerine Standard Library — std::test
# Full unit testing framework with runner, discovery, filtering, and output.

use std::core::{Option, Result, Vec, String, Bool, Int, panic}
use std::collections::{Map}
use std::io::{print, println, eprintln}
use std::time::{Instant, Duration, instant_now, duration_between}
use std::env::{get_env}
use std::backtrace::{capture as capture_backtrace, Backtrace}

# ———————————————————————————————————————————————————————————————
# Assertions
# ———————————————————————————————————————————————————————————————

def assert_eq[T](a: T, b: T) -> Unit
  # Compiler intrinsic: compare two values, panic if not equal
  if a != b then
    panic("assertion failed: `assert_eq!`\n  left:  `" + a.to_string() + "`\n  right: `" + b.to_string() + "`")
  end
end

def assert_ne[T](a: T, b: T) -> Unit
  # Compiler intrinsic: compare two values, panic if equal
  if a == b then
    panic("assertion failed: `assert_ne!`\n  both sides equal: `" + a.to_string() + "`")
  end
end

def assert(cond: Bool, msg: String) -> Unit
  if !cond then
    panic("assertion failed: " + msg)
  end
end

def assert_true(cond: Bool) -> Unit
  assert(cond, "expected true, got false")
end

def assert_false(cond: Bool) -> Unit
  assert(!cond, "expected false, got true")
end

def assert_some[T](opt: Option[T]) -> T
  match opt
  when Option::Some(v) then v
  when Option::None then
    panic("assertion failed: expected Some, got None")
  end
end

def assert_none[T](opt: Option[T]) -> Unit
  match opt
  when Option::Some(_) then
    panic("assertion failed: expected None, got Some")
  when Option::None then ()
  end
end

def assert_ok[T, E](result: Result[T, E]) -> T
  match result
  when Result::Ok(v) then v
  when Result::Err(e) then
    panic("assertion failed: expected Ok, got Err(" + e.to_string() + ")")
  end
end

def assert_err[T, E](result: Result[T, E]) -> E
  match result
  when Result::Ok(_) then
    panic("assertion failed: expected Err, got Ok")
  when Result::Err(e) then e
  end
end

def assert_approx_eq(a: Float, b: Float, epsilon: Float) -> Unit
  let diff = if a > b then a - b else b - a end
  if diff > epsilon then
    let msg = "assertion failed: `assert_approx_eq!`\n  left:  `"
      + a.to_string() + "`\n  right: `" + b.to_string()
      + "`\n  epsilon: " + epsilon.to_string()
      + "\n  diff: " + diff.to_string()
    panic(msg)
  end
end

def assert_contains(haystack: String, needle: String) -> Unit
  if !haystack.contains(needle) then
    panic("assertion failed: expected string to contain `" + needle + "`\n  string: `" + haystack + "`")
  end
end

def assert_starts_with(s: String, prefix: String) -> Unit
  if !s.starts_with(prefix) then
    panic("assertion failed: expected string to start with `" + prefix + "`\n  string: `" + s + "`")
  end
end

def assert_panics(f: || -> Unit) -> String
  match catch_panic(f)
  when Option::Some(msg) then msg
