## examples/gpu_triangle.tg — Minimal GPU triangle rendering example
## Demonstrates the std::gpu abstraction with auto-detected backend.
## Run: tg run examples/gpu_triangle.tg

use std::gpu::{
  GpuInstance, Backend, GpuDevice, GpuQueue,
  Surface, Swapchain, PresentMode,
  ShaderModule, ShaderSource,
  RenderPipeline, RenderPipelineDesc,
  CommandEncoder, RenderPassEncoder, RenderPassDesc,
  ColorAttachment, LoadOp, StoreOp, Color,
  TextureFormat, VertexFormat, PrimitiveTopology,
  VertexBufferLayout, VertexAttribute,
  GpuBuffer, BufferUsage,
}
use std::linalg::{Vec2, Vec3, Vec4, Mat4}
use std::gfx_window::{Window, WindowConfig, EventLoop, Event}

# ─── Vertex Data ─────────────────────────────────────────────────────

struct Vertex
  position: Vec2
  color: Vec3
end

const TRIANGLE_VERTICES: [Vertex; 3] = [
  Vertex { position: Vec2.new( 0.0,  0.5), color: Vec3.new(1.0, 0.0, 0.0) },  ## Top - red
  Vertex { position: Vec2.new(-0.5, -0.5), color: Vec3.new(0.0, 1.0, 0.0) },  ## Bottom-left - green
  Vertex { position: Vec2.new( 0.5, -0.5), color: Vec3.new(0.0, 0.0, 1.0) },  ## Bottom-right - blue
]

# ─── Shader Source ───────────────────────────────────────────────────

const SHADER: &str = """
struct VertexInput {
  @location(0) position: vec2<f32>,
  @location(1) color: vec3<f32>,
}

struct VertexOutput {
  @builtin(position) clip_position: vec4<f32>,
  @location(0) color: vec3<f32>,
}

@vertex
fn vs_main(in: VertexInput) -> VertexOutput {
  var out: VertexOutput;
  out.clip_position = vec4<f32>(in.position, 0.0, 1.0);
  out.color = in.color;
  return out;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
  return vec4<f32>(in.color, 1.0);
}
"""

# ─── Main ────────────────────────────────────────────────────────────

def main() -> Result[Unit, Error]
  ## 1. Create window
  let window_config = WindowConfig {
    title: "Tangerine GPU Triangle".to_string(),
    width: 800,
    height: 600,
    resizable: true,
  }
  let (window, event_loop) = Window.new(window_config)?

  ## 2. Initialize GPU with auto-detected backend
  let instance = GpuInstance.new(Backend.Auto)?
  let surface = instance.create_surface(&window)?
  let adapter = instance.request_adapter(Some(&surface)).await?

  let info = adapter.info()
  println("GPU: {} ({:?})", info.name, info.device_type)
  println("Backend: {:?}", info.backend)

  let (device, queue) = adapter.request_device(None).await?

  ## 3. Create swapchain
  let format = TextureFormat.Bgra8Unorm
  var swapchain = device.create_swapchain(&surface, 800, 600, format, PresentMode.Fifo)?

  ## 4. Compile shader
  let shader = device.create_shader_module(ShaderSource.Wgsl(SHADER))?

  ## 5. Create render pipeline
  let pipeline = device.create_render_pipeline(RenderPipelineDesc {
    vertex_shader: &shader,
    vertex_entry: "vs_main",
    fragment_shader: Some(&shader),
    fragment_entry: Some("fs_main"),
    vertex_buffers: &[
      VertexBufferLayout {
        stride: 20,  ## 2 floats (pos) + 3 floats (color) = 5 * 4 = 20 bytes
        attributes: &[
          VertexAttribute { format: VertexFormat.Float32x2, offset: 0,  location: 0 },
          VertexAttribute { format: VertexFormat.Float32x3, offset: 8,  location: 1 },
        ],
      },
    ],
    primitive: PrimitiveTopology.TriangleList,
    color_targets: &[format],
    depth_stencil: None,
    multisample_count: 1,
  })?

  ## 6. Upload vertex data
  let vertex_buffer = device.create_buffer_init(
    &TRIANGLE_VERTICES,
    BufferUsage.Vertex,
  )?

  ## 7. Render loop
  println("Rendering... (close window to exit)")
  var running = true

  event_loop.run(move |event|
    match event
      Event.WindowClose => running = false

      Event.WindowResize { width, height } =>
        if width > 0 && height > 0 then
          swapchain = device.create_swapchain(&surface, width, height, format, PresentMode.Fifo).unwrap()
        end

      Event.RedrawRequested =>
        let frame = match swapchain.acquire_next_image()
          Ok(f) => f
          Err(_) => return  ## Skip frame on swapchain error
        end

        let mut encoder = device.create_command_encoder().unwrap()

        ## Begin render pass
        {
          let mut pass = encoder.begin_render_pass(&RenderPassDesc {
            color_attachments: &[ColorAttachment {
              view: &frame.view,
              load: LoadOp.Clear(Color { r: 0.05, g: 0.05, b: 0.08, a: 1.0 }),
              store: StoreOp.Store,
            }],
            depth_attachment: None,
          })

          pass.set_pipeline(&pipeline)
          pass.set_vertex_buffer(0, &vertex_buffer)
          pass.draw(0..3, 0..1)
        }   ## RenderPassEncoder dropped here, ending the pass

        queue.submit(&[encoder.finish().unwrap()])
        swapchain.present(frame).unwrap()

      _ => ()
    end

    if !running then event_loop.exit() end
  end)

  println("Goodbye!")
  Ok(())
end
