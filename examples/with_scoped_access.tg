## ---------------------------------------------------------------
## examples/with_scoped_access.tg — audit P1-1: scoped-access `with`
## Syntax-level specimen for the block-bound access statement
## (`with <expr> as let <name>` / `with <expr> as inout <name>`).
##
## The first-pass surface: `as let` binds a READ access (projected
## mutation is rejected in the body), `as inout` binds a READ/WRITE access
## whose fallthrough write-back the lowering emits. Both forms require a
## Copy (non-owning) access value in this pass.
##
## The container half of the audit: the source of the access may be a
## MAP-ENTRY ACCESSOR call on the std Map (std/collections.tg):
##     `with map.get_read(key) as let value ...`  — the READ side (the key
##       needs only Hash + Eq — String keys work — the value type must be
##       Copy);
##     `with map.get_modify(key) as inout value ...`  — the READ/WRITE
##       side (the block mutates the snapshot and the machinery writes it
##       back into the entry under the same key; both the key and the
##       value must be Copy in the first pass). A missing entry TRAPS in
##       the accessor body.
## The closure forms (Map::with_value / with_value_mut) are NOT
## expressible: a closure parameter cannot carry the let/inout access
## conventions — documented as a TODO beside the std accessors and in
## tg_compiler/types.tg's StmtWith arm.
##
## It is a syntax-level specimen only: it is deliberately NOT wired into
## any gate.
## ---------------------------------------------------------------

use std::core::{Option}
use std::collections::{Map}

## A plain Copy value type: the first-pass checker accepts with-scoped
## access over Copy (non-owning) values only.
struct Level
  qty: Int
  tag: Int
end

struct Order
  id: Int
  total: Int
end

## Read side: the bound name is a read-only access to the value; the
## block ends at `end` and the name does not exist afterwards.
def process_order(order: Order) -> Int
  order.id + order.total
end

## A container-shaped struct holding the places the with-blocks bind to.
struct Book
  level: Level
end

impl Book
  ## `as inout` requires the expression to be a simple place/accessor in
  ## the first pass. The access value itself is never first-class: the
  ## body mutates it through its fields (here a field of the access) but
  ## may not store/rebind the access name.
  def bump_qty(inout self) -> Level
    with self.level as inout lvl
      lvl.qty = lvl.qty + 1
    end
    self.level
  end

  def adjust(inout self, delta: Int) -> Level
    with self.level as inout lvl
      lvl.qty = lvl.qty + delta
    end
    self.level
  end
end

# ———————————————————————————————————————————————————————————————
# The container half: Map-entry accessor sources. `get_modify` reads the
# entry snapshot on block entry and the lowering writes the (possibly
# mutated) snapshot back into the entry under the same key on the block's
# fallthrough exit. Compound assignment (`level.qty += delta`) is not yet
# accepted by the checker snapshot, so the canonical `level.qty = level.qty
# + delta` spelling is used — the same spelling as Book::bump_qty above.
def bump_quote(inout quotes: Map[Int, Level], key: Int, delta: Int) -> Level
  with quotes.get_modify(key) as inout level
    level.qty = level.qty + delta
  end
  let after = quotes.get(key)
  match after
  when Option::Some(v) then v
  when Option::None then Level { qty: -1, tag: -1 }
  end
end

def main()
  let order = Order { id: 7, total: 3 }
  with order as let entry
    let sum = process_order(entry)
    println("order total: " + sum.to_string())
  end

  var book = Book { level: Level { qty: 1, tag: 9 } }
  let after = book.bump_qty()
  println("after bump: " + after.qty.to_string())

  let adjusted = book.adjust(5)
  println("after adjust: " + adjusted.qty.to_string())

  # —————————————————————————————————————————————————————————————
  # Container half (audit P1-1): Map-entry accessor sources.
  #
  # `with orders.get_read(symbol) as let entry` — the READ-side accessor:
  # the key needs only Hash + Eq (an owned String key works); the bound
  # name is a read-only snapshot of the entry.
  var orders = Map::new()
  orders.insert("aapl", Order { id: 1, total: 900 })
  let symbol = "aapl"
  with orders.get_read(symbol) as let entry
    let grand = process_order(entry)
    println("read " + symbol + " totals " + grand.to_string())
  end

  # `with quotes.get_modify(key) as inout level` — the MODIFY-side
  # accessor: the block mutates the snapshot through its fields and the
  # machinery writes the snapshot back into the map entry under the same
  # key when the block falls through. The first pass requires a Copy key
  # (K: Hash + Eq + Copy on Map::get_modify) and a Copy value.
  var quotes = Map::new()
  quotes.insert(11, Level { qty: 2, tag: 9 })
  let bumped = bump_quote(quotes, 11, 4)
  println("after map bump: qty " + bumped.qty.to_string() + ", tag " + bumped.tag.to_string())
end
