## ---------------------------------------------------------------
## examples/widget_gallery.tg — Reference: UI widget gallery app
## Non-blocking validation aid per §29
## ---------------------------------------------------------------

use std::app
use std::gfx
use std::geom
use std::ui_toolkit
use std::accessibility

## Widget gallery — exercises each built-in widget type in a simple layout.
## Smoke test only; feature coverage is in tests/.

struct GalleryApp
  done: Bool
end

impl App for GalleryApp
  def on_event(window: Window, event: Event) -> Nil
    match event
    when Event::Redraw
      let surface = window.surface()
      let canvas = surface.begin()
      canvas.clear(Color { r: 0.95, g: 0.95, b: 0.95, a: 1.0 })

      ## Paint a minimal widget gallery (visual only)
      let black = Paint::solid(Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 })
      let blue = Paint::solid(Color { r: 0.2, g: 0.4, b: 0.8, a: 1.0 })
      let gray = Paint::solid(Color { r: 0.7, g: 0.7, b: 0.7, a: 1.0 })

      ## Button
      canvas.draw_rrect(RRect { x: 10.0, y: 10.0, width: 100.0, height: 30.0, radius: 4.0 }, blue)

      ## Checkbox area
      canvas.draw_rect(Rect { x: 10.0, y: 50.0, width: 16.0, height: 16.0 }, black)

      ## Slider track
      canvas.draw_rect(Rect { x: 10.0, y: 80.0, width: 200.0, height: 4.0 }, gray)
      canvas.draw_circle(24.0, 82.0, 8.0, blue)

      ## Text input box
      canvas.draw_rect(Rect { x: 10.0, y: 100.0, width: 200.0, height: 28.0 }, gray)

      surface.present()
      self.done = true
    when Event::CloseRequested
      self.done = true
    else
      ## ignore
    end
  end
end

def main() -> Nil
  let opts = AppOpts {
    title: "Widget Gallery",
    width: 400u32,
    height: 300u32,
    resizable: true,
  }
  let app = GalleryApp { done: false }
  let sw = SoftwareApp.new()
  sw.run(opts, app)
end

test "widget_gallery smoke" do
  let app = GalleryApp { done: false }
  assert !app.done
end
