## examples/embedded_blinky.tg — Minimal embedded blinky example
## Target: ARM Cortex-M4 (STM32F4 Discovery board)
## Build: tg build --target thumbv7em-none-eabihf --release

use std::embedded::{
  PanicStrategy, volatile_read, volatile_write, volatile_modify,
  Register, critical_section,
  hal::{GpioPin, GpioMode, GpioState},
}

# ─── Board Constants ─────────────────────────────────────────────────

## STM32F407 register addresses
const RCC_AHB1ENR: *mut u32 = 0x4002_3830 as *mut u32
const GPIOD_MODER: *mut u32 = 0x4002_0C00 as *mut u32
const GPIOD_ODR:   *mut u32 = 0x4002_0C14 as *mut u32

## LED pins on STM32F4 Discovery: PD12 (green), PD13 (orange), PD14 (red), PD15 (blue)
const LED_GREEN:  u32 = 12
const LED_ORANGE: u32 = 13
const LED_RED:    u32 = 14
const LED_BLUE:   u32 = 15

# ─── Entry Point ─────────────────────────────────────────────────────

@[no_std]
@[entry]
def main() -> !
  ## Enable GPIOD clock
  volatile_modify(RCC_AHB1ENR, |v| v | (1 << 3))

  ## Configure PD12-PD15 as output (mode = 01)
  volatile_modify(GPIOD_MODER, |v|
    var r = v
    r = r & !(0x3 << (LED_GREEN * 2))  | (0x1 << (LED_GREEN * 2))
    r = r & !(0x3 << (LED_ORANGE * 2)) | (0x1 << (LED_ORANGE * 2))
    r = r & !(0x3 << (LED_RED * 2))    | (0x1 << (LED_RED * 2))
    r = r & !(0x3 << (LED_BLUE * 2))   | (0x1 << (LED_BLUE * 2))
    r
  )

  ## Blink pattern: rotate through all 4 LEDs
  var current_led: u32 = LED_GREEN
  loop
    ## Turn on current LED
    volatile_modify(GPIOD_ODR, |v| v | (1 << current_led))
    delay(500_000)

    ## Turn off current LED
    volatile_modify(GPIOD_ODR, |v| v & !(1 << current_led))

    ## Advance to next LED
    current_led = match current_led
      LED_GREEN  => LED_ORANGE
      LED_ORANGE => LED_RED
      LED_RED    => LED_BLUE
      LED_BLUE   => LED_GREEN
      _          => LED_GREEN
    end
  end
end

# ─── Helpers ─────────────────────────────────────────────────────────

@[no_heap]
@[inline(never)]
def delay(count: u32)
  for _ in 0..count do
    volatile_read(0 as *const u32)  ## Prevent loop optimization
  end
end

@[panic_handler]
def panic_handler(info: &PanicInfo) -> !
  ## On panic, turn on red LED and halt
  volatile_modify(GPIOD_ODR, |v| v | (1 << LED_RED))
  loop end
end
