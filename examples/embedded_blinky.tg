## examples/embedded_blinky.tg — Minimal embedded blinky example
## Target: aarch64-unknown-none (the bare-metal target with real code
## generation; see tests/run_embedded_lane.sh and
## tests/embedded/embedded_blinky.tg for the lane program).
## Build: tg build examples/embedded_blinky.tg --target aarch64-unknown-none

@no_std

use std::core::{Unit, Bool, Int, UInt}
use std::embedded::{volatile_read32, volatile_write32, volatile_modify, PanicInfo, PanicStrategy}

# ─── Board register addresses (STM32F4 family) ──────────────────────

const RCC_AHB1ENR: UInt = 0x4002_3830
const GPIOD_MODER: UInt = 0x4002_0C00
const GPIOD_ODR:   UInt = 0x4002_0C14

## LED pins on STM32F4 Discovery: PD12 (green), PD13 (orange), PD14 (red), PD15 (blue)
const LED_GREEN:  u32 = 12
const LED_ORANGE: u32 = 13
const LED_RED:    u32 = 14
const LED_BLUE:   u32 = 15

# ─── Entry Point ─────────────────────────────────────────────────────

## The user main, called by std::embedded's `_reset_handler` after the
## .bss zeroing and the .data copy. Every access below goes through the
## width-exact volatile arms (volatile_read32 / volatile_write32 /
## volatile_modify — observable, exactly-once loads/stores that the
## optimizer can neither elide nor merge).
def main() -> !
  ## Enable GPIOD clock (read-modify-write: one volatile load + one
  ## volatile store).
  volatile_modify(RCC_AHB1ENR, |v| v | (1u32 << 3))

  ## Configure PD12-PD15 as output (mode = 01).
  volatile_modify(GPIOD_MODER, |v|
    var r = v
    r = r & !(0x3 << (LED_GREEN * 2))  | (0x1 << (LED_GREEN * 2))
    r = r & !(0x3 << (LED_ORANGE * 2)) | (0x1 << (LED_ORANGE * 2))
    r = r & !(0x3 << (LED_RED * 2))    | (0x1 << (LED_RED * 2))
    r = r & !(0x3 << (LED_BLUE * 2))   | (0x1 << (LED_BLUE * 2))
    r
  )

  ## Blink pattern: rotate through all 4 LEDs
  var current_led: u32 = LED_GREEN
  loop
    ## Turn on current LED
    volatile_modify(GPIOD_ODR, |v| v | (1u32 << current_led))
    delay(500_000)

    ## Turn off current LED
    volatile_modify(GPIOD_ODR, |v| v & !(1u32 << current_led))

    ## Advance to next LED
    current_led = match current_led
      LED_GREEN  => LED_ORANGE
      LED_ORANGE => LED_RED
      LED_RED    => LED_BLUE
      LED_BLUE   => LED_GREEN
      _          => LED_GREEN
    end
  end
end

# ─── Helpers ─────────────────────────────────────────────────────────


def delay(count: Int)
  var acc: u32 = 0
  for _ in 0..count do
    ## An observable volatile read keeps the delay loop alive (never
    ## elided by the optimizer).
    acc = acc + volatile_read32(0xE0000000)
  end
  let _ = acc
end


def blinky_panic(info: PanicInfo) -> !
  ## On panic, turn on the red LED and halt.
  volatile_modify(GPIOD_ODR, |v| v | (1u32 << LED_RED))
  loop { }
end
