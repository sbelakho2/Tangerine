## ---------------------------------------------------------------
## examples/hello_window.tg — Reference: minimal smoke-test app
## Non-blocking validation aid per §29
## ---------------------------------------------------------------

use std::app
use std::gfx
use std::geom

## Minimal reference application — opens a window, draws a colored
## rectangle, and exits after the first frame.  This is a smoke test
## only; comprehensive testing lives in tests/.

struct HelloApp
  done: Bool
end

impl App for HelloApp
  def on_event(window: Window, event: Event) -> Nil
    match event
    when Event::Redraw
      let surface = window.surface()
      let canvas = surface.begin()
      canvas.clear(Color { r: 0.2, g: 0.2, b: 0.3, a: 1.0 })
      let paint = Paint::solid(Color { r: 1.0, g: 0.6, b: 0.1, a: 1.0 })
      canvas.draw_rect(Rect { x: 50.0, y: 50.0, width: 200.0, height: 100.0 }, paint)
      surface.present()
      self.done = true
    when Event::CloseRequested
      self.done = true
    else
      ## ignore other events
    end
  end
end

def main() -> Nil
  let opts = AppOpts {
    title: "Hello Window",
    width: 400u32,
    height: 300u32,
    resizable: true,
  }
  let mut app = HelloApp { done: false }
  let sw = SoftwareApp.new()
  sw.run(opts, app)
end

## Minimal smoke test
test "hello_window smoke" do
  let app = HelloApp { done: false }
  assert !app.done
end
