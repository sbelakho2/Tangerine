## ---------------------------------------------------------------
## examples/text_demo.tg — Reference: text rendering app
## Non-blocking validation aid per §29
## ---------------------------------------------------------------

use std::app
use std::gfx
use std::geom
use std::text

## Reference text rendering application — loads a font, shapes text,
## and renders it to a window.  Smoke test only.

struct TextDemoApp
  done: Bool
end

impl App for TextDemoApp
  def on_event(window: Window, event: Event) -> Nil
    match event
    when Event::Redraw
      let surface = window.surface()
      let canvas = surface.begin()
      canvas.clear(Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })

      ## Shape and render text
      let db = FontDb.new()
      let result = db.load("sans-serif", 16.0)
      match result
      when Ok(font)
        let run = shape(font, "Hello, Tangerine!")
        let layout = layout(run, 380.0)
        let paint = Paint::solid(Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 })
        canvas.draw_text(layout, 10.0, 30.0, paint)
      when Err(_)
        ## Font not available — draw fallback rectangle
        let paint = Paint::solid(Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 })
        canvas.draw_rect(Rect { x: 10.0, y: 10.0, width: 100.0, height: 20.0 }, paint)
      end

      surface.present()
      self.done = true
    when Event::CloseRequested
      self.done = true
    else
      ## ignore
    end
  end
end

def main() -> Nil
  let opts = AppOpts {
    title: "Text Demo",
    width: 400u32,
    height: 200u32,
    resizable: true,
  }
  let app = TextDemoApp { done: false }
  let sw = SoftwareApp.new()
  sw.run(opts, app)
end

test "text_demo smoke" do
  let app = TextDemoApp { done: false }
  assert !app.done
end
