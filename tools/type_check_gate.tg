# Fast type-check gate: parses + type-checks the kernel only.
# Skips borrow check / MIR / codegen so iteration is fast (~15 min vs 90+).
# Usage: tg_stage0 compile tools/type_check_gate.tg -o /tmp/gate
#        /tmp/gate <file.tg>   (prints error count to stdout)

use std::core::{Option, Result, println, panic}
use std::args::{raw_arg_count, raw_arg_unchecked, raw_arg_copy}
use std::fs::{read_file}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::types::{type_check}

def main() -> Unit
  let path = if raw_arg_count() > 1 then raw_arg_copy(1) else "tg_compiler/driver.tg" end
  match read_file(path.clone())
  when Result::Ok(src) then
    let program = parse(&src, path.clone())
    if diag_has_errors(&program.diag) then
      println("GATE: parse errors")
      return
    end
    let errors = type_check(&program)
    println("GATE: type errors = " + errors.len().to_string())
  when Result::Err(e) then
    println("GATE: cannot read " + path)
  end
end
