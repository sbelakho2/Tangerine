{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.dev/schema/tgcov.schema.json",
  "title": "Tangerine Coverage Artifact (tgcov JSONL)",
  "description": "Line 1 is header object; lines 2..N are branch-arm hit records.",
  "type": "object",
  "required": [
    "schema_version",
    "edition",
    "tgc_version",
    "target",
    "target_triple",
    "branch_id_scheme",
    "arm_id_scheme",
    "build_id",
    "timestamp_utc"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "edition": { "type": "string" },
    "tgc_version": { "type": "string" },
    "target": { "type": "string" },
    "target_triple": { "type": "string" },
    "branch_id_scheme": { "type": "string" },
    "arm_id_scheme": { "type": "string" },
    "build_id": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "merged_from_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["symbol_id", "branch_id", "arm_id", "kind", "arm_index", "hits"],
      "properties": {
        "symbol_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "arm_id": { "type": "string" },
        "kind": { "type": "string" },
        "arm_index": { "type": "integer", "minimum": 0 },
        "hits": { "type": "integer", "minimum": 0 },
        "target_bb": { "type": "integer", "minimum": 0 },
        "span": {
          "type": "object",
          "required": ["file", "start", "end"],
          "properties": {
            "file": { "type": "string" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        "arm_span": {
          "type": "object",
          "required": ["file", "start", "end"],
          "properties": {
            "file": { "type": "string" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
