{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.dev/schema/cqs_quality.schema.json",
  "title": "Tangerine CQS Quality Report",
  "description": "§29/§42-47: Machine-readable quality report for CQS scoring",
  "type": "object",
  "required": ["schema_version", "summary", "modules"],
  "properties": {
    "schema_version": { "type": "string", "const": "cqs.v0.2" },
    "summary": {
      "type": "object",
      "required": ["mode", "target", "profile", "symbols_total", "symbols_gated", "gated_failures", "aggregate_score"],
      "properties": {
        "mode": { "type": "string", "enum": ["Dev", "Strict", "Production", "Hardened"] },
        "target": { "type": "string" },
        "profile": { "type": "string", "enum": ["backend", "cli", "ui", "library"] },
        "symbols_total": { "type": "integer", "minimum": 0 },
        "symbols_gated": { "type": "integer", "minimum": 0 },
        "gated_failures": { "type": "integer", "minimum": 0 },
        "aggregate_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "coverage_merged": { "type": "boolean" },
        "caps_baseline_hash": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "score", "symbols"],
        "properties": {
          "module": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "weight": { "type": "number", "minimum": 0, "description": "§41 surface-weighted module score" },
          "symbols": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["symbol", "surface", "score", "signals"],
              "properties": {
                "symbol": { "type": "string" },
                "surface": { "type": "string", "enum": ["public_stable", "public_experimental", "internal_hot_path", "internal_glue", "test_only", "platform_shim"] },
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "branch_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "severity", "penalty", "weight", "count"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["CF-1","CF-2","CF-3","CF-4","DF-1","DF-2","DF-3","DF-4","EH-1","EH-2","EH-3","CV-1","CV-2","CP-1","CP-2","CP-3","FT-1","FT-2"], "description": "Signal ID: CF-1..CF-4, DF-1..DF-4, EH-1..EH-3, CV-1..CV-2, CP-1..CP-3, FT-1..FT-2" },
                      "severity": { "type": "number", "minimum": 0, "maximum": 1 },
                      "penalty": { "type": "number", "minimum": 0 },
                      "weight": { "type": "number", "minimum": 0 },
                      "count": { "type": "integer", "minimum": 0 },
                      "suppressed": { "type": "boolean" },
                      "suppression_reason": { "type": "string" }
                    }
                  }
                },
                "suggested_actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["action_id", "priority", "title", "kind"],
                    "properties": {
                      "action_id": { "type": "string" },
                      "priority": { "type": "integer", "minimum": 1, "maximum": 4, "description": "1 = critical, 2 = high, 3 = medium, 4 = low" },
                      "title": { "type": "string" },
                      "kind": { "type": "string", "enum": ["add_test", "add_branch", "handle_error", "add_contract", "add_cap", "refactor"] },
                      "signal_ref": { "type": "string", "description": "Signal kind this action addresses" },
                      "estimated_score_gain": { "type": "number" },
                      "tests_to_run": { "type": "array", "items": { "type": "string" } },
                      "patch": {
                        "type": "object",
                        "properties": {
                          "file": { "type": "string" },
                          "line": { "type": "integer" },
                          "snippet": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "description": "§27 enforcement actions taken",
      "properties": {
        "gate_result": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string" },
              "reason": { "type": "string" },
              "threshold": { "type": "number" },
              "actual": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
