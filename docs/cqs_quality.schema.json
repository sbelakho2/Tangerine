{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.dev/schema/cqs_quality.schema.json",
  "title": "Tangerine CQS Quality Report",
  "type": "object",
  "required": ["schema_version", "summary", "modules"],
  "properties": {
    "schema_version": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["mode", "target", "symbols_total", "gated_failures"],
      "properties": {
        "mode": { "type": "string" },
        "target": { "type": "string" },
        "symbols_total": { "type": "integer", "minimum": 0 },
        "gated_failures": { "type": "integer", "minimum": 0 }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "score", "symbols"],
        "properties": {
          "module": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "symbols": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["symbol", "surface", "score", "signals"],
              "properties": {
                "symbol": { "type": "string" },
                "surface": { "type": "string" },
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "severity", "penalty"],
                    "properties": {
                      "kind": { "type": "string" },
                      "severity": { "type": "number", "minimum": 0, "maximum": 1 },
                      "penalty": { "type": "number", "minimum": 0 }
                    }
                  }
                },
                "suggested_actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["action_id", "priority", "title"],
                    "properties": {
                      "action_id": { "type": "string" },
                      "priority": { "type": "string" },
                      "title": { "type": "string" },
                      "tests_to_run": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
