{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.dev/schema/ctxpack.schema.json",
  "title": "Tangerine Context Pack",
  "description": "§91-103: ctxpack.json formal schema for agent consumption",
  "type": "object",
  "required": ["schema_version", "tangerine", "pack", "inputs", "budgets", "graphs", "selection", "items", "proof"],
  "properties": {
    "schema_version": { "type": "string", "const": "ctxpack.v0.2" },
    "tangerine": {
      "type": "object",
      "description": "§92 Toolchain identity",
      "required": ["edition", "tgc_version", "tg_version", "target"],
      "properties": {
        "edition": { "type": "string" },
        "tgc_version": { "type": "string" },
        "tg_version": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "pack": {
      "type": "object",
      "description": "§93 Pack identity and determinism info",
      "required": ["pack_id", "created_utc", "profile", "mode", "determinism"],
      "properties": {
        "pack_id": { "type": "string", "description": "SHA256 of canonical inputs" },
        "created_utc": { "type": "string", "format": "date-time" },
        "profile": { "type": "string", "enum": ["backend", "cli", "ui", "library"] },
        "mode": { "type": "string", "enum": ["Dev", "Strict", "Production", "Hardened"] },
        "determinism": {
          "type": "object",
          "required": ["sort_order", "hash_scheme", "branch_id_scheme", "arm_id_scheme"],
          "properties": {
            "sort_order": { "type": "string", "const": "lexicographic" },
            "hash_scheme": { "type": "string", "const": "sha256" },
            "branch_id_scheme": { "type": "string" },
            "arm_id_scheme": { "type": "string" }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "§94 Query and seed symbols",
      "required": ["query", "seed_symbols"],
      "properties": {
        "query": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "type": "string", "enum": ["compile_error", "failing_test", "cqs_gate", "manual"] },
            "value": { "type": "string" },
            "primary_spans": { "type": "array", "items": { "type": "object" } }
          }
        },
        "seed_symbols": { "type": "array", "items": { "type": "string" }, "description": "Stable-sorted lexicographically" },
        "index": {
          "type": "object",
          "properties": {
            "symbol_graph_id": { "type": "string" },
            "sdg_id": { "type": "string" },
            "coverage_id": { "type": "string" },
            "caps_baseline_id": { "type": "string" }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "description": "§95 Budget constraints",
      "required": ["unit", "total", "summaries", "code", "used"],
      "properties": {
        "unit": { "type": "string", "const": "CU", "description": "1 CU = 4 bytes UTF-8" },
        "total": { "type": "integer", "minimum": 0 },
        "summaries": { "type": "integer", "minimum": 0 },
        "code": { "type": "integer", "minimum": 0 },
        "used": {
          "type": "object",
          "required": ["total", "summaries", "code"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "summaries": { "type": "integer", "minimum": 0 },
            "code": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "graphs": {
      "type": "object",
      "description": "§96 Graph metadata",
      "properties": {
        "edge_costs": {
          "type": "object",
          "properties": {
            "call": { "type": "number" },
            "type_use": { "type": "number" },
            "trait": { "type": "number" },
            "effect": { "type": "number" },
            "test": { "type": "number" },
            "file": { "type": "number" }
          }
        },
        "radius_caps": { "type": "object", "additionalProperties": { "type": "number" } },
        "limits": {
          "type": "object",
          "properties": {
            "max_candidate_symbols": { "type": "integer" },
            "max_expanded_edges": { "type": "integer" },
            "max_seeds": { "type": "integer" }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "description": "§97 Selection model parameters",
      "required": ["algorithm", "objective", "alpha", "k"],
      "properties": {
        "algorithm": { "type": "string", "const": "submodular_greedy_knapsack" },
        "objective": { "type": "string", "const": "weighted_need_coverage" },
        "alpha": { "type": "number", "minimum": 0 },
        "k": { "type": "integer", "minimum": 1 },
        "needs_profile": { "type": "string" },
        "weights": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "§98 Optional artifact references",
      "properties": {
        "quality_report_path": { "type": "string" },
        "merged_coverage_path": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "description": "§99 Selected context items",
      "items": {
        "type": "object",
        "required": ["item_id", "tier", "kind", "cost_cu", "covers", "why", "payload"],
        "properties": {
          "item_id": { "type": "string" },
          "tier": { "type": "string", "enum": ["S", "M", "L"] },
          "kind": {
            "type": "string",
            "enum": [
              "symbol_summary", "definition_span", "slice_span",
              "test_summary", "test_span",
              "trait_resolution_bundle", "capability_boundary_bundle",
              "taint_flow_bundle"
            ]
          },
          "cost_cu": { "type": "integer", "minimum": 0 },
          "covers": { "type": "array", "items": { "type": "string" } },
          "why": {
            "type": "object",
            "description": "§99.2 Audit trail",
            "required": ["seed_distance", "slice_membership", "marginal_gain"],
            "properties": {
              "seed_distance": {
                "type": "object",
                "properties": {
                  "min": { "type": "number" },
                  "avg": { "type": "number" },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "seed": { "type": "string" },
                        "dist": { "type": "number" },
                        "via": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "slice_membership": {
                "type": "object",
                "properties": {
                  "in_backward_slice": { "type": "boolean" },
                  "in_forward_slice": { "type": "boolean" },
                  "sdg_available": { "type": "boolean" },
                  "sdg_nodes": { "type": "array", "items": { "type": "integer" } }
                }
              },
              "marginal_gain": {
                "type": "object",
                "properties": {
                  "delta_f": { "type": "number" },
                  "delta_per_cu": { "type": "number" }
                }
              },
              "priority_tags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "payload": { "type": "string", "description": "JSON-encoded payload" }
        }
      }
    },
    "spans": {
      "type": "array",
      "description": "§100 Code excerpts",
      "items": {
        "type": "object",
        "required": ["span_ref", "file", "start", "end", "hash", "language", "text"],
        "properties": {
          "span_ref": { "type": "string" },
          "file": { "type": "string" },
          "start": { "type": "integer", "minimum": 0, "description": "Byte offset (UTF-8)" },
          "end": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string", "description": "SHA256 of text bytes" },
          "language": { "type": "string", "const": "tangerine" },
          "text": { "type": "string" }
        }
      }
    },
    "proof": {
      "type": "object",
      "description": "§101 Optimization proof and audit",
      "required": ["needs_universe", "candidates_considered", "selected_count", "objective_value"],
      "properties": {
        "needs_universe": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "weight", "category"],
            "properties": {
              "id": { "type": "string" },
              "weight": { "type": "number" },
              "category": { "type": "string" }
            }
          }
        },
        "candidates_considered": { "type": "integer", "minimum": 0 },
        "selected_count": { "type": "integer", "minimum": 0 },
        "objective_value": {
          "type": "object",
          "required": ["f_selected", "f_upper_bound"],
          "properties": {
            "f_selected": { "type": "number" },
            "f_upper_bound": { "type": "number" }
          }
        },
        "greedy_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "picked_item_id", "cost_cu", "delta_f", "delta_per_cu", "budget_remaining_cu"],
            "properties": {
              "step": { "type": "integer" },
              "picked_item_id": { "type": "string" },
              "cost_cu": { "type": "integer" },
              "delta_f": { "type": "number" },
              "delta_per_cu": { "type": "number" },
              "budget_remaining_cu": { "type": "integer" }
            }
          }
        },
        "trace_truncated": { "type": "boolean" },
        "truncation": {
          "type": "object",
          "properties": {
            "candidate_cap_hit": { "type": "boolean" },
            "edge_cap_hit": { "type": "boolean" },
            "seed_cap_hit": { "type": "boolean" }
          }
        }
      }
    }
  }
}
