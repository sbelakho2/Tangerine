{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.dev/schema/ctxpack.schema.json",
  "title": "Tangerine Context Pack",
  "type": "object",
  "required": ["schema_version", "tangerine", "pack", "inputs", "budgets", "graphs", "selection", "items", "proof"],
  "properties": {
    "schema_version": { "type": "string" },
    "tangerine": {
      "type": "object",
      "required": ["edition", "tgc_version"],
      "properties": {
        "edition": { "type": "string" },
        "tgc_version": { "type": "string" }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "created_at_utc", "hash"],
      "properties": {
        "id": { "type": "string" },
        "created_at_utc": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "inputs": { "type": "object" },
    "budgets": { "type": "object" },
    "graphs": { "type": "object" },
    "selection": { "type": "object" },
    "artifacts": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "payload", "why"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "payload": { "type": "object" },
          "why": {
            "type": "object",
            "required": ["needs", "utility", "cost_cu"],
            "properties": {
              "needs": { "type": "array", "items": { "type": "string" } },
              "utility": { "type": "number" },
              "cost_cu": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "start_byte", "end_byte"],
        "properties": {
          "file": { "type": "string" },
          "start_byte": { "type": "integer", "minimum": 0 },
          "end_byte": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["needs_universe", "selected_count", "objective_value"],
      "properties": {
        "needs_universe": { "type": "array", "items": { "type": "object" } },
        "selected_count": { "type": "integer", "minimum": 0 },
        "objective_value": { "type": "object" },
        "greedy_trace": { "type": "array", "items": { "type": "object" } },
        "truncation": { "type": "object" }
      }
    }
  }
}
