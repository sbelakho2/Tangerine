# ═══════════════════════════════════════════════════════════════
# §60 — Coverage Artifact Purpose & Properties
# ═══════════════════════════════════════════════════════════════

# Records branch-arm hits for CQS canonical branch points.
# Enables CV-1 and CV-2 signals.
# Stable cross-run comparisons.
# Branch arms only (not statement coverage).

# ═══════════════════════════════════════════════════════════════
# §61 — Artifact Identity & Location
# ═══════════════════════════════════════════════════════════════

# Default output: target/cqs/coverage/
# Default name: coverage.tgcov
# Per-test: coverage.<test_id>.tgcov

struct CoverageHeader
  schema_version: String      # "tgcov.v1"
  edition: String             # "2026"
  tgc_version: String         # "0.1.0"
  target: String              # target triple
  branch_id_scheme: String    # "tg.branch.v1"
  arm_id_scheme: String       # "tg.arm.v1"
  build_id: String            # hash of code + config + compiler
  timestamp_utc: String
end

def default_header(target: String, build_id: String) -> CoverageHeader
  CoverageHeader {
    schema_version: "tgcov.v1",
    edition: "2026",
    tgc_version: "0.1.0",
    target: target,
    branch_id_scheme: "tg.branch.v1",
    arm_id_scheme: "tg.arm.v1",
    build_id: build_id,
    timestamp_utc: "unknown".to_string()
  }
end

# ═══════════════════════════════════════════════════════════════
# §62 — Coverage Stable IDs
# ═══════════════════════════════════════════════════════════════

# §62.1 — Symbol IDs
# Format: sym:<module_path>::<name>#<stable_hash>
# Hash from (edition, module_path, symbol_name, signature_shape) — NOT from spans
def compute_symbol_id(edition: String, module_path: String, name: String, sig_shape: String) -> String
  let hash = sha256(edition + "|" + module_path + "|" + name + "|" + sig_shape)
  "sym:" + module_path + "::" + name + "#" + hash.slice(0, 8)
end

# §62.2 — Branch Point IDs
# Stable if MIR control structure semantically unchanged + same compiler/edition
# branch_id = SHA256("tg.branch.v1" ‖ sid ‖ bb ‖ ti ‖ kind)
def compute_stable_branch_id(symbol_id: String, bb: Int, term_index: Int, kind: String) -> String
  sha256("tg.branch.v1" + symbol_id + bb.to_string() + term_index.to_string() + kind)
end

# §62.3 — Arm IDs
# arm_id = SHA256("tg.arm.v1" ‖ branch_id ‖ arm_index ‖ target_bb)
# Ordering: Branch: 0=true, 1=false; SwitchInt: ascending; SwitchEnum: declaration order
def compute_stable_arm_id(branch_id: String, arm_index: Int, target_bb: Int) -> String
  sha256("tg.arm.v1" + branch_id + arm_index.to_string() + target_bb.to_string())
end

# ═══════════════════════════════════════════════════════════════
# §63 — Source Mapping
# ═══════════════════════════════════════════════════════════════

struct SourceMapping
  span: Option[Span]       # Origin match/if expression
  arm_span: Option[Span]   # Arm body (best-effort)
end

# ═══════════════════════════════════════════════════════════════
# §64 — Coverage File Format: tgcov (JSON Lines)
# ═══════════════════════════════════════════════════════════════

# Line 1: Header JSON object
# Lines 2..N: Record objects

struct CoverageRecord
  symbol_id: String
  branch_id: String
  arm_id: String
  kind: String           # "IfExpr", "MatchExpr", etc.
  arm_index: Int
  hits: Int
  span: Option[Span]
  arm_span: Option[Span]
  target_bb: Option[Int]
end

struct CoverageArtifact
  header: CoverageHeader
  records: Vec[CoverageRecord]
end

def new_artifact(target: String, build_id: String) -> CoverageArtifact
  CoverageArtifact {
    header: default_header(target, build_id),
    records: Vec::new()
  }
end

def add_record(inout artifact: CoverageArtifact, sink record: CoverageRecord) -> Unit
  artifact.records.push(record)
end

# Serialize to JSONL format
def serialize_tgcov(artifact: CoverageArtifact) -> String
  let lines = Vec::new()
  # Header line
  lines.push(serialize_header(&artifact.header))
  # Record lines
  for rec in artifact.records
    lines.push(serialize_record(rec))
  end
  lines.join("\n")
end

def json_escape(s: String) -> String
  mut result = String::new()
  for c in s.chars() do
    match c
    when '"' then result.push_str("\\\"")
    when '\\' then result.push_str("\\\\")
    when '\n' then result.push_str("\\n")
    when '\r' then result.push_str("\\r")
    when '\t' then result.push_str("\\t")
    when c then result.push(c)
    end
  end
  result
end

def serialize_header(h: CoverageHeader) -> String
  "{\"schema_version\":\"" + json_escape(&h.schema_version) +
  "\",\"edition\":\"" + json_escape(&h.edition) +
  "\",\"tgc_version\":\"" + json_escape(&h.tgc_version) +
  "\",\"target\":\"" + json_escape(&h.target) +
  "\",\"branch_id_scheme\":\"" + json_escape(&h.branch_id_scheme) +
  "\",\"arm_id_scheme\":\"" + json_escape(&h.arm_id_scheme) +
  "\",\"build_id\":\"" + json_escape(&h.build_id) +
  "\",\"timestamp_utc\":\"" + json_escape(&h.timestamp_utc) + "\"}"
end

def serialize_record(r: CoverageRecord) -> String
  "{\"symbol_id\":\"" + json_escape(&r.symbol_id) +
  "\",\"branch_id\":\"" + json_escape(&r.branch_id) +
  "\",\"arm_id\":\"" + json_escape(&r.arm_id) +
  "\",\"kind\":\"" + json_escape(&r.kind) +
  "\",\"arm_index\":" + r.arm_index.to_string() +
  ",\"hits\":" + r.hits.to_string() + "}"
end

# Parse a tgcov file from JSONL
def parse_tgcov(content: String) -> Result[CoverageArtifact, String]
  let lines = content.lines()
  if lines.is_empty()
    return Result::Err("Empty coverage file")
  end
  let header = parse_header(lines[0])?
  let records = Vec::new()
  for i in 1..lines.len() do
    if lines[i].trim().len() > 0
      let rec = parse_record(lines[i])?
      records.push(rec)
    end
  end
  Result::Ok(CoverageArtifact { header: header, records: records })
end

def parse_header(line: String) -> Result[CoverageHeader, String]
  # JSON parsing delegated to std::json
  let obj = json_parse(line)?
  Result::Ok(CoverageHeader {
    schema_version: obj.get_string("schema_version")?,
    edition: obj.get_string("edition")?,
    tgc_version: obj.get_string("tgc_version")?,
    target: obj.get_string("target")?,
    branch_id_scheme: obj.get_string("branch_id_scheme")?,
    arm_id_scheme: obj.get_string("arm_id_scheme")?,
    build_id: obj.get_string("build_id")?,
    timestamp_utc: obj.get_string("timestamp_utc")?
  })
end

def parse_record(line: String) -> Result[CoverageRecord, String]
  let obj = json_parse(line)?
  Result::Ok(CoverageRecord {
    symbol_id: obj.get_string("symbol_id")?,
    branch_id: obj.get_string("branch_id")?,
    arm_id: obj.get_string("arm_id")?,
    kind: obj.get_string("kind")?,
    arm_index: obj.get_int("arm_index")?,
    hits: obj.get_int("hits")?,
    span: Option::None,
    arm_span: Option::None,
    target_bb: Option::None
  })
end

# ═══════════════════════════════════════════════════════════════
# §65 — Instrumentation Rules
# ═══════════════════════════════════════════════════════════════

# §65.1 — Available in `tg test --coverage`, optional in `tg run --coverage`
# MUST NOT change program semantics.
# §65.2 — Thread safety: atomic increments or thread-local merge on exit
# §65.3 — Overhead control: may sample/compress

struct InstrumentationConfig
  enabled: Bool
  thread_safe: Bool     # Use atomic counters
  sample_rate: Float    # 1.0 = instrument all, 0.1 = 10% sampling
end

def default_instrumentation() -> InstrumentationConfig
  InstrumentationConfig {
    enabled: true,
    thread_safe: true,
    sample_rate: 1.0
  }
end

# Per-function hit counters
struct HitCounters
  counters: Map[String, Int]   # arm_id → hit count
end

def new_counters() -> HitCounters
  HitCounters { counters: Map::new() }
end

def increment(inout counters: HitCounters, sink arm_id: String) -> Unit
  let current = counters.counters.get(arm_id).unwrap_or(0)
  counters.counters.insert(arm_id, current + 1)
end

def get_hits(counters: HitCounters, arm_id: String) -> Int
  counters.counters.get(arm_id).unwrap_or(0)
end

# ═══════════════════════════════════════════════════════════════
# §66 — Merging Coverage Artifacts
# ═══════════════════════════════════════════════════════════════

# §66.1 — Merge operator: hits(arm_id) = hitsA + hitsB
# §66.2 — Merge only if edition, tgc_version, target, build_id, ID schemes all identical
# §66.3 — Output: same schema with summed hits

def merge_artifacts(a: CoverageArtifact, b: CoverageArtifact) -> Result[CoverageArtifact, String]
  # Validate compatibility
  if a.header.schema_version != b.header.schema_version
    return Result::Err("Schema version mismatch: " + a.header.schema_version + " vs " + b.header.schema_version)
  end
  if a.header.edition != b.header.edition
    return Result::Err("Edition mismatch")
  end
  if a.header.tgc_version != b.header.tgc_version
    return Result::Err("tgc_version mismatch")
  end
  if a.header.target != b.header.target
    return Result::Err("Target mismatch")
  end
  if a.header.build_id != b.header.build_id
    return Result::Err("build_id mismatch")
  end
  if a.header.branch_id_scheme != b.header.branch_id_scheme
    return Result::Err("branch_id_scheme mismatch")
  end
  if a.header.arm_id_scheme != b.header.arm_id_scheme
    return Result::Err("arm_id_scheme mismatch")
  end

  # Merge records by (symbol_id, arm_id) key
  let merged = Map::new()
  for rec in a.records
    let key = rec.symbol_id + "|" + rec.arm_id
    merged.insert(key, rec.clone())
  end
  for rec in b.records
    let key = rec.symbol_id + "|" + rec.arm_id
    match merged.get_mut(key)
    when Option::Some(existing) then
      existing.hits = existing.hits + rec.hits
    when Option::None then
      merged.insert(key, rec.clone())
    end
  end

  # Sort records lexicographically by (symbol_id, arm_id)
  let mut records = Vec::new()
  for v in merged.values() do
    records.push(v.clone())
  end
  records.sort_by(|a, b|
    if a.symbol_id != b.symbol_id
      a.symbol_id < b.symbol_id
    else
      a.arm_id < b.arm_id
    end
  )

  Result::Ok(CoverageArtifact {
    header: a.header.clone(),
    records: records
  })
end

# ═══════════════════════════════════════════════════════════════
# §67 — Computing Branch Coverage Ratio (Normative)
# ═══════════════════════════════════════════════════════════════

# Per function symbol:
#   arms_total = |A(s)| (all arm_ids expected by compiler)
#   arms_covered = count(arm where hit ≥ 1)
#   branch_ratio = arms_covered / arms_total (or 1 if total=0)
# This is the canonical ratio for CV-2.

struct CoverageRatio
  symbol_id: String
  arms_total: Int
  arms_covered: Int
  branch_ratio: Float
end

def compute_coverage_ratio(
  symbol_id: String,
  expected_arms: Vec[String],
  artifact: CoverageArtifact
) -> CoverageRatio
  let total = expected_arms.len()
  if total == 0 then
    return CoverageRatio {
      symbol_id: symbol_id,
      arms_total: 0,
      arms_covered: 0,
      branch_ratio: 1.0
    }
  end

  # Build a set of covered arm_ids for this symbol — O(m) once
  let covered_set: Map[String, Bool] = Map::new()
  for rec in artifact.records do
    if rec.symbol_id == symbol_id && rec.hits >= 1 then
      covered_set.insert(rec.arm_id.clone(), true)
    end
  end

  # Now check expected arms — O(n) lookups into the set
  mut covered = 0
  for arm_id in expected_arms do
    if covered_set.contains_key(arm_id) then
      covered = covered + 1
    end
  end

  CoverageRatio {
    symbol_id: symbol_id,
    arms_total: total,
    arms_covered: covered,
    branch_ratio: to_float(covered) / to_float(total)
  }
end

# ═══════════════════════════════════════════════════════════════
# §75 — Branch Anchors (source-level stability)
# ═══════════════════════════════════════════════════════════════

# Every branch point assigned a BranchAnchor at HIR lowering time
# (before optimizations).

struct BranchAnchor
  origin_kind: BranchPointKind  # IfExpr, WhileExpr, MatchExpr, etc.
  origin_span: Span             # Source location of syntactic construct
  path: Vec[Int]                # Stable structural path in HIR AST
end

# §76 — Stable Branch ID (source-anchored)
# Computed from BranchAnchor (not incidental block IDs)
def compute_anchor_branch_id(symbol_id: String, anchor: BranchAnchor) -> String
  let kind_str = match anchor.origin_kind
  when BranchPointKind::IfExpr then "if"
  when BranchPointKind::WhileExpr then "while"
  when BranchPointKind::MatchExpr then "match"
  when BranchPointKind::ShortCircuit then "short_circuit"
  when BranchPointKind::Guard then "guard"
  when BranchPointKind::Desugar then "desugar"
  end
  var path_parts = Vec::new()
  for i in anchor.path do
    path_parts.push(i.to_string())
  end
  let path_str = path_parts.join(",")
  sha256("tg.branch.anchor.v1" + symbol_id + kind_str +
    anchor.origin_span.file + anchor.origin_span.start_line.to_string() + path_str)
end

# §77 — Stable Arm IDs with discriminants
# If/while: "then", "else", "body", "exit"
# Match enum: "Variant::<name>" in declared enum order
# Match int: "case::<value>" in sorted order; "other" last
# Short-circuit: "lhs_true", "lhs_false"

def arm_discriminant(kind: BranchPointKind, arm_index: Int, label: String) -> String
  match kind
  when BranchPointKind::IfExpr then
    match arm_index
    when 0 then "then"
    when 1 then "else"
    when _ then "arm_" + arm_index.to_string()
    end
  when BranchPointKind::WhileExpr then
    match arm_index
    when 0 then "body"
    when 1 then "exit"
    when _ then "arm_" + arm_index.to_string()
    end
  when BranchPointKind::ShortCircuit then
    match arm_index
    when 0 then "lhs_true"
    when 1 then "lhs_false"
    when _ then "arm_" + arm_index.to_string()
    end
  when _ then label
  end  end  end
end

# ═══════════════════════════════════════════════════════════════
# §78 — Optimization Preservation Rules
# ═══════════════════════════════════════════════════════════════

# All transformations MUST maintain an AnchorMap.
struct AnchorMap
  anchors: Map[Int, BranchAnchor]   # bb_id → anchor
end

def new_anchor_map() -> AnchorMap
  AnchorMap { anchors: Map::new() }
end

# Duplicated branches (inlining): inherit same anchor if same source span + HIR path
def inherit_anchor(inout map: AnchorMap, old_bb: Int, new_bb: Int) -> Unit
  match map.anchors.get(old_bb)
  when Option::Some(anchor) then
    map.anchors.insert(new_bb, anchor.clone())
  when Option::None then ()
  end  end
end

# Merged branches: LCA anchor or Desugar + fresh anchor
def merge_anchor(inout map: AnchorMap, bb_ids: Vec[Int], merged_bb: Int, span: Span) -> Unit
  # Use origin_kind=Desugar for merged branches
  map.anchors.insert(merged_bb, BranchAnchor {
    origin_kind: BranchPointKind::Desugar,
    origin_span: span,
    path: Vec::new()
  })
end

# Eliminated branches: simply disappear; expected arm set from same anchoring pipeline

# ═══════════════════════════════════════════════════════════════
# §79 — Coverage Correctness Contract
# ═══════════════════════════════════════════════════════════════

# `tgc` MUST compute expected arm set using same BranchAnchor rules
# CV-1/CV-2 operate on anchor-based IDs
# NO dependence on basic-block numbering

def compute_expected_arms(branches: Vec[BranchPoint]) -> Vec[String]
  let arm_ids = Vec::new()
  for bp in branches
    for arm in bp.arms
      arm_ids.push(arm.arm_id.clone())
    end
  end
  arm_ids.sort()
  arm_ids
end

# ═══════════════════════════════════════════════════════════════
# §55 — Coverage Signal Mapping Rules
# ═══════════════════════════════════════════════════════════════

# §55.1 — Instrument branch arms: increment counter when control enters arm target block
# §55.2 — Counters stable, written to coverage artifact

# Per-function symbol ID: total branch arms, hit count per arm ID

struct CoverageSignalInput
  symbol_id: String
  surface_class: String
  branches: Vec[BranchPoint]
  hits: Map[String, Int]     # arm_id → hits
  threshold: Float           # τ_b for this surface+mode
  gamma: Float               # γ_b for this mode
end

def compute_cv_signals(input: CoverageSignalInput) -> Vec[CoverageSignalResult]
  let results = Vec::new()
  mut total_arms = 0
  mut covered_arms = 0
  mut uncovered_arms = 0

  for bp in input.branches
    for arm in bp.arms
      total_arms = total_arms + 1
      let h = input.hits.get(arm.arm_id).unwrap_or(0)
      if h >= 1
        covered_arms = covered_arms + 1
      else
        uncovered_arms = uncovered_arms + 1
      end
    end
  end

  # CV-1: Uncovered fraction
  if total_arms > 0
    let uncov_frac = to_float(uncovered_arms) / to_float(total_arms)
    if uncov_frac > 0.05  # u0 = 0.05
      results.push(CoverageSignalResult {
        kind: "CV-1",
        severity: sev_count_float(uncov_frac, 0.05, 0.30),
        count: uncovered_arms,
        total: total_arms
      })
    end
  end

  # CV-2: Coverage below threshold
  if total_arms > 0 && input.threshold > 0.0
    let ratio = to_float(covered_arms) / to_float(total_arms)
    if ratio < input.threshold
      let shortfall = input.threshold - ratio
      let sev_cov = shortfall / input.threshold
      let severity = pow(sev_cov, input.gamma)
      results.push(CoverageSignalResult {
        kind: "CV-2",
        severity: severity,
        count: covered_arms,
        total: total_arms
      })
    end
  end

  results
end

struct CoverageSignalResult
  kind: String
  severity: Float
  count: Int
  total: Int
end

def sev_count_float(val: Float, n0: Float, n1: Float) -> Float
  if n1 == n0
    if val >= n1 then 1.0 else 0.0 end
  else
    let result = (val - n0) / (n1 - n0)
    if result < 0.0 then 0.0
    elsif result > 1.0 then 1.0
    else result
    end
  end
end

use std::json
use std::serde::{Value}

def json_parse(s: String) -> Result[Value, json::JsonError]
  # Delegates to std::json parser
  json::parse(s.as_str())
end

# ═══════════════════════════════════════════════════════════════
# §80 — The coverage-harness execution path
# ═══════════════════════════════════════════════════════════════
# ONE harness-construction entry (coverage_harness_build_and_run) owns the
# whole `tg test --coverage` lane:
#   1. per-test dispatch main generation (coverage_harness_source);
#   2. compilation through the SHARED finalize_verified_mir entry (lower ->
#      verify -> effect/purity/budget -> persistent lineage view -> mono ->
#      unconditional post-mono checkpoint -> tail/SLP stamps -> optimizer ->
#      post-opt verify -> pre-codegen firewall);
#   3. the coverage emission plan + the LIR coverage executable build;
#   4. per-test execution: one process per test name, argv[1] = the name
#      (the runtime dump binds it as `test|<name>`);
#   5. exit-time trace ingest through coverage_trace_bind_stable +
#      coverage_ingest, the trace deleted before every run (a crashed
#      process's missing trace is detected, never a stale ingest).
#
# BOTH harness call sites run through it and can no longer drift:
#   * the CLI route (driver.tg: compile_and_run_tests /
#     compile_and_run_file_main) keeps its CLI-specific paths, argv
#     dispatch and sibling run-snapshot / lineage-store publication, and
#     calls this entry;
#   * the verified-edit transaction (semantic_server.tg:
#     session_run_affected_tests / session_synthesize_uncovered_tests)
#     calls the SAME entry in-process.
# The entry lives HERE because driver.tg imports semantic_server.tg: the
# transaction cannot import the driver (cycle), and this module imports
# neither.
#
# `test_names` non-empty selects the generated per-test dispatch harness
# over `module_source`; EMPTY selects the canary convention — the module
# source is compiled as-is and the file's own main runs once with no argv
# element, exactly the CLI lane's file-main route.
#
# The harness stores nothing beside the executable: the run snapshot is
# returned in-process (a compile never invents runtime evidence) and the
# lineage store is THREADED IN by the caller (the transaction passes the
# session's persisted store, so the harness declarations carry the same
# stable identities as the transaction snapshot and the delta's affected
# keys match the run snapshot's coverage index; the CLI passes the store
# loaded from its sibling path and publishes the returned mutated store).
#
# HOST ROUTE: the LIR coverage emitter is host-only exactly like the CLI
# lane; a target outside aarch64/x86-64 fails closed here (the caller
# records the documented Unavailable status, never a fabricated pass).

pub struct CoverageHarnessTestResult
  name: String
  passed: Bool
  message: String
end

pub struct CoverageHarnessCompiled
  exe_path: String
  snapshot: SemanticSnapshot
  lineage_store: DeclLineageStore
end

pub struct CoverageHarnessRun
  snapshot: SemanticSnapshot
  results: Vec[CoverageHarnessTestResult]
  traces: Int = 0
  missing_traces: Int = 0
end

# THE outcome of the ONE harness-construction entry. compiled_snapshot is
# the finalized compile boundary (the CLI publishes THIS boundary beside
# the harness exactly as before the dedup); snapshot is that boundary
# after every ingested exit-time trace (the state the transaction
# evaluates and the CLI reports its coverage rows from); lineage_store is
# the mutated store the caller threaded in (the CLI publishes it as the
# run's sibling).
pub struct CoverageHarnessOutcome
  exe_path: String
  compiled_snapshot: SemanticSnapshot
  snapshot: SemanticSnapshot
  lineage_store: DeclLineageStore
  results: Vec[CoverageHarnessTestResult]
  traces: Int = 0
  missing_traces: Int = 0
end

# THE typed failure vocabulary of the harness construction: the ONE entry
# never forces one caller's route text on the other — each caller renders
# it through its own vocabulary (the driver keeps its CLI messages, this
# module's coverage_harness_error_text renders the lane's).
pub enum CoverageHarnessError
  RouteUnsupported
  HarnessDir(detail: String)
  HarnessWrite(path: String, detail: String)
  SourceDiagnostics(rendered: String)
  Finalize(failure: FinalizeFailure)
  Snapshot(error: SnapshotError)
  UntrackedArtifact(artifact: UntrackedArtifact)
  Executable(detail: String)
end

# The route-unsupported text (the CLI lane's coverage_route_message
# mirror — kept here so the module owns its own route vocabulary).
pub def coverage_harness_route_message() -> String
  "the coverage harness route is host-only (aarch64 / x86-64)"
end

# The SnapshotError render (the driver's snapshot_error_text mirror — the
# harness builder reports the builder's ONE error vocabulary).
def coverage_harness_snapshot_error_text(e: SnapshotError) -> String
  match e
  when SnapshotError::UnstableTypeIdentity(tid) then "unstable type identity (type id " + tid + ")"
  when SnapshotError::UnstableDefIdentity then "unstable def identity"
  when SnapshotError::UnstableFieldIdentity then "unstable field identity"
  when SnapshotError::UnstableVariantIdentity then "unstable variant identity"
  when SnapshotError::UnstableLocalIdentity then "unstable local identity"
  when SnapshotError::UnstableClosureIdentity then "unstable closure identity"
  when SnapshotError::UnstableBlockIdentity then "unstable block identity"
  when SnapshotError::UnstableInstanceDisplay then "unstable instance display"
  when SnapshotError::UnstableTarget then "unstable target"
  when SnapshotError::UntrackedOrigin(api, detail) then
    "untracked-artifact: " + api + ": " + detail
  end
end

# The finalize-failure render (the route-local diagnostic channel): the
# structured annotation diagnostics when the stage carries them, else the
# canonical stage word plus the verifier / lowering / mono rows.
def coverage_harness_finalize_failure_text(f: FinalizeFailure) -> String
  if !f.diagnostics.is_empty() then
    join_diagnostics(&f.diagnostics)
  else
    "finalization failed at " + f.stage.clone() + ": " + f.rows.join("; ")
  end
end

# The shared construction's failure render (the coverage lane's text): the
# route-unsupported message, the IO texts, the source diagnostics, and the
# typed pipeline / snapshot / artifact failures.
pub def coverage_harness_error_text(e: CoverageHarnessError) -> String
  match e
  when CoverageHarnessError::RouteUnsupported then coverage_harness_route_message()
  when CoverageHarnessError::HarnessDir(detail) then
    "failed to create coverage harness directory: " + detail
  when CoverageHarnessError::HarnessWrite(path, detail) then
    "failed to write harness '" + path + "': " + detail
  when CoverageHarnessError::SourceDiagnostics(rendered) then rendered
  when CoverageHarnessError::Finalize(failure) then
    coverage_harness_finalize_failure_text(failure)
  when CoverageHarnessError::Snapshot(error) then
    "semantic snapshot build failed: " + coverage_harness_snapshot_error_text(error)
  when CoverageHarnessError::UntrackedArtifact(artifact) then
    untracked_artifact_text(artifact)
  when CoverageHarnessError::Executable(detail) then detail
  end
end

# The generated per-test dispatch harness source: the module source plus a
# generated `main` that dispatches argv[1] to the named @test function —
# THE ONE generated-main shape both the CLI `tg test` lane and the
# verified-edit transaction compile (the argv[1] convention the runtime
# coverage dump binds as `test|<name>`). `use std::args` (and
# `use std::test::*` when the source asserts) is appended only when the
# source does not already carry it, so a test file with its own imports
# compiles unchanged.
pub def coverage_harness_source(module_source: String, test_names: Vec[String]) -> String
  var lines: Vec[String] = Vec::new()
  lines.push(module_source.clone())
  lines.push("")
  lines.push("# [generated by the verified-edit transaction] per-test dispatch main")
  if !module_source.contains("use std::args".to_string()) then
    lines.push("use std::args")
  end
  if module_source.contains("assert".to_string()) &&
     !module_source.contains("use std::test".to_string()) then
    lines.push("use std::test::*")
  end
  lines.push("")
  lines.push("def main() -> Int")
  lines.push("  let argv = args::args()")
  lines.push("  if argv.len() < 2 then")
  lines.push("    return 1")
  lines.push("  end")
  lines.push("  let name = argv[1]")
  var first = true
  for name in test_names do
    if first then
      lines.push("  if name == \"" + name.clone() + "\" then")
      first = false
    else
      lines.push("  elsif name == \"" + name.clone() + "\" then")
    end
    lines.push("    " + name.clone() + "()")
  end
  if first then
    lines.push("  return 1")
  else
    lines.push("  else")
    lines.push("    panic(\"unknown test: \" + name)")
    lines.push("  end")
    lines.push("  0")
  end
  lines.push("end")
  lines.push("")
  lines.join("\n")
end

# The parent directory of a harness path: the ONE construction creates it
# before installing the source (the CLI's build/.tg_test_harness and the
# transaction's build/.tg_verify_edit share the rule).
def coverage_harness_parent_dir(path: String) -> String
  match path.rfind("/")
  when Option::Some(i) then path.slice(0, i)
  when Option::None then "."
  end
end

# Install the harness source at its path: create the parent directory and
# write only when the bytes differ (the CLI's canary file-main route passes
# its own file — the route compiled it in place, never rewriting an
# identical file).
def coverage_harness_install_source(path: String, source: String) -> Result[Unit, CoverageHarnessError]
  match mkdir_p(coverage_harness_parent_dir(path.clone()))
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err(CoverageHarnessError::HarnessDir(e.message()))
  end
  match read_file(path.clone())
  when Result::Ok(existing) then
    if existing == source then
      return Result::Ok(())
    end
  when Result::Err(_) then ()
  end
  match write_file(path.clone(), source)
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(e) then
    Result::Err(CoverageHarnessError::HarnessWrite(path.clone(), e.message()))
  end
end

# Compile one harness source through the canonical LIR host coverage route:
# parse -> merge imports -> analyze -> the SHARED finalize_verified_mir
# entry (lower -> verify -> effect/purity/budget -> persistent lineage view
# -> mono -> unconditional post-mono checkpoint -> tail/SLP stamps ->
# optimizer -> post-opt verify -> pre-codegen firewall) -> snapshot build
# -> coverage emission plan -> LIR executable. `lineage_store` is the
# caller's persisted store: the harness declarations are stamped through it
# (a copy — the caller's store is untouched) so their stable identities
# agree with the caller's snapshot; the mutated copy rides the returned
# struct. `harness_path` is both the source file name the parse and
# diagnostics carry and the executable's base path.
pub def coverage_harness_compile(
  opts: CompilerOptions,
  harness_path: String,
  harness_source: String,
  coverage_out: String,
  lineage_store: DeclLineageStore
) -> Result[CoverageHarnessCompiled, CoverageHarnessError]
  var local_opts = opts.clone()
  # The harness executable path must never alias the caller's own output
  # artifact (`opts.output_file` names the SESSION's binary): the path is
  # derived from the harness file alone.
  local_opts.output_file = Option::None
  match coverage_harness_install_source(harness_path.clone(), harness_source.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err(e)
  end
  var ast = match parse_source_program(harness_source, harness_path.clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then
    return Result::Err(CoverageHarnessError::SourceDiagnostics(join_diagnostics(&diags)))
  end
  ast = match merge_imported_deps(ast, false)
  when Result::Ok(a) then a
  when Result::Err(e) then return Result::Err(CoverageHarnessError::SourceDiagnostics(e))
  end
  var env = type_env_new()
  let typed = match analyze_program(&mut env, &mut ast, local_opts.clone())
  when Result::Ok(tp) then tp
  when Result::Err(diags) then
    return Result::Err(CoverageHarnessError::SourceDiagnostics(join_diagnostics(&diags)))
  end
  # The host route gate and the route's effective target descriptor (the
  # finalization's SLP stamp seam consumes it).
  let target_desc = match detect_host_target().arch
  when Arch::AArch64 then aarch64_desc()
  when Arch::X86_64 then x86_64_desc()
  when _ then return Result::Err(CoverageHarnessError::RouteUnsupported)
  end
  # The harness identities are stamped through the CALLER's store copy:
  # the caller/callee declarations the delta names keep the exact stable
  # ids the caller's snapshot carries, and the synthesized/@test/main
  # declarations are minted fresh. The SAME store copy threads into the
  # snapshot build below.
  var store = lineage_store.clone()
  let pipeline = match finalize_verified_mir(
    env, typed,
    FinalizeTarget { slp_desc: Option::Some(target_desc.clone()) },
    FinalizeOptions { compiler: local_opts.clone() },
    &mut store)
  when Result::Ok(v) then v
  when Result::Err(f) then return Result::Err(CoverageHarnessError::Finalize(f))
  end
  var mir = pipeline.mir
  var snapshot = match semantic_snapshot_of_final_state(
    &env, &typed.typed, &mir, &target_desc, VERSION, semantic_digest_zero(), &mut store,
    typed.drop_plan_facts.clone(), typed.dma_facts.clone(),
    snapshot_feature_set_of(local_opts.clone(), target_desc.clone()),
    snapshot_semantic_options_of(local_opts.clone(), target_desc.clone()))
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(CoverageHarnessError::Snapshot(e))
  end
  let cov_plan = match coverage_emission_plan_of_functions(mir.functions.clone(), coverage_out.clone())
  when Result::Ok(p) then p
  when Result::Err(u) then return Result::Err(CoverageHarnessError::UntrackedArtifact(u))
  end
  let exe_path = get_output_path(local_opts.clone(), harness_path.clone(), "")
  match lir_compile_executable_cov(mir, detect_host_target(), exe_path.clone(), cov_plan,
    lir_replay_plan_disabled())
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err(CoverageHarnessError::Executable(e))
  end
  Result::Ok(CoverageHarnessCompiled {
    exe_path: exe_path,
    snapshot: snapshot,
    lineage_store: store
  })
end

# Run one program with an ARGV vector through the safe std::process::Command
# API (the driver's bootstrap_call_argv idiom; program and test names are
# separate argv elements, never a shell string).
def coverage_harness_call_argv(program: String, args: Vec[String]) -> Int
  var command = Command::new(program)
  for a in args do
    command = command.arg(a.as_str_view())
  end
  match command.status()
  when Result::Ok(code) then code
  when Result::Err(e) then
    eprintln("error: cannot run '" + program + "': " + e)
    127
  end
end

# The per-test run + ingest loop (the ONE entry's dispatch shape): each
# named test runs as its own process with argv[1] = the name (the runtime
# dump binds it as `test|<name>`), the trace file is deleted before every
# run (a crashed process's missing trace is detected, never a stale
# ingest), and every read trace is normalized through the discovery table
# and ingested into the run snapshot. A test that passed but wrote no
# trace carries the documented missing-trace note in its message.
pub def coverage_harness_run(
  exe_path: String,
  test_names: Vec[String],
  snapshot: SemanticSnapshot,
  coverage_out: String
) -> CoverageHarnessRun
  var results: Vec[CoverageHarnessTestResult] = Vec::new()
  var current = snapshot
  var traces = 0
  var missing = 0
  for name in test_names do
    match delete_file(coverage_out.clone())
    when Result::Ok(_) then ()
    when Result::Err(_) then ()
    end
    var test_args: Vec[String] = Vec::new()
    test_args.push(name.clone())
    let exit_code = coverage_harness_call_argv(exe_path.clone(), test_args)
    let passed = exit_code == 0
    var message = if passed then "" else "test exited with code " + exit_code.to_string() end
    match read_file(coverage_out.clone())
    when Result::Ok(trace_text) then
      traces = traces + 1
      let bound = coverage_trace_bind_stable(current.clone(), trace_text)
      current = coverage_ingest(current, bound)
    when Result::Err(_) then
      missing = missing + 1
      if passed then
        message = "test passed but wrote no coverage trace"
      end
    end
    results.push(CoverageHarnessTestResult {
      name: name.clone(),
      passed: passed,
      message: message
    })
  end
  CoverageHarnessRun {
    snapshot: current,
    results: results,
    traces: traces,
    missing_traces: missing
  }
end

# The canary-convention run (the ONE entry's empty test_names shape): the
# executable's own main runs once with no argv element; its exit code is
# the outcome and its exit-time trace is ingested into the caller's
# snapshot. The result is named "main" and carries no missing-trace note —
# exactly the CLI lane's file-main route.
def coverage_harness_run_main(
  exe_path: String,
  snapshot: SemanticSnapshot,
  coverage_out: String
) -> CoverageHarnessRun
  match delete_file(coverage_out.clone())
  when Result::Ok(_) then ()
  when Result::Err(_) then ()
  end
  let exit_code = coverage_harness_call_argv(exe_path.clone(), Vec::new())
  let passed = exit_code == 0
  let message = if passed then "" else "test exited with code " + exit_code.to_string() end
  var current = snapshot
  var traces = 0
  var missing = 0
  match read_file(coverage_out.clone())
  when Result::Ok(trace_text) then
    traces = 1
    let bound = coverage_trace_bind_stable(current.clone(), trace_text)
    current = coverage_ingest(current, bound)
  when Result::Err(_) then
    missing = 1
  end
  var results: Vec[CoverageHarnessTestResult] = Vec::new()
  results.push(CoverageHarnessTestResult {
    name: "main".to_string(),
    passed: passed,
    message: message
  })
  CoverageHarnessRun {
    snapshot: current,
    results: results,
    traces: traces,
    missing_traces: missing
  }
end

# THE ONE harness-construction entry. Both callers (the CLI route in
# driver.tg and the verified-edit transaction in semantic_server.tg) run
# the SAME construction here:
#   dispatch-main generation (or the canary source when test_names is
#   empty) -> compile through finalize_verified_mir + the coverage emission
#   plan + the LIR coverage executable -> per-test execution -> trace
#   ingest. The caller supplies and publishes the lineage store (the CLI
#   loads/persists the sibling store; the transaction threads the session's
#   store); the returned outcome carries both the compile-boundary snapshot
#   (the CLI publishes it) and the post-ingest run snapshot (the
#   transaction evaluates it).
pub def coverage_harness_build_and_run(
  opts: CompilerOptions,
  harness_path: String,
  module_source: String,
  test_names: Vec[String],
  coverage_out: String,
  lineage_store: DeclLineageStore
) -> Result[CoverageHarnessOutcome, CoverageHarnessError]
  let dispatch_names = test_names.clone()
  let harness_source = if dispatch_names.is_empty() then
    module_source.clone()
  else
    coverage_harness_source(module_source.clone(), dispatch_names.clone())
  end
  let compiled = match coverage_harness_compile(opts, harness_path, harness_source,
    coverage_out.clone(), lineage_store)
  when Result::Ok(c) then c
  when Result::Err(e) then return Result::Err(e)
  end
  let compiled_snapshot = compiled.snapshot.clone()
  let run = if dispatch_names.is_empty() then
    coverage_harness_run_main(compiled.exe_path.clone(), compiled.snapshot.clone(),
      coverage_out.clone())
  else
    coverage_harness_run(compiled.exe_path.clone(), dispatch_names.clone(),
      compiled.snapshot.clone(), coverage_out.clone())
  end
  Result::Ok(CoverageHarnessOutcome {
    exe_path: compiled.exe_path.clone(),
    compiled_snapshot: compiled_snapshot,
    snapshot: run.snapshot.clone(),
    lineage_store: compiled.lineage_store.clone(),
    results: run.results.clone(),
    traces: run.traces,
    missing_traces: run.missing_traces
  })
end
