# Tangerine Compiler — Library Module (KERNEL)
#
# This is the bootstrap kernel entry point. It re-exports ONLY the modules
# required to self-host the compiler (front-end + lowering + codegen + object
# + link + tooling), as declared in bootstrap/compiler_kernel.manifest.
#
# The FULL compiler API lives in lib.tg, which is the same kernel plus the
# non-bootstrap tooling modules (agentic, bindgen, coverage, cqs, debugger,
# pkg_manager, refactor, registry, symbol_graph, template, util, etc.).
#
# The self-hosting bootstrap loads THIS module instead of lib.tg so the
# bootstrap compiler closure stays minimal and deterministic.

pub mod token end
pub mod lexer end
pub mod ast end
pub mod parser end
pub mod types end
pub mod access_check end
pub mod resource_check end
pub mod trait_resolve end
pub mod resolver end
pub mod mir end
pub mod asm end
pub mod layout_engine end
pub mod object end
pub mod runtime end
pub mod linker end
pub mod codegen end
pub mod compiler_core end
pub mod mode end
pub mod version end

# Version information
pub use version::{VERSION, VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH}

# Re-export the kernel's commonly used types
pub use token::{Token, TokenKind, Span}
pub use lexer::{tokenize, Lexer}
pub use ast::{Program, Item, ItemKind, Expr, Stmt, Pattern, TypeExpr, TypeExprKind, assign_node_ids}
pub use parser::{parse, Parser, ParseError, diag_has_errors}
pub use types::{type_check, type_check_typed, type_kind_map, type_env_new, Type, TypeError, TypeKind}
pub use access_check::{access_check, AccessError}
pub use resource_check::{resource_check, ResourceError}
pub use resolver::{resolve_names}
pub use mir::{lower_to_mir, MirProgram, optimize_mir, pretty_print_mir}
pub use codegen::{generate_native, generate_executable, generate_object_file, detect_host_target}
pub use trait_resolve::{monomorphize_program, mono_cache_new}
pub use compiler_core::{compile_file, analyze_source, analyze_parsed, default_options, CompilerOptions}

# Convenience function for quick compilation (kernel subset)
pub def compile(source: String) -> Result[String, String]
  var opts = default_options()
  opts.strict_resolution = true
  let typed = match analyze_source(source, "", &opts)
  when Result::Ok(t) then t
  when Result::Err(e) then
    return Result::Err(e)
  end

  let ast = typed.ast.clone()
  let mir = match lower_to_mir(&ast, &typed)
  when Result::Ok(m) then m
  when Result::Err(e) then
    return Result::Err("MIR lowering error: " + e)
  end

  var mir2 = mir
  var mono_cache = mono_cache_new()
  monomorphize_program(&mut mir2, &mut mono_cache)

  optimize_mir(&mut mir2, 1)

  let target = detect_host_target()
  let obj_bytes = match generate_object_file(&mir2, target)
  when Result::Ok(b) then b
  when Result::Err(e) then
    return Result::Err("codegen failed: " + e)
  end

  Result::Ok("Native object generated (" + obj_bytes.len().to_string() + " bytes)")
end

# Quick check function (no codegen)
pub def check(source: String) -> Vec[String]
  var errors = Vec::new()
  var opts = default_options()
  opts.strict_resolution = true
  match analyze_source(source, "", &opts)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    errors.push(e)
  end
  errors
end

# Parse only (for IDE support)
pub def parse_only(source: String) -> Result[Program, String]
  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  match diag_has_errors(&parse_diags)
  when true then Result::Err(parse_diags[0].message.clone())
  when false then Result::Ok(ast)
  end
end

# Get tokens (for syntax highlighting)
pub def tokenize_only(source: String) -> Vec[Token]
  tokenize(source, "").tokens
end
