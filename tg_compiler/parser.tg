# Tangerine Compiler — Parser
# Self-hosting compiler written in Tangerine
#
# LL(1)/Pratt hybrid parser with error recovery.
# - LL(1) recursive descent for declarations and statements
# - Precedence climbing (Pratt) for expressions
# - Error recovery via synchronization at statement boundaries

use std::core::{Option, Result, panic}
use std::collections::{Vec}
use tg_compiler::token::{Span, Token, TokenKind, span_new, span_merge, is_expr_start, is_stmt_start, is_item_start, is_doc_comment}
use tg_compiler::lexer::LexResult
use tg_compiler::ast::{
  Program, Item, ItemKind, Visibility,
  FunctionDecl, GenericParam, Param, ParamModifier, FnBody, FunctionSig,
  StructDecl, FieldDecl, EnumDecl, VariantDecl,
  TraitDecl, TraitMethod, AssocType, ImplDecl, WherePredicate, AssocTypeImpl,
  ModuleDecl, UseDecl, AstPath, TypeAliasDecl, ConstDecl, StaticDecl,
  MacroDecl, ExternBlock, ExternItem, ExternFn, ExternStatic,
  ContractClause, AstContractKind, CapabilityDecl, EffectDecl,
  EffectHandler, HandlerArm,
  BudgetAnnotation, BudgetConstraint, RationaleBlock, EditionDecl,
  TypeExpr, TypeExprKind,
  Block, Stmt, StmtKind, IfStmt, MatchExpr, MatchArm, CatchArm,
  Pattern, PatternKind, Expr, ExprKind, ClosureParam, BinOp, UnOp,
  make_program, make_item, make_block, make_stmt, make_expr, make_type_expr, make_pattern, make_path
}

# ———————————————————————————————————————————————————————————————
# Diagnostics
# ———————————————————————————————————————————————————————————————

enum ErrorCode
  E100UnexpectedToken
  E101ExpectedExpression
  E102ExpectedType
  E103ExpectedIdent
  E104ExpectedPattern
end

enum DiagLevel
  Error
  Warning
  Info
  Note
  Help
end

struct Suggestion
  message: String
  replacement: String
  span: Span
end

struct Diagnostic
  level: DiagLevel
  message: String
  span: Option[Span]
  notes: Vec[String]
  suggestions: Vec[Suggestion]
  code: Option[String]
end

def diag_new() -> Vec[Diagnostic]
  Vec::new()
end

def diag_error(bag: &mut Vec[Diagnostic], code: ErrorCode, msg: String, span: Span) -> Unit
  bag.push(Diagnostic {
    level: DiagLevel::Error,
    message: msg, 
    span: Option::Some(span),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some(error_code_to_string(code))
  })
end

def error_code_to_string(code: ErrorCode) -> String
  match code
  when ErrorCode::E100UnexpectedToken then "E100"
  when ErrorCode::E101ExpectedExpression then "E101"
  when ErrorCode::E102ExpectedType then "E102"
  when ErrorCode::E103ExpectedIdent then "E103"
  when ErrorCode::E104ExpectedPattern then "E104"
  end
end

def diag_has_errors(bag: &Vec[Diagnostic]) -> Bool
  !bag.is_empty()
end

# ———————————————————————————————————————————————————————————————
# Parser State
# ———————————————————————————————————————————————————————————————

struct TgcParser
  tokens: Vec[Token]
  pos: Int
  diag: Vec[Diagnostic]
  disallow_bitwise_pipe: Bool
end

def tgc_parser_new(tokens: Vec[Token]) -> TgcParser
  TgcParser {
    tokens: tokens,
    pos: 0,
    diag: diag_new(),
    disallow_bitwise_pipe: false
  }
end

# ———————————————————————————————————————————————————————————————
# Parser Helpers
# ———————————————————————————————————————————————————————————————

def peek(p: &TgcParser) -> TokenKind
  if p.pos < p.tokens.len() then
    p.tokens[p.pos].kind
  else
    TokenKind::Eof
  end
end

def peek_span(p: &TgcParser) -> Span
  if p.pos < p.tokens.len() then
    p.tokens[p.pos].span
  else
    span_new(0, 0)
  end
end

def at(p: &TgcParser, kind: TokenKind) -> Bool
  peek(p) == kind
end

def advance(p: &mut TgcParser) -> Token
  if p.pos < p.tokens.len() then
    let tok = p.tokens[p.pos]
    p.pos = p.pos + 1
    tok
  else
    Token { kind: TokenKind::Eof, span: span_new(0, 0) }
  end
end

def expect(p: &mut TgcParser, expected: TokenKind) -> Option[Token]
  if at(p, expected) then
    Option::Some(advance(p))
  else
    let span = peek_span(p)
    diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, 
      "expected " + token_kind_name(expected) + ", found " + token_kind_name(peek(p)), span)
    Option::None
  end
end

def skip_newlines(p: &mut TgcParser) -> Unit
  while at(p, TokenKind::Newline) do
    advance(p)
  end
end

def skip_doc_comments(p: &mut TgcParser) -> Unit
  while is_doc_comment(peek(p)) do
    advance(p)
    skip_newlines(p)
  end
end

# Check if the current token is a keyword matching the given string.
# Maps known keyword strings to their TokenKind and delegates to at().
def at_keyword(p: &TgcParser, kw: String) -> Bool
  match kw
  when "where" then at(p, TokenKind::Where)
  when "type" then at(p, TokenKind::Type)
  when "def" then at(p, TokenKind::Def)
  when "let" then at(p, TokenKind::Let)
  when "mut" then at(p, TokenKind::Mut)
  when "if" then at(p, TokenKind::If)
  when "else" then at(p, TokenKind::Else)
  when "end" then at(p, TokenKind::End)
  when "for" then at(p, TokenKind::For)
  when "while" then at(p, TokenKind::While)
  when "match" then at(p, TokenKind::Match)
  when "return" then at(p, TokenKind::Return)
  when "break" then at(p, TokenKind::Break)
  when "enum" then at(p, TokenKind::Enum)
  when "struct" then at(p, TokenKind::Struct)
  when "trait" then at(p, TokenKind::Trait)
  when "impl" then at(p, TokenKind::Impl)
  when "use" then at(p, TokenKind::Use)
  when "pub" then at(p, TokenKind::Pub)
  when "static" then at(p, TokenKind::Static)
  when "const" then at(p, TokenKind::Const)
  when "unsafe" then at(p, TokenKind::Unsafe)
  when "async" then at(p, TokenKind::Async)
  when "await" then at(p, TokenKind::Await)
  when "do" then at(p, TokenKind::Do)
  when _ then false
  end
end

# Like expect(), but returns Bool instead of Option[Token].
def expect_keyword(p: &mut TgcParser, kind: TokenKind) -> Bool
  match expect(p, kind)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# Check if the current token can start an expression.
def at_expr_start(p: &TgcParser) -> Bool
  is_expr_start(peek(p))
end

def expect_end(p: &mut TgcParser) -> Unit
  skip_newlines(p)
  if at(p, TokenKind::End) then
    advance(p)
  else
    let span = peek_span(p)
    diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected 'end'", span)
  end
end

def eat_optional_semi(p: &mut TgcParser) -> Unit
  if at(p, TokenKind::Semicolon) then
    advance(p)
  end
end

def synchronize(p: &mut TgcParser) -> Unit
  while !at(p, TokenKind::Eof) do
    match peek(p)
    when TokenKind::Newline then
      advance(p)
      break
    when TokenKind::End then
      advance(p)
      break
    when TokenKind::Eof then
      break
    when TokenKind::Def then break
    when TokenKind::Struct then break
    when TokenKind::Enum then break
    when TokenKind::Trait then break
    when TokenKind::Impl then break
    when TokenKind::Module then break
    when TokenKind::Use then break
    when TokenKind::Extern then break
    when TokenKind::Const then break
    when TokenKind::Static then break
    when TokenKind::Pub then break
    when TokenKind::Type then break
    when TokenKind::Macro then break
    when _ then advance(p)
    end
  end
end

def token_kind_name(kind: TokenKind) -> String
  match kind
  when TokenKind::Def then "def"
  when TokenKind::End then "end"
  when TokenKind::If then "if"
  when TokenKind::Unless then "unless"
  when TokenKind::Else then "else"
  when TokenKind::While then "while"
  when TokenKind::Until then "until"
  when TokenKind::For then "for"
  when TokenKind::In then "in"
  when TokenKind::Match then "match"
  when TokenKind::When then "when"
  when TokenKind::Let then "let"
  when TokenKind::Mut then "mut"
  when TokenKind::Return then "return"
  when TokenKind::Struct then "struct"
  when TokenKind::Enum then "enum"
  when TokenKind::Trait then "trait"
  when TokenKind::Impl then "impl"
  when TokenKind::Eof then "end of file"
  when _ then "<token>"
  end
end

# ———————————————————————————————————————————————————————————————
# Program Parsing
# ———————————————————————————————————————————————————————————————

def parse_program(p: &mut TgcParser) -> Program
  let start = peek_span(p)
  mut items = Vec::new()
  skip_newlines(p)
  skip_doc_comments(p)
  
  while !at(p, TokenKind::Eof) do
    skip_newlines(p)
    skip_doc_comments(p)
    let before_pos = p.pos
    match parse_item(p)
    when Option::Some(item) then
      items.push(item)
    when Option::None then
      synchronize(p)
      if p.pos == before_pos then
        advance(p)
      end
    end
    skip_newlines(p)
    skip_doc_comments(p)
  end
  
  let end_span = peek_span(p)
  make_program(items, span_merge(start, end_span))
end

# ———————————————————————————————————————————————————————————————
# Attributes
# ———————————————————————————————————————————————————————————————

def parse_attributes(p: &mut TgcParser) -> Vec[Attribute]
  mut attrs = Vec::new()
  while at(p, TokenKind::At) do
    let start = peek_span(p)
    advance(p)
    match expect_ident(p)
    when Option::Some(name) then
      mut args = Vec::new()
      if at(p, TokenKind::LParen) then
        advance(p)
        mut depth = 1
        while depth > 0 && !at(p, TokenKind::Eof) do
          match peek(p)
          when TokenKind::LParen then
            depth = depth + 1
            advance(p)
          when TokenKind::RParen then
            depth = depth - 1
            if depth > 0 then advance(p) end
          when TokenKind::Ident(arg) then
            args.push(arg)
            advance(p)
            if at(p, TokenKind::Comma) then advance(p) end
          when TokenKind::StringLit(s) then
            args.push(s)
            advance(p)
            if at(p, TokenKind::Comma) then advance(p) end
          when _ then
            # Skip other tokens in attribute arguments (operators, literals, etc.)
            advance(p)
          end
        end
        expect(p, TokenKind::RParen)
      end
      attrs.push(Attribute { name: name, args: args, span: span_merge(start, peek_span(p)) })
    when Option::None then ()
    end
    skip_newlines(p)
  end
  attrs
end

# ———————————————————————————————————————————————————————————————
# Item Parsing
# ———————————————————————————————————————————————————————————————

def at_function_decl_start(p: &TgcParser) -> Bool
  let pk = peek(p)
  match pk
  when TokenKind::Def then true
  when TokenKind::Async then true
  when TokenKind::Unsafe then true
  when TokenKind::Pure then true
  when TokenKind::Inline then true
  when TokenKind::Ident(name) then
    name == "def" || name == "fn" || name == "async" || name == "unsafe" || name == "pure" || name == "inline"
  when _ then false
  end
end

def parse_prefixed_function_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[FunctionDecl]
  mut is_async = false
  mut is_unsafe = false
  mut is_inline = false
  mut is_pure = false

  while !at(p, TokenKind::Eof) do
    let pk = peek(p)
    match pk
    when TokenKind::Async then
      advance(p)
      is_async = true
    when TokenKind::Unsafe then
      advance(p)
      is_unsafe = true
    when TokenKind::Pure then
      advance(p)
      is_pure = true
    when TokenKind::Inline then
      advance(p)
      is_inline = true
    when TokenKind::Def then
      advance(p)
      return parse_function_decl_full(p, vis, start, is_async, is_unsafe, false, is_inline, is_pure)
    when TokenKind::Ident(name) then
      if name == "async" then
        advance(p)
        is_async = true
      elsif name == "unsafe" then
        advance(p)
        is_unsafe = true
      elsif name == "pure" then
        advance(p)
        is_pure = true
      elsif name == "inline" then
        advance(p)
        is_inline = true
      elsif name == "def" || name == "fn" then
        advance(p)
        return parse_function_decl_full(p, vis, start, is_async, is_unsafe, false, is_inline, is_pure)
      else
        diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected 'def' after function modifiers", peek_span(p))
        return Option::None
      end
    when TokenKind::Eof then
      break
    when _ then
      diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected 'def' after function modifiers", peek_span(p))
      return Option::None
    end
  end

  Option::None
end

def consume_function_decl_prefix(p: &mut TgcParser) -> Bool
  while at(p, TokenKind::Async) || at(p, TokenKind::Unsafe) || at(p, TokenKind::Pure) || at(p, TokenKind::Inline) do
    advance(p)
  end

  if at(p, TokenKind::Def) then
    advance(p)
    true
  else
    false
  end
end

def parse_item(p: &mut TgcParser) -> Option[Item]
  skip_newlines(p)
  skip_doc_comments(p)
  let attrs = parse_attributes(p)
  
  # Extract @derive attributes
  mut derives = Vec::new()
  for attr in &attrs do
    if attr.name == "derive" then
      for arg in &attr.args do
        derives.push(arg.clone())
      end
    end
  end
  
  let start = peek_span(p)
  let vis = parse_visibility(p)
  if at_function_decl_start(p) then
    let fn_result = parse_prefixed_function_decl(p, vis, start)
    match fn_result
    when Option::Some(f) then
      let item = make_item(ItemKind::Function(f), span_merge(start, peek_span(p)))
      if !attrs.is_empty() then
        item.attrs = attrs
      end
      return Option::Some(item)
    when Option::None then
      return Option::None
    end
  end
  mut result = Option::None
  let pk2 = peek(p)
  if pk2 == TokenKind::Use then
    advance(p)
    match parse_use_decl(p, start)
    when Option::Some(u) then
      result = Option::Some(make_item(ItemKind::Use(u), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Module then
    advance(p)
    match parse_module_decl(p, vis, start)
    when Option::Some(m) then
      result = Option::Some(make_item(ItemKind::Module(m), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Struct then
    advance(p)
    match parse_struct_decl(p, vis, start, derives)
    when Option::Some(s) then
      result = Option::Some(make_item(ItemKind::Struct(s), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Enum then
    advance(p)
    match parse_enum_decl(p, vis, start, derives)
    when Option::Some(e) then
      result = Option::Some(make_item(ItemKind::Enum(e), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Trait then
    advance(p)
    match parse_trait_decl(p, vis, start)
    when Option::Some(t) then
      result = Option::Some(make_item(ItemKind::Trait(t), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Impl then
    advance(p)
    match parse_impl_decl(p, vis, start)
    when Option::Some(i) then
      result = Option::Some(make_item(ItemKind::Impl(i), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Type then
    advance(p)
    match parse_type_alias(p, vis, start)
    when Option::Some(t) then
      result = Option::Some(make_item(ItemKind::TypeAlias(t), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Const then
    advance(p)
    match parse_const(p, vis, start)
    when Option::Some(c) then
      result = Option::Some(make_item(ItemKind::Const(c), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Static then
    advance(p)
    match parse_static(p, vis, start)
    when Option::Some(s) then
      result = Option::Some(make_item(ItemKind::Static(s), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Mut then
    advance(p)
    match parse_static(p, vis, start)
    when Option::Some(s) then
      result = Option::Some(make_item(ItemKind::Static(s), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Cap then
    advance(p)
    match parse_capability_decl(p, vis, start)
    when Option::Some(c) then
      result = Option::Some(make_item(ItemKind::CapabilityDecl(c), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Effect then
    advance(p)
    match parse_effect_decl(p, vis, start)
    when Option::Some(e) then
      result = Option::Some(make_item(ItemKind::EffectDecl(e), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Rationale then
    advance(p)
    match parse_rationale_block(p, start)
    when Option::Some(r) then
      result = Option::Some(make_item(ItemKind::RationaleBlock(r), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Edition then
    advance(p)
    match parse_edition_decl(p, start)
    when Option::Some(e) then
      result = Option::Some(make_item(ItemKind::EditionDecl(e), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  elsif pk2 == TokenKind::Extern then
    advance(p)
    result = parse_extern_dispatch(p, start)
  elsif pk2 == TokenKind::Macro then
    advance(p)
    match parse_macro_decl(p, vis, start)
    when Option::Some(m) then
      result = Option::Some(make_item(ItemKind::Macro(m), span_merge(start, peek_span(p))))
    when Option::None then ()
    end
  else
    # Check for test block: test "name" do ... end
    match peek(p)
    when TokenKind::Ident(name) then
      if name == "test" then
        advance(p)
        mut test_name = "unnamed_test"
        match peek(p)
        when TokenKind::StringLit(s) then
          advance(p)
          test_name = s
        when _ then
          let espan = peek_span(p)
          diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected string literal for test name", espan)
        end
        skip_newlines(p)
        expect(p, TokenKind::Do)
        mut body = FnBody::FnNone
        match parse_block_body(p)
        when Option::Some(block) then
          expect_end(p)
          body = FnBody::FnBlock(block)
        when Option::None then ()
        end
        result = Option::Some(make_item(ItemKind::Function(FunctionDecl {
          vis: vis,
          name: test_name,
          generic_params: Vec::new(),
          params: Vec::new(),
          ret_type: Option::None,
          where_clause: Vec::new(),
          body: body,
          is_async: false,
          is_unsafe: false,
          is_const: false,
          is_inline: false,
          is_pure: false,
          contracts: Vec::new(),
          budget_val: Option::None,
          required_caps: Vec::new(),
          effects: Vec::new(),
          span: span_merge(start, peek_span(p))
        }), span_merge(start, peek_span(p))))
      else
        let span = peek_span(p)
        diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected item", span)
      end
    when _ then
      let span = peek_span(p)
      diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected item", span)
    end
  end

  match result
  when Option::Some(mut item) then
    if !attrs.is_empty() then
      item.attrs = attrs
    end
    return Option::Some(item)
  when Option::None then return Option::None
  end
end

def parse_visibility(p: &mut TgcParser) -> Visibility
  match peek(p)
  when TokenKind::Pub then
    advance(p)
    return Visibility::Public
  when TokenKind::Private then
    advance(p)
    return Visibility::Private
  when _ then
    return Visibility::Default
  end
end

# ———————————————————————————————————————————————————————————————
# Use Declaration
# ———————————————————————————————————————————————————————————————

def parse_use_decl(p: &mut TgcParser, start: Span) -> Option[UseDecl]
  match parse_path(p)
  when Option::Some(path) then
    # Check for glob import: use path::*
    if at(p, TokenKind::ColonColon) then
      advance(p)
      if at(p, TokenKind::Star) then
        advance(p)
        eat_optional_semi(p)
        return Option::Some(UseDecl {
          path: path,
          alias_name: Option::None,
          names: Option::None,
          glob: true,
          span: span_merge(start, peek_span(p))
        })
      end
      # Check for destructuring import: use path::{A, B, C}
      if at(p, TokenKind::LBrace) then
        advance(p)
        skip_newlines(p)
        mut names = Vec::new()
        if !at(p, TokenKind::RBrace) then
          match expect_ident(p)
          when Option::Some(name) then names.push(name)
          when Option::None then ()
          end
          while at(p, TokenKind::Comma) do
            advance(p)
            skip_newlines(p)
            if at(p, TokenKind::RBrace) then break end
            match expect_ident(p)
            when Option::Some(name) then names.push(name)
            when Option::None then break
            end
          end
        end
        skip_newlines(p)
        expect(p, TokenKind::RBrace)
        eat_optional_semi(p)
        return Option::Some(UseDecl {
          path: path,
          alias_name: Option::None,
          names: Option::Some(names),
          glob: false,
          span: span_merge(start, peek_span(p))
        })
      end
    end
    
    mut alias_val = Option::None
    if at(p, TokenKind::As) then
      advance(p)
      match expect_ident(p)
      when Option::Some(name) then alias_val = Option::Some(name)
      when Option::None then ()
      end
    end
    eat_optional_semi(p)
    return Option::Some(UseDecl {
      path: path,
      alias_name: alias_val,
      names: Option::None,
      glob: false,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then
    return Option::None
  end
end

def parse_path(p: &mut TgcParser) -> Option[AstPath]
  let start = peek_span(p)
  match expect_ident(p)
  when Option::Some(first) then
    mut segments = Vec::new()
    segments.push(first)
    
    while at(p, TokenKind::ColonColon) do
      mut next_kind = TokenKind::Eof
      if p.pos + 1 < p.tokens.len() then
        next_kind = p.tokens[p.pos + 1].kind
      end
      match next_kind
      when TokenKind::LBrace then break
      when TokenKind::Star then break
      when _ then ()
      end
      advance(p)
      match expect_ident(p)
      when Option::Some(seg) then
        segments.push(seg)
      when Option::None then
        break
      end
    end
    
    return Option::Some(make_path(segments, span_merge(start, peek_span(p))))
  when Option::None then
    return Option::None
  end
end

def expect_ident(p: &mut TgcParser) -> Option[String]
  match peek(p)
  when TokenKind::Ident(name) then
    advance(p)
    return Option::Some(name)
  when TokenKind::Module then
    advance(p)
    return Option::Some("module")
  when TokenKind::Self_ then
    advance(p)
    return Option::Some("self")
  when TokenKind::SelfType then
    advance(p)
    return Option::Some("Self")
  when TokenKind::TkDrop then
    advance(p)
    return Option::Some("drop")
  when TokenKind::Async then
    advance(p)
    return Option::Some("async")
  when TokenKind::Next then
    advance(p)
    return Option::Some("next")
  when TokenKind::Type then
    advance(p)
    return Option::Some("type")
  when TokenKind::Cap then
    advance(p)
    return Option::Some("cap")
  when TokenKind::Requires then
    advance(p)
    return Option::Some("requires")
  when TokenKind::Ensures then
    advance(p)
    return Option::Some("ensures")
  when TokenKind::Invariant then
    advance(p)
    return Option::Some("invariant")
  when TokenKind::Budget then
    advance(p)
    return Option::Some("budget")
  when TokenKind::TkMove then
    advance(p)
    return Option::Some("move")
  when TokenKind::TkOwn then
    advance(p)
    return Option::Some("own")
  when TokenKind::Pre then
    advance(p)
    return Option::Some("pre")
  when TokenKind::Post then
    advance(p)
    return Option::Some("post")
  when TokenKind::Effect then
    advance(p)
    return Option::Some("effect")
  when TokenKind::Pure then
    advance(p)
    return Option::Some("pure")
  when TokenKind::TkRef then
    advance(p)
    return Option::Some("ref")
  when TokenKind::TkCopy then
    advance(p)
    return Option::Some("copy")
  when TokenKind::Inline then
    advance(p)
    return Option::Some("inline")
  when TokenKind::Edition then
    advance(p)
    return Option::Some("edition")
  when _ then
    let span = peek_span(p)
    diag_error(&mut p.diag, ErrorCode::E103ExpectedIdent, "expected identifier", span)
    return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Module
# ———————————————————————————————————————————————————————————————

def parse_module_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[ModuleDecl]
  match expect_ident(p)
  when Option::Some(name) then
    mut segments = Vec::new()
    segments.push(name)
    while at(p, TokenKind::ColonColon) do
      advance(p)
      match expect_ident(p)
      when Option::Some(seg) then segments.push(seg)
      when Option::None then return Option::None
      end
    end
    skip_newlines(p)
    mut items = Vec::new()
    
    while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
      let before_pos = p.pos
      match parse_item(p)
      when Option::Some(item) then items.push(item)
      when Option::None then
        synchronize(p)
        if p.pos == before_pos then
          advance(p)
        end
      end
      skip_newlines(p)
    end
    
    expect_end(p)
    let module_span = span_merge(start, peek_span(p))
    mut nested_items = items
    mut segment_index = segments.len() - 1
    while segment_index > 0 do
      let nested_module = ModuleDecl {
        vis: vis,
        name: segments[segment_index].clone(),
        items: nested_items,
        is_inline: true,
        span: module_span
      }
      let nested_item = make_item(ItemKind::Module(nested_module), module_span)
      nested_items = Vec::new()
      nested_items.push(nested_item)
      segment_index = segment_index - 1
    end
    return Option::Some(ModuleDecl {
      vis: vis,
      name: segments[0].clone(),
      items: nested_items,
      is_inline: true,
      span: module_span
    })
  when Option::None then
    return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Function
# ———————————————————————————————————————————————————————————————

def parse_function_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[FunctionDecl]
  parse_function_decl_full(p, vis, start, false, false, false, false, false)
end

def parse_function_decl_with_async(p: &mut TgcParser, vis: Visibility, start: Span, is_async: Bool) -> Option[FunctionDecl]
  parse_function_decl_full(p, vis, start, is_async, false, false, false, false)
end

def parse_function_decl_with_unsafe(p: &mut TgcParser, vis: Visibility, start: Span, is_unsafe: Bool) -> Option[FunctionDecl]
  parse_function_decl_full(p, vis, start, false, is_unsafe, false, false, false)
end

def parse_function_decl_with_pure(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[FunctionDecl]
  parse_function_decl_full(p, vis, start, false, false, false, false, true)
end

def parse_function_decl_with_inline(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[FunctionDecl]
  parse_function_decl_full(p, vis, start, false, false, false, true, false)
end

def parse_function_decl_full(
  p: &mut TgcParser, 
  vis: Visibility, 
  start: Span,
  is_async: Bool,
  is_unsafe: Bool,
  is_const: Bool,
  is_inline: Bool,
  is_pure: Bool
) -> Option[FunctionDecl]
  match expect_ident(p)
  when Option::Some(first_name) then
    # Handle qualified names: def Type::method(...) → name becomes "Type__method"
    mut name = first_name
    if at(p, TokenKind::ColonColon) then
      advance(p)
      match expect_ident(p)
      when Option::Some(method_name) then name = first_name + "__" + method_name
      when Option::None then ()
      end
    end
    let generic_params = parse_generic_params(p)
    expect(p, TokenKind::LParen)
    let params = parse_param_list(p)
    expect(p, TokenKind::RParen)
    
    mut ret_type = Option::None
    if at(p, TokenKind::Arrow) then
      advance(p)
      match parse_type(p)
      when Option::Some(ty) then ret_type = Option::Some(ty)
      when Option::None then
        diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected type after '->'", peek_span(p))
      end
    end
    
    # Parse standalone where clause (in addition to bounds in generics)
    mut where_clause = Vec::new()
    if at_keyword(p, "where") then
      advance(p)
      where_clause = parse_where_predicates(p)
    end
    
    # Parse contracts, budget, requires, effects
    mut contracts = Vec::new()
    mut budget_opt = Option::None
    mut required_caps = Vec::new()
    mut effects = Vec::new()
    skip_newlines(p)
    
    while true do
      match peek(p)
      when TokenKind::Pre then
        let cspan = peek_span(p)
        advance(p)
        match parse_expr(p)
        when Option::Some(expr) then
          let msg = parse_optional_message(p)
          contracts.push(ContractClause { 
            kind: tg_compiler::ast::AstContractKind::AstPre, 
            expr: expr, 
            message: msg, 
            span: cspan 
          })
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::Post then
        let cspan = peek_span(p)
        advance(p)
        match parse_expr(p)
        when Option::Some(expr) then
          let msg = parse_optional_message(p)
          contracts.push(ContractClause { 
            kind: tg_compiler::ast::AstContractKind::AstPost, 
            expr: expr, 
            message: msg, 
            span: cspan 
          })
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::Ensures then
        let cspan = peek_span(p)
        advance(p)
        match parse_expr(p)
        when Option::Some(expr) then
          let msg = parse_optional_message(p)
          contracts.push(ContractClause { 
            kind: tg_compiler::ast::AstContractKind::AstPost, 
            expr: expr, 
            message: msg, 
            span: cspan 
          })
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::Invariant then
        let cspan = peek_span(p)
        advance(p)
        match parse_expr(p)
        when Option::Some(expr) then
          let msg = parse_optional_message(p)
          contracts.push(ContractClause { 
              kind: tg_compiler::ast::AstContractKind::AstInvariant, 
            expr: expr, 
            message: msg, 
            span: cspan 
          })
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::Requires then
        advance(p)
        match expect_ident(p)
        when Option::Some(cap_name) then
          required_caps.push(cap_name)
          while at(p, TokenKind::Comma) do
            advance(p)
            match expect_ident(p)
            when Option::Some(cn) then required_caps.push(cn)
            when Option::None then break
            end
          end
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::Effect then
        advance(p)
        match expect_ident(p)
        when Option::Some(eff_name) then
          effects.push(eff_name)
          while at(p, TokenKind::Comma) do
            advance(p)
            match expect_ident(p)
            when Option::Some(en) then effects.push(en)
            when Option::None then break
            end
          end
          skip_newlines(p)
        when Option::None then break
        end
      when TokenKind::At then
        # @budget annotation
        let saved_pos = p.pos
        advance(p)
        if at(p, TokenKind::Budget) then
          let bspan = peek_span(p)
          advance(p)
          match parse_budget_annotation(p, bspan)
          when Option::Some(b) then
            budget_opt = Option::Some(b)
            skip_newlines(p)
          when Option::None then break
          end
        else
          p.pos = saved_pos
          break
        end
      when _ then break
      end
    end
    # Parse body
    mut body = FnBody::FnNone
    if at(p, TokenKind::Eq) then
      advance(p)
      match parse_expr(p)
      when Option::Some(expr) then body = FnBody::FnExpr(expr)
      when Option::None then ()
      end
    else
      match parse_block_body(p)
      when Option::Some(block) then
        expect_end(p)
        body = FnBody::FnBlock(block)
      when Option::None then ()
      end
    end
    
    return Option::Some(FunctionDecl {
      vis: vis,
      name: name,
      generic_params: generic_params,
      params: params,
      ret_type: ret_type,
      where_clause: where_clause,
      body: body,
      is_async: is_async,
      is_unsafe: is_unsafe,
      is_const: is_const,
      is_inline: is_inline,
      is_pure: is_pure,
      contracts: contracts,
      budget_val: budget_opt,
      required_caps: required_caps,
      effects: effects,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then
    return Option::None
  end
end

def parse_optional_message(p: &mut TgcParser) -> Option[String]
  if at(p, TokenKind::Comma) then
    advance(p)
    match peek(p)
    when TokenKind::StringLit(s) then
      advance(p)
      return Option::Some(s)
    when _ then return Option::None
    end
  else
    return Option::None
  end
end

def parse_generic_params(p: &mut TgcParser) -> Vec[GenericParam]
  mut params = Vec::new()
  if at(p, TokenKind::LBracket) then
    advance(p)
    if !at(p, TokenKind::RBracket) then
      match parse_single_generic_param(p)
      when Option::Some(param) then params.push(param)
      when Option::None then ()
      end
      
      while at(p, TokenKind::Comma) do
        advance(p)
        match parse_single_generic_param(p)
        when Option::Some(param) then params.push(param)
        when Option::None then break
        end
      end
    end
    expect(p, TokenKind::RBracket)
  end
  
  # Parse optional where clause: where T: Trait + Trait2, U: OtherTrait
  if at_keyword(p, "where") then
    advance(p)
    parse_where_clause(p, &mut params)
  end
  
  params
end

def parse_single_generic_param(p: &mut TgcParser) -> Option[GenericParam]
  match expect_ident(p)
  when Option::Some(name) then
    mut bounds = Vec::new()
    # Parse inline bounds: T: Trait + Trait2
    if at(p, TokenKind::Colon) then
      advance(p)
      bounds = parse_type_bounds(p)
    end
    return Option::Some(GenericParam { 
      name: name, 
      bounds: bounds, 
      default: Option::None, 
      span: peek_span(p) 
    })
  when Option::None then return Option::None
  end
end

def parse_type_bounds(p: &mut TgcParser) -> Vec[TypeExpr]
  mut bounds = Vec::new()
  match parse_type(p)
  when Option::Some(bound) then bounds.push(bound)
  when Option::None then return bounds
  end
  while at(p, TokenKind::Plus) do
    advance(p)
    match parse_type(p)
    when Option::Some(bound) then bounds.push(bound)
    when Option::None then break
    end
  end
  bounds
end

def parse_where_clause(p: &mut TgcParser, params: &mut Vec[GenericParam]) -> Unit
  # Parse: T: Bound1 + Bound2, U: Bound3
  loop
    match expect_ident(p)
    when Option::Some(type_name) then
      if at(p, TokenKind::Colon) then
        advance(p)
        let bounds = parse_type_bounds(p)
        # Find the matching generic param and add bounds
        mut found = false
        for param in params do
          if param.name == type_name then
            for b in bounds do
              param.bounds.push(b)
            end
            found = true
          end
        end
        if !found then
          diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "where clause references unknown type parameter: " + type_name, peek_span(p))
        end
      end
      if !at(p, TokenKind::Comma) then break end
      advance(p)
    when Option::None then break
    end
  end
end

# Parse where clause returning WherePredicate list
def parse_where_predicates(p: &mut TgcParser) -> Vec[WherePredicate]
  mut predicates = Vec::new()
  loop
    let start = peek_span(p)
    match parse_type(p)
    when Option::Some(ty) then
      if at(p, TokenKind::Colon) then
        advance(p)
        mut bounds = Vec::new()
        match parse_type(p)
        when Option::Some(bound) then bounds.push(bound)
        when Option::None then ()
        end
        while at(p, TokenKind::Plus) do
          advance(p)
          match parse_type(p)
          when Option::Some(bound) then bounds.push(bound)
          when Option::None then break
          end
        end
        predicates.push(WherePredicate {
          ty: ty,
          bounds: bounds,
          span: span_merge(start, peek_span(p))
        })
      end
      if !at(p, TokenKind::Comma) then break end
      advance(p)
    when Option::None then break
    end
  end
  predicates
end

def parse_param_list(p: &mut TgcParser) -> Vec[Param]
  mut params = Vec::new()
  skip_newlines(p)
  if at(p, TokenKind::RParen) then
    return params
  end
  
  match parse_param(p)
  when Option::Some(param) then params.push(param)
  when Option::None then ()
  end
  
  while at(p, TokenKind::Comma) do
    advance(p)
    skip_newlines(p)
    if at(p, TokenKind::RParen) then break end
    match parse_param(p)
    when Option::Some(param) then params.push(param)
    when Option::None then break
    end
  end
  
  skip_newlines(p)
  params
end

def parse_param(p: &mut TgcParser) -> Option[Param]
  let start = peek_span(p)
  
  mut modifier = Option::None
  if at(p, TokenKind::Mut) then
    advance(p)
    modifier = Option::Some(ParamModifier::Mut)
  elsif at(p, TokenKind::AmpMut) then
    advance(p)
    modifier = Option::Some(ParamModifier::RefMut)
  elsif at(p, TokenKind::Amp) then
    advance(p)
    modifier = Option::Some(ParamModifier::Ref)
  elsif at(p, TokenKind::TkMove) then
    advance(p)
    modifier = Option::Some(ParamModifier::Move)
  elsif at(p, TokenKind::TkOwn) then
    advance(p)
    modifier = Option::Some(ParamModifier::Own)
  end
  
  match expect_ident(p)
  when Option::Some(name) then
    mut ty = Option::None
    if at(p, TokenKind::Colon) then
      advance(p)
      ty = parse_type(p)
    end
    
    mut default = Option::None
    if at(p, TokenKind::Eq) then
      advance(p)
      default = parse_expr(p)
    end
    
    return Option::Some(Param {
      modifier: modifier,
      name: name,
      ty: ty,
      default: default,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then
    return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Macro
# ———————————————————————————————————————————————————————————————

def parse_macro_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[MacroDecl]
  match expect_ident(p)
  when Option::Some(name) then
    expect(p, TokenKind::LParen)
    let params = parse_param_list(p)
    expect(p, TokenKind::RParen)
    skip_newlines(p)
    
    match parse_block_body(p)
    when Option::Some(body) then
      expect_end(p)
      return Option::Some(MacroDecl {
        vis: vis,
        name: name,
        params: params,
        body: body,
        span: span_merge(start, peek_span(p))
      })
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Struct
# ———————————————————————————————————————————————————————————————

def parse_struct_decl(p: &mut TgcParser, vis: Visibility, start: Span, derives: Vec[String]) -> Option[StructDecl]
  match expect_ident(p)
  when Option::Some(name) then
    let generic_params = parse_generic_params(p)
    skip_newlines(p)
    skip_doc_comments(p)
    
    mut fields = Vec::new()
    while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
      skip_newlines(p)
      skip_doc_comments(p)
      if at(p, TokenKind::End) then break end
      let before_pos = p.pos
      match parse_field_decl(p)
      when Option::Some(f) then fields.push(f)
      when Option::None then
        synchronize(p)
        if p.pos == before_pos then
          advance(p)
        end
      end
    end
    
    expect_end(p)
    return Option::Some(StructDecl {
      vis: vis,
      name: name,
      generic_params: generic_params,
      fields: fields,
      derives: derives,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then
    return Option::None
  end
end

def parse_field_decl(p: &mut TgcParser) -> Option[FieldDecl]
  let start = peek_span(p)
  let vis = parse_visibility(p)
  
  match expect_ident(p)
  when Option::Some(name) then
    expect(p, TokenKind::Colon)
    match parse_type(p)
    when Option::Some(ty) then
      mut default = Option::None
      if at(p, TokenKind::Eq) then
        advance(p)
        default = parse_expr(p)
      end
      eat_optional_semi(p)
      skip_newlines(p)
      return Option::Some(FieldDecl {
        vis: vis,
        name: name,
        ty: ty,
        default: default,
        span: span_merge(start, peek_span(p))
      })
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Enum
# ———————————————————————————————————————————————————————————————

def parse_enum_decl(p: &mut TgcParser, vis: Visibility, start: Span, derives: Vec[String]) -> Option[EnumDecl]
  match expect_ident(p)
  when Option::Some(name) then
    let generic_params = parse_generic_params(p)
    skip_newlines(p)
    skip_doc_comments(p)
    
    mut variants = Vec::new()
    while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
      skip_newlines(p)
      skip_doc_comments(p)
      if at(p, TokenKind::End) then break end
      let before_pos = p.pos
      match parse_variant_decl(p)
      when Option::Some(v) then variants.push(v)
      when Option::None then
        synchronize(p)
        if p.pos == before_pos then
          advance(p)
        end
      end
    end
    
    expect_end(p)
    return Option::Some(EnumDecl {
      vis: vis,
      name: name,
      generic_params: generic_params,
      variants: variants,
      derives: derives,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_variant_field(p: &mut TgcParser) -> (Option[String], Option[TypeExpr])
  # variant_field = [ IDENT ':' ] type_expr
  # Check if this is a named field (lookahead for Ident Colon)
  match peek(p)
  when TokenKind::Ident(_) then
    if p.pos + 1 < p.tokens.len() then
      match p.tokens[p.pos + 1].kind
      when TokenKind::Colon then
        # Named field — capture name, skip colon, then parse the type
        let field_name = expect_ident(p)
        advance(p)
        return (field_name, parse_type(p))
      when _ then ()
      end
    end
  when _ then ()
  end
  # Positional field — just a type
  (Option::None, parse_type(p))
end

def parse_variant_decl(p: &mut TgcParser) -> Option[VariantDecl]
  let start = peek_span(p)
  match expect_ident(p)
  when Option::Some(name) then
    mut fields = Vec::new()
    mut field_names = Vec::new()
    if at(p, TokenKind::LParen) then
      advance(p)
      if !at(p, TokenKind::RParen) then
        let (fn0, ty0) = parse_variant_field(p)
        match ty0
        when Option::Some(ty) then
          fields.push(ty)
          field_names.push(fn0)
        when Option::None then ()
        end
        while at(p, TokenKind::Comma) do
          advance(p)
          let (fn_n, ty_n) = parse_variant_field(p)
          match ty_n
          when Option::Some(ty) then
            fields.push(ty)
            field_names.push(fn_n)
          when Option::None then break
          end
        end
      end
      expect(p, TokenKind::RParen)
    elsif at(p, TokenKind::LBrace) then
      # Named fields with curly braces: Variant { field: Type, ... }
      advance(p)
      skip_newlines(p)
      skip_doc_comments(p)
      if !at(p, TokenKind::RBrace) then
        let (fn0, ty0) = parse_variant_field(p)
        match ty0
        when Option::Some(ty) then
          fields.push(ty)
          field_names.push(fn0)
        when Option::None then ()
        end
        while at(p, TokenKind::Comma) do
          advance(p)
          skip_newlines(p)
          skip_doc_comments(p)
          if at(p, TokenKind::RBrace) then break end
          let (fn_n, ty_n) = parse_variant_field(p)
          match ty_n
          when Option::Some(ty) then
            fields.push(ty)
            field_names.push(fn_n)
          when Option::None then break
          end
        end
      end
      skip_newlines(p)
      expect(p, TokenKind::RBrace)
    end
    eat_optional_semi(p)
    skip_newlines(p)
    return Option::Some(VariantDecl {
      name: name,
      fields: fields,
      field_names: field_names,
      discriminant: Option::None,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Trait
# ———————————————————————————————————————————————————————————————

def parse_trait_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[TraitDecl]
  match expect_ident(p)
  when Option::Some(name) then
    let generic_params = parse_generic_params(p)
    mut super_traits = Vec::new()
    if at(p, TokenKind::Colon) then
      advance(p)
      match parse_type(p)
      when Option::Some(ty) then super_traits.push(ty)
      when Option::None then ()
      end
      while at(p, TokenKind::Plus) do
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then super_traits.push(ty)
        when Option::None then break
        end
      end
    end
    skip_newlines(p)
    
    mut methods = Vec::new()
    mut assoc_types = Vec::new()
    while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
      skip_newlines(p)
      if at(p, TokenKind::End) then break end
      let saved_pos = p.pos
      if consume_function_decl_prefix(p) then
        match parse_function_sig(p)
        when Option::Some(sig) then
          # Check for default method body
          # A default body starts either with 'do' or on the next line (not 'end'/'def'/EOF)
          let saved_body_pos = p.pos
          skip_newlines(p)
          mut has_body = true
          if at(p, TokenKind::End) || at_function_decl_start(p) || at(p, TokenKind::Eof) then
            # No body — just a method signature
            p.pos = saved_body_pos
            has_body = false
          elsif at_keyword(p, "type") then
            p.pos = saved_body_pos
            has_body = false
          else
            # There's a body — restore position for parse_block_body
            p.pos = saved_body_pos
          end
          mut default_body = Option::None
          if has_body then
            match parse_block_body(p)
            when Option::Some(body) then
              expect_end(p)
              default_body = Option::Some(body)
            when Option::None then ()
            end
          end
          methods.push(TraitMethod { sig: sig, default_body: default_body, span: sig.span })
        when Option::None then synchronize(p)
        end
      elsif p.pos != saved_pos then
        synchronize(p)
      elsif at_keyword(p, "type") then
        # Associated type: type Item or type Item = DefaultType
        advance(p)
        match expect_ident(p)
        when Option::Some(type_name) then
          mut bounds = Vec::new()
          if at(p, TokenKind::Colon) then
            advance(p)
            bounds = parse_type_bounds(p)
          end
          mut default = Option::None
          if at(p, TokenKind::Eq) then
            advance(p)
            default = parse_type(p)
          end
          assoc_types.push(AssocType { name: type_name, bounds: bounds, default: default, span: peek_span(p) })
        when Option::None then synchronize(p)
        end
      else
        synchronize(p)
      end
      # If no progress was made, force advance to prevent infinite loop
      if p.pos == saved_pos then
        advance(p)
      end
    end
    
    expect_end(p)
    return Option::Some(TraitDecl {
      vis: vis,
      name: name,
      generic_params: generic_params,
      super_traits: super_traits,
      methods: methods,
      assoc_types: assoc_types,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_function_sig(p: &mut TgcParser) -> Option[FunctionSig]
  let start = peek_span(p)
  match expect_ident(p)
  when Option::Some(name) then
    let generic_params = parse_generic_params(p)
    expect(p, TokenKind::LParen)
    let params = parse_param_list(p)
    expect(p, TokenKind::RParen)
    mut ret_type = Option::None
    if at(p, TokenKind::Arrow) then
      advance(p)
      match parse_type(p)
      when Option::Some(ty) then ret_type = Option::Some(ty)
      when Option::None then return Option::None
      end
    end
    eat_optional_semi(p)
    return Option::Some(FunctionSig {
      name: name,
      generic_params: generic_params,
      params: params,
      ret_type: ret_type,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Impl
# ———————————————————————————————————————————————————————————————

def parse_impl_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[ImplDecl]
  # Support impl[T] Trait for Type syntax (leading generics)
  mut leading_generics = Vec::new()
  if at(p, TokenKind::LBracket) then
    leading_generics = parse_generic_params(p)
  end
  match expect_ident(p)
  when Option::Some(first_name) then
    let type_generics = parse_generic_params(p)
    mut generic_params = type_generics
    if leading_generics.len() > 0 then
      generic_params = leading_generics
    end
    
    # Check if this is `impl Trait for Type` or `impl Type` (inherent)
    if at(p, TokenKind::For) then
      # Trait impl: impl TraitName[T] for Type
      advance(p)
      match parse_type(p)
      when Option::Some(for_type) then
        # Parse optional where clause
        mut where_preds = Vec::new()
        if at_keyword(p, "where") then
          advance(p)
          where_preds = parse_where_predicates(p)
        end
        return parse_impl_body_with_where(p, vis, start, generic_params, Option::Some(first_name), for_type, where_preds)
      when Option::None then return Option::None
      end
    else
      # Inherent impl: impl Type
      mut type_args = Vec::new()
      for g in generic_params do
        type_args.push(make_type_expr(TypeExprKind::Named(g.name.clone(), Vec::new()), start))
      end
      let for_type = make_type_expr(TypeExprKind::Named(first_name, type_args), start)
      # Parse optional where clause for inherent impl
      mut where_preds = Vec::new()
      if at_keyword(p, "where") then
        advance(p)
        where_preds = parse_where_predicates(p)
      end
      return parse_impl_body_with_where(p, vis, start, generic_params, Option::None, for_type, where_preds)
    end
  when Option::None then return Option::None
  end
end

def parse_impl_body_with_where(
  p: &mut TgcParser, 
  vis: Visibility,
  start: Span, 
  generic_params: Vec[GenericParam],
  trait_name: Option[String],
  for_type: TypeExpr,
  where_clause: Vec[WherePredicate]
) -> Option[ImplDecl]
  skip_newlines(p)
  
  mut methods = Vec::new()
  mut assoc_types = Vec::new()
  while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
    skip_newlines(p)
    if at(p, TokenKind::End) then break end
    let before_pos = p.pos
    let method_vis = parse_visibility(p)
    if at_function_decl_start(p) then
      let fn_start = peek_span(p)
      match parse_prefixed_function_decl(p, method_vis, fn_start)
      when Option::Some(f) then methods.push(f)
      when Option::None then synchronize(p)
      end
    elsif at_keyword(p, "type") then
      advance(p)
      match expect_ident(p)
      when Option::Some(type_name) then
        expect(p, TokenKind::Eq)
        match parse_type(p)
        when Option::Some(impl_ty) then
          eat_optional_semi(p)
          assoc_types.push(AssocTypeImpl {
            name: type_name,
            ty: impl_ty,
            span: peek_span(p)
          })
        when Option::None then synchronize(p)
        end
      when Option::None then synchronize(p)
      end
    else
      synchronize(p)
    end
    if p.pos == before_pos then
      advance(p)
    end
  end
  
  expect_end(p)
  return Option::Some(ImplDecl {
    vis: vis,
    generic_params: generic_params,
    trait_name: trait_name,
    for_type: for_type.clone(),
    self_type: for_type,
    where_clause: where_clause,
    methods: methods,
    assoc_types: assoc_types,
    span: span_merge(start, peek_span(p))
  })
end

# ———————————————————————————————————————————————————————————————
# Type Alias, Const, Static
# ———————————————————————————————————————————————————————————————

def parse_type_alias(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[TypeAliasDecl]
  match expect_ident(p)
  when Option::Some(name) then
    let generic_params = parse_generic_params(p)
    expect(p, TokenKind::Eq)
    match parse_type(p)
    when Option::Some(ty) then
      eat_optional_semi(p)
      return Option::Some(TypeAliasDecl {
        vis: vis,
        name: name,
        generic_params: generic_params,
        ty: ty,
        span: span_merge(start, peek_span(p))
      })
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

def parse_const(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[ConstDecl]
  match expect_ident(p)
  when Option::Some(name) then
    mut ty = Option::None
    if at(p, TokenKind::Colon) then
      advance(p)
      ty = parse_type(p)
    end
    expect(p, TokenKind::Eq)
    match parse_expr(p)
    when Option::Some(value) then
      eat_optional_semi(p)
      return Option::Some(ConstDecl {
        vis: vis,
        name: name,
        ty: ty,
        value: value,
        span: span_merge(start, peek_span(p))
      })
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

def parse_static(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[StaticDecl]
  mut is_mut = false
  if at(p, TokenKind::Mut) then
    advance(p)
    is_mut = true
  end
  
  match expect_ident(p)
  when Option::Some(name) then
    expect(p, TokenKind::Colon)
    match parse_type(p)
    when Option::Some(ty) then
      expect(p, TokenKind::Eq)
      match parse_expr(p)
      when Option::Some(value) then
        eat_optional_semi(p)
        return Option::Some(StaticDecl {
          vis: vis,
          name: name,
          ty: ty,
          value: value,
          is_mut: is_mut,
          span: span_merge(start, peek_span(p))
        })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Agentic Features
# ———————————————————————————————————————————————————————————————

def parse_capability_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[CapabilityDecl]
  match expect_ident(p)
  when Option::Some(name) then
    mut parent = Option::None
    if at(p, TokenKind::Colon) then
      advance(p)
      parent = expect_ident(p)
    end
    if at(p, TokenKind::End) then advance(p) end
    eat_optional_semi(p)
    return Option::Some(CapabilityDecl {
      vis: vis,
      name: name,
      parent: parent,
      permissions: Vec::new(),
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_effect_decl(p: &mut TgcParser, vis: Visibility, start: Span) -> Option[EffectDecl]
  match expect_ident(p)
  when Option::Some(name) then
    mut parent = Option::None
    if at(p, TokenKind::Colon) then
      advance(p)
      parent = expect_ident(p)
    end
    if at(p, TokenKind::End) then advance(p) end
    eat_optional_semi(p)
    return Option::Some(EffectDecl {
      vis: vis,
      name: name,
      parent: parent,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_budget_annotation(p: &mut TgcParser, start: Span) -> Option[BudgetAnnotation]
  mut constraints = Vec::new()
  
  while true do
    let cstart = peek_span(p)
    match expect_ident(p)
    when Option::Some(metric) then
      # Accept : or < or <= as separator
      if at(p, TokenKind::Colon) then advance(p)
      elsif at(p, TokenKind::LtEq) then advance(p)
      elsif at(p, TokenKind::Lt) then advance(p)
      end
      
      match peek(p)
      when TokenKind::StringLit(bound) then
        advance(p)
        constraints.push(BudgetConstraint {
          metric: metric,
          bound: bound,
          span: span_merge(cstart, peek_span(p))
        })
        if at(p, TokenKind::Comma) then
          advance(p)
        else
          break
        end
      when _ then break
      end
    when Option::None then break
    end
  end
  
  Option::Some(BudgetAnnotation {
    constraints: constraints,
    span: span_merge(start, peek_span(p))
  })
end

def parse_rationale_block(p: &mut TgcParser, start: Span) -> Option[RationaleBlock]
  ## Parse structured rationale block with key: value pairs
  ##   rationale
  ##     objective: "..."
  ##     why: "..."
  ##     author: "Name"
  ##     tag: "label"
  ##   end

  ## If the first token is a bare string literal (old syntax: rationale "title" ... end)
  match peek(p)
  when TokenKind::StringLit(title) then
    advance(p)
    mut body = title.clone()
    while true do
      skip_newlines(p)
      match peek(p)
      when TokenKind::StringLit(s) then
        body = body + "\n" + s
        advance(p)
      when _ then break
      end
    end
    if at(p, TokenKind::End) then advance(p) end
    eat_optional_semi(p)
    return Option::Some(RationaleBlock {
      title: title,
      body: body,
      author: Option::None,
      tags: Vec::new(),
      span: span_merge(start, peek_span(p))
    })
  when _ then ()
  end

  ## Structured key: value format
  mut title = "rationale".to_string()
  mut body = String::new()
  mut author: Option[String] = Option::None
  mut tags: Vec[String] = Vec::new()
  mut fields_found = 0

  while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
    skip_newlines(p)
    if at(p, TokenKind::End) then break end
    match peek(p)
    when TokenKind::Ident(key) then
      let k = key.clone()
      advance(p)
      ## Expect colon separator
      if at(p, TokenKind::Colon) then
        advance(p)
        ## Expect a string value
        match peek(p)
        when TokenKind::StringLit(val) then
          let v = val.clone()
          advance(p)
          if k == "objective" || k == "title" then
            title = v.clone()
            if body.is_empty() then body = v else body = body + "\n" + &v end
          elsif k == "why" || k == "reason" || k == "description" then
            if body.is_empty() then body = v else body = body + "\n" + &v end
          elsif k == "author" then
            author = Option::Some(v)
          elsif k == "tag" then
            tags.push(v)
          elsif k == "tags" then
            ## tags: "a, b, c" — split on comma
            let parts = v.split(",")
            for part in parts do
              let t = part.trim()
              if !t.is_empty() then tags.push(t.to_string()) end
            end
          else
            ## Unknown key — append to body
            if body.is_empty() then
              body = k.clone() + ": " + &v
            else
              body = body + "\n" + &k + ": " + &v
            end
          end
          fields_found = fields_found + 1
        when _ then
          ## Value is not a string — consume as raw text
          if !body.is_empty() then body = body + "\n" end
          body = body + &k + ":"
        end
      else
        ## No colon — treat as raw content
        if !body.is_empty() then body = body + "\n" end
        body = body + &k
      end
    when _ then
      advance(p)
    end
  end

  if at(p, TokenKind::End) then advance(p) end
  eat_optional_semi(p)
  return Option::Some(RationaleBlock {
    title: title,
    body: body,
    author: author,
    tags: tags,
    span: span_merge(start, peek_span(p))
  })
end

def parse_edition_decl(p: &mut TgcParser, start: Span) -> Option[EditionDecl]
  match peek(p)
  when TokenKind::StringLit(version) then
    advance(p)
    eat_optional_semi(p)
    return Option::Some(EditionDecl {
      version: version,
      span: span_merge(start, peek_span(p))
    })
  when _ then
    let span = peek_span(p)
    diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, "expected edition string", span)
    return Option::None
  end
end

def parse_extern_dispatch(p: &mut TgcParser, start: Span) -> Option[Item]
  # Check for optional ABI string: extern "C" def ...
  mut extern_abi = Option::None
  match peek(p)
  when TokenKind::StringLit(s) then
    advance(p)
    skip_newlines(p)
    extern_abi = Option::Some(s)
  when _ then ()
  end
  # Standalone extern def: extern [abi] def foo() -> T (no end block)
  # When an ABI string is present, also handle extern blocks:
  #   extern "ABI" def a() ... def b() ... end
  if at(p, TokenKind::Def) then
    advance(p)
    match parse_extern_fn(p)
    when Option::Some(f) then
      mut items = Vec::from([ExternItem::Function(f)])
      # Only continue parsing more defs when an explicit ABI was given
      # (indicating block syntax like extern "Tangerine" ... end).
      # Without ABI, this is a standalone extern def - don't eat more defs.
      if extern_abi != Option::None then
        skip_newlines(p)
        while at(p, TokenKind::Def) do
          advance(p)
          match parse_extern_fn(p)
          when Option::Some(f2) then items.push(ExternItem::Function(f2))
          when Option::None then break
          end
          skip_newlines(p)
        end
      else
        skip_newlines(p)
      end
      # Consume optional trailing 'end'
      if at(p, TokenKind::End) then advance(p) end
      let ext = ExternBlock {
        abi: extern_abi,
        items: items,
        span: span_merge(start, peek_span(p))
      }
      return Option::Some(make_item(ItemKind::ExternBlock(ext), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  # Standalone extern static: extern [abi] static ...
  elsif at(p, TokenKind::Static) then
    advance(p)
    match parse_extern_static(p)
    when Option::Some(s) then
      let ext = ExternBlock {
        abi: extern_abi,
        items: Vec::from([ExternItem::Static(s)]),
        span: span_merge(start, peek_span(p))
      }
      return Option::Some(make_item(ItemKind::ExternBlock(ext), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  else
    # Full extern block: extern [abi] ... end
    match parse_extern_block_with_abi(p, start, extern_abi)
    when Option::Some(e) then
      return Option::Some(make_item(ItemKind::ExternBlock(e), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  end
end

def parse_extern_block_with_abi(p: &mut TgcParser, start: Span, abi: Option[String]) -> Option[ExternBlock]
  skip_newlines(p)
  mut items = Vec::new()
  while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
    skip_newlines(p)
    if at(p, TokenKind::End) then break end
    let before_pos = p.pos
    if at(p, TokenKind::Def) then
      advance(p)
      match parse_extern_fn(p)
      when Option::Some(f) then items.push(ExternItem::Function(f))
      when Option::None then synchronize(p)
      end
    elsif at(p, TokenKind::Static) then
      advance(p)
      match parse_extern_static(p)
      when Option::Some(s) then items.push(ExternItem::Static(s))
      when Option::None then synchronize(p)
      end
    else
      synchronize(p)
    end
    if p.pos == before_pos then
      advance(p)
    end
  end
  expect_end(p)
  return Option::Some(ExternBlock {
    abi: abi,
    items: items,
    span: span_merge(start, peek_span(p))
  })
end

def parse_extern_block(p: &mut TgcParser, start: Span) -> Option[ExternBlock]
  mut abi = Option::None
  match peek(p)
  when TokenKind::StringLit(s) then
    advance(p)
    abi = Option::Some(s)
  when _ then ()
  end
  
  skip_newlines(p)
  mut items = Vec::new()
  
  while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
    skip_newlines(p)
    if at(p, TokenKind::End) then break end
    let before_pos = p.pos
    if at(p, TokenKind::Def) then
      advance(p)
      match parse_extern_fn(p)
      when Option::Some(f) then items.push(ExternItem::Function(f))
      when Option::None then synchronize(p)
      end
    elsif at(p, TokenKind::Static) then
      advance(p)
      match parse_extern_static(p)
      when Option::Some(s) then items.push(ExternItem::Static(s))
      when Option::None then synchronize(p)
      end
    else
      synchronize(p)
    end
    if p.pos == before_pos then
      advance(p)
    end
  end
  
  expect_end(p)
  return Option::Some(ExternBlock {
    abi: abi,
    items: items,
    span: span_merge(start, peek_span(p))
  })
end

def parse_extern_fn(p: &mut TgcParser) -> Option[ExternFn]
  let start = peek_span(p)
  match expect_ident(p)
  when Option::Some(name) then
    expect(p, TokenKind::LParen)
    let params = parse_param_list(p)
    expect(p, TokenKind::RParen)
    mut ret_type = Option::None
    if at(p, TokenKind::Arrow) then
      advance(p)
      ret_type = parse_type(p)
    end
    eat_optional_semi(p)
    return Option::Some(ExternFn {
      name: name,
      params: params,
      ret_type: ret_type,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_extern_static(p: &mut TgcParser) -> Option[ExternStatic]
  let start = peek_span(p)
  mut is_mut = false
  if at(p, TokenKind::Mut) then
    advance(p)
    is_mut = true
  end
  
  match expect_ident(p)
  when Option::Some(name) then
    expect(p, TokenKind::Colon)
    match parse_type(p)
    when Option::Some(ty) then
      eat_optional_semi(p)
      return Option::Some(ExternStatic {
        name: name,
        ty: ty,
        is_mut: is_mut,
        span: span_merge(start, peek_span(p))
      })
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Types
# ———————————————————————————————————————————————————————————————

def parse_type(p: &mut TgcParser) -> Option[TypeExpr]
  let start = peek_span(p)
  
  match peek(p)
  when TokenKind::Amp then
    advance(p)
    match parse_type(p)
    when Option::Some(inner) then
      return Option::Some(make_type_expr(TypeExprKind::Ref(inner), span_merge(start, inner.span)))
    when Option::None then return Option::None
    end
  when TokenKind::And then
    # &&T is lexed as TokenKind::And; treat as double reference &(&T)
    advance(p)
    match parse_type(p)
    when Option::Some(inner) then
      let ref_inner = make_type_expr(TypeExprKind::Ref(inner), span_merge(start, inner.span))
      return Option::Some(make_type_expr(TypeExprKind::Ref(ref_inner), span_merge(start, inner.span)))
    when Option::None then return Option::None
    end
  when TokenKind::AmpMut then
    advance(p)
    match parse_type(p)
    when Option::Some(inner) then
      return Option::Some(make_type_expr(TypeExprKind::RefMut(inner), span_merge(start, inner.span)))
    when Option::None then return Option::None
    end
  when TokenKind::Star then
    # Raw pointer types (*T and *mut T)
    advance(p)
    mut is_mut = false
    if at(p, TokenKind::Mut) then
      advance(p)
      is_mut = true
    end
    match parse_type(p)
    when Option::Some(inner) then
      if is_mut then
        return Option::Some(make_type_expr(TypeExprKind::PtrMut(inner), span_merge(start, inner.span)))
      else
        return Option::Some(make_type_expr(TypeExprKind::Ptr(inner), span_merge(start, inner.span)))
      end
    when Option::None then return Option::None
    end
  when TokenKind::Def then
    # Function pointer types  fn(T, U) -> V
    advance(p)
    expect(p, TokenKind::LParen)
    mut params = Vec::new()
    if !at(p, TokenKind::RParen) then
      match parse_type(p)
      when Option::Some(ty) then params.push(ty)
      when Option::None then ()
      end
      while at(p, TokenKind::Comma) do
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then params.push(ty)
        when Option::None then break
        end
      end
    end
    expect(p, TokenKind::RParen)
    mut ret = make_type_expr(TypeExprKind::Unit, peek_span(p))
    if at(p, TokenKind::Arrow) then
      advance(p)
      match parse_type(p)
      when Option::Some(ty) then ret = ty
      when Option::None then ()
      end
    end
    return Option::Some(make_type_expr(TypeExprKind::Fn(params, ret), span_merge(start, ret.span)))
  when TokenKind::LParen then
    advance(p)
    if at(p, TokenKind::RParen) then
      advance(p)
      return Option::Some(make_type_expr(TypeExprKind::Unit, span_merge(start, peek_span(p))))
    else
      mut types = Vec::new()
      match parse_type(p)
      when Option::Some(ty) then types.push(ty)
      when Option::None then ()
      end
      while at(p, TokenKind::Comma) do
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then types.push(ty)
        when Option::None then break
        end
      end
      expect(p, TokenKind::RParen)
      if types.len() == 1 then
        return Option::Some(types[0])
      else
        return Option::Some(make_type_expr(TypeExprKind::Tuple(types), span_merge(start, peek_span(p))))
      end
    end
  when TokenKind::LBracket then
    advance(p)
    match parse_type(p)
    when Option::Some(inner) then
      mut size = Option::None
      if at(p, TokenKind::Semicolon) then
        advance(p)
        size = parse_expr(p)
      end
      expect(p, TokenKind::RBracket)
      if size.is_some() then
        return Option::Some(make_type_expr(TypeExprKind::Array(inner, size), span_merge(start, peek_span(p))))
      else
        return Option::Some(make_type_expr(TypeExprKind::Slice(inner), span_merge(start, peek_span(p))))
      end
    when Option::None then return Option::None
    end
  when TokenKind::Async then
    advance(p)
    match parse_type(p)
    when Option::Some(inner) then
      return Option::Some(make_type_expr(TypeExprKind::Async(inner), span_merge(start, inner.span)))
    when Option::None then return Option::None
    end
  when TokenKind::SelfType then
    advance(p)
    return Option::Some(make_type_expr(TypeExprKind::Named("Self", Vec::new()), span_merge(start, peek_span(p))))
  when TokenKind::Ident(name) then
    advance(p)
    # Handle dyn keyword for trait objects: dyn Trait → just parse Trait
    # e.g. &dyn Error → &Error, Box[dyn Any] → Box[Any]
    if name == "dyn" then
      return parse_type(p)
    end
    # Handle Fn(...) -> Ret function types
    # Also handle "fn" and "def" as identifiers — defensive fallback for when
    # the keyword lookup fails to map fn/def to TokenKind::Def during bootstrap
    if (name == "Fn" || name == "FnOnce" || name == "FnMut" || name == "fn" || name == "def") && at(p, TokenKind::LParen) then
      advance(p)
      mut params = Vec::new()
      if !at(p, TokenKind::RParen) then
        match parse_type(p)
        when Option::Some(ty) then params.push(ty)
        when Option::None then ()
        end
        while at(p, TokenKind::Comma) do
          advance(p)
          match parse_type(p)
          when Option::Some(ty) then params.push(ty)
          when Option::None then break
          end
        end
      end
      expect(p, TokenKind::RParen)
      mut ret = make_type_expr(TypeExprKind::Unit, peek_span(p))
      if at(p, TokenKind::Arrow) then
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then ret = ty
        when Option::None then ()
        end
      end
      return Option::Some(make_type_expr(TypeExprKind::Fn(params, ret), span_merge(start, ret.span)))
    end
    if at(p, TokenKind::ColonColon) then
      mut segments = Vec::new()
      segments.push(name)
      while at(p, TokenKind::ColonColon) do
        advance(p)
        match expect_ident(p)
        when Option::Some(seg) then segments.push(seg)
        when Option::None then break
        end
      end
      return Option::Some(make_type_expr(TypeExprKind::Path(make_path(segments, span_merge(start, peek_span(p)))), span_merge(start, peek_span(p))))
    end
    mut type_args = Vec::new()
    if at(p, TokenKind::LBracket) then
      advance(p)
      if !at(p, TokenKind::RBracket) then
        match parse_type(p)
        when Option::Some(ty) then type_args.push(ty)
        when Option::None then ()
        end
        while at(p, TokenKind::Comma) do
          advance(p)
          match parse_type(p)
          when Option::Some(ty) then type_args.push(ty)
          when Option::None then break
          end
        end
      end
      expect(p, TokenKind::RBracket)
    end
    let base_ty = make_type_expr(TypeExprKind::Named(name, type_args), span_merge(start, peek_span(p)))
    # T? option shorthand (desugars to Option[T])
    if at(p, TokenKind::Question) then
      advance(p)
      let option_ty = make_type_expr(TypeExprKind::Named("Option".to_string(), Vec::from([base_ty])), span_merge(start, peek_span(p)))
      return Option::Some(option_ty)
    else
      return Option::Some(base_ty)
    end
  when TokenKind::SelfType then
    # Self type parsing, including Self::AssocType paths
    advance(p)
    if at(p, TokenKind::ColonColon) then
      advance(p)
      mut segments = Vec::new()
      segments.push("Self".to_string())
      match expect_ident(p)
      when Option::Some(seg) then segments.push(seg)
      when Option::None then ()
      end
      while at(p, TokenKind::ColonColon) do
        advance(p)
        match expect_ident(p)
        when Option::Some(seg) then segments.push(seg)
        when Option::None then break
        end
      end
      return Option::Some(make_type_expr(TypeExprKind::Path(make_path(segments, span_merge(start, peek_span(p)))), span_merge(start, peek_span(p))))
    else
      return Option::Some(make_type_expr(TypeExprKind::Named("Self".to_string(), Vec::new()), span_merge(start, peek_span(p))))
    end
  when _ then
    diag_error(&mut p.diag, ErrorCode::E102ExpectedType, "expected type", start)
    return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Block & Statements
# ———————————————————————————————————————————————————————————————

def parse_block_body(p: &mut TgcParser) -> Option[Block]
  skip_newlines(p)
  skip_doc_comments(p)
  let start = peek_span(p)
  mut stmts = Vec::new()
  
  while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) && !at(p, TokenKind::Elsif) && !at(p, TokenKind::Else) && !at(p, TokenKind::When) && !at(p, TokenKind::Catch) && !at(p, TokenKind::Finally) && !at(p, TokenKind::With) do
    skip_newlines(p)
    skip_doc_comments(p)
    if at(p, TokenKind::End) || at(p, TokenKind::Eof) || at(p, TokenKind::Elsif) || at(p, TokenKind::Else) || at(p, TokenKind::When) || at(p, TokenKind::Catch) || at(p, TokenKind::Finally) || at(p, TokenKind::With) then
      break
    end
    let before_pos = p.pos
    match parse_stmt(p)
    when Option::Some(s) then stmts.push(s)
    when Option::None then
      synchronize(p)
      # If synchronize made no progress, force advance to prevent infinite loop
      if p.pos == before_pos then
        advance(p)
      end
    end
    skip_newlines(p)
    skip_doc_comments(p)
  end
  
  Option::Some(make_block(stmts, span_merge(start, peek_span(p))))
end

def parse_stmt(p: &mut TgcParser) -> Option[Stmt]
  let start = peek_span(p)
  let pk = peek(p)
  
  if pk == TokenKind::Let then
    advance(p)
    # Support 'let mut'
    mut is_mutable = false
    if at(p, TokenKind::Mut) then
      advance(p)
      is_mutable = true
    end
    match parse_pattern(p)
    when Option::Some(pat) then
      mut ty = Option::None
      if at(p, TokenKind::Colon) then
        advance(p)
        ty = parse_type(p)
      end
      expect(p, TokenKind::Eq)
      match parse_expr(p)
      when Option::Some(value) then
        eat_optional_semi(p)
        return Option::Some(make_stmt(StmtKind::StmtLet(pat, ty, value, is_mutable), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Mut then
    advance(p)
    match expect_ident(p)
    when Option::Some(name) then
      mut ty = Option::None
      if at(p, TokenKind::Colon) then
        advance(p)
        ty = parse_type(p)
      end
      expect(p, TokenKind::Eq)
      match parse_expr(p)
      when Option::Some(value) then
        eat_optional_semi(p)
        let pat = make_pattern(PatternKind::Ident(name, true), span_merge(start, peek_span(p)))
        return Option::Some(make_stmt(StmtKind::StmtLet(pat, ty, value, true), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Use then
    advance(p)
    match parse_use_decl(p, start)
    when Option::Some(_) then
      eat_optional_semi(p)
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Budget then
    advance(p)
    match parse_budget_annotation(p, start)
    when Option::Some(_) then
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Return then
    advance(p)
    mut val = Option::None
    if is_expr_start(peek(p)) then
      val = parse_expr(p)
    end
    eat_optional_semi(p)
    return Option::Some(make_stmt(StmtKind::StmtReturn(val), span_merge(start, peek_span(p))))
  elsif pk == TokenKind::Break then
    advance(p)
    mut val = Option::None
    if is_expr_start(peek(p)) then
      val = parse_expr(p)
    end
    eat_optional_semi(p)
    return Option::Some(make_stmt(StmtKind::StmtBreak(val), span_merge(start, peek_span(p))))
  elsif pk == TokenKind::Next then
    advance(p)
    eat_optional_semi(p)
    return Option::Some(make_stmt(StmtKind::StmtContinue, span_merge(start, peek_span(p))))
  elsif pk == TokenKind::Yield then
    advance(p)
    mut val = Option::None
    if is_expr_start(peek(p)) then
      val = parse_expr(p)
    end
    eat_optional_semi(p)
    return Option::Some(make_stmt(StmtKind::StmtYield(val), span_merge(start, peek_span(p))))
  elsif pk == TokenKind::While then
    advance(p)
    match parse_expr(p)
    when Option::Some(cond) then
      skip_newlines(p)
      if at(p, TokenKind::Do) then
        advance(p)
      end
      skip_newlines(p)
      match parse_block_body(p)
      when Option::Some(body) then
        expect_end(p)
        return Option::Some(make_stmt(StmtKind::StmtWhile(cond, body), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Until then
    advance(p)
    match parse_expr(p)
    when Option::Some(cond) then
      skip_newlines(p)
      if at(p, TokenKind::Do) then
        advance(p)
      end
      skip_newlines(p)
      let neg_cond = make_expr(ExprKind::ExprUnaryOp(UnOp::Not, Box::new(cond)), cond.span)
      match parse_block_body(p)
      when Option::Some(body) then
        expect_end(p)
        return Option::Some(make_stmt(StmtKind::StmtWhile(neg_cond, body), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::For then
    advance(p)
    match parse_pattern(p)
    when Option::Some(pat) then
      expect(p, TokenKind::In)
      match parse_expr(p)
      when Option::Some(iter) then
        skip_newlines(p)
        if at(p, TokenKind::Do) then
          advance(p)
        end
        skip_newlines(p)
        match parse_block_body(p)
        when Option::Some(body) then
          expect_end(p)
          return Option::Some(make_stmt(StmtKind::StmtFor(pat, iter, body), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::If then
    match parse_if_stmt(p)
    when Option::Some(if_stmt) then
      return Option::Some(make_stmt(StmtKind::StmtIf(if_stmt), span_merge(start, if_stmt.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Unless then
    advance(p)
    match parse_expr(p)
    when Option::Some(cond) then
      skip_newlines(p)
      if at(p, TokenKind::Then) then
        advance(p)
      end
      skip_newlines(p)
      let neg_cond = make_expr(ExprKind::ExprUnaryOp(UnOp::Not, Box::new(cond)), cond.span)
      match parse_block_body(p)
      when Option::Some(then_block) then
        mut else_block = Option::None
        if at(p, TokenKind::Else) then
          advance(p)
          skip_newlines(p)
          else_block = parse_block_body(p)
        end
        expect_end(p)
        let if_stmt = IfStmt {
          cond: neg_cond,
          then_block: then_block,
          elsif_branches: Vec::new(),
          else_block: else_block,
          span: span_merge(start, peek_span(p))
        }
        return Option::Some(make_stmt(StmtKind::StmtIf(if_stmt), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Match then
    match parse_match_expr(p)
    when Option::Some(m) then
      return Option::Some(make_stmt(StmtKind::StmtMatch(m), span_merge(start, m.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Unsafe then
    advance(p)
    mut justification = Option::None
    match peek(p)
    when TokenKind::StringLit(s) then
      advance(p)
      justification = Option::Some(s)
    when _ then ()
    end
    skip_newlines(p)
    if at(p, TokenKind::Do) then advance(p) end
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(body) then
      expect_end(p)
      return Option::Some(make_stmt(StmtKind::StmtUnsafe(justification, body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Defer then
    advance(p)
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(body) then
      expect_end(p)
      return Option::Some(make_stmt(StmtKind::StmtDefer(body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Loop then
    advance(p)
    skip_newlines(p)
    if at(p, TokenKind::Do) then advance(p) end
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(body) then
      expect_end(p)
      return Option::Some(make_stmt(StmtKind::StmtLoop(body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Handle then
    match parse_handle_with_stmt(p, start)
    when Option::Some(s) then return Option::Some(s)
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Try then
    match parse_try_stmt(p, start)
    when Option::Some(s) then return Option::Some(s)
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Guard then
    match parse_guard_stmt(p, start)
    when Option::Some(s) then return Option::Some(s)
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Struct then
    advance(p)
    match parse_struct_decl(p, Visibility::Private, start, Vec::new())
    when Option::Some(_) then
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Enum then
    advance(p)
    match parse_enum_decl(p, Visibility::Private, start, Vec::new())
    when Option::Some(_) then
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Impl then
    advance(p)
    match parse_impl_decl(p, Visibility::Private, start)
    when Option::Some(_) then
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::At then
    let attrs = parse_attributes(p)
    skip_newlines(p)
    if at_function_decl_start(p) then
      let fn_start = peek_span(p)
      match parse_prefixed_function_decl(p, Visibility::Private, fn_start)
      when Option::Some(_) then
        let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
        return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    else
      return parse_stmt(p)
    end
  elsif pk == TokenKind::Def || pk == TokenKind::Async || pk == TokenKind::Pure || pk == TokenKind::Inline then
    let fn_start = peek_span(p)
    match parse_prefixed_function_decl(p, Visibility::Private, fn_start)
    when Option::Some(_) then
      let noop = make_expr(ExprKind::ExprNilLit, span_merge(start, peek_span(p)))
      return Option::Some(make_stmt(StmtKind::StmtExpr(noop), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  else
    # Expression statement
    match parse_expr(p)
    when Option::Some(expr) then
      if at(p, TokenKind::Eq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtAssign(expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      elsif at(p, TokenKind::PlusEq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtCompoundAssign(BinOp::Add, expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      elsif at(p, TokenKind::MinusEq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtCompoundAssign(BinOp::Sub, expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      elsif at(p, TokenKind::StarEq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtCompoundAssign(BinOp::Mul, expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      elsif at(p, TokenKind::SlashEq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtCompoundAssign(BinOp::Div, expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      elsif at(p, TokenKind::PercentEq) then
        advance(p)
        match parse_expr(p)
        when Option::Some(value) then
          eat_optional_semi(p)
          return Option::Some(make_stmt(StmtKind::StmtCompoundAssign(BinOp::Mod, expr, value), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      else
        eat_optional_semi(p)
        return Option::Some(make_stmt(StmtKind::StmtExpr(expr), span_merge(start, expr.span)))
      end
    when Option::None then return Option::None
    end
  end
  Option::None
end

def parse_if_stmt(p: &mut TgcParser) -> Option[IfStmt]
  let start = peek_span(p)
  expect(p, TokenKind::If)
  
  match parse_expr(p)
  when Option::Some(cond) then
    return parse_if_stmt_after_cond(p, start, cond)
  when Option::None then return Option::None
  end
end

def make_single_expr_block(expr: Expr) -> Block
  make_block(Vec::from([make_stmt(StmtKind::StmtExpr(expr), expr.span)]), expr.span)
end

def parse_if_stmt_after_cond(p: &mut TgcParser, start: Span, cond: Expr) -> Option[IfStmt]
  skip_newlines(p)
  if at(p, TokenKind::Then) then
    advance(p)
  end
  skip_newlines(p)
  match parse_block_body(p)
  when Option::Some(then_block) then
    mut elsif_branches = Vec::new()
    mut else_block = Option::None
    mut chained_tail = false

    while at(p, TokenKind::Elsif) && !chained_tail do
      advance(p)
      if at(p, TokenKind::Let) then
        advance(p)
        match parse_if_let_match_after_let(p, start)
        when Option::Some(nested_match) then
          let nested_expr = make_expr(ExprKind::ExprMatch(nested_match), nested_match.span)
          else_block = Option::Some(make_single_expr_block(nested_expr))
          chained_tail = true
        when Option::None then return Option::None
        end
      else
        match parse_expr(p)
        when Option::Some(econd) then
          skip_newlines(p)
          if at(p, TokenKind::Then) then
            advance(p)
          end
          skip_newlines(p)
          match parse_block_body(p)
          when Option::Some(ebody) then
            elsif_branches.push((econd, ebody))
          when Option::None then return Option::None
          end
        when Option::None then return Option::None
        end
      end
    end

    if !chained_tail then
      if at(p, TokenKind::Else) then
        advance(p)
        skip_newlines(p)
        # Handle 'else if' as else-if chain (same as elsif)
        if at(p, TokenKind::If) then
          advance(p)
          if at(p, TokenKind::Let) then
            advance(p)
            match parse_if_let_match_after_let(p, start)
            when Option::Some(nested_match) then
              let nested_expr = make_expr(ExprKind::ExprMatch(nested_match), nested_match.span)
              else_block = Option::Some(make_single_expr_block(nested_expr))
              chained_tail = true
            when Option::None then return Option::None
            end
          else
            match parse_expr(p)
            when Option::Some(econd) then
              skip_newlines(p)
              if at(p, TokenKind::Then) then
                advance(p)
              end
              skip_newlines(p)
              match parse_block_body(p)
              when Option::Some(ebody) then
                elsif_branches.push((econd, ebody))
                # Continue collecting more else-if/elsif branches
                while (at(p, TokenKind::Elsif) || at(p, TokenKind::Else)) && !chained_tail do
                  if at(p, TokenKind::Elsif) then
                    advance(p)
                  else
                    # else — check if followed by 'if'
                    advance(p)
                    skip_newlines(p)
                    if !at(p, TokenKind::If) then
                      # Pure else block
                      else_block = parse_block_body(p)
                      break
                    end
                    advance(p)
                  end
                  if at(p, TokenKind::Let) then
                    advance(p)
                    match parse_if_let_match_after_let(p, start)
                    when Option::Some(nested_match) then
                      let nested_expr = make_expr(ExprKind::ExprMatch(nested_match), nested_match.span)
                      else_block = Option::Some(make_single_expr_block(nested_expr))
                      chained_tail = true
                    when Option::None then return Option::None
                    end
                  else
                    match parse_expr(p)
                    when Option::Some(econd2) then
                      skip_newlines(p)
                      if at(p, TokenKind::Then) then advance(p) end
                      skip_newlines(p)
                      match parse_block_body(p)
                      when Option::Some(ebody2) then
                        elsif_branches.push((econd2, ebody2))
                      when Option::None then return Option::None
                      end
                    when Option::None then return Option::None
                    end
                  end
                end
              when Option::None then return Option::None
              end
            when Option::None then return Option::None
            end
          end
        else
          else_block = parse_block_body(p)
        end
      end
      if !chained_tail then
        expect_end(p)
      end
    end

    return Option::Some(IfStmt {
      cond: cond,
      then_block: then_block,
      elsif_branches: elsif_branches,
      else_block: else_block,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def at_if_let(p: &TgcParser) -> Bool
  at(p, TokenKind::If) && p.pos + 1 < p.tokens.len() && p.tokens[p.pos + 1].kind == TokenKind::Let
end

def parse_if_let_match_after_let(p: &mut TgcParser, start: Span) -> Option[MatchExpr]
  match parse_pattern(p)
  when Option::Some(pat) then
    expect(p, TokenKind::Eq)
    match parse_expr(p)
    when Option::Some(scrutinee) then
      skip_newlines(p)
      if at(p, TokenKind::Then) then
        advance(p)
      end
      skip_newlines(p)
      match parse_block_body(p)
      when Option::Some(then_block) then
        mut arms = Vec::new()
        arms.push(MatchArm {
          pattern: pat,
          guard_expr: Option::None,
          body: then_block,
          span: span_merge(start, peek_span(p))
        })

        mut chained_tail = false

        if at(p, TokenKind::Elsif) then
          advance(p)
          if at(p, TokenKind::Let) then
            advance(p)
            match parse_if_let_match_after_let(p, start)
            when Option::Some(nested_match) then
              let nested_expr = make_expr(ExprKind::ExprMatch(nested_match), nested_match.span)
              let wildcard = make_pattern(PatternKind::Wildcard, nested_match.span)
              arms.push(MatchArm {
                pattern: wildcard,
                guard_expr: Option::None,
                body: make_single_expr_block(nested_expr),
                span: span_merge(start, nested_match.span)
              })
              chained_tail = true
            when Option::None then return Option::None
            end
          else
            match parse_expr(p)
            when Option::Some(cond) then
              match parse_if_stmt_after_cond(p, start, cond)
              when Option::Some(nested_if) then
                let nested_expr = make_expr(ExprKind::ExprIf(nested_if), nested_if.span)
                let wildcard = make_pattern(PatternKind::Wildcard, nested_if.span)
                arms.push(MatchArm {
                  pattern: wildcard,
                  guard_expr: Option::None,
                  body: make_single_expr_block(nested_expr),
                  span: span_merge(start, nested_if.span)
                })
                chained_tail = true
              when Option::None then return Option::None
              end
            when Option::None then return Option::None
            end
          end
        elsif at(p, TokenKind::Else) then
          advance(p)
          skip_newlines(p)
          match parse_block_body(p)
          when Option::Some(else_block) then
            let wildcard = make_pattern(PatternKind::Wildcard, peek_span(p))
            arms.push(MatchArm {
              pattern: wildcard,
              guard_expr: Option::None,
              body: else_block,
              span: span_merge(start, peek_span(p))
            })
          when Option::None then ()
          end
        end

        if !chained_tail then
          expect_end(p)
        end

        return Option::Some(MatchExpr {
          scrutinee: scrutinee,
          arms: arms,
          span: span_merge(start, peek_span(p))
        })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  when Option::None then return Option::None
  end
end

def parse_if_let_match(p: &mut TgcParser) -> Option[MatchExpr]
  let start = peek_span(p)
  expect(p, TokenKind::If)
  expect(p, TokenKind::Let)
  parse_if_let_match_after_let(p, start)
end

def at_match_arrow_arm_start(p: &TgcParser) -> Bool
  if at(p, TokenKind::End) || at(p, TokenKind::Else) || at(p, TokenKind::When) || at(p, TokenKind::Eof) then
    return false
  end

  mut idx = p.pos
  mut paren_depth = 0
  mut bracket_depth = 0
  mut brace_depth = 0

  while idx < p.tokens.len() do
    let kind = p.tokens[idx].kind
    if paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 then
      if kind == TokenKind::Newline then
        return false
      elsif kind == TokenKind::FatArrow then
        return true
      elsif kind == TokenKind::End || kind == TokenKind::Else || kind == TokenKind::When then
        return false
      end
    end

    match kind
    when TokenKind::LParen then paren_depth = paren_depth + 1
    when TokenKind::RParen then if paren_depth > 0 then paren_depth = paren_depth - 1 end
    when TokenKind::LBracket then bracket_depth = bracket_depth + 1
    when TokenKind::RBracket then if bracket_depth > 0 then bracket_depth = bracket_depth - 1 end
    when TokenKind::LBrace then brace_depth = brace_depth + 1
    when TokenKind::RBrace then if brace_depth > 0 then brace_depth = brace_depth - 1 end
    when _ then ()
    end

    idx = idx + 1
  end

  false
end

def parse_match_arm_guard(p: &mut TgcParser) -> Option[Expr]
  if at(p, TokenKind::If) then
    advance(p)
    let prev = p.disallow_bitwise_pipe
    p.disallow_bitwise_pipe = true
    let guard_expr = parse_expr(p)
    p.disallow_bitwise_pipe = prev
    guard_expr
  else
    Option::None
  end
end

def parse_match_arrow_body(p: &mut TgcParser) -> Option[Block]
  let body_start = peek_span(p)
  expect(p, TokenKind::FatArrow)

  if at(p, TokenKind::Newline) then
    skip_newlines(p)
    skip_doc_comments(p)
    let start = peek_span(p)
    mut stmts = Vec::new()

    while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) && !at(p, TokenKind::Else) && !at(p, TokenKind::When) && !at_match_arrow_arm_start(p) do
      skip_newlines(p)
      skip_doc_comments(p)
      if at(p, TokenKind::End) || at(p, TokenKind::Eof) || at(p, TokenKind::Else) || at(p, TokenKind::When) || at_match_arrow_arm_start(p) then
        break
      end
      let before_pos = p.pos
      match parse_stmt(p)
      when Option::Some(stmt) then stmts.push(stmt)
      when Option::None then
        synchronize(p)
        if p.pos == before_pos then
          advance(p)
        end
      end
      skip_newlines(p)
      skip_doc_comments(p)
    end

    return Option::Some(make_block(stmts, span_merge(start, peek_span(p))))
  else
    match parse_expr(p)
    when Option::Some(expr) then
      let mut stmts = Vec::new()
      stmts.push(make_stmt(StmtKind::StmtExpr(expr), expr.span))
      return Option::Some(make_block(stmts, span_merge(body_start, peek_span(p))))
    when Option::None then return Option::None
    end
  end
end

def parse_match_expr(p: &mut TgcParser) -> Option[MatchExpr]
  let start = peek_span(p)
  expect(p, TokenKind::Match)
  
  match parse_expr(p)
  when Option::Some(scrutinee) then
    skip_newlines(p)
    mut arms = Vec::new()

    while !at(p, TokenKind::End) && !at(p, TokenKind::Else) && !at(p, TokenKind::Eof) do
      skip_newlines(p)
      if at(p, TokenKind::End) || at(p, TokenKind::Else) || at(p, TokenKind::Eof) then
        break
      end

      if at(p, TokenKind::When) then
        advance(p)
        match parse_pattern(p)
        when Option::Some(pat) then
          let guard_val = parse_match_arm_guard(p)
          if at(p, TokenKind::Then) then advance(p) end
          skip_newlines(p)
          match parse_block_body(p)
          when Option::Some(body) then
            arms.push(MatchArm {
              pattern: pat,
              guard_expr: guard_val,
              body: body,
              span: span_merge(start, peek_span(p))
            })
          when Option::None then break
          end
        when Option::None then break
        end
      elsif at_match_arrow_arm_start(p) then
        match parse_pattern(p)
        when Option::Some(pat) then
          let guard_val = parse_match_arm_guard(p)
          match parse_match_arrow_body(p)
          when Option::Some(body) then
            arms.push(MatchArm {
              pattern: pat,
              guard_expr: guard_val,
              body: body,
              span: span_merge(start, peek_span(p))
            })
          when Option::None then break
          end
        when Option::None then break
        end
      else
        break
      end
    end

    # Support else as catch-all arm: match x ... else body end
    if at(p, TokenKind::Else) then
      advance(p)
      skip_newlines(p)
      match parse_block_body(p)
      when Option::Some(body) then
        let wildcard = make_pattern(PatternKind::Wildcard, peek_span(p))
        arms.push(MatchArm {
          pattern: wildcard,
          guard_expr: Option::None,
          body: body,
          span: span_merge(start, peek_span(p))
        })
      when Option::None then ()
      end
    end
    
    expect_end(p)
    return Option::Some(MatchExpr {
      scrutinee: scrutinee,
      arms: arms,
      span: span_merge(start, peek_span(p))
    })
  when Option::None then return Option::None
  end
end

def parse_try_stmt(p: &mut TgcParser, start: Span) -> Option[Stmt]
  advance(p)  # consume 'try'
  skip_newlines(p)
  
  match parse_block_body(p)
  when Option::Some(try_block) then
    mut catch_arms = Vec::new()
    while at(p, TokenKind::Catch) do
      advance(p)
      match parse_pattern(p)
      when Option::Some(pat) then
        skip_newlines(p)
        match parse_block_body(p)
        when Option::Some(body) then
          catch_arms.push(CatchArm { pattern: pat, body: body, span: span_merge(start, peek_span(p)) })
        when Option::None then break
        end
      when Option::None then break
      end
    end
    
    mut finally_opt = Option::None
    if at(p, TokenKind::Finally) then
      advance(p)
      skip_newlines(p)
      finally_opt = parse_block_body(p)
    end
    
    expect_end(p)
    return Option::Some(make_stmt(StmtKind::StmtTry(try_block, catch_arms, finally_opt), span_merge(start, peek_span(p))))
  when Option::None then return Option::None
  end
end

# guard <condition> else <action>
# action: return [expr] | panic("msg") | break [expr] | continue
def parse_guard_stmt(p: &mut TgcParser, start: Span) -> Option[Stmt]
  advance(p)  # consume 'guard'
  match parse_expr(p)
  when Option::Some(cond) then
    if !expect_keyword(p, TokenKind::Else) then
      return Option::None
    end
    mut action = GuardElse::Continue
    if at(p, TokenKind::Return) then
      advance(p)
      mut val = Option::None
      if at_expr_start(p) then val = parse_expr(p) end
      action = GuardElse::Return(val)
    elsif at(p, TokenKind::Break) then
      advance(p)
      mut val = Option::None
      if at_expr_start(p) then val = parse_expr(p) end
      action = GuardElse::Break(val)
    elsif at(p, TokenKind::Next) then
      advance(p)
      action = GuardElse::Continue
    else
      # panic("msg") or other expression
      match parse_expr(p)
      when Option::Some(expr) then
        match expr.kind
        when ExprKind::ExprCall(callee, args) then
          match callee.kind
          when ExprKind::ExprIdent(name) then
            if name == "panic" && args.len() == 1 then
              match args[0].kind
              when ExprKind::ExprStringLit(msg) then GuardElse::Panic(msg)
              when _ then
                diag_error(&mut p.diag, ErrorCode::E104ExpectedPattern,
                  "panic() argument must be a string literal", args[0].span)
                return Option::None
              end
            else
              diag_error(&mut p.diag, ErrorCode::E104ExpectedPattern,
                "guard else action must be return/break/continue or panic(\"msg\")", expr.span)
              return Option::None
            end
          when _ then
            diag_error(&mut p.diag, ErrorCode::E104ExpectedPattern,
              "guard else action must be return/break/continue or panic(\"msg\")", expr.span)
            return Option::None
          end
        when _ then
          diag_error(&mut p.diag, ErrorCode::E104ExpectedPattern,
            "guard else action must be return/break/continue or panic(\"msg\")", expr.span)
          return Option::None
        end
      when Option::None then
        return Option::None
      end
    end
    return Option::Some(make_stmt(StmtKind::StmtGuard(cond, action), span_merge(start, peek_span(p))))
  when Option::None then return Option::None
  end
end

def parse_handle_with_stmt(p: &mut TgcParser, start: Span) -> Option[Stmt]
  advance(p)  # consume 'handle'
  
  match parse_expr(p)
  when Option::Some(expr) then
    skip_newlines(p)
    mut handlers = Vec::new()
    
    while at(p, TokenKind::With) do
      let handler_start = peek_span(p)
      advance(p)  # consume 'with'
      
      match expect_ident(p)
      when Option::Some(effect_name) then
        skip_newlines(p)
        mut arms = Vec::new()
        
        # Parse handler arms: operation(params) => body
        while !at(p, TokenKind::End) && !at(p, TokenKind::With) && !at(p, TokenKind::Eof) do
          let arm_start = peek_span(p)
          match expect_ident(p)
          when Option::Some(op_name) then
            mut params = Vec::new()
            if at(p, TokenKind::LParen) then
              advance(p)
              if !at(p, TokenKind::RParen) then
                match expect_ident(p)
                when Option::Some(pname) then params.push(pname)
                when Option::None then ()
                end
                while at(p, TokenKind::Comma) do
                  advance(p)
                  match expect_ident(p)
                  when Option::Some(pname) then params.push(pname)
                  when Option::None then break
                  end
                end
              end
              expect(p, TokenKind::RParen)
            end
            
            expect(p, TokenKind::FatArrow)
            skip_newlines(p)
            match parse_block_body(p)
            when Option::Some(body) then
              arms.push(HandlerArm {
                operation: op_name,
                params: params,
                body: body,
                span: span_merge(arm_start, peek_span(p))
              })
            when Option::None then break
            end
            skip_newlines(p)
          when Option::None then break
          end
        end
        
        handlers.push(EffectHandler {
          effect_name: effect_name,
          arms: arms,
          span: span_merge(handler_start, peek_span(p))
        })
      when Option::None then break
      end
    end
    
    expect_end(p)
    return Option::Some(make_stmt(
      StmtKind::StmtHandleWith(expr, handlers),
      span_merge(start, peek_span(p))
    ))
  when Option::None then return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Patterns
# ———————————————————————————————————————————————————————————————

def parse_pattern(p: &mut TgcParser) -> Option[Pattern]
  let start = peek_span(p)
  
  # Parse first alternative
  match parse_single_pattern(p)
  when Option::Some(first) then
    # Check for or-pattern: pat1 | pat2 | pat3
    if at(p, TokenKind::Pipe) then
      mut alternatives = Vec::new()
      alternatives.push(first)
      while at(p, TokenKind::Pipe) do
        advance(p)
        match parse_single_pattern(p)
        when Option::Some(pat) then alternatives.push(pat)
        when Option::None then break
        end
      end
      return Option::Some(make_pattern(PatternKind::Or(alternatives), span_merge(start, peek_span(p))))
    else
      return Option::Some(first)
    end
  when Option::None then return Option::None
  end
end

def parse_single_pattern(p: &mut TgcParser) -> Option[Pattern]
  let start = peek_span(p)
  
  match peek(p)
  when TokenKind::Amp then
    # Ref pattern: &pat
    advance(p)
    match parse_single_pattern(p)
    when Option::Some(inner) then
      return Option::Some(make_pattern(PatternKind::Ref(inner), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::AmpMut then
    # RefMut pattern: &mut pat
    advance(p)
    match parse_single_pattern(p)
    when Option::Some(inner) then
      return Option::Some(make_pattern(PatternKind::RefMut(inner), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::TkRef then
    advance(p)
    match parse_single_pattern(p)
    when Option::Some(inner) then
      return Option::Some(make_pattern(PatternKind::Ref(inner), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::Ident(name) then
    if name == "_" then
      advance(p)
      return Option::Some(make_pattern(PatternKind::Wildcard, start))
    else
      advance(p)
      # Check for variant: Name(pats...)
      if at(p, TokenKind::LParen) then
        advance(p)
        mut pats = Vec::new()
        if !at(p, TokenKind::RParen) then
          match parse_pattern(p)
          when Option::Some(pat) then pats.push(pat)
          when Option::None then ()
          end
          while at(p, TokenKind::Comma) do
            advance(p)
            match parse_pattern(p)
            when Option::Some(pat) then pats.push(pat)
            when Option::None then break
            end
          end
        end
        expect(p, TokenKind::RParen)
        let path = make_path(Vec::from([name]), start)
        return Option::Some(make_pattern(PatternKind::Variant(path, pats), span_merge(start, peek_span(p))))
      # Check for struct pattern: Name { field: pat, ... }
      elsif at(p, TokenKind::LBrace) then
        advance(p)
        mut fields = Map::new()
        if !at(p, TokenKind::RBrace) then
          match expect_ident(p)
          when Option::Some(fname) then
            if at(p, TokenKind::Colon) then
              advance(p)
              match parse_pattern(p)
              when Option::Some(fpat) then fields.insert(fname, fpat)
              when Option::None then ()
              end
            else
              # Shorthand: just the field name as ident pattern
              let fpat = make_pattern(PatternKind::Ident(fname.clone(), false), peek_span(p))
              fields.insert(fname, fpat)
            end
          when Option::None then ()
          end
          while at(p, TokenKind::Comma) do
            advance(p)
            if at(p, TokenKind::RBrace) then break end
            match expect_ident(p)
            when Option::Some(fname) then
              if at(p, TokenKind::Colon) then
                advance(p)
                match parse_pattern(p)
                when Option::Some(fpat) then fields.insert(fname, fpat)
                when Option::None then break
                end
              else
                let fpat = make_pattern(PatternKind::Ident(fname.clone(), false), peek_span(p))
                fields.insert(fname, fpat)
              end
            when Option::None then break
            end
          end
        end
        expect(p, TokenKind::RBrace)
        let path = make_path(Vec::from([name]), start)
        return Option::Some(make_pattern(PatternKind::Struct(path, fields), span_merge(start, peek_span(p))))
      # Check for path pattern: Name::Variant(pats...) or Name::Variant { ... }
      elsif at(p, TokenKind::ColonColon) then
        advance(p)
        match expect_ident(p)
        when Option::Some(seg2) then
          let path = make_path(Vec::from([name, seg2]), start)
          if at(p, TokenKind::LParen) then
            advance(p)
            mut pats = Vec::new()
            if !at(p, TokenKind::RParen) then
              match parse_pattern(p)
              when Option::Some(pat) then pats.push(pat)
              when Option::None then ()
              end
              while at(p, TokenKind::Comma) do
                advance(p)
                match parse_pattern(p)
                when Option::Some(pat) then pats.push(pat)
                when Option::None then break
                end
              end
            end
            expect(p, TokenKind::RParen)
            return Option::Some(make_pattern(PatternKind::Variant(path, pats), span_merge(start, peek_span(p))))
          elsif at(p, TokenKind::LBrace) then
            advance(p)
            mut fields = Vec::new()
            if !at(p, TokenKind::RBrace) then
              match expect_ident(p)
              when Option::Some(fname) then
                if at(p, TokenKind::Colon) then
                  advance(p)
                  match parse_pattern(p)
                  when Option::Some(fpat) then fields.push((fname, fpat))
                  when Option::None then ()
                  end
                else
                  let fpat = make_pattern(PatternKind::Ident(fname, false), peek_span(p))
                  fields.push((fname, fpat))
                end
              when Option::None then ()
              end
              while at(p, TokenKind::Comma) do
                advance(p)
                if at(p, TokenKind::RBrace) then break end
                match expect_ident(p)
                when Option::Some(fname) then
                  if at(p, TokenKind::Colon) then
                    advance(p)
                    match parse_pattern(p)
                    when Option::Some(fpat) then fields.push((fname, fpat))
                    when Option::None then break
                    end
                  else
                    let fpat = make_pattern(PatternKind::Ident(fname, false), peek_span(p))
                    fields.push((fname, fpat))
                  end
                when Option::None then break
                end
              end
            end
            expect(p, TokenKind::RBrace)
            return Option::Some(make_pattern(PatternKind::Struct(path, fields), span_merge(start, peek_span(p))))
          else
            return Option::Some(make_pattern(PatternKind::Variant(path, Vec::new()), span_merge(start, peek_span(p))))
          end
        when Option::None then
          return Option::Some(make_pattern(PatternKind::Ident(name, false), start))
        end
      else
        return Option::Some(make_pattern(PatternKind::Ident(name, false), start))
      end
    end
  when TokenKind::Module then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("module", false), span_merge(start, peek_span(p))))
  when TokenKind::Mut then
    advance(p)
    match expect_ident(p)
    when Option::Some(name) then
      return Option::Some(make_pattern(PatternKind::Ident(name, true), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::IntLit(n) then
    advance(p)
    let expr = make_expr(ExprKind::ExprIntLit(n), start)
    # Check for range pattern: N..M or N..=M
    if at(p, TokenKind::DotDot) then
      advance(p)
      let end_expr = if at_expr_start(p) then parse_primary(p) else Option::None end
      return Option::Some(make_pattern(PatternKind::Range(Option::Some(expr), end_expr, false), span_merge(start, peek_span(p))))
    elsif at(p, TokenKind::DotDotEq) then
      advance(p)
      let end_expr = parse_primary(p)
      return Option::Some(make_pattern(PatternKind::Range(Option::Some(expr), end_expr, true), span_merge(start, peek_span(p))))
    else
      return Option::Some(make_pattern(PatternKind::Literal(expr), start))
    end
  when TokenKind::StringLit(s) then
    advance(p)
    let expr = make_expr(ExprKind::ExprStringLit(s), start)
    return Option::Some(make_pattern(PatternKind::Literal(expr), start))
  when TokenKind::CharLit(c) then
    advance(p)
    let expr = make_expr(ExprKind::ExprCharLit(c), start)
    # Check for range pattern: 'a'..'z' or 'a'..='z'
    if at(p, TokenKind::DotDot) then
      advance(p)
      let end_expr = if at_expr_start(p) then parse_primary(p) else Option::None end
      return Option::Some(make_pattern(PatternKind::Range(Option::Some(expr), end_expr, false), span_merge(start, peek_span(p))))
    elsif at(p, TokenKind::DotDotEq) then
      advance(p)
      let end_expr = parse_primary(p)
      return Option::Some(make_pattern(PatternKind::Range(Option::Some(expr), end_expr, true), span_merge(start, peek_span(p))))
    else
      return Option::Some(make_pattern(PatternKind::Literal(expr), start))
    end
  when TokenKind::True then
    advance(p)
    let expr = make_expr(ExprKind::ExprBoolLit(true), start)
    return Option::Some(make_pattern(PatternKind::Literal(expr), start))
  when TokenKind::False then
    advance(p)
    let expr = make_expr(ExprKind::ExprBoolLit(false), start)
    return Option::Some(make_pattern(PatternKind::Literal(expr), start))
  when TokenKind::Nil then
    advance(p)
    let expr = make_expr(ExprKind::ExprNilLit, start)
    return Option::Some(make_pattern(PatternKind::Literal(expr), start))
  when TokenKind::LBracket then
    advance(p)
    mut pats = Vec::new()
    if !at(p, TokenKind::RBracket) then
      match parse_pattern(p)
      when Option::Some(pat) then pats.push(pat)
      when Option::None then ()
      end
      while at(p, TokenKind::Comma) do
        advance(p)
        match parse_pattern(p)
        when Option::Some(pat) then pats.push(pat)
        when Option::None then break
        end
      end
    end
    expect(p, TokenKind::RBracket)
    return Option::Some(make_pattern(PatternKind::Array(pats), span_merge(start, peek_span(p))))
  when TokenKind::LParen then
    advance(p)
    mut pats = Vec::new()
    if !at(p, TokenKind::RParen) then
      match parse_pattern(p)
      when Option::Some(pat) then pats.push(pat)
      when Option::None then ()
      end
      while at(p, TokenKind::Comma) do
        advance(p)
        match parse_pattern(p)
        when Option::Some(pat) then pats.push(pat)
        when Option::None then break
        end
      end
    end
    expect(p, TokenKind::RParen)
    return Option::Some(make_pattern(PatternKind::Tuple(pats), span_merge(start, peek_span(p))))
  # Contextual keywords that can be used as identifiers in patterns
  when TokenKind::TkDrop then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("drop", false), start))
  when TokenKind::Async then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("async", false), start))
  when TokenKind::Next then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("next", false), start))
  when TokenKind::Type then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("type", false), start))
  when TokenKind::Cap then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("cap", false), start))
  when TokenKind::Requires then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("requires", false), start))
  when TokenKind::Ensures then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("ensures", false), start))
  when TokenKind::Invariant then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("invariant", false), start))
  when TokenKind::Budget then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("budget", false), start))
  when TokenKind::TkMove then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("move", false), start))
  when TokenKind::TkOwn then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("own", false), start))
  when TokenKind::Pre then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("pre", false), start))
  when TokenKind::Post then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("post", false), start))
  when TokenKind::Effect then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("effect", false), start))
  when TokenKind::Pure then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("pure", false), start))
  when TokenKind::TkCopy then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("copy", false), start))
  when TokenKind::Inline then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("inline", false), start))
  when TokenKind::Edition then
    advance(p)
    return Option::Some(make_pattern(PatternKind::Ident("edition", false), start))
  when _ then
    diag_error(&mut p.diag, ErrorCode::E104ExpectedPattern, "expected pattern", start)
    return Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Expressions (Pratt Parser)
# ———————————————————————————————————————————————————————————————

def parse_expr(p: &mut TgcParser) -> Option[Expr]
  skip_newlines(p)
  parse_or(p)
end

def parse_or(p: &mut TgcParser) -> Option[Expr]
  match parse_and(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Or) then
        p.pos = saved
        break
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_and(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(BinOp::Or, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_and(p: &mut TgcParser) -> Option[Expr]
  match parse_range(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::And) then
        p.pos = saved
        break
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_range(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(BinOp::And, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_range(p: &mut TgcParser) -> Option[Expr]
  match parse_equality(p)
  when Option::Some(left) then
    let saved = p.pos
    skip_newlines(p)
    if at(p, TokenKind::DotDot) then
      let start = left.span
      advance(p)
      # Optional end expression
      if is_expr_start(peek(p)) then
        match parse_equality(p)
        when Option::Some(right) then
          return Option::Some(make_expr(ExprKind::ExprRange(Option::Some(left), Option::Some(right), false), span_merge(start, right.span)))
        when Option::None then
          return Option::Some(make_expr(ExprKind::ExprRange(Option::Some(left), Option::None, false), span_merge(start, peek_span(p))))
        end
      else
        return Option::Some(make_expr(ExprKind::ExprRange(Option::Some(left), Option::None, false), span_merge(start, peek_span(p))))
      end
    elsif at(p, TokenKind::DotDotEq) then
      let start = left.span
      advance(p)
      match parse_equality(p)
      when Option::Some(right) then
        return Option::Some(make_expr(ExprKind::ExprRange(Option::Some(left), Option::Some(right), true), span_merge(start, right.span)))
      when Option::None then
        return Option::Some(make_expr(ExprKind::ExprRange(Option::Some(left), Option::None, true), span_merge(start, peek_span(p))))
      end
    else
      p.pos = saved
      return Option::Some(left)
    end
  when Option::None then return Option::None
  end
end

def parse_equality(p: &mut TgcParser) -> Option[Expr]
  match parse_comparison(p)
  when Option::Some(left) then
    mut result = left
    while true do
      # Check for operator — also look across newlines for leading operator continuation
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::EqEq) && !at(p, TokenKind::BangEq) then
        p.pos = saved
        break
      end
      mut op = BinOp::Ne
      if at(p, TokenKind::EqEq) then
        op = BinOp::Eq
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_comparison(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_comparison(p: &mut TgcParser) -> Option[Expr]
  match parse_bitwise_or(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if at(p, TokenKind::Lt) then
        let op = BinOp::Lt
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_bitwise_or(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::Gt) then
        let op = BinOp::Gt
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_bitwise_or(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::LtEq) then
        let op = BinOp::Le
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_bitwise_or(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::GtEq) then
        let op = BinOp::Ge
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_bitwise_or(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      else
        p.pos = saved
        break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_bitwise_or(p: &mut TgcParser) -> Option[Expr]
  match parse_bitwise_xor(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Pipe) then
        p.pos = saved
        break
      end
      if p.disallow_bitwise_pipe then
        p.pos = saved
        break
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_bitwise_xor(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(BinOp::BitOr, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_bitwise_xor(p: &mut TgcParser) -> Option[Expr]
  match parse_bitwise_and(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Caret) then
        p.pos = saved
        break
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_bitwise_and(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(BinOp::BitXor, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_bitwise_and(p: &mut TgcParser) -> Option[Expr]
  match parse_shift(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Amp) then
        p.pos = saved
        break
      end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_shift(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(BinOp::BitAnd, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_shift(p: &mut TgcParser) -> Option[Expr]
  match parse_term(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Shl) && !at(p, TokenKind::Shr) then
        p.pos = saved
        break
      end
      mut op = BinOp::Shr
      if at(p, TokenKind::Shl) then op = BinOp::Shl end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_term(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_term(p: &mut TgcParser) -> Option[Expr]
  match parse_factor(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if !at(p, TokenKind::Plus) && !at(p, TokenKind::Minus) then
        p.pos = saved
        break
      end
      mut op = BinOp::Sub
      if at(p, TokenKind::Plus) then op = BinOp::Add end
      let start = result.span
      advance(p)
      skip_newlines(p)
      match parse_factor(p)
      when Option::Some(right) then
        result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
      when Option::None then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_factor(p: &mut TgcParser) -> Option[Expr]
  match parse_unary(p)
  when Option::Some(left) then
    mut result = left
    while true do
      let saved = p.pos
      skip_newlines(p)
      if at(p, TokenKind::Star) then
        let op = BinOp::Mul
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_unary(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::Slash) then
        let op = BinOp::Div
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_unary(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::Percent) then
        let op = BinOp::Mod
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_unary(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      elsif at(p, TokenKind::DoubleStar) then
        let op = BinOp::Pow
        let start = result.span
        advance(p)
        skip_newlines(p)
        match parse_unary(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprBinaryOp(op, result, right), span_merge(start, right.span))
        when Option::None then break
        end
      else
        p.pos = saved
        break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def parse_unary(p: &mut TgcParser) -> Option[Expr]
  let start = peek_span(p)
  let pk = peek(p)
  
  if pk == TokenKind::Bang then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprUnaryOp(UnOp::Not, expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Tilde then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprUnaryOp(UnOp::BitNot, expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Minus then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprUnaryOp(UnOp::Neg, expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Amp then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprRef(expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::AmpMut then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprRefMut(expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Await then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprAwait(expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::TkMove then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprMove(expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::TkCopy then
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprCopy(expr), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  elsif pk == TokenKind::Star then
    # Dereference (*expr)
    advance(p)
    match parse_unary(p)
    when Option::Some(expr) then
      return Option::Some(make_expr(ExprKind::ExprDeref(Box::new(expr)), span_merge(start, expr.span)))
    when Option::None then return Option::None
    end
  else
    return parse_postfix(p)
  end
end

def at_postfix_start(p: &mut TgcParser) -> Bool
  let saved = p.pos
  skip_newlines(p)
  let crossed_newline = p.pos != saved
  if crossed_newline && at(p, TokenKind::LParen) then
    p.pos = saved
    return false
  end
  let can_continue = at(p, TokenKind::Question) || at(p, TokenKind::Dot) || at(p, TokenKind::LParen) || at(p, TokenKind::LBracket) || at(p, TokenKind::Is) || at(p, TokenKind::As) || at(p, TokenKind::PipeArrow)
  if !can_continue then
    p.pos = saved
  end
  can_continue
end

def parse_struct_literal_fields(p: &mut TgcParser) -> Vec[(String, Expr)]
  mut fields = Vec::new()
  skip_newlines(p)
  if at(p, TokenKind::RBrace) then
    return fields
  end

  while true do
    let field_span = peek_span(p)
    match expect_ident(p)
    when Option::Some(fname) then
      if at(p, TokenKind::Colon) then
        advance(p)
        match parse_expr(p)
        when Option::Some(fval) then fields.push((fname, fval))
        when Option::None then break
        end
      else
        fields.push((fname.clone(), make_expr(ExprKind::ExprIdent(fname), field_span)))
      end
    when Option::None then break
    end

    skip_newlines(p)
    if !at(p, TokenKind::Comma) then
      break
    end
    advance(p)
    skip_newlines(p)
    if at(p, TokenKind::RBrace) then
      break
    end
  end

  fields
end

def parse_postfix(p: &mut TgcParser) -> Option[Expr]
  match parse_primary(p)
  when Option::Some(expr) then
    mut result = expr
    while true do
      if !at_postfix_start(p) then
        break
      end
      match peek(p)
      when TokenKind::Question then
        let start = result.span
        advance(p)
        result = make_expr(ExprKind::ExprTry(result), span_merge(start, peek_span(p)))
      when TokenKind::Dot then
        let start = result.span
        advance(p)
        # Support both named field access and tuple index access (.0, .1)
        mut field_opt = Option::None
        match peek(p)
        when TokenKind::IntLit(n) then
          advance(p)
          field_opt = Option::Some(n.to_string())
        when _ then
          field_opt = expect_ident(p)
        end
        match field_opt
        when Option::Some(field) then
          if at(p, TokenKind::LParen) then
            advance(p)
            let args = parse_arg_list(p)
            expect(p, TokenKind::RParen)
            # Check for trailing block: method(args) { |params| body }
            let trailing = parse_trailing_block(p)
            match trailing
            when Option::Some(block_expr) then
              mut full_args = args
              full_args.push(block_expr)
              result = make_expr(ExprKind::ExprMethodCall(result, field, Vec::new(), full_args), span_merge(start, peek_span(p)))
            when Option::None then
              result = make_expr(ExprKind::ExprMethodCall(result, field, Vec::new(), args), span_merge(start, peek_span(p)))
            end
          elsif at(p, TokenKind::LBrace) then
            # Trailing block without parens: method { |params| body }
            let trailing = parse_trailing_block(p)
            match trailing
            when Option::Some(block_expr) then
              mut args = Vec::new()
              args.push(block_expr)
              result = make_expr(ExprKind::ExprMethodCall(result, field, Vec::new(), args), span_merge(start, peek_span(p)))
            when Option::None then
              result = make_expr(ExprKind::ExprFieldAccess(result, field), span_merge(start, peek_span(p)))
            end
          else
            result = make_expr(ExprKind::ExprFieldAccess(result, field), span_merge(start, peek_span(p)))
          end
        when Option::None then break
        end
      when TokenKind::LParen then
        let start = result.span
        let _call_start_pos = span_start(&start)
        advance(p)
        let args = parse_arg_list(p)
        expect(p, TokenKind::RParen)
        result = make_expr(ExprKind::ExprCall(result, args), span_merge(start, peek_span(p)))
      when TokenKind::LBracket then
        let start = result.span
        advance(p)
        match parse_expr(p)
        when Option::Some(index) then
          expect(p, TokenKind::RBracket)
          result = make_expr(ExprKind::ExprIndex(result, index), span_merge(start, peek_span(p)))
        when Option::None then break
        end
      when TokenKind::Is then
        let start = result.span
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then
          result = make_expr(ExprKind::ExprTypeCheck(result, ty), span_merge(start, ty.span))
        when Option::None then break
        end
      when TokenKind::As then
        let start = result.span
        advance(p)
        match parse_type(p)
        when Option::Some(ty) then
          result = make_expr(ExprKind::ExprCast(result, ty), span_merge(start, ty.span))
        when Option::None then break
        end
      when TokenKind::PipeArrow then
        let start = result.span
        advance(p)
        match parse_postfix(p)
        when Option::Some(right) then
          result = make_expr(ExprKind::ExprPipe(result, right), span_merge(start, right.span))
        when Option::None then break
        end
      when _ then break
      end
    end
    return Option::Some(result)
  when Option::None then return Option::None
  end
end

def skip_named_arg_label(p: &mut TgcParser)
  # If we see Ident followed by Colon, treat as named argument label and skip both.
  match peek(p)
  when TokenKind::Ident(_) then
    if p.pos + 1 < p.tokens.len() && p.tokens[p.pos + 1].kind == TokenKind::Colon then
      advance(p)
      advance(p)
    end
  when _ then ()
  end
end

def parse_arg_list(p: &mut TgcParser) -> Vec[Expr]
  mut args = Vec::new()
  skip_newlines(p)
  if at(p, TokenKind::RParen) then
    return args
  end
  skip_named_arg_label(p)
  match parse_expr(p)
  when Option::Some(arg) then args.push(arg)
  when Option::None then ()
  end
  while at(p, TokenKind::Comma) do
    advance(p)
    skip_newlines(p)
    if at(p, TokenKind::RParen) then break end
    skip_named_arg_label(p)
    match parse_expr(p)
    when Option::Some(arg) then args.push(arg)
    when Option::None then break
    end
  end
  skip_newlines(p)
  args
end

def parse_closure_params(p: &mut TgcParser) -> Vec[ClosureParam]
  mut params = Vec::new()
  if at(p, TokenKind::Pipe) then
    return params
  end

  while true do
    let param_start = peek_span(p)
    match parse_single_pattern(p)
    when Option::Some(pat) then
      mut ty = Option::None
      if at(p, TokenKind::Colon) then
        advance(p)
        ty = parse_type(p)
      end
      params.push(ClosureParam { pat: pat, ty: ty, span: span_merge(param_start, peek_span(p)) })
    when Option::None then break
    end

    if !at(p, TokenKind::Comma) then
      break
    end
    advance(p)
    if at(p, TokenKind::Pipe) then
      break
    end
  end

  params
end

def parse_closure_return_type(p: &mut TgcParser) -> Option[TypeExpr]
  if at(p, TokenKind::Arrow) then
    advance(p)
    parse_type(p)
  else
    Option::None
  end
end

# Parse a trailing block: { |params| body } or do |params| ... end
# Used for Ruby-style method calls: list.map { |x| x * 2 }
def parse_trailing_block(p: &mut TgcParser) -> Option[Expr]
  skip_newlines(p)
  if at(p, TokenKind::LBrace) then
    let start = peek_span(p)
    advance(p)
    skip_newlines(p)

    # Check for |params|
    mut params = Vec::new()
    mut ret_type = Option::None
    if at(p, TokenKind::Pipe) then
      advance(p)
      params = parse_closure_params(p)
      expect(p, TokenKind::Pipe)
      ret_type = parse_closure_return_type(p)
      skip_newlines(p)
    end

    match parse_expr(p)
    when Option::Some(body) then
      skip_newlines(p)
      expect(p, TokenKind::RBrace)
      return Option::Some(make_expr(ExprKind::ExprClosure(params, ret_type, body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  else
    return Option::None
  end
end

def parse_primary(p: &mut TgcParser) -> Option[Expr]
  let start = peek_span(p)
  
  match peek(p)
  when TokenKind::IntLit(n) then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIntLit(n), start))
  when TokenKind::FloatLit(f) then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprFloatLit(f), start))
  when TokenKind::StringLit(s) then
    advance(p)
    let _string_start_pos = span_start(&start)
    return Option::Some(make_expr(ExprKind::ExprStringLit(s), start))
  when TokenKind::CharLit(c) then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprCharLit(c), start))
  when TokenKind::True then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprBoolLit(true), start))
  when TokenKind::False then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprBoolLit(false), start))
  when TokenKind::Nil then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprNilLit, start))
  when TokenKind::Self_ then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprSelfRef, start))
  when TokenKind::Module then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("module"), start))
  when TokenKind::TkDrop then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("drop"), start))
  when TokenKind::Cap then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("cap"), start))
  when TokenKind::Requires then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("requires"), start))
  when TokenKind::Ensures then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("ensures"), start))
  when TokenKind::Invariant then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("invariant"), start))
  when TokenKind::TkMove then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("move"), start))
  when TokenKind::TkOwn then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("own"), start))
  when TokenKind::Pre then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("pre"), start))
  when TokenKind::Post then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("post"), start))
  when TokenKind::Effect then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("effect"), start))
  when TokenKind::Pure then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("pure"), start))
  when TokenKind::TkRef then
    if at_if_let(p) then
      match parse_if_let_match(p)
      when Option::Some(m) then
        return Option::Some(make_expr(ExprKind::ExprMatch(m), m.span))
      when Option::None then return Option::None
      end
    else
      match parse_if_stmt(p)
      when Option::Some(if_stmt) then
        return Option::Some(make_expr(ExprKind::ExprIf(if_stmt), if_stmt.span))
      when Option::None then return Option::None
      end
    end
  when TokenKind::Inline then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("inline"), start))
  when TokenKind::Edition then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("edition"), start))
  when TokenKind::Next then
    advance(p)
    return Option::Some(make_expr(ExprKind::ExprIdent("next"), start))
  when TokenKind::Ident(name) then
    advance(p)
    let _ident_start_pos = span_start(&start)
    # Macro invocation: name![args] or name!(args)
    if at(p, TokenKind::Bang) then
      let bang_pos = p.pos
      advance(p)
      if at(p, TokenKind::LBracket) then
        advance(p)
        skip_newlines(p)
        mut args = Vec::new()
        if !at(p, TokenKind::RBracket) then
          match parse_expr(p)
          when Option::Some(e) then args.push(e)
          when Option::None then ()
          end
          while at(p, TokenKind::Comma) do
            advance(p)
            skip_newlines(p)
            if at(p, TokenKind::RBracket) then break end
            match parse_expr(p)
            when Option::Some(e) then args.push(e)
            when Option::None then break
            end
          end
        end
        skip_newlines(p)
        expect(p, TokenKind::RBracket)
        return Option::Some(make_expr(ExprKind::ExprMacroCall(name, args), span_merge(start, peek_span(p))))
      elsif at(p, TokenKind::LParen) then
        advance(p)
        let args = parse_arg_list(p)
        expect(p, TokenKind::RParen)
        return Option::Some(make_expr(ExprKind::ExprMacroCall(name, args), span_merge(start, peek_span(p))))
      else
        # Not a macro call — backtrack past the bang
        p.pos = bang_pos
      end
    end
    let struct_start_pos = p.pos
    skip_newlines(p)
    mut is_end_struct_lit = false
    match peek(p)
    when TokenKind::Ident(_) then
      if p.pos + 1 < p.tokens.len() then
        is_end_struct_lit = p.tokens[p.pos + 1].kind == TokenKind::Colon
      end
    when _ then ()
    end
    p.pos = struct_start_pos

    if at(p, TokenKind::ColonColon) then
      mut segments = Vec::new()
      segments.push(name)
      while at(p, TokenKind::ColonColon) do
        advance(p)
        match expect_ident(p)
        when Option::Some(seg) then segments.push(seg)
        when Option::None then break
        end
      end
      let path = make_path(segments, span_merge(start, peek_span(p)))
      if at(p, TokenKind::LParen) then
        advance(p)
        let args = parse_arg_list(p)
        expect(p, TokenKind::RParen)
        return Option::Some(make_expr(ExprKind::ExprEnumVariant(path, args), span_merge(start, peek_span(p))))
      elsif at(p, TokenKind::LBrace) then
        advance(p)
        let fields = parse_struct_literal_fields(p)
        skip_newlines(p)
        expect(p, TokenKind::RBrace)
        return Option::Some(make_expr(ExprKind::ExprStructLit(path, fields), span_merge(start, peek_span(p))))
      else
        return Option::Some(make_expr(ExprKind::ExprPath(path), span_merge(start, peek_span(p))))
      end
    elsif at(p, TokenKind::LBrace) then
      # Struct literal
      advance(p)
      let fields = parse_struct_literal_fields(p)
      skip_newlines(p)
      expect(p, TokenKind::RBrace)
      let path = make_path(Vec::from([name]), start)
      return Option::Some(make_expr(ExprKind::ExprStructLit(path, fields), span_merge(start, peek_span(p))))
    elsif is_end_struct_lit then
      let saved_pos = p.pos
      skip_newlines(p)
      mut fields = Vec::new()
      while !at(p, TokenKind::End) && !at(p, TokenKind::Eof) do
        match expect_ident(p)
        when Option::Some(fname) then
          expect(p, TokenKind::Colon)
          match parse_expr(p)
          when Option::Some(fval) then
            fields.push((fname, fval))
          when Option::None then
            p.pos = saved_pos
            return Option::Some(make_expr(ExprKind::ExprIdent(name), start))
          end
        when Option::None then
          p.pos = saved_pos
          return Option::Some(make_expr(ExprKind::ExprIdent(name), start))
        end
        skip_newlines(p)
        if at(p, TokenKind::Comma) then
          advance(p)
          skip_newlines(p)
        end
      end
      expect_end(p)
      let path = make_path(Vec::from([name]), start)
      return Option::Some(make_expr(ExprKind::ExprStructLit(path, fields), span_merge(start, peek_span(p))))
    else
      return Option::Some(make_expr(ExprKind::ExprIdent(name), start))
    end
  when TokenKind::LParen then
    advance(p)
    if at(p, TokenKind::RParen) then
      advance(p)
      return Option::Some(make_expr(ExprKind::ExprTupleLit(Vec::new()), span_merge(start, peek_span(p))))
    else
      match parse_expr(p)
      when Option::Some(expr) then
        if at(p, TokenKind::Comma) then
          mut elems = Vec::new()
          elems.push(expr)
          while at(p, TokenKind::Comma) do
            advance(p)
            skip_newlines(p)
            if at(p, TokenKind::RParen) then break end
            match parse_expr(p)
            when Option::Some(e) then elems.push(e)
            when Option::None then break
            end
          end
          skip_newlines(p)
          expect(p, TokenKind::RParen)
          return Option::Some(make_expr(ExprKind::ExprTupleLit(elems), span_merge(start, peek_span(p))))
        else
          expect(p, TokenKind::RParen)
          return Option::Some(expr)
        end
      when Option::None then return Option::None
      end
    end
  when TokenKind::LBracket then
    advance(p)
    skip_newlines(p)
    mut elems = Vec::new()
    if !at(p, TokenKind::RBracket) then
      match parse_expr(p)
      when Option::Some(e) then elems.push(e)
      when Option::None then ()
      end
      while at(p, TokenKind::Comma) do
        advance(p)
        skip_newlines(p)
        if at(p, TokenKind::RBracket) then break end
        match parse_expr(p)
        when Option::Some(e) then elems.push(e)
        when Option::None then break
        end
      end
    end
    skip_newlines(p)
    expect(p, TokenKind::RBracket)
    return Option::Some(make_expr(ExprKind::ExprArrayLit(elems), span_merge(start, peek_span(p))))
  when TokenKind::LBrace then
    return parse_brace_expr(p)
  when TokenKind::If then
    if at_if_let(p) then
      match parse_if_let_match(p)
      when Option::Some(m) then
        return Option::Some(make_expr(ExprKind::ExprMatch(m), m.span))
      when Option::None then return Option::None
      end
    else
      match parse_if_stmt(p)
      when Option::Some(if_stmt) then
        return Option::Some(make_expr(ExprKind::ExprIf(if_stmt), if_stmt.span))
      when Option::None then return Option::None
      end
    end
  when TokenKind::Unless then
    # Desugar: unless cond then ... else ... end  →  if !(cond) then ... else ... end
    advance(p)
    match parse_expr(p)
    when Option::Some(cond) then
      skip_newlines(p)
      if at(p, TokenKind::Then) then
        advance(p)
      end
      skip_newlines(p)
      let neg_cond = make_expr(ExprKind::ExprUnaryOp(UnOp::Not, Box::new(cond)), cond.span)
      match parse_block_body(p)
      when Option::Some(then_block) then
        mut else_block = Option::None
        if at(p, TokenKind::Else) then
          advance(p)
          skip_newlines(p)
          else_block = parse_block_body(p)
        end
        expect_end(p)
        let if_stmt = IfStmt {
          cond: neg_cond,
          then_block: then_block,
          elsif_branches: Vec::new(),
          else_block: else_block,
          span: span_merge(start, peek_span(p))
        }
        return Option::Some(make_expr(ExprKind::ExprIf(if_stmt), span_merge(start, peek_span(p))))
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
  when TokenKind::Match then
    match parse_match_expr(p)
    when Option::Some(m) then
      return Option::Some(make_expr(ExprKind::ExprMatch(m), m.span))
    when Option::None then return Option::None
    end
  when TokenKind::Do then
    advance(p)
    skip_newlines(p)

    # Ruby-like block params: do |x, y| ... end
    mut block_params = Vec::new()
    mut block_ret_type = Option::None
    if at(p, TokenKind::Pipe) then
      advance(p)
      block_params = parse_closure_params(p)
      expect(p, TokenKind::Pipe)
      block_ret_type = parse_closure_return_type(p)
      skip_newlines(p)
    end

    match parse_block_body(p)
    when Option::Some(block) then
      expect_end(p)
      if block_params.is_empty() then
        return Option::Some(make_expr(ExprKind::ExprBlock(block), span_merge(start, peek_span(p))))
      else
        # Treat as a closure with a block body
        let body = make_expr(ExprKind::ExprBlock(block), span_merge(start, peek_span(p)))
        return Option::Some(make_expr(ExprKind::ExprClosure(block_params, block_ret_type, body), span_merge(start, peek_span(p))))
      end
    when Option::None then return Option::None
    end
  when TokenKind::Async then
    advance(p)
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(block) then
      expect_end(p)
      return Option::Some(make_expr(ExprKind::ExprAsync(block), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::Unsafe then
    advance(p)
    mut justification = Option::None
    match peek(p)
    when TokenKind::StringLit(s) then
      advance(p)
      justification = Option::Some(s)
    when _ then ()
    end
    skip_newlines(p)
    if at(p, TokenKind::Do) then advance(p) end
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(body) then
      expect_end(p)
      return Option::Some(make_expr(ExprKind::ExprUnsafe(justification, body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::Comptime then
    advance(p)
    skip_newlines(p)
    match parse_block_body(p)
    when Option::Some(block) then
      expect_end(p)
      return Option::Some(make_expr(ExprKind::ExprComptime(block), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  when TokenKind::Pipe then
    # Standalone closure expression |x| expr or |x, y| expr
    advance(p)
    let params = parse_closure_params(p)
    expect(p, TokenKind::Pipe)
    let ret_type = parse_closure_return_type(p)
    match parse_expr(p)
    when Option::Some(body) then
      return Option::Some(make_expr(ExprKind::ExprClosure(params, ret_type, body), span_merge(start, body.span)))
    when Option::None then return Option::None
    end
  when TokenKind::Or then
    # Empty-param closure: || expr
    advance(p)
    let params = Vec::new()
    let ret_type = parse_closure_return_type(p)
    match parse_expr(p)
    when Option::Some(body) then
      return Option::Some(make_expr(ExprKind::ExprClosure(params, ret_type, body), span_merge(start, body.span)))
    when Option::None then return Option::None
    end
  when _ then
    diag_error(&mut p.diag, ErrorCode::E101ExpectedExpression, "expected expression", start)
    return Option::None
  end
end

def parse_brace_expr(p: &mut TgcParser) -> Option[Expr]
  let start = peek_span(p)
  expect(p, TokenKind::LBrace)
  skip_newlines(p)
  
  # Check for closure: { |params| body }
  if at(p, TokenKind::Pipe) then
    advance(p)
    let params = parse_closure_params(p)
    expect(p, TokenKind::Pipe)
    let ret_type = parse_closure_return_type(p)
    skip_newlines(p)
    match parse_expr(p)
    when Option::Some(body) then
      skip_newlines(p)
      expect(p, TokenKind::RBrace)
      return Option::Some(make_expr(ExprKind::ExprClosure(params, ret_type, body), span_merge(start, peek_span(p))))
    when Option::None then return Option::None
    end
  else
    # Map literal or expression block
    match parse_expr(p)
    when Option::Some(expr) then
      skip_newlines(p)
      if at(p, TokenKind::FatArrow) then
        # Map literal
        advance(p)
        match parse_expr(p)
        when Option::Some(val) then
          mut entries = Vec::new()
          entries.push((expr, val))
          while at(p, TokenKind::Comma) do
            advance(p)
            skip_newlines(p)
            if at(p, TokenKind::RBrace) then break end
            match parse_expr(p)
            when Option::Some(k) then
              expect(p, TokenKind::FatArrow)
              match parse_expr(p)
              when Option::Some(v) then
                entries.push((k, v))
              when Option::None then break
              end
            when Option::None then break
            end
          end
          skip_newlines(p)
          expect(p, TokenKind::RBrace)
          return Option::Some(make_expr(ExprKind::ExprMapLit(entries), span_merge(start, peek_span(p))))
        when Option::None then return Option::None
        end
      else
        skip_newlines(p)
        expect(p, TokenKind::RBrace)
        let block = make_block(Vec::from([make_stmt(StmtKind::StmtExpr(expr), expr.span)]), span_merge(start, peek_span(p)))
        return Option::Some(make_expr(ExprKind::ExprBlock(block), span_merge(start, peek_span(p))))
      end
    when Option::None then return Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def parse(tokens: LexResult) -> (Program, Vec[Diagnostic])
  let tok_vec = tokens.tokens
  mut p = tgc_parser_new(tok_vec)
  for err in tokens.errors do
    let (msg, span) = err
    diag_error(&mut p.diag, ErrorCode::E100UnexpectedToken, msg, span)
  end
  let program = parse_program(&mut p)
  (program, p.diag)
end
