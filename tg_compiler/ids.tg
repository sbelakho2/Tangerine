# Tangerine Compiler — Central Semantic Identity Domains
# Self-hosting compiler written in Tangerine
#
# ONE module graph, ONE semantic identity system. Every semantic identity is
# a strong struct over a primitive payload — the Int-wrapped `id` field style
# established by LocalId/NodeId/TypeId — so cross-domain ID confusion is hard
# to express (the param-vs-pattern collision bug class that motivated the 
# strong IDs below).
#
# The domains:
#   ModuleId        the module graph's vertex identity: the ast.tg Crate's
#                   Map[ModuleId, Module] key, and every DefId's owner
#                   module.
#   DefId           a definition's identity: owner ModuleId + the per-module
#                   symbol index. The kind is definition METADATA (the
#                   resolver's metadata map, consulted by def_kind_of) — NOT
#                   part of the identity, so DefId equality is
#                   (module, index) only.
#   TypeId          a type definition's identity (the type checker's
#                   TypeDef.id).
#   TraitId         a trait definition's identity.
#   ImplId          an impl's identity.
#   VariantId       an enum variant's identity: owner TypeId + variant index.
#   GenericParamId  a generic parameter's identity: owner DefId + param index.
#   CallableId      newtype over DefId: every callable's identity.
#   InstanceId      a monomorphized callee's identity: CallableId + the
#                   concrete type substitutions. Moved here from
#                   trait_resolve.tg — the shared semantic identity domain.
#   ClosureId       a closure's identity.
# EffectId a declared effect's identity (— the interning table
#                   below; the builtin effect names are registered with
#                   FIXED ids, user effects intern module-qualified).
# IntrinsicId the semantic intrinsic-KIND classification (): the
#                   kind of an intrinsic call, attached by the type checker
#                   at call-recording time (typed_intrinsics in the typed
#                   program) and read by MIR/codegen for dispatch. An
#                   intrinsic DEFINITION's identity remains its DefId
#                   (DefKind::Intrinsic — the resolver registers the
#                   __intrinsic_* names); IntrinsicId is the KIND domain
#                   over those definitions.
#   CfgBlockId / CfgEdgeId — CFG vertex/edge identities.
#
# STRINGS ARE NOT IDENTITIES: module-path Strings belong only to diagnostics
# and to FINAL symbol mangling (the mangled emission name is derived at the
# mangling boundary — types.tg's fn_owner_key / the canonical type encoding —
# never compared or keyed as an identity).
#
# THE COMPILER-SYNTHETIC DEFINITION DOMAIN (): definitions the compiler
# synthesizes (the generated drop-glue functions, the synthetic-callable
# registrations, the builtin/intrinsic DefId allocations, the synthetic
# generic-parameter owners) live in ModuleIds BELOW ZERO — the negative
# synthetic module band, which can never collide with the non-negative
# source ModuleIds of Program.crate. The constants below name the band and
# the individual synthetic modules; every magic negative literal in the
# codebase must resolve to one of these constants (or be documented as a
# per-table synthetic owner index, e.g. the GenericParamTable's synthetic
# counter, which allocates synthetic OWNER DefIds inside the same band).
#
# consumers still constructing the old DefId shape
# { module: <path String>, index, kind: DefKind } — types.tg, mir.tg,
# trait_resolve.tg, resource_check.tg — are migrated by the next batch to
# resolve the ModuleId via the module graph; resolver.tg is on the new
# shape (DefId { module: ModuleId, index } + def_kinds metadata) and
# registers every declaration module-qualified.: the resolver's
# stable-id machinery is wired to the DIGEST MODEL below — its stable
# identities are stable_def_id_digested records (the canonical key stored
# alongside; an actual digest collision is stable_digest_verify's panic —
# the old FNV-64 + sequential-counter disambiguation in resolver.tg is
# are not part of the model), and its bare-name resolution feeds on the module_symbols /
# def_kinds entries (the bare-name first-wins tables).

use std::collections::{Vec, Map}
use tg_compiler::types::{Type}

# The definition-kind METADATA set (DefId carries no kind — the kind is
# the resolver's metadata map, consulted by def_kind_of). Trait is the
# module-semantic trait-declaration kind: the resolver registers every
# trait declaration under its module-qualified "path::name" key with this
# kind, so traits resolve through the SAME module-qualified machinery as
# types/callables (an import brings the trait into scope; two traits with
# the same name in different modules are distinct).
enum DefKind
  Function
  Method
  Static
  Constant
  EnumVariant
  StructField
  Intrinsic
  TypeName
  Trait
  Other
end

# The module graph's vertex identity. One ModuleId per module in the compiled
# program; the ast.tg Crate's Map[ModuleId, Module] is keyed by this, and
# DefId.module (below) points into that graph.
struct ModuleId
  id: Int
end

# ———————————————————————————————————————————————————————————————
# THE COMPILER-SYNTHETIC DEFINITION DOMAIN ()
# ———————————————————————————————————————————————————————————————
# Compiler-synthesized definitions (generated drop-glue functions, builtin
# and __intrinsic_* DefId allocations, synthetic generic-parameter owners)
# are NOT source definitions: they carry no Program.crate module. They live
# in the NEGATIVE synthetic module band — ModuleIds below zero, which can
# never collide with the non-negative source ModuleIds of Program.crate.
# Every synthetic identity must use one of the named constants below, never
# a magic literal. ModuleId 0 is the crate root; source file modules are
# >= 1.
const SYNTHETIC_MODULE_MIN: Int = -128
# The synthetic module for the resolver's runtime-intrinsic / builtin DefId
# allocations (the __intrinsic_* family, DefKind::Intrinsic) and the
# GenericParamTable's synthetic owners. Historically the magic -1.
const SYNTHETIC_MODULE_INTRINSIC: Int = -1
# The deterministic fallback owner for item functions without a resolver
# DefId (item_owner_def's module -2 fallback). Historically the magic -2.
const SYNTHETIC_MODULE_ITEM_FALLBACK: Int = -2
# The deterministic fallback owner for impl-method generic parameters
# without a resolver DefId (impl_method_owner_def's module -3 fallback).
# Historically the magic -3.
const SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK: Int = -3

def synthetic_module_id(id: Int) -> ModuleId
  if id >= 0 then
    panic("internal error: synthetic ModuleId must be negative (source modules are >= 0)")
  end
  ModuleId { id: id }
end

struct TypeId
  id: Int
end

# A definition's identity: the owner ModuleId (NEVER a path String — see the
# header: strings belong only to diagnostics and final symbol mangling) plus
# the per-module symbol index. The former `kind` component moved to
# definition metadata (the resolver's metadata map, consulted by
# def_kind_of), so DefId equality is (module, index) only.
struct DefId
  module: ModuleId
  index: UInt
end

# strong IDs: two more Int-wrapped identity domains so cross-domain ID
# confusion is hard to express (the resource checker's frame used to be
# indexed by a naked Int, so a parameter's id and a pattern node's id were
# the same type even though they live in different domains — the
# param-vs-pattern collision bug class). Compare with TypeId above:
#   - NodeId:  AST NODE identity — the parser's node ids (stmt.node_id,
#              expr.node_id, pat.node_id). Globally unique within one
#              compilation; the semantic node domain.
#   - LocalId: SEMANTIC LOCAL identity — the type checker's local-binding
#              ids: the keys of typed.local_bindings, the VALUES of
#              typed.param_binding_resolutions / typed.pattern_binding_
#              resolutions, the values of typed.ident_resolutions. Distinct
#              from AST node ids AND from the MIR's own lowered-function
#              local-slot domain (MirLocalId — mir.tg, renamed from the
#              ambiguous LocalId so two incompatible ID domains can never
#              share a spelling). The resource checker's ResFrame is keyed
#              by THIS type, so a pattern node id can no longer index the
#              frame by accident.
# The field name stays `id` so `.id` access keeps working at the domain
# boundaries (e.g. the finalize_plan values the MIR consumes are still
# plain Int).
struct NodeId
  id: Int
end

struct LocalId
  id: Int
end

struct FieldId
  owner: TypeId
  index: Int
end

# A trait definition's identity.
struct TraitId
  id: Int
end

# An impl's identity.
struct ImplId
  id: Int
end

# An enum variant's identity: the owner type's TypeId + the variant index.
struct VariantId
  owner: TypeId
  index: UInt
end

# A generic parameter's identity: the owner definition's DefId + the
# parameter index. The index IS the parameter's DECLARATION ORDER within
# the owner — the interning table below allocates indices in
# declaration order at registration, so GenericParamId order and the
# substs-order contract (the InstanceId.substs Vec aligns positionally with
# the declaration order) are the same thing by construction.
struct GenericParamId
  owner: DefId
  index: UInt
end

# ———————————————————————————————————————————————————————————————
# the generic-parameter interning table (the registration the
# GenericParamId domain needs)
# ———————————————————————————————————————————————————————————————
#
# Every declaration (function / impl / method / type / builtin) interns its
# generic parameters IN DECLARATION ORDER at registration:
#   - the interning allocates each parameter's index as the owner's current
#     interned count (counts), so the GenericParamId order IS the
#     declaration order — the substs-order contract holds by construction;
#   - the parameter NAME is stored SEPARATELY, keyed by GenericParamId
#     (names) — the param-name table: diagnostics look up a name by id;
#     identity is the id, never the name.
#
# Owners: a declaration with a resolver DefId (functions via item_defs,
# methods via their registered method DefId, types via the
# module_symbols DefKind::TypeName entries) interns under that DefId — the
# declaration context. Declarations
# without one (the builtin type/trait registrations, the impl-level
# parameter lists, IR-synthesized functions) intern under a SYNTHETIC owner
# from fresh_synthetic_owner — module id -1, a dedicated counter — which can
# never collide with the non-negative source ModuleIds. The synthetic owner
# is allocated ONCE per declaration, so the owner's interned indices are
# still the declaration order.
struct GenericParamTable
  names: Map[Int, String]   # numeric GenericParamId -> parameter name
  counts: Map[Int, UInt]    # numeric owner DefId -> interned param count
  synthetic_counter: UInt   # index source of the synthetic owner DefIds
end

def generic_param_table_new() -> GenericParamTable
  GenericParamTable { names: Map::new(), counts: Map::new(), synthetic_counter: 0 }
end

# The numeric flattening of a DefId — the (module.id << 32) + index
# convention callable_id_numeric (types.tg) established. Synthetic owners
# use module id -1, which shifts negative and can never collide with the
# non-negative source module ids.
def def_id_numeric(did: &DefId) -> Int
  (did.module.id << 32) + (did.index as Int)
end

# The numeric flattening of a GenericParamId: the owner's flattening in the
# high bits, the parameter index in the low byte — a declaration's
# parameter list is tiny, so the index always fits in the low 8 bits.
# (numeric packing invariant): the invariant is ENFORCED at the
# declaration interning site (types.tg's intern_generic_params) — a
# declaration with MORE THAN 255 generic parameters is a compilation
# diagnostic, so the packed key is never produced for an over-limit
# declaration.
def generic_param_id_numeric(gpid: &GenericParamId) -> Int
  (def_id_numeric(&gpid.owner) << 8) + (gpid.index as Int)
end

# GenericParamId equality: (owner ModuleId, owner index, param index) —
# the id IS the identity; the name never participates.
def generic_param_id_eq(a: &GenericParamId, b: &GenericParamId) -> Bool
  a.owner.module.id == b.owner.module.id && a.owner.index == b.owner.index && a.index == b.index
end

# A fresh synthetic owner DefId for a declaration the resolver never gave a
# DefId (builtin type/trait registrations, impl-level parameter lists,
# IR-synthesized functions). Module id -1; the index comes from the table's
# dedicated counter, so two synthetic owners never collide with each other
# or with the source DefIds.
def fresh_synthetic_owner(table: &mut GenericParamTable) -> DefId
  let owner = DefId { module: synthetic_module_id(SYNTHETIC_MODULE_INTRINSIC), index: table.synthetic_counter }
  table.synthetic_counter = table.synthetic_counter + 1
  owner
end

# Intern ONE generic parameter of `owner` in declaration order: the
# parameter's index is the owner's current interned count, so the
# GenericParamId order IS the declaration order. Records the name in the
# param-name table (diagnostics only). Idempotent per (owner, name):
# re-interning an already-recorded name returns its existing id, so a
# declaration interned twice (an env re-run) never shifts the
# declaration-order indices. Returns the id.
def intern_generic_param(table: &mut GenericParamTable, owner: &DefId, name: String) -> GenericParamId
  let owner_key = def_id_numeric(owner)
  let index = match table.counts.get(owner_key)
  when Option::Some(c) then c
  when Option::None then 0
  end
  var j = 0
  while j < index do
    let existing_id = GenericParamId { owner: owner.clone(), index: j }
    let existing_key = generic_param_id_numeric(&existing_id)
    match table.names.get(existing_key)
    when Option::Some(n) then
      if n == name then
        return existing_id
      end
    when Option::None then ()
    end
    j = j + 1
  end
  let gpid = GenericParamId { owner: owner.clone(), index: index }
  table.names.insert(generic_param_id_numeric(&gpid), name)
  table.counts.insert(owner_key, index + 1)
  gpid
end

# The registered name of a generic parameter, for diagnostics: the
# param-name table lookup keyed by GenericParamId; "<param#<numeric>>" for
# an id the table never interned (a synthesized IR-only parameter).
def generic_param_name_of(table: &GenericParamTable, gpid: &GenericParamId) -> String
  match table.names.get(generic_param_id_numeric(gpid))
  when Option::Some(n) then n.clone()
  when Option::None then "<param#" + generic_param_id_numeric(gpid).to_string() + ">"
  end
end

# The name of a generic parameter from a bare names snapshot (the
# MonoCache / MirProgram tables — the serialized form of the table's
# names map); "<param#<numeric>>" when the snapshot never recorded it.
def generic_param_name_from(names: &Map[Int, String], gpid: &GenericParamId) -> String
  match names.get(generic_param_id_numeric(gpid))
  when Option::Some(n) then n.clone()
  when Option::None then "<param#" + generic_param_id_numeric(gpid).to_string() + ">"
  end
end

# Newtype over DefId: every callable's identity (functions, methods,
# statics, intrinsics — anything invocable).
struct CallableId
  def: DefId
end

# CFG vertex identity (the codegen-side control-flow graph domain).
struct CfgBlockId
  id: Int
end

# CFG edge identity (the codegen-side control-flow graph domain).
struct CfgEdgeId
  id: Int
end

# The semantic ACCESS identity: one per access (borrow/use of a place) the
# access checker records on a CFG edge. CleanupAction::EndAccess names it —
# the resource checker's edge cleanup ends the accesses the edge's transfer
# performed. The access checker allocates fresh ids per access_check run
# (the ACCESS_REGISTRY accumulator in resource_check.tg); the id is the
# numeric identity, never a name.
struct AccessId
  id: Int
end

# The semantic ROOT of an access path (the access checker's TypedPlace):
#   - Local(LocalId)  a local binding (the type checker's local-binding id —
#                     the typed.ident_resolutions value);
#   - SelfValue       the `self` receiver (previously the magic negative
#                     integer root);
#   - Static(DefId)   a static/const value (the resolver's DefId);
#   - RawUnknown      a root whose provenance cannot be known (a raw-pointer
#                     root, or an unresolvable root) — never provably
#                     disjoint from any other root.
# Roots are semantic identities; overlap analysis compares them
# structurally (never by name or by a naked integer).
enum AccessRoot
  Local(LocalId)
  SelfValue
  Static(DefId)
  RawUnknown
end

# A closure's identity.
struct ClosureId
  id: Int
end

# ———————————————————————————————————————————————————————————————
# the semantic FinalizerKind domain — the typed
# finalizer classification
# ———————————————————————————————————————————————————————————————
# The KIND of a registered finalizer method, assigned at declaration/type
# checking (the checker's Drop-impl / deinit registration — types.tg's
# finalizer registration walk — records the kind alongside the finalizer's
# CallableId in TypedProgram.finalizer_kinds). NO downstream consumer
# recognizes a finalizer by its SOURCE NAME: the MIR builder and the
# resource checker consult the typed kind (finalizer_kind_of_callable),
# never `name == "deinit"` / `name == "drop"`.
#   NotFinalizer     — an ordinary method (no finalizer semantics).
#   DropTraitMethod  — an EXPLICIT `impl Drop for T` drop method (the
#                      Drop-trait impl registration produces this kind; the
#                      trait identity is the LangItems drop_trait TraitId,
#                      never the method name).
#   DeinitMethod     — an inherent `fn deinit` method (the canonical
#                      Tangerine finalizer; this kind covers both the
#                      declaration-site kind and the explicitly-registered
#                      form the checker records).
enum FinalizerKind
  NotFinalizer
  DropTraitMethod
  DeinitMethod
end

# The numeric flattening of a FinalizerKind (the discriminant) — the
# serialized form maps carry when a numeric projection is needed.
# Deterministic per enum declaration order.
def finalizer_kind_numeric(k: &FinalizerKind) -> Int
  match k
  when FinalizerKind::NotFinalizer then 0
  when FinalizerKind::DropTraitMethod then 1
  when FinalizerKind::DeinitMethod then 2
  end
end

# ———————————————————————————————————————————————————————————————
# the EffectId domain — the declared effects, interned
# ———————————————————————————————————————————————————————————————
# The canonical effect sets in TYPE values ARE the interned id
# collections: the Type::Effect(Vec[EffectId],...) variant carries the
# canonical ordered effect-ID set (the String-set form is gone — the
# identity is the id, never the name). The
# EffectId domain is the semantic identity of a DECLARED effect, used by
# the canonical type identity (the canonical ordered effect-ID set) and
# by the effect classification. The registry:
#   - the BUILTIN effect names (Io / Network / File /...) are registered
#     with FIXED EffectId constants (deterministic across compilations —
#     the public ABI renders them by their fixed ids/names);
#   - USER effects (an `effect Name` declaration, or an effect name used in
#     a type) intern with fresh ids under their MODULE-QUALIFIED key
#     ("path::name" — the root module's effects intern under the bare
#     name), so two same-named effects in different modules are distinct.
# Identity is the id; the name map exists for diagnostics and for the ABI
# render (the ABI renders module-qualified names, never per-compilation
# ids).
const EFFECT_IO: Int = 1
const EFFECT_NETWORK: Int = 2
const EFFECT_FILE: Int = 3
const EFFECT_ASYNC: Int = 4
const EFFECT_TIMER: Int = 5

struct EffectId
  id: Int
end

def effect_id_eq(a: &EffectId, b: &EffectId) -> Bool
  a.id == b.id
end

# The canonical ordered effect-SET equality of two Type::Effect payloads
# (element order matters — the canonical ordered effect-ID set is the
# type identity's effect component; the set's canonical ORDER is the
# source order the checker constructs, and the identity render sorts the
# same elements canonically).
def effect_vec_eq(a: &Vec[EffectId], b: &Vec[EffectId]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if !effect_id_eq(&a[i], &b[i]) then
      return false
    end
    i = i + 1
  end
  true
end

# The effect interning table. Builtin effects register at construction
# (effect_registry_new) with their FIXED ids; user effects intern through
# intern_effect / intern_module_effect with fresh ids (module-qualified
# keys for user effects). names is id -> name; by_name is the interned key
# -> id. Fresh ids start above the builtin band (EFFECT_USER_BASE).
const EFFECT_USER_BASE: Int = 64

struct EffectRegistry
  names: Map[Int, String]
  by_name: Map[String, Int]
  next_id: Int
end

def effect_registry_new() -> EffectRegistry
  var reg = EffectRegistry { names: Map::new(), by_name: Map::new(), next_id: EFFECT_USER_BASE }
  register_builtin_effect(&mut reg, EFFECT_IO, "Io")
  register_builtin_effect(&mut reg, EFFECT_NETWORK, "Network")
  register_builtin_effect(&mut reg, EFFECT_FILE, "File")
  register_builtin_effect(&mut reg, EFFECT_ASYNC, "Async")
  register_builtin_effect(&mut reg, EFFECT_TIMER, "Timer")
  reg
end

# Register a builtin effect under its FIXED id (the ABI-deterministic band).
def register_builtin_effect(reg: &mut EffectRegistry, id: Int, name: String) -> Unit
  reg.names.insert(id, name.clone())
  reg.by_name.insert(name.clone(), id)
end

# The interned id of an effect name (the builtin fixed ids and the already
# interned user effects); Option::None for a name never registered.
def effect_id_of_name(reg: &EffectRegistry, name: &String) -> Option[EffectId]
  match reg.by_name.get(name.clone())
  when Option::Some(id) then Option::Some(EffectId { id: id })
  when Option::None then Option::None
  end
end

# The name of an interned effect id (the ABI renders names, never ids);
# Option::None for an id the registry never interned.
def effect_name_of_id(reg: &EffectRegistry, id: &EffectId) -> Option[String]
  match reg.names.get(id.id)
  when Option::Some(n) then Option::Some(n.clone())
  when Option::None then Option::None
  end
end

# Intern a user effect under the MODULE-QUALIFIED key ("path::name"; the
# root module's empty path degenerates to the bare name). A builtin name
# resolves to its fixed id instead. Returns the id.
def intern_module_effect(reg: &mut EffectRegistry, module_path: &Vec[String], name: &String) -> EffectId
  match effect_id_of_name(reg, name)
  when Option::Some(eid) then return eid
  when Option::None then ()
  end
  let key = if module_path.is_empty() then name.clone() else module_path.join("::") + "::" + name.clone() end
  match reg.by_name.get(key.clone())
  when Option::Some(id) then EffectId { id: id }
  when Option::None then
    let id = reg.next_id
    reg.next_id = reg.next_id + 1
    reg.names.insert(id, key.clone())
    reg.by_name.insert(key.clone(), id)
    EffectId { id: id }
  end
end

# A stable def ID is a content-based identity that survives across
# compilations even when source positions change. It is computed from the
# fully-qualified path + signature of the definition. The canonical key
# that produced the digest is stored alongside it so a digest collision
# between two distinct keys is detectable instead of silently mapping
# both definitions to the same id.
#
# DIGEST MODEL: the identity is the 128-bit STABLE DIGEST
# (StableDigest — two independent FNV-1a passes over the length-prefixed
# canonical key, stable_digest_of) of the canonical key — NOT a 64-bit FNV
# hash plus an order-sensitive collision disambiguation. `hash` and `id`
# are the LOW 64-bit word of the digest: the projection the UInt-keyed
# incremental cache maps key by; the FULL digest (digest_hi / digest_lo)
# IS the identity. COLLISION POLICY: an actual 128-bit digest collision
# (two distinct canonical keys whose hi AND lo both agree) is an INTERNAL
# FAILURE (stable_digest_verify panics) — an order-dependent alternate
# identity (a sequential-counter disambiguation) is NEVER created; the
# canonical key stored alongside makes every lower-width projection
# collision equally detectable at lookup (the stored key is compared, not
# assumed).
struct StableDigest
  hi: UInt   # high 64-bit word of the 128-bit digest
  lo: UInt   # low 64-bit word of the 128-bit digest
end

# The 128-bit stable digest of a canonical key: two independent FNV-1a
# passes (distinct offset bases) over the length-prefixed key bytes, with
# a domain tag — a 128-bit collision space, deterministic across
# compilations. The identity of a StableDefId.
def stable_digest_of(key: &String) -> StableDigest
  var hi: UInt = 0xcbf29ce484222325  # FNV-1a offset basis (pass A)
  var lo: UInt = 0x84222325cbf29ce4  # rotated second basis (pass B)
  hi = hi ^ 0x11  # domain tag: the stable-def-id digest domain
  lo = lo ^ 0x22
  let len_bytes: Vec[Int] = key.len().to_string().bytes()
  for c in len_bytes do
    hi = hi ^ (c as UInt)
    hi = hi * 0x100000001b3  # FNV-1a prime
    lo = lo ^ (c as UInt)
    lo = lo * 0x100000001b3
  end
  let key_bytes: Vec[Int] = key.bytes()
  for c in key_bytes do
    hi = hi ^ (c as UInt)
    hi = hi * 0x100000001b3
    lo = lo ^ (c as UInt)
    lo = lo * 0x100000001b3
  end
  StableDigest { hi: hi, lo: lo }
end

# StableDigest equality — the full 128-bit identity comparison.
def stable_digest_eq(a: &StableDigest, b: &StableDigest) -> Bool
  a.hi == b.hi && a.lo == b.lo
end

# The digest of a StableDefId — its identity.
def stable_def_id_digest(sid: &StableDefId) -> StableDigest
  StableDigest { hi: sid.digest_hi, lo: sid.digest_lo }
end

# The COLLISION POLICY enforcement point: an actual 128-bit digest
# collision (two distinct canonical keys with equal digests) is an
# INTERNAL FAILURE — panic — never an order-dependent alternate identity.
# Registration and lookup compare the canonical key against the stored key
# through this check; a mismatch aborts the compilation.
def stable_digest_verify(sid: &StableDefId, expected_key: &String) -> Unit
  if sid.key != expected_key.clone() then
    panic("internal error: stable id digest collision — the canonical keys `" + sid.key + "` and `" + expected_key.clone() + "` share a stable id (a 128-bit digest collision is an internal failure; no counter-disambiguated identity is created)")
  end
end

# The digest-model builder for a stable def id: digest the canonical key,
# store the key alongside, and derive the registered id from the digest's
# low word (the projection the incremental cache maps key by). The digest
# itself (hi/lo) is the identity.: the resolver's stable-id machinery
# (compute_stable_def_id / register_stable_id) is wired to this builder —
# the canonical key is built as "path::name" + "#" + signature.
def stable_def_id_digested(key: String, path: String) -> StableDefId
  let d = stable_digest_of(&key)
  StableDefId { hash: d.lo, key: key, path: path, id: d.lo, digest_hi: d.hi, digest_lo: d.lo }
end

# StableDefId fields: `hash` and `id` are the LOW 64-bit word of the
# 128-bit digest of the canonical key (the projection the UInt-keyed
# incremental maps use); the full digest (digest_hi / digest_lo) is the
# identity. `id` is NEVER a counter-disambiguated alternate identity —
# see the collision policy above.
struct StableDefId
  hash: UInt       # low 64-bit word of the 128-bit digest of the
                   # canonical key (the UInt-keyed cache projection)
  key: String      # Canonical key that was digested (path + "#" + signature)
  path: String     # Human-readable path (e.g., "std::collections::Vec::push")
  id: UInt         # Registered stable id: the digest's low word — never a
                   # hash + counter disambiguation (an actual digest
                   # collision is an internal failure, not an alternate
                   # identity)
  digest_hi: UInt = 0  # the 128-bit digest of the canonical key: high word
  digest_lo: UInt = 0  # the 128-bit digest of the canonical key: low word
end

# a monomorphized callee's identity — the callable's DefId (via
# CallableId) plus the concrete type substitutions. Moved from
# trait_resolve.tg into the shared semantic identity domain. The instance
# payload is the ONLY authority for type arguments at the monomorphizer
# (zero-inference: the monomorphizer never fills them from a call site).
struct InstanceId
  def: CallableId
  substs: Vec[Type]
end

# ———————————————————————————————————————————————————————————————
# the semantic IntrinsicId domain — the intrinsic-KIND classification
# ———————————————————————————————————————————————————————————————
# The semantic classification of an intrinsic call, attached by the type
# checker at call-recording time (TypedProgram.typed_intrinsics — the
# node-id-keyed classification) and consumed by MIR/codegen for dispatch.
# This is the KIND domain over intrinsic definitions (an intrinsic
# definition's IDENTITY remains its DefKind::Intrinsic DefId — the
# resolver's __intrinsic_* registration); the enum names the machine
# operation the name denotes. Moved here from codegen.tg's local enum so
# the frontend and the backend share ONE classification domain: the name
# table lives in types.tg (classify_intrinsic_call — the semantic router
# the checker attaches with and codegen's dispatch reads), and codegen
# holds no name-matching table of its own.
enum IntrinsicId
  ArrayAsPtrAddress
  ReadFileToStringNative
  SetIsEmpty
  MapPush
  ArrayReplace
  ArrayAsStr
  ArrayPush
  ArrayPop
  ArrayNew
  ArrayLen
  ArrayGet
  ArraySet
  StrSlice
  Syscall1
  Syscall2
  Syscall3
  Syscall4
  Syscall5
  Syscall6
  ArrayAsPtr
  IntToString
  FloatToString
  BoolToString
  CharToString
  StrToString
  StringFromBytes
  ToString
  AsBytes
  AsPtr
  AsStr
  Clone
  Len
  StrConcat
  StrLen
  StrCmp
  StrFind
  StartsWith
  EndsWith
  StringContains
  StrCopy
  IntToStr
  FloatToStr
  StrToInt
  StrToFloat
  ArrayCap
  ArrayRemove
  ArrayInsert
  ArrayClear
  ArrayDestroy
  ArrayContains
  ArrayLast
  ArrayFirst
  ArrayIsEmpty
  ArrayReverse
  ArraySort
  ArrayExtend
  ArrayTruncate
  ArrayResize
  MapNew
  MapInsert
  MapGet
  MapRemove
  MapRemoveKey
  MapContains
  OptionWrap
  MapLen
  MapClone
  MapClear
  MapKeys
  MapValues
  MapEntries
  MapDrainOne
  MapDestroy
  SetNew
  SetInsert
  SetContains
  SetRemove
  SetRemoveKey
  SetLen
  SetClone
  SetEntries
  SetDrainOne
  SetDestroy
  SetClear
  DropInPlace
  Drop
  MemAlloc
  MemFree
  MemCopy
  MemSet
  MemZero
  HashInt
  HashStr
  HashCombine
  Chars
  CharAt
  CStringNew
  CStringAsPtr
  Bytes
  IsSome
  IsNone
  Unwrap
  UnwrapOr
  Status
  Output
  StdoutString
  StderrString
  FormatterNoOp
  FormatterEmitNewline
  WouldOverflow
  Cmp
  ToInt
  LintFile
  SysWrite
  SysRead
  SysOpen
  SysClose
  SysExit
  OWriteOnly
  ORdWr
  OAppend
  OCreate
  OTrunc
  OpenWindows
  TrimMatches
  SplitOnce
  ToLowercase
  MapJoinCollect
  SplitLinesTrim
  StringReplace
  StringSplit
  ArraySlice
  ArrayFromList
  ArrayWithCapacity
  ArrayCapacity
  ArrayJoin
  StringIsEmptyChars
  StringTrim
  StringToLowercase
  StringSplitLines
 # the owned String-object ABI intrinsics. The string_* names
  # dispatch here — NEVER to the Array runtime (the historical
  # string_new→ArrayNew / string_push→ArrayPush aliasing is removed).
  StringNew
  StringPush
  StringPushStr
  StringReserve
  StringLen
  StringHash
  StringAsPtr
  StringAsStr
  StringClone
  StringFromStatic
end

# The compiler-known intrinsic EXTERN name test: only declarations whose
# name carries the `__intrinsic_` prefix (the std/collections.tg,
# std/core.tg, std/ctx.tg intrinsic family — the bootstrap collections'
# internal visitor signatures and the compiler's builtin operations) are
# allowed the reference forms (`&T` / `Option[&T]`) in their extern type
# positions — the internal address/reference ABI (TypeExprKind::Ref →
# RefInternal). An ordinary user extern (any other name) is the strict
# FFI boundary: its reference-form type positions are rejected (E106 —
# Tangerine has no first-class references) and the interop guidance is
# raw pointers / view structs. The parser gates its extern-ABI context on
# this test (parse_extern_fn / parse_extern_static — the name is read
# before the type positions).
def is_intrinsic_extern_name(name: &String) -> Bool
  name.starts_with("__intrinsic_")
end

# The numeric flattening of an IntrinsicId (the discriminant) — the
# serialized form the typed program's per-call classification carries
# through maps keyed by Int. Deterministic per enum declaration order.
def intrinsic_id_numeric(id: &IntrinsicId) -> Int
  match id
  when IntrinsicId::ArrayAsPtrAddress then 0
  when IntrinsicId::ReadFileToStringNative then 1
  when IntrinsicId::SetIsEmpty then 2
  when IntrinsicId::MapPush then 3
  when IntrinsicId::ArrayReplace then 4
  when IntrinsicId::ArrayAsStr then 5
  when IntrinsicId::ArrayPush then 6
  when IntrinsicId::ArrayPop then 7
  when IntrinsicId::ArrayNew then 8
  when IntrinsicId::ArrayLen then 9
  when IntrinsicId::ArrayGet then 10
  when IntrinsicId::ArraySet then 11
  when IntrinsicId::StrSlice then 12
  when IntrinsicId::Syscall1 then 13
  when IntrinsicId::Syscall2 then 14
  when IntrinsicId::Syscall3 then 15
  when IntrinsicId::Syscall4 then 16
  when IntrinsicId::Syscall5 then 17
  when IntrinsicId::Syscall6 then 18
  when IntrinsicId::ArrayAsPtr then 19
  when IntrinsicId::IntToString then 20
  when IntrinsicId::FloatToString then 21
  when IntrinsicId::BoolToString then 22
  when IntrinsicId::CharToString then 23
  when IntrinsicId::StrToString then 24
  when IntrinsicId::StringFromBytes then 25
  when IntrinsicId::ToString then 26
  when IntrinsicId::AsBytes then 27
  when IntrinsicId::AsPtr then 28
  when IntrinsicId::AsStr then 29
  when IntrinsicId::Clone then 30
  when IntrinsicId::Len then 31
  when IntrinsicId::StrConcat then 32
  when IntrinsicId::StrLen then 33
  when IntrinsicId::StrCmp then 34
  when IntrinsicId::StrFind then 35
  when IntrinsicId::StartsWith then 36
  when IntrinsicId::EndsWith then 37
  when IntrinsicId::StringContains then 38
  when IntrinsicId::StrCopy then 39
