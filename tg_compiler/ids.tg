  when IntrinsicId::SetInsert then 74
  when IntrinsicId::SetContains then 75
  when IntrinsicId::SetRemove then 76
  when IntrinsicId::SetRemoveKey then 77
  when IntrinsicId::SetLen then 78
  when IntrinsicId::SetClone then 79
