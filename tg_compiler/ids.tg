enum DefKind
  Function
  Method
  Static
  Constant
  EnumVariant
  StructField
  Intrinsic
  TypeName
  Other
end

struct DefId
  module: String
  index: UInt
  kind: DefKind
end

struct TypeId
  id: Int
end

# P1 strong IDs: two more Int-wrapped identity domains so cross-domain ID
# confusion is hard to express (the resource checker's frame used to be
# indexed by a naked Int, so a parameter's id and a pattern node's id were
# the same type even though they live in different domains — the
# param-vs-pattern collision bug class). Compare with TypeId above:
#   - NodeId:  AST NODE identity — the parser's node ids (stmt.node_id,
#              expr.node_id, pat.node_id). Globally unique within one
#              compilation; the semantic node domain.
#   - LocalId: SEMANTIC LOCAL identity — the type checker's local-binding
#              ids: the keys of typed.local_bindings, the VALUES of
#              typed.param_binding_resolutions / typed.pattern_binding_
#              resolutions, the values of typed.ident_resolutions. Distinct
#              from AST node ids AND from the MIR's own LocalId (mir.tg —
#              the codegen-side local-slot domain). The resource checker's
#              ResFrame is keyed by THIS type, so a pattern node id can no
#              longer index the frame by accident.
# The field name stays `id` so `.id` access keeps working at the domain
# boundaries (e.g. the finalize_plan values the MIR consumes are still
# plain Int).
struct NodeId
  id: Int
end

struct LocalId
  id: Int
end

struct FieldId
  owner: TypeId
  index: Int
end

# A stable def ID is a content-based identity that survives across
# compilations even when source positions change. It is computed from the
# fully-qualified path + signature of the definition. The canonical key
# that produced the hash is stored alongside it so a hash collision
# between two distinct keys is detectable instead of silently mapping
# both definitions to the same id.
struct StableDefId
  hash: UInt       # 64-bit FNV-1a hash of the canonical key
  key: String      # Canonical key that was hashed (path + "#" + signature)
  path: String     # Human-readable path (e.g., "std::collections::Vec::push")
  id: UInt         # Registered stable id: the hash, or a disambiguated
                   # hash + counter id when a collision was detected
end
