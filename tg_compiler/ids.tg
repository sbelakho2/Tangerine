  when IntrinsicId::ArrayCap then 44
  when IntrinsicId::ArrayRemove then 45
  when IntrinsicId::ArrayInsert then 46
  when IntrinsicId::ArrayClear then 47
  when IntrinsicId::ArrayDestroy then 48
  when IntrinsicId::ArrayContains then 49
  when IntrinsicId::ArrayLast then 50
