# Tangerine Compiler — Shared Utilities
# Common helper functions used across compiler modules.

use std::core::{Option, Result}

# ———————————————————————————————————————————————————————————————
# Numeric Utilities
# ———————————————————————————————————————————————————————————————

pub def to_float(i: Int) -> Float
  __intrinsic_int_to_float(i)
end

pub def to_int(f: Float) -> Int
  __intrinsic_float_to_int(f)
end

pub def max_int(a: Int, b: Int) -> Int
  if a > b then a else b end
end

pub def min_int(a: Int, b: Int) -> Int
  if a < b then a else b end
end

pub def clamp_int(value: Int, low: Int, high: Int) -> Int
  if value < low then low
  elsif value > high then high
  else value
  end
end

pub def abs_int(a: Int) -> Int
  if a < 0 then -a else a end
end

pub def max_float(a: Float, b: Float) -> Float
  if a > b then a else b end
end

pub def min_float(a: Float, b: Float) -> Float
  if a < b then a else b end
end

pub def clamp_float(value: Float, low: Float, high: Float) -> Float
  if value < low then low
  elsif value > high then high
  else value
  end
end

# ———————————————————————————————————————————————————————————————
# Math
# ———————————————————————————————————————————————————————————————

pub def pow(base: Float, exp: Float) -> Float
  __intrinsic_pow(base, exp)
end

pub def sha256(input: String) -> String
  # Use the real SHA-256 implementation from std::crypto.
  let bytes = input.as_bytes()
  let hash = std::crypto::sha256(&bytes)
  mut out = ""
  let digits = "0123456789abcdef"
  for b in hash do
    out = out + digits.char_at(((b >> 4) & 0xF) as Int).to_string()
    out = out + digits.char_at((b & 0xF) as Int).to_string()
  end
  out
end

def fnv1a64_seed(s: String, seed: UInt) -> UInt
  mut h: UInt = seed
  let bytes: Vec[Int] = s.bytes()
  for b in bytes do
    h = h ^ (b as UInt)
    h = h * 0x100000001b3
  end
  h
end

def hex_u64(v: UInt) -> String
  let digits = "0123456789abcdef"
  mut out = ""
  mut shift = 60
  while shift >= 0 do
    let nibble = ((v >> shift) & 0xF) as Int
    out = out + digits.char_at(nibble).to_string()
    shift = shift - 4
  end
  out
end

# ———————————————————————————————————————————————————————————————
# String Utilities
# ———————————————————————————————————————————————————————————————

pub def repeat_string(s: String, count: Int) -> String
  mut result = ""
  mut i = 0
  while i < count do
    result = result + s
    i = i + 1
  end
  result
end
