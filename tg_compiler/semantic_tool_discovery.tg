# Tangerine Compiler — Dynamic Semantic-Tool Discovery (Tier-4, piece 2)
# Self-hosting compiler written in Tangerine
#
# This module is the DISCOVERY half of the Tier-4 rationale surface; the
# rationale records / store / grounded constructors / R1-R5 lane stay in
# semantic_rationale.tg (data-only). Declared AFTER semantic_server.tg
# because the §39 operation registry walk and the typed-schema constructors
# live there; semantic_server.tg imports the rationale RECORDS, so the two
# layers stay acyclic: model -> rationale/data -> server -> discovery.
#
# DYNAMIC SEMANTIC-TOOL DISCOVERY (audit item 4 — TYPED SCHEMAS). ONE
#    SemanticToolSchema per implemented semantic operation family — the
#    machine-checkable surface automated consumers enumerate instead of
#    hardcoding. Each row carries the stable tool id (canonical name +
#    semantic_operation_digest), the typed argument ProductSchema (field
#    name + value kind + required/optional + semantic-id-kind constraint +
#    the text-boundary mark), the typed result SumSchema (answer record
#    families), the identity domains, the completeness contract (the
#    documented unavailable kind included), the typed ArtifactRequirements,
#    the mutability / determinism / cost classes, the stability and the
#    handler capability word. The list is built from TWO live sources,
#    never invented names:
#      a. the §39 OPERATION REGISTRY WALK:
#         semantic_server.semantic_tool_schemas() — ONE schema per
#         server_operations() row, built from the handler's real typed
#         request/response records. A registered name with no schema row is
#         REPORTED (semantic_tool_schema_missing) and the lane fails
#         closed; nothing is papered over by a default row.
#      b. the §38 QUERY-DISPATCH + EXPORT SUPPLEMENT: the implemented
#         engine exports not carried by the registry (change_affected /
#         change_semantic_diff, abi_inspect / abi.diff / abi.ffi_report /
#         abi.rows, perf_report.tg's report / fact engines, hole_constraints,
#         type_use, and this module's own rationale surface), each with its
#         own typed schema built from the library signature it actually has.
#    service.describe (audit item 4a) is the BOOTSTRAP server op: one call
#    returns the rendered schema of every registered operation (itself
#    included) so a client with no prior vocabulary discovers the whole
#    protocol. Stability is the typed ToolStability (stable = the
#    long-standing session families that answer from the session
#    snapshot+index; experimental = the artifact-fed families or those with
#    a documented unavailable form). semantic_tools is deterministic
#    byte-sorted and deduped (registry rows win); tool_for /
#    tools_requiring_mir / tools_requiring_coverage / tools_requiring_store
#    are the filters, keyed on the typed ArtifactRequirements.
#
use std::collections::{Vec}

use tg_compiler::semantic_model::{
  SemanticToolSchema, ProductSchema, SumSchema, SchemaField, SchemaValueKind,
  TextKind, TextBoundary, StableIdKind, CompletenessContract,
  ArtifactRequirements, Mutability, DeterminismClass, QueryCostClass,
  ToolStability, RecordFamily, tool_stability_word
}
# (audit item 4) the §39 operation registry + the registry schema walk and
# constructors this supplement builds its rows through (the same
# id/digest/version authority as the registry rows).
use tg_compiler::semantic_server::{
  server_operations,
  semantic_tool_schemas, semantic_tool_schema_missing, semantic_tool_schema_new,
  semantic_operation_digest,
  schema_field_text, schema_field_required, schema_text_args, schema_result1,
  schema_complete, schema_gated, schema_artifacts, schema_no_artifacts,
  service_describe_schemas, semantic_schema_lane_check
}
# The R1-R5 rationale lane (data-side verification) and the shared lane
# row helpers the T1-T5 lane reports through.
use tg_compiler::semantic_rationale::{
  rationale_lane_bool, rationale_lane_int, rationale_lane_text, rationale_lane_rows,
  rationale_lane_check
}

# ═══════════════════════════════════════════════════════════════
# 1. THE SEMANTIC-TOOL DISCOVERY SURFACE (typed schemas — audit item 4)
# ═══════════════════════════════════════════════════════════════
# ONE SemanticToolSchema per implemented semantic operation family — the
# machine-checkable replacement for the String inputs/outputs discovery
# descriptions. The list is built from TWO live sources, never invented
# names:
#   a. the §39 OPERATION REGISTRY WALK: semantic_server.semantic_tool_schemas()
#      (registry order; ONE schema per server_operations() row with the
#      REAL typed argument product / result sum, identity domains,
#      completeness contract, artifact requirements, mutability / determinism
#      / cost classes — built from the handler's typed records). A registered
#      name with no schema row is REPORTED (semantic_tool_schema_missing),
#      never papered over; service.describe returns exactly one row per
#      registry operation, itself included.
#   b. the §38 QUERY-DISPATCH + EXPORT SUPPLEMENT: the implemented engine
#      exports not carried by the registry (this module's rationale surface,
#      the change / ABI / perf / hole engines, type.use), each with its own
#      typed schema built from the library signature it actually has.
# semantic_tools is deterministic byte-sorted and deduped (registry rows
# win); tool_for / tools_requiring_mir / tools_requiring_coverage /
# tools_requiring_store are the filters, the latter three keyed on the
# schema's TYPED ArtifactRequirements.

# The supplement's typed schema builder: the same id/digest/version
# authority as the registry rows (semantic_tool_schema_new), read-only.
def tool_supplemental(
  name: String,
  capability: String,
  arguments: ProductSchema,
  result: SumSchema,
  ids: Vec[StableIdKind],
  artifacts: ArtifactRequirements,
  determinism: DeterminismClass,
  cost: QueryCostClass,
  stability: ToolStability,
  completeness: CompletenessContract
) -> SemanticToolSchema
  semantic_tool_schema_new(name, capability, arguments, result, ids, completeness,
    artifacts, Mutability::ReadOnly, determinism, cost, stability)
end

def supplemental_key_args(field_name: String) -> ProductSchema
  ProductSchema {
    fields: Vec::from([schema_field_text(field_name, TextKind::CanonicalKeyText)]),
    boundary: TextBoundary::KeyText
  }
end

def supplemental_typed_args(fields: Vec[SchemaField], boundary: TextBoundary) -> ProductSchema
  ProductSchema { fields: fields, boundary: boundary }
end

# The supplement artifact flags as the typed ArtifactRequirements: the
# rationale store flag mirrors `store` (the rationale ops own that store).
def supplemental_artifacts(
  mir: Bool, coverage: Bool, store: Bool, delta: Bool, typed_program: Bool
) -> ArtifactRequirements
  schema_artifacts(mir, coverage, store, false, delta, typed_program, false, store)
end

# The explicit typed schema rows for every supplement name (the engine
# exports the §39 registry does not carry). Names are the callers' real
# exported operation names; nothing synthetic is invented.
def semantic_tools_supplemental() -> Vec[SemanticToolSchema]
  Vec::from([
    # ———— the §38 export supplement ————
    tool_supplemental("type.use".to_string(), "type".to_string(),
      supplemental_key_args("type_key".to_string()),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      ToolStability::Stable, schema_complete()),
    tool_supplemental("change.affected".to_string(), "change".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("delta".to_string(), SchemaValueKind::SemanticDelta),
        schema_field_text("key".to_string(), TextKind::CanonicalKeyText)
      ]), TextBoundary::Typed),
      schema_result1("bool".to_string(), RecordFamily::Bool),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(false, false, false, true, false),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("change.semantic_diff".to_string(), "change".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("delta".to_string(), SchemaValueKind::SemanticDelta)
      ]), TextBoundary::Typed),
      schema_result1("delta".to_string(), RecordFamily::Delta),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(false, false, false, true, false),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("abi.inspect".to_string(), "abi".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("delta".to_string(), SchemaValueKind::SemanticDelta)
      ]), TextBoundary::Typed),
      schema_result1("abi".to_string(), RecordFamily::Abi),
      Vec::from([StableIdKind::Abi]), supplemental_artifacts(false, false, false, true, false),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("abi.diff".to_string(), "abi".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("left".to_string(), SchemaValueKind::AbiRows),
        schema_field_required("right".to_string(), SchemaValueKind::AbiRows)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Abi]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("abi.ffi_report".to_string(), "abi".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_text("symbol".to_string(), TextKind::CanonicalKeyText),
        schema_field_required("snapshot".to_string(), SchemaValueKind::Snapshot)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::Abi]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("abi.rows".to_string(), "abi".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("snapshot".to_string(), SchemaValueKind::Snapshot)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Abi]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("perf.report.mir".to_string(), "perf".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("function".to_string(), SchemaValueKind::MirFunction)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(true, false, false, false, false),
      DeterminismClass::Deterministic, QueryCostClass::ProgramWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("perf.report.lir".to_string(), "perf".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("alloc".to_string(), SchemaValueKind::LirAlloc)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("perf.reports".to_string(), "perf".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("program".to_string(), SchemaValueKind::MirProgram)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(true, false, false, false, false),
      DeterminismClass::Deterministic, QueryCostClass::ProgramWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("perf.facts.mir".to_string(), "perf".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("function".to_string(), SchemaValueKind::MirFunction)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(true, false, false, false, false),
      DeterminismClass::Deterministic, QueryCostClass::ProgramWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("perf.facts.lir".to_string(), "perf".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("alloc".to_string(), SchemaValueKind::LirAlloc)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("hole.constraints".to_string(), "holes".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("program".to_string(), SchemaValueKind::TypedProgram),
        schema_field_text("hole_key".to_string(), TextKind::CanonicalKeyText)
      ]), TextBoundary::Typed),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::HirNode]),
      supplemental_artifacts(false, false, false, false, true),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    # The registry carries mir.block; this deduped backup row keeps the
    # supplement's typed metadata if the registry row ever moves.
    tool_supplemental("mir.block".to_string(), "mir".to_string(),
      supplemental_key_args("block_key".to_string()),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::MirBlock, StableIdKind::MirStmt]),
      supplemental_artifacts(true, false, false, false, false),
      DeterminismClass::Deterministic, QueryCostClass::ProgramWalk,
      ToolStability::Experimental, schema_gated("mir.block_unavailable".to_string())),
    # ———— the Tier-4 rationale surface ————
    tool_supplemental("rationale.add".to_string(), "rationale".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("record".to_string(), SchemaValueKind::RationaleRecord)
      ]), TextBoundary::Typed),
      schema_result1("digest".to_string(), RecordFamily::Digest),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(false, false, true, false, false),
      DeterminismClass::Deterministic, QueryCostClass::Constant,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("rationale.save".to_string(), "rationale".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("store".to_string(), SchemaValueKind::RationaleStore)
      ]), TextBoundary::Typed),
      schema_result1("text".to_string(), RecordFamily::Text),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(false, false, true, false, false),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("rationale.load".to_string(), "rationale".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_text("store_text".to_string(), TextKind::None)
      ]), TextBoundary::Typed),
      schema_result1("rationale-store".to_string(), RecordFamily::RationaleStore),
      Vec::new(), schema_no_artifacts(),
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("rationale.for_subject".to_string(), "rationale".to_string(),
      supplemental_key_args("subject".to_string()),
      schema_result1("rationale-record".to_string(), RecordFamily::RationaleRecord),
      Vec::from([StableIdKind::Decl]), supplemental_artifacts(false, false, true, false, false),
      DeterminismClass::SessionRelative, QueryCostClass::LinearScan,
      ToolStability::Experimental, schema_complete()),
    tool_supplemental("rationale.store_digest".to_string(), "rationale".to_string(),
      supplemental_typed_args(Vec::from([
        schema_field_required("store".to_string(), SchemaValueKind::RationaleStore)
      ]), TextBoundary::Typed),
      schema_result1("digest".to_string(), RecordFamily::Digest),
      Vec::new(), supplemental_artifacts(false, false, true, false, false),
      DeterminismClass::Deterministic, QueryCostClass::Constant,
      ToolStability::Experimental, schema_complete())
  ])
end

def semantic_tools_has(tools: Vec[SemanticToolSchema], name: String) -> Bool
  for tool in tools do
    if tool.name == name then
      return true
    end
  end
  false
end

# The discovery surface: registry schema walk + supplement, deduped by name
# (registry rows win), byte-sorted by name. Deterministic on every call.
pub def semantic_tools() -> Vec[SemanticToolSchema]
  var out = semantic_tool_schemas()
  for tool in semantic_tools_supplemental() do
    if !semantic_tools_has(out.clone(), tool.name.clone()) then
      out.push(tool)
    end
  end
  out.sort_by(|a, b| a.name < b.name)
  out
end

pub def tool_for(name: String) -> Option[SemanticToolSchema]
  for tool in semantic_tools() do
    if tool.name == name then
      return Option::Some(tool.clone())
    end
  end
  Option::None
end

def tool_requires_store(tool: SemanticToolSchema) -> Bool
  tool.required_artifacts.diagnostic_store || tool.required_artifacts.rationale_store
end

pub def tools_requiring_mir() -> Vec[SemanticToolSchema]
  var out: Vec[SemanticToolSchema] = Vec::new()
  for tool in semantic_tools() do
    if tool.required_artifacts.mir_program then
      out.push(tool.clone())
    end
  end
  out
end

pub def tools_requiring_coverage() -> Vec[SemanticToolSchema]
  var out: Vec[SemanticToolSchema] = Vec::new()
  for tool in semantic_tools() do
    if tool.required_artifacts.coverage_rows then
      out.push(tool.clone())
    end
  end
  out
end

pub def tools_requiring_store() -> Vec[SemanticToolSchema]
  var out: Vec[SemanticToolSchema] = Vec::new()
  for tool in semantic_tools() do
    if tool_requires_store(tool.clone()) then
      out.push(tool.clone())
    end
  end
  out
end

def tool_name_rows(tools: Vec[SemanticToolSchema]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for tool in tools do
    out.push(tool.name.clone())
  end
  out
end
# T1-T5: the discovery surface — sorted deterministic enumeration, registry
# schema coverage, the audited count, the named ops' typed flags, the filter
# views, the schema well-formedness and the service.describe bootstrap.
pub def semantic_tools_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let tools = semantic_tools()

  # ———— T1: sorted, deduped, registry-covered ————
  # 84 = 66 registry schemas (62 pre-item-4 ops + service.describe +
  # edit.apply_verified + repair.candidates + repair.instantiate) + 18 net
  # supplement rows (19 names, mir.block deduped by the registry).
  rationale_lane_int(&mut out, "t1-tool-count", tools.len(), 84)
  var sorted = true
  var i = 1
  while i < tools.len() do
    if tools[i - 1].name > tools[i].name then
      sorted = false
    end
    i = i + 1
  end
  rationale_lane_bool(&mut out, "t1-sorted", sorted)
  var unique = true
  i = 1
  while i < tools.len() do
    if tools[i - 1].name == tools[i].name then
      unique = false
    end
    i = i + 1
  end
  rationale_lane_bool(&mut out, "t1-unique", unique)

  let registry = server_operations()
  rationale_lane_int(&mut out, "t1-registry-count", registry.len(), 66)
  let missing_schemas = semantic_tool_schema_missing()
  rationale_lane_int(&mut out, "t1-registry-schema-count", missing_schemas.len(), 0)
  for name in missing_schemas do
    out.push("t1-registry-schema-missing: " + name.clone())
  end
  var listed = true
  for op in registry do
    var found = false
    for tool in tools do
      if tool.name == op.name then
        found = true
      end
    end
    if !found then
      listed = false
    end
  end
  rationale_lane_bool(&mut out, "t1-registry-listed", listed)

  # ———— T2: the named ops' typed capability metadata ————
  match tool_for("mir.dominators".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-dominators-mir", tool.required_artifacts.mir_program)
    rationale_lane_bool(&mut out, "t2-dominators-coverage", !tool.required_artifacts.coverage_rows)
    rationale_lane_bool(&mut out, "t2-dominators-store", !tool_requires_store(tool.clone()))
    rationale_lane_text(&mut out, "t2-dominators-stability",
      tool_stability_word(tool.stability.clone()), "experimental")
    rationale_lane_text(&mut out, "t2-dominators-capability", tool.capability.clone(), "mir")
  when Option::None then
    out.push("t2-dominators: expected Some, got None")
  end
  match tool_for("coverage.affected".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-coverage-flag", tool.required_artifacts.coverage_rows)
    rationale_lane_bool(&mut out, "t2-coverage-mir", !tool.required_artifacts.mir_program)
  when Option::None then
    out.push("t2-coverage: expected Some, got None")
  end
  # The §39 registry spells the op "symbol_get" (there is no dotted
  # "symbol.get" name in the dispatch): it requires NOTHING extra.
  match tool_for("symbol_get".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-symbol-get-requires-nothing",
      !tool.required_artifacts.mir_program && !tool.required_artifacts.coverage_rows &&
      !tool_requires_store(tool.clone()))
    rationale_lane_text(&mut out, "t2-symbol-get-stability",
      tool_stability_word(tool.stability.clone()), "stable")
  when Option::None then
    out.push("t2-symbol-get: expected Some, got None")
  end
  match tool_for("diagnostic.get".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-diagnostic-store", tool.required_artifacts.diagnostic_store)
  when Option::None then
    out.push("t2-diagnostic-store: expected Some, got None")
  end
  match tool_for("rationale.for_subject".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-rationale-store", tool.required_artifacts.rationale_store)
  when Option::None then
    out.push("t2-rationale-store: expected Some, got None")
  end
  # The registry-gap finding: mir.block is implemented by the §38 dispatch
  # and registered in server_operations; the discovery surface carries it.
  match tool_for("mir.block".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-mir-block-flag", tool.required_artifacts.mir_program)
  when Option::None then
    out.push("t2-mir-block: expected Some, got None")
  end
  # The supplement's engine families are present.
  for engine_name in Vec::from([
    "type.use".to_string(),
    "change.semantic_diff".to_string(),
    "abi.inspect".to_string(),
    "perf.reports".to_string(),
    "hole.constraints".to_string()
  ]) do
    match tool_for(engine_name.clone())
    when Option::Some(_) then ()
    when Option::None then
      out.push("t2-engine-missing: " + engine_name.clone())
    end
  end

  # ———— T3: the filter views ————
  let mir_tools = tools_requiring_mir()
  rationale_lane_int(&mut out, "t3-mir-count", mir_tools.len(), 12)
  rationale_lane_rows(&mut out, "t3-mir-names", tool_name_rows(mir_tools.clone()), Vec::from([
    "mir.block".to_string(),
    "mir.control".to_string(),
    "mir.diff".to_string(),
    "mir.dominators".to_string(),
    "mir.loops".to_string(),
    "mir.path".to_string(),
    "mir.postdominators".to_string(),
    "mir.reaching".to_string(),
    "mir_slice".to_string(),
    "perf.facts.mir".to_string(),
    "perf.report.mir".to_string(),
    "perf.reports".to_string()
  ]))
  let coverage_tools = tools_requiring_coverage()
  rationale_lane_rows(&mut out, "t3-coverage-names", tool_name_rows(coverage_tools.clone()), Vec::from([
    "coverage.affected".to_string(),
    "test.affected".to_string()
  ]))
  let store_tools = tools_requiring_store()
  rationale_lane_int(&mut out, "t3-store-count", store_tools.len(), 9)
  rationale_lane_rows(&mut out, "t3-store-names", tool_name_rows(store_tools.clone()), Vec::from([
    "diagnostic.explain".to_string(),
    "diagnostic.get".to_string(),
    "diagnostic.repair_context".to_string(),
    "rationale.add".to_string(),
    "rationale.for_subject".to_string(),
    "rationale.save".to_string(),
    "rationale.store_digest".to_string(),
    "repair.candidates".to_string(),
    "repair.instantiate".to_string()
  ]))
  match tool_for("no.such.tool".to_string())
  when Option::Some(_) then
    out.push("t3-absent: expected None, got Some")
  when Option::None then ()
  end

  # ———— T4: schema well-formedness ————
  # The registry schema lane (semantic_server.semantic_schema_lane_check)
  # plus the whole discovery list's id/result invariants (the supplement
  # rows included).
  for row in semantic_schema_lane_check() do
    out.push("t4-" + row.clone())
  end
  for tool in tools do
    if tool.id.name != tool.name then
      out.push("t4-id-name: " + tool.name.clone())
    end
    let digest = semantic_operation_digest(tool.name.clone())
    if tool.id.digest.hi != digest.hi || tool.id.digest.lo != digest.lo then
      out.push("t4-id-digest: " + tool.name.clone())
    end
    if tool.result.variants.len() == 0 then
      out.push("t4-result-empty: " + tool.name.clone())
    end
    if tool.stability == ToolStability::Stable && tool.completeness.class == CompletenessClass::ArtifactGated then
      # A stable op may be artifact-gated (build.plan) — the check is the
      # contract's unavailable kind must be named.
      if tool.completeness.unavailable_kind.len() == 0 then
        out.push("t4-gated-no-kind: " + tool.name.clone())
      end
    end
  end

  # ———— T5: service.describe — ONE schema per registry op, itself included ————
  let described = service_describe_schemas()
  rationale_lane_int(&mut out, "t5-describe-count", described.len(), registry.len())
  var order_ok = true
  var di = 0
  while di < described.len() && di < registry.len() do
    if described[di].name != registry[di].name then
      order_ok = false
    end
    di = di + 1
  end
  rationale_lane_bool(&mut out, "t5-describe-order", order_ok)
  var saw_self = false
  for tool in described do
    if tool.name == "service.describe" then
      saw_self = true
    end
  end
  rationale_lane_bool(&mut out, "t5-describe-self", saw_self)

  out
end

pub def semantic_rationale_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  for row in rationale_lane_check() do
    out.push(row.clone())
  end
  for row in semantic_tools_lane_check() do
    out.push(row.clone())
  end
  out
end
