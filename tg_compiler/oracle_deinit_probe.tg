# oracle_deinit_probe.tg — focused regression fixture for the semantic
# completeness oracle's deinit-plan walk (types.tg oracle_scan_deinit_plan).
#
# The embedded program's deinit plans carry the plan shapes the oracle
# used to abort on (String / Tuple / Option / Result / Map children and a
# SelfRecursive edge); type_check_typed runs the oracle over them. The
# bootstrap/oracle_mini.manifest closure + tg_oracle_deinit selfcheck run
# this probe under the seed VM.

use std::core::{Option, Result}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::resolver::{resolve_names}
use tg_compiler::types::{type_env_new, type_check_typed}

def main() -> Int
  let source = "struct Holder\n  name: String\n  pair: (Int, String)\n  maybe: Option[String]\n  outcome: Result[Int, String]\n  table: Map[Int, String]\n  items: Vec[String]\nend\n\nstruct Chain\n  next: Vec[Chain]\nend\n\ndef main() -> Int\n  0\nend\n"
  let lex = tokenize(source, "oracle_deinit_probe_input.tg")
  let parsed = parse(lex)
  if diag_has_errors(&parsed.diagnostics) then
    println("oracle_deinit_probe: parse failed")
    return 2
  end
  let program = parsed.program
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(env, program, &res)
    if result.errors.len() > 0 then
      println("oracle_deinit_probe: typecheck errors = " + result.errors.len().to_string())
      return 1
    end
    println("oracle_deinit_probe: kernel oracle deinit-plan walk completed")
    0
  when Result::Err(errs) then
    println("oracle_deinit_probe: resolve failed = " + errs.len().to_string())
    3
  end
end
