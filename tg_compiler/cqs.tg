## Tangerine Compiler — CQS (Completion & Quality System)
## Formal Specification v0.2 Implementation
##
## §23-59 of needed.txt: Static detection, scoring, enforcement, signals.
## All detection performed on typed MIR with source spans preserved.
## Deterministic, reproducible, no AI/heuristic guesswork.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::mode::{Mode, ModeConfig, config_for_mode, is_at_least, RichSpan}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirBlock, MirStatement, MirTerminator, MirRvalue,
  MirTerminatorKind, MirStatementKind, MirRvalueKind,
  MirOperand, MirOperandKind, MirConstant, MirConstantKind, MirCallValue,
  MirBlockId, MirLocalId, MirLocal, Place, SwitchTarget, AssertMessage
}
use tg_compiler::token::{Span}
use tg_compiler::parser::{Diagnostic, DiagLevel}
use tg_compiler::ast::{Program, Item, ItemKind, FunctionDecl, StructDecl, EnumDecl,
                        TraitDecl, ImplDecl, Expr, ExprKind, Stmt, StmtKind,
                        Block, FnBody, TypeExpr, TypeExprKind}
use tg_compiler::types::{TypedProgram}
use tg_compiler::util::{pow, min_float, max_float, clamp_int, clamp_float, to_float, to_int, max_int, sha256}

# ═══════════════════════════════════════════════════════════════
# §24 — CQS Definitions
# ═══════════════════════════════════════════════════════════════

# §24.1 — Symbol: any function, method, struct, enum, trait, impl, or module
struct Symbol
  symbol_id: String    # Stable across builds for same edition
  name: String
  kind: SymbolKind
  span: RichSpan
  surface_class: SurfaceClass
  module_path: String
end

enum SymbolKind
  Function
  Method
  Struct
  Enum
  Trait
  Impl
  Module
end

# §24.2 — Surface Class (auto-classified at compile time)
enum SurfaceClass
  PublicStable         # pub, not @experimental, referenced externally
  PublicExperimental   # pub + @experimental
  InternalHotPath      # not pub, referenced ≥N times or @budget/@hot
  InternalGlue         # not pub, thin wrapper, mostly forwards calls
  TestOnly             # only referenced by test modules
  PlatformShim         # @platform(...) or entirely cfg-gated
end

def classify_surface(
  is_pub: Bool,
  is_experimental: Bool,
  ref_count: Int,
  has_budget: Bool,
  has_hot: Bool,
  stmt_count: Int,
  is_test_only: Bool,
  is_platform_gated: Bool,
  hot_path_threshold: Int
) -> SurfaceClass
  if is_test_only
    SurfaceClass::TestOnly
  elsif is_platform_gated
    SurfaceClass::PlatformShim
  elsif is_pub && is_experimental
    SurfaceClass::PublicExperimental
  elsif is_pub
    SurfaceClass::PublicStable
  elsif ref_count >= hot_path_threshold || has_budget || has_hot
    SurfaceClass::InternalHotPath
  elsif stmt_count < 5
    SurfaceClass::InternalGlue
  else
    SurfaceClass::InternalGlue
  end
end

# §24.3 — Evidence Signal Categories
enum SignalCategory
  ControlFlow
  DataFlow
  ErrorHandling
  Coverage
  Capability
  FutureGate
end

# §24.4 — Completeness Score: numeric value in [0, 100]
struct CompletenessScore
  raw: Float     # 100 - Σ penalties (may be negative)
  clamped: Int   # clamp(raw, 0, 100)
end

# ═══════════════════════════════════════════════════════════════
# §25 — Evidence Signal Definitions 
# ═══════════════════════════════════════════════════════════════

enum SignalKind
  # §25.1 Control-Flow Signals
  CF1_UnreachableBranch
  CF2_NonExhaustiveMatch
  CF3_PanicUnreachableExit
  CF4_ConstantReturnDominance

  # §25.2 Data-Flow Signals
  DF1_UnusedParameter
  DF2_OutputIndependentOfInputs
  DF3_DeadAssignment
  DF4_AllBranchesReturnSameLiteral

  # §25.3 Error-Handling Signals
  EH1_IgnoredResultWithoutJustification
  EH2_CatchAllWithoutAction
  EH3_BroadExceptionBoundarySwallowing

  # §25.4 Coverage Signals
  CV1_UnexecutedPublicBranch
  CV2_CoverageBelowThreshold

  # §25.5 Capability Signals
  CP1_CapabilityDrift
  CP2_UnsafeBlockWithoutReason
  CP3_TaintedFFIValueUsedWithoutValidation

  # §25.6 Future Signals
  FT1_FutureBlockInEnabledFeature
  FT2_CfgFeatureEnabledButIncomplete
end

struct Signal
  kind: SignalKind
  severity: Float    # Normalized ∈ [0, 1]
  count: Int
  suppressed: Bool
  penalty: Float     # Computed from penalty model
  locations: Vec[RichSpan]
  details: Map[String, String]
end

# ═══════════════════════════════════════════════════════════════
# §26 — CQS Completeness Scoring
# ═══════════════════════════════════════════════════════════════

# §26.2 — Signal Penalty Model parameters per kind
struct SignalParams
  w: Float    # Base weight
  alpha: Float # Count scaling factor
  beta: Float  # Severity exponent
  cap: Float   # Per-kind cap
end

# §38 — Default Signal Parameter Table
def default_signal_params(kind: SignalKind) -> SignalParams
  match kind
  # §38.1 Control-Flow
  when SignalKind::CF1_UnreachableBranch then
    SignalParams { w: 8.0, alpha: 0.15, beta: 1.0, cap: 20.0 }
  when SignalKind::CF2_NonExhaustiveMatch then
    SignalParams { w: 15.0, alpha: 0.0, beta: 1.0, cap: 30.0 }
  when SignalKind::CF3_PanicUnreachableExit then
    SignalParams { w: 18.0, alpha: 0.0, beta: 1.0, cap: 40.0 }
  when SignalKind::CF4_ConstantReturnDominance then
    SignalParams { w: 10.0, alpha: 0.0, beta: 1.0, cap: 25.0 }

  # §38.2 Data-Flow
  when SignalKind::DF1_UnusedParameter then
    SignalParams { w: 4.0, alpha: 0.20, beta: 1.0, cap: 18.0 }
  when SignalKind::DF2_OutputIndependentOfInputs then
    SignalParams { w: 10.0, alpha: 0.0, beta: 1.0, cap: 25.0 }
  when SignalKind::DF3_DeadAssignment then
    SignalParams { w: 3.0, alpha: 0.15, beta: 1.0, cap: 15.0 }
  when SignalKind::DF4_AllBranchesReturnSameLiteral then
    SignalParams { w: 8.0, alpha: 0.0, beta: 1.0, cap: 20.0 }

  # §38.3 Error-Handling
  when SignalKind::EH1_IgnoredResultWithoutJustification then
    SignalParams { w: 12.0, alpha: 0.20, beta: 1.0, cap: 30.0 }
  when SignalKind::EH2_CatchAllWithoutAction then
    SignalParams { w: 8.0, alpha: 0.0, beta: 1.0, cap: 20.0 }
  when SignalKind::EH3_BroadExceptionBoundarySwallowing then
    SignalParams { w: 14.0, alpha: 0.0, beta: 1.0, cap: 30.0 }

  # §38.4 Coverage
  when SignalKind::CV1_UnexecutedPublicBranch then
    SignalParams { w: 10.0, alpha: 0.0, beta: 1.0, cap: 20.0 }
  when SignalKind::CV2_CoverageBelowThreshold then
    SignalParams { w: 20.0, alpha: 0.0, beta: 1.0, cap: 35.0 }

  # §38.5 Capability & Unsafe
  when SignalKind::CP1_CapabilityDrift then
    SignalParams { w: 10.0, alpha: 0.0, beta: 1.0, cap: 25.0 }
  when SignalKind::CP2_UnsafeBlockWithoutReason then
    SignalParams { w: 20.0, alpha: 0.0, beta: 1.0, cap: 40.0 }
  when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then
    SignalParams { w: 18.0, alpha: 0.0, beta: 1.0, cap: 40.0 }

  # §38.6 Future/Feature
  when SignalKind::FT1_FutureBlockInEnabledFeature then
    SignalParams { w: 8.0, alpha: 0.0, beta: 1.0, cap: 20.0 }
  when SignalKind::FT2_CfgFeatureEnabledButIncomplete then
    SignalParams { w: 10.0, alpha: 0.0, beta: 1.0, cap: 25.0 }
  end
end

# §26.2 — Penalty computation
# P(σ,s) = (1 - suppr) · min(w · (sev^β) · (1 + α · (n-1)), cap)
def compute_penalty(signal: Signal, params: SignalParams) -> Float
  let suppr = if signal.suppressed then 1.0 else 0.0 end
  let raw = params.w * pow(signal.severity, params.beta) * (1.0 + params.alpha * (to_float(signal.count) - 1.0))
  let capped = min_float(raw, params.cap)
  (1.0 - suppr) * capped
end

# §26.1 — Core score definition
# Score(s) = clamp(100 - Σ P(σ,s), 0, 100)
def compute_score(signals: Vec[Signal]) -> CompletenessScore
  mut total_penalty = 0.0
  for signal in signals
    let params = default_signal_params(signal.kind)
    total_penalty = total_penalty + compute_penalty(signal, &params)
  end
  let raw = 100.0 - total_penalty
  let clamped = clamp_int(to_int(raw), 0, 100)
  CompletenessScore { raw: raw, clamped: clamped }
end

# §26.3 — Normalized Severity Functions

# Binary static signals: sev = 1 if present
def sev_binary() -> Float
  1.0
end

# Count-based: sevCount(n; n0, n1) = clamp((n - n0) / (n1 - n0), 0, 1)
def sev_count(n: Int, n0: Int, n1: Int) -> Float
  if n1 == n0
    if n >= n1 then 1.0 else 0.0 end
  else
    clamp_float(to_float(n - n0) / to_float(n1 - n0), 0.0, 1.0)
  end
end

# §26.4 — Coverage Penalty Normalization
# r_b = branches_covered / branches_total
# s_b = max(0, τ_b - r_b)
# sevCov = s_b / τ_b
# CV-2 severity: sev = sevCov^γ_b
def sev_coverage(branches_covered: Int, branches_total: Int, threshold: Float, gamma: Float) -> Float
  if branches_total == 0
    0.0
  else
    let r_b = to_float(branches_covered) / to_float(branches_total)
    let s_b = max_float(0.0, threshold - r_b)
    let sev_cov = if threshold > 0.0 then s_b / threshold else 0.0 end
    pow(sev_cov, gamma)
  end
end

# §26.5 — DF-2: Output-Independence Normalization
# r_d = |{p ∈ Π': AffectsReturn(p)}| / |Π'|
# Severity = 1 - r_d
def sev_output_independence(affecting_params: Int, total_params: Int) -> Float
  if total_params == 0
    0.0
  else
    let r_d = to_float(affecting_params) / to_float(total_params)
    1.0 - r_d
  end
end

# §26.6 — CF-4: Constant-Return Dominance Normalization
# sev = clamp((c - c0)/(1 - c0), 0, 1) * clamp(k0/k, 0, 1)
# Defaults: c0 = 0.80, k0 = 1
def sev_constant_return(c: Float, k: Int, c0: Float, k0: Int) -> Float
  let sev_c = clamp_float((c - c0) / (1.0 - c0), 0.0, 1.0)
  let sev_k = clamp_float(to_float(k0) / to_float(max_int(k, 1)), 0.0, 1.0)
  sev_c * sev_k
end

# CV-1: Uncovered branch fraction
# sevUncov(s) with u0=0.05, u1=0.30
def sev_uncovered_fraction(uncovered_frac: Float, u0: Float, u1: Float) -> Float
  sev_count_float(uncovered_frac, u0, u1)
end

def sev_count_float(val: Float, n0: Float, n1: Float) -> Float
  if n1 == n0
    if val >= n1 then 1.0 else 0.0 end
  else
    clamp_float((val - n0) / (n1 - n0), 0.0, 1.0)
  end
end

# ═══════════════════════════════════════════════════════════════
# §27 — CQS Mode Enforcement Matrix
# ═══════════════════════════════════════════════════════════════

# §36 — Minimum CompletenessScore Thresholds
def min_score_threshold(surface: SurfaceClass, mode: Mode) -> Int
  match (surface, mode)
  when (SurfaceClass::PublicStable, Mode::Dev) then 0
  when (SurfaceClass::PublicStable, Mode::Strict) then 75
  when (SurfaceClass::PublicStable, Mode::Production) then 85
  when (SurfaceClass::PublicStable, Mode::Hardened) then 92
  when (SurfaceClass::InternalHotPath, Mode::Production) then 70
  when (SurfaceClass::InternalHotPath, Mode::Hardened) then 80
  when (_, _) then 0
  end
end

# §37 — Branch Coverage Thresholds (τ_b)
def branch_coverage_threshold(surface: SurfaceClass, mode: Mode) -> Float
  match (surface, mode)
  when (SurfaceClass::PublicStable, Mode::Strict) then 0.60
  when (SurfaceClass::PublicStable, Mode::Production) then 0.75
  when (SurfaceClass::PublicStable, Mode::Hardened) then 0.85
  when (SurfaceClass::InternalHotPath, Mode::Strict) then 0.40
  when (SurfaceClass::InternalHotPath, Mode::Production) then 0.60
  when (SurfaceClass::InternalHotPath, Mode::Hardened) then 0.70
  when (_, _) then 0.00
  end
end

# §37.2 — Coverage Shortfall Exponent γ_b
def coverage_gamma(mode: Mode) -> Float
  match mode
  when Mode::Hardened then 2.0
  when _ then 1.0
  end
end

enum EnforcementAction
  NoEnforcement
  Warn
  Error
  SpecialRules
end

def enforcement_action(surface: SurfaceClass, mode: Mode, score: Int) -> EnforcementAction
  let threshold = min_score_threshold(surface, mode)
  if threshold == 0 then
    if surface == SurfaceClass::PublicStable && mode == Mode::Dev then
      if score < 70 then
        return EnforcementAction::Warn
      end
      return EnforcementAction::NoEnforcement
    end
    if surface == SurfaceClass::PublicExperimental then
      return EnforcementAction::Warn
    end
    if surface == SurfaceClass::PlatformShim then
      return EnforcementAction::SpecialRules
    end
    return EnforcementAction::NoEnforcement
  end

  if score < threshold then
    return EnforcementAction::Error
  end
  EnforcementAction::NoEnforcement
end

# ═══════════════════════════════════════════════════════════════
# §28 — Context-Aware Relaxation (Suppressions)
# ═══════════════════════════════════════════════════════════════

# §39 — Deterministic Suppression Policy
def should_suppress(
  signal_kind: SignalKind,
  surface: SurfaceClass,
  is_cfg_inactive: Bool,
  is_future_disabled: Bool,
  is_unit_return: Bool,
  mode: Mode
) -> Bool
  # TestOnly → suppress all
  match surface
  when SurfaceClass::TestOnly then return true
  when _ then ()
  end

  # Inactive cfg region → suppress
  if is_cfg_inactive
    return true
  end

  # @future with disabled feature → suppress (unless Hardened)
  if is_future_disabled
    match mode
    when Mode::Hardened then return false  # Hardened: @future doesn't suppress
    when _ then return true
    end
  end

  # PlatformShim: suppress CF-3, CF-4, DF-2 only if cfg-gated
  match (surface, signal_kind)
  when (SurfaceClass::PlatformShim, SignalKind::CF3_PanicUnreachableExit) then
    return is_cfg_inactive
  when (SurfaceClass::PlatformShim, SignalKind::CF4_ConstantReturnDominance) then
    return is_cfg_inactive
  when (SurfaceClass::PlatformShim, SignalKind::DF2_OutputIndependentOfInputs) then
    return is_cfg_inactive
  when (_, _) then ()
  end

  # §58.3 — Unit-returning functions: suppress CF-4
  match signal_kind
  when SignalKind::CF4_ConstantReturnDominance then
    if is_unit_return then return true end
  when _ then ()
  end

  false
end

# ═══════════════════════════════════════════════════════════════
# §40 — Default sevCount Parameters by Kind
# ═══════════════════════════════════════════════════════════════

struct SevCountParams
  n0: Int
  n1: Int
end

def sev_count_params(kind: SignalKind) -> SevCountParams
  match kind
  when SignalKind::DF1_UnusedParameter then SevCountParams { n0: 0, n1: 3 }
  when SignalKind::DF3_DeadAssignment then SevCountParams { n0: 0, n1: 5 }
  when SignalKind::CF1_UnreachableBranch then SevCountParams { n0: 0, n1: 2 }
  when SignalKind::EH1_IgnoredResultWithoutJustification then SevCountParams { n0: 0, n1: 2 }
  when _ then SevCountParams { n0: 0, n1: 1 }  # Binary default
  end
end

# ═══════════════════════════════════════════════════════════════
# §41 — Module / Package Score Aggregation
# ═══════════════════════════════════════════════════════════════

def surface_weight(surface: SurfaceClass) -> Float
  match surface
  when SurfaceClass::PublicStable then 4.0
  when SurfaceClass::PublicExperimental then 2.0
  when SurfaceClass::InternalHotPath then 3.0
  when SurfaceClass::InternalGlue then 1.0
  when SurfaceClass::TestOnly then 0.0
  when SurfaceClass::PlatformShim then 2.0
  end
end

# §41.1 — Module score as weighted mean
# Score_M = Σ(w_class(s) · Score(s)) / Σ(w_class(s))
def compute_module_score(symbols: Vec[SymbolReport]) -> Float
  mut weighted_sum = 0.0
  mut weight_sum = 0.0
  for sym in symbols
    let w = surface_weight(sym.surface_class)
    weighted_sum = weighted_sum + w * to_float(sym.score.clamped)
    weight_sum = weight_sum + w
  end
  if weight_sum > 0.0
    weighted_sum / weight_sum
  else
    100.0
  end
end

