# ═══════════════════════════════════════════════════════════════
# §49 — IR Level and Determinism
# ═══════════════════════════════════════════════════════════════

# All CQS detection on typed MIR with source spans preserved.
# Deterministic ordering:
#   Functions in stable symbol-id order
#   Basic blocks in numeric order
#   Statements in sequence order
#   Edges in sorted (from_bb, to_bb) order
#   Signals emitted sorted by (kind, file, start, end)

def signal_sort_lt(a: Signal, b: Signal) -> Bool
  let ka = signal_kind_ordinal(a.kind)
  let kb = signal_kind_ordinal(b.kind)
  if ka != kb then
    ka < kb
  elsif a.locations.len() > 0 && b.locations.len() > 0 then
    let la = a.locations[0]
    let lb = b.locations[0]
    if la.file != lb.file then
      la.file < lb.file
    elsif la.start_line != lb.start_line then
      la.start_line < lb.start_line
    else
      la.start_col < lb.start_col
    end
  else
    false
  end
end

def sort_signals(inout signals: Vec[Signal]) -> Unit
  signals.sort_by(|a, b| signal_sort_lt(a, b))
end

def signal_kind_ordinal(k: SignalKind) -> Int
  match k
  when SignalKind::CF1_UnreachableBranch then 0
  when SignalKind::CF2_NonExhaustiveMatch then 1
  when SignalKind::CF3_PanicUnreachableExit then 2
  when SignalKind::CF4_ConstantReturnDominance then 3
  when SignalKind::DF1_UnusedParameter then 4
  when SignalKind::DF2_OutputIndependentOfInputs then 5
  when SignalKind::DF3_DeadAssignment then 6
  when SignalKind::DF4_AllBranchesReturnSameLiteral then 7
  when SignalKind::EH1_IgnoredResultWithoutJustification then 8
  when SignalKind::EH2_CatchAllWithoutAction then 9
  when SignalKind::EH3_BroadExceptionBoundarySwallowing then 10
  when SignalKind::CV1_UnexecutedPublicBranch then 11
  when SignalKind::CV2_CoverageBelowThreshold then 12
  when SignalKind::CP1_CapabilityDrift then 13
  when SignalKind::CP2_UnsafeBlockWithoutReason then 14
  when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then 15
  when SignalKind::FT1_FutureBlockInEnabledFeature then 16
  when SignalKind::FT2_CfgFeatureEnabledButIncomplete then 17
  end
end

# ═══════════════════════════════════════════════════════════════
# §50 — CqsCFG Construction for CQS
# ═══════════════════════════════════════════════════════════════

struct BasicBlock
  id: Int
  statements: Vec[MirStatement]
  terminator: Terminator
end

enum Terminator
  Goto(Int)                        # target bb
  Branch(Int, Int, Int)            # cond_local, true_bb, false_bb
  SwitchInt(Int, Vec[SwitchArm], Option[Int])  # operand, cases, other_bb
  SwitchEnum(Int, Vec[SwitchArm], Option[Int]) # operand, variants, other_bb
  Return
  Panic
  Unreachable
end

struct SwitchArm
  value: Int    # discriminant or integer value
  target: Int   # target bb
end

struct CqsCFG
  entry: Int                         # bb0
  blocks: Vec[BasicBlock]
  edges: Vec[CqsCFGEdge]
  reachable: Set[Int]                # Set of reachable block IDs
end

struct CqsCFGEdge
  from_bb: Int
  to_bb: Int
end

# §50.2 — Reachability via DFS from entry
def compute_reachability(cfg: CqsCFG) -> Set[Int]
  mut visited: Set[Int] = Set::new()
  mut stack = Vec::new()
  stack.push(cfg.entry)

  while !stack.is_empty() do
    let bb = match stack.pop()
    when Option::Some(value) then value
    when Option::None then break
    end
    if !visited.contains(&bb)
      visited.insert(bb)
      for edge in cfg.edges
        let to_bb = edge.to_bb
        if edge.from_bb == bb && !visited.contains(&to_bb)
          stack.push(to_bb)
        end
      end
    end
  end

  visited
end

# ═══════════════════════════════════════════════════════════════
# §51 — Branch Point Definition
# ═══════════════════════════════════════════════════════════════

struct BranchPoint
  branch_id: String     # Stable hash
  bb_id: Int
  kind: BranchPointKind
  arms: Vec[BranchArm]
  span: Option[RichSpan]
end

enum BranchPointKind
  IfExpr
  WhileExpr
  MatchExpr
  ShortCircuit
  Guard
  Desugar
end

struct BranchArm
  arm_id: String    # Stable hash
  arm_index: Int
  target_bb: Int
  label: String     # "then", "else", "Variant::Name", "case::42", "other"
end

# §51.2 — Arm ID stability
# arm_id = SHA256("tg.arm.v1" ‖ branch_id ‖ arm_index ‖ target_bb)
def compute_arm_id(branch_id: String, arm_index: Int, target_bb: Int) -> String
  sha256("tg.arm.v1" + branch_id + arm_index.to_string() + target_bb.to_string())
end

# Branch ID from function symbol + bb + terminator
def compute_branch_id(symbol_id: String, bb_id: Int, term_index: Int, kind: BranchPointKind) -> String
  let kind_str = match kind
  when BranchPointKind::IfExpr then "if"
  when BranchPointKind::WhileExpr then "while"
  when BranchPointKind::MatchExpr then "match"
  when BranchPointKind::ShortCircuit then "short_circuit"
  when BranchPointKind::Guard then "guard"
  when BranchPointKind::Desugar then "desugar"
  end
  sha256("tg.branch.v1" + symbol_id + bb_id.to_string() + term_index.to_string() + kind_str)
end

# Enumerate all branch points from a CqsCFG
def enumerate_branch_points(cfg: CqsCFG, symbol_id: String) -> Vec[BranchPoint]
  mut points = Vec::new()
  for block in cfg.blocks
    match block.terminator
    when Terminator::Branch(cond, t, f) then
      let bp_id = compute_branch_id(symbol_id, block.id, 0, BranchPointKind::IfExpr)
      mut arms = Vec::new()
      arms.push(BranchArm {
        arm_id: compute_arm_id(bp_id, 0, t),
        arm_index: 0,
        target_bb: t,
        label: "then"
      })
      arms.push(BranchArm {
        arm_id: compute_arm_id(bp_id, 1, f),
        arm_index: 1,
        target_bb: f,
        label: "else"
      })
      points.push(BranchPoint {
        branch_id: bp_id,
        bb_id: block.id,
        kind: BranchPointKind::IfExpr,
        arms: arms,
        span: Option::None
      })
    when Terminator::SwitchEnum(op, variants, other) then
      let bp_id = compute_branch_id(symbol_id, block.id, 0, BranchPointKind::MatchExpr)
      mut arms = Vec::new()
      for i in 0..variants.len() do
        let v = variants[i]
        arms.push(BranchArm {
          arm_id: compute_arm_id(bp_id, i, v.target),
          arm_index: i,
          target_bb: v.target,
          label: "Variant::" + v.value.to_string()
        })
      end
      match other
      when Option::Some(bb) then
        arms.push(BranchArm {
          arm_id: compute_arm_id(bp_id, variants.len(), bb),
          arm_index: variants.len(),
          target_bb: bb,
          label: "other"
        })
      when Option::None then ()
      end
      points.push(BranchPoint {
        branch_id: bp_id,
        bb_id: block.id,
        kind: BranchPointKind::MatchExpr,
        arms: arms,
        span: Option::None
      })
    when Terminator::SwitchInt(op, cases, other) then
      let bp_id = compute_branch_id(symbol_id, block.id, 0, BranchPointKind::MatchExpr)
      mut arms = Vec::new()
      # Cases sorted ascending by value
      let sorted_cases = cases.sorted_by(|a, b| a.value < b.value)
      for i in 0..sorted_cases.len() do
        let c = sorted_cases[i]
        arms.push(BranchArm {
          arm_id: compute_arm_id(bp_id, i, c.target),
          arm_index: i,
          target_bb: c.target,
          label: "case::" + c.value.to_string()
        })
      end
      match other
      when Option::Some(bb) then
        arms.push(BranchArm {
          arm_id: compute_arm_id(bp_id, sorted_cases.len(), bb),
          arm_index: sorted_cases.len(),
          target_bb: bb,
          label: "other"
        })
      when Option::None then ()
      end
      points.push(BranchPoint {
        branch_id: bp_id,
        bb_id: block.id,
        kind: BranchPointKind::MatchExpr,
        arms: arms,
        span: Option::None
      })
    when _ then ()
    end
  end
  points
end

# ═══════════════════════════════════════════════════════════════
# §52 — CF Signal Detection Algorithms
# ═══════════════════════════════════════════════════════════════

# §52.1 — CF-1: Unreachable Branch/Block
def detect_cf1(cfg: CqsCFG, symbol_spans: Map[Int, RichSpan]) -> Option[Signal]
  mut unreachable_count = 0
  mut locs = Vec::new()
  for block in cfg.blocks
    let block_id = block.id
    if !cfg.reachable.contains(&block_id)
      match symbol_spans.get(block_id)
      when Option::Some(span) then
        unreachable_count = unreachable_count + 1
        if locs.len() < 10  # First K=10 spans
          locs.push(span)
        end
      when Option::None then ()
      end
    end
  end
  if unreachable_count > 0
    let params = sev_count_params(SignalKind::CF1_UnreachableBranch)
    Option::Some(Signal {
      kind: SignalKind::CF1_UnreachableBranch,
      severity: sev_count(unreachable_count, params.n0, params.n1),
      count: unreachable_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

# §52.2 — CF-2: Non-Exhaustive Match
def detect_cf2(cfg: CqsCFG, match_info: Vec[MatchInfo]) -> Option[Signal]
  mut locs = Vec::new()
  for info in match_info
    ## Heuristic: if covered_variants contains "_" (wildcard), the programmer
    ## intentionally made the match non-exhaustive — treat as explicit.
    let has_wildcard = info.covered_variants.contains(&"_".to_string())
    if !info.is_exhaustive && !info.explicit_non_exhaustive && !has_wildcard
      locs.push(info.span.clone())
    end
  end
  if !locs.is_empty()
    Option::Some(Signal {
      kind: SignalKind::CF2_NonExhaustiveMatch,
      severity: sev_binary(),
      count: locs.len(),
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct MatchInfo
  span: RichSpan
  is_exhaustive: Bool
  explicit_non_exhaustive: Bool
  enum_type: Option[String]
  covered_variants: Vec[String]
  all_variants: Vec[String]
end

# §52.3 — CF-3: Panic/Unreachable as Normal Exit
def detect_cf3(cfg: CqsCFG, spans: Map[Int, RichSpan]) -> Option[Signal]
  mut panic_count = 0
  mut locs = Vec::new()
  for block in cfg.blocks
    let block_id = block.id
    if cfg.reachable.contains(&block_id)
      match block.terminator
      when Terminator::Panic then
        panic_count = panic_count + 1
        match spans.get(block_id)
        when Option::Some(s) then locs.push(s)
        when Option::None then ()
        end
      when Terminator::Unreachable then
        panic_count = panic_count + 1
        match spans.get(block.id)
        when Option::Some(s) then locs.push(s)
        when Option::None then ()
        end
      when _ then ()
      end
    end
  end
  if panic_count > 0
    Option::Some(Signal {
      kind: SignalKind::CF3_PanicUnreachableExit,
      severity: sev_binary(),
      count: panic_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

# §52.4 — CF-4: Constant-Return Dominance
def detect_cf4(
  cfg: CqsCFG,
  return_sites: Vec[ReturnSite],
  param_count: Int,
  has_non_context_param: Bool,
  surface: SurfaceClass
) -> Option[Signal]
  if return_sites.is_empty()
    return Option::None
  end
  let total = return_sites.len()
  mut constant_count = 0
  mut distinct_constants = Set::new()
  for site in return_sites
    match site.form
    when ReturnForm::Const(val) then
      constant_count = constant_count + 1
      distinct_constants.insert(val)
    when ReturnForm::NonConst then ()
    end
  end
  let c = to_float(constant_count) / to_float(total)
  let k = distinct_constants.len()
  let sev = sev_constant_return(c, k, 0.80, 1)

  # Only fires when has ≥1 non-context param or PublicStable/InternalHotPath
  let should_emit = (has_non_context_param || matches_surface(surface)) && c >= 0.80
  if should_emit && sev > 0.0
    let mut details = Map::new()
    details.insert("c", c.to_string())
    details.insert("k", k.to_string())
    Option::Some(Signal {
      kind: SignalKind::CF4_ConstantReturnDominance,
      severity: sev,
      count: 1,
      suppressed: false,
      penalty: 0.0,
      locations: Vec::new(),
      details: details
    })
  else
    Option::None
  end
end

struct ReturnSite
  bb_id: Int
  form: ReturnForm
end

enum ReturnForm
  Const(String)   # Normalized value representation
  NonConst
end

def matches_surface(s: SurfaceClass) -> Bool
  match s
  when SurfaceClass::PublicStable then true
  when SurfaceClass::InternalHotPath then true
  when _ then false
  end
end

# ═══════════════════════════════════════════════════════════════
# §53 — DF Signal Detection (Def-Use)
# ═══════════════════════════════════════════════════════════════

struct DefUseGraph
  definitions: Vec[Definition]
  uses: Vec[CqsUse]
  links: Vec[DefUseLink]
end

struct Definition
  local_id: Int
  stmt_index: Int
  bb_id: Int
end

struct CqsUse
  local_id: Int
  stmt_index: Int
  bb_id: Int
end

struct DefUseLink
  def_index: Int
  use_index: Int
end

# §53.2 — DF-1: Unused Parameter
def detect_df1(params: Vec[ParamInfo], def_use: DefUseGraph) -> Option[Signal]
  mut unused_count = 0
  mut locs = Vec::new()
  for p in params
    if p.name.starts_with("_") || p.has_unused_ok
      next
    end
    # Check if param is a context/capability type
    if p.is_context_param
      next
    end
    mut has_use = false
    for link in def_use.links
        let def_info = def_use.definitions[link.def_index]
        if def_info.local_id == p.local_id
        has_use = true
        break
      end
    end
    if !has_use
      unused_count = unused_count + 1
      locs.push(p.span.clone())
    end
  end
  if unused_count > 0
    let params_sev = sev_count_params(SignalKind::DF1_UnusedParameter)
    Option::Some(Signal {
      kind: SignalKind::DF1_UnusedParameter,
      severity: sev_count(unused_count, params_sev.n0, params_sev.n1),
      count: unused_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct ParamInfo
  local_id: Int
  name: String
  span: RichSpan
  is_context_param: Bool
  has_unused_ok: Bool
end

# §53.3 — DF-3: Dead Assignment (liveness analysis)
def detect_df3(def_use: DefUseGraph, spans: Map[Int, RichSpan]) -> Option[Signal]
  mut dead_count = 0
  mut locs = Vec::new()
  for i in 0..def_use.definitions.len() do
    let def_info = def_use.definitions[i]
    mut has_use = false
    for link in def_use.links
      if link.def_index == i
        has_use = true
        break
      end
    end
    if !has_use
      dead_count = dead_count + 1
      match spans.get(def_info.stmt_index)
      when Option::Some(s) then locs.push(s)
      when Option::None then ()
      end
    end
  end
  if dead_count > 0
    let params = sev_count_params(SignalKind::DF3_DeadAssignment)
    Option::Some(Signal {
      kind: SignalKind::DF3_DeadAssignment,
      severity: sev_count(dead_count, params.n0, params.n1),
      count: dead_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

# §53.4 — DF-2: AffectsReturn
def detect_df2(
  params: Vec[ParamInfo],
  dep_graph: DependencyGraph,
  return_sinks: Vec[Int]
) -> Option[Signal]
  mut non_context_params = Vec::new()
  for p in params do
    if !p.is_context_param then
      non_context_params.push(p.clone())
    end
  end
  if non_context_params.is_empty() || return_sinks.is_empty()
    return Option::None
  end
  mut affecting = 0
  let mut locs = Vec::new()
  for p in non_context_params
    if reachable_to_sink(dep_graph, p.local_id, return_sinks)
      affecting = affecting + 1
    else
      locs.push(p.span.clone())
    end
  end
  let sev = sev_output_independence(affecting, non_context_params.len())
  if sev > 0.0
    let details = Map::new()
    details.insert("affecting_params", affecting.to_string())
    details.insert("total_non_context_params", non_context_params.len().to_string())
    details.insert("return_sinks", return_sinks.len().to_string())
    Option::Some(Signal {
      kind: SignalKind::DF2_OutputIndependentOfInputs,
      severity: sev,
      count: 1,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: details
    })
  else
    Option::None
  end
end

struct DependencyGraph
  edges: Vec[DepEdge]
end

struct DepEdge
  from_local: Int
  to_local: Int
end

def reachable_to_sink(graph: DependencyGraph, start: Int, sinks: Vec[Int]) -> Bool
  mut visited: Set[Int] = Set::new()
  mut stack = Vec::new()
  stack.push(start)
  while !stack.is_empty() do
    let node = match stack.pop()
    when Option::Some(value) then value
    when Option::None then break
    end
    if sinks.contains(&node)
      return true
    end
    if !visited.contains(&node)
      visited.insert(node)
      for edge in graph.edges
        if edge.from_local == node
          stack.push(edge.to_local)
        end
      end
    end
  end
  false
end

# ═══════════════════════════════════════════════════════════════
# §54 — EH Signal Detection (Result Discipline)
# ═══════════════════════════════════════════════════════════════

enum ResultHandling
  Propagate      # via `?`
  OkBang         # via `.ok!`
  IgnoreReason(String) # via `.ignore("reason")`
  Handled        # Matched/consumed
  Unknown        # No handler — potential EH-1
end

# §54.2 — EH-1: Ignored Result without justification
def detect_eh1(result_sites: Vec[ResultSite]) -> Option[Signal]
  mut ignored_count = 0
  mut locs = Vec::new()
  for site in result_sites
    match site.handling
    when ResultHandling::Unknown then
      ignored_count = ignored_count + 1
      locs.push(site.span.clone())
    when _ then ()
    end
  end
  if ignored_count > 0
    let params = sev_count_params(SignalKind::EH1_IgnoredResultWithoutJustification)
    Option::Some(Signal {
      kind: SignalKind::EH1_IgnoredResultWithoutJustification,
      severity: sev_count(ignored_count, params.n0, params.n1),
      count: ignored_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct ResultSite
  span: RichSpan
  result_type: String
  handling: ResultHandling
end

# §54.3 — EH-2: Catch-all without action
def detect_eh2(wildcard_arms: Vec[WildcardArm]) -> Option[Signal]
  mut bad_count = 0
  mut locs = Vec::new()
  for arm in wildcard_arms
    if !arm.has_rethrow && !arm.has_log && !arm.has_ignore_reason && !arm.has_default_reason
      bad_count = bad_count + 1
      locs.push(arm.span.clone())
    end
  end
  if bad_count > 0
    Option::Some(Signal {
      kind: SignalKind::EH2_CatchAllWithoutAction,
      severity: sev_binary(),
      count: bad_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct WildcardArm
  span: RichSpan
  has_rethrow: Bool
  has_log: Bool
  has_ignore_reason: Bool
  has_default_reason: Bool
end

# §54.4 — EH-3: Broad Exception Boundary Swallowing
struct TryCatchInfo
  span: RichSpan
  catches_all: Bool       # catch block uses wildcard pattern
  has_rethrow: Bool       # whether the catch block re-raises
  has_logging: Bool       # whether the catch block logs the error
  body_stmt_count: Int    # number of statements in the catch body
end

def detect_eh3(try_catches: Vec[TryCatchInfo]) -> Option[Signal]
  mut bad_count = 0
  mut locs = Vec::new()
  for tc in try_catches do
    if tc.catches_all && !tc.has_rethrow && !tc.has_logging && tc.body_stmt_count <= 1 then
      bad_count = bad_count + 1
      locs.push(tc.span.clone())
    end
  end
  if bad_count > 0 then
    Option::Some(Signal {
      kind: SignalKind::EH3_BroadExceptionBoundarySwallowing,
      severity: sev_binary(),
      count: bad_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

# §53.5 — DF-4: All Branches Return Same Literal
struct BranchReturnInfo
  span: RichSpan
  branch_count: Int
  return_values: Vec[String]  # string representations of returned literals
end

def detect_df4(branches: Vec[BranchReturnInfo]) -> Option[Signal]
  mut bad_count = 0
  mut locs = Vec::new()
  for br in branches do
    if br.branch_count >= 2 && br.return_values.len() >= 2 then
      let first = br.return_values[0].clone()
      mut all_same = true
      for val in br.return_values do
        if val != first then
          all_same = false
          break
        end
      end
      if all_same then
        bad_count = bad_count + 1
        locs.push(br.span.clone())
      end
    end
  end
  if bad_count > 0 then
    Option::Some(Signal {
      kind: SignalKind::DF4_AllBranchesReturnSameLiteral,
      severity: sev_binary(),
      count: bad_count,
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# §56 — Capability Signal Detection
# ═══════════════════════════════════════════════════════════════

# §56.1 — Capability Set Extraction
struct CapabilitySet
  direct: Set[String]      # From parameter types
  transitive: Set[String]  # From callees
  from_effects: Set[String] # From effect-to-cap mapping
  from_unsafe: Bool        # Has unsafe blocks
end

def effect_to_capability(effect: String) -> Option[String]
  match effect
  when "net.read" then Option::Some("NetCap")
  when "net.write" then Option::Some("NetCap")
  when "fs.read" then Option::Some("FsReadCap")
  when "fs.write" then Option::Some("FsCap")
  when "process.spawn" then Option::Some("ProcCap")
  when "ffi.call" then Option::Some("FfiCap")
  when "env.read" then Option::Some("EnvCap")
  when "env.write" then Option::Some("EnvCap")
  when "db.read" then Option::Some("DbCap")
  when "db.write" then Option::Some("DbCap")
  when "clock.now" then Option::Some("ClockCap")
  when "random.gen" then Option::Some("RandomCap")
  when _ then
    let lowered = effect.to_lowercase()
    if lowered.starts_with("net.") then
      Option::Some("NetCap")
    elsif lowered.starts_with("fs.") then
      if lowered.contains("read") then Option::Some("FsReadCap") else Option::Some("FsCap") end
    elsif lowered.starts_with("process.") then
      Option::Some("ProcCap")
    elsif lowered.starts_with("ffi.") then
      Option::Some("FfiCap")
    elsif lowered.starts_with("env.") then
      Option::Some("EnvCap")
    elsif lowered.starts_with("db.") then
      Option::Some("DbCap")
    elsif lowered.starts_with("clock.") || lowered.starts_with("time.") then
      Option::Some("ClockCap")
    elsif lowered.starts_with("random.") || lowered.starts_with("rand.") then
      Option::Some("RandomCap")
    else
      Option::None
    end
  end
end

## Capability implication graph: if a capability is present, its implied
## capabilities are also considered present (e.g., "net" implies "io",
## "http" implies "net" and "io", "db" implies "io").
def _expand_capability_implications(caps: Set[String]) -> Set[String]
  let mut expanded = caps.clone()
  let mut changed = true
  while changed
    changed = false
    let snapshot = expanded.clone()
    for cap in snapshot
      let implied = _capability_implies(cap)
      for imp in implied
        if !expanded.contains(&imp)
          expanded.insert(imp)
          changed = true
        end
      end
    end
  end
  expanded
end

def _capability_implies(cap: str) -> Vec[String]
  ## Returns the capabilities transitively implied by the given capability
  match cap
  when "NetCap" then vec!["IoCap".to_string()]
  when "HttpCap" then vec!["NetCap".to_string(), "IoCap".to_string()]
  when "DbCap" then vec!["IoCap".to_string()]
  when "FsCap" then vec!["IoCap".to_string()]
  when "ProcessCap" then vec!["IoCap".to_string()]
  else Vec::new()
  end
end

# §56.2 — CP-1: Capability Drift
def detect_cp1(current_caps: Set[String], baseline_caps: Set[String]) -> Option[Signal]
  ## Expand baseline with transitive implications before diffing
  let expanded_baseline = _expand_capability_implications(baseline_caps)
  mut drift = Set::new()
  for cap in current_caps
    let cap_name = cap.clone()
    if !expanded_baseline.contains(&cap_name)
      drift.insert(cap_name)
    end
  end
  if !drift.is_empty()
    let n_cap_max = 10
    let sev = to_float(drift.len()) / to_float(max_int(drift.len(), n_cap_max))
    let mut details = Map::new()
    details.insert("new_caps", drift.to_vec().join(", "))
    details.insert("baseline_caps", baseline_caps.to_vec().join(", "))
    Option::Some(Signal {
      kind: SignalKind::CP1_CapabilityDrift,
      severity: sev,
      count: drift.len(),
      suppressed: false,
      penalty: 0.0,
      locations: Vec::new(),
      details: details
    })
  else
    Option::None
  end
end

# §56.3 — CP-2: Unsafe block without reason
def detect_cp2(unsafe_blocks: Vec[UnsafeBlockInfo]) -> Option[Signal]
  mut locs = Vec::new()
  for block in unsafe_blocks
    if block.reason.is_none() || block.reason.unwrap_or("").is_empty()
      locs.push(block.span.clone())
    end
  end
  if !locs.is_empty()
    Option::Some(Signal {
      kind: SignalKind::CP2_UnsafeBlockWithoutReason,
      severity: sev_binary(),
      count: locs.len(),
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct UnsafeBlockInfo
  span: RichSpan
  reason: Option[String]
end

# §56.4 — CP-3: Tainted FFI value without validation
def detect_cp3(taint_flows: Vec[TaintFlow]) -> Option[Signal]
  mut locs = Vec::new()
  for flow in taint_flows
    if !flow.validated
      locs.push(flow.source_span.clone())
    end
  end
  if !locs.is_empty()
    Option::Some(Signal {
      kind: SignalKind::CP3_TaintedFFIValueUsedWithoutValidation,
      severity: sev_binary(),
      count: locs.len(),
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct TaintFlow
  source_span: RichSpan
  sink_span: RichSpan
  validated: Bool
  validator: Option[String]
end

# ═══════════════════════════════════════════════════════════════
# §57 — Future/Feature Signal Detection
# ═══════════════════════════════════════════════════════════════

def detect_ft1(future_blocks: Vec[FutureBlock]) -> Option[Signal]
  mut locs = Vec::new()
  for fb in future_blocks
    if fb.feature_enabled
      locs.push(fb.span.clone())
    end
  end
  if !locs.is_empty()
    Option::Some(Signal {
      kind: SignalKind::FT1_FutureBlockInEnabledFeature,
      severity: sev_binary(),
      count: locs.len(),
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct FutureBlock
  span: RichSpan
  feature: String
  feature_enabled: Bool
end

def detect_ft2(cfg_regions: Vec[CfgRegion]) -> Option[Signal]
  mut locs = Vec::new()
  for region in cfg_regions
    if region.active && region.has_cf3_or_cf4
      locs.push(region.span.clone())
    end
  end
  if !locs.is_empty()
    Option::Some(Signal {
      kind: SignalKind::FT2_CfgFeatureEnabledButIncomplete,
      severity: sev_binary(),
      count: locs.len(),
      suppressed: false,
      penalty: 0.0,
      locations: locs,
      details: Map::new()
    })
  else
    Option::None
  end
end

struct CfgRegion
  span: RichSpan
  feature: String
  active: Bool
  has_cf3_or_cf4: Bool
end

# ═══════════════════════════════════════════════════════════════
# §32 — CQS Determinism Requirement
# ═══════════════════════════════════════════════════════════════

# Output MUST be:
#   Stable across builds
#   Stable across machines
#   Independent of timing
#   Independent of non-deterministic test order
# All functions above produce deterministic output given the same MIR input.

# ═══════════════════════════════════════════════════════════════
# §33 — CQS Human-Friendliness Guarantees
# ═══════════════════════════════════════════════════════════════

# Never require verbose annotations in Dev mode
# Never block InternalGlue code
# Never require tests for experimental APIs
# Provide actionable suggestions, not vague warnings
# Allow opt-in strictness via config

def is_gating_blocked(surface: SurfaceClass, mode: Mode) -> Bool
  match surface
  when SurfaceClass::InternalGlue then true   # Never block glue
  when SurfaceClass::TestOnly then true        # Never block tests
  when SurfaceClass::PublicExperimental then
    match mode
    when Mode::Hardened then false  # Even experimental gated in Hardened
    when _ then true               # Never gate experimental otherwise
    end
  when _ then false
  end
end

# ═══════════════════════════════════════════════════════════════
# §34 — CQS Agent Optimization Guarantees
# ═══════════════════════════════════════════════════════════════

# Deterministic next actions
# Explicit structured diagnostics
# Reduced retry loops
# Context widening via structured metadata
# Prevention of incomplete public APIs in release builds

def generate_suggested_actions(sym: SymbolReport, mode: Mode) -> Vec[SuggestedAction]
  mut actions = Vec::new()

  for signal in sym.signals
    if signal.suppressed then next end

    let action = match signal.kind
    when SignalKind::CF1_UnreachableBranch then
      Option::Some(SuggestedAction {
        action_id: "remove_unreachable_branch",
        priority: 3,
        title: "Remove unreachable branch or fix condition to make it reachable",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::CF2_NonExhaustiveMatch then
      Option::Some(SuggestedAction {
        action_id: "add_missing_match_arms",
        priority: 1,
        title: "Add missing match arms for exhaustiveness",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 1.0
      })
    when SignalKind::CF3_PanicUnreachableExit then
      Option::Some(SuggestedAction {
        action_id: "replace_panic_with_result",
        priority: 2,
        title: "Replace panic/unreachable with Result return or proper error handling",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.85
      })
    when SignalKind::CF4_ConstantReturnDominance then
      Option::Some(SuggestedAction {
        action_id: "simplify_constant_return",
        priority: 3,
        title: "Simplify function that always returns a constant",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::DF1_UnusedParameter then
      Option::Some(SuggestedAction {
        action_id: "use_or_prefix_param",
        priority: 3,
        title: "Use parameter or prefix with _ to mark intentionally unused",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.95
      })
    when SignalKind::DF2_OutputIndependentOfInputs then
      Option::Some(SuggestedAction {
        action_id: "connect_output_to_inputs",
        priority: 2,
        title: "Connect function output to its inputs or mark as constant",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.85
      })
    when SignalKind::DF3_DeadAssignment then
      Option::Some(SuggestedAction {
        action_id: "remove_dead_assignment",
        priority: 3,
        title: "Remove dead assignment or use the assigned value",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.95
      })
    when SignalKind::DF4_AllBranchesReturnSameLiteral then
      Option::Some(SuggestedAction {
        action_id: "collapse_identical_branches",
        priority: 3,
        title: "Collapse branches that all return the same literal value",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 1.0
      })
    when SignalKind::EH1_IgnoredResultWithoutJustification then
      Option::Some(SuggestedAction {
        action_id: "handle_result",
        priority: 2,
        title: "Handle or propagate Result value",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::EH2_CatchAllWithoutAction then
      Option::Some(SuggestedAction {
        action_id: "add_catch_action",
        priority: 2,
        title: "Add logging or re-raise in catch-all handler",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::EH3_BroadExceptionBoundarySwallowing then
      Option::Some(SuggestedAction {
        action_id: "narrow_exception_boundary",
        priority: 1,
        title: "Narrow catch scope or add error logging to prevent silent swallowing",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::CV1_UnexecutedPublicBranch then
      Option::Some(SuggestedAction {
        action_id: "add_branch_test",
        priority: 2,
        title: "Add test case to cover unexecuted public branch",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.85
      })
    when SignalKind::CV2_CoverageBelowThreshold then
      Option::Some(SuggestedAction {
        action_id: "increase_coverage",
        priority: 2,
        title: "Add tests to meet coverage threshold",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.8
      })
    when SignalKind::CP1_CapabilityDrift then
      Option::Some(SuggestedAction {
        action_id: "review_capability_drift",
        priority: 1,
        title: "Review and update capability baseline or remove drifted capabilities",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::CP2_UnsafeBlockWithoutReason then
      Option::Some(SuggestedAction {
        action_id: "add_unsafe_reason",
        priority: 1,
        title: "Add reason parameter to unsafe block",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 1.0
      })
    when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then
      Option::Some(SuggestedAction {
        action_id: "validate_ffi_value",
        priority: 1,
        title: "Validate FFI return value before use across trust boundary",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.95
      })
    when SignalKind::FT1_FutureBlockInEnabledFeature then
      Option::Some(SuggestedAction {
        action_id: "implement_future_block",
        priority: 2,
        title: "Implement future block content now that feature is enabled",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when SignalKind::FT2_CfgFeatureEnabledButIncomplete then
      Option::Some(SuggestedAction {
        action_id: "complete_feature_impl",
        priority: 2,
        title: "Complete feature implementation or disable feature flag",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.85
      })
    end

    match action
    when Option::Some(a) then actions.push(a)
    when Option::None then ()
    end
  end

  actions
end

# ═══════════════════════════════════════════════════════════════
# §35 — CQS Security Integration (Hardened mode)
# ═══════════════════════════════════════════════════════════════

def hardened_security_check(sym: SymbolReport) -> Vec[String]
  mut violations = Vec::new()

  for signal in sym.signals
    match signal.kind
    when SignalKind::CP1_CapabilityDrift then
      if !signal.suppressed
        violations.push("Capability drift without explicit review flag")
      end
    when SignalKind::CP2_UnsafeBlockWithoutReason then
      if !signal.suppressed
        violations.push("Unsafe block without reason")
      end
    when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then
      if !signal.suppressed
        violations.push("FFI tainted value crosses boundary without validation")
      end
    when _ then ()
    end
  end

  # Check coverage for public branches
  match sym.coverage
  when Option::Some(cov) then
    if sym.surface_class == SurfaceClass::PublicStable && cov.branch_ratio < 0.85
      violations.push("Public branches not fully covered by tests")
    end
  when Option::None then ()
  end

  violations
end

# ═══════════════════════════════════════════════════════════════
# Entry Point — Run CQS Analysis
# ═══════════════════════════════════════════════════════════════

def find_mir_function(mir_functions: Vec[MirFunction], name: String) -> Option[MirFunction]
  for func in mir_functions do
    if func.name == name then
      return Option::Some(func)
    end
  end
  Option::None
end

def extract_branch_return_info(func: MirFunction) -> Vec[BranchReturnInfo]
  mut results = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirSwitchInt(_, targets, fallback) then
      mut return_values = Vec::new()
      mut branch_count = 0
      for target in targets do
        branch_count = branch_count + 1
        match find_block_terminal_constant(func, target.target)
        when Option::Some(val) then return_values.push(val)
        when Option::None then ()
        end
      end
      branch_count = branch_count + 1
      match find_block_terminal_constant(func, fallback)
      when Option::Some(val) then return_values.push(val)
      when Option::None then ()
      end
      if branch_count >= 2 && return_values.len() == branch_count then
        results.push(BranchReturnInfo {
          span: RichSpan {
            file: func.name.clone(),
            start_line: block.id.id,
            start_col: 0,
            end_line: block.id.id,
            end_col: 0
          },
          branch_count: branch_count,
          return_values: return_values
        })
      end
    when _ then ()
    end
  end
  results
end

def find_block_terminal_constant(func: MirFunction, target: MirBlockId) -> Option[String]
  for block in func.blocks do
    if block.id.id == target.id then
      match block.terminator.kind
      when MirTerminatorKind::MirReturn then
        if !block.statements.is_empty() then
          let last = block.statements[block.statements.len() - 1]
          match last.kind
          when MirStatementKind::MirAssign(_, rvalue) then
            match rvalue.kind
            when MirRvalueKind::MirMove(operand) then
              match operand.kind
              when MirOperandKind::MirConstant(c) then
                match c.kind
                when MirConstantKind::MirInt(i) then return Option::Some(i.to_string())
                when MirConstantKind::MirBool(b) then return Option::Some(b.to_string())
                when MirConstantKind::MirFloat(f) then return Option::Some(f.to_string())
                when MirConstantKind::MirString(s) then return Option::Some(s.clone())
                when MirConstantKind::MirUnit then return Option::Some("unit")
                when _ then ()
                end
              when _ then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
      return Option::None
    end
  end
  Option::None
end

def extract_try_catch_info(func: MirFunction) -> Vec[TryCatchInfo]
  mut results = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall(_, _, _, _, unwind, _) then
      match unwind
      when Option::Some(unwind_block) then
        match find_block_by_id(func, unwind_block)
        when Option::Some(catch_block) then
          let catches_all = true
          let body_count = catch_block.statements.len()
          let has_rethrow = block_has_rethrow(func, catch_block)
          let has_logging = block_has_logging(catch_block)
          results.push(TryCatchInfo {
            span: RichSpan {
              file: func.name.clone(),
              start_line: block.id.id,
              start_col: 0,
              end_line: unwind_block.id,
              end_col: 0
            },
            catches_all: catches_all,
            has_rethrow: has_rethrow,
            has_logging: has_logging,
            body_stmt_count: body_count
          })
        when Option::None then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  results
end

def find_block_by_id(func: MirFunction, target: MirBlockId) -> Option[MirBlock]
  for block in func.blocks do
    if block.id.id == target.id then
      return Option::Some(block)
    end
  end
  Option::None
end

def block_has_rethrow(func: MirFunction, block: MirBlock) -> Bool
  match block.terminator.kind
  when MirTerminatorKind::MirUnreachable then true
  when MirTerminatorKind::MirCall(_, callee, _, _, _, _) then
    match callee.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirFnItem(name) then
        name.contains("panic") || name.contains("raise") || name.contains("rethrow")
      when _ then false
      end
    when _ then false
    end
  when _ then false
  end
end

def block_has_logging(block: MirBlock) -> Bool
  for stmt in block.statements do
    match stmt.kind
    when MirStatementKind::MirAssign(_, rvalue) then
      match rvalue.kind
      when MirRvalueKind::MirMove(operand) then
        match operand.kind
        when MirOperandKind::MirConstant(c) then
          match c.kind
          when MirConstantKind::MirFnItem(name) then
            if name.contains("log") || name.contains("eprintln") || name.contains("warn") then
              return true
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  end
  false
end

# ═══════════════════════════════════════════════════════════════
# §79 — MIR-derived signal inputs (the FULL detector wiring)
# ═══════════════════════════════════════════════════════════════
# run_cqs_analysis runs the COMPLETE detector set over the lowered MIR:
# every detector whose input is derivable from the MIR shape — the
# reachability-based CF family (CF-1/CF-3/CF-4), the def-use DF family
# (DF-1/DF-3), the switch-based DF-4, the unwind-based EH-3. The
# extractions below translate the MIR into the detector input shapes;
# nothing is inferred beyond the MIR.

# The CqsCFG translation of a lowered MIR function: the basic blocks and
# the control-flow edges (goto/switch/call/assert/deinit targets), with
# the reachable set computed by DFS from the entry block. Every CF-family
# detector consumes THIS construction.
def cqs_cfg_from_function(func: MirFunction) -> CqsCFG
  mut blocks = Vec::new()
  mut edges = Vec::new()
  for block in func.blocks do
    let term = match block.terminator.kind
    when MirTerminatorKind::MirGoto(target) then
      edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: target.id })
      Terminator::Goto(target.id)
    when MirTerminatorKind::MirReturn then
      Terminator::Return
    when MirTerminatorKind::MirUnreachable then
      Terminator::Unreachable
    when MirTerminatorKind::MirAbort then
      Terminator::Panic
    when MirTerminatorKind::MirSwitchInt(_, targets, default_target) then
      mut arms = Vec::new()
      for t in targets do
        arms.push(SwitchArm { value: t.value, target: t.target.id })
        edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: t.target.id })
      end
      edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: default_target.id })
      Terminator::SwitchInt(0, arms, Option::Some(default_target.id))
    when MirTerminatorKind::MirCall(_, _, _, success, unwind, _) then
      edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: success.id })
      match unwind
      when Option::Some(u) then
        edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: u.id })
      when Option::None then ()
      end
      Terminator::Goto(success.id)
    when MirTerminatorKind::MirAssert(_, _, _, target, unwind) then
      edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: target.id })
      match unwind
      when Option::Some(u) then
        edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: u.id })
      when Option::None then ()
      end
      Terminator::Goto(target.id)
    when MirTerminatorKind::MirDeinit(_, _, target, unwind) then
      edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: target.id })
      match unwind
      when Option::Some(u) then
        edges.push(CqsCFGEdge { from_bb: block.id.id, to_bb: u.id })
      when Option::None then ()
      end
      Terminator::Goto(target.id)
    end
    blocks.push(BasicBlock {
      id: block.id.id,
      statements: block.statements.clone(),
      terminator: term
    })
  end
  let cfg = CqsCFG {
    entry: func.entry_block.id,
    blocks: blocks,
    edges: edges,
    reachable: Set::new()
  }
  CqsCFG {
    entry: cfg.entry,
    blocks: cfg.blocks.clone(),
    edges: cfg.edges.clone(),
    reachable: compute_reachability(&cfg)
  }
end

# The local id an operand references, when it references a local at all
# (constants carry none).
def cqs_operand_local(operand: MirOperand) -> Option[Int]
  match operand.kind
  when MirOperandKind::MirCopy(place) then Option::Some(place.local.id)
  when MirOperandKind::MirMovePlace(place) then Option::Some(place.local.id)
  when MirOperandKind::MirRead(place) then Option::Some(place.local.id)
  when MirOperandKind::MirConsume(place) then Option::Some(place.local.id)
  when _ then Option::None
  end
end

def cqs_collect_rvalue_uses(rvalue: MirRvalue, bb_id: Int, stmt_index: Int, inout uses: Vec[CqsUse]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then
    match cqs_operand_local(&operand)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirRvalueKind::MirRef(place) then
    uses.push(CqsUse { local_id: place.local.id, stmt_index: stmt_index, bb_id: bb_id })
  when MirRvalueKind::MirAggregate(_, operands) then
    for op in operands do
      match cqs_operand_local(&op)
      when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirBinOp(_, left, right) then
    match cqs_operand_local(&left)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
    match cqs_operand_local(&right)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirRvalueKind::MirUnOp(_, operand) then
    match cqs_operand_local(&operand)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirRvalueKind::MirDiscriminant(place) then
    uses.push(CqsUse { local_id: place.local.id, stmt_index: stmt_index, bb_id: bb_id })
  when MirRvalueKind::MirLen(place) then
    uses.push(CqsUse { local_id: place.local.id, stmt_index: stmt_index, bb_id: bb_id })
  when MirRvalueKind::MirCast(_, operand, _) then
    match cqs_operand_local(&operand)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirRvalueKind::MirRepeat(operand, _) then
    match cqs_operand_local(&operand)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirRvalueKind::MirPhi(pairs) then
    for (_, local) in pairs do
      uses.push(CqsUse { local_id: local.id, stmt_index: stmt_index, bb_id: bb_id })
    end
  when _ then ()
  end
end

def cqs_collect_terminator_uses(terminator: MirTerminator, bb_id: Int, stmt_index: Int, inout uses: Vec[CqsUse]) -> Unit
  match terminator.kind
  when MirTerminatorKind::MirSwitchInt(op, _, _) then
    match cqs_operand_local(&op)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
  when MirTerminatorKind::MirCall(_, func, args, _, _, _) then
    match cqs_operand_local(&func)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
    for arg in args do
      match arg.value
      when MirCallValue::Value(operand) then
        match cqs_operand_local(&operand)
        when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
        when Option::None then ()
        end
      when MirCallValue::Place(place) then
        uses.push(CqsUse { local_id: place.local.id, stmt_index: stmt_index, bb_id: bb_id })
      end
    end
  when MirTerminatorKind::MirAssert(cond, _, msg, _, _) then
    match cqs_operand_local(&cond)
    when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
    when Option::None then ()
    end
    match msg
    when AssertMessage::BoundsCheck(a, b) then
      match cqs_operand_local(&a)
      when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
      when Option::None then ()
      end
      match cqs_operand_local(&b)
      when Option::Some(local) then uses.push(CqsUse { local_id: local, stmt_index: stmt_index, bb_id: bb_id })
      when Option::None then ()
      end
    when _ then ()
    end
  when _ then ()
  end
end

# The return slot of a lowered MIR function: the "_ret" local (the
# locals[0] convention). Its definition is the function's return-value
# write — never a "dead assignment" (the value is consumed by the
# MirReturn terminator, which carries no operand), so the def-use
# extraction EXCLUDES it: a clean function never produces a DF-3 signal
# for its own return write.
def cqs_ret_local_id(func: MirFunction) -> Int
  for l in func.locals do
    if l.name == "_ret" then
      return l.id.id
    end
  end
  -1
end

# The def-use graph of a lowered MIR function: every assignment is a
# definition, every operand read is a use, and a link pairs a definition
# with a use of the SAME local. The DF-1 (unused parameter) and DF-3
# (dead assignment) detectors consume it.
def cqs_def_use_from_function(func: MirFunction) -> DefUseGraph
  mut definitions = Vec::new()
  mut uses = Vec::new()
  let ret_local = cqs_ret_local_id(&func)
  for block in func.blocks do
    var stmt_index = 0
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.local.id != ret_local then
          definitions.push(Definition { local_id: place.local.id, stmt_index: stmt_index, bb_id: block.id.id })
        end
        cqs_collect_rvalue_uses(&rvalue, block.id.id, stmt_index, uses)
      when _ then ()
      end
      stmt_index = stmt_index + 1
    end
    cqs_collect_terminator_uses(&block.terminator, block.id.id, stmt_index, uses)
  end
  mut links = Vec::new()
  var di = 0
  while di < definitions.len() do
    var ui = 0
    while ui < uses.len() do
      if definitions[di].local_id == uses[ui].local_id then
        links.push(DefUseLink { def_index: di, use_index: ui })
      end
      ui = ui + 1
    end
    di = di + 1
  end
  DefUseGraph { definitions: definitions, uses: uses, links: links }
end

# The parameter table of a lowered MIR function (the DF-1 input).
def cqs_param_info_from_function(func: MirFunction) -> Vec[ParamInfo]
  mut params = Vec::new()
  for p in func.params do
    params.push(ParamInfo {
      local_id: p.id.id,
      name: p.name.clone(),
      span: RichSpan {
        file: func.name.clone(),
        start_line: p.span.start,
        start_col: 0,
        end_line: p.span.start,
        end_col: 0
      },
      is_context_param: false,
      has_unused_ok: p.name.starts_with("_")
    })
  end
  params
end

# The per-statement spans (the DF-3 location table): statement index ->
# the statement's source span.
def cqs_stmt_spans_from_function(func: MirFunction) -> Map[Int, RichSpan]
  mut spans = Map::new()
  for block in func.blocks do
    var stmt_index = 0
    for stmt in block.statements do
      spans.insert(stmt_index, RichSpan {
        file: func.name.clone(),
        start_line: stmt.span.start,
        start_col: 0,
        end_line: stmt.span.end_pos,
        end_col: 0
      })
      stmt_index = stmt_index + 1
    end
  end
  spans
end

# The per-block spans (the CF-1/CF-3 location tables): block id -> the
# block's location, keyed off the MIR block id (deterministic).
def cqs_block_spans_from_function(func: MirFunction) -> Map[Int, RichSpan]
  mut spans = Map::new()
  for block in func.blocks do
    spans.insert(block.id.id, RichSpan {
      file: func.name.clone(),
      start_line: block.id.id,
      start_col: 0,
      end_line: block.id.id,
      end_col: 0
    })
  end
  spans
end

# The return sites of a lowered MIR function (the CF-4 input): every
# MirReturn block, classified Const when its final value is a constant.
def cqs_return_sites_from_function(func: MirFunction) -> Vec[ReturnSite]
  mut sites = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirReturn then
      var form = ReturnForm::NonConst
      if !block.statements.is_empty() then
        let last = block.statements[block.statements.len() - 1]
        match last.kind
        when MirStatementKind::MirAssign(_, rvalue) then
          match rvalue.kind
          when MirRvalueKind::MirMove(operand) then
            match operand.kind
            when MirOperandKind::MirConstant(c) then
              form = cqs_return_form_of_constant(&c)
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      end
      sites.push(ReturnSite { bb_id: block.id.id, form: form })
    when _ then ()
    end
  end
  sites
end

def cqs_return_form_of_constant(c: MirConstant) -> ReturnForm
  match c.kind
  when MirConstantKind::MirInt(i) then ReturnForm::Const(i.to_string())
  when MirConstantKind::MirBool(b) then ReturnForm::Const(b.to_string())
  when MirConstantKind::MirFloat(f) then ReturnForm::Const(f.to_string())
  when MirConstantKind::MirString(s) then ReturnForm::Const(s.clone())
  when MirConstantKind::MirChar(ch) then ReturnForm::Const(ch.to_string())
  when MirConstantKind::MirUnit then ReturnForm::Const("unit".to_string())
  when _ then ReturnForm::NonConst
  end
end

# §29/§42-43 — Run CQS Analysis (the FULL detector set)
pub def run_cqs_analysis(
  symbols: Vec[Symbol],
  mir_functions: Vec[MirFunction],
  mode: Mode,
  config_hash: String
) -> QualityReport
  mut module_reports = Map::new()

  for sym in symbols
    mut signals = Vec::new()

    match find_mir_function(mir_functions, &sym.name)
    when Option::Some(func) then
      # CF-1 (unreachable branch) and CF-3 (panic/unreachable exit): the
      # reachability-based detectors over the MIR-derived CFG.
      let cfg = cqs_cfg_from_function(&func)
      let block_spans = cqs_block_spans_from_function(&func)
      match detect_cf1(&cfg, &block_spans)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end
      match detect_cf3(&cfg, &block_spans)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end

      # CF-4 (constant-return dominance): the return-site classification.
      let return_sites = cqs_return_sites_from_function(&func)
      match detect_cf4(&cfg, &return_sites, func.params.len(), !func.params.is_empty(), sym.surface_class)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end

      # DF-1 (unused parameter) and DF-3 (dead assignment): the def-use
      # graph.
      let def_use = cqs_def_use_from_function(&func)
      let params = cqs_param_info_from_function(&func)
      match detect_df1(&params, &def_use)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end
      let stmt_spans = cqs_stmt_spans_from_function(&func)
      match detect_df3(&def_use, &stmt_spans)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end

      # DF-4 (all branches return the same literal) and EH-3 (broad
      # exception-boundary swallowing): the switch/unwind extractions.
      let branch_info = extract_branch_return_info(&func)
      match detect_df4(&branch_info)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end

      let try_catch_info = extract_try_catch_info(&func)
      match detect_eh3(&try_catch_info)
      when Option::Some(signal) then signals.push(signal)
      when Option::None then ()
      end
    when Option::None then ()
    end

    # Deterministic emission order: kind ordinal, then the first location.
    sort_signals(signals)

    let score = compute_score(&signals)
    let signal_actions = generate_suggested_actions_from_signals(&signals, mode)

    mut report = SymbolReport {
      symbol_id: sym.symbol_id,
      name: sym.name,
      kind: sym.kind,
      span: sym.span,
      surface_class: sym.surface_class,
      score: score,
      score_raw: score.raw,
      penalty_total: 100.0 - score.raw,
      coverage: Option::None,
      capabilities: Option::None,
      signals: signals,
      suggested_actions: signal_actions
    }

    # Run the SymbolReport-level action generator for richer suggestions
    let report_actions = generate_suggested_actions(&report, mode)
    for ra in report_actions do
      report.suggested_actions.push(ra)
    end

    let module = module_reports.entry(sym.module_path).or_insert(Vec::new())
    module.push(report)
  end

  # Build final report
  mut modules = Vec::new()
  mut total_symbols = 0
  mut total_scored = 0
  mut total_gated = 0
  mut min_score = 100
  mut weighted_sum = 0.0
  mut weight_sum = 0.0
  mut signals_total = 0
  mut kind_counts = Map::new()

  for (path, sym_reports) in module_reports
    let mod_score = compute_module_score(&sym_reports)
    for sr in sym_reports
      total_symbols = total_symbols + 1
      total_scored = total_scored + 1
      signals_total = signals_total + sr.signals.len()
      for sig in sr.signals do
        let ordinal = signal_kind_ordinal(sig.kind)
        match kind_counts.get(ordinal)
        when Option::Some(n) then kind_counts.insert(ordinal, n + 1)
        when Option::None then kind_counts.insert(ordinal, 1)
        end
      end
      if sr.score.clamped < min_score
        min_score = sr.score.clamped
      end
      let w = surface_weight(sr.surface_class)
      weighted_sum = weighted_sum + w * to_float(sr.score.clamped)
      weight_sum = weight_sum + w

      # Check gating
      let action = enforcement_action(sr.surface_class, mode, sr.score.clamped)
      match action
      when EnforcementAction::Error then total_gated = total_gated + 1
      when _ then ()
      end
    end
    modules.push(ModuleReport {
      module_path: path,
      module_score_weighted: mod_score,
      symbols: sym_reports
    })
  end

  # The top signal kinds: descending count, ties broken by kind ordinal
  # (deterministic).
  mut top_signal_kinds = Vec::new()
  for (ordinal, count) in kind_counts do
    top_signal_kinds.push(SignalCount { kind: signal_kind_of_ordinal(ordinal), count: count })
  end
  top_signal_kinds.sort_by(|a, b| cqs_signal_count_lt(a, b))

  let avg = if weight_sum > 0.0 then weighted_sum / weight_sum else 100.0 end

  QualityReport {
    schema_version: "cqs.v0.2",
    tangerine_edition: "2026",
    tgc_version: "0.1.0",
    target: "native",
    mode: mode,
    config_hash: config_hash,
    package_name: "tangerine",
    package_version: "0.1.0",
    summary: QualitySummary {
      symbols_total: total_symbols,
      symbols_scored: total_scored,
      avg_score_weighted: avg,
      min_score: min_score,
      gated_failures: total_gated,
      signals_total: signals_total,
      top_signal_kinds: top_signal_kinds
    },
    modules: modules
  }
end

def signal_kind_of_ordinal(ordinal: Int) -> SignalKind
  match ordinal
  when 0 then SignalKind::CF1_UnreachableBranch
  when 1 then SignalKind::CF2_NonExhaustiveMatch
  when 2 then SignalKind::CF3_PanicUnreachableExit
  when 3 then SignalKind::CF4_ConstantReturnDominance
  when 4 then SignalKind::DF1_UnusedParameter
  when 5 then SignalKind::DF2_OutputIndependentOfInputs
  when 6 then SignalKind::DF3_DeadAssignment
  when 7 then SignalKind::DF4_AllBranchesReturnSameLiteral
  when 8 then SignalKind::EH1_IgnoredResultWithoutJustification
  when 9 then SignalKind::EH2_CatchAllWithoutAction
  when 10 then SignalKind::EH3_BroadExceptionBoundarySwallowing
  when 11 then SignalKind::CV1_UnexecutedPublicBranch
  when 12 then SignalKind::CV2_CoverageBelowThreshold
  when 13 then SignalKind::CP1_CapabilityDrift
  when 14 then SignalKind::CP2_UnsafeBlockWithoutReason
  when 15 then SignalKind::CP3_TaintedFFIValueUsedWithoutValidation
  when 16 then SignalKind::FT1_FutureBlockInEnabledFeature
  when 17 then SignalKind::FT2_CfgFeatureEnabledButIncomplete
  when _ then SignalKind::CF1_UnreachableBranch
  end
end

def cqs_signal_count_lt(a: SignalCount, b: SignalCount) -> Bool
  if a.count != b.count then
    a.count > b.count
  else
    signal_kind_ordinal(a.kind) < signal_kind_ordinal(b.kind)
  end
end

# ═══════════════════════════════════════════════════════════════
# §80 — The CQS Query Server (the canonical pipeline's consumer)
# ═══════════════════════════════════════════════════════════════
# The compiler-query-server surface the canonical pipeline (the driver's
# check path, the library API) INVOKES on the analyzed program + the
# lowered MIR. The three queries:
#   cqs_query_symbols     — the symbol table (module-path-qualified
#                           symbols with stable ids + surface classes);
#   cqs_query_typed_info  — the typed information (per-symbol signature
#                           text + the resolved-expression coverage of
#                           the function bodies — the typed HIR's
#                           expr_types);
#   cqs_query_diagnostics — the detected signals converted into the
#                           pipeline's STRUCTURED diagnostics at the
#                           enforcement levels the mode matrix assigns
#                           (Error where the gate blocks, Warning where
#                           it warns, absent where it does not enforce).
# The query results AFFECT THE COMPILATION where required: the driver's
# check path reports the Error-level diagnostics and fails the check;
# the library API surfaces them on its Result channel.

pub struct CqsQueryServer
  schema_version: String
end

pub def cqs_query_server_new() -> CqsQueryServer
  CqsQueryServer {
    schema_version: "cqs-query.v1"
  }
end

pub struct CqsTypedInfo
  symbol_id: String
  name: String
  kind: SymbolKind
  type_str: String
  param_count: Int
  generic_count: Int
  typed_expr_count: Int
  span: RichSpan
end

pub struct CqsQueryResults
  typed_info: Vec[CqsTypedInfo]
  symbols: Vec[Symbol]
  diagnostics: Vec[Diagnostic]
end

pub def cqs_run_queries(
  server: CqsQueryServer,
  ast: Program,
  typed: TypedProgram,
  mir: MirProgram,
  mode: Mode,
  config_hash: String
) -> CqsQueryResults
  let symbols = cqs_query_symbols(&ast)
  let typed_info = cqs_query_typed_info(&ast, &typed)
  # The query server's schema version NAMESPACES the analysis config:
  # the report's config_hash records which query-server generation
  # produced the results.
  let diagnostics = cqs_query_diagnostics(&mir, &symbols, mode, server.schema_version.clone() + ":" + config_hash)
  CqsQueryResults {
    typed_info: typed_info,
    symbols: symbols,
    diagnostics: diagnostics
  }
end

pub def cqs_query_symbols(ast: Program) -> Vec[Symbol]
  mut symbols = Vec::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      symbols.push(cqs_build_symbol(&ast, &item, f.name.clone(), SymbolKind::Function))
    when ItemKind::ItemStruct(s) then
      symbols.push(cqs_build_symbol(&ast, &item, s.name.clone(), SymbolKind::Struct))
    when ItemKind::ItemEnum(e) then
      symbols.push(cqs_build_symbol(&ast, &item, e.name.clone(), SymbolKind::Enum))
    when ItemKind::ItemTrait(t) then
      symbols.push(cqs_build_symbol(&ast, &item, t.name.clone(), SymbolKind::Trait))
    when ItemKind::ItemImpl(imp) then
      symbols.push(cqs_build_symbol(&ast, &item, "impl".to_string(), SymbolKind::Impl))
      for m in imp.methods do
        symbols.push(cqs_build_symbol(&ast, &item, m.name.clone(), SymbolKind::Method))
      end
    when _ then ()
    end
  end
  symbols
end

def cqs_build_symbol(ast: Program, item: Item, name: String, kind: SymbolKind) -> Symbol
  let module_path = cqs_module_path_of(ast, &item)
  let symbol_id = sha256("tg.symbol.v1" + module_path.clone() + "::" + name.clone() + cqs_symbol_kind_ordinal(kind).to_string())
  Symbol {
    symbol_id: symbol_id,
    name: name,
    kind: kind,
    span: cqs_span_to_rich(&item.span),
    surface_class: cqs_classify_item(&item),
    module_path: module_path
  }
end

def cqs_symbol_kind_ordinal(kind: SymbolKind) -> Int
  match kind
  when SymbolKind::Function then 0
  when SymbolKind::Method then 1
  when SymbolKind::Struct then 2
  when SymbolKind::Enum then 3
  when SymbolKind::Trait then 4
  when SymbolKind::Impl then 5
  when SymbolKind::Module then 6
  end
end

def cqs_module_path_of(ast: Program, item: Item) -> String
  match ast.crate.modules.get(item.owner_module)
  when Option::Some(info) then
    var parts = Vec::new()
    for seg in info.path do
      parts.push(seg.clone())
    end
    cqs_join_strings(&parts, "::")
  when Option::None then "".to_string()
  end
end

def cqs_classify_item(item: Item) -> SurfaceClass
  classify_surface(
    item.is_pub,
    cqs_item_has_attr(&item, "experimental"),
    0,
    cqs_item_has_attr(&item, "budget"),
    cqs_item_has_attr(&item, "hot"),
    cqs_item_stmt_count(&item),
    cqs_item_has_attr(&item, "test"),
    cqs_item_has_attr(&item, "cfg"),
    5
  )
end

def cqs_item_has_attr(item: Item, name: String) -> Bool
  for attr in item.attrs do
    if attr.name == name then
      return true
    end
  end
  false
end

def cqs_item_stmt_count(item: Item) -> Int
  match item.kind
  when ItemKind::ItemFunction(f) then
    match f.body
    when FnBody::FnBlock(block) then block.stmts.len()
    when _ then 0
    end
  when _ then 0
  end
end

pub def cqs_query_typed_info(ast: Program, typed: TypedProgram) -> Vec[CqsTypedInfo]
  mut info = Vec::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      info.push(cqs_typed_info_of_function(&typed, &f))
    when ItemKind::ItemImpl(imp) then
      for m in imp.methods do
        info.push(cqs_typed_info_of_function(&typed, &m))
      end
    when _ then ()
    end
  end
  info
end

def cqs_typed_info_of_function(typed: TypedProgram, f: FunctionDecl) -> CqsTypedInfo
  mut param_names = Vec::new()
  for p in f.params do
    match p.ty
    when Option::Some(ty) then param_names.push(cqs_type_expr_name(&ty))
    when Option::None then param_names.push("?".to_string())
    end
  end
  let ret = match f.ret_type
  when Option::Some(ty) then cqs_type_expr_name(&ty)
  when Option::None then "unit".to_string()
  end
  let type_str = "fn " + f.name.clone() + "(" + cqs_join_strings(&param_names, ", ") + ") -> " + ret
  CqsTypedInfo {
    symbol_id: sha256("tg.symbol.v1" + "::" + f.name.clone() + cqs_symbol_kind_ordinal(SymbolKind::Function).to_string()),
    name: f.name.clone(),
    kind: SymbolKind::Function,
    type_str: type_str,
    param_count: f.params.len(),
    generic_count: f.generic_params.len(),
    typed_expr_count: cqs_count_typed_exprs(&typed, &f.body),
    span: cqs_span_to_rich(&f.span)
  }
end

def cqs_type_expr_name(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when TypeExprKind::Unit then "unit".to_string()
  when TypeExprKind::Never then "never".to_string()
  when TypeExprKind::Tuple(_) then "tuple".to_string()
  when TypeExprKind::Array(_, _) then "array".to_string()
  when TypeExprKind::Slice(_) then "slice".to_string()
  when TypeExprKind::Ptr(_) then "ptr".to_string()
  when TypeExprKind::PtrMut(_) then "ptr_mut".to_string()
  when TypeExprKind::Ref(_, _) then "ref".to_string()
  when TypeExprKind::Fn(_, _) then "fn".to_string()
  when TypeExprKind::Async(_) then "async".to_string()
  when TypeExprKind::Effect(_, _) then "effect".to_string()
  when TypeExprKind::Path(_) then "path".to_string()
  when TypeExprKind::Infer then "?".to_string()
  end
end

def cqs_count_typed_exprs(typed: TypedProgram, body: FnBody) -> Int
  mut count = 0
  match body
  when FnBody::FnBlock(block) then cqs_count_typed_in_block(&typed, &block, count)
  when FnBody::FnExpr(e) then cqs_count_typed_in_expr(&typed, &e, count)
  when _ then ()
  end
  count
end

def cqs_count_typed_in_block(typed: TypedProgram, block: Block, inout count: Int) -> Unit
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtExpr(expr) then cqs_count_typed_in_expr(&typed, &expr, count)
    when StmtKind::StmtLet(_, _, init, _) then cqs_count_typed_in_expr(&typed, &init, count)
    when StmtKind::StmtAssign(target, value) then
      cqs_count_typed_in_expr(&typed, &target, count)
      cqs_count_typed_in_expr(&typed, &value, count)
    when StmtKind::StmtFor(for_stmt) then
      cqs_count_typed_in_expr(&typed, &for_stmt.iter, count)
      cqs_count_typed_in_block(&typed, &for_stmt.body, count)
    when StmtKind::StmtWhile(cond, body) then
      cqs_count_typed_in_expr(&typed, &cond, count)
      cqs_count_typed_in_block(&typed, &body, count)
    when StmtKind::StmtLoop(body) then
      cqs_count_typed_in_block(&typed, &body, count)
    when StmtKind::StmtReturn(val) then
      match val
      when Option::Some(v) then cqs_count_typed_in_expr(&typed, &v, count)
      when Option::None then ()
      end
    when _ then ()
    end
  end
end

def cqs_count_typed_in_expr(typed: TypedProgram, expr: Expr, inout count: Int) -> Unit
  if typed.expr_types.contains_key(&expr.node_id) then
    count = count + 1
  end
  match expr.kind
  when ExprKind::ExprBinaryOp(_, left, right) then
    cqs_count_typed_in_expr(&typed, &left, count)
    cqs_count_typed_in_expr(&typed, &right, count)
  when ExprKind::ExprUnaryOp(_, operand) then
    cqs_count_typed_in_expr(&typed, &operand, count)
  when ExprKind::ExprCall(callee, args) then
    cqs_count_typed_in_expr(&typed, &callee, count)
    for a in args do
      cqs_count_typed_in_expr(&typed, &a, count)
    end
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    cqs_count_typed_in_expr(&typed, &receiver, count)
    for a in args do
      cqs_count_typed_in_expr(&typed, &a, count)
    end
  when ExprKind::ExprFieldAccess(obj, _) then
    cqs_count_typed_in_expr(&typed, &obj, count)
  when ExprKind::ExprIndex(arr, idx) then
    cqs_count_typed_in_expr(&typed, &arr, count)
    cqs_count_typed_in_expr(&typed, &idx, count)
  when ExprKind::ExprIf(if_stmt) then
    cqs_count_typed_in_expr(&typed, &if_stmt.cond, count)
    cqs_count_typed_in_block(&typed, &if_stmt.then_block, count)
    match if_stmt.else_block
    when Option::Some(e) then cqs_count_typed_in_block(&typed, &e, count)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    cqs_count_typed_in_expr(&typed, &m.scrutinee, count)
    for arm in m.arms do
      cqs_count_typed_in_block(&typed, &arm.body, count)
    end
  when ExprKind::ExprClosure(_, _, body) then
    cqs_count_typed_in_expr(&typed, &body, count)
  when ExprKind::ExprAssign(target, value) then
    cqs_count_typed_in_expr(&typed, &target, count)
    cqs_count_typed_in_expr(&typed, &value, count)
  when ExprKind::ExprBlock(block) then
    cqs_count_typed_in_block(&typed, &block, count)
  when _ then ()
  end
end

def cqs_span_to_rich(span: Span) -> RichSpan
  RichSpan {
    file: span.file.clone(),
    start_line: span.start,
    start_col: 0,
    end_line: span.end_pos,
    end_col: 0
  }
end

def cqs_join_strings(parts: Vec[String], sep: String) -> String
  var out = "".to_string()
  var i = 0
  while i < parts.len() do
    if i > 0 then
      out = out + sep.clone()
    end
    out = out + parts[i].clone()
    i = i + 1
  end
  out
end

pub def cqs_query_diagnostics(
  mir: MirProgram,
  symbols: Vec[Symbol],
  mode: Mode,
  config_hash: String
) -> Vec[Diagnostic]
  let report = run_cqs_analysis(&symbols, &mir.functions, mode, config_hash)
  mut out = Vec::new()
  for module in report.modules do
    for sr in module.symbols do
      let action = enforcement_action(sr.surface_class, mode, sr.score.clamped)
      match action
      when EnforcementAction::Error then
        cqs_collect_signal_diagnostics(&sr, &mir.functions, mode, DiagLevel::Error, &mut out)
      when EnforcementAction::Warn then
        cqs_collect_signal_diagnostics(&sr, &mir.functions, mode, DiagLevel::Warning, &mut out)
      when _ then ()
      end
    end
  end
  out.sort_by(|a, b| cqs_diag_sort_lt(a, b))
  out
end

def cqs_collect_signal_diagnostics(
  sr: SymbolReport,
  mir_functions: Vec[MirFunction],
  mode: Mode,
  level: DiagLevel,
  inout out: Vec[Diagnostic]
) -> Unit
  for signal in sr.signals do
    if signal.suppressed then next end
    # The deterministic suppression policy — conservative inputs at the
    # query boundary (no cfg/future context, no unit-return context).
    if should_suppress(signal.kind, sr.surface_class, false, false, false, mode) then next end
    out.push(Diagnostic {
      level: level,
      message: cqs_signal_message(&signal, &sr.name),
      span: cqs_diag_span_for_function(&mir_functions, &sr.name),
      notes: Vec::new(),
      suggestions: Vec::new(),
      code: Option::Some("CQS-" + cqs_signal_code(signal.kind))
    })
  end
end

def cqs_diag_span_for_function(mir_functions: Vec[MirFunction], name: String) -> Option[Span]
  # The real byte span of the symbol's lowered function: the first
  # statement's span (the terminator's when the function is statement-
  # free) — the query results carry REAL source positions, never
  # synthetic ones.
  match find_mir_function(mir_functions, name)
  when Option::Some(func) then
    if func.blocks.is_empty() then
      return Option::None
    end
    for block in func.blocks do
      if !block.statements.is_empty() then
        return Option::Some(block.statements[0].span)
      end
    end
    Option::Some(func.blocks[0].terminator.span)
  when Option::None then Option::None
  end
end

def cqs_signal_message(signal: Signal, name: String) -> String
  "CQS-" + cqs_signal_code(signal.kind) + ": " + cqs_signal_title(signal.kind) +
    " (" + signal.count.to_string() + " occurrence(s) in '" + name + "')"
end

def cqs_signal_title(kind: SignalKind) -> String
  match kind
  when SignalKind::CF1_UnreachableBranch then "unreachable branch"
  when SignalKind::CF2_NonExhaustiveMatch then "non-exhaustive match"
  when SignalKind::CF3_PanicUnreachableExit then "panic/unreachable as normal exit"
  when SignalKind::CF4_ConstantReturnDominance then "constant-return dominance"
  when SignalKind::DF1_UnusedParameter then "unused parameter"
  when SignalKind::DF2_OutputIndependentOfInputs then "output independent of inputs"
  when SignalKind::DF3_DeadAssignment then "dead assignment"
  when SignalKind::DF4_AllBranchesReturnSameLiteral then "all branches return the same literal"
  when SignalKind::EH1_IgnoredResultWithoutJustification then "ignored result without justification"
  when SignalKind::EH2_CatchAllWithoutAction then "catch-all without action"
  when SignalKind::EH3_BroadExceptionBoundarySwallowing then "broad exception-boundary swallowing"
  when SignalKind::CV1_UnexecutedPublicBranch then "unexecuted public branch"
  when SignalKind::CV2_CoverageBelowThreshold then "coverage below threshold"
  when SignalKind::CP1_CapabilityDrift then "capability drift"
  when SignalKind::CP2_UnsafeBlockWithoutReason then "unsafe block without reason"
  when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then "tainted FFI value used without validation"
  when SignalKind::FT1_FutureBlockInEnabledFeature then "future block in an enabled feature"
  when SignalKind::FT2_CfgFeatureEnabledButIncomplete then "cfg feature enabled but incomplete"
  end
end

def cqs_signal_code(kind: SignalKind) -> String
  match kind
  when SignalKind::CF1_UnreachableBranch then "CF1"
  when SignalKind::CF2_NonExhaustiveMatch then "CF2"
  when SignalKind::CF3_PanicUnreachableExit then "CF3"
  when SignalKind::CF4_ConstantReturnDominance then "CF4"
  when SignalKind::DF1_UnusedParameter then "DF1"
  when SignalKind::DF2_OutputIndependentOfInputs then "DF2"
  when SignalKind::DF3_DeadAssignment then "DF3"
  when SignalKind::DF4_AllBranchesReturnSameLiteral then "DF4"
  when SignalKind::EH1_IgnoredResultWithoutJustification then "EH1"
  when SignalKind::EH2_CatchAllWithoutAction then "EH2"
  when SignalKind::EH3_BroadExceptionBoundarySwallowing then "EH3"
  when SignalKind::CV1_UnexecutedPublicBranch then "CV1"
  when SignalKind::CV2_CoverageBelowThreshold then "CV2"
  when SignalKind::CP1_CapabilityDrift then "CP1"
  when SignalKind::CP2_UnsafeBlockWithoutReason then "CP2"
  when SignalKind::CP3_TaintedFFIValueUsedWithoutValidation then "CP3"
  when SignalKind::FT1_FutureBlockInEnabledFeature then "FT1"
  when SignalKind::FT2_CfgFeatureEnabledButIncomplete then "FT2"
  end
end

def cqs_diag_sort_lt(a: Diagnostic, b: Diagnostic) -> Bool
  cqs_diag_sort_key(&a) < cqs_diag_sort_key(&b)
end

def cqs_diag_sort_key(d: Diagnostic) -> String
  let code = match d.code
  when Option::Some(c) then c.clone()
  when Option::None then "".to_string()
  end
  let start = match d.span
  when Option::Some(s) then s.start.to_string()
  when Option::None then "".to_string()
  end
  code + ":" + start + ":" + d.message.clone()
end

def generate_suggested_actions_from_signals(signals: Vec[Signal], mode: Mode) -> Vec[SuggestedAction]
  mut actions = Vec::new()
  for signal in signals
    if signal.suppressed then next end
    match signal.kind
    when SignalKind::CF2_NonExhaustiveMatch then
      actions.push(SuggestedAction {
        action_id: "add_missing_arms",
        priority: 1,
        title: "Add missing match arms",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 1.0
      })
    when SignalKind::EH1_IgnoredResultWithoutJustification then
      actions.push(SuggestedAction {
        action_id: "handle_result",
        priority: 2,
        title: "Propagate with ? or handle Result",
        patches: Vec::new(),
        tests_to_run: Vec::new(),
        confidence: 0.9
      })
    when _ then ()
    end
  end
  actions
end
