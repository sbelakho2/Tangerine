def load_call_arg_value(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, arg: MirCallArg, dst: PhysReg) -> Unit
  match arg.value
  when MirCallValue::Value(op) then load_operand_call_arg(ctx, fctx, op, dst)
  when MirCallValue::Place(p) then emit_place_address(ctx, fctx, p, dst)
  end  end
end

