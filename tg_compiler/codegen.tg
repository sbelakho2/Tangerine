    when _ then panic("emit_xor: mixed arch")
    end
  end  end
end

# Shifts
def emit_shl(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_mov_rr(&mut ctx.text, X64::RCX, xm)
        x64_shl_rcl(&mut ctx.text, xd)
      when _ then panic("emit_shl: mixed arch")
      end
    when _ then panic("emit_shl: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then emit32_le(&mut ctx.text, 0x9AC02000 | (a64_code(am) << 16) | (a64_code(an) << 5) | a64_code(ad))
      when _ then panic("emit_shl: mixed arch")
      end
    when _ then panic("emit_shl: mixed arch")
    end
  end  end
end

def emit_shr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_mov_rr(&mut ctx.text, X64::RCX, xm)
        x64_shr_rcl(&mut ctx.text, xd)
      when _ then panic("emit_shr: mixed arch")
      end
    when _ then panic("emit_shr: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then emit32_le(&mut ctx.text, 0x9AC02800 | (a64_code(am) << 16) | (a64_code(an) << 5) | a64_code(ad))
      when _ then panic("emit_shr: mixed arch")
      end
    when _ then panic("emit_shr: mixed arch")
    end
  end  end
end

# NEG reg
def emit_neg(inout ctx: CodegenCtx, d: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then x64_neg_r(&mut ctx.text, xd)
  when PhysReg::A64Reg(ad) then
    # NEG Xd, Xd  ≡  SUB Xd, XZR, Xd
    a64_sub_rrr(&mut ctx.text, ad, A64::XZR, ad)
  end  end
end

# NOT reg (bitwise)
def emit_not(inout ctx: CodegenCtx, d: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then x64_not_r(&mut ctx.text, xd)
  when PhysReg::A64Reg(ad) then
    # MVN Xd, Xd  ≡  ORN Xd, XZR, Xd
    emit32_le(&mut ctx.text, 0xAA200000 | (a64_code(ad) << 16) | (31 << 5) | a64_code(ad))
  end  end
end

# CMP reg, reg
def emit_cmp_rr(inout ctx: CodegenCtx, a: PhysReg, b: PhysReg) -> Unit
  match a
  when PhysReg::X64Reg(xa) then
    match b
    when PhysReg::X64Reg(xb) then x64_cmp_rr(&mut ctx.text, xa, xb)
    when _ then panic("emit_cmp: mixed arch")
    end
  when PhysReg::A64Reg(aa) then
    match b
    when PhysReg::A64Reg(ab) then a64_cmp_rr(&mut ctx.text, aa, ab)
    when _ then panic("emit_cmp: mixed arch")
    end
  end  end
end

# CMP reg, imm
def emit_cmp_ri(inout ctx: CodegenCtx, r: PhysReg, imm: i32) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_cmp_ri(&mut ctx.text, xr, imm)
  when PhysReg::A64Reg(ar) then a64_cmp_ri(&mut ctx.text, ar, imm as u32)
  end  end
end

# TEST reg, reg (x86) / TST reg, reg (arm64)
def emit_test_rr(inout ctx: CodegenCtx, a: PhysReg, b: PhysReg) -> Unit
  match a
  when PhysReg::X64Reg(xa) then
    match b
    when PhysReg::X64Reg(xb) then x64_test_rr(&mut ctx.text, xa, xb)
    when _ then panic("emit_test: mixed arch")
    end
  when PhysReg::A64Reg(aa) then
    match b
    when PhysReg::A64Reg(ab) then emit32_le(&mut ctx.text, 0xEA00001F | (a64_code(ab) << 16) | (a64_code(aa) << 5))
    when _ then panic("emit_test: mixed arch")
    end
  end  end
end

# Set register to 0 or 1 based on condition after CMP
enum CondKind
  Eq; Ne; Lt; Le; Gt; Ge
end

def emit_setcc(inout ctx: CodegenCtx, cond: CondKind, dst: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xr) then
    let cc = match cond
    when CondKind::Eq then CC::E
    when CondKind::Ne then CC::NE
    when CondKind::Lt then CC::L
    when CondKind::Le then CC::LE
    when CondKind::Gt then CC::G
    when CondKind::Ge then CC::GE
    end
    x64_setcc(&mut ctx.text, cc, xr)
    x64_movzx_r64_r8(&mut ctx.text, xr, xr)
  when PhysReg::A64Reg(ar) then
    let arm_cond = match cond
    when CondKind::Eq then a64_cc_eq()
    when CondKind::Ne then a64_cc_ne()
    when CondKind::Lt then a64_cc_lt()
    when CondKind::Le then a64_cc_le()
    when CondKind::Gt then a64_cc_gt()
    when CondKind::Ge then a64_cc_ge()
    end
    a64_cset(&mut ctx.text, ar, arm_cond)
  end  end
end

# Unconditional jump to label
def emit_jmp(inout ctx: CodegenCtx, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_jmp(&mut ctx.text, label)
  when Arch::AArch64 then a64_b(&mut ctx.text, label)
  end  end
end

# Conditional jump (eq/ne after TEST or CMP)
def emit_jcc(inout ctx: CodegenCtx, cond: CondKind, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64 then
    let cc = match cond
    when CondKind::Eq then CC::E
    when CondKind::Ne then CC::NE
    when CondKind::Lt then CC::L
    when CondKind::Le then CC::LE
    when CondKind::Gt then CC::G
    when CondKind::Ge then CC::GE
    end
    x64_jcc(&mut ctx.text, cc, label)
  when Arch::AArch64 then
    let arm_cond = match cond
    when CondKind::Eq then a64_cc_eq()
    when CondKind::Ne then a64_cc_ne()
    when CondKind::Lt then a64_cc_lt()
    when CondKind::Le then a64_cc_le()
    when CondKind::Gt then a64_cc_gt()
    when CondKind::Ge then a64_cc_ge()
    end
    a64_bcond(&mut ctx.text, arm_cond, label)
  end  end
end

# CALL label (local or external)
def emit_call_label(inout ctx: CodegenCtx, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_call_label(&mut ctx.text, label)
  when Arch::AArch64 then a64_bl(&mut ctx.text, label)
  end  end
end

def emit_call_extern(inout ctx: CodegenCtx, sym: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64 then x64_call_extern(&mut ctx.text, sym)
  when Arch::AArch64 then
    # Needs relocation for external calls
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_CALL26, sym, 0)
    emit32_le(&mut ctx.text, 0x94000000)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Extern ABI return normalization (the 32-bit boundary)
# ———————————————————————————————————————————————————————————————
# A C function returns `int`/`unsigned int` in the LOW 32 bits of the
# return register (eax on x86-64, w0 on AArch64). The upper 32 bits are
# unspecified: x86-64 guarantees only eax, and AArch64 zero-extends
# w0 -> x0. A C -1 (0xFFFFFFFF in eax/w0) must therefore be explicitly
# SIGN-extended (I32) — or zero-extended (U32) — before the post-call
# store, or the caller's `< 0` check / `as Int` widening sees
# +4294967295 instead of -1. Full-width returns (Int/I64/U64/pointers)
# are already exact and pass through unchanged; the extension is
# idempotent for properly-formed values.
def normalize_extern_return(inout ctx: CodegenCtx, rr: PhysReg, dest_ty: Type) -> Unit
  match dest_ty
  when Type::I32 then
    match ctx.target.arch
    when Arch::X86_64 then
      match rr
      when PhysReg::X64Reg(r) then x64_movsxd(&mut ctx.text, r, r)
      when _ then ()
      end
    when Arch::AArch64 then
      match rr
      when PhysReg::A64Reg(r) then a64_sxtw(&mut ctx.text, r, r)
      when _ then ()
      end
    end
  when Type::U32 then
    match ctx.target.arch
    when Arch::X86_64 then
      match rr
      when PhysReg::X64Reg(r) then x64_mov_r32(&mut ctx.text, r, r)
      when _ then ()
      end
    when Arch::AArch64 then
      # Writing w0 zero-extends into x0 on AArch64 — already normalized.
      ()
    end
  when _ then ()
  end  end
end

# ———————————————————————————————————————————————————————————————
# GCC __sync_* atomic builtins → inline ARMv8.1 LSE atomics
# ———————————————————————————————————————————————————————————————
# These names look like external functions but are actually compiler builtins
# that must be emitted inline. There is no `__sync_*` symbol in libSystem
# or any system library. Without inlining, the linker would reject every
# allocator/Rc/Arc operation.
#
# LSE CONTRACT (explicit — see asm.tg's target feature table): the AArch64
# RMWs emitted below — the LDADDAL/CASAL/SWPAL family — require the ARMv8.1
# LSE extension. The aarch64 target's contract is LSE-REQUIRED (Apple
# Silicon, Neoverse, Cortex-A75+ — the modern baseline); a bare ARMv8.0
# core without LSE is not a supported target. The ldaxr/stlxr LL/SC loops
# are the FUTURE portable mode (a runtime/target-flag dispatch), not the
# current emission. x86-64 needs no note: the LOCKed prefix is baseline.
#
# Returns true if the call was intercepted and emitted inline; false otherwise.
def try_emit_atomic_builtin(inout ctx: CodegenCtx, name: String) -> Bool
  # The compiler/runtime atomic intrinsics — the ONE atomic authority.
  # std::atomic AND std::sync route every atomic operation through the
  # __intrinsic_atomic_* family (emit_atomic_intrinsic below — the inline
  # LDAR/STLR/LSE atomics on AArch64, the LOCKed xchg/xadd/cmpxchg on
  # x86). A fence does NOT turn a non-atomic access into an atomic one,
  # so the fence-around-ordinary-access pattern is never the authority.
  if name.starts_with("__intrinsic_atomic_") then
    return emit_atomic_intrinsic(ctx, &name)
  end
  match ctx.target.arch
  when Arch::AArch64 then
    if name == "__sync_synchronize" then
      a64_dmb_ish(&mut ctx.text)
      true
    else if name == "__sync_bool_compare_and_swap_1" then
      # x0=ptr, w1=expected, w2=desired → x0 = 1 if swapped else 0
      # CASALB clobbers Ws (w8) with original [x0]; preserve expected in w1
      a64_mov_w_rr(&mut ctx.text, A64::X8, A64::X1)   # mov w8, w1
      a64_casalb(&mut ctx.text, A64::X8, A64::X2, A64::X0)  # casalb w8, w2, [x0]
      a64_cmp_w(&mut ctx.text, A64::X8, A64::X1)      # cmp w8, w1
      a64_cset_eq(&mut ctx.text, A64::X0)             # cset x0, eq
      true
    else if name == "__sync_val_compare_and_swap_uint" || name == "__sync_val_compare_and_swap_4" then
      # 32-bit CAS, returns original value
      a64_mov_w_rr(&mut ctx.text, A64::X8, A64::X1)
      a64_casal_w(&mut ctx.text, A64::X8, A64::X2, A64::X0)
      a64_mov_w_rr(&mut ctx.text, A64::X0, A64::X8)
      true
    else if name == "__sync_val_compare_and_swap_8" then
      # 64-bit CAS
      a64_mov_rr(&mut ctx.text, A64::X8, A64::X1)
      a64_casal_x(&mut ctx.text, A64::X8, A64::X2, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X8)
      true
    else if name == "__sync_fetch_and_sub_4" then
      # 32-bit atomic subtract: prev = *ptr; *ptr -= val; return prev
      # LDADDAL reads from [Xn] into Wt, atomically adds Ws to memory.
      # Avoid Wt aliasing Xn (UNPREDICTABLE) — use w9 as the dest.
      a64_neg_w(&mut ctx.text, A64::X8, A64::X1)              # w8 = -val
      a64_ldaddal_w(&mut ctx.text, A64::X8, A64::X9, A64::X0) # ldaddal w8, w9, [x0]
      a64_mov_w_rr(&mut ctx.text, A64::X0, A64::X9)           # mov w0, w9
      true
    else if name == "__sync_fetch_and_sub_8" || name == "__sync_fetch_and_sub" then
      # 64-bit atomic subtract
      a64_neg(&mut ctx.text, A64::X8, A64::X1)                # x8 = -val
      a64_ldaddal_x(&mut ctx.text, A64::X8, A64::X9, A64::X0) # ldaddal x8, x9, [x0]
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)             # mov x0, x9
      true
    else if name == "__sync_fetch_and_add_4" then
      a64_mov_w_rr(&mut ctx.text, A64::X8, A64::X1)
      a64_ldaddal_w(&mut ctx.text, A64::X8, A64::X9, A64::X0)
      a64_mov_w_rr(&mut ctx.text, A64::X0, A64::X9)
      true
    else if name == "__sync_fetch_and_add_8" || name == "__sync_fetch_and_add" then
      a64_mov_rr(&mut ctx.text, A64::X8, A64::X1)
      a64_ldaddal_x(&mut ctx.text, A64::X8, A64::X9, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
      true
    else
      false
    end
  when Arch::X86_64 then
    # x86-64 __sync_* builtins: TSO makes plain MOVs acquire/release; the
    # RMW/CAS family uses the LOCKed forms (xadd/xchg/cmpxchg) and the
    # fence is MFENCE. AArch64 and x86 now share the same __sync_*
    # surface, so the allocator/Rc/Arc code compiles on both arches.
    if name == "__sync_synchronize" then
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xAE)
      emit8(&mut ctx.text, 0xF0)   # mfence
      true
    else if name == "__sync_bool_compare_and_swap_1" then
      # rdi = ptr, rsi = expected (by value), rdx = desired
      let lbl_fail = ".Lsync_cas1_fail." + ctx.fn_counter.to_string()
      let lbl_done = ".Lsync_cas1_done." + ctx.fn_counter.to_string()
      ctx.fn_counter = ctx.fn_counter + 1
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov eax, esi
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xB0)
      emit8(&mut ctx.text, 0x17)   # lock cmpxchg byte [rdi], dl
      x64_jcc(&mut ctx.text, CC::NE, lbl_fail.clone())
      x64_mov_ri(&mut ctx.text, X64::RAX, 1)
      x64_jmp(&mut ctx.text, lbl_done.clone())
      def_label(&mut ctx.text, lbl_fail.clone())
      x64_xor_rr(&mut ctx.text, X64::RAX, X64::RAX)
      def_label(&mut ctx.text, lbl_done.clone())
      true
    else if name == "__sync_val_compare_and_swap_4" || name == "__sync_val_compare_and_swap_uint" then
      # 32-bit CAS: rax = expected; lock cmpxchg leaves the old value in rax.
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov eax, esi
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xB1)
      emit8(&mut ctx.text, 0x17)   # lock cmpxchg [rdi], edx
      true
    else if name == "__sync_val_compare_and_swap_8" then
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov rax, rsi
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xB1)
      emit8(&mut ctx.text, 0x17)   # lock cmpxchg [rdi], rdx
      true
    else if name == "__sync_fetch_and_add_4" then
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xC1)
      emit8(&mut ctx.text, 0x37)   # lock xadd [rdi], esi
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov eax, esi (old)
      true
    else if name == "__sync_fetch_and_add_8" || name == "__sync_fetch_and_add" then
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xC1)
      emit8(&mut ctx.text, 0x37)   # lock xadd [rdi], rsi
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov rax, rsi (old)
      true
    else if name == "__sync_fetch_and_sub_4" then
      x64_neg_r(&mut ctx.text, X64::RSI)
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xC1)
      emit8(&mut ctx.text, 0x37)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)
      true
    else if name == "__sync_fetch_and_sub_8" || name == "__sync_fetch_and_sub" then
      x64_neg_r(&mut ctx.text, X64::RSI)
      emit8(&mut ctx.text, 0xF0)
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0xC1)
      emit8(&mut ctx.text, 0x37)
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)
      true
    else if name == "__sync_lock_test_and_set_4" then
      emit8(&mut ctx.text, 0x87)
      emit8(&mut ctx.text, 0x37)   # xchg [rdi], esi (implicitly locked)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)   # mov eax, esi (old)
      true
    else if name == "__sync_lock_test_and_set_8" then
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x87)
      emit8(&mut ctx.text, 0x37)
      emit8(&mut ctx.text, 0x48)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0xF0)
      true
    else
      false
    end
  when _ then
    false
  end
end

# ———————————————————————————————————————————————————————————————
# The compiler/runtime atomic intrinsics — the ONE atomic authority
# ———————————————————————————————————————————————————————————————
# Every atomic operation in the std (std::atomic's AtomicBool/Int/UInt/
# U8/U64/Ptr AND std::sync's AtomicBool/U32/U64/Ptr) routes through the
# __intrinsic_atomic_* family emitted here — the load/store/RMW/CAS/
# fence per width 1/2/4/8 on both arches. These inline instructions ARE
# the atomicity; a fence around an ordinary access is never used.
#
# Name shape: __intrinsic_atomic_<op>_u<width> with width 8/16/32/64
# (bits) and op in { load, store, exchange, compare_exchange, fetch_add,
# fetch_sub, fetch_and, fetch_or, fetch_xor, add_fetch, sub_fetch,
# and_fetch, or_fetch, xor_fetch }; __intrinsic_atomic_fence is the
# memory fence.
#
# ABI: the general call machinery has already loaded the args into the
# argument registers — x0/rdi = ptr, x1/rsi = value (or order for load),
# x2/rdx = order/desired, x3/rcx = weak, x4/r8 = success_order, x5/r9 =
# failure_order. Order codes (ordering_to_c in std::atomic): 0 = Relaxed
# ... 5 = SeqCst. AArch64 emits the strongest form unconditionally
# (LDAR/STLR/LSE-al — correct for every ordering). x86-64 reads the
# ordering where it matters: the SeqCst STORE is the xchg-based store
# (the implicitly-locked exchange) while the weaker stores are plain
# MOVs (TSO gives a plain store the release semantics); the SeqCst LOAD
# stays the plain MOV — the total order is TSO + the xchg-store
# discipline. The compare_exchange `expected` argument is the ADDRESS of
# the expected slot (in/out: the current value is written back on
# failure).
#
# LSE CONTRACT: the AArch64 RMWs (LDADDAL/CASAL/SWPAL — the LSE-al family
# below) require the ARMv8.1 LSE extension; the aarch64 target's contract
# is LSE-REQUIRED (see asm.tg's target feature table — the driver's
# --target documentation). The LL/SC (ldaxr/stlxr) fallback is the future
# portable mode, not the current emission.
def emit_atomic_intrinsic(inout ctx: CodegenCtx, name: String) -> Bool
  let (op, width) = atomic_intrinsic_op_and_width(name)
  match ctx.target.arch
  when Arch::AArch64 then emit_atomic_intrinsic_a64(ctx, &op, width)
  when Arch::X86_64  then emit_atomic_intrinsic_x64(ctx, &op, width)
  when _ then ()
  end
  true
end

# Parse "__intrinsic_atomic_<op>_u<width>" -> (op, width-bytes); the
# fence (no width suffix) returns width 0.
def atomic_intrinsic_op_and_width(name: String) -> (String, Int)
  let prefix = "__intrinsic_atomic_"
  if !name.starts_with(prefix) then
    return ("", 0)
  end
  var rest = name.slice(prefix.len(), name.len())
  match rest.find("_u")
  when Option::Some(pos) then
    let op = rest.slice(0, pos)
    let wstr = rest.slice(pos + 2, rest.len())
    let width = match wstr
    when "8" then 1
    when "16" then 2
    when "32" then 4
    when "64" then 8
    when _ then 0
    end
    (op, width)
  when Option::None then
    (rest, 0)
  end
end

# Size-scaled AArch64 atomic encodings (size in bits [31:30]).
def a64_ldar_enc(width: Int) -> u32
  match width
  when 1 then 0x08DFFC00
  when 2 then 0x48DFFC00
  when 4 then 0x88DFFC00
  when 8 then 0xC8DFFC00
  when _ then 0x00000000
  end  end
end

def a64_stlr_enc(width: Int) -> u32
  match width
  when 1 then 0x001F7C00
  when 2 then 0x401F7C00
  when 4 then 0x801F7C00
  when 8 then 0xC01F7C00
  when _ then 0x00000000
  end  end
end

def a64_ldaddal_enc(width: Int) -> u32
  match width
  when 1 then 0x38E00000
  when 2 then 0x78E00000
  when 4 then 0xB8E00000
  when 8 then 0xF8E00000
  when _ then 0x00000000
  end  end
end

def a64_ldclral_enc(width: Int) -> u32
  match width
  when 1 then 0x38E01000
  when 2 then 0x78E01000
  when 4 then 0xB8E01000
  when 8 then 0xF8E01000
  when _ then 0x00000000
  end  end
end

def a64_ldeoral_enc(width: Int) -> u32
  match width
  when 1 then 0x38E02000
  when 2 then 0x78E02000
  when 4 then 0xB8E02000
  when 8 then 0xF8E02000
  when _ then 0x00000000
  end  end
end

def a64_ldsetal_enc(width: Int) -> u32
  match width
  when 1 then 0x38E03000
  when 2 then 0x78E03000
  when 4 then 0xB8E03000
  when 8 then 0xF8E03000
  when _ then 0x00000000
  end  end
end

def a64_swpal_enc(width: Int) -> u32
  match width
  when 1 then 0x38E08000
  when 2 then 0x78E08000
  when 4 then 0xB8E08000
  when 8 then 0xF8E08000
  when _ then 0x00000000
  end  end
end

def a64_casal_enc(width: Int) -> u32
  match width
  when 1 then 0x08E0FC00
  when 2 then 0x48E0FC00
  when 4 then 0x88E0FC00
  when 8 then 0xC8E0FC00
  when _ then 0x00000000
  end  end
end

# Move the RMW result out of the scratch register (64-bit for width 8,
# 32-bit zero-extending move otherwise — the LSE ops zero-extend bytes/
# halfwords/words into the W register).
def a64_emit_mov_result(inout ctx: CodegenCtx, width: Int, src: A64) -> Unit
  if width == 8 then
    a64_mov_rr(&mut ctx.text, A64::X0, src)
  else
    a64_mov_w_rr(&mut ctx.text, A64::X0, src)
  end
end

def emit_atomic_intrinsic_a64(inout ctx: CodegenCtx, op: String, width: Int) -> Unit
  match op
  when "fence" then
    a64_dmb_ish(&mut ctx.text)
  when "load" then
    # LDAR (acquire) — correct for every ordering (Relaxed is served
    # stronger, never weaker).
    emit32_le(&mut ctx.text, a64_ldar_enc(width) | (a64_code(A64::X0) << 5) | a64_code(A64::X0))
  when "store" then
    # STLR (release) with the value in x1 — the SeqCst store on
    # AArch64: the LDAR/STLR pair is SC on ARMv8 (a SeqCst store is
    # STLR + the acquire/release pair discipline, exactly what the
    # LDAR/STLR implementation provides), so the ordering argument
    # needs no branch here.
    emit32_le(&mut ctx.text, a64_stlr_enc(width) | (a64_code(A64::X0) << 5) | a64_code(A64::X1))
  when "exchange" then
    # SWPAL w1, w9, [x0] — old value in w9.
    emit32_le(&mut ctx.text, a64_swpal_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "fetch_add" then
    emit32_le(&mut ctx.text, a64_ldaddal_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "fetch_sub" then
    # The subtraction is the atomic add of -v.
    if width == 8 then
      a64_neg(&mut ctx.text, A64::X8, A64::X1)
    else
      a64_neg_w(&mut ctx.text, A64::X8, A64::X1)
    end
    emit32_le(&mut ctx.text, a64_ldaddal_enc(width) | (a64_code(A64::X8) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "fetch_and" then
    emit32_le(&mut ctx.text, a64_ldclral_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "fetch_or" then
    emit32_le(&mut ctx.text, a64_ldsetal_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "fetch_xor" then
    emit32_le(&mut ctx.text, a64_ldeoral_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_emit_mov_result(ctx, width, A64::X9)
  when "add_fetch" then
    emit32_le(&mut ctx.text, a64_ldaddal_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    # new = old + val (the dest store truncates to the width).
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X1)
  when "sub_fetch" then
    if width == 8 then
      a64_neg(&mut ctx.text, A64::X8, A64::X1)
    else
      a64_neg_w(&mut ctx.text, A64::X8, A64::X1)
    end
    emit32_le(&mut ctx.text, a64_ldaddal_enc(width) | (a64_code(A64::X8) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_sub_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X1)
  when "and_fetch" then
    emit32_le(&mut ctx.text, a64_ldclral_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_and_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X1)
  when "or_fetch" then
    emit32_le(&mut ctx.text, a64_ldsetal_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_orr_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X1)
  when "xor_fetch" then
    emit32_le(&mut ctx.text, a64_ldeoral_enc(width) | (a64_code(A64::X1) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    a64_eor_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X1)
  when "compare_exchange" then
    # x0 = ptr, x1 = &expected, x2 = desired. The expected VALUE is
    # loaded from [x1]; on failure the current value is written back.
    let lbl_fail = ".Latomic_cas_fail." + ctx.fn_counter.to_string()
    let lbl_done = ".Latomic_cas_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    match width
    when 1 then a64_ldrb(&mut ctx.text, A64::X8, A64::X1, 0)
    when 2 then a64_ldrh(&mut ctx.text, A64::X8, A64::X1, 0)
    when 4 then a64_ldr_w(&mut ctx.text, A64::X8, A64::X1, 0)
    when 8 then a64_ldr(&mut ctx.text, A64::X8, A64::X1, 0)
    end
    if width == 8 then
      a64_mov_rr(&mut ctx.text, A64::X10, A64::X8)
      a64_mov_rr(&mut ctx.text, A64::X9, A64::X2)
    else
      a64_mov_w_rr(&mut ctx.text, A64::X10, A64::X8)
      a64_mov_w_rr(&mut ctx.text, A64::X9, A64::X2)
    end
    # casal Xs(w8 = expected), Xt(w9 = desired), [x0]; X8 <- original.
    emit32_le(&mut ctx.text, a64_casal_enc(width) | (a64_code(A64::X8) << 16) | (a64_code(A64::X0) << 5) | a64_code(A64::X9))
    if width == 8 then
      a64_cmp_rr(&mut ctx.text, A64::X8, A64::X10)
    else
      a64_cmp_w(&mut ctx.text, A64::X8, A64::X10)
    end
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_fail.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_fail.clone())
    match width
    when 1 then a64_strb(&mut ctx.text, A64::X8, A64::X1, 0)
    when 2 then a64_strh(&mut ctx.text, A64::X8, A64::X1, 0)
    when 4 then a64_str_w(&mut ctx.text, A64::X8, A64::X1, 0)
    when 8 then a64_str(&mut ctx.text, A64::X8, A64::X1, 0)
    end
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    def_label(&mut ctx.text, lbl_done.clone())
  when _ then
    ()
  end  end
end

def emit_atomic_intrinsic_x64(inout ctx: CodegenCtx, op: String, width: Int) -> Unit
  # x86-64: arg regs rdi..r9. Loads are plain MOVs (TSO: loads are
  # acquire). The SeqCst STORE is the xchg-based store (`xchg [rdi],
  # rsi` — the implicitly-locked exchange); the weaker stores
  # (Relaxed/Release/AcqRel) are plain MOVs — TSO gives a plain store
  # the release semantics, so only SeqCst needs the full-strength form
  # (a plain MOV is not a sequentially-consistent store by itself). The
  # SeqCst LOAD stays the plain MOV: TSO + the xchg-store discipline
  # provides the total order. The RMW/CAS family uses the LOCKed forms
  # (seq-cst strength); the fence is MFENCE.
  match op
  when "fence" then
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xAE)
    emit8(&mut ctx.text, 0xF0)   # mfence
  when "load" then
    match width
    when 1 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB6); emit8(&mut ctx.text, 0x07)  # movzx eax, byte [rdi]
    when 2 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB7); emit8(&mut ctx.text, 0x07)  # movzx eax, word [rdi]
    when 4 then emit8(&mut ctx.text, 0x8B); emit8(&mut ctx.text, 0x07)                              # mov eax, [rdi]
    when 8 then x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    end
  when "store" then
    # rdi = ptr, rsi = value, rdx = order (the AtomicOrdering c code
    # the std passes — ordering_to_c in std::atomic: 5 = SeqCst). The
    # SeqCst store is the xchg-based store — `xchg [rdi], rsi`, the
    # implicitly-locked exchange (the usual C++/Rust SeqCst-store
    # implementation; the discarded old value lands in rsi). The weaker
    # orderings (Relaxed/Release/AcqRel) are plain MOVs: on x86 TSO a
    # plain store already has the release semantics, so ONLY the SeqCst
    # store needs the full-strength form — a plain MOV alone is not a
    # sequentially-consistent store. The SeqCst LOAD stays the plain
    # MOV (loads are acquire on TSO): the total order comes from TSO +
    # the xchg-store discipline (a SeqCst store is a full barrier that
    # no later load/store can overtake).
    let lbl_weak = ".Latomic_store_weak." + ctx.fn_counter.to_string()
    let lbl_done = ".Latomic_store_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit8(&mut ctx.text, 0x83)
    emit8(&mut ctx.text, 0xFA)
    emit8(&mut ctx.text, 0x05)   # cmp edx, 5 (SeqCst)
    x64_jcc(&mut ctx.text, CC::NE, lbl_weak.clone())
    match width
    when 1 then emit8(&mut ctx.text, 0x40); emit8(&mut ctx.text, 0x86); emit8(&mut ctx.text, 0x37)  # xchg byte [rdi], sil
    when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    when 4 then emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    when 8 then emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    end
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_weak.clone())
    match width
    when 1 then emit8(&mut ctx.text, 0x40); emit8(&mut ctx.text, 0x88); emit8(&mut ctx.text, 0x37)  # mov byte [rdi], sil
    when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x37)
    when 4 then emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x37)
    when 8 then emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x37)
    end
    def_label(&mut ctx.text, lbl_done.clone())
  when "exchange" then
    match width
    when 1 then emit8(&mut ctx.text, 0x40); emit8(&mut ctx.text, 0x86); emit8(&mut ctx.text, 0x37)
    when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    when 4 then emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    when 8 then emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x87); emit8(&mut ctx.text, 0x37)
    end
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)   # old value
  when "fetch_add" then
    emit_x64_lock_xadd(ctx, width)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)   # old value
  when "fetch_sub" then
    x64_neg_r(&mut ctx.text, X64::RSI)
    emit_x64_lock_xadd(ctx, width)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
  when "fetch_and" | "fetch_or" | "fetch_xor" then
    # CAS retry loop: cur = [rdi]; new = cur OP val; lock cmpxchg.
    # On exit rax = the old value (the compare operand).
    emit_x64_rmw_cas_loop(ctx, width, &op)
  when "add_fetch" then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RSI)   # keep val
    emit_x64_lock_xadd(ctx, width)                  # rsi = old
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)   # new = old + val
  when "sub_fetch" then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RSI)   # keep val
    x64_neg_r(&mut ctx.text, X64::RSI)
    emit_x64_lock_xadd(ctx, width)                  # rsi = old
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_sub_rr(&mut ctx.text, X64::RAX, X64::RCX)   # new = old - val
  when "and_fetch" | "or_fetch" | "xor_fetch" then
    # The CAS loop leaves the NEW value in rcx.
    emit_x64_rmw_cas_loop(ctx, width, &op)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
  when "compare_exchange" then
    # rdi = ptr, rsi = &expected, rdx = desired. The expected VALUE is
    # loaded from [rsi]; on failure the current value is written back.
    let lbl_fail = ".Latomic_cas_fail." + ctx.fn_counter.to_string()
    let lbl_done = ".Latomic_cas_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    match width
    when 1 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB6); emit8(&mut ctx.text, 0x06)  # movzx eax, byte [rsi]
    when 2 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB7); emit8(&mut ctx.text, 0x06)  # movzx eax, word [rsi]
    when 4 then emit8(&mut ctx.text, 0x8B); emit8(&mut ctx.text, 0x06)                              # mov eax, [rsi]
    when 8 then emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x8B); emit8(&mut ctx.text, 0x06)  # mov rax, [rsi]
    end
    match width
    when 1 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB0); emit8(&mut ctx.text, 0x17)  # lock cmpxchg byte [rdi], dl
    when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x17)
    when 4 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x17)
    when 8 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x17)
    end
    x64_jcc(&mut ctx.text, CC::NE, lbl_fail.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_fail.clone())
    match width
    when 1 then emit8(&mut ctx.text, 0x88); emit8(&mut ctx.text, 0x06)  # mov byte [rsi], al
    when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x06)
    when 4 then emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x06)
    when 8 then emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x89); emit8(&mut ctx.text, 0x06)
    end
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RAX)
    def_label(&mut ctx.text, lbl_done.clone())
  when _ then
    ()
  end
end

# lock xadd [rdi], rsi — rsi receives the old value.
def emit_x64_lock_xadd(inout ctx: CodegenCtx, width: Int) -> Unit
  match width
  when 1 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x40); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xC0); emit8(&mut ctx.text, 0x37)  # lock xadd byte [rdi], sil
  when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xC1); emit8(&mut ctx.text, 0x37)
  when 4 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xC1); emit8(&mut ctx.text, 0x37)
  when 8 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xC1); emit8(&mut ctx.text, 0x37)
  end  end
end

# CAS retry loop for the logical RMWs (and/or/xor). rax holds the old
# value on exit; rcx holds the new value (for the *_fetch forms).
def emit_x64_rmw_cas_loop(inout ctx: CodegenCtx, width: Int, op: String) -> Unit
  let lbl_loop = ".Latomic_rmw_loop." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  def_label(&mut ctx.text, lbl_loop.clone())
  match width
  when 1 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB6); emit8(&mut ctx.text, 0x07)  # movzx eax, byte [rdi]
  when 2 then emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB7); emit8(&mut ctx.text, 0x07)
  when 4 then emit8(&mut ctx.text, 0x8B); emit8(&mut ctx.text, 0x07)
  when 8 then x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
  end
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
  if op == "fetch_and" || op == "and_fetch" then
    x64_and_rr(&mut ctx.text, X64::RCX, X64::RSI)
  elsif op == "fetch_or" || op == "or_fetch" then
    x64_or_rr(&mut ctx.text, X64::RCX, X64::RSI)
  else
    x64_xor_rr(&mut ctx.text, X64::RCX, X64::RSI)
  end
  match width
  when 1 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB0); emit8(&mut ctx.text, 0x0F)  # lock cmpxchg byte [rdi], cl
  when 2 then emit8(&mut ctx.text, 0x66); emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x0F)
  when 4 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x0F)
  when 8 then emit8(&mut ctx.text, 0xF0); emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x0F); emit8(&mut ctx.text, 0xB1); emit8(&mut ctx.text, 0x0F)
  end
  x64_jcc(&mut ctx.text, CC::NE, lbl_loop.clone())
end

# CALL reg (indirect)
def emit_call_r(inout ctx: CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_call_r(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then a64_blr(&mut ctx.text, ar)
  end  end
end

# RET
def emit_ret(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_ret(&mut ctx.text)
  when Arch::AArch64 then a64_ret(&mut ctx.text)
  end  end
end

# PUSH reg
def emit_push(inout ctx: CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_push(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then
    # ARM64: STR Xr, [SP, #-16]!  (pre-index, 16-byte aligned)
    a64_stur(&mut ctx.text, ar, A64::SP, -16)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 16)
  end  end
end

# POP reg
def emit_pop(inout ctx: CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_pop(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then
    # ARM64: LDR Xr, [SP], #16  (post-index: load then increment SP by 16)
    a64_ldr_post(&mut ctx.text, ar, A64::SP, 16)
  end  end
end

# LEA reg, [FP + offset]
def emit_lea_fp(inout ctx: CodegenCtx, dst: PhysReg, offset: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_lea_mem(&mut ctx.text, xd, X64::RBP, offset)
  when PhysReg::A64Reg(ad) then
    # Sign-extend i32 to i64 manually (interpreter may zero-extend i32)
    let raw = offset as i64
    var ext = raw
    if (raw & 2147483648) != 0 then
      ext = raw | (-4294967296)
    end
    if ext >= 0 && ext < 4096 then
      a64_add_rri(&mut ctx.text, ad, A64::FP, ext as u32)
    elsif ext < 0 && ext > -4096 then
      let abs_off = -ext
      a64_sub_rri(&mut ctx.text, ad, A64::FP, abs_off as u32)
    elsif ext < 0 then
      # Large negative offset: load positive abs, then SUB from FP
      let abs_off = -ext
      a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
      a64_sub_rrr(&mut ctx.text, ad, A64::FP, A64::X15)
    else
      # Large positive offset: load value, then ADD to FP
      a64_mov_ri(&mut ctx.text, ad, ext)
      a64_add_rrr(&mut ctx.text, ad, A64::FP, ad)
    end
  end  end
end

# LEA reg, [rip + label] (x86) / ADRP+ADD (arm64)
def emit_lea_label(inout ctx: CodegenCtx, dst: PhysReg, label: String) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_lea_rip(&mut ctx.text, xd, label)
  when PhysReg::A64Reg(ad) then
    # ADRP + ADD (needs page-relative relocations)
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, label.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000 | a64_code(ad))  # ADRP
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, label, 0)
    a64_add_rri(&mut ctx.text, ad, ad, 0)  # ADD lo12 (patched by relocation)
  end  end
end

# UD2 / UDF (trap)
def emit_trap(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_ud2(&mut ctx.text)
  when Arch::AArch64 then a64_udf(&mut ctx.text)
  end  end
end

# NOP
def emit_nop(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_nop(&mut ctx.text)
  when Arch::AArch64 then a64_nop(&mut ctx.text)
  end  end
end

# ADD reg, imm
def emit_add_ri(inout ctx: CodegenCtx, dst: PhysReg, imm: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_add_ri(&mut ctx.text, xd, imm)
  when PhysReg::A64Reg(ad) then
    if imm >= 0 then
      a64_add_rri(&mut ctx.text, ad, ad, imm as u32)
    else
      a64_sub_rri(&mut ctx.text, ad, ad, (-imm) as u32)
    end
  end  end
end

# SUB reg, imm
def emit_sub_ri(inout ctx: CodegenCtx, dst: PhysReg, imm: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_sub_ri(&mut ctx.text, xd, imm)
  when PhysReg::A64Reg(ad) then
    if imm >= 0 then
      a64_sub_rri(&mut ctx.text, ad, ad, imm as u32)
    else
      a64_add_rri(&mut ctx.text, ad, ad, (-imm) as u32)
    end
  end  end
end

# ———————————————————————————————————————————————————————————————
# Block label naming
# ———————————————————————————————————————————————————————————————

def block_label(fn_name: String, block_id: Int) -> String
  ".L" + fn_name + ".bb" + block_id.to_string()
end

def make_block_labels(func: MirFunction) -> Map[Int, String]
  var labels: Map[Int, String] = Map::new()
  for block in func.blocks do
    labels.insert(block.id.id, block_label(&func.name, block.id.id))
  end
  labels
end

def block_label_for(fctx: FnCodegenCtx, block_id: Int) -> String
  match fctx.block_labels.get(block_id)
  when Option::Some(label) then label.clone()
  when Option::None then block_label(&fctx.func.name, block_id)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Load operand into a register
# ———————————————————————————————————————————————————————————————

def load_operand(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_operand_aggregate_item(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_operand_call_arg(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
