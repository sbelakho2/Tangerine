# ———————————————————————————————————————————————————————————————
# Code Generation Context
# ———————————————————————————————————————————————————————————————

# Architecture-independent register handle.
# Wraps either an x86-64 or ARM64 physical register.
enum PhysReg
  X64Reg(X64)
  A64Reg(A64)
end

# Register allocation slot for a MIR local
enum VarLoc
  Register(PhysReg)   # in a physical register
  Stack(i32)          # at [FP + disp]
  Spilled(i32)        # forced to stack
end

struct FrameInfo
  stack_size: Int           # total frame size (bytes, 16-aligned)
  local_offsets: Map[Int, i32]   # MirLocalId.id -> FP offset
  spill_offset: i32         # current spill position
  saved_regs: Vec[PhysReg]  # callee-saved regs used
  sret_offset: i32          # FP offset where x8 is saved (0 = no sret)
  # The per-invocation BUDGET slots (FP-relative offsets; 0 = the function
  # carries no statements for that metric). The budget counters moved from
  # the global .data table into the generated function's STACK FRAME, so
  # every invocation of a budgeted function gets its own counter/stamp:
  #   * budget_alloc_offset — the ALLOCATION metric's consumed-units
  #     counter ([FP + offset]); the prologue zeroes it at entry (each
  #     invocation counts from zero — two calls of the same budgeted
  #     function never share a counter, nested/recursive invocations use
  #     their own frame slots, and per-thread stacks make concurrent calls
  #     race-free).
  #   * budget_time_offset — the TIME metric's entry-timestamp slot
  #     ([FP + offset]); the __tg_budget_time_start MirEffectRecord stamps
  #     it with __tg_clock_ns at function entry and the exit
  #     MirBudgetConsume("time", _) reads it back — nesting works because
  #     the inner invocation's frame is separate.
  # Both offsets are reserved FIRST in allocate_locals (spill_off starts
  # at -8), so they sit at the top of the spill area, never collide with
  # other spills (those continue below) or the callee-saved saves (the
  # bottom of the frame), and stay within the a64 LDUR/STUR -256..255
  # range for every function.
  budget_alloc_offset: i32 = 0
  budget_time_offset: i32 = 0
  # The per-invocation EFFECT-HANDLER frame slots (FP-relative offsets;
  # empty = the function installs no handler frames). EVERY
  # MirEffectFrameEnter in the function gets its OWN 48-byte slot (the
  # runtime writes the handler frame — effect id, op count, handled
  # bitmap, dispatcher, env ptr, next — into the CALLER's frame slot at
  # that address), so NESTED/SEQUENTIAL handle-with blocks in one
  # function each link an independent frame onto the task's handler
  # stack. The slots are reserved in emission order (the same block/
  # statement walk allocate_locals uses to build this vector and
  # codegen_function uses to emit — the j-th MirEffectFrameEnter reads
  # effect_frame_offsets[j]); each slot is 48 bytes and is placed BELOW
  # the budget slots so its upward 48-byte write region stays entirely
  # inside the spill area and never reaches the saved frame pointer /
  # return address at [fp .. fp+16). The slots live in the generated
  # function's STACK FRAME (the direct-style handler frames —
  # per-invocation, nesting-safe, race-free, exactly like the budget
  # counters): the runtime never allocates.
  effect_frame_offsets: Vec[i32] = Vec::new()
end

struct FnCodegenCtx
  func: MirFunction
  frame: FrameInfo
  var_locs: Map[Int, VarLoc]     # MirLocalId.id -> VarLoc
  block_labels: Map[Int, String] # MirBlockId.id -> label name
  string_locals: Set[Int]        # MirLocalId.id values known to be string type
  # The per-function effect-handler-frame occurrence counter: codegen
  # consumes frame.effect_frame_offsets[0..] in EMISSION order (the same
  # order allocate_locals scanned), so the j-th MirEffectFrameEnter
  # emitted installs into the j-th reserved 48-byte slot.
  next_effect_frame: Int = 0
end

struct CodegenCtx
  target: AsmTarget
  text: CodeBuffer
  data: CodeBuffer
  rodata: CodeBuffer
  debug_current_fn: String
  # Track BSS size for uninitialized globals
  bss_size: Int
  bss_symbols: Vec[AsmSymbol]  # Symbols in .bss
  string_pool: Map[String, String]  # literal -> label
  string_counter: Int
  fn_counter: Int
 # the nominal layout tables are CONCRETE-KEYED — every entry is
  # keyed by mir_type_identity_key of a CONCRETE Adt (the (TypeId, substs)
  # render), so Wrapper[u8] and Wrapper[Int] are distinct entries and a
  # generic def has no nominal (empty-args) entry. Queries always resolve
  # through the concrete type (codegen_aggregate / struct_field_offset_by_name).
  type_layout: Map[String, Int]    # concrete key -> byte size
  type_field_offsets: Map[String, Vec[Int]]  # concrete key -> per-field byte offsets
  type_field_sizes: Map[String, Vec[Int]]    # concrete key -> per-field byte sizes
  enum_payload_offsets: Map[String, Int]     # concrete key -> enum payload base offset
  layout_engine: LayoutEngine             # Single ABI authority for all codegen layout queries
  type_defs: Vec[MirTypeDef]              # All type definitions for lookup
  type_def_index: Map[Int, Int]           # TypeId.id -> index in type_defs (O(1) lookup)
  extern_fns: Set[String]                 # Names of extern (FFI) functions
  reachable_fns: Set[String]               # Names of all reachable compiled functions
  fn_alias: Map[String, String]            # MIR reference name → actual compiled function label
 # base names of `$`-suffixed monomorphized instance names
  # ("Option__map$i64_str" → "Option__map"). Used by resolve_callee_label's
  # instance-aware fail-closed check: a call site that still carries a base
  # name is a monomorphization-identity leak, never a callable.
  generic_instance_bases: Set[String]
 # the enum-eq helper identity is the CONCRETE key (mir_type_identity_key
  # of the compared enum) — Option[u8] and Option[Int] get distinct helpers;
  # the queue carries the concrete Types the bodies are emitted from.
  enum_eq_helper_requested: Set[String]
  enum_eq_helper_emitted: Set[String]
  enum_eq_helper_queue: Vec[Type]
  deinit_plans: Map[String, DeinitPlan]   # CONCRETE (TypeId, substs)-keyed plans (from MirProgram; see mir_type_identity_key)
 # the generated drop-glue function tables (from MirProgram) — the
  # glue functions' semantic identity -> emission name (drop_glue_fns) and
  # the concrete-type-key -> glue instance (drop_glue_instances). A
  # MirDeinit's InstanceId payload resolves to a label through these; the
  # whole-value destruction intrinsics (drop / drop_in_place) look the glue
  # up by the concrete type key. Codegen holds NO destruction knowledge:
  # it only calls the pre-generated glue functions.
  drop_glue_fns: Map[Int, String]
  drop_glue_instances: Map[String, InstanceId]
 # def_id_numeric(finalizer DefId) -> the finalizer's mangled
  # emission name ("Type__drop" / "Type__deinit"). MirDeinit payloads that
  # are FINALIZER instances (inside a generated glue body) resolve their
  # emission label through this table — the DefId is the identity, the name
  # is only the symbol-mangling boundary.
  method_names_by_def: Map[Int, String]
 # map/set Hash/Eq dispatch metadata — impl method mangled base
  # name ("MyKey__hash") -> (the DefId's fn_owner_key_of_def instance-base
  # render, the declared parameter count). Copied from
  # MirProgram.dispatch_methods. The map-op label resolution consults it:
  # the param count gates the CORE Hash/Eq ABI (hash(self) -> Int has ONE
  # param; eq(self, other) -> Bool has TWO), so Hasher-style impls
  # (`def hash[H: Hasher](self, state)`) never dispatch.
  dispatch_methods: Map[String, (String, Int)]
 # the static label table — DefId-render key -> the static's
  # emission label (the name-side symbol-table registration emitted by
  # codegen_static under st.name). The static references (MirStaticRef /
  # MirStaticAddr) carry the static's SEMANTIC DefId and resolve through
  # this table — fail-closed: a reference whose DefId never registered is
  # an internal compiler error, never a name-derived or guessed address.
  static_labels: Map[String, String]
 # the String-ABI receiver unwrap flag. The intrinsic router
  # sets it around the shared byte-op emitters for the string_* intrinsics
  # (the String object ABI); the emitters' maybe_load_string_data_ptr
  # consults it to unwrap the String object header ([header+0] = data).
  # str_* intrinsics leave it clear (their values are already raw byte
  # pointers — the static StaticStrPtr form). Always cleared after the emitter.
  string_abi_unwrap: Bool
end

# ———————————————————————————————————————————————————————————————
# Type lookup helpers
# ———————————————————————————————————————————————————————————————

# O(1) type def lookup by type ID using the pre-built index map.
def lookup_type_def(ctx: CodegenCtx, type_id: Int) -> Option[MirTypeDef]
  match ctx.type_def_index.get(type_id)
  when Option::Some(i) then Option::Some(&ctx.type_defs[i])
  when Option::None then Option::None
  end  end  end
end

# ———————————————————————————————————————————————————————————————
# Type layout
# ———————————————————————————————————————————————————————————————

# STRING ABI (— DECIDED: the owned String object)
# The by-value String VALUE is ONE 8-byte pointer — the Repr::StringPtr
# row of the engine's decision table (type_repr). The layout
# concepts are SEPARATED: the value is the StringHandleLayout (8 — the
# VALUE width; string_abi_size), and the pointer points to the 32-byte
# OwnedStringObjectLayout (owned_string_object_size / the engine's
# repr_header_size(StringPtr)):
#   [ptr+0]:  data   — pointer to the null-terminated UTF-8 byte buffer
#   [ptr+8]:  len    — byte length (excluding the NUL)
#   [ptr+16]: cap    — byte capacity (>= len, >= 8)
#   [ptr+24]: stride — 1 (u8 byte stride)
# The engine's container_field_offset(StringPtr) {data:0,len:8,cap:16,
# stride:24} describes exactly this object. The String OBJECT ABI is the
# intrinsic-level contract:
#   - string_* intrinsic RECEIVERS and RESULTS are String objects
#     (header pointers); the byte-op emitters unwrap [header+0] = data
#     (see maybe_load_string_data_ptr / ctx.string_abi_unwrap);
#   - str-typed operands (&str params, str_* intrinsics) are RAW pointers
#     to NUL-terminated bytes — the static StaticStrPtr form;
#   - a string LITERAL is the static StaticStrPtr (raw label); the owned
#     conversion is string_from_static (_tg_string_from_static).
# The old "no inline {ptr,len,cap} header" reading of StringPtr is
# superseded by this contract: the VALUE stays one pointer, the heap
# object behind it gained the header that mutation needs.
# normalize_string_arg0_for_current_arch below is the documented no-op
# (the runtime helpers unwrap the object themselves).

def codegen_layout_target(arch: Arch) -> TargetDescriptor
  match arch
  when Arch::X86_64 then x86_64_target()
  when Arch::AArch64 then aarch64_target()
  end  end
end

def layout_of_strict(inout engine: LayoutEngine, ty: Type) -> Layout
  match layout_of_concrete(engine, ty)
  when Result::Ok(l) then l
  when Result::Err(e) then panic("ICE: unresolved type reached codegen: " + e.type_name)
  end  end
end

def align_up_int(v: Int, align: Int) -> Int
  ((v + align - 1) / align) * align
end

# Build type layout map using the centralized LayoutEngine.
# This ensures single source of truth for all type sizes.
# Also computes field-level offsets and sizes in one pass to avoid
# creating a second LayoutEngine.
# the tables are CONCRETE-KEYED (mir_type_identity_key of the
# concrete Adt — the (TypeId, substs) identity). The MIR type definitions
# are the generic templates: NON-GENERIC defs (generic_params empty — their
# fields are already concrete) are laid out under their nominal key, which
# IS their concrete key. GENERIC defs (Wrapper, Option, Result,...) have NO
# nominal entry — every instantiation the program actually mentions (the
# collected concrete Adt instances from the post-mono function/static types)
# is laid out under its OWN concrete key with the def's fields SUBSTITUTED
# (the layout engine's substituted-field computation). No pointer-width
# generic-slot placeholder exists anywhere in these tables.
def build_all_layouts(inout engine: LayoutEngine, types: Vec[MirTypeDef], concrete_instances: Vec[Type]) -> (Map[String, Int], Map[String, Vec[Int]], Map[String, Vec[Int]], Map[String, Int])
  var layout: Map[String, Int] = Map::new()
  var offsets_map: Map[String, Vec[Int]] = Map::new()
  var sizes_map: Map[String, Vec[Int]] = Map::new()
  var payload_map: Map[String, Int] = Map::new()

  layout_engine_register_types(engine, types)
  compute_all_layouts(engine)

  # The nominal entries: non-generic defs only (their fields are concrete).
  for td in types do
    if td.generic_params.is_empty() then
      let cty = Type::Adt(td.id.clone(), Vec::new())
      let ckey = mir_type_identity_key(&cty)
      match layout_of_concrete(engine, &cty)
      when Result::Ok(l) then layout.insert(ckey.clone(), l.size)
      when Result::Err(e) then panic("ICE: unresolved type reached codegen: " + e.type_name)
      end
      match td.kind
      when MirTypeDefKind::Struct(fields) then
        var field_offsets = Vec::new()
        var field_sizes = Vec::new()
        var i = 0
        while i < fields.len() do
          let off = field_offset(engine, &cty, i)
          field_offsets.push(off)
          let sz = field_size(engine, &cty, i)
          field_sizes.push(sz)
          i = i + 1
        end
        offsets_map.insert(ckey.clone(), field_offsets)
        sizes_map.insert(ckey.clone(), field_sizes)
      when MirTypeDefKind::Enum(variants) then
        var field_offsets = Vec::new()
        var field_sizes = Vec::new()
        field_offsets.push(discriminant_offset(engine, &cty))
        field_sizes.push(discriminant_size(engine, &cty))
        payload_map.insert(ckey.clone(), payload_offset(engine, &cty))
        var vi = 0
        while vi < variants.len() do
          let voffs = enum_variant_field_offsets(engine, &cty, vi)
          let vsizes = enum_variant_field_sizes(engine, &cty, vi)
          var j = 0
          while j < variants[vi].fields.len() do
            # Offsets/sizes come exclusively from the layout engine; a missing
            # entry is an invariant violation, never a hardcoded 8.
            let off = if j < voffs.len() then voffs[j] else payload_offset(engine, &cty) end
            let sz = if j < vsizes.len() then vsizes[j] else panic("build_all_layouts: missing field size for enum " + td.id.id.to_string()) end
            field_offsets.push(off)
            field_sizes.push(sz)
            j = j + 1
          end
          vi = vi + 1
        end
        offsets_map.insert(ckey.clone(), field_offsets)
        sizes_map.insert(ckey.clone(), field_sizes)
      end
    end
  end

  # The CONCRETE entries: every concrete Adt instance the (post-mono) MIR
  # mentions — generic instantiations laid out per substitution.
  for inst in concrete_instances do
    match inst
    when Type::Adt(tid, args) then
      if lookup_type_name(engine, tid.id) == "Array" || is_slice_view_tid(engine, tid.id) then
        # Heap-vector handle / RAW UnsafeSlice view: pointer-sized or
        # 16-byte inline handles — no field
        # table (their shapes come from container_field_offset /
        # slice_view_layout, not the def). The SAFE source-spelled Slice
        # is the std-declared shared struct and gets its field table below
        # (the 8-byte Arc handle).
        ()
      else
        let cty = Type::Adt(tid.clone(), args.clone())
        let ckey = mir_type_identity_key(&cty)
        match layout_of_concrete(engine, &cty)
        when Result::Ok(l) then layout.insert(ckey.clone(), l.size)
        when Result::Err(e) then panic("ICE: unresolved type reached codegen: " + e.type_name)
        end
        var found_def = false
        for td in types do
          if td.id.id == tid.id then
            found_def = true
            match td.kind
            when MirTypeDefKind::Struct(fields) then
              var field_offsets = Vec::new()
              var field_sizes = Vec::new()
              var i = 0
              while i < fields.len() do
                let off = field_offset(engine, &cty, i)
                field_offsets.push(off)
                let sz = field_size(engine, &cty, i)
                field_sizes.push(sz)
                i = i + 1
              end
              offsets_map.insert(ckey.clone(), field_offsets)
              sizes_map.insert(ckey.clone(), field_sizes)
            when MirTypeDefKind::Enum(variants) then
              var field_offsets = Vec::new()
              var field_sizes = Vec::new()
              field_offsets.push(discriminant_offset(engine, &cty))
              field_sizes.push(discriminant_size(engine, &cty))
              payload_map.insert(ckey.clone(), payload_offset(engine, &cty))
              var vi = 0
              while vi < variants.len() do
                let voffs = enum_variant_field_offsets(engine, &cty, vi)
                let vsizes = enum_variant_field_sizes(engine, &cty, vi)
                var j = 0
                while j < variants[vi].fields.len() do
                  let off = if j < voffs.len() then voffs[j] else payload_offset(engine, &cty) end
                  let sz = if j < vsizes.len() then vsizes[j] else panic("build_all_layouts: missing field size for enum " + td.id.id.to_string()) end
                  field_offsets.push(off)
                  field_sizes.push(sz)
                  j = j + 1
                end
                vi = vi + 1
              end
              offsets_map.insert(ckey.clone(), field_offsets)
              sizes_map.insert(ckey.clone(), field_sizes)
            end
          end
        end
        if !found_def then
          # A concrete instance whose def is unregistered is a lowering
          # defect — fail closed (no layout table entry).
          panic("ICE: concrete instance '" + ckey + "' has no registered MIR type definition")
        end
      end
    when Type::Closure(_, _, _, _, _) then
 # (the closure {code, env} ABI): the closure OBJECT's layout —
      # { code: fn ptr @ 0, env: capture-tuple } — registered by the
      # ClosureId-keyed concrete identity (closure_object_record computes
      # and caches the engine record; the field tables below are what the
      # aggregate emission (codegen_aggregate's general path) and the
      # closure-call dispatch (codegen_indirect_callee) resolve).
      let ckey = mir_type_identity_key(&inst)
      let cl_rec = closure_object_record(engine, &inst)
      layout.insert(ckey.clone(), cl_rec.size)
      var field_offsets = Vec::new()
      var field_sizes = Vec::new()
      var fi = 0
      while fi < cl_rec.fields.len() do
        field_offsets.push(cl_rec.fields[fi].offset)
        field_sizes.push(cl_rec.fields[fi].size)
        fi = fi + 1
      end
      offsets_map.insert(ckey.clone(), field_offsets)
      sizes_map.insert(ckey.clone(), field_sizes)
    when _ then ()
    end
  end

  (layout, offsets_map, sizes_map, payload_map)
end

# The number of captured locals a closure type carries (the capture TUPLE's
# element count) — the closure-call dispatch's leading-argument shift.
def capture_tuple_len(captures: Type) -> Int
  match captures
  when Type::Tuple(t) then t.len()
  when _ then 0
  end  end
end

# Collect every concrete Type::Adt instance reachable in a MIR type
# (post-mono: function param/local/return types and static types are fully
# substituted) — the population source for the concrete-keyed layout tables.
# (the closure {code, env} ABI): every Type::Closure instance is
# collected TOO — the closure OBJECT's layout ({ code @ 0, env:
# capture-tuple }) is registered by the ClosureId-keyed concrete identity in
# build_all_layouts, so the aggregate emission and the closure-call dispatch
# resolve the object's field offsets from the registered tables.
def collect_concrete_adt_types(ty: Type, inout out: Vec[Type]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    out.push(ty.clone())
    for a in args do
      collect_concrete_adt_types(a, out)
    end
  when Type::Tuple(fields) then
    for f in fields do
      collect_concrete_adt_types(f, out)
    end
  when Type::FixedArray(elem, _) then
    collect_concrete_adt_types(elem, out)
  when Type::FnPtr(params, ret, _) then
    for p in params do
      collect_concrete_adt_types(&p.ty, out)
    end
    collect_concrete_adt_types(ret, out)
  when Type::Closure(_, params, ret, captures, _) then
    out.push(ty.clone())
    for p in params do
      collect_concrete_adt_types(&p.ty, out)
    end
    collect_concrete_adt_types(ret, out)
    collect_concrete_adt_types(&captures, out)
  when Type::RefInternal(inner, _) then collect_concrete_adt_types(inner, out)
  when Type::Ptr(inner) then collect_concrete_adt_types(inner, out)
  when Type::PtrMut(inner) then collect_concrete_adt_types(inner, out)
  when Type::Effect(_, inner) then collect_concrete_adt_types(inner, out)
  when _ then ()
  end  end
end

# ———————————————————————————————————————————————————————————————
# Layout table dumper — diagnostic output for debugging layout issues
# ———————————————————————————————————————————————————————————————

def dump_layout_table(types: Vec[MirTypeDef], layout: Map[String, Int],
                      offsets: Map[String, Vec[Int]], sizes: Map[String, Vec[Int]]) -> Unit
  for td in types do
    let cty = Type::Adt(td.id.clone(), Vec::new())
    let ckey = mir_type_identity_key(&cty)
    let total_sz = match layout.get(ckey)
    when Option::Some(sz) then sz
    when Option::None then -1
    end
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      var fi = 0
      for f in fields do
        let fo = match offsets.get(ckey)
        when Option::Some(offs) then
          if fi < offs.len() then offs[fi].to_string() else "?" end
        when Option::None then "?"
        end
        let fs = match sizes.get(ckey)
        when Option::Some(szs) then
          if fi < szs.len() then szs[fi].to_string() else "?" end
        when Option::None then "?"
        end
        fi = fi + 1
      end
    when MirTypeDefKind::Enum(variants) then
      for v in variants do
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Allocatable general-purpose registers (architecture-dispatched)
# ———————————————————————————————————————————————————————————————

# x86-64: avoid RAX (return/scratch), RSP (stack), RBP (frame).
def x64_allocatable_regs() -> Vec[PhysReg]
  var regs = Vec::new()
  regs.push(PhysReg::X64Reg(X64::RCX))
  regs.push(PhysReg::X64Reg(X64::RDX))
  regs.push(PhysReg::X64Reg(X64::RSI))
  regs.push(PhysReg::X64Reg(X64::RDI))
  regs.push(PhysReg::X64Reg(X64::R8))
  regs.push(PhysReg::X64Reg(X64::R9))
  regs.push(PhysReg::X64Reg(X64::R10))
  regs.push(PhysReg::X64Reg(X64::RBX))
  regs.push(PhysReg::X64Reg(X64::R12))
  regs.push(PhysReg::X64Reg(X64::R13))
  regs.push(PhysReg::X64Reg(X64::R14))
  regs.push(PhysReg::X64Reg(X64::R15))
  regs
end

# ARM64: avoid X0 (return), X16-X17 (IP0/IP1 linker scratch),
# X18 (platform), FP(X29), LR(X30), SP.
def a64_allocatable_regs() -> Vec[PhysReg]
  var regs = Vec::new()
  # Callee-saved registers first (safe across calls)
  regs.push(PhysReg::A64Reg(A64::X19))
  regs.push(PhysReg::A64Reg(A64::X20))
  regs.push(PhysReg::A64Reg(A64::X21))
  regs.push(PhysReg::A64Reg(A64::X22))
  regs.push(PhysReg::A64Reg(A64::X23))
  regs.push(PhysReg::A64Reg(A64::X24))
  regs.push(PhysReg::A64Reg(A64::X25))
  regs.push(PhysReg::A64Reg(A64::X26))
  regs.push(PhysReg::A64Reg(A64::X27))
  regs.push(PhysReg::A64Reg(A64::X28))
  regs
end

def allocatable_regs(arch: Arch) -> Vec[PhysReg]
  match arch
  when Arch::X86_64  then x64_allocatable_regs()
  when Arch::AArch64 then a64_allocatable_regs()
  end  end
end

def phys_is_callee_saved(r: PhysReg) -> Bool
  match r
  when PhysReg::X64Reg(xr) then is_callee_saved(xr)
  when PhysReg::A64Reg(ar) then
    match ar
    when A64::X19 then true; when A64::X20 then true; when A64::X21 then true
    when A64::X22 then true; when A64::X23 then true; when A64::X24 then true
    when A64::X25 then true; when A64::X26 then true; when A64::X27 then true
    when A64::X28 then true
    when _ then false
    end
  end  end
end

def phys_reg_id(r: PhysReg) -> Int
  match r
  when PhysReg::X64Reg(xr) then x64_code(xr) as Int
  when PhysReg::A64Reg(ar) then a64_code(ar) as Int
  end  end
end

# Scratch register (not allocatable, used for temporaries)
def scratch_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::R11)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X15)
  end  end
end

# Return value register
def ret_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RAX)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X0)
  end  end
end

# Argument registers for calling convention
def arg_reg(arch: Arch, i: Int) -> Option[PhysReg]
  match arch
  when Arch::X86_64 then
    match x64_arg_reg(i)
    when Option::Some(r) then Option::Some(PhysReg::X64Reg(r))
    when Option::None then Option::None
    end
  when Arch::AArch64 then
    match a64_arg_reg(i)
    when Option::Some(r) then Option::Some(PhysReg::A64Reg(r))
    when Option::None then Option::None
    end
  end  end
end

def max_reg_args(arch: Arch) -> Int
  match arch
  when Arch::X86_64  then 6
  when Arch::AArch64 then 8
  end  end
end

# ———————————————————————————————————————————————————————————————
# Register Allocator (linear-scan style, simplified)
# ———————————————————————————————————————————————————————————————

struct RegAllocState
  free_regs: Vec[PhysReg]
  used_callee: Set[Int]     # phys_reg_id values of callee-saved regs in use
  assignments: Map[Int, VarLoc]
  arch: Arch
end

def reg_alloc_new(arch: Arch) -> RegAllocState
  RegAllocState {
    free_regs: allocatable_regs(arch),
    used_callee: Set::new(),
    assignments: Map::new(),
    arch: arch
  }
end

def alloc_reg(inout state: RegAllocState) -> Option[PhysReg]
  if state.free_regs.is_empty() then
    return Option::None
  end
  match state.free_regs.pop()
  when Option::Some(r) then
    if phys_is_callee_saved(r) then
      state.used_callee.insert(phys_reg_id(r))
    end
    Option::Some(r)
  when Option::None then
    Option::None
  end
end

# Allocate a register with spill support: if no free regs, spill one
def alloc_reg_or_spill(inout state: RegAllocState, inout ctx: CodegenCtx, inout frame: FrameInfo) -> PhysReg
  match alloc_reg(state)
  when Option::Some(r) then r
  when Option::None then
    # No free registers — find an in-use register, spill its value to the
    # stack, and reclaim it.  Pick the first register-allocated variable
    # found in the assignments map.
    var spill_victim_id = -1
    var spill_reg = scratch_reg(state.arch)
    for entry in state.assignments do
      match entry.1
      when VarLoc::Register(r) then
        spill_victim_id = entry.0
        spill_reg = r
        break
      when _ then ()
      end
    end
    if spill_victim_id >= 0 then
      # Allocate a spill slot on the stack.
      let fp = fp_reg(state.arch)
      frame.spill_offset = frame.spill_offset - 8
      let offset = frame.spill_offset
      emit_store_mem(ctx, fp, offset, spill_reg)
      state.assignments.insert(spill_victim_id, VarLoc::Spilled(offset))
      frame.local_offsets.insert(spill_victim_id, offset)
    end
    spill_reg
  end  end
end

# Reload a spilled value from the stack
def reload_spill(inout ctx: CodegenCtx, sp: PhysReg, offset: i32, dst: PhysReg) -> Unit
  emit_load_mem(ctx, dst, sp, offset)
end

def free_reg(inout state: RegAllocState, r: PhysReg) -> Unit
  state.free_regs.push(r)
end

def used_callee_reg(state: RegAllocState, code: Int) -> Bool
  state.used_callee.contains(&code)
end

def collect_saved_regs(state: RegAllocState, arch: Arch) -> Vec[PhysReg]
  var saved: Vec[PhysReg] = Vec::new()
  match arch
  when Arch::X86_64 then
    if used_callee_reg(state, x64_code(X64::RBX) as Int) then saved.push(PhysReg::X64Reg(X64::RBX)) end
    if used_callee_reg(state, x64_code(X64::R12) as Int) then saved.push(PhysReg::X64Reg(X64::R12)) end
    if used_callee_reg(state, x64_code(X64::R13) as Int) then saved.push(PhysReg::X64Reg(X64::R13)) end
    if used_callee_reg(state, x64_code(X64::R14) as Int) then saved.push(PhysReg::X64Reg(X64::R14)) end
    if used_callee_reg(state, x64_code(X64::R15) as Int) then saved.push(PhysReg::X64Reg(X64::R15)) end
  when Arch::AArch64 then
    if used_callee_reg(state, a64_code(A64::X19) as Int) then saved.push(PhysReg::A64Reg(A64::X19)) end
    if used_callee_reg(state, a64_code(A64::X20) as Int) then saved.push(PhysReg::A64Reg(A64::X20)) end
    if used_callee_reg(state, a64_code(A64::X21) as Int) then saved.push(PhysReg::A64Reg(A64::X21)) end
    if used_callee_reg(state, a64_code(A64::X22) as Int) then saved.push(PhysReg::A64Reg(A64::X22)) end
    if used_callee_reg(state, a64_code(A64::X23) as Int) then saved.push(PhysReg::A64Reg(A64::X23)) end
    if used_callee_reg(state, a64_code(A64::X24) as Int) then saved.push(PhysReg::A64Reg(A64::X24)) end
    if used_callee_reg(state, a64_code(A64::X25) as Int) then saved.push(PhysReg::A64Reg(A64::X25)) end
    if used_callee_reg(state, a64_code(A64::X26) as Int) then saved.push(PhysReg::A64Reg(A64::X26)) end
    if used_callee_reg(state, a64_code(A64::X27) as Int) then saved.push(PhysReg::A64Reg(A64::X27)) end
    if used_callee_reg(state, a64_code(A64::X28) as Int) then saved.push(PhysReg::A64Reg(A64::X28)) end
  end
  saved
end

def saved_reg_bytes(saved: Vec[PhysReg]) -> Int
  var count = 0
  for _ in saved do
    count = count + 1
  end
  count * 8
end

# Which budget frame slots a function's MIR needs: scan the lowered body
# for the budget statements the lowering emits (the allocation consumes —
# MirBudgetConsume("alloc", _) after each intrinsic allocation — and the
# time entry/exit pair — the __tg_budget_time_start MirEffectRecord plus
# the MirBudgetConsume("time", _) exit checks). The scan is the slot-
# reservation authority: a function that carries no such statement never
# reserves frame space, and a function that does always finds its slots
# reserved when the codegen arms address them.
def func_budget_slot_usage(func: MirFunction) -> (Bool, Bool)
  var needs_alloc = false
  var needs_time = false
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirBudgetConsume(resource, _) then
        if resource == "alloc" then needs_alloc = true
        elsif resource == "time" then needs_time = true
        end
      when MirStatementKind::MirEffectRecord(name, _) then
        if name == "__tg_budget_time_start" then needs_time = true end
      when _ then ()
      end
    end
  end
  (needs_alloc, needs_time)
end

# Whether a function installs effect-handler frames: any
# MirEffectFrameEnter in the body reserves the frame slots (the
# slot-reservation authority mirror of func_budget_slot_usage — the
# __tg_effect_frame_push arm always finds its slot reserved).
def func_has_effect_frame(func: MirFunction) -> Bool
  func_effect_frame_count(func) > 0
end

# The number of MirEffectFrameEnter occurrences in a function, in
# block/statement order (the SAME order codegen_function emits). Every
# occurrence — one per `handle ... with ...` clause and one per nested
# handle-with statement — reserves its OWN 48-byte frame slot, so nested
# and sequential handlers within one function each install an independent
# frame onto the task's handler stack.
def func_effect_frame_count(func: MirFunction) -> Int
  var count = 0
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, _) then count = count + 1
      when _ then ()
      end
    end
  end
  count
end

def allocate_locals(func: MirFunction, arch: Arch, inout engine: LayoutEngine) -> (Map[Int, VarLoc], FrameInfo)
  var ra = reg_alloc_new(arch)
  var local_offsets: Map[Int, Int] = Map::new()
  var var_locs: Map[Int, VarLoc] = Map::new()
  var spill_off: i32 = 0  # next spill starts at [fp - 8]
  var address_taken_locals: Set[Int] = Set::new()

  # The per-invocation budget slots: reserved FIRST (before the sret slot
  # and every spill), so their FP offsets are fixed at -8/-16 and every
  # MirBudgetConsume / __tg_budget_time_start arm in the function's body
  # addresses them through fctx.frame. A function that carries no budget
  # statements never reserves (its frame stays unchanged).
  var budget_alloc_offset: i32 = 0
  var budget_time_offset: i32 = 0
  let (fn_needs_alloc, fn_needs_time) = func_budget_slot_usage(func)
  if fn_needs_alloc then
    spill_off = spill_off - 8
    budget_alloc_offset = spill_off
  end
  if fn_needs_time then
    spill_off = spill_off - 8
    budget_time_offset = spill_off
  end
  # The effect-handler frame slots: reserved with the budget slots — one
  # 48-byte slot per MirEffectFrameEnter occurrence, placed BELOW the
  # budget slots. Each slot's upward 48-byte write region
  # ([slot .. slot+48)) stays entirely inside the spill area, so it never
  # reaches the budget counters or the saved FP/LR at [fp .. fp+16).
  # Nested/sequential handle-with blocks in one function each get their
  # own slot (frame.effect_frame_offsets[j] is the j-th occurrence's
  # slot, in emission order).
  var effect_frame_offsets: Vec[i32] = Vec::new()
  let fn_effect_frames = func_effect_frame_count(func)
  if fn_effect_frames > 0 then
    spill_off = spill_off - (48 * fn_effect_frames) as i32
    var efi = 0
    while efi < fn_effect_frames do
      effect_frame_offsets.push(spill_off + (48 * efi) as i32)
      efi = efi + 1
    end
  end

  # sret ABI: if the return type (local 0) has a sret-eligible value
  # category (ScalarPair/ByAddress — see category_uses_sret, the single
  # sret-candidate authority shared with classify_return), reserve a slot to
  # save the caller-supplied indirect-return pointer (x8 on AArch64). Caller
  # passes &dest in x8; epilogue copies local 0 into [x8]. We must reserve
  # this BEFORE other allocations so the offset is fixed. ZeroSized/Scalar
  # results (primitives, pointers/handles, TaggedPtr-represented enums — the
  # enum VALUE is one pointer-width word, so it returns directly regardless
  # of its image size) never reserve. FAIL-CLOSED: an unresolved return type
  # panics here instead of assuming a word.
  var sret_offset: i32 = 0
  if func.locals.len() > 0 then
    match classify_value_category(engine, &func.locals[0].ty)
    when Result::Err(e) then
      panic("ICE: sret decision failed closed for return type '" + e.type_name + "': " + layout_error_to_string(&e))
    when Result::Ok(cat) then
      if category_uses_sret(&cat) then
        spill_off = spill_off - 8
        sret_offset = spill_off
      end
    end
  end

  # Locals whose address is taken need a stable stack home. Keeping them in
  # registers and synthesizing temporary spill slots later has proven fragile
  # during native bootstrap, especially for method receivers lowered as &self.
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirRef(ref_place) then
          address_taken_locals.insert(ref_place.local.id)
        when _ then ()
        end
      when _ then ()
      end
    end
  end

  # Build set of param IDs to avoid double-allocating them
  var param_ids = Set::new()
  for param in func.params do
    param_ids.insert(param.id.id)
  end

  # Try to give each local a register; spill when exhausted
  # Skip params (they're also in locals, but allocated separately below)
  for local in func.locals do
    let local_id = local.id.id
    if param_ids.contains(&local_id) then
      ()  # skip — will be allocated in the params loop
    else
      let sz = layout_of_strict(engine, &local.ty).size
      let alloc_sz = if sz == 0 then 8 else sz end

      # Multi-word locals (>8 bytes) cannot fit in a single register; force them
      # onto the stack so all words are addressable.
      let force_stack = alloc_sz > 8
      if address_taken_locals.contains(&local_id) || force_stack then
        let aligned_sz = align_up_int(alloc_sz, 8)
        spill_off = spill_off - aligned_sz as i32
        var_locs.insert(local_id, VarLoc::Spilled(spill_off))
        local_offsets.insert(local_id, spill_off)
      else
        match alloc_reg(&mut ra)
        when Option::Some(r) then
          var_locs.insert(local_id, VarLoc::Register(r))
        when Option::None then
          let aligned_sz = align_up_int(alloc_sz, 8)
          spill_off = spill_off - aligned_sz as i32
          var_locs.insert(local_id, VarLoc::Spilled(spill_off))
          local_offsets.insert(local_id, spill_off)
        end
      end
    end
  end

  # Allocate storage for params — callee-saved registers or spill slots.
  # The prologue will move from ABI arg regs into these locations.
  var arg_idx = 0
  for param in func.params do
    let param_id = param.id.id
    let sz = layout_of_strict(engine, &param.ty).size
    let alloc_sz_p = if sz == 0 then 8 else sz end
    let force_stack_p = alloc_sz_p > 8
    if address_taken_locals.contains(&param_id) || force_stack_p then
      let aligned_sz = align_up_int(alloc_sz_p, 8)
      spill_off = spill_off - aligned_sz as i32
      var_locs.insert(param_id, VarLoc::Spilled(spill_off))
      local_offsets.insert(param_id, spill_off)
    else
      match alloc_reg(&mut ra)
      when Option::Some(r) then
        var_locs.insert(param_id, VarLoc::Register(r))
      when Option::None then
        let aligned_sz = align_up_int(sz, 8)
        spill_off = spill_off - aligned_sz as i32
        var_locs.insert(param_id, VarLoc::Spilled(spill_off))
        local_offsets.insert(param_id, spill_off)
      end
    end
    arg_idx = arg_idx + 1
  end

  # Collect callee-saved regs used
  let saved = collect_saved_regs(&ra, arch)

  # Pre-scan MIR to account for fallback spill growth during codegen.
  # Address-taken locals are normally stack-homed above. This remains as a
  # guard for any ref emitted before the address-taken scan can see it.
  var dynamic_extra = 0
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirAggregate(_, _) then
          ()
        when MirRvalueKind::MirRef(ref_place) then
          match var_locs.get(ref_place.local.id)
          when Option::Some(loc) then
            match loc
            when VarLoc::Register(_) then dynamic_extra = dynamic_extra + 8
            when _ then ()
            end
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  end

  # Extend spill_off to cover the fallback dynamic needs. Save the original
  # spill_off as the starting point for codegen.
 # the former fixed 128-byte reserve for the codegen-side drop-glue
 # scratch places are not part of the model — destruction is a pre-generated MIR glue
  # function with its own frame; codegen emits no synthetic glue slots.
  let codegen_spill_start = spill_off
  spill_off = spill_off - dynamic_extra as i32

  # Calculate total frame size (includes space for static spills +
  # dynamic spills + callee-saved registers)
  let spill_bytes = if spill_off < 0 then (-spill_off) as Int else 0 end
  let save_bytes = saved_reg_bytes(&saved)
  let raw_size = spill_bytes + save_bytes
  let stack_size = align_up_int(raw_size, 16)

  let frame = FrameInfo {
    stack_size: stack_size,
    local_offsets: local_offsets,
    spill_offset: codegen_spill_start,
    saved_regs: saved,
    sret_offset: sret_offset,
    budget_alloc_offset: budget_alloc_offset,
    budget_time_offset: budget_time_offset,
    effect_frame_offsets: effect_frame_offsets
  }

  (var_locs, frame)
end

# ———————————————————————————————————————————————————————————————
# Code Generation — Context Creation
# ———————————————————————————————————————————————————————————————

def codegen_new(target: AsmTarget) -> CodegenCtx
  CodegenCtx {
    target: target.clone(),
    text: buf_new(),
    data: buf_new(),
    rodata: buf_new(),
    debug_current_fn: "".to_string(),
    bss_size: 0,
    bss_symbols: Vec::new(),
    string_pool: Map::new(),
    string_counter: 0,
    fn_counter: 0,
    type_layout: Map::new(),
    type_field_offsets: Map::new(),
    type_field_sizes: Map::new(),
    enum_payload_offsets: Map::new(),
    layout_engine: layout_engine_new(codegen_layout_target(target.arch)),
    type_defs: Vec::new(),
    type_def_index: Map::new(),
    extern_fns: Set::new(),
    reachable_fns: Set::new(),
    fn_alias: Map::new(),
    generic_instance_bases: Set::new(),
    enum_eq_helper_requested: Set::new(),
    enum_eq_helper_emitted: Set::new(),
    enum_eq_helper_queue: Vec::new(),
    deinit_plans: Map::new(),
    dispatch_methods: Map::new(),
    drop_glue_fns: Map::new(),
    drop_glue_instances: Map::new(),
    method_names_by_def: Map::new(),
    static_labels: Map::new(),
    string_abi_unwrap: false
  }
end

# Intern a string literal, return label for the constant
def intern_string(inout ctx: CodegenCtx, s: String) -> String
  match ctx.string_pool.get(s)
  when Option::Some(label) then return label
  when Option::None then ()
  end

  let label = ".Lstr." + ctx.string_counter.to_string()
  ctx.string_counter = ctx.string_counter + 1
  ctx.string_pool.insert(s.clone(), label.clone())

  # Emit string bytes into rodata
  def_label(&mut ctx.rodata, label.clone())
  var byte_idx = 0
  while byte_idx < s.len() do
    emit8(&mut ctx.rodata, s.char_at(byte_idx) as Int)
    byte_idx = byte_idx + 1
  end
  emit8(&mut ctx.rodata, 0)  # null terminator

  label  end
end

# ———————————————————————————————————————————————————————————————
# Architecture-dispatched instruction emission
# ———————————————————————————————————————————————————————————————

# MOV reg, immediate
def emit_mov_ri(inout ctx: CodegenCtx, dst: PhysReg, imm: i64) -> Unit
  match dst
  when PhysReg::X64Reg(r) then x64_mov_ri(&mut ctx.text, r, imm)
  when PhysReg::A64Reg(r) then a64_mov_ri(&mut ctx.text, r, imm)
  end  end
end

# MOV reg, reg
def emit_mov_rr(inout ctx: CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(d) then
    match src
    when PhysReg::X64Reg(s) then x64_mov_rr(&mut ctx.text, d, s)
    when _ then panic("emit_mov_rr: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match src
    when PhysReg::A64Reg(ab) then a64_mov_rr(&mut ctx.text, d, ab)
    when _ then panic("emit_mov_rr: mixed architectures")
    end
  end  end
end

# LOAD reg, [base + offset]
def emit_load_mem(inout ctx: CodegenCtx, dst: PhysReg, base: PhysReg, offset: i32) -> Unit
  match dst
  when PhysReg::X64Reg(d) then
    match base
    when PhysReg::X64Reg(b) then x64_mov_rm(&mut ctx.text, d, b, offset)
    when _ then panic("emit_load_mem: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match base
    when PhysReg::A64Reg(b) then
      # Sign-extend i32 to i64 manually (interpreter may zero-extend i32)
      let raw = offset as i64
      var ext = raw
      if (raw & 2147483648) != 0 then
        ext = raw | (-4294967296)
      end
      if ext >= 0 && (ext % 8) == 0 && ext < 32768 then
        a64_ldr(&mut ctx.text, d, b, ext as u32)
      else if ext >= -256 && ext <= 255 then
        a64_ldur(&mut ctx.text, d, b, offset)
      else if ext < 0 then
        # Negative large offset: compute positive abs distance, use SUB
        let abs_off = -ext
        a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
        a64_sub_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        a64_ldur(&mut ctx.text, d, A64::X15, 0)
      else
        # Positive large offset: load value, ADD to compute address
        a64_mov_ri(&mut ctx.text, A64::X15, ext)
        a64_add_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        a64_ldur(&mut ctx.text, d, A64::X15, 0)
      end
    when _ then panic("emit_load_mem: mixed architectures")
    end
  end  end
end

# STORE [base + offset], reg
def emit_store_mem(inout ctx: CodegenCtx, base: PhysReg, offset: i32, src: PhysReg) -> Unit
  match base
  when PhysReg::X64Reg(b) then
    match src
    when PhysReg::X64Reg(s) then x64_mov_mr(&mut ctx.text, b, offset, s)
    when _ then panic("emit_store_mem: mixed architectures")
    end
  when PhysReg::A64Reg(b) then
    match src
    when PhysReg::A64Reg(s) then
      # Sign-extend i32 to i64 manually (interpreter may zero-extend i32)
      let raw = offset as i64
      var ext = raw
      if (raw & 2147483648) != 0 then
        ext = raw | (-4294967296)
      end
      if ext >= 0 && (ext % 8) == 0 && ext < 32768 then
        a64_str(&mut ctx.text, s, b, ext as u32)
      else if ext >= -256 && ext <= 255 then
        a64_stur(&mut ctx.text, s, b, offset)
      else if ext < 0 then
        # Negative large offset: compute positive abs distance, use SUB
        let abs_off = -ext
        a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
        a64_sub_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        a64_stur(&mut ctx.text, s, A64::X15, 0)
      else
        # Positive large offset: load value, ADD to compute address
        a64_mov_ri(&mut ctx.text, A64::X15, ext)
        a64_add_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        a64_stur(&mut ctx.text, s, A64::X15, 0)
      end
    when _ then panic("emit_store_mem: mixed architectures")
    end
  end  end
end

# ———————————————————————————————————————————————————————————————
# Sized memory access (respects narrow storage widths)
# ———————————————————————————————————————————————————————————————
# The layout engine defines narrow storage sizes (Bool=1, i8/u8=1, i16/u16=2,
# i32/u32=4, 64-bit=8). These primitives load/store exactly the field's storage
# width so adjacent narrow fields are never corrupted by an 8-byte access.
enum MemWidth
  W8
  W16
  W32
  W64
end

enum Extension
  Zero
  Sign
  None
end

# Storage width of a scalar type in memory (bytes).  The primitive widths are
# intrinsic; EVERY non-immediate representation (StringPtr, heap headers,
# inline aggregates, pointers, opaque handles) occupies a pointer-width slot —
# exactly what the layout engine's repr_storage_size returns (pointer_size for
# all of them). The former W64-for-compound fallback is now derived from the
# Repr decision table through codegen_type_repr instead of being re-decided
# here.
def storage_width_of(inout ctx: CodegenCtx, ty: Type) -> MemWidth
  match codegen_type_repr(ctx, ty)
  when Repr::Immediate then
    match ty
    when Type::Bool then MemWidth::W8
    when Type::I8 then MemWidth::W8
    when Type::U8 then MemWidth::W8
    when Type::I16 then MemWidth::W16
    when Type::U16 then MemWidth::W16
    when Type::I32 then MemWidth::W32
    when Type::U32 then MemWidth::W32
    when Type::F32 then MemWidth::W32
    when Type::Char then MemWidth::W32
    when Type::I64 then MemWidth::W64
    when Type::U64 then MemWidth::W64
    when Type::Int then MemWidth::W64
    when Type::UInt then MemWidth::W64
    when Type::ISize then MemWidth::W64
    when Type::USize then MemWidth::W64
    when Type::F64 then MemWidth::W64
    when _ then MemWidth::W64
    end
  when _ then MemWidth::W64
  end  end
end

# Extension rule when loading a narrow value into a 64-bit register.
def storage_signedness_of(ty: Type) -> Extension
  match ty
  when Type::I8 then Extension::Sign
  when Type::I16 then Extension::Sign
  when Type::I32 then Extension::Sign
  when Type::Int then Extension::Sign
  when Type::ISize then Extension::Sign
  when Type::I64 then Extension::Sign
  when Type::Char then Extension::Sign
  when Type::Bool then Extension::Zero
  when Type::U8 then Extension::Zero
  when Type::U16 then Extension::Zero
  when Type::U32 then Extension::Zero
  when Type::UInt then Extension::Zero
  when Type::USize then Extension::Zero
  when Type::U64 then Extension::Zero
  when _ then Extension::None
  end  end
end

# LOAD a value of `width` bytes from [addr + offset] into `dst`, applying the
# given extension when widening into the 64-bit register.
def emit_load_mem_sized(inout ctx: CodegenCtx, dst: PhysReg, addr: PhysReg, offset: i32, width: MemWidth, extension: Extension) -> Unit
  match dst
  when PhysReg::X64Reg(d) then
    match addr
    when PhysReg::X64Reg(b) then
      match width
      when MemWidth::W8 then
        match extension
        when Extension::Sign then x64_movsx_r64_m8(&mut ctx.text, d, b, offset)
        when _ then x64_movzx_r64_m8(&mut ctx.text, d, b, offset)
        end
      when MemWidth::W16 then
        match extension
        when Extension::Sign then x64_movsx_r64_m16(&mut ctx.text, d, b, offset)
        when _ then x64_movzx_r64_m16(&mut ctx.text, d, b, offset)
        end
      when MemWidth::W32 then
        match extension
        when Extension::Sign then x64_movsx_r64_m32(&mut ctx.text, d, b, offset)
        when _ then x64_mov_r32_m32(&mut ctx.text, d, b, offset)
        end
      when MemWidth::W64 then
        x64_mov_rm(&mut ctx.text, d, b, offset)
      end
    when _ then panic("emit_load_mem_sized: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match addr
    when PhysReg::A64Reg(b) then
      # Resolve the effective address. Narrow AArch64 loads use an unsigned
      # scaled immediate; materialize the address into X15 whenever the offset
      # is nonzero so the sized access always uses offset 0.
      var ab = b
      var off = offset
      if off != 0 then
        let raw = off as i64
        var ext = raw
        if (raw & 2147483648) != 0 then
          ext = raw | (-4294967296)
        end
        a64_mov_ri(&mut ctx.text, A64::X15, ext)
        if ext < 0 then
          a64_sub_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        else
          a64_add_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        end
        ab = A64::X15
        off = 0
      end
      match width
      when MemWidth::W8 then
        a64_ldrb(&mut ctx.text, d, ab, off as u32)
        if extension == Extension::Sign then
          a64_lsl(&mut ctx.text, d, d, 56)
          a64_mov_ri(&mut ctx.text, A64::X15, 56)
          a64_asr_rrr(&mut ctx.text, d, d, A64::X15)
        end
      when MemWidth::W16 then
        a64_ldrh(&mut ctx.text, d, ab, off as u32)
        if extension == Extension::Sign then
          a64_lsl(&mut ctx.text, d, d, 48)
          a64_mov_ri(&mut ctx.text, A64::X15, 48)
          a64_asr_rrr(&mut ctx.text, d, d, A64::X15)
        end
      when MemWidth::W32 then
        a64_ldr_w(&mut ctx.text, d, ab, off as u32)
        if extension == Extension::Sign then
          a64_sxtw(&mut ctx.text, d, d)
        end
      when MemWidth::W64 then
        a64_ldr(&mut ctx.text, d, ab, off as u32)
      end
    when _ then panic("emit_load_mem_sized: mixed architectures")
    end
  end  end
end

# STORE the low `width` bytes of `src` into [addr + offset].
def emit_store_mem_sized(inout ctx: CodegenCtx, addr: PhysReg, offset: i32, src: PhysReg, width: MemWidth) -> Unit
  match addr
  when PhysReg::X64Reg(b) then
    match src
    when PhysReg::X64Reg(s) then
      match width
      when MemWidth::W8 then x64_mov_m8_r8(&mut ctx.text, b, offset, s)
      when MemWidth::W16 then x64_mov_m16_r16(&mut ctx.text, b, offset, s)
      when MemWidth::W32 then x64_mov_m32_r32(&mut ctx.text, b, offset, s)
      when MemWidth::W64 then x64_mov_mr(&mut ctx.text, b, offset, s)
      end
    when _ then panic("emit_store_mem_sized: mixed architectures")
    end
  when PhysReg::A64Reg(b) then
    match src
    when PhysReg::A64Reg(s) then
      var ab = b
      var off = offset
      if off != 0 then
        let raw = off as i64
        var ext = raw
        if (raw & 2147483648) != 0 then
          ext = raw | (-4294967296)
        end
        a64_mov_ri(&mut ctx.text, A64::X15, ext)
        if ext < 0 then
          a64_sub_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        else
          a64_add_rrr(&mut ctx.text, A64::X15, b, A64::X15)
        end
        ab = A64::X15
        off = 0
      end
      match width
      when MemWidth::W8 then a64_strb(&mut ctx.text, s, ab, off as u32)
      when MemWidth::W16 then a64_strh(&mut ctx.text, s, ab, off as u32)
      when MemWidth::W32 then a64_str_w(&mut ctx.text, s, ab, off as u32)
      when MemWidth::W64 then a64_str(&mut ctx.text, s, ab, off as u32)
      end
    when _ then panic("emit_store_mem_sized: mixed architectures")
    end
  end  end
end

# ———————————————————————————————————————————————————————————————
# UNALIGNED load/store lowering (the @packed attribute's memory accesses)
# ———————————————————————————————————————————————————————————————
# A @packed aggregate's fields sit at the PACKED offsets (no padding), so
# a wider-than-1 field (a u32 at offset 1, a u64 at offset 4 — the
# kernel epoll_event shape { u32 events @ 0, u64 data @ 4 }) is accessed
# at a misaligned address. A direct `mov` of that width at a misaligned
# address is undefined on the target (and faults on strict-alignment
# AArch64), so the codegen's load/store width paths route the MISALIGNED
# accesses through the BYTE-WISE lowering:
#   load  = assemble the little-endian value byte by byte
#           (b0 | b1<<8 | ... — zero-extended into the register, then
#           sign-extended per the storage signedness);
#   store = store each byte of the value ((src >> 8*i) & 0xFF) into
#           [addr + i].
# The CHOICE is made statically: a projected place whose final offset is
# KNOWN at compile time and not a multiple of the access width lowers
# unaligned (the aligned path is used everywhere else — the unaligned
# path only where the attributed layout demands it).
#
# The width in bytes of a MemWidth — the unaligned check's modulus.
def mem_width_bytes(width: MemWidth) -> Int
  match width
  when MemWidth::W8 then 1
  when MemWidth::W16 then 2
  when MemWidth::W32 then 4
  when MemWidth::W64 then 8
  end  end
end

# ———————————————————————————————————————————————————————————————
# The place's FINAL STATIC byte offset — the unaligned-access decision
# ———————————————————————————————————————————————————————————————
# The byte offset the LAST projection contributes to the place address
# (Field/TupleIndex/ConstantIndex offsets are compile-time constants; a
# dynamic final projection — ProjIndex — cannot be decided statically).
# The unaligned load/store lowering (emit_load_mem_sized_unaligned /
# emit_store_mem_sized_unaligned — the @packed attribute's misaligned
# field accesses) consults this: when the final static offset is not a
# multiple of the access width, the place address base (stack slots are
# 8-aligned, heap payloads 16-aligned) makes the access misaligned and
# the byte-wise lowering is chosen. Returns -1 when the offset is not
# statically decidable (the aligned path is used).
def place_final_static_offset(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place) -> Int
  if place.projections.len() == 0 then
    return -1
  end
  var current_ty = local_type(fctx, place.local.id)
  var downcast_variant: Option[VariantId] = Option::None
  var last_static = 0
  var has_static_last = true
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then
      current_ty = project_deref_type(ctx, &current_ty)
    when Projection::Variant(vid) then
      downcast_variant = Option::Some(vid)
    when Projection::Field(fid) then
      last_static = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
      current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
    when Projection::TupleIndex(idx) then
      last_static = projected_tuple_offset(ctx, &current_ty, idx)
      current_ty = projected_tuple_type(ctx, &current_ty, idx)
    when Projection::ProjConstantIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    when Projection::ProjIndex(_) then
      # A dynamic final index: the element offset is runtime — the
      # alignment cannot be decided statically.
      has_static_last = false
      current_ty = project_index_type(ctx, &current_ty)
    end
  end
  if has_static_last then last_static else -1 end
end

# The place-address base alignment check: a projected place whose FINAL
# static offset is known and not a multiple of `width_bytes` bytes is a
# MISALIGNED access (the @packed attribute's packed field offsets) — the
# byte-wise unaligned lowering must be used. All runtime bases (the
# 8-aligned stack slots, the 16-aligned heap payloads) are multiples of
# every supported access width (1/2/4/8), so the static offset alone
# decides the alignment.
def place_access_is_unaligned(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, width: MemWidth) -> Bool
  let wb = mem_width_bytes(width)
  if wb <= 1 then
    false
  else
    let off = place_final_static_offset(ctx, fctx, place)
    off >= 0 && (off % wb) != 0
  end
end

# The byte-wise UNALIGNED load: assembles the little-endian value of
# `width` bytes from [addr + 0 .. addr + width) into `dst`, then applies
# the storage extension. `dst` may alias `addr` (the canonical
# emit_load_place pattern computes the address INTO the destination
# register): the address is copied to the scratch register first.
def emit_load_mem_sized_unaligned(inout ctx: CodegenCtx, dst: PhysReg, addr: PhysReg, width: MemWidth, extension: Extension) -> Unit
  let scratch = scratch_reg(ctx.target.arch)
  var a = addr
  # Preserve the address when the destination aliases it.
  if phys_reg_id(dst) == phys_reg_id(a) then
    emit_mov_rr(ctx, scratch, a)
    a = scratch
  end
  let bytes = mem_width_bytes(width)
  match dst
  when PhysReg::X64Reg(d) then
    match a
    when PhysReg::X64Reg(base) then
      match scratch2_reg(ctx.target.arch)
      when PhysReg::X64Reg(t) then
        var bi = 0
        while bi < bytes do
          x64_movzx_r64_m8(&mut ctx.text, t, base, bi as i32)
          if bi > 0 then
            x64_shl_ri(&mut ctx.text, t, (bi * 8) as u8)
            x64_or_rr(&mut ctx.text, d, t)
          else
            x64_mov_rr(&mut ctx.text, d, t)
          end
          bi = bi + 1
        end
        # The storage extension on the assembled narrow value.
        match extension
        when Extension::Sign then
          # Sign-extend the register-held narrow value through the stack
          # (the movsx memory forms are the x86 sign-extension authority).
          emit_push(ctx, dst)
          match sp_reg(ctx.target.arch)
          when PhysReg::X64Reg(spx) then
            match width
            when MemWidth::W8 then x64_movsx_r64_m8(&mut ctx.text, d, spx, 0)
            when MemWidth::W16 then x64_movsx_r64_m16(&mut ctx.text, d, spx, 0)
            when MemWidth::W32 then x64_movsx_r64_m32(&mut ctx.text, d, spx, 0)
            when MemWidth::W64 then ()
            end
          when _ then panic("emit_load_mem_sized_unaligned: mixed architectures")
          end
          emit_pop(ctx, scratch)
        when _ then ()
        end
      when _ then panic("emit_load_mem_sized_unaligned: mixed architectures")
      end
    when _ then panic("emit_load_mem_sized_unaligned: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match a
    when PhysReg::A64Reg(base) then
      match scratch2_reg(ctx.target.arch)
      when PhysReg::A64Reg(t) then
        var bi = 0
        while bi < bytes do
          a64_ldrb(&mut ctx.text, t, base, bi as u32)
          if bi > 0 then
            a64_lsl(&mut ctx.text, t, t, (bi * 8) as u32)
            a64_orr_rrr(&mut ctx.text, d, d, t)
          else
            a64_mov_rr(&mut ctx.text, d, t)
          end
          bi = bi + 1
        end
        match extension
        when Extension::Sign then
          # Sign-extend the assembled narrow value (the aligned path's
          # lsl/asr sequence).
          match width
          when MemWidth::W8 then
            a64_lsl(&mut ctx.text, d, d, 56)
            a64_mov_ri(&mut ctx.text, A64::X15, 56)
            a64_asr_rrr(&mut ctx.text, d, d, A64::X15)
          when MemWidth::W16 then
            a64_lsl(&mut ctx.text, d, d, 48)
            a64_mov_ri(&mut ctx.text, A64::X15, 48)
            a64_asr_rrr(&mut ctx.text, d, d, A64::X15)
          when MemWidth::W32 then
            a64_sxtw(&mut ctx.text, d, d)
          when MemWidth::W64 then ()
          end
        when _ then ()
        end
      when _ then panic("emit_load_mem_sized_unaligned: mixed architectures")
      end
    when _ then panic("emit_load_mem_sized_unaligned: mixed architectures")
    end
  end
end

# The byte-wise UNALIGNED store: stores each byte of `src`'s low `width`
# bytes into [addr + i] (the little-endian byte order).
def emit_store_mem_sized_unaligned(inout ctx: CodegenCtx, addr: PhysReg, src: PhysReg, width: MemWidth) -> Unit
  let bytes = mem_width_bytes(width)
  # The byte temp must be distinct from BOTH addr and src: the callers
  # may pass a scratch2-register address (store_place's base is
  # scratch2_reg) or a scratch-register source — clobbering either would
  # corrupt the store.
  let s2 = scratch2_reg(ctx.target.arch)
  let tmp_reg = if phys_reg_id(s2) == phys_reg_id(addr) || phys_reg_id(s2) == phys_reg_id(src) then
    scratch_reg(ctx.target.arch)
  else
    s2
  end
  match addr
  when PhysReg::X64Reg(b) then
    match src
    when PhysReg::X64Reg(s) then
      match tmp_reg
      when PhysReg::X64Reg(t) then
        var bi = 0
        while bi < bytes do
          x64_mov_rr(&mut ctx.text, t, s)
          if bi > 0 then
            x64_shr_ri(&mut ctx.text, t, (bi * 8) as u8)
          end
          x64_mov_m8_r8(&mut ctx.text, b, bi as i32, t)
          bi = bi + 1
        end
      when _ then panic("emit_store_mem_sized_unaligned: mixed architectures")
      end
    when _ then panic("emit_store_mem_sized_unaligned: mixed architectures")
    end
  when PhysReg::A64Reg(b) then
    match src
    when PhysReg::A64Reg(s) then
      match tmp_reg
      when PhysReg::A64Reg(t) then
        var bi = 0
        while bi < bytes do
          if bi > 0 then
            a64_lsr(&mut ctx.text, t, s, (bi * 8) as u32)
          else
            a64_mov_rr(&mut ctx.text, t, s)
          end
          a64_strb(&mut ctx.text, t, b, bi as u32)
          bi = bi + 1
        end
      when _ then panic("emit_store_mem_sized_unaligned: mixed architectures")
      end
    when _ then panic("emit_store_mem_sized_unaligned: mixed architectures")
    end
  end
end

# Frame pointer register
def fp_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RBP)
  when Arch::AArch64 then PhysReg::A64Reg(A64::FP)
  end  end
end

# Stack pointer register
def sp_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RSP)
  when Arch::AArch64 then PhysReg::A64Reg(A64::SP)
  end  end
end

# Second scratch register (for binop RHS etc.)
def scratch2_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::R10)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X14)
  end  end
end

# XOR/zero a register
def emit_zero_reg(inout ctx: CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_xor_rr(&mut ctx.text, xr, xr)
  when PhysReg::A64Reg(ar) then a64_mov_rr(&mut ctx.text, ar, A64::XZR)
  end  end
end

# Load 64-bit float from stack into GPR (for float operations through GPR)
def emit_load_fp_from_stack(inout ctx: CodegenCtx, dst: PhysReg, base: PhysReg, offset: i32) -> Unit
  emit_load_mem(ctx, dst, base, offset)
end

# Emit a fixed 5-byte sequence directly into the text segment.
def emit_raw_bytes(inout ctx: CodegenCtx, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8) -> Unit
  emit8(&mut ctx.text, b0)
  emit8(&mut ctx.text, b1)
  emit8(&mut ctx.text, b2)
  emit8(&mut ctx.text, b3)
  emit8(&mut ctx.text, b4)
end

# Emit raw 32-bit value (for ARM64 instructions)
def emit_raw_u32(inout ctx: CodegenCtx, val: u32) -> Unit
  emit32_le(&mut ctx.text, val)
end

# Extract ARM64 register code from a GPR PhysReg
def a64_code_from_gpr(r: PhysReg) -> u32
  match r
  when PhysReg::A64Reg(ar) then a64_code(ar)
  when _ then 0
  end  end
end

# AND register with immediate (for truncation masks)
def emit_and_ri(inout ctx: CodegenCtx, r: PhysReg, imm: i32) -> Unit
  match r
  when PhysReg::X64Reg(xr) then
    x64_and_ri(&mut ctx.text, xr, imm)
  when PhysReg::A64Reg(ar) then
    a64_and_ri(&mut ctx.text, ar, imm as u32)
  end  end
end

# Move with 32-bit zero extension (for ZeroExtend cast)
def emit_mov_r32(inout ctx: CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then
    match src
    when PhysReg::X64Reg(xs) then x64_mov_r32(&mut ctx.text, xd, xs)
    when _ then ()
    end
  when PhysReg::A64Reg(ad) then
    match src
    when PhysReg::A64Reg(as_) then a64_mov_w(&mut ctx.text, ad, as_)
    when _ then ()
    end
  end  end
end

# Sign-extend 32-bit to 64-bit (for SignExtend cast)
def emit_movsxd(inout ctx: CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then
    match src
    when PhysReg::X64Reg(xs) then x64_movsxd(&mut ctx.text, xd, xs)
    when _ then ()
    end
  when PhysReg::A64Reg(ad) then
    match src
    when PhysReg::A64Reg(as_) then a64_sxtw(&mut ctx.text, ad, as_)
    when _ then ()
    end
  end  end
end

# ADD reg, reg, reg  (dst = n + m)
def emit_add_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_add_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_add: mixed arch")
      end
    when _ then panic("emit_add: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_add_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_add: mixed arch")
      end
    when _ then panic("emit_add: mixed arch")
    end
  end  end
end

# SUB reg, reg, reg  (dst = n - m)
def emit_sub_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_sub_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_sub: mixed arch")
      end
    when _ then panic("emit_sub: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_sub_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_sub: mixed arch")
      end
    when _ then panic("emit_sub: mixed arch")
    end
  end  end
end

# Convenience wrappers used by statement lowering paths.
def emit_lea_global(inout ctx: CodegenCtx, symbol: String, dst: PhysReg) -> Unit
  emit_lea_label(ctx, dst, symbol)
end

def emit_load_indirect(inout ctx: CodegenCtx, base: PhysReg, offset: i32, dst: PhysReg) -> Unit
  emit_load_mem(ctx, dst, base, offset)
end

def emit_sub_rr(inout ctx: CodegenCtx, subtrahend: PhysReg, dst: PhysReg) -> Unit
  emit_sub_rrr(ctx, dst, dst, subtrahend)
end

def emit_store_indirect(inout ctx: CodegenCtx, src: PhysReg, base: PhysReg, offset: i32) -> Unit
  emit_store_mem(ctx, base, offset, src)
end

def emit_call_direct(inout ctx: CodegenCtx, symbol: String) -> Unit
  emit_call_extern(ctx, symbol)
end

# MUL reg, reg, reg
def emit_mul_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_imul_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_mul: mixed arch")
      end
    when _ then panic("emit_mul: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_mul_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_mul: mixed arch")
      end
    when _ then panic("emit_mul: mixed arch")
    end
  end  end
end

# SDIV: dst = n / m
def emit_sdiv(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        x64_mov_rr(&mut ctx.text, X64::RAX, xn)
        x64_cqo(&mut ctx.text)
        x64_idiv_r(&mut ctx.text, xm)
        if x64_code(xd) != x64_code(X64::RAX) then
          x64_mov_rr(&mut ctx.text, xd, X64::RAX)
        end
      when _ then panic("emit_sdiv: mixed arch")
      end
    when _ then panic("emit_sdiv: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_sdiv_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_sdiv: mixed arch")
      end
    when _ then panic("emit_sdiv: mixed arch")
    end
  end  end
end

# MOD: dst = n % m
def emit_smod(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        x64_mov_rr(&mut ctx.text, X64::RAX, xn)
        x64_cqo(&mut ctx.text)
        x64_idiv_r(&mut ctx.text, xm)
        if x64_code(xd) != x64_code(X64::RDX) then
          x64_mov_rr(&mut ctx.text, xd, X64::RDX)
        end
      when _ then panic("emit_smod: mixed arch")
      end
    when _ then panic("emit_smod: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then
        a64_sdiv_rrr(&mut ctx.text, A64::X15, an, am)
        emit32_le(&mut ctx.text, 0x9B008000 | (a64_code(am) << 16) | (a64_code(an) << 10) | (a64_code(A64::X15) << 5) | a64_code(ad))
      when _ then panic("emit_smod: mixed arch")
      end
    when _ then panic("emit_smod: mixed arch")
    end
  end  end
end

# AND/OR/XOR reg, reg, reg
def emit_and_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_and_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_and: mixed arch")
      end
    when _ then panic("emit_and: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_and_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_and: mixed arch")
      end
    when _ then panic("emit_and: mixed arch")
    end
  end  end
end

def emit_or_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_or_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_or: mixed arch")
      end
    when _ then panic("emit_or: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_orr_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_or: mixed arch")
      end
    when _ then panic("emit_or: mixed arch")
    end
  end  end
end

def emit_xor_rrr(inout ctx: CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_xor_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_xor: mixed arch")
      end
    when _ then panic("emit_xor: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_eor_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_xor: mixed arch")
