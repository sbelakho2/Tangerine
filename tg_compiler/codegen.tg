def load_operand_binop_input(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, op: &MirOperand, dst: PhysReg) -> Unit
  match &op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match &cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(name) then
      emit_lea_label(ctx, dst, name.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(name) then
      emit_lea_label(ctx, dst, name.clone())
    end
  end
end

def load_operand_control_input(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, op: &MirOperand, dst: PhysReg) -> Unit
  match &op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match &cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(name) then
      emit_lea_label(ctx, dst, name.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(name) then
      emit_lea_label(ctx, dst, name.clone())
    end
  end
end

def load_place(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, place: &Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(r) then
      if place.projections.is_empty() then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      else
        emit_mov_rr(ctx, dst, r)
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Stack(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Spilled(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    end
  when Option::None then
    println("[codegen] load_place unknown local=" + place.local.id.to_string() + " func=" + fctx.func.name + " projections=" + place.projections.len().to_string())
    panic("load_place: unknown local " + place.local.id.to_string())
  end
end

# Look up the byte offset of field at index `idx` for a given TypeId.
# MUST use layout engine API - no ad-hoc offsets.
# The type_field_offsets map is populated from layout_engine.compute_all_layouts.
def resolve_field_byte_offset(ctx: &CodegenCtx, type_id: Int, idx: Int) -> Int
  match ctx.type_field_offsets.get(type_id)
  when Option::Some(offsets) then
    if idx < offsets.len() then offsets[idx] else idx * 8 end
  when Option::None then 
    idx * 8
  end
end

def resolve_field_byte_size(ctx: &CodegenCtx, type_id: Int, idx: Int) -> Int
  match ctx.type_field_sizes.get(type_id)
  when Option::Some(sizes) then
    if idx < sizes.len() then sizes[idx] else 8 end
  when Option::None then 8
  end
end

# Get the TypeId from a local's type, returns -1 if not a Named type.
# Extract the TypeId from a type, unwrapping through Ref/RefMut
def extract_named_type_id(ty: &Type) -> Int
  match ty
  when Type::Named(tid, _) then tid.id
  when Type::Ref(inner, _) then extract_named_type_id(&inner)
  when Type::RefMut(inner, _) then extract_named_type_id(&inner)
  when Type::Owned(inner) then extract_named_type_id(&inner)
  when Type::Ptr(inner) then extract_named_type_id(&inner)
  when Type::PtrMut(inner) then extract_named_type_id(&inner)
  when Type::Box(inner) then extract_named_type_id(&inner)
  when Type::Rc(inner) then extract_named_type_id(&inner)
  when _ then -1
  end
end

def type_name_by_id(ctx: &CodegenCtx, type_id: Int) -> String
  if type_id < 0 then return "" end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end
end

def project_deref_type(ty: &Type) -> Type
  match ty
  when Type::Ref(inner, _) then inner.clone()
  when Type::RefMut(inner, _) then inner.clone()
  when Type::Owned(inner) then inner.clone()
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when Type::Box(inner) then inner.clone()
  when Type::Rc(inner) then inner.clone()
  when other then other.clone()
  end
end

def type_is_unit(ty: &Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end
end

def emit_len_ref_derefs(ctx: &mut CodegenCtx, reg: PhysReg, ty: &Type) -> Unit
  mut current_ty = ty.clone()
  while is_ref_like_type(&current_ty) do
    let inner_ty = project_deref_type(&current_ty)
    let value_ty = strip_receiver_ptr_like_type(&inner_ty)
    if is_heap_collection_type(ctx, &value_ty) || type_is_unit(&inner_ty) || type_is_unit(&value_ty) then
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = inner_ty
    else
      return
    end
  end
end

def project_index_type(ctx: &CodegenCtx, ty: &Type) -> Type
  match ty
  when Type::Array(elem, _) then elem.clone()
  when Type::Slice(elem) then elem.clone()
  when Type::String then Type::Char
  when Type::Named(tid, args) then
    let qualified = type_name_by_id(ctx, tid.id)
    let type_name = bare_name_from_qualified(qualified)
    if (type_name == "Vec" || type_name == "Array") && !args.is_empty() then
      args[0].clone()
    else if (type_name == "Map" || type_name == "HashMap") && args.len() >= 2 then
      args[1].clone()
    else if (type_name == "Set" || type_name == "HashSet") && !args.is_empty() then
      args[0].clone()
    else
      Type::Unit
    end
  when Type::Ref(inner, _) then project_index_type(ctx, inner)
  when Type::RefMut(inner, _) then project_index_type(ctx, inner)
  when Type::Owned(inner) then project_index_type(ctx, inner)
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when Type::Box(inner) then project_index_type(ctx, inner)
  when Type::Rc(inner) then project_index_type(ctx, inner)
  when _ then Type::Unit
  end
end

def project_field_type(ctx: &CodegenCtx, ty: &Type, downcast_disc: Int, idx: Int, field_name: &String) -> Type
  match ty
  when Type::Tuple(elems) then
    if idx < elems.len() then elems[idx].clone() else Type::Unit end
  when Type::Named(tid, _) then
    match lookup_type_def(ctx, tid.id)
    when Option::Some(td) then
      match td.kind
      when MirTypeDefKind::Struct(fields) then
        # The lowering may emit projections whose index is a name hash rather
        # than the real position (stage0 fieldIndex).  Resolve by NAME first
        # so the projected type tracks the correct field.
        let resolved_idx = match resolve_field_idx_by_name(ctx, tid.id, field_name)
        when Option::Some(fidx) then fidx
        when Option::None then idx
        end
        if resolved_idx < fields.len() then
          return fields[resolved_idx].ty.clone()
        end
      when MirTypeDefKind::Enum(variants) then
        for variant in variants do
          if variant.discriminant == downcast_disc && idx < variant.fields.len() then
            return variant.fields[idx].clone()
          end
        end
      end
    when Option::None then ()
    end
    Type::Unit
  when Type::Ref(inner, _) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::RefMut(inner, _) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::Owned(inner) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::Ptr(inner) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::PtrMut(inner) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::Box(inner) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when Type::Rc(inner) then project_field_type(ctx, inner, downcast_disc, idx, field_name)
  when _ then Type::Unit
  end
end

def resolve_projected_field_offset(ctx: &CodegenCtx, ty: &Type, downcast_disc: Int, idx: Int, field_name: &String) -> Int
  let tid = extract_named_type_id(ty)
  if tid >= 0 && downcast_disc >= 0 && is_enum_type_id(ctx, tid) then
    enum_field_offset_for_discriminant(ctx, tid, downcast_disc, idx)
  else if tid >= 0 then
    # The lowering may emit projections whose index is a name hash rather
    # than the real position (stage0 fieldIndex).  Resolve by NAME against
    # the type definition so struct field offsets stay correct.
    let resolved_idx = match resolve_field_idx_by_name(ctx, tid, field_name)
    when Option::Some(fidx) then fidx
    when Option::None then idx
    end
    resolve_field_byte_offset(ctx, tid, resolved_idx)
  else
    idx * 8
  end
end

def resolve_field_idx_by_name(ctx: &CodegenCtx, type_id: Int, name: &String) -> Option[Int]
  match ctx.type_field_name_index.get(type_id)
  when Option::Some(name_map) then
    match name_map.get(name)
    when Option::Some(fidx) then return Option::Some(fidx)
    when Option::None then ()
    end
  when Option::None then ()
  end
  # Fall back to a linear scan of the type definition (covers types without
  # a precomputed layout, e.g. enum payload field lookups).
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      mut i = 0
      while i < fields.len() do
        if fields[i].name == name then return Option::Some(i) end
        i = i + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  Option::None
end

def resolve_projected_field_size(ctx: &CodegenCtx, ty: &Type, downcast_disc: Int, idx: Int) -> Int
  let tid = extract_named_type_id(ty)
  if tid >= 0 && downcast_disc >= 0 && is_enum_type_id(ctx, tid) then
    8
  else if tid >= 0 then
    resolve_field_byte_size(ctx, tid, idx)
  else
    8
  end
end

def local_type_id(fctx: &FnCodegenCtx, local_id: Int) -> Int
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return extract_named_type_id(&local.ty)
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return extract_named_type_id(&param.ty)
    end
  end
  -1
end

def local_type(fctx: &FnCodegenCtx, local_id: Int) -> Type
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return local.ty.clone()
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return param.ty.clone()
    end
  end
  Type::Unit
end

def place_type(ctx: &CodegenCtx, fctx: &FnCodegenCtx, place: &Place) -> Type
  mut current_ty = local_type(fctx, place.local.id)
  mut downcast_disc = -1
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then
      current_ty = project_deref_type(&current_ty)
    when Projection::ProjDowncast(_, disc) then
      downcast_disc = disc
    when Projection::ProjField(name, idx) then
      current_ty = project_field_type(ctx, &current_ty, downcast_disc, idx, name)
    when Projection::ProjIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    when Projection::ProjConstantIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    end
  end
  current_ty
end

def operand_type_id(ctx: &CodegenCtx, fctx: &FnCodegenCtx, op: &MirOperand) -> Int
  match op.kind
  when MirOperandKind::MirCopy(place) then extract_named_type_id(&place_type(ctx, fctx, &place))
  when MirOperandKind::MirMovePlace(place) then extract_named_type_id(&place_type(ctx, fctx, &place))
  when MirOperandKind::MirConstant(cst) then extract_named_type_id(&cst.ty)
  end
end

def operand_type(ctx: &CodegenCtx, fctx: &FnCodegenCtx, op: &MirOperand) -> Type
  match op.kind
  when MirOperandKind::MirCopy(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirMovePlace(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirConstant(cst) then cst.ty.clone()
  end
end

def is_ref_like_type(ty: &Type) -> Bool
  match ty
  when Type::Ref(_, _) then true
  when Type::RefMut(_, _) then true
  when _ then false
  end
end

def is_receiver_ptr_like_type(ty: &Type) -> Bool
  match ty
  when Type::Ref(_, _) then true
  when Type::RefMut(_, _) then true
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end
end

def strip_ref_like_type(ty: &Type) -> Type
  match ty
  when Type::Ref(inner, _) then strip_ref_like_type(&inner)
  when Type::RefMut(inner, _) then strip_ref_like_type(&inner)
  when other then other.clone()
  end
end

def strip_receiver_ptr_like_type(ty: &Type) -> Type
  match ty
  when Type::Ref(inner, _) then strip_receiver_ptr_like_type(&inner)
  when Type::RefMut(inner, _) then strip_receiver_ptr_like_type(&inner)
  when Type::Ptr(inner) then strip_receiver_ptr_like_type(&inner)
  when Type::PtrMut(inner) then strip_receiver_ptr_like_type(&inner)
  when other then other.clone()
  end
end

def is_string_like_type(ty: &Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::String then
    true
  when Type::Slice(elem) then
    match strip_ref_like_type(&elem)
    when Type::Char then true
    when Type::I8 then true
    when Type::U8 then true
    else false
    end
  when _ then
    false
  end
end

def is_heap_collection_type(ctx: &CodegenCtx, ty: &Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::Array(_, _) then
    true
  when Type::Slice(_) then
    true
  when Type::Map(_, _) then
    true
  when Type::Set(_) then
    true
  when Type::Named(tid, _) then
    let qualified = type_name_by_id(ctx, tid.id)
    let type_name = bare_name_from_qualified(qualified)
    type_name == "Vec" || type_name == "Array" ||
    type_name == "Map" || type_name == "HashMap" ||
    type_name == "Set" || type_name == "HashSet"
  when _ then
    false
  end
end

def deref_all_ref_like_args(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, args: &Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  mut arg_ty = operand_type(ctx, fctx, &args[0])
  while is_ref_like_type(&arg_ty) do
    emit_load_mem(ctx, rr, rr, 0)
    arg_ty = project_deref_type(&arg_ty)
  end
end

def deref_all_receiver_ptr_like_args(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, args: &Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  let arg_ty = operand_type(ctx, fctx, &args[0])
  if is_receiver_ptr_like_type(&arg_ty) then
    emit_load_mem(ctx, rr, rr, 0)
  end
end

def deref_arg_once_if_ref_like(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, args: &Vec[MirOperand], idx: Int) -> Unit
  if args.len() <= idx then
    return
  end

  let arg_ty = operand_type(ctx, fctx, &args[idx])
  if !is_ref_like_type(&arg_ty) then
    return
  end

  match arg_reg(ctx.target.arch, idx)
  when Option::Some(reg) then
    emit_load_mem(ctx, reg, reg, 0)
  when Option::None then ()
  end
end

# Detect a packed inline string (≤8 printable ASCII bytes stored little-endian in
# the value word, e.g. "Int__fmt") and, if found, materialize it into a real
# null-terminated heap buffer so downstream byte-loads operate on a valid pointer.
# target holds the value/pointer; work/cnt/byte are scratch for the scan; buf holds
# the allocated pointer. X0/X1 are preserved across the bump-alloc call.
def emit_normalize_inline_string_a64(ctx: &mut CodegenCtx, target: A64, work: A64, cnt: A64, byte: A64, buf: A64) -> Unit
  let lbl_scan = next_codegen_label(ctx, ".Lstrnorm_scan.")
  let lbl_maybe = next_codegen_label(ctx, ".Lstrnorm_maybe.")
  let lbl_packed = next_codegen_label(ctx, ".Lstrnorm_packed.")
  let lbl_np = next_codegen_label(ctx, ".Lstrnorm_np.")
  let lbl_done = next_codegen_label(ctx, ".Lstrnorm_done.")

  # Byte-scan: every byte up to a zero terminator must be printable ASCII.
  a64_mov_rr(&mut ctx.text, work, target)
  a64_mov_ri(&mut ctx.text, cnt, 0)
  def_label(&mut ctx.text, lbl_scan.clone())
  a64_mov_rr(&mut ctx.text, byte, work)
  a64_and_ri(&mut ctx.text, byte, 255)
  a64_cmp_ri(&mut ctx.text, byte, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, byte, 32)
  a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_np.clone())
  a64_cmp_ri(&mut ctx.text, byte, 127)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_np.clone())
  a64_add_rri(&mut ctx.text, cnt, cnt, 1)
  a64_cmp_ri(&mut ctx.text, cnt, 8)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_packed.clone())
  a64_lsr(&mut ctx.text, work, work, 8)
  a64_b(&mut ctx.text, lbl_scan.clone())

  def_label(&mut ctx.text, lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, cnt, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_np.clone())

  # Packed: allocate 16 bytes, store the 8 value bytes + null pad, repoint target.
  def_label(&mut ctx.text, lbl_packed)
  a64_stp_pre(&mut ctx.text, A64::X0, A64::X1, A64::SP, -16)
  a64_mov_ri(&mut ctx.text, A64::X0, 16)
  emit_call_label(ctx, "_tg_bump_alloc")
  a64_mov_rr(&mut ctx.text, buf, A64::X0)
  a64_ldp_post(&mut ctx.text, A64::X0, A64::X1, A64::SP, 16)
  a64_stur(&mut ctx.text, target, buf, 0)
  a64_stur(&mut ctx.text, A64::XZR, buf, 8)
  a64_mov_rr(&mut ctx.text, target, buf)
  a64_b(&mut ctx.text, lbl_done.clone())

  def_label(&mut ctx.text, lbl_np)
  def_label(&mut ctx.text, lbl_done)
end

def maybe_load_string_data_ptr(ctx: &mut CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
  # Disabled: the inline-string scan clobbers caller-saved registers that
  # the surrounding code relies on, causing stack corruption. In the native
  # bootstrap, all strings are heap pointers (from bump_alloc or rodata),
  # so the scan is unnecessary. The reg already holds a valid data pointer.
  ()
end

def maybe_load_string_data_ptr_disabled(ctx: &mut CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match reg
    when PhysReg::A64Reg(target) then
      match data_reg
      when PhysReg::A64Reg(work) then
        match len_reg
        when PhysReg::A64Reg(cnt) then
          match cap_reg
          when PhysReg::A64Reg(byte) then
            match scratch_reg
            when PhysReg::A64Reg(buf) then
              emit_normalize_inline_string_a64(ctx, target, work, cnt, byte, buf)
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  when _ then ()
  end
end

def normalize_string_arg0_for_current_arch(ctx: &mut CodegenCtx) -> Unit
  # String ABI is raw pointer (8 bytes, null-terminated).
  # No Vec header unwrapping needed — x0/rdi already holds the data pointer.
  ()
end

def is_enum_type_id(ctx: &CodegenCtx, type_id: Int) -> Bool
  if type_id < 0 then return false end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(_) then true
    when _ then false
    end
  when Option::None then false
  end
end

def enum_type_id_for_operands(ctx: &CodegenCtx, fctx: &FnCodegenCtx, left: &MirOperand, right: &MirOperand) -> Int
  let left_tid = operand_type_id(ctx, fctx, left)
  if is_enum_type_id(ctx, left_tid) then return left_tid end
  let right_tid = operand_type_id(ctx, fctx, right)
  if is_enum_type_id(ctx, right_tid) then return right_tid end
  -1
end

def next_codegen_label(ctx: &mut CodegenCtx, prefix: String) -> String
  let label = prefix + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  label
end

def enum_eq_helper_label(type_id: Int) -> String
  ".Lenum_eq_helper." + type_id.to_string()
end

def request_enum_eq_helper(ctx: &mut CodegenCtx, type_id: Int) -> String
  let label = enum_eq_helper_label(type_id)
  if !ctx.enum_eq_helper_requested.contains(&type_id) then
    ctx.enum_eq_helper_requested.insert(type_id)
    ctx.enum_eq_helper_queue.push(type_id)
  end
  label
end

def normalize_enum_value_to_tag(ctx: &mut CodegenCtx, reg: PhysReg) -> Unit
  # Convert an enum value (which may be a heap pointer or a raw discriminant
  # integer) into a plain discriminant tag.
  #
  # Representation:
  #   - Raw integers 0..255 are inline discriminant tags — use as-is.
  #     This covers: simple enums (no-payload variants), and statics
  #     initialized to a discriminant value.
  #   - Values >= 256 are heap pointers to enum structs whose first 8 bytes
  #     hold the discriminant tag — dereference to extract it.
  let lbl_done = next_codegen_label(ctx, ".Lenum_tag_done.")
  let lbl_deref = next_codegen_label(ctx, ".Lenum_tag_deref.")
  emit_cmp_ri(ctx, reg, 256)
  emit_jcc(ctx, CondKind::Ge, lbl_deref.clone())
  emit_jmp(ctx, lbl_done.clone())
  def_label(&mut ctx.text, lbl_deref)
  emit_load_mem(ctx, reg, reg, 0)
  def_label(&mut ctx.text, lbl_done)
end

def enum_field_relative_offset(field_types: &Vec[Type], field_idx: Int, layout: &Map[Int, Int]) -> Int
  mut rel = 0
  mut i = 0
  while i < field_types.len() do
    let field_ty = field_types[i]
    rel = align_up_int(rel, type_align(&field_ty))
    if i == field_idx then return rel end
    rel = rel + type_size(&field_ty, layout)
    i = i + 1
  end
  field_idx * 8
end

def enum_field_offset_for_discriminant(ctx: &CodegenCtx, type_id: Int, discriminant: Int, field_idx: Int) -> Int
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      for variant in variants do
        if variant.discriminant == discriminant then
          return enum_field_relative_offset(&variant.fields, field_idx, &ctx.type_layout)
        end
      end
    when _ then ()
    end
  when Option::None then ()
  end
  field_idx * 8
end

def emit_enum_eq_loaded(ctx: &mut CodegenCtx, type_id: Int, dst: PhysReg, scratch: PhysReg) -> Unit
  let arch = ctx.target.arch
  let label = request_enum_eq_helper(ctx, type_id)

  match arg_reg(arch, 1)
  when Option::Some(arg1) then
    if phys_reg_id(arg1) != phys_reg_id(scratch) then
      emit_mov_rr(ctx, arg1, scratch)
    end
  when Option::None then ()
  end

  match arg_reg(arch, 0)
  when Option::Some(arg0) then
    if phys_reg_id(arg0) != phys_reg_id(dst) then
      emit_mov_rr(ctx, arg0, dst)
    end
  when Option::None then ()
  end

  emit_call_label(ctx, label)

  let rr = ret_reg(arch)
  if phys_reg_id(dst) != phys_reg_id(rr) then
    emit_mov_rr(ctx, dst, rr)
  end
end

def emit_enum_eq_helper_body(ctx: &mut CodegenCtx, type_id: Int) -> Unit
  if ctx.enum_eq_helper_emitted.contains(&type_id) then
    return
  end
  ctx.enum_eq_helper_emitted.insert(type_id)

  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let temp = scratch_reg(arch)
  let dst = match arg_reg(arch, 0)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg0 register")
  end
  let scratch = match arg_reg(arch, 1)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg1 register")
  end
  let saved_left_offset = match arch
  when Arch::X86_64 then -8
  when Arch::AArch64 then -16
  end
  let saved_right_offset = match arch
  when Arch::X86_64 then -16
  when Arch::AArch64 then -32
  end

  align_to(&mut ctx.text, 4, arch)
  def_label(&mut ctx.text, enum_eq_helper_label(type_id))

  match arch
  when Arch::X86_64 then
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp_reg(arch))
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  end

  emit_push(ctx, dst)
  emit_push(ctx, scratch)

  normalize_enum_value_to_tag(ctx, dst)
  normalize_enum_value_to_tag(ctx, scratch)

  let lbl_false = next_codegen_label(ctx, ".Lenum_eq_false.")
  let lbl_true = next_codegen_label(ctx, ".Lenum_eq_true.")
  let lbl_done = next_codegen_label(ctx, ".Lenum_eq_done.")

  emit_cmp_rr(ctx, dst, scratch)
  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())

  mut has_payload_variant = false
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      for variant in variants do
          if variant.fields.len() > 0 then
            has_payload_variant = true
            let lbl_next_variant = next_codegen_label(ctx, ".Lenum_eq_next_variant.")
            emit_cmp_ri(ctx, dst, variant.discriminant as i32)
            emit_jcc(ctx, CondKind::Ne, lbl_next_variant.clone())

            mut field_idx = 0
            for field_ty in variant.fields do
              let field_off = 8 + enum_field_relative_offset(&variant.fields, field_idx, &ctx.type_layout)
              emit_load_mem(ctx, dst, fp, saved_left_offset)
              emit_load_mem(ctx, scratch, fp, saved_right_offset)
              emit_load_mem(ctx, dst, dst, field_off as i32)
              emit_load_mem(ctx, scratch, scratch, field_off as i32)

              match field_ty
              when Type::String then
                codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Float then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F32 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F64 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Named(tid, _) then
                if is_enum_type_id(ctx, tid.id) then
                  emit_enum_eq_loaded(ctx, tid.id, dst, scratch)
                  emit_test_rr(ctx, dst, dst)
                  emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
                else
                  emit_cmp_rr(ctx, dst, scratch)
                  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
                end
              when _ then
                emit_cmp_rr(ctx, dst, scratch)
                emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
              end

              field_idx = field_idx + 1
            end

            emit_jmp(ctx, lbl_true.clone())
            def_label(&mut ctx.text, lbl_next_variant)
          end
        end
      when _ then ()
      end
    when Option::None then ()
    end

  emit_jmp(ctx, lbl_true.clone())

  def_label(&mut ctx.text, lbl_false)
  emit_zero_reg(ctx, dst)
  emit_jmp(ctx, lbl_done.clone())

  def_label(&mut ctx.text, lbl_true)
  emit_mov_ri(ctx, dst, 1)

  def_label(&mut ctx.text, lbl_done)
  emit_pop(ctx, scratch)
  emit_pop(ctx, temp)
  match arch
  when Arch::X86_64 then
    emit_pop(ctx, fp)
    emit_ret(ctx)
  when Arch::AArch64 then
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

def emit_pending_enum_eq_helpers(ctx: &mut CodegenCtx) -> Unit
  mut idx = 0
  while idx < ctx.enum_eq_helper_queue.len() do
    let type_id = ctx.enum_eq_helper_queue[idx]
    if !ctx.enum_eq_helper_emitted.contains(&type_id) then
      emit_enum_eq_helper_body(ctx, type_id)
    end
    idx = idx + 1
  end
end

def projection_is_field(proj: &Projection) -> Bool
  match proj
  when Projection::ProjField(_, _) then true
  when _ then false
  end
end

def apply_projections(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, place: &Place, projs: &Vec[Projection], reg: PhysReg) -> Unit
  let scratch = ret_reg(ctx.target.arch)  # use return reg as scratch for index loads
  mut current_ty = local_type(fctx, place.local.id)
  mut downcast_disc = -1
  mut last_deref_unwrapped_ref = false
  # Label to skip remaining projections after an inline-tag ProjDowncast.
  # Inline tags (< 256) have no heap allocation, so there is no payload
  # struct to project into — remaining field/offset projections must be
  # skipped to avoid null-pointer dereference (ldr x0, [x0] on xzr).
  let lbl_skip_remaining = next_codegen_label(ctx, ".Lskip_remaining.")

  mut i = 0
  while i < projs.len() do
    let proj = &projs[i]
    match proj
    when Projection::ProjDeref then ()
    when _ then
      if is_ref_like_type(&current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        current_ty = project_deref_type(&current_ty)
      end
    end
    match proj
    when Projection::ProjDeref then
      last_deref_unwrapped_ref = is_ref_like_type(&current_ty)
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = project_deref_type(&current_ty)
    when Projection::ProjField(name, idx) then
      # Every struct field is an 8-byte slot holding the field VALUE (for
      # struct/collection fields that value is a pointer to the heap object).
      # Intermediate fields must LOAD the slot just like the last one: the
      # next projection operates on that value. Passing the slot address
      # through instead would make a following ProjIndex/ProjField deref the
      # field slot (obtaining the value pointer) rather than the pointed-to
      # object, breaking chains such as (*p).v[i].f.
      let offset = resolve_projected_field_offset(ctx, &current_ty, downcast_disc, idx, name)
      emit_load_mem(ctx, reg, reg, offset as i32)
      current_ty = project_field_type(ctx, &current_ty, downcast_disc, idx, name)
      last_deref_unwrapped_ref = false
    when Projection::ProjIndex(local_id) then
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
      end
      let idx_reg = scratch2_reg(ctx.target.arch)
      load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
      # Determine element size from the collection type.
      # Strings use 1-byte characters; everything else uses 8-byte pointers/ints.
      let is_byte_indexed = is_string_like_type(&current_ty)
      if !is_byte_indexed then
        # Multiply index by element size (8) using shift left 3
        match idx_reg
        when PhysReg::A64Reg(a) then a64_lsl(&mut ctx.text, a, a, 3)
        when PhysReg::X64Reg(x) then x64_shl_ri(&mut ctx.text, x, 3)
        end
      end
      # Add scaled offset to base address
      emit_add_rrr(ctx, reg, reg, idx_reg)
      if is_byte_indexed then
        # Load a single byte (zero-extended to register)
        match reg
        when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
        when PhysReg::X64Reg(_) then emit_load_mem(ctx, reg, reg, 0)  # TODO: x86 MOVZX byte
        end
      else
        emit_load_mem(ctx, reg, reg, 0)
      end
      current_ty = project_index_type(ctx, &current_ty)
      last_deref_unwrapped_ref = false
    when Projection::ProjConstantIndex(ci) then
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
      end
      let is_byte_indexed = is_string_like_type(&current_ty)
      if is_byte_indexed then
        emit_add_ri(ctx, reg, ci as i32)
        match reg
        when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
        when PhysReg::X64Reg(_) then emit_load_mem(ctx, reg, reg, 0)  # TODO: x86 MOVZX byte
        end
      else
        let offset = ci * 8
        emit_load_mem(ctx, reg, reg, offset as i32)
      end
      current_ty = project_index_type(ctx, &current_ty)
      last_deref_unwrapped_ref = false
    when Projection::ProjDowncast(name, disc) then
      downcast_disc = disc
      # Enum values may be inline tags (0..255) or heap pointers (>= 256).
      # Inline tags have no heap allocation, so there's no payload to access.
      # Heap pointers have {discriminant, payload} layout; add 8 to reach payload.
      let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
      let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
      emit_cmp_ri(ctx, reg, 256)
      emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
      # Heap pointer: add 8 to skip discriminant, reach payload.
      emit_add_ri(ctx, reg, 8)
      if i == projs.len() - 1 then
        emit_load_mem(ctx, reg, reg, 0)
      end
      emit_jmp(ctx, lbl_payload_done.clone())
      def_label(&mut ctx.text, lbl_payload_skip)
      # Inline tag: no heap allocation, zero out the payload reference.
      emit_zero_reg(ctx, reg)
      # If there are remaining projections after ProjDowncast, skip them.
      # An inline tag has no heap-allocated payload struct, so there is
      # nothing to project into — remaining projections would dereference
      # null (ldr x0, [x0]) and crash.
      if i < projs.len() - 1 then
        emit_jmp(ctx, lbl_skip_remaining.clone())
      end
      def_label(&mut ctx.text, lbl_payload_done)
      last_deref_unwrapped_ref = false
    end
    i = i + 1
  end
  def_label(&mut ctx.text, lbl_skip_remaining)
end

def load_constant(ctx: &mut CodegenCtx, cst: &MirConstant, dst: PhysReg) -> Unit
  match &cst.kind
  when MirConstantKind::MirUnit then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirBool(b) then
    if b then
      emit_mov_ri(ctx, dst, 1)
    else
      emit_zero_reg(ctx, dst)
    end
  when MirConstantKind::MirInt(i) then
    emit_mov_ri(ctx, dst, i as i64)
  when MirConstantKind::MirFloat(f) then
    # Load float bits into GPR, then move to float reg via stack
    let bits = f.to_bits() as i64
    emit_mov_ri(ctx, dst, bits)
    # Store GPR to temp stack slot, load back as float
    let sp = sp_reg(ctx.target.arch)
    emit_store_mem(ctx, sp, -8, dst)
    emit_load_fp_from_stack(ctx, dst, sp, -8)
  when MirConstantKind::MirChar(c) then
    emit_mov_ri(ctx, dst, c as i64)
  when MirConstantKind::MirString(s) then
    let label = intern_string(ctx, s)
    emit_lea_label(ctx, dst, label)
  when MirConstantKind::MirFnItem(fn_name) then
    # Load the address of a named function
    emit_lea_label(ctx, dst, fn_name.clone())
  when MirConstantKind::MirZeroSized then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirStaticRef(name) then
    # Load current value of a global/static variable: ADRP+ADD to get address, then LDR
    emit_lea_label(ctx, dst, name.clone())
    emit_load_mem(ctx, dst, dst, 0)
  when MirConstantKind::MirStaticAddr(name) then
    # Get address of a global/static variable: ADRP+ADD
    emit_lea_label(ctx, dst, name.clone())
  end
end

# ———————————————————————————————————————————————————————————————
# Store to a Place
# ———————————————————————————————————————————————————————————————

def store_place(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, place: &Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = ret_reg(ctx.target.arch)
  let place_ty = local_type(fctx, place.local.id)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    if place.projections.is_empty() then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    else
      # Save value to stack, then compute base address in a DIFFERENT
      # register so that pop(src) does not clobber the base.
      let base = scratch2_reg(ctx.target.arch)  # X14 — not X0
      emit_push(ctx, src)

      match loc
      when VarLoc::Register(r) then
        emit_mov_rr(ctx, base, r)
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, base, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, base, fp, offset)
      end

      # Walk projections except last to compute base address
      mut current_ty = place_ty
      mut downcast_disc = -1
      mut i = 0
      let n = place.projections.len()
      # Label to skip remaining projections after an inline-tag ProjDowncast.
      # Inline tags (< 256) have no heap allocation, so subsequent projection
      # code would compute garbage addresses from a zeroed base register.
      let lbl_skip_store = next_codegen_label(ctx, ".Lskip_store_proj.")
      while i < n - 1 do
        let proj = place.projections[i]
        match proj
        when Projection::ProjDeref then ()
        when _ then
          if is_ref_like_type(&current_ty) then
            emit_load_mem(ctx, base, base, 0)
            current_ty = project_deref_type(&current_ty)
          end
        end
        match proj
        when Projection::ProjDeref then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(&current_ty)
        when Projection::ProjField(name, idx) then
          # Non-last field projection: load the field VALUE so the base
          # becomes the pointed-to object (e.g. the Vec pointer for a
          # Vec-typed field), matching apply_projections semantics.
          # Only the LAST projection computes a store address via ADD.
          let field_off = resolve_projected_field_offset(ctx, &current_ty, downcast_disc, idx, name)
          emit_load_mem(ctx, base, base, field_off as i32)
          current_ty = project_field_type(ctx, &current_ty, downcast_disc, idx, name)
        when Projection::ProjDowncast(_, disc) then
          downcast_disc = disc
          # Normalize inline tags vs heap pointers before accessing payload.
          let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
          let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
          emit_cmp_ri(ctx, base, 256)
          emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
          emit_add_ri(ctx, base, 8)
          emit_jmp(ctx, lbl_payload_done.clone())
          def_label(&mut ctx.text, lbl_payload_skip)
          # Inline tag: no heap allocation, zero out the payload reference.
          emit_zero_reg(ctx, base)
          # If there are remaining non-last projections, skip them since
          # the inline tag has no heap-allocated payload struct to compute
          # addresses into.
          if i < n - 2 then
            emit_jmp(ctx, lbl_skip_store.clone())
          end
          def_label(&mut ctx.text, lbl_payload_done)
        when Projection::ProjIndex(local_id) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
          load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
          match scratch
          when PhysReg::A64Reg(a) then a64_lsl(&mut ctx.text, a, a, 3)
          when PhysReg::X64Reg(x) then x64_shl_ri(&mut ctx.text, x, 3)
          end
          emit_add_rrr(ctx, base, base, scratch)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when Projection::ProjConstantIndex(ci) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
          emit_add_ri(ctx, base, (ci * 8) as i32)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when _ then ()
        end
        i = i + 1
      end
      def_label(&mut ctx.text, lbl_skip_store)

      # Last projection determines final store offset
      let last = place.projections[n - 1]
      mut store_off: i32 = 0
      match last
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(&current_ty)
        end
      end
      match last
      when Projection::ProjDeref then
        store_off = 0
      when Projection::ProjField(name, idx) then
        let fo = resolve_projected_field_offset(ctx, &current_ty, downcast_disc, idx, name)
        store_off = fo as i32
      when Projection::ProjIndex(local_id) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
        match scratch
        when PhysReg::A64Reg(a) then a64_lsl(&mut ctx.text, a, a, 3)
        when PhysReg::X64Reg(x) then x64_shl_ri(&mut ctx.text, x, 3)
        end
        emit_add_rrr(ctx, base, base, scratch)
        store_off = 0
      when Projection::ProjConstantIndex(ci) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        store_off = (ci * 8) as i32
      when Projection::ProjDowncast(_, _) then
        store_off = 8
      when _ then
        store_off = 0
      end

      emit_pop(ctx, src)  # restore value
      emit_store_mem(ctx, base, store_off, src)
    end
  when Option::None then
    panic("store_place: unknown local " + place.local.id.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Rvalue code generation
# ———————————————————————————————————————————————————————————————

def codegen_rvalue(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, stmt: &MirStatement, dst: PhysReg) -> Unit
  match &stmt.kind
  when MirStatementKind::MirAssign(_, rv) then
    match &rv.kind
    when MirRvalueKind::MirMove(op) then
    match &op.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(name) then
        emit_lea_label(ctx, dst, name.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(name) then
        emit_lea_label(ctx, dst, name.clone())
      end
    end

    when MirRvalueKind::MirBinOp(bin_op, left, right) then
      codegen_binop(ctx, fctx, bin_op, left, right, dst)

    when MirRvalueKind::MirUnOp(un_op, operand) then
    match &operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(name) then
        emit_lea_label(ctx, dst, name.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(name) then
        emit_lea_label(ctx, dst, name.clone())
      end
    end
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, dst)
      when MirUnOp::Not    then
        emit_test_rr(ctx, dst, dst)
        emit_setcc(ctx, CondKind::Eq, dst)
      when MirUnOp::BitNot then emit_not(ctx, dst)
      end

    when MirRvalueKind::MirRef(place) then
      codegen_address_of(ctx, fctx, place, dst)

    when MirRvalueKind::MirRefMut(place) then
      codegen_address_of(ctx, fctx, place, dst)

    when MirRvalueKind::MirAggregate(kind, operands) then
      codegen_aggregate(ctx, fctx, kind, operands, dst)

    when MirRvalueKind::MirDiscriminant(place) then
      load_place(ctx, fctx, place, dst)
      normalize_enum_value_to_tag(ctx, dst)

    when MirRvalueKind::MirLen(place) then
      load_place(ctx, fctx, place, dst)
      let len_ty = place_type(ctx, fctx, place)
      emit_len_ref_derefs(ctx, dst, &len_ty)
      let len_value_ty = strip_receiver_ptr_like_type(&len_ty)
      if is_heap_collection_type(ctx, &len_value_ty) then
        let lbl_len_done = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, dst, dst)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done.clone())
        emit_load_mem(ctx, dst, dst, 8)
        def_label(&mut ctx.text, lbl_len_done)
      else
        emit_load_mem(ctx, dst, dst, 8)
      end

    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
    match &operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(name) then
        emit_lea_label(ctx, dst, name.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(name) then
        emit_lea_label(ctx, dst, name.clone())
      end
    end
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
        # cvtsi2sd xmm0, dst (via stack round-trip)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)  # cvtsi2sd xmm0, rax
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)  # movq rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # SCVTF D0, Xn  — convert GPR int to FP D0
        emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
        # FMOV Xdst, D0 — move FP bits back to GPR
        a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)  # movq xmm0, rax
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)  # cvttsd2si rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # FMOV D0, Xn  — move GPR float-bits to FP register
        a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
        # FCVTZS Xdst, D0  — convert FP to int
        emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
      # Narrowing integer casts need an explicit mask; widening is a register no-op here.
      let target_bits = type_size(&target_ty, &ctx.type_layout) * 8
      if target_bits < 64 then
        let mask = (1 << target_bits) - 1
        emit_and_ri(ctx, dst, mask as i32)
      end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_rvalue: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(operand, count) then
    # Allocate count * element_size on stack and fill with the value
    let scratch = ret_reg(ctx.target.arch)
    match &operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, scratch, 1)
        else
          emit_zero_reg(ctx, scratch)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, scratch, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, scratch, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, scratch)
        emit_load_fp_from_stack(ctx, scratch, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, scratch, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, scratch, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, scratch, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirStaticRef(name) then
        emit_lea_label(ctx, scratch, name.clone())
        emit_load_mem(ctx, scratch, scratch, 0)
      when MirConstantKind::MirStaticAddr(name) then
        emit_lea_label(ctx, scratch, name.clone())
      end
    end
    # Store element for each repetition at dst + i * 8
    mut i: UInt = 0
    while i < count do
      emit_store_mem(ctx, dst, (i * 8) as i32, scratch)
      i = i + 1
    end

    when MirRvalueKind::MirPhi(pairs) then
    # Phi nodes: values already placed by predecessor blocks.
    # Skip — no code generation needed.
    ()
    when _ then
      panic("codegen_rvalue: unsupported MIR rvalue kind")
    end
  when _ then
    panic("codegen_rvalue: expected assignment statement")
  end
end

def compute_string_locals(func: &MirFunction) -> Set[Int]
  mut strings: Set[Int] = Set::new()

  for local in func.locals do
    match local.ty
    when Type::String then strings.insert(local.id.id)
    else ()
    end
  end
  for param in func.params do
    match param.ty
    when Type::String then strings.insert(param.id.id)
    else ()
    end
  end

  strings
end

def is_string_operand(op: &MirOperand, fctx: &FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirString(_) then return true
    else ()
    end
  when MirOperandKind::MirCopy(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirMovePlace(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  end
  false
end

def is_float_operand(op: &MirOperand, fctx: &FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFloat(_) then return true
    else ()
    end
    match c.ty
    when Type::Float then return true
    when Type::F32 then return true
    when Type::F64 then return true
    when _ then ()
    end
  when MirOperandKind::MirCopy(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirMovePlace(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  end
  false
end

# String comparison helper: move operands to arg0/arg1, call inline str_cmp,
# compare result (-1/0/1) with 0, set condition code into dst.
def codegen_str_binop(ctx: &mut CodegenCtx, dst: PhysReg, scratch: PhysReg, cond: CondKind) -> Unit
  let arch = ctx.target.arch
  # Move operands to argument registers for codegen_str_cmp
  match arg_reg(arch, 1)
  when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
  when Option::None then ()
  end
  match arg_reg(arch, 0)
  when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
  when Option::None then ()
  end
  # Inline byte-by-byte comparison, result in ret_reg (-1, 0, or 1)
  codegen_str_cmp(ctx)
  let rr = ret_reg(arch)
  # Compare str_cmp result with 0 and set condition flag
  emit_cmp_ri(ctx, rr, 0)
  emit_setcc(ctx, cond, dst)
end

def codegen_binop(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, op: MirBinOp, left: &MirOperand, right: &MirOperand, dst: PhysReg) -> Unit
  let scratch = scratch2_reg(ctx.target.arch)
  load_operand_binop_input(ctx, fctx, left, dst)
  load_operand_binop_input(ctx, fctx, right, scratch)

  let is_float = is_float_operand(left, fctx) || is_float_operand(right, fctx)
  let left_ty = operand_type(ctx, fctx, left)
  let right_ty = operand_type(ctx, fctx, right)
  let left_is_string =
    is_string_operand(left, fctx) ||
    is_string_like_type(&left_ty) ||
    is_string_like_type(&strip_ref_like_type(&left_ty))
  let right_is_string =
    is_string_operand(right, fctx) ||
    is_string_like_type(&right_ty) ||
    is_string_like_type(&strip_ref_like_type(&right_ty))
  let enum_type_id = enum_type_id_for_operands(ctx, fctx, left, right)

  if is_float then
    codegen_float_binop(ctx, op, dst, scratch)
    return
  end

  match op
  when MirBinOp::Add then
    if left_is_string || right_is_string then
      # String concatenation: call _tg_str_concat(left, right)
      let arch = ctx.target.arch
      match arg_reg(arch, 1)
      when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
      when Option::None then ()
      end
      match arg_reg(arch, 0)
      when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
      when Option::None then ()
      end
      emit_call_label(ctx, "_tg_str_concat")
      let rr = ret_reg(arch)
      emit_mov_rr(ctx, dst, rr)
    else
      emit_add_rrr(ctx, dst, dst, scratch)
    end
  when MirBinOp::Sub    then emit_sub_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Mul    then emit_mul_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Div    then emit_sdiv(ctx, dst, dst, scratch)
  when MirBinOp::Mod    then emit_smod(ctx, dst, dst, scratch)
  when MirBinOp::BitAnd then emit_and_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitOr  then emit_or_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitXor then emit_xor_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Shl    then emit_shl(ctx, dst, dst, scratch)
  when MirBinOp::Shr    then emit_shr(ctx, dst, dst, scratch)
  when MirBinOp::Eq then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
    else if enum_type_id >= 0 then
      emit_enum_eq_loaded(ctx, enum_type_id, dst, scratch)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Eq, dst)
    end
  when MirBinOp::Ne then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Ne)
    else if enum_type_id >= 0 then
      emit_enum_eq_loaded(ctx, enum_type_id, dst, scratch)
      emit_test_rr(ctx, dst, dst)
      emit_setcc(ctx, CondKind::Eq, dst)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ne, dst)
    end
  when MirBinOp::Lt then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Lt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Lt, dst)
    end
  when MirBinOp::Le then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Le)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Le, dst)
    end
  when MirBinOp::Gt then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Gt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Gt, dst)
    end
  when MirBinOp::Ge then
    if left_is_string || right_is_string then
      codegen_str_binop(ctx, dst, scratch, CondKind::Ge)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ge, dst)
    end
  end
end

# Float binary operation: operands are in GPRs dst and scratch with float bit patterns.
# Move to FP registers D0/D1, compute, move result back to dst GPR.
def codegen_float_binop(ctx: &mut CodegenCtx, op: MirBinOp, dst: PhysReg, scratch: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Move GPR float-bits to FP registers: D0 = dst, D1 = scratch
    let dst_gpr = match dst
    when PhysReg::A64Reg(r) then r
    when _ then A64::X0
    end
    let scratch_gpr = match scratch
    when PhysReg::A64Reg(r) then r
    when _ then A64::X14
    end
    a64_fmov_dx(&mut ctx.text, A64V::V0, dst_gpr)
    a64_fmov_dx(&mut ctx.text, A64V::V1, scratch_gpr)
    match op
    when MirBinOp::Add then a64_fadd_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Sub then a64_fsub_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Mul then a64_fmul_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Div then a64_fdiv_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Eq then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, EQ  (CSINC Xd, XZR, XZR, NE)
      emit_raw_u32(ctx, 0x9A9F17E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ne then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, NE  (CSINC Xd, XZR, XZR, EQ)
      emit_raw_u32(ctx, 0x9A9F07E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Lt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, MI  (CSINC Xd, XZR, XZR, PL)  — MI = float less than
      emit_raw_u32(ctx, 0x9A9F57E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Le then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, LS  (CSINC Xd, XZR, XZR, HI)  — LS = float less or equal
      emit_raw_u32(ctx, 0x9A9F87E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Gt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GT  (CSINC Xd, XZR, XZR, LE)
      emit_raw_u32(ctx, 0x9A9FD7E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ge then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GE  (CSINC Xd, XZR, XZR, LT)
      emit_raw_u32(ctx, 0x9A9FB7E0 | a64_code(dst_gpr))
      return
    when _ then
      # Fallback: treat as integer op
      emit_add_rrr(ctx, dst, dst, scratch)
      return
    end
    # Move FP result back to GPR
    a64_fmov_xd(&mut ctx.text, dst_gpr, A64V::V0)
  when Arch::X86_64 then
    # x86-64: move GPR float-bits to XMM0/XMM1 via stack
    let sp = sp_reg(ctx.target.arch)
    # Store dst to stack, load as xmm0
    emit_store_mem(ctx, sp, -8, dst)
    # movsd xmm0, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    # Store scratch to stack, load as xmm1
    emit_store_mem(ctx, sp, -8, scratch)
    # movsd xmm1, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    match op
    when MirBinOp::Add then
      # addsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x58)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Sub then
      # subsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5C)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Mul then
      # mulsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x59)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Div then
      # divsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5E)
      emit8(&mut ctx.text, 0xC1)
    when _ then ()
    end
    # Move xmm0 result back to GPR via stack: movsd [rsp-8], xmm0
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x11)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    emit_load_mem(ctx, dst, sp, -8)
  end
end

def codegen_address_of(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, place: &Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)

  if place.projections.is_empty() then
    # No projections: return stack address of the local.
    # Method intrinsics dereference &self once to obtain the underlying value.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        let spill_off = fctx.frame.spill_offset - 8
        fctx.frame.spill_offset = spill_off
        emit_store_mem(ctx, fp, spill_off, r)
        emit_lea_fp(ctx, dst, spill_off)
      when VarLoc::Stack(offset) then
        emit_lea_fp(ctx, dst, offset)
      when VarLoc::Spilled(offset) then
        emit_lea_fp(ctx, dst, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end
  else
    # Has projections (e.g. opts.input_files): load the local value,
    # apply all projections except the last one normally (load), and for
    # the last one compute the address without loading the value.
    # This way the intrinsic's single dereference of &self reaches the
    # correct heap object (e.g. Vec struct) rather than the parent struct.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then emit_mov_rr(ctx, dst, r)
      when VarLoc::Stack(offset) then emit_load_mem(ctx, dst, fp, offset)
      when VarLoc::Spilled(offset) then emit_load_mem(ctx, dst, fp, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end

    mut current_ty = local_type(fctx, place.local.id)
    let n = place.projections.len()
    mut downcast_disc = -1
    mut i = 0
    # Label to skip remaining projections after an inline-tag ProjDowncast.
    # Inline tags (< 256) have no heap allocation, so there is no payload
    # struct to compute addresses into.
    let lbl_skip_addr = next_codegen_label(ctx, ".Lskip_addr_proj.")
    while i < n do
      let proj = place.projections[i]
      let is_last = i == n - 1
      # Downcast payload safety is handled in ProjDowncast arm below.
      match proj
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
          current_ty = project_deref_type(&current_ty)
        end
      end
      match proj
      when Projection::ProjDeref then
        if !is_last then
          emit_load_mem(ctx, dst, dst, 0)
        end
        current_ty = project_deref_type(&current_ty)
      when Projection::ProjField(name, idx) then
        let offset = resolve_projected_field_offset(ctx, &current_ty, downcast_disc, idx, name)
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          # Intermediate fields are 8-byte value slots (see apply_projections):
          # the address of a deeper projection is computed from the LOADED
          # value, so load the slot rather than passing its address through.
          emit_load_mem(ctx, dst, dst, offset as i32)
        end
        current_ty = project_field_type(ctx, &current_ty, downcast_disc, idx, name)
      when Projection::ProjIndex(local_id) then
        let is_byte_indexed = is_string_like_type(&current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let idx_reg = scratch2_reg(ctx.target.arch)
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
        if !is_byte_indexed then
          match idx_reg
          when PhysReg::A64Reg(a) then a64_lsl(&mut ctx.text, a, a, 3)
          when PhysReg::X64Reg(x) then x64_shl_ri(&mut ctx.text, x, 3)
          end
        end
        emit_add_rrr(ctx, dst, dst, idx_reg)
        if !is_last then
          if is_byte_indexed then
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, 0)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::ProjConstantIndex(ci) then
        let is_byte_indexed = is_string_like_type(&current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let offset = if is_byte_indexed then ci else ci * 8 end
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          if is_byte_indexed then
            if offset != 0 then
              emit_add_ri(ctx, dst, offset as i32)
            end
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, offset as i32)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::ProjDowncast(name, disc) then
        downcast_disc = disc
        # Same inline-tag check as apply_projections: ensure value is a heap pointer
        # (>= 256) before adding 8 to reach payload struct.
        let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
        let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
        emit_cmp_ri(ctx, dst, 256)
        emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
        emit_add_ri(ctx, dst, 8)
        emit_jmp(ctx, lbl_payload_done.clone())
        def_label(&mut ctx.text, lbl_payload_skip)
        # Inline tag: no heap payload exists. Materialize a safe stack-backed
        # sentinel address so downstream code never dereferences a null pointer.
        let null_off = fctx.frame.spill_offset - 8
        fctx.frame.spill_offset = null_off
        let zero = scratch_reg(ctx.target.arch)
        emit_zero_reg(ctx, zero)
        emit_store_mem(ctx, fp, null_off, zero)
        emit_lea_fp(ctx, dst, null_off)
        # If there are remaining projections after ProjDowncast, skip them.
        # An inline tag has no heap-allocated payload struct, so subsequent
        # projections would dereference null and crash.
        if !is_last then
          emit_jmp(ctx, lbl_skip_addr.clone())
        end
        def_label(&mut ctx.text, lbl_payload_done)
      end
      i = i + 1
    end
    def_label(&mut ctx.text, lbl_skip_addr)
  end
end

def codegen_aggregate(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, kind: &AggregateKind, operands: &Vec[MirOperand], dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = scratch2_reg(ctx.target.arch)
  let sp = sp_reg(ctx.target.arch)

  # Array literals must produce a Vec-compatible structure {data_ptr, len, cap}
  # so that for-loop iteration (ProjDeref + MirLen + ProjIndex) works correctly.
  match kind
  when AggregateKind::MirArray(_) then
    # Build array literals through the same runtime path used by Vec::new()+push.
    # The manual header synthesis above can leave fixed-array values pointing at
    # partially initialized storage when later loaded through the normal place path.
    emit_call_label(ctx, "_tg_array_new")
    emit_push(ctx, dst)

    mut op_idx = 0
    while op_idx < operands.len() do
      load_operand_aggregate_item(ctx, fctx, &operands[op_idx], scratch)
      emit_load_mem(ctx, dst, sp, 0)
      match ctx.target.arch
      when Arch::AArch64 then
        let elem = match scratch
        when PhysReg::A64Reg(r) then r
        when _ then A64::X1
        end
        if a64_code(elem) != a64_code(A64::X1) then
          a64_mov_rr(&mut ctx.text, A64::X1, elem)
        end
      when Arch::X86_64 then
        let elem = match scratch
        when PhysReg::X64Reg(r) then r
        when _ then X64::RSI
        end
        if x64_code(elem) != x64_code(X64::RSI) then
          x64_mov_rr(&mut ctx.text, X64::RSI, elem)
        end
      end
      emit_call_label(ctx, "_tg_array_push")
      op_idx = op_idx + 1
    end

    emit_load_mem(ctx, dst, sp, 0)
    emit_pop(ctx, scratch)
    return
  when _ then ()
  end

  # Determine total size and per-field offsets based on the aggregate kind
  let type_id = match kind
  when AggregateKind::Struct(tid, _) then tid.id
  when AggregateKind::Closure(tid) then tid.id
  when AggregateKind::Generator(tid) then tid.id
  when _ then 0
  end

  # Look up the type name to detect collection types that need heap allocation
  mut type_name = match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end

  # For collection types (Vec, Map, Set), use runtime heap allocation instead
  # of stack allocation.  These types must survive function returns, and their
  # runtime functions (e.g. _tg_array_push) expect the struct to live on the heap.
  if type_name == "Vec" || type_name == "Array" then
    emit_call_label(ctx, "_tg_array_new")
    return
  else if type_name == "Map" || type_name == "HashMap" then
    emit_call_label(ctx, "_tg_map_new")
    return
  else if type_name == "Set" || type_name == "HashSet" then
    emit_call_label(ctx, "_tg_set_new")
    return
  end

  # Try to get field offsets from the type layout
  let has_layout = match ctx.type_field_offsets.get(type_id)
  when Option::Some(_) then true
  when Option::None then false
  end

  # Calculate total size
  let total_size = if has_layout then
    match ctx.type_layout.get(type_id)
    when Option::Some(sz) then if sz > 0 then sz else operands.len() * 8 end
    when Option::None then operands.len() * 8
    end
  else
    operands.len() * 8
  end
  let aligned = align_up_int(total_size, 8)

  # Heap-allocate struct data via bump allocator so the pointer survives
  # function returns.  Stack-allocating in the callee spill area would create
  # a dangling pointer when the struct escapes via return value.
  emit_mov_ri(ctx, dst, aligned as i64)
  emit_call_label(ctx, "_tg_bump_alloc")
  # After call: dst (x0/rax) = heap pointer to allocated memory. Preserve it
  # with a balanced stack push while operand lowering may make calls/clobber dst.
  emit_push(ctx, dst)

  # Store each field at its proper offset
  let enum_discriminant = if type_id >= 0 && is_enum_type_id(ctx, type_id) && operands.len() > 0 then
    match &operands[0].kind
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirInt(disc) then disc
      when _ then -1
      end
    when _ then -1
    end
  else
    -1
  end

  mut i = 0
  while i < operands.len() do
    load_operand_aggregate_item(ctx, fctx, &operands[i], scratch)
    emit_load_mem(ctx, dst, sp, 0)
    let field_off = if enum_discriminant >= 0 then
      if i == 0 then 0 else 8 + enum_field_offset_for_discriminant(ctx, type_id, enum_discriminant, i - 1) end
    else if has_layout then
      match ctx.type_field_offsets.get(type_id)
      when Option::Some(offsets) then
        if i < offsets.len() then offsets[i] else i * 8 end
      when Option::None then i * 8
      end
    else
      i * 8
    end
    emit_store_mem(ctx, dst, field_off as i32, scratch)
    i = i + 1
  end
  emit_load_mem(ctx, dst, sp, 0)
  emit_pop(ctx, scratch)
end

# ———————————————————————————————————————————————————————————————
# Statement code generation
# ———————————————————————————————————————————————————————————————

def codegen_statement(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, block: &MirBlock, stmt_idx: Int) -> Unit
  let stmt = &block.statements[stmt_idx]
  let rr = ret_reg(ctx.target.arch)
  match &stmt.kind
  when MirStatementKind::MirAssign(ref place, MirRvalue { kind: ref rvalue_kind }) then
    mut should_store = true
    match rvalue_kind
    when MirRvalueKind::MirPhi(pairs) then
      should_store = false

    when MirRvalueKind::MirMove(ref op) then
      load_operand_rvalue_item(ctx, fctx, op, rr)

    when MirRvalueKind::MirBinOp(bin_op, ref left, ref right) then
      codegen_binop(ctx, fctx, bin_op, left, right, rr)

    when MirRvalueKind::MirUnOp(un_op, ref operand) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, rr)
      when MirUnOp::Not    then
        emit_test_rr(ctx, rr, rr)
        emit_setcc(ctx, CondKind::Eq, rr)
      when MirUnOp::BitNot then emit_not(ctx, rr)
      end

    when MirRvalueKind::MirRef(ref ref_place) then
      codegen_address_of(ctx, fctx, ref_place, rr)

    when MirRvalueKind::MirRefMut(ref ref_place) then
      codegen_address_of(ctx, fctx, ref_place, rr)

    when MirRvalueKind::MirAggregate(ref kind, ref operands) then
      codegen_aggregate(ctx, fctx, kind, operands, rr)

    when MirRvalueKind::MirDiscriminant(ref discr_place) then
      load_place(ctx, fctx, discr_place, rr)
      normalize_enum_value_to_tag(ctx, rr)
      # A discriminant place may hold a REFERENCE to an enum value (e.g. a
      # &StmtKind parameter or a `match &f.body` subject).  In the compiled
      # representation a reference is the address of the field that holds the
      # enum value, so the first normalize yields the enum struct pointer
      # (still >= 256); dereference once more to extract the actual tag.
      # For plain enum values the first normalize already yields a tag < 256
      # and this second pass is a no-op.
      normalize_enum_value_to_tag(ctx, rr)

    when MirRvalueKind::MirLen(ref len_place) then
      load_place(ctx, fctx, len_place, rr)
      let len_ty = place_type(ctx, fctx, len_place)
      emit_len_ref_derefs(ctx, rr, &len_ty)
      let len_value_ty = strip_receiver_ptr_like_type(&len_ty)
      if is_heap_collection_type(ctx, &len_value_ty) then
        # Null collection pointers represent empty values in native bootstrap
        # paths; avoid dereferencing [0 + 8] and keep zero length.
        let lbl_len_done = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, rr, rr)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done.clone())
        emit_load_mem(ctx, rr, rr, 8)
        def_label(&mut ctx.text, lbl_len_done)
      else
        emit_load_mem(ctx, rr, rr, 8)
      end

    when MirRvalueKind::MirCast(cast_kind, ref operand, ref target_ty) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
          let sp = sp_reg(ctx.target.arch)
          emit_store_mem(ctx, sp, -8, rr)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
          a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
          emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
        let target_bits = type_size(&target_ty, &ctx.type_layout) * 8
        if target_bits < 64 then
          let mask = (1 << target_bits) - 1
          emit_and_ri(ctx, rr, mask as i32)
        end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_statement: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(ref operand, count) then
      let scratch = ret_reg(ctx.target.arch)
      load_operand_rvalue_item(ctx, fctx, operand, scratch)
      mut i: UInt = 0
      while i < count do
        emit_store_mem(ctx, rr, (i * 8) as i32, scratch)
        i = i + 1
      end

    when _ then
      panic("codegen_statement: unsupported MIR rvalue kind")
    end

    if should_store then
      store_place(ctx, fctx, place, rr)
    end

  when MirStatementKind::MirStorageLive(_) then ()
  when MirStatementKind::MirStorageDead(_) then ()
  when MirStatementKind::MirNop then ()

  when MirStatementKind::MirContractCheck(contract, cond) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ok_label = ".Lcontract_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ne, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirBudgetConsume(resource, amount) then
    # Decrement the resource budget counter in the thread-local budget table
    # Format: load current budget, subtract amount, store back, trap if negative
    let scratch = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    
    # Load the budget address (assume __tg_budget_table + resource_offset)
    let budget_sym = "__tg_budget_" + resource.clone()
    emit_lea_global(ctx, budget_sym.clone(), scratch)
    
    # Load current budget value
    emit_load_indirect(ctx, scratch, 0, scratch2)
    
    # Load amount to consume
    emit_mov_ri(ctx, rr, amount as i64)
    
    # Subtract amount from budget
    emit_sub_rr(ctx, rr, scratch2)
    
    # Store updated budget back
    emit_store_indirect(ctx, scratch2, scratch, 0)
    
    # If the budget is now negative, trap (budget exhausted)
    emit_test_rr(ctx, scratch2, scratch2)
    let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ge, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirEffectRecord(name, operand) then
    # Record an effect by pushing it to the effect log
    # Call __tg_effect_record(name_ptr, value)
    let scratch = scratch_reg(ctx.target.arch)
    
    # Load the effect value into result register
    load_operand_control_input(ctx, fctx, operand, rr)
    
    # Load effect name string address
    let name_label = intern_string(ctx, name)
    emit_lea_global(ctx, name_label, scratch)
    
    # Set up call arguments (ABI: scratch = name_ptr, rr = value)
    # Move arguments to proper registers for the call
    match arg_reg(ctx.target.arch, 0)
    when Option::Some(arg0) then
      match arg_reg(ctx.target.arch, 1)
      when Option::Some(arg1) then
        emit_mov_rr(ctx, arg0, scratch)
        emit_mov_rr(ctx, arg1, rr)
      when Option::None then ()
      end
    when Option::None then ()
    end
    
    # Call the runtime function
    emit_call_direct(ctx, "__tg_effect_record".to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Terminator code generation
# ———————————————————————————————————————————————————————————————

def codegen_terminator(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, term: &MirTerminator) -> Unit
  let rr = ret_reg(ctx.target.arch)
  # NOTE: `term` is already a borrow (&MirTerminator); match on `term.kind`
  # directly (NOT `&term.kind`). Native codegen mis-derefs `&term.kind` (a
  # reference to an already-borrowed enum field) by one indirection level, so
  # the tag read is garbage and every terminator falls into the `_` arm
  # (panic: "unsupported MIR terminator kind"). `get_successor_ids` uses the
  # correct `match term.kind` form on the same borrowed param.
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    load_operand_control_input(ctx, fctx, discr, rr)
    mut target_idx = 0
    while target_idx < targets.len() do
      let sw = &targets[target_idx]
      emit_cmp_ri(ctx, rr, sw.value as i32)
      let tgt_label = block_label_for(fctx, sw.target.id)
      emit_jcc(ctx, CondKind::Eq, tgt_label)
      target_idx = target_idx + 1
    end
    let def_label = block_label_for(fctx, default_target.id)
    emit_jmp(ctx, def_label)

  when MirTerminatorKind::MirReturn then
    codegen_epilogue(ctx, fctx)

  when MirTerminatorKind::MirUnreachable then
    emit_trap(ctx)

  when MirTerminatorKind::MirCall(dest, callee, args, success, unwind) then
    codegen_call(ctx, fctx, dest, callee, args, success, unwind)

  when MirTerminatorKind::MirDrop(place, target, unwind) then
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ck = if expected then CondKind::Ne else CondKind::Eq end
    let tgt_label = block_label_for(fctx, target.id)
    emit_jcc(ctx, ck, tgt_label)
    emit_trap(ctx)

  when MirTerminatorKind::MirYield(value, resume) then
    load_operand_control_input(ctx, fctx, value, rr)
    let label = block_label_for(fctx, resume.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAbort then
    emit_trap(ctx)
  when _ then
    panic("codegen_terminator: unsupported MIR terminator kind")
  end
end

def codegen_call(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, dest: &Place, callee: &MirOperand, args: &Vec[MirOperand], success: BlockId, unwind: &Option[BlockId]) -> Unit
  let arch   = ctx.target.arch
  let rr     = ret_reg(arch)
  let scratch = scratch2_reg(arch)
  let sp     = sp_reg(arch)
  let max_ra = max_reg_args(arch)

  # sret eligibility: AArch64 only, dest type > 8 bytes, dest has no
  # projections, dest local has a stable stack home. When eligible we will
  # pass &dest in x8 to the callee (which uses sret) and skip storing rr.
  let dest_ty = place_type(ctx, fctx, dest)
  let dest_sz = type_size(&dest_ty, &ctx.type_layout)
  mut sret_dest_off: i32 = 0
  mut sret_dest_ok = false
  if dest_sz > 8 && dest.projections.is_empty() then
    match arch
    when Arch::AArch64 then
      match fctx.var_locs.get(dest.local.id)
      when Option::Some(loc) then
        match loc
        when VarLoc::Stack(off) then
          sret_dest_off = off
          sret_dest_ok = true
        when VarLoc::Spilled(off) then
          sret_dest_off = off
          sret_dest_ok = true
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  end
  mut did_sret = false

  # Place arguments in reverse order. Loading a projected operand may use x0/rax
  # as scratch, so left-to-right loading can clobber an already prepared arg0.
  let total_args = args.len()
  mut arg_idx = total_args
  while arg_idx > 0 do
    arg_idx = arg_idx - 1
    let arg = &args[arg_idx]
    if arg_idx < max_ra then
      match arg_reg(arch, arg_idx)
      when Option::Some(abi_r) then
        load_operand_call_arg(ctx, fctx, arg, abi_r)
      when Option::None then ()
      end
    else
      load_operand_call_arg(ctx, fctx, arg, scratch)
      emit_push(ctx, scratch)
    end
  end

  # Call the function
  match &callee.kind
  when MirOperandKind::MirConstant(cst) then
    match &cst.kind
    when MirConstantKind::MirFnItem(fn_name) then
      # For dot-prefixed method names (.keys, .is_empty, etc.),
      # resolve using the receiver argument's type
      mut resolved_fn_name = fn_name.clone()
      if fn_name.len() > 1 && fn_name.slice(0, 1) == "." then
        resolved_fn_name = resolve_dot_method(ctx, fctx, fn_name, args)
      end
      let intr_name = bare_intrinsic_name(&resolved_fn_name)
      let is_explicit_intrinsic =
        (resolved_fn_name.len() >= 12 && resolved_fn_name.slice(0, 12) == "__intrinsic_") ||
        (resolved_fn_name.len() >= 10 && resolved_fn_name.slice(resolved_fn_name.len() - 10, resolved_fn_name.len()) == "_intrinsic")
      let prefer_intrinsic =
        intr_name == "as_ptr" || intr_name == "as_str" || intr_name == "len" ||
        intr_name == "as_bytes" || intr_name == "bytes" || intr_name == "clone" || intr_name == "str_concat" ||
        intr_name == "starts_with" || intr_name == "ends_with" || intr_name == "string_contains" ||
        intr_name == "unwrap" || intr_name == "unwrap_or" ||
        intr_name == "is_some" || intr_name == "is_none" || intr_name == "is_ok" || intr_name == "is_err" ||
        intr_name == "array_clone" || intr_name == "string_clone" ||
        intr_name == "array_starts_with" || intr_name == "string_starts_with" ||
        intr_name == "array_ends_with" || intr_name == "string_ends_with" ||
        intr_name == "array_as_ptr" || intr_name == "array_as_mut_ptr" ||
        intr_name == "string_as_ptr" || intr_name == "string_as_str" ||
        intr_name == "array_len" || intr_name == "string_len" ||
        intr_name == "array_is_empty" || intr_name == "array_contains" ||
        intr_name == "map_clone" || intr_name == "set_clone" ||
        intr_name == "map_get" || intr_name == "map_get_mut" ||
        intr_name == "map_contains" || intr_name == "map_contains_key" ||
        intr_name == "set_contains" || intr_name == "set_remove"
       let force_intrinsic = is_explicit_intrinsic ||
         is_intrinsic(&intr_name) ||
         intr_name == "int_to_string" || intr_name == "uint_to_string" ||
        intr_name == "float_to_string" || intr_name == "bool_to_string" ||
        intr_name == "char_to_string" ||
        intr_name == "str_to_string" || intr_name == "read_file_to_string_native"
      let has_real_body =
        ctx.extern_fns.contains(&resolved_fn_name) ||
        ctx.reachable_fns.contains(&resolved_fn_name)
      let fallback_clone_intrinsic =
        !has_real_body &&
        resolved_fn_name.len() >= 7 &&
        resolved_fn_name.slice(resolved_fn_name.len() - 7, resolved_fn_name.len()) == "__clone"
      # Prefer calling compiled function bodies over intrinsic inlining.
      # If a function was compiled (is in reachable_fns), ALWAYS call it
      # directly — never fall through to the intrinsic/NOP path.
      if try_emit_atomic_builtin(ctx, &resolved_fn_name) then
        ()
      else if resolved_fn_name == "String__new" || intr_name == "string_new" then
        codegen_array_new(ctx)
      else if resolved_fn_name == "cstring_new" || resolved_fn_name == "cstring_as_ptr" then
        codegen_intrinsic(ctx, fctx, intr_name, args, resolved_fn_name)
      else if force_intrinsic then
        codegen_intrinsic(ctx, fctx, intr_name, args, resolved_fn_name)
      else if fallback_clone_intrinsic then
        codegen_intrinsic(ctx, fctx, "clone", args, resolved_fn_name)
      else if prefer_intrinsic && is_intrinsic(&intr_name) then
        codegen_intrinsic(ctx, fctx, intr_name, args, resolved_fn_name)
      else if ctx.extern_fns.contains(&resolved_fn_name) then
        emit_call_extern(ctx, resolved_fn_name)
      else if ctx.reachable_fns.contains(&resolved_fn_name) then
        # Function has a compiled body — call it directly
        let resolved = match ctx.fn_alias.get(&resolved_fn_name)
          when Option::Some(actual) then actual
          when Option::None then resolved_fn_name.clone()
          end
        if sret_dest_ok then
          # Pass &dest in x8 for sret-returning callee
          emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
          did_sret = true
        end
        emit_call_label(ctx, resolved)
      else if is_intrinsic(&intr_name) then
        codegen_intrinsic(ctx, fctx, intr_name, args, resolved_fn_name)
      else
        # Resolve through fn_alias map for label mismatches
        let resolved = match ctx.fn_alias.get(&resolved_fn_name)
          when Option::Some(actual) then actual
          when Option::None then resolved_fn_name.clone()
          end
        if sret_dest_ok then
          emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
          did_sret = true
        end
        emit_call_label(ctx, resolved)
      end
    when MirConstantKind::MirZeroSized then
      match cst.ty
      when Type::Function(_, _) then
        emit_trap(ctx)
      when _ then
        emit_trap(ctx)
      end
    when _ then
      emit_trap(ctx)
    end
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, &place, rr)
    emit_call_r(ctx, rr)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, &place, rr)
    emit_call_r(ctx, rr)
  end

  # Clean up stack args
  if total_args > max_ra then
    let stack_arg_slot = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    emit_add_ri(ctx, sp, ((total_args - max_ra) * stack_arg_slot) as i32)
  end

  # Store return value
  if !did_sret then
    store_place(ctx, fctx, dest, rr)
  end

  # Jump to success block
  let label = block_label_for(fctx, success.id)
  emit_jmp(ctx, label)
end

# ———————————————————————————————————————————————————————————————
# Intrinsic code generation — emit inline code for built-in operations
# ———————————————————————————————————————————————————————————————

def codegen_intrinsic(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, name: String, args: &Vec[MirOperand], orig_fn_name: String) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let receiver_ty = if args.len() > 0 then strip_ref_like_type(&operand_type(ctx, fctx, &args[0])) else Type::Unit end
  let receiver_is_string = if args.len() > 0 then is_string_operand(&args[0], fctx) else false end
  let receiver_is_string_like = if args.len() > 0 then is_string_like_type(&operand_type(ctx, fctx, &args[0])) else false end
  let needle_ty = if args.len() > 1 then operand_type(ctx, fctx, &args[1]) else Type::Unit end
  let needle_value_ty = strip_ref_like_type(&needle_ty)
  let needle_is_ref = match needle_ty
    when Type::Ref(_, _) then true
    when Type::RefMut(_, _) then true
    when _ then false
    end
  let needle_is_string = if args.len() > 1 then is_string_operand(&args[1], fctx) else false end
  let needle_is_string_like = if args.len() > 1 then
    is_string_like_type(&needle_ty) || is_string_like_type(&needle_value_ty)
  else
    false
  end
  let orig_is_string_contains =
    orig_fn_name == "String__contains" ||
    orig_fn_name == "string_contains" ||
    orig_fn_name == "__intrinsic_string_contains" ||
    orig_fn_name == "str_contains"

  # FAST-PATH: Handle newly-added intrinsics BEFORE the long alias/dispatch chains.
  # The stage0 interpreter has limits on deeply-nested if/else if chains,
  # so these handlers use early returns to avoid being lost at chain ends.
  if name == "array_as_ptr_address" then
    emit_load_mem(ctx, rr, rr, 0)
    emit_load_mem(ctx, rr, rr, 0)
    return
  end
  if name == "read_file_to_string_native" then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    # arg0 = path string pointer (already in rr from arg loading)
    emit_call_label(ctx, "_tg_read_file_to_string")
    return
  end
  if name == "set_is_empty" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_is_empty(ctx)
    return
  end
  if name == "map_push" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_insert(ctx)
    return
  end
  if name == "array_replace" then
    emit_call_label(ctx, "_tg_str_concat")
    return
  end
   if name == "array_as_str" then
     emit_load_mem(ctx, rr, rr, 0)
     return
   end
   if name == "array_push" then
     deref_all_ref_like_args(ctx, fctx, args, rr)
     a64_bl(&mut ctx.text, "_tg_array_push")
     return
   end
   if name == "array_pop" then
     deref_all_ref_like_args(ctx, fctx, args, rr)
     a64_bl(&mut ctx.text, "_tg_array_pop")
     return
   end
   if name == "array_new" then
     a64_bl(&mut ctx.text, "_tg_array_new")
     return
   end
   if name == "array_len" then
     deref_all_ref_like_args(ctx, fctx, args, rr)
     codegen_array_len(ctx)
     return
   end
   if name == "array_get" then
     deref_all_ref_like_args(ctx, fctx, args, rr)
     codegen_array_get(ctx)
     return
   end
   if name == "array_set" then
     deref_all_ref_like_args(ctx, fctx, args, rr)
     codegen_array_set(ctx)
     return
   end
   if name == "str_slice" then
     codegen_str_slice(ctx)
     return
   end

  # Normalize aliases and bare method names to canonical intrinsic names.
  # This handles: map_contains_key → map_contains, map_get_mut → map_get,
  # and bare names like "push" → "array_push" (default to array_ prefix).
  let name = if name == "map_contains_key" then "map_contains"
    else if name == "map_get_mut" then "map_get"
    else if name == "contains_key" then "map_contains"
    else if name == "get_mut" then "map_get"
    else if name == "push" then "array_push"
    else if name == "pop" then "array_pop"
    else if name == "get" then "array_get"
    else if name == "set" then "array_set"
    else if name == "insert" then "array_insert"
    else if name == "remove" then "array_remove"
    else if name == "clear" then "array_clear"
    else if name == "first" then "array_first"
    else if name == "last" then "array_last"
    else if name == "reverse" then "array_reverse"
    else if name == "sort" then "array_sort"
    else if name == "extend" then "array_extend"
    else if name == "entries" then match receiver_ty
      when Type::Set(_) then "set_entries"
      when _ then "map_entries"
      end
    else if name == "keys" then "map_keys"
    else if name == "values" then "map_values"
    else if name == "is_empty" then "array_is_empty"
    else if name == "cap" then "array_cap"
    else if name == "contains" then match receiver_ty
      when Type::String then "string_contains"
      when Type::Map(_, _) then "map_contains"
      when Type::Set(_) then "set_contains"
      when _ then
        if orig_is_string_contains || receiver_is_string || receiver_is_string_like then "string_contains"
        elsif needle_is_string || needle_is_string_like then "string_contains"
        elsif !needle_is_ref && needle_value_ty == Type::String then "string_contains"
        else "array_contains"
        end
      end
    else if name == "array_contains" then
      if orig_is_string_contains || receiver_is_string || receiver_is_string_like then "string_contains"
      elsif needle_is_string || needle_is_string_like then "string_contains"
      elsif !needle_is_ref && needle_value_ty == Type::String then "string_contains"
      else "array_contains"
      end
    # Bare-name aliases for NOP_FALLBACK intrinsics
    else if name == "trim_matches" then "clone"
    else if name == "split_once" then "clone"
    else if name == "to_bits" then "clone"
    else if name == "to_lowercase" then "clone"
    else if name == "bytes" then "as_bytes"
    else if name == "arg" then "clone"
    else if name == "eval" then "clone"
    else if name == "map" || name == "join" || name == "collect" then
      # Iterator methods — identity pass-through (return arg0 deref)
      "clone"
    else if name == "slice" then "str_slice"
    else if name == "split" || name == "lines" || name == "trim" then
      # String methods — identity pass-through for now
      "clone"
    else if name == "parse_int" then "str_to_int"
    else if name == "starts_with" then "starts_with"
    else if name == "ends_with" then "ends_with"
    else if name == "string_replace" || name == "replace" then "str_concat"
    else if name == "string_find" || name == "find" then "str_find"
    else if name == "string_new" then "array_new"
    else if name == "string_char_at" then "char_at"
    else if name == "string_push" || name == "string_push_str" then "array_push"
    else if name == "string_split" then "clone"
    else if name == "string_slice" then "str_slice"
    else if name == "string_len" then "len"
    else if name == "string_parse_int" then "str_to_int"
    # __intrinsic_* aliases that map to existing handlers
    else if name == "array_slice" then "array_get"
    else if name == "array_from_list" then "clone"
    else if name == "array_with_capacity" then "array_new"
    else if name == "array_capacity" then "array_len"
    else if name == "set_entries" then "set_entries"
    # Vec__/Array__ prefixed methods - map to canonical intrinsics
    else if name == "Vec__clone" || name == "Array__clone" || name == "array_clone" then "clone"
    else if name == "Vec__starts_with" || name == "array_starts_with" then "starts_with"
    else if name == "Vec__ends_with" || name == "array_ends_with" then "str_cmp"
    else if name == "Vec__to_string" || name == "Array__to_string" || name == "array_to_string" then "to_string"
    else if name == "Vec__read" || name == "Array__read" || name == "array_read" then "clone"
    else if name == "Vec__join" || name == "Array__join" || name == "array_join" then "clone"
    # Map__ prefixed methods
    else if name == "Map__unwrap" || name == "map_unwrap" then "unwrap"
    else if name == "Map__clone" || name == "map_clone" then "map_clone"
    # Set__ prefixed methods  
    else if name == "Set__clone" || name == "set_clone" then "set_clone"
    else if name == "Set__unwrap" || name == "set_unwrap" then "unwrap"
    # String__ prefixed methods
    else if name == "String__parse_float" || name == "__intrinsic_string_parse_float" || name == "str_parse_float" then "str_to_float"
    else if name == "String__clone" then "clone"
    # Additional string_ prefixed variants (from bare_intrinsic_name transformation)
    else if name == "string_clone" || name == "string_is_empty" || name == "string_chars" then "clone"
    else if name == "string_as_bytes" then "as_bytes"
    else if name == "string_as_ptr" then "as_ptr"
    else if name == "string_as_str" then "as_str"
    else if name == "string_to_wide_string" || name == "string_to_string" then "to_string"
    else if name == "string_starts_with" then "starts_with"
    else if name == "string_ends_with" then "ends_with"
    else if name == "string_index_of" then "str_find"
    else if name == "string_last_index_of" || name == "string_rfind" then "str_find"
    else if name == "string_find" then "str_find"
    else if name == "string_len" then "len"
    else if name == "string_trim" || name == "string_trim_matches" then "clone"
    else if name == "string_to_lowercase" || name == "string_to_uppercase" then "clone"
    else if name == "string_contains" then "string_contains"
    else if name == "string_replace" then "str_concat"
    else if name == "string_slice" || name == "string_split" || name == "string_lines" || name == "string_split_once" then "clone"
    # Type__method variants for various std types - all map to clone or identity
    else if name == "PanicInfo__clone" || name == "TypeExpr__clone" || name == "Span__clone" then "clone"
    else if name == "LifetimeCtx__to_string" || name == "MirProgram__to_string" || name == "Type__to_string" then "to_string"
    else if name == "Type__clone" || name == "Type__collect" || name == "Type__unwrap" then "clone"
    else if name == "InlineResult__unwrap_or" || name == "MirStatement__unwrap_or" || name == "Place__unwrap_or" then "unwrap_or"
    else if name == "MirRvalue__collect" || name == "MirRvalue__unwrap_or" || name == "MirTerminator__unwrap_or" then "clone"
    else if name == "PgoProfile__unwrap_or" then "unwrap_or"
    else if name == "LocalId__clone" || name == "BlockId__clone" || name == "MirFunction__clone" then "clone"
    else if name == "MirStatement__clone" || name == "MirRvalue__clone" || name == "AggregateKind__clone" then "clone"
    else if name == "MirTerminatorKind__clone" || name == "AsmTarget__clone" then "clone"
    else if name == "Budget__unwrap_or" || name == "Budget__trim" then "unwrap_or"
    else if name == "IfStmt__len" then "len"
    # Collection intrinsic aliases
    else if name == "array_replace" then "str_concat"
    else if name == "map_push" then "map_insert"
    else if name == "set_is_empty" then "array_is_empty"
    else if name == "array_as_str" then "as_str"
    # NOP_FALLBACK rescue aliases
    else if name == "string_bytes" then "bytes"
    else if name == "string_unwrap_or" || name == "String__unwrap_or" then "unwrap_or"
    else if name == "cstring_new" || name == "CString__new" then "cstring_new"
    else if name == "cstring_as_ptr" || name == "CString__as_ptr" then "cstring_as_ptr"
    else if name == "arg" then "clone"
    else name
    end

  # Syscall intrinsics (1-6 arguments)
  if name == "syscall6" then
    codegen_syscall(ctx, 6)
  else if name == "syscall5" then
    codegen_syscall(ctx, 5)
  else if name == "syscall4" then
    codegen_syscall(ctx, 4)
  else if name == "syscall3" then
    codegen_syscall(ctx, 3)
  else if name == "syscall2" then
    codegen_syscall(ctx, 2)
  else if name == "syscall1" then
    codegen_syscall(ctx, 1)

  # Array pointer intrinsics: arg0 is &self, so dereference once to get the
  # Vec/Array header, then load the data pointer from field 0.
  else if name == "array_as_ptr" || name == "array_as_mut_ptr" then
    emit_load_mem(ctx, rr, rr, 0)
    emit_load_mem(ctx, rr, rr, 0)

  # Vec.as_ptr_address() → return data pointer as Int (same bit pattern as pointer)
  else if name == "array_as_ptr_address" || name == "as_ptr_address" then
    emit_load_mem(ctx, rr, rr, 0)
    emit_load_mem(ctx, rr, rr, 0)

  else if name == "int_to_string" || name == "int_to_string_intrinsic" then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_int_to_str(ctx)

  else if name == "float_to_string" || name == "float_to_string_intrinsic" then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_float_to_str(ctx)

  else if name == "bool_to_string" then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_bool_to_str(ctx)

  else if name == "char_to_string" then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_char_to_str(ctx)

  else if name == "str_to_string" then
    deref_all_ref_like_args(ctx, fctx, args, rr)

  else if name == "string_from_bytes" then
    codegen_string_from_bytes(ctx)

  else if name == "to_string" then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_ref_like_type(&arg_ty)
    deref_all_ref_like_args(ctx, fctx, args, rr)
    match value_ty
    when Type::Int then codegen_int_to_str(ctx)
    when Type::Float then codegen_float_to_str(ctx)
    when Type::F32 then codegen_float_to_str(ctx)
    when Type::F64 then codegen_float_to_str(ctx)
    when Type::Bool then codegen_bool_to_str(ctx)
    when Type::Char then codegen_char_to_str(ctx)
    when _ then ()
    end

  # Method-receiver intrinsics: the argument is &self (a reference).
  else if name == "as_bytes" then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    match value_ty
    when Type::String then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      codegen_string_bytes(ctx)
    when _ then deref_all_ref_like_args(ctx, fctx, args, rr)
    end
  else if name == "as_ptr" || name == "as_str" then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    let is_string_receiver =
      is_string_like_type(&value_ty) ||
      orig_fn_name == "String__as_ptr" ||
      orig_fn_name == "String__as_str" ||
      orig_fn_name == "__intrinsic_string_as_ptr" ||
      orig_fn_name == "__intrinsic_string_as_str" ||
      orig_fn_name == "string_as_ptr" ||
      orig_fn_name == "string_as_str"
    if is_string_receiver then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      normalize_string_arg0_for_current_arch(ctx)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
  else if name == "clone" then
    deref_all_ref_like_args(ctx, fctx, args, rr)

  # String intrinsics
  else if name == "len" then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    let is_pure_string =
      (match value_ty
       when Type::String then true
       else false
       end) ||
      orig_fn_name == "String__len" ||
      orig_fn_name == "__intrinsic_string_len" ||
      orig_fn_name == "string_len"
    let is_collection_receiver =
      is_heap_collection_type(ctx, &value_ty) ||
      orig_fn_name == "Vec__len" ||
      orig_fn_name == "Array__len" ||
      orig_fn_name == "Map__len" ||
      orig_fn_name == "Set__len" ||
      orig_fn_name == "__intrinsic_array_len" ||
      orig_fn_name == "array_len"
    if is_collection_receiver then
      # Vec/Map/Set/Slice — len is stored at offset 8 of the heap header
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      codegen_array_len(ctx)
    else if is_pure_string then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      codegen_strlen(ctx)
    else
      # Unknown receiver type: fall back to the collection header layout
      # (len at offset 8). A strlen is only correct for C-string payloads,
      # and the compiler's Strings/Vecs both use the {data, len, cap} header.
      deref_all_ref_like_args(ctx, fctx, args, rr)
      codegen_array_len(ctx)
    end
  else if name == "str_concat" then
    emit_call_label(ctx, "_tg_str_concat")
  else if name == "str_len" then
    codegen_str_len(ctx)
  else if name == "str_cmp" then
    codegen_str_cmp(ctx)
  else if name == "str_find" then
    codegen_str_find(ctx)
  else if name == "starts_with" then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(&arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_starts_with(ctx)
  else if name == "ends_with" then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(&arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_ends_with(ctx)
  else if name == "string_contains" then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(&arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_string_contains(ctx)
  else if name == "str_copy" then
    codegen_str_copy(ctx)
  else if name == "str_slice" then
    codegen_str_slice(ctx)
  else if name == "int_to_str" then
    codegen_int_to_str(ctx)
  else if name == "float_to_str" then
    codegen_float_to_str(ctx)
  else if name == "str_to_int" then
    codegen_str_to_int(ctx)
  else if name == "str_to_float" then
    codegen_str_to_float(ctx)

  # Array/Vec intrinsics
  # Collection method receivers are references to locals that store the heap
  # header pointer, so dereference once before invoking the runtime helper.
  else if name == "array_new" then
    codegen_array_new(ctx)
  else if name == "array_push" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_push(ctx)
  else if name == "array_pop" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_pop(ctx)
  else if name == "array_get" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_get(ctx)
  else if name == "array_set" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_set(ctx)
  else if name == "array_len" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_len(ctx)
  else if name == "array_cap" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_cap(ctx)
  else if name == "array_remove" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_remove(ctx)
  else if name == "array_insert" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_insert(ctx)
  else if name == "array_clear" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_clear(ctx)
  else if name == "array_contains" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_array_contains(ctx)
  else if name == "array_last" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_last(ctx)
  else if name == "array_first" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_first(ctx)
  else if name == "array_is_empty" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_is_empty(ctx)
  else if name == "array_reverse" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_reverse(ctx)
  else if name == "array_sort" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_sort(ctx)
  else if name == "array_extend" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_array_extend(ctx)
  else if name == "array_truncate" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_truncate(ctx)
  else if name == "array_resize" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_resize(ctx)

  # Map intrinsics — dereference &self for all methods (not constructors)
  else if name == "map_new" then
    codegen_map_new(ctx)
  else if name == "map_insert" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_insert(ctx)
  else if name == "map_get" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_map_get(ctx)
  else if name == "map_remove" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_map_remove(ctx)
  else if name == "map_contains" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_map_contains(ctx)
  else if name == "map_len" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_len(ctx)
  else if name == "map_clone" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_clone(ctx)
  else if name == "map_clear" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_clear(ctx)
  else if name == "map_keys" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_keys(ctx)
  else if name == "map_values" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_values(ctx)
  else if name == "map_entries" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_entries(ctx)

  # Set intrinsics — dereference &self for all methods (not constructors)
  else if name == "set_new" then
    codegen_set_new(ctx)
  else if name == "set_insert" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_insert(ctx)
  else if name == "set_contains" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_set_contains(ctx)
  else if name == "set_remove" then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, 1)
    codegen_set_remove(ctx)
  else if name == "set_len" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_len(ctx)
  else if name == "set_clone" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_clone(ctx)
  else if name == "set_entries" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_entries(ctx)
  else if name == "set_clear" then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_clear(ctx)

  # Memory intrinsics
  else if name == "mem_alloc" then
    codegen_mem_alloc(ctx)
  else if name == "mem_free" then
    codegen_mem_free(ctx)
  else if name == "mem_copy" then
    codegen_mem_copy(ctx)
  else if name == "mem_set" then
    codegen_mem_set(ctx)
  else if name == "mem_zero" then
    codegen_mem_zero(ctx)

  # Hash intrinsics
  else if name == "hash_int" then
    codegen_hash_int(ctx)
  else if name == "hash_str" then
    codegen_hash_str(ctx)
  else if name == "hash_combine" then
    codegen_hash_combine(ctx)

  # String iteration
  else if name == "chars" then
    emit_call_label(ctx, "_tg_str_chars")

  # String byte indexing
  else if name == "char_at" then
    codegen_char_at(ctx)

  # CString intrinsics (String = raw C string at ABI level)
  # cstring_new(s: String) → CString: no-op pass-through since String is already char*
    # cstring_as_ptr(&cs) then loads that raw pointer back out of the local/reference slot.
  else if name == "cstring_new" then
    # No-op: just return x0 as-is (the reference/pointer value)
    # cstring_as_ptr(&cs: &CString) → Ptr[u8]: one deref to get the raw char*
    # &c_path (stack) → char* (actual C string)
  else if name == "cstring_as_ptr" then
    emit_load_mem(ctx, rr, rr, 0)

  # String.bytes() → Vec[Int]: create a Vec of the C string's bytes
  # Since this involves allocation and looping, delegate to runtime helper
  else if name == "bytes" then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    if is_string_like_type(&value_ty) then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
    codegen_string_bytes(ctx)

  # Option discriminant checks: arg0 = &self (ptr to enum)
  # Enum layout: raw value is either inline tag (0-255) or heap pointer (>=256).
  # Must normalize to discriminant tag before comparing.
  # Option::Some = variant 0, Option::None = variant 1
  else if name == "is_some" || name == "is_ok" then
    emit_load_mem(ctx, rr, rr, 0)
    normalize_enum_value_to_tag(ctx, rr)
    emit_cmp_ri(ctx, rr, 0)
    emit_setcc(ctx, CondKind::Eq, rr)
  else if name == "is_none" || name == "is_err" then
    emit_load_mem(ctx, rr, rr, 0)
    normalize_enum_value_to_tag(ctx, rr)
    emit_cmp_ri(ctx, rr, 0)
    emit_setcc(ctx, CondKind::Ne, rr)

  # Option/Result unwrap: arg0 = &self (ptr to enum)
  # Representation:
  #   - raw value < 256: inline tag (uninitialized field => 0, or explicit
  #     small inline). Treat as None/Err.
  #   - raw value >= 256: heap pointer to {discriminant, payload}.
  #     discriminant 0 == Some/Ok, 1 == None/Err.
  else if name == "unwrap" then
    let scratch = scratch_reg(arch)
    emit_load_mem(ctx, rr, rr, 0)
    emit_mov_rr(ctx, scratch, rr)
    let ok_label = ".Lunwrap_ok." + ctx.fn_counter.to_string()
    let trap_label = ".Lunwrap_trap." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_cmp_ri(ctx, scratch, 256)
    emit_jcc(ctx, CondKind::Lt, trap_label.clone())
    # Heap pointer: load discriminant
    emit_load_mem(ctx, rr, scratch, 0)
    emit_cmp_ri(ctx, rr, 0)
    emit_jcc(ctx, CondKind::Eq, ok_label.clone())
    def_label(&mut ctx.text, trap_label)
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)
    # scratch holds heap pointer; payload at [+8]
    emit_load_mem(ctx, rr, scratch, 8)

  # Option/Result unwrap_or: arg0 = &self (ptr to enum), arg1 = default
  else if name == "unwrap_or" then
    let scratch = scratch_reg(arch)
    emit_load_mem(ctx, rr, rr, 0)
    emit_mov_rr(ctx, scratch, rr)
    let none_label = ".Lunwrap_or_none." + ctx.fn_counter.to_string()
    let some_label = ".Lunwrap_or_some." + ctx.fn_counter.to_string()
    let done_label = ".Lunwrap_or_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    # If raw < 256, treat as None (inline tag or uninitialized field)
    emit_cmp_ri(ctx, scratch, 256)
    emit_jcc(ctx, CondKind::Lt, none_label.clone())
    # Heap pointer: load discriminant and compare to 1 (None/Err)
    emit_load_mem(ctx, rr, scratch, 0)
    emit_cmp_ri(ctx, rr, 0)
    emit_jcc(ctx, CondKind::Eq, some_label.clone())
    # disc != 0 => None/Err
    emit_jmp(ctx, none_label.clone())
    def_label(&mut ctx.text, some_label)
    # Some case: payload at [heap_ptr + 8]
    emit_load_mem(ctx, rr, scratch, 8)
    emit_jmp(ctx, done_label.clone())
    # None case: return default (arg1)
    def_label(&mut ctx.text, none_label)
    match arg_reg(arch, 1)
    when Option::Some(r) then emit_mov_rr(ctx, rr, r)
    when Option::None then ()
    end
    def_label(&mut ctx.text, done_label)

  # Process/Environment intrinsics - call runtime functions
  else if name == "status" then
    emit_call_label(ctx, "_tg_status")
  else if name == "output" then
    emit_call_label(ctx, "_tg_output")
  else if name == "stdout_string" then
    emit_call_label(ctx, "_tg_stdout_string")
  else if name == "stderr_string" then
    emit_call_label(ctx, "_tg_stderr_string")

  # Formatter intrinsics - these are no-op/identity for code generation
  # The Formatter is a compile-time construct for pretty-printing
  else if name == "emit" || name == "space" || name == "indent" || name == "dedent" then
    ()  # No-op - formatter state changes don't generate runtime code
  else if name == "emit_newline" || name == "emit_blank_line" then
    ()  # No-op - newline emission is compile-time
  else if name == "would_overflow" then
    # Return false (0) - no overflow check at runtime
    emit_zero_reg(ctx, rr)

  # Utility intrinsics
  else if name == "cmp" then
    # Compare two values - use str_cmp for strings, integer compare otherwise
    codegen_str_cmp(ctx)
  else if name == "to_int" then
    # Identity - value is already an int
    ()
  else if name == "eval" then
    # Runtime eval not supported - identity pass-through
    ()
  else if name == "lint_file" then
    # Linting is a compile-time operation - no runtime code
    emit_zero_reg(ctx, rr)

  # File constants - return constant values
  else if name == "SYS_WRITE" then
    emit_mov_ri(ctx, rr, 1)   # __NR_write on Linux
  else if name == "SYS_READ" then
    emit_mov_ri(ctx, rr, 0)   # __NR_read on Linux
  else if name == "SYS_OPEN" then
    emit_mov_ri(ctx, rr, 2)   # __NR_open on Linux
  else if name == "SYS_CLOSE" then
    emit_mov_ri(ctx, rr, 3)   # __NR_close on Linux
  else if name == "SYS_EXIT" then
    emit_mov_ri(ctx, rr, 60)  # __NR_exit on Linux
  else if name == "O_WRONLY" then
    emit_mov_ri(ctx, rr, 1)
  else if name == "O_RDWR" then
    emit_mov_ri(ctx, rr, 2)
  else if name == "O_APPEND" then
    emit_mov_ri(ctx, rr, 1024)
  else if name == "O_CREAT" then
    emit_mov_ri(ctx, rr, 64)
  else if name == "O_TRUNC" then
    emit_mov_ri(ctx, rr, 512)
  else if name == "open_windows" then
    # Windows not supported on macOS/Linux - return error
    emit_mov_ri(ctx, rr, -1)

  else
    # Unhandled intrinsic — zero out return value (identity passthrough).
    # Using emit_zero to avoid unresolved label references.
    emit_zero_reg(ctx, rr)
  end
end
# Args already in ABI registers: arg0=num, arg1=a1, arg2=a2, arg3=a3
def codegen_syscall(ctx: &mut CodegenCtx, nargs: Int) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS AArch64: x16=syscall_num, x0=a1, x1=a2, x2=a3, SVC #0x80
      # TG canonical numbers → macOS: add 3 (read:0→3, write:1→4, open:2→5, close:3→6)
      a64_add_rri(&mut ctx.text, A64::X16, A64::X0, 3)
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
      if nargs >= 2 then
        a64_mov_rr(&mut ctx.text, A64::X1, A64::X2)
      end
      if nargs >= 3 then
        a64_mov_rr(&mut ctx.text, A64::X2, A64::X3)
      end
      a64_svc(&mut ctx.text, 0x80)
      # Darwin reports syscall errors with carry set and errno in x0.
      # Normalize that to the Linux-style negative errno convention used
      # by the std/fs raw wrappers and direct syscall callers.
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      # Linux AArch64: x8=syscall_num, x0=a1, x1=a2, x2=a3, SVC #0
      # TG canonical numbers match Linux x86_64 but NOT aarch64
      # For now: emit raw (user must provide correct aarch64 numbers)
      a64_mov_rr(&mut ctx.text, A64::X8, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
      if nargs >= 2 then
        a64_mov_rr(&mut ctx.text, A64::X1, A64::X2)
      end
      if nargs >= 3 then
        a64_mov_rr(&mut ctx.text, A64::X2, A64::X3)
      end
      a64_svc(&mut ctx.text, 0)
    when _ then
      a64_brk(&mut ctx.text, 1)
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS x86_64: rax=0x2000000+bsd_num, rdi=a1, rsi=a2, rdx=a3
      # TG canonical → macOS BSD: add 3, then add 0x2000000
      let ok_label = ".Lsyscall_ok." + ctx.fn_counter.to_string()
      ctx.fn_counter = ctx.fn_counter + 1
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
      x64_add_ri(&mut ctx.text, X64::RAX, 0x2000003)
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
      if nargs >= 2 then
        x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
      end
      if nargs >= 3 then
        x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
      end
      x64_syscall(&mut ctx.text)
      # Darwin reports syscall errors with carry set and errno in rax.
      # Normalize that to the Linux-style negative errno convention used
      # by the std/fs raw wrappers and direct syscall callers.
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label)
    when OsAbi::Linux then
      # Linux x86_64: rax=num, rdi=a1, rsi=a2, rdx=a3
      # TG canonical numbers match Linux x86_64 directly
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
      if nargs >= 2 then
        x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
      end
      if nargs >= 3 then
        x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
      end
      x64_syscall(&mut ctx.text)
    when _ then
      x64_ud2(&mut ctx.text)
    end
  end
end

# Emit inline strlen for a raw null-terminated string pointer in x0/rdi.
def codegen_strlen(ctx: &mut CodegenCtx) -> Unit
  normalize_string_arg0_for_current_arch(ctx)
  let lbl_loop = ".Lstrlen_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrlen_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr. Use x9 as counter, x10 as byte scratch
    a64_mov_ri(&mut ctx.text, A64::X9, 0)
    def_label(&mut ctx.text, lbl_loop.clone())
    # ldrb w10, [x0, x9]
    # (use add + ldrb since we don't have indexed ldrb)
     a64_add_rrr(&mut ctx.text, A64::X10, A64::X0, A64::X9)
     a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
     a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
  when Arch::X86_64 then
    # rdi = ptr. Use rcx as counter
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx eax, byte [rdi + rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x04)  # modrm SIB
    emit8(&mut ctx.text, 0x0F)  # SIB: rcx + rdi
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# char_at intrinsic: load byte at string[index]
# AArch64: x0 = &self (ref to string ptr), x1 = index
# x86_64:  rdi = &self, rsi = index
# Returns the byte value (zero-extended to Int) in return register.
def codegen_char_at(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Dereference &self to get the string pointer
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X9),
      PhysReg::A64Reg(A64::X10),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12)
    )
    # Compute ptr + index
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
     # Load byte at that address
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_mov_rr(&mut ctx.text, A64::X0, A64::X2)
  when Arch::X86_64 then
    # Dereference &self to get the string pointer
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # movzx eax, byte [rdi + rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x04)  # modrm SIB
    emit8(&mut ctx.text, 0x37)  # SIB: rsi + rdi
  end
end

# String.bytes() intrinsic on a raw C-string pointer.
# Returns: x0 = Vec pointer
def codegen_string_bytes(ctx: &mut CodegenCtx) -> Unit
  normalize_string_arg0_for_current_arch(ctx)
  emit_call_label(ctx, "_tg_string_bytes")
end

def codegen_string_from_bytes(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_string_from_bytes")
end

# ———————————————————————————————————————————————————————————————
# Function prologue and epilogue
# ———————————————————————————————————————————————————————————————

def stack_probe_step_bytes() -> Int = 4096

def emit_stack_probe(ctx: &mut CodegenCtx, sp: PhysReg, frame_size: Int) -> Unit
  if frame_size <= stack_probe_step_bytes() then
    return
  end

  let scratch = scratch2_reg(ctx.target.arch)
  emit_zero_reg(ctx, scratch)

  mut offset = 0
  while offset < frame_size do
    emit_store_mem(ctx, sp, offset as i32, scratch)
    offset = offset + stack_probe_step_bytes()
  end
end

def codegen_prologue(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)

  match arch
  when Arch::X86_64 then
    # push rbp; mov rbp, rsp
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp)

    # Save callee-saved registers
    for r in fctx.frame.saved_regs do
      emit_push(ctx, r)
    end

    # Allocate stack frame
    if fctx.frame.stack_size > 0 then
      emit_sub_ri(ctx, sp, fctx.frame.stack_size as i32)
      emit_stack_probe(ctx, sp, fctx.frame.stack_size)
    end

  when Arch::AArch64 then
    # stp fp, lr, [sp, #-16]!  (pre-index: push fp and lr)
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    # mov fp, sp
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    # Allocate full stack frame (callee-saved saves + spill area)
    if fctx.frame.stack_size > 0 then
      let aligned = align_up_int(fctx.frame.stack_size, 16)
      if aligned <= 4095 then
        a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, aligned as u32)
      else
        # Large frame: load size into scratch register then subtract
        a64_mov_ri(&mut ctx.text, A64::X15, aligned as i64)
        a64_sub_sp_sp_r(&mut ctx.text, A64::X15)
      end
      emit_stack_probe(ctx, sp, aligned)
    end

    # Save callee-saved registers at the BOTTOM of the frame (FP-relative)
    # Callee-saved go at [FP-stack_size], [FP-stack_size+8], etc.
    # Spill slots are at [FP-8], [FP-16], etc. (near top), so no collision.
    let saved = &fctx.frame.saved_regs
    mut si = 0
    let ss = fctx.frame.stack_size
    while si < saved.len() do
      # off = -(stack_size) + (si * 8), always negative
      let abs_off = ss - (si * 8)
      match saved[si]
      when PhysReg::A64Reg(a) then
        if abs_off <= 256 then
          a64_stur(&mut ctx.text, a, A64::FP, -(abs_off as i32))
        elsif abs_off <= 4095 then
          a64_sub_rri(&mut ctx.text, A64::X15, A64::FP, abs_off as u32)
          a64_stur(&mut ctx.text, a, A64::X15, 0)
        else
          a64_mov_ri(&mut ctx.text, A64::X15, abs_off as i64)
          a64_sub_rrr(&mut ctx.text, A64::X15, A64::FP, A64::X15)
          a64_stur(&mut ctx.text, a, A64::X15, 0)
        end
      when _ then ()
      end
      si = si + 1
    end
  end

  # Move register-assigned params from ABI regs to their assigned regs
  let max_ra = max_reg_args(arch)
  # sret ABI: save the caller-supplied indirect-return pointer (x8) into
  # the reserved frame slot before any callee work clobbers it.
  if fctx.frame.sret_offset != 0 then
    match arch
    when Arch::AArch64 then
      emit_store_mem(ctx, PhysReg::A64Reg(A64::FP), fctx.frame.sret_offset as i32, PhysReg::A64Reg(A64::X8))
    when _ then ()
    end
  end
  mut idx = 0
  for param in fctx.func.params do
    if idx < max_ra then
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        match fctx.var_locs.get(param.id.id)
        when Option::Some(loc) then
          match loc
          when VarLoc::Register(target_r) then
            if phys_reg_id(abi_r) != phys_reg_id(target_r) then
              emit_mov_rr(ctx, target_r, abi_r)
            end
          when VarLoc::Stack(off) then
            emit_store_mem(ctx, fp, off, abi_r)
          when VarLoc::Spilled(off) then
            emit_store_mem(ctx, fp, off, abi_r)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
    idx = idx + 1
  end
end

def codegen_epilogue(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)
  let rr = ret_reg(arch)

  # sret ABI: if function uses indirect return, copy local 0 (return slot)
  # into the buffer pointed to by the saved x8 pointer. Skip the x0 load.
  mut loaded_ret = false
  if fctx.frame.sret_offset != 0 then
    match arch
    when Arch::AArch64 then
      let ret_local = fctx.func.locals[0]
      let ret_sz = type_size(&ret_local.ty, &ctx.type_layout)
      # Reload saved x8 into x16 (scratch)
      emit_load_mem(ctx, PhysReg::A64Reg(A64::X16), PhysReg::A64Reg(A64::FP), fctx.frame.sret_offset as i32)
      # Find local 0's stack offset
      mut src_off: i32 = 0
      match fctx.var_locs.get(ret_local.id.id)
      when Option::Some(loc) then
        match loc
        when VarLoc::Stack(off) then src_off = off
        when VarLoc::Spilled(off) then src_off = off
        when _ then ()
        end
      when _ then ()
      end
      # Copy ret_sz bytes from [fp + src_off] to [x16] in 8-byte chunks
      mut copied = 0
      while copied < ret_sz do
        emit_load_mem(ctx, PhysReg::A64Reg(A64::X17), PhysReg::A64Reg(A64::FP), (src_off + copied as i32) as i32)
        emit_store_mem(ctx, PhysReg::A64Reg(A64::X16), copied as i32, PhysReg::A64Reg(A64::X17))
        copied = copied + 8
      end
      loaded_ret = true
    when _ then ()
    end
  end

  # Load return value into the return register (local 0 is return place).
  # Always check var_locs for local 0 regardless of type_size, because
  # type_size may report 0 for Named types whose layout has forward references.
  if !loaded_ret && fctx.func.locals.len() > 0 then
    let ret_local = fctx.func.locals[0]
    match fctx.var_locs.get(ret_local.id.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(rr) then
          emit_mov_rr(ctx, rr, r)
        end
        loaded_ret = true
      when VarLoc::Stack(off) then
        emit_load_mem(ctx, rr, fp, off)
        loaded_ret = true
      when VarLoc::Spilled(off) then
        emit_load_mem(ctx, rr, fp, off)
        loaded_ret = true
      end
    when _ then ()
    end
  end
  if !loaded_ret then
    # Unit return type or no return local: ensure return register is zero
    emit_zero_reg(ctx, rr)
  end

  match arch
  when Arch::X86_64 then
    # Deallocate stack frame
    if fctx.frame.stack_size > 0 then
      emit_add_ri(ctx, sp, fctx.frame.stack_size as i32)
    end
    # Restore callee-saved registers (reverse order)
    mut i = fctx.frame.saved_regs.len() - 1
    while i >= 0 do
      emit_pop(ctx, fctx.frame.saved_regs[i])
      i = i - 1
    end
    # pop rbp; ret
    emit_pop(ctx, fp)
    emit_ret(ctx)

  when Arch::AArch64 then
    # Restore callee-saved registers from bottom of frame (FP-relative)
    let saved = &fctx.frame.saved_regs
    let ss = fctx.frame.stack_size
    mut si = 0
    while si < saved.len() do
      # off = -(stack_size) + (si * 8), always negative
      let abs_off = ss - (si * 8)
      match saved[si]
      when PhysReg::A64Reg(a) then
        if abs_off <= 256 then
          a64_ldur(&mut ctx.text, a, A64::FP, -(abs_off as i32))
        elsif abs_off <= 4095 then
          a64_sub_rri(&mut ctx.text, A64::X15, A64::FP, abs_off as u32)
          a64_ldur(&mut ctx.text, a, A64::X15, 0)
        else
          a64_mov_ri(&mut ctx.text, A64::X15, abs_off as i64)
          a64_sub_rrr(&mut ctx.text, A64::X15, A64::FP, A64::X15)
          a64_ldur(&mut ctx.text, a, A64::X15, 0)
        end
      when _ then ()
      end
      si = si + 1
    end
    # mov sp, fp (deallocate entire frame at once)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::FP)
    # ldp fp, lr, [sp], #16  (post-index: restore fp and lr)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Phi resolution — emit copies for phi nodes in successor blocks
# ———————————————————————————————————————————————————————————————

def get_successor_ids(term: &MirTerminator) -> Vec[Int]
  mut succs = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    succs.push(target.id)
  when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
    for sw in targets do
      succs.push(sw.target.id)
    end
    succs.push(default_target.id)
  when MirTerminatorKind::MirCall(dest, func_op, args, success, unwind) then
    succs.push(success.id)
  when MirTerminatorKind::MirDrop(place, target, unwind) then
    succs.push(target.id)
  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    succs.push(target.id)
  when MirTerminatorKind::MirYield(op, target) then
    succs.push(target.id)
  when _ then ()
  end
  succs
end

def emit_phi_copies(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, block: &MirBlock, func: &MirFunction) -> Unit
  let rr = ret_reg(ctx.target.arch)
  let succ_ids = get_successor_ids(&block.terminator)
  let cur_id = block.id.id

  for succ_id in succ_ids do
    if succ_id < func.blocks.len() then
      let succ_block = func.blocks[succ_id]
      for stmt in succ_block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          match rvalue.kind
          when MirRvalueKind::MirPhi(pairs) then
            # Find the pair for our current block
            for pair in pairs do
              if pair.0.id == cur_id then
                # Load from the predecessor local
                let fp = fp_reg(ctx.target.arch)
                match fctx.var_locs.get(pair.1.id)
                when Option::Some(loc) then
                  match loc
                  when VarLoc::Register(r) then emit_mov_rr(ctx, rr, r)
                  when VarLoc::Stack(off)  then emit_load_mem(ctx, rr, fp, off)
                  when VarLoc::Spilled(off) then emit_load_mem(ctx, rr, fp, off)
                  end
                when Option::None then ()
                end
                # Store to the phi destination
                store_place(ctx, fctx, &place, rr)
              end
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Function code generation
# ———————————————————————————————————————————————————————————————

def codegen_function(ctx: &mut CodegenCtx, func: &MirFunction) -> Unit
  # Extern functions don't get a body — they are resolved at link time.
  # Emit an undefined symbol entry so the linker knows to resolve it.
  if func.is_extern then
    # Add undefined symbol (N_EXT) for extern function
    add_symbol(&mut ctx.text, AsmSymbol {
      name: func.name.clone(),
      section: Section::Extern,  # Mark as external/undefined
      offset: 0,
      size: 0,
      binding: SymBinding::Global,
      kind: SymKind::Func
    })
    return
  end

  # Register allocation — allocate_locals now also pre-scans the MIR to
  # reserve space for dynamic spills (aggregates, address-of), so
  # frame.stack_size includes everything and is final.
  let (var_locs, frame) = allocate_locals(func, ctx.target.arch, &ctx.type_layout)

  # Block labels
  let block_labels = make_block_labels(func)
  let str_locals = compute_string_locals(func)
  mut fctx = FnCodegenCtx {
    func: func.clone(),
    frame: frame,
    var_locs: var_locs,
    block_labels: block_labels,
    string_locals: str_locals
  }

  # Align function start to 4 bytes (required for ARM64 instruction alignment)
  align_to(&mut ctx.text, 4, ctx.target.arch)

  let fn_start = buf_pos(&ctx.text)
  ctx.debug_current_fn = func.name.clone()
  let symbol_name = func.name.clone()
  let entry_label = match ctx.fn_alias.get(&symbol_name)
  when Option::Some(label) then label.clone()
  when Option::None then symbol_name.clone()
  end

  # Emit function symbol
  add_symbol(&mut ctx.text, AsmSymbol {
    name: symbol_name.clone(),
    section: Section::Text,
    offset: fn_start,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })

  # Define the function entry label for direct calls/fixups.
  def_label(&mut ctx.text, entry_label)

  # Prologue
  codegen_prologue(ctx, &fctx)

  # ABI-provided argc and argv into .data globals so the runtime can
  if func.name == "main" || func.name == "_start" then
    emit_save_argc_argv(ctx)
  end

  # Emit all blocks
  mut block_idx = 0
  while block_idx < func.blocks.len() do
    let block = &func.blocks[block_idx]
    let label = block_label_for(&fctx, block.id.id)
    def_label(&mut ctx.text, label)

    mut stmt_idx = 0
    while stmt_idx < block.statements.len() do
      codegen_statement(ctx, &mut fctx, block, stmt_idx)
      stmt_idx = stmt_idx + 1
    end

    # Phi resolution: copy values into phi destinations in successor blocks
    emit_phi_copies(ctx, &mut fctx, block, func)
    codegen_terminator(ctx, &fctx, &block.terminator)
    block_idx = block_idx + 1
  end

  # Patch the symbol size
  let fn_end = buf_pos(&ctx.text)
  # (Symbol size patching would update the last symbol's size field)
end

# ———————————————————————————————————————————————————————————————
# Static variables
# ———————————————————————————————————————————————————————————————

def clone_static_init_operand(st: &MirStatic) -> Option[MirOperand]
  match &st.init
  when Option::Some(op) then Option::Some(op.clone())
  when Option::None then Option::None
  end
end

def codegen_static(ctx: &mut CodegenCtx, st: &MirStatic) -> Unit
  let sz = type_size(&st.ty, &ctx.type_layout)
  let init_opt = clone_static_init_operand(st)

  # Detect Vec/Slice-typed statics — they need a pointer to a 24-byte struct
  let is_vec_type = match st.ty
  when Type::Array(_, _) then true
  when Type::Slice(_) then true
  when _ then false
  end
  
  match init_opt
  when Option::Some(op) then
    # Align data buffer to 8 bytes before emitting any static
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end

    # For Vec statics: emit a 24-byte empty vec struct in data, then
    # emit the static as a pointer to that struct
    if is_vec_type then
      let vec_data_label = ".Lvec_init_" + st.name.clone()
      add_symbol(&mut ctx.data, AsmSymbol {
        name: vec_data_label.clone(),
        section: Section::Data,
        offset: buf_pos(&ctx.data),
        size: 24,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
      def_label(&mut ctx.data, vec_data_label.clone())
      emit64_le(&mut ctx.data, 0)
      # Now emit the static variable itself as a pointer to the vec struct
      add_symbol(&mut ctx.data, AsmSymbol {
        name: st.name.clone(),
        section: Section::Data,
        offset: buf_pos(&ctx.data),
        size: 8,
        binding: SymBinding::Global,
        kind: SymKind::Data
      })
      def_label(&mut ctx.data, st.name.clone())
      add_reloc(&mut ctx.data, RelocKind::R_AARCH64_ABS64, vec_data_label, 0)
      emit64_le(&mut ctx.data, 0)  # Placeholder, patched by linker
      return
    end

    # Initialized - goes into .data section
    add_symbol(&mut ctx.data, AsmSymbol {
      name: st.name.clone(),
      section: Section::Data,
      offset: buf_pos(&ctx.data),
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    def_label(&mut ctx.data, st.name.clone())

    match &op.kind
    when MirOperandKind::MirConstant(cst) then
      match &cst.kind
      when MirConstantKind::MirInt(v) then
        emit64_le(&mut ctx.data, v as u64)
        # Pad remaining bytes to fill the full type size
        mut emitted = 8
        while emitted < sz do
          emit8(&mut ctx.data, 0)
          emitted = emitted + 1
        end
      when MirConstantKind::MirBool(b) then
        if b then emit8(&mut ctx.data, 1) else emit8(&mut ctx.data, 0) end
        # Pad to alignment
        mut pad = sz - 1
        while pad > 0 do
          emit8(&mut ctx.data, 0)
          pad = pad - 1
        end
      when MirConstantKind::MirString(s) then
          # String constant: emit raw pointer to null-terminated rodata.
        let label = intern_string(ctx, s)
        # Emit relocation for the string pointer
        add_reloc(&mut ctx.data, RelocKind::R_AARCH64_ABS64, label.clone(), 0)
        emit64_le(&mut ctx.data, 0)  # Placeholder, patched by linker
      when _ then
        mut i = 0
        while i < sz do
          emit8(&mut ctx.data, 0)
          i = i + 1
        end
      end
    when _ then
      mut i = 0
      while i < sz do
        emit8(&mut ctx.data, 0)
        i = i + 1
      end
    end
    # Ensure 8-byte alignment after emission
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end
  when Option::None then
    # Uninitialized/zero-initialized - goes into .bss section
    # Track symbol in bss_symbols with current bss_size as offset
    ctx.bss_symbols.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Bss,
      offset: ctx.bss_size,
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    # Align bss_size appropriately
    let align = type_align(&st.ty)
    let rem = ctx.bss_size % align
    if rem != 0 then
      ctx.bss_size = ctx.bss_size + (align - rem)
    end
    ctx.bss_size = ctx.bss_size + sz
  end
end

# ———————————————————————————————————————————————————————————————
# Dead Code Elimination — only codegen functions reachable from main
# ———————————————————————————————————————————————————————————————

def collect_fn_refs_from_operand(op: &MirOperand, out: &mut Vec[String]) -> Unit
  match &op.kind
  when MirOperandKind::MirConstant(cst) then
    match &cst.kind
    when MirConstantKind::MirFnItem(name) then
      out.push(name.clone())
    when _ then ()
    end
  when _ then ()
  end
end

def collect_fn_refs_from_rvalue(rv: &MirRvalue, out: &mut Vec[String]) -> Unit
  match &rv.kind
  when MirRvalueKind::MirMove(op) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirBinOp(_, left, right) then
    collect_fn_refs_from_operand(left, out)
    collect_fn_refs_from_operand(right, out)
  when MirRvalueKind::MirUnOp(_, op) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      collect_fn_refs_from_operand(op, out)
    end
  when MirRvalueKind::MirCast(_, op, _) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirRepeat(op, _) then
    collect_fn_refs_from_operand(op, out)
  when _ then ()
  end
end

def collect_fn_refs(func: &MirFunction) -> Vec[String]
  mut refs: Vec[String] = Vec::new()
  for block in func.blocks do
    # Scan statements
    for stmt in block.statements do
      match &stmt.kind
      when MirStatementKind::MirAssign(_, rv) then
        collect_fn_refs_from_rvalue(rv, &mut refs)
      when MirStatementKind::MirContractCheck(_, cond) then
        collect_fn_refs_from_operand(cond, &mut refs)
      when MirStatementKind::MirEffectRecord(_, op) then
        collect_fn_refs_from_operand(op, &mut refs)
      when _ then ()
      end
    end
    # Scan terminator
    match &block.terminator.kind
    when MirTerminatorKind::MirCall(_, callee, args, _, _) then
      collect_fn_refs_from_operand(callee, &mut refs)
      for arg in args do
        collect_fn_refs_from_operand(arg, &mut refs)
      end
    when MirTerminatorKind::MirSwitchInt(op, _, _) then
      collect_fn_refs_from_operand(op, &mut refs)
    when MirTerminatorKind::MirAssert(cond, _, _, _, _) then
      collect_fn_refs_from_operand(cond, &mut refs)
    when _ then ()
    end
  end
  refs
end

# Extract the bare (unqualified) name from a potentially qualified function name.
# "std::env::args" → "args", "Vec__push" → "push", "main" → "main"
def find_double_underscore(name: &String) -> Int
  if name.len() < 2 then
    return -1
  end
  mut i = 0
  while i + 1 < name.len() do
    if name.slice(i, i + 2) == "__" then
      return i
    end
    i = i + 1
  end
  -1
end

def rfind_double_colon(name: &String) -> Int
  if name.len() < 2 then
    return -1
  end
  mut i = name.len() - 2
  loop
    if name.slice(i, i + 2) == "::" then
      return i
    end
    if i == 0 then
      break
    end
    i = i - 1
  end
  -1
end

def bare_name_from_qualified(name: String) -> String
  # Handle Type__method mangled names
  let mangled_pos = find_double_underscore(&name)
  if mangled_pos > 0 then
    return name.slice(mangled_pos + 2, name.len())
  end

  # Handle :: qualified names
  let qual_pos = rfind_double_colon(&name)
  if qual_pos >= 0 then
    return name.slice(qual_pos + 2, name.len())
  end

  name.clone()
end

# Build a canonical lookup key for a function reference name.
# This normalizes all the different ways a function can be referenced:
# - Bare names: "args", "push", "len"
# - Qualified names: "std::env::args", "Vec::push"
# - Mangled names: "Vec__push", "Array__push", "String__to_lowercase"
# - Intrinsic wrappers: "__intrinsic_array_push"
def canonical_fn_ref(name: String) -> String
  # First, normalize intrinsic wrapper prefix
  if name.len() >= 12 then
    if name.slice(0, 12) == "__intrinsic_" then
      return name.slice(12, name.len())
    end
  end
  
  # Normalize Type__method to canonical intrinsic form
  let mangled_pos = find_double_underscore(&name)
  if mangled_pos > 0 then
    let prefix = name.slice(0, mangled_pos)
    let bare = name.slice(mangled_pos + 2, name.len())
    # Known collection type prefixes → canonical intrinsic prefix
    if prefix == "Vec" || prefix == "Array" then
      return "array_" + bare
    else if prefix == "Map" then
      return "map_" + bare
    else if prefix == "Set" then
      return "set_" + bare
    # String type methods use the same canonical form as bare_intrinsic_name.
    else if prefix == "String" then
      return "string_" + bare
    # Formatter type methods
    else if prefix == "Formatter" then
      return "fmt_" + bare
    # Option type methods
    else if prefix == "Option" then
      return "option_" + bare
    # Result type methods
    else if prefix == "Result" then
      return "result_" + bare
    # Iterator type methods
    else if prefix == "Iterator" then
      return "iter_" + bare
    # File/IO types
    else if prefix == "File" then
      return "file_" + bare
    else if prefix == "Io" then
      return "io_" + bare
    end
    # For other types, return bare method name
    return bare
  end
  
  # For qualified names, extract the bare name for matching
  let qual_pos = rfind_double_colon(&name)
  if qual_pos >= 0 then
    # Return bare name for lookup
    return name.slice(qual_pos + 2, name.len())
  end
  
  name.clone()
end

def compute_reachable(program: &MirProgram) -> Set[String]
  # EMIT ALL FUNCTIONS — bootstrap mode.
  # During bootstrap compilation, the compiler compiles individual compiler source
  # files (e.g. agentic.tg) whose MIR may NOT contain the compiler driver functions
  # (cmd_compile, compile_startup_entry) needed to trigger the old bootstrap
  # heuristics. Rather than trying to detect "is this a bootstrap compile?" from
  # the MIR contents (which is fragile), we unconditionally emit all functions.
  # Dead-code elimination (DCE) can be reintroduced as an optimization pass once
  # the compiler is fully self-hosted and the bootstrap chain is complete.
  mut all_fns: Set[String] = Set::new()
  for func in program.functions do
    all_fns.insert(func.name.clone())
  end
  all_fns
end

def compute_reachable_dce(program: &MirProgram) -> Set[String]
  # Build name -> function index map with MULTIPLE aliases per function.
  # This is the production fix: each function is registered under:
  # 1. Its full MIR name (e.g., "std::env::args")
  # 2. Its bare name (e.g., "args") for unqualified references
  # 3. Its canonical intrinsic name if applicable (e.g., "array_push" for "Vec__push")
  mut fn_map: Map[String, Int] = Map::new()
  mut idx = 0
  for func in program.functions do
    # Debug: trace println registration
    if func.name == "println" || func.name.contains("println") then
    end
    # Register under full name
    fn_map.insert(func.name.clone(), idx)
    
    # Register under bare name (last segment after :: or before __)
    let bare = bare_name_from_qualified(func.name.clone())
    if bare != func.name then
      fn_map.insert(bare.clone(), idx)
    end
    
    # Register under canonical intrinsic-normalized name
    let canonical = canonical_fn_ref(func.name.clone())
    if canonical != func.name && canonical != bare then
      fn_map.insert(canonical.clone(), idx)
    end
    
    idx = idx + 1
  end

  # BFS from "main"
  mut reachable: Set[String] = Set::new()
  mut worklist: Vec[String] = Vec::new()
  worklist.push("main".to_string())
  reachable.insert("main".to_string())

  while worklist.len() > 0 do
    let name = match worklist.pop()
    when Option::Some(n) then n
    when Option::None then break
    end
    if name == "main" || name == "println" then
    end
    
    # Try to find the function - first by exact name, then by canonical form
    mut func_idx: Option[Int] = fn_map.get(&name)
    match func_idx
    when Option::None then
      # Try canonical form
      let canonical = canonical_fn_ref(name.clone())
      func_idx = fn_map.get(&canonical)
    when Option::Some(_) then ()
    end
    
    match func_idx
    when Option::Some(fi) then
      let func = &program.functions[fi]
      let refs = collect_fn_refs(func)
      for r in refs do
        # Normalize the reference for lookup
        let r_canonical = canonical_fn_ref(r.clone())
        mut r_idx = fn_map.get(&r)
        match r_idx
        when Option::None then
          # Try canonical form
          r_idx = fn_map.get(&r_canonical)
        when Option::Some(_) then
          ()
        end
        
        # Get the actual function name for the reachable set
        match r_idx
        when Option::Some(actual_idx) then
          let actual_func = &program.functions[actual_idx]
          let actual_name = actual_func.name.clone()
          let is_in = reachable.contains(&actual_name)
          # Use explicit == false instead of ! to work around potential interpreter bug
          if is_in == false then
            reachable.insert(actual_name.clone())
            worklist.push(actual_name.clone())
          end
        when Option::None then
          # Function not found - could be intrinsic or extern
          # Add to reachable anyway for intrinsics
          if is_intrinsic(&r) || is_intrinsic(&r_canonical) then
            if !reachable.contains(&r) then
              reachable.insert(r.clone())
            end
          end
        end
      end
    when Option::None then
      ()
    end
  end

  reachable
end

# ———————————————————————————————————————————————————————————————
# Intrinsic function detection
# ———————————————————————————————————————————————————————————————

# Resolve a dot-prefixed method name (e.g. ".keys") to a qualified name
# using the receiver argument's type. Returns Type__method format which
# the codegen can resolve through compiled function bodies or intrinsics.
def resolve_dot_method(ctx: &CodegenCtx, fctx: &FnCodegenCtx, fn_name: &String, args: &Vec[MirOperand]) -> String
  if fn_name.len() <= 1 then
    return fn_name.clone()
  end
  if fn_name.slice(0, 1) != "." then
    return fn_name.clone()
  end
  let method = fn_name.slice(1, fn_name.len())
  if args.len() == 0 then
    return method
  end
  let recv_ty = strip_ref_like_type(&operand_type(ctx, fctx, &args[0]))
  match recv_ty
  when Type::Map(_, _) then "Map__" + method
  when Type::Set(_) then "Set__" + method
  when Type::Array(_, _) then "Vec__" + method
  when Type::Slice(_) then "Vec__" + method
  when Type::Char then
    if method == "to_string" then "__intrinsic_char_to_string"
    else "Char__" + method
    end
  when Type::String then "String__" + method
  when Type::Option(_) then "Option__" + method
  when Type::Result(_, _) then "Result__" + method
  when Type::Named(tid, _) then
    let type_name = type_name_by_id(ctx, tid.id)
    if type_name != "" then
      type_name + "__" + method
    else
      method
    end
  when _ then method
  end
end

# Normalize a potentially mangled function name to its canonical intrinsic name.
# Handles three naming patterns:
#   1. __intrinsic_array_push  → array_push   (std library intrinsic wrappers)
#   2. Vec__push / Array__push → array_push   (known collection type prefixes)
#      Map__insert             → map_insert
#      Set__contains           → set_contains
#   3. Lexer__push             → push          (unknown struct prefix, bare name)
# Returns the original name unchanged if no pattern matches.
def bare_intrinsic_name(name: &String) -> String
  # Pattern 0: Strip leading dot from method names (MIR uses .method_name)
  if name.len() > 1 then
    if name.slice(0, 1) == "." then
      let stripped = name.slice(1, name.len())
      return bare_intrinsic_name(&stripped)
    end
  end

  # Pattern 0b: Some lowered names carry a single leading underscore
  # (e.g. _Set__clone). Normalize those before collection prefix matching.
  if name.len() > 2 then
    if name.slice(0, 1) == "_" && name.slice(1, 2) != "_" then
      let trimmed = name.slice(1, name.len())
      let normalized = bare_intrinsic_name(&trimmed)
      if normalized != trimmed then
        return normalized
      end
    end
  end

  # Pattern 1: __intrinsic_ prefix from std library impl bodies
  if name.len() >= 12 then
    if name.slice(0, 12) == "__intrinsic_" then
      mut result = name.slice(12, name.len())
      # Strip generic parameters if present
      match result.find("<")
      when Option::Some(i) then result = result.slice(0, i)
      when Option::None then ()
      end
      return result
    end
  end

  # Pattern 2 & 3: Type__method mangled names
  let sep = "__"
  match name.find(sep)
  when Option::Some(pos) then
    if pos == 0 then
      # Name starts with __ but not __intrinsic_ — return unchanged
      return name.clone()
    end
    let prefix = name.slice(0, pos)
    mut bare = name.slice(pos + 2, name.len())
    # Strip generic parameters (e.g., "new<String>" → "new")
    match bare.find("<")
    when Option::Some(i) then bare = bare.slice(0, i)
    when Option::None then ()
    end
    # Known collection/stdlib type prefixes → canonical intrinsic prefix
    if prefix == "Vec" || prefix == "Array" then
      "array_" + bare
    else if prefix == "Map" then
      "map_" + bare
    else if prefix == "Set" then
      "set_" + bare
    else if prefix == "String" then
      "string_" + bare
    else if prefix == "Formatter" then
      # Formatter methods: emit_newline, emit_blank_line, emit, space, etc.
      # These are identity/no-op intrinsics
      bare
    else if prefix == "Option" || prefix == "Result" then
      # Option/Result methods: unwrap, unwrap_or, is_some, is_none, etc.
      bare
    else if prefix == "Io" || prefix == "File" then
      # IO/File methods
      bare
    else if prefix == "Budget" || prefix == "PanicInfo" || prefix == "TypeExpr" then
      # Utility types
      bare
    else if prefix == "Span" || prefix == "LocalId" || prefix == "BlockId" then
      # ID types
      bare
    else if prefix == "MirFunction" || prefix == "MirStatement" || prefix == "MirRvalue" then
      # MIR types
      bare
    else if prefix == "MirTerminator" || prefix == "AggregateKind" || prefix == "AsmTarget" then
      # More MIR types
      bare
    else if prefix == "InlineResult" || prefix == "Place" || prefix == "PgoProfile" then
      # More types
      bare
    else if prefix == "LifetimeCtx" || prefix == "MirProgram" || prefix == "Type" then
      # More types
      bare
    else if prefix == "IfStmt" || prefix == "LocalDef" || prefix == "FieldDef" then
      # More types  
      bare
    else if prefix == "Repl" || prefix == "ReplContext" then
      # REPL types
      bare
    else
      # Unknown struct prefix (e.g. Lexer__advance)
      # Return the FULL mangled name unchanged — these are NOT intrinsics,
      # they are regular method calls on user-defined types.
      name.clone()
    end
  when Option::None then
    name.clone()
  end
end

def is_intrinsic(name: &String) -> Bool
  # Regular functions with bodies in std/ — NEVER treat as intrinsics.
  # Must be near the top because stage0 cannot evaluate the full || chain.
  if name == "open" || name == "close" || name == "read" || name == "write" ||
     name == "raw_read" || name == "raw_write" || name == "raw_open" || name == "raw_close" then
    return false
  end

  # File-to-string runtime intrinsic (bypass Vec ABI issues in bootstrap)
  if name == "read_file_to_string_native" then
    return true
  end

  # Bare contains() is too ambiguous to inline safely at this stage.
  # Prefer the actual std method body (String/Array/Set) over intrinsic guessing.
  if name == "contains" then
    return false
  end

  # __intrinsic_ prefixed names (canonical form from stdlib wrappers)
  if name.len() >= 12 then
    if name.slice(0, 12) == "__intrinsic_" then
      return true
    end
  end
  
  # Collection intrinsics that MUST be near the top (stage0 interpreter
  # may fail to evaluate very long || chains to the end)
  if name == "array_as_ptr_address" || name == "array_as_str" ||
     name == "array_replace" || name == "set_is_empty" || name == "map_push" ||
     name == "as_ptr_address" ||
     name == "cstring_new" || name == "cstring_as_ptr" || name == "bytes" then
    return true
  end

  # Core collection intrinsics — must be early returns (stage0 || chain limits)
  if name == "array_new" || name == "array_push" || name == "array_pop" ||
     name == "array_get" || name == "array_set" || name == "array_len" ||
     name == "array_last" || name == "array_first" || name == "array_is_empty" ||
     name == "array_cap" || name == "array_remove" || name == "array_insert" ||
     name == "array_clear" || name == "array_contains" then
    return true
  end
  if name == "array_reverse" || name == "array_sort" || name == "array_extend" ||
     name == "array_truncate" || name == "array_resize" ||
     name == "array_slice" || name == "array_from_list" ||
     name == "array_with_capacity" || name == "array_capacity" then
    return true
  end
  if name == "map_new" || name == "map_insert" || name == "map_get" ||
      name == "map_remove" || name == "map_contains" || name == "map_len" ||
      name == "map_clone" ||
     name == "map_clear" || name == "map_keys" || name == "map_values" ||
     name == "map_entries" || name == "map_contains_key" || name == "map_get_mut" then
    return true
  end
  if name == "set_new" || name == "set_insert" || name == "set_contains" ||
      name == "set_remove" || name == "set_len" || name == "set_clone" || name == "set_clear" ||
     name == "set_entries" then
    return true
  end

  if name == "int_to_string" then return true end
  if name == "uint_to_string" then return true end
  if name == "float_to_string" then return true end
  if name == "bool_to_string" then return true end
  if name == "char_to_string" then return true end
  if name == "str_to_string" then return true end
  if name == "string_from_bytes" then return true end
  if name == "int_to_string_intrinsic" then return true end
  if name == "uint_to_string_intrinsic" then return true end
  if name == "float_to_string_intrinsic" then return true end

  # Syscall intrinsics — early return
  if name == "syscall6" || name == "syscall5" || name == "syscall4" ||
     name == "syscall3" || name == "syscall2" || name == "syscall1" then
    return true
  end
  if name == "resize" then return true end

  # String intrinsics — early return
  if name == "string_new" then return true end

  if name == "str_concat" || name == "str_len" || name == "str_cmp" ||
     name == "str_copy" || name == "str_slice" || name == "str_find" || name == "int_to_str" ||
     name == "float_to_str" || name == "str_to_int" || name == "str_to_float" then
    return true
  end
  if name == "starts_with" || name == "ends_with" ||
     name == "string_starts_with" || name == "string_ends_with" ||
     name == "string_contains" then
    return true
  end
  if name == "clone" || name == "to_string" || name == "len" ||
     name == "as_bytes" || name == "as_ptr" || name == "as_str" ||
     name == "as_mut_ptr" then
    return true
  end
  if name == "is_some" || name == "is_none" || name == "unwrap" || name == "unwrap_or" ||
     name == "is_ok" || name == "is_err" then
    return true
  end

  # Syscall intrinsics
  name == "syscall6" || name == "syscall5" || name == "syscall4" ||
  name == "syscall3" || name == "syscall2" || name == "syscall1" ||
  # NOTE: raw_read/raw_write are regular functions, NOT intrinsics (removed)
  name == "resize" ||
  # String conversion intrinsics (used by std/fmt.tg)
  name == "int_to_string" || name == "uint_to_string" ||
  name == "float_to_string" || name == "bool_to_string" ||
  name == "str_to_string" || name == "string_from_bytes" ||
  name == "int_to_string_intrinsic" || name == "uint_to_string_intrinsic" ||
  name == "float_to_string_intrinsic" ||
  # Identity/no-op intrinsics (canonical names)
  name == "as_bytes" || name == "as_ptr" || name == "as_str" ||
  name == "as_mut_ptr" || name == "len" ||
  name == "clone" || name == "to_string" ||
  # String intrinsics (canonical names)
  name == "string_new" || name == "str_concat" || name == "str_len" || name == "str_cmp" ||
  name == "str_copy" || name == "str_slice" || name == "str_find" || name == "int_to_str" || name == "float_to_str" ||
  name == "str_to_int" || name == "str_to_float" ||
  # String methods (canonical and bare)
  name == "to_lowercase" || name == "to_uppercase" ||
  name == "trim_matches" || name == "trim" ||
  name == "split_once" || name == "split" || name == "lines" ||
  name == "starts_with" || name == "ends_with" ||
  name == "index_of" || name == "last_index_of" ||
  name == "rfind" || name == "find" ||
  name == "parse_int" || name == "parse_float" ||
  name == "to_bits" || name == "from_bits" ||
  name == "to_wide_string" ||
  name == "replace" || name == "slice" ||
  name == "string_replace" || name == "string_find" ||
  name == "string_char_at" || name == "string_push" ||
  name == "string_push_str" || name == "string_split" ||
  name == "string_slice" || name == "string_len" ||
  name == "string_parse_int" ||
  # Array/Vec intrinsics (canonical names)
  name == "array_new" || name == "array_push" || name == "array_pop" ||
  name == "array_get" || name == "array_set" || name == "array_len" ||
  name == "array_cap" || name == "array_remove" || name == "array_insert" ||
  name == "array_clear" || name == "array_contains" ||
  name == "array_last" || name == "array_first" || name == "array_is_empty" ||
  name == "array_reverse" || name == "array_sort" || name == "array_extend" ||
  name == "array_truncate" || name == "array_resize" ||
  # Array aliases for __intrinsic_ names
  name == "array_slice" || name == "array_from_list" ||
  name == "array_with_capacity" || name == "array_capacity" ||
  # Map intrinsics (canonical names)
  name == "map_new" || name == "map_insert" || name == "map_get" ||
  name == "map_remove" || name == "map_contains" || name == "map_len" ||
  name == "map_clone" ||
  name == "map_clear" || name == "map_keys" || name == "map_values" ||
  name == "map_entries" ||
  # Map aliases (contains_key → contains, get_mut → get)
  name == "map_contains_key" || name == "map_get_mut" ||
  # Set intrinsics (canonical names)
  name == "set_new" || name == "set_insert" || name == "set_contains" ||
  name == "set_remove" || name == "set_len" || name == "set_clone" || name == "set_clear" ||
  name == "set_entries" ||
  # Memory intrinsics
  name == "mem_alloc" || name == "mem_free" || name == "mem_copy" ||
  name == "mem_set" || name == "mem_zero" ||
  # Hash intrinsics
  name == "hash_int" || name == "hash_str" || name == "hash_combine" ||
  # String iteration
  name == "chars" ||
  # String byte indexing
  name == "char_at" ||
  # Option/Result discriminant checks
  name == "is_some" || name == "is_none" ||
  name == "is_ok" || name == "is_err" ||
  # Option/Result unwrap
  name == "unwrap" || name == "unwrap_or" ||
  # Formatter intrinsics
  name == "emit_newline" || name == "emit_blank_line" ||
  name == "emit" || name == "space" ||
  name == "would_overflow" || name == "indent" || name == "dedent" ||
  # BARE method names that may not be properly mangled in MIR lowering
  # These are critical for bootstrap - if the MIR lowering fails to mangle
  # the method name, we still need to recognize these as intrinsics.
  # Array/Vec methods (bare)
  name == "push" || name == "pop" || name == "get" || name == "set" ||
  name == "cap" || name == "is_empty" ||
  name == "first" || name == "last" || name == "contains" ||
  name == "insert" || name == "remove" || name == "clear" ||
  name == "reverse" || name == "sort" || name == "extend" ||
  name == "truncate" || name == "resize" ||
  # Map methods (bare)
  name == "map" || name == "entries" || name == "keys" || name == "values" ||
  name == "contains_key" || name == "get_mut" ||
  # Iterator methods (bare)
  name == "join" || name == "collect" ||
  # IO/File intrinsics
  # NOTE: "read", "write", "raw_read", "raw_write", "open", "close" are regular
  # functions with bodies in std/fs.tg. Do NOT list them as intrinsics, or their
  # call chains will not be discovered by reachability and will fall through to
  # NOP_FALLBACK (returning zero) instead of emitting real function calls.
  name == "truncate" || name == "resize" ||
  # Process/Environment intrinsics
  name == "status" || name == "output" ||
  name == "stdout_string" || name == "stderr_string" ||
  name == "lint_file" ||
  # Utility intrinsics
  name == "cmp" || name == "to_int" || name == "eval" ||
  # File constants (treated as intrinsics that return constant values)
  name == "SYS_WRITE" || name == "SYS_READ" || name == "SYS_OPEN" ||
  name == "SYS_CLOSE" || name == "SYS_EXIT" ||
  name == "O_WRONLY" || name == "O_RDWR" || name == "O_APPEND" ||
  name == "O_CREAT" || name == "O_TRUNC" ||
  name == "open_windows" ||
  # Additional method names that need to be recognized as intrinsics
  # These are called as Vec__method, Map__method, Set__method, String__method
  # NOTE: bare "read"/"write" REMOVED — they match regular fs functions
  name == "parse_float" || name == "string_parse_float" ||
  # Vec/Array methods that resolve to clone
  name == "Vec__clone" || name == "Array__clone" ||
  name == "Vec__starts_with" || name == "Vec__ends_with" ||
  name == "Vec__to_string" || name == "Array__to_string" ||
  name == "Vec__read" || name == "Array__read" ||
  name == "Vec__join" || name == "Array__join" ||
  # Vec pointer methods (return data ptr)
  name == "Vec__as_ptr" || name == "Vec__as_mut_ptr" ||
  name == "Array__as_ptr" || name == "Array__as_mut_ptr" ||
  name == "array_as_ptr" || name == "array_as_mut_ptr" ||
  name == "array_as_ptr_address" || name == "array_as_str" ||
  name == "array_replace" ||
  # Set methods
  name == "set_is_empty" ||
  # Map methods
  name == "map_push" ||
  name == "Map__unwrap" || name == "Map__clone" ||
  # Set methods
  name == "Set__clone" || name == "Set__unwrap" ||
  # Canonical array_/map_/set_/string_ intrinsics (from bare_intrinsic_name normalization)
  name == "array_clone" || name == "array_starts_with" || name == "array_ends_with" ||
  name == "array_to_string" || name == "array_read" || name == "array_join" ||
  name == "array_as_ptr" || name == "array_as_mut_ptr" ||
  name == "map_unwrap" || name == "map_clone" ||
  name == "set_clone" || name == "set_unwrap" ||
  # String__ prefixed method variants (after bare_intrinsic_name transformation)
  name == "string_clone" || name == "string_is_empty" || name == "string_chars" ||
  name == "string_as_bytes" || name == "string_as_ptr" || name == "string_as_str" ||
  name == "string_to_wide_string" || name == "string_to_string" ||
  name == "string_ends_with" || name == "string_starts_with" ||
  name == "string_len" || name == "string_index_of" || name == "string_last_index_of" ||
  name == "string_rfind" || name == "string_trim" || name == "string_trim_matches" ||
  name == "string_to_lowercase" || name == "string_to_uppercase" ||
  name == "string_contains" || name == "string_replace" ||
  name == "string_slice" || name == "string_split" || name == "string_lines" ||
  name == "string_split_once" ||
  name == "string_unwrap_or" || name == "String__unwrap_or" ||
  # Type__method variants for various std types
  name == "PanicInfo__clone" || name == "TypeExpr__clone" ||
  name == "Span__clone" || name == "LifetimeCtx__to_string" ||
  name == "MirProgram__to_string" || name == "Type__clone" ||
  name == "Type__collect" || name == "Type__unwrap" ||
  name == "InlineResult__unwrap_or" || name == "MirStatement__unwrap_or" ||
  name == "Place__unwrap_or" || name == "MirRvalue__collect" ||
  name == "MirRvalue__unwrap_or" || name == "MirTerminator__unwrap_or" ||
  name == "PgoProfile__unwrap_or" || name == "LocalId__clone" ||
  name == "BlockId__clone" || name == "MirFunction__clone" ||
  name == "MirStatement__clone" || name == "MirRvalue__clone" ||
  name == "AggregateKind__clone" || name == "MirTerminatorKind__clone" ||
  name == "AsmTarget__clone" || name == "Budget__unwrap_or" ||
  name == "Budget__trim" || name == "IfStmt__len"
  # try_invoke is handled as extern function, not inline intrinsic
end

# ———————————————————————————————————————————————————————————————
# Runtime string concatenation
# ———————————————————————————————————————————————————————————————

# Emit _tg_str_concat runtime function into text section.
# ABI: arg0 = ptr to null-terminated string A
#      arg1 = ptr to null-terminated string B
# Returns: ptr to newly allocated concatenation (A + B + '\0')
# Uses mmap for allocation. One page per call.
def emit_runtime_str_concat(ctx: &mut CodegenCtx) -> Unit
  def_label(&mut ctx.text, "_tg_str_concat")
  match ctx.target.arch
  when Arch::AArch64 then emit_str_concat_aarch64(ctx)
  when Arch::X86_64  then emit_str_concat_x86_64(ctx)
  end
end

def emit_str_concat_aarch64(ctx: &mut CodegenCtx) -> Unit
  # Prologue: save FP, LR, callee-saved x19-x23
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)

  # Save input args
  a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # ptr_a
  a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # ptr_b

   # strlen(ptr_a) → x21 (NULL/low-addr pointer → empty string)
   a64_mov_ri(&mut ctx.text, A64::X9, 0)
   a64_cmp_ri(&mut ctx.text, A64::X19, 0x1000)
   a64_bcond(&mut ctx.text, a64_cc_lt(), ".Lsc_la_d")
   def_label(&mut ctx.text, ".Lsc_la")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_la_d")
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_la")
  def_label(&mut ctx.text, ".Lsc_la_d")
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X9)

   # strlen(ptr_b) → x22 (NULL/low-addr pointer → empty string)
   a64_mov_ri(&mut ctx.text, A64::X9, 0)
   a64_cmp_ri(&mut ctx.text, A64::X20, 0x1000)
   a64_bcond(&mut ctx.text, a64_cc_lt(), ".Lsc_lb_d")
   def_label(&mut ctx.text, ".Lsc_lb")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X20, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_lb_d")
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_lb")
  def_label(&mut ctx.text, ".Lsc_lb_d")
  a64_mov_rr(&mut ctx.text, A64::X22, A64::X9)

  # total = len_a + len_b + 1  (size arg for the bump allocator in X0)
  a64_add_rrr(&mut ctx.text, A64::X0, A64::X21, A64::X22)
  a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)

  # Allocate the result from the shared bump arena (size in X0 -> ptr in X0).
  # Previously this did a fresh mmap per concatenation, which on macOS rounds
  # each allocation up to a 16 KB page and never frees it — driving the
  # self-hosted compiler to multi-GB RSS and non-deterministic OOM (SIGKILL).
  # _tg_bump_alloc preserves X19/X20 and leaves X21-X28 untouched, so the
  # saved pointers/lengths (X19-X23) survive the call.
  a64_bl(&mut ctx.text, "_tg_bump_alloc")

  # x0 = buf
  a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)

  # memcpy(buf, ptr_a, len_a)
  a64_mov_ri(&mut ctx.text, A64::X9, 0)
   def_label(&mut ctx.text, ".Lsc_ca")
   a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
   a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_ca_d")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X9)
   a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_ca")
  def_label(&mut ctx.text, ".Lsc_ca_d")

  # memcpy(buf + len_a, ptr_b, len_b)
  a64_mov_ri(&mut ctx.text, A64::X9, 0)
   def_label(&mut ctx.text, ".Lsc_cb")
   a64_cmp_rr(&mut ctx.text, A64::X9, A64::X22)
   a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_cb_d")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X20, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X21)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X9)
   a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_cb")
  def_label(&mut ctx.text, ".Lsc_cb_d")

  # Null terminate: buf[len_a + len_b] = 0
  a64_add_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X22)
  a64_add_rrr(&mut ctx.text, A64::X9, A64::X23, A64::X9)
  a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

  # Return buf
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)

  # Epilogue
  a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
  a64_ret(&mut ctx.text)
end

def emit_str_concat_x86_64(ctx: &mut CodegenCtx) -> Unit
  # Prologue: save callee-saved regs (rbx, r12-r15)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)
  x64_push(&mut ctx.text, X64::R15)

  # Save input args
  x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # ptr_a
  x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)    # ptr_b

  # strlen(ptr_a) → r13. Use rdi=ptr, rcx=counter, same encoding as codegen_strlen
  x64_mov_ri(&mut ctx.text, X64::RCX, 0)
  x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_la_d")
  def_label(&mut ctx.text, ".Lsc_la")
  # movzx eax, byte [rdi + rcx]
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x0F)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_la_d")
  x64_add_ri(&mut ctx.text, X64::RCX, 1)
  x64_jmp(&mut ctx.text, ".Lsc_la")
  def_label(&mut ctx.text, ".Lsc_la_d")
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RCX)

  # strlen(ptr_b) → r14. rdi = ptr_b
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
  x64_mov_ri(&mut ctx.text, X64::RCX, 0)
  x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_lb_d")
  def_label(&mut ctx.text, ".Lsc_lb")
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x0F)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_lb_d")
  x64_add_ri(&mut ctx.text, X64::RCX, 1)
  x64_jmp(&mut ctx.text, ".Lsc_lb")
  def_label(&mut ctx.text, ".Lsc_lb_d")
  x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)

  # total = len_a + len_b + 1 → rdi (size arg for the bump allocator)
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
  x64_add_rr(&mut ctx.text, X64::RDI, X64::R14)
  x64_add_ri(&mut ctx.text, X64::RDI, 1)

  # Allocate the result from the shared bump arena (size in RDI -> ptr in RAX).
  # Previously this did a fresh mmap per concatenation, which never frees and
  # drove the self-hosted compiler to multi-GB RSS and non-deterministic OOM.
  # _tg_bump_alloc preserves RBX/R12/RBP and leaves R13-R15 untouched, so the
  # saved pointers/lengths survive the call.
  x64_call_label(&mut ctx.text, "_tg_bump_alloc")
  # rax = buf
  x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)

  # memcpy(buf, ptr_a, len_a) via rep movsb: rdi=dst, rsi=src, rcx=count
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
  emit8(&mut ctx.text, 0xF3)
  emit8(&mut ctx.text, 0xA4)

  # memcpy(buf + len_a, ptr_b, len_b): rdi already advanced by rep movsb
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  emit8(&mut ctx.text, 0xF3)
  emit8(&mut ctx.text, 0xA4)

  # Null terminate: mov byte [rdi], 0 (rdi is at buf + len_a + len_b)
  emit8(&mut ctx.text, 0xC6)
  emit8(&mut ctx.text, 0x07)
  emit8(&mut ctx.text, 0x00)

  # Return buf
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R15)
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# String Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# str_len: Get length of null-terminated string. Arg in x0/rdi, returns len in x0/rax
def codegen_str_len(ctx: &mut CodegenCtx) -> Unit
  codegen_strlen(ctx)  # Same as len intrinsic
end

# str_cmp: Compare two null-terminated strings. Args in x0/rdi, x1/rsi. Returns -1, 0, or 1
def codegen_str_cmp(ctx: &mut CodegenCtx) -> Unit
  let lbl_loop = ".Lstrcmp_loop." + ctx.fn_counter.to_string()
  let lbl_eq = ".Lstrcmp_eq." + ctx.fn_counter.to_string()
  let lbl_lt = ".Lstrcmp_lt." + ctx.fn_counter.to_string()
  let lbl_gt = ".Lstrcmp_gt." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrcmp_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X1),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    # x0 = a, x1 = b. Use x9, x10 as byte scratch
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_lt.clone())
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_gt.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_eq.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_lt)
    a64_mov_ri(&mut ctx.text, A64::X0, -1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_gt)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_eq)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RSI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    def_label(&mut ctx.text, lbl_loop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x0E)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::L, lbl_lt.clone())
    x64_jcc(&mut ctx.text, CC::G, lbl_gt.clone())
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_eq.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_lt)
    x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_gt)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_eq)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# starts_with: Check if null-terminated string starts with a prefix.
# Args: x0/rdi = string, x1/rsi = prefix
# Returns: 1 if string starts with prefix, 0 otherwise
def codegen_starts_with(ctx: &mut CodegenCtx) -> Unit
  let lbl_loop = ".Lstw_loop." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lstw_yes." + ctx.fn_counter.to_string()
  let lbl_no = ".Lstw_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstw_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X1),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    # x0 = string, x1 = prefix
    def_label(&mut ctx.text, lbl_loop.clone())
    # Load prefix byte
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    # If prefix byte is 0, prefix exhausted = match!
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    # Load string byte
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    # Compare
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_no.clone())
    # Advance both pointers
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RSI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # rdi = string, rsi = prefix
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx ecx, byte [rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x0E)
    # If prefix byte is 0, match
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    # movzx eax, byte [rdi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_no.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# ends_with: Check if a null-terminated string ends with a suffix.
# Args: x0/rdi = string, x1/rsi = suffix
# Returns: 1 if string ends with suffix, 0 otherwise
def codegen_ends_with(ctx: &mut CodegenCtx) -> Unit
  let lbl_len_s = ".Lew_len_s." + ctx.fn_counter.to_string()
  let lbl_len_s_done = ".Lew_len_s_done." + ctx.fn_counter.to_string()
  let lbl_len_suffix = ".Lew_len_suffix." + ctx.fn_counter.to_string()
  let lbl_len_suffix_done = ".Lew_len_suffix_done." + ctx.fn_counter.to_string()
  let lbl_cmp = ".Lew_cmp." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lew_yes." + ctx.fn_counter.to_string()
  let lbl_no = ".Lew_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lew_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X1),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )

    a64_mov_rr(&mut ctx.text, A64::X2, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X1)

    a64_mov_rr(&mut ctx.text, A64::X4, A64::X2)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    def_label(&mut ctx.text, lbl_len_s.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X4, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_s_done.clone())
    a64_add_rri(&mut ctx.text, A64::X4, A64::X4, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lbl_len_s)

    def_label(&mut ctx.text, lbl_len_s_done)
    a64_mov_rr(&mut ctx.text, A64::X5, A64::X3)
    a64_mov_ri(&mut ctx.text, A64::X12, 0)
    def_label(&mut ctx.text, lbl_len_suffix.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X5, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_suffix_done.clone())
    a64_add_rri(&mut ctx.text, A64::X5, A64::X5, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_len_suffix)

    def_label(&mut ctx.text, lbl_len_suffix_done)
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_no.clone())
    a64_sub_rrr(&mut ctx.text, A64::X13, A64::X11, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X2, A64::X13)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)

    def_label(&mut ctx.text, lbl_cmp.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_no.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_cmp)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done.clone())

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RSI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )

    x64_mov_rr(&mut ctx.text, X64::R8, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R8)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)
    def_label(&mut ctx.text, lbl_len_s.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R10, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_s_done.clone())
    x64_add_ri(&mut ctx.text, X64::R10, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_len_s)

    def_label(&mut ctx.text, lbl_len_s_done)
    x64_mov_rr(&mut ctx.text, X64::R11, X64::R9)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_len_suffix.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R11, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_suffix_done.clone())
    x64_add_ri(&mut ctx.text, X64::R11, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_len_suffix)

    def_label(&mut ctx.text, lbl_len_suffix_done)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::G, lbl_no.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_sub_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)

    def_label(&mut ctx.text, lbl_cmp.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RSI, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::R10, X64::RDI, 0)
    x64_cmp_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_no.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_cmp)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done.clone())

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# str_find: Search for a substring within a string. Returns Option[Int].
# Args: x0/rdi = haystack, x1/rsi = needle
# Returns: pointer to {tag=0, position} if found, or 1 (None tag) if not found.
def codegen_str_find(ctx: &mut CodegenCtx) -> Unit
  let lbl_outer = ".Lsf_outer." + ctx.fn_counter.to_string()
  let lbl_inner = ".Lsf_inner." + ctx.fn_counter.to_string()
  let lbl_found = ".Lsf_found." + ctx.fn_counter.to_string()
  let lbl_next = ".Lsf_next." + ctx.fn_counter.to_string()
  let lbl_none = ".Lsf_none." + ctx.fn_counter.to_string()
  let lbl_done = ".Lsf_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = &self (ptr to string ptr), x1 = needle
    # Dereference x0 to get actual string pointer
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X1),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    # Save callee-saved regs
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = haystack base
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # x20 = needle
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)    # x9 = current scan pos

    def_label(&mut ctx.text, lbl_outer.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_none.clone())

    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)    # haystack scan ptr
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X20)   # needle scan ptr

    def_label(&mut ctx.text, lbl_inner.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X12, 0)
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_found.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X11, 0)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_next.clone())
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_found)
    # Position = x9 - x19 (current pos - haystack base)
    a64_sub_rrr(&mut ctx.text, A64::X19, A64::X9, A64::X19)
    # x19 now holds position (callee-saved, survives call)
    # Allocate 16 bytes for Option struct: {tag: 0, payload: position}
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    # x0 = allocated buffer
    # Store tag = 0 (Some)
    a64_str(&mut ctx.text, A64::XZR, A64::X0, 0)
    # Store payload = position (x19 survived the call)
    a64_str(&mut ctx.text, A64::X19, A64::X0, 8)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_none)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    # rdi = &self (ptr to string ptr), rsi = needle
    # Dereference rdi to get actual string pointer
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RSI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # Save callee-saved
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # r12 = haystack base
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RSI)  # r13 = needle
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # rcx = scan pos

    def_label(&mut ctx.text, lbl_outer.clone())
    # movzx eax, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_none.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)  # haystack scan
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)   # needle scan

    def_label(&mut ctx.text, lbl_inner.clone())
    # movzx eax, byte [rdx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_found.clone())
    # movzx esi, byte [rdi] — careful, need manual encoding
    emit8(&mut ctx.text, 0x40)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x37)
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_next.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_found)
    # Position = rcx - r12 (scan pos - haystack base)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_sub_rr(&mut ctx.text, X64::RSI, X64::R12)
    # Save position in r12 (overwrite base, no longer needed; callee-saved survives call)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)
    # Allocate 16 bytes
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    # rax = buffer. Store tag=0 at [rax], payload at [rax+8]
    # mov qword [rax], 0
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0xC7)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    # mov [rax+8], r12
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x60)
    emit8(&mut ctx.text, 0x08)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_none)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)

    def_label(&mut ctx.text, lbl_done)
  end
end

# string_contains: Check if null-terminated string contains a substring.
# Args: x0/rdi = haystack, x1/rsi = needle
# Returns: 1 if found, 0 otherwise
def codegen_string_contains(ctx: &mut CodegenCtx) -> Unit
  let lbl_outer = ".Lsc_outer." + ctx.fn_counter.to_string()
  let lbl_inner = ".Lsc_inner." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lsc_yes." + ctx.fn_counter.to_string()
  let lbl_next = ".Lsc_next." + ctx.fn_counter.to_string()
  let lbl_no = ".Lsc_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lsc_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X1),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    # x0 = haystack, x1 = needle
    # x9 = haystack position pointer
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)

    def_label(&mut ctx.text, lbl_outer.clone())
    # Check if we've reached end of haystack
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_no.clone())

    # Try to match needle starting at x9
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)   # haystack scan ptr
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X1)   # needle scan ptr

    def_label(&mut ctx.text, lbl_inner.clone())
    # Load needle byte
    a64_ldrb(&mut ctx.text, A64::X13, A64::X12, 0)
    # If needle byte is 0, full match!
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    # Load haystack byte
    a64_ldrb(&mut ctx.text, A64::X10, A64::X11, 0)
    # Compare
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_next.clone())
    # Match, advance both
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    # No match at this position, advance haystack
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RSI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # rdi = haystack, rsi = needle
    # Use rcx as haystack position
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)

    def_label(&mut ctx.text, lbl_outer.clone())
    # movzx eax, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_no.clone())

    # Try match at rcx
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)   # haystack scan
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)   # needle scan

    def_label(&mut ctx.text, lbl_inner.clone())
    # movzx eax, byte [rdx]  (needle)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    # movzx r8d, byte [rdi]  (haystack)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    # cmp r8, rax
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x39)
    emit8(&mut ctx.text, 0xC0)
    x64_jcc(&mut ctx.text, CC::NE, lbl_next.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# str_copy: Copy string from src to dst. Args: dst=x0/rdi, src=x1/rsi
def codegen_str_copy(ctx: &mut CodegenCtx) -> Unit
  let lbl_loop = ".Lstrcpy_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrcpy_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = dst (save in x9), x1 = src
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_strb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    # rdi = dst (save in rcx), rsi = src
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx eax, byte [rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)
    # mov [rcx], al
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
  end
end

# str_slice: Extract substring from start to end indices.
# Args: x0/rdi = &self (ptr to string ptr), x1/rsi = start, x2/rdx = end
# Returns: pointer to newly allocated null-terminated substring
def codegen_str_slice(ctx: &mut CodegenCtx) -> Unit
  let lbl_loop = ".Lstr_slice_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstr_slice_done." + ctx.fn_counter.to_string()
  let lbl_safe = ".Lstr_slice_safe." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = &self (ptr to string ptr), x1 = start, x2 = end
    # Save callee-saved regs we use
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    # Load actual string pointer: x0 = [x0]
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    # x3 = len = end - start, with bounds check
    a64_sub_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X1)
    # If start > end, the subtraction wraps negative (bit 63 set). Clamp to 0.
    a64_cmp_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_safe.clone())
    a64_mov_ri(&mut ctx.text, A64::X3, 0)
    def_label(&mut ctx.text, lbl_safe)
    # x4 = src = string_ptr + start
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X0, A64::X1)
    # Save src and len across alloc call
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X4)
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X3)
    # Allocate len+1 bytes: x0 = len + 1
    a64_add_rri(&mut ctx.text, A64::X0, A64::X3, 1)
    emit_call_label(ctx, "_tg_bump_alloc")
    # x0 = allocated buffer, x19 = src, x20 = len
    # Copy loop
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_ldrb(&mut ctx.text, A64::X11, A64::X19, 0)
    a64_strb(&mut ctx.text, A64::X11, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    # Null-terminate
    a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)
    # Restore callee-saved regs
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    # x0 already has the buffer pointer (return value)

  when Arch::X86_64 then
    # rdi = &self, rsi = start, rdx = end
    # Load actual string pointer: rdi = [rdi]
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # rcx = len = end - start, with bounds check
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_jcc(&mut ctx.text, CC::GE, lbl_safe.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_jmp(&mut ctx.text, ".Lstr_slice_clamp_done." + (ctx.fn_counter - 1).to_string())
    def_label(&mut ctx.text, lbl_safe)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_sub_rr(&mut ctx.text, X64::RCX, X64::RSI)
    def_label(&mut ctx.text, ".Lstr_slice_clamp_done." + (ctx.fn_counter - 1).to_string())
    # r12 = src = string_ptr + start
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)
    x64_add_rr(&mut ctx.text, X64::R12, X64::RSI)
    # r13 = len
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RCX)
    # Allocate len+1 bytes: rdi = len + 1
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    emit_call_label(ctx, "_tg_bump_alloc")
    # rax = allocated buffer, r12 = src, r13 = len
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
    def_label(&mut ctx.text, lbl_loop.clone())
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    # movzx eax, byte [r12]
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0x24)
    # mov [rcx], al
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x01)
    x64_add_ri(&mut ctx.text, X64::R12, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_sub_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    # Null-terminate: mov byte [rcx], 0
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x01)
    emit8(&mut ctx.text, 0x00)
    # rax already has the buffer pointer (return value)
  end
end

# int_to_str: Convert integer to string. Arg in x0/rdi, returns ptr to string
def codegen_int_to_str(ctx: &mut CodegenCtx) -> Unit
  # Call runtime function _tg_int_to_str
  emit_call_label(ctx, "_tg_int_to_str")
end

def codegen_bool_to_str(ctx: &mut CodegenCtx) -> Unit
  let rr = ret_reg(ctx.target.arch)
  let lbl_true = next_codegen_label(ctx, ".Lbool_to_str_true.")
  let lbl_done = next_codegen_label(ctx, ".Lbool_to_str_done.")
  let true_label = intern_string(ctx, &"true")
  let false_label = intern_string(ctx, &"false")

  emit_test_rr(ctx, rr, rr)
  emit_jcc(ctx, CondKind::Ne, lbl_true.clone())
  emit_lea_label(ctx, rr, false_label)
  emit_jmp(ctx, lbl_done.clone())
  def_label(&mut ctx.text, lbl_true)
  emit_lea_label(ctx, rr, true_label)
  def_label(&mut ctx.text, lbl_done)
end
def codegen_char_to_str(ctx: &mut CodegenCtx) -> Unit
  let lbl_ascii = next_codegen_label(ctx, ".Lchar_to_str_ascii.")
  let lbl_two = next_codegen_label(ctx, ".Lchar_to_str_two.")
  let lbl_three = next_codegen_label(ctx, ".Lchar_to_str_three.")
  let lbl_packed = next_codegen_label(ctx, ".Lchar_to_str_packed.")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = Unicode code point. Pack its UTF-8 bytes into x1 so a single
    # 64-bit store yields a null-terminated string in little-endian memory.
    a64_cmp_ri(&mut ctx.text, A64::X0, 0x7F)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_ascii.clone())
    a64_cmp_ri(&mut ctx.text, A64::X0, 0x7FF)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_two.clone())
    a64_mov_ri(&mut ctx.text, A64::X15, 0xFFFF)
    a64_cmp_rr(&mut ctx.text, A64::X0, A64::X15)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_three.clone())

    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 18)
    a64_and_ri(&mut ctx.text, A64::X1, 0x07)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xF0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 12)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 24)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 12)
    a64_and_ri(&mut ctx.text, A64::X1, 0x0F)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xE0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 6)
    a64_and_ri(&mut ctx.text, A64::X1, 0x1F)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xC0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)

    # All branches packed UTF-8 bytes into X1. Allocate 8-byte buffer, store, return ptr.
    def_label(&mut ctx.text, lbl_packed)
    a64_stp_pre(&mut ctx.text, A64::X1, A64::XZR, A64::SP, -16)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    emit_call_label(ctx, "_tg_bump_alloc")
    a64_ldp_post(&mut ctx.text, A64::X1, A64::XZR, A64::SP, 16)
    a64_stur(&mut ctx.text, A64::X1, A64::X0, 0)

  when Arch::X86_64 then
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x7F)
    x64_jcc(&mut ctx.text, CC::LE, lbl_ascii.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x7FF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_two.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0xFFFF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_three.clone())

    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 18)
    x64_and_ri(&mut ctx.text, X64::R11, 0x07)
    x64_add_ri(&mut ctx.text, X64::R11, 0xF0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 24)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 12)
    x64_and_ri(&mut ctx.text, X64::R11, 0x0F)
    x64_add_ri(&mut ctx.text, X64::R11, 0xE0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 6)
    x64_and_ri(&mut ctx.text, X64::R11, 0x1F)
    x64_add_ri(&mut ctx.text, X64::R11, 0xC0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)

    def_label(&mut ctx.text, lbl_packed)
    x64_xor_rr(&mut ctx.text, X64::R10, X64::R10)
    emit_push(ctx, PhysReg::X64Reg(X64::R10))
    emit_push(ctx, PhysReg::X64Reg(X64::R11))
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    emit_call_label(ctx, "_tg_bump_alloc")
    emit_pop(ctx, PhysReg::X64Reg(X64::R11))
    emit_pop(ctx, PhysReg::X64Reg(X64::R10))
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::R11)
  end
end


# float_to_str: Convert float to string. Arg in x0/rdi (float bits), returns ptr to string
def codegen_float_to_str(ctx: &mut CodegenCtx) -> Unit
  # Call runtime function _tg_float_to_str
  emit_call_label(ctx, "_tg_float_to_str")
end

# str_to_int: Parse string to integer. Arg in x0/rdi.
# Returns a heap-allocated Option[Int]::Some(value) pointer in x0/rax,
# matching the `parse_int(...) -> Option[Int]` source-level contract.
# Layout of the Option heap cell: { disc: Int (0=Some), payload: Int } (16 bytes).
def codegen_str_to_int(ctx: &mut CodegenCtx) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let scratch = scratch_reg(arch)
  # Call runtime function _tg_str_to_int → raw int in rr.
  emit_call_label(ctx, "_tg_str_to_int")
  # Save parsed value across the bump_alloc call.
  emit_push(ctx, rr)
  # arg0 = 16 bytes
  match arg_reg(arch, 0)
  when Option::Some(a0) then emit_mov_ri(ctx, a0, 16)
  when Option::None then ()
  end
  emit_call_label(ctx, "_tg_bump_alloc")  # rr = heap pointer
  # Restore parsed value into scratch.
  emit_pop(ctx, scratch)
  # Zero the discriminant slot (Some = 0). Use a separate temporary register
  # so we don't clobber scratch before storing the payload.
  let zero_r = match arg_reg(arch, 1)
    when Option::Some(r) then r
    when Option::None then scratch
    end
  emit_mov_ri(ctx, zero_r, 0)
  emit_store_mem(ctx, rr, 0, zero_r)      # disc = 0 (Some)
  emit_store_mem(ctx, rr, 8, scratch)     # payload = parsed value
end

# str_to_float: Parse string to float. Arg in x0/rdi, returns float bits in x0/rax
def codegen_str_to_float(ctx: &mut CodegenCtx) -> Unit
  # Call runtime function _tg_str_to_float
  emit_call_label(ctx, "_tg_str_to_float")
end

# ———————————————————————————————————————————————————————————————
# Runtime String chars()
# ———————————————————————————————————————————————————————————————
#
# _tg_str_chars: Convert null-terminated string to Vec-like buffer of 8-byte chars
# ABI: x0/rdi = &self (pointer to string pointer)
# Returns: pointer to {data_ptr, len, cap, char0, char1, ...}
#
# With ProjDeref+ProjIndex iteration:
#   MirLen reads [ptr+8] = len
#   ProjDeref reads [ptr+0] = data_ptr
#   ProjIndex reads *(data_ptr + idx*8)

def emit_runtime_str_chars(ctx: &mut CodegenCtx) -> Unit
  def_label(&mut ctx.text, "_tg_str_chars")
  match ctx.target.arch
  when Arch::AArch64 then emit_str_chars_aarch64(ctx)
  when Arch::X86_64  then emit_str_chars_x86_64(ctx)
  end
end

def emit_str_chars_aarch64(ctx: &mut CodegenCtx) -> Unit
  let lbl_strlen   = ".Lchars_strlen." + ctx.fn_counter.to_string()
  let lbl_done_len = ".Lchars_done_len." + ctx.fn_counter.to_string()
  let lbl_copy     = ".Lchars_copy." + ctx.fn_counter.to_string()
  let lbl_copy_end = ".Lchars_copy_end." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  let os = ctx.target.os

  # Prologue
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

  # Dereference &self to get string data pointer
  a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)

  # strlen(x19) → x20
  a64_mov_ri(&mut ctx.text, A64::X20, 0)
   def_label(&mut ctx.text, lbl_strlen.clone())
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X20)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done_len.clone())
  a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
  a64_b(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())

  # Allocate via inline mmap: 24 (header) + len * 8 (data)
  a64_lsl(&mut ctx.text, A64::X1, A64::X20, 3)
  a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 24)
  a64_mov_ri(&mut ctx.text, A64::X0, 0)
  a64_mov_ri(&mut ctx.text, A64::X2, 3)    # PROT_READ|PROT_WRITE
  match os
  when OsAbi::MacOS then
    a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X16, 197)
    a64_svc(&mut ctx.text, 0x80)
  when OsAbi::Linux then
    a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X8, 222)
    a64_svc(&mut ctx.text, 0)
  when _ then
    a64_brk(&mut ctx.text, 1)
  end
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

  # Header: data_ptr = buf + 24, len, cap
  a64_add_rri(&mut ctx.text, A64::X9, A64::X21, 24)
  a64_str(&mut ctx.text, A64::X9, A64::X21, 0)
  a64_str(&mut ctx.text, A64::X20, A64::X21, 8)
  a64_str(&mut ctx.text, A64::X20, A64::X21, 16)

  # Copy: for i in 0..len → data[i*8] = string[i]
  a64_mov_ri(&mut ctx.text, A64::X22, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copy_end.clone())
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_lsl(&mut ctx.text, A64::X11, A64::X22, 3)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X11)
   a64_str(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
  a64_b(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return buffer
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

  # Epilogue
  a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
  a64_ret(&mut ctx.text)
end

def emit_str_chars_x86_64(ctx: &mut CodegenCtx) -> Unit
  let lbl_strlen   = ".Lchars_strlen." + ctx.fn_counter.to_string()
  let lbl_done_len = ".Lchars_done_len." + ctx.fn_counter.to_string()
  let lbl_copy     = ".Lchars_copy." + ctx.fn_counter.to_string()
  let lbl_copy_end = ".Lchars_copy_end." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  let os = ctx.target.os

  # Prologue
  x64_push(&mut ctx.text, X64::RBP)
  x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)

  # Deref &self
  x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)

  # strlen
  x64_mov_ri(&mut ctx.text, X64::R12, 0)
  def_label(&mut ctx.text, lbl_strlen.clone())
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x23)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, lbl_done_len.clone())
  x64_add_ri(&mut ctx.text, X64::R12, 1)
  x64_jmp(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())

  # Allocate via inline mmap: 24 + r12*8
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
  x64_shl_ri(&mut ctx.text, X64::RSI, 3)
  x64_add_ri(&mut ctx.text, X64::RSI, 24)
  x64_mov_ri(&mut ctx.text, X64::RDI, 0)    # addr = 0
  x64_mov_ri(&mut ctx.text, X64::RDX, 3)    # PROT_RW
  match os
  when OsAbi::Linux then
    x64_mov_ri(&mut ctx.text, X64::R10, 0x22) # MAP_PRIVATE|MAP_ANON
    x64_mov_ri(&mut ctx.text, X64::R8, -1)
    x64_mov_ri(&mut ctx.text, X64::R9, 0)
    x64_mov_ri(&mut ctx.text, X64::RAX, 9)    # __NR_mmap
    x64_syscall(&mut ctx.text)
  when _ then
    x64_ud2(&mut ctx.text)
  end
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

  # Header
  x64_lea_mem(&mut ctx.text, X64::RCX, X64::R13, 24)
  x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RCX)
  x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)
  x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)

  # Copy
  x64_mov_ri(&mut ctx.text, X64::R14, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
  x64_jcc(&mut ctx.text, CC::GE, lbl_copy_end.clone())
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x33)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  x64_shl_ri(&mut ctx.text, X64::RCX, 3)
  x64_add_rr(&mut ctx.text, X64::RCX, X64::R13)
  x64_mov_mr(&mut ctx.text, X64::RCX, 24, X64::RAX)
  x64_add_ri(&mut ctx.text, X64::R14, 1)
  x64_jmp(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_pop(&mut ctx.text, X64::RBP)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# Array/Vec Intrinsic Implementations
# ———————————————————————————————————————————————————————————————
#
# Vec[T] memory layout (24 bytes):
#   offset 0: ptr    - pointer to data buffer
#   offset 8: len    - current length (number of elements)
#   offset 16: cap   - capacity (allocated elements)
#
# The vec pointer itself is passed in arg0 (x0/rdi)

# array_new: Create empty Vec with capacity 0. Returns ptr to vec struct.
def codegen_array_new(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_new")
end

# array_push: Append element to vec. Args: vec_ptr, element_ptr
def codegen_array_push(ctx: &mut CodegenCtx) -> Unit
  # Call runtime _tg_array_push(vec, elem)
  emit_call_label(ctx, "_tg_array_push")
end

# array_pop: Remove and return last element. Args: vec_ptr. Returns element or null.
def codegen_array_pop(ctx: &mut CodegenCtx) -> Unit
  # Call runtime _tg_array_pop(vec)
  emit_call_label(ctx, "_tg_array_pop")
end

# array_get: Get element at index. Args: vec_ptr, index. Returns element ptr.
def codegen_array_get(ctx: &mut CodegenCtx) -> Unit
  # Call runtime _tg_array_get(vec, idx)
  emit_call_label(ctx, "_tg_array_get")
end

# array_set: Set element at index. Args: vec_ptr, index, element_ptr.
def codegen_array_set(ctx: &mut CodegenCtx) -> Unit
  # Call runtime _tg_array_set(vec, idx, elem)
  emit_call_label(ctx, "_tg_array_set")
end

# array_len: Get length of vec. Args: vec_ptr. Returns length.
def codegen_array_len(ctx: &mut CodegenCtx) -> Unit
  # Load len from offset 8. Null collection pointers represent empty values.
  match ctx.target.arch
  when Arch::AArch64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_len_done.")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 8)
    def_label(&mut ctx.text, lbl_done)
  when Arch::X86_64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_len_done.")
    x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
    def_label(&mut ctx.text, lbl_done)
  end
end

# array_cap: Get capacity of vec. Args: vec_ptr. Returns capacity.
def codegen_array_cap(ctx: &mut CodegenCtx) -> Unit
  # Load cap from offset 16. Null collection pointers represent empty values.
  match ctx.target.arch
  when Arch::AArch64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_cap_done.")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 16)
    def_label(&mut ctx.text, lbl_done)
  when Arch::X86_64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_cap_done.")
    x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 16)
    def_label(&mut ctx.text, lbl_done)
  end
end

# array_remove: Remove element at index. Args: vec_ptr, index. Returns removed element.
def codegen_array_remove(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_remove")
end

# array_insert: Insert element at index. Args: vec_ptr, index, element_ptr.
def codegen_array_insert(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_insert")
end

# array_clear: Clear vec (set len to 0). Args: vec_ptr.
def codegen_array_clear(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Store 0 at [x0 + 8] (len)
    a64_stur(&mut ctx.text, A64::XZR, A64::X0, 8)
  when Arch::X86_64 then
    # Store 0 at [rdi + 8] (len)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, 8, X64::RAX)
  end
end

# array_contains: Check if element exists. Args: vec_ptr, element_ptr. Returns bool.
def codegen_array_contains(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_contains")
end

# array_last: Returns last element (or 0 if empty). Args: vec_ptr.
def codegen_array_last(ctx: &mut CodegenCtx) -> Unit
  let lbl_empty = ".Larr_last_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, 8)   # len
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X2, A64::X0, 0)   # data ptr
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X2, A64::X1, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)  # len
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 0)  # data
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    # mov rax, [rcx + rax*8]
    emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x04); emit8(&mut ctx.text, 0xC1)
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# array_first: Returns first element (or 0 if empty). Args: vec_ptr.
def codegen_array_first(ctx: &mut CodegenCtx) -> Unit
  let lbl_empty = ".Larr_first_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, 8)   # len
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)   # data ptr
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)    # data[0]
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)  # data[0]
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# array_is_empty: Returns 1 if len == 0, else 0. Args: vec_ptr.
def codegen_array_is_empty(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 8)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    emit_setcc(ctx, CondKind::Eq, PhysReg::A64Reg(A64::X0))
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    emit_setcc(ctx, CondKind::Eq, PhysReg::X64Reg(X64::RAX))
  end
end

# Stub intrinsics — emit no-op for non-critical array operations that may
# be needed for compilation to succeed. Full implementations can be added
# when the bootstrap needs them.
def codegen_array_reverse(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_reverse")
end
def codegen_array_sort(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_sort")
end
def codegen_array_extend(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_extend")
end
def codegen_array_truncate(ctx: &mut CodegenCtx) -> Unit
  # Truncate to given length — just update len if new len < current len
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stur(&mut ctx.text, A64::X1, A64::X0, 8)
  when Arch::X86_64 then
    x64_mov_mr(&mut ctx.text, X64::RDI, 8, X64::RSI)
  end
end
def codegen_array_resize(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_resize")
end

# ———————————————————————————————————————————————————————————————
# Map Intrinsic Implementations (Hash Table)
# ———————————————————————————————————————————————————————————————
#
# Map[K, V] memory layout:
#   offset 0: buckets  - ptr to bucket array
#   offset 8: size     - number of entries
#   offset 16: cap     - bucket count (power of 2)
#   offset 24: hash_fn - ptr to hash function
#   offset 32: eq_fn   - ptr to equality function
#
# Each bucket entry:
#   offset 0: hash  - cached hash value
#   offset 8: key   - key pointer
#   offset 16: val  - value pointer
#   offset 24: next - next entry in chain (for collisions)

# map_new: Create empty map. Returns map ptr.
def codegen_map_new(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_new")
end

# map_insert: Insert key-value pair. Args: map_ptr, key_ptr, val_ptr. Returns old value or null.
def codegen_map_insert(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_insert")
end

# map_get: Get value for key. Args: map_ptr, key_ptr.
# Returns Option value: 0 from runtime means None (return inline disc 1),
# non-zero means found (wrap in Option::Some heap {disc=0, payload=value}).
def codegen_map_get(ctx: &mut CodegenCtx) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let lbl_none = next_codegen_label(ctx, ".Lmap_get_none.")
  let lbl_done = next_codegen_label(ctx, ".Lmap_get_done.")

  emit_call_label(ctx, "_tg_map_get")

  # Check if raw result is 0 (not found)
  emit_cmp_ri(ctx, rr, 0)
  emit_jcc(ctx, CondKind::Eq, lbl_none.clone())

  match arch
  when Arch::AArch64 then
    # Found: save raw value, alloc Option::Some struct
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    a64_stur(&mut ctx.text, A64::XZR, A64::X0, 0)    # disc = 0 (Some)
    a64_stur(&mut ctx.text, A64::X19, A64::X0, 8)     # payload = value
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_b(&mut ctx.text, lbl_done.clone())
  when Arch::X86_64 then
    # Found: save raw value, alloc Option::Some struct
    x64_push(&mut ctx.text, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)  # disc = 0 (Some)
    x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RBX)  # payload = value
    x64_pop(&mut ctx.text, X64::RBX)
    x64_jmp(&mut ctx.text, lbl_done.clone())
  end

  def_label(&mut ctx.text, lbl_none)
  emit_mov_ri(ctx, rr, 1)              # None = disc 1
  def_label(&mut ctx.text, lbl_done)
end

# map_remove: Remove entry for key. Args: map_ptr, key_ptr. Returns removed value or null.
def codegen_map_remove(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_remove")
end

# map_contains: Check if key exists. Args: map_ptr, key_ptr. Returns bool.
def codegen_map_contains(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_contains")
end

# map_len: Get number of entries. Args: map_ptr. Returns size.
def codegen_map_len(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 8)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
  end
end

# map_clone: Clone map entries into a new map. Args: map_ptr. Returns new map ptr.
def codegen_map_clone(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_clone")
end

# map_clear: Clear all entries. Args: map_ptr.
def codegen_map_clear(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_clear")
end

# map_keys/values/entries: Iterate map and extract keys, values, or entries.
# These forward to runtime helpers.
def codegen_map_keys(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_keys")
end
def codegen_map_values(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_values")
end
def codegen_map_entries(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_entries")
end

# ———————————————————————————————————————————————————————————————
# Set Intrinsic Implementations
# ———————————————————————————————————————————————————————————————
#
# Set[T] is implemented as Map[T, Unit] internally

# set_new: Create empty set. Returns set ptr.
def codegen_set_new(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_set_new")
end

# set_insert: Add element to set. Args: set_ptr, elem_ptr. Returns bool (was new).
def codegen_set_insert(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_set_insert")
end

# set_contains: Check if element exists. Args: set_ptr, elem_ptr. Returns bool.
def codegen_set_contains(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_set_contains")
end

# set_remove: Remove element. Args: set_ptr, elem_ptr. Returns bool (was present).
def codegen_set_remove(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_set_remove")
end

# set_len: Get number of elements. Args: set_ptr. Returns size.
def codegen_set_len(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 8)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
  end
end

# set_clone: Clone set entries into a new set. Args: set_ptr. Returns new set ptr.
def codegen_set_clone(ctx: &mut CodegenCtx) -> Unit
