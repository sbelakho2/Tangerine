      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_place(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(r) then
      if place.projections.is_empty() then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      else
        emit_mov_rr(ctx, dst, r)
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Stack(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Spilled(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    end
  when Option::None then
    println("[codegen] load_place unknown local=" + place.local.id.to_string() + " func=" + fctx.func.name + " projections=" + place.projections.len().to_string())
    panic("load_place: unknown local " + place.local.id.to_string())
  end
end

# Get the TypeId from a local's type, returns -1 if not a Named type.
# Extract the TypeId from a type, unwrapping through Ref/RefMut
def extract_named_type_id(ctx: CodegenCtx, ty: Type) -> Int
  match ty
  when Type::Adt(tid, args) then
 # Adt form of Box/Rc mirrors the canonical unwrap arms
    # (recurse through the Adt args); other Adt types return their id.
    let ent_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if (ent_named == "Box" || ent_named == "Rc") && !args.is_empty() then
      extract_named_type_id(ctx, &args[0])
    else
      tid.id
    end
  when Type::RefInternal(inner, _) then extract_named_type_id(ctx, &inner)
  when Type::Ptr(inner) then extract_named_type_id(ctx, &inner)
  when Type::PtrMut(inner) then extract_named_type_id(ctx, &inner)
  when _ then -1
  end  end
end

def type_name_by_id(ctx: CodegenCtx, type_id: Int) -> String
  if type_id < 0 then return "" end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end
end

def project_deref_type(ctx: CodegenCtx, ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner.clone()
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when Type::Adt(tid, args) then
 # Adt form of Box/Rc mirrors the canonical unwrap arms
    # (pointee via the Adt args); anything else passes through unchanged.
    let pdt_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if (pdt_named == "Box" || pdt_named == "Rc") && !args.is_empty() then
      args[0].clone()
    else
      ty.clone()
    end
  when other then other.clone()
  end  end
end

def type_is_unit(ty: Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end  end
end

def emit_len_ref_derefs(inout ctx: CodegenCtx, reg: PhysReg, ty: Type) -> Unit
  var current_ty = ty.clone()
  while is_ref_like_type(&current_ty) do
    let inner_ty = project_deref_type(ctx, &current_ty)
    let value_ty = strip_receiver_ptr_like_type(&inner_ty)
    if is_heap_collection_type(ctx, &value_ty) || type_is_unit(&inner_ty) || type_is_unit(&value_ty) then
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = inner_ty
    else
      return
    end
  end
end

def project_index_type(ctx: CodegenCtx, ty: Type) -> Type
  match ty
  when Type::String then Type::Char
  when Type::FixedArray(elem, _) then elem.clone()
  when Type::Adt(tid, args) then
 # Adt form of Slice/Box/Rc mirrors the canonical arms
    # (element via the Adt args / unwrap recurse); the pre-existing name
    # chain keeps covering Vec/Array/Map/Set in their Adt storage forms.
    let qualified = type_name_by_id(ctx, tid.id)
    let type_name = bare_name_from_qualified(qualified)
    if (type_name == "UnsafeSlice") && !args.is_empty() then
      args[0].clone()
    else if (type_name == "Slice") && !args.is_empty() then
      # The SAFE source-spelled Slice (the std-declared shared struct):
      # the element is its type argument (the index reads through the Arc
      # deref — see the ProjIndex arm).
      args[0].clone()
    else if (type_name == "Box" || type_name == "Rc") && !args.is_empty() then
      project_index_type(ctx, &args[0])
    else if (type_name == "Vec" || type_name == "Array") && !args.is_empty() then
      args[0].clone()
    else if (type_name == "Map" || type_name == "HashMap") && args.len() >= 2 then
      args[1].clone()
    else if (type_name == "Set" || type_name == "HashSet") && !args.is_empty() then
      args[0].clone()
    else
      Type::Unit
    end
  when Type::RefInternal(inner, _) then project_index_type(ctx, inner)
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when _ then Type::Unit
  end  end
end

# the type of a Field(FieldId) projection, resolved from the
# FieldId's OWNER type def — a struct field (owner struct TypeId) or a
# variant-payload field (owner enum TypeId, reached through the ACTIVE
# Variant(VariantId) downcast; the index is the payload field index).
# `ty` is the CONCRETE type being projected (the place's current
# type — Type::Adt(tid, args)); the def-level field type is SUBSTITUTED
# under its args (substitute_in_concrete_adt), so a generic def's field
# yields the concrete field type — never a Param and never a placeholder.
def projected_field_type(ctx: CodegenCtx, fid: FieldId, downcast_variant: Option[VariantId], ty: Type) -> Type
  # Defensive: the projected type may arrive ref-wrapped — substitution keys
  # on the VALUE type's concrete Adt.
  let value_ty = strip_ref_like_type(ty)
  match lookup_type_def(ctx, fid.owner.id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      if fid.index < fields.len() then
        substitute_in_concrete_adt(&ctx.layout_engine, &value_ty, &fields[fid.index].ty)
      else
        Type::Unit
      end
    when MirTypeDefKind::Enum(variants) then
      match downcast_variant
      when Option::Some(vid) then
        if vid.owner.id == fid.owner.id && vid.index < variants.len() then
          let pv = variants[vid.index]
          if fid.index < pv.fields.len() then
            substitute_in_concrete_adt(&ctx.layout_engine, &value_ty, &pv.fields[fid.index])
          else
            Type::Unit
          end
        else
          Type::Unit
        end
      when Option::None then Type::Unit
      end
    end
  when Option::None then Type::Unit
  end
end

# the type of a TupleIndex(Int) projection — the positional tuple
# element type (tuples carry no FieldId).
def projected_tuple_type(ctx: CodegenCtx, ty: Type, idx: Int) -> Type
  match strip_ref_like_type(ty)
  when Type::Tuple(elems) then
    if idx >= 0 && idx < elems.len() then elems[idx].clone() else Type::Unit end
  when _ then Type::Unit
  end  end
end

# the byte offset of a Field(FieldId) projection — ALWAYS from the
# layout engine, resolved through the CONCRETE projected type (the field's
# layout under the place's concrete Adt args). With an ACTIVE
# Variant(VariantId) downcast the projected type is the enum: the index is
# the variant-PAYLOAD field index (declaration order — the flat layout list
# is [tag, v0.fields.., v1.fields..,...]), and the offset is the
# payload-relative position added to the enum's payload base.
def projected_field_offset(inout ctx: CodegenCtx, fid: FieldId, downcast_variant: Option[VariantId], ty: Type) -> Int
  # Defensive: the projected type may arrive ref-wrapped (a &Struct place);
  # the layout authority is the VALUE type's concrete key.
  let value_ty = strip_ref_like_type(ty)
  match downcast_variant
  when Option::Some(vid) then
    if vid.owner.id != fid.owner.id then
      panic("ICE: Field(FieldId) owner " + fid.owner.id.to_string() + " does not match the active Variant(VariantId) owner " + vid.owner.id.to_string())
    end
    enum_payload_base(ctx, &value_ty) + enum_field_offset_for_variant_index(ctx, &value_ty, vid.index, fid.index)
  when Option::None then
    field_offset(&mut ctx.layout_engine, &value_ty, fid.index)
  end
end

# the byte offset of a TupleIndex(Int) projection — the positional
# tuple element offset, from the layout engine's tuple layout.
def projected_tuple_offset(inout ctx: CodegenCtx, ty: Type, idx: Int) -> Int
  match strip_ref_like_type(ty)
  when Type::Tuple(elems) then
    if idx >= 0 && idx < elems.len() then
      let tl = tuple_layout(&mut ctx.layout_engine, &elems)
      tl.fields[idx].offset
    else
      panic("projected_tuple_offset: tuple index " + idx.to_string() + " out of range")
    end
  when _ then
    panic("projected_tuple_offset: expected a tuple type")
  end  end
end

def local_type_id(ctx: CodegenCtx, fctx: FnCodegenCtx, local_id: Int) -> Int
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return extract_named_type_id(ctx, &local.ty)
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return extract_named_type_id(ctx, &param.ty)
    end
  end
  -1
end

def local_type(fctx: FnCodegenCtx, local_id: Int) -> Type
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return local.ty.clone()
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return param.ty.clone()
    end
  end
  Type::Unit
end

def place_type(ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place) -> Type
  var current_ty = local_type(fctx, place.local.id)
  var downcast_variant: Option[VariantId] = Option::None
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then
      current_ty = project_deref_type(ctx, &current_ty)
    when Projection::Variant(vid) then
      downcast_variant = Option::Some(vid)
    when Projection::Field(fid) then
      current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
    when Projection::TupleIndex(idx) then
      current_ty = projected_tuple_type(ctx, &current_ty, idx)
    when Projection::ProjIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    when Projection::ProjConstantIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    end
  end
  current_ty
end

def operand_type_id(ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand) -> Int
  match op.kind
  when MirOperandKind::MirCopy(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirMovePlace(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirRead(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirConsume(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirConstant(cst) then extract_named_type_id(ctx, &cst.ty)
  end  end
end

def operand_type(ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand) -> Type
  match op.kind
  when MirOperandKind::MirCopy(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirMovePlace(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirRead(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirConsume(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirConstant(cst) then cst.ty.clone()
  end  end
end

def is_ref_like_type(ty: Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end  end
end

def is_receiver_ptr_like_type(ty: Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end  end
end

def strip_ref_like_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then strip_ref_like_type(&inner)
  when other then other.clone()
  end  end
end

def strip_receiver_ptr_like_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then strip_receiver_ptr_like_type(&inner)
  when Type::Ptr(inner) then strip_receiver_ptr_like_type(&inner)
  when Type::PtrMut(inner) then strip_receiver_ptr_like_type(&inner)
  when other then other.clone()
  end  end
end

def is_string_like_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::String then
    true
 # (the typed literal/view split): the MIR-internal static
  # StaticStrPtr of a string literal IS a string (the raw view of the interned
  # bytes) — string binops/concats and the intrinsic classification treat
  # it as string-typed.
  when Type::StaticStrPtr then
    true
  when Type::Adt(tid, args) then
 # Adt form of Slice mirrors the canonical Slice arm
    # (char/i8/u8 element via the Adt args).
    let slt_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if slt_named == "UnsafeSlice" && !args.is_empty() then
      match strip_ref_like_type(&args[0])
      when Type::Char then true
      when Type::I8 then true
      when Type::U8 then true
      else false
      end
    else
      false
    end
  when _ then
    false
  end  end
end

# ———————————————————————————————————————————————————————————————
# consumption — the single representation accessor
# ———————————————————————————————————————————————————————————————
# The layout engine's Repr decision table (type_repr / repr_header_size /
# container_field_offset) is the ONE authority on how a runtime value is
# stored. Codegen NEVER re-decides a storage shape: every representation
# question routes through codegen_type_repr, and heap-header knowledge comes
# from repr_header_size / container_field_offset. The engine is a dependency
# exactly like layout_of_strict: the calls below follow the same import
# pattern (tg_compiler::layout_engine::{... }).
def codegen_type_repr(inout ctx: CodegenCtx, ty: Type) -> Repr
  let r = type_repr(&ctx.layout_engine, ty)
  match r
  when Repr::Invalid then
    # FAIL-CLOSED: an unresolved type (Var/Param/Error/unknown) reaching a
    # codegen representation query is an internal compiler error — never a
    # silent pointer-word guess. The strict path (layout_of_concrete /
    # --strict-resolution) must reject these before codegen.
    panic("ICE: unresolved type reached a codegen representation query (type_repr = Repr::Invalid) — layout queries fail closed")
  when _ then r
  end
end

# Heap-header sizes and field offsets, from the engine's F2 FROZEN table
# (repr_header_size / container_field_offset). Only Vec/Map/Set headers are
# ever touched here (StringPtr is a raw pointer with NO inline header — its
# {data,len,cap,stride} shape is only the internal char-Vec buffer of
# str.chars()).
#
# The table matches the runtime exactly: Vec {data:0,len:8,cap:16,stride:24}
# (32); Map and Set (map-backed) share the runtime's actual 96-byte layout
# header — the canonical MAP_HEADER_FIELDS table in layout_engine.tg
# (map_header_field_offset / map_header_total_size) is the SINGLE
# machine-readable Map/Set layout authority: {buckets:0, size:8, capacity:16,
# key_stride:24, key_align:32, value_stride:40, value_align:48, key_off:56,
# value_off:64, next_off:72, bucket_stride:80, free_list:88} (runtime.tg
# "Map header (96 bytes)"). Every Map/Set header read here routes through
# container_field_offset / heap_header_field_offset to that table.
# Codegen reads the len (and Vec cap) fields at 8/16 and the Vec stride at
# 24, agreeing with both the table and the runtime.
def heap_header_field_offset(repr: Repr, field_name: String) -> Int
  let container_name = match repr
  when Repr::HeapVecHeader then "Vec"
  when Repr::HeapMapHeader then "Map"
  when Repr::HeapSetHeader then "Set"
  when Repr::StringPtr then "String"
  when _ then "Vec"
  end
  container_field_offset(&container_name, field_name)
end

# Fixed arrays (the distinct Type::FixedArray variant) are INLINE storage:
# every other array/vec value is a heap {data,len,cap,stride} handle (the
# stride field is the element-addressing authority). The heap-handle
# semantics (ProjIndex derefs the handle, MirLen reads the header) apply to
# the heap collections; a FixedArray is indexed/measured in place (ProjIndex
# keeps the inline base, MirLen emits the constant count).
# UnsafeSlice is NOT a heap collection: an UnsafeSlice[T] value is the
# 16-byte inline RAW VIEW { ptr: Ptr[T], len: UInt } (Repr::Inline — see
# slice_view_layout). The SAFE source-spelled Slice is the std-declared
# shared struct — its 8-byte Arc-class handle (slice_shared_handle_layout).
# For a view, the projection chain's reg holds the DATA pointer after the
# ProjDeref of the receiver, so ProjIndex must NOT deref again; len comes
# from the view's second word, never from a heap header.
# this is a REPRESENTATION question — the layout engine's type_repr
# (via codegen_type_repr) is the single authority. The former name-list
# special cases (Adt "Array" -> HeapVecHeader, "UnsafeSlice" -> Inline)
# duplicated type_repr's own Adt arms (layout_engine type_repr: named
# Array -> HeapVecHeader, named UnsafeSlice -> Inline, FixedArray ->
# Inline) and are not part of the model: the engine answers the same,
# table-for-table.
def is_heap_collection_type(inout ctx: CodegenCtx, ty: Type) -> Bool
  match codegen_type_repr(ctx, &strip_ref_like_type(ty))
  when Repr::HeapVecHeader then true
  when Repr::HeapMapHeader then true
  when Repr::HeapSetHeader then true
  when _ then false
  end  end
end

# True when the value type is the RAW UnsafeSlice view (after stripping
# references and pointer layers). Mirrors the layout engine's
# is_slice_view_tid. The SAFE source-spelled Slice is the std-declared
# shared struct — its operations compile as its std methods (the Arc
# deref through the backing), never through these raw-view emitters.
def is_slice_view_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::Adt(tid, _) then
    bare_name_from_qualified(type_name_by_id(ctx, tid.id)) == "UnsafeSlice"
  when _ then false
  end  end
end

# True when the value type is the SAFE SOURCE-spelled Slice — the
# std-declared SHARED struct (Slice[T] { inner: ArcStrong[SliceBacking[T]] }).
# Its VALUE is the 8-byte Arc-class handle; its element reads go through
# the Arc deref chain into the 24-byte pinned backing (slice_shared_handle
# _layout / slice_shared_backing_layout): handle word @ 0, ArcInnerWeak
# { refcount @ 0, weak_count @ 8, data @ 16 }, SliceBacking
# { ptr @ 0, len @ 8, offset @ 16 }.
def is_shared_slice_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::Adt(tid, _) then
    bare_name_from_qualified(type_name_by_id(ctx, tid.id)) == "Slice"
  when _ then false
  end  end
end

def deref_all_ref_like_args(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  var arg_ty = operand_type(ctx, fctx, &args[0])
  while is_ref_like_type(&arg_ty) do
    emit_load_mem(ctx, rr, rr, 0)
    arg_ty = project_deref_type(ctx, &arg_ty)
  end
end

def deref_all_receiver_ptr_like_args(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  let arg_ty = operand_type(ctx, fctx, &args[0])
  if is_receiver_ptr_like_type(&arg_ty) then
    emit_load_mem(ctx, rr, rr, 0)
  end
end

def deref_arg_once_if_ref_like(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], idx: Int) -> Unit
  if args.len() <= idx then
    return
  end

  var deref = is_ref_like_type(&operand_type(ctx, fctx, &args[idx]))
  if !deref then
    if call_args.len() > idx then
      match call_args[idx].value
      when MirCallValue::Place(_) then deref = true
      when MirCallValue::Value(_) then ()
      end
    end
  end
  if !deref then
    return
  end

  match arg_reg(ctx.target.arch, idx)
  when Option::Some(reg) then
    emit_load_mem(ctx, reg, reg, 0)
  when Option::None then ()
  end
end

# Detect a packed inline string (≤8 printable ASCII bytes stored little-endian in
# the value word, e.g. "Int__fmt") and, if found, materialize it into a real
# null-terminated heap buffer so downstream byte-loads operate on a valid pointer.
# target holds the value/pointer; work/cnt/byte are scratch for the scan; buf holds
# the allocated pointer. X0/X1 are preserved across the bump-alloc call.
def emit_normalize_inline_string_a64(inout ctx: CodegenCtx, target: A64, work: A64, cnt: A64, byte: A64, buf: A64) -> Unit
  let lbl_scan = next_codegen_label(ctx, ".Lstrnorm_scan.")
  let lbl_maybe = next_codegen_label(ctx, ".Lstrnorm_maybe.")
  let lbl_packed = next_codegen_label(ctx, ".Lstrnorm_packed.")
  let lbl_np = next_codegen_label(ctx, ".Lstrnorm_np.")
  let lbl_done = next_codegen_label(ctx, ".Lstrnorm_done.")

  # Byte-scan: every byte up to a zero terminator must be printable ASCII.
  a64_mov_rr(&mut ctx.text, work, target)
  a64_mov_ri(&mut ctx.text, cnt, 0)
  def_label(&mut ctx.text, lbl_scan.clone())
  a64_mov_rr(&mut ctx.text, byte, work)
  a64_and_ri(&mut ctx.text, byte, 255)
  a64_cmp_ri(&mut ctx.text, byte, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, byte, 32)
  a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_np.clone())
  a64_cmp_ri(&mut ctx.text, byte, 127)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_np.clone())
  a64_add_rri(&mut ctx.text, cnt, cnt, 1)
  a64_cmp_ri(&mut ctx.text, cnt, 8)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_packed.clone())
  a64_lsr(&mut ctx.text, work, work, 8)
  a64_b(&mut ctx.text, lbl_scan.clone())

  def_label(&mut ctx.text, lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, cnt, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_np.clone())

  # Packed: allocate 16 bytes, store the 8 value bytes + null pad, repoint target.
  def_label(&mut ctx.text, lbl_packed)
  a64_stp_pre(&mut ctx.text, A64::X0, A64::X1, A64::SP, -16)
  a64_mov_ri(&mut ctx.text, A64::X0, 16)
  emit_call_label(ctx, "_tg_bump_alloc")
  a64_mov_rr(&mut ctx.text, buf, A64::X0)
  a64_ldp_post(&mut ctx.text, A64::X0, A64::X1, A64::SP, 16)
  a64_stur(&mut ctx.text, target, buf, 0)
  a64_stur(&mut ctx.text, A64::XZR, buf, 8)
  a64_mov_rr(&mut ctx.text, target, buf)
  a64_b(&mut ctx.text, lbl_done.clone())

  def_label(&mut ctx.text, lbl_np)
  def_label(&mut ctx.text, lbl_done)
end

def maybe_load_string_data_ptr(inout ctx: CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
 # the String-ABI receiver unwrap. When the surrounding
  # intrinsic is a string_* op (the router set ctx.string_abi_unwrap), the
  # register holds a String OBJECT header and the byte-op needs the data
  # pointer at [header+0]. str_* ops (flag clear) pass raw through — the
  # value is already the byte pointer (literals, borrowed views).
  if ctx.string_abi_unwrap then
    match ctx.target.arch
    when Arch::AArch64 then
      match reg
      when PhysReg::A64Reg(r) then a64_ldr(&mut ctx.text, r, r, 0)
      when _ then ()
      end
    when Arch::X86_64 then
      match reg
      when PhysReg::X64Reg(r) then x64_mov_rm(&mut ctx.text, r, r, 0)
      when _ then ()
      end
    end
  end
end

def maybe_load_string_data_ptr_disabled(inout ctx: CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match reg
    when PhysReg::A64Reg(target) then
      match data_reg
      when PhysReg::A64Reg(work) then
        match len_reg
        when PhysReg::A64Reg(cnt) then
          match cap_reg
          when PhysReg::A64Reg(byte) then
            match scratch_reg
            when PhysReg::A64Reg(buf) then
              emit_normalize_inline_string_a64(ctx, target, work, cnt, byte, buf)
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  when _ then ()
  end  end
end

def normalize_string_arg0_for_current_arch(inout ctx: CodegenCtx) -> Unit
 # String ABI (— DECIDED): the String VALUE is ONE pointer to the
  # String object header; the runtime helpers unwrap the object
  # themselves (see runtime.tg "String Object Runtime"), so no inline
  # normalization is needed here. The StaticStrPtr static form (interned
  # literal labels) and the borrowed str views pass through unchanged.
  ()
end

def is_enum_type_id(ctx: CodegenCtx, type_id: Int) -> Bool
  if type_id < 0 then return false end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(_) then true
    when _ then false
    end
  when Option::None then false
  end
end

# The concrete enum TYPE of an operand pair (the first operand whose type
# is a registered enum Adt), else Type::Unit. returns the CONCRETE
# type (args included) — the enum-eq helper is keyed by the (TypeId, substs)
# identity, so Option[u8] and Option[Int] compare through distinct helpers.
def enum_type_for_operands(ctx: CodegenCtx, fctx: FnCodegenCtx, left: MirOperand, right: MirOperand) -> Type
  let left_ty = operand_type(ctx, fctx, left)
  match left_ty
  when Type::Adt(tid, _) then
    if is_enum_type_id(ctx, tid.id) then return left_ty end
  when _ then ()
  end
  let right_ty = operand_type(ctx, fctx, right)
  match right_ty
  when Type::Adt(tid2, _) then
    if is_enum_type_id(ctx, tid2.id) then return right_ty end
  when _ then ()
  end
  Type::Unit
end

def next_codegen_label(inout ctx: CodegenCtx, prefix: String) -> String
  let label = prefix + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  label
end

# the enum-eq helper identity is the CONCRETE key (mir_type_identity_key
# of the compared enum) — Option[u8] and Option[Int] are distinct helpers.
# The EMISSION label sanitizes the render (type renders contain '#', '[',
# ']', ',' — invalid asm label characters).
def sanitize_label_part(s: String) -> String
  var out = ""
  var i = 0
  while i < s.len() do
    let c = s.char_at(i)
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' then
      out = out + c.to_string()
    else
      out = out + "_"
    end
    i = i + 1
  end
  out
end

def enum_eq_helper_label(ckey: String) -> String
  ".Lenum_eq_helper." + sanitize_label_part(&ckey)
end

def request_enum_eq_helper(inout ctx: CodegenCtx, ty: Type) -> String
  let ckey = mir_type_identity_key(ty)
  let label = enum_eq_helper_label(ckey.clone())
  if !ctx.enum_eq_helper_requested.contains(&ckey) then
    ctx.enum_eq_helper_requested.insert(ckey)
    ctx.enum_eq_helper_queue.push(ty.clone())
  end
  label
end

# The EnumLayout of a registered enum TYPE (concrete Adt), fail-closed: a
# type with no enum layout reaching an enum question is an internal
# compiler error. resolved through the concrete key — the payload
# layout of Option[u8] comes from the Option[u8] EnumLayout, never a
# nominal record.
def enum_layout_strict(inout ctx: CodegenCtx, ty: Type) -> EnumLayout
  let stripped = strip_ref_like_type(ty)
  match enum_layout_for_type(&mut ctx.layout_engine, &stripped)
  when Option::Some(el) then el
  when Option::None then
    panic("ICE: enum layout query failed closed: type " + mir_type_identity_key(ty) + " is not a registered enum (no EnumLayout)")
  end
end

# The payload base offset of a registered enum's image, from the EnumLayout
# (the single authority — never a hardcoded 8).
def enum_payload_base(inout ctx: CodegenCtx, ty: Type) -> Int
  enum_layout_strict(ctx, ty).payload_offset
end

# The discriminant of a variant by its registered NAME, from the layout
# authority (variant_discriminant in the engine). Fail closed when the type
# is not a registered enum or the variant is unknown.
def enum_variant_discriminant_of(inout ctx: CodegenCtx, ty: Type, variant_name: String) -> Int
  let stripped = strip_ref_like_type(ty)
  match variant_discriminant(&mut ctx.layout_engine, &stripped, variant_name)
  when Option::Some(d) then d
  when Option::None then
    panic("ICE: enum_variant_discriminant_of: variant `" + variant_name + "` not found in type " + mir_type_identity_key(ty))
  end
end

# The discriminant of a registered enum's FIRST variant (variant 0), from
# the EnumLayout. Used by the Option/Result unwrap intrinsics, whose success
# variant (Some/Ok) is always variant 0 — asked of the layout, never a
# hardcoded 0.
def enum_first_variant_discriminant(inout ctx: CodegenCtx, ty: Type) -> Int
  let el = enum_layout_strict(ctx, ty)
  if el.variant_layouts.len() > 0 then
    el.variant_layouts[0].discriminant
  else
    panic("ICE: enum_first_variant_discriminant: enum " + mir_type_identity_key(ty) + " has no variants")
  end
end

# Normalize an enum's register-resident VALUE to a plain discriminant tag,
# asking the layout engine's EnumLayout — the single enum-representation
# authority. For TaggedPtr-represented enums (every registered enum today):
# values below the layout's inline-tag threshold are raw discriminants and
# pass through; values at/above the threshold are heap pointers to the enum
# image, whose tag sits at tag_layout.offset (dereferenced). The threshold
# and the deref rule come from the EnumLayout — codegen never contains the
# boundary policy. For InlineTagged-represented enums the register value
# carries the tag word itself (tag_offset 0) — no normalization is needed.
def normalize_enum_value_to_tag(inout ctx: CodegenCtx, reg: PhysReg, enum_ty: Type) -> Unit
  let el = enum_layout_strict(ctx, enum_ty)
  match el.representation
  when EnumValueRepresentation::TaggedPtr(threshold) then
    let lbl_done = next_codegen_label(ctx, ".Lenum_tag_done.")
    let lbl_deref = next_codegen_label(ctx, ".Lenum_tag_deref.")
    emit_cmp_ri(ctx, reg, threshold)
    emit_jcc(ctx, CondKind::Ge, lbl_deref.clone())
    emit_jmp(ctx, lbl_done.clone())
    def_label(&mut ctx.text, lbl_deref)
    emit_load_mem(ctx, reg, reg, el.tag_layout.offset)
    def_label(&mut ctx.text, lbl_done)
  when EnumValueRepresentation::InlineTagged then
    # The value IS the tagged image: the tag word sits at the value base
    # (tag_layout.offset is 0) — the low bits of the register value already
    # ARE the discriminant.
    ()
  when EnumValueRepresentation::Opaque then
    panic("ICE: normalize_enum_value_to_tag: enum type " + mir_type_identity_key(enum_ty) + " has an opaque (unresolved) EnumLayout")
  end
end

# The DISCRIMINANT of a variant by its DECLARATION index (VariantId.index
# is declaration order, NEVER the discriminant), from the layout authority
# (the EnumLayout's variant_layouts, built in declaration order).
def enum_variant_discriminant_of_index(inout ctx: CodegenCtx, ty: Type, variant_index: Int) -> Int
  let el = enum_layout_strict(ctx, ty)
  if variant_index >= 0 && variant_index < el.variant_layouts.len() then
    el.variant_layouts[variant_index].discriminant
  else
    panic("ICE: enum_variant_discriminant_of_index: variant index " + variant_index.to_string() + " out of range in type " + mir_type_identity_key(ty))
  end
end

# The DECLARATION index of a variant by name (VariantId.index — declaration
# order, never the discriminant), from the enum's MirTypeDef. Used by the
# drop-glue downcasts (Option::Some, Result Ok/Err, plan variants).
def enum_variant_index_of_name(ctx: CodegenCtx, type_id: Int, variant_name: String) -> Int
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].name == variant_name then return vi end
        vi = vi + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  panic("ICE: enum_variant_index_of_name: variant `" + variant_name.clone() + "` not found in type " + type_id.to_string())  end
end

# The DECLARATION index of a variant by its discriminant — the DeinitPlan
# Enum arm is discriminant-keyed (variant discriminant -> (VariantId,
# plans)) and the VariantId is carried directly; this index resolution
# serves the remaining discriminant-side consumers.
# takes the CONCRETE enum type (the declaration order is a def
# property, so the def is looked up through the type's TypeId).
def enum_variant_index_of_discriminant(ctx: CodegenCtx, ty: Type, discriminant: Int) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].discriminant == discriminant then return vi end
        vi = vi + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  panic("ICE: enum_variant_index_of_discriminant: no variant " + discriminant.to_string() + " in type " + type_id.to_string())
end

# Return the payload-relative offset (0 = first payload field) of an enum
# variant's field, from the single layout authority (the layout engine —
# the flat field list is [tag, v0.f0..v0.fN, v1.f0..v1.fN,...] in
# DECLARATION order, so the variant INDEX computes the flat index directly).
def enum_field_offset_for_variant_index(inout ctx: CodegenCtx, ty: Type, variant_index: Int, field_idx: Int) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      if variant_index >= 0 && variant_index < variants.len() then
        var flat = 1
        var pi = 0
        while pi < variant_index do
          flat = flat + variants[pi].fields.len()
          pi = pi + 1
        end
        flat = flat + field_idx
 # the flat field offset comes from the CONCRETE enum's
        # layout (the substituted field list under this Adt's args).
        let abs = field_offset(&mut ctx.layout_engine, ty, flat)
        # Subtract the tag/payload-start offset to get a payload-relative
        # value. The payload base comes from the EnumLayout — the single
        # enum authority — never a hardcoded 8.
        let pbase = enum_payload_base(ctx, ty)
        abs - pbase
      else
        panic("enum_field_offset_for_variant_index: variant index " + variant_index.to_string() + " out of range in type " + type_id.to_string())
      end
    when _ then
      panic("enum_field_offset_for_variant_index: type " + type_id.to_string() + " is not an enum")
    end
  when Option::None then
    panic("enum_field_offset_for_variant_index: unknown type " + type_id.to_string())
  end
end

def emit_enum_eq_loaded(inout ctx: CodegenCtx, ty: Type, dst: PhysReg, scratch: PhysReg) -> Unit
  let arch = ctx.target.arch
  let label = request_enum_eq_helper(ctx, ty)

  match arg_reg(arch, 1)
  when Option::Some(arg1) then
    if phys_reg_id(arg1) != phys_reg_id(scratch) then
      emit_mov_rr(ctx, arg1, scratch)
    end
  when Option::None then ()
  end

  match arg_reg(arch, 0)
  when Option::Some(arg0) then
    if phys_reg_id(arg0) != phys_reg_id(dst) then
      emit_mov_rr(ctx, arg0, dst)
    end
  when Option::None then ()
  end

  emit_call_label(ctx, label)

  let rr = ret_reg(arch)
  if phys_reg_id(dst) != phys_reg_id(rr) then
    emit_mov_rr(ctx, dst, rr)
  end
end

def emit_enum_eq_helper_body(inout ctx: CodegenCtx, ty: Type) -> Unit
  let ckey = mir_type_identity_key(ty)
  if ctx.enum_eq_helper_emitted.contains(&ckey) then
    return
  end
  ctx.enum_eq_helper_emitted.insert(ckey.clone())

  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let temp = scratch_reg(arch)
  let dst = match arg_reg(arch, 0)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg0 register")
  end
  let scratch = match arg_reg(arch, 1)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg1 register")
  end
  let saved_left_offset = match arch
  when Arch::X86_64 then -8
  when Arch::AArch64 then -16
  end
  let saved_right_offset = match arch
  when Arch::X86_64 then -16
  when Arch::AArch64 then -32
  end

  align_to(&mut ctx.text, 4, arch)
  def_label(&mut ctx.text, enum_eq_helper_label(ckey))

  match arch
  when Arch::X86_64 then
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp_reg(arch))
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  end

  emit_push(ctx, dst)
  emit_push(ctx, scratch)

  # Normalization asks the EnumLayout of the compared enum (the concrete
  # type — the single enum-representation authority; codegen holds no
  # threshold policy).
  normalize_enum_value_to_tag(ctx, dst, ty)
  normalize_enum_value_to_tag(ctx, scratch, ty)

  let lbl_false = next_codegen_label(ctx, ".Lenum_eq_false.")
  let lbl_true = next_codegen_label(ctx, ".Lenum_eq_true.")
  let lbl_done = next_codegen_label(ctx, ".Lenum_eq_done.")

  emit_cmp_rr(ctx, dst, scratch)
  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())

  var has_payload_variant = false
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var variant_vi = 0
      for variant in variants do
          if variant.fields.len() > 0 then
            has_payload_variant = true
            let lbl_next_variant = next_codegen_label(ctx, ".Lenum_eq_next_variant.")
            emit_cmp_ri(ctx, dst, variant.discriminant as i32)
            emit_jcc(ctx, CondKind::Ne, lbl_next_variant.clone())

            var field_idx = 0
            for def_field_ty in variant.fields do
              # Absolute payload field offset: EnumLayout payload base +
              # payload-relative offset (the base comes from the layout
              # authority — never a hardcoded 8). The variant index is the
              # DECLARATION index (the loop position), never the
              # discriminant.
 # the compared field type is the def field type
              # SUBSTITUTED under the concrete enum's args.
              let field_ty = substitute_in_concrete_adt(&ctx.layout_engine, ty, def_field_ty)
              let field_off = enum_payload_base(ctx, ty) + enum_field_offset_for_variant_index(ctx, ty, variant_vi, field_idx)
              emit_load_mem(ctx, dst, fp, saved_left_offset)
              emit_load_mem(ctx, scratch, fp, saved_right_offset)
              emit_load_mem(ctx, dst, dst, field_off as i32)
              emit_load_mem(ctx, scratch, scratch, field_off as i32)

              match field_ty
              when Type::String then
                codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Float then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F32 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F64 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Adt(tid, _) then
                if is_enum_type_id(ctx, tid.id) then
 # the compared field type is CONCRETE (the def
                  # field type was substituted above) — the nested eq helper
                  # is keyed by its (TypeId, substs) identity.
                  emit_enum_eq_loaded(ctx, &field_ty, dst, scratch)
                  emit_test_rr(ctx, dst, dst)
                  emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
                else
                  emit_cmp_rr(ctx, dst, scratch)
                  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
                end
              when _ then
                emit_cmp_rr(ctx, dst, scratch)
                emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
              end

              field_idx = field_idx + 1
            end

            emit_jmp(ctx, lbl_true.clone())
            def_label(&mut ctx.text, lbl_next_variant)
          end
          variant_vi = variant_vi + 1
        end
      when _ then ()
      end
    when Option::None then ()
    end

  emit_jmp(ctx, lbl_true.clone())

  def_label(&mut ctx.text, lbl_false)
  emit_zero_reg(ctx, dst)
  emit_jmp(ctx, lbl_done.clone())

  def_label(&mut ctx.text, lbl_true)
  emit_mov_ri(ctx, dst, 1)

  def_label(&mut ctx.text, lbl_done)
  emit_pop(ctx, scratch)
  emit_pop(ctx, temp)
  match arch
  when Arch::X86_64 then
    emit_pop(ctx, fp)
    emit_ret(ctx)
  when Arch::AArch64 then
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

def emit_pending_enum_eq_helpers(inout ctx: CodegenCtx) -> Unit
  var idx = 0
  while idx < ctx.enum_eq_helper_queue.len() do
    let enum_ty = ctx.enum_eq_helper_queue[idx]
    if !ctx.enum_eq_helper_emitted.contains(&mir_type_identity_key(&enum_ty)) then
      emit_enum_eq_helper_body(ctx, &enum_ty)
    end
    idx = idx + 1
  end
end

def projection_is_field(proj: Projection) -> Bool
  match proj
  when Projection::Field(_) then true
  when Projection::TupleIndex(_) then true
  when _ then false
  end  end
end

# Storage size of a scalar type in bytes (1/2/4/8), matching storage_width_of.
# Non-immediate representations are pointer-width (8), again via the Repr
# decision table — the byte-count mirror of storage_width_of.
def storage_size_bytes(inout ctx: CodegenCtx, ty: Type) -> Int
  match codegen_type_repr(ctx, ty)
  when Repr::Immediate then
    match ty
    when Type::Bool then 1
    when Type::I8 then 1
    when Type::U8 then 1
    when Type::I16 then 2
    when Type::U16 then 2
    when Type::I32 then 4
    when Type::U32 then 4
    when Type::F32 then 4
    when Type::Char then 4
    when Type::I64 then 8
    when Type::U64 then 8
    when Type::Int then 8
    when Type::UInt then 8
    when Type::ISize then 8
    when Type::USize then 8
    when Type::F64 then 8
    when _ then 8
    end
  when _ then 8
  end  end
end

# Byte stride between consecutive collection elements — derived from the
# element's VALUE CATEGORY (classify_value_category, the layout engine's
# single ABI authority), so the stride ALWAYS equals the element TRANSFER
# size:
#   ZeroSized    -> 0 (nothing to copy)
#   Scalar(w)    -> w (1/2/4/8 — the width-dispatch transfer)
#   ScalarPair   -> 16 (the 16-byte image)
#   ByAddress(sz)-> sz (the full image byte size)
# The engine's inline aggregate layouts are alignment-rounded
# (compute_tuple_layout / compute_struct_layout round the total size up to
# the aggregate alignment), so stride == size_of(T) for every aligned
# aggregate — the Vec header stride is BOTH the addressing stride and the
# byte-copy length. (This replaces the old storage_size_bytes guess, which
# returned a flat 8 for every Inline aggregate — a 16-byte tuple or a
# 24-byte struct element was addressed at 8-byte intervals.)
def element_stride_bytes(inout ctx: CodegenCtx, elem_ty: Type) -> Int
  match classify_value_category(&mut ctx.layout_engine, elem_ty)
  when Result::Err(e) then
    panic("ICE: element-stride classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then 0
    when ValueCategory::Scalar(w) then w
    when ValueCategory::ScalarPair(_, _) then 16
    when ValueCategory::Vector(w) then w
    when ValueCategory::ByAddress(sz) then sz
    end
  end  end
end

# The CONCRETE element type of a Vec/Array/Slice receiver (or a FixedArray
# element type), used to compute the element stride at an operation site.
# The layout values MUST come from the concrete type here — a generic Param
# is a monomorphization bug and fails closed (panic).
def vec_elem_type_of(inout ctx: CodegenCtx, ty: Type) -> Type
  let stripped = strip_ref_like_type(ty)
  match stripped
  when Type::FixedArray(elem, _) then elem.clone()
  when Type::Adt(tid, args) then
    let ven = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if ven == "Array" || ven == "Vec" || ven == "UnsafeSlice" || ven == "Slice" then
      if args.is_empty() then
        panic("internal error: Vec/Array receiver type carries no element type argument at a codegen operation site")
      end
      let elem = strip_ref_like_type(&args[0])
      match elem
      when Type::Param(_) then
        panic("internal error: Vec element type is an unresolved Param at a codegen operation site — the monomorphizer must supply the concrete element type")
      when _ then elem.clone()
      end
    else
      panic("internal error: expected a Vec/Array/Slice receiver type for element-layout computation, got `" + type_name_by_id(ctx, tid.id) + "`")
    end
  when Type::String then
 # String::new no longer routes through ArrayNew (it builds
    # the owned String object via _tg_string_new), so this arm is reached
    # only by the char-Vec convention of `str.chars()` (_tg_str_chars
    # builds a Vec[Char], stride 4) — kept for that path.
    Type::Char
  when _ then
    panic("internal error: expected a Vec/Array/Slice receiver type for element-layout computation")
  end
end

# Scale `reg` (an element index) by `stride` bytes. The single codegen-side
# element-index scaler, used by ProjIndex/ProjConstantIndex, the drop-glue
# array walk and codegen_array_last: shifts for power-of-two strides, a
# multiply for any other stride (fixed-array elements). The multiply uses a
# caller-saved scratch that is dead at every call site (X16/X17, R11/RDX —
# R11 is the register the addr-path scales, so the helper falls back to RDX
# when `reg` IS R11).
def emit_scale_index(inout ctx: CodegenCtx, reg: PhysReg, stride: Int) -> Unit
  match reg
  when PhysReg::A64Reg(a) then
    match stride
    when 1 then ()
    when 2 then a64_lsl(&mut ctx.text, a, a, 1)
    when 4 then a64_lsl(&mut ctx.text, a, a, 2)
    when 8 then a64_lsl(&mut ctx.text, a, a, 3)
    when _ then
      let mul_scratch = if a == A64::X16 then A64::X17 else A64::X16 end
      a64_mov_ri(&mut ctx.text, mul_scratch, stride as i64)
      a64_mul_rrr(&mut ctx.text, a, a, mul_scratch)
    end
  when PhysReg::X64Reg(x) then
    match stride
    when 1 then ()
    when 2 then x64_shl_ri(&mut ctx.text, x, 1)
    when 4 then x64_shl_ri(&mut ctx.text, x, 2)
    when 8 then x64_shl_ri(&mut ctx.text, x, 3)
    when _ then
      let mul_scratch = if x == X64::R11 then X64::RDX else X64::R11 end
      x64_mov_ri(&mut ctx.text, mul_scratch, stride as i64)
      x64_imul_rr(&mut ctx.text, x, mul_scratch)
    end
  end  end
end

def apply_projections(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, projs: Vec[Projection], reg: PhysReg) -> Unit
  let scratch = ret_reg(ctx.target.arch)  # use return reg as scratch for index loads
  var current_ty = local_type(fctx, place.local.id)
  var downcast_variant: Option[VariantId] = Option::None
  var last_deref_unwrapped_ref = false
  # Label to skip remaining projections after a payload-less inline-tag
  # Variant downcast (TaggedPtr-represented enums: a raw discriminant below
  # the layout threshold has no heap-allocated payload, so there is no
  # payload struct to project into — remaining field/offset projections must
  # be skipped to avoid null-pointer dereference (ldr x0, [x0] on xzr). The
  # threshold/payload rule comes from the EnumLayout, never codegen.)
  let lbl_skip_remaining = next_codegen_label(ctx, ".Lskip_remaining.")

  var i = 0
  while i < projs.len() do
    let proj = projs[i]
    match proj
    when Projection::ProjDeref then ()
    when _ then
      if is_ref_like_type(&current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        current_ty = project_deref_type(ctx, &current_ty)
      end
    end
    match proj
    when Projection::ProjDeref then
      last_deref_unwrapped_ref = is_ref_like_type(&current_ty)
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = project_deref_type(ctx, &current_ty)
    when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type (— the place's current type
      # carries the Adt args; a generic def's field is substituted).
      let offset = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
      let field_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
      let fwidth = storage_width_of(ctx, &field_ty)
      let fext = storage_signedness_of(&field_ty)
      if (offset % mem_width_bytes(fwidth)) != 0 then
        # A @packed-aggregate field at a MISALIGNED static offset: the
        # byte-wise unaligned load.
        emit_push(ctx, reg)
        emit_add_ri(ctx, reg, offset as i32)
        emit_load_mem_sized_unaligned(ctx, reg, reg, fwidth, fext)
        emit_pop(ctx, scratch)
      else
        emit_load_mem_sized(ctx, reg, reg, offset as i32, fwidth, fext)
      end
      current_ty = field_ty
      last_deref_unwrapped_ref = false
    when Projection::TupleIndex(idx) then
 # positional tuple element access — the offset comes from the
      # layout engine's tuple layout.
      let offset = projected_tuple_offset(ctx, &current_ty, idx)
      let field_ty = projected_tuple_type(ctx, &current_ty, idx)
      let fwidth = storage_width_of(ctx, &field_ty)
      let fext = storage_signedness_of(&field_ty)
      if (offset % mem_width_bytes(fwidth)) != 0 then
        # A @packed-aggregate tuple field at a MISALIGNED static offset:
        # the byte-wise unaligned load.
        emit_push(ctx, reg)
        emit_add_ri(ctx, reg, offset as i32)
        emit_load_mem_sized_unaligned(ctx, reg, reg, fwidth, fext)
        emit_pop(ctx, scratch)
      else
        emit_load_mem_sized(ctx, reg, reg, offset as i32, fwidth, fext)
      end
      current_ty = field_ty
      last_deref_unwrapped_ref = false
    when Projection::ProjIndex(local_id) then
      let idx_reg = scratch2_reg(ctx.target.arch)
      load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
      # Determine element size from the collection type.
      let elem_ty = project_index_type(ctx, &current_ty)
      let elem_size = element_stride_bytes(ctx, &elem_ty)
      let is_byte_indexed = is_string_like_type(ctx, &current_ty)
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        if !is_byte_indexed then
          # Scale index by the element's storage stride (1/2/4/8 shifts,
          # multiply for any other stride — the SAME authority the runtime
          # reads from the Vec header).
          emit_scale_index(ctx, idx_reg, elem_size)
        end
        # Add scaled offset to base address
        emit_add_rrr(ctx, reg, reg, idx_reg)
      elsif is_shared_slice_type(ctx, &current_ty) then
        # The SAFE source-spelled Slice — the SHARED form's element read:
        # element i lives at backing.ptr + i * stride (the backing.ptr IS
        # the pinned window's start; the backing's offset is source
        # metadata, never an element address — the std get/sub contract).
        # The Arc deref chain: [value+0] = ArcInnerWeak*, [inner+16] =
        # SliceBacking { ptr@0, len@8, offset@16 }. The scratch register
        # is consumed BEFORE emit_scale_index (which may itself use the
        # scratch on x86-64 for a non-power-of-2 stride).
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), reg, 0)  # scratch = ArcInnerWeak*
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), scratch_reg(ctx.target.arch), 16) # scratch = SliceBacking*
        emit_load_mem(ctx, reg, scratch_reg(ctx.target.arch), 0)  # reg = backing.ptr
        emit_add_rrr(ctx, reg, reg, idx_reg)                      # reg = ptr + i
        emit_scale_index(ctx, reg, elem_size)
      else
        if !is_byte_indexed then
          # Scale index by the element's storage stride (1/2/4/8 shifts,
          # multiply for any other stride — the SAME authority the runtime
          # reads from the Vec header).
          emit_scale_index(ctx, idx_reg, elem_size)
        end
        # Add scaled offset to base address
        emit_add_rrr(ctx, reg, reg, idx_reg)
      end
      if is_byte_indexed then
        match reg
        when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
        when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
        end
      else
        let ewidth = storage_width_of(ctx, &elem_ty)
        let eext = storage_signedness_of(&elem_ty)
        emit_load_mem_sized(ctx, reg, reg, 0, ewidth, eext)
      end
      current_ty = elem_ty
      last_deref_unwrapped_ref = false
    when Projection::ProjConstantIndex(ci) then
      let is_byte_indexed = is_string_like_type(ctx, &current_ty)
      let elem_ty2 = project_index_type(ctx, &current_ty)
      let elem_size2 = element_stride_bytes(ctx, &elem_ty2)
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        if is_byte_indexed then
          emit_add_ri(ctx, reg, ci as i32)
          match reg
          when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
          when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
          end
        else
          let offset = ci * elem_size2
          let ewidth2 = storage_width_of(ctx, &elem_ty2)
          let eext2 = storage_signedness_of(&elem_ty2)
          emit_load_mem_sized(ctx, reg, reg, offset as i32, ewidth2, eext2)
        end
      elsif is_shared_slice_type(ctx, &current_ty) then
        # The SAFE source-spelled Slice — the SHARED form's constant-index
        # read: element ci at backing.ptr + ci * stride (the Arc deref
        # chain; see the ProjIndex arm — the scratch is consumed before
        # emit_scale_index).
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), reg, 0)  # scratch = ArcInnerWeak*
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), scratch_reg(ctx.target.arch), 16) # scratch = SliceBacking*
        emit_load_mem(ctx, reg, scratch_reg(ctx.target.arch), 0)  # reg = backing.ptr
        emit_add_ri(ctx, reg, ci as i32)                          # reg = ptr + ci
        emit_scale_index(ctx, reg, elem_size2)
        let ewidth2 = storage_width_of(ctx, &elem_ty2)
        let eext2 = storage_signedness_of(&elem_ty2)
        emit_load_mem_sized(ctx, reg, reg, 0, ewidth2, eext2)
      else
        if is_byte_indexed then
          emit_add_ri(ctx, reg, ci as i32)
          match reg
          when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
          when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
          end
        else
          let offset = ci * elem_size2
          let ewidth2 = storage_width_of(ctx, &elem_ty2)
          let eext2 = storage_signedness_of(&elem_ty2)
          emit_load_mem_sized(ctx, reg, reg, offset as i32, ewidth2, eext2)
        end
      end
      current_ty = elem_ty2
      last_deref_unwrapped_ref = false
    when Projection::Variant(vid) then
      downcast_variant = Option::Some(vid)
      # The payload-access rule comes from the enum's EnumLayout (the single
      # enum-representation authority): a TaggedPtr-represented enum value
      # is a heap pointer (at/above the layout threshold) to the image
      # { tag @ tag_layout.offset, payload @ payload_offset } — or a raw
      # inline discriminant (below the threshold) that has no heap payload.
      # The VariantId carries the enum OWNER + the variant's DECLARATION
 # index (never the discriminant). the EnumLayout is resolved
      # through the CONCRETE enum type (current_ty carries the Adt args).
      let dc_el = enum_layout_strict(ctx, &current_ty)
      match dc_el.representation
      when EnumValueRepresentation::TaggedPtr(threshold) then
        let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
        let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
        emit_cmp_ri(ctx, reg, threshold)
        emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
        # Heap pointer: skip the tag to reach the payload.
        emit_add_ri(ctx, reg, dc_el.payload_offset)
        if i == projs.len() - 1 then
          emit_load_mem(ctx, reg, reg, 0)
        end
        emit_jmp(ctx, lbl_payload_done.clone())
        def_label(&mut ctx.text, lbl_payload_skip)
        # Inline tag: no heap allocation, zero out the payload reference.
        emit_zero_reg(ctx, reg)
        # If there are remaining projections after the downcast, skip them.
        # An inline tag has no heap-allocated payload struct, so there is
        # nothing to project into — remaining projections would dereference
        # null (ldr x0, [x0]) and crash.
        if i < projs.len() - 1 then
          emit_jmp(ctx, lbl_skip_remaining.clone())
        end
        def_label(&mut ctx.text, lbl_payload_done)
      when EnumValueRepresentation::InlineTagged then
        # The value is the inline image: the payload sits at payload_offset
        # within the image — no threshold test.
        emit_add_ri(ctx, reg, dc_el.payload_offset)
        if i == projs.len() - 1 then
          emit_load_mem(ctx, reg, reg, 0)
        end
      when EnumValueRepresentation::Opaque then
        panic("ICE: apply_projections: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
      end
      last_deref_unwrapped_ref = false
    end
    i = i + 1
  end
  def_label(&mut ctx.text, lbl_skip_remaining)
end

def load_constant(inout ctx: CodegenCtx, cst: MirConstant, dst: PhysReg) -> Unit
  match cst.kind
  when MirConstantKind::MirUnit then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirBool(b) then
    if b then
      emit_mov_ri(ctx, dst, 1)
    else
      emit_zero_reg(ctx, dst)
    end
  when MirConstantKind::MirInt(i) then
    emit_mov_ri(ctx, dst, i as i64)
  when MirConstantKind::MirFloat(f) then
    # Load float bits into GPR, then move to float reg via stack
    let bits = f.to_bits() as i64
    emit_mov_ri(ctx, dst, bits)
    # Store GPR to temp stack slot, load back as float
    let sp = sp_reg(ctx.target.arch)
    emit_store_mem(ctx, sp, -8, dst)
    emit_load_fp_from_stack(ctx, dst, sp, -8)
  when MirConstantKind::MirChar(c) then
    emit_mov_ri(ctx, dst, c as i64)
  when MirConstantKind::MirString(s) then
    let label = intern_string(ctx, s)
    emit_lea_label(ctx, dst, label)
  when MirConstantKind::MirFnItem(fn_name) then
    # Load the address of a named function
    emit_lea_label(ctx, dst, fn_name.clone())
  when MirConstantKind::MirZeroSized then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
    # static label table (the name-side symbol-table registration).
    let label = resolve_static_label(ctx, did)
    # Load current value of a global/static variable: ADRP+ADD to get address, then LDR
    emit_lea_label(ctx, dst, label.clone())
    emit_load_mem(ctx, dst, dst, 0)
  when MirConstantKind::MirStaticAddr(did) then
    # Get address of a global/static variable: ADRP+ADD
    let label = resolve_static_label(ctx, did)
    emit_lea_label(ctx, dst, label.clone())
  end  end
end

# ———————————————————————————————————————————————————————————————
# Store to a Place
# ———————————————————————————————————————————————————————————————

def store_place(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = ret_reg(ctx.target.arch)
  let place_ty = local_type(fctx, place.local.id)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    if place.projections.is_empty() then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    else
      # Save value to stack, then compute base address in a DIFFERENT
      # register so that pop(src) does not clobber the base.
      let base = scratch2_reg(ctx.target.arch)  # X14 — not X0
      emit_push(ctx, src)

      match loc
      when VarLoc::Register(r) then
        emit_mov_rr(ctx, base, r)
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, base, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, base, fp, offset)
      end

      # Walk projections except last to compute base address
      var current_ty = place_ty
      var downcast_variant: Option[VariantId] = Option::None
      var i = 0
      let n = place.projections.len()
      # Label to skip remaining projections after a payload-less inline-tag
      # Variant downcast (the EnumLayout's TaggedPtr encoding: a raw
      # discriminant below the threshold has no heap-allocated payload, so
      # subsequent projection code would compute addresses from a zeroed
      # base register).
      let lbl_skip_store = next_codegen_label(ctx, ".Lskip_store_proj.")
      while i < n - 1 do
        let proj = place.projections[i]
        match proj
        when Projection::ProjDeref then ()
        when _ then
          if is_ref_like_type(&current_ty) then
            emit_load_mem(ctx, base, base, 0)
            current_ty = project_deref_type(ctx, &current_ty)
          end
        end
        match proj
        when Projection::ProjDeref then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type (— the place's current type
          # carries the Adt args; a generic def's field is substituted).
          let field_off = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
          emit_add_ri(ctx, base, field_off as i32)
          current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
        when Projection::TupleIndex(idx) then
          let field_off = projected_tuple_offset(ctx, &current_ty, idx)
          emit_add_ri(ctx, base, field_off as i32)
          current_ty = projected_tuple_type(ctx, &current_ty, idx)
        when Projection::Variant(vid) then
          downcast_variant = Option::Some(vid)
          # Payload addressing via the EnumLayout (the single
          # enum-representation authority): TaggedPtr-represented enums are
          # heap pointers (at/above the threshold) to the image with the
          # payload at payload_offset — or raw inline discriminants (below
          # the threshold) with no heap payload. The VariantId carries the
 # enum OWNER + the variant's DECLARATION index. the
          # EnumLayout resolves through the CONCRETE enum type (current_ty).
          let sp_el = enum_layout_strict(ctx, &current_ty)
          match sp_el.representation
          when EnumValueRepresentation::TaggedPtr(threshold) then
            let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
            let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
            emit_cmp_ri(ctx, base, threshold)
            emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
            emit_add_ri(ctx, base, sp_el.payload_offset)
            emit_jmp(ctx, lbl_payload_done.clone())
            def_label(&mut ctx.text, lbl_payload_skip)
            # Inline tag: no heap allocation, zero out the payload reference.
            emit_zero_reg(ctx, base)
            # If there are remaining non-last projections, skip them since
            # the inline tag has no heap-allocated payload struct to compute
            # addresses into.
            if i < n - 2 then
              emit_jmp(ctx, lbl_skip_store.clone())
            end
            def_label(&mut ctx.text, lbl_payload_done)
          when EnumValueRepresentation::InlineTagged then
            # The value is the inline image: payload at payload_offset.
            emit_add_ri(ctx, base, sp_el.payload_offset)
          when EnumValueRepresentation::Opaque then
            panic("ICE: store_place: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
          end
        when Projection::ProjIndex(local_id) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
          load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
          # Scale the index by the element's real storage stride (the same
          # authority the runtime reads from the Vec header).
          let sidx_elem_ty = project_index_type(ctx, &current_ty)
          let sidx_stride = element_stride_bytes(ctx, &sidx_elem_ty)
          emit_scale_index(ctx, scratch, sidx_stride)
          emit_add_rrr(ctx, base, base, scratch)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when Projection::ProjConstantIndex(ci) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
        let cidx_elem_ty = project_index_type(ctx, &current_ty)
        let cidx_stride = element_stride_bytes(ctx, &cidx_elem_ty)
        emit_add_ri(ctx, base, (ci * cidx_stride) as i32)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when _ then ()
        end
        i = i + 1
      end
      def_label(&mut ctx.text, lbl_skip_store)

      # Last projection determines final store offset
      let last = place.projections[n - 1]
      var store_off: i32 = 0
      match last
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        end
      end
      match last
      when Projection::ProjDeref then
        store_off = 0
      when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type.
        let fo = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
        store_off = fo as i32
      when Projection::TupleIndex(idx) then
        let fo = projected_tuple_offset(ctx, &current_ty, idx)
        store_off = fo as i32
        current_ty = projected_tuple_type(ctx, &current_ty, idx)
      when Projection::ProjIndex(local_id) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
        let idx_elem_ty = project_index_type(ctx, &current_ty)
        let idx_elem_size = element_stride_bytes(ctx, &idx_elem_ty)
        emit_scale_index(ctx, scratch, idx_elem_size)
        emit_add_rrr(ctx, base, base, scratch)
        store_off = 0
        current_ty = idx_elem_ty
      when Projection::ProjConstantIndex(ci) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        let celem_ty = project_index_type(ctx, &current_ty)
        store_off = (ci * element_stride_bytes(ctx, &celem_ty)) as i32
        current_ty = celem_ty
      when Projection::Variant(_) then
        # The final store lands on the payload base of the enum image —
        # from the EnumLayout (the CONCRETE enum type), never a hardcoded 8.
        match downcast_variant
        when Option::Some(vid) then
          store_off = enum_payload_base(ctx, &current_ty)
        when Option::None then
          store_off = 0
        end
        current_ty = Type::Int
      when _ then
        store_off = 0
      end

      emit_pop(ctx, src)  # restore value
      # Store exactly the final projected value's storage width so a narrow
      # field/element is never overwritten by an 8-byte write. A
      # @packed-aggregate field at a MISALIGNED static offset (the
      # attributed layout's packed offsets) lowers through the byte-wise
      # UNALIGNED path — never a direct misaligned mov.
      let final_store_width = storage_width_of(ctx, &current_ty)
      if (store_off as Int) % mem_width_bytes(final_store_width) != 0 then
        emit_push(ctx, base)
        emit_add_ri(ctx, base, store_off)
        emit_store_mem_sized_unaligned(ctx, base, src, final_store_width)
        emit_pop(ctx, scratch)
      else
        emit_store_mem_sized(ctx, base, store_off, src, final_store_width)
      end
    end
  when Option::None then
    panic("store_place: unknown local " + place.local.id.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Rvalue code generation
# ———————————————————————————————————————————————————————————————

def codegen_rvalue(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, stmt: MirStatement, dst: PhysReg) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rv) then
    match rv.kind
    when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end

    when MirRvalueKind::MirBinOp(bin_op, left, right) then
      codegen_binop(ctx, fctx, bin_op, left, right, dst)

    when MirRvalueKind::MirUnOp(un_op, operand) then
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, dst)
      when MirUnOp::Not    then
        emit_test_rr(ctx, dst, dst)
        emit_setcc(ctx, CondKind::Eq, dst)
      when MirUnOp::BitNot then emit_not(ctx, dst)
      end

    when MirRvalueKind::MirRef(place) then
      emit_ref_place(ctx, fctx, place, dst)

    when MirRvalueKind::MirAggregate(kind, operands) then
 # the aggregate emitter resolves the concrete layout through
      # the ASSIGN destination's concrete type (the post-mono place type
      # carries the Adt args).
      codegen_aggregate(ctx, fctx, kind, operands, dst, &place_type(ctx, fctx, place))

    when MirRvalueKind::MirDiscriminant(place) then
      load_place(ctx, fctx, place, dst)
      # Normalize via the enum's EnumLayout — the single enum-representation
      # authority (no codegen threshold policy). The enum type comes from the
      # place's own type (the MirDiscriminant reads the enum VALUE word);
 # the CONCRETE type (Adt args included) selects the layout.
      normalize_enum_value_to_tag(ctx, dst, &place_type(ctx, fctx, place))

    when MirRvalueKind::MirLen(place) then
      let len_ty2 = place_type(ctx, fctx, place)
      match strip_receiver_ptr_like_type(&len_ty2)
      when Type::FixedArray(_, n) then
        # Fixed arrays: the length is the compile-time count carried in the
        # TYPE — emit the constant, never a heap-header read.
        emit_mov_ri(ctx, dst, n as i64)
      when _ then
      if is_slice_view_type(ctx, &len_ty2) then
        # UnsafeSlice[T] raw-view len: the len lives in the VIEW's second
        # word, not in a heap header. dst = the view base address (a plain
        # raw-view place is addressed directly; a &UnsafeSlice place derefs
        # its ref slot once).
        emit_place_address(ctx, fctx, place, dst)
        if is_ref_like_type(&len_ty2) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let slice_len_off2 = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
        emit_load_mem(ctx, dst, dst, slice_len_off2 as i32)
      else
      load_place(ctx, fctx, place, dst)
      emit_len_ref_derefs(ctx, dst, &len_ty2)
      let len_value_ty2 = strip_receiver_ptr_like_type(&len_ty2)
      # The len field lives in the heap header — a valid header read only for
      # HeapVecHeader/HeapMapHeader/HeapSetHeader representations (offset from
      # the engine's container_field_offset). Behavior unchanged: the Adt
      # Array form is the heap-vector identity (the fixed arrays are the
      # distinct Type::FixedArray variant), so every array len is a header read.
      if is_heap_collection_type(ctx, &len_value_ty2) then
        let lbl_len_done2 = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, dst, dst)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done2.clone())
        emit_load_mem(ctx, dst, dst, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty2), &"len".to_string()))
        def_label(&mut ctx.text, lbl_len_done2)
      else
        emit_load_mem(ctx, dst, dst, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty2), &"len".to_string()))
      end
      end
      end

    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
        # cvtsi2sd xmm0, dst (via stack round-trip)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)  # cvtsi2sd xmm0, rax
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)  # movq rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # SCVTF D0, Xn  — convert GPR int to FP D0
        emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
        # FMOV Xdst, D0 — move FP bits back to GPR
        a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)  # movq xmm0, rax
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)  # cvttsd2si rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # FMOV D0, Xn  — move GPR float-bits to FP register
        a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
        # FCVTZS Xdst, D0  — convert FP to int
        emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
      # Narrowing integer casts need an explicit mask; widening is a register no-op here.
      let target_bits = layout_of_strict(&mut ctx.layout_engine, &target_ty).size * 8
      if target_bits < 64 then
        let mask = (1 << target_bits) - 1
        emit_and_ri(ctx, dst, mask as i32)
      end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_rvalue: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(operand, count) then
    # Allocate count * element_size on stack and fill with the value
    let scratch = ret_reg(ctx.target.arch)
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, scratch, 1)
        else
          emit_zero_reg(ctx, scratch)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, scratch, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, scratch, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, scratch)
        emit_load_fp_from_stack(ctx, scratch, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, scratch, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, scratch, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, scratch, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, scratch, label.clone())
        emit_load_mem(ctx, scratch, scratch, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, scratch, label.clone())
      end
    end
    # Store element for each repetition at dst + i * element_size
    let repeat_ty = operand_type(ctx, fctx, &operand)
    let repeat_width = storage_width_of(ctx, &repeat_ty)
    let repeat_stride = element_stride_bytes(ctx, &repeat_ty)
    var i: UInt = 0
    while i < count do
      emit_store_mem_sized(ctx, dst, (i as Int * repeat_stride) as i32, scratch, repeat_width)
      i = i + 1
    end

    when MirRvalueKind::MirPhi(pairs) then
    # Phi nodes: values already placed by predecessor blocks.
    # Skip — no code generation needed.
    ()
    when _ then
      panic("codegen_rvalue: unsupported MIR rvalue kind")
    end
  when _ then
    panic("codegen_rvalue: expected assignment statement")
  end  end
end

def compute_string_locals(func: MirFunction) -> Set[Int]
  var strings: Set[Int] = Set::new()

  for local in func.locals do
    match local.ty
    when Type::String then strings.insert(local.id.id)
    else ()
    end
  end
  for param in func.params do
    match param.ty
    when Type::String then strings.insert(param.id.id)
    else ()
    end
  end

  strings
end

def is_string_operand(op: MirOperand, fctx: FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirString(_) then return true
    else ()
    end
  when MirOperandKind::MirCopy(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirMovePlace(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirRead(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirConsume(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  end
  false  end
end

def is_float_operand(op: MirOperand, fctx: FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFloat(_) then return true
    else ()
    end
    match c.ty
    when Type::Float then return true
    when Type::F32 then return true
    when Type::F64 then return true
    when _ then ()
    end
  when MirOperandKind::MirCopy(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirMovePlace(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirRead(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirConsume(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  end
  false  end
end

# String comparison helper: move operands to arg0/arg1, call inline str_cmp,
# compare result (-1/0/1) with 0, set condition code into dst.
def codegen_str_binop(inout ctx: CodegenCtx, dst: PhysReg, scratch: PhysReg, cond: CondKind) -> Unit
  let arch = ctx.target.arch
  # Move operands to argument registers for codegen_str_cmp
  match arg_reg(arch, 1)
  when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
  when Option::None then ()
  end
  match arg_reg(arch, 0)
  when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
  when Option::None then ()
  end
  # Inline byte-by-byte comparison, result in ret_reg (-1, 0, or 1)
  codegen_str_cmp(ctx)
  let rr = ret_reg(arch)
  # Compare str_cmp result with 0 and set condition flag
  emit_cmp_ri(ctx, rr, 0)
  emit_setcc(ctx, cond, dst)
end

def codegen_binop(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirBinOp, left: MirOperand, right: MirOperand, dst: PhysReg) -> Unit
  let scratch = scratch2_reg(ctx.target.arch)
  load_operand_binop_input(ctx, fctx, left, dst)
  load_operand_binop_input(ctx, fctx, right, scratch)

  let is_float = is_float_operand(left, fctx) || is_float_operand(right, fctx)
  let left_ty = operand_type(ctx, fctx, left)
  let right_ty = operand_type(ctx, fctx, right)
  let left_is_string =
    is_string_operand(left, fctx) ||
    is_string_like_type(ctx, &left_ty) ||
    is_string_like_type(ctx, &strip_ref_like_type(&left_ty))
  let right_is_string =
    is_string_operand(right, fctx) ||
    is_string_like_type(ctx, &right_ty) ||
    is_string_like_type(ctx, &strip_ref_like_type(&right_ty))
  let enum_ty = enum_type_for_operands(ctx, fctx, left, right)
  let enum_is = match enum_ty
  when Type::Unit then false
  when _ then true
  end

  if is_float then
    codegen_float_binop(ctx, op, dst, scratch)
    return
  end

  match op
  when MirBinOp::Add then
    if left_is_string || right_is_string then
 # String concatenation. The operands are String OBJECTS
      # (headers) or static StaticStrPtr constants (raw labels) — normalize to
      # the raw byte form, concatenate, and wrap the raw result into an
      # OWNED String object.
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      let arch = ctx.target.arch
      match arg_reg(arch, 1)
      when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
      when Option::None then ()
      end
      match arg_reg(arch, 0)
      when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
      when Option::None then ()
      end
      emit_call_label(ctx, "_tg_str_concat")
      let rr = ret_reg(arch)
      emit_mov_rr(ctx, dst, rr)
      codegen_string_wrap_result(ctx)
      emit_mov_rr(ctx, dst, rr)
    else
      emit_add_rrr(ctx, dst, dst, scratch)
    end
  when MirBinOp::Sub    then emit_sub_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Mul    then emit_mul_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Div    then emit_sdiv(ctx, dst, dst, scratch)
  when MirBinOp::Mod    then emit_smod(ctx, dst, dst, scratch)
  when MirBinOp::BitAnd then emit_and_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitOr  then emit_or_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitXor then emit_xor_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Shl    then emit_shl(ctx, dst, dst, scratch)
  when MirBinOp::Shr    then emit_shr(ctx, dst, dst, scratch)
  when MirBinOp::Eq then
    if left_is_string || right_is_string then
 # normalize the String-object operands to their data
      # pointers before the byte comparison (constants stay raw).
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
    else if enum_is then
 # the compared enum's CONCRETE type (Adt args included) keys
      # the eq helper — Option[u8] and Option[Int] compare distinctly.
      emit_enum_eq_loaded(ctx, &enum_ty, dst, scratch)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Eq, dst)
    end
  when MirBinOp::Ne then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Ne)
    else if enum_is then
      emit_enum_eq_loaded(ctx, &enum_ty, dst, scratch)
      emit_test_rr(ctx, dst, dst)
      emit_setcc(ctx, CondKind::Eq, dst)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ne, dst)
    end
  when MirBinOp::Lt then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Lt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Lt, dst)
    end
  when MirBinOp::Le then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Le)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Le, dst)
    end
  when MirBinOp::Gt then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Gt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Gt, dst)
    end
  when MirBinOp::Ge then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Ge)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ge, dst)
    end
  end
end

# Float binary operation: operands are in GPRs dst and scratch with float bit patterns.
# Move to FP registers D0/D1, compute, move result back to dst GPR.
def codegen_float_binop(inout ctx: CodegenCtx, op: MirBinOp, dst: PhysReg, scratch: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Move GPR float-bits to FP registers: D0 = dst, D1 = scratch
    let dst_gpr = match dst
    when PhysReg::A64Reg(r) then r
    when _ then A64::X0
    end
    let scratch_gpr = match scratch
    when PhysReg::A64Reg(r) then r
    when _ then A64::X14
    end
    a64_fmov_dx(&mut ctx.text, A64V::V0, dst_gpr)
    a64_fmov_dx(&mut ctx.text, A64V::V1, scratch_gpr)
    match op
    when MirBinOp::Add then a64_fadd_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Sub then a64_fsub_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Mul then a64_fmul_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Div then a64_fdiv_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Eq then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, EQ  (CSINC Xd, XZR, XZR, NE)
      emit_raw_u32(ctx, 0x9A9F17E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ne then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, NE  (CSINC Xd, XZR, XZR, EQ)
      emit_raw_u32(ctx, 0x9A9F07E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Lt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, MI  (CSINC Xd, XZR, XZR, PL)  — MI = float less than
      emit_raw_u32(ctx, 0x9A9F57E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Le then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, LS  (CSINC Xd, XZR, XZR, HI)  — LS = float less or equal
      emit_raw_u32(ctx, 0x9A9F87E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Gt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GT  (CSINC Xd, XZR, XZR, LE)
      emit_raw_u32(ctx, 0x9A9FD7E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ge then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GE  (CSINC Xd, XZR, XZR, LT)
      emit_raw_u32(ctx, 0x9A9FB7E0 | a64_code(dst_gpr))
      return
    when _ then
      # Fallback: treat as integer op
      emit_add_rrr(ctx, dst, dst, scratch)
      return
    end
    # Move FP result back to GPR
    a64_fmov_xd(&mut ctx.text, dst_gpr, A64V::V0)
  when Arch::X86_64 then
    # x86-64: move GPR float-bits to XMM0/XMM1 via stack
    let sp = sp_reg(ctx.target.arch)
    # Store dst to stack, load as xmm0
    emit_store_mem(ctx, sp, -8, dst)
    # movsd xmm0, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    # Store scratch to stack, load as xmm1
    emit_store_mem(ctx, sp, -8, scratch)
    # movsd xmm1, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    match op
    when MirBinOp::Add then
      # addsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x58)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Sub then
      # subsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5C)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Mul then
      # mulsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x59)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Div then
      # divsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5E)
      emit8(&mut ctx.text, 0xC1)
    when _ then ()
    end
    # Move xmm0 result back to GPR via stack: movsd [rsp-8], xmm0
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x11)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    emit_load_mem(ctx, dst, sp, -8)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Place-address primitive — CANONICAL place-addressing entry point.
#
# Computes the byte ADDRESS of `place` into register `dst`. For a
# zero-projection place this is the address of the local's storage; for a
# projected place it walks the projection chain, following pointer-typed
# (struct/collection/reference) intermediates by LOADING their stored value
# and applying the final projection as a pure offset so that the result is
# the address of the field/component slot itself.
#
# Every place-based operation is built on top of this single primitive so
# loads, stores, borrows and method receivers all agree on nested field
# addressing:
#   emit_load_place        = emit_place_address + dereference value
#   emit_store_place       = emit_place_address + store
#   emit_ref_place         = emit_place_address (a reference is an address)
#   emit_method_receiver   = emit_place_address (receiver borrows the place)
# ———————————————————————————————————————————————————————————————
def emit_place_address(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)

  if place.projections.is_empty() then
    # No projections: return stack address of the local.
    # Method intrinsics dereference &self once to obtain the underlying value.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        let spill_off = fctx.frame.spill_offset - 8
        fctx.frame.spill_offset = spill_off
        emit_store_mem(ctx, fp, spill_off, r)
        emit_lea_fp(ctx, dst, spill_off)
      when VarLoc::Stack(offset) then
        emit_lea_fp(ctx, dst, offset)
      when VarLoc::Spilled(offset) then
        emit_lea_fp(ctx, dst, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end
  else
    # Has projections (e.g. opts.input_files): load the local value,
    # apply all projections except the last one normally (load), and for
    # the last one compute the address without loading the value.
    # This way the intrinsic's single dereference of &self reaches the
    # correct heap object (e.g. Vec struct) rather than the parent struct.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then emit_mov_rr(ctx, dst, r)
      when VarLoc::Stack(offset) then emit_load_mem(ctx, dst, fp, offset)
      when VarLoc::Spilled(offset) then emit_load_mem(ctx, dst, fp, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end

    var current_ty = local_type(fctx, place.local.id)
    let n = place.projections.len()
    var downcast_variant: Option[VariantId] = Option::None
    var i = 0
    # Label to skip remaining projections after a payload-less inline-tag
    # Variant downcast (the EnumLayout's TaggedPtr encoding: a raw
    # discriminant below the threshold has no heap-allocated payload struct
    # to compute addresses into).
    let lbl_skip_addr = next_codegen_label(ctx, ".Lskip_addr_proj.")
    while i < n do
      let proj = place.projections[i]
      let is_last = i == n - 1
      # Downcast payload safety is handled in the Variant arm below.
      match proj
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        end
      end
      match proj
      when Projection::ProjDeref then
        if !is_last then
          emit_load_mem(ctx, dst, dst, 0)
        end
        current_ty = project_deref_type(ctx, &current_ty)
      when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type.
        let offset = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          emit_load_mem(ctx, dst, dst, offset as i32)
        end
        current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
      when Projection::TupleIndex(idx) then
        let offset = projected_tuple_offset(ctx, &current_ty, idx)
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          emit_load_mem(ctx, dst, dst, offset as i32)
        end
        current_ty = projected_tuple_type(ctx, &current_ty, idx)
      when Projection::ProjIndex(local_id) then
        let is_byte_indexed = is_string_like_type(ctx, &current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let idx_reg = scratch2_reg(ctx.target.arch)
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
        if !is_byte_indexed then
          # Scale the index by the element's TRUE storage stride — the
          # single codegen-side element-index scaler (1/2/4/8 shifts, a
          # multiply for any other stride — inline FixedArray elements).
          let elem_ty = project_index_type(ctx, &current_ty)
          let elem_stride = element_stride_bytes(ctx, &elem_ty)
          emit_scale_index(ctx, idx_reg, elem_stride)
        end
        emit_add_rrr(ctx, dst, dst, idx_reg)
        if !is_last then
          if is_byte_indexed then
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, 0)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::ProjConstantIndex(ci) then
        let is_byte_indexed = is_string_like_type(ctx, &current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let ci_elem_ty = project_index_type(ctx, &current_ty)
        let ci_stride = element_stride_bytes(ctx, &ci_elem_ty)
        let offset = if is_byte_indexed then ci else ci * ci_stride end
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          if is_byte_indexed then
            if offset != 0 then
              emit_add_ri(ctx, dst, offset as i32)
            end
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, offset as i32)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::Variant(vid) then
        downcast_variant = Option::Some(vid)
        # Same layout-driven payload rule as apply_projections: the
        # threshold and payload offset come from the enum's EnumLayout
        # (never codegen policy). The VariantId carries the enum OWNER +
 # the variant's DECLARATION index. the EnumLayout resolves
        # through the CONCRETE enum type (current_ty carries the Adt args).
        let pa_el = enum_layout_strict(ctx, &current_ty)
        match pa_el.representation
        when EnumValueRepresentation::TaggedPtr(threshold) then
          let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
          let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
          emit_cmp_ri(ctx, dst, threshold)
          emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
          emit_add_ri(ctx, dst, pa_el.payload_offset)
          emit_jmp(ctx, lbl_payload_done.clone())
          def_label(&mut ctx.text, lbl_payload_skip)
          # Inline tag: no heap payload exists. Materialize a safe stack-backed
          # sentinel address so downstream code never dereferences a null pointer.
          let null_off = fctx.frame.spill_offset - 8
          fctx.frame.spill_offset = null_off
          let zero = scratch_reg(ctx.target.arch)
          emit_zero_reg(ctx, zero)
          emit_store_mem(ctx, fp, null_off, zero)
          emit_lea_fp(ctx, dst, null_off)
          # If there are remaining projections after the downcast, skip them.
          # An inline tag has no heap-allocated payload struct, so subsequent
          # projections would dereference null and crash.
          if !is_last then
            emit_jmp(ctx, lbl_skip_addr.clone())
          end
          def_label(&mut ctx.text, lbl_payload_done)
        when EnumValueRepresentation::InlineTagged then
          # The value is the inline image: payload at payload_offset.
          emit_add_ri(ctx, dst, pa_el.payload_offset)
        when EnumValueRepresentation::Opaque then
          panic("ICE: emit_place_address: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
        end
      end
      i = i + 1
    end
    def_label(&mut ctx.text, lbl_skip_addr)
  end
end

# Resolve a struct field's declared byte offset by NAME (not position).
# The aggregate's operands are emitted in the struct-literal's stated order,
# which may differ from the type's declaration order. Positional indexing
# (offsets[i]) misplaces every field when the literal reorders fields, so we
# must map each operand to the declared offset of the field it names.
# the offsets table is CONCRETE-keyed — `ty` is the aggregate's
# concrete Type (Adt with args), so a generic struct literal (Wrapper[u8])
# resolves its field offsets through the Wrapper[u8] entry.
def struct_field_offset_by_name(ctx: CodegenCtx, ty: Type, field_name: String) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  let ckey = mir_type_identity_key(ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      var idx = 0
      while idx < fields.len() do
        if fields[idx].name == field_name then
          match ctx.type_field_offsets.get(ckey)
          when Option::Some(offsets) then
            if idx < offsets.len() then
              return offsets[idx]
            end
          when Option::None then ()
          end
          return -1
        end
        idx = idx + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  -1
end

# Load the VALUE of `place` into `dst`. For a zero-projection place this is a
# plain move/load of the local; for a projected place it composes the canonical
# address primitive with a single dereference of the final slot.
def emit_load_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  if place.projections.is_empty() then
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, dst, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, dst, fp, offset)
      end
    when Option::None then
      panic("emit_load_place: unknown local " + place.local.id.to_string())
    end
  else
    emit_place_address(ctx, fctx, place, dst)
    # Load exactly the final projected value's storage width. A
    # @packed-aggregate field at a MISALIGNED static offset (the
    # attributed layout's packed offsets) lowers through the byte-wise
    # UNALIGNED path — never a direct misaligned mov.
    let pty = place_type(ctx, fctx, place)
    let pwidth = storage_width_of(ctx, &pty)
    let pext = storage_signedness_of(&pty)
    if place_access_is_unaligned(ctx, fctx, place, pwidth) then
      emit_load_mem_sized_unaligned(ctx, dst, dst, pwidth, pext)
    else
      emit_load_mem_sized(ctx, dst, dst, 0, pwidth, pext)
    end
  end
end

# Store `src` into `place`. Computes the place address through the canonical
# primitive (preserving `src` across the address walk) and stores into it.
def emit_store_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  if place.projections.is_empty() then
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    when Option::None then
      panic("emit_store_place: unknown local " + place.local.id.to_string())
    end
  else
    # Compute the place address into a distinct register so popping `src`
    # does not clobber the computed base.
    let base = scratch2_reg(ctx.target.arch)
    emit_push(ctx, src)
    emit_place_address(ctx, fctx, place, base)
    emit_pop(ctx, src)
    # Store exactly the place's final storage width. A @packed-aggregate
    # field at a MISALIGNED static offset (the attributed layout's packed
    # offsets) lowers through the byte-wise UNALIGNED path — never a
    # direct misaligned mov.
    let pty = place_type(ctx, fctx, place)
    let pwidth = storage_width_of(ctx, &pty)
    if place_access_is_unaligned(ctx, fctx, place, pwidth) then
      emit_store_mem_sized_unaligned(ctx, base, src, pwidth)
    else
      emit_store_mem_sized(ctx, base, 0, src, pwidth)
    end
  end
end

# Take a reference (borrow) of `place`: a reference to a place is exactly its
# address. Used to lower MirRef.
def emit_ref_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  emit_place_address(ctx, fctx, place, dst)
end

# Compute the method receiver for a call on `place`. A method receiver is the
# borrow (&self / &mut self) of the receiver place, so it is the place address.
def emit_method_receiver(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  emit_place_address(ctx, fctx, place, dst)
end

def codegen_aggregate(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, kind: AggregateKind, operands: Vec[MirOperand], dst: PhysReg, agg_ty: Type) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = scratch2_reg(ctx.target.arch)
  let sp = sp_reg(ctx.target.arch)

  # Array literals must produce a Vec-compatible structure {data_ptr, len, cap}
  # so that for-loop iteration (ProjDeref + MirLen + ProjIndex) works correctly.
  match kind
  when AggregateKind::MirArray(arr_ty) then
    match arr_ty
    when Type::FixedArray(elem, n) then
      # Fixed-array literal: INLINE stores at i * stride — no heap. dst is
      # the BASE ADDRESS of the destination slot (the statement emitter
      # arranged it via emit_place_address); each operand is stored at
      # [dst + i * stride] with the element's storage width. A zero-length
      # array (n == 0) emits nothing.
      let fa_elem_size = layout_of_strict(&mut ctx.layout_engine, &elem).size
      let fa_elem_align = layout_of_strict(&mut ctx.layout_engine, &elem).align
      let fa_stride = align_up_int(fa_elem_size, fa_elem_align)
      let fa_width = storage_width_of(ctx, &elem)
      emit_push(ctx, dst)
      var op_idx = 0
      while op_idx < operands.len() do
        load_operand_aggregate_item(ctx, fctx, &operands[op_idx], scratch)
        emit_load_mem(ctx, dst, sp, 0)
        emit_store_mem_sized(ctx, dst, (op_idx * fa_stride) as i32, scratch, fa_width)
        op_idx = op_idx + 1
      end
      emit_load_mem(ctx, dst, sp, 0)
      emit_pop(ctx, scratch)
      return
    when _ then ()
    end
    # Heap-vector array literal: build through the same runtime path used by
    # Vec::new()+push. The header stride comes from the CONCRETE element
    # type of the literal (arr_ty = Array[T]).
    let lit_elem_ty = vec_elem_type_of(ctx, &arr_ty)
    let lit_stride = element_stride_bytes(ctx, &lit_elem_ty)
    emit_mov_ri(ctx, ret_reg(ctx.target.arch), lit_stride as i64)
    emit_call_label(ctx, "_tg_array_new")
    emit_push(ctx, dst)

    var op_idx = 0
    while op_idx < operands.len() do
      # The element crosses per its value category: Scalar -> the value
      # word; ScalarPair/ByAddress -> the element image ADDRESS (the
      # runtime byte-copies the full image). The slot is arg1 (x1/rsi).
      let lit_op_ty = operand_type(ctx, fctx, &operands[op_idx])
      let elem_slot = match arg_reg(ctx.target.arch, 1)
      when Option::Some(r) then r
      when Option::None then panic("codegen_aggregate: no element ABI slot register")
      end
      codegen_collection_elem_transfer_operand(ctx, fctx, &lit_op_ty, &operands[op_idx], elem_slot)
      emit_load_mem(ctx, dst, sp, 0)
      emit_call_label(ctx, "_tg_array_push")
      op_idx = op_idx + 1
    end

    emit_load_mem(ctx, dst, sp, 0)
    emit_pop(ctx, scratch)
    return
  when _ then ()
  end

  # Determine total size and per-field offsets based on the aggregate kind.
  # For named structs the aggregate carries the field NAMES in literal order;
  # codegen must resolve each operand to its DECLARED offset by name, because
  # the literal order may differ from the type declaration order.
 # the concrete aggregate type (agg_ty — the assign destination's
  # post-mono type, Type::Adt with args) keys every layout/offset lookup;
  # a generic struct literal (Wrapper[u8]) resolves through its own entry.
  let type_id = extract_named_type_id(ctx, agg_ty)
  let ckey = mir_type_identity_key(agg_ty)
  let struct_field_names = match kind
  when AggregateKind::Struct(_, names) then Option::Some(names)
  when _ then Option::None
  end

  # Look up the type name to detect collection types that need heap allocation
  var type_name = match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end

  # For collection types (Vec, Map, Set), use runtime heap allocation instead
  # of stack allocation.  These types must survive function returns, and their
  # runtime functions (e.g. _tg_array_push) expect the struct to live on the heap.
  if type_name == "Vec" || type_name == "Array" then
    # A struct LITERAL of type Vec/Array carries no element-type information
    # here (the AggregateKind has only the TypeId, not the Adt args), so the
    # element stride for _tg_array_new is unknowable. No source constructs
    # this shape (Vec/Array values come from the __intrinsic_array_* calls);
    # fail closed rather than fabricate a stride.
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete element type to derive the Vec stride from")
  else if type_name == "Map" || type_name == "HashMap" then
    # The runtime map contract needs the CONCRETE K/V layout parameters at
    # creation (map_new receives key_stride/key_align/value_stride/
    # value_align); a struct-literal aggregate carries only the TypeId, so
    # the layout is unknowable here. No source constructs this shape (Map
    # values come from the __intrinsic_map_* calls); fail closed rather
    # than fabricate a layout.
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete K/V layout to derive the map layout from")
  else if type_name == "Set" || type_name == "HashSet" then
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete element layout to derive the map layout from")
  end

  # Try to get field offsets from the type layout (CONCRETE-keyed)
  let has_layout = match ctx.type_field_offsets.get(ckey)
  when Option::Some(_) then true
  when Option::None then false
  end

  # Calculate total size. A missing layout for a concrete aggregate is a
  # compiler invariant violation — it must ICE, never guess 8 bytes/field.
  let total_size = match ctx.type_layout.get(ckey)
  when Option::Some(sz) then sz
  when Option::None then panic("codegen_aggregate: no layout recorded for type " + ckey)
  end
  let aligned = align_up_int(total_size, 8)

  # Heap-allocate struct data via bump allocator so the pointer survives
  # function returns.  Stack-allocating in the callee spill area would create
  # a dangling pointer when the struct escapes via return value.
  emit_mov_ri(ctx, dst, aligned as i64)
  emit_call_label(ctx, "_tg_bump_alloc")
  # After call: dst (x0/rax) = heap pointer to allocated memory. Preserve it
  # with a balanced stack push while operand lowering may make calls/clobber dst.
  emit_push(ctx, dst)

  # Store each field at its proper offset
  let enum_discriminant = if type_id >= 0 && is_enum_type_id(ctx, type_id) && operands.len() > 0 then
    match operands[0].kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(disc) then disc
      when _ then -1
      end
    when _ then -1
    end
  else
    -1
  end

  var i = 0
  while i < operands.len() do
    load_operand_aggregate_item(ctx, fctx, &operands[i], scratch)
    emit_load_mem(ctx, dst, sp, 0)
    let field_off = if enum_discriminant >= 0 then
      if i == 0 then
        0
      else
        # Payload base comes from the EnumLayout (the single enum
        # authority), never a hardcoded 8; the per-variant field offsets
        # are payload-relative from the same authority. The variant index
        # is derived from the operand's discriminant via the enum def
 # (declaration order — VariantId semantics). resolved
        # through the CONCRETE enum type (agg_ty carries the Adt args).
        enum_payload_base(ctx, agg_ty) + enum_field_offset_for_variant_index(ctx, agg_ty, enum_variant_index_of_discriminant(ctx, agg_ty, enum_discriminant), i - 1)
      end
    else if has_layout then
      # Named struct: resolve the declared offset of the field this operand names.
      # This is correct even when the literal lists fields in a different order
      # than the struct declaration (positional offsets[i] would misplace them).
      # A missing/unknown field or a missing layout is a compiler invariant
      # violation and must fail compilation, never fall back to `i * 8`.
      match struct_field_names
      when Option::Some(names) then
        let off = struct_field_offset_by_name(ctx, agg_ty, &names[i])
        if off >= 0 then off else panic("codegen_aggregate: unknown struct field '" + names[i] + "' for type " + ckey) end
      when Option::None then
        match ctx.type_field_offsets.get(ckey)
        when Option::Some(offsets) then
          if i < offsets.len() then offsets[i] else panic("codegen_aggregate: field index " + i.to_string() + " out of range for type " + ckey) end
        when Option::None then panic("codegen_aggregate: no field offsets for type " + ckey)
        end
      end
    else
      panic("codegen_aggregate: no layout for concrete aggregate of type " + ckey)
    end
    # Store exactly the field's storage width so adjacent narrow fields are not
    # corrupted by an 8-byte write. A @packed-aggregate field at a
    # MISALIGNED offset (the attributed layout's packed offsets) lowers
    # through the byte-wise UNALIGNED path — never a direct misaligned mov.
    let field_ty = operand_type(ctx, fctx, &operands[i])
    let field_width = storage_width_of(ctx, &field_ty)
    if (field_off % mem_width_bytes(field_width)) != 0 then
      # The aggregate base is 8/16-aligned; the field's own static offset
      # decides the alignment (the aggregate-literal store path carries no
      # runtime base, so the field offset alone is the check).
      emit_push(ctx, dst)
      emit_add_ri(ctx, dst, field_off as i32)
      emit_store_mem_sized_unaligned(ctx, dst, scratch, field_width)
      emit_pop(ctx, scratch)
    else
      emit_store_mem_sized(ctx, dst, field_off as i32, scratch, field_width)
    end
    i = i + 1
  end
  emit_load_mem(ctx, dst, sp, 0)
  emit_pop(ctx, scratch)
end

# ———————————————————————————————————————————————————————————————
# Statement code generation
# ———————————————————————————————————————————————————————————————

def codegen_statement(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, block: MirBlock, stmt_idx: Int) -> Unit
  let stmt = block.statements[stmt_idx]
  let rr = ret_reg(ctx.target.arch)
  match stmt.kind
  when MirStatementKind::MirAssign(place, MirRvalue { kind: rvalue_kind }) then
    var should_store = true
    match rvalue_kind
    when MirRvalueKind::MirPhi(pairs) then
      should_store = false

    when MirRvalueKind::MirMove(op) then
      # Whole-value moves/copies are classified by the value-category
      # authority (classify_value_category — the layout engine), never by a
      # register/8-byte-word guess:
      #   ZeroSized          -> no payload: nothing to copy
      #   Scalar(width)      -> one register word (the pre-existing path)
      #   ScalarPair(w1, w2) -> TWO words: the 16-byte raw UnsafeSlice view
      #                         { ptr, len } and other 16-byte aggregates
      #                         (the raw view keeps emitting exactly the
      #                         two-word copy it always has; the
      #                         single-register path would copy only the ptr
      #                         word and leave len stale)
      #   ByAddress(size)    -> a >16-byte inline aggregate (fixed arrays,
      #                         large structs): the full layout byte size is
      #                         copied — a 40-byte value is NOT an
      #                         eight-byte value
      # When a copy emitter runs, the trailing value store is skipped (rr no
      # longer carries the value).
      match classify_value_category(&mut ctx.layout_engine, &operand_type(ctx, fctx, op))
      when Result::Err(e) then
        panic("ICE: move/copy classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
      when Result::Ok(ValueCategory::ZeroSized) then
        should_store = false
      when Result::Ok(ValueCategory::Scalar(_)) then
        load_operand_rvalue_item(ctx, fctx, op, rr)
      when Result::Ok(ValueCategory::ScalarPair(_, _)) then
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      when Result::Ok(ValueCategory::Vector(w)) then
        # A SIMD vector value (the 16/32/64-byte vector row): the FULL
        # image is byte-copied — the vector never travels through the
        # scalar value register.
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      when Result::Ok(ValueCategory::ByAddress(sz)) then
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      end

    when MirRvalueKind::MirBinOp(bin_op, left, right) then
      codegen_binop(ctx, fctx, bin_op, left, right, rr)

    when MirRvalueKind::MirUnOp(un_op, operand) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, rr)
      when MirUnOp::Not    then
        emit_test_rr(ctx, rr, rr)
        emit_setcc(ctx, CondKind::Eq, rr)
      when MirUnOp::BitNot then emit_not(ctx, rr)
      end

    when MirRvalueKind::MirRef(ref_place) then
      emit_ref_place(ctx, fctx, ref_place, rr)

    when MirRvalueKind::MirAggregate(kind, operands) then
      # The FixedArray-typed aggregate (the dest-aware array-literal path)
      # is INLINE storage: the aggregate emitter stores each element at
      # i * stride into the DESTINATION SLOT directly, so rr must be the
      # place address and the trailing value store is skipped. Every other
      # aggregate (including the heap-vector array literal) keeps the
      # value-in-register path (codegen_aggregate — _tg_array_new +
      # _tg_array_push for the heap literal).
      let agg_is_fixed = match kind
      when AggregateKind::MirArray(arr_ty) then
        match arr_ty
        when Type::FixedArray(_, _) then true
        when _ then false
        end
      when _ then false
      end
      if agg_is_fixed then
        should_store = false
        emit_place_address(ctx, fctx, place, rr)
        codegen_aggregate(ctx, fctx, kind, operands, rr, &place_type(ctx, fctx, place))
      else
        codegen_aggregate(ctx, fctx, kind, operands, rr, &place_type(ctx, fctx, place))
      end

    when MirRvalueKind::MirDiscriminant(discr_place) then
      load_place(ctx, fctx, discr_place, rr)
      # Normalize via the enum's EnumLayout — the single enum-representation
 # authority (no codegen threshold policy). the CONCRETE enum
      # type (Adt args included) selects the layout.
      normalize_enum_value_to_tag(ctx, rr, &place_type(ctx, fctx, discr_place))

    when MirRvalueKind::MirLen(len_place) then
      let len_ty = place_type(ctx, fctx, len_place)
      match strip_receiver_ptr_like_type(&len_ty)
      when Type::FixedArray(_, n) then
        # Fixed arrays: the length is the compile-time count carried in the
        # TYPE — emit the constant, never a heap-header read.
        emit_mov_ri(ctx, rr, n as i64)
      when _ then
      if is_slice_view_type(ctx, &len_ty) then
        # UnsafeSlice[T] raw-view len: the len lives in the VIEW's second
        # word, not in a heap header. rr = the view base address (a plain
        # raw-view place is addressed directly; a &UnsafeSlice place derefs
        # its ref slot once), then read [base + len_off].
        emit_place_address(ctx, fctx, len_place, rr)
        if is_ref_like_type(&len_ty) then
          emit_load_mem(ctx, rr, rr, 0)
        end
        let slice_len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
        emit_load_mem(ctx, rr, rr, slice_len_off as i32)
      else
      load_place(ctx, fctx, len_place, rr)
      let len_value_ty = strip_receiver_ptr_like_type(&len_ty)
      emit_len_ref_derefs(ctx, rr, &len_ty)
      # The len field lives in the heap header — a valid header read only for
      # HeapVecHeader/HeapMapHeader/HeapSetHeader representations (offset from
      # the engine's container_field_offset). Behavior unchanged: the Adt
      # Array form is the heap-vector identity (the fixed arrays are the
      # distinct Type::FixedArray variant), so every array len is a header read.
      if is_heap_collection_type(ctx, &len_value_ty) then
        # Null collection pointers represent empty values in native bootstrap
        # paths; avoid dereferencing [0 + 8] and keep zero length.
        let lbl_len_done = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, rr, rr)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done.clone())
        emit_load_mem(ctx, rr, rr, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty), &"len".to_string()))
        def_label(&mut ctx.text, lbl_len_done)
      else
        emit_load_mem(ctx, rr, rr, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty), &"len".to_string()))
      end
      end
      end

    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
          let sp = sp_reg(ctx.target.arch)
          emit_store_mem(ctx, sp, -8, rr)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
          a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
          emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
        let target_bits = layout_of_strict(&mut ctx.layout_engine, target_ty).size * 8
        if target_bits < 64 then
          let mask = (1 << target_bits) - 1
          emit_and_ri(ctx, rr, mask as i32)
        end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_statement: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(operand, count) then
      let scratch = ret_reg(ctx.target.arch)
      load_operand_rvalue_item(ctx, fctx, operand, scratch)
      let rpty = operand_type(ctx, fctx, operand)
      let rpwidth = storage_width_of(ctx, &rpty)
      let rpstride = element_stride_bytes(ctx, &rpty)
      var i: UInt = 0
      while i < count do
        emit_store_mem_sized(ctx, rr, (i as Int * rpstride) as i32, scratch, rpwidth)
        i = i + 1
      end

    when _ then
      panic("codegen_statement: unsupported MIR rvalue kind")
    end

    if should_store then
      store_place(ctx, fctx, place, rr)
    end

  when MirStatementKind::MirStorageLive(_) then ()
  when MirStatementKind::MirStorageDead(_) then ()
  when MirStatementKind::MirNop then ()

  when MirStatementKind::MirContractCheck(contract, cond) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ok_label = ".Lcontract_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ne, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirBudgetConsume(resource, amount) then
    # REAL budget enforcement: the budget state lives in THIS invocation's
    # STACK FRAME (the slots allocate_locals reserved — FrameInfo's
    # budget_alloc_offset / budget_time_offset), never in global .data, so
    # two calls of the same budgeted function never share a counter, nested
    # and recursive budgeted calls each get their own frame slots, and
    # concurrent calls on per-thread stacks cannot race. The amount payload
    # is the function's DECLARED LIMIT for the resource (the typed budget's
    # bound); the limit exceeded -> the runtime traps (budget exhausted).
    let fp = fp_reg(ctx.target.arch)
    let scratch = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    if resource == "time" then
      # The time metric's exit check: elapsed = now - entry stamp (the
      # frame slot the __tg_budget_time_start record stamped at entry);
      # trap when elapsed exceeds the declared limit.
      if fctx.frame.budget_time_offset == 0 then
        # Fail-closed: a time consume in a function whose frame carries no
        # time slot is a lowering defect, never a silent [FP+0] write.
        emit_trap(ctx)
      else
        emit_call_direct(ctx, "__tg_clock_ns".to_string())
        emit_load_mem(ctx, scratch2, fp, fctx.frame.budget_time_offset)
        emit_sub_rrr(ctx, rr, rr, scratch2)
        emit_mov_ri(ctx, scratch, amount as i64)
        emit_cmp_rr(ctx, rr, scratch)
        let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
        ctx.fn_counter = ctx.fn_counter + 1
        emit_jcc(ctx, CondKind::Le, ok_label.clone())
        emit_trap(ctx)
        def_label(&mut ctx.text, ok_label)
      end
    elsif resource == "alloc" then
      # The allocation metric's consume: increment this invocation's
      # frame-slot counter by one; trap when it exceeds the limit.
      if fctx.frame.budget_alloc_offset == 0 then
        # Fail-closed: an alloc consume without a reserved frame slot is a
        # lowering defect (the slot scan is the authority), never a
        # silent [FP+0] write.
        emit_trap(ctx)
      else
        emit_load_mem(ctx, scratch2, fp, fctx.frame.budget_alloc_offset)
        emit_add_ri(ctx, scratch2, 1)
        emit_store_mem(ctx, fp, fctx.frame.budget_alloc_offset, scratch2)
        emit_mov_ri(ctx, rr, amount as i64)
        emit_cmp_rr(ctx, scratch2, rr)
        let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
        ctx.fn_counter = ctx.fn_counter + 1
        emit_jcc(ctx, CondKind::Le, ok_label.clone())
        emit_trap(ctx)
        def_label(&mut ctx.text, ok_label)
      end
    else
      # Any other resource the lowering never emits (the budget discipline
      # only constructs "alloc"/"time" consumes — budget_metric_enforced)
      # is a lowering defect: fail closed with a trap.
      emit_trap(ctx)
    end

  when MirStatementKind::MirEffectRecord(name, operand) then
    if name == "__tg_budget_time_start" then
      # REAL time-budget ENTRY: stamp THIS invocation's time slot (the
      # frame slot allocate_locals reserved) with the monotonic clock
      # (__tg_clock_ns — the clock_gettime runtime helper) — the exit
      # MirBudgetConsume("time", _) compares the elapsed clock against the
      # declared limit. Per-invocation semantics: the slot belongs to this
      # frame, so nested/recursive budgeted calls stamp their own slots.
      # (The fail-closed placeholder arm became the real check; the
      # __tg_effect_record effect LOG itself remains a trap stub — no
      # source lowering constructs effect records.)
      if fctx.frame.budget_time_offset == 0 then
        emit_trap(ctx)
      else
        let fp = fp_reg(ctx.target.arch)
        emit_call_direct(ctx, "__tg_clock_ns".to_string())
        emit_store_mem(ctx, fp, fctx.frame.budget_time_offset, rr)
      end
    else
      # Record an effect by pushing it to the effect log
      # Call __tg_effect_record(name_ptr, value)
      let scratch = scratch_reg(ctx.target.arch)
      
      # Load the effect value into result register
      load_operand_control_input(ctx, fctx, operand, rr)
      
      # Load effect name string address
      let name_label = intern_string(ctx, name)
      emit_lea_global(ctx, name_label, scratch)
      
      # Set up call arguments (ABI: scratch = name_ptr, rr = value)
      # Move arguments to proper registers for the call
      match arg_reg(ctx.target.arch, 0)
      when Option::Some(arg0) then
        match arg_reg(ctx.target.arch, 1)
        when Option::Some(arg1) then
          emit_mov_rr(ctx, arg0, scratch)
          emit_mov_rr(ctx, arg1, rr)
        when Option::None then ()
        end
      when Option::None then ()
      end
      
      # Call the runtime function
      emit_call_direct(ctx, "__tg_effect_record".to_string())
    end

  when MirStatementKind::MirEffectPerform(eid, op_index, op_name, payload_ptr, result_ptr) then
    # The algebraic-effects perform dispatch: call
    # __tg_effect_perform(effect_id, op_index, payload_ptr, result_ptr) —
    # the runtime walks the task's handler frames, invokes the innermost
    # matching handler's dispatcher (which writes the op's result into
    # *result_ptr) and returns; an unhandled operation aborts with the
    # defined error. The payload/result slots live in THIS frame (the
    # MirRef'd locals) — the synchronous dispatch reads/writes them.
    # Arguments are loaded into the ABI registers in reverse order so the
    # const loads never clobber an already-loaded operand.
    match arg_reg(ctx.target.arch, 3)
    when Option::Some(arg3) then
      load_operand_control_input(ctx, fctx, result_ptr, arg3)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 2)
    when Option::Some(arg2) then
      load_operand_control_input(ctx, fctx, payload_ptr, arg2)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 1)
    when Option::Some(arg1) then
      emit_mov_ri(ctx, arg1, op_index as i64)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 0)
    when Option::Some(arg0) then
      emit_mov_ri(ctx, arg0, eid.id as i64)
    when Option::None then ()
    end
    emit_call_direct(ctx, "__tg_effect_perform".to_string())

  when MirStatementKind::MirEffectFrameEnter(eid, op_count, bitmap, disp_name, env_ptr) then
    # Install a handler frame: call __tg_effect_frame_push(slot_ptr,
    # effect_id, op_count, handled_bitmap, dispatcher, env_ptr) — the
    # runtime writes the frame into THIS function's per-occurrence frame
    # slot (fctx.frame.effect_frame_offsets[this occurrence], consumed in
    # emission order — nested/sequential handle-with blocks each get their
    # own 48-byte slot) and links it onto the task's handler stack. The
    # dispatcher address is the MIR-synthesized handler function's label.
    if fctx.next_effect_frame >= fctx.frame.effect_frame_offsets.len() then
      emit_trap(ctx)
    else
      let slot_off = fctx.frame.effect_frame_offsets[fctx.next_effect_frame]
      fctx.next_effect_frame = fctx.next_effect_frame + 1
      let fp = fp_reg(ctx.target.arch)
      match arg_reg(ctx.target.arch, 5)
      when Option::Some(arg5) then
        load_operand_control_input(ctx, fctx, env_ptr, arg5)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 4)
      when Option::Some(arg4) then
        emit_lea_label(ctx, arg4, disp_name.clone())
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 3)
      when Option::Some(arg3) then
        emit_mov_ri(ctx, arg3, bitmap as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 2)
      when Option::Some(arg2) then
        emit_mov_ri(ctx, arg2, op_count as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 1)
      when Option::Some(arg1) then
        emit_mov_ri(ctx, arg1, eid.id as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 0)
      when Option::Some(arg0) then
        emit_add_ri(ctx, fp, slot_off)
        emit_mov_rr(ctx, arg0, fp)
        emit_add_ri(ctx, fp, -slot_off)
      when Option::None then ()
      end
      emit_call_direct(ctx, "__tg_effect_frame_push".to_string())
    end

  when MirStatementKind::MirEffectFrameExit then
    # Pop the innermost handler frame (the frame slot is reclaimed by the
    # epilogue).
    emit_call_direct(ctx, "__tg_effect_frame_pop".to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Terminator code generation
# ———————————————————————————————————————————————————————————————

def codegen_terminator(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, term: MirTerminator) -> Unit
  let rr = ret_reg(ctx.target.arch)
  # `term` is already a borrow (&MirTerminator); match on `term.kind` directly.
  # (lower_match now dereferences reference-typed scrutinees by type, so the
  # former `&term.kind` mis-dereference is fixed; covered by
  # tests/canary/test_canary_borrowed_enum.tg.)
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    load_operand_control_input(ctx, fctx, discr, rr)
    var target_idx = 0
    while target_idx < targets.len() do
      let sw = targets[target_idx]
      emit_cmp_ri(ctx, rr, sw.value as i32)
      let tgt_label = block_label_for(fctx, sw.target.id)
      emit_jcc(ctx, CondKind::Eq, tgt_label)
      target_idx = target_idx + 1
    end
    let def_label = block_label_for(fctx, default_target.id)
    emit_jmp(ctx, def_label)

  when MirTerminatorKind::MirReturn then
    codegen_epilogue(ctx, fctx)

  when MirTerminatorKind::MirUnreachable then
    emit_trap(ctx)

  when MirTerminatorKind::MirCall(dest, callee, args, success, unwind, intrinsic) then
    codegen_call(ctx, fctx, dest, callee, args, success, unwind, intrinsic)

  when MirTerminatorKind::MirDeinit(place, deinit_instance, target, unwind) then
    codegen_finalizer_call(ctx, fctx, &place, &deinit_instance)
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ck = if expected then CondKind::Ne else CondKind::Eq end
    let tgt_label = block_label_for(fctx, target.id)
    emit_jcc(ctx, ck, tgt_label)
    emit_trap(ctx)

  when MirTerminatorKind::MirAbort then
    emit_trap(ctx)
  when _ then
    panic("codegen_terminator: unsupported MIR terminator kind")
  end
end

# ———————————————————————————————————————————————————————————————
# ABI classification — the value-category model 
# ———————————————————————————————————————————————————————————————
# Both sides of the call boundary (arguments and results) are classified by
# the layout engine's SINGLE value-category authority
# (classify_value_category — ValueCategory), never by an ad-hoc
# register/8-byte-word size test. The category model:
#   ZeroSized           — no payload (Unit, Never, empty aggregates)
#   Scalar(width)       — ONE ABI slot of `width` bytes: the value itself
#                         travels in the slot (primitives of every width,
#                         pointers/handles, TaggedPtr-represented enums —
#                         their ONE pointer-width TaggedPtr word crosses
#                         regardless of the image size)
#   ScalarPair(w1, w2)  — a 16-byte value: two ABI slots (16-byte tuples/
#                         structs, the raw UnsafeSlice view, I128)
#   ByAddress(size)     — a >16-byte value: crosses BY ADDRESS (the slot
#                         carries the address; returns use sret)
# The SLOT rule stays mechanical (arg_reg(arch, index) Some/None picks the
# register or the caller's stack slot; the MIR lowering emits aggregate args
# as MirCallValue::Place, so the by-reference convention carries the
# aggregate's ADDRESS through the same slot a scalar of that index would
# use). Every ABI decision (call lowering, prologue binding, the sret
# decision, aggregate move/copy emission) is derived from this pair —
# nobody re-decides register/stack/indirect inline.
# FAIL-CLOSED: classify_value_category returns Result::Err for unresolved
# types (Var/Param/Error) — an internal compiler error here, never a
# silently assumed word.

# How a function result is delivered to the caller.
enum AbiReturn
  Direct         # returned in the value register (ret_reg)
  IndirectSret   # returned indirectly: callee writes the result at &dest (x8)
end

# The category-level sret eligibility: a function RESULT crosses indirectly
# (sret) exactly when its value category is ScalarPair (16-byte aggregate)
# or ByAddress (>16-byte aggregate). ZeroSized/Scalar results — primitives,
# pointers/handles, and TaggedPtr-represented enums (the enum VALUE is ONE
# pointer-width word, so it returns directly regardless of its image size) —
# never use sret. This is the single sret-candidate authority:
# classify_return (the caller side) and allocate_locals (the callee frame
# side) both read it, so the two ends can never disagree.
def category_uses_sret(cat: ValueCategory) -> Bool
  match cat
  when ValueCategory::ZeroSized then false
  when ValueCategory::Scalar(_) then false
  when ValueCategory::ScalarPair(_, _) then true
  # THE VECTOR CASE: the 16-byte vector crosses THROUGH THE REGISTERS
  # (never sret); the 32/64-byte vectors cross BY ADDRESS (memory/sret) —
  # the classifier emits ByAddress for them, so the only Vector category
  # that reaches here is the register-classified 16-byte form.
  when ValueCategory::Vector(_) then false
  when ValueCategory::ByAddress(_) then true
  end  end
end

# SINGLE authority for the sret policy on aggregate returns. A call result
# goes through sret (indirect return) exactly when:
#   - the result's value category is ScalarPair or ByAddress (the
#     category-level decision above — this REPLACES the former `size > 8`
#     test, which classified by nothing but the raw byte size),
#   - the destination is a plain local with no projections, and
#   - that local has a stable stack home the callee can write into
#     (AArch64 passes the indirect-return pointer via x8; x86-64 has no sret
#     here — the result crosses in the value register instead).
# classify_argument (AbiArg) is the paired authority on the ARGUMENT side of
# the ABI: the two functions together (classify_return + classify_argument)
# are the single classify pair that decides how every value crosses the call
# boundary.
def classify_return(inout ctx: CodegenCtx, fctx: FnCodegenCtx, dest: Place, ty: Type) -> AbiReturn
  match classify_value_category(&mut ctx.layout_engine, ty)
  when Result::Err(e) then
    panic("ICE: ABI return classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    if category_uses_sret(&cat) && dest.projections.is_empty() then
      match ctx.target.arch
      when Arch::AArch64 then
        match fctx.var_locs.get(dest.local.id)
        when Option::Some(loc) then
          match loc
          when VarLoc::Stack(_) then return AbiReturn::IndirectSret
          when VarLoc::Spilled(_) then return AbiReturn::IndirectSret
          when _ then ()
          end
        when Option::None then ()
        end
      when _ then ()
      end
    end
    AbiReturn::Direct
  end  end
end

# ———————————————————————————————————————————————————————————————
# ABI classification — arguments 
# ———————————————————————————————————————————————————————————————
# How a function ARGUMENT is delivered to the callee, as the first-class
# value-category distinction (the layout engine's ValueCategory decides the
# category; the slot index is carried so the caller/callee can place it):
enum AbiArg
  Scalar(Int, Int)     # one <width>-byte value in ABI slot <index>
  ScalarPair(Int, Int) # a 16-byte value: ABI slots <index> and <index + 1>
  # A SIMD VECTOR (the 16-byte vector row): the value crosses THROUGH THE
  # REGISTER SLOTS — the address travels in slot <index> (the by-reference
  # convention; the 128-bit payload lives in the memory image and the
  # intrinsic bodies work in the architectural vector registers q0-q7 /
  # xmm0-xmm7). <width> = the vector width (16). The 32/64-byte vectors
  # classify ByAddress (memory) at the classifier.
  Vector(Int, Int)     # SIMD vector in ABI slot <index>; <width> bytes
  ByAddress(Int, Int)  # a >16-byte value crossed BY ADDRESS: slot <index>
                       # carries the address; <size> = payload byte size
end

# SINGLE authority for the argument-passing convention, mirroring the
# argument placement the call lowering and the prologue have always used.
# The CATEGORY comes from the layout engine's classifier (primitives of all
# widths -> Scalar(width); pointers/String/heap-container handles -> Scalar
# (pointer width); TaggedPtr-represented enums -> Scalar(pointer size) — the
# enum's ONE pointer-width TaggedPtr word, asked of the EnumLayout;
# 16-byte aggregates -> ScalarPair; >16-byte aggregates -> ByAddress);
# the SLOT follows the index rule: an argument at index < max_reg_args(arch)
# travels in arg_reg(arch, index) (x0..x7 on AArch64, rdi..r9 on x86-64), an
# argument at index >= max_reg_args(arch) is pushed on the stack
# (caller-pops cleanup in codegen_call). Aggregate args (>8-byte payloads)
# are classified ScalarPair/ByAddress: the MIR lowering emits them as
# MirCallValue::Place, so the existing code passes the place ADDRESS through
# the same register/stack slot a scalar of that index would use — the
# by-reference convention is preserved byte-for-byte; only the MODEL is now
# category-explicit. The slot itself still follows the index rule above, so
# behavior is byte-identical.
# FAIL-CLOSED: an unresolved type (Var/Param/Error) reaching the classifier
# panics here — never a silently assumed word.
def classify_argument(inout ctx: CodegenCtx, ty: Type, index: Int) -> AbiArg
 # (the typed literal/view split): the MIR-internal static
  # StaticStrPtr of a string literal is an 8-byte raw pointer (the interned
  # label) — the same ABI slot a str value crosses. It is classified as a
  # scalar directly (never through the layout engine's aggregate path —
  # though the engine's own StaticStrPtr row, Repr::RawPtr — 8 bytes,
  # agrees): the view is a scalar pointer, exactly like the StringPtr
  # representation.
  match ty
  when Type::StaticStrPtr then
    return AbiArg::Scalar(index, ctx.target.pointer_size)
  when _ then ()
  end
  match classify_value_category(&mut ctx.layout_engine, ty)
  when Result::Err(e) then
    panic("ICE: ABI argument classification failed closed for type '" + e.type_name + "' at index " + index.to_string() + ": " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then AbiArg::Scalar(index, 0)
    when ValueCategory::Scalar(w) then AbiArg::Scalar(index, w)
    when ValueCategory::ScalarPair(_, _) then AbiArg::ScalarPair(index, index + 1)
    # THE VECTOR CASE: the 16-byte SIMD vector crosses through the
    # register slots (the vector class — never sret, never memory).
    when ValueCategory::Vector(w) then AbiArg::Vector(index, w)
    when ValueCategory::ByAddress(sz) then AbiArg::ByAddress(index, sz)
    end
  end
end

# The static type of a call argument (Place args are passed by reference —
# the ADDRESS is the value that crosses the boundary).
def mir_call_arg_type(ctx: CodegenCtx, fctx: FnCodegenCtx, arg: MirCallArg) -> Type
  match arg.value
  when MirCallValue::Value(op) then operand_type(ctx, fctx, &op)
  when MirCallValue::Place(p) then place_type(ctx, fctx, &p)
  end  end
end

# Position of the `$` that separates a monomorphized instance name's base
# from its mangled type arguments ("Option__map$i64_str" → 12), or -1 when
# the name carries no instance suffix.
def find_instance_dollar(name: String) -> Int
  var i = 0
  while i < name.len() do
    if name.slice(i, i + 1) == "$" then
      return i
    end
    i = i + 1
  end
  -1
end

# ———————————————————————————————————————————————————————————————
# CALLEE-LABEL RESOLUTION — the single authority 
#
# resolve_callee_label translates a callable NAME to the machine label to
# emit at the call site, or it is an internal error. The callable identity
# flows:
#
#   name (MirFnItem operand)
#     -> typed call_targets DefId      (the typed program)
#     -> monomorphized instance name   (the monomorphizer: generic callees
#                                       are rewritten to `$`-suffixed
#                                       instance names, e.g. "Option__map$i64_str")
#     -> fn_alias label                (codegen_program: ".Lfn_entry.<index>")
#
# InstanceId { def, substs } is the target representation that REMOVES the
# string stage: the name string is a rendering of that identity pair, and
# fn_alias is its codegen-side index. Until the DefId/substs pair reaches
# codegen, this function is the one authority for "this callable name
# resolves to this machine label or it is an internal error" — every emitted
# compiled call (codegen_call's compiled-function path, codegen_call's alias
# fallback, codegen_finalizer_call's emission) funnels through it. The
# intrinsic call path is the paired authority on the other side of
# codegen_call's dispatch: the semantic intrinsic router (classify_
# intrinsic_call — types.tg) owns intrinsic names and rejects unknown
# ones; resolve_callee_label owns compiled callables. No callable name
# escapes both.
#
# Resolution order:
#   1. fn_alias — the identity entry (".Lfn_entry.<index>") for every emitted
#      function, plus the bare/canonical alias entries.
#   2. reachable_fns / extern_fns — the function is emitted under its own
#      symbol name (safety net; identity entries make this unreachable).
#   3. FAIL CLOSED — panic. Instance-aware verification first: if the name is
#      the BASE of a monomorphized generic (a `$`-suffixed instance of it
#      exists), the call site was never rewritten to an instance name — a
#      monomorphization-identity leak, reported as such.
# the call references arriving here are the DefId-derived emission
# names (MirFnItem names from the call's InstanceId, matching the callee's
# MirFunction.name), so the identity entry resolves them directly. The
# name-based paths that remain are the linking boundary (extern symbols,
# intrinsic names, the OS-entry "main"/"_start") and the "Type__method"
# method names — all emitted under those exact names, all resolvable here.
def resolve_callee_label(ctx: CodegenCtx, name: String) -> String
  match ctx.fn_alias.get(name)
  when Option::Some(label) then label.clone()
  when Option::None then
    if ctx.reachable_fns.contains(name) || ctx.extern_fns.contains(name) then
      name.clone()
    else
      if ctx.generic_instance_bases.contains(name) then
        panic("internal error: call to `" + name + "` is an unresolved generic BASE name; the monomorphizer must rewrite this call site to a `$`-suffixed instance name (InstanceId { def, substs } replaces this string stage) — no instance label exists")
      end
      panic("internal error: call to `" + name + "` is not a reachable function, an extern, or a known intrinsic (unresolved callee)")
    end
  end  end
end

def codegen_call(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, dest: Place, callee: MirOperand, args: Vec[MirCallArg], success: MirBlockId, unwind: Option[MirBlockId], intrinsic: Option[IntrinsicId]) -> Unit
  let arch   = ctx.target.arch
  let rr     = ret_reg(arch)
  let scratch = scratch2_reg(arch)
  let sp     = sp_reg(arch)
  let max_ra = max_reg_args(arch)

  var arg_ops = Vec::new()
  var arg_idx_build = 0
  while arg_idx_build < args.len() do
    arg_ops.push(mir_call_arg_operand(&args[arg_idx_build]))
    arg_idx_build = arg_idx_build + 1
  end

  # sret eligibility is decided by classify_return — the single authority on
  # whether an aggregate return is passed indirectly (see AbiReturn above).
  # When eligible we pass &dest in x8 to the callee (which uses sret) and
  # skip storing rr. The stack-home offset below is a mechanical lookup, not
  # a policy decision.
  let dest_ty = place_type(ctx, fctx, dest)
  var sret_dest_off: i32 = 0
  var sret_dest_ok = false
  if classify_return(ctx, fctx, dest, &dest_ty) == AbiReturn::IndirectSret then
    match fctx.var_locs.get(dest.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Stack(off) then
        sret_dest_off = off
        sret_dest_ok = true
      when VarLoc::Spilled(off) then
        sret_dest_off = off
        sret_dest_ok = true
      when _ then ()
      end
    when Option::None then ()
    end
  end
  # The drain helpers (_tg_map_drain_one / _tg_set_drain_one) deliver their
  # result through x8 — a fixed RUNTIME-ABI property of those helpers
  # (disc@0, key@8, value@8 + t_v_off — the runtime writes the enum IMAGE
  # at the buffer, never a TaggedPtr word), so classify_return — which
  # classifies Option/Result as Scalar (their ONE pointer-width TaggedPtr
  # word) — cannot gate the x8 setup for them. Resolve the same stack home
  # here so the drain call sites can always set up the buffer.
  var drain_dest_off: i32 = 0
  var drain_dest_ok = false
  if !sret_dest_ok then
    match fctx.var_locs.get(dest.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Stack(off) then
        drain_dest_off = off
        drain_dest_ok = true
      when VarLoc::Spilled(off) then
        drain_dest_off = off
        drain_dest_ok = true
      when _ then ()
      end
    when Option::None then ()
    end
  end
  var did_sret = false
  # The intrinsic arms that materialize the FULL result image into the
  # destination place themselves (the ArrayGet/ArrayRemove ScalarPair/
  # ByAddress paths) report it through codegen_intrinsic's Bool result;
  # the post-call register store is then suppressed.
  var intrinsic_did_materialize = false

  # Place arguments in reverse order. Loading a projected operand may use x0/rax
  # as scratch, so left-to-right loading can clobber an already prepared arg0.
  # The category of every argument comes from the single authority
  # classify_argument (AbiArg) — the ABI half of the review's
  # classify_argument/classify_return pair — which classifies through the
  # layout engine's value-category model (Scalar/ScalarPair/ByAddress).
  # ScalarPair and ByAddress aggregates keep the by-reference convention:
  # their ADDRESS travels in the same slot a scalar of this index would use
  # (arg_reg is Some exactly while index < max_ra, so the Some/None test
  # below IS the register-count rule). Behavior is byte-identical to the
  # former Register/Stack/Indirect split.
  let total_args = args.len()
 # (the closure {code, env} ABI): a CLOSURE-VALUE callee (an indirect
  # operand whose type is Type::Closure) dispatches through the closure
  # OBJECT — the value is a pointer to the registered { code @ 0,
  # env: capture-tuple } image. The generated closure function takes the
  # CAPTURE VALUES as its leading parameters, so the explicit call args
  # shift right by the capture count (every slot index below is offset by
  # closure_shift when the callee is a closure value).
  var closure_shift = 0
  var closure_cap_tys: Vec[Type] = Vec::new()
  var closure_callee_ty: Option[Type] = Option::None
  match callee.kind
  when MirOperandKind::MirCopy(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirMovePlace(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirRead(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirConsume(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when _ then ()
  end
 # (the closure {code, env} ABI): for a CLOSURE-VALUE callee, the
  # [ptr, code] pair is preserved on the stack BEFORE the explicit arg
  # loop so the whole pushed area (pair, explicit stack args, capture
  # stack args) stays in ascending slot order from the callee's frame.
  var closure_ptr_depth = 1
  match closure_callee_ty
  when Option::Some(_) then
    let cl_slot_size0 = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    match callee.kind
    when MirOperandKind::MirCopy(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirMovePlace(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirRead(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirConsume(place) then load_place(ctx, fctx, &place, rr)
    when _ then ()
    end
    emit_push(ctx, rr)
    emit_load_mem(ctx, rr, rr, 0)
    emit_push(ctx, rr)
  when Option::None then ()
  end
  var arg_idx = total_args
  while arg_idx > 0 do
    arg_idx = arg_idx - 1
    let arg = args[arg_idx]
    let arg_ty = mir_call_arg_type(ctx, fctx, &arg)
    let slot_idx = arg_idx + closure_shift
    match classify_argument(ctx, &arg_ty, slot_idx)
    when AbiArg::Scalar(_, _) then
      # One <width>-byte value in the slot.
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::ScalarPair(_, _) then
      # A 16-byte aggregate (a two-slot value) — crossed by reference: the
      # ADDRESS travels in the single slot.
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::Vector(_, _) then
      # THE VECTOR CASE: a 16-byte SIMD vector — crossed by reference
      # through the register slots (the address travels in the slot; the
      # 128-bit payload stays in the memory image).
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::ByAddress(_, _) then
      # A >16-byte aggregate — the slot carries the ADDRESS (by reference).
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    end
  end

  # The closure dispatch's [ptr, code] pair was preserved BEFORE the
  # explicit arg loop; the explicit STACK args were pushed on top of the
  # pair, so the closure pointer now sits at depth 1 + the pushed explicit
  # stack args. The cleanup below and the dispatch share this count.
  let eff_total_args = total_args + closure_shift
  if eff_total_args > max_ra then
    closure_ptr_depth = 1 + (eff_total_args - max_ra)
  end

  # Call the function
  match callee.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFnItem(fn_name) then
      # For dot-prefixed method names (.keys,.is_empty, etc.),
      # resolve using the receiver argument's type
      var resolved_fn_name = fn_name.clone()
      if fn_name.len() > 1 && fn_name.slice(0, 1) == "." then
        resolved_fn_name = resolve_dot_method(ctx, fctx, fn_name, &arg_ops)
      end
      let intr_name = bare_intrinsic_name(&resolved_fn_name)
 # (IntrinsicId at check time): the ONE semantic classification —
      # types.tg's semantic router (the same classification the type
      # checker attaches at call-recording time — intrinsic_id_of_call
      # over the TYPED operand facts). Option::None = the name is NOT an
      # intrinsic name. The former name-shape gates (the codegen
      # name tables) are GONE: the classification decides.
      let recv_ty0 = if arg_ops.len() > 0 then strip_ref_like_type(&operand_type(ctx, fctx, &arg_ops[0])) else Type::Unit end
      let recv_named0 = match recv_ty0
      when Type::Adt(ri_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ri_tid.id))
      when _ then "".to_string()
      end
      let needle_ty0 = if arg_ops.len() > 1 then operand_type(ctx, fctx, &arg_ops[1]) else Type::Unit end
      let needle_named0 = match strip_ref_like_type(&needle_ty0)
      when Type::Adt(ni_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ni_tid.id))
      when _ then "".to_string()
      end
      let recv_is_string0 = if arg_ops.len() > 0 then is_string_operand(&arg_ops[0], fctx) else false end
      let needle_is_string0 = if arg_ops.len() > 1 then
        is_string_operand(&arg_ops[1], fctx) ||
        is_string_like_type(ctx, &needle_ty0) ||
        is_string_like_type(ctx, &strip_ref_like_type(&needle_ty0))
      else
        false
      end
 # (IntrinsicId through MirCall): the STAMPED id — the lowering
      # read the checker's typed_intrinsics at the SOURCE call sites and
      # stamped the MirCall — is the authority. The semantic router
      # (intrinsic_id_of_call over the typed operand facts) is the
      # fallback ONLY for the compiler-SYNTHESIZED calls, which construct
      # their own names and carry Option::None here.
      let intr_opt = match intrinsic
      when Option::Some(stamped_id) then Option::Some(stamped_id)
      when Option::None then intrinsic_id_of_call(&intr_name, &recv_ty0, &recv_named0, &needle_ty0, &needle_named0, &resolved_fn_name, recv_is_string0, needle_is_string0)
      end
      let has_real_body =
        ctx.extern_fns.contains(&resolved_fn_name) ||
        ctx.reachable_fns.contains(&resolved_fn_name)
 # boundary between the two call-identity authorities: has_real_body
      # is the intrinsic path's PRESENCE test against the compiled-callable
      # namespace (reachable_fns/extern_fns). It deliberately does NOT resolve
      # a label — intrinsic names are owned by the semantic router
      # (classify_intrinsic_call) and must not panic here. Label resolution
      # for compiled callables happens only in the compiled and alias
      # branches below, via resolve_callee_label — the single authority. No
      # name escapes both: intrinsic names fail classify_intrinsic_call with
      # a panic, compiled names fail resolve_callee_label with a panic.
      let fallback_clone_intrinsic =
        !has_real_body &&
        resolved_fn_name.len() >= 7 &&
        resolved_fn_name.slice(resolved_fn_name.len() - 7, resolved_fn_name.len()) == "__clone"
      # The atomic builtins (try_emit_atomic_builtin) emit first; a
      # CLASSIFIED intrinsic name then inlines through the semantic
      # router's decision; everything else resolves against the compiled
      # namespace (extern/reachable/fn_alias) through the single authority
      # resolve_callee_label.
      if try_emit_atomic_builtin(ctx, &resolved_fn_name) then
        ()
      else
        match intr_opt
        when Option::Some(iid) then
          # Intrinsic path — the SEMANTIC classification decides (a
          # classified intrinsic name inlines; the String__new / cstring
          # special cases are the router's StringNew / CStringNew arms).
          # Only the DRAIN intrinsics write their aggregate result through
          # the sret slot (the runtime fills disc + payload at &dest in
          # x8). Other aggregate-returning intrinsics (e.g. map_entries ->
          # Vec) return in the value register and must keep the post-call
          # store.
          if iid == IntrinsicId::MapDrainOne || iid == IntrinsicId::SetDrainOne then
            # Drain runtime contract: the helper writes its result IMAGE at
            # &dest (AArch64: x8; x86-64: r8 — the drain sret register) — a
            # runtime-ABI property, independent of the result type's value
            # category (see drain_dest_ok above).
            let drain_sret = match arch
            when Arch::AArch64 then PhysReg::A64Reg(A64::X8)
            when Arch::X86_64  then PhysReg::X64Reg(X64::R8)
            end
            if sret_dest_ok then
              emit_lea_fp(ctx, drain_sret, sret_dest_off)
              did_sret = true
            else if drain_dest_ok then
              emit_lea_fp(ctx, drain_sret, drain_dest_off)
              did_sret = true
            end
          end
          intrinsic_did_materialize = codegen_intrinsic(ctx, fctx, intr_name, &arg_ops, args, resolved_fn_name, &dest_ty, dest)
          # The drain helpers wrote the enum IMAGE at &dest; re-encode it as
          # the TaggedPtr VALUE word (codegen_drain_result_materialize) so
          # every consumer — MirDiscriminant, is_some, the Variant payload
          # projections, the drop-glue plan walk — agrees with the category
          # model.
          if (iid == IntrinsicId::MapDrainOne || iid == IntrinsicId::SetDrainOne) && did_sret then
            let drain_materialize_off = if sret_dest_ok then sret_dest_off else drain_dest_off end
            codegen_drain_result_materialize(ctx, fctx, &dest_ty, drain_materialize_off)
          end
        when Option::None then
          if fallback_clone_intrinsic then
            intrinsic_did_materialize = codegen_intrinsic(ctx, fctx, "clone", &arg_ops, args, resolved_fn_name, &dest_ty, dest)
          else if ctx.extern_fns.contains(&resolved_fn_name) then
            emit_call_extern(ctx, resolved_fn_name)
            # The extern ABI boundary: a C `int` return arrives in the low
            # 32 bits of the return register (eax/w0) with unspecified
            # upper bits — normalize (sign/zero-extend) before the
            # post-call store so a C -1 reads as -1 (see
            # normalize_extern_return).
            normalize_extern_return(ctx, rr, &dest_ty)
          else if ctx.reachable_fns.contains(&resolved_fn_name) then
 # Function has a compiled body — call it directly. the callee
            # identity flow is verified here — for a generic callee this name is
            # the MONOMORPHIZED instance name (the monomorphizer rewrote the call
            # site to e.g. "Option__map$i64_str"), and fn_alias maps that exact
            # instance name to the emitted body's label. The label itself comes
            # from the single authority resolve_callee_label.
            let resolved = resolve_callee_label(ctx, &resolved_fn_name)
            if sret_dest_ok then
              # Pass &dest in x8 for sret-returning callee
              emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
              did_sret = true
            end
            emit_call_label(ctx, resolved)
          else
 # verification layer: at this point the callee is NOT an
            # extern, NOT a lowered reachable function, and NOT a known
            # intrinsic — all of those were handled above. The single authority
            # resolve_callee_label handles the only legitimate remaining case
            # (an fn_alias entry mapping this reference to an emitted function
            # label — bare/canonical aliases of compiled functions) and panics
            # fail-closed otherwise. An unknown callee is a compiler error, never
            # a silent call to a possibly-nonexistent label; every emitted call
            # therefore goes through the resolved-name check, and generic
            # callees carry the instance names ("Option__map$i64_str") that the
            # monomorphizer produced and fn_alias maps to labels.
            let resolved = resolve_callee_label(ctx, &resolved_fn_name)
            if sret_dest_ok then
              emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
              did_sret = true
            end
            emit_call_label(ctx, resolved)
          end
        end
      end
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  when MirOperandKind::MirCopy(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirMovePlace(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirRead(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirConsume(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  end

  # Clean up stack args — the closure dispatch pushed the shifted stack
  # args (total_args + closure_shift slots), so the pop count matches.
  if eff_total_args > max_ra then
    let stack_arg_slot = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    emit_add_ri(ctx, sp, ((eff_total_args - max_ra) * stack_arg_slot) as i32)
  end

  # Store return value — the post-call store. The intrinsic arms that
  # materialized the FULL result image into dest themselves reported it
  # (intrinsic_did_materialize) and skip this register store.
  if !did_sret && !intrinsic_did_materialize then
    store_place(ctx, fctx, dest, rr)
  end
end

# (the closure {code, env} ABI): the INDIRECT-callee dispatch for a
# callee operand that is a place-like value. A CLOSURE-VALUE callee (the
# operand's type is Type::Closure — the closure object, registered by its
# ClosureId) dispatches through the closure OBJECT: the value is a pointer
# to the registered { code @ 0, env: capture-tuple } image (the object's
# field offsets live in ctx.type_field_offsets under the closure type's
# concrete identity key). The code pointer is loaded from [ptr + 0]; the
# capture VALUES are loaded from the env fields into the LEADING argument
# slots (the generated closure function takes the capture values as its
# leading params — the explicit call args were loaded at the shifted slots
# by codegen_call's arg loop), and the code pointer is called. The [ptr,
# code] pair is preserved on the stack while the capture loads clobber
# registers. Every other place-like callee (a plain fn pointer) is loaded
# and called directly.
def codegen_indirect_callee(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, callee: MirOperand, closure_shift: Int, closure_cap_tys: Vec[Type], closure_callee_ty: Option[Type]) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let scratch = scratch2_reg(arch)
  let sp = sp_reg(arch)
  match closure_callee_ty
  when Option::Some(cl_ty) then
    let cl_key = mir_type_identity_key(cl_ty)
    let cl_offsets = match ctx.type_field_offsets.get(cl_key.clone())
    when Option::Some(offs) then offs.clone()
    when Option::None then panic("codegen_call: no closure-object layout recorded for " + cl_key)
    end
    let cl_slot_size = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    # The [ptr, code] pair was preserved by codegen_call BEFORE the
    # explicit arg loop (the pair sits BELOW the pushed arg area); the
    # closure pointer is reloaded per capture at the CURRENT depth ([sp +
    # slot * ptr_depth] — each pushed capture shifts sp). The STACK
    # captures (slots >= max_ra) push in DESCENDING slot order so the
    # whole stack arg area (pair, explicit args, captures) is laid out in
    # ascending slot order from the callee's frame — the same discipline
    # the explicit loop follows.
    var cap_i = closure_cap_tys.len()
    var ptr_depth = closure_ptr_depth
    while cap_i > 0 do
      cap_i = cap_i - 1
      let cap_off = if cap_i + 1 < cl_offsets.len() then cl_offsets[cap_i + 1] else 0 end
      emit_load_mem(ctx, scratch, sp, (cl_slot_size * ptr_depth) as i32)
      match classify_argument(ctx, &closure_cap_tys[cap_i], cap_i)
      when AbiArg::Scalar(_, _) then
        match arg_reg(arch, cap_i)
        when Option::Some(reg) then emit_load_mem(ctx, reg, scratch, cap_off as i32)
        when Option::None then emit_load_mem(ctx, scratch, scratch, cap_off as i32); emit_push(ctx, scratch); ptr_depth = ptr_depth + 1
        end
      when _ then
        # ScalarPair/ByAddress captures cross by reference: the field ADDRESS.
        emit_add_ri(ctx, scratch, cap_off as i32)
        match arg_reg(arch, cap_i)
        when Option::Some(reg) then emit_mov_rr(ctx, reg, scratch)
        when Option::None then emit_push(ctx, scratch); ptr_depth = ptr_depth + 1
        end
      end
    end
    emit_pop(ctx, rr)
    emit_pop(ctx, scratch)
    emit_call_r(ctx, rr)
  when Option::None then
    load_place(ctx, fctx, place, rr)
    emit_call_r(ctx, rr)
  end
end

def load_operand_aggregate_item(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_operand_call_arg(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_call_arg_value(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, arg: MirCallArg, dst: PhysReg) -> Unit
  match arg.value
  when MirCallValue::Value(op) then load_operand_call_arg(ctx, fctx, op, dst)
  when MirCallValue::Place(p) then emit_place_address(ctx, fctx, p, dst)
  end  end
end

def load_operand_rvalue_item(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_operand_binop_input(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_operand_control_input(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirRead(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConsume(place) then
    load_place(ctx, fctx, place, dst)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirUnit then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirBool(b) then
      if b then
        emit_mov_ri(ctx, dst, 1)
      else
        emit_zero_reg(ctx, dst)
      end
    when MirConstantKind::MirInt(i) then
      emit_mov_ri(ctx, dst, i as i64)
    when MirConstantKind::MirFloat(f) then
      let bits = f.to_bits() as i64
      emit_mov_ri(ctx, dst, bits)
      let sp = sp_reg(ctx.target.arch)
      emit_store_mem(ctx, sp, -8, dst)
      emit_load_fp_from_stack(ctx, dst, sp, -8)
    when MirConstantKind::MirChar(c) then
      emit_mov_ri(ctx, dst, c as i64)
    when MirConstantKind::MirString(s) then
      let label = intern_string(ctx, s)
      emit_lea_label(ctx, dst, label)
    when MirConstantKind::MirFnItem(fn_name) then
      emit_lea_label(ctx, dst, fn_name.clone())
    when MirConstantKind::MirZeroSized then
      emit_zero_reg(ctx, dst)
    when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
      # static label table (the name-side symbol-table registration).
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
      emit_load_mem(ctx, dst, dst, 0)
    when MirConstantKind::MirStaticAddr(did) then
      let label = resolve_static_label(ctx, did)
      emit_lea_label(ctx, dst, label.clone())
    end
  end  end
end

def load_place(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(r) then
      if place.projections.is_empty() then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      else
        emit_mov_rr(ctx, dst, r)
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Stack(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    when VarLoc::Spilled(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, place, &place.projections, dst)
      end
    end
  when Option::None then
    println("[codegen] load_place unknown local=" + place.local.id.to_string() + " func=" + fctx.func.name + " projections=" + place.projections.len().to_string())
    panic("load_place: unknown local " + place.local.id.to_string())
  end
end

# Get the TypeId from a local's type, returns -1 if not a Named type.
# Extract the TypeId from a type, unwrapping through Ref/RefMut
def extract_named_type_id(ctx: CodegenCtx, ty: Type) -> Int
  match ty
  when Type::Adt(tid, args) then
 # Adt form of Box/Rc mirrors the canonical unwrap arms
    # (recurse through the Adt args); other Adt types return their id.
    let ent_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if (ent_named == "Box" || ent_named == "Rc") && !args.is_empty() then
      extract_named_type_id(ctx, &args[0])
    else
      tid.id
    end
  when Type::RefInternal(inner, _) then extract_named_type_id(ctx, &inner)
  when Type::Ptr(inner) then extract_named_type_id(ctx, &inner)
  when Type::PtrMut(inner) then extract_named_type_id(ctx, &inner)
  when _ then -1
  end  end
end

def type_name_by_id(ctx: CodegenCtx, type_id: Int) -> String
  if type_id < 0 then return "" end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end
end

def project_deref_type(ctx: CodegenCtx, ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner.clone()
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when Type::Adt(tid, args) then
 # Adt form of Box/Rc mirrors the canonical unwrap arms
    # (pointee via the Adt args); anything else passes through unchanged.
    let pdt_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if (pdt_named == "Box" || pdt_named == "Rc") && !args.is_empty() then
      args[0].clone()
    else
      ty.clone()
    end
  when other then other.clone()
  end  end
end

def type_is_unit(ty: Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end  end
end

def emit_len_ref_derefs(inout ctx: CodegenCtx, reg: PhysReg, ty: Type) -> Unit
  var current_ty = ty.clone()
  while is_ref_like_type(&current_ty) do
    let inner_ty = project_deref_type(ctx, &current_ty)
    let value_ty = strip_receiver_ptr_like_type(&inner_ty)
    if is_heap_collection_type(ctx, &value_ty) || type_is_unit(&inner_ty) || type_is_unit(&value_ty) then
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = inner_ty
    else
      return
    end
  end
end

def project_index_type(ctx: CodegenCtx, ty: Type) -> Type
  match ty
  when Type::String then Type::Char
  when Type::FixedArray(elem, _) then elem.clone()
  when Type::Adt(tid, args) then
 # Adt form of Slice/Box/Rc mirrors the canonical arms
    # (element via the Adt args / unwrap recurse); the pre-existing name
    # chain keeps covering Vec/Array/Map/Set in their Adt storage forms.
    let qualified = type_name_by_id(ctx, tid.id)
    let type_name = bare_name_from_qualified(qualified)
    if (type_name == "UnsafeSlice") && !args.is_empty() then
      args[0].clone()
    else if (type_name == "Slice") && !args.is_empty() then
      # The SAFE source-spelled Slice (the std-declared shared struct):
      # the element is its type argument (the index reads through the Arc
      # deref — see the ProjIndex arm).
      args[0].clone()
    else if (type_name == "Box" || type_name == "Rc") && !args.is_empty() then
      project_index_type(ctx, &args[0])
    else if (type_name == "Vec" || type_name == "Array") && !args.is_empty() then
      args[0].clone()
    else if (type_name == "Map" || type_name == "HashMap") && args.len() >= 2 then
      args[1].clone()
    else if (type_name == "Set" || type_name == "HashSet") && !args.is_empty() then
      args[0].clone()
    else
      Type::Unit
    end
  when Type::RefInternal(inner, _) then project_index_type(ctx, inner)
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when _ then Type::Unit
  end  end
end

# the type of a Field(FieldId) projection, resolved from the
# FieldId's OWNER type def — a struct field (owner struct TypeId) or a
# variant-payload field (owner enum TypeId, reached through the ACTIVE
# Variant(VariantId) downcast; the index is the payload field index).
# `ty` is the CONCRETE type being projected (the place's current
# type — Type::Adt(tid, args)); the def-level field type is SUBSTITUTED
# under its args (substitute_in_concrete_adt), so a generic def's field
# yields the concrete field type — never a Param and never a placeholder.
def projected_field_type(ctx: CodegenCtx, fid: FieldId, downcast_variant: Option[VariantId], ty: Type) -> Type
  # Defensive: the projected type may arrive ref-wrapped — substitution keys
  # on the VALUE type's concrete Adt.
  let value_ty = strip_ref_like_type(ty)
  match lookup_type_def(ctx, fid.owner.id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      if fid.index < fields.len() then
        substitute_in_concrete_adt(&ctx.layout_engine, &value_ty, &fields[fid.index].ty)
      else
        Type::Unit
      end
    when MirTypeDefKind::Enum(variants) then
      match downcast_variant
      when Option::Some(vid) then
        if vid.owner.id == fid.owner.id && vid.index < variants.len() then
          let pv = variants[vid.index]
          if fid.index < pv.fields.len() then
            substitute_in_concrete_adt(&ctx.layout_engine, &value_ty, &pv.fields[fid.index])
          else
            Type::Unit
          end
        else
          Type::Unit
        end
      when Option::None then Type::Unit
      end
    end
  when Option::None then Type::Unit
  end
end

# the type of a TupleIndex(Int) projection — the positional tuple
# element type (tuples carry no FieldId).
def projected_tuple_type(ctx: CodegenCtx, ty: Type, idx: Int) -> Type
  match strip_ref_like_type(ty)
  when Type::Tuple(elems) then
    if idx >= 0 && idx < elems.len() then elems[idx].clone() else Type::Unit end
  when _ then Type::Unit
  end  end
end

# the byte offset of a Field(FieldId) projection — ALWAYS from the
# layout engine, resolved through the CONCRETE projected type (the field's
# layout under the place's concrete Adt args). With an ACTIVE
# Variant(VariantId) downcast the projected type is the enum: the index is
# the variant-PAYLOAD field index (declaration order — the flat layout list
# is [tag, v0.fields.., v1.fields..,...]), and the offset is the
# payload-relative position added to the enum's payload base.
def projected_field_offset(inout ctx: CodegenCtx, fid: FieldId, downcast_variant: Option[VariantId], ty: Type) -> Int
  # Defensive: the projected type may arrive ref-wrapped (a &Struct place);
  # the layout authority is the VALUE type's concrete key.
  let value_ty = strip_ref_like_type(ty)
  match downcast_variant
  when Option::Some(vid) then
    if vid.owner.id != fid.owner.id then
      panic("ICE: Field(FieldId) owner " + fid.owner.id.to_string() + " does not match the active Variant(VariantId) owner " + vid.owner.id.to_string())
    end
    enum_payload_base(ctx, &value_ty) + enum_field_offset_for_variant_index(ctx, &value_ty, vid.index, fid.index)
  when Option::None then
    field_offset(&mut ctx.layout_engine, &value_ty, fid.index)
  end
end

# the byte offset of a TupleIndex(Int) projection — the positional
# tuple element offset, from the layout engine's tuple layout.
def projected_tuple_offset(inout ctx: CodegenCtx, ty: Type, idx: Int) -> Int
  match strip_ref_like_type(ty)
  when Type::Tuple(elems) then
    if idx >= 0 && idx < elems.len() then
      let tl = tuple_layout(&mut ctx.layout_engine, &elems)
      tl.fields[idx].offset
    else
      panic("projected_tuple_offset: tuple index " + idx.to_string() + " out of range")
    end
  when _ then
    panic("projected_tuple_offset: expected a tuple type")
  end  end
end

def local_type_id(ctx: CodegenCtx, fctx: FnCodegenCtx, local_id: Int) -> Int
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return extract_named_type_id(ctx, &local.ty)
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return extract_named_type_id(ctx, &param.ty)
    end
  end
  -1
end

def local_type(fctx: FnCodegenCtx, local_id: Int) -> Type
  for local in fctx.func.locals do
    if local.id.id == local_id then
      return local.ty.clone()
    end
  end
  for param in fctx.func.params do
    if param.id.id == local_id then
      return param.ty.clone()
    end
  end
  Type::Unit
end

def place_type(ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place) -> Type
  var current_ty = local_type(fctx, place.local.id)
  var downcast_variant: Option[VariantId] = Option::None
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then
      current_ty = project_deref_type(ctx, &current_ty)
    when Projection::Variant(vid) then
      downcast_variant = Option::Some(vid)
    when Projection::Field(fid) then
      current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
    when Projection::TupleIndex(idx) then
      current_ty = projected_tuple_type(ctx, &current_ty, idx)
    when Projection::ProjIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    when Projection::ProjConstantIndex(_) then
      current_ty = project_index_type(ctx, &current_ty)
    end
  end
  current_ty
end

def operand_type_id(ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand) -> Int
  match op.kind
  when MirOperandKind::MirCopy(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirMovePlace(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirRead(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirConsume(place) then extract_named_type_id(ctx, &place_type(ctx, fctx, &place))
  when MirOperandKind::MirConstant(cst) then extract_named_type_id(ctx, &cst.ty)
  end  end
end

def operand_type(ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand) -> Type
  match op.kind
  when MirOperandKind::MirCopy(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirMovePlace(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirRead(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirConsume(place) then place_type(ctx, fctx, &place)
  when MirOperandKind::MirConstant(cst) then cst.ty.clone()
  end  end
end

def is_ref_like_type(ty: Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end  end
end

def is_receiver_ptr_like_type(ty: Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end  end
end

def strip_ref_like_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then strip_ref_like_type(&inner)
  when other then other.clone()
  end  end
end

def strip_receiver_ptr_like_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then strip_receiver_ptr_like_type(&inner)
  when Type::Ptr(inner) then strip_receiver_ptr_like_type(&inner)
  when Type::PtrMut(inner) then strip_receiver_ptr_like_type(&inner)
  when other then other.clone()
  end  end
end

def is_string_like_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::String then
    true
 # (the typed literal/view split): the MIR-internal static
  # StaticStrPtr of a string literal IS a string (the raw view of the interned
  # bytes) — string binops/concats and the intrinsic classification treat
  # it as string-typed.
  when Type::StaticStrPtr then
    true
  when Type::Adt(tid, args) then
 # Adt form of Slice mirrors the canonical Slice arm
    # (char/i8/u8 element via the Adt args).
    let slt_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if slt_named == "UnsafeSlice" && !args.is_empty() then
      match strip_ref_like_type(&args[0])
      when Type::Char then true
      when Type::I8 then true
      when Type::U8 then true
      else false
      end
    else
      false
    end
  when _ then
    false
  end  end
end

# ———————————————————————————————————————————————————————————————
# consumption — the single representation accessor
# ———————————————————————————————————————————————————————————————
# The layout engine's Repr decision table (type_repr / repr_header_size /
# container_field_offset) is the ONE authority on how a runtime value is
# stored. Codegen NEVER re-decides a storage shape: every representation
# question routes through codegen_type_repr, and heap-header knowledge comes
# from repr_header_size / container_field_offset. The engine is a dependency
# exactly like layout_of_strict: the calls below follow the same import
# pattern (tg_compiler::layout_engine::{... }).
def codegen_type_repr(inout ctx: CodegenCtx, ty: Type) -> Repr
  let r = type_repr(&ctx.layout_engine, ty)
  match r
  when Repr::Invalid then
    # FAIL-CLOSED: an unresolved type (Var/Param/Error/unknown) reaching a
    # codegen representation query is an internal compiler error — never a
    # silent pointer-word guess. The strict path (layout_of_concrete /
    # --strict-resolution) must reject these before codegen.
    panic("ICE: unresolved type reached a codegen representation query (type_repr = Repr::Invalid) — layout queries fail closed")
  when _ then r
  end
end

# Heap-header sizes and field offsets, from the engine's F2 FROZEN table
# (repr_header_size / container_field_offset). Only Vec/Map/Set headers are
# ever touched here (StringPtr is a raw pointer with NO inline header — its
# {data,len,cap,stride} shape is only the internal char-Vec buffer of
# str.chars()).
#
# The table matches the runtime exactly: Vec {data:0,len:8,cap:16,stride:24}
# (32); Map and Set (map-backed) share the runtime's actual 96-byte layout
# header — the canonical MAP_HEADER_FIELDS table in layout_engine.tg
# (map_header_field_offset / map_header_total_size) is the SINGLE
# machine-readable Map/Set layout authority: {buckets:0, size:8, capacity:16,
# key_stride:24, key_align:32, value_stride:40, value_align:48, key_off:56,
# value_off:64, next_off:72, bucket_stride:80, free_list:88} (runtime.tg
# "Map header (96 bytes)"). Every Map/Set header read here routes through
# container_field_offset / heap_header_field_offset to that table.
# Codegen reads the len (and Vec cap) fields at 8/16 and the Vec stride at
# 24, agreeing with both the table and the runtime.
def heap_header_field_offset(repr: Repr, field_name: String) -> Int
  let container_name = match repr
  when Repr::HeapVecHeader then "Vec"
  when Repr::HeapMapHeader then "Map"
  when Repr::HeapSetHeader then "Set"
  when Repr::StringPtr then "String"
  when _ then "Vec"
  end
  container_field_offset(&container_name, field_name)
end

# Fixed arrays (the distinct Type::FixedArray variant) are INLINE storage:
# every other array/vec value is a heap {data,len,cap,stride} handle (the
# stride field is the element-addressing authority). The heap-handle
# semantics (ProjIndex derefs the handle, MirLen reads the header) apply to
# the heap collections; a FixedArray is indexed/measured in place (ProjIndex
# keeps the inline base, MirLen emits the constant count).
# UnsafeSlice is NOT a heap collection: an UnsafeSlice[T] value is the
# 16-byte inline RAW VIEW { ptr: Ptr[T], len: UInt } (Repr::Inline — see
# slice_view_layout). The SAFE source-spelled Slice is the std-declared
# shared struct — its 8-byte Arc-class handle (slice_shared_handle_layout).
# For a view, the projection chain's reg holds the DATA pointer after the
# ProjDeref of the receiver, so ProjIndex must NOT deref again; len comes
# from the view's second word, never from a heap header.
# this is a REPRESENTATION question — the layout engine's type_repr
# (via codegen_type_repr) is the single authority. The former name-list
# special cases (Adt "Array" -> HeapVecHeader, "UnsafeSlice" -> Inline)
# duplicated type_repr's own Adt arms (layout_engine type_repr: named
# Array -> HeapVecHeader, named UnsafeSlice -> Inline, FixedArray ->
# Inline) and are not part of the model: the engine answers the same,
# table-for-table.
def is_heap_collection_type(inout ctx: CodegenCtx, ty: Type) -> Bool
  match codegen_type_repr(ctx, &strip_ref_like_type(ty))
  when Repr::HeapVecHeader then true
  when Repr::HeapMapHeader then true
  when Repr::HeapSetHeader then true
  when _ then false
  end  end
end

# True when the value type is the RAW UnsafeSlice view (after stripping
# references and pointer layers). Mirrors the layout engine's
# is_slice_view_tid. The SAFE source-spelled Slice is the std-declared
# shared struct — its operations compile as its std methods (the Arc
# deref through the backing), never through these raw-view emitters.
def is_slice_view_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::Adt(tid, _) then
    bare_name_from_qualified(type_name_by_id(ctx, tid.id)) == "UnsafeSlice"
  when _ then false
  end  end
end

# True when the value type is the SAFE SOURCE-spelled Slice — the
# std-declared SHARED struct (Slice[T] { inner: ArcStrong[SliceBacking[T]] }).
# Its VALUE is the 8-byte Arc-class handle; its element reads go through
# the Arc deref chain into the 24-byte pinned backing (slice_shared_handle
# _layout / slice_shared_backing_layout): handle word @ 0, ArcInnerWeak
# { refcount @ 0, weak_count @ 8, data @ 16 }, SliceBacking
# { ptr @ 0, len @ 8, offset @ 16 }.
def is_shared_slice_type(ctx: CodegenCtx, ty: Type) -> Bool
  match strip_ref_like_type(ty)
  when Type::Adt(tid, _) then
    bare_name_from_qualified(type_name_by_id(ctx, tid.id)) == "Slice"
  when _ then false
  end  end
end

def deref_all_ref_like_args(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  var arg_ty = operand_type(ctx, fctx, &args[0])
  while is_ref_like_type(&arg_ty) do
    emit_load_mem(ctx, rr, rr, 0)
    arg_ty = project_deref_type(ctx, &arg_ty)
  end
end

def deref_all_receiver_ptr_like_args(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], rr: PhysReg) -> Unit
  if args.len() == 0 then
    return
  end

  let arg_ty = operand_type(ctx, fctx, &args[0])
  if is_receiver_ptr_like_type(&arg_ty) then
    emit_load_mem(ctx, rr, rr, 0)
  end
end

def deref_arg_once_if_ref_like(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], idx: Int) -> Unit
  if args.len() <= idx then
    return
  end

  var deref = is_ref_like_type(&operand_type(ctx, fctx, &args[idx]))
  if !deref then
    if call_args.len() > idx then
      match call_args[idx].value
      when MirCallValue::Place(_) then deref = true
      when MirCallValue::Value(_) then ()
      end
    end
  end
  if !deref then
    return
  end

  match arg_reg(ctx.target.arch, idx)
  when Option::Some(reg) then
    emit_load_mem(ctx, reg, reg, 0)
  when Option::None then ()
  end
end

# Detect a packed inline string (≤8 printable ASCII bytes stored little-endian in
# the value word, e.g. "Int__fmt") and, if found, materialize it into a real
# null-terminated heap buffer so downstream byte-loads operate on a valid pointer.
# target holds the value/pointer; work/cnt/byte are scratch for the scan; buf holds
# the allocated pointer. X0/X1 are preserved across the bump-alloc call.
def emit_normalize_inline_string_a64(inout ctx: CodegenCtx, target: A64, work: A64, cnt: A64, byte: A64, buf: A64) -> Unit
  let lbl_scan = next_codegen_label(ctx, ".Lstrnorm_scan.")
  let lbl_maybe = next_codegen_label(ctx, ".Lstrnorm_maybe.")
  let lbl_packed = next_codegen_label(ctx, ".Lstrnorm_packed.")
  let lbl_np = next_codegen_label(ctx, ".Lstrnorm_np.")
  let lbl_done = next_codegen_label(ctx, ".Lstrnorm_done.")

  # Byte-scan: every byte up to a zero terminator must be printable ASCII.
  a64_mov_rr(&mut ctx.text, work, target)
  a64_mov_ri(&mut ctx.text, cnt, 0)
  def_label(&mut ctx.text, lbl_scan.clone())
  a64_mov_rr(&mut ctx.text, byte, work)
  a64_and_ri(&mut ctx.text, byte, 255)
  a64_cmp_ri(&mut ctx.text, byte, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, byte, 32)
  a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_np.clone())
  a64_cmp_ri(&mut ctx.text, byte, 127)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_np.clone())
  a64_add_rri(&mut ctx.text, cnt, cnt, 1)
  a64_cmp_ri(&mut ctx.text, cnt, 8)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_packed.clone())
  a64_lsr(&mut ctx.text, work, work, 8)
  a64_b(&mut ctx.text, lbl_scan.clone())

  def_label(&mut ctx.text, lbl_maybe.clone())
  a64_cmp_ri(&mut ctx.text, cnt, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_np.clone())

  # Packed: allocate 16 bytes, store the 8 value bytes + null pad, repoint target.
  def_label(&mut ctx.text, lbl_packed)
  a64_stp_pre(&mut ctx.text, A64::X0, A64::X1, A64::SP, -16)
  a64_mov_ri(&mut ctx.text, A64::X0, 16)
  emit_call_label(ctx, "_tg_bump_alloc")
  a64_mov_rr(&mut ctx.text, buf, A64::X0)
  a64_ldp_post(&mut ctx.text, A64::X0, A64::X1, A64::SP, 16)
  a64_stur(&mut ctx.text, target, buf, 0)
  a64_stur(&mut ctx.text, A64::XZR, buf, 8)
  a64_mov_rr(&mut ctx.text, target, buf)
  a64_b(&mut ctx.text, lbl_done.clone())

  def_label(&mut ctx.text, lbl_np)
  def_label(&mut ctx.text, lbl_done)
end

def maybe_load_string_data_ptr(inout ctx: CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
 # the String-ABI receiver unwrap. When the surrounding
  # intrinsic is a string_* op (the router set ctx.string_abi_unwrap), the
  # register holds a String OBJECT header and the byte-op needs the data
  # pointer at [header+0]. str_* ops (flag clear) pass raw through — the
  # value is already the byte pointer (literals, borrowed views).
  if ctx.string_abi_unwrap then
    match ctx.target.arch
    when Arch::AArch64 then
      match reg
      when PhysReg::A64Reg(r) then a64_ldr(&mut ctx.text, r, r, 0)
      when _ then ()
      end
    when Arch::X86_64 then
      match reg
      when PhysReg::X64Reg(r) then x64_mov_rm(&mut ctx.text, r, r, 0)
      when _ then ()
      end
    end
  end
end

def maybe_load_string_data_ptr_disabled(inout ctx: CodegenCtx, reg: PhysReg, data_reg: PhysReg, len_reg: PhysReg, cap_reg: PhysReg, scratch_reg: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match reg
    when PhysReg::A64Reg(target) then
      match data_reg
      when PhysReg::A64Reg(work) then
        match len_reg
        when PhysReg::A64Reg(cnt) then
          match cap_reg
          when PhysReg::A64Reg(byte) then
            match scratch_reg
            when PhysReg::A64Reg(buf) then
              emit_normalize_inline_string_a64(ctx, target, work, cnt, byte, buf)
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  when _ then ()
  end  end
end

def normalize_string_arg0_for_current_arch(inout ctx: CodegenCtx) -> Unit
 # String ABI (— DECIDED): the String VALUE is ONE pointer to the
  # String object header; the runtime helpers unwrap the object
  # themselves (see runtime.tg "String Object Runtime"), so no inline
  # normalization is needed here. The StaticStrPtr static form (interned
  # literal labels) and the borrowed str views pass through unchanged.
  ()
end

def is_enum_type_id(ctx: CodegenCtx, type_id: Int) -> Bool
  if type_id < 0 then return false end
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(_) then true
    when _ then false
    end
  when Option::None then false
  end
end

# The concrete enum TYPE of an operand pair (the first operand whose type
# is a registered enum Adt), else Type::Unit. returns the CONCRETE
# type (args included) — the enum-eq helper is keyed by the (TypeId, substs)
# identity, so Option[u8] and Option[Int] compare through distinct helpers.
def enum_type_for_operands(ctx: CodegenCtx, fctx: FnCodegenCtx, left: MirOperand, right: MirOperand) -> Type
  let left_ty = operand_type(ctx, fctx, left)
  match left_ty
  when Type::Adt(tid, _) then
    if is_enum_type_id(ctx, tid.id) then return left_ty end
  when _ then ()
  end
  let right_ty = operand_type(ctx, fctx, right)
  match right_ty
  when Type::Adt(tid2, _) then
    if is_enum_type_id(ctx, tid2.id) then return right_ty end
  when _ then ()
  end
  Type::Unit
end

def next_codegen_label(inout ctx: CodegenCtx, prefix: String) -> String
  let label = prefix + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  label
end

# the enum-eq helper identity is the CONCRETE key (mir_type_identity_key
# of the compared enum) — Option[u8] and Option[Int] are distinct helpers.
# The EMISSION label sanitizes the render (type renders contain '#', '[',
# ']', ',' — invalid asm label characters).
def sanitize_label_part(s: String) -> String
  var out = ""
  var i = 0
  while i < s.len() do
    let c = s.char_at(i)
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' then
      out = out + c.to_string()
    else
      out = out + "_"
    end
    i = i + 1
  end
  out
end

def enum_eq_helper_label(ckey: String) -> String
  ".Lenum_eq_helper." + sanitize_label_part(&ckey)
end

def request_enum_eq_helper(inout ctx: CodegenCtx, ty: Type) -> String
  let ckey = mir_type_identity_key(ty)
  let label = enum_eq_helper_label(ckey.clone())
  if !ctx.enum_eq_helper_requested.contains(&ckey) then
    ctx.enum_eq_helper_requested.insert(ckey)
    ctx.enum_eq_helper_queue.push(ty.clone())
  end
  label
end

# The EnumLayout of a registered enum TYPE (concrete Adt), fail-closed: a
# type with no enum layout reaching an enum question is an internal
# compiler error. resolved through the concrete key — the payload
# layout of Option[u8] comes from the Option[u8] EnumLayout, never a
# nominal record.
def enum_layout_strict(inout ctx: CodegenCtx, ty: Type) -> EnumLayout
  let stripped = strip_ref_like_type(ty)
  match enum_layout_for_type(&mut ctx.layout_engine, &stripped)
  when Option::Some(el) then el
  when Option::None then
    panic("ICE: enum layout query failed closed: type " + mir_type_identity_key(ty) + " is not a registered enum (no EnumLayout)")
  end
end

# The payload base offset of a registered enum's image, from the EnumLayout
# (the single authority — never a hardcoded 8).
def enum_payload_base(inout ctx: CodegenCtx, ty: Type) -> Int
  enum_layout_strict(ctx, ty).payload_offset
end

# The discriminant of a variant by its registered NAME, from the layout
# authority (variant_discriminant in the engine). Fail closed when the type
# is not a registered enum or the variant is unknown.
def enum_variant_discriminant_of(inout ctx: CodegenCtx, ty: Type, variant_name: String) -> Int
  let stripped = strip_ref_like_type(ty)
  match variant_discriminant(&mut ctx.layout_engine, &stripped, variant_name)
  when Option::Some(d) then d
  when Option::None then
    panic("ICE: enum_variant_discriminant_of: variant `" + variant_name + "` not found in type " + mir_type_identity_key(ty))
  end
end

# The discriminant of a registered enum's FIRST variant (variant 0), from
# the EnumLayout. Used by the Option/Result unwrap intrinsics, whose success
# variant (Some/Ok) is always variant 0 — asked of the layout, never a
# hardcoded 0.
def enum_first_variant_discriminant(inout ctx: CodegenCtx, ty: Type) -> Int
  let el = enum_layout_strict(ctx, ty)
  if el.variant_layouts.len() > 0 then
    el.variant_layouts[0].discriminant
  else
    panic("ICE: enum_first_variant_discriminant: enum " + mir_type_identity_key(ty) + " has no variants")
  end
end

# Normalize an enum's register-resident VALUE to a plain discriminant tag,
# asking the layout engine's EnumLayout — the single enum-representation
# authority. For TaggedPtr-represented enums (every registered enum today):
# values below the layout's inline-tag threshold are raw discriminants and
# pass through; values at/above the threshold are heap pointers to the enum
# image, whose tag sits at tag_layout.offset (dereferenced). The threshold
# and the deref rule come from the EnumLayout — codegen never contains the
# boundary policy. For InlineTagged-represented enums the register value
# carries the tag word itself (tag_offset 0) — no normalization is needed.
def normalize_enum_value_to_tag(inout ctx: CodegenCtx, reg: PhysReg, enum_ty: Type) -> Unit
  let el = enum_layout_strict(ctx, enum_ty)
  match el.representation
  when EnumValueRepresentation::TaggedPtr(threshold) then
    let lbl_done = next_codegen_label(ctx, ".Lenum_tag_done.")
    let lbl_deref = next_codegen_label(ctx, ".Lenum_tag_deref.")
    emit_cmp_ri(ctx, reg, threshold)
    emit_jcc(ctx, CondKind::Ge, lbl_deref.clone())
    emit_jmp(ctx, lbl_done.clone())
    def_label(&mut ctx.text, lbl_deref)
    emit_load_mem(ctx, reg, reg, el.tag_layout.offset)
    def_label(&mut ctx.text, lbl_done)
  when EnumValueRepresentation::InlineTagged then
    # The value IS the tagged image: the tag word sits at the value base
    # (tag_layout.offset is 0) — the low bits of the register value already
    # ARE the discriminant.
    ()
  when EnumValueRepresentation::Opaque then
    panic("ICE: normalize_enum_value_to_tag: enum type " + mir_type_identity_key(enum_ty) + " has an opaque (unresolved) EnumLayout")
  end
end

# The DISCRIMINANT of a variant by its DECLARATION index (VariantId.index
# is declaration order, NEVER the discriminant), from the layout authority
# (the EnumLayout's variant_layouts, built in declaration order).
def enum_variant_discriminant_of_index(inout ctx: CodegenCtx, ty: Type, variant_index: Int) -> Int
  let el = enum_layout_strict(ctx, ty)
  if variant_index >= 0 && variant_index < el.variant_layouts.len() then
    el.variant_layouts[variant_index].discriminant
  else
    panic("ICE: enum_variant_discriminant_of_index: variant index " + variant_index.to_string() + " out of range in type " + mir_type_identity_key(ty))
  end
end

# The DECLARATION index of a variant by name (VariantId.index — declaration
# order, never the discriminant), from the enum's MirTypeDef. Used by the
# drop-glue downcasts (Option::Some, Result Ok/Err, plan variants).
def enum_variant_index_of_name(ctx: CodegenCtx, type_id: Int, variant_name: String) -> Int
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].name == variant_name then return vi end
        vi = vi + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  panic("ICE: enum_variant_index_of_name: variant `" + variant_name.clone() + "` not found in type " + type_id.to_string())  end
end

# The DECLARATION index of a variant by its discriminant — the DeinitPlan
# Enum arm is discriminant-keyed (variant discriminant -> (VariantId,
# plans)) and the VariantId is carried directly; this index resolution
# serves the remaining discriminant-side consumers.
# takes the CONCRETE enum type (the declaration order is a def
# property, so the def is looked up through the type's TypeId).
def enum_variant_index_of_discriminant(ctx: CodegenCtx, ty: Type, discriminant: Int) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].discriminant == discriminant then return vi end
        vi = vi + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  panic("ICE: enum_variant_index_of_discriminant: no variant " + discriminant.to_string() + " in type " + type_id.to_string())
end

# Return the payload-relative offset (0 = first payload field) of an enum
# variant's field, from the single layout authority (the layout engine —
# the flat field list is [tag, v0.f0..v0.fN, v1.f0..v1.fN,...] in
# DECLARATION order, so the variant INDEX computes the flat index directly).
def enum_field_offset_for_variant_index(inout ctx: CodegenCtx, ty: Type, variant_index: Int, field_idx: Int) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      if variant_index >= 0 && variant_index < variants.len() then
        var flat = 1
        var pi = 0
        while pi < variant_index do
          flat = flat + variants[pi].fields.len()
          pi = pi + 1
        end
        flat = flat + field_idx
 # the flat field offset comes from the CONCRETE enum's
        # layout (the substituted field list under this Adt's args).
        let abs = field_offset(&mut ctx.layout_engine, ty, flat)
        # Subtract the tag/payload-start offset to get a payload-relative
        # value. The payload base comes from the EnumLayout — the single
        # enum authority — never a hardcoded 8.
        let pbase = enum_payload_base(ctx, ty)
        abs - pbase
      else
        panic("enum_field_offset_for_variant_index: variant index " + variant_index.to_string() + " out of range in type " + type_id.to_string())
      end
    when _ then
      panic("enum_field_offset_for_variant_index: type " + type_id.to_string() + " is not an enum")
    end
  when Option::None then
    panic("enum_field_offset_for_variant_index: unknown type " + type_id.to_string())
  end
end

def emit_enum_eq_loaded(inout ctx: CodegenCtx, ty: Type, dst: PhysReg, scratch: PhysReg) -> Unit
  let arch = ctx.target.arch
  let label = request_enum_eq_helper(ctx, ty)

  match arg_reg(arch, 1)
  when Option::Some(arg1) then
    if phys_reg_id(arg1) != phys_reg_id(scratch) then
      emit_mov_rr(ctx, arg1, scratch)
    end
  when Option::None then ()
  end

  match arg_reg(arch, 0)
  when Option::Some(arg0) then
    if phys_reg_id(arg0) != phys_reg_id(dst) then
      emit_mov_rr(ctx, arg0, dst)
    end
  when Option::None then ()
  end

  emit_call_label(ctx, label)

  let rr = ret_reg(arch)
  if phys_reg_id(dst) != phys_reg_id(rr) then
    emit_mov_rr(ctx, dst, rr)
  end
end

def emit_enum_eq_helper_body(inout ctx: CodegenCtx, ty: Type) -> Unit
  let ckey = mir_type_identity_key(ty)
  if ctx.enum_eq_helper_emitted.contains(&ckey) then
    return
  end
  ctx.enum_eq_helper_emitted.insert(ckey.clone())

  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let temp = scratch_reg(arch)
  let dst = match arg_reg(arch, 0)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg0 register")
  end
  let scratch = match arg_reg(arch, 1)
  when Option::Some(r) then r
  when Option::None then panic("emit_enum_eq_helper_body: missing arg1 register")
  end
  let saved_left_offset = match arch
  when Arch::X86_64 then -8
  when Arch::AArch64 then -16
  end
  let saved_right_offset = match arch
  when Arch::X86_64 then -16
  when Arch::AArch64 then -32
  end

  align_to(&mut ctx.text, 4, arch)
  def_label(&mut ctx.text, enum_eq_helper_label(ckey))

  match arch
  when Arch::X86_64 then
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp_reg(arch))
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  end

  emit_push(ctx, dst)
  emit_push(ctx, scratch)

  # Normalization asks the EnumLayout of the compared enum (the concrete
  # type — the single enum-representation authority; codegen holds no
  # threshold policy).
  normalize_enum_value_to_tag(ctx, dst, ty)
  normalize_enum_value_to_tag(ctx, scratch, ty)

  let lbl_false = next_codegen_label(ctx, ".Lenum_eq_false.")
  let lbl_true = next_codegen_label(ctx, ".Lenum_eq_true.")
  let lbl_done = next_codegen_label(ctx, ".Lenum_eq_done.")

  emit_cmp_rr(ctx, dst, scratch)
  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())

  var has_payload_variant = false
  let type_id = extract_named_type_id(ctx, ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Enum(variants) then
      var variant_vi = 0
      for variant in variants do
          if variant.fields.len() > 0 then
            has_payload_variant = true
            let lbl_next_variant = next_codegen_label(ctx, ".Lenum_eq_next_variant.")
            emit_cmp_ri(ctx, dst, variant.discriminant as i32)
            emit_jcc(ctx, CondKind::Ne, lbl_next_variant.clone())

            var field_idx = 0
            for def_field_ty in variant.fields do
              # Absolute payload field offset: EnumLayout payload base +
              # payload-relative offset (the base comes from the layout
              # authority — never a hardcoded 8). The variant index is the
              # DECLARATION index (the loop position), never the
              # discriminant.
 # the compared field type is the def field type
              # SUBSTITUTED under the concrete enum's args.
              let field_ty = substitute_in_concrete_adt(&ctx.layout_engine, ty, def_field_ty)
              let field_off = enum_payload_base(ctx, ty) + enum_field_offset_for_variant_index(ctx, ty, variant_vi, field_idx)
              emit_load_mem(ctx, dst, fp, saved_left_offset)
              emit_load_mem(ctx, scratch, fp, saved_right_offset)
              emit_load_mem(ctx, dst, dst, field_off as i32)
              emit_load_mem(ctx, scratch, scratch, field_off as i32)

              match field_ty
              when Type::String then
                codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Float then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F32 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::F64 then
                codegen_float_binop(ctx, MirBinOp::Eq, dst, scratch)
                emit_test_rr(ctx, dst, dst)
                emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
              when Type::Adt(tid, _) then
                if is_enum_type_id(ctx, tid.id) then
 # the compared field type is CONCRETE (the def
                  # field type was substituted above) — the nested eq helper
                  # is keyed by its (TypeId, substs) identity.
                  emit_enum_eq_loaded(ctx, &field_ty, dst, scratch)
                  emit_test_rr(ctx, dst, dst)
                  emit_jcc(ctx, CondKind::Eq, lbl_false.clone())
                else
                  emit_cmp_rr(ctx, dst, scratch)
                  emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
                end
              when _ then
                emit_cmp_rr(ctx, dst, scratch)
                emit_jcc(ctx, CondKind::Ne, lbl_false.clone())
              end

              field_idx = field_idx + 1
            end

            emit_jmp(ctx, lbl_true.clone())
            def_label(&mut ctx.text, lbl_next_variant)
          end
          variant_vi = variant_vi + 1
        end
      when _ then ()
      end
    when Option::None then ()
    end

  emit_jmp(ctx, lbl_true.clone())

  def_label(&mut ctx.text, lbl_false)
  emit_zero_reg(ctx, dst)
  emit_jmp(ctx, lbl_done.clone())

  def_label(&mut ctx.text, lbl_true)
  emit_mov_ri(ctx, dst, 1)

  def_label(&mut ctx.text, lbl_done)
  emit_pop(ctx, scratch)
  emit_pop(ctx, temp)
  match arch
  when Arch::X86_64 then
    emit_pop(ctx, fp)
    emit_ret(ctx)
  when Arch::AArch64 then
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

def emit_pending_enum_eq_helpers(inout ctx: CodegenCtx) -> Unit
  var idx = 0
  while idx < ctx.enum_eq_helper_queue.len() do
    let enum_ty = ctx.enum_eq_helper_queue[idx]
    if !ctx.enum_eq_helper_emitted.contains(&mir_type_identity_key(&enum_ty)) then
      emit_enum_eq_helper_body(ctx, &enum_ty)
    end
    idx = idx + 1
  end
end

def projection_is_field(proj: Projection) -> Bool
  match proj
  when Projection::Field(_) then true
  when Projection::TupleIndex(_) then true
  when _ then false
  end  end
end

# Storage size of a scalar type in bytes (1/2/4/8), matching storage_width_of.
# Non-immediate representations are pointer-width (8), again via the Repr
# decision table — the byte-count mirror of storage_width_of.
def storage_size_bytes(inout ctx: CodegenCtx, ty: Type) -> Int
  match codegen_type_repr(ctx, ty)
  when Repr::Immediate then
    match ty
    when Type::Bool then 1
    when Type::I8 then 1
    when Type::U8 then 1
    when Type::I16 then 2
    when Type::U16 then 2
    when Type::I32 then 4
    when Type::U32 then 4
    when Type::F32 then 4
    when Type::Char then 4
    when Type::I64 then 8
    when Type::U64 then 8
    when Type::Int then 8
    when Type::UInt then 8
    when Type::ISize then 8
    when Type::USize then 8
    when Type::F64 then 8
    when _ then 8
    end
  when _ then 8
  end  end
end

# Byte stride between consecutive collection elements — derived from the
# element's VALUE CATEGORY (classify_value_category, the layout engine's
# single ABI authority), so the stride ALWAYS equals the element TRANSFER
# size:
#   ZeroSized    -> 0 (nothing to copy)
#   Scalar(w)    -> w (1/2/4/8 — the width-dispatch transfer)
#   ScalarPair   -> 16 (the 16-byte image)
#   ByAddress(sz)-> sz (the full image byte size)
# The engine's inline aggregate layouts are alignment-rounded
# (compute_tuple_layout / compute_struct_layout round the total size up to
# the aggregate alignment), so stride == size_of(T) for every aligned
# aggregate — the Vec header stride is BOTH the addressing stride and the
# byte-copy length. (This replaces the old storage_size_bytes guess, which
# returned a flat 8 for every Inline aggregate — a 16-byte tuple or a
# 24-byte struct element was addressed at 8-byte intervals.)
def element_stride_bytes(inout ctx: CodegenCtx, elem_ty: Type) -> Int
  match classify_value_category(&mut ctx.layout_engine, elem_ty)
  when Result::Err(e) then
    panic("ICE: element-stride classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then 0
    when ValueCategory::Scalar(w) then w
    when ValueCategory::ScalarPair(_, _) then 16
    when ValueCategory::Vector(w) then w
    when ValueCategory::ByAddress(sz) then sz
    end
  end  end
end

# The CONCRETE element type of a Vec/Array/Slice receiver (or a FixedArray
# element type), used to compute the element stride at an operation site.
# The layout values MUST come from the concrete type here — a generic Param
# is a monomorphization bug and fails closed (panic).
def vec_elem_type_of(inout ctx: CodegenCtx, ty: Type) -> Type
  let stripped = strip_ref_like_type(ty)
  match stripped
  when Type::FixedArray(elem, _) then elem.clone()
  when Type::Adt(tid, args) then
    let ven = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if ven == "Array" || ven == "Vec" || ven == "UnsafeSlice" || ven == "Slice" then
      if args.is_empty() then
        panic("internal error: Vec/Array receiver type carries no element type argument at a codegen operation site")
      end
      let elem = strip_ref_like_type(&args[0])
      match elem
      when Type::Param(_) then
        panic("internal error: Vec element type is an unresolved Param at a codegen operation site — the monomorphizer must supply the concrete element type")
      when _ then elem.clone()
      end
    else
      panic("internal error: expected a Vec/Array/Slice receiver type for element-layout computation, got `" + type_name_by_id(ctx, tid.id) + "`")
    end
  when Type::String then
 # String::new no longer routes through ArrayNew (it builds
    # the owned String object via _tg_string_new), so this arm is reached
    # only by the char-Vec convention of `str.chars()` (_tg_str_chars
    # builds a Vec[Char], stride 4) — kept for that path.
    Type::Char
  when _ then
    panic("internal error: expected a Vec/Array/Slice receiver type for element-layout computation")
  end
end

# Scale `reg` (an element index) by `stride` bytes. The single codegen-side
# element-index scaler, used by ProjIndex/ProjConstantIndex, the drop-glue
# array walk and codegen_array_last: shifts for power-of-two strides, a
# multiply for any other stride (fixed-array elements). The multiply uses a
# caller-saved scratch that is dead at every call site (X16/X17, R11/RDX —
# R11 is the register the addr-path scales, so the helper falls back to RDX
# when `reg` IS R11).
def emit_scale_index(inout ctx: CodegenCtx, reg: PhysReg, stride: Int) -> Unit
  match reg
  when PhysReg::A64Reg(a) then
    match stride
    when 1 then ()
    when 2 then a64_lsl(&mut ctx.text, a, a, 1)
    when 4 then a64_lsl(&mut ctx.text, a, a, 2)
    when 8 then a64_lsl(&mut ctx.text, a, a, 3)
    when _ then
      let mul_scratch = if a == A64::X16 then A64::X17 else A64::X16 end
      a64_mov_ri(&mut ctx.text, mul_scratch, stride as i64)
      a64_mul_rrr(&mut ctx.text, a, a, mul_scratch)
    end
  when PhysReg::X64Reg(x) then
    match stride
    when 1 then ()
    when 2 then x64_shl_ri(&mut ctx.text, x, 1)
    when 4 then x64_shl_ri(&mut ctx.text, x, 2)
    when 8 then x64_shl_ri(&mut ctx.text, x, 3)
    when _ then
      let mul_scratch = if x == X64::R11 then X64::RDX else X64::R11 end
      x64_mov_ri(&mut ctx.text, mul_scratch, stride as i64)
      x64_imul_rr(&mut ctx.text, x, mul_scratch)
    end
  end  end
end

def apply_projections(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, projs: Vec[Projection], reg: PhysReg) -> Unit
  let scratch = ret_reg(ctx.target.arch)  # use return reg as scratch for index loads
  var current_ty = local_type(fctx, place.local.id)
  var downcast_variant: Option[VariantId] = Option::None
  var last_deref_unwrapped_ref = false
  # Label to skip remaining projections after a payload-less inline-tag
  # Variant downcast (TaggedPtr-represented enums: a raw discriminant below
  # the layout threshold has no heap-allocated payload, so there is no
  # payload struct to project into — remaining field/offset projections must
  # be skipped to avoid null-pointer dereference (ldr x0, [x0] on xzr). The
  # threshold/payload rule comes from the EnumLayout, never codegen.)
  let lbl_skip_remaining = next_codegen_label(ctx, ".Lskip_remaining.")

  var i = 0
  while i < projs.len() do
    let proj = projs[i]
    match proj
    when Projection::ProjDeref then ()
    when _ then
      if is_ref_like_type(&current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        current_ty = project_deref_type(ctx, &current_ty)
      end
    end
    match proj
    when Projection::ProjDeref then
      last_deref_unwrapped_ref = is_ref_like_type(&current_ty)
      emit_load_mem(ctx, reg, reg, 0)
      current_ty = project_deref_type(ctx, &current_ty)
    when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type (— the place's current type
      # carries the Adt args; a generic def's field is substituted).
      let offset = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
      let field_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
      let fwidth = storage_width_of(ctx, &field_ty)
      let fext = storage_signedness_of(&field_ty)
      if (offset % mem_width_bytes(fwidth)) != 0 then
        # A @packed-aggregate field at a MISALIGNED static offset: the
        # byte-wise unaligned load.
        emit_push(ctx, reg)
        emit_add_ri(ctx, reg, offset as i32)
        emit_load_mem_sized_unaligned(ctx, reg, reg, fwidth, fext)
        emit_pop(ctx, scratch)
      else
        emit_load_mem_sized(ctx, reg, reg, offset as i32, fwidth, fext)
      end
      current_ty = field_ty
      last_deref_unwrapped_ref = false
    when Projection::TupleIndex(idx) then
 # positional tuple element access — the offset comes from the
      # layout engine's tuple layout.
      let offset = projected_tuple_offset(ctx, &current_ty, idx)
      let field_ty = projected_tuple_type(ctx, &current_ty, idx)
      let fwidth = storage_width_of(ctx, &field_ty)
      let fext = storage_signedness_of(&field_ty)
      if (offset % mem_width_bytes(fwidth)) != 0 then
        # A @packed-aggregate tuple field at a MISALIGNED static offset:
        # the byte-wise unaligned load.
        emit_push(ctx, reg)
        emit_add_ri(ctx, reg, offset as i32)
        emit_load_mem_sized_unaligned(ctx, reg, reg, fwidth, fext)
        emit_pop(ctx, scratch)
      else
        emit_load_mem_sized(ctx, reg, reg, offset as i32, fwidth, fext)
      end
      current_ty = field_ty
      last_deref_unwrapped_ref = false
    when Projection::ProjIndex(local_id) then
      let idx_reg = scratch2_reg(ctx.target.arch)
      load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
      # Determine element size from the collection type.
      let elem_ty = project_index_type(ctx, &current_ty)
      let elem_size = element_stride_bytes(ctx, &elem_ty)
      let is_byte_indexed = is_string_like_type(ctx, &current_ty)
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        if !is_byte_indexed then
          # Scale index by the element's storage stride (1/2/4/8 shifts,
          # multiply for any other stride — the SAME authority the runtime
          # reads from the Vec header).
          emit_scale_index(ctx, idx_reg, elem_size)
        end
        # Add scaled offset to base address
        emit_add_rrr(ctx, reg, reg, idx_reg)
      elsif is_shared_slice_type(ctx, &current_ty) then
        # The SAFE source-spelled Slice — the SHARED form's element read:
        # element i lives at backing.ptr + i * stride (the backing.ptr IS
        # the pinned window's start; the backing's offset is source
        # metadata, never an element address — the std get/sub contract).
        # The Arc deref chain: [value+0] = ArcInnerWeak*, [inner+16] =
        # SliceBacking { ptr@0, len@8, offset@16 }. The scratch register
        # is consumed BEFORE emit_scale_index (which may itself use the
        # scratch on x86-64 for a non-power-of-2 stride).
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), reg, 0)  # scratch = ArcInnerWeak*
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), scratch_reg(ctx.target.arch), 16) # scratch = SliceBacking*
        emit_load_mem(ctx, reg, scratch_reg(ctx.target.arch), 0)  # reg = backing.ptr
        emit_add_rrr(ctx, reg, reg, idx_reg)                      # reg = ptr + i
        emit_scale_index(ctx, reg, elem_size)
      else
        if !is_byte_indexed then
          # Scale index by the element's storage stride (1/2/4/8 shifts,
          # multiply for any other stride — the SAME authority the runtime
          # reads from the Vec header).
          emit_scale_index(ctx, idx_reg, elem_size)
        end
        # Add scaled offset to base address
        emit_add_rrr(ctx, reg, reg, idx_reg)
      end
      if is_byte_indexed then
        match reg
        when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
        when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
        end
      else
        let ewidth = storage_width_of(ctx, &elem_ty)
        let eext = storage_signedness_of(&elem_ty)
        emit_load_mem_sized(ctx, reg, reg, 0, ewidth, eext)
      end
      current_ty = elem_ty
      last_deref_unwrapped_ref = false
    when Projection::ProjConstantIndex(ci) then
      let is_byte_indexed = is_string_like_type(ctx, &current_ty)
      let elem_ty2 = project_index_type(ctx, &current_ty)
      let elem_size2 = element_stride_bytes(ctx, &elem_ty2)
      if is_heap_collection_type(ctx, &current_ty) then
        emit_load_mem(ctx, reg, reg, 0)
        if is_byte_indexed then
          emit_add_ri(ctx, reg, ci as i32)
          match reg
          when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
          when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
          end
        else
          let offset = ci * elem_size2
          let ewidth2 = storage_width_of(ctx, &elem_ty2)
          let eext2 = storage_signedness_of(&elem_ty2)
          emit_load_mem_sized(ctx, reg, reg, offset as i32, ewidth2, eext2)
        end
      elsif is_shared_slice_type(ctx, &current_ty) then
        # The SAFE source-spelled Slice — the SHARED form's constant-index
        # read: element ci at backing.ptr + ci * stride (the Arc deref
        # chain; see the ProjIndex arm — the scratch is consumed before
        # emit_scale_index).
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), reg, 0)  # scratch = ArcInnerWeak*
        emit_load_mem(ctx, scratch_reg(ctx.target.arch), scratch_reg(ctx.target.arch), 16) # scratch = SliceBacking*
        emit_load_mem(ctx, reg, scratch_reg(ctx.target.arch), 0)  # reg = backing.ptr
        emit_add_ri(ctx, reg, ci as i32)                          # reg = ptr + ci
        emit_scale_index(ctx, reg, elem_size2)
        let ewidth2 = storage_width_of(ctx, &elem_ty2)
        let eext2 = storage_signedness_of(&elem_ty2)
        emit_load_mem_sized(ctx, reg, reg, 0, ewidth2, eext2)
      else
        if is_byte_indexed then
          emit_add_ri(ctx, reg, ci as i32)
          match reg
          when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
          when PhysReg::X64Reg(x) then x64_movzx_r64_m8(&mut ctx.text, x, x, 0)
          end
        else
          let offset = ci * elem_size2
          let ewidth2 = storage_width_of(ctx, &elem_ty2)
          let eext2 = storage_signedness_of(&elem_ty2)
          emit_load_mem_sized(ctx, reg, reg, offset as i32, ewidth2, eext2)
        end
      end
      current_ty = elem_ty2
      last_deref_unwrapped_ref = false
    when Projection::Variant(vid) then
      downcast_variant = Option::Some(vid)
      # The payload-access rule comes from the enum's EnumLayout (the single
      # enum-representation authority): a TaggedPtr-represented enum value
      # is a heap pointer (at/above the layout threshold) to the image
      # { tag @ tag_layout.offset, payload @ payload_offset } — or a raw
      # inline discriminant (below the threshold) that has no heap payload.
      # The VariantId carries the enum OWNER + the variant's DECLARATION
 # index (never the discriminant). the EnumLayout is resolved
      # through the CONCRETE enum type (current_ty carries the Adt args).
      let dc_el = enum_layout_strict(ctx, &current_ty)
      match dc_el.representation
      when EnumValueRepresentation::TaggedPtr(threshold) then
        let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
        let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
        emit_cmp_ri(ctx, reg, threshold)
        emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
        # Heap pointer: skip the tag to reach the payload.
        emit_add_ri(ctx, reg, dc_el.payload_offset)
        if i == projs.len() - 1 then
          emit_load_mem(ctx, reg, reg, 0)
        end
        emit_jmp(ctx, lbl_payload_done.clone())
        def_label(&mut ctx.text, lbl_payload_skip)
        # Inline tag: no heap allocation, zero out the payload reference.
        emit_zero_reg(ctx, reg)
        # If there are remaining projections after the downcast, skip them.
        # An inline tag has no heap-allocated payload struct, so there is
        # nothing to project into — remaining projections would dereference
        # null (ldr x0, [x0]) and crash.
        if i < projs.len() - 1 then
          emit_jmp(ctx, lbl_skip_remaining.clone())
        end
        def_label(&mut ctx.text, lbl_payload_done)
      when EnumValueRepresentation::InlineTagged then
        # The value is the inline image: the payload sits at payload_offset
        # within the image — no threshold test.
        emit_add_ri(ctx, reg, dc_el.payload_offset)
        if i == projs.len() - 1 then
          emit_load_mem(ctx, reg, reg, 0)
        end
      when EnumValueRepresentation::Opaque then
        panic("ICE: apply_projections: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
      end
      last_deref_unwrapped_ref = false
    end
    i = i + 1
  end
  def_label(&mut ctx.text, lbl_skip_remaining)
end

def load_constant(inout ctx: CodegenCtx, cst: MirConstant, dst: PhysReg) -> Unit
  match cst.kind
  when MirConstantKind::MirUnit then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirBool(b) then
    if b then
      emit_mov_ri(ctx, dst, 1)
    else
      emit_zero_reg(ctx, dst)
    end
  when MirConstantKind::MirInt(i) then
    emit_mov_ri(ctx, dst, i as i64)
  when MirConstantKind::MirFloat(f) then
    # Load float bits into GPR, then move to float reg via stack
    let bits = f.to_bits() as i64
    emit_mov_ri(ctx, dst, bits)
    # Store GPR to temp stack slot, load back as float
    let sp = sp_reg(ctx.target.arch)
    emit_store_mem(ctx, sp, -8, dst)
    emit_load_fp_from_stack(ctx, dst, sp, -8)
  when MirConstantKind::MirChar(c) then
    emit_mov_ri(ctx, dst, c as i64)
  when MirConstantKind::MirString(s) then
    let label = intern_string(ctx, s)
    emit_lea_label(ctx, dst, label)
  when MirConstantKind::MirFnItem(fn_name) then
    # Load the address of a named function
    emit_lea_label(ctx, dst, fn_name.clone())
  when MirConstantKind::MirZeroSized then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
    # static label table (the name-side symbol-table registration).
    let label = resolve_static_label(ctx, did)
    # Load current value of a global/static variable: ADRP+ADD to get address, then LDR
    emit_lea_label(ctx, dst, label.clone())
    emit_load_mem(ctx, dst, dst, 0)
  when MirConstantKind::MirStaticAddr(did) then
    # Get address of a global/static variable: ADRP+ADD
    let label = resolve_static_label(ctx, did)
    emit_lea_label(ctx, dst, label.clone())
  end  end
end

# ———————————————————————————————————————————————————————————————
# Store to a Place
# ———————————————————————————————————————————————————————————————

def store_place(inout ctx: CodegenCtx, fctx: FnCodegenCtx, place: Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = ret_reg(ctx.target.arch)
  let place_ty = local_type(fctx, place.local.id)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    if place.projections.is_empty() then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    else
      # Save value to stack, then compute base address in a DIFFERENT
      # register so that pop(src) does not clobber the base.
      let base = scratch2_reg(ctx.target.arch)  # X14 — not X0
      emit_push(ctx, src)

      match loc
      when VarLoc::Register(r) then
        emit_mov_rr(ctx, base, r)
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, base, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, base, fp, offset)
      end

      # Walk projections except last to compute base address
      var current_ty = place_ty
      var downcast_variant: Option[VariantId] = Option::None
      var i = 0
      let n = place.projections.len()
      # Label to skip remaining projections after a payload-less inline-tag
      # Variant downcast (the EnumLayout's TaggedPtr encoding: a raw
      # discriminant below the threshold has no heap-allocated payload, so
      # subsequent projection code would compute addresses from a zeroed
      # base register).
      let lbl_skip_store = next_codegen_label(ctx, ".Lskip_store_proj.")
      while i < n - 1 do
        let proj = place.projections[i]
        match proj
        when Projection::ProjDeref then ()
        when _ then
          if is_ref_like_type(&current_ty) then
            emit_load_mem(ctx, base, base, 0)
            current_ty = project_deref_type(ctx, &current_ty)
          end
        end
        match proj
        when Projection::ProjDeref then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type (— the place's current type
          # carries the Adt args; a generic def's field is substituted).
          let field_off = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
          emit_add_ri(ctx, base, field_off as i32)
          current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
        when Projection::TupleIndex(idx) then
          let field_off = projected_tuple_offset(ctx, &current_ty, idx)
          emit_add_ri(ctx, base, field_off as i32)
          current_ty = projected_tuple_type(ctx, &current_ty, idx)
        when Projection::Variant(vid) then
          downcast_variant = Option::Some(vid)
          # Payload addressing via the EnumLayout (the single
          # enum-representation authority): TaggedPtr-represented enums are
          # heap pointers (at/above the threshold) to the image with the
          # payload at payload_offset — or raw inline discriminants (below
          # the threshold) with no heap payload. The VariantId carries the
 # enum OWNER + the variant's DECLARATION index. the
          # EnumLayout resolves through the CONCRETE enum type (current_ty).
          let sp_el = enum_layout_strict(ctx, &current_ty)
          match sp_el.representation
          when EnumValueRepresentation::TaggedPtr(threshold) then
            let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
            let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
            emit_cmp_ri(ctx, base, threshold)
            emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
            emit_add_ri(ctx, base, sp_el.payload_offset)
            emit_jmp(ctx, lbl_payload_done.clone())
            def_label(&mut ctx.text, lbl_payload_skip)
            # Inline tag: no heap allocation, zero out the payload reference.
            emit_zero_reg(ctx, base)
            # If there are remaining non-last projections, skip them since
            # the inline tag has no heap-allocated payload struct to compute
            # addresses into.
            if i < n - 2 then
              emit_jmp(ctx, lbl_skip_store.clone())
            end
            def_label(&mut ctx.text, lbl_payload_done)
          when EnumValueRepresentation::InlineTagged then
            # The value is the inline image: payload at payload_offset.
            emit_add_ri(ctx, base, sp_el.payload_offset)
          when EnumValueRepresentation::Opaque then
            panic("ICE: store_place: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
          end
        when Projection::ProjIndex(local_id) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
          load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
          # Scale the index by the element's real storage stride (the same
          # authority the runtime reads from the Vec header).
          let sidx_elem_ty = project_index_type(ctx, &current_ty)
          let sidx_stride = element_stride_bytes(ctx, &sidx_elem_ty)
          emit_scale_index(ctx, scratch, sidx_stride)
          emit_add_rrr(ctx, base, base, scratch)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when Projection::ProjConstantIndex(ci) then
          if is_heap_collection_type(ctx, &current_ty) then
            emit_load_mem(ctx, base, base, 0)
          end
        let cidx_elem_ty = project_index_type(ctx, &current_ty)
        let cidx_stride = element_stride_bytes(ctx, &cidx_elem_ty)
        emit_add_ri(ctx, base, (ci * cidx_stride) as i32)
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_index_type(ctx, &current_ty)
        when _ then ()
        end
        i = i + 1
      end
      def_label(&mut ctx.text, lbl_skip_store)

      # Last projection determines final store offset
      let last = place.projections[n - 1]
      var store_off: i32 = 0
      match last
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, base, base, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        end
      end
      match last
      when Projection::ProjDeref then
        store_off = 0
      when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type.
        let fo = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
        store_off = fo as i32
      when Projection::TupleIndex(idx) then
        let fo = projected_tuple_offset(ctx, &current_ty, idx)
        store_off = fo as i32
        current_ty = projected_tuple_type(ctx, &current_ty, idx)
      when Projection::ProjIndex(local_id) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
        let idx_elem_ty = project_index_type(ctx, &current_ty)
        let idx_elem_size = element_stride_bytes(ctx, &idx_elem_ty)
        emit_scale_index(ctx, scratch, idx_elem_size)
        emit_add_rrr(ctx, base, base, scratch)
        store_off = 0
        current_ty = idx_elem_ty
      when Projection::ProjConstantIndex(ci) then
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, base, base, 0)
        end
        let celem_ty = project_index_type(ctx, &current_ty)
        store_off = (ci * element_stride_bytes(ctx, &celem_ty)) as i32
        current_ty = celem_ty
      when Projection::Variant(_) then
        # The final store lands on the payload base of the enum image —
        # from the EnumLayout (the CONCRETE enum type), never a hardcoded 8.
        match downcast_variant
        when Option::Some(vid) then
          store_off = enum_payload_base(ctx, &current_ty)
        when Option::None then
          store_off = 0
        end
        current_ty = Type::Int
      when _ then
        store_off = 0
      end

      emit_pop(ctx, src)  # restore value
      # Store exactly the final projected value's storage width so a narrow
      # field/element is never overwritten by an 8-byte write. A
      # @packed-aggregate field at a MISALIGNED static offset (the
      # attributed layout's packed offsets) lowers through the byte-wise
      # UNALIGNED path — never a direct misaligned mov.
      let final_store_width = storage_width_of(ctx, &current_ty)
      if (store_off as Int) % mem_width_bytes(final_store_width) != 0 then
        emit_push(ctx, base)
        emit_add_ri(ctx, base, store_off)
        emit_store_mem_sized_unaligned(ctx, base, src, final_store_width)
        emit_pop(ctx, scratch)
      else
        emit_store_mem_sized(ctx, base, store_off, src, final_store_width)
      end
    end
  when Option::None then
    panic("store_place: unknown local " + place.local.id.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Rvalue code generation
# ———————————————————————————————————————————————————————————————

def codegen_rvalue(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, stmt: MirStatement, dst: PhysReg) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rv) then
    match rv.kind
    when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end

    when MirRvalueKind::MirBinOp(bin_op, left, right) then
      codegen_binop(ctx, fctx, bin_op, left, right, dst)

    when MirRvalueKind::MirUnOp(un_op, operand) then
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, dst)
      when MirUnOp::Not    then
        emit_test_rr(ctx, dst, dst)
        emit_setcc(ctx, CondKind::Eq, dst)
      when MirUnOp::BitNot then emit_not(ctx, dst)
      end

    when MirRvalueKind::MirRef(place) then
      emit_ref_place(ctx, fctx, place, dst)

    when MirRvalueKind::MirAggregate(kind, operands) then
 # the aggregate emitter resolves the concrete layout through
      # the ASSIGN destination's concrete type (the post-mono place type
      # carries the Adt args).
      codegen_aggregate(ctx, fctx, kind, operands, dst, &place_type(ctx, fctx, place))

    when MirRvalueKind::MirDiscriminant(place) then
      load_place(ctx, fctx, place, dst)
      # Normalize via the enum's EnumLayout — the single enum-representation
      # authority (no codegen threshold policy). The enum type comes from the
      # place's own type (the MirDiscriminant reads the enum VALUE word);
 # the CONCRETE type (Adt args included) selects the layout.
      normalize_enum_value_to_tag(ctx, dst, &place_type(ctx, fctx, place))

    when MirRvalueKind::MirLen(place) then
      let len_ty2 = place_type(ctx, fctx, place)
      match strip_receiver_ptr_like_type(&len_ty2)
      when Type::FixedArray(_, n) then
        # Fixed arrays: the length is the compile-time count carried in the
        # TYPE — emit the constant, never a heap-header read.
        emit_mov_ri(ctx, dst, n as i64)
      when _ then
      if is_slice_view_type(ctx, &len_ty2) then
        # UnsafeSlice[T] raw-view len: the len lives in the VIEW's second
        # word, not in a heap header. dst = the view base address (a plain
        # raw-view place is addressed directly; a &UnsafeSlice place derefs
        # its ref slot once).
        emit_place_address(ctx, fctx, place, dst)
        if is_ref_like_type(&len_ty2) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let slice_len_off2 = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
        emit_load_mem(ctx, dst, dst, slice_len_off2 as i32)
      else
      load_place(ctx, fctx, place, dst)
      emit_len_ref_derefs(ctx, dst, &len_ty2)
      let len_value_ty2 = strip_receiver_ptr_like_type(&len_ty2)
      # The len field lives in the heap header — a valid header read only for
      # HeapVecHeader/HeapMapHeader/HeapSetHeader representations (offset from
      # the engine's container_field_offset). Behavior unchanged: the Adt
      # Array form is the heap-vector identity (the fixed arrays are the
      # distinct Type::FixedArray variant), so every array len is a header read.
      if is_heap_collection_type(ctx, &len_value_ty2) then
        let lbl_len_done2 = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, dst, dst)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done2.clone())
        emit_load_mem(ctx, dst, dst, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty2), &"len".to_string()))
        def_label(&mut ctx.text, lbl_len_done2)
      else
        emit_load_mem(ctx, dst, dst, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty2), &"len".to_string()))
      end
      end
      end

    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirRead(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConsume(place) then
      load_place(ctx, fctx, place, dst)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, dst, 1)
        else
          emit_zero_reg(ctx, dst)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, dst, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, dst, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_load_fp_from_stack(ctx, dst, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, dst, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, dst, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, dst, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, dst)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
        emit_load_mem(ctx, dst, dst, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, dst, label.clone())
      end
    end
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
        # cvtsi2sd xmm0, dst (via stack round-trip)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)  # cvtsi2sd xmm0, rax
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)  # movq rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # SCVTF D0, Xn  — convert GPR int to FP D0
        emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
        # FMOV Xdst, D0 — move FP bits back to GPR
        a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)  # movq xmm0, rax
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)  # cvttsd2si rax, xmm0
        when Arch::AArch64 then
        let gpr = match dst
        when PhysReg::A64Reg(r) then r
        when _ then A64::X0
        end
        # FMOV D0, Xn  — move GPR float-bits to FP register
        a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
        # FCVTZS Xdst, D0  — convert FP to int
        emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
      # Narrowing integer casts need an explicit mask; widening is a register no-op here.
      let target_bits = layout_of_strict(&mut ctx.layout_engine, &target_ty).size * 8
      if target_bits < 64 then
        let mask = (1 << target_bits) - 1
        emit_and_ri(ctx, dst, mask as i32)
      end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_rvalue: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(operand, count) then
    # Allocate count * element_size on stack and fill with the value
    let scratch = ret_reg(ctx.target.arch)
    match operand.kind
    when MirOperandKind::MirCopy(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirMovePlace(place) then
      load_place(ctx, fctx, place, scratch)
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirUnit then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirBool(b) then
        if b then
          emit_mov_ri(ctx, scratch, 1)
        else
          emit_zero_reg(ctx, scratch)
        end
      when MirConstantKind::MirInt(i) then
        emit_mov_ri(ctx, scratch, i as i64)
      when MirConstantKind::MirFloat(f) then
        let bits = f.to_bits() as i64
        emit_mov_ri(ctx, scratch, bits)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, scratch)
        emit_load_fp_from_stack(ctx, scratch, sp, -8)
      when MirConstantKind::MirChar(c) then
        emit_mov_ri(ctx, scratch, c as i64)
      when MirConstantKind::MirString(s) then
        let label = intern_string(ctx, s)
        emit_lea_label(ctx, scratch, label)
      when MirConstantKind::MirFnItem(fn_name) then
        emit_lea_label(ctx, scratch, fn_name.clone())
      when MirConstantKind::MirZeroSized then
        emit_zero_reg(ctx, scratch)
      when MirConstantKind::MirStaticRef(did) then
 # the static's DefId resolves to its emission label via the
        # static label table (the name-side symbol-table registration).
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, scratch, label.clone())
        emit_load_mem(ctx, scratch, scratch, 0)
      when MirConstantKind::MirStaticAddr(did) then
        let label = resolve_static_label(ctx, did)
        emit_lea_label(ctx, scratch, label.clone())
      end
    end
    # Store element for each repetition at dst + i * element_size
    let repeat_ty = operand_type(ctx, fctx, &operand)
    let repeat_width = storage_width_of(ctx, &repeat_ty)
    let repeat_stride = element_stride_bytes(ctx, &repeat_ty)
    var i: UInt = 0
    while i < count do
      emit_store_mem_sized(ctx, dst, (i as Int * repeat_stride) as i32, scratch, repeat_width)
      i = i + 1
    end

    when MirRvalueKind::MirPhi(pairs) then
    # Phi nodes: values already placed by predecessor blocks.
    # Skip — no code generation needed.
    ()
    when _ then
      panic("codegen_rvalue: unsupported MIR rvalue kind")
    end
  when _ then
    panic("codegen_rvalue: expected assignment statement")
  end  end
end

def compute_string_locals(func: MirFunction) -> Set[Int]
  var strings: Set[Int] = Set::new()

  for local in func.locals do
    match local.ty
    when Type::String then strings.insert(local.id.id)
    else ()
    end
  end
  for param in func.params do
    match param.ty
    when Type::String then strings.insert(param.id.id)
    else ()
    end
  end

  strings
end

def is_string_operand(op: MirOperand, fctx: FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirString(_) then return true
    else ()
    end
  when MirOperandKind::MirCopy(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirMovePlace(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirRead(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  when MirOperandKind::MirConsume(place) then
    let local_id = place.local.id
    if fctx.string_locals.contains(&local_id) then return true end
    match local_type(fctx, local_id)
    when Type::String then return true
    else ()
    end
  end
  false  end
end

def is_float_operand(op: MirOperand, fctx: FnCodegenCtx) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFloat(_) then return true
    else ()
    end
    match c.ty
    when Type::Float then return true
    when Type::F32 then return true
    when Type::F64 then return true
    when _ then ()
    end
  when MirOperandKind::MirCopy(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirMovePlace(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirRead(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  when MirOperandKind::MirConsume(place) then
    for local in fctx.func.locals do
      if local.id.id == place.local.id then
        match local.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
    for param in fctx.func.params do
      if param.id.id == place.local.id then
        match param.ty
        when Type::Float then return true
        when Type::F32 then return true
        when Type::F64 then return true
        when _ then ()
        end
      end
    end
  end
  false  end
end

# String comparison helper: move operands to arg0/arg1, call inline str_cmp,
# compare result (-1/0/1) with 0, set condition code into dst.
def codegen_str_binop(inout ctx: CodegenCtx, dst: PhysReg, scratch: PhysReg, cond: CondKind) -> Unit
  let arch = ctx.target.arch
  # Move operands to argument registers for codegen_str_cmp
  match arg_reg(arch, 1)
  when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
  when Option::None then ()
  end
  match arg_reg(arch, 0)
  when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
  when Option::None then ()
  end
  # Inline byte-by-byte comparison, result in ret_reg (-1, 0, or 1)
  codegen_str_cmp(ctx)
  let rr = ret_reg(arch)
  # Compare str_cmp result with 0 and set condition flag
  emit_cmp_ri(ctx, rr, 0)
  emit_setcc(ctx, cond, dst)
end

def codegen_binop(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirBinOp, left: MirOperand, right: MirOperand, dst: PhysReg) -> Unit
  let scratch = scratch2_reg(ctx.target.arch)
  load_operand_binop_input(ctx, fctx, left, dst)
  load_operand_binop_input(ctx, fctx, right, scratch)

  let is_float = is_float_operand(left, fctx) || is_float_operand(right, fctx)
  let left_ty = operand_type(ctx, fctx, left)
  let right_ty = operand_type(ctx, fctx, right)
  let left_is_string =
    is_string_operand(left, fctx) ||
    is_string_like_type(ctx, &left_ty) ||
    is_string_like_type(ctx, &strip_ref_like_type(&left_ty))
  let right_is_string =
    is_string_operand(right, fctx) ||
    is_string_like_type(ctx, &right_ty) ||
    is_string_like_type(ctx, &strip_ref_like_type(&right_ty))
  let enum_ty = enum_type_for_operands(ctx, fctx, left, right)
  let enum_is = match enum_ty
  when Type::Unit then false
  when _ then true
  end

  if is_float then
    codegen_float_binop(ctx, op, dst, scratch)
    return
  end

  match op
  when MirBinOp::Add then
    if left_is_string || right_is_string then
 # String concatenation. The operands are String OBJECTS
      # (headers) or static StaticStrPtr constants (raw labels) — normalize to
      # the raw byte form, concatenate, and wrap the raw result into an
      # OWNED String object.
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      let arch = ctx.target.arch
      match arg_reg(arch, 1)
      when Option::Some(arg1) then emit_mov_rr(ctx, arg1, scratch)
      when Option::None then ()
      end
      match arg_reg(arch, 0)
      when Option::Some(arg0) then emit_mov_rr(ctx, arg0, dst)
      when Option::None then ()
      end
      emit_call_label(ctx, "_tg_str_concat")
      let rr = ret_reg(arch)
      emit_mov_rr(ctx, dst, rr)
      codegen_string_wrap_result(ctx)
      emit_mov_rr(ctx, dst, rr)
    else
      emit_add_rrr(ctx, dst, dst, scratch)
    end
  when MirBinOp::Sub    then emit_sub_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Mul    then emit_mul_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Div    then emit_sdiv(ctx, dst, dst, scratch)
  when MirBinOp::Mod    then emit_smod(ctx, dst, dst, scratch)
  when MirBinOp::BitAnd then emit_and_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitOr  then emit_or_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitXor then emit_xor_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Shl    then emit_shl(ctx, dst, dst, scratch)
  when MirBinOp::Shr    then emit_shr(ctx, dst, dst, scratch)
  when MirBinOp::Eq then
    if left_is_string || right_is_string then
 # normalize the String-object operands to their data
      # pointers before the byte comparison (constants stay raw).
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Eq)
    else if enum_is then
 # the compared enum's CONCRETE type (Adt args included) keys
      # the eq helper — Option[u8] and Option[Int] compare distinctly.
      emit_enum_eq_loaded(ctx, &enum_ty, dst, scratch)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Eq, dst)
    end
  when MirBinOp::Ne then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Ne)
    else if enum_is then
      emit_enum_eq_loaded(ctx, &enum_ty, dst, scratch)
      emit_test_rr(ctx, dst, dst)
      emit_setcc(ctx, CondKind::Eq, dst)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ne, dst)
    end
  when MirBinOp::Lt then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Lt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Lt, dst)
    end
  when MirBinOp::Le then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Le)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Le, dst)
    end
  when MirBinOp::Gt then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Gt)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Gt, dst)
    end
  when MirBinOp::Ge then
    if left_is_string || right_is_string then
      if left_is_string then
        codegen_string_operand_to_raw(ctx, fctx, left, dst)
      end
      if right_is_string then
        codegen_string_operand_to_raw(ctx, fctx, right, scratch)
      end
      codegen_str_binop(ctx, dst, scratch, CondKind::Ge)
    else
      emit_cmp_rr(ctx, dst, scratch)
      emit_setcc(ctx, CondKind::Ge, dst)
    end
  end
end

# Float binary operation: operands are in GPRs dst and scratch with float bit patterns.
# Move to FP registers D0/D1, compute, move result back to dst GPR.
def codegen_float_binop(inout ctx: CodegenCtx, op: MirBinOp, dst: PhysReg, scratch: PhysReg) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Move GPR float-bits to FP registers: D0 = dst, D1 = scratch
    let dst_gpr = match dst
    when PhysReg::A64Reg(r) then r
    when _ then A64::X0
    end
    let scratch_gpr = match scratch
    when PhysReg::A64Reg(r) then r
    when _ then A64::X14
    end
    a64_fmov_dx(&mut ctx.text, A64V::V0, dst_gpr)
    a64_fmov_dx(&mut ctx.text, A64V::V1, scratch_gpr)
    match op
    when MirBinOp::Add then a64_fadd_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Sub then a64_fsub_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Mul then a64_fmul_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Div then a64_fdiv_ddd(&mut ctx.text, A64V::V0, A64V::V0, A64V::V1)
    when MirBinOp::Eq then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, EQ  (CSINC Xd, XZR, XZR, NE)
      emit_raw_u32(ctx, 0x9A9F17E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ne then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, NE  (CSINC Xd, XZR, XZR, EQ)
      emit_raw_u32(ctx, 0x9A9F07E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Lt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, MI  (CSINC Xd, XZR, XZR, PL)  — MI = float less than
      emit_raw_u32(ctx, 0x9A9F57E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Le then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, LS  (CSINC Xd, XZR, XZR, HI)  — LS = float less or equal
      emit_raw_u32(ctx, 0x9A9F87E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Gt then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GT  (CSINC Xd, XZR, XZR, LE)
      emit_raw_u32(ctx, 0x9A9FD7E0 | a64_code(dst_gpr))
      return
    when MirBinOp::Ge then
      a64_fcmp_dd(&mut ctx.text, A64V::V0, A64V::V1)
      # CSET dst, GE  (CSINC Xd, XZR, XZR, LT)
      emit_raw_u32(ctx, 0x9A9FB7E0 | a64_code(dst_gpr))
      return
    when _ then
      # Fallback: treat as integer op
      emit_add_rrr(ctx, dst, dst, scratch)
      return
    end
    # Move FP result back to GPR
    a64_fmov_xd(&mut ctx.text, dst_gpr, A64V::V0)
  when Arch::X86_64 then
    # x86-64: move GPR float-bits to XMM0/XMM1 via stack
    let sp = sp_reg(ctx.target.arch)
    # Store dst to stack, load as xmm0
    emit_store_mem(ctx, sp, -8, dst)
    # movsd xmm0, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    # Store scratch to stack, load as xmm1
    emit_store_mem(ctx, sp, -8, scratch)
    # movsd xmm1, [rsp-8]
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x10)
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    match op
    when MirBinOp::Add then
      # addsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x58)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Sub then
      # subsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5C)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Mul then
      # mulsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x59)
      emit8(&mut ctx.text, 0xC1)
    when MirBinOp::Div then
      # divsd xmm0, xmm1
      emit8(&mut ctx.text, 0xF2)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x5E)
      emit8(&mut ctx.text, 0xC1)
    when _ then ()
    end
    # Move xmm0 result back to GPR via stack: movsd [rsp-8], xmm0
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x11)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x24)
    emit8(&mut ctx.text, 0xF8)
    emit_load_mem(ctx, dst, sp, -8)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Place-address primitive — CANONICAL place-addressing entry point.
#
# Computes the byte ADDRESS of `place` into register `dst`. For a
# zero-projection place this is the address of the local's storage; for a
# projected place it walks the projection chain, following pointer-typed
# (struct/collection/reference) intermediates by LOADING their stored value
# and applying the final projection as a pure offset so that the result is
# the address of the field/component slot itself.
#
# Every place-based operation is built on top of this single primitive so
# loads, stores, borrows and method receivers all agree on nested field
# addressing:
#   emit_load_place        = emit_place_address + dereference value
#   emit_store_place       = emit_place_address + store
#   emit_ref_place         = emit_place_address (a reference is an address)
#   emit_method_receiver   = emit_place_address (receiver borrows the place)
# ———————————————————————————————————————————————————————————————
def emit_place_address(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)

  if place.projections.is_empty() then
    # No projections: return stack address of the local.
    # Method intrinsics dereference &self once to obtain the underlying value.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        let spill_off = fctx.frame.spill_offset - 8
        fctx.frame.spill_offset = spill_off
        emit_store_mem(ctx, fp, spill_off, r)
        emit_lea_fp(ctx, dst, spill_off)
      when VarLoc::Stack(offset) then
        emit_lea_fp(ctx, dst, offset)
      when VarLoc::Spilled(offset) then
        emit_lea_fp(ctx, dst, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end
  else
    # Has projections (e.g. opts.input_files): load the local value,
    # apply all projections except the last one normally (load), and for
    # the last one compute the address without loading the value.
    # This way the intrinsic's single dereference of &self reaches the
    # correct heap object (e.g. Vec struct) rather than the parent struct.
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then emit_mov_rr(ctx, dst, r)
      when VarLoc::Stack(offset) then emit_load_mem(ctx, dst, fp, offset)
      when VarLoc::Spilled(offset) then emit_load_mem(ctx, dst, fp, offset)
      end
    when Option::None then
      panic("address_of: unknown local")
    end

    var current_ty = local_type(fctx, place.local.id)
    let n = place.projections.len()
    var downcast_variant: Option[VariantId] = Option::None
    var i = 0
    # Label to skip remaining projections after a payload-less inline-tag
    # Variant downcast (the EnumLayout's TaggedPtr encoding: a raw
    # discriminant below the threshold has no heap-allocated payload struct
    # to compute addresses into).
    let lbl_skip_addr = next_codegen_label(ctx, ".Lskip_addr_proj.")
    while i < n do
      let proj = place.projections[i]
      let is_last = i == n - 1
      # Downcast payload safety is handled in the Variant arm below.
      match proj
      when Projection::ProjDeref then ()
      when _ then
        if is_ref_like_type(&current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
          current_ty = project_deref_type(ctx, &current_ty)
        end
      end
      match proj
      when Projection::ProjDeref then
        if !is_last then
          emit_load_mem(ctx, dst, dst, 0)
        end
        current_ty = project_deref_type(ctx, &current_ty)
      when Projection::Field(fid) then
 # the offset comes from the layout engine, resolved through
 # the CONCRETE projected type.
        let offset = projected_field_offset(ctx, &fid, &downcast_variant, &current_ty)
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          emit_load_mem(ctx, dst, dst, offset as i32)
        end
        current_ty = projected_field_type(ctx, &fid, &downcast_variant, &current_ty)
      when Projection::TupleIndex(idx) then
        let offset = projected_tuple_offset(ctx, &current_ty, idx)
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          emit_load_mem(ctx, dst, dst, offset as i32)
        end
        current_ty = projected_tuple_type(ctx, &current_ty, idx)
      when Projection::ProjIndex(local_id) then
        let is_byte_indexed = is_string_like_type(ctx, &current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let idx_reg = scratch2_reg(ctx.target.arch)
        load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, idx_reg)
        if !is_byte_indexed then
          # Scale the index by the element's TRUE storage stride — the
          # single codegen-side element-index scaler (1/2/4/8 shifts, a
          # multiply for any other stride — inline FixedArray elements).
          let elem_ty = project_index_type(ctx, &current_ty)
          let elem_stride = element_stride_bytes(ctx, &elem_ty)
          emit_scale_index(ctx, idx_reg, elem_stride)
        end
        emit_add_rrr(ctx, dst, dst, idx_reg)
        if !is_last then
          if is_byte_indexed then
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, 0)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::ProjConstantIndex(ci) then
        let is_byte_indexed = is_string_like_type(ctx, &current_ty)
        if is_heap_collection_type(ctx, &current_ty) then
          emit_load_mem(ctx, dst, dst, 0)
        end
        let ci_elem_ty = project_index_type(ctx, &current_ty)
        let ci_stride = element_stride_bytes(ctx, &ci_elem_ty)
        let offset = if is_byte_indexed then ci else ci * ci_stride end
        if is_last then
          if offset != 0 then
            emit_add_ri(ctx, dst, offset as i32)
          end
        else
          if is_byte_indexed then
            if offset != 0 then
              emit_add_ri(ctx, dst, offset as i32)
            end
            match dst
            when PhysReg::A64Reg(a) then a64_ldrb(&mut ctx.text, a, a, 0)
            when PhysReg::X64Reg(_) then emit_load_mem(ctx, dst, dst, 0)
            end
          else
            emit_load_mem(ctx, dst, dst, offset as i32)
          end
        end
        current_ty = project_index_type(ctx, &current_ty)
      when Projection::Variant(vid) then
        downcast_variant = Option::Some(vid)
        # Same layout-driven payload rule as apply_projections: the
        # threshold and payload offset come from the enum's EnumLayout
        # (never codegen policy). The VariantId carries the enum OWNER +
 # the variant's DECLARATION index. the EnumLayout resolves
        # through the CONCRETE enum type (current_ty carries the Adt args).
        let pa_el = enum_layout_strict(ctx, &current_ty)
        match pa_el.representation
        when EnumValueRepresentation::TaggedPtr(threshold) then
          let lbl_payload_skip = next_codegen_label(ctx, ".Lpayload_skip.")
          let lbl_payload_done = next_codegen_label(ctx, ".Lpayload_done.")
          emit_cmp_ri(ctx, dst, threshold)
          emit_jcc(ctx, CondKind::Lt, lbl_payload_skip.clone())
          emit_add_ri(ctx, dst, pa_el.payload_offset)
          emit_jmp(ctx, lbl_payload_done.clone())
          def_label(&mut ctx.text, lbl_payload_skip)
          # Inline tag: no heap payload exists. Materialize a safe stack-backed
          # sentinel address so downstream code never dereferences a null pointer.
          let null_off = fctx.frame.spill_offset - 8
          fctx.frame.spill_offset = null_off
          let zero = scratch_reg(ctx.target.arch)
          emit_zero_reg(ctx, zero)
          emit_store_mem(ctx, fp, null_off, zero)
          emit_lea_fp(ctx, dst, null_off)
          # If there are remaining projections after the downcast, skip them.
          # An inline tag has no heap-allocated payload struct, so subsequent
          # projections would dereference null and crash.
          if !is_last then
            emit_jmp(ctx, lbl_skip_addr.clone())
          end
          def_label(&mut ctx.text, lbl_payload_done)
        when EnumValueRepresentation::InlineTagged then
          # The value is the inline image: payload at payload_offset.
          emit_add_ri(ctx, dst, pa_el.payload_offset)
        when EnumValueRepresentation::Opaque then
          panic("ICE: emit_place_address: Variant downcast on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&current_ty))
        end
      end
      i = i + 1
    end
    def_label(&mut ctx.text, lbl_skip_addr)
  end
end

# Resolve a struct field's declared byte offset by NAME (not position).
# The aggregate's operands are emitted in the struct-literal's stated order,
# which may differ from the type's declaration order. Positional indexing
# (offsets[i]) misplaces every field when the literal reorders fields, so we
# must map each operand to the declared offset of the field it names.
# the offsets table is CONCRETE-keyed — `ty` is the aggregate's
# concrete Type (Adt with args), so a generic struct literal (Wrapper[u8])
# resolves its field offsets through the Wrapper[u8] entry.
def struct_field_offset_by_name(ctx: CodegenCtx, ty: Type, field_name: String) -> Int
  let type_id = extract_named_type_id(ctx, ty)
  let ckey = mir_type_identity_key(ty)
  match lookup_type_def(ctx, type_id)
  when Option::Some(td) then
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      var idx = 0
      while idx < fields.len() do
        if fields[idx].name == field_name then
          match ctx.type_field_offsets.get(ckey)
          when Option::Some(offsets) then
            if idx < offsets.len() then
              return offsets[idx]
            end
          when Option::None then ()
          end
          return -1
        end
        idx = idx + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end
  -1
end

# Load the VALUE of `place` into `dst`. For a zero-projection place this is a
# plain move/load of the local; for a projected place it composes the canonical
# address primitive with a single dereference of the final slot.
def emit_load_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  if place.projections.is_empty() then
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, dst, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, dst, fp, offset)
      end
    when Option::None then
      panic("emit_load_place: unknown local " + place.local.id.to_string())
    end
  else
    emit_place_address(ctx, fctx, place, dst)
    # Load exactly the final projected value's storage width. A
    # @packed-aggregate field at a MISALIGNED static offset (the
    # attributed layout's packed offsets) lowers through the byte-wise
    # UNALIGNED path — never a direct misaligned mov.
    let pty = place_type(ctx, fctx, place)
    let pwidth = storage_width_of(ctx, &pty)
    let pext = storage_signedness_of(&pty)
    if place_access_is_unaligned(ctx, fctx, place, pwidth) then
      emit_load_mem_sized_unaligned(ctx, dst, dst, pwidth, pext)
    else
      emit_load_mem_sized(ctx, dst, dst, 0, pwidth, pext)
    end
  end
end

# Store `src` into `place`. Computes the place address through the canonical
# primitive (preserving `src` across the address walk) and stores into it.
def emit_store_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  if place.projections.is_empty() then
    match fctx.var_locs.get(place.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    when Option::None then
      panic("emit_store_place: unknown local " + place.local.id.to_string())
    end
  else
    # Compute the place address into a distinct register so popping `src`
    # does not clobber the computed base.
    let base = scratch2_reg(ctx.target.arch)
    emit_push(ctx, src)
    emit_place_address(ctx, fctx, place, base)
    emit_pop(ctx, src)
    # Store exactly the place's final storage width. A @packed-aggregate
    # field at a MISALIGNED static offset (the attributed layout's packed
    # offsets) lowers through the byte-wise UNALIGNED path — never a
    # direct misaligned mov.
    let pty = place_type(ctx, fctx, place)
    let pwidth = storage_width_of(ctx, &pty)
    if place_access_is_unaligned(ctx, fctx, place, pwidth) then
      emit_store_mem_sized_unaligned(ctx, base, src, pwidth)
    else
      emit_store_mem_sized(ctx, base, 0, src, pwidth)
    end
  end
end

# Take a reference (borrow) of `place`: a reference to a place is exactly its
# address. Used to lower MirRef.
def emit_ref_place(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  emit_place_address(ctx, fctx, place, dst)
end

# Compute the method receiver for a call on `place`. A method receiver is the
# borrow (&self / &mut self) of the receiver place, so it is the place address.
def emit_method_receiver(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, dst: PhysReg) -> Unit
  emit_place_address(ctx, fctx, place, dst)
end

def codegen_aggregate(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, kind: AggregateKind, operands: Vec[MirOperand], dst: PhysReg, agg_ty: Type) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = scratch2_reg(ctx.target.arch)
  let sp = sp_reg(ctx.target.arch)

  # Array literals must produce a Vec-compatible structure {data_ptr, len, cap}
  # so that for-loop iteration (ProjDeref + MirLen + ProjIndex) works correctly.
  match kind
  when AggregateKind::MirArray(arr_ty) then
    match arr_ty
    when Type::FixedArray(elem, n) then
      # Fixed-array literal: INLINE stores at i * stride — no heap. dst is
      # the BASE ADDRESS of the destination slot (the statement emitter
      # arranged it via emit_place_address); each operand is stored at
      # [dst + i * stride] with the element's storage width. A zero-length
      # array (n == 0) emits nothing.
      let fa_elem_size = layout_of_strict(&mut ctx.layout_engine, &elem).size
      let fa_elem_align = layout_of_strict(&mut ctx.layout_engine, &elem).align
      let fa_stride = align_up_int(fa_elem_size, fa_elem_align)
      let fa_width = storage_width_of(ctx, &elem)
      emit_push(ctx, dst)
      var op_idx = 0
      while op_idx < operands.len() do
        load_operand_aggregate_item(ctx, fctx, &operands[op_idx], scratch)
        emit_load_mem(ctx, dst, sp, 0)
        emit_store_mem_sized(ctx, dst, (op_idx * fa_stride) as i32, scratch, fa_width)
        op_idx = op_idx + 1
      end
      emit_load_mem(ctx, dst, sp, 0)
      emit_pop(ctx, scratch)
      return
    when _ then ()
    end
    # Heap-vector array literal: build through the same runtime path used by
    # Vec::new()+push. The header stride comes from the CONCRETE element
    # type of the literal (arr_ty = Array[T]).
    let lit_elem_ty = vec_elem_type_of(ctx, &arr_ty)
    let lit_stride = element_stride_bytes(ctx, &lit_elem_ty)
    emit_mov_ri(ctx, ret_reg(ctx.target.arch), lit_stride as i64)
    emit_call_label(ctx, "_tg_array_new")
    emit_push(ctx, dst)

    var op_idx = 0
    while op_idx < operands.len() do
      # The element crosses per its value category: Scalar -> the value
      # word; ScalarPair/ByAddress -> the element image ADDRESS (the
      # runtime byte-copies the full image). The slot is arg1 (x1/rsi).
      let lit_op_ty = operand_type(ctx, fctx, &operands[op_idx])
      let elem_slot = match arg_reg(ctx.target.arch, 1)
      when Option::Some(r) then r
      when Option::None then panic("codegen_aggregate: no element ABI slot register")
      end
      codegen_collection_elem_transfer_operand(ctx, fctx, &lit_op_ty, &operands[op_idx], elem_slot)
      emit_load_mem(ctx, dst, sp, 0)
      emit_call_label(ctx, "_tg_array_push")
      op_idx = op_idx + 1
    end

    emit_load_mem(ctx, dst, sp, 0)
    emit_pop(ctx, scratch)
    return
  when _ then ()
  end

  # Determine total size and per-field offsets based on the aggregate kind.
  # For named structs the aggregate carries the field NAMES in literal order;
  # codegen must resolve each operand to its DECLARED offset by name, because
  # the literal order may differ from the type declaration order.
 # the concrete aggregate type (agg_ty — the assign destination's
  # post-mono type, Type::Adt with args) keys every layout/offset lookup;
  # a generic struct literal (Wrapper[u8]) resolves through its own entry.
  let type_id = extract_named_type_id(ctx, agg_ty)
  let ckey = mir_type_identity_key(agg_ty)
  let struct_field_names = match kind
  when AggregateKind::Struct(_, names) then Option::Some(names)
  when _ then Option::None
  end

  # Look up the type name to detect collection types that need heap allocation
  var type_name = match lookup_type_def(ctx, type_id)
  when Option::Some(td) then td.name.clone()
  when Option::None then ""
  end

  # For collection types (Vec, Map, Set), use runtime heap allocation instead
  # of stack allocation.  These types must survive function returns, and their
  # runtime functions (e.g. _tg_array_push) expect the struct to live on the heap.
  if type_name == "Vec" || type_name == "Array" then
    # A struct LITERAL of type Vec/Array carries no element-type information
    # here (the AggregateKind has only the TypeId, not the Adt args), so the
    # element stride for _tg_array_new is unknowable. No source constructs
    # this shape (Vec/Array values come from the __intrinsic_array_* calls);
    # fail closed rather than fabricate a stride.
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete element type to derive the Vec stride from")
  else if type_name == "Map" || type_name == "HashMap" then
    # The runtime map contract needs the CONCRETE K/V layout parameters at
    # creation (map_new receives key_stride/key_align/value_stride/
    # value_align); a struct-literal aggregate carries only the TypeId, so
    # the layout is unknowable here. No source constructs this shape (Map
    # values come from the __intrinsic_map_* calls); fail closed rather
    # than fabricate a layout.
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete K/V layout to derive the map layout from")
  else if type_name == "Set" || type_name == "HashSet" then
    panic("internal error: struct-literal aggregate of type `" + type_name + "` has no concrete element layout to derive the map layout from")
  end

  # Try to get field offsets from the type layout (CONCRETE-keyed)
  let has_layout = match ctx.type_field_offsets.get(ckey)
  when Option::Some(_) then true
  when Option::None then false
  end

  # Calculate total size. A missing layout for a concrete aggregate is a
  # compiler invariant violation — it must ICE, never guess 8 bytes/field.
  let total_size = match ctx.type_layout.get(ckey)
  when Option::Some(sz) then sz
  when Option::None then panic("codegen_aggregate: no layout recorded for type " + ckey)
  end
  let aligned = align_up_int(total_size, 8)

  # Heap-allocate struct data via bump allocator so the pointer survives
  # function returns.  Stack-allocating in the callee spill area would create
  # a dangling pointer when the struct escapes via return value.
  emit_mov_ri(ctx, dst, aligned as i64)
  emit_call_label(ctx, "_tg_bump_alloc")
  # After call: dst (x0/rax) = heap pointer to allocated memory. Preserve it
  # with a balanced stack push while operand lowering may make calls/clobber dst.
  emit_push(ctx, dst)

  # Store each field at its proper offset
  let enum_discriminant = if type_id >= 0 && is_enum_type_id(ctx, type_id) && operands.len() > 0 then
    match operands[0].kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(disc) then disc
      when _ then -1
      end
    when _ then -1
    end
  else
    -1
  end

  var i = 0
  while i < operands.len() do
    load_operand_aggregate_item(ctx, fctx, &operands[i], scratch)
    emit_load_mem(ctx, dst, sp, 0)
    let field_off = if enum_discriminant >= 0 then
      if i == 0 then
        0
      else
        # Payload base comes from the EnumLayout (the single enum
        # authority), never a hardcoded 8; the per-variant field offsets
        # are payload-relative from the same authority. The variant index
        # is derived from the operand's discriminant via the enum def
 # (declaration order — VariantId semantics). resolved
        # through the CONCRETE enum type (agg_ty carries the Adt args).
        enum_payload_base(ctx, agg_ty) + enum_field_offset_for_variant_index(ctx, agg_ty, enum_variant_index_of_discriminant(ctx, agg_ty, enum_discriminant), i - 1)
      end
    else if has_layout then
      # Named struct: resolve the declared offset of the field this operand names.
      # This is correct even when the literal lists fields in a different order
      # than the struct declaration (positional offsets[i] would misplace them).
      # A missing/unknown field or a missing layout is a compiler invariant
      # violation and must fail compilation, never fall back to `i * 8`.
      match struct_field_names
      when Option::Some(names) then
        let off = struct_field_offset_by_name(ctx, agg_ty, &names[i])
        if off >= 0 then off else panic("codegen_aggregate: unknown struct field '" + names[i] + "' for type " + ckey) end
      when Option::None then
        match ctx.type_field_offsets.get(ckey)
        when Option::Some(offsets) then
          if i < offsets.len() then offsets[i] else panic("codegen_aggregate: field index " + i.to_string() + " out of range for type " + ckey) end
        when Option::None then panic("codegen_aggregate: no field offsets for type " + ckey)
        end
      end
    else
      panic("codegen_aggregate: no layout for concrete aggregate of type " + ckey)
    end
    # Store exactly the field's storage width so adjacent narrow fields are not
    # corrupted by an 8-byte write. A @packed-aggregate field at a
    # MISALIGNED offset (the attributed layout's packed offsets) lowers
    # through the byte-wise UNALIGNED path — never a direct misaligned mov.
    let field_ty = operand_type(ctx, fctx, &operands[i])
    let field_width = storage_width_of(ctx, &field_ty)
    if (field_off % mem_width_bytes(field_width)) != 0 then
      # The aggregate base is 8/16-aligned; the field's own static offset
      # decides the alignment (the aggregate-literal store path carries no
      # runtime base, so the field offset alone is the check).
      emit_push(ctx, dst)
      emit_add_ri(ctx, dst, field_off as i32)
      emit_store_mem_sized_unaligned(ctx, dst, scratch, field_width)
      emit_pop(ctx, scratch)
    else
      emit_store_mem_sized(ctx, dst, field_off as i32, scratch, field_width)
    end
    i = i + 1
  end
  emit_load_mem(ctx, dst, sp, 0)
  emit_pop(ctx, scratch)
end

# ———————————————————————————————————————————————————————————————
# Statement code generation
# ———————————————————————————————————————————————————————————————

def codegen_statement(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, block: MirBlock, stmt_idx: Int) -> Unit
  let stmt = block.statements[stmt_idx]
  let rr = ret_reg(ctx.target.arch)
  match stmt.kind
  when MirStatementKind::MirAssign(place, MirRvalue { kind: rvalue_kind }) then
    var should_store = true
    match rvalue_kind
    when MirRvalueKind::MirPhi(pairs) then
      should_store = false

    when MirRvalueKind::MirMove(op) then
      # Whole-value moves/copies are classified by the value-category
      # authority (classify_value_category — the layout engine), never by a
      # register/8-byte-word guess:
      #   ZeroSized          -> no payload: nothing to copy
      #   Scalar(width)      -> one register word (the pre-existing path)
      #   ScalarPair(w1, w2) -> TWO words: the 16-byte raw UnsafeSlice view
      #                         { ptr, len } and other 16-byte aggregates
      #                         (the raw view keeps emitting exactly the
      #                         two-word copy it always has; the
      #                         single-register path would copy only the ptr
      #                         word and leave len stale)
      #   ByAddress(size)    -> a >16-byte inline aggregate (fixed arrays,
      #                         large structs): the full layout byte size is
      #                         copied — a 40-byte value is NOT an
      #                         eight-byte value
      # When a copy emitter runs, the trailing value store is skipped (rr no
      # longer carries the value).
      match classify_value_category(&mut ctx.layout_engine, &operand_type(ctx, fctx, op))
      when Result::Err(e) then
        panic("ICE: move/copy classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
      when Result::Ok(ValueCategory::ZeroSized) then
        should_store = false
      when Result::Ok(ValueCategory::Scalar(_)) then
        load_operand_rvalue_item(ctx, fctx, op, rr)
      when Result::Ok(ValueCategory::ScalarPair(_, _)) then
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, 16)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      when Result::Ok(ValueCategory::Vector(w)) then
        # A SIMD vector value (the 16/32/64-byte vector row): the FULL
        # image is byte-copied — the vector never travels through the
        # scalar value register.
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, w)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      when Result::Ok(ValueCategory::ByAddress(sz)) then
        match op.kind
        when MirOperandKind::MirCopy(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirMovePlace(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirRead(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when MirOperandKind::MirConsume(p) then
          emit_aggregate_value_copy(ctx, fctx, p, place, sz)
          should_store = false
        when _ then
          load_operand_rvalue_item(ctx, fctx, op, rr)
        end
      end

    when MirRvalueKind::MirBinOp(bin_op, left, right) then
      codegen_binop(ctx, fctx, bin_op, left, right, rr)

    when MirRvalueKind::MirUnOp(un_op, operand) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match un_op
      when MirUnOp::Neg    then emit_neg(ctx, rr)
      when MirUnOp::Not    then
        emit_test_rr(ctx, rr, rr)
        emit_setcc(ctx, CondKind::Eq, rr)
      when MirUnOp::BitNot then emit_not(ctx, rr)
      end

    when MirRvalueKind::MirRef(ref_place) then
      emit_ref_place(ctx, fctx, ref_place, rr)

    when MirRvalueKind::MirAggregate(kind, operands) then
      # The FixedArray-typed aggregate (the dest-aware array-literal path)
      # is INLINE storage: the aggregate emitter stores each element at
      # i * stride into the DESTINATION SLOT directly, so rr must be the
      # place address and the trailing value store is skipped. Every other
      # aggregate (including the heap-vector array literal) keeps the
      # value-in-register path (codegen_aggregate — _tg_array_new +
      # _tg_array_push for the heap literal).
      let agg_is_fixed = match kind
      when AggregateKind::MirArray(arr_ty) then
        match arr_ty
        when Type::FixedArray(_, _) then true
        when _ then false
        end
      when _ then false
      end
      if agg_is_fixed then
        should_store = false
        emit_place_address(ctx, fctx, place, rr)
        codegen_aggregate(ctx, fctx, kind, operands, rr, &place_type(ctx, fctx, place))
      else
        codegen_aggregate(ctx, fctx, kind, operands, rr, &place_type(ctx, fctx, place))
      end

    when MirRvalueKind::MirDiscriminant(discr_place) then
      load_place(ctx, fctx, discr_place, rr)
      # Normalize via the enum's EnumLayout — the single enum-representation
 # authority (no codegen threshold policy). the CONCRETE enum
      # type (Adt args included) selects the layout.
      normalize_enum_value_to_tag(ctx, rr, &place_type(ctx, fctx, discr_place))

    when MirRvalueKind::MirLen(len_place) then
      let len_ty = place_type(ctx, fctx, len_place)
      match strip_receiver_ptr_like_type(&len_ty)
      when Type::FixedArray(_, n) then
        # Fixed arrays: the length is the compile-time count carried in the
        # TYPE — emit the constant, never a heap-header read.
        emit_mov_ri(ctx, rr, n as i64)
      when _ then
      if is_slice_view_type(ctx, &len_ty) then
        # UnsafeSlice[T] raw-view len: the len lives in the VIEW's second
        # word, not in a heap header. rr = the view base address (a plain
        # raw-view place is addressed directly; a &UnsafeSlice place derefs
        # its ref slot once), then read [base + len_off].
        emit_place_address(ctx, fctx, len_place, rr)
        if is_ref_like_type(&len_ty) then
          emit_load_mem(ctx, rr, rr, 0)
        end
        let slice_len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
        emit_load_mem(ctx, rr, rr, slice_len_off as i32)
      else
      load_place(ctx, fctx, len_place, rr)
      let len_value_ty = strip_receiver_ptr_like_type(&len_ty)
      emit_len_ref_derefs(ctx, rr, &len_ty)
      # The len field lives in the heap header — a valid header read only for
      # HeapVecHeader/HeapMapHeader/HeapSetHeader representations (offset from
      # the engine's container_field_offset). Behavior unchanged: the Adt
      # Array form is the heap-vector identity (the fixed arrays are the
      # distinct Type::FixedArray variant), so every array len is a header read.
      if is_heap_collection_type(ctx, &len_value_ty) then
        # Null collection pointers represent empty values in native bootstrap
        # paths; avoid dereferencing [0 + 8] and keep zero length.
        let lbl_len_done = next_codegen_label(ctx, ".Lmir_len_done.")
        emit_test_rr(ctx, rr, rr)
        emit_jcc(ctx, CondKind::Eq, lbl_len_done.clone())
        emit_load_mem(ctx, rr, rr, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty), &"len".to_string()))
        def_label(&mut ctx.text, lbl_len_done)
      else
        emit_load_mem(ctx, rr, rr, heap_header_field_offset(codegen_type_repr(ctx, &len_value_ty), &"len".to_string()))
      end
      end
      end

    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
      load_operand_rvalue_item(ctx, fctx, operand, rr)
      match cast_kind
      when CastKind::IntToFloat then
        match ctx.target.arch
        when Arch::X86_64 then
          let sp = sp_reg(ctx.target.arch)
          emit_store_mem(ctx, sp, -8, rr)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          emit_raw_u32(ctx, 0x9E620000 | (a64_code(gpr) << 5) | 0)
          a64_fmov_xd(&mut ctx.text, gpr, A64V::V0)
        end
      when CastKind::FloatToInt then
        match ctx.target.arch
        when Arch::X86_64 then
          emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)
          emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)
        when Arch::AArch64 then
          let gpr = match rr
          when PhysReg::A64Reg(r) then r
          when _ then A64::X0
          end
          a64_fmov_dx(&mut ctx.text, A64V::V0, gpr)
          emit_raw_u32(ctx, 0x9E780000 | (0 << 5) | a64_code(gpr))
        end
      when CastKind::IntToInt then
        let target_bits = layout_of_strict(&mut ctx.layout_engine, target_ty).size * 8
        if target_bits < 64 then
          let mask = (1 << target_bits) - 1
          emit_and_ri(ctx, rr, mask as i32)
        end
      when CastKind::FloatToFloat then ()
      when CastKind::Pointer then ()
      when CastKind::Transmute then ()
      when _ then
        panic("codegen_statement: unsupported cast kind")
      end

    when MirRvalueKind::MirRepeat(operand, count) then
      let scratch = ret_reg(ctx.target.arch)
      load_operand_rvalue_item(ctx, fctx, operand, scratch)
      let rpty = operand_type(ctx, fctx, operand)
      let rpwidth = storage_width_of(ctx, &rpty)
      let rpstride = element_stride_bytes(ctx, &rpty)
      var i: UInt = 0
      while i < count do
        emit_store_mem_sized(ctx, rr, (i as Int * rpstride) as i32, scratch, rpwidth)
        i = i + 1
      end

    when _ then
      panic("codegen_statement: unsupported MIR rvalue kind")
    end

    if should_store then
      store_place(ctx, fctx, place, rr)
    end

  when MirStatementKind::MirStorageLive(_) then ()
  when MirStatementKind::MirStorageDead(_) then ()
  when MirStatementKind::MirNop then ()

  when MirStatementKind::MirContractCheck(contract, cond) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ok_label = ".Lcontract_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ne, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirBudgetConsume(resource, amount) then
    # REAL budget enforcement: the budget state lives in THIS invocation's
    # STACK FRAME (the slots allocate_locals reserved — FrameInfo's
    # budget_alloc_offset / budget_time_offset), never in global .data, so
    # two calls of the same budgeted function never share a counter, nested
    # and recursive budgeted calls each get their own frame slots, and
    # concurrent calls on per-thread stacks cannot race. The amount payload
    # is the function's DECLARED LIMIT for the resource (the typed budget's
    # bound); the limit exceeded -> the runtime traps (budget exhausted).
    let fp = fp_reg(ctx.target.arch)
    let scratch = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    if resource == "time" then
      # The time metric's exit check: elapsed = now - entry stamp (the
      # frame slot the __tg_budget_time_start record stamped at entry);
      # trap when elapsed exceeds the declared limit.
      if fctx.frame.budget_time_offset == 0 then
        # Fail-closed: a time consume in a function whose frame carries no
        # time slot is a lowering defect, never a silent [FP+0] write.
        emit_trap(ctx)
      else
        emit_call_direct(ctx, "__tg_clock_ns".to_string())
        emit_load_mem(ctx, scratch2, fp, fctx.frame.budget_time_offset)
        emit_sub_rrr(ctx, rr, rr, scratch2)
        emit_mov_ri(ctx, scratch, amount as i64)
        emit_cmp_rr(ctx, rr, scratch)
        let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
        ctx.fn_counter = ctx.fn_counter + 1
        emit_jcc(ctx, CondKind::Le, ok_label.clone())
        emit_trap(ctx)
        def_label(&mut ctx.text, ok_label)
      end
    elsif resource == "alloc" then
      # The allocation metric's consume: increment this invocation's
      # frame-slot counter by one; trap when it exceeds the limit.
      if fctx.frame.budget_alloc_offset == 0 then
        # Fail-closed: an alloc consume without a reserved frame slot is a
        # lowering defect (the slot scan is the authority), never a
        # silent [FP+0] write.
        emit_trap(ctx)
      else
        emit_load_mem(ctx, scratch2, fp, fctx.frame.budget_alloc_offset)
        emit_add_ri(ctx, scratch2, 1)
        emit_store_mem(ctx, fp, fctx.frame.budget_alloc_offset, scratch2)
        emit_mov_ri(ctx, rr, amount as i64)
        emit_cmp_rr(ctx, scratch2, rr)
        let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
        ctx.fn_counter = ctx.fn_counter + 1
        emit_jcc(ctx, CondKind::Le, ok_label.clone())
        emit_trap(ctx)
        def_label(&mut ctx.text, ok_label)
      end
    else
      # Any other resource the lowering never emits (the budget discipline
      # only constructs "alloc"/"time" consumes — budget_metric_enforced)
      # is a lowering defect: fail closed with a trap.
      emit_trap(ctx)
    end

  when MirStatementKind::MirEffectRecord(name, operand) then
    if name == "__tg_budget_time_start" then
      # REAL time-budget ENTRY: stamp THIS invocation's time slot (the
      # frame slot allocate_locals reserved) with the monotonic clock
      # (__tg_clock_ns — the clock_gettime runtime helper) — the exit
      # MirBudgetConsume("time", _) compares the elapsed clock against the
      # declared limit. Per-invocation semantics: the slot belongs to this
      # frame, so nested/recursive budgeted calls stamp their own slots.
      # (The fail-closed placeholder arm became the real check; the
      # __tg_effect_record effect LOG itself remains a trap stub — no
      # source lowering constructs effect records.)
      if fctx.frame.budget_time_offset == 0 then
        emit_trap(ctx)
      else
        let fp = fp_reg(ctx.target.arch)
        emit_call_direct(ctx, "__tg_clock_ns".to_string())
        emit_store_mem(ctx, fp, fctx.frame.budget_time_offset, rr)
      end
    else
      # Record an effect by pushing it to the effect log
      # Call __tg_effect_record(name_ptr, value)
      let scratch = scratch_reg(ctx.target.arch)
      
      # Load the effect value into result register
      load_operand_control_input(ctx, fctx, operand, rr)
      
      # Load effect name string address
      let name_label = intern_string(ctx, name)
      emit_lea_global(ctx, name_label, scratch)
      
      # Set up call arguments (ABI: scratch = name_ptr, rr = value)
      # Move arguments to proper registers for the call
      match arg_reg(ctx.target.arch, 0)
      when Option::Some(arg0) then
        match arg_reg(ctx.target.arch, 1)
        when Option::Some(arg1) then
          emit_mov_rr(ctx, arg0, scratch)
          emit_mov_rr(ctx, arg1, rr)
        when Option::None then ()
        end
      when Option::None then ()
      end
      
      # Call the runtime function
      emit_call_direct(ctx, "__tg_effect_record".to_string())
    end

  when MirStatementKind::MirEffectPerform(eid, op_index, op_name, payload_ptr, result_ptr) then
    # The algebraic-effects perform dispatch: call
    # __tg_effect_perform(effect_id, op_index, payload_ptr, result_ptr) —
    # the runtime walks the task's handler frames, invokes the innermost
    # matching handler's dispatcher (which writes the op's result into
    # *result_ptr) and returns; an unhandled operation aborts with the
    # defined error. The payload/result slots live in THIS frame (the
    # MirRef'd locals) — the synchronous dispatch reads/writes them.
    # Arguments are loaded into the ABI registers in reverse order so the
    # const loads never clobber an already-loaded operand.
    match arg_reg(ctx.target.arch, 3)
    when Option::Some(arg3) then
      load_operand_control_input(ctx, fctx, result_ptr, arg3)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 2)
    when Option::Some(arg2) then
      load_operand_control_input(ctx, fctx, payload_ptr, arg2)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 1)
    when Option::Some(arg1) then
      emit_mov_ri(ctx, arg1, op_index as i64)
    when Option::None then ()
    end
    match arg_reg(ctx.target.arch, 0)
    when Option::Some(arg0) then
      emit_mov_ri(ctx, arg0, eid.id as i64)
    when Option::None then ()
    end
    emit_call_direct(ctx, "__tg_effect_perform".to_string())

  when MirStatementKind::MirEffectFrameEnter(eid, op_count, bitmap, disp_name, env_ptr) then
    # Install a handler frame: call __tg_effect_frame_push(slot_ptr,
    # effect_id, op_count, handled_bitmap, dispatcher, env_ptr) — the
    # runtime writes the frame into THIS function's per-occurrence frame
    # slot (fctx.frame.effect_frame_offsets[this occurrence], consumed in
    # emission order — nested/sequential handle-with blocks each get their
    # own 48-byte slot) and links it onto the task's handler stack. The
    # dispatcher address is the MIR-synthesized handler function's label.
    if fctx.next_effect_frame >= fctx.frame.effect_frame_offsets.len() then
      emit_trap(ctx)
    else
      let slot_off = fctx.frame.effect_frame_offsets[fctx.next_effect_frame]
      fctx.next_effect_frame = fctx.next_effect_frame + 1
      let fp = fp_reg(ctx.target.arch)
      match arg_reg(ctx.target.arch, 5)
      when Option::Some(arg5) then
        load_operand_control_input(ctx, fctx, env_ptr, arg5)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 4)
      when Option::Some(arg4) then
        emit_lea_label(ctx, arg4, disp_name.clone())
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 3)
      when Option::Some(arg3) then
        emit_mov_ri(ctx, arg3, bitmap as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 2)
      when Option::Some(arg2) then
        emit_mov_ri(ctx, arg2, op_count as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 1)
      when Option::Some(arg1) then
        emit_mov_ri(ctx, arg1, eid.id as i64)
      when Option::None then ()
      end
      match arg_reg(ctx.target.arch, 0)
      when Option::Some(arg0) then
        emit_add_ri(ctx, fp, slot_off)
        emit_mov_rr(ctx, arg0, fp)
        emit_add_ri(ctx, fp, -slot_off)
      when Option::None then ()
      end
      emit_call_direct(ctx, "__tg_effect_frame_push".to_string())
    end

  when MirStatementKind::MirEffectFrameExit then
    # Pop the innermost handler frame (the frame slot is reclaimed by the
    # epilogue).
    emit_call_direct(ctx, "__tg_effect_frame_pop".to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Terminator code generation
# ———————————————————————————————————————————————————————————————

def codegen_terminator(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, term: MirTerminator) -> Unit
  let rr = ret_reg(ctx.target.arch)
  # `term` is already a borrow (&MirTerminator); match on `term.kind` directly.
  # (lower_match now dereferences reference-typed scrutinees by type, so the
  # former `&term.kind` mis-dereference is fixed; covered by
  # tests/canary/test_canary_borrowed_enum.tg.)
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    load_operand_control_input(ctx, fctx, discr, rr)
    var target_idx = 0
    while target_idx < targets.len() do
      let sw = targets[target_idx]
      emit_cmp_ri(ctx, rr, sw.value as i32)
      let tgt_label = block_label_for(fctx, sw.target.id)
      emit_jcc(ctx, CondKind::Eq, tgt_label)
      target_idx = target_idx + 1
    end
    let def_label = block_label_for(fctx, default_target.id)
    emit_jmp(ctx, def_label)

  when MirTerminatorKind::MirReturn then
    codegen_epilogue(ctx, fctx)

  when MirTerminatorKind::MirUnreachable then
    emit_trap(ctx)

  when MirTerminatorKind::MirCall(dest, callee, args, success, unwind, intrinsic) then
    codegen_call(ctx, fctx, dest, callee, args, success, unwind, intrinsic)

  when MirTerminatorKind::MirDeinit(place, deinit_instance, target, unwind) then
    codegen_finalizer_call(ctx, fctx, &place, &deinit_instance)
    let label = block_label_for(fctx, target.id)
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    load_operand_control_input(ctx, fctx, cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ck = if expected then CondKind::Ne else CondKind::Eq end
    let tgt_label = block_label_for(fctx, target.id)
    emit_jcc(ctx, ck, tgt_label)
    emit_trap(ctx)

  when MirTerminatorKind::MirAbort then
    emit_trap(ctx)
  when _ then
    panic("codegen_terminator: unsupported MIR terminator kind")
  end
end

# ———————————————————————————————————————————————————————————————
# ABI classification — the value-category model 
# ———————————————————————————————————————————————————————————————
# Both sides of the call boundary (arguments and results) are classified by
# the layout engine's SINGLE value-category authority
# (classify_value_category — ValueCategory), never by an ad-hoc
# register/8-byte-word size test. The category model:
#   ZeroSized           — no payload (Unit, Never, empty aggregates)
#   Scalar(width)       — ONE ABI slot of `width` bytes: the value itself
#                         travels in the slot (primitives of every width,
#                         pointers/handles, TaggedPtr-represented enums —
#                         their ONE pointer-width TaggedPtr word crosses
#                         regardless of the image size)
#   ScalarPair(w1, w2)  — a 16-byte value: two ABI slots (16-byte tuples/
#                         structs, the raw UnsafeSlice view, I128)
#   ByAddress(size)     — a >16-byte value: crosses BY ADDRESS (the slot
#                         carries the address; returns use sret)
# The SLOT rule stays mechanical (arg_reg(arch, index) Some/None picks the
# register or the caller's stack slot; the MIR lowering emits aggregate args
# as MirCallValue::Place, so the by-reference convention carries the
# aggregate's ADDRESS through the same slot a scalar of that index would
# use). Every ABI decision (call lowering, prologue binding, the sret
# decision, aggregate move/copy emission) is derived from this pair —
# nobody re-decides register/stack/indirect inline.
# FAIL-CLOSED: classify_value_category returns Result::Err for unresolved
# types (Var/Param/Error) — an internal compiler error here, never a
# silently assumed word.

# How a function result is delivered to the caller.
enum AbiReturn
  Direct         # returned in the value register (ret_reg)
  IndirectSret   # returned indirectly: callee writes the result at &dest (x8)
end

# The category-level sret eligibility: a function RESULT crosses indirectly
# (sret) exactly when its value category is ScalarPair (16-byte aggregate)
# or ByAddress (>16-byte aggregate). ZeroSized/Scalar results — primitives,
# pointers/handles, and TaggedPtr-represented enums (the enum VALUE is ONE
# pointer-width word, so it returns directly regardless of its image size) —
# never use sret. This is the single sret-candidate authority:
# classify_return (the caller side) and allocate_locals (the callee frame
# side) both read it, so the two ends can never disagree.
def category_uses_sret(cat: ValueCategory) -> Bool
  match cat
  when ValueCategory::ZeroSized then false
  when ValueCategory::Scalar(_) then false
  when ValueCategory::ScalarPair(_, _) then true
  # THE VECTOR CASE: the 16-byte vector crosses THROUGH THE REGISTERS
  # (never sret); the 32/64-byte vectors cross BY ADDRESS (memory/sret) —
  # the classifier emits ByAddress for them, so the only Vector category
  # that reaches here is the register-classified 16-byte form.
  when ValueCategory::Vector(_) then false
  when ValueCategory::ByAddress(_) then true
  end  end
end

# SINGLE authority for the sret policy on aggregate returns. A call result
# goes through sret (indirect return) exactly when:
#   - the result's value category is ScalarPair or ByAddress (the
#     category-level decision above — this REPLACES the former `size > 8`
#     test, which classified by nothing but the raw byte size),
#   - the destination is a plain local with no projections, and
#   - that local has a stable stack home the callee can write into
#     (AArch64 passes the indirect-return pointer via x8; x86-64 has no sret
#     here — the result crosses in the value register instead).
# classify_argument (AbiArg) is the paired authority on the ARGUMENT side of
# the ABI: the two functions together (classify_return + classify_argument)
# are the single classify pair that decides how every value crosses the call
# boundary.
def classify_return(inout ctx: CodegenCtx, fctx: FnCodegenCtx, dest: Place, ty: Type) -> AbiReturn
  match classify_value_category(&mut ctx.layout_engine, ty)
  when Result::Err(e) then
    panic("ICE: ABI return classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    if category_uses_sret(&cat) && dest.projections.is_empty() then
      match ctx.target.arch
      when Arch::AArch64 then
        match fctx.var_locs.get(dest.local.id)
        when Option::Some(loc) then
          match loc
          when VarLoc::Stack(_) then return AbiReturn::IndirectSret
          when VarLoc::Spilled(_) then return AbiReturn::IndirectSret
          when _ then ()
          end
        when Option::None then ()
        end
      when _ then ()
      end
    end
    AbiReturn::Direct
  end  end
end

# ———————————————————————————————————————————————————————————————
# ABI classification — arguments 
# ———————————————————————————————————————————————————————————————
# How a function ARGUMENT is delivered to the callee, as the first-class
# value-category distinction (the layout engine's ValueCategory decides the
# category; the slot index is carried so the caller/callee can place it):
enum AbiArg
  Scalar(Int, Int)     # one <width>-byte value in ABI slot <index>
  ScalarPair(Int, Int) # a 16-byte value: ABI slots <index> and <index + 1>
  # A SIMD VECTOR (the 16-byte vector row): the value crosses THROUGH THE
  # REGISTER SLOTS — the address travels in slot <index> (the by-reference
  # convention; the 128-bit payload lives in the memory image and the
  # intrinsic bodies work in the architectural vector registers q0-q7 /
  # xmm0-xmm7). <width> = the vector width (16). The 32/64-byte vectors
  # classify ByAddress (memory) at the classifier.
  Vector(Int, Int)     # SIMD vector in ABI slot <index>; <width> bytes
  ByAddress(Int, Int)  # a >16-byte value crossed BY ADDRESS: slot <index>
                       # carries the address; <size> = payload byte size
end

# SINGLE authority for the argument-passing convention, mirroring the
# argument placement the call lowering and the prologue have always used.
# The CATEGORY comes from the layout engine's classifier (primitives of all
# widths -> Scalar(width); pointers/String/heap-container handles -> Scalar
# (pointer width); TaggedPtr-represented enums -> Scalar(pointer size) — the
# enum's ONE pointer-width TaggedPtr word, asked of the EnumLayout;
# 16-byte aggregates -> ScalarPair; >16-byte aggregates -> ByAddress);
# the SLOT follows the index rule: an argument at index < max_reg_args(arch)
# travels in arg_reg(arch, index) (x0..x7 on AArch64, rdi..r9 on x86-64), an
# argument at index >= max_reg_args(arch) is pushed on the stack
# (caller-pops cleanup in codegen_call). Aggregate args (>8-byte payloads)
# are classified ScalarPair/ByAddress: the MIR lowering emits them as
# MirCallValue::Place, so the existing code passes the place ADDRESS through
# the same register/stack slot a scalar of that index would use — the
# by-reference convention is preserved byte-for-byte; only the MODEL is now
# category-explicit. The slot itself still follows the index rule above, so
# behavior is byte-identical.
# FAIL-CLOSED: an unresolved type (Var/Param/Error) reaching the classifier
# panics here — never a silently assumed word.
def classify_argument(inout ctx: CodegenCtx, ty: Type, index: Int) -> AbiArg
 # (the typed literal/view split): the MIR-internal static
  # StaticStrPtr of a string literal is an 8-byte raw pointer (the interned
  # label) — the same ABI slot a str value crosses. It is classified as a
  # scalar directly (never through the layout engine's aggregate path —
  # though the engine's own StaticStrPtr row, Repr::RawPtr — 8 bytes,
  # agrees): the view is a scalar pointer, exactly like the StringPtr
  # representation.
  match ty
  when Type::StaticStrPtr then
    return AbiArg::Scalar(index, ctx.target.pointer_size)
  when _ then ()
  end
  match classify_value_category(&mut ctx.layout_engine, ty)
  when Result::Err(e) then
    panic("ICE: ABI argument classification failed closed for type '" + e.type_name + "' at index " + index.to_string() + ": " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then AbiArg::Scalar(index, 0)
    when ValueCategory::Scalar(w) then AbiArg::Scalar(index, w)
    when ValueCategory::ScalarPair(_, _) then AbiArg::ScalarPair(index, index + 1)
    # THE VECTOR CASE: the 16-byte SIMD vector crosses through the
    # register slots (the vector class — never sret, never memory).
    when ValueCategory::Vector(w) then AbiArg::Vector(index, w)
    when ValueCategory::ByAddress(sz) then AbiArg::ByAddress(index, sz)
    end
  end
end

# The static type of a call argument (Place args are passed by reference —
# the ADDRESS is the value that crosses the boundary).
def mir_call_arg_type(ctx: CodegenCtx, fctx: FnCodegenCtx, arg: MirCallArg) -> Type
  match arg.value
  when MirCallValue::Value(op) then operand_type(ctx, fctx, &op)
  when MirCallValue::Place(p) then place_type(ctx, fctx, &p)
  end  end
end

# Position of the `$` that separates a monomorphized instance name's base
# from its mangled type arguments ("Option__map$i64_str" → 12), or -1 when
# the name carries no instance suffix.
def find_instance_dollar(name: String) -> Int
  var i = 0
  while i < name.len() do
    if name.slice(i, i + 1) == "$" then
      return i
    end
    i = i + 1
  end
  -1
end

# ———————————————————————————————————————————————————————————————
# CALLEE-LABEL RESOLUTION — the single authority 
#
# resolve_callee_label translates a callable NAME to the machine label to
# emit at the call site, or it is an internal error. The callable identity
# flows:
#
#   name (MirFnItem operand)
#     -> typed call_targets DefId      (the typed program)
#     -> monomorphized instance name   (the monomorphizer: generic callees
#                                       are rewritten to `$`-suffixed
#                                       instance names, e.g. "Option__map$i64_str")
#     -> fn_alias label                (codegen_program: ".Lfn_entry.<index>")
#
# InstanceId { def, substs } is the target representation that REMOVES the
# string stage: the name string is a rendering of that identity pair, and
# fn_alias is its codegen-side index. Until the DefId/substs pair reaches
# codegen, this function is the one authority for "this callable name
# resolves to this machine label or it is an internal error" — every emitted
# compiled call (codegen_call's compiled-function path, codegen_call's alias
# fallback, codegen_finalizer_call's emission) funnels through it. The
# intrinsic call path is the paired authority on the other side of
# codegen_call's dispatch: the semantic intrinsic router (classify_
# intrinsic_call — types.tg) owns intrinsic names and rejects unknown
# ones; resolve_callee_label owns compiled callables. No callable name
# escapes both.
#
# Resolution order:
#   1. fn_alias — the identity entry (".Lfn_entry.<index>") for every emitted
#      function, plus the bare/canonical alias entries.
#   2. reachable_fns / extern_fns — the function is emitted under its own
#      symbol name (safety net; identity entries make this unreachable).
#   3. FAIL CLOSED — panic. Instance-aware verification first: if the name is
#      the BASE of a monomorphized generic (a `$`-suffixed instance of it
#      exists), the call site was never rewritten to an instance name — a
#      monomorphization-identity leak, reported as such.
# the call references arriving here are the DefId-derived emission
# names (MirFnItem names from the call's InstanceId, matching the callee's
# MirFunction.name), so the identity entry resolves them directly. The
# name-based paths that remain are the linking boundary (extern symbols,
# intrinsic names, the OS-entry "main"/"_start") and the "Type__method"
# method names — all emitted under those exact names, all resolvable here.
def resolve_callee_label(ctx: CodegenCtx, name: String) -> String
  match ctx.fn_alias.get(name)
  when Option::Some(label) then label.clone()
  when Option::None then
    if ctx.reachable_fns.contains(name) || ctx.extern_fns.contains(name) then
      name.clone()
    else
      if ctx.generic_instance_bases.contains(name) then
        panic("internal error: call to `" + name + "` is an unresolved generic BASE name; the monomorphizer must rewrite this call site to a `$`-suffixed instance name (InstanceId { def, substs } replaces this string stage) — no instance label exists")
      end
      panic("internal error: call to `" + name + "` is not a reachable function, an extern, or a known intrinsic (unresolved callee)")
    end
  end  end
end

def codegen_call(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, dest: Place, callee: MirOperand, args: Vec[MirCallArg], success: MirBlockId, unwind: Option[MirBlockId], intrinsic: Option[IntrinsicId]) -> Unit
  let arch   = ctx.target.arch
  let rr     = ret_reg(arch)
  let scratch = scratch2_reg(arch)
  let sp     = sp_reg(arch)
  let max_ra = max_reg_args(arch)

  var arg_ops = Vec::new()
  var arg_idx_build = 0
  while arg_idx_build < args.len() do
    arg_ops.push(mir_call_arg_operand(&args[arg_idx_build]))
    arg_idx_build = arg_idx_build + 1
  end

  # sret eligibility is decided by classify_return — the single authority on
  # whether an aggregate return is passed indirectly (see AbiReturn above).
  # When eligible we pass &dest in x8 to the callee (which uses sret) and
  # skip storing rr. The stack-home offset below is a mechanical lookup, not
  # a policy decision.
  let dest_ty = place_type(ctx, fctx, dest)
  var sret_dest_off: i32 = 0
  var sret_dest_ok = false
  if classify_return(ctx, fctx, dest, &dest_ty) == AbiReturn::IndirectSret then
    match fctx.var_locs.get(dest.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Stack(off) then
        sret_dest_off = off
        sret_dest_ok = true
      when VarLoc::Spilled(off) then
        sret_dest_off = off
        sret_dest_ok = true
      when _ then ()
      end
    when Option::None then ()
    end
  end
  # The drain helpers (_tg_map_drain_one / _tg_set_drain_one) deliver their
  # result through x8 — a fixed RUNTIME-ABI property of those helpers
  # (disc@0, key@8, value@8 + t_v_off — the runtime writes the enum IMAGE
  # at the buffer, never a TaggedPtr word), so classify_return — which
  # classifies Option/Result as Scalar (their ONE pointer-width TaggedPtr
  # word) — cannot gate the x8 setup for them. Resolve the same stack home
  # here so the drain call sites can always set up the buffer.
  var drain_dest_off: i32 = 0
  var drain_dest_ok = false
  if !sret_dest_ok then
    match fctx.var_locs.get(dest.local.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Stack(off) then
        drain_dest_off = off
        drain_dest_ok = true
      when VarLoc::Spilled(off) then
        drain_dest_off = off
        drain_dest_ok = true
      when _ then ()
      end
    when Option::None then ()
    end
  end
  var did_sret = false
  # The intrinsic arms that materialize the FULL result image into the
  # destination place themselves (the ArrayGet/ArrayRemove ScalarPair/
  # ByAddress paths) report it through codegen_intrinsic's Bool result;
  # the post-call register store is then suppressed.
  var intrinsic_did_materialize = false

  # Place arguments in reverse order. Loading a projected operand may use x0/rax
  # as scratch, so left-to-right loading can clobber an already prepared arg0.
  # The category of every argument comes from the single authority
  # classify_argument (AbiArg) — the ABI half of the review's
  # classify_argument/classify_return pair — which classifies through the
  # layout engine's value-category model (Scalar/ScalarPair/ByAddress).
  # ScalarPair and ByAddress aggregates keep the by-reference convention:
  # their ADDRESS travels in the same slot a scalar of this index would use
  # (arg_reg is Some exactly while index < max_ra, so the Some/None test
  # below IS the register-count rule). Behavior is byte-identical to the
  # former Register/Stack/Indirect split.
  let total_args = args.len()
 # (the closure {code, env} ABI): a CLOSURE-VALUE callee (an indirect
  # operand whose type is Type::Closure) dispatches through the closure
  # OBJECT — the value is a pointer to the registered { code @ 0,
  # env: capture-tuple } image. The generated closure function takes the
  # CAPTURE VALUES as its leading parameters, so the explicit call args
  # shift right by the capture count (every slot index below is offset by
  # closure_shift when the callee is a closure value).
  var closure_shift = 0
  var closure_cap_tys: Vec[Type] = Vec::new()
  var closure_callee_ty: Option[Type] = Option::None
  match callee.kind
  when MirOperandKind::MirCopy(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirMovePlace(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirRead(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when MirOperandKind::MirConsume(place) then
    match operand_type(ctx, fctx, callee)
    when Type::Closure(_, _, _, captures, _) then
      closure_shift = capture_tuple_len(&captures)
      match captures
      when Type::Tuple(t) then closure_cap_tys = t.clone()
      when _ then ()
      end
      closure_callee_ty = Option::Some(operand_type(ctx, fctx, callee))
    when _ then ()
    end
  when _ then ()
  end
 # (the closure {code, env} ABI): for a CLOSURE-VALUE callee, the
  # [ptr, code] pair is preserved on the stack BEFORE the explicit arg
  # loop so the whole pushed area (pair, explicit stack args, capture
  # stack args) stays in ascending slot order from the callee's frame.
  var closure_ptr_depth = 1
  match closure_callee_ty
  when Option::Some(_) then
    let cl_slot_size0 = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    match callee.kind
    when MirOperandKind::MirCopy(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirMovePlace(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirRead(place) then load_place(ctx, fctx, &place, rr)
    when MirOperandKind::MirConsume(place) then load_place(ctx, fctx, &place, rr)
    when _ then ()
    end
    emit_push(ctx, rr)
    emit_load_mem(ctx, rr, rr, 0)
    emit_push(ctx, rr)
  when Option::None then ()
  end
  var arg_idx = total_args
  while arg_idx > 0 do
    arg_idx = arg_idx - 1
    let arg = args[arg_idx]
    let arg_ty = mir_call_arg_type(ctx, fctx, &arg)
    let slot_idx = arg_idx + closure_shift
    match classify_argument(ctx, &arg_ty, slot_idx)
    when AbiArg::Scalar(_, _) then
      # One <width>-byte value in the slot.
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::ScalarPair(_, _) then
      # A 16-byte aggregate (a two-slot value) — crossed by reference: the
      # ADDRESS travels in the single slot.
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::Vector(_, _) then
      # THE VECTOR CASE: a 16-byte SIMD vector — crossed by reference
      # through the register slots (the address travels in the slot; the
      # 128-bit payload stays in the memory image).
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    when AbiArg::ByAddress(_, _) then
      # A >16-byte aggregate — the slot carries the ADDRESS (by reference).
      match arg_reg(arch, slot_idx)
      when Option::Some(abi_r) then
        load_call_arg_value(ctx, fctx, arg, abi_r)
      when Option::None then
        load_call_arg_value(ctx, fctx, arg, scratch)
        emit_push(ctx, scratch)
      end
    end
  end

  # The closure dispatch's [ptr, code] pair was preserved BEFORE the
  # explicit arg loop; the explicit STACK args were pushed on top of the
  # pair, so the closure pointer now sits at depth 1 + the pushed explicit
  # stack args. The cleanup below and the dispatch share this count.
  let eff_total_args = total_args + closure_shift
  if eff_total_args > max_ra then
    closure_ptr_depth = 1 + (eff_total_args - max_ra)
  end

  # Call the function
  match callee.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFnItem(fn_name) then
      # For dot-prefixed method names (.keys,.is_empty, etc.),
      # resolve using the receiver argument's type
      var resolved_fn_name = fn_name.clone()
      if fn_name.len() > 1 && fn_name.slice(0, 1) == "." then
        resolved_fn_name = resolve_dot_method(ctx, fctx, fn_name, &arg_ops)
      end
      let intr_name = bare_intrinsic_name(&resolved_fn_name)
 # (IntrinsicId at check time): the ONE semantic classification —
      # types.tg's semantic router (the same classification the type
      # checker attaches at call-recording time — intrinsic_id_of_call
      # over the TYPED operand facts). Option::None = the name is NOT an
      # intrinsic name. The former name-shape gates (the codegen
      # name tables) are GONE: the classification decides.
      let recv_ty0 = if arg_ops.len() > 0 then strip_ref_like_type(&operand_type(ctx, fctx, &arg_ops[0])) else Type::Unit end
      let recv_named0 = match recv_ty0
      when Type::Adt(ri_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ri_tid.id))
      when _ then "".to_string()
      end
      let needle_ty0 = if arg_ops.len() > 1 then operand_type(ctx, fctx, &arg_ops[1]) else Type::Unit end
      let needle_named0 = match strip_ref_like_type(&needle_ty0)
      when Type::Adt(ni_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ni_tid.id))
      when _ then "".to_string()
      end
      let recv_is_string0 = if arg_ops.len() > 0 then is_string_operand(&arg_ops[0], fctx) else false end
      let needle_is_string0 = if arg_ops.len() > 1 then
        is_string_operand(&arg_ops[1], fctx) ||
        is_string_like_type(ctx, &needle_ty0) ||
        is_string_like_type(ctx, &strip_ref_like_type(&needle_ty0))
      else
        false
      end
 # (IntrinsicId through MirCall): the STAMPED id — the lowering
      # read the checker's typed_intrinsics at the SOURCE call sites and
      # stamped the MirCall — is the authority. The semantic router
      # (intrinsic_id_of_call over the typed operand facts) is the
      # fallback ONLY for the compiler-SYNTHESIZED calls, which construct
      # their own names and carry Option::None here.
      let intr_opt = match intrinsic
      when Option::Some(stamped_id) then Option::Some(stamped_id)
      when Option::None then intrinsic_id_of_call(&intr_name, &recv_ty0, &recv_named0, &needle_ty0, &needle_named0, &resolved_fn_name, recv_is_string0, needle_is_string0)
      end
      let has_real_body =
        ctx.extern_fns.contains(&resolved_fn_name) ||
        ctx.reachable_fns.contains(&resolved_fn_name)
 # boundary between the two call-identity authorities: has_real_body
      # is the intrinsic path's PRESENCE test against the compiled-callable
      # namespace (reachable_fns/extern_fns). It deliberately does NOT resolve
      # a label — intrinsic names are owned by the semantic router
      # (classify_intrinsic_call) and must not panic here. Label resolution
      # for compiled callables happens only in the compiled and alias
      # branches below, via resolve_callee_label — the single authority. No
      # name escapes both: intrinsic names fail classify_intrinsic_call with
      # a panic, compiled names fail resolve_callee_label with a panic.
      let fallback_clone_intrinsic =
        !has_real_body &&
        resolved_fn_name.len() >= 7 &&
        resolved_fn_name.slice(resolved_fn_name.len() - 7, resolved_fn_name.len()) == "__clone"
      # The atomic builtins (try_emit_atomic_builtin) emit first; a
      # CLASSIFIED intrinsic name then inlines through the semantic
      # router's decision; everything else resolves against the compiled
      # namespace (extern/reachable/fn_alias) through the single authority
      # resolve_callee_label.
      if try_emit_atomic_builtin(ctx, &resolved_fn_name) then
        ()
      else
        match intr_opt
        when Option::Some(iid) then
          # Intrinsic path — the SEMANTIC classification decides (a
          # classified intrinsic name inlines; the String__new / cstring
          # special cases are the router's StringNew / CStringNew arms).
          # Only the DRAIN intrinsics write their aggregate result through
          # the sret slot (the runtime fills disc + payload at &dest in
          # x8). Other aggregate-returning intrinsics (e.g. map_entries ->
          # Vec) return in the value register and must keep the post-call
          # store.
          if iid == IntrinsicId::MapDrainOne || iid == IntrinsicId::SetDrainOne then
            # Drain runtime contract: the helper writes its result IMAGE at
            # &dest (AArch64: x8; x86-64: r8 — the drain sret register) — a
            # runtime-ABI property, independent of the result type's value
            # category (see drain_dest_ok above).
            let drain_sret = match arch
            when Arch::AArch64 then PhysReg::A64Reg(A64::X8)
            when Arch::X86_64  then PhysReg::X64Reg(X64::R8)
            end
            if sret_dest_ok then
              emit_lea_fp(ctx, drain_sret, sret_dest_off)
              did_sret = true
            else if drain_dest_ok then
              emit_lea_fp(ctx, drain_sret, drain_dest_off)
              did_sret = true
            end
          end
          intrinsic_did_materialize = codegen_intrinsic(ctx, fctx, intr_name, &arg_ops, args, resolved_fn_name, &dest_ty, dest)
          # The drain helpers wrote the enum IMAGE at &dest; re-encode it as
          # the TaggedPtr VALUE word (codegen_drain_result_materialize) so
          # every consumer — MirDiscriminant, is_some, the Variant payload
          # projections, the drop-glue plan walk — agrees with the category
          # model.
          if (iid == IntrinsicId::MapDrainOne || iid == IntrinsicId::SetDrainOne) && did_sret then
            let drain_materialize_off = if sret_dest_ok then sret_dest_off else drain_dest_off end
            codegen_drain_result_materialize(ctx, fctx, &dest_ty, drain_materialize_off)
          end
        when Option::None then
          if fallback_clone_intrinsic then
            intrinsic_did_materialize = codegen_intrinsic(ctx, fctx, "clone", &arg_ops, args, resolved_fn_name, &dest_ty, dest)
          else if ctx.extern_fns.contains(&resolved_fn_name) then
            emit_call_extern(ctx, resolved_fn_name)
            # The extern ABI boundary: a C `int` return arrives in the low
            # 32 bits of the return register (eax/w0) with unspecified
            # upper bits — normalize (sign/zero-extend) before the
            # post-call store so a C -1 reads as -1 (see
            # normalize_extern_return).
            normalize_extern_return(ctx, rr, &dest_ty)
          else if ctx.reachable_fns.contains(&resolved_fn_name) then
 # Function has a compiled body — call it directly. the callee
            # identity flow is verified here — for a generic callee this name is
            # the MONOMORPHIZED instance name (the monomorphizer rewrote the call
            # site to e.g. "Option__map$i64_str"), and fn_alias maps that exact
            # instance name to the emitted body's label. The label itself comes
            # from the single authority resolve_callee_label.
            let resolved = resolve_callee_label(ctx, &resolved_fn_name)
            if sret_dest_ok then
              # Pass &dest in x8 for sret-returning callee
              emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
              did_sret = true
            end
            emit_call_label(ctx, resolved)
          else
 # verification layer: at this point the callee is NOT an
            # extern, NOT a lowered reachable function, and NOT a known
            # intrinsic — all of those were handled above. The single authority
            # resolve_callee_label handles the only legitimate remaining case
            # (an fn_alias entry mapping this reference to an emitted function
            # label — bare/canonical aliases of compiled functions) and panics
            # fail-closed otherwise. An unknown callee is a compiler error, never
            # a silent call to a possibly-nonexistent label; every emitted call
            # therefore goes through the resolved-name check, and generic
            # callees carry the instance names ("Option__map$i64_str") that the
            # monomorphizer produced and fn_alias maps to labels.
            let resolved = resolve_callee_label(ctx, &resolved_fn_name)
            if sret_dest_ok then
              emit_lea_fp(ctx, PhysReg::A64Reg(A64::X8), sret_dest_off)
              did_sret = true
            end
            emit_call_label(ctx, resolved)
          end
        end
      end
    when MirConstantKind::MirZeroSized then
      match cst.ty
      when Type::FnPtr(_, _, _) | Type::Closure(_, _, _, _, _) then
        emit_trap(ctx)
      when _ then
        emit_trap(ctx)
      end
    when _ then
      emit_trap(ctx)
    end
  when MirOperandKind::MirCopy(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirMovePlace(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirRead(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  when MirOperandKind::MirConsume(place) then
    codegen_indirect_callee(ctx, fctx, &place, callee, closure_shift, &closure_cap_tys, &closure_callee_ty)
  end

  # Clean up stack args — the closure dispatch pushed the shifted stack
  # args (total_args + closure_shift slots), so the pop count matches.
  if eff_total_args > max_ra then
    let stack_arg_slot = match arch
    when Arch::AArch64 then 16
    when Arch::X86_64 then 8
    end
    emit_add_ri(ctx, sp, ((eff_total_args - max_ra) * stack_arg_slot) as i32)
  end

  # Store return value
  if !did_sret && !intrinsic_did_materialize then
    store_place(ctx, fctx, dest, rr)
  end

  # Jump to success block
  let label = block_label_for(fctx, success.id)
  emit_jmp(ctx, label)
end

# ———————————————————————————————————————————————————————————————
# Destruction call emission.
#
# Codegen holds NO destruction knowledge: the pre-generated drop-GLUE
# functions (ordinary MirFunctions produced by the MIR builder — one per
# concrete type with a non-trivial deinit plan) do all the walking. Every
# destruction site emits ONE call:
#   - a MirDeinit terminator whose payload is the SEMANTIC InstanceId of
#     either the glue function (whole-value destruction — cleanup chains,
#     assignment replacement, the array-set old element) or the finalizer
#     (a DeinitPlan callable inside a glue body);
#   - the whole-value destruction intrinsics (drop / drop_in_place),
#     which resolve the glue by the CONCRETE type key.
# The label always comes from the identity: drop_glue_fns
# (def_id_numeric(glue CallableId) -> emission name) for glue instances,
# method_names_by_def (def_id_numeric(finalizer DefId) -> mangled emission
# name) for finalizer instances — both through the single authority
# resolve_callee_label. FAIL CLOSED: an unresolvable destruction identity
# is an internal compiler error, never a silently skipped cleanup.
# ———————————————————————————————————————————————————————————————

# The emission label of a MirDeinit's InstanceId payload: the drop-glue
# function's label when the payload is a glue instance (drop_glue_fns
# membership), else the FINALIZER's emission label (method_names_by_def —
# the finalizer's mangled "Type__drop" / "Type__deinit" emission name,
# resolved like any other emitted function). A glue entry whose name is
# NOT a compiled function is a RUNTIME-EMITTED destructor (— real
# String lifetime: the "_tg_string_drop" entry the MIR registers in
# drop_glue_fns for DeinitPlan::String): the runtime emits every
# _tg_* function unconditionally (emit_all_runtime), so the symbol itself
# is the label.
def codegen_deinit_label(ctx: CodegenCtx, instance: InstanceId) -> String
  let inst_key = def_id_numeric(&instance.def.def)
  match ctx.drop_glue_fns.get(inst_key)
  when Option::Some(glue_name) then
    if ctx.reachable_fns.contains(&glue_name) || ctx.extern_fns.contains(&glue_name) then
      resolve_callee_label(ctx, &glue_name)
    else
      # The runtime-emitted destructor domain (the String drop): emitted
      # unconditionally by emit_all_runtime under its own symbol name.
      glue_name.clone()
    end
  when Option::None then
    match ctx.method_names_by_def.get(inst_key)
    when Option::Some(finalizer_name) then
      resolve_callee_label(ctx, &finalizer_name)
    when Option::None then
      panic("internal error: MirDeinit instance is neither a generated drop-glue function nor a registered finalizer identity (def_id_numeric " + inst_key.to_string() + ")")
    end
  end
end

# The emission label of the generated drop-glue function for a CONCRETE
# type (the whole-value destruction intrinsics — drop / drop_in_place —
# resolve the glue by the concrete type key through drop_glue_instances).
def codegen_drop_glue_label_for_type(ctx: CodegenCtx, ty: Type) -> Option[String]
  let key = mir_type_identity_key(ty)
  match ctx.drop_glue_instances.get(key)
  when Option::Some(glue_inst) then
    let inst_key2 = def_id_numeric(&glue_inst.def.def)
    match ctx.drop_glue_fns.get(inst_key2)
    when Option::Some(glue_name2) then Option::Some(resolve_callee_label(ctx, &glue_name2))
    when Option::None then
      panic("internal error: drop-glue instance has no emission name (the glue function was not registered)")
    end
  when Option::None then Option::None
  end
end

def codegen_finalizer_call(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, place: Place, deinit_instance: InstanceId) -> Unit
  # FAIL CLOSED: a MirDeinit whose identity cannot be resolved is an
  # internal compiler error — silently skipping destruction would turn a
  # cleanup-identity bug into a silent memory leak.
 # the label resolution is identity-driven (codegen_deinit_label —
  # the glue function's label via the glue instance, or the finalizer's
  # emission label via the finalizer DefId) and goes through the single
  # authority resolve_callee_label.
 # (partial-drop conditioning): every drop-glue function's signature is
  # (ptr: Ptr[T], mask: Int) — the initialized-fields bitmask (all-ones =
  # every field live). A MirDeinit is a WHOLE-VALUE destruction, so the
  # mask argument is the full mask (-1) here; the mask-carrying partial
  # drops are ordinary MirCall terminators to the glue label with their
  # own constant mask.
  let resolved = codegen_deinit_label(ctx, deinit_instance)
  match arg_reg(ctx.target.arch, 0)
  when Option::Some(r0) then
    emit_place_address(ctx, fctx, place, r0)
    match arg_reg(ctx.target.arch, 1)
    when Option::Some(r1) then
      emit_mov_ri(ctx, r1, -1)
    when Option::None then ()
    end
    emit_call_label(ctx, resolved)
  when Option::None then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Intrinsic code generation — emit inline code for built-in operations
#
# (IntrinsicId at check time): the semantic IntrinsicId enum and the
# name -> id classification live in the SHARED semantic domain (ids.tg's
# IntrinsicId; types.tg's intrinsic_id_of_call / classify_intrinsic_call —
# the semantic router the type checker attaches with at call-recording
# time). codegen holds NO name table: the dispatch below is a pure match
# on IntrinsicId, and the classification comes from the semantic router
# (classify_intrinsic_call — the fail-closed wrapper) over the TYPED
# operand facts. The former local enum and codegen-side name table are
# are not part of the model.
# ———————————————————————————————————————————————————————————————

# ———————————————————————————————————————————————————————————————
# String-ABI normalization helpers
# ———————————————————————————————————————————————————————————————
# The String ABI: a string_* intrinsic RECEIVER is a String object header;
# a str-typed operand (&str param, str_* value) is a RAW byte pointer (the
# static StaticStrPtr form). These helpers normalize operands between the two
# forms at the intrinsic boundary. The rules:
#   - a MirString CONSTANT is the static StaticStrPtr — raw, never touched;
#   - a String-typed (non-ref) place operand is an owned String object —
#     one [reg+0] load yields the data pointer;
#   - a RefInternal operand carries the &self receiver address (the
#     receiver convention) or an inlined str value — the arms deref the
#     receiver via the receiver-ptr-like deref; str values pass through.
def string_abi_intrinsic_name(name: String) -> Bool
  if name.len() >= 7 then
    if name.slice(0, 7) == "string_" then return true end
  end
  false
end

# Normalize a str-typed argument (arg index `idx`, already in its ABI
# register) to a raw byte pointer: constants pass through (static
# StaticStrPtr); non-ref String-typed place operands unwrap the String object
# header ([reg+0] = data). RefInternal operands pass through (they carry
# inlined str values — labels/borrowed views).
def codegen_string_str_arg_normalize(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], idx: Int) -> Unit
  if args.len() <= idx then
    return
  end
 # (the typed literal/view split): an operand whose TYPE is the
  # MIR-internal static StaticStrPtr is the raw interned label already — pass
  # through, never unwrapped as a String object.
  match operand_type(ctx, fctx, &args[idx])
  when Type::StaticStrPtr then return
  when _ then ()
  end
  match args[idx].kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirString(_) then ()
    when _ then ()
    end
  when _ then
    let aty = operand_type(ctx, fctx, &args[idx])
    if !is_ref_like_type(&aty) then
      match arg_reg(ctx.target.arch, idx)
      when Option::Some(reg) then emit_load_mem(ctx, reg, reg, 0)
      when Option::None then ()
      end
    end
  end
end

# Normalize a string binary-op operand (already loaded in `reg`) to the
# raw byte form _tg_str_concat / the str comparisons expect: a MirString
# CONSTANT is the static StaticStrPtr (pass through); any other String-typed
# value is an owned String object whose data pointer is at [reg+0].
def codegen_string_operand_to_raw(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, reg: PhysReg) -> Unit
 # (the typed literal/view split): an operand whose TYPE is the
  # MIR-internal static StaticStrPtr is the raw interned label already — pass
  # through, never unwrapped as a String object.
  match operand_type(ctx, fctx, op)
  when Type::StaticStrPtr then ()
  when _ then
    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirString(_) then ()
      when _ then emit_load_mem(ctx, reg, reg, 0)
      end
    when _ then emit_load_mem(ctx, reg, reg, 0)
    end
  end
end

# Wrap the raw NUL-terminated buffer in the return register into an OWNED
# String object (_tg_string_wrap): the String-producing conversions
# (int/float/bool/char to string, slice, concat) built a raw buffer and
# the result must be a String object per the String ABI. The helper's
# result lands in the return register, so after the call the value is
# already in rr.
def codegen_string_wrap_result(inout ctx: CodegenCtx) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  match arg_reg(arch, 0)
  when Option::Some(a0) then
    emit_mov_rr(ctx, a0, rr)
    emit_call_label(ctx, "_tg_string_wrap")
  when Option::None then ()
  end
end

# Normalize the String-op receiver in arg0 to the OWNED String OBJECT for
# the _tg_string_* object-based helpers (trim/lower/upper/replace/split):
# a borrowed &String/&mut String receiver derefs once (the slot holds the
# object handle); a STATIC StaticStrPtr receiver (the MIR-internal literal
# view — only when the method-call lowering did not materialize the
# literal) converts through _tg_string_from_static (raw label -> owned
# object). Returns true when the conversion ran (it may clobber the
# caller-saved argument registers — the caller must re-load args 1..n
# through codegen_string_intrinsic_reload_arg).
def codegen_string_intrinsic_receiver_object(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand]) -> Bool
  if args.len() == 0 then
    return false
  end
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let recv_ty = operand_type(ctx, fctx, &args[0])
  let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
  match recv_value_ty
  when Type::StaticStrPtr then
    emit_call_label(ctx, "_tg_string_from_static")
    true
  when _ then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    false
  end
end

# Re-load one str/String argument into its ABI register after the
# receiver conversion clobbered the caller-saved registers: load the
# operand (constants -> the interned label; places -> the slot value) and
# normalize a String-typed value to its raw data pointer.
def codegen_string_intrinsic_reload_arg(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], idx: Int) -> Unit
  if args.len() <= idx then
    return
  end
  match arg_reg(ctx.target.arch, idx)
  when Option::Some(reg) then
    load_operand_aggregate_item(ctx, fctx, &args[idx], reg)
    codegen_string_str_arg_normalize(ctx, fctx, args, idx)
  when Option::None then ()
  end
end

def codegen_intrinsic(inout ctx: CodegenCtx, fctx: FnCodegenCtx, name: String, args: Vec[MirOperand], call_args: Vec[MirCallArg], orig_fn_name: String, dest_ty: Type, dest: Place) -> Bool
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
 # (THE SIMD GATE): a SIMD intrinsic name (the __intrinsic_simd_<op>_<lane>
  # family — the vector operations of the IntrinsicId domain, classified
  # by types.tg's SIMD router) routes to the SIMD emission BEFORE the
  # IntrinsicId dispatch: the SIMD arms inline the machine instructions
  # (aarch64 NEON + x86 SSE/AVX) and materialize the full vector image
  # into the destination place (returning true — the post-call register
  # store is suppressed). An unknown SIMD spelling fails closed (the
  # router's Option::None means the name is not a SIMD intrinsic and the
  # IntrinsicId dispatch below owns it).
  match simd_intrinsic_kind_of(&name)
  when Option::Some(kind) then
    match simd_intrinsic_lane_of(&name)
    when Option::Some(lane) then
      return codegen_simd_intrinsic(ctx, fctx, name, kind, lane, args, dest, dest_ty)
    when Option::None then
      panic("internal error: SIMD intrinsic `" + name + "` classified but its lane shape is unknown")
    end
  when Option::None then ()
  end
 # (IntrinsicId at check time): the classification comes from the ONE
  # semantic router (types.tg's classify_intrinsic_call — the same
  # classification the type checker attaches at call-recording time) over
  # the TYPED operand facts; codegen holds no name table. Fail-closed: a
  # name the semantic router does not recognize is an internal error.
  let recv_ty = if args.len() > 0 then strip_ref_like_type(&operand_type(ctx, fctx, &args[0])) else Type::Unit end
  let recv_named = match recv_ty
  when Type::Adt(ri_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ri_tid.id))
  when _ then "".to_string()
  end
  let needle_ty = if args.len() > 1 then operand_type(ctx, fctx, &args[1]) else Type::Unit end
  let needle_named = match strip_ref_like_type(&needle_ty)
  when Type::Adt(ni_tid, _) then bare_name_from_qualified(type_name_by_id(ctx, ni_tid.id))
  when _ then "".to_string()
  end
  let recv_is_string = if args.len() > 0 then is_string_operand(&args[0], fctx) else false end
  let needle_is_string = if args.len() > 1 then
    is_string_operand(&args[1], fctx) ||
    is_string_like_type(ctx, &needle_ty) ||
    is_string_like_type(ctx, &strip_ref_like_type(&needle_ty))
  else
    false
  end
  let id = classify_intrinsic_call(&name, &recv_ty, &recv_named, &needle_ty, &needle_named, &orig_fn_name, recv_is_string, needle_is_string)

 # the String-ABI discriminator — "string_*" canonical names
  # carry the owned String-object ABI (receivers are headers); "str_*"
  # names carry the raw str ABI. The byte-op arms below set
  # ctx.string_abi_unwrap around the shared emitters so their
  # maybe_load_string_data_ptr unwraps the receiver header.
  let is_string_abi = string_abi_intrinsic_name(&name)

  # Pure enum dispatch — no string comparisons. The intrinsic arm functions
  # (codegen_array_len, codegen_str_concat,...) are unchanged; only the
  # routing is enum-based. Unknown names never reach this match: they panic
  # in the semantic router's fail-closed classification, and the `when _`
  # arm below is the final guard.
  match id
  when IntrinsicId::ArrayAsPtrAddress then
    emit_load_mem(ctx, rr, rr, 0)
    emit_load_mem(ctx, rr, rr, 0)
  when IntrinsicId::ReadFileToStringNative then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    emit_call_label(ctx, "_tg_read_file_to_string")
  when IntrinsicId::SetIsEmpty then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view is_empty: [view + len_off] == 0.
      codegen_slice_is_empty(ctx)
    else
      emit_load_mem(ctx, rr, rr, 0)
      codegen_array_is_empty(ctx, &recv_ty)
    end
  when IntrinsicId::MapPush then
    emit_load_mem(ctx, rr, rr, 0)
    # map_push is the map-insert alias: the full hash/eq dispatch + the
    # Option[V] return wrap, exactly like MapInsert.
    codegen_map_insert(ctx, fctx, args, call_args, dest_ty)
  when IntrinsicId::ArrayReplace then
    # Checker-diagnosed (defensive last line): array_replace was routed to
    # _tg_str_concat in earlier work (silent semantic corruption) and has
    # no std surface; the checker rejects it with "unsupported: use the
    # std Array methods instead" before codegen. Reject instead of
    # emitting a wrong handler.
    panic("internal error: intrinsic `" + name + "` is unsupported (the checker rejects array_replace — use the std Array methods)")
  when IntrinsicId::ArrayAsStr then
    emit_load_mem(ctx, rr, rr, 0)
  when IntrinsicId::ArrayPush then
 # the element crosses per its value category (Scalar -> the
    # value word; ScalarPair/ByAddress -> the image ADDRESS — the runtime
    # byte-copies the full image). The arm normalizes the element slot and
    # re-derives the receiver's vec handle (the normalization may clobber
    # x0/rax through projected-place addressing).
    codegen_array_push(ctx, fctx, args)
 # the owned String-object operations — the String ABI. The
  # receiver arg0 arrives as &self (the ADDRESS of the String slot); one
  # deref yields the String OBJECT. push/push_str/reserve mutate the
  # object in place; len/as_ptr/as_str/clone/from_static are the object
  # queries and the owned conversions.
  when IntrinsicId::StringNew then
    emit_call_label(ctx, "_tg_string_new")
  when IntrinsicId::StringPush then
    emit_load_mem(ctx, rr, rr, 0)
    emit_call_label(ctx, "_tg_string_push")
  when IntrinsicId::StringPushStr then
    emit_load_mem(ctx, rr, rr, 0)
    # The str-typed operand: constants are the static StaticStrPtr (raw); a
    # non-ref String-typed value is an owned String object — unwrap it.
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    emit_call_label(ctx, "_tg_string_push_str")
  when IntrinsicId::StringReserve then
    emit_load_mem(ctx, rr, rr, 0)
    emit_call_label(ctx, "_tg_string_reserve")
  when IntrinsicId::StringLen then
    emit_load_mem(ctx, rr, rr, 0)
    emit_call_label(ctx, "_tg_string_len")
  when IntrinsicId::StringHash then
    emit_call_label(ctx, "_tg_hash_str")
  when IntrinsicId::RegexMatch then
    # the receiver = the text (the object/data pointer), the first arg =
    # the pattern — the runtime matcher's ABI: (text ptr, text len,
    # pattern ptr, pattern len).
    emit_call_label(ctx, "_tg_regex_match")
  when IntrinsicId::TypeProbe then
    # the coverage-test probe: returns the fixed 0 (the specimen's
    # exercise only — the call must compile and run).
    emit_store_word(ctx, rr, 0)
  when IntrinsicId::AstProbe then
    emit_store_word(ctx, rr, 0)
  when IntrinsicId::StringAsPtr | IntrinsicId::StringAsStr then
    emit_load_mem(ctx, rr, rr, 0)
    match id
    when IntrinsicId::StringAsStr then emit_call_label(ctx, "_tg_string_as_str")
    when _ then emit_call_label(ctx, "_tg_string_as_ptr")
    end
  when IntrinsicId::StringClone then
    emit_load_mem(ctx, rr, rr, 0)
    emit_call_label(ctx, "_tg_string_clone")
  when IntrinsicId::StringFromStatic then
    # The static StaticStrPtr (raw label) → owned String object copy. The arg
    # is a str-typed VALUE: constants are the raw label, RefInternal
    # operands carry the inlined raw str value — both pass through
    # unchanged (NO deref: the runtime copies the bytes).
    emit_call_label(ctx, "_tg_string_from_static")
  when IntrinsicId::ArrayPop then
 # VALUE-ABI: the runtime returns the popped element's IMAGE
    # ADDRESS or 0 (empty); codegen_option_payload_wrap constructs the
    # complete Option[T] TaggedPtr word — for a Scalar T the width-matched
    # payload load turns the value word into the Some payload; for
    # ScalarPair/ByAddress T the payload is the full-image address.
    codegen_collection_receiver_deref(ctx, fctx, call_args)
    codegen_array_pop(ctx)
    codegen_option_payload_wrap(ctx, dest_ty)
  when IntrinsicId::ArrayNew | IntrinsicId::ArrayWithCapacity then
    # The Vec header must carry the element stride from the CONCRETE
    # element type at this operation site (the destination type — a
    # monomorphized Vec/Array[T]). The stride is the runtime's
    # element-addressing authority. (String::new is NOT this path — it
    # routes to StringNew.)
    let new_elem_ty = vec_elem_type_of(ctx, dest_ty)
    let new_stride = element_stride_bytes(ctx, &new_elem_ty)
    emit_mov_ri(ctx, rr, new_stride as i64)
    codegen_array_new(ctx)
  when IntrinsicId::ArrayLen then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view len: the receiver is the &UnsafeSlice
      # borrow — arg0 holds the ADDRESS of the view; len is the view's
      # second word, never a heap-header read.
      codegen_slice_len(ctx)
    else
      emit_load_mem(ctx, rr, rr, 0)
      codegen_array_len(ctx, &recv_ty)
    end
  when IntrinsicId::ArrayGet then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view get: element at ptr + index * size_of(T) —
      # the element stride/width come from the layout engine (no fixed 8).
      let slice_elem_ty = project_index_type(ctx, &recv_value_ty)
      codegen_slice_get(ctx, &slice_elem_ty)
    else
      # The ordinary (non-Slice) ArrayGet path — the VALUE-ABI
      # materialization. The CHECKED path: index < len is verified here and
      # out-of-range TRAPS (the defined std OOB policy — panic on OOB)
      # before the UNCHECKED address primitive _tg_array_get runs. The
      # returned element ADDRESS is then materialized into the complete T
      # per its ValueCategory:
      #   ZeroSized         -> the zero word;
      #   Scalar(width)     -> the width-matched value word is loaded from
      #                        the address (the general call machinery
      #                        stores it);
      #   ScalarPair/ByAddr -> the FULL image is byte-copied into the
      #                        destination place and the post-call
      #                        register store is suppressed (return true).
      codegen_collection_receiver_deref(ctx, fctx, call_args)
      codegen_array_get_checked(ctx, &recv_value_ty)
      match classify_value_category(&mut ctx.layout_engine, dest_ty)
      when Result::Err(e) then
        panic("ICE: ArrayGet materialization classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
      when Result::Ok(cat) then
        match cat
        when ValueCategory::ZeroSized then
          emit_zero_reg(ctx, rr)
        when ValueCategory::Scalar(_) then
          let gw = storage_width_of(ctx, dest_ty)
          let ge = storage_signedness_of(dest_ty)
          emit_load_mem_sized(ctx, rr, rr, 0, gw, ge)
        when ValueCategory::ScalarPair(_, _) then
          codegen_array_image_to_dest(ctx, fctx, dest, 16)
          return true
        when ValueCategory::Vector(w) then
          # THE VECTOR CASE: a SIMD vector element — the FULL image is
          # materialized into the destination place (the post-call
          # register store is suppressed).
          codegen_array_image_to_dest(ctx, fctx, dest, w)
          return true
        when ValueCategory::ByAddress(sz) then
          codegen_array_image_to_dest(ctx, fctx, dest, sz)
          return true
        end
      end
    end
  when IntrinsicId::ArraySet then
    codegen_array_set(ctx, fctx, args)
  when IntrinsicId::StrSlice then
 # (the owned slice): _tg_string_slice computes the substring
    # and allocates the OWNED String object (header + buffer), copies the
    # bytes, NUL-terminates, and returns the OBJECT HANDLE — a function
    # returning String always returns the owned-object handle, never a raw
    # byte buffer. The receiver is normalized to the raw data pointer: a
    # String-object receiver (string_slice — the &String derefs to the
    # object, then [obj+0] unwraps the data pointer); a raw str receiver
    # (str_slice — the &str slot derefs once to the label). The result
    # lands in the return register.
    if is_string_abi then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      emit_load_mem(ctx, rr, rr, 0)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
    emit_call_label(ctx, "_tg_string_slice")
  when IntrinsicId::Syscall1 then codegen_syscall(ctx, 1)
  when IntrinsicId::Syscall2 then codegen_syscall(ctx, 2)
  when IntrinsicId::Syscall3 then codegen_syscall(ctx, 3)
  when IntrinsicId::Syscall4 then codegen_syscall(ctx, 4)
  when IntrinsicId::Syscall5 then codegen_syscall(ctx, 5)
  when IntrinsicId::Syscall6 then codegen_syscall(ctx, 6)
  when IntrinsicId::ArrayAsPtr then
    emit_load_mem(ctx, rr, rr, 0)
    emit_load_mem(ctx, rr, rr, 0)
  when IntrinsicId::IntToString then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_int_to_str(ctx)
  when IntrinsicId::FloatToString then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_float_to_str(ctx)
  when IntrinsicId::BoolToString then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_bool_to_str(ctx)
  when IntrinsicId::CharToString then
    deref_all_ref_like_args(ctx, fctx, args, rr)
    codegen_char_to_str(ctx)
  when IntrinsicId::StrToString then
    deref_all_ref_like_args(ctx, fctx, args, rr)
 # str.to_string() produces an OWNED String object — the
    # owned copy of the raw str value.
    codegen_string_wrap_result(ctx)
  when IntrinsicId::StringFromBytes then
    codegen_string_from_bytes(ctx)
  when IntrinsicId::ToString then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_ref_like_type(&arg_ty)
    deref_all_ref_like_args(ctx, fctx, args, rr)
    match value_ty
    when Type::Int then codegen_int_to_str(ctx)
    when Type::Float then codegen_float_to_str(ctx)
    when Type::F32 then codegen_float_to_str(ctx)
    when Type::F64 then codegen_float_to_str(ctx)
    when Type::Bool then codegen_bool_to_str(ctx)
    when Type::Char then codegen_char_to_str(ctx)
    when _ then ()
    end
  when IntrinsicId::AsBytes then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    match value_ty
    when Type::String then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      codegen_string_bytes(ctx)
    when _ then deref_all_ref_like_args(ctx, fctx, args, rr)
    end
  when IntrinsicId::AsPtr | IntrinsicId::AsStr then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    let is_string_receiver =
      is_string_like_type(ctx, &value_ty) ||
      orig_fn_name == "String__as_ptr" ||
      orig_fn_name == "String__as_str" ||
      orig_fn_name == "__intrinsic_string_as_ptr" ||
      orig_fn_name == "__intrinsic_string_as_str" ||
      orig_fn_name == "string_as_ptr" ||
      orig_fn_name == "string_as_str"
    if is_string_receiver then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
 # the receiver deref yields the String OBJECT; the
      # result of as_ptr/as_str is the object's data pointer.
      emit_load_mem(ctx, rr, rr, 0)
      normalize_string_arg0_for_current_arch(ctx)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
  when IntrinsicId::Clone then
 # (the clone-aware traversal — the read-then-clone shape): the
    # Clone intrinsic's receiver is the projected place read (the MIR
    # lowers `slot.clone()` — entries_cloned's key_ref/val_ref, the
    # snapshot iterators' `self.entries[i].0.clone()` — as the slot's
    # ADDRESS; NO image of the stored value is ever materialized, so this
    # arm never byte-copies a resource). The CONCRETE clone implementation
    # is dispatched from the receiver's concrete type (post-mono):
    #   - String -> _tg_string_clone (the String-ABI deep copy: the &self
    #     slot is deref'd once to the String OBJECT, then the runtime
    #     clone allocates a fresh buffer);
    #   - an Adt with a COMPILED "TypeName__clone" body -> a direct call
    #     to it (the body receives the &self ADDRESS — the projected read
    #     — and clones in place; the Scalar-size gate keeps the ABI
    #     simple: a Scalar result crosses in the value register);
    #   - everything else -> the receiver-deref shape (unchanged
    #     behavior for the intrinsic-receiver and non-clone-body types).
    let cl_ty = if args.len() > 0 then strip_ref_like_type(&operand_type(ctx, fctx, &args[0])) else Type::Unit end
    match cl_ty
    when Type::String then
      deref_all_ref_like_args(ctx, fctx, args, rr)
      emit_call_label(ctx, "_tg_string_clone")
    when Type::Adt(cl_tid, _) then
      let cl_base = bare_name_from_qualified(type_name_by_id(ctx, cl_tid.id))
      let cl_fn = cl_base + "__clone"
      if (ctx.reachable_fns.contains(&cl_fn) || ctx.extern_fns.contains(&cl_fn)) &&
         layout_of_strict(&mut ctx.layout_engine, &cl_ty).size <= 8 then
        emit_call_label(ctx, resolve_callee_label(ctx, &cl_fn))
      else
        deref_all_ref_like_args(ctx, fctx, args, rr)
      end
    when _ then
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
  when IntrinsicId::Len then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    let is_pure_string =
      (match value_ty
       when Type::String then true
       else false
       end) ||
      orig_fn_name == "String__len" ||
      orig_fn_name == "__intrinsic_string_len" ||
      orig_fn_name == "string_len"
    # Fixed arrays (collapsed): the canonical Array count is are not part of the model —
    # the Adt Array form is the heap-vector identity, so every array is a
    # collection receiver whose len lives in the heap header
    # (codegen_array_len reads it from the engine's container_field_offset).
    let is_collection_receiver =
      is_heap_collection_type(ctx, &value_ty) ||
      orig_fn_name == "Vec__len" ||
      orig_fn_name == "Array__len" ||
      orig_fn_name == "Map__len" ||
      orig_fn_name == "Set__len" ||
      orig_fn_name == "__intrinsic_array_len" ||
      orig_fn_name == "array_len"
    if is_slice_view_type(ctx, &value_ty) then
      # UnsafeSlice[T] raw-view len: arg0 is the &UnsafeSlice borrow — the
      # ADDRESS of the view value. The len is the view's second word
      # (slice_view_field_offset), NEVER a heap-header read. No deref: the
      # view base stays in arg0.
      codegen_slice_len(ctx)
    # Fixed arrays (collapsed): the canonical Array count is are not part of the model —
    # the Adt Array form is the heap-vector identity, so every array is a
    # collection receiver whose len lives in the heap header
    # (codegen_array_len reads it from the engine's container_field_offset).
    elsif is_collection_receiver then
      # Vec/Map/Set — len is stored in the heap header (offset from the
      # engine's container_field_offset, see codegen_array_len).
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      codegen_array_len(ctx, &value_ty)
    elsif is_pure_string then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
 # the String OBJECT's cached length is the header field at
      # [obj+8] — never a strlen over the header.
      emit_load_mem(ctx, rr, rr, 8)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
      codegen_strlen(ctx)
    end
  when IntrinsicId::StrConcat then
 # the concat operands are String OBJECTS (or static
    # StaticStrPtr constants) — normalize to the raw byte form the concat
    # emitter takes, then wrap the raw result into an owned String object.
    codegen_string_str_arg_normalize(ctx, fctx, args, 0)
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    emit_call_label(ctx, "_tg_str_concat")
    codegen_string_wrap_result(ctx)
  when IntrinsicId::StrLen then
    codegen_str_len(ctx)
  when IntrinsicId::StrCmp then
    codegen_str_cmp(ctx)
  when IntrinsicId::StrFind then
    # The String-ABI receiver unwrap (string_find: the emitter derefs
    # &self → String object, then maybe_load_string_data_ptr unwraps the
    # header); the needle normalizes to raw first (constants are the
    # static StaticStrPtr; String-typed places are objects).
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    ctx.string_abi_unwrap = is_string_abi
    codegen_str_find(ctx)
    ctx.string_abi_unwrap = false
  when IntrinsicId::StartsWith then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(ctx, &arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    ctx.string_abi_unwrap = is_string_abi
    codegen_starts_with(ctx)
    ctx.string_abi_unwrap = false
  when IntrinsicId::EndsWith then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(ctx, &arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    ctx.string_abi_unwrap = is_string_abi
    codegen_ends_with(ctx)
    ctx.string_abi_unwrap = false
  when IntrinsicId::StringContains then
    if args.len() > 0 then
      let arg0_ty = operand_type(ctx, fctx, &args[0])
      let arg0_value_ty = strip_receiver_ptr_like_type(&arg0_ty)
      if is_receiver_ptr_like_type(&arg0_ty) && is_string_like_type(ctx, &arg0_value_ty) then
        deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      end
    end
    codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    ctx.string_abi_unwrap = is_string_abi
    codegen_string_contains(ctx)
    ctx.string_abi_unwrap = false
  when IntrinsicId::StrCopy then
    codegen_str_copy(ctx)
  when IntrinsicId::IntToStr then
    codegen_int_to_str(ctx)
  when IntrinsicId::FloatToStr then
    codegen_float_to_str(ctx)
  when IntrinsicId::StrToInt then
 # string_parse_int's receiver is a String OBJECT — deref
    # &self → object, then unwrap [obj+0] → data before the byte parser.
    # str_to_int (raw str receivers) derefs the &str slot once.
    if is_string_abi then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      emit_load_mem(ctx, rr, rr, 0)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
    codegen_str_to_int(ctx)
  when IntrinsicId::StrToFloat then
    if is_string_abi then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
      emit_load_mem(ctx, rr, rr, 0)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
    codegen_str_to_float(ctx)

  # Array/Vec — collection method receivers are references to locals that
  # store the heap header pointer, so dereference once before invoking the
  # runtime helper.
  when IntrinsicId::ArrayCap then
    emit_load_mem(ctx, rr, rr, 0)
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_array_cap(ctx, &recv_ty)
  when IntrinsicId::ArrayRemove then
 # VALUE-ABI: the runtime returns the complete T per the
    # element's ValueCategory — the width-matched VALUE WORD for a Scalar
    # element (the general call machinery stores it) or the ADDRESS of a
    # fresh bump copy of the FULL removed image for ScalarPair/ByAddress
    # (materialized into the destination place below; the post-call
    # register store is suppressed).
    codegen_collection_receiver_deref(ctx, fctx, call_args)
    codegen_array_remove(ctx)
    match classify_value_category(&mut ctx.layout_engine, dest_ty)
    when Result::Err(e) then
      panic("ICE: ArrayRemove materialization classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
    when Result::Ok(cat) then
      match cat
      when ValueCategory::ZeroSized then
        emit_zero_reg(ctx, rr)
      when ValueCategory::Scalar(_) then
        ()  # the complete scalar T is already in the return register
      when ValueCategory::ScalarPair(_, _) then
        codegen_array_image_to_dest(ctx, fctx, dest, 16)
        return true
      when ValueCategory::ByAddress(sz) then
        codegen_array_image_to_dest(ctx, fctx, dest, sz)
        return true
      end
    end
  when IntrinsicId::ArrayInsert then
    codegen_array_insert(ctx, fctx, args)
  when IntrinsicId::ArrayClear then
    emit_load_mem(ctx, rr, rr, 0)
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_array_clear(ctx, &recv_ty)
  when IntrinsicId::ArrayDestroy then
    # Fixed arrays (collapsed): the canonical Array count is are not part of the model —
    # the Adt Array form is the heap-vector identity, so every array owns a
    # backing buffer and the destroy always takes the release path.
 # (x86-64 parity): _tg_array_destroy's x86 body munmaps the backing
    # buffer — no compile-time rejection.
    let destroy_recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_destroy(ctx)
  when IntrinsicId::ArrayContains then
    # VALUE-ABI (Eq dispatch): arg1 arrives as the &T reference VALUE (the
    # item ADDRESS — NO deref: the runtime probes the element bytes by
    # reference); the arm resolves the CONCRETE Eq::eq instance address
    # (map_eq_dispatch_label — the same dispatch the map keys use: the
    # compiled `impl Eq for T` instance, _tg_eq_str for String objects,
    # _tg_eq_str_view for StrView, or the _tg_eq_mem structural fallback
    # with the element stride) into arg2 and calls _tg_array_contains.
    codegen_collection_receiver_deref(ctx, fctx, call_args)
    codegen_array_contains(ctx, fctx, args)
  when IntrinsicId::ArrayLast then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view last: element at ptr + (len-1) * size_of(T).
      let slice_elem_ty = project_index_type(ctx, &recv_value_ty)
      codegen_slice_last(ctx, &slice_elem_ty)
    else
      emit_load_mem(ctx, rr, rr, 0)
      codegen_array_last(ctx, &recv_ty)
    end
  when IntrinsicId::ArrayFirst then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view first: element at ptr.
      let slice_elem_ty = project_index_type(ctx, &recv_value_ty)
      codegen_slice_first(ctx, &slice_elem_ty)
    else
      emit_load_mem(ctx, rr, rr, 0)
      codegen_array_first(ctx, &recv_ty)
    end
  when IntrinsicId::ArrayIsEmpty then
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let recv_value_ty = strip_receiver_ptr_like_type(&recv_ty)
    if is_slice_view_type(ctx, &recv_value_ty) then
      # UnsafeSlice[T] raw-view is_empty: [view + len_off] == 0.
      codegen_slice_is_empty(ctx)
    else
      emit_load_mem(ctx, rr, rr, 0)
      codegen_array_is_empty(ctx, &recv_ty)
    end
  when IntrinsicId::ArrayReverse then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_reverse(ctx)
  when IntrinsicId::ArraySort then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_array_sort(ctx)
  when IntrinsicId::ArrayExtend then
    emit_load_mem(ctx, rr, rr, 0)
    deref_arg_once_if_ref_like(ctx, fctx, args, call_args, 1)
    codegen_array_extend(ctx)
  when IntrinsicId::ArrayTruncate then
    emit_load_mem(ctx, rr, rr, 0)
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_array_truncate(ctx, &recv_ty)
  when IntrinsicId::ArrayResize then
    codegen_array_resize(ctx, fctx, args)

  # Map intrinsics — dereference &self for all methods (not constructors)
  when IntrinsicId::MapNew then
    codegen_map_new(ctx, dest_ty)
  when IntrinsicId::MapInsert then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_insert(ctx, fctx, args, call_args, dest_ty)
  when IntrinsicId::MapGet then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_get(ctx, fctx, args, call_args, dest_ty)
  when IntrinsicId::MapRemove then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_remove(ctx, fctx, args, call_args, dest_ty)
  when IntrinsicId::MapRemoveKey then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_remove_key(ctx, fctx, args, call_args)
  when IntrinsicId::OptionWrap then
    # The MIR's ownership remove: args[0] = the address of the caller's
    # V-typed slot (0 for a Unit map). The generic call marshalling left
    # the address in x0/rax — codegen_option_payload_wrap re-encodes it
    # (V <= 8: the VALUE WORD loaded from the address; V > 8: the address
    # itself as the payload — the same conventions the map ops use).
    codegen_option_payload_wrap(ctx, dest_ty)
  when IntrinsicId::MapContains then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_contains(ctx, fctx, args, call_args)
  when IntrinsicId::MapLen then
    emit_load_mem(ctx, rr, rr, 0)
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_map_len(ctx, &recv_ty)
  when IntrinsicId::MapClone then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_clone(ctx, fctx, args)
  when IntrinsicId::MapClear then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_clear(ctx)
  when IntrinsicId::MapKeys then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_keys(ctx, fctx, args)
  when IntrinsicId::MapValues then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_values(ctx)
  when IntrinsicId::MapEntries then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_entries(ctx, fctx, args)
  when IntrinsicId::MapDrainOne then
 # (x86-64 parity): the ownership-transfer drain has x86 bodies in
    # the runtime (_tg_map_drain_one_full) — no compile-time rejection.
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_drain_one(ctx, fctx, args)
  when IntrinsicId::MapDestroy then
 # (x86-64 parity): _tg_map_destroy's x86 body releases the arena,
    # the overflow chains and the free list — no compile-time rejection.
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_destroy(ctx)

  # Set intrinsics — a set IS a Map[T, Unit]: every set operation forwards
  # to the map runtime with the element type as the map's key type.
  when IntrinsicId::SetNew then
    codegen_set_new(ctx, dest_ty)
  when IntrinsicId::SetInsert then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_insert(ctx, fctx, args, call_args)
  when IntrinsicId::SetContains then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_contains(ctx, fctx, args, call_args)
  when IntrinsicId::SetRemove then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_remove(ctx, fctx, args, call_args)
  when IntrinsicId::SetRemoveKey then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_remove_key(ctx, fctx, args, call_args)
  when IntrinsicId::SetLen then
    emit_load_mem(ctx, rr, rr, 0)
    let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_set_len(ctx, &recv_ty)
  when IntrinsicId::SetClone then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_clone(ctx, fctx, args)
  when IntrinsicId::SetEntries then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_entries(ctx, fctx, args)
  when IntrinsicId::SetDrainOne then
 # (x86-64 parity): _tg_set_drain_one_full's x86 body implements the
    # ownership-transfer drain — no compile-time rejection.
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_drain_one(ctx)
  when IntrinsicId::SetDestroy then
 # (x86-64 parity): set_destroy forwards to _tg_map_destroy, whose
    # x86 body releases the backing storage — no compile-time rejection.
    emit_load_mem(ctx, rr, rr, 0)
    codegen_set_destroy(ctx)
  when IntrinsicId::SetClear then
    emit_load_mem(ctx, rr, rr, 0)
    codegen_map_clear(ctx)

  # drop_in_place: typed destruction of the POINTEE of Ptr[T] using the
  # semantic authority's plan (the Ptr builtin method is NOT an empty shim).
 # (plan-key fix): the plan lookup keys by the CONCRETE (TypeId, substs)
  # identity (mir_type_identity_key) — the MIR carries the concrete-keyed
  # table (MirProgram.deinit_plans), so Wrapper[Int] and Wrapper[File] are
  # distinct entries; the old TypeId-keyed lookup served the unsubstituted
 # nominal shape. the destruction itself is ONE call to the
  # pre-generated drop-GLUE function for the concrete pointee type — codegen
  # holds no destruction knowledge (the recursive plan walk lives in the
  # glue function's MIR body).
  when IntrinsicId::DropInPlace then
    if args.len() >= 1 then
      let ptr_ty = operand_type(ctx, fctx, &args[0])
      match ptr_ty
      when Type::Ptr(inner) then
        match inner
        when Type::Adt(_, _) then
          match ctx.deinit_plans.get(mir_type_identity_key(&inner))
          when Option::Some(plan) then
            if !deinit_plan_is_trivial(plan) then
              match codegen_drop_glue_label_for_type(ctx, &inner)
              when Option::Some(glue_label) then
                match args[0].kind
                when MirOperandKind::MirCopy(p) then
                  var projs = p.projections.clone()
                  projs.push(Projection::ProjDeref)
                  let pointee = Place { local: p.local, projections: projs }
                  match arg_reg(ctx.target.arch, 0)
                  when Option::Some(r0) then
                    emit_place_address(ctx, fctx, &pointee, r0)
                    emit_call_label(ctx, glue_label)
                  when Option::None then ()
                  end
                when _ then ()
                end
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  # Typed drop glue: the generic drop[T] library shim is EMPTY; the codegen
  # destroys the CONCRETE argument through its pre-generated drop-glue
 # function (the label resolved from the concrete type — no
  # destruction knowledge in codegen).
  when IntrinsicId::Drop then
    if args.len() >= 1 then
      # The argument may be a reference (Rc's last-release calls
      # drop(&mut inner.value)): the DESTROYED value is the referent. The
 # plan is keyed by the CONCRETE substituted type (the plan-key
      # fix: mir_type_identity_key on the concrete type — Wrapper[Int] and
      # Wrapper[File] are distinct entries; the TypeId-only key would serve
      # the unsubstituted nominal shape).
      let drop_ty = strip_ref_like_type(&operand_type(ctx, fctx, &args[0]))
      match drop_ty
      when Type::Adt(_, _) then
        match ctx.deinit_plans.get(mir_type_identity_key(&drop_ty))
        when Option::Some(plan) then
          if !deinit_plan_is_trivial(plan) then
            match codegen_drop_glue_label_for_type(ctx, &drop_ty)
            when Option::Some(glue_label2) then
              match args[0].kind
              when MirOperandKind::MirCopy(p) then
                match arg_reg(ctx.target.arch, 0)
                when Option::Some(r0b) then
                  emit_place_address(ctx, fctx, &p, r0b)
                  emit_call_label(ctx, glue_label2.clone())
                when Option::None then ()
                end
              when MirOperandKind::MirMovePlace(p) then
                match arg_reg(ctx.target.arch, 0)
                when Option::Some(r0c) then
                  emit_place_address(ctx, fctx, &p, r0c)
                  emit_call_label(ctx, glue_label2.clone())
                when Option::None then ()
                end
              when MirOperandKind::MirConsume(p) then
                match arg_reg(ctx.target.arch, 0)
                when Option::Some(r0d) then
                  emit_place_address(ctx, fctx, &p, r0d)
                  emit_call_label(ctx, glue_label2)
                when Option::None then ()
                end
              when _ then ()
              end
            when Option::None then ()
            end
          end
        when Option::None then ()
        end
      when _ then ()
      end
    end

  # Memory intrinsics
  when IntrinsicId::MemAlloc then
    codegen_mem_alloc(ctx)
  when IntrinsicId::MemFree then
    codegen_mem_free(ctx)
  when IntrinsicId::MemCopy then
    codegen_mem_copy(ctx)
  when IntrinsicId::MemSet then
    codegen_mem_set(ctx)
  when IntrinsicId::MemZero then
    codegen_mem_zero(ctx)

  # Hash intrinsics
  when IntrinsicId::HashInt then
    codegen_hash_int(ctx)
  when IntrinsicId::HashStr then
    codegen_hash_str(ctx)
  when IntrinsicId::HashCombine then
    codegen_hash_combine(ctx)

  # String iteration
  when IntrinsicId::Chars then
    emit_call_label(ctx, "_tg_str_chars")

  # String byte indexing
  when IntrinsicId::CharAt then
 # string_char_at's receiver is a String OBJECT — the
    # emitter derefs &self → object, then maybe_load_string_data_ptr
    # (flag set) unwraps [obj+0] → data before the byte load. Every name
    # the router classifies as CharAt ("string_char_at" — the String-ABI
    # name — and the bare "char_at") unwraps the object header.
    ctx.string_abi_unwrap = true
    codegen_char_at(ctx)
    ctx.string_abi_unwrap = false

 # CString intrinsics — cstring_new(s: String) → CString is
  # the String-object data pointer (the runtime _tg_cstring_new unwraps
  # the object; arg0 = the String value by-value); cstring_as_ptr(&cs)
  # then loads that raw pointer back out of the local/reference slot.
  when IntrinsicId::CStringNew then
    ()
  when IntrinsicId::CStringAsPtr then
    emit_load_mem(ctx, rr, rr, 0)

  # String.bytes() → Vec[Int]: create a Vec of the C string's bytes
  # Since this involves allocation and looping, delegate to runtime helper
  when IntrinsicId::Bytes then
    let arg_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    let value_ty = strip_receiver_ptr_like_type(&arg_ty)
    if is_string_like_type(ctx, &value_ty) then
      deref_all_receiver_ptr_like_args(ctx, fctx, args, rr)
    else
      deref_all_ref_like_args(ctx, fctx, args, rr)
    end
    codegen_string_bytes(ctx)

  # Option/Result discriminant checks: arg0 = &self (ptr to the enum).
  # The tag normalization and the "Some"/"None"/"Ok"/"Err" discriminants
  # come from the receiver's EnumLayout — the single enum-representation
  # authority. Option/Result get their representation exactly like every
  # other enum after generic substitution; there is no Option/OpaquePtr
  # special case anywhere in codegen.
  when IntrinsicId::IsSome then
    emit_load_mem(ctx, rr, rr, 0)
    let is_ty = strip_receiver_ptr_like_type(&operand_type(ctx, fctx, &args[0]))
    normalize_enum_value_to_tag(ctx, rr, &is_ty)
    let is_some_disc = enum_variant_discriminant_of(ctx, &is_ty, "Some")
    emit_cmp_ri(ctx, rr, is_some_disc)
    emit_setcc(ctx, CondKind::Eq, rr)
  when IntrinsicId::IsNone then
    emit_load_mem(ctx, rr, rr, 0)
    let in_ty = strip_receiver_ptr_like_type(&operand_type(ctx, fctx, &args[0]))
    normalize_enum_value_to_tag(ctx, rr, &in_ty)
    let in_some_disc = enum_variant_discriminant_of(ctx, &in_ty, "Some")
    emit_cmp_ri(ctx, rr, in_some_disc)
    emit_setcc(ctx, CondKind::Ne, rr)

  # Option/Result unwrap: arg0 = &self (ptr to enum). The representation
  # comes from the receiver's EnumLayout (TaggedPtr: a raw value below the
  # layout threshold is an inline tag — treat as None/Err and trap; at/above
  # the threshold is a heap pointer to the image whose tag sits at
  # tag_layout.offset and whose success payload sits at payload_offset).
  # Success = the FIRST variant's discriminant (Some/Ok are variant 0).
  # Codegen holds no threshold/offset policy.
  when IntrinsicId::Unwrap then
    let scratch = scratch_reg(arch)
    emit_load_mem(ctx, rr, rr, 0)
    let uw_ty = strip_receiver_ptr_like_type(&operand_type(ctx, fctx, &args[0]))
    emit_mov_rr(ctx, scratch, rr)
    let ok_label = ".Lunwrap_ok." + ctx.fn_counter.to_string()
    let trap_label = ".Lunwrap_trap." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    let uw_el = enum_layout_strict(ctx, &uw_ty)
    let uw_first_disc = enum_first_variant_discriminant(ctx, &uw_ty)
    match uw_el.representation
    when EnumValueRepresentation::TaggedPtr(threshold) then
      emit_cmp_ri(ctx, scratch, threshold)
      emit_jcc(ctx, CondKind::Lt, trap_label.clone())
      # Heap pointer: load discriminant
      emit_load_mem(ctx, rr, scratch, uw_el.tag_layout.offset)
      emit_cmp_ri(ctx, rr, uw_first_disc)
      emit_jcc(ctx, CondKind::Eq, ok_label.clone())
      def_label(&mut ctx.text, trap_label)
      emit_trap(ctx)
      def_label(&mut ctx.text, ok_label)
      # scratch holds the heap pointer; the payload sits at payload_offset
      emit_load_mem(ctx, rr, scratch, uw_el.payload_offset)
    when EnumValueRepresentation::InlineTagged then
      panic("ICE: unwrap of an InlineTagged-represented enum is not supported by the register encoding (no registered enum uses InlineTagged today)")
    when EnumValueRepresentation::Opaque then
      panic("ICE: unwrap on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&uw_ty))
    end

  # Option/Result unwrap_or: arg0 = &self (ptr to enum), arg1 = default
  when IntrinsicId::UnwrapOr then
    let scratch = scratch_reg(arch)
    emit_load_mem(ctx, rr, rr, 0)
    let uo_ty = strip_receiver_ptr_like_type(&operand_type(ctx, fctx, &args[0]))
    emit_mov_rr(ctx, scratch, rr)
    let none_label = ".Lunwrap_or_none." + ctx.fn_counter.to_string()
    let some_label = ".Lunwrap_or_some." + ctx.fn_counter.to_string()
    let done_label = ".Lunwrap_or_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    let uo_el = enum_layout_strict(ctx, &uo_ty)
    let uo_first_disc = enum_first_variant_discriminant(ctx, &uo_ty)
    match uo_el.representation
    when EnumValueRepresentation::TaggedPtr(threshold) then
      # If raw < threshold, treat as None (inline tag or uninitialized field)
      emit_cmp_ri(ctx, scratch, threshold)
      emit_jcc(ctx, CondKind::Lt, none_label.clone())
      # Heap pointer: load discriminant and compare to the first variant
      # (Some/Ok); anything else is None/Err.
      emit_load_mem(ctx, rr, scratch, uo_el.tag_layout.offset)
      emit_cmp_ri(ctx, rr, uo_first_disc)
      emit_jcc(ctx, CondKind::Eq, some_label.clone())
      # disc != first => None/Err
      emit_jmp(ctx, none_label.clone())
      def_label(&mut ctx.text, some_label)
      # Some case: payload at [heap_ptr + payload_offset]
      emit_load_mem(ctx, rr, scratch, uo_el.payload_offset)
      emit_jmp(ctx, done_label.clone())
      # None case: return default (arg1)
      def_label(&mut ctx.text, none_label)
      match arg_reg(arch, 1)
      when Option::Some(r) then emit_mov_rr(ctx, rr, r)
      when Option::None then ()
      end
      def_label(&mut ctx.text, done_label)
    when EnumValueRepresentation::InlineTagged then
      panic("ICE: unwrap_or of an InlineTagged-represented enum is not supported by the register encoding (no registered enum uses InlineTagged today)")
    when EnumValueRepresentation::Opaque then
      panic("ICE: unwrap_or on an opaque (unresolved) EnumLayout for type " + mir_type_identity_key(&uo_ty))
    end

  # Process/Environment intrinsics - call runtime functions
  when IntrinsicId::Status then
    emit_call_label(ctx, "_tg_status")
  when IntrinsicId::Output then
    emit_call_label(ctx, "_tg_output")
  when IntrinsicId::StdoutString then
    emit_call_label(ctx, "_tg_stdout_string")
  when IntrinsicId::StderrString then
    emit_call_label(ctx, "_tg_stderr_string")

  # Formatter intrinsics - these are no-op/identity for code generation
  # The Formatter is a compile-time construct for pretty-printing
  when IntrinsicId::FormatterNoOp then
    ()  # No-op - formatter state changes don't generate runtime code
  when IntrinsicId::FormatterEmitNewline then
    ()  # No-op - newline emission is compile-time
  when IntrinsicId::WouldOverflow then
    # Return false (0) - no overflow check at runtime
    emit_zero_reg(ctx, rr)

  # Utility intrinsics
  when IntrinsicId::Cmp then
    # Compare two values - use str_cmp for strings, integer compare otherwise
    codegen_str_cmp(ctx)
  when IntrinsicId::ToInt then
    # Identity - value is already an int
    ()
  when IntrinsicId::LintFile then
    # Linting is a compile-time operation - no runtime code
    emit_zero_reg(ctx, rr)

  # File constants - return constant values
  when IntrinsicId::SysWrite then
    emit_mov_ri(ctx, rr, 1)   # __NR_write on Linux
  when IntrinsicId::SysRead then
    emit_mov_ri(ctx, rr, 0)   # __NR_read on Linux
  when IntrinsicId::SysOpen then
    emit_mov_ri(ctx, rr, 2)   # __NR_open on Linux
  when IntrinsicId::SysClose then
    emit_mov_ri(ctx, rr, 3)   # __NR_close on Linux
  when IntrinsicId::SysExit then
    emit_mov_ri(ctx, rr, 60)  # __NR_exit on Linux
  when IntrinsicId::OWriteOnly then
    emit_mov_ri(ctx, rr, 1)
  when IntrinsicId::ORdWr then
    emit_mov_ri(ctx, rr, 2)
  when IntrinsicId::OAppend then
    emit_mov_ri(ctx, rr, 1024)
  when IntrinsicId::OCreate then
    emit_mov_ri(ctx, rr, 64)
  when IntrinsicId::OTrunc then
    emit_mov_ri(ctx, rr, 512)
  when IntrinsicId::OpenWindows then
    # Windows not supported on macOS/Linux - return error
    emit_mov_ri(ctx, rr, -1)

 # / collection surfaces: the String-object operations
  # (trim / trim_matches / to_lowercase / to_uppercase / replace / split /
  # lines) and the owned-Vec operations (slice / from_list / capacity).
  # The receivers are normalized to the OWNED String object / Vec handle
  # and the work runs in the _tg_string_* / _tg_array_* runtime helpers on
  # BOTH arches. The result lands in the return register (the object
  # handle or the Vec handle — both are 8-byte values the general call
  # machinery stores).
  when IntrinsicId::StringTrim | IntrinsicId::TrimMatches then
    # trim: (s) -> _tg_string_trim; trim_matches: (s, pattern) ->
    # _tg_string_trim_matches. The pattern is normalized to raw bytes.
    let trim_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
    if trim_converted then
      codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
    else
      codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    end
    if args.len() > 1 then
      emit_call_label(ctx, "_tg_string_trim_matches")
    else
      emit_call_label(ctx, "_tg_string_trim")
    end
  when IntrinsicId::StringToLowercase | IntrinsicId::ToLowercase then
    # Both the lowercase and the uppercase mapping route here; the callee
    # name discriminates the direction (the router classifies
    # to_lowercase/to_uppercase/string_to_lowercase/string_to_uppercase
    # to this id).
    let case_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
    if case_converted then
      codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
    end
    if name == "to_uppercase" || name == "string_to_uppercase" then
      emit_call_label(ctx, "_tg_string_toupper")
    else
      emit_call_label(ctx, "_tg_string_tolower")
    end
  when IntrinsicId::StringReplace then
    # (s, from, to) -> _tg_string_replace; from/to normalize to raw bytes.
    let rep_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
    if rep_converted then
      codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
      codegen_string_intrinsic_reload_arg(ctx, fctx, args, 2)
    else
      codegen_string_str_arg_normalize(ctx, fctx, args, 1)
      codegen_string_str_arg_normalize(ctx, fctx, args, 2)
    end
    emit_call_label(ctx, "_tg_string_replace")
  when IntrinsicId::StringSplit then
    # (s, sep) -> _tg_string_split: a Vec[String] of OWNED String objects
    # (the helper slices each segment through _tg_string_slice and pushes
    # the handles through the collection ABI).
    let split_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
    if split_converted then
      codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
    else
      codegen_string_str_arg_normalize(ctx, fctx, args, 1)
    end
    emit_call_label(ctx, "_tg_string_split")
  when IntrinsicId::StringSplitLines then
    # lines: (s) -> _tg_string_split(s, "\n") — the static newline view.
    let lines_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
    match arg_reg(ctx.target.arch, 1)
    when Option::Some(sep_reg) then
      let nl_label = intern_string(ctx, "\n")
      emit_lea_label(ctx, sep_reg, nl_label)
    when Option::None then ()
    end
    emit_call_label(ctx, "_tg_string_split")
  when IntrinsicId::SplitLinesTrim then
    # The bare split/lines/trim method names (the router dispatches them
    # type-directed; this arm implements all three by callee name).
    if name == "split" then
      let sl_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
      if sl_converted then
        codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
      else
        codegen_string_str_arg_normalize(ctx, fctx, args, 1)
      end
      emit_call_label(ctx, "_tg_string_split")
    elsif name == "lines" then
      let ln_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
      match arg_reg(ctx.target.arch, 1)
      when Option::Some(sep_reg) then
        let nl_label = intern_string(ctx, "\n")
        emit_lea_label(ctx, sep_reg, nl_label)
      when Option::None then ()
      end
      emit_call_label(ctx, "_tg_string_split")
    else
      let tr_converted = codegen_string_intrinsic_receiver_object(ctx, fctx, args)
      if tr_converted then
        codegen_string_intrinsic_reload_arg(ctx, fctx, args, 1)
      else
        codegen_string_str_arg_normalize(ctx, fctx, args, 1)
      end
      if args.len() > 1 then
        emit_call_label(ctx, "_tg_string_trim_matches")
      else
        emit_call_label(ctx, "_tg_string_trim")
      end
    end
  when IntrinsicId::ArraySlice then
    # (arr, start, end) -> _tg_array_slice: the owned Vec copy of the
    # span (the helper reads the element stride from the SOURCE header —
    # the collection ABI's stride authority).
    emit_load_mem(ctx, rr, rr, 0)
    emit_call_label(ctx, "_tg_array_slice")
  when IntrinsicId::ArrayFromList then
    # (items: &[T]) -> _tg_array_from_list: the arg is the &[T] borrow —
    # the ADDRESS of the raw UnsafeSlice view {ptr@0, len@8} (the
    # array-literal argument is the heap-vector form whose header
    # {data@0, len@8} is the same leading layout). The element stride
    # comes from the CONCRETE destination element type at this operation
    # site.
    let fl_elem_ty = vec_elem_type_of(ctx, dest_ty)
    let fl_stride = element_stride_bytes(ctx, &fl_elem_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_ldur(&mut ctx.text, A64::X1, A64::X0, 8)   # len (before clobbering x0)
      a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)   # data
      a64_mov_ri(&mut ctx.text, A64::X2, fl_stride as i64)
    when Arch::X86_64 then
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)  # len
      x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)  # data
      x64_mov_ri(&mut ctx.text, X64::RDX, fl_stride as i64)
    end
    emit_call_label(ctx, "_tg_array_from_list")
  when IntrinsicId::ArrayCapacity then
    # capacity: the header read (cap@16 — the collection ABI's
    # container_field_offset authority), exactly like ArrayCap.
    emit_load_mem(ctx, rr, rr, 0)
    let cap_recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
    codegen_array_cap(ctx, &cap_recv_ty)

  # Checker-diagnosed surfaces — the type checker rejects the explicit
  # intrinsic spellings with an "unsupported: use X instead" error at
  # call-recording time (record_intrinsic_classification in types.tg), so
  # compilation aborts before codegen. The bare method names these were
  # once misrouted from are COMPILED methods with real std bodies
  # (split_once via find+slice, map/join/collect via the std methods).
  # These arms are the DEFENSIVE last line only: if a classification ever
  # reaches them, the compiler fails closed with an internal error rather
  # than emit a semantically wrong handler (the historical
  # identity/clone/concat misroutes).
  when IntrinsicId::SplitOnce then
    panic("internal error: intrinsic `" + name + "` is unsupported (the checker rejects string_split_once with 'use find + slice instead'; the bare split_once method is the std body)")
  when IntrinsicId::MapJoinCollect then
    panic("internal error: intrinsic `" + name + "` is unsupported (the checker rejects map/join/collect — the std methods implement them)")
  when IntrinsicId::StringIsEmptyChars then
    panic("internal error: intrinsic `" + name + "` is unsupported (the checker rejects string_is_empty/string_chars — use is_empty / len() == 0)")
  when IntrinsicId::ArrayJoin then
    panic("internal error: intrinsic `" + name + "` is unsupported (the checker rejects array join — use the std Array::join method)")

  when _ then
    # Fail closed: an intrinsic with no handler must be a compiler error,
    # never a silent zero (a fake value would corrupt semantics).
    panic("internal error: unknown or unsupported intrinsic `" + name + "`")
  end
    # The default result: the intrinsic arm materialized its result in the
  # return register — the general call machinery stores it into dest. Arms
  # that wrote the FULL result image into the destination place themselves
  # (the ArrayGet/ArrayRemove ScalarPair/ByAddress materializations) return
  # true so that store is suppressed.
  false
end

# ———————————————————————————————————————————————————————————————
# THE SIMD EMISSION — aarch64 NEON + x86 SSE/AVX arms
# ———————————————————————————————————————————————————————————————
# The vector operations of the IntrinsicId domain (the __intrinsic_simd_*
# family — the SIMD sub-domain classified in types.tg). The vectors are
# the std Vec2/Vec4/Vec8/Vec16 values (the VECTOR ROW: 16/32/64-byte
# images, alignment = the vector width); the emission works on the memory
# images through the ARCHITECTURAL vector registers — v0/v1 (q0/q1) on
# aarch64, xmm0/xmm1 (ymm0/ymm1 for the 256-bit AVX forms) on x86-64 —
# which the intrinsic bodies use TRANSIENTLY (load → op → store; no
# register allocation — the vector values themselves live in the memory
# image, so the ABI crossing stays the by-reference convention).
#
# THE SUPPORTED SUBSET per arm (FAIL-CLOSED: an op/lane combo an arm does
# not lower panics with the explicit gap — never a silent scalar fallback):
#   AArch64 NEON (128-bit vregs):
#     f32x4/f64x2/i32x4/i16x8/i8x16  add/sub/mul, and/or/xor, load/store,
#                                     shuffle (TBL with a runtime byte mask)
#     i64x2                          add/sub only (NEON has no 64-bit lane
#                                     multiply), and/or/xor, load/store,
#                                     shuffle
#     256-bit (f32x8/i32x8/f64x4/i64x4/i16x16/i8x32): two 128-bit halves
#     512-bit (f32x16/i32x16/f64x8/i64x8/i16x32/i8x64): four 128-bit
#       halves (add/sub/mul/and/or/xor/load/store/shuffle)
#   x86-64 SSE (128-bit):
#     f32x4 add/sub/mul/and/or/xor (addps/subps/mulps/andps/orps/xorps),
#     i32x4 add/sub (paddd/psubd) + mul (pmulld — SSE4.1),
#     i64x2 add/sub (paddq/psubq), i16x8 add/sub/mul (paddw/psubw/pmullw),
#     i8x16 add/sub (paddb/psubb), load/store (movdqu), shuffle (pshufb —
#       SSSE3); the i8x16 mul and the i64x2 mul have NO SSE instruction —
#       NOT in the subset (fail closed)
#   x86-64 AVX (256-bit):
#     f32x8/f64x4 add/sub/mul/and/or/xor (vaddps/vsubps/vmulps/vandps/
#       vorps/vxorps), i32x8 add/sub (vpaddd/vpsubd) + mul (vpmulld —
#       AVX2), i16x16/i8x32 add/sub (vpaddw/vpsubb — AVX2), i64x4 add/sub
#       (vpaddq/vpsubq — AVX2), load/store (vmovdqu), shuffle (vpshufb —
#       AVX2); the i8x32 mul has no AVX2 instruction — NOT in the subset
#   512-bit on x86-64: NOT in the subset (no EVEX emission)

# The vector register index gate: the transient registers are v0/v1 on
# aarch64, xmm0/xmm1 (ymm0/ymm1) on x86-64 — fixed, never allocated.
def codegen_simd_intrinsic(inout ctx: CodegenCtx, fctx: FnCodegenCtx, name: String, kind: SimdIntrinsicKind, lane: SimdLane, args: Vec[MirOperand], dest: Place, dest_ty: Type) -> Bool
  match kind
  when SimdIntrinsicKind::SimdAdd | SimdIntrinsicKind::SimdSub |
       SimdIntrinsicKind::SimdMul | SimdIntrinsicKind::SimdAnd |
       SimdIntrinsicKind::SimdOr | SimdIntrinsicKind::SimdXor then
    codegen_simd_binop(ctx, fctx, kind, lane, args, dest)
    true
  when SimdIntrinsicKind::SimdLoad then
    codegen_simd_load(ctx, fctx, lane, args, dest)
    true
  when SimdIntrinsicKind::SimdStore then
    codegen_simd_store(ctx, fctx, lane, args, dest)
    false
  when SimdIntrinsicKind::SimdShuffle then
    codegen_simd_shuffle(ctx, fctx, lane, args, dest)
    true
  end  end
end

# The address of a vector operand's memory image (the MIR materializes
# vector values as stack temps — place operands only; a constant operand
# is a lowering bug and fails closed).
def simd_operand_address(inout ctx: CodegenCtx, fctx: FnCodegenCtx, op: MirOperand, reg: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(p) | MirOperandKind::MirMovePlace(p) |
       MirOperandKind::MirRead(p) | MirOperandKind::MirConsume(p) then
    emit_place_address(ctx, fctx, p, reg)
  when MirConstant(_) then
    panic("internal error: SIMD operand is a constant — the MIR must materialize vector operands as stack temps")
  end  end
end

# The aarch64 NEON three-register-same emitter (Q=1 — the 128-bit form).
# The register fields (EMPIRICAL — verified byte-for-byte against the
# assembler for every op below): the SECOND source operand at bits 20:16,
# the FIRST source operand at bits 9:5, the destination at bits 4:0.
# `vn` is the first source, `vm` the second source, `vd` the destination
# (the instruction computes vd = vn op vm).
def emit_neon_3same(inout ctx: CodegenCtx, base: UInt, vn: Int, vd: Int, vm: Int) -> Unit
  var word = base
  word = word | ((vm as UInt) << 16)
  word = word | (((vn as UInt) & 0x1F) << 5)
  word = word | ((vd as UInt) & 0x1F)
  emit32_le(&mut ctx.text, word)
end

# ldr q{vreg}, [addr] — the 128-bit vector load.
def emit_neon_ldr_q(inout ctx: CodegenCtx, vreg: Int, addr: PhysReg) -> Unit
  match addr
  when PhysReg::A64Reg(r) then
    emit32_le(&mut ctx.text, 0x3DC00000 | ((vreg as UInt) & 0x1F) | (a64_code(r) << 5))
  when _ then panic("emit_neon_ldr_q: aarch64 register required")
  end  end
end

# str q{vreg}, [addr] — the 128-bit vector store.
def emit_neon_str_q(inout ctx: CodegenCtx, vreg: Int, addr: PhysReg) -> Unit
  match addr
  when PhysReg::A64Reg(r) then
    emit32_le(&mut ctx.text, 0x3D800000 | ((vreg as UInt) & 0x1F) | (a64_code(r) << 5))
  when _ then panic("emit_neon_str_q: aarch64 register required")
  end  end
end

# tbl v{vd}.16b, {v{vn}.16b}, v{vm}.16b — the byte-lane shuffle (the
# table vector vn at bits 9:5, the index vector vm at bits 20:16).
def emit_neon_tbl(inout ctx: CodegenCtx, vd: Int, vn: Int, vm: Int) -> Unit
  emit32_le(&mut ctx.text, 0x4E000000 | (((vm as UInt) & 0x1F) << 16) | (((vn as UInt) & 0x1F) << 5) | ((vd as UInt) & 0x1F))
end

# The NEON 3-same base word for an op/lane pair (all register fields
# ZERO — the emitter adds vn/vd/vm). The size field (bits 23:22) is
# added by the caller via simd_neon_size_field (integer ops: log2(lane
# size); FP ops: 0 for 4s, 1 for 2d).
def simd_neon_base(kind: SimdIntrinsicKind, lane: SimdLane) -> UInt
  let is_int = !simd_lane_is_float(lane)
  match kind
  when SimdIntrinsicKind::SimdAdd then if is_int then 0x4E208400 else 0x4E20D400 end
  when SimdIntrinsicKind::SimdSub then if is_int then 0x6E208400 else 0x4EA0D400 end
  when SimdIntrinsicKind::SimdMul then if is_int then 0x4E209C00 else 0x6E20DC00 end
  when SimdIntrinsicKind::SimdAnd then 0x4E201C00
  when SimdIntrinsicKind::SimdOr then 0x4EA01C00
  when SimdIntrinsicKind::SimdXor then 0x6E201C00
  end
end

# The NEON size field for the op/lane pair: the integer ops encode
# log2(lane size) at bits 23:22 (8-bit → 00, 16-bit → 01, 32-bit → 10,
# 64-bit → 11); the FP ops encode the FP size (0 for 4s, 1 for 2d) at bit
# 22; the logical ops (and/or/xor) always use 00 (the full 128-bit form).
def simd_neon_size_field(kind: SimdIntrinsicKind, lane: SimdLane) -> UInt
  match kind
  when SimdIntrinsicKind::SimdAnd | SimdIntrinsicKind::SimdOr | SimdIntrinsicKind::SimdXor then
    0
  when _ then
    if simd_lane_is_float(lane) then
      if simd_lane_elem_size(lane) == 8 then 1 else 0 end
    else
      let sz = simd_lane_elem_size(lane)
      if sz == 1 then 0
      elsif sz == 2 then 1
      elsif sz == 4 then 2
      else 3
      end
    end
  end  end
end

# The NEON op for one 128-bit half: load [a + off] -> v0, load [b + off]
# -> v1, op v0,v1 -> v0, store [dest + off] <- v0.
def codegen_neon_128_binop(inout ctx: CodegenCtx, kind: SimdIntrinsicKind, lane: SimdLane, a_addr: PhysReg, b_addr: PhysReg, d_addr: PhysReg, offset: Int) -> Unit
  if offset != 0 then
    emit_add_ri(ctx, a_addr, offset)
    emit_add_ri(ctx, b_addr, offset)
    emit_add_ri(ctx, d_addr, offset)
  end
  emit_neon_ldr_q(ctx, 0, a_addr)
  emit_neon_ldr_q(ctx, 1, b_addr)
  let base = simd_neon_base(kind, lane)
  let size = simd_neon_size_field(kind, lane)
  let word = base | (size << 22)
  emit_neon_3same(ctx, word, 1, 0, 0)
  emit_neon_str_q(ctx, 0, d_addr)
  if offset != 0 then
    emit_add_ri(ctx, a_addr, -offset)
    emit_add_ri(ctx, b_addr, -offset)
    emit_add_ri(ctx, d_addr, -offset)
  end
end

# The x86-64 SIMD op bytes (opcode stream; the modrm byte follows).
def simd_x64_op_bytes(kind: SimdIntrinsicKind, lane: SimdLane, is_256: Bool) -> Vec[u8]
  var out = Vec::new()
  match kind
  when SimdIntrinsicKind::SimdAdd then
    if simd_lane_is_float(lane) then
      if is_256 then
        out.push(0xC5); out.push(0xFC)
      else
        out.push(0x0F)
      end
      out.push(0x58)
    else
      if is_256 then out.push(0xC5); out.push(0xFD) else out.push(0x66) end
      match simd_lane_elem_size(lane)
      when 1 then out.push(0x0F); out.push(0xFC)
      when 2 then out.push(0x0F); out.push(0xFD)
      when 4 then out.push(0x0F); out.push(0xFE)
      when 8 then out.push(0x0F); out.push(0xD4)
      end
    end
  when SimdIntrinsicKind::SimdSub then
    if simd_lane_is_float(lane) then
      if is_256 then
        out.push(0xC5); out.push(0xFC)
      else
        out.push(0x0F)
      end
      out.push(0x5C)
    else
      if is_256 then out.push(0xC5); out.push(0xFD) else out.push(0x66) end
      match simd_lane_elem_size(lane)
      when 1 then out.push(0x0F); out.push(0xF8)
      when 2 then out.push(0x0F); out.push(0xF9)
      when 4 then out.push(0x0F); out.push(0xFA)
      when 8 then out.push(0x0F); out.push(0xFB)
      end
    end
  when SimdIntrinsicKind::SimdMul then
    if simd_lane_is_float(lane) then
      if is_256 then
        out.push(0xC5); out.push(0xFC)
      else
        out.push(0x0F)
      end
      out.push(0x59)
    else
      match simd_lane_elem_size(lane)
      when 2 then
        if is_256 then out.push(0xC5); out.push(0xFD) else out.push(0x66) end
        out.push(0x0F); out.push(0xD5)
      when 4 then
        if is_256 then out.push(0xC4); out.push(0xE2); out.push(0x7D) else out.push(0x66); out.push(0x0F); out.push(0x38) end
        out.push(0x40)
      when _ then
        panic("internal error: SIMD i" + (simd_lane_elem_size(lane) * 8).to_string() + " lane multiply has no x86-64 instruction (not in the supported subset)")
      end
    end
  when SimdIntrinsicKind::SimdAnd then
    if is_256 then
      out.push(0xC5); out.push(0xFC)
    else
      out.push(0x0F)
    end
    out.push(0x54)
  when SimdIntrinsicKind::SimdOr then
    if is_256 then
      out.push(0xC5); out.push(0xFC)
    else
      out.push(0x0F)
    end
    out.push(0x56)
  when SimdIntrinsicKind::SimdXor then
    if is_256 then
      out.push(0xC5); out.push(0xFC)
    else
      out.push(0x0F)
    end
    out.push(0x57)
  end
  out
end

# The x86-64 modrm for [rbp + disp32] with the given reg field (the SIMD
# ops use the RBP-relative frame addressing; mod=10, rm=101).
def simd_x64_modrm_mem(reg: u8) -> u8
  ((0x02 << 6) | ((reg & 0x07) << 3) | 0x05) as u8
end

# The x86-64 register-register modrm (mod=11).
def simd_x64_modrm_reg(dst_reg: u8, src_reg: u8) -> u8
  ((0x03 << 6) | ((src_reg & 0x07) << 3) | (dst_reg & 0x07)) as u8
end

# movdqu/vmovdqu xmm/ymm {0,1} <-> [rbp + disp32].
def emit_x64_simd_load(inout ctx: CodegenCtx, vreg: Int, disp: i32, is_256: Bool) -> Unit
  if is_256 then
    emit8(&mut ctx.text, 0xC5)
    emit8(&mut ctx.text, 0xFE)
    emit8(&mut ctx.text, 0x6F)
  else
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6F)
  end
  emit8(&mut ctx.text, simd_x64_modrm_mem(vreg as u8))
  emit32_le(&mut ctx.text, disp as u32)
end

def emit_x64_simd_store(inout ctx: CodegenCtx, vreg: Int, disp: i32, is_256: Bool) -> Unit
  if is_256 then
    emit8(&mut ctx.text, 0xC5)
    emit8(&mut ctx.text, 0xFE)
    emit8(&mut ctx.text, 0x7F)
  else
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x7F)
  end
  emit8(&mut ctx.text, simd_x64_modrm_mem(vreg as u8))
  emit32_le(&mut ctx.text, disp as u32)
end

# movdqu xmm{vreg}, [base] / movdqu [base], xmm{vreg} — the register-
# indirect unaligned 128-bit move (REX.B for the high registers).
def emit_x64_movdqu_reg_indirect(inout ctx: CodegenCtx, vreg: Int, base: X64, is_load: Bool) -> Unit
  if x64_code(base) >= 8 then
    emit8(&mut ctx.text, 0x41)  ## REX.B
  end
  emit8(&mut ctx.text, 0xF3)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, if is_load then 0x6F else 0x7F end)
  emit8(&mut ctx.text, (0x00 << 6) | ((vreg & 0x07) << 3) | (x64_code(base) & 0x07))
end

# vmovdqu ymm{vreg}, [base] / vmovdqu [base], ymm{vreg} — the AVX
# register-indirect 256-bit move (3-byte VEX with B=0 for the high
# registers, 2-byte VEX otherwise).
def emit_x64_vmovdqu_reg_indirect(inout ctx: CodegenCtx, vreg: Int, base: X64, is_load: Bool) -> Unit
  if x64_code(base) >= 8 then
    emit8(&mut ctx.text, 0xC4)
    emit8(&mut ctx.text, 0xC1)
    emit8(&mut ctx.text, 0x7E)
  else
    emit8(&mut ctx.text, 0xC5)
    emit8(&mut ctx.text, 0xFE)
  end
  emit8(&mut ctx.text, if is_load then 0x6F else 0x7F end)
  emit8(&mut ctx.text, (0x00 << 6) | ((vreg & 0x07) << 3) | (x64_code(base) & 0x07))
end

# The x86-64 128-bit op: load [a_disp] -> xmm0, op xmm0, [b_disp] (the
# memory-operand form), store [d_disp] <- xmm0.
def codegen_x64_128_binop(inout ctx: CodegenCtx, kind: SimdIntrinsicKind, lane: SimdLane, a_disp: i32, b_disp: i32, d_disp: i32) -> Unit
  emit_x64_simd_load(ctx, 0, a_disp, false)
  let bytes = simd_x64_op_bytes(kind, lane, false)
  var bi = 0
  while bi < bytes.len() do
    emit8(&mut ctx.text, bytes[bi])
    bi = bi + 1
  end
  emit8(&mut ctx.text, simd_x64_modrm_mem(0))
  emit32_le(&mut ctx.text, b_disp as u32)
  emit_x64_simd_store(ctx, 0, d_disp, false)
end

# The x86-64 256-bit (AVX) op: vmovdqu [a_disp] -> ymm0, op ymm0, [b_disp],
# vmovdqu [d_disp] <- ymm0.
def codegen_x64_256_binop(inout ctx: CodegenCtx, kind: SimdIntrinsicKind, lane: SimdLane, a_disp: i32, b_disp: i32, d_disp: i32) -> Unit
  emit_x64_simd_load(ctx, 0, a_disp, true)
  let bytes = simd_x64_op_bytes(kind, lane, true)
  var bi = 0
  while bi < bytes.len() do
    emit8(&mut ctx.text, bytes[bi])
    bi = bi + 1
  end
  emit8(&mut ctx.text, simd_x64_modrm_mem(0))
  emit32_le(&mut ctx.text, b_disp as u32)
  emit_x64_simd_store(ctx, 0, d_disp, true)
end

# The stack displacement of a local's slot (the frame's FP-relative
# offset; Option::None when the local has no stack home — a SIMD vector
# must be memory-resident for the by-reference emission).
def simd_local_disp(fctx: FnCodegenCtx, local_id: Int) -> i32
  match fctx.var_locs.get(local_id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Stack(off) then off
    when VarLoc::Spilled(off) then off
    when _ then panic("internal error: SIMD operand local has no stack home (the vector emission is memory-based)")
    end
  when Option::None then panic("internal error: SIMD operand local " + local_id.to_string() + " has no location")
  end  end
end

# The binary-op arm: a = args[0], b = args[1], result into dest. The
# emission is memory-based on both arms: the vector images live in the
# stack slots; the op runs in the transient architectural vector
# registers. The 256/512-bit forms run the 128-bit op per half (NEON) or
# the AVX 256-bit instruction (x86).
def codegen_simd_binop(inout ctx: CodegenCtx, fctx: FnCodegenCtx, kind: SimdIntrinsicKind, lane: SimdLane, args: Vec[MirOperand], dest: Place) -> Unit
  if args.len() < 2 then
    panic("internal error: SIMD binary intrinsic requires two operands")
  end
  let width = simd_lane_width(lane)
  let width_b = width / 8
  if width_b > 64 then
    panic("internal error: SIMD vector width " + width_b.to_string() + " bytes is not in the supported subset")
  end
  match ctx.target.arch
  when Arch::AArch64 then
    let scratch = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    let d_scratch = ret_reg(ctx.target.arch)
    simd_operand_address(ctx, fctx, &args[0], scratch)
    simd_operand_address(ctx, fctx, &args[1], scratch2)
    emit_place_address(ctx, fctx, dest, d_scratch)
    let halves = width_b / 16
    var h = 0
    while h < halves do
      codegen_neon_128_binop(ctx, kind, lane, scratch, scratch2, d_scratch, h * 16)
      h = h + 1
    end
  when Arch::X86_64 then
    let a_disp = simd_local_disp(fctx, _simd_operand_local_id(&args[0]))
    let b_disp = simd_local_disp(fctx, _simd_operand_local_id(&args[1]))
    let d_disp = simd_local_disp(fctx, dest.local.id)
    if width_b == 16 then
      codegen_x64_128_binop(ctx, kind, lane, a_disp, b_disp, d_disp)
    elsif width_b == 32 then
      codegen_x64_256_binop(ctx, kind, lane, a_disp, b_disp, d_disp)
    else
      panic("internal error: SIMD " + width_b.to_string() + "-byte arithmetic has no x86-64 lowering (not in the supported subset)")
    end
  end
end

# The local id of a place-carrying operand (the x86 arm's frame-displacement
# addressing requires the local directly).
def _simd_operand_local_id(op: MirOperand) -> Int
  match op.kind
  when MirOperandKind::MirCopy(p) | MirOperandKind::MirMovePlace(p) |
       MirOperandKind::MirRead(p) | MirOperandKind::MirConsume(p) then
    p.local.id
  when MirConstant(_) then
    panic("internal error: SIMD operand is a constant — the MIR must materialize vector operands as stack temps")
  end  end
end

# The load arm: __intrinsic_simd_load_<lane>(ptr) — the pointer operand's
# VALUE is the address of the 16/32/64-byte image; the image is copied
# into the destination vector. The aarch64 arm loads each 128-bit half
# through the scratch register; the x86 arm uses the memory-operand form
# of the unaligned load.
def codegen_simd_load(inout ctx: CodegenCtx, fctx: FnCodegenCtx, lane: SimdLane, args: Vec[MirOperand], dest: Place) -> Unit
  if args.len() < 1 then
    panic("internal error: SIMD load intrinsic requires a pointer operand")
  end
  let width_b = simd_lane_width(lane) / 8
  match ctx.target.arch
  when Arch::AArch64 then
    let ptr_reg = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    load_operand_rvalue_item(ctx, fctx, &args[0], ptr_reg)
    emit_place_address(ctx, fctx, dest, scratch2)
    let halves = width_b / 16
    var h = 0
    while h < halves do
      if h != 0 then
        emit_add_ri(ctx, ptr_reg, h * 16)
        emit_add_ri(ctx, scratch2, h * 16)
      end
      emit_neon_ldr_q(ctx, 0, ptr_reg)
      emit_neon_str_q(ctx, 0, scratch2)
      if h != 0 then
        emit_add_ri(ctx, ptr_reg, -(h * 16))
        emit_add_ri(ctx, scratch2, -(h * 16))
      end
      h = h + 1
    end
  when Arch::X86_64 then
    let ptr_reg = scratch_reg(ctx.target.arch)
    load_operand_rvalue_item(ctx, fctx, &args[0], ptr_reg)
    let d_disp = simd_local_disp(fctx, dest.local.id)
    match ptr_reg
    when PhysReg::X64Reg(pr) then
      if width_b == 16 then
        emit_x64_movdqu_reg_indirect(ctx, 0, pr, true)
        emit_x64_simd_store(ctx, 0, d_disp, false)
      elsif width_b == 32 then
        emit_x64_vmovdqu_reg_indirect(ctx, 0, pr, true)
        emit_x64_simd_store(ctx, 0, d_disp, true)
      else
        panic("internal error: SIMD " + width_b.to_string() + "-byte load/store has no x86-64 lowering (not in the supported subset)")
      end
    when _ then panic("emit_x64_simd: x86-64 register required")
    end
  end
end

# The store arm: __intrinsic_simd_store_<lane>(v, ptr) — the vector
# image is copied to the pointer's address. Returns no value (Unit).
def codegen_simd_store(inout ctx: CodegenCtx, fctx: FnCodegenCtx, lane: SimdLane, args: Vec[MirOperand], dest: Place) -> Unit
  if args.len() < 2 then
    panic("internal error: SIMD store intrinsic requires (vector, pointer) operands")
  end
  let width_b = simd_lane_width(lane) / 8
  match ctx.target.arch
  when Arch::AArch64 then
    let v_addr = scratch_reg(ctx.target.arch)
    let ptr_reg = scratch2_reg(ctx.target.arch)
    simd_operand_address(ctx, fctx, &args[0], v_addr)
    load_operand_rvalue_item(ctx, fctx, &args[1], ptr_reg)
    let halves = width_b / 16
    var h = 0
    while h < halves do
      if h != 0 then
        emit_add_ri(ctx, v_addr, h * 16)
        emit_add_ri(ctx, ptr_reg, h * 16)
      end
      emit_neon_ldr_q(ctx, 0, v_addr)
      emit_neon_str_q(ctx, 0, ptr_reg)
      if h != 0 then
        emit_add_ri(ctx, v_addr, -(h * 16))
        emit_add_ri(ctx, ptr_reg, -(h * 16))
      end
      h = h + 1
    end
  when Arch::X86_64 then
    let v_disp = simd_local_disp(fctx, _simd_operand_local_id(&args[0]))
    let ptr_reg = scratch_reg(ctx.target.arch)
    load_operand_rvalue_item(ctx, fctx, &args[1], ptr_reg)
    match ptr_reg
    when PhysReg::X64Reg(pr) then
      if width_b == 16 then
        emit_x64_simd_load(ctx, 0, v_disp, false)
        emit_x64_movdqu_reg_indirect(ctx, 0, pr, false)
      elsif width_b == 32 then
        emit_x64_simd_load(ctx, 0, v_disp, true)
        emit_x64_vmovdqu_reg_indirect(ctx, 0, pr, false)
      else
        panic("internal error: SIMD " + width_b.to_string() + "-byte load/store has no x86-64 lowering (not in the supported subset)")
      end
    when _ then panic("emit_x64_simd: x86-64 register required")
    end
  end
end

# The shuffle arm: __intrinsic_simd_shuffle_<lane>(a, mask) — the mask is
# the 16/32/64-byte BYTE mask image (mask byte j selects the source byte
# j — the std helpers build the byte mask from the lane indexes); the
# result is a lane rearrangement of a's bytes. NEON: TBL per 128-bit half
# (the mask half selects within the half); x86-64: pshufb per 128-bit
# half (SSE) / vpshufb (AVX2, 256-bit).
def codegen_simd_shuffle(inout ctx: CodegenCtx, fctx: FnCodegenCtx, lane: SimdLane, args: Vec[MirOperand], dest: Place) -> Unit
  if args.len() < 2 then
    panic("internal error: SIMD shuffle intrinsic requires (vector, mask) operands")
  end
  let width_b = simd_lane_width(lane) / 8
  match ctx.target.arch
  when Arch::AArch64 then
    let a_addr = scratch_reg(ctx.target.arch)
    let m_addr = scratch2_reg(ctx.target.arch)
    let d_addr = ret_reg(ctx.target.arch)
    simd_operand_address(ctx, fctx, &args[0], a_addr)
    simd_operand_address(ctx, fctx, &args[1], m_addr)
    emit_place_address(ctx, fctx, dest, d_addr)
    let halves = width_b / 16
    var h = 0
    while h < halves do
      if h != 0 then
        emit_add_ri(ctx, a_addr, h * 16)
        emit_add_ri(ctx, m_addr, h * 16)
        emit_add_ri(ctx, d_addr, h * 16)
      end
      emit_neon_ldr_q(ctx, 0, a_addr)
      emit_neon_ldr_q(ctx, 1, m_addr)
      emit_neon_tbl(ctx, 0, 0, 1)
      emit_neon_str_q(ctx, 0, d_addr)
      if h != 0 then
        emit_add_ri(ctx, a_addr, -(h * 16))
        emit_add_ri(ctx, m_addr, -(h * 16))
        emit_add_ri(ctx, d_addr, -(h * 16))
      end
      h = h + 1
    end
  when Arch::X86_64 then
    let a_disp = simd_local_disp(fctx, _simd_operand_local_id(&args[0]))
    let m_disp = simd_local_disp(fctx, _simd_operand_local_id(&args[1]))
    let d_disp = simd_local_disp(fctx, dest.local.id)
    if width_b == 16 then
      # pshufb xmm0, xmm1: load a -> xmm0, mask -> xmm1, pshufb, store.
      emit_x64_simd_load(ctx, 0, a_disp, false)
      emit_x64_simd_load(ctx, 1, m_disp, false)
      emit8(&mut ctx.text, 0x66)
      emit8(&mut ctx.text, 0x0F)
      emit8(&mut ctx.text, 0x38)
      emit8(&mut ctx.text, 0x00)
      emit8(&mut ctx.text, simd_x64_modrm_reg(0, 1))
      emit_x64_simd_store(ctx, 0, d_disp, false)
    elsif width_b == 32 then
      # vpshufb ymm0, ymm0, ymm1 (AVX2).
      emit_x64_simd_load(ctx, 0, a_disp, true)
      emit_x64_simd_load(ctx, 1, m_disp, true)
      emit8(&mut ctx.text, 0xC4)
      emit8(&mut ctx.text, 0xE2)
      emit8(&mut ctx.text, 0x7D)
      emit8(&mut ctx.text, 0x00)
      emit8(&mut ctx.text, simd_x64_modrm_reg(0, 1))
      emit_x64_simd_store(ctx, 0, d_disp, true)
    else
      panic("internal error: SIMD " + width_b.to_string() + "-byte shuffle has no x86-64 lowering (not in the supported subset)")
    end
  end
end


# ———————————————————————————————————————————————————————————————
# The per-target syscall identity table (the ONE translation authority)
# ———————————————————————————————————————————————————————————————
# The std's syscall wrappers (std/io's sys_read/sys_write and std/fs's
# raw_*) pass the TG CANONICAL numbers — the Linux x86-64 values
# (read=0, write=1, open=2, close=3, ...). macOS receives the canonical
# numbers too (the macOS branches add the BSD offset: +3 for AArch64,
# +0x2000003 for x86-64, with the pre-adjusted SYS_*_MAC constants).
#
# Linux AArch64 uses the asm-generic syscall table whose numbers DIFFER
# (read=63, write=64, openat=56, close=57, ...) AND whose path-syscall
# surface is the *at family: a path syscall takes the dirfd FIRST. The
# canonical identities therefore map to the AArch64 numbers below, and
# the *at rewrites INSERT the AT_FDCWD (-100) dirfd — plus the extra
# argument the AArch64 call needs where the x86-64 call has none
# (fstatat's flags, unlinkat's AT_REMOVEDIR for rmdir). The identity
# set is the std's used set, enumerated from the std syscall calls
# (std/io.tg, std/fs.tg) plus mmap/munmap/exit for direct intrinsic
# callers. UNKNOWN numbers pass through raw — the caller supplies a
# target-native number directly.

# The canonical → AArch64 argument layout for the *at rewrites:
#   Direct            — args pass through as-is (the number-only mappings)
#   PrependFdcwd      — the syscall takes dirfd FIRST (openat, mkdirat,
#                       unlinkat, readlinkat, fchmodat)
#   PrependFdcwdFlags0— fstatat also takes the flags argument (= 0 for stat)
#   RmdirToUnlinkat   — AArch64 has no rmdir: unlinkat(path, AT_REMOVEDIR)
#   RenameToRenameat  — renameat takes TWO dirfds: (AT_FDCWD, from, AT_FDCWD, to)
#   SymlinkToSymlinkat— symlinkat takes (target, dirfd, linkpath)
enum A64SyscallArgLayout
  Direct
  PrependFdcwd
  PrependFdcwdFlags0
  RmdirToUnlinkat
  RenameToRenameat
  SymlinkToSymlinkat
end

# The canonical (x86-64) identities covered by the aarch64 translation —
# the std's used set (read, write, open, close, stat, fstat, lseek,
# getcwd, chdir, rename, mkdir, rmdir, unlink, symlink, readlink, chmod,
# getdents64, dup, dup2) plus mmap/munmap/exit for direct callers.
def linux_aarch64_syscall_canonicals() -> Vec[Int]
  var v = Vec::new()
  v.push(0)
  v.push(1)
  v.push(2)
  v.push(3)
  v.push(4)
  v.push(5)
  v.push(8)
  v.push(9)
  v.push(11)
  v.push(32)
  v.push(33)
  v.push(60)
  v.push(79)
  v.push(80)
  v.push(82)
  v.push(83)
  v.push(84)
  v.push(87)
  v.push(88)
  v.push(89)
  v.push(90)
  v.push(217)
  v
end

# The canonical number → Linux AArch64 syscall number.
def linux_aarch64_syscall_number(canonical: Int) -> Int
  match canonical
  when 0 then 63    # read
  when 1 then 64    # write
  when 2 then 56    # open → openat
  when 3 then 57    # close
  when 4 then 79    # stat → fstatat
  when 5 then 80    # fstat
  when 8 then 62    # lseek
  when 9 then 222   # mmap
  when 11 then 215  # munmap
  when 32 then 23   # dup
  when 33 then 24   # dup2
  when 60 then 93   # exit
  when 79 then 17   # getcwd
  when 80 then 49   # chdir
  when 82 then 38   # rename → renameat
  when 83 then 34   # mkdir → mkdirat
  when 84 then 35   # rmdir → unlinkat
  when 87 then 35   # unlink → unlinkat
  when 88 then 36   # symlink → symlinkat
  when 89 then 37   # readlink → readlinkat
  when 90 then 53   # chmod → fchmodat
  when 217 then 61  # getdents64
  when _ then canonical  # unknown: pass through raw
  end  end
end

# The canonical number → AArch64 argument layout (the *at rewrites).
def linux_aarch64_syscall_layout(canonical: Int) -> A64SyscallArgLayout
  match canonical
  when 2 then A64SyscallArgLayout::PrependFdcwd        # open → openat
  when 4 then A64SyscallArgLayout::PrependFdcwdFlags0  # stat → fstatat
  when 82 then A64SyscallArgLayout::RenameToRenameat
  when 83 then A64SyscallArgLayout::PrependFdcwd       # mkdir → mkdirat
  when 84 then A64SyscallArgLayout::RmdirToUnlinkat
  when 87 then A64SyscallArgLayout::PrependFdcwd       # unlink → unlinkat
  when 88 then A64SyscallArgLayout::SymlinkToSymlinkat
  when 89 then A64SyscallArgLayout::PrependFdcwd       # readlink → readlinkat
  when 90 then A64SyscallArgLayout::PrependFdcwd       # chmod → fchmodat
  when _ then A64SyscallArgLayout::Direct
  end  end
end

# Emit the Linux AArch64 syscall: x0 holds the canonical number, x1..x6
# the args. Each known identity compares x0 and branches to its block
# (x8 = the AArch64 number, then the identity's argument layout); the
# unknown numbers fall through to the raw passthrough (x8 = x0, args
# as-is). The *at layouts need NO arg shifting: the args already sit in
# x1.., so inserting the dirfd is only `mov x0, AT_FDCWD` — except the
# layouts that also repurpose an existing register (renameat's second
# dirfd, symlinkat's middle dirfd).
def codegen_syscall_a64_linux(inout ctx: CodegenCtx, nargs: Int) -> Unit
  let base = ".Lsyscall_a64l." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  # The dispatch chain: compare x0 against each canonical number.
  let canonicals = linux_aarch64_syscall_canonicals()
  let i = 0
  while i < canonicals.len() do
    let c = canonicals[i]
    a64_cmp_ri(&mut ctx.text, A64::X0, c as u32)
    a64_bcond(&mut ctx.text, a64_cc_eq(), base + "_id_" + c.to_string())
    i = i + 1
  end
  # Unknown numbers: pass through raw.
  a64_mov_rr(&mut ctx.text, A64::X8, A64::X0)
  a64_b(&mut ctx.text, base + "_direct")

  # The identity blocks: load the AArch64 number, branch to the layout.
  let j = 0
  while j < canonicals.len() do
    let c = canonicals[j]
    def_label(&mut ctx.text, base + "_id_" + c.to_string())
    a64_mov_ri(&mut ctx.text, A64::X8, linux_aarch64_syscall_number(c) as i64)
    match linux_aarch64_syscall_layout(c)
    when A64SyscallArgLayout::Direct then a64_b(&mut ctx.text, base + "_direct")
    when A64SyscallArgLayout::PrependFdcwd then a64_b(&mut ctx.text, base + "_prepend")
    when A64SyscallArgLayout::PrependFdcwdFlags0 then a64_b(&mut ctx.text, base + "_flags0")
    when A64SyscallArgLayout::RmdirToUnlinkat then a64_b(&mut ctx.text, base + "_rmdir")
    when A64SyscallArgLayout::RenameToRenameat then a64_b(&mut ctx.text, base + "_rename")
    when A64SyscallArgLayout::SymlinkToSymlinkat then a64_b(&mut ctx.text, base + "_symlink")
    end
    j = j + 1
  end

  # Direct: shift the args down into x0.. (a1→x0, a2→x1, ...).
  def_label(&mut ctx.text, base + "_direct")
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
  a64_mov_rr(&mut ctx.text, A64::X1, A64::X2)
  a64_mov_rr(&mut ctx.text, A64::X2, A64::X3)
  if nargs >= 4 then
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X4)
  end
  if nargs >= 5 then
    a64_mov_rr(&mut ctx.text, A64::X4, A64::X5)
  end
  if nargs >= 6 then
    a64_mov_rr(&mut ctx.text, A64::X5, A64::X6)
  end
  a64_b(&mut ctx.text, base + "_svc")

  # Prepend the AT_FDCWD dirfd (the *at rewrites): the args already sit
  # in x1.., so the dirfd lands exactly where the kernel reads it.
  def_label(&mut ctx.text, base + "_prepend")
  a64_mov_ri(&mut ctx.text, A64::X0, -100)  # AT_FDCWD
  a64_b(&mut ctx.text, base + "_svc")

  # fstatat(AT_FDCWD, path, buf, flags=0) — stat's flags argument.
  def_label(&mut ctx.text, base + "_flags0")
  a64_mov_ri(&mut ctx.text, A64::X0, -100)  # AT_FDCWD
  a64_mov_ri(&mut ctx.text, A64::X3, 0)
  a64_b(&mut ctx.text, base + "_svc")

  # unlinkat(AT_FDCWD, path, AT_REMOVEDIR) — the AArch64 rmdir.
  def_label(&mut ctx.text, base + "_rmdir")
  a64_mov_ri(&mut ctx.text, A64::X0, -100)  # AT_FDCWD
  a64_mov_ri(&mut ctx.text, A64::X2, 0x200) # AT_REMOVEDIR
  a64_b(&mut ctx.text, base + "_svc")

  # renameat(AT_FDCWD, from, AT_FDCWD, to) — two dirfds.
  def_label(&mut ctx.text, base + "_rename")
  a64_mov_ri(&mut ctx.text, A64::X0, -100)  # AT_FDCWD
  a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
  a64_mov_ri(&mut ctx.text, A64::X2, -100)  # AT_FDCWD
  a64_b(&mut ctx.text, base + "_svc")

  # symlinkat(target, AT_FDCWD, linkpath) — the dirfd sits in the middle.
  def_label(&mut ctx.text, base + "_symlink")
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
  a64_mov_ri(&mut ctx.text, A64::X1, -100)  # AT_FDCWD
  a64_b(&mut ctx.text, base + "_svc")

  def_label(&mut ctx.text, base + "_svc")
  a64_svc(&mut ctx.text, 0)
end

# Args already in ABI registers: arg0=num, arg1=a1, arg2=a2, arg3=a3
def codegen_syscall(inout ctx: CodegenCtx, nargs: Int) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS AArch64: x16=syscall_num, x0=a1, x1=a2, x2=a3, SVC #0x80
      # TG canonical numbers → macOS: add 3 (read:0→3, write:1→4, open:2→5, close:3→6)
      a64_add_rri(&mut ctx.text, A64::X16, A64::X0, 3)
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
      if nargs >= 2 then
        a64_mov_rr(&mut ctx.text, A64::X1, A64::X2)
      end
      if nargs >= 3 then
        a64_mov_rr(&mut ctx.text, A64::X2, A64::X3)
      end
      a64_svc(&mut ctx.text, 0x80)
      # Darwin reports syscall errors with carry set and errno in x0.
      # Normalize that to the Linux-style negative errno convention used
      # by the std/fs raw wrappers and direct syscall callers.
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      # Linux AArch64: x8=syscall_num, x0=a1, x1=a2, x2=a3, ..., SVC #0.
      # The std passes the TG canonical (x86-64) numbers: the per-target
      # identity table (linux_aarch64_syscall_number / _layout) translates
      # them here — the *at rewrites insert the AT_FDCWD dirfd (and the
      # flags argument where the AArch64 call needs one) — and unknown
      # numbers pass through raw.
      codegen_syscall_a64_linux(ctx, nargs)
    when _ then
      a64_brk(&mut ctx.text, 1)
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS x86_64: rax=0x2000000+bsd_num, rdi=a1, rsi=a2, rdx=a3
      # TG canonical → macOS BSD: add 3, then add 0x2000000
      let ok_label = ".Lsyscall_ok." + ctx.fn_counter.to_string()
      ctx.fn_counter = ctx.fn_counter + 1
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
      x64_add_ri(&mut ctx.text, X64::RAX, 0x2000003)
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
      if nargs >= 2 then
        x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
      end
      if nargs >= 3 then
        x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
      end
      x64_syscall(&mut ctx.text)
      # Darwin reports syscall errors with carry set and errno in rax.
      # Normalize that to the Linux-style negative errno convention used
      # by the std/fs raw wrappers and direct syscall callers.
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label)
    when OsAbi::Linux then
      # Linux x86_64: rax=num, rdi=a1, rsi=a2, rdx=a3
      # TG canonical numbers match Linux x86_64 directly
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
      if nargs >= 2 then
        x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
      end
      if nargs >= 3 then
        x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
      end
      x64_syscall(&mut ctx.text)
    when _ then
      x64_ud2(&mut ctx.text)
    end
  end  end
end

# Emit inline strlen for a raw null-terminated string pointer in x0/rdi.
def codegen_strlen(inout ctx: CodegenCtx) -> Unit
  normalize_string_arg0_for_current_arch(ctx)
  let lbl_loop = ".Lstrlen_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrlen_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr. Use x9 as counter, x10 as byte scratch
    a64_mov_ri(&mut ctx.text, A64::X9, 0)
    def_label(&mut ctx.text, lbl_loop.clone())
    # ldrb w10, [x0, x9]
    # (use add + ldrb since we don't have indexed ldrb)
     a64_add_rrr(&mut ctx.text, A64::X10, A64::X0, A64::X9)
     a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
     a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
  when Arch::X86_64 then
    # rdi = ptr. Use rcx as counter
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx eax, byte [rdi + rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x04)  # modrm SIB
    emit8(&mut ctx.text, 0x0F)  # SIB: rcx + rdi
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# char_at intrinsic: load byte at string[index]
# AArch64: x0 = &self (ref to string ptr), x1 = index
# x86_64:  rdi = &self, rsi = index
# Returns the byte value (zero-extended to Int) in return register.
def codegen_char_at(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Dereference &self to get the string pointer
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X9),
      PhysReg::A64Reg(A64::X10),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12)
    )
    # Compute ptr + index
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
     # Load byte at that address
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_mov_rr(&mut ctx.text, A64::X0, A64::X2)
  when Arch::X86_64 then
    # Dereference &self to get the string pointer
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # movzx eax, byte [rdi + rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x04)  # modrm SIB
    emit8(&mut ctx.text, 0x37)  # SIB: rsi + rdi
  end  end
end

# String.bytes() intrinsic on a raw C-string pointer.
# Returns: x0 = Vec pointer
def codegen_string_bytes(inout ctx: CodegenCtx) -> Unit
  normalize_string_arg0_for_current_arch(ctx)
  emit_call_label(ctx, "_tg_string_bytes")
end

def codegen_string_from_bytes(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_string_from_bytes")
end

# ———————————————————————————————————————————————————————————————
# Function prologue and epilogue
# ———————————————————————————————————————————————————————————————

def stack_probe_step_bytes() -> Int = 4096

def emit_stack_probe(inout ctx: CodegenCtx, sp: PhysReg, frame_size: Int) -> Unit
  if frame_size <= stack_probe_step_bytes() then
    return
  end

  let scratch = scratch2_reg(ctx.target.arch)
  emit_zero_reg(ctx, scratch)

  var offset = 0
  while offset < frame_size do
    emit_store_mem(ctx, sp, offset as i32, scratch)
    offset = offset + stack_probe_step_bytes()
  end
end

# Bind one parameter from its ABI argument register into its assigned home
# (register, stack slot, or spill slot). Used by the prologue for Scalar
# params and ScalarPair/ByAddress by-reference aggregates (the caller
# delivered the aggregate's ADDRESS in the ABI register; the param
# home stores that address and the value is reached through projections).
def prologue_bind_param_from_abi_reg(inout ctx: CodegenCtx, fctx: FnCodegenCtx, fp: PhysReg, param: MirLocal, abi_r: PhysReg) -> Unit
  match fctx.var_locs.get(param.id.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(target_r) then
      if phys_reg_id(abi_r) != phys_reg_id(target_r) then
        emit_mov_rr(ctx, target_r, abi_r)
      end
    when VarLoc::Stack(off) then
      emit_store_mem(ctx, fp, off, abi_r)
    when VarLoc::Spilled(off) then
      emit_store_mem(ctx, fp, off, abi_r)
    end
  when _ then ()
  end  end
end

def codegen_prologue(inout ctx: CodegenCtx, fctx: FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)

  match arch
  when Arch::X86_64 then
    # push rbp; mov rbp, rsp
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp)

    # Allocate stack frame (stack_size = spill_bytes + save_bytes)
    if fctx.frame.stack_size > 0 then
      emit_sub_ri(ctx, sp, fctx.frame.stack_size as i32)
      emit_stack_probe(ctx, sp, fctx.frame.stack_size)
    end

    # Save callee-saved registers at the BOTTOM of the frame, exactly like
    # the AArch64 prologue: saved[i] at [fp - stack_size + i*8]. The former
    # pushes landed at [rbp-8], [rbp-16],... — the SAME addresses the spill
    # slots use (allocate_locals starts spill offsets at -8) — so any
    # function that spilled a local and saved a register corrupted both the
    # caller's register and the spill. The sub above also double-counted the
    # save bytes (stack_size already includes them).
    let saved = fctx.frame.saved_regs
    var si = 0
    while si < saved.len() do
      # off = -(stack_size) + (si * 8) — bottom of frame, no spill overlap
      let abs_off = fctx.frame.stack_size - (si * 8)
      match saved[si]
      when PhysReg::X64Reg(r) then
        emit_store_mem(ctx, fp, -(abs_off as i32), PhysReg::X64Reg(r))
      when _ then ()
      end
      si = si + 1
    end

  when Arch::AArch64 then
    # stp fp, lr, [sp, #-16]!  (pre-index: push fp and lr)
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    # mov fp, sp
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    # Allocate full stack frame (callee-saved saves + spill area)
    if fctx.frame.stack_size > 0 then
      let aligned = align_up_int(fctx.frame.stack_size, 16)
      if aligned <= 4095 then
        a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, aligned as u32)
      else
        # Large frame: load size into scratch register then subtract
        a64_mov_ri(&mut ctx.text, A64::X15, aligned as i64)
        a64_sub_sp_sp_r(&mut ctx.text, A64::X15)
      end
      emit_stack_probe(ctx, sp, aligned)
    end

    # Save callee-saved registers at the BOTTOM of the frame (FP-relative)
    # Callee-saved go at [FP-stack_size], [FP-stack_size+8], etc.
    # Spill slots are at [FP-8], [FP-16], etc. (near top), so no collision.
    let saved = fctx.frame.saved_regs
    var si = 0
    let ss = fctx.frame.stack_size
    while si < saved.len() do
      # off = -(stack_size) + (si * 8), always negative
      let abs_off = ss - (si * 8)
      match saved[si]
      when PhysReg::A64Reg(a) then
        if abs_off <= 256 then
          a64_stur(&mut ctx.text, a, A64::FP, -(abs_off as i32))
        elsif abs_off <= 4095 then
          a64_sub_rri(&mut ctx.text, A64::X15, A64::FP, abs_off as u32)
          a64_stur(&mut ctx.text, a, A64::X15, 0)
        else
          a64_mov_ri(&mut ctx.text, A64::X15, abs_off as i64)
          a64_sub_rrr(&mut ctx.text, A64::X15, A64::FP, A64::X15)
          a64_stur(&mut ctx.text, a, A64::X15, 0)
        end
      when _ then ()
      end
      si = si + 1
    end
  end

  # The per-invocation ALLOCATION counter: zero the function's budget slot
  # at entry, so every invocation of a budgeted function counts its own
  # consumed units from zero (the counter never leaks across calls,
  # nested/recursive invocations, or concurrent per-thread stacks). The
  # TIME slot needs no prologue action — the __tg_budget_time_start
  # MirEffectRecord (the entry block's first statement) stamps it.
  if fctx.frame.budget_alloc_offset != 0 then
    let zr = scratch_reg(arch)
    emit_zero_reg(ctx, zr)
    emit_store_mem(ctx, fp, fctx.frame.budget_alloc_offset, zr)
  end

  # Move register-assigned params from ABI regs to their assigned regs.
  # Where each parameter arrives is decided by the single authority
  # classify_argument (AbiArg): Register params and Indirect by-reference
  # aggregates both arrive in arg_reg(arch, idx) (Some exactly while
  # idx < max_ra) and are bound to their home; Stack params arrive on the
  # caller's stack and need no prologue binding — the place machinery reads
  # them from the frame.
  # sret ABI: save the caller-supplied indirect-return pointer (x8) into
  # the reserved frame slot before any callee work clobbers it.
  if fctx.frame.sret_offset != 0 then
    match arch
    when Arch::AArch64 then
      emit_store_mem(ctx, PhysReg::A64Reg(A64::FP), fctx.frame.sret_offset as i32, PhysReg::A64Reg(A64::X8))
    when _ then ()
    end
  end
  var idx = 0
  for param in fctx.func.params do
    # The category of every parameter comes from the single authority
    # classify_argument (AbiArg) — the layout engine's value-category model.
    # Scalar values and ScalarPair/ByAddress aggregate references both arrive
    # in arg_reg(arch, idx) (Some exactly while idx < max_ra) and are bound
    # to their home; parameters at idx >= max_ra arrive on the caller's stack
    # and are bound from there. Behavior is byte-identical to the former
    # Register/Indirect/Stack split.
    match classify_argument(ctx, &param.ty, idx)
    when AbiArg::Scalar(_, _) then
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        prologue_bind_param_from_abi_reg(ctx, fctx, fp, param, abi_r)
      when Option::None then
        # Scalar pushed on the caller's stack (idx >= max_ra).
        prologue_bind_param_from_stack(ctx, fctx, fp, param, idx)
      end
    when AbiArg::ScalarPair(_, _) then
      # A 16-byte aggregate (two-slot value) passed BY REFERENCE: the address
      # arrives in the same ABI slot a scalar of this index would use (see
      # classify_argument).
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        prologue_bind_param_from_abi_reg(ctx, fctx, fp, param, abi_r)
      when Option::None then
        # Aggregate address pushed on the caller's stack (idx >= max_ra).
        prologue_bind_param_from_stack(ctx, fctx, fp, param, idx)
      end
    when AbiArg::Vector(_, _) then
      # THE VECTOR CASE: a 16-byte SIMD vector passed BY REFERENCE through
      # the register slots (see classify_argument) — the address arrives in
      # the same ABI slot a scalar of this index would use.
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        prologue_bind_param_from_abi_reg(ctx, fctx, fp, param, abi_r)
      when Option::None then
        # Vector address pushed on the caller's stack (idx >= max_ra).
        prologue_bind_param_from_stack(ctx, fctx, fp, param, idx)
      end
    when AbiArg::ByAddress(_, _) then
      # A >16-byte aggregate passed BY REFERENCE: the address arrives in the
      # same ABI slot a scalar of this index would use (see classify_argument).
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        prologue_bind_param_from_abi_reg(ctx, fctx, fp, param, abi_r)
      when Option::None then
        # Aggregate address pushed on the caller's stack (idx >= max_ra).
        prologue_bind_param_from_stack(ctx, fctx, fp, param, idx)
      end
    end
    idx = idx + 1
  end
end

# Bind a parameter that arrived on the caller's stack (idx >= max_reg_args):
# load the pushed slot into the scratch register and bind from it.
def prologue_bind_param_from_stack(inout ctx: CodegenCtx, fctx: FnCodegenCtx, fp: PhysReg, param: MirLocal, idx: Int) -> Unit
  let max_ra = max_reg_args(ctx.target.arch)
  let k = idx - max_ra
  let slot = match ctx.target.arch
  when Arch::AArch64 then 16
  when Arch::X86_64 then 8
  end
  let tmp = scratch_reg(ctx.target.arch)
  emit_load_mem(ctx, tmp, fp, (16 + k * slot) as i32)
  prologue_bind_param_from_abi_reg(ctx, fctx, fp, param, tmp)
end

def codegen_epilogue(inout ctx: CodegenCtx, fctx: FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)
  let rr = ret_reg(arch)

  # sret ABI: if function uses indirect return, copy local 0 (return slot)
  # into the buffer pointed to by the saved x8 pointer. Skip the x0 load.
  var loaded_ret = false
  if fctx.frame.sret_offset != 0 then
    match arch
    when Arch::AArch64 then
      let ret_local = fctx.func.locals[0]
      # Reload saved x8 into x16 (scratch)
      emit_load_mem(ctx, PhysReg::A64Reg(A64::X16), PhysReg::A64Reg(A64::FP), fctx.frame.sret_offset as i32)
      # Find local 0's stack offset
      var src_off: i32 = 0
      match fctx.var_locs.get(ret_local.id.id)
      when Option::Some(loc) then
        match loc
        when VarLoc::Stack(off) then src_off = off
        when VarLoc::Spilled(off) then src_off = off
        when _ then ()
        end
      when _ then ()
      end
      # Copy exactly ret_sz bytes from [fp + src_off] to [x16] — never more.
      # 8-byte chunks while remaining >= 8, then 4/2/1-byte tails, so a 12-byte
      # aggregate copies exactly 12 bytes (the old loop copied 16).
      var copied = 0
      let ret_sz = layout_of_strict(&mut ctx.layout_engine, &ret_local.ty).size
      while ret_sz - copied >= 8 do
        emit_load_mem(ctx, PhysReg::A64Reg(A64::X17), PhysReg::A64Reg(A64::FP), (src_off + copied as i32) as i32)
        emit_store_mem(ctx, PhysReg::A64Reg(A64::X16), copied as i32, PhysReg::A64Reg(A64::X17))
        copied = copied + 8
      end
      if ret_sz - copied >= 4 then
        emit_load_mem_sized(ctx, PhysReg::A64Reg(A64::X17), PhysReg::A64Reg(A64::FP), (src_off + copied as i32) as i32, MemWidth::W32, Extension::Zero)
        emit_store_mem_sized(ctx, PhysReg::A64Reg(A64::X16), copied as i32, PhysReg::A64Reg(A64::X17), MemWidth::W32)
        copied = copied + 4
      end
      if ret_sz - copied >= 2 then
        emit_load_mem_sized(ctx, PhysReg::A64Reg(A64::X17), PhysReg::A64Reg(A64::FP), (src_off + copied as i32) as i32, MemWidth::W16, Extension::Zero)
        emit_store_mem_sized(ctx, PhysReg::A64Reg(A64::X16), copied as i32, PhysReg::A64Reg(A64::X17), MemWidth::W16)
        copied = copied + 2
      end
      if ret_sz - copied >= 1 then
        emit_load_mem_sized(ctx, PhysReg::A64Reg(A64::X17), PhysReg::A64Reg(A64::FP), (src_off + copied as i32) as i32, MemWidth::W8, Extension::Zero)
        emit_store_mem_sized(ctx, PhysReg::A64Reg(A64::X16), copied as i32, PhysReg::A64Reg(A64::X17), MemWidth::W8)
        copied = copied + 1
      end
      loaded_ret = true
    when _ then ()
    end
  end

  # Load return value into the return register (local 0 is return place).
  if !loaded_ret && fctx.func.locals.len() > 0 then
    let ret_local = fctx.func.locals[0]
    match fctx.var_locs.get(ret_local.id.id)
    when Option::Some(loc) then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(rr) then
          emit_mov_rr(ctx, rr, r)
        end
        loaded_ret = true
      when VarLoc::Stack(off) then
        emit_load_mem(ctx, rr, fp, off)
        loaded_ret = true
      when VarLoc::Spilled(off) then
        emit_load_mem(ctx, rr, fp, off)
        loaded_ret = true
      end
    when _ then ()
    end
  end
  if !loaded_ret then
    # Unit return type or no return local: ensure return register is zero
    emit_zero_reg(ctx, rr)
  end

  match arch
  when Arch::X86_64 then
    # Restore callee-saved registers from the bottom of the frame
    # (saved[i] at [fp - stack_size + i*8], matching the prologue stores)
    let saved = fctx.frame.saved_regs
    var si = 0
    while si < saved.len() do
      let abs_off = fctx.frame.stack_size - (si * 8)
      match saved[si]
      when PhysReg::X64Reg(r) then
        emit_load_mem(ctx, PhysReg::X64Reg(r), fp, -(abs_off as i32))
      when _ then ()
      end
      si = si + 1
    end
    # Deallocate stack frame
    if fctx.frame.stack_size > 0 then
      emit_add_ri(ctx, sp, fctx.frame.stack_size as i32)
    end
    # pop rbp; ret
    emit_pop(ctx, fp)
    emit_ret(ctx)

  when Arch::AArch64 then
    # Restore callee-saved registers from bottom of frame (FP-relative)
    let saved = fctx.frame.saved_regs
    let ss = fctx.frame.stack_size
    var si = 0
    while si < saved.len() do
      # off = -(stack_size) + (si * 8), always negative
      let abs_off = ss - (si * 8)
      match saved[si]
      when PhysReg::A64Reg(a) then
        if abs_off <= 256 then
          a64_ldur(&mut ctx.text, a, A64::FP, -(abs_off as i32))
        elsif abs_off <= 4095 then
          a64_sub_rri(&mut ctx.text, A64::X15, A64::FP, abs_off as u32)
          a64_ldur(&mut ctx.text, a, A64::X15, 0)
        else
          a64_mov_ri(&mut ctx.text, A64::X15, abs_off as i64)
          a64_sub_rrr(&mut ctx.text, A64::X15, A64::FP, A64::X15)
          a64_ldur(&mut ctx.text, a, A64::X15, 0)
        end
      when _ then ()
      end
      si = si + 1
    end
    # mov sp, fp (deallocate entire frame at once)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::FP)
    # ldp fp, lr, [sp], #16  (post-index: restore fp and lr)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Phi resolution — emit copies for phi nodes in successor blocks
# ———————————————————————————————————————————————————————————————

def get_successor_ids(term: MirTerminator) -> Vec[Int]
  var succs = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    succs.push(target.id)
  when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
    for sw in targets do
      succs.push(sw.target.id)
    end
    succs.push(default_target.id)
  when MirTerminatorKind::MirCall(dest, func_op, args, success, unwind, intrinsic) then
    succs.push(success.id)
  when MirTerminatorKind::MirDeinit(place, deinit_fn, target, unwind) then
    succs.push(target.id)
  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    succs.push(target.id)
  when _ then ()
  end
  succs
end

def emit_phi_copies(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, block: MirBlock, func: MirFunction) -> Unit
  let rr = ret_reg(ctx.target.arch)
  let succ_ids = get_successor_ids(&block.terminator)
  let cur_id = block.id.id

  for succ_id in succ_ids do
    if succ_id < func.blocks.len() then
      let succ_block = func.blocks[succ_id]
      for stmt in succ_block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          match rvalue.kind
          when MirRvalueKind::MirPhi(pairs) then
            # Find the pair for our current block
            for pair in pairs do
              if pair.0.id == cur_id then
                # Load from the predecessor local
                let fp = fp_reg(ctx.target.arch)
                match fctx.var_locs.get(pair.1.id)
                when Option::Some(loc) then
                  match loc
                  when VarLoc::Register(r) then emit_mov_rr(ctx, rr, r)
                  when VarLoc::Stack(off)  then emit_load_mem(ctx, rr, fp, off)
                  when VarLoc::Spilled(off) then emit_load_mem(ctx, rr, fp, off)
                  end
                when Option::None then ()
                end
                # Store to the phi destination
                store_place(ctx, fctx, &place, rr)
              end
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Function code generation
# ———————————————————————————————————————————————————————————————

def codegen_function(inout ctx: CodegenCtx, func: MirFunction) -> Unit
  # Extern functions don't get a body — they are resolved at link time.
  # Emit an undefined symbol entry so the linker knows to resolve it.
  if func.is_extern then
    # Add undefined symbol (N_EXT) for extern function
    add_symbol(&mut ctx.text, AsmSymbol {
      name: func.name.clone(),
      section: Section::Extern,  # Mark as external/undefined
      offset: 0,
      size: 0,
      binding: SymBinding::Global,
      kind: SymKind::Func
    })
    return
  end

  # Register allocation — allocate_locals now also pre-scans the MIR to
  # reserve space for dynamic spills (aggregates, address-of), so
  # frame.stack_size includes everything and is final.
  let (var_locs, frame) = allocate_locals(func, ctx.target.arch, &mut ctx.layout_engine)

  # Block labels
  let block_labels = make_block_labels(func)
  let str_locals = compute_string_locals(func)
  var fctx = FnCodegenCtx {
    func: func.clone(),
    frame: frame,
    var_locs: var_locs,
    block_labels: block_labels,
    string_locals: str_locals,
    next_effect_frame: 0
  }

  # Align function start to 4 bytes (required for ARM64 instruction alignment)
  align_to(&mut ctx.text, 4, ctx.target.arch)

  let fn_start = buf_pos(&ctx.text)
  ctx.debug_current_fn = func.name.clone()
  let symbol_name = func.name.clone()
  let entry_label = match ctx.fn_alias.get(&symbol_name)
  when Option::Some(label) then label.clone()
  when Option::None then symbol_name.clone()
  end

  # Emit function symbol
  add_symbol(&mut ctx.text, AsmSymbol {
    name: symbol_name.clone(),
    section: Section::Text,
    offset: fn_start,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })

  # Define the function entry label for direct calls/fixups.
  def_label(&mut ctx.text, entry_label)

  # Prologue
  codegen_prologue(ctx, &fctx)

  # ABI-provided argc and argv into.data globals so the runtime can
  if func.name == "main" || func.name == "_start" then
    emit_save_argc_argv(ctx)
  end

  # Emit all blocks
  var block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    let label = block_label_for(&fctx, block.id.id)
    def_label(&mut ctx.text, label)

    var stmt_idx = 0
    while stmt_idx < block.statements.len() do
      codegen_statement(ctx, &mut fctx, block, stmt_idx)
      stmt_idx = stmt_idx + 1
    end

    # Phi resolution: copy values into phi destinations in successor blocks
    emit_phi_copies(ctx, &mut fctx, block, func)
    codegen_terminator(ctx, &mut fctx, &block.terminator)
    block_idx = block_idx + 1
  end

  # Patch the symbol size
  let fn_end = buf_pos(&ctx.text)
  # (Symbol size patching would update the last symbol's size field)
end

# ———————————————————————————————————————————————————————————————
# Static variables
# ———————————————————————————————————————————————————————————————

# the DefId-render key of a static reference's DefId — the static
# label table's key domain.
def static_def_id_key(did: DefId) -> String
  did.module.id.to_string() + ":" + did.index.to_string()
end

# resolve the emission label of a static from its SEMANTIC DefId —
# the single authority for the MirStaticRef / MirStaticAddr constant arms.
# The label comes from the static label table (built at codegen_program
# from the program's statics + its reference constants — see
# build_static_label_table); a DefId that never registered is an internal
# compiler error — fail-closed, never a name-derived or guessed address.
def resolve_static_label(ctx: CodegenCtx, did: DefId) -> String
  match ctx.static_labels.get(static_def_id_key(did))
  when Option::Some(label) then label.clone()
  when Option::None then
    panic("ICE: static reference carries an unregistered DefId (module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") — the static's DefId-side registration is missing from the static label table")
  end  end
end

# collect every (DefId, constant type) pair a MirStaticRef /
# MirStaticAddr constant carries, from one operand. The MirStaticRef
# constant's type is the static's type (set at lowering); the MirStaticAddr
# constant's type is the Ptr(Unit) of its address temp and takes no part in
# the type join below — its DefId resolves through the same table entry the
# static's other references register.
def collect_static_refs_from_operand(op: MirOperand, inout out: Vec[(DefId, Type)]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirStaticRef(did) then
      out.push((DefId { module: ModuleId { id: did.module.id }, index: did.index }, cst.ty.clone()))
    when MirConstantKind::MirStaticAddr(did) then
      out.push((DefId { module: ModuleId { id: did.module.id }, index: did.index }, cst.ty.clone()))
    when _ then ()
    end
  when _ then ()
  end  end
end

def collect_static_refs_from_rvalue(rv: MirRvalue, inout out: Vec[(DefId, Type)]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    collect_static_refs_from_operand(op, out)
  when MirRvalueKind::MirBinOp(_, left, right) then
    collect_static_refs_from_operand(left, out)
    collect_static_refs_from_operand(right, out)
  when MirRvalueKind::MirUnOp(_, op) then
    collect_static_refs_from_operand(op, out)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      collect_static_refs_from_operand(op, out)
    end
  when MirRvalueKind::MirCast(_, op, _) then
    collect_static_refs_from_operand(op, out)
  when MirRvalueKind::MirRepeat(op, _) then
    collect_static_refs_from_operand(op, out)
  when _ then ()
  end  end
end

def collect_static_refs_from_call_arg(arg: MirCallArg, inout out: Vec[(DefId, Type)]) -> Unit
  match arg.value
  when MirCallValue::Value(op) then collect_static_refs_from_operand(op, out)
  when MirCallValue::Place(_) then ()
  end  end
end

def collect_static_refs(func: MirFunction) -> Vec[(DefId, Type)]
  var refs: Vec[(DefId, Type)] = Vec::new()
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rv) then
        collect_static_refs_from_rvalue(rv, &mut refs)
      when MirStatementKind::MirContractCheck(_, cond) then
        collect_static_refs_from_operand(cond, &mut refs)
      when MirStatementKind::MirEffectRecord(_, op) then
        collect_static_refs_from_operand(op, &mut refs)
      when MirStatementKind::MirEffectPerform(_, _, _, payload_ptr, result_ptr) then
        collect_static_refs_from_operand(payload_ptr, &mut refs)
        collect_static_refs_from_operand(result_ptr, &mut refs)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, env_ptr) then
        collect_static_refs_from_operand(env_ptr, &mut refs)
      when _ then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirCall(_, callee, args, _, _, _) then
      collect_static_refs_from_operand(callee, &mut refs)
      for arg in args do
        collect_static_refs_from_call_arg(arg, &mut refs)
      end
    when MirTerminatorKind::MirSwitchInt(op, _, _) then
      collect_static_refs_from_operand(op, &mut refs)
    when MirTerminatorKind::MirAssert(cond, _, _, _, _) then
      collect_static_refs_from_operand(cond, &mut refs)
    when _ then ()
    end
  end
  refs
end

# build the static label table — DefId-render -> the static's
# emission label — from the program's statics and the DefIds its reference
# constants carry. Each MirStatic's emission label is its name-side
# registration (st.name — the label codegen_static emits at the symbol
# table); the DefId is recovered by joining the reference constants (whose
# MirStaticRef constant type IS the static's type) against the statics by
# type identity — the pairing the lowering established (static_def_ids:
# source name -> the resolver's DefId). The join must be UNIQUE: a
# reference type matching several same-typed statics is an internal error
# (fail-closed — the emission label must never be derived from an
# unverifiable pairing).
#
# MirStaticAddr-only DefIds (a static referenced ONLY through its address —
# method receivers, write sites — whose constant type is Ptr(Unit) and can
# take no part in the type join) pair with the single unclaimed static
# when the counts are both exactly one; anything richer fails closed.
def build_static_label_table(program: MirProgram, inout out: Map[String, String]) -> Unit
  var refs: Vec[(DefId, Type)] = Vec::new()
  for func in program.functions do
    let fre = collect_static_refs(func)
    for r in fre do
      refs.push(r)
    end
  end
  for st in program.statics do
    match st.init
    when Option::Some(init_op) then collect_static_refs_from_operand(init_op, &mut refs)
    when Option::None then ()
    end
  end

  # Ref-side join: every MirStaticRef constant's type IS its static's type
  # (set at lowering) — the DefIds per reference type. The same DefId
  # repeated is one claim.
  var type_dids: Map[String, Vec[String]] = Map::new()
  var seen_did: Map[String, Int] = Map::new()
  for (did, ty) in refs do
    let ty_key = mir_type_identity_key(&ty)
    if ty_key != mir_type_identity_key(&Type::Ptr(Type::Unit)) then
      let did_key = static_def_id_key(&did)
      if !seen_did.contains_key(&did_key) then
        seen_did.insert(did_key.clone(), 1)
        match type_dids.get(ty_key.clone())
        when Option::Some(v) then
          var nv = v
          nv.push(did_key.clone())
          type_dids.insert(ty_key.clone(), nv)
        when Option::None then
          var nv = Vec::new()
          nv.push(did_key.clone())
          type_dids.insert(ty_key.clone(), nv)
        end
      end
    end
  end

  # ADDRESS-ONLY references: a MirStaticAddr whose DefId never appears in a
  # MirStaticRef anywhere — the static is used only through its address
  # (method receivers, write sites). The Addr constant's type is the
  # Ptr(Unit) of its address temp, so these DefIds take part in no type
  # join; they need the unclaimed pairing below.
  var addr_only: Vec[String] = Vec::new()
  for (did, ty) in refs do
    let ty_key = mir_type_identity_key(&ty)
    let did_key = static_def_id_key(&did)
    if ty_key == mir_type_identity_key(&Type::Ptr(Type::Unit)) && !seen_did.contains_key(&did_key) && !addr_only.contains(&did_key) then
      addr_only.push(did_key.clone())
    end
  end

  # The join must be UNIQUE: a claimed reference type must match exactly
  # one static and carry exactly one DefId — otherwise the pairing is
  # unverifiable and the emission label must never be guessed (fail-closed).
  var static_count_by_type: Map[String, Int] = Map::new()
  for st in program.statics do
    let st_ty_key = mir_type_identity_key(&st.ty)
    match static_count_by_type.get(st_ty_key.clone())
    when Option::Some(c) then static_count_by_type.insert(st_ty_key.clone(), c + 1)
    when Option::None then static_count_by_type.insert(st_ty_key.clone(), 1)
    end
  end
  for (ty_key, dids) in type_dids do
    let st_count = match static_count_by_type.get(ty_key.clone())
    when Option::Some(c) then c
    when Option::None then 0
    end
    if st_count != 1 || dids.len() != 1 then
      panic("ICE: static label table: reference type `" + ty_key.clone() + "` is claimed by " + dids.len().to_string() + " DefId(s) and matched by " + st_count.to_string() + " static(s) — the statics' DefId-side registration (MirStatic.def_id) is required for a unique pairing")
    end
  end

  # Register each claimed static's label (the name-side symbol-table
  # registration) under its reference DefId.
  for st in program.statics do
    let st_ty_key = mir_type_identity_key(&st.ty)
    match type_dids.get(st_ty_key)
    when Option::Some(dids) then
      if dids.len() == 1 then out.insert(dids[0].clone(), st.name.clone()) end
    when Option::None then ()
    end
  end

  # Address-only references (a static used ONLY through its address — method
  # receivers, write sites — with no MirStaticRef anywhere): pair the single
  # unpaired address DefId with the single unclaimed static when both are
  # unique — the only sound pairing available. Anything richer fails closed.
  var unclaimed: Vec[String] = Vec::new()
  for st in program.statics do
    let st_ty_key = mir_type_identity_key(&st.ty)
    if !type_dids.contains_key(&st_ty_key) then
      unclaimed.push(st.name.clone())
    end
  end
  if !addr_only.is_empty() then
    if addr_only.len() == 1 && unclaimed.len() == 1 then
      out.insert(addr_only[0].clone(), unclaimed[0].clone())
    else
      panic("ICE: static label table: " + addr_only.len().to_string() + " address-only static reference(s) cannot be paired with " + unclaimed.len().to_string() + " unclaimed static(s) — the statics' DefId-side registration (MirStatic.def_id) is required")
    end
  end
end

def clone_static_init_operand(st: MirStatic) -> Option[MirOperand]
  match st.init
  when Option::Some(op) then Option::Some(op.clone())
  when Option::None then Option::None
  end  end
end

# Emit a scalar integer constant into a buffer at exactly its storage width
# (1/2/4/8 bytes). Used by statics, constant globals and any scalar image that
# must match the layout engine's storage record rather than an 8-byte slot.
def emit_scalar_constant_for_storage(inout buf: CodeBuffer, value: i64, width: Int) -> Unit
  match width
  when 1 then emit8(buf, (value & 255) as u8)
  when 2 then emit16_le(buf, (value & 65535) as u16)
  when 4 then emit32_le(buf, (value & 4294967295) as u32)
  when _ then emit64_le(buf, value as u64)
  end  end
end

def emit_static_initializer_scalar(inout ctx: CodegenCtx, op: MirOperand, inout buf: CodeBuffer, st_ty: Type) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(v) then
      let w = storage_size_bytes(ctx, st_ty)
      emit_scalar_constant_for_storage(buf, v, w)
    when _ then ()
    end
  when _ then ()
  end  end
end

def codegen_static(inout ctx: CodegenCtx, st: MirStatic) -> Unit
  let sz = layout_of_strict(&mut ctx.layout_engine, &st.ty).size
  let init_opt = clone_static_init_operand(st)

  # Detect Vec/Array-typed statics — they need a pointer to a 32-byte struct
  # (the HeapVecHeader header size, repr_header_size(Repr::HeapVecHeader),
  # {data:0, len:8, cap:16, stride:24}).
  # Slice-typed statics are the 16-byte VIEW { ptr, len } (slice_view_layout)
  # and are emitted inline below — a Slice static never points at a
  # HeapVecHeader.
  let is_vec_type = match st.ty
  when Type::Adt(tid, _) then
 # Adt form of Array mirrors the canonical arms
    # (heap {ptr,len,cap} handle statics).
    let cst_named = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if cst_named == "Array" then true else false end
  when _ then false
  end
  # The RAW UnsafeSlice view static (the checker rejects raw-view statics,
  # so this empty-view emission is the defensive/FFI path). The SAFE
  # source-spelled Slice is the std-declared shared struct — its static is
  # the Arc handle, emitted through the general initializer path below.
  let is_slice_static = match st.ty
  when Type::Adt(tid, _) then
    bare_name_from_qualified(type_name_by_id(ctx, tid.id)) == "UnsafeSlice"
  when _ then false
  end
  
  match init_opt
  when Option::Some(op) then
    # Align data buffer to 8 bytes before emitting any static
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end

    # For Vec statics: emit a 32-byte empty vec struct in data (the
    # HeapVecHeader size from the engine's repr_header_size — {data:0,
    # len:8, cap:16, stride:24}), then emit the static as a pointer to that
    # struct. The stride field is REQUIRED (an empty vec must still grow
    # correctly): it comes from the CONCRETE element type of the static
    # (Array[T] → args[0]).
    if is_vec_type then
      let vec_data_label = ".Lvec_init_" + st.name.clone()
      add_symbol(&mut ctx.data, AsmSymbol {
        name: vec_data_label.clone(),
        section: Section::Data,
        offset: buf_pos(&ctx.data),
        size: repr_header_size(Repr::HeapVecHeader),
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
      def_label(&mut ctx.data, vec_data_label.clone())
      emit64_le(&mut ctx.data, 0)  # data = null
      emit64_le(&mut ctx.data, 0)  # len = 0
      emit64_le(&mut ctx.data, 0)  # cap = 0
      let st_elem_ty = vec_elem_type_of(ctx, &st.ty)
      let st_stride = element_stride_bytes(ctx, &st_elem_ty)
      emit64_le(&mut ctx.data, st_stride as u64)  # stride (element layout)
      # Now emit the static variable itself as a pointer to the vec struct
      add_symbol(&mut ctx.data, AsmSymbol {
        name: st.name.clone(),
        section: Section::Data,
        offset: buf_pos(&ctx.data),
        size: 8,
        binding: SymBinding::Global,
        kind: SymKind::Data
      })
      def_label(&mut ctx.data, st.name.clone())
      add_reloc(&mut ctx.data, RelocKind::R_AARCH64_ABS64, vec_data_label, 0)
      emit64_le(&mut ctx.data, 0)  # Placeholder, patched by linker
      return
    end

    # UnsafeSlice statics are the 16-byte RAW VIEW { ptr: Ptr[T], len:
    # UInt }: the value IS the view (slice_view_layout), emitted inline as
    # an empty view { ptr = 0, len = 0 } — never a pointer to a heap
    # header.
    if is_slice_static then
      add_symbol(&mut ctx.data, AsmSymbol {
        name: st.name.clone(),
        section: Section::Data,
        offset: buf_pos(&ctx.data),
        size: sz,
        binding: SymBinding::Global,
        kind: SymKind::Data
      })
      def_label(&mut ctx.data, st.name.clone())
      emit64_le(&mut ctx.data, 0)  # ptr = 0 (empty view)
      emit64_le(&mut ctx.data, 0)  # len = 0
      return
    end

    # Initialized - goes into.data section
    add_symbol(&mut ctx.data, AsmSymbol {
      name: st.name.clone(),
      section: Section::Data,
      offset: buf_pos(&ctx.data),
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    def_label(&mut ctx.data, st.name.clone())

    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(v) then
        emit_scalar_constant_for_storage(&mut ctx.data, v, storage_size_bytes(ctx, &st.ty))
        # Pad remaining bytes to fill the full type size
        var emitted = storage_size_bytes(ctx, &st.ty)
        while emitted < sz do
          emit8(&mut ctx.data, 0)
          emitted = emitted + 1
        end
      when MirConstantKind::MirBool(b) then
        if b then emit8(&mut ctx.data, 1) else emit8(&mut ctx.data, 0) end
        # Pad to alignment
        var pad = sz - 1
        while pad > 0 do
          emit8(&mut ctx.data, 0)
          pad = pad - 1
        end
      when MirConstantKind::MirString(s) then
          # String constant: emit raw pointer to null-terminated rodata.
        let label = intern_string(ctx, s)
        # Emit relocation for the string pointer
        add_reloc(&mut ctx.data, RelocKind::R_AARCH64_ABS64, label.clone(), 0)
        emit64_le(&mut ctx.data, 0)  # Placeholder, patched by linker
      when _ then
        var i = 0
        while i < sz do
          emit8(&mut ctx.data, 0)
          i = i + 1
        end
      end
    when _ then
      var i = 0
      while i < sz do
        emit8(&mut ctx.data, 0)
        i = i + 1
      end
    end
    # Ensure 8-byte alignment after emission
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end
  when Option::None then
    # Uninitialized/zero-initialized - goes into.bss section
    # Track symbol in bss_symbols with current bss_size as offset
    ctx.bss_symbols.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Bss,
      offset: ctx.bss_size,
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    # Align bss_size appropriately
    let align = layout_of_strict(&mut ctx.layout_engine, &st.ty).align
    let rem = ctx.bss_size % align
    if rem != 0 then
      ctx.bss_size = ctx.bss_size + (align - rem)
    end
    ctx.bss_size = ctx.bss_size + sz
  end
end

# ———————————————————————————————————————————————————————————————
# Dead Code Elimination — only codegen functions reachable from main
# ———————————————————————————————————————————————————————————————

def collect_fn_refs_from_operand(op: MirOperand, inout out: Vec[String]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFnItem(name) then
      out.push(name.clone())
    when _ then ()
    end
  when _ then ()
  end  end
end

def collect_fn_refs_from_rvalue(rv: MirRvalue, inout out: Vec[String]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirBinOp(_, left, right) then
    collect_fn_refs_from_operand(left, out)
    collect_fn_refs_from_operand(right, out)
  when MirRvalueKind::MirUnOp(_, op) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      collect_fn_refs_from_operand(op, out)
    end
  when MirRvalueKind::MirCast(_, op, _) then
    collect_fn_refs_from_operand(op, out)
  when MirRvalueKind::MirRepeat(op, _) then
    collect_fn_refs_from_operand(op, out)
  when _ then ()
  end  end
end

def collect_fn_refs(func: MirFunction) -> Vec[String]
  var refs: Vec[String] = Vec::new()
  for block in func.blocks do
    # Scan statements
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rv) then
        collect_fn_refs_from_rvalue(rv, &mut refs)
      when MirStatementKind::MirContractCheck(_, cond) then
        collect_fn_refs_from_operand(cond, &mut refs)
      when MirStatementKind::MirEffectRecord(_, op) then
        collect_fn_refs_from_operand(op, &mut refs)
      when MirStatementKind::MirEffectPerform(_, _, _, payload_ptr, result_ptr) then
        collect_fn_refs_from_operand(payload_ptr, &mut refs)
        collect_fn_refs_from_operand(result_ptr, &mut refs)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, env_ptr) then
        collect_fn_refs_from_operand(env_ptr, &mut refs)
      when _ then ()
      end
    end
    # Scan terminator
    match block.terminator.kind
    when MirTerminatorKind::MirCall(_, callee, args, _, _, _) then
      collect_fn_refs_from_operand(callee, &mut refs)
      for arg in args do
        let arg_op = mir_call_arg_operand(arg)
        collect_fn_refs_from_operand(&arg_op, &mut refs)
      end
    when MirTerminatorKind::MirSwitchInt(op, _, _) then
      collect_fn_refs_from_operand(op, &mut refs)
    when MirTerminatorKind::MirAssert(cond, _, _, _, _) then
      collect_fn_refs_from_operand(cond, &mut refs)
    when _ then ()
    end
  end
  refs
end

# Extract the bare (unqualified) name from a potentially qualified function name.
# "std::env::args" → "args", "Vec__push" → "push", "main" → "main"
def find_double_underscore(name: String) -> Int
  if name.len() < 2 then
    return -1
  end
  var i = 0
  while i + 1 < name.len() do
    if name.slice(i, i + 2) == "__" then
      return i
    end
    i = i + 1
  end
  -1
end

def rfind_double_colon(name: String) -> Int
  if name.len() < 2 then
    return -1
  end
  var i = name.len() - 2
  loop
    if name.slice(i, i + 2) == "::" then
      return i
    end
    if i == 0 then
      break
    end
    i = i - 1
  end
  -1
end

# The ALIAS-key normalizer — used only to build extra
# fn_alias lookup keys for unqualified references, never to rewrite an
# emitted label. The semantic function identity is the module-qualified
# DefId-derived key; emission names are the symbol-mangling boundary, and
# this stripping keeps the mangled/qualified emission name intact (only the
# last segment is exposed as an alias). "Type__method" -> "method",
# "a::b::helper" -> "helper"; the emitted name itself is never shortened.
def bare_name_from_qualified(name: String) -> String
  # Handle Type__method mangled names
  let mangled_pos = find_double_underscore(&name)
  if mangled_pos > 0 then
    return name.slice(mangled_pos + 2, name.len())
  end

  # Handle :: qualified names
  let qual_pos = rfind_double_colon(&name)
  if qual_pos >= 0 then
    return name.slice(qual_pos + 2, name.len())
  end

  name.clone()
end

# whether a name is a DefId-derived emission name — the fn_owner_key
# rendering "<module path>::<index>::<kind>" that top-level functions are
# emitted under (see mir.tg's mir_fn_emission_name). A DefId-derived name
# has NO bare form: bare_name_from_qualified strips only the LAST segment,
# which would reduce every derived name to its kind token ("fn"), a
# synthetic alias that only collides. Derived names are referenced by their
# exact identity entry (fn_alias name -> ".Lfn_entry.<index>"); the
# bare/canonical alias machinery is for the remaining name-based references
# (methods, synthesized/IR-only calls) only.
def is_defid_derived_name(name: String) -> Bool
  let segs = name.split("::")
  if segs.len() < 2 then return false end
  let kind_seg = segs[segs.len() - 1]
  if kind_seg != "fn" && kind_seg != "method" && kind_seg != "static" &&
     kind_seg != "const" && kind_seg != "variant" && kind_seg != "field" &&
     kind_seg != "intrinsic" && kind_seg != "type" && kind_seg != "other" then
    return false
  end
  let idx_seg = segs[segs.len() - 2]
  if idx_seg.is_empty() then return false end
  var i = 0
  var numeric = true
  while i < idx_seg.len() do
    let ch = idx_seg.char_at(i)
    if ch < '0' || ch > '9' then
      numeric = false
      break
    end
    i = i + 1
  end
  numeric
end

# Build a canonical lookup key for a function reference name.
# This normalizes all the different ways a function can be referenced:
# - Bare names: "args", "push", "len"
# - Qualified names: "std::env::args", "Vec::push"
# - Mangled names: "Vec__push", "Array__push", "String__to_lowercase"
# - Intrinsic wrappers: "__intrinsic_array_push"
def canonical_fn_ref(name: String) -> String
  # First, normalize intrinsic wrapper prefix
  if name.len() >= 12 then
    if name.slice(0, 12) == "__intrinsic_" then
      return name.slice(12, name.len())
    end
  end
  
  # Normalize Type__method to canonical intrinsic form
  let mangled_pos = find_double_underscore(&name)
  if mangled_pos > 0 then
    let prefix = name.slice(0, mangled_pos)
    let bare = name.slice(mangled_pos + 2, name.len())
    # Known collection type prefixes → canonical intrinsic prefix
    if prefix == "Vec" || prefix == "Array" then
      return "array_" + bare
    else if prefix == "Map" then
      return "map_" + bare
    else if prefix == "Set" then
      return "set_" + bare
    # String type methods use the same canonical form as bare_intrinsic_name.
    else if prefix == "String" then
      return "string_" + bare
    # Formatter type methods
    else if prefix == "Formatter" then
      return "fmt_" + bare
    # Option type methods
    else if prefix == "Option" then
      return "option_" + bare
    # Result type methods
    else if prefix == "Result" then
      return "result_" + bare
    # Iterator type methods
    else if prefix == "Iterator" then
      return "iter_" + bare
    # File/IO types
    else if prefix == "File" then
      return "file_" + bare
    else if prefix == "Io" then
      return "io_" + bare
    end
    # For other types, return bare method name
    return bare
  end
  
  # For qualified names, extract the bare name for matching
  let qual_pos = rfind_double_colon(&name)
  if qual_pos >= 0 then
    # Return bare name for lookup
    return name.slice(qual_pos + 2, name.len())
  end
  
  name.clone()
end

def compute_reachable(program: MirProgram) -> Set[String]
  # EMIT ALL FUNCTIONS — bootstrap mode.
  # During bootstrap compilation, the compiler compiles individual compiler source
  # files (e.g. agentic.tg) whose MIR may NOT contain the compiler driver functions
  # (cmd_compile, compile_startup_entry) needed to trigger the old bootstrap
  # heuristics. Rather than trying to detect "is this a bootstrap compile?" from
  # the MIR contents (which is fragile), we unconditionally emit all functions.
  # Dead-code elimination (DCE) can be reintroduced as an optimization pass once
  # the compiler is fully self-hosted and the bootstrap chain is complete.
 # the set is keyed by MirFunction.name — the DefId-derived EMISSION
  # name for top-level functions (fn_owner_key "<module path>::<index>::fn"),
  # with "Type__method" method names, extern/intrinsic source names, and the
  # OS-entry "main"/"_start" unchanged. reachable_fns is therefore keyed
  # identically to the fn_alias identity entries and the MirFnItem call
  # references, so resolve_callee_label's reachable/extern gate sees exactly
  # the emitted names.
  var all_fns: Set[String] = Set::new()
  for func in program.functions do
    all_fns.insert(func.name.clone())
  end
  all_fns
end

def compute_reachable_dce(program: MirProgram) -> Set[String]
  # Build name -> function index map with MULTIPLE aliases per function.
  # This is the production fix: each function is registered under:
  # 1. Its full MIR name (e.g., "std::env::args")
  # 2. Its bare name (e.g., "args") for unqualified references
  # 3. Its canonical intrinsic name if applicable (e.g., "array_push" for "Vec__push")
  var fn_map: Map[String, Int] = Map::new()
  var idx = 0
  for func in program.functions do
    # Debug: trace println registration
    if func.name == "println" || func.name.contains("println") then
    end
    # Register under full name
    fn_map.insert(func.name.clone(), idx)
    
    # Register under bare name (last segment after :: or before __)
    let bare = bare_name_from_qualified(func.name.clone())
    if bare != func.name then
      fn_map.insert(bare.clone(), idx)
    end
    
    # Register under canonical intrinsic-normalized name
    let canonical = canonical_fn_ref(func.name.clone())
    if canonical != func.name && canonical != bare then
      fn_map.insert(canonical.clone(), idx)
    end
    
    idx = idx + 1
  end

  # BFS from "main"
  var reachable: Set[String] = Set::new()
  var worklist: Vec[String] = Vec::new()
  worklist.push("main".to_string())
  reachable.insert("main".to_string())

  while worklist.len() > 0 do
    let name = match worklist.pop()
    when Option::Some(n) then n
    when Option::None then break
    end
    if name == "main" || name == "println" then
    end
    
    # Try to find the function - first by exact name, then by canonical form
    var func_idx: Option[Int] = fn_map.get(&name)
    match func_idx
    when Option::None then
      # Try canonical form
      let canonical = canonical_fn_ref(name.clone())
      func_idx = fn_map.get(&canonical)
    when Option::Some(_) then ()
    end
    
    match func_idx
    when Option::Some(fi) then
      let func = program.functions[fi]
      let refs = collect_fn_refs(func)
      for r in refs do
        # Normalize the reference for lookup
        let r_canonical = canonical_fn_ref(r.clone())
        var r_idx = fn_map.get(&r)
        match r_idx
        when Option::None then
          # Try canonical form
          r_idx = fn_map.get(&r_canonical)
        when Option::Some(_) then
          ()
        end
        
        # Get the actual function name for the reachable set
        match r_idx
        when Option::Some(actual_idx) then
          let actual_func = program.functions[actual_idx]
          let actual_name = actual_func.name.clone()
          let is_in = reachable.contains(&actual_name)
          # Use explicit == false instead of ! to work around potential interpreter bug
          if is_in == false then
            reachable.insert(actual_name.clone())
            worklist.push(actual_name.clone())
          end
        when Option::None then
          # Function not found - could be intrinsic or extern
 # Add to reachable anyway for intrinsics.: the membership is
          # the SEMANTIC router's (intrinsic_id_of_call — the same
          # classification the checker attaches; the reachability marking
          # only needs Some/None, so the operand facts are dummy).
          let r_is_intr = intrinsic_id_of_call(&r, &Type::Unit, &"".to_string(), &Type::Unit, &"".to_string(), &r, false, false)
          let rc_is_intr = intrinsic_id_of_call(&r_canonical, &Type::Unit, &"".to_string(), &Type::Unit, &"".to_string(), &r_canonical, false, false)
          if r_is_intr.is_some() || rc_is_intr.is_some() then
            if !reachable.contains(&r) then
              reachable.insert(r.clone())
            end
          end
        end
      end
    when Option::None then
      ()
    end
  end

  reachable
end

# Resolve a dot-prefixed method name (e.g. ".keys") to a qualified name
# using the receiver argument's type. Returns Type__method format which
# the codegen can resolve through compiled function bodies or intrinsics.
def resolve_dot_method(ctx: CodegenCtx, fctx: FnCodegenCtx, fn_name: String, args: Vec[MirOperand]) -> String
  if fn_name.len() <= 1 then
    return fn_name.clone()
  end
  if fn_name.slice(0, 1) != "." then
    return fn_name.clone()
  end
  let method = fn_name.slice(1, fn_name.len())
  if args.len() == 0 then
    return method
  end
  let recv_ty = strip_ref_like_type(&operand_type(ctx, fctx, &args[0]))
  match recv_ty
  when Type::Char then
    if method == "to_string" then "__intrinsic_char_to_string"
    else "Char__" + method
    end
  when Type::String then "String__" + method
  when Type::Adt(tid, _) then
 # Adt form of the builtin compound collections mirrors the
    # canonical arms above (Type__method mangling); everything else
    # keeps the pre-existing name-based resolution.
    let type_name = type_name_by_id(ctx, tid.id)
    let bare_type_name = bare_name_from_qualified(type_name)
    if bare_type_name == "Map" then "Map__" + method
    elsif bare_type_name == "Set" then "Set__" + method
    elsif bare_type_name == "Array" || bare_type_name == "UnsafeSlice" then "Vec__" + method
    elsif bare_type_name == "Option" then "Option__" + method
    elsif bare_type_name == "Result" then "Result__" + method
    else
      if type_name != "" then
        type_name + "__" + method
      else
        method
      end
    end
  when _ then method
  end
end

# Normalize a potentially mangled function name to its canonical intrinsic name.
# Handles three naming patterns:
#   1. __intrinsic_array_push  → array_push   (std library intrinsic wrappers)
#   2. Vec__push / Array__push → array_push   (known collection type prefixes)
#      Map__insert             → map_insert
#      Set__contains           → set_contains
#   3. Lexer__push             → push          (unknown struct prefix, bare name)
# Returns the original name unchanged if no pattern matches.
def bare_intrinsic_name(name: String) -> String
  # Pattern 0: Strip leading dot from method names (MIR uses.method_name)
  if name.len() > 1 then
    if name.slice(0, 1) == "." then
      let stripped = name.slice(1, name.len())
      return bare_intrinsic_name(&stripped)
    end
  end

  # Pattern 0b: Some lowered names carry a single leading underscore
  # (e.g. _Set__clone). Normalize those before collection prefix matching.
  if name.len() > 2 then
    if name.slice(0, 1) == "_" && name.slice(1, 2) != "_" then
      let trimmed = name.slice(1, name.len())
      let normalized = bare_intrinsic_name(&trimmed)
      if normalized != trimmed then
        return normalized
      end
    end
  end

  # Pattern 1: __intrinsic_ prefix from std library impl bodies
  if name.len() >= 12 then
    if name.slice(0, 12) == "__intrinsic_" then
      var result = name.slice(12, name.len())
      # Strip generic parameters if present
      match result.find("<")
      when Option::Some(i) then result = result.slice(0, i)
      when Option::None then ()
      end
      return result
    end
  end

  # Pattern 2 & 3: Type__method mangled names
  let sep = "__"
  match name.find(sep)
  when Option::Some(pos) then
    if pos == 0 then
      # Name starts with __ but not __intrinsic_ — return unchanged
      return name.clone()
    end
    let prefix = name.slice(0, pos)
    var bare = name.slice(pos + 2, name.len())
    # Strip generic parameters (e.g., "new<String>" → "new")
    match bare.find("<")
    when Option::Some(i) then bare = bare.slice(0, i)
    when Option::None then ()
    end
    # Known collection/stdlib type prefixes → canonical intrinsic prefix
    if prefix == "Vec" || prefix == "Array" then
      "array_" + bare
    else if prefix == "Map" then
      "map_" + bare
    else if prefix == "Set" then
      "set_" + bare
    else if prefix == "String" then
      "string_" + bare
    else if prefix == "Formatter" then
      # Formatter methods: emit_newline, emit_blank_line, emit, space, etc.
      # These are identity/no-op intrinsics
      bare
    else if prefix == "Option" || prefix == "Result" then
      # Option/Result methods: unwrap, unwrap_or, is_some, is_none, etc.
      bare
    else if prefix == "Io" || prefix == "File" then
      # IO/File methods
      bare
    else if prefix == "Budget" || prefix == "PanicInfo" || prefix == "TypeExpr" then
      # Utility types
      bare
    else if prefix == "Span" || prefix == "MirLocalId" || prefix == "MirBlockId" then
      # ID types
      bare
    else if prefix == "MirFunction" || prefix == "MirStatement" || prefix == "MirRvalue" then
      # MIR types
      bare
    else if prefix == "MirTerminator" || prefix == "AggregateKind" || prefix == "AsmTarget" then
      # More MIR types
      bare
    else if prefix == "InlineResult" || prefix == "Place" || prefix == "PgoProfile" then
      # More types
      bare
    else if prefix == "MirProgram" || prefix == "Type" then
      # More types
      bare
    else if prefix == "IfStmt" || prefix == "LocalDef" || prefix == "FieldDef" then
      # More types  
      bare
    else if prefix == "Repl" || prefix == "ReplContext" then
      # REPL types
      bare
    else
      # Unknown struct prefix (e.g. Lexer__advance)
      # Return the FULL mangled name unchanged — these are NOT intrinsics,
      # they are regular method calls on user-defined types.
      name.clone()
    end
  when Option::None then
    name.clone()
  end
end

def emit_runtime_str_concat(inout ctx: CodegenCtx) -> Unit
  def_label(&mut ctx.text, "_tg_str_concat")
  match ctx.target.arch
  when Arch::AArch64 then emit_str_concat_aarch64(ctx)
  when Arch::X86_64  then emit_str_concat_x86_64(ctx)
  end
end

def emit_str_concat_aarch64(inout ctx: CodegenCtx) -> Unit
  # Prologue: save FP, LR, callee-saved x19-x23
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)

  # Save input args
  a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # ptr_a
  a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # ptr_b

   # strlen(ptr_a) → x21 (NULL/low-addr pointer → empty string)
   a64_mov_ri(&mut ctx.text, A64::X9, 0)
   a64_cmp_ri(&mut ctx.text, A64::X19, 0x1000)
   a64_bcond(&mut ctx.text, a64_cc_lt(), ".Lsc_la_d")
   def_label(&mut ctx.text, ".Lsc_la")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_la_d")
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_la")
  def_label(&mut ctx.text, ".Lsc_la_d")
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X9)

   # strlen(ptr_b) → x22 (NULL/low-addr pointer → empty string)
   a64_mov_ri(&mut ctx.text, A64::X9, 0)
   a64_cmp_ri(&mut ctx.text, A64::X20, 0x1000)
   a64_bcond(&mut ctx.text, a64_cc_lt(), ".Lsc_lb_d")
   def_label(&mut ctx.text, ".Lsc_lb")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X20, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_lb_d")
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_lb")
  def_label(&mut ctx.text, ".Lsc_lb_d")
  a64_mov_rr(&mut ctx.text, A64::X22, A64::X9)

  # total = len_a + len_b + 1  (size arg for the bump allocator in X0)
  a64_add_rrr(&mut ctx.text, A64::X0, A64::X21, A64::X22)
  a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)

  # Allocate the result from the shared bump arena (size in X0 -> ptr in X0).
  # Previously this did a fresh mmap per concatenation, which on macOS rounds
  # each allocation up to a 16 KB page and never frees it — driving the
  # self-hosted compiler to multi-GB RSS and non-deterministic OOM (SIGKILL).
  # _tg_bump_alloc preserves X19/X20 and leaves X21-X28 untouched, so the
  # saved pointers/lengths (X19-X23) survive the call.
  a64_bl(&mut ctx.text, "_tg_bump_alloc")

  # x0 = buf
  a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)

  # memcpy(buf, ptr_a, len_a)
  a64_mov_ri(&mut ctx.text, A64::X9, 0)
   def_label(&mut ctx.text, ".Lsc_ca")
   a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
   a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_ca_d")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X9)
   a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_ca")
  def_label(&mut ctx.text, ".Lsc_ca_d")

  # memcpy(buf + len_a, ptr_b, len_b)
  a64_mov_ri(&mut ctx.text, A64::X9, 0)
   def_label(&mut ctx.text, ".Lsc_cb")
   a64_cmp_rr(&mut ctx.text, A64::X9, A64::X22)
   a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsc_cb_d")
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X20, A64::X9)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X21)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X9)
   a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
  a64_b(&mut ctx.text, ".Lsc_cb")
  def_label(&mut ctx.text, ".Lsc_cb_d")

  # Null terminate: buf[len_a + len_b] = 0
  a64_add_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X22)
  a64_add_rrr(&mut ctx.text, A64::X9, A64::X23, A64::X9)
  a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

  # Return buf
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)

  # Epilogue
  a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
  a64_ret(&mut ctx.text)
end

def emit_str_concat_x86_64(inout ctx: CodegenCtx) -> Unit
  # Prologue: save callee-saved regs (rbx, r12-r15)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)
  x64_push(&mut ctx.text, X64::R15)

  # Save input args
  x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # ptr_a
  x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)    # ptr_b

  # strlen(ptr_a) → r13. Use rdi=ptr, rcx=counter, same encoding as codegen_strlen
  x64_mov_ri(&mut ctx.text, X64::RCX, 0)
  x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_la_d")
  def_label(&mut ctx.text, ".Lsc_la")
  # movzx eax, byte [rdi + rcx]
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x0F)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_la_d")
  x64_add_ri(&mut ctx.text, X64::RCX, 1)
  x64_jmp(&mut ctx.text, ".Lsc_la")
  def_label(&mut ctx.text, ".Lsc_la_d")
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RCX)

  # strlen(ptr_b) → r14. rdi = ptr_b
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
  x64_mov_ri(&mut ctx.text, X64::RCX, 0)
  x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_lb_d")
  def_label(&mut ctx.text, ".Lsc_lb")
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x0F)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, ".Lsc_lb_d")
  x64_add_ri(&mut ctx.text, X64::RCX, 1)
  x64_jmp(&mut ctx.text, ".Lsc_lb")
  def_label(&mut ctx.text, ".Lsc_lb_d")
  x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)

  # total = len_a + len_b + 1 → rdi (size arg for the bump allocator)
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
  x64_add_rr(&mut ctx.text, X64::RDI, X64::R14)
  x64_add_ri(&mut ctx.text, X64::RDI, 1)

  # Allocate the result from the shared bump arena (size in RDI -> ptr in RAX).
  # Previously this did a fresh mmap per concatenation, which never frees and
  # drove the self-hosted compiler to multi-GB RSS and non-deterministic OOM.
  # _tg_bump_alloc preserves RBX/R12/RBP and leaves R13-R15 untouched, so the
  # saved pointers/lengths survive the call.
  x64_call_label(&mut ctx.text, "_tg_bump_alloc")
  # rax = buf
  x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)

  # memcpy(buf, ptr_a, len_a) via rep movsb: rdi=dst, rsi=src, rcx=count
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
  emit8(&mut ctx.text, 0xF3)
  emit8(&mut ctx.text, 0xA4)

  # memcpy(buf + len_a, ptr_b, len_b): rdi already advanced by rep movsb
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  emit8(&mut ctx.text, 0xF3)
  emit8(&mut ctx.text, 0xA4)

  # Null terminate: mov byte [rdi], 0 (rdi is at buf + len_a + len_b)
  emit8(&mut ctx.text, 0xC6)
  emit8(&mut ctx.text, 0x07)
  emit8(&mut ctx.text, 0x00)

  # Return buf
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R15)
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# String Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# str_len: Get length of null-terminated string. Arg in x0/rdi, returns len in x0/rax
def codegen_str_len(inout ctx: CodegenCtx) -> Unit
  codegen_strlen(ctx)  # Same as len intrinsic
end

# str_cmp: Compare two null-terminated strings. Args in x0/rdi, x1/rsi. Returns -1, 0, or 1
def codegen_str_cmp(inout ctx: CodegenCtx) -> Unit
  let lbl_loop = ".Lstrcmp_loop." + ctx.fn_counter.to_string()
  let lbl_eq = ".Lstrcmp_eq." + ctx.fn_counter.to_string()
  let lbl_lt = ".Lstrcmp_lt." + ctx.fn_counter.to_string()
  let lbl_gt = ".Lstrcmp_gt." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrcmp_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    # x0 = a, x1 = b. Use x9, x10 as byte scratch
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_lt.clone())
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_gt.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_eq.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_lt)
    a64_mov_ri(&mut ctx.text, A64::X0, -1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_gt)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_eq)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    def_label(&mut ctx.text, lbl_loop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x0E)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::L, lbl_lt.clone())
    x64_jcc(&mut ctx.text, CC::G, lbl_gt.clone())
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_eq.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_lt)
    x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_gt)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_eq)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# starts_with: Check if null-terminated string starts with a prefix.
# Args: x0/rdi = string, x1/rsi = prefix
# Returns: 1 if string starts with prefix, 0 otherwise
def codegen_starts_with(inout ctx: CodegenCtx) -> Unit
  let lbl_loop = ".Lstw_loop." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lstw_yes." + ctx.fn_counter.to_string()
  let lbl_no = ".Lstw_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstw_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )
    # x0 = string, x1 = prefix
    def_label(&mut ctx.text, lbl_loop.clone())
    # Load prefix byte
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    # If prefix byte is 0, prefix exhausted = match!
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    # Load string byte
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    # Compare
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_no.clone())
    # Advance both pointers
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # rdi = string, rsi = prefix
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx ecx, byte [rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x0E)
    # If prefix byte is 0, match
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    # movzx eax, byte [rdi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_no.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# ends_with: Check if a null-terminated string ends with a suffix.
# Args: x0/rdi = string, x1/rsi = suffix
# Returns: 1 if string ends with suffix, 0 otherwise
def codegen_ends_with(inout ctx: CodegenCtx) -> Unit
  let lbl_len_s = ".Lew_len_s." + ctx.fn_counter.to_string()
  let lbl_len_s_done = ".Lew_len_s_done." + ctx.fn_counter.to_string()
  let lbl_len_suffix = ".Lew_len_suffix." + ctx.fn_counter.to_string()
  let lbl_len_suffix_done = ".Lew_len_suffix_done." + ctx.fn_counter.to_string()
  let lbl_cmp = ".Lew_cmp." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lew_yes." + ctx.fn_counter.to_string()
  let lbl_no = ".Lew_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lew_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X11),
      PhysReg::A64Reg(A64::X12),
      PhysReg::A64Reg(A64::X13),
      PhysReg::A64Reg(A64::X14)
    )

    a64_mov_rr(&mut ctx.text, A64::X2, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X1)

    a64_mov_rr(&mut ctx.text, A64::X4, A64::X2)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    def_label(&mut ctx.text, lbl_len_s.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X4, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_s_done.clone())
    a64_add_rri(&mut ctx.text, A64::X4, A64::X4, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lbl_len_s)

    def_label(&mut ctx.text, lbl_len_s_done)
    a64_mov_rr(&mut ctx.text, A64::X5, A64::X3)
    a64_mov_ri(&mut ctx.text, A64::X12, 0)
    def_label(&mut ctx.text, lbl_len_suffix.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X5, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_suffix_done.clone())
    a64_add_rri(&mut ctx.text, A64::X5, A64::X5, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_len_suffix)

    def_label(&mut ctx.text, lbl_len_suffix_done)
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_no.clone())
    a64_sub_rrr(&mut ctx.text, A64::X13, A64::X11, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X2, A64::X13)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)

    def_label(&mut ctx.text, lbl_cmp.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_no.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_cmp)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done.clone())

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )

    x64_mov_rr(&mut ctx.text, X64::R8, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R8)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)
    def_label(&mut ctx.text, lbl_len_s.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R10, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_s_done.clone())
    x64_add_ri(&mut ctx.text, X64::R10, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_len_s)

    def_label(&mut ctx.text, lbl_len_s_done)
    x64_mov_rr(&mut ctx.text, X64::R11, X64::R9)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_len_suffix.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R11, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_suffix_done.clone())
    x64_add_ri(&mut ctx.text, X64::R11, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_len_suffix)

    def_label(&mut ctx.text, lbl_len_suffix_done)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::G, lbl_no.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_sub_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)

    def_label(&mut ctx.text, lbl_cmp.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RSI, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::R10, X64::RDI, 0)
    x64_cmp_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_no.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_cmp)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done.clone())

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# str_find: Search for a substring within a string. Returns Option[Int].
# Args: x0/rdi = haystack, x1/rsi = needle
# Returns: pointer to {tag=0, position} if found, or 1 (None tag) if not found.
def codegen_str_find(inout ctx: CodegenCtx) -> Unit
  let lbl_outer = ".Lsf_outer." + ctx.fn_counter.to_string()
  let lbl_inner = ".Lsf_inner." + ctx.fn_counter.to_string()
  let lbl_found = ".Lsf_found." + ctx.fn_counter.to_string()
  let lbl_next = ".Lsf_next." + ctx.fn_counter.to_string()
  let lbl_none = ".Lsf_none." + ctx.fn_counter.to_string()
  let lbl_done = ".Lsf_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = &self (ptr to string ptr), x1 = needle
    # Dereference x0 to get actual string pointer
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    # Save callee-saved regs
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = haystack base
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # x20 = needle
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)    # x9 = current scan pos

    def_label(&mut ctx.text, lbl_outer.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_none.clone())

    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)    # haystack scan ptr
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X20)   # needle scan ptr

    def_label(&mut ctx.text, lbl_inner.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X12, 0)
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_found.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X11, 0)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_next.clone())
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_found)
    # Position = x9 - x19 (current pos - haystack base)
    a64_sub_rrr(&mut ctx.text, A64::X19, A64::X9, A64::X19)
    # x19 now holds position (callee-saved, survives call)
    # Allocate 16 bytes for Option struct: {tag: 0, payload: position}
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    # x0 = allocated buffer
    # Store tag = 0 (Some)
    a64_str(&mut ctx.text, A64::XZR, A64::X0, 0)
    # Store payload = position (x19 survived the call)
    a64_str(&mut ctx.text, A64::X19, A64::X0, 8)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_none)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    # rdi = &self (ptr to string ptr), rsi = needle
    # Dereference rdi to get actual string pointer
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # Save callee-saved
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # r12 = haystack base
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RSI)  # r13 = needle
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # rcx = scan pos

    def_label(&mut ctx.text, lbl_outer.clone())
    # movzx eax, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_none.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)  # haystack scan
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)   # needle scan

    def_label(&mut ctx.text, lbl_inner.clone())
    # movzx eax, byte [rdx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_found.clone())
    # movzx esi, byte [rdi] — careful, need manual encoding
    emit8(&mut ctx.text, 0x40)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x37)
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_next.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_found)
    # Position = rcx - r12 (scan pos - haystack base)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_sub_rr(&mut ctx.text, X64::RSI, X64::R12)
    # Save position in r12 (overwrite base, no longer needed; callee-saved survives call)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)
    # Allocate 16 bytes
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    # rax = buffer. Store tag=0 at [rax], payload at [rax+8]
    # mov qword [rax], 0
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0xC7)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    # mov [rax+8], r12
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x60)
    emit8(&mut ctx.text, 0x08)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_none)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)

    def_label(&mut ctx.text, lbl_done)
  end
end

# string_contains: Check if null-terminated string contains a substring.
# Args: x0/rdi = haystack, x1/rsi = needle
# Returns: 1 if found, 0 otherwise
def codegen_string_contains(inout ctx: CodegenCtx) -> Unit
  let lbl_outer = ".Lsc_outer." + ctx.fn_counter.to_string()
  let lbl_inner = ".Lsc_inner." + ctx.fn_counter.to_string()
  let lbl_yes = ".Lsc_yes." + ctx.fn_counter.to_string()
  let lbl_next = ".Lsc_next." + ctx.fn_counter.to_string()
  let lbl_no = ".Lsc_no." + ctx.fn_counter.to_string()
  let lbl_done = ".Lsc_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::A64Reg(A64::X0),
      PhysReg::A64Reg(A64::X14),
      PhysReg::A64Reg(A64::X15),
      PhysReg::A64Reg(A64::X16),
      PhysReg::A64Reg(A64::X17)
    )
    # x0 = haystack, x1 = needle
    # x9 = haystack position pointer
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)

    def_label(&mut ctx.text, lbl_outer.clone())
    # Check if we've reached end of haystack
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_no.clone())

    # Try to match needle starting at x9
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)   # haystack scan ptr
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X1)   # needle scan ptr

    def_label(&mut ctx.text, lbl_inner.clone())
    # Load needle byte
    a64_ldrb(&mut ctx.text, A64::X13, A64::X12, 0)
    # If needle byte is 0, full match!
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_yes.clone())
    # Load haystack byte
    a64_ldrb(&mut ctx.text, A64::X10, A64::X11, 0)
    # Compare
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_next.clone())
    # Match, advance both
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    # No match at this position, advance haystack
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_yes)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    maybe_load_string_data_ptr(
      ctx,
      PhysReg::X64Reg(X64::RDI),
      PhysReg::X64Reg(X64::R8),
      PhysReg::X64Reg(X64::R9),
      PhysReg::X64Reg(X64::R10),
      PhysReg::X64Reg(X64::R11)
    )
    # rdi = haystack, rsi = needle
    # Use rcx as haystack position
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)

    def_label(&mut ctx.text, lbl_outer.clone())
    # movzx eax, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_no.clone())

    # Try match at rcx
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)   # haystack scan
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)   # needle scan

    def_label(&mut ctx.text, lbl_inner.clone())
    # movzx eax, byte [rdx]  (needle)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_yes.clone())
    # movzx r8d, byte [rdi]  (haystack)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    # cmp r8, rax
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x39)
    emit8(&mut ctx.text, 0xC0)
    x64_jcc(&mut ctx.text, CC::NE, lbl_next.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, lbl_inner)

    def_label(&mut ctx.text, lbl_next)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_outer)

    def_label(&mut ctx.text, lbl_yes)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lbl_done)

    def_label(&mut ctx.text, lbl_no)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lbl_done)
  end
end

# str_copy: Copy string from src to dst. Args: dst=x0/rdi, src=x1/rsi
def codegen_str_copy(inout ctx: CodegenCtx) -> Unit
  let lbl_loop = ".Lstrcpy_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lstrcpy_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = dst (save in x9), x1 = src
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_strb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)

  when Arch::X86_64 then
    # rdi = dst (save in rcx), rsi = src
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx eax, byte [rsi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)
    # mov [rcx], al
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x01)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
  end
end

# (the owned slice): the old inline `codegen_str_slice` raw-buffer
# emitter (allocate len+1 bytes, copy, NUL-terminate, return the raw byte
# pointer) is not part of the model. String::slice / str::slice delegate to the runtime
# helper _tg_string_slice (runtime.tg, both arches), which computes the
# substring, allocates the OWNED String object (header + buffer), copies
# the bytes, NUL-terminates, and returns the OBJECT HANDLE — a function
# returning String always returns the owned-object handle.

# int_to_str: Convert integer to string. Arg in x0/rdi, returns an OWNED
# String object (the String ABI — the raw buffer is wrapped).
def codegen_int_to_str(inout ctx: CodegenCtx) -> Unit
  # Call runtime function _tg_int_to_str
  emit_call_label(ctx, "_tg_int_to_str")
  codegen_string_wrap_result(ctx)
end

def codegen_bool_to_str(inout ctx: CodegenCtx) -> Unit
  let rr = ret_reg(ctx.target.arch)
  let lbl_true = next_codegen_label(ctx, ".Lbool_to_str_true.")
  let lbl_done = next_codegen_label(ctx, ".Lbool_to_str_done.")
  let true_label = intern_string(ctx, &"true")
  let false_label = intern_string(ctx, &"false")

  emit_test_rr(ctx, rr, rr)
  emit_jcc(ctx, CondKind::Ne, lbl_true.clone())
  emit_lea_label(ctx, rr, false_label)
  emit_jmp(ctx, lbl_done.clone())
  def_label(&mut ctx.text, lbl_true)
  emit_lea_label(ctx, rr, true_label)
  def_label(&mut ctx.text, lbl_done)
 # the interned static label (the static StaticStrPtr) becomes an
  # OWNED String object.
  codegen_string_wrap_result(ctx)
end
def codegen_char_to_str(inout ctx: CodegenCtx) -> Unit
  let lbl_ascii = next_codegen_label(ctx, ".Lchar_to_str_ascii.")
  let lbl_two = next_codegen_label(ctx, ".Lchar_to_str_two.")
  let lbl_three = next_codegen_label(ctx, ".Lchar_to_str_three.")
  let lbl_packed = next_codegen_label(ctx, ".Lchar_to_str_packed.")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = Unicode code point. Pack its UTF-8 bytes into x1 so a single
    # 64-bit store yields a null-terminated string in little-endian memory.
    a64_cmp_ri(&mut ctx.text, A64::X0, 0x7F)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_ascii.clone())
    a64_cmp_ri(&mut ctx.text, A64::X0, 0x7FF)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_two.clone())
    a64_mov_ri(&mut ctx.text, A64::X15, 0xFFFF)
    a64_cmp_rr(&mut ctx.text, A64::X0, A64::X15)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_three.clone())

    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 18)
    a64_and_ri(&mut ctx.text, A64::X1, 0x07)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xF0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 12)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 24)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 12)
    a64_and_ri(&mut ctx.text, A64::X1, 0x0F)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xE0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_lsr(&mut ctx.text, A64::X1, A64::X1, 6)
    a64_and_ri(&mut ctx.text, A64::X1, 0x1F)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 0xC0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X0)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X15)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)

    # All branches packed UTF-8 bytes into X1. Allocate 8-byte buffer, store, return ptr.
    def_label(&mut ctx.text, lbl_packed)
    a64_stp_pre(&mut ctx.text, A64::X1, A64::XZR, A64::SP, -16)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    emit_call_label(ctx, "_tg_bump_alloc")
    a64_ldp_post(&mut ctx.text, A64::X1, A64::XZR, A64::SP, 16)
    a64_stur(&mut ctx.text, A64::X1, A64::X0, 0)
 # the packed UTF-8 buffer becomes an OWNED String object.
    codegen_string_wrap_result(ctx)

  when Arch::X86_64 then
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x7F)
    x64_jcc(&mut ctx.text, CC::LE, lbl_ascii.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x7FF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_two.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0xFFFF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_three.clone())

    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 18)
    x64_and_ri(&mut ctx.text, X64::R11, 0x07)
    x64_add_ri(&mut ctx.text, X64::R11, 0xF0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 24)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 12)
    x64_and_ri(&mut ctx.text, X64::R11, 0x0F)
    x64_add_ri(&mut ctx.text, X64::R11, 0xE0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_shr_ri(&mut ctx.text, X64::R11, 6)
    x64_and_ri(&mut ctx.text, X64::R11, 0x1F)
    x64_add_ri(&mut ctx.text, X64::R11, 0xC0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R11, X64::R10)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    x64_mov_rr(&mut ctx.text, X64::R11, X64::RAX)

    def_label(&mut ctx.text, lbl_packed)
    x64_xor_rr(&mut ctx.text, X64::R10, X64::R10)
    emit_push(ctx, PhysReg::X64Reg(X64::R10))
    emit_push(ctx, PhysReg::X64Reg(X64::R11))
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    emit_call_label(ctx, "_tg_bump_alloc")
    emit_pop(ctx, PhysReg::X64Reg(X64::R11))
    emit_pop(ctx, PhysReg::X64Reg(X64::R10))
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::R11)
 # the packed UTF-8 buffer becomes an OWNED String object.
    codegen_string_wrap_result(ctx)
  end
end


# float_to_str: Convert float to string. Arg in x0/rdi (float bits),
# returns an OWNED String object (the String ABI — the raw buffer is
# wrapped).
def codegen_float_to_str(inout ctx: CodegenCtx) -> Unit
  # Call runtime function _tg_float_to_str
  emit_call_label(ctx, "_tg_float_to_str")
  codegen_string_wrap_result(ctx)
end

# str_to_int: Parse string to integer. Arg in x0/rdi.
# Returns a heap-allocated Option[Int]::Some(value) pointer in x0/rax,
# matching the `parse_int(...) -> Option[Int]` source-level contract.
# Layout of the Option heap cell: { disc: Int (0=Some), payload: Int } (16 bytes).
def codegen_str_to_int(inout ctx: CodegenCtx) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let scratch = scratch_reg(arch)
  # Call runtime function _tg_str_to_int → raw int in rr.
  emit_call_label(ctx, "_tg_str_to_int")
  # Save parsed value across the bump_alloc call.
  emit_push(ctx, rr)
  # arg0 = 16 bytes
  match arg_reg(arch, 0)
  when Option::Some(a0) then emit_mov_ri(ctx, a0, 16)
  when Option::None then ()
  end
  emit_call_label(ctx, "_tg_bump_alloc")  # rr = heap pointer
  # Restore parsed value into scratch.
  emit_pop(ctx, scratch)
  # Zero the discriminant slot (Some = 0). Use a separate temporary register
  # so we don't clobber scratch before storing the payload.
  let zero_r = match arg_reg(arch, 1)
    when Option::Some(r) then r
    when Option::None then scratch
    end
  emit_mov_ri(ctx, zero_r, 0)
  emit_store_mem(ctx, rr, 0, zero_r)      # disc = 0 (Some)
  emit_store_mem(ctx, rr, 8, scratch)     # payload = parsed value
end

# str_to_float: Parse string to float. Arg in x0/rdi, returns float bits in x0/rax
def codegen_str_to_float(inout ctx: CodegenCtx) -> Unit
  # Call runtime function _tg_str_to_float
  emit_call_label(ctx, "_tg_str_to_float")
end

# ———————————————————————————————————————————————————————————————
# Runtime String chars()
# ———————————————————————————————————————————————————————————————
#
# _tg_str_chars: Convert null-terminated string to Vec[Char] (the standard
# 32-byte Vec header: {data:0, len:8, cap:16, stride:24}, stride = 4).
# ABI: x0/rdi = &self (pointer to string pointer)
# Returns: pointer to the Vec header; elements at data + i*4.
#
# With ProjDeref+ProjIndex iteration:
#   MirLen reads [ptr+8] = len
#   ProjDeref reads [ptr+0] = data_ptr
#   ProjIndex reads *(data_ptr + idx*4) with W32 load (Char stride)

def emit_runtime_str_chars(inout ctx: CodegenCtx) -> Unit
  def_label(&mut ctx.text, "_tg_str_chars")
  match ctx.target.arch
  when Arch::AArch64 then emit_str_chars_aarch64(ctx)
  when Arch::X86_64  then emit_str_chars_x86_64(ctx)
  end
end

def emit_str_chars_aarch64(inout ctx: CodegenCtx) -> Unit
  let lbl_strlen   = ".Lchars_strlen." + ctx.fn_counter.to_string()
  let lbl_done_len = ".Lchars_done_len." + ctx.fn_counter.to_string()
  let lbl_copy     = ".Lchars_copy." + ctx.fn_counter.to_string()
  let lbl_copy_end = ".Lchars_copy_end." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  let os = ctx.target.os
  # The internal char-Vec buffer is the HeapVecHeader row of the engine's F2
  # table: repr_header_size 32 ({data:0, len:8, cap:16, stride:24}), stride 4
  # (Char). Elements are 4-byte zero-extended chars at data + i*4.
  let hdr_size = repr_header_size(Repr::HeapVecHeader) as u32
  let hdr_data_off = heap_header_field_offset(Repr::HeapVecHeader, &"data".to_string()) as u32
  let hdr_len_off = heap_header_field_offset(Repr::HeapVecHeader, &"len".to_string()) as u32
  let hdr_cap_off = heap_header_field_offset(Repr::HeapVecHeader, &"cap".to_string()) as u32
  let hdr_stride_off = heap_header_field_offset(Repr::HeapVecHeader, &"stride".to_string()) as u32

  # Prologue
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

  # Dereference &self to get string data pointer
  a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)

  # strlen(x19) → x20
  a64_mov_ri(&mut ctx.text, A64::X20, 0)
   def_label(&mut ctx.text, lbl_strlen.clone())
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X20)
   a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
   a64_cmp_ri(&mut ctx.text, A64::X11, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done_len.clone())
  a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
  a64_b(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())

  # Allocate via inline mmap: hdr_size (header) + len * 4 (data, Char stride)
  a64_lsl(&mut ctx.text, A64::X1, A64::X20, 2)
  a64_add_rri(&mut ctx.text, A64::X1, A64::X1, hdr_size)
  a64_mov_ri(&mut ctx.text, A64::X0, 0)
  a64_mov_ri(&mut ctx.text, A64::X2, 3)    # PROT_READ|PROT_WRITE
  match os
  when OsAbi::MacOS then
    a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X16, 197)
    a64_svc(&mut ctx.text, 0x80)
  when OsAbi::Linux then
    a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X8, 222)
    a64_svc(&mut ctx.text, 0)
  when _ then
    a64_brk(&mut ctx.text, 1)
  end
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

  # Header: data_ptr = buf + hdr_size, len, cap, stride (offsets from engine)
  a64_add_rri(&mut ctx.text, A64::X9, A64::X21, hdr_size)
  a64_str(&mut ctx.text, A64::X9, A64::X21, hdr_data_off)
  a64_str(&mut ctx.text, A64::X20, A64::X21, hdr_len_off)
  a64_str(&mut ctx.text, A64::X20, A64::X21, hdr_cap_off)
  a64_mov_ri(&mut ctx.text, A64::X12, 4)  # Char stride
  a64_str(&mut ctx.text, A64::X12, A64::X21, hdr_stride_off)

  # Copy: for i in 0..len → data[i*4] = string[i] (W32 zero-extended)
  a64_mov_ri(&mut ctx.text, A64::X22, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copy_end.clone())
   a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
   a64_ldrb(&mut ctx.text, A64::X12, A64::X10, 0)
   a64_lsl(&mut ctx.text, A64::X11, A64::X22, 2)
   a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X11)
   a64_str_w(&mut ctx.text, A64::X12, A64::X11, 0)
  a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
  a64_b(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return buffer
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

  # Epilogue
  a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
  a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
  a64_ret(&mut ctx.text)
end

def emit_str_chars_x86_64(inout ctx: CodegenCtx) -> Unit
  let lbl_strlen   = ".Lchars_strlen." + ctx.fn_counter.to_string()
  let lbl_done_len = ".Lchars_done_len." + ctx.fn_counter.to_string()
  let lbl_copy     = ".Lchars_copy." + ctx.fn_counter.to_string()
  let lbl_copy_end = ".Lchars_copy_end." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  let os = ctx.target.os
  # The internal char-Vec buffer is the HeapVecHeader row of the engine's F2
  # table: repr_header_size 32 ({data:0, len:8, cap:16, stride:24}), stride 4
  # (Char). Elements are 4-byte zero-extended chars at data + i*4.
  let hdr_size = repr_header_size(Repr::HeapVecHeader) as i32
  let hdr_len_off = heap_header_field_offset(Repr::HeapVecHeader, &"len".to_string()) as i32
  let hdr_cap_off = heap_header_field_offset(Repr::HeapVecHeader, &"cap".to_string()) as i32
  let hdr_stride_off = heap_header_field_offset(Repr::HeapVecHeader, &"stride".to_string()) as i32

  # Prologue
  x64_push(&mut ctx.text, X64::RBP)
  x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)

  # Deref &self
  x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)

  # strlen
  x64_mov_ri(&mut ctx.text, X64::R12, 0)
  def_label(&mut ctx.text, lbl_strlen.clone())
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x23)
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, lbl_done_len.clone())
  x64_add_ri(&mut ctx.text, X64::R12, 1)
  x64_jmp(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())

  # Allocate via inline mmap: hdr_size + r12*4 (Char stride)
  x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
  x64_shl_ri(&mut ctx.text, X64::RSI, 2)
  x64_add_ri(&mut ctx.text, X64::RSI, hdr_size)
  x64_mov_ri(&mut ctx.text, X64::RDI, 0)    # addr = 0
  x64_mov_ri(&mut ctx.text, X64::RDX, 3)    # PROT_RW
  match os
  when OsAbi::Linux then
    x64_mov_ri(&mut ctx.text, X64::R10, 0x22) # MAP_PRIVATE|MAP_ANON
    x64_mov_ri(&mut ctx.text, X64::R8, -1)
    x64_mov_ri(&mut ctx.text, X64::R9, 0)
    x64_mov_ri(&mut ctx.text, X64::RAX, 9)    # __NR_mmap
    x64_syscall(&mut ctx.text)
  when _ then
    x64_ud2(&mut ctx.text)
  end
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

  # Header (offsets from the engine)
  x64_lea_mem(&mut ctx.text, X64::RCX, X64::R13, hdr_size)
  x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RCX)
  x64_mov_mr(&mut ctx.text, X64::R13, hdr_len_off, X64::R12)
  x64_mov_mr(&mut ctx.text, X64::R13, hdr_cap_off, X64::R12)
  x64_mov_ri(&mut ctx.text, X64::RCX, 4)  # Char stride
  x64_mov_mr(&mut ctx.text, X64::R13, hdr_stride_off, X64::RCX)

  # Copy
  x64_mov_ri(&mut ctx.text, X64::R14, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
  x64_jcc(&mut ctx.text, CC::GE, lbl_copy_end.clone())
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x33)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  x64_shl_ri(&mut ctx.text, X64::RCX, 2)
  x64_add_rr(&mut ctx.text, X64::RCX, X64::R13)
  x64_mov_m32_r32(&mut ctx.text, X64::RCX, hdr_size, X64::RAX)
  x64_add_ri(&mut ctx.text, X64::R14, 1)
  x64_jmp(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_pop(&mut ctx.text, X64::RBP)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# Array/Vec Intrinsic Implementations
# ———————————————————————————————————————————————————————————————
#
# Vec[T] memory layout (32 bytes — the HeapVecHeader row of the engine's F2
# table, repr_header_size(Repr::HeapVecHeader); field offsets from
# container_field_offset):
#   offset 0: ptr    - pointer to data buffer
#   offset 8: len    - current length (number of elements)
#   offset 16: cap   - capacity (allocated element slots)
#   offset 24: stride - element stride in bytes; set at creation from the
#                      CONCRETE element type (element_stride_bytes(T) —
#                      category-derived, so stride == size_of(T) for every
#                      aggregate) and read by every _tg_array_* helper for
#                      element addresses (data + i*stride), allocation
#                      sizes (cap*stride) AND the element TRANSFER size
#                      (the category-driven byte-copy length).
#
# THE UNIFIED TRANSFER RULE: for an element of concrete type T the
# collection intrinsic's element transfer uses T's value category
# (classify_value_category — the layout engine's single authority):
#   ZeroSized        -> nothing is copied (stride 0)
#   Scalar(width)    -> the VALUE WORD in the register, stored/loaded at
#                       the width (the runtime width dispatch, 1/2/4/8)
#   ScalarPair       -> the 16-byte image ADDRESS in the register; the
#                       runtime byte-copies the full image
#   ByAddress(size)  -> the image ADDRESS in the register; the runtime
#                       byte-copies the complete image (size bytes)
# The CALLER side (the arms below) therefore normalizes the element slot
# per category: Scalar -> the value word (a Place arg crossed by ADDRESS in
# the generic call-arg setup, so the value is loaded from the place);
# ScalarPair/ByAddress -> the element image ADDRESS (Place args already
# carry it; Value operands carry the first word — the address of the
# materialized image is re-derived via emit_place_address). The receiver's
# vec handle is re-derived after the normalization (the normalization may
# clobber x0/rax through projected-place addressing).
#
# The vec pointer itself is passed in arg0 (x0/rdi)

# The element-arg normalization for the collection intrinsics: `arg_idx` is
# the element's MirCallArg index, `slot` the ABI register the runtime reads.
def codegen_collection_elem_transfer_arg(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg], arg_idx: Int, slot: PhysReg) -> Unit
  if args.len() <= arg_idx then
    panic("internal error: collection intrinsic element arg " + arg_idx.to_string() + " missing at the call site")
  end
  let elem_ty = mir_call_arg_type(ctx, fctx, &args[arg_idx])
  match classify_value_category(&mut ctx.layout_engine, &elem_ty)
  when Result::Err(e) then
    panic("ICE: collection element transfer classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then
      # Nothing transfers (stride 0); the slot content is irrelevant.
      ()
    when ValueCategory::Scalar(_) then
      # The value word must be in the slot: a Place arg crossed by ADDRESS
      # (the generic call-arg setup) — load the value from the place.
      match args[arg_idx].value
      when MirCallValue::Place(p) then load_place(ctx, fctx, p, slot)
      when MirCallValue::Value(_) then ()
      end
    when ValueCategory::ScalarPair(_, _) then
      codegen_collection_elem_image_addr(ctx, fctx, args, arg_idx, slot)
    when ValueCategory::Vector(_) then
      # THE VECTOR CASE: a SIMD vector element — the image ADDRESS
      # convention, exactly like the other aggregate forms.
      codegen_collection_elem_image_addr(ctx, fctx, args, arg_idx, slot)
    when ValueCategory::ByAddress(_) then
      codegen_collection_elem_image_addr(ctx, fctx, args, arg_idx, slot)
    end
  end
end

# The ScalarPair/ByAddress element-arg convention: the slot must hold the
# element IMAGE ADDRESS. A Place arg already carries it (the generic setup);
# a place-carrying Value operand (the MIR materializes aggregate operands as
# stack temps) has its address re-derived; an aggregate CONSTANT operand is
# a lowering bug and fails closed.
def codegen_collection_elem_image_addr(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg], arg_idx: Int, slot: PhysReg) -> Unit
  match args[arg_idx].value
  when MirCallValue::Place(p) then ()
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirCopy(p) then emit_place_address(ctx, fctx, p, slot)
    when MirOperandKind::MirMovePlace(p) then emit_place_address(ctx, fctx, p, slot)
    when MirOperandKind::MirRead(p) then emit_place_address(ctx, fctx, p, slot)
    when MirOperandKind::MirConsume(p) then emit_place_address(ctx, fctx, p, slot)
    when MirConstant(_) then
      panic("internal error: aggregate collection element is a constant operand — the MIR must materialize aggregates as stack temps")
    end
  end  end
end

# The operand form of the element-arg convention (the heap-vector array
# literal loop, which builds through _tg_array_push): Scalar -> the value
# word; ScalarPair/ByAddress -> the element image ADDRESS.
def codegen_collection_elem_transfer_operand(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, elem_ty: Type, op: MirOperand, slot: PhysReg) -> Unit
  match classify_value_category(&mut ctx.layout_engine, elem_ty)
  when Result::Err(e) then
    panic("ICE: collection element transfer classification failed closed for type '" + e.type_name + "': " + layout_error_to_string(&e))
  when Result::Ok(cat) then
    match cat
    when ValueCategory::ZeroSized then
      # Nothing transfers (stride 0); the slot content is irrelevant.
      ()
    when ValueCategory::Scalar(_) then
      load_operand_aggregate_item(ctx, fctx, op, slot)
    when ValueCategory::ScalarPair(_, _) then
      match op.kind
      when MirOperandKind::MirCopy(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirMovePlace(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirRead(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirConsume(p) then emit_place_address(ctx, fctx, p, slot)
      when MirConstant(_) then
        panic("internal error: aggregate collection element is a constant operand — the MIR must materialize aggregates as stack temps")
      end
    when ValueCategory::Vector(_) then
      # THE VECTOR CASE: a SIMD vector element — the image ADDRESS
      # convention, exactly like the other aggregate forms.
      match op.kind
      when MirOperandKind::MirCopy(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirMovePlace(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirRead(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirConsume(p) then emit_place_address(ctx, fctx, p, slot)
      when MirConstant(_) then
        panic("internal error: aggregate collection element is a constant operand — the MIR must materialize aggregates as stack temps")
      end
    when ValueCategory::ByAddress(_) then
      match op.kind
      when MirOperandKind::MirCopy(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirMovePlace(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirRead(p) then emit_place_address(ctx, fctx, p, slot)
      when MirOperandKind::MirConsume(p) then emit_place_address(ctx, fctx, p, slot)
      when MirConstant(_) then
        panic("internal error: aggregate collection element is a constant operand — the MIR must materialize aggregates as stack temps")
      end
    end
  end  end
end

# Re-derive the receiver's vec handle in the ARG0 ABI register (x0 on
# AArch64, RDI on x86-64 — the register the runtime helpers read): the
# generic call-arg setup left the &Vec ref word in arg0 (Value receiver
# operands — the only receiver form the MIR produces); ONE deref reaches
# the 32-byte header. The deref must target arg0 — ret_reg would be RAX
# on x86-64 while every _tg_array_* helper reads RDI.
def codegen_collection_receiver_deref(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  match arg_reg(ctx.target.arch, 0)
  when Option::Some(r0) then
    load_call_arg_value(ctx, fctx, &args[0], r0)
    emit_load_mem(ctx, r0, r0, 0)
  when Option::None then
    panic("codegen_collection_receiver_deref: no arg0 ABI register")
  end  end
end

# array_new: Create empty Vec with capacity 0. Returns ptr to vec struct.
def codegen_array_new(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_new")
end

# array_push: Append element to vec. Args: vec_ptr, element (per category).
def codegen_array_push(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let arch = ctx.target.arch
  let elem_slot = match arg_reg(arch, 1)
  when Option::Some(r) then r
  when Option::None then panic("codegen_array_push: no element ABI slot register")
  end
  codegen_collection_elem_transfer_arg(ctx, fctx, args, 1, elem_slot)
  codegen_collection_receiver_deref(ctx, fctx, args)
  emit_call_label(ctx, "_tg_array_push")
end

# array_pop: Remove and return the last element. Args: vec_ptr.
# The runtime returns the popped element's IMAGE ADDRESS (0 when empty):
#   - Scalar (stride <= 8): the in-buffer slot address — the width-aware
#     codegen_option_payload_wrap loads the value word from it immediately;
#   - ScalarPair/ByAddress (stride > 8): the address of a fresh bump copy
#     of the FULL image — the wrap's payload is that address.
# The arm constructs the complete Option[T] TaggedPtr word with
# codegen_option_payload_wrap (the same wrap the map ops use) — the
# runtime NEVER returns a raw element word for a non-empty pop.
def codegen_array_pop(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_pop")
end

# The CHECKED ArrayGet path (the std's defined OOB policy — panic on
# out-of-range): arg0 = the vec handle (x0/rdi), arg1 = index (x1/rsi).
# index >= len traps BEFORE the runtime primitive runs; then the UNCHECKED
# address accessor _tg_array_get computes data + index*stride and the arm
# materializes the element per its ValueCategory:
#   - ZeroSized: zero word;
#   - Scalar(w): the width-matched value word is loaded from the address
#     (the complete T in the return register — the general call machinery
#     stores it);
#   - ScalarPair/ByAddress: the FULL element image is byte-copied from the
#     address into the destination place (codegen_array_image_to_dest —
#     the arm reports the full store so the post-call register store is
#     suppressed).
def codegen_array_get_checked(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  let lbl_ok = next_codegen_label(ctx, ".Larray_get_ok.")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X2, A64::X0, len_off as i32)  # len
    a64_cmp_rr(&mut ctx.text, A64::X1, A64::X2)                # index vs len
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_ok.clone())
    emit_trap(ctx)  # OOB: panic (defined std policy)
    def_label(&mut ctx.text, lbl_ok)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)  # len
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)                  # index vs len
    x64_jcc(&mut ctx.text, CC::L, lbl_ok.clone())
    emit_trap(ctx)  # OOB: panic (defined std policy)
    def_label(&mut ctx.text, lbl_ok)
  end
  emit_call_label(ctx, "_tg_array_get")
end

# Copy the FULL element image (size bytes) from the address in the return
# register (rr) to the destination place. Mirrors emit_aggregate_value_copy
# (8-byte chunks + 4/2/1-byte tails) but takes REGISTERS: rr = the image
# source address, dst = the destination address. Uses scratch (x15/r11) as
# the data register — never clobbers rr.
def codegen_array_image_to_dest(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, dest: Place, size: Int) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let t1 = scratch2_reg(arch)   # x14 / r10 — the destination address
  let data = scratch_reg(arch)  # x15 / r11 — the byte temp
  emit_place_address(ctx, fctx, dest, t1)
  var copied = 0
  while size - copied >= 8 do
    emit_load_mem(ctx, data, rr, copied as i32)
    emit_store_mem(ctx, t1, copied as i32, data)
    copied = copied + 8
  end
  if size - copied >= 4 then
    emit_load_mem_sized(ctx, data, rr, copied as i32, MemWidth::W32, Extension::Zero)
    emit_add_ri(ctx, t1, copied as i32)
    emit_store_mem_sized(ctx, t1, 0, data, MemWidth::W32)
    copied = copied + 4
  end
  if size - copied >= 2 then
    emit_load_mem_sized(ctx, data, rr, copied as i32, MemWidth::W16, Extension::Zero)
    emit_add_ri(ctx, t1, copied as i32)
    emit_store_mem_sized(ctx, t1, 0, data, MemWidth::W16)
    copied = copied + 2
  end
  if size - copied >= 1 then
    emit_load_mem_sized(ctx, data, rr, copied as i32, MemWidth::W8, Extension::Zero)
    emit_add_ri(ctx, t1, copied as i32)
    emit_store_mem_sized(ctx, t1, 0, data, MemWidth::W8)
    copied = copied + 1
  end
end

# array_set: Set element at index. Args: vec_ptr, index, element (per category).
def codegen_array_set(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let arch = ctx.target.arch
  let elem_slot = match arg_reg(arch, 2)
  when Option::Some(r) then r
  when Option::None then panic("codegen_array_set: no element ABI slot register")
  end
  codegen_collection_elem_transfer_arg(ctx, fctx, args, 2, elem_slot)
  codegen_collection_receiver_deref(ctx, fctx, args)
  emit_call_label(ctx, "_tg_array_set")
end

# ———————————————————————————————————————————————————————————————
# RAW UnsafeSlice view ops (the explicit unsafe/FFI two-field view model)
# ———————————————————————————————————————————————————————————————
# UnsafeSlice[T] = { ptr: Ptr[T] @ 0, len: UInt @ 8 } — the RAW 16-byte
# inline VIEW (layout_engine's slice_view_layout; field offsets from
# slice_view_field_offset) — the explicit unsafe/FFI form. Every raw-view
# operation is a VIEW operation:
#   - the receiver arrives in arg0 (x0/rdi) as the &UnsafeSlice borrow —
#     the ADDRESS of the view value, never a heap-header handle;
#   - len reads [base + 8];
#   - element i lives at ptr + i * size_of(T) — the element stride and
#     width come from the layout engine (no fixed 8);
#   - an UnsafeSlice value is NEVER read through HeapVecHeader offsets.
# The SAFE source-spelled Slice is the std-declared shared struct — its
# operations (len/get/sub/first/last) compile as its std methods, which
# deref the Arc handle to the 24-byte pinned backing {ptr@0, len@8,
# offset@16} (slice_shared_backing_layout). These raw-view emitters never
# see it.

# view len: arg0 = view base address; return [base + len_off].
def codegen_slice_len(inout ctx: CodegenCtx) -> Unit
  let len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
  end
end

# view is_empty: arg0 = view base address; return [base + len_off] == 0.
def codegen_slice_is_empty(inout ctx: CodegenCtx) -> Unit
  let len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    emit_setcc(ctx, CondKind::Eq, PhysReg::A64Reg(A64::X0))
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    emit_setcc(ctx, CondKind::Eq, PhysReg::X64Reg(X64::RAX))
  end
end

# view get: arg0 = view base address, arg1 = index (ABI regs). The element
# address is ptr + index * size_of(T): ptr = [base + 0], the index is scaled
# by the element's layout stride, and the element is loaded with its layout
# width/signedness.
def codegen_slice_get(inout ctx: CodegenCtx, elem_ty: Type) -> Unit
  let idx_reg = match arg_reg(ctx.target.arch, 1)
  when Option::Some(r) then r
  when Option::None then panic("codegen_slice_get: no second ABI arg register")
  end
  let rr = ret_reg(ctx.target.arch)
  # rr (arg0) = view base; load the view's ptr field into rr.
  emit_load_mem(ctx, rr, rr, 0)
  # Scale the index by the element's TRUE layout stride (the same authority
  # the runtime reads from the Vec header).
  let elem_stride = element_stride_bytes(ctx, elem_ty)
  emit_scale_index(ctx, idx_reg, elem_stride)
  emit_add_rrr(ctx, rr, rr, idx_reg)
  let ewidth = storage_width_of(ctx, elem_ty)
  let eext = storage_signedness_of(elem_ty)
  emit_load_mem_sized(ctx, rr, rr, 0, ewidth, eext)
end

# view first: arg0 = view base; result = [ptr] (or 0 for an empty view).
def codegen_slice_first(inout ctx: CodegenCtx, elem_ty: Type) -> Unit
  let ptr_off = slice_view_field_offset(&ctx.layout_engine, &"ptr".to_string())
  let len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
  let lbl_empty = ".Lslice_first_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, len_off as i32)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, ptr_off as i32)
    let ewidth = storage_width_of(ctx, elem_ty)
    let eext = storage_signedness_of(elem_ty)
    emit_load_mem_sized(ctx, PhysReg::A64Reg(A64::X0), PhysReg::A64Reg(A64::X0), 0, ewidth, eext)
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, ptr_off as i32)
    let ewidth2 = storage_width_of(ctx, elem_ty)
    let eext2 = storage_signedness_of(elem_ty)
    emit_load_mem_sized(ctx, PhysReg::X64Reg(X64::RAX), PhysReg::X64Reg(X64::RAX), 0, ewidth2, eext2)
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# view last: arg0 = view base; result = [ptr + (len-1) * size_of(T)] (or 0
# for an empty view).
def codegen_slice_last(inout ctx: CodegenCtx, elem_ty: Type) -> Unit
  let ptr_off = slice_view_field_offset(&ctx.layout_engine, &"ptr".to_string())
  let len_off = slice_view_field_offset(&ctx.layout_engine, &"len".to_string())
  let lbl_empty = ".Lslice_last_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, len_off as i32)   # len
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X2, A64::X0, ptr_off as i32)   # ptr
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    # Scale (len-1) by the element's TRUE layout stride — the single
    # codegen-side element-index scaler (1/2/4/8 shifts, multiply for any
    # other stride — e.g. a Slice[FixedArray[T, N]] element).
    emit_scale_index(ctx, PhysReg::A64Reg(A64::X1), elem_stride)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X2, A64::X1)
    let ewidth = storage_width_of(ctx, elem_ty)
    let eext = storage_signedness_of(elem_ty)
    emit_load_mem_sized(ctx, PhysReg::A64Reg(A64::X0), PhysReg::A64Reg(A64::X0), 0, ewidth, eext)
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)  # len
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    # Scale (len-1) by the element's TRUE layout stride — the single
    # codegen-side element-index scaler (1/2/4/8 shifts, multiply for any
    # other stride — e.g. a Slice[FixedArray[T, N]] element).
    let elem_stride2 = element_stride_bytes(ctx, elem_ty)
    emit_scale_index(ctx, PhysReg::X64Reg(X64::RAX), elem_stride2)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, ptr_off as i32)  # ptr
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    let ewidth2 = storage_width_of(ctx, elem_ty)
    let eext2 = storage_signedness_of(elem_ty)
    emit_load_mem_sized(ctx, PhysReg::X64Reg(X64::RAX), PhysReg::X64Reg(X64::RAX), 0, ewidth2, eext2)
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# Copy a whole RAW UnsafeSlice view value (16 bytes: {ptr, len}) from one
# plain raw-view place to another. The single-register machinery only moves
# 8 bytes, which would copy the ptr word and leave the len word stale — the
# view needs both words. Both places must be plain raw-view locals/params
# (no projections).
# Whole-value aggregate copy — the move/copy emitter for non-scalar value
# categories (asked of classify_value_category by the MirMove lowering):
#   - ScalarPair (16 bytes — the raw UnsafeSlice view { ptr @ 0, len @ 8 }
#     and other 16-byte aggregates): both words are copied. For the raw
#     view this is byte-identical to the former name-based
#     emit_slice_value_copy; the single-register path would copy only the
#     ptr word and leave len stale.
#   - ByAddress (>16-byte inline aggregates — fixed arrays, large structs):
#     the full layout byte size is copied in 8-byte chunks plus 4/2/1-byte
#     tails (the same shape the sret epilogue uses) — a 40-byte value is
#     copied as 40 bytes, never as one eight-byte word.
# The addresses come from emit_place_address (which walks projections and
# synthesizes a slot for register-homed places); both aggregate categories
# are always stack-homed by allocate_locals (force_stack for >8-byte
# locals/params), so the plain-lea path dominates.
def emit_aggregate_value_copy(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, src: Place, dst: Place, size: Int) -> Unit
  let t0 = scratch_reg(ctx.target.arch)    # x15 / r11 — src base
  let t1 = scratch2_reg(ctx.target.arch)   # x14 — dst base
  let data = ret_reg(ctx.target.arch)      # x0 / rax
  emit_place_address(ctx, fctx, src, t0)
  emit_place_address(ctx, fctx, dst, t1)
  var copied = 0
  while size - copied >= 8 do
    emit_load_mem(ctx, data, t0, copied as i32)
    emit_store_mem(ctx, t1, copied as i32, data)
    copied = copied + 8
  end
  if size - copied >= 4 then
    emit_load_mem_sized(ctx, data, t0, copied as i32, MemWidth::W32, Extension::Zero)
    emit_store_mem_sized(ctx, t1, copied as i32, data, MemWidth::W32)
    copied = copied + 4
  end
  if size - copied >= 2 then
    emit_load_mem_sized(ctx, data, t0, copied as i32, MemWidth::W16, Extension::Zero)
    emit_store_mem_sized(ctx, t1, copied as i32, data, MemWidth::W16)
    copied = copied + 2
  end
  if size - copied >= 1 then
    emit_load_mem_sized(ctx, data, t0, copied as i32, MemWidth::W8, Extension::Zero)
    emit_store_mem_sized(ctx, t1, copied as i32, data, MemWidth::W8)
    copied = copied + 1
  end
end

# array_len: Get length of vec. Args: vec_ptr. Returns length.
# The receiver is a heap-header handle by dispatch (Vec/Array/Slice ->
# HeapVecHeader); the len offset comes from the engine's container_field_offset.
# Fixed arrays (the distinct Type::FixedArray variant) carry the count IN the
# TYPE: the receiver's length is the compile-time constant n, never a header
# read.
def codegen_array_len(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let stripped = strip_ref_like_type(recv_ty)
  match stripped
  when Type::FixedArray(_, n) then
    # The receiver arrives in the ABI argument registers (x0/rdi); return
    # the compile-time count in the return register (x0/rax).
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X0, n as i64)
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RAX, n as i64)
    end
    return
  when _ then ()
  end
  # Load len from the header. Null collection pointers represent empty values.
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_len_done.")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
    def_label(&mut ctx.text, lbl_done)
  when Arch::X86_64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_len_done.")
    x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
    def_label(&mut ctx.text, lbl_done)
  end
end

# array_cap: Get capacity of vec. Args: vec_ptr. Returns capacity.
# Cap offset from the engine's container_field_offset (16 for Vec/Map).
def codegen_array_cap(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let cap_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"cap".to_string())
  # Load cap from the header. Null collection pointers represent empty values.
  match ctx.target.arch
  when Arch::AArch64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_cap_done.")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, cap_off as i32)
    def_label(&mut ctx.text, lbl_done)
  when Arch::X86_64 then
    let lbl_done = next_codegen_label(ctx, ".Larray_cap_done.")
    x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, cap_off as i32)
    def_label(&mut ctx.text, lbl_done)
  end
end

# array_remove: Remove element at index. Args: vec_ptr, index. The result
# is the category-aware VALUE-ABI extraction:
#   - Scalar: the runtime returns the complete T (the width-matched VALUE
#     WORD) in the return register — the general call machinery stores it;
#   - ScalarPair/ByAddress: the runtime returns the ADDRESS of a fresh
#     bump copy of the FULL removed image; the arm byte-copies the image
#     into the destination place (the materialization below) and reports
#     the full store so the post-call register store is suppressed.
def codegen_array_remove(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_remove")
end

# array_contains: Check if element exists. Args: vec_ptr (x0/rdi), item
# ADDRESS (x1/rsi — the &T reference value, never deref'd), eq_fn
# (x2/rdx — the concrete Eq::eq instance address resolved by
# map_eq_dispatch_label — the same dispatch the map keys use). The runtime
# probes each element with the Eq call.
def codegen_array_contains(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand]) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  let elem_ty = vec_elem_type_of(ctx, &strip_ref_like_type(&recv_ty))
  let eq_label = map_eq_dispatch_label(ctx, &elem_ty)
  match ctx.target.arch
  when Arch::AArch64 then
    emit_lea_label(ctx, PhysReg::A64Reg(A64::X2), eq_label)
  when Arch::X86_64 then
    emit_lea_label(ctx, PhysReg::X64Reg(X64::RDX), eq_label)
  end
  emit_call_label(ctx, "_tg_array_contains")
end

# array_insert: Insert element at index. Args: vec_ptr, index, element (per category).
def codegen_array_insert(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let arch = ctx.target.arch
  let elem_slot = match arg_reg(arch, 2)
  when Option::Some(r) then r
  when Option::None then panic("codegen_array_insert: no element ABI slot register")
  end
  codegen_collection_elem_transfer_arg(ctx, fctx, args, 2, elem_slot)
  codegen_collection_receiver_deref(ctx, fctx, args)
  emit_call_label(ctx, "_tg_array_insert")
end

# array_clear: Clear vec (set len to 0). Args: vec_ptr.
def codegen_array_clear(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    # Store 0 at [x0 + len_off] (len)
    a64_stur(&mut ctx.text, A64::XZR, A64::X0, len_off as i32)
  when Arch::X86_64 then
    # Store 0 at [rdi + len_off] (len)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, len_off as i32, X64::RAX)
  end
end

# array_destroy: release the vec's mmap'ed data buffer. Args: vec_ptr.
def codegen_array_destroy(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_destroy")
end

# array_last: Returns last element (or 0 if empty). Args: vec_ptr.
# Element address = data + (len-1) * stride — the stride comes from the
# CONCRETE element type (element_stride_bytes, the same authority the
# runtime reads from the Vec header); the load keeps the element's width.
def codegen_array_last(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  let elem_ty = vec_elem_type_of(ctx, recv_ty)
  let elem_stride = element_stride_bytes(ctx, &elem_ty)
  let lbl_empty = ".Larr_last_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, len_off as i32)   # len
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X2, A64::X0, 0)   # data ptr
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    emit_scale_index(ctx, PhysReg::A64Reg(A64::X1), elem_stride)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X2, A64::X1)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)  # len
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 0)  # data
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    emit_scale_index(ctx, PhysReg::X64Reg(X64::RAX), elem_stride)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    # mov rax, [rcx]
    emit8(&mut ctx.text, 0x48); emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x01)
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# array_first: Returns first element (or 0 if empty). Args: vec_ptr.
def codegen_array_first(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  let lbl_empty = ".Larr_first_empty." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X1, A64::X0, len_off as i32)   # len
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)   # data ptr
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)    # data[0]
    def_label(&mut ctx.text, lbl_empty.clone())
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)  # data[0]
    def_label(&mut ctx.text, lbl_empty.clone())
  end
end

# array_is_empty: Returns 1 if len == 0, else 0. Args: vec_ptr.
# Also serves SetIsEmpty (a set is map-backed; len is at the same header
# offset — HeapSetHeader row of container_field_offset).
def codegen_array_is_empty(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    emit_setcc(ctx, CondKind::Eq, PhysReg::A64Reg(A64::X0))
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    emit_setcc(ctx, CondKind::Eq, PhysReg::X64Reg(X64::RAX))
  end
end

# Stub intrinsics — emit no-op for non-critical array operations that may
# be needed for compilation to succeed. Full implementations can be added
# when the bootstrap needs them.
def codegen_array_reverse(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_reverse")
end
def codegen_array_sort(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_sort")
end
def codegen_array_extend(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_array_extend")
end
def codegen_array_truncate(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  # Truncate to given length — just update len if new len < current len
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stur(&mut ctx.text, A64::X1, A64::X0, len_off as i32)
  when Arch::X86_64 then
    x64_mov_mr(&mut ctx.text, X64::RDI, len_off as i32, X64::RSI)
  end
end
def codegen_array_resize(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let arch = ctx.target.arch
  let fill_slot = match arg_reg(arch, 2)
  when Option::Some(r) then r
  when Option::None then panic("codegen_array_resize: no fill ABI slot register")
  end
  codegen_collection_elem_transfer_arg(ctx, fctx, args, 2, fill_slot)
  codegen_collection_receiver_deref(ctx, fctx, args)
  emit_call_label(ctx, "_tg_array_resize")
end

# ———————————————————————————————————————————————————————————————
# Map/Set Intrinsic Implementations — INLINE-BUCKET HASH TABLE
# ———————————————————————————————————————————————————————————————
#
# CONTRACT (mirrors runtime.tg's map/set contract; see there for the full
# header/bucket/tuple layouts):
#   - Map[K, V] is a 96-byte header: { buckets, size, capacity,
#     key_stride, key_align, value_stride, value_align, key_off,
#     value_off, next_off, bucket_stride, free_list } — the canonical
#     MAP_HEADER_FIELDS table in layout_engine.tg (map_header_field_offset /
#     map_header_total_size) is the SINGLE machine-readable authority for
#     these offsets; every header read in this file routes through
#     container_field_offset / heap_header_field_offset. The four DERIVED
#     layout fields are computed here from the CONCRETE K/V via the layout
#     engine and passed to the runtime at creation; the runtime derives
#     nothing. free_list (header+88) is the runtime's overflow-node reuse
#     list: clear collects every chain node there and insert pops it
#     before mmap'ing a fresh node.
#   - Bucket records are inline: { hash, key bytes @key_off,
#     value bytes @value_off, next @next_off }. NO hardcoded 8-byte bucket
#     arithmetic anywhere: every offset/stride comes from the header.
#   - STORED-HASH ENCODING: the runtime normalizes every hash argument at
#     entry (stored = hash == 0 ? 1: hash) — the codegen passes the raw
#     Hash::hash result and the normalization is the runtime's single
#     place, so a user hash of 0 can never collide with the empty marker.
#   - HASH/EQ DISPATCH: at each map-operation site the concrete K is
#     known (post-monomorphization). The hash is computed by a DIRECT call
#     to the CONCRETE Hash::hash instance (user-defined `impl Hash for
#     MyKey` → MyKey__hash; generic impls resolve through the instance
#     base render + type mangling); the probe's key equality uses the
#     CONCRETE Eq::eq instance, passed to the runtime as a function
#     pointer. Kernel key types (Int/String/StrView/...) dispatch to the
#     typed runtime helpers _tg_hash_* / _tg_eq_* (their std::hash impls
#     are Hasher-style and do not match the core ABI). The dispatch is
#     gated by the DECLARED PARAMETER COUNT recorded in
#     ctx.dispatch_methods: hash must declare exactly 1 param
#     (hash(self) -> Int), eq exactly 2 (eq(self, other) -> Bool).
#   - Key/value operands: for stride <= 8 the value WORD travels in the
#     argument register and is materialized to a stack slot here; for
#     stride > 8 the register holds the ADDRESS of the concrete bytes.
#     The runtime ops always receive ADDRESSES.

# Kernel key types that must NEVER dispatch through the compiled impl
# methods: their registered std::hash impls are Hasher-style
# (`def hash[H: Hasher](self, state)`) — a different ABI.
def is_kernel_map_key_type(ty: Type) -> Bool
  match ty
  when Type::Int then true
  when Type::UInt then true
  when Type::Bool then true
  when Type::Char then true
  when Type::Float then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::String then true
  when _ then false
  end  end
end

# The map/set container's (K, V): Map[K, V] -> (K, V); Set[T] -> (T, Unit).
def map_container_key_value(ctx: CodegenCtx, ty: Type) -> Option[(Type, Type)]
  let stripped = strip_ref_like_type(ty)
  match stripped
  when Type::Adt(tid, args) then
    let tn = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if tn == "Map" && args.len() >= 2 then
      Option::Some((args[0].clone(), args[1].clone()))
    elsif tn == "Set" && args.len() >= 1 then
      Option::Some((args[0].clone(), Type::Unit))
    else
      Option::None
    end
  when _ then Option::None
  end
end

# The CONCRETE bucket/tuple layout for (K, V) — the exact mirror of the
# runtime contract (runtime.tg computes the same values at map creation
# from the four parameters passed here).
struct MapKvLayout
  k_stride: Int
  k_align: Int
  v_stride: Int
  v_align: Int
  k_off: Int
  v_off: Int
  next_off: Int
  b_stride: Int
  t_v_off: Int
  t_size: Int
end

def map_layout_of(inout ctx: CodegenCtx, k_ty: Type, v_ty: Type) -> MapKvLayout
  let kl = layout_of_strict(&mut ctx.layout_engine, k_ty)
  let vl = layout_of_strict(&mut ctx.layout_engine, v_ty)
  let k_stride = kl.size
  let k_align = kl.align
  let v_stride = vl.size
  let v_align = vl.align
  let k_off = align_up_int(8, k_align)
  let v_off = align_up_int(k_off + k_stride, v_align)
  let next_off = align_up_int(v_off + v_stride, 8)
  let b_stride = next_off + 8
  let t_v_off = align_up_int(k_stride, v_align)
  let t_size = align_up_int(t_v_off + v_stride, 8)
  MapKvLayout {
    k_stride: k_stride,
    k_align: k_align,
    v_stride: v_stride,
    v_align: v_align,
    k_off: k_off,
    v_off: v_off,
    next_off: next_off,
    b_stride: b_stride,
    t_v_off: t_v_off,
    t_size: t_size
  }
end

# The impl method base name for a concrete key type ("MyKey__hash").
# Kernel types and StrView resolve to None (they dispatch to the runtime
# helpers instead).
def map_key_impl_base(ctx: CodegenCtx, k_ty: Type, method: String) -> Option[String]
  if is_kernel_map_key_type(k_ty) then
    return Option::None
  end
  match strip_ref_like_type(k_ty)
  when Type::Adt(tid, _) then
    let tn = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
    if tn == "StrView" then
      Option::None
    else
      Option::Some(tn + "__" + method)
    end
  when _ then Option::None
  end
end

# Resolve the concrete Hash::hash dispatch label for K: the compiled impl
# method (core ABI, 1 declared param — generic impls resolve through the
# instance base render + type mangling) or the kernel/structural fallback.
def map_hash_dispatch_label(ctx: CodegenCtx, k_ty: Type) -> String
  let stripped = strip_ref_like_type(k_ty)
  match map_key_impl_base(ctx, k_ty, "hash")
  when Option::Some(base) then
    match ctx.dispatch_methods.get(&base)
    when Option::Some((render, pc)) then
      if pc == 1 then
        if ctx.fn_alias.contains_key(&base) then
          return resolve_callee_label(ctx, &base)
        end
        let mangled = render + "$" + type_to_mangled(&stripped)
        if ctx.fn_alias.contains_key(&mangled) then
          return resolve_callee_label(ctx, &mangled)
        end
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  match stripped
  when Type::String then "_tg_hash_str"
  when _ then
    match stripped
    when Type::Adt(tid, _) then
      let tn = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
      if tn == "StrView" then "_tg_hash_str_view" else "_tg_hash_mem" end
    when _ then "_tg_hash_mem"
    end
  end
end

# Resolve the concrete Eq::eq dispatch label for K (core ABI, 2 declared
# params) or the kernel/structural fallback.
def map_eq_dispatch_label(ctx: CodegenCtx, k_ty: Type) -> String
  let stripped = strip_ref_like_type(k_ty)
  match map_key_impl_base(ctx, k_ty, "eq")
  when Option::Some(base) then
    match ctx.dispatch_methods.get(&base)
    when Option::Some((render, pc)) then
      if pc == 2 then
        if ctx.fn_alias.contains_key(&base) then
          return resolve_callee_label(ctx, &base)
        end
        let mangled = render + "$" + type_to_mangled(&stripped)
        if ctx.fn_alias.contains_key(&mangled) then
          return resolve_callee_label(ctx, &mangled)
        end
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  match stripped
  when Type::String then "_tg_eq_str"
  when _ then
    match stripped
    when Type::Adt(tid, _) then
      let tn = bare_name_from_qualified(type_name_by_id(ctx, tid.id))
      if tn == "StrView" then "_tg_eq_str_view" else "_tg_eq_mem" end
    when _ then "_tg_eq_mem"
    end
  end
end

# map_new: Create an empty map with the CONCRETE layout parameters.
# Returns map ptr. Args: the four layout constants.
def codegen_map_new(inout ctx: CodegenCtx, dest_ty: Type) -> Unit
  match map_container_key_value(ctx, dest_ty)
  when Option::Some((k_ty, v_ty)) then
    let lay = map_layout_of(ctx, &k_ty, &v_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X0, lay.k_stride)
      a64_mov_ri(&mut ctx.text, A64::X1, lay.k_align)
      a64_mov_ri(&mut ctx.text, A64::X2, lay.v_stride)
      a64_mov_ri(&mut ctx.text, A64::X3, lay.v_align)
      emit_call_label(ctx, "_tg_map_new")
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RDI, lay.k_stride)
      x64_mov_ri(&mut ctx.text, X64::RSI, lay.k_align)
      x64_mov_ri(&mut ctx.text, X64::RDX, lay.v_stride)
      x64_mov_ri(&mut ctx.text, X64::RCX, lay.v_align)
      emit_call_label(ctx, "_tg_map_new")
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_new")
  end  end
end

# set_new: Create an empty set — a Map[T, Unit] with the element type as
# the key type. Returns set ptr.
def codegen_set_new(inout ctx: CodegenCtx, dest_ty: Type) -> Unit
  match map_container_key_value(ctx, dest_ty)
  when Option::Some((t_ty, _)) then
    let lay = map_layout_of(ctx, &t_ty, &Type::Unit)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X0, lay.k_stride)
      a64_mov_ri(&mut ctx.text, A64::X1, lay.k_align)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X3, 1)
      emit_call_label(ctx, "_tg_map_new")
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RDI, lay.k_stride)
      x64_mov_ri(&mut ctx.text, X64::RSI, lay.k_align)
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::RCX, 1)
      emit_call_label(ctx, "_tg_map_new")
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_new")
  end  end
end

# map_insert: Insert key/value into the map. Args after the dispatch:
# x0/rdi = map, x1/rsi = key (word or address), x2/rdx = value (word or
# address). Computes the concrete hash by a DIRECT call to the key type's
# Hash::hash instance, loads the Eq::eq instance address, and forwards
# (map, key_addr, value_addr, hash, eq_fn) to _tg_map_insert. The runtime
# returns the fresh owned allocation of the REPLACED value (0 for a new
# key; the Unit-value marker 1 for set-style maps); the shared
# codegen_option_payload_wrap re-encodes it as the Option[V] word.
def codegen_map_insert(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], dest_ty: Type) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, v_ty)) then
    let lay = map_layout_of(ctx, &k_ty, &v_ty)
    let hash_label = map_hash_dispatch_label(ctx, &k_ty)
    let eq_label = map_eq_dispatch_label(ctx, &k_ty)
    let k_mat = lay.k_stride <= 8
    let v_mat = lay.v_stride <= 8
    match ctx.target.arch
    when Arch::AArch64 then
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::XZR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
      if k_mat then a64_stp_pre(&mut ctx.text, A64::X1, A64::XZR, A64::SP, -16) end
      if v_mat then a64_stp_pre(&mut ctx.text, A64::X2, A64::XZR, A64::SP, -16) end
      if k_mat then
        if v_mat then
          a64_add_rri(&mut ctx.text, A64::X20, A64::SP, 16)
        else
          a64_mov_rr(&mut ctx.text, A64::X20, A64::SP)
        end
      else
        a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)
      end
      if v_mat then
        a64_mov_rr(&mut ctx.text, A64::X21, A64::SP)
      else
        a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)
      end
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_ldur(&mut ctx.text, A64::X1, A64::X19, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X0)   # hash
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # map
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # key addr
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)  # value addr
      emit_lea_label(ctx, PhysReg::A64Reg(A64::X4), eq_label)
      emit_call_label(ctx, "_tg_map_insert")
      if v_mat then a64_ldp_post(&mut ctx.text, A64::XZR, A64::XZR, A64::SP, 16) end
      if k_mat then a64_ldp_post(&mut ctx.text, A64::XZR, A64::XZR, A64::SP, 16) end
      a64_ldp_post(&mut ctx.text, A64::X21, A64::XZR, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    when Arch::X86_64 then
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)
      x64_push(&mut ctx.text, X64::R13)
      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
      if k_mat then x64_push(&mut ctx.text, X64::RSI) end
      if v_mat then x64_push(&mut ctx.text, X64::RDX) end
      if k_mat then
        if v_mat then
          x64_mov_rr(&mut ctx.text, X64::R12, X64::RSP)
          x64_add_ri(&mut ctx.text, X64::R12, 8)
        else
          x64_mov_rr(&mut ctx.text, X64::R12, X64::RSP)
        end
      else
        x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)
      end
      if v_mat then
        x64_mov_rr(&mut ctx.text, X64::R13, X64::RSP)
      else
        x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)
      end
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)   # hash
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # map
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)   # key addr
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)   # value addr
      emit_lea_label(ctx, PhysReg::X64Reg(X64::R8), eq_label)
      emit_call_label(ctx, "_tg_map_insert")
      if v_mat then x64_pop(&mut ctx.text, X64::R8) end
      if k_mat then x64_pop(&mut ctx.text, X64::R8) end
      x64_pop(&mut ctx.text, X64::R13)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
    end
    # Wrap the runtime result (fresh old-value allocation / 0 / the
    # Unit-marker 1) into the Option[V] word.
    codegen_option_payload_wrap(ctx, dest_ty)
  when Option::None then
    emit_call_label(ctx, "_tg_map_insert")
    codegen_option_payload_wrap(ctx, dest_ty)
  end
end

# set_insert: Add an element to the set — the Map[T, Unit] insert with a
# zero value address (Unit has zero bytes; the runtime copies nothing).
def codegen_set_insert(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((t_ty, _)) then
    let lay = map_layout_of(ctx, &t_ty, &Type::Unit)
    let hash_label = map_hash_dispatch_label(ctx, &t_ty)
    let eq_label = map_eq_dispatch_label(ctx, &t_ty)
    let t_mat = lay.k_stride <= 8
    match ctx.target.arch
    when Arch::AArch64 then
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::XZR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # set
      if t_mat then a64_stp_pre(&mut ctx.text, A64::X1, A64::XZR, A64::SP, -16) end
      if t_mat then
        a64_mov_rr(&mut ctx.text, A64::X20, A64::SP)
      else
        a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)
      end
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_ldur(&mut ctx.text, A64::X1, A64::X19, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X0)   # hash
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # set
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # item addr
      a64_mov_ri(&mut ctx.text, A64::X2, 0)         # value addr (Unit)
      emit_lea_label(ctx, PhysReg::A64Reg(A64::X4), eq_label)
      emit_call_label(ctx, "_tg_map_insert")
      if t_mat then a64_ldp_post(&mut ctx.text, A64::XZR, A64::XZR, A64::SP, 16) end
      a64_ldp_post(&mut ctx.text, A64::X21, A64::XZR, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    when Arch::X86_64 then
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)
      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # set
      if t_mat then x64_push(&mut ctx.text, X64::RSI) end
      if t_mat then
        x64_mov_rr(&mut ctx.text, X64::R12, X64::RSP)
      else
        x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)
      end
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)   # hash
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # set
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)   # item addr
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)          # value addr (Unit)
      emit_lea_label(ctx, PhysReg::X64Reg(X64::R8), eq_label)
      emit_call_label(ctx, "_tg_map_insert")
      if t_mat then x64_pop(&mut ctx.text, X64::R8) end
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_insert")
  end
end

# Shared probe-op emission for map_get / map_remove / map_contains /
# set_contains / set_remove: the key reference's ADDRESS is in arg1
# (references are pointer-width; NO deref — the runtime wants the address).
# Emits: hash(key) via the concrete Hash::hash instance, loads the Eq::eq
# instance address, then calls `op_label` with (map, key_addr, hash, eq_fn).
def codegen_map_probe_op(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], op_label: String, is_contains: Bool) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, _)) then
    let hash_label = map_hash_dispatch_label(ctx, &k_ty)
    let eq_label = map_eq_dispatch_label(ctx, &k_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
      a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key addr
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_ldur(&mut ctx.text, A64::X1, A64::X19, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X0)   # hash
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # map
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # key addr
      emit_lea_label(ctx, PhysReg::A64Reg(A64::X3), eq_label)
      emit_call_label(ctx, op_label)
      if is_contains then
        a64_cmp_ri(&mut ctx.text, A64::X0, 0)
        a64_cset(&mut ctx.text, A64::X0, a64_cc_ne())
      end
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    when Arch::X86_64 then
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)
      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key addr
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RAX)   # hash
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # map
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)   # key addr
      emit_lea_label(ctx, PhysReg::X64Reg(X64::RCX), eq_label)
      emit_call_label(ctx, op_label)
      if is_contains then
        x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
        x64_setcc(&mut ctx.text, CC::NE, X64::RAX)
        x64_movzx_r64_r8(&mut ctx.text, X64::RAX, X64::RAX)
      end
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
    end
  when Option::None then
    emit_call_label(ctx, op_label)
  end
end

# The Option[V] return wrap shared by the map extract-then-write ops
# (map_get / map_insert / map_remove): the runtime returns the raw result
# — the fresh value ADDRESS (a fresh allocation holding the copied bytes)
# or 0 when the key is absent — and this helper re-encodes it as the
# Option[V] TaggedPtr word the caller's category model expects:
#   found  -> a fresh heap image { tag = Some's discriminant @
#             tag_layout.offset, payload @ payload_offset } — for a
#             by-value V (0 < size <= 8) the payload is the VALUE WORD
#             loaded from the returned address (the canary contract:
#             `match m.get(&k) when Some(v) then v` binds the value, never
#             the address); for a >8-byte V the payload is the address
#             itself (the map ABI's by-reference payload convention);
#   absent -> the raw None discriminant word (below the TaggedPtr inline
#             threshold, so it normalizes to None).
# The tag/payload offsets and the discriminants come from the dest type's
# EnumLayout — the single enum-representation authority (for the std
# Option they are 0/1, matching the runtime's drain image constants).
def codegen_option_payload_wrap(inout ctx: CodegenCtx, dest_ty: Type) -> Unit
  let arch = ctx.target.arch
  let rr = ret_reg(arch)
  let lbl_none = next_codegen_label(ctx, ".Loption_wrap_none.")
  let lbl_done = next_codegen_label(ctx, ".Loption_wrap_done.")

  # The Option's payload type and its layout size: V <= 8 (and > 0) values
  # cross by value in the payload word; larger values cross by address.
  let opt_payload_ty = match dest_ty
  when Type::Adt(tid, args) then
    if args.len() >= 1 then args[0].clone() else Type::Unit end
  when _ then Type::Unit
  end
  let opt_v_size = layout_of_strict(&mut ctx.layout_engine, &opt_payload_ty).size
  let opt_some_disc = enum_variant_discriminant_of(ctx, dest_ty, "Some")
  let opt_none_disc = enum_variant_discriminant_of(ctx, dest_ty, "None")
  let opt_el = enum_layout_strict(ctx, dest_ty)

  emit_cmp_ri(ctx, rr, 0)
  emit_jcc(ctx, CondKind::Eq, lbl_none.clone())

  # Found: the payload word is the VALUE for 0 < V <= 8 (load it from the
  # returned address — WIDTH-MATCHED so a narrow payload (u8/u16/u32) is
  # read exactly at its own width and never crosses the slot's allocation
  # tail — the ArrayPop in-buffer slot path relies on this), else the
  # address itself.
  if opt_v_size > 0 && opt_v_size <= 8 then
    let pw = storage_width_of(ctx, &opt_payload_ty)
    let pext = storage_signedness_of(&opt_payload_ty)
    emit_load_mem_sized(ctx, rr, rr, 0, pw, pext)
  end

  match arch
  when Arch::AArch64 then
    # Allocate the Some image and fill { tag, payload }.
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    a64_mov_ri(&mut ctx.text, A64::X1, opt_some_disc as i64)
    a64_stur(&mut ctx.text, A64::X1, A64::X0, opt_el.tag_layout.offset)
    a64_stur(&mut ctx.text, A64::X19, A64::X0, opt_el.payload_offset)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    emit_call_label(ctx, "_tg_bump_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, opt_some_disc as i64)
    x64_mov_mr(&mut ctx.text, X64::RAX, opt_el.tag_layout.offset, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::RAX, opt_el.payload_offset, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBX)
  end
  emit_jmp(ctx, lbl_done.clone())

  def_label(&mut ctx.text, lbl_none)
  emit_mov_ri(ctx, rr, opt_none_disc as i64)
  def_label(&mut ctx.text, lbl_done)
end

# map_get: Get value for key. Args: map, key ref. The runtime returns the
# value ADDRESS or 0; the Option[V] wrapper is built by the shared
# codegen_option_payload_wrap (by-value V payloads for V <= 8, the address
# payload otherwise).
def codegen_map_get(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], dest_ty: Type) -> Unit
  codegen_map_probe_op(ctx, fctx, args, call_args, "_tg_map_get", false)
  codegen_option_payload_wrap(ctx, dest_ty)
end

# map_remove: Remove entry for key. The runtime returns the removed
# value's ADDRESS (a fresh allocation holding the copied bytes — the
# bucket is zeroed) or 0 when absent; the shared Option[V] wrap
# re-encodes it (the by-value V payload for V <= 8, the address payload
# otherwise).
def codegen_map_remove(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg], dest_ty: Type) -> Unit
  codegen_map_probe_op(ctx, fctx, args, call_args, "_tg_map_remove", false)
  codegen_option_payload_wrap(ctx, dest_ty)
end

# map_remove_key: the OWNERSHIP-TRANSFER remove (the MIR-side stored-key
# drop). The MIR's lowering of Map::remove over owning key types calls
# this intrinsic instead of the std wrapper: the runtime _tg_map_remove_key
# copies the removed VALUE image into the caller-provided v_out slot
# (args[2] — the address of the caller's V-typed local) and returns the
# removed record's KEY ADDRESS in x0/rax (0 when absent); the record is
# unlinked (hash zeroed) and the key bytes stay in the record until the
# MIR's MirDeinit (the concrete K drop glue) runs on the returned address.
# The intrinsic is RAW — no Option wrap: the MIR builds the Option[V]
# aggregate itself after the guarded drop. Args: x0/rdi = map,
# x1/rsi = key addr, x2/rdx = hash, x3/rcx = eq_fn, x4/r8 = v_out.
def codegen_map_remove_key(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, _)) then
    let hash_label = map_hash_dispatch_label(ctx, &k_ty)
    let eq_label = map_eq_dispatch_label(ctx, &k_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::XZR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
      a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key addr
      if args.len() > 2 then
        load_operand_call_arg(ctx, fctx, &args[2], PhysReg::A64Reg(A64::X21))  # v_out
      else
        a64_mov_ri(&mut ctx.text, A64::X21, 0)
      end
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_ldur(&mut ctx.text, A64::X1, A64::X19, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X0)   # hash
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # map
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # key addr
      a64_mov_rr(&mut ctx.text, A64::X4, A64::X21)  # v_out
      emit_lea_label(ctx, PhysReg::A64Reg(A64::X3), eq_label)
      emit_call_label(ctx, "_tg_map_remove_key")
      a64_ldp_post(&mut ctx.text, A64::X21, A64::XZR, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    when Arch::X86_64 then
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)
      x64_push(&mut ctx.text, X64::R13)
      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key addr
      if args.len() > 2 then
        load_operand_call_arg(ctx, fctx, &args[2], PhysReg::X64Reg(X64::R13))  # v_out
      else
        x64_mov_ri(&mut ctx.text, X64::R13, 0)
      end
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 24)  # key stride (mem-hash size)
      emit_call_label(ctx, hash_label)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RAX)   # hash
      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # map
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)   # key addr
      x64_mov_rr(&mut ctx.text, X64::R8, X64::R13)    # v_out
      emit_lea_label(ctx, PhysReg::X64Reg(X64::RCX), eq_label)
      emit_call_label(ctx, "_tg_map_remove_key")
      x64_pop(&mut ctx.text, X64::R13)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_remove_key")
  end
end

# set_remove_key: the OWNERSHIP-TRANSFER set remove (the MIR-side element
# drop). The Map[T, Unit] remove-key: the runtime returns the removed
# element's ADDRESS (the record's key slot) or 0; the MIR emits the
# element drop glue on the returned address and turns the nonzero test
# into the Bool. v_out is the Unit-slot zero constant (nothing is copied).
def codegen_set_remove_key(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  codegen_map_remove_key(ctx, fctx, args, call_args)
end

# map_contains: Check if key exists. Returns bool.
def codegen_map_contains(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  codegen_map_probe_op(ctx, fctx, args, call_args, "_tg_map_contains", true)
end

# set_contains: Check if element exists (the Map[T, Unit] contains).
def codegen_set_contains(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  codegen_map_probe_op(ctx, fctx, args, call_args, "_tg_map_contains", true)
end

# set_remove: Remove an element (the Map[T, Unit] remove; Unit values
# return the marker 1 from the runtime). Returns bool.
def codegen_set_remove(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand], call_args: Vec[MirCallArg]) -> Unit
  codegen_map_probe_op(ctx, fctx, args, call_args, "_tg_map_remove", true)
end

# map_len: Get number of entries. Args: map_ptr. Returns size.
# The len field of the map header: read through container_field_offset /
# heap_header_field_offset from the canonical MAP_HEADER_FIELDS table in
# layout_engine.tg (map_header_field_offset — size at 8, agreeing with the
# runtime's 96-byte header); only the size field at 8 is read here.
def codegen_map_len(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
  end
end

# set_len: Get number of elements (the Map[T, Unit] len).
def codegen_set_len(inout ctx: CodegenCtx, recv_ty: Type) -> Unit
  let len_off = heap_header_field_offset(codegen_type_repr(ctx, &strip_ref_like_type(recv_ty)), &"len".to_string())
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, len_off as i32)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, len_off as i32)
  end
end

# map_clone: Clone map entries into a new map of the same layout.
# Args: map. The eq_fn (the map's concrete Eq::eq instance address) is
# forwarded; it is never invoked while the destination is empty.
def codegen_map_clone(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand]) -> Unit
  let eq_label = if args.len() > 0 then
    let recv_ty2 = operand_type(ctx, fctx, &args[0])
    match map_container_key_value(ctx, &recv_ty2)
    when Option::Some((k_ty, _)) then map_eq_dispatch_label(ctx, &k_ty)
    when Option::None then "_tg_eq_mem"
    end
  else
    "_tg_eq_mem"
  end
  match ctx.target.arch
  when Arch::AArch64 then
    emit_lea_label(ctx, PhysReg::A64Reg(A64::X1), eq_label)
    emit_call_label(ctx, "_tg_map_clone")
  when Arch::X86_64 then
    emit_lea_label(ctx, PhysReg::X64Reg(X64::RSI), eq_label)
    emit_call_label(ctx, "_tg_map_clone")
  end
end

# set_clone: Clone set elements into a new set (the Map[T, Unit] clone).
def codegen_set_clone(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand]) -> Unit
  codegen_map_clone(ctx, fctx, args)
end

# map_clear: Clear all entries. Args: map_ptr.
# The runtime walks every chain and links every overflow node into the
# header's free_list word (header+88 — the canonical MAP_HEADER_FIELDS
# table in layout_engine.tg); only the map pointer crosses here.
def codegen_map_clear(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_clear")
end

# map_keys/values/entries: Iterate map and extract keys, values, or entries.
# entries receives the CONCRETE tuple layout (t_v_off, t_size) PLUS the
# entries element STRIDE (the (K, V) tuple's category-derived
# element_stride_bytes — the same authority the caller's ProjIndex uses to
# address the returned Vec[(K, V)], so the runtime's header stride and the
# caller's addressing can never disagree).
def codegen_map_keys(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let recv_ty = if args.len() > 0 then mir_call_arg_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, _)) then
    let k_stride = element_stride_bytes(ctx, &k_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X1, k_stride)
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RSI, k_stride)
    end
  when Option::None then ()
  end
  emit_call_label(ctx, "_tg_map_keys")
end
def codegen_map_values(inout ctx: CodegenCtx) -> Unit
  # Pre-existing: no _tg_map_values runtime helper exists; the MapValues
  # intrinsic is unreachable from the std surface (values() materializes
  # via entries()). Keep the historical label so the dead path stays dead
  # rather than silently returning keys.
  emit_call_label(ctx, "_tg_map_values")
end
def codegen_map_entries(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let recv_ty = if args.len() > 0 then mir_call_arg_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, v_ty)) then
    let lay = map_layout_of(ctx, &k_ty, &v_ty)
    let entry_stride = element_stride_bytes(ctx, &Type::Tuple(vec![k_ty.clone(), v_ty.clone()]))
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X1, lay.t_v_off)
      a64_mov_ri(&mut ctx.text, A64::X2, lay.t_size)
      a64_mov_ri(&mut ctx.text, A64::X3, entry_stride)
      emit_call_label(ctx, "_tg_map_entries")
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RSI, lay.t_v_off)
      x64_mov_ri(&mut ctx.text, X64::RDX, lay.t_size)
      x64_mov_ri(&mut ctx.text, X64::RCX, entry_stride)
      emit_call_label(ctx, "_tg_map_entries")
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_entries")
  end
end

# set_entries: Collect set elements into a Vec[T] (the Map[T, Unit] keys);
# the element stride (T's category-derived element_stride_bytes) is passed
# so the runtime's header matches the caller's ProjIndex addressing.
def codegen_set_entries(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, args: Vec[MirCallArg]) -> Unit
  let recv_ty = if args.len() > 0 then mir_call_arg_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((t_ty, _)) then
    let t_stride = element_stride_bytes(ctx, &t_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X1, t_stride)
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RSI, t_stride)
    end
  when Option::None then ()
  end
  emit_call_label(ctx, "_tg_map_keys")
end

# map_drain_one: remove the FIRST live entry, returning Option[(K, V)].
# Args: map. Returns via sret (AArch64: x8; x86-64: r8 — the drain sret
# register the shared drain block sets) with disc + the concrete
# (K, V) tuple (key at payload+0, value at payload + t_v_off).
def codegen_map_drain_one(inout ctx: CodegenCtx, fctx: FnCodegenCtx, args: Vec[MirOperand]) -> Unit
  let recv_ty = if args.len() > 0 then operand_type(ctx, fctx, &args[0]) else Type::Unit end
  match map_container_key_value(ctx, &recv_ty)
  when Option::Some((k_ty, v_ty)) then
    let lay = map_layout_of(ctx, &k_ty, &v_ty)
    match ctx.target.arch
    when Arch::AArch64 then
      a64_mov_ri(&mut ctx.text, A64::X1, lay.t_v_off)
      a64_mov_ri(&mut ctx.text, A64::X2, lay.t_size)
      emit_call_label(ctx, "_tg_map_drain_one")
    when Arch::X86_64 then
      x64_mov_ri(&mut ctx.text, X64::RSI, lay.t_v_off)
      x64_mov_ri(&mut ctx.text, X64::RDX, lay.t_size)
      emit_call_label(ctx, "_tg_map_drain_one")
    end
  when Option::None then
    emit_call_label(ctx, "_tg_map_drain_one")
  end
end

# set_drain_one: remove the FIRST live element, returning Option[T].
# Args: set. Returns via sret (AArch64: x8) with disc + element.
def codegen_set_drain_one(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_set_drain_one")
end

# Re-encode a drain helper's result as a proper enum VALUE. The drain
# helpers (_tg_map_drain_one / _tg_set_drain_one) deliver their result as
# the enum IMAGE written at &dest in x8 (disc@0, payload@8 — a runtime-ABI
# property independent of the result's value category), so the dest
# local's first word is the raw tag (0/1) — BELOW the TaggedPtr inline
# threshold. Read as an enum word, that looks like an inline tag with NO
# heap payload, so every payload projection (the deinit plan's
# Some-arm walk: Variant(Some) + TupleIndex on the drained (K, V)) would
# resolve to a zeroed base instead of the transferred entry. This helper
# copies the image into a fresh heap allocation and stores the heap
# POINTER into the dest slot — the standard TaggedPtr word — so every
# consumer (MirDiscriminant's normalize-deref, is_some, the Variant
# payload projections, unwrap, the drop-glue plan walk) agrees with the
# category model. The image is the enum's full layout image (the runtime
# wrote disc + key + value bytes; the remaining padding is never read).
def codegen_drain_result_materialize(inout ctx: CodegenCtx, inout fctx: FnCodegenCtx, dest_ty: Type, dest_off: i32) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let rr = ret_reg(arch)
  let src = scratch_reg(arch)
  let data = scratch2_reg(arch)
  let img_sz = layout_of_strict(&mut ctx.layout_engine, dest_ty).size

  emit_mov_ri(ctx, rr, img_sz as i64)
  emit_call_label(ctx, "_tg_bump_alloc")
  # rr = heap image base; copy img_sz bytes from [fp + dest_off] to [rr].
  emit_lea_fp(ctx, src, dest_off)
  var copied = 0
  while img_sz - copied >= 8 do
    emit_load_mem(ctx, data, src, copied as i32)
    emit_store_mem(ctx, rr, copied as i32, data)
    copied = copied + 8
  end
  if img_sz - copied >= 4 then
    emit_load_mem_sized(ctx, data, src, copied as i32, MemWidth::W32, Extension::Zero)
    emit_store_mem_sized(ctx, rr, copied as i32, data, MemWidth::W32)
    copied = copied + 4
  end
  if img_sz - copied >= 2 then
    emit_load_mem_sized(ctx, data, src, copied as i32, MemWidth::W16, Extension::Zero)
    emit_store_mem_sized(ctx, rr, copied as i32, data, MemWidth::W16)
    copied = copied + 2
  end
  if img_sz - copied >= 1 then
    emit_load_mem_sized(ctx, data, src, copied as i32, MemWidth::W8, Extension::Zero)
    emit_store_mem_sized(ctx, rr, copied as i32, data, MemWidth::W8)
    copied = copied + 1
  end
  # Store the heap pointer into the dest slot: the local now holds the
  # enum VALUE word.
  emit_store_mem(ctx, fp, dest_off, rr)
end

# map_destroy: release the map's bucket arena + overflow chains. Args: map_ptr.
def codegen_map_destroy(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_destroy")
end

# set_destroy: release the set's backing storage (the Map[T, Unit] destroy).
def codegen_set_destroy(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_map_destroy")
end

# ———————————————————————————————————————————————————————————————
# Memory Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# mem_alloc: Allocate memory. Args: size. Returns ptr.
def codegen_mem_alloc(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_mem_alloc")
end

# mem_free: Free memory. Args: ptr, size.
def codegen_mem_free(inout ctx: CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_mem_free")
end

# mem_copy: Copy memory. Args: dst, src, size.
def codegen_mem_copy(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Use rep-movsb style byte-by-byte copy
    # x0 = dst, x1 = src, x2 = count
    let lbl_loop = ".Lmemcpy_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemcpy_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save dst
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X2)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X1, A64::X10)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = dst, rsi = src, rdx = count
    # Use rep movsb
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xA4)  # movsb
  end  end
end

# mem_set: Fill memory with byte value. Args: ptr, value, size.
def codegen_mem_set(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr, x1 = value (byte), x2 = count
    let lbl_loop = ".Lmemset_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemset_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    a64_and_ri(&mut ctx.text, A64::X1, 0xFF)     # Mask to byte
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X2)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::X1, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = ptr, rsi = value, rdx = count
    # Use rep stosb
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xAA)  # stosb
  end  end
end

# mem_zero: Zero memory. Args: ptr, size.
def codegen_mem_zero(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr, x1 = count
    let lbl_loop = ".Lmemzero_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemzero_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = ptr, rsi = count
    # Use rep stosb with 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RSI)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xAA)  # stosb
  end  end
end

# ———————————————————————————————————————————————————————————————
# Hash Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# hash_int: Hash an integer. Arg in x0/rdi. Returns hash in x0/rax.
def codegen_hash_int(inout ctx: CodegenCtx) -> Unit
  # FNV-1a hash for 64-bit integers
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = value
    # FNV offset basis: 0xcbf29ce484222325
    # FNV prime: 0x100000001b3
    a64_mov_ri(&mut ctx.text, A64::X9, 0xcbf29ce484222325 as i64)
    a64_mov_ri(&mut ctx.text, A64::X10, 0x100000001b3 as i64)
    # xor with value
    a64_eor_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X0)
    # multiply by FNV prime
    a64_mul_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X10)
  when Arch::X86_64 then
    # rdi = value
    # Load full 64-bit FNV offset basis
    x64_mov_ri(&mut ctx.text, X64::RAX, 0xcbf29ce484222325 as i64)
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDI)
    # Multiply by FNV prime (0x100000001b3)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0x100000001b3 as i64)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# hash_str: Hash a null-terminated string. Arg in x0/rdi. Returns hash in x0/rax.
def codegen_hash_str(inout ctx: CodegenCtx) -> Unit
  # FNV-1a hash for strings
  let lbl_loop = ".Lhashstr_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lhashstr_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = str ptr, x1 = hash accumulator
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X1, 0xcbf29ce484222325 as i64)  # FNV-1a 64-bit basis
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    # xor hash with byte
    a64_eor_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X10)
    # multiply by FNV-1a 64-bit prime (0x100000001b3)
    a64_mov_ri(&mut ctx.text, A64::X10, 0x100000001b3 as i64)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X10)
    # next char
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop)
    
    def_label(&mut ctx.text, lbl_done)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
    
  when Arch::X86_64 then
    # rdi = str ptr, rcx = hash accumulator
    x64_mov_ri(&mut ctx.text, X64::RCX, 0xcbf29ce484222325 as i64)  # FNV-1a 64-bit basis
    
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx edx, byte [rdi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x17)
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    # xor hash with byte
    x64_xor_rr(&mut ctx.text, X64::RCX, X64::RDX)
    # multiply by FNV-1a 64-bit prime (0x100000001b3)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0x100000001b3 as i64)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    # next char
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    
    def_label(&mut ctx.text, lbl_done)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# hash_combine: Combine two hash values. Args: hash1, hash2. Returns combined hash.
def codegen_hash_combine(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = h1, x1 = h2
    # Combine: h1 ^= h2 + 0x9e3779b9 + (h1 << 6) + (h1 >> 2)
    a64_lsl(&mut ctx.text, A64::X2, A64::X0, 6)    # x2 = h1 << 6
    a64_lsr(&mut ctx.text, A64::X3, A64::X0, 2)    # x3 = h1 >> 2
    a64_mov_ri(&mut ctx.text, A64::X4, 0x9e3779b9)  # x4 = golden ratio constant
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X1, A64::X4)  # x4 = h2 + constant
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X4, A64::X2)  # x4 += (h1 << 6)
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X4, A64::X3)  # x4 += (h1 >> 2)
    a64_eor_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X4)  # h1 ^= x4
  when Arch::X86_64 then
    # rdi = h1, rsi = h2
    # Combine: h1 ^= h2 + 0x9e3779b9 + (h1 << 6) + (h1 >> 2)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)   # rdx = h1
    x64_shl_ri(&mut ctx.text, X64::RDX, 6)           # rdx = h1 << 6
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)   # rcx = h1
    x64_shr_ri(&mut ctx.text, X64::RCX, 2)           # rcx = h1 >> 2
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x9e3779b9)  # rax = golden ratio constant
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RSI)    # rax += h2
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)    # rax += (h1 << 6)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)    # rax += (h1 >> 2)
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDI)    # rax = h1 ^ rax
  end  end
end

# ———————————————————————————————————————————————————————————————
# Program code generation
# ———————————————————————————————————————————————————————————————

def codegen_program(inout ctx: CodegenCtx, program: MirProgram) -> Result[Unit, String]
  ctx.deinit_plans = program.deinit_plans.clone()
 # the generated drop-glue tables — the glue functions' identity ->
  # emission name and the concrete-type-key -> glue instance; the
  # finalizer DefId -> mangled emission name table.
  ctx.drop_glue_fns = program.drop_glue_fns.clone()
  ctx.drop_glue_instances = program.drop_glue_instances.clone()
  ctx.method_names_by_def = program.method_names_by_def.clone()
 # the map/set dispatch metadata (impl method base name ->
  # (instance-base render, declared parameter count)) — the map-op label
  # resolution authority.
  ctx.dispatch_methods = program.dispatch_methods.clone()
  # Build type layout map and field layouts from MIR type definitions (single
 # LayoutEngine pass). the tables are CONCRETE-keyed — the nominal
  # entries come from the non-generic defs and every concrete Adt instance
  # the post-mono MIR mentions (function param/local/ret types, static types)
  # is laid out under its OWN (TypeId, substs) key with the def's fields
  # substituted (generic defs have no nominal entry).
  var concrete_instances = Vec::new()
  for f in program.functions do
    collect_concrete_adt_types(&f.ret_type, &mut concrete_instances)
    for p in f.params do
      collect_concrete_adt_types(&p.ty, &mut concrete_instances)
    end
    for l in f.locals do
      collect_concrete_adt_types(&l.ty, &mut concrete_instances)
    end
  end
  for st in program.statics do
    collect_concrete_adt_types(&st.ty, &mut concrete_instances)
  end
  let (type_layout, field_offsets, field_sizes, payload_offsets) = build_all_layouts(&mut ctx.layout_engine, &program.types, &concrete_instances)
  ctx.type_layout = type_layout
  ctx.type_field_offsets = field_offsets
  ctx.type_field_sizes = field_sizes
  ctx.enum_payload_offsets = payload_offsets
  ctx.type_defs = program.types.clone()
  # Reference the MIR functions/statics directly for all codegen passes in this
  # routine. program is an immutable borrow and is never mutated here, so a
  # borrow is both safe and avoids an unnecessary whole-MirFunction deep clone.
  # Whole-aggregate copy/clone semantics (including MirFunction-shaped records
  # with adjacent Bool fields) are covered by tests/canary/test_canary_aggregate_copy.tg.
  let functions = program.functions
  let statics = program.statics

  # Build O(1) type lookup index
  var tdi = 0
  while tdi < ctx.type_defs.len() do
    ctx.type_def_index.insert(ctx.type_defs[tdi].id.id, tdi)
    tdi = tdi + 1
  end

  # Build set of extern function names (for call dispatch)
  var fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    if func.is_extern then
      ctx.extern_fns.insert(func.name.clone())
    end
    fi = fi + 1
  end

  # Compute reachable functions from main
  let reachable = compute_reachable(program)
  ctx.reachable_fns = reachable.clone()

  # Build fn_alias map: maps bare/canonical names to actual compiled function labels.
  # This resolves label mismatches where MIR call refs use bare names (e.g., "read_all")
  # but function bodies are emitted with mangled names (e.g., "File__read_all").
  # First, collect all real function names so we never shadow them with aliases.
  #
 # The naming flow is the symbol-mangling boundary. The
  # SEMANTIC function identity is the module-qualified DefId-derived key
  # (fn_owner_key "<module path>::<index>::fn" — see mir.tg's
  # mir_fn_emission_name / types.tg's fn_owner_key_of_item); the MIR function
  # NAME (MirFunction.name / MirFnItem operand) is the EMISSION name, and
  # this map is where emission names become machine labels. The identity
  # entry below maps the exact emission name -> ".Lfn_entry.<index>", so a
  # module-qualified emission name ("a::b::helper") resolves directly and is
  # never mis-stripped. The bare/canonical aliases are EXTRA lookup keys for
  # unqualified references: bare_name_from_qualified strips only the
  # LAST-segment qualification ("a::b::helper" -> "helper",
  # "Type__method" -> "method") — the emitted function keeps its full
  # qualified/mangled name; no alias ever rewrites an emitted label. A
  # bare-name collision (same-named functions in different modules) is the
  # documented name-based residual: the last emitted alias wins, so
  # unqualified references are ambiguous — the DefId-derived identity
  # (InstanceId on MirFnItem) is the semantic disambiguator that replaces
  # this string stage.
 # (final): the full flow is now DefId-driven end to end:
  #   MirFunction.name (fn_owner_key of the item's DefId, recorded by
  #   lower_program) -> codegen_function's emitted symbol AND fn_alias
  #   identity entry (".Lfn_entry.<index>") -> call references (MirFnItem
  #   names derived from the call's InstanceId DefId) -> resolve_callee_label
  #   (the single authority) -> the identity label.
  # DefId-derived names get NO bare/canonical aliases (is_defid_derived_name
  # guards the loop below): their only lookup key is the exact identity
  # entry. Extern symbols, intrinsic names, the OS-entry "main"/"_start",
  # and "Type__method" method names keep their source/mangled names
  # unchanged (the linking boundary and the finalizer/Drop identities).
  var real_fn_names: Set[String] = Set::new()
  fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    real_fn_names.insert(func.name.clone())
    fi = fi + 1
  end
  fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    let func_name = func.name.clone()
    if reachable.contains(&func_name) || func.is_extern then
 # a DefId-derived emission name ("<module path>::<index>::fn")
      # has no bare form — bare_name_from_qualified would strip it to the
      # kind token ("fn"), a synthetic alias that only collides. Derived
      # names are referenced by their exact identity entry; the
      # bare/canonical aliases below are only for the remaining name-based
      # references (methods, synthesized/IR-only callees, extern stubs).
      if !is_defid_derived_name(&func_name) then
        let bare = bare_name_from_qualified(func_name.clone())
        if bare != func.name && !real_fn_names.contains(&bare) then
          ctx.fn_alias.insert(bare.clone(), func_name.clone())
        end
        let canonical = canonical_fn_ref(func_name.clone())
        if canonical != func.name && canonical != bare && !real_fn_names.contains(&canonical) then
          ctx.fn_alias.insert(canonical.clone(), func_name.clone())
        end
      end
    end
    fi = fi + 1
  end

 # the static label table — DefId-render -> the static's emission
  # label (the name-side symbol-table registration). Built BEFORE the
  # statics are emitted so the MirStaticRef / MirStaticAddr arms resolve
  # their DefIds through it.
  var static_labels: Map[String, String] = Map::new()
  build_static_label_table(program, &mut static_labels)
  ctx.static_labels = static_labels

  # Emit all statics from a stable snapshot (same strategy as functions above).
  var si = 0
  while si < statics.len() do
    codegen_static(ctx, &statics[si])
    si = si + 1
  end

  # Emit reachable functions + all extern stubs + closures
  # Closures (names starting with _closure) are always emitted if referenced
  # Build set of functions with compiled bodies (non-extern, has blocks)
  # This is used by codegen_call to prefer direct calls over intrinsic inlining
  var has_body_fns: Set[String] = Set::new()
  fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit && !func.is_extern && func.blocks.len() > 0 then
      has_body_fns.insert(func_name)
    end
    fi = fi + 1
  end
  ctx.reachable_fns = has_body_fns.clone()

  fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit then
      ctx.fn_alias.insert(func_name.clone(), ".Lfn_entry." + fi.to_string())
    end
    fi = fi + 1
  end

 # index the bases of `$`-suffixed monomorphized instance names
  # ("Option__map$i64_str" → "Option__map"). resolve_callee_label's
  # instance-aware check consults this set in the fail-closed panic path: a
  # MirFnItem name that is not resolvable itself but IS the base of emitted
  # instances means the monomorphizer never rewrote that call site — the
  # instance-identity leak the InstanceId { def, substs } target eliminates.
  # Built by iterating the functions Vec (deterministic order; the set is
  # only queried by contains, never iterated).
  ctx.generic_instance_bases = Set::new()
  fi = 0
  while fi < functions.len() do
    let func_name = functions[fi].name.clone()
    let dollar_pos = find_instance_dollar(&func_name)
    if dollar_pos > 0 then
      ctx.generic_instance_bases.insert(func_name.slice(0, dollar_pos))
    end
    fi = fi + 1
  end

  fi = 0
  while fi < functions.len() do
    let func = functions[fi]
    # Emit if: reachable OR _start OR extern OR closure (closures are always emitted when present)
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit then
      codegen_function(ctx, func)
    end
    fi = fi + 1
  end
  emit_pending_enum_eq_helpers(ctx)

  # Emit runtime helper functions
  emit_runtime_str_concat(ctx)
  emit_runtime_str_chars(ctx)
  
  # Emit full runtime library (arrays, maps, sets, memory, string conversion)
  # Runtime is compiled into its own CodeBuffer and then merged into the main
  # text section.  This avoids interpreter issues with nested &mut references
  # through the RuntimeEmitCtx wrapper and is also the standard pattern for
  # separate compilation units that are linked together.
  var runtime_ctx = runtime_ctx_new(ctx.target.clone())
  emit_all_runtime(&mut runtime_ctx)
  merge_code_buffer(&mut ctx.text, &runtime_ctx.text)

  # Emit stub function bodies for referenced-but-uncompiled labels.
  # These are intrinsics or unreachable functions whose addresses are taken
  # (via MirFnItem in assignments) but have no real body.
  # Emitting a simple RET stub prevents unresolved label errors at fixup.
  var fi = 0
  while fi < ctx.text.fixups.len() do
    let f = ctx.text.fixups[fi]
    match ctx.text.labels.get(f.label)
    when Option::None then
      # Label not defined yet — emit a stub function (just RET)
      align_to(&mut ctx.text, 4, ctx.target.arch)
      def_label(&mut ctx.text, f.label.clone())
      emit_ret(ctx)
    when Option::Some(_) then ()
    end
    fi = fi + 1
  end

  # Resolve local branch fixups
  match resolve_fixups(&mut ctx.text)
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(e) then Result::Err("codegen fixup error: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# Argc/Argv Data Section Storage
# ———————————————————————————————————————————————————————————————

# Allocate two 8-byte slots in.data for the saved argc and argv.
# The entry point writes the real values here and the runtime
# tg_get_argc / tg_get_argv stubs read from them via relocations.
def emit_argc_argv_data(inout ctx: CodegenCtx) -> Unit
  # Align data to 8 bytes
  while (buf_pos(&ctx.data) % 8) != 0 do
    emit8(&mut ctx.data, 0)
  end
  # _tg_saved_argc (8 bytes, initialized to 0)
  let argc_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_argc".to_string(),
    section: Section::Data,
    offset: argc_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_argc".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_saved_argv (8 bytes, initialized to 0)
  let argv_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_argv".to_string(),
    section: Section::Data,
    offset: argv_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_argv".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_saved_envp (8 bytes, initialized to 0) — envp pointer for getenv
  let envp_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_envp".to_string(),
    section: Section::Data,
    offset: envp_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_envp".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_bump_ptr (8 bytes, initialized to 0) — bump allocator current pointer
  let bump_ptr_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_bump_ptr".to_string(),
    section: Section::Data,
    offset: bump_ptr_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_bump_ptr".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_bump_end (8 bytes, initialized to 0) — bump allocator chunk end
  let bump_end_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_bump_end".to_string(),
    section: Section::Data,
    offset: bump_end_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_bump_end".to_string())
  emit64_le(&mut ctx.data, 0)

  # __tg_effect_stack_top (8 bytes, initialized to 0) — the task's
  # effect-handler stack top (the direct-style handler frames: each
  # installed handler's frame is written by __tg_effect_frame_push into
  # the INSTALLING function's frame slot and linked here; perform walks
  # the linked frames to the innermost matching handler).
  let effect_top_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "__tg_effect_stack_top".to_string(),
    section: Section::Data,
    offset: effect_top_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "__tg_effect_stack_top".to_string())
  emit64_le(&mut ctx.data, 0)

  # __tg_effect_unhandled_msg — the DEFINED ERROR message of an unhandled
  # effect operation (78 bytes incl. the newline): __tg_effect_perform
  # writes it to stderr and aborts when no handler frame matches the
  # performed op.
  let effect_msg_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "__tg_effect_unhandled_msg".to_string(),
    section: Section::Data,
    offset: effect_msg_off,
    size: 80,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "__tg_effect_unhandled_msg".to_string())
  let effect_msg = "Tangerine runtime: unhandled effect operation (no matching handler frame)\n"
  var emi = 0
  while emi < 80 do
    if emi < effect_msg.len() then
      emit8(&mut ctx.data, effect_msg.char_at(emi) as u8)
    else
      emit8(&mut ctx.data, 0)
    end
    emi = emi + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Budget Enforcement Data Section Storage
# ———————————————————————————————————————————————————————————————
# The budget counters NO LONGER live in .data — the global counter table
# (the former __tg_budget_alloc / __tg_budget_time slots) was removed with
# the semantics fix: the counters moved into the generated function's STACK
# FRAME (FrameInfo.budget_alloc_offset / budget_time_offset — reserved by
# allocate_locals and zeroed/stamped by the prologue and the
# __tg_budget_time_start record arm). Global counters broke the budget
# semantics three ways — two calls of the same budgeted function shared one
# counter, nested budgeted calls overwrote the single global time stamp,
# and concurrent calls raced the shared slots. The frame slots are
# per-invocation (each invocation's frame), per-nesting (inner frames are
# separate), and per-thread (per-thread stacks) by construction.
# The runtime emits no budget data symbols; the __tg_clock_ns helper
# (runtime.tg) remains the time metric's clock.

# ———————————————————————————————————————————————————————————————
# Allocator Runtime Data Section Storage
# ———————————————————————————————————————————————————————————————
# The free-list allocator state the _tg_mem_alloc/_tg_mem_free pair
# maintains (see emit_tg_mem_alloc in runtime.tg):
#   * _tg_alloc_free_heads — 13 per-class free-list head slots, one per
#     size class (16/32/64/128/256/512/1024/2048/4096/8192/16384/32768/
#     65536). Each slot holds the BASE address of the most recently freed
#     block of that class (LIFO); zero = empty. Freed small blocks store
#     the next-free pointer in their payload's first 8 bytes, so the head
#     slots are the only static allocator state the free list needs.
#   * _tg_alloc_outstanding — the allocator's live-byte counter: total
#     payload bytes handed out minus total bytes freed (free-list blocks
#     count as freed the moment _tg_mem_free links them in). Exposed to
#     tests through _tg_allocator_outstanding_bytes.
#   * _tg_alloc_fail_next — single-shot fault-injection flag: when
#     nonzero, the next _tg_mem_alloc large-path request returns 0 without
#     calling mmap (deterministic OOM simulation; see _tg_alloc_fail_next).
#
# All slots are zero-initialized in .data — the first small allocation
# seeds each class from the bump arena, and the first large allocation
# sees a cleared fail flag.
def emit_allocator_runtime_data(inout ctx: CodegenCtx) -> Unit
  # Align data to 8 bytes
  while (buf_pos(&ctx.data) % 8) != 0 do
    emit8(&mut ctx.data, 0)
  end
  # _tg_alloc_free_heads (13 × 8 bytes, initialized to 0)
  let heads_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_alloc_free_heads".to_string(),
    section: Section::Data,
    offset: heads_off,
    size: 104,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_alloc_free_heads".to_string())
  var head_i = 0
  while head_i < 13 do
    emit64_le(&mut ctx.data, 0)
    head_i = head_i + 1
  end

  # _tg_alloc_outstanding (8 bytes, initialized to 0)
  let outstanding_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_alloc_outstanding".to_string(),
    section: Section::Data,
    offset: outstanding_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_alloc_outstanding".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_alloc_fail_next (8 bytes, initialized to 0)
  let fail_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_alloc_fail_next".to_string(),
    section: Section::Data,
    offset: fail_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_alloc_fail_next".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_alloc_locks (13 × 1 byte — one spin-lock per size class,
  # initialized to 0 = unlocked). _tg_alloc_lock/_tg_alloc_unlock (the
  # runtime pair) serialize the per-class free-list head pop/push so two
  # threads churning the same class never race the same head slot.
  let locks_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_alloc_locks".to_string(),
    section: Section::Data,
    offset: locks_off,
    size: 13,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_alloc_locks".to_string())
  var lock_i = 0
  while lock_i < 13 do
    emit8(&mut ctx.data, 0)
    lock_i = lock_i + 1
  end
end

# Emit code at the start of main() to save the ABI-provided argc/argv
# into _tg_saved_argc / _tg_saved_argv in the.data section.
# On macOS the entry point `main` receives argc in x0/edi and argv in x1/rsi.
# On Linux `_start` receives argc at [sp] and argv at sp+8 — those are read
# from the Frame Pointer after the prologue adjusts SP.
def emit_save_argc_argv(inout ctx: CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS: main(argc, argv) — argc in x0, argv in x1
      # Save argc
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argc".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argc".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X0, A64::X15, 0)               # STR X0, [X15]
      # Save argv
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argv".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argv".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X1, A64::X15, 0)               # STR X1, [X15]
      # Compute envp = argv + (argc + 1) * 8 and save it
      a64_add_rri(&mut ctx.text, A64::X14, A64::X0, 1)           # X14 = argc + 1
      a64_lsl(&mut ctx.text, A64::X14, A64::X14, 3)              # X14 = (argc + 1) * 8
      a64_add_rrr(&mut ctx.text, A64::X14, A64::X1, A64::X14)    # X14 = argv + (argc+1)*8 = envp
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_envp".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_envp".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X14, A64::X15, 0)              # STR X14, [X15]
    when OsAbi::Linux then
      # Linux _start: argc at [FP+16], argv = FP + 24 (after prologue)
      # FP was set to SP by the prologue; the kernel placed argc at [original_sp]
      # and argv at [original_sp+8..].  After STP FP,LR,[SP,#-16]!, original_sp = FP+16.
      # Save argc
      a64_ldur(&mut ctx.text, A64::X15, A64::FP, 16)             # LDR X15, [FP, #16]  — argc
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argc".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X14))  # ADRP X14, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argc".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 0)
      a64_str(&mut ctx.text, A64::X15, A64::X14, 0)              # STR X15, [X14]
      # Save argv pointer (FP + 24)
      a64_add_rri(&mut ctx.text, A64::X15, A64::FP, 24)          # X15 = FP + 24 = &argv[0]
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argv".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X14))
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argv".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 0)
      a64_str(&mut ctx.text, A64::X15, A64::X14, 0)
    when _ then ()
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS: main(argc, argv) — argc in edi (zero-extended in rdi), argv in rsi
      # LEA R11, [RIP + _tg_saved_argc]
      emit8(&mut ctx.text, 0x4C)  # REX.WR (R11 is hi reg)
      emit8(&mut ctx.text, 0x8D)  # LEA
      emit8(&mut ctx.text, 0x1D)  # ModRM: mod=00, reg=R11(011), rm=101(RIP)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argc".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV [R11], RDI
      emit8(&mut ctx.text, 0x49)  # REX.WB (R11 base)
      emit8(&mut ctx.text, 0x89)  # MOV r/m64, r64
      emit8(&mut ctx.text, 0x3B)  # ModRM: mod=00, reg=RDI(111), rm=R11(011)
      # LEA R11, [RIP + _tg_saved_argv]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argv".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV [R11], RSI
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x33)  # ModRM: mod=00, reg=RSI(110), rm=R11(011)
    when OsAbi::Linux then
      # Linux _start: argc at [RBP+16], argv = RBP+24 (after prologue)
      # LEA R11, [RIP + _tg_saved_argc]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argc".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV RAX, [RBP+16]  — argc
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 16)
      # MOV [R11], RAX
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x03)  # ModRM: mod=00, reg=RAX(000), rm=R11(011)
      # LEA R11, [RIP + _tg_saved_argv]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argv".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # LEA RAX, [RBP+24]  — argv pointer
      x64_lea_mem(&mut ctx.text, X64::RAX, X64::RBP, 24)
      # MOV [R11], RAX
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x03)
    when _ then ()
    end
  end  end
end

# ———————————————————————————————————————————————————————————————
# Public API — Full pipeline: MIR → native binary
# ———————————————————————————————————————————————————————————————

def generate_native(program: MirProgram, target: AsmTarget) -> Result[Vec[u8], String]
  var ctx = codegen_new(target)
  match codegen_program(&mut ctx, program)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err("codegen failed: " + e)
  end

  # Reserve 16 bytes in.data for saved argc/argv so the runtime can
  # read them via tg_get_argc / tg_get_argv after the entry point
  # stores the real values at program start.
  emit_argc_argv_data(&mut ctx)
  # Free-list allocator state (heads, outstanding counter, fail flag).
  emit_allocator_runtime_data(&mut ctx)
  # No budget data symbols: the budget counters live in each budgeted
  # function's STACK FRAME (FrameInfo.budget_alloc_offset /
  # budget_time_offset), not in .data — per-invocation, nesting-safe,
  # race-free.

  # Combine text symbols with data, rodata, and BSS symbols so the
  # linker can resolve all cross-section relocations.
  var all_symbols = ctx.text.symbols.clone()
  for sym in ctx.data.symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.rodata.symbols do
    all_symbols.push(sym.clone())
  end
  # Convert rodata labels to symbols (e.g.,.Lstr.0 string constants)
  # NOTE: binding the labels Map to a local first keeps the receiver simple.
  # The two-level field method-receiver projection bug this worked around is
  # fixed by the canonical emit_place_address primitive (see generate_executable).
  let rodata_labels = ctx.rodata.labels
  # Canonicalize Map-derived emission order: collect the label names into a Vec
  # and sort them so the symbol table is identical across runs regardless of
  # the Map's internal bucket order.
  var rodata_names = Vec::new()
  for rname in rodata_labels.keys() do
    rodata_names.push(rname)
  end
  rodata_names.sort()
  for name in rodata_names do
    match rodata_labels.get(name)
    when Option::Some(offset) then
      all_symbols.push(AsmSymbol {
        name: name,
        section: Section::Rodata,
        offset: offset,
        size: 0,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
    when Option::None then ()
    end
  end
  # Convert text labels to symbols for internal references (only local labels)
  let text_labels = ctx.text.labels
  # Canonicalize text-label emission order the same way (deterministic symbols).
  var text_names = Vec::new()
  for tname in text_labels.keys() do
    text_names.push(tname)
  end
  text_names.sort()
  for name in text_names do
    if name.starts_with(".L") then
      match text_labels.get(name)
      when Option::Some(offset) then
        all_symbols.push(AsmSymbol {
          name: name,
          section: Section::Text,
          offset: offset,
          size: 0,
          binding: SymBinding::Local,
          kind: SymKind::Func
        })
      when Option::None then ()
      end
    end
  end

  # Build object file from encoded buffers.
  # NOTE: struct-literal fields are emitted by codegen_aggregate by resolving
  # each operand to the DECLARED offset of the field it NAMES, so the literal
  # order no longer needs to match the ObjectFile declaration order.
  let text_relocs = ctx.text.relocations
  let data_relocs = ctx.data.relocations
  let obj = ObjectFile {
    target: ctx.target,
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: text_relocs.clone(),
    data_relocations: data_relocs.clone(),
    string_table: Vec::new(),
    strings: Map::new()
  }

  let obj_bytes = build_object(&obj)
  Result::Ok(obj_bytes)
end

def generate_executable(program: MirProgram, target: AsmTarget, output_path: String) -> Result[Unit, String]
  var ctx = codegen_new(target)
  match codegen_program(&mut ctx, program)
  when Result::Err(e) then
    return Result::Err(e)
  when Result::Ok(_) then
  end

  # Reserve 16 bytes in.data for saved argc/argv
  emit_argc_argv_data(&mut ctx)
  # Free-list allocator state (heads, outstanding counter, fail flag).
  emit_allocator_runtime_data(&mut ctx)
  # No budget data symbols: the budget counters live in each budgeted
  # function's STACK FRAME (FrameInfo.budget_alloc_offset /
  # budget_time_offset), not in .data — per-invocation, nesting-safe,
  # race-free.

  # Combine symbols from all sections + convert labels to symbols for cross-section refs
  var all_symbols = ctx.text.symbols.clone()
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.rodata.symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.data.symbols do
    all_symbols.push(sym.clone())
  end
  # Convert rodata labels to symbols (e.g.,.Lstr.0 string constants)
  # NOTE: binding the labels Map to a local keeps the receiver simple.
  # The nested field-address projection bug this historically worked around is
  # fixed by the canonical emit_place_address primitive, which applies the
  # FINAL field offset for multi-level places (e.g. `ctx.rodata.labels`), so a
  # method receiver borrows the labels Map rather than the parent CodeBuffer.
  let rodata_labels = ctx.rodata.labels
  # Canonicalize Map-derived emission order: sort the label names so the symbol
  # table is deterministic across runs (independent of Map bucket order).
  var rodata_names = Vec::new()
  for rname in rodata_labels.keys() do
    rodata_names.push(rname)
  end
  rodata_names.sort()
  for name in rodata_names do
    match rodata_labels.get(name)
    when Option::Some(offset) then
      all_symbols.push(AsmSymbol {
        name: name,
        section: Section::Rodata,
        offset: offset,
        size: 0,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
    when Option::None then ()
    end
  end
  # Convert text labels to symbols for internal references (only local labels)
  let text_labels = ctx.text.labels
  # Canonicalize text-label emission order the same way (deterministic symbols).
  var text_names = Vec::new()
  for tname in text_labels.keys() do
    text_names.push(tname)
  end
  text_names.sort()
  for name in text_names do
    if name.starts_with(".L") then
      match text_labels.get(name)
      when Option::Some(offset) then
        all_symbols.push(AsmSymbol {
          name: name,
          section: Section::Text,
          offset: offset,
          size: 0,
          binding: SymBinding::Local,
          kind: SymKind::Func
        })
      when Option::None then ()
      end
    end
  end

  # CRITICAL: struct-literal fields are emitted POSITIONALLY (see generate_native
  # above). List fields in exact ObjectFile declaration order and include ALL of
  # them, or every field shifts by one slot.
  let text_relocs2 = ctx.text.relocations
  let data_relocs2 = ctx.data.relocations
  let obj = ObjectFile {
    target: target.clone(),
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: text_relocs2.clone(),
    data_relocations: data_relocs2.clone(),
    string_table: Vec::new(),
    strings: Map::new()
  }

  # Determine entry point name
  let entry = match target.os
  when OsAbi::MacOS   then "main"
  when OsAbi::Linux   then "_start"
  when OsAbi::Windows then "mainCRTStartup"
  end

  var objects = Vec::new()
  objects.push(obj)

  let input = LinkerInput {
    objects: objects,
    entry: entry.to_string(),
    entry_offset: -1,
    output: output_path,
    target: target.clone()
  }

  let link_result = link_executable(&input)
  link_result
end

def generate_object_file(program: MirProgram, target: AsmTarget) -> Result[Vec[u8], String]
  generate_native(program, target)
end

# ———————————————————————————————————————————————————————————————
# Host target detection
# ———————————————————————————————————————————————————————————————

def detect_host_target() -> AsmTarget
  # Delegate to the canonical host_target() in asm module
  # which checks TG_HOST_TARGET, HOSTTYPE, OSTYPE, and
  # PROCESSOR_ARCHITECTURE env vars with proper fallback.
  #
  # Override with explicit env vars if set:
  let arch_override = std::env::get_env("TG_TARGET_ARCH")
  let os_override   = std::env::get_env("TG_TARGET_OS")
  
  match arch_override
  when Option::Some(arch_str) then
    let fallback_target = host_target()
    let os_str   = os_override.unwrap_or(match fallback_target.os
      when OsAbi::MacOS then "macos"
      when OsAbi::Linux then "linux"
      when OsAbi::Windows then "windows"
    end)
    
    let arch = if arch_str == "x86_64" || arch_str == "amd64" then Arch::X86_64
    elsif arch_str == "aarch64" || arch_str == "arm64" then Arch::AArch64
    else panic("unsupported TG_TARGET_ARCH override: " + arch_str)
    end
    
    let os = if os_str == "macos" || os_str == "darwin" then OsAbi::MacOS
    elsif os_str == "linux" then OsAbi::Linux
    elsif os_str == "windows" then OsAbi::Windows
    else panic("unsupported TG_TARGET_OS override: " + os_str)
    end
    
    asm_target(arch, os)
  when Option::None then
    host_target()
  end
end
