# ———————————————————————————————————————————————————————————————
# Memory Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# mem_alloc: Allocate memory. Args: size. Returns ptr.
def codegen_mem_alloc(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_mem_alloc")
end

# mem_free: Free memory. Args: ptr, size.
def codegen_mem_free(ctx: &mut CodegenCtx) -> Unit
  emit_call_label(ctx, "_tg_mem_free")
end

# mem_copy: Copy memory. Args: dst, src, size.
def codegen_mem_copy(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # Use rep-movsb style byte-by-byte copy
    # x0 = dst, x1 = src, x2 = count
    let lbl_loop = ".Lmemcpy_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemcpy_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save dst
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X2)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X1, A64::X10)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = dst, rsi = src, rdx = count
    # Use rep movsb
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xA4)  # movsb
  end
end

# mem_set: Fill memory with byte value. Args: ptr, value, size.
def codegen_mem_set(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr, x1 = value (byte), x2 = count
    let lbl_loop = ".Lmemset_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemset_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    a64_and_ri(&mut ctx.text, A64::X1, 0xFF)     # Mask to byte
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X2)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::X1, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = ptr, rsi = value, rdx = count
    # Use rep stosb
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xAA)  # stosb
  end
end

# mem_zero: Zero memory. Args: ptr, size.
def codegen_mem_zero(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = ptr, x1 = count
    let lbl_loop = ".Lmemzero_loop." + ctx.fn_counter.to_string()
    let lbl_done = ".Lmemzero_done." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # Counter
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_loop)
    def_label(&mut ctx.text, lbl_done)
    
  when Arch::X86_64 then
    # rdi = ptr, rsi = count
    # Use rep stosb with 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RSI)
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xAA)  # stosb
  end
end

# ———————————————————————————————————————————————————————————————
# Hash Intrinsic Implementations
# ———————————————————————————————————————————————————————————————

# hash_int: Hash an integer. Arg in x0/rdi. Returns hash in x0/rax.
def codegen_hash_int(ctx: &mut CodegenCtx) -> Unit
  # FNV-1a hash for 64-bit integers
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = value
    # FNV offset basis: 0xcbf29ce484222325
    # FNV prime: 0x100000001b3
    a64_mov_ri(&mut ctx.text, A64::X9, 0xcbf29ce484222325 as i64)
    a64_mov_ri(&mut ctx.text, A64::X10, 0x100000001b3 as i64)
    # xor with value
    a64_eor_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X0)
    # multiply by FNV prime
    a64_mul_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X10)
  when Arch::X86_64 then
    # rdi = value
    # Load full 64-bit FNV offset basis
    x64_mov_ri(&mut ctx.text, X64::RAX, 0xcbf29ce484222325 as i64)
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDI)
    # Multiply by FNV prime (0x100000001b3)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0x100000001b3 as i64)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# hash_str: Hash a null-terminated string. Arg in x0/rdi. Returns hash in x0/rax.
def codegen_hash_str(ctx: &mut CodegenCtx) -> Unit
  # FNV-1a hash for strings
  let lbl_loop = ".Lhashstr_loop." + ctx.fn_counter.to_string()
  let lbl_done = ".Lhashstr_done." + ctx.fn_counter.to_string()
  ctx.fn_counter = ctx.fn_counter + 1

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = str ptr, x1 = hash accumulator
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # Save ptr
    a64_mov_ri(&mut ctx.text, A64::X1, 0xcbf29ce484222325 as i64)  # FNV-1a 64-bit basis
    
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    # xor hash with byte
    a64_eor_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X10)
    # multiply by FNV-1a 64-bit prime (0x100000001b3)
    a64_mov_ri(&mut ctx.text, A64::X10, 0x100000001b3 as i64)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X10)
    # next char
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop)
    
    def_label(&mut ctx.text, lbl_done)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
    
  when Arch::X86_64 then
    # rdi = str ptr, rcx = hash accumulator
    x64_mov_ri(&mut ctx.text, X64::RCX, 0xcbf29ce484222325 as i64)  # FNV-1a 64-bit basis
    
    def_label(&mut ctx.text, lbl_loop.clone())
    # movzx edx, byte [rdi]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x17)
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    # xor hash with byte
    x64_xor_rr(&mut ctx.text, X64::RCX, X64::RDX)
    # multiply by FNV-1a 64-bit prime (0x100000001b3)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0x100000001b3 as i64)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    # next char
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_jmp(&mut ctx.text, lbl_loop)
    
    def_label(&mut ctx.text, lbl_done)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
  end
end

# hash_combine: Combine two hash values. Args: hash1, hash2. Returns combined hash.
def codegen_hash_combine(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = h1, x1 = h2
    # Combine: h1 ^= h2 + 0x9e3779b9 + (h1 << 6) + (h1 >> 2)
    a64_lsl(&mut ctx.text, A64::X2, A64::X0, 6)    # x2 = h1 << 6
    a64_lsr(&mut ctx.text, A64::X3, A64::X0, 2)    # x3 = h1 >> 2
    a64_mov_ri(&mut ctx.text, A64::X4, 0x9e3779b9)  # x4 = golden ratio constant
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X1, A64::X4)  # x4 = h2 + constant
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X4, A64::X2)  # x4 += (h1 << 6)
    a64_add_rrr(&mut ctx.text, A64::X4, A64::X4, A64::X3)  # x4 += (h1 >> 2)
    a64_eor_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X4)  # h1 ^= x4
  when Arch::X86_64 then
    # rdi = h1, rsi = h2
    # Combine: h1 ^= h2 + 0x9e3779b9 + (h1 << 6) + (h1 >> 2)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)   # rdx = h1
    x64_shl_ri(&mut ctx.text, X64::RDX, 6)           # rdx = h1 << 6
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)   # rcx = h1
    x64_shr_ri(&mut ctx.text, X64::RCX, 2)           # rcx = h1 >> 2
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x9e3779b9)  # rax = golden ratio constant
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RSI)    # rax += h2
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)    # rax += (h1 << 6)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)    # rax += (h1 >> 2)
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDI)    # rax = h1 ^ rax
  end
end

# ———————————————————————————————————————————————————————————————
# Program code generation
# ———————————————————————————————————————————————————————————————

def codegen_program(ctx: &mut CodegenCtx, program: &MirProgram) -> Result[Unit, String]
  # Build type layout map and field layouts from MIR type definitions (single LayoutEngine pass)
  let (type_layout, field_offsets, field_sizes, field_name_index) = build_all_layouts(&program.types, &ctx.target)
  ctx.type_layout = type_layout
  ctx.type_field_offsets = field_offsets
  ctx.type_field_sizes = field_sizes
  ctx.type_field_name_index = field_name_index
  ctx.type_defs = program.types.clone()
  # Reference the MIR functions/statics directly for all codegen passes in this routine.
  # program is an immutable borrow and is never mutated here, so a borrow is both
  # safe and avoids a whole-MirFunction deep clone (which miscompiles in this build,
  # corrupting fields like ret_type for some functions, e.g. default_options).
  let functions = &program.functions
  let statics = &program.statics

  # Build O(1) type lookup index
  mut tdi = 0
  while tdi < ctx.type_defs.len() do
    ctx.type_def_index.insert(ctx.type_defs[tdi].id.id, tdi)
    tdi = tdi + 1
  end

  # Build set of extern function names (for call dispatch)
  mut fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    if func.is_extern then
      ctx.extern_fns.insert(func.name.clone())
    end
    fi = fi + 1
  end

  # Compute reachable functions from main
  let reachable = compute_reachable(program)
  ctx.reachable_fns = reachable.clone()

  # Build fn_alias map: maps bare/canonical names to actual compiled function labels.
  # This resolves label mismatches where MIR call refs use bare names (e.g., "read_all")
  # but function bodies are emitted with mangled names (e.g., "File__read_all").
  # First, collect all real function names so we never shadow them with aliases.
  mut real_fn_names: Set[String] = Set::new()
  fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    real_fn_names.insert(func.name.clone())
    fi = fi + 1
  end
  fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    let func_name = func.name.clone()
    if reachable.contains(&func_name) || func.is_extern then
      let bare = bare_name_from_qualified(func_name.clone())
      if bare != func.name && !real_fn_names.contains(&bare) then
        ctx.fn_alias.insert(bare.clone(), func_name.clone())
      end
      let canonical = canonical_fn_ref(func_name.clone())
      if canonical != func.name && canonical != bare && !real_fn_names.contains(&canonical) then
        ctx.fn_alias.insert(canonical.clone(), func_name.clone())
      end
    end
    fi = fi + 1
  end

  # Emit all statics from a stable snapshot (same strategy as functions above).
  mut si = 0
  while si < statics.len() do
    codegen_static(ctx, &statics[si])
    si = si + 1
  end

  # Emit reachable functions + all extern stubs + closures
  # Closures (names starting with _closure) are always emitted if referenced
  # Build set of functions with compiled bodies (non-extern, has blocks)
  # This is used by codegen_call to prefer direct calls over intrinsic inlining
  mut has_body_fns: Set[String] = Set::new()
  fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit && !func.is_extern && func.blocks.len() > 0 then
      has_body_fns.insert(func_name)
    end
    fi = fi + 1
  end
  ctx.reachable_fns = has_body_fns.clone()

  fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit then
      ctx.fn_alias.insert(func_name.clone(), ".Lfn_entry." + fi.to_string())
    end
    fi = fi + 1
  end

  fi = 0
  while fi < functions.len() do
    let func = &functions[fi]
    # Emit if: reachable OR _start OR extern OR closure (closures are always emitted when present)
    let func_name = func.name.clone()
    let is_closure = func_name.starts_with("_closure")
    let should_emit = reachable.contains(&func_name) || func_name == "_start" || func.is_extern || is_closure
    if should_emit then
      codegen_function(ctx, func)
    end
    fi = fi + 1
  end
  emit_pending_enum_eq_helpers(ctx)

  # Emit runtime helper functions
  emit_runtime_str_concat(ctx)
  emit_runtime_str_chars(ctx)
  
  # Emit full runtime library (arrays, maps, sets, memory, string conversion)
  # Runtime is compiled into its own CodeBuffer and then merged into the main
  # text section.  This avoids interpreter issues with nested &mut references
  # through the RuntimeEmitCtx wrapper and is also the standard pattern for
  # separate compilation units that are linked together.
  mut runtime_ctx = runtime_ctx_new(ctx.target.clone())
  emit_all_runtime(&mut runtime_ctx)
  merge_code_buffer(&mut ctx.text, &runtime_ctx.text)

  # Emit stub function bodies for referenced-but-uncompiled labels.
  # These are intrinsics or unreachable functions whose addresses are taken
  # (via MirFnItem in assignments) but have no real body.
  # Emitting a simple RET stub prevents unresolved label errors at fixup.
  mut fi = 0
  while fi < ctx.text.fixups.len() do
    let f = ctx.text.fixups[fi]
    match ctx.text.labels.get(f.label)
    when Option::None then
      # Label not defined yet — emit a stub function (just RET)
      align_to(&mut ctx.text, 4, ctx.target.arch)
      def_label(&mut ctx.text, f.label.clone())
      emit_ret(ctx)
    when Option::Some(_) then ()
    end
    fi = fi + 1
  end

  # Resolve local branch fixups
  match resolve_fixups(&mut ctx.text)
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(e) then Result::Err("codegen fixup error: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# Argc/Argv Data Section Storage
# ———————————————————————————————————————————————————————————————

# Allocate two 8-byte slots in .data for the saved argc and argv.
# The entry point writes the real values here and the runtime
# tg_get_argc / tg_get_argv stubs read from them via relocations.
def emit_argc_argv_data(ctx: &mut CodegenCtx) -> Unit
  # Align data to 8 bytes
  while (buf_pos(&ctx.data) % 8) != 0 do
    emit8(&mut ctx.data, 0)
  end
  # _tg_saved_argc (8 bytes, initialized to 0)
  let argc_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_argc".to_string(),
    section: Section::Data,
    offset: argc_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_argc".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_saved_argv (8 bytes, initialized to 0)
  let argv_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_argv".to_string(),
    section: Section::Data,
    offset: argv_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_argv".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_saved_envp (8 bytes, initialized to 0) — envp pointer for getenv
  let envp_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_saved_envp".to_string(),
    section: Section::Data,
    offset: envp_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_saved_envp".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_bump_ptr (8 bytes, initialized to 0) — bump allocator current pointer
  let bump_ptr_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_bump_ptr".to_string(),
    section: Section::Data,
    offset: bump_ptr_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_bump_ptr".to_string())
  emit64_le(&mut ctx.data, 0)

  # _tg_bump_end (8 bytes, initialized to 0) — bump allocator chunk end
  let bump_end_off = buf_pos(&ctx.data)
  add_symbol(&mut ctx.data, AsmSymbol {
    name: "_tg_bump_end".to_string(),
    section: Section::Data,
    offset: bump_end_off,
    size: 8,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  def_label(&mut ctx.data, "_tg_bump_end".to_string())
  emit64_le(&mut ctx.data, 0)
end

# Emit code at the start of main() to save the ABI-provided argc/argv
# into _tg_saved_argc / _tg_saved_argv in the .data section.
# On macOS the entry point `main` receives argc in x0/edi and argv in x1/rsi.
# On Linux `_start` receives argc at [sp] and argv at sp+8 — those are read
# from the Frame Pointer after the prologue adjusts SP.
def emit_save_argc_argv(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS: main(argc, argv) — argc in x0, argv in x1
      # Save argc
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argc".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argc".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X0, A64::X15, 0)               # STR X0, [X15]
      # Save argv
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argv".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argv".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X1, A64::X15, 0)               # STR X1, [X15]
      # Compute envp = argv + (argc + 1) * 8 and save it
      a64_add_rri(&mut ctx.text, A64::X14, A64::X0, 1)           # X14 = argc + 1
      a64_lsl(&mut ctx.text, A64::X14, A64::X14, 3)              # X14 = (argc + 1) * 8
      a64_add_rrr(&mut ctx.text, A64::X14, A64::X1, A64::X14)    # X14 = argv + (argc+1)*8 = envp
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_envp".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_envp".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X14, A64::X15, 0)              # STR X14, [X15]
      # Pre-allocate the bump arena ONCE at a fixed high address.
      # A per-call mmap-based grow path returned the same overlapping
      # chunk every time on this platform, so every allocation aliased
      # 0x100ae8000 and corrupted live objects.  Allocating a single
      # fixed-address arena at startup and bumping within it avoids
      # address-space overlap entirely.
      # mmap(0x600000000, 256MB, PROT_READ|PROT_WRITE, MAP_FIXED|MAP_PRIVATE|MAP_ANON, -1, 0)
      a64_mov_ri(&mut ctx.text, A64::X0, 0x600000000)
      a64_mov_ri(&mut ctx.text, A64::X1, 0x10000000)
      a64_mov_ri(&mut ctx.text, A64::X2, 3)
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1012)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
      # _tg_bump_ptr = 0x600000000, _tg_bump_end = 0x600000000 + 256MB
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_bump_ptr".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_bump_ptr".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_mov_ri(&mut ctx.text, A64::X14, 0x600000000)
      a64_str(&mut ctx.text, A64::X14, A64::X15, 0)              # STR X14, [X15]
      a64_mov_ri(&mut ctx.text, A64::X14, 0x610000000)
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_bump_end".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X15))  # ADRP X15, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_bump_end".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0)          # ADD X15, X15, :lo12:...
      a64_str(&mut ctx.text, A64::X14, A64::X15, 0)              # STR X14, [X15]
    when OsAbi::Linux then
      # Linux _start: argc at [FP+16], argv = FP + 24 (after prologue)
      # FP was set to SP by the prologue; the kernel placed argc at [original_sp]
      # and argv at [original_sp+8..].  After STP FP,LR,[SP,#-16]!, original_sp = FP+16.
      # Save argc
      a64_ldur(&mut ctx.text, A64::X15, A64::FP, 16)             # LDR X15, [FP, #16]  — argc
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argc".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X14))  # ADRP X14, ...
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argc".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 0)
      a64_str(&mut ctx.text, A64::X15, A64::X14, 0)              # STR X15, [X14]
      # Save argv pointer (FP + 24)
      a64_add_rri(&mut ctx.text, A64::X15, A64::FP, 24)          # X15 = FP + 24 = &argv[0]
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_saved_argv".to_string(), 0)
      emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X14))
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_saved_argv".to_string(), 0)
      a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 0)
      a64_str(&mut ctx.text, A64::X15, A64::X14, 0)
    when _ then ()
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # macOS: main(argc, argv) — argc in edi (zero-extended in rdi), argv in rsi
      # LEA R11, [RIP + _tg_saved_argc]
      emit8(&mut ctx.text, 0x4C)  # REX.WR (R11 is hi reg)
      emit8(&mut ctx.text, 0x8D)  # LEA
      emit8(&mut ctx.text, 0x1D)  # ModRM: mod=00, reg=R11(011), rm=101(RIP)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argc".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV [R11], RDI
      emit8(&mut ctx.text, 0x49)  # REX.WB (R11 base)
      emit8(&mut ctx.text, 0x89)  # MOV r/m64, r64
      emit8(&mut ctx.text, 0x3B)  # ModRM: mod=00, reg=RDI(111), rm=R11(011)
      # LEA R11, [RIP + _tg_saved_argv]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argv".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV [R11], RSI
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x33)  # ModRM: mod=00, reg=RSI(110), rm=R11(011)
    when OsAbi::Linux then
      # Linux _start: argc at [RBP+16], argv = RBP+24 (after prologue)
      # LEA R11, [RIP + _tg_saved_argc]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argc".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # MOV RAX, [RBP+16]  — argc
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 16)
      # MOV [R11], RAX
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x03)  # ModRM: mod=00, reg=RAX(000), rm=R11(011)
      # LEA R11, [RIP + _tg_saved_argv]
      emit8(&mut ctx.text, 0x4C)
      emit8(&mut ctx.text, 0x8D)
      emit8(&mut ctx.text, 0x1D)
      add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_saved_argv".to_string(), -4)
      emit32_le(&mut ctx.text, 0)
      # LEA RAX, [RBP+24]  — argv pointer
      x64_lea_mem(&mut ctx.text, X64::RAX, X64::RBP, 24)
      # MOV [R11], RAX
      emit8(&mut ctx.text, 0x49)
      emit8(&mut ctx.text, 0x89)
      emit8(&mut ctx.text, 0x03)
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Public API — Full pipeline: MIR → native binary
# ———————————————————————————————————————————————————————————————

def generate_native(program: &MirProgram, target: &AsmTarget) -> Vec[u8]
  mut ctx = codegen_new(target)
  codegen_program(&mut ctx, program)

  # Reserve 16 bytes in .data for saved argc/argv so the runtime can
  # read them via tg_get_argc / tg_get_argv after the entry point
  # stores the real values at program start.
  emit_argc_argv_data(&mut ctx)

  # Combine text symbols with data, rodata, and BSS symbols so the
  # linker can resolve all cross-section relocations.
  mut all_symbols = ctx.text.symbols.clone()
  for sym in ctx.data.symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.rodata.symbols do
    all_symbols.push(sym.clone())
  end
  # Convert rodata labels to symbols (e.g., .Lstr.0 string constants)
  # NOTE: bind the labels Map to a local first (see generate_executable) to
  # avoid the two-level field method-receiver projection bug.
  let rodata_labels = ctx.rodata.labels
  for name in rodata_labels.keys() do
    match rodata_labels.get(name)
    when Option::Some(offset) then
      all_symbols.push(AsmSymbol {
        name: name,
        section: Section::Rodata,
        offset: offset,
        size: 0,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
    when Option::None then ()
    end
  end
  # Convert text labels to symbols for internal references (only local labels)
  let text_labels = ctx.text.labels
  for name in text_labels.keys() do
    if name.starts_with(".L") then
      match text_labels.get(name)
      when Option::Some(offset) then
        all_symbols.push(AsmSymbol {
          name: name,
          section: Section::Text,
          offset: offset,
          size: 0,
          binding: SymBinding::Local,
          kind: SymKind::Func
        })
      when Option::None then ()
      end
    end
  end

  # Build object file from encoded buffers.
  # CRITICAL: struct-literal fields are emitted POSITIONALLY by codegen_aggregate
  # (each operand i is stored at type_field_offsets[i]); the field NAMES are
  # ignored. So the literal MUST list fields in the exact ObjectFile declaration
  # order, and include ALL fields. A mismatched order shifts every field by one
  # (e.g. `target` landing in the `data_relocations` slot -> corrupt {1,1} Vec).
  let text_relocs = ctx.text.relocations
  let data_relocs = ctx.data.relocations
  let obj = ObjectFile {
    target: ctx.target,
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: text_relocs.clone(),
    data_relocations: data_relocs.clone(),
    string_table: Vec::new(),
    strings: Map::new()
  }

  build_object(&obj)
end

def generate_executable(program: &MirProgram, target: &AsmTarget, output_path: String) -> Result[Unit, String]
  mut ctx = codegen_new(target)
  match codegen_program(&mut ctx, program)
  when Result::Err(e) then
    return Result::Err(e)
  when Result::Ok(_) then
  end

  # Reserve 16 bytes in .data for saved argc/argv
  emit_argc_argv_data(&mut ctx)

  # Combine symbols from all sections + convert labels to symbols for cross-section refs
  mut all_symbols = ctx.text.symbols.clone()
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.rodata.symbols do
    all_symbols.push(sym.clone())
  end
  for sym in ctx.data.symbols do
    all_symbols.push(sym.clone())
  end
  # Convert rodata labels to symbols (e.g., .Lstr.0 string constants)
  # NOTE: bind the labels Map to a local before calling methods on it.
  # `ctx.rodata.labels.keys()` (a method call on a TWO-level field access)
  # mis-computes the receiver: codegen_address_of drops the final `.labels`
  # field offset and passes &ctx.rodata (the CodeBuffer) instead of the labels
  # Map, so _tg_map_entries reads CodeBuffer fields as buckets/size/capacity
  # and walks garbage (crash in .Lmap_ent_chain). A plain value read into a
  # local (like `e.source_map.files`) projects correctly.
  let rodata_labels = ctx.rodata.labels
  for name in rodata_labels.keys() do
    match rodata_labels.get(name)
    when Option::Some(offset) then
      all_symbols.push(AsmSymbol {
        name: name,
        section: Section::Rodata,
        offset: offset,
        size: 0,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
    when Option::None then ()
    end
  end
  # Convert text labels to symbols for internal references (only local labels)
  let text_labels = ctx.text.labels
  for name in text_labels.keys() do
    if name.starts_with(".L") then
      match text_labels.get(name)
      when Option::Some(offset) then
        all_symbols.push(AsmSymbol {
          name: name,
          section: Section::Text,
          offset: offset,
          size: 0,
          binding: SymBinding::Local,
          kind: SymKind::Func
        })
      when Option::None then ()
      end
    end
  end

  # CRITICAL: struct-literal fields are emitted POSITIONALLY (see generate_native
  # above). List fields in exact ObjectFile declaration order and include ALL of
  # them, or every field shifts by one slot.
  let text_relocs2 = ctx.text.relocations
  let data_relocs2 = ctx.data.relocations
  let obj = ObjectFile {
    target: target.clone(),
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: text_relocs2.clone(),
    data_relocations: data_relocs2.clone(),
    string_table: Vec::new(),
    strings: Map::new()
  }

  # Determine entry point name
  let entry = match target.os
  when OsAbi::MacOS   then "main"
  when OsAbi::Linux   then "_start"
  when OsAbi::Windows then "mainCRTStartup"
  end

  mut objects = Vec::new()
  objects.push(obj)

  let input = LinkerInput {
    objects: objects,
    entry: entry.to_string(),
    entry_offset: -1,
    output: output_path,
    target: target.clone()
  }

  let link_result = link_executable(&input)
  link_result
end

def generate_object_file(program: &MirProgram, target: &AsmTarget) -> Vec[u8]
  generate_native(program, target)
end

# ———————————————————————————————————————————————————————————————
# Host target detection
# ———————————————————————————————————————————————————————————————

def detect_host_target() -> AsmTarget
  # Delegate to the canonical host_target() in asm module
  # which checks TG_HOST_TARGET, HOSTTYPE, OSTYPE, and
  # PROCESSOR_ARCHITECTURE env vars with proper fallback.
  #
  # Override with explicit env vars if set:
  let arch_override = std::env::get_env("TG_TARGET_ARCH")
  let os_override   = std::env::get_env("TG_TARGET_OS")
  
  match arch_override
  when Option::Some(arch_str) then
    let fallback_target = host_target()
    let os_str   = os_override.unwrap_or(match fallback_target.os
      when OsAbi::MacOS then "macos"
      when OsAbi::Linux then "linux"
      when OsAbi::Windows then "windows"
    end)
    
    let arch = if arch_str == "x86_64" || arch_str == "amd64" then Arch::X86_64
    elsif arch_str == "aarch64" || arch_str == "arm64" then Arch::AArch64
    else panic("unsupported TG_TARGET_ARCH override: " + arch_str)
    end
    
    let os = if os_str == "macos" || os_str == "darwin" then OsAbi::MacOS
    elsif os_str == "linux" then OsAbi::Linux
    elsif os_str == "windows" then OsAbi::Windows
    else panic("unsupported TG_TARGET_OS override: " + os_str)
    end
    
    asm_target(arch, os)
  when Option::None then
    host_target()
  end
end
