# Tangerine Compiler — Native Code Generator
# Self-hosting compiler written in Tangerine
#
# Lowers MIR to machine code — NO C, NO external language dependency.
# Generates native x86-64 or ARM64 instructions via asm.tg, then
# packages into object files via object.tg and links via linker.tg.
#
# Pipeline:  MIR → Register Allocation → Instruction Selection → Object → Link → Executable

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{write_file_bytes}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirBlock, MirLocal, MirStatic,
  MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef,
  MirStatement, MirStatementKind,
  MirTerminator, MirTerminatorKind,
  MirRvalue, MirRvalueKind,
  MirOperand, MirOperandKind,
  MirConstant, MirConstantKind,
  MirBinOp, MirUnOp, CastKind,
  AggregateKind, SwitchTarget, AssertMessage,
  Place, Projection, LocalId, BlockId, MirContractKind
}
use tg_compiler::asm::{
  CodeBuffer, buf_new, buf_pos, emit8, emit32_le, emit64_le,
  def_label, add_fixup, add_reloc, add_symbol, resolve_fixups, align_to,
  Arch, OsAbi, AsmTarget, Section, SymBinding, SymKind, AsmSymbol,
  FixupKind, RelocKind, CC,
  X64, x64_code, x64_arg_reg, x64_callee_saved,
  x64_mov_ri, x64_mov_rr, x64_mov_rm, x64_mov_mr,
  x64_add_rr, x64_add_ri, x64_sub_rr, x64_sub_ri,
  x64_imul_rr, x64_cqo, x64_idiv_r,
  x64_and_rr, x64_or_rr, x64_xor_rr,
  x64_shl_rcl, x64_shr_rcl, x64_sar_rcl,
  x64_neg_r, x64_not_r,
  x64_cmp_rr, x64_cmp_ri, x64_test_rr,
  x64_setcc, x64_movzx_r64_r8,
  x64_jmp, x64_jcc, x64_call_label, x64_call_extern, x64_call_r, x64_jmp_r,
  x64_ret, x64_push, x64_pop,
  x64_lea_rip, x64_lea_mem,
  x64_syscall, x64_ud2, x64_int3, x64_nop,
  host_target
}
use tg_compiler::object::{ObjectFile, build_object}
use tg_compiler::linker::{LinkerInput, link_executable, perform_link}

# ———————————————————————————————————————————————————————————————
# Code Generation Context
# ———————————————————————————————————————————————————————————————

# Architecture-independent register handle.
# Wraps either an x86-64 or ARM64 physical register.
enum PhysReg
  X64Reg(X64)
  A64Reg(A64)
end

# Register allocation slot for a MIR local
enum VarLoc
  Register(PhysReg)   # in a physical register
  Stack(i32)          # at [FP + disp]
  Spilled(i32)        # forced to stack
end

struct FrameInfo
  stack_size: Int           # total frame size (bytes, 16-aligned)
  local_offsets: Map[Int, i32]   # LocalId.id -> FP offset
  spill_offset: i32         # current spill position
  saved_regs: Vec[PhysReg]  # callee-saved regs used
end

struct FnCodegenCtx
  func: MirFunction
  frame: FrameInfo
  var_locs: Map[Int, VarLoc]     # LocalId.id -> VarLoc
  block_labels: Map[Int, String] # BlockId.id -> label name
end

struct CodegenCtx
  target: AsmTarget
  text: CodeBuffer
  data: CodeBuffer
  rodata: CodeBuffer
  # Track BSS size for uninitialized globals
  bss_size: Int
  bss_symbols: Vec[AsmSymbol]  # Symbols in .bss
  string_pool: Map[String, String]  # literal -> label
  string_counter: Int
  fn_counter: Int
  type_layout: Map[Int, Int]    # TypeId.id -> byte size
end

# ———————————————————————————————————————————————————————————————
# Type layout
# ———————————————————————————————————————————————————————————————

def type_size(ty: &Type, layout: &Map[Int, Int]) -> Int
  match ty
  when Type::Unit    then 0
  when Type::Bool    then 1
  when Type::Char    then 4
  when Type::Int     then 8
  when Type::Float   then 8
  when Type::String  then 24   # ptr + len + cap
  when Type::Never   then 0
  when Type::Ref(_, _)     then 8
  when Type::RefMut(_, _)  then 8
  when Type::Owned(_)      then 8
  when Type::Tuple(fields) then
    mut total = 0
    mut max_align = 1
    for f in fields do
      let sz = type_size(f, layout)
      let align = type_align(f)
      if align > max_align then max_align = align end
      # Pad to alignment
      let rem = total % align
      if rem != 0 then total = total + (align - rem) end
      total = total + sz
    end
    # Pad to overall alignment
    let rem = total % max_align
    if rem != 0 then total = total + (max_align - rem) end
    total
  when Type::Array(elem, count) then type_size(elem, layout) * count
  when Type::Slice(_) then 16    # ptr + len
  when Type::Named(tid, _) then
    match layout.get(tid.id)
    when Option::Some(sz) then sz
    when Option::None then 8  # fallback for unknown types
    end
  when Type::Function(_, _) then 8  # Function pointer
  when Type::Var(_) then 8      # Unknown; default to pointer size
  when Type::Error then 0
  end
end

def type_align(ty: &Type) -> Int
  match ty
  when Type::Unit    then 1
  when Type::Bool    then 1
  when Type::Char    then 4
  when _             then 8
  end
end

def align_up_int(v: Int, align: Int) -> Int
  ((v + align - 1) / align) * align
end

def build_type_layout(types: &Vec[MirTypeDef]) -> Map[Int, Int]
  mut layout: Map[Int, Int] = Map::new()
  # First pass: insert 0 for all type ids to break potential cycles
  for td in types do
    layout.insert(td.id.id, 0)
  end
  # Second pass: compute real sizes
  for td in types do
    let sz = match td.kind
    when MirTypeDefKind::Struct(fields) then
      mut total = 0
      mut max_align = 1
      for f in fields do
        let fsz = type_size(&f.ty, &layout)
        let fa = type_align(&f.ty)
        if fa > max_align then max_align = fa end
        let rem = total % fa
        if rem != 0 then total = total + (fa - rem) end
        total = total + fsz
      end
      let rem = total % max_align
      if rem != 0 then total = total + (max_align - rem) end
      total
    when MirTypeDefKind::Enum(variants) then
      # tag (8 bytes) + max payload
      mut max_payload = 0
      for v in variants do
        mut payload = 0
        for fty in v.fields do
          payload = payload + type_size(fty, &layout)
        end
        if payload > max_payload then max_payload = payload end
      end
      8 + max_payload
    end
    layout.insert(td.id.id, sz)
  end
  layout
end

# ———————————————————————————————————————————————————————————————
# Allocatable general-purpose registers (architecture-dispatched)
# ———————————————————————————————————————————————————————————————

# x86-64: avoid RAX (return/scratch), RSP (stack), RBP (frame).
def x64_allocatable_regs() -> Vec[PhysReg]
  mut regs = Vec::new()
  regs.push(PhysReg::X64Reg(X64::RCX))
  regs.push(PhysReg::X64Reg(X64::RDX))
  regs.push(PhysReg::X64Reg(X64::RSI))
  regs.push(PhysReg::X64Reg(X64::RDI))
  regs.push(PhysReg::X64Reg(X64::R8))
  regs.push(PhysReg::X64Reg(X64::R9))
  regs.push(PhysReg::X64Reg(X64::R10))
  regs.push(PhysReg::X64Reg(X64::RBX))
  regs.push(PhysReg::X64Reg(X64::R12))
  regs.push(PhysReg::X64Reg(X64::R13))
  regs.push(PhysReg::X64Reg(X64::R14))
  regs.push(PhysReg::X64Reg(X64::R15))
  regs
end

# ARM64: avoid X0 (return), X16-X17 (IP0/IP1 linker scratch),
# X18 (platform), FP(X29), LR(X30), SP.
def a64_allocatable_regs() -> Vec[PhysReg]
  mut regs = Vec::new()
  # Callee-saved registers first (safe across calls)
  regs.push(PhysReg::A64Reg(A64::X19))
  regs.push(PhysReg::A64Reg(A64::X20))
  regs.push(PhysReg::A64Reg(A64::X21))
  regs.push(PhysReg::A64Reg(A64::X22))
  regs.push(PhysReg::A64Reg(A64::X23))
  regs.push(PhysReg::A64Reg(A64::X24))
  regs.push(PhysReg::A64Reg(A64::X25))
  regs.push(PhysReg::A64Reg(A64::X26))
  regs.push(PhysReg::A64Reg(A64::X27))
  regs.push(PhysReg::A64Reg(A64::X28))
  regs
end

def allocatable_regs(arch: Arch) -> Vec[PhysReg]
  match arch
  when Arch::X86_64  then x64_allocatable_regs()
  when Arch::AArch64 then a64_allocatable_regs()
  end
end

def phys_is_callee_saved(r: PhysReg) -> Bool
  match r
  when PhysReg::X64Reg(xr) then is_callee_saved(xr)
  when PhysReg::A64Reg(ar) then
    match ar
    when A64::X19 then true; when A64::X20 then true; when A64::X21 then true
    when A64::X22 then true; when A64::X23 then true; when A64::X24 then true
    when A64::X25 then true; when A64::X26 then true; when A64::X27 then true
    when A64::X28 then true
    when _ then false
    end
  end
end

def phys_reg_id(r: PhysReg) -> Int
  match r
  when PhysReg::X64Reg(xr) then x64_code(xr) as Int
  when PhysReg::A64Reg(ar) then a64_code(ar) as Int
  end
end

# Scratch register (not allocatable, used for temporaries)
def scratch_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::R11)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X15)
  end
end

# Return value register
def ret_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RAX)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X0)
  end
end

# Argument registers for calling convention
def arg_reg(arch: Arch, i: Int) -> Option[PhysReg]
  match arch
  when Arch::X86_64 then
    match x64_arg_reg(i)
    when Option::Some(r) then Option::Some(PhysReg::X64Reg(r))
    when Option::None then Option::None
    end
  when Arch::AArch64 then
    match a64_arg_reg(i)
    when Option::Some(r) then Option::Some(PhysReg::A64Reg(r))
    when Option::None then Option::None
    end
  end
end

def max_reg_args(arch: Arch) -> Int
  match arch
  when Arch::X86_64  then 6
  when Arch::AArch64 then 8
  end
end

# ———————————————————————————————————————————————————————————————
# Register Allocator (linear-scan style, simplified)
# ———————————————————————————————————————————————————————————————

struct RegAllocState
  free_regs: Vec[PhysReg]
  used_callee: Set[Int]     # phys_reg_id values of callee-saved regs in use
  assignments: Map[Int, VarLoc]
  arch: Arch
end

def reg_alloc_new(arch: Arch) -> RegAllocState
  RegAllocState {
    free_regs: allocatable_regs(arch),
    used_callee: Set::new(),
    assignments: Map::new(),
    arch: arch
  }
end

def alloc_reg(state: &mut RegAllocState) -> Option[PhysReg]
  if state.free_regs.is_empty() then
    return Option::None
  end
  match state.free_regs.pop()
  when Option::Some(r) then
    if phys_is_callee_saved(r) then
      state.used_callee.insert(phys_reg_id(r))
    end
    Option::Some(r)
  when Option::None then
    Option::None
  end
end

# Allocate a register with spill support: if no free regs, spill one
def alloc_reg_or_spill(state: &mut RegAllocState, ctx: &mut CodegenCtx, frame: &mut FrameInfo) -> PhysReg
  match alloc_reg(state)
  when Option::Some(r) then r
  when Option::None then
    # No free registers — find an in-use register, spill its value to the
    # stack, and reclaim it.  Pick the first register-allocated variable
    # found in the assignments map.
    mut spill_victim_id = -1
    mut spill_reg = scratch_reg(state.arch)
    for entry in state.assignments do
      match entry.1
      when VarLoc::Register(r) then
        spill_victim_id = entry.0
        spill_reg = r
        break
      when _ then ()
      end
    end
    if spill_victim_id >= 0 then
      # Allocate a spill slot on the stack.
      let fp = fp_reg(state.arch)
      frame.spill_offset = frame.spill_offset - 8
      let offset = frame.spill_offset
      emit_store_mem(ctx, fp, offset, spill_reg)
      state.assignments.insert(spill_victim_id, VarLoc::Spilled(offset))
      frame.local_offsets.insert(spill_victim_id, offset)
    end
    spill_reg
  end
end

# Reload a spilled value from the stack
def reload_spill(ctx: &mut CodegenCtx, sp: PhysReg, offset: i32, dst: PhysReg) -> Unit
  emit_load_mem(ctx, dst, sp, offset)
end

def free_reg(state: &mut RegAllocState, r: PhysReg) -> Unit
  state.free_regs.push(r)
end

def collect_saved_regs(state: &RegAllocState, arch: Arch) -> Vec[PhysReg]
  mut saved: Vec[PhysReg] = Vec::new()
  match arch
  when Arch::X86_64 then
    if state.used_callee.contains(x64_code(X64::RBX) as Int) then saved.push(PhysReg::X64Reg(X64::RBX)) end
    if state.used_callee.contains(x64_code(X64::R12) as Int) then saved.push(PhysReg::X64Reg(X64::R12)) end
    if state.used_callee.contains(x64_code(X64::R13) as Int) then saved.push(PhysReg::X64Reg(X64::R13)) end
    if state.used_callee.contains(x64_code(X64::R14) as Int) then saved.push(PhysReg::X64Reg(X64::R14)) end
    if state.used_callee.contains(x64_code(X64::R15) as Int) then saved.push(PhysReg::X64Reg(X64::R15)) end
  when Arch::AArch64 then
    if state.used_callee.contains(a64_code(A64::X19) as Int) then saved.push(PhysReg::A64Reg(A64::X19)) end
    if state.used_callee.contains(a64_code(A64::X20) as Int) then saved.push(PhysReg::A64Reg(A64::X20)) end
    if state.used_callee.contains(a64_code(A64::X21) as Int) then saved.push(PhysReg::A64Reg(A64::X21)) end
    if state.used_callee.contains(a64_code(A64::X22) as Int) then saved.push(PhysReg::A64Reg(A64::X22)) end
    if state.used_callee.contains(a64_code(A64::X23) as Int) then saved.push(PhysReg::A64Reg(A64::X23)) end
    if state.used_callee.contains(a64_code(A64::X24) as Int) then saved.push(PhysReg::A64Reg(A64::X24)) end
    if state.used_callee.contains(a64_code(A64::X25) as Int) then saved.push(PhysReg::A64Reg(A64::X25)) end
    if state.used_callee.contains(a64_code(A64::X26) as Int) then saved.push(PhysReg::A64Reg(A64::X26)) end
    if state.used_callee.contains(a64_code(A64::X27) as Int) then saved.push(PhysReg::A64Reg(A64::X27)) end
    if state.used_callee.contains(a64_code(A64::X28) as Int) then saved.push(PhysReg::A64Reg(A64::X28)) end
  end
  saved
end

def saved_reg_bytes(saved: &Vec[PhysReg]) -> Int
  mut count = 0
  for _ in *saved do
    count = count + 1
  end
  count * 8
end

def allocate_locals(func: &MirFunction, arch: Arch, layout: &Map[Int, Int]) -> (Map[Int, VarLoc], FrameInfo)
  mut ra = reg_alloc_new(arch)
  mut local_offsets: Map[Int, Int] = Map::new()
  mut var_locs: Map[Int, VarLoc] = Map::new()
  mut spill_off: i32 = 0  # next spill starts at [fp - 8]

  # Try to give each local a register; spill when exhausted
  for local in func.locals do
    let sz = type_size(&local.ty, layout)
    if sz == 0 then
      var_locs.insert(local.id.id, VarLoc::Stack(0))
      next
    end

    match alloc_reg(&mut ra)
    when Option::Some(r) then
      var_locs.insert(local.id.id, VarLoc::Register(r))
    when Option::None then
      let aligned_sz = align_up_int(sz, 8)
      spill_off = spill_off - aligned_sz as i32
      var_locs.insert(local.id.id, VarLoc::Spilled(spill_off))
      local_offsets.insert(local.id.id, spill_off)
    end
  end

  # Allocate storage for params — callee-saved registers or spill slots.
  # The prologue will move from ABI arg regs into these locations.
  mut arg_idx = 0
  for param in func.params do
    let sz = type_size(&param.ty, layout)
    if sz == 0 then
      var_locs.insert(param.id.id, VarLoc::Stack(0))
    else
      match alloc_reg(&mut ra)
      when Option::Some(r) then
        var_locs.insert(param.id.id, VarLoc::Register(r))
      when Option::None then
        let aligned_sz = align_up_int(sz, 8)
        spill_off = spill_off - aligned_sz as i32
        var_locs.insert(param.id.id, VarLoc::Spilled(spill_off))
      end
    end
    arg_idx = arg_idx + 1
  end

  # Collect callee-saved regs used
  let saved = collect_saved_regs(&ra, arch)

  # Calculate total frame size
  let spill_bytes = if spill_off < 0 then (-spill_off) as Int else 0 end
  let save_bytes = saved_reg_bytes(&saved)
  let raw_size = spill_bytes + save_bytes
  let stack_size = align_up_int(raw_size, 16)

  let frame = FrameInfo {
    stack_size: stack_size,
    local_offsets: local_offsets,
    spill_offset: spill_off,
    saved_regs: saved
  }

  (var_locs, frame)
end

# ———————————————————————————————————————————————————————————————
# Code Generation — Context Creation
# ———————————————————————————————————————————————————————————————

def codegen_new(target: AsmTarget) -> CodegenCtx
  CodegenCtx {
    target: target,
    text: buf_new(),
    data: buf_new(),
    rodata: buf_new(),
    bss_size: 0,
    bss_symbols: Vec::new(),
    string_pool: Map::new(),
    string_counter: 0,
    fn_counter: 0,
    type_layout: Map::new()
  }
end

# Intern a string literal, return label for the constant
def intern_string(ctx: &mut CodegenCtx, s: &String) -> String
  match ctx.string_pool.get(s)
  when Option::Some(label) then return label
  when Option::None then ()
  end

  let label = ".Lstr." + ctx.string_counter.to_string()
  ctx.string_counter = ctx.string_counter + 1
  ctx.string_pool.insert(s.clone(), label.clone())

  # Emit string bytes into rodata
  def_label(&mut ctx.rodata, label.clone())
  for byte in s.bytes() do
    emit8(&mut ctx.rodata, byte)
  end
  emit8(&mut ctx.rodata, 0)  # null terminator

  label
end

# ———————————————————————————————————————————————————————————————
# Architecture-dispatched instruction emission
# ———————————————————————————————————————————————————————————————

# MOV reg, immediate
def emit_mov_ri(ctx: &mut CodegenCtx, dst: PhysReg, imm: i64) -> Unit
  match dst
  when PhysReg::X64Reg(r) then x64_mov_ri(&mut ctx.text, r, imm)
  when PhysReg::A64Reg(r) then a64_mov_ri(&mut ctx.text, r, imm)
  end
end

# MOV reg, reg
def emit_mov_rr(ctx: &mut CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(d) then
    match src
    when PhysReg::X64Reg(s) then x64_mov_rr(&mut ctx.text, d, s)
    when _ then panic("emit_mov_rr: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match src
    when PhysReg::A64Reg(s) then a64_mov_rr(&mut ctx.text, d, s)
    when _ then panic("emit_mov_rr: mixed architectures")
    end
  end
end

# LOAD reg, [base + offset]
def emit_load_mem(ctx: &mut CodegenCtx, dst: PhysReg, base: PhysReg, offset: i32) -> Unit
  match dst
  when PhysReg::X64Reg(d) then
    match base
    when PhysReg::X64Reg(b) then x64_mov_rm(&mut ctx.text, d, b, offset)
    when _ then panic("emit_load_mem: mixed architectures")
    end
  when PhysReg::A64Reg(d) then
    match base
    when PhysReg::A64Reg(b) then
      if offset >= 0 && (offset % 8) == 0 && offset < 32768 then
        a64_ldr(&mut ctx.text, d, b, offset as u32)
      else
        a64_ldur(&mut ctx.text, d, b, offset)
      end
    when _ then panic("emit_load_mem: mixed architectures")
    end
  end
end

# STORE [base + offset], reg
def emit_store_mem(ctx: &mut CodegenCtx, base: PhysReg, offset: i32, src: PhysReg) -> Unit
  match base
  when PhysReg::X64Reg(b) then
    match src
    when PhysReg::X64Reg(s) then x64_mov_mr(&mut ctx.text, b, offset, s)
    when _ then panic("emit_store_mem: mixed architectures")
    end
  when PhysReg::A64Reg(b) then
    match src
    when PhysReg::A64Reg(s) then
      if offset >= 0 && (offset % 8) == 0 && offset < 32768 then
        a64_str(&mut ctx.text, s, b, offset as u32)
      else
        a64_stur(&mut ctx.text, s, b, offset)
      end
    when _ then panic("emit_store_mem: mixed architectures")
    end
  end
end

# Frame pointer register
def fp_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RBP)
  when Arch::AArch64 then PhysReg::A64Reg(A64::FP)
  end
end

# Stack pointer register
def sp_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::RSP)
  when Arch::AArch64 then PhysReg::A64Reg(A64::SP)
  end
end

# Second scratch register (for binop RHS etc.)
def scratch2_reg(arch: Arch) -> PhysReg
  match arch
  when Arch::X86_64  then PhysReg::X64Reg(X64::R10)
  when Arch::AArch64 then PhysReg::A64Reg(A64::X14)
  end
end

# XOR/zero a register
def emit_zero_reg(ctx: &mut CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_xor_rr(&mut ctx.text, xr, xr)
  when PhysReg::A64Reg(ar) then a64_mov_rr(&mut ctx.text, ar, A64::XZR)
  end
end

# Load 64-bit float from stack into GPR (for float operations through GPR)
def emit_load_fp_from_stack(ctx: &mut CodegenCtx, dst: PhysReg, base: PhysReg, offset: i32) -> Unit
  emit_load_mem(ctx, dst, base, offset)
end

# Emit a fixed 5-byte sequence directly into the text segment.
def emit_raw_bytes(ctx: &mut CodegenCtx, b0: u8, b1: u8, b2: u8, b3: u8, b4: u8) -> Unit
  emit8(&mut ctx.text, b0)
  emit8(&mut ctx.text, b1)
  emit8(&mut ctx.text, b2)
  emit8(&mut ctx.text, b3)
  emit8(&mut ctx.text, b4)
end

# Emit raw 32-bit value (for ARM64 instructions)
def emit_raw_u32(ctx: &mut CodegenCtx, val: u32) -> Unit
  emit32_le(&mut ctx.text, val)
end

# Extract ARM64 register code from a GPR PhysReg
def a64_code_from_gpr(r: PhysReg) -> u32
  match r
  when PhysReg::A64Reg(ar) then a64_code(ar)
  when _ then 0
  end
end

# AND register with immediate (for truncation masks)
def emit_and_ri(ctx: &mut CodegenCtx, r: PhysReg, imm: i32) -> Unit
  match r
  when PhysReg::X64Reg(xr) then
    x64_and_ri(&mut ctx.text, xr, imm)
  when PhysReg::A64Reg(ar) then
    a64_and_ri(&mut ctx.text, ar, imm as u32)
  end
end

# Move with 32-bit zero extension (for ZeroExtend cast)
def emit_mov_r32(ctx: &mut CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then
    match src
    when PhysReg::X64Reg(xs) then x64_mov_r32(&mut ctx.text, xd, xs)
    when _ then ()
    end
  when PhysReg::A64Reg(ad) then
    match src
    when PhysReg::A64Reg(as_) then a64_mov_w(&mut ctx.text, ad, as_)
    when _ then ()
    end
  end
end

# Sign-extend 32-bit to 64-bit (for SignExtend cast)
def emit_movsxd(ctx: &mut CodegenCtx, dst: PhysReg, src: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then
    match src
    when PhysReg::X64Reg(xs) then x64_movsxd(&mut ctx.text, xd, xs)
    when _ then ()
    end
  when PhysReg::A64Reg(ad) then
    match src
    when PhysReg::A64Reg(as_) then a64_sxtw(&mut ctx.text, ad, as_)
    when _ then ()
    end
  end
end

# ADD reg, reg, reg  (dst = n + m)
def emit_add_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_add_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_add: mixed arch")
      end
    when _ then panic("emit_add: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_add_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_add: mixed arch")
      end
    when _ then panic("emit_add: mixed arch")
    end
  end
end

# SUB reg, reg, reg  (dst = n - m)
def emit_sub_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_sub_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_sub: mixed arch")
      end
    when _ then panic("emit_sub: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_sub_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_sub: mixed arch")
      end
    when _ then panic("emit_sub: mixed arch")
    end
  end
end

# Convenience wrappers used by statement lowering paths.
def emit_lea_global(ctx: &mut CodegenCtx, symbol: String, dst: PhysReg) -> Unit
  emit_lea_label(ctx, dst, symbol)
end

def emit_load_indirect(ctx: &mut CodegenCtx, base: PhysReg, offset: i32, dst: PhysReg) -> Unit
  emit_load_mem(ctx, dst, base, offset)
end

def emit_sub_rr(ctx: &mut CodegenCtx, subtrahend: PhysReg, dst: PhysReg) -> Unit
  emit_sub_rrr(ctx, dst, dst, subtrahend)
end

def emit_store_indirect(ctx: &mut CodegenCtx, src: PhysReg, base: PhysReg, offset: i32) -> Unit
  emit_store_mem(ctx, base, offset, src)
end

def emit_call_direct(ctx: &mut CodegenCtx, symbol: String) -> Unit
  emit_call_extern(ctx, symbol)
end

# MUL reg, reg, reg
def emit_mul_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_imul_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_mul: mixed arch")
      end
    when _ then panic("emit_mul: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_mul_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_mul: mixed arch")
      end
    when _ then panic("emit_mul: mixed arch")
    end
  end
end

# SDIV: dst = n / m
def emit_sdiv(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        x64_mov_rr(&mut ctx.text, X64::RAX, xn)
        x64_cqo(&mut ctx.text)
        x64_idiv_r(&mut ctx.text, xm)
        if x64_code(xd) != x64_code(X64::RAX) then
          x64_mov_rr(&mut ctx.text, xd, X64::RAX)
        end
      when _ then panic("emit_sdiv: mixed arch")
      end
    when _ then panic("emit_sdiv: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_sdiv_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_sdiv: mixed arch")
      end
    when _ then panic("emit_sdiv: mixed arch")
    end
  end
end

# MOD: dst = n % m
def emit_smod(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        x64_mov_rr(&mut ctx.text, X64::RAX, xn)
        x64_cqo(&mut ctx.text)
        x64_idiv_r(&mut ctx.text, xm)
        if x64_code(xd) != x64_code(X64::RDX) then
          x64_mov_rr(&mut ctx.text, xd, X64::RDX)
        end
      when _ then panic("emit_smod: mixed arch")
      end
    when _ then panic("emit_smod: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then
        a64_sdiv_rrr(&mut ctx.text, A64::X15, an, am)
        emit32_le(&mut ctx.text, 0x9B008000
          | (a64_code(am) << 16)
          | (a64_code(an) << 10)
          | (a64_code(A64::X15) << 5)
          | a64_code(ad))
      when _ then panic("emit_smod: mixed arch")
      end
    when _ then panic("emit_smod: mixed arch")
    end
  end
end

# AND/OR/XOR reg, reg, reg
def emit_and_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_and_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_and: mixed arch")
      end
    when _ then panic("emit_and: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_and_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_and: mixed arch")
      end
    when _ then panic("emit_and: mixed arch")
    end
  end
end

def emit_or_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_or_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_or: mixed arch")
      end
    when _ then panic("emit_or: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_orr_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_or: mixed arch")
      end
    when _ then panic("emit_or: mixed arch")
    end
  end
end

def emit_xor_rrr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_xor_rr(&mut ctx.text, xd, xm)
      when _ then panic("emit_xor: mixed arch")
      end
    when _ then panic("emit_xor: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then a64_eor_rrr(&mut ctx.text, ad, an, am)
      when _ then panic("emit_xor: mixed arch")
      end
    when _ then panic("emit_xor: mixed arch")
    end
  end
end

# Shifts
def emit_shl(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_mov_rr(&mut ctx.text, X64::RCX, xm)
        x64_shl_rcl(&mut ctx.text, xd)
      when _ then panic("emit_shl: mixed arch")
      end
    when _ then panic("emit_shl: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then emit32_le(&mut ctx.text, 0x9AC02000 | (a64_code(am) << 16) | (a64_code(an) << 5) | a64_code(ad))
      when _ then panic("emit_shl: mixed arch")
      end
    when _ then panic("emit_shl: mixed arch")
    end
  end
end

def emit_shr(ctx: &mut CodegenCtx, d: PhysReg, n: PhysReg, m: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then
    match n
    when PhysReg::X64Reg(xn) then
      match m
      when PhysReg::X64Reg(xm) then
        if x64_code(xd) != x64_code(xn) then x64_mov_rr(&mut ctx.text, xd, xn) end
        x64_mov_rr(&mut ctx.text, X64::RCX, xm)
        x64_shr_rcl(&mut ctx.text, xd)
      when _ then panic("emit_shr: mixed arch")
      end
    when _ then panic("emit_shr: mixed arch")
    end
  when PhysReg::A64Reg(ad) then
    match n
    when PhysReg::A64Reg(an) then
      match m
      when PhysReg::A64Reg(am) then emit32_le(&mut ctx.text, 0x9AC02800 | (a64_code(am) << 16) | (a64_code(an) << 5) | a64_code(ad))
      when _ then panic("emit_shr: mixed arch")
      end
    when _ then panic("emit_shr: mixed arch")
    end
  end
end

# NEG reg
def emit_neg(ctx: &mut CodegenCtx, d: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then x64_neg_r(&mut ctx.text, xd)
  when PhysReg::A64Reg(ad) then
    # NEG Xd, Xd  ≡  SUB Xd, XZR, Xd
    a64_sub_rrr(&mut ctx.text, ad, A64::XZR, ad)
  end
end

# NOT reg (bitwise)
def emit_not(ctx: &mut CodegenCtx, d: PhysReg) -> Unit
  match d
  when PhysReg::X64Reg(xd) then x64_not_r(&mut ctx.text, xd)
  when PhysReg::A64Reg(ad) then
    # MVN Xd, Xd  ≡  ORN Xd, XZR, Xd
    emit32_le(&mut ctx.text, 0xAA200000 | (a64_code(ad) << 16) | (31 << 5) | a64_code(ad))
  end
end

# CMP reg, reg
def emit_cmp_rr(ctx: &mut CodegenCtx, a: PhysReg, b: PhysReg) -> Unit
  match a
  when PhysReg::X64Reg(xa) then
    match b
    when PhysReg::X64Reg(xb) then x64_cmp_rr(&mut ctx.text, xa, xb)
    when _ then panic("emit_cmp: mixed arch")
    end
  when PhysReg::A64Reg(aa) then
    match b
    when PhysReg::A64Reg(ab) then a64_cmp_rr(&mut ctx.text, aa, ab)
    when _ then panic("emit_cmp: mixed arch")
    end
  end
end

# CMP reg, imm
def emit_cmp_ri(ctx: &mut CodegenCtx, r: PhysReg, imm: i32) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_cmp_ri(&mut ctx.text, xr, imm)
  when PhysReg::A64Reg(ar) then a64_cmp_ri(&mut ctx.text, ar, imm as u32)
  end
end

# TEST reg, reg (x86) / TST reg, reg (arm64)
def emit_test_rr(ctx: &mut CodegenCtx, a: PhysReg, b: PhysReg) -> Unit
  match a
  when PhysReg::X64Reg(xa) then
    match b
    when PhysReg::X64Reg(xb) then x64_test_rr(&mut ctx.text, xa, xb)
    when _ then panic("emit_test: mixed arch")
    end
  when PhysReg::A64Reg(aa) then
    match b
    when PhysReg::A64Reg(ab) then emit32_le(&mut ctx.text, 0xEA00001F | (a64_code(ab) << 16) | (a64_code(aa) << 5))
    when _ then panic("emit_test: mixed arch")
    end
  end
end

# Set register to 0 or 1 based on condition after CMP
enum CondKind
  Eq; Ne; Lt; Le; Gt; Ge
end

def emit_setcc(ctx: &mut CodegenCtx, cond: CondKind, dst: PhysReg) -> Unit
  match dst
  when PhysReg::X64Reg(xr) then
    let cc = match cond
    when CondKind::Eq then CC::E
    when CondKind::Ne then CC::NE
    when CondKind::Lt then CC::L
    when CondKind::Le then CC::LE
    when CondKind::Gt then CC::G
    when CondKind::Ge then CC::GE
    end
    x64_setcc(&mut ctx.text, cc, xr)
    x64_movzx_r64_r8(&mut ctx.text, xr, xr)
  when PhysReg::A64Reg(ar) then
    let arm_cond = match cond
    when CondKind::Eq then a64_cc_eq()
    when CondKind::Ne then a64_cc_ne()
    when CondKind::Lt then a64_cc_lt()
    when CondKind::Le then a64_cc_le()
    when CondKind::Gt then a64_cc_gt()
    when CondKind::Ge then a64_cc_ge()
    end
    a64_cset(&mut ctx.text, ar, arm_cond)
  end
end

# Unconditional jump to label
def emit_jmp(ctx: &mut CodegenCtx, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_jmp(&mut ctx.text, label)
  when Arch::AArch64 then a64_b(&mut ctx.text, label)
  end
end

# Conditional jump (eq/ne after TEST or CMP)
def emit_jcc(ctx: &mut CodegenCtx, cond: CondKind, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64 then
    let cc = match cond
    when CondKind::Eq then CC::E
    when CondKind::Ne then CC::NE
    when CondKind::Lt then CC::L
    when CondKind::Le then CC::LE
    when CondKind::Gt then CC::G
    when CondKind::Ge then CC::GE
    end
    x64_jcc(&mut ctx.text, cc, label)
  when Arch::AArch64 then
    let arm_cond = match cond
    when CondKind::Eq then a64_cc_eq()
    when CondKind::Ne then a64_cc_ne()
    when CondKind::Lt then a64_cc_lt()
    when CondKind::Le then a64_cc_le()
    when CondKind::Gt then a64_cc_gt()
    when CondKind::Ge then a64_cc_ge()
    end
    a64_bcond(&mut ctx.text, arm_cond, label)
  end
end

# CALL label (local or external)
def emit_call_label(ctx: &mut CodegenCtx, label: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_call_label(&mut ctx.text, label)
  when Arch::AArch64 then a64_bl(&mut ctx.text, label)
  end
end

def emit_call_extern(ctx: &mut CodegenCtx, sym: String) -> Unit
  match ctx.target.arch
  when Arch::X86_64 then x64_call_extern(&mut ctx.text, sym)
  when Arch::AArch64 then
    # Needs relocation for external calls
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_CALL26, sym, 0)
    emit32_le(&mut ctx.text, 0x94000000)
  end
end

# CALL reg (indirect)
def emit_call_r(ctx: &mut CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_call_r(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then a64_blr(&mut ctx.text, ar)
  end
end

# RET
def emit_ret(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_ret(&mut ctx.text)
  when Arch::AArch64 then a64_ret(&mut ctx.text)
  end
end

# PUSH reg
def emit_push(ctx: &mut CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_push(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then
    # ARM64: STR Xr, [SP, #-16]!  (pre-index, 16-byte aligned)
    a64_stur(&mut ctx.text, ar, A64::SP, -16)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 16)
  end
end

# POP reg
def emit_pop(ctx: &mut CodegenCtx, r: PhysReg) -> Unit
  match r
  when PhysReg::X64Reg(xr) then x64_pop(&mut ctx.text, xr)
  when PhysReg::A64Reg(ar) then
    # ARM64: LDR Xr, [SP], #16  (post-index: load then increment SP by 16)
    a64_ldr_post(&mut ctx.text, ar, A64::SP, 16)
  end
end

# LEA reg, [FP + offset]
def emit_lea_fp(ctx: &mut CodegenCtx, dst: PhysReg, offset: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_lea_mem(&mut ctx.text, xd, X64::RBP, offset)
  when PhysReg::A64Reg(ad) then
    if offset >= 0 && offset < 4096 then
      a64_add_rri(&mut ctx.text, ad, A64::FP, offset as u32)
    elsif offset < 0 && offset > -4096 then
      a64_sub_rri(&mut ctx.text, ad, A64::FP, (-offset) as u32)
    else
      a64_mov_ri(&mut ctx.text, ad, offset as i64)
      a64_add_rrr(&mut ctx.text, ad, A64::FP, ad)
    end
  end
end

# LEA reg, [rip + label] (x86) / ADRP+ADD (arm64)
def emit_lea_label(ctx: &mut CodegenCtx, dst: PhysReg, label: String) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_lea_rip(&mut ctx.text, xd, label)
  when PhysReg::A64Reg(ad) then
    # ADRP + ADD (needs page-relative relocations)
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, label.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000 | a64_code(ad))  # ADRP
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, label, 0)
    a64_add_rri(&mut ctx.text, ad, ad, 0)  # ADD lo12 (patched by relocation)
  end
end

# UD2 / UDF (trap)
def emit_trap(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_ud2(&mut ctx.text)
  when Arch::AArch64 then a64_udf(&mut ctx.text)
  end
end

# NOP
def emit_nop(ctx: &mut CodegenCtx) -> Unit
  match ctx.target.arch
  when Arch::X86_64  then x64_nop(&mut ctx.text)
  when Arch::AArch64 then a64_nop(&mut ctx.text)
  end
end

# ADD reg, imm
def emit_add_ri(ctx: &mut CodegenCtx, dst: PhysReg, imm: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_add_ri(&mut ctx.text, xd, imm)
  when PhysReg::A64Reg(ad) then
    if imm >= 0 then
      a64_add_rri(&mut ctx.text, ad, ad, imm as u32)
    else
      a64_sub_rri(&mut ctx.text, ad, ad, (-imm) as u32)
    end
  end
end

# SUB reg, imm
def emit_sub_ri(ctx: &mut CodegenCtx, dst: PhysReg, imm: i32) -> Unit
  match dst
  when PhysReg::X64Reg(xd) then x64_sub_ri(&mut ctx.text, xd, imm)
  when PhysReg::A64Reg(ad) then
    if imm >= 0 then
      a64_sub_rri(&mut ctx.text, ad, ad, imm as u32)
    else
      a64_add_rri(&mut ctx.text, ad, ad, (-imm) as u32)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Block label naming
# ———————————————————————————————————————————————————————————————

def block_label(fn_name: &String, block_id: Int) -> String
  ".L" + fn_name + ".bb" + block_id.to_string()
end

def make_block_labels(func: &MirFunction) -> Map[Int, String]
  mut labels: Map[Int, String] = Map::new()
  for block in func.blocks do
    labels.insert(block.id.id, block_label(&func.name, block.id.id))
  end
  labels
end

# ———————————————————————————————————————————————————————————————
# Load operand into a register
# ———————————————————————————————————————————————————————————————

def load_operand(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, op: &MirOperand, dst: PhysReg) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, &place, dst)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, &place, dst)
  when MirOperandKind::MirConstant(cst) then
    load_constant(ctx, &cst, dst)
  end
end

def load_place(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, place: &Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(r) then
      if place.projections.is_empty() then
        if phys_reg_id(r) != phys_reg_id(dst) then
          emit_mov_rr(ctx, dst, r)
        end
      else
        emit_mov_rr(ctx, dst, r)
        apply_projections(ctx, fctx, &place.projections, dst)
      end
    when VarLoc::Stack(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, &place.projections, dst)
      end
    when VarLoc::Spilled(offset) then
      emit_load_mem(ctx, dst, fp, offset)
      if !place.projections.is_empty() then
        apply_projections(ctx, fctx, &place.projections, dst)
      end
    end
  when Option::None then
    panic("load_place: unknown local " + place.local.id.to_string())
  end
end

def apply_projections(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, projs: &Vec[Projection], reg: PhysReg) -> Unit
  let scratch = ret_reg(ctx.target.arch)  # use return reg as scratch for index loads
  for proj in projs do
    match proj
    when Projection::ProjDeref then
      emit_load_mem(ctx, reg, reg, 0)
    when Projection::ProjField(name, idx) then
      let offset = idx * 8
      emit_load_mem(ctx, reg, reg, offset as i32)
    when Projection::ProjIndex(local_id) then
      # Load index value into scratch
      load_place(ctx, fctx, &Place { local: local_id, projections: Vec::new() }, scratch)
      # Multiply index by element size (default 8 bytes per element)
      match arg_reg(ctx.target.arch, 0)
      when Option::Some(elem_size_reg) then
        emit_mov_ri(ctx, elem_size_reg, 8)
        emit_mul_rrr(ctx, scratch, scratch, elem_size_reg)
      when Option::None then ()
      end
      # Add scaled offset to base address
      emit_add_rrr(ctx, reg, reg, scratch)
      emit_load_mem(ctx, reg, reg, 0)
    when Projection::ProjConstantIndex(i) then
      let offset = i * 8
      emit_load_mem(ctx, reg, reg, offset as i32)
    when Projection::ProjDowncast(name, disc) then
      emit_add_ri(ctx, reg, 8)
    end
  end
end

def load_constant(ctx: &mut CodegenCtx, cst: &MirConstant, dst: PhysReg) -> Unit
  match cst.kind
  when MirConstantKind::MirUnit then
    emit_zero_reg(ctx, dst)
  when MirConstantKind::MirBool(b) then
    if b then
      emit_mov_ri(ctx, dst, 1)
    else
      emit_zero_reg(ctx, dst)
    end
  when MirConstantKind::MirInt(i) then
    emit_mov_ri(ctx, dst, i as i64)
  when MirConstantKind::MirFloat(f) then
    # Load float bits into GPR, then move to float reg via stack
    let bits = f.to_bits() as i64
    emit_mov_ri(ctx, dst, bits)
    # Store GPR to temp stack slot, load back as float
    let sp = sp_reg(ctx.target.arch)
    emit_store_mem(ctx, sp, -8, dst)
    emit_load_fp_from_stack(ctx, dst, sp, -8)
  when MirConstantKind::MirChar(c) then
    emit_mov_ri(ctx, dst, c as i64)
  when MirConstantKind::MirString(s) then
    let label = intern_string(ctx, &s)
    emit_lea_label(ctx, dst, label)
  when MirConstantKind::MirFnItem(fn_name) then
    # Load the address of the named function
    emit_lea_label(ctx, dst, fn_name)
  when MirConstantKind::MirZeroSized then
    emit_zero_reg(ctx, dst)
  end
end

# ———————————————————————————————————————————————————————————————
# Store to a Place
# ———————————————————————————————————————————————————————————————

def store_place(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, place: &Place, src: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  let scratch = ret_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    if place.projections.is_empty() then
      match loc
      when VarLoc::Register(r) then
        if phys_reg_id(r) != phys_reg_id(src) then
          emit_mov_rr(ctx, r, src)
        end
      when VarLoc::Stack(offset) then
        emit_store_mem(ctx, fp, offset, src)
      when VarLoc::Spilled(offset) then
        emit_store_mem(ctx, fp, offset, src)
      end
    else
      # Save value
      emit_push(ctx, src)

      match loc
      when VarLoc::Register(r) then
        emit_mov_rr(ctx, scratch, r)
      when VarLoc::Stack(offset) then
        emit_load_mem(ctx, scratch, fp, offset)
      when VarLoc::Spilled(offset) then
        emit_load_mem(ctx, scratch, fp, offset)
      end

      # Walk projections except last to compute base address
      mut i = 0
      let n = place.projections.len()
      while i < n - 1 do
        let proj = place.projections[i]
        match proj
        when Projection::ProjDeref then
          emit_load_mem(ctx, scratch, scratch, 0)
        when Projection::ProjField(_, idx) then
          emit_add_ri(ctx, scratch, (idx * 8) as i32)
        when Projection::ProjDowncast(_, _) then
          emit_add_ri(ctx, scratch, 8)
        when _ then ()
        end
        i = i + 1
      end

      # Last projection determines final store offset
      let last = place.projections[n - 1]
      let store_off: i32 = match last
      when Projection::ProjDeref then 0
      when Projection::ProjField(_, idx) then (idx * 8) as i32
      when Projection::ProjConstantIndex(ci) then (ci * 8) as i32
      when Projection::ProjDowncast(_, _) then 8
      when _ then 0
      end

      emit_pop(ctx, src)  # restore value
      emit_store_mem(ctx, scratch, store_off, src)
    end
  when Option::None then
    panic("store_place: unknown local " + place.local.id.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Rvalue code generation
# ———————————————————————————————————————————————————————————————

def codegen_rvalue(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, rv: &MirRvalue, dst: PhysReg) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    load_operand(ctx, fctx, &op, dst)

  when MirRvalueKind::MirBinOp(bin_op, left, right) then
    codegen_binop(ctx, fctx, bin_op, &left, &right, dst)

  when MirRvalueKind::MirUnOp(un_op, operand) then
    load_operand(ctx, fctx, &operand, dst)
    match un_op
    when MirUnOp::Neg    then emit_neg(ctx, dst)
    when MirUnOp::Not    then
      emit_test_rr(ctx, dst, dst)
      emit_setcc(ctx, CondKind::Eq, dst)
    when MirUnOp::BitNot then emit_not(ctx, dst)
    end

  when MirRvalueKind::MirRef(place) then
    codegen_address_of(ctx, fctx, &place, dst)

  when MirRvalueKind::MirRefMut(place) then
    codegen_address_of(ctx, fctx, &place, dst)

  when MirRvalueKind::MirAggregate(kind, operands) then
    codegen_aggregate(ctx, fctx, &kind, &operands, dst)

  when MirRvalueKind::MirDiscriminant(place) then
    load_place(ctx, fctx, &place, dst)

  when MirRvalueKind::MirLen(place) then
    load_place(ctx, fctx, &place, dst)
    emit_load_mem(ctx, dst, dst, 8)

  when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
    load_operand(ctx, fctx, &operand, dst)
    match cast_kind
    when CastKind::IntToFloat then
      match ctx.target.arch
      when Arch::X86_64 then
        # cvtsi2sd xmm0, dst (via stack round-trip)
        let sp = sp_reg(ctx.target.arch)
        emit_store_mem(ctx, sp, -8, dst)
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2A, 0xC0)  # cvtsi2sd xmm0, rax
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x7E, 0xC0)  # movq rax, xmm0
      when Arch::AArch64 then
        emit_raw_u32(ctx, 0x9E620000 | a64_code_from_gpr(dst))  # SCVTF D0, Xn
      end
    when CastKind::FloatToInt then
      match ctx.target.arch
      when Arch::X86_64 then
        emit_raw_bytes(ctx, 0x66, 0x48, 0x0F, 0x6E, 0xC0)  # movq xmm0, rax
        emit_raw_bytes(ctx, 0xF2, 0x48, 0x0F, 0x2C, 0xC0)  # cvttsd2si rax, xmm0
      when Arch::AArch64 then
        emit_raw_u32(ctx, 0x9E780000 | a64_code_from_gpr(dst))  # FCVTZS Xn, D0
      end
    when CastKind::IntToInt then
      # Narrowing integer casts need an explicit mask; widening is a register no-op here.
      let target_bits = type_size(&target_ty, &ctx.type_layout) * 8
      if target_bits < 64 then
        let mask = (1 << target_bits) - 1
        emit_and_ri(ctx, dst, mask as i32)
      end
    when CastKind::FloatToFloat then ()
    when CastKind::Pointer then ()
    when CastKind::Transmute then ()
    when _ then
      panic("codegen_rvalue: unsupported cast kind")
    end

  when MirRvalueKind::MirRepeat(operand, count) then
    # Allocate count * element_size on stack and fill with the value
    let scratch = ret_reg(ctx.target.arch)
    load_operand(ctx, fctx, &operand, scratch)
    # Store element for each repetition at dst + i * 8
    mut i: UInt = 0
    while i < count do
      emit_store_mem(ctx, dst, (i * 8) as i32, scratch)
      i = i + 1
    end

  when MirRvalueKind::MirPhi(pairs) then
    # Phi nodes: values already placed by predecessor blocks.
    # Skip — no code generation needed.
    ()
  when _ then
    panic("codegen_rvalue: unsupported MIR rvalue kind")
  end
end

def codegen_binop(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, op: MirBinOp, left: &MirOperand, right: &MirOperand, dst: PhysReg) -> Unit
  let scratch = scratch2_reg(ctx.target.arch)
  load_operand(ctx, fctx, left, dst)
  load_operand(ctx, fctx, right, scratch)

  match op
  when MirBinOp::Add    then emit_add_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Sub    then emit_sub_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Mul    then emit_mul_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Div    then emit_sdiv(ctx, dst, dst, scratch)
  when MirBinOp::Mod    then emit_smod(ctx, dst, dst, scratch)
  when MirBinOp::BitAnd then emit_and_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitOr  then emit_or_rrr(ctx, dst, dst, scratch)
  when MirBinOp::BitXor then emit_xor_rrr(ctx, dst, dst, scratch)
  when MirBinOp::Shl    then emit_shl(ctx, dst, dst, scratch)
  when MirBinOp::Shr    then emit_shr(ctx, dst, dst, scratch)
  when MirBinOp::Eq then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Eq, dst)
  when MirBinOp::Ne then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Ne, dst)
  when MirBinOp::Lt then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Lt, dst)
  when MirBinOp::Le then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Le, dst)
  when MirBinOp::Gt then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Gt, dst)
  when MirBinOp::Ge then
    emit_cmp_rr(ctx, dst, scratch)
    emit_setcc(ctx, CondKind::Ge, dst)
  end
end

def codegen_address_of(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, place: &Place, dst: PhysReg) -> Unit
  let fp = fp_reg(ctx.target.arch)
  match fctx.var_locs.get(place.local.id)
  when Option::Some(loc) then
    match loc
    when VarLoc::Register(r) then
      # Spill the register-allocated variable to a dedicated temp slot below the frame
      # Use a stable spill slot that won't conflict with other spills
      let spill_off = fctx.frame.spill_offset - 8
      fctx.frame.spill_offset = spill_off  # Update to track used spill space
      emit_store_mem(ctx, fp, spill_off, r)
      emit_lea_fp(ctx, dst, spill_off)
    when VarLoc::Stack(offset) then
      emit_lea_fp(ctx, dst, offset)
    when VarLoc::Spilled(offset) then
      emit_lea_fp(ctx, dst, offset)
    end
  when Option::None then
    panic("address_of: unknown local")
  end
end

def codegen_aggregate(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, kind: &AggregateKind, operands: &Vec[MirOperand], dst: PhysReg) -> Unit
  let total_size = operands.len() * 8
  let aligned = align_up_int(total_size, 16)
  let sp = sp_reg(ctx.target.arch)
  let scratch = scratch2_reg(ctx.target.arch)

  emit_sub_ri(ctx, sp, aligned as i32)
  emit_mov_rr(ctx, dst, sp)

  mut i = 0
  for op in operands do
    load_operand(ctx, fctx, op, scratch)
    emit_store_mem(ctx, sp, (i * 8) as i32, scratch)
    i = i + 1
  end

  emit_add_ri(ctx, sp, aligned as i32)
end

# ———————————————————————————————————————————————————————————————
# Statement code generation
# ———————————————————————————————————————————————————————————————

def codegen_statement(ctx: &mut CodegenCtx, fctx: &mut FnCodegenCtx, stmt: &MirStatement) -> Unit
  let rr = ret_reg(ctx.target.arch)
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    # Skip phi assignments — values already placed by predecessor blocks
    match rvalue.kind
    when MirRvalueKind::MirPhi(_) then ()
    when _ then
      codegen_rvalue(ctx, fctx, &rvalue, rr)
      store_place(ctx, fctx, &place, rr)
    end

  when MirStatementKind::MirStorageLive(_) then ()
  when MirStatementKind::MirStorageDead(_) then ()
  when MirStatementKind::MirNop then ()

  when MirStatementKind::MirContractCheck(contract, cond) then
    load_operand(ctx, fctx, &cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ok_label = ".Lcontract_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ne, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirBudgetConsume(resource, amount) then
    # Decrement the resource budget counter in the thread-local budget table
    # Format: load current budget, subtract amount, store back, trap if negative
    let scratch = scratch_reg(ctx.target.arch)
    let scratch2 = scratch2_reg(ctx.target.arch)
    
    # Load the budget address (assume __tg_budget_table + resource_offset)
    let budget_sym = "__tg_budget_" + resource.clone()
    emit_lea_global(ctx, budget_sym.clone(), scratch)
    
    # Load current budget value
    emit_load_indirect(ctx, scratch, 0, scratch2)
    
    # Load amount to consume
    emit_mov_ri(ctx, rr, amount as i64)
    
    # Subtract amount from budget
    emit_sub_rr(ctx, rr, scratch2)
    
    # Store updated budget back
    emit_store_indirect(ctx, scratch2, scratch, 0)
    
    # If the budget is now negative, trap (budget exhausted)
    emit_test_rr(ctx, scratch2, scratch2)
    let ok_label = ".Lbudget_ok." + ctx.fn_counter.to_string()
    ctx.fn_counter = ctx.fn_counter + 1
    emit_jcc(ctx, CondKind::Ge, ok_label.clone())
    emit_trap(ctx)
    def_label(&mut ctx.text, ok_label)

  when MirStatementKind::MirEffectRecord(name, operand) then
    # Record an effect by pushing it to the effect log
    # Call __tg_effect_record(name_ptr, value)
    let scratch = scratch_reg(ctx.target.arch)
    
    # Load the effect value into result register
    load_operand(ctx, fctx, &operand, rr)
    
    # Load effect name string address
    let name_label = intern_string(ctx, &name)
    emit_lea_global(ctx, name_label, scratch)
    
    # Set up call arguments (ABI: scratch = name_ptr, rr = value)
    # Move arguments to proper registers for the call
    match arg_reg(ctx.target.arch, 0)
    when Option::Some(arg0) then
      match arg_reg(ctx.target.arch, 1)
      when Option::Some(arg1) then
        emit_mov_rr(ctx, arg0, scratch)
        emit_mov_rr(ctx, arg1, rr)
      when Option::None then ()
      end
    when Option::None then ()
    end
    
    # Call the runtime function
    emit_call_direct(ctx, "__tg_effect_record".to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Terminator code generation
# ———————————————————————————————————————————————————————————————

def codegen_terminator(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, term: &MirTerminator) -> Unit
  let rr = ret_reg(ctx.target.arch)
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    let label = fctx.block_labels.get(target.id).unwrap()
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    load_operand(ctx, fctx, &discr, rr)
    for sw in targets do
      emit_cmp_ri(ctx, rr, sw.value as i32)
      let tgt_label = fctx.block_labels.get(sw.target.id).unwrap()
      emit_jcc(ctx, CondKind::Eq, tgt_label)
    end
    let def_label = fctx.block_labels.get(default_target.id).unwrap()
    emit_jmp(ctx, def_label)

  when MirTerminatorKind::MirReturn then
    codegen_epilogue(ctx, fctx)

  when MirTerminatorKind::MirUnreachable then
    emit_trap(ctx)

  when MirTerminatorKind::MirCall(dest, callee, args, success, unwind) then
    codegen_call(ctx, fctx, &dest, &callee, &args, success, &unwind)

  when MirTerminatorKind::MirDrop(place, target, unwind) then
    let label = fctx.block_labels.get(target.id).unwrap()
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    load_operand(ctx, fctx, &cond, rr)
    emit_test_rr(ctx, rr, rr)
    let ck = if expected then CondKind::Ne else CondKind::Eq end
    let tgt_label = fctx.block_labels.get(target.id).unwrap()
    emit_jcc(ctx, ck, tgt_label)
    emit_trap(ctx)

  when MirTerminatorKind::MirYield(value, resume) then
    load_operand(ctx, fctx, &value, rr)
    let label = fctx.block_labels.get(resume.id).unwrap()
    emit_jmp(ctx, label)

  when MirTerminatorKind::MirAbort then
    emit_trap(ctx)
  when _ then
    panic("codegen_terminator: unsupported MIR terminator kind")
  end
end

def codegen_call(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx, dest: &Place, callee: &MirOperand, args: &Vec[MirOperand], success: BlockId, unwind: &Option[BlockId]) -> Unit
  let arch   = ctx.target.arch
  let rr     = ret_reg(arch)
  let scratch = scratch2_reg(arch)
  let sp     = sp_reg(arch)
  let max_ra = max_reg_args(arch)

  # Place arguments in ABI registers
  mut arg_idx = 0
  for arg in args do
    if arg_idx < max_ra then
      match arg_reg(arch, arg_idx)
      when Option::Some(abi_r) then
        load_operand(ctx, fctx, arg, abi_r)
      when Option::None then ()
      end
    else
      load_operand(ctx, fctx, arg, scratch)
      emit_push(ctx, scratch)
    end
    arg_idx = arg_idx + 1
  end

  # Call the function
  match callee.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFnItem(fn_name) then
      # Direct call to named function
      emit_call_extern(ctx, fn_name)
    when MirConstantKind::MirZeroSized then
      match cst.ty
      when Type::Function(_, _) then
        # ZeroSized function type — extract name from mangled type if possible
        # Fallback: trap (should have been FnItem)
        emit_trap(ctx)
      when _ then
        emit_trap(ctx)
      end
    when _ then
      emit_trap(ctx)
    end
  when MirOperandKind::MirCopy(place) then
    load_place(ctx, fctx, &place, rr)
    emit_call_r(ctx, rr)
  when MirOperandKind::MirMovePlace(place) then
    load_place(ctx, fctx, &place, rr)
    emit_call_r(ctx, rr)
  end

  # Clean up stack args
  if arg_idx > max_ra then
    emit_add_ri(ctx, sp, ((arg_idx - max_ra) * 8) as i32)
  end

  # Store return value
  store_place(ctx, fctx, dest, rr)

  # Jump to success block
  let label = fctx.block_labels.get(success.id).unwrap()
  emit_jmp(ctx, label)
end

# ———————————————————————————————————————————————————————————————
# Function prologue and epilogue
# ———————————————————————————————————————————————————————————————

def stack_probe_step_bytes() -> Int = 4096

def emit_stack_probe(ctx: &mut CodegenCtx, sp: PhysReg, frame_size: Int) -> Unit
  if frame_size <= stack_probe_step_bytes() then
    return
  end

  let scratch = scratch2_reg(ctx.target.arch)
  emit_zero_reg(ctx, scratch)

  mut offset = 0
  while offset < frame_size do
    emit_store_mem(ctx, sp, offset as i32, scratch)
    offset = offset + stack_probe_step_bytes()
  end
end

def codegen_prologue(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)

  match arch
  when Arch::X86_64 then
    # push rbp; mov rbp, rsp
    emit_push(ctx, fp)
    emit_mov_rr(ctx, fp, sp)

    # Save callee-saved registers
    for r in fctx.frame.saved_regs do
      emit_push(ctx, r)
    end

    # Allocate stack frame
    if fctx.frame.stack_size > 0 then
      emit_sub_ri(ctx, sp, fctx.frame.stack_size as i32)
      emit_stack_probe(ctx, sp, fctx.frame.stack_size)
    end

  when Arch::AArch64 then
    # stp fp, lr, [sp, #-16]!  (pre-index: push fp and lr)
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    # mov fp, sp
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    # Allocate full stack frame (callee-saved saves + spill area)
    if fctx.frame.stack_size > 0 then
      let aligned = align_up_int(fctx.frame.stack_size, 16)
      a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, aligned as u32)
      emit_stack_probe(ctx, sp, aligned)
    end

    # Save callee-saved registers at the BOTTOM of the frame (FP-relative)
    # Callee-saved go at [FP-stack_size], [FP-stack_size+8], etc.
    # Spill slots are at [FP-8], [FP-16], etc. (near top), so no collision.
    let saved = &fctx.frame.saved_regs
    mut si = 0
    let ss = fctx.frame.stack_size
    while si < saved.len() do
      let off = -(ss as i32) + (si * 8) as i32
      match saved[si]
      when PhysReg::A64Reg(a) then
        a64_stur(&mut ctx.text, a, A64::FP, off)
      when _ then ()
      end
      si = si + 1
    end
  end

  # Move register-assigned params from ABI regs to their assigned regs
  let max_ra = max_reg_args(arch)
  mut idx = 0
  for param in fctx.func.params do
    if idx < max_ra then
      match arg_reg(arch, idx)
      when Option::Some(abi_r) then
        match fctx.var_locs.get(param.id.id)
        when Option::Some(loc) then
          match loc
          when VarLoc::Register(target_r) then
            if phys_reg_id(abi_r) != phys_reg_id(target_r) then
              emit_mov_rr(ctx, target_r, abi_r)
            end
          when VarLoc::Stack(off) then
            emit_store_mem(ctx, fp, off, abi_r)
          when VarLoc::Spilled(off) then
            emit_store_mem(ctx, fp, off, abi_r)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
    idx = idx + 1
  end
end

def codegen_epilogue(ctx: &mut CodegenCtx, fctx: &FnCodegenCtx) -> Unit
  let arch = ctx.target.arch
  let fp = fp_reg(arch)
  let sp = sp_reg(arch)
  let rr = ret_reg(arch)

  # Load return value into the return register if needed (local 0 is return place)
  if type_size(&fctx.func.ret_type, &ctx.type_layout) > 0 && fctx.func.locals.len() > 0 then
    let ret_local = fctx.func.locals[0]
    if type_size(&ret_local.ty, &ctx.type_layout) > 0 then
      match fctx.var_locs.get(ret_local.id.id)
      when Option::Some(loc) then
        match loc
        when VarLoc::Register(r) then
          if phys_reg_id(r) != phys_reg_id(rr) then
            emit_mov_rr(ctx, rr, r)
          end
        when VarLoc::Stack(off) then
          emit_load_mem(ctx, rr, fp, off)
        when VarLoc::Spilled(off) then
          emit_load_mem(ctx, rr, fp, off)
        end
      when _ then ()
      end
    end
  else
    # Unit return type: ensure return register is zero
    emit_zero_reg(ctx, rr)
  end

  match arch
  when Arch::X86_64 then
    # Deallocate stack frame
    if fctx.frame.stack_size > 0 then
      emit_add_ri(ctx, sp, fctx.frame.stack_size as i32)
    end
    # Restore callee-saved registers (reverse order)
    mut i = fctx.frame.saved_regs.len() - 1
    while i >= 0 do
      emit_pop(ctx, fctx.frame.saved_regs[i])
      i = i - 1
    end
    # pop rbp; ret
    emit_pop(ctx, fp)
    emit_ret(ctx)

  when Arch::AArch64 then
    # Restore callee-saved registers from bottom of frame (FP-relative)
    let saved = &fctx.frame.saved_regs
    let ss = fctx.frame.stack_size
    mut si = 0
    while si < saved.len() do
      let off = -(ss as i32) + (si * 8) as i32
      match saved[si]
      when PhysReg::A64Reg(a) then
        a64_ldur(&mut ctx.text, a, A64::FP, off)
      when _ then ()
      end
      si = si + 1
    end
    # mov sp, fp (deallocate entire frame at once)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::FP)
    # ldp fp, lr, [sp], #16  (post-index: restore fp and lr)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Function code generation
# ———————————————————————————————————————————————————————————————

def codegen_function(ctx: &mut CodegenCtx, func: &MirFunction) -> Unit
  # Extern functions don't get a body — they are resolved at link time.
  # We just register them as undefined external symbols so the linker
  # can wire up the relocations.
  if func.is_extern then
    add_symbol(&mut ctx.text, AsmSymbol {
      name: func.name.clone(),
      section: Section::Text,
      offset: 0,
      size: 0,
      binding: SymBinding::Global,
      kind: SymKind::Func
    })
    return
  end

  # Register allocation
  let (var_locs, frame) = allocate_locals(func, ctx.target.arch, &ctx.type_layout)

  # Block labels
  let block_labels = make_block_labels(func)
  let fctx = FnCodegenCtx {
    func: func.clone(),
    frame: frame,
    var_locs: var_locs,
    block_labels: block_labels
  }

  # Emit function symbol
  add_symbol(&mut ctx.text, AsmSymbol {
    name: func.name.clone(),
    section: Section::Text,
    offset: buf_pos(&ctx.text),
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })

  # Label
  def_label(&mut ctx.text, func.name.clone())

  # Prologue
  codegen_prologue(ctx, &fctx)

  # Emit all blocks
  for block in func.blocks do
    let label = fctx.block_labels.get(block.id.id).unwrap()
    def_label(&mut ctx.text, label)

    for stmt in block.statements do
      codegen_statement(ctx, &mut fctx, stmt)
    end

    codegen_terminator(ctx, &fctx, &block.terminator)
  end

  # Patch the symbol size
  let fn_end = buf_pos(&ctx.text)
  # (Symbol size patching would update the last symbol's size field)
end

# ———————————————————————————————————————————————————————————————
# Static variables
# ———————————————————————————————————————————————————————————————

def codegen_static(ctx: &mut CodegenCtx, st: &MirStatic) -> Unit
  let sz = type_size(&st.ty, &ctx.type_layout)
  
  match st.init
  when Option::Some(op) then
    # Initialized - goes into .data section
    add_symbol(&mut ctx.data, AsmSymbol {
      name: st.name.clone(),
      section: Section::Data,
      offset: buf_pos(&ctx.data),
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    def_label(&mut ctx.data, st.name.clone())

    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(v) then
        emit64_le(&mut ctx.data, v as u64)
      when MirConstantKind::MirBool(b) then
        if b then emit8(&mut ctx.data, 1) else emit8(&mut ctx.data, 0) end
        # Pad to alignment
        mut pad = sz - 1
        while pad > 0 do
          emit8(&mut ctx.data, 0)
          pad = pad - 1
        end
      when _ then
        mut i = 0
        while i < sz do
          emit8(&mut ctx.data, 0)
          i = i + 1
        end
      end
    when _ then
      mut i = 0
      while i < sz do
        emit8(&mut ctx.data, 0)
        i = i + 1
      end
    end
  when Option::None then
    # Uninitialized/zero-initialized - goes into .bss section
    # Track symbol in bss_symbols with current bss_size as offset
    ctx.bss_symbols.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Bss,
      offset: ctx.bss_size,
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    # Align bss_size appropriately
    let align = type_align(&st.ty)
    let rem = ctx.bss_size % align
    if rem != 0 then
      ctx.bss_size = ctx.bss_size + (align - rem)
    end
    ctx.bss_size = ctx.bss_size + sz
  end
end

# ———————————————————————————————————————————————————————————————
# Program code generation
# ———————————————————————————————————————————————————————————————

def codegen_program(ctx: &mut CodegenCtx, program: &MirProgram) -> Unit
  # Build type layout map from MIR type definitions
  ctx.type_layout = build_type_layout(&program.types)

  # Emit all statics
  for st in program.statics do
    codegen_static(ctx, st)
  end

  # Emit all functions
  for func in program.functions do
    codegen_function(ctx, func)
  end

  # Resolve local branch fixups
  match resolve_fixups(&mut ctx.text)
  when Result::Ok(_) then ()
  when Result::Err(e) then panic("codegen fixup error: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API — Full pipeline: MIR → native binary
# ———————————————————————————————————————————————————————————————

def generate_native(program: &MirProgram, target: AsmTarget) -> Vec[u8]
  mut ctx = codegen_new(target)
  codegen_program(&mut ctx, program)

  # Combine text symbols with BSS symbols
  mut all_symbols = ctx.text.symbols.clone()
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end

  # Build object file from encoded buffers
  let obj = ObjectFile {
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: ctx.text.relocations.clone(),
    target: ctx.target
  }

  build_object(&obj)
end

def generate_executable(program: &MirProgram, target: AsmTarget, output_path: String) -> Result[Unit, String]
  mut ctx = codegen_new(target.clone())
  codegen_program(&mut ctx, program)

  # Combine text symbols with BSS symbols
  mut all_symbols = ctx.text.symbols.clone()
  for sym in ctx.bss_symbols do
    all_symbols.push(sym.clone())
  end

  let obj = ObjectFile {
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: ctx.text.relocations.clone(),
    target: target.clone()
  }

  # Determine entry point name
  let entry = match target.os
  when OsAbi::MacOS   then "main"
  when OsAbi::Linux   then "_start"
  when OsAbi::Windows then "mainCRTStartup"
  end

  mut objects = Vec::new()
  objects.push(obj)

  let input = LinkerInput {
    objects: objects,
    entry: entry.to_string(),
    output: output_path,
    target: target
  }

  link_executable(&input)
end

def generate_object_file(program: &MirProgram, target: AsmTarget) -> Vec[u8]
  generate_native(program, target)
end

# ———————————————————————————————————————————————————————————————
# Host target detection
# ———————————————————————————————————————————————————————————————

def detect_host_target() -> AsmTarget
  # Delegate to the canonical host_target() in asm module
  # which checks TG_HOST_TARGET, HOSTTYPE, OSTYPE, and
  # PROCESSOR_ARCHITECTURE env vars with proper fallback.
  #
  # Override with explicit env vars if set:
  let arch_override = std::env::get_env("TG_TARGET_ARCH")
  let os_override   = std::env::get_env("TG_TARGET_OS")
  
  match arch_override
  when Option::Some(_) then
    let arch_str = arch_override.unwrap()
    let os_str   = os_override.unwrap_or("macos")
    
    let arch = if arch_str == "x86_64" || arch_str == "amd64" then Arch::X86_64
    elsif arch_str == "aarch64" || arch_str == "arm64" then Arch::AArch64
    else Arch::AArch64
    end
    
    let os = if os_str == "macos" || os_str == "darwin" then OsAbi::MacOS
    elsif os_str == "linux" then OsAbi::Linux
    elsif os_str == "windows" then OsAbi::Windows
    else OsAbi::MacOS
    end
    
    target_triple(arch, os)
  when Option::None then
    host_target()
  end
end
