  field_offset, field_offset_by_name, field_size,
  discriminant_offset, discriminant_size, payload_offset, variant_discriminant,
  container_header_size, container_field_offset,
  validate_layout, dump_layout_table, layout_align_up,
  LayoutAssertion,
  # New imports for direct layout engine queries
  primitive_size, primitive_align
}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirBlock, MirLocal, MirStatic,
  MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef,
  MirStatement, MirStatementKind,
