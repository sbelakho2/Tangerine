def cmd_explain(code: String) -> Unit
  let explanation = explain_error_code(code.clone())
  println("Error code " + code + ":")
  println("")
  println(explanation)
  println("")
  
  # Print example if available
  let example = error_code_example(code.clone())
  if !example.is_empty() then
    println("Example:")
    println(example)
  end
end

# (target-capability gate): the compile-time rejection site for
# operations the target's runtime has no body for. The map/set surface —
# destroy, entries, keys, clone, drain_one, the record-visit traversal —
# now has x86-64 parity in the runtime (the a64 bodies mirrored
# register-for-register), so for those operations the gate reports
# nothing; a FUTURE arch-gated stub is rejected here as a capability
# diagnostic (a normal compile error listing the operation) instead of
# emitting a runtime trap (ud2) or a fabricated default. The target triple
# is read from the options (the --target selection; the host target when
# absent — the same triple the codegen resolves).
def check_target_capabilities(opts: CompilerOptions) -> Vec[String]
  var rejections = Vec::new()
  let triple = match opts.target_triple
  when Option::Some(t) then t.clone()
  when Option::None then detect_host_target()
  end
  # The x86-64 map/set parity surface (the bodies live in runtime.tg):
  #   _tg_map_destroy / _tg_set_destroy (the arena + chains + free-list
  #     munmaps), _tg_map_entries, _tg_map_keys, _tg_map_clone,
  #     _tg_map_drain_one(_full) / _tg_set_drain_one(_full), and the
  #     record-visit traversal (__intrinsic_map/set_visit_begin/next/value).
  # All implemented — the rejection list stays empty for every arch. An
  # unimplemented op would be listed here, e.g.:
  #   rejections.push("target `" + triple + "`: <op> has no runtime body (compiler capability limit)")
  rejections
end

# 
# Argument Parsing
# 

def parse_args(argv: Vec[String]) -> Result[CompilerOptions, String]
  var opts = default_options()
  var i = 1  # Skip program name
  
  while i < argv.len() do
    let arg = argv[i].clone()
    
    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for -o")
      end
      opts.output_file = Option::Some(argv[i].clone())
    elsif arg == "-c" then
      opts.emit = EmitMode::Object
    elsif arg == "--emit-obj" then
      opts.emit = EmitMode::Object
    elsif arg == "--emit-mir" then
      opts.emit_mir = true
    elsif arg == "--print-ast" then
      opts.print_ast = true
    elsif arg == "--print-tokens" then
      opts.print_tokens = true
    elsif arg == "--dump-tokens" then
      opts.print_tokens = true
      opts.dump_phase = Option::Some("tokens")
    elsif arg == "--dump-ast" then
      opts.dump_phase = Option::Some("ast")
    elsif arg == "--dump-resolved-ast" then
      opts.dump_phase = Option::Some("resolved-ast")
    elsif arg == "--dump-module-graph" then
      opts.dump_phase = Option::Some("module-graph")
    elsif arg == "--dump-mir-lowered" then
      opts.dump_phase = Option::Some("mir-lowered")
      opts.emit_mir = true
    elsif arg == "--dump-mir-mono" then
      opts.dump_phase = Option::Some("mir-mono")
      opts.emit_mir = true
    elsif arg == "--dump-mir-opt" then
      opts.dump_phase = Option::Some("mir-opt")
      opts.emit_mir = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      # THE -g REJECTION (the reviewer's false-success fix): the
      # debug_info option was INERT — no compile path emits debug info
      # (generate_dwarf_debug_info has no caller), so the flag silently
      # claimed a feature that does not exist. The honest contract is the
      # REJECTION: `-g` fails with the explicit "debug info is not
      # supported" error instead of compiling with a decorative flag.
      return Result::Err("debug info is not supported: the -g flag is rejected (no compile path emits debug info)")
    elsif arg == "--check" then
      opts.check_only = true
    elsif arg == "-v" || arg == "--verbose" then
      opts.verbose = true
    elsif arg == "-q" || arg == "--quiet" then
      opts.quiet = true
    elsif arg == "-W" || arg == "--warn-all" then
      opts.warn_all = true
    elsif arg == "-Werror" then
      opts.deny_warnings = true
    elsif arg == "--strict" then
      opts.strict_resolution = true
    elsif arg == "--no-contracts" then
      opts.enable_contracts = false
    elsif arg == "--no-capabilities" then
      opts.enable_capabilities = false
    elsif arg == "--no-effects" then
      opts.enable_effects = false
    elsif arg == "--no-budgets" then
      opts.enable_budgets = false
    elsif arg == "--target" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for --target")
      end
      opts.target_triple = Option::Some(argv[i].clone())
    elsif arg == "--panic-strategy" then
      # STATE A (abort-only): panic=abort is the ONLY stable panic
      # strategy. The unwind/catch machinery is experimental and carries
      # no cleanup guarantees (no unwind cleanup edges exist), so a
      # stable build never selects it — an explicit request for
      # panic=unwind is REJECTED here, at the option boundary.
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for --panic-strategy (expected abort; unwind is rejected — abort-only is the only stable panic strategy)")
      end
      let panic_strat = argv[i].clone()
      if panic_strat == "abort" then
        ()
      elsif panic_strat == "unwind" then
        return Result::Err("--panic-strategy unwind is rejected: panic=abort is the ONLY stable panic strategy (the unwind/catch machinery is experimental, carries no cleanup guarantees, and is never selectable in a stable build)")
      else
        return Result::Err("Unknown panic strategy: " + panic_strat + " (abort is the only stable strategy; unwind is rejected)")
      end
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "--no-color" then
      opts.color = false
    elsif arg == "--color" then
      opts.color = true
    elsif arg.starts_with("--pgo-gen") then
      if arg.contains("=") then
        opts.pgo_gen = Option::Some(arg.split("=")[1].clone())
      else
        opts.pgo_gen = Option::Some(".tg_pgo_profile".to_string())
      end
    elsif arg.starts_with("--pgo-use") then
      if arg.contains("=") then
        opts.pgo_use = Option::Some(arg.split("=")[1].clone())
      else
        opts.pgo_use = Option::Some(".tg_pgo_profile".to_string())
      end
    elsif arg == "--mode" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for --mode")
      end
      let mode_str = argv[i].clone()
      if mode_str == "dev" then
        opts.mode = Mode::Dev
        opts.mode_config = config_for_mode(Mode::Dev)
      elsif mode_str == "strict" then
        opts.mode = Mode::Strict
        opts.mode_config = config_for_mode(Mode::Strict)
      elsif mode_str == "production" then
        opts.mode = Mode::Production
        opts.mode_config = config_for_mode(Mode::Production)
      elsif mode_str == "hardened" then
        opts.mode = Mode::Hardened
        opts.mode_config = config_for_mode(Mode::Hardened)
      else
        return Result::Err("Unknown mode: " + mode_str + " (expected dev/strict/production/hardened)")
      end
      # Apply mode-driven feature flags (enforce_contracts / enforce_
      # capabilities are unconditional; the enable_* options are inert —
      # no pass reads them, they are kept for CLI compatibility only).
      opts.enable_contracts = opts.mode_config.enforce_contracts
      opts.enable_capabilities = opts.mode_config.enforce_capabilities
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return Result::Err("help")
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return Result::Err("version")
    elsif arg.starts_with("-") then
      return Result::Err("Unknown option: " + arg)
    else
      opts.input_files.push(arg)
    end
    
    i = i + 1
  end
  
  if opts.input_files.is_empty() then
    return Result::Err("No input files")
  end
  
  Result::Ok(opts)
end

def parse_startup_compile_args(skip_subcommand: Bool) -> Result[CompilerOptions, String]
  var opts = default_options()
  let argc = raw_arg_count()
  var i = if skip_subcommand then 2 else 1 end

  while i < argc do
    let arg = raw_arg_copy(i)

    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argc then
        return Result::Err("Missing argument for -o")
      end
      opts.output_file = Option::Some(raw_arg_copy(i))
    elsif arg == "--emit-mir" then
      opts.emit_mir = true
    elsif arg == "-c" || arg == "--emit-obj" then
      opts.emit = EmitMode::Object
    elsif arg == "--print-ast" then
      opts.print_ast = true
    elsif arg == "--print-tokens" then
      opts.print_tokens = true
    elsif arg == "--dump-tokens" then
      opts.print_tokens = true
      opts.dump_phase = Option::Some("tokens")
    elsif arg == "--dump-ast" then
      opts.dump_phase = Option::Some("ast")
    elsif arg == "--dump-resolved-ast" then
      opts.dump_phase = Option::Some("resolved-ast")
    elsif arg == "--dump-module-graph" then
      opts.dump_phase = Option::Some("module-graph")
    elsif arg == "--dump-mir-lowered" then
      opts.dump_phase = Option::Some("mir-lowered")
      opts.emit_mir = true
    elsif arg == "--dump-mir-mono" then
      opts.dump_phase = Option::Some("mir-mono")
      opts.emit_mir = true
    elsif arg == "--dump-mir-opt" then
      opts.dump_phase = Option::Some("mir-opt")
      opts.emit_mir = true
    elsif arg == "--check" then
      opts.check_only = true
    elsif arg == "-v" || arg == "--verbose" then
      opts.verbose = true
    elsif arg == "-q" || arg == "--quiet" then
      opts.quiet = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      # THE -g REJECTION (the reviewer's false-success fix): the
      # debug_info option was INERT — no compile path emits debug info
      # (generate_dwarf_debug_info has no caller), so the flag silently
      # claimed a feature that does not exist. The honest contract is the
      # REJECTION: `-g` fails with the explicit "debug info is not
      # supported" error instead of compiling with a decorative flag.
      return Result::Err("debug info is not supported: the -g flag is rejected (no compile path emits debug info)")
    elsif arg == "--target" then
      i = i + 1
      if i >= argc then
        return Result::Err("Missing argument for --target")
      end
      opts.target_triple = Option::Some(raw_arg_copy(i))
    elsif arg == "--no-std" then
      # The no_std flag: accepted here (the compile route reads it from the
      # raw argv — CompilerOptions carries no dedicated field). A no_std
      # compile applies the core-only surface + _start entry + libc-free
      # link contract (see compile_to_nostd_route).
      ()
    elsif arg == "--panic-strategy" then
      # STATE A (abort-only): the startup-compile entry enforces the same
      # rejection as the full CLI — panic=unwind is never selectable.
      i = i + 1
      if i >= argc then
        return Result::Err("Missing argument for --panic-strategy (expected abort; unwind is rejected — abort-only is the only stable panic strategy)")
      end
      let panic_strat2 = raw_arg_copy(i)
      if panic_strat2 == "abort" then
        ()
      elsif panic_strat2 == "unwind" then
        return Result::Err("--panic-strategy unwind is rejected: panic=abort is the ONLY stable panic strategy (the unwind/catch machinery is experimental, carries no cleanup guarantees, and is never selectable in a stable build)")
      else
        return Result::Err("Unknown panic strategy: " + panic_strat2 + " (abort is the only stable strategy; unwind is rejected)")
      end
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return Result::Err("help")
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return Result::Err("version")
    elsif arg.starts_with("-") then
      return Result::Err("Unknown option: " + arg)
    end

    i = i + 1
  end

  Result::Ok(opts)
end

def print_help() -> Unit
  println("Usage: tg [SUBCOMMAND] [OPTIONS] [FILES]...")
  println("")
  println("Subcommands:")
  println("  build     Compile project (uses Tangerine.toml)")
  println("  run       Compile and execute")
  println("  test      Discover and run tests")
  println("  check     Type-check, access-check and resource-check only")
  println("  fmt       Format source files")
  println("  lint      Run linter")
  println("  doc       Generate documentation")
  println("  bench     Run benchmarks")
  println("  repl      Interactive REPL")
  println("  lsp       Start language server (alias: ln)")
  println("  init      Create new project")
  println("  dep       Dependency management (add/remove/list/update/tree)")
  println("  install   Install a package globally")
  println("  self-update Update the compiler")
  println("  explain   Explain an error code")
  println("  agent     Run agentic workflows (check/caps/effects/budget/diff/audit)")
  println("")
  println("Options:")
  println("  -o, --output <FILE>  Write output to FILE")
  println("  -c                   Compile to object file")
  println("  --emit-obj           Emit object file")
  println("  --emit-mir           Print MIR representation")
  println("  --print-ast          Print AST")
  println("  --print-tokens       Print tokens")
  println("  -O0 / -O1 / -O2 / -O3  Optimization level")
  println("  -g                   Include debug info")
  println("  --check              Check only, don't compile")
  println("  -v, --verbose        Verbose output")
  println("  -q, --quiet          Quiet output")
  println("  -W, --warn-all       Enable all warnings")
  println("  -Werror              Treat warnings as errors")
  println("  --no-contracts       Disable contract checking")
  println("  --no-capabilities    Disable capability system")
  println("  --no-effects         Disable effect system")
  println("  --no-budgets         Disable budget system")
  println("  --target <TRIPLE>    Cross-compile for target (e.g. x86_64-linux-gnu, aarch64-macos)")
  println("                     aarch64 REQUIRES the ARMv8.1 LSE atomics (LDADDAL/CASAL/SWPAL —")
  println("                     Apple Silicon, Neoverse, Cortex-A75+; see asm.tg's target feature")
  println("                     table; the ldaxr/stlxr LL/SC fallback is the future portable mode)")
  println("  --panic-strategy <S>  abort (the ONLY stable strategy; unwind is rejected —")
  println("                     the unwind/catch machinery is experimental and never selectable)")
  println("  --pgo-gen[=PATH]     Instrument binary for profile generation")
  println("  --pgo-use[=PATH]     Optimize using previously collected profile data")
  println("  --json               Emit diagnostics in JSON format")
  println("  --no-color           Disable colored output")
  println("  --color              Force colored output")
  println("  -h, --help           Show help")
  println("  -V, --version        Show version")
end

def print_version() -> Unit
  println("Tangerine compiler v" + VERSION)
  println("Self-hosting edition")
end

# 
# Subcommands
# 

enum Subcommand
  Build        # tg build  compile project
  Parse        # tg parse  parse only
  Run          # tg run  compile and execute
  Test         # tg test  discover and run tests
  Check        # tg check  type/access/resource check only
  Fmt          # tg fmt  format source files
  Lint         # tg lint  run linter
  Doc          # tg doc  generate documentation
  Bench        # tg bench  run benchmarks
  Repl         # tg repl  interactive REPL
  Lsp          # tg lsp  start language server
  Init         # tg init  create new project
  Dep          # tg dep  dependency management
  Install      # tg install  install a package
  SelfUpdate   # tg self-update  update the compiler
  Explain      # tg explain E0XXX  explain error code
  Agent        # tg agent  run agentic workflows
  Bindgen      # tg bindgen  generate FFI bindings
  Abi          # tg abi  ABI tools (test, dump)
  Compile      # tg <files>  raw compile (default, no subcommand)
end

struct SubcommandDispatch
  subcmd: Subcommand
  sub_argv: Vec[String]
end

def startup_args() -> Vec[String]
  let argc = raw_arg_count()
  var result: Vec[String] = Vec::new()
  var i = 0
  while i < argc do
    result.push(raw_arg_copy(i))
    i = i + 1
  end
  result
end

def startup_subcommand_argv() -> Vec[String]
  let argc = raw_arg_count()
  var result: Vec[String] = Vec::new()
  if argc > 0 then
    result.push(raw_arg_copy(0))
  end
  var i = 2
  while i < argc do
    result.push(raw_arg_copy(i))
    i = i + 1
  end
  result
end

# 
# Main Entry Point
# 

def driver_main() -> Int
  let argc = raw_arg_count()

  if argc < 2 then
    print_help()
    return 0
  end

  let first = raw_arg_unchecked(1)

  if first == "-h" || first == "--help" then
    print_help()
    return 0
  end

  if first == "-V" || first == "--version" then
    print_version()
    return 0
  end

  if first == "build" then
    cmd_build(startup_subcommand_argv())
  elsif first == "parse" then
    cmd_parse(startup_subcommand_argv())
  elsif first == "run" then
    cmd_run(startup_subcommand_argv())
  elsif first == "test" then
    cmd_test(startup_subcommand_argv())
  elsif first == "check" then
    cmd_check(startup_subcommand_argv())
  elsif first == "fmt" || first == "format" then
    cmd_fmt(startup_subcommand_argv())
  elsif first == "lint" then
    cmd_lint(startup_subcommand_argv())
  elsif first == "doc" then
    cmd_doc(startup_subcommand_argv())
  elsif first == "bench" then
    cmd_bench(startup_subcommand_argv())
  elsif first == "repl" then
    cmd_repl(startup_subcommand_argv())
  elsif first == "lsp" || first == "ln" then
    cmd_lsp(startup_subcommand_argv())
  elsif first == "init" then
    cmd_init(startup_subcommand_argv())
  elsif first == "dep" then
    cmd_dep(startup_subcommand_argv())
  elsif first == "install" then
    cmd_install(startup_subcommand_argv())
  elsif first == "self-update" || first == "update" then
    cmd_self_update(startup_subcommand_argv())
  elsif first == "explain" then
    cmd_explain_main(startup_subcommand_argv())
  elsif first == "agent" then
    cmd_agent(startup_subcommand_argv())
  elsif first == "bindgen" then
    cmd_bindgen(startup_subcommand_argv())
  elsif first == "abi" then
    cmd_abi(startup_subcommand_argv())
  elsif first == "compile" then
    cmd_compile(startup_subcommand_argv())
  else
    cmd_compile_raw(false)
  end
end

def subcommand_argv(argv: Vec[String]) -> Vec[String]
  var sub_argv: Vec[String] = Vec::new()
  sub_argv.push(argv[0].clone())
  var i: UInt = 2
  while i < argv.len() do
    sub_argv.push(argv[i].clone())
    i = i + 1
  end
  sub_argv
end

def detect_subcommand(argv: Vec[String]) -> SubcommandDispatch
  if argv.len() < 2 then
    return SubcommandDispatch { subcmd: Subcommand::Compile, sub_argv: argv }
  end
  
  let first: String = argv[1].clone()
  
  let subcmd = if first == "build" then
    Subcommand::Build
  elsif first == "parse" then
    Subcommand::Parse
  elsif first == "run" then
    Subcommand::Run
  elsif first == "test" then
    Subcommand::Test
  elsif first == "check" then
    Subcommand::Check
  elsif first == "fmt" || first == "format" then
    Subcommand::Fmt
  elsif first == "lint" then
    Subcommand::Lint
  elsif first == "doc" then
    Subcommand::Doc
  elsif first == "bench" then
    Subcommand::Bench
  elsif first == "repl" then
    Subcommand::Repl
  elsif first == "lsp" || first == "ln" then
    Subcommand::Lsp
  elsif first == "init" then
    Subcommand::Init
  elsif first == "dep" then
    Subcommand::Dep
  elsif first == "install" then
    Subcommand::Install
  elsif first == "self-update" || first == "update" then
    Subcommand::SelfUpdate
  elsif first == "explain" then
    Subcommand::Explain
  elsif first == "agent" then
    Subcommand::Agent
  elsif first == "bindgen" then
    Subcommand::Bindgen
  elsif first == "abi" then
    Subcommand::Abi
  elsif first == "compile" then
    Subcommand::Compile
  else
    # No subcommand  treat as raw compile
    return SubcommandDispatch { subcmd: Subcommand::Compile, sub_argv: argv }
  end
  
  # Build sub-argv: [program_name, args after subcommand...]
  var sub_argv: Vec[String] = Vec::new()
  sub_argv.push(argv[0].clone())
  var i: UInt = 2
  while i < argv.len() do
    sub_argv.push(argv[i].clone())
    i = i + 1
  end
  
  SubcommandDispatch { subcmd: subcmd, sub_argv: sub_argv }
end

# 
# Subcommand: build
# 

def cmd_build(argv: Vec[String]) -> Int
  # Bootstrap fast path: detect explicit stage2 output from raw argv
  var requested_output = Option::None
  var i: UInt = 0
  while i < argv.len() do
    let arg = argv[i].clone()
    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i < argv.len() then
        requested_output = Option::Some(argv[i].clone())
      end
    end
    i = i + 1
  end
  match requested_output
  when Option::Some(out) then
    # No bootstrap fast-path. Always build correctly.
    ()
  when Option::None then ()
  end

  # Try loading project from Tangerine.toml first
  match load_project(".") 
  when Result::Ok(project) then
    # Merge CLI options with project config
    let opts = match parse_args(argv)
    when Result::Ok(o) then o
    when Result::Err(e) then
      if e == "help" || e == "version" then
        return 0
      elsif e == "No input files" then
        # Use project sources
        var o = default_options()
        o.input_files = clone_vec_strings(&project.sources)
        o
      else
        return 1
      end
    end

    match build_project(&project)
    when Result::Ok(_) then 0
    when Result::Err(e) then
      1
    end # end match build_project
  when Result::Err(e) then
    # No project file  compile with CLI args
    cmd_compile(argv)
  end # end match load_project
end # end main

def cmd_parse(argv: Vec[String]) -> Int
  let opts = match parse_args(argv)
  when Result::Ok(o) then
    var o2 = o
    o2.check_only = true
    o2.stop_after = StopAfter::Parse
    o2
  when Result::Err(e) then
    if e == "help" || e == "No input files" then
      println("Usage: tg parse [OPTIONS] [FILES]...")
      println("Parse files only (no type-check or codegen)")
      return if e == "help" then 0 else 1 end
    else
      return 1
    end
  end

  var exit_code = 0
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      exit_code = 1
    end
  end

  exit_code
end

# 
# Subcommand: run
# 

def cmd_run(argv: Vec[String]) -> Int
  # Compile to a temp executable, then run it
  let opts = match parse_args(argv)
  when Result::Ok(o) then o
  when Result::Err(e) then
    if e == "No input files" then
      # Try project
      match load_project(".")
      when Result::Ok(project) then
        var o = default_options()
        o.input_files = clone_vec_strings(&project.sources)
        o
      when Result::Err(_) then
        return 1
      end
    elsif e == "help" then
      println("Usage: tg run [OPTIONS] [FILES]...")
      println("Compile and run a Tangerine program")
      return 0
    else
      return 1
    end
  end
  
  # Compile
  let exe_path = get_output_path(&opts, opts.input_files[0].clone(), "")
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return 1
    end
  end
  
  # Execute
  let exit_code = execute_binary(exe_path)
  exit_code
end

# Standard file descriptor for stdout
def STDOUT_FILENO() -> Int = 1

def execute_binary(path: String) -> Int
  # Run the compiled binary through the ARGV-based process API — never a
  # shell string. A path containing spaces/quotes is ONE argv element and
  # no shell metacharacter is ever interpreted. Command::status forwards
  # the child's exit code exactly (WEXITSTATUS) and maps a signal
  # termination to the shell convention 128+sig — the same status a
  # `tg run` from a shell would observe.
  var command = std::process::Command::new(path)
  match command.status()
  when Result::Ok(code) then code
  when Result::Err(e) then
    eprintln("error: cannot execute '" + path + "': " + e)
    127
  end
end

# 
# Subcommand: test
# 

def cmd_test(argv: Vec[String]) -> Int
  # Discover test sources: from project or CLI args. Explicitly named FILES
  # are verified strictly; project discovery and directory scans select only
  # RECOGNIZED test sources (the files carrying the @test test-attribute
  # marker) and run them under the same strict discipline — a recognized
  # test source's read/parse/compile failure fails the invocation; non-test
  # sources are never selected.
  var explicit_files: Vec[String] = Vec::new()
  var implicit_files: Vec[String] = Vec::new()

  match parse_args(argv)
  when Result::Ok(o) then
    if o.input_files.is_empty() then
      # Implicit discovery (project sources or directory scan): narrowed to
      # RECOGNIZED test sources below; non-test sources are never selected.
      match load_project(".")
      when Result::Ok(project) then
        let srcs = clone_vec_strings(&project.sources)
        for s in srcs do implicit_files.push(s) end
      when Result::Err(_) then
        let found = find_tg_files(".")
        for f in found do implicit_files.push(f) end
      end
    else
      for f in o.input_files do
        if is_dir(f.clone()) then
          let sub = find_tg_files(f.clone())
          for s in sub do implicit_files.push(s) end
        else
          explicit_files.push(f.clone())
        end
      end
    end
  when Result::Err(e) then
    if e == "help" then
      println("Usage: tg test [OPTIONS] [FILES]...")
      println("Discover and run @test functions")
      return 0
    elsif e == "No input files" then
      match load_project(".")
      when Result::Ok(project) then
        let srcs = clone_vec_strings(&project.sources)
        for s in srcs do implicit_files.push(s) end
      when Result::Err(_) then
        let found = find_tg_files(".")
        for f in found do implicit_files.push(f) end
      end
    else
      return 1
    end
  end

  # Implicit discovery selects only RECOGNIZED test sources: the files
  # carrying the @test test-attribute marker (the recognized set). Non-test
  # sources are never selected; a selected source is a recognized test
  # source and its read/parse/compile failure fails the invocation (no
  # silent vanish).
  implicit_files = select_test_sources(implicit_files)

  let opts = default_options()

  var summary = run_test_files(&opts, explicit_files, true)
  let scan_summary = run_test_files(&opts, implicit_files, true)
  summary.total = summary.total + scan_summary.total
  summary.passed = summary.passed + scan_summary.passed
  summary.failed = summary.failed + scan_summary.failed
  for n in scan_summary.fail_names do
    summary.fail_names.push(n)
  end

  println("")
  println("test result: " + if summary.failed == 0 then "ok" else "FAILED" end
    + ". " + summary.passed.to_string() + " passed; " + summary.failed.to_string()
    + " failed; " + summary.total.to_string() + " total")

  if !summary.fail_names.is_empty() then
    println("")
    println("failures:")
    for name in summary.fail_names do
      println("    " + name)
    end
  end

  if summary.failed > 0 then 1 else 0 end
end

struct TestRunSummary
  total: Int
  passed: Int
  failed: Int
  fail_names: Vec[String]
end

struct TestResult
  name: String
  passed: Bool
  message: String
end

# Run one batch of test files.
#   strict   — explicitly named files: a read/lex/parse/resolve/type/
#              ownership/MIR/codegen/link failure FAILS the batch (the
#              diagnostics are emitted and the failure is counted, never
#              skipped); a file with zero @test functions FAILS it with the
#              "no tests found in <file>" diagnostic. Only a file whose tests
#              all pass succeeds.
#   implicit — discovered suites (directory scans, project sources): the
#              batch has already been narrowed to RECOGNIZED test sources
#              (select_test_sources — the files carrying the @test marker),
#              so the strict discipline applies: a recognized test source's
#              read/parse/compile failure fails the invocation; non-test
#              sources are never selected.
def run_test_files(opts: CompilerOptions, files: Vec[String], strict: Bool) -> TestRunSummary
  var total = 0
  var passed = 0
  var failed = 0
  var fail_names: Vec[String] = Vec::new()

  for file in files do
    let source = match read_file(file.clone())
    when Result::Ok(content) then content
    when Result::Err(_) then
      if strict then
        eprintln("error: failed to read test file: " + file)
        failed = failed + 1
        fail_names.push(file.clone())
        println("  FAIL  " + file + ": failed to read file")
      end
      next
    end
    let lex_result = tokenize(source.clone(), file.clone())
    let parse_out = parse(lex_result)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then
      if strict then
        # Emit the parse diagnostics and count the file as failed: an
        # explicitly named test file is never skipped.
        for d in parse_diags do
          let dmsg = d.message
          match d.code
          when Option::Some(c) then eprintln(file + ": error[" + c + "]: " + dmsg)
          when Option::None then eprintln(file + ": error: " + dmsg)
          end
        end
        failed = failed + 1
        fail_names.push(file.clone())
        println("  FAIL  " + file + ": parse errors (see diagnostics)")
      end
      next
    end

    # Find @test functions
    var tests: Vec[FunctionDecl] = Vec::new()
    var has_main = false
    for item in ast.items do
      var is_test = false
      for attr in item.attrs do
        if attr.name == "test" then
          is_test = true
        end
      end
      match item.kind
      when ItemKind::ItemFunction(func_decl) then
        if is_test then
          tests.push(func_decl.clone())
        elsif func_decl.name == "main" then
          has_main = true
        end
      when _ then ()
      end
    end

    if tests.is_empty() then
      if strict then
        # An explicitly named test file must contain @test functions. Gate it
        # through the full `tg check` pipeline first so a resolve/type/
        # ownership/MIR error cannot pass `tg test` vacuously, then fail:
        # such a module should be verified with `tg check` instead.
        var check_opts = opts
        check_opts.check_only = true
        check_opts.stop_after = StopAfter::Mir
        match compile_file(&check_opts, file.clone())
        when Result::Ok(_) then ()
        when Result::Err(e) then
          eprintln(e)
        end
        println("  FAIL  " + file + ": no @test functions found (verify with `tg check` instead)")
        eprintln("error: no tests found in " + file)
        failed = failed + 1
        fail_names.push(file.clone())
      end
      next
    end

    # Compile the file once (with a generated main that dispatches to each
    # @test function by name) and run each test as its own process. A file
    # that defines its own main is compiled as-is and run once (canary
    # convention).
    let outcome = if has_main then
      compile_and_run_file_main(opts, file.clone())
    else
      compile_and_run_tests(opts, file.clone(), source, tests.clone())
    end

    match outcome
    when Result::Ok(results) then
      for r in results do
        total = total + 1
        if r.passed then
          passed = passed + 1
          println("  PASS  " + file + "::" + r.name)
        else
          failed = failed + 1
          fail_names.push(file.clone() + "::" + r.name)
          println("  FAIL  " + file + "::" + r.name + ": " + r.message)
        end
      end
    when Result::Err(e) then
      # The file failed to compile (resolve/type/ownership/MIR/codegen/link):
      # every test in it fails with the compile error — never skipped.
      for t in tests do
        total = total + 1
        failed = failed + 1
        fail_names.push(file.clone() + "::" + t.name)
        println("  FAIL  " + file + "::" + t.name + ": " + e)
      end
    end
  end

  TestRunSummary { total: total, passed: passed, failed: failed, fail_names: fail_names }
end

# Compile the test file once with a generated dispatch main, then run each
# @test function by name as its own process.
def compile_and_run_tests(opts: CompilerOptions, file: String, source: String, tests: Vec[FunctionDecl]) -> Result[Vec[TestResult], String]
  let harness_base = file.replace("/", "_").replace(".tg", "") + "_harness"
  let harness_path = "build/.tg_test_harness/" + harness_base + ".tg"
  match mkdir_p("build/.tg_test_harness".to_string())
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err("failed to create test harness directory: " + e.to_string())
  end

  var harness_src = source.clone()
  harness_src = harness_src + "\n\n# [generated by `tg test`] per-test dispatch main\n"
  harness_src = harness_src + "use std::args\n\n"
  harness_src = harness_src + "def main() -> Int\n"
  harness_src = harness_src + "  let argv = args::args()\n"
  harness_src = harness_src + "  if argv.len() < 2 then\n"
  harness_src = harness_src + "    return 1\n"
  harness_src = harness_src + "  end\n"
  harness_src = harness_src + "  let name = argv[1]\n"
  var ti = 0
  var first = true
  while ti < tests.len() do
    let t = tests[ti]
    if first then
      harness_src = harness_src + "  if name == \"" + t.name + "\" then\n"
      first = false
    else
      harness_src = harness_src + "  elsif name == \"" + t.name + "\" then\n"
    end
    harness_src = harness_src + "    " + t.name + "()\n"
    ti = ti + 1
  end
  harness_src = harness_src + "  else\n"
  harness_src = harness_src + "    panic(\"unknown test: \" + name)\n"
  harness_src = harness_src + "  end\n"
  harness_src = harness_src + "  0\n"
  harness_src = harness_src + "end\n"

  match write_file(harness_path.clone(), harness_src)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err("failed to write test harness: " + e.to_string())
  end

  match compile_file(opts, harness_path.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err("compilation failed: " + e)
  end

  let exe_path = get_output_path(&opts, harness_path.clone(), "")
  var results = Vec::new()
  var ri = 0
  while ri < tests.len() do
    let t = tests[ri]
    var test_args: Vec[String] = Vec::new()
    test_args.push(t.name.clone())
    let exit_code = bootstrap_call_argv(exe_path.clone(), test_args)
    let passed = exit_code == 0
    let message = if passed then "" else "test exited with code " + exit_code.to_string() end
    results.push(TestResult {
      name: t.name.clone(),
      passed: passed,
      message: message
    })
    ri = ri + 1
  end
  Result::Ok(results)
end

# Files that define their own main (canary convention) are compiled as-is and
# run once; the process exit code is the test outcome.
def compile_and_run_file_main(opts: CompilerOptions, file: String) -> Result[Vec[TestResult], String]
  match compile_file(opts, file.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err("compilation failed: " + e)
  end
  let exe_path = get_output_path(&opts, file.clone(), "")
  let exit_code = bootstrap_call_argv(exe_path.clone(), Vec::new())
  var results = Vec::new()
  let passed = exit_code == 0
  let message = if passed then "" else "test exited with code " + exit_code.to_string() end
  results.push(TestResult {
    name: "main".to_string(),
    passed: passed,
    message: message
  })
  Result::Ok(results)  end  end
end

# 
# Subcommand: check
# 

def cmd_check(argv: Vec[String]) -> Int
  let opts = match parse_args(argv)
  when Result::Ok(o) then
    var o2 = o
    o2.check_only = true
    o2.stop_after = StopAfter::Mir
    o2
  when Result::Err(e) then
    if e == "help" then
      println("Usage: tg check [OPTIONS] [FILES]...")
      println("Type-check, access-check and resource-check without compiling")
      return 0
    elsif e == "No input files" then
      match load_project(".")
      when Result::Ok(project) then
        var o = default_options()
        o.check_only = true
        o.stop_after = StopAfter::Mir
        o.input_files = clone_vec_strings(&project.sources)
        o
      when Result::Err(_) then
        return 1
      end
    else
      return 1
    end
  end
  
  var exit_code = 0
  for file in opts.input_files do
    match compile_file(&opts, file.clone())
    when Result::Ok(_) then
      # (the CQS query server — the canonical pipeline's invocation): the
      # compiler-query-server queries run on the SAME canonical semantic
      # path the check gate runs (parse -> dependency merge -> analyze ->
      # lower). The query results AFFECT the compilation where required:
      # an Error-level CQS diagnostic (the mode matrix's gated failure —
      # Production/Hardened) is reported and fails the check. The Dev-mode
      # sweep contract (zero diagnostics) is untouched: the Dev matrix
      # enforces nothing, so no diagnostic is emitted.
      let cqs_diags = driver_cqs_query_pass(file.clone(), &opts)
      var cqs_failed = false
      for d in cqs_diags do
        match d.level
        when DiagLevel::Error then cqs_failed = true
        when _ then ()
        end
      end
      if cqs_failed then
        eprintln("CQS gate: " + join_diagnostics(&cqs_diags))
        exit_code = 1
      end
    when Result::Err(e) then
      # Surface the failure (e.g. the E106 hard error on `&T` type positions,
      # which aborts at the parse stage): the diagnostics were reported by
      # the compile pipeline, but the final error line is printed here.
      eprintln(e)
      exit_code = 1
    end
  end
  
  exit_code
end

# (the CQS query server — the canonical pipeline's invocation): the
# driver-owned query pass. The pass re-runs the canonical semantic path
# (the same parse -> merge -> analyze -> lower shape the check gate
# runs) and returns the three query results' diagnostic channel — the
# Error-level entries (the mode matrix's gated failures) fail the check;
# the warning-level entries stay in the query results (the API and the
# strict modes surface them). The pass fails silently (an empty result)
# when the file does not parse or analyze — the semantic gate already
# reported those failures.
def driver_cqs_query_pass(file: String, opts: CompilerOptions) -> Vec[Diagnostic]
  var empty = Vec::new()
  let source = match read_file(file.clone())
  when Result::Ok(s) then s
  when Result::Err(_) then return empty
  end
  var ast = match parse_source_program(source, file)
  when Result::Ok(program) then program
  when Result::Err(_) then return empty
  end
  let merged = match merge_imported_deps(ast, include_compiler_lib: false)
  when Result::Ok(m) then m
  when Result::Err(_) then return empty
  end
  ast = merged
  var env = type_env_new()
  var typed_program: Option[AnalyzedProgram] = Option::None
  match analyze_program(&mut env, &mut ast, &opts)
  when Result::Ok(ap) then typed_program = Option::Some(ap)
  when Result::Err(_) then return empty
  end
  let mir = match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then m
  when Result::Err(_) then return empty
  end
  match typed_program
  when Option::Some(ap) then
    let results = cqs_run_queries(cqs_query_server_new(), &ast, &ap.typed, &mir, opts.mode, "driver")
    results.diagnostics
  when Option::None then empty
  end
end

# 
# Subcommand: fmt
# 

use tg_compiler::formatter::{format_file, format_source, FormatConfig, default_format_config, format_check, fmt_type_expr_to_string}

def cmd_fmt(argv: Vec[String]) -> Int
  var check_only = false
  var files = Vec::new()
  var config = default_format_config()
  
  var i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--check" then
      check_only = true
    elsif arg == "--indent" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --indent")
        return 1
      end
      config.indent_width = argv[i].parse_uint().unwrap_or(2)
    elsif arg == "--line-width" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --line-width")
        return 1
      end
      config.max_line_width = argv[i].parse_uint().unwrap_or(100)
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg fmt [OPTIONS] [FILES]...")
      println("Format Tangerine source files")
      println("")
      println("Options:")
      println("  --check          Check formatting without writing")
      println("  --indent <N>     Indentation width (default: 2)")
      println("  --line-width <N> Maximum line width (default: 100)")
      return 0
    elsif arg.starts_with("-") then
      eprintln("error: unknown option '" + arg + "' for `tg fmt` (try `tg fmt --help`)")
      return 1
    else
      files.push(arg.clone())
    end
    i = i + 1
  end
  
  # If no files, format all.tg files in project
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  var exit_code = 0
  var formatted_count: UInt = 0
  
  for file in files do
    if check_only then
      match format_check(file.clone(), &config)
      when Result::Ok(needs_format) then
        if needs_format then
          println("Would reformat: " + file)
          exit_code = 1
        end
      when Result::Err(e) then
        exit_code = 1
      end
    else
      match format_file(file.clone(), &config)
      when Result::Ok(changed) then
        if changed then
          formatted_count = formatted_count + 1
          println("Formatted: " + file)
        end
      when Result::Err(e) then
        exit_code = 1
      end
    end
  end
  
  if !check_only && formatted_count > 0 then
    println(formatted_count.to_string() + " file(s) formatted")
  end
  
  exit_code
end

# 
# Subcommand: lint
# 

use tg_compiler::linter::{lint_file, list_lints, LintConfig, LintDiagnostic, default_lint_config, LintLevel}

def cmd_lint(argv: Vec[String]) -> Int
  var files = Vec::new()
  var config = default_lint_config()
  var list_only = false
  
  var i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--deny" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --deny")
        return 1
      end
      config.denied.push(argv[i].clone())
    elsif arg == "--allow" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --allow")
        return 1
      end
      config.allowed.push(argv[i].clone())
    elsif arg == "--warn" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --warn")
        return 1
      end
      config.warned.push(argv[i].clone())
    elsif arg == "--json" then
      config.json_output = true
    elsif arg == "--list" then
      list_only = true
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg lint [OPTIONS] [FILES]...")
      println("Run linter on Tangerine source files")
      println("")
      println("Options:")
      println("  --deny <LINT>    Deny a lint (error)")
      println("  --allow <LINT>   Allow a lint (suppress)")
      println("  --warn <LINT>    Warn on a lint")
      println("  --json           Output diagnostics as JSON")
      println("  --list           List the available lints")
      println("")
      println("Exit codes:")
      println("  0  no diagnostics")
      println("  1  at least one error-level diagnostic (or a read failure)")
      println("  2  warnings/info only")
      return 0
    elsif arg.starts_with("-") then
      eprintln("error: unknown option '" + arg + "' for `tg lint` (try `tg lint --help`)")
      return 1
    else
      files.push(arg.clone())
    end
    i = i + 1
  end

  if list_only then
    let lints = list_lints()
    for (name, desc, level) in lints do
      let level_str = match level
      when LintLevel::Error then "error"
      when LintLevel::Warning then "warning"
      when LintLevel::Info then "info"
      end
      println(name + "  [" + level_str + "]  " + desc)
    end
    return 0
  end
  
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  var total_warnings: UInt = 0
  var total_errors: UInt = 0
  var diag_count: UInt = 0
  
  for file in files do
    match lint_file(file.clone(), &config)
    when Result::Ok(diagnostics) then
      for diag in diagnostics do
        diag_count = diag_count + 1
        if config.json_output then
          println(lint_diagnostic_json(&diag))
        else
          let level_str = match diag.level
          when LintLevel::Error then "error"
          when LintLevel::Warning then "warning"
          when LintLevel::Info then "info"
          end
          println(diag.file.clone() + ":" + diag.line.to_string() + ":" + diag.column.to_string() +
            ": " + level_str + "[" + diag.lint_name.clone() + "]: " + diag.message.clone())
        end
        match diag.level
        when LintLevel::Error then
          total_errors = total_errors + 1
        when LintLevel::Warning then
          total_warnings = total_warnings + 1
        when LintLevel::Info then
        end
      end
    when Result::Err(e) then
      eprintln(e)
      total_errors = total_errors + 1
    end
  end
  
  if !config.json_output && diag_count > 0 then
    println("lint: " + diag_count.to_string() + " diagnostic(s), " + total_errors.to_string() +
      " error(s), " + total_warnings.to_string() + " warning(s)")
  end
  
  if total_errors > 0 then
    1
  elsif diag_count > 0 then
    2
  else
    0
  end
end

# The single-line JSON form of a lint diagnostic (the --json output
# channel — one object per diagnostic, RFC 8259-parseable as a stream).
def lint_diagnostic_json(diag: LintDiagnostic) -> String
  let level_str = match diag.level
  when LintLevel::Error then "error"
  when LintLevel::Warning then "warning"
  when LintLevel::Info then "info"
  end
  "{\"file\":\"" + json_escape(diag.file.clone()) +
    "\",\"line\":" + diag.line.to_string() +
    ",\"column\":" + diag.column.to_string() +
    ",\"level\":\"" + level_str + "\"" +
    ",\"lint\":\"" + json_escape(diag.lint_name.clone()) + "\"" +
    ",\"message\":\"" + json_escape(diag.message.clone()) + "\"}"
end

# 
# Subcommand: doc
# 

use tg_compiler::docgen::{generate_docs, DocConfig, default_doc_config}

def cmd_doc(argv: Vec[String]) -> Int
  var files = Vec::new()
  var config = default_doc_config()
  
  var i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--output" || arg == "-o" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for " + arg)
        return 1
      end
      config.output_dir = argv[i].clone()
    elsif arg == "--format" then
      i = i + 1
      if i >= argv.len() then
        eprintln("error: missing value for --format")
        return 1
      end
      if argv[i] == "html" then
        config.format = DocFormat::Html
      elsif argv[i] == "markdown" || argv[i] == "md" then
        config.format = DocFormat::Markdown
      else
        eprintln("error: unknown format '" + argv[i] + "' (expected html or markdown)")
        return 1
      end
    elsif arg == "--private" then
      config.include_private = true
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg doc [OPTIONS] [FILES]...")
      println("Generate documentation")
      println("")
      println("Options:")
      println("  -o, --output <DIR>  Output directory (default: docs/api)")
      println("  --format <FMT>      Output format: html, markdown (default: html)")
      println("  --private           Include private items")
      return 0
    elsif arg.starts_with("-") then
      eprintln("error: unknown option '" + arg + "' for `tg doc` (try `tg doc --help`)")
      return 1
    else
      files.push(arg.clone())
    end
    i = i + 1
  end
  
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  match generate_docs(files, &config)
  when Result::Ok(count) then
    println("Generated documentation for " + count.to_string() + " item(s) in " + config.output_dir)
    0
  when Result::Err(e) then
    1
  end
end

# 
# Subcommand: bench
# 

use std::bench::{BenchSuite, bench_suite_new, run_benchmarks, parse_bench_args}

def cmd_bench(argv: Vec[String]) -> Int
  # The benchmark-option parser is the single authority for the flags
  # (--json/--baseline/--filter/--exact/--list/--min-iters/...): CI invokes
  # `tg bench --json` and `tg bench --baseline <file>` and the output must
  # reflect them.
  let config = parse_bench_args(argv.clone())
  # Discover benchmark sources: from CLI args or project.
  var bench_files: Vec[String] = Vec::new()
  if argv.len() > 1 && !argv[1].starts_with("-") then
    var i: UInt = 1
    while i < argv.len() do
      if !argv[i].starts_with("-") then
        bench_files.push(argv[i].clone())
      end
      i = i + 1
    end
  else
    match load_project(".")
    when Result::Ok(project) then
      let srcs = clone_vec_strings(&project.sources)
      for s in srcs do bench_files.push(s) end
    when Result::Err(_) then
      let found = find_bench_files(".")
      for f in found do bench_files.push(f) end
    end
  end

  if bench_files.is_empty() then
    println("No benchmark files found.")
    eprintln("error: no benchmarks found")
    return 1
  end

  let opts = default_options()
  var total = 0
  var ok_count = 0
  var failed = 0
  var results: Vec[(String, BenchOutcome)] = Vec::new()

  for file in bench_files do
    let source = match read_file(file.clone())
    when Result::Ok(content) then content
    when Result::Err(_) then
      eprintln("error: failed to read benchmark file: " + file)
      println("  FAIL  " + file + ": failed to read file")
      failed = failed + 1
      next
    end
    let lex_result = tokenize(source, file.clone())
    let parse_out = parse(lex_result)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then
      # Emit the parse diagnostics and count the file as failed: a benchmark
      # source that cannot be parsed is never skipped.
      for d in parse_diags do
        let dmsg = d.message
        match d.code
        when Option::Some(c) then eprintln(file + ": error[" + c + "]: " + dmsg)
        when Option::None then eprintln(file + ": error: " + dmsg)
        end
      end
      println("  FAIL  " + file + ": parse errors (see diagnostics)")
      failed = failed + 1
      next
    end

    let cases = extract_bench_functions(&ast, file.clone())
    if cases.is_empty() then
      println("  FAIL  " + file + ": no @bench functions found (verify with `tg check` instead)")
      eprintln("error: no benchmarks found in " + file)
      failed = failed + 1
      next
    end

    for bench in cases do
      # The --filter/--exact options: only the matching benches run.
      match config.filter
      when Option::Some(f) then
        let matches = if config.exact then bench.name == f else bench.name.contains(&f) end
        if !matches then next end
      when Option::None then ()
      end
      total = total + 1
      if config.list_only then
        println(bench.name)
        ok_count = ok_count + 1
        next
      end
      # Compile the file to get a runnable binary, then invoke the bench by
      # name; the wall-clock of the invocation is the honest measurement
      # proxy (the whole-process duration — the baseline comparison's
      # timing axis).
      match compile_file(&opts, file.clone())
      when Result::Ok(_) then
        let exe_path = get_output_path(&opts, file.clone(), "")
        var bench_args: Vec[String] = Vec::new()
        bench_args.push("--run-bench".to_string())
        bench_args.push(bench.name.clone())
        let t0 = std::time::Instant::now()
        let exit_code = bootstrap_call_argv(exe_path, bench_args)
        let elapsed = t0.elapsed()
        if exit_code == 0 then
          ok_count = ok_count + 1
          results.push((bench.name.clone(), BenchOutcome::Passed(BenchResult {
            name: bench.name.clone(),
            iterations: 1,
            total_time: elapsed,
            min_ns: 0,
            max_ns: 0,
            mean_ns: elapsed.as_nanos_f() as Float,
          })))
          if !config.json_output then
            println("  bench " + bench.name + " ... ok")
          end
        else
          results.push((bench.name.clone(), BenchOutcome::Failed("exit " + exit_code.to_string())))
          failed = failed + 1
          if !config.json_output then
            println("  bench " + bench.name + " ... FAILED (exit " + exit_code.to_string() + ")")
          end
        end
      when Result::Err(e) then
        results.push((bench.name.clone(), BenchOutcome::Failed("compile error")))
        failed = failed + 1
        if !config.json_output then
          println("  bench " + bench.name + " ... COMPILE ERROR: " + e)
        end
      end
    end
  end

  if config.json_output then
    # STRICT RFC 8259 JSON: no comments, no unescaped strings, no NaN/Inf
    # numbers, and every array element separated by a comma. The whole
    # document is built as ONE string (a `python3 -m json.tool` parse is
    # the contract test's oracle). Numeric timing values are never emitted
    # (a wall-clock Float can be NaN/Inf on an interrupted measurement).
    var json_out = "{\n  \"benchmarks\": ["
    var ri = 0
    while ri < results.len() do
      let r = results[ri]
      if ri > 0 then
        json_out = json_out + ","
      end
      let status = match r.1
      when BenchOutcome::Passed(_) then "\"ok\""
      when BenchOutcome::Failed(msg) then "\"failed\", \"message\": \"" + json_escape(msg) + "\""
      when BenchOutcome::Skipped then "\"skipped\""
      end
      json_out = json_out + "\n    {\"name\": \"" + json_escape(r.0) + "\", \"status\": " + status + "}"
      ri = ri + 1
    end
    json_out = json_out + "\n  ]\n}"
    println(json_out)
  else
    println("")
    println("bench result: " + ok_count.to_string() + "/" + total.to_string() + " ok")
  end

  # The --baseline comparison: the loaded baseline's mean_ns vs the
  # measured wall-clock mean_ns (the regression signal).
  match config.baseline
  when Option::Some(bpath) then
    match load_baseline(bpath.clone())
    when Result::Ok(entries) then
      compare_with_baseline(results, entries)
    when Result::Err(e) then
      eprintln("error: cannot load baseline: " + e)
      failed = failed + 1
    end
  when Option::None then ()
  end

  if failed > 0 then 1 else 0 end
end

def find_bench_files(dir: String) -> Vec[String]
  var files = Vec::new()
  let entries = match std::fs::read_dir(dir)
  when Result::Ok(entries) then entries
  when Result::Err(_) then return files
  end
  
  for entry in entries do
    if entry.is_dir && !entry.name.starts_with(".") then
      let sub = find_bench_files(entry.path.clone())
      for f in sub do files.push(f) end
    elsif entry.name.ends_with("_bench.tg") || entry.name.starts_with("bench_") then
      files.push(entry.path.clone())
    elsif entry.name.ends_with(".tg") then
      match read_file(entry.path.clone())
      when Result::Ok(content) then
        if is_bench_source(content) then
          files.push(entry.path.clone())
        end
      when Result::Err(_) then ()
      end
    end
  end
  
  files
end

def extract_bench_functions(ast: Program, file: String) -> Vec[BenchCase]
  var cases: Vec[BenchCase] = Vec::new()
  for item in ast.items do
    var is_bench = false
    for attr in item.attrs do
      if attr.name == "bench" then
        is_bench = true
      end
    end
    if is_bench then
      match item.kind
      when ItemKind::ItemFunction(func_decl) then
        cases.push(BenchCase {
          name: func_decl.name.clone(),
          func: || (),
          setup: Option::None,
          teardown: Option::None,
          iterations: Option::None,
          warmup_iterations: 3,
          input_size: Option::None
        })
      when _ then ()
      end
    end
  end
  cases
end

# 
# Subcommand: repl
# 

# The bounded REPL (the reviewer's preferred shape): every input entry is
# COMPILED AND RUN through the driver's existing machinery (parse ->
# type-check -> resource check -> MIR -> codegen -> link -> execute) as its
# own process — the language's real evaluation path. State is the session's
# input buffer: a multi-line entry accumulates until its block structure is
# complete (the parser's trailing `expected 'end'` diagnostic at EOF), then
# evaluates as one unit. A runtime failure in one entry never corrupts the
# subsequent state: each evaluation is a fresh process and the buffer is
# cleared after every completed entry. Expression entries are wrapped as the
# body of `def main() -> Int` and their result is the exit code, printed as
# `=> <code>`; statement/program entries run and print their own output.

def repl_help_text() -> String
  ":help          - Show this help\n:quit, :q      - Exit the REPL\n:clear         - Discard the current multi-line buffer"
end

# A buffer is COMPLETE when the parser accepts it, or when its failure is a
# trailing `expected 'end'` at EOF (an unterminated block — keep reading
# continuation lines). Any other parse failure is the entry being complete
# (the diagnostics are reported when the entry evaluates).
def repl_buffer_complete(buffer: String) -> Bool
  let lex_result = tokenize(buffer.clone(), "<repl>")
  let parse_out = parse(lex_result)
  if !diag_has_errors(&parse_out.diagnostics) then
    return true
  end
  let diags = parse_out.diagnostics
  let last = diags[diags.len() - 1]
  if last.message == "expected 'end'" then
    match last.span
    when Option::Some(sp) then
      if sp.start + 2 >= buffer.len() then
        return false
      end
    when Option::None then ()
    end
  end
  true
end

# An entry that already starts with a top-level item is a complete program
# (it must define `main` to run — a missing main is reported as the entry's
# compile error). Anything else is wrapped as the body of `def main() -> Int`.
def repl_is_full_program(s: String) -> Bool
  s.starts_with("def ") || s.starts_with("pub ") || s.starts_with("struct ") ||
  s.starts_with("enum ") || s.starts_with("trait ") || s.starts_with("impl ") ||
  s.starts_with("module ") || s.starts_with("use ") || s.starts_with("extern") ||
  s.starts_with("edition ") || s.starts_with("@") || s.starts_with("rationale") ||
  s.starts_with("capability ") || s.starts_with("effect ") || s.starts_with("type ") ||
  s.starts_with("const ") || s.starts_with("static ")
end

def repl_last_line(s: String) -> String
  match s.rfind("\n")
  when Option::Some(pos) then s.slice(pos + 1, s.len())
  when Option::None then s
  end  end
end

# A trailing line that begins with a statement form (a `let` binding, a
# control-flow statement, a print call, ...) has no expression result —
# evaluate it as a Unit main. A trailing expression is the entry's result
# (wrapped as `def main() -> Int`, the exit code printed as `=> <code>`).
def repl_statement_start(s: String) -> Bool
  let t = s.trim()
  t.starts_with("let ") || t.starts_with("var ") || t.starts_with("while ") ||
  t.starts_with("for ") || t.starts_with("if ") || t.starts_with("match ") ||
  t.starts_with("loop") || t.starts_with("return") || t.starts_with("next") ||
  t.starts_with("break") || t.starts_with("unsafe") || t.starts_with("defer") ||
  t.starts_with("guard ") || t.starts_with("try") || t.starts_with("with ") ||
  t.starts_with("handle ") || t.starts_with("use ") || t.starts_with("println(") ||
  t.starts_with("print(") || t.starts_with("eprintln(") || t.starts_with("eprint(")
end

def repl_wrap_entry(entry: String) -> String
  if repl_is_full_program(entry) then
    entry
  elsif repl_statement_start(repl_last_line(entry)) then
    "def main()\n" + entry + "\nend\n"
  else
    "def main() -> Int\n" + entry + "\nend\n"
  end
end

# Compile + run ONE entry through the driver's machinery. Returns the text
# to print (the `=> <code>` result for expression entries, the compile
# diagnostics on failure, "" when the entry produced no result line).
def repl_eval_source(entry: String, entry_no: Int) -> String
  let trimmed = entry.trim()
  if trimmed.is_empty() then
    return ""
  end
  let wrapped = repl_wrap_entry(trimmed)
  let repl_dir = "build/.tg_repl"
  let path = repl_dir + "/entry_" + entry_no.to_string() + ".tg"
  match write_file(path.clone(), wrapped)
  when Result::Err(e) then
    return "error: cannot write REPL entry: " + e
  when Result::Ok(_) then ()
  end
  var opts = default_options()
  match compile_file(&opts, path.clone())
  when Result::Err(e) then
    e
  when Result::Ok(_) then
    let exe_path = get_output_path(&opts, path, "")
    let code = execute_binary(exe_path)
    if repl_is_full_program(trimmed) then
      ""
    elsif repl_statement_start(repl_last_line(trimmed)) then
      ""
    else
      "=> " + code.to_string()
    end
  end
end

def cmd_repl(argv: Vec[String]) -> Int
  let repl_dir = "build/.tg_repl"
  match mkdir_p(repl_dir.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then
    println("error: cannot create REPL work directory '" + repl_dir + "': " + e)
    return 1
  end
  println("Tangerine REPL v" + VERSION)
  println("Type :help for help, :quit to exit")
  println("")
  var buffer = ""
  var entry_no = 0
  var running = true
  while running do
    print(if buffer.is_empty() then "tg> " else "...> " end)
    let line = read_line_impl()
    if line.is_empty() then
      # EOF: flush the pending multi-line entry (a piped session evaluates
      # its final incomplete entry), then exit.
      if !buffer.is_empty() then
        let result = repl_eval_source(buffer.clone(), entry_no)
        entry_no = entry_no + 1
        buffer = ""
        if !result.is_empty() then
          println(result)
        end
      end
      break
    end
    if buffer.is_empty() then
      if line == ":quit" || line == ":q" then
        running = false
        next
      elsif line == ":help" then
        println(repl_help_text())
        next
      elsif line == ":clear" then
        buffer = ""
        println("REPL state cleared.")
        next
      elsif line.starts_with(":") then
        println("Unknown command: " + line)
        println("Type :help for available commands.")
        next
      end
    end
    # Multi-line accumulation: an entry is complete when its block
    # structure balances; the buffer is cleared after every completed
    # entry, so a failed evaluation never leaks into the next entry.
    buffer = buffer + line + "\n"
    if repl_buffer_complete(buffer.clone()) then
      let result = repl_eval_source(buffer.clone(), entry_no)
      entry_no = entry_no + 1
      buffer = ""
      if !result.is_empty() then
        println(result)
      end
    end
  end
  println("Goodbye!")
  0
end

# 
# Subcommand: lsp
# 

def cmd_lsp(argv: Vec[String]) -> Int
  # The banner goes to STDERR: the LSP 3.17 stdio transport is pure
  # JSON-RPC on stdout — a stray line would corrupt the client's framed
  # stream.
  eprintln("Starting Tangerine Language Server...")
  var server = lsp_server_new()
  lsp_main_loop(&mut server)
  0
end

# 
# Subcommand: init
# 

def cmd_init(argv: Vec[String]) -> Int
  let project_name = if argv.len() > 1 then
    argv[1].clone()
  else
    "my_project".to_string()
  end
  
  # Create project directory structure
  match std::fs::create_dir(project_name.clone())
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  match std::fs::create_dir(project_name.clone() + "/src")
  when Result::Err(_) then ()
  when Result::Ok(_) then ()
  end
  
  # Write Tangerine.toml
  let manifest = "[package]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
  match write_file(project_name.clone() + "/Tangerine.toml", manifest)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  # Write src/main.tg
  let main_content = "# " + project_name + "\n\ndef main() -> Int\n  println(\"Hello from " + project_name + "!\")\n  0\nend\n"
  match write_file(project_name.clone() + "/src/main.tg", main_content)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  println("Created project '" + project_name + "'")
  println("  " + project_name + "/Tangerine.toml")
  println("  " + project_name + "/src/main.tg")
  0  end
end

# 
# Subcommand: compile (raw, no subcommand)
# 

# ———————————————————————————————————————————————————————————————
# THE WASM DRIVER ROUTE — --target wasm32-unknown-unknown
# ———————————————————————————————————————————————————————————————
# The driver's wasm dispatch: a --target wasm32-unknown-unknown (or
# wasm32-wasi) compile routes to the WASM BACKEND (wasm_target.tg's
# WasmCompiler) instead of the native object/executable emission. The
# route runs the SAME front-end pipeline (parse → merge deps → analyze →
# MIR → verify → monomorphize → optimize → verify) and then the wasm
# backend — the type/layout mapping (i32/i64/f32/f64/externref), the
# section emission (type/import/function/memory/global/export/start/
# code/data + the producer custom section), the binary encode — writing a
# .wasm module. The native route (compile_file_core) never sees the wasm
# target: the dispatch below intercepts it at the driver boundary.

def is_wasm_target(opts: CompilerOptions) -> Bool
  match opts.target_triple
  when Option::Some(t) then
    t == "wasm32-unknown-unknown" || t == "wasm32-wasi"
  when Option::None then false
  end  end
end

# The wasm backend config for the requested triple: wasm32-unknown-unknown
# is the freestanding target (no WASI imports); wasm32-wasi adds the WASI
# snapshot_preview1 imports.
def wasm_config_for_triple(opts: CompilerOptions) -> WasmCompileConfig
  let mut cfg = WasmCompileConfig::default()
  match opts.target_triple
  when Option::Some(t) then
    if t == "wasm32-wasi" then
      cfg.target = WasmTarget::Wasm32Wasi
    else
      cfg.target = WasmTarget::Wasm32Unknown
    end
  when Option::None then
    cfg.target = WasmTarget::Wasm32Unknown
  end
  cfg
end

def compile_to_wasm_route(opts: CompilerOptions, files: Vec[String], output_path: String) -> Result[Unit, String]
  if files.len() == 0 then
    return Result::Err("no input files for the wasm compile")
  end
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  var file_i = 0
  while file_i < files.len() do
    let file = files[file_i].clone()
    let out_path = if output_path.len() > 0 then
      output_path.clone()
    else
      get_output_path(&opts, file.clone(), ".wasm")
    end
    let source = match read_file(file.clone())
    when Result::Ok(s) then s
    when Result::Err(e) then return Result::Err("failed to read " + file.clone() + ": " + e)
    end
    var ast = match parse_source_program(source, file.clone())
    when Result::Ok(p) then p
    when Result::Err(diags) then
      for d in diags do
        emit_diagnostic(&mut emitter, d)
      end
      return Result::Err(join_diagnostics(&diags))
    end
    ast = match merge_imported_deps(ast, false)
    when Result::Ok(a) then a
    when Result::Err(e) then return Result::Err(e)
    end
    var env = type_env_new()
    let typed = match analyze_program(&mut env, &mut ast, opts.clone())
    when Result::Ok(tp) then tp
    when Result::Err(diags) then
      for d in diags do
        emit_diagnostic(&mut emitter, d)
      end
      return Result::Err(join_diagnostics(&diags))
    end
    var mir = match driver_lower_to_mir(&ast, Option::Some(typed.clone()))
    when Result::Ok(m) then m
    when Result::Err(e) then return Result::Err("MIR lowering failed: " + e)
    end
    let pre_mono_errs = verify_mir(&mir)
    if !pre_mono_errs.is_empty() then
      return Result::Err("MIR verification failed before monomorphization (" + pre_mono_errs.len().to_string() + " error(s))")
    end
    var mono_cache = mono_cache_new(&ast, &typed.resolutions)
    match monomorphize_program(&mut mir, &mut mono_cache)
    when Result::Ok(_) then ()
    when Result::Err(me) then
      return Result::Err("monomorphization failed with " + me.len().to_string() + " error(s)")
    end
    optimize_mir(&mut mir, opts.opt_level)
    let post_errs = verify_mir(&mir)
    if !post_errs.is_empty() then
      return Result::Err("MIR verification failed after optimization (" + post_errs.len().to_string() + " error(s))")
    end
    let cfg = wasm_config_for_triple(&opts)
    let bytes = match WasmCompiler::new(cfg).compile(&mir)
    when Result::Ok(b) then b
    when Result::Err(e) then return Result::Err("wasm compilation failed: " + e.to_string())
    end
    match write_file_bytes(out_path.clone(), &bytes)
    when Result::Ok(_) then ()
    when Result::Err(e) then return Result::Err("failed to write " + out_path.clone() + ": " + e)
    end
    if !opts.quiet then
      println("Wasm module: " + out_path)
    end
    file_i = file_i + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# THE NO-STD ROUTE — the core-only compile contract
# ———————————————————————————————————————————————————————————————
# A no_std compile (the `--no-std` flag or the `@no_std` module attribute)
# applies the no_std CONTRACT on top of the standard pipeline:
#   1. the CORE-ONLY SURFACE — the program's own imports may only resolve
#      within the no_std allowlist (std::core / std::ffi / std::embedded /
#      std::atomic). The collection/string/alloc modules and the OS
#      runtime modules (io/fs/process/env/net/...) are excluded from the
#      program's import surface — an import of any of them fails the
#      compile with the no_std diagnostic;
#   2. the BARE ENTRY — the program must define `def _start() -> !` and
#      must NOT define `main`: the binary's entry is the program's own
#      _start (the linker's bare-entry fallback), there is no libc/CRT
#      main wrapper, and the direct syscall surface (std::core's
#      __intrinsic_syscall1..6 + the runtime's _exit) is the only
#      OS-facing interface;
#   3. the LINK CONTRACT — the internal linker resolves the entry through
#      the default -> _start fallback chain and the produced image is
#      fully self-contained (no libc dependency by construction).

def join_vec_str(v: Vec[String], sep: String) -> String
  var out = "".to_string()
  var i = 0
  while i < v.len() do
    if i > 0 then
      out = out + sep
    end
    out = out + v[i].clone()
    i = i + 1
  end
  out
end

def root_item_has_attr(item: Item, name: String) -> Bool
  for attr in item.attrs do
    if attr.name == name then
      return true
    end
  end
  false
end

def root_program_has_attr(program: Program, name: String) -> Bool
  for item in program.items do
    if root_item_has_attr(item, name) then
      return true
    end
  end
  false
end

def root_program_has_fn(program: Program, name: String) -> Bool
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if f.name == name then
        return true
      end
    when _ then ()
    end
  end
  false
end

def root_program_fn_names(program: Program) -> Vec[String]
  var names = Vec::new()
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      names.push(f.name.clone())
    when _ then ()
    end
  end
  names
end

# The no_std core-only allowlist for a use path's module segment: std paths
# must resolve within {core, ffi, embedded, atomic}; non-std paths (user
# modules) are permitted.
def nostd_use_allowed(segments: Vec[String]) -> Bool
  if segments.len() < 2 then
    return false
  end
  if segments[0] != "std" then
    return true
  end
  let mod2 = segments[1].clone()
  mod2 == "core" || mod2 == "ffi" || mod2 == "embedded" || mod2 == "atomic"
end

def nostd_surface_error(program: Program) -> Option[String]
  for item in program.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      if !nostd_use_allowed(&u.path.segments) then
        let path_str = join_vec_str(&u.path.segments, "::")
        return Option::Some("no_std: the import `use " + path_str + "` is outside the core-only surface (allowed: std::core / std::ffi / std::embedded / std::atomic; the collection/string/alloc and the OS runtime modules are excluded from the no_std import surface)")
      end
    when _ then ()
    end
  end
  Option::None
end

def start_entry_error(program: Program) -> Option[String]
  let has_start = root_program_has_fn(program, "_start")
  let has_main = root_program_has_fn(program, "main")
  if !has_start then
    return Option::Some("no_std: the program must define the bare entry `def _start() -> !` (the no_std link contract: the _start entry, no libc main wrapper)")
  end
  if has_main then
    return Option::Some("no_std: the program must NOT define `main` (the no_std entry is the program's own `_start`; a `main` would select the libc/CRT entry)")
  end
  Option::None
end

def nostd_mode_requested(argv: Vec[String], files: Vec[String]) -> Bool
  for arg in argv do
    if arg == "--no-std" then
      return true
    end
  end
  if files.len() > 0 then
    match read_file(files[0].clone())
    when Result::Ok(src) then
      return src.contains("@no_std")
    when Result::Err(_) then return false
    end
  end
  false
end

def compile_to_nostd_route(opts: CompilerOptions, files: Vec[String], output_path: String, no_std_flag: Bool) -> Result[Unit, String]
  if files.len() == 0 then
    return Result::Err("no input files for the no_std compile")
  end
  let source = match read_file(files[0].clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return Result::Err("failed to read " + files[0].clone() + ": " + e)
  end
  let ast = match parse_source_program(source, files[0].clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then
    return Result::Err(join_diagnostics(&diags))
  end
  let attr_mode = root_program_has_attr(&ast, "no_std")
  if !attr_mode && !no_std_flag then
    return Result::Err("no_std: the program carries no @no_std attribute and --no-std was not passed (a no_std compile requires one of the two)")
  end
  match nostd_surface_error(&ast)
  when Option::Some(err) then return Result::Err(err)
  when Option::None then ()
  end
  match start_entry_error(&ast)
  when Option::Some(err) then return Result::Err(err)
  when Option::None then ()
  end
  let rc = compile_startup_entry(&opts, files[0].clone(), output_path)
  if rc == 0 then
    Result::Ok(())
  else
    Result::Err("no_std compilation failed (exit code " + rc.to_string() + ")")
  end
end

# ———————————————————————————————————————————————————————————————
# THE EMBEDDED ROUTE — the bare-metal target contract
# ———————————————————————————————————————————————————————————————
# A --target <embedded triple> compile applies the EMBEDDED CONTRACT:
#   1. the TARGET SPEC — the per-triple record (arch/cpu/fpu/endianness/
#      pointer width/atomicity availability/linker), emitted as the
#      machine-readable target JSON artifact;
#   2. the LINKER SCRIPT — the flash/RAM MEMORY layout + the section
#      placement (.isr_vector/.text/.rodata/.data/.bss + the __data_load
#      copy table + the stack top), emitted as the .ld artifact;
#   3. the STARTUP — the reset handler contract (the .bss zeroing + the
#      .data copy + the user main call — std::embedded's
#      `_reset_handler`) and the interrupt vector table (every @interrupt
#      function in the program, in declaration order), emitted as the
#      startup artifact;
#   4. the VOLATILE/MMIO + INTERRUPT surfaces — std::embedded's volatile
#      intrinsics (the runtime's _tg_volatile_read*/_write* load/store
#      arms) and the @interrupt attribute (signature-validated, collected
#      into the vector table);
#   5. the PANIC/ABORT contract — the abort-only panic strategy (the only
#      stable strategy) recorded in the spec artifact;
#   6. the BARE-METAL BINARY — the program compiles through the same
#      front-end pipeline and links to the bare ELF image whose entry is
#      `_reset_handler` (the linker's bare-entry fallback); the artifact
#      is structurally verified (ELF magic + non-zero entry).
# The allocator-free core: the same core-only surface check as no_std
# (the program's imports are restricted to the no_std allowlist).
#
# THE ISA CODE-GEN TRUTH (P0.2): the ONLY embedded triple with REAL code
# generation is aarch64-unknown-none — its machine code is produced by
# the aarch64 backend (the same backend the host bootstrap uses). The
# Thumb (thumbv6m / thumbv7em / thumbv8m.main) and RISC-V (riscv32imc /
# riscv32imac / riscv64gc) triples have NO code generator in this
# compiler. The route's old behavior FORCED the aarch64 backend for every
# triple and claimed the result as the requested ISA's image — a
# fabricated artifact. The honest contract is the HARD REJECTION: the
# stable diagnostic, NO artifact directory, NO compile invocation, NO
# "compiles" claim. There is also NO QEMU execution lane — the old lane
# only PRINTED that it ran without invoking QEMU; hardware execution is
# not claimed until a real invocation exists.

struct EmbeddedTargetSpec
  target: String
  arch: String
  cpu: String
  fpu: Bool
  endianness: String
  pointer_width: Int
  max_atomic_width: Int
  family: String
  default_linker: String
  linker_script: String
  description: String
end

def embedded_target_specs() -> Vec[EmbeddedTargetSpec]
  var specs = Vec::new()
  specs.push(EmbeddedTargetSpec {
    target: "thumbv6m-none-eabi",
    arch: "thumbv6m", cpu: "cortex-m0",
    fpu: false, endianness: "little", pointer_width: 32, max_atomic_width: 0,
    family: "arm", default_linker: "arm-none-eabi-ld", linker_script: "cortex-m",
    description: "ARM Cortex-M0/M0+ (ARMv6-M, Thumb only, no atomic support)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "thumbv7em-none-eabi",
    arch: "thumbv7em", cpu: "cortex-m4",
    fpu: false, endianness: "little", pointer_width: 32, max_atomic_width: 32,
    family: "arm", default_linker: "arm-none-eabi-ld", linker_script: "cortex-m",
    description: "ARM Cortex-M4 (ARMv7E-M, Thumb-2, 32-bit atomics)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "thumbv7em-none-eabihf",
    arch: "thumbv7em", cpu: "cortex-m4f",
    fpu: true, endianness: "little", pointer_width: 32, max_atomic_width: 32,
    family: "arm", default_linker: "arm-none-eabi-ld", linker_script: "cortex-m",
    description: "ARM Cortex-M4F (ARMv7E-M, Thumb-2 + DSP + single-precision FPU)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "thumbv8m.main-none-eabihf",
    arch: "thumbv8m.main", cpu: "cortex-m33",
    fpu: true, endianness: "little", pointer_width: 32, max_atomic_width: 32,
    family: "arm", default_linker: "arm-none-eabi-ld", linker_script: "cortex-m",
    description: "ARM Cortex-M33 (ARMv8-M Mainline, TrustZone)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "riscv32imc-unknown-none-elf",
    arch: "riscv32imc", cpu: "generic-rv32",
    fpu: false, endianness: "little", pointer_width: 32, max_atomic_width: 0,
    family: "riscv", default_linker: "riscv32-unknown-elf-ld", linker_script: "riscv",
    description: "RISC-V RV32IMC (integer + multiply + compressed, no atomics)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "riscv32imac-unknown-none-elf",
    arch: "riscv32imac", cpu: "generic-rv32",
    fpu: false, endianness: "little", pointer_width: 32, max_atomic_width: 32,
    family: "riscv", default_linker: "riscv32-unknown-elf-ld", linker_script: "riscv",
    description: "RISC-V RV32IMAC (integer + multiply + atomics + compressed)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "riscv64gc-unknown-none-elf",
    arch: "riscv64gc", cpu: "generic-rv64",
    fpu: true, endianness: "little", pointer_width: 64, max_atomic_width: 64,
    family: "riscv", default_linker: "riscv64-unknown-elf-ld", linker_script: "riscv",
    description: "RISC-V RV64GC (general-purpose 64-bit)"
  })
  specs.push(EmbeddedTargetSpec {
    target: "aarch64-unknown-none",
    arch: "aarch64", cpu: "generic-a64",
    fpu: true, endianness: "little", pointer_width: 64, max_atomic_width: 64,
    family: "aarch64", default_linker: "aarch64-none-elf-ld", linker_script: "aarch64",
    description: "AArch64 bare-metal (ARM64, the FP/NEON baseline) — the ONLY embedded triple with real code generation (the aarch64 backend)"
  })
  specs
end

def embedded_spec_for(triple: String) -> Option[EmbeddedTargetSpec]
  for spec in embedded_target_specs() do
    if spec.target == triple then
      return Option::Some(spec)
    end
  end
  Option::None
end

def is_embedded_target(triple: String) -> Bool
  match embedded_spec_for(triple)
  when Option::Some(_) then true
  when Option::None then false
  end  end
end

def embedded_cortex_m_linker_script(spec: EmbeddedTargetSpec) -> String
  "/* " + spec.target + " linker script (generated by the embedded route) */\n" +
  "MEMORY\n" +
  "{\n" +
  "  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 256K\n" +
  "  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 64K\n" +
  "}\n" +
  "\n" +
  "SECTIONS\n" +
  "{\n" +
  "  .isr_vector: { KEEP(*(.isr_vector)) } > FLASH\n" +
  "  .text      : { *(.text.reset) *(.text .text.*) } > FLASH\n" +
  "  .rodata    : { *(.rodata .rodata.*) } > FLASH\n" +
  "  .data      : {\n" +
  "    __data_start = .;\n" +
  "    *(.data .data.*)\n" +
  "    __data_end = .;\n" +
  "  } > RAM AT > FLASH\n" +
  "  __data_load = LOADADDR(.data);\n" +
  "  .bss (NOLOAD) : {\n" +
  "    __bss_start = .;\n" +
  "    *(.bss .bss.*)\n" +
  "    __bss_end = .;\n" +
  "  } > RAM\n" +
  "  _stack_top = ORIGIN(RAM) + LENGTH(RAM);\n" +
  "}\n"
end

def embedded_riscv_linker_script(spec: EmbeddedTargetSpec) -> String
  "/* " + spec.target + " linker script (generated by the embedded route) */\n" +
  "MEMORY\n" +
  "{\n" +
  "  FLASH (rx)  : ORIGIN = 0x20000000, LENGTH = 512K\n" +
  "  RAM   (rwx) : ORIGIN = 0x80000000, LENGTH = 64K\n" +
  "}\n" +
  "\n" +
  "SECTIONS\n" +
  "{\n" +
  "  .text      : { *(.text.reset) *(.text .text.*) } > FLASH\n" +
  "  .rodata    : { *(.rodata .rodata.*) } > FLASH\n" +
  "  .data      : {\n" +
  "    __data_start = .;\n" +
  "    *(.data .data.*)\n" +
  "    __data_end = .;\n" +
  "  } > RAM AT > FLASH\n" +
  "  __data_load = LOADADDR(.data);\n" +
  "  .bss (NOLOAD) : {\n" +
  "    __bss_start = .;\n" +
  "    *(.bss .bss.*)\n" +
  "    __bss_end = .;\n" +
  "  } > RAM\n" +
  "  _stack_top = ORIGIN(RAM) + LENGTH(RAM);\n" +
  "}\n"
end

def embedded_aarch64_linker_script(spec: EmbeddedTargetSpec) -> String
  "/* " + spec.target + " linker script (generated by the embedded route) */\n" +
  "MEMORY\n" +
  "{\n" +
  "  FLASH (rx)  : ORIGIN = 0x00000000, LENGTH = 512K\n" +
  "  RAM   (rwx) : ORIGIN = 0x40000000, LENGTH = 64K\n" +
  "}\n" +
  "\n" +
  "SECTIONS\n" +
  "{\n" +
  "  .isr_vector: { KEEP(*(.isr_vector)) } > FLASH\n" +
  "  .text      : { *(.text.reset) *(.text .text.*) } > FLASH\n" +
  "  .rodata    : { *(.rodata .rodata.*) } > FLASH\n" +
  "  .data      : {\n" +
  "    __data_start = .;\n" +
  "    *(.data .data.*)\n" +
  "    __data_end = .;\n" +
  "  } > RAM AT > FLASH\n" +
  "  __data_load = LOADADDR(.data);\n" +
  "  .bss (NOLOAD) : {\n" +
  "    __bss_start = .;\n" +
  "    *(.bss .bss.*)\n" +
  "    __bss_end = .;\n" +
  "  } > RAM\n" +
  "  _stack_top = ORIGIN(RAM) + LENGTH(RAM);\n" +
  "}\n"
end

def embedded_spec_json(spec: EmbeddedTargetSpec, entry: String, interrupts: Vec[String], sections: Vec[String]) -> String
  var out = "{\n"
  out = out + "  \"target\": \"" + spec.target + "\",\n"
  out = out + "  \"arch\": \"" + spec.arch + "\",\n"
  out = out + "  \"cpu\": \"" + spec.cpu + "\",\n"
  out = out + "  \"fpu\": " + if spec.fpu then "true" else "false" end + ",\n"
  out = out + "  \"endianness\": \"" + spec.endianness + "\",\n"
  out = out + "  \"pointer_width\": " + spec.pointer_width.to_string() + ",\n"
  out = out + "  \"max_atomic_width\": " + spec.max_atomic_width.to_string() + ",\n"
  out = out + "  \"family\": \"" + spec.family + "\",\n"
  out = out + "  \"default_linker\": \"" + spec.default_linker + "\",\n"
  out = out + "  \"panic_strategy\": \"abort\",\n"
  out = out + "  \"entry\": \"" + entry + "\",\n"
  out = out + "  \"link_sections\": [\"" + join_vec_str(&sections, "\", \"") + "\"],\n"
  out = out + "  \"interrupts\": [\"" + join_vec_str(&interrupts, "\", \"") + "\"]\n"
  out = out + "}\n"
  out
end

def embedded_startup_source(spec: EmbeddedTargetSpec, entry: String, interrupts: Vec[String]) -> String
  var out = "## " + spec.target + " startup (generated by the embedded route)\n"
  out = out + "## The reset vector: " + entry + "\n"
  out = out + "## The interrupt vector table (the @interrupt functions, in declaration order):\n"
  for name in interrupts do
    out = out + "##   - " + name + "\n"
  end
  out = out + "\n"
  out = out + "## The vector table lives in the .isr_vector section (the linker script's\n"
  out = out + "## KEEP(*(.isr_vector)) placement — the section placement contract).\n"
  out
end

def collect_interrupt_fns(program: Program, inout errors: Vec[String]) -> Vec[String]
  var fns = Vec::new()
  for item in program.items do
    if root_item_has_attr(item, "interrupt") then
      match item.kind
      when ItemKind::ItemFunction(f) then
        if f.params.len() != 0 then
          errors.push("embedded: the @interrupt function `" + f.name + "` must take no parameters (an ISR has no arguments)")
        end
        fns.push(f.name.clone())
      when _ then
        errors.push("embedded: the @interrupt attribute is only valid on a function declaration")
      end
    end
  end
  fns
end

def collect_link_sections(program: Program) -> Vec[String]
  var sections = Vec::new()
  for item in program.items do
    for attr in item.attrs do
      if attr.name == "link_section" && attr.args.len() > 0 then
        sections.push(attr.args[0].clone())
      end
    end
  end
  sections
end

def embedded_elf_entry_ok(path: String) -> Result[Unit, String]
  match read_to_vec(path.clone())
  when Result::Ok(bytes) then
    if bytes.len() < 0x20 then
      return Result::Err("embedded: the produced ELF is truncated (" + bytes.len().to_string() + " bytes)")
    end
    if bytes[0] != 0x7F || bytes[1] != 0x45 || bytes[2] != 0x4C || bytes[3] != 0x46 then
      return Result::Err("embedded: the produced image has no ELF magic")
    end
    var entry: u64 = 0
    var bi = 0x18
    var shift: UInt = 0
    while bi < 0x20 do
      entry = entry | ((bytes[bi] as u64) << shift)
      shift = shift + 8
      bi = bi + 1
    end
    if entry == 0 then
      return Result::Err("embedded: the produced ELF has a zero entry point")
    end
    Result::Ok(())
  when Result::Err(e) then
    Result::Err("embedded: cannot read the produced image: " + e)
  end  end
end

def compile_to_embedded_route(opts: CompilerOptions, files: Vec[String], output_path: String) -> Result[Unit, String]
  if files.len() == 0 then
    return Result::Err("no input files for the embedded compile")
  end
  let triple = match opts.target_triple
  when Option::Some(t) then t.clone()
  when Option::None then return Result::Err("embedded: no target triple (use --target <embedded-triple>)")
  end
  let spec = match embedded_spec_for(triple.clone())
  when Option::Some(s) then s
  when Option::None then return Result::Err("embedded: unknown embedded target triple: " + triple)
  end
  # THE ISA CODE-GEN GATE (the P0.2 fix): the only embedded triple with
  # a real code generator is aarch64-unknown-none (family "aarch64" — the
  # aarch64 backend). Every Thumb (thumbv6m/thumbv7em/thumbv8m.main) and
  # RISC-V (riscv32imc/riscv32imac/riscv64gc) triple is HARD-REJECTED
  # HERE: the stable diagnostic below, and NOTHING else — no artifact
  # directory, no linker script, no startup, no compile invocation, no
  # "compiles" claim. The old route forced the aarch64 backend under the
  # foreign triple and fabricated the image; that override is now
  # unreachable for every rejected ISA.
  if spec.family != "aarch64" then
    return Result::Err("embedded: the target triple `" + triple + "` is REJECTED — the " + spec.arch + " (" + spec.family + ") code generator does not exist (the bare-metal codegen is aarch64 only; this route will not fabricate a " + spec.arch + " image). Use --target aarch64-unknown-none (the real bare-metal target)")
  end
  let source = match read_file(files[0].clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return Result::Err("failed to read " + files[0].clone() + ": " + e)
  end
  let ast = match parse_source_program(source, files[0].clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then
    return Result::Err(join_diagnostics(&diags))
  end
  match nostd_surface_error(&ast)
  when Option::Some(err) then return Result::Err(err)
  when Option::None then ()
  end
  let has_reset_handler = root_program_has_fn(&ast, "_reset_handler")
  let imports_embedded = root_program_imports_module(&ast, "embedded")
  if !has_reset_handler && !imports_embedded then
    return Result::Err("embedded: the program must define `_reset_handler` or import std::embedded (the reset/startup contract — the reset vector zeroes .bss, copies .data and calls the user main)")
  end
  var interrupt_errors: Vec[String] = Vec::new()
  let interrupts = collect_interrupt_fns(&ast, &mut interrupt_errors)
  if interrupt_errors.len() > 0 then
    return Result::Err(join_vec_str(&interrupt_errors, "\n"))
  end
  let sections = collect_link_sections(&ast)
  let entry = if has_reset_handler then "_reset_handler" else "main" end
  let art_dir = output_path + ".d"
  match mkdir_p(art_dir.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("embedded: cannot create the artifact directory: " + e)
  end
  match write_file(art_dir.clone() + "/" + triple + ".json", embedded_spec_json(&spec, entry, &interrupts, &sections))
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("embedded: cannot write the target spec artifact: " + e)
  end
  let ld_text = if spec.linker_script == "cortex-m" then
    embedded_cortex_m_linker_script(&spec)
  elsif spec.linker_script == "aarch64" then
    embedded_aarch64_linker_script(&spec)
  else
    embedded_riscv_linker_script(&spec)
  end
  match write_file(art_dir.clone() + "/" + triple + ".ld", ld_text)
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("embedded: cannot write the linker script artifact: " + e)
  end
  match write_file(art_dir.clone() + "/startup.tg", embedded_startup_source(&spec, entry, &interrupts))
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("embedded: cannot write the startup artifact: " + e)
  end
  let elf_path = output_path + ".elf"
  # THE CODECEN TRIPLE: the aarch64-unknown-none request compiles through
  # the aarch64 backend — the ONLY bare-metal code generator. The codegen
  # triple parser (asm.tg parse_target_triple) requires an OS part, so
  # the codegen sees the aarch64 Linux triple while the requested target
  # is the same arch (aarch64); the produced machine code is aarch64, the
  # arch the requested bare-metal target names. The family gate above
  # makes this line UNREACHABLE for every rejected ISA — there is no
  # target-triple override for the Thumb/RISC-V triples.
  let mut elf_opts = opts
  elf_opts.target_triple = Option::Some("aarch64-unknown-linux-gnu".to_string())
  let rc = compile_startup_entry(&elf_opts, files[0].clone(), elf_path.clone())
  if rc != 0 then
    return Result::Err("embedded: the bare-metal compilation failed (exit code " + rc.to_string() + ")")
  end
  match embedded_elf_entry_ok(elf_path.clone())
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err(e)
  end
  if !opts.quiet then
    println("Embedded bare-metal image: " + elf_path)
    println("Embedded target spec:      " + art_dir + "/" + triple + ".json")
    println("Embedded linker script:    " + art_dir + "/" + triple + ".ld")
    println("Embedded startup:          " + art_dir + "/startup.tg")
  end
  Result::Ok(())
end

def root_program_imports_module(program: Program, module: String) -> Bool
  for item in program.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      if u.path.segments.len() >= 2 && u.path.segments[0] == "std" && u.path.segments[1] == module then
        return true
      end
    when _ then ()
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# THE LIR ROUTE — audit P1-7 slice (default-off, aarch64 host)
# ———————————————————————————————————————————————————————————————
# TANGERINE_LIR=1 routes native single-file compiles through
# tg_compiler::lir — the standalone register-allocation pipeline
# (MIR -> LIR -> linear scan -> aarch64 emission -> object/link; see
# lir.tg's module doc for the legalization contract). The gate is an
# env-var opt-in, so the working direct emitter is untouched; the LIR
# route FAILS CLOSED on any construct outside the contract (it never
# falls back per function silently). The route mirrors
# compile_to_wasm_route's pipeline shape.

def lir_route_enabled() -> Bool
  match std::env::get_env("TANGERINE_LIR")
  when Option::Some(v) then v == "1"
  when Option::None then false
  end
end

def compile_lir_route(opts: CompilerOptions, files: Vec[String], output_path: String) -> Result[Unit, String]
  if files.len() != 1 then
    return Result::Err("TANGERINE_LIR=1 requires exactly one input file (unset it to use the direct emitter)")
  end
  let file = files[0].clone()
  let out_path = if output_path.len() > 0 then
    output_path.clone()
  else
    match opts.emit
    when EmitMode::Object then get_output_path(&opts, file.clone(), ".o")
    when EmitMode::Executable then get_output_path(&opts, file.clone(), "")
    when _ then "".to_string()
    end
  end
  let source = match read_file(file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err("failed to read " + file.clone() + ": " + e)
  end
  var ast = match parse_source_program(source, file.clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then return Result::Err(join_diagnostics(&diags))
  end
  ast = match merge_imported_deps(ast, false)
  when Result::Ok(a) then a
  when Result::Err(e) then return Result::Err(e)
  end
  var env = type_env_new()
  let typed = match analyze_program(&mut env, &mut ast, opts.clone())
  when Result::Ok(tp) then tp
  when Result::Err(diags) then return Result::Err(join_diagnostics(&diags))
  end
  var mir = match driver_lower_to_mir(&ast, Option::Some(typed.clone()))
  when Result::Ok(m) then m
  when Result::Err(e) then return Result::Err("MIR lowering failed: " + e)
  end
  let pre_errs = verify_mir(&mir)
  if !pre_errs.is_empty() then
    return Result::Err("MIR verification failed before monomorphization (" + pre_errs.len().to_string() + " error(s))")
  end
  var mono_cache = mono_cache_new(&ast, &typed.resolutions)
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Ok(_) then ()
  when Result::Err(me) then return Result::Err("monomorphization failed with " + me.len().to_string() + " error(s)")
  end
  optimize_mir(&mut mir, opts.opt_level)
  let post_errs = verify_mir(&mir)
  if !post_errs.is_empty() then
    return Result::Err("MIR verification failed after optimization (" + post_errs.len().to_string() + " error(s))")
  end
  let target = detect_host_target()
  if target.arch != Arch::AArch64 then
    return Result::Err("the TANGERINE_LIR route emits aarch64 only in this slice; the host is " + host_arch_name(target.arch) + " — unset TANGERINE_LIR to use the direct emitter")
  end
  match opts.target_triple
  when Option::Some(tt) then
    return Result::Err("the TANGERINE_LIR route does not support --target overrides (" + tt + "); unset TANGERINE_LIR to use the direct emitter")
  when Option::None then ()
  end
  match opts.emit
  when EmitMode::Object then
    let bytes = match lir_compile_object(mir, target.clone())
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(b) then b
    end
    match write_file_bytes(out_path.clone(), &bytes)
    when Result::Ok(_) then ()
    when Result::Err(e) then return Result::Err("failed to write " + out_path.clone() + ": " + e)
    end
    Result::Ok(())
  when EmitMode::Executable then
    lir_compile_executable(mir, target.clone(), out_path)
  when _ then
    Result::Err("the TANGERINE_LIR route supports --emit=obj and --emit=exe only (unset TANGERINE_LIR for other emit modes)")
  end
end

def host_arch_name(arch: Arch) -> String
  match arch
  when Arch::AArch64 then "aarch64"
  when Arch::X86_64 then "x86_64"
  when _ then "other"
  end
end

def cmd_compile(argv: Vec[String]) -> Int
  var stage2_probe = false
  var probe_i: UInt = 0
  while probe_i < argv.len() do
    if argv[probe_i].ends_with("tg_stage2") then
      stage2_probe = true
    end
    probe_i = probe_i + 1
  end

  let opts = match parse_startup_compile_args(true)
  when Result::Ok(o) then
    o
  when Result::Err(e) then
    if stage2_probe then
      panic("cmd_compile parse err: " + e)
    end
    if e == "help" || e == "version" then
      return 0
    end
    println(e)
    return 1
  end

 # (target-capability gate): the compile-time rejection site for any
  # operation the target's runtime has no body for. Every map/set operation
  # (destroy / entries / keys / clone / drain / visit) now has x86-64
  # parity, so the gate reports nothing; a future arch-gated stub would be
  # rejected HERE as a capability diagnostic instead of emitting a trap.
  let cap_rejections = check_target_capabilities(&opts)
  if cap_rejections.len() > 0 then
    for rej in cap_rejections do
      eprintln(rej)
    end
    return 1
  end

  let argc = raw_arg_count()
  var files: Vec[String] = Vec::new()
  var arg_i = 2
  while arg_i < argc do
    let arg = raw_arg_copy(arg_i)
    if arg == "-o" || arg == "--output" || arg == "--emit" || arg == "--target" || arg == "--mode" then
      arg_i = arg_i + 2
    elsif arg.starts_with("-") then
      arg_i = arg_i + 1
    else
      files.push(arg)
      arg_i = arg_i + 1
    end
  end

  if files.len() == 0 then
    println("No input files")
    return 1
  end

  var output_path = "".to_string()
  var out_i = 2
  while out_i < argc do
    let arg = raw_arg_copy(out_i)
    if arg == "-o" || arg == "--output" then
      out_i = out_i + 1
      if out_i < argc then
        output_path = raw_arg_copy(out_i)
      end
      break
    end
    out_i = out_i + 1
  end

  if output_path.len() == 0 then
    output_path = match opts.emit
    when EmitMode::Object then get_output_path(&opts, files[0].clone(), ".o")
    when EmitMode::Executable then get_output_path(&opts, files[0].clone(), "")
    when _ then "".to_string()
    end
  end

  # THE WASM ROUTE: a --target wasm32-unknown-unknown / wasm32-wasi
  # compile dispatches to the wasm backend (the driver's target
  # dispatch — the native compile path never sees the wasm target).
  if is_wasm_target(&opts) then
    match compile_to_wasm_route(&opts, files, output_path)
    when Result::Ok(_) then return 0
    when Result::Err(e) then
      eprintln(e)
      return 1
    end
  end

  # THE EMBEDDED ROUTE: a --target <embedded triple>
  # (aarch64-unknown-none — the real bare-metal target) dispatches to the
  # embedded contract — the target spec JSON, the linker script, the
  # startup/vector artifacts and the bare-metal aarch64 ELF image (entry
  # _reset_handler, the core-only surface, abort-only panic). The Thumb
  # (thumbv6m/thumbv7em/thumbv8m.main) and RISC-V (riscv32*/riscv64gc)
  # triples are HARD-REJECTED inside the route (no code generator — no
  # fabricated artifact).
  match opts.target_triple
  when Option::Some(et) then
    if is_embedded_target(et) then
      match compile_to_embedded_route(&opts, files, output_path)
      when Result::Ok(_) then return 0
      when Result::Err(e) then
        eprintln(e)
        return 1
      end
    end
  when Option::None then ()
  end

  # THE NO-STD ROUTE: the --no-std flag or the @no_std attribute dispatches
  # to the no_std contract — the core-only import surface, the _start bare
  # entry and the libc-free link.
  if nostd_mode_requested(&argv, &files) then
    match compile_to_nostd_route(&opts, files, output_path, true)
    when Result::Ok(_) then return 0
    when Result::Err(e) then
      eprintln(e)
      return 1
    end
  end

  # THE LIR ROUTE GATE (audit P1-7 slice; default-off): TANGERINE_LIR=1
  # routes native single-file compiles through the standalone
  # register-allocation pipeline in tg_compiler::lir. Fail-closed: any
  # construct outside the LIR legalization contract fails the compile
  # with a rule-naming error — never a silent per-function fallback.
  if lir_route_enabled() then
    match compile_lir_route(&opts, files, output_path)
    when Result::Ok(_) then return 0
    when Result::Err(e) then
      eprintln(e)
      return 1
    end
  end

  if files.len() == 1 then
    compile_startup_entry(&opts, files[0].clone(), output_path)
  else
    compile_multiple_files(&opts, files, output_path)
  end
end


def cmd_compile_direct(skip_subcommand: Bool) -> Int
  # Bypass Result return — parse args and compile in same function scope
  var opts = default_options()
  var primary_input = "".to_string()
  var input_count = 0
  let argc = raw_arg_count()
  var i = if skip_subcommand then 2 else 1 end

  while i < argc do
    let arg = raw_arg_unchecked(i)

    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argc then
        println("Missing argument for -o")
        return 1
      end
      opts.output_file = Option::Some(raw_arg_unchecked(i))
    elsif arg == "--emit" then
      i = i + 1
    elsif arg == "--verbose" || arg == "-v" then
      opts.verbose = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      # THE -g REJECTION (the reviewer's false-success fix): the
      # debug_info option was INERT — no compile path emits debug info
      # (generate_dwarf_debug_info has no caller), so the flag silently
      # claimed a feature that does not exist. The honest contract is the
      # REJECTION: `-g` fails with the explicit "debug info is not
      # supported" error instead of compiling with a decorative flag.
      println("debug info is not supported: the -g flag is rejected (no compile path emits debug info)")
      return 1
    elsif arg == "--target" then
      i = i + 1
      if i >= argc then
        println("Missing argument for --target")
        return 1
      end
      opts.target_triple = Option::Some(raw_arg_unchecked(i))
    elsif arg == "--no-std" then
      # Accepted in raw compile mode too (see cmd_compile's no_std route).
      ()
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return 0
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return 0
    elsif arg.starts_with("-") then
      println("Unknown option: " + arg)
      return 1
    else
      if input_count == 0 then
        primary_input = arg.clone()
      end
      input_count = input_count + 1
    end

    i = i + 1
  end

  if input_count == 0 then
    println("No input files")
    return 1
  end

  if input_count > 1 then
    println("Multiple input files are not supported in raw compile mode")
    return 1
  end

 # (target-capability gate): same policy as cmd_compile — the
  # compile-time rejection site for arch-gated operations (all map/set
  # operations now have x86-64 parity; the gate reports nothing).
  let cap_rejections_raw = check_target_capabilities(&opts)
  if cap_rejections_raw.len() > 0 then
    for rej in cap_rejections_raw do
      eprintln(rej)
    end
    return 1
  end

  # THE WASM ROUTE: the raw compile mode dispatches the wasm targets to
  # the wasm backend exactly like cmd_compile.
  if is_wasm_target(&opts) then
    var wasm_files = Vec::new()
    wasm_files.push(primary_input.clone())
    match compile_to_wasm_route(&opts, wasm_files, "".to_string())
    when Result::Ok(_) then return 0
    when Result::Err(e) then
      eprintln(e)
      return 1
    end
  end

  let file = primary_input.clone()
  let output_path = match opts.emit
  when EmitMode::Object then get_output_path(&opts, file.clone(), ".o")
  when EmitMode::Executable then get_output_path(&opts, file.clone(), "")
  when _ then "".to_string()
  end

  if output_path.len() > 0 && file_exists(output_path.clone()) then
    let _ = delete_file(output_path.clone())
  end

  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  # THE LIR ROUTE GATE in raw compile mode (audit P1-7 slice; default-
  # off) — same fail-closed semantics as cmd_compile's gate.
  if lir_route_enabled() then
    var lir_files = Vec::new()
    lir_files.push(file.clone())
    match compile_lir_route(&opts, lir_files, output_path)
    when Result::Ok(_) then return 0
    when Result::Err(e) then
      eprintln(e)
      return 1
    end
  end

  match compile_file_core(file.clone(), &opts, &mut emitter)
  when Result::Ok(_) then
    0
  when Result::Err(e) then
    eprintln(e)
    1
  end
end

def cmd_compile_raw(skip_subcommand: Bool) -> Int
  cmd_compile_direct(skip_subcommand)
end

# Helper: find all.tg files recursively
def find_tg_files(dir: String) -> Vec[String]
  var files = Vec::new()
  let entries = match std::fs::read_dir(dir)
  when Result::Ok(entries) then entries
  when Result::Err(_) then return files
  end
  
  for entry in entries do
    if entry.is_dir && !entry.name.starts_with(".") && entry.name != "target" then
      let sub = find_tg_files(entry.path.clone())
      for f in sub do files.push(f) end
    elsif entry.name.ends_with(".tg") then
      files.push(entry.path.clone())
    end
  end
  
  files
end

# Implicit-discovery selection: only RECOGNIZED test sources are selected —
# the files carrying the @test test-attribute marker (the recognized set).
# Non-test sources are never selected; a selected source is a recognized
# test source and runs under the strict discipline, so its read/parse/
# compile failure fails the invocation (no silent vanish).
def select_test_sources(files: Vec[String]) -> Vec[String]
  var selected = Vec::new()
  for file in files do
    match read_file(file.clone())
    when Result::Ok(content) then
      if is_test_source(content) then
        selected.push(file.clone())
      end
    when Result::Err(_) then ()
    end
  end
  selected
end

# A RECOGNIZED test source carries the @test test-attribute marker in the
# attribute position: at the start of a line (after indentation). The marker
# is never matched inside comments or string literals, so the compiler's own
# sources (whose code and docs mention `@test`) cannot self-select.
def is_test_source(content: String) -> Bool
  if content.starts_with("@test") then
    return true
  end
  for line in content.lines() do
    if line.trim().starts_with("@test") then
      return true
    end
  end
  false
end

# The bench counterpart of is_test_source: a recognized benchmark source
# carries the @bench attribute marker in the attribute position (line
# start). Discovered-only: files named *_bench.tg / bench_* need no marker.
def is_bench_source(content: String) -> Bool
  if content.starts_with("@bench") then
    return true
  end
  for line in content.lines() do
    if line.trim().starts_with("@bench") then
      return true
    end
  end
  false
end


# 
# Incremental Compilation Support
# 

struct IncrementalCache
  entries: Map[String, CacheEntry]
  cache_dir: String
end

struct CacheEntry
  source_hash: String
  mir_hash: String
  timestamp: Int
end

def cache_new(dir: String) -> IncrementalCache
  IncrementalCache {
    entries: Map::new(),
    cache_dir: dir
  }
end

def is_stale(cache: IncrementalCache, path: String, source: String) -> Bool
  match cache.entries.get(path)
  when Option::Some(entry) then
    let current_hash = fnv1a_hash(source).to_string()
    entry.source_hash != current_hash
  when Option::None then
    true
  end  end
end

def update_cache(inout cache: IncrementalCache, path: String, source: String, mir_hash: String) -> Unit
  let source_hash = fnv1a_hash(source).to_string()
  cache.entries.insert(path, CacheEntry {
    source_hash: source_hash,
    mir_hash: mir_hash,
    timestamp: current_time()
  })
end

def current_time() -> Int
  # Return seconds since Unix epoch via std::time.
  let now = std::time::SystemTime::now()
  now.tv.tv_sec as Int
end

# Run a program with an ARGV vector through the safe std::process::Command
# API — the replacement for the former `sh -c` string path (the shell
# quoting/injection hazard). Program names, test names and bench names are
# passed as separate argv elements: a name containing spaces, quotes or
# shell metacharacters is a single argument, never a command. The status
# forwards the exact exit code; a signal termination maps to 128+sig.
def bootstrap_call_argv(program: String, args: Vec[String]) -> Int
  var command = std::process::Command::new(program)
  for a in args do
    command = command.arg(a.as_str_view())
  end
  match command.status()
  when Result::Ok(code) then code
  when Result::Err(e) then
    eprintln("error: cannot run '" + program + "': " + e)
    127
  end
end

# Local bootstrap-safe project metadata types.
struct Dependency
  name: String
  version: String
  requirement: Option[String]
  registry: Option[String]
  features: Array[String]
  optional: Bool
  dev_only: Bool
  path: Option[String]
  git: Option[String]
end

struct Project
  name: String
  version: String
  dependencies: Vec[Dependency]
  sources: Vec[String]
  output_dir: String
end

# 
# Build System Integration
# 

def load_project(path: String) -> Result[Project, String]
  # Parse a Tangerine.toml project manifest through the ONE canonical TOML
  # implementation (pkg_manager::parse_toml — the same parser the package
  # system uses; the driver's former line-by-line parser is removed).
  # Expected format:
  #   [package]            (the legacy [project] spelling is also accepted)
  #   name = "my_app"
  #   version = "0.1.0"
  #
  #   [sources]
  #   files = ["src/main.tg", "src/lib.tg"]
  #
  #   [dependencies]
  #   http = "1.0"
  #   http2 = { version = "1.0", path = "../http" }

  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end

  match read_file(manifest_path.clone())
  when Result::Err(e) then
    Result::Err("Cannot read project manifest '" + manifest_path + "': " + e)
  when Result::Ok(content) then
    let toml = match parse_toml(content)
    when Result::Err(e) then
      return Result::Err("Cannot parse project manifest '" + manifest_path + "': " + e.to_string())
    when Result::Ok(t) then t
    end

    var name = "untitled"
    var version = "0.0.0"
    var sources = Vec::new()
    var deps = Vec::new()
    var output_dir = "build"

    # The [package]/[project] table.
    match toml.get("package")
    when Option::Some(v) then
      match v.as_table()
      when Option::Some(t) then
        match t.get("name")
        when Option::Some(n) then
          match n.as_str()
          when Option::Some(s) then name = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("version")
        when Option::Some(vv) then
          match vv.as_str()
          when Option::Some(s) then version = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("output_dir")
        when Option::Some(od) then
          match od.as_str()
          when Option::Some(s) then output_dir = s
          when Option::None then ()
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    when Option::None then ()
    end

    # The legacy [project] spelling (same keys).
    match toml.get("project")
    when Option::Some(v) then
      match v.as_table()
      when Option::Some(t) then
        match t.get("name")
        when Option::Some(n) then
          match n.as_str()
          when Option::Some(s) then name = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("version")
        when Option::Some(vv) then
          match vv.as_str()
          when Option::Some(s) then version = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("output_dir")
        when Option::Some(od) then
          match od.as_str()
          when Option::Some(s) then output_dir = s
          when Option::None then ()
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    when Option::None then ()
    end

    # The [sources] files array.
    match toml.get("sources")
    when Option::Some(v) then
      match v.as_table()
      when Option::Some(t) then
        match t.get("files")
        when Option::Some(fv) then
          match fv.as_array()
          when Option::Some(arr) then
            for f in arr do
              match f.as_str()
              when Option::Some(s) then sources.push(s)
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    when Option::None then ()
    end

    # The [dependencies] table: `name = "version"` or the inline-table form
    # `name = { version = "1.0", path = "../http", optional = true, ... }`.
    match toml.get("dependencies")
    when Option::Some(v) then
      match v.as_table()
      when Option::Some(t) then
        for entry in t do
          let dep_name = entry.key
          match entry.value
          when TomlValue::Str(s) then
            deps.push(Dependency {
              name: dep_name,
              version: s.clone(),
              requirement: Option::Some(s),
              registry: Option::None,
              features: Array::new(),
              optional: false,
              dev_only: false,
              path: Option::None,
              git: Option::None
            })
          when TomlValue::Table(itable) then
            var req = "*".to_string()
            var dep_path = Option::None
            var dep_git = Option::None
            var dep_registry = Option::None
            var optional = false
            match itable.get("version")
            when Option::Some(ver_v) then
              match ver_v.as_str()
              when Option::Some(s) then req = s
              when Option::None then ()
              end
            when Option::None then ()
            end
            match itable.get("path")
            when Option::Some(p_v) then
              match p_v.as_str()
              when Option::Some(s) then dep_path = Option::Some(s)
              when Option::None then ()
              end
            when Option::None then ()
            end
            match itable.get("git")
            when Option::Some(g_v) then
              match g_v.as_str()
              when Option::Some(s) then dep_git = Option::Some(s)
              when Option::None then ()
              end
            when Option::None then ()
            end
            match itable.get("registry")
            when Option::Some(r_v) then
              match r_v.as_str()
              when Option::Some(s) then dep_registry = Option::Some(s)
              when Option::None then ()
              end
            when Option::None then ()
            end
            match itable.get("optional")
            when Option::Some(TomlValue::Bool(b)) then optional = b
            when _ then ()
            end
            deps.push(Dependency {
              name: dep_name,
              version: req.clone(),
              requirement: Option::Some(req),
              registry: dep_registry,
              features: Array::new(),
              optional: optional,
              dev_only: false,
              path: dep_path,
              git: dep_git
            })
          when _ then ()
          end
        end
      when Option::None then ()
      end
    when Option::None then ()
    end

    # Default: if no sources specified, look for src/main.tg
    if sources.is_empty() then
      sources.push("src/main.tg".to_string())
    end

    Result::Ok(Project {
      name: name.to_string(),
      version: version.to_string(),
      dependencies: deps,
      sources: sources,
      output_dir: output_dir.to_string()
    })
  end
end

def build_project(project: Project) -> Result[Unit, String]
  let opts = default_options()
  
  # Resolve dependencies first
  let resolved = resolve_project_deps(project)?
  
  # Build dependency sources before project sources
  for dep_src in resolved.dep_sources do
    match compile_file(&opts, dep_src)
    when Result::Ok(_) then ()
    when Result::Err(e) then return Result::Err("dependency error: " + e)
    end
  end
  
  # Build cache integration
  var cache = load_build_cache(&project.output_dir)
  
  for src in project.sources do
    match read_file(src.clone())
    when Result::Ok(content) then
      if is_stale(&cache, src.clone(), content.clone()) then
        match compile_file(&opts, src.clone())
        when Result::Ok(_) then
          update_cache(&mut cache, src.clone(), content, "".to_string())
        when Result::Err(e) then return Result::Err(e)
        end
      else
        # Cache hit  skip recompilation
        ()
      end
    when Result::Err(_) then
      match compile_file(&opts, src)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
  end
  
  save_build_cache(&cache)
  Result::Ok(())
end

# 
# Dependency Resolution & DriverLockfile
# 

struct ResolvedDeps
  packages: Vec[ResolvedPackage]
  dep_sources: Vec[String]
end

struct ResolvedPackage
  name: String
  version: String
  resolved_path: String
  checksum: String
end

struct DriverLockfile
  packages: Vec[DriverLockEntry]
  metadata: Map[String, String]
  version: Int
end

struct DriverLockEntry
  name: String
  version: String
  source: String
  checksum: String
  dependencies: Vec[String]
end

def resolve_project_deps(project: Project) -> Result[ResolvedDeps, String]
  # Load existing lockfile if present
  let lockfile = load_lockfile("Tangerine.lock")
  
  var resolved = ResolvedDeps {
    packages: Vec::new(),
    dep_sources: Vec::new()
  }
  
  for dep in project.dependencies do
    # Check lockfile first for reproducibility
    let locked_entry = match lockfile
    when Option::Some(lf) then find_lock_entry(lf, &dep.name)
    when Option::None then Option::None
    end
    
    # Resolve the dependency source
    let resolved_pkg = resolve_single_dep(&dep, &locked_entry)?
    
    # Collect source files from resolved dependency
    let dep_dir = resolved_pkg.resolved_path.clone()
    match discover_sources(&dep_dir)
    when Result::Ok(srcs) then
      for s in srcs do
        resolved.dep_sources.push(s)
      end
    when Result::Err(e) then
      return Result::Err("Failed to discover sources for '" + dep.name.clone() + "': " + e)
    end
    
    resolved.packages.push(resolved_pkg)
  end
  
  # Write lockfile with resolved state
  write_lockfile("Tangerine.lock", &resolved)
  
  Result::Ok(resolved)
end

def resolve_single_dep(dep: Dependency, locked: Option[DriverLockEntry]) -> Result[ResolvedPackage, String]
  # If a path dependency, use it directly (local development)
  match dep.path
  when Option::Some(p) then
    return Result::Ok(ResolvedPackage {
      name: dep.name.clone(),
      version: dep.version.clone(),
      resolved_path: p.clone(),
      checksum: hash_directory(p)
    })
  when Option::None then ()
  end
  
  # If a git dependency, clone/fetch
  match dep.git
  when Option::Some(url) then
    let clone_dir = ".tg_deps/" + dep.name.clone()
    
    # Check if already cloned with correct version from lockfile
    match locked
    when Option::Some(entry) then
      if is_dir(&clone_dir) && entry.source == url.clone() then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: clone_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
    
    # Clone the repo
    mkdir_p(".tg_deps")
    let clone_result = run_command("git", vec!["clone", "--depth", "1", url.as_str(), clone_dir.as_str()])
    
    match clone_result
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: clone_dir.clone(),
        checksum: hash_directory(&clone_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to clone '" + dep.name.clone() + "' from " + url.clone() + ": " + e)
    end
  when Option::None then ()
  end
  
  # Registry dependency  fetch from package registry
  let registry_url = "https://registry.tangerine-lang.org"
  let pkg_dir = ".tg_deps/" + dep.name.clone() + "-" + dep.version.clone()
  
  # Check if already downloaded
  if is_dir(&pkg_dir) then
    match locked
    when Option::Some(entry) then
      if entry.version == dep.version then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: pkg_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
  end
  
  # Download package tarball
  mkdir_p(".tg_deps")
  let fetch_url = registry_url + "/api/v1/packages/" + dep.name.clone() + "/" + dep.version.clone() + "/download"
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (pkg_dir.clone() + ".tar.gz").as_str(), fetch_url.as_str()])
  
  match fetch_result
  when Result::Ok(_) then
    # THE ARCHIVE-PATH VALIDATION BEFORE THE TAR XZF (the reviewer's
    # package-manager hardening): the downloaded archive's EVERY entry
    # name AND every link target is checked against the
    # traversal/absolute/backslash rules (the pkg_manager's
    # _tar_entry_name_safe applied to the ACTUAL archive — the same
    # pre-flight the std extractor runs) BEFORE the system tar extracts
    # a single byte. A malicious package cannot write outside the
    # package directory through `tar xzf` — a symlink entry pointing
    # outside the extraction root is rejected here, and the archive is
    # never handed to the system tar.
    match read_to_vec(pkg_dir.clone() + ".tar.gz")
    when Result::Ok(archive_bytes) then
      match validate_tar_gz_archive(&archive_bytes)
      when Result::Ok(_) then ()
      when Result::Err(e) then
        return Result::Err("Refusing to extract '" + dep.name.clone() + "': " + e.to_string())
      end
    when Result::Err(e) then
      return Result::Err("Failed to read the package archive for validation: " + e.to_string())
    end
    # Extract tarball
    mkdir_p(&pkg_dir)
    let extract = run_command("tar", vec!["xzf", (pkg_dir.clone() + ".tar.gz").as_str(), "-C", pkg_dir.as_str()])
    match extract
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: pkg_dir.clone(),
        checksum: hash_directory(&pkg_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to extract package '" + dep.name.clone() + "': " + e)
    end
  when Result::Err(e) then
    Result::Err("Failed to fetch '" + dep.name.clone() + "@" + dep.version.clone() + "' from registry: " + e)
  end
end

def discover_sources(dir: String) -> Result[Vec[String], String]
  # Look for Tangerine.toml in the dependency directory to find its sources.
  # If not found, glob for all.tg files under src/.
  let manifest = dir.clone() + "/Tangerine.toml"
  match load_project(manifest)
  when Result::Ok(proj) then
    var sources = Vec::new()
    for s in proj.sources do
      sources.push(dir.clone() + "/" + s)
    end
    Result::Ok(sources)
  when Result::Err(_) then
    # Fallback: find all.tg files under src/
    let src_dir = dir.clone() + "/src"
    match list_directory(src_dir.clone())
    when Result::Ok(files) then
      var sources = Vec::new()
      for f in files do
        if f.ends_with(".tg") then
          sources.push(src_dir.clone() + "/" + f)
        end
      end
      Result::Ok(sources)
    when Result::Err(_) then
      # Try root directory
      match list_directory(dir.clone())
      when Result::Ok(files) then
        var sources = Vec::new()
        for f in files do
          if f.ends_with(".tg") then
            sources.push(dir.clone() + "/" + f)
          end
        end
        Result::Ok(sources)
      when Result::Err(e) then
        Result::Err("Cannot list directory: " + e)
      end
    end
  end
end

def find_lock_entry(lf: DriverLockfile, name: String) -> Option[DriverLockEntry]
  for entry in lf.packages do
    if entry.name == name then
      return Option::Some(entry.clone())
    end
  end
  Option::None
end

#  DriverLockfile I/O 

def load_lockfile(path: str) -> Option[DriverLockfile]
  match read_file(path.to_string())
  when Result::Ok(content) then
    parse_lockfile(&content)
  when Result::Err(_) then
    Option::None
  end  end
end

def parse_lockfile(content: String) -> Option[DriverLockfile]
  # Format (the canonical TOML emitted by write_lockfile):
  #   # This file is auto-generated by tg. Do not edit.
  #   [[package]]
  #   name = "http"
  #   version = "1.0.0"
  #   source = "path:../http"
  #   checksum = "abc123"
  #   dependencies = ["core", "io"]
  #
  # Parsed through the ONE canonical TOML implementation (pkg_manager::parse_toml).

  let toml = match parse_toml(content)
  when Result::Ok(t) then t
  when Result::Err(_) then return Option::None
  end

  var packages = Vec::new()

  match toml.get("package")
  when Option::Some(TomlValue::Array(pkg_vals)) then
    for pkg_val in pkg_vals do
      var current_name = "".to_string()
      var current_version = "".to_string()
      var current_source = "".to_string()
      var current_checksum = "".to_string()
      var current_deps = Vec::new()

      match pkg_val.as_table()
      when Option::Some(t) then
        match t.get("name")
        when Option::Some(v) then
          match v.as_str()
          when Option::Some(s) then current_name = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("version")
        when Option::Some(v) then
          match v.as_str()
          when Option::Some(s) then current_version = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("source")
        when Option::Some(v) then
          match v.as_str()
          when Option::Some(s) then current_source = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("checksum")
        when Option::Some(v) then
          match v.as_str()
          when Option::Some(s) then current_checksum = s
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("dependencies")
        when Option::Some(TomlValue::Array(dep_vals)) then
          for d in dep_vals do
            match d.as_str()
            when Option::Some(s) then current_deps.push(s)
            when Option::None then ()
            end
          end
        when _ then ()
        end
      when Option::None then ()
      end

      if !current_name.is_empty() then
        packages.push(DriverLockEntry {
          name: current_name.clone(),
          version: current_version.clone(),
          source: current_source.clone(),
          checksum: current_checksum.clone(),
          dependencies: current_deps.clone()
        })
      end
    end
  when _ then ()
  end

  Option::Some(DriverLockfile {
    packages: packages,
    metadata: Map::new(),
    version: 1
  })
end

def write_lockfile(path: str, resolved: ResolvedDeps) -> Unit
  var out = "# This file is auto-generated by tg. Do not edit.\n".to_string()
  out = out + "# Tangerine lockfile v1\n\n"
  
  for pkg in resolved.packages do
    out = out + "[[package]]\n"
    out = out + "name = \"" + pkg.name.clone() + "\"\n"
    out = out + "version = \"" + pkg.version.clone() + "\"\n"
    out = out + "source = \"" + pkg.resolved_path.clone() + "\"\n"
    out = out + "checksum = \"" + pkg.checksum.clone() + "\"\n"
    out = out + "dependencies = []\n\n"
  end
  
  match write_file(path.to_string(), out)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

def hash_directory(dir: String) -> String
  # THE AUTHENTICATED PACKAGE-TREE DIGEST (the reviewer's hash_directory
  # fix): the SHA-256 over the NORMALIZED FULL TREE — every file at every
  # depth, the relative paths sorted, each file's relative path + content
  # fed into the hasher in the canonical order (pkg_manager's
  # hash_package_tree — the single package-tree digest authority). The
  # old FNV-1a over the TOP LEVEL ONLY (.tg files, no recursion) missed
  # a change in a nested file, a rename, or an added/removed non-.tg
  # file — a dependency could change on disk without its lockfile
  # checksum noticing.
  hash_package_tree(dir)
end

# 
# Workspace Support
# 

struct Workspace
  root: String
  members: Vec[String]
  default_members: Vec[String]
  shared_output: String
end

def load_workspace(path: String) -> Result[Workspace, String]
  # Parse a workspace Tangerine.toml with [workspace] through the ONE
  # canonical TOML implementation (pkg_manager::parse_toml).
  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end

  match read_file(manifest_path.clone())
  when Result::Err(e) then
    Result::Err("Cannot read workspace manifest: " + e)
  when Result::Ok(content) then
    let toml = match parse_toml(content)
    when Result::Err(e) then
      return Result::Err("Cannot parse workspace manifest '" + manifest_path + "': " + e.to_string())
    when Result::Ok(t) then t
    end

    var members = Vec::new()
    var default_members = Vec::new()
    var is_workspace = false

    match toml.get("workspace")
    when Option::Some(v) then
      match v.as_table()
      when Option::Some(t) then
        is_workspace = true
        match t.get("members")
        when Option::Some(mv) then
          match mv.as_array()
          when Option::Some(arr) then
            for m in arr do
              match m.as_str()
              when Option::Some(s) then members.push(s)
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
        match t.get("default-members")
        when Option::Some(mv) then
          match mv.as_array()
          when Option::Some(arr) then
            for m in arr do
              match m.as_str()
              when Option::Some(s) then default_members.push(s)
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    when Option::None then ()
    end

    if !is_workspace then
      return Result::Err("No [workspace] section in " + manifest_path)
    end

    if default_members.is_empty() then
      default_members = members.clone()
    end

    Result::Ok(Workspace {
      root: path.clone(),
      members: members,
      default_members: default_members,
      shared_output: path + "/build"
    })
  end
end

def build_workspace(ws: Workspace) -> Result[Unit, String]
  println("Building workspace with " + ws.members.len().to_string() + " member(s)")
  
  for member in ws.default_members do
    let member_path = ws.root.clone() + "/" + member.clone()
    println("  Building " + member.clone() + "...")
    
    match load_project(member_path.clone())
    when Result::Ok(project) then
      match build_project(&project)
      when Result::Ok(_) then
        println("     " + member.clone())
      when Result::Err(e) then
        return Result::Err("Failed to build workspace member '" + member + "': " + e)
      end
    when Result::Err(e) then
      return Result::Err("Failed to load workspace member '" + member + "': " + e)
    end
  end
  
  println("Workspace build complete.")
  Result::Ok(())
end

# 
# tg dep  Dependency Management
# 

def cmd_dep(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg dep <subcommand>")
    println("")
    println("Subcommands:")
    println("  add <name> [--version <ver>] [--path <path>] [--git <url>]")
    println("  remove <name>")
    println("  list")
    println("  update [<name>]")
    println("  tree")
    return 1
  end
  
  let sub = argv[1].clone()
  
  if sub == "add" then
    cmd_dep_add(argv)
  elsif sub == "remove" then
    cmd_dep_remove(argv)
  elsif sub == "list" then
    cmd_dep_list()
  elsif sub == "update" then
    cmd_dep_update(argv)
  elsif sub == "tree" then
    cmd_dep_tree()
  else
    1
  end
end

def cmd_dep_add(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  var version = "*".to_string()
  var path_opt = Option::None
  var git_opt = Option::None
  
  var i: UInt = 3
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--path" && i + 1 < argv.len() then
      path_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    elsif argv[i] == "--git" && i + 1 < argv.len() then
      git_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    else
      i = i + 1
    end
  end
  
  # Read current manifest
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Check if [dependencies] section exists
    var new_content = content.clone()
    let dep_line = name.clone() + " = " + match path_opt
    when Option::Some(p) then
      "{ version = \"" + version.clone() + "\", path = \"" + p.clone() + "\" }"
    when Option::None then
      match git_opt
      when Option::Some(url) then
        "{ version = \"" + version.clone() + "\", git = \"" + url.clone() + "\" }"
      when Option::None then
        "\"" + version.clone() + "\""
      end
    end
    
    if content.contains("[dependencies]") then
      # Append after [dependencies] line
      new_content = content.replace("[dependencies]", "[dependencies]\n" + dep_line)
    else
      # Add [dependencies] section
      new_content = content + "\n[dependencies]\n" + dep_line + "\n"
    end
    
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Added dependency: " + name + " " + version)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_remove(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Remove lines matching the dependency name in [dependencies]
    var new_lines = Vec::new()
    var in_deps = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      
      if trimmed == "[dependencies]" then
        in_deps = true
        new_lines.push(line.to_string())
        next
      end
      
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        in_deps = false
      end
      
      if in_deps && trimmed.starts_with(name.as_str()) then
        # Skip this dependency line
        next
      end
      
      new_lines.push(line.to_string())
    end
    
    let new_content = new_lines.join("\n")
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Removed dependency: " + name)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(_) then
    1
  end
end

def cmd_dep_list() -> Int
  match load_project(".")
  when Result::Ok(project) then
    if project.dependencies.is_empty() then
      println("No dependencies.")
    else
      println("Dependencies:")
      for dep in project.dependencies do
        var info = "  " + dep.name.clone() + " " + dep.version.clone()
        match dep.path
        when Option::Some(p) then info = info + " (path: " + p.clone() + ")"
        when Option::None then ()
        end
        match dep.git
        when Option::Some(url) then info = info + " (git: " + url.clone() + ")"
        when Option::None then ()
        end
        println(info)
      end
    end
    0
  when Result::Err(e) then
    1
  end  end
end

def cmd_dep_update(argv: Vec[String]) -> Int
  # Re-resolve all dependencies (or a specific one) and update lockfile
  let filter = if argv.len() >= 3 then
    Option::Some(argv[2].clone())
  else
    Option::None
  end
  
  match load_project(".")
  when Result::Ok(project) then
    # Remove lockfile to force re-resolution
    match filter
    when Option::Some(name) then
      println("Updating dependency: " + name.clone())
    when Option::None then
      println("Updating all dependencies...")
      # Delete existing lockfile to force fresh resolution
      let _ = delete_file("Tangerine.lock")
    end
    
    match resolve_project_deps(&project)
    when Result::Ok(resolved) then
      println("Updated " + resolved.packages.len().to_string() + " package(s).")
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_tree() -> Int
  # Display dependency tree
  match load_project(".")
  when Result::Ok(project) then
    println(project.name.clone() + " v" + project.version.clone())
    for dep in project.dependencies do
      let prefix = " "
      var line = prefix + dep.name.clone() + " v" + dep.version.clone()
      match dep.path
      when Option::Some(p) then line = line + " (path)"
      when Option::None then ()
      end
      match dep.git
      when Option::Some(url) then line = line + " (git)"
      when Option::None then ()
      end
      println(line)
      
      # Attempt to load transitive deps
      let dep_dir = match dep.path
      when Option::Some(p) then p.clone()
      when Option::None then ".tg_deps/" + dep.name.clone()
      end
      
      match load_project(dep_dir)
      when Result::Ok(sub_proj) then
        for sub_dep in sub_proj.dependencies do
          println("    " + sub_dep.name.clone() + " v" + sub_dep.version.clone())
        end
      when Result::Err(_) then ()
      end
    end
    0
  when Result::Err(e) then
    1
  end
end

# 
# tg install  Package Installation
# 

def cmd_install(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg install <package-name> [--version <ver>]")
    println("")
    println("Installs a Tangerine package binary to ~/.tg/bin/")
    println("")
    println("Options:")
    println("  --version <ver>  Install a specific version")
    println("  --global         Install globally (default)")
    println("  --force          Reinstall even if already installed")
    return 0
  end
  
  let pkg_name = argv[1].clone()
  var version = "latest".to_string()
  var force = false
  
  var i: UInt = 2
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--force" then
      force = true
      i = i + 1
    else
      i = i + 1
    end
  end
  
  let install_dir = home_dir() + "/.tg/bin"
  mkdir_p(&install_dir)
  
  let install_path = install_dir.clone() + "/" + pkg_name.clone()
  
  if !force && file_exists(&install_path) then
    println("Package '" + pkg_name.clone() + "' is already installed. Use --force to reinstall.")
    return 0
  end
  
  println("Installing " + pkg_name.clone() + " " + version.clone() + "...")
  
  # Create a temp directory, fetch the package, build it, copy binary
  let tmp_dir = "/tmp/tg_install_" + pkg_name.clone()
  mkdir_p(&tmp_dir)
  
  # Fetch from registry
  let registry_url = "https://registry.tangerine-lang.org"
  let fetch_url = registry_url + "/api/v1/packages/" + pkg_name.clone() + "/" + version.clone() + "/download"
  
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), fetch_url.as_str()])
  match fetch_result
  when Result::Ok(_) then
    # Extract
    let extract = run_command("tar", vec!["xzf", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), "-C", tmp_dir.as_str()])
    match extract
    when Result::Ok(_) then
      # Build the package
      match load_project(tmp_dir.clone())
      when Result::Ok(project) then
        match build_project(&project)
        when Result::Ok(_) then
          # Copy resulting binary to install dir
          let binary = tmp_dir.clone() + "/build/" + pkg_name.clone()
          let cp_result = run_command("cp", vec![binary.as_str(), install_path.as_str()])
          match cp_result
          when Result::Ok(_) then
            # Make executable
            let _ = run_command("chmod", vec!["+x", install_path.as_str()])
            println("Installed " + pkg_name.clone() + " to " + install_path)
            0
          when Result::Err(e) then
            1
          end
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

# 
# tg self-update  Compiler Version Manager
# 

def cmd_self_update(argv: Vec[String]) -> Int
  println("Tangerine self-update")
  println("")
  
  let current_version = VERSION
  
  # Determine target triple
  let os = detect_os()
  let arch = detect_arch()
  let target = arch + "-" + os
  
  println("Current version: " + current_version)
  println("Target: " + target.clone())
  
  # Check for latest version from release server
  let release_url = "https://releases.tangerine-lang.org/latest/version"
  println("Checking for updates...")
  
  let version_result = run_command("curl", vec!["-sSL", release_url.as_str()])
  match version_result
  when Result::Ok(latest_version) then
    let latest = latest_version.trim().to_string()
    
    if latest == current_version then
      println("Already up to date (v" + current_version + ").")
      return 0
    end
    
    println("New version available: v" + latest.clone())
    println("Downloading...")
    
    let download_url = "https://releases.tangerine-lang.org/" + latest.clone() + "/tg-" + target + ".tar.gz"
    let tmp = "/tmp/tg_self_update.tar.gz"
    
    let dl = run_command("curl", vec!["-sSL", "-o", tmp, download_url.as_str()])
    match dl
    when Result::Ok(_) then
      # Extract to temp location
      let tmp_dir = "/tmp/tg_self_update"
      mkdir_p(tmp_dir)
      let extract = run_command("tar", vec!["xzf", tmp, "-C", tmp_dir])
      
      match extract
      when Result::Ok(_) then
        # Replace current binary
        let current_binary = argv[0].clone()  # Path to running tg binary
        let new_binary = tmp_dir.to_string() + "/tg"
        
        let cp = run_command("cp", vec![new_binary.as_str(), current_binary.as_str()])
        match cp
        when Result::Ok(_) then
          let _ = run_command("chmod", vec!["+x", current_binary.as_str()])
          println("Updated to v" + latest + " successfully!")
          0
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def detect_os() -> String
  # Check via uname (available on macOS/Linux)
  match run_command("uname", vec!["-s"])
  when Result::Ok(out) then
    let os = out.trim().to_lowercase()
    if os.contains("darwin") then "apple-darwin".to_string()
    elsif os.contains("linux") then "unknown-linux-gnu".to_string()
    else "unknown".to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end
end

def detect_arch() -> String
  match run_command("uname", vec!["-m"])
  when Result::Ok(out) then
    let arch = out.trim().to_lowercase()
    if arch == "x86_64" || arch == "amd64" then "x86_64".to_string()
    elsif arch == "arm64" || arch == "aarch64" then "aarch64".to_string()
    else arch.to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end  end
end

def cmd_explain_main(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    return 1
  end
  cmd_explain(argv[1].clone())
  0
end

# 
# Subcommand: agent
# 
#
# Run agentic workflows using the Tangerine agentic subsystem.
# Provides CLI access to contracts, capabilities, effects, and budgets.
#
# Usage:
#   tg agent check <file>            verify all contracts in a source file
#   tg agent caps <file>             list capabilities required by a module
#   tg agent effects <file>          list effects performed by a module
#   tg agent budget <file>           analyse resource budget of a module
#   tg agent diff <old> <new>        semantic diff between two source files
#   tg agent audit <dir>             full agentic audit of a project

def cmd_agent(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg agent <subcommand> [options] <file>")
    println("")
    println("Subcommands:")
    println("  check    Verify all contracts (pre/post/invariant)")
    println("  caps     List required capabilities")
    println("  effects  List effects performed by each function")
    println("  budget   Analyse resource budget usage")
    println("  diff     Semantic diff between two source files")
    println("  audit    Full agentic audit of a project directory")
    return 1
  end

  let subcmd = argv[1].clone()
  
  if subcmd == "check" then
    agent_check(argv)
  elsif subcmd == "caps" then
    agent_caps(argv)
  elsif subcmd == "effects" then
    agent_effects(argv)
  elsif subcmd == "budget" then
    agent_budget(argv)
  elsif subcmd == "diff" then
    agent_diff(argv)
  elsif subcmd == "audit" then
    agent_audit(argv)
  else
    1
  end
end

def agent_check(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Extract contract declarations from the AST
  var contract_count = 0

  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      for contract in f.contracts do
        contract_count = contract_count + 1
        # Verify contract is well-formed (condition references in-scope names)
        let cond_note = match contract.message
        when Option::Some(m) then m.clone()
        when Option::None then "(no message)"
        end
        println("  [" + contract.kind.to_string() + "] " + f.name.clone() + ": " + cond_note)
      end
    when _ then ()
    end
  end

  # THE REAL SEMANTIC VERIFICATION (the reviewer's false-success fix):
  # the agentic subsystem's contract checker ACTUALLY runs —
  # analyze_agentic_features checks every contract for unsatisfiability
  # (the trivially-false probe), every required capability for
  # availability, and every declared effect for existence — and the
  # violations ARE counted and reported (the old stub counted 0 forever
  # and returned success on every input). A violation fails the
  # invocation.
  var ctx = agentic_context_new()
  let violations = analyze_agentic_features(&mut ctx, ast)
  for v in violations do
    println("  [violation] " + v)
  end

  println("Contract analysis for " + path + ":")
  println("  Total contracts: " + contract_count.to_string())
  println("  Violations: " + violations.len().to_string())
  if violations.len() == 0 then 0 else 1 end
end

def agent_caps(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for capability annotations: #[require(cap)] and `require_capability` calls
  var caps = Set::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      for attr in item.attrs do
        if attr.name == "require" then
          for arg in attr.args do
            caps.insert(arg.value.clone())
          end
        end
      end
    when _ then ()
    end
  end

  println("Capabilities required by " + path + ":")
  if caps.is_empty() then
    println("  (none)")
  else
    for cap_name in caps do
      println("  - " + cap_name)
    end
  end
  0
end

def agent_effects(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for effect annotations and perform declarations
  println("Effects in " + path + ":")
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      var fn_effects = Vec::new()
      for attr in item.attrs do
        if attr.name == "performs" || attr.name == "effect" then
          for arg in attr.args do
            fn_effects.push(arg.value.clone())
          end
        end
      end
      if !fn_effects.is_empty() then
        var effect_str = ""
        var first = true
        for e in fn_effects do
          if !first then effect_str = effect_str + ", " end
          effect_str = effect_str + e
          first = false
        end
        println("  " + f.name.clone() + ": performs " + effect_str)
      end
    when _ then ()
    end
  end
  0
end

def agent_budget(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  var ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Lower to MIR and analyse budget consumption. THE ONE canonical semantic
  # path (analyze_program) — expansion, node ids, resolution, type/access/
  # resource checks — produces the AnalyzedProgram artifact the lowering
  # consumes (no checker re-run). The former manual pre-pass
 # (assign_node_ids + resolve + type_check_typed) is not part of the model — performing
  # node-id assignment here would renumber the ids the canonical pass
  # assigns.
  var typed_program: Option[AnalyzedProgram] = Option::None
  var opts = default_options()
  var env = type_env_new()
  match analyze_program(&mut env, &mut ast, &opts)
  when Result::Ok(ap) then
    typed_program = Option::Some(ap)
  when Result::Err(diags) then
    eprintln(join_diagnostics(&diags))
    return 1
  end

  let mir = match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  println("Budget analysis for " + path + ":")
  for func in mir.functions do
    var budget_ops = Vec::new()
    for block in func.blocks do
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirBudgetConsume(resource, amount) then
          budget_ops.push((resource.clone(), amount))
        when _ then ()
        end
      end
    end
    if !budget_ops.is_empty() then
      println("  fn " + func.name.clone() + ":")
      for op in budget_ops do
        let res = op.0
        let amt = op.1
        println("    consumes " + amt.to_string() + " units of " + res)
      end
    end
  end
  0
end

def agent_diff(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end
  let old_path = argv[2].clone()
  let new_path = argv[3].clone()

  let old_source = match read_file(old_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end
  let new_source = match read_file(new_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  # Parse both
  let old_parse = parse(tokenize(old_source, ""))
  let old_ast = old_parse.program
  let old_diags = old_parse.diagnostics
  if diag_has_errors(&old_diags) then
    return 1
  end
  let new_parse = parse(tokenize(new_source, ""))
  let new_ast = new_parse.program
  let new_diags = new_parse.diagnostics
  if diag_has_errors(&new_diags) then
    return 1
  end

  # Semantic diff: compare items by name
  println("Semantic diff: " + old_path + "  " + new_path)

  var old_items: Map[String, String] = Map::new()
  for item in old_ast.items do
    let name = item_name(&item)
    old_items.insert(name, item.kind.to_string())
  end

  var new_items: Map[String, String] = Map::new()
  for item in new_ast.items do
    let name = item_name(&item)
    new_items.insert(name, item.kind.to_string())
  end

  # Added items
  for entry in new_items do
    let name = entry.key
    if !old_items.contains_key(&name) then
      println("  + " + name + " (added)")
    end
  end

  # Removed items
  for entry in old_items do
    let name = entry.key
    if !new_items.contains_key(&name) then
      println("  - " + name + " (removed)")
    end
  end

  # Modified items
  for entry in old_items do
    let name = entry.key
    let old_kind = entry.value
    match new_items.get(&name)
    when Option::Some(new_kind) then
      if old_kind != new_kind then
        println("  ~ " + name + " (modified)")
      end
    when Option::None then ()
    end
  end
  0
end

def item_name(item: Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then f.name.clone()
  when ItemKind::ItemStruct(s) then s.name.clone()
  when ItemKind::ItemEnum(e) then e.name.clone()
  when ItemKind::ItemTrait(t) then t.name.clone()
  when ItemKind::ItemImpl(i) then "impl_" + type_expr_name(&i.for_type).clone()
  when ItemKind::ItemConst(c) then c.name.clone()
  when ItemKind::ItemMacro(m) then "macro_" + m.name.clone()
  when _ then "<anonymous>"
  end  end
end

def agent_audit(argv: Vec[String]) -> Int
  let dir = if argv.len() >= 3 then argv[2].clone() else ".".to_string() end

  println("Agentic audit of " + dir + ":")
  println("========================================")

  # Discover all.tg files
  let files = discover_sources(&dir)

  var total_contracts = 0
  var total_caps = 0
  var total_effects = 0
  var total_unsafe = 0
  var total_functions = 0

  for file in files do
    let source = match read_file(file.clone())
    when Result::Ok(s) then s
    when Result::Err(_) then next
    end

    let tokens = tokenize(source, "")
    let parse_out = parse(tokens)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then next end

    for item in ast.items do
      match item.kind
      when ItemKind::ItemFunction(f) then
        total_functions = total_functions + 1
        total_contracts = total_contracts + f.contracts.len()
        if f.is_unsafe then total_unsafe = total_unsafe + 1 end
        for attr in item.attrs do
          if attr.name == "require" then
            total_caps = total_caps + attr.args.len()
          end
          if attr.name == "performs" || attr.name == "effect" then
            total_effects = total_effects + attr.args.len()
          end
        end
      when _ then ()
      end
    end
  end

  println("  Files scanned:   " + files.len().to_string())
  println("  Functions:       " + total_functions.to_string())
  println("  Contracts:       " + total_contracts.to_string())
  println("  Capabilities:    " + total_caps.to_string())
  println("  Effects:         " + total_effects.to_string())
  println("  Unsafe functions:" + total_unsafe.to_string())
  println("")

  if total_unsafe > 0 then
    println("  WARNING: " + total_unsafe.to_string() + " unsafe functions found  ensure SAFETY comments are present")
  end

  println("Audit complete.")
  0
end

# 
# Subcommand: bindgen
# 
# Generates FFI bindings for C, Rust, and Ruby.
# Per interop.txt 8.2, 9.1, 12
#
# Usage:
#   tg bindgen c <file.tg> [-o output.h]
#   tg bindgen rust <file.tg> [-o output_dir]
#   tg bindgen ruby <file.tg> [-o output_dir]

def cmd_bindgen(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    print_bindgen_help()
    return 1
  end

  let target = argv[1].clone()
  let file = argv[2].clone()

  let output = if argv.len() >= 5 && argv[3] == "-o" then
    argv[4].clone()
  else
    match target.as_str()
    when "c" then file.replace(".tg", ".h")
    when "rust" then "tangerine_shim"
    when "ruby" then "ext"
    end
  end

  match target.as_str()
  when "c" then bindgen_c(file, output)
  when "rust" then bindgen_rust(file, output)
  when "ruby" then bindgen_ruby(file, output)
  when _ then
    1
  end
end

def print_bindgen_help() -> Unit
  println("Usage: tg bindgen <target> <file.tg> [-o output]")
  println("Generate FFI bindings")
  println("")
  println("Targets:")
  println("  c      Generate C header (.h)")
  println("  rust   Generate Rust shim crate")
  println("  ruby   Generate Ruby extension scaffold")
  println("")
  println("Options:")
  println("  -o <path>  Output file/directory")
end

# Generate C header from Tangerine source
def bindgen_c(source_file: String, output: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  var header = "/* Generated by tg bindgen c */\n"
  header = header + "#ifndef TG_BINDINGS_H\n"
  header = header + "#define TG_BINDINGS_H\n\n"
  header = header + "#include <stdint.h>\n"
  header = header + "#include <stdbool.h>\n\n"

  header = header + "/* Type aliases */\n"
  header = header + "typedef int64_t tg_int;\n"
  header = header + "typedef uint64_t tg_uint;\n"
  header = header + "typedef double tg_float;\n"
  header = header + "typedef uint8_t tg_u8;\n"
  header = header + "typedef uint32_t tg_char;\n\n"

  header = header + "/* FFI string view (borrowed) */\n"
  header = header + "typedef struct { const uint8_t* ptr; size_t len; } tg_str;\n\n"

  header = header + "/* FFI result */\n"
  header = header + "typedef struct { bool ok; int32_t err_code; } tg_result_void;\n\n"

  # Extract extern "C" functions
  header = header + "/* Exported functions */\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        header = header + generate_c_prototype(&f) + "\n"
      end
    when ItemKind::ItemStruct(s) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_struct(&s) + "\n"
      end
    when ItemKind::ItemEnum(e) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_enum(&e) + "\n"
      end
    when _ then ()
    end
  end

  header = header + "\n#endif /* TG_BINDINGS_H */\n"

  match write_file(output.clone(), header)
  when Result::Ok(_) then
    println("Generated " + output)
    0
  when Result::Err(e) then
    1
  end
end

def is_ffi_exported(f: FunctionDecl, annotations: Vec[Attribute]) -> Bool
  # Check if function has extern "C" abi or has #[export] annotation
  var is_export = false
  for a in annotations do
    if a.name == "export" then is_export = true end
  end
  is_export
end

def is_repr_c(annotations: Vec[Annotation]) -> Bool
  for a in annotations do
    if a.name == "repr" then
      for arg in a.args do
        if arg.value == "c" || arg.value == "C" then
          return true
        end
      end
    end
  end
  false
end

def generate_c_prototype(f: FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_expr_to_c(rt)
    when Option::None then "void"
  end
  var params = ""
  var first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_expr_to_c(t)
      when Option::None then "void*"
    end
    params = params + ty_str + " " + p.name.clone()
    first = false
  end
  if params == "" then params = "void" end
  ret_type + " " + f.name.clone() + "(" + params + ");"
end

def generate_c_struct(s: StructDecl) -> String
  var result = "typedef struct {\n"
  for field in s.fields do
    result = result + "    " + tangerine_type_expr_to_c(&field.ty) + " " + field.name.clone() + ";\n"
  end
  result = result + "} " + s.name.clone() + ";\n"
  result
end

def generate_c_enum(e: EnumDecl) -> String
  var result = "typedef enum {\n"
  var val = 0
  for variant in e.variants do
    result = result + "    " + e.name.clone() + "_" + variant.name.clone()
    result = result + " = " + val.to_string() + ",\n"
    val = val + 1
  end
  result = result + "} " + e.name.clone() + ";\n"
  result
end

def tangerine_type_to_c(ty: String) -> String
  if ty == "Bool" then "bool"
  elsif ty == "Int" then "tg_int"
  elsif ty == "UInt" then "tg_uint"
  elsif ty == "Float" then "tg_float"
  elsif ty == "Char" then "tg_char"
  elsif ty == "String" then "tg_str"
  elsif ty == "U8" then "tg_u8"
  else ty.clone()
  end
end

def tangerine_type_expr_to_c(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "void"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "int64_t"
    elsif name == "UInt" then "uint64_t"
    elsif name == "Float" then "double"
    elsif name == "Char" then "uint32_t"
    elsif name == "String" then "tg_str"
    else name.clone()
    end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "void*"
  end  end
end

# Generate Rust shim crate
def bindgen_rust(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())
  std::fs::create_dir_all(output_dir.clone() + "/src")

  # Generate Cargo.toml
  let cargo_toml = "[package]\n" +
    "name = \"tangerine_shim\"\n" +
    "version = \"0.1.0\"\n" +
    "edition = \"2021\"\n\n" +
    "[lib]\n" +
    "crate-type = [\"cdylib\", \"staticlib\"]\n"

  match write_file(output_dir.clone() + "/Cargo.toml", cargo_toml)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate lib.rs
  var lib_rs = "//! Generated by tg bindgen rust\n\n"
  lib_rs = lib_rs + "#![allow(non_camel_case_types)]\n\n"

  lib_rs = lib_rs + "// Type aliases\n"
  lib_rs = lib_rs + "pub type tg_int = i64;\n"
  lib_rs = lib_rs + "pub type tg_uint = u64;\n"
  lib_rs = lib_rs + "pub type tg_float = f64;\n\n"

  lib_rs = lib_rs + "// FFI string view\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgStr { pub ptr: *const u8, pub len: usize }\n\n"

  lib_rs = lib_rs + "// FFI result\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgResultVoid { pub ok: bool, pub err_code: i32 }\n\n"

  lib_rs = lib_rs + "extern \"C\" {\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        lib_rs = lib_rs + "    " + generate_rust_extern(&f) + "\n"
      end
    when _ then ()
    end
  end
  lib_rs = lib_rs + "}\n"

  match write_file(output_dir.clone() + "/src/lib.rs", lib_rs)
  when Result::Ok(_) then
    println("Generated Rust shim in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_rust_extern(f: FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_to_rust(rt)
    when Option::None then "()"
  end
  var params = ""
  var first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_to_rust(t)
      when Option::None then "*const ()"
    end
    params = params + p.name.clone() + ": " + ty_str
    first = false
  end
  let ret_clause = if ret_type == "()" then "" else " -> " + ret_type end
  "pub fn " + f.name.clone() + "(" + params + ")" + ret_clause + ";"
end

def tangerine_type_to_rust(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "()"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "i64"
    elsif name == "UInt" then "u64"
    elsif name == "Float" then "f64"
    elsif name == "Char" then "u32"
    elsif name == "String" then "TgStr"
    else name.clone()
    end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "*mut std::ffi::c_void"
  end  end
end

# Generate Ruby extension scaffold
def bindgen_ruby(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  let module_name = source_file.replace(".tg", "").replace("/", "_")

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())

  # Generate extconf.rb
  let extconf = "require 'mkmf'\n\n" +
    "extension_name = '" + module_name + "'\n" +
    "dir_config(extension_name)\n" +
    "create_makefile(extension_name)\n"

  match write_file(output_dir.clone() + "/extconf.rb", extconf)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate extension.c
  var ext_c = "/* Generated by tg bindgen ruby */\n"
  ext_c = ext_c + "#include \"ruby.h\"\n\n"
  ext_c = ext_c + "static VALUE m" + module_name + ";\n\n"

  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        ext_c = ext_c + generate_ruby_wrapper(&f, &module_name) + "\n"
      end
    when _ then ()
    end
  end

  ext_c = ext_c + "void Init_" + module_name + "(void) {\n"
  ext_c = ext_c + "    m" + module_name + " = rb_define_module(\"" + capitalize(&module_name) + "\");\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let argc = f.params.len()
        ext_c = ext_c + "    rb_define_module_function(m" + module_name
        ext_c = ext_c + ", \"" + f.name.clone() + "\", rb_" + f.name.clone()
        ext_c = ext_c + ", " + argc.to_string() + ");\n"
      end
    when _ then ()
    end
  end
  ext_c = ext_c + "}\n"

  match write_file(output_dir.clone() + "/" + module_name + ".c", ext_c)
  when Result::Ok(_) then
    println("Generated Ruby extension in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_ruby_wrapper(f: FunctionDecl, module_name: String) -> String
  let argc = f.params.len()
  var params = ""
  var i = 0
  while i < argc do
    if i > 0 then params = params + ", " end
    params = params + "VALUE arg" + i.to_string()
    i = i + 1
  end
  if argc == 0 then params = "VALUE self" else params = "VALUE self, " + params end

  # Build argument conversion code
  var conversions = ""
  var call_args = ""
  i = 0
  while i < argc do
    let param = f.params[i]
    let arg_name = "arg" + i.to_string()
    let conv_name = "c_" + arg_name
    
    # Generate conversion based on parameter type
    let (conv_code, c_type) = match param.ty
      when Option::Some(t) then ruby_to_c_conversion(arg_name.clone(), t)
      when Option::None then ("(void*)" + arg_name.clone(), "void*")
    end
    conversions = conversions + "    " + c_type + " " + conv_name + " = " + conv_code + ";\n"
    
    if i > 0 then call_args = call_args + ", " end
    call_args = call_args + conv_name
    i = i + 1
  end
  
  # Generate return value handling
  let (ret_decl, ret_call, ret_conv) = match f.ret_type
    when Option::Some(rt) then c_to_ruby_return(rt)
    when Option::None then ("", "", "    return Qnil;\n")
  end

  "static VALUE rb_" + f.name.clone() + "(" + params + ") {\n" +
  conversions +
  ret_decl +
  "    " + ret_call + f.name.clone() + "(" + call_args + ");\n" +
  ret_conv +
  "}\n"
end

# Convert Ruby VALUE to C type for function call
def ruby_to_c_conversion(arg: String, ty: TypeExpr) -> (String, String)
  match ty.kind
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then ("NUM2LONG(" + arg + ")", "long")
    when "UInt" then ("NUM2ULONG(" + arg + ")", "unsigned long")
    when "Float" then ("NUM2DBL(" + arg + ")", "double")
    when "Bool" then ("RTEST(" + arg + ")", "int")
    when "String" then ("StringValueCStr(" + arg + ")", "const char*")
    when "RubyValue" then (arg, "VALUE")
    when _ then ("(void*)" + arg, "void*")
    end
  when TypeExprKind::Ptr(_) then
    ("(void*)" + arg, "void*")
  when TypeExprKind::PtrMut(_) then
    ("(void*)" + arg, "void*")
  when _ then
    ("(void*)" + arg, "void*")
  end  end
end

# Generate C return handling code for Ruby
def c_to_ruby_return(ty: TypeExpr) -> (String, String, String)
  match ty.kind
  when TypeExprKind::Unit then
    ("", "", "    return Qnil;\n")
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then
      ("    long tg_result;\n", "tg_result = ", "    return LONG2NUM(tg_result);\n")
    when "UInt" then
      ("    unsigned long tg_result;\n", "tg_result = ", "    return ULONG2NUM(tg_result);\n")
    when "Float" then
      ("    double tg_result;\n", "tg_result = ", "    return DBL2NUM(tg_result);\n")
    when "Bool" then
      ("    int tg_result;\n", "tg_result = ", "    return tg_result ? Qtrue : Qfalse;\n")
    when "String" then
      ("    const char* tg_result;\n", "tg_result = ", "    return rb_str_new_cstr(tg_result);\n")
    when "RubyValue" then
      ("    VALUE tg_result;\n", "tg_result = ", "    return tg_result;\n")
    when _ then
      ("", "", "    return Qnil;\n")
    end
  when _ then
    ("", "", "    return Qnil;\n")
  end  end
end

def capitalize(s: String) -> String
  if s.is_empty() then return "" end
  let first = s.char_at(0).to_uppercase().to_string()
  first + s.slice(1, s.len())
end

# 
# Subcommand: abi
# 
# ABI tools: test, dump, check
# Per interop.txt 10.2
#
# Usage:
#   tg abi test [file.tg]    validate ABI conformance
#   tg abi dump <file.tg>    dump type layouts
#   tg abi check <a.tg> <b.tg>   check ABI compatibility

def cmd_abi(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    print_abi_help()
    return 1
  end

  let subcmd = argv[1].clone()
  match subcmd.as_str()
  when "test" then abi_test(argv)
  when "dump" then abi_dump(argv)
  when "check" then abi_check(argv)
  when _ then
    print_abi_help()
    1
  end
end

def print_abi_help() -> Unit
  println("Usage: tg abi <subcommand> [args]")
  println("ABI tools")
  println("")
  println("Subcommands:")
  println("  test [file]     Validate ABI conformance")
  println("  dump <file>     Dump type layouts (size/align)")
  println("  check <a> <b>   Check ABI compatibility between files")
end

# Validate ABI conformance  checks type sizes, alignments, calling conventions
def abi_test(argv: Vec[String]) -> Int
  println("Tangerine ABI Test Suite")
  println("========================")
  println("")

  var passed = 0
  var failed = 0

  # Primitive type size/align tests (per interop.txt 5.2)
  let tests = [
    ("i8/u8", 1, 1),
    ("i16/u16", 2, 2),
    ("i32/u32", 4, 4),
    ("i64/u64", 8, 8),
    ("isize/usize", 8, 8),
    ("bool", 1, 1),
    ("f32", 4, 4),
    ("f64", 8, 8),
    ("*T", 8, 8)
  ]

  println("Primitive type layout tests:")
  let empty_layout: Map[Int, Int] = Map::new()
  
  # Test Int (i64)
  let int_size = type_size(&Type::Int, &empty_layout)
  let int_align = type_align(&Type::Int)
  if int_size == 8 && int_align == 8 then
    println("   Int: size=8, align=8")
    passed = passed + 1
  else
    println("   Int: expected size=8 align=8, got size=" + int_size.to_string() + " align=" + int_align.to_string())
    failed = failed + 1
  end

  # Test Bool
  let bool_size = type_size(&Type::Bool, &empty_layout)
  let bool_align = type_align(&Type::Bool)
  if bool_size == 1 && bool_align == 1 then
    println("   Bool: size=1, align=1")
    passed = passed + 1
  else
    println("   Bool: expected size=1 align=1, got size=" + bool_size.to_string())
    failed = failed + 1
  end

  # Test Float (f64)
  let float_size = type_size(&Type::Float, &empty_layout)
  let float_align = type_align(&Type::Float)
  if float_size == 8 && float_align == 8 then
    println("   Float: size=8, align=8")
    passed = passed + 1
  else
    println("   Float: expected size=8 align=8, got size=" + float_size.to_string())
    failed = failed + 1
  end

  # Test Ref (pointer)
  let ref_size = type_size(&Type::RefInternal(Type::Int, false), &empty_layout)
  if ref_size == 8 then
    println("   &T: size=8")
    passed = passed + 1
  else
    println("   &T: expected size=8, got " + ref_size.to_string())
    failed = failed + 1
  end

  # Test String (raw char*)
  let str_size = type_size(&Type::String, &empty_layout)
  if str_size == 8 then
    println("   String: size=8")
    passed = passed + 1
  else
    println("   String: expected size=8, got " + str_size.to_string())
    failed = failed + 1
  end

  # Test Slice lowering (the two-field view {ptr, len} — a 16-byte inline
  # aggregate, slice_view_layout). The collapsed Adt form: builtin_adt
  # resolves the registered Slice LangItems TypeId.
  let slice_size = type_size(&builtin_adt(&type_env_new(), "Slice".to_string(), [Type::Int]), &empty_layout)
  if slice_size == 16 then
    println("   Slice[T]: size=16 ({ptr, len} view)")
    passed = passed + 1
  else
    println("   Slice[T]: expected size=16, got " + slice_size.to_string())
    failed = failed + 1
  end

  println("")
  println("ABI version info:")
  println("  Edition: 2026")
  println("  ABI revision: 1")
  println("  Target: " + detect_host_target().to_string())
  println("")

  println("Results: " + passed.to_string() + " passed, " + failed.to_string() + " failed")

  if failed > 0 then 1 else 0 end
end

# Dump type layouts for a source file
def abi_dump(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end

  let file = argv[2].clone()
  let source = match read_file(file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_output = parse(tokens)
  if diag_has_errors(&parse_output.diagnostics) then
    return 1
  end
  let ast = parse_output.program

  println("Type layouts for " + file + ":")
  println("==============================")
  println("")

  let empty_layout: Map[Int, Int] = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemStruct(s) then
      println("struct " + s.name.clone() + " {")
      var offset = 0
      for field in s.fields do
        let sz = type_expr_size(&field.ty)
        let al = type_expr_align(&field.ty)
        # Compute padding
        let padding = if offset % al != 0 then al - (offset % al) else 0 end
        offset = offset + padding
        println("  " + field.name.clone() + ": " + type_name(&field.ty) +
                " @ offset " + offset.to_string() + " (size=" + sz.to_string() +
                ", align=" + al.to_string() + ")")
        offset = offset + sz
      end
      let struct_align = max_field_align(&s.fields)
      let final_padding = if offset % struct_align != 0 then struct_align - (offset % struct_align) else 0 end
      offset = offset + final_padding
      println("} // total size=" + offset.to_string() + ", align=" + struct_align.to_string())
      println("")
    when ItemKind::ItemEnum(e) then
      println("enum " + e.name.clone() + " {")
      for variant in e.variants do
        println("  " + variant.name.clone())
      end
      println("} // tag size=4")
      println("")
    when _ then ()
    end
  end

  0
end

def type_expr_size(ty: TypeExpr) -> Int
  match ty.kind
  when TypeExprKind::Unit then 1
  when TypeExprKind::Never then 1
  when TypeExprKind::Named(name, _) then
    if name == "Bool" || name == "u8" || name == "i8" || name == "char" then 1
    elsif name == "u16" || name == "i16" then 2
    elsif name == "u32" || name == "i32" || name == "Float" || name == "float" || name == "f32" then 4
    elsif name == "u64" || name == "i64" || name == "USize" || name == "ISize" then 8
    else 8
    end
  when TypeExprKind::Tuple(parts) then
    var total = 0
    var max_al = 1
    for p2 in parts do
      let sz2 = type_expr_size(&p2)
      let al2 = type_expr_align(&p2)
      let pad = if total % al2 != 0 then al2 - (total % al2) else 0 end
      total = total + pad + sz2
      if al2 > max_al then max_al = al2 end
    end
    let final_pad = if total % max_al != 0 then max_al - (total % max_al) else 0 end
    total + final_pad
  when TypeExprKind::Array(elem, _) then
    let esz = type_expr_size(&elem)
    if esz > 0 then esz * 4 else 8 end
  when TypeExprKind::Slice(_) then 16
  when TypeExprKind::Ptr(_) then 8
  when TypeExprKind::PtrMut(_) then 8
  when TypeExprKind::Fn(_, _) then 8
  when _ then 8
  end  end
end

def type_expr_align(ty: TypeExpr) -> Int
  let sz = type_expr_size(ty)
  if sz == 1 then 1
  elsif sz == 2 then 2
  elsif sz <= 4 then 4
  else 8
  end
end

def max_field_align(fields: Vec[FieldDecl]) -> Int
  var max_al = 1
  for f in fields do
    let al = type_align(&f.ty)
    if al > max_al then max_al = al end
  end
  max_al
end

def type_name(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      var rendered = name.clone() + "["
      var first = true
      for arg in args do
        if !first then rendered = rendered + ", " end
        rendered = rendered + type_name(&arg)
        first = false
      end
      rendered + "]"
    end
  when TypeExprKind::Array(inner, n) then "[" + type_name(&inner) + "; " + n.to_string() + "]"
  when TypeExprKind::Slice(inner) then "[" + type_name(&inner) + "]"
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Infer then "_"
  when _ then "?"
  end  end
end

# Check ABI compatibility between two files
def abi_check(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end

  let file_a = argv[2].clone()
  let file_b = argv[3].clone()

  # Parse both files
  let ast_a = match parse_file(file_a.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  let ast_b = match parse_file(file_b.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  # Extract exported symbols from both
  let exports_a = extract_exports(&ast_a)
  let exports_b = extract_exports(&ast_b)

  var compatible = true
  var checked = 0

  println("ABI Compatibility Check: " + file_a + " vs " + file_b)
  println("========================================================")
  println("")

  # Check for removed exports
  for entry in exports_a do
    let name = entry.key
    let sig_a = entry.value
    checked = checked + 1
    match exports_b.get(&name)
    when Option::Some(sig_b) then
      if sig_a != sig_b then
        println(" " + name + ": signature changed")
        println("    was: " + sig_a)
        println("    now: " + sig_b)
        compatible = false
      else
        println(" " + name)
      end
    when Option::None then
      println(" " + name + ": removed (breaking change)")
      compatible = false
    end
  end

  # Check for new exports (non-breaking but reported)
  for entry in exports_b do
    let name = entry.key
    if !exports_a.contains_key(&name) then
      println("+ " + name + ": new export")
    end
  end

  println("")
  println("Checked " + checked.to_string() + " exports.")
  
  if compatible then
    println("Result: ABI compatible ")
    0
  else
    println("Result: ABI INCOMPATIBLE ")
    1
  end
end

def parse_file(path: String) -> Result[Program, String]
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err("Cannot read " + path + ": " + e)
  end
  # The ONE parse entry: the complete structured diagnostic set, never a
  # bare "Parse error in..." summary.
  match parse_source_program(source, path.clone())
  when Result::Ok(ast) then Result::Ok(ast)
  when Result::Err(diags) then Result::Err(join_diagnostics(&diags))
  end
end

def extract_exports(ast: Program) -> Map[String, String]
  var exports = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let sig = function_signature(&f)
        exports.insert(f.name.clone(), sig)
      end
    when _ then ()
    end
  end
  exports
end

def function_signature(f: FunctionDecl) -> String
  var sig = "("
  var first = true
  for p in f.params do
    if !first then sig = sig + ", " end
    match p.ty
    when Option::Some(t) then sig = sig + type_name(t)
    when Option::None then sig = sig + "?"
    end
    first = false
  end
  sig = sig + ") -> "
  match f.ret_type
  when Option::Some(rt) then sig = sig + type_name(rt)
  when Option::None then sig = sig + "Unit"
  end
  sig
end

# 
# Build Cache Persistence
# 

def load_build_cache(output_dir: String) -> IncrementalCache
  let cache_path = output_dir.clone() + "/.tg_cache"
  
  match read_file(cache_path)
  when Result::Ok(content) then
    var cache = cache_new(output_dir.clone())
    
    # Parse cache file: each line is "path|source_hash|mir_hash|timestamp"
    for line in content.lines() do
      let trimmed = line.trim()
      if trimmed.is_empty() || trimmed.starts_with("#") then next end
      
      let parts = trimmed.split("|")
      if parts.len() >= 4 then
        let path = parts[0].to_string()
        let source_hash = parts[1].to_string()
        let mir_hash = parts[2].to_string()
        let timestamp = match parts[3].parse_int()
        when Result::Ok(t) then t
        when Result::Err(_) then 0
        end
        
        cache.entries.insert(path, CacheEntry {
          source_hash: source_hash,
          mir_hash: mir_hash,
          timestamp: timestamp
        })
      end
    end
    
    cache
  when Result::Err(_) then
    cache_new(output_dir.clone())
  end
end

def save_build_cache(cache: IncrementalCache) -> Unit
  let cache_path = cache.cache_dir.clone() + "/.tg_cache"
  mkdir_p(&cache.cache_dir)
  
  var content = "# Tangerine build cache v1\n".to_string()
  
  for entry in cache.entries do
    content = content + entry.0.clone() + "|"
    content = content + entry.1.source_hash.clone() + "|"
    content = content + entry.1.mir_hash.clone() + "|"
    content = content + entry.1.timestamp.to_string() + "\n"
  end
  
  match write_file(cache_path, content)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

# 
# LSP Support
# 

struct LspServer
  documents: Map[String, String]
  diagnostics: Map[String, Vec[Diagnostic]]
  asts: Map[String, Program]
  symbol_tables: Map[String, Vec[LspSymbol]]
end

struct LspSymbol
  name: String
  kind: LspSymbolKind
  span: Span
  type_str: String
  doc_comment: Option[String]
  definition_uri: Option[String]
  definition_span: Option[Span]
end

enum LspSymbolKind
  Function
  Method
  Variable
  Parameter
  Field
  Struct
  Enum
  Trait
  Module
  Constant
  Type
end

struct LspPosition
  line: UInt
  character: UInt
end

struct LspRange
  start: LspPosition
  end_pos: LspPosition
end

struct LspLocation
  uri: String
  range: LspRange
end

struct LspCompletionItem
  label: String
  kind: LspSymbolKind
  detail: Option[String]
  documentation: Option[String]
  insert_text: String
end

struct LspHoverResult
  contents: String
  range: Option[LspRange]
end

struct LspSignatureHelp
  signatures: Vec[LspSignature]
  active_signature: UInt
  active_parameter: UInt
end

struct LspSignature
  label: String
  documentation: Option[String]
  parameters: Vec[LspParameterInfo]
end

struct LspParameterInfo
  label: String
  documentation: Option[String]
end

struct LspCodeAction
  title: String
  kind: String
  diagnostics: Vec[Diagnostic]
  edit: Option[LspTextEdit]
end

struct LspTextEdit
  uri: String
  range: LspRange
  new_text: String
end

def lsp_server_new() -> LspServer
  LspServer {
    documents: Map::new(),
    diagnostics: Map::new(),
    asts: Map::new(),
    symbol_tables: Map::new()
  }
end

def lsp_did_open(inout server: LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_did_change(inout server: LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_check_document(inout server: LspServer, uri: String) -> Unit
  match server.documents.get(uri.clone())
  when Option::Some(content) then
    let tokens = tokenize(content, uri.clone())
    let parse_out = parse(tokens)
    var ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    assign_node_ids(&mut ast)
    
    var diags = Vec::new()
    
    # Convert parse diagnostics
    for pd in parse_diags do
      diags.push(Diagnostic {
        level: DiagLevel::Error,
        message: pd.message,
        span: Option::Some(pd.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
    
    if !diag_has_errors(&parse_diags) then
      # Build symbol table for the document
      let symbols = build_symbol_table(&ast, uri.clone())
      server.symbol_tables.insert(uri.clone(), symbols)
      server.asts.insert(uri.clone(), ast.clone())
      
      match resolve_names(&ast)
      when Result::Ok(res) then
        var env = type_env_new()
        let type_result = type_check_typed(&mut env, &ast, &res)
        for err in type_result.errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end
        
 # (ONE TypedCFG): this LSP diagnostic path builds the CFG
        # ONCE here (the pipeline's analyze_parsed does the same for real
        # compilations) and passes the same instance to both checkers.
 # ONE AnalysisContext per document compilation — the access
        # registry and the accumulators live in it, so concurrent/parallel
        # LSP documents never share process-global checker state.
        let diag_cfg = build_typed_cfg(&ast, &type_result.program.typed)
        var diag_ctx = analysis_context_new()
        let access_errors = access_check(&ast, &type_result.program.typed, &diag_cfg, &mut diag_ctx)
        for err in access_errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end

        var diag_engine = type_result.program.engine_snapshot
        let res_result = resource_check(&ast, &type_result.program.typed, &diag_cfg, &mut diag_ctx, &mut diag_engine)
        for err in res_result.errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end
      when Result::Err(res_errors) then
        for re in res_errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: re.message,
            span: Option::Some(re.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::Some("E0405")
          })
        end
      end
    end
    
    server.diagnostics.insert(uri, diags)
  when Option::None then ()
  end  end
end

# 
# LSP: Hover
# 

def lsp_hover(server: LspServer, uri: String, position: LspPosition) -> Option[LspHoverResult]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find symbol at offset
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      var hover_text = "```tangerine\n"
      
      match symbol.kind
      when LspSymbolKind::Function | LspSymbolKind::Method then
        hover_text = hover_text + "def " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Variable | LspSymbolKind::Parameter then
        hover_text = hover_text + "let " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Struct then
        hover_text = hover_text + "struct " + symbol.name
      when LspSymbolKind::Enum then
        hover_text = hover_text + "enum " + symbol.name
      when LspSymbolKind::Trait then
        hover_text = hover_text + "trait " + symbol.name
      when LspSymbolKind::Field then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Constant then
        hover_text = hover_text + "const " + symbol.name + ": " + symbol.type_str
      when _ then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      end
      
      hover_text = hover_text + "\n```"
      
      # Add doc comment if present
      match symbol.doc_comment
      when Option::Some(doc) then
        hover_text = hover_text + "\n\n---\n\n" + doc
      when Option::None then ()
      end
      
      let range = span_to_lsp_range(content, symbol.span)
      Option::Some(LspHoverResult {
        contents: hover_text,
        range: Option::Some(range)
      })
    end
  end  end
end

# 
# LSP: Completion
# 

def lsp_completion(server: LspServer, uri: String, position: LspPosition) -> Vec[LspCompletionItem]
  var items = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return items
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Get the prefix being typed
    let prefix = get_completion_prefix(content, offset)
    
    # Collect all visible symbols
    match server.symbol_tables.get(uri.clone())
    when Option::Some(symbols) then
      for sym in symbols do
        if sym.name.starts_with(prefix.clone()) then
          items.push(LspCompletionItem {
            label: sym.name.clone(),
            kind: sym.kind,
            detail: Option::Some(sym.type_str.clone()),
            documentation: sym.doc_comment.clone(),
            insert_text: sym.name.clone()
          })
        end
      end
    when Option::None then ()
    end
    
    # Add keyword completions
    let keywords = ["def", "struct", "enum", "trait", "impl", "use", "pub",
                    "let", "mut", "if", "unless", "elsif", "else", "match", "when",
                    "for", "while", "until", "loop", "break", "next", "return",
                    "true", "false", "self", "Self", "in", "do", "end",
                    "then", "module", "type", "where", "as", "unsafe",
                    "extern", "async", "await"]
    
    for kw in keywords do
      if kw.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: kw.to_string(),
          kind: LspSymbolKind::Module,  # Keyword kind
          detail: Option::Some("keyword".to_string()),
          documentation: Option::None,
          insert_text: kw.to_string()
        })
      end
    end
    
    # Add type completions from builtins
    let builtin_types = ["Int", "UInt", "Float", "Bool", "String", "Char",
                         "Unit", "Never", "Option", "Result", "Vec", "Map",
                         "Set", "Ptr", "Array"]
    
    for ty in builtin_types do
      if ty.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: ty.to_string(),
          kind: LspSymbolKind::Type,
          detail: Option::Some("type".to_string()),
          documentation: Option::None,
          insert_text: ty.to_string()
        })
      end
    end
  end
  
  items
end

# 
# LSP: Go to Definition
# 

def lsp_goto_definition(server: LspServer, uri: String, position: LspPosition) -> Option[LspLocation]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      # Check if this symbol has a known definition location
      match symbol.definition_uri
      when Option::Some(def_uri) then
        match symbol.definition_span
        when Option::Some(def_span) then
          # Resolve the definition content for range conversion
          match server.documents.get(def_uri.clone())
          when Option::Some(def_content) then
            let range = span_to_lsp_range(def_content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          when Option::None then
            # Same document
            let range = span_to_lsp_range(content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          end
        when Option::None then Option::None
        end
      when Option::None then
        # Definition is in same file  search by name
        match find_definition_in_document(server, uri.clone(), symbol.name.clone())
        when Option::Some(def_symbol) then
          let range = span_to_lsp_range(content, def_symbol.span)
          Option::Some(LspLocation { uri: uri, range: range })
        when Option::None then Option::None
        end
      end
    end
  end  end
end

# 
# LSP: References
# 

def lsp_references(server: LspServer, uri: String, position: LspPosition, include_declaration: Bool) -> Vec[LspLocation]
  var locations = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return locations
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then return locations
    when Option::Some(target_symbol) then
      # Search all open documents for references to this symbol
      for entry in server.symbol_tables do
        let doc_uri = entry.key
        let symbols = entry.value
        
        match server.documents.get(doc_uri.clone())
        when Option::Some(doc_content) then
          for sym in symbols do
            if sym.name == target_symbol.name then
              let is_declaration = match sym.kind
                  when LspSymbolKind::Function then true
                  when LspSymbolKind::Struct then true
                  when LspSymbolKind::Enum then true
                  when LspSymbolKind::Trait then true
                  when LspSymbolKind::Method then true
                  when LspSymbolKind::Variable then true
                  when LspSymbolKind::Constant then true
                  when LspSymbolKind::Field then true
                  when LspSymbolKind::Type then true
                  when LspSymbolKind::Module then true
              when _ then false
              end
              
              if include_declaration || !is_declaration then
                let range = span_to_lsp_range(doc_content, sym.span)
                locations.push(LspLocation { uri: doc_uri.clone(), range: range })
              end
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  locations
end

# 
# LSP: Rename
# 

def lsp_rename(server: LspServer, uri: String, position: LspPosition, new_name: String) -> Vec[LspTextEdit]
  var edits = Vec::new()
  
  # Find all references and create edits
  let refs = lsp_references(server, uri, position, true)
  
  for loc in refs do
    edits.push(LspTextEdit {
      uri: loc.uri,
      range: loc.range,
      new_text: new_name.clone()
    })
  end
  
  edits
end

# 
# LSP: Signature Help
# 

def lsp_signature_help(server: LspServer, uri: String, position: LspPosition) -> Option[LspSignatureHelp]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find the enclosing function call
    let (func_name, active_param) = find_enclosing_call(content, offset)
    
    match func_name
    when Option::None then return Option::None
    when Option::Some(name) then
      # Look up the function signature
      match find_definition_in_document(server, uri.clone(), name.clone())
      when Option::None then Option::None
      when Option::Some(sym) then
        # Parse the type string to extract parameters
        let params = parse_function_params(sym.type_str.clone())
        
        var param_infos = Vec::new()
        for p in params do
          param_infos.push(LspParameterInfo {
            label: p.clone(),
            documentation: Option::None
          })
        end
        
        let signature = LspSignature {
          label: sym.name.clone() + ": " + sym.type_str.clone(),
          documentation: sym.doc_comment.clone(),
          parameters: param_infos
        }
        
        Option::Some(LspSignatureHelp {
          signatures: vec![signature],
          active_signature: 0,
          active_parameter: active_param
        })
      end
    end
  end  end
end

# 
# LSP: Code Actions
# 

def lsp_code_actions(server: LspServer, uri: String, range: LspRange) -> Vec[LspCodeAction]
  var actions = Vec::new()
  
  # Check if there are diagnostics in this range with suggestions
  match server.diagnostics.get(uri.clone())
  when Option::None then return actions
  when Option::Some(diags) then
    match server.documents.get(uri.clone())
    when Option::None then return actions
    when Option::Some(content) then
      let range_start = lsp_position_to_offset(content, range.start)
      let range_end = lsp_position_to_offset(content, range.end_pos)
      
      for diag in diags do
        match diag.span
        when Option::Some(span) then
          if span.start >= range_start && span.end_pos <= range_end then
            # Generate fix-it actions from suggestions
            for sugg in diag.suggestions do
              let edit_range = span_to_lsp_range(content, sugg.span)
              var action_diags = Vec::new()
              action_diags.push(diag.clone())
              actions.push(LspCodeAction {
                title: sugg.message.clone(),
                kind: "quickfix".to_string(),
                diagnostics: action_diags,
                edit: Option::Some(LspTextEdit {
                  uri: uri.clone(),
                  range: edit_range,
                  new_text: sugg.replacement.clone()
                })
              })
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  actions
end

# 
# LSP: Format Document
# 

def lsp_format(server: LspServer, uri: String) -> Option[String]
  match server.documents.get(uri)
  when Option::None then Option::None
  when Option::Some(content) then
    let config = default_format_config()
    match format_source(content.clone(), &config)
    when Result::Ok(formatted) then Option::Some(formatted)
    when Result::Err(_e) then Option::Some(content.clone())
    end
  end  end
end

# 
# LSP: Main Loop (JSON-RPC over stdio)
# 

def lsp_main_loop(inout server: LspServer) -> Unit
  # LSP protocol: read Content-Length header, then JSON-RPC body
  loop
    # Read header
    let header = read_lsp_header()
    match header
    when Option::None then break  # EOF
    when Option::Some(content_length) then
      # Read body
      let body = read_lsp_body(content_length)
      
      # Parse JSON-RPC request
      let response = handle_lsp_request(server, body)
      
      # Send response
      match response
      when Option::Some(resp) then
        send_lsp_response(resp)
      when Option::None then ()
      end
    end
  end
end

def read_lsp_header() -> Option[UInt]
  # Read "Content-Length: N\r\n\r\n"
  var header = ""
  loop
    let line = read_line().unwrap_or("")
    if line.is_empty() then break end
    header = header + line + "\n"
    if line == "\r" || line == "" then break end
  end
  
  # Parse Content-Length
  for line in header.lines() do
    if line.starts_with("Content-Length:") then
      let val = line.slice(15, line.len()).trim()
      return Option::Some(val.parse_uint().unwrap_or(0))
    end
  end
  
  Option::None
end

def read_lsp_body(length: UInt) -> String
  var bytes = Vec::with_capacity(length)
  var i = 0
  while i < length do
    bytes.push(0u8)
    i = i + 1
  end
  let n = std::fs::read(0, bytes.as_mut_ptr(), length as Int)
  if n as UInt < length then
    # Handle partial read or error
    ()
  end
  String::from_bytes(bytes)
end

def read_line_impl() -> String
  match std::io::read_line()
  when Result::Ok(s) then s
  when Result::Err(_) then ""
  end  end
end

def read_bytes_impl(n: UInt) -> String
  var bytes = Vec::with_capacity(n)
  var i = 0
  while i < n do
    bytes.push(0)
    i = i + 1
  end
  let read_count = std::fs::read(0, bytes.as_ptr(), n as Int)
  if read_count <= 0 then
    return ""
  end
  String::from_bytes(bytes.slice(0, read_count as Int))
end

def send_lsp_response(body: String) -> Unit
  let header = "Content-Length: " + body.len().to_string() + "\r\n\r\n"
  print(header + body)
end

def handle_lsp_request(inout server: LspServer, body: String) -> Option[String]
  # Minimal JSON-RPC parsing
  let method = extract_json_string(body.clone(), "method")
  let id = extract_json_value(body.clone(), "id")
  
  match method
  when Option::None then Option::None
  when Option::Some(m) then
    if m == "initialize" then
      # Send capabilities
      let result = "{\"capabilities\":{" +
        "\"textDocumentSync\":1," +
        "\"hoverProvider\":true," +
        "\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]}," +
        "\"definitionProvider\":true," +
        "\"referencesProvider\":true," +
        "\"renameProvider\":true," +
        "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}," +
        "\"documentFormattingProvider\":true," +
        "\"codeActionProvider\":true" +
        "},\"serverInfo\":{\"name\":\"tangerine-ls\",\"version\":\"" + VERSION + "\"}}"
      make_json_rpc_response(id, result)
    elsif m == "initialized" then
      Option::None  # Notification, no response
    elsif m == "textDocument/didOpen" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let text = extract_nested_json_string(body.clone(), "textDocument", "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_open(server, u, t)
      when _ then ()
      end
      Option::None  # Notification
    elsif m == "textDocument/didChange" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      # Get full content from contentChanges[0].text
      let text = extract_json_string(body.clone(), "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_change(server, u, t)
      when _ then ()
      end
      Option::None
    elsif m == "textDocument/hover" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_hover(server, u, pos)
        when Option::Some(hover) then
          let result = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" +
            json_escape(hover.contents) + "\"}}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/completion" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let items = lsp_completion(server, u, pos)
        var result = "{\"isIncomplete\":false,\"items\":["
        var first = true
        for item in items do
          if !first then result = result + "," end
          result = result + "{\"label\":\"" + json_escape(item.label) + "\""
          match item.detail
          when Option::Some(d) then
            result = result + ",\"detail\":\"" + json_escape(d) + "\""
          when Option::None then ()
          end
          result = result + ",\"insertText\":\"" + json_escape(item.insert_text) + "\"}"
          first = false
        end
        result = result + "]}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "{\"isIncomplete\":false,\"items\":[]}".to_string())
      end
    elsif m == "textDocument/definition" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_goto_definition(server, u, pos)
        when Option::Some(loc) then
          let result = "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/references" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let refs = lsp_references(server, u, pos, true)
        var result = "["
        var first = true
        for loc in refs do
          if !first then result = result + "," end
          result = result + "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          first = false
        end
        result = result + "]"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "textDocument/rename" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      let new_name = extract_json_string(body.clone(), "newName")
      match (uri, line, character, new_name)
      when (Option::Some(u), Option::Some(l), Option::Some(c), Option::Some(name)) then
        let pos = LspPosition { line: l, character: c }
        let edits = lsp_rename(server, u, pos, name)
        # Group edits by URI
        var changes = Map::new()
        for edit in edits do
          match changes.get(edit.uri.clone())
          when Option::Some(existing) then
            existing.push(edit)
          when Option::None then
            var first_edits = Vec::new()
            first_edits.push(edit)
            changes.insert(edit.uri.clone(), first_edits)
          end
        end
        
        var result = "{\"changes\":{"
        var first_uri = true
        for entry in changes do
          if !first_uri then result = result + "," end
          result = result + "\"" + json_escape(entry.key) + "\":["
          var first_edit = true
          for edit in entry.value do
            if !first_edit then result = result + "," end
            result = result + "{\"range\":" + lsp_range_to_json(&edit.range) + ","
            result = result + "\"newText\":\"" + json_escape(edit.new_text) + "\"}"
            first_edit = false
          end
          result = result + "]"
          first_uri = false
        end
        result = result + "}}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/signatureHelp" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_signature_help(server, u, pos)
        when Option::Some(help) then
          var result = "{\"signatures\":["
          var first = true
          for sig in help.signatures do
            if !first then result = result + "," end
            result = result + "{\"label\":\"" + json_escape(sig.label) + "\""
            result = result + ",\"parameters\":["
            var first_p = true
            for p in sig.parameters do
              if !first_p then result = result + "," end
              result = result + "{\"label\":\"" + json_escape(p.label) + "\"}"
              first_p = false
            end
            result = result + "]}"
            first = false
          end
          result = result + "],\"activeSignature\":" + help.active_signature.to_string()
          result = result + ",\"activeParameter\":" + help.active_parameter.to_string() + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/formatting" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      match uri
      when Option::Some(u) then
        match lsp_format(server, u.clone())
        when Option::Some(formatted) then
          match server.documents.get(u)
          when Option::Some(content) then
            let total_lines = count_lines(content)
            let end_col = last_line_length(content)
            let range = LspRange {
              start: LspPosition { line: 0, character: 0 },
              end_pos: LspPosition { line: total_lines, character: end_col }
            }
            let result = "[{\"range\":" + lsp_range_to_json(&range) + "," +
              "\"newText\":\"" + json_escape(formatted) + "\"}]"
            make_json_rpc_response(id, result)
          when Option::None then
            make_json_rpc_response(id, "[]".to_string())
          end
        when Option::None then
          make_json_rpc_response(id, "[]".to_string())
        end
      when Option::None then
        make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "textDocument/diagnostic" then
      # The LSP 3.17 pull-diagnostics request: the diagnostics the
      # document compilation computed at didOpen/didChange (the real
      # spans — the byte offsets converted to the LSP position units).
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      match uri
      when Option::Some(u) then
        let content = match server.documents.get(u.clone())
        when Option::Some(c) then c
        when Option::None then "".to_string()
        end
        let diags = match server.diagnostics.get(u.clone())
        when Option::Some(list) then list
        when Option::None then Vec::new()
        end
        var result = "{\"kind\":\"full\",\"items\":["
        var first_d = true
        for d in diags do
          if !first_d then result = result + "," end
          var range_json = "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}"
          match d.span
          when Option::Some(sp) then
            let rng = span_to_lsp_range(&content, sp)
            range_json = lsp_range_to_json(&rng)
          when Option::None then ()
          end
          let severity = match d.level
          when DiagLevel::Error then 1
          when DiagLevel::Warning then 2
          when _ then 3
          end
          result = result + "{\"range\":" + range_json + ",\"severity\":" + severity.to_string() +
            ",\"source\":\"tangerine\",\"message\":\"" + json_escape(d.message) + "\"}"
          first_d = false
        end
        result = result + "]}"
        make_json_rpc_response(id, result)
      when Option::None then
        make_json_rpc_response(id, "{\"kind\":\"full\",\"items\":[]}".to_string())
      end
    elsif m == "shutdown" then
      make_json_rpc_response(id, "null".to_string())
    elsif m == "exit" then
      Option::None  # Exit the loop
    else
      # Unknown method
      Option::None
    end
  end
end

# 
# LSP Helpers
# 

def build_symbol_table(ast: Program, uri: String) -> Vec[LspSymbol]
  var symbols = Vec::new()
  
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(func) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: func.name.clone(),
        kind: LspSymbolKind::Function,
        span: item.span,
        type_str: format_function_type(&func),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      # Add parameters
      for param in func.params do
        let param_type_str = match param.ty
          when Option::Some(t) then fmt_type_expr_to_string(t)
          when Option::None then "?"
        end
        symbols.push(LspSymbol {
          name: param.name.clone(),
          kind: LspSymbolKind::Parameter,
          span: param.span,
          type_str: param_type_str,
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(param.span)
        })
      end
    when ItemKind::ItemStruct(s) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: s.name.clone(),
        kind: LspSymbolKind::Struct,
        span: item.span,
        type_str: s.name.clone(),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for field in s.fields do
        symbols.push(LspSymbol {
          name: field.name.clone(),
          kind: LspSymbolKind::Field,
          span: field.span,
          type_str: fmt_type_expr_to_string(&field.ty),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(field.span)
        })
      end
    when ItemKind::ItemEnum(e) then
      symbols.push(LspSymbol {
        name: e.name.clone(),
        kind: LspSymbolKind::Enum,
        span: item.span,
        type_str: e.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when ItemKind::ItemTrait(t) then
      symbols.push(LspSymbol {
        name: t.name.clone(),
        kind: LspSymbolKind::Trait,
        span: item.span,
        type_str: t.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for method in t.methods do
        symbols.push(LspSymbol {
          name: method.sig.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_sig_type(&method.sig),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::ItemImpl(imp) then
      for method in imp.methods do
        symbols.push(LspSymbol {
          name: method.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_type(&method),
          doc_comment: extract_doc_comment_before(ast, method.span),
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::ItemConst(c) then
      symbols.push(LspSymbol {
        name: c.name.clone(),
        kind: LspSymbolKind::Constant,
        span: item.span,
        type_str: match c.ty
          when Option::Some(t) then fmt_type_expr_to_string(&t)
          when Option::None then "?"
        end,
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when _ then ()
    end
  end
  
  symbols
end

def find_symbol_at(server: LspServer, uri: String, offset: UInt) -> Option[LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    # Find the most specific (smallest span) symbol containing the offset
    var best: Option[LspSymbol] = Option::None
    var best_span_size: UInt = 18446744073709551615u64
    
    for sym in symbols do
      if offset >= sym.span.start && offset <= sym.span.end_pos then
        let span_size = sym.span.end_pos - sym.span.start
        if span_size < best_span_size then
          best = Option::Some(sym)
          best_span_size = span_size
        end
      end
    end
    
    best
  end  end
end

def find_definition_in_document(server: LspServer, uri: String, name: String) -> Option[LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    for sym in symbols do
      if sym.name == name then
        match sym.kind
        when LspSymbolKind::Function then
          return Option::Some(sym)
        when LspSymbolKind::Struct then
          return Option::Some(sym)
        when LspSymbolKind::Enum then
          return Option::Some(sym)
        when LspSymbolKind::Trait then
          return Option::Some(sym)
        when LspSymbolKind::Constant then
          return Option::Some(sym)
        when _ then ()
        end
      end
    end
    Option::None
  end  end
end

def position_to_offset(content: String, pos: LspPosition) -> UInt
  lsp_position_to_offset(content, pos)
end

def lsp_position_to_offset(content: String, pos: LspPosition) -> UInt
  var offset: UInt = 0
  var line: UInt = 0
  
  while offset < content.len() && line < pos.line do
    if content.char_at(offset) == '\n' then
      line = line + 1
    end
    offset = offset + 1
  end
  
  offset + pos.character
end

def span_to_lsp_range(content: String, span: Span) -> LspRange
  let start = offset_to_lsp_position(content, span.start)
  let end_pos = offset_to_lsp_position(content, span.end_pos)
  LspRange { start: start, end_pos: end_pos }
end

def offset_to_lsp_position(content: String, offset: UInt) -> LspPosition
  var line: UInt = 0
  var col: UInt = 0
  var i: UInt = 0
  
  while i < offset && i < content.len() do
    if content.char_at(i) == '\n' then
      line = line + 1
      col = 0
    else
      col = col + 1
    end
    i = i + 1
  end
  
  LspPosition { line: line, character: col }
end

def get_completion_prefix(content: String, offset: UInt) -> String
  # Walk backwards from offset to find identifier start
  var start = offset
  while start > 0 do
    let c = content.char_at(start - 1)
    if c.is_alphanumeric() || c == '_' then
      start = start - 1
    else
      break
    end
  end
  
  if start < offset then
    content.slice(start, offset)
  else
    "".to_string()
  end
end

def find_enclosing_call(content: String, offset: UInt) -> (Option[String], UInt)
  # Walk backwards from offset to find the function name before '('
  var depth = 0
  var param_count: UInt = 0
  var i = offset
  var in_string = false
  var in_char = false
  
  while i > 0 do
    i = i - 1
    let c = content.char_at(i)
    
    # Track string/char literal boundaries (backward scan)
    # Skip escaped quotes by checking if preceded by backslash
    if c == '"' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_string = !in_string
      next
    end
    if c == '\'' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_char = !in_char
      next
    end
    if in_string || in_char then next end
    
    if c == ')' then depth = depth + 1
    elsif c == '(' then
      if depth == 0 then
        # Found the opening paren  get function name before it
        var end_pos = i
        while end_pos > 0 && (content.char_at(end_pos - 1).is_alphanumeric() || content.char_at(end_pos - 1) == '_') do
          end_pos = end_pos - 1
        end
        if end_pos < i then
          let name = content.slice(end_pos, i)
          return (Option::Some(name), param_count)
        end
        return (Option::None, 0)
      end
      depth = depth - 1
    elsif c == ',' && depth == 0 then
      param_count = param_count + 1
    end
  end
  
  (Option::None, 0)
end

def parse_function_params(type_str: String) -> Vec[String]
  # Parse "(T1, T2) -> R" format
  var params = Vec::new()
  
  if !type_str.starts_with("(") then return params end
  
  let close = type_str.index_of(")")
  match close
  when Option::None then return params
  when Option::Some(idx) then
    let inner = type_str.slice(1, idx)
    if inner.is_empty() then return params end
    
    for part in inner.split(",") do
      params.push(part.trim().to_string())
    end
  end
  
  params
end

def format_function_type(func: FunctionDecl) -> String
  var result = "("
  var first = true
  for param in func.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then fmt_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match func.ret_type
  when Option::Some(rt) then result = result + fmt_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def format_function_sig_type(sig: FunctionSig) -> String
  var result = "("
  var first = true
  for param in sig.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then fmt_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match sig.ret_type
  when Option::Some(rt) then result = result + fmt_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def extract_doc_comment_before(ast: Program, span: Span) -> Option[String]
  # Program does not carry the source text, so doc-comment extraction cannot
  # scan backwards from the span. Return None (LSP doc comments are optional);
  # the extraction can be re-enabled when Program carries source text.
  Option::None
end
def make_json_rpc_response(id: Option[String], result: String) -> Option[String]
  match id
  when Option::None then Option::None
  when Option::Some(req_id) then
    Option::Some("{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":" + result + "}")
  end  end
end

def extract_json_string(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    # Skip whitespace
    var pos = start
    while pos < json.len() && (json.char_at(pos) == ' ' || json.char_at(pos) == '\t') do
      pos = pos + 1
    end
    if pos < json.len() && json.char_at(pos) == '"' then
      pos = pos + 1
      var end_pos = pos
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      Option::Some(json.slice(pos, end_pos))
    else
      Option::None
    end
  end
end

def extract_json_value(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    var pos = start
    while pos < json.len() && json.char_at(pos) == ' ' do pos = pos + 1 end
    
    var end_pos = pos
    let first_char = json.char_at(pos)
    if first_char == '"' then
      # String value
      end_pos = pos + 1
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      end_pos = end_pos + 1
    elsif first_char == '{' || first_char == '[' then
      # Object/array  find matching close
      var depth = 1
      end_pos = pos + 1
      while end_pos < json.len() && depth > 0 do
        let c = json.char_at(end_pos)
        if c == '{' || c == '[' then depth = depth + 1
        elsif c == '}' || c == ']' then depth = depth - 1
        end
        end_pos = end_pos + 1
      end
    else
      # Number/bool/null
      while end_pos < json.len() && json.char_at(end_pos) != ',' && json.char_at(end_pos) != '}' && json.char_at(end_pos) != ']' do
        end_pos = end_pos + 1
      end
    end
    
    Option::Some(json.slice(pos, end_pos).trim().to_string())
  end
end

def extract_nested_json_string(json: String, outer_key: String, inner_key: String) -> Option[String]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    extract_json_string(inner_json, inner_key)
  end  end
end

def extract_nested_json_uint(json: String, outer_key: String, inner_key: String) -> Option[UInt]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    match extract_json_value(inner_json, inner_key)
    when Option::None then Option::None
    when Option::Some(val) then
      Option::Some(val.parse_uint().unwrap_or(0))
    end
  end  end
end

def lsp_range_to_json(range: LspRange) -> String
  "{\"start\":{\"line\":" + range.start.line.to_string() + ",\"character\":" + range.start.character.to_string() + "}," +
  "\"end\":{\"line\":" + range.end_pos.line.to_string() + ",\"character\":" + range.end_pos.character.to_string() + "}}"
end

def count_lines(content: String) -> UInt
  var count: UInt = 0
  for c in content.chars() do
    if c == '\n' then count = count + 1 end
  end
  count
end

def last_line_length(content: String) -> UInt
  var len: UInt = 0
  var i = content.len()
  while i > 0 do
    i = i - 1
    if content.char_at(i) == '\n' then break end
    len = len + 1
  end
  len
end
