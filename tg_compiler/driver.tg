# Home directory helper
extern def libc_getenv(name: Ptr[u8]) -> Ptr[u8]
# Vec[String] clone under the T: Clone surface — the element-wise loop form
# (Array::clone is Copy-gated; String is Clone-not-Copy).
def clone_vec_strings(src: Vec[String]) -> Vec[String]
  var out = Vec::new()
  var i = 0
  while i < src.len() do
    out.push(src[i].clone())
    i = i + 1
  end
  out
end

def home_dir() -> String
  let result = libc_getenv("HOME\0".as_ptr())
  if result as Int == 0 then
    "/tmp".to_string()
  else
    String::from_cstr(result)
  end
end

