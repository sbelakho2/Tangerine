# 
# Subcommand: init
# 

def cmd_init(argv: Vec[String]) -> Int
  let project_name = if argv.len() > 1 then
    argv[1].clone()
  else
    "my_project".to_string()
  end
  
  # Create project directory structure
  match std::fs::create_dir(project_name.clone())
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  match std::fs::create_dir(project_name.clone() + "/src")
  when Result::Err(_) then ()
  when Result::Ok(_) then ()
  end
  
  # Write Tangerine.toml
  let manifest = "[package]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
  match write_file(project_name.clone() + "/Tangerine.toml", manifest)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  # Write src/main.tg
  let main_content = "# " + project_name + "\n\ndef main() -> Int\n  println(\"Hello from " + project_name + "!\")\n  0\nend\n"
  match write_file(project_name.clone() + "/src/main.tg", main_content)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  println("Created project '" + project_name + "'")
  println("  " + project_name + "/Tangerine.toml")
  println("  " + project_name + "/src/main.tg")
  0
end

# 
# Subcommand: compile (raw, no subcommand)
# 

def cmd_compile(argv: Vec[String]) -> Int
  var stage2_probe = false
  var probe_i: UInt = 0
  while probe_i < argv.len() do
    if argv[probe_i].ends_with("tg_stage2") then
      stage2_probe = true
    end
    probe_i = probe_i + 1
  end

  let opts = match parse_startup_compile_args(true)
  when Result::Ok(o) then
    o
  when Result::Err(e) then
    if stage2_probe then
      panic("cmd_compile parse err: " + e)
    end
    if e == "help" || e == "version" then
      return 0
    end
    println(e)
    return 1
  end

  let argc = raw_arg_count()
  var files: Vec[String] = Vec::new()
  var arg_i = 2
  while arg_i < argc do
    let arg = raw_arg_copy(arg_i)
    if arg == "-o" || arg == "--output" || arg == "--emit" || arg == "--target" || arg == "--mode" then
      arg_i = arg_i + 2
    elsif arg.starts_with("-") then
      arg_i = arg_i + 1
    else
      files.push(arg)
      arg_i = arg_i + 1
    end
  end

  if files.len() == 0 then
    println("No input files")
    return 1
  end

  var output_path = "".to_string()
  var out_i = 2
  while out_i < argc do
    let arg = raw_arg_copy(out_i)
    if arg == "-o" || arg == "--output" then
      out_i = out_i + 1
      if out_i < argc then
        output_path = raw_arg_copy(out_i)
      end
      break
    end
    out_i = out_i + 1
  end

  if output_path.len() == 0 then
    output_path = match opts.emit
    when EmitMode::Object then get_output_path(&opts, files[0].clone(), ".o")
    when EmitMode::Executable then get_output_path(&opts, files[0].clone(), "")
    when _ then "".to_string()
    end
  end

  if files.len() == 1 then
    compile_startup_entry(&opts, files[0].clone(), output_path)
  else
    compile_multiple_files(&opts, files, output_path)
  end
end


def cmd_compile_direct(skip_subcommand: Bool) -> Int
  # Bypass Result return — parse args and compile in same function scope
  var opts = default_options()
  var primary_input = "".to_string()
  var input_count = 0
  let argc = raw_arg_count()
  var i = if skip_subcommand then 2 else 1 end

  while i < argc do
    let arg = raw_arg_unchecked(i)

    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argc then
        println("Missing argument for -o")
        return 1
      end
      opts.output_file = Option::Some(raw_arg_unchecked(i))
    elsif arg == "--emit" then
      i = i + 1
    elsif arg == "--verbose" || arg == "-v" then
      opts.verbose = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      opts.debug_info = true
    elsif arg == "--target" then
      i = i + 1
      if i >= argc then
        println("Missing argument for --target")
        return 1
      end
      opts.target_triple = Option::Some(raw_arg_unchecked(i))
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return 0
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return 0
    elsif arg.starts_with("-") then
      println("Unknown option: " + arg)
      return 1
    else
      if input_count == 0 then
        primary_input = arg.clone()
      end
      input_count = input_count + 1
    end

    i = i + 1
  end

  if input_count == 0 then
    println("No input files")
    return 1
  end

  if input_count > 1 then
    println("Multiple input files are not supported in raw compile mode")
    return 1
  end

  let file = primary_input.clone()
  let output_path = match opts.emit
  when EmitMode::Object then get_output_path(&opts, file.clone(), ".o")
  when EmitMode::Executable then get_output_path(&opts, file.clone(), "")
  when _ then "".to_string()
  end

  if output_path.len() > 0 && file_exists(output_path.clone()) then
    let _ = delete_file(output_path.clone())
  end

  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  match compile_file_core(file.clone(), &opts, &mut emitter)
  when Result::Ok(_) then
    0
  when Result::Err(e) then
    eprintln(e)
    1
  end
end

def cmd_compile_raw(skip_subcommand: Bool) -> Int
  cmd_compile_direct(skip_subcommand)
end

# Helper: find all .tg files recursively
def find_tg_files(dir: String) -> Vec[String]
  var files = Vec::new()
  let entries = match std::fs::read_dir(dir)
  when Result::Ok(entries) then entries
  when Result::Err(_) then return files
  end
  
  for entry in entries do
    if entry.is_dir && !entry.name.starts_with(".") && entry.name != "target" then
      let sub = find_tg_files(entry.path.clone())
      for f in sub do files.push(f) end
    elsif entry.name.ends_with(".tg") then
      files.push(entry.path.clone())
    end
  end
  
  files
end


# 
# Incremental Compilation Support
# 

struct IncrementalCache
  entries: Map[String, CacheEntry]
  cache_dir: String
end

struct CacheEntry
  source_hash: String
  mir_hash: String
  timestamp: Int
end

def cache_new(dir: String) -> IncrementalCache
  IncrementalCache {
    entries: Map::new(),
    cache_dir: dir
  }
end

def is_stale(cache: &IncrementalCache, path: String, source: String) -> Bool
  match cache.entries.get(path)
  when Option::Some(entry) then
    let current_hash = fnv1a_hash(source).to_string()
    entry.source_hash != current_hash
  when Option::None then
    true
  end
end

def update_cache(cache: &mut IncrementalCache, path: String, source: String, mir_hash: String) -> Unit
  let source_hash = fnv1a_hash(source).to_string()
  cache.entries.insert(path, CacheEntry {
    source_hash: source_hash,
    mir_hash: mir_hash,
    timestamp: current_time()
  })
end

def current_time() -> Int
  # Return seconds since Unix epoch via std::time.
  let now = std::time::SystemTime::now()
  now.tv.tv_sec as Int
end

def bootstrap_call_system(cmd: String) -> Int
  # Use the safe std::process::Command API instead of raw FFI system().
  # Split the command string at the first space to get program + args.
  var command = std::process::Command::new("sh".to_string())
  command.arg("-c".to_string())
  command.arg(cmd)
  match command.status()
  when Result::Ok(status) then status.code
  when Result::Err(_) then 127
  end
end

# Local bootstrap-safe project metadata types.
struct Dependency
  name: String
  version: String
  requirement: Option[String]
  registry: Option[String]
  features: Array[String]
  optional: Bool
  dev_only: Bool
  path: Option[String]
  git: Option[String]
end

struct Project
  name: String
  version: String
  dependencies: Vec[Dependency]
  sources: Vec[String]
  output_dir: String
end

# 
# Build System Integration
# 

def load_project(path: String) -> Result[Project, String]
  # Parse a Tangerine.toml project manifest file.
  # Expected format:
  #   [project]
  #   name = "my_app"
  #   version = "0.1.0"
  #   
  #   [sources]
  #   files = ["src/main.tg", "src/lib.tg"]
  #   
  #   [dependencies]
  #   http = { version = "1.0", path = "../http" }
  
  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end
  
  match read_file(manifest_path.clone())
  when Result::Ok(content) then
    # Simple TOML-like parser for the project manifest
    var name = "untitled"
    var version = "0.0.0"
    var sources = Vec::new()
    var deps = Vec::new()
    var output_dir = "build"
    var section = ""
    var in_sources_array = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      
      # Skip comments and empty lines
      if trimmed.is_empty() || trimmed.starts_with("#") then
        next
      end
      
      # Section headers
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        section = trimmed.slice(1, trimmed.len() - 1)
        in_sources_array = false
        next
      end
      
      # Check if we're inside a multi-line sources array
      if in_sources_array then
        if trimmed.starts_with("]") then
          in_sources_array = false
          next
        end
        var entry = trimmed.to_string()
        if entry.ends_with(",") then
          entry = entry.slice(0, entry.len() - 1)
        end
        entry = entry.trim()
        var cleaned = ""
        var i = 0
        while i < entry.len() do
          let ch = entry.char_at(i)
          if ch != '"' then
            cleaned = cleaned + ch.to_string()
          end
          i = i + 1
        end
        entry = cleaned.trim()
        if !entry.is_empty() then
          sources.push(entry.to_string())
        end
        next
      end
      
      # Key-value pairs
      let parts = trimmed.split("=")
      if parts.len() >= 2 then
        let key = parts[0].trim()
        let val = parts[1].trim()
        
        if section == "project" then
          if key == "name" then name = val.trim_matches('"').to_string() end
          if key == "version" then version = val.trim_matches('"').to_string() end
          if key == "output_dir" then output_dir = val.trim_matches('"').to_string() end
        end
        
        if section == "sources" then
          if key == "files" then
            if val.starts_with("[") then
              var rest = val.slice(1, val.len())
              var closed = false
              while rest.ends_with("]") && rest.len() > 0 do
                rest = rest.slice(0, rest.len() - 1)
                closed = true
              end
              for entry in rest.split(",") do
                var src = entry.trim().to_string()
                if src.ends_with(",") && src.len() > 0 then
                  src = src.slice(0, src.len() - 1)
                end
                src = src.trim()
                var cleaned = ""
                var j = 0
                while j < src.len() do
                  let ch = src.char_at(j)
                  if ch != '"' then
                    cleaned = cleaned + ch.to_string()
                  end
                  j = j + 1
                end
                src = cleaned.trim()
                if !src.is_empty() then
                  sources.push(src.to_string())
                end
              end
              if !closed then
                in_sources_array = true
              end
            end
          end
        end
        
        if section == "dependencies" then
          # Simple dependency parsing (name = "version")
          let version_str = val.trim_matches('"')
          deps.push(Dependency {
            name: key.to_string(),
            version: version_str.to_string(),
            requirement: Option::Some(version_str.to_string()),
            registry: Option::None,
            features: Array::new(),
            optional: false,
            dev_only: false,
            path: Option::None,
            git: Option::None
          })
        end
      end
    end
    
    # Default: if no sources specified, look for src/main.tg
    if sources.is_empty() then
      sources.push("src/main.tg".to_string())
    end

    Result::Ok(Project {
      name: name.to_string(),
      version: version.to_string(),
      dependencies: deps,
      sources: sources,
      output_dir: output_dir.to_string()
    })
  when Result::Err(e) then
    Result::Err("Cannot read project manifest '" + manifest_path + "': " + e)
  end
end

def build_project(project: &Project) -> Result[Unit, String]
  let opts = default_options()
  
  # Resolve dependencies first
  let resolved = resolve_project_deps(project)?
  
  # Build dependency sources before project sources
  for dep_src in resolved.dep_sources do
    match compile_file(&opts, dep_src)
    when Result::Ok(_) then ()
    when Result::Err(e) then return Result::Err("dependency error: " + e)
    end
  end
  
  # Build cache integration
  var cache = load_build_cache(&project.output_dir)
  
  for src in project.sources do
    match read_file(src.clone())
    when Result::Ok(content) then
      if is_stale(&cache, src.clone(), content.clone()) then
        match compile_file(&opts, src.clone())
        when Result::Ok(_) then
          update_cache(&mut cache, src.clone(), content, "".to_string())
        when Result::Err(e) then return Result::Err(e)
        end
      else
        # Cache hit  skip recompilation
        ()
      end
    when Result::Err(_) then
      match compile_file(&opts, src)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
  end
  
  save_build_cache(&cache)
  Result::Ok(())
end

# 
# Dependency Resolution & DriverLockfile
# 

struct ResolvedDeps
  packages: Vec[ResolvedPackage]
  dep_sources: Vec[String]
end

struct ResolvedPackage
  name: String
  version: String
  resolved_path: String
  checksum: String
end

struct DriverLockfile
  packages: Vec[DriverLockEntry]
  metadata: Map[String, String]
  version: Int
end

struct DriverLockEntry
  name: String
  version: String
  source: String
  checksum: String
  dependencies: Vec[String]
end

def resolve_project_deps(project: &Project) -> Result[ResolvedDeps, String]
  # Load existing lockfile if present
  let lockfile = load_lockfile("Tangerine.lock")
  
  var resolved = ResolvedDeps {
    packages: Vec::new(),
    dep_sources: Vec::new()
  }
  
  for dep in project.dependencies do
    # Check lockfile first for reproducibility
    let locked_entry = match lockfile
    when Option::Some(ref lf) then find_lock_entry(lf, &dep.name)
    when Option::None then Option::None
    end
    
    # Resolve the dependency source
    let resolved_pkg = resolve_single_dep(&dep, &locked_entry)?
    
    # Collect source files from resolved dependency
    let dep_dir = resolved_pkg.resolved_path.clone()
    match discover_sources(&dep_dir)
    when Result::Ok(srcs) then
      for s in srcs do
        resolved.dep_sources.push(s)
      end
    when Result::Err(e) then
      return Result::Err("Failed to discover sources for '" + dep.name.clone() + "': " + e)
    end
    
    resolved.packages.push(resolved_pkg)
  end
  
  # Write lockfile with resolved state
  write_lockfile("Tangerine.lock", &resolved)
  
  Result::Ok(resolved)
end

def resolve_single_dep(dep: &Dependency, locked: &Option[DriverLockEntry]) -> Result[ResolvedPackage, String]
  # If a path dependency, use it directly (local development)
  match dep.path
  when Option::Some(ref p) then
    return Result::Ok(ResolvedPackage {
      name: dep.name.clone(),
      version: dep.version.clone(),
      resolved_path: p.clone(),
      checksum: hash_directory(p)
    })
  when Option::None then ()
  end
  
  # If a git dependency, clone/fetch
  match dep.git
  when Option::Some(ref url) then
    let clone_dir = ".tg_deps/" + dep.name.clone()
    
    # Check if already cloned with correct version from lockfile
    match locked
    when Option::Some(ref entry) then
      if is_dir(&clone_dir) && entry.source == url.clone() then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: clone_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
    
    # Clone the repo
    mkdir_p(".tg_deps")
    let clone_result = run_command("git", vec!["clone", "--depth", "1", url.as_str(), clone_dir.as_str()])
    
    match clone_result
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: clone_dir.clone(),
        checksum: hash_directory(&clone_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to clone '" + dep.name.clone() + "' from " + url.clone() + ": " + e)
    end
  when Option::None then ()
  end
  
  # Registry dependency  fetch from package registry
  let registry_url = "https://registry.tangerine-lang.org"
  let pkg_dir = ".tg_deps/" + dep.name.clone() + "-" + dep.version.clone()
  
  # Check if already downloaded
  if is_dir(&pkg_dir) then
    match locked
    when Option::Some(ref entry) then
      if entry.version == dep.version then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: pkg_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
  end
  
  # Download package tarball
  mkdir_p(".tg_deps")
  let fetch_url = registry_url + "/api/v1/packages/" + dep.name.clone() + "/" + dep.version.clone() + "/download"
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (pkg_dir.clone() + ".tar.gz").as_str(), fetch_url.as_str()])
  
  match fetch_result
  when Result::Ok(_) then
    # Extract tarball
    mkdir_p(&pkg_dir)
    let extract = run_command("tar", vec!["xzf", (pkg_dir.clone() + ".tar.gz").as_str(), "-C", pkg_dir.as_str()])
    match extract
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: pkg_dir.clone(),
        checksum: hash_directory(&pkg_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to extract package '" + dep.name.clone() + "': " + e)
    end
  when Result::Err(e) then
    Result::Err("Failed to fetch '" + dep.name.clone() + "@" + dep.version.clone() + "' from registry: " + e)
  end
end

def discover_sources(dir: &String) -> Result[Vec[String], String]
  # Look for Tangerine.toml in the dependency directory to find its sources.
  # If not found, glob for all .tg files under src/.
  let manifest = dir.clone() + "/Tangerine.toml"
  match load_project(manifest)
  when Result::Ok(proj) then
    var sources = Vec::new()
    for s in proj.sources do
      sources.push(dir.clone() + "/" + s)
    end
    Result::Ok(sources)
  when Result::Err(_) then
    # Fallback: find all .tg files under src/
    let src_dir = dir.clone() + "/src"
    match list_directory(src_dir.clone())
    when Result::Ok(files) then
      var sources = Vec::new()
      for f in files do
        if f.ends_with(".tg") then
          sources.push(src_dir.clone() + "/" + f)
        end
      end
      Result::Ok(sources)
    when Result::Err(_) then
      # Try root directory
      match list_directory(dir.clone())
      when Result::Ok(files) then
        var sources = Vec::new()
        for f in files do
          if f.ends_with(".tg") then
            sources.push(dir.clone() + "/" + f)
          end
        end
        Result::Ok(sources)
      when Result::Err(e) then
        Result::Err("Cannot list directory: " + e)
      end
    end
  end
end

def find_lock_entry(lf: &DriverLockfile, name: &String) -> Option[DriverLockEntry]
  for entry in lf.packages do
    if entry.name == name then
      return Option::Some(entry.clone())
    end
  end
  Option::None
end

#  DriverLockfile I/O 

def load_lockfile(path: &str) -> Option[DriverLockfile]
  match read_file(path.to_string())
  when Result::Ok(content) then
    parse_lockfile(&content)
  when Result::Err(_) then
    Option::None
  end
end

def parse_lockfile(content: &String) -> Option[DriverLockfile]
  # Format:
  #   # This file is auto-generated by tg. Do not edit.
  #   [[package]]
  #   name = "http"
  #   version = "1.0.0"
  #   source = "path:../http"
  #   checksum = "abc123"
  #   dependencies = ["core", "io"]
  
  var packages = Vec::new()
  var current_name = "".to_string()
  var current_version = "".to_string()
  var current_source = "".to_string()
  var current_checksum = "".to_string()
  var current_deps = Vec::new()
  var in_package = false
  
  for line in content.lines() do
    let trimmed = line.trim()
    
    if trimmed == "[[package]]" then
      # Flush previous package
      if in_package && !current_name.is_empty() then
        packages.push(DriverLockEntry {
          name: current_name.clone(),
          version: current_version.clone(),
          source: current_source.clone(),
          checksum: current_checksum.clone(),
          dependencies: current_deps.clone()
        })
      end
      current_name = "".to_string()
      current_version = "".to_string()
      current_source = "".to_string()
      current_checksum = "".to_string()
      current_deps = Vec::new()
      in_package = true
      next
    end
    
    if !in_package || trimmed.is_empty() || trimmed.starts_with("#") then
      next
    end
    
    match trimmed.split_once("=")
    when Option::Some(kv) then
      let key = kv.0.trim()
      let val = kv.1.trim().trim_matches('"')
      
      if key == "name" then current_name = val.to_string() end
      if key == "version" then current_version = val.to_string() end
      if key == "source" then current_source = val.to_string() end
      if key == "checksum" then current_checksum = val.to_string() end
      if key == "dependencies" then
        let arr = val.trim_matches('[').trim_matches(']')
        for dep_name in arr.split(",") do
          let d = dep_name.trim().trim_matches('"')
          if !d.is_empty() then
            current_deps.push(d.to_string())
          end
        end
      end
    when Option::None then ()
    end
  end
  
  # Flush last package
  if in_package && !current_name.is_empty() then
    packages.push(DriverLockEntry {
      name: current_name.clone(),
      version: current_version.clone(),
      source: current_source.clone(),
      checksum: current_checksum.clone(),
      dependencies: current_deps.clone()
    })
  end
  
  Option::Some(DriverLockfile {
    packages: packages,
    metadata: Map::new(),
    version: 1
  })
end

def write_lockfile(path: &str, resolved: &ResolvedDeps) -> Unit
  var out = "# This file is auto-generated by tg. Do not edit.\n".to_string()
  out = out + "# Tangerine lockfile v1\n\n"
  
  for pkg in resolved.packages do
    out = out + "[[package]]\n"
    out = out + "name = \"" + pkg.name.clone() + "\"\n"
    out = out + "version = \"" + pkg.version.clone() + "\"\n"
    out = out + "source = \"" + pkg.resolved_path.clone() + "\"\n"
    out = out + "checksum = \"" + pkg.checksum.clone() + "\"\n"
    out = out + "dependencies = []\n\n"
  end
  
  match write_file(path.to_string(), out)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

def hash_directory(dir: &String) -> String
  # Compute a content hash of all .tg files in a directory for reproducibility.
  var h: UInt = 14695981039346656037  # FNV-1a offset basis
  let prime: UInt = 1099511628211
  
  match list_directory(dir.clone())
  when Result::Ok(files) then
    var sorted = files.clone()
    sorted.sort()
    for f in sorted do
      if f.ends_with(".tg") then
        match read_file(dir.clone() + "/" + f)
        when Result::Ok(content) then
          let content_bytes: Vec[Int] = content.bytes()
          for c in content_bytes do
            h = h ^ (c as UInt)
            h = h * prime
          end
        when Result::Err(_) then ()
        end
      end
    end
  when Result::Err(_) then ()
  end
  
  h.to_string()
end

# 
# Workspace Support
# 

struct Workspace
  root: String
  members: Vec[String]
  default_members: Vec[String]
  shared_output: String
end

def load_workspace(path: String) -> Result[Workspace, String]
  # Parse a workspace Tangerine.toml with [workspace] section.
  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end
  
  match read_file(manifest_path.clone())
  when Result::Ok(content) then
    var members = Vec::new()
    var default_members = Vec::new()
    var section = ""
    var is_workspace = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      if trimmed.is_empty() || trimmed.starts_with("#") then
        next
      end
      
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        section = trimmed.slice(1, trimmed.len() - 1)
        if section == "workspace" then is_workspace = true end
        next
      end
      
      if section == "workspace" then
        match trimmed.split_once("=")
        when Option::Some(kv) then
          let key = kv.0.trim()
          let val = kv.1.trim()
          
          if key == "members" then
            let arr = val.trim_matches('[').trim_matches(']')
            for entry in arr.split(",") do
              let m = entry.trim().trim_matches('"')
              if !m.is_empty() then
                members.push(m.to_string())
              end
            end
          end
          
          if key == "default-members" then
            let arr = val.trim_matches('[').trim_matches(']')
            for entry in arr.split(",") do
              let m = entry.trim().trim_matches('"')
              if !m.is_empty() then
                default_members.push(m.to_string())
              end
            end
          end
        when Option::None then ()
        end
      end
    end
    
    if !is_workspace then
      return Result::Err("No [workspace] section in " + manifest_path)
    end
    
    if default_members.is_empty() then
      default_members = members.clone()
    end
    
    Result::Ok(Workspace {
      root: path.clone(),
      members: members,
      default_members: default_members,
      shared_output: path + "/build"
    })
  when Result::Err(e) then
    Result::Err("Cannot read workspace manifest: " + e)
  end
end

def build_workspace(ws: &Workspace) -> Result[Unit, String]
  println("Building workspace with " + ws.members.len().to_string() + " member(s)")
  
  for member in ws.default_members do
    let member_path = ws.root.clone() + "/" + member.clone()
    println("  Building " + member.clone() + "...")
    
    match load_project(member_path.clone())
    when Result::Ok(project) then
      match build_project(&project)
      when Result::Ok(_) then
        println("     " + member.clone())
      when Result::Err(e) then
        return Result::Err("Failed to build workspace member '" + member + "': " + e)
      end
    when Result::Err(e) then
      return Result::Err("Failed to load workspace member '" + member + "': " + e)
    end
  end
  
  println("Workspace build complete.")
  Result::Ok(())
end

# 
# tg dep  Dependency Management
# 

def cmd_dep(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg dep <subcommand>")
    println("")
    println("Subcommands:")
    println("  add <name> [--version <ver>] [--path <path>] [--git <url>]")
    println("  remove <name>")
    println("  list")
    println("  update [<name>]")
    println("  tree")
    return 1
  end
  
  let sub = argv[1].clone()
  
  if sub == "add" then
    cmd_dep_add(argv)
  elsif sub == "remove" then
    cmd_dep_remove(argv)
  elsif sub == "list" then
    cmd_dep_list()
  elsif sub == "update" then
    cmd_dep_update(argv)
  elsif sub == "tree" then
    cmd_dep_tree()
  else
    1
  end
end

def cmd_dep_add(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  var version = "*".to_string()
  var path_opt = Option::None
  var git_opt = Option::None
  
  var i: UInt = 3
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--path" && i + 1 < argv.len() then
      path_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    elsif argv[i] == "--git" && i + 1 < argv.len() then
      git_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    else
      i = i + 1
    end
  end
  
  # Read current manifest
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Check if [dependencies] section exists
    var new_content = content.clone()
    let dep_line = name.clone() + " = " + match path_opt
    when Option::Some(ref p) then
      "{ version = \"" + version.clone() + "\", path = \"" + p.clone() + "\" }"
    when Option::None then
      match git_opt
      when Option::Some(ref url) then
        "{ version = \"" + version.clone() + "\", git = \"" + url.clone() + "\" }"
      when Option::None then
        "\"" + version.clone() + "\""
      end
    end
    
    if content.contains("[dependencies]") then
      # Append after [dependencies] line
      new_content = content.replace("[dependencies]", "[dependencies]\n" + dep_line)
    else
      # Add [dependencies] section
      new_content = content + "\n[dependencies]\n" + dep_line + "\n"
    end
    
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Added dependency: " + name + " " + version)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_remove(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Remove lines matching the dependency name in [dependencies]
    var new_lines = Vec::new()
    var in_deps = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      
      if trimmed == "[dependencies]" then
        in_deps = true
        new_lines.push(line.to_string())
        next
      end
      
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        in_deps = false
      end
      
      if in_deps && trimmed.starts_with(name.as_str()) then
        # Skip this dependency line
        next
      end
      
      new_lines.push(line.to_string())
    end
    
    let new_content = new_lines.join("\n")
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Removed dependency: " + name)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(_) then
    1
  end
end

def cmd_dep_list() -> Int
  match load_project(".")
  when Result::Ok(project) then
    if project.dependencies.is_empty() then
      println("No dependencies.")
    else
      println("Dependencies:")
      for dep in project.dependencies do
        var info = "  " + dep.name.clone() + " " + dep.version.clone()
        match dep.path
        when Option::Some(ref p) then info = info + " (path: " + p.clone() + ")"
        when Option::None then ()
        end
        match dep.git
        when Option::Some(ref url) then info = info + " (git: " + url.clone() + ")"
        when Option::None then ()
        end
        println(info)
      end
    end
    0
  when Result::Err(e) then
    1
  end
end

def cmd_dep_update(argv: Vec[String]) -> Int
  # Re-resolve all dependencies (or a specific one) and update lockfile
  let filter = if argv.len() >= 3 then
    Option::Some(argv[2].clone())
  else
    Option::None
  end
  
  match load_project(".")
  when Result::Ok(project) then
    # Remove lockfile to force re-resolution
    match filter
    when Option::Some(ref name) then
      println("Updating dependency: " + name.clone())
    when Option::None then
      println("Updating all dependencies...")
      # Delete existing lockfile to force fresh resolution
      let _ = delete_file("Tangerine.lock")
    end
    
    match resolve_project_deps(&project)
    when Result::Ok(resolved) then
      println("Updated " + resolved.packages.len().to_string() + " package(s).")
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_tree() -> Int
  # Display dependency tree
  match load_project(".")
  when Result::Ok(project) then
    println(project.name.clone() + " v" + project.version.clone())
    for dep in project.dependencies do
      let prefix = " "
      var line = prefix + dep.name.clone() + " v" + dep.version.clone()
      match dep.path
      when Option::Some(ref p) then line = line + " (path)"
      when Option::None then ()
      end
      match dep.git
      when Option::Some(ref url) then line = line + " (git)"
      when Option::None then ()
      end
      println(line)
      
      # Attempt to load transitive deps
      let dep_dir = match dep.path
      when Option::Some(ref p) then p.clone()
      when Option::None then ".tg_deps/" + dep.name.clone()
      end
      
      match load_project(dep_dir)
      when Result::Ok(sub_proj) then
        for sub_dep in sub_proj.dependencies do
          println("    " + sub_dep.name.clone() + " v" + sub_dep.version.clone())
        end
      when Result::Err(_) then ()
      end
    end
    0
  when Result::Err(e) then
    1
  end
end

# 
# tg install  Package Installation
# 

def cmd_install(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg install <package-name> [--version <ver>]")
    println("")
    println("Installs a Tangerine package binary to ~/.tg/bin/")
    println("")
    println("Options:")
    println("  --version <ver>  Install a specific version")
    println("  --global         Install globally (default)")
    println("  --force          Reinstall even if already installed")
    return 0
  end
  
  let pkg_name = argv[1].clone()
  var version = "latest".to_string()
  var force = false
  
  var i: UInt = 2
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--force" then
      force = true
      i = i + 1
    else
      i = i + 1
    end
  end
  
  let install_dir = home_dir() + "/.tg/bin"
  mkdir_p(&install_dir)
  
  let install_path = install_dir.clone() + "/" + pkg_name.clone()
  
  if !force && file_exists(&install_path) then
    println("Package '" + pkg_name.clone() + "' is already installed. Use --force to reinstall.")
    return 0
  end
  
  println("Installing " + pkg_name.clone() + " " + version.clone() + "...")
  
  # Create a temp directory, fetch the package, build it, copy binary
  let tmp_dir = "/tmp/tg_install_" + pkg_name.clone()
  mkdir_p(&tmp_dir)
  
  # Fetch from registry
  let registry_url = "https://registry.tangerine-lang.org"
  let fetch_url = registry_url + "/api/v1/packages/" + pkg_name.clone() + "/" + version.clone() + "/download"
  
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), fetch_url.as_str()])
  match fetch_result
  when Result::Ok(_) then
    # Extract
    let extract = run_command("tar", vec!["xzf", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), "-C", tmp_dir.as_str()])
    match extract
    when Result::Ok(_) then
      # Build the package
      match load_project(tmp_dir.clone())
      when Result::Ok(project) then
        match build_project(&project)
        when Result::Ok(_) then
          # Copy resulting binary to install dir
          let binary = tmp_dir.clone() + "/build/" + pkg_name.clone()
          let cp_result = run_command("cp", vec![binary.as_str(), install_path.as_str()])
          match cp_result
          when Result::Ok(_) then
            # Make executable
            let _ = run_command("chmod", vec!["+x", install_path.as_str()])
            println("Installed " + pkg_name.clone() + " to " + install_path)
            0
          when Result::Err(e) then
            1
          end
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

# 
# tg self-update  Compiler Version Manager
# 

def cmd_self_update(argv: Vec[String]) -> Int
  println("Tangerine self-update")
  println("")
  
  let current_version = VERSION
  
  # Determine target triple
  let os = detect_os()
  let arch = detect_arch()
  let target = arch + "-" + os
  
  println("Current version: " + current_version)
  println("Target: " + target.clone())
  
  # Check for latest version from release server
  let release_url = "https://releases.tangerine-lang.org/latest/version"
  println("Checking for updates...")
  
  let version_result = run_command("curl", vec!["-sSL", release_url.as_str()])
  match version_result
  when Result::Ok(latest_version) then
    let latest = latest_version.trim().to_string()
    
    if latest == current_version then
      println("Already up to date (v" + current_version + ").")
      return 0
    end
    
    println("New version available: v" + latest.clone())
    println("Downloading...")
    
    let download_url = "https://releases.tangerine-lang.org/" + latest.clone() + "/tg-" + target + ".tar.gz"
    let tmp = "/tmp/tg_self_update.tar.gz"
    
    let dl = run_command("curl", vec!["-sSL", "-o", tmp, download_url.as_str()])
    match dl
    when Result::Ok(_) then
      # Extract to temp location
      let tmp_dir = "/tmp/tg_self_update"
      mkdir_p(tmp_dir)
      let extract = run_command("tar", vec!["xzf", tmp, "-C", tmp_dir])
      
      match extract
      when Result::Ok(_) then
        # Replace current binary
        let current_binary = argv[0].clone()  # Path to running tg binary
        let new_binary = tmp_dir.to_string() + "/tg"
        
        let cp = run_command("cp", vec![new_binary.as_str(), current_binary.as_str()])
        match cp
        when Result::Ok(_) then
          let _ = run_command("chmod", vec!["+x", current_binary.as_str()])
          println("Updated to v" + latest + " successfully!")
          0
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def detect_os() -> String
  # Check via uname (available on macOS/Linux)
  match run_command("uname", vec!["-s"])
  when Result::Ok(out) then
    let os = out.trim().to_lowercase()
    if os.contains("darwin") then "apple-darwin".to_string()
    elsif os.contains("linux") then "unknown-linux-gnu".to_string()
    else "unknown".to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end
end

def detect_arch() -> String
  match run_command("uname", vec!["-m"])
  when Result::Ok(out) then
    let arch = out.trim().to_lowercase()
    if arch == "x86_64" || arch == "amd64" then "x86_64".to_string()
    elsif arch == "arm64" || arch == "aarch64" then "aarch64".to_string()
    else arch.to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end
end

def cmd_explain_main(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    return 1
  end
  cmd_explain(argv[1].clone())
  0
end

# 
# Subcommand: agent
# 
#
# Run agentic workflows using the Tangerine agentic subsystem.
# Provides CLI access to contracts, capabilities, effects, and budgets.
#
# Usage:
#   tg agent check <file>            verify all contracts in a source file
#   tg agent caps <file>             list capabilities required by a module
#   tg agent effects <file>          list effects performed by a module
#   tg agent budget <file>           analyse resource budget of a module
#   tg agent diff <old> <new>        semantic diff between two source files
#   tg agent audit <dir>             full agentic audit of a project

def cmd_agent(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg agent <subcommand> [options] <file>")
    println("")
    println("Subcommands:")
    println("  check    Verify all contracts (pre/post/invariant)")
    println("  caps     List required capabilities")
    println("  effects  List effects performed by each function")
    println("  budget   Analyse resource budget usage")
    println("  diff     Semantic diff between two source files")
    println("  audit    Full agentic audit of a project directory")
    return 1
  end

  let subcmd = argv[1].clone()
  
  if subcmd == "check" then
    agent_check(argv)
  elsif subcmd == "caps" then
    agent_caps(argv)
  elsif subcmd == "effects" then
    agent_effects(argv)
  elsif subcmd == "budget" then
    agent_budget(argv)
  elsif subcmd == "diff" then
    agent_diff(argv)
  elsif subcmd == "audit" then
    agent_audit(argv)
  else
    1
  end
end

def agent_check(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Extract contract declarations from the AST
  var contract_count = 0
  var violation_count = 0

  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      for contract in f.contracts do
        contract_count = contract_count + 1
        # Verify contract is well-formed (condition references in-scope names)
        let cond_note = match contract.message
        when Option::Some(m) then m.clone()
        when Option::None then "(no message)"
        end
        println("  [" + contract.kind.to_string() + "] " + f.name.clone() + ": " + cond_note)
      end
    when _ then ()
    end
  end

  println("Contract analysis for " + path + ":")
  println("  Total contracts: " + contract_count.to_string())
  println("  Violations: " + violation_count.to_string())
  if violation_count == 0 then 0 else 1 end
end

def agent_caps(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for capability annotations: #[require(cap)] and `require_capability` calls
  var caps = Set::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      for attr in item.attrs do
        if attr.name == "require" then
          for arg in attr.args do
            caps.insert(arg.value.clone())
          end
        end
      end
    when _ then ()
    end
  end

  println("Capabilities required by " + path + ":")
  if caps.is_empty() then
    println("  (none)")
  else
    for cap_name in caps do
      println("  - " + cap_name)
    end
  end
  0
end

def agent_effects(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for effect annotations and perform declarations
  println("Effects in " + path + ":")
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      var fn_effects = Vec::new()
      for attr in item.attrs do
        if attr.name == "performs" || attr.name == "effect" then
          for arg in attr.args do
            fn_effects.push(arg.value.clone())
          end
        end
      end
      if !fn_effects.is_empty() then
        var effect_str = ""
        var first = true
        for e in fn_effects do
          if !first then effect_str = effect_str + ", " end
          effect_str = effect_str + e
          first = false
        end
        println("  " + f.name.clone() + ": performs " + effect_str)
      end
    when _ then ()
    end
  end
  0
end

def agent_budget(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  var ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end
  assign_node_ids(&mut ast)

  # Lower to MIR and analyse budget consumption
  var typed_program: Option[TypedProgram] = Option::None
  match resolve_names(&ast)
  when Result::Ok(res) then
    var env = type_env_new()
    let type_result = type_check_typed(&mut env, &ast, &res)
    if !type_result.errors.is_empty() then
      return 1
    end
    typed_program = Option::Some(type_result.program)
  when Result::Err(res_errors) then
    for re in res_errors do
      eprintln(re.message)
    end
    return 1
  end

  let mir = match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  println("Budget analysis for " + path + ":")
  for func in mir.functions do
    var budget_ops = Vec::new()
    for block in func.blocks do
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirBudgetConsume(resource, amount) then
          budget_ops.push((resource.clone(), amount))
        when _ then ()
        end
      end
    end
    if !budget_ops.is_empty() then
      println("  fn " + func.name.clone() + ":")
      for op in budget_ops do
        let res = op.0
        let amt = op.1
        println("    consumes " + amt.to_string() + " units of " + res)
      end
    end
  end
  0
end

def agent_diff(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end
  let old_path = argv[2].clone()
  let new_path = argv[3].clone()

  let old_source = match read_file(old_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end
  let new_source = match read_file(new_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  # Parse both
  let old_parse = parse(tokenize(old_source, ""))
  let old_ast = old_parse.program
  let old_diags = old_parse.diagnostics
  if diag_has_errors(&old_diags) then
    return 1
  end
  let new_parse = parse(tokenize(new_source))
  let new_ast = new_parse.program
  let new_diags = new_parse.diagnostics
  if diag_has_errors(&new_diags) then
    return 1
  end

  # Semantic diff: compare items by name
  println("Semantic diff: " + old_path + "  " + new_path)

  var old_items: Map[String, String] = Map::new()
  for item in old_ast.items do
    let name = item_name(&item)
    old_items.insert(name, item.kind.to_string())
  end

  var new_items: Map[String, String] = Map::new()
  for item in new_ast.items do
    let name = item_name(&item)
    new_items.insert(name, item.kind.to_string())
  end

  # Added items
  for entry in new_items do
    let name = entry.key
    if !old_items.contains_key(&name) then
      println("  + " + name + " (added)")
    end
  end

  # Removed items
  for entry in old_items do
    let name = entry.key
    if !new_items.contains_key(&name) then
      println("  - " + name + " (removed)")
    end
  end

  # Modified items
  for entry in old_items do
    let name = entry.key
    let old_kind = entry.value
    match new_items.get(&name)
    when Option::Some(new_kind) then
      if old_kind != new_kind then
        println("  ~ " + name + " (modified)")
      end
    when Option::None then ()
    end
  end
  0
end

def item_name(item: &Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then f.name.clone()
  when ItemKind::ItemStruct(s) then s.name.clone()
  when ItemKind::ItemEnum(e) then e.name.clone()
  when ItemKind::ItemTrait(t) then t.name.clone()
  when ItemKind::ItemImpl(i) then "impl_" + type_expr_name(&i.for_type).clone()
  when ItemKind::ItemConst(c) then c.name.clone()
  when ItemKind::ItemMacro(m) then "macro_" + m.name.clone()
  when _ then "<anonymous>"
  end
end

def agent_audit(argv: Vec[String]) -> Int
  let dir = if argv.len() >= 3 then argv[2].clone() else ".".to_string() end

  println("Agentic audit of " + dir + ":")
  println("========================================")

  # Discover all .tg files
  let files = discover_sources(&dir)

  var total_contracts = 0
  var total_caps = 0
  var total_effects = 0
  var total_unsafe = 0
  var total_functions = 0

  for file in files do
    let source = match read_file(file.clone())
    when Result::Ok(s) then s
    when Result::Err(_) then next
    end

    let tokens = tokenize(source, "")
    let parse_out = parse(tokens)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then next end

    for item in ast.items do
      match item.kind
      when ItemKind::ItemFunction(f) then
        total_functions = total_functions + 1
        total_contracts = total_contracts + f.contracts.len()
        if f.is_unsafe then total_unsafe = total_unsafe + 1 end
        for attr in item.attrs do
          if attr.name == "require" then
            total_caps = total_caps + attr.args.len()
          end
          if attr.name == "performs" || attr.name == "effect" then
            total_effects = total_effects + attr.args.len()
          end
        end
      when _ then ()
      end
    end
  end

  println("  Files scanned:   " + files.len().to_string())
  println("  Functions:       " + total_functions.to_string())
  println("  Contracts:       " + total_contracts.to_string())
  println("  Capabilities:    " + total_caps.to_string())
  println("  Effects:         " + total_effects.to_string())
  println("  Unsafe functions:" + total_unsafe.to_string())
  println("")

  if total_unsafe > 0 then
    println("  WARNING: " + total_unsafe.to_string() + " unsafe functions found  ensure SAFETY comments are present")
  end

  println("Audit complete.")
  0
end

# 
# Subcommand: bindgen
# 
# Generates FFI bindings for C, Rust, and Ruby.
# Per interop.txt 8.2, 9.1, 12
#
# Usage:
#   tg bindgen c <file.tg> [-o output.h]
#   tg bindgen rust <file.tg> [-o output_dir]
#   tg bindgen ruby <file.tg> [-o output_dir]

def cmd_bindgen(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    print_bindgen_help()
    return 1
  end

  let target = argv[1].clone()
  let file = argv[2].clone()

  let output = if argv.len() >= 5 && argv[3] == "-o" then
    argv[4].clone()
  else
    match target.as_str()
    when "c" then file.replace(".tg", ".h")
    when "rust" then "tangerine_shim"
    when "ruby" then "ext"
    end
  end

  match target.as_str()
  when "c" then bindgen_c(file, output)
  when "rust" then bindgen_rust(file, output)
  when "ruby" then bindgen_ruby(file, output)
  when _ then
    1
  end
end

def print_bindgen_help() -> Unit
  println("Usage: tg bindgen <target> <file.tg> [-o output]")
  println("Generate FFI bindings")
  println("")
  println("Targets:")
  println("  c      Generate C header (.h)")
  println("  rust   Generate Rust shim crate")
  println("  ruby   Generate Ruby extension scaffold")
  println("")
  println("Options:")
  println("  -o <path>  Output file/directory")
end

# Generate C header from Tangerine source
def bindgen_c(source_file: String, output: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  var header = "/* Generated by tg bindgen c */\n"
  header = header + "#ifndef TG_BINDINGS_H\n"
  header = header + "#define TG_BINDINGS_H\n\n"
  header = header + "#include <stdint.h>\n"
  header = header + "#include <stdbool.h>\n\n"

  header = header + "/* Type aliases */\n"
  header = header + "typedef int64_t tg_int;\n"
  header = header + "typedef uint64_t tg_uint;\n"
  header = header + "typedef double tg_float;\n"
  header = header + "typedef uint8_t tg_u8;\n"
  header = header + "typedef uint32_t tg_char;\n\n"

  header = header + "/* FFI string view (borrowed) */\n"
  header = header + "typedef struct { const uint8_t* ptr; size_t len; } tg_str;\n\n"

  header = header + "/* FFI result */\n"
  header = header + "typedef struct { bool ok; int32_t err_code; } tg_result_void;\n\n"

  # Extract extern "C" functions
  header = header + "/* Exported functions */\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        header = header + generate_c_prototype(&f) + "\n"
      end
    when ItemKind::ItemStruct(s) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_struct(&s) + "\n"
      end
    when ItemKind::ItemEnum(e) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_enum(&e) + "\n"
      end
    when _ then ()
    end
  end

  header = header + "\n#endif /* TG_BINDINGS_H */\n"

  match write_file(output.clone(), header)
  when Result::Ok(_) then
    println("Generated " + output)
    0
  when Result::Err(e) then
    1
  end
end

def is_ffi_exported(f: &FunctionDecl, annotations: &Vec[Attribute]) -> Bool
  # Check if function has extern "C" abi or has #[export] annotation
  annotations.iter().any(|a| a.name == "export")
end

def is_repr_c(annotations: &Vec[Annotation]) -> Bool
  for a in annotations do
    if a.name == "repr" then
      for arg in a.args do
        if arg.value == "c" || arg.value == "C" then
          return true
        end
      end
    end
  end
  false
end

def generate_c_prototype(f: &FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_expr_to_c(rt)
    when Option::None then "void"
  end
  var params = ""
  var first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_expr_to_c(t)
      when Option::None then "void*"
    end
    params = params + ty_str + " " + p.name.clone()
    first = false
  end
  if params == "" then params = "void" end
  ret_type + " " + f.name.clone() + "(" + params + ");"
end

def generate_c_struct(s: &StructDecl) -> String
  var result = "typedef struct {\n"
  for field in s.fields do
    result = result + "    " + tangerine_type_expr_to_c(&field.ty) + " " + field.name.clone() + ";\n"
  end
  result = result + "} " + s.name.clone() + ";\n"
  result
end

def generate_c_enum(e: &EnumDecl) -> String
  var result = "typedef enum {\n"
  var val = 0
  for variant in e.variants do
    result = result + "    " + e.name.clone() + "_" + variant.name.clone()
    result = result + " = " + val.to_string() + ",\n"
    val = val + 1
  end
  result = result + "} " + e.name.clone() + ";\n"
  result
end

def tangerine_type_to_c(ty: String) -> String
  if ty == "Bool" then "bool"
  elsif ty == "Int" then "tg_int"
  elsif ty == "UInt" then "tg_uint"
  elsif ty == "Float" then "tg_float"
  elsif ty == "Char" then "tg_char"
  elsif ty == "String" then "tg_str"
  elsif ty == "U8" then "tg_u8"
  else ty.clone()
  end
end

def tangerine_type_expr_to_c(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "void"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "int64_t"
    elsif name == "UInt" then "uint64_t"
    elsif name == "Float" then "double"
    elsif name == "Char" then "uint32_t"
    elsif name == "String" then "tg_str"
    else name.clone()
    end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "void*"
  end
end

# Generate Rust shim crate
def bindgen_rust(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())
  std::fs::create_dir_all(output_dir.clone() + "/src")

  # Generate Cargo.toml
  let cargo_toml = "[package]\n" +
    "name = \"tangerine_shim\"\n" +
    "version = \"0.1.0\"\n" +
    "edition = \"2021\"\n\n" +
    "[lib]\n" +
    "crate-type = [\"cdylib\", \"staticlib\"]\n"

  match write_file(output_dir.clone() + "/Cargo.toml", cargo_toml)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate lib.rs
  var lib_rs = "//! Generated by tg bindgen rust\n\n"
  lib_rs = lib_rs + "#![allow(non_camel_case_types)]\n\n"

  lib_rs = lib_rs + "// Type aliases\n"
  lib_rs = lib_rs + "pub type tg_int = i64;\n"
  lib_rs = lib_rs + "pub type tg_uint = u64;\n"
  lib_rs = lib_rs + "pub type tg_float = f64;\n\n"

  lib_rs = lib_rs + "// FFI string view\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgStr { pub ptr: *const u8, pub len: usize }\n\n"

  lib_rs = lib_rs + "// FFI result\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgResultVoid { pub ok: bool, pub err_code: i32 }\n\n"

  lib_rs = lib_rs + "extern \"C\" {\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        lib_rs = lib_rs + "    " + generate_rust_extern(&f) + "\n"
      end
    when _ then ()
    end
  end
  lib_rs = lib_rs + "}\n"

  match write_file(output_dir.clone() + "/src/lib.rs", lib_rs)
  when Result::Ok(_) then
    println("Generated Rust shim in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_rust_extern(f: &FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_to_rust(rt)
    when Option::None then "()"
  end
  var params = ""
  var first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_to_rust(t)
      when Option::None then "*const ()"
    end
    params = params + p.name.clone() + ": " + ty_str
    first = false
  end
  let ret_clause = if ret_type == "()" then "" else " -> " + ret_type end
  "pub fn " + f.name.clone() + "(" + params + ")" + ret_clause + ";"
end

def tangerine_type_to_rust(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "()"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "i64"
    elsif name == "UInt" then "u64"
    elsif name == "Float" then "f64"
    elsif name == "Char" then "u32"
    elsif name == "String" then "TgStr"
    else name.clone()
    end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "*mut std::ffi::c_void"
  end
end

# Generate Ruby extension scaffold
def bindgen_ruby(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return 1
  end

  let module_name = source_file.replace(".tg", "").replace("/", "_")

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())

  # Generate extconf.rb
  let extconf = "require 'mkmf'\n\n" +
    "extension_name = '" + module_name + "'\n" +
    "dir_config(extension_name)\n" +
    "create_makefile(extension_name)\n"

  match write_file(output_dir.clone() + "/extconf.rb", extconf)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate extension.c
  var ext_c = "/* Generated by tg bindgen ruby */\n"
  ext_c = ext_c + "#include \"ruby.h\"\n\n"
  ext_c = ext_c + "static VALUE m" + module_name + ";\n\n"

  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        ext_c = ext_c + generate_ruby_wrapper(&f, &module_name) + "\n"
      end
    when _ then ()
    end
  end

  ext_c = ext_c + "void Init_" + module_name + "(void) {\n"
  ext_c = ext_c + "    m" + module_name + " = rb_define_module(\"" + capitalize(&module_name) + "\");\n"
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let argc = f.params.len()
        ext_c = ext_c + "    rb_define_module_function(m" + module_name
        ext_c = ext_c + ", \"" + f.name.clone() + "\", rb_" + f.name.clone()
        ext_c = ext_c + ", " + argc.to_string() + ");\n"
      end
    when _ then ()
    end
  end
  ext_c = ext_c + "}\n"

  match write_file(output_dir.clone() + "/" + module_name + ".c", ext_c)
  when Result::Ok(_) then
    println("Generated Ruby extension in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_ruby_wrapper(f: &FunctionDecl, module_name: &String) -> String
  let argc = f.params.len()
  var params = ""
  var i = 0
  while i < argc do
    if i > 0 then params = params + ", " end
    params = params + "VALUE arg" + i.to_string()
    i = i + 1
  end
  if argc == 0 then params = "VALUE self" else params = "VALUE self, " + params end

  # Build argument conversion code
  var conversions = ""
  var call_args = ""
  i = 0
  while i < argc do
    let param = f.params[i]
    let arg_name = "arg" + i.to_string()
    let conv_name = "c_" + arg_name
    
    # Generate conversion based on parameter type
    let (conv_code, c_type) = match param.ty
      when Option::Some(t) then ruby_to_c_conversion(arg_name.clone(), t)
      when Option::None then ("(void*)" + arg_name.clone(), "void*")
    end
    conversions = conversions + "    " + c_type + " " + conv_name + " = " + conv_code + ";\n"
    
    if i > 0 then call_args = call_args + ", " end
    call_args = call_args + conv_name
    i = i + 1
  end
  
  # Generate return value handling
  let (ret_decl, ret_call, ret_conv) = match f.ret_type
    when Option::Some(rt) then c_to_ruby_return(rt)
    when Option::None then ("", "", "    return Qnil;\n")
  end

  "static VALUE rb_" + f.name.clone() + "(" + params + ") {\n" +
  conversions +
  ret_decl +
  "    " + ret_call + f.name.clone() + "(" + call_args + ");\n" +
  ret_conv +
  "}\n"
end

# Convert Ruby VALUE to C type for function call
def ruby_to_c_conversion(arg: String, ty: &TypeExpr) -> (String, String)
  match ty.kind
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then ("NUM2LONG(" + arg + ")", "long")
    when "UInt" then ("NUM2ULONG(" + arg + ")", "unsigned long")
    when "Float" then ("NUM2DBL(" + arg + ")", "double")
    when "Bool" then ("RTEST(" + arg + ")", "int")
    when "String" then ("StringValueCStr(" + arg + ")", "const char*")
    when "RubyValue" then (arg, "VALUE")
    when _ then ("(void*)" + arg, "void*")
    end
  when TypeExprKind::Ptr(_) then
    ("(void*)" + arg, "void*")
  when TypeExprKind::PtrMut(_) then
    ("(void*)" + arg, "void*")
  when _ then
    ("(void*)" + arg, "void*")
  end
end

# Generate C return handling code for Ruby
def c_to_ruby_return(ty: &TypeExpr) -> (String, String, String)
  match ty.kind
  when TypeExprKind::Unit then
    ("", "", "    return Qnil;\n")
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then
      ("    long tg_result;\n", "tg_result = ", "    return LONG2NUM(tg_result);\n")
    when "UInt" then
      ("    unsigned long tg_result;\n", "tg_result = ", "    return ULONG2NUM(tg_result);\n")
    when "Float" then
      ("    double tg_result;\n", "tg_result = ", "    return DBL2NUM(tg_result);\n")
    when "Bool" then
      ("    int tg_result;\n", "tg_result = ", "    return tg_result ? Qtrue : Qfalse;\n")
    when "String" then
      ("    const char* tg_result;\n", "tg_result = ", "    return rb_str_new_cstr(tg_result);\n")
    when "RubyValue" then
      ("    VALUE tg_result;\n", "tg_result = ", "    return tg_result;\n")
    when _ then
      ("", "", "    return Qnil;\n")
    end
  when _ then
    ("", "", "    return Qnil;\n")
  end
end

def capitalize(s: &String) -> String
  if s.is_empty() then return "" end
  let first = s.char_at(0).to_uppercase().to_string()
  first + s.slice(1, s.len())
end

# 
# Subcommand: abi
# 
# ABI tools: test, dump, check
# Per interop.txt 10.2
#
# Usage:
#   tg abi test [file.tg]    validate ABI conformance
#   tg abi dump <file.tg>    dump type layouts
#   tg abi check <a.tg> <b.tg>   check ABI compatibility

def cmd_abi(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    print_abi_help()
    return 1
  end

  let subcmd = argv[1].clone()
  match subcmd.as_str()
  when "test" then abi_test(argv)
  when "dump" then abi_dump(argv)
  when "check" then abi_check(argv)
  when _ then
    print_abi_help()
    1
  end
end

def print_abi_help() -> Unit
  println("Usage: tg abi <subcommand> [args]")
  println("ABI tools")
  println("")
  println("Subcommands:")
  println("  test [file]     Validate ABI conformance")
  println("  dump <file>     Dump type layouts (size/align)")
  println("  check <a> <b>   Check ABI compatibility between files")
end

# Validate ABI conformance  checks type sizes, alignments, calling conventions
def abi_test(argv: Vec[String]) -> Int
  println("Tangerine ABI Test Suite")
  println("========================")
  println("")

  var passed = 0
  var failed = 0

  # Primitive type size/align tests (per interop.txt 5.2)
  let tests = [
    ("i8/u8", 1, 1),
    ("i16/u16", 2, 2),
    ("i32/u32", 4, 4),
    ("i64/u64", 8, 8),
    ("isize/usize", 8, 8),
    ("bool", 1, 1),
    ("f32", 4, 4),
    ("f64", 8, 8),
    ("*T", 8, 8)
  ]

  println("Primitive type layout tests:")
  let empty_layout: Map[Int, Int] = Map::new()
  
  # Test Int (i64)
  let int_size = type_size(&Type::Int, &empty_layout)
  let int_align = type_align(&Type::Int)
  if int_size == 8 && int_align == 8 then
    println("   Int: size=8, align=8")
    passed = passed + 1
  else
    println("   Int: expected size=8 align=8, got size=" + int_size.to_string() + " align=" + int_align.to_string())
    failed = failed + 1
  end

  # Test Bool
  let bool_size = type_size(&Type::Bool, &empty_layout)
  let bool_align = type_align(&Type::Bool)
  if bool_size == 1 && bool_align == 1 then
    println("   Bool: size=1, align=1")
    passed = passed + 1
  else
    println("   Bool: expected size=1 align=1, got size=" + bool_size.to_string())
    failed = failed + 1
  end

  # Test Float (f64)
  let float_size = type_size(&Type::Float, &empty_layout)
  let float_align = type_align(&Type::Float)
  if float_size == 8 && float_align == 8 then
    println("   Float: size=8, align=8")
    passed = passed + 1
  else
    println("   Float: expected size=8 align=8, got size=" + float_size.to_string())
    failed = failed + 1
  end

  # Test Ref (pointer)
  let ref_size = type_size(&Type::RefInternal(Type::Int, false), &empty_layout)
  if ref_size == 8 then
    println("   &T: size=8")
    passed = passed + 1
  else
    println("   &T: expected size=8, got " + ref_size.to_string())
    failed = failed + 1
  end

  # Test String (raw char*)
  let str_size = type_size(&Type::String, &empty_layout)
  if str_size == 8 then
    println("   String: size=8")
    passed = passed + 1
  else
    println("   String: expected size=8, got " + str_size.to_string())
    failed = failed + 1
  end

  # Test Slice / Vec lowering (heap-header pointer)
  let slice_size = type_size(&Type::Slice(Box::new(Type::Int)), &empty_layout)
  if slice_size == 8 then
    println("   Slice[T]: size=8")
    passed = passed + 1
  else
    println("   Slice[T]: expected size=8, got " + slice_size.to_string())
    failed = failed + 1
  end

  println("")
  println("ABI version info:")
  println("  Edition: 2026")
  println("  ABI revision: 1")
  println("  Target: " + detect_host_target().to_string())
  println("")

  println("Results: " + passed.to_string() + " passed, " + failed.to_string() + " failed")

  if failed > 0 then 1 else 0 end
end

# Dump type layouts for a source file
def abi_dump(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end

  let file = argv[2].clone()
  let source = match read_file(file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source, "")
  let parse_output = parse(tokens)
  if diag_has_errors(&parse_output.diagnostics) then
    return 1
  end
  let ast = parse_output.program

  println("Type layouts for " + file + ":")
  println("==============================")
  println("")

  let empty_layout: Map[Int, Int] = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemStruct(s) then
      println("struct " + s.name.clone() + " {")
      var offset = 0
      for field in s.fields do
        let sz = type_expr_size(&field.ty)
        let al = type_expr_align(&field.ty)
        # Compute padding
        let padding = if offset % al != 0 then al - (offset % al) else 0 end
        offset = offset + padding
        println("  " + field.name.clone() + ": " + type_name(&field.ty) +
                " @ offset " + offset.to_string() + " (size=" + sz.to_string() +
                ", align=" + al.to_string() + ")")
        offset = offset + sz
      end
      let struct_align = max_field_align(&s.fields)
      let final_padding = if offset % struct_align != 0 then struct_align - (offset % struct_align) else 0 end
      offset = offset + final_padding
      println("} // total size=" + offset.to_string() + ", align=" + struct_align.to_string())
      println("")
    when ItemKind::ItemEnum(e) then
      println("enum " + e.name.clone() + " {")
      for variant in e.variants do
        println("  " + variant.name.clone())
      end
      println("} // tag size=4")
      println("")
    when _ then ()
    end
  end

  0
end

def type_expr_size(ty: &TypeExpr) -> Int
  match ty.kind
  when TypeExprKind::Unit then 1
  when TypeExprKind::Never then 1
  when TypeExprKind::Named(name, _) then
    if name == "Bool" || name == "u8" || name == "i8" || name == "char" then 1
    elsif name == "u16" || name == "i16" then 2
    elsif name == "u32" || name == "i32" || name == "Float" || name == "float" || name == "f32" then 4
    elsif name == "u64" || name == "i64" || name == "USize" || name == "ISize" then 8
    else 8
    end
  when TypeExprKind::Tuple(parts) then
    var total = 0
    var max_al = 1
    for p2 in parts do
      let sz2 = type_expr_size(&p2)
      let al2 = type_expr_align(&p2)
      let pad = if total % al2 != 0 then al2 - (total % al2) else 0 end
      total = total + pad + sz2
      if al2 > max_al then max_al = al2 end
    end
    let final_pad = if total % max_al != 0 then max_al - (total % max_al) else 0 end
    total + final_pad
  when TypeExprKind::Array(elem, _) then
    let esz = type_expr_size(&elem)
    if esz > 0 then esz * 4 else 8 end
  when TypeExprKind::Slice(_) then 16
  when TypeExprKind::Ptr(_) then 8
  when TypeExprKind::PtrMut(_) then 8
  when TypeExprKind::Fn(_, _) then 8
  when _ then 8
  end
end

def type_expr_align(ty: &TypeExpr) -> Int
  let sz = type_expr_size(ty)
  if sz == 1 then 1
  elsif sz == 2 then 2
  elsif sz <= 4 then 4
  else 8
  end
end

def max_field_align(fields: &Vec[FieldDecl]) -> Int
  var max_al = 1
  for f in fields do
    let al = type_align(&f.ty)
    if al > max_al then max_al = al end
  end
  max_al
end

def type_name(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      var rendered = name.clone() + "["
      var first = true
      for arg in args do
        if !first then rendered = rendered + ", " end
        rendered = rendered + type_name(&arg)
        first = false
      end
      rendered + "]"
    end
  when TypeExprKind::Array(inner, n) then "[" + type_name(&inner) + "; " + n.to_string() + "]"
  when TypeExprKind::Slice(inner) then "[" + type_name(&inner) + "]"
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Infer then "_"
  when _ then "?"
  end
end

# Check ABI compatibility between two files
def abi_check(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end

  let file_a = argv[2].clone()
  let file_b = argv[3].clone()

  # Parse both files
  let ast_a = match parse_file(file_a.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  let ast_b = match parse_file(file_b.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  # Extract exported symbols from both
  let exports_a = extract_exports(&ast_a)
  let exports_b = extract_exports(&ast_b)

  var compatible = true
  var checked = 0

  println("ABI Compatibility Check: " + file_a + " vs " + file_b)
  println("========================================================")
  println("")

  # Check for removed exports
  for entry in exports_a do
    let name = entry.key
    let sig_a = entry.value
    checked = checked + 1
    match exports_b.get(&name)
    when Option::Some(sig_b) then
      if sig_a != sig_b then
        println(" " + name + ": signature changed")
        println("    was: " + sig_a)
        println("    now: " + sig_b)
        compatible = false
      else
        println(" " + name)
      end
    when Option::None then
      println(" " + name + ": removed (breaking change)")
      compatible = false
    end
  end

  # Check for new exports (non-breaking but reported)
  for entry in exports_b do
    let name = entry.key
    if !exports_a.contains_key(&name) then
      println("+ " + name + ": new export")
    end
  end

  println("")
  println("Checked " + checked.to_string() + " exports.")
  
  if compatible then
    println("Result: ABI compatible ")
    0
  else
    println("Result: ABI INCOMPATIBLE ")
    1
  end
end

def parse_file(path: String) -> Result[Program, String]
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err("Cannot read " + path + ": " + e)
  end
  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    Result::Err("Parse error in " + path)
  else
    Result::Ok(ast)
  end
end

def extract_exports(ast: &Program) -> Map[String, String]
  var exports = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let sig = function_signature(&f)
        exports.insert(f.name.clone(), sig)
      end
    when _ then ()
    end
  end
  exports
end

def function_signature(f: &FunctionDecl) -> String
  var sig = "("
  var first = true
  for p in f.params do
    if !first then sig = sig + ", " end
    match p.ty
    when Option::Some(t) then sig = sig + type_name(t)
    when Option::None then sig = sig + "?"
    end
    first = false
  end
  sig = sig + ") -> "
  match f.ret_type
  when Option::Some(rt) then sig = sig + type_name(rt)
  when Option::None then sig = sig + "Unit"
  end
  sig
end

# 
# Build Cache Persistence
# 

def load_build_cache(output_dir: &String) -> IncrementalCache
  let cache_path = output_dir.clone() + "/.tg_cache"
  
  match read_file(cache_path)
  when Result::Ok(content) then
    var cache = cache_new(output_dir.clone())
    
    # Parse cache file: each line is "path|source_hash|mir_hash|timestamp"
    for line in content.lines() do
      let trimmed = line.trim()
      if trimmed.is_empty() || trimmed.starts_with("#") then next end
      
      let parts = trimmed.split("|")
      if parts.len() >= 4 then
        let path = parts[0].to_string()
        let source_hash = parts[1].to_string()
        let mir_hash = parts[2].to_string()
        let timestamp = match parts[3].parse_int()
        when Result::Ok(t) then t
        when Result::Err(_) then 0
        end
        
        cache.entries.insert(path, CacheEntry {
          source_hash: source_hash,
          mir_hash: mir_hash,
          timestamp: timestamp
        })
      end
    end
    
    cache
  when Result::Err(_) then
    cache_new(output_dir.clone())
  end
end

def save_build_cache(cache: &IncrementalCache) -> Unit
  let cache_path = cache.cache_dir.clone() + "/.tg_cache"
  mkdir_p(&cache.cache_dir)
  
  var content = "# Tangerine build cache v1\n".to_string()
  
  for entry in cache.entries do
    content = content + entry.0.clone() + "|"
    content = content + entry.1.source_hash.clone() + "|"
    content = content + entry.1.mir_hash.clone() + "|"
    content = content + entry.1.timestamp.to_string() + "\n"
  end
  
  match write_file(cache_path, content)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

# 
# LSP Support
# 

struct LspServer
  documents: Map[String, String]
  diagnostics: Map[String, Vec[Diagnostic]]
  asts: Map[String, Program]
  symbol_tables: Map[String, Vec[LspSymbol]]
end

struct LspSymbol
  name: String
  kind: LspSymbolKind
  span: Span
  type_str: String
  doc_comment: Option[String]
  definition_uri: Option[String]
  definition_span: Option[Span]
end

enum LspSymbolKind
  Function
  Method
  Variable
  Parameter
  Field
  Struct
  Enum
  Trait
  Module
  Constant
  Type
end

struct LspPosition
  line: UInt
  character: UInt
end

struct LspRange
  start: LspPosition
  end_pos: LspPosition
end

struct LspLocation
  uri: String
  range: LspRange
end

struct LspCompletionItem
  label: String
  kind: LspSymbolKind
  detail: Option[String]
  documentation: Option[String]
  insert_text: String
end

struct LspHoverResult
  contents: String
  range: Option[LspRange]
end

struct LspSignatureHelp
  signatures: Vec[LspSignature]
  active_signature: UInt
  active_parameter: UInt
end

struct LspSignature
  label: String
  documentation: Option[String]
  parameters: Vec[LspParameterInfo]
end

struct LspParameterInfo
  label: String
  documentation: Option[String]
end

struct LspCodeAction
  title: String
  kind: String
  diagnostics: Vec[Diagnostic]
  edit: Option[LspTextEdit]
end

struct LspTextEdit
  uri: String
  range: LspRange
  new_text: String
end

def lsp_server_new() -> LspServer
  LspServer {
    documents: Map::new(),
    diagnostics: Map::new(),
    asts: Map::new(),
    symbol_tables: Map::new()
  }
end

def lsp_did_open(server: &mut LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_did_change(server: &mut LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_check_document(server: &mut LspServer, uri: String) -> Unit
  match server.documents.get(uri.clone())
  when Option::Some(content) then
    let tokens = tokenize(content)
    let parse_out = parse(tokens)
    var ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    assign_node_ids(&mut ast)
    
    var diags = Vec::new()
    
    # Convert parse diagnostics
    for pd in parse_diags do
      diags.push(Diagnostic {
        level: DiagLevel::Error,
        message: pd.message,
        span: Option::Some(pd.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
    
    if !diag_has_errors(&parse_diags) then
      # Build symbol table for the document
      let symbols = build_symbol_table(&ast, uri.clone())
      server.symbol_tables.insert(uri.clone(), symbols)
      server.asts.insert(uri.clone(), ast.clone())
      
      match resolve_names(&ast)
      when Result::Ok(res) then
        var env = type_env_new()
        let type_result = type_check_typed(&mut env, &ast, &res)
        for err in type_result.errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end
        
        let access_errors = access_check(&ast, &type_result.program)
        for err in access_errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end

        let resource_errors = resource_check(&ast, &type_result.program)
        for err in resource_errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: err.message,
            span: Option::Some(err.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::None
          })
        end
      when Result::Err(res_errors) then
        for re in res_errors do
          diags.push(Diagnostic {
            level: DiagLevel::Error,
            message: re.message,
            span: Option::Some(re.span),
            notes: Vec::new(),
            suggestions: Vec::new(),
            code: Option::Some("E0405")
          })
        end
      end
    end
    
    server.diagnostics.insert(uri, diags)
  when Option::None then ()
  end
end

# 
# LSP: Hover
# 

def lsp_hover(server: &LspServer, uri: String, position: LspPosition) -> Option[LspHoverResult]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find symbol at offset
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      var hover_text = "```tangerine\n"
      
      match symbol.kind
      when LspSymbolKind::Function | LspSymbolKind::Method then
        hover_text = hover_text + "def " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Variable | LspSymbolKind::Parameter then
        hover_text = hover_text + "let " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Struct then
        hover_text = hover_text + "struct " + symbol.name
      when LspSymbolKind::Enum then
        hover_text = hover_text + "enum " + symbol.name
      when LspSymbolKind::Trait then
        hover_text = hover_text + "trait " + symbol.name
      when LspSymbolKind::Field then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Constant then
        hover_text = hover_text + "const " + symbol.name + ": " + symbol.type_str
      when _ then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      end
      
      hover_text = hover_text + "\n```"
      
      # Add doc comment if present
      match symbol.doc_comment
      when Option::Some(doc) then
        hover_text = hover_text + "\n\n---\n\n" + doc
      when Option::None then ()
      end
      
      let range = span_to_lsp_range(content, symbol.span)
      Option::Some(LspHoverResult {
        contents: hover_text,
        range: Option::Some(range)
      })
    end
  end
end

# 
# LSP: Completion
# 

def lsp_completion(server: &LspServer, uri: String, position: LspPosition) -> Vec[LspCompletionItem]
  var items = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return items
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Get the prefix being typed
    let prefix = get_completion_prefix(content, offset)
    
    # Collect all visible symbols
    match server.symbol_tables.get(uri.clone())
    when Option::Some(symbols) then
      for sym in symbols do
        if sym.name.starts_with(prefix.clone()) then
          items.push(LspCompletionItem {
            label: sym.name.clone(),
            kind: sym.kind,
            detail: Option::Some(sym.type_str.clone()),
            documentation: sym.doc_comment.clone(),
            insert_text: sym.name.clone()
          })
        end
      end
    when Option::None then ()
    end
    
    # Add keyword completions
    let keywords = ["def", "struct", "enum", "trait", "impl", "use", "pub",
                    "let", "mut", "if", "unless", "elsif", "else", "match", "when",
                    "for", "while", "until", "loop", "break", "next", "return",
                    "true", "false", "self", "Self", "in", "do", "end",
                    "then", "module", "type", "where", "as", "unsafe",
                    "extern", "async", "await", "yield"]
    
    for kw in keywords do
      if kw.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: kw.to_string(),
          kind: LspSymbolKind::Module,  # Keyword kind
          detail: Option::Some("keyword".to_string()),
          documentation: Option::None,
          insert_text: kw.to_string()
        })
      end
    end
    
    # Add type completions from builtins
    let builtin_types = ["Int", "UInt", "Float", "Bool", "String", "Char",
                         "Unit", "Never", "Option", "Result", "Vec", "Map",
                         "Set", "Ptr", "Array"]
    
    for ty in builtin_types do
      if ty.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: ty.to_string(),
          kind: LspSymbolKind::Type,
          detail: Option::Some("type".to_string()),
          documentation: Option::None,
          insert_text: ty.to_string()
        })
      end
    end
  end
  
  items
end

# 
# LSP: Go to Definition
# 

def lsp_goto_definition(server: &LspServer, uri: String, position: LspPosition) -> Option[LspLocation]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      # Check if this symbol has a known definition location
      match symbol.definition_uri
      when Option::Some(def_uri) then
        match symbol.definition_span
        when Option::Some(def_span) then
          # Resolve the definition content for range conversion
          match server.documents.get(def_uri.clone())
          when Option::Some(def_content) then
            let range = span_to_lsp_range(def_content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          when Option::None then
            # Same document
            let range = span_to_lsp_range(content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          end
        when Option::None then Option::None
        end
      when Option::None then
        # Definition is in same file  search by name
        match find_definition_in_document(server, uri.clone(), symbol.name.clone())
        when Option::Some(def_symbol) then
          let range = span_to_lsp_range(content, def_symbol.span)
          Option::Some(LspLocation { uri: uri, range: range })
        when Option::None then Option::None
        end
      end
    end
  end
end

# 
# LSP: References
# 

def lsp_references(server: &LspServer, uri: String, position: LspPosition, include_declaration: Bool) -> Vec[LspLocation]
  var locations = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return locations
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then return locations
    when Option::Some(target_symbol) then
      # Search all open documents for references to this symbol
      for entry in server.symbol_tables do
        let doc_uri = entry.key
        let symbols = entry.value
        
        match server.documents.get(doc_uri.clone())
        when Option::Some(doc_content) then
          for sym in symbols do
            if sym.name == target_symbol.name then
              let is_declaration = match sym.kind
                  when LspSymbolKind::Function then true
                  when LspSymbolKind::Struct then true
                  when LspSymbolKind::Enum then true
                  when LspSymbolKind::Trait then true
                  when LspSymbolKind::Method then true
                  when LspSymbolKind::Variable then true
                  when LspSymbolKind::Constant then true
                  when LspSymbolKind::Field then true
                  when LspSymbolKind::Type then true
                  when LspSymbolKind::Module then true
              when _ then false
              end
              
              if include_declaration || !is_declaration then
                let range = span_to_lsp_range(doc_content, sym.span)
                locations.push(LspLocation { uri: doc_uri.clone(), range: range })
              end
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  locations
end

# 
# LSP: Rename
# 

def lsp_rename(server: &LspServer, uri: String, position: LspPosition, new_name: String) -> Vec[LspTextEdit]
  var edits = Vec::new()
  
  # Find all references and create edits
  let refs = lsp_references(server, uri, position, true)
  
  for loc in refs do
    edits.push(LspTextEdit {
      uri: loc.uri,
      range: loc.range,
      new_text: new_name.clone()
    })
  end
  
  edits
end

# 
# LSP: Signature Help
# 

def lsp_signature_help(server: &LspServer, uri: String, position: LspPosition) -> Option[LspSignatureHelp]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find the enclosing function call
    let (func_name, active_param) = find_enclosing_call(content, offset)
    
    match func_name
    when Option::None then return Option::None
    when Option::Some(name) then
      # Look up the function signature
      match find_definition_in_document(server, uri.clone(), name.clone())
      when Option::None then Option::None
      when Option::Some(sym) then
        # Parse the type string to extract parameters
        let params = parse_function_params(sym.type_str.clone())
        
        var param_infos = Vec::new()
        for p in params do
          param_infos.push(LspParameterInfo {
            label: p.clone(),
            documentation: Option::None
          })
        end
        
        let signature = LspSignature {
          label: sym.name.clone() + ": " + sym.type_str.clone(),
          documentation: sym.doc_comment.clone(),
          parameters: param_infos
        }
        
        Option::Some(LspSignatureHelp {
          signatures: vec![signature],
          active_signature: 0,
          active_parameter: active_param
        })
      end
    end
  end
end

# 
# LSP: Code Actions
# 

def lsp_code_actions(server: &LspServer, uri: String, range: LspRange) -> Vec[LspCodeAction]
  var actions = Vec::new()
  
  # Check if there are diagnostics in this range with suggestions
  match server.diagnostics.get(uri.clone())
  when Option::None then return actions
  when Option::Some(diags) then
    match server.documents.get(uri.clone())
    when Option::None then return actions
    when Option::Some(content) then
      let range_start = lsp_position_to_offset(content, range.start)
      let range_end = lsp_position_to_offset(content, range.end_pos)
      
      for diag in diags do
        match diag.span
        when Option::Some(span) then
          if span.start >= range_start && span.end_pos <= range_end then
            # Generate fix-it actions from suggestions
            for sugg in diag.suggestions do
              let edit_range = span_to_lsp_range(content, sugg.span)
              var action_diags = Vec::new()
              action_diags.push(diag.clone())
              actions.push(LspCodeAction {
                title: sugg.message.clone(),
                kind: "quickfix".to_string(),
                diagnostics: action_diags,
                edit: Option::Some(LspTextEdit {
                  uri: uri.clone(),
                  range: edit_range,
                  new_text: sugg.replacement.clone()
                })
              })
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  actions
end

# 
# LSP: Format Document
# 

def lsp_format(server: &LspServer, uri: String) -> Option[String]
  match server.documents.get(uri)
  when Option::None then Option::None
  when Option::Some(content) then
    let config = default_format_config()
    match format_source(content.clone(), &config)
    when Result::Ok(formatted) then Option::Some(formatted)
    when Result::Err(_e) then Option::Some(content.clone())
    end
  end
end

# 
# LSP: Main Loop (JSON-RPC over stdio)
# 

def lsp_main_loop(server: &mut LspServer) -> Unit
  # LSP protocol: read Content-Length header, then JSON-RPC body
  loop
    # Read header
    let header = read_lsp_header()
    match header
    when Option::None then break  # EOF
    when Option::Some(content_length) then
      # Read body
      let body = read_lsp_body(content_length)
      
      # Parse JSON-RPC request
      let response = handle_lsp_request(server, body)
      
      # Send response
      match response
      when Option::Some(resp) then
        send_lsp_response(resp)
      when Option::None then ()
      end
    end
  end
end

def read_lsp_header() -> Option[UInt]
  # Read "Content-Length: N\r\n\r\n"
  var header = ""
  loop
    let line = read_line().unwrap_or("")
    if line.is_empty() then break end
    header = header + line + "\n"
    if line == "\r" || line == "" then break end
  end
  
  # Parse Content-Length
  for line in header.lines() do
    if line.starts_with("Content-Length:") then
      let val = line.slice(15, line.len()).trim()
      return Option::Some(val.parse_uint().unwrap_or(0))
    end
  end
  
  Option::None
end

def read_lsp_body(length: UInt) -> String
  var bytes = Vec::with_capacity(length)
  var i = 0
  while i < length do
    bytes.push(0u8)
    i = i + 1
  end
  let n = std::fs::read(0, bytes.as_mut_ptr(), length as Int)
  if n as UInt < length then
    # Handle partial read or error
    ()
  end
  String::from_bytes(bytes)
end

def read_line_impl() -> String
  match std::io::read_line()
  when Result::Ok(s) then s
  when Result::Err(_) then ""
  end
end

def read_bytes_impl(n: UInt) -> String
  var bytes = Vec::with_capacity(n)
  var i = 0
  while i < n do
    bytes.push(0)
    i = i + 1
  end
  let read_count = std::fs::read(0, bytes.as_ptr(), n as Int)
  if read_count <= 0 then
    return ""
  end
  String::from_bytes(bytes.slice(0, read_count as Int))
end

def send_lsp_response(body: String) -> Unit
  let header = "Content-Length: " + body.len().to_string() + "\r\n\r\n"
  print(header + body)
end

def handle_lsp_request(server: &mut LspServer, body: String) -> Option[String]
  # Minimal JSON-RPC parsing
  let method = extract_json_string(body.clone(), "method")
  let id = extract_json_value(body.clone(), "id")
  
  match method
  when Option::None then Option::None
  when Option::Some(m) then
    if m == "initialize" then
      # Send capabilities
      let result = "{\"capabilities\":{" +
        "\"textDocumentSync\":1," +
        "\"hoverProvider\":true," +
        "\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]}," +
        "\"definitionProvider\":true," +
        "\"referencesProvider\":true," +
        "\"renameProvider\":true," +
        "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}," +
        "\"documentFormattingProvider\":true," +
        "\"codeActionProvider\":true" +
        "},\"serverInfo\":{\"name\":\"tangerine-ls\",\"version\":\"" + VERSION + "\"}}"
      make_json_rpc_response(id, result)
    elsif m == "initialized" then
      Option::None  # Notification, no response
    elsif m == "textDocument/didOpen" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let text = extract_nested_json_string(body.clone(), "textDocument", "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_open(server, u, t)
      when _ then ()
      end
      Option::None  # Notification
    elsif m == "textDocument/didChange" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      # Get full content from contentChanges[0].text
      let text = extract_json_string(body.clone(), "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_change(server, u, t)
      when _ then ()
      end
      Option::None
    elsif m == "textDocument/hover" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_hover(server, u, pos)
        when Option::Some(hover) then
          let result = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" +
            json_escape(hover.contents) + "\"}}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/completion" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let items = lsp_completion(server, u, pos)
        var result = "{\"isIncomplete\":false,\"items\":["
        var first = true
        for item in items do
          if !first then result = result + "," end
          result = result + "{\"label\":\"" + json_escape(item.label) + "\""
          match item.detail
          when Option::Some(d) then
            result = result + ",\"detail\":\"" + json_escape(d) + "\""
          when Option::None then ()
          end
          result = result + ",\"insertText\":\"" + json_escape(item.insert_text) + "\"}"
          first = false
        end
        result = result + "]}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "{\"isIncomplete\":false,\"items\":[]}".to_string())
      end
    elsif m == "textDocument/definition" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_goto_definition(server, u, pos)
        when Option::Some(loc) then
          let result = "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/references" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let refs = lsp_references(server, u, pos, true)
        var result = "["
        var first = true
        for loc in refs do
          if !first then result = result + "," end
          result = result + "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          first = false
        end
        result = result + "]"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "textDocument/rename" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      let new_name = extract_json_string(body.clone(), "newName")
      match (uri, line, character, new_name)
      when (Option::Some(u), Option::Some(l), Option::Some(c), Option::Some(name)) then
        let pos = LspPosition { line: l, character: c }
        let edits = lsp_rename(server, u, pos, name)
        # Group edits by URI
        var changes = Map::new()
        for edit in edits do
          match changes.get(edit.uri.clone())
          when Option::Some(existing) then
            existing.push(edit)
          when Option::None then
            var first_edits = Vec::new()
            first_edits.push(edit)
            changes.insert(edit.uri.clone(), first_edits)
          end
        end
        
        var result = "{\"changes\":{"
        var first_uri = true
        for entry in changes do
          if !first_uri then result = result + "," end
          result = result + "\"" + json_escape(entry.key) + "\":["
          var first_edit = true
          for edit in entry.value do
            if !first_edit then result = result + "," end
            result = result + "{\"range\":" + lsp_range_to_json(&edit.range) + ","
            result = result + "\"newText\":\"" + json_escape(edit.new_text) + "\"}"
            first_edit = false
          end
          result = result + "]"
          first_uri = false
        end
        result = result + "}}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/signatureHelp" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_signature_help(server, u, pos)
        when Option::Some(help) then
          var result = "{\"signatures\":["
          var first = true
          for sig in help.signatures do
            if !first then result = result + "," end
            result = result + "{\"label\":\"" + json_escape(sig.label) + "\""
            result = result + ",\"parameters\":["
            var first_p = true
            for p in sig.parameters do
              if !first_p then result = result + "," end
              result = result + "{\"label\":\"" + json_escape(p.label) + "\"}"
              first_p = false
            end
            result = result + "]}"
            first = false
          end
          result = result + "],\"activeSignature\":" + help.active_signature.to_string()
          result = result + ",\"activeParameter\":" + help.active_parameter.to_string() + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/formatting" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      match uri
      when Option::Some(u) then
        match lsp_format(server, u.clone())
        when Option::Some(formatted) then
          match server.documents.get(u)
          when Option::Some(content) then
            let total_lines = count_lines(content)
            let end_col = last_line_length(content)
            let range = LspRange {
              start: LspPosition { line: 0, character: 0 },
              end_pos: LspPosition { line: total_lines, character: end_col }
            }
            let result = "[{\"range\":" + lsp_range_to_json(&range) + "," +
              "\"newText\":\"" + json_escape(formatted) + "\"}]"
            make_json_rpc_response(id, result)
          when Option::None then
            make_json_rpc_response(id, "[]".to_string())
          end
        when Option::None then
          make_json_rpc_response(id, "[]".to_string())
        end
      when Option::None then
        make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "shutdown" then
      make_json_rpc_response(id, "null".to_string())
    elsif m == "exit" then
      Option::None  # Exit the loop
    else
      # Unknown method
      Option::None
    end
  end
end

# 
# LSP Helpers
# 

def build_symbol_table(ast: &Program, uri: String) -> Vec[LspSymbol]
  var symbols = Vec::new()
  
  for item in ast.items do
    match item.kind
    when ItemKind::ItemFunction(func) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: func.name.clone(),
        kind: LspSymbolKind::Function,
        span: item.span,
        type_str: format_function_type(&func),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      # Add parameters
      for param in func.params do
        let param_type_str = match param.ty
          when Option::Some(t) then fmt_type_expr_to_string(t)
          when Option::None then "?"
        end
        symbols.push(LspSymbol {
          name: param.name.clone(),
          kind: LspSymbolKind::Parameter,
          span: param.span,
          type_str: param_type_str,
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(param.span)
        })
      end
    when ItemKind::ItemStruct(s) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: s.name.clone(),
        kind: LspSymbolKind::Struct,
        span: item.span,
        type_str: s.name.clone(),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for field in s.fields do
        symbols.push(LspSymbol {
          name: field.name.clone(),
          kind: LspSymbolKind::Field,
          span: field.span,
          type_str: fmt_type_expr_to_string(&field.ty),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(field.span)
        })
      end
    when ItemKind::ItemEnum(e) then
      symbols.push(LspSymbol {
        name: e.name.clone(),
        kind: LspSymbolKind::Enum,
        span: item.span,
        type_str: e.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when ItemKind::ItemTrait(t) then
      symbols.push(LspSymbol {
        name: t.name.clone(),
        kind: LspSymbolKind::Trait,
        span: item.span,
        type_str: t.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for method in t.methods do
        symbols.push(LspSymbol {
          name: method.sig.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_sig_type(&method.sig),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::ItemImpl(imp) then
      for method in imp.methods do
        symbols.push(LspSymbol {
          name: method.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_type(&method),
          doc_comment: extract_doc_comment_before(ast, method.span),
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::ItemConst(c) then
      symbols.push(LspSymbol {
        name: c.name.clone(),
        kind: LspSymbolKind::Constant,
        span: item.span,
        type_str: match c.ty
          when Option::Some(t) then fmt_type_expr_to_string(&t)
          when Option::None then "?"
        end,
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when _ then ()
    end
  end
  
  symbols
end

def find_symbol_at(server: &LspServer, uri: String, offset: UInt) -> Option[&LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    # Find the most specific (smallest span) symbol containing the offset
    var best: Option[&LspSymbol] = Option::None
    var best_span_size: UInt = 18446744073709551615u64
    
    for sym in symbols do
      if offset >= sym.span.start && offset <= sym.span.end_pos then
        let span_size = sym.span.end_pos - sym.span.start
        if span_size < best_span_size then
          best = Option::Some(sym)
          best_span_size = span_size
        end
      end
    end
    
    best
  end
end

def find_definition_in_document(server: &LspServer, uri: String, name: String) -> Option[&LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    for sym in symbols do
      if sym.name == name then
        match sym.kind
        when LspSymbolKind::Function then
          return Option::Some(sym)
        when LspSymbolKind::Struct then
          return Option::Some(sym)
        when LspSymbolKind::Enum then
          return Option::Some(sym)
        when LspSymbolKind::Trait then
          return Option::Some(sym)
        when LspSymbolKind::Constant then
          return Option::Some(sym)
        when _ then ()
        end
      end
    end
    Option::None
  end
end

def position_to_offset(content: &String, pos: LspPosition) -> UInt
  lsp_position_to_offset(content, pos)
end

def lsp_position_to_offset(content: &String, pos: LspPosition) -> UInt
  var offset: UInt = 0
  var line: UInt = 0
  
  while offset < content.len() && line < pos.line do
    if content.char_at(offset) == '\n' then
      line = line + 1
    end
    offset = offset + 1
  end
  
  offset + pos.character
end

def span_to_lsp_range(content: &String, span: Span) -> LspRange
  let start = offset_to_lsp_position(content, span.start)
  let end_pos = offset_to_lsp_position(content, span.end_pos)
  LspRange { start: start, end_pos: end_pos }
end

def offset_to_lsp_position(content: &String, offset: UInt) -> LspPosition
  var line: UInt = 0
  var col: UInt = 0
  var i: UInt = 0
  
  while i < offset && i < content.len() do
    if content.char_at(i) == '\n' then
      line = line + 1
      col = 0
    else
      col = col + 1
    end
    i = i + 1
  end
  
  LspPosition { line: line, character: col }
end

def get_completion_prefix(content: &String, offset: UInt) -> String
  # Walk backwards from offset to find identifier start
  var start = offset
  while start > 0 do
    let c = content.char_at(start - 1)
    if c.is_alphanumeric() || c == '_' then
      start = start - 1
    else
      break
    end
  end
  
  if start < offset then
    content.slice(start, offset)
  else
    "".to_string()
  end
end

def find_enclosing_call(content: &String, offset: UInt) -> (Option[String], UInt)
  # Walk backwards from offset to find the function name before '('
  var depth = 0
  var param_count: UInt = 0
  var i = offset
  var in_string = false
  var in_char = false
  
  while i > 0 do
    i = i - 1
    let c = content.char_at(i)
    
    # Track string/char literal boundaries (backward scan)
    # Skip escaped quotes by checking if preceded by backslash
    if c == '"' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_string = !in_string
      next
    end
    if c == '\'' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_char = !in_char
      next
    end
    if in_string || in_char then next end
    
    if c == ')' then depth = depth + 1
    elsif c == '(' then
      if depth == 0 then
        # Found the opening paren  get function name before it
        var end_pos = i
        while end_pos > 0 && (content.char_at(end_pos - 1).is_alphanumeric() || content.char_at(end_pos - 1) == '_') do
          end_pos = end_pos - 1
        end
        if end_pos < i then
          let name = content.slice(end_pos, i)
          return (Option::Some(name), param_count)
        end
        return (Option::None, 0)
      end
      depth = depth - 1
    elsif c == ',' && depth == 0 then
      param_count = param_count + 1
    end
  end
  
  (Option::None, 0)
end

def parse_function_params(type_str: String) -> Vec[String]
  # Parse "(T1, T2) -> R" format
  var params = Vec::new()
  
  if !type_str.starts_with("(") then return params end
  
  let close = type_str.index_of(")")
  match close
  when Option::None then return params
  when Option::Some(idx) then
    let inner = type_str.slice(1, idx)
    if inner.is_empty() then return params end
    
    for part in inner.split(",") do
      params.push(part.trim().to_string())
    end
  end
  
  params
end

def format_function_type(func: &FunctionDecl) -> String
  var result = "("
  var first = true
  for param in func.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then fmt_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match func.ret_type
  when Option::Some(rt) then result = result + fmt_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def format_function_sig_type(sig: &FunctionSig) -> String
  var result = "("
  var first = true
  for param in sig.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then fmt_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match sig.ret_type
  when Option::Some(rt) then result = result + fmt_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def extract_doc_comment_before(ast: &Program, span: Span) -> Option[String]
  # Program does not carry the source text, so doc-comment extraction cannot
  # scan backwards from the span. Return None (LSP doc comments are optional);
  # the extraction can be re-enabled when Program carries source text.
  Option::None
end
def make_json_rpc_response(id: Option[String], result: String) -> Option[String]
  match id
  when Option::None then Option::None
  when Option::Some(req_id) then
    Option::Some("{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":" + result + "}")
  end
end

def extract_json_string(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    # Skip whitespace
    var pos = start
    while pos < json.len() && (json.char_at(pos) == ' ' || json.char_at(pos) == '\t') do
      pos = pos + 1
    end
    if pos < json.len() && json.char_at(pos) == '"' then
      pos = pos + 1
      var end_pos = pos
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      Option::Some(json.slice(pos, end_pos))
    else
      Option::None
    end
  end
end

def extract_json_value(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    var pos = start
    while pos < json.len() && json.char_at(pos) == ' ' do pos = pos + 1 end
    
    var end_pos = pos
    let first_char = json.char_at(pos)
    if first_char == '"' then
      # String value
      end_pos = pos + 1
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      end_pos = end_pos + 1
    elsif first_char == '{' || first_char == '[' then
      # Object/array  find matching close
      var depth = 1
      end_pos = pos + 1
      while end_pos < json.len() && depth > 0 do
        let c = json.char_at(end_pos)
        if c == '{' || c == '[' then depth = depth + 1
        elsif c == '}' || c == ']' then depth = depth - 1
        end
        end_pos = end_pos + 1
      end
    else
      # Number/bool/null
      while end_pos < json.len() && json.char_at(end_pos) != ',' && json.char_at(end_pos) != '}' && json.char_at(end_pos) != ']' do
        end_pos = end_pos + 1
      end
    end
    
    Option::Some(json.slice(pos, end_pos).trim().to_string())
  end
end

def extract_nested_json_string(json: String, outer_key: String, inner_key: String) -> Option[String]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    extract_json_string(inner_json, inner_key)
  end
end

def extract_nested_json_uint(json: String, outer_key: String, inner_key: String) -> Option[UInt]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    match extract_json_value(inner_json, inner_key)
    when Option::None then Option::None
    when Option::Some(val) then
      Option::Some(val.parse_uint().unwrap_or(0))
    end
  end
end

def lsp_range_to_json(range: &LspRange) -> String
  "{\"start\":{\"line\":" + range.start.line.to_string() + ",\"character\":" + range.start.character.to_string() + "}," +
  "\"end\":{\"line\":" + range.end_pos.line.to_string() + ",\"character\":" + range.end_pos.character.to_string() + "}}"
end

def count_lines(content: &String) -> UInt
  var count: UInt = 0
  for c in content.chars() do
    if c == '\n' then count = count + 1 end
  end
  count
end

def last_line_length(content: &String) -> UInt
  var len: UInt = 0
  var i = content.len()
  while i > 0 do
    i = i - 1
    if content.char_at(i) == '\n' then break end
    len = len + 1
  end
  len
end
