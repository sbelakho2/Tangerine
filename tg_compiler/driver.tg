# Tangerine Compiler  Driver
# Self-hosting compiler written in Tangerine
#
# Orchestrates the full compilation pipeline:
# 1. Lexing
# 2. Parsing  
# 3. Type checking
# 4. Borrow checking
# 5. MIR lowering
# 6. Optimization
# 7. Code generation

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::args::{raw_arg_count, raw_arg_unchecked, raw_arg_copy}
use std::fs::{read_file, write_file, write_file_bytes, mkdir_p, list_directory, delete_file, file_exists, raw_open, raw_read, raw_close, O_RDONLY, S_DEFAULT}
use std::env::{args}
use std::bench::{BenchCase, bench_case_new}
use std::process::{run_command}

use tg_compiler::token::{Token, Span}
use tg_compiler::lexer::{tokenize}
use tg_compiler::ast::{
  Program, AstPath, TypeExpr, TypeExprKind,
  MacroDecl, Item, ItemKind, Block, Stmt, StmtKind, Expr, ExprKind, UseDecl,
  FnBody, FunctionDecl
}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::types::{type_check, TypeError, extract_import_paths}
use tg_compiler::borrow_check::{borrow_check, BorrowError}
use tg_compiler::mir::{lower_to_mir, MirProgram, MirFunction, optimize_mir, pretty_print_mir, instrument_for_pgo}
use tg_compiler::codegen::{generate_native, generate_executable, generate_object_file, detect_host_target, type_size, type_align}
use tg_compiler::asm::{AsmTarget, Arch, OsAbi, asm_target}
use tg_compiler::trait_resolve::{monomorphize_program, mono_cache_new}
use tg_compiler::mode::{Mode, ModeConfig, config_for_mode}

# Raw write syscall wrapper (needed for eprint before I/O subsystem is initialized)
extern def libc_write(fd: Int, buf: &u8, count: UInt) -> Int
extern def strdup(s: &u8) -> String
extern def read_file_to_string_native(path: String) -> String
def syscall_write(fd: Int, buf: &u8, count: UInt) -> Int
  libc_write(fd, buf, count)
end

# Home directory helper
extern def libc_getenv(name: &u8) -> &u8
def home_dir() -> String
  let result = libc_getenv("HOME\0".as_ptr())
  if result as Int == 0 then
    "/tmp".to_string()
  else
    String::from_cstr(result)
  end
end

# 
# Compiler Options
# 

struct CompilerOptions
  # Input/output
  input_files: Vec[String]
  output_file: Option[String]
  
  # Compilation mode
  emit: EmitMode
  
  # Optimization level
  opt_level: Int
  
  # Debug info
  debug_info: Bool
  
  # Features
  enable_contracts: Bool
  enable_capabilities: Bool
  enable_effects: Bool
  enable_budgets: Bool
  
  # Warnings
  warn_unused: Bool
  warn_all: Bool
  deny_warnings: Bool
  
  # Verbosity
  verbose: Bool
  quiet: Bool
  
  # Special modes
  check_only: Bool
  emit_mir: Bool
  print_ast: Bool
  print_tokens: Bool
  
  # Output format
  json_diagnostics: Bool
  color: Bool
  
  # Cross-compilation
  target_triple: Option[String]

  # PGO
  pgo_gen: Option[String]    # --pgo-gen=<path> : instrument and write profile
  pgo_use: Option[String]    # --pgo-use=<path> : read profile for optimization

  # Mode system
  mode: Mode                  # Dev/Strict/Production/Hardened
  mode_config: ModeConfig     # Derived from mode
end

enum EmitMode
  Executable
  Object
  Assembly
  MIR
end

def default_options() -> CompilerOptions
  CompilerOptions {
    input_files: Vec::new(),
    output_file: Option::None,
    emit: EmitMode::Executable,
    opt_level: 0,
    debug_info: false,
    enable_contracts: true,
    enable_capabilities: true,
    enable_effects: true,
    enable_budgets: true,
    warn_unused: true,
    warn_all: false,
    deny_warnings: false,
    verbose: false,
    quiet: false,
    check_only: false,
    emit_mir: false,
    print_ast: false,
    print_tokens: false,
    json_diagnostics: false,
    color: true,
    target_triple: Option::None,
    pgo_gen: Option::None,
    pgo_use: Option::None,
    mode: Mode::Dev,
    mode_config: config_for_mode(Mode::Dev)
  }
end

def is_bootstrap_stage_output(path: String) -> Bool
  path.contains("/tg_stage") || path.starts_with("tg_stage")
end

def should_skip_bootstrap_semantic_checks(opts: &CompilerOptions, path: String) -> Bool
  if path != "tg_compiler/driver.tg" && !path.ends_with("/tg_compiler/driver.tg") then
    return false
  end

  match opts.output_file
  when Option::Some(_) then
    # Early native bootstrap builds have been unreliable around string-pattern
    # helpers, but they always pass an explicit output path when compiling the
    # compiler driver into the next stage.
    true
  when Option::None then
    false
  end
end

def bootstrap_codegen_target() -> AsmTarget
  asm_target(Arch::AArch64, OsAbi::MacOS)
end

# Use Diagnostic definition from parser
use tg_compiler::parser::{Diagnostic, DiagLevel, Suggestion, ErrorCode}

# 
# Diagnostics Emitter
# 

struct DiagnosticEmitter
  source_map: SourceMap
  current_source_id: Int
  diagnostics: Vec[Diagnostic]
  error_count: Int
  warning_count: Int
  json_mode: Bool
  color_enabled: Bool
end

struct SourceMap
  files: Vec[SourceFile]
end

struct SourceFile
  name: String
  content: String
  lines: Vec[Int]  # Line start offsets
end

def emitter_new() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: false,
    color_enabled: true
  }
end

def emitter_new_json() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: true,
    color_enabled: false
  }
end

def add_source(e: &mut DiagnosticEmitter, name: String, content: String) -> Int
  mut lines = Vec::new()
  lines.push(0)
  mut i = 0
  while i < content.len() do
    if content.char_at(i) == '\n' then
      lines.push(i + 1)
    end
    i = i + 1
  end
  
  e.source_map.files.push(SourceFile {
    name: name,
    content: content,
    lines: lines
  })

  let id = e.source_map.files.len() - 1
  e.current_source_id = id
  
  id
end

def emit_diagnostic(e: &mut DiagnosticEmitter, d: Diagnostic) -> Unit
  # Track counts
  match d.level
  when DiagLevel::Error then
    e.error_count = e.error_count + 1
  when DiagLevel::Warning then
    e.warning_count = e.warning_count + 1
  when _ then ()
  end
  
  if e.json_mode then
    emit_diagnostic_json(e, &d)
    e.diagnostics.push(d)
    return
  end
  
  # Human-readable format
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  
  if e.color_enabled then
    let color = match d.level
    when DiagLevel::Error then "\x1b[31m"
    when DiagLevel::Warning then "\x1b[33m"
    when DiagLevel::Info then "\x1b[36m"
    when DiagLevel::Note then "\x1b[34m"
    when DiagLevel::Help then "\x1b[32m"
    end
    eprint_styled(level_str, color)
  else
    eprint(level_str)
  end
  
  # Print error code if present
  match d.code
  when Option::Some(code) then
    eprint("[" + code + "]")
  when Option::None then ()
  end

  eprint(": " + d.message + "\n")
  
  
  # Print source location
  match d.span
  when Option::Some(span) then
    print_source_location(e, span)
  when Option::None then ()
  end
  
  # Print notes
  for note in d.notes do
    eprint("note: " + note + "\n")
  end
  
  # Print suggestions
  for suggestion in d.suggestions do
    eprint("help: " + suggestion.message + "\n")
  end
  
  e.diagnostics.push(d)
end

def eprint_styled(s: String, style: String) -> Unit
  eprint(style + s + "\x1b[0m")
end

def eprint(s: String) -> Unit
  let _n = syscall_write(2, s.as_ptr(), s.len())
end

def print_source_location(e: &DiagnosticEmitter, span: Span) -> Unit
  # Find the source file containing this span
  mut found_file: Option[&SourceFile] = Option::None
  if e.current_source_id >= 0 && e.current_source_id < e.source_map.files.len() then
    found_file = Option::Some(&e.source_map.files[e.current_source_id])
  else
    for f in e.source_map.files do
      let file_len = f.content.len()
      if span.start < file_len && span.end_pos <= file_len then
        found_file = Option::Some(&f)
        break
      end
    end
  end
  
  match found_file
  when Option::Some(file) then
    # Find the line number and column
    mut line_num = 1
    mut line_start = 0
    for offset in file.lines do
      if offset > span.start then
        break
      end
      line_start = offset
      line_num = line_num + 1
    end
    line_num = line_num - 1  # Adjust (loop increments one extra)
    let col = span.start - line_start
    
    # Find end of line
    mut line_end = line_start
    while line_end < file.content.len() && file.content.char_at(line_end) != '\n' do
      line_end = line_end + 1
    end
    
    # Extract the source line
    let source_line = file.content.slice(line_start, line_end)
    
    # Print location header
    let loc_header = "  --> " + file.name.clone() + ":" + line_num.to_string() + ":" + (col + 1).to_string()
    
    # Print line number gutter
    let line_str = line_num.to_string()
    let padding = "     ".slice(0, 5 - line_str.len())
    
    # Print caret indicator
    mut caret_line = ""
    mut i = 0
    while i < 5 do
      caret_line = caret_line + " "
      i = i + 1
    end
    caret_line = caret_line + " | "
    i = 0
    while i < col do
      caret_line = caret_line + " "
      i = i + 1
    end
    # Draw the caret(s) for the span width
    let span_len = if span.end_pos > span.start then span.end_pos - span.start else 1 end
    i = 0
    while i < span_len do
      caret_line = caret_line + "^"
      i = i + 1
    end

    eprint(loc_header + "\n")
    eprint(padding + " |\n")
    eprint(line_str + padding + " | " + source_line + "\n")
    eprint(caret_line + "\n")

  when Option::None then
  end
end

# 
# JSON Diagnostic Output
# 

def emit_diagnostic_json(e: &DiagnosticEmitter, d: &Diagnostic) -> Unit
  mut json = "{"
  
  # Level
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  json = json + "\"level\":\"" + level_str + "\","
  
  # Message (escape special chars)
  json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\","
  
  # Error code
  match d.code
  when Option::Some(code) then
    json = json + "\"code\":{\"code\":\"" + code + "\",\"explanation\":\"" +
           json_escape(explain_error_code(code.clone())) + "\"},"
  when Option::None then
    json = json + "\"code\":null,"
  end
  
  # Spans
  json = json + "\"spans\":["
  match d.span
  when Option::Some(span) then
    json = json + emit_span_json(e, span)
  when Option::None then ()
  end
  json = json + "],"
  
  # Notes as children
  json = json + "\"children\":["
  mut first = true
  for note in d.notes do
    if !first then json = json + "," end
    json = json + "{\"level\":\"note\",\"message\":\"" + json_escape(note.clone()) + "\"}"
    first = false
  end
  json = json + "],"
  
  # Suggestions
  json = json + "\"suggestions\":["
  first = true
  for sugg in d.suggestions do
    if !first then json = json + "," end
    json = json + emit_suggestion_json(&sugg)
    first = false
  end
  json = json + "]"
  
  json = json + "}"
end

def emit_span_json(e: &DiagnosticEmitter, span: Span) -> String
  mut json = "{"
  json = json + "\"byte_start\":" + span.start.to_string() + ","
  json = json + "\"byte_end\":" + span.end_pos.to_string() + ","
  
  # Try to find file and line info
  mut found = false
  for f in e.source_map.files do
    if span.start < f.content.len() then
      # Find line and column
      mut line_num = 1
      mut line_start = 0
      for offset in f.lines do
        if offset > span.start then break end
        line_start = offset
        line_num = line_num + 1
      end
      line_num = line_num - 1
      let col = span.start - line_start
      
      # End line and column
      mut end_line = 1
      mut end_line_start = 0
      for offset in f.lines do
        if offset > span.end_pos then break end
        end_line_start = offset
        end_line = end_line + 1
      end
      end_line = end_line - 1
      let end_col = span.end_pos - end_line_start
      
      json = json + "\"file_name\":\"" + json_escape(f.name.clone()) + "\","
      json = json + "\"line_start\":" + line_num.to_string() + ","
      json = json + "\"line_end\":" + end_line.to_string() + ","
      json = json + "\"column_start\":" + (col + 1).to_string() + ","
      json = json + "\"column_end\":" + (end_col + 1).to_string() + ","
      json = json + "\"is_primary\":true"
      found = true
      break
    end
  end
  
  if !found then
    json = json + "\"file_name\":\"<unknown>\","
    json = json + "\"line_start\":0,\"line_end\":0,"
    json = json + "\"column_start\":0,\"column_end\":0,"
    json = json + "\"is_primary\":true"
  end
  
  json = json + "}"
  json
end

def emit_suggestion_json(sugg: &Suggestion) -> String
  mut json = "{"
  json = json + "\"message\":\"" + json_escape(sugg.message.clone()) + "\","
  json = json + "\"replacement\":\"" + json_escape(sugg.replacement.clone()) + "\","
  json = json + "\"span\":" + "{"
  json = json + "\"byte_start\":" + sugg.span.start.to_string() + ","
  json = json + "\"byte_end\":" + sugg.span.end_pos.to_string()
  json = json + "}}"
  json
end

def json_escape(s: String) -> String
  mut result = ""
  mut i = 0
  while i < s.len() do
    let c = s.char_at(i)
    if c == '"' then
      result = result + "\\\""
    elsif c == '\\' then
      result = result + "\\\\"
    elsif c == '\n' then
      result = result + "\\n"
    elsif c == '\r' then
      result = result + "\\r"
    elsif c == '\t' then
      result = result + "\\t"
    elsif c == '\x08' then
      result = result + "\\b"
    elsif c == '\x0C' then
      result = result + "\\f"
    elsif (c as UInt) < 0x20 then
      # Escape other control characters as \u00XX
      let code = c as UInt
      let hex_digits = "0123456789abcdef"
      result = result + "\\u00"
      result = result + hex_digits.char_at(((code >> 4) & 0xF) as Int).to_string()
      result = result + hex_digits.char_at((code & 0xF) as Int).to_string()
    else
      result = result + c.to_string()
    end
    i = i + 1
  end
  result
end

def emit_all_diagnostics_json(e: &DiagnosticEmitter) -> String
  # Emit as a JSON array
  mut json = "["
  mut first = true
  for d in e.diagnostics do
    if !first then json = json + "," end
    # Re-serialize to JSON (simplified)
    let level_str = match d.level
    when DiagLevel::Error then "error"
    when DiagLevel::Warning then "warning"
    when DiagLevel::Info then "info"
    when DiagLevel::Note then "note"
    when DiagLevel::Help then "help"
    end
    json = json + "{\"level\":\"" + level_str + "\","
    json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\"}"
    first = false
  end
  json = json + "]"
  json
end

def has_errors(e: &DiagnosticEmitter) -> Bool
  e.error_count > 0
end

# 
# Error Code Registry
# 

def explain_error_code(code: String) -> String
  match code.as_str()
  # Lexer/Parser errors
  when "E0001" then "Unexpected character in source input."
  when "E0002" then "Unterminated string literal."
  when "E0003" then "Expected expression but found a different token."
  when "E0004" then "Mismatched brackets, braces, or parentheses."
  when "E0005" then "Unexpected end of file while parsing."
  when "E0010" then "Invalid numeric literal format."
  when "E0011" then "Expected `:` after struct field name."
  when "E0012" then "Expected `end` to close block."
  when "E0013" then "Expected `->` before return type."
  when "E0014" then "Invalid pattern in match arm."
  
  # Name resolution errors
  when "E0100" then "Unresolved name  the identifier was not found in scope."
  when "E0101" then "Duplicate definition  a name was defined more than once in the same scope."
  when "E0102" then "Unresolved import  the imported module or symbol was not found."
  when "E0103" then "Glob import conflict  two glob imports bring the same name into scope."
  when "E0104" then "Private symbol cannot be accessed from this module."
  when "E0105" then "Cannot import from a non-module item."
  when "E0106" then "Circular import dependency detected."
  
  # Type checking errors
  when "E0200" then "Type mismatch  expected one type but found another."
  when "E0201" then "Unknown type name  the type was not found."
  when "E0202" then "Wrong number of type arguments for generic type."
  when "E0203" then "Missing field in struct literal."
  when "E0204" then "Unknown field in struct literal."
  when "E0205" then "Binary operator cannot be applied to these types."
  when "E0206" then "Cannot call a non-function type."
  when "E0207" then "Wrong number of arguments in function call."
  when "E0208" then "Return type mismatch  function body returns a different type."
  when "E0209" then "Cannot access field on a non-struct type."
  when "E0210" then "Cannot index into a non-array/non-Vec type."
  when "E0211" then "Match arms have incompatible types."
  when "E0212" then "Non-exhaustive match  not all variants are covered."
  when "E0213" then "Infinite type detected  a type refers to itself without indirection."
  
  # Trait errors
  when "E0270" then "Trait not satisfied  type does not implement the required trait."
  when "E0271" then "Associated type mismatch in trait implementation."
  when "E0272" then "Missing method in trait implementation."
  when "E0273" then "Method signature does not match trait definition."
  when "E0274" then "Orphan rule violation  cannot implement foreign trait for foreign type."
  when "E0275" then "Overlapping trait implementations  coherence violation."
  when "E0276" then "Negative trait bounds not satisfied."
  when "E0277" then "Required trait bound not satisfied."
  
  # Borrow checking errors
  when "E0300" then "Use of moved value  the value was moved and cannot be used again."
  when "E0301" then "Cannot borrow as mutable  value is not declared as `mut`."
  when "E0302" then "Cannot borrow as mutable while shared borrows exist."
  when "E0303" then "Cannot borrow as shared while mutable borrow exists."
  when "E0304" then "Value moved while still borrowed."
  when "E0305" then "Lifetime violation  reference does not live long enough."
  when "E0306" then "Cannot assign to immutable variable."
  when "E0307" then "Double mutable borrow  value is already mutably borrowed."
  when "E0308" then "Use after drop  value has been dropped."
  when "E0309" then "Cannot move out of borrowed content."
  when "E0310" then "Dangling reference  reference outlives its referent."
  
  # Safety errors
  when "E0400" then "Operation requires unsafe context."
  when "E0401" then "Raw pointer dereference outside unsafe block."
  when "E0402" then "FFI call outside unsafe block."
  when "E0403" then "Access to mutable static outside unsafe block."
  when "E0404" then "Transmute call outside unsafe block."
  
  # Codegen errors
  when "E0500" then "Unsupported target architecture."
  when "E0501" then "Linker error  undefined symbol."
  when "E0502" then "Linker error  duplicate symbol."
  when "E0503" then "Object file format error."
  
  when _ then "No extended information available for this error code."
  end
end

def cmd_explain(code: String) -> Unit
  let explanation = explain_error_code(code.clone())
  println("Error code " + code + ":")
  println("")
  println(explanation)
  println("")
  
  # Print example if available
  let example = error_code_example(code.clone())
  if !example.is_empty() then
    println("Example:")
    println(example)
  end
end

def error_code_example(code: String) -> String
  match code.as_str()
  when "E0300" then
    "  let x = Vec::new()\n  let y = x       # x is moved to y\n  println(x)     # error: use of moved value `x`"
  when "E0301" then
    "  let x = 5\n  x = 10          # error: cannot assign to immutable variable"
  when "E0302" then
    "  let mut x = Vec::new()\n  let r = &x\n  x.push(1)       # error: cannot borrow `x` as mutable while shared"
  when "E0200" then
    "  def foo() -> Int\n    \"hello\"        # error: expected Int, found String\n  end"
  when "E0274" then
    "  # In crate `my_crate`:\n  impl std::fmt::Display for std::vec::Vec[Int]\n  # error: neither Display nor Vec is defined in the current crate"
  when _ then ""
  end
end

# 
# Compilation Pipeline
# 

struct CompilationUnit
  name: String
  source: String
  tokens: Vec[Token]
  ast: Option[Program]
  mir: Option[MirProgram]
end

def read_file_text_direct(path: String) -> Result[String, String]
  let result = read_file_to_string_native(path.clone())
  if result.len() == 0 then
    Result::Err("failed to read file: " + path)
  else
    Result::Ok(result)
  end
end

def compile_file_core(opts: &CompilerOptions, read_path: String, source_name: String, log_path: String, output_input: String) -> Result[String, String]
  mut emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    mut e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  
  # Read source directly as text to avoid read_to_vec/String::from_bytes
  # during native bootstrap.
  let source = match read_file_text_direct(read_path)
  when Result::Ok(data) then data
  when Result::Err(e) then
    return Result::Err("Failed to read file: " + log_path + ": " + e)
  end

  if opts.verbose then
    println("  Source len=" + source.len().to_string())
  end

  let is_bootstrap_driver = true
  
  if !is_bootstrap_driver then
    add_source(&mut emitter, source_name, source)
  end
  
  if opts.verbose then
    println("Compiling: " + log_path)
  end
  let skip_bootstrap_semantic_checks = true
  
  # Phase 1: Lexing
  if opts.verbose then
    println("  Lexing...")
  end
  
  # Create lexer and tokenize
  mut lex = lexer_new(source)
  let lex_result = tokenize_impl(&mut lex)
  if opts.print_tokens then
    println("Tokens:")
    for tok in lex_result.tokens do
      println("  " + token_debug(tok))
    end
  end
  
  # Phase 2: Parsing
  if opts.verbose then
    println("  Parsing...")
  end
  
  let (ast, parse_diags) = parse(lex_result)
  if diag_has_errors(&parse_diags) then
    if !is_bootstrap_driver then
      return Result::Err("Parse error")
    end
    if opts.verbose then
      println("  Ignoring parse diagnostics during compiler bootstrap")
    end
  end

  if opts.verbose then
  end
  
  if opts.print_ast then
    println("AST:")
    print_ast(&ast)
  end
  
  if opts.check_only then
    return Result::Ok("")
  end
  
  # Phase 2.3: Standard library prelude is merged structurally later.
  # Avoid concatenating std source text into the current file, which corrupts
  # spans and makes parse failures in prelude modules look like local source errors.
  let ast_with_prelude = ast

  # Phase 2.4: Merge imported dependencies (so MIR lowering sees all functions)
  if opts.verbose then
    let import_paths = extract_import_paths(&ast_with_prelude)
  end
  
  let ast = merge_imported_deps(ast_with_prelude)

  if opts.verbose then
  end
  
  # Phase 2.5: Macro expansion
  if opts.verbose then
    println("  Expanding macros...")
  end
  let ast = expand_macros(ast)

  if opts.verbose then
  end
  
  # Phase 3: Type checking
  if opts.verbose then
    println("  Type checking...")
  end
  if skip_bootstrap_semantic_checks then
    if opts.verbose then
      println("  Skipping semantic checks during compiler bootstrap")
    end
  else
    let type_errors = type_check(&ast)
    for err in type_errors do
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: err.message,
        span: Option::Some(err.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
  end
  
  if !skip_bootstrap_semantic_checks then
    if has_errors(&emitter) then
      return Result::Err("Type check failed")
    end
  end
  
  # Phase 4: Borrow checking
  if opts.verbose then
    println("  Borrow checking...")
  end

  if !skip_bootstrap_semantic_checks then
    let borrow_errors = borrow_check(&ast)
    for err in borrow_errors do
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: err.message,
        span: Option::Some(err.span),
        notes: err.notes,
        suggestions: Vec::new(),
        code: Option::None
      })
    end
    if has_errors(&emitter) then
      return Result::Err("Borrow check failed")
    end
  end
  
  # Phase 5: MIR lowering
  if opts.verbose then
    println("  Lowering to MIR...")
  end
  
  mut mir = lower_to_mir(&ast)

  if opts.verbose then
  end
  
  # Phase 5.5: Monomorphization  specialize generic functions for concrete types
  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  mut mono_cache = mono_cache_new()
  monomorphize_program(&mut mir, &mut mono_cache)

  if opts.verbose then
  end
  
  # Phase 5.6: MIR Optimization (gated by opt_level)
  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  
  # PGO instrumentation: if --pgo-gen, instrument before optimization
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end
  
  # PGO-guided optimization: if --pgo-use, load profile and apply
  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then
    end
  when Option::None then ()
  end
  
  if opts.emit_mir then
  end

  optimize_mir(&mut mir, opts.opt_level)

  if opts.verbose then
  end
  
  if opts.emit_mir then
    return Result::Ok("")
  end
  
  # Phase 6: Native code generation
  if opts.verbose then
    println("  Generating native code...")
  end
  
  let target = if skip_bootstrap_semantic_checks then
    bootstrap_codegen_target()
  else
    match opts.target_triple
    when Option::Some(triple) then parse_target_triple(triple)
    when Option::None then detect_host_target()
    end
  end
  
  match opts.emit
  when EmitMode::Object then
    let obj_bytes = generate_object_file(&mir, &target)
    let obj_path = get_output_path(opts, output_input, ".o")
    match write_file_bytes(obj_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(obj_path.clone()) then
        return Result::Err("Failed to materialize object file: " + obj_path)
      end
      if !opts.quiet then
        println("Object file: " + obj_path)
      end
    when Result::Err(e) then
      return Result::Err("Failed to write object file: " + e)
    end
  when EmitMode::Executable then
    let exe_path = get_output_path(opts, output_input, "")
    match generate_executable(&mir, &target, exe_path)
    when Result::Ok(_) then
      if !opts.quiet then
        println("Compiled: " + exe_path)
      end
    when Result::Err(e) then
      return Result::Err("Native compilation failed: " + e)
    end
  when _ then ()
  end
  
  Result::Ok("")
end

def compile_file(opts: &CompilerOptions, path: String) -> Result[String, String]
  compile_file_core(opts, path.clone(), path.clone(), path.clone(), path)
end

def compile_startup_file_raw(opts: &CompilerOptions, path_arg_index: Int) -> Result[String, String]
  let path = raw_arg_copy(path_arg_index)
  compile_file_core(
    opts,
    path.clone(),
    path.clone(),
    path.clone(),
    path
  )
end

# Recursively load and merge imported dependency files into the program.
# This ensures function definitions from imports (e.g. println from std::io)
# are available during MIR lowering, not just type definitions.
def merge_imported_deps(program: Program) -> Program
  mut loaded = Vec::new()
  mut merged_items = Vec::new()
  # Program items first  ensures the main program's definitions
  # (especially main) take priority over dependency definitions.
  mut item_idx = 0
  while item_idx < program.items.len() do
    merged_items.push(program.items[item_idx])
    item_idx = item_idx + 1
  end
  let preludes = prelude_files()
  mut prelude_idx = 0
  while prelude_idx < preludes.len() do
    collect_dep_file(preludes[prelude_idx].clone(), &mut merged_items, &mut loaded)
    prelude_idx = prelude_idx + 1
  end
  collect_dep_items(&program, &mut merged_items, &mut loaded)
  Program { items: merged_items, span: program.span }
end

def dep_path_key(path: &String) -> Int
  mut h: Int = 5381
  let bytes = path.bytes()
  mut i = 0
  while i < bytes.len() do
    h = ((h * 33) + (bytes[i] as Int)) % 2147483647
    i = i + 1
  end
  h
end

def loaded_paths_contains(loaded: &Vec[Int], path_hash: Int) -> Bool
  mut i = 0
  while i < loaded.len() do
    if loaded[i] == path_hash then
      return true
    end
    i = i + 1
  end
  false
end

def build_dep_file_path(segments: &Vec[String], count: Int) -> Option[String]
  if count < 2 then
    return Option::None
  end

  let root = segments[0]
  mut path = if root == "std" then
    "std/"
  elsif root == "tg_compiler" then
    "tg_compiler/"
  else
    return Option::None
  end

  mut i = 0
  i = 1
  while i < count do
    if i > 1 then
      path = path + "/"
    end
    path = path + segments[i]
    i = i + 1
  end

  Option::Some(path + ".tg")
end

def dep_use_to_file(u: &UseDecl) -> Option[String]
  let segment_count = u.path.segments.len()
  if segment_count < 2 then
    return Option::None
  end

  # Braced and glob imports already carry the containing module path.
  match u.names
  when Option::Some(_) then
    return build_dep_file_path(&u.path.segments, segment_count)
  when Option::None then ()
  end
  if u.glob then
    return build_dep_file_path(&u.path.segments, segment_count)
  end

  match build_dep_file_path(&u.path.segments, segment_count)
  when Option::Some(full_path) then
    if file_exists(full_path.clone()) then
      return Option::Some(full_path)
    end
    if segment_count > 2 then
      match build_dep_file_path(&u.path.segments, segment_count - 1)
      when Option::Some(parent_path) then
        if file_exists(parent_path.clone()) then
          return Option::Some(parent_path)
        end
      when Option::None then ()
      end
    end
    Option::None
  when Option::None then
    Option::None
  end
end

def collect_dep_items(program: &Program, out: &mut Vec[Item], loaded: &mut Vec[Int]) -> Unit
  mut i = 0
  while i < program.items.len() do
    let item = program.items[i]
    match item.kind
    when ItemKind::ItemUse(u) then
      match dep_use_to_file(&u)
      when Option::Some(path) then
        collect_dep_file(path, out, loaded)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
end

def collect_dep_file(path: String, out: &mut Vec[Item], loaded: &mut Vec[Int]) -> Unit
  let path_hash = dep_path_key(&path)
  if loaded_paths_contains(loaded, path_hash) then
    return
  end
  loaded.push(path_hash)

  match read_file_text_direct(path)
  when Result::Ok(source) then
    let tokens = tokenize(source)
    let (dep_ast, dep_diags) = parse(tokens)
    # Recurse into this dependency's own imports
    collect_dep_items(&dep_ast, out, loaded)
    # Add all items from this dependency
    mut item_idx = 0
    while item_idx < dep_ast.items.len() do
      out.push(dep_ast.items[item_idx])
      item_idx = item_idx + 1
    end
  when Result::Err(e) then
  end
end

def get_output_path(opts: &CompilerOptions, input: String, ext: String) -> String
  match opts.output_file
  when Option::Some(out) then out
  when Option::None then
    # Replace .tg with ext
    if input.ends_with(".tg") then
      input.slice(0, input.len() - 3) + ext
    else
      input + ext
    end
  end
end

# No external compiler invocation needed -- native code is generated directly

# 
# Debug Printing
# 

def token_debug(tok: Token) -> String
  tok.kind.to_string() + " @ " + tok.span.start.to_string() + ".." + tok.span.end_pos.to_string()
end

def print_ast(program: &Program) -> Unit
  println("Program with " + program.items.len().to_string() + " items")
  for item in program.items do
    println("  Item: " + item.kind.to_string())
  end
end

def print_mir(mir: &MirProgram) -> Unit
  println(pretty_print_mir(mir))
end

# 
# Macro Expansion
# 
#
# Expands macro invocations in the AST by textual substitution.
# Macros are templatebased: the macro body is a Block whose parameters
# are substituted at each call site.
#
# Expansion algorithm:
#   1. Collect all MacroDecl items into a namedecl map.
#   2. Walk every expression/statement looking for call expressions
#      whose callee matches a macro name.
#   3. For each match, clone the macro body, substitute parameter
#      names with the supplied argument expressions, and splice the
#      result into the AST.
#   4. Repeat until no more expansions are found (handles nested macros).

struct MacroEnv
  macros: Map[String, MacroDecl]
  # Recursion stack for hygiene (prevents infinite expansion)
  expansion_stack: Vec[String]
end

struct ExpandedProgram
  program: Program
  did_expand: Bool
end

struct ExpandedItem
  item: Item
  did_expand: Bool
end

struct ExpandedFunctionDecl
  func: FunctionDecl
  did_expand: Bool
end

struct ExpandedTraitMethod
  method: TraitMethod
  did_expand: Bool
end

struct ExpandedBlock
  block: Block
  did_expand: Bool
end

struct ExpandedStmt
  stmt: Stmt
  did_expand: Bool
end

struct ExpandedExpr
  expr: Expr
  did_expand: Bool
end

struct ExpandedExprVec
  args: Vec[Expr]
  did_expand: Bool
end

def expand_macros(program: Program) -> Program
  # Phase 1: collect macro declarations
  eprint("[expand_macros] enter, items=")
  eprint(program.items.len().to_string())
  eprint("\n")
  mut env = MacroEnv { macros: Map::new(), expansion_stack: Vec::new() }
  mut item_idx = 0
  for item in program.items do
    eprint("[em] item ")
    eprint(item_idx.to_string())
    eprint("\n")
    item_idx = item_idx + 1
    match item.kind
    when ItemKind::ItemFunction(_) then
      eprint("[em] -> ItemFunction\n")
    when ItemKind::ItemStruct(_) then
      eprint("[em] -> ItemStruct\n")
    when ItemKind::ItemEnum(_) then
      eprint("[em] -> ItemEnum\n")
    when ItemKind::Macro(m) then
      eprint("[expand_macros] found macro: ")
      eprint(m.name)
      eprint("\n")
      eprint("[expand_macros] cloning name\n")
      let key = m.name.clone()
      eprint("[expand_macros] cloning macro\n")
      let val = m.clone()
      eprint("[expand_macros] inserting\n")
      env.macros.insert(key, val)
      eprint("[expand_macros] inserted\n")
    when _ then ()
    end
  end

  eprint("[expand_macros] checking is_empty\n")
  # If no macros defined, return as-is
  if env.macros.is_empty() then
    eprint("[expand_macros] empty, returning\n")
    return program
  end
  eprint("[expand_macros] NOT empty, continuing\n")

  # Phase 2: iteratively expand until fixpoint (max 64 passes)
  mut current = program
  mut pass = 0
  while pass < 64 do
    let expanded_result = expand_program_pass(&env, current)
    current = expanded_result.program
    if !expanded_result.did_expand then break end
    pass = pass + 1
  end

  # Phase 3: remove macro declarations from the output AST
  mut filtered_items = Vec::new()
  for item in current.items do
    match item.kind
    when ItemKind::Macro(_) then ()  # Drop macro defs
    when _ then filtered_items.push(item.clone())
    end
  end
  Program { items: filtered_items }
end

def expand_program_pass(env: &MacroEnv, program: Program) -> ExpandedProgram
  mut new_items = Vec::new()
  mut did_expand = false
  mut i = 0
  while i < program.items.len() do
    let expanded_item = expand_item(env, program.items[i].clone())
    new_items.push(expanded_item.item)
    if expanded_item.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedProgram { program: Program { items: new_items }, did_expand }
end

def expand_item(env: &MacroEnv, item: Item) -> ExpandedItem
  match item.kind
  when ItemKind::Function(f) then
    let expanded_f = expand_function_decl(env, f)
    ExpandedItem {
      item: Item { kind: ItemKind::Function(expanded_f.func), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand: expanded_f.did_expand
    }
  when ItemKind::ItemImpl(impl_block) then
    mut new_methods = Vec::new()
    mut did_expand = false
    for method in impl_block.methods do
      let expanded_method = expand_function_decl(env, method)
      new_methods.push(expanded_method.func)
      if expanded_method.did_expand then did_expand = true end
    end
    let new_impl = ImplDecl {
      vis: impl_block.vis,
      self_type: impl_block.self_type.clone(),
      trait_name: impl_block.trait_name.clone(),
      for_type: impl_block.for_type.clone(),
      generic_params: impl_block.generic_params.clone(),
      where_clause: impl_block.where_clause.clone(),
      methods: new_methods,
      assoc_types: impl_block.assoc_types.clone(),
      span: impl_block.span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemImpl(new_impl), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when ItemKind::ItemTrait(trait_decl) then
    mut new_methods = Vec::new()
    mut did_expand = false
    for ti in trait_decl.methods do
      let expanded = expand_trait_method(env, ti)
      new_methods.push(expanded.method)
      if expanded.did_expand then did_expand = true end
    end
    let new_trait = TraitDecl {
      vis: trait_decl.vis,
      name: trait_decl.name.clone(),
      generic_params: trait_decl.generic_params.clone(),
      super_traits: trait_decl.super_traits.clone(),
      methods: new_methods,
      assoc_types: trait_decl.assoc_types.clone(),
      span: trait_decl.span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemTrait(new_trait), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when _ then ExpandedItem { item, did_expand: false }
  end
end

def expand_function_decl(env: &MacroEnv, f: FunctionDecl) -> ExpandedFunctionDecl
  match f.body
  when FnBody::FnBlock(block) then
    let expanded_block = expand_block(env, block)
    ExpandedFunctionDecl {
      func: FunctionDecl {
        vis: f.vis,
        name: f.name.clone(),
        generic_params: f.generic_params.clone(),
        params: f.params.clone(),
        ret_type: f.ret_type.clone(),
        where_clause: f.where_clause.clone(),
        body: FnBody::FnBlock(expanded_block.block),
        is_async: f.is_async,
        is_unsafe: f.is_unsafe,
        is_const: f.is_const,
        is_inline: f.is_inline,
        is_pure: f.is_pure,
        contracts: f.contracts.clone(),
        budget_val: f.budget_val.clone(),
        required_caps: f.required_caps.clone(),
        effects: f.effects.clone(),
        span: f.span
      },
      did_expand: expanded_block.did_expand
    }
  when _ then ExpandedFunctionDecl { func: f, did_expand: false }
  end
end

def expand_trait_method(env: &MacroEnv, method: TraitMethod) -> ExpandedTraitMethod
  match method.default_body
  when Option::Some(FnBody::FnBlock(block)) then
    let expanded_block = expand_block(env, block)
    ExpandedTraitMethod {
      method: TraitMethod {
        sig: method.sig,
        default_body: Option::Some(FnBody::FnBlock(expanded_block.block)),
        span: method.span
      },
      did_expand: expanded_block.did_expand
    }
  when _ then ExpandedTraitMethod { method, did_expand: false }
  end
end

def expand_block(env: &MacroEnv, block: Block) -> ExpandedBlock
  mut new_stmts = Vec::new()
  mut did_expand = false
  mut i = 0
  while i < block.stmts.len() do
    let expanded_stmt = expand_stmt(env, block.stmts[i].clone())
    new_stmts.push(expanded_stmt.stmt)
    if expanded_stmt.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedBlock { block: Block { stmts: new_stmts, span: block.span }, did_expand }
end

def expand_stmt(env: &MacroEnv, stmt: Stmt) -> ExpandedStmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    let expanded_expr = expand_expr(env, expr)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtExpr(expanded_expr.expr), span: stmt.span },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    let expanded_expr = expand_expr(env, init)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLet(pat, ty, expanded_expr.expr, is_mut), span: stmt.span },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtAssign(target, value) then
    let et = expand_expr(env, target)
    let ev = expand_expr(env, value)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtAssign(et.expr, ev.expr), span: stmt.span },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtCompoundAssign(op, target, value) then
    let et = expand_expr(env, target)
    let ev = expand_expr(env, value)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtCompoundAssign(op, et.expr, ev.expr), span: stmt.span },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtIf(if_stmt) then
    let ec = expand_expr(env, *if_stmt.cond)
    let eb = expand_block(env, if_stmt.then_block)
    let did = ec.did_expand || eb.did_expand
    let new_if = IfStmt {
      cond: ec.expr,
      then_block: eb.block,
      elsif_branches: if_stmt.elsif_branches.clone(),
      else_block: if_stmt.else_block.clone(),
      span: if_stmt.span
    }
    ExpandedStmt { stmt: Stmt { kind: StmtKind::StmtIf(new_if), span: stmt.span }, did_expand: did }
  when StmtKind::StmtWhile(cond, body) then
    let ec = expand_expr(env, cond)
    let eb = expand_block(env, body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtWhile(ec.expr, eb.block), span: stmt.span },
      did_expand: ec.did_expand || eb.did_expand
    }
  when StmtKind::StmtFor(pat, iter_expr, body) then
    let ei = expand_expr(env, iter_expr)
    let eb = expand_block(env, body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtFor(pat, ei.expr, eb.block), span: stmt.span },
      did_expand: ei.did_expand || eb.did_expand
    }
  when StmtKind::StmtLoop(body) then
    let eb = expand_block(env, body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLoop(eb.block), span: stmt.span },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtReturn(opt_expr) then
    match opt_expr
    when Option::Some(expr) then
      let ee = expand_expr(env, expr)
      ExpandedStmt {
        stmt: Stmt { kind: StmtKind::StmtReturn(Option::Some(ee.expr)), span: stmt.span },
        did_expand: ee.did_expand
      }
    when Option::None then ExpandedStmt { stmt, did_expand: false }
    end
  when StmtKind::StmtUnsafe(reason, body) then
    let eb = expand_block(env, body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtUnsafe(reason, eb.block), span: stmt.span },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtDefer(body) then
    let eb = expand_block(env, body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtDefer(eb.block), span: stmt.span },
      did_expand: eb.did_expand
    }
  when _ then ExpandedStmt { stmt, did_expand: false }
  end
end

def expand_exprs(env: &MacroEnv, args: &Vec[Expr]) -> ExpandedExprVec
  mut new_args = Vec::new()
  mut did_expand = false
  mut i = 0
  while i < args.len() do
    let expanded_arg = expand_expr(env, args[i].clone())
    new_args.push(expanded_arg.expr)
    if expanded_arg.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedExprVec { args: new_args, did_expand }
end

def expand_expr(env: &MacroEnv, expr: Expr) -> ExpandedExpr
  match expr.kind
  when ExprKind::ExprCall(callee, args) then
    ## Check if callee is a path that matches a macro name
    match callee.kind
    when ExprKind::ExprPath(path) then
      let name = path_to_name(&path)
      match env.macros.get(&name)
      when Option::Some(macro_decl) then
        if env.expansion_stack.contains(&name) then
          ExpandedExpr {
            expr: Expr {
              kind: ExprKind::ExprError("recursive macro invocation: '" + name.clone() + "'"),
              span: expr.span
            },
            did_expand: false
          }
        else
          env.expansion_stack.push(name.clone())
          let expanded = instantiate_macro(macro_decl, &args, &expr.span)
          env.expansion_stack.pop()
          ExpandedExpr { expr: expanded, did_expand: true }
        end
      when Option::None then
        ## Not a macro  expand arguments recursively
        let ea = expand_exprs(env, &args)
        let ec = expand_expr(env, *callee)
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span },
          did_expand: ec.did_expand || ea.did_expand
        }
      end
    when _ then
      let ea = expand_exprs(env, &args)
      let ec = expand_expr(env, *callee)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span },
        did_expand: ec.did_expand || ea.did_expand
      }
    end
  when ExprKind::ExprMacroCall(name, args) then
    match env.macros.get(&name)
    when Option::Some(macro_decl) then
      if env.expansion_stack.contains(&name) then
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + name.clone() + "'"), span: expr.span },
          did_expand: false
        }
      else
        env.expansion_stack.push(name.clone())
        let expanded = instantiate_macro(macro_decl, &args, &expr.span)
        env.expansion_stack.pop()
        ExpandedExpr { expr: expanded, did_expand: true }
      end
    when Option::None then
      let ea = expand_exprs(env, &args)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprMacroCall(name, ea.args), span: expr.span },
        did_expand: ea.did_expand
      }
    end
  when ExprKind::ExprBlock(block) then
    let expanded_block = expand_block(env, block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBlock(expanded_block.block), span: expr.span },
      did_expand: expanded_block.did_expand
    }
  when ExprKind::ExprIf(if_expr) then
    let expanded_cond = expand_expr(env, *if_expr.cond)
    let expanded_then = expand_block(env, if_expr.then_block)
    let expanded = expanded_cond.did_expand || expanded_then.did_expand
    let new_if = IfStmt {
      cond: expanded_cond.expr,
      then_block: expanded_then.block,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    ExpandedExpr { expr: Expr { kind: ExprKind::ExprIf(new_if), span: expr.span }, did_expand: expanded }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    let el = expand_expr(env, *lhs)
    let er = expand_expr(env, *rhs)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBinaryOp(op, Box::new(el.expr), Box::new(er.expr)), span: expr.span },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprUnaryOp(op, operand) then
    let eo = expand_expr(env, *operand)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(eo.expr)), span: expr.span },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let er = expand_expr(env, *receiver)
    let ea = expand_exprs(env, &args)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprMethodCall(Box::new(er.expr), method, targs, ea.args), span: expr.span },
      did_expand: er.did_expand || ea.did_expand
    }
  when ExprKind::ExprFieldAccess(obj, field) then
    let eo = expand_expr(env, *obj)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprFieldAccess(Box::new(eo.expr), field), span: expr.span },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprIndex(obj, idx) then
    let eo = expand_expr(env, *obj)
    let ei = expand_expr(env, *idx)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprIndex(Box::new(eo.expr), Box::new(ei.expr)), span: expr.span },
      did_expand: eo.did_expand || ei.did_expand
    }
  when ExprKind::ExprArrayLit(elems) then
    let ea = expand_exprs(env, &elems)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprArrayLit(ea.args), span: expr.span },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprTupleLit(elems) then
    let ea = expand_exprs(env, &elems)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTupleLit(ea.args), span: expr.span },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprRef(inner) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRef(Box::new(ei.expr)), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprRefMut(inner) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRefMut(Box::new(ei.expr)), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprDeref(inner) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprDeref(Box::new(ei.expr)), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    let eb = expand_expr(env, *body)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprClosure(params, ret_ty, Box::new(eb.expr)), span: expr.span },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprUnsafe(reason, block) then
    let eb = expand_block(env, block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnsafe(reason, eb.block), span: expr.span },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprAwait(inner) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAwait(Box::new(ei.expr)), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprTry(inner) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTry(Box::new(ei.expr)), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprAssign(target, value) then
    let et = expand_expr(env, *target)
    let ev = expand_expr(env, *value)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAssign(Box::new(et.expr), Box::new(ev.expr)), span: expr.span },
      did_expand: et.did_expand || ev.did_expand
    }
  when ExprKind::ExprPipe(lhs, rhs) then
    let el = expand_expr(env, *lhs)
    let er = expand_expr(env, *rhs)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprPipe(Box::new(el.expr), Box::new(er.expr)), span: expr.span },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprCast(inner, ty) then
    let ei = expand_expr(env, *inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprCast(Box::new(ei.expr), ty), span: expr.span },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprAsync(block) then
    let eb = expand_block(env, block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAsync(eb.block), span: expr.span },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprComptime(block) then
    let eb = expand_block(env, block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprComptime(eb.block), span: expr.span },
      did_expand: eb.did_expand
    }
  when _ then ExpandedExpr { expr, did_expand: false }
  end
end

def instantiate_macro(macro_decl: &MacroDecl, args: &Vec[Expr], call_span: &Span) -> Expr
  # Validate argument count matches parameter count
  if args.len() != macro_decl.params.len() then
    # Return an error expression - type checker will catch this
    return Expr {
      kind: ExprKind::ExprError("macro '" + macro_decl.name.clone() + "' expects " +
        macro_decl.params.len().to_string() + " arguments, got " + args.len().to_string()),
      span: call_span.clone()
    }
  end

  # Build substitution map: param_name  argument expression
  mut subst_map: Map[String, Expr] = Map::new()
  mut i = 0
  while i < macro_decl.params.len() do
    subst_map.insert(macro_decl.params[i].name.clone(), args[i].clone())
    i = i + 1
  end

  # Clone the macro body and substitute identifiers matching parameter names
  let substituted_block = substitute_block(&subst_map, &macro_decl.body)

  # Wrap the block as a block expression
  Expr { kind: ExprKind::ExprBlock(substituted_block), span: call_span.clone() }
end

def substitute_block(subst: &Map[String, Expr], block: &Block) -> Block
  mut new_stmts = Vec::new()
  mut i = 0
  while i < block.stmts.len() do
    new_stmts.push(substitute_stmt(subst, &block.stmts[i]))
    i = i + 1
  end
  Block { stmts: new_stmts, span: block.span }
end

def substitute_stmt(subst: &Map[String, Expr], stmt: &Stmt) -> Stmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    Stmt { kind: StmtKind::StmtExpr(substitute_expr(subst, &expr)), span: stmt.span }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    let new_init = substitute_expr(subst, &init)
    Stmt { kind: StmtKind::StmtLet(pat.clone(), ty.clone(), new_init, is_mut), span: stmt.span }
  when _ then stmt.clone()
  end
end

def substitute_expr(subst: &Map[String, Expr], expr: &Expr) -> Expr
  match expr.kind
  when ExprKind::ExprPath(path) then
    let name = path_to_name(&path)
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then expr.clone()
    end
  when ExprKind::ExprIdent(name) then
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then expr.clone()
    end
  when ExprKind::ExprCall(callee, args) then
    let new_callee = substitute_expr(subst, &callee)
    mut new_args = Vec::new()
    mut i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprCall(Box::new(new_callee), new_args), span: expr.span }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    Expr {
      kind: ExprKind::ExprBinaryOp(op, Box::new(substitute_expr(subst, &lhs)), Box::new(substitute_expr(subst, &rhs))),
      span: expr.span
    }
  when ExprKind::ExprUnaryOp(op, operand) then
    Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(substitute_expr(subst, &operand))), span: expr.span }
  when ExprKind::ExprBlock(block) then
    Expr { kind: ExprKind::ExprBlock(substitute_block(subst, &block)), span: expr.span }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let new_recv = substitute_expr(subst, &receiver)
    mut new_args = Vec::new()
    mut i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprMethodCall(Box::new(new_recv), method.clone(), targs.clone(), new_args), span: expr.span }
  when ExprKind::ExprFieldAccess(obj, field) then
    Expr { kind: ExprKind::ExprFieldAccess(Box::new(substitute_expr(subst, &obj)), field.clone()), span: expr.span }
  when ExprKind::ExprIndex(obj, idx) then
    Expr { kind: ExprKind::ExprIndex(Box::new(substitute_expr(subst, &obj)), Box::new(substitute_expr(subst, &idx))), span: expr.span }
  when ExprKind::ExprArrayLit(elems) then
    mut new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, &e)) end
    Expr { kind: ExprKind::ExprArrayLit(new_elems), span: expr.span }
  when ExprKind::ExprTupleLit(elems) then
    mut new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, &e)) end
    Expr { kind: ExprKind::ExprTupleLit(new_elems), span: expr.span }
  when ExprKind::ExprRef(inner) then
    Expr { kind: ExprKind::ExprRef(Box::new(substitute_expr(subst, &inner))), span: expr.span }
  when ExprKind::ExprRefMut(inner) then
    Expr { kind: ExprKind::ExprRefMut(Box::new(substitute_expr(subst, &inner))), span: expr.span }
  when ExprKind::ExprDeref(inner) then
    Expr { kind: ExprKind::ExprDeref(Box::new(substitute_expr(subst, &inner))), span: expr.span }
  when ExprKind::ExprAwait(inner) then
    Expr { kind: ExprKind::ExprAwait(Box::new(substitute_expr(subst, &inner))), span: expr.span }
  when ExprKind::ExprTry(inner) then
    Expr { kind: ExprKind::ExprTry(Box::new(substitute_expr(subst, &inner))), span: expr.span }
  when ExprKind::ExprCast(inner, ty) then
    Expr { kind: ExprKind::ExprCast(Box::new(substitute_expr(subst, &inner)), ty.clone()), span: expr.span }
  when ExprKind::ExprAssign(target, value) then
    Expr { kind: ExprKind::ExprAssign(Box::new(substitute_expr(subst, &target)), Box::new(substitute_expr(subst, &value))), span: expr.span }
  when ExprKind::ExprPipe(lhs, rhs) then
    Expr { kind: ExprKind::ExprPipe(Box::new(substitute_expr(subst, &lhs)), Box::new(substitute_expr(subst, &rhs))), span: expr.span }
  when ExprKind::ExprIf(if_expr) then
    let new_cond = substitute_expr(subst, &if_expr.cond)
    let new_then = substitute_block(subst, &if_expr.then_block)
    let new_if = IfStmt {
      cond: new_cond,
      then_block: new_then,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    Expr { kind: ExprKind::ExprIf(new_if), span: expr.span }
  when ExprKind::ExprUnsafe(reason, block) then
    Expr { kind: ExprKind::ExprUnsafe(reason.clone(), substitute_block(subst, &block)), span: expr.span }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    Expr { kind: ExprKind::ExprClosure(params.clone(), ret_ty.clone(), Box::new(substitute_expr(subst, &body))), span: expr.span }
  when _ then expr.clone()
  end
end

def path_to_name(path: &AstPath) -> String
  # Simple: use the last segment name
  if path.segments.is_empty() then
    "".to_string()
  else
    path.segments[path.segments.len() - 1].clone()
  end
end

# 
# Argument Parsing
# 

def parse_args(argv: Vec[String]) -> Result[CompilerOptions, String]
  mut opts = default_options()
  mut i = 1  # Skip program name
  
  while i < argv.len() do
    let arg = argv[i]
    
    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for -o")
      end
      opts.output_file = Option::Some(argv[i])
    elsif arg == "-c" then
      opts.emit = EmitMode::Object
    elsif arg == "--emit-obj" then
      opts.emit = EmitMode::Object
    elsif arg == "--emit-mir" then
      opts.emit_mir = true
    elsif arg == "--print-ast" then
      opts.print_ast = true
    elsif arg == "--print-tokens" then
      opts.print_tokens = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      opts.debug_info = true
    elsif arg == "--check" then
      opts.check_only = true
    elsif arg == "-v" || arg == "--verbose" then
      opts.verbose = true
    elsif arg == "-q" || arg == "--quiet" then
      opts.quiet = true
    elsif arg == "-W" || arg == "--warn-all" then
      opts.warn_all = true
    elsif arg == "-Werror" then
      opts.deny_warnings = true
    elsif arg == "--no-contracts" then
      opts.enable_contracts = false
    elsif arg == "--no-capabilities" then
      opts.enable_capabilities = false
    elsif arg == "--no-effects" then
      opts.enable_effects = false
    elsif arg == "--no-budgets" then
      opts.enable_budgets = false
    elsif arg == "--target" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for --target")
      end
      opts.target_triple = Option::Some(argv[i])
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "--no-color" then
      opts.color = false
    elsif arg == "--color" then
      opts.color = true
    elsif arg.starts_with("--pgo-gen") then
      if arg.contains("=") then
        opts.pgo_gen = Option::Some(arg.split("=")[1].clone())
      else
        opts.pgo_gen = Option::Some(".tg_pgo_profile".to_string())
      end
    elsif arg.starts_with("--pgo-use") then
      if arg.contains("=") then
        opts.pgo_use = Option::Some(arg.split("=")[1].clone())
      else
        opts.pgo_use = Option::Some(".tg_pgo_profile".to_string())
      end
    elsif arg == "--mode" then
      i = i + 1
      if i >= argv.len() then
        return Result::Err("Missing argument for --mode")
      end
      let mode_str = argv[i]
      if mode_str == "dev" then
        opts.mode = Mode::Dev
        opts.mode_config = config_for_mode(Mode::Dev)
      elsif mode_str == "strict" then
        opts.mode = Mode::Strict
        opts.mode_config = config_for_mode(Mode::Strict)
      elsif mode_str == "production" then
        opts.mode = Mode::Production
        opts.mode_config = config_for_mode(Mode::Production)
      elsif mode_str == "hardened" then
        opts.mode = Mode::Hardened
        opts.mode_config = config_for_mode(Mode::Hardened)
      else
        return Result::Err("Unknown mode: " + mode_str + " (expected dev/strict/production/hardened)")
      end
      # Apply mode-driven feature flags
      opts.enable_contracts = opts.mode_config.enforce_contracts
      opts.enable_effects = opts.mode_config.enforce_effects
      opts.enable_budgets = opts.mode_config.enforce_budgets
      opts.enable_capabilities = opts.mode_config.enforce_capabilities
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return Result::Err("help")
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return Result::Err("version")
    elsif arg.starts_with("-") then
      return Result::Err("Unknown option: " + arg)
    else
      opts.input_files.push(arg)
    end
    
    i = i + 1
  end
  
  if opts.input_files.is_empty() then
    return Result::Err("No input files")
  end
  
  Result::Ok(opts)
end

def parse_startup_compile_args(skip_subcommand: Bool) -> Result[CompilerOptions, String]
  mut opts = default_options()
  let argc = raw_arg_count()
  mut i = if skip_subcommand then 2 else 1 end

  while i < argc do
    let arg = raw_arg_copy(i)

    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argc then
        return Result::Err("Missing argument for -o")
      end
      opts.output_file = Option::Some(raw_arg_copy(i))
    elsif arg == "--emit-mir" then
      opts.emit_mir = true
    elsif arg == "-c" || arg == "--emit-obj" then
      opts.emit = EmitMode::Object
    elsif arg == "--print-ast" then
      opts.print_ast = true
    elsif arg == "--print-tokens" then
      opts.print_tokens = true
    elsif arg == "--check" then
      opts.check_only = true
    elsif arg == "-v" || arg == "--verbose" then
      opts.verbose = true
    elsif arg == "-q" || arg == "--quiet" then
      opts.quiet = true
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "-g" then
      opts.debug_info = true
    elsif arg == "--target" then
      i = i + 1
      if i >= argc then
        return Result::Err("Missing argument for --target")
      end
      opts.target_triple = Option::Some(raw_arg_copy(i))
    elsif arg == "--json" then
      opts.json_diagnostics = true
    elsif arg == "-h" || arg == "--help" then
      print_help()
      return Result::Err("help")
    elsif arg == "-V" || arg == "--version" then
      print_version()
      return Result::Err("version")
    elsif arg.starts_with("-") then
      return Result::Err("Unknown option: " + arg)
    else
      opts.input_files.push(arg)
    end

    i = i + 1
  end

  if opts.input_files.is_empty() then
    return Result::Err("No input files")
  end

  Result::Ok(opts)
end

def print_help() -> Unit
  println("Usage: tg [SUBCOMMAND] [OPTIONS] [FILES]...")
  println("")
  println("Subcommands:")
  println("  build     Compile project (uses Tangerine.toml)")
  println("  run       Compile and execute")
  println("  test      Discover and run tests")
  println("  check     Type-check and borrow-check only")
  println("  fmt       Format source files")
  println("  lint      Run linter")
  println("  doc       Generate documentation")
  println("  bench     Run benchmarks")
  println("  repl      Interactive REPL")
  println("  lsp       Start language server")
  println("  init      Create new project")
  println("  dep       Dependency management (add/remove/list/update/tree)")
  println("  install   Install a package globally")
  println("  self-update Update the compiler")
  println("  explain   Explain an error code")
  println("  agent     Run agentic workflows (check/caps/effects/budget/diff/audit)")
  println("")
  println("Options:")
  println("  -o, --output <FILE>  Write output to FILE")
  println("  -c                   Compile to object file")
  println("  --emit-obj           Emit object file")
  println("  --emit-mir           Print MIR representation")
  println("  --print-ast          Print AST")
  println("  --print-tokens       Print tokens")
  println("  -O0 / -O1 / -O2 / -O3  Optimization level")
  println("  -g                   Include debug info")
  println("  --check              Check only, don't compile")
  println("  -v, --verbose        Verbose output")
  println("  -q, --quiet          Quiet output")
  println("  -W, --warn-all       Enable all warnings")
  println("  -Werror              Treat warnings as errors")
  println("  --no-contracts       Disable contract checking")
  println("  --no-capabilities    Disable capability system")
  println("  --no-effects         Disable effect system")
  println("  --no-budgets         Disable budget system")
  println("  --target <TRIPLE>    Cross-compile for target (e.g. x86_64-linux-gnu, aarch64-macos)")
  println("  --pgo-gen[=PATH]     Instrument binary for profile generation")
  println("  --pgo-use[=PATH]     Optimize using previously collected profile data")
  println("  --json               Emit diagnostics in JSON format")
  println("  --no-color           Disable colored output")
  println("  --color              Force colored output")
  println("  -h, --help           Show help")
  println("  -V, --version        Show version")
end

def print_version() -> Unit
  println("Tangerine compiler v" + VERSION)
  println("Self-hosting edition")
end

# 
# Subcommands
# 

enum Subcommand
  Build        # tg build  compile project
  Parse        # tg parse  parse only
  Run          # tg run  compile and execute
  Test         # tg test  discover and run tests
  Check        # tg check  type/borrow check only
  Fmt          # tg fmt  format source files
  Lint         # tg lint  run linter
  Doc          # tg doc  generate documentation
  Bench        # tg bench  run benchmarks
  Repl         # tg repl  interactive REPL
  Lsp          # tg lsp  start language server
  Init         # tg init  create new project
  Dep          # tg dep  dependency management
  Install      # tg install  install a package
  SelfUpdate   # tg self-update  update the compiler
  Explain      # tg explain E0XXX  explain error code
  Agent        # tg agent  run agentic workflows
  Bindgen      # tg bindgen  generate FFI bindings
  Abi          # tg abi  ABI tools (test, dump)
  Compile      # tg <files>  raw compile (default, no subcommand)
end

struct SubcommandDispatch
  subcmd: Subcommand
  sub_argv: Vec[String]
end

def startup_args() -> Vec[String]
  let argc = raw_arg_count()
  mut result: Vec[String] = Vec::new()
  mut i = 0
  while i < argc do
    result.push(raw_arg_copy(i))
    i = i + 1
  end
  result
end

def startup_subcommand_argv() -> Vec[String]
  let argc = raw_arg_count()
  mut result: Vec[String] = Vec::new()
  if argc > 0 then
    result.push(raw_arg_copy(0))
  end
  mut i = 2
  while i < argc do
    result.push(raw_arg_copy(i))
    i = i + 1
  end
  result
end

# 
# Main Entry Point
# 

def main() -> Int
  let argc = raw_arg_count()

  if argc < 2 then
    print_help()
    return 0
  end

  let first = raw_arg_unchecked(1)

  if first == "-h" || first == "--help" then
    print_help()
    return 0
  end

  if first == "build" then
    cmd_build(startup_subcommand_argv())
  elsif first == "parse" then
    cmd_parse(startup_subcommand_argv())
  elsif first == "run" then
    cmd_run(startup_subcommand_argv())
  elsif first == "test" then
    cmd_test(startup_subcommand_argv())
  elsif first == "check" then
    cmd_check(startup_subcommand_argv())
  elsif first == "fmt" || first == "format" then
    cmd_fmt(startup_subcommand_argv())
  elsif first == "lint" then
    cmd_lint(startup_subcommand_argv())
  elsif first == "doc" then
    cmd_doc(startup_subcommand_argv())
  elsif first == "bench" then
    cmd_bench(startup_subcommand_argv())
  elsif first == "repl" then
    cmd_repl(startup_subcommand_argv())
  elsif first == "lsp" then
    cmd_lsp(startup_subcommand_argv())
  elsif first == "init" then
    cmd_init(startup_subcommand_argv())
  elsif first == "dep" then
    cmd_dep(startup_subcommand_argv())
  elsif first == "install" then
    cmd_install(startup_subcommand_argv())
  elsif first == "self-update" || first == "update" then
    cmd_self_update(startup_subcommand_argv())
  elsif first == "explain" then
    cmd_explain_main(startup_subcommand_argv())
  elsif first == "agent" then
    cmd_agent(startup_subcommand_argv())
  elsif first == "bindgen" then
    cmd_bindgen(startup_subcommand_argv())
  elsif first == "abi" then
    cmd_abi(startup_subcommand_argv())
  elsif first == "compile" then
    cmd_compile_raw(true)
  else
    cmd_compile_raw(false)
  end
end

def subcommand_argv(argv: Vec[String]) -> Vec[String]
  mut sub_argv: Vec[String] = Vec::new()
  sub_argv.push(argv[0].clone())
  mut i: UInt = 2
  while i < argv.len() do
    sub_argv.push(argv[i].clone())
    i = i + 1
  end
  sub_argv
end

def detect_subcommand(argv: Vec[String]) -> SubcommandDispatch
  if argv.len() < 2 then
    return SubcommandDispatch { subcmd: Subcommand::Compile, sub_argv: argv }
  end
  
  let first: String = argv[1].clone()
  
  let subcmd = if first == "build" then
    Subcommand::Build
  elsif first == "parse" then
    Subcommand::Parse
  elsif first == "run" then
    Subcommand::Run
  elsif first == "test" then
    Subcommand::Test
  elsif first == "check" then
    Subcommand::Check
  elsif first == "fmt" || first == "format" then
    Subcommand::Fmt
  elsif first == "lint" then
    Subcommand::Lint
  elsif first == "doc" then
    Subcommand::Doc
  elsif first == "bench" then
    Subcommand::Bench
  elsif first == "repl" then
    Subcommand::Repl
  elsif first == "lsp" then
    Subcommand::Lsp
  elsif first == "init" then
    Subcommand::Init
  elsif first == "dep" then
    Subcommand::Dep
  elsif first == "install" then
    Subcommand::Install
  elsif first == "self-update" || first == "update" then
    Subcommand::SelfUpdate
  elsif first == "explain" then
    Subcommand::Explain
  elsif first == "agent" then
    Subcommand::Agent
  elsif first == "bindgen" then
    Subcommand::Bindgen
  elsif first == "abi" then
    Subcommand::Abi
  elsif first == "compile" then
    Subcommand::Compile
  else
    # No subcommand  treat as raw compile
    return SubcommandDispatch { subcmd: Subcommand::Compile, sub_argv: argv }
  end
  
  # Build sub-argv: [program_name, args after subcommand...]
  mut sub_argv: Vec[String] = Vec::new()
  sub_argv.push(argv[0].clone())
  mut i: UInt = 2
  while i < argv.len() do
    sub_argv.push(argv[i].clone())
    i = i + 1
  end
  
  SubcommandDispatch { subcmd: subcmd, sub_argv: sub_argv }
end

# 
# Subcommand: build
# 

def cmd_build(argv: Vec[String]) -> Int
  # Bootstrap fast path: detect explicit stage2 output from raw argv
  mut requested_output = Option::None
  mut i: UInt = 0
  while i < argv.len() do
    let arg = argv[i].clone()
    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i < argv.len() then
        requested_output = Option::Some(argv[i].clone())
      end
    end
    i = i + 1
  end
  match requested_output
  when Option::Some(out) then
    # No bootstrap fast-path. Always build correctly.
    ()
  when Option::None then ()
  end

  # Try loading project from Tangerine.toml first
  match load_project(".") 
  when Result::Ok(project) then
    # Merge CLI options with project config
    let opts = match parse_args(argv)
    when Result::Ok(o) then o
    when Result::Err(e) then
      if e == "help" || e == "version" then
        return 0
      elsif e == "No input files" then
        # Use project sources
        mut o = default_options()
        o.input_files = project.sources.clone()
        o
      else
        return 1
      end
    end

    match build_project(&project)
    when Result::Ok(_) then 0
    when Result::Err(e) then
      1
    end # end match build_project
  when Result::Err(e) then
    # No project file  compile with CLI args
    cmd_compile(argv)
  end # end match load_project
end # end main

def cmd_parse(argv: Vec[String]) -> Int
  let opts = match parse_args(argv)
  when Result::Ok(o) then
    mut o2 = o
    o2.check_only = true
    o2
  when Result::Err(e) then
    if e == "help" || e == "No input files" then
      println("Usage: tg parse [OPTIONS] [FILES]...")
      println("Parse files only (no type-check or codegen)")
      return if e == "help" then 0 else 1 end
    else
      return 1
    end
  end

  mut exit_code = 0
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      exit_code = 1
    end
  end

  exit_code
end

# 
# Subcommand: run
# 

def cmd_run(argv: Vec[String]) -> Int
  # Compile to a temp executable, then run it
  let opts = match parse_args(argv)
  when Result::Ok(o) then o
  when Result::Err(e) then
    if e == "No input files" then
      # Try project
      match load_project(".")
      when Result::Ok(project) then
        mut o = default_options()
        o.input_files = project.sources.clone()
        o
      when Result::Err(_) then
        return 1
      end
    elsif e == "help" then
      println("Usage: tg run [OPTIONS] [FILES]...")
      println("Compile and run a Tangerine program")
      return 0
    else
      return 1
    end
  end
  
  # Compile
  let exe_path = get_output_path(&opts, opts.input_files[0].clone(), "")
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return 1
    end
  end
  
  # Execute
  let exit_code = execute_binary(exe_path)
  exit_code
end

# Standard file descriptor for stdout
def STDOUT_FILENO() -> Int = 1

def execute_binary(path: String) -> Int
  # Execute the compiled binary using libc system() call.
  # Returns the exit code from the executed program.
  unsafe "FFI system call" do
    let exit_code = std::ffi::system(path.as_ptr())
    # system() returns -1 on error, otherwise the exit status
    if exit_code < 0 then
      1
    else
      exit_code
    end
  end
end

# 
# Subcommand: test
# 

def cmd_test(argv: Vec[String]) -> Int
  # Discover test sources: from project or CLI args.
  let test_files = match parse_args(argv)
  when Result::Ok(o) then
    if o.input_files.is_empty() then
      match load_project(".")
      when Result::Ok(project) then project.sources.clone()
      when Result::Err(_) then find_tg_files(".")
      end
    else
      o.input_files.clone()
    end
  when Result::Err(e) then
    if e == "help" then
      println("Usage: tg test [OPTIONS] [FILES]...")
      println("Discover and run @test functions")
      return 0
    elsif e == "No input files" then
      match load_project(".")
      when Result::Ok(project) then project.sources.clone()
      when Result::Err(_) then find_tg_files(".")
      end
    else
      return 1
    end
  end

  mut total = 0
  mut passed = 0
  mut failed = 0
  mut fail_names: Vec[String] = Vec::new()

  let opts = default_options()

  for file in test_files do
    let source = match read_file(file.clone())
    when Result::Ok(content) then content
    when Result::Err(_) then next
    end
    let lex_result = tokenize(source)
    let (ast, parse_diags) = parse(lex_result)
    if diag_has_errors(&parse_diags) then next end

    # Find @test functions
    for item in ast.items do
      mut is_test = false
      for attr in item.attrs do
        if attr.name == "test" then
          is_test = true
        end
      end
      if is_test then
        match item.kind
        when ItemKind::ItemFunction(func_decl) then
          total = total + 1
          let test_name = file.clone() + "::" + func_decl.name.clone()
          # Compile and run the test function
          match compile_and_run_test(&opts, file.clone(), &func_decl)
          when Result::Ok(_) then
            passed = passed + 1
            println("  PASS  " + test_name)
          when Result::Err(e) then
            failed = failed + 1
            fail_names.push(test_name.clone())
            println("  FAIL  " + test_name + ": " + e)
          end
        when _ then ()
        end
      end
    end
  end

  println("")
  println("test result: " + if failed == 0 then "ok" else "FAILED" end
    + ". " + passed.to_string() + " passed; " + failed.to_string()
    + " failed; " + total.to_string() + " total")

  if !fail_names.is_empty() then
    println("")
    println("failures:")
    for name in fail_names do
      println("    " + name)
    end
  end

  if failed > 0 then 1 else 0 end
end

def compile_and_run_test(opts: &CompilerOptions, path: String, func: &FunctionDecl) -> Result[Unit, String]
  # Compile the test file, then invoke the test function.
  match compile_file(opts, path)
  when Result::Ok(output_path) then
    # Execute the compiled test binary with the test function name.
    let cmd = output_path + " --run-test " + func.name.clone()
    let exit_code = bootstrap_call_system(cmd)
    if exit_code == 0 then
      Result::Ok(())
    else
      Result::Err("test exited with code " + exit_code.to_string())
    end
  when Result::Err(e) then
    Result::Err("compilation failed: " + e)
  end
end

# 
# Subcommand: check
# 

def cmd_check(argv: Vec[String]) -> Int
  let opts = match parse_args(argv)
  when Result::Ok(o) then
    mut o2 = o
    o2.check_only = true
    o2
  when Result::Err(e) then
    if e == "help" then
      println("Usage: tg check [OPTIONS] [FILES]...")
      println("Type-check and borrow-check without compiling")
      return 0
    elsif e == "No input files" then
      match load_project(".")
      when Result::Ok(project) then
        mut o = default_options()
        o.check_only = true
        o.input_files = project.sources.clone()
        o
      when Result::Err(_) then
        return 1
      end
    else
      return 1
    end
  end
  
  mut exit_code = 0
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      exit_code = 1
    end
  end
  
  exit_code
end

# 
# Subcommand: fmt
# 

use tg_compiler::formatter::{format_file, format_source, FormatConfig, default_format_config, format_check}

def cmd_fmt(argv: Vec[String]) -> Int
  mut check_only = false
  mut files = Vec::new()
  mut config = default_format_config()
  
  mut i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--check" then
      check_only = true
    elsif arg == "--indent" then
      i = i + 1
      if i < argv.len() then
        config.indent_width = argv[i].parse_uint().unwrap_or(2)
      end
    elsif arg == "--line-width" then
      i = i + 1
      if i < argv.len() then
        config.max_line_width = argv[i].parse_uint().unwrap_or(100)
      end
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg fmt [OPTIONS] [FILES]...")
      println("Format Tangerine source files")
      println("")
      println("Options:")
      println("  --check          Check formatting without writing")
      println("  --indent <N>     Indentation width (default: 2)")
      println("  --line-width <N> Maximum line width (default: 100)")
      return 0
    elsif !arg.starts_with("-") then
      files.push(arg.clone())
    end
    i = i + 1
  end
  
  # If no files, format all .tg files in project
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  mut exit_code = 0
  mut formatted_count: UInt = 0
  
  for file in files do
    if check_only then
      match format_check(file.clone(), &config)
      when Result::Ok(needs_format) then
        if needs_format then
          println("Would reformat: " + file)
          exit_code = 1
        end
      when Result::Err(e) then
        exit_code = 1
      end
    else
      match format_file(file.clone(), &config)
      when Result::Ok(changed) then
        if changed then
          formatted_count = formatted_count + 1
          println("Formatted: " + file)
        end
      when Result::Err(e) then
        exit_code = 1
      end
    end
  end
  
  if !check_only && formatted_count > 0 then
    println(formatted_count.to_string() + " file(s) formatted")
  end
  
  exit_code
end

# 
# Subcommand: lint
# 

use tg_compiler::linter::{lint_file, LintConfig, default_lint_config, LintLevel}

def cmd_lint(argv: Vec[String]) -> Int
  mut files = Vec::new()
  mut config = default_lint_config()
  
  mut i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--deny" then
      i = i + 1
      if i < argv.len() then
        config.denied.push(argv[i].clone())
      end
    elsif arg == "--allow" then
      i = i + 1
      if i < argv.len() then
        config.allowed.push(argv[i].clone())
      end
    elsif arg == "--warn" then
      i = i + 1
      if i < argv.len() then
        config.warned.push(argv[i].clone())
      end
    elsif arg == "--json" then
      config.json_output = true
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg lint [OPTIONS] [FILES]...")
      println("Run linter on Tangerine source files")
      println("")
      println("Options:")
      println("  --deny <LINT>    Deny a lint (error)")
      println("  --allow <LINT>   Allow a lint (suppress)")
      println("  --warn <LINT>    Warn on a lint")
      println("  --json           Output diagnostics as JSON")
      return 0
    elsif !arg.starts_with("-") then
      files.push(arg.clone())
    end
    i = i + 1
  end
  
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  mut total_warnings: UInt = 0
  mut total_errors: UInt = 0
  
  for file in files do
    match lint_file(file.clone(), &config)
    when Result::Ok(diagnostics) then
      for diag in diagnostics do
        match diag.level
        when LintLevel::Error then
          total_errors = total_errors + 1
        when LintLevel::Warning then
          total_warnings = total_warnings + 1
        when LintLevel::Info then
        end
      end
    when Result::Err(e) then
      total_errors = total_errors + 1
    end
  end
  
  if total_errors > 0 || total_warnings > 0 then
  end
  
  if total_errors > 0 then 1 else 0 end
end

# 
# Subcommand: doc
# 

use tg_compiler::docgen::{generate_docs, DocConfig, default_doc_config}

def cmd_doc(argv: Vec[String]) -> Int
  mut files = Vec::new()
  mut config = default_doc_config()
  
  mut i: UInt = 1
  while i < argv.len() do
    let arg = argv[i]
    if arg == "--output" || arg == "-o" then
      i = i + 1
      if i < argv.len() then
        config.output_dir = argv[i].clone()
      end
    elsif arg == "--format" then
      i = i + 1
      if i < argv.len() then
        if argv[i] == "html" then
          config.format = DocFormat::Html
        elsif argv[i] == "markdown" || argv[i] == "md" then
          config.format = DocFormat::Markdown
        end
      end
    elsif arg == "--private" then
      config.include_private = true
    elsif arg == "-h" || arg == "--help" then
      println("Usage: tg doc [OPTIONS] [FILES]...")
      println("Generate documentation")
      println("")
      println("Options:")
      println("  -o, --output <DIR>  Output directory (default: docs/api)")
      println("  --format <FMT>      Output format: html, markdown (default: html)")
      println("  --private           Include private items")
      return 0
    elsif !arg.starts_with("-") then
      files.push(arg.clone())
    end
    i = i + 1
  end
  
  if files.is_empty() then
    files = find_tg_files(".")
  end
  
  match generate_docs(files, &config)
  when Result::Ok(count) then
    println("Generated documentation for " + count.to_string() + " item(s) in " + config.output_dir)
    0
  when Result::Err(e) then
    1
  end
end

# 
# Subcommand: bench
# 

use std::bench::{BenchSuite, bench_suite_new, run_benchmarks, parse_bench_args}

def cmd_bench(argv: Vec[String]) -> Int
  # Discover benchmark sources: from CLI args or project.
  let bench_files = if argv.len() > 1 && !argv[1].starts_with("-") then
    mut files = Vec::new()
    mut i: UInt = 1
    while i < argv.len() do
      if !argv[i].starts_with("-") then
        files.push(argv[i].clone())
      end
      i = i + 1
    end
    files
  else
    match load_project(".")
    when Result::Ok(project) then project.sources.clone()
    when Result::Err(_) then find_bench_files(".")
    end
  end

  if bench_files.is_empty() then
    println("No benchmark files found.")
    return 0
  end

  let opts = default_options()
  mut total = 0
  mut ok_count = 0

  for file in bench_files do
    let source = match read_file(file.clone())
    when Result::Ok(content) then content
    when Result::Err(_) then next
    end
    let lex_result = tokenize(source)
    let (ast, parse_diags) = parse(lex_result)
    if diag_has_errors(&parse_diags) then next end

    let cases = extract_bench_functions(&ast, file.clone())
    for bench in cases do
      total = total + 1
      # Compile the file to get a runnable binary, then invoke the bench by name.
      match compile_file(&opts, file.clone())
      when Result::Ok(output_path) then
        let cmd = output_path + " --run-bench " + bench.name.clone()
        let exit_code = bootstrap_call_system(cmd)
        if exit_code == 0 then
          ok_count = ok_count + 1
          println("  bench " + bench.name + " ... ok")
        else
          println("  bench " + bench.name + " ... FAILED (exit " + exit_code.to_string() + ")")
        end
      when Result::Err(e) then
        println("  bench " + bench.name + " ... COMPILE ERROR: " + e)
      end
    end
  end

  println("")
  println("bench result: " + ok_count.to_string() + "/" + total.to_string() + " ok")
  if ok_count < total then 1 else 0 end
end

def find_bench_files(dir: String) -> Vec[String]
  mut files = Vec::new()
  let entries = match std::fs::read_dir(dir)
  when Result::Ok(entries) then entries
  when Result::Err(_) then return files
  end
  
  for entry in entries do
    if entry.is_dir && !entry.name.starts_with(".") then
      let sub = find_bench_files(entry.path.clone())
      for f in sub do files.push(f) end
    elsif entry.name.ends_with("_bench.tg") || entry.name.starts_with("bench_") then
      files.push(entry.path.clone())
    elsif entry.name.ends_with(".tg") then
      match read_file(entry.path.clone())
      when Result::Ok(content) then
        if content.contains("#[bench]") then
          files.push(entry.path.clone())
        end
      when Result::Err(_) then ()
      end
    end
  end
  
  files
end

def extract_bench_functions(ast: &Program, file: String) -> Vec[BenchCase]
  mut cases: Vec[BenchCase] = Vec::new()
  for item in ast.items do
    mut is_bench = false
    for attr in item.attrs do
      if attr.name == "bench" then
        is_bench = true
      end
    end
    if is_bench then
      match item.kind
      when ItemKind::ItemFunction(func_decl) then
        cases.push(BenchCase {
          name: func_decl.name.clone(),
          func: || (),
          setup: Option::None,
          teardown: Option::None,
          iterations: Option::None,
          warmup_iterations: 3,
          input_size: Option::None
        })
      when _ then ()
      end
    end
  end
  cases
end

# 
# Subcommand: repl
# 

def cmd_repl(argv: Vec[String]) -> Int
  println("REPL is unavailable in bootstrap builds.")
  1
end

# 
# Subcommand: lsp
# 

def cmd_lsp(argv: Vec[String]) -> Int
  println("Starting Tangerine Language Server...")
  mut server = lsp_server_new()
  lsp_main_loop(&mut server)
  0
end

# 
# Subcommand: init
# 

def cmd_init(argv: Vec[String]) -> Int
  let project_name = if argv.len() > 1 then
    argv[1].clone()
  else
    "my_project".to_string()
  end
  
  # Create project directory structure
  match std::fs::create_dir(project_name.clone())
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  match std::fs::create_dir(project_name.clone() + "/src")
  when Result::Err(_) then ()
  when Result::Ok(_) then ()
  end
  
  # Write Tangerine.toml
  let manifest = "[package]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
  match write_file(project_name.clone() + "/Tangerine.toml", manifest)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  # Write src/main.tg
  let main_content = "# " + project_name + "\n\ndef main() -> Int\n  println(\"Hello from " + project_name + "!\")\n  0\nend\n"
  match write_file(project_name.clone() + "/src/main.tg", main_content)
  when Result::Err(e) then
    return 1
  when Result::Ok(_) then ()
  end
  
  println("Created project '" + project_name + "'")
  println("  " + project_name + "/Tangerine.toml")
  println("  " + project_name + "/src/main.tg")
  0
end

# 
# Subcommand: compile (raw, no subcommand)
# 

def cmd_compile(argv: Vec[String]) -> Int
  let opts = match parse_args(argv)
  when Result::Ok(o) then
    o
  when Result::Err(e) then
    if e == "help" || e == "version" then
      return 0
    end
    println(e)
    return 1
  end
  
  mut exit_code = 0
  
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println(e)
      exit_code = 1
    end
  end
  
  exit_code
end

def cmd_compile_raw(skip_subcommand: Bool) -> Int
  let opts = match parse_startup_compile_args(skip_subcommand)
  when Result::Ok(o) then
    o
  when Result::Err(e) then
    if e == "help" || e == "version" then
      return 0
    end
    println(e)
    return 1
  end

  if opts.input_files.is_empty() then
  end

  mut exit_code = 0
  for file in opts.input_files do
    match compile_file(&opts, file)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println(e)
      exit_code = 1
    end
  end
  exit_code
end

# Helper: find all .tg files recursively
def find_tg_files(dir: String) -> Vec[String]
  mut files = Vec::new()
  let entries = match std::fs::read_dir(dir)
  when Result::Ok(entries) then entries
  when Result::Err(_) then return files
  end
  
  for entry in entries do
    if entry.is_dir && !entry.name.starts_with(".") && entry.name != "target" then
      let sub = find_tg_files(entry.path.clone())
      for f in sub do files.push(f) end
    elsif entry.name.ends_with(".tg") then
      files.push(entry.path.clone())
    end
  end
  
  files
end

# 
# Standard Library Prelude
# 

def prelude_files() -> Vec[String]
  mut files = Vec::new()
  files.push("std/core.tg")
  files.push("std/collections.tg")
  files.push("std/fmt.tg")
  files.push("std/io.tg")
  files.push("std/fs.tg")
  files.push("std/env.tg")
  files.push("std/contracts.tg")
  files.push("std/capabilities.tg")
  files.push("std/effects.tg")
  files.push("std/budget.tg")
  files.push("std/test.tg")
  files.push("std/ffi.tg")
  files
end

# 
# Incremental Compilation Support
# 

struct IncrementalCache
  entries: Map[String, CacheEntry]
  cache_dir: String
end

struct CacheEntry
  source_hash: String
  mir_hash: String
  timestamp: Int
end

def cache_new(dir: String) -> IncrementalCache
  IncrementalCache {
    entries: Map::new(),
    cache_dir: dir
  }
end

def is_stale(cache: &IncrementalCache, path: String, source: String) -> Bool
  match cache.entries.get(path)
  when Option::Some(entry) then
    let current_hash = fnv1a_hash(source).to_string()
    entry.source_hash != current_hash
  when Option::None then
    true
  end
end

def update_cache(cache: &mut IncrementalCache, path: String, source: String, mir_hash: String) -> Unit
  let source_hash = fnv1a_hash(source).to_string()
  cache.entries.insert(path, CacheEntry {
    source_hash: source_hash,
    mir_hash: mir_hash,
    timestamp: current_time()
  })
end

def current_time() -> Int
  # Return seconds since Unix epoch via std::time.
  let now = std::time::SystemTime::now()
  now.tv.tv_sec as Int
end

def bootstrap_call_system(cmd: String) -> Int
  # Use the safe std::process::Command API instead of raw FFI system().
  # Split the command string at the first space to get program + args.
  mut command = std::process::Command::new("sh".to_string())
  command.arg("-c".to_string())
  command.arg(cmd)
  match command.status()
  when Result::Ok(status) then status.code
  when Result::Err(_) then 127
  end
end

# Local bootstrap-safe project metadata types.
struct Dependency
  name: String
  version: String
  path: Option[String]
  git: Option[String]
end

struct Project
  name: String
  version: String
  dependencies: Vec[Dependency]
  sources: Vec[String]
  output_dir: String
end

# 
# Build System Integration
# 

def load_project(path: String) -> Result[Project, String]
  # Parse a Tangerine.toml project manifest file.
  # Expected format:
  #   [project]
  #   name = "my_app"
  #   version = "0.1.0"
  #   
  #   [sources]
  #   files = ["src/main.tg", "src/lib.tg"]
  #   
  #   [dependencies]
  #   http = { version = "1.0", path = "../http" }
  
  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end
  
  match read_file(manifest_path.clone())
  when Result::Ok(content) then
    # Simple TOML-like parser for the project manifest
    mut name = "untitled"
    mut version = "0.0.0"
    mut sources = Vec::new()
    mut deps = Vec::new()
    mut output_dir = "build"
    mut section = ""
    mut in_sources_array = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      
      # Skip comments and empty lines
      if trimmed.is_empty() || trimmed.starts_with("#") then
        next
      end
      
      # Section headers
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        section = trimmed.slice(1, trimmed.len() - 1)
        in_sources_array = false
        next
      end
      
      # Check if we're inside a multi-line sources array
      if in_sources_array then
        if trimmed.starts_with("]") then
          in_sources_array = false
          next
        end
        let mut entry = trimmed.to_string()
        if entry.ends_with(",") then
          entry = entry.slice(0, entry.len() - 1)
        end
        entry = entry.trim()
        let mut cleaned = ""
        mut i = 0
        while i < entry.len() do
          let ch = entry.char_at(i)
          if ch != '"' then
            cleaned = cleaned + ch.to_string()
          end
          i = i + 1
        end
        entry = cleaned.trim()
        if !entry.is_empty() then
          sources.push(entry.to_string())
        end
        next
      end
      
      # Key-value pairs
      let parts = trimmed.split("=")
      if parts.len() >= 2 then
        let key = parts[0].trim()
        let val = parts[1].trim()
        
        if section == "project" then
          if key == "name" then name = val.trim_matches('"').to_string() end
          if key == "version" then version = val.trim_matches('"').to_string() end
          if key == "output_dir" then output_dir = val.trim_matches('"').to_string() end
        end
        
        if section == "sources" then
          if key == "files" then
            if val.starts_with("[") then
              let mut rest = val.slice(1, val.len())
              let mut closed = false
              while rest.ends_with("]") && rest.len() > 0 do
                rest = rest.slice(0, rest.len() - 1)
                closed = true
              end
              for entry in rest.split(",") do
                let mut src = entry.trim().to_string()
                if src.ends_with(",") && src.len() > 0 then
                  src = src.slice(0, src.len() - 1)
                end
                src = src.trim()
                let mut cleaned = ""
                mut j = 0
                while j < src.len() do
                  let ch = src.char_at(j)
                  if ch != '"' then
                    cleaned = cleaned + ch.to_string()
                  end
                  j = j + 1
                end
                src = cleaned.trim()
                if !src.is_empty() then
                  sources.push(src.to_string())
                end
              end
              if !closed then
                in_sources_array = true
              end
            end
          end
        end
        
        if section == "dependencies" then
          # Simple dependency parsing (name = "version")
          let version_str = val.trim_matches('"')
          match std::semver::Requirement::parse(&version_str)
          when Result::Ok(req) then
            deps.push(Dependency {
              name: key.to_string(),
              version: version_str.to_string(),
              requirement: req,
              registry: Option::None,
              features: Array::new(),
              optional: false,
              dev_only: false,
              path: Option::None,
              git: Option::None
            })
          when Result::Err(_) then ()
          end
        end
      end
    end
    
    # Default: if no sources specified, look for src/main.tg
    if sources.is_empty() then
      sources.push("src/main.tg".to_string())
    end

    Result::Ok(Project {
      name: name.to_string(),
      version: version.to_string(),
      dependencies: deps,
      sources: sources,
      output_dir: output_dir.to_string()
    })
  when Result::Err(e) then
    Result::Err("Cannot read project manifest '" + manifest_path + "': " + e)
  end
end

def build_project(project: &Project) -> Result[Unit, String]
  let opts = default_options()
  
  # Resolve dependencies first
  let resolved = resolve_project_deps(project)?
  
  # Build dependency sources before project sources
  for dep_src in resolved.dep_sources do
    match compile_file(&opts, dep_src)
    when Result::Ok(_) then ()
    when Result::Err(e) then return Result::Err("dependency error: " + e)
    end
  end
  
  # Build cache integration
  mut cache = load_build_cache(&project.output_dir)
  
  for src in project.sources do
    match read_file(src.clone())
    when Result::Ok(content) then
      if is_stale(&cache, src.clone(), content.clone()) then
        match compile_file(&opts, src.clone())
        when Result::Ok(_) then
          update_cache(&mut cache, src.clone(), content, "".to_string())
        when Result::Err(e) then return Result::Err(e)
        end
      else
        # Cache hit  skip recompilation
        ()
      end
    when Result::Err(_) then
      match compile_file(&opts, src)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
  end
  
  save_build_cache(&cache)
  Result::Ok(())
end

# 
# Dependency Resolution & DriverLockfile
# 

struct ResolvedDeps
  packages: Vec[ResolvedPackage]
  dep_sources: Vec[String]
end

struct ResolvedPackage
  name: String
  version: String
  resolved_path: String
  checksum: String
end

struct DriverLockfile
  packages: Vec[DriverLockEntry]
  metadata: Map[String, String]
  version: Int
end

struct DriverLockEntry
  name: String
  version: String
  source: String
  checksum: String
  dependencies: Vec[String]
end

def resolve_project_deps(project: &Project) -> Result[ResolvedDeps, String]
  # Load existing lockfile if present
  let lockfile = load_lockfile("Tangerine.lock")
  
  mut resolved = ResolvedDeps {
    packages: Vec::new(),
    dep_sources: Vec::new()
  }
  
  for dep in project.dependencies do
    # Check lockfile first for reproducibility
    let locked_entry = match lockfile
    when Option::Some(ref lf) then find_lock_entry(lf, &dep.name)
    when Option::None then Option::None
    end
    
    # Resolve the dependency source
    let resolved_pkg = resolve_single_dep(&dep, &locked_entry)?
    
    # Collect source files from resolved dependency
    let dep_dir = resolved_pkg.resolved_path.clone()
    match discover_sources(&dep_dir)
    when Result::Ok(srcs) then
      for s in srcs do
        resolved.dep_sources.push(s)
      end
    when Result::Err(e) then
      return Result::Err("Failed to discover sources for '" + dep.name.clone() + "': " + e)
    end
    
    resolved.packages.push(resolved_pkg)
  end
  
  # Write lockfile with resolved state
  write_lockfile("Tangerine.lock", &resolved)
  
  Result::Ok(resolved)
end

def resolve_single_dep(dep: &Dependency, locked: &Option[DriverLockEntry]) -> Result[ResolvedPackage, String]
  # If a path dependency, use it directly (local development)
  match dep.path
  when Option::Some(ref p) then
    return Result::Ok(ResolvedPackage {
      name: dep.name.clone(),
      version: dep.version.clone(),
      resolved_path: p.clone(),
      checksum: hash_directory(p)
    })
  when Option::None then ()
  end
  
  # If a git dependency, clone/fetch
  match dep.git
  when Option::Some(ref url) then
    let clone_dir = ".tg_deps/" + dep.name.clone()
    
    # Check if already cloned with correct version from lockfile
    match locked
    when Option::Some(ref entry) then
      if dir_exists(&clone_dir) && entry.source == url.clone() then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: clone_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
    
    # Clone the repo
    mkdir_p(".tg_deps")
    let clone_result = run_command("git", vec!["clone", "--depth", "1", url.as_str(), clone_dir.as_str()])
    
    match clone_result
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: clone_dir.clone(),
        checksum: hash_directory(&clone_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to clone '" + dep.name.clone() + "' from " + url.clone() + ": " + e)
    end
  when Option::None then ()
  end
  
  # Registry dependency  fetch from package registry
  let registry_url = "https://registry.tangerine-lang.org"
  let pkg_dir = ".tg_deps/" + dep.name.clone() + "-" + dep.version.clone()
  
  # Check if already downloaded
  if dir_exists(&pkg_dir) then
    match locked
    when Option::Some(ref entry) then
      if entry.version == dep.version then
        return Result::Ok(ResolvedPackage {
          name: dep.name.clone(),
          version: entry.version.clone(),
          resolved_path: pkg_dir,
          checksum: entry.checksum.clone()
        })
      end
    when Option::None then ()
    end
  end
  
  # Download package tarball
  mkdir_p(".tg_deps")
  let fetch_url = registry_url + "/api/v1/packages/" + dep.name.clone() + "/" + dep.version.clone() + "/download"
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (pkg_dir.clone() + ".tar.gz").as_str(), fetch_url.as_str()])
  
  match fetch_result
  when Result::Ok(_) then
    # Extract tarball
    mkdir_p(&pkg_dir)
    let extract = run_command("tar", vec!["xzf", (pkg_dir.clone() + ".tar.gz").as_str(), "-C", pkg_dir.as_str()])
    match extract
    when Result::Ok(_) then
      Result::Ok(ResolvedPackage {
        name: dep.name.clone(),
        version: dep.version.clone(),
        resolved_path: pkg_dir.clone(),
        checksum: hash_directory(&pkg_dir)
      })
    when Result::Err(e) then
      Result::Err("Failed to extract package '" + dep.name.clone() + "': " + e)
    end
  when Result::Err(e) then
    Result::Err("Failed to fetch '" + dep.name.clone() + "@" + dep.version.clone() + "' from registry: " + e)
  end
end

def discover_sources(dir: &String) -> Result[Vec[String], String]
  # Look for Tangerine.toml in the dependency directory to find its sources.
  # If not found, glob for all .tg files under src/.
  let manifest = dir.clone() + "/Tangerine.toml"
  match load_project(manifest)
  when Result::Ok(proj) then
    mut sources = Vec::new()
    for s in proj.sources do
      sources.push(dir.clone() + "/" + s)
    end
    Result::Ok(sources)
  when Result::Err(_) then
    # Fallback: find all .tg files under src/
    let src_dir = dir.clone() + "/src"
    match list_directory(src_dir.clone())
    when Result::Ok(files) then
      mut sources = Vec::new()
      for f in files do
        if f.ends_with(".tg") then
          sources.push(src_dir.clone() + "/" + f)
        end
      end
      Result::Ok(sources)
    when Result::Err(_) then
      # Try root directory
      match list_directory(dir.clone())
      when Result::Ok(files) then
        mut sources = Vec::new()
        for f in files do
          if f.ends_with(".tg") then
            sources.push(dir.clone() + "/" + f)
          end
        end
        Result::Ok(sources)
      when Result::Err(e) then
        Result::Err("Cannot list directory: " + e)
      end
    end
  end
end

def find_lock_entry(lf: &DriverLockfile, name: &String) -> Option[DriverLockEntry]
  for entry in lf.packages do
    if entry.name == *name then
      return Option::Some(entry.clone())
    end
  end
  Option::None
end

#  DriverLockfile I/O 

def load_lockfile(path: &str) -> Option[DriverLockfile]
  match read_file(path.to_string())
  when Result::Ok(content) then
    parse_lockfile(&content)
  when Result::Err(_) then
    Option::None
  end
end

def parse_lockfile(content: &String) -> Option[DriverLockfile]
  # Format:
  #   # This file is auto-generated by tg. Do not edit.
  #   [[package]]
  #   name = "http"
  #   version = "1.0.0"
  #   source = "path:../http"
  #   checksum = "abc123"
  #   dependencies = ["core", "io"]
  
  mut packages = Vec::new()
  mut current_name = "".to_string()
  mut current_version = "".to_string()
  mut current_source = "".to_string()
  mut current_checksum = "".to_string()
  mut current_deps = Vec::new()
  mut in_package = false
  
  for line in content.lines() do
    let trimmed = line.trim()
    
    if trimmed == "[[package]]" then
      # Flush previous package
      if in_package && !current_name.is_empty() then
        packages.push(DriverLockEntry {
          name: current_name.clone(),
          version: current_version.clone(),
          source: current_source.clone(),
          checksum: current_checksum.clone(),
          dependencies: current_deps.clone()
        })
      end
      current_name = "".to_string()
      current_version = "".to_string()
      current_source = "".to_string()
      current_checksum = "".to_string()
      current_deps = Vec::new()
      in_package = true
      next
    end
    
    if !in_package || trimmed.is_empty() || trimmed.starts_with("#") then
      next
    end
    
    match trimmed.split_once("=")
    when Option::Some(kv) then
      let key = kv.0.trim()
      let val = kv.1.trim().trim_matches('"')
      
      if key == "name" then current_name = val.to_string() end
      if key == "version" then current_version = val.to_string() end
      if key == "source" then current_source = val.to_string() end
      if key == "checksum" then current_checksum = val.to_string() end
      if key == "dependencies" then
        let arr = val.trim_matches('[').trim_matches(']')
        for dep_name in arr.split(",") do
          let d = dep_name.trim().trim_matches('"')
          if !d.is_empty() then
            current_deps.push(d.to_string())
          end
        end
      end
    when Option::None then ()
    end
  end
  
  # Flush last package
  if in_package && !current_name.is_empty() then
    packages.push(DriverLockEntry {
      name: current_name.clone(),
      version: current_version.clone(),
      source: current_source.clone(),
      checksum: current_checksum.clone(),
      dependencies: current_deps.clone()
    })
  end
  
  Option::Some(DriverLockfile {
    packages: packages,
    metadata: Map::new(),
    version: 1
  })
end

def write_lockfile(path: &str, resolved: &ResolvedDeps) -> Unit
  mut out = "# This file is auto-generated by tg. Do not edit.\n".to_string()
  out = out + "# Tangerine lockfile v1\n\n"
  
  for pkg in resolved.packages do
    out = out + "[[package]]\n"
    out = out + "name = \"" + pkg.name.clone() + "\"\n"
    out = out + "version = \"" + pkg.version.clone() + "\"\n"
    out = out + "source = \"" + pkg.resolved_path.clone() + "\"\n"
    out = out + "checksum = \"" + pkg.checksum.clone() + "\"\n"
    out = out + "dependencies = []\n\n"
  end
  
  match write_file(path.to_string(), out)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

def hash_directory(dir: &String) -> String
  # Compute a content hash of all .tg files in a directory for reproducibility.
  mut h: UInt = 14695981039346656037  # FNV-1a offset basis
  let prime: UInt = 1099511628211
  
  match list_directory(dir.clone())
  when Result::Ok(files) then
    mut sorted = files.clone()
    sorted.sort()
    for f in sorted do
      if f.ends_with(".tg") then
        match read_file(dir.clone() + "/" + f)
        when Result::Ok(content) then
          for c in content.bytes() do
            h = h ^ (c as UInt)
            h = h * prime
          end
        when Result::Err(_) then ()
        end
      end
    end
  when Result::Err(_) then ()
  end
  
  h.to_string()
end

# 
# Workspace Support
# 

struct Workspace
  root: String
  members: Vec[String]
  default_members: Vec[String]
  shared_output: String
end

def load_workspace(path: String) -> Result[Workspace, String]
  # Parse a workspace Tangerine.toml with [workspace] section.
  let manifest_path = if path.ends_with("Tangerine.toml") then
    path.clone()
  else
    path.clone() + "/Tangerine.toml"
  end
  
  match read_file(manifest_path.clone())
  when Result::Ok(content) then
    mut members = Vec::new()
    mut default_members = Vec::new()
    mut section = ""
    mut is_workspace = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      if trimmed.is_empty() || trimmed.starts_with("#") then
        next
      end
      
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        section = trimmed.slice(1, trimmed.len() - 1)
        if section == "workspace" then is_workspace = true end
        next
      end
      
      if section == "workspace" then
        match trimmed.split_once("=")
        when Option::Some(kv) then
          let key = kv.0.trim()
          let val = kv.1.trim()
          
          if key == "members" then
            let arr = val.trim_matches('[').trim_matches(']')
            for entry in arr.split(",") do
              let m = entry.trim().trim_matches('"')
              if !m.is_empty() then
                members.push(m.to_string())
              end
            end
          end
          
          if key == "default-members" then
            let arr = val.trim_matches('[').trim_matches(']')
            for entry in arr.split(",") do
              let m = entry.trim().trim_matches('"')
              if !m.is_empty() then
                default_members.push(m.to_string())
              end
            end
          end
        when Option::None then ()
        end
      end
    end
    
    if !is_workspace then
      return Result::Err("No [workspace] section in " + manifest_path)
    end
    
    if default_members.is_empty() then
      default_members = members.clone()
    end
    
    Result::Ok(Workspace {
      root: path.clone(),
      members: members,
      default_members: default_members,
      shared_output: path + "/build"
    })
  when Result::Err(e) then
    Result::Err("Cannot read workspace manifest: " + e)
  end
end

def build_workspace(ws: &Workspace) -> Result[Unit, String]
  println("Building workspace with " + ws.members.len().to_string() + " member(s)")
  
  for member in ws.default_members do
    let member_path = ws.root.clone() + "/" + member.clone()
    println("  Building " + member.clone() + "...")
    
    match load_project(member_path.clone())
    when Result::Ok(project) then
      match build_project(&project)
      when Result::Ok(_) then
        println("     " + member.clone())
      when Result::Err(e) then
        return Result::Err("Failed to build workspace member '" + member + "': " + e)
      end
    when Result::Err(e) then
      return Result::Err("Failed to load workspace member '" + member + "': " + e)
    end
  end
  
  println("Workspace build complete.")
  Result::Ok(())
end

# 
# tg dep  Dependency Management
# 

def cmd_dep(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg dep <subcommand>")
    println("")
    println("Subcommands:")
    println("  add <name> [--version <ver>] [--path <path>] [--git <url>]")
    println("  remove <name>")
    println("  list")
    println("  update [<name>]")
    println("  tree")
    return 1
  end
  
  let sub = argv[1].clone()
  
  if sub == "add" then
    cmd_dep_add(argv)
  elsif sub == "remove" then
    cmd_dep_remove(argv)
  elsif sub == "list" then
    cmd_dep_list()
  elsif sub == "update" then
    cmd_dep_update(argv)
  elsif sub == "tree" then
    cmd_dep_tree()
  else
    1
  end
end

def cmd_dep_add(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  mut version = "*".to_string()
  mut path_opt = Option::None
  mut git_opt = Option::None
  
  mut i: UInt = 3
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--path" && i + 1 < argv.len() then
      path_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    elsif argv[i] == "--git" && i + 1 < argv.len() then
      git_opt = Option::Some(argv[i + 1].clone())
      i = i + 2
    else
      i = i + 1
    end
  end
  
  # Read current manifest
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Check if [dependencies] section exists
    mut new_content = content.clone()
    let dep_line = name.clone() + " = " + match path_opt
    when Option::Some(ref p) then
      "{ version = \"" + version.clone() + "\", path = \"" + p.clone() + "\" }"
    when Option::None then
      match git_opt
      when Option::Some(ref url) then
        "{ version = \"" + version.clone() + "\", git = \"" + url.clone() + "\" }"
      when Option::None then
        "\"" + version.clone() + "\""
      end
    end
    
    if content.contains("[dependencies]") then
      # Append after [dependencies] line
      new_content = content.replace("[dependencies]", "[dependencies]\n" + dep_line)
    else
      # Add [dependencies] section
      new_content = content + "\n[dependencies]\n" + dep_line + "\n"
    end
    
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Added dependency: " + name + " " + version)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_remove(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  
  let name = argv[2].clone()
  
  match read_file("Tangerine.toml".to_string())
  when Result::Ok(content) then
    # Remove lines matching the dependency name in [dependencies]
    mut new_lines = Vec::new()
    mut in_deps = false
    
    for line in content.lines() do
      let trimmed = line.trim()
      
      if trimmed == "[dependencies]" then
        in_deps = true
        new_lines.push(line.to_string())
        next
      end
      
      if trimmed.starts_with("[") && trimmed.ends_with("]") then
        in_deps = false
      end
      
      if in_deps && trimmed.starts_with(name.as_str()) then
        # Skip this dependency line
        next
      end
      
      new_lines.push(line.to_string())
    end
    
    let new_content = new_lines.join("\n")
    match write_file("Tangerine.toml".to_string(), new_content)
    when Result::Ok(_) then
      println("Removed dependency: " + name)
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(_) then
    1
  end
end

def cmd_dep_list() -> Int
  match load_project(".")
  when Result::Ok(project) then
    if project.dependencies.is_empty() then
      println("No dependencies.")
    else
      println("Dependencies:")
      for dep in project.dependencies do
        mut info = "  " + dep.name.clone() + " " + dep.version.clone()
        match dep.path
        when Option::Some(ref p) then info = info + " (path: " + p.clone() + ")"
        when Option::None then ()
        end
        match dep.git
        when Option::Some(ref url) then info = info + " (git: " + url.clone() + ")"
        when Option::None then ()
        end
        println(info)
      end
    end
    0
  when Result::Err(e) then
    1
  end
end

def cmd_dep_update(argv: Vec[String]) -> Int
  # Re-resolve all dependencies (or a specific one) and update lockfile
  let filter = if argv.len() >= 3 then
    Option::Some(argv[2].clone())
  else
    Option::None
  end
  
  match load_project(".")
  when Result::Ok(project) then
    # Remove lockfile to force re-resolution
    match filter
    when Option::Some(ref name) then
      println("Updating dependency: " + name.clone())
    when Option::None then
      println("Updating all dependencies...")
      # Delete existing lockfile to force fresh resolution
      let _ = delete_file("Tangerine.lock")
    end
    
    match resolve_project_deps(&project)
    when Result::Ok(resolved) then
      println("Updated " + resolved.packages.len().to_string() + " package(s).")
      0
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def cmd_dep_tree() -> Int
  # Display dependency tree
  match load_project(".")
  when Result::Ok(project) then
    println(project.name.clone() + " v" + project.version.clone())
    for dep in project.dependencies do
      let prefix = " "
      mut line = prefix + dep.name.clone() + " v" + dep.version.clone()
      match dep.path
      when Option::Some(ref p) then line = line + " (path)"
      when Option::None then ()
      end
      match dep.git
      when Option::Some(ref url) then line = line + " (git)"
      when Option::None then ()
      end
      println(line)
      
      # Attempt to load transitive deps
      let dep_dir = match dep.path
      when Option::Some(ref p) then p.clone()
      when Option::None then ".tg_deps/" + dep.name.clone()
      end
      
      match load_project(dep_dir)
      when Result::Ok(sub_proj) then
        for sub_dep in sub_proj.dependencies do
          println("    " + sub_dep.name.clone() + " v" + sub_dep.version.clone())
        end
      when Result::Err(_) then ()
      end
    end
    0
  when Result::Err(e) then
    1
  end
end

# 
# tg install  Package Installation
# 

def cmd_install(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg install <package-name> [--version <ver>]")
    println("")
    println("Installs a Tangerine package binary to ~/.tg/bin/")
    println("")
    println("Options:")
    println("  --version <ver>  Install a specific version")
    println("  --global         Install globally (default)")
    println("  --force          Reinstall even if already installed")
    return 0
  end
  
  let pkg_name = argv[1].clone()
  mut version = "latest".to_string()
  mut force = false
  
  mut i: UInt = 2
  while i < argv.len() do
    if argv[i] == "--version" && i + 1 < argv.len() then
      version = argv[i + 1].clone()
      i = i + 2
    elsif argv[i] == "--force" then
      force = true
      i = i + 1
    else
      i = i + 1
    end
  end
  
  let install_dir = home_dir() + "/.tg/bin"
  mkdir_p(&install_dir)
  
  let install_path = install_dir.clone() + "/" + pkg_name.clone()
  
  if !force && file_exists(&install_path) then
    println("Package '" + pkg_name.clone() + "' is already installed. Use --force to reinstall.")
    return 0
  end
  
  println("Installing " + pkg_name.clone() + " " + version.clone() + "...")
  
  # Create a temp directory, fetch the package, build it, copy binary
  let tmp_dir = "/tmp/tg_install_" + pkg_name.clone()
  mkdir_p(&tmp_dir)
  
  # Fetch from registry
  let registry_url = "https://registry.tangerine-lang.org"
  let fetch_url = registry_url + "/api/v1/packages/" + pkg_name.clone() + "/" + version.clone() + "/download"
  
  let fetch_result = run_command("curl", vec!["-sSL", "-o", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), fetch_url.as_str()])
  match fetch_result
  when Result::Ok(_) then
    # Extract
    let extract = run_command("tar", vec!["xzf", (tmp_dir.clone() + "/pkg.tar.gz").as_str(), "-C", tmp_dir.as_str()])
    match extract
    when Result::Ok(_) then
      # Build the package
      match load_project(tmp_dir.clone())
      when Result::Ok(project) then
        match build_project(&project)
        when Result::Ok(_) then
          # Copy resulting binary to install dir
          let binary = tmp_dir.clone() + "/build/" + pkg_name.clone()
          let cp_result = run_command("cp", vec![binary.as_str(), install_path.as_str()])
          match cp_result
          when Result::Ok(_) then
            # Make executable
            let _ = run_command("chmod", vec!["+x", install_path.as_str()])
            println("Installed " + pkg_name.clone() + " to " + install_path)
            0
          when Result::Err(e) then
            1
          end
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

# 
# tg self-update  Compiler Version Manager
# 

def cmd_self_update(argv: Vec[String]) -> Int
  println("Tangerine self-update")
  println("")
  
  let current_version = VERSION
  
  # Determine target triple
  let os = detect_os()
  let arch = detect_arch()
  let target = arch + "-" + os
  
  println("Current version: " + current_version)
  println("Target: " + target.clone())
  
  # Check for latest version from release server
  let release_url = "https://releases.tangerine-lang.org/latest/version"
  println("Checking for updates...")
  
  let version_result = run_command("curl", vec!["-sSL", release_url.as_str()])
  match version_result
  when Result::Ok(latest_version) then
    let latest = latest_version.trim().to_string()
    
    if latest == current_version then
      println("Already up to date (v" + current_version + ").")
      return 0
    end
    
    println("New version available: v" + latest.clone())
    println("Downloading...")
    
    let download_url = "https://releases.tangerine-lang.org/" + latest.clone() + "/tg-" + target + ".tar.gz"
    let tmp = "/tmp/tg_self_update.tar.gz"
    
    let dl = run_command("curl", vec!["-sSL", "-o", tmp, download_url.as_str()])
    match dl
    when Result::Ok(_) then
      # Extract to temp location
      let tmp_dir = "/tmp/tg_self_update"
      mkdir_p(tmp_dir)
      let extract = run_command("tar", vec!["xzf", tmp, "-C", tmp_dir])
      
      match extract
      when Result::Ok(_) then
        # Replace current binary
        let current_binary = argv[0].clone()  # Path to running tg binary
        let new_binary = tmp_dir.to_string() + "/tg"
        
        let cp = run_command("cp", vec![new_binary.as_str(), current_binary.as_str()])
        match cp
        when Result::Ok(_) then
          let _ = run_command("chmod", vec!["+x", current_binary.as_str()])
          println("Updated to v" + latest + " successfully!")
          0
        when Result::Err(e) then
          1
        end
      when Result::Err(e) then
        1
      end
    when Result::Err(e) then
      1
    end
  when Result::Err(e) then
    1
  end
end

def detect_os() -> String
  # Check via uname (available on macOS/Linux)
  match run_command("uname", vec!["-s"])
  when Result::Ok(out) then
    let os = out.trim().to_lowercase()
    if os.contains("darwin") then "apple-darwin".to_string()
    elsif os.contains("linux") then "unknown-linux-gnu".to_string()
    else "unknown".to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end
end

def detect_arch() -> String
  match run_command("uname", vec!["-m"])
  when Result::Ok(out) then
    let arch = out.trim().to_lowercase()
    if arch == "x86_64" || arch == "amd64" then "x86_64".to_string()
    elsif arch == "arm64" || arch == "aarch64" then "aarch64".to_string()
    else arch.to_string()
    end
  when Result::Err(_) then
    "unknown".to_string()
  end
end

def cmd_explain_main(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    return 1
  end
  cmd_explain(argv[1].clone())
  0
end

# 
# Subcommand: agent
# 
#
# Run agentic workflows using the Tangerine agentic subsystem.
# Provides CLI access to contracts, capabilities, effects, and budgets.
#
# Usage:
#   tg agent check <file>            verify all contracts in a source file
#   tg agent caps <file>             list capabilities required by a module
#   tg agent effects <file>          list effects performed by a module
#   tg agent budget <file>           analyse resource budget of a module
#   tg agent diff <old> <new>        semantic diff between two source files
#   tg agent audit <dir>             full agentic audit of a project

def cmd_agent(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    println("Usage: tg agent <subcommand> [options] <file>")
    println("")
    println("Subcommands:")
    println("  check    Verify all contracts (pre/post/invariant)")
    println("  caps     List required capabilities")
    println("  effects  List effects performed by each function")
    println("  budget   Analyse resource budget usage")
    println("  diff     Semantic diff between two source files")
    println("  audit    Full agentic audit of a project directory")
    return 1
  end

  let subcmd = argv[1].clone()
  
  if subcmd == "check" then
    agent_check(argv)
  elsif subcmd == "caps" then
    agent_caps(argv)
  elsif subcmd == "effects" then
    agent_effects(argv)
  elsif subcmd == "budget" then
    agent_budget(argv)
  elsif subcmd == "diff" then
    agent_diff(argv)
  elsif subcmd == "audit" then
    agent_audit(argv)
  else
    1
  end
end

def agent_check(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Extract contract declarations from the AST
  mut contract_count = 0
  mut violation_count = 0

  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      for contract in f.contracts do
        contract_count = contract_count + 1
        # Verify contract is well-formed (condition references in-scope names)
        println("  [" + contract.kind.to_string() + "] " + f.name.clone() + ": " + contract.condition_source.clone())
      end
    when _ then ()
    end
  end

  println("Contract analysis for " + path + ":")
  println("  Total contracts: " + contract_count.to_string())
  println("  Violations: " + violation_count.to_string())
  if violation_count == 0 then 0 else 1 end
end

def agent_caps(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for capability annotations: #[require(cap)] and `require_capability` calls
  mut caps = Set::new()
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      for attr in item.attrs do
        if attr.name == "require" then
          for arg in attr.args do
            caps.insert(arg.value.clone())
          end
        end
      end
    when _ then ()
    end
  end

  println("Capabilities required by " + path + ":")
  if caps.is_empty() then
    println("  (none)")
  else
    for cap_name in caps do
      println("  - " + cap_name)
    end
  end
  0
end

def agent_effects(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Scan for effect annotations and perform declarations
  println("Effects in " + path + ":")
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      mut fn_effects = Vec::new()
      for attr in item.attrs do
        if attr.name == "performs" || attr.name == "effect" then
          for arg in attr.args do
            fn_effects.push(arg.value.clone())
          end
        end
      end
      if !fn_effects.is_empty() then
        mut effect_str = ""
        mut first = true
        for e in fn_effects do
          if !first then effect_str = effect_str + ", " end
          effect_str = effect_str + e
          first = false
        end
        println("  " + f.name.clone() + ": performs " + effect_str)
      end
    when _ then ()
    end
  end
  0
end

def agent_budget(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end
  let path = argv[2].clone()
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Lower to MIR and analyse budget consumption
  let type_errors = type_check(&ast)
  if !type_errors.is_empty() then
    return 1
  end

  let mir = lower_to_mir(&ast)

  println("Budget analysis for " + path + ":")
  for func in mir.functions do
    mut budget_ops = Vec::new()
    for block in func.blocks do
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirBudgetConsume(resource, amount) then
          budget_ops.push((resource.clone(), amount))
        when _ then ()
        end
      end
    end
    if !budget_ops.is_empty() then
      println("  fn " + func.name.clone() + ":")
      for op in budget_ops do
        let res = op.0
        let amt = op.1
        println("    consumes " + amt.to_string() + " units of " + res)
      end
    end
  end
  0
end

def agent_diff(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end
  let old_path = argv[2].clone()
  let new_path = argv[3].clone()

  let old_source = match read_file(old_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end
  let new_source = match read_file(new_path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  # Parse both
  let (old_ast, old_diags) = parse(tokenize(old_source))
  if diag_has_errors(&old_diags) then
    return 1
  end
  let (new_ast, new_diags) = parse(tokenize(new_source))
  if diag_has_errors(&new_diags) then
    return 1
  end

  # Semantic diff: compare items by name
  println("Semantic diff: " + old_path + "  " + new_path)

  mut old_items: Map[String, String] = Map::new()
  for item in old_ast.items do
    let name = item_name(&item)
    old_items.insert(name, item.kind.to_string())
  end

  mut new_items: Map[String, String] = Map::new()
  for item in new_ast.items do
    let name = item_name(&item)
    new_items.insert(name, item.kind.to_string())
  end

  # Added items
  for entry in new_items do
    let name = entry.key
    if !old_items.contains_key(&name) then
      println("  + " + name + " (added)")
    end
  end

  # Removed items
  for entry in old_items do
    let name = entry.key
    if !new_items.contains_key(&name) then
      println("  - " + name + " (removed)")
    end
  end

  # Modified items
  for entry in old_items do
    let name = entry.key
    let old_kind = entry.value
    match new_items.get(&name)
    when Option::Some(new_kind) then
      if old_kind != new_kind then
        println("  ~ " + name + " (modified)")
      end
    when Option::None then ()
    end
  end
  0
end

def item_name(item: &Item) -> String
  match item.kind
  when ItemKind::Function(f) then f.name.clone()
  when ItemKind::Struct(s) then s.name.clone()
  when ItemKind::Enum(e) then e.name.clone()
  when ItemKind::Trait(t) then t.name.clone()
  when ItemKind::Impl(i) then "impl_" + i.type_name.clone()
  when ItemKind::Const(c) then c.name.clone()
  when ItemKind::Macro(m) then "macro_" + m.name.clone()
  when _ then "<anonymous>"
  end
end

def agent_audit(argv: Vec[String]) -> Int
  let dir = if argv.len() >= 3 then argv[2].clone() else ".".to_string() end

  println("Agentic audit of " + dir + ":")
  println("========================================")

  # Discover all .tg files
  let files = discover_sources(&dir)

  mut total_contracts = 0
  mut total_caps = 0
  mut total_effects = 0
  mut total_unsafe = 0
  mut total_functions = 0

  for file in files do
    let source = match read_file(file.clone())
    when Result::Ok(s) then s
    when Result::Err(_) then next
    end

    let tokens = tokenize(source)
    let (ast, parse_diags) = parse(tokens)
    if diag_has_errors(&parse_diags) then next end

    for item in ast.items do
      match item.kind
      when ItemKind::Function(f) then
        total_functions = total_functions + 1
        total_contracts = total_contracts + f.contracts.len()
        if f.is_unsafe then total_unsafe = total_unsafe + 1 end
        for attr in item.attrs do
          if attr.name == "require" then
            total_caps = total_caps + attr.args.len()
          end
          if attr.name == "performs" || attr.name == "effect" then
            total_effects = total_effects + attr.args.len()
          end
        end
      when _ then ()
      end
    end
  end

  println("  Files scanned:   " + files.len().to_string())
  println("  Functions:       " + total_functions.to_string())
  println("  Contracts:       " + total_contracts.to_string())
  println("  Capabilities:    " + total_caps.to_string())
  println("  Effects:         " + total_effects.to_string())
  println("  Unsafe functions:" + total_unsafe.to_string())
  println("")

  if total_unsafe > 0 then
    println("  WARNING: " + total_unsafe.to_string() + " unsafe functions found  ensure SAFETY comments are present")
  end

  println("Audit complete.")
  0
end

# 
# Subcommand: bindgen
# 
# Generates FFI bindings for C, Rust, and Ruby.
# Per interop.txt 8.2, 9.1, 12
#
# Usage:
#   tg bindgen c <file.tg> [-o output.h]
#   tg bindgen rust <file.tg> [-o output_dir]
#   tg bindgen ruby <file.tg> [-o output_dir]

def cmd_bindgen(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    print_bindgen_help()
    return 1
  end

  let target = argv[1].clone()
  let file = argv[2].clone()

  let output = if argv.len() >= 5 && argv[3] == "-o" then
    argv[4].clone()
  else
    match target.as_str()
    when "c" then file.replace(".tg", ".h")
    when "rust" then "tangerine_shim"
    when "ruby" then "ext"
    end
  end

  match target.as_str()
  when "c" then bindgen_c(file, output)
  when "rust" then bindgen_rust(file, output)
  when "ruby" then bindgen_ruby(file, output)
  when _ then
    1
  end
end

def print_bindgen_help() -> Unit
  println("Usage: tg bindgen <target> <file.tg> [-o output]")
  println("Generate FFI bindings")
  println("")
  println("Targets:")
  println("  c      Generate C header (.h)")
  println("  rust   Generate Rust shim crate")
  println("  ruby   Generate Ruby extension scaffold")
  println("")
  println("Options:")
  println("  -o <path>  Output file/directory")
end

# Generate C header from Tangerine source
def bindgen_c(source_file: String, output: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  mut header = "/* Generated by tg bindgen c */\n"
  header = header + "#ifndef TG_BINDINGS_H\n"
  header = header + "#define TG_BINDINGS_H\n\n"
  header = header + "#include <stdint.h>\n"
  header = header + "#include <stdbool.h>\n\n"

  header = header + "/* Type aliases */\n"
  header = header + "typedef int64_t tg_int;\n"
  header = header + "typedef uint64_t tg_uint;\n"
  header = header + "typedef double tg_float;\n"
  header = header + "typedef uint8_t tg_u8;\n"
  header = header + "typedef uint32_t tg_char;\n\n"

  header = header + "/* FFI string view (borrowed) */\n"
  header = header + "typedef struct { const uint8_t* ptr; size_t len; } tg_str;\n\n"

  header = header + "/* FFI result */\n"
  header = header + "typedef struct { bool ok; int32_t err_code; } tg_result_void;\n\n"

  # Extract extern "C" functions
  header = header + "/* Exported functions */\n"
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      if is_ffi_exported(&f, &item.attrs) then
        header = header + generate_c_prototype(&f) + "\n"
      end
    when ItemKind::Struct(s) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_struct(&s) + "\n"
      end
    when ItemKind::Enum(e) then
      if is_repr_c(&item.attrs) then
        header = header + generate_c_enum(&e) + "\n"
      end
    when _ then ()
    end
  end

  header = header + "\n#endif /* TG_BINDINGS_H */\n"

  match write_file(output.clone(), header)
  when Result::Ok(_) then
    println("Generated " + output)
    0
  when Result::Err(e) then
    1
  end
end

def is_ffi_exported(f: &FunctionDecl, annotations: &Vec[Annotation]) -> Bool
  # Check if function has extern "C" abi or has #[export] annotation
  annotations.iter().any(|a| a.name == "export")
end

def is_repr_c(annotations: &Vec[Annotation]) -> Bool
  for a in annotations do
    if a.name == "repr" then
      for arg in a.args do
        if arg.value == "c" || arg.value == "C" then
          return true
        end
      end
    end
  end
  false
end

def generate_c_prototype(f: &FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_expr_to_c(rt)
    when Option::None then "void"
  end
  mut params = ""
  mut first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_expr_to_c(t)
      when Option::None then "void*"
    end
    params = params + ty_str + " " + p.name.clone()
    first = false
  end
  if params == "" then params = "void" end
  ret_type + " " + f.name.clone() + "(" + params + ");"
end

def generate_c_struct(s: &Struct) -> String
  mut result = "typedef struct {\n"
  for field in s.fields do
    result = result + "    " + tangerine_type_expr_to_c(&field.ty) + " " + field.name.clone() + ";\n"
  end
  result = result + "} " + s.name.clone() + ";\n"
  result
end

def generate_c_enum(e: &Enum) -> String
  mut result = "typedef enum {\n"
  mut val = 0
  for variant in e.variants do
    result = result + "    " + e.name.clone() + "_" + variant.name.clone()
    result = result + " = " + val.to_string() + ",\n"
    val = val + 1
  end
  result = result + "} " + e.name.clone() + ";\n"
  result
end

def tangerine_type_to_c(ty: String) -> String
  if ty == "Bool" then "bool"
  elsif ty == "Int" then "tg_int"
  elsif ty == "UInt" then "tg_uint"
  elsif ty == "Float" then "tg_float"
  elsif ty == "Char" then "tg_char"
  elsif ty == "String" then "tg_str"
  elsif ty == "U8" then "tg_u8"
  else ty.clone()
  end
end

def tangerine_type_expr_to_c(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "void"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "int64_t"
    elsif name == "UInt" then "uint64_t"
    elsif name == "Float" then "double"
    elsif name == "Char" then "uint32_t"
    elsif name == "String" then "tg_str"
    else name.clone()
    end
  when TypeExprKind::Ref(inner) then "const " + tangerine_type_expr_to_c(&inner) + "*"
  when TypeExprKind::RefMut(inner) then tangerine_type_expr_to_c(&inner) + "*"
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "void*"
  end
end

# Generate Rust shim crate
def bindgen_rust(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())
  std::fs::create_dir_all(output_dir.clone() + "/src")

  # Generate Cargo.toml
  let cargo_toml = "[package]\n" +
    "name = \"tangerine_shim\"\n" +
    "version = \"0.1.0\"\n" +
    "edition = \"2021\"\n\n" +
    "[lib]\n" +
    "crate-type = [\"cdylib\", \"staticlib\"]\n"

  match write_file(output_dir.clone() + "/Cargo.toml", cargo_toml)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate lib.rs
  mut lib_rs = "//! Generated by tg bindgen rust\n\n"
  lib_rs = lib_rs + "#![allow(non_camel_case_types)]\n\n"

  lib_rs = lib_rs + "// Type aliases\n"
  lib_rs = lib_rs + "pub type tg_int = i64;\n"
  lib_rs = lib_rs + "pub type tg_uint = u64;\n"
  lib_rs = lib_rs + "pub type tg_float = f64;\n\n"

  lib_rs = lib_rs + "// FFI string view\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgStr { pub ptr: *const u8, pub len: usize }\n\n"

  lib_rs = lib_rs + "// FFI result\n"
  lib_rs = lib_rs + "#[repr(C)]\n"
  lib_rs = lib_rs + "pub struct TgResultVoid { pub ok: bool, pub err_code: i32 }\n\n"

  lib_rs = lib_rs + "extern \"C\" {\n"
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      if is_ffi_exported(&f, &item.attrs) then
        lib_rs = lib_rs + "    " + generate_rust_extern(&f) + "\n"
      end
    when _ then ()
    end
  end
  lib_rs = lib_rs + "}\n"

  match write_file(output_dir.clone() + "/src/lib.rs", lib_rs)
  when Result::Ok(_) then
    println("Generated Rust shim in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_rust_extern(f: &FunctionDecl) -> String
  let ret_type = match f.ret_type
    when Option::Some(rt) then tangerine_type_to_rust(rt)
    when Option::None then "()"
  end
  mut params = ""
  mut first = true
  for p in f.params do
    if !first then params = params + ", " end
    let ty_str = match p.ty
      when Option::Some(t) then tangerine_type_to_rust(t)
      when Option::None then "*const ()"
    end
    params = params + p.name.clone() + ": " + ty_str
    first = false
  end
  let ret_clause = if ret_type == "()" then "" else " -> " + ret_type end
  "pub fn " + f.name.clone() + "(" + params + ")" + ret_clause + ";"
end

def tangerine_type_to_rust(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "()"
  when TypeExprKind::Named(name, _) then
    if name == "Bool" then "bool"
    elsif name == "Int" then "i64"
    elsif name == "UInt" then "u64"
    elsif name == "Float" then "f64"
    elsif name == "Char" then "u32"
    elsif name == "String" then "TgStr"
    else name.clone()
    end
  when TypeExprKind::Ref(inner) then "*const " + tangerine_type_to_rust(&inner)
  when TypeExprKind::RefMut(inner) then "*mut " + tangerine_type_to_rust(&inner)
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then "*mut std::ffi::c_void"
  end
end

# Generate Ruby extension scaffold
def bindgen_ruby(source_file: String, output_dir: String) -> Int
  let source = match read_file(source_file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  let module_name = source_file.replace(".tg", "").replace("/", "_")

  # Create output directory
  std::fs::create_dir_all(output_dir.clone())

  # Generate extconf.rb
  let extconf = "require 'mkmf'\n\n" +
    "extension_name = '" + module_name + "'\n" +
    "dir_config(extension_name)\n" +
    "create_makefile(extension_name)\n"

  match write_file(output_dir.clone() + "/extconf.rb", extconf)
  when Result::Err(e) then
    return 1
  when _ then ()
  end

  # Generate extension.c
  mut ext_c = "/* Generated by tg bindgen ruby */\n"
  ext_c = ext_c + "#include \"ruby.h\"\n\n"
  ext_c = ext_c + "static VALUE m" + module_name + ";\n\n"

  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      if is_ffi_exported(&f, &item.attrs) then
        ext_c = ext_c + generate_ruby_wrapper(&f, &module_name) + "\n"
      end
    when _ then ()
    end
  end

  ext_c = ext_c + "void Init_" + module_name + "(void) {\n"
  ext_c = ext_c + "    m" + module_name + " = rb_define_module(\"" + capitalize(&module_name) + "\");\n"
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let argc = f.params.len()
        ext_c = ext_c + "    rb_define_module_function(m" + module_name
        ext_c = ext_c + ", \"" + f.name.clone() + "\", rb_" + f.name.clone()
        ext_c = ext_c + ", " + argc.to_string() + ");\n"
      end
    when _ then ()
    end
  end
  ext_c = ext_c + "}\n"

  match write_file(output_dir.clone() + "/" + module_name + ".c", ext_c)
  when Result::Ok(_) then
    println("Generated Ruby extension in " + output_dir)
    0
  when Result::Err(e) then
    1
  end
end

def generate_ruby_wrapper(f: &FunctionDecl, module_name: &String) -> String
  let argc = f.params.len()
  mut params = ""
  mut i = 0
  while i < argc do
    if i > 0 then params = params + ", " end
    params = params + "VALUE arg" + i.to_string()
    i = i + 1
  end
  if argc == 0 then params = "VALUE self" else params = "VALUE self, " + params end

  # Build argument conversion code
  mut conversions = ""
  mut call_args = ""
  i = 0
  while i < argc do
    let param = &f.params[i]
    let arg_name = "arg" + i.to_string()
    let conv_name = "c_" + arg_name
    
    # Generate conversion based on parameter type
    let (conv_code, c_type) = match param.ty
      when Option::Some(t) then ruby_to_c_conversion(arg_name.clone(), t)
      when Option::None then ("(void*)" + arg_name.clone(), "void*")
    end
    conversions = conversions + "    " + c_type + " " + conv_name + " = " + conv_code + ";\n"
    
    if i > 0 then call_args = call_args + ", " end
    call_args = call_args + conv_name
    i = i + 1
  end
  
  # Generate return value handling
  let (ret_decl, ret_call, ret_conv) = match f.ret_type
    when Option::Some(rt) then c_to_ruby_return(rt)
    when Option::None then ("", "", "    return Qnil;\n")
  end

  "static VALUE rb_" + f.name.clone() + "(" + params + ") {\n" +
  conversions +
  ret_decl +
  "    " + ret_call + f.name.clone() + "(" + call_args + ");\n" +
  ret_conv +
  "}\n"
end

# Convert Ruby VALUE to C type for function call
def ruby_to_c_conversion(arg: String, ty: &TypeExpr) -> (String, String)
  match ty.kind
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then ("NUM2LONG(" + arg + ")", "long")
    when "UInt" then ("NUM2ULONG(" + arg + ")", "unsigned long")
    when "Float" then ("NUM2DBL(" + arg + ")", "double")
    when "Bool" then ("RTEST(" + arg + ")", "int")
    when "String" then ("StringValueCStr(" + arg + ")", "const char*")
    when "RubyValue" then (arg, "VALUE")
    when _ then ("(void*)" + arg, "void*")
    end
  when TypeExprKind::Ref(inner) then
    let (inner_conv, inner_type) = ruby_to_c_conversion(arg.clone(), &inner)
    ("&" + inner_conv, inner_type + "*")
  when TypeExprKind::RefMut(inner) then
    let (inner_conv, inner_type) = ruby_to_c_conversion(arg.clone(), &inner)
    ("&" + inner_conv, inner_type + "*")
  when TypeExprKind::Ptr(_) then
    ("(void*)" + arg, "void*")
  when TypeExprKind::PtrMut(_) then
    ("(void*)" + arg, "void*")
  when _ then
    ("(void*)" + arg, "void*")
  end
end

# Generate C return handling code for Ruby
def c_to_ruby_return(ty: &TypeExpr) -> (String, String, String)
  match ty.kind
  when TypeExprKind::Unit then
    ("", "", "    return Qnil;\n")
  when TypeExprKind::Named(name, _) then
    match name.as_str()
    when "Int" then
      ("    long tg_result;\n", "tg_result = ", "    return LONG2NUM(tg_result);\n")
    when "UInt" then
      ("    unsigned long tg_result;\n", "tg_result = ", "    return ULONG2NUM(tg_result);\n")
    when "Float" then
      ("    double tg_result;\n", "tg_result = ", "    return DBL2NUM(tg_result);\n")
    when "Bool" then
      ("    int tg_result;\n", "tg_result = ", "    return tg_result ? Qtrue : Qfalse;\n")
    when "String" then
      ("    const char* tg_result;\n", "tg_result = ", "    return rb_str_new_cstr(tg_result);\n")
    when "RubyValue" then
      ("    VALUE tg_result;\n", "tg_result = ", "    return tg_result;\n")
    when _ then
      ("", "", "    return Qnil;\n")
    end
  when _ then
    ("", "", "    return Qnil;\n")
  end
end

def capitalize(s: &String) -> String
  if s.is_empty() then return "" end
  let first = s.char_at(0).to_uppercase().to_string()
  first + s.slice(1, s.len())
end

# 
# Subcommand: abi
# 
# ABI tools: test, dump, check
# Per interop.txt 10.2
#
# Usage:
#   tg abi test [file.tg]    validate ABI conformance
#   tg abi dump <file.tg>    dump type layouts
#   tg abi check <a.tg> <b.tg>   check ABI compatibility

def cmd_abi(argv: Vec[String]) -> Int
  if argv.len() < 2 then
    print_abi_help()
    return 1
  end

  let subcmd = argv[1].clone()
  match subcmd.as_str()
  when "test" then abi_test(argv)
  when "dump" then abi_dump(argv)
  when "check" then abi_check(argv)
  when _ then
    print_abi_help()
    1
  end
end

def print_abi_help() -> Unit
  println("Usage: tg abi <subcommand> [args]")
  println("ABI tools")
  println("")
  println("Subcommands:")
  println("  test [file]     Validate ABI conformance")
  println("  dump <file>     Dump type layouts (size/align)")
  println("  check <a> <b>   Check ABI compatibility between files")
end

# Validate ABI conformance  checks type sizes, alignments, calling conventions
def abi_test(argv: Vec[String]) -> Int
  println("Tangerine ABI Test Suite")
  println("========================")
  println("")

  mut passed = 0
  mut failed = 0

  # Primitive type size/align tests (per interop.txt 5.2)
  let tests = [
    ("i8/u8", 1, 1),
    ("i16/u16", 2, 2),
    ("i32/u32", 4, 4),
    ("i64/u64", 8, 8),
    ("isize/usize", 8, 8),
    ("bool", 1, 1),
    ("f32", 4, 4),
    ("f64", 8, 8),
    ("*T", 8, 8)
  ]

  println("Primitive type layout tests:")
  let empty_layout: Map[Int, Int] = Map::new()
  
  # Test Int (i64)
  let int_size = type_size(&Type::Int, &empty_layout)
  let int_align = type_align(&Type::Int)
  if int_size == 8 && int_align == 8 then
    println("   Int: size=8, align=8")
    passed = passed + 1
  else
    println("   Int: expected size=8 align=8, got size=" + int_size.to_string() + " align=" + int_align.to_string())
    failed = failed + 1
  end

  # Test Bool
  let bool_size = type_size(&Type::Bool, &empty_layout)
  let bool_align = type_align(&Type::Bool)
  if bool_size == 1 && bool_align == 1 then
    println("   Bool: size=1, align=1")
    passed = passed + 1
  else
    println("   Bool: expected size=1 align=1, got size=" + bool_size.to_string())
    failed = failed + 1
  end

  # Test Float (f64)
  let float_size = type_size(&Type::Float, &empty_layout)
  let float_align = type_align(&Type::Float)
  if float_size == 8 && float_align == 8 then
    println("   Float: size=8, align=8")
    passed = passed + 1
  else
    println("   Float: expected size=8 align=8, got size=" + float_size.to_string())
    failed = failed + 1
  end

  # Test Ref (pointer)
  let ref_size = type_size(&Type::Ref(Box::new(Type::Int), lifetime_static()), &empty_layout)
  if ref_size == 8 then
    println("   &T: size=8")
    passed = passed + 1
  else
    println("   &T: expected size=8, got " + ref_size.to_string())
    failed = failed + 1
  end

  # Test String (raw char*)
  let str_size = type_size(&Type::String, &empty_layout)
  if str_size == 8 then
    println("   String: size=8")
    passed = passed + 1
  else
    println("   String: expected size=8, got " + str_size.to_string())
    failed = failed + 1
  end

  # Test Slice / Vec lowering (heap-header pointer)
  let slice_size = type_size(&Type::Slice(Box::new(Type::Int)), &empty_layout)
  if slice_size == 8 then
    println("   Slice[T]: size=8")
    passed = passed + 1
  else
    println("   Slice[T]: expected size=8, got " + slice_size.to_string())
    failed = failed + 1
  end

  println("")
  println("ABI version info:")
  println("  Edition: 2026")
  println("  ABI revision: 1")
  println("  Target: " + detect_host_target().to_string())
  println("")

  println("Results: " + passed.to_string() + " passed, " + failed.to_string() + " failed")

  if failed > 0 then 1 else 0 end
end

# Dump type layouts for a source file
def abi_dump(argv: Vec[String]) -> Int
  if argv.len() < 3 then
    return 1
  end

  let file = argv[2].clone()
  let source = match read_file(file.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then
    return 1
  end

  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    return 1
  end

  println("Type layouts for " + file + ":")
  println("==============================")
  println("")

  let empty_layout: Map[Int, Int] = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::Struct(s) then
      println("struct " + s.name.clone() + " {")
      mut offset = 0
      for field in s.fields do
        let sz = type_size(&field.ty, &empty_layout)
        let al = type_align(&field.ty)
        # Compute padding
        let padding = if offset % al != 0 then al - (offset % al) else 0 end
        offset = offset + padding
        println("  " + field.name.clone() + ": " + type_name(&field.ty) +
                " @ offset " + offset.to_string() + " (size=" + sz.to_string() +
                ", align=" + al.to_string() + ")")
        offset = offset + sz
      end
      let struct_align = max_field_align(&s.fields)
      let final_padding = if offset % struct_align != 0 then struct_align - (offset % struct_align) else 0 end
      offset = offset + final_padding
      println("} // total size=" + offset.to_string() + ", align=" + struct_align.to_string())
      println("")
    when ItemKind::Enum(e) then
      println("enum " + e.name.clone() + " {")
      for variant in e.variants do
        println("  " + variant.name.clone())
      end
      println("} // tag size=4")
      println("")
    when _ then ()
    end
  end

  0
end

def max_field_align(fields: &Vec[Field]) -> Int
  mut max_al = 1
  for f in fields do
    let al = type_align(&f.ty)
    if al > max_al then max_al = al end
  end
  max_al
end

def type_name(ty: &TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      mut rendered = name.clone() + "["
      mut first = true
      for arg in args do
        if !first then rendered = rendered + ", " end
        rendered = rendered + type_name(&arg)
        first = false
      end
      rendered + "]"
    end
  when TypeExprKind::Ref(inner) then "&" + type_name(&inner)
  when TypeExprKind::RefMut(inner) then "&mut " + type_name(&inner)
  when TypeExprKind::Array(inner, n) then "[" + type_name(&inner) + "; " + n.to_string() + "]"
  when TypeExprKind::Slice(inner) then "[" + type_name(&inner) + "]"
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Infer then "_"
  when _ then "?"
  end
end

# Check ABI compatibility between two files
def abi_check(argv: Vec[String]) -> Int
  if argv.len() < 4 then
    return 1
  end

  let file_a = argv[2].clone()
  let file_b = argv[3].clone()

  # Parse both files
  let ast_a = match parse_file(file_a.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  let ast_b = match parse_file(file_b.clone())
  when Result::Ok(a) then a
  when Result::Err(e) then
    return 1
  end

  # Extract exported symbols from both
  let exports_a = extract_exports(&ast_a)
  let exports_b = extract_exports(&ast_b)

  mut compatible = true
  mut checked = 0

  println("ABI Compatibility Check: " + file_a + " vs " + file_b)
  println("========================================================")
  println("")

  # Check for removed exports
  for entry in exports_a do
    let name = entry.key
    let sig_a = entry.value
    checked = checked + 1
    match exports_b.get(&name)
    when Option::Some(sig_b) then
      if sig_a != sig_b then
        println(" " + name + ": signature changed")
        println("    was: " + sig_a)
        println("    now: " + sig_b)
        compatible = false
      else
        println(" " + name)
      end
    when Option::None then
      println(" " + name + ": removed (breaking change)")
      compatible = false
    end
  end

  # Check for new exports (non-breaking but reported)
  for entry in exports_b do
    let name = entry.key
    if !exports_a.contains_key(&name) then
      println("+ " + name + ": new export")
    end
  end

  println("")
  println("Checked " + checked.to_string() + " exports.")
  
  if compatible then
    println("Result: ABI compatible ")
    0
  else
    println("Result: ABI INCOMPATIBLE ")
    1
  end
end

def parse_file(path: String) -> Result[Program, String]
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err("Cannot read " + path + ": " + e)
  end
  let tokens = tokenize(source)
  let (ast, parse_diags) = parse(tokens)
  if diag_has_errors(&parse_diags) then
    Result::Err("Parse error in " + path)
  else
    Result::Ok(ast)
  end
end

def extract_exports(ast: &Program) -> Map[String, String]
  mut exports = Map::new()
  for item in ast.items do
    match item.kind
    when ItemKind::Function(f) then
      if is_ffi_exported(&f, &item.attrs) then
        let sig = function_signature(&f)
        exports.insert(f.name.clone(), sig)
      end
    when _ then ()
    end
  end
  exports
end

def function_signature(f: &FunctionDecl) -> String
  mut sig = "("
  mut first = true
  for p in f.params do
    if !first then sig = sig + ", " end
    match p.ty
    when Option::Some(t) then sig = sig + type_name(t)
    when Option::None then sig = sig + "?"
    end
    first = false
  end
  sig = sig + ") -> "
  match f.ret_type
  when Option::Some(rt) then sig = sig + type_name(rt)
  when Option::None then sig = sig + "Unit"
  end
  sig
end

# 
# Build Cache Persistence
# 

def load_build_cache(output_dir: &String) -> IncrementalCache
  let cache_path = output_dir.clone() + "/.tg_cache"
  
  match read_file(cache_path)
  when Result::Ok(content) then
    mut cache = cache_new(output_dir.clone())
    
    # Parse cache file: each line is "path|source_hash|mir_hash|timestamp"
    for line in content.lines() do
      let trimmed = line.trim()
      if trimmed.is_empty() || trimmed.starts_with("#") then next end
      
      let parts = trimmed.split("|")
      if parts.len() >= 4 then
        let path = parts[0].to_string()
        let source_hash = parts[1].to_string()
        let mir_hash = parts[2].to_string()
        let timestamp = match parts[3].parse_int()
        when Result::Ok(t) then t
        when Result::Err(_) then 0
        end
        
        cache.entries.insert(path, CacheEntry {
          source_hash: source_hash,
          mir_hash: mir_hash,
          timestamp: timestamp
        })
      end
    end
    
    cache
  when Result::Err(_) then
    cache_new(output_dir.clone())
  end
end

def save_build_cache(cache: &IncrementalCache) -> Unit
  let cache_path = cache.cache_dir.clone() + "/.tg_cache"
  mkdir_p(&cache.cache_dir)
  
  mut content = "# Tangerine build cache v1\n".to_string()
  
  for entry in cache.entries do
    content = content + entry.0.clone() + "|"
    content = content + entry.1.source_hash.clone() + "|"
    content = content + entry.1.mir_hash.clone() + "|"
    content = content + entry.1.timestamp.to_string() + "\n"
  end
  
  match write_file(cache_path, content)
  when Result::Ok(_) then ()
  when Result::Err(e) then
  end
end

# 
# LSP Support
# 

struct LspServer
  documents: Map[String, String]
  diagnostics: Map[String, Vec[Diagnostic]]
  asts: Map[String, Program]
  symbol_tables: Map[String, Vec[LspSymbol]]
end

struct LspSymbol
  name: String
  kind: LspSymbolKind
  span: Span
  type_str: String
  doc_comment: Option[String]
  definition_uri: Option[String]
  definition_span: Option[Span]
end

enum LspSymbolKind
  Function
  Method
  Variable
  Parameter
  Field
  Struct
  Enum
  Trait
  Module
  Constant
  Type
end

struct LspPosition
  line: UInt
  character: UInt
end

struct LspRange
  start: LspPosition
  end_pos: LspPosition
end

struct LspLocation
  uri: String
  range: LspRange
end

struct LspCompletionItem
  label: String
  kind: LspSymbolKind
  detail: Option[String]
  documentation: Option[String]
  insert_text: String
end

struct LspHoverResult
  contents: String
  range: Option[LspRange]
end

struct LspSignatureHelp
  signatures: Vec[LspSignature]
  active_signature: UInt
  active_parameter: UInt
end

struct LspSignature
  label: String
  documentation: Option[String]
  parameters: Vec[LspParameterInfo]
end

struct LspParameterInfo
  label: String
  documentation: Option[String]
end

struct LspCodeAction
  title: String
  kind: String
  diagnostics: Vec[Diagnostic]
  edit: Option[LspTextEdit]
end

struct LspTextEdit
  uri: String
  range: LspRange
  new_text: String
end

def lsp_server_new() -> LspServer
  LspServer {
    documents: Map::new(),
    diagnostics: Map::new(),
    asts: Map::new(),
    symbol_tables: Map::new()
  }
end

def lsp_did_open(server: &mut LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_did_change(server: &mut LspServer, uri: String, content: String) -> Unit
  server.documents.insert(uri.clone(), content)
  lsp_check_document(server, uri)
end

def lsp_check_document(server: &mut LspServer, uri: String) -> Unit
  match server.documents.get(uri.clone())
  when Option::Some(content) then
    let tokens = tokenize(content)
    let (ast, parse_diags) = parse(tokens)
    
    mut diags = Vec::new()
    
    # Convert parse diagnostics
    for pd in parse_diags do
      diags.push(Diagnostic {
        level: DiagLevel::Error,
        message: pd.message,
        span: Option::Some(pd.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
    
    if !diag_has_errors(&parse_diags) then
      # Build symbol table for the document
      let symbols = build_symbol_table(&ast, uri.clone())
      server.symbol_tables.insert(uri.clone(), symbols)
      server.asts.insert(uri.clone(), ast.clone())
      
      let type_errors = type_check(&ast)
      for err in type_errors do
        diags.push(Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::None
        })
      end
      
      let borrow_errors = borrow_check(&ast)
      for err in borrow_errors do
        diags.push(Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: err.notes,
          suggestions: Vec::new(),
          code: Option::None
        })
      end
    end
    
    server.diagnostics.insert(uri, diags)
  when Option::None then ()
  end
end

# 
# LSP: Hover
# 

def lsp_hover(server: &LspServer, uri: String, position: LspPosition) -> Option[LspHoverResult]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find symbol at offset
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      mut hover_text = "```tangerine\n"
      
      match symbol.kind
      when LspSymbolKind::Function | LspSymbolKind::Method then
        hover_text = hover_text + "def " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Variable | LspSymbolKind::Parameter then
        hover_text = hover_text + "let " + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Struct then
        hover_text = hover_text + "struct " + symbol.name
      when LspSymbolKind::Enum then
        hover_text = hover_text + "enum " + symbol.name
      when LspSymbolKind::Trait then
        hover_text = hover_text + "trait " + symbol.name
      when LspSymbolKind::Field then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      when LspSymbolKind::Constant then
        hover_text = hover_text + "const " + symbol.name + ": " + symbol.type_str
      when _ then
        hover_text = hover_text + symbol.name + ": " + symbol.type_str
      end
      
      hover_text = hover_text + "\n```"
      
      # Add doc comment if present
      match symbol.doc_comment
      when Option::Some(doc) then
        hover_text = hover_text + "\n\n---\n\n" + doc
      when Option::None then ()
      end
      
      let range = span_to_lsp_range(content, symbol.span)
      Option::Some(LspHoverResult {
        contents: hover_text,
        range: Option::Some(range)
      })
    end
  end
end

# 
# LSP: Completion
# 

def lsp_completion(server: &LspServer, uri: String, position: LspPosition) -> Vec[LspCompletionItem]
  mut items = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return items
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Get the prefix being typed
    let prefix = get_completion_prefix(content, offset)
    
    # Collect all visible symbols
    match server.symbol_tables.get(uri.clone())
    when Option::Some(symbols) then
      for sym in symbols do
        if sym.name.starts_with(prefix.clone()) then
          items.push(LspCompletionItem {
            label: sym.name.clone(),
            kind: sym.kind,
            detail: Option::Some(sym.type_str.clone()),
            documentation: sym.doc_comment.clone(),
            insert_text: sym.name.clone()
          })
        end
      end
    when Option::None then ()
    end
    
    # Add keyword completions
    let keywords = ["def", "struct", "enum", "trait", "impl", "use", "pub",
                    "let", "mut", "if", "unless", "elsif", "else", "match", "when",
                    "for", "while", "until", "loop", "break", "next", "return",
                    "true", "false", "self", "Self", "in", "do", "end",
                    "then", "module", "type", "where", "as", "unsafe",
                    "extern", "async", "await", "yield"]
    
    for kw in keywords do
      if kw.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: kw.to_string(),
          kind: LspSymbolKind::Module,  # Keyword kind
          detail: Option::Some("keyword".to_string()),
          documentation: Option::None,
          insert_text: kw.to_string()
        })
      end
    end
    
    # Add type completions from builtins
    let builtin_types = ["Int", "UInt", "Float", "Bool", "String", "Char",
                         "Unit", "Never", "Option", "Result", "Vec", "Map",
                         "Set", "Ptr", "Array"]
    
    for ty in builtin_types do
      if ty.starts_with(prefix.clone()) then
        items.push(LspCompletionItem {
          label: ty.to_string(),
          kind: LspSymbolKind::Type,
          detail: Option::Some("type".to_string()),
          documentation: Option::None,
          insert_text: ty.to_string()
        })
      end
    end
  end
  
  items
end

# 
# LSP: Go to Definition
# 

def lsp_goto_definition(server: &LspServer, uri: String, position: LspPosition) -> Option[LspLocation]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then Option::None
    when Option::Some(symbol) then
      # Check if this symbol has a known definition location
      match symbol.definition_uri
      when Option::Some(def_uri) then
        match symbol.definition_span
        when Option::Some(def_span) then
          # Resolve the definition content for range conversion
          match server.documents.get(def_uri.clone())
          when Option::Some(def_content) then
            let range = span_to_lsp_range(def_content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          when Option::None then
            # Same document
            let range = span_to_lsp_range(content, def_span)
            Option::Some(LspLocation { uri: def_uri, range: range })
          end
        when Option::None then Option::None
        end
      when Option::None then
        # Definition is in same file  search by name
        match find_definition_in_document(server, uri.clone(), symbol.name.clone())
        when Option::Some(def_symbol) then
          let range = span_to_lsp_range(content, def_symbol.span)
          Option::Some(LspLocation { uri: uri, range: range })
        when Option::None then Option::None
        end
      end
    end
  end
end

# 
# LSP: References
# 

def lsp_references(server: &LspServer, uri: String, position: LspPosition, include_declaration: Bool) -> Vec[LspLocation]
  mut locations = Vec::new()
  
  match server.documents.get(uri.clone())
  when Option::None then return locations
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    match find_symbol_at(server, uri.clone(), offset)
    when Option::None then return locations
    when Option::Some(target_symbol) then
      # Search all open documents for references to this symbol
      for entry in server.symbol_tables do
        let doc_uri = entry.key
        let symbols = entry.value
        
        match server.documents.get(doc_uri.clone())
        when Option::Some(doc_content) then
          for sym in symbols do
            if sym.name == target_symbol.name then
              let is_declaration = match sym.kind
                  when LspSymbolKind::Function then true
                  when LspSymbolKind::Struct then true
                  when LspSymbolKind::Enum then true
                  when LspSymbolKind::Trait then true
                  when LspSymbolKind::Method then true
                  when LspSymbolKind::Variable then true
                  when LspSymbolKind::Constant then true
                  when LspSymbolKind::Field then true
                  when LspSymbolKind::Type then true
                  when LspSymbolKind::Module then true
              when _ then false
              end
              
              if include_declaration || !is_declaration then
                let range = span_to_lsp_range(doc_content, sym.span)
                locations.push(LspLocation { uri: doc_uri.clone(), range: range })
              end
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  locations
end

# 
# LSP: Rename
# 

def lsp_rename(server: &LspServer, uri: String, position: LspPosition, new_name: String) -> Vec[LspTextEdit]
  mut edits = Vec::new()
  
  # Find all references and create edits
  let refs = lsp_references(server, uri, position, true)
  
  for loc in refs do
    edits.push(LspTextEdit {
      uri: loc.uri,
      range: loc.range,
      new_text: new_name.clone()
    })
  end
  
  edits
end

# 
# LSP: Signature Help
# 

def lsp_signature_help(server: &LspServer, uri: String, position: LspPosition) -> Option[LspSignatureHelp]
  match server.documents.get(uri.clone())
  when Option::None then return Option::None
  when Option::Some(content) then
    let offset = position_to_offset(content, position)
    
    # Find the enclosing function call
    let (func_name, active_param) = find_enclosing_call(content, offset)
    
    match func_name
    when Option::None then return Option::None
    when Option::Some(name) then
      # Look up the function signature
      match find_definition_in_document(server, uri.clone(), name.clone())
      when Option::None then Option::None
      when Option::Some(sym) then
        # Parse the type string to extract parameters
        let params = parse_function_params(sym.type_str.clone())
        
        mut param_infos = Vec::new()
        for p in params do
          param_infos.push(LspParameterInfo {
            label: p.clone(),
            documentation: Option::None
          })
        end
        
        let signature = LspSignature {
          label: sym.name.clone() + ": " + sym.type_str.clone(),
          documentation: sym.doc_comment.clone(),
          parameters: param_infos
        }
        
        Option::Some(LspSignatureHelp {
          signatures: vec![signature],
          active_signature: 0,
          active_parameter: active_param
        })
      end
    end
  end
end

# 
# LSP: Code Actions
# 

def lsp_code_actions(server: &LspServer, uri: String, range: LspRange) -> Vec[LspCodeAction]
  mut actions = Vec::new()
  
  # Check if there are diagnostics in this range with suggestions
  match server.diagnostics.get(uri.clone())
  when Option::None then return actions
  when Option::Some(diags) then
    match server.documents.get(uri.clone())
    when Option::None then return actions
    when Option::Some(content) then
      let range_start = lsp_position_to_offset(content, range.start)
      let range_end = lsp_position_to_offset(content, range.end_pos)
      
      for diag in diags do
        match diag.span
        when Option::Some(span) then
          if span.start >= range_start && span.end_pos <= range_end then
            # Generate fix-it actions from suggestions
            for sugg in diag.suggestions do
              let edit_range = span_to_lsp_range(content, sugg.span)
              mut action_diags = Vec::new()
              action_diags.push(diag.clone())
              actions.push(LspCodeAction {
                title: sugg.message.clone(),
                kind: "quickfix".to_string(),
                diagnostics: action_diags,
                edit: Option::Some(LspTextEdit {
                  uri: uri.clone(),
                  range: edit_range,
                  new_text: sugg.replacement.clone()
                })
              })
            end
          end
        when Option::None then ()
        end
      end
    end
  end
  
  actions
end

# 
# LSP: Format Document
# 

def lsp_format(server: &LspServer, uri: String) -> Option[String]
  match server.documents.get(uri)
  when Option::None then Option::None
  when Option::Some(content) then
    let config = default_format_config()
    match format_source(content.clone(), &config)
    when Result::Ok(formatted) then Option::Some(formatted)
    when Result::Err(_e) then Option::Some(content.clone())
    end
  end
end

# 
# LSP: Main Loop (JSON-RPC over stdio)
# 

def lsp_main_loop(server: &mut LspServer) -> Unit
  # LSP protocol: read Content-Length header, then JSON-RPC body
  loop
    # Read header
    let header = read_lsp_header()
    match header
    when Option::None then break  # EOF
    when Option::Some(content_length) then
      # Read body
      let body = read_lsp_body(content_length)
      
      # Parse JSON-RPC request
      let response = handle_lsp_request(server, body)
      
      # Send response
      match response
      when Option::Some(resp) then
        send_lsp_response(resp)
      when Option::None then ()
      end
    end
  end
end

def read_lsp_header() -> Option[UInt]
  # Read "Content-Length: N\r\n\r\n"
  mut header = ""
  loop
    let line = read_line()
    if line.is_empty() then break end
    header = header + line + "\n"
    if line == "\r" || line == "" then break end
  end
  
  # Parse Content-Length
  for line in header.lines() do
    if line.starts_with("Content-Length:") then
      let val = line.slice(15, line.len()).trim()
      return Option::Some(val.parse_uint().unwrap_or(0))
    end
  end
  
  Option::None
end

def read_lsp_body(length: UInt) -> String
  mut bytes = Vec::with_capacity(length)
  mut i = 0
  while i < length do
    bytes.push(0u8)
    i = i + 1
  end
  let n = std::fs::read(0, bytes.as_mut_ptr(), length as Int)
  if n as UInt < length then
    # Handle partial read or error
    ()
  end
  String::from_bytes(bytes)
end

def read_line_impl() -> String
  match std::io::read_line()
  when Result::Ok(s) then s
  when Result::Err(_) then ""
  end
end

def read_bytes_impl(n: UInt) -> String
  mut bytes = Vec::with_capacity(n)
  mut i = 0
  while i < n do
    bytes.push(0)
    i = i + 1
  end
  let read_count = std::fs::read(0, bytes.as_ptr(), n as Int)
  if read_count <= 0 then
    return ""
  end
  String::from_bytes(bytes.slice(0, read_count as Int))
end

def send_lsp_response(body: String) -> Unit
  let header = "Content-Length: " + body.len().to_string() + "\r\n\r\n"
  print(header + body)
end

def handle_lsp_request(server: &mut LspServer, body: String) -> Option[String]
  # Minimal JSON-RPC parsing
  let method = extract_json_string(body.clone(), "method")
  let id = extract_json_value(body.clone(), "id")
  
  match method
  when Option::None then Option::None
  when Option::Some(m) then
    if m == "initialize" then
      # Send capabilities
      let result = "{\"capabilities\":{" +
        "\"textDocumentSync\":1," +
        "\"hoverProvider\":true," +
        "\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]}," +
        "\"definitionProvider\":true," +
        "\"referencesProvider\":true," +
        "\"renameProvider\":true," +
        "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}," +
        "\"documentFormattingProvider\":true," +
        "\"codeActionProvider\":true" +
        "},\"serverInfo\":{\"name\":\"tangerine-ls\",\"version\":\"" + VERSION + "\"}}"
      make_json_rpc_response(id, result)
    elsif m == "initialized" then
      Option::None  # Notification, no response
    elsif m == "textDocument/didOpen" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let text = extract_nested_json_string(body.clone(), "textDocument", "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_open(server, u, t)
      when _ then ()
      end
      Option::None  # Notification
    elsif m == "textDocument/didChange" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      # Get full content from contentChanges[0].text
      let text = extract_json_string(body.clone(), "text")
      match (uri, text)
      when (Option::Some(u), Option::Some(t)) then
        lsp_did_change(server, u, t)
      when _ then ()
      end
      Option::None
    elsif m == "textDocument/hover" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_hover(server, u, pos)
        when Option::Some(hover) then
          let result = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" +
            json_escape(hover.contents) + "\"}}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/completion" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let items = lsp_completion(server, u, pos)
        mut result = "{\"isIncomplete\":false,\"items\":["
        mut first = true
        for item in items do
          if !first then result = result + "," end
          result = result + "{\"label\":\"" + json_escape(item.label) + "\""
          match item.detail
          when Option::Some(d) then
            result = result + ",\"detail\":\"" + json_escape(d) + "\""
          when Option::None then ()
          end
          result = result + ",\"insertText\":\"" + json_escape(item.insert_text) + "\"}"
          first = false
        end
        result = result + "]}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "{\"isIncomplete\":false,\"items\":[]}".to_string())
      end
    elsif m == "textDocument/definition" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_goto_definition(server, u, pos)
        when Option::Some(loc) then
          let result = "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/references" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        let refs = lsp_references(server, u, pos, true)
        mut result = "["
        mut first = true
        for loc in refs do
          if !first then result = result + "," end
          result = result + "{\"uri\":\"" + json_escape(loc.uri) + "\"," +
            "\"range\":" + lsp_range_to_json(&loc.range) + "}"
          first = false
        end
        result = result + "]"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "textDocument/rename" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      let new_name = extract_json_string(body.clone(), "newName")
      match (uri, line, character, new_name)
      when (Option::Some(u), Option::Some(l), Option::Some(c), Option::Some(name)) then
        let pos = LspPosition { line: l, character: c }
        let edits = lsp_rename(server, u, pos, name)
        # Group edits by URI
        mut changes = Map::new()
        for edit in edits do
          match changes.get(edit.uri.clone())
          when Option::Some(existing) then
            existing.push(edit)
          when Option::None then
            mut first_edits = Vec::new()
            first_edits.push(edit)
            changes.insert(edit.uri.clone(), first_edits)
          end
        end
        
        mut result = "{\"changes\":{"
        mut first_uri = true
        for entry in changes do
          if !first_uri then result = result + "," end
          result = result + "\"" + json_escape(entry.key) + "\":["
          mut first_edit = true
          for edit in entry.value do
            if !first_edit then result = result + "," end
            result = result + "{\"range\":" + lsp_range_to_json(&edit.range) + ","
            result = result + "\"newText\":\"" + json_escape(edit.new_text) + "\"}"
            first_edit = false
          end
          result = result + "]"
          first_uri = false
        end
        result = result + "}}"
        make_json_rpc_response(id, result)
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/signatureHelp" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      let line = extract_nested_json_uint(body.clone(), "position", "line")
      let character = extract_nested_json_uint(body.clone(), "position", "character")
      match (uri, line, character)
      when (Option::Some(u), Option::Some(l), Option::Some(c)) then
        let pos = LspPosition { line: l, character: c }
        match lsp_signature_help(server, u, pos)
        when Option::Some(help) then
          mut result = "{\"signatures\":["
          mut first = true
          for sig in help.signatures do
            if !first then result = result + "," end
            result = result + "{\"label\":\"" + json_escape(sig.label) + "\""
            result = result + ",\"parameters\":["
            mut first_p = true
            for p in sig.parameters do
              if !first_p then result = result + "," end
              result = result + "{\"label\":\"" + json_escape(p.label) + "\"}"
              first_p = false
            end
            result = result + "]}"
            first = false
          end
          result = result + "],\"activeSignature\":" + help.active_signature.to_string()
          result = result + ",\"activeParameter\":" + help.active_parameter.to_string() + "}"
          make_json_rpc_response(id, result)
        when Option::None then
          make_json_rpc_response(id, "null".to_string())
        end
      when _ then make_json_rpc_response(id, "null".to_string())
      end
    elsif m == "textDocument/formatting" then
      let uri = extract_nested_json_string(body.clone(), "textDocument", "uri")
      match uri
      when Option::Some(u) then
        match lsp_format(server, u.clone())
        when Option::Some(formatted) then
          match server.documents.get(u)
          when Option::Some(content) then
            let total_lines = count_lines(content)
            let end_col = last_line_length(content)
            let range = LspRange {
              start: LspPosition { line: 0, character: 0 },
              end_pos: LspPosition { line: total_lines, character: end_col }
            }
            let result = "[{\"range\":" + lsp_range_to_json(&range) + "," +
              "\"newText\":\"" + json_escape(formatted) + "\"}]"
            make_json_rpc_response(id, result)
          when Option::None then
            make_json_rpc_response(id, "[]".to_string())
          end
        when Option::None then
          make_json_rpc_response(id, "[]".to_string())
        end
      when Option::None then
        make_json_rpc_response(id, "[]".to_string())
      end
    elsif m == "shutdown" then
      make_json_rpc_response(id, "null".to_string())
    elsif m == "exit" then
      Option::None  # Exit the loop
    else
      # Unknown method
      Option::None
    end
  end
end

# 
# LSP Helpers
# 

def build_symbol_table(ast: &Program, uri: String) -> Vec[LspSymbol]
  mut symbols = Vec::new()
  
  for item in ast.items do
    match item.kind
    when ItemKind::Function(func) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: func.name.clone(),
        kind: LspSymbolKind::Function,
        span: item.span,
        type_str: format_function_type(&func),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      # Add parameters
      for param in func.params do
        let param_type_str = match param.ty
          when Option::Some(t) then format_type_expr_to_string(t)
          when Option::None then "?"
        end
        symbols.push(LspSymbol {
          name: param.name.clone(),
          kind: LspSymbolKind::Parameter,
          span: param.span,
          type_str: param_type_str,
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(param.span)
        })
      end
    when ItemKind::Struct(s) then
      let doc = extract_doc_comment_before(ast, item.span)
      symbols.push(LspSymbol {
        name: s.name.clone(),
        kind: LspSymbolKind::Struct,
        span: item.span,
        type_str: s.name.clone(),
        doc_comment: doc,
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for field in s.fields do
        symbols.push(LspSymbol {
          name: field.name.clone(),
          kind: LspSymbolKind::Field,
          span: field.span,
          type_str: format_type_expr_to_string(&field.ty),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(field.span)
        })
      end
    when ItemKind::Enum(e) then
      symbols.push(LspSymbol {
        name: e.name.clone(),
        kind: LspSymbolKind::Enum,
        span: item.span,
        type_str: e.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when ItemKind::Trait(t) then
      symbols.push(LspSymbol {
        name: t.name.clone(),
        kind: LspSymbolKind::Trait,
        span: item.span,
        type_str: t.name.clone(),
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
      
      for method in t.methods do
        symbols.push(LspSymbol {
          name: method.sig.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_sig_type(&method.sig),
          doc_comment: Option::None,
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::Impl(imp) then
      for method in imp.methods do
        symbols.push(LspSymbol {
          name: method.name.clone(),
          kind: LspSymbolKind::Method,
          span: method.span,
          type_str: format_function_type(&method),
          doc_comment: extract_doc_comment_before(ast, method.span),
          definition_uri: Option::Some(uri.clone()),
          definition_span: Option::Some(method.span)
        })
      end
    when ItemKind::Const(c) then
      symbols.push(LspSymbol {
        name: c.name.clone(),
        kind: LspSymbolKind::Constant,
        span: item.span,
        type_str: match c.ty
          when Option::Some(t) then format_type_expr_to_string(&t)
          when Option::None then "?"
        end,
        doc_comment: extract_doc_comment_before(ast, item.span),
        definition_uri: Option::Some(uri.clone()),
        definition_span: Option::Some(item.span)
      })
    when _ then ()
    end
  end
  
  symbols
end

def find_symbol_at(server: &LspServer, uri: String, offset: UInt) -> Option[&LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    # Find the most specific (smallest span) symbol containing the offset
    mut best: Option[&LspSymbol] = Option::None
    mut best_span_size: UInt = 18446744073709551615u64
    
    for sym in symbols do
      if offset >= sym.span.start && offset <= sym.span.end_pos then
        let span_size = sym.span.end_pos - sym.span.start
        if span_size < best_span_size then
          best = Option::Some(sym)
          best_span_size = span_size
        end
      end
    end
    
    best
  end
end

def find_definition_in_document(server: &LspServer, uri: String, name: String) -> Option[&LspSymbol]
  match server.symbol_tables.get(uri)
  when Option::None then Option::None
  when Option::Some(symbols) then
    for sym in symbols do
      if sym.name == name then
        match sym.kind
        when LspSymbolKind::Function then
          return Option::Some(sym)
        when LspSymbolKind::Struct then
          return Option::Some(sym)
        when LspSymbolKind::Enum then
          return Option::Some(sym)
        when LspSymbolKind::Trait then
          return Option::Some(sym)
        when LspSymbolKind::Constant then
          return Option::Some(sym)
        when _ then ()
        end
      end
    end
    Option::None
  end
end

def position_to_offset(content: &String, pos: LspPosition) -> UInt
  lsp_position_to_offset(content, pos)
end

def lsp_position_to_offset(content: &String, pos: LspPosition) -> UInt
  mut offset: UInt = 0
  mut line: UInt = 0
  
  while offset < content.len() && line < pos.line do
    if content.char_at(offset) == '\n' then
      line = line + 1
    end
    offset = offset + 1
  end
  
  offset + pos.character
end

def span_to_lsp_range(content: &String, span: Span) -> LspRange
  let start = offset_to_lsp_position(content, span.start)
  let end_pos = offset_to_lsp_position(content, span.end_pos)
  LspRange { start: start, end_pos: end_pos }
end

def offset_to_lsp_position(content: &String, offset: UInt) -> LspPosition
  mut line: UInt = 0
  mut col: UInt = 0
  mut i: UInt = 0
  
  while i < offset && i < content.len() do
    if content.char_at(i) == '\n' then
      line = line + 1
      col = 0
    else
      col = col + 1
    end
    i = i + 1
  end
  
  LspPosition { line: line, character: col }
end

def get_completion_prefix(content: &String, offset: UInt) -> String
  # Walk backwards from offset to find identifier start
  mut start = offset
  while start > 0 do
    let c = content.char_at(start - 1)
    if c.is_alphanumeric() || c == '_' then
      start = start - 1
    else
      break
    end
  end
  
  if start < offset then
    content.slice(start, offset)
  else
    "".to_string()
  end
end

def find_enclosing_call(content: &String, offset: UInt) -> (Option[String], UInt)
  # Walk backwards from offset to find the function name before '('
  mut depth = 0
  mut param_count: UInt = 0
  mut i = offset
  mut in_string = false
  mut in_char = false
  
  while i > 0 do
    i = i - 1
    let c = content.char_at(i)
    
    # Track string/char literal boundaries (backward scan)
    # Skip escaped quotes by checking if preceded by backslash
    if c == '"' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_string = !in_string
      next
    end
    if c == '\'' && !(i > 0 && content.char_at(i - 1) == '\\') then
      in_char = !in_char
      next
    end
    if in_string || in_char then next end
    
    if c == ')' then depth = depth + 1
    elsif c == '(' then
      if depth == 0 then
        # Found the opening paren  get function name before it
        mut end_pos = i
        while end_pos > 0 && (content.char_at(end_pos - 1).is_alphanumeric() || content.char_at(end_pos - 1) == '_') do
          end_pos = end_pos - 1
        end
        if end_pos < i then
          let name = content.slice(end_pos, i)
          return (Option::Some(name), param_count)
        end
        return (Option::None, 0)
      end
      depth = depth - 1
    elsif c == ',' && depth == 0 then
      param_count = param_count + 1
    end
  end
  
  (Option::None, 0)
end

def parse_function_params(type_str: String) -> Vec[String]
  # Parse "(T1, T2) -> R" format
  mut params = Vec::new()
  
  if !type_str.starts_with("(") then return params end
  
  let close = type_str.index_of(")")
  match close
  when Option::None then return params
  when Option::Some(idx) then
    let inner = type_str.slice(1, idx)
    if inner.is_empty() then return params end
    
    for part in inner.split(",") do
      params.push(part.trim().to_string())
    end
  end
  
  params
end

def format_function_type(func: &FunctionDecl) -> String
  mut result = "("
  mut first = true
  for param in func.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then format_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match func.ret_type
  when Option::Some(rt) then result = result + format_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def format_function_sig_type(sig: &FunctionSig) -> String
  mut result = "("
  mut first = true
  for param in sig.params do
    if !first then result = result + ", " end
    let ty_str = match param.ty
      when Option::Some(t) then format_type_expr_to_string(t)
      when Option::None then "?"
    end
    result = result + param.name + ": " + ty_str
    first = false
  end
  result = result + ") -> "
  match sig.ret_type
  when Option::Some(rt) then result = result + format_type_expr_to_string(rt)
  when Option::None then result = result + "Unit"
  end
  result
end

def extract_doc_comment_before(ast: &Program, span: Span) -> Option[String]
  # Scan source text backwards from span.start looking for contiguous ## doc comment lines.
  # Tangerine doc comments use `##` prefix (like Rust `///`).
  if span.start <= 0 then
    return Option::None
  end
  
  let source = &ast.source
  if source.is_empty() then
    return Option::None
  end
  
  # Find the beginning of the current line
  mut pos = span.start - 1
  while pos > 0 && source.char_at(pos) != '\n' do
    pos = pos - 1
  end
  
  # Now scan upward collecting doc comment lines
  mut doc_lines = Vec::new()
  mut scan_pos = pos
  
  loop
    # Skip to the start of the line above
    if scan_pos <= 0 then
      break
    end
    # Move past the newline
    scan_pos = scan_pos - 1
    while scan_pos > 0 && source.char_at(scan_pos) != '\n' do
      scan_pos = scan_pos - 1
    end
    let line_start = if scan_pos == 0 then 0 else scan_pos + 1 end
    
    # Find end of this line
    mut line_end = line_start
    while line_end < source.len() && source.char_at(line_end) != '\n' do
      line_end = line_end + 1
    end
    
    let line = source.substring(line_start, line_end).trim()
    
    # Check if this line is a doc comment (## prefix)
    if line.starts_with("##") then
      # Strip the ## prefix and leading space
      let content = line.substring(2, line.len()).trim()
      doc_lines.push(content)
    elsif line.is_empty() then
      # Empty line between doc comment and declaration is ok (skip)
      if doc_lines.is_empty() then
        break
      end
    else
      # Non-doc-comment, non-empty line  stop scanning
      break
    end
    
    if scan_pos <= 0 then
      break
    end
  end
  
  if doc_lines.is_empty() then
    return Option::None
  end
  
  # Reverse since we collected bottom-up
  doc_lines.reverse()
  Option::Some(doc_lines.join("\n"))
end

def make_json_rpc_response(id: Option[String], result: String) -> Option[String]
  match id
  when Option::None then Option::None
  when Option::Some(req_id) then
    Option::Some("{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":" + result + "}")
  end
end

def extract_json_string(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    # Skip whitespace
    mut pos = start
    while pos < json.len() && (json.char_at(pos) == ' ' || json.char_at(pos) == '\t') do
      pos = pos + 1
    end
    if pos < json.len() && json.char_at(pos) == '"' then
      pos = pos + 1
      mut end_pos = pos
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      Option::Some(json.slice(pos, end_pos))
    else
      Option::None
    end
  end
end

def extract_json_value(json: String, key: String) -> Option[String]
  let search = "\"" + key + "\":"
  match json.index_of(search)
  when Option::None then Option::None
  when Option::Some(idx) then
    let start = idx + search.len()
    mut pos = start
    while pos < json.len() && json.char_at(pos) == ' ' do pos = pos + 1 end
    
    mut end_pos = pos
    let first_char = json.char_at(pos)
    if first_char == '"' then
      # String value
      end_pos = pos + 1
      while end_pos < json.len() && json.char_at(end_pos) != '"' do
        if json.char_at(end_pos) == '\\' then end_pos = end_pos + 1 end
        end_pos = end_pos + 1
      end
      end_pos = end_pos + 1
    elsif first_char == '{' || first_char == '[' then
      # Object/array  find matching close
      mut depth = 1
      end_pos = pos + 1
      while end_pos < json.len() && depth > 0 do
        let c = json.char_at(end_pos)
        if c == '{' || c == '[' then depth = depth + 1
        elsif c == '}' || c == ']' then depth = depth - 1
        end
        end_pos = end_pos + 1
      end
    else
      # Number/bool/null
      while end_pos < json.len() && json.char_at(end_pos) != ',' && json.char_at(end_pos) != '}' && json.char_at(end_pos) != ']' do
        end_pos = end_pos + 1
      end
    end
    
    Option::Some(json.slice(pos, end_pos).trim().to_string())
  end
end

def extract_nested_json_string(json: String, outer_key: String, inner_key: String) -> Option[String]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    extract_json_string(inner_json, inner_key)
  end
end

def extract_nested_json_uint(json: String, outer_key: String, inner_key: String) -> Option[UInt]
  match extract_json_value(json, outer_key)
  when Option::None then Option::None
  when Option::Some(inner_json) then
    match extract_json_value(inner_json, inner_key)
    when Option::None then Option::None
    when Option::Some(val) then
      Option::Some(val.parse_uint().unwrap_or(0))
    end
  end
end

def lsp_range_to_json(range: &LspRange) -> String
  "{\"start\":{\"line\":" + range.start.line.to_string() + ",\"character\":" + range.start.character.to_string() + "}," +
  "\"end\":{\"line\":" + range.end_pos.line.to_string() + ",\"character\":" + range.end_pos.character.to_string() + "}}"
end

def count_lines(content: &String) -> UInt
  mut count: UInt = 0
  for c in content.chars() do
    if c == '\n' then count = count + 1 end
  end
  count
end

def last_line_length(content: &String) -> UInt
  mut len: UInt = 0
  mut i = content.len()
  while i > 0 do
    i = i - 1
    if content.char_at(i) == '\n' then break end
    len = len + 1
  end
  len
end
