# Tangerine Compiler — Abstract Syntax Tree
# Self-hosting compiler written in Tangerine
#
# Complete AST with all language features:
# - Functions, structs, enums, traits, impls
# - Ownership / ACCESS EXCLUSIVITY / MOVE-RESOURCE STATE / SCOPED PROJECTED
#   VIEWS (the memory model: there are NO general first-class safe
#   references — a borrow is a scoped, checker-managed access, not a
#   first-class value; the resource checker's linearity rules govern moves
#   and the access checker's exclusivity rules govern projection)
# - Agentic features (contracts, capabilities, effects, budgets)
# - Modern constructs (async/await, pattern matching, generics)
# - Compile-time evaluation

use std::core::{Option, Result}
use std::collections::{Vec, Map}
use tg_compiler::ids::{ModuleId, ItemId}
use tg_compiler::token::{Span, span_merge, ParsedIntegerLiteral, ParsedFloatLiteral}

# ———————————————————————————————————————————————————————————————
# AST Versioning
# ———————————————————————————————————————————————————————————————
# Semantic versioning for AST stability:
#   MAJOR: Breaking structural changes (new node kinds, removed variants)
#   MINOR: Backward-compatible additions (new fields with defaults)
#   PATCH: Bug fixes in AST-related code without structural changes
#
# Bump MAJOR when:
#   - Adding/removing variants to ItemKind, ExprKind, StmtKind, etc.
#   - Changing field types in any node struct
#   - Removing fields from nodes
#
# Bump MINOR when:
#   - Adding new optional fields (Option[T] with default None)
#   - Adding new attributes or annotations
#
# Tools can check ast_version_compatible() to verify AST compatibility.

pub const AST_VERSION_MAJOR: UInt = 2
pub const AST_VERSION_MINOR: UInt = 0
pub const AST_VERSION_PATCH: UInt = 0

pub def ast_version() -> String
  AST_VERSION_MAJOR.to_string() + "." + AST_VERSION_MINOR.to_string() + "." + AST_VERSION_PATCH.to_string()
end

pub def ast_version_compatible(major: UInt, minor: UInt) -> Bool
  # Same major version required; minor must be <= current
  major == AST_VERSION_MAJOR && minor <= AST_VERSION_MINOR
end

# ———————————————————————————————————————————————————————————————
# Program Root
# ———————————————————————————————————————————————————————————————

# (real module graph): Program.crate is the SINGLE module table — the
# Crate { root: ModuleId, modules: Map[ModuleId, Module] } authority the
# design specifies. Each Module's items is the per-module ItemId
# list (Vec[ItemId] — an ItemId is the owning item's index into the flat
# Program.items; the flat vector stays the intermediate storage, the
# SEMANTIC OWNERSHIP lives in the module tables). The root module, id 0,
# covers the main program's top-level items; every dependency file gets one
# Module (see merge_imported_deps / collect_dep_file in compiler_core.tg).
# EVERY item carries its owning ModuleId directly (Item.owner_module),
# assigned at the construction sites — the parser's make_item defaults to
# the root module, compiler_core's dependency assembly stamps each
# dependency item with its ModuleId — so owner lookups are table reads
# (program.items[i].owner_module -> crate.modules), never range scans.
# ModuleId itself lives in ids.tg — the central semantic identity domain —
# so DefId.module (also ids.tg) points into this graph by identity, never
# by path String.

struct Module
  id: ModuleId
  path: Vec[String]
  items: Vec[ItemId]
  imports: Vec[String]
end

struct Crate
  root: ModuleId
  modules: Map[ModuleId, Module]
end

struct Program
  items: Vec[Item]
  crate: Crate
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Attributes
# ———————————————————————————————————————————————————————————————

struct Attribute
  name: String
  args: Vec[String]
  span: Span
end

# The FIRST attribute with the given name, or None — the item-attribute
# read the target-conditioned @cfg elimination pass performs over an item's
# attribute list (an item carries one list; a @cfg attribute is found by
# name).
def attribute_named(attrs: Vec[Attribute], name: String) -> Option[Attribute]
  for attr in attrs do
    if attr.name == name then
      return Option::Some(Attribute { name: attr.name.clone(), args: attr.args.clone(), span: attr.span })
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Layout attributes — @repr(C) / @align(N) / @packed
# ———————————————————————————————————————————————————————————————
# The layout-relevant subset of a struct/enum declaration's item
# attributes, extracted at parse time (the parser validates the arg shape
# — N a power of two — and the exclusivity rules: @repr(C) with @packed,
# and @packed with @align(N), are invalid combinations) and validated
# semantically by the checker (the alignment-overflow bound), where the
# typed records carry the attributed declaration for the MIR/ABI
# consumers.
#
# Semantics (the layout engine's attributed rules):
#   @repr(C) — the C struct rules: declaration order, natural alignment,
#              standard offsets; the ABI classification follows the C
#              aggregate rules (the 8-byte integer class splitting).
#   @align(N) — the type's alignment becomes N (N a power of two); the
#              fields' offsets align to the max of the field's own
#              alignment and the declared N, and the total size is
#              tail-aligned to N (per the C alignment rules).
#   @packed  — the fields sit at the packed offsets (no padding, per-field
#              alignment 1); the type's alignment is 1 and the size is the
#              exact byte span (the kernel epoll_event shape
#              { u32 events @ 0, u64 data @ 4 } — size 12 — is the
#              canonical user).
struct LayoutAttrs
  is_repr_c: Bool
  is_packed: Bool
  align: Option[Int]   # the @align(N) N (a power of two)
  span: Span
end

# The un-attributed record (every struct/enum declaration carries one).
def layout_attrs_plain(span: Span) -> LayoutAttrs
  LayoutAttrs { is_repr_c: false, is_packed: false, align: Option::None, span: span }
end

# True when the record carries any layout attribute.
def layout_attrs_is_plain(attrs: LayoutAttrs) -> Bool
  !attrs.is_repr_c && !attrs.is_packed && attrs.align.is_none()
end

# ———————————————————————————————————————————————————————————————
# Items (Top-Level Declarations)
# ———————————————————————————————————————————————————————————————

struct Item
  kind: ItemKind
  attrs: Vec[Attribute]
  span: Span
  is_pub: Bool
 # (semantic ownership): the ModuleId of the module owning this item —
  # the Program.crate.modules key of its owner (the root module id 0 for
  # the main program's items). Assigned at the construction sites: the
  # parser's make_item defaults to root; compiler_core's dependency
  # assembly (collect_dep_file) stamps each merged dependency item with its
  # file module's ModuleId. Consumers read the owner's path/items via the
  # crate table — no range scans.
  owner_module: ModuleId
end

enum ItemKind
  ItemFunction(FunctionDecl)
  ItemStruct(StructDecl)
  ItemEnum(EnumDecl)
  ItemTrait(TraitDecl)
  ItemImpl(ImplDecl)
  ItemModule(ModuleDecl)
  ItemUse(UseDecl)
  ItemMacro(MacroDecl)
  ItemTypeAlias(TypeAliasDecl)
  ItemConst(ConstDecl)
  ItemStatic(StaticDecl)
  
  # Agentic features
  ItemCapabilityDecl(CapabilityDecl)
  ItemEffectDecl(EffectDecl)
  ItemRationaleBlock(RationaleBlock)
  ItemEditionDecl(EditionDecl)
  
  # Foreign interface
  ItemExternBlock(ExternBlock)
end

enum Visibility
  Public
  Private
  Default
end

# ———————————————————————————————————————————————————————————————
# Functions
# ———————————————————————————————————————————————————————————————

struct FunctionDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  params: Vec[Param]
  ret_type: Option[TypeExpr]
  where_clause: Vec[WherePredicate]
  body: FnBody
  
  # Function modifiers
  is_async: Bool
  is_unsafe: Bool
  is_const: Bool
  is_inline: Bool
  is_pure: Bool
  
  # Agentic features
  contracts: Vec[ContractClause]
  budget_val: Option[BudgetAnnotation]
  required_caps: Vec[String]
  effects: Vec[String]
  
  span: Span
end

struct GenericParam
  name: String
  bounds: Vec[TypeExpr]
  default: Option[TypeExpr]
  span: Span
end

# The semantic AST parameter record: ONE access convention. The legacy
# spellings (mut / & / &mut / move / own) are SYNTAX-ONLY — the parser
# converts them to an AccessConvention at parse time (mut/&mut -> Inout,
# & -> Let, move/own -> Sink) and the semantic AST never carries them.
struct Param
  convention: AccessConvention
  name: String
  ty: Option[TypeExpr]
  default: Option[Expr]
  span: Span
end

enum AccessConvention
  Let
  Inout
  Sink
  Set
end

enum NominalKind
  Value
  Resource
end

enum FnBody
  FnBlock(Block)
  FnExpr(Expr)
  FnExtern(String)
  FnNone
end

struct FunctionSig
  name: String
  generic_params: Vec[GenericParam]
  params: Vec[Param]
  ret_type: Option[TypeExpr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Structs
# ———————————————————————————————————————————————————————————————

struct StructDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  fields: Vec[FieldDecl]
  methods: Vec[FunctionDecl]
  derives: Vec[String]
  kind: NominalKind
  layout_attrs: LayoutAttrs
  span: Span
end

struct FieldDecl
  vis: Visibility
  name: String
  ty: TypeExpr
  default: Option[Expr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

struct EnumDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  variants: Vec[VariantDecl]
  derives: Vec[String]
  layout_attrs: LayoutAttrs
  span: Span
end

struct VariantDecl
  name: String
  fields: Vec[TypeExpr]
  field_names: Vec[Option[String]]
  discriminant: Option[Expr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Traits & Impls
# ———————————————————————————————————————————————————————————————

struct TraitDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  super_traits: Vec[TypeExpr]
  methods: Vec[TraitMethod]
  assoc_types: Vec[AssocType]
  span: Span
end

struct TraitMethod
  sig: FunctionSig
  default_body: FnBody
  span: Span
end

struct AssocType
  name: String
  bounds: Vec[TypeExpr]
  default: Option[TypeExpr]
  span: Span
end

struct ImplDecl
  vis: Visibility
  generic_params: Vec[GenericParam]
  trait_name: Option[String]
  trait_type_args: Vec[TypeExpr]
  for_type: TypeExpr
  self_type: TypeExpr
  where_clause: Vec[WherePredicate]
  methods: Vec[FunctionDecl]
  assoc_types: Vec[AssocTypeImpl]
  span: Span
end

struct AssocTypeImpl
  name: String
  ty: TypeExpr
  span: Span
end

struct WherePredicate
  ty: TypeExpr
  bounds: Vec[TypeExpr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Modules & Imports
# ———————————————————————————————————————————————————————————————

struct ModuleDecl
  vis: Visibility
  name: String
  items: Vec[Item]
  is_inline: Bool
  span: Span
end

struct UseDecl
  vis: Visibility
  path: AstPath
  alias_name: Option[String]
  names: Option[Vec[String]]
  glob: Bool
  span: Span
end

struct AstPath
  segments: Vec[String]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Type Aliases, Constants, Statics
# ———————————————————————————————————————————————————————————————

struct TypeAliasDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  ty: TypeExpr
  span: Span
end

struct ConstDecl
  vis: Visibility
  name: String
  ty: Option[TypeExpr]
  value: Expr
  span: Span
end

struct StaticDecl
  vis: Visibility
  name: String
  ty: TypeExpr
  value: Expr
  is_mut: Bool
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Macros
# ———————————————————————————————————————————————————————————————

# (macro identity): MacroDecl carries only the bare `name`; the
# MODULE-SCOPED identity (owner module path + name, rendered by the
# resolver's module-qualified key form) is assigned at registration time by
# the expansion env in compiler_core.tg (expand_macros Phase 1 — the owner
# module comes from Program.crate's module table item ranges, inline module
# trees append their segment). A macro is never visible outside its module
# except through module-qualified paths, `use` imports, or import aliases —
# the same module/import ambiguity rules other declarations obey (a
# same-module duplicate or an import collision is an E107 ambiguity error).
struct MacroDecl
  vis: Visibility
  name: String
  params: Vec[Param]
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Effect Handlers
# ———————————————————————————————————————————————————————————————

struct EffectHandler
  effect_name: String
  arms: Vec[HandlerArm]
  span: Span
end

struct HandlerArm
  operation: String
  params: Vec[Pattern]
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Agentic Features
# ———————————————————————————————————————————————————————————————

# Contracts (Design by Contract)
struct ContractClause
  kind: AstContractKind
  expr: Expr
  message: Option[String]
  span: Span
end

enum AstContractKind
  AstPre
  AstPost
  AstInvariant
end

# Capabilities (Permission System)
struct CapabilityDecl
  vis: Visibility
  name: String
  parent: Option[String]
  permissions: Vec[String]
  span: Span
end

# Effects (Side Effect Tracking)
# EffectDecl is the AST node for `effect` declarations as parsed by the frontend.
# It is distinct from std::effects::Effect, which is the runtime representation
# used by the effect tracking and enforcement system.
#
# The ops field carries the effect declaration's OPERATION SIGNATURES — the
# `effect Name { op(param: T, ...) -> R; ... } end` forms the parser records
# (the algebraic-effects row: the typed checker resolves these signatures into
# the semantic EffectId-keyed op table the perform surface is checked against).
struct EffectDecl
  vis: Visibility
  name: String
  parent: Option[String]
  ops: Vec[EffectOpSig]
  span: Span
end

# The parsed signature of ONE operation of an effect declaration:
#   op(param: T, ...) -> R
# The parameter types and the return type are TypeExprs resolved by the type
# checker (TypeExpr is never interpreted after checking).
struct EffectOpSig
  name: String
  params: Vec[EffectOpParamSig]
  ret: Option[TypeExpr]
  span: Span
end

struct EffectOpParamSig
  name: String
  ty: TypeExpr
end

# Budget (Resource Constraints)
struct BudgetAnnotation
  constraints: Vec[BudgetConstraint]
  span: Span
end

struct BudgetConstraint
  metric: String
  bound: String
  span: Span
end

# Rationale (Documentation for AI)
struct RationaleBlock
  title: String
  body: String
  author: Option[String]
  tags: Vec[String]
  span: Span
end

# Edition (Language Version)
struct EditionDecl
  version: String
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Extern (FFI)
# ———————————————————————————————————————————————————————————————

struct ExternBlock
  abi: Option[String]
  items: Vec[ExternItem]
  span: Span
end

enum ExternItem
  Function(ExternFn)
  Static(ExternStatic)
end

struct ExternFn
  name: String
  generic_params: Vec[GenericParam]
  params: Vec[Param]
  ret_type: Option[TypeExpr]
  span: Span
end

struct ExternStatic
  name: String
  ty: TypeExpr
  is_mut: Bool
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Types
# ———————————————————————————————————————————————————————————————

struct ParamTypeExpr
  ty: TypeExpr
  convention: AccessConvention
end

struct TypeExpr
  kind: TypeExprKind
  span: Span
end

enum TypeExprKind
  # Named type with optional type arguments
  Named(String, Vec[TypeExpr])
  
  # Primitive types
  Unit
  Never
  
  # Compound types
  Tuple(Vec[TypeExpr])
  Array(TypeExpr, Option[Expr])
  Slice(TypeExpr)
  
  # Pointer types (unsafe)
  Ptr(TypeExpr)
  PtrMut(TypeExpr)
  Ref(TypeExpr, Bool)
  
  # Function types
  Fn(Vec[ParamTypeExpr], TypeExpr)
  
  # Async/effect types
  Async(TypeExpr)
  Effect(String, TypeExpr)
  
  # Path type
  Path(AstPath)
  
  # Inferred
  Infer
end

# ———————————————————————————————————————————————————————————————
# Statements
# ———————————————————————————————————————————————————————————————

struct Block
  stmts: Vec[Stmt]
  span: Span
end

struct Stmt
  kind: StmtKind
  span: Span
  node_id: Int
end

enum StmtKind
  # Variable bindings
  StmtLet(Pattern, Option[TypeExpr], Expr, Bool)      # pattern, type, value, is_mut
  
  # Assignment
  StmtAssign(Expr, Expr)
  StmtCompoundAssign(BinOp, Expr, Expr)  # op, target, value
  
  # Control flow
  StmtIf(IfStmt)
  StmtMatch(MatchExpr)
  StmtWhile(Expr, Block)
  StmtFor(ForStmt)
  StmtLoop(Block)
  
  # Jumps
  StmtReturn(Option[Expr])
  StmtBreak(Option[Expr])
  StmtContinue
  
  # Expression statement
  StmtExpr(Expr)
  
  # Unsafe blocks
  StmtUnsafe(Option[String], Block)
  
  # Defer (cleanup)
  StmtDefer(Block)
  
  # Guard (early exit)
  StmtGuard(Expr, GuardElse)
  
 # the three forms below (try/catch/finally, with, handle/with) are
  # exceptional / teardown-guarding constructs. They PARSE — the AST keeps
  # them and the parser still accepts them — but they are REJECTED at the
  # type checker with the diagnostic "exceptions are not supported — no
  # throwing path may bypass teardown": the backend has no exception
  # runtime and the resource CFG has no Throw/Unwind/Handler edges, so a
  # throwing path could bypass Drop/defer/access teardown. Rejected code
  # never reaches the resource checker or MIR (which also fail closed).
  # Try/catch
  StmtTry(Block, Vec[CatchArm], Option[Block])
  
  # With (context manager)
  StmtWith(Expr, Pattern, Block)
  
  # Handle/with (effect handlers)
  StmtHandleWith(Expr, Vec[EffectHandler])
end

# Guard else action: what to do when the guard condition fails.
enum GuardElse
  Return(Option[Expr])
  Panic(String)
  Break(Option[Expr])
  Continue
end

struct IfStmt
  cond: Expr
  then_block: Block
  elsif_branches: Vec[(Expr, Block)]
  else_block: Option[Block]
  span: Span
end

struct ForStmt
  pattern: Pattern
  iter: Expr
  body: Block
  span: Span
end

struct MatchExpr
  scrutinee: Expr
  arms: Vec[MatchArm]
  span: Span
end

struct MatchArm
  pattern: Pattern
  guard_expr: Option[Expr]
  body: Block
  span: Span
end

struct CatchArm
  pattern: Pattern
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Patterns
# ———————————————————————————————————————————————————————————————

struct Pattern
  kind: PatternKind
  span: Span
  node_id: Int
end

enum PatternKind
  Wildcard
  Ident(String, Bool)                    # name, is_mut
  Literal(Expr)
  Tuple(Vec[Pattern])
  Array(Vec[Pattern])
  Struct(AstPath, Vec[(String, Pattern)])
  Variant(AstPath, Vec[Pattern])
  Or(Vec[Pattern])
  Range(Option[Expr], Option[Expr], Bool)  # start, end, inclusive
end

# ———————————————————————————————————————————————————————————————
# Expressions
# ———————————————————————————————————————————————————————————————

struct Expr
  kind: ExprKind
  span: Span
  node_id: Int
end

# The canonical place-likeness predicate: whether an expression denotes a
# MEMORY PLACE (an identifier / self reference / field access / index /
# raw deref) whose address can be taken, as opposed to a computed VALUE.
# Single source of truth for the typed-HIR consumers (mir.tg's
# expr_is_place_like and the checker-side place derivations).
pub def expr_is_place_like(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprSelfRef then true
  when ExprKind::ExprFieldAccess(_, _) then true
  when ExprKind::ExprRawDeref(_) then true
  when ExprKind::ExprIndex(_, _) then true
  when _ then false
  end  end  end
end

enum ExprKind
  # Literals — the LOSSless pre-typing form (the lexer preserves the
  # arbitrary-precision magnitude and the suffix; the checker alone
  # decides the range; the host value is materialized by the MIR/const-eval
  # consumers through token::parsed_int_to_host / parsed_float_to_host).
  ExprIntLit(ParsedIntegerLiteral)
  ExprFloatLit(ParsedFloatLiteral)
  ExprStringLit(String)
  ExprCharLit(Char)
  ExprBoolLit(Bool)
  ExprNilLit
  
  # Collections
  ExprArrayLit(Vec[Expr])
  ExprTupleLit(Vec[Expr])
  ExprStructLit(AstPath, Vec[(String, Expr)])
  ExprMapLit(Vec[(Expr, Expr)])
  
  # Identifiers and paths
  ExprIdent(String)
  ExprPath(AstPath)
  ExprSelfRef
  
  # Operators
  ExprBinaryOp(BinOp, Box[Expr], Box[Expr])
  ExprUnaryOp(UnOp, Box[Expr])

  # Member access
  ExprFieldAccess(Box[Expr], String)
  ExprMethodCall(Box[Expr], String, Vec[TypeExpr], Vec[Expr])
  ExprIndex(Box[Expr], Box[Expr])

  # Function calls
  ExprCall(Box[Expr], Vec[Expr])

  # Closures
  ExprClosure(Vec[ClosureParam], Option[TypeExpr], Box[Expr])

  # Access marker: &place / &mut place (effect from callee convention)
  ExprAccess(Box[Expr])

  # Unsafe raw pointer dereference
  ExprRawDeref(Box[Expr])

  # Control flow expressions
  ExprIf(IfStmt)
  ExprMatch(MatchExpr)
  ExprBlock(Block)
  ExprUnsafe(Option[String], Block)

  # Async/await
  ExprAsync(Block)
  ExprAwait(Box[Expr])
  
 # the postfix `?` operator (try/propagate). NOT an exceptional
  # construct in this language: no throw/raise expression exists and no
  # error propagation is modeled at any level — its semantics are ERASURE
  # (the operand's value). It is NOT rejected (the compiler kernel uses
  # it; the block exceptional forms above are the ones rejected at check
  # time).
  # Try operator
  ExprTry(Box[Expr])
  
  # Range
  ExprRange(Option[Box[Expr]], Option[Box[Expr]], Bool)  # start, end, inclusive
  
  # Type operations
  ExprCast(Box[Expr], TypeExpr)
  ExprTypeCheck(Box[Expr], TypeExpr)
  
  # Compile-time
  ExprComptime(Block)
  
  # Enum variant construction
  ExprEnumVariant(AstPath, Vec[Expr])
  
  # Assignment (expression form)
  ExprAssign(Box[Expr], Box[Expr])
  
  # Pipe operator
  ExprPipe(Box[Expr], Box[Expr])

 # Macro invocation: vec![1, 2, 3]. (macro identity): the bare name is
  # resolved MODULE-SCOPED at expansion time (compiler_core.tg
  # lookup_macro — the call site's module first, then its imports;
  # ambiguity is an E107 error). Module-qualified invocations in CALL form
  # (`a::m(x)` — the parser produces ExprEnumVariant for qualified call
  # paths) resolve through the same module-qualified machinery.
  ExprMacroCall(String, Vec[Expr])

  # Error sentinel (produced during macro expansion)
  ExprError(String)
end

struct ClosureParam
  pat: Pattern
  ty: Option[TypeExpr]
  span: Span
end

enum BinOp
  # Arithmetic
  Add
  Sub
  Mul
  Div
  Mod
  Pow
  
  # Comparison
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  
  # Logical
  And
  Or
  
  # Bitwise
  BitAnd
  BitOr
  BitXor
  Shl
  Shr
end

enum UnOp
  Neg
  Not
  BitNot
end

# ———————————————————————————————————————————————————————————————
# AST Utilities
# ———————————————————————————————————————————————————————————————

# every freshly parsed program records its root module (id 0, empty
# path, empty imports) covering all top-level items in its Crate. The root
# module's item list is built HERE (— Module.items: Vec[ItemId], each
# ItemId the flat index of one item); the parser's make_item already stamped
# every item with the root owner ModuleId. merge_imported_deps
# (compiler_core.tg) rebuilds the module table when dependencies are
# flattened in; the flat items vector stays the interface.
def make_program(items: Vec[Item], span: Span) -> Program
  var root_items = Vec::new()
  var ri = 0
  while ri < items.len() do
    root_items.push(ItemId { id: ri })
    ri = ri + 1
  end
  var root_imports = Vec::new()
  var root_id = ModuleId { id: 0 }
  var modules = Map::new()
  modules.insert(root_id, Module {
    id: root_id,
    path: Vec::new(),
    items: root_items,
    imports: root_imports
  })
  Program { items: items, crate: Crate { root: root_id, modules: modules }, span: span }
end

def make_item(kind: ItemKind, span: Span) -> Item
  Item { kind: kind, attrs: Vec::new(), span: span, is_pub: false, owner_module: ModuleId { id: 0 } }
end

def make_item_with_attrs(kind: ItemKind, attrs: Vec[Attribute], span: Span) -> Item
  Item { kind: kind, attrs: attrs, span: span, is_pub: false, owner_module: ModuleId { id: 0 } }
end

def make_block(stmts: Vec[Stmt], span: Span) -> Block
  Block { stmts: stmts, span: span }
end

def make_stmt(kind: StmtKind, span: Span) -> Stmt
  Stmt { kind: kind, span: span, node_id: 0 }
end

def make_expr(kind: ExprKind, span: Span) -> Expr
  Expr { kind: kind, span: span, node_id: 0 }
end

def make_type_expr(kind: TypeExprKind, span: Span) -> TypeExpr
  TypeExpr { kind: kind, span: span }
end

def make_pattern(kind: PatternKind, span: Span) -> Pattern
  Pattern { kind: kind, span: span, node_id: 0 }
end

def make_path(segments: Vec[String], span: Span) -> AstPath
  AstPath { segments: segments, span: span }
end

pub def type_expr_name(te: TypeExpr) -> String
  match te.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when TypeExprKind::Path(p) then
    if p.segments.len() > 0 then p.segments[p.segments.len() - 1].clone() else "".to_string() end
  when _ then "".to_string()
  end  end
end

# ———————————————————————————————————————————————————————————————
# Node IDs
# ———————————————————————————————————————————————————————————————

def assign_node_ids(inout program: Program) -> Unit
  mut next_id = 1
  mut i = 0
  while i < program.items.len() do
    assign_item_ids(&mut program.items[i], &mut next_id)
    i = i + 1
  end
end

def assign_item_ids(inout item: Item, inout next_id: Int) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    assign_function_ids(f, next_id)
  when ItemKind::ItemStruct(s) then
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then assign_expr_ids(e, next_id)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      assign_function_ids(&mut s.methods[i], next_id)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then assign_expr_ids(d, next_id)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      mut j = 0
      while j < t.methods[i].sig.params.len() do
        match t.methods[i].sig.params[j].default
        when Option::Some(e) then assign_expr_ids(e, next_id)
        when Option::None then ()
        end
        j = j + 1
      end
      match t.methods[i].default_body
      when FnBody::FnBlock(b) then assign_block_ids(b, next_id)
      when FnBody::FnExpr(e) then assign_expr_ids(e, next_id)
      when _ then ()
      end
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      assign_function_ids(&mut im.methods[i], next_id)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      assign_item_ids(&mut m.items[i], next_id)
      i = i + 1
    end
  when ItemKind::ItemMacro(mac) then
    assign_block_ids(&mut mac.body, next_id)
  when ItemKind::ItemConst(c) then
    assign_expr_ids(&mut c.value, next_id)
  when ItemKind::ItemStatic(s) then
    assign_expr_ids(&mut s.value, next_id)
  when ItemKind::ItemExternBlock(ext) then
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        mut j = 0
        while j < ef.params.len() do
          match ef.params[j].default
          when Option::Some(e) then assign_expr_ids(e, next_id)
          when Option::None then ()
          end
          j = j + 1
        end
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  when _ then ()
  end  end
end

def assign_function_ids(inout f: FunctionDecl, inout next_id: Int) -> Unit
  mut i = 0
  while i < f.params.len() do
    match f.params[i].default
    when Option::Some(e) then assign_expr_ids(e, next_id)
    when Option::None then ()
    end
    i = i + 1
  end
  i = 0
  while i < f.contracts.len() do
    assign_expr_ids(&mut f.contracts[i].expr, next_id)
    i = i + 1
  end
  match f.body
  when FnBody::FnBlock(b) then assign_block_ids(b, next_id)
  when FnBody::FnExpr(e) then assign_expr_ids(e, next_id)
  when _ then ()
  end
end

def assign_block_ids(inout block: Block, inout next_id: Int) -> Unit
  mut i = 0
  while i < block.stmts.len() do
    assign_stmt_ids(&mut block.stmts[i], next_id)
    i = i + 1
  end
end

def assign_stmt_ids(inout stmt: Stmt, inout next_id: Int) -> Unit
  stmt.node_id = next_id
  next_id = next_id + 1
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    assign_pattern_ids(pattern, next_id)
    assign_expr_ids(value, next_id)
  when StmtKind::StmtAssign(target, value) then
    assign_expr_ids(target, next_id)
    assign_expr_ids(value, next_id)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    assign_expr_ids(target, next_id)
    assign_expr_ids(value, next_id)
  when StmtKind::StmtIf(if_stmt) then
    assign_if_ids(if_stmt, next_id)
  when StmtKind::StmtMatch(m) then
    assign_match_ids(m, next_id)
  when StmtKind::StmtWhile(cond, body) then
    assign_expr_ids(cond, next_id)
    assign_block_ids(body, next_id)
  when StmtKind::StmtFor(for_stmt) then
    assign_pattern_ids(&mut for_stmt.pattern, next_id)
    assign_expr_ids(&mut for_stmt.iter, next_id)
    assign_block_ids(&mut for_stmt.body, next_id)
  when StmtKind::StmtLoop(body) then
    assign_block_ids(body, next_id)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then assign_expr_ids(val, next_id)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then assign_expr_ids(val, next_id)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then
    ()
  when StmtKind::StmtExpr(e) then
    assign_expr_ids(e, next_id)
  when StmtKind::StmtUnsafe(_, body) then
    assign_block_ids(body, next_id)
  when StmtKind::StmtDefer(body) then
    assign_block_ids(body, next_id)
  when StmtKind::StmtGuard(cond, else_action) then
    assign_expr_ids(cond, next_id)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then assign_expr_ids(val, next_id)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then assign_expr_ids(val, next_id)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    assign_block_ids(body, next_id)
    mut i = 0
    while i < catches.len() do
      assign_pattern_ids(&mut catches[i].pattern, next_id)
      assign_block_ids(&mut catches[i].body, next_id)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then assign_block_ids(fb, next_id)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat, body) then
    assign_expr_ids(expr, next_id)
    assign_pattern_ids(pat, next_id)
    assign_block_ids(body, next_id)
  when StmtKind::StmtHandleWith(expr, handlers) then
    assign_expr_ids(expr, next_id)
    mut i = 0
    while i < handlers.len() do
      mut j = 0
      while j < handlers[i].arms.len() do
        mut k = 0
        while k < handlers[i].arms[j].params.len() do
          assign_pattern_ids(&mut handlers[i].arms[j].params[k], next_id)
          k = k + 1
        end
        assign_block_ids(&mut handlers[i].arms[j].body, next_id)
        j = j + 1
      end
      i = i + 1
    end
  end
end

def assign_if_ids(inout if_stmt: IfStmt, inout next_id: Int) -> Unit
  assign_expr_ids(&mut if_stmt.cond, next_id)
  assign_block_ids(&mut if_stmt.then_block, next_id)
  mut i = 0
  while i < if_stmt.elsif_branches.len() do
    assign_expr_ids(&mut if_stmt.elsif_branches[i].0, next_id)
    assign_block_ids(&mut if_stmt.elsif_branches[i].1, next_id)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then assign_block_ids(eb, next_id)
  when Option::None then ()
  end
end

def assign_match_ids(inout m: MatchExpr, inout next_id: Int) -> Unit
  assign_expr_ids(&mut m.scrutinee, next_id)
  mut i = 0
  while i < m.arms.len() do
    assign_pattern_ids(&mut m.arms[i].pattern, next_id)
    match m.arms[i].guard_expr
    when Option::Some(g) then assign_expr_ids(g, next_id)
    when Option::None then ()
    end
    assign_block_ids(&mut m.arms[i].body, next_id)
    i = i + 1
  end
end

def assign_pattern_ids(inout pat: Pattern, inout next_id: Int) -> Unit
  pat.node_id = next_id
  next_id = next_id + 1
  match pat.kind
  when PatternKind::Literal(e) then
    assign_expr_ids(e, next_id)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      assign_pattern_ids(&mut pats[i], next_id)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      assign_pattern_ids(&mut pats[i], next_id)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      assign_pattern_ids(&mut field_pats[i].1, next_id)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      assign_pattern_ids(&mut pats[i], next_id)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      assign_pattern_ids(&mut alts[i], next_id)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then assign_expr_ids(e, next_id)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then assign_expr_ids(e, next_id)
    when Option::None then ()
    end
  when _ then ()
  end
end

def assign_expr_ids(inout expr: Expr, inout next_id: Int) -> Unit
  expr.node_id = next_id
  next_id = next_id + 1
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      assign_expr_ids(&mut elems[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      assign_expr_ids(&mut elems[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      assign_expr_ids(&mut fields[i].1, next_id)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      assign_expr_ids(&mut entries[i].0, next_id)
      assign_expr_ids(&mut entries[i].1, next_id)
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then ()
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    assign_expr_ids(lhs, next_id)
    assign_expr_ids(rhs, next_id)
  when ExprKind::ExprUnaryOp(_, operand) then
    assign_expr_ids(operand, next_id)
  when ExprKind::ExprFieldAccess(base, _) then
    assign_expr_ids(base, next_id)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    assign_expr_ids(recv, next_id)
    mut i = 0
    while i < args.len() do
      assign_expr_ids(&mut args[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprIndex(base, index) then
    assign_expr_ids(base, next_id)
    assign_expr_ids(index, next_id)
  when ExprKind::ExprCall(callee, args) then
    assign_expr_ids(callee, next_id)
    mut i = 0
    while i < args.len() do
      assign_expr_ids(&mut args[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprClosure(params, _, body) then
    mut i = 0
    while i < params.len() do
      assign_pattern_ids(&mut params[i].pat, next_id)
      i = i + 1
    end
    assign_expr_ids(body, next_id)
  when ExprKind::ExprAccess(inner) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprRawDeref(inner) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprIf(if_stmt) then
    assign_if_ids(if_stmt, next_id)
  when ExprKind::ExprMatch(m) then
    assign_match_ids(m, next_id)
  when ExprKind::ExprBlock(block) then
    assign_block_ids(block, next_id)
  when ExprKind::ExprUnsafe(_, block) then
    assign_block_ids(block, next_id)
  when ExprKind::ExprAsync(block) then
    assign_block_ids(block, next_id)
  when ExprKind::ExprAwait(inner) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprTry(inner) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then assign_expr_ids(s, next_id)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then assign_expr_ids(e, next_id)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprTypeCheck(inner, _) then
    assign_expr_ids(inner, next_id)
  when ExprKind::ExprComptime(block) then
    assign_block_ids(block, next_id)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      assign_expr_ids(&mut args[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    assign_expr_ids(target, next_id)
    assign_expr_ids(value, next_id)
  when ExprKind::ExprPipe(lhs, rhs) then
    assign_expr_ids(lhs, next_id)
    assign_expr_ids(rhs, next_id)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      assign_expr_ids(&mut args[i], next_id)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end
end
