    when PatternKind::Literal(p0) then PatternKind::Literal(p0.clone())
    when PatternKind::Tuple(p0) then PatternKind::Tuple(p0.clone())
    when PatternKind::Array(p0) then PatternKind::Array(p0.clone())
    when PatternKind::Struct(p0, p1) then PatternKind::Struct(p0.clone(), p1.clone())
    when PatternKind::Variant(p0, p1) then PatternKind::Variant(p0.clone(), p1.clone())
    when PatternKind::Or(p0) then PatternKind::Or(p0.clone())
