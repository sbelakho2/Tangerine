impl Clone for ItemKind
  def clone(self: Self) -> ItemKind
    match self
    when ItemKind::ItemFunction(p0) then ItemKind::ItemFunction(p0.clone())
    when ItemKind::ItemStruct(p0) then ItemKind::ItemStruct(p0.clone())
    when ItemKind::ItemEnum(p0) then ItemKind::ItemEnum(p0.clone())
    when ItemKind::ItemTrait(p0) then ItemKind::ItemTrait(p0.clone())
    when ItemKind::ItemImpl(p0) then ItemKind::ItemImpl(p0.clone())
    when ItemKind::ItemModule(p0) then ItemKind::ItemModule(p0.clone())
    when ItemKind::ItemUse(p0) then ItemKind::ItemUse(p0.clone())
    when ItemKind::ItemMacro(p0) then ItemKind::ItemMacro(p0.clone())
    when ItemKind::ItemTypeAlias(p0) then ItemKind::ItemTypeAlias(p0.clone())
    when ItemKind::ItemConst(p0) then ItemKind::ItemConst(p0.clone())
    when ItemKind::ItemStatic(p0) then ItemKind::ItemStatic(p0.clone())
    when ItemKind::ItemCapabilityDecl(p0) then ItemKind::ItemCapabilityDecl(p0.clone())
    when ItemKind::ItemEffectDecl(p0) then ItemKind::ItemEffectDecl(p0.clone())
    when ItemKind::ItemRationaleBlock(p0) then ItemKind::ItemRationaleBlock(p0.clone())
    when ItemKind::ItemEditionDecl(p0) then ItemKind::ItemEditionDecl(p0.clone())
    when ItemKind::ItemExternBlock(p0) then ItemKind::ItemExternBlock(p0.clone())
    end
  end
end

