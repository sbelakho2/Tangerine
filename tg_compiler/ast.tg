impl Clone for TypeExprKind
  def clone(self: Self) -> TypeExprKind
    match self
    when TypeExprKind::Named(p0, p1) then TypeExprKind::Named(p0.clone(), p1.clone())
    when TypeExprKind::ConstArg(p0) then TypeExprKind::ConstArg(p0.clone())
    when TypeExprKind::ConstExpr(p0) then TypeExprKind::ConstExpr(p0.clone())
    when TypeExprKind::Unit then TypeExprKind::Unit
    when TypeExprKind::Never then TypeExprKind::Never
    when TypeExprKind::Tuple(p0) then TypeExprKind::Tuple(p0.clone())
    when TypeExprKind::Array(p0, p1) then TypeExprKind::Array(p0.clone(), p1.clone())
    when TypeExprKind::Slice(p0) then TypeExprKind::Slice(p0.clone())
    when TypeExprKind::Ptr(p0) then TypeExprKind::Ptr(p0.clone())
    when TypeExprKind::PtrMut(p0) then TypeExprKind::PtrMut(p0.clone())
    when TypeExprKind::Ref(p0, p1) then TypeExprKind::Ref(p0.clone(), p1.clone())
    when TypeExprKind::Fn(p0, p1) then TypeExprKind::Fn(p0.clone(), p1.clone())
    when TypeExprKind::Async(p0) then TypeExprKind::Async(p0.clone())
    when TypeExprKind::Effect(p0, p1) then TypeExprKind::Effect(p0.clone(), p1.clone())
    when TypeExprKind::Path(p0) then TypeExprKind::Path(p0.clone())
    when TypeExprKind::Infer then TypeExprKind::Infer
    end
  end
end

