impl Clone for StmtKind
  def clone(self: Self) -> StmtKind
    match self
    when StmtKind::StmtLet(p0, p1, p2, p3) then StmtKind::StmtLet(p0.clone(), p1.clone(), p2.clone(), p3.clone())
    when StmtKind::StmtAssign(p0, p1) then StmtKind::StmtAssign(p0.clone(), p1.clone())
    when StmtKind::StmtCompoundAssign(p0, p1, p2) then StmtKind::StmtCompoundAssign(p0.clone(), p1.clone(), p2.clone())
    when StmtKind::StmtIf(p0) then StmtKind::StmtIf(p0.clone())
    when StmtKind::StmtMatch(p0) then StmtKind::StmtMatch(p0.clone())
    when StmtKind::StmtWhile(p0, p1) then StmtKind::StmtWhile(p0.clone(), p1.clone())
    when StmtKind::StmtFor(p0) then StmtKind::StmtFor(p0.clone())
    when StmtKind::StmtLoop(p0) then StmtKind::StmtLoop(p0.clone())
    when StmtKind::StmtReturn(p0) then StmtKind::StmtReturn(p0.clone())
    when StmtKind::StmtBreak(p0) then StmtKind::StmtBreak(p0.clone())
    when StmtKind::StmtContinue then StmtKind::StmtContinue
    when StmtKind::StmtExpr(p0) then StmtKind::StmtExpr(p0.clone())
    when StmtKind::StmtUnsafe(p0, p1) then StmtKind::StmtUnsafe(p0.clone(), p1.clone())
    when StmtKind::StmtDefer(p0) then StmtKind::StmtDefer(p0.clone())
    when StmtKind::StmtGuard(p0, p1) then StmtKind::StmtGuard(p0.clone(), p1.clone())
    when StmtKind::StmtTry(p0, p1, p2) then StmtKind::StmtTry(p0.clone(), p1.clone(), p2.clone())
    when StmtKind::StmtWith(p0, p1, p2) then StmtKind::StmtWith(p0.clone(), p1.clone(), p2.clone())
    when StmtKind::StmtHandleWith(p0, p1) then StmtKind::StmtHandleWith(p0.clone(), p1.clone())
    end
  end
end

