# Tangerine Compiler — Abstract Syntax Tree
# Self-hosting compiler written in Tangerine
#
# Complete AST with all language features:
# - Functions, structs, enums, traits, impls
# - Memory safety (ownership, borrowing, lifetimes)
# - Agentic features (contracts, capabilities, effects, budgets)
# - Modern constructs (async/await, pattern matching, generics)
# - Compile-time evaluation

use std::core::{Option, Result}
use std::collections::{Vec, Map}
use tg_compiler::token::{Span, span_merge}

# ———————————————————————————————————————————————————————————————
# Program Root
# ———————————————————————————————————————————————————————————————

struct Program
  items: Vec[Item]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Items (Top-Level Declarations)
# ———————————————————————————————————————————————————————————————

struct Item
  kind: ItemKind
  span: Span
end

enum ItemKind
  Function(FunctionDecl)
  Struct(StructDecl)
  Enum(EnumDecl)
  Trait(TraitDecl)
  Impl(ImplDecl)
  Module(ModuleDecl)
  Use(UseDecl)
  Macro(MacroDecl)
  TypeAlias(TypeAliasDecl)
  Const(ConstDecl)
  Static(StaticDecl)
  
  # Agentic features
  CapabilityDecl(CapabilityDecl)
  EffectDecl(EffectDecl)
  RationaleBlock(RationaleBlock)
  EditionDecl(EditionDecl)
  
  # Foreign interface
  ExternBlock(ExternBlock)
end

enum Visibility
  Public
  Private
  Default
end

# ———————————————————————————————————————————————————————————————
# Functions
# ———————————————————————————————————————————————————————————————

struct FunctionDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  params: Vec[Param]
  ret_type: Option[TypeExpr]
  where_clause: Vec[WherePredicate]
  body: FnBody
  
  # Function modifiers
  is_async: Bool
  is_unsafe: Bool
  is_const: Bool
  is_inline: Bool
  is_pure: Bool
  
  # Agentic features
  contracts: Vec[ContractClause]
  budget: Option[BudgetAnnotation]
  required_caps: Vec[String]
  effects: Vec[String]
  
  span: Span
end

struct GenericParam
  name: String
  bounds: Vec[TypeExpr]
  default: Option[TypeExpr]
  span: Span
end

struct Param
  modifier: Option[ParamModifier]
  name: String
  ty: Option[TypeExpr]
  default: Option[Expr]
  span: Span
end

enum ParamModifier
  Mut
  Ref
  RefMut
  Move
  Own
end

enum FnBody
  Block(Block)
  Expr(Expr)
  Extern(String)
  None
end

struct FunctionSig
  name: String
  generic_params: Vec[GenericParam]
  params: Vec[Param]
  ret_type: TypeExpr
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Structs
# ———————————————————————————————————————————————————————————————

struct StructDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  fields: Vec[FieldDecl]
  derives: Vec[String]
  span: Span
end

struct FieldDecl
  vis: Visibility
  name: String
  ty: TypeExpr
  default: Option[Expr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

struct EnumDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  variants: Vec[VariantDecl]
  derives: Vec[String]
  span: Span
end

struct VariantDecl
  name: String
  fields: Vec[TypeExpr]
  discriminant: Option[Expr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Traits & Impls
# ———————————————————————————————————————————————————————————————

struct TraitDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  super_traits: Vec[TypeExpr]
  methods: Vec[TraitMethod]
  assoc_types: Vec[AssocType]
  span: Span
end

struct TraitMethod
  sig: FunctionSig
  default_body: Option[FnBody]
  span: Span
end

struct AssocType
  name: String
  bounds: Vec[TypeExpr]
  default: Option[TypeExpr]
  span: Span
end

struct ImplDecl
  generic_params: Vec[GenericParam]
  trait_name: Option[String]
  for_type: TypeExpr
  where_clause: Vec[WherePredicate]
  methods: Vec[FunctionDecl]
  assoc_types: Vec[AssocTypeImpl]
  span: Span
end

struct AssocTypeImpl
  name: String
  ty: TypeExpr
  span: Span
end

struct WherePredicate
  ty: TypeExpr
  bounds: Vec[TypeExpr]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Modules & Imports
# ———————————————————————————————————————————————————————————————

struct ModuleDecl
  vis: Visibility
  name: String
  items: Vec[Item]
  is_inline: Bool
  span: Span
end

struct UseDecl
  path: Path
  alias: Option[String]
  names: Option[Vec[String]]
  glob: Bool
  span: Span
end

struct Path
  segments: Vec[String]
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Type Aliases, Constants, Statics
# ———————————————————————————————————————————————————————————————

struct TypeAliasDecl
  vis: Visibility
  name: String
  generic_params: Vec[GenericParam]
  ty: TypeExpr
  span: Span
end

struct ConstDecl
  vis: Visibility
  name: String
  ty: Option[TypeExpr]
  value: Expr
  span: Span
end

struct StaticDecl
  vis: Visibility
  name: String
  ty: TypeExpr
  value: Expr
  is_mut: Bool
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Macros
# ———————————————————————————————————————————————————————————————

struct MacroDecl
  vis: Visibility
  name: String
  params: Vec[Param]
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Effect Handlers
# ———————————————————————————————————————————————————————————————

struct EffectHandler
  effect_name: String
  arms: Vec[HandlerArm]
  span: Span
end

struct HandlerArm
  operation: String
  params: Vec[String]
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Agentic Features
# ———————————————————————————————————————————————————————————————

# Contracts (Design by Contract)
struct ContractClause
  kind: ContractKind
  expr: Expr
  message: Option[String]
  span: Span
end

enum ContractKind
  Pre
  Post
  Invariant
end

# Capabilities (Permission System)
struct CapabilityDecl
  vis: Visibility
  name: String
  parent: Option[String]
  permissions: Vec[String]
  span: Span
end

# Effects (Side Effect Tracking)
struct EffectDecl
  vis: Visibility
  name: String
  parent: Option[String]
  span: Span
end

# Budget (Resource Constraints)
struct BudgetAnnotation
  constraints: Vec[BudgetConstraint]
  span: Span
end

struct BudgetConstraint
  metric: String
  bound: String
  span: Span
end

# Rationale (Documentation for AI)
struct RationaleBlock
  title: String
  body: String
  author: Option[String]
  tags: Vec[String]
  span: Span
end

# Edition (Language Version)
struct EditionDecl
  version: String
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Extern (FFI)
# ———————————————————————————————————————————————————————————————

struct ExternBlock
  abi: Option[String]
  items: Vec[ExternItem]
  span: Span
end

enum ExternItem
  Function(ExternFn)
  Static(ExternStatic)
end

struct ExternFn
  name: String
  params: Vec[Param]
  ret_type: Option[TypeExpr]
  span: Span
end

struct ExternStatic
  name: String
  ty: TypeExpr
  is_mut: Bool
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Types
# ———————————————————————————————————————————————————————————————

struct TypeExpr
  kind: TypeExprKind
  span: Span
end

enum TypeExprKind
  # Named type with optional type arguments
  Named(String, Vec[TypeExpr])
  
  # Primitive types
  Unit
  Never
  
  # Compound types
  Tuple(Vec[TypeExpr])
  Array(TypeExpr, Option[Expr])
  Slice(TypeExpr)
  
  # Reference types
  Ref(TypeExpr)
  RefMut(TypeExpr)
  
  # Pointer types (unsafe)
  Ptr(TypeExpr)
  PtrMut(TypeExpr)
  
  # Function types
  Fn(Vec[TypeExpr], TypeExpr)
  
  # Async/effect types
  Async(TypeExpr)
  Effect(String, TypeExpr)
  
  # Path type
  Path(Path)
  
  # Inferred
  Infer
end

# ———————————————————————————————————————————————————————————————
# Statements
# ———————————————————————————————————————————————————————————————

struct Block
  stmts: Vec[Stmt]
  span: Span
end

struct Stmt
  kind: StmtKind
  span: Span
end

enum StmtKind
  # Variable bindings
  Let(String, Option[TypeExpr], Expr, Bool)      # name, type, value, is_mut
  
  # Assignment
  Assign(Expr, Expr)
  
  # Control flow
  If(IfStmt)
  Match(MatchExpr)
  While(Expr, Block)
  For(String, Expr, Block)
  Loop(Block)
  
  # Jumps
  Return(Option[Expr])
  Break(Option[Expr])
  Continue
  Yield(Option[Expr])
  
  # Expression statement
  Expr(Expr)
  
  # Unsafe blocks
  Unsafe(Option[String], Block)
  
  # Defer (cleanup)
  Defer(Block)
  
  # Try/catch
  Try(Block, Vec[CatchArm], Option[Block])
  
  # With (context manager)
  With(Expr, String, Block)
  
  # Handle/with (effect handlers)
  HandleWith(Expr, Vec[EffectHandler])
end

struct IfStmt
  cond: Expr
  then_block: Block
  elsif_branches: Vec[(Expr, Block)]
  else_block: Option[Block]
  span: Span
end

struct MatchExpr
  scrutinee: Expr
  arms: Vec[MatchArm]
  span: Span
end

struct MatchArm
  pattern: Pattern
  guard: Option[Expr]
  body: Block
  span: Span
end

struct CatchArm
  pattern: Pattern
  body: Block
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Patterns
# ———————————————————————————————————————————————————————————————

struct Pattern
  kind: PatternKind
  span: Span
end

enum PatternKind
  Wildcard
  Ident(String, Bool)                    # name, is_mut
  Literal(Expr)
  Tuple(Vec[Pattern])
  Array(Vec[Pattern])
  Struct(Path, Vec[(String, Pattern)])
  Variant(Path, Vec[Pattern])
  Or(Vec[Pattern])
  Range(Option[Expr], Option[Expr], Bool)  # start, end, inclusive
  Ref(Pattern)
  RefMut(Pattern)
end

# ———————————————————————————————————————————————————————————————
# Expressions
# ———————————————————————————————————————————————————————————————

struct Expr
  kind: ExprKind
  span: Span
end

enum ExprKind
  # Literals
  IntLit(Int)
  FloatLit(Float)
  StringLit(String)
  CharLit(Char)
  BoolLit(Bool)
  NilLit
  
  # Collections
  ArrayLit(Vec[Expr])
  TupleLit(Vec[Expr])
  StructLit(Path, Vec[(String, Expr)])
  MapLit(Vec[(Expr, Expr)])
  
  # Identifiers and paths
  Ident(String)
  Path(Path)
  SelfRef
  
  # Operators
  BinaryOp(BinOp, Expr, Expr)
  UnaryOp(UnOp, Expr)
  
  # Member access
  FieldAccess(Expr, String)
  MethodCall(Expr, String, Vec[TypeExpr], Vec[Expr])
  Index(Expr, Expr)
  
  # Function calls
  Call(Expr, Vec[Expr])
  
  # Closures
  Closure(Vec[ClosureParam], Option[TypeExpr], Expr)
  
  # References
  Ref(Expr)
  RefMut(Expr)
  Deref(Expr)
  
  # Ownership expressions
  Move(Expr)
  Copy(Expr)
  
  # Control flow expressions
  If(IfStmt)
  Match(MatchExpr)
  Block(Block)
  
  # Async/await
  Async(Block)
  Await(Expr)
  
  # Try operator
  Try(Expr)
  
  # Range
  Range(Option[Expr], Option[Expr], Bool)  # start, end, inclusive
  
  # Type operations
  Cast(Expr, TypeExpr)
  TypeCheck(Expr, TypeExpr)
  
  # Compile-time
  Comptime(Block)
  
  # Enum variant construction
  EnumVariant(Path, Vec[Expr])
  
  # Assignment (expression form)
  Assign(Expr, Expr)
  
  # Pipe operator
  Pipe(Expr, Expr)
end

struct ClosureParam
  name: String
  ty: Option[TypeExpr]
  span: Span
end

enum BinOp
  # Arithmetic
  Add
  Sub
  Mul
  Div
  Mod
  Pow
  
  # Comparison
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  
  # Logical
  And
  Or
  
  # Bitwise
  BitAnd
  BitOr
  BitXor
  Shl
  Shr
end

enum UnOp
  Neg
  Not
  BitNot
end

# ———————————————————————————————————————————————————————————————
# AST Utilities
# ———————————————————————————————————————————————————————————————

def make_program(items: Vec[Item], span: Span) -> Program
  Program { items: items, span: span }
end

def make_item(kind: ItemKind, span: Span) -> Item
  Item { kind: kind, span: span }
end

def make_block(stmts: Vec[Stmt], span: Span) -> Block
  Block { stmts: stmts, span: span }
end

def make_stmt(kind: StmtKind, span: Span) -> Stmt
  Stmt { kind: kind, span: span }
end

def make_expr(kind: ExprKind, span: Span) -> Expr
  Expr { kind: kind, span: span }
end

def make_type_expr(kind: TypeExprKind, span: Span) -> TypeExpr
  TypeExpr { kind: kind, span: span }
end

def make_pattern(kind: PatternKind, span: Span) -> Pattern
  Pattern { kind: kind, span: span }
end

def make_path(segments: Vec[String], span: Span) -> Path
  Path { segments: segments, span: span }
end
