impl Clone for ExprKind
  def clone(self: Self) -> ExprKind
    match self
    when ExprKind::ExprIntLit(p0) then ExprKind::ExprIntLit(p0.clone())
    when ExprKind::ExprFloatLit(p0) then ExprKind::ExprFloatLit(p0.clone())
    when ExprKind::ExprStringLit(p0) then ExprKind::ExprStringLit(p0.clone())
    when ExprKind::ExprCharLit(p0) then ExprKind::ExprCharLit(p0.clone())
    when ExprKind::ExprBoolLit(p0) then ExprKind::ExprBoolLit(p0.clone())
    when ExprKind::ExprNilLit then ExprKind::ExprNilLit
    when ExprKind::ExprArrayLit(p0) then ExprKind::ExprArrayLit(p0.clone())
    when ExprKind::ExprArrayRepeat(p0, p1) then ExprKind::ExprArrayRepeat(p0.clone(), p1.clone())
    when ExprKind::ExprTupleLit(p0) then ExprKind::ExprTupleLit(p0.clone())
    when ExprKind::ExprStructLit(p0, p1) then ExprKind::ExprStructLit(p0.clone(), p1.clone())
    when ExprKind::ExprMapLit(p0) then ExprKind::ExprMapLit(p0.clone())
    when ExprKind::ExprIdent(p0) then ExprKind::ExprIdent(p0.clone())
    when ExprKind::ExprPath(p0) then ExprKind::ExprPath(p0.clone())
    when ExprKind::ExprSelfRef then ExprKind::ExprSelfRef
    when ExprKind::ExprBinaryOp(p0, p1, p2) then ExprKind::ExprBinaryOp(p0.clone(), p1.clone(), p2.clone())
    when ExprKind::ExprUnaryOp(p0, p1) then ExprKind::ExprUnaryOp(p0.clone(), p1.clone())
    when ExprKind::ExprFieldAccess(p0, p1) then ExprKind::ExprFieldAccess(p0.clone(), p1.clone())
    when ExprKind::ExprMethodCall(p0, p1, p2, p3) then ExprKind::ExprMethodCall(p0.clone(), p1.clone(), p2.clone(), p3.clone())
    when ExprKind::ExprIndex(p0, p1) then ExprKind::ExprIndex(p0.clone(), p1.clone())
    when ExprKind::ExprCall(p0, p1) then ExprKind::ExprCall(p0.clone(), p1.clone())
    when ExprKind::ExprClosure(p0, p1, p2) then ExprKind::ExprClosure(p0.clone(), p1.clone(), p2.clone())
    when ExprKind::ExprAccess(p0) then ExprKind::ExprAccess(p0.clone())
    when ExprKind::ExprRawDeref(p0) then ExprKind::ExprRawDeref(p0.clone())
    when ExprKind::ExprIf(p0) then ExprKind::ExprIf(p0.clone())
    when ExprKind::ExprMatch(p0) then ExprKind::ExprMatch(p0.clone())
    when ExprKind::ExprBlock(p0) then ExprKind::ExprBlock(p0.clone())
    when ExprKind::ExprUnsafe(p0, p1) then ExprKind::ExprUnsafe(p0.clone(), p1.clone())
    when ExprKind::ExprAsync(p0) then ExprKind::ExprAsync(p0.clone())
    when ExprKind::ExprAwait(p0) then ExprKind::ExprAwait(p0.clone())
    when ExprKind::ExprTry(p0) then ExprKind::ExprTry(p0.clone())
    when ExprKind::ExprRange(p0, p1, p2) then ExprKind::ExprRange(p0.clone(), p1.clone(), p2.clone())
    when ExprKind::ExprCast(p0, p1) then ExprKind::ExprCast(p0.clone(), p1.clone())
    when ExprKind::ExprTypeCheck(p0, p1) then ExprKind::ExprTypeCheck(p0.clone(), p1.clone())
    when ExprKind::ExprComptime(p0) then ExprKind::ExprComptime(p0.clone())
    when ExprKind::ExprEnumVariant(p0, p1, p2) then ExprKind::ExprEnumVariant(p0.clone(), p1.clone(), p2.clone())
    when ExprKind::ExprAssign(p0, p1) then ExprKind::ExprAssign(p0.clone(), p1.clone())
    when ExprKind::ExprPipe(p0, p1) then ExprKind::ExprPipe(p0.clone(), p1.clone())
    when ExprKind::ExprMacroCall(p0, p1) then ExprKind::ExprMacroCall(p0.clone(), p1.clone())
    when ExprKind::ExprHole then ExprKind::ExprHole
    when ExprKind::ExprError(p0) then ExprKind::ExprError(p0.clone())
    end
  end
end

impl Clone for ClosureParam
  def clone(self: Self) -> ClosureParam
    ClosureParam {
      pat: self.pat.clone(),
      ty: self.ty.clone(),
      span: self.span.clone(),
    }
  end
end

impl Clone for BinOp
  def clone(self: Self) -> BinOp
    match self
    when BinOp::Add then BinOp::Add
    when BinOp::Sub then BinOp::Sub
    when BinOp::Mul then BinOp::Mul
    when BinOp::Div then BinOp::Div
    when BinOp::Mod then BinOp::Mod
    when BinOp::Pow then BinOp::Pow
    when BinOp::Eq then BinOp::Eq
    when BinOp::Ne then BinOp::Ne
    when BinOp::Lt then BinOp::Lt
    when BinOp::Le then BinOp::Le
    when BinOp::Gt then BinOp::Gt
    when BinOp::Ge then BinOp::Ge
    when BinOp::And then BinOp::And
    when BinOp::Or then BinOp::Or
    when BinOp::BitAnd then BinOp::BitAnd
    when BinOp::BitOr then BinOp::BitOr
    when BinOp::BitXor then BinOp::BitXor
    when BinOp::Shl then BinOp::Shl
    when BinOp::Shr then BinOp::Shr
    end
  end
end

impl Clone for UnOp
  def clone(self: Self) -> UnOp
    match self
    when UnOp::Neg then UnOp::Neg
    when UnOp::Not then UnOp::Not
    when UnOp::BitNot then UnOp::BitNot
    end
  end
end

