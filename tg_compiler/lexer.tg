# Tangerine Compiler — Lexer
# Self-hosting compiler written in Tangerine
#
# Tokenizes.tg source files with full error recovery.
# Produces Token stream for the parser.

use std::core::{Option, Result, panic, utf8_seq_len, utf8_seq_valid}
use std::collections::{Vec}
use tg_compiler::token::{Span, Token, TokenKind, token_new, span_new, keyword_from_str, ParsedIntegerLiteral, ParsedFloatLiteral, parsed_float_value_of}

# ———————————————————————————————————————————————————————————————
# Lexer State
# ———————————————————————————————————————————————————————————————

struct Lexer
  source: String
  file: String
  pos: Int
  len: Int
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

struct LexResult
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

# ———————————————————————————————————————————————————————————————
# Lexer Creation
# ———————————————————————————————————————————————————————————————

def lexer_new(source: String, file: String) -> Lexer
  let source_len = source.len()
  Lexer {
    source: source,
    file: file,
    pos: 0,
    len: source_len,
    tokens: Vec::new(),
    errors: Vec::new()
  }
end

# ———————————————————————————————————————————————————————————————
# Character Utilities
# ———————————————————————————————————————————————————————————————

def lexer_char_at(s: String, idx: Int) -> Option[Char]
  if idx >= 0 && idx < s.len() then
    Option::Some(s.char_at(idx))
  else
    Option::None
  end
end

def is_whitespace(c: Char) -> Bool
  # CR is NOT whitespace here: under the Unicode source model the CR is a
  # line ending (the tokenize loop turns it into the Newline token).
  c == ' ' || c == '\t'
end

def is_newline(c: Char) -> Bool
  c == '\n'
end

def is_digit(c: Char) -> Bool
  c >= '0' && c <= '9'
end

def is_alpha(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
end

def is_ident_start(c: Char) -> Bool
  is_alpha(c) || c == '_'
end

def is_ident_char(c: Char) -> Bool
  is_alpha(c) || is_digit(c) || c == '_'
end
# ———————————————————————————————————————————————————————————————
# Unicode Source Model — the UCD-derived identifier tables and NFC
# ———————————————————————————————————————————————————————————————
#
# The normative data authority is the Unicode Character Database (UCD),
# version 16.0.0:
#   - XID_Start / XID_Continue: DerivedCoreProperties.txt (the BMP ranges
#     the language supports; the ASCII classes are the lexer's fast path).
#   - NFC: UnicodeData.txt canonical decompositions, primary composites
#     per CompositionExclusions.txt, Hangul syllables algorithmic.
# The tables are generated by a script (reported in the repo) and were
# verified to reproduce Python's unicodedata NFC (16.0.0) on every BMP
# scalar and on 3000 random identifier-shaped strings.
#
# Generated data — Unicode 16.0.0 UCD (DerivedCoreProperties.txt + UnicodeData.txt +
# CompositionExclusions.txt via the UAX15 NFC oracle; Python unicodedata 16.0.0).
# The full table set (decompose+compose) reproduces Python's NFC on every BMP scalar
# and 3000 random identifier-shaped strings (CCC reordering has no BMP-only effect).
# XID_Start BMP ranges beyond the ASCII fast path: 383 ranges
def xid_start_range(cp: Int) -> Bool
  if cp >= 0x00AA && cp <= 0x00AA then return true end
  if cp >= 0x00B5 && cp <= 0x00B5 then return true end
  if cp >= 0x00BA && cp <= 0x00BA then return true end
  if cp >= 0x00C0 && cp <= 0x00D6 then return true end
  if cp >= 0x00D8 && cp <= 0x00F6 then return true end
  if cp >= 0x00F8 && cp <= 0x02C1 then return true end
  if cp >= 0x02C6 && cp <= 0x02D1 then return true end
  if cp >= 0x02E0 && cp <= 0x02E4 then return true end
  if cp >= 0x02EC && cp <= 0x02EC then return true end
