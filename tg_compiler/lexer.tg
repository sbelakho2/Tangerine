# Tangerine Compiler — Lexer
# Self-hosting compiler written in Tangerine
#
# Tokenizes .tg source files with full error recovery.
# Produces Token stream for the parser.

use std::core::{Option, Result, panic}
use std::collections::{Vec}
use tg_compiler::token::{Span, Token, TokenKind, token_new, span_new, keyword_from_str}

# ———————————————————————————————————————————————————————————————
# Lexer State
# ———————————————————————————————————————————————————————————————

struct Lexer
  source: String
  pos: Int
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

struct LexResult
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

# ———————————————————————————————————————————————————————————————
# Lexer Creation
# ———————————————————————————————————————————————————————————————

def lexer_new(source: String) -> Lexer
  Lexer {
    source: source,
    pos: 0,
    tokens: Vec::new(),
    errors: Vec::new()
  }
end

# ———————————————————————————————————————————————————————————————
# Character Utilities
# ———————————————————————————————————————————————————————————————

def char_at(s: String, idx: Int) -> Option[Char]
  if idx >= 0 && idx < s.len() then
    Option::Some(s.char_at(idx))
  else
    Option::None
  end
end

def is_whitespace(c: Char) -> Bool
  c == ' ' || c == '\t' || c == '\r'
end

def is_newline(c: Char) -> Bool
  c == '\n'
end

def is_digit(c: Char) -> Bool
  c >= '0' && c <= '9'
end

def is_alpha(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
end

def is_ident_start(c: Char) -> Bool
  is_alpha(c) || c == '_'
end

def is_ident_char(c: Char) -> Bool
  is_alpha(c) || is_digit(c) || c == '_'
end

# ———————————————————————————————————————————————————————————————
# Lexer Helpers
# ———————————————————————————————————————————————————————————————

def peek(lex: &Lexer) -> Option[Char]
  char_at(lex.source, lex.pos)
end

def peek_next(lex: &Lexer) -> Option[Char]
  char_at(lex.source, lex.pos + 1)
end

def advance(lex: &mut Lexer) -> Option[Char]
  let c = peek(lex)
  if c.is_some() then
    lex.pos = lex.pos + 1
  end
  c
end

def at_end(lex: &Lexer) -> Bool
  lex.pos >= lex.source.len()
end

def emit_token(lex: &mut Lexer, kind: TokenKind, start: Int) -> Unit
  let span = span_new(start, lex.pos)
  lex.tokens.push(token_new(kind, span))
end

def emit_error(lex: &mut Lexer, msg: String, start: Int) -> Unit
  let span = span_new(start, lex.pos)
  lex.errors.push((msg, span))
  lex.tokens.push(token_new(TokenKind::Error(msg), span))
end

# ———————————————————————————————————————————————————————————————
# Escape Sequence Helpers
# ———————————————————————————————————————————————————————————————

# Read exactly `count` hex digits and return their value
def read_hex_escape(lex: &mut Lexer, count: Int) -> Int
  mut result = 0
  mut i = 0
  while i < count do
    match peek(lex)
    when Option::Some(c) then
      let digit = hex_digit_value(c)
      if digit >= 0 then
        result = result * 16 + digit
        advance(lex)
        i = i + 1
      else
        emit_error(lex, "invalid hex escape: expected hex digit", lex.pos)
        break
      end
    when Option::None then
      emit_error(lex, "unexpected end of file in hex escape", lex.pos)
      break
    end
  end
  result
end

# Read hex digits until delimiter character
def read_hex_until(lex: &mut Lexer, delim: Char) -> Int
  mut result = 0
  mut count = 0
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if c == delim then
        break
      end
      let digit = hex_digit_value(c)
      if digit >= 0 then
        result = result * 16 + digit
        advance(lex)
        count = count + 1
        if count > 6 then
          emit_error(lex, "unicode escape too long (max 6 hex digits)", lex.pos)
          break
        end
      else
        emit_error(lex, "invalid unicode escape: expected hex digit", lex.pos)
        break
      end
    when Option::None then
      emit_error(lex, "unexpected end of file in unicode escape", lex.pos)
      break
    end
  end
  result
end

# Get numeric value of hex digit (-1 if not a hex digit)
def hex_digit_value(c: Char) -> Int
  if c >= '0' && c <= '9' then
    (c as Int) - ('0' as Int)
  elsif c >= 'a' && c <= 'f' then
    (c as Int) - ('a' as Int) + 10
  elsif c >= 'A' && c <= 'F' then
    (c as Int) - ('A' as Int) + 10
  else
    -1
  end
end

# Convert a unicode code point to a character
def char_from_code(code: Int) -> Char
  if code >= 0 && code <= 0x10FFFF then
    code as Char
  else
    '\uFFFD'  # Replacement character
  end
end

# ———————————————————————————————————————————————————————————————
# Whitespace & Comments
# ———————————————————————————————————————————————————————————————

def skip_whitespace(lex: &mut Lexer) -> Unit
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_whitespace(c) then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
end

def skip_line_comment(lex: &mut Lexer) -> Unit
  # Skip until newline
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_newline(c) then
        break
      else
        advance(lex)
      end
    when Option::None then
      break
    end
  end
end

def skip_block_comment(lex: &mut Lexer) -> Unit
  # Skip #| ... |# with nesting support
  let start = lex.pos
  mut depth = 1
  while !at_end(lex) && depth > 0 do
    match peek(lex)
    when Option::Some('#') then
      match peek_next(lex)
      when Option::Some('|') then
        advance(lex)
        advance(lex)
        depth = depth + 1
      when _ then
        advance(lex)
      end
    when Option::Some('|') then
      match peek_next(lex)
      when Option::Some('#') then
        advance(lex)
        advance(lex)
        depth = depth - 1
      when _ then
        advance(lex)
      end
    when _ then
      advance(lex)
    end
  end
  
  # Check for unterminated block comment
  if depth > 0 then
    emit_error(lex, "unterminated block comment", start)
  end
end

def skip_whitespace_and_comments(lex: &mut Lexer) -> Unit
  while !at_end(lex) do
    skip_whitespace(lex)
    if at_end(lex) then break end
    
    match peek(lex)
    when Option::Some('#') then
      match peek_next(lex)
      when Option::Some('|') then
        # Block comment: #| ... |#
        advance(lex)
        advance(lex)
        skip_block_comment(lex)
      when Option::Some('#') then
        # Doc comment: ## ... — DON'T skip, will be handled by next_token
        break
      when _ then
        # Line comment: # ...
        skip_line_comment(lex)
      end
    when _ then
      break
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Number Lexing
# ———————————————————————————————————————————————————————————————

def is_hex_digit(c: Char) -> Bool
  is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
end

def is_binary_digit(c: Char) -> Bool
  c == '0' || c == '1'
end

def is_octal_digit(c: Char) -> Bool
  c >= '0' && c <= '7'
end

def lex_number(lex: &mut Lexer, start: Int) -> Unit
  let first_char = lex.source.char_at(start)
  
  if first_char == '0' && !at_end(lex) then
    match peek(lex)
    when Option::Some('x') | Option::Some('X') then
      advance(lex)
      lex_hex_number(lex, start)
      return
    when Option::Some('b') | Option::Some('B') then
      advance(lex)
      lex_binary_number(lex, start)
      return
    when Option::Some('o') | Option::Some('O') then
      advance(lex)
      lex_octal_number(lex, start)
      return
    when _ then ()
    end
  end
  
  # Consume integer part (decimal)
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_digit(c) then
        advance(lex)
      elsif c == '_' then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
  
  # Check for decimal point
  mut is_float = false
  match peek(lex)
  when Option::Some('.') then
    match peek_next(lex)
    when Option::Some(c) then
      if is_digit(c) then
        advance(lex)
        is_float = true
        while !at_end(lex) do
          match peek(lex)
          when Option::Some(c2) then
            if is_digit(c2) then
              advance(lex)
            elsif c2 == '_' then
              advance(lex)
            else
              break
            end
          when Option::None then
            break
          end
        end
      end
    when Option::None then
      ()
    end
  when _ then
    ()
  end
  
  # Check for exponent part: e/E followed by optional +/- and digits
  match peek(lex)
  when Option::Some('e') | Option::Some('E') then
    is_float = true
    advance(lex)
    match peek(lex)
    when Option::Some('+') | Option::Some('-') then advance(lex)
    when _ then ()
    end
    mut has_exp_digits = false
    while !at_end(lex) do
      match peek(lex)
      when Option::Some(c) then
        if is_digit(c) then
          advance(lex)
          has_exp_digits = true
        elsif c == '_' then
          advance(lex)
        else
          break
        end
      when Option::None then break
      end
    end
    if !has_exp_digits then
      emit_error(lex, "expected digits after exponent", start)
      return
    end
  when _ then ()
  end
  
  let text = lex.source.slice(start, lex.pos)
  if is_float then
    let val = text.parse_float()
    emit_token(lex, TokenKind::FloatLit(val), start)
  else
    let val = text.parse_int()
    emit_token(lex, TokenKind::IntLit(val), start)
  end
end

def lex_hex_number(lex: &mut Lexer, start: Int) -> Unit
  mut has_digits = false
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_hex_digit(c) then
        advance(lex)
        has_digits = true
      elsif c == '_' then
        advance(lex)
      else
        break
      end
    when Option::None then break
    end
  end
  if !has_digits then
    emit_error(lex, "expected hex digits after 0x", start)
    return
  end
  let text = lex.source.slice(start, lex.pos)
  let val = parse_hex(text.slice(2, text.len()))
  emit_token(lex, TokenKind::IntLit(val), start)
end

def lex_binary_number(lex: &mut Lexer, start: Int) -> Unit
  mut has_digits = false
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_binary_digit(c) then
        advance(lex)
        has_digits = true
      elsif c == '_' then
        advance(lex)
      else
        break
      end
    when Option::None then break
    end
  end
  if !has_digits then
    emit_error(lex, "expected binary digits after 0b", start)
    return
  end
  let text = lex.source.slice(start, lex.pos)
  let val = parse_binary(text.slice(2, text.len()))
  emit_token(lex, TokenKind::IntLit(val), start)
end

def lex_octal_number(lex: &mut Lexer, start: Int) -> Unit
  mut has_digits = false
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_octal_digit(c) then
        advance(lex)
        has_digits = true
      elsif c == '_' then
        advance(lex)
      else
        break
      end
    when Option::None then break
    end
  end
  if !has_digits then
    emit_error(lex, "expected octal digits after 0o", start)
    return
  end
  let text = lex.source.slice(start, lex.pos)
  let val = parse_octal(text.slice(2, text.len()))
  emit_token(lex, TokenKind::IntLit(val), start)
end

def parse_hex(s: String) -> Int
  mut result = 0
  for c in s.chars() do
    if c == '_' then next end
    result = result * 16 + hex_digit_value(c)
  end
  result
end

def parse_binary(s: String) -> Int
  mut result = 0
  for c in s.chars() do
    if c == '_' then next end
    result = result * 2 + (c as Int - '0' as Int)
  end
  result
end

def parse_octal(s: String) -> Int
  mut result = 0
  for c in s.chars() do
    if c == '_' then next end
    result = result * 8 + (c as Int - '0' as Int)
  end
  result
end

# ———————————————————————————————————————————————————————————————
# String Lexing
# ———————————————————————————————————————————————————————————————

def lex_string(lex: &mut Lexer, start: Int) -> Unit
  advance(lex)  # consume opening quote
  mut content = ""
  mut escaped = false
  
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if escaped then
        # BUG-025 FIX: Track whether we need to advance after escape
        mut should_advance = true
        match c
        when 'n' then content = content + "\n"
        when 't' then content = content + "\t"
        when 'r' then content = content + "\r"
        when '0' then content = content + "\0"
        when '\\' then content = content + "\\"
        when '"' then content = content + "\""
        when '\'' then content = content + "\'"
        when 'x' then
          # Hex escape: \xNN
          advance(lex)  # consume 'x'
          let hex = read_hex_escape(lex, 2)
          content = content + char_from_code(hex).to_string()
          should_advance = false  # read_hex_escape already advanced past digits
        when 'u' then
          # Unicode escape: \u{NNNN}
          advance(lex)  # consume 'u'
          if peek(lex) == Option::Some('{') then
            advance(lex)  # consume '{'
            let hex = read_hex_until(lex, '}')
            if hex > 0x10FFFF then
              emit_error(lex, "unicode escape out of range (max 0x10FFFF)", lex.pos)
            end
            if peek(lex) == Option::Some('}') then
              advance(lex)  # consume '}'
            else
              emit_error(lex, "invalid unicode escape, missing closing '}'", lex.pos)
            end
            content = content + char_from_code(hex).to_string()
            should_advance = false  # already advanced past '}'
          else
            emit_error(lex, "invalid unicode escape, expected \\u{...}", lex.pos)
          end
        when c2 then
          emit_error(lex, "unknown escape sequence: \\" + c2.to_string(), lex.pos - 1)
          content = content + c2.to_string()
        end
        escaped = false
        if should_advance then
          advance(lex)
        end
      elsif c == '\\' then
        escaped = true
        advance(lex)
      elsif c == '"' then
        advance(lex)  # consume closing quote
        emit_token(lex, TokenKind::StringLit(content), start)
        return
      elsif is_newline(c) then
        emit_error(lex, "unterminated string literal", start)
        return
      else
        content = content + c.to_string()
        advance(lex)
      end
    when Option::None then
      break
    end
  end
  
  emit_error(lex, "unterminated string literal", start)
end

# ———————————————————————————————————————————————————————————————
# Character Lexing
# ———————————————————————————————————————————————————————————————

def lex_char(lex: &mut Lexer, start: Int) -> Unit
  advance(lex)  # consume opening quote
  
  match peek(lex)
  when Option::Some('\\') then
    advance(lex)
    match peek(lex)
    when Option::Some(c) then
      let mut ch = '\0'
      match c
      when 'n' then ch = '\n'
      when 't' then ch = '\t'
      when 'r' then ch = '\r'
      when '\\' then ch = '\\'
      when '\'' then ch = '\''
      when c2 then
        emit_error(lex, "unknown escape sequence: \\" + c2.to_string(), start)
        ch = c2
      end
      end
      advance(lex)
      match peek(lex)
      when Option::Some('\'') then
        advance(lex)
        emit_token(lex, TokenKind::CharLit(ch), start)
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    when Option::None then
      emit_error(lex, "unterminated character literal", start)
    end
  when Option::Some(c) then
    if c != '\'' then
      advance(lex)
      match peek(lex)
      when Option::Some('\'') then
        advance(lex)
        emit_token(lex, TokenKind::CharLit(c), start)
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    else
      emit_error(lex, "empty character literal", start)
    end
  when Option::None then
    emit_error(lex, "unterminated character literal", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Identifier / Keyword Lexing
# ———————————————————————————————————————————————————————————————

def lex_ident(lex: &mut Lexer, start: Int) -> Unit
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_ident_char(c) then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
  
  let text = lex.source.slice(start, lex.pos)
  match keyword_from_str(text)
  when Option::Some(kw) then
    emit_token(lex, kw, start)
  when Option::None then
    emit_token(lex, TokenKind::Ident(text), start)
  end
end

# ———————————————————————————————————————————————————————————————
# Main Tokenize Loop
# ———————————————————————————————————————————————————————————————

def tokenize_impl(lex: &mut Lexer) -> LexResult
  while !at_end(lex) do
    skip_whitespace_and_comments(lex)
    if at_end(lex) then break end
    
    let start = lex.pos
    match peek(lex)
    when Option::Some(c) then
      if is_newline(c) then
        advance(lex)
        # Only emit newline if last token isn't already newline
        let should_emit = match lex.tokens.last()
        when Option::Some(t) then
          match t.kind
          when TokenKind::Newline then false
          when _ then true
          end
        when Option::None then true
        end
        if should_emit then
          emit_token(lex, TokenKind::Newline, start)
        end
      elsif is_digit(c) then
        lex_number(lex, start)
      elsif is_ident_start(c) then
        lex_ident(lex, start)
      elsif c == '"' then
        lex_string(lex, start)
      elsif c == '\'' then
        lex_char(lex, start)
      else
        lex_operator_or_delimiter(lex, start, c)
      end
    when Option::None then
      break
    end
  end
  
  emit_token(lex, TokenKind::Eof, lex.pos)
  LexResult { tokens: lex.tokens, errors: lex.errors }
end

# ———————————————————————————————————————————————————————————————
# Operator & Delimiter Lexing
# ———————————————————————————————————————————————————————————————

def lex_operator_or_delimiter(lex: &mut Lexer, start: Int, c: Char) -> Unit
  advance(lex)
  
  match c
  when '(' then emit_token(lex, TokenKind::LParen, start)
  when ')' then emit_token(lex, TokenKind::RParen, start)
  when '[' then emit_token(lex, TokenKind::LBracket, start)
  when ']' then emit_token(lex, TokenKind::RBracket, start)
  when '{' then emit_token(lex, TokenKind::LBrace, start)
  when '}' then emit_token(lex, TokenKind::RBrace, start)
  when ',' then emit_token(lex, TokenKind::Comma, start)
  when ';' then emit_token(lex, TokenKind::Semicolon, start)
  when '?' then emit_token(lex, TokenKind::Question, start)
  when '%' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::PercentEq, start)
    when _ then
      emit_token(lex, TokenKind::Percent, start)
    end
  when '~' then emit_token(lex, TokenKind::Tilde, start)
  when '^' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::CaretEq, start)
    when _ then
      emit_token(lex, TokenKind::Caret, start)
    end
  when '@' then emit_token(lex, TokenKind::At, start)
  when '+' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::PlusEq, start)
    when _ then
      emit_token(lex, TokenKind::Plus, start)
    end
  when '*' then
    match peek(lex)
    when Option::Some('*') then
      advance(lex)
      emit_token(lex, TokenKind::DoubleStar, start)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::StarEq, start)
    when _ then
      emit_token(lex, TokenKind::Star, start)
    end
  when '/' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::SlashEq, start)
    when _ then
      emit_token(lex, TokenKind::Slash, start)
    end
  when ':' then
    match peek(lex)
    when Option::Some(':') then
      advance(lex)
      emit_token(lex, TokenKind::ColonColon, start)
    when _ then
      emit_token(lex, TokenKind::Colon, start)
    end
  when '.' then
    match peek(lex)
    when Option::Some('.') then
      advance(lex)
      match peek(lex)
      when Option::Some('=') then
        advance(lex)
        emit_token(lex, TokenKind::DotDotEq, start)
      when _ then
        emit_token(lex, TokenKind::DotDot, start)
      end
    when _ then
      emit_token(lex, TokenKind::Dot, start)
    end
  when '-' then
    match peek(lex)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::Arrow, start)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::MinusEq, start)
    when _ then
      emit_token(lex, TokenKind::Minus, start)
    end
  when '=' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::EqEq, start)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::FatArrow, start)
    when _ then
      emit_token(lex, TokenKind::Eq, start)
    end
  when '!' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::BangEq, start)
    when _ then
      emit_token(lex, TokenKind::Bang, start)
    end
  when '<' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::LtEq, start)
    when Option::Some('<') then
      advance(lex)
      match peek(lex)
      when Option::Some('=') then
        advance(lex)
        emit_token(lex, TokenKind::ShlEq, start)
      when _ then
        emit_token(lex, TokenKind::Shl, start)
      end
    when _ then
      emit_token(lex, TokenKind::Lt, start)
    end
  when '>' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::GtEq, start)
    when Option::Some('>') then
      advance(lex)
      match peek(lex)
      when Option::Some('=') then
        advance(lex)
        emit_token(lex, TokenKind::ShrEq, start)
      when _ then
        emit_token(lex, TokenKind::Shr, start)
      end
    when _ then
      emit_token(lex, TokenKind::Gt, start)
    end
  when '&' then
    match peek(lex)
    when Option::Some('&') then
      advance(lex)
      emit_token(lex, TokenKind::And, start)
    when Option::Some('m') then
      # Check for &mut (with bounds check)
      if lex.pos + 3 <= lex.source.len() && lex.source.slice(lex.pos, lex.pos + 3) == "mut" then
        let next_pos = lex.pos + 3
        if next_pos >= lex.source.len() || !is_ident_char(lex.source.char_at(next_pos)) then
          lex.pos = next_pos
          emit_token(lex, TokenKind::AmpMut, start)
        else
          emit_token(lex, TokenKind::Amp, start)
        end
      else
        emit_token(lex, TokenKind::Amp, start)
      end
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::AmpEq, start)
    when _ then
      emit_token(lex, TokenKind::Amp, start)
    end
  when '|' then
    match peek(lex)
    when Option::Some('|') then
      advance(lex)
      emit_token(lex, TokenKind::Or, start)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::PipeArrow, start)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::PipeEq, start)
    when _ then
      emit_token(lex, TokenKind::Pipe, start)
    end
  when '#' then
    # Doc comment starts with ##
    match peek(lex)
    when Option::Some('#') then
      advance(lex)  # consume second #
      # Consume optional leading space
      match peek(lex)
      when Option::Some(' ') then advance(lex)
      when _ then ()
      end
      # Collect content until end of line
      mut doc_start = lex.pos
      while !at_end(lex) do
        match peek(lex)
        when Option::Some('\n') then break
        when Option::Some('\r') then break
        when _ then advance(lex)
        end
      end
      let content = lex.source.slice(doc_start, lex.pos)
      emit_token(lex, TokenKind::DocComment(content), start)
    when _ then
      # Regular # should have been handled by skip_whitespace_and_comments
      # but as fallback, skip as line comment
      skip_line_comment(lex)
    end
  when _ then
    emit_error(lex, "unexpected character: '" + c.to_string() + "'", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lex(source: String) -> LexResult
  tokenize(source)
end

def tokenize(source: String) -> LexResult
  mut lex = lexer_new(source)
  tokenize_impl(&mut lex)
end
