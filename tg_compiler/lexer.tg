# ———————————————————————————————————————————————————————————————
# Unicode Source Model — the runtime helpers (the byte/scalar model)
# ———————————————————————————————————————————————————————————————

# Decode the UTF-8 scalar at byte `idx`; returns (scalar, byte length).
# (0, 0) at the end of the input; (U+FFFD, 1) on a malformed tail — the
# entry validation makes the malformed case unreachable during scanning.
def decode_scalar(bytes: Vec[u8], idx: Int) -> (Int, Int)
  if idx >= bytes.len() then
    return (0, 0)
  end
  let b0 = bytes[idx] as Int
  if b0 < 0x80 then
    return (b0, 1)
  end
  if b0 < 0xE0 && idx + 1 < bytes.len() then
    return (((b0 & 0x1F) << 6) | ((bytes[idx + 1] as Int) & 0x3F), 2)
  end
  if b0 < 0xF0 && idx + 2 < bytes.len() then
    return (((b0 & 0x0F) << 12) | (((bytes[idx + 1] as Int) & 0x3F) << 6) | ((bytes[idx + 2] as Int) & 0x3F), 3)
  end
  if idx + 3 < bytes.len() then
    return (((b0 & 0x07) << 18) | (((bytes[idx + 1] as Int) & 0x3F) << 12) | (((bytes[idx + 2] as Int) & 0x3F) << 6) | ((bytes[idx + 3] as Int) & 0x3F), 4)
  end
  (0xFFFD, 1)
end

# The XID classes (UAX31): the ASCII fast path plus the UCD BMP tables.
def is_xid_start_scalar(cp: Int) -> Bool
  (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F || xid_start_range(cp)
end

def is_xid_continue_scalar(cp: Int) -> Bool
  (cp >= 0x30 && cp <= 0x39) || (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F ||
  xid_start_range(cp) || xid_continue_range(cp)
end

# Whether the scalar at byte `idx` starts / continues an identifier.
def ident_start_at(lex: Lexer, idx: Int) -> Bool
  let bytes = lex.source.as_bytes()
  let (cp, _clen) = decode_scalar(bytes, idx)
  is_xid_start_scalar(cp)
end

def ident_char_at(lex: Lexer, idx: Int) -> Bool
  let bytes = lex.source.as_bytes()
  let (cp, _clen) = decode_scalar(bytes, idx)
  is_xid_continue_scalar(cp)
end

# The bidi-control set the lexer REJECTS (the Unicode policy §6.1 Trojan
# Source set): U+202A..U+202E (LRE/RLE/PDF/LRO/RLO) and U+2066..U+2069
# (LRI/RLI/FSI/PDI).
def is_bidi_control(cp: Int) -> Bool
  (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069)
end

# The hex spelling of a scalar for the diagnostics (never padded).
def hex_digits(v: Int) -> String
  mut s = ""
  var x = v
  while x > 0 do
    let d = x % 16
    let ch = if d < 10 then ((('0' as Int) + d) as Char) else ((('A' as Int) + d - 10) as Char) end
    s = ch.to_string() + s
    x = x / 16
  end
  if s.len() == 0 then "0" else s end
end

# ———————————————————————————————————————————————————————————————
# Unicode Source Model — identifier NFC (canonical equivalence)
# ———————————————————————————————————————————————————————————————
# The lexer stores BOTH forms: the token's Ident payload is the NFC form
# (the symbol identity compares normalized spellings); the token's span
# preserves the ORIGINAL bytes (the diagnostics print the original).

# Recursive canonical decomposition (the Hangul syllables are algorithmic;
# the UCD tables cover the BMP pairs and singletons).
def nfc_decompose_into(cp: Int, inout scalars: Vec[Char]) -> Unit
  if cp < 0x80 then
    # the ASCII fast path (the overwhelming case for identifiers)
    scalars.push(cp as Char)
  elsif cp >= 0xAC00 && cp <= 0xD7A3 then
    let s_idx = cp - 0xAC00
    scalars.push((0x1100 + s_idx / 588) as Char)
    scalars.push((0x1161 + (s_idx % 588) / 28) as Char)
    let t = s_idx % 28
    if t != 0 then scalars.push((0x11A7 + t) as Char) end
  else
    match nfc_pair_decompose(cp)
    when Option::Some((a, b)) then
      nfc_decompose_into(a, &mut scalars)
      nfc_decompose_into(b, &mut scalars)
    when Option::None then
      match nfc_singleton_decompose(cp)
      when Option::Some(s) then
        nfc_decompose_into(s, &mut scalars)
      when Option::None then
        scalars.push(cp as Char)
      end
    end
  end
end

# The canonical ordering pass (UAX15): a stable insertion sort of the
# combining marks by their canonical combining class (ascending), never
# moving a mark across a starter.
def nfc_order_marks(inout scalars: Vec[Char]) -> Unit
  let n = scalars.len()
  mut i = 1
  while i < n do
    let ci = nfc_combining_class(scalars[i] as Int)
    if ci > 0 then
      var j = i
      while j > 0 do
        let cj = nfc_combining_class(scalars[j - 1] as Int)
        if cj > 0 && cj > ci then
          let tmp = scalars[j]
          scalars[j] = scalars[j - 1]
          scalars[j - 1] = tmp
          j = j - 1
        else
          break
        end
      end
    end
    i = i + 1
  end
end

# The Hangul syllable composition (algorithmic, UAX15): L+V -> the LV
# syllable, LV+T -> the LVT syllable.
def hangul_compose(a: Int, b: Int) -> Option[Int]
  if a >= 0x1100 && a <= 0x1112 && b >= 0x1161 && b <= 0x1175 then
    return Option::Some(0xAC00 + (a - 0x1100) * 588 + (b - 0x1161) * 28)
  end
  if a >= 0xAC00 && a <= 0xD7A3 && (a - 0xAC00) % 28 == 0 && b >= 0x11A8 && b <= 0x11C2 then
    return Option::Some(a + (b - 0x11A7))
  end
  Option::None
end

# The canonical composition pass (UAX15): per-pair blocking test; a
# non-composing mark stays in the stream and does NOT close the starter
# (a later mark may still compose — the UCD oracle confirmed the exact
# blocking semantics: `last_stayed >= ccc` blocks, otherwise compose).
def nfc_compose_scalars(inout scalars: Vec[Char]) -> Vec[Char]
  mut out = Vec::new()
  var i = 0
  while i < scalars.len() do
    let starter = scalars[i]
    out.push(starter)
    i = i + 1
    mut s = starter
    mut stayed = Vec::new()
    mut last_stayed = 0
    while i < scalars.len() do
      let m = scalars[i]
      let cc = nfc_combining_class(m as Int)
      if cc == 0 then
        match hangul_compose(s as Int, m as Int)
        when Option::Some(c) then
          s = c as Char
          out[out.len() - 1] = s
          i = i + 1
        when Option::None then
          match nfc_pair_compose(s as Int, m as Int)
          when Option::Some(c) then
            s = c as Char
            out[out.len() - 1] = s
            i = i + 1
          when Option::None then
            break
          end
        end
      elsif last_stayed >= cc then
        stayed.push(m)
        last_stayed = cc
        i = i + 1
      else
        match nfc_pair_compose(s as Int, m as Int)
        when Option::Some(c) then
          s = c as Char
          out[out.len() - 1] = s
          i = i + 1
        when Option::None then
          stayed.push(m)
          last_stayed = cc
          i = i + 1
        end
      end
    end
    for st in stayed do
      out.push(st)
    end
  end
  out
end

# NFC(s): canonical decomposition, canonical ordering, canonical
# composition — the identifier identity form.
def identifier_nfc(s: String) -> String
  let bytes = s.as_bytes()
  mut scalars = Vec::new()
  var i = 0
  while i < bytes.len() do
    let (cp, clen) = decode_scalar(bytes, i)
    nfc_decompose_into(cp, &mut scalars)
    i = i + clen
  end
  nfc_order_marks(&mut scalars)
  let composed = nfc_compose_scalars(&mut scalars)
  String::from_chars(composed)
end

# ———————————————————————————————————————————————————————————————
# Unicode Source Model — the entry validation pass
# ———————————————————————————————————————————————————————————————
# Runs BEFORE the tokenization: strict UTF-8 validation (the malformed
# sequences — the overlong C0 AF, the isolated 80, the truncated E2 82 —
# are the hard lexical error with the byte offset), the BOM policy (a
# leading BOM is skipped, a mid-source BOM is rejected), and the bidi
# policy (any bidi control anywhere in the source is the hard
# bidi-security diagnostic). A failed validation yields ZERO tokens (the
# zero-AST outcome) — the errors carry the byte offsets.

def validate_source(inout lex: Lexer) -> Bool
  let bytes = lex.source.as_bytes()
  var i = 0
  if bytes.len() >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF then
    # the leading BOM is accepted and skipped: the first token starts after it
    lex.pos = 3
    i = 3
  end
  while i < bytes.len() do
    let b = bytes[i]
    if b < 0x80 then
      i = i + 1
    else
      let seq_len = utf8_seq_len(b)
      if seq_len == 0 || i + seq_len > bytes.len() || !utf8_seq_valid(bytes, i, seq_len) then
        let span = Span { file: lex.file.clone(), start: i, end_pos: i + 1 }
        lex.errors.push(("invalid UTF-8 byte sequence at byte " + i.to_string(), span))
        return false
      end
      let (cp, clen) = decode_scalar(bytes, i)
      if cp == 0xFEFF then
        let span = Span { file: lex.file.clone(), start: i, end_pos: i + 1 }
        lex.errors.push(("UTF-8 BOM inside the source: a BOM is only permitted at the start of the file", span))
        return false
      end
      if is_bidi_control(cp) then
        let span = Span { file: lex.file.clone(), start: i, end_pos: i + 1 }
        lex.errors.push(("bidirectional override character U+" + hex_digits(cp) + " in the source (the Trojan-Source policy rejects it)", span))
        return false
      end
      i = i + clen
    end
  end
  true
end

# The checked scalar conversion for the \u{...} / \uNNNN escapes: the
# range gate (U+0000..U+10FFFF) and the surrogate gate (U+D800..U+DFFF
# are NOT Unicode scalar values). Emits the hard diagnostic and returns
# None on every failure — never a replacement-character fallback.
def unicode_scalar_checked(inout lex: Lexer, hex: Int, at: Int) -> Option[Char]
  if hex < 0 then
    Option::None
  elsif hex > 0x10FFFF then
    emit_error(lex, "unicode escape out of range: U+" + hex_digits(hex) + " exceeds the maximum scalar U+10FFFF", at)
    Option::None
  elsif hex >= 0xD800 && hex <= 0xDFFF then
    emit_error(lex, "invalid Unicode scalar value: U+" + hex_digits(hex) + " is a surrogate (U+D800..U+DFFF)", at)
    Option::None
  else
    Option::Some(hex as Char)
  end
end

# ———————————————————————————————————————————————————————————————
# Lexer Helpers
# ———————————————————————————————————————————————————————————————

def lex_peek(lex: Lexer) -> Option[Char]
  if lex.pos >= 0 && lex.pos < lex.len then
    Option::Some(lex.source.char_at(lex.pos))
  else
    Option::None
  end
end

def lex_peek_next(lex: Lexer) -> Option[Char]
  let next_pos = lex.pos + 1
  if next_pos >= 0 && next_pos < lex.len then
    Option::Some(lex.source.char_at(next_pos))
  else
    Option::None
  end
end

def lex_advance(inout lex: Lexer) -> Option[Char]
  let c = lex_peek(lex)
  if c.is_some() then
    lex.pos = lex.pos + 1
  end
  c
end

def at_end(lex: Lexer) -> Bool
  lex.pos >= lex.len
end

def emit_token(inout lex: Lexer, kind: TokenKind, start: Int) -> Unit
  let span = Span { file: lex.file.clone(), start: start, end_pos: lex.pos }
  lex.tokens.push(token_new(kind, span))
end

def emit_error(inout lex: Lexer, msg: String, start: Int) -> Unit
  let span = Span { file: lex.file.clone(), start: start, end_pos: lex.pos }
  lex.errors.push((msg, span))
  lex.tokens.push(token_new(TokenKind::Error(msg), span))
end

# ———————————————————————————————————————————————————————————————
# Escape Sequence Helpers
# ———————————————————————————————————————————————————————————————

# Read exactly `count` hex digits and return their value
def read_hex_escape(inout lex: Lexer, count: Int) -> Int
  mut result = 0
  mut i = 0
  while i < count do
    match lex_peek(lex)
    when Option::Some(c) then
      let digit = hex_digit_value(c)
      if digit >= 0 then
        result = result * 16 + digit
        lex_advance(lex)
        i = i + 1
      else
        emit_error(lex, "invalid hex escape: expected hex digit", lex.pos)
        break
      end
    when Option::None then
      emit_error(lex, "unexpected end of file in hex escape", lex.pos)
      break
    end
  end
  result
end

# Read hex digits until delimiter character
def read_hex_until(inout lex: Lexer, delim: Char) -> Int
  mut result = 0
  mut count = 0
  mut had_error = false
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      if c == delim then
        break
      end
      let digit = hex_digit_value(c)
      if digit >= 0 then
        result = result * 16 + digit
        lex_advance(lex)
        count = count + 1
        if count > 6 then
          emit_error(lex, "unicode escape too long (max 6 hex digits)", lex.pos)
          had_error = true
          break
        end
      else
        emit_error(lex, "invalid unicode escape: expected hex digit", lex.pos)
        had_error = true
        break
      end
    when Option::None then
      emit_error(lex, "unexpected end of file in unicode escape", lex.pos)
      had_error = true
      break
    end
  end
  if count == 0 then
    emit_error(lex, "empty unicode escape: \\u{} needs at least one hex digit", lex.pos)
    -1
  else
    if had_error then -1 else result end
  end
end

# Get numeric value of hex digit (-1 if not a hex digit)
def hex_digit_value(c: Char) -> Int
  if c >= '0' && c <= '9' then
    (c as Int) - ('0' as Int)
  elsif c >= 'a' && c <= 'f' then
    (c as Int) - ('a' as Int) + 10
  elsif c >= 'A' && c <= 'F' then
    (c as Int) - ('A' as Int) + 10
  else
    -1
  end
end

# Convert a unicode code point to a character
def char_from_code(code: Int) -> Char
  if code >= 0 && code <= 0x10FFFF then
    code as Char
  else
    '\uFFFD'  # Replacement character
  end
end

# ———————————————————————————————————————————————————————————————
# Whitespace & Comments
# ———————————————————————————————————————————————————————————————

def skip_whitespace(inout lex: Lexer) -> Unit
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      if is_whitespace(c) then
        lex_advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
end

def skip_line_comment(inout lex: Lexer) -> Unit
  # Skip until a line ending: LF, CRLF, or CR alone (the CR is a line ending)
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      if is_newline(c) || c == '\r' then
        break
      else
        lex_advance(lex)
      end
    when Option::None then
      # Advance a single byte to resynchronize if we're mid-UTF-8
      lex.pos = lex.pos + 1
    end
  end
end

def is_doc_comment_start(lex: Lexer, start: Int) -> Bool
  mut idx = start - 1
  while idx >= 0 do
    let c = lex.source.char_at(idx)
    if c == '\n' then
      return true
    elsif c == ' ' || c == '\t' || c == '\r' then
      idx = idx - 1
    else
      return false
    end
  end
  true
end

def skip_block_comment(inout lex: Lexer) -> Unit
  # Skip #|... |# with nesting support
  let start = lex.pos
  mut depth = 1
  while !at_end(lex) && depth > 0 do
    match lex_peek(lex)
    when Option::Some('#') then
      match lex_peek_next(lex)
      when Option::Some('|') then
        lex_advance(lex)
        lex_advance(lex)
        depth = depth + 1
      when _ then
        lex_advance(lex)
      end
    when Option::Some('|') then
      match lex_peek_next(lex)
      when Option::Some('#') then
        lex_advance(lex)
        lex_advance(lex)
        depth = depth - 1
      when _ then
        lex_advance(lex)
      end
    when Option::Some(_) then
      lex_advance(lex)
    when Option::None then
      # At end of source - break to avoid infinite loop
      break
    end
  end
  
  # Check for unterminated block comment
  if depth > 0 then
    emit_error(lex, "unterminated block comment", start)
  end
end

def skip_whitespace_and_comments(inout lex: Lexer) -> Unit
  while !at_end(lex) do
    skip_whitespace(lex)
    if at_end(lex) then break end
    match lex_peek(lex)
    when Option::Some('#') then
      match lex_peek_next(lex)
      when Option::Some('|') then
        # Block comment: #|... |#
        lex_advance(lex)
        lex_advance(lex)
        skip_block_comment(lex)
      when Option::Some('#') then
        # Doc comment: ##... — DON'T skip, will be handled by next_token
        break
      when _ then
        # Line comment: #...
        skip_line_comment(lex)
      end
    when Option::Some('/') then
      match lex_peek_next(lex)
      when Option::Some('/') then
        # // or /// line comment — skip rest of line
        skip_line_comment(lex)
      when _ then
        break
      end
    when _ then
      break
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Number Lexing
# ———————————————————————————————————————————————————————————————

def is_hex_digit(c: Char) -> Bool
  is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
end

def is_binary_digit(c: Char) -> Bool
  c == '0' || c == '1'
end

def is_octal_digit(c: Char) -> Bool
  c >= '0' && c <= '7'
end

# The value of a digit in the given radix (-1 when not a digit of that radix).
def radix_digit_value(radix: UInt, c: Char) -> Int
  let dv = (c as Int) - ('0' as Int)
  if dv >= 0 && dv <= 9 && (dv as UInt) < radix then
    dv
  else
    let lv = if c >= 'a' && c <= 'f' then
        (c as Int) - ('a' as Int) + 10
      elsif c >= 'A' && c <= 'F' then
        (c as Int) - ('A' as Int) + 10
      else
        -1
      end
    if lv >= 0 && (lv as UInt) < radix then lv else -1 end
  end
end

# The ONE lexical diagnostic for every misplaced digit separator (the
# language-grade underscore rule: separators sit only between digits).
def emit_underscore_error(inout lex: Lexer) -> Unit
  emit_error(lex, "invalid digit separator '_': a digit separator must sit between digits", lex.pos)
end

# The optional numeric suffix scan (an alpha run with alphanumeric
# continuation); "" when the next character does not start a suffix. The
# caller validates the text against the literal's class.
def lex_scan_suffix(inout lex: Lexer) -> String
  if at_end(lex) then
    return ""
  end
  match lex_peek(lex)
  when Option::Some(c) then
    if is_alpha(c) then
      let s = lex.pos
      while !at_end(lex) do
        match lex_peek(lex)
        when Option::Some(sc) then
          if is_alpha(sc) || is_digit(sc) then
            lex_advance(lex)
          else
            break
          end
        when Option::None then break
        end
      end
      return lex.source.slice(s, lex.pos)
    else
      return ""
    end
  when Option::None then ""
  end
end

def integer_suffix_valid(s: String) -> Bool
  s == "u" || s == "i" || s == "u8" || s == "u16" || s == "u32" || s == "u64" || s == "u128" ||
  s == "i8" || s == "i16" || s == "i32" || s == "i64" || s == "i128" ||
  s == "usize" || s == "isize"
end

def float_suffix_valid(s: String) -> Bool
  s == "f32" || s == "f64"
end

def digit_text(digits: Vec[u8]) -> String
  mut s = ""
  for d in digits do
    s = s + (((('0' as Int) + (d as Int)) as Char).to_string())
  end
  s
end

def lex_number(inout lex: Lexer, start: Int) -> Unit
  let first_char = lex.source.char_at(start)
  lex_advance(lex)  # consume first digit
  
  if first_char == '0' && !at_end(lex) then
    match lex_peek(lex)
    when Option::Some('x') | Option::Some('X') then
      lex_advance(lex)
      lex_radix_number(lex, start, 16)
      return
    when Option::Some('b') | Option::Some('B') then
      lex_advance(lex)
      lex_radix_number(lex, start, 2)
      return
    when Option::Some('o') | Option::Some('O') then
      lex_advance(lex)
      lex_radix_number(lex, start, 8)
      return
    when _ then ()
    end
  end
  
  # Decimal literal — the integer digits are collected into the magnitude
  # vector (arbitrary precision; NEVER converted to the host Int here).
  # The digit separators are language-grade: only between digits.
  mut int_digits = Vec::new()
  int_digits.push((first_char as Int - '0' as Int) as u8)
  mut prev_was_digit = true
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      if is_digit(c) then
        int_digits.push((c as Int - '0' as Int) as u8)
        lex_advance(lex)
        prev_was_digit = true
      elsif c == '_' then
        if !prev_was_digit then
          emit_underscore_error(lex)
          return
        end
        lex_advance(lex)
        prev_was_digit = false
      else
        break
      end
    when Option::None then
      break
    end
  end
  if !prev_was_digit then
    emit_underscore_error(lex)
    return
  end
  
  # Fractional part: a '.' must be followed by a digit.
  mut is_float = false
  mut frac_digits = Vec::new()
  match lex_peek(lex)
  when Option::Some('.') then
    match lex_peek_next(lex)
    when Option::Some(c) then
      if is_digit(c) then
        lex_advance(lex)
        is_float = true
        mut fprev = true
        while !at_end(lex) do
          match lex_peek(lex)
          when Option::Some(c2) then
            if is_digit(c2) then
              frac_digits.push((c2 as Int - '0' as Int) as u8)
              lex_advance(lex)
              fprev = true
            elsif c2 == '_' then
              if !fprev then
                emit_underscore_error(lex)
                return
              end
              lex_advance(lex)
              fprev = false
            else
              break
            end
          when Option::None then
            break
          end
        end
        if !fprev then
          emit_underscore_error(lex)
          return
        end
      end
    when Option::None then
      ()
    end
  when _ then
    ()
  end
  
  # Exponent part: e/E, an optional sign, then at least one digit (the
  # malformed 1e / 1e+ forms are REJECTED here — never a silent fallback).
  mut exp_text = ""
  mut has_exponent = false
  match lex_peek(lex)
  when Option::Some('e') | Option::Some('E') then
    is_float = true
    has_exponent = true
    lex_advance(lex)
    match lex_peek(lex)
    when Option::Some('+') then
      exp_text = exp_text + "+"
      lex_advance(lex)
    when Option::Some('-') then
      exp_text = exp_text + "-"
      lex_advance(lex)
    when _ then ()
    end
    mut exp_has_digits = false
    mut exp_prev = false
    while !at_end(lex) do
      match lex_peek(lex)
      when Option::Some(c) then
        if is_digit(c) then
          exp_text = exp_text + c.to_string()
          lex_advance(lex)
          exp_has_digits = true
          exp_prev = true
        elsif c == '_' then
          if !exp_prev then
            emit_underscore_error(lex)
            return
          end
          lex_advance(lex)
          exp_prev = false
        else
          break
        end
      when Option::None then
        break
      end
    end
    if !exp_has_digits then
      emit_error(lex, "expected digits after exponent", start)
      return
    end
    if !exp_prev then
      emit_underscore_error(lex)
      return
    end
  when _ then ()
  end
  
  # Optional suffix — carried as the literal's explicit_suffix field
  # (never dropped); validated against the literal's class.
  let suffix_text = lex_scan_suffix(lex)
  let float_suffix_on_int = !is_float && !suffix_text.is_empty() && float_suffix_valid(suffix_text)
  if !suffix_text.is_empty() && !float_suffix_on_int then
    if is_float then
      if !float_suffix_valid(suffix_text) then
        emit_error(lex, "invalid numeric suffix '" + suffix_text + "'", start)
        return
      end
    else
      if !integer_suffix_valid(suffix_text) then
        emit_error(lex, "invalid numeric suffix '" + suffix_text + "'", start)
        return
      end
    end
  end
  let suffix_opt = if suffix_text.is_empty() then Option::None else Option::Some(suffix_text.clone()) end
  let span = Span { file: lex.file.clone(), start: start, end_pos: lex.pos }
  
  # An integer spelling with a float suffix (1f32) IS a float literal.
  if float_suffix_on_int then
    let int_text = digit_text(int_digits)
    emit_token(lex, TokenKind::FloatLit(ParsedFloatLiteral {
      significand: int_text,
      exponent: "",
      has_exponent: false,
      explicit_suffix: suffix_opt,
      source_span: span,
      value: parsed_float_value_of(int_text, "")
    }), start)
    return
  end
  
  if is_float then
    # The significand/exponent STRINGS are preserved (the exact value) until
    # the type checker decides the range; the host f64 value is computed
    # from the strings (the runtime parse_float has no exponent support) —
    # never a fabricated 0.0 fallback.
    let sig_text = digit_text(int_digits) + (if frac_digits.len() > 0 then "." + digit_text(frac_digits) else "" end)
    emit_token(lex, TokenKind::FloatLit(ParsedFloatLiteral {
      significand: sig_text,
      exponent: exp_text,
      has_exponent: has_exponent,
      explicit_suffix: suffix_opt,
      source_span: span,
      value: parsed_float_value_of(sig_text, exp_text)
    }), start)
  else
    emit_token(lex, TokenKind::IntLit(ParsedIntegerLiteral {
      sign: 1,
      radix: 10,
      magnitude: int_digits,
      explicit_suffix: suffix_opt,
      source_span: span
    }), start)
  end
end

# The shared radix (hex/binary/octal) scanner: the digits are collected
# into the magnitude vector (arbitrary precision — no host accumulation),
# the separators are language-grade, the optional integer suffix is
# carried in the literal's explicit_suffix field.
def lex_radix_number(inout lex: Lexer, start: Int, radix: UInt) -> Unit
  mut mag = Vec::new()
  mut prev_was_digit = false
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      let dv = radix_digit_value(radix, c)
      if dv >= 0 then
        mag.push(dv as u8)
        lex_advance(lex)
        prev_was_digit = true
      elsif c == '_' then
        if !prev_was_digit then
          emit_underscore_error(lex)
          return
        end
        lex_advance(lex)
        prev_was_digit = false
      else
        break
      end
    when Option::None then
      break
    end
  end
  if mag.len() == 0 then
    let radix_name = if radix == 16 then "hex" elsif radix == 2 then "binary" else "octal" end
    let prefix = if radix == 16 then "0x" elsif radix == 2 then "0b" else "0o" end
    emit_error(lex, "expected " + radix_name + " digits after " + prefix, start)
    return
  end
  if !prev_was_digit then
    emit_underscore_error(lex)
    return
  end
  let suffix_text = lex_scan_suffix(lex)
  if !suffix_text.is_empty() && !integer_suffix_valid(suffix_text) then
    emit_error(lex, "invalid numeric suffix '" + suffix_text + "'", start)
    return
  end
  let suffix_opt = if suffix_text.is_empty() then Option::None else Option::Some(suffix_text.clone()) end
  let span = Span { file: lex.file.clone(), start: start, end_pos: lex.pos }
  emit_token(lex, TokenKind::IntLit(ParsedIntegerLiteral {
    sign: 1,
    radix: radix,
    magnitude: mag,
    explicit_suffix: suffix_opt,
    source_span: span
  }), start)
end

# ———————————————————————————————————————————————————————————————
# String Lexing
# ———————————————————————————————————————————————————————————————

def lex_string(inout lex: Lexer, start: Int) -> Unit
  lex_advance(lex)  # consume opening quote
  mut content = ""
  mut run_start = lex.pos  # start of current literal-text run
  
  while !at_end(lex) do
    match lex_peek(lex)
    when Option::Some(c) then
      if c == '\\' then
        # Flush current run of literal characters in one slice
        if lex.pos > run_start then
          content = content + lex.source.slice(run_start, lex.pos)
        end
        lex_advance(lex)  # consume backslash
        match lex_peek(lex)
        when Option::Some(esc) then
          mut should_advance = true
          match esc
          when 'n' then content = content + "\n"
          when 't' then content = content + "\t"
          when 'r' then content = content + "\r"
          when '0' then content = content + "\0"
          when '\\' then content = content + "\\"
          when '"' then content = content + "\""
          when '\'' then content = content + "\'"
          when 'x' then
            # Hex escape: \xNN
            lex_advance(lex)  # consume 'x'
            let hex = read_hex_escape(lex, 2)
            content = content + char_from_code(hex).to_string()
            should_advance = false
          when 'u' then
            # Unicode escape: \u{NNNN}
            lex_advance(lex)  # consume 'u'
            if lex_peek(lex) == Option::Some('{') then
              lex_advance(lex)  # consume '{'
              let hex = read_hex_until(lex, '}')
              if lex_peek(lex) == Option::Some('}') then
                lex_advance(lex)  # consume '}'
              else
                emit_error(lex, "invalid unicode escape, missing closing '}'", lex.pos)
              end
              # the scalar gates: the surrogate range is a hard error
              match unicode_scalar_checked(lex, hex, lex.pos)
              when Option::Some(sc) then
                content = content + sc.to_string()
              when Option::None then ()
              end
              should_advance = false
            else
              emit_error(lex, "invalid unicode escape, expected \\u{...}", lex.pos)
            end
          when c2 then
            emit_error(lex, "unknown escape sequence: \\" + c2.to_string(), lex.pos - 1)
            content = content + c2.to_string()
          end
          if should_advance then
            lex_advance(lex)
          end
        when Option::None then break
        end
        run_start = lex.pos  # next run starts after escape
      elsif c == '"' then
        # Flush remaining literal run and finish
        if lex.pos > run_start then
          content = content + lex.source.slice(run_start, lex.pos)
        end
        lex_advance(lex)  # consume closing quote
        emit_token(lex, TokenKind::StringLit(content), start)
        return
      else
        lex_advance(lex)  # stay in current run, just advance
      end
    when Option::None then
      break
    end
  end
  
  # Flush any remaining content
  if lex.pos > run_start then
    content = content + lex.source.slice(run_start, lex.pos)
  end
  emit_error(lex, "unterminated string literal", start)
end

# ———————————————————————————————————————————————————————————————
# Character Lexing
# ———————————————————————————————————————————————————————————————

def lex_char(inout lex: Lexer, start: Int) -> Unit
  lex_advance(lex)  # consume opening quote
  
  match lex_peek(lex)
  when Option::Some('\\') then
    lex_advance(lex)
    match lex_peek(lex)
    when Option::Some(c) then
      let mut ch = '\0'
      mut need_advance = true
      mut valid = true
      match c
      when 'n' then ch = '\n'
      when 't' then ch = '\t'
      when 'r' then ch = '\r'
      when '0' then ch = '\0'
      when '\\' then ch = '\\'
      when '\'' then ch = '\''
      when 'x' then
        lex_advance(lex)  # consume 'x'
        let hex = read_hex_escape(lex, 2)
        ch = char_from_code(hex)
        need_advance = false
      when 'u' then
        lex_advance(lex)  # consume 'u'
        if lex_peek(lex) == Option::Some('{') then
          lex_advance(lex)  # consume '{'
          let hex = read_hex_until(lex, '}')
          if lex_peek(lex) == Option::Some('}') then
            lex_advance(lex)  # consume '}'
          else
            emit_error(lex, "invalid unicode escape, missing closing '}'", start)
          end
          # the scalar gates: \u{D800} is the hard invalid-scalar
          # diagnostic; \u{10FFFF} is valid; \u{110000} and \u{} are
          # rejected — no CharLit token is produced on any failure.
          match unicode_scalar_checked(lex, hex, start)
          when Option::Some(sc) then
            ch = sc
          when Option::None then
            valid = false
          end
        else
          # \uNNNN — exactly 4 hex digits (the surrogate gate applies)
          let hex = read_hex_escape(lex, 4)
          match unicode_scalar_checked(lex, hex, start)
          when Option::Some(sc) then
            ch = sc
          when Option::None then
            valid = false
          end
        end
        need_advance = false
      when c2 then
        emit_error(lex, "unknown escape sequence: \\" + c2.to_string(), start)
        ch = c2
      end
      if need_advance then
        lex_advance(lex)
      end
      match lex_peek(lex)
      when Option::Some('\'') then
        lex_advance(lex)
        if valid then
          emit_token(lex, TokenKind::CharLit(ch), start)
        end
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    when Option::None then
      emit_error(lex, "unterminated character literal", start)
    end
  when Option::Some(c) then
    if c != '\'' then
      # the literal character is the full UTF-8 scalar (the byte-wise
      # char_at can only see its first byte)
      let bytes = lex.source.as_bytes()
      let (cp, clen) = decode_scalar(bytes, lex.pos)
      lex.pos = lex.pos + clen
      match lex_peek(lex)
      when Option::Some('\'') then
        lex_advance(lex)
        emit_token(lex, TokenKind::CharLit(cp as Char), start)
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    else
      emit_error(lex, "empty character literal", start)
    end
  when Option::None then
    emit_error(lex, "unterminated character literal", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Identifier / Keyword Lexing
# ———————————————————————————————————————————————————————————————

def lex_ident(inout lex: Lexer, start: Int) -> Unit
  # The XID_Continue scan over the UTF-8 scalars (the first scalar is
  # already verified XID_Start by the dispatch).
  let bytes = lex.source.as_bytes()
  var pos = start
  while pos < lex.len do
    let (cp, clen) = decode_scalar(bytes, pos)
    if is_xid_continue_scalar(cp) then
      pos = pos + clen
    else
      break
    end
  end
  lex.pos = pos

  let text = lex.source.slice(start, pos)
  # The identifier identity is the NFC-normalized form (the original
  # spelling stays available through the token's span — the diagnostics
  # print the original bytes). The keywords are pure ASCII, so the
  # keyword check is unaffected by the normalization.
  let norm = identifier_nfc(text)
  match keyword_from_str(text)
  when Option::Some(kw) then
    emit_token(lex, kw, start)
  when Option::None then
    emit_token(lex, TokenKind::Ident(norm), start)
  end
end

# ———————————————————————————————————————————————————————————————
# Main Tokenize Loop
# ———————————————————————————————————————————————————————————————

def tokenize_impl(inout lex: Lexer) -> LexResult
  while !at_end(lex) do
    skip_whitespace_and_comments(lex)
    if at_end(lex) then break end
    
    let start = lex.pos
    match lex_peek(lex)
    when Option::Some(c) then
      if is_newline(c) || c == '\r' then
        # LF -> line+1; CRLF -> line+1 (one Newline token, both bytes);
        # CR alone -> line+1 (the CR is a line ending, not whitespace)
        lex_advance(lex)
        if c == '\r' && lex_peek(lex) == Option::Some('\n') then
          lex_advance(lex)
        end
        emit_token(lex, TokenKind::Newline, start)
      elsif is_digit(c) then
        lex_number(lex, start)
      elsif ident_start_at(lex, start) then
        lex_ident(lex, start)
      elsif c == '"' then
        lex_string(lex, start)
      elsif c == '\'' then
        lex_char(lex, start)
      else
        lex_operator_or_delimiter(lex, start, c)
      end
    when Option::None then
      break
    end
  end
  
  emit_token(lex, TokenKind::Eof, lex.pos)
  LexResult { tokens: lex.tokens, errors: lex.errors }
end

# ———————————————————————————————————————————————————————————————
# Operator & Delimiter Lexing
# ———————————————————————————————————————————————————————————————

def lex_operator_or_delimiter(inout lex: Lexer, start: Int, c: Char) -> Unit
  lex_advance(lex)
  
  match c
  when '(' then emit_token(lex, TokenKind::LParen, start)
  when ')' then emit_token(lex, TokenKind::RParen, start)
  when '[' then emit_token(lex, TokenKind::LBracket, start)
  when ']' then emit_token(lex, TokenKind::RBracket, start)
  when '{' then emit_token(lex, TokenKind::LBrace, start)
  when '}' then emit_token(lex, TokenKind::RBrace, start)
  when ',' then emit_token(lex, TokenKind::Comma, start)
  when ';' then emit_token(lex, TokenKind::Semicolon, start)
  when '?' then emit_token(lex, TokenKind::Question, start)
  when '%' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::PercentEq, start)
    when _ then
      emit_token(lex, TokenKind::Percent, start)
    end
  when '~' then emit_token(lex, TokenKind::Tilde, start)
  when '^' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::CaretEq, start)
    when _ then
      emit_token(lex, TokenKind::Caret, start)
    end
  when '@' then emit_token(lex, TokenKind::At, start)
  when '+' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::PlusEq, start)
    when _ then
      emit_token(lex, TokenKind::Plus, start)
    end
  when '*' then
    match lex_peek(lex)
    when Option::Some('*') then
      lex_advance(lex)
      emit_token(lex, TokenKind::DoubleStar, start)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::StarEq, start)
    when _ then
      emit_token(lex, TokenKind::Star, start)
    end
  when '/' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::SlashEq, start)
    when _ then
      emit_token(lex, TokenKind::Slash, start)
    end
  when ':' then
    match lex_peek(lex)
    when Option::Some(':') then
      lex_advance(lex)
      emit_token(lex, TokenKind::ColonColon, start)
    when _ then
      emit_token(lex, TokenKind::Colon, start)
    end
  when '.' then
    match lex_peek(lex)
    when Option::Some('.') then
      lex_advance(lex)
      match lex_peek(lex)
      when Option::Some('=') then
        lex_advance(lex)
        emit_token(lex, TokenKind::DotDotEq, start)
      when _ then
        emit_token(lex, TokenKind::DotDot, start)
      end
    when _ then
      emit_token(lex, TokenKind::Dot, start)
    end
  when '-' then
    match lex_peek(lex)
    when Option::Some('>') then
      lex_advance(lex)
      emit_token(lex, TokenKind::Arrow, start)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::MinusEq, start)
    when _ then
      emit_token(lex, TokenKind::Minus, start)
    end
  when '=' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::EqEq, start)
    when Option::Some('>') then
      lex_advance(lex)
      emit_token(lex, TokenKind::FatArrow, start)
    when _ then
      emit_token(lex, TokenKind::Eq, start)
    end
  when '!' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::BangEq, start)
    when _ then
      emit_token(lex, TokenKind::Bang, start)
    end
  when '<' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::LtEq, start)
    when Option::Some('<') then
      lex_advance(lex)
      match lex_peek(lex)
      when Option::Some('=') then
        lex_advance(lex)
        emit_token(lex, TokenKind::ShlEq, start)
      when _ then
        emit_token(lex, TokenKind::Shl, start)
      end
    when _ then
      emit_token(lex, TokenKind::Lt, start)
    end
  when '>' then
    match lex_peek(lex)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::GtEq, start)
    when Option::Some('>') then
      lex_advance(lex)
      match lex_peek(lex)
      when Option::Some('=') then
        lex_advance(lex)
        emit_token(lex, TokenKind::ShrEq, start)
      when _ then
        emit_token(lex, TokenKind::Shr, start)
      end
    when _ then
      emit_token(lex, TokenKind::Gt, start)
    end
  when '&' then
    match lex_peek(lex)
    when Option::Some('&') then
      lex_advance(lex)
      emit_token(lex, TokenKind::And, start)
    when Option::Some('m') then
      # Check for &mut (with bounds check)
      if lex.pos + 3 <= lex.source.len() && lex.source.slice(lex.pos, lex.pos + 3) == "mut" then
        let next_pos = lex.pos + 3
        if next_pos >= lex.source.len() || !ident_char_at(lex, next_pos) then
          lex.pos = next_pos
          emit_token(lex, TokenKind::AmpMut, start)
        else
          emit_token(lex, TokenKind::Amp, start)
        end
      else
        emit_token(lex, TokenKind::Amp, start)
      end
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::AmpEq, start)
    when _ then
      emit_token(lex, TokenKind::Amp, start)
    end
  when '|' then
    match lex_peek(lex)
    when Option::Some('|') then
      lex_advance(lex)
      emit_token(lex, TokenKind::Or, start)
    when Option::Some('>') then
      lex_advance(lex)
      emit_token(lex, TokenKind::PipeArrow, start)
    when Option::Some('=') then
      lex_advance(lex)
      emit_token(lex, TokenKind::PipeEq, start)
    when _ then
      emit_token(lex, TokenKind::Pipe, start)
    end
  when '#' then
    # Doc comment starts with ##
    match lex_peek(lex)
    when Option::Some('#') then
      if is_doc_comment_start(lex, start) then
        lex_advance(lex)  # consume second #
        # Consume optional leading space
        match lex_peek(lex)
        when Option::Some(' ') then
          let _ = lex_advance(lex)
        when _ then ()
        end
        # Collect content until end of line
        mut doc_start = lex.pos
        while !at_end(lex) do
          match lex_peek(lex)
          when Option::Some('\n') then break
          when Option::Some('\r') then break
          when _ then
            let _ = lex_advance(lex)
          end
        end
        let content = lex.source.slice(doc_start, lex.pos)
        emit_token(lex, TokenKind::DocComment(content), start)
      else
        skip_line_comment(lex)
      end
    when _ then
      # Regular # should have been handled by skip_whitespace_and_comments
      # but as fallback, skip as line comment
      skip_line_comment(lex)
    end
  when _ then
    emit_error(lex, "unexpected character: '" + c.to_string() + "'", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lex(source: String) -> LexResult
  tokenize(source, "")
end

def tokenize(source: String, file: String) -> LexResult
  mut lex = lexer_new(source, file)
  # The entry validation pass: the source bytes are validated BEFORE the
  # tokenization — strict UTF-8, the BOM policy, the bidi policy. On the
  # failure the result is the hard lexical error with the byte offset and
  # ZERO tokens (the zero-AST outcome).
  if !validate_source(&mut lex) then
    return LexResult { tokens: Vec::new(), errors: lex.errors }
  end
  let result = tokenize_impl(&mut lex)
  result
end
