# Canonical Combining Classes (BMP marks with CCC > 0): 708 entries
def nfc_combining_class(cp: Int) -> Int
  if cp == 0x0300 then return 230 end
  if cp == 0x0301 then return 230 end
  if cp == 0x0302 then return 230 end
  if cp == 0x0303 then return 230 end
  if cp == 0x0304 then return 230 end
  if cp == 0x0305 then return 230 end
  if cp == 0x0306 then return 230 end
  if cp == 0x0307 then return 230 end
  if cp == 0x0308 then return 230 end
  if cp == 0x0309 then return 230 end
  if cp == 0x030A then return 230 end
  if cp == 0x030B then return 230 end
