# Tangerine Compiler — Lexer
# Self-hosting compiler written in Tangerine
#
# Tokenizes .tg source files with full error recovery.
# Produces Token stream for the parser.

use std::core::{Option, Result, panic}
use std::collections::{Vec}
use tg_compiler::token::{Span, Token, TokenKind, token_new, span_new, keyword_from_str}

# ———————————————————————————————————————————————————————————————
# Lexer State
# ———————————————————————————————————————————————————————————————

struct Lexer
  source: String
  pos: Int
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

struct LexResult
  tokens: Vec[Token]
  errors: Vec[(String, Span)]
end

# ———————————————————————————————————————————————————————————————
# Lexer Creation
# ———————————————————————————————————————————————————————————————

def lexer_new(source: String) -> Lexer
  Lexer {
    source: source,
    pos: 0,
    tokens: Vec::new(),
    errors: Vec::new()
  }
end

# ———————————————————————————————————————————————————————————————
# Character Utilities
# ———————————————————————————————————————————————————————————————

def char_at(s: String, idx: Int) -> Option[Char]
  if idx >= 0 && idx < s.len() then
    Option::Some(s.char_at(idx))
  else
    Option::None
  end
end

def is_whitespace(c: Char) -> Bool
  c == ' ' || c == '\t' || c == '\r'
end

def is_newline(c: Char) -> Bool
  c == '\n'
end

def is_digit(c: Char) -> Bool
  c >= '0' && c <= '9'
end

def is_alpha(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
end

def is_ident_start(c: Char) -> Bool
  is_alpha(c) || c == '_'
end

def is_ident_char(c: Char) -> Bool
  is_alpha(c) || is_digit(c) || c == '_'
end

# ———————————————————————————————————————————————————————————————
# Lexer Helpers
# ———————————————————————————————————————————————————————————————

def peek(lex: &Lexer) -> Option[Char]
  char_at(lex.source, lex.pos)
end

def peek_next(lex: &Lexer) -> Option[Char]
  char_at(lex.source, lex.pos + 1)
end

def advance(lex: &mut Lexer) -> Option[Char]
  let c = peek(lex)
  if c.is_some() then
    lex.pos = lex.pos + 1
  end
  c
end

def at_end(lex: &Lexer) -> Bool
  lex.pos >= lex.source.len()
end

def emit_token(lex: &mut Lexer, kind: TokenKind, start: Int) -> Unit
  let span = span_new(start, lex.pos)
  lex.tokens.push(token_new(kind, span))
end

def emit_error(lex: &mut Lexer, msg: String, start: Int) -> Unit
  let span = span_new(start, lex.pos)
  lex.errors.push((msg, span))
  lex.tokens.push(token_new(TokenKind::Error(msg), span))
end

# ———————————————————————————————————————————————————————————————
# Whitespace & Comments
# ———————————————————————————————————————————————————————————————

def skip_whitespace(lex: &mut Lexer) -> Unit
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_whitespace(c) then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
end

def skip_line_comment(lex: &mut Lexer) -> Unit
  # Skip until newline
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_newline(c) then
        break
      else
        advance(lex)
      end
    when Option::None then
      break
    end
  end
end

def skip_block_comment(lex: &mut Lexer) -> Unit
  # Skip #| ... |# with nesting support
  mut depth = 1
  while !at_end(lex) && depth > 0 do
    match peek(lex)
    when Option::Some('#') then
      match peek_next(lex)
      when Option::Some('|') then
        advance(lex)
        advance(lex)
        depth = depth + 1
      when _ then
        advance(lex)
      end
    when Option::Some('|') then
      match peek_next(lex)
      when Option::Some('#') then
        advance(lex)
        advance(lex)
        depth = depth - 1
      when _ then
        advance(lex)
      end
    when _ then
      advance(lex)
    end
  end
end

def skip_whitespace_and_comments(lex: &mut Lexer) -> Unit
  while !at_end(lex) do
    skip_whitespace(lex)
    if at_end(lex) then break end
    
    match peek(lex)
    when Option::Some('#') then
      match peek_next(lex)
      when Option::Some('|') then
        # Block comment: #| ... |#
        advance(lex)
        advance(lex)
        skip_block_comment(lex)
      when _ then
        # Line comment: # ...
        skip_line_comment(lex)
      end
    when _ then
      break
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Number Lexing
# ———————————————————————————————————————————————————————————————

def lex_number(lex: &mut Lexer, start: Int) -> Unit
  # Consume integer part
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_digit(c) then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
  
  # Check for decimal point
  mut is_float = false
  match peek(lex)
  when Option::Some('.') then
    match peek_next(lex)
    when Option::Some(c) then
      if is_digit(c) then
        advance(lex)  # consume '.'
        is_float = true
        while !at_end(lex) do
          match peek(lex)
          when Option::Some(c2) then
            if is_digit(c2) then
              advance(lex)
            else
              break
            end
          when Option::None then
            break
          end
        end
      end
    when Option::None then
      ()
    end
  when _ then
    ()
  end
  
  let text = lex.source.slice(start, lex.pos)
  if is_float then
    let val = text.parse_float()
    emit_token(lex, TokenKind::FloatLit(val), start)
  else
    let val = text.parse_int()
    emit_token(lex, TokenKind::IntLit(val), start)
  end
end

# ———————————————————————————————————————————————————————————————
# String Lexing
# ———————————————————————————————————————————————————————————————

def lex_string(lex: &mut Lexer, start: Int) -> Unit
  advance(lex)  # consume opening quote
  mut content = ""
  mut escaped = false
  
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if escaped then
        match c
        when 'n' then content = content + "\n"
        when 't' then content = content + "\t"
        when 'r' then content = content + "\r"
        when '\\' then content = content + "\\"
        when '"' then content = content + "\""
        when c2 then content = content + c2.to_string()
        end
        escaped = false
        advance(lex)
      elsif c == '\\' then
        escaped = true
        advance(lex)
      elsif c == '"' then
        advance(lex)  # consume closing quote
        emit_token(lex, TokenKind::StringLit(content), start)
        return
      elsif is_newline(c) then
        emit_error(lex, "unterminated string literal", start)
        return
      else
        content = content + c.to_string()
        advance(lex)
      end
    when Option::None then
      break
    end
  end
  
  emit_error(lex, "unterminated string literal", start)
end

# ———————————————————————————————————————————————————————————————
# Character Lexing
# ———————————————————————————————————————————————————————————————

def lex_char(lex: &mut Lexer, start: Int) -> Unit
  advance(lex)  # consume opening quote
  
  match peek(lex)
  when Option::Some('\\') then
    advance(lex)
    match peek(lex)
    when Option::Some(c) then
      let ch = match c
      when 'n' then '\n'
      when 't' then '\t'
      when 'r' then '\r'
      when '\\' then '\\'
      when '\'' then '\''
      when c2 then c2
      end
      advance(lex)
      match peek(lex)
      when Option::Some('\'') then
        advance(lex)
        emit_token(lex, TokenKind::CharLit(ch), start)
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    when Option::None then
      emit_error(lex, "unterminated character literal", start)
    end
  when Option::Some(c) then
    if c != '\'' then
      advance(lex)
      match peek(lex)
      when Option::Some('\'') then
        advance(lex)
        emit_token(lex, TokenKind::CharLit(c), start)
      when _ then
        emit_error(lex, "unterminated character literal", start)
      end
    else
      emit_error(lex, "empty character literal", start)
    end
  when Option::None then
    emit_error(lex, "unterminated character literal", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Identifier / Keyword Lexing
# ———————————————————————————————————————————————————————————————

def lex_ident(lex: &mut Lexer, start: Int) -> Unit
  while !at_end(lex) do
    match peek(lex)
    when Option::Some(c) then
      if is_ident_char(c) then
        advance(lex)
      else
        break
      end
    when Option::None then
      break
    end
  end
  
  let text = lex.source.slice(start, lex.pos)
  match keyword_from_str(text)
  when Option::Some(kw) then
    emit_token(lex, kw, start)
  when Option::None then
    emit_token(lex, TokenKind::Ident(text), start)
  end
end

# ———————————————————————————————————————————————————————————————
# Main Tokenize Loop
# ———————————————————————————————————————————————————————————————

def tokenize(lex: &mut Lexer) -> LexResult
  while !at_end(lex) do
    skip_whitespace_and_comments(lex)
    if at_end(lex) then break end
    
    let start = lex.pos
    match peek(lex)
    when Option::Some(c) then
      if is_newline(c) then
        advance(lex)
        # Only emit newline if last token isn't already newline
        let should_emit = match lex.tokens.last()
        when Option::Some(t) then
          match t.kind
          when TokenKind::Newline then false
          when _ then true
          end
        when Option::None then true
        end
        if should_emit then
          emit_token(lex, TokenKind::Newline, start)
        end
      elsif is_digit(c) then
        lex_number(lex, start)
      elsif is_ident_start(c) then
        lex_ident(lex, start)
      elsif c == '"' then
        lex_string(lex, start)
      elsif c == '\'' then
        lex_char(lex, start)
      else
        lex_operator_or_delimiter(lex, start, c)
      end
    when Option::None then
      break
    end
  end
  
  emit_token(lex, TokenKind::Eof, lex.pos)
  LexResult { tokens: lex.tokens, errors: lex.errors }
end

# ———————————————————————————————————————————————————————————————
# Operator & Delimiter Lexing
# ———————————————————————————————————————————————————————————————

def lex_operator_or_delimiter(lex: &mut Lexer, start: Int, c: Char) -> Unit
  advance(lex)
  
  match c
  when '(' then emit_token(lex, TokenKind::LParen, start)
  when ')' then emit_token(lex, TokenKind::RParen, start)
  when '[' then emit_token(lex, TokenKind::LBracket, start)
  when ']' then emit_token(lex, TokenKind::RBracket, start)
  when '{' then emit_token(lex, TokenKind::LBrace, start)
  when '}' then emit_token(lex, TokenKind::RBrace, start)
  when ',' then emit_token(lex, TokenKind::Comma, start)
  when ';' then emit_token(lex, TokenKind::Semicolon, start)
  when '?' then emit_token(lex, TokenKind::Question, start)
  when '%' then emit_token(lex, TokenKind::Percent, start)
  when '~' then emit_token(lex, TokenKind::Tilde, start)
  when '^' then emit_token(lex, TokenKind::Caret, start)
  when '@' then emit_token(lex, TokenKind::At, start)
  when '+' then emit_token(lex, TokenKind::Plus, start)
  when '*' then
    match peek(lex)
    when Option::Some('*') then
      advance(lex)
      emit_token(lex, TokenKind::DoubleStar, start)
    when _ then
      emit_token(lex, TokenKind::Star, start)
    end
  when '/' then emit_token(lex, TokenKind::Slash, start)
  when ':' then
    match peek(lex)
    when Option::Some(':') then
      advance(lex)
      emit_token(lex, TokenKind::ColonColon, start)
    when _ then
      emit_token(lex, TokenKind::Colon, start)
    end
  when '.' then
    match peek(lex)
    when Option::Some('.') then
      advance(lex)
      match peek(lex)
      when Option::Some('=') then
        advance(lex)
        emit_token(lex, TokenKind::DotDotEq, start)
      when _ then
        emit_token(lex, TokenKind::DotDot, start)
      end
    when _ then
      emit_token(lex, TokenKind::Dot, start)
    end
  when '-' then
    match peek(lex)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::Arrow, start)
    when _ then
      emit_token(lex, TokenKind::Minus, start)
    end
  when '=' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::EqEq, start)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::FatArrow, start)
    when _ then
      emit_token(lex, TokenKind::Eq, start)
    end
  when '!' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::BangEq, start)
    when _ then
      emit_token(lex, TokenKind::Bang, start)
    end
  when '<' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::LtEq, start)
    when _ then
      emit_token(lex, TokenKind::Lt, start)
    end
  when '>' then
    match peek(lex)
    when Option::Some('=') then
      advance(lex)
      emit_token(lex, TokenKind::GtEq, start)
    when _ then
      emit_token(lex, TokenKind::Gt, start)
    end
  when '&' then
    match peek(lex)
    when Option::Some('&') then
      advance(lex)
      emit_token(lex, TokenKind::And, start)
    when Option::Some('m') then
      # Check for &mut
      if lex.source.slice(lex.pos, lex.pos + 3) == "mut" then
        let next_pos = lex.pos + 3
        if next_pos >= lex.source.len() || !is_ident_char(lex.source.char_at(next_pos)) then
          lex.pos = next_pos
          emit_token(lex, TokenKind::AmpMut, start)
        else
          emit_token(lex, TokenKind::Amp, start)
        end
      else
        emit_token(lex, TokenKind::Amp, start)
      end
    when _ then
      emit_token(lex, TokenKind::Amp, start)
    end
  when '|' then
    match peek(lex)
    when Option::Some('|') then
      advance(lex)
      emit_token(lex, TokenKind::Or, start)
    when Option::Some('>') then
      advance(lex)
      emit_token(lex, TokenKind::PipeArrow, start)
    when _ then
      emit_token(lex, TokenKind::Pipe, start)
    end
  when _ then
    emit_error(lex, "unexpected character: '" + c.to_string() + "'", start)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lex(source: String) -> LexResult
  mut lex = lexer_new(source)
  tokenize(&mut lex)
end
