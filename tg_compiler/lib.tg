# The §29 semantic snapshot/delta protocol (semantic_model.tg — data
# structures only; the analysis slices that fill the snapshot arrive in the
# audit's later slices). SemanticResponsePayload is the typed semantic
# RESPONSE envelope of the §38/§39 query protocol (audit item 23 — the
# per-kind payload variants carrying the canonical answer rows; see the
# module's mapping table).
pub use semantic_model::{
  SemanticSnapshot, SemanticResponsePayload, semantic_snapshot_new, semantic_symbols_sort
}
# The §27 stable semantic identity domains (stable_ids.tg — the STABLE face
# of the semantic domains as strong records, each dense_id + stable_key +
# the 128-bit digest pair of ids.tg StableDigest: the LOCAL dense ids of
# one compilation (TypeId.id / TraitId.id / MirBlockId.id ...; -1 when none
# exists) are separated from the STABLE semantic ids the §29 snapshot / §31
# delta / §32 index / §33 slice / §35 repair / §36 budget / §37 patch rows
# key on (the canonical key TEXT grammars the snapshot writer, the delta
# row keys and the §33 node keys already use, mirrored here). The module is
# the String-authority seam: stable_key_eq is the documented semantic
# comparison for the §31/§36/§37 text hot spots, and the typed accessors
# (stable_type_of_key / stable_capability_of_key / ...) plus the
# from-existing constructors (stable_type_from_def / stable_symbol_of_key
# / stable_from_def_key) rebuild the domain records later migrations re-key
# maps through. SymbolId is stable_ids' OWN StableSymbolId — the split
# record {StableDeclId declaration lineage, SignatureFingerprint, full key
# text} of stable_ids section 6: the declaration lineage "path::name"
# digests alone (a signature change keeps the declaration id — the §31
# vocabulary pairs a signature CHANGE, never a remove/create pairing); the
# fingerprint parses/digests the "#sig" component
# (signature_fingerprint_of_sig_text / decl_id_of_full_key /
# stable_symbol_id_of_full_key). repair_candidates.tg's same-named record
# stays the §35 advisory vocabulary's record, exported below). Section 7
# (audit item 7) adds the same-shaped records for the domains with no row
# family today: the IMPL records over types.tg ImplInfo's registration
# data (StableImplId — the impl text "trait_key|self_pattern|binders|
# predicates" — built by stable_impl_id_of / parsed by stable_impl_of_key
# — and StableImplMethodId), the local/place records over the ownership-row
# place texts (StableLocalId / StableProjection / StablePlaceId with
# stable_place_of_text), the reserved StableValueId, and the
# generated-executable ids keyed by the mir_functions origin row keys
# (StableDropGlueId / StableClosureId / StableDerivedBodyId / StableShimId
# with their origin-piece constructors).
pub use stable_ids::{
  StableTypeId, StableTraitId, StableImplId, StableContractId, StableEffectId,
  StableCapabilityId, StableInstanceId, StableMirFunctionId, StableMirBlockId,
  StableMirStmtId, StableTestId, StableAbiSurfaceId,
  SignatureFingerprint, StableDeclId, StableSymbolId,
  StableImplMethodId, StableLocalId, StableProjection, StablePlaceId,
  StableValueId, StableDropGlueId, StableClosureId, StableDerivedBodyId,
  StableShimId,
  stable_registration_key, stable_def_key, stable_key_module, stable_key_name,
  stable_key_name_part, stable_key_signature, stable_instance_key,
  stable_mir_stmt_key, stable_mir_term_key, stable_capability_row_key,
  stable_contract_row_key, stable_key_eq, stable_key_digest,
  stable_symbol_of_key, stable_from_def_key,
  signature_fingerprint_of_sig_text, decl_id_of_full_key,
  stable_symbol_id_of_full_key,
  stable_type_of_key, stable_trait_of_key, stable_impl_of_key,
  stable_effect_of_key, stable_contract_of_key, stable_capability_of_key,
  stable_instance_of_key, stable_mir_function_of_key, stable_mir_block_of_key,
  stable_mir_stmt_of_key, stable_test_of_key, stable_abi_surface_of_key,
  stable_type_from_def, stable_trait_from_def, stable_effect_from_def,
  stable_mir_function_from_def, stable_test_from_def, stable_abi_surface_from_def,
  stable_impl_id_of, stable_place_of_text,
  stable_drop_glue_id_of_type_key, stable_closure_id_of,
  stable_derived_body_id_of, stable_shim_id_of
}
# The §30 semantic snapshot builder (semantic_snapshot.tg — builds
# SemanticSnapshot values from the FINALIZED semantic state — the finalized
# env + typed program + verified MIR — with deterministic serialization,
# content-addressed revision and the three surface hashes; the
# TANGERINE_SNAPSHOT env-gated hook is the driver's compile_snapshot_route,
# next to the LIR gates — the bootstrap compiler kernel stays closed).
pub use semantic_snapshot::{
  semantic_snapshot_of_final_state, semantic_snapshot_serialize, semantic_snapshot_digest,
  semantic_snapshot_finalize
}
# The §31 semantic delta core (semantic_delta.tg — the diff core over the
# §29 protocol records: semantic_delta_of compares two SemanticSnapshot
# values table-by-table by stable key; SemanticDelta carries the entity /
# edge / ownership / contract deltas, the public-api and abi deltas, the
# affected closure and a content-addressed delta digest).
pub use semantic_delta::{
  SemanticDelta, EntityDelta, EdgeDelta, OwnershipDelta, ContractDelta, ApiDelta, AbiDelta,
  DeltaKind, semantic_delta_of, semantic_delta_empty, semantic_delta_digest,
  semantic_delta_digest_text
}
# The §32 semantic index (semantic_index.tg — the read-side graph index of
# one SemanticSnapshot: build_semantic_index folds the snapshot's row tables
# into Map-based indexes once per snapshot — callers/callees over the call
# rows, per-symbol effects/capabilities/contracts, per-type members/impls/
# properties, test relationships, coarse MIR summaries — so queries become
# O(1) Map lookups instead of per-query table scans; index_snapshot_hash
# digests the index's canonical sorted text deterministically).
pub use semantic_index::{
  SemanticIndex, build_semantic_index, index_callers_of, index_callees_of, index_types_of,
  index_effects_of, index_capabilities_of, index_contracts_of, index_fields_of, index_impls_of,
  index_properties_of, index_layout_of, index_symbols_for_test, index_tests_for_symbol,
  index_mir_summary_of, index_snapshot_hash
}
# The §33 semantic slices (semantic_slice.tg — compiler-derived slices
# over the verified lowered MIR: backward value def chains (slice_value),
# forward use slices of a statement's defs (slice_statement), the
# statements contributing to a diagnostic (slice_failure — span-mapped)
# and the direct statements contributing an effect class
# (slice_effect — the §11 machinery's sites) — as stable statement key
# texts "<fn emission name>#B<block id>#S<stmt index>" / "#T" with
# external anchors; span_keys are presentation-only; slice_digest
# content-addresses the sorted canonical rows). The ONE typed entry
# (audit item 22) is mir_slice(Option[MirProgram], MirSliceRequest) —
# MirSliceKind routes per kind onto those engines (plus the
# ControlDependence / Ownership walks); MirSlice is the typed result,
# MirSliceError the typed error (see the module's entry doc for the
# anchor grammar).
pub use semantic_slice::{
  SliceResult, slice_value, slice_statement, slice_failure, slice_effect, slice_digest,
  MirSlice, MirSliceKind, MirSliceRequest, MirSliceError, mir_slice
}
# The §35 repair-candidate engine (repair_candidates.tg — the DETERMINISTIC
# compiler repair candidates for the audit's error classes: one Diagnostic in,
# the advisory RepairCandidate list out, keyed off the §34 derivational rows:
# ownership use-after-move / convention classes, expected-vs-actual mismatch,
# trait-resolution gaps, E0232 effect classes. Records: RepairKind,
# StableSymbolId (its own digest-bearing ADVISORY symbol record — distinct
# from stable_ids' symbol-domain StableSymbolId of the §27 block above),
# SemanticDeltaConstraint (the §31 envelope: signature/impl/annotation
# changes), RepairCandidate (carrying the module-local Obligation
# preconditions {kind, type_text, ok}). candidate_of_diagnostic is the
# rules engine; repair_candidate_rows renders the canonical text lines).
pub use repair_candidates::{
  RepairKind, RepairCandidate, SemanticDeltaConstraint,
  candidate_of_diagnostic, repair_candidate_rows
}
# The §36 change-budget verifier (change_budget.tg — the SemanticDelta ⊆
# ChangeBudget envelope: one ChangeBudget is the audit's per-change allowance
# over one §31 delta — the allowed stable-symbol keys, the public-api / abi
# row budgets, the new-effect-class / new-capability allow-sets, the new
# unsafe-marker budget, contract-weakening permission and the optional
# alloc-class row cap. budget_verify returns the "budget:"-prefixed violation
# list (empty = the delta verifies); budget_verified is the Bool gate. An
# empty budget admits only the empty delta — the fail-closed default).
pub use change_budget::{ChangeBudget, budget_verify, budget_verified}
# The §37 proof-carrying patch report (proof_patch.tg — ONE audit §37
# ProofCarryingPatch over ONE §31 SemanticDelta and ONE §36 ChangeBudget:
# the delta carried whole, the compiler-verified stage flags (parses /
# resolves / types / ownership — pipeline stages only, never inferred, never
# application claims), the delta's domain row lists (contract_delta /
# effect_delta / capability_delta — the §31 ContractDelta/EdgeDelta records
# with their kinds), the §36-rule unsafe-marker rows (unsafe_delta), the
# abi / public-api deltas, the extensible affected-tests / uncovered-new-
# paths surfaces and the budget_verify violation list as budget_result.
# proof_patch_new is the claim-nothing empty patch; proof_patch_of_delta
# derives a report from a delta + budget; proof_patch_proven_fields lists
# the true stage flags).
pub use proof_patch::{
  ProofCarryingPatch, proof_patch_new, proof_patch_of_delta, proof_patch_proven_fields
}
# The §38 semantic query facade (semantic_query.tg — the typed dispatch
# surface over the §29 snapshot / §32 index / §31 delta: ONE QueryResults
# record (kind word + sorted stable key texts) carries every query, and
# (audit item 23) each answer ALSO rides the TYPED
# SemanticResponsePayload variant of its semantic kind (semantic_model.tg)
# — the nine index accessors (callers..properties), the def-key presence/
# search ops (symbol_get / symbol_search), the recorded contract row lists
# (contract_obligations / contract_has_rows / contract_list — rows marked
# recorded only, never "verified"), the explain helpers (type_explain /
# ownership_explain) and the coarse MIR summary query (mir_function).
# The §38 query-level mir_slice slot stays at the module scope
# (semantic_query::mir_slice — the declared-empty "mir_slice_unavailable"
# answer); the REAL typed slice entry is semantic_slice::mir_slice above
# (audit item 22), exported at the root under that name. The change probes
# (change_affected / change_semantic_diff) and the delta ABI rows
# (abi_inspect). SemanticQuerySession pairs a snapshot with its built
# index; query() routes the session-scoped ops by name — unknown names and
# the delta-scoped ops return kind "unknown").
pub use semantic_query::{
  QueryResults, SemanticQuerySession, new_semantic_query_session, query,
  query_callers, query_callees, query_types, query_effects, query_capabilities,
  query_contracts, query_fields, query_impls, query_properties,
  symbol_get, symbol_search, query_symbol_get, query_symbol_search,
  contract_obligations, contract_has_rows, contract_list,
  type_explain, ownership_explain, mir_function,
  change_affected, change_semantic_diff, abi_inspect
}
# The §39 semantic server session (semantic_server.tg — the PERSISTENT
# semantic service over the §38 facade: ONE CompilerSession holds the
# revision digest + §29 snapshot + §32 index (with the finalized
# env/typed-program/verified-MIR Option slots for the documented pipeline
# hook gap) and answers a versioned length-prefixed structured request
# protocol — semantic_request_frame/parse, semantic_response_frame/parse —
# routing the sixteen §38 session ops plus the "revision" service op;
# every response carries the §38 answer rows on the wire AND the typed
# SemanticResponsePayload in-process (audit item 23 — never serialized,
# always rendered by response_to_debug_string);
# session_revise replaces the session after a source revision and the §31
# session_delta of the old/new sessions is the invalidation unit; the §38
# query facade is constructed on demand via session_query; the *_to_debug_string
# JSONL helpers are for logs only — never parsed on the wire).
pub use semantic_server::{
  SEMANTIC_PROTOCOL_VERSION, CompilerSession, SemanticRequest, SemanticResponse,
  new_compiler_session, session_query, session_handle_request, session_revise,
  session_delta, semantic_request_frame, semantic_request_parse,
  semantic_response_frame, semantic_response_parse,
  request_to_debug_string, response_to_debug_string
}
# The §40 coverage graph (coverage_graph.tg — the test-coverage index
# family over the §29 relationship rows: CoverageGraph maps each exercised
# function stable key to its covering test-function keys in the symbol /
# contract / effect domains (both tables documented EMPTY today — the read
# side comes alive with the §40 test-relationship machinery; the
# MirBlockId/MirEdgeId branch indexes stay empty until coverage rows carry
# a test endpoint — documented gaps in the module); coverage_graph_of_snapshot
# builds one graph per snapshot; tests_covering_symbol/contract/effect are
# the sorted TestId lookups; uncovered_paths returns the §40 path
# constraints of the delta's CREATED call/effect edges that no covering
# test exercises — "uncovered:<kind>:<src>-><dst>:no covering test:
# constraint <fn-key>#B?<edge-key>" — for targeted test generation).
pub use coverage_graph::{
  CoverageGraph, coverage_graph_of_snapshot,
  tests_covering_symbol, tests_covering_contract, tests_covering_effect,
  uncovered_paths
}
# The §41 layered equivalence checking (equivalence.tg — equivalence_check
# compares TWO MIR versions of ONE function — the pre/post forms a compile
# produces around the optimizer passes — through CHEAP-FIRST layers: the L1
# normalized shape digest (id-independent full row render, canonical names by
# first mention; equal rows prove identical bodies up to renaming), the L2
# symbolic-finite layer (a tiny symbolic evaluator over FINITE PURE
# single-block bodies, folding mirrored from optimize_mir, comparing the
# return trees; structural divergence at concrete leaves is a
# Counterexample), and the SCAFFOLDED L3 bounded-domain (exhaustive Bool
# domains gated by domain_depth <= 2^16) / L4 differential layers that return
# the documented Unknown texts "bounded domain requires an evaluator" /
# "differential requires a runner" — tg_compiler has no MIR interpreter.
# Claim discipline is the module's core rule: Unknown is returned for
# everything not proven; nothing is ever claimed equivalent beyond what a
# layer proved).
pub use equivalence::{
  EquivalenceResult, ProofDomain, equivalence_check, equivalence_proven,
  equivalence_counterexample, equivalence_unknown, proof_domain_text,
  equivalence_result_render, equivalence_normalized_rows, equivalence_normalized_hash
}
# The §42 replay/divergence audit (replay.tg — the compact event-level
# divergence lane: two EventTraces of MIR-site events (stable def key
# texts + §33 statement keys + thread/task ids + effect words + place
# deltas), never raw million-event traces. first_divergence finds the
# first sequence position where the (symbol, stmt, effect_kind,
# delta-render) tuple differs or a side ends; causal_predecessors
# returns the conservative same-thread + last-cross-thread-writer
# predecessors (capped at 64); writes_to / value_at answer the place
# questions; minimal_causal_slice materializes ONLY the divergence
# event + its transitive causal predecessors (capped, sorted, deduped).
# The append-only ReplayTraceBuilder stamps sequence == Vec index and
# replay_trace_digest content-addresses the canonical sequence-ordered
# rows (the digest preimage — never the raw traces)).
pub use replay::{
  ReplayEventId, StateDelta, ReplayEvent, EventTrace, ReplayTraceBuilder,
  replay_builder_new, replay_builder_append, replay_builder_append_record,
  replay_builder_finish, replay_trace_rows, replay_trace_digest,
  first_divergence, causal_predecessors, writes_to, value_at,
  minimal_causal_slice
}
# The §43 ABI/FFI report (abi_report.tg — ONE compact FfiReport per
# exported / extern symbol of a §29 snapshot, plus abi_diff and the
# coarse abi-row fallback: ffi_report_of_symbol derives the report from
# the snapshot's symbol rows alone — the full stable key as symbol_key,
# its "#signature" component as tangerine_signature, the §30-grammar abi
# row (digest + registration key, "generic" marker for generic bases)
# for every pub Function-kind row with a def-keyed lowering as abi_name /
# external_signature, and the documented heuristic scans (nullability
# over "ptr"/"Ptr"-prefixed param type texts, ownership_transfer over
# the sig's sink/set convention words); arg_locations / return_location /
# layouts / alignments stay empty (no per-arg location or layout row
# family rides a snapshot — documented) and thread_safety / taint /
# failure_convention are the "not modeled" markers. abi_diff emits the
# positional layout/alignment and arg-location diffs plus appended
# signature changes in sorted rows; abi_rows_of_snapshot returns the
# §30-surface row texts a snapshot can support).
pub use abi_report::{
  FfiReport, ffi_report_of_symbol, abi_diff, abi_rows_of_snapshot
}
# The §44 per-function performance report (perf_report.tg — ONE compact
# PerfReport per function of an OPTIMIZED MirProgram, plus the LIR view:
# perf_report_of_mir_function counts the surviving optimized-MIR
# artifacts — §11 allocating MirCall sites (mirroring mir_effect_
# classify_call's decision path through the effect records / bodyless
# name router / extern seeds with fail-closed unknowns) plus the §11
# string-concat statement sites as heap_allocations, the arena/"bump"
# callee-name heuristic as arena_allocations, MirRef sites + bare-local
# call-argument occurrences as escapes, the surviving BoundsCheck
# asserts as bounds_checks, MirCopy/MirRead operand occurrences as
# copies, MirMovePlace occurrences as moves, MirDeinit terminators as
# drops, the retain/"release"/clone callee-name heuristic as
# retain_release, MirGoto+MirSwitchInt+MirAssert terms as branch_count,
# 2*statements+3*terminators as est_instruction_count and any
# array/vector-typed statement (inline arrays, the Vec2/4/8/16 SIMD
# family, MirArray aggregates, MirRepeat, MirLen) as
# vectorization_eligible — while proven_removed_bounds, inline_decisions,
# spills/reloads and hotness stay 0 (the optimizer records NO pass
# statistics; each field documents its gap). perf_report_of_lir_alloc
# fills spills/reloads/stack_bytes/branch_count from the LIR allocation
# artifacts (LirAlloc.spills/.reloads/.frame_bytes + the LirJump/
# LirSwitch terms) and perf_reports_of_program returns the per-function
# reports sorted by function key).
pub use perf_report::{
  PerfReport, perf_report_of_mir_function, perf_report_of_lir_alloc,
  perf_reports_of_program
}
use tg_compiler::parser::{Diagnostic, DiagLevel}
use tg_compiler::cqs::{cqs_query_server_new, cqs_run_queries, CqsQueryServer, CqsQueryResults}

# ———————————————————————————————————————————————————————————————
# The CQS query server — the canonical pipeline's invocation point
# ———————————————————————————————————————————————————————————————
# The library pipeline INVOKES the compiler-query-server queries on the
# analyzed program + the lowered MIR. analyze_source_cqs is the query
# server's library boundary: it runs the canonical semantic path
# (parse -> analyze_parsed -> lower) and returns the three query results
# (the typed info, the symbols, the diagnostics). The library compile/
# check entries surface the Error-level CQS diagnostics on their Result
# channel — the query results AFFECT the compilation where required (the
# mode matrix's gated failures).

pub def analyze_source_cqs(source: String, file: String, opts: CompilerOptions) -> Result[CqsQueryResults, Vec[Diagnostic]]
  var ast = match parse_source_program(source, file)
  when Result::Ok(program) then program
  when Result::Err(diags) then
    return Result::Err(diags)
  end
  var env = type_env_new()
  let analyzed = match analyze_parsed(&mut env, &mut ast, &opts)
  when Result::Ok(ap) then ap
  when Result::Err(diags) then
    return Result::Err(diags)
  end
  let mir = match lower_to_mir(&ast, &analyzed)
  when Result::Ok(m) then m
  when Result::Err(e) then
    return Result::Err(Vec::from([Diagnostic {
      level: DiagLevel::Error,
      message: "CQS query pipeline: MIR lowering failed: " + e,
      span: Option::None,
      notes: Vec::new(),
      suggestions: Vec::new(),
      code: Option::None
    }]))
  end
  Result::Ok(cqs_run_queries(
    cqs_query_server_new(),
    &ast,
    &analyzed.typed,
    &mir,
    opts.mode,
    "lib"
  ))
end

# Convenience function for quick compilation
pub def compile(source: String) -> Result[String, String]
  var opts = default_options()
  opts.strict_resolution = true
  let typed = match analyze_source(source, "", &opts)
  when Result::Ok(t) then t
  when Result::Err(diags) then
    return Result::Err(join_diagnostics(&diags))
  end

  # (the CQS query server — the library pipeline's invocation): the query
  # diagnostics AFFECT the compilation where required — an Error-level CQS
  # diagnostic (the mode matrix's gated failure) fails the compile with
  # the query results reported.
  let query = match analyze_source_cqs(source.clone(), "", &opts)
  when Result::Ok(q) then q
  when Result::Err(diags) then
    return Result::Err(join_diagnostics(&diags))
  end
  for d in query.diagnostics do
    match d.level
    when DiagLevel::Error then
      return Result::Err("CQS gate: " + join_diagnostics(&query.diagnostics))
    when _ then ()
    end
  end

  let ast = typed.ast.clone()
  mut mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match lower_to_mir(&ast, &typed)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    return Result::Err("MIR lowering failed: " + e)
  end

  # Monomorphize generics
  mut mono_cache = mono_cache_new(&ast, &typed.resolutions)
  monomorphize_program(&mut mir, &mut mono_cache)

  # Optimize (default O1)
  optimize_mir(&mut mir, 1)

  # Generate native object code
  let target = detect_host_target()
  let obj_bytes = match generate_object_file(&mir, target)
  when Result::Ok(b) then b
  when Result::Err(e) then
    return Result::Err("codegen failed: " + e)
  end

  Result::Ok("Native object generated (" + obj_bytes.len().to_string() + " bytes)")
end

# Quick check function (no codegen)
pub def check(source: String) -> Vec[String]
  var errors = Vec::new()
  var opts = default_options()
  opts.strict_resolution = true
  match analyze_source(source, "", &opts)
  when Result::Ok(_) then ()
  when Result::Err(diags) then
    errors.push(join_diagnostics(&diags))
  end
  # (the CQS query server — the library pipeline's invocation): the
  # query diagnostics AFFECT the check where required — an Error-level
  # CQS diagnostic is surfaced on the result channel.
  match analyze_source_cqs(source.clone(), "", &opts)
  when Result::Ok(query) then
    for d in query.diagnostics do
      match d.level
      when DiagLevel::Error then
        errors.push("CQS gate: " + join_diagnostics(&query.diagnostics))
        break
      when _ then ()
      end
    end
  when Result::Err(diags) then
    errors.push(join_diagnostics(&diags))
  end
  errors
end

# Parse only (for IDE support)
pub def parse_only(source: String) -> Result[Program, String]
  let tokens = tokenize(source, "")
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  match diag_has_errors(&parse_diags)
  when true then Result::Err(parse_diags[0].message.clone())
  when false then Result::Ok(ast)
  end
end

# Get tokens (for syntax highlighting)
pub def tokenize_only(source: String) -> Vec[Token]
  tokenize(source, "").tokens
end

# Format source code through the ONE canonical formatter — the AST-based
# formatter.tg implementation (lib.tg's former line-based reimplementation
# is REMOVED: two formatters would diverge, and the AST-based one is the
# tool-proof gate's subject — parse(original) == parse(format(original))
# and format(format(x)) == format(x) are asserted over the compiler/std/
# test tree by tests/run_formatter_gate.sh).
pub def format(source: String) -> Result[String, String]
  use tg_compiler::formatter::{format_source, default_format_config}
  format_source(source.clone(), default_format_config())
end

# Compiler information
pub def print_version() -> Unit
  println("Tangerine Compiler v{}", VERSION)
  println("Self-hosting edition")
end

pub def print_help() -> Unit
  println("Usage: tg [OPTIONS] <FILES>...")
  println("")
  println("Options:")
  println("  -o, --output <FILE>  Write output to FILE")
  println("  -c                   Compile to object file")
  println("  --emit-obj           Emit native object file")
  println("  -O0/-O1/-O2/-O3      Optimization level")
  println("  -g                   Include debug info")
  println("  --check              Type check only")
  println("  -v, --verbose        Verbose output")
  println("  -h, --help           Show this help")
  println("  -V, --version        Show version")
end

# Entry point for compiler executable
pub def main() -> Int
  driver::driver_main()
end

# ———————————————————————————————————————————————————————————————
# Compiler Plugins/Extensions API
# ———————————————————————————————————————————————————————————————

# Plugin trait for extending the compiler
pub trait CompilerPlugin
  def name(self) -> String
  def version(self) -> String
  
  # Called before parsing
  def pre_parse(inout self, source: String) -> Option[String]
  
  # Called after parsing
  def post_parse(inout self, inout ast: Program) -> Unit
  
  # Called after type checking
  def post_type_check(inout self, ast: Program, types: TypeEnv) -> Unit
  
  # Called before codegen
  def pre_codegen(inout self, inout mir: MirProgram) -> Unit
end

# Plugin registry
pub struct PluginRegistry
  plugins: Vec[Box[CompilerPlugin]]
end

impl PluginRegistry
  pub def new() -> Self
    PluginRegistry { plugins: Vec::new() }
  end
  
  pub def register(inout self, sink plugin: Box[CompilerPlugin]) -> Unit
    println("Registered plugin: {} v{}", plugin.name(), plugin.version())
    self.plugins.push(plugin)
  end
  
  pub def run_pre_parse(inout self, source: String) -> String
    mut result = source
    for plugin in self.plugins do
      match plugin.pre_parse(&result)
      when Option::Some(new_source) then
        result = new_source
      when Option::None then ()
      end
    end
    result
  end
  
  pub def run_post_parse(inout self, inout ast: Program) -> Unit
    for plugin in self.plugins do
      plugin.post_parse(ast)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# REPL Support — the BOUNDED REPL (the reviewer's preferred shape)
# ———————————————————————————————————————————————————————————————
# The REPL is implemented (it is no longer the "unavailable in bootstrap
# builds" stub): every input entry is COMPILED AND RUN through the driver's
# existing machinery (parse -> type-check -> resource check -> MIR ->
# codegen -> link -> execute) as its own process — the language's real
# evaluation path. State is the session's input buffer: a multi-line entry
# accumulates until its block structure is complete (the driver's balance
# check), then evaluates as one unit. A runtime failure in one entry never
# corrupts the subsequent state: every evaluation is a fresh process and
# the buffer is cleared after every completed entry. Expression entries
# are wrapped as the body of `def main() -> Int` and their result is the
# exit code, printed as `=> <code>`; statement/program entries run and
# print their own output.

pub struct Repl
  history: Vec[String]
  buffer: String
  entry_no: Int
end

impl Repl
  pub def new() -> Self
    Repl {
      history: Vec::new(),
      buffer: String::new(),
      entry_no: 0
    }
  end

  # Evaluate one input line in the bounded REPL session.
  pub def eval(inout self, line: String) -> String
    self.history.push(line.clone())
    if self.buffer.is_empty() then
      match line
      when ":help" then
        return driver::repl_help_text()
      when ":quit" then
        return "Goodbye!"
      when ":q" then
        return "Goodbye!"
      when ":clear" then
        self.buffer = ""
        return "REPL state cleared."
      when _ then ()
      end
    end
    if line.is_empty() then
      # EOF: flush the pending multi-line entry.
      if !self.buffer.is_empty() then
        let result = driver::repl_eval_source(self.buffer.clone(), self.entry_no)
        self.entry_no = self.entry_no + 1
        self.buffer = ""
        return result
      end
      return ""
    end
    # Multi-line accumulation: an entry is complete when its block
    # structure balances; the buffer is cleared after every completed
    # entry, so a failed evaluation never leaks into the next one.
    self.buffer = self.buffer + line + "\n"
    if driver::repl_buffer_complete(self.buffer.clone()) then
      let result = driver::repl_eval_source(self.buffer.clone(), self.entry_no)
      self.entry_no = self.entry_no + 1
      self.buffer = ""
      return result
    end
    ""
  end
end

# The interactive REPL loop — the driver's bounded implementation (the
# per-input compile + run + printed result). The former lib.tg loop with
# the hand-rolled MIR interpreter is REMOVED: evaluation is the language's
# real compile+run path, so the REPL can never drift from the compiler.
pub def run_repl() -> Unit
  let _rc = driver::cmd_repl(Vec::new())
  ()
end
