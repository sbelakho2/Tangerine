# Convenience function for quick compilation
pub def compile(source: String) -> Result[String, String]
  var opts = default_options()
  opts.strict_resolution = true
  let typed = match analyze_source(source, "", &opts)
  when Result::Ok(t) then t
  when Result::Err(e) then
    return Result::Err(e)
  end

  let ast = typed.ast.clone()
  mut mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match lower_to_mir(&ast, &typed)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    return Result::Err("MIR lowering failed: " + e)
  end

  # Monomorphize generics
  mut mono_cache = mono_cache_new(&ast, &typed.resolutions)
  monomorphize_program(&mut mir, &mut mono_cache)

  # Optimize (default O1)
  optimize_mir(&mut mir, 1)

  # Generate native object code
  let target = detect_host_target()
  let obj_bytes = match generate_object_file(&mir, target)
  when Result::Ok(b) then b
  when Result::Err(e) then
    return Result::Err("codegen failed: " + e)
  end

  Result::Ok("Native object generated (" + obj_bytes.len().to_string() + " bytes)")
end

# Quick check function (no codegen)
pub def check(source: String) -> Vec[String]
  var errors = Vec::new()
  var opts = default_options()
  opts.strict_resolution = true
  match analyze_source(source, "", &opts)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    errors.push(e)
  end
  errors
end

# Parse only (for IDE support)
pub def parse_only(source: String) -> Result[Program, String]
  let tokens = tokenize(source)
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  match diag_has_errors(&parse_diags)
  when true then Result::Err(parse_diags[0].message.clone())
  when false then Result::Ok(ast)
  end
end

# Get tokens (for syntax highlighting)
pub def tokenize_only(source: String) -> Vec[Token]
  tokenize(source).tokens
end

# Format source code
pub def format(source: String) -> Result[String, String]
  # Tangerine code formatter — normalizes indentation, whitespace, and style.
  # Follows Tangerine's canonical formatting conventions:
  #   - 2-space indentation
  #   - Spaces around binary operators
  #   - Blank line between top-level items
  #   - Consistent `end` alignment
  
  mut output = ""
  mut indent_level = 0
  mut prev_was_blank = false
  
  for line in source.lines() do
    let trimmed = line.trim()
    
    # Skip multiple consecutive blank lines
    if trimmed.is_empty() then
      if !prev_was_blank then
        output = output + "\n"
        prev_was_blank = true
      end
      next
    end
    prev_was_blank = false
    
    # Decrease indent for closing keywords
    if trimmed.starts_with("end") ||
       trimmed.starts_with("elsif") ||
       trimmed.starts_with("else") ||
       trimmed.starts_with("when") then
      if indent_level > 0 then
        indent_level = indent_level - 1
      end
    end
    
    # Apply indentation
    mut indent_str = ""
    mut i = 0
    while i < indent_level do
      indent_str = indent_str + "  "
      i = i + 1
    end
    
    output = output + indent_str + trimmed + "\n"
    
    # Increase indent after block-opening keywords
    if trimmed.starts_with("def ") ||
       trimmed.starts_with("pub def ") ||
       trimmed.starts_with("struct ") ||
       trimmed.starts_with("pub struct ") ||
       trimmed.starts_with("enum ") ||
       trimmed.starts_with("pub enum ") ||
       trimmed.starts_with("trait ") ||
       trimmed.starts_with("impl ") ||
       trimmed.starts_with("module ") ||
       trimmed.starts_with("if ") ||
       trimmed.starts_with("elsif ") ||
       trimmed == "else" ||
       trimmed.starts_with("match ") ||
       trimmed.starts_with("when ") ||
       trimmed.starts_with("for ") ||
       trimmed.starts_with("while ") ||
       trimmed.starts_with("loop") then
      indent_level = indent_level + 1
    end
    
    # Decrease back after single-line `when ... then ...` (no block)
    if trimmed.starts_with("when ") && trimmed.contains(" then ") && !trimmed.ends_with("then") then
      indent_level = indent_level - 1
    end
  end
  Result::Ok(output)
end

# Compiler information
pub def print_version() -> Unit
  println("Tangerine Compiler v{}", VERSION)
  println("Self-hosting edition")
end

pub def print_help() -> Unit
  println("Usage: tg [OPTIONS] <FILES>...")
  println("")
  println("Options:")
  println("  -o, --output <FILE>  Write output to FILE")
  println("  -c                   Compile to object file")
  println("  --emit-obj           Emit native object file")
  println("  -O0/-O1/-O2/-O3      Optimization level")
  println("  -g                   Include debug info")
  println("  --check              Type check only")
  println("  -v, --verbose        Verbose output")
  println("  -h, --help           Show this help")
  println("  -V, --version        Show version")
end

# Entry point for compiler executable
pub def main() -> Int
  driver::driver_main()
end

# ———————————————————————————————————————————————————————————————
# Compiler Plugins/Extensions API
# ———————————————————————————————————————————————————————————————

# Plugin trait for extending the compiler
pub trait CompilerPlugin
  def name(&self) -> String
  def version(&self) -> String
  
  # Called before parsing
  def pre_parse(&mut self, source: &String) -> Option[String]
  
  # Called after parsing
  def post_parse(&mut self, ast: &mut Program) -> Unit
  
  # Called after type checking
  def post_type_check(&mut self, ast: &Program, types: &TypeEnv) -> Unit
  
  # Called before codegen
  def pre_codegen(&mut self, mir: &mut MirProgram) -> Unit
end

# Plugin registry
pub struct PluginRegistry
  plugins: Vec[Box[CompilerPlugin]]
end

impl PluginRegistry
  pub def new() -> Self
    PluginRegistry { plugins: Vec::new() }
  end
  
  pub def register(&mut self, plugin: Box[CompilerPlugin]) -> Unit
    println("Registered plugin: {} v{}", plugin.name(), plugin.version())
    self.plugins.push(plugin)
  end
  
  pub def run_pre_parse(&mut self, source: String) -> String
    mut result = source
    for plugin in self.plugins do
      match plugin.pre_parse(&result)
      when Option::Some(new_source) then
        result = new_source
      when Option::None then ()
      end
    end
    result
  end
  
  pub def run_post_parse(&mut self, ast: &mut Program) -> Unit
    for plugin in self.plugins do
      plugin.post_parse(ast)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# REPL Support
# ———————————————————————————————————————————————————————————————

pub struct Repl
  history: Vec[String]
  context: ReplContext
end

struct ReplContext
  variables: Map[String, Value]
  types: TypeEnv
end

impl Repl
  pub def new() -> Self
    Repl {
      history: Vec::new(),
      context: ReplContext {
        variables: Map::new(),
        types: type_env_new()
      }
    }
  end
  
  pub def eval(&mut self, line: String) -> String
    self.history.push(line.clone())
  match line.starts_with(":")
  when true then
    self.handle_command(line)
  when false then
    # Parse and evaluate
    match parse_only(line.clone())
    when Result::Ok(ast) then
      # Type-check the parsed expression
      "ast"
    when Result::Err(e) then
      "Parse error: " + e
    end
  end
end

def test_if() -> Unit
  if true then
    ()
  else
    ()
  end
end
  
  def handle_command(&mut self, cmd: String) -> String
    match cmd
    when ":help" then
      ":help       - Show this help\n:type <expr> - Show type of expression\n:ast <expr>  - Show AST\n:mir <expr>  - Show MIR\n:env         - Show bound variables\n:clear       - Clear REPL state\n:quit        - Exit REPL"
    when ":quit" then
      "Goodbye!"
    when ":q" then
      "Goodbye!"
    when ":env" then
      mut out = "Bound variables:\n"
      for entry in self.context.variables do
        out = out + "  " + entry.key + " = " + value_to_string(&entry.value) + "\n"
      end
      out
    when ":clear" then
      self.context.variables = Map::new()
      "REPL state cleared."
    when _ then
      match cmd.starts_with(":type ")
      when true then
        let expr_str = cmd.slice(6, cmd.len())
        match parse_only(expr_str.clone())
        when Result::Ok(ast) then
          match type_check_program(&ast)
          when Result::Ok(typed) then
            # Extract the type of the last expression
            match lib_infer_expr_type(&typed)
            when Option::Some(ty) then
              "Type: " + type_to_string(&ty)
            when Option::None then
              "Type: Unit"
            end
          when Result::Err(errors) then
            "Type error: " + errors.get(0).map(|e| e.message.clone()).unwrap_or("unknown".to_string())
          end
        when Result::Err(e) then
          "Parse error: " + e
        end
      when false then
        match cmd.starts_with(":ast ")
        when true then
          let expr_str = cmd.slice(5, cmd.len())
          match parse_only(expr_str.clone())
          when Result::Ok(ast) then
            format_ast(&ast)
          when Result::Err(e) then
            "Parse error: " + e
          end
        when false then
          match cmd.starts_with(":mir ")
          when true then
            let expr_str = cmd.slice(5, cmd.len())
            match parse_only(expr_str.clone())
            when Result::Ok(ast) then
              match resolve_names(&ast)
              when Result::Ok(res) then
                var env = type_env_new()
                let type_result = type_check_typed(&mut env, &ast, &res)
                if type_result.errors.is_empty() then
                  match lower_to_mir(&ast, &type_result.program)
                  when Result::Ok(mir) then
                    format_mir(&mir)
                  when Result::Err(e) then
                    "MIR lowering error: " + e
                  end
                else
                  "Type error: " + type_result.errors[0].message.clone()
                end
              when Result::Err(e) then
                "Resolution error: " + e
              end
            when Result::Err(e) then
              "Parse error: " + e
            end
          when false then
            "Unknown command: " + cmd + "\nType :help for available commands."
          end
        end
      end
    end
  end
end

pub def run_repl() -> Unit
  println("Tangerine REPL v{}", VERSION)
  println("Type :help for help, :quit to exit")
  println("")
  
  mut repl = Repl::new()
  
  loop
    print("> ")
    let line = read_line()
    
    match line
    when ":quit" then
      println("Goodbye!")
      break
    when ":q" then
      println("Goodbye!")
      break
    when _ then
      let result = repl.eval(line)
      println(result)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# REPL Helper Functions
# ———————————————————————————————————————————————————————————————

struct Value
  data: Int
  ty: Type
  str_val: Option[String]
end

def value_to_string(v: &Value) -> String
  match v.ty
  when Type::Int then v.data.to_string()
  when Type::Bool then
    match v.data != 0
    when true then "true"
    when false then "false"
    end
  when Type::Float then
    # Reinterpret bits as float
    let f = Float::from_bits(v.data as u64)
    f.to_string()
  when Type::String then
    match v.str_val
    when Option::Some(s) then "\"" + s + "\""
    when Option::None then "\"<string>\""
    end
  when Type::Unit then "()"
  when Type::Char then
    let c = Char::from_u32(v.data as u32)
    "'" + c.to_string() + "'"
  when _ then v.data.to_string()
  end
end

def type_to_string(ty: &Type) -> String
  match ty
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Bool then "Bool"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::Unit then "Unit"
  when Type::Never then "Never"
  when Type::RefInternal(inner, mutable) then
    if mutable then "&mut " + type_to_string(&inner) else "&" + type_to_string(&inner) end
  when Type::Tuple(elems) then
    mut s = "("
    mut first = true
    for e in elems do
      if !first then s = s + ", " end
      s = s + type_to_string(&e)
      first = false
    end
    s + ")"
  when Type::Adt(tid, args) then
    if args.is_empty() then
      "<type_" + tid.id.to_string() + ">"
    else
      mut s = "<type_" + tid.id.to_string() + ">["
      mut first = true
      for a in args do
        if !first then s = s + ", " end
        s = s + type_to_string(&a)
        first = false
      end
      s + "]"
    end
  when Type::Function(params, ret) then
    mut s = "fn("
    mut first = true
    for p in params do
      if !first then s = s + ", " end
      s = s + type_to_string(&p.ty)
      first = false
    end
    s + ") -> " + type_to_string(&ret)
  when Type::Var(id) then "?" + id.to_string()
  when Type::Error then "<error>"
  end
end

def type_check_program(ast: &Program) -> Result[Program, Vec[TypeError]]
  # Run the type checker over the program, returning typed AST or errors
  let errors = type_check(ast)
  if errors.is_empty() then
    Result::Ok(ast.clone())
  else
    Result::Err(errors)
  end
end

def interpret_mir_program(mir: &MirProgram, ctx: &ReplContext) -> Result[Value, String]
  # Simple MIR interpreter for REPL evaluation.
  # Executes the first function (usually the expression wrapper) and returns its result.
  
  if mir.functions.is_empty() then
    return Result::Ok(Value { data: 0, ty: Type::Unit, str_val: Option::None })
  end
  
  let func = mir.functions.get(0)
  
  # Create a simple evaluation environment
  mut locals: Map[Int, Value] = Map::new()
  
  # Initialize parameters from context
  mut param_idx = 0
  for param in func.params do
    let p_name = param.name.clone()
    match ctx.variables.get(&p_name)
    when Option::Some(v) then
      locals.insert(param_idx, v.clone())
    when Option::None then
      let p_ty = param.ty.clone()
      locals.insert(param_idx, Value { data: 0, ty: p_ty, str_val: Option::None })
    end
    param_idx = param_idx + 1
  end
  
  # Execute blocks starting from entry
  mut current_block_id = func.entry_block.id
  let f_ret_ty = func.ret_type.clone()
  mut result = Value { data: 0, ty: f_ret_ty, str_val: Option::None }
  mut steps = 0
  let max_steps = 10000  # Prevent infinite loops in REPL
  
  while steps < max_steps do
    steps = steps + 1
    
    mut current_block_found = false
    mut current_block_idx = 0
    for i in 0..func.blocks.len() do
      let b = func.blocks.get(i)
      if b.id.id == current_block_id then
        current_block_idx = i
        current_block_found = true
        break
      end
    end
    
    if !current_block_found then
      return Result::Err("block not found: bb" + current_block_id.to_string())
    end
    
    let block = func.blocks.get(current_block_idx)
    
    # Execute statements
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        let val = eval_mir_rvalue(&rvalue, &locals)
        locals.insert(place.local.id, val)
      when _ then ()
      end
    end
    
    # Execute terminator and get next action
    match block.terminator.kind
    when MirTerminatorKind::MirReturn then
      match locals.get(0)
      when Option::Some(v) then return Result::Ok(v.clone())
      when Option::None then return Result::Ok(result.clone())
      end
    when MirTerminatorKind::MirGoto(target) then
      current_block_id = target.id
    when MirTerminatorKind::MirCall(dest, _callee, _args, success_block, _unwind) then
      let f_ret_ty2 = func.ret_type.clone()
      locals.insert(dest.local.id, Value { data: 0, ty: f_ret_ty2, str_val: Option::None })
      current_block_id = success_block.id
    when MirTerminatorKind::MirSwitchInt(discr, targets, otherwise) then
      let discr_val = eval_mir_operand(&discr, &locals)
      mut matched = false
      for tgt in targets do
        if tgt.value == discr_val.data then
          current_block_id = tgt.target.id
          matched = true
          break
        end
      end
      if !matched then
        current_block_id = otherwise.id
      end
    when MirTerminatorKind::MirDeinit(_place, _deinit_fn, target, _unwind) then
      current_block_id = target.id
    when MirTerminatorKind::MirAssert(_cond, _expected, _msg, target, _unwind) then
      current_block_id = target.id
    when MirTerminatorKind::MirUnreachable then
      return Result::Err("reached unreachable code".to_string())
    when MirTerminatorKind::MirAbort then
      return Result::Err("abort reached".to_string())
    end
  end
  
  Result::Err("REPL evaluation limit reached (10,000 steps) — possible infinite loop")
end

def eval_mir_rvalue(rv: &MirRvalue, locals: &Map[Int, Value]) -> Value
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    eval_mir_operand(&op, locals)
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    let l = eval_mir_operand(&lhs, locals)
    let r = eval_mir_operand(&rhs, locals)
    let result_data = match op
    when MirBinOp::Add then l.data + r.data
    when MirBinOp::Sub then l.data - r.data
    when MirBinOp::Mul then l.data * r.data
    when MirBinOp::Div then if r.data != 0 then l.data / r.data else 0 end
    when MirBinOp::Mod then if r.data != 0 then l.data % r.data else 0 end
    when MirBinOp::Eq then if l.data == r.data then 1 else 0 end
    when MirBinOp::Ne then if l.data != r.data then 1 else 0 end
    when MirBinOp::Lt then if l.data < r.data then 1 else 0 end
    when MirBinOp::Le then if l.data <= r.data then 1 else 0 end
    when MirBinOp::Gt then if l.data > r.data then 1 else 0 end
    when MirBinOp::Ge then if l.data >= r.data then 1 else 0 end
    when MirBinOp::BitAnd then l.data & r.data
    when MirBinOp::BitOr then l.data | r.data
    when MirBinOp::BitXor then l.data ^ r.data
    when MirBinOp::Shl then l.data << r.data
    when MirBinOp::Shr then l.data >> r.data
    when _ then 0
    end
    Value { data: result_data, ty: l.ty.clone(), str_val: Option::None }
  when MirRvalueKind::MirUnOp(op, inner) then
    let v = eval_mir_operand(&inner, locals)
    let result_data = match op
    when MirUnOp::Neg then -v.data
    when MirUnOp::Not then if v.data == 0 then 1 else 0 end
    when MirUnOp::BitNot then ~v.data
    end
    Value { data: result_data, ty: v.ty.clone(), str_val: Option::None }
  when _ then
    Value { data: 0, ty: Type::Unit, str_val: Option::None }
  end
end

def eval_mir_operand(op: &MirOperand, locals: &Map[Int, Value]) -> Value
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(n) then
      Value { data: n, ty: Type::Int, str_val: Option::None }
    when MirConstantKind::MirFloat(f) then
      Value { data: f.to_bits() as Int, ty: Type::Float, str_val: Option::None }
    when MirConstantKind::MirBool(b) then
      Value { data: if b then 1 else 0 end, ty: Type::Bool, str_val: Option::None }
    when MirConstantKind::MirString(s) then
      Value { data: 0, ty: Type::String, str_val: Option::Some(s.clone()) }
    when MirConstantKind::MirChar(c) then
      Value { data: c as Int, ty: Type::Char, str_val: Option::None }
    when MirConstantKind::MirUnit then
      Value { data: 0, ty: Type::Unit, str_val: Option::None }
    when _ then
      Value { data: 0, ty: cst.ty.clone(), str_val: Option::None }
    end
  when MirOperandKind::MirCopy(place) then
    match locals.get(place.local.id)
    when Option::Some(v) then v.clone()
    when Option::None then Value { data: 0, ty: Type::Unit, str_val: Option::None }
    end
  when MirOperandKind::MirMovePlace(place) then
    match locals.get(place.local.id)
    when Option::Some(v) then v.clone()
    when Option::None then Value { data: 0, ty: Type::Unit, str_val: Option::None }
    end
  when MirOperandKind::MirRead(place) then
    match locals.get(place.local.id)
    when Option::Some(v) then v.clone()
    when Option::None then Value { data: 0, ty: Type::Unit, str_val: Option::None }
    end
  when MirOperandKind::MirConsume(place) then
    match locals.get(place.local.id)
    when Option::Some(v) then v.clone()
    when Option::None then Value { data: 0, ty: Type::Unit, str_val: Option::None }
    end
  end
end

def lib_infer_expr_type(program: &Program) -> Option[Type]
  # Extract the type of the last expression in the program
  match program.items.last()
  when Option::Some(last_item) then
    match last_item.kind
    when ItemKind::ItemFunction(f) then
      match f.ret_type
      when Option::Some(ty) then
        Option::Some(resolve_type_expr_for_display(&ty))
      when Option::None then
        Option::Some(Type::Unit)
      end
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end
#
def resolve_type_expr_for_display(ty: &TypeExpr) -> Type
  match ty.kind
  when TypeExprKind::Named(name, args) then
    match name.as_str()
    when "Int" then Type::Int
    when "UInt" then Type::UInt
    when "Float" then Type::Float
    when "Bool" then Type::Bool
    when "Char" then Type::Char
    when "String" then Type::String
    when "Unit" then Type::Unit
    when "Never" then Type::Never
    when _ then
      mut type_args = Vec::new()
      for a in args do
        type_args.push(resolve_type_expr_for_display(&a))
      end
      Type::Error
    end
  when TypeExprKind::Tuple(elems) then
    mut ts = Vec::new()
    for e in elems do
      ts.push(resolve_type_expr_for_display(&e))
    end
    Type::Tuple(ts)
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when _ then Type::Unit
  end
end

def format_ast(program: &Program) -> String
  mut out = "AST:\n"
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      out = out + "  Function: " + f.name.clone() + "\n"
      out = out + "    Params: " + f.params.len().to_string() + "\n"
      match f.ret_type
      when Option::Some(_) then
        out = out + "    Returns: (specified)\n"
      when Option::None then
        out = out + "    Returns: Unit (implicit)\n"
      end
    when ItemKind::ItemStruct(s) then
      out = out + "  Struct: " + s.name.clone() + "\n"
      out = out + "    Fields: " + s.fields.len().to_string() + "\n"
    when ItemKind::ItemEnum(e) then
      out = out + "  Enum: " + e.name.clone() + "\n"
      out = out + "    Variants: " + e.variants.len().to_string() + "\n"
    when _ then
      out = out + "  <item>\n"
    end
  end
  out
end

def format_mir(mir: &MirProgram) -> String
  pretty_print_mir(mir)
end
