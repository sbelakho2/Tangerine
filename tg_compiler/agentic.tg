# Tangerine Compiler — Agentic Features
# Self-hosting compiler written in Tangerine
#
# This module provides runtime and compile-time support for:
# - Design-by-Contract advisory tooling (the ONE contract authority is the
#   canonical MIR ContractCheck path; see contract_evaluation_authority)
# - Capability-based security
# - Effect tracking
# - Budget/resource management
# - Rationale documentation
# - Semantic differencing

use std::core::{Option, Result}
use std::collections::{Vec, Map, Set}
use std::time::perf_counter_ms
use tg_compiler::token::Span
use tg_compiler::ast::{
  Program, Item, ItemKind,
  AstContractKind, Expr, ExprKind, UnOp, AccessConvention
}

# ———————————————————————————————————————————————————————————————
# Contract Evaluation Authority
# ———————————————————————————————————————————————————————————————
# There is exactly ONE contract authority: the canonical MIR contract
# machinery. AST contract clauses are lowered by mir.tg `lower_contract`
# into `MirStatementKind::MirContractCheck`, and codegen.tg emits the
# runtime trap on a false computed condition (unconditional in every mode
# — see docs/current/language.md). This module deliberately carries NO
# AST-level contract evaluator: the removed pseudo-evaluator
# (check_preconditions / check_postconditions / check_invariants plus the
# evaluate_condition mini-interpreter) defaulted unsupported expressions
# to true and hardcoded method predicates, so a boolean verdict from it
# was never verification. Callers must compile the condition and observe
# the emitted ContractCheck; the def below reports that requirement as a
# typed error (never Ok(true) for an unevaluated condition).
def contract_evaluation_authority() -> Result[Unit, String]
  Result::Err(
    "contract evaluation belongs to emitted ContractCheck MIR " +
    "(mir.tg lower_contract -> MirStatementKind::MirContractCheck; " +
    "codegen.tg emits the runtime trap). No AST-level evaluator exists."
  )
end

# Payload value of agentic bookkeeping records (performed-effect argument
# lists). This is a VALUE CARRIER only — it is not a contract-evaluation
# type; contract verdicts come exclusively from the emitted ContractCheck
# path above.
enum ContractValue
  Int(Int)
  Bool(Bool)
  Float(Float)
  Named(String, ContractValue)
  Unit
end

# ———————————————————————————————————————————————————————————————
# Capability System
# ———————————————————————————————————————————————————————————————

struct CapabilityContext
  # Available capabilities in current scope
  available: Map[String, Capability]
  
  # Required capabilities for current function
  required: Set[Capability]
  
  # Capability grants (from capability declarations)
  grants: Map[String, CapabilityGrant]
  
  # Violations found
  violations: Vec[CapabilityViolation]
end

struct Capability
  name: String
  scope: CapabilityScope
  level: CapabilityLevel
end


enum CapabilityScope
  Global        # Available everywhere
  Module        # Available in declaring module
  Function      # Available in declaring function
  Block         # Available in current block
end

enum CapabilityLevel
  Read          # Read-only access
  Write         # Read-write access
  Execute       # Execute permission
  Admin         # Full control
end

struct CapabilityGrant
  name: String
  parent: Option[String]
  implied_caps: Vec[String]
  revocable: Bool
end

struct CapabilityViolation
  required: String
  available: Vec[String]
  location: Span
  message: String
end

def cap_context_new() -> CapabilityContext
  mut ctx = CapabilityContext {
    available: Map::new(),
    required: Set::new(),
    grants: Map::new(),
    violations: Vec::new()
  }
  
  # Register built-in capabilities
  ctx.grants.insert("Filesystem", CapabilityGrant {
    name: "Filesystem",
    parent: Option::None,
    implied_caps: ["FileRead", "FileWrite"],
    revocable: true
  })
  
  ctx.grants.insert("Network", CapabilityGrant {
    name: "Network",
    parent: Option::None,
    implied_caps: ["NetworkRead", "NetworkWrite"],
    revocable: true
  })
  
  ctx.grants.insert("Memory", CapabilityGrant {
    name: "Memory",
    parent: Option::None,
    implied_caps: ["Alloc", "Dealloc"],
    revocable: false
  })
  
  ctx
end

def check_capability(ctx: CapabilityContext, cap: String) -> Bool
  # Direct check
  match ctx.available.get(&cap)
  when Option::Some(_) then
    return true
  when Option::None then ()
  end
  
  # Check implied capabilities
  for capability_name in ctx.available.keys() do
    match ctx.grants.get(&capability_name)
    when Option::Some(grant) then
      for implied in grant.implied_caps do
        if implied == cap then
          return true
        end
      end
    when Option::None then ()
    end
  end
  
  false
end

def require_capability(inout ctx: CapabilityContext, cap: String, span: Span) -> Bool
  if !check_capability(ctx, cap) then
    mut available = Vec::new()
    for capability_name in ctx.available.keys() do
      available.push(capability_name)
    end
    ctx.violations.push(CapabilityViolation {
      required: cap,
      available: available,
      location: span,
      message: "Missing capability: " + cap
    })
    false
  else
    true
  end
end

def grant_capability(inout ctx: CapabilityContext, cap: String, scope: CapabilityScope) -> Unit
  ctx.available.insert(cap.clone(), Capability {
    name: cap,
    scope: scope,
    level: CapabilityLevel::Read
  })
end

def revoke_capability(inout ctx: CapabilityContext, cap: String) -> Bool
  mut removed = false
  match ctx.available.get(&cap)
  when Option::Some(_) then
    ctx.available.remove(&cap)
      removed = true
  when Option::None then ()
  end

  # Check if capability is revocable
  match ctx.grants.get(cap)
  when Option::Some(grant) then
    if grant.revocable then
      removed
    else
      false
    end
  when Option::None then
    removed
  end
end

# ———————————————————————————————————————————————————————————————
# Effect System
# ———————————————————————————————————————————————————————————————

struct EffectContext
  # Declared effects
  effects: Map[String, EffectDefinition]
  
  # Active effect handlers
  handlers: Vec[AgenticEffectHandler]
  
  # Effects performed in current scope
  performed: Vec[PerformedEffect]
  
  # Violations (effect not handled)
  violations: Vec[EffectViolation]
end

struct EffectDefinition
  name: String
  operations: Vec[EffectOp]
  resumable: Bool
end

struct EffectOp
  name: String
  param_types: Vec[Type]
  return_type: Type
end

struct AgenticEffectHandler
  effect_name: String
  handler_fn: String
  scope: Span
end

struct PerformedEffect
  effect_name: String
  operation: String
  arguments: Vec[ContractValue]
  location: Span
end

struct EffectViolation
  effect: String
  operation: String
  location: Span
  message: String
end

def effect_context_new() -> EffectContext
  mut ctx = EffectContext {
    effects: Map::new(),
    handlers: Vec::new(),
    performed: Vec::new(),
    violations: Vec::new()
  }
  
  # Register built-in effects
  ctx.effects.insert("IO", EffectDefinition {
    name: "IO",
    operations: [
      EffectOp { name: "print", param_types: [Type::String], return_type: Type::Unit },
      EffectOp { name: "read_line", param_types: Vec::new(), return_type: Type::String }
    ],
    resumable: true
  })
  
  ctx.effects.insert("Async", EffectDefinition {
    name: "Async",
    operations: [
      EffectOp { name: "await", param_types: [Type::Unit], return_type: Type::Unit }
    ],
    resumable: true
  })
  
  ctx.effects.insert("Exception", EffectDefinition {
    name: "Exception",
    operations: [
      EffectOp { name: "throw", param_types: [Type::Unit], return_type: Type::Never }
    ],
    resumable: false
  })
  
  ctx
end

def perform_effect(inout ctx: EffectContext, effect: String, op: String, args: Vec[ContractValue], span: Span) -> Option[ContractValue]
  # Check if effect is handled
  mut handled = false
  for h in ctx.handlers do
    if h.effect_name == effect then
      handled = true
      break
    end
  end
  
  if !handled then
    ctx.violations.push(EffectViolation {
      effect: effect,
      operation: op,
      location: span,
      message: "Unhandled effect: " + effect + "::" + op
    })
    return Option::None
  end
  
  # Record the performed effect
  ctx.performed.push(PerformedEffect {
    effect_name: effect,
    operation: op,
    arguments: args,
    location: span
  })
  
  Option::Some(ContractValue::Unit)
end

def install_handler(inout ctx: EffectContext, effect: String, handler: String, span: Span) -> Unit
  ctx.handlers.push(AgenticEffectHandler {
    effect_name: effect,
    handler_fn: handler,
    scope: span
  })
end

def uninstall_handler(inout ctx: EffectContext, effect: String) -> Unit
  mut i = ctx.handlers.len()
  while i > 0 do
    i = i - 1
    if ctx.handlers[i].effect_name == effect then
      ctx.handlers.remove(i)
      return
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Budget System
# ———————————————————————————————————————————————————————————————

struct BudgetContext
  # Resource budgets
  budgets: Map[String, Budget]
  
  # Budget violations
  violations: Vec[BudgetViolation]
  
  # Tracking enabled
  tracking_enabled: Bool
end

struct Budget
  resource: String
  limit: Int
  used: Int
  rate_limit: Option[RateLimit]
end

struct RateLimit
  max_per_second: Int
  window_start: Int
  current_count: Int
end

struct BudgetViolation
  resource: String
  limit: Int
  attempted: Int
  location: Span
  message: String
end

def budget_context_new() -> BudgetContext
  mut ctx = BudgetContext {
    budgets: Map::new(),
    violations: Vec::new(),
    tracking_enabled: true
  }
  
  # Register default budgets
  ctx.budgets.insert("memory", Budget {
    resource: "memory",
    limit: 100_000_000,  # 100MB
    used: 0,
    rate_limit: Option::None
  })
  
  ctx.budgets.insert("time", Budget {
    resource: "time",
    limit: 60_000,  # 60 seconds in ms
    used: 0,
    rate_limit: Option::None
  })
  
  ctx.budgets.insert("api_calls", Budget {
    resource: "api_calls",
    limit: 1000,
    used: 0,
    rate_limit: Option::Some(RateLimit {
      max_per_second: 10,
      window_start: 0,
      current_count: 0
    })
  })
  
  ctx
end

def set_budget(inout ctx: BudgetContext, resource: String, limit: Int) -> Unit
  ctx.budgets.insert(resource, Budget {
    resource: resource,
    limit: limit,
    used: 0,
    rate_limit: Option::None
  })
end

def consume_budget(inout ctx: BudgetContext, resource: String, amount: Int, span: Span) -> Bool
  if !ctx.tracking_enabled then
    return true
  end
  
  match ctx.budgets.get_mut(resource)
  when Option::Some(budget_entry) then
    # Check rate limit
    match budget_entry.rate_limit
    when Option::Some(rl) then
      # Real monotonic-time window: the decision uses the actual clock
      # (perf_counter_ms), never an approximated time; the counter resets
      # once the 1s window elapses.
      let window_now_ms = perf_counter_ms()
      if window_now_ms - rl.window_start >= 1000 then
        rl.window_start = window_now_ms
        rl.current_count = 0
      end
      if rl.current_count >= rl.max_per_second then
        ctx.violations.push(BudgetViolation {
          resource: resource,
          limit: rl.max_per_second,
          attempted: rl.current_count + 1,
          location: span,
          message: "Rate limit exceeded for: " + resource
        })
        return false
      end
      rl.current_count = rl.current_count + 1
    when Option::None then ()
    end
    
    # Check total budget
    if budget_entry.used + amount > budget_entry.limit then
      ctx.violations.push(BudgetViolation {
        resource: resource,
        limit: budget_entry.limit,
        attempted: budget_entry.used + amount,
        location: span,
        message: "Budget exceeded for: " + resource
      })
      return false
    end
    
    budget_entry.used = budget_entry.used + amount
    true
  when Option::None then
    # Fail closed: an unregistered resource has no verified limit, so the
    # consume is DENIED and reported (never a silent allow). Register the
    # resource via set_budget to make it consumable.
    ctx.violations.push(BudgetViolation {
      resource: resource,
      limit: 0,
      attempted: amount,
      location: span,
      message: "Unknown budget resource: " + resource
    })
    false
  end
end

def get_remaining(ctx: BudgetContext, resource: String) -> Int
  match ctx.budgets.get(resource)
  when Option::Some(budget_entry) then
    budget_entry.limit - budget_entry.used
  when Option::None then
    -1  # Unknown
  end  end
end

def reset_budget(inout ctx: BudgetContext, resource: String) -> Unit
  match ctx.budgets.get_mut(resource)
  when Option::Some(budget_entry) then
    budget_entry.used = 0
    match budget_entry.rate_limit
    when Option::Some(rl) then
      rl.current_count = 0
    when Option::None then ()
    end
  when Option::None then ()
  end  end
end

# ———————————————————————————————————————————————————————————————
# Rationale Documentation
# ———————————————————————————————————————————————————————————————

struct RationaleStore
  entries: Vec[RationaleEntry]
end

struct RationaleEntry
  item_path: String
  span: Span
  details: Rationale
end

struct Rationale
  objective: String
  why: Option[String]
  how: Option[String]
  tradeoffs: Vec[String]
  alternatives: Vec[Alternative]
  references: Vec[String]
end

struct Alternative
  description: String
  reason_rejected: String
end

def rationale_store_new() -> RationaleStore
  RationaleStore { entries: Vec::new() }
end

def add_rationale(inout store: RationaleStore, path: String, span: Span, details: Rationale) -> Unit
  store.entries.push(RationaleEntry {
    item_path: path,
    span: span,
    details: details
  })
end

def get_rationale(store: RationaleStore, path: String) -> Option[Rationale]
  for entry in store.entries do
    if entry.item_path == path then
      return Option::Some(entry.details)
    end
  end
  Option::None
end

def export_rationale_markdown(store: RationaleStore) -> String
  mut parts: Vec[String] = Vec::new()
  parts.push("# Design Rationale\n\n")
  
  for entry in store.entries do
    parts.push("## " + entry.item_path + "\n\n")
    parts.push("**Objective:** " + entry.details.objective + "\n\n")
    
    match entry.details.why
    when Option::Some(why) then
      parts.push("**Why:** " + why + "\n\n")
    when Option::None then ()
    end
    
    match entry.details.how
    when Option::Some(how) then
      parts.push("**How:** " + how + "\n\n")
    when Option::None then ()
    end
    
    if !entry.details.tradeoffs.is_empty() then
      parts.push("**Tradeoffs:**\n")
      for t in entry.details.tradeoffs do
        parts.push("- " + t + "\n")
      end
      parts.push("\n")
    end
    
    if !entry.details.alternatives.is_empty() then
      parts.push("**Alternatives Considered:**\n")
      for alt in entry.details.alternatives do
        parts.push("- " + alt.description + " — rejected because: " + alt.reason_rejected + "\n")
      end
      parts.push("\n")
    end
  end
  
  parts.join("")
end

# ———————————————————————————————————————————————————————————————
# Semantic Differencing
# ———————————————————————————————————————————————————————————————

struct SemanticDiff
  changes: Vec[SemanticChange]
end

enum SemanticChange
  Added(ItemSummary)
  Removed(ItemSummary)
  Modified(ItemSummary, ItemSummary)
  Renamed(String, String, ItemSummary)
  MovedModule(String, String, ItemSummary)
  SignatureChanged(String, SignatureChange)
  ContractChanged(String, ContractChange)
  CapabilityChanged(String, CapabilityChange)
end

struct ItemSummary
  kind: String
  name: String
  visibility: String
  signature: String
end

struct SignatureChange
  old_params: Vec[String]
  new_params: Vec[String]
  old_return: String
  new_return: String
end

struct ContractChange
  added_pres: Vec[String]
  removed_pres: Vec[String]
  added_posts: Vec[String]
  removed_posts: Vec[String]
end

struct CapabilityChange
  added_caps: Vec[String]
  removed_caps: Vec[String]
end

def compute_diff(old_program: Program, new_program: Program) -> SemanticDiff
  mut changes = Vec::new()
  
  mut old_items = Map::new()
  for item in old_program.items do
    old_items.insert(item_name(&item), item)
  end
  
  mut new_items = Map::new()
  for item in new_program.items do
    new_items.insert(item_name(&item), item)
  end
  
  # Find added items
  for (name, item) in new_items do
    if !old_items.contains_key(name) then
      changes.push(SemanticChange::Added(summarize_item(&item)))
    end
  end
  
  # Find removed items
  for (name, item) in old_items do
    if !new_items.contains_key(name) then
      changes.push(SemanticChange::Removed(summarize_item(&item)))
    end
  end
  
  # Find modified items
  for (name, new_item) in new_items do
    match old_items.get(name)
    when Option::Some(old_item) then
      if !items_equal(&old_item, &new_item) then
        changes.push(SemanticChange::Modified(
          summarize_item(&old_item),
          summarize_item(&new_item)
        ))
      end
    when Option::None then ()
    end
  end
  
  SemanticDiff { changes: changes }
end

def item_name(item: Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then f.name
  when ItemKind::ItemStruct(s) then s.name
  when ItemKind::ItemEnum(e) then e.name
  when ItemKind::ItemTrait(t) then t.name
  when ItemKind::ItemTypeAlias(ta) then ta.name
  when ItemKind::ItemConst(c) then c.name
  when ItemKind::ItemStatic(s) then s.name
  when _ then "<anonymous>"
  end  end
end

def summarize_item(item: Item) -> ItemSummary
  let kind_str = match item.kind
  when ItemKind::ItemFunction(_) then "function"
  when ItemKind::ItemStruct(_) then "struct"
  when ItemKind::ItemEnum(_) then "enum"
  when ItemKind::ItemTrait(_) then "trait"
  when ItemKind::ItemImpl(_) then "impl"
  when ItemKind::ItemModule(_) then "module"
  when ItemKind::ItemUse(_) then "use"
  when ItemKind::ItemMacro(_) then "macro"
  when ItemKind::ItemTypeAlias(_) then "type_alias"
  when ItemKind::ItemConst(_) then "const"
  when ItemKind::ItemStatic(_) then "static"
  when ItemKind::ItemCapabilityDecl(_) then "capability"
  when ItemKind::ItemEffectDecl(_) then "effect"
  when ItemKind::ItemRationaleBlock(_) then "rationale"
  when ItemKind::ItemExternBlock(_) then "extern"
  when _ then "unknown"
  end

  let sig = compute_item_signature(item)

  ItemSummary {
    kind: kind_str.to_string(),
    name: item_name(item),
    visibility: if item.is_pub then "pub" else "priv" end,
    signature: sig
  }
end

def compute_item_signature(item: Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then
    mut sig = "def " + f.name.clone()
    sig = sig + "("
    mut first = true
    for p in f.params do
      if !first then sig = sig + ", " end
      sig = sig + p.name.clone()
      match p.ty
      when Option::Some(ty) then
        sig = sig + ": " + type_expr_to_string(&ty)
      when Option::None then ()
      end
      first = false
    end
    sig = sig + ")"
    match f.ret_type
    when Option::Some(ret) then
      sig = sig + " -> " + type_expr_to_string(&ret)
    when Option::None then ()
    end
    sig
  when ItemKind::ItemStruct(s) then
    mut sig = "struct " + s.name.clone()
    if !s.generic_params.is_empty() then
      sig = sig + "["
      mut first = true
      for g in s.generic_params do
        if !first then sig = sig + ", " end
        sig = sig + g.name.clone()
        first = false
      end
      sig = sig + "]"
    end
    sig
  when ItemKind::ItemEnum(e) then
    mut sig = "enum " + e.name.clone()
    if !e.generic_params.is_empty() then
      sig = sig + "["
      mut first = true
      for g in e.generic_params do
        if !first then sig = sig + ", " end
        sig = sig + g.name.clone()
        first = false
      end
      sig = sig + "]"
    end
    sig
  when ItemKind::ItemTrait(t) then
    "trait " + t.name.clone()
  when ItemKind::ItemImpl(i) then
    mut sig = "impl "
    match i.trait_name
    when Option::Some(tr) then
      sig = sig + tr + " for "
    when Option::None then ()
    end
    sig = sig + type_expr_to_string(&i.self_type)
    sig
  when ItemKind::ItemTypeAlias(ta) then
    "type " + ta.name.clone()
  when ItemKind::ItemConst(c) then
    "const " + c.name.clone()
  when ItemKind::ItemStatic(s) then
    "static " + s.name.clone()
  when _ then
    item_name(item)
  end  end
end

def type_expr_to_string(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      mut parts: Vec[String] = Vec::new()
      parts.push(name.clone() + "[")
      mut first = true
      for a in args do
        if !first then parts.push(", ") end
        parts.push(type_expr_to_string(&a))
        first = false
      end
      parts.push("]")
      parts.join("")
    end
  when TypeExprKind::Tuple(elems) then
    mut parts: Vec[String] = Vec::new()
    parts.push("(")
    mut first = true
    for e in elems do
      if !first then parts.push(", ") end
      parts.push(type_expr_to_string(&e))
      first = false
    end
    parts.push(")")
    parts.join("")
  when TypeExprKind::Array(elem, size) then
    "[" + type_expr_to_string(&elem) + "; ...]"
  when TypeExprKind::Slice(elem) then
    "[" + type_expr_to_string(&elem) + "]"
  when TypeExprKind::Fn(params, ret) then
    mut parts: Vec[String] = Vec::new()
    parts.push("fn(")
    mut first = true
    for p in params do
      if !first then parts.push(", ") end
      match p.convention
      when AccessConvention::Inout then parts.push("inout ")
      when AccessConvention::Sink then parts.push("sink ")
      when AccessConvention::Set then parts.push("set ")
      when AccessConvention::Let then ()
      end
      parts.push(type_expr_to_string(&p.ty))
      first = false
    end
    parts.push(") -> " + type_expr_to_string(&ret))
    parts.join("")
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Infer then "_"
  when TypeExprKind::ConstArg(v) then v.to_string()
  when TypeExprKind::ConstExpr(_) then "<const-expr>"
  when _ then "?"
  end  end
end

def items_equal(a: Item, b: Item) -> Bool
  # ADVISORY equality heuristic for semantic differencing — deliberately
  # approximate, NOT verification. Same kind + name, then: parameter names
  # and the rendered signature for functions; field/variant/generic counts
  # for structs/enums; kind + name for the remaining item kinds. A `true`
  # means "this differencing heuristic detected no change", never "the
  # items are proven equivalent".

  # First check: same item kind discriminant
  let a_kind = match a.kind
  when ItemKind::ItemFunction(_) then 0
  when ItemKind::ItemStruct(_) then 1
  when ItemKind::ItemEnum(_) then 2
  when ItemKind::ItemTrait(_) then 3
  when ItemKind::ItemImpl(_) then 4
  when ItemKind::ItemModule(_) then 5
  when ItemKind::ItemUse(_) then 6
  when ItemKind::ItemMacro(_) then 7
  when ItemKind::ItemTypeAlias(_) then 8
  when ItemKind::ItemConst(_) then 9
  when ItemKind::ItemStatic(_) then 10
  when ItemKind::ItemCapabilityDecl(_) then 11
  when ItemKind::ItemEffectDecl(_) then 12
  when ItemKind::ItemRationaleBlock(_) then 13
  when ItemKind::ItemExternBlock(_) then 14
  when _ then -1
  end
  
  let b_kind = match b.kind
  when ItemKind::ItemFunction(_) then 0
  when ItemKind::ItemStruct(_) then 1
  when ItemKind::ItemEnum(_) then 2
  when ItemKind::ItemTrait(_) then 3
  when ItemKind::ItemImpl(_) then 4
  when ItemKind::ItemModule(_) then 5
  when ItemKind::ItemUse(_) then 6
  when ItemKind::ItemMacro(_) then 7
  when ItemKind::ItemTypeAlias(_) then 8
  when ItemKind::ItemConst(_) then 9
  when ItemKind::ItemStatic(_) then 10
  when ItemKind::ItemCapabilityDecl(_) then 11
  when ItemKind::ItemEffectDecl(_) then 12
  when ItemKind::ItemRationaleBlock(_) then 13
  when ItemKind::ItemExternBlock(_) then 14
  when _ then -1
  end
  
  if a_kind != b_kind then
    return false
  end
  
  # Same kind — compare names
  let a_name = item_name(a)
  let b_name = item_name(b)
  if a_name != b_name then
    return false
  end
  
  # Deep comparison by kind
  match a.kind
  when ItemKind::ItemFunction(fa) then
    match b.kind
    when ItemKind::ItemFunction(fb) then
      # Compare parameter counts, names, and return types
      if fa.params.len() != fb.params.len() then return false end
      mut i = 0
      while i < fa.params.len() do
        let pa = fa.params[i]
        let pb = fb.params[i]
        if pa.name != pb.name then return false end
        i = i + 1
      end
      # Compare signatures (approximate via string)
      let sig_a = compute_item_signature(a)
      let sig_b = compute_item_signature(b)
      sig_a == sig_b
    when _ then false
    end
  when ItemKind::ItemStruct(sa) then
    match b.kind
    when ItemKind::ItemStruct(sb) then
      sa.fields.len() == sb.fields.len() &&
        sa.generic_params.len() == sb.generic_params.len()
    when _ then false
    end
  when ItemKind::ItemEnum(ea) then
    match b.kind
    when ItemKind::ItemEnum(eb) then
      ea.variants.len() == eb.variants.len() &&
        ea.generic_params.len() == eb.generic_params.len()
    when _ then false
    end
  when _ then
    # For other item kinds, name + kind equality is sufficient
    true
  end
end

def format_diff(diff: SemanticDiff) -> String
  mut parts: Vec[String] = Vec::new()
  
  for change in diff.changes do
    match change
    when SemanticChange::Added(item) then
      parts.push("+ " + item.visibility + " " + item.kind + " " + item.name + "\n")
    when SemanticChange::Removed(item) then
      parts.push("- " + item.visibility + " " + item.kind + " " + item.name + "\n")
    when SemanticChange::Modified(old, new) then
      parts.push("~ " + old.kind + " " + old.name + "\n")
    when SemanticChange::Renamed(old_name, new_name, item) then
      parts.push("~ " + item.kind + " " + old_name + " => " + new_name + "\n")
    when SemanticChange::SignatureChanged(name, sig) then
      parts.push("~ signature of " + name + "\n")
    when _ then ()
    end
  end
  
  parts.join("")
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

struct AgenticContext
  capabilities: CapabilityContext
  effects: EffectContext
  budgets: BudgetContext
  rationale_store: RationaleStore
end

def agentic_context_new() -> AgenticContext
  AgenticContext {
    capabilities: cap_context_new(),
    effects: effect_context_new(),
    budgets: budget_context_new(),
    rationale_store: rationale_store_new()
  }
end

# ADVISORY static lint (deliberately incomplete, SOUND in the reporting
# direction): true only for a syntactically `false` / `!true` expression;
# every other expression yields false ("not trivially false"). It never
# claims a contract HOLDS, so it is neither a verifier nor a second
# contract authority — the canonical MIR ContractCheck (see
# contract_evaluation_authority) is the ONE authority. Used by
# analyze_agentic_features to flag definitely-unsatisfiable clauses.
def contract_expr_trivially_false(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprBoolLit(b) then !b
  when ExprKind::ExprUnaryOp(op, inner) then
    match op
    when UnOp::Not then
      match inner.kind
      when ExprKind::ExprBoolLit(v) then v
      when _ then false
      end
    when _ then false
    end
  when _ then false
  end  end
end

def analyze_agentic_features(inout ctx: AgenticContext, program: Program) -> Vec[String]
  mut errors = Vec::new()

  # Pass 1: Register declarations so function checks are order-independent.
  for item in program.items do
    match item.kind
    when ItemKind::ItemCapabilityDecl(c) then
      # Register capability
      ctx.capabilities.grants.insert(c.name.clone(), CapabilityGrant {
        name: c.name,
        parent: c.parent,
        implied_caps: c.permissions,
        revocable: true
      })
      # Make declared capability available for subsequent validation in this program.
      grant_capability(&mut ctx.capabilities, c.name.clone(), CapabilityScope::Global)
    when ItemKind::ItemEffectDecl(e) then
      # Register effect
      ctx.effects.effects.insert(e.name.clone(), EffectDefinition {
        name: e.name,
        operations: Vec::new(),
        resumable: true
      })
    when _ then ()
    end
  end

  # Pass 2: Validate function-level requirements against registered declarations.
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      # Check contracts are valid
      for c in f.contracts do
        match c.kind
        when AstContractKind::AstPre then
          if contract_expr_trivially_false(&c.expr) then
            errors.push("Function " + f.name + " has unsatisfiable precondition")
          end
        when AstContractKind::AstPost then
          if contract_expr_trivially_false(&c.expr) then
            errors.push("Function " + f.name + " has unsatisfiable postcondition")
          end
        when AstContractKind::AstInvariant then
          if contract_expr_trivially_false(&c.expr) then
            errors.push("Function " + f.name + " has unsatisfiable invariant")
          end
        when _ then ()
        end
      end

      # Check capabilities are available
      for cap in f.required_caps do
        if !check_capability(&ctx.capabilities, cap) then
          errors.push("Function " + f.name + " requires unavailable capability: " + cap)
        end
      end

      # Check declared effects exist
      for eff in f.effects do
        if !ctx.effects.effects.contains_key(eff) then
          errors.push("Function " + f.name + " references unknown effect: " + eff)
        end
      end
    when _ then ()
    end
  end
  
  errors
end
