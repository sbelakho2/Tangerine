# Tangerine Compiler — Borrow Checker
# Self-hosting compiler written in Tangerine
#
# Complete memory safety analysis with:
# - Ownership tracking
# - Borrow checking (immutable and mutable)
# - Lifetime inference and validation
# - Move semantics
# - Drop insertion

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::token::{Span}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind,
  Param, ParamModifier
}
use tg_compiler::types::{Type, Lifetime, lifetime_static, lifetime_anonymous}

# ———————————————————————————————————————————————————————————————
# Ownership State
# ———————————————————————————————————————————————————————————————

enum OwnershipState
  Owned           # Variable owns the value
  Borrowed        # Immutably borrowed
  BorrowedMut     # Mutably borrowed
  Moved           # Value has been moved out
  Dropped         # Value has been dropped
  Invalid         # Invalid state (for error recovery)
end

struct VarState
  name: String
  ty: Type
  ownership: OwnershipState
  borrow_count: Int
  mut_borrow_count: Int
  lifetime: Lifetime
  span: Span
  is_copy: Bool
end

def var_state_new(name: String, ty: Type, span: Span) -> VarState
  VarState {
    name: name,
    ty: ty,
    ownership: OwnershipState::Owned,
    borrow_count: 0,
    mut_borrow_count: 0,
    lifetime: lifetime_static(),
    span: span,
    is_copy: is_copy_type(&ty)
  }
end

def is_copy_type(ty: &Type) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::Ref(_, _) then true
  when Type::Tuple(elems) then
    mut all_copy = true
    for e in elems do
      if !is_copy_type(&e) then
        all_copy = false
        break
      end
    end
    all_copy
  when _ then false
  end
end

# Resolve a type expression AST node to a compiler Type for borrow analysis
def resolve_type_expr_for_borrow(ty_expr: &TypeExpr) -> Type
  match ty_expr.kind
  when TypeExprKind::Named(name, args) then
    if name == "Int" then Type::Int
    elsif name == "UInt" then Type::UInt
    elsif name == "Float" then Type::Float
    elsif name == "Bool" then Type::Bool
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "Unit" then Type::Unit
    elsif name == "Vec" then
      let elem = if args.len() > 0 then resolve_type_expr_for_borrow(&args[0])
      else Type::Unit
      end
      Type::Array(elem, 0)
    elsif name == "Map" then
      let k = if args.len() > 0 then resolve_type_expr_for_borrow(&args[0]) else Type::Unit end
      let v = if args.len() > 1 then resolve_type_expr_for_borrow(&args[1]) else Type::Unit end
      Type::Map(k, v)
    elsif name == "Option" then
      let inner = if args.len() > 0 then resolve_type_expr_for_borrow(&args[0]) else Type::Unit end
      Type::Option(inner)
    elsif name == "Result" then
      let ok = if args.len() > 0 then resolve_type_expr_for_borrow(&args[0]) else Type::Unit end
      let err = if args.len() > 1 then resolve_type_expr_for_borrow(&args[1]) else Type::Unit end
      Type::Result(ok, err)
    else
      # User-defined types are resolved by the type checker; keep borrow checker conservative.
      Type::Error
    end
  when TypeExprKind::Ref(inner) then
    Type::Ref(resolve_type_expr_for_borrow(inner), lifetime_anonymous())
  when TypeExprKind::RefMut(inner) then
    Type::RefMut(resolve_type_expr_for_borrow(inner), lifetime_anonymous())
  when TypeExprKind::Tuple(elems) then
    mut resolved = Vec::new()
    for e in elems do
      resolved.push(resolve_type_expr_for_borrow(&e))
    end
    Type::Tuple(resolved)
  when TypeExprKind::Array(elem, size) then
    Type::Array(resolve_type_expr_for_borrow(elem), size)
  when TypeExprKind::Fn(params, ret) then
    mut resolved_params = Vec::new()
    for p in params do
      resolved_params.push(resolve_type_expr_for_borrow(&p))
    end
    Type::Function(resolved_params, resolve_type_expr_for_borrow(ret))
  when TypeExprKind::Unit then Type::Unit
  when _ then Type::Unit
  end
end

# Infer the type of an expression for borrow checking purposes
def infer_expr_type(ctx: &BorrowCtx, expr: &Expr) -> Type
  match expr.kind
  when ExprKind::IntLit(_) then Type::Int
  when ExprKind::FloatLit(_) then Type::Float
  when ExprKind::StringLit(_) then Type::String
  when ExprKind::BoolLit(_) then Type::Bool
  when ExprKind::CharLit(_) then Type::Char
  when ExprKind::Ident(name) then
    match ctx.vars.get(name)
    when Option::Some(vs) then vs.ty.clone()
    when Option::None then Type::Unit
    end
  when ExprKind::Ref(inner) then
    Type::Ref(infer_expr_type(ctx, inner), lifetime_anonymous())
  when ExprKind::RefMut(inner) then
    Type::RefMut(infer_expr_type(ctx, inner), lifetime_anonymous())
  when ExprKind::Tuple(elems) then
    mut types = Vec::new()
    for e in elems do
      types.push(infer_expr_type(ctx, &e))
    end
    Type::Tuple(types)
  when ExprKind::Call(_, _) then Type::Unit
  when ExprKind::MethodCall(recv, _, _, _) then
    infer_expr_type(ctx, recv)
  when ExprKind::BinaryOp(_, left, _) then
    infer_expr_type(ctx, left)
  when ExprKind::UnaryOp(_, inner) then
    infer_expr_type(ctx, inner)
  when ExprKind::Array(elems) then
    if elems.len() > 0 then
      Type::Array(infer_expr_type(ctx, &elems[0]), elems.len())
    else
      Type::Array(Type::Unit, 0)
    end
  when _ then Type::Unit
  end
end

# Extract the element type from a collection/iterator type
def extract_iter_element_type(ty: &Type) -> Type
  match ty
  when Type::Array(elem, _) then elem.clone()
  when Type::Slice(elem) then elem.clone()
  when Type::Named(_, args) then
    # Vec[T], Set[T], etc: first generic arg is the element type
    if args.len() > 0 then
      args[0].clone()
    else
      Type::Unit
    end
  when Type::String then Type::Char
  when _ then Type::Unit
  end
end

# ———————————————————————————————————————————————————————————————
# Borrow Information
# ———————————————————————————————————————————————————————————————

struct Borrow
  id: Int
  kind: BorrowKind
  target: String
  lifetime: Lifetime
  span: Span
end

enum BorrowKind
  Immutable
  Mutable
end

struct BorrowSet
  borrows: Vec[Borrow]
  next_id: Int
end

def borrow_set_new() -> BorrowSet
  BorrowSet { borrows: Vec::new(), next_id: 0 }
end

def add_borrow(bs: &mut BorrowSet, kind: BorrowKind, target: String, lifetime: Lifetime, span: Span) -> Int
  let id = bs.next_id
  bs.next_id = bs.next_id + 1
  bs.borrows.push(Borrow {
    id: id,
    kind: kind,
    target: target,
    lifetime: lifetime,
    span: span
  })
  id
end

def end_borrow(bs: &mut BorrowSet, id: Int) -> Unit
  mut i = 0
  while i < bs.borrows.len() do
    if bs.borrows[i].id == id then
      bs.borrows.remove(i)
      return
    end
    i = i + 1
  end
end

def has_mut_borrow(bs: &BorrowSet, target: String) -> Bool
  for b in bs.borrows do
    match b.kind
    when BorrowKind::Mutable then
      if b.target == target then
        return true
      end
    when _ then ()
    end
  end
  false
end

def has_any_borrow(bs: &BorrowSet, target: String) -> Bool
  for b in bs.borrows do
    if b.target == target then
      return true
    end
  end
  false
end

def count_borrows(bs: &BorrowSet, target: String) -> Int
  mut count = 0
  for b in bs.borrows do
    if b.target == target then
      count = count + 1
    end
  end
  count
end

# Collect all variable names that are borrowed in a block (for loop borrow tracking)
def collect_borrows_in_block(block: &Block) -> Vec[String]
  mut names = Vec::new()
  for stmt in block.stmts do
    collect_borrows_in_stmt(&stmt, &mut names)
  end
  names
end

def collect_borrows_in_stmt(stmt: &Stmt, names: &mut Vec[String]) -> Unit
  match stmt.kind
  when StmtKind::Let(pattern, _, _, _) then
    match pattern.kind
    when PatternKind::Ident(name, _) then names.push(name.clone())
    when _ then ()
    end
  when StmtKind::Expr(expr) then
    collect_borrows_in_expr(&expr, names)
  when StmtKind::If(if_stmt) then
    collect_borrows_in_block(&if_stmt.then_block)
      .iter().for_each(|n| names.push(n))
    match if_stmt.else_block
    when Option::Some(eb) then
      collect_borrows_in_block(&eb).iter().for_each(|n| names.push(n))
    when Option::None then ()
    end
  when StmtKind::While(_, body) then
    collect_borrows_in_block(&body).iter().for_each(|n| names.push(n))
  when StmtKind::For(var, _, body) then
    names.push(var.clone())
    collect_borrows_in_block(&body).iter().for_each(|n| names.push(n))
  when _ then ()
  end
end

def collect_borrows_in_expr(expr: &Expr, names: &mut Vec[String]) -> Unit
  match expr.kind
  when ExprKind::Ref(inner) then
    match inner.kind
    when ExprKind::Ident(name) then names.push(name.clone())
    when _ then collect_borrows_in_expr(&inner, names)
    end
  when ExprKind::RefMut(inner) then
    match inner.kind
    when ExprKind::Ident(name) then names.push(name.clone())
    when _ then collect_borrows_in_expr(&inner, names)
    end

  when ExprKind::Call(callee, args) then
    collect_borrows_in_expr(&callee, names)
    for a in args do
      collect_borrows_in_expr(&a, names)
    end

  when ExprKind::MethodCall(recv, _, _, args) then
    collect_borrows_in_expr(&recv, names)
    for a in args do
      collect_borrows_in_expr(&a, names)
    end

  when ExprKind::BinaryOp(_, left, right) then
    collect_borrows_in_expr(&left, names)
    collect_borrows_in_expr(&right, names)

  when ExprKind::UnaryOp(_, inner) then
    collect_borrows_in_expr(&inner, names)

  when ExprKind::FieldAccess(recv, _) then
    collect_borrows_in_expr(&recv, names)

  when ExprKind::Index(recv, index) then
    collect_borrows_in_expr(&recv, names)
    collect_borrows_in_expr(&index, names)

  when ExprKind::Assign(target, value) then
    collect_borrows_in_expr(&target, names)
    collect_borrows_in_expr(&value, names)

  when ExprKind::ArrayLit(elems) then
    for e in elems do
      collect_borrows_in_expr(&e, names)
    end

  when ExprKind::TupleLit(elems) then
    for e in elems do
      collect_borrows_in_expr(&e, names)
    end

  when ExprKind::StructLit(_, fields) then
    for (_, val) in fields do
      collect_borrows_in_expr(&val, names)
    end

  when ExprKind::If(if_stmt) then
    collect_borrows_in_expr(&if_stmt.cond, names)

  when ExprKind::Match(m) then
    collect_borrows_in_expr(&m.scrutinee, names)

  when ExprKind::Await(inner) then
    collect_borrows_in_expr(&inner, names)

  when ExprKind::Try(inner) then
    collect_borrows_in_expr(&inner, names)

  when ExprKind::Pipe(left, right) then
    collect_borrows_in_expr(&left, names)
    collect_borrows_in_expr(&right, names)

  when _ then ()
  end
end

# Invalidate all borrows of a given target (used at loop boundaries)
def invalidate_borrow(ctx: &mut BorrowCtx, target: &String, span: Span) -> Unit
  mut i = 0
  while i < ctx.borrows.borrows.len() do
    if ctx.borrows.borrows[i].target == *target then
      ctx.borrows.borrows.remove(i)
      # Don't increment i since we removed an element
    else
      i = i + 1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Borrow Checker Context
# ———————————————————————————————————————————————————————————————

struct BorrowCtx
  # Variable state tracking
  vars: Map[String, VarState]
  
  # Active borrows
  borrows: BorrowSet
  
  # Lifetime management
  lifetime_counter: Int
  current_lifetime: Lifetime
  
  # Scope stack for drops
  scope_stack: Vec[Vec[String]]
  
  # Error collection
  errors: Vec[BorrowError]
  warnings: Vec[BorrowError]
  
  # Configuration
  unsafe_context: Bool
  
  # Unsafe audit trail
  unsafe_audit: Vec[UnsafeUsage]
  current_file: String
  current_function: String
  source: String
end

# ———————————————————————————————————————————————————————————————
# Unsafe Audit Infrastructure
# ———————————————————————————————————————————————————————————————

enum UnsafeOperation
  RawPointerDeref
  FfiCall(String)
  MutableStaticAccess(String)
  UnionFieldAccess
  InlineAssembly
  TransmuteCall
  UncheckedArithmetic
  RawPointerArithmetic
end

struct UnsafeUsage
  span: Span
  file: String
  line: Int
  column: Int
  reason: String
  operations: Vec[UnsafeOperation]
  function_name: String
end

def collect_unsafe_operations(block: &Block, ops: &mut Vec[UnsafeOperation]) -> Unit
  for stmt in block.stmts do
    collect_unsafe_ops_stmt(stmt, ops)
  end
end

def collect_unsafe_ops_stmt(stmt: &Stmt, ops: &mut Vec[UnsafeOperation]) -> Unit
  match stmt.kind
  when StmtKind::Expr(expr) then collect_unsafe_ops_expr(expr, ops)
  when StmtKind::Let(_, _, init, _) then
    collect_unsafe_ops_expr(init, ops)
  when _ then ()
  end
end

def collect_unsafe_ops_expr(expr: &Expr, ops: &mut Vec[UnsafeOperation]) -> Unit
  match expr.kind
  when ExprKind::Deref(inner) then
    match inner.kind
    when ExprKind::Ident(_) then ops.push(UnsafeOperation::RawPointerDeref)
    when _ then ()
    end
    collect_unsafe_ops_expr(inner, ops)
  when ExprKind::Call(callee, args) then
    match callee.kind
    when ExprKind::Ident(name) then
      if name == "transmute" || name == "std::mem::transmute" then
        ops.push(UnsafeOperation::TransmuteCall)
      end
    when ExprKind::Path(path) then
      if path.segments.len() > 0 && path.segments[0] == "ffi" then
        let ffi_name = path.segments[path.segments.len() - 1].clone()
        ops.push(UnsafeOperation::FfiCall(ffi_name))
      end
    when ExprKind::FieldAccess(_, field) then
      if field == "offset" || field == "add" || field == "sub" then
        ops.push(UnsafeOperation::RawPointerArithmetic)
      end
    when _ then ()
    end
    collect_unsafe_ops_expr(callee, ops)
    for a in args do collect_unsafe_ops_expr(a, ops) end
  when ExprKind::BinaryOp(_, l, r) then
    collect_unsafe_ops_expr(l, ops)
    collect_unsafe_ops_expr(r, ops)
  when ExprKind::Assign(l, r) then
    collect_unsafe_ops_expr(l, ops)
    collect_unsafe_ops_expr(r, ops)
  when _ then ()
  end
end

def offset_to_line_col(source: &String, offset: Int) -> (Int, Int)
  mut line = 1
  mut col = 1
  mut i = 0
  while i < offset && i < source.len() do
    if source.char_at(i) == '\n' then
      line = line + 1
      col = 1
    else
      col = col + 1
    end
    i = i + 1
  end
  (line, col)
end

def generate_unsafe_report(audit: &Vec[UnsafeUsage]) -> String
  mut report = "# Unsafe Audit Report\n\n"
  report = report + "Total unsafe blocks: " + audit.len().to_string() + "\n\n"
  
  mut by_file = Map::new()
  for usage in audit do
    match by_file.get_mut(usage.file.clone())
    when Option::Some(list) then list.push(usage)
    when Option::None then
      mut list = Vec::new()
      list.push(usage)
      by_file.insert(usage.file.clone(), list)
    end
  end
  
  for entry in by_file do
    report = report + "## " + entry.key + "\n\n"
    for usage in entry.value do
      report = report + "- **Line " + usage.line.to_string() + "** in `" + usage.function_name + "`"
      if !usage.reason.is_empty() then
        report = report + " — reason: \"" + usage.reason + "\""
      else
        report = report + " — **no reason documented**"
      end
      report = report + "\n"
      for op in usage.operations do
        let op_str = match op
        when UnsafeOperation::RawPointerDeref then "raw pointer dereference"
        when UnsafeOperation::FfiCall(name) then "FFI call: " + name
        when UnsafeOperation::MutableStaticAccess(name) then "mutable static access: " + name
        when UnsafeOperation::UnionFieldAccess then "union field access"
        when UnsafeOperation::InlineAssembly then "inline assembly"
        when UnsafeOperation::TransmuteCall then "transmute call"
        when UnsafeOperation::UncheckedArithmetic then "unchecked arithmetic"
        when UnsafeOperation::RawPointerArithmetic then "raw pointer arithmetic"
        end
        report = report + "  - " + op_str + "\n"
      end
    end
    report = report + "\n"
  end
  
  report
end

struct BorrowError
  kind: BorrowErrorKind
  message: String
  span: Span
  notes: Vec[String]
  code: String
end

# Stable error codes for borrow checking:
#   E0300 — Use after move
#   E0301 — Use after drop
#   E0302 — Cannot borrow as mutable more than once
#   E0303 — Cannot borrow as mutable while borrowed as immutable
#   E0304 — Cannot borrow as immutable while borrowed as mutable
#   E0305 — Cannot move while borrowed
#   E0306 — Lifetime error (borrow outlives owner)
#   E0307 — Cannot assign to immutable variable
#   E0308 — Cannot borrow immutable as mutable
#   E0309 — Warning (lint-style)
def error_code_for_kind(kind: BorrowErrorKind) -> String
  match kind
  when BorrowErrorKind::UseAfterMove then "E0300"
  when BorrowErrorKind::UseAfterDrop then "E0301"
  when BorrowErrorKind::DoubleMutBorrow then "E0302"
  when BorrowErrorKind::MutBorrowWhileShared then "E0303"
  when BorrowErrorKind::SharedBorrowWhileMut then "E0304"
  when BorrowErrorKind::MovedWhileBorrowed then "E0305"
  when BorrowErrorKind::LifetimeError then "E0306"
  when BorrowErrorKind::AssignToImmutable then "E0307"
  when BorrowErrorKind::MutBorrowOfImmutable then "E0308"
  when BorrowErrorKind::Warning then "W0300"
  end
end

enum BorrowErrorKind
  UseAfterMove
  UseAfterDrop
  DoubleMutBorrow
  MutBorrowWhileShared
  SharedBorrowWhileMut
  MovedWhileBorrowed
  LifetimeError
  AssignToImmutable
  MutBorrowOfImmutable
  Warning
end

def ctx_new() -> BorrowCtx
  BorrowCtx {
    vars: Map::new(),
    borrows: borrow_set_new(),
    lifetime_counter: 1,
    current_lifetime: lifetime_static(),
    scope_stack: Vec::new(),
    errors: Vec::new(),
    warnings: Vec::new(),
    unsafe_context: false,
    unsafe_audit: Vec::new(),
    current_file: "".to_string(),
    current_function: "".to_string(),
    source: "".to_string()
  }
end

def push_scope(ctx: &mut BorrowCtx) -> Unit
  ctx.scope_stack.push(Vec::new())
end

def pop_scope(ctx: &mut BorrowCtx) -> Unit
  match ctx.scope_stack.pop()
  when Option::Some(vars) then
    # Drop all variables in this scope
    for name in vars do
      drop_var(ctx, name)
    end
  when Option::None then ()
  end
end

def fresh_lifetime(ctx: &mut BorrowCtx) -> Lifetime
  let id = ctx.lifetime_counter
  ctx.lifetime_counter = ctx.lifetime_counter + 1
  Lifetime { id: id, name: "'a" + id.to_string() }
end

def add_var(ctx: &mut BorrowCtx, name: String, ty: Type, span: Span) -> Unit
  let state = var_state_new(name, ty, span)
  ctx.vars.insert(name, state)
  
  # Track in current scope for drop
  if !ctx.scope_stack.is_empty() then
    let idx = ctx.scope_stack.len() - 1
    ctx.scope_stack[idx].push(name)
  end
end

def drop_var(ctx: &mut BorrowCtx, name: String) -> Unit
  # Dropping a variable ends all active borrows rooted at that variable.
  invalidate_borrow(ctx, &name, span_dummy())

  match ctx.vars.get_mut(name)
  when Option::Some(state) then
    state.borrow_count = 0
    state.mut_borrow_count = 0

    match state.ownership
    when OwnershipState::Moved then ()  # Already moved, nothing to drop
    when OwnershipState::Dropped then ()  # Already dropped
    when _ then
      state.ownership = OwnershipState::Dropped
    end
  when Option::None then ()
  end
end

def add_error(ctx: &mut BorrowCtx, kind: BorrowErrorKind, msg: String, span: Span) -> Unit
  ctx.errors.push(BorrowError {
    kind: kind,
    message: msg,
    span: span,
    notes: Vec::new(),
    code: error_code_for_kind(kind)
  })
end

def add_error_with_note(ctx: &mut BorrowCtx, kind: BorrowErrorKind, msg: String, span: Span, note: String) -> Unit
  mut notes = Vec::new()
  notes.push(note)
  ctx.errors.push(BorrowError {
    kind: kind,
    message: msg,
    span: span,
    notes: notes,
    code: error_code_for_kind(kind)
  })
end

# ———————————————————————————————————————————————————————————————
# Borrow Check Analysis
# ———————————————————————————————————————————————————————————————

def check_program(program: &Program) -> Vec[BorrowError]
  mut ctx = ctx_new()
  
  for item in program.items do
    check_item(&mut ctx, &item)
  end
  
  ctx.errors
end

def check_item(ctx: &mut BorrowCtx, item: &Item) -> Unit
  match item.kind
  when ItemKind::Function(f) then
    check_function(ctx, &f)
  when ItemKind::Impl(i) then
    for m in i.methods do
      check_function(ctx, &m)
    end
  when _ then ()
  end
end

def check_function(ctx: &mut BorrowCtx, f: &FunctionDecl) -> Unit
  push_scope(ctx)
  
  # Add parameters to context with resolved types
  for p in f.params do
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_type_expr_for_borrow(&ty_expr)
    when Option::None then Type::Unit
    end
    add_var(ctx, p.name, ty, f.span)
    
    # Handle parameter modifiers
    match p.modifier
    when Option::Some(modifier) then
      match modifier
      when ParamModifier::Ref then
        ctx.vars[p.name].ownership = OwnershipState::Borrowed
      when ParamModifier::RefMut then
        ctx.vars[p.name].ownership = OwnershipState::BorrowedMut
      when ParamModifier::Move then
        ()  # Already owned
      when ParamModifier::Copy then
        ctx.vars[p.name].is_copy = true
      when _ then ()
      end
    when Option::None then ()
    end
  end
  
  # Check body
  match f.body
  when FnBody::Block(block) then
    check_block(ctx, &block)
  when FnBody::Expr(expr) then
    check_expr(ctx, &expr)
  when _ then ()
  end
  
  pop_scope(ctx)
end

def check_block(ctx: &mut BorrowCtx, block: &Block) -> Unit
  push_scope(ctx)

  for i in 0..block.stmts.len() do
    let stmt = &block.stmts[i]
    check_stmt(ctx, &stmt)
    end_dead_borrows_after_stmt(ctx, block, i, stmt.span)
  end
  
  pop_scope(ctx)
end

def end_dead_borrows_after_stmt(ctx: &mut BorrowCtx, block: &Block, stmt_idx: UInt, span: Span) -> Unit
  let mut candidates = Set::new()
  for b in &ctx.borrows.borrows do
    candidates.insert(b.target.clone())
  end

  for name in candidates do
    let mut used_later = false
    let mut j = stmt_idx + 1
    while j < block.stmts.len() do
      if stmt_uses_var(&block.stmts[j], &name) then
        used_later = true
        break
      end
      j = j + 1
    end

    if !used_later then
      invalidate_borrow(ctx, &name, span)
    end
  end
end

def check_stmt(ctx: &mut BorrowCtx, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::Let(pattern, ty_opt, value, is_mut) then
    # Check value expression (may consume values)
    check_expr(ctx, &value)
    
    # Resolve type from annotation or infer from value
    let ty = match ty_opt
    when Option::Some(ty_expr) then
      resolve_type_expr_for_borrow(ty_expr)
    when Option::None then
      # Infer from value expression
      infer_expr_type(ctx, &value)
    end
    match pattern.kind
    when PatternKind::Ident(name, _) then
      add_var(ctx, name, ty, stmt.span)
    when _ then ()
    end
    
    if is_mut then
      # Mark as mutable (can be mutably borrowed)
      ()
    end
    
  when StmtKind::Assign(target, value) then
    # Check that target is mutable and not borrowed
    check_assign_target(ctx, &target, stmt.span)
    check_expr(ctx, &value)
    
  when StmtKind::If(if_stmt) then
    check_expr(ctx, &if_stmt.cond)
    check_block(ctx, &if_stmt.then_block)
    
    for (econd, ebody) in if_stmt.elsif_branches do
      check_expr(ctx, &econd)
      check_block(ctx, &ebody)
    end
    
    match if_stmt.else_block
    when Option::Some(else_block) then
      check_block(ctx, &else_block)
    when Option::None then ()
    end
    
  when StmtKind::While(cond, body) then
    check_expr(ctx, &cond)
    check_block(ctx, &body)

  when StmtKind::Loop(body) then
    check_block(ctx, &body)
    
  when StmtKind::For(var, iter, body) then
    check_expr(ctx, &iter)
    push_scope(ctx)
    # Infer loop variable type from iterator
    let iter_ty = infer_expr_type(ctx, &iter)
    let elem_ty = extract_iter_element_type(&iter_ty)
    add_var(ctx, var, elem_ty, stmt.span)
    
    # Invalidate borrows at loop entry (they may not be valid across iterations)
    let loop_borrows = collect_borrows_in_block(&body)
    
    check_block(ctx, &body)
    
    # Invalidate all borrows created in loop body at end of iteration
    # This prevents use-after-move across loop iterations
    for borrow_name in loop_borrows do
      invalidate_borrow(ctx, &borrow_name, stmt.span)
    end
    
    pop_scope(ctx)
    
  when StmtKind::Return(val_opt) then
    match val_opt
    when Option::Some(val) then
      check_expr(ctx, &val)
    when Option::None then ()
    end

  when StmtKind::Break(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(ctx, &val)
    when Option::None then ()
    end

  when StmtKind::Continue then
    ()

  when StmtKind::Yield(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(ctx, &val)
    when Option::None then ()
    end

  when StmtKind::Expr(expr) then
    check_expr(ctx, &expr)

    # NLL-like behavior: borrows created only for a stand-alone expression
    # end at statement boundary if they are not bound to a named variable.
    let temp_borrows = Vec::new()
    collect_borrows_in_expr(&expr, &temp_borrows)
    for name in temp_borrows do
      invalidate_borrow(ctx, &name, stmt.span)
    end
    
  when StmtKind::Match(m) then
    check_expr(ctx, &m.scrutinee)
    
    for arm in m.arms do
      push_scope(ctx)
      check_pattern(ctx, &arm.pattern, stmt.span)
      match arm.guard
      when Option::Some(guard) then check_expr(ctx, &guard)
      when Option::None then ()
      end
      check_block(ctx, &arm.body)
      pop_scope(ctx)
    end
    
  when StmtKind::Unsafe(reason, body) then
    let was_unsafe = ctx.unsafe_context
    ctx.unsafe_context = true
    
    # Unsafe audit: record this block
    let (line, col) = offset_to_line_col(&ctx.source, stmt.span.start)
    mut operations = Vec::new()
    collect_unsafe_operations(&body, &mut operations)
    
    ctx.unsafe_audit.push(UnsafeUsage {
      span: stmt.span,
      file: ctx.current_file.clone(),
      line: line,
      column: col,
      reason: reason.clone(),
      operations: operations,
      function_name: ctx.current_function.clone()
    })
    
    # Lint: empty unsafe block
    if body.stmts.is_empty() then
      ctx.warnings.push(BorrowError {
        kind: BorrowErrorKind::Warning,
        message: "unnecessary unsafe block — body is empty",
        span: stmt.span,
        notes: Vec::new()
      })
    end
    
    check_block(ctx, &body)
    ctx.unsafe_context = was_unsafe
    
  when StmtKind::Defer(body) then
    # Defer blocks are checked but executed later
    check_block(ctx, &body)

  when StmtKind::Guard(cond, else_action) then
    check_expr(ctx, &cond)
    match else_action
    when GuardElse::Return(ret_opt) then
      match ret_opt
      when Option::Some(ret_expr) then check_expr(ctx, &ret_expr)
      when Option::None then ()
      end
    when GuardElse::Break(br_opt) then
      match br_opt
      when Option::Some(br_expr) then check_expr(ctx, &br_expr)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Continue then ()
    end
    
  when StmtKind::Try(body, catches, finally) then
    check_block(ctx, &body)
    for c in catches do
      push_scope(ctx)
      check_pattern(ctx, &c.pattern, stmt.span)
      check_block(ctx, &c.body)
      pop_scope(ctx)
    end
    match finally
    when Option::Some(fb) then check_block(ctx, &fb)
    when Option::None then ()
    end

  when StmtKind::With(resource, bind_name, body) then
    check_expr(ctx, &resource)
    push_scope(ctx)
    add_var(ctx, bind_name, Type::Unit, stmt.span)
    check_block(ctx, &body)
    pop_scope(ctx)

  when StmtKind::HandleWith(effect_expr, handlers) then
    check_expr(ctx, &effect_expr)
    for h in handlers do
      for arm in h.arms do
        push_scope(ctx)
        for param_name in arm.params do
          add_var(ctx, param_name, Type::Unit, arm.span)
        end
        check_block(ctx, &arm.body)
        pop_scope(ctx)
      end
    end
    
  when _ then ()
  end
end

def check_assign_target(ctx: &mut BorrowCtx, target: &Expr, span: Span) -> Unit
  match target.kind
  when ExprKind::Ident(name) then
    # Check if borrowing conflicts
    if has_any_borrow(&ctx.borrows, name) then
      add_error(ctx, BorrowErrorKind::MutBorrowWhileShared,
        "cannot assign to `" + name + "` while borrowed", span)
    end
    
  when ExprKind::FieldAccess(recv, field) then
    check_assign_target(ctx, &recv, span)
    
  when ExprKind::Index(recv, index) then
    check_assign_target(ctx, &recv, span)
    check_expr(ctx, &index)
    
  when ExprKind::Deref(inner) then
    check_expr(ctx, &inner)
    
  when _ then ()
  end
end

def check_expr(ctx: &mut BorrowCtx, expr: &Expr) -> Unit
  match expr.kind
  when ExprKind::NilLit then
    ()

  when ExprKind::Ident(name) then
    check_use(ctx, name, expr.span)

  when ExprKind::Path(path) then
    ()

  when ExprKind::SelfRef then
    ()
    
  when ExprKind::BinaryOp(op, left, right) then
    check_expr(ctx, &left)
    check_expr(ctx, &right)
    
  when ExprKind::UnaryOp(op, inner) then
    check_expr(ctx, &inner)
    
  when ExprKind::Call(func, args) then
    check_expr(ctx, &func)
    for a in args do
      check_expr(ctx, &a)
    end
    
  when ExprKind::MethodCall(recv, method, type_args, args) then
    check_expr(ctx, &recv)
    for a in args do
      check_expr(ctx, &a)
    end
    
  when ExprKind::FieldAccess(recv, field) then
    check_expr(ctx, &recv)
    
  when ExprKind::Index(recv, index) then
    check_expr(ctx, &recv)
    check_expr(ctx, &index)
    
  when ExprKind::Ref(inner) then
    check_borrow(ctx, &inner, BorrowKind::Immutable, expr.span)
    
  when ExprKind::RefMut(inner) then
    check_borrow(ctx, &inner, BorrowKind::Mutable, expr.span)
    
  when ExprKind::Deref(inner) then
    check_expr(ctx, &inner)
    
  when ExprKind::Move(inner) then
    check_move(ctx, &inner, expr.span)
    
  when ExprKind::Copy(inner) then
    check_expr(ctx, &inner)
    # Copy is always OK if underlying type is Copy
    
  when ExprKind::ArrayLit(elems) then
    for e in elems do
      check_expr(ctx, &e)
    end

  when ExprKind::MapLit(entries) then
    for (key, value) in entries do
      check_expr(ctx, &key)
      check_expr(ctx, &value)
    end
    
  when ExprKind::TupleLit(elems) then
    for e in elems do
      check_expr(ctx, &e)
    end
    
  when ExprKind::StructLit(path, fields) then
    for (name, val) in fields do
      check_expr(ctx, &val)
    end
    
  when ExprKind::Closure(params, ret_ty, body) then
    push_scope(ctx)
    for p in params do
      add_var(ctx, p.name, Type::Unit, expr.span)
    end
    check_expr(ctx, &body)
    pop_scope(ctx)
    
  when ExprKind::If(if_stmt) then
    check_expr(ctx, &if_stmt.cond)
    check_block(ctx, &if_stmt.then_block)
    for (elsif_cond, elsif_block) in if_stmt.elsif_branches do
      check_expr(ctx, &elsif_cond)
      check_block(ctx, &elsif_block)
    end
    match if_stmt.else_block
    when Option::Some(eb) then check_block(ctx, &eb)
    when Option::None then ()
    end
    
  when ExprKind::Match(m) then
    check_expr(ctx, &m.scrutinee)
    for arm in m.arms do
      push_scope(ctx)
      check_pattern(ctx, &arm.pattern, expr.span)
      match arm.guard
      when Option::Some(guard) then check_expr(ctx, &guard)
      when Option::None then ()
      end
      check_block(ctx, &arm.body)
      pop_scope(ctx)
    end
    
  when ExprKind::Block(block) then
    check_block(ctx, &block)
    
  when ExprKind::Async(block) then
    # Async blocks have special lifetime requirements
    check_block(ctx, &block)
    
  when ExprKind::Await(inner) then
    check_expr(ctx, &inner)
    
  when ExprKind::Try(inner) then
    check_expr(ctx, &inner)

  when ExprKind::Range(start_opt, end_opt, inclusive) then
    match start_opt
    when Option::Some(start) then check_expr(ctx, &start)
    when Option::None then ()
    end
    match end_opt
    when Option::Some(end_expr) then check_expr(ctx, &end_expr)
    when Option::None then ()
    end

  when ExprKind::Cast(inner, ty) then
    check_expr(ctx, &inner)

  when ExprKind::TypeCheck(inner, ty) then
    check_expr(ctx, &inner)

  when ExprKind::Comptime(block) then
    check_block(ctx, &block)

  when ExprKind::EnumVariant(path, args) then
    for a in args do
      check_expr(ctx, &a)
    end

  when ExprKind::Assign(target, value) then
    check_expr(ctx, &value)
    check_assign_target(ctx, &target, expr.span)
    
  when ExprKind::Pipe(left, right) then
    check_expr(ctx, &left)
    check_expr(ctx, &right)
    
  when _ then ()
  end
end

def check_pattern(ctx: &mut BorrowCtx, pat: &Pattern, span: Span) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    add_var(ctx, name, Type::Unit, span)
  when PatternKind::Tuple(pats) then
    for p in pats do
      check_pattern(ctx, &p, span)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      check_pattern(ctx, &p, span)
    end
  when PatternKind::Struct(path, fields) then
    for (name, subpat) in fields do
      check_pattern(ctx, &subpat, span)
    end
  when PatternKind::Variant(path, pats) then
    for p in pats do
      check_pattern(ctx, &p, span)
    end
  when PatternKind::Ref(inner) then
    check_pattern(ctx, &inner, span)
  when PatternKind::RefMut(inner) then
    check_pattern(ctx, &inner, span)
  when PatternKind::Or(left, right) then
    check_pattern(ctx, &left, span)
    check_pattern(ctx, &right, span)
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Use/Move/Borrow Checking
# ———————————————————————————————————————————————————————————————

def check_use(ctx: &mut BorrowCtx, name: String, span: Span) -> Unit
  match ctx.vars.get(name)
  when Option::Some(state) then
    match state.ownership
    when OwnershipState::Moved then
      add_error_with_note(ctx, BorrowErrorKind::UseAfterMove,
        "use of moved value: `" + name + "`", span,
        "value moved previously")
    when OwnershipState::Dropped then
      add_error(ctx, BorrowErrorKind::UseAfterDrop,
        "use of dropped value: `" + name + "`", span)
    when OwnershipState::Invalid then
      add_error(ctx, BorrowErrorKind::UseAfterMove,
        "use of invalid value: `" + name + "`", span)
    when _ then ()
    end
  when Option::None then
    # Variable not found - might be from outer scope or error
    ()
  end
end

def check_move(ctx: &mut BorrowCtx, expr: &Expr, span: Span) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    match ctx.vars.get_mut(name)
    when Option::Some(state) then
      # Check if borrowed
      if has_any_borrow(&ctx.borrows, name) then
        add_error(ctx, BorrowErrorKind::MovedWhileBorrowed,
          "cannot move `" + name + "` while borrowed", span)
        return
      end
      
      # Check current state
      match state.ownership
      when OwnershipState::Moved then
        add_error(ctx, BorrowErrorKind::UseAfterMove,
          "use of moved value: `" + name + "`", span)
      when OwnershipState::Owned then
        if !state.is_copy then
          state.ownership = OwnershipState::Moved
        end
      when OwnershipState::Borrowed then
        add_error(ctx, BorrowErrorKind::MovedWhileBorrowed,
          "cannot move `" + name + "` while borrowed", span)
      when OwnershipState::BorrowedMut then
        add_error(ctx, BorrowErrorKind::MovedWhileBorrowed,
          "cannot move `" + name + "` while mutably borrowed", span)
      when _ then ()
      end
    when Option::None then ()
    end
  when _ then
    check_expr(ctx, expr)
  end
end

def check_borrow(ctx: &mut BorrowCtx, expr: &Expr, kind: BorrowKind, span: Span) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    match ctx.vars.get_mut(name)
    when Option::Some(state) then
      # Check current state
      match state.ownership
      when OwnershipState::Moved then
        add_error(ctx, BorrowErrorKind::UseAfterMove,
          "cannot borrow moved value: `" + name + "`", span)
        return
      when OwnershipState::Dropped then
        add_error(ctx, BorrowErrorKind::UseAfterDrop,
          "cannot borrow dropped value: `" + name + "`", span)
        return
      when _ then ()
      end
      
      match kind
      when BorrowKind::Immutable then
        # Can have multiple immutable borrows
        if has_mut_borrow(&ctx.borrows, name) then
          add_error(ctx, BorrowErrorKind::SharedBorrowWhileMut,
            "cannot borrow `" + name + "` as immutable while mutably borrowed", span)
        else
          let lt = fresh_lifetime(ctx)
          add_borrow(&mut ctx.borrows, kind, name, lt, span)
          state.borrow_count = state.borrow_count + 1
        end
      when BorrowKind::Mutable then
        # Can only have one mutable borrow
        if has_any_borrow(&ctx.borrows, name) then
          if has_mut_borrow(&ctx.borrows, name) then
            add_error(ctx, BorrowErrorKind::DoubleMutBorrow,
              "cannot borrow `" + name + "` as mutable more than once", span)
          else
            add_error(ctx, BorrowErrorKind::MutBorrowWhileShared,
              "cannot borrow `" + name + "` as mutable while also borrowed as immutable", span)
          end
        else
          let lt = fresh_lifetime(ctx)
          add_borrow(&mut ctx.borrows, kind, name, lt, span)
          state.mut_borrow_count = state.mut_borrow_count + 1
        end
      end
    when Option::None then ()
    end
  when ExprKind::FieldAccess(recv, field) then
    # For field access, check the receiver
    check_borrow(ctx, &recv, kind, span)
  when ExprKind::Index(recv, index) then
    check_borrow(ctx, &recv, kind, span)
    check_expr(ctx, &index)
  when ExprKind::Deref(inner) then
    check_borrow(ctx, &inner, kind, span)
  when _ then
    check_expr(ctx, expr)
  end
end

# ———————————————————————————————————————————————————————————————
# Lifetime Analysis
# ———————————————————————————————————————————————————————————————

struct LifetimeConstraint
  shorter: Lifetime
  longer: Lifetime
  span: Span
end

struct LifetimeCtx
  constraints: Vec[LifetimeConstraint]
  var_lifetimes: Map[String, Lifetime]
  next_lifetime_id: Int
end

def lifetime_ctx_new() -> LifetimeCtx
  LifetimeCtx {
    constraints: Vec::new(),
    var_lifetimes: Map::new(),
    next_lifetime_id: 1
  }
end

def fresh_constraint_lifetime(ctx: &mut LifetimeCtx, label: String) -> Lifetime
  let id = ctx.next_lifetime_id
  ctx.next_lifetime_id = ctx.next_lifetime_id + 1
  Lifetime {
    id: id,
    name: label + id.to_string()
  }
end

def add_constraint(ctx: &mut LifetimeCtx, shorter: Lifetime, longer: Lifetime, span: Span) -> Unit
  ctx.constraints.push(LifetimeConstraint {
    shorter: shorter,
    longer: longer,
    span: span
  })
end

def outlives(ctx: &LifetimeCtx, a: Lifetime, b: Lifetime) -> Bool
  # Static outlives everything
  if a.id == 0 then
    return true
  end
  
  # Same lifetime
  if a.id == b.id then
    return true
  end
  
  # Constraint graph traversal:
  # add_constraint(shorter, longer) encodes shorter : longer (shorter outlives longer).
  mut visited = Set::new()
  mut stack = Vec::new()
  stack.push(a.id)

  while !stack.is_empty() do
    let cur = stack.pop()
    if cur == b.id then
      return true
    end
    if visited.contains(cur) then
      continue
    end
    visited.insert(cur)

    for c in ctx.constraints do
      if c.shorter.id == cur && !visited.contains(c.longer.id) then
        stack.push(c.longer.id)
      end
    end
  end
  
  false
end

# ———————————————————————————————————————————————————————————————
# Drop Check
# ———————————————————————————————————————————————————————————————

struct DropInfo
  name: String
  needs_drop: Bool
  drop_order: Int
end

def compute_drop_order(block: &Block) -> Vec[DropInfo]
  mut drops = Vec::new()
  mut order = 0
  
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::Let(pattern, ty_opt, value, is_mut) then
      match pattern.kind
      when PatternKind::Ident(name, _) then
        drops.push(DropInfo {
          name: name,
          needs_drop: true,  # Would check if type needs drop
          drop_order: order
        })
        order = order + 1
      when _ then ()
      end
    when _ then ()
    end
  end
  
  # Reverse for drop order (LIFO)
  mut reversed = Vec::new()
  mut i = drops.len()
  while i > 0 do
    i = i - 1
    reversed.push(drops[i])
  end
  
  reversed
end

# ———————————————————————————————————————————————————————————————
# Drop Elaboration
# ———————————————————————————————————————————————————————————————

def insert_drops(block: &mut Block) -> Unit
  let drop_info = compute_drop_order(block)
  
  # Insert drop calls at end of block in reverse declaration order
  for info in drop_info do
    if info.needs_drop then
      # Synthesize a drop expression: drop(name)
      let drop_expr = make_expr(
        ExprKind::MethodCall(
          make_expr(ExprKind::Ident(info.name.clone()), span_dummy()),
          "drop",
          Vec::new(),
          Vec::new()
        ),
        span_dummy()
      )
      let drop_stmt = make_stmt(
        StmtKind::Expr(drop_expr),
        span_dummy()
      )
      block.stmts.push(drop_stmt)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# NLL (Non-Lexical Lifetimes) Support
# ———————————————————————————————————————————————————————————————

# Control Flow Graph for NLL analysis
struct CFGNode
  id: Int
  kind: CFGNodeKind
  successors: Vec[Int]
  predecessors: Vec[Int]
end

enum CFGNodeKind
  Start
  End
  Statement(Int)
  Branch(Expr)      # Branch with condition expression
  Join
end

struct CFG
  nodes: Vec[CFGNode]
  statements: Vec[Stmt]   # All statements in the function
  entry: Int
  exit: Int
end

def cfg_new() -> CFG
  mut nodes = Vec::new()
  nodes.push(CFGNode {
    id: 0,
    kind: CFGNodeKind::Start,
    successors: Vec::new(),
    predecessors: Vec::new()
  })
  nodes.push(CFGNode {
    id: 1,
    kind: CFGNodeKind::End,
    successors: Vec::new(),
    predecessors: Vec::new()
  })
  CFG { nodes: nodes, statements: Vec::new(), entry: 0, exit: 1 }
end

# Liveness analysis for NLL
struct LivenessInfo
  live_in: Set[String]
  live_out: Set[String]
end

def compute_liveness(cfg: &CFG) -> Map[Int, LivenessInfo]
  mut result = Map::new()
  
  # Initialize with empty sets
  for node in cfg.nodes do
    result.insert(node.id, LivenessInfo {
      live_in: Set::new(),
      live_out: Set::new()
    })
  end
  
  # Worklist-based backward dataflow (only re-process affected nodes)
  mut worklist: Vec[Int] = Vec::new()
  # Initialize worklist with all nodes in reverse order
  mut i = cfg.nodes.len()
  while i > 0 do
    i = i - 1
    worklist.push(cfg.nodes[i].id)
  end
  
  mut in_worklist: Set[Int] = Set::new()
  for id in &worklist do
    in_worklist.insert(*id)
  end
  
  while !worklist.is_empty() do
    let node_id = worklist.pop().unwrap()
    in_worklist.remove(&node_id)
    
    # Find the node
    mut node_opt: Option[&CFGNode] = Option::None
    for n in &cfg.nodes do
      if n.id == node_id then
        node_opt = Option::Some(n)
        break
      end
    end
    
    let node = match node_opt
    when Option::Some(n) then n
    when Option::None then next
    end
    
    # live_out = union of live_in of all successors
    mut new_live_out = Set::new()
    for succ in &node.successors do
      match result.get(*succ)
      when Option::Some(succ_info) then
        for v in &succ_info.live_in do
          new_live_out.insert(v.clone())
        end
      when Option::None then ()
      end
    end
    
    # live_in = uses(node) ∪ (live_out - defs(node))
    let (uses, defs) = node_uses_defs(cfg, node)
    mut new_live_in = Set::new()
    # Start with live_out minus defs
    for v in &new_live_out do
      if !defs.contains(v) then
        new_live_in.insert(v.clone())
      end
    end
    # Add uses
    for u in &uses do
      new_live_in.insert(u.clone())
    end
    
    match result.get_mut(&node_id)
    when Option::Some(info) then
      if info.live_in != new_live_in then
        info.live_out = new_live_out
        info.live_in = new_live_in
        # Add predecessors to worklist (they need to be recomputed)
        for pred in &node.predecessors do
          if !in_worklist.contains(pred) then
            worklist.push(*pred)
            in_worklist.insert(*pred)
          end
        end
      end
    when Option::None then ()
    end
  end
  
  result
end

# Extract uses and defs from a CFG node
def node_uses_defs(cfg: &CFG, node: &CFGNode) -> (Set[String], Set[String])
  mut uses = Set::new()
  mut defs = Set::new()
  
  match node.kind
  when CFGNodeKind::Statement(stmt_idx) then
    # Look up the actual statement and extract variables
    if stmt_idx >= 0 && stmt_idx < cfg.statements.len() as Int then
      let stmt = &cfg.statements[stmt_idx as UInt]
      extract_stmt_uses_defs(stmt, &mut uses, &mut defs)
    end
  when CFGNodeKind::Branch(cond) then
    # Branch condition is a use (no defs)
    extract_expr_uses(&cond, &mut uses)
  when CFGNodeKind::Start then ()
  when CFGNodeKind::End then ()
  when CFGNodeKind::Join then ()
  end
  
  (uses, defs)
end

# Extract uses and defs from a statement
def extract_stmt_uses_defs(stmt: &Stmt, uses: &mut Set[String], defs: &mut Set[String]) -> Unit
  match stmt.kind
  when StmtKind::Let(pattern, ty_opt, value, is_mut) then
    # Let bindings define a new variable
    match pattern.kind
    when PatternKind::Ident(name, _) then defs.insert(name.clone())
    when _ then ()
    end
    # The initializer expression contains uses
    extract_expr_uses(&value, uses)
    
  when StmtKind::Assign(target, value) then
    # Assignment: target is def, value contains uses
    extract_assign_target_def(&target, defs)
    extract_expr_uses(&value, uses)
    
  when StmtKind::Expr(expr) then
    # Expression statement: all variables are uses
    extract_expr_uses(&expr, uses)
    
  when StmtKind::Return(val_opt) then
    match val_opt
    when Option::Some(val) then
      extract_expr_uses(&val, uses)
    when Option::None then ()
    end
    
  when StmtKind::If(if_stmt) then
    # Condition is used
    extract_expr_uses(&if_stmt.cond, uses)
    # Blocks will be handled as separate CFG nodes
    
  when StmtKind::While(cond, body) then
    extract_expr_uses(&cond, uses)
    
  when StmtKind::For(var, iter, body) then
    # Iterator expression is used
    extract_expr_uses(&iter, uses)
    # Loop variable is defined (in each iteration)
    defs.insert(var.clone())
    
  when StmtKind::Match(m) then
    extract_expr_uses(&m.scrutinee, uses)
    
  when _ then ()
  end
end

# Extract def from assignment target
def extract_assign_target_def(target: &Expr, defs: &mut Set[String]) -> Unit
  match target.kind
  when ExprKind::Ident(name) then
    defs.insert(name.clone())
  when ExprKind::FieldAccess(recv, field) then
    # Field assignment: the base is both used and modified
    # We track the root variable as modified
    extract_root_var(&recv, defs)
  when ExprKind::Index(recv, index) then
    # Index assignment: base is modified, index is used
    extract_root_var(&recv, defs)
  when ExprKind::Deref(inner) then
    # Deref assignment: we're writing through a pointer
    # The pointer itself is not modified, just used
    ()
  when _ then ()
  end
end

# Extract root variable from an lvalue expression
def extract_root_var(expr: &Expr, vars: &mut Set[String]) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    vars.insert(name.clone())
  when ExprKind::FieldAccess(recv, _) then
    extract_root_var(&recv, vars)
  when ExprKind::Index(recv, _) then
    extract_root_var(&recv, vars)
  when ExprKind::Deref(inner) then
    extract_root_var(&inner, vars)
  when _ then ()
  end
end

# Extract all variable uses from an expression
def extract_expr_uses(expr: &Expr, uses: &mut Set[String]) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    uses.insert(name.clone())
    
  when ExprKind::BinaryOp(op, left, right) then
    extract_expr_uses(&left, uses)
    extract_expr_uses(&right, uses)
    
  when ExprKind::UnaryOp(op, inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Call(func, args) then
    extract_expr_uses(&func, uses)
    for a in args do
      extract_expr_uses(&a, uses)
    end
    
  when ExprKind::MethodCall(recv, method, type_args, args) then
    extract_expr_uses(&recv, uses)
    for a in args do
      extract_expr_uses(&a, uses)
    end
    
  when ExprKind::FieldAccess(recv, field) then
    extract_expr_uses(&recv, uses)
    
  when ExprKind::Index(recv, index) then
    extract_expr_uses(&recv, uses)
    extract_expr_uses(&index, uses)
    
  when ExprKind::Ref(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::RefMut(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Deref(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Move(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Copy(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::ArrayLit(elems) then
    for e in elems do
      extract_expr_uses(&e, uses)
    end
    
  when ExprKind::TupleLit(elems) then
    for e in elems do
      extract_expr_uses(&e, uses)
    end
    
  when ExprKind::StructLit(path, fields) then
    for (name, val) in fields do
      extract_expr_uses(&val, uses)
    end
    
  when ExprKind::If(if_stmt) then
    extract_expr_uses(&if_stmt.cond, uses)
    # Block contents handled separately
    
  when ExprKind::Match(m) then
    extract_expr_uses(&m.scrutinee, uses)
    
  when ExprKind::Closure(params, ret_ty, body) then
    # Closures capture variables - extract free variables
    mut param_names = Set::new()
    for p in params do
      param_names.insert(p.name.clone())
    end
    extract_closure_captures(&body, &param_names, uses)
    
  when ExprKind::Await(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Try(inner) then
    extract_expr_uses(&inner, uses)
    
  when ExprKind::Pipe(left, right) then
    extract_expr_uses(&left, uses)
    extract_expr_uses(&right, uses)
    
  when ExprKind::IntLit(_) then ()
  when ExprKind::FloatLit(_) then ()
  when ExprKind::StringLit(_) then ()
  when ExprKind::CharLit(_) then ()
  when ExprKind::BoolLit(_) then ()
  when ExprKind::Unit then ()
  when _ then ()
  end
end

# Extract captured variables from closure body
def extract_closure_captures(body: &Expr, bound: &Set[String], captures: &mut Set[String]) -> Unit
  match body.kind
  when ExprKind::Ident(name) then
    if !bound.contains(&name) then
      captures.insert(name.clone())
    end
    
  when ExprKind::BinaryOp(_, left, right) then
    extract_closure_captures(&left, bound, captures)
    extract_closure_captures(&right, bound, captures)
    
  when ExprKind::UnaryOp(_, inner) then
    extract_closure_captures(&inner, bound, captures)
    
  when ExprKind::Call(func, args) then
    extract_closure_captures(&func, bound, captures)
    for a in args do
      extract_closure_captures(&a, bound, captures)
    end
    
  when ExprKind::MethodCall(recv, _, _, args) then
    extract_closure_captures(&recv, bound, captures)
    for a in args do
      extract_closure_captures(&a, bound, captures)
    end
    
  when ExprKind::Block(block) then
    mut new_bound = bound.clone()
    for stmt in block.stmts do
      match stmt.kind
      when StmtKind::Let(pattern, _, init, _) then
        extract_closure_captures(&init, &new_bound, captures)
        match pattern.kind
        when PatternKind::Ident(name, _) then new_bound.insert(name.clone())
        when _ then ()
        end
      when StmtKind::Expr(e) then
        extract_closure_captures(&e, &new_bound, captures)
      when _ then ()
      end
    end
    
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def borrow_check(program: &Program) -> Vec[BorrowError]
  mut errors = check_program(program)

  # Run NLL + escape analysis for more precise diagnostics
  let _escape_info = analyze_escapes(program)

  for item in program.items do
    match item.kind
    when ItemKind::Function(f) then
      run_advanced_analysis(&mut errors, &f)
    when ItemKind::Impl(i) then
      for m in i.methods do
        run_advanced_analysis(&mut errors, &m)
      end
    when _ then ()
    end
  end

  errors
end

def run_advanced_analysis(errors: &mut Vec[BorrowError], f: &FunctionDecl) -> Unit
  # Build CFG from function body for NLL analysis
  match f.body
  when FnBody::Block(block) then
    # 1. Build CFG and compute liveness (NLL)
    mut cfg = cfg_new()
    build_cfg_from_block(&mut cfg, &block)
    let _liveness = compute_liveness(&cfg)

    # 2. Lifetime constraint checking
    mut lt_ctx = lifetime_ctx_new()
    collect_lifetime_constraints_block(&mut lt_ctx, &block)
    check_lifetime_violations(&lt_ctx, errors)

    # 3. Drop order verification
    let drop_info = compute_drop_order(&block)
    verify_no_use_after_drop(errors, &drop_info, &block)
  when _ then ()
  end
end

def build_cfg_from_block(cfg: &mut CFG, block: &Block) -> Unit
  mut prev_id = cfg.entry
  for stmt in block.stmts do
    let node_id = cfg.nodes.len() as Int
    let idx = cfg.statements.len() as Int
    cfg.statements.push(stmt.clone())
    cfg.nodes.push(CFGNode {
      id: node_id,
      kind: CFGNodeKind::Statement(idx),
      successors: Vec::new(),
      predecessors: Vec::new()
    })
    cfg.nodes[prev_id].successors.push(node_id)
    cfg.nodes[node_id].predecessors.push(prev_id)
    prev_id = node_id
  end
  cfg.nodes[prev_id].successors.push(cfg.exit)
  cfg.nodes[cfg.exit].predecessors.push(prev_id)
end

def collect_lifetime_constraints_block(lt_ctx: &mut LifetimeCtx, block: &Block) -> Unit
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::Let(pattern, ty_opt, value, is_mut) then
      # If binding a reference, add outlives constraint
      match value.kind
      when ExprKind::Ref(inner) then
        let borrow_lt = fresh_constraint_lifetime(lt_ctx, "'borrow")
        let binding_lt = fresh_constraint_lifetime(lt_ctx, "'binding")
        add_constraint(lt_ctx, borrow_lt, binding_lt, stmt.span)
      when ExprKind::RefMut(inner) then
        let borrow_lt = fresh_constraint_lifetime(lt_ctx, "'borrow")
        let binding_lt = fresh_constraint_lifetime(lt_ctx, "'binding")
        add_constraint(lt_ctx, borrow_lt, binding_lt, stmt.span)
      when _ then ()
      end
    when _ then ()
    end
  end
end

def check_lifetime_violations(lt_ctx: &LifetimeCtx, errors: &mut Vec[BorrowError]) -> Unit
  for c in lt_ctx.constraints do
    if !outlives(lt_ctx, c.shorter, c.longer) then
      errors.push(BorrowError {
        kind: BorrowErrorKind::LifetimeError,
        message: "borrowed value does not live long enough",
        span: c.span,
        related: Vec::new()
      })
    end
  end
end

def verify_no_use_after_drop(errors: &mut Vec[BorrowError], drops: &Vec[DropInfo], block: &Block) -> Unit
  # Check that no variable is used after it would be dropped
  for i in 0..drops.len() do
    let info = &drops[i]
    if info.needs_drop then
      # Verify no uses of this variable appear after its drop point
      for j in (info.drop_order + 1)..block.stmts.len() do
        if stmt_uses_var(&block.stmts[j], &info.name) then
          errors.push(BorrowError {
            kind: BorrowErrorKind::UseAfterDrop,
            message: "use of variable `" + info.name.clone() + "` after drop",
            span: block.stmts[j].span,
            related: Vec::new()
          })
        end
      end
    end
  end
end

def stmt_uses_var(stmt: &Stmt, name: &String) -> Bool
  match stmt.kind
  when StmtKind::Expr(expr) then expr_uses_var(&expr, name)
  when StmtKind::Let(_, _, value, _) then expr_uses_var(&value, name)
  when StmtKind::Assign(target, value) then
    expr_uses_var(&target, name) || expr_uses_var(&value, name)
  when StmtKind::If(if_stmt) then
    if expr_uses_var(&if_stmt.cond, name) then return true end
    for s in if_stmt.then_block.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    for (econd, ebody) in if_stmt.elsif_branches do
      if expr_uses_var(&econd, name) then return true end
      for s in ebody.stmts do
        if stmt_uses_var(&s, name) then return true end
      end
    end
    match if_stmt.else_block
    when Option::Some(eb) then
      for s in eb.stmts do
        if stmt_uses_var(&s, name) then return true end
      end
      false
    when Option::None then false
    end
  when StmtKind::While(cond, body) then
    if expr_uses_var(&cond, name) then return true end
    for s in body.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when StmtKind::For(_, iter, body) then
    if expr_uses_var(&iter, name) then return true end
    for s in body.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when StmtKind::Loop(body) then
    for s in body.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when StmtKind::Return(v) then
    match v
    when Option::Some(e) then expr_uses_var(&e, name)
    when Option::None then false
    end
  when StmtKind::Yield(v) then
    match v
    when Option::Some(e) then expr_uses_var(&e, name)
    when Option::None then false
    end
  when StmtKind::Match(m) then
    if expr_uses_var(&m.scrutinee, name) then return true end
    for arm in m.arms do
      match arm.guard
      when Option::Some(g) then if expr_uses_var(&g, name) then return true end
      when Option::None then ()
      end
      for s in arm.body.stmts do
        if stmt_uses_var(&s, name) then return true end
      end
    end
    false
  when StmtKind::Unsafe(_, body) then
    for s in body.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when StmtKind::Defer(body) then
    for s in body.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when _ then false
  end
end

def expr_uses_var(expr: &Expr, name: &String) -> Bool
  match expr.kind
  when ExprKind::Ident(n) then n == *name
  when ExprKind::Ref(inner) then expr_uses_var(&inner, name)
  when ExprKind::RefMut(inner) then expr_uses_var(&inner, name)
  when ExprKind::Deref(inner) then expr_uses_var(&inner, name)
  when ExprKind::Move(inner) then expr_uses_var(&inner, name)
  when ExprKind::Copy(inner) then expr_uses_var(&inner, name)
  when ExprKind::UnaryOp(_, inner) then expr_uses_var(&inner, name)
  when ExprKind::BinaryOp(_, left, right) then
    expr_uses_var(&left, name) || expr_uses_var(&right, name)
  when ExprKind::FieldAccess(inner, _) then expr_uses_var(&inner, name)
  when ExprKind::Index(recv, idx) then
    expr_uses_var(&recv, name) || expr_uses_var(&idx, name)
  when ExprKind::MethodCall(recv, _, args, _) then
    if expr_uses_var(&recv, name) then return true end
    for a in args do
      if expr_uses_var(&a, name) then return true end
    end
    false
  when ExprKind::Call(callee, args) then
    if expr_uses_var(&callee, name) then return true end
    for a in args do
      if expr_uses_var(&a, name) then return true end
    end
    false
  when ExprKind::ArrayLit(elems) then
    for e in elems do
      if expr_uses_var(&e, name) then return true end
    end
    false
  when ExprKind::TupleLit(elems) then
    for e in elems do
      if expr_uses_var(&e, name) then return true end
    end
    false
  when ExprKind::StructLit(_, fields) then
    for (_, v) in fields do
      if expr_uses_var(&v, name) then return true end
    end
    false
  when ExprKind::Assign(target, value) then
    expr_uses_var(&target, name) || expr_uses_var(&value, name)
  when ExprKind::Pipe(left, right) then
    expr_uses_var(&left, name) || expr_uses_var(&right, name)
  when ExprKind::Try(inner) then expr_uses_var(&inner, name)
  when ExprKind::Await(inner) then expr_uses_var(&inner, name)
  when ExprKind::If(if_stmt) then
    if expr_uses_var(&if_stmt.cond, name) then return true end
    for s in if_stmt.then_block.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    for (econd, ebody) in if_stmt.elsif_branches do
      if expr_uses_var(&econd, name) then return true end
      for s in ebody.stmts do
        if stmt_uses_var(&s, name) then return true end
      end
    end
    match if_stmt.else_block
    when Option::Some(eb) then
      for s in eb.stmts do
        if stmt_uses_var(&s, name) then return true end
      end
      false
    when Option::None then false
    end
  when ExprKind::Block(block) then
    for s in block.stmts do
      if stmt_uses_var(&s, name) then return true end
    end
    false
  when _ then false
  end
end

# ———————————————————————————————————————————————————————————————
# Escape Analysis
# ———————————————————————————————————————————————————————————————
#
# Determines which allocations "escape" the current function and must be
# heap-allocated vs. which can be safely stack-allocated.
#
# An allocation escapes if:
# 1. It is returned from the function
# 2. It is assigned to a global or static variable
# 3. It is passed to a function that stores it (transitively)
# 4. A reference to it outlives the function scope
# 5. It is captured by a closure that escapes
#
# Non-escaping allocations can use stack allocation (arena/bump allocator)
# which is faster and doesn't require GC/RAII tracking.

enum EscapeState
  NoEscape        # Can be stack-allocated
  ArgEscape       # Escapes through argument (may be stored)
  GlobalEscape    # Escapes to global/heap
  Unknown         # Escape status not yet determined
end

struct EscapeInfo
  var_name: String
  escape_state: EscapeState
  escape_reason: Option[String]
  allocation_site: Option[Span]
end

struct EscapeAnalysisContext
  # Map variable name -> escape info
  escape_info: Map[String, EscapeInfo]
  # Functions known to capture/store their arguments
  capturing_functions: Set[String]
  # Current function's returned expressions
  returned_vars: Set[String]
end

def escape_analysis_new() -> EscapeAnalysisContext
  EscapeAnalysisContext {
    escape_info: Map::new(),
    capturing_functions: Set::new(),
    returned_vars: Set::new()
  }
end

def analyze_escapes(program: &Program) -> Map[String, EscapeInfo]
  mut ctx = escape_analysis_new()
  
  # First pass: identify capturing functions
  for item in program.items do
    match item.kind
    when ItemKind::Function(decl) then
      if function_captures_args(&decl) then
        ctx.capturing_functions.insert(decl.name.clone())
      end
    when _ then ()
    end
  end
  
  # Second pass: analyze escape for each function
  for item in program.items do
    match item.kind
    when ItemKind::Function(decl) then
      analyze_function_escapes(&mut ctx, &decl)
    when _ then ()
    end
  end
  
  ctx.escape_info
end

def function_captures_args(decl: &FunctionDecl) -> Bool
  # Heuristic: functions that store arguments typically have
  # - Reference parameters that get assigned to struct fields
  # - Closure parameters
  # For now, check if any param is a closure type
  for param in decl.params do
    match param.ty
    when Type::Function(_, _) then return true
    when _ then ()
    end
  end
  false
end

def analyze_function_escapes(ctx: &mut EscapeAnalysisContext, decl: &FunctionDecl) -> Unit
  # Initialize escape state for all locals
  for param in decl.params do
    ctx.escape_info.insert(param.name.clone(), EscapeInfo {
      var_name: param.name.clone(),
      escape_state: EscapeState::NoEscape,
      escape_reason: Option::None,
      allocation_site: Option::Some(param.span.clone())
    })
  end
  
  # Analyze function body
  match decl.body
  when Option::Some(FnBody::Block(block)) then
    analyze_block_escapes(ctx, &block)
  when Option::Some(FnBody::Expr(expr)) then
    # Check if expression returns a local
    mark_expr_as_escaped(ctx, &expr, EscapeState::GlobalEscape, "returned from function")
  when _ then ()
  end
  
  # Mark returned variables as escaping
  for var in ctx.returned_vars do
    match ctx.escape_info.get(var.clone())
    when Option::Some(info) then
      info.escape_state = EscapeState::GlobalEscape
      info.escape_reason = Option::Some("returned from function".to_string())
    when Option::None then ()
    end
  end
end

def analyze_block_escapes(ctx: &mut EscapeAnalysisContext, block: &Block) -> Unit
  for stmt in block.stmts do
    analyze_stmt_escapes(ctx, &stmt)
  end
end

def analyze_stmt_escapes(ctx: &mut EscapeAnalysisContext, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::Let(pattern, ty, init, _) then
    # Initialize the variable with NoEscape
    match pattern.kind
    when PatternKind::Ident(name, _) then
      ctx.escape_info.insert(name.clone(), EscapeInfo {
        var_name: name.clone(),
        escape_state: EscapeState::NoEscape,
        escape_reason: Option::None,
        allocation_site: Option::Some(stmt.span.clone())
      })
    when _ then ()
    end
    
    # Analyze the initializer
    analyze_expr_escapes(ctx, &init)
  
  when StmtKind::Expr(expr) then
    analyze_expr_escapes(ctx, &expr)
  
  when StmtKind::Return(expr) then
    match expr
    when Option::Some(e) then
      mark_expr_as_escaped(ctx, &e, EscapeState::GlobalEscape, "returned from function")
      ctx.returned_vars.insert(expr_to_var_name(&e).unwrap_or("".to_string()))
    when Option::None then ()
    end
  
  when _ then ()
  end
end

def analyze_expr_escapes(ctx: &mut EscapeAnalysisContext, expr: &Expr) -> Unit
  match expr.kind
  when ExprKind::Call(callee, args) then
    # Check if callee is a capturing function
    let callee_name = expr_to_var_name(&callee).unwrap_or("".to_string())
    let is_capturing = ctx.capturing_functions.contains(callee_name.clone())
    
    for arg in args do
      if is_capturing then
        mark_expr_as_escaped(ctx, &arg, EscapeState::ArgEscape, "passed to capturing function")
      else
        analyze_expr_escapes(ctx, &arg)
      end
    end
  
  when ExprKind::StructLit(_, fields) then
    # Fields might escape if the struct escapes
    for (_, value) in fields do
      analyze_expr_escapes(ctx, &value)
    end
  
  when ExprKind::Closure(params, _, body) then
    # Variables captured by closure may escape
    let captured = find_captured_variables(&expr)
    for var in captured do
      mark_var_as_escaped(ctx, &var, EscapeState::ArgEscape, "captured by closure")
    end
  
  when ExprKind::Block(block) then
    analyze_block_escapes(ctx, &block)
  
  when ExprKind::If(if_stmt) then
    analyze_expr_escapes(ctx, &if_stmt.cond)
    for stmt in if_stmt.then_block.stmts do
      analyze_stmt_escapes(ctx, &stmt)
    end
    for (elsif_cond, elsif_block) in if_stmt.elsif_branches do
      analyze_expr_escapes(ctx, &elsif_cond)
      for stmt in elsif_block.stmts do
        analyze_stmt_escapes(ctx, &stmt)
      end
    end
    match if_stmt.else_block
    when Option::Some(eb) then
      for stmt in eb.stmts do
        analyze_stmt_escapes(ctx, &stmt)
      end
    when Option::None then ()
    end
  
  when ExprKind::Ref(inner) then
    analyze_expr_escapes(ctx, &inner)

  when ExprKind::RefMut(inner) then
    # Taking a reference doesn't cause escape by itself
    # But the reference might escape in the future
    analyze_expr_escapes(ctx, &inner)
  
  when _ then ()
  end
end

def mark_expr_as_escaped(ctx: &mut EscapeAnalysisContext, expr: &Expr, state: EscapeState, reason: &str) -> Unit
  match expr_to_var_name(expr)
  when Option::Some(name) then
    mark_var_as_escaped(ctx, &name, state, reason)
  when Option::None then ()
  end
end

def mark_var_as_escaped(ctx: &mut EscapeAnalysisContext, name: &String, state: EscapeState, reason: &str) -> Unit
  match ctx.escape_info.get(name.clone())
  when Option::Some(info) then
    # Only escalate escape state, never downgrade
    let should_update = match (info.escape_state, state)
    when (EscapeState::NoEscape, _) then true
    when (EscapeState::ArgEscape, EscapeState::GlobalEscape) then true
    when _ then false
    end
    
    if should_update then
      info.escape_state = state
      info.escape_reason = Option::Some(reason.to_string())
    end
  when Option::None then ()
  end
end

def expr_to_var_name(expr: &Expr) -> Option[String]
  match expr.kind
  when ExprKind::Ident(name) then Option::Some(name.clone())
  when ExprKind::FieldAccess(base, _) then expr_to_var_name(&base)
  when ExprKind::Index(base, _) then expr_to_var_name(&base)
  when _ then Option::None
  end
end

def find_captured_variables(closure: &Expr) -> Vec[String]
  # Find all free variables referenced in the closure body
  # This is a simplified implementation that should be expanded
  mut captured = Vec::new()
  
  match closure.kind
  when ExprKind::Closure(params, _, body) then
    # Build set of parameter names
    mut param_names = Set::new()
    for p in params do
      param_names.insert(p.name.clone())
    end
    
    # Find all identifiers in body that aren't params
    collect_free_vars(&body, &param_names, &mut captured)
  when _ then ()
  end
  
  captured
end

def collect_free_vars(expr: &Expr, bound: &Set[String], free: &mut Vec[String]) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    if !bound.contains(name.clone()) then
      free.push(name.clone())
    end
  when ExprKind::Call(callee, args) then
    collect_free_vars(&callee, bound, free)
    for arg in args do
      collect_free_vars(&arg, bound, free)
    end
  when ExprKind::BinaryOp(_, lhs, rhs) then
    collect_free_vars(&lhs, bound, free)
    collect_free_vars(&rhs, bound, free)
  when ExprKind::UnaryOp(_, inner) then
    collect_free_vars(&inner, bound, free)
  when ExprKind::Block(block) then
    mut new_bound = bound.clone()
    for stmt in block.stmts do
      match stmt.kind
      when StmtKind::Let(pattern, _, init, _) then
        collect_free_vars(&init, &new_bound, free)
        match pattern.kind
        when PatternKind::Ident(name, _) then new_bound.insert(name.clone())
        when _ then ()
        end
      when StmtKind::Expr(e) then
        collect_free_vars(&e, &new_bound, free)
      when _ then ()
      end
    end
  when _ then ()
  end
end

# Utility to check if a variable can be stack-allocated
def can_stack_allocate(escape_info: &Map[String, EscapeInfo], var_name: &String) -> Bool
  match escape_info.get(var_name.clone())
  when Option::Some(info) then
    match info.escape_state
    when EscapeState::NoEscape then true
    when _ then false
    end
  when Option::None then
    # Unknown variable - conservatively say no
    false
  end
end
