# tg_compiler/layout_descriptor.tg — Per-target layout descriptors
# Canonical layout categories and per-architecture size/align tables.
#
# This file is the SINGLE SOURCE OF TRUTH for target-specific layout
# parameters. All codegen, runtime, and ABI boundary code must read
# from these descriptors rather than hardcoding sizes.

# ———————————————————————————————————————————————————————————————
# Canonical layout categories
# ———————————————————————————————————————————————————————————————

enum LayoutCategory
  # Fixed-width integer and float types
  Primitive
  # Pointer-width types (references, raw pointers, Box)
  Pointer
  # Fat pointer types (slices, trait objects)
  FatPointer
  # Inline aggregates (structs laid out field-by-field)
  InlineStruct
  # Discriminated unions (enums with tag + max_payload)
  TaggedUnion
  # Dynamically-sized containers (Vec, String, Map, Set)
  DynContainer
  # Zero-sized types (Unit, Never, zero-variant enums)
  ZeroSized
  # Function types (raw function pointers)
  FunctionType
end

# ———————————————————————————————————————————————————————————————
# Per-type layout record
# ———————————————————————————————————————————————————————————————

struct LayoutRecord
  name: String
  category: LayoutCategory
  size: Int              # total size in bytes
  align: Int             # required alignment in bytes
  stride: Int            # distance between consecutive elements
  field_count: Int       # number of fields (0 for primitives)
end

# ———————————————————————————————————————————————————————————————
# Target layout descriptor — one per target architecture
# ———————————————————————————————————————————————————————————————

struct TargetLayoutDescriptor
  arch_name: String                    # "aarch64" or "x86_64"
  pointer_size: Int                    # 8 for LP64
  pointer_align: Int                   # 8 for LP64
  max_align: Int                       # maximum natural alignment
  int_size: Int                        # 8 for LP64
  bool_size: Int                       # 1
  char_size: Int                       # 4 (Unicode scalar)
  fn_ptr_size: Int                     # 8 (raw function pointer)
  endianness: String                   # "little"
  records: Vec[LayoutRecord]           # per-type records
end

# ———————————————————————————————————————————————————————————————
# AArch64 (Apple Silicon) layout descriptor
# ———————————————————————————————————————————————————————————————

def aarch64_layout_descriptor() -> TargetLayoutDescriptor
  mut records: Vec[LayoutRecord] = Vec::new()

  # Primitives
  records.push(LayoutRecord { name: "Bool",   category: LayoutCategory::Primitive, size: 1,  align: 1, stride: 1,  field_count: 0 })
  records.push(LayoutRecord { name: "u8",     category: LayoutCategory::Primitive, size: 1,  align: 1, stride: 1,  field_count: 0 })
  records.push(LayoutRecord { name: "i8",     category: LayoutCategory::Primitive, size: 1,  align: 1, stride: 1,  field_count: 0 })
  records.push(LayoutRecord { name: "u16",    category: LayoutCategory::Primitive, size: 2,  align: 2, stride: 2,  field_count: 0 })
  records.push(LayoutRecord { name: "i16",    category: LayoutCategory::Primitive, size: 2,  align: 2, stride: 2,  field_count: 0 })
  records.push(LayoutRecord { name: "Char",   category: LayoutCategory::Primitive, size: 4,  align: 4, stride: 4,  field_count: 0 })
  records.push(LayoutRecord { name: "u32",    category: LayoutCategory::Primitive, size: 4,  align: 4, stride: 4,  field_count: 0 })
  records.push(LayoutRecord { name: "i32",    category: LayoutCategory::Primitive, size: 4,  align: 4, stride: 4,  field_count: 0 })
  records.push(LayoutRecord { name: "f32",    category: LayoutCategory::Primitive, size: 4,  align: 4, stride: 4,  field_count: 0 })
  records.push(LayoutRecord { name: "Int",    category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "UInt",   category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "u64",    category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "i64",    category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "Float",  category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "f64",    category: LayoutCategory::Primitive, size: 8,  align: 8, stride: 8,  field_count: 0 })

  # Pointers
  records.push(LayoutRecord { name: "Box",    category: LayoutCategory::Pointer,   size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "Ptr",    category: LayoutCategory::Pointer,   size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "Ref",    category: LayoutCategory::Pointer,   size: 8,  align: 8, stride: 8,  field_count: 0 })
  records.push(LayoutRecord { name: "RefMut", category: LayoutCategory::Pointer,   size: 8,  align: 8, stride: 8,  field_count: 0 })

  # Dynamic containers
  records.push(LayoutRecord { name: "String", category: LayoutCategory::DynContainer, size: 24, align: 8, stride: 24, field_count: 3 })
  records.push(LayoutRecord { name: "Vec",    category: LayoutCategory::DynContainer, size: 24, align: 8, stride: 24, field_count: 3 })
  records.push(LayoutRecord { name: "Map",    category: LayoutCategory::DynContainer, size: 48, align: 8, stride: 48, field_count: 4 })
  records.push(LayoutRecord { name: "Set",    category: LayoutCategory::DynContainer, size: 32, align: 8, stride: 32, field_count: 2 })

  # Tagged unions
  records.push(LayoutRecord { name: "Option", category: LayoutCategory::TaggedUnion,  size: 16, align: 8, stride: 16, field_count: 2 })
  records.push(LayoutRecord { name: "Result", category: LayoutCategory::TaggedUnion,  size: 24, align: 8, stride: 24, field_count: 3 })

  # Zero-sized
  records.push(LayoutRecord { name: "Unit",   category: LayoutCategory::ZeroSized,    size: 0,  align: 1, stride: 0,  field_count: 0 })
  records.push(LayoutRecord { name: "Never",  category: LayoutCategory::ZeroSized,    size: 0,  align: 1, stride: 0,  field_count: 0 })

  # Function types
  records.push(LayoutRecord { name: "Fn",     category: LayoutCategory::FunctionType, size: 8, align: 8, stride: 8, field_count: 0 })

  TargetLayoutDescriptor {
    arch_name: "aarch64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 8,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 8,
    endianness: "little",
    records: records
  }
end

# ———————————————————————————————————————————————————————————————
# x86-64 layout descriptor
# (Identical to AArch64 for LP64 targets — factored for future
#  divergence if ILP32, x32, or different alignment rules needed)
# ———————————————————————————————————————————————————————————————

def x86_64_layout_descriptor() -> TargetLayoutDescriptor
  mut desc = aarch64_layout_descriptor()
  desc.arch_name = "x86_64"
  desc
end

# ———————————————————————————————————————————————————————————————
# Descriptor lookup
# ———————————————————————————————————————————————————————————————

def layout_descriptor_for_arch(arch: Arch) -> TargetLayoutDescriptor
  match arch
  when Arch::AArch64 then aarch64_layout_descriptor()
  when Arch::X86_64  then x86_64_layout_descriptor()
  end
end

# Look up a LayoutRecord by type name in a descriptor.
def lookup_layout(desc: TargetLayoutDescriptor, name: String) -> Option[LayoutRecord]
  for r in desc.records do
    if r.name == *name then
      return Option::Some(r.clone())
    end
  end
  Option::None
end

# Validate that an observed size matches the descriptor.
def validate_type_size(desc: TargetLayoutDescriptor, name: String, observed_size: Int) -> Bool
  match lookup_layout(desc, name)
  when Option::Some(rec) then rec.size == observed_size
  when Option::None then true  # unknown type, no constraint
  end
end
