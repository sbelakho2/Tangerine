# Tangerine Compiler — Native Linker
# Self-hosting compiler written in Tangerine
#
# Produces native executables directly — NO external linker dependency.
# Supports:
#   ELF64 executable  (Linux)
#   Mach-O executable (macOS)
#   PE executable     (Windows)
#
# This linker handles:
#   - Symbol resolution across object files
#   - Relocation patching
#   - Section merging and layout
#   - Entry point setup (_start / _main)
#   - Program header / load command generation

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}
use std::fs::{write_file_bytes}
use tg_compiler::asm::{Arch, OsAbi, TargetTriple, RelocKind}
use tg_compiler::object::{
  ObjectFile, build_object,
  write16, write32, write64, emit_zeros_vec, append_vec, pad_to, align_up,
  push_str, write_padded_str
}

# ———————————————————————————————————————————————————————————————
# Linker types
# ———————————————————————————————————————————————————————————————

struct LinkerInput
  objects: Vec[ObjectFile]
  entry: String           # entry point symbol (_start or _main)
  output: String          # output file path
  target: TargetTriple
end

struct LinkedSection
  name: String
  data: Vec[u8]
  mem_size: u64
  vaddr: u64
  file_offset: u64
  alignment: u64
  flags: u64     # rwx permissions
end

struct LinkerSymbol
  name: String
  value: u64     # resolved virtual address
  section: Int   # section index
  is_defined: Bool
end

struct LinkerCtx
  sections: Vec[LinkedSection]
  symbols: Map[String, LinkerSymbol]
  entry_addr: u64
  target: TargetTriple
end

# GOT/PLT support for dynamic linking
struct GotEntry
  symbol_name: String
  got_offset: u64       # offset within GOT section
end

struct PltEntry
  symbol_name: String
  plt_offset: u64       # offset within PLT section
  got_index: u64        # corresponding GOT entry index
end

struct DynamicLinkInfo
  got_entries: Vec[GotEntry]
  plt_entries: Vec[PltEntry]
  got_section_vaddr: u64
  plt_section_vaddr: u64
end

# Build GOT and PLT entries for external/undefined symbols
def build_got_plt(objects: &Vec[ObjectFile], syms: &Map[String, LinkerSymbol]) -> DynamicLinkInfo
  mut got_entries = Vec::new()
  mut plt_entries = Vec::new()
  mut got_offset: u64 = 0
  mut plt_offset: u64 = 16  # First 16 bytes are PLT0 stub
  mut got_index: u64 = 0

  # Scan relocations for external references needing GOT/PLT
  mut extern_syms: Map[String, Bool] = Map::new()
  for obj in objects do
    for reloc in obj.relocations do
      match reloc.kind
      when RelocKind::R_X86_64_PLT32 then
        # PLT call - might need PLT entry for dynamic linking
        match syms.get(&reloc.symbol)
        when Option::Some(sym) then
          if !sym.is_defined then
            extern_syms.insert(reloc.symbol.clone(), true)
          end
        when Option::None then
          extern_syms.insert(reloc.symbol.clone(), true)
        end
      when RelocKind::R_X86_64_GOTPCREL then
        # Reference via GOT
        match syms.get(&reloc.symbol)
        when Option::Some(sym) then
          if !sym.is_defined then
            extern_syms.insert(reloc.symbol.clone(), true)
          end
        when Option::None then
          extern_syms.insert(reloc.symbol.clone(), true)
        end
      when _ then ()
      end
    end
  end

  # Create GOT and PLT entries for external symbols
  for sym_name in extern_syms.keys() do
    # GOT entry: 8 bytes per entry (64-bit address)
    got_entries.push(GotEntry {
      symbol_name: sym_name.clone(),
      got_offset: got_offset
    })
    
    # PLT entry: 16 bytes per entry (x86-64 PLT stub)
    plt_entries.push(PltEntry {
      symbol_name: sym_name.clone(),
      plt_offset: plt_offset,
      got_index: got_index
    })
    
    got_offset = got_offset + 8
    plt_offset = plt_offset + 16
    got_index = got_index + 1
  end

  DynamicLinkInfo {
    got_entries: got_entries,
    plt_entries: plt_entries,
    got_section_vaddr: 0,  # Set later during layout
    plt_section_vaddr: 0
  }
end

# Generate GOT section data (array of 8-byte addresses)
def emit_got_section(info: &DynamicLinkInfo, syms: &Map[String, LinkerSymbol]) -> Vec[u8]
  mut data = Vec::new()
  for entry in info.got_entries do
    let addr = match syms.get(&entry.symbol_name)
    when Option::Some(sym) then sym.value
    when Option::None then 0 as u64  # Lazy binding: filled by dynamic linker
    end
    write64(&mut data, addr)
  end
  data
end

# Generate PLT section data (PLT0 + per-symbol stubs)
def emit_plt_section(info: &DynamicLinkInfo) -> Vec[u8]
  mut data = Vec::new()
  
  # PLT0: push GOT[1], jmp GOT[2] - resolver stub
  # push [rip+offset to GOT[1]]   ; ff 35 xx xx xx xx
  # jmp  [rip+offset to GOT[2]]   ; ff 25 xx xx xx xx
  # nop padding
  data.push(0xff); data.push(0x35)
  write32(&mut data, 0)  # Placeholder for GOT[1] offset
  data.push(0xff); data.push(0x25)
  write32(&mut data, 0)  # Placeholder for GOT[2] offset
  emit_zeros_vec(&mut data, 4)  # padding to 16 bytes
  
  # Per-symbol PLT entries
  for entry in info.plt_entries do
    # jmp [rip+offset_to_got]     ; ff 25 xx xx xx xx
    # push imm32 (got index)      ; 68 xx xx xx xx
    # jmp plt0                    ; e9 xx xx xx xx
    data.push(0xff); data.push(0x25)
    write32(&mut data, 0)  # Placeholder for GOT offset
    data.push(0x68)
    write32(&mut data, entry.got_index as u32)
    data.push(0xe9)
    # Jump back to PLT0 (negative offset)
    let plt0_offset = -((entry.plt_offset as i32) + 16)
    write32(&mut data, plt0_offset as u32)
  end
  
  data
end

# ———————————————————————————————————————————————————————————————
# Symbol resolution
# ———————————————————————————————————————————————————————————————

def resolve_symbols(objects: &Vec[ObjectFile]) -> Result[Map[String, LinkerSymbol], String]
  mut syms = Map::new()

  for obj in objects do
    for sym in obj.symbols do
      match syms.get(sym.name)
      when Option::Some(existing) then
        if existing.is_defined then
          return Result::Err("duplicate symbol: " + sym.name)
        end
      when Option::None then ()
      end
      let sec_idx = match sym.section
      when Section::Text   then 0
      when Section::Data   then 2
      when Section::Rodata then 1
      when Section::Bss    then 3
      when _               then 0
      end
      syms.insert(sym.name, LinkerSymbol {
        name: sym.name,
        value: sym.offset as u64,
        section: sec_idx,
        is_defined: true
      })
    end
  end

  Result::Ok(syms)
end



# After sections are merged and virtual addresses assigned we walk every
# relocation from every object file and patch the bytes in the merged
# section data so that cross-reference addresses are correct.

def patch_relocations(
  objects: &Vec[ObjectFile],
  sections: &mut Vec[LinkedSection],
  syms: &Map[String, LinkerSymbol],
  text_offsets: &Vec[u64]       # per-object byte offset into merged .text
) -> Result[Unit, String]

  mut obj_idx = 0
  for obj in objects do
    let obj_text_base = text_offsets[obj_idx]

    for reloc in obj.relocations do
      # Target symbol virtual address
      let target_sym = match syms.get(reloc.symbol)
      when Option::Some(s) then s
      when Option::None then
        return Result::Err("undefined symbol in relocation: " + reloc.symbol)
      end

      # The relocation offset is relative to this object's .text start.
      # Translate to offset within the merged section.
      let patch_offset = (obj_text_base as Int) + reloc.offset
      let target_vaddr = sections[target_sym.section].vaddr + target_sym.value

      # Address of the site being patched (for PC-relative)
      let site_vaddr = sections[0].vaddr + patch_offset as u64

      match reloc.kind
      # ---- x86-64 relocations ----
      when RelocKind::R_X86_64_PC32 then
        let delta = (target_vaddr as i64) - (site_vaddr as i64) + (reloc.addend as i64)
        write32_at(&mut sections[0].data, patch_offset, delta as u32)

      when RelocKind::R_X86_64_PLT32 then
        let delta = (target_vaddr as i64) - (site_vaddr as i64) + (reloc.addend as i64)
        write32_at(&mut sections[0].data, patch_offset, delta as u32)

      when RelocKind::R_X86_64_64 then
        let abs = (target_vaddr as i64) + (reloc.addend as i64)
        write64_at(&mut sections[0].data, patch_offset, abs as u64)

      when RelocKind::R_X86_64_GOTPCREL then
        # Without a GOT we treat GOTPCREL the same as PC32 (static link only)
        let delta = (target_vaddr as i64) - (site_vaddr as i64) + (reloc.addend as i64)
        write32_at(&mut sections[0].data, patch_offset, delta as u32)

      # ---- ARM64 relocations ----
      when RelocKind::R_AARCH64_CALL26 then
        let delta = ((target_vaddr as i64) - (site_vaddr as i64)) >> 2
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0xFC000000) | ((delta as u32) & 0x03FFFFFF)
        write32_at(&mut sections[0].data, patch_offset, patched)

      when RelocKind::R_AARCH64_ADR_PREL_PG_HI21 then
        let page_target = target_vaddr & 0xFFFFFFFFFFFFF000
        let page_site   = site_vaddr   & 0xFFFFFFFFFFFFF000
        let page_delta  = ((page_target as i64) - (page_site as i64)) >> 12
        let immlo = (page_delta as u32) & 0x3
        let immhi = ((page_delta as u32) >> 2) & 0x7FFFF
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0x9F00001F) | (immlo << 29) | (immhi << 5)
        write32_at(&mut sections[0].data, patch_offset, patched)

      when RelocKind::R_AARCH64_ADD_ABS_LO12_NC then
        let lo12 = (target_vaddr as u32) & 0xFFF
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0xFFC003FF) | (lo12 << 10)
        write32_at(&mut sections[0].data, patch_offset, patched)

      # ---- Mach-O relocations ----
      when RelocKind::X86_64_RELOC_BRANCH then
        let delta = (target_vaddr as i64) - (site_vaddr as i64) - 4
        write32_at(&mut sections[0].data, patch_offset, delta as u32)

      when RelocKind::X86_64_RELOC_SIGNED then
        let delta = (target_vaddr as i64) - (site_vaddr as i64) + (reloc.addend as i64)
        write32_at(&mut sections[0].data, patch_offset, delta as u32)

      when RelocKind::ARM64_RELOC_BRANCH26 then
        let delta = ((target_vaddr as i64) - (site_vaddr as i64)) >> 2
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0xFC000000) | ((delta as u32) & 0x03FFFFFF)
        write32_at(&mut sections[0].data, patch_offset, patched)

      when RelocKind::ARM64_RELOC_PAGE21 then
        let page_target = target_vaddr & 0xFFFFFFFFFFFFF000
        let page_site   = site_vaddr   & 0xFFFFFFFFFFFFF000
        let page_delta  = ((page_target as i64) - (page_site as i64)) >> 12
        let immlo = (page_delta as u32) & 0x3
        let immhi = ((page_delta as u32) >> 2) & 0x7FFFF
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0x9F00001F) | (immlo << 29) | (immhi << 5)
        write32_at(&mut sections[0].data, patch_offset, patched)

      when RelocKind::ARM64_RELOC_PAGEOFF12 then
        let lo12 = (target_vaddr as u32) & 0xFFF
        let existing = read32_at(&sections[0].data, patch_offset)
        let patched = (existing & 0xFFC003FF) | (lo12 << 10)
        write32_at(&mut sections[0].data, patch_offset, patched)

      when _ then
        return Result::Err("unsupported relocation kind during patching")
      end
    end

    obj_idx = obj_idx + 1
  end

  Result::Ok(())
end

# Helpers for in-place binary patching
def write32_at(data: &mut Vec[u8], offset: Int, value: u32) -> Unit
  data[offset]     = (value & 0xFF) as u8
  data[offset + 1] = ((value >> 8) & 0xFF) as u8
  data[offset + 2] = ((value >> 16) & 0xFF) as u8
  data[offset + 3] = ((value >> 24) & 0xFF) as u8
end

def write64_at(data: &mut Vec[u8], offset: Int, value: u64) -> Unit
  mut i = 0
  while i < 8 do
    data[offset + i] = ((value >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
end

def read32_at(data: &Vec[u8], offset: Int) -> u32
  (data[offset] as u32)
    | ((data[offset + 1] as u32) << 8)
    | ((data[offset + 2] as u32) << 16)
    | ((data[offset + 3] as u32) << 24)
end

# ———————————————————————————————————————————————————————————————
# Section merging
# ———————————————————————————————————————————————————————————————

def merge_sections(objects: &Vec[ObjectFile]) -> Vec[LinkedSection]
  mut text_data = Vec::new()
  mut data_data = Vec::new()
  mut rodata_data = Vec::new()
  mut total_bss: u64 = 0

  for obj in objects do
    append_vec(&mut text_data, &obj.text)
    append_vec(&mut data_data, &obj.data)
    append_vec(&mut rodata_data, &obj.rodata)
    total_bss = total_bss + obj.bss_size as u64
  end

  mut sections = Vec::new()
  sections.push(LinkedSection {
    name: ".text",
    data: text_data,
    mem_size: text_data.len() as u64,
    vaddr: 0,
    file_offset: 0,
    alignment: 16,
    flags: 5   # r-x
  })
  sections.push(LinkedSection {
    name: ".rodata",
    data: rodata_data,
    mem_size: rodata_data.len() as u64,
    vaddr: 0,
    file_offset: 0,
    alignment: 8,
    flags: 4   # r--
  })
  sections.push(LinkedSection {
    name: ".data",
    data: data_data,
    mem_size: data_data.len() as u64,
    vaddr: 0,
    file_offset: 0,
    alignment: 8,
    flags: 6   # rw-
  })

  # .bss (virtual-only, no file data)
  if total_bss > 0 then
    sections.push(LinkedSection {
      name: ".bss",
      data: Vec::new(),
      mem_size: total_bss,
      vaddr: 0,
      file_offset: 0,
      alignment: 8,
      flags: 6   # rw-
    })
  end

  sections
end

# ———————————————————————————————————————————————————————————————
# ELF64 Executable Generation
# ———————————————————————————————————————————————————————————————

# Program header types
def PT_NULL()    -> u32 = 0
def PT_LOAD()    -> u32 = 1
def PT_INTERP()  -> u32 = 3

# Program header flags
def PF_X() -> u32 = 1
def PF_W() -> u32 = 2
def PF_R() -> u32 = 4

def link_elf64(input: &LinkerInput) -> Result[Vec[u8], String]
  mut out = Vec::new()

  # Track per-object offsets into merged .text for relocation patching
  mut text_offsets = Vec::new()
  mut running_offset: u64 = 0
  for obj in input.objects do
    text_offsets.push(running_offset)
    running_offset = running_offset + obj.text.len() as u64
  end

  # Merge sections
  mut sections = merge_sections(&input.objects)

  # Resolve symbols
  let syms = match resolve_symbols(&input.objects)
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(e)
  end

  # Layout
  # Note: 0x400000 is the standard Linux x86-64 ELF base address.
  # macOS (Mach-O) uses 0x100000000 — see link_macho64().
  # Windows (PE) uses 0x140000000 — see link_pe64().
  let base_addr: u64 = 0x400000
  let ehdr_size = 64
  let phdr_size = 56
  let num_phdrs = sections.len()
  let phdrs_total = num_phdrs * phdr_size

  mut file_offset = align_up(ehdr_size + phdrs_total, 4096) as u64
  mut vaddr = base_addr + file_offset

  # Assign addresses to sections
  mut i = 0
  while i < sections.len() do
    sections[i].file_offset = file_offset
    sections[i].vaddr = vaddr

    let sec_file_size = sections[i].data.len() as u64
    let sec_mem_size = sections[i].mem_size
    file_offset = file_offset + sec_file_size
    vaddr = vaddr + sec_mem_size

    # Page-align next segment
    file_offset = align_up(file_offset as Int, 4096) as u64
    vaddr = align_up(vaddr as Int, 4096) as u64

    i = i + 1
  end

  # Patch relocations now that section addresses are assigned
  match patch_relocations(&input.objects, &mut sections, &syms, &text_offsets)
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("relocation error: " + e)
  end

  # Find entry point and report error if undefined
  let entry_addr = match syms.get(&input.entry)
  when Option::Some(sym) then
    # entry is relative to .text; add .text vaddr
    sections[0].vaddr + sym.value
  when Option::None then
    return Result::Err("undefined entry point symbol: " + input.entry.clone())
  end

  # --- ELF Header ---
  # e_ident
  out.push(0x7F); out.push(0x45); out.push(0x4C); out.push(0x46)  # \x7fELF
  out.push(2)   # ELFCLASS64
  out.push(1)   # ELFDATA2LSB
  out.push(1)   # EV_CURRENT
  out.push(0)   # OSABI
  emit_zeros_vec(&mut out, 8)

  let machine = match input.target.arch
  when Arch::X86_64  then 62 as u16
  when Arch::AArch64 then 183 as u16
  end

  write16(&mut out, 2)           # ET_EXEC
  write16(&mut out, machine)
  write32(&mut out, 1)           # e_version
  write64(&mut out, entry_addr)  # e_entry
  write64(&mut out, ehdr_size as u64)  # e_phoff
  write64(&mut out, 0)           # e_shoff (no section headers in exec)
  write32(&mut out, 0)           # e_flags
  write16(&mut out, ehdr_size as u16)
  write16(&mut out, phdr_size as u16)
  write16(&mut out, num_phdrs as u16)
  write16(&mut out, 0)           # e_shentsize
  write16(&mut out, 0)           # e_shnum
  write16(&mut out, 0)           # e_shstrndx

  # --- Program Headers ---
  for sec in sections do
    let sec_file_size = sec.data.len() as u64
    let sec_mem_size = sec.mem_size
    let pflags = match sec.name
    when ".text"   then PF_R() | PF_X()
    when ".rodata" then PF_R()
    when ".data"   then PF_R() | PF_W()
    when ".bss"    then PF_R() | PF_W()
    when _          then PF_R()
    end

    write32(&mut out, PT_LOAD())
    write32(&mut out, pflags)
    write64(&mut out, sec.file_offset)     # p_offset
    write64(&mut out, sec.vaddr)           # p_vaddr
    write64(&mut out, sec.vaddr)           # p_paddr
    write64(&mut out, sec_file_size)       # p_filesz
    write64(&mut out, sec_mem_size)        # p_memsz
    write64(&mut out, sec.alignment)       # p_align
  end

  # --- Section data ---
  for sec in sections do
    pad_to(&mut out, sec.file_offset as Int)
    append_vec(&mut out, &sec.data)
  end

  Result::Ok(out)
end

# ———————————————————————————————————————————————————————————————
# Mach-O Executable Generation (macOS)
# ———————————————————————————————————————————————————————————————

def link_macho64(input: &LinkerInput) -> Result[Vec[u8], String]
  mut out = Vec::new()

  # Track per-object text offsets for relocation patching
  mut text_offsets = Vec::new()
  mut running_offset: u64 = 0
  for obj in input.objects do
    text_offsets.push(running_offset)
    running_offset = running_offset + obj.text.len() as u64
  end

  # Merge sections
  mut sections = merge_sections(&input.objects)
  let syms = match resolve_symbols(&input.objects)
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(e)
  end

  let is_arm = match input.target.arch
  when Arch::AArch64 then true
  when _ then false
  end

  let cputype = if is_arm then 0x0100000C as u32 else 0x01000007 as u32 end
  let cpusubtype = if is_arm then 0 as u32 else 3 as u32 end

  # Mach-O constants
  let MH_EXECUTE = 2 as u32
  let LC_SEGMENT_64 = 0x19 as u32
  let LC_MAIN = 0x80000028 as u32
  let LC_SYMTAB = 0x02 as u32
  let LC_DYSYMTAB = 0x0B as u32
  let LC_BUILD_VERSION = 0x32 as u32
  let LC_LOAD_DYLINKER = 0x0E as u32
  let LC_LOAD_DYLIB = 0x0C as u32

  # ARM64 macOS requires 16KB page alignment for segments
  let page_size = if is_arm then 16384 else 4096 end
  let base: u64 = 0x100000000   # macOS default base = 4GB

  # Segments: __PAGEZERO, __TEXT, __DATA, __LINKEDIT
  let text_sect_count = 2   # __text, __const
  let data_sect_count = 1   # __data

  let pagezero_cmd_size = 72   # LC_SEGMENT_64 with 0 sections
  let text_seg_cmd_size = 72 + (text_sect_count * 80)
  let data_seg_cmd_size = 72 + (data_sect_count * 80)
  let linkedit_cmd_size = 72   # LC_SEGMENT_64 with 0 sections
  let main_cmd_size = 24
  let symtab_cmd_size = 24
  let dysymtab_cmd_size = 80
  let build_version_cmd_size = 24  # LC_BUILD_VERSION with 0 tools
  let dylinker_cmd_size = 32       # LC_LOAD_DYLINKER "/usr/lib/dyld"
  let dylib_cmd_size = 56          # LC_LOAD_DYLIB "/usr/lib/libSystem.B.dylib"
  let uuid_cmd_size = 24           # LC_UUID (16 bytes of UUID)
  let codesign_reserve = 16        # space reserved for codesign to insert LC_CODE_SIGNATURE
  let num_cmds = 11
  let load_cmds_size = pagezero_cmd_size + text_seg_cmd_size + data_seg_cmd_size + linkedit_cmd_size + main_cmd_size + symtab_cmd_size + dysymtab_cmd_size + build_version_cmd_size + dylinker_cmd_size + dylib_cmd_size + uuid_cmd_size
  let header_size = 32
  # __TEXT starts at fileoff 0 (includes header + load commands)
  # Code is placed right after load commands, 16-byte aligned
  let code_fileoff = align_up(header_size + load_cmds_size + codesign_reserve, 16)
  let rodata_fileoff = code_fileoff + sections[0].data.len()
  let text_seg_filesize = align_up(rodata_fileoff + sections[1].data.len(), page_size)
  let text_seg_size = text_seg_filesize  # __TEXT segment starts at fileoff=0

  let data_fileoff = text_seg_filesize
  let data_seg_size = if sections[2].data.len() > 0 then align_up(sections[2].data.len(), page_size) else 0 end

  # Assign virtual addresses — __TEXT at base, code within it
  let text_seg_vaddr = base
  let text_vaddr = base + code_fileoff as u64
  let rodata_vaddr = base + rodata_fileoff as u64
  let data_vaddr = base + data_fileoff as u64

  sections[0].vaddr = text_vaddr
  sections[0].file_offset = code_fileoff as u64
  sections[1].vaddr = rodata_vaddr
  sections[1].file_offset = rodata_fileoff as u64
  sections[2].vaddr = data_vaddr
  sections[2].file_offset = data_fileoff as u64

  # Patch relocations
  match patch_relocations(&input.objects, &mut sections, &syms, &text_offsets)
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("relocation error: " + e)
  end

  # Entry point offset (relative to start of __TEXT segment, which is fileoff=0)
  let entry_off = match syms.get(&input.entry)
  when Option::Some(sym) then (code_fileoff as u64) + (sym.value as u64)
  when Option::None then
    return Result::Err("undefined entry point symbol: " + input.entry.clone())
  end

  # Empty string table (just a NUL byte) for LC_SYMTAB, placed in __LINKEDIT
  let linkedit_fileoff = data_fileoff + data_seg_size
  let strtab_off = linkedit_fileoff
  let strtab_size = 1
  let linkedit_size = align_up(strtab_size, page_size)
  let linkedit_vaddr = data_vaddr + data_seg_size as u64

  # --- Mach-O Header (32 bytes) ---
  write32(&mut out, 0xFEEDFACF)       # MH_MAGIC_64
  write32(&mut out, cputype)
  write32(&mut out, cpusubtype)
  write32(&mut out, MH_EXECUTE)
  write32(&mut out, num_cmds as u32)
  write32(&mut out, load_cmds_size as u32)
  write32(&mut out, 0x200085 as u32)    # MH_PIE | MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL
  write32(&mut out, 0)                 # reserved

  # --- LC_SEGMENT_64: __PAGEZERO (null guard page) ---
  write32(&mut out, LC_SEGMENT_64)
  write32(&mut out, pagezero_cmd_size as u32)
  write_padded_str(&mut out, "__PAGEZERO", 16)      # segname
  write64(&mut out, 0)                              # vmaddr
  write64(&mut out, base)                           # vmsize = 4GB
  write64(&mut out, 0)                              # fileoff
  write64(&mut out, 0)                              # filesize
  write32(&mut out, 0)                              # maxprot: none
  write32(&mut out, 0)                              # initprot: none
  write32(&mut out, 0)                              # nsects
  write32(&mut out, 0)                              # flags

  # --- LC_SEGMENT_64: __TEXT (r-x), contains header + __text + __const ---
  write32(&mut out, LC_SEGMENT_64)
  write32(&mut out, text_seg_cmd_size as u32)
  write_padded_str(&mut out, "__TEXT", 16)          # segname
  write64(&mut out, text_seg_vaddr)                 # vmaddr = base
  write64(&mut out, text_seg_size as u64)           # vmsize
  write64(&mut out, 0)                              # fileoff = 0 (includes header)
  write64(&mut out, text_seg_filesize as u64)       # filesize
  write32(&mut out, 5)                              # maxprot: r-x
  write32(&mut out, 5)                              # initprot: r-x
  write32(&mut out, text_sect_count as u32)         # nsects
  write32(&mut out, 0)                              # flags

  # section: __text in __TEXT
  write_padded_str(&mut out, "__text", 16)
  write_padded_str(&mut out, "__TEXT", 16)
  write64(&mut out, text_vaddr)
  write64(&mut out, sections[0].data.len() as u64)
  write32(&mut out, code_fileoff as u32)
  write32(&mut out, 4)                   # align = 2^4 = 16
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, 0x80000400)          # S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # section: __const in __TEXT
  write_padded_str(&mut out, "__const", 16)
  write_padded_str(&mut out, "__TEXT", 16)
  write64(&mut out, rodata_vaddr)
  write64(&mut out, sections[1].data.len() as u64)
  write32(&mut out, rodata_fileoff as u32)
  write32(&mut out, 3)                   # align = 2^3 = 8
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, 0)                   # S_REGULAR
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # --- LC_SEGMENT_64: __DATA (rw-), contains __data ---
  write32(&mut out, LC_SEGMENT_64)
  write32(&mut out, data_seg_cmd_size as u32)
  write_padded_str(&mut out, "__DATA", 16)          # segname
  write64(&mut out, data_vaddr)                     # vmaddr
  write64(&mut out, data_seg_size as u64)           # vmsize
  write64(&mut out, data_fileoff as u64)            # fileoff
  write64(&mut out, data_seg_size as u64)           # filesize
  write32(&mut out, 3)                              # maxprot: rw-
  write32(&mut out, 3)                              # initprot: rw-
  write32(&mut out, data_sect_count as u32)
  write32(&mut out, 0)

  # section: __data in __DATA
  write_padded_str(&mut out, "__data", 16)
  write_padded_str(&mut out, "__DATA", 16)
  write64(&mut out, data_vaddr)
  write64(&mut out, sections[2].data.len() as u64)
  write32(&mut out, data_fileoff as u32)
  write32(&mut out, 3)
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, 0)
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # --- LC_SEGMENT_64: __LINKEDIT (symbol/string table data) ---
  write32(&mut out, LC_SEGMENT_64)
  write32(&mut out, linkedit_cmd_size as u32)
  write_padded_str(&mut out, "__LINKEDIT", 16)      # segname
  write64(&mut out, linkedit_vaddr)                 # vmaddr
  write64(&mut out, linkedit_size as u64)           # vmsize
  write64(&mut out, linkedit_fileoff as u64)        # fileoff
  write64(&mut out, strtab_size as u64)             # filesize
  write32(&mut out, 1)                              # maxprot: r--
  write32(&mut out, 1)                              # initprot: r--
  write32(&mut out, 0)                              # nsects
  write32(&mut out, 0)                              # flags

  # --- LC_MAIN ---
  write32(&mut out, LC_MAIN)
  write32(&mut out, main_cmd_size as u32)
  write64(&mut out, entry_off)        # entryoff (relative to __TEXT start)
  write64(&mut out, 0)                # stacksize (default)

  # --- LC_SYMTAB ---
  write32(&mut out, LC_SYMTAB)
  write32(&mut out, symtab_cmd_size as u32)
  write32(&mut out, 0)                # symoff  (no symbols in minimal exe)
  write32(&mut out, 0)                # nsyms
  write32(&mut out, strtab_off as u32)  # stroff
  write32(&mut out, strtab_size as u32) # strsize

  # --- LC_DYSYMTAB ---
  write32(&mut out, LC_DYSYMTAB)
  write32(&mut out, dysymtab_cmd_size as u32)
  emit_zeros_vec(&mut out, dysymtab_cmd_size - 8)  # all fields zero for static exe

  # --- LC_BUILD_VERSION ---
  write32(&mut out, LC_BUILD_VERSION)
  write32(&mut out, build_version_cmd_size as u32)
  write32(&mut out, 1)                # platform: macOS
  write32(&mut out, 0x000E0000 as u32)  # minos: 14.0.0
  write32(&mut out, 0)                # sdk: 0
  write32(&mut out, 0)                # ntools: 0

  # --- LC_LOAD_DYLINKER ---
  write32(&mut out, LC_LOAD_DYLINKER)
  write32(&mut out, dylinker_cmd_size as u32)
  write32(&mut out, 12)               # name offset (right after these 3 u32s)
  write_padded_str(&mut out, "/usr/lib/dyld", dylinker_cmd_size - 12)

  # --- LC_LOAD_DYLIB: libSystem.B.dylib ---
  write32(&mut out, LC_LOAD_DYLIB)
  write32(&mut out, dylib_cmd_size as u32)
  write32(&mut out, 24)               # name offset (after cmd+cmdsize+timestamp+current+compat)
  write32(&mut out, 0)                # timestamp
  write32(&mut out, 0x010000 as u32)  # current_version: 1.0.0
  write32(&mut out, 0x010000 as u32)  # compatibility_version: 1.0.0
  write_padded_str(&mut out, "/usr/lib/libSystem.B.dylib", dylib_cmd_size - 24)

  # --- LC_UUID ---
  let LC_UUID = 0x1B as u32
  write32(&mut out, LC_UUID)
  write32(&mut out, uuid_cmd_size as u32)
  # Fixed UUID (deterministic): 54 47 43 4F 4D 50 00 00 00 00 00 00 00 00 00 01
  # "TGCOMP" + version 1
  write32(&mut out, 0x54474F4D as u32)
  write32(&mut out, 0x50000000 as u32)
  write32(&mut out, 0x00000000 as u32)
  write32(&mut out, 0x00000001 as u32)

  # --- Section data ---
  pad_to(&mut out, code_fileoff)
  append_vec(&mut out, &sections[0].data)   # __text
  append_vec(&mut out, &sections[1].data)   # __const (rodata)
  pad_to(&mut out, data_fileoff)
  append_vec(&mut out, &sections[2].data)   # __data

  # String table (single NUL)
  pad_to(&mut out, strtab_off)
  out.push(0)

  Result::Ok(out)
end

# ———————————————————————————————————————————————————————————————
# PE Executable Generation (Windows)
# ———————————————————————————————————————————————————————————————

def link_pe64(input: &LinkerInput) -> Result[Vec[u8], String]
  mut out = Vec::new()

  # Track per-object text offsets for relocation patching
  mut text_offsets = Vec::new()
  mut running_offset: u64 = 0
  for obj in input.objects do
    text_offsets.push(running_offset)
    running_offset = running_offset + obj.text.len() as u64
  end

  mut sections = merge_sections(&input.objects)
  let syms = match resolve_symbols(&input.objects)
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(e)
  end

  # DOS stub
  out.push(0x4D); out.push(0x5A)  # "MZ"
  emit_zeros_vec(&mut out, 58)
  write32(&mut out, 64)           # e_lfanew -> PE signature at offset 64

  # PE signature
  out.push(0x50); out.push(0x45); out.push(0x00); out.push(0x00)  # "PE\0\0"

  # COFF Header
  let pe_machine = match input.target.arch
  when Arch::X86_64 then 0x8664   # IMAGE_FILE_MACHINE_AMD64
  when Arch::AArch64 then 0xAA64  # IMAGE_FILE_MACHINE_ARM64
  end
  let num_sections = if sections.len() > 3 then 4 else 3 end
  write16(&mut out, pe_machine)
  write16(&mut out, num_sections as u16)
  write32(&mut out, 0)              # TimeDateStamp
  write32(&mut out, 0)              # PointerToSymbolTable
  write32(&mut out, 0)              # NumberOfSymbols
  write16(&mut out, 240)            # SizeOfOptionalHeader
  write16(&mut out, 0x22)           # Characteristics: EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

  # Optional Header (PE32+ = 240 bytes)
  write16(&mut out, 0x020B)         # PE32+ magic
  write16(&mut out, 0)              # LinkerVersion
  write32(&mut out, sections[0].data.len() as u32)   # SizeOfCode
  write32(&mut out, (sections[1].data.len() + sections[2].data.len()) as u32) # SizeOfInitializedData
  write32(&mut out, 0)              # SizeOfUninitializedData

  let image_base: u64 = 0x140000000  # Windows default
  let section_align = 4096
  let file_align = 512

  let text_rva = section_align
  let entry_offset = match syms.get(&input.entry)
  when Option::Some(sym) then sym.value as Int
  when Option::None then
    return Result::Err("undefined entry point symbol: " + input.entry.clone())
  end
  let entry_rva = text_rva + entry_offset

  write32(&mut out, entry_rva as u32)  # AddressOfEntryPoint
  write32(&mut out, text_rva as u32)   # BaseOfCode

  write64(&mut out, image_base)
  write32(&mut out, section_align as u32)
  write32(&mut out, file_align as u32)

  # OS version, image version, subsystem version
  write16(&mut out, 6); write16(&mut out, 0)   # OS ver
  write16(&mut out, 0); write16(&mut out, 0)   # Image ver
  write16(&mut out, 6); write16(&mut out, 0)   # Subsystem ver

  write32(&mut out, 0)                         # Win32VersionValue

  # SizeOfImage: the total virtual size covering all sections
  # Accounts for headers + .text + .rdata + .data, each aligned to section_align
  let text_vsize = align_up(sections[0].data.len(), section_align)
  let rdata_vsize = align_up(sections[1].data.len(), section_align)
  let data_vsize = align_up(sections[2].data.len(), section_align)
  let bss_vsize = if sections.len() > 3 then
    align_up(sections[3].mem_size as Int, section_align)
  else
    0
  end
  let total_rva_size = section_align + text_vsize + rdata_vsize + data_vsize + bss_vsize
  write32(&mut out, total_rva_size as u32)     # SizeOfImage

  let headers_size = align_up(64 + 4 + 20 + 240 + (num_sections * 40), file_align)
  write32(&mut out, headers_size as u32)       # SizeOfHeaders
  write32(&mut out, 0)                         # CheckSum
  write16(&mut out, 3)                         # Subsystem: CONSOLE
  write16(&mut out, 0x8160)                    # DllCharacteristics: NX_COMPAT|DYNAMIC_BASE|HIGH_ENTROPY_VA|TERMINAL_SERVER_AWARE

  # Stack and heap sizes
  write64(&mut out, 0x100000)   # SizeOfStackReserve
  write64(&mut out, 0x1000)     # SizeOfStackCommit
  write64(&mut out, 0x100000)   # SizeOfHeapReserve
  write64(&mut out, 0x1000)     # SizeOfHeapCommit
  write32(&mut out, 0)          # LoaderFlags

  write32(&mut out, 16)         # NumberOfRvaAndSizes

  # Data directories (16 × 8 bytes = 128 bytes, all zero for minimal exe)
  emit_zeros_vec(&mut out, 128)

  # Section headers
  let text_file_off = headers_size
  let data_file_off = align_up(text_file_off + sections[0].data.len(), file_align)
  let rdata_file_off = align_up(data_file_off + sections[2].data.len(), file_align)

  let data_rva = text_rva + align_up(sections[0].data.len(), section_align)
  let rdata_rva = data_rva + align_up(sections[2].data.len(), section_align)
  let bss_rva = rdata_rva + align_up(sections[1].data.len(), section_align)

  # Assign vaddr on sections for relocation patching
  sections[0].vaddr = image_base + text_rva as u64
  sections[1].vaddr = image_base + rdata_rva as u64
  sections[2].vaddr = image_base + data_rva as u64
  if sections.len() > 3 then
    sections[3].vaddr = image_base + bss_rva as u64
  end

  # Patch relocations
  match patch_relocations(&input.objects, &mut sections, &syms, &text_offsets)
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err("relocation error: " + e)
  end

  # .text
  write_padded_str(&mut out, ".text", 8)
  write32(&mut out, sections[0].data.len() as u32)   # VirtualSize
  write32(&mut out, text_rva as u32)
  write32(&mut out, align_up(sections[0].data.len(), file_align) as u32)
  write32(&mut out, text_file_off as u32)
  write32(&mut out, 0); write32(&mut out, 0)
  write16(&mut out, 0); write16(&mut out, 0)
  write32(&mut out, 0x60000020)  # CODE|EXECUTE|READ

  # .data
  write_padded_str(&mut out, ".data", 8)
  write32(&mut out, sections[2].data.len() as u32)
  write32(&mut out, data_rva as u32)
  write32(&mut out, align_up(sections[2].data.len(), file_align) as u32)
  write32(&mut out, data_file_off as u32)
  write32(&mut out, 0); write32(&mut out, 0)
  write16(&mut out, 0); write16(&mut out, 0)
  write32(&mut out, 0xC0000040)  # INITIALIZED|READ|WRITE

  # .rdata
  write_padded_str(&mut out, ".rdata", 8)
  write32(&mut out, sections[1].data.len() as u32)
  write32(&mut out, rdata_rva as u32)
  write32(&mut out, align_up(sections[1].data.len(), file_align) as u32)
  write32(&mut out, rdata_file_off as u32)
  write32(&mut out, 0); write32(&mut out, 0)
  write16(&mut out, 0); write16(&mut out, 0)
  write32(&mut out, 0x40000040)  # INITIALIZED|READ

  if sections.len() > 3 then
    # .bss (uninitialized, virtual only)
    write_padded_str(&mut out, ".bss", 8)
    write32(&mut out, sections[3].mem_size as u32)
    write32(&mut out, bss_rva as u32)
    write32(&mut out, 0)
    write32(&mut out, 0)
    write32(&mut out, 0); write32(&mut out, 0)
    write16(&mut out, 0); write16(&mut out, 0)
    write32(&mut out, 0xC0000080)  # UNINITIALIZED|READ|WRITE
  end

  # Section data
  pad_to(&mut out, text_file_off)
  append_vec(&mut out, &sections[0].data)
  pad_to(&mut out, data_file_off)
  append_vec(&mut out, &sections[2].data)
  pad_to(&mut out, rdata_file_off)
  append_vec(&mut out, &sections[1].data)

  Result::Ok(out)
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def link(input: &LinkerInput) -> Result[Vec[u8], String]
  match input.target.os
  when OsAbi::Linux   then link_elf64(input)
  when OsAbi::MacOS   then link_macho64(input)
  when OsAbi::Windows then link_pe64(input)
  end
end

def link_and_write(input: &LinkerInput) -> Result[Unit, String]
  let bytes = match link(input)
  when Result::Ok(b) then b
  when Result::Err(e) then return Result::Err(e)
  end

  match write_file_bytes(input.output, bytes)
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(e) then Result::Err("failed to write executable: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# Startup code injection
# ———————————————————————————————————————————————————————————————

# Generates minimal _start that calls main() and exits
def inject_start_x64_linux(text: &mut CodeBuffer) -> Unit
  use tg_compiler::asm::{
    x64_xor_rr, x64_mov_rr, x64_call_label, x64_mov_ri,
    x64_syscall, x64_and_ri8, x64_mov_rm, x64_lea_mem,
    def_label, X64
  }

  def_label(text, "_start")

  # Zero RBP (ABI: frame pointer sentinel)
  x64_xor_rr(text, X64::RBP, X64::RBP)

  # argc = [rsp], argv = rsp+8
  # rdi = argc, rsi = argv (for main(argc, argv))
  x64_mov_rm(text, X64::RDI, X64::RSP, 0)    # rdi = [rsp] = argc
  x64_lea_mem(text, X64::RSI, X64::RSP, 8)    # rsi = rsp+8 = argv

  # Align stack to 16 bytes (SysV ABI requirement)
  x64_and_ri8(text, X64::RSP, -16 as i8)

  # Call main
  x64_call_label(text, "main")

  # exit(rax)
  x64_mov_rr(text, X64::RDI, X64::RAX)
  x64_mov_ri(text, X64::RAX, 60)  # SYS_exit
  x64_syscall(text)
end

def inject_start_a64_linux(text: &mut CodeBuffer) -> Unit
  use tg_compiler::asm::{
    a64_mov_rr, a64_bl, a64_mov_ri, a64_svc, a64_ldr, a64_add_rri, def_label, A64
  }

  def_label(text, "_start")

  # x0 = argc (from stack), x1 = argv
  a64_ldr(text, A64::X0, A64::SP, 0)
  a64_add_rri(text, A64::X1, A64::SP, 8)

  # Call main
  a64_bl(text, "main")

  # exit(x0)
  a64_mov_rr(text, A64::X0, A64::X0)  # return code already in X0
  a64_mov_ri(text, A64::X8, 93)       # SYS_exit on ARM64 Linux
  a64_svc(text, 0)
end

# ———————————————————————————————————————————————————————————————
# Link-Time Optimization (LTO)
# ———————————————————————————————————————————————————————————————

enum LtoMode
  None        # No LTO
  Thin        # Thin LTO — per-module optimization + cross-module import
  Fat         # Full LTO — all modules merged into one then optimized
end

struct LtoContext
  mode: LtoMode
  modules: Vec[LtoModule]
  symbol_table: Map[String, LtoSymbolInfo]
  call_graph: Map[String, Vec[String]]   # caller -> callees
end

struct LtoModule
  name: String
  mir_functions: Vec[MirFunction]
  symbols: Vec[LtoSymbolInfo]
end

struct LtoSymbolInfo
  name: String
  module_idx: Int
  is_exported: Bool
  size_bytes: Int
  call_count: Int     # How many times this symbol is referenced
end

def lto_context_new(mode: LtoMode) -> LtoContext
  LtoContext {
    mode: mode,
    modules: Vec::new(),
    symbol_table: Map::new(),
    call_graph: Map::new()
  }
end

def lto_add_module(ctx: &mut LtoContext, module: LtoModule) -> Unit
  let idx = ctx.modules.len() as Int
  for sym in module.symbols do
    mut info = sym.clone()
    info.module_idx = idx
    ctx.symbol_table.insert(sym.name.clone(), info)
  end
  ctx.modules.push(module)
end

# Perform LTO: cross-module dead code elimination and inlining
def perform_lto(ctx: &mut LtoContext) -> Unit
  match ctx.mode
  when LtoMode::None then return
  when LtoMode::Thin then
    lto_thin(ctx)
  when LtoMode::Fat then
    lto_fat(ctx)
  end
end

def lto_thin(ctx: &mut LtoContext) -> Unit
  # Phase 1: Build cross-module call graph
  build_call_graph(ctx)
  
  # Phase 2: Cross-module dead code elimination
  # Mark reachable symbols starting from exported ones
  mut reachable = Set::new()
  mut worklist = Vec::new()
  
  for entry in ctx.symbol_table do
    if entry.value.is_exported then
      worklist.push(entry.key.clone())
      reachable.insert(entry.key.clone())
    end
  end
  
  # Also keep "main" and "_start"
  if !reachable.contains("main") then
    worklist.push("main".to_string())
    reachable.insert("main".to_string())
  end
  
  while !worklist.is_empty() do
    let sym = worklist.pop().unwrap()
    match ctx.call_graph.get(sym.clone())
    when Option::Some(callees) then
      for callee in callees do
        if !reachable.contains(callee.clone()) then
          reachable.insert(callee.clone())
          worklist.push(callee.clone())
        end
      end
    when Option::None then ()
    end
  end
  
  # Remove unreachable functions from each module
  for module in ctx.modules do
    module.mir_functions.retain(|f| reachable.contains(f.name.clone()))
  end
  
  # Phase 3: Cross-module inlining for small functions
  let inline_candidates = find_inline_candidates(ctx)
  let function_index = build_function_index(ctx)
  for candidate in inline_candidates do
    inline_cross_module(ctx, &candidate, &function_index)
  end
end

def lto_fat(ctx: &mut LtoContext) -> Unit
  # Phase 1: Merge all modules into a single module
  mut merged = LtoModule {
    name: "<merged>".to_string(),
    mir_functions: Vec::new(),
    symbols: Vec::new()
  }
  
  for module in ctx.modules do
    for func in module.mir_functions do
      merged.mir_functions.push(func)
    end
    for sym in module.symbols do
      merged.symbols.push(sym)
    end
  end
  
  ctx.modules.clear()
  ctx.modules.push(merged)
  
  # Phase 2: Run full optimization pipeline on merged module
  build_call_graph(ctx)
  
  # Dead code elimination
  mut reachable = Set::new()
  mut worklist = Vec::new()
  
  for entry in ctx.symbol_table do
    if entry.value.is_exported then
      worklist.push(entry.key.clone())
      reachable.insert(entry.key.clone())
    end
  end
  worklist.push("main".to_string())
  reachable.insert("main".to_string())
  
  while !worklist.is_empty() do
    let sym = worklist.pop().unwrap()
    match ctx.call_graph.get(sym.clone())
    when Option::Some(callees) then
      for callee in callees do
        if !reachable.contains(callee.clone()) then
          reachable.insert(callee.clone())
          worklist.push(callee.clone())
        end
      end
    when Option::None then ()
    end
  end
  
  ctx.modules[0].mir_functions.retain(|f| reachable.contains(f.name.clone()))
  
  # Phase 3: Aggressive inlining (no cross-module boundary now)
  let candidates = find_inline_candidates(ctx)
  let function_index = build_function_index(ctx)
  for candidate in candidates do
    inline_cross_module(ctx, &candidate, &function_index)
  end
end

def build_function_index(ctx: &LtoContext) -> Map[String, (Int, Int)]
  mut index: Map[String, (Int, Int)] = Map::new()
  mut mi = 0
  while mi < ctx.modules.len() do
    let mut fi = 0
    while fi < ctx.modules[mi].mir_functions.len() do
      index.insert(ctx.modules[mi].mir_functions[fi].name.clone(), (mi, fi))
      fi = fi + 1
    end
    mi = mi + 1
  end
  index
end

def build_call_graph(ctx: &mut LtoContext) -> Unit
  ctx.call_graph.clear()
  
  for module in ctx.modules do
    for func in module.mir_functions do
      mut callees = Vec::new()
      
      for block in func.blocks do
        match block.terminator.kind
        when MirTerminatorKind::Call(_, func_op, _, _, _) then
          match func_op.kind
          when MirOperandKind::Constant(c) then
            match c.kind
            when MirConstantKind::FnItem(target) then
              callees.push(target.clone())
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      end
      
      ctx.call_graph.insert(func.name.clone(), callees)
    end
  end
end

struct InlineCandidate
  caller: String
  callee: String
  callee_size: Int
end

def find_inline_candidates(ctx: &LtoContext) -> Vec[InlineCandidate]
  mut candidates = Vec::new()
  let max_inline_size = 50  # Maximum MIR statements for inlining
  
  # Build function index: name -> (size, module_idx) for O(1) lookup
  mut func_index: Map[String, (Int, Int)] = Map::new()
  mut mod_idx = 0
  for module in ctx.modules do
    for func in module.mir_functions do
      let size = count_mir_statements(func)
      func_index.insert(func.name.clone(), (size, mod_idx))
    end
    mod_idx = mod_idx + 1
  end
  
  # Now iterate call graph edges with O(1) callee lookup
  for entry in ctx.call_graph do
    for callee_name in entry.value do
      match func_index.get(callee_name)
      when Option::Some((size, _)) then
        if size <= max_inline_size && size > 0 then
          candidates.push(InlineCandidate {
            caller: entry.key.clone(),
            callee: callee_name.clone(),
            callee_size: size
          })
        end
      when Option::None then ()
      end
    end
  end
  
  # Sort by size (inline smallest first)
  candidates.sort_by(|a, b| a.callee_size.cmp(&b.callee_size))
  candidates
end

def count_mir_statements(func: &MirFunction) -> Int
  mut count = 0
  for block in func.blocks do
    count = count + block.statements.len() as Int + 1  # +1 for terminator
  end
  count
end

def inline_cross_module(ctx: &mut LtoContext, candidate: &InlineCandidate, function_index: &Map[String, (Int, Int)]) -> Unit
  let callee_body = match function_index.get(candidate.callee.clone())
  when Option::Some((callee_mod_idx, callee_fn_idx)) then
    Option::Some(ctx.modules[*callee_mod_idx].mir_functions[*callee_fn_idx].clone())
  when Option::None then Option::None
  end

  match callee_body
  when Option::Some(body) then
    match function_index.get(candidate.caller.clone())
    when Option::Some((caller_mod_idx, caller_fn_idx)) then
      inline_calls_in_function(&mut ctx.modules[*caller_mod_idx].mir_functions[*caller_fn_idx], &candidate.callee, &body)
    when Option::None then ()
    end
  when Option::None then ()
  end
end

def inline_calls_in_function(caller: &mut MirFunction, callee_name: &String, callee_body: &MirFunction) -> Unit
  # Replace Call terminators that target callee_name with the inlined body
  
  mut next_block_id = caller.blocks.len() as Int
  mut next_local_id = caller.locals.len() as Int
  
  for block_idx in 0..caller.blocks.len() do
    match caller.blocks[block_idx].terminator.kind
    when MirTerminatorKind::Call(dest, func_op, args, next, unwind) then
      let target = match func_op.kind
      when MirOperandKind::Constant(c) then
        match c.kind
        when MirConstantKind::FnItem(name) then Option::Some(name.clone())
        when _ then Option::None
        end
      when _ then Option::None
      end
      match target
      when Option::Some(target_name) then
      if target_name == *callee_name then
        # 1. Build local variable rename map: callee_local_id -> caller_local_id
        mut local_map: Map[Int, Int] = Map::new()
        
        # Map parameters to arguments (callee params are first N locals)
        let param_count = callee_body.params.len()
        for i in 0..param_count do
          if i < args.len() then
            # Extract local ID from argument operand
            let arg_local = extract_operand_local(&args[i])
            local_map.insert(i, arg_local)
          end
        end
        
        # Create new locals for non-parameter callee locals, add to caller
        for i in param_count..callee_body.locals.len() do
          let new_id = next_local_id
          local_map.insert(i, new_id)
          caller.locals.push(callee_body.locals[i].clone())
          next_local_id = next_local_id + 1
        end
        
        # 2. Build block rename map
        let block_base = next_block_id
        mut block_map: Map[Int, Int] = Map::new()
        for i in 0..callee_body.blocks.len() do
          block_map.insert(callee_body.blocks[i].id, block_base + i)
        end
        
        # 3. Clone and remap callee blocks
        for cb in callee_body.blocks do
          mut new_block = cb.clone()
          new_block.id = block_map.get(cb.id).unwrap_or(cb.id)
          
          # Remap locals in all statements
          for stmt_idx in 0..new_block.statements.len() do
            new_block.statements[stmt_idx] = remap_statement_locals(&new_block.statements[stmt_idx], &local_map)
          end
          
          # Remap terminator
          match new_block.terminator.kind
          when MirTerminatorKind::Return then
            # Store return value to dest, then goto continuation
            # Note: simplified - assumes return value is in local 0 or uses operand
            new_block.terminator = MirTerminator { kind: MirTerminatorKind::Goto(next), span: new_block.terminator.span }
          when MirTerminatorKind::Goto(target) then
            let new_target = block_map.get(target).unwrap_or(target)
            new_block.terminator = MirTerminator { kind: MirTerminatorKind::Goto(new_target), span: new_block.terminator.span }
          when MirTerminatorKind::SwitchInt(op, targets, default) then
            let new_op = remap_operand_locals(&op, &local_map)
            mut new_targets = Vec::new()
            for t in targets do
              new_targets.push(SwitchTarget { 
                value: t.value, 
                target: block_map.get(t.target).unwrap_or(t.target) 
              })
            end
            let new_default = block_map.get(default).unwrap_or(default)
            new_block.terminator = MirTerminator { kind: MirTerminatorKind::SwitchInt(new_op, new_targets, new_default), span: new_block.terminator.span }
          when _ then ()
          end
          
          caller.blocks.push(new_block)
        end
        
        # 4. Replace the call terminator with a goto to the inlined entry
        let inlined_entry = block_map.get(callee_body.entry_block.id).unwrap_or(block_base)
        caller.blocks[block_idx].terminator = MirTerminator { kind: MirTerminatorKind::Goto(inlined_entry), span: caller.blocks[block_idx].terminator.span }
        next_block_id = next_block_id + callee_body.blocks.len() as Int
      end
      when Option::None then ()
      end
    when _ then ()
    end
  end
end

def extract_operand_local(op: &MirOperand) -> Int
  match op.kind
  when MirOperandKind::Copy(place) then place.local.id
  when MirOperandKind::Move(place) then place.local.id
  when MirOperandKind::Constant(_) then -1
  end
end

def remap_statement_locals(stmt: &MirStatement, local_map: &Map[Int, Int]) -> MirStatement
  MirStatement {
    kind: remap_statement_kind_locals(&stmt.kind, local_map),
    span: stmt.span
  }
end

def remap_statement_kind_locals(kind: &MirStatementKind, local_map: &Map[Int, Int]) -> MirStatementKind
  match kind
  when MirStatementKind::Assign(place, rvalue) then
    MirStatementKind::Assign(remap_place_locals(&place, local_map), remap_rvalue_locals(&rvalue, local_map))
  when MirStatementKind::StorageLive(local) then
    let new_id = local_map.get(local.id).unwrap_or(local.id)
    MirStatementKind::StorageLive(LocalId { id: new_id })
  when MirStatementKind::StorageDead(local) then
    let new_id = local_map.get(local.id).unwrap_or(local.id)
    MirStatementKind::StorageDead(LocalId { id: new_id })
  when _ then kind.clone()
  end
end

def remap_place_locals(place: &Place, local_map: &Map[Int, Int]) -> Place
  let new_id = local_map.get(place.local.id).unwrap_or(place.local.id)
  Place { local: LocalId { id: new_id }, projections: place.projections.clone() }
end

def remap_operand_locals(op: &MirOperand, local_map: &Map[Int, Int]) -> MirOperand
  match op.kind
  when MirOperandKind::Copy(place) then
    MirOperand { kind: MirOperandKind::Copy(remap_place_locals(&place, local_map)) }
  when MirOperandKind::Move(place) then
    MirOperand { kind: MirOperandKind::Move(remap_place_locals(&place, local_map)) }
  when MirOperandKind::Constant(c) then
    MirOperand { kind: MirOperandKind::Constant(c.clone()) }
  end
end

def remap_rvalue_locals(rv: &MirRvalue, local_map: &Map[Int, Int]) -> MirRvalue
  match rv.kind
  when MirRvalueKind::Use(op) then
    MirRvalue { kind: MirRvalueKind::Use(remap_operand_locals(&op, local_map)) }
  when MirRvalueKind::Ref(place) then
    MirRvalue { kind: MirRvalueKind::Ref(remap_place_locals(&place, local_map)) }
  when MirRvalueKind::BinOp(op, a, b) then
    MirRvalue { kind: MirRvalueKind::BinOp(op.clone(), remap_operand_locals(&a, local_map), remap_operand_locals(&b, local_map)) }
  when MirRvalueKind::UnOp(op, operand) then
    MirRvalue { kind: MirRvalueKind::UnOp(op.clone(), remap_operand_locals(&operand, local_map)) }
  when _ then rv.clone()
  end
end
