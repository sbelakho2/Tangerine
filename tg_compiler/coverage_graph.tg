# Tangerine Compiler — Coverage graph (third-audit item 34 / audit §40)
# Self-hosting compiler written in Tangerine
#
# The §40 coverage index family — "which tests cover what" — over the §29
# semantic snapshot rows, plus the §40 uncovered-edge query: after a patch
# creates a new call/effect edge (a new MIR call terminator or a function's
# new effect row) with NO covering test, return its PATH CONSTRAINT so a
# test can be generated that drives exactly that path.
#
# AUDIT ANCHORS (the audit's index list -> the row shapes that serve them):
#   SymbolId    -> TestId[]    — snapshot.tests rows (TestRelationship:
#                   (audit order item 5) TEST StableTestId (owner
#                   declaration lineage + test-kind) -> exercised
#                   StableDeclId) PLUS every ingested CoverageRelationship
#                   row (a covered block / edge / contract / effect site
#                   covers its owning function's symbol). The symbol index
#                   below is the reverse edge: exercised-declaration
#                   identity -> test stable key texts; section 7b/7c add
#                   the typed targeted verification and the mutation
#                   kill mapping.
#   MirBlockId  -> TestId[]    — the branch index family: block_to_tests
#                   keys by the TYPED StableMirBlockId record and is
#                   filled by the ingest from coverage rows whose kind word
#                   is "Block". (fourth-audit P0-8) the id is the block's
#                   P0-7 CONTROL-ORIGIN key "<fn key>#B@<hi>-<lo>"; the
#                   tg.cov.trace.v1 ingest parses the id text ONCE at the
#                   boundary into the typed record — no text authority
#                   downstream. An ORIGIN-LESS point (a legacy locator id
#                   or a hand-built row with no typed id) enters no point
#                   map: it contributes fn-level evidence only (audit
#                   order item 1 closeout — a locator is never identity).
#   MirEdgeId   -> TestId[]    — edge_to_tests keys by the TYPED
#                   StableMirEdgeId record (the semantic "<from>|><to>|
#                   <kind>" key parsed at the ingest boundary).
#   ContractId  -> TestId[]    — contract_site_to_tests keys by the TYPED
#                   StableContractId record (parsed at the ingest /
#                   snapshot-text boundary); the legacy fn-granular
#                   contract_to_tests keeps answering for callers that
#                   hold only the owning function key.
#   EffectPath  -> TestId[]    — effect_site_to_tests keys by the TYPED
#                   StableEffectSiteId record ("<fn key>|effect@<role>#
#                   <role seq>", parsed at the boundary); the legacy
#                   fn-granular effect_to_tests keeps answering for
#                   callers holding only the subject function key.
#
# COVERAGE ID GRAMMAR (tg.cov.v1 — the stable-id key of every coverage
# point; constructors + parse helpers below):
#   block id    — the StableMirBlockId.stable_key text: the P0-7
#                 CONTROL-ORIGIN form "<fn key>#B@<hi>-<lo>" (P0-8
#                 re-key; coverage_block_key_of_block) or the locator
#                 "<fn key>#B<block ordinal>" for origin-less IR
#                 (§33 grammar; coverage_block_id_of)
#   edge id     — "<from block id>|><to block id>|<kind word>"
#                 (coverage_edge_id; the arrow "|>" is unambiguous because
#                 block keys never contain '>')
#   contract id — the StableContractId.stable_key text
#                 "<fn key>|<Pre|Post|Invariant>|<clause>"
#                 (coverage_contract_id_of_stable)
#   effect site — "<fn key>|effect@<role>#<role seq>" (the stable
#                 node/role identity of stable_ids.tg section 8;
#                 coverage_effect_site_id / coverage_effect_site_of_node)
# Every id is span-free by construction; the §62 ordinal-scheme ids of
# coverage.tg remain the CQS artifact domain — the semantic snapshot rows
# and the §40 indexes key on THIS stable-id grammar (never on dense
# ordinals re-derived at read time).
#
# THE INGEST (third-audit item 34 — the execution-side follow-up this
# module now implements): coverage_ingest / coverage_ingest_rows read the
# tg.cov.trace.v1 trace text and populate CoverageRelationship rows
# (function = the stable def id owning the point, branch_id = the point's
# tg.cov.v1 id text, arm_id = None, kind = "Block" | "Edge" | "Contract" |
# "EffectSite", test_id = the exercising test's canonical stable key text —
# "" for a point recorded outside any test bind, the model's documented
# unbound form; (audit order item 5) the runtime writes the DECLARED test
# name, so the ingest path normalizes it through the discovery table
# (coverage_trace_bind_stable) and the graph builder re-resolves any
# name-form binding through the same table — an unmatched binding stays
# its own text, never a fabricated test identity). Rows are deduped by
# (function key, branch id, kind, test id) and sorted through
# semantic_model.tg's semantic_coverage_relationships_sort (the model sort
# is the row order authority). The INGEST IS THE ONLY WRITER (the snapshot
# builder still emits an empty coverage table — coverage_graph.
# coverage_ingest is the documented entry the execution side calls with
# the trace a test run produced).
#
# TRACE FORMAT (tg.cov.trace.v1 — the runtime hook's output; line-oriented,
# fields separated by '|', '#' comments and blank lines skipped):
#   test|<test key>                   — bind the CURRENT test
#   test|<test key>|<kind>|<payload>  — inline: bind + one point row
#   block|<block id>                  — a reached block (stable block id)
#   edge|<from block id>|<to block id>[|<kind word>]
#                                     — a traversed CFG edge (the kind word
#                                       defaults to "cf" when omitted)
#   contract|<contract id>            — an evaluated contract clause (the id
#                                       is the final field: it may contain '|')
#   effect|<effect site id>           — an executed effect site
# A point row under no preceding test bind is UNBOUND (test_id "" — it
# contributes coverage evidence but no test link). Every payload is
# validated against the tg.cov.v1 grammar (stable_mir_block_of_key /
# coverage_edge_id_parse / stable_contract_of_key /
# coverage_effect_site_id_parse); an invalid or malformed row is dropped
# (fail closed — the ingest never invents a row).
#
# INSTRUMENTATION TARGET (third-audit item 34 — the runtime producer is
# IMPLEMENTED; see below for the harness command): the self-hosted test
# route (driver.tg cmd_test -> run_test_files -> compile_and_run_tests)
# compiles each suite to a LINKED NATIVE BINARY through the self-hosted
# LIR/object pipeline and runs it via bootstrap_call_argv — tg_compiler
# has NO MIR interpreter/VM (lib.tg: "differential requires a runner —
# tg_compiler has no MIR interpreter"; equivalence.tg documents the
# same). The compile-time plan lives HERE: coverage_table_of_mir_function
# assigns every MIR block (and every classified CFG edge) a dense counter
# index and renders the per-function table (coverage_table_render);
# coverage_emission_plan_of_functions (section 2b) attaches those tables
# to the program's functions at program-global bases and pre-renders the
# trace row of every slot. The runtime half:
#   driver.tg     — `tg compile --codegen=lir --coverage [--coverage-out=
#                   <path>] file.tg` builds the plan from the finalized
#                   MIR and threads it into the LIR route (any other
#                   codegen route fails closed);
#   lir.tg        — lir_emit_coverage_data_a64 emits the program-level
#                   .bss counter array + the embedded row blob +
#                   `tg.cov.table.v1` text, lir_emit_cov_bump_a64 emits
#                   the per-block/per-taken-edge bumps, and
#                   lir_emit_term's Ret arm calls the dump before the
#                   user main/_start epilogue;
#   runtime.tg    — emit_tg_cov_dump (`_tg_cov_dump`) writes
#                   tg.cov.trace.v1 at exit: header, `test|<argv[1]>`
#                   when the entry captured one, then one pre-rendered
#                   row per nonzero counter in GLOBAL INDEX order.
# The trace then feeds coverage_ingest.
#
# (audit order item 5) `tg test --coverage` IS THE CANONICAL ROUTE NOW: the
# test lane force-selects the aarch64 host LIR route, attaches the SAME
# coverage emission plan, runs each @test process (the generated dispatch
# main's argv[1] is the declared test name, which the exit-time dump binds
# as `test|<name>`), normalizes every trace through
# coverage_trace_bind_stable (the discovery table's name -> stable key
# binding) and ingests it into the run's SemanticSnapshot, which is
# finalized and written beside the harness. The older spelled-out producer
# command (`tg compile --codegen=lir --coverage prog.tg && ./prog <test
# key>` + a library coverage_ingest call) remains valid for direct
# program runs.
#
# TEST SYNTHESIS (audit order item 5 — THE LOOP IS NOW WIRED; the kernel
# boundary is unchanged): the uncovered-path results are TYPED records
# (TargetedPathConstraint) and THIS module deliberately stops there. The
# kernel closure cannot import the generator: std/test_gen.tg is a
# FULL-LIBRARY module (not in bootstrap/compiler_kernel.manifest) and the
# kernel manifest grows only for bootstrap_main's own closure. The
# full-library wiring lives OUTSIDE the kernel in
# tg_compiler/test_synthesis.tg (imported by the out-of-manifest full
# driver, tg_compiler/driver.tg — its imports load from the repo through
# the canonical recursive loader): it promotes test_targeted_for_delta's
# "uncovered-path" requests into typed SynthesisRequests with a
# deterministic identity/name (the 128-bit stable digest of the
# length-prefixed constraint identity), calls the pub generator
# (std::test_gen.generate_test_suite) and renders CONCRETE @test sources;
# a request the generator cannot serve is rendered as a typed request —
# never a fabricated test. The kernel never calls into that module and
# never imports it (the boundary this note documents).
#
# THE UNCOVERED-EDGE QUERY (uncovered_paths): operates on the §31
# SemanticDelta's call_delta / effect_delta lists. Call rows keep the
# delta core's kind vocabulary (DeltaKind::Created = a call row absent
# from the a-side snapshot — the key-membership diff). Effect rows carry
# the TYPED before/after EffectSummaryView values (audit items 14/15): the
# filter is a GAINED effect surface — a row whose before view is empty and
# whose after view carries §11 classes/capabilities (the typed successor
# of the Created classification; row lifecycle never participates, and a
# row whose summary gained classes on an already-rowed function counts as
# a gain). For each such edge whose row is BACKED by the current
# snapshot's own call/effect tables (guards against deltas built from a
# different snapshot pair), a constraint line is emitted iff no test in
# the graph covers the edge:
#   call rows   — covered iff tests_covering_symbol(graph, from) non-empty
#                 (from = the CALLER function key — the function whose MIR
#                 body gained the new call terminator; a generated test
#                 must drive the caller to reach the edge). Ingested
#                 block/edge coverage rows add the caller to the symbol
#                 index, so a traced run suppresses the line; an empty
#                 coverage table keeps the old fail-closed behavior.
#   effect rows — covered iff tests_covering_symbol(graph, function)
#                 non-empty OR tests_covering_effect(graph, function)
#                 non-empty (function = the effect's subject function key;
#                 ingested EffectSite rows feed BOTH lookups — the exact
#                 site index and the fn-granular reverse edge).
# The emitted line format (sorted, deduped, deterministic):
#   "uncovered:<edge kind>:<src>-><dst>:no covering test: constraint <fn-key>#B?<edge-key>"
# with <edge kind> = "call" | "effect", <src> = the source symbol key
# (caller / effect subject), <dst> = the callee key / the effect §11 class
# payload text, and the CONSTRAINT = the source symbol key + "#B?" + the
# edge key itself (the delta row key: "caller|callee|kind-numeric" for
# call rows; the function key for effect rows). The "#B?" fragment is the
# audit's "<fn-key>#B<..>" anchor with the block ordinal UNKNOWN: the
# snapshot/delta row domains carry no block/terminator ordinals (they live
# in the §33 MirProgram slice domain), so a generator resolves the block
# containing the new edge against the b-side MIR — the constraint pins the
# function and the exact row key meanwhile.
#
# DETERMINISM: builds are order-insensitive (Map insertion, row dedupe);
# every accessor returns its rows SORTED; uncovered_paths returns its
# lines sorted and deduped; coverage_test_coverage sorts by test id and
# every point list. Map reads use the kernel get-by-value/clone idiom of
# the sibling modules; no Map mutation happens while a raw entries()
# snapshot is live.

use std::collections::{Vec, Map, Set}

use tg_compiler::ids::{StableDefId, stable_def_id_digested}
use tg_compiler::mir::{
  MirFunction, MirBlock, MirBlockId, MirLocal, MirLocalId, MirTerminator, MirTerminatorKind,
  MirConstant, MirConstantKind, SwitchTarget, operand_constant
}
use tg_compiler::token::{span_dummy}
use tg_compiler::types::{Type}
use tg_compiler::stable_ids::{
  StableDeclId, StableMirBlockId, StableContractId, StableSemanticNodeId, StableRowKey,
  StableMirNodeId, StableMirEdgeId, StableEffectSiteId, StableTestId,
  UntrackedArtifact, untracked_artifact, untracked_artifact_text,
  stable_decl_of_key, stable_decl_eq,
  stable_row_key_of, stable_row_key_or_text, stable_row_key_digest_eq,
  stable_mir_block_of_key, stable_contract_of_key,
  stable_mir_semantic_edge_of_key, stable_mir_cov_edge_of_key,
  stable_hir_node_id_of, stable_mir_node_id_of_source,
  stable_mir_block_id_of_node, stable_mir_block_id_of_control_generated,
  stable_mir_node_id_of_generated,
  stable_mir_block_key_is_semantic,
  stable_effect_site_key, stable_effect_site_of_key,
  stable_test_eq, stable_test_name_of, stable_test_id_from_row
}
use tg_compiler::semantic_model::{
  SemanticSnapshot, CallEdge, CallEdgeKind, CoverageRelationship, StableTargetId,
  TestRelationship,
  semantic_call_edge_kind_numeric, semantic_digest_zero,
  semantic_coverage_relationships_sort, semantic_strings_sort
}
use tg_compiler::semantic_delta::{
  SemanticDelta, DeltaKind, EdgeDelta, EffectDelta, AbiDeltaView, AbiSurfaceView,
  semantic_delta_effect_view_text
}

# ———————————————————————————————————————————————————————————————
# 1. The tg.cov.v1 coverage ids — constructors + parse helpers
# ———————————————————————————————————————————————————————————————

# A parsed tg.cov.v1 EDGE id: from/to are block id texts, kind is the edge
# kind word ("goto" | "switch" | "switch-default" | "call-success" |
# "call-unwind" | "deinit-success" | "deinit-unwind" | "assert-success" |
# "assert-unwind" | "cf" — the trace default).
pub struct CoverageEdgeId
  from: String
  to: String
  kind: String
end

# A parsed tg.cov.v1 EFFECT SITE id: the owning function key, the stable
# role word and the role ordinal (stable_ids.tg section 8's role identity).
pub struct CoverageEffectSiteId
  function_key: String
  role: String
  role_seq: Int
end

# The block id text of a §33 block key: "<fn key>#B<block ordinal>".
pub def coverage_block_id_of(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string()
end

# The block id text of an existing StableMirBlockId record (its stable_key
# IS the tg.cov.v1 block id).
pub def coverage_block_id_of_stable(block: StableMirBlockId) -> String
  block.stable_key.clone()
end

# (fourth-audit P0-8 / audit order item 1 closeout) The SEMANTIC id of a
# MIR block: its P0-7 control-origin stable key. Option::None for an
# origin-less hand-built block — the persistent builders report the
# artifact untracked and NEVER substitute the "#B<ordinal>" locator.
pub def coverage_block_key_of_block(fn_key: String, block: MirBlock) -> Option[String]
  match block.origin
  when Option::Some(bid) then Option::Some(bid.stable_key.clone())
  when Option::None then Option::None
  end
end

# The semantic key of a successor block id resolved in the function's
# block list. Option::None for a successor that is absent or carries no
# origin (the caller fails closed with the untracked result).
pub def coverage_semantic_successor_key(fn_key: String, blocks: Vec[MirBlock], block_id: Int) -> Option[String]
  for b in blocks do
    if b.id.id == block_id then
      return coverage_block_key_of_block(fn_key.clone(), b)
    end
  end
  Option::None
end

# The owning function key of a block id text ("" when no "#B" marker).
pub def coverage_block_id_owner(text: String) -> String
  match text.rfind("#B")
  when Option::Some(i) then text.slice(0, i)
  when Option::None then "".to_string()
  end
end

# The block ordinal of a block id text (-1 when the text is not a valid
# §33 block key).
pub def coverage_block_id_ordinal(text: String) -> Int
  match stable_mir_block_of_key(text.clone())
  when Option::Some(block) then block.dense_id
  when Option::None then -1
  end
end

# The canonical tg.cov.v1 edge id text.
pub def coverage_edge_id(from_block: String, to_block: String, kind: String) -> String
  from_block + "|>" + to_block + "|" + kind
end

def coverage_is_block_id(text: String) -> Bool
  match stable_mir_block_of_key(text.clone())
  when Option::Some(_) then true
  when Option::None then false
  end
end

# Every '|' byte position of a text (the split-candidate scan).
def coverage_bar_positions(s: String) -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  var i = 0
  while i < s.len() do
    if s.slice(i, i + 1) == "|" then
      out.push(i)
    end
    i = i + 1
  end
  out
end

# Split a text into two block ids at the UNIQUE '|' position whose both
# sides are valid §33 block keys, scanning left to right (a block key's own
# function-key prefix may itself contain '|', but a split inside it never
# leaves a valid block key on the right). None when no such split exists.
def coverage_edge_split_blocks(text: String) -> Option[(String, String)]
  for i in coverage_bar_positions(text.clone()) do
    let left = text.slice(0, i)
    let right = text.slice(i + 1, text.len())
    if coverage_is_block_id(left.clone()) && coverage_is_block_id(right.clone()) then
      return Option::Some((left, right))
    end
  end
  Option::None
end

# Parse the CANONICAL edge id text "<from>|><to>|<kind>" (kind defaults to
# "cf" when the final field is omitted). The from side never contains '|>'
# (block keys carry no '>'), so the first arrow occurrence splits.
pub def coverage_edge_id_parse(text: String) -> Option[CoverageEdgeId]
  match text.find("|>")
  when Option::Some(arrow) then
    let from = text.slice(0, arrow)
    let rest = text.slice(arrow + 2, text.len())
    if !coverage_is_block_id(from.clone()) then
      return Option::None
    end
    match rest.rfind("|")
    when Option::Some(j) then
      let to = rest.slice(0, j)
      let kind = rest.slice(j + 1, rest.len())
      if !coverage_is_block_id(to.clone()) || kind.len() == 0 then
        return Option::None
      end
      Option::Some(CoverageEdgeId { from: from, to: to, kind: kind })
    when Option::None then
      if !coverage_is_block_id(rest.clone()) then
        return Option::None
      end
      Option::Some(CoverageEdgeId { from: from, to: rest, kind: "cf".to_string() })
    end
  when Option::None then Option::None
  end
end

# Parse the TRACE edge payload "<from>|<to>[|<kind>]" — the two-field form
# first (a split where BOTH sides are block keys), then the kind-word form
# (the last '|' field is the kind word, the head must split into blocks).
def coverage_edge_payload_parse(payload: String) -> Option[CoverageEdgeId]
  match coverage_edge_split_blocks(payload.clone())
  when Option::Some(pair) then
    Option::Some(CoverageEdgeId {
      from: pair.0,
      to: pair.1,
      kind: "cf".to_string()
    })
  when Option::None then
    match payload.rfind("|")
    when Option::Some(j) then
      let head = payload.slice(0, j)
      let kind = payload.slice(j + 1, payload.len())
      if kind.len() == 0 then
        return Option::None
      end
      match coverage_edge_split_blocks(head)
      when Option::Some(pair2) then
        Option::Some(CoverageEdgeId { from: pair2.0, to: pair2.1, kind: kind })
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  end
end

# The contract id text of an existing StableContractId record.
pub def coverage_contract_id_of_stable(contract: StableContractId) -> String
  contract.stable_key.clone()
end

# The owning function key of a contract id text (before the first '|'; ""
# when the text carries no '|').
pub def coverage_contract_id_owner(text: String) -> String
  match text.find("|")
  when Option::Some(i) then text.slice(0, i)
  when Option::None then "".to_string()
  end
end

# The tg.cov.v1 effect-site id text of (function key, stable role, role
# ordinal) — the stable_ids.tg canonical grammar (ONE authority; the
# coverage layer never re-implements it).
pub def coverage_effect_site_id(fn_key: String, role: String, role_seq: Int) -> String
  stable_effect_site_key(fn_key, role, role_seq)
end

# The effect-site id text of a StableSemanticNodeId (its stable node/role
# identity — section 8's role key pieces).
pub def coverage_effect_site_of_node(node: StableSemanticNodeId) -> String
  coverage_effect_site_id(node.function_key.clone(), node.role.clone(), node.role_seq)
end

# Parse a tg.cov.v1 effect-site id text into the legacy advisory view
# (function key, role, ordinal). The typed record is
# stable_effect_site_of_key; the coverage maps key on THAT record.
pub def coverage_effect_site_id_parse(text: String) -> Option[CoverageEffectSiteId]
  match stable_effect_site_of_key(text)
  when Option::Some(site) then
    Option::Some(CoverageEffectSiteId {
      function_key: site.function_key,
      role: site.role,
      role_seq: site.role_seq
    })
  when Option::None then Option::None
  end
end

# The owning function key of an effect-site id text ("" when the text is
# not a tg.cov.v1 effect-site id).
pub def coverage_effect_site_owner(text: String) -> String
  match coverage_effect_site_id_parse(text.clone())
  when Option::Some(site) then site.function_key
  when Option::None then "".to_string()
  end
end

# The point-family word of a tg.cov.v1 id text ("block" | "edge" |
# "contract" | "effect"; "" for an id outside the grammar). The families
# are disjoint by construction (block ids carry no '|').
pub def coverage_point_kind(id: String) -> String
  if coverage_is_block_id(id.clone()) then
    "block"
  elsif id.find("|>") != Option::None then
    match coverage_edge_id_parse(id.clone())
    when Option::Some(_) then "edge"
    when Option::None then ""
    end
  elsif id.find("|effect@") != Option::None then
    match coverage_effect_site_id_parse(id.clone())
    when Option::Some(_) then "effect"
    when Option::None then ""
    end
  elsif id.find("|") != Option::None then
    match stable_contract_of_key(id.clone())
    when Option::Some(_) then "contract"
    when Option::None then ""
    end
  else
    ""
  end
end

# ———————————————————————————————————————————————————————————————
# 2. The compile-time coverage table (the instrumentation plan)
# ———————————————————————————————————————————————————————————————
# One entry per counter slot: the dense counter index, the tg.cov.v1 point
# family and the point's stable id text. The table is per FUNCTION; the
# native runtime hook (see lir.tg's lir_emit_fn emission-site note) reserves
# one 8-byte counter per entry in a .bss array, bumps index i at the point's
# entry and dumps the counts at exit; coverage_table_render is the mapping
# the trace writer needs (index -> stable id). Builder indices follow the
# MirFunction.blocks VEC ORDER (the same order lower_mir_fn_to_lir
# preserves into LirFunction.blocks and the LIR emitter walks), so block
# counter indices are stable across the lowering; LIR-synthesized blocks
# (pointer/atomic dispatch arms, the assert trap block) carry no MIR
# counterpart and get NO counter.

pub struct CoverageTableEntry
  index: Int
  point_kind: String
  stable_id: String
end

pub struct CoverageTable
  function_key: String
  block_counters: Map[String, Int] = Map::new()
  edge_counters: Map[String, Int] = Map::new()
  entries: Vec[CoverageTableEntry] = Vec::new()
end

# The coverage-table clone: every counter table and entry row duplicates
# through the registered container/row Clones (the row carries owned id
# texts). Registered because CoverageFnPlan.table is a component of the
# lane-check clones.
impl Clone for CoverageTableEntry
  def clone(self: Self) -> CoverageTableEntry
    CoverageTableEntry {
      index: self.index,
      point_kind: self.point_kind.clone(),
      stable_id: self.stable_id.clone()
    }
  end
end

impl Clone for CoverageTable
  def clone(self: Self) -> CoverageTable
    CoverageTable {
      function_key: self.function_key.clone(),
      block_counters: self.block_counters.clone(),
      edge_counters: self.edge_counters.clone(),
      entries: self.entries.clone()
    }
  end
end

# The classified CFG edges of one block terminator, in a fixed emission
# order (the successor order of mir.tg's terminator_successor_ids, with the
# unwind successor last where one exists). Only edges that actually
# transfer control are listed; MirReturn / MirAbort / MirUnreachable carry
# none.
pub def coverage_terminator_edges(fn_key: String, block_id: Int, term: MirTerminator) -> Vec[CoverageEdgeId]
  var out: Vec[CoverageEdgeId] = Vec::new()
  let from_key = coverage_block_id_of(fn_key.clone(), block_id)
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    out.push(CoverageEdgeId {
      from: from_key.clone(),
      to: coverage_block_id_of(fn_key.clone(), target.id),
      kind: "goto".to_string()
    })
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    for t in targets do
      out.push(CoverageEdgeId {
        from: from_key.clone(),
        to: coverage_block_id_of(fn_key.clone(), t.target.id),
        kind: "switch".to_string()
      })
    end
    out.push(CoverageEdgeId {
      from: from_key.clone(),
      to: coverage_block_id_of(fn_key.clone(), default_target.id),
      kind: "switch-default".to_string()
    })
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    out.push(CoverageEdgeId {
      from: from_key.clone(),
      to: coverage_block_id_of(fn_key.clone(), success.id),
      kind: "call-success".to_string()
    })
    match unwind
    when Option::Some(uw) then
      out.push(CoverageEdgeId {
        from: from_key.clone(),
        to: coverage_block_id_of(fn_key.clone(), uw.id),
        kind: "call-unwind".to_string()
      })
    when Option::None then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    out.push(CoverageEdgeId {
      from: from_key.clone(),
      to: coverage_block_id_of(fn_key.clone(), target.id),
      kind: "deinit-success".to_string()
    })
    match unwind
    when Option::Some(uw) then
      out.push(CoverageEdgeId {
        from: from_key.clone(),
        to: coverage_block_id_of(fn_key.clone(), uw.id),
        kind: "deinit-unwind".to_string()
      })
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    out.push(CoverageEdgeId {
      from: from_key.clone(),
      to: coverage_block_id_of(fn_key.clone(), target.id),
      kind: "assert-success".to_string()
    })
    match unwind
    when Option::Some(uw) then
      out.push(CoverageEdgeId {
        from: from_key.clone(),
        to: coverage_block_id_of(fn_key.clone(), uw.id),
        kind: "assert-unwind".to_string()
      })
    when Option::None then ()
    end
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirAbort then ()
  when MirTerminatorKind::MirUnreachable then ()
  end
  out
end

# The one semantic edge of (from block, successor block id): the canonical
# CoverageEdgeId under the blocks' P0-7 control-origin keys; the
# documented UntrackedArtifact result when the successor is absent or
# origin-less (audit order item 1 closeout — never a locator).
def coverage_semantic_edge_of(
  from_key: String,
  fn_key: String,
  blocks: Vec[MirBlock],
  to_id: Int,
  kind: String
) -> Result[CoverageEdgeId, UntrackedArtifact]
  match coverage_semantic_successor_key(fn_key.clone(), blocks, to_id)
  when Option::Some(to_key) then
    Result::Ok(CoverageEdgeId { from: from_key, to: to_key, kind: kind })
  when Option::None then
    Result::Err(untracked_artifact("coverage-edges".to_string(),
      "function '" + fn_key + "' successor block bb" + to_id.to_string() + " carries no persistent control-origin"))
  end
end

# (fourth-audit P0-8 / audit order item 1 closeout) The classified CFG
# edges of one block under the SEMANTIC block ids: the from/to sides are
# the blocks' P0-7 control-origin stable keys, so coverage trace/table ids
# and PGO edge ids share ONE identity. An origin-less block or successor
# returns the documented UntrackedArtifact result — the locator fallback is
# GONE.
pub def coverage_terminator_edges_semantic(fn_key: String, block: MirBlock, blocks: Vec[MirBlock]) -> Result[Vec[CoverageEdgeId], UntrackedArtifact]
  var out: Vec[CoverageEdgeId] = Vec::new()
  let from_key = match coverage_block_key_of_block(fn_key.clone(), block.clone())
  when Option::Some(k) then k
  when Option::None then
    return Result::Err(untracked_artifact("coverage-edges".to_string(),
      "function '" + fn_key.clone() + "' block bb" + block.id.id.to_string() + " carries no persistent control-origin"))
  end
  let term = block.terminator.clone()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), target.id, "goto".to_string())?)
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    for t in targets do
      out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), t.target.id, "switch".to_string())?)
    end
    out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), default_target.id, "switch-default".to_string())?)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), success.id, "call-success".to_string())?)
    match unwind
    when Option::Some(uw) then
      out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), uw.id, "call-unwind".to_string())?)
    when Option::None then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), target.id, "deinit-success".to_string())?)
    match unwind
    when Option::Some(uw) then
      out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), uw.id, "deinit-unwind".to_string())?)
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), target.id, "assert-success".to_string())?)
    match unwind
    when Option::Some(uw) then
      out.push(coverage_semantic_edge_of(from_key.clone(), fn_key.clone(), blocks.clone(), uw.id, "assert-unwind".to_string())?)
    when Option::None then ()
    end
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirAbort then ()
  when MirTerminatorKind::MirUnreachable then ()
  end
  Result::Ok(out)
end

def coverage_table_push(
  inout table: CoverageTable,
  inout next_index: Int,
  kind: String,
  stable_id: String
) -> Unit
  table.entries.push(CoverageTableEntry {
    index: next_index,
    point_kind: kind.clone(),
    stable_id: stable_id.clone()
  })
  if kind == "block" then
    table.block_counters.insert(stable_id, next_index)
  else
    table.edge_counters.insert(stable_id, next_index)
  end
  next_index = next_index + 1
  ()
end

# (audit order item 1 closeout) The persistent coverage-table builder:
# every block/edge slot keys on the nodes' P0-7 control-origin stable keys
# (never the dense ordinal). Origin-less input returns the documented
# UntrackedArtifact result.
pub def coverage_table_of_mir_function(fn_key: String, f: MirFunction) -> Result[CoverageTable, UntrackedArtifact]
  var table = CoverageTable { function_key: fn_key.clone() }
  var next_index = 0
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    # (fourth-audit P0-8) the block id is the block's SEMANTIC control
    # origin (coverage_block_key_of_block), never the locator ordinal.
    let bkey = match coverage_block_key_of_block(fn_key.clone(), b.clone())
    when Option::Some(k) then k
    when Option::None then
      return Result::Err(untracked_artifact("coverage-table".to_string(),
        "function '" + fn_key.clone() + "' block bb" + b.id.id.to_string() + " carries no persistent control-origin — no coverage slot is ever keyed by a locator"))
    end
    if !table.block_counters.contains_key(bkey.clone()) then
      coverage_table_push(&mut table, &mut next_index, "block".to_string(), bkey.clone())
    end
    let edges = match coverage_terminator_edges_semantic(fn_key.clone(), b.clone(), f.blocks.clone())
    when Result::Ok(es) then es
    when Result::Err(u) then return Result::Err(u)
    end
    for e in edges do
      let ekey = coverage_edge_id(e.from.clone(), e.to.clone(), e.kind.clone())
      if !table.edge_counters.contains_key(ekey.clone()) then
        coverage_table_push(&mut table, &mut next_index, "edge".to_string(), ekey.clone())
      end
    end
    bi = bi + 1
  end
  Result::Ok(table)
end

# The counter index of a block id (counter index; -1 when the block carries
# no slot — e.g. a LIR-synthesized block absent from the table).
pub def coverage_table_block_counter(table: CoverageTable, block_id: String) -> Int
  match table.block_counters.get(block_id.clone())
  when Option::Some(i) then i
  when Option::None then -1
  end
end

# The counter index of an edge id text; -1 when absent.
pub def coverage_table_edge_counter(table: CoverageTable, edge_id: String) -> Int
  match table.edge_counters.get(edge_id.clone())
  when Option::Some(i) then i
  when Option::None then -1
  end
end

# The BYTE offset of a point's counter in the per-function .bss array (8
# bytes per slot; -1 when the point carries no slot). The emission-site note
# in lir.tg uses this as the immediate of the bump's add.
pub def coverage_table_counter_offset(table: CoverageTable, stable_id: String) -> Int
  var index = -1
  match table.block_counters.get(stable_id.clone())
  when Option::Some(i) then index = i
  when Option::None then ()
  end
  if index < 0 then
    match table.edge_counters.get(stable_id.clone())
    when Option::Some(i2) then index = i2
    when Option::None then ()
    end
  end
  if index < 0 then
    -1
  else
    index * 8
  end
end

# The number of counter slots of a table.
pub def coverage_table_counter_count(table: CoverageTable) -> Int
  table.entries.len()
end

# The compile-time table artifact (tg.cov.table.v1): one header line
# ("coverage-table|tg.cov.v1|<function key>") then one
# "entry|<index>|<kind>|<stable id>" line per slot, in index order.
def coverage_table_entry_line(e: CoverageTableEntry) -> String
  "entry|" + e.index.to_string() + "|" + e.point_kind.clone() + "|" + e.stable_id.clone()
end

pub def coverage_table_render(table: CoverageTable) -> String
  var lines: Vec[String] = Vec::new()
  lines.push("coverage-table|tg.cov.v1|" + table.function_key.clone())
  for e in table.entries do
    lines.push(coverage_table_entry_line(e))
  end
  lines.join("\n")
end

# ———————————————————————————————————————————————————————————————
# 2b. The runtime emission half (third-audit item 34 — the producer)
# ———————————————————————————————————————————————————————————————
# The compile-time plan the LIR route consumes: one CoverageFnPlan per
# non-extern MirFunction (its table + the function's first GLOBAL counter
# index), the pre-rendered trace row of every global slot (index order),
# the concatenated tg.cov.table.v1 render and the dump path. The runtime
# data emitter turns `rows` into the embedded fixed-record blob the dump
# reads (one 16-byte record per slot: {u64 offset from blob base, u64
# length}, then the row texts) and `table_text` into the `tg.cov.table`
# rodata artifact; the dump writer is the runtime helper
# (_tg_cov_dump, runtime.tg) called on the main exit path.
pub struct CoverageFnPlan
  fn_name: String   # the MIR/LIR emission name (the plan's lookup key)
  fn_key: String    # the stable fn key the tg.cov.v1 ids use (the name)
  base: Int         # first GLOBAL counter index of this function's slots
  table: CoverageTable
  # (fourth-audit P0-8) dense MIR block id -> SEMANTIC block key: the LIR
  # route's block/edge counter bumps resolve through this map so a bump
  # keys the block's control-origin identity, never its ordinal.
  block_keys: Map[Int, String] = Map::new()
end

pub struct CoverageEmissionPlan
  enabled: Bool = false
  out_path: String = ""
  functions: Vec[CoverageFnPlan] = Vec::new()
  rows: Vec[String] = Vec::new()
  table_text: String = ""
  total: Int = 0
end

# The disabled plan (a compile without --coverage): no counters, no data.
pub def coverage_emission_plan_disabled() -> CoverageEmissionPlan
  CoverageEmissionPlan {}
end

# The function's plan record (None when the plan does not carry it — the
# disabled plan carries no functions).
pub def coverage_plan_fn_of(plan: CoverageEmissionPlan, fn_name: String) -> Option[CoverageFnPlan]
  for f in plan.functions do
    if f.fn_name == fn_name then
      return Option::Some(f.clone())
    end
  end
  Option::None
end

# Build the whole-program emission plan: functions in PROGRAM ORDER, each
# non-extern function's table attached at the running global base. The
# rows vector is the concatenation of every table entry's rendered trace
# row, so a global counter index IS an index into rows. (audit order item
# 1 closeout) Origin-less input returns the documented UntrackedArtifact
# result — the driver fails the --coverage compile instead of emitting
# locator-keyed counters.
pub def coverage_emission_plan_of_functions(functions: Vec[MirFunction], out_path: String) -> Result[CoverageEmissionPlan, UntrackedArtifact]
  var plan = CoverageEmissionPlan { enabled: true, out_path: out_path }
  var base = 0
  var table_texts: Vec[String] = Vec::new()
  for f in functions do
    if !f.is_extern then
      let table = match coverage_table_of_mir_function(f.name.clone(), f.clone())
      when Result::Ok(t) then t
      when Result::Err(u) then return Result::Err(u)
      end
      var block_keys: Map[Int, String] = Map::new()
      for b in f.blocks do
        match coverage_block_key_of_block(f.name.clone(), b.clone())
        when Option::Some(k) then block_keys.insert(b.id.id, k)
        when Option::None then
          return Result::Err(untracked_artifact("coverage-plan".to_string(),
            "function '" + f.name.clone() + "' block bb" + b.id.id.to_string() + " carries no persistent control-origin — the LIR route never carries a locator-keyed block"))
        end
      end
      plan.functions.push(CoverageFnPlan {
        fn_name: f.name.clone(),
        fn_key: f.name.clone(),
        base: base,
        table: table.clone(),
        block_keys: block_keys
      })
      for e in table.entries do
        plan.rows.push(coverage_trace_row_text(e.point_kind.clone(), e.stable_id.clone()))
      end
      table_texts.push(coverage_table_render(table.clone()))
      base = base + table.entries.len()
    end
  end
  plan.total = base
  plan.table_text = table_texts.join("\n")
  Result::Ok(plan)
end

# The trace row text of one table entry — the exact line the runtime dump
# writes for a nonzero counter:
#   block|<block id>
#   edge|<from block id>|<to block id>|<kind word>   (the canonical
#       "<from>|><to>|<kind>" id re-rendered in the trace grammar; the
#       "|>" arrow is normalized to the trace's '|' separator)
#   contract|<contract id>
#   effect|<effect site id>
# An edge id outside the canonical grammar yields "" (the runtime data
# emitter stores no row for it — never a fabricated line).
pub def coverage_trace_row_text(kind: String, stable_id: String) -> String
  if kind == "edge" then
    match coverage_edge_id_parse(stable_id.clone())
    when Option::Some(e) then
      "edge|" + e.from.clone() + "|" + e.to.clone() + "|" + e.kind.clone()
    when Option::None then "".to_string()
    end
  elsif kind == "contract" then
    "contract|" + stable_id.clone()
  elsif kind == "effect" then
    "effect|" + stable_id.clone()
  else
    "block|" + stable_id.clone()
  end
end

# Render the tg.cov.trace.v1 text the runtime dump writes for a table and
# an array of per-slot counts: the header, the optional test bind
# (`test|<test key>` when non-empty), then one row per slot whose count is
# > 0, in INDEX order (deterministic; the runtime blob stores the rows in
# the same order). This is the dump contract's pure renderer — the lane
# verifies it over a synthetic count array, and the runtime dump's data
# blob is built from the same coverage_trace_row_text lines.
pub def coverage_trace_render(table: CoverageTable, counts: Vec[Int], test_key: String) -> String
  var lines: Vec[String] = Vec::new()
  lines.push("tg.cov.trace.v1")
  if test_key.len() > 0 then
    lines.push("test|" + test_key.clone())
  end
  var i = 0
  while i < table.entries.len() do
    let e = table.entries[i]
    var value = 0
    if i < counts.len() then
      value = counts[i]
    end
    if value > 0 then
      let row = coverage_trace_row_text(e.point_kind.clone(), e.stable_id.clone())
      if row.len() > 0 then
        lines.push(row)
      end
    end
    i = i + 1
  end
  lines.join("\n") + "\n"
end

# ———————————————————————————————————————————————————————————————
# 3. CoverageGraph — the §40 test-coverage index of one snapshot
# ———————————————————————————————————————————————————————————————
# One graph is built from ONE SemanticSnapshot (coverage_graph_of_snapshot)
# and is immutable in practice: accessors only read. The fn-level maps key
# on the exercised FUNCTION's typed declaration identity (StableDeclId) and
# hold the test-function stable keys exercising that function. The point
# maps key on the tg.cov.v1 id TEXTS (stable_ids has no Eq/Hash record for
# a block/edge point — the id text IS the canonical identity there, exactly
# as the §33 slice layer keys its block maps). coverage_rows counts every
# ingested CoverageRelationship row the builder saw (including unbound
# test_id "" rows): it is the op layer's "coverage evidence exists" gate.
struct CoverageGraph
  # exercised function decl -> test-function stable keys (the audit's
  # SymbolId -> TestId[] reverse index).
  symbol_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  # exercised function decl -> test-function stable keys (the audit's
  # ContractId -> TestId[] index at fn granularity; exact contract ids ride
  # contract_site_to_tests).
  contract_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  # exercised function decl -> test-function stable keys (the audit's
  # EffectPath -> TestId[] index at fn granularity; exact sites ride
  # effect_site_to_tests).
  effect_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  # TYPED point maps (audit order item 1 closeout): the keys are the
  # stable_ids records parsed ONCE at the ingest / snapshot-text boundary;
  # the branch_id text is the row RENDER, never the map identity.
  # block -> test keys (the MirBlockId -> TestId[] index).
  block_to_tests: Map[StableMirBlockId, Vec[String]] = Map::new()
  # edge -> test keys (the MirEdgeId -> TestId[] index).
  edge_to_tests: Map[StableMirEdgeId, Vec[String]] = Map::new()
  # exact contract id -> test keys (the ContractId -> TestId[] index).
  contract_site_to_tests: Map[StableContractId, Vec[String]] = Map::new()
  # exact effect-site id -> test keys (the EffectPath -> TestId[] index).
  effect_site_to_tests: Map[StableEffectSiteId, Vec[String]] = Map::new()
  # exercised function decl -> the covered point ids of that function (the
  # coverage.affected answer source).
  function_points: Map[StableDeclId, Vec[String]] = Map::new()
  # (audit order item 5) The DISCOVERY table's runtime-name binding: the
  # declared test NAME (the trace's `test|<name>` binding) -> the test's
  # canonical stable key text. Built from the snapshot's TestRelationship
  # rows (tr.test.test_name -> tr.test.stable_key), it is the ONLY
  # name-to-identity authority the ingest consults — a trace binding with
  # no discovery row stays its own text (never fabricated).
  test_key_of_name: Map[String, String] = Map::new()
  # (audit order item 5) The discovered test identities themselves, in the
  # snapshot's sorted row order (the typed endpoint table the targeted
  # verification and the mutation mapping answer from).
  test_ids: Vec[StableTestId] = Vec::new()
  # (audit order item 1 closeout) the count of point-family rows the
  # builder saw WITHOUT a typed point id (a legacy artifact carrying only
  # its branch_id text). Such a row contributes its fn-level link and its
  # function_points text, but NO point index entry — the graph never
  # re-parses the text (no locator identity).
  untracked_point_rows: Int = 0
  # ingested CoverageRelationship rows the builder saw (availability gate).
  coverage_rows: Int = 0
end

# ———————————————————————————————————————————————————————————————
# Map-row helpers (the sibling index_map_push / index_map_rows idiom)
# ———————————————————————————————————————————————————————————————
# Append one value under one typed exercised-function decl, deduped.
def coverage_map_push(inout m: Map[StableDeclId, Vec[String]], key: StableDeclId, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

# The sorted values of an exercised-function decl ([] when absent).
def coverage_map_rows(m: Map[StableDeclId, Vec[String]], key: StableDeclId) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  semantic_strings_sort(&mut out)
  out
end

# ———— The TYPED point-map helpers (audit order item 1 closeout) ————
# One push/rows pair per typed coverage-key record. The keys are Eq/Hash
# over their digest words (stable_ids.tg), so a lookup never compares key
# TEXT.

def coverage_block_map_push(inout m: Map[StableMirBlockId, Vec[String]], key: StableMirBlockId, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

def coverage_block_map_rows(m: Map[StableMirBlockId, Vec[String]], key: StableMirBlockId) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  semantic_strings_sort(&mut out)
  out
end

def coverage_edge_map_push(inout m: Map[StableMirEdgeId, Vec[String]], key: StableMirEdgeId, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

def coverage_edge_map_rows(m: Map[StableMirEdgeId, Vec[String]], key: StableMirEdgeId) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  semantic_strings_sort(&mut out)
  out
end

def coverage_contract_map_push(inout m: Map[StableContractId, Vec[String]], key: StableContractId, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

def coverage_contract_map_rows(m: Map[StableContractId, Vec[String]], key: StableContractId) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  semantic_strings_sort(&mut out)
  out
end

def coverage_effect_site_map_push(inout m: Map[StableEffectSiteId, Vec[String]], key: StableEffectSiteId, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

def coverage_effect_site_map_rows(m: Map[StableEffectSiteId, Vec[String]], key: StableEffectSiteId) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  semantic_strings_sort(&mut out)
  out
end

# The function-owner stable def id of a tg.cov.v1 point ("" owner -> a
# zero-key record the caller rejects; the ingest validates first).
def coverage_point_owner(kind: String, point_id: String) -> String
  if kind == "block" then
    coverage_block_id_owner(point_id.clone())
  elsif kind == "edge" then
    match coverage_edge_id_parse(point_id.clone())
    when Option::Some(e) then coverage_block_id_owner(e.from.clone())
    when Option::None then "".to_string()
    end
  elsif kind == "contract" then
    coverage_contract_id_owner(point_id.clone())
  elsif kind == "effect" then
    coverage_effect_site_owner(point_id.clone())
  else
    "".to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# 4. The builder — one coverage graph per snapshot
# ———————————————————————————————————————————————————————————————

pub def coverage_graph_of_snapshot(snapshot: SemanticSnapshot) -> CoverageGraph
  var symbol_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  var contract_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  var effect_to_tests: Map[StableDeclId, Vec[String]] = Map::new()
  var block_to_tests: Map[StableMirBlockId, Vec[String]] = Map::new()
  var edge_to_tests: Map[StableMirEdgeId, Vec[String]] = Map::new()
  var contract_site_to_tests: Map[StableContractId, Vec[String]] = Map::new()
  var effect_site_to_tests: Map[StableEffectSiteId, Vec[String]] = Map::new()
  var function_points: Map[StableDeclId, Vec[String]] = Map::new()
  var test_key_of_name: Map[String, String] = Map::new()
  var test_ids: Vec[StableTestId] = Vec::new()
  var untracked_point_rows = 0
  var coverage_rows = 0

  # The §29 TestRelationship rows (audit order item 5 re-keys): test
  # (StableTestId) -> exercised declaration (StableDeclId) — both endpoints
  # are TYPED identity records now, so the fn-level families key directly
  # on the row's target record (never a text parse). Each row exercises the
  # WHOLE target function, so its typed declaration identity is indexed in
  # all three fn-level families at once (the symbol/contract/effect subject
  # keys of that function are the same canonical key text — see the struct
  # docs). Rows absent -> the maps stay empty until the ingest populates
  # the coverage table. The DISCOVERY table's runtime-name binding is built
  # here too: test_name -> the test's canonical stable key text.
  for tr in snapshot.tests do
    coverage_map_push(&mut symbol_to_tests, tr.target.clone(), tr.test.stable_key.clone())
    coverage_map_push(&mut contract_to_tests, tr.target.clone(), tr.test.stable_key.clone())
    coverage_map_push(&mut effect_to_tests, tr.target.clone(), tr.test.stable_key.clone())
    let tname = stable_test_name_of(tr.test.clone())
    if tname.len() > 0 && !test_key_of_name.contains_key(&tname) then
      test_key_of_name.insert(tname, tr.test.stable_key.clone())
    end
    if !test_ids.contains(&tr.test) then
      test_ids.push(tr.test.clone())
    end
  end

  # The ingested coverage rows. Every row counts toward the availability
  # gate. A bound row (test_id non-empty) links its point AND its owning
  # function to the exercising test; an unbound row contributes the point
  # to coverage.affected but no test link (a fact recorded outside a test
  # run is evidence, never "covered by" a test). The row's test endpoint is
  # NORMALIZED through the discovery table: the runtime trace binds the
  # DECLARED test name, so a binding that matches a discovered test_name
  # resolves to that test's stable key; an unmatched binding stays its own
  # text (never fabricated into a discovered identity).
  for cr in snapshot.coverage do
    coverage_rows = coverage_rows + 1
    let row_decl = stable_decl_of_key(&cr.function.key)
    let cr_test_key = coverage_resolve_test_binding(&test_key_of_name, cr.test_id.clone())
    var point_kind = ""
    match cr.block_id.clone()
    when Option::Some(b) then
      point_kind = "block"
      if cr_test_key.len() > 0 then
        coverage_block_map_push(&mut block_to_tests, b, cr_test_key.clone())
      end
    when Option::None then ()
    end
    match cr.edge_id.clone()
    when Option::Some(e) then
      point_kind = "edge"
      if cr_test_key.len() > 0 then
        coverage_edge_map_push(&mut edge_to_tests, e, cr_test_key.clone())
      end
    when Option::None then ()
    end
    match cr.contract_id.clone()
    when Option::Some(cid) then
      point_kind = "contract"
      if cr_test_key.len() > 0 then
        coverage_contract_map_push(&mut contract_site_to_tests, cid, cr_test_key.clone())
      end
    when Option::None then ()
    end
    match cr.effect_site_id.clone()
    when Option::Some(sid) then
      point_kind = "effect"
      if cr_test_key.len() > 0 then
        coverage_effect_site_map_push(&mut effect_site_to_tests, sid, cr_test_key.clone())
      end
    when Option::None then ()
    end
    if cr_test_key.len() > 0 then
      coverage_map_push(&mut symbol_to_tests, row_decl.clone(), cr_test_key.clone())
      if point_kind == "contract" then
        coverage_map_push(&mut contract_to_tests, row_decl.clone(), cr_test_key.clone())
      elsif point_kind == "effect" then
        coverage_map_push(&mut effect_to_tests, row_decl.clone(), cr_test_key.clone())
      end
    end
    if point_kind.len() == 0 then
      let family = cr.kind.clone()
      if family == "Block" || family == "Edge" || family == "Contract" || family == "EffectSite" then
        untracked_point_rows = untracked_point_rows + 1
      end
    end
    if cr.branch_id.len() > 0 then
      coverage_map_push(&mut function_points, row_decl.clone(), cr.branch_id.clone())
    end
  end

  CoverageGraph {
    symbol_to_tests: symbol_to_tests,
    contract_to_tests: contract_to_tests,
    effect_to_tests: effect_to_tests,
    block_to_tests: block_to_tests,
    edge_to_tests: edge_to_tests,
    contract_site_to_tests: contract_site_to_tests,
    effect_site_to_tests: effect_site_to_tests,
    function_points: function_points,
    test_key_of_name: test_key_of_name,
    test_ids: test_ids,
    untracked_point_rows: untracked_point_rows,
    coverage_rows: coverage_rows
  }
end

# The discovery-table normalization of a coverage row's test endpoint: a
# `test|<name>` binding resolves to the discovered test's stable key text
# when the discovery table carries the name; an unbound row returns "";
# a binding with no discovery row stays its own text.
def coverage_resolve_test_binding(test_key_of_name: Map[String, String], test_id: String) -> String
  if test_id.len() == 0 then
    return "".to_string()
  end
  match test_key_of_name.get(test_id.clone())
  when Option::Some(k) then k.clone()
  when Option::None then test_id.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# 5. The typed accessors — the audit's TestId lookups, one family each
# ———————————————————————————————————————————————————————————————
# Each exists twice: the String-keyed form parses the exercised function's
# canonical key text once (stable_decl_of_key), the *_of_decl form takes
# the typed identity directly. Both return the sorted test-function stable
# key texts covering the function; [] for unknown keys.

# The tests exercising a symbol (function/def) key — the SymbolId index.
pub def tests_covering_symbol(graph: CoverageGraph, key: String) -> Vec[String]
  coverage_map_rows(&graph.symbol_to_tests, stable_decl_of_key(&key))
end

pub def tests_covering_symbol_decl(graph: CoverageGraph, key: StableDeclId) -> Vec[String]
  coverage_map_rows(&graph.symbol_to_tests, key.clone())
end

# The tests exercising a function's CONTRACT surface — the ContractId
# index at fn granularity (contract rows key on the owning function).
pub def tests_covering_contract(graph: CoverageGraph, key: String) -> Vec[String]
  coverage_map_rows(&graph.contract_to_tests, stable_decl_of_key(&key))
end

pub def tests_covering_contract_decl(graph: CoverageGraph, key: StableDeclId) -> Vec[String]
  coverage_map_rows(&graph.contract_to_tests, key.clone())
end

# The tests exercising a function's EFFECT surface — the EffectPath index
# at fn granularity (effect rows key on the subject function).
pub def tests_covering_effect(graph: CoverageGraph, key: String) -> Vec[String]
  coverage_map_rows(&graph.effect_to_tests, stable_decl_of_key(&key))
end

pub def tests_covering_effect_decl(graph: CoverageGraph, key: StableDeclId) -> Vec[String]
  coverage_map_rows(&graph.effect_to_tests, key.clone())
end

# The tests reaching a block — the MirBlockId index. The text argument is
# parsed ONCE at this API boundary into the typed record (Option::None for
# a text outside the grammar answers []); the MAP lookup is typed.
pub def tests_covering_block(graph: CoverageGraph, block_id: String) -> Vec[String]
  match stable_mir_block_of_key(block_id)
  when Option::Some(b) then coverage_block_map_rows(&graph.block_to_tests, b)
  when Option::None then Vec::new()
  end
end

pub def tests_covering_block_of(graph: CoverageGraph, block_id: StableMirBlockId) -> Vec[String]
  coverage_block_map_rows(&graph.block_to_tests, block_id)
end

# The tests traversing an edge — the MirEdgeId index. The text argument is
# parsed ONCE at this boundary (the semantic edge grammar or the tg.cov.v1
# locator grammar); an unparsable id answers [].
pub def tests_covering_edge(graph: CoverageGraph, edge_id: String) -> Vec[String]
  match stable_mir_cov_edge_of_key(edge_id)
  when Option::Some(e) then coverage_edge_map_rows(&graph.edge_to_tests, e)
  when Option::None then Vec::new()
  end
end

pub def tests_covering_edge_of(graph: CoverageGraph, edge_id: StableMirEdgeId) -> Vec[String]
  coverage_edge_map_rows(&graph.edge_to_tests, edge_id)
end

# The tests evaluating an exact contract id — the StableContractId index.
# The text argument is parsed ONCE at this boundary.
pub def tests_covering_contract_id(graph: CoverageGraph, contract_id: String) -> Vec[String]
  match stable_contract_of_key(contract_id)
  when Option::Some(c) then coverage_contract_map_rows(&graph.contract_site_to_tests, c)
  when Option::None then Vec::new()
  end
end

pub def tests_covering_contract_id_of(graph: CoverageGraph, contract_id: StableContractId) -> Vec[String]
  coverage_contract_map_rows(&graph.contract_site_to_tests, contract_id)
end

# The tests executing an exact effect site — the StableEffectSiteId index.
# The text argument is parsed ONCE at this boundary.
pub def tests_covering_effect_site(graph: CoverageGraph, site_id: String) -> Vec[String]
  match stable_effect_site_of_key(site_id)
  when Option::Some(s) then coverage_effect_site_map_rows(&graph.effect_site_to_tests, s)
  when Option::None then Vec::new()
  end
end

pub def tests_covering_effect_site_of(graph: CoverageGraph, site_id: StableEffectSiteId) -> Vec[String]
  coverage_effect_site_map_rows(&graph.effect_site_to_tests, site_id)
end

# The covered point ids of a symbol key (sorted tg.cov.v1 id texts) — the
# coverage.affected answer source.
pub def coverage_points_of_symbol(graph: CoverageGraph, key: String) -> Vec[String]
  coverage_map_rows(&graph.function_points, stable_decl_of_key(&key))
end

# Whether any coverage evidence was ingested into the snapshot the graph
# was built from (the op layer's available/unavailable gate).
pub def coverage_graph_has_rows(graph: CoverageGraph) -> Bool
  graph.coverage_rows > 0
end

# The number of ingested coverage rows the graph saw.
pub def coverage_graph_row_count(graph: CoverageGraph) -> Int
  graph.coverage_rows
end

# (audit order item 1 closeout) The number of point-family coverage rows
# the graph saw WITHOUT a typed point id (a legacy artifact): the
# documented untracked-point count. The graph answers NO point lookup for
# them (no locator fallback); callers surface this count instead.
pub def coverage_graph_untracked_point_rows(graph: CoverageGraph) -> Int
  graph.untracked_point_rows
end

# (audit order item 5) The discovered test identities of the graph's
# snapshot (the TestRelationship test endpoints, sorted by the model's row
# order). The targeted verification answers from these records.
pub def coverage_graph_test_ids(graph: CoverageGraph) -> Vec[StableTestId]
  var out: Vec[StableTestId] = Vec::new()
  for t in graph.test_ids do
    out.push(t.clone())
  end
  out
end

# (audit order item 5) The discovery-table lookup of a runtime test name:
# the test's canonical stable key text ("" when no discovered test carries
# the name — never a fabricated identity).
pub def coverage_graph_test_key_of_name(graph: CoverageGraph, name: String) -> String
  match graph.test_key_of_name.get(name.clone())
  when Option::Some(k) then k.clone()
  when Option::None then "".to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# 6. The trace parser + ingest (tg.cov.trace.v1)
# ———————————————————————————————————————————————————————————————

# One parsed trace row: the exercising test key ("" = unbound), the point
# family word ("block" | "edge" | "contract" | "effect"), the point's
# canonical tg.cov.v1 id text (edges are canonicalized through
# coverage_edge_id, so "edge|a|b" and "edge|a|b|cf" agree) AND the TYPED
# point record parsed at this boundary (audit order item 1 closeout) —
# exactly one typed field is Some. Downstream consumers key on the typed
# fields; the text is the row render.
pub struct CoverageTraceRow
  test_id: String
  kind: String
  point_id: String
  block: Option[StableMirBlockId] = Option::None
  edge: Option[StableMirEdgeId] = Option::None
  contract: Option[StableContractId] = Option::None
  effect: Option[StableEffectSiteId] = Option::None
end

# One test's reached points (the TestCoverage record): sorted, deduped
# tg.cov.v1 id texts per family. Built from a snapshot's coverage rows by
# coverage_test_coverage; the ingest's rows carry the same content.
pub struct TestCoverage
  test_id: String
  blocks: Vec[String] = Vec::new()
  edges: Vec[String] = Vec::new()
  contracts: Vec[String] = Vec::new()
  effects: Vec[String] = Vec::new()
end

# Split at the first '|': (before, after). No '|' -> (whole, "").
def coverage_trace_split_first(s: String) -> (String, String)
  match s.find("|")
  when Option::Some(i) then (s.slice(0, i), s.slice(i + 1, s.len()))
  when Option::None then (s.clone(), "".to_string())
  end
end

# Append one validated point row (payload = "<kind>|<body>") under the
# current test context; malformed or duplicate rows are dropped. The
# payload text is parsed ONCE here into BOTH the canonical render and the
# typed record (the sole text boundary; no consumer parses it again).
def coverage_trace_take_row(
  inout rows: Vec[CoverageTraceRow],
  inout seen: Set[String],
  test_id: String,
  payload: String
) -> Unit
  let (kind, body) = coverage_trace_split_first(payload)
  if body.len() == 0 then
    return ()
  end
  var point_id = "".to_string()
  var block: Option[StableMirBlockId] = Option::None
  var edge: Option[StableMirEdgeId] = Option::None
  var contract: Option[StableContractId] = Option::None
  var effect_site: Option[StableEffectSiteId] = Option::None
  if kind == "block" then
    match stable_mir_block_of_key(body.clone())
    when Option::Some(b) then
      point_id = b.stable_key.clone()
      block = Option::Some(b)
    when Option::None then ()
    end
  elsif kind == "edge" then
    match coverage_edge_payload_parse(body.clone())
    when Option::Some(e) then
      point_id = coverage_edge_id(e.from.clone(), e.to.clone(), e.kind.clone())
      # The typed edge record of EITHER coverage grammar (semantic keys or
      # the tg.cov.v1 locator form), parsed at this single boundary.
      match stable_mir_cov_edge_of_key(point_id.clone())
      when Option::Some(se) then edge = Option::Some(se)
      when Option::None then ()
      end
    when Option::None then ()
    end
  elsif kind == "contract" then
    match stable_contract_of_key(body.clone())
    when Option::Some(c) then
      point_id = body.clone()
      contract = Option::Some(c)
    when Option::None then ()
    end
  elsif kind == "effect" then
    match stable_effect_site_of_key(body.clone())
    when Option::Some(s) then
      point_id = body.clone()
      effect_site = Option::Some(s)
    when Option::None then ()
    end
  else
    return ()
  end
  if point_id.len() == 0 then
    return ()
  end
  let dedupe = test_id.clone() + "|" + kind.clone() + "|" + point_id.clone()
  if !seen.contains(&dedupe) then
    seen.insert(dedupe)
    rows.push(CoverageTraceRow {
      test_id: test_id,
      kind: kind,
      point_id: point_id,
      block: block,
      edge: edge,
      contract: contract,
      effect: effect_site
    })
  end
  ()
end

# Parse a tg.cov.trace.v1 trace text into validated trace rows, in trace
# order, deduped. "test|<key>" binds the current test; "test|<key>|<kind>|
# <body>" binds AND takes one row; a bare point row takes a row under the
# current binding ("" before any bind).
pub def coverage_trace_rows(trace_text: String) -> Vec[CoverageTraceRow]
  var rows: Vec[CoverageTraceRow] = Vec::new()
  var seen: Set[String] = Set::new()
  var current_test = "".to_string()
  for raw in trace_text.lines() do
    let line = raw.trim()
    if line.len() > 0 && !line.starts_with("#") then
      let (first, rest) = coverage_trace_split_first(line.clone())
      if first == "test" then
        if rest.len() > 0 then
          let (second, tail) = coverage_trace_split_first(rest.clone())
          current_test = second.clone()
          if tail.len() > 0 then
            coverage_trace_take_row(&mut rows, &mut seen, current_test.clone(), tail)
          end
        end
      elsif first == "block" || first == "edge" || first == "contract" || first == "effect" then
        coverage_trace_take_row(&mut rows, &mut seen, current_test.clone(), line.clone())
      end
    end
  end
  rows
end

# (audit order item 5) Normalize a raw runtime trace's test bindings to
# STABLE test keys before ingest: every `test|<name>` line (bare or
# inline `test|<name>|<kind>|<body>`) resolves through the snapshot's
# discovery table (test_name -> stable key); a binding with no discovered
# test stays its own text (never fabricated). The rewritten trace feeds
# coverage_ingest exactly like a trace the runtime had bound with stable
# keys — the CoverageRelationship rows then carry the stable test key
# text (the model's documented test endpoint).
pub def coverage_trace_bind_stable(snapshot: SemanticSnapshot, trace_text: String) -> String
  let graph = coverage_graph_of_snapshot(snapshot)
  var out: Vec[String] = Vec::new()
  for raw in trace_text.lines() do
    let line = raw.trim()
    if line.starts_with("test|") then
      let rest = line.slice(5, line.len())
      let (name, tail) = coverage_trace_split_first(rest.clone())
      let key = coverage_graph_test_key_of_name(graph.clone(), name.clone())
      let bound = if key.len() > 0 then key else name.clone() end
      if tail.len() > 0 then
        out.push("test|" + bound + "|" + tail)
      else
        out.push("test|" + bound)
      end
    else
      out.push(line.clone())
    end
  end
  out.join("\n") + "\n"
end

# The model kind word of a trace family word.
def coverage_trace_kind_word(kind: String) -> String
  if kind == "block" then
    "Block"
  elsif kind == "edge" then
    "Edge"
  elsif kind == "contract" then
    "Contract"
  elsif kind == "effect" then
    "EffectSite"
  else
    ""
  end
end

# The dedupe/join key of one CoverageRelationship row.
def coverage_row_join_key(r: CoverageRelationship) -> String
  var arm = "".to_string()
  match r.arm_id
  when Option::Some(a) then arm = a.clone()
  when Option::None then ()
  end
  r.function.key.clone() + "|" + r.branch_id.clone() + "|" + arm + "|" +
    r.kind.clone() + "|" + r.test_id.clone()
end

# Build the CoverageRelationship rows a trace produces against a snapshot
# (the rows-only ingest entry). One row per (point, exercising test); an
# unbound point (no test bind) yields a row with test_id "". The TYPED
# point id parsed at the trace boundary rides the row (audit order item 1
# closeout). Rows are deduped and sorted through the model's coverage sort.
pub def coverage_ingest_rows(snapshot: SemanticSnapshot, trace_text: String) -> Vec[CoverageRelationship]
  var rows: Vec[CoverageRelationship] = Vec::new()
  var seen: Set[String] = Set::new()
  for tr in coverage_trace_rows(trace_text) do
    let kind_word = coverage_trace_kind_word(tr.kind.clone())
    let owner = coverage_point_owner(tr.kind.clone(), tr.point_id.clone())
    if kind_word.len() > 0 && owner.len() > 0 then
      let row = CoverageRelationship {
        function: stable_def_id_digested(owner.clone(), owner.clone()),
        branch_id: tr.point_id.clone(),
        arm_id: Option::None,
        kind: kind_word,
        test_id: tr.test_id.clone(),
        span: Option::None,
        block_id: tr.block.clone(),
        edge_id: tr.edge.clone(),
        contract_id: tr.contract.clone(),
        effect_site_id: tr.effect.clone()
      }
      let join = coverage_row_join_key(&row)
      if !seen.contains(&join) then
        seen.insert(join)
        rows.push(row)
      end
    end
  end
  semantic_coverage_relationships_sort(&mut rows)
  rows
end

# Ingest a trace into a snapshot: the snapshot's existing coverage rows are
# kept and the new deduped rows are merged, then the merged table is
# sorted through the model's coverage sort. The returned snapshot's
# coverage table IS the §40 index source — coverage_graph_of_snapshot over
# it rebuilds every index family (repeated ingests accumulate).
pub def coverage_ingest(snapshot: SemanticSnapshot, trace_text: String) -> SemanticSnapshot
  var out = snapshot.clone()
  var merged: Vec[CoverageRelationship] = out.coverage.clone()
  var seen: Set[String] = Set::new()
  for r in merged do
    seen.insert(coverage_row_join_key(&r))
  end
  for r in coverage_ingest_rows(snapshot.clone(), trace_text.clone()) do
    let join = coverage_row_join_key(&r)
    if !seen.contains(&join) then
      seen.insert(join)
      merged.push(r)
    end
  end
  semantic_coverage_relationships_sort(&mut merged)
  out.coverage = merged
  out
end

# Group a snapshot's coverage rows into the TestCoverage records: one per
# non-empty test id, with sorted, deduped point id lists per family, the
# records sorted by test id.
pub def coverage_test_coverage(snapshot: SemanticSnapshot) -> Vec[TestCoverage]
  var by_test: Map[String, TestCoverage] = Map::new()
  for r in snapshot.coverage do
    if r.test_id.len() > 0 then
      var tc = match by_test.get(r.test_id.clone())
      when Option::Some(existing) then existing.clone()
      when Option::None then TestCoverage { test_id: r.test_id.clone() }
      end
      if r.kind == "Block" then
        if !tc.blocks.contains(&r.branch_id) then
          tc.blocks.push(r.branch_id.clone())
        end
      elsif r.kind == "Edge" then
        if !tc.edges.contains(&r.branch_id) then
          tc.edges.push(r.branch_id.clone())
        end
      elsif r.kind == "Contract" then
        if !tc.contracts.contains(&r.branch_id) then
          tc.contracts.push(r.branch_id.clone())
        end
      elsif r.kind == "EffectSite" then
        if !tc.effects.contains(&r.branch_id) then
          tc.effects.push(r.branch_id.clone())
        end
      end
      by_test.insert(r.test_id.clone(), tc)
    end
  end
  var entries: Vec[(String, TestCoverage)] = by_test.entries()
  var out: Vec[TestCoverage] = Vec::new()
  var ei = 0
  while ei < entries.len() do
    out.push(entries[ei].1.clone())
    ei = ei + 1
  end
  var insert_i = 1
  while insert_i < out.len() do
    let insert_current = out[insert_i].clone()
    var insert_j = insert_i
    while insert_j > 0 && insert_current.test_id < out[insert_j - 1].test_id do
      out[insert_j] = out[insert_j - 1].clone()
      insert_j = insert_j - 1
    end
    out[insert_j] = insert_current
    insert_i = insert_i + 1
  end
  var oi = 0
  while oi < out.len() do
    semantic_strings_sort(&mut out[oi].blocks)
    semantic_strings_sort(&mut out[oi].edges)
    semantic_strings_sort(&mut out[oi].contracts)
    semantic_strings_sort(&mut out[oi].effects)
    oi = oi + 1
  end
  out
end

# ———————————————————————————————————————————————————————————————
# 7. The uncovered-edge query — created edges without a covering test
# ———————————————————————————————————————————————————————————————

# The delta call-row key text of a §29 CallEdge (the §31 delta protocol's
# canonical call-row key — caller|callee|kind-numeric).
def coverage_call_row_key(c: CallEdge) -> String
  c.caller.key.clone() + "|" + c.callee.key.clone() + "|" +
    semantic_call_edge_kind_numeric(&c.kind).to_string()
end

def coverage_delta_kind_created(k: DeltaKind) -> Bool
  match k
  when DeltaKind::Created then true
  when _ then false
  end
end

# The created call rows of the delta that the current snapshot BACKS: the
# row identity (the StableRowKey digest words) must exist among the
# snapshot's own call rows (a delta built against a different snapshot
# pair never leaks rows into the output). The snapshot rows are parsed to
# the same typed row key and compared by digest words.
def coverage_snapshot_has_call_row(snapshot: SemanticSnapshot, row: StableRowKey) -> Bool
  var found = false
  for c in snapshot.calls do
    match stable_row_key_of(&coverage_call_row_key(c))
    when Option::Some(candidate) then
      if stable_row_key_digest_eq(&candidate, &row) then
        found = true
        break
      end
    when Option::None then ()
    end
  end
  found
end

# The created effect rows of the delta backed by the snapshot's effect
# table (effect rows key on the subject function's stable decl).
def coverage_snapshot_has_effect_row(snapshot: SemanticSnapshot, key: StableDeclId) -> Bool
  var found = false
  for e in snapshot.effects do
    if stable_decl_eq(&stable_decl_of_key(&e.function.key), &key) then
      found = true
      break
    end
  end
  found
end

# Whether an effect delta row represents a NEWLY GAINED effect surface
# (audit items 14/15 semantics — the delta rows carry typed before/after
# §11 views; a row whose before view is empty and whose after view carries
# classes/capabilities is the typed "created effect edge" of the former
# row-lifecycle classification: the subject function gained an effect row
# with content — Created rows with an all-clean summary never fire, since
# they introduce no effect surface to cover).
def coverage_effect_gained(e: EffectDelta) -> Bool
  if e.before.bits != 0 || e.before.capabilities.len() > 0 then
    return false
  end
  e.after.bits != 0 || e.after.capabilities.len() > 0
end

# The coveredness predicates of the module doc: a call edge is covered when
# a test covers its source (caller) symbol; an effect edge is covered when
# a test covers the source symbol OR the source's effect surface. Ingested
# coverage rows promote the owning function into the symbol index, so these
# predicates answer from real trace evidence once an ingest has run.
def coverage_symbol_covered(graph: CoverageGraph, key: String) -> Bool
  tests_covering_symbol(&graph, key.clone()).len() > 0
end

def coverage_symbol_covered_decl(graph: CoverageGraph, key: StableDeclId) -> Bool
  tests_covering_symbol_decl(&graph, key.clone()).len() > 0
end

def coverage_effect_covered(graph: CoverageGraph, key: String) -> Bool
  tests_covering_effect(&graph, key.clone()).len() > 0
end

def coverage_effect_covered_decl(graph: CoverageGraph, key: StableDeclId) -> Bool
  tests_covering_effect_decl(&graph, key.clone()).len() > 0
end

# ———————————————————————————————————————————————————————————————
# 7b. The TYPED uncovered-path constraints + targeted verification
# ———————————————————————————————————————————————————————————————
# (audit order item 5) The uncovered-edge query returns its lines through
# TYPED records now: ONE TargetedPathConstraint per created call/gained
# effect edge with no covering test. The line renderer below is the
# canonical text of the record (uncovered_paths delegates here, so the
# text and the record can never drift). `obligation` is the fixed
# "test-must-exist" word: the path has no test and a generator must
# synthesize one.

pub struct TargetedPathConstraint
  edge_kind: String    # "call" | "effect"
  source: String       # the source symbol key (caller / effect subject)
  target: String       # the callee key / the effect §11 class payload text
  constraint: String   # "<source>#B?<edge key>" — the generator anchor
  obligation: String = "test-must-exist"
end

# The canonical uncovered-path line of a typed constraint (the audit's
# documented "uncovered:<edge kind>:<src>-><dst>:no covering test:
# constraint <anchor>" grammar).
pub def coverage_path_constraint_line(c: TargetedPathConstraint) -> String
  "uncovered:" + c.edge_kind.clone() + ":" + c.source.clone() + "->" + c.target.clone() +
    ":no covering test: constraint " + c.constraint.clone()
end

# The typed uncovered-path builder: every CREATED call/effect edge of the
# delta (the delta's own key-membership Created classification) that the
# current snapshot backs and that NO test in the graph covers yields one
# record. Sorted by the canonical line (deduped by constraint + kind).
pub def targeted_path_constraints(graph: CoverageGraph, snapshot: SemanticSnapshot, delta: SemanticDelta) -> Vec[TargetedPathConstraint]
  var records: Vec[TargetedPathConstraint] = Vec::new()
  var seen: Set[String] = Set::new()

  # 1. Created CALL edges: a new call terminator in the caller's MIR body.
  #    The constraint's source is the CALLER — a generated test must drive
  #    the caller function so the new callee edge is reached.
  for e in delta.call_delta do
    if coverage_delta_kind_created(&e.kind) && e.from.len() > 0 then
      let from_decl = stable_decl_of_key(&e.from)
      let row_key = stable_row_key_or_text("call".to_string(), e.key.clone())
      if coverage_snapshot_has_call_row(&snapshot, row_key) then
        if !coverage_symbol_covered_decl(&graph, from_decl.clone()) then
          let record = TargetedPathConstraint {
            edge_kind: "call".to_string(),
            source: e.from.clone(),
            target: e.to.clone(),
            constraint: e.from.clone() + "#B?" + e.key.clone()
          }
          let join = record.edge_kind.clone() + "|" + record.constraint.clone()
          if !seen.contains(&join) then
            seen.insert(join)
            records.push(record)
          end
        end
      end
    end
  end

  # 2. GAINED effect edges: the subject function newly carries an effect
  #    surface (the typed before/after view rule). coveredness =
  #    source-symbol OR source-effect coverage.
  for e in delta.effect_delta do
    if coverage_effect_gained(&e) && e.function.len() > 0 then
      let fn_decl = stable_decl_of_key(&e.function)
      if coverage_snapshot_has_effect_row(&snapshot, fn_decl.clone()) then
        if !coverage_symbol_covered_decl(&graph, fn_decl.clone()) &&
          !coverage_effect_covered_decl(&graph, fn_decl.clone()) then
          let effect_text = semantic_delta_effect_view_text(&e.after)
          let record = TargetedPathConstraint {
            edge_kind: "effect".to_string(),
            source: e.function.clone(),
            target: effect_text.clone(),
            constraint: e.function.clone() + "#B?effect:" + effect_text.clone()
          }
          let join = record.edge_kind.clone() + "|" + record.constraint.clone()
          if !seen.contains(&join) then
            seen.insert(join)
            records.push(record)
          end
        end
      end
    end
  end

  # The output order is the canonical line order (the historical sort).
  var lines: Vec[String] = Vec::new()
  for r in records do
    lines.push(coverage_path_constraint_line(&r))
  end
  semantic_strings_sort(&mut lines)
  var out: Vec[TargetedPathConstraint] = Vec::new()
  var pushed: Set[String] = Set::new()
  for line in lines do
    if !pushed.contains(&line) then
      pushed.insert(line.clone())
      for r in records do
        if coverage_path_constraint_line(&r) == line then
          out.push(r.clone())
          break
        end
      end
    end
  end
  out
end

# The uncovered-edge query: the CANONICAL TEXT of targeted_path_constraints
# (one line per uncovered created call/gained effect edge). Sorted,
# deduped output — byte-identical to the pre-item-5 query.
pub def uncovered_paths(graph: CoverageGraph, snapshot: SemanticSnapshot, delta: SemanticDelta) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for r in targeted_path_constraints(&graph, &snapshot, &delta) do
    out.push(coverage_path_constraint_line(&r))
  end
  out
end

# (audit order item 5) ONE targeted-verification request:
#   kind "affected-test" — a test that MUST RUN for the delta: `test` is
#     the test's canonical stable key text and `symbols` are the
#     delta-affected symbol keys that test reaches (sorted, deduped).
#   kind "uncovered-path" — a path constraint for which NO test exists:
#     the typed record fields ride the request (test stays "").
# THE SYNTHESIS HAND-OFF: this kernel surface exposes the typed requests
# ONLY. The full-library consumer (tg_compiler/test_synthesis.tg, imported
# by the out-of-manifest driver) promotes the uncovered-path rows into
# synthesis requests and calls std::test_gen there — std::test_gen is
# outside the kernel manifest, so the kernel closure can never carry the
# generator. This module never fabricates a test.
pub struct TargetedTestRequest
  kind: String
  test: String = ""
  symbols: Vec[String] = Vec::new()
  constraint: String = ""
  edge_kind: String = ""
  source: String = ""
  target: String = ""
end

# The targeted verification for a §31 delta against a snapshot: the tests
# that must run (affected: the delta-affected symbol keys' covering tests,
# from the discovery table AND ingested coverage) plus the uncovered path
# constraints no test covers. NO test synthesis is fabricated here: an
# uncovered-path request names exactly the constraint a generator must
# satisfy.
pub def test_targeted_for_delta(snapshot: SemanticSnapshot, delta: SemanticDelta) -> Vec[TargetedTestRequest]
  var out: Vec[TargetedTestRequest] = Vec::new()
  let graph = coverage_graph_of_snapshot(snapshot.clone())

  # 1. Affected tests: every delta-affected symbol key -> its covering
  #    tests (tests_covering_symbol is the discovery+ingest union). The
  #    per-test symbol sets are sorted/deduped; the test entries are
  #    emitted in stable-key order.
  var by_test: Map[String, Vec[String]] = Map::new()
  for key in delta.affected do
    if key.len() > 0 then
      for t in tests_covering_symbol(&graph, key.clone()) do
        var syms = match by_test.get(t.clone())
        when Option::Some(s) then s.clone()
        when Option::None then Vec::new()
        end
        if !syms.contains(&key) then
          syms.push(key.clone())
        end
        by_test.insert(t.clone(), syms)
      end
    end
  end
  var entries: Vec[(String, Vec[String])] = by_test.entries()
  var insert_i = 1
  while insert_i < entries.len() do
    let insert_current = entries[insert_i].clone()
    var insert_j = insert_i
    while insert_j > 0 && insert_current.0 < entries[insert_j - 1].0 do
      entries[insert_j] = entries[insert_j - 1].clone()
      insert_j = insert_j - 1
    end
    entries[insert_j] = insert_current
    insert_i = insert_i + 1
  end
  var ei = 0
  while ei < entries.len() do
    var syms = entries[ei].1.clone()
    semantic_strings_sort(&mut syms)
    out.push(TargetedTestRequest {
      kind: "affected-test".to_string(),
      test: entries[ei].0.clone(),
      symbols: syms
    })
    ei = ei + 1
  end

  # 2. Uncovered path constraints (no test exists): typed records.
  for c in targeted_path_constraints(&graph, &snapshot, &delta) do
    out.push(TargetedTestRequest {
      kind: "uncovered-path".to_string(),
      constraint: c.constraint.clone(),
      edge_kind: c.edge_kind.clone(),
      source: c.source.clone(),
      target: c.target.clone()
    })
  end
  out
end

# ———————————————————————————————————————————————————————————————
# 7c. The mutation-report kill mapping (audit order item 5)
# ———————————————————————————————————————————————————————————————
# ONE mutation's kill mapping: the harness's mutation id and behavioral
# suite ids, the stable test key texts its KILLING TEST IDENTIFIERS
# resolved to through the discovery table (deduped, sorted) and the
# identifiers with NO discovery row (the honest residual). `status`:
#   "Mapped"      — at least one identifier resolved to a discovered test;
#   "Unavailable" — none did; the mutation's kill is reported WITHOUT a
#                   stable test identity (never fabricated).
# The behavioral harness (scripts/run_mutation_tests.sh) classifies a kill
# by running mapped suites whose test files fail under the mutated
# compiler. The harness NOW EMITS THE PER-SUITE FAILING TEST IDENTIFIERS
# (audit order item 5 closeout): for every failed suite its own log is
# scanned for driver.tg's `tg test` failure lines ("FAIL  <file>::<name>"
# — the declared test name, the same key the discovery table carries); a
# suite that failed WITHOUT a per-test name (a compile/check-driven
# canary suite or a crashed runner) is reported as the suite plus the
# `crash` marker, and a mutation killed at the compiler BUILD step is
# reported as the `build` marker — markers are NOT test identities, land
# in `unmapped` and are never fabricated into a discovery row. A report
# carrying only suite ids maps nothing: pass the test-level identifiers,
# never a suite name.
pub struct MutationKillMapping
  mutation_id: String
  # (audit order item 5) the SNAPSHOT REVISION the mapping was resolved
  # against (the content-addressed render): a mutation kill is attached to
  # the revision whose discovery table mapped it, so two reports over
  # different revisions are never conflated.
  revision: String = ""
  suites: Vec[String] = Vec::new()
  killing_tests: Vec[String] = Vec::new()
  # The typed identities of the mapped killing tests (same order as
  # killing_tests — the StableTestId records the report carries into the
  # targeted-verification loop).
  killing_test_ids: Vec[StableTestId] = Vec::new()
  unmapped: Vec[String] = Vec::new()
  status: String = "Unavailable"
end

# Map one mutation report row's test identifiers to StableTestId key
# texts AND typed records via the snapshot's discovery table (declared
# test name AND canonical stable key both resolve). Identifiers with no
# discovery row land in `unmapped`; an empty mapping answers
# "Unavailable".
pub def mutation_kill_mapping(
  snapshot: SemanticSnapshot,
  mutation_id: String,
  suites: Vec[String],
  test_identifiers: Vec[String]
) -> MutationKillMapping
  var by_ident: Map[String, StableTestId] = Map::new()
  for tr in snapshot.tests do
    if tr.test.test_name.len() > 0 && !by_ident.contains_key(&tr.test.test_name) then
      by_ident.insert(tr.test.test_name.clone(), tr.test.clone())
    end
    if !by_ident.contains_key(&tr.test.stable_key) then
      by_ident.insert(tr.test.stable_key.clone(), tr.test.clone())
    end
  end
  var mapped: Vec[String] = Vec::new()
  var unmapped: Vec[String] = Vec::new()
  for ident in test_identifiers do
    match by_ident.get(ident.clone())
    when Option::Some(t) then
      if !mapped.contains(&t.stable_key) then
        mapped.push(t.stable_key.clone())
      end
    when Option::None then
      if !unmapped.contains(&ident) then
        unmapped.push(ident.clone())
      end
    end
  end
  semantic_strings_sort(&mut mapped)
  semantic_strings_sort(&mut unmapped)
  # The typed ids follow the sorted key order exactly (re-resolved through
  # the same table).
  var sorted_ids: Vec[StableTestId] = Vec::new()
  for k in mapped do
    match by_ident.get(k.clone())
    when Option::Some(t) then sorted_ids.push(t.clone())
    when Option::None then ()
    end
  end
  let status = if mapped.len() > 0 then "Mapped".to_string() else "Unavailable".to_string() end
  MutationKillMapping {
    mutation_id: mutation_id,
    revision: semantic_digest_render(&snapshot.revision),
    suites: suites,
    killing_tests: mapped,
    killing_test_ids: sorted_ids,
    unmapped: unmapped,
    status: status
  }
end

# ———————————————————————————————————————————————————————————————
# 8. The coverage lane (third-audit item 34 executable rows)
# ———————————————————————————————————————————————————————————————
# Hand-built trace + snapshot fixtures asserting: the id grammar helpers;
# the compile-time table builder over a hand-built MirFunction; the ingest
# (rows, TestCoverage records, index families, the unbound row); the
# uncovered_paths query over a hand-built delta; the availability gate; and
# (audit order item 5) the discovery-table name binding, the typed
# targeted verification and the mutation kill mapping. Empty = the lane
# verifies.

def coverage_lane_target() -> StableTargetId
  StableTargetId {
    triple: "coverage-lane".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def coverage_lane_snapshot() -> SemanticSnapshot
  SemanticSnapshot {
    revision: semantic_digest_zero(),
    compiler_version: "coverage-lane".to_string(),
    target: coverage_lane_target(),
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
end

def coverage_lane_sid(key: String) -> StableDefId
  stable_def_id_digested(key.clone(), key.clone())
end

# The hand-built trace: one unbound block row (recorded outside any test
# run), then test_a over f's block B0 / edge / contract / effect and
# test_b over f's block B1.
def coverage_lane_trace() -> String
  "# coverage lane trace\n" +
    "block|m::u#fn()->unit#B0\n" +
    "test|m::test_a#fn()->unit\n" +
    "block|m::f#fn()->unit#B0\n" +
    "edge|m::f#fn()->unit#B0|m::f#fn()->unit#B1\n" +
    "contract|m::f#fn()->unit|Pre|result > 0\n" +
    "effect|m::f#fn()->unit|effect@io#0\n" +
    "test|m::test_b#fn()->unit|block|m::f#fn()->unit#B1\n"
end

# ———— (audit order item 5) the discovery/targeted lane fixtures ————

# ONE discovered test identity: the test's declared NAME + owner key
# render the stable key; the digest words are the identity (synthetic
# lane values — the identity is what matters, not the preimage here).
def coverage_lane_test_id(name: String, owner_key: String) -> StableTestId
  var attrs: Vec[String] = Vec::new()
  attrs.push("test".to_string())
  stable_test_id_from_row(
    owner_key.clone() + "|test@attr#" + name.clone(),
    "attr".to_string(),
    name.clone(),
    attrs,
    0x1234,
    0x5678
  )
end

def coverage_lane_test_a() -> StableTestId
  coverage_lane_test_id("test_a".to_string(), "m::test_a#fn()->unit".to_string())
end

def coverage_lane_test_b() -> StableTestId
  coverage_lane_test_id("test_b".to_string(), "m::test_b#fn()->unit".to_string())
end

# The discovery fixture: test_a exercises m::f, test_b exercises m::g (the
# TestRelationship rows a snapshot builder emits), over the call-fixture
# snapshot the uncovered lane uses.
def coverage_lane_discovery_snapshot() -> SemanticSnapshot
  var snapshot = coverage_lane_call_snapshot()
  var tests: Vec[TestRelationship] = Vec::new()
  tests.push(TestRelationship {
    test: coverage_lane_test_a(),
    target: stable_decl_of_key(&"m::f#fn()->unit".to_string())
  })
  tests.push(TestRelationship {
    test: coverage_lane_test_b(),
    target: stable_decl_of_key(&"m::g#fn()->unit".to_string())
  })
  snapshot.tests = tests
  snapshot
end

# The RAW runtime trace form: the generated dispatch main binds argv[1],
# the DECLARED name — exactly what tg.cov.trace.v1 carries before the
# discovery-table normalization.
def coverage_lane_named_trace() -> String
  "tg.cov.trace.v1\n" +
    "test|test_a\n" +
    "block|m::f#fn()->unit#B0\n"
end

# The targeted fixture: the delta-affected set names f and g (both
# discovered tests reach one), and the created h -> k call has no covering
# test. f's created f -> j row is covered by test_a's discovery row.
def coverage_lane_targeted_delta() -> SemanticDelta
  var d = coverage_lane_delta()
  d.affected = Vec::from(["m::f#fn()->unit".to_string(), "m::g#fn()->unit".to_string()])
  d
end

def coverage_lane_block(kind_id: Int) -> String
  coverage_block_id_of("m::f#fn()->unit".to_string(), kind_id)
end

def coverage_lane_edge() -> String
  coverage_edge_id(
    coverage_lane_block(0),
    coverage_lane_block(1),
    "cf".to_string()
  )
end

def coverage_lane_contract() -> String
  "m::f#fn()->unit|Pre|result > 0".to_string()
end

def coverage_lane_effect() -> String
  coverage_effect_site_id("m::f#fn()->unit".to_string(), "io".to_string(), 0)
end

# The uncovered fixture: the b-side snapshot backs the two created call
# rows h -> k (uncovered) and f -> j (f is covered by the trace).
def coverage_lane_call_snapshot() -> SemanticSnapshot
  var snapshot = coverage_lane_snapshot()
  var calls: Vec[CallEdge] = Vec::new()
  calls.push(CallEdge {
    caller: coverage_lane_sid("m::h#fn()->unit".to_string()),
    callee: coverage_lane_sid("m::k#fn()->unit".to_string()),
    kind: CallEdgeKind::Direct
  })
  calls.push(CallEdge {
    caller: coverage_lane_sid("m::f#fn()->unit".to_string()),
    callee: coverage_lane_sid("m::j#fn()->unit".to_string()),
    kind: CallEdgeKind::Direct
  })
  snapshot.calls = calls
  snapshot
end

def coverage_lane_delta() -> SemanticDelta
  var d = SemanticDelta {
    public_api_delta: AbiDeltaView {
      surface_id: "api".to_string(),
      before: AbiSurfaceView { rows: Vec::new() },
      after: AbiSurfaceView { rows: Vec::new() }
    },
    abi_delta: AbiDeltaView {
      surface_id: "abi".to_string(),
      before: AbiSurfaceView { rows: Vec::new() },
      after: AbiSurfaceView { rows: Vec::new() }
    }
  }
  var calls: Vec[EdgeDelta] = Vec::new()
  calls.push(EdgeDelta {
    key: "m::h#fn()->unit|m::k#fn()->unit|0".to_string(),
    kind: DeltaKind::Created,
    from: "m::h#fn()->unit".to_string(),
    to: "m::k#fn()->unit".to_string()
  })
  calls.push(EdgeDelta {
    key: "m::f#fn()->unit|m::j#fn()->unit|0".to_string(),
    kind: DeltaKind::Created,
    from: "m::f#fn()->unit".to_string(),
    to: "m::j#fn()->unit".to_string()
  })
  d.call_delta = calls
  d
end

# The hand-built MIR function of the table lane (ORIGIN-STAMPED: every
# block/terminator carries a deterministic generated origin, so the
# persistent builders key on the semantic ids — audit order item 1):
#   b0 switch -> b1 / default b2 ; b1 goto b3 ; b2 goto b3 ; b3 return
# Counter plan (Vec order): blocks 0..3 at indices 0..3, then the edges
# b0->b1 "switch" (4), b0->b2 "switch-default" (5), b1->b3 "goto" (6),
# b2->b3 "goto" (7).
def coverage_lane_fn_key() -> String
  "m::f#fn()->unit".to_string()
end

def coverage_lane_gen_node(role: String, seq: Int) -> StableMirNodeId
  let fn_key = coverage_lane_fn_key()
  stable_mir_node_id_of_generated(fn_key.clone(), fn_key, "coverage-lane".to_string(), role, seq)
end

def coverage_lane_gen_block(block_id: Int) -> StableMirBlockId
  let fn_key = coverage_lane_fn_key()
  stable_mir_block_id_of_control_generated(fn_key.clone(), fn_key, "coverage-lane".to_string(), "block".to_string(), block_id)
end

# The semantic block key text of the fixture function's block.
def coverage_lane_fn_block_key(block_id: Int) -> String
  coverage_lane_gen_block(block_id).stable_key.clone()
end

def coverage_lane_switch_term(arm: Int, fallback: Int) -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirSwitchInt {
      op: operand_constant(MirConstant {
        kind: MirConstantKind::MirInt(0),
        ty: Type::Int,
        instance: Option::None
      }),
      targets: Vec::from([SwitchTarget {
        value: 0,
        target: MirBlockId { id: arm }
      }]),
      default_target: MirBlockId { id: fallback }
    },
    span: span_dummy(),
    origin: Option::Some(coverage_lane_gen_node("switch".to_string(), arm))
  }
end

def coverage_lane_goto_term(target: Int) -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirGoto(MirBlockId { id: target }),
    span: span_dummy(),
    origin: Option::Some(coverage_lane_gen_node("goto".to_string(), target))
  }
end

def coverage_lane_return_term() -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirReturn,
    span: span_dummy(),
    origin: Option::Some(coverage_lane_gen_node("return".to_string(), 0))
  }
end

def coverage_lane_mir_fn() -> MirFunction
  var locals: Vec[MirLocal] = Vec::new()
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(MirBlock {
    id: MirBlockId { id: 0 },
    statements: Vec::new(),
    terminator: coverage_lane_switch_term(1, 2),
    origin: Option::Some(coverage_lane_gen_block(0))
  })
  blocks.push(MirBlock {
    id: MirBlockId { id: 1 },
    statements: Vec::new(),
    terminator: coverage_lane_goto_term(3),
    origin: Option::Some(coverage_lane_gen_block(1))
  })
  blocks.push(MirBlock {
    id: MirBlockId { id: 2 },
    statements: Vec::new(),
    terminator: coverage_lane_goto_term(3),
    origin: Option::Some(coverage_lane_gen_block(2))
  })
  blocks.push(MirBlock {
    id: MirBlockId { id: 3 },
    statements: Vec::new(),
    terminator: coverage_lane_return_term(),
    origin: Option::Some(coverage_lane_gen_block(3))
  })
  MirFunction {
    name: coverage_lane_fn_key(),
    params: Vec::new(),
    ret_type: Type::Unit,
    locals: locals,
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  }
end

# The UNTRACKED twin: the same body with NO origins (hand-built test MIR).
# The persistent builders must return the documented UntrackedArtifact
# result for it — never a locator-keyed table/plan.
def coverage_lane_mir_fn_untracked() -> MirFunction
  var f = coverage_lane_mir_fn()
  var blocks: Vec[MirBlock] = Vec::new()
  for b in f.blocks do
    var nb = b.clone()
    nb.origin = Option::None
    nb.terminator.origin = Option::None
    blocks.push(nb)
  end
  f.blocks = blocks
  f
end

def coverage_lane_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def coverage_lane_row(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !coverage_lane_same(got, expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

def coverage_lane_int(inout out: Vec[String], name: String, got: Int, expected: Int) -> Unit
  if got != expected then
    out.push(name + ": expected " + expected.to_string() + ", got " + got.to_string())
  end
  ()
end

def coverage_lane_bool_text(b: Bool) -> String
  if b then "true" else "false" end
end

def coverage_lane_bool(inout out: Vec[String], name: String, got: Bool, expected: Bool) -> Unit
  if got != expected then
    out.push(name + ": expected " + coverage_lane_bool_text(expected) +
      ", got " + coverage_lane_bool_text(got))
  end
  ()
end

def coverage_lane_str(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected.clone() then
    out.push(name + ": expected [" + expected + "], got [" + got + "]")
  end
  ()
end

# Run the lane rows. Returns every mismatch row (empty = the lane
# verifies).
pub def coverage_graph_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # —— A. the id grammar ——
  let b0 = coverage_lane_block(0)
  let b1 = coverage_lane_block(1)
  let e01 = coverage_lane_edge()
  coverage_lane_bool(&mut out, "a1-block-owner",
    coverage_block_id_owner(b0.clone()) == "m::f#fn()->unit".to_string(), true)
  coverage_lane_int(&mut out, "a2-block-ordinal",
    coverage_block_id_ordinal(b0.clone()), 0)
  coverage_lane_bool(&mut out, "a3-point-kind-block",
    coverage_point_kind(b0.clone()) == "block", true)
  coverage_lane_bool(&mut out, "a4-point-kind-edge",
    coverage_point_kind(e01.clone()) == "edge", true)
  coverage_lane_bool(&mut out, "a5-point-kind-contract",
    coverage_point_kind(coverage_lane_contract()) == "contract", true)
  coverage_lane_bool(&mut out, "a6-point-kind-effect",
    coverage_point_kind(coverage_lane_effect()) == "effect", true)
  match coverage_edge_id_parse(e01.clone())
  when Option::Some(parsed) then
    coverage_lane_bool(&mut out, "a7-edge-parse-from",
      parsed.from == b0.clone(), true)
    coverage_lane_bool(&mut out, "a8-edge-parse-to",
      parsed.to == b1.clone(), true)
    coverage_lane_bool(&mut out, "a9-edge-parse-kind",
      parsed.kind == "cf".to_string(), true)
  when Option::None then
    out.push("a7-edge-parse: expected Some, got None")
  end
  match coverage_effect_site_id_parse(coverage_lane_effect())
  when Option::Some(site) then
    coverage_lane_bool(&mut out, "a10-site-role",
      site.role == "io".to_string(), true)
    coverage_lane_int(&mut out, "a11-site-seq", site.role_seq, 0)
  when Option::None then
    out.push("a10-site-parse: expected Some, got None")
  end
  match coverage_edge_id_parse("not-an-edge".to_string())
  when Option::None then ()
  when Option::Some(_) then
    out.push("a12-invalid-edge: expected None, got Some")
  end

  # —— B. the compile-time coverage table (origin-tracked MIR) ——
  # The block/edge slots key on the fixture's P0-7 generated origins; the
  # locator texts of section A are NOT the table ids.
  let sb0 = coverage_lane_fn_block_key(0)
  let sb1 = coverage_lane_fn_block_key(1)
  let sb2 = coverage_lane_fn_block_key(2)
  let sb3 = coverage_lane_fn_block_key(3)
  let table = match coverage_table_of_mir_function(coverage_lane_fn_key(), coverage_lane_mir_fn())
  when Result::Ok(t) then t
  when Result::Err(u) then
    out.push("b0-table-untracked: unexpected " + untracked_artifact_text(u))
    CoverageTable { function_key: coverage_lane_fn_key() }
  end
  coverage_lane_int(&mut out, "b1-counter-count",
    coverage_table_counter_count(table.clone()), 8)
  coverage_lane_int(&mut out, "b2-block-counter-b0",
    coverage_table_block_counter(table.clone(), sb0.clone()), 0)
  coverage_lane_int(&mut out, "b3-block-counter-b1",
    coverage_table_block_counter(table.clone(), sb1.clone()), 1)
  coverage_lane_int(&mut out, "b4-block-counter-b2",
    coverage_table_block_counter(table.clone(), sb2.clone()), 2)
  coverage_lane_int(&mut out, "b5-block-counter-b3",
    coverage_table_block_counter(table.clone(), sb3.clone()), 3)
  coverage_lane_int(&mut out, "b6-edge-counter-switch",
    coverage_table_edge_counter(table.clone(),
      coverage_edge_id(sb0.clone(), sb1.clone(), "switch".to_string())), 4)
  coverage_lane_int(&mut out, "b7-edge-counter-switch-default",
    coverage_table_edge_counter(table.clone(),
      coverage_edge_id(sb0.clone(), sb2.clone(), "switch-default".to_string())), 5)
  coverage_lane_int(&mut out, "b8-edge-counter-goto",
    coverage_table_edge_counter(table.clone(),
      coverage_edge_id(sb1.clone(), sb3.clone(), "goto".to_string())), 6)
  coverage_lane_int(&mut out, "b9-counter-offset",
    coverage_table_counter_offset(table.clone(), sb1.clone()), 8)
  coverage_lane_int(&mut out, "b10-table-render-lines",
    coverage_table_render(table.clone()).lines().len(), 9)
  coverage_lane_bool(&mut out, "b11-table-semantic-block-key",
    table.block_counters.contains_key(sb0.clone()), true)
  coverage_lane_bool(&mut out, "b12-table-not-locator-key",
    table.block_counters.contains_key(coverage_lane_block(0)), false)

  # —— C. the ingest ——
  let trace = coverage_lane_trace()
  let ingested = coverage_ingest(coverage_lane_call_snapshot(), trace.clone())
  coverage_lane_int(&mut out, "c1-row-count", ingested.coverage.len(), 6)
  let graph = coverage_graph_of_snapshot(ingested.clone())
  coverage_lane_bool(&mut out, "c2-graph-has-rows",
    coverage_graph_has_rows(graph.clone()), true)
  coverage_lane_int(&mut out, "c3-graph-row-count",
    coverage_graph_row_count(graph.clone()), 6)
  coverage_lane_row(&mut out, "c4-tests-block-b0",
    tests_covering_block(&graph, b0.clone()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c5-tests-block-b1",
    tests_covering_block(&graph, b1.clone()),
    Vec::from(["m::test_b#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c6-tests-edge",
    tests_covering_edge(&graph, e01.clone()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c7-tests-contract-id",
    tests_covering_contract_id(&graph, coverage_lane_contract()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c8-tests-contract-fn",
    tests_covering_contract(&graph, "m::f#fn()->unit".to_string()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c9-tests-effect-site",
    tests_covering_effect_site(&graph, coverage_lane_effect()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c10-tests-effect-fn",
    tests_covering_effect(&graph, "m::f#fn()->unit".to_string()),
    Vec::from(["m::test_a#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c11-tests-symbol",
    tests_covering_symbol(&graph, "m::f#fn()->unit".to_string()),
    Vec::from([
      "m::test_a#fn()->unit".to_string(),
      "m::test_b#fn()->unit".to_string()
    ]))
  coverage_lane_row(&mut out, "c12-tests-unbound-blank",
    tests_covering_block(&graph, coverage_block_id_of("m::u#fn()->unit".to_string(), 0)),
    Vec::new())
  coverage_lane_row(&mut out, "c13-points-of-symbol",
    coverage_points_of_symbol(&graph, "m::f#fn()->unit".to_string()),
    Vec::from([
      b0.clone(),
      e01.clone(),
      b1.clone(),
      coverage_lane_contract(),
      coverage_lane_effect()
    ]))
  coverage_lane_row(&mut out, "c14-unbound-points",
    coverage_points_of_symbol(&graph, "m::u#fn()->unit".to_string()),
    Vec::from([coverage_block_id_of("m::u#fn()->unit".to_string(), 0)]))
  let tc_rows = coverage_test_coverage(ingested.clone())
  coverage_lane_int(&mut out, "c15-test-coverage-records", tc_rows.len(), 2)
  if tc_rows.len() == 2 then
    coverage_lane_row(&mut out, "c16-test-a-contracts",
      tc_rows[0].contracts.clone(), Vec::from([coverage_lane_contract()]))
    coverage_lane_row(&mut out, "c17-test-b-blocks",
      tc_rows[1].blocks.clone(), Vec::from([b1.clone()]))
  end
  # idempotence: a second ingest of the same trace adds no rows
  let ingested2 = coverage_ingest(ingested.clone(), trace.clone())
  coverage_lane_int(&mut out, "c18-ingest-idempotent",
    ingested2.coverage.len(), 6)

  # —— C2. the typed-keys ingest round trip (semantic ids) ——
  # The trace carries the fixture's SEMANTIC block/edge ids; the ingest
  # converts them ONCE into the typed records and the graph indexes them.
  # A lookup through the typed accessor and the parsed String form agree.
  let sem_trace = "test|m::test_s#fn()->unit\n" +
    "block|" + sb0.clone() + "\n" +
    "edge|" + sb0.clone() + "|" + sb1.clone() + "\n" +
    "contract|" + coverage_lane_contract() + "\n" +
    "effect|" + coverage_lane_effect() + "\n"
  let sem_ingested = coverage_ingest(coverage_lane_snapshot(), sem_trace.clone())
  coverage_lane_int(&mut out, "c19-semantic-row-count", sem_ingested.coverage.len(), 4)
  let sem_graph = coverage_graph_of_snapshot(sem_ingested.clone())
  coverage_lane_row(&mut out, "c20-semantic-block-roundtrip",
    tests_covering_block(&sem_graph, sb0.clone()),
    Vec::from(["m::test_s#fn()->unit".to_string()]))
  coverage_lane_row(&mut out, "c21-semantic-typed-block-lookup",
    tests_covering_block_of(&sem_graph, coverage_lane_gen_block(0)),
    Vec::from(["m::test_s#fn()->unit".to_string()]))
  var semantic_row_typed = false
  for r in sem_ingested.coverage do
    match r.block_id.clone()
    when Option::Some(b) then
      if b.semantic && stable_mir_block_key_is_semantic(&b.stable_key) then
        semantic_row_typed = true
      end
    when Option::None then ()
    end
  end
  coverage_lane_bool(&mut out, "c22-semantic-row-typed", semantic_row_typed, true)
  match stable_mir_semantic_edge_of_key(coverage_edge_id(sb0.clone(), sb1.clone(), "cf".to_string()))
  when Option::Some(se) then
    coverage_lane_row(&mut out, "c23-semantic-typed-edge-lookup",
      tests_covering_edge_of(&sem_graph, se),
      Vec::from(["m::test_s#fn()->unit".to_string()]))
  when Option::None then
    out.push("c23-semantic-edge-typed: expected Some, got None")
  end
  match stable_contract_of_key(coverage_lane_contract())
  when Option::Some(cid) then
    coverage_lane_row(&mut out, "c24-typed-contract-lookup",
      tests_covering_contract_id_of(&sem_graph, cid),
      Vec::from(["m::test_s#fn()->unit".to_string()]))
  when Option::None then
    out.push("c24-contract-typed: expected Some, got None")
  end
  match stable_effect_site_of_key(coverage_lane_effect())
  when Option::Some(sid) then
    coverage_lane_row(&mut out, "c25-typed-effect-site-lookup",
      tests_covering_effect_site_of(&sem_graph, sid),
      Vec::from(["m::test_s#fn()->unit".to_string()]))
  when Option::None then
    out.push("c25-effect-site-typed: expected Some, got None")
  end
  # The locator-keyed rows of section C and the semantic-keyed rows of C2
  # NEVER cross-map: the typed records differ.
  coverage_lane_bool(&mut out, "c26-locator-is-not-semantic",
    stable_mir_block_key_is_semantic(&b0.clone()), false)
  coverage_lane_bool(&mut out, "c27-semantic-is-semantic",
    stable_mir_block_key_is_semantic(&sb0.clone()), true)

  # —— D. uncovered_paths over the hand-built delta ——
  let lines = uncovered_paths(&graph, ingested.clone(), coverage_lane_delta())
  let expected_line = "uncovered:call:m::h#fn()->unit->m::k#fn()->unit:" +
    "no covering test: constraint m::h#fn()->unit#B?m::h#fn()->unit|m::k#fn()->unit|0"
  coverage_lane_row(&mut out, "d1-uncovered-call",
    lines, Vec::from([expected_line]))
  # a covered caller emits no line: f is covered by the trace (edge + blocks)
  coverage_lane_bool(&mut out, "d2-covered-caller",
    coverage_symbol_covered(&graph, "m::f#fn()->unit".to_string()), true)

  # —— E. the availability gate ——
  let empty_graph = coverage_graph_of_snapshot(coverage_lane_snapshot())
  coverage_lane_bool(&mut out, "e1-empty-graph",
    coverage_graph_has_rows(empty_graph.clone()), false)
  coverage_lane_int(&mut out, "e2-empty-row-count",
    coverage_graph_row_count(empty_graph), 0)

  # —— E2. the untracked-artifact results (audit order item 1) ——
  # Origin-less hand-built MIR: the persistent coverage builders return
  # the documented UntrackedArtifact result — no locator-keyed slots.
  let untracked_fn = coverage_lane_mir_fn_untracked()
  match coverage_table_of_mir_function(coverage_lane_fn_key(), untracked_fn.clone())
  when Result::Err(u) then
    coverage_lane_str(&mut out, "e3-untracked-table-api", u.api.clone(), "coverage-table")
    coverage_lane_bool(&mut out, "e4-untracked-table-text",
      untracked_artifact_text(u.clone()).starts_with("untracked-artifact:"), true)
  when Result::Ok(_) then
    out.push("e3-untracked-table: expected Err, got Ok")
  end
  match coverage_emission_plan_of_functions(Vec::from([untracked_fn.clone()]), "/tmp/tg.cov.untracked".to_string())
  when Result::Err(u2) then
    coverage_lane_str(&mut out, "e5-untracked-plan-api", u2.api.clone(), "coverage-table")
  when Result::Ok(_) then
    out.push("e5-untracked-plan: expected Err, got Ok")
  end
  match coverage_terminator_edges_semantic(coverage_lane_fn_key(), untracked_fn.blocks[0].clone(), untracked_fn.blocks.clone())
  when Result::Err(u3) then
    coverage_lane_str(&mut out, "e6-untracked-edges-api", u3.api.clone(), "coverage-edges")
  when Result::Ok(_) then
    out.push("e6-untracked-edges: expected Err, got Ok")
  end
  coverage_lane_bool(&mut out, "e7-tracked-edges-ok",
    match coverage_terminator_edges_semantic(coverage_lane_fn_key(), coverage_lane_mir_fn().blocks[0].clone(), coverage_lane_mir_fn().blocks.clone())
    when Result::Ok(_) then true
    when Result::Err(_) then false
    end, true)

  # —— E3. the legacy string-only point row (audit order item 1) ——
  # A row whose kind IS a point family but which carries no typed id (a
  # legacy artifact): the graph counts it untracked, answers NO point
  # lookup (never a locator), and keeps the fn-level test evidence.
  var legacy_snap = coverage_lane_snapshot()
  var legacy_rows: Vec[CoverageRelationship] = Vec::new()
  legacy_rows.push(CoverageRelationship {
    function: coverage_lane_sid(coverage_lane_fn_key()),
    branch_id: coverage_lane_block(0),
    arm_id: Option::None,
    kind: "Block".to_string(),
    test_id: "m::test_l#fn()->unit".to_string()
  })
  legacy_snap.coverage = legacy_rows
  let legacy_graph = coverage_graph_of_snapshot(legacy_snap)
  coverage_lane_int(&mut out, "e8-legacy-point-untracked",
    coverage_graph_untracked_point_rows(legacy_graph.clone()), 1)
  coverage_lane_row(&mut out, "e9-legacy-point-no-locator-lookup",
    tests_covering_block(&legacy_graph, coverage_lane_block(0)), Vec::new())
  coverage_lane_row(&mut out, "e10-legacy-point-fn-evidence",
    tests_covering_symbol(&legacy_graph, coverage_lane_fn_key()),
    Vec::from(["m::test_l#fn()->unit".to_string()]))

  # —— F. (audit order item 5) the discovery table + targeted verification ——
  # F1/F2: the TestRelationship rows (test -> exercised declaration) drive
  # the fn-level symbol index and build the runtime-name binding table.
  let disc = coverage_lane_discovery_snapshot()
  let disc_graph = coverage_graph_of_snapshot(disc.clone())
  coverage_lane_row(&mut out, "f1-discovery-drives-symbol-index",
    tests_covering_symbol(&disc_graph, "m::g#fn()->unit".to_string()),
    Vec::from(["m::test_b#fn()->unit|test@attr#test_b".to_string()]))
  coverage_lane_str(&mut out, "f2-name-to-stable-key",
    coverage_graph_test_key_of_name(disc_graph.clone(), "test_a".to_string()),
    "m::test_a#fn()->unit|test@attr#test_a")
  coverage_lane_int(&mut out, "f3-test-id-count",
    coverage_graph_test_ids(disc_graph.clone()).len(), 2)
  coverage_lane_row(&mut out, "f4-unknown-name-no-fabrication",
    tests_covering_symbol(&disc_graph, "m::missing#fn()->unit".to_string()), Vec::new())

  # F5: the raw trace binds the DECLARED name; the normalizer rewrites it
  # to the discovered stable key (and leaves unknown bindings alone).
  let stable_trace = coverage_trace_bind_stable(disc.clone(), coverage_lane_named_trace())
  coverage_lane_bool(&mut out, "f5-bind-normalized",
    stable_trace.contains("test|m::test_a#fn()->unit|test@attr#test_a"), true)
  coverage_lane_bool(&mut out, "f6-bind-unknown-kept",
    coverage_trace_bind_stable(disc.clone(), "test|nope\nblock|m::f#fn()->unit#B0\n").contains("test|nope"), true)

  # F7: an ingest of the RAW named trace answers through the graph with the
  # STABLE test key (the discovery-table normalization at read time).
  let named_ingested = coverage_ingest(disc.clone(), coverage_lane_named_trace())
  let named_graph = coverage_graph_of_snapshot(named_ingested.clone())
  coverage_lane_row(&mut out, "f7-ingest-resolves-test-key",
    tests_covering_symbol(&named_graph, "m::f#fn()->unit".to_string()),
    Vec::from(["m::test_a#fn()->unit|test@attr#test_a".to_string()]))

  # F8: the targeted verification: two affected-test requests (test_a for
  # f, test_b for g) plus the uncovered h -> k path constraint (no test).
  let targeted = test_targeted_for_delta(named_ingested.clone(), coverage_lane_targeted_delta())
  coverage_lane_int(&mut out, "f8-targeted-request-count", targeted.len(), 3)
  if targeted.len() == 3 then
    coverage_lane_str(&mut out, "f9-targeted-test-a-kind", targeted[0].kind.clone(), "affected-test")
    coverage_lane_str(&mut out, "f10-targeted-test-a",
      targeted[0].test.clone(), "m::test_a#fn()->unit|test@attr#test_a")
    coverage_lane_row(&mut out, "f11-targeted-test-a-symbols",
      targeted[0].symbols.clone(), Vec::from(["m::f#fn()->unit".to_string()]))
    coverage_lane_str(&mut out, "f12-targeted-test-b",
      targeted[1].test.clone(), "m::test_b#fn()->unit|test@attr#test_b")
    coverage_lane_str(&mut out, "f13-targeted-uncovered-kind", targeted[2].kind.clone(), "uncovered-path")
    coverage_lane_str(&mut out, "f14-targeted-uncovered-edge", targeted[2].edge_kind.clone(), "call")
    coverage_lane_str(&mut out, "f15-targeted-uncovered-constraint",
      targeted[2].constraint.clone(),
      "m::h#fn()->unit#B?m::h#fn()->unit|m::k#fn()->unit|0")
  end
  # The typed record list renders the SAME canonical lines uncovered_paths
  # always returned (the text/record consistency contract).
  let typed_lines = uncovered_paths(&named_graph, named_ingested.clone(), coverage_lane_targeted_delta())
  coverage_lane_row(&mut out, "f16-typed-records-render-lines",
    typed_lines,
    Vec::from(["uncovered:call:m::h#fn()->unit->m::k#fn()->unit:no covering test: constraint m::h#fn()->unit#B?m::h#fn()->unit|m::k#fn()->unit|0".to_string()]))

  # F17: the mutation kill mapping: declared names resolve through the
  # discovery table; an unmatched identifier lands in `unmapped`; a report
  # with no resolvable identifier is Unavailable (never fabricated).
  let kill = mutation_kill_mapping(disc.clone(), "mut-lane".to_string(),
    Vec::from(["canary-neg".to_string()]),
    Vec::from(["test_b".to_string(), "not_a_test".to_string()]))
  coverage_lane_str(&mut out, "f17-mutation-status", kill.status.clone(), "Mapped")
  coverage_lane_str(&mut out, "f17b-mutation-revision",
    kill.revision.clone(), semantic_digest_render(&disc.revision))
  coverage_lane_row(&mut out, "f18-mutation-killing-tests",
    kill.killing_tests.clone(), Vec::from(["m::test_b#fn()->unit|test@attr#test_b".to_string()]))
  coverage_lane_str(&mut out, "f18b-mutation-killing-test-id",
    if kill.killing_test_ids.len() == 1 then kill.killing_test_ids[0].stable_key.clone() else "".to_string() end,
    "m::test_b#fn()->unit|test@attr#test_b")
  coverage_lane_row(&mut out, "f19-mutation-unmapped",
    kill.unmapped.clone(), Vec::from(["not_a_test".to_string()]))
  let kill_none = mutation_kill_mapping(disc.clone(), "mut-lane-2".to_string(),
    Vec::new(), Vec::from(["also_missing".to_string()]))
  coverage_lane_str(&mut out, "f20-mutation-unavailable", kill_none.status.clone(), "Unavailable")
  coverage_lane_row(&mut out, "f21-mutation-unavailable-empty", kill_none.killing_tests.clone(), Vec::new())

  # F22: the per-suite identifier contract (audit order item 5 closeout):
  # the harness passes one identifier per failed suite (the declared
  # name) plus the suite context; BOTH suites' names resolve, the crash
  # marker does NOT (it is not a test identity — `unmapped`, never a
  # fabricated discovery row).
  let kill_suites = mutation_kill_mapping(disc.clone(), "mut-lane-3".to_string(),
    Vec::from(["verifier".to_string(), "layout".to_string()]),
    Vec::from(["test_a".to_string(), "test_b".to_string(), "canary-neg:crash".to_string()]))
  coverage_lane_str(&mut out, "f22-multi-suite-status", kill_suites.status.clone(), "Mapped")
  coverage_lane_row(&mut out, "f23-multi-suite-killing-tests",
    kill_suites.killing_tests.clone(),
    Vec::from([
      "m::test_a#fn()->unit|test@attr#test_a".to_string(),
      "m::test_b#fn()->unit|test@attr#test_b".to_string()
    ]))
  coverage_lane_int(&mut out, "f24-multi-suite-killing-ids",
    kill_suites.killing_test_ids.len(), 2)
  coverage_lane_row(&mut out, "f25-crash-marker-unmapped",
    kill_suites.unmapped.clone(), Vec::from(["canary-neg:crash".to_string()]))
  # A crash marker ALONE maps nothing (honest Unavailable, never a
  # fabricated identity).
  let kill_crash = mutation_kill_mapping(disc.clone(), "mut-lane-4".to_string(),
    Vec::from(["build".to_string()]), Vec::from(["build".to_string()]))
  coverage_lane_str(&mut out, "f26-build-marker-unavailable", kill_crash.status.clone(), "Unavailable")
  coverage_lane_row(&mut out, "f27-build-marker-unmapped",
    kill_crash.unmapped.clone(), Vec::from(["build".to_string()]))

  out
end

# ———————————————————————————————————————————————————————————————
# 9. The emission lane (third-audit item 34 — the runtime producer)
# ———————————————————————————————————————————————————————————————
# Rows over the compile-time emission plan (the counter table attach) and
# the dump writer contract (coverage_trace_render over a synthetic count
# array). Empty = the lane verifies.

def coverage_emission_lane_str(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected.clone() then
    out.push(name + ": expected [" + expected + "], got [" + got + "]")
  end
  ()
end

pub def coverage_emission_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # The lane's shared fixtures (section A's locator grammar fixtures plus
  # the origin-stamped fixture's semantic keys).
  let b0 = coverage_lane_block(0)
  let e01 = coverage_lane_edge()
  let sb0 = coverage_lane_fn_block_key(0)
  let sb1 = coverage_lane_fn_block_key(1)
  let sb3 = coverage_lane_fn_block_key(3)

  # —— A. the plan: one function's table attached at base 0 ——
  var fns: Vec[MirFunction] = Vec::new()
  fns.push(coverage_lane_mir_fn())
  let plan = match coverage_emission_plan_of_functions(fns, "/tmp/tg.cov.trace".to_string())
  when Result::Ok(p) then p
  when Result::Err(u) then
    out.push("f0-plan-untracked: unexpected " + untracked_artifact_text(u))
    coverage_emission_plan_disabled()
  end
  coverage_lane_bool(&mut out, "f1-plan-enabled", plan.enabled, true)
  coverage_lane_int(&mut out, "f2-plan-total", plan.total, 8)
  coverage_lane_int(&mut out, "f3-plan-fn-count", plan.functions.len(), 1)
  coverage_lane_int(&mut out, "f4-plan-row-count", plan.rows.len(), 8)
  if plan.functions.len() == 1 then
    let fp = plan.functions[0].clone()
    coverage_lane_int(&mut out, "f5-fn-base", fp.base, 0)
    coverage_lane_int(&mut out, "f6-fn-counters",
      coverage_table_counter_count(fp.table.clone()), 8)
    coverage_lane_bool(&mut out, "f7-fn-key",
      fp.fn_key == "m::f#fn()->unit".to_string(), true)
  end
  match coverage_plan_fn_of(plan.clone(), "m::f#fn()->unit".to_string())
  when Option::Some(fp2) then
    coverage_lane_int(&mut out, "f8-fn-lookup-base", fp2.base, 0)
  when Option::None then
    out.push("f8-fn-lookup: expected Some, got None")
  end
  match coverage_plan_fn_of(plan.clone(), "m::missing#fn()->unit".to_string())
  when Option::None then ()
  when Option::Some(_) then
    out.push("f9-fn-lookup-missing: expected None, got Some")
  end
  if plan.rows.len() == 8 then
    coverage_lane_str(&mut out, "f10-row-block-b0",
      plan.rows[0].clone(), "block|" + sb0.clone())
    coverage_lane_str(&mut out, "f11-row-edge-switch",
      plan.rows[4].clone(),
      "edge|" + sb0.clone() + "|" + sb1.clone() + "|switch")
    coverage_lane_str(&mut out, "f12-row-edge-goto",
      plan.rows[6].clone(),
      "edge|" + sb1.clone() + "|" + sb3.clone() + "|goto")
  end
  coverage_lane_bool(&mut out, "f13-table-text-header",
    plan.table_text.starts_with("coverage-table|tg.cov.v1|m::f#fn()->unit"), true)
  coverage_lane_bool(&mut out, "f14-table-text-entry",
    plan.table_text.contains("entry|4|edge|" + sb0.clone() + "|>" + sb1.clone() + "|switch"), true)
  coverage_lane_bool(&mut out, "f15-plan-path",
    plan.out_path == "/tmp/tg.cov.trace".to_string(), true)

  # —— B. the dump writer over a synthetic counter array ——
  # counts: blocks B0 and B3 reached, edge B1->B3 traversed twice.
  let table = match coverage_table_of_mir_function("m::f#fn()->unit".to_string(), coverage_lane_mir_fn())
  when Result::Ok(t) then t
  when Result::Err(u2) then
    out.push("f15b-table-untracked: unexpected " + untracked_artifact_text(u2))
    CoverageTable { function_key: "m::f#fn()->unit".to_string() }
  end
  let counts = Vec::from([2, 0, 0, 1, 0, 0, 3, 0])
  let trace_text = coverage_trace_render(table.clone(), counts, "m::test_a#fn()->unit".to_string())
  let expected_trace = "tg.cov.trace.v1\n" +
    "test|m::test_a#fn()->unit\n" +
    "block|" + sb0.clone() + "\n" +
    "block|" + sb3.clone() + "\n" +
    "edge|" + sb1.clone() + "|" + sb3.clone() + "|goto\n"
  coverage_lane_str(&mut out, "f16-dump-render", trace_text, expected_trace)
  # the rendered trace ingests to exactly three bound rows
  let ingested = coverage_ingest(coverage_lane_snapshot(), trace_text.clone())
  coverage_lane_int(&mut out, "f17-dump-ingest-rows", ingested.coverage.len(), 3)
  # zero counts -> header only (no rows, no bind when the test key is empty)
  coverage_lane_str(&mut out, "f18-dump-empty",
    coverage_trace_render(table.clone(), Vec::new(), "".to_string()),
    "tg.cov.trace.v1\n")
  # the row renderer per family
  coverage_lane_str(&mut out, "f19-row-text-block",
    coverage_trace_row_text("block".to_string(), b0.clone()),
    "block|m::f#fn()->unit#B0")
  coverage_lane_str(&mut out, "f20-row-text-edge",
    coverage_trace_row_text("edge".to_string(), e01.clone()),
    "edge|m::f#fn()->unit#B0|m::f#fn()->unit#B1|cf")
  coverage_lane_str(&mut out, "f21-row-text-contract",
    coverage_trace_row_text("contract".to_string(), coverage_lane_contract()),
    "contract|m::f#fn()->unit|Pre|result > 0")
  coverage_lane_str(&mut out, "f22-row-text-effect",
    coverage_trace_row_text("effect".to_string(), coverage_lane_effect()),
    "effect|m::f#fn()->unit|effect@io#0")
  coverage_lane_str(&mut out, "f23-row-text-bad-edge",
    coverage_trace_row_text("edge".to_string(), "not-an-edge".to_string()),
    "")

  # —— C. the disabled plan carries nothing ——
  let off = coverage_emission_plan_disabled()
  coverage_lane_bool(&mut out, "f24-disabled-plan", off.enabled, false)
  coverage_lane_int(&mut out, "f25-disabled-total", off.total, 0)
  coverage_lane_int(&mut out, "f26-disabled-fns", off.functions.len(), 0)
  match coverage_plan_fn_of(off, "m::f#fn()->unit".to_string())
  when Option::None then ()
  when Option::Some(_) then
    out.push("f27-disabled-lookup: expected None, got Some")
  end

  out
end

# ———————————————————————————————————————————————————————————————
# (fourth-audit P0-8) The semantic re-key lane
# ———————————————————————————————————————————————————————————————
# Rows asserted by coverage_semantic_rekey_lane_check:
#   R1 a block's coverage id IS its P0-7 control-origin stable key (the
#      locator "#B<ordinal>" is not the identity);
#   R2 an edge id composes the two blocks' semantic keys;
#   R3 inserting a block before the original ones leaves their semantic
#      coverage ids UNCHANGED (only the locators shift);
#   R4 the emission plan's block_keys map (the ids the LIR route carries)
#      carries the same semantic keys;
#   R5 the rendered trace/table text carries the semantic ids.

def coverage_lane_fn_with_origins(name: String, block_origins: Vec[StableMirBlockId], term_origin: StableMirNodeId) -> MirFunction
  var blocks: Vec[MirBlock] = Vec::new()
  var bi = 0
  while bi < block_origins.len() do
    let term = if bi + 1 < block_origins.len() then
      MirTerminator {
        kind: MirTerminatorKind::MirGoto(MirBlockId { id: bi + 1 }),
        span: span_dummy(),
        origin: Option::Some(term_origin.clone())
      }
    else
      MirTerminator {
        kind: MirTerminatorKind::MirReturn,
        span: span_dummy(),
        origin: Option::Some(term_origin.clone())
      }
    end
    blocks.push(MirBlock {
      id: MirBlockId { id: bi },
      statements: Vec::new(),
      terminator: term,
      origin: Option::Some(block_origins[bi].clone())
    })
    bi = bi + 1
  end
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(MirLocal {
    id: MirLocalId { id: 0 },
    name: "_ret".to_string(),
    ty: Type::Unit,
    is_mut: false,
    span: span_dummy()
  })
  MirFunction {
    name: name,
    params: Vec::new(),
    ret_type: Type::Unit,
    locals: locals,
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span_dummy()
  }
end

pub def coverage_semantic_rekey_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let fn_key = "m::rekey#fn()->unit".to_string()
  let owner = stable_decl_of_key(&fn_key)
  let hir0 = stable_hir_node_id_of(owner.clone(), 11)
  let hir1 = stable_hir_node_id_of(owner.clone(), 22)
  let orig0 = stable_mir_node_id_of_source(fn_key.clone(), hir0.clone(), "goto".to_string())
  let orig1 = stable_mir_node_id_of_source(fn_key.clone(), hir1.clone(), "return".to_string())
  let bkey0 = stable_mir_block_id_of_node(orig0.clone()).stable_key.clone()
  let bkey1 = stable_mir_block_id_of_node(orig1.clone()).stable_key.clone()

  var origins_a: Vec[StableMirBlockId] = Vec::new()
  origins_a.push(stable_mir_block_id_of_node(orig0.clone()))
  origins_a.push(stable_mir_block_id_of_node(orig1.clone()))
  let f_a = coverage_lane_fn_with_origins(fn_key.clone(), origins_a, orig0.clone())

  # R1: the coverage block id is the semantic key, never the locator.
  coverage_lane_str(&mut out, "R1-block-semantic-id", coverage_lane_key_of(fn_key.clone(), f_a.blocks[0].clone()), bkey0.clone())
  coverage_lane_bool(&mut out, "R1-block-not-locator", coverage_lane_key_of(fn_key.clone(), f_a.blocks[0].clone()) == coverage_block_id_of(fn_key.clone(), 0), false)

  # R2: the edge id composes the two semantic keys.
  let edges = match coverage_terminator_edges_semantic(fn_key.clone(), f_a.blocks[0].clone(), f_a.blocks.clone())
  when Result::Ok(es) then es
  when Result::Err(u) then
    out.push("R2-edges-untracked: unexpected " + untracked_artifact_text(u))
    Vec::new()
  end
  coverage_lane_int(&mut out, "R2-edge-count", edges.len(), 1)
  if edges.len() == 1 then
    coverage_lane_str(&mut out, "R2-edge-from", edges[0].from.clone(), bkey0.clone())
    coverage_lane_str(&mut out, "R2-edge-to", edges[0].to.clone(), bkey1.clone())
    coverage_lane_str(&mut out, "R2-edge-id", coverage_edge_id(edges[0].from.clone(), edges[0].to.clone(), edges[0].kind.clone()),
      bkey0.clone() + "|>" + bkey1.clone() + "|goto")
  end

  # The table keys the semantic ids.
  let table_a = match coverage_table_of_mir_function(fn_key.clone(), f_a.clone())
  when Result::Ok(t) then t
  when Result::Err(u) then
    out.push("R2-table-untracked: unexpected " + untracked_artifact_text(u))
    CoverageTable { function_key: fn_key.clone() }
  end
  let ekey_a = coverage_edge_id(bkey0.clone(), bkey1.clone(), "goto".to_string())
  coverage_lane_bool(&mut out, "R2-table-has-semantic-block", table_a.block_counters.contains_key(bkey0.clone()), true)
  coverage_lane_bool(&mut out, "R2-table-has-semantic-edge", table_a.edge_counters.contains_key(ekey_a.clone()), true)

  # R4: the emission plan (the LIR route's carrier) maps dense ids to the
  # same semantic keys.
  let plan = match coverage_emission_plan_of_functions(Vec::from([f_a.clone()]), "/tmp/x.cov".to_string())
  when Result::Ok(p) then p
  when Result::Err(u) then
    out.push("R4-plan-untracked: unexpected " + untracked_artifact_text(u))
    coverage_emission_plan_disabled()
  end
  coverage_lane_int(&mut out, "R4-plan-fns", plan.functions.len(), 1)
  if plan.functions.len() == 1 then
    match plan.functions[0].block_keys.get(0)
    when Option::Some(k) then coverage_lane_str(&mut out, "R4-plan-block0-key", k.clone(), bkey0.clone())
    when Option::None then out.push("R4-plan-block0-key: missing")
    end
  end

  # R5: the rendered trace row carries the semantic id.
  coverage_lane_str(&mut out, "R5-row-text", coverage_trace_row_text("block".to_string(), bkey0.clone()), "block|" + bkey0.clone())

  # R3: insert a NEW block before the originals (renumbering them): their
  # origins — and therefore their coverage ids — are unchanged.
  let orig_new = stable_mir_node_id_of_source(fn_key.clone(), stable_hir_node_id_of(owner.clone(), 33), "goto".to_string())
  var origins_b: Vec[StableMirBlockId] = Vec::new()
  origins_b.push(stable_mir_block_id_of_node(orig_new))
  origins_b.push(stable_mir_block_id_of_node(orig0.clone()))
  origins_b.push(stable_mir_block_id_of_node(orig1.clone()))
  let f_b = coverage_lane_fn_with_origins(fn_key.clone(), origins_b, orig0.clone())
  coverage_lane_str(&mut out, "R3-inserted-block-semantic-id", coverage_lane_key_of(fn_key.clone(), f_b.blocks[1].clone()), bkey0.clone())
  coverage_lane_str(&mut out, "R3-original-return-semantic-id", coverage_lane_key_of(fn_key.clone(), f_b.blocks[2].clone()), bkey1.clone())
  let table_b = match coverage_table_of_mir_function(fn_key.clone(), f_b.clone())
  when Result::Ok(t) then t
  when Result::Err(u) then
    out.push("R3-table-untracked: unexpected " + untracked_artifact_text(u))
    CoverageTable { function_key: fn_key.clone() }
  end
  coverage_lane_bool(&mut out, "R3-table-still-has-original-block", table_b.block_counters.contains_key(bkey0.clone()), true)
  coverage_lane_bool(&mut out, "R3-table-still-has-original-return", table_b.block_counters.contains_key(bkey1.clone()), true)

  # R6 (audit order item 1): the SAME body with its origins removed is an
  # untracked artifact — every persistent builder reports it instead of
  # falling back to the locators.
  var originless_blocks: Vec[MirBlock] = Vec::new()
  for b in f_a.blocks do
    var nb = b.clone()
    nb.origin = Option::None
    nb.terminator.origin = Option::None
    originless_blocks.push(nb)
  end
  let f_untracked_base = coverage_lane_fn_with_origins(fn_key.clone(), Vec::new(), orig0.clone())
  var f_untracked = f_untracked_base
  f_untracked.blocks = originless_blocks
  match coverage_block_key_of_block(fn_key.clone(), f_untracked.blocks[0].clone())
  when Option::None then ()
  when Option::Some(_) then
    out.push("R6-originless-block: expected None, got Some")
  end
  match coverage_table_of_mir_function(fn_key.clone(), f_untracked.clone())
  when Result::Err(u) then
    coverage_lane_str(&mut out, "R6-untracked-table-api", u.api.clone(), "coverage-table")
  when Result::Ok(_) then
    out.push("R6-untracked-table: expected Err, got Ok")
  end

  out
end

# The lane's Option-unwrapping block key ("" for an origin-less block —
# only used for mismatch rendering).
def coverage_lane_key_of(fn_key: String, block: MirBlock) -> String
  match coverage_block_key_of_block(fn_key, block)
  when Option::Some(k) then k
  when Option::None then "".to_string()
  end
end
