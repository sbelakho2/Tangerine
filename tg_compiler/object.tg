## Tangerine Compiler — Object File Generation
## Self-hosting compiler written in Tangerine
##
## Emits native object files directly — no external assembler needed.
## Supports:
##   ELF64  (Linux x86-64, Linux AArch64)
##   Mach-O 64 (macOS x86-64, macOS AArch64 / Apple Silicon)
##   COFF / PE (Windows x86-64)
##
## NO dependency on any other language.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}
use tg_compiler::asm::{
  CodeBuffer, AsmSymbol, Relocation, RelocKind,
  Section, SymBinding, SymKind,
  buf_pos, emit8, emit16_le, emit32_le, emit64_le,
  Arch, OsAbi, AsmTarget
}

# ———————————————————————————————————————————————————————————————
# Object file builder
# ———————————————————————————————————————————————————————————————

struct ObjectFile
target: AsmTarget
  text: Vec[u8]
  data: Vec[u8]
  rodata: Vec[u8]
  bss_size: Int
  symbols: Vec[AsmSymbol]
  relocations: Vec[Relocation]
  data_relocations: Vec[Relocation]
  string_table: Vec[u8]
  strings: Map[String, Int]
end

struct ResolvedSymbol
  name: String
  value: u64
  section: Int
  is_defined: Bool
end

def object_new(target: AsmTarget) -> ObjectFile
  var strtab = Vec::new()
  strtab.push(0)   # first byte is NUL
  ObjectFile {
    target: target,
    text: Vec::new(),
    data: Vec::new(),
    rodata: Vec::new(),
    bss_size: 0,
    symbols: Vec::new(),
    relocations: Vec::new(),
    data_relocations: Vec::new(),
    string_table: strtab,
    strings: Map::new()
  }
end

def object_text_len(obj: ObjectFile) -> Int
  obj.text.len()
end

def object_data_len(obj: ObjectFile) -> Int
  obj.data.len()
end

def object_rodata_len(obj: ObjectFile) -> Int
  obj.rodata.len()
end

def object_text_clone(obj: ObjectFile) -> Vec[u8]
  obj.text.clone()
end

def object_data_clone(obj: ObjectFile) -> Vec[u8]
  obj.data.clone()
end

def object_rodata_clone(obj: ObjectFile) -> Vec[u8]
  obj.rodata.clone()
end

def object_bss_size(obj: ObjectFile) -> Int
  obj.bss_size
end

def object_symbols_clone(obj: ObjectFile) -> Vec[AsmSymbol]
  obj.symbols.clone()
end

def object_symbols_len(obj: ObjectFile) -> Int
  obj.symbols.len()
end

def object_symbol_at(obj: ObjectFile, index: Int) -> AsmSymbol
  obj.symbols[index]
end

def object_symbol_get(obj: ObjectFile, index: Int) -> Option[AsmSymbol]
  obj.symbols.get(index)
end

def object_relocations_clone(obj: ObjectFile) -> Vec[Relocation]
  obj.relocations.clone()
end

def object_relocations_len(obj: ObjectFile) -> Int
  obj.relocations.len()
end

# ———————————————————————————————————————————————————————————————
# ObjectFile integrity validation
# ———————————————————————————————————————————————————————————————

# Validate an ObjectFile before linking: target match, section bounds for every
# symbol and relocation, duplicate global symbols, undefined symbols classified
# as extern, and the presence of the entry symbol. Returns an error string on
# the first structural problem found.
def validate_object_file(obj: ObjectFile, target: AsmTarget, entry: String) -> Result[Unit, String]
  if obj.target != target then
    return Result::Err("object target mismatch: expected " + format_target(target) + " got " + format_target(obj.target))
  end

  let text_len = object_text_len(obj)
  let data_len = object_data_len(obj)
  let rodata_len = object_rodata_len(obj)
  let bss_size = object_bss_size(obj)

  # Duplicate global detection
  var globals: Vec[String] = Vec::new()
  var entry_found = false
  var si = 0
  let syms = object_symbols_clone(obj)
  while si < syms.len() do
    let s = syms[si]
    if s.binding == SymBinding::Global then
      if vec_contains_string(&globals, s.name.clone()) then
        return Result::Err("duplicate global symbol: " + s.name)
      end
      globals.push(s.name.clone())
      if !entry.is_empty() && s.name == entry then
        entry_found = true
      end
    end
    # Section bounds for defined symbols
    match s.section
    when Section::Text then
      if s.offset < 0 || s.offset > text_len then
        return Result::Err("symbol " + s.name + " text offset out of range")
      end
    when Section::Data then
      if s.offset < 0 || s.offset > data_len then
        return Result::Err("symbol " + s.name + " data offset out of range")
      end
    when Section::Rodata then
      if s.offset < 0 || s.offset > rodata_len then
        return Result::Err("symbol " + s.name + " rodata offset out of range")
      end
    when Section::Bss then
      if s.offset < 0 || s.offset > bss_size then
        return Result::Err("symbol " + s.name + " bss offset out of range")
      end
    when Section::Extern then
      # Undefined symbols must be explicitly classified as extern.
      ()
    end
    si = si + 1
  end

  if !entry.is_empty() && !entry_found then
    return Result::Err("entry symbol not found: " + entry)
  end

  # Relocation offsets must lie within the code/data section sizes, WIDTH-
  # AWARE (the reviewer's item 13): a relocation PATCHES `width` bytes at
  # its offset, so the last legal site is len - width — an offset == len
  # or an offset in (len - width, len) would make the patch write past the
  # section. The addition is OVERFLOW-SAFE by subtraction (width > len -
  # offset, with offset <= len guaranteeing a non-negative difference —
  # never offset + width, which could wrap).
  let relocs = object_relocations_clone(obj)
  var ri = 0
  while ri < relocs.len() do
    let r = relocs[ri]
    let rwidth = relocation_patch_width(&r.kind)
    if !relocation_fits_section(&r.offset, rwidth, text_len) then
      return Result::Err("relocation offset out of text range for symbol " + r.symbol + " (offset " + r.offset.to_string() + " + patch width " + rwidth.to_string() + " exceeds text length " + text_len.to_string() + ")")
    end
    # (item 13 — the unknown-symbol class): every relocation must name a
    # symbol the object actually carries (a defined symbol in some section
    # or an explicitly classified extern). A relocation for a symbol the
    # object never declares is a structural corruption — fail closed, the
    # linker never guesses a target for it.
    var reloc_sym_known = false
    var si2 = 0
    let syms2 = object_symbols_clone(obj)
    while si2 < syms2.len() do
      if syms2[si2].name == r.symbol then reloc_sym_known = true end
      si2 = si2 + 1
    end
    if !reloc_sym_known then
      return Result::Err("relocation names unknown symbol " + r.symbol + " (no symbol table entry carries it)")
    end
    ri = ri + 1
  end
  var ddi = 0
  let drelocs = object_data_relocations_clone(obj)
  while ddi < drelocs.len() do
    let dr = drelocs[ddi]
    let drwidth = relocation_patch_width(&dr.kind)
    if !relocation_fits_section(&dr.offset, drwidth, data_len) then
      return Result::Err("data relocation offset out of data range for symbol " + dr.symbol + " (offset " + dr.offset.to_string() + " + patch width " + drwidth.to_string() + " exceeds data length " + data_len.to_string() + ")")
    end
    var dr_sym_known = false
    var di3 = 0
    let dsyms = object_symbols_clone(obj)
    while di3 < dsyms.len() do
      if dsyms[di3].name == dr.symbol then dr_sym_known = true end
      di3 = di3 + 1
    end
    if !dr_sym_known then
      return Result::Err("data relocation names unknown symbol " + dr.symbol + " (no symbol table entry carries it)")
    end
    ddi = ddi + 1
  end

  # (item 13 — the AArch64 ADRP/ADD pair invariants): the ADRP/ADD address
  # materialization is a PAIR — the ADR_PREL_PG_HI21 (page-relative) at
  # offset O and its ADD_ABS_LO12_NC (lo12) immediately after it at O + 4,
  # BOTH for the same symbol. A page relocation without its lo12 partner
  # (or with a partner for a different symbol) leaves the address
  # computation with the wrong low bits — a silent corruption class. The
  # Mach-O output maps these to the ARM64_RELOC_PAGE21 / PAGEOFF12 pair,
  # which is validated under the same rule.
  match obj.target.arch
  when Arch::AArch64 then
    match validate_aarch64_adrp_add_pairs(&relocs)
    when Option::Some(pair_err) then
      return Result::Err(pair_err)
    when Option::None then ()
    end
  when _ then ()
  end

  Result::Ok(())
end

# The patch width (bytes) of a relocation kind: 8 for the absolute-64
# kinds, 4 for every instruction-word / 32-bit kind. A kind outside the
# known table is treated as 4 (the widest known instruction relocation);
# the width only ever makes the bounds check STRICTER (fail closed).
def relocation_patch_width(kind: RelocKind) -> Int
  match kind
  when RelocKind::R_X86_64_64 then 8
  when RelocKind::R_AARCH64_ABS64 then 8
  when _ then 4
  end
end

# Overflow-safe membership of the patch [offset, offset + width) in a
# section of `len` bytes: offset must be non-negative, offset <= len, and
# width <= len - offset (the subtraction cannot underflow once offset <=
# len; no offset + width addition is ever performed).
def relocation_fits_section(offset: Int, width: Int, len: Int) -> Bool
  if offset < 0 then
    false
  elsif width < 0 then
    false
  elsif offset > len then
    false
  elsif width > len - offset then
    false
  else
    true
  end
end

# The AArch64 ADRP/ADD pair invariant over ONE object's text relocations.
# Returns Some(error) on the first violation:
#   - an ADR_PREL_PG_HI21 (or ARM64_RELOC_PAGE21) at offset O must be
#     followed by the matching lo12 relocation (ADD_ABS_LO12_NC /
#     ARM64_RELOC_PAGEOFF12) at O + 4 naming the SAME symbol;
#   - an ADD_ABS_LO12_NC (or ARM64_RELOC_PAGEOFF12) at offset O must be
#     preceded by the matching page relocation at O - 4 naming the SAME
#     symbol.
# The relocations of one object are emitted in offset order by codegen, so
# index adjacency mirrors offset adjacency; the exact offset delta is
# still checked (a pair split by an unrelated relocation is a violation).
def validate_aarch64_adrp_add_pairs(relocs: Vec[Relocation]) -> Option[String]
  var i = 0
  while i < relocs.len() do
    let r = relocs[i]
    let is_adrp = match r.kind
    when RelocKind::R_AARCH64_ADR_PREL_PG_HI21 then true
    when RelocKind::ARM64_RELOC_PAGE21 then true
    when _ then false
    end
    let is_lo12 = match r.kind
    when RelocKind::R_AARCH64_ADD_ABS_LO12_NC then true
    when RelocKind::ARM64_RELOC_PAGEOFF12 then true
    when _ then false
    end
    if is_adrp then
      if i + 1 >= relocs.len() then
        return Option::Some("AArch64 ADRP relocation at offset " + r.offset.to_string() + " for symbol " + r.symbol.clone() + " has no lo12 partner (the ADRP/ADD pair is incomplete)")
      end
      let nxt = relocs[i + 1]
      let nxt_is_lo12 = match nxt.kind
      when RelocKind::R_AARCH64_ADD_ABS_LO12_NC then true
      when RelocKind::ARM64_RELOC_PAGEOFF12 then true
      when _ then false
      end
      if !nxt_is_lo12 then
        return Option::Some("AArch64 ADRP relocation at offset " + r.offset.to_string() + " for symbol " + r.symbol.clone() + " is not followed by a lo12 relocation (the ADRP/ADD pair is broken by an unrelated relocation)")
      end
      if nxt.offset != r.offset + 4 then
        return Option::Some("AArch64 ADRP/ADD pair offset invariant violated: ADRP at offset " + r.offset.to_string() + " is paired with its lo12 at offset " + nxt.offset.to_string() + " (expected " + (r.offset + 4).to_string() + ")")
      end
      if nxt.symbol != r.symbol then
        return Option::Some("AArch64 ADRP/ADD pair symbol invariant violated: ADRP at offset " + r.offset.to_string() + " names symbol " + r.symbol.clone() + " but its lo12 partner names " + nxt.symbol.clone())
      end
      i = i + 1
    elsif is_lo12 then
      if i - 1 < 0 then
        return Option::Some("AArch64 lo12 relocation at offset " + r.offset.to_string() + " for symbol " + r.symbol.clone() + " has no preceding ADRP (the ADRP/ADD pair is incomplete)")
      end
      let prv = relocs[i - 1]
      let prv_is_adrp = match prv.kind
      when RelocKind::R_AARCH64_ADR_PREL_PG_HI21 then true
      when RelocKind::ARM64_RELOC_PAGE21 then true
      when _ then false
      end
      if !prv_is_adrp then
        return Option::Some("AArch64 lo12 relocation at offset " + r.offset.to_string() + " for symbol " + r.symbol.clone() + " is not preceded by an ADRP relocation (the ADRP/ADD pair is broken by an unrelated relocation)")
      end
      if r.offset != prv.offset + 4 then
        return Option::Some("AArch64 ADRP/ADD pair offset invariant violated: lo12 at offset " + r.offset.to_string() + " is paired with its ADRP at offset " + prv.offset.to_string() + " (expected " + (prv.offset + 4).to_string() + ")")
      end
      if r.symbol != prv.symbol then
        return Option::Some("AArch64 ADRP/ADD pair symbol invariant violated: lo12 at offset " + r.offset.to_string() + " names symbol " + r.symbol.clone() + " but its ADRP partner names " + prv.symbol.clone())
      end
    end
    i = i + 1
  end
  Option::None
end

def format_target(t: AsmTarget) -> String
  let arch = match t.arch
  when Arch::X86_64 then "x86_64"
  when Arch::AArch64 then "aarch64"
  when _ then "unknown"
  end
  let os = match t.os
  when OsAbi::Linux then "linux"
  when OsAbi::MacOS then "macos"
  when OsAbi::Windows then "windows"
  when _ then "unknown"
  end
  arch + "-" + os
end

def vec_contains_string(v: Vec[String], s: String) -> Bool
  var i = 0
  while i < v.len() do
    if v[i] == s then return true end
    i = i + 1
  end
  false
end

def object_relocation_at(obj: ObjectFile, index: Int) -> Relocation
  obj.relocations[index]
end

def object_relocation_get(obj: ObjectFile, index: Int) -> Option[Relocation]
  obj.relocations.get(index)
end

def object_data_relocations_clone(obj: ObjectFile) -> Vec[Relocation]
  obj.data_relocations.clone()
end

def object_string_eq(a: String, b: String) -> Bool
  let a_len = a.len()
  let b_len = b.len()
  if a_len != b_len then
    return false
  end

  var i = 0
  while i < a_len do
    if a.char_at(i) != b.char_at(i) then
      return false
    end
    i = i + 1
  end
  true
end

def object_defined_symbol_offset(obj: ObjectFile, name: String) -> Option[u64]
  for sym in obj.symbols do
    let is_extern = sym.size == 0 && sym.offset == 0 && sym.section != Section::Text && sym.section != Section::Data && sym.section != Section::Rodata && sym.section != Section::Bss
    if !is_extern then
      let sym_name = sym.name.clone()
      if object_string_eq(&sym_name, name) then
        return Option::Some(sym.offset as u64)
      end
    end
  end
  Option::None
end

def object_shifted_relocations_clone(obj: ObjectFile, base: Int) -> Vec[Relocation]
  var shifted = Vec::new()
  let rels = obj.relocations.clone()
  for rel in rels do
    shifted.push(Relocation {
      offset: rel.offset + base,
      kind: rel.kind,
      symbol: rel.symbol.clone(),
      addend: rel.addend
    })
  end
  shifted
end

def object_shifted_data_relocations_clone(obj: ObjectFile, data_base: Int) -> Vec[Relocation]
  var shifted = Vec::new()
  let rels = obj.data_relocations.clone()
  for rel in rels do
    shifted.push(Relocation {
      offset: rel.offset + data_base,
      kind: rel.kind,
      symbol: rel.symbol.clone(),
      addend: rel.addend
    })
  end
  shifted
end

def object_resolve_symbols(obj: ObjectFile) -> Map[String, ResolvedSymbol]
  var syms = Map::new()
  var extern_syms = Vec::new()

  for sym in obj.symbols do
    let is_extern = sym.size == 0 && sym.offset == 0 && sym.section != Section::Text && sym.section != Section::Data && sym.section != Section::Rodata && sym.section != Section::Bss

    if is_extern then
      extern_syms.push(sym.name.clone())
    else
      let sec_idx = match sym.section
      when Section::Text   then 0
      when Section::Data   then 2
      when Section::Rodata then 1
      when Section::Bss    then 3
      when _               then 0
      end
      syms.insert(sym.name.clone(), ResolvedSymbol {
        name: sym.name.clone(),
        value: sym.offset as u64,
        section: sec_idx,
        is_defined: true
      })
    end
  end

  for ext_name in extern_syms do
    if !syms.contains_key(&ext_name) then
      syms.insert(ext_name.clone(), ResolvedSymbol {
        name: ext_name.clone(),
        value: 0,
        section: 0,
        is_defined: false
      })
    end
  end

  if syms.contains_key("main") then
    eprintln("[odiag] resolved has main")
  else
    eprintln("[odiag] resolved MISSING main")
  end
  syms
end

def obj_add_string(inout obj: ObjectFile, s: String) -> Int
  match obj.strings.get(s)
  when Option::Some(off) then return off
  when Option::None then ()
  end
  let off = obj.string_table.len()
  let s_len = s.len()
  var i = 0
  while i < s_len do
    obj.string_table.push(s.char_at(i) as u8)
    i = i + 1
  end
  obj.string_table.push(0 as u8)
  obj.strings.insert(s, off)
  off
end

# ———————————————————————————————————————————————————————————————
# ELF64 Generation
# ———————————————————————————————————————————————————————————————
# This module emits object files in three formats:
# - ELF64 (Linux/FreeBSD x86-64 and AArch64) via build_elf64()
# - Mach-O 64-bit (macOS x86-64 and Apple Silicon) via build_macho64()
# - COFF (Windows x86-64) via build_coff64()
# The build_object() dispatcher selects format based on target.os.

# ELF constants
def ELF_MAGIC() -> [u8; 4] = [0x7F, 0x45, 0x4C, 0x46]  # \x7fELF

def ELFCLASS64()    -> u8 = 2
def ELFDATA2LSB()   -> u8 = 1
def EV_CURRENT()    -> u8 = 1
def ELFOSABI_NONE() -> u8 = 0
def ELFOSABI_LINUX()-> u8 = 3

def ET_REL()  -> u16 = 1    # relocatable object
def ET_EXEC() -> u16 = 2    # executable

def EM_X86_64()  -> u16 = 62   # 0x3E
def EM_AARCH64() -> u16 = 183  # 0xB7

# Section header types
def SHT_NULL()     -> u32 = 0
def SHT_PROGBITS() -> u32 = 1
def SHT_SYMTAB()   -> u32 = 2
def SHT_STRTAB()   -> u32 = 3
def SHT_RELA()     -> u32 = 4
def SHT_NOBITS()   -> u32 = 8

# Section flags
def SHF_WRITE()     -> u64 = 0x1
def SHF_ALLOC()     -> u64 = 0x2
def SHF_EXECINSTR() -> u64 = 0x4
def SHF_INFO()      -> u64 = 0x40

# Symbol binding/type for st_info field
def STB_LOCAL()  -> u8 = 0
def STB_GLOBAL() -> u8 = 1
def STB_WEAK()   -> u8 = 2

def STT_NOTYPE() -> u8 = 0
def STT_FUNC()   -> u8 = 2
def STT_OBJECT() -> u8 = 1
def STT_SECTION()-> u8 = 3

def elf_st_info(bind: u8, typ: u8) -> u8
  (bind << 4) | (typ & 0xF)
end

# ELF64 relocation types (x86-64)
def R_X86_64_NONE()      -> u32 = 0
def R_X86_64_64_()       -> u32 = 1
def R_X86_64_PC32_()     -> u32 = 2
def R_X86_64_PLT32_()    -> u32 = 4
def R_X86_64_GOTPCREL_() -> u32 = 9

# ELF64 relocation types (AArch64)
def R_AARCH64_ABS64_()           -> u32 = 257
def R_AARCH64_CALL26_()          -> u32 = 283
def R_AARCH64_ADR_PREL_PG_HI21_()-> u32 = 275
def R_AARCH64_ADD_ABS_LO12_NC_() -> u32 = 277
def R_AARCH64_CONDBR19_()        -> u32 = 280
def R_AARCH64_PREL32_()          -> u32 = 261
def R_AARCH64_MOVW_UABS_G0_NC_() -> u32 = 264
def R_AARCH64_MOVW_UABS_G1_NC_() -> u32 = 266
def R_AARCH64_MOVW_UABS_G2_NC_() -> u32 = 268
def R_AARCH64_LDST16_ABS_LO12_NC_() -> u32 = 284
def R_AARCH64_LDST64_ABS_LO12_NC_() -> u32 = 286
def R_AARCH64_LDST32_ABS_LO12_NC_() -> u32 = 285
def R_AARCH64_LDST8_ABS_LO12_NC_()  -> u32 = 278

# ELF section indices (fixed layout for our files)
# 0: NULL
# 1:.text
# 2:.data
# 3:.rodata
# 4:.bss
# 5:.symtab
# 6:.strtab
# 7:.shstrtab
# 8:.rela.text
def NUM_ELF_SECTIONS() -> Int = 9

def build_elf64(obj: ObjectFile) -> Vec[u8]
  var out = Vec::new()

  # --- Precompute section name string table (.shstrtab) ---
  var shstrtab = Vec::new()
  shstrtab.push(0)  # index 0 = empty

  let sh_text_name    = shstrtab.len(); push_str(&mut shstrtab, ".text")
  let sh_data_name    = shstrtab.len(); push_str(&mut shstrtab, ".data")
  let sh_rodata_name  = shstrtab.len(); push_str(&mut shstrtab, ".rodata")
  let sh_bss_name     = shstrtab.len(); push_str(&mut shstrtab, ".bss")
  let sh_symtab_name  = shstrtab.len(); push_str(&mut shstrtab, ".symtab")
  let sh_strtab_name  = shstrtab.len(); push_str(&mut shstrtab, ".strtab")
  let sh_shstrtab_name= shstrtab.len(); push_str(&mut shstrtab, ".shstrtab")
  let sh_relatext_name= shstrtab.len(); push_str(&mut shstrtab, ".rela.text")

  # --- Build symbol table ---
  var symtab_buf = Vec::new()
  var strtab = Vec::new()
  strtab.push(0)  # null byte at start

  # Symbol 0: null entry (24 bytes of zero)
  emit_zeros_vec(&mut symtab_buf, 24)

  # Section symbols (1-4:.text,.data,.rodata,.bss)
  var sym_idx = 1
  for sec_idx in 1..5 do
    elf_write_sym(&mut symtab_buf, 0, elf_st_info(STB_LOCAL(), STT_SECTION()), 0, sec_idx as u16, 0, 0)
    sym_idx = sym_idx + 1
  end

  let first_global = sym_idx

  # Global/weak symbols from the object
  for sym in obj.symbols do
    let name_off = strtab.len()
    push_str(&mut strtab, sym.name)

    let bind = match sym.binding
    when SymBinding::Local  then STB_LOCAL()
    when SymBinding::Global then STB_GLOBAL()
    when SymBinding::Weak   then STB_WEAK()
    end

    let typ = match sym.kind
    when SymKind::Func   then STT_FUNC()
    when SymKind::Data   then STT_OBJECT()
    when SymKind::NoType then STT_NOTYPE()
    end

    let sec = match sym.section
    when Section::Text   then 1
    when Section::Data   then 2
    when Section::Rodata then 3
    when Section::Bss    then 4
    when Section::Extern then 0  # SHN_UNDEF for external symbols
    end

    elf_write_sym(&mut symtab_buf, name_off as u32, elf_st_info(bind, typ), 0, sec as u16, sym.offset as u64, sym.size as u64)
    sym_idx = sym_idx + 1
  end

  # --- Build.rela.text entries ---
  var rela_buf = Vec::new()
  for rel in obj.relocations do
    # Find symbol index
    var rsym: u32 = 0
    var ri = 0
    for s in obj.symbols do
      if s.name == rel.symbol then
        rsym = (first_global + ri) as u32
        break
      end
      ri = ri + 1
    end

    let rtype = match obj.target.arch
    when Arch::X86_64 then
      match rel.kind
      when RelocKind::R_X86_64_PC32      then R_X86_64_PC32_()
      when RelocKind::R_X86_64_PLT32     then R_X86_64_PLT32_()
      when RelocKind::R_X86_64_GOTPCREL  then R_X86_64_GOTPCREL_()
      when RelocKind::R_X86_64_64        then R_X86_64_64_()
      when _ then panic("unsupported x86-64 ELF relocation kind")
      end
    when Arch::AArch64 then
      match rel.kind
      when RelocKind::R_AARCH64_CALL26   then R_AARCH64_CALL26_()
      when RelocKind::R_AARCH64_ADR_PREL_PG_HI21 then R_AARCH64_ADR_PREL_PG_HI21_()
      when RelocKind::R_AARCH64_ADD_ABS_LO12_NC  then R_AARCH64_ADD_ABS_LO12_NC_()
      when RelocKind::R_AARCH64_CONDBR19          then R_AARCH64_CONDBR19_()
      when RelocKind::R_AARCH64_PREL32            then R_AARCH64_PREL32_()
      when RelocKind::R_AARCH64_MOVW_UABS_G0_NC  then R_AARCH64_MOVW_UABS_G0_NC_()
      when RelocKind::R_AARCH64_MOVW_UABS_G1_NC  then R_AARCH64_MOVW_UABS_G1_NC_()
      when RelocKind::R_AARCH64_MOVW_UABS_G2_NC  then R_AARCH64_MOVW_UABS_G2_NC_()
      when RelocKind::R_AARCH64_LDST16_ABS_LO12_NC then R_AARCH64_LDST16_ABS_LO12_NC_()
      when RelocKind::R_AARCH64_LDST64_ABS_LO12_NC then R_AARCH64_LDST64_ABS_LO12_NC_()
      when RelocKind::R_AARCH64_LDST32_ABS_LO12_NC then R_AARCH64_LDST32_ABS_LO12_NC_()
      when RelocKind::R_AARCH64_LDST8_ABS_LO12_NC  then R_AARCH64_LDST8_ABS_LO12_NC_()
      when RelocKind::R_AARCH64_ABS64               then R_AARCH64_ABS64_()
      when _ then panic("unsupported AArch64 ELF relocation kind")
      end
    end

    elf_write_rela(&mut rela_buf, rel.offset as u64, rsym, rtype, rel.addend as i64)
  end

  # --- Compute layout ---
  let ehdr_size   = 64
  let text_off    = ehdr_size
  let text_size   = obj.text.len()
  let data_off    = text_off + text_size
  let data_size   = obj.data.len()
  let rodata_off  = data_off + data_size
  let rodata_size = obj.rodata.len()
  let symtab_off  = align_up(rodata_off + rodata_size, 8)
  let symtab_size = symtab_buf.len()
  let strtab_off  = symtab_off + symtab_size
  let strtab_size = strtab.len()
  let shstrtab_off= strtab_off + strtab_size
  let shstrtab_sz = shstrtab.len()
  let rela_off    = shstrtab_off + shstrtab_sz
  let rela_size   = rela_buf.len()
  let shdr_off    = align_up(rela_off + rela_size, 8)

  # --- ELF Header (64 bytes) ---
  # e_ident[16]
  out.push(0x7F)
  out.push(0x45)
  out.push(0x4C)
  out.push(0x46)
  out.push(ELFCLASS64())
  out.push(ELFDATA2LSB())
  out.push(EV_CURRENT())
  let osabi = match obj.target.os
  when OsAbi::Linux then ELFOSABI_LINUX()
  when _            then ELFOSABI_NONE()
  end
  out.push(osabi)
  emit_zeros_vec(&mut out, 8)  # padding

  write16(&mut out, ET_REL())
  let machine = match obj.target.arch
  when Arch::X86_64  then EM_X86_64()
  when Arch::AArch64 then EM_AARCH64()
  end
  write16(&mut out, machine)
  write32(&mut out, 1)              # e_version
  write64(&mut out, 0)              # e_entry
  write64(&mut out, 0)              # e_phoff
  write64(&mut out, shdr_off as u64)# e_shoff
  write32(&mut out, 0)              # e_flags
  write16(&mut out, 64)             # e_ehsize
  write16(&mut out, 0)              # e_phentsize
  write16(&mut out, 0)              # e_phnum
  write16(&mut out, 64)             # e_shentsize
  write16(&mut out, NUM_ELF_SECTIONS() as u16) # e_shnum
  write16(&mut out, 7)              # e_shstrndx

  # --- Sections data ---
  append_vec(&mut out, &obj.text)
  append_vec(&mut out, &obj.data)
  append_vec(&mut out, &obj.rodata)
  pad_to(&mut out, symtab_off)
  append_vec(&mut out, &symtab_buf)
  append_vec(&mut out, &strtab)
  append_vec(&mut out, &shstrtab)
  append_vec(&mut out, &rela_buf)
  pad_to(&mut out, shdr_off)

  # --- Section headers (9 × 64 bytes) ---

  # [0] NULL
  write_shdr(&mut out, 0, SHT_NULL(), 0, 0, 0, 0, 0, 0, 0, 0)

  # [1].text
  write_shdr(&mut out, sh_text_name as u32, SHT_PROGBITS(),
    SHF_ALLOC() | SHF_EXECINSTR(),
    0, text_off as u64, text_size as u64,
    0, 0, 16, 0)

  # [2].data
  write_shdr(&mut out, sh_data_name as u32, SHT_PROGBITS(),
    SHF_ALLOC() | SHF_WRITE(),
    0, data_off as u64, data_size as u64,
    0, 0, 8, 0)

  # [3].rodata
  write_shdr(&mut out, sh_rodata_name as u32, SHT_PROGBITS(),
    SHF_ALLOC(),
    0, rodata_off as u64, rodata_size as u64,
    0, 0, 8, 0)

  # [4].bss
  write_shdr(&mut out, sh_bss_name as u32, SHT_NOBITS(),
    SHF_ALLOC() | SHF_WRITE(),
    0, 0, obj.bss_size as u64,
    0, 0, 8, 0)

  # [5].symtab
  write_shdr(&mut out, sh_symtab_name as u32, SHT_SYMTAB(),
    0, 0, symtab_off as u64, symtab_size as u64,
    6,                     # sh_link = .strtab index
    first_global as u32,   # sh_info = first global sym
    8, 24)                 # entsize=24

  # [6].strtab
  write_shdr(&mut out, sh_strtab_name as u32, SHT_STRTAB(),
    0, 0, strtab_off as u64, strtab_size as u64,
    0, 0, 1, 0)

  # [7].shstrtab
  write_shdr(&mut out, sh_shstrtab_name as u32, SHT_STRTAB(),
    0, 0, shstrtab_off as u64, shstrtab_sz as u64,
    0, 0, 1, 0)

  # [8].rela.text
  write_shdr(&mut out, sh_relatext_name as u32, SHT_RELA(),
    SHF_INFO(),
    0, rela_off as u64, rela_size as u64,
    5,   # sh_link = .symtab index
    1,   # sh_info = .text index
    8, 24)  # entsize=24

  out
end

# Write ELF64 Sym entry (24 bytes)
def elf_write_sym(inout buf: Vec[u8], name: u32, info: u8, other: u8, shndx: u16, value: u64, size: u64) -> Unit
  write32(buf, name)
  buf.push(info)
  buf.push(other)
  write16(buf, shndx)
  write64(buf, value)
  write64(buf, size)
end

# Write ELF64 Rela entry (24 bytes)
def elf_write_rela(inout buf: Vec[u8], offset: u64, sym: u32, typ: u32, addend: i64) -> Unit
  write64(buf, offset)
  write64(buf, ((sym as u64) << 32) | (typ as u64))
  write64(buf, addend as u64)
end

# Write ELF64 section header (64 bytes)
def write_shdr(inout buf: Vec[u8], name: u32, typ: u32, flags: u64, addr: u64,
               offset: u64, size: u64, link: u32, info: u32, align: u64, entsize: u64) -> Unit
  write32(buf, name)
  write32(buf, typ)
  write64(buf, flags)
  write64(buf, addr)
  write64(buf, offset)
  write64(buf, size)
  write32(buf, link)
  write32(buf, info)
  write64(buf, align)
  write64(buf, entsize)
end

# ———————————————————————————————————————————————————————————————
# Mach-O 64 Generation (macOS x86-64 and ARM64)
# ———————————————————————————————————————————————————————————————

# Mach-O header magic
def MH_MAGIC_64()   -> u32 = 0xFEEDFACF
def MH_OBJECT()     -> u32 = 1

def CPU_TYPE_X86_64()  -> u32 = 0x01000007
def CPU_TYPE_ARM64()   -> u32 = 0x0100000C

def CPU_SUBTYPE_X86_64_ALL() -> u32 = 3
def CPU_SUBTYPE_ARM64_ALL()  -> u32 = 0

# Load command types
def LC_SEGMENT_64()  -> u32 = 0x19
def LC_SYMTAB()      -> u32 = 0x02
def LC_DYSYMTAB()    -> u32 = 0x0B

# Section types/attrs
def S_REGULAR()             -> u32 = 0
def S_ZEROFILL()            -> u32 = 1
def S_ATTR_PURE_INSTRUCTIONS() -> u32 = 0x80000000
def S_ATTR_SOME_INSTRUCTIONS() -> u32 = 0x00000400

# Mach-O relocation types (x86-64)
def X86_64_RELOC_BRANCH_()  -> u32 = 2
def X86_64_RELOC_SIGNED_()  -> u32 = 1

# Mach-O relocation types (ARM64)
def ARM64_RELOC_BRANCH26_() -> u32 = 2
def ARM64_RELOC_PAGE21_()   -> u32 = 3
def ARM64_RELOC_PAGEOFF12_()-> u32 = 4

def build_macho64(obj: ObjectFile) -> Vec[u8]
  var out = Vec::new()

  let is_arm = match obj.target.arch
  when Arch::AArch64 then true
  when _ then false
  end

  let cputype = if is_arm then CPU_TYPE_ARM64() else CPU_TYPE_X86_64() end
  let cpusubtype = if is_arm then CPU_SUBTYPE_ARM64_ALL() else CPU_SUBTYPE_X86_64_ALL() end

  let text_size = obj.text.len()
  let data_size = obj.data.len()
  let rodata_size = obj.rodata.len()

  let num_sections = 4   # __text, __data, __const, __bss
  let segment_cmd_size = 72 + (num_sections * 80)
  let symtab_cmd_size = 24
  let dysymtab_cmd_size = 80

  let num_load_cmds = 3   # segment + symtab + dysymtab
  let load_cmds_size = segment_cmd_size + symtab_cmd_size + dysymtab_cmd_size

  let header_size = 32   # Mach-O 64-bit header

  let text_offset = header_size + load_cmds_size
  let data_offset = text_offset + text_size
  let rodata_offset = data_offset + data_size
  let segment_filesize = text_size + data_size + rodata_size

  # --- Build relocation entries for __text section ---
  # Mach-O relocation_info: r_address(4 bytes), packed(4 bytes)
  # packed = r_symbolnum:24 | r_pcrel:1 | r_length:2 | r_extern:1 | r_type:4
  var reloc_buf = Vec::new()
  var text_nreloc = 0

  # Build symbol name to index map for relocation symbol lookup
  var sym_name_to_idx: Map[String, Int] = Map::new()
  var si = 0
  for sym in obj.symbols do
    sym_name_to_idx.insert(sym.name.clone(), si)
    si = si + 1
  end

  for rel in obj.relocations do
    # Only emit relocations for the.text section
    let r_address = rel.offset as u32

    # Look up symbol index
    let sym_idx = match sym_name_to_idx.get(rel.symbol.clone())
    when Option::Some(idx) then idx
    when Option::None then 0
    end

    # Determine relocation type, pcrel, and length for Mach-O
    let (r_type, r_pcrel, r_length) = if is_arm then
      match rel.kind
      when RelocKind::R_AARCH64_CALL26 then
        (ARM64_RELOC_BRANCH26_(), 1 as u32, 2 as u32)   # pcrel, 4-byte (2^2)
      when RelocKind::R_AARCH64_ADR_PREL_PG_HI21 then
        (ARM64_RELOC_PAGE21_(), 1 as u32, 2 as u32)
      when RelocKind::R_AARCH64_ADD_ABS_LO12_NC then
        (ARM64_RELOC_PAGEOFF12_(), 0 as u32, 2 as u32)  # not pcrel
      when RelocKind::ARM64_RELOC_BRANCH26 then
        (ARM64_RELOC_BRANCH26_(), 1 as u32, 2 as u32)
      when RelocKind::ARM64_RELOC_PAGE21 then
        (ARM64_RELOC_PAGE21_(), 1 as u32, 2 as u32)
      when RelocKind::ARM64_RELOC_PAGEOFF12 then
        (ARM64_RELOC_PAGEOFF12_(), 0 as u32, 2 as u32)
      when _ then (0 as u32, 0 as u32, 2 as u32)
      end
    else
      match rel.kind
      when RelocKind::R_X86_64_PC32 then
        (X86_64_RELOC_SIGNED_(), 1 as u32, 2 as u32)    # pcrel, 4-byte
      when RelocKind::R_X86_64_PLT32 then
        (X86_64_RELOC_BRANCH_(), 1 as u32, 2 as u32)
      when RelocKind::R_X86_64_64 then
        (0 as u32, 0 as u32, 3 as u32)                  # abs, 8-byte (2^3)
      when RelocKind::R_X86_64_GOTPCREL then
        (4 as u32, 1 as u32, 2 as u32)                  # X86_64_RELOC_GOT
      when RelocKind::X86_64_RELOC_BRANCH then
        (X86_64_RELOC_BRANCH_(), 1 as u32, 2 as u32)
      when RelocKind::X86_64_RELOC_SIGNED then
        (X86_64_RELOC_SIGNED_(), 1 as u32, 2 as u32)
      when _ then (0 as u32, 0 as u32, 2 as u32)
      end
    end

    # r_extern = 1 (symbol-based relocation)
    let r_extern: u32 = 1
    # Pack: r_symbolnum(24) | r_pcrel(1) | r_length(2) | r_extern(1) | r_type(4)
    let packed: u32 = (sym_idx as u32 & 0x00FFFFFF) | ((r_pcrel & 1) << 24) | ((r_length & 3) << 25) | ((r_extern & 1) << 27) | ((r_type & 0xF) << 28)

    write32(&mut reloc_buf, r_address)
    write32(&mut reloc_buf, packed)
    text_nreloc = text_nreloc + 1
  end

  let reloc_offset = align_up(rodata_offset + rodata_size, 4)
  let reloc_size = reloc_buf.len()

  # Build symbol + string tables
  var mo_strtab = Vec::new()
  mo_strtab.push(0x20)  # space (Mach-O convention: first byte is space)
  mo_strtab.push(0)

  var nlist_buf = Vec::new()
  var n_local_syms = 0
  var n_extern_syms = 0

  for sym in obj.symbols do
    let name_off = mo_strtab.len()
    # Mach-O symbols need leading underscore
    mo_strtab.push(0x5F)  # '_'
    push_str(&mut mo_strtab, sym.name)

    let n_sect: u8 = match sym.section
    when Section::Text   then 1
    when Section::Data   then 2
    when Section::Rodata then 3
    when Section::Bss    then 0
    when Section::Extern then 0  # NO_SECT for external symbols
    end

    # For extern symbols, use N_UNDF type; otherwise use section-based type
    let (n_type, is_ext) = if sym.section == Section::Extern then
      (0x01 as u8, true)  # N_UNDF | N_EXT
    else
      match sym.binding
      when SymBinding::Local  then (0x0E as u8, false)  # N_SECT
      when SymBinding::Global then (0x0F as u8, true)   # N_SECT | N_EXT
      when SymBinding::Weak   then (0x0F as u8, true)   # N_SECT | N_EXT (weak via n_desc)
      end
    end

    if is_ext then n_extern_syms = n_extern_syms + 1
    else n_local_syms = n_local_syms + 1
    end

    let n_desc: u16 = match sym.binding
    when SymBinding::Weak then 0x0080  # N_WEAK_DEF
    when _ then 0
    end

    # nlist_64: strx(4) type(1) sect(1) desc(2) value(8) = 16 bytes
    write32(&mut nlist_buf, name_off as u32)
    nlist_buf.push(n_type)
    nlist_buf.push(n_sect)
    write16(&mut nlist_buf, n_desc)
    write64(&mut nlist_buf, sym.offset as u64)
  end

  let symtab_offset = align_up(reloc_offset + reloc_size, 8)
  let strtab_offset = symtab_offset + nlist_buf.len()

  # --- Mach-O Header (32 bytes) ---
  write32(&mut out, MH_MAGIC_64())
  write32(&mut out, cputype)
  write32(&mut out, cpusubtype)
  write32(&mut out, MH_OBJECT())
  write32(&mut out, num_load_cmds as u32)
  write32(&mut out, load_cmds_size as u32)
  let hdr_flags: u32 = if obj.relocations.len() > 0 then 0x2000 else 0 end  # MH_SUBSECTIONS_VIA_SYMBOLS
  write32(&mut out, hdr_flags)
  write32(&mut out, 0)   # reserved

  # --- LC_SEGMENT_64 ---
  write32(&mut out, LC_SEGMENT_64())
  write32(&mut out, segment_cmd_size as u32)
  write_padded_str(&mut out, "", 16)         # segname (empty for MH_OBJECT)
  write64(&mut out, 0)                        # vmaddr
  let bss_size = obj.bss_size
  write64(&mut out, (segment_filesize + bss_size) as u64)  # vmsize (includes BSS)
  write64(&mut out, text_offset as u64)       # fileoff
  write64(&mut out, segment_filesize as u64)  # filesize
  write32(&mut out, 7)                        # maxprot (rwx)
  write32(&mut out, 7)                        # initprot
  write32(&mut out, num_sections as u32)
  write32(&mut out, 0)                        # flags

  # Section 1: __text (with relocations)
  write_padded_str(&mut out, "__text", 16)
  write_padded_str(&mut out, "__TEXT", 16)
  write64(&mut out, 0)                        # addr
  write64(&mut out, text_size as u64)
  write32(&mut out, text_offset as u32)
  write32(&mut out, 4)                        # align (2^4 = 16)
  if text_nreloc > 0 then
    write32(&mut out, reloc_offset as u32)    # reloff
    write32(&mut out, text_nreloc as u32)     # nreloc
  else
    write32(&mut out, 0)                      # reloff
    write32(&mut out, 0)                      # nreloc
  end
  write32(&mut out, S_REGULAR() | S_ATTR_PURE_INSTRUCTIONS() | S_ATTR_SOME_INSTRUCTIONS())
  write32(&mut out, 0)                        # reserved1
  write32(&mut out, 0)                        # reserved2
  write32(&mut out, 0)                        # reserved3 (padding for 64-bit)

  # Section 2: __data
  write_padded_str(&mut out, "__data", 16)
  write_padded_str(&mut out, "__DATA", 16)
  write64(&mut out, text_size as u64)
  write64(&mut out, data_size as u64)
  write32(&mut out, data_offset as u32)
  write32(&mut out, 3)
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, S_REGULAR())
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # Section 3: __const (rodata)
  write_padded_str(&mut out, "__const", 16)
  write_padded_str(&mut out, "__TEXT", 16)
  write64(&mut out, (text_size + data_size) as u64)
  write64(&mut out, rodata_size as u64)
  write32(&mut out, rodata_offset as u32)
  write32(&mut out, 3)
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, S_REGULAR())
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # Section 4: __bss (zero-initialized data)
  let bss_vmaddr = (text_size + data_size + rodata_size) as u64
  write_padded_str(&mut out, "__bss", 16)
  write_padded_str(&mut out, "__DATA", 16)
  write64(&mut out, bss_vmaddr)                # addr (after rodata in VM)
  write64(&mut out, bss_size as u64)           # size
  write32(&mut out, 0)                          # offset (no file content for zerofill)
  write32(&mut out, 3)                          # align (2^3 = 8)
  write32(&mut out, 0); write32(&mut out, 0)    # reloff, nreloc
  write32(&mut out, S_ZEROFILL())               # flags: S_ZEROFILL
  write32(&mut out, 0); write32(&mut out, 0); write32(&mut out, 0)

  # --- LC_SYMTAB ---
  write32(&mut out, LC_SYMTAB())
  write32(&mut out, symtab_cmd_size as u32)
  write32(&mut out, symtab_offset as u32)
  write32(&mut out, obj.symbols.len() as u32)
  write32(&mut out, strtab_offset as u32)
  write32(&mut out, mo_strtab.len() as u32)

  # --- LC_DYSYMTAB ---
  write32(&mut out, LC_DYSYMTAB())
  write32(&mut out, dysymtab_cmd_size as u32)
  write32(&mut out, 0)                              # ilocalsym
  write32(&mut out, n_local_syms as u32)             # nlocalsym
  write32(&mut out, n_local_syms as u32)             # iextdefsym
  write32(&mut out, n_extern_syms as u32)            # nextdefsym
  write32(&mut out, (n_local_syms + n_extern_syms) as u32)  # iundefsym
  write32(&mut out, 0)                              # nundefsym
  write32(&mut out, 0)                              # tocoff
  write32(&mut out, 0)                              # ntoc
  write32(&mut out, 0)                              # modtaboff
  write32(&mut out, 0)                              # nmodtab
  write32(&mut out, 0)                              # extrefsymoff
  write32(&mut out, 0)                              # nextrefsyms
  write32(&mut out, 0)                              # indirectsymoff
  write32(&mut out, 0)                              # nindirectsyms
  write32(&mut out, 0)                              # extreloff
  write32(&mut out, 0)                              # nextrel
  write32(&mut out, 0)                              # locreloff
  write32(&mut out, 0)                              # nlocrel

  # --- Section data ---
  append_vec(&mut out, &obj.text)
  append_vec(&mut out, &obj.data)
  append_vec(&mut out, &obj.rodata)

  # --- Relocation entries ---
  pad_to(&mut out, reloc_offset)
  append_vec(&mut out, &reloc_buf)

  pad_to(&mut out, symtab_offset)
  append_vec(&mut out, &nlist_buf)
  append_vec(&mut out, &mo_strtab)

  out
end

# ———————————————————————————————————————————————————————————————
# COFF / PE Generation (Windows x86-64)
# ———————————————————————————————————————————————————————————————

def IMAGE_FILE_MACHINE_AMD64() -> u16 = 0x8664
def IMAGE_FILE_MACHINE_ARM64() -> u16 = 0xAA64

def coff_machine(arch: Arch) -> u16
  match arch
  when Arch::X86_64 then IMAGE_FILE_MACHINE_AMD64()
  when Arch::AArch64 then IMAGE_FILE_MACHINE_ARM64()
  end
end

def coff_text_reloc_type(arch: Arch, kind: RelocKind) -> u16
  match arch
  when Arch::X86_64 then
    match kind
    when RelocKind::R_X86_64_64    then 1   # IMAGE_REL_AMD64_ADDR64
    when RelocKind::R_X86_64_PC32  then 4   # IMAGE_REL_AMD64_REL32
    when RelocKind::R_X86_64_PLT32 then 4   # IMAGE_REL_AMD64_REL32
    when _ then 0
    end
  when Arch::AArch64 then
    match kind
    when RelocKind::R_AARCH64_CALL26            then 0x0003  # IMAGE_REL_ARM64_BRANCH26
    when RelocKind::R_AARCH64_ADR_PREL_PG_HI21  then 0x0004  # IMAGE_REL_ARM64_PAGEBASE_REL21
    when RelocKind::R_AARCH64_ADD_ABS_LO12_NC   then 0x0006  # IMAGE_REL_ARM64_PAGEOFFSET_12A
    when RelocKind::R_AARCH64_LDST16_ABS_LO12_NC then 0x0007 # IMAGE_REL_ARM64_PAGEOFFSET_12L
    when RelocKind::R_AARCH64_LDST64_ABS_LO12_NC then 0x0007 # IMAGE_REL_ARM64_PAGEOFFSET_12L
    when RelocKind::R_AARCH64_LDST32_ABS_LO12_NC then 0x0007 # IMAGE_REL_ARM64_PAGEOFFSET_12L
    when RelocKind::R_AARCH64_LDST8_ABS_LO12_NC  then 0x0007 # IMAGE_REL_ARM64_PAGEOFFSET_12L
    when RelocKind::R_AARCH64_CONDBR19           then 0x000F # IMAGE_REL_ARM64_BRANCH19
    when RelocKind::R_AARCH64_PREL32             then 0x0011 # IMAGE_REL_ARM64_REL32
    when _ then 0
    end
  end
end

# Section flags
def IMAGE_SCN_CNT_CODE()           -> u32 = 0x00000020
def IMAGE_SCN_CNT_INITIALIZED()    -> u32 = 0x00000040
def IMAGE_SCN_CNT_UNINITIALIZED()  -> u32 = 0x00000080
def IMAGE_SCN_MEM_EXECUTE()        -> u32 = 0x20000000
def IMAGE_SCN_MEM_READ()           -> u32 = 0x40000000
def IMAGE_SCN_MEM_WRITE()          -> u32 = 0x80000000

def build_coff64(obj: ObjectFile) -> Vec[u8]
  var out = Vec::new()

  let num_sections = 3  # .text, .data, .rdata

  # --- Build relocation entries for.text section ---
  # COFF relocation: VirtualAddress(4), SymbolTableIndex(4), Type(2) = 10 bytes each
  var text_reloc_buf = Vec::new()
  var text_nrelocs: u16 = 0

  # Build symbol name to index map
  var sym_name_to_idx: Map[String, Int] = Map::new()
  var si = 0
  for sym in obj.symbols do
    sym_name_to_idx.insert(sym.name.clone(), si)
    si = si + 1
  end

  for rel in obj.relocations do
    let sym_idx = match sym_name_to_idx.get(rel.symbol.clone())
    when Option::Some(idx) then idx
    when Option::None then 0
    end

    let reloc_type: u16 = coff_text_reloc_type(obj.target.arch, rel.kind)

    write32(&mut text_reloc_buf, rel.offset as u32)     # VirtualAddress
    write32(&mut text_reloc_buf, sym_idx as u32)         # SymbolTableIndex
    write16(&mut text_reloc_buf, reloc_type)             # Type
    text_nrelocs = text_nrelocs + 1
  end

  # COFF Header (20 bytes)
  write16(&mut out, coff_machine(obj.target.arch))
  write16(&mut out, num_sections as u16)
  write32(&mut out, 0)                # TimeDateStamp
  let symtab_placeholder = out.len()  # will patch later
  write32(&mut out, 0)                # PointerToSymbolTable (placeholder)
  write32(&mut out, obj.symbols.len() as u32)  # NumberOfSymbols
  write16(&mut out, 0)                # SizeOfOptionalHeader
  write16(&mut out, 0)                # Characteristics

  # Section headers (40 bytes each)
  let headers_end = 20 + (num_sections * 40)
  let text_off = headers_end
  let data_off = text_off + obj.text.len()
  let rdata_off = data_off + obj.data.len()
  let reloc_off = rdata_off + obj.rodata.len()
  let reloc_size = text_reloc_buf.len()

  #.text (with relocations)
  write_padded_str(&mut out, ".text", 8)
  write32(&mut out, 0)                                    # VirtualSize
  write32(&mut out, 0)                                    # VirtualAddress
  write32(&mut out, obj.text.len() as u32)                # SizeOfRawData
  write32(&mut out, text_off as u32)                      # PointerToRawData
  if text_nrelocs > 0 then
    write32(&mut out, reloc_off as u32)                   # PointerToRelocations
  else
    write32(&mut out, 0)
  end
  write32(&mut out, 0)                                    # PointerToLinenumbers
  write16(&mut out, text_nrelocs)                         # NumberOfRelocations
  write16(&mut out, 0)                                    # NumberOfLinenumbers
  write32(&mut out, IMAGE_SCN_CNT_CODE() | IMAGE_SCN_MEM_EXECUTE() | IMAGE_SCN_MEM_READ())

  #.data
  write_padded_str(&mut out, ".data", 8)
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, obj.data.len() as u32)
  write32(&mut out, data_off as u32)
  write32(&mut out, 0); write32(&mut out, 0)
  write16(&mut out, 0); write16(&mut out, 0)
  write32(&mut out, IMAGE_SCN_CNT_INITIALIZED() | IMAGE_SCN_MEM_READ() | IMAGE_SCN_MEM_WRITE())

  #.rdata
  write_padded_str(&mut out, ".rdata", 8)
  write32(&mut out, 0); write32(&mut out, 0)
  write32(&mut out, obj.rodata.len() as u32)
  write32(&mut out, rdata_off as u32)
  write32(&mut out, 0); write32(&mut out, 0)
  write16(&mut out, 0); write16(&mut out, 0)
  write32(&mut out, IMAGE_SCN_CNT_INITIALIZED() | IMAGE_SCN_MEM_READ())

  # Section data
  append_vec(&mut out, &obj.text)
  append_vec(&mut out, &obj.data)
  append_vec(&mut out, &obj.rodata)

  # Relocation data
  append_vec(&mut out, &text_reloc_buf)

  # Symbol table
  let symtab_pos = out.len()
  patch_u32(&mut out, symtab_placeholder, symtab_pos as u32)

  # COFF symbol entries (18 bytes each)
  var coff_strtab = Vec::new()
  # String table starts with its own size (4 bytes), patched later
  let strtab_size_placeholder = coff_strtab.len()
  write32(&mut coff_strtab, 0)  # placeholder for string table size

  for sym in obj.symbols do
    if sym.name.len() <= 8 then
      # Short name: fits inline
      write_padded_str(&mut out, sym.name, 8)
    else
      # Long name: zeroes(4) + offset_into_string_table(4)
      let str_off = coff_strtab.len()
      push_str(&mut coff_strtab, sym.name)
      write32(&mut out, 0)
      write32(&mut out, str_off as u32)
    end

    write32(&mut out, sym.offset as u32)   # Value
    let sec_num: u16 = match sym.section
    when Section::Text   then 1
    when Section::Data   then 2
    when Section::Rodata then 3
    when Section::Bss    then 0
    when Section::Extern then 0  # IMAGE_SYM_UNDEFINED for external symbols
    end
    write16(&mut out, sec_num)             # SectionNumber
    let sym_type: u16 = match sym.kind
    when SymKind::Func then 0x20           # IMAGE_SYM_DTYPE_FUNCTION
    when _ then 0
    end
    write16(&mut out, sym_type)            # Type
    let storage: u8 = match sym.binding
    when SymBinding::Global then 2         # IMAGE_SYM_CLASS_EXTERNAL
    when SymBinding::Local  then 3         # IMAGE_SYM_CLASS_STATIC
    when SymBinding::Weak   then 2
    end
    out.push(storage)                      # StorageClass
    out.push(0)                            # NumberOfAuxSymbols
  end

  # String table (patch size)
  patch_u32(&mut coff_strtab, strtab_size_placeholder, coff_strtab.len() as u32)
  append_vec(&mut out, &coff_strtab)

  out
end

# ———————————————————————————————————————————————————————————————
# Public API — write object file based on target
# ———————————————————————————————————————————————————————————————

def build_object(obj: ObjectFile) -> Vec[u8]
  match obj.target.os
  when OsAbi::Linux   then build_elf64(obj)
  when OsAbi::MacOS   then build_macho64(obj)
  when OsAbi::Windows then build_coff64(obj)
  end
end

# ———————————————————————————————————————————————————————————————
# Vector / byte helpers
# ———————————————————————————————————————————————————————————————

def push_str(inout v: Vec[u8], s: String) -> Unit
  let s_len = s.len()
  var i = 0
  while i < s_len do
    v.push(s.char_at(i) as u8)
    i = i + 1
  end
  v.push(0 as u8)
end

def write16(inout v: Vec[u8], val: u16) -> Unit
  v.push((val & 0xFF) as u8)
  v.push(((val >> 8) & 0xFF) as u8)
end

def write32(inout v: Vec[u8], val: u32) -> Unit
  v.push((val & 0xFF) as u8)
  v.push(((val >> 8) & 0xFF) as u8)
  v.push(((val >> 16) & 0xFF) as u8)
  v.push(((val >> 24) & 0xFF) as u8)
end

def write64(inout v: Vec[u8], val: u64) -> Unit
  write32(v, (val & 0xFFFFFFFF) as u32)
  write32(v, ((val >> 32) & 0xFFFFFFFF) as u32)
end

def emit_zeros_vec(inout v: Vec[u8], n: Int) -> Unit
  v.extend(&Vec::filled(n, 0u8))
end

def append_vec(inout dst: Vec[u8], src: Vec[u8]) -> Unit
  dst.extend(src)
end

def pad_to(inout v: Vec[u8], target: Int) -> Unit
  while v.len() < target do
    v.push(0)
  end
end

def write_padded_str(inout v: Vec[u8], s: String, len: Int) -> Unit
  var i = 0
  let s_len = s.len()
  while i < len do
    if i < s_len then
      v.push(s.char_at(i) as u8)
    else
      v.push(0 as u8)
    end
    i = i + 1
  end
end

def patch_u32(inout v: Vec[u8], offset: Int, val: u32) -> Unit
  v[offset]     = (val & 0xFF) as u8
  v[offset + 1] = ((val >> 8) & 0xFF) as u8
  v[offset + 2] = ((val >> 16) & 0xFF) as u8
  v[offset + 3] = ((val >> 24) & 0xFF) as u8
end

def align_up(val: Int, align: Int) -> Int
  ((val + align - 1) / align) * align
end

# ———————————————————————————————————————————————————————————————
# DWARF Debug Information Generation
# ———————————————————————————————————————————————————————————————
#
# Generates DWARF version 4 debug information for native debugging.
# Emits these sections:
#  .debug_info      - Compilation unit and DIE tree
#  .debug_abbrev    - Abbreviation table
#  .debug_line      - Line number program
#  .debug_str       - String table
#  .debug_aranges   - Address ranges
#  .debug_frame     - Call frame info (for stack unwinding)

# DWARF constants
def DW_TAG_compile_unit()     -> u8 = 0x11
def DW_TAG_subprogram()       -> u8 = 0x2E
def DW_TAG_variable()         -> u8 = 0x34
def DW_TAG_formal_parameter() -> u8 = 0x05
def DW_TAG_base_type()        -> u8 = 0x24
def DW_TAG_pointer_type()     -> u8 = 0x0F
def DW_TAG_structure_type()   -> u8 = 0x13
def DW_TAG_member()           -> u8 = 0x0D
def DW_TAG_typedef()          -> u8 = 0x16
def DW_TAG_lexical_block()    -> u8 = 0x0B

def DW_AT_name()              -> u8 = 0x03
def DW_AT_producer()          -> u8 = 0x25
def DW_AT_language()          -> u8 = 0x13
def DW_AT_comp_dir()          -> u8 = 0x1B
def DW_AT_low_pc()            -> u8 = 0x11
def DW_AT_high_pc()           -> u8 = 0x12
def DW_AT_stmt_list()         -> u8 = 0x10
def DW_AT_type()              -> u8 = 0x49
def DW_AT_decl_file()         -> u8 = 0x3A
def DW_AT_decl_line()         -> u8 = 0x3B
def DW_AT_byte_size()         -> u8 = 0x0B
def DW_AT_encoding()          -> u8 = 0x3E
def DW_AT_location()          -> u8 = 0x02
def DW_AT_frame_base()        -> u8 = 0x40
def DW_AT_external()          -> u8 = 0x3F

def DW_FORM_addr()            -> u8 = 0x01
def DW_FORM_data1()           -> u8 = 0x0B
def DW_FORM_data2()           -> u8 = 0x05
def DW_FORM_data4()           -> u8 = 0x06
def DW_FORM_string()          -> u8 = 0x08
def DW_FORM_strp()            -> u8 = 0x0E
def DW_FORM_sec_offset()      -> u8 = 0x17
def DW_FORM_flag()            -> u8 = 0x0C
def DW_FORM_flag_present()    -> u8 = 0x19
def DW_FORM_ref4()            -> u8 = 0x13
def DW_FORM_exprloc()         -> u8 = 0x18

def DW_ATE_signed()           -> u8 = 0x05
def DW_ATE_unsigned()         -> u8 = 0x07
def DW_ATE_boolean()          -> u8 = 0x02
def DW_ATE_float()            -> u8 = 0x04
def DW_ATE_signed_char()      -> u8 = 0x06
def DW_ATE_UTF()              -> u8 = 0x10

def DW_OP_fbreg()             -> u8 = 0x91
def DW_OP_reg0()              -> u8 = 0x50
def DW_OP_call_frame_cfa()    -> u8 = 0x9C

# Tangerine language code (vendor-specific range 0x8000-0xFFFF)
# Using 0x8FE1 = "TG" in hex (0x54 0x47) combined
def DW_LANG_Tangerine()       -> u16 = 0x8FE1

# DWARF line number opcodes
def DW_LNS_copy()             -> u8 = 0x01
def DW_LNS_advance_pc()       -> u8 = 0x02
def DW_LNS_advance_line()     -> u8 = 0x03
def DW_LNS_set_file()         -> u8 = 0x04
def DW_LNS_set_column()       -> u8 = 0x05
def DW_LNS_negate_stmt()      -> u8 = 0x06
def DW_LNS_const_add_pc()     -> u8 = 0x08
def DW_LNS_fixed_advance_pc() -> u8 = 0x09
def DW_LNE_end_sequence()     -> u8 = 0x01
def DW_LNE_set_address()      -> u8 = 0x02
def DW_LNE_define_file()      -> u8 = 0x03

struct ObjectDebugInfo
  arch: Arch              # Target architecture for register mapping
  debug_abbrev: Vec[u8]   # Abbreviation table
  debug_info: Vec[u8]     # DIE tree
  debug_line: Vec[u8]     # Line number program
  debug_str: Vec[u8]      # String table
  debug_aranges: Vec[u8]  # Address ranges
  debug_frame: Vec[u8]    # Call frame info
  
  # String table index
  str_offsets: Map[String, Int]
  
  # DIE reference tracking
  next_die_offset: Int
  type_die_offsets: Map[String, Int]  # Type name -> DIE offset
end

struct DwarfBaseTypeEntry
  name: String
  encoding: u8
  byte_size: u8
end

struct CvStructField
  name: String
  type_index: u32
  offset: u32
end

struct CvEnumVariant
  name: String
  value: i64
end

struct FunctionObjectDebugInfo
  name: String
  low_pc: u64
  high_pc: u64
  file_index: Int
  line: Int
  params: Vec[VariableObjectDebugInfo]
  locals: Vec[VariableObjectDebugInfo]
end

struct VariableObjectDebugInfo
  name: String
  type_name: String
  file_index: Int
  line: Int
  stack_offset: Int  # Offset from frame base
end

def debug_info_new(arch: Arch) -> ObjectDebugInfo
  var str_table = Vec::new()
  str_table.push(0)  # Empty string at offset 0
  
  ObjectDebugInfo {
    arch: arch,
    debug_abbrev: Vec::new(),
    debug_info: Vec::new(),
    debug_line: Vec::new(),
    debug_str: str_table,
    debug_aranges: Vec::new(),
    debug_frame: Vec::new(),
    str_offsets: Map::new(),
    next_die_offset: 0,
    type_die_offsets: Map::new()
  }
end

def dwarf_add_string(inout di: ObjectDebugInfo, s: String) -> Int
  match di.str_offsets.get(s.clone())
  when Option::Some(off) then return off
  when Option::None then ()
  end
  
  let off = di.debug_str.len()
  let s_len = s.len()
  var i = 0
  while i < s_len do
    di.debug_str.push(s.char_at(i) as u8)
    i = i + 1
  end
  di.debug_str.push(0 as u8)
  di.str_offsets.insert(s, off)
  off
end

def emit_uleb128(inout v: Vec[u8], inout value: u64) -> Unit
  loop
    var byte = (value & 0x7F) as u8
    value = value >> 7
    if value != 0 then
      byte = byte | 0x80
    end
    v.push(byte)
    if value == 0 then break end
  end
end

def emit_sleb128(inout v: Vec[u8], inout value: i64) -> Unit
  let negative = value < 0
  loop
    var byte = (value & 0x7F) as u8
    value = value >> 7
    let more = !((value == 0 && (byte & 0x40) == 0) || 
                 (value == -1 && (byte & 0x40) != 0))
    if more then
      byte = byte | 0x80
    end
    v.push(byte)
    if !more then break end
  end
end

def generate_dwarf_debug_info(
  inout di: ObjectDebugInfo,
  source_file: String,
  comp_dir: String,
  producer: String,
  functions: Vec[FunctionObjectDebugInfo],
  text_size: u64
) -> Unit
  # Generate abbreviation table first
  generate_abbrev_table(di)
  
  # Generate.debug_info compilation unit
  let abbrev_offset = 0u32
  let addr_size = 8u8  # 64-bit addresses
  
  # Compilation unit header
  let unit_start = di.debug_info.len()
  write32(&mut di.debug_info, 0)  # Unit length placeholder
  write16(&mut di.debug_info, 4)  # DWARF version 4
  write32(&mut di.debug_info, abbrev_offset)  # Abbrev offset
  di.debug_info.push(addr_size)
  
  # DW_TAG_compile_unit (abbrev code 1)
  emit_uleb128(&mut di.debug_info, 1)
  
  # Producer string
  let producer_off = dwarf_add_string(di, producer.clone())
  write32(&mut di.debug_info, producer_off as u32)
  
  # Language (Tangerine vendor-specific code)
  write16(&mut di.debug_info, DW_LANG_Tangerine())
  
  # Name (source file)
  let name_off = dwarf_add_string(di, source_file.clone())
  write32(&mut di.debug_info, name_off as u32)
  
  # Comp dir
  let dir_off = dwarf_add_string(di, comp_dir.clone())
  write32(&mut di.debug_info, dir_off as u32)
  
  # Low PC (0 for relocatable)
  write64(&mut di.debug_info, 0)
  
  # High PC (size)
  write64(&mut di.debug_info, text_size)
  
  # Stmt list (offset into.debug_line)
  write32(&mut di.debug_info, 0)
  
  # Emit base types
  emit_base_types(di)
  
  # Emit function DIEs
  for func in functions do
    emit_function_die(di, func)
  end
  
  # End of children
  di.debug_info.push(0)
  
  # Patch unit length
  let unit_length = di.debug_info.len() - unit_start - 4
  patch_u32(&mut di.debug_info, unit_start, unit_length as u32)
  
  # Generate line number info
  generate_line_info(di, source_file.clone(), functions)
  
  # Generate address ranges
  generate_aranges(di, text_size)
  
  # Generate call frame info
  generate_frame_info(di)
end

def generate_abbrev_table(inout di: ObjectDebugInfo) -> Unit
  # Abbrev 1: DW_TAG_compile_unit
  emit_uleb128(&mut di.debug_abbrev, 1)  # Abbrev code
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_compile_unit() as u64)
  di.debug_abbrev.push(1)  # DW_CHILDREN_yes
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_producer() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_language() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data2() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_name() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_comp_dir() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_low_pc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_addr() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_high_pc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_addr() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_stmt_list() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_sec_offset() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # Abbrev 2: DW_TAG_subprogram
  emit_uleb128(&mut di.debug_abbrev, 2)
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_subprogram() as u64)
  di.debug_abbrev.push(1)  # DW_CHILDREN_yes
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_name() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_low_pc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_addr() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_high_pc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_addr() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_frame_base() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_exprloc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_decl_file() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data1() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_decl_line() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data2() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_external() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_flag_present() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # Abbrev 3: DW_TAG_formal_parameter
  emit_uleb128(&mut di.debug_abbrev, 3)
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_formal_parameter() as u64)
  di.debug_abbrev.push(0)  # DW_CHILDREN_no
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_name() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_type() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_ref4() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_location() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_exprloc() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # Abbrev 4: DW_TAG_variable
  emit_uleb128(&mut di.debug_abbrev, 4)
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_variable() as u64)
  di.debug_abbrev.push(0)  # DW_CHILDREN_no
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_name() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_type() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_ref4() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_location() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_exprloc() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_decl_line() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data2() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # Abbrev 5: DW_TAG_base_type
  emit_uleb128(&mut di.debug_abbrev, 5)
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_base_type() as u64)
  di.debug_abbrev.push(0)  # DW_CHILDREN_no
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_name() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_strp() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_encoding() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data1() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_byte_size() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data1() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # Abbrev 6: DW_TAG_pointer_type
  emit_uleb128(&mut di.debug_abbrev, 6)
  emit_uleb128(&mut di.debug_abbrev, DW_TAG_pointer_type() as u64)
  di.debug_abbrev.push(0)  # DW_CHILDREN_no
  
  emit_uleb128(&mut di.debug_abbrev, DW_AT_type() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_ref4() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_AT_byte_size() as u64)
  emit_uleb128(&mut di.debug_abbrev, DW_FORM_data1() as u64)
  emit_uleb128(&mut di.debug_abbrev, 0)
  emit_uleb128(&mut di.debug_abbrev, 0)
  
  # End of abbreviations
  di.debug_abbrev.push(0)
end

def emit_base_types(inout di: ObjectDebugInfo) -> Unit
  var types = Vec::new()
  types.push(DwarfBaseTypeEntry { name: "Int".to_string(), encoding: DW_ATE_signed(), byte_size: 8 })
  types.push(DwarfBaseTypeEntry { name: "UInt".to_string(), encoding: DW_ATE_unsigned(), byte_size: 8 })
  types.push(DwarfBaseTypeEntry { name: "Bool".to_string(), encoding: DW_ATE_boolean(), byte_size: 1 })
  types.push(DwarfBaseTypeEntry { name: "Float".to_string(), encoding: DW_ATE_float(), byte_size: 8 })
  types.push(DwarfBaseTypeEntry { name: "Char".to_string(), encoding: DW_ATE_UTF(), byte_size: 4 })
  types.push(DwarfBaseTypeEntry { name: "u8".to_string(), encoding: DW_ATE_unsigned(), byte_size: 1 })
  types.push(DwarfBaseTypeEntry { name: "i32".to_string(), encoding: DW_ATE_signed(), byte_size: 4 })
  types.push(DwarfBaseTypeEntry { name: "i64".to_string(), encoding: DW_ATE_signed(), byte_size: 8 })
  types.push(DwarfBaseTypeEntry { name: "u64".to_string(), encoding: DW_ATE_unsigned(), byte_size: 8 })

  for entry in types do
    di.type_die_offsets.insert(entry.name.clone(), di.debug_info.len())
    
    # Abbrev code 5: DW_TAG_base_type
    emit_uleb128(&mut di.debug_info, 5)
    
    let name_off = dwarf_add_string(di, entry.name.clone())
    write32(&mut di.debug_info, name_off as u32)
    di.debug_info.push(entry.encoding)
    di.debug_info.push(entry.byte_size)
  end
end

def emit_function_die(inout di: ObjectDebugInfo, func: FunctionObjectDebugInfo) -> Unit
  # Abbrev code 2: DW_TAG_subprogram
  emit_uleb128(&mut di.debug_info, 2)
  
  let name_off = dwarf_add_string(di, func.name.clone())
  write32(&mut di.debug_info, name_off as u32)
  
  write64(&mut di.debug_info, func.low_pc)
  write64(&mut di.debug_info, func.high_pc)
  
  # Frame base expression: DW_OP_call_frame_cfa
  di.debug_info.push(1)  # Expression length
  di.debug_info.push(DW_OP_call_frame_cfa())
  
  di.debug_info.push(func.file_index as u8)
  write16(&mut di.debug_info, func.line as u16)
  # DW_AT_external is flag_present, no value needed
  
  # Emit parameters
  for param in func.params do
    emit_variable_die(di, &param, true)
  end
  
  # Emit local variables
  for local in func.locals do
    emit_variable_die(di, &local, false)
  end
  
  # End of children
  di.debug_info.push(0)
end

def emit_variable_die(inout di: ObjectDebugInfo, var_info: VariableObjectDebugInfo, is_param: Bool) -> Unit
  # Abbrev code 3 (param) or 4 (variable)
  if is_param then
    emit_uleb128(&mut di.debug_info, 3)
  else
    emit_uleb128(&mut di.debug_info, 4)
  end
  
  let name_off = dwarf_add_string(di, var_info.name.clone())
  write32(&mut di.debug_info, name_off as u32)
  
  # Type reference - look up or use Int as default
  let type_off = di.type_die_offsets.get(var_info.type_name.clone())
    .unwrap_or(di.type_die_offsets.get("Int".to_string()).unwrap_or(0))
  write32(&mut di.debug_info, type_off as u32)
  
  # Location expression: DW_OP_fbreg + offset
  var loc_expr: Vec[u8] = Vec::new()
  loc_expr.push(DW_OP_fbreg())
  emit_sleb128(&mut loc_expr, var_info.stack_offset as i64)
  
  emit_uleb128(&mut di.debug_info, loc_expr.len() as u64)
  for b in loc_expr do
    di.debug_info.push(b)
  end
  
  if !is_param then
    write16(&mut di.debug_info, var_info.line as u16)
  end
end

def generate_line_info(inout di: ObjectDebugInfo, source_file: String, functions: Vec[FunctionObjectDebugInfo]) -> Unit
  # DWARF line number program header
  let header_start = di.debug_line.len()
  
  write32(&mut di.debug_line, 0)  # Total length placeholder
  write16(&mut di.debug_line, 4)  # DWARF version 4
  
  let header_length_pos = di.debug_line.len()
  write32(&mut di.debug_line, 0)  # Header length placeholder
  
  let after_header_length = di.debug_line.len()
  
  di.debug_line.push(1)   # Minimum instruction length
  di.debug_line.push(1)   # Maximum ops per instruction
  di.debug_line.push(1)   # Default is_stmt
  di.debug_line.push(250) # Line base (-6 cast to u8)
  di.debug_line.push(14)  # Line range
  di.debug_line.push(13)  # Opcode base
  
  # Standard opcode lengths
  di.debug_line.push(0)  # DW_LNS_copy
  di.debug_line.push(1)  # DW_LNS_advance_pc
  di.debug_line.push(1)  # DW_LNS_advance_line
  di.debug_line.push(1)  # DW_LNS_set_file
  di.debug_line.push(1)  # DW_LNS_set_column
  di.debug_line.push(0)  # DW_LNS_negate_stmt
  di.debug_line.push(0)  # DW_LNS_set_basic_block
  di.debug_line.push(0)  # DW_LNS_const_add_pc
  di.debug_line.push(1)  # DW_LNS_fixed_advance_pc
  di.debug_line.push(0)  # DW_LNS_set_prologue_end
  di.debug_line.push(0)  # DW_LNS_set_epilogue_begin
  di.debug_line.push(1)  # DW_LNS_set_isa
  
  # Include directories (empty)
  di.debug_line.push(0)
  
  # File names
  let source_file_len = source_file.len()
  var source_file_i = 0
  while source_file_i < source_file_len do
    di.debug_line.push(source_file.char_at(source_file_i) as u8)
    source_file_i = source_file_i + 1
  end
  di.debug_line.push(0 as u8)  # Null terminate filename
  emit_uleb128(&mut di.debug_line, 0)  # Directory index
  emit_uleb128(&mut di.debug_line, 0)  # Modification time
  emit_uleb128(&mut di.debug_line, 0)  # File size
  di.debug_line.push(0)  # End of file list
  
  # Patch header length
  let header_length = di.debug_line.len() - after_header_length
  patch_u32(&mut di.debug_line, header_length_pos, header_length as u32)
  
  # Line number program
  for func in functions do
    # Set address
    di.debug_line.push(0)  # Extended opcode
    emit_uleb128(&mut di.debug_line, 9)  # Length
    di.debug_line.push(DW_LNE_set_address())
    write64(&mut di.debug_line, func.low_pc)

    # Emit multiple rows within a function using available source-line metadata
    var line_rows: Vec[Int] = Vec::new()
    line_rows.push(func.line)
    for p in func.params do
      let param_line = p.line
      if param_line > 0 && !line_rows.contains(&param_line) then
        line_rows.push(param_line)
      end
    end
    for l in func.locals do
      let local_line = l.line
      if local_line > 0 && !line_rows.contains(&local_line) then
        line_rows.push(local_line)
      end
    end

    let total_span = if func.high_pc > func.low_pc then
      func.high_pc - func.low_pc
    else
      0
    end
    let row_count = if line_rows.is_empty() then 1 else line_rows.len() end

    var cur_line = 1
    var cur_pc = func.low_pc
    var i = 0
    while i < row_count do
      let src_line = if line_rows.is_empty() then func.line else line_rows[i] end

      di.debug_line.push(DW_LNS_advance_line())
      emit_sleb128(&mut di.debug_line, (src_line - cur_line) as i64)
      cur_line = src_line

      di.debug_line.push(DW_LNS_copy())

      if i + 1 < row_count then
        let next_pc = func.low_pc + ((total_span * (i + 1) as u64) / row_count as u64)
        if next_pc > cur_pc then
          di.debug_line.push(DW_LNS_advance_pc())
          emit_uleb128(&mut di.debug_line, (next_pc - cur_pc) as u64)
          cur_pc = next_pc
        end
      end

      i = i + 1
    end

    if func.high_pc > cur_pc then
      di.debug_line.push(DW_LNS_advance_pc())
      emit_uleb128(&mut di.debug_line, (func.high_pc - cur_pc) as u64)
    end
  end
  
  # End sequence
  di.debug_line.push(0)  # Extended opcode
  emit_uleb128(&mut di.debug_line, 1)
  di.debug_line.push(DW_LNE_end_sequence())
  
  # Patch total length
  let total_length = di.debug_line.len() - header_start - 4
  patch_u32(&mut di.debug_line, header_start, total_length as u32)
end

def generate_aranges(inout di: ObjectDebugInfo, text_size: u64) -> Unit
  let header_start = di.debug_aranges.len()
  
  write32(&mut di.debug_aranges, 0)  # Length placeholder
  write16(&mut di.debug_aranges, 2)  # Version
  write32(&mut di.debug_aranges, 0)  # Debug info offset
  di.debug_aranges.push(8)           # Address size
  di.debug_aranges.push(0)           # Segment size
  
  # Padding to address size alignment
  emit_zeros_vec(&mut di.debug_aranges, 4)
  
  # Address range: start, length
  write64(&mut di.debug_aranges, 0)
  write64(&mut di.debug_aranges, text_size)
  
  # Terminator
  write64(&mut di.debug_aranges, 0)
  write64(&mut di.debug_aranges, 0)
  
  # Patch length
  let length = di.debug_aranges.len() - header_start - 4
  patch_u32(&mut di.debug_aranges, header_start, length as u32)
end

def generate_frame_info(inout di: ObjectDebugInfo) -> Unit
  # CIE (Common Information Entry)
  let cie_start = di.debug_frame.len()
  
  let (ra_reg, sp_reg) = match di.arch
  when Arch::X86_64 then (16, 7)    # RIP=16, RSP=7
  when Arch::AArch64 then (30, 31)  # LR=30, SP=31
  end
  
  write32(&mut di.debug_frame, 0)  # Length placeholder
  write32(&mut di.debug_frame, 0xFFFFFFFF)  # CIE ID
  di.debug_frame.push(4)           # Version
  di.debug_frame.push(0)           # Augmentation (empty string)
  emit_uleb128(&mut di.debug_frame, 8)  # Code alignment factor
  emit_sleb128(&mut di.debug_frame, -8) # Data alignment factor
  emit_uleb128(&mut di.debug_frame, ra_reg as u64) # Return address register
  
  # Initial instructions: CFA = SP + 8
  di.debug_frame.push(0x0C)  # DW_CFA_def_cfa
  emit_uleb128(&mut di.debug_frame, sp_reg as u64)   # SP
  emit_uleb128(&mut di.debug_frame, 8)   # Offset
  
  di.debug_frame.push(0x90 | ra_reg as u8)  # DW_CFA_offset for RA
  emit_uleb128(&mut di.debug_frame, 1)   # Offset factor
  
  # Padding
  while (di.debug_frame.len() - cie_start) % 8 != 4 do
    di.debug_frame.push(0)
  end
  
  # Patch CIE length
  let cie_length = di.debug_frame.len() - cie_start - 4
  patch_u32(&mut di.debug_frame, cie_start, cie_length as u32)
end

# ———————————————————————————————————————————————————————————————
# PDB / CodeView Debug Info (Windows)
# ———————————————————————————————————————————————————————————————

# PDB (Program DataBase) file format for Visual Studio / WinDbg.
# Contains type information (TPI stream), symbol information (DBI stream),
# source file mappings, and module debug information.

struct PdbInfo
  # CodeView sections embedded in PE/COFF
  debug_s: Vec[u8]     # .debug$S — symbol records
  debug_t: Vec[u8]     # .debug$T — type records
  
  # PDB file streams
  pdb_path: String
  age: u32              # PDB age/revision
  guid: PdbGuid         # Unique identifier linking EXE to PDB
  
  # TPI (Type Program Information) stream
  type_records: Vec[CvTypeRecord]
  type_index_base: u32  # Starting type index (0x1000 for user types)
  
  # Symbol records
  symbol_records: Vec[CvSymbolRecord]
  
  # Source file checksums
  file_checksums: Vec[FileChecksum]
  
  # Line number mappings
  line_info: Vec[CvLineInfo]
end

struct PdbGuid
  data1: u32
  data2: u16
  data3: u16
  data4: Vec[u8]  # 8 bytes
end

# CodeView type record kinds
enum CvTypeKind
  LfPointer       # 0x1002
  LfProcedure     # 0x1008
  LfArgList       # 0x1201
  LfFieldList     # 0x1203
  LfStructure     # 0x1505
  LfEnum          # 0x1507
  LfArray         # 0x1503
  LfMember        # 0x150D
  LfEnumerate     # 0x1502
  LfModifier      # 0x1001
end

struct CvTypeRecord
  kind: CvTypeKind
  data: Vec[u8]
end

# CodeView symbol record kinds
enum CvSymbolKind
  SProcRef        # 0x1125 — procedure reference
  SLProcRef       # 0x1127 — local procedure reference
  SGProc32        # 0x1110 — global procedure start
  SLProc32        # 0x110F — local procedure start
  SEnd            # 0x0006 — end of block/procedure
  SObjName        # 0x1101 — object file name
  SCompile3       # 0x113C — compiler info
  SUdt            # 0x1108 — user-defined type
  SConstant       # 0x1107 — constant
  SLocal          # 0x113E — local variable in optimized code
  SDefRange       # 0x113F — definition range for local
  SGData32        # 0x110D — global data
end

struct CvSymbolRecord
  kind: CvSymbolKind
  data: Vec[u8]
end

struct FileChecksum
  filename: String
  checksum: Vec[u8]    # MD5 hash
  checksum_kind: u8    # 1 = MD5
end

struct CvLineInfo
  function_name: String
  file_idx: u32
  lines: Vec[CvLineEntry]
end

struct CvLineEntry
  offset: u32
  line: u32
  col_start: u16
  col_end: u16
end

def pdb_info_new(pdb_path: String) -> PdbInfo
  PdbInfo {
    debug_s: Vec::new(),
    debug_t: Vec::new(),
    pdb_path: pdb_path,
    age: 1,
    guid: generate_pdb_guid(&pdb_path),
    type_records: Vec::new(),
    type_index_base: 0x1000,
    symbol_records: Vec::new(),
    file_checksums: Vec::new(),
    line_info: Vec::new()
  }
end

extern def _tg_obj_time(tloc: PtrMut[Int]) -> Int

def generate_pdb_guid(pdb_path: String) -> PdbGuid
  var current_time = 0
  let ts = _tg_obj_time(&mut current_time)
  let path_len = pdb_path.len() as Int

  let data1 = ((ts as u32) ^ 0x54414E47)
  let data2 = ((ts >> 16) & 0xFFFF) as u16
  let data3 = (((ts >> 1) ^ path_len) & 0xFFFF) as u16

  PdbGuid {
    data1: data1,
    data2: data2,
    data3: data3,
    data4: vec![
      (ts & 0xFF) as u8,
      ((ts >> 8) & 0xFF) as u8,
      ((ts >> 16) & 0xFF) as u8,
      ((ts >> 24) & 0xFF) as u8,
      (path_len & 0xFF) as u8,
      ((path_len >> 8) & 0xFF) as u8,
      ((path_len >> 16) & 0xFF) as u8,
      1
    ]
  }
end

# ———————————————————————————————————————————————————————————————
# CodeView Type Record Emission
# ———————————————————————————————————————————————————————————————

def cv_emit_type_index(inout pdb: PdbInfo) -> u32
  let idx = pdb.type_index_base + pdb.type_records.len() as u32
  idx
end

# Emit a basic type (Int, Bool, etc.) — uses predefined indices
def cv_builtin_type_index(name: String) -> u32
  match name.as_str()
  when "Unit" then 0x0003   # T_VOID
  when "Bool" then 0x0030   # T_BOOL08
  when "Int" then 0x0076    # T_INT8 (64-bit signed)
  when "UInt" then 0x0077   # T_UINT8 (64-bit unsigned)
  when "Float" then 0x0041  # T_REAL64
  when "Char" then 0x0070   # T_CHAR
  when "String" then 0x0603 # T_PVOID (pointer to bytes)
  when _ then 0x0003        # T_VOID (fallback)
  end
end

def cv_emit_struct_type(inout pdb: PdbInfo, name: String, fields: Vec[CvStructField], struct_size: u32) -> u32
  let type_idx = cv_emit_type_index(pdb)
  
  # First emit the field list
  var field_list_data = Vec::new()
  for field in fields do
    # LF_MEMBER (0x150D)
    write16_le(&mut field_list_data, 0x150D)
    write16_le(&mut field_list_data, 0x0003)  # access: public
    write32_le(&mut field_list_data, field.type_index)
    write16_le(&mut field_list_data, field.offset as u16)
    write_cv_string(&mut field_list_data, &field.name)
    # Align to 4 bytes
    while field_list_data.len() % 4 != 0 do
      field_list_data.push(0xF0 + (4 - field_list_data.len() % 4) as u8)
    end
  end
  
  let fl_idx = cv_emit_type_index(pdb)
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfFieldList,
    data: field_list_data
  })
  
  # Now emit the structure type
  var struct_data = Vec::new()
  write16_le(&mut struct_data, fields.len() as u16)  # member count
  write16_le(&mut struct_data, 0x0200)                # property: none
  write32_le(&mut struct_data, fl_idx)                 # field list
  write32_le(&mut struct_data, 0)                      # derived from
  write32_le(&mut struct_data, 0)                      # vshape
  write16_le(&mut struct_data, struct_size as u16)     # actual struct size
  write_cv_string(&mut struct_data, &name)
  
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfStructure,
    data: struct_data
  })
  
  type_idx
end

def cv_emit_enum_type(inout pdb: PdbInfo, name: String, variants: Vec[CvEnumVariant]) -> u32
  let type_idx = cv_emit_type_index(pdb)
  
  # Emit field list for enum variants
  var field_data = Vec::new()
  for variant in variants do
    # LF_ENUMERATE (0x1502)
    write16_le(&mut field_data, 0x1502)
    write16_le(&mut field_data, 0x0003)  # access: public
    # Value as LF_LONG
    write16_le(&mut field_data, 0x8004)
    write32_le(&mut field_data, variant.value as u32)
    write_cv_string(&mut field_data, &variant.name)
    while field_data.len() % 4 != 0 do
      field_data.push(0xF0 + (4 - field_data.len() % 4) as u8)
    end
  end
  
  let fl_idx = cv_emit_type_index(pdb)
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfFieldList,
    data: field_data
  })
  
  # LF_ENUM record
  var enum_data = Vec::new()
  write16_le(&mut enum_data, variants.len() as u16)
  write16_le(&mut enum_data, 0)               # property
  write32_le(&mut enum_data, 0x0076)           # underlying type: INT8
  write32_le(&mut enum_data, fl_idx)           # field list
  write_cv_string(&mut enum_data, &name)
  
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfEnum,
    data: enum_data
  })
  
  type_idx
end

def cv_emit_procedure_type(inout pdb: PdbInfo, ret_type: u32, param_types: Vec[u32]) -> u32
  let type_idx = cv_emit_type_index(pdb)
  
  # Emit arg list first
  var arglist_data = Vec::new()
  write32_le(&mut arglist_data, param_types.len() as u32)
  for pt in param_types do
    write32_le(&mut arglist_data, pt)
  end
  
  let al_idx = cv_emit_type_index(pdb)
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfArgList,
    data: arglist_data
  })
  
  # LF_PROCEDURE
  var proc_data = Vec::new()
  write32_le(&mut proc_data, ret_type)
  proc_data.push(0)        # calling convention: near C
  proc_data.push(0)        # func attributes
  write16_le(&mut proc_data, param_types.len() as u16)
  write32_le(&mut proc_data, al_idx)
  
  pdb.type_records.push(CvTypeRecord {
    kind: CvTypeKind::LfProcedure,
    data: proc_data
  })
  
  type_idx
end

# ———————————————————————————————————————————————————————————————
# CodeView Symbol Record Emission
# ———————————————————————————————————————————————————————————————

def cv_emit_obj_name(inout pdb: PdbInfo, obj_name: String) -> Unit
  var data = Vec::new()
  write32_le(&mut data, 0)  # signature
  write_cv_string(&mut data, &obj_name)
  
  pdb.symbol_records.push(CvSymbolRecord {
    kind: CvSymbolKind::SObjName,
    data: data
  })
end

def cv_emit_compile3(inout pdb: PdbInfo, compiler_version: String) -> Unit
  var data = Vec::new()
  write32_le(&mut data, 0)      # flags
  write16_le(&mut data, 0x00D0) # machine: AMD64
  write16_le(&mut data, 0)      # frontend version major
  write16_le(&mut data, 1)      # frontend version minor
  write16_le(&mut data, 0)      # frontend version build
  write16_le(&mut data, 0)      # frontend version QFE
  write16_le(&mut data, 0)      # backend version major
  write16_le(&mut data, 1)      # backend version minor
  write16_le(&mut data, 0)      # backend version build
  write16_le(&mut data, 0)      # backend version QFE
  write_cv_string(&mut data, &compiler_version)
  
  pdb.symbol_records.push(CvSymbolRecord {
    kind: CvSymbolKind::SCompile3,
    data: data
  })
end

def cv_emit_global_proc(inout pdb: PdbInfo, name: String, type_idx: u32,
                        offset: u32, section: u16, code_size: u32) -> Unit
  var data = Vec::new()
  write32_le(&mut data, 0)           # pParent
  write32_le(&mut data, 0)           # pEnd
  write32_le(&mut data, 0)           # pNext
  write32_le(&mut data, code_size)   # code size
  write32_le(&mut data, 0)           # debug start offset
  write32_le(&mut data, code_size)   # debug end offset
  write32_le(&mut data, type_idx)    # type index
  write32_le(&mut data, offset)      # offset in section
  write16_le(&mut data, section)     # section number
  data.push(0)                       # flags
  write_cv_string(&mut data, &name)
  
  pdb.symbol_records.push(CvSymbolRecord {
    kind: CvSymbolKind::SGProc32,
    data: data
  })
end

def cv_emit_local_var(inout pdb: PdbInfo, name: String, type_idx: u32, flags: u16) -> Unit
  var data = Vec::new()
  write32_le(&mut data, type_idx)
  write16_le(&mut data, flags)
  write_cv_string(&mut data, &name)
  
  pdb.symbol_records.push(CvSymbolRecord {
    kind: CvSymbolKind::SLocal,
    data: data
  })
end

def cv_emit_end(inout pdb: PdbInfo) -> Unit
  pdb.symbol_records.push(CvSymbolRecord {
    kind: CvSymbolKind::SEnd,
    data: Vec::new()
  })
end

# ———————————————————————————————————————————————————————————————
#.debug$S and.debug$T Section Building
# ———————————————————————————————————————————————————————————————

def build_debug_s_section(inout pdb: PdbInfo) -> Unit
  # CodeView signature
  write32_le(&mut pdb.debug_s, 4)  # CV_SIGNATURE_C13
  
  # File checksums subsection (0xF4)
  let checksums_start = pdb.debug_s.len()
  write32_le(&mut pdb.debug_s, 0xF4)  # subsection type
  write32_le(&mut pdb.debug_s, 0)     # length placeholder
  
  for fc in pdb.file_checksums do
    let name_offset = 0u32  # Would be offset into string table
    write32_le(&mut pdb.debug_s, name_offset)
    pdb.debug_s.push(fc.checksum.len() as u8)
    pdb.debug_s.push(fc.checksum_kind)
    for b in fc.checksum do
      pdb.debug_s.push(b)
    end
    # Align to 4
    while (pdb.debug_s.len() - checksums_start) % 4 != 0 do
      pdb.debug_s.push(0)
    end
  end
  
  # Patch checksums length
  let checksums_len = pdb.debug_s.len() - checksums_start - 8
  patch_u32(&mut pdb.debug_s, checksums_start + 4, checksums_len as u32)
  
  # Lines subsection (0xF2)
  for li in pdb.line_info do
    let lines_start = pdb.debug_s.len()
    write32_le(&mut pdb.debug_s, 0xF2)  # subsection type
    write32_le(&mut pdb.debug_s, 0)     # length placeholder
    
    write32_le(&mut pdb.debug_s, 0)     # offset of contributing code
    write16_le(&mut pdb.debug_s, 1)     # segment
    write16_le(&mut pdb.debug_s, 0)     # flags
    write32_le(&mut pdb.debug_s, 0)     # code size
    
    # File block
    write32_le(&mut pdb.debug_s, li.file_idx)
    write32_le(&mut pdb.debug_s, li.lines.len() as u32)
    write32_le(&mut pdb.debug_s, 12 + li.lines.len() as u32 * 8)  # block size
    
    for entry in li.lines do
      write32_le(&mut pdb.debug_s, entry.offset)
      # line/deltaLineEnd/fStatement packed
      write32_le(&mut pdb.debug_s, entry.line | 0x80000000)
    end
    
    let lines_len = pdb.debug_s.len() - lines_start - 8
    patch_u32(&mut pdb.debug_s, lines_start + 4, lines_len as u32)
  end
  
  # Symbol records subsection (0xF1)
  let syms_start = pdb.debug_s.len()
  write32_le(&mut pdb.debug_s, 0xF1)
  write32_le(&mut pdb.debug_s, 0)  # length placeholder
  
  for sym in pdb.symbol_records do
    let sym_start = pdb.debug_s.len()
    write16_le(&mut pdb.debug_s, 0)  # record length placeholder
    write16_le(&mut pdb.debug_s, cv_symbol_kind_value(&sym.kind))
    for b in sym.data do
      pdb.debug_s.push(b)
    end
    # Align to 4
    while (pdb.debug_s.len() - sym_start) % 4 != 0 do
      pdb.debug_s.push(0)
    end
    let sym_len = pdb.debug_s.len() - sym_start - 2
    patch_u16(&mut pdb.debug_s, sym_start, sym_len as u16)
  end
  
  let syms_len = pdb.debug_s.len() - syms_start - 8
  patch_u32(&mut pdb.debug_s, syms_start + 4, syms_len as u32)
end

def build_debug_t_section(inout pdb: PdbInfo) -> Unit
  # CodeView signature
  write32_le(&mut pdb.debug_t, 4)  # CV_SIGNATURE_C13
  
  for rec in pdb.type_records do
    let rec_start = pdb.debug_t.len()
    write16_le(&mut pdb.debug_t, 0)  # record length placeholder
    write16_le(&mut pdb.debug_t, cv_type_kind_value(&rec.kind))
    for b in rec.data do
      pdb.debug_t.push(b)
    end
    while (pdb.debug_t.len() - rec_start) % 4 != 0 do
      pdb.debug_t.push(0)
    end
    let rec_len = pdb.debug_t.len() - rec_start - 2
    patch_u16(&mut pdb.debug_t, rec_start, rec_len as u16)
  end
end

def cv_symbol_kind_value(kind: CvSymbolKind) -> u16
  match kind
  when CvSymbolKind::SProcRef then 0x1125
  when CvSymbolKind::SLProcRef then 0x1127
  when CvSymbolKind::SGProc32 then 0x1110
  when CvSymbolKind::SLProc32 then 0x110F
  when CvSymbolKind::SEnd then 0x0006
  when CvSymbolKind::SObjName then 0x1101
  when CvSymbolKind::SCompile3 then 0x113C
  when CvSymbolKind::SUdt then 0x1108
  when CvSymbolKind::SConstant then 0x1107
  when CvSymbolKind::SLocal then 0x113E
  when CvSymbolKind::SDefRange then 0x113F
  when CvSymbolKind::SGData32 then 0x110D
  end
end

def cv_type_kind_value(kind: CvTypeKind) -> u16
  match kind
  when CvTypeKind::LfPointer then 0x1002
  when CvTypeKind::LfProcedure then 0x1008
  when CvTypeKind::LfArgList then 0x1201
  when CvTypeKind::LfFieldList then 0x1203
  when CvTypeKind::LfStructure then 0x1505
  when CvTypeKind::LfEnum then 0x1507
  when CvTypeKind::LfArray then 0x1503
  when CvTypeKind::LfMember then 0x150D
  when CvTypeKind::LfEnumerate then 0x1502
  when CvTypeKind::LfModifier then 0x1001
  end
end

def write_cv_string(inout buf: Vec[u8], s: String) -> Unit
  let s_len = s.len()
  var i = 0
  while i < s_len do
    buf.push(s.char_at(i) as u8)
    i = i + 1
  end
  buf.push(0 as u8)  # Null terminator
end

def write16_le(inout buf: Vec[u8], val: u16) -> Unit
  buf.push((val & 0xFF) as u8)
  buf.push(((val >> 8) & 0xFF) as u8)
end

def write32_le(inout buf: Vec[u8], val: u32) -> Unit
  buf.push((val & 0xFF) as u8)
  buf.push(((val >> 8) & 0xFF) as u8)
  buf.push(((val >> 16) & 0xFF) as u8)
  buf.push(((val >> 24) & 0xFF) as u8)
end

def patch_u16(inout buf: Vec[u8], offset: UInt, val: u16) -> Unit
  buf[offset] = (val & 0xFF) as u8
  buf[offset + 1] = ((val >> 8) & 0xFF) as u8
end

# ———————————————————————————————————————————————————————————————
# PE Debug Directory Entry (links to PDB)
# ———————————————————————————————————————————————————————————————

def build_pe_debug_directory(pdb: PdbInfo) -> Vec[u8]
  var dir = Vec::new()
  
  # IMAGE_DEBUG_DIRECTORY entry for CodeView
  write32_le(&mut dir, 0)        # Characteristics
  write32_le(&mut dir, 0)        # TimeDateStamp
  write16_le(&mut dir, 0)        # MajorVersion
  write16_le(&mut dir, 0)        # MinorVersion
  write32_le(&mut dir, 2)        # Type: IMAGE_DEBUG_TYPE_CODEVIEW
  write32_le(&mut dir, 0)        # SizeOfData (filled later)
  write32_le(&mut dir, 0)        # AddressOfRawData (filled later)
  write32_le(&mut dir, 0)        # PointerToRawData (filled later)
  
  dir
end

def build_codeview_info(pdb: PdbInfo) -> Vec[u8]
  var cv = Vec::new()
  
  # RSDS signature
  cv.push('R' as u8)
  cv.push('S' as u8)
  cv.push('D' as u8)
  cv.push('S' as u8)
  
  # GUID
  write32_le(&mut cv, pdb.guid.data1)
  write16_le(&mut cv, pdb.guid.data2)
  write16_le(&mut cv, pdb.guid.data3)
  for b in pdb.guid.data4 do
    cv.push(b)
  end
  
  # Age
  write32_le(&mut cv, pdb.age)
  
  # PDB file path (null-terminated UTF-8)
  let pdb_path = pdb.pdb_path.clone()
  let pdb_path_len = pdb_path.len()
  var i = 0
  while i < pdb_path_len do
    cv.push(pdb_path.char_at(i) as u8)
    i = i + 1
  end
  cv.push(0 as u8)
  
  cv
end
