## tg_compiler::bindgen — FFI binding generator
## Generate Tangerine bindings from C headers, Rust crates, and export C ABI.
## Spec: §tooling.bindgen

# module tg_compiler::bindgen

use std::core::{Option, Result, Display}
use std::collections::{Map, Array}
use std::fs

# ─── Configuration ───────────────────────────────────────────────────

pub struct BindgenConfig
  pub input: BindgenInput
  pub output_path: String
  pub module_name: String
  pub allowlist: Array[String]
  pub blocklist: Array[String]
  pub type_mappings: Map[String, String]
  pub generate_docs: Bool
  pub safety: BindgenSafety
end

pub enum BindgenInput
  CHeader(String)
  CHeaders(Array[String])
  RustCrate(String)
  WitFile(String)
end

pub enum BindgenSafety
  AllUnsafe
  SafeWrappers
  Trusted
end

impl BindgenConfig
  pub def from_c_header(header: str, module: str) -> BindgenConfig
    BindgenConfig {
      input: BindgenInput::CHeader(header.to_string()),
      output_path: module.to_string() + "_ffi.tg",
      module_name: module.to_string(),
      allowlist: Array::new(),
      blocklist: Array::new(),
      type_mappings: _default_c_type_mappings(),
      generate_docs: true,
      safety: BindgenSafety::SafeWrappers,
    }
  end

  pub def from_rust(crate_path: str, module: str) -> BindgenConfig
    BindgenConfig {
      input: BindgenInput::RustCrate(crate_path.to_string()),
      output_path: module.to_string() + "_ffi.tg",
      module_name: module.to_string(),
      allowlist: Array::new(),
      blocklist: Array::new(),
      type_mappings: _default_rust_type_mappings(),
      generate_docs: true,
      safety: BindgenSafety::SafeWrappers,
    }
  end
end

# ─── C type representation ───────────────────────────────────────────

pub enum CType
  Void
  Bool
  Char
  UChar
  Short
  UShort
  Int
  UInt
  Long
  ULong
  LongLong
  ULongLong
  Float
  Double
  SizeT
  Pointer(Box[CType])
  ConstPointer(Box[CType])
  Array(Box[CType], UInt)
  FuncPointer(Array[CType], Box[CType])
  Struct(CStruct)
  Union(CUnion)
  Enum(CEnum)
  Typedef(String, Box[CType])
end

pub struct CStruct
  pub name: String
  pub fields: Array[CField]
  pub packed: Bool
end

pub struct CField
  pub name: String
  pub ty: CType
  pub doc: Option[String]
end

pub struct CUnion
  pub name: String
  pub variants: Array[CField]
end

pub struct CEnum
  pub name: String
  pub variants: Array[(String, i64)]
end

pub struct CFunction
  pub name: String
  pub params: Array[(String, CType)]
  pub return_type: CType
  pub variadic: Bool
  pub doc: Option[String]
end

# ─── Generator ───────────────────────────────────────────────────────

pub struct Bindgen
  config: BindgenConfig
  declarations: Array[Declaration]
end

enum Declaration
  Function(CFunction)
  Struct(CStruct)
  Union(CUnion)
  Enum(CEnum)
  Typedef(String, CType)
  Constant(String, CType, String)
end

impl Bindgen
  pub def new(config: BindgenConfig) -> Bindgen
    Bindgen { config: config, declarations: Array::new() }
  end

  /// Parse the input and generate bindings.
  pub def generate(inout self) -> Result[String, BindgenError]
    match self.config.input
    when BindgenInput::CHeader(path) then
      match self.parse_c_header(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    when BindgenInput::CHeaders(paths) then
      for path in paths do
        match self.parse_c_header(path)
        when Result::Ok(_) then ()
        when Result::Err(e) then return Result::Err(e)
        end
      end
    when BindgenInput::RustCrate(path) then
      match self.parse_rust_crate(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    when BindgenInput::WitFile(path) then
      match self.parse_wit_file(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
    self.emit()
  end

  /// Generate and write to file.
  pub def generate_to_file(inout self) -> Result[Unit, BindgenError]
    match self.generate()
    when Result::Ok(output) then
      match fs::write_string(self.config.output_path.clone(), output)
      when Result::Ok(_) then Result::Ok(())
      when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
      end
    when Result::Err(e) then Result::Err(e)
    end
  end

  def parse_c_header(inout self, path: str) -> Result[Unit, BindgenError]
    match fs::read_to_string(path.to_string())
    when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
    when Result::Ok(content) then
      ## Recursive-descent C header parser
      let mut parser = CHeaderParser::new(content)
      let decls = match parser.parse_translation_unit()
      when Result::Ok(d) then d
      when Result::Err(msg) then return Result::Err(BindgenError::ParseError(msg))
      end
      for decl in decls do
        let name = match decl
        when Declaration::Function(f) then f.name.clone()
        when Declaration::Struct(s) then s.name.clone()
        when Declaration::Union(u) then u.name.clone()
        when Declaration::Enum(e) then e.name.clone()
        when Declaration::Typedef(n, _) then n.clone()
        when Declaration::Constant(n, _, _) then n.clone()
        end
        match self.should_include(&name)
        when true then self.declarations.push(decl.clone())
        when false then ()
        end
      end
      Result::Ok(())
    end
  end

  def parse_rust_crate(inout self, path: str) -> Result[Unit, BindgenError]
    ## Parse Rust rlib metadata for pub extern "C" fn declarations
    ## In a fully independent Tangerine, we might skip Rust rlibs, 
    ## but for completeness, we read the symbols.
    match std::fs::read_to_string(path.to_string())
    when Result::Ok(content) then
      # Scrape for patterns like: pub extern "C" fn name(...)
      let lines = content.lines()
      mut i = 0
      while i < lines.len() do
        let line = lines[i]
        let trimmed = line.trim()
        if trimmed.starts_with("pub extern \"C\" fn ") || trimmed.starts_with("pub extern \"c\" fn ") then
          # Parse the full function signature
          let fn_part = if trimmed.starts_with("pub extern \"C\" fn ") then
            trimmed.slice(18, trimmed.len())
          else
            trimmed.slice(18, trimmed.len())
          end
          
          # Extract function name
          let paren_pos = fn_part.find("(")
          let name = match paren_pos
          when Option::Some(pos) then fn_part.slice(0, pos).trim().to_string()
          when Option::None then fn_part.trim().to_string()
          end
          
          # Parse parameters and return type
          let (params, return_type) = _parse_rust_fn_signature(fn_part)
          
          self.declarations.push(Declaration::Function(CFunction {
            name: name,
            params: params,
            return_type: return_type,
            doc: Option::None,
            variadic: false
          }))
        end
        i = i + 1
      end
      Result::Ok(())
    when Result::Err(e) then
      Result::Err(BindgenError::IoError(e.to_string()))
    end
  end

  def parse_wit_file(inout self, path: str) -> Result[Unit, BindgenError]
    ## Parse WIT (WASM Interface Types) file
    match std::fs::read_to_string(path.to_string())
    when Result::Ok(content) then
      # WIT grammar parsing
      let lines = content.lines()
      for line in lines do
        let trimmed = line.trim()
        if trimmed.starts_with("export ") then
          let parts = trimmed.split(" ")
          if parts.len() > 1 then
            let name = parts[1].trim_end(";").to_string()
            self.declarations.push(Declaration::Function(CFunction {
              name: name,
              params: Vec::new(),
              return_type: CType::Void,
              doc: Option::Some("WASM export".to_string()),
              variadic: false
            }))
          end
        end
      end
      Result::Ok(())
    when Result::Err(e) then
      Result::Err(BindgenError::IoError(e.to_string()))
    end
  end

  def should_include(self, name: str) -> Bool
    mut is_blocked = false
    for blocked in self.config.blocklist do
      match name == blocked
      when true then is_blocked = true
      when false then ()
      end
    end
    
    match is_blocked
    when true then false
    when false then
      match self.config.allowlist.is_empty()
      when true then
        true
      when false then
        mut found = false
        for a in self.config.allowlist do
          match a == name
          when true then found = true
          when false then ()
          end
        end
        found
      end
    end
  end

  def emit(self) -> Result[String, BindgenError]
    mut out = String::new()
    out = out + "## Auto-generated by tg_compiler::bindgen\n"
    out = out + "## Do not edit — regenerate with `tangerine bindgen`\n\n"
    out = out + "module " + &self.config.module_name + "_ffi\n\n"

    for decl in self.declarations do
      match decl
      when Declaration::Function(f) then out = out + &self.emit_function(f)
      when Declaration::Struct(s) then out = out + &self.emit_struct(s)
      when Declaration::Union(u) then out = out + &self.emit_union(u)
      when Declaration::Enum(e) then out = out + &self.emit_enum(e)
      when Declaration::Typedef(name, ty) then
        out = out + "type " + name + " = " + &_ctype_to_tg(ty, &self.config.type_mappings) + "\n\n"
      when Declaration::Constant(name, ty, val) then
        out = out + "pub def " + name + "() -> " + &_ctype_to_tg(ty, &self.config.type_mappings) + " = " + val + "\n\n"
      end
    end

    out = out + "end ## module " + &self.config.module_name + "_ffi\n"
    Result::Ok(out)
  end

  def emit_function(self, f: CFunction) -> String
    mut out = String::new()
    match self.config.generate_docs
    when true then
      match f.doc
      when Option::Some(doc) then
        out = out + "## " + doc + "\n"
      when Option::None then ()
      end
    when false then ()
    end

    ## Emit the extern declaration
    out = out + "@ffi(\"c\")\n"
    out = out + "extern def " + &f.name + "("
    mut p_idx = 0
    for param_pair in f.params do
      let pname = param_pair.0
      let pty = param_pair.1
      match p_idx > 0
      when true then out = out + ", "
      when false then ()
      end
      out = out + pname + ": " + &_ctype_to_tg(pty, &self.config.type_mappings)
      p_idx = p_idx + 1
    end
    match f.variadic
    when true then
      match f.params.is_empty()
      when false then out = out + ", "
      when true then ()
      end
      out = out + "..."
    when false then ()
    end
    out = out + ") -> " + &_ctype_to_tg(&f.return_type, &self.config.type_mappings) + "\n\n"

    ## Optionally emit safe wrapper
    match self.config.safety
    when BindgenSafety::SafeWrappers then
      out = out + "pub def " + &f.name + "_safe("
      mut idx = 0
      for param in f.params do
        let pname = param.0
        let pty = param.1
        match idx > 0
        when true then out = out + ", "
        when false then ()
        end
        out = out + pname + ": " + &_ctype_to_tg_safe(pty, &self.config.type_mappings)
        idx = idx + 1
      end
      out = out + ") -> Result[" + &_ctype_to_tg_safe(&f.return_type, &self.config.type_mappings) + ", FfiError]\n"
      out = out + "  unsafe { " + &f.name + "("
      mut idx2 = 0
      for param2 in f.params do
        let pname2 = param2.0
        match idx2 > 0
        when true then out = out + ", "
        when false then ()
        end
        out = out + pname2
        idx2 = idx2 + 1
      end
      out = out + ") }\nend\n\n"
    when _ then ()
    end

    out
  end

  def emit_struct(self, s: CStruct) -> String
    mut out = "@repr(C)\n"
    match s.packed
    when true then out = out + "@packed\n"
    when false then ()
    end
    out = out + "pub struct " + &s.name + "\n"
    for field in s.fields do
      match field.doc
      when Option::Some(doc) then
        out = out + "  ## " + doc + "\n"
      when Option::None then ()
      end
      out = out + "  pub " + &field.name + ": " + &_ctype_to_tg(&field.ty, &self.config.type_mappings) + "\n"
    end
    out = out + "end\n\n"
    out
  end

  def emit_union(self, u: CUnion) -> String
    mut out = "@repr(C)\n"
    out = out + "pub union " + &u.name + "\n"
    for v in u.variants do
      out = out + "  pub " + &v.name + ": " + &_ctype_to_tg(&v.ty, &self.config.type_mappings) + "\n"
    end
    out = out + "end\n\n"
    out
  end

  def emit_enum(self, e: CEnum) -> String
    mut out = "@repr(i32)\n"
    out = out + "pub enum " + &e.name + "\n"
    for variant in e.variants do
      let name = variant.0
      let value = variant.1
      out = out + "  " + name + " = " + &value.to_string() + "\n"
    end
    out = out + "end\n\n"
    out
  end
end

# ─── C ABI Export ────────────────────────────────────────────────────

/// Generate a C header file from Tangerine @export functions.
pub def generate_c_header(module_path: str) -> Result[String, BindgenError]
  match fs::read_to_string(module_path.to_string())
  when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
  when Result::Ok(content) then
    mut out = String::new()
    out = out + "/* Auto-generated C header for Tangerine module */\n"
    out = out + "#ifndef TANGERINE_" + &_header_guard(module_path) + "_H\n"
    out = out + "#define TANGERINE_" + &_header_guard(module_path) + "_H\n\n"
    out = out + "#include <stdint.h>\n#include <stddef.h>\n\n"
    out = out + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"

    ## Parse @export / @ffi_export annotated functions from Tangerine source
    let lines = content.lines()
    mut i = 0
    while i < lines.len() do
      let trimmed = lines[i].trim()
      if trimmed.starts_with("@export") || trimmed.starts_with("@ffi_export") then
        ## Look ahead for the function signature on subsequent lines
        mut j = i + 1
        while j < lines.len() do
          let next = lines[j].trim()
          if next.is_empty() || next.starts_with("@") || next.starts_with("##") then
            j = j + 1
            continue
          end
          ## Parse "pub def name(params) -> RetType" or "def name(...)"
          if next.starts_with("pub def ") || next.starts_with("def ") then
            let sig_start = if next.starts_with("pub def ") then 8 else 4 end
            let rest = next.substring(sig_start, next.len() as Int)
            let paren_pos = rest.find("(")
            match paren_pos
            when Option::Some(pp) then
              let fn_name = rest.substring(0, pp as Int).trim()
              let close_paren = rest.rfind(")")
              match close_paren
              when Option::Some(cp) then
                let params_str = rest.substring((pp + 1) as Int, cp as Int)
                let after = rest.substring((cp + 1) as Int, rest.len() as Int).trim()
                ## Parse return type
                let c_ret = if after.starts_with("->") then
                  let ret_name = after.substring(2, after.len() as Int).trim()
                  _tg_type_to_c(ret_name)
                else
                  "void"
                end
                ## Parse parameters
                mut c_params = Array::new()
                if !params_str.is_empty() then
                  let parts = params_str.split(",")
                  for part in parts do
                    let p = part.trim()
                    let colon = p.find(":")
                    match colon
                    when Option::Some(cpos) then
                      let pname = p.substring(0, cpos as Int).trim()
                      ## Strip mut/ref markers from param name
                      let clean_name = if pname.starts_with("mut ") then
                        pname.substring(4, pname.len() as Int).trim()
                      else
                        pname
                      end
                      let ptype = p.substring((cpos + 1) as Int, p.len() as Int).trim()
                      c_params.push((_tg_type_to_c(ptype).to_string() + " " + clean_name))
                    when Option::None then
                      if !p.is_empty() then
                        c_params.push(p.to_string())
                      end
                    end
                  end
                end
                ## Emit C declaration
                out = out + c_ret + " " + fn_name + "("
                if c_params.is_empty() then
                  out = out + "void"
                else
                  mut pidx = 0
                  for cp in c_params do
                    if pidx > 0 then out = out + ", " end
                    out = out + cp
                    pidx = pidx + 1
                  end
                end
                out = out + ");\n\n"
              when Option::None then ()
              end
            when Option::None then ()
            end
          end
          break
        end
      end
      i = i + 1
    end

    out = out + "#ifdef __cplusplus\n}\n#endif\n\n"
    out = out + "#endif /* TANGERINE_" + &_header_guard(module_path) + "_H */\n"
    Result::Ok(out)
  end
end

# ─── Errors ──────────────────────────────────────────────────────────

pub enum BindgenError
  IoError(String)
  ParseError(String)
  UnsupportedType(String)
  InvalidConfig(String)
end

impl Display for BindgenError
  def fmt(self: Self) -> String
    match self
    when BindgenError::IoError(msg) then "bindgen I/O error: " + msg
    when BindgenError::ParseError(msg) then "bindgen parse error: " + msg
    when BindgenError::UnsupportedType(ty) then "unsupported C type: " + ty
    when BindgenError::InvalidConfig(msg) then "bindgen config error: " + msg
    end
  end
end

pub struct FfiError
  pub message: String
end

# ─── Recursive-descent C header parser ───────────────────────────────

enum CToken
  Ident(String)
  IntLit(i64)
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Semi
  Comma
  Star
  Eq
  Ellipsis
  Arrow
  KwStruct
  KwUnion
  KwEnum
  KwTypedef
  KwConst
  KwVoid
  KwExtern
  KwStatic
  KwInline
  KwVolatile
  KwUnsigned
  KwSigned
  KwChar
  KwShort
  KwInt
  KwLong
  KwFloat
  KwDouble
  KwBool
  Eof
end

struct CHeaderParser
  src: String
  pos: Int
  tokens: Array[CToken]
  tok_pos: Int
end

impl CHeaderParser
  def new(source: String) -> CHeaderParser
    let mut p = CHeaderParser {
      src: source,
      pos: 0,
      tokens: Array::new(),
      tok_pos: 0,
    }
    p.tokenize()
    p
  end

  ## ── Tokenizer ──────────────────────────────────────────────────
  def tokenize(inout self)
    let len = self.src.len()
    while self.pos < len do
      let ch = self.src.char_at(self.pos)
      ## Skip whitespace
      if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' then
        self.pos = self.pos + 1
        continue
      end
      ## Skip // comments
      if ch == '/' && self.pos + 1 < len && self.src.char_at(self.pos + 1) == '/' then
        while self.pos < len && self.src.char_at(self.pos) != '\n' do
          self.pos = self.pos + 1
        end
        continue
      end
      ## Skip /* */ comments
      if ch == '/' && self.pos + 1 < len && self.src.char_at(self.pos + 1) == '*' then
        self.pos = self.pos + 2
        while self.pos + 1 < len do
          if self.src.char_at(self.pos) == '*' && self.src.char_at(self.pos + 1) == '/' then
            self.pos = self.pos + 2
            break
          end
          self.pos = self.pos + 1
        end
        continue
      end
      ## Skip preprocessor lines (# directives) — but extract #define constants
      if ch == '#' then
        let directive_start = self.pos
        self.pos = self.pos + 1
        self._skip_whitespace_inline()
        let word = self._read_ident_raw()
        if word == "define" then
          self._skip_whitespace_inline()
          let macro_name = self._read_ident_raw()
          if !macro_name.is_empty() then
            self._skip_whitespace_inline()
            ## Only simple integer constants: #define NAME 123
            if self.pos < len then
              let nc = self.src.char_at(self.pos)
              if nc >= '0' && nc <= '9' then
                let val = self._read_int_raw()
                self.tokens.push(CToken::KwConst)
                self.tokens.push(CToken::KwInt)
                self.tokens.push(CToken::Ident(macro_name))
                self.tokens.push(CToken::Eq)
                self.tokens.push(CToken::IntLit(val))
                self.tokens.push(CToken::Semi)
              end
            end
          end
        end
        ## Skip rest of line (handles multi-line with backslash)
        while self.pos < len do
          let lc = self.src.char_at(self.pos)
          if lc == '\n' then
            self.pos = self.pos + 1
            break
          end
          if lc == '\\' && self.pos + 1 < len && self.src.char_at(self.pos + 1) == '\n' then
            self.pos = self.pos + 2
            continue
          end
          self.pos = self.pos + 1
        end
        continue
      end
      ## Punctuation
      if ch == '(' then self.tokens.push(CToken::LParen); self.pos = self.pos + 1; continue end
      if ch == ')' then self.tokens.push(CToken::RParen); self.pos = self.pos + 1; continue end
      if ch == '{' then self.tokens.push(CToken::LBrace); self.pos = self.pos + 1; continue end
      if ch == '}' then self.tokens.push(CToken::RBrace); self.pos = self.pos + 1; continue end
      if ch == '[' then self.tokens.push(CToken::LBracket); self.pos = self.pos + 1; continue end
      if ch == ']' then self.tokens.push(CToken::RBracket); self.pos = self.pos + 1; continue end
      if ch == ';' then self.tokens.push(CToken::Semi); self.pos = self.pos + 1; continue end
      if ch == ',' then self.tokens.push(CToken::Comma); self.pos = self.pos + 1; continue end
      if ch == '*' then self.tokens.push(CToken::Star); self.pos = self.pos + 1; continue end
      if ch == '=' then self.tokens.push(CToken::Eq); self.pos = self.pos + 1; continue end
      if ch == '.' && self.pos + 2 < len && self.src.char_at(self.pos + 1) == '.' && self.src.char_at(self.pos + 2) == '.' then
        self.tokens.push(CToken::Ellipsis); self.pos = self.pos + 3; continue
      end
      if ch == '-' && self.pos + 1 < len && self.src.char_at(self.pos + 1) == '>' then
        self.tokens.push(CToken::Arrow); self.pos = self.pos + 2; continue
      end
      ## Integer literals
      if ch >= '0' && ch <= '9' then
        let val = self._read_int_raw()
        self.tokens.push(CToken::IntLit(val))
        continue
      end
      ## Negative integer literals
      if ch == '-' && self.pos + 1 < len then
        let next_c = self.src.char_at(self.pos + 1)
        if next_c >= '0' && next_c <= '9' then
          self.pos = self.pos + 1
          let val = self._read_int_raw()
          self.tokens.push(CToken::IntLit(-val))
          continue
        end
      end
      ## Identifiers / keywords
      if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' then
        let word = self._read_ident_raw()
        let tok = match word.as_str()
        when "struct" then CToken::KwStruct
        when "union" then CToken::KwUnion
        when "enum" then CToken::KwEnum
        when "typedef" then CToken::KwTypedef
        when "const" then CToken::KwConst
        when "void" then CToken::KwVoid
        when "extern" then CToken::KwExtern
        when "static" then CToken::KwStatic
        when "inline" then CToken::KwInline
        when "__inline" then CToken::KwInline
        when "__inline__" then CToken::KwInline
        when "volatile" then CToken::KwVolatile
        when "__volatile__" then CToken::KwVolatile
        when "unsigned" then CToken::KwUnsigned
        when "signed" then CToken::KwSigned
        when "char" then CToken::KwChar
        when "short" then CToken::KwShort
        when "int" then CToken::KwInt
        when "long" then CToken::KwLong
        when "float" then CToken::KwFloat
        when "double" then CToken::KwDouble
        when "bool" then CToken::KwBool
        when "_Bool" then CToken::KwBool
        when _ then CToken::Ident(word)
        end
        self.tokens.push(tok)
        continue
      end
      ## Skip string literals
      if ch == '"' then
        self.pos = self.pos + 1
        while self.pos < len do
          let sc = self.src.char_at(self.pos)
          if sc == '\\' then self.pos = self.pos + 2; continue end
          if sc == '"' then self.pos = self.pos + 1; break end
          self.pos = self.pos + 1
        end
        continue
      end
      ## Skip char literals
      if ch == '\'' then
        self.pos = self.pos + 1
        while self.pos < len && self.src.char_at(self.pos) != '\'' do
          if self.src.char_at(self.pos) == '\\' then self.pos = self.pos + 1 end
          self.pos = self.pos + 1
        end
        if self.pos < len then self.pos = self.pos + 1 end
        continue
      end
      ## Skip unknown characters
      self.pos = self.pos + 1
    end
    self.tokens.push(CToken::Eof)
  end

  def _skip_whitespace_inline(inout self)
    let len = self.src.len()
    while self.pos < len do
      let c = self.src.char_at(self.pos)
      if c == ' ' || c == '\t' then self.pos = self.pos + 1
      else break end
    end
  end

  def _read_ident_raw(inout self) -> String
    let start = self.pos
    let len = self.src.len()
    while self.pos < len do
      let c = self.src.char_at(self.pos)
      if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' then
        self.pos = self.pos + 1
      else break end
    end
    self.src.substring(start, self.pos)
  end

  def _read_int_raw(inout self) -> i64
    let len = self.src.len()
    mut val: i64 = 0
    ## Handle hex: 0x...
    if self.pos + 1 < len && self.src.char_at(self.pos) == '0' then
      let nx = self.src.char_at(self.pos + 1)
      if nx == 'x' || nx == 'X' then
        self.pos = self.pos + 2
        while self.pos < len do
          let c = self.src.char_at(self.pos)
          if c >= '0' && c <= '9' then val = val * 16 + ((c as i64) - ('0' as i64))
          elsif c >= 'a' && c <= 'f' then val = val * 16 + ((c as i64) - ('a' as i64) + 10)
          elsif c >= 'A' && c <= 'F' then val = val * 16 + ((c as i64) - ('A' as i64) + 10)
          else break end
          self.pos = self.pos + 1
        end
        ## Skip U/L/UL suffixes
        while self.pos < len do
          let c = self.src.char_at(self.pos)
          if c == 'u' || c == 'U' || c == 'l' || c == 'L' then self.pos = self.pos + 1
          else break end
        end
        return val
      end
    end
    while self.pos < len do
      let c = self.src.char_at(self.pos)
      if c >= '0' && c <= '9' then
        val = val * 10 + ((c as i64) - ('0' as i64))
        self.pos = self.pos + 1
      else break end
    end
    ## Skip U/L suffixes
    while self.pos < len do
      let c = self.src.char_at(self.pos)
      if c == 'u' || c == 'U' || c == 'l' || c == 'L' then self.pos = self.pos + 1
      else break end
    end
    val
  end

  ## ── Token access ───────────────────────────────────────────────
  def peek(self) -> CToken
    self.tokens[self.tok_pos]
  end

  def advance(inout self) -> CToken
    let t = self.tokens[self.tok_pos]
    if self.tok_pos < self.tokens.len() - 1 then
      self.tok_pos = self.tok_pos + 1
    end
    t
  end

  def expect_semi(inout self) -> Result[Unit, String]
    match self.peek()
    when CToken::Semi then self.advance(); Result::Ok(())
    when _ then Result::Err("expected ';'".to_string())
    end
  end

  ## ── Top-level parser ───────────────────────────────────────────
  def parse_translation_unit(inout self) -> Result[Array[Declaration], String]
    mut decls = Array::new()
    while !self._at_eof() do
      match self._parse_top_level()
      when Result::Ok(maybe_decl) then
        match maybe_decl
        when Option::Some(d) then decls.push(d)
        when Option::None then ()
        end
      when Result::Err(e) then
        ## Skip to next semicolon or closing brace to recover
        self._skip_to_sync()
      end
    end
    Result::Ok(decls)
  end

  def _at_eof(self) -> Bool
    match self.peek()
    when CToken::Eof then true
    when _ then false
    end
  end

  def _skip_to_sync(inout self)
    while !self._at_eof() do
      match self.peek()
      when CToken::Semi then self.advance(); return
      when CToken::RBrace then self.advance(); return
      when _ then self.advance()
      end
    end
  end

  def _parse_top_level(inout self) -> Result[Option[Declaration], String]
    ## Skip storage class specifiers and qualifiers
    self._skip_storage_qualifiers()
    match self.peek()
    when CToken::KwTypedef then return self._parse_typedef()
    when CToken::KwStruct then return self._parse_struct_or_func()
    when CToken::KwUnion then return self._parse_union_decl()
    when CToken::KwEnum then return self._parse_enum_decl()
    when CToken::Eof then return Result::Ok(Option::None)
    when _ then ()
    end
    ## Possibly a function or variable declaration
    self._parse_func_or_var()
  end

  def _skip_storage_qualifiers(inout self)
    loop do
      match self.peek()
      when CToken::KwExtern then self.advance()
      when CToken::KwStatic then self.advance()
      when CToken::KwInline then self.advance()
      when CToken::KwVolatile then self.advance()
      when _ then break
      end
    end
  end

  ## ── Typedef ────────────────────────────────────────────────────
  def _parse_typedef(inout self) -> Result[Option[Declaration], String]
    self.advance()  ## consume 'typedef'
    ## typedef struct {... } Name;
    ## typedef enum {... } Name;
    ## typedef TYPE NAME;
    ## typedef RETTYPE (*NAME)(PARAMS);
    match self.peek()
    when CToken::KwStruct then
      self.advance()
      let tag = self._maybe_ident()
      match self.peek()
      when CToken::LBrace then
        let fields = self._parse_struct_body()?
        let name = self._expect_ident()?
        self.expect_semi()?
        let s = CStruct { name: name.clone(), fields: fields, packed: false }
        Result::Ok(Option::Some(Declaration::Typedef(name, CType::Struct(s))))
      when _ then
        let tag_name = match tag
        when Option::Some(t) then t
        when Option::None then return Result::Err("expected struct name".to_string())
        end
        let name = self._expect_ident()?
        self.expect_semi()?
        Result::Ok(Option::Some(Declaration::Typedef(name, CType::Typedef(tag_name, Box::new(CType::Void)))))
      end
    when CToken::KwEnum then
      self.advance()
      let _tag = self._maybe_ident()
      match self.peek()
      when CToken::LBrace then
        let variants = self._parse_enum_body()?
        let name = self._expect_ident()?
        self.expect_semi()?
        let e = CEnum { name: name.clone(), variants: variants }
        Result::Ok(Option::Some(Declaration::Typedef(name, CType::Enum(e))))
      when _ then
        let name = self._expect_ident()?
        self.expect_semi()?
        Result::Ok(Option::Some(Declaration::Typedef(name, CType::Int)))
      end
    when _ then
      ## typedef BASETYPE...
      let base = self._parse_type_specifier()?
      ## Check for function pointer: typedef RET (*NAME)(PARAMS);
      match self.peek()
      when CToken::LParen then
        self.advance()
        match self.peek()
        when CToken::Star then
          self.advance()
          let name = self._expect_ident()?
          self._expect_token_rparen()?
          self._expect_token_lparen()?
          let params = self._parse_param_types()?
          self._expect_token_rparen()?
          self.expect_semi()?
          let fp = CType::FuncPointer(params, Box::new(base))
          Result::Ok(Option::Some(Declaration::Typedef(name, fp)))
        when _ then
          self._skip_to_sync()
          Result::Ok(Option::None)
        end
      when _ then
        ## typedef TYPE *NAME or TYPE NAME
        mut ty = base
        while self._peek_is_star() do
          self.advance()
          match self._peek_is_const() 
          when true then self.advance(); ty = CType::ConstPointer(Box::new(ty))
          when false then ty = CType::Pointer(Box::new(ty))
          end
        end
        let name = self._expect_ident()?
        ## Array typedef: typedef int arr[10];
        match self.peek()
        when CToken::LBracket then
          self.advance()
          let size = self._parse_int_lit()?
          self._expect_token_rbracket()?
          ty = CType::Array(Box::new(ty), size as UInt)
        when _ then ()
        end
        self.expect_semi()?
        Result::Ok(Option::Some(Declaration::Typedef(name, ty)))
      end
    end
  end

  ## ── Struct ─────────────────────────────────────────────────────
  def _parse_struct_or_func(inout self) -> Result[Option[Declaration], String]
    self.advance()  ## consume 'struct'
    let name_opt = self._maybe_ident()
    match self.peek()
    when CToken::LBrace then
      let name = match name_opt
      when Option::Some(n) then n
      when Option::None then "_anon_struct".to_string()
      end
      let fields = self._parse_struct_body()?
      ## Possibly followed by variable name + ;
      match self.peek()
      when CToken::Semi then self.advance()
      when _ then
        let _var_name = self._maybe_ident()
        self.expect_semi()?
      end
      Result::Ok(Option::Some(Declaration::Struct(CStruct { name: name, fields: fields, packed: false })))
    when CToken::Semi then
      self.advance()
      Result::Ok(Option::None)
    when _ then
      ## Forward declaration or "struct Name var;" — skip
      self._skip_to_sync()
      Result::Ok(Option::None)
    end
  end

  def _parse_struct_body(inout self) -> Result[Array[CField], String]
    self.advance()  ## consume '{'
    mut fields = Array::new()
    while !self._at_eof() do
      match self.peek()
      when CToken::RBrace then self.advance(); return Result::Ok(fields)
      when _ then
        let ty = self._parse_full_type()?
        let fname = self._expect_ident()?
        ## Handle array fields: int buf[256];
        mut final_ty = ty
        match self.peek()
        when CToken::LBracket then
          self.advance()
          let sz = self._parse_int_lit()?
          self._expect_token_rbracket()?
          final_ty = CType::Array(Box::new(final_ty), sz as UInt)
        when _ then ()
        end
        self.expect_semi()?
        fields.push(CField { name: fname, ty: final_ty, doc: Option::None })
      end
    end
    Result::Err("unterminated struct body".to_string())
  end

  ## ── Union ──────────────────────────────────────────────────────
  def _parse_union_decl(inout self) -> Result[Option[Declaration], String]
    self.advance()  ## consume 'union'
    let name = match self._maybe_ident()
    when Option::Some(n) then n
    when Option::None then "_anon_union".to_string()
    end
    match self.peek()
    when CToken::LBrace then
      let fields = self._parse_struct_body()?
      match self.peek()
      when CToken::Semi then self.advance()
      when _ then ()
      end
      Result::Ok(Option::Some(Declaration::Union(CUnion { name: name, variants: fields })))
    when _ then
      self._skip_to_sync()
      Result::Ok(Option::None)
    end
  end

  ## ── Enum ───────────────────────────────────────────────────────
  def _parse_enum_decl(inout self) -> Result[Option[Declaration], String]
    self.advance()  ## consume 'enum'
    let name = match self._maybe_ident()
    when Option::Some(n) then n
    when Option::None then "_anon_enum".to_string()
    end
    match self.peek()
    when CToken::LBrace then
      let variants = self._parse_enum_body()?
      match self.peek()
      when CToken::Semi then self.advance()
      when _ then ()
      end
      Result::Ok(Option::Some(Declaration::Enum(CEnum { name: name, variants: variants })))
    when _ then
      self._skip_to_sync()
      Result::Ok(Option::None)
    end
  end

  def _parse_enum_body(inout self) -> Result[Array[(String, i64)], String]
    self.advance()  ## consume '{'
    mut variants = Array::new()
    mut next_val: i64 = 0
    while !self._at_eof() do
      match self.peek()
      when CToken::RBrace then self.advance(); return Result::Ok(variants)
      when CToken::Comma then self.advance(); continue
      when _ then
        let vname = self._expect_ident()?
        match self.peek()
        when CToken::Eq then
          self.advance()
          let val = self._parse_int_lit()?
          next_val = val
        when _ then ()
        end
        variants.push((vname, next_val))
        next_val = next_val + 1
        ## Optional comma
        match self.peek()
        when CToken::Comma then self.advance()
        when _ then ()
        end
      end
    end
    Result::Err("unterminated enum body".to_string())
  end

  ## ── Function or variable declaration ────────────────────────────
  def _parse_func_or_var(inout self) -> Result[Option[Declaration], String]
    let base_type = self._parse_type_specifier()?
    ## Parse pointer decorations and name
    mut ty = base_type.clone()
    while self._peek_is_star() do
      self.advance()
      match self._peek_is_const()
      when true then self.advance(); ty = CType::ConstPointer(Box::new(ty))
      when false then ty = CType::Pointer(Box::new(ty))
      end
    end
    let name = match self._maybe_ident()
    when Option::Some(n) then n
    when Option::None then
      ## Might be a standalone type specifier (e.g. bare struct ref) — skip
      self._skip_to_sync()
      return Result::Ok(Option::None)
    end
    ## Is this a function? Check for '('
    match self.peek()
    when CToken::LParen then
      self.advance()
      let (params, variadic) = self._parse_params()?
      self._expect_token_rparen()?
      ## Skip function body if present
      match self.peek()
      when CToken::LBrace then self._skip_braced_block()
      when CToken::Semi then self.advance()
      when _ then self._skip_to_sync()
      end
      let func = CFunction {
        name: name,
        params: params,
        return_type: ty,
        variadic: variadic,
        doc: Option::None,
      }
      Result::Ok(Option::Some(Declaration::Function(func)))
    when _ then
      ## Variable declaration — skip
      self._skip_to_sync()
      Result::Ok(Option::None)
    end
  end

  ## ── Parameter parsing ──────────────────────────────────────────
  def _parse_params(inout self) -> Result[(Array[(String, CType)], Bool), String]
    mut params = Array::new()
    mut variadic = false
    ## Handle void or empty
    match self.peek()
    when CToken::RParen then return Result::Ok((params, false))
    when CToken::KwVoid then
      self.advance()
      match self.peek()
      when CToken::RParen then return Result::Ok((params, false))
      when _ then
        ## "void *ptr" — reparse as full param
        let name = self._expect_ident()?
        params.push((name, CType::Pointer(Box::new(CType::Void))))
      end
    when _ then ()
    end
    ## Parse first param (if not already parsed above from void*)
    if params.is_empty() then
      let (pname, pty, is_variadic) = self._parse_one_param()?
      if is_variadic then
        return Result::Ok((params, true))
      end
      params.push((pname, pty))
    end
    ## Parse remaining params
    loop do
      match self.peek()
      when CToken::Comma then
        self.advance()
        match self.peek()
        when CToken::Ellipsis then
          self.advance()
          variadic = true
          break
        when _ then
          let (pname, pty, is_v) = self._parse_one_param()?
          if is_v then variadic = true; break end
          params.push((pname, pty))
        end
      when _ then break
      end
    end
    Result::Ok((params, variadic))
  end

  def _parse_one_param(inout self) -> Result[(String, CType, Bool), String]
    match self.peek()
    when CToken::Ellipsis then
      self.advance()
      return Result::Ok(("...".to_string(), CType::Void, true))
    when _ then ()
    end
    let ty = self._parse_full_type()?
    let name = match self._maybe_ident()
    when Option::Some(n) then n
    when Option::None then "_arg".to_string()
    end
    ## Handle array param: int arr[]
    mut final_ty = ty
    match self.peek()
    when CToken::LBracket then
      self.advance()
      match self.peek()
      when CToken::RBracket then self.advance()
      when _ then
        let _sz = self._parse_int_lit()?
        self._expect_token_rbracket()?
      end
      final_ty = CType::Pointer(Box::new(final_ty))
    when _ then ()
    end
    Result::Ok((name, final_ty, false))
  end

  ## Parse types used in function pointer param lists (no names)
  def _parse_param_types(inout self) -> Result[Array[CType], String]
    mut types = Array::new()
    match self.peek()
    when CToken::RParen then return Result::Ok(types)
    when CToken::KwVoid then
      self.advance()
      match self.peek()
      when CToken::RParen then return Result::Ok(types)
      when _ then types.push(CType::Pointer(Box::new(CType::Void)))
      end
    when _ then ()
    end
    if types.is_empty() then
      types.push(self._parse_full_type()?)
      let _ = self._maybe_ident()  ## optional param name
    end
    loop do
      match self.peek()
      when CToken::Comma then
        self.advance()
        match self.peek()
        when CToken::Ellipsis then self.advance(); break
        when _ then
          types.push(self._parse_full_type()?)
          let _ = self._maybe_ident()
        end
      when _ then break
      end
    end
    Result::Ok(types)
  end

  ## ── Type parsing ───────────────────────────────────────────────
  def _parse_full_type(inout self) -> Result[CType, String]
    ## Parse base type then pointer/const decorations
    let base = self._parse_type_specifier()?
    mut ty = base
    while self._peek_is_star() do
      self.advance()
      match self._peek_is_const()
      when true then self.advance(); ty = CType::ConstPointer(Box::new(ty))
      when false then ty = CType::Pointer(Box::new(ty))
      end
    end
    Result::Ok(ty)
  end

  def _parse_type_specifier(inout self) -> Result[CType, String]
    ## Skip leading const/volatile
    self._skip_cv_qualifiers()
    match self.peek()
    when CToken::KwVoid then self.advance(); Result::Ok(CType::Void)
    when CToken::KwBool then self.advance(); Result::Ok(CType::Bool)
    when CToken::KwFloat then self.advance(); Result::Ok(CType::Float)
    when CToken::KwDouble then self.advance(); Result::Ok(CType::Double)
    when CToken::KwChar then
      self.advance()
      Result::Ok(CType::Char)
    when CToken::KwShort then
      self.advance()
      self._skip_int_keyword()
      Result::Ok(CType::Short)
    when CToken::KwInt then
      self.advance()
      Result::Ok(CType::Int)
    when CToken::KwLong then
      self.advance()
      match self.peek()
      when CToken::KwLong then
        self.advance()
        self._skip_int_keyword()
        Result::Ok(CType::LongLong)
      when CToken::KwDouble then
        self.advance()
        Result::Ok(CType::Double)
      when CToken::KwInt then
        self.advance()
        Result::Ok(CType::Long)
      when _ then Result::Ok(CType::Long)
      end
    when CToken::KwUnsigned then
      self.advance()
      match self.peek()
      when CToken::KwChar then self.advance(); Result::Ok(CType::UChar)
      when CToken::KwShort then self.advance(); self._skip_int_keyword(); Result::Ok(CType::UShort)
      when CToken::KwInt then self.advance(); Result::Ok(CType::UInt)
      when CToken::KwLong then
        self.advance()
        match self.peek()
        when CToken::KwLong then self.advance(); self._skip_int_keyword(); Result::Ok(CType::ULongLong)
        when KwInt then self.advance(); Result::Ok(CType::ULong)
        when _ then Result::Ok(CType::ULong)
        end
      when _ then Result::Ok(CType::UInt)
      end
    when CToken::KwSigned then
      self.advance()
      match self.peek()
      when CToken::KwChar then self.advance(); Result::Ok(CType::Char)
      when CToken::KwShort then self.advance(); self._skip_int_keyword(); Result::Ok(CType::Short)
      when CToken::KwInt then self.advance(); Result::Ok(CType::Int)
      when CToken::KwLong then
        self.advance()
        match self.peek()
        when CToken::KwLong then self.advance(); self._skip_int_keyword(); Result::Ok(CType::LongLong)
        when _ then Result::Ok(CType::Long)
        end
      when _ then Result::Ok(CType::Int)
      end
    when CToken::KwStruct then
      self.advance()
      let name = self._expect_ident()?
      match self.peek()
      when CToken::LBrace then
        let fields = self._parse_struct_body()?
        Result::Ok(CType::Struct(CStruct { name: name, fields: fields, packed: false }))
      when _ then
        Result::Ok(CType::Struct(CStruct { name: name, fields: Array::new(), packed: false }))
      end
    when CToken::KwUnion then
      self.advance()
      let name = self._expect_ident()?
      Result::Ok(CType::Union(CUnion { name: name, variants: Array::new() }))
    when CToken::KwEnum then
      self.advance()
      let name = self._expect_ident()?
      Result::Ok(CType::Enum(CEnum { name: name, variants: Array::new() }))
    when CToken::Ident(name) then
      self.advance()
      ## Known standard types
      if name == "size_t" || name == "SIZE_T" then Result::Ok(CType::SizeT)
      elsif name == "ssize_t" then Result::Ok(CType::Long)
      elsif name == "int8_t" || name == "__int8" then Result::Ok(CType::Char)
      elsif name == "uint8_t" then Result::Ok(CType::UChar)
      elsif name == "int16_t" || name == "__int16" then Result::Ok(CType::Short)
      elsif name == "uint16_t" then Result::Ok(CType::UShort)
      elsif name == "int32_t" || name == "__int32" then Result::Ok(CType::Int)
      elsif name == "uint32_t" then Result::Ok(CType::UInt)
      elsif name == "int64_t" || name == "__int64" then Result::Ok(CType::LongLong)
      elsif name == "uint64_t" then Result::Ok(CType::ULongLong)
      elsif name == "intptr_t" || name == "ptrdiff_t" then Result::Ok(CType::Long)
      elsif name == "uintptr_t" then Result::Ok(CType::ULong)
      else Result::Ok(CType::Typedef(name.clone(), Box::new(CType::Int)))
      end
    when _ then
      Result::Err("expected type specifier".to_string())
    end
  end

  ## ── Helpers ────────────────────────────────────────────────────
  def _skip_cv_qualifiers(inout self)
    loop do
      match self.peek()
      when CToken::KwConst then self.advance()
      when CToken::KwVolatile then self.advance()
      when _ then break
      end
    end
  end

  def _skip_int_keyword(inout self)
    match self.peek()
    when CToken::KwInt then self.advance(); ()
    when _ then ()
    end
  end

  def _peek_is_star(self) -> Bool
    match self.peek()
    when CToken::Star then true
    when _ then false
    end
  end

  def _peek_is_const(self) -> Bool
    match self.peek()
    when CToken::KwConst then true
    when _ then false
    end
  end

  def _maybe_ident(inout self) -> Option[String]
    match self.peek()
    when CToken::Ident(name) then
      let n = name.clone()
      self.advance()
      Option::Some(n)
    when _ then Option::None
    end
  end

  def _expect_ident(inout self) -> Result[String, String]
    match self.peek()
    when CToken::Ident(name) then
      let n = name.clone()
      self.advance()
      Result::Ok(n)
    when _ then Result::Err("expected identifier".to_string())
    end
  end

  def _expect_token_lparen(inout self) -> Result[Unit, String]
    match self.peek()
    when CToken::LParen then self.advance(); Result::Ok(())
    when _ then Result::Err("expected '('".to_string())
    end
  end

  def _expect_token_rparen(inout self) -> Result[Unit, String]
    match self.peek()
    when CToken::RParen then self.advance(); Result::Ok(())
    when _ then Result::Err("expected ')'".to_string())
    end
  end

  def _expect_token_rbracket(inout self) -> Result[Unit, String]
    match self.peek()
    when CToken::RBracket then self.advance(); Result::Ok(())
    when _ then Result::Err("expected ']'".to_string())
    end
  end

  def _parse_int_lit(inout self) -> Result[i64, String]
    match self.peek()
    when CToken::IntLit(v) then
      let val = *v
      self.advance()
      Result::Ok(val)
    when _ then Result::Err("expected integer literal".to_string())
    end
  end

  def _skip_braced_block(inout self)
    self.advance()  ## consume '{'
    mut depth = 1
    while !self._at_eof() && depth > 0 do
      match self.peek()
      when CToken::LBrace then
        depth = depth + 1
        self.advance()
      when CToken::RBrace then
        depth = depth - 1
        self.advance()
      when _ then self.advance()
      end
    end
  end
end

## Map Tangerine types to C types for @export header generation
def _tg_type_to_c(ty_str: str) -> String
  let t = ty_str.trim()
  if t == "Unit" || t == "()" then "void"
  elsif t == "Bool" then "bool"
  elsif t == "i8" then "int8_t"
  elsif t == "u8" then "uint8_t"
  elsif t == "i16" then "int16_t"
  elsif t == "u16" then "uint16_t"
  elsif t == "i32" || t == "Int" then "int32_t"
  elsif t == "u32" || t == "UInt" then "uint32_t"
  elsif t == "i64" then "int64_t"
  elsif t == "u64" then "uint64_t"
  elsif t == "f32" then "float"
  elsif t == "f64" || t == "Float" then "double"
  elsif t == "String" || t == "&str" then "const char*"
  elsif t.starts_with("&mut ") then
    let inner = t.substring(5, t.len() as Int).trim()
    _tg_type_to_c(inner).to_string() + "*"
  elsif t.starts_with("&") then
    let inner = t.substring(1, t.len() as Int).trim()
    "const " + &_tg_type_to_c(inner) + "*"
  elsif t.starts_with("PtrMut[") then
    let inner = t.substring(7, t.len() as Int - 1).trim()
    _tg_type_to_c(inner).to_string() + "*"
  elsif t.starts_with("Ptr[") then
    let inner = t.substring(4, t.len() as Int - 1).trim()
    "const " + &_tg_type_to_c(inner) + "*"
  else
    t.to_string()
  end
end

# ─── Internal helpers ────────────────────────────────────────────────

def _default_c_type_mappings() -> Map[String, String]
  var m = Map::new()
  m.insert("void".to_string(), "Unit".to_string())
  m.insert("int".to_string(), "i32".to_string())
  m.insert("unsigned int".to_string(), "u32".to_string())
  m.insert("long".to_string(), "i64".to_string())
  m.insert("unsigned long".to_string(), "u64".to_string())
  m.insert("char".to_string(), "i8".to_string())
  m.insert("unsigned char".to_string(), "u8".to_string())
  m.insert("short".to_string(), "i16".to_string())
  m.insert("unsigned short".to_string(), "u16".to_string())
  m.insert("float".to_string(), "f32".to_string())
  m.insert("double".to_string(), "f64".to_string())
  m.insert("size_t".to_string(), "UInt".to_string())
  m.insert("ssize_t".to_string(), "Int".to_string())
  m.insert("bool".to_string(), "Bool".to_string())
  m.insert("_Bool".to_string(), "Bool".to_string())
  m.insert("int8_t".to_string(), "i8".to_string())
  m.insert("uint8_t".to_string(), "u8".to_string())
  m.insert("int16_t".to_string(), "i16".to_string())
  m.insert("uint16_t".to_string(), "u16".to_string())
  m.insert("int32_t".to_string(), "i32".to_string())
  m.insert("uint32_t".to_string(), "u32".to_string())
  m.insert("int64_t".to_string(), "i64".to_string())
  m.insert("uint64_t".to_string(), "u64".to_string())
  m
end

def _default_rust_type_mappings() -> Map[String, String]
  var m = _default_c_type_mappings()
  m.insert("i8".to_string(), "i8".to_string())
  m.insert("u8".to_string(), "u8".to_string())
  m.insert("i16".to_string(), "i16".to_string())
  m.insert("u16".to_string(), "u16".to_string())
  m.insert("i32".to_string(), "i32".to_string())
  m.insert("u32".to_string(), "u32".to_string())
  m.insert("i64".to_string(), "i64".to_string())
  m.insert("u64".to_string(), "u64".to_string())
  m.insert("f32".to_string(), "f32".to_string())
  m.insert("f64".to_string(), "f64".to_string())
  m.insert("usize".to_string(), "UInt".to_string())
  m.insert("isize".to_string(), "Int".to_string())
  m.insert("bool".to_string(), "Bool".to_string())
  m.insert("String".to_string(), "String".to_string())
  m
end

def _ctype_to_tg(ct: CType, mappings: Map[String, String]) -> String
  match ct
  when CType::Void then "Unit"
  when CType::Bool then "Bool"
  when CType::Char then "i64"
  when CType::Short then "i64"
  when CType::Int then "i64"
  when CType::Long then "i64"
  when CType::LongLong then "i64"
  when CType::UChar then "u64"
  when CType::UShort then "u64"
  when CType::UInt then "u64"
  when CType::ULong then "u64"
  when CType::ULongLong then "u64"
  when CType::Float then "f32"
  when CType::Double then "f64"
  when CType::SizeT then "UInt"
  when CType::Pointer(inner) then "PtrMut[" + &_ctype_to_tg(inner, mappings) + "]"
  when CType::ConstPointer(inner) then "Ptr[" + &_ctype_to_tg(inner, mappings) + "]"
  when CType::Array(inner, size) then "[" + &_ctype_to_tg(inner, mappings) + "; " + &size.to_string() + "]"
  when CType::FuncPointer(params, ret) then
    mut s = "fn("
    mut idx = 0
    for p in params do
      match idx > 0
      when true then s = s + ", "
      when false then ()
      end
      s = s + &_ctype_to_tg(p, mappings)
      idx = idx + 1
    end
    s + ") -> " + &_ctype_to_tg(ret, mappings)
  when CType::Struct(s) then s.name.clone()
  when CType::Union(u) then u.name.clone()
  when CType::Enum(e) then e.name.clone()
  when CType::Typedef(name, _) then name.clone()
  when _ then "Unit"
  end
end

def _ctype_to_tg_safe(ct: CType, mappings: Map[String, String]) -> String
  ## Same as _ctype_to_tg but converts raw pointers to references
  match ct
  when CType::Pointer(inner) then "&mut " + &_ctype_to_tg_safe(inner, mappings)
  when CType::ConstPointer(inner) then "&" + &_ctype_to_tg_safe(inner, mappings)
  when _ then _ctype_to_tg(ct, mappings)
  end
end

def _parse_c_function(line: str) -> Option[CFunction]
  ## Parse a C function declaration like: int foo(int x, char *y);
  ## or: void bar(void);
  let trimmed = line.trim()
  ## Must contain '(' and end with ');'
  let paren_open = trimmed.find("(")
  match paren_open
  when Option::None then return None
  when Option::Some(open_pos) then
    let before_paren = trimmed.substring(0, open_pos as Int).trim()
    ## Split into return type + name: "int foo" → ("int", "foo")
    let last_space = before_paren.rfind(" ")
    match last_space
    when Option::None then return None
    when Option::Some(sp) then
      let ret_str = before_paren.substring(0, sp as Int).trim()
      mut fn_name = before_paren.substring((sp + 1) as Int, before_paren.len() as Int).trim().to_string()
      if fn_name.is_empty() then return None end

      ## Handle pointer return: "int *get_ptr" → ret is pointer to int
      mut ptr_depth = 0
      while fn_name.starts_with("*") do
        fn_name = fn_name.substring(1, fn_name.len() as Int)
        ptr_depth = ptr_depth + 1
      end

      mut ret_type = _parse_c_type_str(ret_str)
      mut i = 0
      while i < ptr_depth do
        ret_type = CType::Pointer(Box::new(ret_type))
        i = i + 1
      end

      ## Parse parameters between ( and )
      let close_pos = trimmed.rfind(")")
      match close_pos
      when Option::None then return None
      when Option::Some(cp) then
        let params_str = trimmed.substring((open_pos + 1) as Int, cp as Int).trim()
        mut params = Array::new()
        mut variadic = false
        if params_str != "void" && !params_str.is_empty() then
          let param_parts = params_str.split(",")
          for part in param_parts do
            let p = part.trim()
            if p == "..." then
              variadic = true
            else
              ## Parse "type name" or just "type"
              let psp = p.rfind(" ")
              match psp
              when Option::Some(ps) then
                let p_type_str = p.substring(0, ps as Int).trim()
                mut p_name = p.substring((ps + 1) as Int, p.len() as Int).trim().to_string()
                ## Handle pointer in name: "char *name"
                if p_name.starts_with("*") then
                  p_name = p_name.substring(1, p_name.len() as Int)
                end
                params.push((p_name, _parse_c_type_str(p_type_str)))
              when Option::None then
                params.push(("arg".to_string(), _parse_c_type_str(p)))
              end
            end
          end
        end

        return Some(CFunction {
          name: fn_name.to_string(),
          params: params,
          return_type: ret_type,
          variadic: variadic,
          doc: None,
        })
      end
    end
  end
  None
end

def _parse_c_type_str(s: str) -> CType
  let trimmed = s.trim()
  if trimmed == "void" then CType::Void
  elsif trimmed == "int" then CType::Int
  elsif trimmed == "unsigned int" || trimmed == "unsigned" then CType::UInt
  elsif trimmed == "long" then CType::Long
  elsif trimmed == "unsigned long" then CType::ULong
  elsif trimmed == "long long" then CType::LongLong
  elsif trimmed == "unsigned long long" then CType::ULongLong
  elsif trimmed == "char" then CType::Char
  elsif trimmed == "unsigned char" then CType::UChar
  elsif trimmed == "short" then CType::Short
  elsif trimmed == "unsigned short" then CType::UShort
  elsif trimmed == "float" then CType::Float
  elsif trimmed == "double" then CType::Double
  elsif trimmed == "size_t" then CType::SizeT
  elsif trimmed == "bool" || trimmed == "_Bool" then CType::Bool
  elsif trimmed.ends_with("*") then
    let inner = trimmed.substring(0, (trimmed.len() - 1) as Int).trim()
    if inner.starts_with("const ") then
      CType::ConstPointer(Box::new(_parse_c_type_str(inner.substring(6, inner.len() as Int))))
    else
      CType::Pointer(Box::new(_parse_c_type_str(inner)))
    end
  elsif trimmed.starts_with("const ") then
    _parse_c_type_str(trimmed.substring(6, trimmed.len() as Int))
  else
    CType::Typedef(trimmed.to_string(), Box::new(CType::Int))
  end
end

def _header_guard(path: str) -> String
  path.replace("/", "_").replace(".", "_").replace("-", "_").to_uppercase()
end

def _parse_rust_fn_signature(fn_part: String) -> (Array[(String, CType)], CType)
  ## Parse Rust function signature: name(params) -> return_type
  ## Returns (params, return_type)
  mut params = Array::new()
  mut return_type = CType::Void
  
  # Find the parameter list
  let paren_open = fn_part.find("(")
  let paren_close = fn_part.find(")")
  
  match (paren_open, paren_close)
  when (Option::Some(open_pos), Option::Some(close_pos)) then
    # Extract parameters
    let params_str = fn_part.substring((open_pos + 1) as Int, close_pos as Int)
    if !params_str.is_empty() then
      let param_parts = params_str.split(",")
      for part in param_parts do
        let trimmed = part.trim()
        if !trimmed.is_empty() then
          # Parse "name: type" or "&type" or "type"
          let colon_pos = trimmed.find(":")
          match colon_pos
          when Option::Some(col_pos) then
            let pname = trimmed.substring(0, col_pos as Int).trim().to_string()
            let ptype_str = trimmed.substring((col_pos + 1) as Int, trimmed.len() as Int).trim()
            let ptype = _parse_rust_type_str(ptype_str)
            params.push((pname, ptype))
          when Option::None then
            # No name, just type
            let ptype = _parse_rust_type_str(trimmed)
            params.push(("_arg".to_string(), ptype))
          end
        end
      end
    end
    
    # Find return type after ')'
    let after_paren = fn_part.substring((close_pos + 1) as Int, fn_part.len() as Int).trim()
    if after_paren.starts_with("->") then
      let ret_str = after_paren.substring(2, after_paren.len() as Int).trim()
      return_type = _parse_rust_type_str(ret_str)
    end
  when _ then ()
  end
  
  (params, return_type)
end

def _parse_rust_type_str(s: str) -> CType
  let trimmed = s.trim()
  if trimmed.is_empty() then return CType::Void end
  
  # Remove lifetime annotations like 'a, 'static
  let without_lifetime = if trimmed.starts_with("&'") then
    let space_pos = trimmed.find(" ")
    match space_pos
    when Option::Some(pos) then "&" + trimmed.substring((pos + 1) as Int, trimmed.len() as Int)
    when Option::None then trimmed
    end
  else
    trimmed.to_string()
  end
  
  # Handle references
  if without_lifetime.starts_with("&mut ") then
    let inner = without_lifetime.substring(5, without_lifetime.len() as Int).trim()
    CType::Pointer(Box::new(_parse_rust_type_str(inner)))
  elsif without_lifetime.starts_with("&") then
    let inner = without_lifetime.substring(1, without_lifetime.len() as Int).trim()
    CType::ConstPointer(Box::new(_parse_rust_type_str(inner)))
  elsif without_lifetime == "i8" then CType::Char
  elsif without_lifetime == "u8" then CType::UChar
  elsif without_lifetime == "i16" then CType::Short
  elsif without_lifetime == "u16" then CType::UShort
  elsif without_lifetime == "i32" then CType::Int
  elsif without_lifetime == "u32" then CType::UInt
  elsif without_lifetime == "i64" || without_lifetime == "isize" then CType::LongLong
  elsif without_lifetime == "u64" || without_lifetime == "usize" then CType::ULongLong
  elsif without_lifetime == "f32" then CType::Float
  elsif without_lifetime == "f64" then CType::Double
  elsif without_lifetime == "bool" then CType::Bool
  elsif without_lifetime == "()" then CType::Void
  elsif without_lifetime == "c_char" then CType::Char
  elsif without_lifetime == "c_int" then CType::Int
  elsif without_lifetime == "c_uint" then CType::UInt
  elsif without_lifetime == "c_long" then CType::Long
  elsif without_lifetime == "c_ulong" then CType::ULong
  elsif without_lifetime == "c_void" then CType::Void
  elsif without_lifetime.starts_with("Ptr[") then
    let inner = without_lifetime.substring(7, without_lifetime.len() as Int).trim()
    CType::ConstPointer(Box::new(_parse_rust_type_str(inner)))
  elsif without_lifetime.starts_with("*mut ") then
    let inner = without_lifetime.substring(5, without_lifetime.len() as Int).trim()
    CType::Pointer(Box::new(_parse_rust_type_str(inner)))
  else
    # Unknown type - treat as typedef
    CType::Typedef(without_lifetime.to_string(), Box::new(CType::Void))
  end
end

# end ## module tg_compiler::bindgen
