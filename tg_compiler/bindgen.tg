## tg_compiler::bindgen — FFI binding generator
## Generate Tangerine bindings from C headers, Rust crates, and export C ABI.
## Spec: §tooling.bindgen

# module tg_compiler::bindgen

use std::core::{Option, Result, Display}
use std::collections::{Map, Array}
use std::fs

# ─── Configuration ───────────────────────────────────────────────────

pub struct BindgenConfig
  pub input: BindgenInput
  pub output_path: String
  pub module_name: String
  pub allowlist: Array[String]
  pub blocklist: Array[String]
  pub type_mappings: Map[String, String]
  pub generate_docs: Bool
  pub safety: BindgenSafety
end

pub enum BindgenInput
  CHeader(String)
  CHeaders(Array[String])
  RustCrate(String)
  WitFile(String)
end

pub enum BindgenSafety
  AllUnsafe
  SafeWrappers
  Trusted
end

impl BindgenConfig
  pub def from_c_header(header: &str, module: &str) -> BindgenConfig
    BindgenConfig {
      input: BindgenInput::CHeader(header.to_string()),
      output_path: module.to_string() + "_ffi.tg",
      module_name: module.to_string(),
      allowlist: Array::new(),
      blocklist: Array::new(),
      type_mappings: _default_c_type_mappings(),
      generate_docs: true,
      safety: BindgenSafety::SafeWrappers,
    }
  end

  pub def from_rust(crate_path: &str, module: &str) -> BindgenConfig
    BindgenConfig {
      input: BindgenInput::RustCrate(crate_path.to_string()),
      output_path: module.to_string() + "_ffi.tg",
      module_name: module.to_string(),
      allowlist: Array::new(),
      blocklist: Array::new(),
      type_mappings: _default_rust_type_mappings(),
      generate_docs: true,
      safety: BindgenSafety::SafeWrappers,
    }
  end
end

# ─── C type representation ───────────────────────────────────────────

pub enum CType
  Void
  Bool
  Char
  UChar
  Short
  UShort
  Int
  UInt
  Long
  ULong
  LongLong
  ULongLong
  Float
  Double
  SizeT
  Pointer(Box[CType])
  ConstPointer(Box[CType])
  Array(Box[CType], UInt)
  FuncPointer(Array[CType], Box[CType])
  Struct(CStruct)
  Union(CUnion)
  Enum(CEnum)
  Typedef(String, Box[CType])
end

pub struct CStruct
  pub name: String
  pub fields: Array[CField]
  pub packed: Bool
end

pub struct CField
  pub name: String
  pub ty: CType
  pub doc: Option[String]
end

pub struct CUnion
  pub name: String
  pub variants: Array[CField]
end

pub struct CEnum
  pub name: String
  pub variants: Array[(String, i64)]
end

pub struct CFunction
  pub name: String
  pub params: Array[(String, CType)]
  pub return_type: CType
  pub variadic: Bool
  pub doc: Option[String]
end

# ─── Generator ───────────────────────────────────────────────────────

pub struct Bindgen
  config: BindgenConfig
  declarations: Array[Declaration]
end

enum Declaration
  Function(CFunction)
  Struct(CStruct)
  Union(CUnion)
  Enum(CEnum)
  Typedef(String, CType)
  Constant(String, CType, String)
end

impl Bindgen
  pub def new(config: BindgenConfig) -> Bindgen
    Bindgen { config: config, declarations: Array::new() }
  end

  /// Parse the input and generate bindings.
  pub def generate(&mut self) -> Result[String, BindgenError]
    match self.config.input
    when BindgenInput::CHeader(path) then
      match self.parse_c_header(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    when BindgenInput::CHeaders(paths) then
      for path in paths.iter() do
        match self.parse_c_header(path)
        when Result::Ok(_) then ()
        when Result::Err(e) then return Result::Err(e)
        end
      end
    when BindgenInput::RustCrate(path) then
      match self.parse_rust_crate(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    when BindgenInput::WitFile(path) then
      match self.parse_wit_file(path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
    self.emit()
  end

  /// Generate and write to file.
  pub def generate_to_file(&mut self) -> Result[Unit, BindgenError]
    match self.generate()
    when Result::Ok(output) then
      match fs::write_string(self.config.output_path.clone(), output)
      when Result::Ok(_) then Result::Ok(())
      when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
      end
    when Result::Err(e) then Result::Err(e)
    end
  end

  def parse_c_header(&mut self, path: &str) -> Result[Unit, BindgenError]
    match fs::read_to_string(path.to_string())
    when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
    when Result::Ok(content) then
      ## Simple C header parser (real impl would use libclang)
      let lines = content.lines()
      for line in lines do
        let trimmed = line.trim()
        match trimmed.is_empty() || trimmed.starts_with("//") || trimmed.starts_with("/*")
        when true then continue
        when false then
          match trimmed.starts_with("#")
          when true then continue
          when false then
            ## Detect struct declarations
            match trimmed.starts_with("typedef struct") || trimmed.starts_with("struct ")
            when true then continue
            when false then
              ## Detect function declarations
              match trimmed.contains("(") && trimmed.ends_with(";")
              when true then
                match _parse_c_function(trimmed)
                when Some(func) then
                  match self.should_include(&func.name)
                  when true then
                    self.declarations.push(Declaration::Function(func))
                  when false then ()
                  end
                when None then ()
                end
              when false then ()
              end
            end
          end
        end
      end
      Result::Ok(())
    end
  end

  def parse_rust_crate(&mut self, path: &str) -> Result[Unit, BindgenError]
    ## Parse Rust rlib metadata for pub extern "C" fn declarations
    ## In a fully independent Tangerine, we might skip Rust rlibs, 
    ## but for completeness, we read the symbols.
    match std::fs::read_to_string(path.to_string())
    when Result::Ok(content) then
      # Scrape for patterns like: pub extern "C" fn name(...)
      let lines = content.lines()
      for line in lines do
        let trimmed = line.trim()
        if trimmed.starts_with("pub extern \"C\" fn ") then
          # Example: pub extern "C" fn name(arg: type) -> ret;
          let fn_part = trimmed.slice(18, trimmed.len())
          let name_end = fn_part.find("(").unwrap_or(0)
          let name = fn_part.slice(0, name_end).trim().to_string()
          
          self.declarations.push(Declaration::Function(CFunction {
            name: name,
            params: Vec::new(), # Simplified
            return_type: CType::Int, # Placeholder
            doc: Option::None,
            variadic: false
          }))
        end
      end
      Result::Ok(())
    when Result::Err(e) then
      Result::Err(BindgenError::IoError(e.to_string()))
    end
  end

  def parse_wit_file(&mut self, path: &str) -> Result[Unit, BindgenError]
    ## Parse WIT (WASM Interface Types) file
    match std::fs::read_to_string(path.to_string())
    when Result::Ok(content) then
      # WIT grammar parsing
      let lines = content.lines()
      for line in lines do
        let trimmed = line.trim()
        if trimmed.starts_with("export ") then
          let parts = trimmed.split(" ")
          if parts.len() > 1 then
            let name = parts[1].trim_end(";").to_string()
            self.declarations.push(Declaration::Function(CFunction {
              name: name,
              params: Vec::new(),
              return_type: CType::Void,
              doc: Option::Some("WASM export".to_string()),
              variadic: false
            }))
          end
        end
      end
      Result::Ok(())
    when Result::Err(e) then
      Result::Err(BindgenError::IoError(e.to_string()))
    end
  end

  def should_include(&self, name: &str) -> Bool
    mut is_blocked = false
    for blocked in self.config.blocklist.iter() do
      match name == blocked
      when true then is_blocked = true
      when false then ()
      end
    end
    
    match is_blocked
    when true then false
    when false then
      match self.config.allowlist.is_empty()
      when true then
        true
      when false then
        mut found = false
        for a in self.config.allowlist.iter() do
          match a == name
          when true then found = true
          when false then ()
          end
        end
        found
      end
    end
  end

  def emit(&self) -> Result[String, BindgenError]
    mut out = String::new()
    out = out + "## Auto-generated by tg_compiler::bindgen\n"
    out = out + "## Do not edit — regenerate with `tangerine bindgen`\n\n"
    out = out + "module " + &self.config.module_name + "_ffi\n\n"

    for decl in self.declarations.iter() do
      match decl
      when Declaration::Function(f) then out = out + &self.emit_function(f)
      when Declaration::Struct(s) then out = out + &self.emit_struct(s)
      when Declaration::Union(u) then out = out + &self.emit_union(u)
      when Declaration::Enum(e) then out = out + &self.emit_enum(e)
      when Declaration::Typedef(name, ty) then
        out = out + "type " + name + " = " + &_ctype_to_tg(ty, &self.config.type_mappings) + "\n\n"
      when Declaration::Constant(name, ty, val) then
        out = out + "pub def " + name + "() -> " + &_ctype_to_tg(ty, &self.config.type_mappings) + " = " + val + "\n\n"
      end
    end

    out = out + "end ## module " + &self.config.module_name + "_ffi\n"
    Result::Ok(out)
  end

  def emit_function(&self, f: &CFunction) -> String
    mut out = String::new()
    match self.config.generate_docs
    when true then
      match f.doc
      when Option::Some(doc) then
        out = out + "## " + doc + "\n"
      when Option::None then ()
      end
    when false then ()
    end

    ## Emit the extern declaration
    out = out + "@ffi(\"c\")\n"
    out = out + "extern def " + &f.name + "("
    mut p_idx = 0
    for param_pair in f.params.iter() do
      let pname = param_pair.0
      let pty = param_pair.1
      match p_idx > 0
      when true then out = out + ", "
      when false then ()
      end
      out = out + pname + ": " + &_ctype_to_tg(pty, &self.config.type_mappings)
      p_idx = p_idx + 1
    end
    match f.variadic
    when true then
      match f.params.is_empty()
      when false then out = out + ", "
      when true then ()
      end
      out = out + "..."
    when false then ()
    end
    out = out + ") -> " + &_ctype_to_tg(&f.return_type, &self.config.type_mappings) + "\n\n"

    ## Optionally emit safe wrapper
    match self.config.safety
    when BindgenSafety::SafeWrappers then
      out = out + "pub def " + &f.name + "_safe("
      mut idx = 0
      for param in f.params.iter() do
        let pname = param.0
        let pty = param.1
        match idx > 0
        when true then out = out + ", "
        when false then ()
        end
        out = out + pname + ": " + &_ctype_to_tg_safe(pty, &self.config.type_mappings)
        idx = idx + 1
      end
      out = out + ") -> Result[" + &_ctype_to_tg_safe(&f.return_type, &self.config.type_mappings) + ", FfiError]\n"
      out = out + "  unsafe { " + &f.name + "("
      mut idx2 = 0
      for param2 in f.params.iter() do
        let pname2 = param2.0
        match idx2 > 0
        when true then out = out + ", "
        when false then ()
        end
        out = out + pname2
        idx2 = idx2 + 1
      end
      out = out + ") }\nend\n\n"
    when _ then ()
    end

    out
  end

  def emit_struct(&self, s: &CStruct) -> String
    mut out = "@repr(C)\n"
    match s.packed
    when true then out = out + "@packed\n"
    when false then ()
    end
    out = out + "pub struct " + &s.name + "\n"
    for field in s.fields.iter() do
      match field.doc
      when Option::Some(doc) then
        out = out + "  ## " + doc + "\n"
      when Option::None then ()
      end
      out = out + "  pub " + &field.name + ": " + &_ctype_to_tg(&field.ty, &self.config.type_mappings) + "\n"
    end
    out = out + "end\n\n"
    out
  end

  def emit_union(&self, u: &CUnion) -> String
    mut out = "@repr(C)\n"
    out = out + "pub union " + &u.name + "\n"
    for v in u.variants.iter() do
      out = out + "  pub " + &v.name + ": " + &_ctype_to_tg(&v.ty, &self.config.type_mappings) + "\n"
    end
    out = out + "end\n\n"
    out
  end

  def emit_enum(&self, e: &CEnum) -> String
    mut out = "@repr(i32)\n"
    out = out + "pub enum " + &e.name + "\n"
    for variant in e.variants.iter() do
      let name = variant.0
      let value = variant.1
      out = out + "  " + name + " = " + &value.to_string() + "\n"
    end
    out = out + "end\n\n"
    out
  end
end

# ─── C ABI Export ────────────────────────────────────────────────────

/// Generate a C header file from Tangerine @export functions.
pub def generate_c_header(module_path: &str) -> Result[String, BindgenError]
  match fs::read_to_string(module_path.to_string())
  when Result::Err(e) then Result::Err(BindgenError::IoError(e.to_string()))
  when Result::Ok(content) then
    mut out = String::new()
    out = out + "/* Auto-generated C header for Tangerine module */\n"
    out = out + "#ifndef TANGERINE_" + &_header_guard(module_path) + "_H\n"
    out = out + "#define TANGERINE_" + &_header_guard(module_path) + "_H\n\n"
    out = out + "#include <stdint.h>\n#include <stddef.h>\n\n"
    out = out + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"

    ## Parse @export annotated functions (simplified)
    for line in content.lines() do
      let trimmed = line.trim()
      match trimmed.starts_with("@export") || trimmed.starts_with("@ffi_export")
      when true then ()
        ## Next line should be the function signature
        ## Simplified — real impl would use the AST
      when false then ()
      end
    end

    out = out + "#ifdef __cplusplus\n}\n#endif\n\n"
    out = out + "#endif /* TANGERINE_" + &_header_guard(module_path) + "_H */\n"
    Result::Ok(out)
  end
end

# ─── Errors ──────────────────────────────────────────────────────────

pub enum BindgenError
  IoError(String)
  ParseError(String)
  UnsupportedType(String)
  InvalidConfig(String)
end

impl Display for BindgenError
  def fmt(self: &Self) -> String
    match self
    when BindgenError::IoError(msg) then "bindgen I/O error: " + msg
    when BindgenError::ParseError(msg) then "bindgen parse error: " + msg
    when BindgenError::UnsupportedType(ty) then "unsupported C type: " + ty
    when BindgenError::InvalidConfig(msg) then "bindgen config error: " + msg
    end
  end
end

pub struct FfiError
  pub message: String
end

# ─── Internal helpers ────────────────────────────────────────────────

def _default_c_type_mappings() -> Map[String, String]
  var m = Map::new()
  m.insert("void".to_string(), "Unit".to_string())
  m.insert("int".to_string(), "i32".to_string())
  m.insert("unsigned int".to_string(), "u32".to_string())
  m.insert("long".to_string(), "i64".to_string())
  m.insert("unsigned long".to_string(), "u64".to_string())
  m.insert("char".to_string(), "i8".to_string())
  m.insert("unsigned char".to_string(), "u8".to_string())
  m.insert("short".to_string(), "i16".to_string())
  m.insert("unsigned short".to_string(), "u16".to_string())
  m.insert("float".to_string(), "f32".to_string())
  m.insert("double".to_string(), "f64".to_string())
  m.insert("size_t".to_string(), "UInt".to_string())
  m.insert("ssize_t".to_string(), "Int".to_string())
  m.insert("bool".to_string(), "Bool".to_string())
  m.insert("_Bool".to_string(), "Bool".to_string())
  m.insert("int8_t".to_string(), "i8".to_string())
  m.insert("uint8_t".to_string(), "u8".to_string())
  m.insert("int16_t".to_string(), "i16".to_string())
  m.insert("uint16_t".to_string(), "u16".to_string())
  m.insert("int32_t".to_string(), "i32".to_string())
  m.insert("uint32_t".to_string(), "u32".to_string())
  m.insert("int64_t".to_string(), "i64".to_string())
  m.insert("uint64_t".to_string(), "u64".to_string())
  m
end

def _default_rust_type_mappings() -> Map[String, String]
  var m = _default_c_type_mappings()
  m.insert("i8".to_string(), "i8".to_string())
  m.insert("u8".to_string(), "u8".to_string())
  m.insert("i16".to_string(), "i16".to_string())
  m.insert("u16".to_string(), "u16".to_string())
  m.insert("i32".to_string(), "i32".to_string())
  m.insert("u32".to_string(), "u32".to_string())
  m.insert("i64".to_string(), "i64".to_string())
  m.insert("u64".to_string(), "u64".to_string())
  m.insert("f32".to_string(), "f32".to_string())
  m.insert("f64".to_string(), "f64".to_string())
  m.insert("usize".to_string(), "UInt".to_string())
  m.insert("isize".to_string(), "Int".to_string())
  m.insert("bool".to_string(), "Bool".to_string())
  m.insert("String".to_string(), "String".to_string())
  m
end

def _ctype_to_tg(ct: &CType, mappings: &Map[String, String]) -> String
  match ct
  when CType::Void then "Unit"
  when CType::Bool then "Bool"
  when CType::Char then "i64"
  when CType::Short then "i64"
  when CType::Int then "i64"
  when CType::Long then "i64"
  when CType::LongLong then "i64"
  when CType::UChar then "u64"
  when CType::UShort then "u64"
  when CType::UInt then "u64"
  when CType::ULong then "u64"
  when CType::ULongLong then "u64"
  when CType::Float then "f32"
  when CType::Double then "f64"
  when CType::SizeT then "UInt"
  when CType::Pointer(inner) then "*mut " + &_ctype_to_tg(inner, mappings)
  when CType::ConstPointer(inner) then "*const " + &_ctype_to_tg(inner, mappings)
  when CType::Array(inner, size) then "[" + &_ctype_to_tg(inner, mappings) + "; " + &size.to_string() + "]"
  when CType::FuncPointer(params, ret) then
    mut s = "fn("
    mut idx = 0
    for p in params.iter() do
      match idx > 0
      when true then s = s + ", "
      when false then ()
      end
      s = s + &_ctype_to_tg(p, mappings)
      idx = idx + 1
    end
    s + ") -> " + &_ctype_to_tg(ret, mappings)
  when CType::Struct(s) then s.name.clone()
  when CType::Union(u) then u.name.clone()
  when CType::Enum(e) then e.name.clone()
  when CType::Typedef(name, _) then name.clone()
  when _ then "Unit"
  end
end

def _ctype_to_tg_safe(ct: &CType, mappings: &Map[String, String]) -> String
  ## Same as _ctype_to_tg but converts raw pointers to references
  match ct
  when CType::Pointer(inner) then "&mut " + &_ctype_to_tg_safe(inner, mappings)
  when CType::ConstPointer(inner) then "&" + &_ctype_to_tg_safe(inner, mappings)
  when _ then _ctype_to_tg(ct, mappings)
  end
end

def _parse_c_function(line: &str) -> Option[CFunction]
  ## Parse a C function declaration like: int foo(int x, char *y);
  ## or: void bar(void);
  let trimmed = line.trim()
  ## Must contain '(' and end with ');'
  let paren_open = trimmed.find("(")
  match paren_open
  when Option::None then return None
  when Option::Some(open_pos) then
    let before_paren = trimmed.substring(0, open_pos as Int).trim()
    ## Split into return type + name: "int foo" → ("int", "foo")
    let last_space = before_paren.rfind(" ")
    match last_space
    when Option::None then return None
    when Option::Some(sp) then
      let ret_str = before_paren.substring(0, sp as Int).trim()
      mut fn_name = before_paren.substring((sp + 1) as Int, before_paren.len() as Int).trim().to_string()
      if fn_name.is_empty() then return None end

      ## Handle pointer return: "int *get_ptr" → ret is pointer to int
      mut ptr_depth = 0
      while fn_name.starts_with("*") do
        fn_name = fn_name.substring(1, fn_name.len() as Int)
        ptr_depth = ptr_depth + 1
      end

      mut ret_type = _parse_c_type_str(ret_str)
      mut i = 0
      while i < ptr_depth do
        ret_type = CType::Pointer(Box::new(ret_type))
        i = i + 1
      end

      ## Parse parameters between ( and )
      let close_pos = trimmed.rfind(")")
      match close_pos
      when Option::None then return None
      when Option::Some(cp) then
        let params_str = trimmed.substring((open_pos + 1) as Int, cp as Int).trim()
        mut params = Array::new()
        mut variadic = false
        if params_str != "void" && !params_str.is_empty() then
          let param_parts = params_str.split(",")
          for part in param_parts do
            let p = part.trim()
            if p == "..." then
              variadic = true
            else
              ## Parse "type name" or just "type"
              let psp = p.rfind(" ")
              match psp
              when Option::Some(ps) then
                let p_type_str = p.substring(0, ps as Int).trim()
                mut p_name = p.substring((ps + 1) as Int, p.len() as Int).trim().to_string()
                ## Handle pointer in name: "char *name"
                if p_name.starts_with("*") then
                  p_name = p_name.substring(1, p_name.len() as Int)
                end
                params.push((p_name, _parse_c_type_str(p_type_str)))
              when Option::None then
                params.push(("arg".to_string(), _parse_c_type_str(p)))
              end
            end
          end
        end

        return Some(CFunction {
          name: fn_name.to_string(),
          params: params,
          return_type: ret_type,
          variadic: variadic,
          doc: None,
        })
      end
    end
  end
  None
end

def _parse_c_type_str(s: &str) -> CType
  let trimmed = s.trim()
  if trimmed == "void" then CType::Void
  elsif trimmed == "int" then CType::Int
  elsif trimmed == "unsigned int" || trimmed == "unsigned" then CType::UInt
  elsif trimmed == "long" then CType::Long
  elsif trimmed == "unsigned long" then CType::ULong
  elsif trimmed == "long long" then CType::LongLong
  elsif trimmed == "unsigned long long" then CType::ULongLong
  elsif trimmed == "char" then CType::Char
  elsif trimmed == "unsigned char" then CType::UChar
  elsif trimmed == "short" then CType::Short
  elsif trimmed == "unsigned short" then CType::UShort
  elsif trimmed == "float" then CType::Float
  elsif trimmed == "double" then CType::Double
  elsif trimmed == "size_t" then CType::SizeT
  elsif trimmed == "bool" || trimmed == "_Bool" then CType::Bool
  elsif trimmed.ends_with("*") then
    let inner = trimmed.substring(0, (trimmed.len() - 1) as Int).trim()
    if inner.starts_with("const ") then
      CType::ConstPointer(Box::new(_parse_c_type_str(inner.substring(6, inner.len() as Int))))
    else
      CType::Pointer(Box::new(_parse_c_type_str(inner)))
    end
  elsif trimmed.starts_with("const ") then
    _parse_c_type_str(trimmed.substring(6, trimmed.len() as Int))
  else
    CType::Typedef(trimmed.to_string(), Box::new(CType::Int))
  end
end

def _header_guard(path: &str) -> String
  path.replace("/", "_").replace(".", "_").replace("-", "_").to_uppercase()
end

# end ## module tg_compiler::bindgen
