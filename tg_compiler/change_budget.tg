# Tangerine Compiler — Change Budget (audit §36)
# Self-hosting compiler written in Tangerine
#
# budget_verify checks the §36 envelope SemanticDelta ⊆ ChangeBudget: a
# ChangeBudget is the audit's per-change allowance over ONE §31 SemanticDelta
# — the stable symbol keys the change may create/remove/modify/affect, the
# public-api / abi row counts it may add, the effect classes / capability
# edges a NEW row may carry, the new unsafe markers it may add, the contract
# weakenings it may perform and (optionally) the alloc-class effect rows it
# may create. The module reads ONLY SemanticDelta records (semantic_delta.tg,
# never AST / typed / MIR state) and mirrors the semantic_delta.tg /
# repair_candidates.tg idioms. An EMPTY budget (ChangeBudget {}) admits only
# the empty delta: budget_verified returns false for any non-empty change —
# the fail-closed default that mechanically prevents scope creep.
#
# DOMAIN ADAPTATIONS (the audit names mapped onto the §31 records that exist
# — the §29 module doc's adaptation discipline, never invented look-alikes):
#   - StableSymbolId is repair_candidates.tg's advisory stable-symbol record.
#     Identity for the budget is the canonical stable KEY TEXT
#     (StableSymbolId.key): the delta's created/removed/modified/affected key
#     texts must equal an allowed entry's key EXACTLY (the "path::name#
#     signature" text — the digest words ride the same identity and are not
#     consulted).
#   - EffectId is the §11 dirty-class id. The §31 effect rows carry no
#     declared-effect registry id (ids.tg's Io/File/... interned effects ride
#     fn signatures, never effect rows): the row's only effect vocabulary is
#     the payload's dirty word (semantic_summary_dirty_word — allocate=1,
#     block=2, io=4, spawn=8, sleep=16, panic=32, unsafe=64, rendered
#     "word;cap-ids"). allow_new_effects therefore names CLASS ids: an
#     EffectId { id: <class bit> } entry allows that class; ids outside the
#     class band {1,2,4,8,16,32,64} can never match an effect row (a budget
#     entry outside the band is inert — fail-closed, never permissive).
#   - CapabilityId is types.tg's fixed capability id, as keyed in the §31
#     capability row text "cap<id>" (arena=1, mmio=2, ...).
#   - Unsafe markers: SemanticDelta carries no unsafe-surface rows (the
#     unsafe_hash domain has no delta rows — documented in semantic_delta.tg);
#     the delta-side marker signal is an effect row whose dirty word carries
#     the §11 unsafe class (the fail-closed unknown/extern shapes set
#     may_unsafe). "Extern" markers (unsafe-fn / extern-call / transmute /
#     unknown-call row texts of the unsafe_hash domain) are NOT observable
#     through SemanticDelta — documented gap; the unsafe class of a created
#     effect row is their only row-level echo.
#   - Contract weakening: a contract clause's text rides the §31 row KEY, so
#     a clause text change never produces a Modified ContractDelta — it
#     produces a Removed row (old text) + a Created row (new text). Without a
#     clause lattice the direction of any clause change is unprovable, so a
#     Removed row on a SURVIVING function (a dropped or replaced constraint)
#     is treated as weakening; pure clause additions (Created rows alone) are
#     strengthening and do not fire; a function deleted from the program is
#     already gated by allowed_symbols (its rows are excluded here); a
#     Modified row (structurally unreachable today) fires for robustness.
#
# THE CHECKS (each violation string starts with "budget:"):
#   1. allowed_symbols — every key of delta.created / delta.removed /
#      delta.affected and every modified entity's stable_id must be allowed.
#      A key reported through several lists (affected contains the created/
#      removed seeds) yields one violation per list — deterministic.
#   2. public-api rows — when public_api_delta.public_api_rows.len() exceeds
#      max_public_api_delta, the count violation lists every exceeding row.
#   3. abi rows — abi_delta.abi_rows likewise against max_abi_delta.
#   4. contract weakening — see the adaptation above (fires only when
#      allow_contract_weakening is false).
#   5. new effect edges — each class bit set in the dirty word of a Created
#      effect row (delta.effect_delta, kind Created) is a new effect: not in
#      allow_new_effects -> one violation per (row, class). Modified effect
#      rows (a summary gaining classes on an already-rowed function) are not
#      named by the audit and do not fire (documented gap).
#   6. new capability edges — each Created capability row (kind Created in
#      delta.capability_delta) whose "cap<id>" id is not in
#      allow_new_capabilities is a violation.
#   7. max_new_unsafe — EXACT COUNTING RULE: the count is (a) the Created
#      OwnershipDelta rows — "the delta's ownership rows" — plus (b) the
#      Created effect rows whose dirty word carries the §11 unsafe class
#      (bit 64) — "any unsafe markers" (the audit's "created rows whose kind
#      text contains unsafe/extern", realized per the model conventions: the
#      ownership convention words let/inout/sink/set and the call/capability
#      kind words never contain "unsafe"/"extern"; the effect class word
#      "unsafe" is the only row kind text that does). A count above
#      max_new_unsafe lists every counted row.
#   8. allocation — only when max_allocation_delta = Some(n): the count of
#      Created effect rows whose dirty word carries the alloc class (bit 1 —
#      the §11 payload marks allocation as the word's low bit); a count above
#      n lists every counted row.
#
# VIOLATION CATALOG (the exact strings budget_verify emits; every row listed
# is prefixed "budget:" on its own line, in the check order above):
#   budget:symbol-created <key> not in allowed_symbols
#   budget:symbol-removed <key> not in allowed_symbols
#   budget:symbol-modified <key> not in allowed_symbols
#   budget:symbol-affected <key> not in allowed_symbols
#   budget:public-api <n> rows exceed max_public_api_delta <m>
#   budget:public-api row <row>
#   budget:abi <n> rows exceed max_abi_delta <m>
#   budget:abi row <row>
#   budget:contract-weakening <fn-key> <clause> (clause removed/changed on a
#     surviving function; allow_contract_weakening=false)
#   budget:effect <fn-key> introduces class <class-word> (EffectId <bit>) not
#     in allow_new_effects
#   budget:capability <fn-key> cap<id> not in allow_new_capabilities
#   budget:unsafe <n> new-unsafe markers exceed max_new_unsafe <m>
#   budget:unsafe marker <fn-key> ownership-<convention>
#   budget:unsafe marker <fn-key> effect-unsafe
#   budget:allocation <n> created alloc-class effect rows exceed
#     max_allocation_delta <m>
#   budget:allocation row <fn-key>
#
# budget_verified is the Bool gate over the same envelope; an empty budget
# verifies only an empty delta.

use std::core::{Option}
use std::collections::{Vec, Set}

use tg_compiler::ids::{EffectId}
use tg_compiler::types::{CapabilityId}
use tg_compiler::repair_candidates::{StableSymbolId}
use tg_compiler::semantic_delta::{SemanticDelta, DeltaKind}

# ———————————————————————————————————————————————————————————————
# The §36 protocol record
# ———————————————————————————————————————————————————————————————
# The per-change allowance over ONE SemanticDelta (the audit's struct, field
# for field). Every field is defaulted so an EMPTY budget is expressible as
# ChangeBudget {}: empty allow-sets, zero row budgets, no allocation cap and
# contract weakening forbidden — the fail-closed envelope.
struct ChangeBudget
  # The stable symbol keys the change may touch: every created/removed/
  # modified/affected key must equal an entry's key text exactly.
  allowed_symbols: Set[StableSymbolId] = Set::new()
  # The most public-api rows (symmetric-difference surface rows) the change
  # may introduce.
  max_public_api_delta: Int = 0
  # The most abi rows the change may introduce.
  max_abi_delta: Int = 0
  # The §11 dirty-class ids a Created effect row may newly carry (the
  # domain adaptation in the module doc: class id = dirty-word bit).
  allow_new_effects: Set[EffectId] = Set::new()
  # The capability ids a Created capability edge may newly carry.
  allow_new_capabilities: Set[CapabilityId] = Set::new()
  # The most new unsafe markers the change may add (created ownership rows +
  # created unsafe-class effect rows — the exact counting rule in the doc).
  max_new_unsafe: Int = 0
  # Whether removed/replaced contract clauses on surviving functions are
  # permitted (false = any such row is a weakening violation).
  allow_contract_weakening: Bool = false
  # The most created alloc-class effect rows permitted; None = no cap.
  max_allocation_delta: Option[Int] = Option::None
end

# ———————————————————————————————————————————————————————————————
# Text / kind primitives (the semantic_delta.tg byte-text idioms)
# ———————————————————————————————————————————————————————————————

# The integer value of the leading ASCII-digit run of a text (0 when the
# text does not start with a digit). The §11 payload's dirty word is the
# leading run of "<word>;<cap-ids>"; the capability text "cap<id>" is
# sliced past its "cap" prefix before this runs. Byte-parse idiom mirrors
# semantic_slice.tg's slice_text_to_int.
def budget_int_prefix(s: String) -> Int
  var value = 0
  var i = 0
  while i < s.len() do
    let bs = s.slice(i, i + 1).bytes()
    if bs.len() == 0 then
      break
    end
    let b = bs[0] as Int
    if b >= 48 && b <= 57 then
      value = value * 10 + (b - 48)
      i = i + 1
    else
      break
    end
  end
  value
end

# The capability id of a §31 capability-row part text ("cap<id>"); -1 for
# any other text (a -1 id can never match a budget entry — ids are fixed
# positive CapabilityId numbers, arena=1 / mmio=2).
def budget_cap_id_of(part: String) -> Int
  if !part.starts_with("cap") then
    return -1
  end
  if part.len() <= 3 then
    return -1
  end
  var digits = part.slice(3, part.len())
  budget_int_prefix(digits)
end

# The row-state word of a §31 DeltaKind ("created"/"removed"/"modified") —
# the delta kind discriminates which rows a check counts.
def budget_kind_state(k: DeltaKind) -> String
  match k
  when DeltaKind::Created then "created"
  when DeltaKind::Removed then "removed"
  when DeltaKind::Modified then "modified"
  end
end

# Whether a §11 dirty word carries the class of the given bit (the word is
# the sum of its class bits: allocate=1, block=2, io=4, spawn=8, sleep=16,
# panic=32, unsafe=64 — semantic_summary_dirty_word's field order).
def budget_word_has_class(word: Int, bit: Int) -> Bool
  (word / bit) % 2 == 1
end

# The class word of a §11 dirty-class bit (the §11 may_* field names minus
# the "may_" prefix; the fallback keeps the word deterministic for any bit).
def budget_class_text(bit: Int) -> String
  if bit == 1 then "alloc"
  elsif bit == 2 then "block"
  elsif bit == 4 then "io"
  elsif bit == 8 then "spawn"
  elsif bit == 16 then "sleep"
  elsif bit == 32 then "panic"
  else "unsafe"
  end
end

# ———————————————————————————————————————————————————————————————
# Budget set membership (the allow-sets are read-only here — the module
# iterates them and compares identities by hand, so the sets themselves
# never require Eq/Hash instances; only the empty Set::new() defaults and
# the reads below are exercised).
# ———————————————————————————————————————————————————————————————

# Whether an allowed_symbols entry's canonical key text equals the delta key.
def budget_symbol_allowed(budget: ChangeBudget, key: String) -> Bool
  for s in budget.allowed_symbols do
    if s.key == key then
      return true
    end
  end
  false
end

# Whether a §11 dirty-class id is in allow_new_effects (id equality — the
# identity is the id, never a name).
def budget_effect_allowed(budget: ChangeBudget, eid: EffectId) -> Bool
  for e in budget.allow_new_effects do
    if e.id == eid.id then
      return true
    end
  end
  false
end

# Whether a capability id is in allow_new_capabilities.
def budget_capability_allowed(budget: ChangeBudget, cap_id: Int) -> Bool
  for c in budget.allow_new_capabilities do
    if c.id == cap_id then
      return true
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# THE VERIFIER — SemanticDelta ⊆ ChangeBudget
# ———————————————————————————————————————————————————————————————
# Runs the §36 checks in the module doc's numbered order; deterministic —
# the delta's own sorted row order is preserved inside every check. Rows of
# an effect/capability/ownership delta are counted by their §31 kind
# (Created = the row's key existed only on the b side).

pub def budget_verify(budget: ChangeBudget, delta: SemanticDelta) -> Vec[String]
  var out: Vec[String] = Vec::new()

  # The §11 dirty-class band (module doc: class ids = word bits).
  var class_bits: Vec[Int] = Vec::from([1, 2, 4, 8, 16, 32, 64])

  # 1. allowed_symbols — created / removed / modified / affected keys.
  for key in delta.created do
    if !budget_symbol_allowed(&budget, key.clone()) then
      out.push("budget:symbol-created " + key.clone() + " not in allowed_symbols")
    end
  end
  for key in delta.removed do
    if !budget_symbol_allowed(&budget, key.clone()) then
      out.push("budget:symbol-removed " + key.clone() + " not in allowed_symbols")
    end
  end
  for entry in delta.modified do
    if !budget_symbol_allowed(&budget, entry.stable_id.clone()) then
      out.push("budget:symbol-modified " + entry.stable_id.clone() + " not in allowed_symbols")
    end
  end
  for key in delta.affected do
    if !budget_symbol_allowed(&budget, key.clone()) then
      out.push("budget:symbol-affected " + key.clone() + " not in allowed_symbols")
    end
  end

  # 2. public-api rows (rows are empty unless the hash pair changed).
  let api_count = delta.public_api_delta.public_api_rows.len()
  if api_count > budget.max_public_api_delta then
    out.push("budget:public-api " + api_count.to_string() +
      " rows exceed max_public_api_delta " + budget.max_public_api_delta.to_string())
    for row in delta.public_api_delta.public_api_rows do
      out.push("budget:public-api row " + row)
    end
  end

  # 3. abi rows.
  let abi_count = delta.abi_delta.abi_rows.len()
  if abi_count > budget.max_abi_delta then
    out.push("budget:abi " + abi_count.to_string() +
      " rows exceed max_abi_delta " + budget.max_abi_delta.to_string())
    for row in delta.abi_delta.abi_rows do
      out.push("budget:abi row " + row)
    end
  end

  # 4. contract weakening — a Removed/Modified clause row on a function that
  #    SURVIVES the change (its key is not in delta.removed) is a dropped or
  #    replaced constraint: without a clause lattice any such row is treated
  #    as weakening (module doc). Pure clause additions (Created rows) never
  #    weaken and fire nowhere; deleted functions are the symbol gate's.
  if !budget.allow_contract_weakening then
    for row in delta.contract_delta do
      let state = budget_kind_state(row.kind)
      if state == "removed" || state == "modified" then
        if !delta.removed.contains(&row.key) then
          out.push("budget:contract-weakening " + row.key.clone() + " " +
            row.clause.clone() + " (clause removed/changed on a surviving " +
            "function; allow_contract_weakening=false)")
        end
      end
    end
  end

  # 5. new effect edges — every §11 class bit of a Created effect row's
  #    payload dirty word is a new effect; one violation per (row, class).
  for row in delta.effect_delta do
    if budget_kind_state(row.kind) == "created" then
      let eword = budget_int_prefix(row.to)
      for bit in class_bits do
        if budget_word_has_class(eword, bit) then
          let eid = EffectId { id: bit }
          if !budget_effect_allowed(&budget, eid) then
            out.push("budget:effect " + row.key.clone() + " introduces class " +
              budget_class_text(bit) + " (EffectId " + bit.to_string() +
              ") not in allow_new_effects")
          end
        end
      end
    end
  end

  # 6. new capability edges — a Created capability row's "cap<id>" id.
  for row in delta.capability_delta do
    if budget_kind_state(row.kind) == "created" then
      let cap_id = budget_cap_id_of(row.to)
      if cap_id >= 0 && !budget_capability_allowed(&budget, cap_id) then
        out.push("budget:capability " + row.from.clone() + " cap" +
          cap_id.to_string() + " not in allow_new_capabilities")
      end
    end
  end

  # 7. max_new_unsafe — the exact counting rule of the module doc: created
  #    ownership rows + created effect rows carrying the §11 unsafe class.
  var unsafe_count = 0
  for row in delta.ownership_delta do
    if budget_kind_state(row.kind) == "created" then
      unsafe_count = unsafe_count + 1
    end
  end
  for row in delta.effect_delta do
    if budget_kind_state(row.kind) == "created" then
      let uword = budget_int_prefix(row.to)
      if budget_word_has_class(uword, 64) then
        unsafe_count = unsafe_count + 1
      end
    end
  end
  if unsafe_count > budget.max_new_unsafe then
    out.push("budget:unsafe " + unsafe_count.to_string() +
      " new-unsafe markers exceed max_new_unsafe " + budget.max_new_unsafe.to_string())
    for row in delta.ownership_delta do
      if budget_kind_state(row.kind) == "created" then
        out.push("budget:unsafe marker " + row.key.clone() + " ownership-" +
          row.convention.clone())
      end
    end
    for row in delta.effect_delta do
      if budget_kind_state(row.kind) == "created" then
        let uword = budget_int_prefix(row.to)
        if budget_word_has_class(uword, 64) then
          out.push("budget:unsafe marker " + row.key.clone() + " effect-unsafe")
        end
      end
    end
  end

  # 8. allocation — only under an explicit Some(n) cap: created effect rows
  #    whose payload dirty word carries the alloc class (bit 1).
  match budget.max_allocation_delta
  when Option::Some(max_alloc) then
    var alloc_count = 0
    for row in delta.effect_delta do
      if budget_kind_state(row.kind) == "created" then
        let aword = budget_int_prefix(row.to)
        if budget_word_has_class(aword, 1) then
          alloc_count = alloc_count + 1
        end
      end
    end
    if alloc_count > max_alloc then
      out.push("budget:allocation " + alloc_count.to_string() +
        " created alloc-class effect rows exceed max_allocation_delta " +
        max_alloc.to_string())
      for row in delta.effect_delta do
        if budget_kind_state(row.kind) == "created" then
          let aword = budget_int_prefix(row.to)
          if budget_word_has_class(aword, 1) then
            out.push("budget:allocation row " + row.key.clone())
          end
        end
      end
    end
  when Option::None then
    ()
  end

  out
end

# The Bool gate over the same envelope: true exactly when the delta verifies
# (no violations — the empty budget admits only the empty delta).
pub def budget_verified(budget: ChangeBudget, delta: SemanticDelta) -> Bool
  budget_verify(&budget, &delta).len() == 0
end
