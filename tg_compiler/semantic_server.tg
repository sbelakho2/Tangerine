      "subject".to_string(), TextKind::CanonicalKeyText,
      schema_result2("diagnostic".to_string(), RecordFamily::Diagnostic,
        "rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Diagnostic]), ToolStability::Experimental,
      DeterminismClass::SessionRelative, QueryCostClass::LinearScan,
      schema_store_artifacts(), schema_gated("diagnostic.get_unavailable".to_string()))
  when "diagnostic.repair_context" then
