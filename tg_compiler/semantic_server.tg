  # render (session_edit_verified_results); the op is session-relative
  # (its verdict depends on the session's held revision).
  when "edit.apply_verified" then
    Option::Some(semantic_tool_schema_new("edit.apply_verified".to_string(), "edit".to_string(),
      schema_edit_verified_args(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
