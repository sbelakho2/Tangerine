  when Option::None then Option::None
  when Option::Some(kind) then
    match v2_read_texts(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(rows) then
      Option::Some(RowsResponse { kind: kind, rows: rows })
    end
  end
end

