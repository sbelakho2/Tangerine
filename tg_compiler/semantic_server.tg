pub def wire_render_type(record: TypeResponse) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("type:" + record.type_key.clone())
  rows.push("kind:" + record.kind.clone())
  rows.push("size:" + record.size.to_string())
  rows.push("alignment:" + record.alignment.to_string())
  for f in record.fields do
    rows.push("field:" + f.clone())
  end
  rows
end

pub def wire_parse_type(rows: Vec[String]) -> Option[TypeResponse]
  var type_key = ""
  var have_key = false
  var kind = ""
  var have_kind = false
  var size = 0
  var have_size = false
  var alignment = 0
  var have_alignment = false
  var fields: Vec[String] = Vec::new()
  for row in rows do
    match server_wire_split_row(row.clone())
    when Option::None then return Option::None
    when Option::Some(parts) then
      let tag = parts.0.clone()
      if tag == "type" then
        type_key = parts.1.clone()
        have_key = true
      elsif tag == "kind" then
        kind = parts.1.clone()
        have_kind = true
      elsif tag == "size" then
        match parts.1.parse_int()
        when Result::Ok(n) then
          size = n
          have_size = true
        when Result::Err(_) then return Option::None
        end
      elsif tag == "alignment" then
        match parts.1.parse_int()
        when Result::Ok(n) then
          alignment = n
          have_alignment = true
        when Result::Err(_) then return Option::None
        end
      elsif tag == "field" then
        fields.push(parts.1.clone())
      else
        return Option::None
      end
    end
  end
  if !have_key || !have_kind || !have_size || !have_alignment then
    return Option::None
  end
  Option::Some(TypeResponse {
    type_key: type_key,
    kind: kind,
    size: size,
    alignment: alignment,
    fields: fields
  })
end

pub def wire_render_effects(record: EffectsResponse) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("function:" + record.function.clone())
  rows.push("bits:" + record.bits.to_string())
  rows.push("purity:" + record.purity.clone())
  for c in record.capabilities do
    rows.push("capability:" + c.clone())
  end
  rows
end

pub def wire_parse_effects(rows: Vec[String]) -> Option[EffectsResponse]
  var function = ""
  var have_function = false
  var bits = 0
  var have_bits = false
  var purity = ""
  var have_purity = false
  var capabilities: Vec[String] = Vec::new()
  for row in rows do
    match server_wire_split_row(row.clone())
    when Option::None then return Option::None
    when Option::Some(parts) then
      let tag = parts.0.clone()
      if tag == "function" then
        function = parts.1.clone()
        have_function = true
      elsif tag == "bits" then
        match parts.1.parse_int()
        when Result::Ok(n) then
          bits = n
          have_bits = true
        when Result::Err(_) then return Option::None
        end
      elsif tag == "purity" then
        purity = parts.1.clone()
        have_purity = true
      elsif tag == "capability" then
        capabilities.push(parts.1.clone())
      else
        return Option::None
      end
    end
  end
  if !have_function || !have_bits || !have_purity then
    return Option::None
  end
  Option::Some(EffectsResponse {
    function: function,
    bits: bits,
    capabilities: capabilities,
    purity: purity
  })
end

