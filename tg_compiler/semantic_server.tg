      Vec::from([StableIdKind::Diagnostic]), ToolStability::Experimental,
      DeterminismClass::SessionRelative, QueryCostClass::LinearScan,
      schema_store_artifacts(),
      schema_gated("diagnostic.repair_context_unavailable".to_string()))
  # (repair-candidates-as-semantic-operations closure) the durable repair
  # ops: candidates answer from the record's retained typed payload; the
  # instantiation answers the fail-closed envelope (kind/missing/reason/
  # edit). Both are store-gated and session-relative.
  when "repair.candidates" then
    schema_text_op("repair.candidates".to_string(), "repair".to_string(),
      "subject".to_string(), TextKind::CanonicalKeyText,
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Diagnostic]), ToolStability::Experimental,
