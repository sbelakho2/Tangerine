# (audit order item 7) the host-route ABI verifier dispatch of the
# verified-edit transaction's pipeline: the finalized MIR is lowered +
# allocated exactly as the host route's compile entries do (no emission)
# and verified by the ONE post-lowering ABI checker. Empty = verified.
def session_abi_verify_rows(program: MirProgram, desc: TargetDesc) -> Vec[String]
  match desc.arch
  when Arch::AArch64 then abi_verify_program_a64(program, desc)
  when Arch::X86_64 then verify_abi_program_x86(program, desc)
  when _ then Vec::from(["abi-verify: the host route has no ABI verifier for `" + desc.name + "` (aarch64/x86-64 only)"])
  end
end

# ———————————————————————————————————————————————————————————————
# The §39 protocol records — version, session, request, response
# ———————————————————————————————————————————————————————————————
# Protocol_version 1 = the whole §39 grammar above; any other request
# version gets the fail-closed "protocol_error" response.

pub const SEMANTIC_PROTOCOL_VERSION: Int = 1

# The §39 framing limits (audit item 25) — the module doc's table says
# where each is enforced; every check precedes the allocation it caps,
# and a violation fails closed (None) exactly like a truncated field.
const MAX_FRAME_BYTES: Int = 16777216 # 16 MiB: 4-byte BE prefix + body
const MAX_FIELD_BYTES: Int = 1048576  # 1 MiB per length-prefixed text
const MAX_KEYS: Int = 65536           # response keys-count cap

# The persistent-service session. revision / snapshot / index are the
# served tables; target holds the compilation's REAL TargetDesc record
# (Option: the pipeline constructors fill it — compiler_session_from_
# finalized — while the offline-artifact forms leave it None: the §29
# snapshot itself carries only the StableTargetId projection). The
# final_env / final_typed / final_mir Option slots carry the PIPELINE's
# finalized state (TypeEnv / TypedProgram / the FINAL verified MirProgram
# — the values in scope at the successful final compiler boundary) for
# the §33-slice / ABI / layout follow-ups; the evidence Option slot
# carries the compilation's §37 VerifiedCompilationEvidence
# (proof_patch.tg — the stages the boundary's pipeline actually ran;
# None on the offline-artifact forms, which ran no pipeline); see the
# module doc's audit item 21 note and compiler_session_from_finalized
# below.
struct CompilerSession
  revision: StableDigest
  snapshot: SemanticSnapshot
  index: SemanticIndex
  target: Option[TargetDesc] = Option::None
  final_env: Option[TypeEnv] = Option::None
  final_typed: Option[TypedProgram] = Option::None
  final_mir: Option[MirProgram] = Option::None
  evidence: Option[VerifiedCompilationEvidence] = Option::None
  # (third-audit items 23/24) the retained persistent diagnostic store:
  # the session's diagnostics are projected into it (append-only, stable
  # ids) and the diagnostic.get / diagnostic.explain /
  # diagnostic.repair_context ops answer from it. The offline-artifact
  # constructors start it EMPTY (the field default); the pipeline-boundary
  # constructor populates it from the compile's diagnostics parameter and
  # session_diagnostics_add appends later.
  diagnostics_store: DiagnosticStore = new_diagnostic_store()
  # ———— (audit order P0-15) the verified-edit transaction inputs ————
  # The transaction (session_apply_verified_edit) resolves edits against
  # THIS session's snapshot/index, rewrites the source text the session
  # was compiled from, recompiles it through the full pipeline and builds
  # the next snapshot through the persistent lineage store below.
  # source / source_file carry the compiled file's text and name ("" on
  # the offline-artifact forms: the transaction then has no edit surface
  # and answers ProvisionalFrontEnd); compile_options is the compile's
  # REAL options record (the transaction reproduces the pipeline and the
  # snapshot header from it); lineages is the persistent
  # declaration-lineage store threaded into the NEW snapshot build (a
  # fresh empty store otherwise); rationale_store is the retained
  # compiler-grounded rationale history the transaction appends the edit
  # records to. All defaulted so every existing constructor call and
  # offline form stays valid.
  source: String = ""
  source_file: String = ""
  # The compile's REAL options record (the driver route passes its CLI
  # options): the transaction recompiles the edited source with the SAME
  # feature set / opt level / phase flags and feeds
  # snapshot_feature_set_of / snapshot_semantic_options_of from it, so the
  # new snapshot's header is the baseline's own header modulo the edit.
  compile_options: CompilerOptions = default_options()
  lineages: DeclLineageStore = stable_lineage_store_new()
  rationale_store: RationaleStore = rationale_store_new()
end

# ———————————————————————————————————————————————————————————————
# The TYPED WIRE RESPONSE RECORDS (third-audit item 22)
# ———————————————————————————————————————————————————————————————
# The typed server-side API of every served answer family: the target /
# caller / function / type / contract / diagnostic fields are STABLE ID
# TEXTS (the wire renders stable ids — never a display name), and the rows
# lists carry the canonical §31/§32 row texts. The canonical row render of
# each record family is defined once in the typed-wire section below
# (<tag>:<value> rows). SemanticWirePayload wraps the twelve records so
# ONE value carries any typed answer through the response record.
#
# PROJECTION NOTES (documented boundaries): the §32 type_layout_map is
# POPULATED — the index builder fills it from the snapshot's persisted ABI
# TYPE rows (semantic_index.tg build step 9 / index_abi_layout_text: each
# value is the layout engine's "size=<n>;align=<n>;fields=<...>" render,
# never fabricated) — and type.layout serves those rows; TypeResponse.size
# /alignment stay 0 only where the mapped operation's rows carry no layout
# row (types / type.get / fields); DiagnosticResponse is the
# typed projection of one retained store record (the id / code / message /
# related rows — the store's span / semantic-class spine rows stay
# reachable through diagnostic.explain); ContractResponse carries ONE
# clause, so the multi-row contract ops keep their §38 rows (the dispatch
# maps only the single-clause answer), and the record is built from the
# underlying ContractFact — never parsed out of the canonical clause text,
# which may contain '|' (fourth-audit P0-12); the purity.get status +
# ordered evidence sequence and the explain tree lines belong to no record
# family and keep their §38 rows.

pub struct CallersResponse
  target: String
  callers: Vec[String] = Vec::new()
end

pub struct CalleesResponse
  function: String
  callees: Vec[String] = Vec::new()
end

pub struct SymbolsResponse
  query: String
  symbols: Vec[String] = Vec::new()
end

pub struct TypeResponse
  type_key: String
  kind: String
  size: Int
  alignment: Int
  fields: Vec[String] = Vec::new()
end

pub struct EffectsResponse
  function: String
  bits: Int
  capabilities: Vec[String] = Vec::new()
  purity: String
end

pub struct OwnershipResponse
  function: String
  rows: Vec[String] = Vec::new()
end

# (fourth-audit P0-12) ContractResponse carries the ContractFact's four
# DISTINCT content fields: the stable clause id (the §31 row key text —
# "fn|kind|canonical"), the kind word, the canonical expression render, the
# expression fingerprint render and the declared message (Option::None
# renders ""). The canonical expression may itself contain '|' and is NEVER
# a field of contract_id after a text split; the record is built from the
# ContractFact row (contract_response_of_fact) or from its own wire render
# (wire_parse_contract) — never parsed out of a canonical row.
pub struct ContractResponse
  contract_id: String
  kind: String
  canonical_expression: String = ""
  fingerprint: String
  message: String
end

pub struct MirFunctionResponse
  function: String
  summary: String
end

pub struct AbiResponse
  surface_id: String
  rows: Vec[String] = Vec::new()
end

pub struct DiagnosticResponse
  diagnostic_id: String
  code: String
  message: String
  related: Vec[String] = Vec::new()
end

pub struct DeltaResponse
  rows: Vec[String] = Vec::new()
end

pub struct PlanResponse
  rows: Vec[String] = Vec::new()
end

pub enum SemanticWirePayload
  Callers(record: CallersResponse)
  Callees(record: CalleesResponse)
  Symbols(record: SymbolsResponse)
  Type(record: TypeResponse)
  Effects(record: EffectsResponse)
  Ownership(record: OwnershipResponse)
  Contract(record: ContractResponse)
  MirFunction(record: MirFunctionResponse)
  Abi(record: AbiResponse)
  Diagnostic(record: DiagnosticResponse)
  Delta(record: DeltaResponse)
  Plan(record: PlanResponse)
end

# One request: operation is a session-op name; payload = the arg key text.
struct SemanticRequest
  protocol_version: Int
  request_id: Int
  operation: String
  payload: String
end

# One response: ok + kind + sorted keys carry the §38 answer on the wire;
# payload (audit item 23) is the TYPED semantic answer the server routes
# from the §38 QueryResults — Option::None for error responses
# (protocol_error), for parsed responses (never serialized — see the
# module doc) and for the ops whose rows carry no payload family. error
# carries the fail-closed reason text (kind "protocol_error").
struct SemanticResponse
  protocol_version: Int
  request_id: Int
  ok: Bool
  kind: String
  keys: Vec[String] = Vec::new()
  payload: Option[SemanticResponsePayload] = Option::None
  # (third-audit item 22) the typed wire record whose canonical render IS
  # the keys field when the answer belongs to one of the twelve record
  # families; Option::None for error responses, parsed responses (the
  # frame never carries it — see the module doc) and the families with no
  # record (unknown / *_unavailable / explain trees / revision). Never a
  # second wire field: semantic_response_frame writes kind + keys only.
  wire_payload: Option[SemanticWirePayload] = Option::None
  error: String = ""
end

# ———————————————————————————————————————————————————————————————
# Session lifecycle — build, facade, revise, delta
# ———————————————————————————————————————————————————————————————

# Build a session over one snapshot: index ONCE, revision = the snapshot's
# digest (its own words when finalized). The OFFLINE-ARTIFACT form of the
# session (see snapshot_only_session): it serves a serialized §30 artifact
# and carries none of the pipeline's live state (target / final_* slots
# stay None — the §33/ABI follow-ups that need the real TargetDesc or the
# verified MirProgram require a session built at the compiler boundary via
# compiler_session_from_finalized).
pub def new_compiler_session(snapshot: SemanticSnapshot) -> CompilerSession
  var revision = semantic_snapshot_digest(&snapshot)
  if snapshot.revision.hi != 0 || snapshot.revision.lo != 0 then
    revision = snapshot.revision
  end
  CompilerSession {
    revision: revision,
    snapshot: snapshot,
    index: build_semantic_index(&snapshot),
    diagnostics_store: new_diagnostic_store()
  }
end

# The OFFLINE-ARTIFACT session constructor (audit item 21): the explicitly
# documented artifact form of new_compiler_session — ONE finalized §30
# SemanticSnapshot in (whatever the writer recorded: revision + the served
# tables), a session out. It never pretends to hold pipeline state: the
# target / final_env / final_typed / final_mir slots are None (documented
# above), so a snapshot_only_session serves the §38 snapshot+index ops and
# its mir_slice op answers "mir_slice_unavailable" (the adapter's
# program-less answer — see semantic_query.tg); it is the correct session
# for a server fed from snapshot FILES rather than from a live compile.
pub def snapshot_only_session(snapshot: SemanticSnapshot) -> CompilerSession
  new_compiler_session(snapshot)
end

# The OFFLINE-ARTIFACT session from a serialized snapshot TEXT (the
# deserializer lane): parse the artifact (semantic_snapshot_parse — the
# exact inverse of the serializer) and wrap the record in the artifact
# session form above. Result::Err carries the parser's fail-closed reason
# verbatim (line number, row tag, field). This is the ONE entry the driver
# (`tg server --snapshot-only --snapshot=<path>`) calls after reading the
# file: no pipeline state is constructed or implied.
pub def snapshot_session_from_text(text: String) -> Result[CompilerSession, String]
  match semantic_snapshot_parse(text)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(snapshot) then Result::Ok(snapshot_only_session(&snapshot))
  end
end

# The PIPELINE-BOUNDARY session constructor (audit item 21): the session
# built at the successful final compiler boundary — the exact values the
# compile pipeline has in scope after the FINAL verify (the driver's
# compile_snapshot_route: env = the analyzer's TypeEnv, typed = the typed
# program it returned, mir_program = the monomorphized + optimized +
# verified MirProgram, snapshot = the §30 SemanticSnapshot of that
# finalized state, index = the §32 index built from it). revision is the
# compile revision the session serves (the snapshot's content-addressed
# digest after semantic_snapshot_finalize — the driver passes
# snapshot.revision); target_desc is the compilation's REAL TargetDesc
# record (target_desc.tg — the desc the §30 builder stamped the
# snapshot's StableTargetId from). Every field of the session is filled:
# revision / snapshot / index, target := the descriptor, the three
# final_* slots := the pipeline values, and evidence := the compilation's
# §37 VerifiedCompilationEvidence (Option — the pipeline-boundary caller
# passes the evidence its stages established; the offline forms leave it
# None). The session then carries the finalized state (the final verified
# MirProgram included) that the §33-slice / ABI / layout follow-ups
# consume — the §38/§39 mir_slice op routes the final_mir through
# semantic_slice.tg's typed entry (see the request-routing section).
pub def compiler_session_from_finalized(
  revision: StableDigest,
  target_desc: TargetDesc,
  env: TypeEnv,
  typed: TypedProgram,
  mir_program: MirProgram,
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  evidence: Option[VerifiedCompilationEvidence] = Option::None,
  diagnostics: Vec[Diagnostic] = Vec::new(),
  # (audit order P0-15) the verified-edit transaction inputs: the source
  # text + file name the compile consumed, the compile's options record,
  # the POST-BUILD persistent lineage store (the builder mutated it) and
  # the retained rationale history. Defaulted so every offline / test call
  # site stays valid; the driver's snapshot route passes the real values
  # (see driver.tg's boundary call).
  source: String = "",
  source_file: String = "",
  compile_options: CompilerOptions = default_options(),
  lineages: DeclLineageStore = stable_lineage_store_new(),
  rationale_store: RationaleStore = rationale_store_new()
) -> CompilerSession
  var store = new_diagnostic_store()
  diagnostic_store_add_all(&mut store, diagnostics)
  CompilerSession {
    revision: revision,
    snapshot: snapshot,
    index: index,
    target: Option::Some(target_desc),
    final_env: Option::Some(env),
    final_typed: Option::Some(typed),
    final_mir: Option::Some(mir_program),
    evidence: evidence,
    diagnostics_store: store,
    source: source,
    source_file: source_file,
    compile_options: compile_options,
    lineages: lineages,
    rationale_store: rationale_store
  }
end

# The §38 facade ON DEMAND — the same snapshot+index, never duplicated;
# (third-audit items 23/24) the session's retained diagnostic store and
# evidence ride the facade so the §38 query ops answer from the SAME
# state the §39 dispatch serves.
pub def session_query(session: CompilerSession) -> SemanticQuerySession
  new_semantic_query_session(session.snapshot, session.index,
    Option::Some(session.diagnostics_store.clone()), session.evidence.clone())
end

# (third-audit items 23/24) Append ONE diagnostic to the retained store —
# the store-side add surface for callers that hold the session and a
# diagnostic produced after the boundary (idempotent per content, stable
# ids; see semantic_diagnostics.tg).
pub def session_diagnostics_add(
  inout session: CompilerSession, diagnostic: Diagnostic
) -> StableDiagnosticId
  var store = session.diagnostics_store.clone()
  let id = diagnostic_store_add(&mut store, diagnostic)
  session.diagnostics_store = store
  id
end

pub def session_diagnostics_add_all(
  inout session: CompilerSession, diagnostics: Vec[Diagnostic]
) -> Vec[StableDiagnosticId]
  var store = session.diagnostics_store.clone()
  let ids = diagnostic_store_add_all(&mut store, diagnostics)
  session.diagnostics_store = store
  ids
end

pub def session_diagnostics_len(session: CompilerSession) -> Int
  session.diagnostics_store.by_id.len()
end

# The §31 delta of two sessions — the INVALIDATION UNIT of a revision:
# exactly delta.affected's def keys may have changed answer rows (equal
# revision digests short-circuit to the empty delta).
pub def session_delta(old: CompilerSession, new: CompilerSession) -> SemanticDelta
  if old.revision.hi == new.revision.hi && old.revision.lo == new.revision.lo then
    return semantic_delta_empty()
  end
  semantic_delta_of(&old.snapshot, &new.snapshot)
end

# (fourth-audit P0-18) The session delta STATUS: a pair of live sessions
# always carries two snapshots, so the status is Complete over the session
# delta. The Option form treats a MISSING old session (no snapshot to diff
# against) as Unavailable — never an empty delta that a budget could pass.
pub def session_delta_status(old: CompilerSession, new: CompilerSession) -> DeltaStatus
  DeltaStatus::Complete(session_delta(&old, &new))
end

pub def session_delta_status_of(old: Option[CompilerSession], new: CompilerSession) -> DeltaStatus
  match old
  when Option::None then
    DeltaStatus::Unavailable("missing old session snapshot: the session delta cannot be computed")
  when Option::Some(o) then
    DeltaStatus::Complete(session_delta(&o, &new))
  end
end

# Replace the session after a source revision (the layer diffs with
# session_delta and drops cached rows for delta.affected keys).
pub def session_revise(session: CompilerSession, new_snapshot: SemanticSnapshot) -> CompilerSession
  new_compiler_session(new_snapshot)
end

# The §37 SPAN PATCH of two sessions (audit item 20 — the proof-patch
# surface a future proof-patch route calls): given the OLD and NEW
# sessions of a change and ONE §36 ChangeBudget, produce the
# ProofCarryingPatch that proof_patch_between assembles from the pair's
# VerifiedCompilationEvidence slots with the pair's REAL §31 delta
# (session_delta — the diff the route computes between the two compiled
# states). Option::None when EITHER session carries no evidence slot (an
# offline-artifact session — new_compiler_session / snapshot_only_session
# — ran no pipeline, so no stage property of the span is claimable; the
# helper fails closed rather than assemble a patch from a missing side).
pub def session_proof_patch_between(
  old: CompilerSession,
  new: CompilerSession,
  budget: ChangeBudget
) -> Option[ProofCarryingPatch]
  match old.evidence
  when Option::None then Option::None
  when Option::Some(old_evidence) then
    match new.evidence
    when Option::None then Option::None
    when Option::Some(new_evidence) then
      Option::Some(proof_patch_between(
        &old_evidence, &new_evidence, &budget, Option::Some(session_delta(&old, &new))))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# (audit order P0-15) THE AUTHORITATIVE VERIFIED-EDIT TRANSACTION
# ———————————————————————————————————————————————————————————————
# session_apply_verified_edit is the audit's `session.apply_verified_edit`:
# ONE SemanticEdit + ONE §36 ChangeBudget + ONE VerificationPolicy in, ONE
# VerifiedEditTransaction out. The transaction runs the WHOLE chain:
#
#   1. resolve_edit against the session's snapshot/index (§32/§29 — the
#      resolution authority);
#   2. the identity-driven source rewrite
#      (apply_edit_to_source_checked_with_origins: parse -> resolve ->
#      type -> access -> resource on the regenerated text) and the
#      planned-set comparison over the reachable front-end rows;
#   3. the FULL compile of the edited source through the session's own
#      pipeline: parse -> merge imports -> analyze -> lower -> verify_mir ->
#      effect/purity/budget annotation checks -> monomorphize -> tail-ABI /
#      SLP stamps -> optimize_mir -> verify_mir ->
#      semantic_snapshot_of_final_state -> finalize (final MIR included);
#   4. the NEW snapshot built through the session's persistent lineage
#      store, with a fresh §32 index and the OLD/NEW revision digests;
#   5. the ACTUAL §31 delta (semantic_delta_of, Complete) of the two
#      finalized snapshots, compared against the planned ResolvedEdit sets
#      over edit_authoritative_delta_rows — the snapshot-only families
#      (effect/allocation, capability, ownership, drop-plan, contract,
#      unsafe, public-api, ABI) included;
#   6. budget_verify_with_equivalence over the ACTUAL delta (the budget's
#      contract policy and equivalence requirement apply);
#   7. affected tests + coverage consequences from the §40 coverage graph
#      when the snapshot carries the relationship rows; tests-executed and
#      performance are REAL surfaces with no compiler-side data — they stay
#      Unavailable, never fabricated;
#   8. the rationale records (the edit reason, the actual delta, the budget
#      verdict, the equivalence result) appended to the session's rationale
#      store — the snapshot route's rationale wiring extended beyond the
#      optimizer-decision journal;
#   9. the §37 patch through proof_patch_of_level (VerifiedFull ONLY) and
#      the final proof hash over the transaction's canonical render.
#
# THE HONEST LEVELS (VerificationLevel): VerifiedFull = the whole chain
# above ran and the authoritative snapshot delta exists; VerifiedFrontend =
# the source edit applied and the front-end chain re-validated but the
# full pipeline was UNAVAILABLE (the session carries no TargetDesc — the
# offline-artifact form); ProvisionalFrontEnd = the transaction stopped
# before final MIR/snapshot creation (resolve/apply failure, a pipeline
# stage failure, or a snapshot-build failure). At ProvisionalFrontEnd and
# VerifiedFrontend the actual delta status is Unavailable — never an empty
# delta a budget could pass — no proof patch is carried, and the
# VerifiedProofPatch constructor refuses both levels.
#
# POLICY (VerificationPolicy): minimum_level is the weakest level the
# caller accepts (VerifiedFull by default — the full pipeline required);
# require_delta_agreement / require_budget gate the accepted verdict at
# VerifiedFull. accepted = the reached level is at or above the minimum, no
# refusal was recorded, and the required gates passed. A rejected
# transaction still carries its diagnostics, deltas, budget rows and
# rationale — the caller sees exactly why.

# The per-change verification policy (the audit's `verification` argument).
pub struct VerificationPolicy
  # The weakest VerificationLevel the caller accepts. VerifiedFull (the
  # default) demands the full pipeline + the authoritative snapshot delta;
  # VerifiedFrontend accepts a re-validated source edit whose full
  # pipeline was unavailable; ProvisionalFrontEnd accepts a transaction
  # that stopped early (the fail-open-to-front-end policy — never a proof).
  minimum_level: VerificationLevel = VerificationLevel::VerifiedFull
  # At VerifiedFull: the authoritative delta must agree with the planned
  # ResolvedEdit sets (an unexpected effect/allocation/ABI row rejects).
  require_delta_agreement: Bool = true
  # At VerifiedFull: budget_verify_with_equivalence must return no
  # violations.
  require_budget: Bool = true
end

# ONE verified-edit transaction: the audit's record, field for field.
# Everything is REAL subsystem data; the surfaces with no compiler-side
# data (tests executed, performance) carry their typed status rows as
# Unavailable instead of fabricated rows.
pub struct VerifiedEditTransaction
  edit: SemanticEdit
  level: VerificationLevel
  # The OLD session's content-addressed revision render and the NEW
  # finalized snapshot's revision render ("" when no new snapshot exists).
  old_revision: String
  new_revision: String
  # The resolved target/preconditions (the resolution record the plan was
  # built from).
  targets: Vec[String] = Vec::new()
  preconditions: Vec[String] = Vec::new()
  # The planned delta (ResolvedEdit.expected_delta + expected_write).
  planned_delta: Vec[String] = Vec::new()
  # The ACTUAL authoritative §31 delta and its status. Complete(delta) only
  # after the final snapshot exists; every earlier stop is Unavailable
  # with the reason.
  actual_delta: SemanticDelta
  actual_delta_status: DeltaStatus
  # The authoritative delta projected onto the canonical row vocabulary
  # (edit_authoritative_delta_rows) and the planned-set comparison.
  actual_rows: Vec[String] = Vec::new()
  delta_agreement: Bool = false
  unexpected_rows: Vec[String] = Vec::new()
  unmatched_rows: Vec[String] = Vec::new()
  # The reachable front-end comparison (the source pipeline's own rows).
  frontend_actual_rows: Vec[String] = Vec::new()
  frontend_agreement: Bool = false
  # The §36 envelope verdict over the authoritative delta (with the
  # budget's equivalence requirement evaluated through the §41 result).
  budget_result: Vec[String] = Vec::new()
  budget_status: VerificationStatus = VerificationStatus::Unavailable
  # The stage diagnostics that stopped the transaction (canonical texts).
  diagnostics: Vec[String] = Vec::new()
  # The regenerated source text ("" until the rewrite applied).
  edited_source: String = ""
  # The application outcome: applied = the rewritten source re-validated;
  # accepted = the policy verdict over the reached level + gates; refusal
  # names the exact stop / refusal reason ("" when the full chain ran).
  # blocked = a HARD failure (resolve / apply / pipeline / snapshot); the
  # policy can never accept a blocked transaction, while an unavailability
  # note (no source, no TargetDesc) is not a failure — a policy whose
  # minimum admits the reached level accepts such a transaction.
  applied: Bool = false
  blocked: Bool = false
  accepted: Bool = false
  refusal: String = ""
  # Tests / coverage: affected_tests + coverage consequences are filled
  # from the §40 coverage graph where the snapshot carries the rows; a
  # missing graph stays Unavailable (never fabricated). tests_executed has
  # no compiler-side test runner — always Unavailable today.
  affected_tests: Vec[String] = Vec::new()
  affected_tests_status: VerificationStatus = VerificationStatus::Unavailable
  tests_executed: Vec[String] = Vec::new()
  tests_executed_status: VerificationStatus = VerificationStatus::Unavailable
  coverage_consequences: Vec[String] = Vec::new()
  coverage_status: VerificationStatus = VerificationStatus::Unavailable
  # The §41 equivalence result computed over the OLD session's final MIR
  # and the NEW optimized MIR (per-function, worst-case aggregate). None =
  # no baseline program held (Unavailable) — never an implicit claim.
  equivalence: Option[EquivalenceResult] = Option::None
  equivalence_status: VerificationStatus = VerificationStatus::Unavailable
  # Performance changes: no perf run feeds the compiler — Unavailable.
  performance_changes: Vec[String] = Vec::new()
  performance_status: VerificationStatus = VerificationStatus::Unavailable
  # ABI changes: the authoritative snapshot ABI surface diff rows.
  abi_changes: Vec[String] = Vec::new()
  abi_status: VerificationStatus = VerificationStatus::Unavailable
  # The rationale records the transaction appended (edit reason + actual
  # change + budget + equivalence).
  rationale_records: Vec[RationaleRecord] = Vec::new()
  # The §37 patch (populated at VerifiedFull only — and cleared again when
  # the policy verdict rejects) and the gated wrapper. The final proof hash
  # is the digest over verified_edit_transaction_render.
  proof_patch: Option[ProofCarryingPatch] = Option::None
  verified_proof: Option[VerifiedProofPatch] = Option::None
  proof_hash: StableDigest
  # The revised session (new snapshot + index + final state + evidence +
  # lineages + rationale store) at VerifiedFull; None on every earlier
  # stop. The serve loop keeps serving the caller's session value — an
  # in-process caller applies this with session_revise semantics.
  new_session: Option[CompilerSession] = Option::None
end

def session_bool_text(b: Bool) -> String
  if b then "true" else "false" end
end

def session_first_row(rows: Vec[String]) -> String
  if rows.len() > 0 then rows[0].clone() else "" end
end

def session_diag_rows(diags: Vec[Diagnostic]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for d in diags do
    var prefix = ""
    match d.code.clone()
    when Option::Some(c) then prefix = c.clone() + ": "
    when Option::None then ()
    end
    out.push(prefix + d.message.clone())
  end
  out
end

# The driver's SnapshotError render (mirrored here so the session module
# owns its own diagnostic text; the enum is the builder's ONE error
# vocabulary).
def session_snapshot_error_text(e: SnapshotError) -> String
  match e
  when SnapshotError::UnstableTypeIdentity(tid) then "unstable type identity (type id " + tid + ")"
  when SnapshotError::UnstableDefIdentity then "unstable def identity"
  when SnapshotError::UnstableFieldIdentity then "unstable field identity"
  when SnapshotError::UnstableVariantIdentity then "unstable variant identity"
  when SnapshotError::UnstableLocalIdentity then "unstable local identity"
  when SnapshotError::UnstableClosureIdentity then "unstable closure identity"
  when SnapshotError::UnstableBlockIdentity then "unstable block identity"
  when SnapshotError::UnstableInstanceDisplay then "unstable instance display"
  when SnapshotError::UnstableTarget then "unstable target"
  when SnapshotError::UntrackedOrigin(api, detail) then
    "untracked-artifact: " + api + ": " + detail
  end
end

def session_edit_target_text(resolved: ResolvedEdit) -> String
  if resolved.targets.len() > 0 then resolved.targets[0].clone() else "" end
end

def session_verified_transaction_new(session: CompilerSession, edit: SemanticEdit) -> VerifiedEditTransaction
  VerifiedEditTransaction {
    edit: edit,
    level: VerificationLevel::ProvisionalFrontEnd,
    old_revision: semantic_digest_render(&session.revision),
    new_revision: "",
    actual_delta: semantic_delta_empty(),
    actual_delta_status: DeltaStatus::Unavailable("the authoritative snapshot delta was not computed"),
    proof_hash: StableDigest { hi: 0, lo: 0 }
  }
end

# The accepted verdict + the final proof hash. The proof hash covers the
# canonical render (verified_edit_transaction_rows — every scalar, delta,
# budget, rationale and proof status row, proof_hash excluded); it is
# computed LAST so it commits the entire record. accepted requires the
# reached level to meet the policy minimum, no refusal, and — at
# VerifiedFull — the required delta-agreement / budget gates; a rejected
# transaction never carries a proof patch.
def session_verified_transaction_seal(
  tx: VerifiedEditTransaction, policy: VerificationPolicy
) -> VerifiedEditTransaction
  var out = tx
  if out.blocked then
    # THE AUDIT RULE (P0-15): anything that STOPPED before final
    # MIR/snapshot creation reports ProvisionalFrontEnd — even when the
    # front-end re-validation itself succeeded (a pipeline stage then
    # failed). VerifiedFrontend is reserved for the source-applying
    # transaction whose full pipeline was merely UNAVAILABLE.
    out.level = VerificationLevel::ProvisionalFrontEnd
    out.accepted = false
  else
    var ok = true
    if verification_level_rank(out.level.clone()) <
       verification_level_rank(policy.minimum_level.clone()) then
      ok = false
      if out.refusal.len() == 0 then
        out.refusal = "verification-level " + verification_level_word(out.level.clone()) +
          " below policy minimum " + verification_level_word(policy.minimum_level.clone())
      end
    end
    if ok && policy.require_delta_agreement &&
       out.level == VerificationLevel::VerifiedFull && !out.delta_agreement then
      ok = false
      out.refusal = "delta-mismatch: unexpected=[" + out.unexpected_rows.join(",") +
        "] unmatched=[" + out.unmatched_rows.join(",") + "]"
    end
    if ok && policy.require_budget &&
       out.level == VerificationLevel::VerifiedFull && out.budget_result.len() > 0 then
      ok = false
      out.refusal = "budget-violations:" + out.budget_result.len().to_string()
    end
    out.accepted = ok
  end
  if !out.accepted then
    out.proof_patch = Option::None
    out.verified_proof = Option::None
  end
  out.proof_hash = stable_digest_of(&verified_edit_transaction_render(&out))
  if out.accepted && out.level == VerificationLevel::VerifiedFull then
    match out.proof_patch.clone()
    when Option::Some(p) then
      out.verified_proof = verified_proof_patch(out.level.clone(), p, out.proof_hash.clone())
    when Option::None then ()
    end
  end
  out
end

# ———— The §41 equivalence aggregate (old final MIR vs new optimized MIR) ————
# The transaction compares EVERY function the new program carries against
# the OLD session's own final MIR form (paired by name) and reports the
# WORST level across the pairs; a function with no baseline form and a
# baseline function with no new form each contribute Unknown (an
# uncompared function is never silently equal). None = the session held no
# final MIR (offline form): the whole surface is Unavailable.
def session_equivalence_rank(r: EquivalenceResult) -> Int
  match equivalence_result_level(r)
  when EquivalenceLevel::Counterexample then 0
  when EquivalenceLevel::Unknown then 1
  when EquivalenceLevel::TestedNoCounterexample then 2
  when EquivalenceLevel::StructurallyEquivalent then 3
  when EquivalenceLevel::ProvenForFiniteDomain then 4
  when EquivalenceLevel::ProvenUnderConstraints then 5
  end
end

def session_equivalence_better(
  worst: Option[EquivalenceResult], candidate: EquivalenceResult
) -> Bool
  match worst
  when Option::None then true
  when Option::Some(w) then
    session_equivalence_rank(candidate) < session_equivalence_rank(w)
  end
end

def session_equivalence_of(
  old_mir: Option[MirProgram], new_mir: MirProgram
) -> Option[EquivalenceResult]
  match old_mir
  when Option::None then Option::None
  when Option::Some(old) then
    var worst: Option[EquivalenceResult] = Option::None
    var old_by_name: Map[String, MirFunction] = Map::new()
    for old_fn in old.functions do
      old_by_name.insert(old_fn.name.clone(), old_fn.clone())
    end
    var new_names: Set[String] = Set::new()
    for new_fn in new_mir.functions do
      new_names.insert(new_fn.name.clone())
      match old_by_name.get(new_fn.name.clone())
      when Option::Some(old_fn) then
        let r = equivalence_check(old_fn.clone(), new_fn.clone(), 0)
        if session_equivalence_better(worst.clone(), r.clone()) then
          worst = Option::Some(r)
        end
      when Option::None then
        let r = equivalence_unknown("new function '" + new_fn.name.clone() +
          "' has no baseline MIR form to compare against")
        if session_equivalence_better(worst.clone(), r.clone()) then
          worst = Option::Some(r)
        end
      end
    end
    for old_fn in old.functions do
      if !new_names.contains(&old_fn.name) then
        let r = equivalence_unknown("baseline function '" + old_fn.name.clone() +
          "' has no new MIR form to compare against")
        if session_equivalence_better(worst.clone(), r.clone()) then
          worst = Option::Some(r)
        end
      end
    end
    worst
  end
end

# ———— The canonical render + the level-gated proof hash ————
# Fixed field order; proof_hash is excluded from its own preimage and
# represented by the separate accessor. The render is the transaction's
# serialization surface: a ProvisionalFrontEnd / VerifiedFrontend
# transaction renders "proof: unavailable" and "actual-delta: unavailable"
# — it cannot render as a verified proof.
pub def verified_edit_transaction_rows(tx: VerifiedEditTransaction) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("edit:" + edit_kind_word(tx.edit.clone()))
  rows.push("level:" + verification_level_word(tx.level.clone()))
  rows.push("old-revision:" + tx.old_revision.clone())
  rows.push("new-revision:" + tx.new_revision.clone())
  rows.push("applied:" + session_bool_text(tx.applied))
  rows.push("accepted:" + session_bool_text(tx.accepted))
  rows.push("refusal:" + tx.refusal.clone())
  rows.push("delta-agreement:" + session_bool_text(tx.delta_agreement))
  rows.push("budget-status:" + verification_status_word(tx.budget_status))
  rows.push("affected-tests-status:" + verification_status_word(tx.affected_tests_status))
  rows.push("tests-executed-status:" + verification_status_word(tx.tests_executed_status))
  rows.push("coverage-status:" + verification_status_word(tx.coverage_status))
  rows.push("equivalence-status:" + verification_status_word(tx.equivalence_status))
  rows.push("performance-status:" + verification_status_word(tx.performance_status))
  rows.push("abi-status:" + verification_status_word(tx.abi_status))
  match tx.actual_delta_status.clone()
  when DeltaStatus::Complete(_) then rows.push("actual-delta: complete")
  when DeltaStatus::Unavailable(reason) then rows.push("actual-delta: unavailable " + reason)
  end
  match tx.equivalence.clone()
  when Option::Some(r) then rows.push("equivalence:" + equivalence_result_render(r))
  when Option::None then rows.push("equivalence: unavailable")
  end
  for t in tx.targets do
    rows.push("target:" + t.clone())
  end
  for p in tx.preconditions do
    rows.push("precondition:" + p.clone())
  end
  for r in tx.planned_delta do
    rows.push("planned:" + r.clone())
  end
  for r in tx.frontend_actual_rows do
    rows.push("frontend:" + r.clone())
  end
  rows.push("frontend-agreement:" + session_bool_text(tx.frontend_agreement))
  for r in tx.actual_rows do
    rows.push("actual:" + r.clone())
  end
  for r in tx.unexpected_rows do
    rows.push("unexpected:" + r.clone())
  end
  for r in tx.unmatched_rows do
    rows.push("unmatched:" + r.clone())
  end
  for r in tx.diagnostics do
    rows.push("diagnostic:" + r.clone())
  end
  for r in tx.budget_result do
    rows.push("budget:" + r.clone())
  end
  for r in tx.affected_tests do
    rows.push("affected-test:" + r.clone())
  end
  for r in tx.tests_executed do
    rows.push("tests-executed:" + r.clone())
  end
  for r in tx.coverage_consequences do
    rows.push("coverage:" + r.clone())
  end
  for r in tx.performance_changes do
    rows.push("performance:" + r.clone())
  end
  for r in tx.abi_changes do
    rows.push("abi:" + r.clone())
  end
  for rec in tx.rationale_records do
    rows.push("rationale:" + rationale_identity_text(rec.clone()))
  end
  match tx.proof_patch.clone()
  when Option::Some(p) then
    for r in proof_patch_verification_rows(p) do
      rows.push("proof:" + r.clone())
    end
    rows.push("verified-proof:" + session_bool_text(tx.verified_proof.is_some()))
  when Option::None then
    rows.push("proof: unavailable")
  end
  rows
end

# The transaction's canonical render text (the proof-hash preimage).
pub def verified_edit_transaction_render(tx: VerifiedEditTransaction) -> String
  verified_edit_transaction_rows(tx).join("\n")
end

# The final proof hash render of a transaction.
pub def verified_edit_transaction_proof_hash_text(tx: VerifiedEditTransaction) -> String
  semantic_digest_render(&tx.proof_hash)
end

# ———— The rationale extension (the edit reason / actual change / evidence) ————
# The snapshot route's rationale wiring records ONLY the optimizer-decision
# journal today; the transaction extends it with the edit's own grounded
# records: ONE edit record (the kind, the resolved target, the actual
# change summary, the planned/actual/precondition evidence and the
# affected-set dependencies), the §31 actual delta record, the §36 budget
# verdict record and (when a result was computed) the §41 equivalence
# record. rationale_store_add_all is idempotent by record digest.
def session_edit_rationale_records(
  revision: String, edit: SemanticEdit, resolved: ResolvedEdit, delta: SemanticDelta,
  planned: Vec[String], actual: Vec[String], budget_rows: Vec[String],
  equivalence: Option[EquivalenceResult], preconditions: Vec[String]
) -> Vec[RationaleRecord]
  let kind_word = edit_kind_word(edit.clone())
  let subject_text = "edit:" + kind_word.clone() + ":" + session_edit_target_text(resolved.clone())
  var evidence: Vec[RationaleEvidence] = Vec::new()
  var pi = 0
  while pi < preconditions.len() do
    evidence.push(rationale_evidence_text("precondition".to_string(),
      preconditions[pi].clone(), preconditions[pi].clone()))
    pi = pi + 1
  end
  for row in planned do
    evidence.push(rationale_evidence_text("planned".to_string(), row.clone(), row.clone()))
  end
  for row in actual do
    evidence.push(rationale_evidence_text("actual".to_string(), row.clone(), row.clone()))
  end
  var deps: Vec[RationaleDependency] = Vec::new()
  for key in resolved.affected do
    deps.push(rationale_dependency("affected".to_string(), key.clone()))
  end
  var records: Vec[RationaleRecord] = Vec::new()
  records.push(rationale_record_new(
    revision.clone(),
    RationaleKind::Delta,
    rationale_subject_of_text(subject_text.clone()),
    "apply-verified-edit".to_string(),
    "edit " + kind_word.clone() + " produced " + actual.len().to_string() +
      " authoritative delta row(s)",
    evidence,
    deps))
  records.push(rationale_of_delta(revision.clone(), delta))
  records.push(rationale_of_budget_rows(revision.clone(),
    "edit-budget:" + subject_text.clone(), budget_rows))
  match equivalence
  when Option::Some(r) then
    records.push(rationale_of_equivalence(revision.clone(), subject_text, r))
  when Option::None then ()
  end
  records
end

# ———— THE ENTRY ————
pub def session_apply_verified_edit(
  session: CompilerSession,
  edit: SemanticEdit,
  budget: ChangeBudget,
  policy: VerificationPolicy = VerificationPolicy {}
) -> VerifiedEditTransaction
  var tx = session_verified_transaction_new(session.clone(), edit.clone())
  # 1. Resolution against the session's snapshot/index.
  let resolved = match resolve_edit(&session.index, &session.snapshot, edit.clone())
  when Result::Ok(r) then r
  when Result::Err(e) then
    tx.diagnostics = Vec::from(["resolve:" + edit_error_word(e)])
    tx.refusal = "resolve:" + edit_error_word(e)
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  tx.targets = resolved.targets.clone()
  tx.preconditions = resolved.preconditions.clone()
  var planned_rows = resolved.expected_delta.clone()
  for write_key in resolved.expected_write do
    planned_rows.push(write_key.clone())
  end
  tx.planned_delta = planned_rows
  # 2. The source surface must exist on the session (the offline-artifact
  # form carries none; the transaction then has nothing to rewrite).
  if session.source.len() == 0 then
    tx.refusal = "source-unavailable: the session carries no source text (the offline-artifact session form cannot run the source edit pipeline)"
    tx.diagnostics = Vec::from([tx.refusal.clone()])
    # Nothing was applied: the requested edit was not verified at all, so
    # the policy can never accept this transaction (the ProvisionalFrontEnd
    # level is the honest claim, not a pass).
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  # 3. The identity-driven source rewrite + front-end re-validation.
  let check = apply_edit_to_source_checked_with_origins(
    session.source.clone(), resolved.clone(), mir_origin_map_new())
  match check.application.clone()
  when Option::Some(app) then
    tx.applied = app.revalidated
    tx.edited_source = app.edited_source.clone()
    tx.frontend_actual_rows = app.actual_delta_rows.clone()
    tx.frontend_agreement = app.delta_match
  when Option::None then ()
  end
  if !tx.applied then
    tx.diagnostics = Vec::from([check.evidence.clone()])
    tx.refusal = "source-apply:" + check.evidence.clone()
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  # The front-end chain (parse -> resolve -> type -> access -> resource)
  # verified: the transaction's claim floor from here on.
  tx.level = VerificationLevel::VerifiedFrontend
  # 4. The full pipeline needs the compilation's REAL target descriptor.
  match session.target.clone()
  when Option::None then
    tx.refusal = "full-pipeline-unavailable: the session carries no TargetDesc (the offline-artifact session form); the highest truthful level is the re-validated front end"
    return session_verified_transaction_seal(tx, policy)
  when Option::Some(target_desc) then
    return session_verified_edit_full(session, tx, resolved, budget, policy, target_desc)
  end
end

# The full-pipeline continuation (steps 3-9 of the module doc). Every stop
# before the finalized snapshot returns ProvisionalFrontEnd (the audit's
# rule); VerifiedFull is reached only after the snapshot built, the
# authoritative delta was diffed, the budget ran and the rationale/proof
# assembly completed.
def session_verified_edit_full(
  session: CompilerSession, tx0: VerifiedEditTransaction, resolved: ResolvedEdit,
  budget: ChangeBudget, policy: VerificationPolicy, target_desc: TargetDesc
) -> VerifiedEditTransaction
  var tx = tx0
  var opts = session.compile_options.clone()
  let parsed = match parse_source_program(tx.edited_source.clone(), session.source_file.clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then
    tx.diagnostics = session_diag_rows(diags)
    tx.refusal = "pipeline-parse:" + session_first_row(tx.diagnostics.clone())
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  let ast = match merge_imported_deps(parsed, false)
  when Result::Ok(a) then a
  when Result::Err(e) then
    tx.diagnostics = Vec::from(["imports:" + e.clone()])
    tx.refusal = "pipeline-imports:" + e
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  var env = type_env_new()
  let analyzed = match analyze_program(&mut env, &mut ast, opts.clone())
  when Result::Ok(a) then a
  when Result::Err(diags) then
    tx.diagnostics = session_diag_rows(diags)
    tx.refusal = "pipeline-analyze:" + session_first_row(tx.diagnostics.clone())
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  var mir = match driver_lower_to_mir(&ast, Option::Some(analyzed.typed.clone()))
  when Result::Ok(m) then m
  when Result::Err(e) then
    tx.diagnostics = Vec::from(["lower:" + e.clone()])
    tx.refusal = "pipeline-lower:" + e
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  let pre_errs = verify_mir(&mir)
  if pre_errs.len() > 0 then
    tx.diagnostics = pre_errs.clone()
    tx.refusal = "pipeline-verify-pre:" + session_first_row(pre_errs)
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  let mir_effect_errs = check_effect_class_annotations_mir(&mir, env)
  if mir_effect_errs.len() > 0 then
    tx.diagnostics = session_diag_rows(type_errors_to_diags(&mir_effect_errs))
    tx.refusal = "pipeline-effects:" + session_first_row(tx.diagnostics.clone())
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  let mir_purity_errs = check_purity_annotations_mir(&mut mir, env)
  if mir_purity_errs.len() > 0 then
    tx.diagnostics = session_diag_rows(type_errors_to_diags(&mir_purity_errs))
    tx.refusal = "pipeline-purity:" + session_first_row(tx.diagnostics.clone())
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  let mir_budget_errs = check_budget_annotations_mir(&mir, env)
  if mir_budget_errs.len() > 0 then
    tx.diagnostics = session_diag_rows(type_errors_to_diags(&mir_budget_errs))
    tx.refusal = "pipeline-budget-annotations:" + session_first_row(tx.diagnostics.clone())
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  var mono_cache = mono_cache_new(&ast, &analyzed.resolutions)
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Ok(_) then ()
  when Result::Err(me) then
    tx.diagnostics = Vec::from(["mono:" + me.len().to_string() + " error(s)"])
    tx.refusal = "pipeline-mono:" + me.len().to_string() + " error(s)"
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  # The route's stamp seams (the authoritative AbiCallPlan + the SLP
  # target-capability stamp), then the optimizer and the FINAL MIR verify.
  stamp_tail_abi_plans(&mut mir, detect_host_target().arch)
  stamp_slp_vector_facility_desc(&mut mir, target_desc.clone())
  optimize_mir(&mut mir, session.compile_options.opt_level)
  let post_errs = verify_mir(&mir)
  if post_errs.len() > 0 then
    tx.diagnostics = post_errs.clone()
    tx.refusal = "pipeline-verify-post:" + session_first_row(post_errs)
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  # THE FINALIZED SNAPSHOT (final MIR included) through the persistent
  # lineage store — the boundary the audit's VerifiedFull level names. The
  # builder runs its own begin/finish revision window over the store, so
  # every unchanged declaration keeps its lineage and number. The resolved
  # rename DeclMove is deliberately NOT applied here: the P0-15 plan
  # grammar models a rename as the old-key removal + new-key creation
  # (expected_delta names the OLD key, expected_write the NEW one), and an
  # identity-continued signature change reports the NEW key on the
  # authoritative side, which the plan row could not name — applying the
  # move would make every rename fail its own plan. The header
  # feature/option rows come from the SESSION's own options record (the
  # same values the baseline header carried).
  var lineage_store = session.lineages.clone()
  let snapshot_features = snapshot_feature_set_of(opts.clone(), target_desc.clone())
  let snapshot_options = snapshot_semantic_options_of(opts.clone(), target_desc.clone())
  let snapshot = match semantic_snapshot_of_final_state(
    &env, &analyzed.typed, &mir, &target_desc, VERSION, StableDigest { hi: 0, lo: 0 },
    &mut lineage_store, analyzed.drop_plan_facts.clone(), snapshot_features, snapshot_options)
  when Result::Ok(s) then s
  when Result::Err(e) then
    tx.diagnostics = Vec::from(["snapshot:" + session_snapshot_error_text(e)])
    tx.refusal = "pipeline-snapshot:" + session_snapshot_error_text(e)
    tx.blocked = true
    return session_verified_transaction_seal(tx, policy)
  end
  var finalized = snapshot
  semantic_snapshot_finalize(&mut finalized)
  let new_revision = finalized.revision
  tx.level = VerificationLevel::VerifiedFull
  tx.new_revision = semantic_digest_render(&new_revision)
  let new_index = build_semantic_index(&finalized)
  # The ACTUAL authoritative delta + the planned-set comparison over the
  # canonical projection (the snapshot-only families included).
  let delta = semantic_delta_of(&session.snapshot, &finalized)
  tx.actual_delta = delta.clone()
  tx.actual_delta_status = DeltaStatus::Complete(delta.clone())
  tx.actual_rows = edit_authoritative_delta_rows(delta.clone())
  let cmp = edit_compare_actual_plan(resolved.clone(), tx.actual_rows.clone())
  tx.unexpected_rows = cmp.unexpected.clone()
  tx.unmatched_rows = cmp.unmatched.clone()
  tx.delta_agreement = cmp.matched && tx.frontend_agreement
  # The §41 equivalence aggregate + the §36 envelope over the actual delta.
  tx.equivalence = session_equivalence_of(session.final_mir.clone(), mir.clone())
  match tx.equivalence.clone()
  when Option::Some(r) then
    if equivalence_result_is_proven(r) then
      tx.equivalence_status = VerificationStatus::Verified
    else
      tx.equivalence_status = VerificationStatus::Failed
    end
  when Option::None then
    tx.equivalence_status = VerificationStatus::Unavailable
  end
  let budget_rows = budget_verify_with_equivalence(&budget, &delta, tx.equivalence.clone())
  tx.budget_result = budget_rows.clone()
  if budget_rows.len() == 0 then
    tx.budget_status = VerificationStatus::Verified
  else
    tx.budget_status = VerificationStatus::Failed
  end
  # The §40 coverage graph: affected tests + coverage points of the
  # affected set, plus the uncovered created-path constraints.
  let graph = coverage_graph_of_snapshot(&finalized)
  var tests: Vec[String] = Vec::new()
  var coverage_rows: Vec[String] = Vec::new()
  for key in delta.affected do
    for t in tests_covering_symbol(&graph, key.clone()) do
      if !tests.contains(&t) then
        tests.push(t.clone())
      end
    end
    for p in coverage_points_of_symbol(&graph, key.clone()) do
      if !coverage_rows.contains(&p) then
        coverage_rows.push(p.clone())
      end
    end
  end
  tests.sort()
  coverage_rows.sort()
  for u in uncovered_paths(&graph, &finalized, &delta) do
    coverage_rows.push(u)
  end
  tx.affected_tests = tests.clone()
  if tests.len() > 0 then
    tx.affected_tests_status = VerificationStatus::Verified
  elsif delta.affected.len() == 0 then
    tx.affected_tests_status = VerificationStatus::Verified
  else
    tx.affected_tests_status = VerificationStatus::Unavailable
  end
  if coverage_graph_has_rows(&graph) then
    tx.coverage_status = VerificationStatus::Verified
  else
    tx.coverage_status = VerificationStatus::Unavailable
  end
  tx.coverage_consequences = coverage_rows.clone()
  # The authoritative ABI surface diff rows.
  tx.abi_changes = semantic_delta_rows_diff(&delta.abi_delta.before.rows,
    &delta.abi_delta.after.rows)
  tx.abi_status = VerificationStatus::Verified
  # (audit order item 7) the REAL ABI-verify stage of THIS transaction's
  # pipeline: the same post-lowering verifier the driver route runs over
  # the finalized MIR on the host route (driver_abi_verify_rows). Its
  # violation rows print on failure.
  let abi_rows = session_abi_verify_rows(mir.clone(), target_desc.clone())
  for abi_row in abi_rows do
    eprintln(abi_row)
  end
  # The REAL verification evidence of THIS transaction's pipeline: the
  # stages it captured are the driver route's (no post-mono verifier
  # checkpoint exists — that status stays Unavailable; abi IS captured
  # since audit order item 7 and carries the verifier's real result).
  let evidence = verified_compilation_evidence_stages(
    tx.new_revision.clone(),
    true,   # parse_ok — parse_source_program succeeded
    true,   # resolution_ok — analyze_program succeeded
    true,   # type_ok
    true,   # access_ok
    true,   # resource_ok
    true,   # mir_verify_ok — the pre-mono verify over the lowered program
    false,  # mono_verify_ok — no post-mono verifier checkpoint
    true,   # post_opt_mir_verify_ok — the final post-opt verify
    true,   # effect_verify_ok
    abi_rows.len() == 0,  # abi_verify_ok — the post-lowering ABI verifier's real result
    true,   # capability_contract_ok
    verification_stage_names_driver_route())
  # The source delta (the two source renders' content hashes).
  var source_delta = SourceDelta {
    changed_files: Vec::from([session.source_file.clone()])
  }
  source_delta.hunk_hashes = Vec::from([
    "old:" + semantic_digest_render(&stable_digest_of(&session.source)),
    "new:" + semantic_digest_render(&stable_digest_of(&tx.edited_source))
  ])
  let bundle = PatchEvidenceBundle {
    source_delta: Option::Some(source_delta),
    affected_tests: tests.clone(),
    coverage_delta_rows: coverage_rows.clone(),
    equivalence: tx.equivalence.clone()
  }
  tx.proof_patch = Option::Some(proof_patch_of_level(
    VerificationLevel::VerifiedFull, &budget, DeltaStatus::Complete(delta.clone()),
    &evidence, bundle))
  # The rationale history append (the session's store carries forward).
  tx.rationale_records = session_edit_rationale_records(
    tx.new_revision.clone(), tx.edit.clone(), resolved.clone(), delta.clone(),
    tx.planned_delta.clone(), tx.actual_rows.clone(), budget_rows.clone(),
    tx.equivalence.clone(), tx.preconditions.clone())
  var rationale_store = session.rationale_store.clone()
  rationale_store_add_all(&mut rationale_store, tx.rationale_records.clone())
  # The revised session (the caller applies it in-process; the serve loop
  # keeps its own session value).
  tx.new_session = Option::Some(CompilerSession {
    revision: new_revision,
    snapshot: finalized,
    index: new_index,
    target: session.target.clone(),
    final_env: Option::Some(env),
    final_typed: Option::Some(analyzed.typed.clone()),
    final_mir: Option::Some(mir.clone()),
    evidence: Option::Some(evidence),
    diagnostics_store: session.diagnostics_store.clone(),
    source: tx.edited_source.clone(),
    source_file: session.source_file.clone(),
    compile_options: session.compile_options.clone(),
    lineages: lineage_store,
    rationale_store: rationale_store
  })
  session_verified_transaction_seal(tx, policy)
end

# ———— The baseline-session constructor (the transaction's counterpart) ————
# Compile ONE source through the SAME pipeline the transaction runs
# (parse -> merge imports -> analyze -> lower -> verify -> effect/purity/
# budget annotations -> mono -> tail-ABI/SLP stamps -> optimize -> verify ->
# snapshot -> finalize) into a fresh CompilerSession whose source / lineages
# / rationale slots are the transaction inputs. This is the in-process
# baseline builder for verified-edit flows (and the lane's full-pipeline
# fixture); Result::Err is "<stage>: <first diagnostic>". No artifact is
# written (the driver route owns persistence).
pub def session_compile_source(
  source: String,
  source_file: String,
  target_desc: TargetDesc,
  compile_options: CompilerOptions = default_options(),
  lineages: DeclLineageStore = stable_lineage_store_new(),
  rationale_store: RationaleStore = rationale_store_new()
) -> Result[CompilerSession, String]
  var opts = compile_options.clone()
  let parsed = match parse_source_program(source.clone(), source_file.clone())
  when Result::Ok(p) then p
  when Result::Err(diags) then
    return Result::Err("parse: " + session_first_row(session_diag_rows(diags)))
  end
  let ast = match merge_imported_deps(parsed, false)
  when Result::Ok(a) then a
  when Result::Err(e) then return Result::Err("imports: " + e) end
  var env = type_env_new()
  let analyzed = match analyze_program(&mut env, &mut ast, opts.clone())
  when Result::Ok(a) then a
  when Result::Err(diags) then
    return Result::Err("analyze: " + session_first_row(session_diag_rows(diags)))
  end
  var mir = match driver_lower_to_mir(&ast, Option::Some(analyzed.typed.clone()))
  when Result::Ok(m) then m
  when Result::Err(e) then return Result::Err("lower: " + e) end
  let pre_errs = verify_mir(&mir)
  if pre_errs.len() > 0 then
    return Result::Err("verify-pre: " + session_first_row(pre_errs))
  end
  let effect_errs = check_effect_class_annotations_mir(&mir, env)
  if effect_errs.len() > 0 then
    return Result::Err("effects: " +
      session_first_row(session_diag_rows(type_errors_to_diags(&effect_errs))))
  end
  let purity_errs = check_purity_annotations_mir(&mut mir, env)
  if purity_errs.len() > 0 then
    return Result::Err("purity: " +
      session_first_row(session_diag_rows(type_errors_to_diags(&purity_errs))))
  end
  let budget_errs = check_budget_annotations_mir(&mir, env)
  if budget_errs.len() > 0 then
    return Result::Err("budget-annotations: " +
      session_first_row(session_diag_rows(type_errors_to_diags(&budget_errs))))
  end
  var mono_cache = mono_cache_new(&ast, &analyzed.resolutions)
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Ok(_) then ()
  when Result::Err(me) then
    return Result::Err("mono: " + me.len().to_string() + " error(s)")
  end
  stamp_tail_abi_plans(&mut mir, detect_host_target().arch)
  stamp_slp_vector_facility_desc(&mut mir, target_desc.clone())
  optimize_mir(&mut mir, opts.opt_level)
  let post_errs = verify_mir(&mir)
  if post_errs.len() > 0 then
    return Result::Err("verify-post: " + session_first_row(post_errs))
  end
  var lineage_store = lineages
  let snapshot_features = snapshot_feature_set_of(opts.clone(), target_desc.clone())
  let snapshot_options = snapshot_semantic_options_of(opts.clone(), target_desc.clone())
  let snapshot = match semantic_snapshot_of_final_state(
    &env, &analyzed.typed, &mir, &target_desc, VERSION, StableDigest { hi: 0, lo: 0 },
    &mut lineage_store, analyzed.drop_plan_facts.clone(), snapshot_features, snapshot_options)
  when Result::Ok(s) then s
  when Result::Err(e) then
    return Result::Err("snapshot: " + session_snapshot_error_text(e))
  end
  var finalized = snapshot
  semantic_snapshot_finalize(&mut finalized)
  let index = build_semantic_index(&finalized)
  # (audit order item 7) the REAL ABI-verify stage (same as the driver
  # route and the verified-edit transaction): post-lowering verification
  # of the finalized MIR on the host route.
  let abi_rows = session_abi_verify_rows(mir.clone(), target_desc.clone())
  for abi_row in abi_rows do
    eprintln(abi_row)
  end
  let evidence = verified_compilation_evidence_stages(
    semantic_digest_render(&finalized.revision),
    true, true, true, true, true, true, false, true, true, abi_rows.len() == 0, true,
    verification_stage_names_driver_route())
  Result::Ok(CompilerSession {
    revision: finalized.revision,
    snapshot: finalized,
    index: index,
    target: Option::Some(target_desc),
    final_env: Option::Some(env),
    final_typed: Option::Some(analyzed.typed.clone()),
    final_mir: Option::Some(mir.clone()),
    evidence: Option::Some(evidence),
    diagnostics_store: new_diagnostic_store(),
    source: source,
    source_file: source_file,
    compile_options: compile_options,
    lineages: lineage_store,
    rationale_store: rationale_store
  })
end

# ———— The transaction lane (self-checking rows) ————
# Executable rows for every surface that does NOT need a full pipeline run:
# the authoritative projection over hand-built typed deltas, the exact
# unexpected-row rejection, the empty no-op delta, the offline /
# frontend-only transaction levels, the level-gated proof refusal and the
# canonical render + proof hash. The end-to-end VerifiedFull path is
# driven separately by the test suite through session_compile_source.

def session_lane_target() -> StableTargetId
  StableTargetId {
    triple: "p0-15-lane".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 8,
    endian: "little".to_string(),
    abi: "lp64".to_string(),
    float_abi: "soft".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def session_name_part(key: String) -> String
  let hash = key.index_of("#")
  if hash >= 0 then key.slice(0, hash) else key.clone() end
end

def session_lane_has(rows: Vec[String], needle: String) -> Bool
  for row in rows do
    if row == needle then return true end
  end
  false
end

def session_lane_push(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

pub def semantic_verified_edit_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— V-fixture: one symbol f#fn()->Int ————
  let k_f = "f#fn()->Int".to_string()
  var snapshot = semantic_snapshot_new("p0-15-lane".to_string(), session_lane_target())
  snapshot.symbols = Vec::from([SemanticSymbol {
    stable_id: stable_def_id_digested(k_f.clone(), session_name_part(&k_f)),
    kind: DefKind::Function,
    name: "f".to_string(),
    module_path: "".to_string(),
    is_pub: false,
    is_generic: false
  }])
  let index = build_semantic_index(&snapshot)
  let resolved = match resolve_edit(&index, &snapshot,
    SemanticEdit::ChangeSignature(k_f.clone(), "fn(x:i64)->Int".to_string()))
  when Result::Ok(r) then r
  when Result::Err(e) then
    out.push("v-resolve: expected Ok, got " + edit_error_word(e))
    return out
  end

  # ———— V1: the authoritative delta touching ANOTHER function's effect
  # (the allocation class bit) and ABI rows is rejected with the EXACT
  # unexpected rows — snapshot-only families included. ————
  var delta = semantic_delta_empty()
  delta.effect_delta = Vec::from([EffectDelta {
    function: "g#fn()->Int".to_string(),
    before: EffectSummaryView { bits: 0 },
    after: EffectSummaryView { bits: 1 }
  }])
  delta.abi_delta = AbiDeltaView {
    surface_id: "abi".to_string(),
    before: AbiSurfaceView { rows: Vec::from(["symbol=h#fn()->Int;size=8".to_string()]) },
    after: AbiSurfaceView { rows: Vec::new() }
  }
  let actual = edit_authoritative_delta_rows(delta.clone())
  let cmp = edit_compare_actual_plan(resolved.clone(), actual.clone())
  session_lane_push(&mut out, "v1-effect-rows",
    session_bool_text(session_lane_has(actual.clone(), "effect-changed:g".to_string())), "true")
  session_lane_push(&mut out, "v1-abi-rows",
    session_bool_text(session_lane_has(actual.clone(), "abi-changed:h".to_string())), "true")
  session_lane_push(&mut out, "v1-unexpected",
    cmp.unexpected.join(","), "abi-changed:h,effect-changed:g")
  session_lane_push(&mut out, "v1-matched", session_bool_text(cmp.matched), "false")
  session_lane_push(&mut out, "v1-unmatched",
    session_bool_text(session_lane_has(cmp.unmatched.clone(), "entity-modified:f#fn()->Int".to_string())),
    "true")

  # ———— V2: the equivalent-edit no-op: an empty delta projects no rows and
  # agrees with an empty plan (the Complete-status no-op case). ————
  let empty_rows = edit_authoritative_delta_rows(semantic_delta_empty())
  session_lane_push(&mut out, "v2-empty-rows", empty_rows.len().to_string(), "0")
  let empty_plan = ResolvedEdit {
    edit: SemanticEdit::Rename(k_f.clone(), "f".to_string())
  }
  let empty_cmp = edit_compare_actual_plan(empty_plan, Vec::new())
  session_lane_push(&mut out, "v2-empty-agrees", session_bool_text(empty_cmp.matched), "true")

  # ———— V3: the no-source session: ProvisionalFrontEnd, no proof. ————
  let no_source = new_compiler_session(snapshot.clone())
  let tx3 = session_apply_verified_edit(no_source.clone(), SemanticEdit::Rename(k_f.clone(), "f2".to_string()),
    ChangeBudget {})
  session_lane_push(&mut out, "v3-level",
    verification_level_word(tx3.level.clone()), "provisional-front-end")
  session_lane_push(&mut out, "v3-blocked", session_bool_text(tx3.blocked), "true")
  session_lane_push(&mut out, "v3-accepted", session_bool_text(tx3.accepted), "false")
  session_lane_push(&mut out, "v3-refusal-prefix",
    session_bool_text(tx3.refusal.starts_with("source-unavailable".to_string())), "true")
  session_lane_push(&mut out, "v3-no-patch", session_bool_text(tx3.proof_patch.is_none()), "true")
  session_lane_push(&mut out, "v3-no-verified-proof", session_bool_text(tx3.verified_proof.is_none()), "true")
  match tx3.actual_delta_status.clone()
  when DeltaStatus::Unavailable(_) then ()
  when DeltaStatus::Complete(_) then out.push("v3-delta-status: expected Unavailable")
  end

  # ———— V4: the source-applying session with no TargetDesc:
  # VerifiedFrontend (front-end chain verified), still no proof; a policy
  # admitting the front end accepts it. ————
  var frontend_session = new_compiler_session(snapshot.clone())
  frontend_session.source = "def f() -> Int\n  1\nend\n".to_string()
  frontend_session.source_file = "lane.tg".to_string()
  let tx4 = session_apply_verified_edit(frontend_session.clone(),
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()), ChangeBudget {},
    VerificationPolicy { minimum_level: VerificationLevel::VerifiedFrontend })
  session_lane_push(&mut out, "v4-level",
    verification_level_word(tx4.level.clone()), "verified-frontend")
  session_lane_push(&mut out, "v4-applied", session_bool_text(tx4.applied), "true")
  session_lane_push(&mut out, "v4-accepted-frontend-policy", session_bool_text(tx4.accepted), "true")
  session_lane_push(&mut out, "v4-no-patch", session_bool_text(tx4.proof_patch.is_none()), "true")
  session_lane_push(&mut out, "v4-no-verified-proof", session_bool_text(tx4.verified_proof.is_none()), "true")
  session_lane_push(&mut out, "v4-full-unavailable",
    session_bool_text(tx4.refusal.starts_with("full-pipeline-unavailable".to_string())), "true")
  session_lane_push(&mut out, "v4-rewrite",
    session_bool_text(tx4.edited_source.contains("def f2()".to_string())), "true")

  # ———— V5: the rationale extension records the edit / delta / budget. ————
  let edit_record_set = session_edit_rationale_records(
    "rev-lane".to_string(), tx4.edit.clone(), resolved.clone(), delta.clone(),
    resolved.expected_delta.clone(), actual.clone(), Vec::from(["budget:lane".to_string()]),
    Option::None, resolved.preconditions.clone())
  session_lane_push(&mut out, "v5-rationale-count", edit_record_set.len().to_string(), "3")
  if edit_record_set.len() >= 3 then
    session_lane_push(&mut out, "v5-rationale-edit-decision",
      edit_record_set[0].decision.clone(), "apply-verified-edit")
    session_lane_push(&mut out, "v5-rationale-delta-kind",
      edit_record_set[1].decision.clone(), "delta-summary")
  end

  # ———— V6: the canonical render + proof hash are deterministic, and a
  # sub-Full transaction renders "proof: unavailable". ————
  let render_a = verified_edit_transaction_render(&tx3)
  let render_b = verified_edit_transaction_render(&tx3.clone())
  session_lane_push(&mut out, "v6-render-deterministic",
    session_bool_text(render_a == render_b), "true")
  session_lane_push(&mut out, "v6-render-proof-unavailable",
    session_bool_text(render_a.contains("proof: unavailable".to_string())), "true")
  let tx3_again = session_apply_verified_edit(no_source,
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()), ChangeBudget {})
  session_lane_push(&mut out, "v6-hash-deterministic",
    session_bool_text(tx3.proof_hash.hi == tx3_again.proof_hash.hi &&
      tx3.proof_hash.lo == tx3_again.proof_hash.lo), "true")
  session_lane_push(&mut out, "v6-hash-nonzero",
    session_bool_text(tx3.proof_hash.hi != 0 || tx3.proof_hash.lo != 0), "true")

  out
end

# ———— The §39 operation surface (typed request/response) ————
# `edit.apply_verified` is the registry op: its payload is the edit kind +
# the kind's fields (the same grammar edit.apply uses), optionally followed
# by "policy:<min-level-word>|<require-delta>|<require-budget>" and zero or
# more "allow:<stable key>" rows (the ChangeBudget allowed_symbols
# allowance). The answer kind is "edit.verified" when the transaction was
# accepted, "edit.verified_rejected" otherwise; keys = the transaction's
# canonical render rows (revision digs, level, delta agreement, budget,
# rationale and proof hash included) — never a proof patch when the level
# is below VerifiedFull.
pub struct EditVerifiedRequest
  edit: SemanticEdit
  budget: ChangeBudget
  policy: VerificationPolicy = VerificationPolicy {}
end

pub struct EditVerifiedResponse
  level: String = ""
  old_revision: String = ""
  new_revision: String = ""
  accepted: Bool = false
  delta_agreement: Bool = false
  proof_hash: String = ""
  refusal: String = ""
  rows: Vec[String] = Vec::new()
end

pub def session_edit_verified_response(tx: VerifiedEditTransaction) -> EditVerifiedResponse
  EditVerifiedResponse {
    level: verification_level_word(tx.level.clone()),
    old_revision: tx.old_revision.clone(),
    new_revision: tx.new_revision.clone(),
    accepted: tx.accepted,
    delta_agreement: tx.delta_agreement,
    proof_hash: semantic_digest_render(&tx.proof_hash),
    refusal: tx.refusal.clone(),
    rows: verified_edit_transaction_rows(tx.clone())
  }
end

def session_edit_verified_request(payload: String) -> Result[EditVerifiedRequest, String]
  let lines = payload.lines()
  if lines.len() == 0 then
    return Result::Err("empty-payload")
  end
  let kind_word = lines[0].clone()
  var header_lines = 0
  var edit: Option[SemanticEdit] = Option::None
  match kind_word
  when "rename" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = Option::Some(SemanticEdit::Rename(lines[1].clone(), lines[2].clone()))
    end
  when "change-signature" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = Option::Some(SemanticEdit::ChangeSignature(lines[1].clone(), lines[2].clone()))
    end
  when "replace-call" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = Option::Some(SemanticEdit::ReplaceCall(lines[1].clone(), lines[2].clone()))
    end
  when "insert-statement" then
    header_lines = 4
    if lines.len() >= 4 then
      edit = Option::Some(SemanticEdit::InsertStatement(lines[1].clone(), lines[2].clone(),
        lines[3].clone()))
    end
  when _ then ()
  end
  match edit
  when Option::None then
    Result::Err("unsupported-edit:" + kind_word)
  when Option::Some(e) then
    var budget = ChangeBudget {}
    var policy = VerificationPolicy {}
    var allowed: Set[StableDeclId] = Set::new()
    var i = header_lines
    while i < lines.len() do
      let line = lines[i].clone()
      if line.starts_with("policy:") then
        let body = line.slice(7, line.len())
        let parts = body.split("|")
        if parts.len() >= 1 then
          match verification_level_of_word(parts[0].clone())
          when Option::Some(l) then policy.minimum_level = l
          when Option::None then ()
          end
        end
        if parts.len() >= 2 then
          policy.require_delta_agreement = parts[1] == "true"
        end
        if parts.len() >= 3 then
          policy.require_budget = parts[2] == "true"
        end
      elsif line.starts_with("allow:") then
        allowed.insert(stable_decl_of_key(line.slice(6, line.len())))
      end
      i = i + 1
    end
    budget.allowed_symbols = allowed
    Result::Ok(EditVerifiedRequest {
      edit: e,
      budget: budget,
      policy: policy
    })
  end
end

pub def session_edit_verified_results(session: CompilerSession, payload: String) -> QueryResults
  let request = match session_edit_verified_request(payload)
  when Result::Ok(r) then r
  when Result::Err(e) then
    return QueryResults {
      kind: "edit.verified_unsupported",
      keys: Vec::from([e])
    }
  end
  let tx = session_apply_verified_edit(&session, request.edit.clone(),
    request.budget.clone(), request.policy.clone())
  let response = session_edit_verified_response(tx)
  let answer_kind = if response.accepted then
    "edit.verified".to_string()
  else
    "edit.verified_rejected".to_string()
  end
  QueryResults {
    kind: answer_kind,
    keys: response.rows.clone()
  }
end

# ———————————————————————————————————————————————————————————————
# Request routing — the §38 session ops + the §39 service op
# ———————————————————————————————————————————————————————————————
# The op table is DECLARED by the §39 operation registry below; every
# registered family delegates to a §38 typed accessor (or, for the mir
# family, to the §33/§22 engines with the session's finalized program);
# "revision" is the one §39 service op. The mir family is the ONE family
# that deviates from §38's session-scoped query() in a documented way:
# this session carries the PIPELINE's finalized state, so the
# mir_slice arm hands semantic_query.mir_slice the session's final_mir
# (compiler_session_from_finalized's verified MirProgram — Option::None
# on the offline-artifact session forms, whose arm then answers
# "mir_slice_unavailable" exactly like §38's query()); with a program
# present the adapter routes the §33 typed engine and surfaces the typed
# MirSlice answer (see semantic_query.tg's mir_slice doc for the request
# grammar and the kind/payload mapping). The MIR GRAPH ops (third-audit
# item 20/22: mir.dominators / mir.postdominators / mir.loops /
# mir.control / mir.path / mir.reaching / mir.diff / mir.block) route the
# same way:
# semantic_query.mir_graph_query receives the session's final_mir and
# answers "<op>" rows or, without a program (the offline-artifact session
# forms), "<op>_unavailable" — documented in that module's mir_graph_query
# slot.
# The EXPLAIN arms (audit item 52) and the diagnostic.* ops route through
# the §38 facade family: ONE facade built on demand from the session's
# snapshot + index + retained store + evidence, then query() (the
# arm-level cost of one explain query; documented).
# The "revision" service answer (the digest render — the client's
# freshness probe). No §23 payload family is enumerated for the service
# op's digest row (semantic_model.tg's mapping table), so payload stays
# None and kind + keys are the whole answer.
def session_revision_results(session: CompilerSession) -> QueryResults
  var keys: Vec[String] = Vec::new()
  keys.push(semantic_digest_render(&session.revision))
  QueryResults { kind: "revision", keys: keys }
end

# ———————————————————————————————————————————————————————————————
# (audit order item 6) replay.compare — the session decode/compare op
# ———————————————————————————————————————————————————————————————
# The session-owned decode/compare entry over two self-describing run
# artifacts (the compiled executables' --replay dumps). Each artifact
# carries its embedded event dictionary, which maps the compact runtime
# tokens to exact stable ids (StableMirNodeId call-site keys + the
# containing declaration keys + the semantic operation word); the compare
# rebuilds the replay.tg EventTraces, walks the first divergence and
# materializes its minimal causal slice. Any decode failure, dictionary
# mismatch, raw token or origin-less entry is the documented untracked
# result — never a fabricated divergence or slice (replay_bridge.tg
# documents the artifact grammar and the untracked reasons).
pub def session_replay_run_compare(session: CompilerSession, run_a: Vec[u8], run_b: Vec[u8]) -> ReplayComparison
  replay_run_compare(run_a, run_b)
end

struct ReplayComparePayload
  run_a: Vec[u8] = Vec::new()
  run_b: Vec[u8] = Vec::new()
end

def server_replay_compare_error(reason: String) -> QueryResults
  QueryResults { kind: "replay.compare_error", keys: Vec::from(["reason=" + reason]) }
end

# Parse the replay.compare payload: two lines, "a:<hex>" and "b:<hex>"
# (the lowercase-hex render of the run artifacts; either order accepted,
# both required). A malformed payload / hex failure answers
# replay.compare_error — never a silent empty comparison.
def server_replay_compare_payload(arg: String) -> Result[ReplayComparePayload, String]
  let lines = arg.lines()
  var a_text = ""
  var b_text = ""
  var have_a = false
  var have_b = false
  for line in lines do
    if line.starts_with("a:") then
      a_text = line.slice(2, line.len())
      have_a = true
    elsif line.starts_with("b:") then
      b_text = line.slice(2, line.len())
      have_b = true
    end
  end
  if !have_a || !have_b then
    return Result::Err("expected two lines `a:<hex>` and `b:<hex>`".to_string())
  end
  let a = match replay_hex_decode(a_text)
  when Result::Err(e) then return Result::Err("run-a:" + e)
  when Result::Ok(v) then v
  end
  let b = match replay_hex_decode(b_text)
  when Result::Err(e) then return Result::Err("run-b:" + e)
  when Result::Ok(v) then v
  end
  Result::Ok(ReplayComparePayload { run_a: a, run_b: b })
end

# The replay.compare answer: the session revision row (context
# attribution) followed by replay_bridge.tg's canonical comparison rows.
# kind "replay.compare" for a compared pair, "replay.compare_untracked"
# for the documented untracked result, "replay.compare_error" for a
# malformed payload.
pub def session_replay_compare_results(session: CompilerSession, arg: String) -> QueryResults
  match server_replay_compare_payload(arg.clone())
  when Result::Err(e) then server_replay_compare_error(e)
  when Result::Ok(payload) then
    let cmp = session_replay_run_compare(session, payload.run_a.clone(), payload.run_b.clone())
    var rows: Vec[String] = Vec::new()
    rows.push("revision=" + semantic_digest_render(&session.revision))
    for row in replay_comparison_rows(cmp.clone()) do
      rows.push(row)
    end
    if replay_comparison_is_untracked(cmp.clone()) then
      QueryResults { kind: "replay.compare_untracked", keys: rows }
    else
      QueryResults { kind: "replay.compare", keys: rows }
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The §39 operation registry (third-audit item 23)
# ———————————————————————————————————————————————————————————————
# ONE declared table of every op the service serves: name + the handler
# family word (the routing class: index / mir / explain / snapshot /
# diagnostic / type / ownership / contract / symbol / plan / replay /
# service).
# server_operations is the DECLARED AUTHORITY of the dispatch:
# session_query_results resolves the name FIRST and answers kind
# "unknown" for an unregistered name, then routes by the resolved
# handler_kind. The new item-23 families (type / ownership / contract /
# symbol / snapshot / plan / diagnostic / replay) route through the §38
# facade — query() built on demand with the session's retained store +
# evidence — so the §38 and §39 answers can never diverge; the residual
# families keep their server-only route because they consume pipeline
# state the facade does not carry: mir / mir.* (the session's final_mir)
# and service (the revision digest render). The existing §38-owned
# families (index / explain) already route through the same facade path
# every new family uses, so this registry plus the single facade route is
# the whole convergence step; a later pass only needs to fold the residual
# mir/service handlers into ServerOperation rows with their own family
# words, leaving this resolver and route unchanged.
pub struct ServerOperation
  name: String
  handler_kind: String
end

def server_operation(name: String, handler_kind: String) -> ServerOperation
  ServerOperation { name: name, handler_kind: handler_kind }
end

pub def server_operations() -> Vec[ServerOperation]
  Vec::from([
    server_operation("callers".to_string(), "index".to_string()),
    server_operation("callees".to_string(), "index".to_string()),
    server_operation("types".to_string(), "index".to_string()),
    server_operation("effects".to_string(), "index".to_string()),
    server_operation("capabilities".to_string(), "index".to_string()),
    server_operation("purity.get".to_string(), "index".to_string()),
    server_operation("contracts".to_string(), "index".to_string()),
    server_operation("fields".to_string(), "index".to_string()),
    server_operation("impls".to_string(), "index".to_string()),
    server_operation("properties".to_string(), "index".to_string()),
    server_operation("mir_function".to_string(), "index".to_string()),
    server_operation("symbol_get".to_string(), "index".to_string()),
    server_operation("symbol_search".to_string(), "index".to_string()),
    server_operation("contract_list".to_string(), "index".to_string()),
    server_operation("type_explain".to_string(), "index".to_string()),
    server_operation("ownership_explain".to_string(), "index".to_string()),
    server_operation("mir_slice".to_string(), "mir".to_string()),
    server_operation("mir.dominators".to_string(), "mir".to_string()),
    server_operation("mir.postdominators".to_string(), "mir".to_string()),
    server_operation("mir.loops".to_string(), "mir".to_string()),
    server_operation("mir.control".to_string(), "mir".to_string()),
    server_operation("mir.path".to_string(), "mir".to_string()),
    server_operation("mir.reaching".to_string(), "mir".to_string()),
    server_operation("mir.diff".to_string(), "mir".to_string()),
    # (the tool-discovery sweep's registry gap) mir.block is dispatched by
    # §38 semantic_query.query() beside the seven graph ops above; the
    # registered "mir" family routes it to the same session final_mir
    # engine (mir_graph_query) as its siblings.
    server_operation("mir.block".to_string(), "mir".to_string()),
    server_operation("type.explain".to_string(), "explain".to_string()),
    server_operation("trait.resolve".to_string(), "explain".to_string()),
    server_operation("trait.explain".to_string(), "explain".to_string()),
    server_operation("ownership.explain".to_string(), "explain".to_string()),
    server_operation("effect.explain".to_string(), "explain".to_string()),
    server_operation("capability.explain".to_string(), "explain".to_string()),
    server_operation("layout.explain".to_string(), "explain".to_string()),
    server_operation("optimization.explain".to_string(), "explain".to_string()),
    server_operation("diagnostic.explain".to_string(), "explain".to_string()),
    server_operation("type.get".to_string(), "type".to_string()),
    server_operation("type.layout".to_string(), "type".to_string()),
    server_operation("type.properties".to_string(), "type".to_string()),
    server_operation("ownership.moves".to_string(), "ownership".to_string()),
    server_operation("ownership.drop_plan".to_string(), "ownership".to_string()),
    server_operation("contract.obligations".to_string(), "contract".to_string()),
    server_operation("contract.verify".to_string(), "contract".to_string()),
    server_operation("symbol.references".to_string(), "symbol".to_string()),
    # (third-audit item 34) the §40 coverage ops — routed through the §38
    # facade like the other index-family ops (test.affected /
    # coverage.affected answer from the session snapshot's ingested
    # coverage rows; "<op>_unavailable" without them).
    server_operation("test.affected".to_string(), "index".to_string()),
    server_operation("coverage.affected".to_string(), "index".to_string()),
    server_operation("snapshot.get".to_string(), "snapshot".to_string()),
    server_operation("snapshot.diff".to_string(), "snapshot".to_string()),
    # (third-audit item 30) the source-edit application op: source-in /
    # edited-source-out through the semantic edit engine (§38 edit.apply).
    server_operation("edit.apply".to_string(), "edit".to_string()),
    # (audit order P0-15) the VERIFIED-EDIT TRANSACTION op: the session's
    # source in, the full recompile + authoritative snapshot delta + budget
    # + level-gated proof out (session_apply_verified_edit; the payload
    # grammar and the answer kinds are on session_edit_verified_results).
    server_operation("edit.apply_verified".to_string(), "edit-verified".to_string()),
    server_operation("build.plan".to_string(), "plan".to_string()),
    server_operation("verify.plan".to_string(), "plan".to_string()),
    server_operation("diagnostic.get".to_string(), "diagnostic".to_string()),
    server_operation("diagnostic.repair_context".to_string(), "diagnostic".to_string()),
    # (repair-candidates-as-semantic-operations closure) the durable repair
    # ops: typed candidates over the retained diagnostic store and the
    # candidate -> SemanticEdit instantiation.
    server_operation("repair.candidates".to_string(), "repair".to_string()),
    server_operation("repair.instantiate".to_string(), "repair".to_string()),
    server_operation("replay.trace_rows".to_string(), "replay".to_string()),
    server_operation("replay.digest".to_string(), "replay".to_string()),
    server_operation("replay.writes_to".to_string(), "replay".to_string()),
    server_operation("replay.value_at".to_string(), "replay".to_string()),
    server_operation("replay.causal_predecessors".to_string(), "replay".to_string()),
    server_operation("replay.first_divergence".to_string(), "replay".to_string()),
    server_operation("replay.minimal_causal_slice".to_string(), "replay".to_string()),
    # (P1-9) the typed record/run/compare entries: replay.record builds a
    # trace from supplied typed choices, replay.run extracts the
    # deterministic choice stream, replay.diff is the semantic-only
    # first-divergence compare (semantic_query.tg's module-scope
    # replay_query serves callers that hold a trace; a §38 session
    # carries none).
    server_operation("replay.record".to_string(), "replay".to_string()),
    server_operation("replay.run".to_string(), "replay".to_string()),
    server_operation("replay.diff".to_string(), "replay".to_string()),
    server_operation("revision".to_string(), "service".to_string()),
    # (audit item 4) service.describe — the BOOTSTRAP op: one call returns
    # the full typed schema list of every registered operation (itself
    # included), so an external client discovers the whole protocol without
    # prior vocabulary. APPENDED at the end: the registry position is the v2
    # dense operation id, so appending keeps every existing dense id stable.
    server_operation("service.describe".to_string(), "service".to_string()),
    # (audit order item 6) THE PRODUCTION-BRIDGE COMPARE op: the two
    # compiled executables' --replay run artifacts (hex-encoded in the
    # payload) in, the first divergence + minimal causal slice out. It is
    # session-owned (the session attributes the comparison to its served
    # revision) and its handler family is its own ("replay-compare"), so
    # the trace-holding §38 facade route stays untouched. APPENDED after
    # service.describe so every existing dense operation id stays stable.
    server_operation("replay.compare".to_string(), "replay-compare".to_string())
  ])
end

pub def server_operation_resolve(name: String) -> Option[ServerOperation]
  for op in server_operations() do
    if op.name == name then
      return Option::Some(op)
    end
  end
  Option::None
end

pub def server_op_known(name: String) -> Bool
  match server_operation_resolve(&name)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# The registry's general route: the §38 facade of the session (snapshot +
# index + the retained diagnostic store + evidence) → query(). This is
# the arm every non-residual registered family uses — the index/explain
# families included, so diagnostic.explain answers the STORE-aware arm
# and the §38 and §39 answers can never diverge.
def session_facade_results(session: CompilerSession, operation: String, arg: String) -> QueryResults
  let facade = session_query(&session)
  query(&facade, operation, arg)
end

def session_query_results(session: CompilerSession, operation: String, arg: String) -> QueryResults
  match server_operation_resolve(&operation)
  when Option::None then QueryResults { kind: "unknown", keys: Vec::new() }
  when Option::Some(op) then
    # The resolved handler family word drives the route — the registry is
    # the authority, not the name text.
    match op.handler_kind
    # ———— the residual server-only families ————
    # These consume pipeline state the §38 facade does not carry (the
    # session's final_mir / the service revision).
    when "mir" then
      if operation == "mir_slice" then
        mir_slice(arg.clone(), &session.final_mir)
      else
        mir_graph_query(operation.clone(), arg.clone(), &session.final_mir)
      end
    when "service" then
      # (audit item 4a) the two service ops: service.describe is the
      # bootstrap schema list; revision is the freshness probe.
      if operation == "service.describe" then
        session_describe_results()
      else
        session_revision_results(&session)
      end
    # (audit order P0-15) the verified-edit transaction route. It consumes
    # the session's OWN source + lineage/rationale stores (the §38 facade
    # carries none of them), so it is a server-only family like mir /
    # service. The op never mutates the served session value; an in-process
    # caller applies the transaction's new_session.
    when "edit-verified" then session_edit_verified_results(&session, arg.clone())
    # (audit order item 6) the production-bridge replay compare: the two
    # run artifacts ride the payload (hex), the session owns the decode +
    # comparison and the revision attribution.
    when "replay-compare" then session_replay_compare_results(&session, arg.clone())
    # ———— every other registered family: the §38 facade ————
    # index / explain / type / ownership / contract / symbol / snapshot /
    # plan / diagnostic / replay all answer through query() over the
    # session's retained store + evidence, so §38 and §39 can never
    # diverge.
    when _ then session_facade_results(&session, operation.clone(), arg.clone())
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The dispatch → typed wire record mapping (third-audit item 22)
# ———————————————————————————————————————————————————————————————
# The MECHANICAL wrapper over the §38 QueryResults rows: one branch per
# served operation, building the family record from the answer's canonical
# rows and the request arg (the identity field the rows do not repeat —
# callers.target, effects.function, ...). Option::None for every op with
# no record family and for the *_unavailable answers (an empty row set is
# never a fabricated record). The response constructor then serializes
# the record through its family's ONE renderer, so the wire rows ARE the
# record's canonical render.

def server_wire_first_row(rows: Vec[String]) -> String
  if rows.len() == 0 then
    return "".to_string()
  end
  rows[0].clone()
end

# The §32 effect row splitter mirror ("<dirty-word>;<cap-id>;..." — the
# same grammar semantic_query.tg's query_effects consumes): bits = the
# first segment parsed as an Int (0 on a non-numeric word), caps = the
# non-empty segments after the first.
def server_wire_effect_row_split(row: String) -> (Int, Vec[String])
  var bits = 0
  var caps: Vec[String] = Vec::new()
  var segment = 0
  var start = 0
  var i = 0
  while i <= row.len() do
    let is_separator = if i == row.len() then true else row.slice(i, i + 1) == ";" end
    if is_separator then
      let text = row.slice(start, i)
      if segment == 0 then
        match text.parse_int()
        when Result::Ok(n) then bits = n
        when Result::Err(_) then bits = 0
        end
      elsif text.len() > 0 then
        caps.push(text.clone())
      end
      segment = segment + 1
      start = i + 1
    end
    i = i + 1
  end
  (bits, caps)
end

def server_wire_effect_parts(rows: Vec[String]) -> (Int, Vec[String])
  if rows.len() == 0 then
    return (0, Vec::new())
  end
  server_wire_effect_row_split(rows[0].clone())
end

# The code component of a stable diagnostic id render
# ("owner|diagnostic|code|cause|...|#ordinal"): "" when the id text does
# not carry one.
def server_wire_diagnostic_code_of_id(id_text: String) -> String
  let parts = id_text.split("|")
  if parts.len() >= 3 then
    parts[2].clone()
  else
    "".to_string()
  end
end

# (fourth-audit P0-12) The contract kind word of one ContractFact kind
# (the same "Pre" / "Post" / "Invariant" render the §29/§31 row keys and the
# index row form use — one vocabulary, mirrored locally so the server never
# imports the query module's private renderer).
def server_contract_kind_text(kind: AstContractKind) -> String
  match kind
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The typed ContractResponse of ONE ContractFact built DIRECTLY from the
# record: id (the stable clause key), kind, canonical expression,
# fingerprint and message ride as DISTINCT fields. The message Option::None
# (no declared message) renders "". No row text is ever split — the
# canonical expression may contain '|' (P0-12).
pub def contract_response_of_fact(fact: ContractFact) -> ContractResponse
  let message = match fact.message.clone()
  when Option::Some(text) then text.clone()
  when Option::None then "".to_string()
  end
  ContractResponse {
    contract_id: fact.id.stable_key.clone(),
    kind: server_contract_kind_text(fact.kind.clone()),
    canonical_expression: semantic_contract_expr_text(&fact.canonical_expression),
    fingerprint: semantic_digest_render(&fact.expression_fingerprint),
    message: message
  }
end

# The ContractFact a single-clause contract answer row names, located in
# the session snapshot BY IDENTITY: the row must equal the fact's stable
# clause key ("<fn>|<kind>|<canonical>") or the index row form
# ("<kind>|<canonical>"), both DERIVED from the fact and compared — the
# answer row is never split into components. Option::None on a multi-row /
# unmatched answer (the record family is ONE clause; a row list keeps its
# §38 rows).
def server_wire_contract_fact(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[ContractFact]
  if rows.len() != 1 then
    return Option::None
  end
  var found: Option[ContractFact] = Option::None
  for contract in snapshot.contracts do
    let row_key = contract.id.stable_key.clone()
    let index_row = server_contract_kind_text(contract.kind.clone()) + "|" +
      semantic_contract_expr_text(&contract.canonical_expression)
    if rows[0] == row_key || rows[0] == index_row then
      found = Option::Some(contract.clone())
      break
    end
  end
  found
end

# The single-clause contract answer as the typed record, built from the
# underlying ContractFact (P0-12: never a split of the canonical clause
# text). Option::None when no fact in the snapshot owns the single row.
def server_wire_contract_of_row(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[ContractResponse]
  match server_wire_contract_fact(&snapshot, rows)
  when Option::Some(fact) then Option::Some(contract_response_of_fact(fact))
  when Option::None then Option::None
  end
end

# The typed-wire form of the single-clause contract helper (the enum wrap
# the dispatch mapping returns).
def server_wire_contract_payload(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[SemanticWirePayload]
  match server_wire_contract_of_row(&snapshot, rows)
  when Option::Some(record) then Option::Some(SemanticWirePayload::Contract(record))
  when Option::None then Option::None
  end
end

pub def semantic_wire_payload_of_results(
  operation: String, arg: String, results: QueryResults, snapshot: SemanticSnapshot
) -> Option[SemanticWirePayload]
  let rows = results.keys.clone()
  match operation
  when "callers" then
    Option::Some(SemanticWirePayload::Callers(CallersResponse {
      target: arg.clone(),
      callers: rows.clone()
    }))
  when "callees" then
    Option::Some(SemanticWirePayload::Callees(CalleesResponse {
      function: arg.clone(),
      callees: rows.clone()
    }))
  when "symbol_get" then
    Option::Some(SemanticWirePayload::Symbols(SymbolsResponse {
      query: arg.clone(),
      symbols: rows.clone()
    }))
  when "symbol_search" then
    Option::Some(SemanticWirePayload::Symbols(SymbolsResponse {
      query: arg.clone(),
      symbols: rows.clone()
    }))
  when "types" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: server_wire_first_row(rows.clone()),
      size: 0,
      alignment: 0,
      fields: Vec::new()
    }))
  when "type.get" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: server_wire_first_row(rows.clone()),
      size: 0,
      alignment: 0,
      fields: Vec::new()
    }))
  when "fields" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: "".to_string(),
      size: 0,
      alignment: 0,
      fields: rows.clone()
    }))
  when "effects" then
    let parts = server_wire_effect_parts(rows.clone())
    Option::Some(SemanticWirePayload::Effects(EffectsResponse {
      function: arg.clone(),
      bits: parts.0,
      capabilities: parts.1.clone(),
      purity: "".to_string()
    }))
  when "capabilities" then
    Option::Some(SemanticWirePayload::Effects(EffectsResponse {
      function: arg.clone(),
      bits: 0,
      capabilities: rows.clone(),
      purity: "".to_string()
    }))
  when "ownership_explain" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "ownership.moves" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "ownership.drop_plan" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "mir_function" then
    Option::Some(SemanticWirePayload::MirFunction(MirFunctionResponse {
      function: arg.clone(),
      summary: server_wire_first_row(rows.clone())
    }))
  when "abi_inspect" then
    Option::Some(SemanticWirePayload::Abi(AbiResponse {
      surface_id: arg.clone(),
      rows: rows.clone()
    }))
  when "contracts" then server_wire_contract_payload(&snapshot, rows.clone())
  when "contract_list" then server_wire_contract_payload(&snapshot, rows.clone())
  when "contract.obligations" then server_wire_contract_payload(&snapshot, rows.clone())
  when "diagnostic.get" then
    if results.kind != "diagnostic.get" then
      Option::None
    else
      var diagnostic_id = ""
      var message = ""
      var related: Vec[String] = Vec::new()
      for row in rows.clone() do
        match server_wire_split_row(row.clone())
        when Option::Some(parts) then
          if parts.0 == "id" then
            diagnostic_id = parts.1.clone()
          elsif parts.0 == "message" then
            message = parts.1.clone()
          elsif parts.0 == "related" then
            related.push(parts.1.clone())
          end
        when Option::None then ()
        end
      end
      if diagnostic_id.len() == 0 then
        Option::None
      else
        Option::Some(SemanticWirePayload::Diagnostic(DiagnosticResponse {
          diagnostic_id: diagnostic_id.clone(),
          code: server_wire_diagnostic_code_of_id(diagnostic_id.clone()),
          message: message,
          related: related
        }))
      end
    end
  when "snapshot.diff" then
    if results.kind == "snapshot.diff" then
      Option::Some(SemanticWirePayload::Delta(DeltaResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when "semantic_diff" then
    Option::Some(SemanticWirePayload::Delta(DeltaResponse { rows: rows.clone() }))
  when "build.plan" then
    if results.kind == "build.plan" then
      Option::Some(SemanticWirePayload::Plan(PlanResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when "verify.plan" then
    if results.kind == "verify.plan" then
      Option::Some(SemanticWirePayload::Plan(PlanResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when _ then Option::None
  end
end

# Route one §38 result into the response: kind + keys ride the wire
# protocol; the typed payload (audit item 23) rides the response record
# (the in-process channel — the framing in semantic_response_frame never
# serializes it; a parse always yields None there). (Third-audit item 22)
# the typed WIRE record is built mechanically from the §38 rows and its
# canonical render becomes the keys field — the wire rows are the record's
# canonical render, never a second field. (Fourth-audit P0-12) the contract
# arm needs the session snapshot to locate the ContractFact the single-row
# answer belongs to.
def session_results_response(session: CompilerSession, req: SemanticRequest, results: QueryResults) -> SemanticResponse
  let payload = match results.payload
  when Option::Some(p) then Option::Some(p.clone())
  when Option::None then Option::None
  end
  let wire_payload = semantic_wire_payload_of_results(
    req.operation.clone(), req.payload.clone(), &results, &session.snapshot)
  let keys = match wire_payload.clone()
  when Option::Some(p) then semantic_wire_payload_render(p)
  when Option::None then results.keys.clone()
  end
  SemanticResponse {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: req.request_id,
    ok: true,
    kind: results.kind.clone(),
    keys: keys,
    payload: payload,
    wire_payload: wire_payload
  }
end

def session_protocol_error_response(req: SemanticRequest) -> SemanticResponse
  let message = "unsupported protocol_version " + req.protocol_version.to_string() +
    " (this server speaks " + SEMANTIC_PROTOCOL_VERSION.to_string() + ")"
  SemanticResponse {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: req.request_id,
    ok: false,
    kind: "protocol_error".to_string(),
    error: message
  }
end

# Handle one typed request: the version gate (fail closed) + §38 routing.
pub def session_handle_request(session: CompilerSession, req: SemanticRequest) -> SemanticResponse
  if req.protocol_version != SEMANTIC_PROTOCOL_VERSION then
    return session_protocol_error_response(&req)
  end
  let results = session_query_results(&session, req.operation.clone(), req.payload.clone())
  session_results_response(&session, &req, &results)
end

# ———————————————————————————————————————————————————————————————
# Wire helpers — 4-byte big-endian length-prefixed fields
# ———————————————————————————————————————————————————————————————

def server_push_u32(inout out: Vec[u8], n: Int) -> Unit
  out.push(((n >> 24) & 0xFF) as u8)
  out.push(((n >> 16) & 0xFF) as u8)
  out.push(((n >> 8) & 0xFF) as u8)
  out.push((n & 0xFF) as u8)
end

def server_push_text(inout out: Vec[u8], text: String) -> Unit
  server_push_u32(&mut out, text.len())
  for b in text.bytes() do
    out.push(b)
  end
end

def server_read_u32(bytes: Vec[u8], inout at: Int) -> Option[Int]
  if at < 0 || at + 4 > bytes.len() then
    return Option::None
  end
  let n = ((bytes[at] as Int) << 24) | ((bytes[at + 1] as Int) << 16) |
    ((bytes[at + 2] as Int) << 8) | (bytes[at + 3] as Int)
  at = at + 4
  Option::Some(n)
end

def server_read_text(bytes: Vec[u8], inout at: Int) -> Option[String]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(n) then
    # Audit item 25: the field length is checked against MAX_FIELD_BYTES
    # and the remaining body BEFORE the text is sliced out.
    if n < 0 || n > MAX_FIELD_BYTES || at + n > bytes.len() then
      Option::None
    else
      let text = String::from_bytes(bytes.slice(at, at + n))
      at = at + n
      Option::Some(text)
    end
  end
end

def server_read_int(bytes: Vec[u8], inout at: Int) -> Option[Int]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(text) then
    match text.parse_int()
    when Result::Ok(n) then Option::Some(n)
    when Result::Err(_) then Option::None
    end
  end
end

def server_frame_of(body: Vec[u8]) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  server_push_u32(&mut out, body.len())
  for b in body do
    out.push(b)
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Request framing — encode + strict parse
# ———————————————————————————————————————————————————————————————

pub def semantic_request_frame(req: SemanticRequest) -> Vec[u8]
  var body: Vec[u8] = Vec::new()
  server_push_text(&mut body, req.protocol_version.to_string())
  server_push_text(&mut body, req.request_id.to_string())
  server_push_text(&mut body, req.operation.clone())
  server_push_text(&mut body, req.payload.clone())
  server_frame_of(body)
end

def server_req_fields_1(bytes: Vec[u8], inout at: Int, protocol_version: Int) -> Option[SemanticRequest]
  match server_read_int(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(request_id) then
    match server_read_text(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(operation) then
      match server_read_text(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(payload) then
        Option::Some(SemanticRequest {
          protocol_version: protocol_version,
          request_id: request_id,
          operation: operation,
          payload: payload
        })
      end
    end
  end
end

# Parse ONE complete request frame (strict — None on any framing/field
# error). Audit item 25: a frame must be at least the 4-byte BE length
# header and at most MAX_FRAME_BYTES (checked before any field work), and
# the fields must end EXACTLY at the body's end — trailing bytes inside a
# frame fail closed.
pub def semantic_request_parse(bytes: Vec[u8]) -> Option[SemanticRequest]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let end = at + body_len
    if bytes.len() != end then
      Option::None
    else
      match server_read_int(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(protocol_version) then
        match server_req_fields_1(&bytes, &mut at, protocol_version)
        when Option::None then Option::None
        when Option::Some(req) then
          if at != end then Option::None else Option::Some(req) end
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Response framing — encode + strict parse
# ———————————————————————————————————————————————————————————————

pub def semantic_response_frame(resp: SemanticResponse) -> Vec[u8]
  let error_text = resp.error.clone()
  var body: Vec[u8] = Vec::new()
  server_push_text(&mut body, resp.protocol_version.to_string())
  server_push_text(&mut body, resp.request_id.to_string())
  server_push_text(&mut body, if resp.ok then "true" else "false" end)
  server_push_text(&mut body, resp.kind.clone())
  server_push_text(&mut body, resp.keys.len().to_string())
  for k in resp.keys do
    server_push_text(&mut body, k.clone())
  end
  server_push_text(&mut body, error_text)
  server_frame_of(body)
end

def server_response_keys(bytes: Vec[u8], inout at: Int, count: Int) -> Option[Vec[String]]
  var keys: Vec[String] = Vec::new()
  var i = 0
  while i < count do
    match server_read_text(&bytes, &mut at)
    when Option::None then return Option::None
    when Option::Some(k) then keys.push(k.clone())
    end
    i = i + 1
  end
  Option::Some(keys)
end

def server_resp_fields_1(
  bytes: Vec[u8], inout at: Int, protocol_version: Int, request_id: Int, ok: Bool
) -> Option[SemanticResponse]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(kind) then
    match server_read_int(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(count) then
      # Audit item 25: the keys-count is range-checked (0 <= count <=
      # MAX_KEYS) BEFORE server_response_keys allocates the keys vector;
      # its own byte length was already bounded by server_read_text.
      if count < 0 || count > MAX_KEYS then
        Option::None
      else
        match server_response_keys(&bytes, &mut at, count)
        when Option::None then Option::None
        when Option::Some(keys) then
          match server_read_text(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(error) then
            Option::Some(SemanticResponse {
              protocol_version: protocol_version,
              request_id: request_id,
              ok: ok,
              kind: kind,
              keys: keys,
              error: error
            })
          end
        end
      end
    end
  end
end

# Parse ONE complete response frame (strict like semantic_request_parse;
# audit item 25 applies the same frame cap and end-of-body check).
pub def semantic_response_parse(bytes: Vec[u8]) -> Option[SemanticResponse]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let end = at + body_len
    if bytes.len() != end then
      Option::None
    else
      match server_read_int(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(protocol_version) then
        match server_read_int(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(request_id) then
          match server_read_text(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(ok_text) then
            if ok_text != "true" && ok_text != "false" then
              Option::None
            else
              match server_resp_fields_1(&bytes, &mut at, protocol_version, request_id, ok_text == "true")
              when Option::None then Option::None
              when Option::Some(resp) then
                if at != end then Option::None else Option::Some(resp) end
              end
            end
          end
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# PROTOCOL V2 — the typed tagged wire protocol (fourth-audit P0-11)
# ———————————————————————————————————————————————————————————————
# The v2 wire carries TYPED RECORDS instead of operation-name + payload
# text -> kind + row text. The §39 frame (4-byte BIG-ENDIAN body length ||
# body) is unchanged and shared with v1; the body is:
#
#   request  := version-word u32 || request_id u64 || request-tag u32 ||
#               <tagged request fields>
#   response := version-word u32 || request_id u64 || response-tag u32 ||
#               <tagged response fields>
#
# Field encodings (deterministic; no padding, no map iteration):
#   text   = u32 BE byte length || UTF-8 bytes   (MAX_FIELD_BYTES enforced
#            by the shared server_read_text BEFORE the slice is allocated)
#   u64    = 8 bytes big-endian; i64 = the same bytes viewed two's
#            complement; bool = 1 byte (0/1); option = presence byte || body
#   count  = u32 BE element count (0 <= count <= MAX_KEYS) || elements
# The version-word layout is `major << 16 | minor` (major 2, minor 0 today).
# READER VERSION POLICY (documented choice):
#   * a version-word with major != 2 is REJECTED (Option::None, fail closed
#     — the parser never guesses a foreign grammar);
#   * a same-major word (any minor) is parsed under this grammar; an
#     UNKNOWN TAG is also REJECTED, never skipped: the parser returns
#     Option::None and the serve loop terminates without a response, so an
#     unreadable request is never answered from a guessed interpretation and
#     the byte stream is never resynchronized onto a misparsed offset.
#   * the minor number is informational today (zero minor releases exist);
#     a future minor adds tags, and old readers fail closed on them by the
#     rule above — the safe direction (skip would risk answering garbage).
# The operation id is TYPED: a dense index into the §39 registry plus the
# 128-bit digest of the canonical operation name (semantic_operation_digest).
# The name text stays a DEBUG string; the wire carries the dense id and the
# digest words, and the decoder re-derives the name through the registry and
# verifies the digest (a forged dense id or digest fails closed).
#
# V1 COMPATIBILITY (negotiated): the v1 text-row protocol below is
# untouched and byte-compatible. semantic_frame_protocol_version probes the
# first body word (a v2 same-major word vs the v1 version-field length) and
# session_handle_frame routes: a version-1 request takes the v1 parse +
# session_handle_request + semantic_response_frame path, a version-2 request
# the v2 path, each answering in the version it was asked in.
#
# The request enum variants group the operation families:
#   Target  — the index / type / ownership / contract / symbol / explain
#             families: a text key (the op's arg grammar) plus the TYPED
#             subject id the key denotes (StableDeclId / StablePlaceId /
#             StableMirStmtId).
#   MirGraph— the mir graph ops: the function key + its StableDeclId, an
#             anchor key (mir.block) or right key (mir.diff), or a typed
#             StableMirStmtId node (mir.path / mir.reaching).
#   Slice   — mir_slice: the typed §33 MirSliceRequest (function key,
#             MirSliceKind, anchor).
#   Text    — the snapshot / diagnostic / plan / replay / edit families
#             (free-form payload grammar).
#   Service — the revision service op.

pub const SEMANTIC_PROTOCOL_VERSION_V2: Int = 2

# The version-word layout and the v2 fixed bits.
const SEMANTIC_V2_MAJOR: Int = 2
const SEMANTIC_V2_MINOR: Int = 0
const SEMANTIC_V2_HEADER: Int = 0x00020000

# Request payload tags (never renumber — they are wire identity).
const V2_REQ_TARGET: Int = 1
const V2_REQ_MIR_GRAPH: Int = 2
const V2_REQ_SLICE: Int = 3
const V2_REQ_TEXT: Int = 4
const V2_REQ_SERVICE: Int = 5

# Response payload tags (never renumber).
const V2_RESP_CALLERS: Int = 1
const V2_RESP_CALLEES: Int = 2
const V2_RESP_SYMBOLS: Int = 3
const V2_RESP_TYPE: Int = 4
const V2_RESP_EFFECTS: Int = 5
const V2_RESP_OWNERSHIP: Int = 6
const V2_RESP_CONTRACT: Int = 7
const V2_RESP_MIR_FUNCTION: Int = 8
const V2_RESP_ABI: Int = 9
const V2_RESP_DIAGNOSTIC: Int = 10
const V2_RESP_DELTA: Int = 11
const V2_RESP_PLAN: Int = 12
const V2_RESP_MIR_SLICE: Int = 13
const V2_RESP_EXPLAIN: Int = 14
const V2_RESP_ROWS: Int = 15
const V2_RESP_REVISION: Int = 16
const V2_RESP_STATUS: Int = 17

# Typed id tags inside the Target id union / the MirGraph node option.
# (repair-candidates-as-semantic-operations closure) V2_ID_UNAVAILABLE
# encodes the typed target-unavailable marker (kind + reason words): it is
# a marker, never a fabricated Decl/Place/MirStmt.
const V2_ID_DECL: Int = 1
const V2_ID_PLACE: Int = 2
const V2_ID_MIR_STMT: Int = 3
const V2_ID_UNAVAILABLE: Int = 4

# ———— The typed operation id ————

pub struct SemanticOperationId
  dense_id: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

def semantic_operation_id_text(id: SemanticOperationId) -> String
  "op:" + id.dense_id.to_string() + ":" + id.digest_hi.to_string() + "-" + id.digest_lo.to_string()
end

# The 128-bit digest of the canonical operation name (domain-separated:
# the "semantic-op|" prefix keeps the operation-id digest space disjoint
# from every stable key digest).
pub def semantic_operation_digest(name: String) -> StableDigest
  let text = "semantic-op|" + name
  stable_digest_of(&text)
end

# The typed id of a registered operation: the registry position (dense
# index — the registry is the dispatch authority) + the name digest words.
# Option::None for a name the registry does not declare.
pub def semantic_operation_id_of(name: String) -> Option[SemanticOperationId]
  var index = 0
  for op in server_operations() do
    if op.name == name then
      let digest = semantic_operation_digest(name.clone())
      return Option::Some(SemanticOperationId {
        dense_id: index,
        digest_hi: digest.hi,
        digest_lo: digest.lo
      })
    end
    index = index + 1
  end
  Option::None
end

# The registry name a typed id denotes: the dense index resolves the name
# and the digest words are RE-DERIVED and compared — a forged index or
# digest fails closed (Option::None). The name stays a debug string.
pub def semantic_operation_name_of(id: SemanticOperationId) -> Option[String]
  let operations = server_operations()
  if id.dense_id < 0 || id.dense_id >= operations.len() then
    return Option::None
  end
  let name = operations[id.dense_id].name.clone()
  let digest = semantic_operation_digest(name.clone())
  if digest.hi != id.digest_hi || digest.lo != id.digest_lo then
    return Option::None
  end
  Option::Some(name)
end

# ———————————————————————————————————————————————————————————————
# THE TYPED OPERATION SCHEMAS (audit item 4) — service.describe's payload
# ———————————————————————————————————————————————————————————————
# semantic_tool_schema_for maps EVERY registered operation to its TYPED
# SemanticToolSchema (semantic_model.tg): the argument product and result
# sum are built from the REAL typed request/response records the handler
# consumes — the v2 request variants (SemanticRequestV2Payload), the §33
# MirSliceRequest, MirGraphRequest (semantic_query.tg) and the typed wire
# response families (SemanticWirePayload) — never a synthetic shape.
# Option::None means the schema table does NOT cover the operation:
# semantic_tool_schemas() then omits it and semantic_schema_lane_check
# reports the missing name, so a gap is surfaced, never papered over by an
# invented default row.
#
# TEXT BOUNDARIES (audit item 4c): every Text field carries a TextKind:
#   CanonicalKeyText — the field value IS the operation's canonical key
#                      text (the real argument domain of the handler);
#   RowGrammar      — the v1 payload is an OP-SPECIFIC row-text grammar
#                      ("<kind>|<fn-key>|<anchor>" style). The handler now
#                      dispatches on the TYPED record (SessionDispatch);
#                      the text form is parsed ONCE at the external
#                      boundary and is marked here for migration;
#   None            — a free text payload whose record-typed form does not
#                      exist yet (the replay event-addressing grammar).
# The schema lane also pins that a RowGrammar-marked boundary is paired
# with a typed dispatch path (Slice / MirGraph / EditRequest).

pub def schema_field_text(name: String, text_kind: TextKind) -> SchemaField
  SchemaField { name: name, kind: SchemaValueKind::Text, text_kind: text_kind }
end

pub def schema_field_required(name: String, kind: SchemaValueKind) -> SchemaField
  SchemaField { name: name, kind: kind }
end

pub def schema_field_optional(name: String, kind: SchemaValueKind) -> SchemaField
  SchemaField { name: name, kind: kind, presence: FieldPresence::Optional }
end

# The target-family argument product: the operation's key text plus the
# OPTIONAL typed v2 subject id (the v1 payload carries the key text alone
# and the handler resolves it; the typed id is the v2 identity carrier).
def schema_key_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("key".to_string(), TextKind::CanonicalKeyText),
      schema_field_optional("target".to_string(), SchemaValueKind::TargetIdUnion)
    ]),
    boundary: TextBoundary::KeyText
  }
end

pub def schema_text_args(name: String, text_kind: TextKind) -> ProductSchema
  ProductSchema {
    fields: Vec::from([schema_field_text(name, text_kind)]),
    boundary: TextBoundary::KeyText
  }
end

pub def schema_no_args() -> ProductSchema
  ProductSchema {}
end

def schema_slice_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("function_key".to_string(), TextKind::CanonicalKeyText),
      schema_field_required("kind".to_string(), SchemaValueKind::MirSliceKind),
      schema_field_text("anchor".to_string(), TextKind::CanonicalKeyText)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

def schema_mir_fn_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("function_key".to_string(), TextKind::CanonicalKeyText)
    ]),
    boundary: TextBoundary::KeyText
  }
end

def schema_mir_node_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("function_key".to_string(), TextKind::CanonicalKeyText),
      schema_field_required("node".to_string(), SchemaValueKind::MirStmtId)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

def schema_mir_block_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("block_key".to_string(), TextKind::CanonicalKeyText)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

def schema_mir_diff_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_text("function_key".to_string(), TextKind::CanonicalKeyText),
      schema_field_text("right_key".to_string(), TextKind::CanonicalKeyText)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

def schema_edit_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_required("edit".to_string(), SchemaValueKind::EditRequest),
      schema_field_text("source".to_string(), TextKind::None)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

# (audit order P0-15) edit.apply_verified's argument product: the typed
# SemanticEdit the handler parses from the row grammar + the ChangeBudget /
# VerificationPolicy rows that ride after the kind's fields (the source is
# the session's own — this op carries no source text).
def schema_edit_verified_args() -> ProductSchema
  ProductSchema {
    fields: Vec::from([
      schema_field_required("edit".to_string(), SchemaValueKind::EditRequest),
      schema_field_text("payload".to_string(), TextKind::RowGrammar)
    ]),
    boundary: TextBoundary::RowGrammar
  }
end

pub def schema_variant(name: String, record: RecordFamily) -> SumSchemaVariant
  SumSchemaVariant { name: name, record: record }
end

pub def schema_result1(name: String, record: RecordFamily) -> SumSchema
  SumSchema { variants: Vec::from([schema_variant(name, record)]) }
end

pub def schema_result2(
  name_a: String, record_a: RecordFamily, name_b: String, record_b: RecordFamily
) -> SumSchema
  SumSchema {
    variants: Vec::from([schema_variant(name_a, record_a), schema_variant(name_b, record_b)])
  }
end

pub def schema_complete() -> CompletenessContract
  CompletenessContract { class: CompletenessClass::Complete }
end

pub def schema_gated(unavailable_kind: String) -> CompletenessContract
  CompletenessContract {
    class: CompletenessClass::ArtifactGated,
    unavailable_kind: unavailable_kind
  }
end

# The Complete contract with a documented fail-closed empty-answer kind
# (the index-found-nothing forms: no artifact is missing — the named kind
# is the machine-readable "no rows for this subject" answer).
pub def schema_kinded(unavailable_kind: String) -> CompletenessContract
  CompletenessContract {
    class: CompletenessClass::Complete,
    unavailable_kind: unavailable_kind
  }
end

pub def schema_artifacts(
  mir: Bool,
  coverage: Bool,
  store: Bool,
  evidence: Bool,
  delta: Bool,
  typed_program: Bool,
  event_trace: Bool,
  rationale_store: Bool
) -> ArtifactRequirements
  ArtifactRequirements {
    mir_program: mir,
    coverage_rows: coverage,
    diagnostic_store: store,
    evidence: evidence,
    delta: delta,
    typed_program: typed_program,
    event_trace: event_trace,
    rationale_store: rationale_store
  }
end

pub def schema_no_artifacts() -> ArtifactRequirements
  schema_artifacts(false, false, false, false, false, false, false, false)
end

pub def schema_mir_artifacts() -> ArtifactRequirements
  schema_artifacts(true, false, false, false, false, false, false, false)
end

pub def schema_store_artifacts() -> ArtifactRequirements
  schema_artifacts(false, false, true, false, false, false, false, false)
end

# The ONE schema constructor (exported so the Tier-4 rationale supplement
# builds its rows through the same id/digest/version authority).
pub def semantic_tool_schema_new(
  name: String,
  capability: String,
  arguments: ProductSchema,
  result: SumSchema,
  ids: Vec[StableIdKind],
  completeness: CompletenessContract,
  artifacts: ArtifactRequirements,
  mutability: Mutability,
  determinism: DeterminismClass,
  cost: QueryCostClass,
  stability: ToolStability
) -> SemanticToolSchema
  SemanticToolSchema {
    id: StableToolId {
      name: name.clone(),
      digest: semantic_operation_digest(name.clone())
    },
    version: ProtocolVersion { major: SEMANTIC_V2_MAJOR, minor: SEMANTIC_V2_MINOR },
    name: name,
    arguments: arguments,
    result: result,
    identity_domains: ids,
    completeness: completeness,
    required_artifacts: artifacts,
    mutability: mutability,
    determinism: determinism,
    cost: cost,
    stability: stability,
    capability: capability
  }
end

# The shared shape of a key-argument op (the target family): argument =
# schema_key_args(), no artifacts, read-only; the per-op result / identity
# domains / classes are the call's arguments.
def schema_key_op(
  name: String,
  capability: String,
  result: SumSchema,
  ids: Vec[StableIdKind],
  stability: ToolStability,
  determinism: DeterminismClass,
  cost: QueryCostClass,
  artifacts: ArtifactRequirements,
  completeness: CompletenessContract
) -> Option[SemanticToolSchema]
  Option::Some(semantic_tool_schema_new(name, capability, schema_key_args(), result, ids,
    completeness, artifacts, Mutability::ReadOnly, determinism, cost, stability))
end

# The shared shape of a no-argument op.
def schema_no_arg_op(
  name: String,
  capability: String,
  result: SumSchema,
  ids: Vec[StableIdKind],
  stability: ToolStability,
  determinism: DeterminismClass,
  cost: QueryCostClass,
  artifacts: ArtifactRequirements,
  completeness: CompletenessContract
) -> Option[SemanticToolSchema]
  Option::Some(semantic_tool_schema_new(name, capability, schema_no_args(), result, ids,
    completeness, artifacts, Mutability::ReadOnly, determinism, cost, stability))
end

# The shared shape of a text-argument op (the subject / event-addressing
# boundary). text_kind marks the boundary (CanonicalKeyText vs RowGrammar
# vs None).
def schema_text_op(
  name: String,
  capability: String,
  field_name: String,
  text_kind: TextKind,
  result: SumSchema,
  ids: Vec[StableIdKind],
  stability: ToolStability,
  determinism: DeterminismClass,
  cost: QueryCostClass,
  artifacts: ArtifactRequirements,
  completeness: CompletenessContract
) -> Option[SemanticToolSchema]
  Option::Some(semantic_tool_schema_new(name, capability, schema_text_args(field_name, text_kind), result,
    ids, completeness, artifacts, Mutability::ReadOnly, determinism, cost, stability))
end

# The shared shape of a MIR-family op: experimental, read-only, MIR-gated,
# walking the finalized program.
def schema_mir_op(
  name: String,
  arguments: ProductSchema,
  result: SumSchema,
  ids: Vec[StableIdKind],
  cost: QueryCostClass,
  unavailable_kind: String
) -> Option[SemanticToolSchema]
  Option::Some(semantic_tool_schema_new(name, "mir".to_string(), arguments, result, ids,
    schema_gated(unavailable_kind), schema_mir_artifacts(), Mutability::ReadOnly,
    DeterminismClass::Deterministic, cost, ToolStability::Experimental))
end

# The per-op schema table — ONE arm per registered operation, the schema
# built from the handler's real typed records. The match is total for the
# current registry; Option::None is the honest answer for a name with no
# schema row (never an invented default).
pub def semantic_tool_schema_for(op: ServerOperation) -> Option[SemanticToolSchema]
  match op.name.clone()
  # ———— the index family (§32 SemanticIndex) ————
  when "callers" then
    schema_key_op("callers".to_string(), "index".to_string(),
      schema_result1("callers".to_string(), RecordFamily::Callers),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "callees" then
    schema_key_op("callees".to_string(), "index".to_string(),
      schema_result1("callees".to_string(), RecordFamily::Callees),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "types" then
    schema_key_op("types".to_string(), "index".to_string(),
      schema_result1("types".to_string(), RecordFamily::Type),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "effects" then
    schema_key_op("effects".to_string(), "index".to_string(),
      schema_result1("effects".to_string(), RecordFamily::Effects),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "capabilities" then
    schema_key_op("capabilities".to_string(), "index".to_string(),
      schema_result1("capabilities".to_string(), RecordFamily::Effects),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "purity.get" then
    schema_key_op("purity.get".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::OrderedDeterministic, QueryCostClass::LinearScan,
      schema_no_artifacts(), schema_complete())
  when "contracts" then
    schema_key_op("contracts".to_string(), "index".to_string(),
      schema_result2("contract".to_string(), RecordFamily::Contract,
        "rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::Contract]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "fields" then
    schema_key_op("fields".to_string(), "index".to_string(),
      schema_result2("type".to_string(), RecordFamily::Type,
        "rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "impls" then
    schema_key_op("impls".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "properties" then
    schema_key_op("properties".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "mir_function" then
    schema_key_op("mir_function".to_string(), "index".to_string(),
      schema_result1("mir-function".to_string(), RecordFamily::MirFunction),
      Vec::from([StableIdKind::Decl, StableIdKind::MirNode]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "symbol_get" then
    schema_key_op("symbol_get".to_string(), "index".to_string(),
      schema_result1("symbols".to_string(), RecordFamily::Symbols),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "symbol_search" then
    schema_key_op("symbol_search".to_string(), "index".to_string(),
      schema_result1("symbols".to_string(), RecordFamily::Symbols),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "contract_list" then
    schema_key_op("contract_list".to_string(), "index".to_string(),
      schema_result2("contract".to_string(), RecordFamily::Contract,
        "rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::Contract]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::Indexed,
      schema_no_artifacts(), schema_complete())
  when "type_explain" then
    schema_key_op("type_explain".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      schema_no_artifacts(), schema_complete())
  when "ownership_explain" then
    schema_key_op("ownership_explain".to_string(), "index".to_string(),
      schema_result1("ownership".to_string(), RecordFamily::Ownership),
      Vec::from([StableIdKind::Decl, StableIdKind::Place]), ToolStability::Stable,
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      schema_no_artifacts(), schema_complete())
  when "test.affected" then
    schema_key_op("test.affected".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl]), ToolStability::Experimental,
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      schema_artifacts(false, true, false, false, false, false, false, false),
      schema_gated("test.affected_unavailable".to_string()))
  when "coverage.affected" then
    schema_key_op("coverage.affected".to_string(), "index".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::MirBlock]), ToolStability::Experimental,
      DeterminismClass::Deterministic, QueryCostClass::LinearScan,
      schema_artifacts(false, true, false, false, false, false, false, false),
      schema_gated("coverage.affected_unavailable".to_string()))

  # ———— the mir family (the session's finalized program) ————
  when "mir_slice" then
    schema_mir_op("mir_slice".to_string(), schema_slice_args(),
      schema_result2("mir-slice".to_string(), RecordFamily::MirSlice,
        "rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::MirStmt]),
      QueryCostClass::EngineWalk, "mir_slice_unavailable".to_string())
  when "mir.dominators" then
    schema_mir_op("mir.dominators".to_string(), schema_mir_fn_args(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::MirBlock]),
      QueryCostClass::ProgramWalk, "mir.dominators_unavailable".to_string())
  when "mir.postdominators" then
    schema_mir_op("mir.postdominators".to_string(), schema_mir_fn_args(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::Decl, StableIdKind::MirBlock]),
