  when Option::None then Option::None
  when Option::Some(revision_hi) then
    match v2_read_u64(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(revision_lo) then
      Option::Some(RevisionResponse {
        revision_hi: revision_hi,
        revision_lo: revision_lo
      })
    end
