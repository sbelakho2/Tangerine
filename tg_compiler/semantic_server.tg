      schema_artifacts(false, false, false, false, false, false, true, false),
      schema_gated("replay.diff_unavailable".to_string()))
  when "replay.compare" then
    # (audit order item 6) the production-bridge compare: the payload is
    # the two-line hex run-artifact grammar (RowGrammar), the answer is the
    # canonical comparison rows (status/digests/first-divergence/slice).
    schema_text_op("replay.compare".to_string(), "replay".to_string(),
      "runs".to_string(), TextKind::RowGrammar,
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::from([StableIdKind::MirNode, StableIdKind::Decl]), ToolStability::Experimental,
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
