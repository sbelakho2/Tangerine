def v2_push_mir_slice(inout out: Vec[u8], record: MirSliceResponse) -> Unit
  server_push_text(out, record.kind.clone())
  v2_push_texts(out, record.statements.clone())
  v2_push_texts(out, record.externals.clone())
  # (audit item 9) the shared completeness record: class word, reason,
  # visited, returned, omitted, model — fixed field order.
  server_push_text(out, slice_completeness_word(record.completeness.completeness.clone()))
  server_push_text(out, record.completeness.truncation_reason.clone())
  v2_push_i64(out, record.completeness.visited_nodes)
  v2_push_i64(out, record.completeness.returned_nodes)
  v2_push_i64(out, record.completeness.omitted_lower_bound)
  server_push_text(out, record.completeness.analysis_model.clone())
end

def v2_read_mir_slice(bytes: Vec[u8], inout at: Int) -> Option[MirSliceResponse]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(kind) then
    match v2_read_texts(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(statements) then
      match v2_read_texts(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(externals) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(class_word) then
          match server_read_text(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(reason) then
            match v2_read_i64(&bytes, &mut at)
            when Option::None then Option::None
            when Option::Some(visited) then
              match v2_read_i64(&bytes, &mut at)
              when Option::None then Option::None
              when Option::Some(returned) then
                match v2_read_i64(&bytes, &mut at)
                when Option::None then Option::None
                when Option::Some(omitted) then
                  match server_read_text(&bytes, &mut at)
                  when Option::None then Option::None
                  when Option::Some(model) then
                    # an unknown class word is REFUSED (fail-closed): a
                    # completeness the decoder cannot name must never
                    # decode as Complete.
                    match slice_completeness_of_word(class_word.clone())
                    when Option::None then Option::None
                    when Option::Some(class) then
                      Option::Some(MirSliceResponse {
                        kind: kind,
                        statements: statements,
                        externals: externals,
                        completeness: CompletenessInfo {
                          completeness: class,
                          truncation_reason: reason,
                          visited_nodes: visited,
                          returned_nodes: returned,
                          omitted_lower_bound: omitted,
                          analysis_model: model
                        }
                      })
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

def v2_push_rows(inout out: Vec[u8], record: RowsResponse) -> Unit
  server_push_text(out, record.kind.clone())
  v2_push_texts(out, record.rows.clone())
end

