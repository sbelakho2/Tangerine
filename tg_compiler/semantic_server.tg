def v2_read_revision(bytes: Vec[u8], inout at: Int) -> Option[RevisionResponse]
  match v2_read_u64(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(revision_hi) then
    match v2_read_u64(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(revision_lo) then
      Option::Some(RevisionResponse {
        revision_hi: revision_hi,
        revision_lo: revision_lo
      })
    end
  end
end

def v2_push_status(inout out: Vec[u8], record: StatusResponse) -> Unit
  v2_push_bool(out, record.ok)
  server_push_text(out, record.kind.clone())
  server_push_text(out, record.message.clone())
end

def v2_read_status(bytes: Vec[u8], inout at: Int) -> Option[StatusResponse]
  match v2_read_bool(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(ok) then
    match server_read_text(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(kind) then
      match server_read_text(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(message) then
        Option::Some(StatusResponse { ok: ok, kind: kind, message: message })
      end
    end
  end
end

def v2_push_explain(inout out: Vec[u8], node: ExplainNode) -> Unit
  server_push_text(out, node.kind.clone())
  server_push_text(out, node.subject.clone())
  server_push_text(out, node.relation.clone())
  server_push_text(out, node.fact.clone())
  v2_push_count(out, node.children.len())
  for child in node.children do
    v2_push_explain(out, child.clone())
  end
end

def v2_read_explain_children(bytes: Vec[u8], inout at: Int, count: Int) -> Option[Vec[ExplainNode]]
  var children: Vec[ExplainNode] = Vec::new()
  var i = 0
  while i < count do
    match v2_read_explain(&bytes, &mut at)
    when Option::None then return Option::None
    when Option::Some(child) then children.push(child.clone())
    end
    i = i + 1
  end
  Option::Some(children)
end

def v2_read_explain(bytes: Vec[u8], inout at: Int) -> Option[ExplainNode]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(kind) then
    match server_read_text(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(subject) then
      match server_read_text(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(relation) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(fact) then
          match v2_read_count(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(count) then
            match v2_read_explain_children(&bytes, &mut at, count)
            when Option::None then Option::None
            when Option::Some(children) then
              Option::Some(ExplainNode {
                kind: kind,
                subject: subject,
                relation: relation,
                fact: fact,
                children: children
              })
            end
          end
        end
      end
    end
  end
end

# ———— The request payload codec ———

def v2_push_request_payload(inout out: Vec[u8], payload: SemanticRequestV2Payload) -> Unit
  match payload
  when SemanticRequestV2Payload::Target(operation, key, target) then
    server_push_u32(out, V2_REQ_TARGET)
    v2_push_operation_id(out, operation)
    server_push_text(out, key)
    v2_push_target(out, target)
  when SemanticRequestV2Payload::MirGraph(operation, function_key, function, anchor_key, right_key, node) then
    server_push_u32(out, V2_REQ_MIR_GRAPH)
    v2_push_operation_id(out, operation)
    server_push_text(out, function_key)
    v2_push_decl(out, function)
    server_push_text(out, anchor_key)
    server_push_text(out, right_key)
    match node
    when Option::Some(stmt) then
      v2_push_bool(out, true)
      v2_push_mir_stmt(out, stmt)
    when Option::None then
      v2_push_bool(out, false)
    end
  when SemanticRequestV2Payload::Slice(operation, request) then
    server_push_u32(out, V2_REQ_SLICE)
    v2_push_operation_id(out, operation)
    v2_push_slice_request(out, request)
  when SemanticRequestV2Payload::Text(operation, arg) then
    server_push_u32(out, V2_REQ_TEXT)
    v2_push_operation_id(out, operation)
    server_push_text(out, arg)
  when SemanticRequestV2Payload::Service(operation) then
    server_push_u32(out, V2_REQ_SERVICE)
    v2_push_operation_id(out, operation)
  end
end

def v2_read_node_option(bytes: Vec[u8], inout at: Int) -> Option[Option[StableMirStmtId]]
  match v2_read_bool(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(present) then
    if present then
      match v2_read_mir_stmt(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(stmt) then Option::Some(Option::Some(stmt))
      end
    else
      Option::Some(Option::None)
    end
  end
end

def v2_read_request_payload(bytes: Vec[u8], inout at: Int) -> Option[SemanticRequestV2Payload]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(tag) then
    if tag == V2_REQ_TARGET then
      match v2_read_operation_id(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(operation) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(key) then
          match v2_read_target(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(target) then
            Option::Some(SemanticRequestV2Payload::Target(operation, key, target))
          end
        end
      end
    elsif tag == V2_REQ_MIR_GRAPH then
      match v2_read_operation_id(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(operation) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(function_key) then
          match v2_read_decl(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(function) then
            match server_read_text(&bytes, &mut at)
            when Option::None then Option::None
            when Option::Some(anchor_key) then
              match server_read_text(&bytes, &mut at)
              when Option::None then Option::None
              when Option::Some(right_key) then
                match v2_read_node_option(&bytes, &mut at)
                when Option::None then Option::None
                when Option::Some(node) then
                  Option::Some(SemanticRequestV2Payload::MirGraph(
                    operation, function_key, function, anchor_key, right_key, node))
                end
              end
            end
          end
        end
      end
    elsif tag == V2_REQ_SLICE then
      match v2_read_operation_id(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(operation) then
        match v2_read_slice_request(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(request) then
          Option::Some(SemanticRequestV2Payload::Slice(operation, request))
        end
      end
    elsif tag == V2_REQ_TEXT then
      match v2_read_operation_id(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(operation) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(arg) then
          Option::Some(SemanticRequestV2Payload::Text(operation, arg))
        end
      end
    elsif tag == V2_REQ_SERVICE then
      match v2_read_operation_id(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(operation) then
        Option::Some(SemanticRequestV2Payload::Service(operation))
      end
    else
      Option::None
    end
  end
end

# ———— The response payload codec ———

def v2_push_response_payload(inout out: Vec[u8], payload: SemanticResponseV2Payload) -> Unit
  match payload
  when SemanticResponseV2Payload::Callers(record) then
    server_push_u32(out, V2_RESP_CALLERS)
    v2_push_callers(out, record)
  when SemanticResponseV2Payload::Callees(record) then
    server_push_u32(out, V2_RESP_CALLEES)
    v2_push_callees(out, record)
  when SemanticResponseV2Payload::Symbols(record) then
    server_push_u32(out, V2_RESP_SYMBOLS)
    v2_push_symbols(out, record)
  when SemanticResponseV2Payload::Type(record) then
    server_push_u32(out, V2_RESP_TYPE)
    v2_push_type(out, record)
  when SemanticResponseV2Payload::Effects(record) then
    server_push_u32(out, V2_RESP_EFFECTS)
    v2_push_effects(out, record)
  when SemanticResponseV2Payload::Ownership(record) then
    server_push_u32(out, V2_RESP_OWNERSHIP)
    v2_push_ownership(out, record)
  when SemanticResponseV2Payload::Contract(record) then
    server_push_u32(out, V2_RESP_CONTRACT)
    v2_push_contract(out, record)
  when SemanticResponseV2Payload::MirFunction(record) then
    server_push_u32(out, V2_RESP_MIR_FUNCTION)
    v2_push_mir_function(out, record)
  when SemanticResponseV2Payload::Abi(record) then
    server_push_u32(out, V2_RESP_ABI)
    v2_push_abi(out, record)
  when SemanticResponseV2Payload::Diagnostic(record) then
    server_push_u32(out, V2_RESP_DIAGNOSTIC)
    v2_push_diagnostic(out, record)
  when SemanticResponseV2Payload::Delta(record) then
    server_push_u32(out, V2_RESP_DELTA)
    v2_push_delta(out, record)
  when SemanticResponseV2Payload::Plan(record) then
    server_push_u32(out, V2_RESP_PLAN)
    v2_push_plan(out, record)
  when SemanticResponseV2Payload::MirSlice(record) then
    server_push_u32(out, V2_RESP_MIR_SLICE)
    v2_push_mir_slice(out, record)
  when SemanticResponseV2Payload::Explain(record) then
    server_push_u32(out, V2_RESP_EXPLAIN)
    v2_push_explain(out, record)
  when SemanticResponseV2Payload::Rows(record) then
    server_push_u32(out, V2_RESP_ROWS)
    v2_push_rows(out, record)
  when SemanticResponseV2Payload::Revision(record) then
    server_push_u32(out, V2_RESP_REVISION)
    v2_push_revision(out, record)
  when SemanticResponseV2Payload::Status(record) then
    server_push_u32(out, V2_RESP_STATUS)
    v2_push_status(out, record)
  end
end

def v2_read_response_payload(bytes: Vec[u8], inout at: Int) -> Option[SemanticResponseV2Payload]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(tag) then
    if tag == V2_RESP_CALLERS then
      match v2_read_callers(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Callers(record))
      end
    elsif tag == V2_RESP_CALLEES then
      match v2_read_callees(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Callees(record))
      end
    elsif tag == V2_RESP_SYMBOLS then
      match v2_read_symbols(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Symbols(record))
      end
    elsif tag == V2_RESP_TYPE then
      match v2_read_type(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Type(record))
      end
    elsif tag == V2_RESP_EFFECTS then
      match v2_read_effects(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Effects(record))
      end
    elsif tag == V2_RESP_OWNERSHIP then
      match v2_read_ownership(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Ownership(record))
      end
    elsif tag == V2_RESP_CONTRACT then
      match v2_read_contract(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Contract(record))
      end
    elsif tag == V2_RESP_MIR_FUNCTION then
      match v2_read_mir_function(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::MirFunction(record))
      end
    elsif tag == V2_RESP_ABI then
      match v2_read_abi(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Abi(record))
      end
    elsif tag == V2_RESP_DIAGNOSTIC then
      match v2_read_diagnostic(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Diagnostic(record))
      end
    elsif tag == V2_RESP_DELTA then
      match v2_read_delta(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Delta(record))
      end
    elsif tag == V2_RESP_PLAN then
      match v2_read_plan(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Plan(record))
      end
    elsif tag == V2_RESP_MIR_SLICE then
      match v2_read_mir_slice(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::MirSlice(record))
      end
    elsif tag == V2_RESP_EXPLAIN then
      match v2_read_explain(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Explain(record))
      end
    elsif tag == V2_RESP_ROWS then
      match v2_read_rows(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Rows(record))
      end
    elsif tag == V2_RESP_REVISION then
      match v2_read_revision(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Revision(record))
      end
    elsif tag == V2_RESP_STATUS then
      match v2_read_status(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(record) then Option::Some(SemanticResponseV2Payload::Status(record))
      end
    else
      Option::None
    end
  end
end

# ———— The v2 frame codec ———

pub def semantic_request_v2_frame(req: SemanticRequestV2) -> Vec[u8]
  var body: Vec[u8] = Vec::new()
  server_push_u32(&mut body, SEMANTIC_V2_HEADER)
  v2_push_u64(&mut body, req.request_id as UInt)
  v2_push_request_payload(&mut body, req.payload.clone())
  server_frame_of(body)
end

# Parse ONE complete v2 request frame (strict — None on a framing/field/
# version/tag error; the same MAX_FRAME_BYTES cap as v1; the fields must
# end exactly at the body end).
pub def semantic_request_v2_parse(bytes: Vec[u8]) -> Option[SemanticRequestV2]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let body_end = at + body_len
    if bytes.len() != body_end then
      Option::None
    else
      match server_read_u32(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(header) then
        if (header >> 16) != SEMANTIC_V2_MAJOR then
          Option::None
        else
          match v2_read_u64(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(request_id_word) then
            match v2_read_request_payload(&bytes, &mut at)
            when Option::None then Option::None
            when Option::Some(payload) then
              var parsed: Option[SemanticRequestV2] = Option::None
              if at == body_end then
                parsed = Option::Some(SemanticRequestV2 {
                  protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
                  request_id: request_id_word as Int,
                  payload: payload
                })
              end
              parsed
            end
          end
        end
      end
    end
  end
end

pub def semantic_response_v2_frame(resp: SemanticResponseV2) -> Vec[u8]
  var body: Vec[u8] = Vec::new()
  server_push_u32(&mut body, SEMANTIC_V2_HEADER)
  v2_push_u64(&mut body, resp.request_id as UInt)
  v2_push_response_payload(&mut body, resp.payload.clone())
  server_frame_of(body)
end

pub def semantic_response_v2_parse(bytes: Vec[u8]) -> Option[SemanticResponseV2]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let body_end = at + body_len
    if bytes.len() != body_end then
      Option::None
    else
      match server_read_u32(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(header) then
        if (header >> 16) != SEMANTIC_V2_MAJOR then
          Option::None
        else
          match v2_read_u64(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(request_id_word) then
            match v2_read_response_payload(&bytes, &mut at)
            when Option::None then Option::None
            when Option::Some(payload) then
              var parsed: Option[SemanticResponseV2] = Option::None
              if at == body_end then
                parsed = Option::Some(SemanticResponseV2 {
                  protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
                  request_id: request_id_word as Int,
                  payload: payload
                })
              end
              parsed
            end
          end
        end
      end
    end
  end
end

# ———— The v2 dispatch, response builder and frame negotiation ———

def server_v2_resolve(operation: SemanticOperationId) -> Option[ServerOperation]
  match semantic_operation_name_of(operation)
  when Option::None then Option::None
  when Option::Some(name) then server_operation_resolve(&name)
  end
end

def server_v2_target_family_ok(handler_kind: String) -> Bool
  handler_kind == "index" || handler_kind == "type" || handler_kind == "ownership" ||
  handler_kind == "contract" || handler_kind == "symbol" || handler_kind == "explain"
end

def server_v2_text_family_ok(handler_kind: String) -> Bool
  handler_kind == "snapshot" || handler_kind == "diagnostic" || handler_kind == "plan" ||
  handler_kind == "replay" || handler_kind == "edit"
end

# The v2 request -> (operation name, §38 arg) adapter. The operation id
# resolves through the registry (never a name string on the wire) and the
# VARIANT is checked against the resolved handler family: a target request
# naming a service op (or a slice request naming an index op) fails closed
# instead of dispatching a mismatched payload.
pub def semantic_request_v2_dispatch(payload: SemanticRequestV2Payload) -> Option[(String, String)]
  match payload
  when SemanticRequestV2Payload::Target(operation, key, _target) then
    match server_v2_resolve(operation)
    when Option::None then Option::None
    when Option::Some(op) then
      if server_v2_target_family_ok(op.handler_kind.clone()) then
        Option::Some((op.name.clone(), key))
      else
        Option::None
      end
    end
  when SemanticRequestV2Payload::MirGraph(operation, function_key, _function, anchor_key, right_key, node) then
    match server_v2_resolve(operation)
    when Option::None then Option::None
    when Option::Some(op) then
      if op.handler_kind != "mir" then
        Option::None
      elsif right_key.len() > 0 then
        Option::Some((op.name.clone(), function_key + "|" + right_key))
      elsif anchor_key.len() > 0 then
        Option::Some((op.name.clone(), anchor_key))
      else
        match node
        when Option::Some(stmt) then
          Option::Some((op.name.clone(), function_key + "|" + stmt.stable_key.clone()))
        when Option::None then
          Option::Some((op.name.clone(), function_key))
        end
      end
    end
  when SemanticRequestV2Payload::Slice(operation, request) then
    match server_v2_resolve(operation)
    when Option::None then Option::None
    when Option::Some(op) then
      if op.handler_kind == "mir" then
        Option::Some((op.name.clone(), v2_slice_request_text(request)))
      else
        Option::None
      end
    end
  when SemanticRequestV2Payload::Text(operation, arg) then
    match server_v2_resolve(operation)
    when Option::None then Option::None
    when Option::Some(op) then
      if server_v2_text_family_ok(op.handler_kind.clone()) then
        Option::Some((op.name.clone(), arg))
      else
        Option::None
      end
    end
  when SemanticRequestV2Payload::Service(operation) then
    match server_v2_resolve(operation)
    when Option::None then Option::None
    when Option::Some(op) then
      if op.handler_kind == "service" then
        Option::Some((op.name.clone(), "".to_string()))
      else
        Option::None
      end
    end
  end
end

def semantic_v2_payload_of_wire(payload: SemanticWirePayload) -> SemanticResponseV2Payload
  match payload
  when SemanticWirePayload::Callers(record) then SemanticResponseV2Payload::Callers(record)
  when SemanticWirePayload::Callees(record) then SemanticResponseV2Payload::Callees(record)
  when SemanticWirePayload::Symbols(record) then SemanticResponseV2Payload::Symbols(record)
  when SemanticWirePayload::Type(record) then SemanticResponseV2Payload::Type(record)
  when SemanticWirePayload::Effects(record) then SemanticResponseV2Payload::Effects(record)
  when SemanticWirePayload::Ownership(record) then SemanticResponseV2Payload::Ownership(record)
  when SemanticWirePayload::Contract(record) then SemanticResponseV2Payload::Contract(record)
  when SemanticWirePayload::MirFunction(record) then SemanticResponseV2Payload::MirFunction(record)
  when SemanticWirePayload::Abi(record) then SemanticResponseV2Payload::Abi(record)
  when SemanticWirePayload::Diagnostic(record) then SemanticResponseV2Payload::Diagnostic(record)
  when SemanticWirePayload::Delta(record) then SemanticResponseV2Payload::Delta(record)
  when SemanticWirePayload::Plan(record) then SemanticResponseV2Payload::Plan(record)
  end
end

def server_v2_is_explain_operation(operation: String) -> Bool
  operation == "type.explain" || operation == "trait.explain" ||
  operation == "ownership.explain" || operation == "effect.explain" ||
  operation == "capability.explain" || operation == "layout.explain" ||
  operation == "optimization.explain" || operation == "diagnostic.explain"
end

# The typed ExplainNode tree of one explain op. The non-diagnostic ops route
# the SAME tree semantic_query.explain_tree builds for the §38 render (so
# the v2 tree and the v1 render lines can never diverge); diagnostic.explain
# mirrors the store-aware arm — an empty store keeps the absent leaf, a
# match builds the record tree, a non-matching non-empty store the
# "diagnostic-missing" leaf (the exact `diagnostic_explain_store` shapes).
def session_explain_node(session: CompilerSession, operation: String, subject: String) -> ExplainNode
  if operation == "diagnostic.explain" then
    let count = store_len(session.diagnostics_store.clone())
    if count == 0 then
      return explain_tree(session_query(&session), operation.clone(), subject.clone(), Option::None)
    end
    match store_match(session.diagnostics_store.clone(), subject.clone())
    when Option::Some(record) then
      return diagnostic_record_explain_node(record)
    when Option::None then
      let root = explain_text_node("diagnostic.explain".to_string(), subject.clone())
      return explain_node_child(root, explain_text_node("diagnostic-missing".to_string(), "no diagnostic matched".to_string()))
    end
  end
  explain_tree(session_query(&session), operation, subject, Option::None)
end

# Build the typed v2 answer of one §38 result. Family precedence:
#   1. the explain ops -> the typed tree (never the rendered rows);
#   2. mir_slice / mir.path -> the typed MirSlice answer (the §33 payload
#      when present, else the kind + empty lists);
#   3. revision -> the session's digest WORDS;
#   4. unknown / "*_unavailable" kinds -> the typed Status (ok=true, the
#      §38 kind preserved);
#   5. the typed record families (the SAME mechanical mapping v1 uses);
#   6. every remaining registry op -> Rows(kind, rows) — a typed record.
pub def semantic_response_v2_of_results(
  session: CompilerSession, operation: String, arg: String, results: QueryResults
) -> SemanticResponseV2Payload
  if server_v2_is_explain_operation(operation.clone()) then
    return SemanticResponseV2Payload::Explain(session_explain_node(&session, operation.clone(), arg.clone()))
  end
  if operation == "mir_slice" || operation == "mir.path" then
    var statements = results.keys.clone()
    var externals: Vec[String] = Vec::new()
    match results.payload.clone()
    when Option::Some(p) then
      match p
      when SemanticResponsePayload::MirSlice(st, ex) then
        statements = st.clone()
        externals = ex.clone()
      when _ then ()
      end
    when Option::None then ()
    end
    return SemanticResponseV2Payload::MirSlice(MirSliceResponse {
      kind: results.kind.clone(),
      statements: statements,
      externals: externals
    })
  end
  if operation == "revision" then
    return SemanticResponseV2Payload::Revision(RevisionResponse {
      revision_hi: session.revision.hi,
      revision_lo: session.revision.lo
    })
  end
  if results.kind == "unknown" || results.kind.ends_with("_unavailable") then
    return SemanticResponseV2Payload::Status(StatusResponse {
      ok: true,
      kind: results.kind.clone(),
      message: "".to_string()
    })
  end
  match semantic_wire_payload_of_results(operation.clone(), arg.clone(), &results, &session.snapshot)
  when Option::Some(payload) then semantic_v2_payload_of_wire(payload)
  when Option::None then
    SemanticResponseV2Payload::Rows(RowsResponse {
      kind: results.kind.clone(),
      rows: results.keys.clone()
    })
  end
end

def session_protocol_error_v2(request_id: Int, message: String) -> SemanticResponseV2
  SemanticResponseV2 {
    protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
    request_id: request_id,
    payload: SemanticResponseV2Payload::Status(StatusResponse {
      ok: false,
      kind: "protocol_error".to_string(),
      message: message
    })
  }
end

# Handle one typed v2 request: the version gate + the typed dispatch + the
# §38 routing (the SAME session_query_results v1 uses — the two protocols
# can never diverge on an operation's answer).
pub def session_handle_request_v2(session: CompilerSession, req: SemanticRequestV2) -> SemanticResponseV2
  if req.protocol_version != SEMANTIC_PROTOCOL_VERSION_V2 then
    return session_protocol_error_v2(req.request_id,
      "unsupported protocol_version " + req.protocol_version.to_string() +
      " (this server speaks v" + SEMANTIC_PROTOCOL_VERSION_V2.to_string() + ")")
  end
  match semantic_request_v2_dispatch(req.payload.clone())
  when Option::None then
    session_protocol_error_v2(req.request_id,
      "unresolvable v2 operation id or request-family mismatch")
  when Option::Some(parts) then
    let operation = parts.0.clone()
    let arg = parts.1.clone()
    let results = session_query_results(&session, operation.clone(), arg.clone())
    SemanticResponseV2 {
      protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
      request_id: req.request_id,
      payload: semantic_response_v2_of_results(&session, operation, arg, &results)
    }
  end
end

# The negotiated version probe: the first body word is a v2 version-word
# (same major) or the v1 version-field length. A frame too short to carry
# either fails closed.
pub def semantic_frame_protocol_version(bytes: Vec[u8]) -> Option[Int]
  if bytes.len() < 8 then
    return Option::None
  end
  let header = ((bytes[4] as Int) << 24) | ((bytes[5] as Int) << 16) |
    ((bytes[6] as Int) << 8) | (bytes[7] as Int)
  if (header >> 16) == SEMANTIC_V2_MAJOR then
    Option::Some(SEMANTIC_PROTOCOL_VERSION_V2)
  else
    Option::Some(1)
  end
end

# One negotiated frame in, one wire frame out: v1 requests take the v1
# parse/handle/frame path (byte-compatible with the existing protocol),
# v2 requests the typed path; each answer rides the version that was asked.
# Option::None on any strict-parse failure (the serve loop fails closed).
pub def session_handle_frame(session: CompilerSession, bytes: Vec[u8]) -> Option[Vec[u8]]
  match semantic_frame_protocol_version(bytes.clone())
  when Option::None then Option::None
  when Option::Some(2) then
    match semantic_request_v2_parse(bytes.clone())
    when Option::None then Option::None
    when Option::Some(req) then
      Option::Some(semantic_response_v2_frame(session_handle_request_v2(&session, req)))
    end
  when Option::Some(1) then
    match semantic_request_parse(bytes.clone())
    when Option::None then Option::None
    when Option::Some(req) then
      Option::Some(semantic_response_frame(session_handle_request(&session, req)))
    end
  when Option::Some(_) then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# The v2 typed-record equality (the lane's round-trip comparator)
# ———————————————————————————————————————————————————————————————
# Field-by-field record equality — the lane's "decode == typed record"
# check. Never a render comparison: every field of every variant is
# compared.

def semantic_operation_id_eq(a: SemanticOperationId, b: SemanticOperationId) -> Bool
  a.dense_id == b.dense_id && a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

def semantic_v2_package_eq(a: StablePackageId, b: StablePackageId) -> Bool
  a.key == b.key && a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

def semantic_v2_module_eq(a: StableModuleId, b: StableModuleId) -> Bool
  a.path == b.path && a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo &&
    semantic_v2_package_eq(a.package.clone(), b.package.clone())
end

def semantic_v2_lineage_eq(a: DeclLineageId, b: DeclLineageId) -> Bool
  a.lineage == b.lineage && a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo &&
    semantic_v2_package_eq(a.package.clone(), b.package.clone()) &&
    semantic_v2_module_eq(a.module.clone(), b.module.clone())
end

def semantic_decl_id_eq(a: StableDeclId, b: StableDeclId) -> Bool
  a.kind == b.kind && a.display_key == b.display_key &&
    a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo &&
    semantic_v2_package_eq(a.package.clone(), b.package.clone()) &&
    semantic_v2_module_eq(a.module.clone(), b.module.clone()) &&
    semantic_v2_lineage_eq(a.lineage.clone(), b.lineage.clone())
end

def semantic_place_id_eq(a: StablePlaceId, b: StablePlaceId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo &&
    stable_place_text_of(a) == stable_place_text_of(b)
end

def semantic_mir_stmt_id_eq(a: StableMirStmtId, b: StableMirStmtId) -> Bool
  a.dense_id == b.dense_id && a.stable_key == b.stable_key &&
    a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

def semantic_target_id_eq(a: SemanticTargetId, b: SemanticTargetId) -> Bool
  match a
  when SemanticTargetId::Decl(ad) then
    match b
    when SemanticTargetId::Decl(bd) then semantic_decl_id_eq(ad, bd)
    when _ then false
    end
  when SemanticTargetId::Place(ap) then
    match b
    when SemanticTargetId::Place(bp) then semantic_place_id_eq(ap, bp)
    when _ then false
    end
  when SemanticTargetId::MirStmt(ast) then
    match b
    when SemanticTargetId::MirStmt(bst) then semantic_mir_stmt_id_eq(ast, bst)
    when _ then false
    end
  end
end

def semantic_v2_opt_stmt_eq(a: Option[StableMirStmtId], b: Option[StableMirStmtId]) -> Bool
  match a
  when Option::Some(ast) then
    match b
    when Option::Some(bst) then semantic_mir_stmt_id_eq(ast, bst)
    when Option::None then false
    end
  when Option::None then
    match b
    when Option::None then true
    when Option::Some(_) then false
    end
  end
end

def semantic_slice_request_eq(a: MirSliceRequest, b: MirSliceRequest) -> Bool
  a.function_key == b.function_key && a.anchor == b.anchor &&
    v2_mir_slice_kind_code(a.kind.clone()) == v2_mir_slice_kind_code(b.kind.clone())
end

def semantic_request_v2_payload_eq(a: SemanticRequestV2Payload, b: SemanticRequestV2Payload) -> Bool
  match a
  when SemanticRequestV2Payload::Target(ao, ak, at) then
    match b
    when SemanticRequestV2Payload::Target(bo, bk, bt) then
      semantic_operation_id_eq(ao, bo) && ak == bk && semantic_target_id_eq(at, bt)
    when _ then false
    end
  when SemanticRequestV2Payload::MirGraph(ao, af, ad, aa, ar, an) then
    match b
    when SemanticRequestV2Payload::MirGraph(bo, bf, bd, ba, br, bn) then
      semantic_operation_id_eq(ao, bo) && af == bf && aa == ba && ar == br &&
        semantic_decl_id_eq(ad, bd) && semantic_v2_opt_stmt_eq(an, bn)
    when _ then false
    end
  when SemanticRequestV2Payload::Slice(ao, ar) then
    match b
    when SemanticRequestV2Payload::Slice(bo, br) then
      semantic_operation_id_eq(ao, bo) && semantic_slice_request_eq(ar, br)
    when _ then false
    end
  when SemanticRequestV2Payload::Text(ao, aa) then
    match b
    when SemanticRequestV2Payload::Text(bo, ba) then
      semantic_operation_id_eq(ao, bo) && aa == ba
    when _ then false
    end
  when SemanticRequestV2Payload::Service(ao) then
    match b
    when SemanticRequestV2Payload::Service(bo) then semantic_operation_id_eq(ao, bo)
    when _ then false
    end
  end
end

pub def semantic_request_v2_eq(a: SemanticRequestV2, b: SemanticRequestV2) -> Bool
  a.protocol_version == b.protocol_version && a.request_id == b.request_id &&
    semantic_request_v2_payload_eq(a.payload.clone(), b.payload.clone())
end

def semantic_v2_strings_eq(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def semantic_v2_callers_eq(a: CallersResponse, b: CallersResponse) -> Bool
  a.target == b.target && semantic_v2_strings_eq(a.callers.clone(), b.callers.clone())
end

def semantic_v2_callees_eq(a: CalleesResponse, b: CalleesResponse) -> Bool
  a.function == b.function && semantic_v2_strings_eq(a.callees.clone(), b.callees.clone())
end

def semantic_v2_symbols_eq(a: SymbolsResponse, b: SymbolsResponse) -> Bool
  a.query == b.query && semantic_v2_strings_eq(a.symbols.clone(), b.symbols.clone())
end

def semantic_v2_type_eq(a: TypeResponse, b: TypeResponse) -> Bool
  a.type_key == b.type_key && a.kind == b.kind && a.size == b.size &&
    a.alignment == b.alignment && semantic_v2_strings_eq(a.fields.clone(), b.fields.clone())
end

def semantic_v2_effects_eq(a: EffectsResponse, b: EffectsResponse) -> Bool
  a.function == b.function && a.bits == b.bits && a.purity == b.purity &&
    semantic_v2_strings_eq(a.capabilities.clone(), b.capabilities.clone())
end

def semantic_v2_ownership_eq(a: OwnershipResponse, b: OwnershipResponse) -> Bool
  a.function == b.function && semantic_v2_strings_eq(a.rows.clone(), b.rows.clone())
end

def semantic_v2_contract_eq(a: ContractResponse, b: ContractResponse) -> Bool
  a.contract_id == b.contract_id && a.kind == b.kind &&
    a.canonical_expression == b.canonical_expression &&
    a.fingerprint == b.fingerprint && a.message == b.message
end

def semantic_v2_mir_function_eq(a: MirFunctionResponse, b: MirFunctionResponse) -> Bool
  a.function == b.function && a.summary == b.summary
end

def semantic_v2_abi_eq(a: AbiResponse, b: AbiResponse) -> Bool
  a.surface_id == b.surface_id && semantic_v2_strings_eq(a.rows.clone(), b.rows.clone())
end

def semantic_v2_diagnostic_eq(a: DiagnosticResponse, b: DiagnosticResponse) -> Bool
  a.diagnostic_id == b.diagnostic_id && a.code == b.code && a.message == b.message &&
    semantic_v2_strings_eq(a.related.clone(), b.related.clone())
end

def semantic_v2_delta_eq(a: DeltaResponse, b: DeltaResponse) -> Bool
  semantic_v2_strings_eq(a.rows.clone(), b.rows.clone())
end

def semantic_v2_plan_eq(a: PlanResponse, b: PlanResponse) -> Bool
  semantic_v2_strings_eq(a.rows.clone(), b.rows.clone())
end

def semantic_v2_mir_slice_eq(a: MirSliceResponse, b: MirSliceResponse) -> Bool
  a.kind == b.kind && semantic_v2_strings_eq(a.statements.clone(), b.statements.clone()) &&
    semantic_v2_strings_eq(a.externals.clone(), b.externals.clone())
end

def semantic_v2_rows_eq(a: RowsResponse, b: RowsResponse) -> Bool
  a.kind == b.kind && semantic_v2_strings_eq(a.rows.clone(), b.rows.clone())
end

def semantic_v2_revision_eq(a: RevisionResponse, b: RevisionResponse) -> Bool
  a.revision_hi == b.revision_hi && a.revision_lo == b.revision_lo
end

def semantic_v2_status_eq(a: StatusResponse, b: StatusResponse) -> Bool
  a.ok == b.ok && a.kind == b.kind && a.message == b.message
end

def semantic_v2_explain_eq(a: ExplainNode, b: ExplainNode) -> Bool
  if a.kind != b.kind || a.subject != b.subject || a.relation != b.relation || a.fact != b.fact then
    return false
  end
  if a.children.len() != b.children.len() then
    return false
  end
  var i = 0
  while i < a.children.len() do
    if !semantic_v2_explain_eq(a.children[i].clone(), b.children[i].clone()) then
      return false
    end
    i = i + 1
  end
  true
end

def semantic_response_v2_payload_eq(a: SemanticResponseV2Payload, b: SemanticResponseV2Payload) -> Bool
  match a
  when SemanticResponseV2Payload::Callers(x) then
    match b
    when SemanticResponseV2Payload::Callers(y) then semantic_v2_callers_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Callees(x) then
    match b
    when SemanticResponseV2Payload::Callees(y) then semantic_v2_callees_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Symbols(x) then
    match b
    when SemanticResponseV2Payload::Symbols(y) then semantic_v2_symbols_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Type(x) then
    match b
    when SemanticResponseV2Payload::Type(y) then semantic_v2_type_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Effects(x) then
    match b
    when SemanticResponseV2Payload::Effects(y) then semantic_v2_effects_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Ownership(x) then
    match b
    when SemanticResponseV2Payload::Ownership(y) then semantic_v2_ownership_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Contract(x) then
    match b
    when SemanticResponseV2Payload::Contract(y) then semantic_v2_contract_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::MirFunction(x) then
    match b
    when SemanticResponseV2Payload::MirFunction(y) then semantic_v2_mir_function_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Abi(x) then
    match b
    when SemanticResponseV2Payload::Abi(y) then semantic_v2_abi_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Diagnostic(x) then
    match b
    when SemanticResponseV2Payload::Diagnostic(y) then semantic_v2_diagnostic_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Delta(x) then
    match b
    when SemanticResponseV2Payload::Delta(y) then semantic_v2_delta_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Plan(x) then
    match b
    when SemanticResponseV2Payload::Plan(y) then semantic_v2_plan_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::MirSlice(x) then
    match b
    when SemanticResponseV2Payload::MirSlice(y) then semantic_v2_mir_slice_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Explain(x) then
    match b
    when SemanticResponseV2Payload::Explain(y) then semantic_v2_explain_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Rows(x) then
    match b
    when SemanticResponseV2Payload::Rows(y) then semantic_v2_rows_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Revision(x) then
    match b
    when SemanticResponseV2Payload::Revision(y) then semantic_v2_revision_eq(x, y)
    when _ then false
    end
  when SemanticResponseV2Payload::Status(x) then
    match b
    when SemanticResponseV2Payload::Status(y) then semantic_v2_status_eq(x, y)
    when _ then false
    end
  end
end

pub def semantic_response_v2_eq(a: SemanticResponseV2, b: SemanticResponseV2) -> Bool
  a.protocol_version == b.protocol_version && a.request_id == b.request_id &&
    semantic_response_v2_payload_eq(a.payload.clone(), b.payload.clone())
end

# ———————————————————————————————————————————————————————————————
# The v2 executable lane (fourth-audit P0-11)
# ———————————————————————————————————————————————————————————————
# V2-1: EVERY registry operation, with a representative typed request:
# encode -> parse -> typed equality -> re-encode byte equality, then the
# real dispatch -> response encode -> parse -> typed equality ->
# re-encode, and the negotiated session_handle_frame entry produces the
# same bytes. V2-2: a place-targeted request (the StablePlaceId carrier).
# V2-3: unknown request AND response tags fail closed. V2-4: a v1 request
# still takes the v1 path through the negotiated entry. Empty result = the
# lane verifies.

def semantic_v2_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane-none".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def semantic_v2_lane_snapshot() -> SemanticSnapshot
  SemanticSnapshot {
    revision: StableDigest { hi: 0, lo: 0 },
    compiler_version: "v2-lane".to_string(),
    target: semantic_v2_lane_target(),
    public_api_hash: StableDigest { hi: 0, lo: 0 },
    abi_hash: StableDigest { hi: 0, lo: 0 },
    unsafe_hash: StableDigest { hi: 0, lo: 0 }
  }
end

def semantic_v2_lane_key() -> String
  "m::f#fn()->unit".to_string()
end

# ONE representative typed request per registry operation (the handler
# family word drives the variant; the arg fixtures are the canonical key
# spellings the ops document).
def semantic_v2_request_for_operation(op: ServerOperation, request_id: Int) -> Option[SemanticRequestV2]
  match semantic_operation_id_of(op.name.clone())
  when Option::None then Option::None
  when Option::Some(id) then
    let key = semantic_v2_lane_key()
    let decl = stable_decl_of_key(key.clone())
    let stmt = stable_mir_stmt_of_key("f#B0#S0".to_string())
    let payload = match op.handler_kind.clone()
    when "index" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "type" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "symbol" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "contract" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "ownership" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "explain" then
      SemanticRequestV2Payload::Target(id.clone(), key.clone(), SemanticTargetId::Decl(decl.clone()))
    when "mir" then
      if op.name == "mir_slice" then
        SemanticRequestV2Payload::Slice(id.clone(), MirSliceRequest {
          function_key: "f".to_string(),
          kind: MirSliceKind::BackwardDataflow,
          anchor: "".to_string()
        })
      elsif op.name == "mir.path" || op.name == "mir.reaching" then
        SemanticRequestV2Payload::MirGraph(id.clone(), "f".to_string(),
          stable_decl_of_key("f".to_string()), "".to_string(), "".to_string(), stmt.clone())
      elsif op.name == "mir.block" then
        SemanticRequestV2Payload::MirGraph(id.clone(), "f".to_string(),
          stable_decl_of_key("f".to_string()), "f#B0".to_string(), "".to_string(), Option::None)
      elsif op.name == "mir.diff" then
        SemanticRequestV2Payload::MirGraph(id.clone(), "f".to_string(),
          stable_decl_of_key("f".to_string()), "".to_string(), "g".to_string(), Option::None)
      else
        SemanticRequestV2Payload::MirGraph(id.clone(), "f".to_string(),
          stable_decl_of_key("f".to_string()), "".to_string(), "".to_string(), Option::None)
      end
    when "snapshot" then
      SemanticRequestV2Payload::Text(id.clone(), "".to_string())
    when "diagnostic" then
      SemanticRequestV2Payload::Text(id.clone(), "d0".to_string())
    when "plan" then
      SemanticRequestV2Payload::Text(id.clone(), "".to_string())
    when "replay" then
      SemanticRequestV2Payload::Text(id.clone(), "seq:0".to_string())
    when "edit" then
      SemanticRequestV2Payload::Text(id.clone(), "rename\nold\nnew".to_string())
    when "service" then
      SemanticRequestV2Payload::Service(id.clone())
    when _ then
      SemanticRequestV2Payload::Text(id.clone(), "".to_string())
    end
    Option::Some(SemanticRequestV2 {
      protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
      request_id: request_id,
      payload: payload
    })
  end
end

# Overwrite the tagged payload word of a v2 frame (frame offset 16..20:
# the 4-byte body length, the 4-byte version word and the 8-byte request
# id precede it). Used by the lane to inject an unknown tag.
def v2_lane_patch_tag(inout frame: Vec[u8], tag: Int) -> Unit
  frame[16] = ((tag >> 24) & 0xFF) as u8
  frame[17] = ((tag >> 16) & 0xFF) as u8
  frame[18] = ((tag >> 8) & 0xFF) as u8
  frame[19] = (tag & 0xFF) as u8
end

# One direct request-variant byte round trip (encode -> parse -> typed
# equality -> re-encode byte equality).
def semantic_v2_request_case(label: String, payload: SemanticRequestV2Payload, inout bad: Vec[String]) -> Unit
  let request = SemanticRequestV2 {
    protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
    request_id: 101,
    payload: payload
  }
  let frame = semantic_request_v2_frame(request.clone())
  match semantic_request_v2_parse(frame.clone())
  when Option::None then
    bad.push(label + ": v2 request parse failed")
  when Option::Some(back) then
    if !semantic_request_v2_eq(request.clone(), back.clone()) then
      bad.push(label + ": v2 request typed mismatch")
    end
    if !v2_bytes_eq(semantic_request_v2_frame(back), frame.clone()) then
      bad.push(label + ": v2 request re-encode mismatch")
    end
  end
end

# One direct response-variant byte round trip.
def semantic_v2_response_case(label: String, payload: SemanticResponseV2Payload, inout bad: Vec[String]) -> Unit
  let response = SemanticResponseV2 {
    protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
    request_id: 102,
    payload: payload
  }
  let frame = semantic_response_v2_frame(response.clone())
  match semantic_response_v2_parse(frame.clone())
  when Option::None then
    bad.push(label + ": v2 response parse failed")
  when Option::Some(back) then
    if !semantic_response_v2_eq(response.clone(), back.clone()) then
      bad.push(label + ": v2 response typed mismatch")
    end
    if !v2_bytes_eq(semantic_response_v2_frame(back), frame.clone()) then
      bad.push(label + ": v2 response re-encode mismatch")
    end
  end
end

pub def semantic_v2_lane_check() -> Vec[String]
  var bad: Vec[String] = Vec::new()
  let session = new_compiler_session(semantic_v2_lane_snapshot())
  var index = 0
  for op in server_operations() do
    let label = op.name.clone()
    match semantic_v2_request_for_operation(op.clone(), index + 1)
    when Option::None then
      bad.push(label + ": no typed operation id")
    when Option::Some(request) then
      let frame = semantic_request_v2_frame(request.clone())
      match semantic_request_v2_parse(frame.clone())
      when Option::None then
        bad.push(label + ": v2 request parse failed")
      when Option::Some(back) then
        if !semantic_request_v2_eq(request.clone(), back.clone()) then
          bad.push(label + ": v2 request typed mismatch")
        end
        if !v2_bytes_eq(semantic_request_v2_frame(back), frame.clone()) then
          bad.push(label + ": v2 request re-encode mismatch")
        end
      end
      let response = session_handle_request_v2(&session, request.clone())
      match response.payload.clone()
      when SemanticResponseV2Payload::Status(status) then
        if status.kind == "protocol_error" then
          bad.push(label + ": v2 dispatch rejected a registry op")
        end
      when _ then ()
      end
      let response_frame = semantic_response_v2_frame(response.clone())
      match semantic_response_v2_parse(response_frame.clone())
      when Option::None then
        bad.push(label + ": v2 response parse failed")
      when Option::Some(response_back) then
        if !semantic_response_v2_eq(response.clone(), response_back.clone()) then
          bad.push(label + ": v2 response typed mismatch")
        end
        if !v2_bytes_eq(semantic_response_v2_frame(response_back), response_frame.clone()) then
          bad.push(label + ": v2 response re-encode mismatch")
        end
      end
      match session_handle_frame(&session, semantic_request_v2_frame(request.clone()))
      when Option::None then
        bad.push(label + ": negotiated v2 frame failed")
      when Option::Some(negotiated) then
        if !v2_bytes_eq(negotiated, response_frame.clone()) then
          bad.push(label + ": negotiated v2 bytes differ")
        end
      end
    end
    index = index + 1
  end

  # V2-2 — the StablePlaceId carrier rides a target request.
  match stable_place_of_text("x.f".to_string())
  when Option::Some(place) then
    match semantic_operation_id_of("ownership.moves".to_string())
    when Option::Some(operation) then
      let request = SemanticRequestV2 {
        protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
        request_id: 91,
        payload: SemanticRequestV2Payload::Target(
          operation, semantic_v2_lane_key(), SemanticTargetId::Place(place))
      }
      let frame = semantic_request_v2_frame(request.clone())
      match semantic_request_v2_parse(frame.clone())
      when Option::None then
        bad.push("place-target: v2 request parse failed")
      when Option::Some(back) then
        if !semantic_request_v2_eq(request.clone(), back.clone()) then
          bad.push("place-target: v2 request typed mismatch")
        end
      end
      let response = session_handle_request_v2(&session, request)
      match response.payload.clone()
      when SemanticResponseV2Payload::Ownership(_) then ()
      when _ then bad.push("place-target: expected the Ownership family answer")
      end
    when Option::None then bad.push("place-target: ownership.moves is not registered")
    end
  when Option::None then bad.push("place-target: place fixture failed to parse")
  end

  # V2-3 — unknown tags fail closed (request and response).
  match semantic_operation_id_of("revision".to_string())
  when Option::Some(operation) then
    let request = SemanticRequestV2 {
      protocol_version: SEMANTIC_PROTOCOL_VERSION_V2,
      request_id: 77,
      payload: SemanticRequestV2Payload::Service(operation)
    }
    var request_frame = semantic_request_v2_frame(request.clone())
    v2_lane_patch_tag(&mut request_frame, 0xDEAD)
    match semantic_request_v2_parse(request_frame)
    when Option::None then ()
    when Option::Some(_) then bad.push("unknown request tag must fail closed")
    end
    let response = session_handle_request_v2(&session, request)
    var response_frame = semantic_response_v2_frame(response)
    v2_lane_patch_tag(&mut response_frame, 0xDEAD)
    match semantic_response_v2_parse(response_frame)
    when Option::None then ()
    when Option::Some(_) then bad.push("unknown response tag must fail closed")
    end
  when Option::None then bad.push("unknown-tag: revision is not registered")
  end

  # V2-4 — a v1 request still takes the v1 path (direct + negotiated).
  let v1_request = SemanticRequest {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: 7,
    operation: "revision".to_string(),
    payload: "".to_string()
  }
  let v1_frame = semantic_request_frame(v1_request)
  match semantic_request_parse(v1_frame.clone())
  when Option::None then bad.push("v1 compat: v1 request parse failed")
  when Option::Some(v1_request_back) then
    let v1_response = session_handle_request(&session, v1_request_back)
    if !v1_response.ok || v1_response.kind != "revision" then
      bad.push("v1 compat: direct v1 answer changed")
    end
  end
  match session_handle_frame(&session, v1_frame.clone())
  when Option::None then bad.push("v1 compat: negotiated v1 frame failed")
  when Option::Some(v1_response_frame) then
    match semantic_response_parse(v1_response_frame)
    when Option::None then bad.push("v1 compat: v1 response parse failed")
    when Option::Some(v1_response) then
      if !v1_response.ok || v1_response.kind != "revision" then
        bad.push("v1 compat: negotiated v1 answer changed")
      end
    end
  end

  # V2-5 — EVERY response variant through actual bytes with adversarial
  # fields (the empty lane session answers several families unavailable,
  # so the record codecs are exercised directly as well) + the remaining
  # request variants (Target MirStmt).
  semantic_v2_request_case("request-target-mirstmt".to_string(),
    SemanticRequestV2Payload::Target(
      semantic_operation_id_of("symbol_get".to_string()).unwrap_or(
        SemanticOperationId { dense_id: 11, digest_hi: 0, digest_lo: 0 }),
      semantic_v2_lane_key(),
      SemanticTargetId::MirStmt(stable_mir_stmt_of_key("f#B0#S0".to_string()).unwrap_or(
        StableMirStmtId { dense_id: -1, stable_key: "f#B0#S0".to_string() }))),
    &mut bad)

  semantic_v2_response_case("callers".to_string(),
    SemanticResponseV2Payload::Callers(CallersResponse {
      target: "t|1".to_string(),
      callers: Vec::from(["a:b".to_string(), "".to_string()])
    }), &mut bad)
  semantic_v2_response_case("callees".to_string(),
    SemanticResponseV2Payload::Callees(CalleesResponse {
      function: "".to_string(),
      callees: Vec::from(["c1".to_string()])
    }), &mut bad)
  semantic_v2_response_case("symbols".to_string(),
    SemanticResponseV2Payload::Symbols(SymbolsResponse {
      query: "q:x".to_string(),
      symbols: Vec::new()
    }), &mut bad)
  semantic_v2_response_case("type".to_string(),
    SemanticResponseV2Payload::Type(TypeResponse {
      type_key: "m::T".to_string(),
      kind: "struct".to_string(),
      size: -7,
      alignment: 16,
      fields: Vec::from(["f|g".to_string()])
    }), &mut bad)
  semantic_v2_response_case("effects".to_string(),
    SemanticResponseV2Payload::Effects(EffectsResponse {
      function: "f|x".to_string(),
      bits: -1,
      capabilities: Vec::from(["io".to_string()]),
      purity: "".to_string()
    }), &mut bad)
  semantic_v2_response_case("ownership".to_string(),
    SemanticResponseV2Payload::Ownership(OwnershipResponse {
      function: "f|p".to_string(),
      rows: Vec::from(["let:x|sink".to_string()])
    }), &mut bad)
  semantic_v2_response_case("contract".to_string(),
    SemanticResponseV2Payload::Contract(ContractResponse {
      contract_id: "f|Pre|a || b".to_string(),
      kind: "Pre".to_string(),
      canonical_expression: "a || b".to_string(),
      fingerprint: "hi:lo".to_string(),
      message: "m:1|2".to_string()
    }), &mut bad)
  semantic_v2_response_case("mir_function".to_string(),
    SemanticResponseV2Payload::MirFunction(MirFunctionResponse {
      function: "f".to_string(),
      summary: "s|1".to_string()
    }), &mut bad)
  semantic_v2_response_case("abi".to_string(),
    SemanticResponseV2Payload::Abi(AbiResponse {
      surface_id: "abi:x".to_string(),
      rows: Vec::from(["arg:0".to_string()])
    }), &mut bad)
  semantic_v2_response_case("diagnostic".to_string(),
    SemanticResponseV2Payload::Diagnostic(DiagnosticResponse {
      diagnostic_id: "f|diagnostic|E0201|place|3:x|#0".to_string(),
      code: "E0201".to_string(),
      message: "use: moved".to_string(),
      related: Vec::from(["state_before:consumed".to_string()])
    }), &mut bad)
  semantic_v2_response_case("delta".to_string(),
    SemanticResponseV2Payload::Delta(DeltaResponse {
      rows: Vec::from(["created:a:b".to_string(), "modified:c".to_string()])
    }), &mut bad)
  semantic_v2_response_case("plan".to_string(),
    SemanticResponseV2Payload::Plan(PlanResponse {
      rows: Vec::from(["verify|1".to_string()])
    }), &mut bad)
  semantic_v2_response_case("mir_slice".to_string(),
    SemanticResponseV2Payload::MirSlice(MirSliceResponse {
      kind: "mir_slice_unavailable".to_string(),
      statements: Vec::from(["a|b".to_string()]),
      externals: Vec::new()
    }), &mut bad)
  semantic_v2_response_case("explain".to_string(),
    SemanticResponseV2Payload::Explain(explain_node_child(
      explain_text_node("k".to_string(), "s:1".to_string()),
      explain_text_node("c".to_string(), "d|2".to_string()))), &mut bad)
  semantic_v2_response_case("rows".to_string(),
    SemanticResponseV2Payload::Rows(RowsResponse {
      kind: "fields".to_string(),
      rows: Vec::from(["x|y".to_string(), "".to_string()])
    }), &mut bad)
  semantic_v2_response_case("revision".to_string(),
    SemanticResponseV2Payload::Revision(RevisionResponse {
      revision_hi: 7,
      revision_lo: 9
    }), &mut bad)
  semantic_v2_response_case("status".to_string(),
    SemanticResponseV2Payload::Status(StatusResponse {
      ok: false,
      kind: "protocol_error".to_string(),
      message: "m|1:2".to_string()
    }), &mut bad)

  bad
end

# ———————————————————————————————————————————————————————————————
# The typed wire render/parse seam (third-audit item 22)
# ———————————————————————————————————————————————————————————————
# ONE canonical renderer per record family (wire_render_*) and its strict
# inverse (wire_parse_*). Canonical grammar: every row is "<tag>:<value>",
# the FIRST ':' separating tag from value (values keep later ':'); scalar
# fields always render (an empty value renders "<tag>:"), list fields
# render one row per element. Parsers fail closed (Option::None) on a
# malformed row, an unknown tag, a non-numeric Int field or a missing
# mandatory scalar. The family's rows ARE the record's wire form — the
# dispatch serializes the typed record through semantic_wire_payload_render
# into the response keys (see session_results_response above), and
# semantic_wire_payload_parse decodes a render back into the typed record
# (the server's own tests + typed clients).

def server_wire_split_row(row: String) -> Option[(String, String)]
  var at = -1
  var i = 0
  while i < row.len() do
    if row.slice(i, i + 1) == ":" then
      at = i
      break
    end
    i = i + 1
  end
  if at < 0 then
    return Option::None
  end
  Option::Some((row.slice(0, at), row.slice(at + 1, row.len())))
end

pub def wire_render_callers(record: CallersResponse) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("target:" + record.target.clone())
  for c in record.callers do
    rows.push("caller:" + c.clone())
  end
  rows
end

pub def wire_parse_callers(rows: Vec[String]) -> Option[CallersResponse]
  var target = ""
  var have_target = false
  var callers: Vec[String] = Vec::new()
  for row in rows do
    match server_wire_split_row(row.clone())
    when Option::None then return Option::None
    when Option::Some(parts) then
      if parts.0 == "target" then
        target = parts.1.clone()
        have_target = true
      elsif parts.0 == "caller" then
        callers.push(parts.1.clone())
      else
        return Option::None
      end
    end
  end
  if !have_target then
    return Option::None
  end
  Option::Some(CallersResponse { target: target, callers: callers })
end

