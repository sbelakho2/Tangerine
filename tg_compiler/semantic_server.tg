# The ONE render dispatcher: every family's canonical rows.
pub def semantic_wire_payload_render(payload: SemanticWirePayload) -> Vec[String]
  match payload
  when SemanticWirePayload::Callers(record) then wire_render_callers(record)
  when SemanticWirePayload::Callees(record) then wire_render_callees(record)
  when SemanticWirePayload::Symbols(record) then wire_render_symbols(record)
  when SemanticWirePayload::Type(record) then wire_render_type(record)
  when SemanticWirePayload::Effects(record) then wire_render_effects(record)
  when SemanticWirePayload::Ownership(record) then wire_render_ownership(record)
  when SemanticWirePayload::Contract(record) then wire_render_contract(record)
  when SemanticWirePayload::MirFunction(record) then wire_render_mir_function(record)
  when SemanticWirePayload::Abi(record) then wire_render_abi(record)
  when SemanticWirePayload::Diagnostic(record) then wire_render_diagnostic(record)
  when SemanticWirePayload::Delta(record) then wire_render_delta(record)
  when SemanticWirePayload::Plan(record) then wire_render_plan(record)
  end
end

# The ONE parse dispatcher: the family's canonical kind (the documented
# operation spellings included) -> the typed record; Option::None for an
# unknown kind or a strict-parse failure.
pub def semantic_wire_payload_parse(kind: String, rows: Vec[String]) -> Option[SemanticWirePayload]
  match kind
  when "callers" then
    match wire_parse_callers(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Callers(record))
    when Option::None then Option::None
    end
  when "callees" then
    match wire_parse_callees(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Callees(record))
    when Option::None then Option::None
    end
  when "symbols" then
    match wire_parse_symbols(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Symbols(record))
    when Option::None then Option::None
    end
  when "symbol_get" then
    match wire_parse_symbols(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Symbols(record))
    when Option::None then Option::None
    end
  when "symbol_search" then
    match wire_parse_symbols(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Symbols(record))
    when Option::None then Option::None
    end
  when "types" then
    match wire_parse_type(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Type(record))
    when Option::None then Option::None
    end
  when "type.get" then
    match wire_parse_type(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Type(record))
    when Option::None then Option::None
    end
  when "type.layout" then
    match wire_parse_type(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Type(record))
    when Option::None then Option::None
    end
  when "fields" then
    match wire_parse_type(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Type(record))
    when Option::None then Option::None
    end
  when "effects" then
    match wire_parse_effects(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Effects(record))
    when Option::None then Option::None
    end
  when "capabilities" then
    match wire_parse_effects(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Effects(record))
    when Option::None then Option::None
    end
  when "ownership" then
    match wire_parse_ownership(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Ownership(record))
    when Option::None then Option::None
    end
  when "ownership_explain" then
    match wire_parse_ownership(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Ownership(record))
    when Option::None then Option::None
    end
  when "ownership.moves" then
    match wire_parse_ownership(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Ownership(record))
    when Option::None then Option::None
    end
  when "ownership.drop_plan" then
    match wire_parse_ownership(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Ownership(record))
    when Option::None then Option::None
    end
  when "contracts" then
    match wire_parse_contract(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Contract(record))
    when Option::None then Option::None
    end
  when "contract_list" then
    match wire_parse_contract(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Contract(record))
    when Option::None then Option::None
    end
  when "contract.obligations" then
    match wire_parse_contract(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Contract(record))
    when Option::None then Option::None
    end
  when "mir_function" then
    match wire_parse_mir_function(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::MirFunction(record))
    when Option::None then Option::None
    end
  when "abi_inspect" then
    match wire_parse_abi(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Abi(record))
    when Option::None then Option::None
    end
  when "diagnostic.get" then
    match wire_parse_diagnostic(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Diagnostic(record))
    when Option::None then Option::None
    end
  when "semantic_diff" then
    match wire_parse_delta(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Delta(record))
    when Option::None then Option::None
    end
  when "snapshot.diff" then
    match wire_parse_delta(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Delta(record))
    when Option::None then Option::None
    end
  when "build.plan" then
    match wire_parse_plan(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Plan(record))
    when Option::None then Option::None
    end
  when "verify.plan" then
    match wire_parse_plan(rows.clone())
    when Option::Some(record) then Option::Some(SemanticWirePayload::Plan(record))
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# The typed-wire lane (third-audit item 22 executable rows)
# ———————————————————————————————————————————————————————————————
# W1: build each record family with adversarial values (embedded ':',
# empty strings, empty lists, negative/zero Ints), render, parse back,
# re-render and compare byte-for-byte. W2: strict-parse rejections
# (missing mandatory scalar, unknown kind, non-numeric Int). Empty result
# = the lane verifies.

def server_wire_lane_case(
  label: String, kind: String, payload: SemanticWirePayload, inout bad: Vec[String]
) -> Unit
  let rows = semantic_wire_payload_render(payload.clone())
  match semantic_wire_payload_parse(kind.clone(), rows.clone())
  when Option::None then
    bad.push(label + ": parse failed")
    ()
  when Option::Some(back) then
    let rows2 = semantic_wire_payload_render(back)
    if rows.len() != rows2.len() then
      bad.push(label + ": re-render row count " + rows2.len().to_string() +
        " != " + rows.len().to_string())
    else
      var i = 0
      while i < rows.len() do
        if rows[i] != rows2[i] then
          bad.push(label + ": re-render row " + i.to_string() + " mismatch")
        end
        i = i + 1
      end
    end
  end
end

pub def semantic_wire_lane_check() -> Vec[String]
  var bad: Vec[String] = Vec::new()

  server_wire_lane_case("callers".to_string(), "callers".to_string(),
    SemanticWirePayload::Callers(CallersResponse {
      target: "m::f#fn()->unit".to_string(),
      callers: Vec::from([
        "m::g#fn()->unit".to_string(),
        "m::h#fn(x:weird:type)->unit".to_string()
      ])
    }), &mut bad)

  server_wire_lane_case("callees".to_string(), "callees".to_string(),
    SemanticWirePayload::Callees(CalleesResponse {
      function: "a:b".to_string(),
      callees: Vec::from(["".to_string(), "c1".to_string()])
    }), &mut bad)

  server_wire_lane_case("symbols".to_string(), "symbol_search".to_string(),
    SemanticWirePayload::Symbols(SymbolsResponse {
      query: "needle:x".to_string(),
      symbols: Vec::new()
    }), &mut bad)

  server_wire_lane_case("type".to_string(), "type.get".to_string(),
    SemanticWirePayload::Type(TypeResponse {
      type_key: "T:x".to_string(),
      kind: "Struct".to_string(),
      size: 0,
      alignment: 16,
      fields: Vec::from(["f1".to_string(), "f:2".to_string()])
    }), &mut bad)

  server_wire_lane_case("effects".to_string(), "effects".to_string(),
    SemanticWirePayload::Effects(EffectsResponse {
      function: "m::f#fn()->unit".to_string(),
      bits: 7,
      capabilities: Vec::from(["cap.a".to_string(), "cap:b".to_string()]),
      purity: "Impure".to_string()
    }), &mut bad)

  server_wire_lane_case("ownership".to_string(), "ownership.moves".to_string(),
    SemanticWirePayload::Ownership(OwnershipResponse {
      function: "m::f#fn()->unit".to_string(),
      rows: Vec::from(["f|p|sink".to_string(), "f|q|let:x".to_string()])
    }), &mut bad)

  server_wire_lane_case("contract".to_string(), "contract.obligations".to_string(),
    SemanticWirePayload::Contract(ContractResponse {
      contract_id: "f|Pre|p(x)".to_string(),
      kind: "Pre".to_string(),
      fingerprint: "hi:lo".to_string(),
      message: "m:1|2".to_string()
    }), &mut bad)

  server_wire_lane_case("mir_function".to_string(), "mir_function".to_string(),
    SemanticWirePayload::MirFunction(MirFunctionResponse {
      function: "m::f#fn()->unit".to_string(),
      summary: "".to_string()
    }), &mut bad)

  server_wire_lane_case("abi".to_string(), "abi_inspect".to_string(),
    SemanticWirePayload::Abi(AbiResponse {
      surface_id: "abi:x".to_string(),
      rows: Vec::new()
    }), &mut bad)

  server_wire_lane_case("diagnostic".to_string(), "diagnostic.get".to_string(),
    SemanticWirePayload::Diagnostic(DiagnosticResponse {
      diagnostic_id: "f|diagnostic|E0201|place|3:x|#0".to_string(),
      code: "E0201".to_string(),
      message: "use: moved".to_string(),
      related: Vec::from([
        "state_before:consumed".to_string(),
        "operation:use".to_string()
      ])
    }), &mut bad)

  server_wire_lane_case("delta".to_string(), "semantic_diff".to_string(),
    SemanticWirePayload::Delta(DeltaResponse {
      rows: Vec::from(["created:a:b".to_string(), "modified:c".to_string()])
    }), &mut bad)

  server_wire_lane_case("plan".to_string(), "build.plan".to_string(),
    SemanticWirePayload::Plan(PlanResponse {
      rows: Vec::new()
    }), &mut bad)

  # W2 — strict parse rejections.
  match semantic_wire_payload_parse("callers".to_string(),
      Vec::from(["caller:m::g#fn()->unit".to_string()]))
  when Option::None then ()
  when Option::Some(_) then bad.push("callers: missing target must fail closed".to_string())
  end

  match semantic_wire_payload_parse("no.such.kind".to_string(), Vec::new())
  when Option::None then ()
  when Option::Some(_) then bad.push("unknown kind must fail closed".to_string())
  end

  match semantic_wire_payload_parse("type.get".to_string(), Vec::from([
      "type:x".to_string(),
      "kind:S".to_string(),
      "size:x".to_string(),
      "alignment:8".to_string()
    ]))
  when Option::None then ()
  when Option::Some(_) then bad.push("non-numeric size must fail closed".to_string())
  end

  bad
end

# ———————————————————————————————————————————————————————————————
# Debug helpers — JSONL for logs ONLY (never parsed); the json_escape
# shape rides semantic_model's semantic_json_escape.
# ———————————————————————————————————————————————————————————————

def server_json_keys_text(keys: Vec[String]) -> String
  var text = "[".to_string()
  var i = 0
  while i < keys.len() do
    if i > 0 then text = text + "," end
    text = text + "\"" + semantic_json_escape(&keys[i]) + "\""
    i = i + 1
  end
  text + "]"
end

# The human debug render of ONE typed payload (audit item 23 — human
# debug Strings only, never parsed, never on the wire): the JSON object
# value the response log line embeds under its "payload" key, keyed by the
# variant name. Rows render through server_json_keys_text (the same JSONL
# list shape as the response's "keys").
def payload_to_debug_text(p: SemanticResponsePayload) -> String
  match p
  when SemanticResponsePayload::Symbol(row_text) then
    "{\"Symbol\":{\"row_text\":\"" + semantic_json_escape(&row_text.clone()) + "\"}}"
  when SemanticResponsePayload::Symbols(rows) then
    "{\"Symbols\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Callers(rows) then
    "{\"Callers\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Callees(rows) then
    "{\"Callees\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Type(kind_word, rows) then
    "{\"Type\":{\"kind_word\":\"" + semantic_json_escape(&kind_word.clone()) +
      "\",\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Effects(bits, caps) then
    "{\"Effects\":{\"bits\":" + bits.to_string() + ",\"caps\":" +
      server_json_keys_text(caps.clone()) + "}}"
  when SemanticResponsePayload::Capabilities(rows) then
    "{\"Capabilities\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Ownership(rows) then
    "{\"Ownership\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::MirFunction(summary_text) then
    "{\"MirFunction\":{\"summary_text\":\"" + semantic_json_escape(&summary_text.clone()) + "\"}}"
  when SemanticResponsePayload::MirSlice(statements, externals) then
    "{\"MirSlice\":{\"statements\":" + server_json_keys_text(statements.clone()) +
      ",\"externals\":" + server_json_keys_text(externals.clone()) + "}}"
  when SemanticResponsePayload::Contract(rows) then
    "{\"Contract\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Delta(changed, rows) then
    "{\"Delta\":{\"changed\":" + server_json_keys_text(changed.clone()) +
      ",\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  when SemanticResponsePayload::Abi(rows) then
    "{\"Abi\":{\"rows\":" + server_json_keys_text(rows.clone()) + "}}"
  end
end

# The debug text of the response's Option payload slot: "null" when the
# response carries none (error/unknown/parsed responses).
def payload_option_debug_text(payload: Option[SemanticResponsePayload]) -> String
  match payload
  when Option::None then "null"
  when Option::Some(p) then payload_to_debug_text(p)
  end
end

# The debug render of the typed wire payload: the family's canonical rows
# as a JSON list (logs only — the wire is kind + keys, never this).
def wire_payload_option_debug_text(payload: Option[SemanticWirePayload]) -> String
  match payload
  when Option::None then "null"
  when Option::Some(p) then server_json_keys_text(semantic_wire_payload_render(p))
  end
end

pub def request_to_debug_string(req: SemanticRequest) -> String
  "{\"request\":{\"protocol_version\":" + req.protocol_version.to_string() +
    ",\"request_id\":" + req.request_id.to_string() +
    ",\"operation\":\"" + semantic_json_escape(&req.operation) +
    "\",\"payload\":\"" + semantic_json_escape(&req.payload) + "\"}}"
end

pub def response_to_debug_string(resp: SemanticResponse) -> String
  "{\"response\":{\"protocol_version\":" + resp.protocol_version.to_string() +
    ",\"request_id\":" + resp.request_id.to_string() +
    ",\"ok\":" + (if resp.ok then "true" else "false" end) +
    ",\"kind\":\"" + semantic_json_escape(&resp.kind) +
    "\",\"keys\":" + server_json_keys_text(resp.keys.clone()) +
    ",\"payload\":" + payload_option_debug_text(&resp.payload) +
    ",\"wire_payload\":" + wire_payload_option_debug_text(resp.wire_payload.clone()) +
    ",\"error\":\"" + semantic_json_escape(&resp.error) + "\"}}"
end

# ———————————————————————————————————————————————————————————————
# The serve loop — the §39 stdin/stdout request loop
# ———————————————————————————————————————————————————————————————
# session_serve_loop serves the request protocol of the module doc from
# stdin to stdout: ONE request frame per iteration (4-byte BIG-ENDIAN
# body length || body — the module doc's framing), handled through the
# VERSION-NEGOTIATED session_handle_frame (fourth-audit P0-11: a version-1
# body takes the v1 text-row parse + session_handle_request path, a
# version-2 body the typed v2 parse + session_handle_request_v2 path; the
# answer rides the version that was asked), the response written back with
# the same framing. The loop returns the number of requests served.
# Termination is fail closed: EOF on stdin, a negative,
# truncated or over-limit (MAX_FRAME_BYTES) frame length, a strict-parse
# failure of either grammar (the byte stream can no longer
# be trusted) or an IO error on either side ends the loop; no partial
# response is ever written. The loop is silent (no log lines on the
# wire); the caller (driver.tg's compile_snapshot_serve_route — the
# TANGERINE_SERVER=1 env route and the normal `tg server` command) prints
# its own status line AFTER the loop. The driver's LSP loop reads the
# same stdin fd only in its own command route, never concurrently.
pub def session_serve_loop(session: CompilerSession) -> Int
  var served = 0
  loop
    match server_read_stdin_exact(4)
    when Option::None then break
    when Option::Some(prefix) then
      let body_len = server_prefix_length(&prefix)
      # Audit item 25: the body length is untrusted input — refuse any
      # frame over MAX_FRAME_BYTES BEFORE server_read_stdin_exact
      # allocates a buffer of that size (fail closed, no giant alloc).
      if body_len < 0 || 4 + body_len > MAX_FRAME_BYTES then
        break
      end
      match server_read_stdin_exact(body_len)
      when Option::None then break
      when Option::Some(body) then
        var frame: Vec[u8] = Vec::new()
        var fi = 0
        while fi < prefix.len() do
          frame.push(prefix[fi])
          fi = fi + 1
        end
        var bi = 0
        while bi < body.len() do
          frame.push(body[bi])
          bi = bi + 1
        end
        # The negotiated entry (fourth-audit P0-11): a v1 request takes the
        # v1 parse/handle/frame path, a v2 request the typed path; each
        # answer rides the version that was asked. A strict-parse failure
        # of either grammar breaks the loop (fail closed, no partial
        # response, no resynchronization).
        match session_handle_frame(&session, frame)
        when Option::None then break
        when Option::Some(response_bytes) then
          if !server_write_stdout(response_bytes) then
            break
          end
          served = served + 1
        end
      end
    end
  end
  served
end

# Read exactly n bytes from stdin (fd 0) into a fresh buffer; Option::None
# on a negative length, an IO error or EOF before the extent is filled —
# fail closed, never a partial frame. Reads loop over raw_read with
# sub-views so a short pipe read never truncates a frame.
def server_read_stdin_exact(n: Int) -> Option[Vec[u8]]
  if n < 0 then
    return Option::None
  end
  var bytes = Vec[u8]::new()
  bytes.resize(n, 0)
  var done = 0
  while done < n do
    var view = bytes.as_mut_slice().sub(done, (n - done) as UInt)
    match std::fs::raw_read(0, view)
    when Result::Err(_) then return Option::None
    when Result::Ok(count) then
      if count as Int <= 0 then
        return Option::None
      end
      done = done + count as Int
    end
  end
  Option::Some(bytes)
end

# The 4-byte BIG-ENDIAN body length of a frame prefix (-1 when the prefix
# is not exactly 4 bytes — the caller fails closed).
def server_prefix_length(prefix: Vec[u8]) -> Int
  if prefix.len() != 4 then
    return -1
  end
  ((prefix[0] as Int) << 24) | ((prefix[1] as Int) << 16) |
    ((prefix[2] as Int) << 8) | (prefix[3] as Int)
end

# Write ONE complete frame to stdout (fd 1); false on an IO error or a
# short write (raw_write reports the bytes actually written) — the caller
# stops serving rather than desync the response stream.
def server_write_stdout(bytes: Vec[u8]) -> Bool
  let n = bytes.len() as UInt
  match std::fs::raw_write(1, &bytes, n)
  when Result::Ok(count) then count == n
  when Result::Err(_) then false
  end
end
