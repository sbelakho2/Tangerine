# Tangerine Compiler — Semantic Server Session (audit §39)
# Self-hosting compiler written in Tangerine
#
# The PERSISTENT semantic service: ONE CompilerSession holds the semantic
# state of a compilation — its content-addressed revision digest, the §29
# SemanticSnapshot and the §32 SemanticIndex built once from it — and
# answers a versioned, length-prefixed, STRUCTURED request protocol by
# routing through the §38 query ops. No second compiler model: the service
# never re-parses, re-type-checks or re-lowers; the snapshot is the model,
# the index is the O(1) read surface. The internal API stays typed
# (Session/Request/Response records + §38 QueryResults); JSON exists only
# as the *_to_debug_string log lines, never on the wire.
#
# SESSION STATE: revision = the compile revision the session serves (the
# snapshot's content-addressed digest — its .revision words when the
# writer finalized it, else semantic_snapshot_digest on construction);
# snapshot + index are the served tables (the §38 facade is constructed ON
# DEMAND via session_query — never embedded). The target Option slot holds
# the compilation's REAL TargetDesc record when the session was built at
# the pipeline boundary (compiler_session_from_finalized); the
# final_env / final_typed / final_mir Option slots carry the PIPELINE's
# finalized state, typed with the real values the §30 builder receives
# (TypeEnv / TypedProgram / verified MirProgram — types.tg / mir.tg
# records; nothing below imports this module, so no kernel/cycle issue).
# AUDIT ITEM 21: the DOCUMENTED HOOK GAP is closed — a driver-side hook
# (driver.tg's compile_snapshot_route, TANGERINE_SERVER=1) constructs the
# session at the successful final compiler boundary via
# compiler_session_from_finalized, which fills the target + final_* slots
# from the pipeline's real values after the final verify_mir; the
# MirProgram-holding session carries the finalized state the §33-slice /
# ABI / layout follow-ups consume (the §38/§39 mir_slice op routes the
# session's final_mir through semantic_slice.tg's typed §33 entry — see
# the request-routing section below).
#
# SERVE LOOP: session_serve_loop(session) serves the request protocol
# below from stdin to stdout (ONE request frame per iteration until EOF) —
# the loop entry the driver route calls when the env gate requests a
# server; it is documented in driver.tg's snapshot-route section.
#
# REQUEST PROTOCOL (versioned; framing binary, no length-prefix helper
# exists outside the driver's LSP Content-Length TEXT framing — driver.tg
# read_lsp_body — so §39 owns the 4-byte big-endian prefix documented here,
# in the backend_rv rv_w32 byte-order idiom):
#   frame := 4-byte BIG-ENDIAN body length || body; body = length-prefixed
#   UTF-8 fields ("4-byte BE length || text"): request: protocol_version,
#   request_id, operation, payload; response: protocol_version, request_id,
#   ok ("true"/"false"), kind, keys-count, keys..., error
#   Parsers are strict and fail closed (prefix/length disagreement,
#   truncated field, non-numeric int field, trailing bytes inside a body
#   or an over-limit length -> None). keys are sorted stable key texts;
#   for the twelve typed record families (third-audit item 22, below) the
#   keys are instead the record's canonical render (identity scalar rows
#   first, then the canonical list rows — the family renderer's fixed
#   order). request_id always echoes. The TYPED SemanticResponsePayload
#   (audit
#   item 23) NEVER rides the wire: it is the in-process typed answer of
#   the internal API — the framing above is unchanged, and a parsed
#   response carries payload = None (the payload is filled by the server
#   and consumed by in-process callers; the *_to_debug_string helpers
#   render it for logs).
#
# TYPED WIRE RESPONSES (third-audit item 22): the semantic content of a
# response is a TYPED RECORD — CallersResponse / CalleesResponse /
# SymbolsResponse / TypeResponse / EffectsResponse / OwnershipResponse /
# ContractResponse / MirFunctionResponse / AbiResponse / DiagnosticResponse
# / DeltaResponse / PlanResponse — wrapped by the SemanticWirePayload enum
# (the records + enum below). The wire keeps the kind + keys shape: the
# dispatch builds the record mechanically from the §38 QueryResults rows
# (semantic_wire_payload_of_results) and serializes it through the family's
# ONE canonical renderer (wire_render_* / semantic_wire_payload_render);
# the response carries the record in-process in SemanticResponse.
# wire_payload while the rendered rows ride the SAME kind + keys fields as
# before (so the framing, the limits and the response parser are
# untouched). The strict inverse (wire_parse_* /
# semantic_wire_payload_parse) decodes a render back into the record for
# the server's own tests and typed clients; the internal API is typed and
# the rows are the record's canonical render — never free-form prose.
#
# PROTOCOL V2 (fourth-audit P0-11): the typed tagged protocol — a version
# word + typed operation id + typed request record in, a typed response
# record out, with NO operation-name / payload text and NO kind + row text
# on the wire. The request enum (Target / MirGraph / Slice / Text /
# Service) carries StableDeclId / StablePlaceId / StableMirStmtId ids and
# the typed §33 MirSliceRequest; the response enum serializes every
# existing record family (the twelve SemanticWirePayload records + the
# MirSlice answer + the ExplainNode tree + a Rows record for the
# row-list-only ops + the revision digest words + the fail-closed status).
# The v2 section below documents the encoding, the limits it reuses
# (MAX_FRAME_BYTES / MAX_FIELD_BYTES / MAX_KEYS), the operation-id model
# (dense registry index + name digest; names stay debug strings) and the
# version policy (unknown same-major tags fail closed, never skipped).
# V1 remains available as the compatibility mode: the frame is shared and
# byte-compatible, semantic_frame_protocol_version negotiates, and a
# version-1 request keeps the old text-row request/response path.
# (Fourth-audit P0-12) ContractResponse is built from the ContractFact
# record — the id / kind / canonical expression / fingerprint / message
# are distinct fields; the canonical clause text may contain '|' and is
# never split.
#
#   §39 FRAMING LIMITS (audit item 25) — the request/response parsers
#   enforce the module constants below on EVERY frame, and every check
#   runs BEFORE the untrusted bytes drive an allocation (a field length is
#   validated against the remaining body before its text is sliced, the
#   response keys-count is validated before the keys vector exists, and
#   the serve loop refuses an over-limit length prefix before reading or
#   allocating the body). A violation is a strict-parse failure like any
#   other (None; the serve loop terminates, never desyncs).
#
#     limit            value   enforced on
#     MAX_FRAME_BYTES  16 MiB  the whole wire frame (the 4-byte BE length
#                              prefix + body): the parsers reject longer
#                              inputs up front; the serve loop rejects the
#                              length prefix before reading the body
#     MAX_FIELD_BYTES   1 MiB  each length-prefixed text field
#     MAX_KEYS         65536   the response keys-count (0 <= count)
#
# SESSION OPS: every served op is a row of the §39 operation registry
# (server_operations — name + handler family). The registry is the
# declared dispatch authority: session_query_results resolves the name
# FIRST (an unregistered name answers kind "unknown" exactly like §38's
# query()) and routes by the resolved handler_kind. The §38 facade
# families (index / explain / type / ownership / contract / symbol /
# snapshot / plan / diagnostic / replay) answer through semantic_query's
# query() over the session's snapshot + index + retained diagnostic store
# + evidence, so the §38 and §39 answers can never diverge. The residual
# server-only families are "mir" (mir_slice and the mir.* graph ops hand
# the accessors the session's final_mir so they answer the TYPED §33/§22
# results; the offline session forms — no program — keep the
# "<op>_unavailable" answer) and "service" ("revision", the ONE §39
# service op: the revision digest render, the client's freshness probe).
# A version mismatch fails closed with an ok=false "protocol_error"
# response.
#
# EXPLAIN / DIAGNOSTIC NOTES (audit items 52 + 23): the session RETAINS
# its diagnostics in the persistent DiagnosticStore (populated at the
# pipeline boundary from the compile's diagnostics and appendable via
# session_diagnostics_add), so diagnostic.get / diagnostic.explain /
# diagnostic.repair_context answer the store records; the remaining
# explain arms answer the snapshot/index rows of their trees (the
# explain() API's Option::None diagnostics form) — layout.explain and
# optimization.explain answer their honest "not available from snapshot
# rows" leaf. In-process callers holding the compile's diagnostics use
# the typed semantic_query::explain API directly to attach the
# diagnostic-derived branches (the §34 trace rows / typed
# DiagnosticSemanticData).
#
# REVISION LIFE-CYCLE: a source revision reaches the session as a NEW
# finalized snapshot; session_revise replaces it (full re-index is correct
# and cheap next to a compile). The §31 delta of the old/new sessions IS the
# invalidation unit: exactly delta.affected's keys may have changed answer
# rows — the service layer drops only those cached rows (invalidation
# GRANULARITY = delta.affected; per-key memo caches live at that layer).

use std::collections::{Vec}
use std::fs

use tg_compiler::ids::{StableDigest, stable_digest_of}
use tg_compiler::ast::{AstContractKind}
use tg_compiler::types::{TypeEnv, TypedProgram}
use tg_compiler::mir::{MirProgram}
use tg_compiler::target_desc::{TargetDesc}
use tg_compiler::parser::{Diagnostic}
use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticResponsePayload, ContractFact, StableTargetId,
  semantic_digest_render, semantic_json_escape, semantic_contract_expr_text
}
# (fourth-audit P0-11/P0-12) the typed stable identity records the v2
# request protocol carries (StableDeclId / StablePlaceId / StableMirStmtId)
# and the total builders the decoder verifies decoded ids with; the contract
# response is built from the ContractFact record, never a text split.
use tg_compiler::stable_ids::{
  StablePackageId, StableModuleId, DeclLineageId, StableDeclId, StablePlaceId,
  StableMirStmtId, stable_decl_of_key,
  stable_decl_identity_text_of, stable_package_id_of, stable_module_id_of,
  stable_decl_lineage_id_of, stable_mir_stmt_of_key, stable_place_of_text,
  stable_place_text_of
}
use tg_compiler::semantic_snapshot::{semantic_snapshot_digest, semantic_snapshot_parse}
use tg_compiler::semantic_delta::{SemanticDelta, semantic_delta_of, semantic_delta_empty, DeltaStatus}
use tg_compiler::semantic_index::{SemanticIndex, build_semantic_index}
use tg_compiler::semantic_query::{
  QueryResults, SemanticQuerySession, new_semantic_query_session, query,
  mir_slice, mir_graph_query, explain_tree
}
# (fourth-audit P0-11) the §33 typed slice request/kind the v2 Slice request
# variant carries.
use tg_compiler::semantic_slice::{MirSliceRequest, MirSliceKind}
# (third-audit items 23/24) the persistent diagnostic store the session
# retains + the stable diagnostic id the add surface returns.
# (fourth-audit P0-11) the typed ExplainNode tree the v2 Explain response
# variant serializes (the store-aware diagnostic.explain arm builds its
# record node).
use tg_compiler::semantic_diagnostics::{
  DiagnosticStore, StableDiagnosticId, new_diagnostic_store,
  diagnostic_store_add, diagnostic_store_add_all,
  ExplainNode, diagnostic_record_explain_node, store_match, store_len,
  explain_text_node, explain_node_child
}
# The §37 verification evidence (proof_patch.tg — audit item 20): the
# session's evidence slot carries the compilation's
# VerifiedCompilationEvidence record (the pipeline-boundary constructor's
# parameter; the offline forms leave it None) and the §37 span assembler
# below (session_proof_patch_between) consumes the OLD/NEW sessions'
# evidence slots with the §31 session delta — the proof-patch surface a
# future driver route calls. Imported here mirroring the driver.tg
# type-import idiom for full-library semantic modules.
use tg_compiler::proof_patch::{
  VerifiedCompilationEvidence, ProofCarryingPatch, proof_patch_between
}
use tg_compiler::change_budget::{ChangeBudget}

# ———————————————————————————————————————————————————————————————
# The §39 protocol records — version, session, request, response
# ———————————————————————————————————————————————————————————————
# Protocol_version 1 = the whole §39 grammar above; any other request
# version gets the fail-closed "protocol_error" response.

pub const SEMANTIC_PROTOCOL_VERSION: Int = 1

# The §39 framing limits (audit item 25) — the module doc's table says
# where each is enforced; every check precedes the allocation it caps,
# and a violation fails closed (None) exactly like a truncated field.
const MAX_FRAME_BYTES: Int = 16777216 # 16 MiB: 4-byte BE prefix + body
const MAX_FIELD_BYTES: Int = 1048576  # 1 MiB per length-prefixed text
const MAX_KEYS: Int = 65536           # response keys-count cap

# The persistent-service session. revision / snapshot / index are the
# served tables; target holds the compilation's REAL TargetDesc record
# (Option: the pipeline constructors fill it — compiler_session_from_
# finalized — while the offline-artifact forms leave it None: the §29
# snapshot itself carries only the StableTargetId projection). The
# final_env / final_typed / final_mir Option slots carry the PIPELINE's
# finalized state (TypeEnv / TypedProgram / the FINAL verified MirProgram
# — the values in scope at the successful final compiler boundary) for
# the §33-slice / ABI / layout follow-ups; the evidence Option slot
# carries the compilation's §37 VerifiedCompilationEvidence
# (proof_patch.tg — the stages the boundary's pipeline actually ran;
# None on the offline-artifact forms, which ran no pipeline); see the
# module doc's audit item 21 note and compiler_session_from_finalized
# below.
struct CompilerSession
  revision: StableDigest
  snapshot: SemanticSnapshot
  index: SemanticIndex
  target: Option[TargetDesc] = Option::None
  final_env: Option[TypeEnv] = Option::None
  final_typed: Option[TypedProgram] = Option::None
  final_mir: Option[MirProgram] = Option::None
  evidence: Option[VerifiedCompilationEvidence] = Option::None
  # (third-audit items 23/24) the retained persistent diagnostic store:
  # the session's diagnostics are projected into it (append-only, stable
  # ids) and the diagnostic.get / diagnostic.explain /
  # diagnostic.repair_context ops answer from it. The offline-artifact
  # constructors start it EMPTY (the field default); the pipeline-boundary
  # constructor populates it from the compile's diagnostics parameter and
  # session_diagnostics_add appends later.
  diagnostics_store: DiagnosticStore = new_diagnostic_store()
end

# ———————————————————————————————————————————————————————————————
# The TYPED WIRE RESPONSE RECORDS (third-audit item 22)
# ———————————————————————————————————————————————————————————————
# The typed server-side API of every served answer family: the target /
# caller / function / type / contract / diagnostic fields are STABLE ID
# TEXTS (the wire renders stable ids — never a display name), and the rows
# lists carry the canonical §31/§32 row texts. The canonical row render of
# each record family is defined once in the typed-wire section below
# (<tag>:<value> rows). SemanticWirePayload wraps the twelve records so
# ONE value carries any typed answer through the response record.
#
# PROJECTION NOTES (documented boundaries): the §32 type_layout_map is
# POPULATED — the index builder fills it from the snapshot's persisted ABI
# TYPE rows (semantic_index.tg build step 9 / index_abi_layout_text: each
# value is the layout engine's "size=<n>;align=<n>;fields=<...>" render,
# never fabricated) — and type.layout serves those rows; TypeResponse.size
# /alignment stay 0 only where the mapped operation's rows carry no layout
# row (types / type.get / fields); DiagnosticResponse is the
# typed projection of one retained store record (the id / code / message /
# related rows — the store's span / semantic-class spine rows stay
# reachable through diagnostic.explain); ContractResponse carries ONE
# clause, so the multi-row contract ops keep their §38 rows (the dispatch
# maps only the single-clause answer), and the record is built from the
# underlying ContractFact — never parsed out of the canonical clause text,
# which may contain '|' (fourth-audit P0-12); the purity.get status +
# ordered evidence sequence and the explain tree lines belong to no record
# family and keep their §38 rows.

pub struct CallersResponse
  target: String
  callers: Vec[String] = Vec::new()
end

pub struct CalleesResponse
  function: String
  callees: Vec[String] = Vec::new()
end

pub struct SymbolsResponse
  query: String
  symbols: Vec[String] = Vec::new()
end

pub struct TypeResponse
  type_key: String
  kind: String
  size: Int
  alignment: Int
  fields: Vec[String] = Vec::new()
end

pub struct EffectsResponse
  function: String
  bits: Int
  capabilities: Vec[String] = Vec::new()
  purity: String
end

pub struct OwnershipResponse
  function: String
  rows: Vec[String] = Vec::new()
end

# (fourth-audit P0-12) ContractResponse carries the ContractFact's four
# DISTINCT content fields: the stable clause id (the §31 row key text —
# "fn|kind|canonical"), the kind word, the canonical expression render, the
# expression fingerprint render and the declared message (Option::None
# renders ""). The canonical expression may itself contain '|' and is NEVER
# a field of contract_id after a text split; the record is built from the
# ContractFact row (contract_response_of_fact) or from its own wire render
# (wire_parse_contract) — never parsed out of a canonical row.
pub struct ContractResponse
  contract_id: String
  kind: String
  canonical_expression: String = ""
  fingerprint: String
  message: String
end

pub struct MirFunctionResponse
  function: String
  summary: String
end

pub struct AbiResponse
  surface_id: String
  rows: Vec[String] = Vec::new()
end

pub struct DiagnosticResponse
  diagnostic_id: String
  code: String
  message: String
  related: Vec[String] = Vec::new()
end

pub struct DeltaResponse
  rows: Vec[String] = Vec::new()
end

pub struct PlanResponse
  rows: Vec[String] = Vec::new()
end

pub enum SemanticWirePayload
  Callers(record: CallersResponse)
  Callees(record: CalleesResponse)
  Symbols(record: SymbolsResponse)
  Type(record: TypeResponse)
  Effects(record: EffectsResponse)
  Ownership(record: OwnershipResponse)
  Contract(record: ContractResponse)
  MirFunction(record: MirFunctionResponse)
  Abi(record: AbiResponse)
  Diagnostic(record: DiagnosticResponse)
  Delta(record: DeltaResponse)
  Plan(record: PlanResponse)
end

# One request: operation is a session-op name; payload = the arg key text.
struct SemanticRequest
  protocol_version: Int
  request_id: Int
  operation: String
  payload: String
end

# One response: ok + kind + sorted keys carry the §38 answer on the wire;
# payload (audit item 23) is the TYPED semantic answer the server routes
# from the §38 QueryResults — Option::None for error responses
# (protocol_error), for parsed responses (never serialized — see the
# module doc) and for the ops whose rows carry no payload family. error
# carries the fail-closed reason text (kind "protocol_error").
struct SemanticResponse
  protocol_version: Int
  request_id: Int
  ok: Bool
  kind: String
  keys: Vec[String] = Vec::new()
  payload: Option[SemanticResponsePayload] = Option::None
  # (third-audit item 22) the typed wire record whose canonical render IS
  # the keys field when the answer belongs to one of the twelve record
  # families; Option::None for error responses, parsed responses (the
  # frame never carries it — see the module doc) and the families with no
  # record (unknown / *_unavailable / explain trees / revision). Never a
  # second wire field: semantic_response_frame writes kind + keys only.
  wire_payload: Option[SemanticWirePayload] = Option::None
  error: String = ""
end

# ———————————————————————————————————————————————————————————————
# Session lifecycle — build, facade, revise, delta
# ———————————————————————————————————————————————————————————————

# Build a session over one snapshot: index ONCE, revision = the snapshot's
# digest (its own words when finalized). The OFFLINE-ARTIFACT form of the
# session (see snapshot_only_session): it serves a serialized §30 artifact
# and carries none of the pipeline's live state (target / final_* slots
# stay None — the §33/ABI follow-ups that need the real TargetDesc or the
# verified MirProgram require a session built at the compiler boundary via
# compiler_session_from_finalized).
pub def new_compiler_session(snapshot: SemanticSnapshot) -> CompilerSession
  var revision = semantic_snapshot_digest(&snapshot)
  if snapshot.revision.hi != 0 || snapshot.revision.lo != 0 then
    revision = snapshot.revision
  end
  CompilerSession {
    revision: revision,
    snapshot: snapshot,
    index: build_semantic_index(&snapshot),
    diagnostics_store: new_diagnostic_store()
  }
end

# The OFFLINE-ARTIFACT session constructor (audit item 21): the explicitly
# documented artifact form of new_compiler_session — ONE finalized §30
# SemanticSnapshot in (whatever the writer recorded: revision + the served
# tables), a session out. It never pretends to hold pipeline state: the
# target / final_env / final_typed / final_mir slots are None (documented
# above), so a snapshot_only_session serves the §38 snapshot+index ops and
# its mir_slice op answers "mir_slice_unavailable" (the adapter's
# program-less answer — see semantic_query.tg); it is the correct session
# for a server fed from snapshot FILES rather than from a live compile.
pub def snapshot_only_session(snapshot: SemanticSnapshot) -> CompilerSession
  new_compiler_session(snapshot)
end

# The OFFLINE-ARTIFACT session from a serialized snapshot TEXT (the
# deserializer lane): parse the artifact (semantic_snapshot_parse — the
# exact inverse of the serializer) and wrap the record in the artifact
# session form above. Result::Err carries the parser's fail-closed reason
# verbatim (line number, row tag, field). This is the ONE entry the driver
# (`tg server --snapshot-only --snapshot=<path>`) calls after reading the
# file: no pipeline state is constructed or implied.
pub def snapshot_session_from_text(text: String) -> Result[CompilerSession, String]
  match semantic_snapshot_parse(text)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(snapshot) then Result::Ok(snapshot_only_session(&snapshot))
  end
end

# The PIPELINE-BOUNDARY session constructor (audit item 21): the session
# built at the successful final compiler boundary — the exact values the
# compile pipeline has in scope after the FINAL verify (the driver's
# compile_snapshot_route: env = the analyzer's TypeEnv, typed = the typed
# program it returned, mir_program = the monomorphized + optimized +
# verified MirProgram, snapshot = the §30 SemanticSnapshot of that
# finalized state, index = the §32 index built from it). revision is the
# compile revision the session serves (the snapshot's content-addressed
# digest after semantic_snapshot_finalize — the driver passes
# snapshot.revision); target_desc is the compilation's REAL TargetDesc
# record (target_desc.tg — the desc the §30 builder stamped the
# snapshot's StableTargetId from). Every field of the session is filled:
# revision / snapshot / index, target := the descriptor, the three
# final_* slots := the pipeline values, and evidence := the compilation's
# §37 VerifiedCompilationEvidence (Option — the pipeline-boundary caller
# passes the evidence its stages established; the offline forms leave it
# None). The session then carries the finalized state (the final verified
# MirProgram included) that the §33-slice / ABI / layout follow-ups
# consume — the §38/§39 mir_slice op routes the final_mir through
# semantic_slice.tg's typed entry (see the request-routing section).
pub def compiler_session_from_finalized(
  revision: StableDigest,
  target_desc: TargetDesc,
  env: TypeEnv,
  typed: TypedProgram,
  mir_program: MirProgram,
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  evidence: Option[VerifiedCompilationEvidence] = Option::None,
  diagnostics: Vec[Diagnostic] = Vec::new()
) -> CompilerSession
  var store = new_diagnostic_store()
  diagnostic_store_add_all(&mut store, diagnostics)
  CompilerSession {
    revision: revision,
    snapshot: snapshot,
    index: index,
    target: Option::Some(target_desc),
    final_env: Option::Some(env),
    final_typed: Option::Some(typed),
    final_mir: Option::Some(mir_program),
    evidence: evidence,
    diagnostics_store: store
  }
end

# The §38 facade ON DEMAND — the same snapshot+index, never duplicated;
# (third-audit items 23/24) the session's retained diagnostic store and
# evidence ride the facade so the §38 query ops answer from the SAME
# state the §39 dispatch serves.
pub def session_query(session: CompilerSession) -> SemanticQuerySession
  new_semantic_query_session(session.snapshot, session.index,
    Option::Some(session.diagnostics_store.clone()), session.evidence.clone())
end

# (third-audit items 23/24) Append ONE diagnostic to the retained store —
# the store-side add surface for callers that hold the session and a
# diagnostic produced after the boundary (idempotent per content, stable
# ids; see semantic_diagnostics.tg).
pub def session_diagnostics_add(
  inout session: CompilerSession, diagnostic: Diagnostic
) -> StableDiagnosticId
  var store = session.diagnostics_store.clone()
  let id = diagnostic_store_add(&mut store, diagnostic)
  session.diagnostics_store = store
  id
end

pub def session_diagnostics_add_all(
  inout session: CompilerSession, diagnostics: Vec[Diagnostic]
) -> Vec[StableDiagnosticId]
  var store = session.diagnostics_store.clone()
  let ids = diagnostic_store_add_all(&mut store, diagnostics)
  session.diagnostics_store = store
  ids
end

pub def session_diagnostics_len(session: CompilerSession) -> Int
  session.diagnostics_store.by_id.len()
end

# The §31 delta of two sessions — the INVALIDATION UNIT of a revision:
# exactly delta.affected's def keys may have changed answer rows (equal
# revision digests short-circuit to the empty delta).
pub def session_delta(old: CompilerSession, new: CompilerSession) -> SemanticDelta
  if old.revision.hi == new.revision.hi && old.revision.lo == new.revision.lo then
    return semantic_delta_empty()
  end
  semantic_delta_of(&old.snapshot, &new.snapshot)
end

# (fourth-audit P0-18) The session delta STATUS: a pair of live sessions
# always carries two snapshots, so the status is Complete over the session
# delta. The Option form treats a MISSING old session (no snapshot to diff
# against) as Unavailable — never an empty delta that a budget could pass.
pub def session_delta_status(old: CompilerSession, new: CompilerSession) -> DeltaStatus
  DeltaStatus::Complete(session_delta(&old, &new))
end

pub def session_delta_status_of(old: Option[CompilerSession], new: CompilerSession) -> DeltaStatus
  match old
  when Option::None then
    DeltaStatus::Unavailable("missing old session snapshot: the session delta cannot be computed")
  when Option::Some(o) then
    DeltaStatus::Complete(session_delta(&o, &new))
  end
end

# Replace the session after a source revision (the layer diffs with
# session_delta and drops cached rows for delta.affected keys).
pub def session_revise(session: CompilerSession, new_snapshot: SemanticSnapshot) -> CompilerSession
  new_compiler_session(new_snapshot)
end

# The §37 SPAN PATCH of two sessions (audit item 20 — the proof-patch
# surface a future proof-patch route calls): given the OLD and NEW
# sessions of a change and ONE §36 ChangeBudget, produce the
# ProofCarryingPatch that proof_patch_between assembles from the pair's
# VerifiedCompilationEvidence slots with the pair's REAL §31 delta
# (session_delta — the diff the route computes between the two compiled
# states). Option::None when EITHER session carries no evidence slot (an
# offline-artifact session — new_compiler_session / snapshot_only_session
# — ran no pipeline, so no stage property of the span is claimable; the
# helper fails closed rather than assemble a patch from a missing side).
pub def session_proof_patch_between(
  old: CompilerSession,
  new: CompilerSession,
  budget: ChangeBudget
) -> Option[ProofCarryingPatch]
  match old.evidence
  when Option::None then Option::None
  when Option::Some(old_evidence) then
    match new.evidence
    when Option::None then Option::None
    when Option::Some(new_evidence) then
      Option::Some(proof_patch_between(
        &old_evidence, &new_evidence, &budget, Option::Some(session_delta(&old, &new))))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Request routing — the §38 session ops + the §39 service op
# ———————————————————————————————————————————————————————————————
# The op table is DECLARED by the §39 operation registry below; every
# registered family delegates to a §38 typed accessor (or, for the mir
# family, to the §33/§22 engines with the session's finalized program);
# "revision" is the one §39 service op. The mir family is the ONE family
# that deviates from §38's session-scoped query() in a documented way:
# this session carries the PIPELINE's finalized state, so the
# mir_slice arm hands semantic_query.mir_slice the session's final_mir
# (compiler_session_from_finalized's verified MirProgram — Option::None
# on the offline-artifact session forms, whose arm then answers
# "mir_slice_unavailable" exactly like §38's query()); with a program
# present the adapter routes the §33 typed engine and surfaces the typed
# MirSlice answer (see semantic_query.tg's mir_slice doc for the request
# grammar and the kind/payload mapping). The MIR GRAPH ops (third-audit
# item 20/22: mir.dominators / mir.postdominators / mir.loops /
# mir.control / mir.path / mir.reaching / mir.diff / mir.block) route the
# same way:
# semantic_query.mir_graph_query receives the session's final_mir and
# answers "<op>" rows or, without a program (the offline-artifact session
# forms), "<op>_unavailable" — documented in that module's mir_graph_query
# slot.
# The EXPLAIN arms (audit item 52) and the diagnostic.* ops route through
# the §38 facade family: ONE facade built on demand from the session's
# snapshot + index + retained store + evidence, then query() (the
# arm-level cost of one explain query; documented).
# The "revision" service answer (the digest render — the client's
# freshness probe). No §23 payload family is enumerated for the service
# op's digest row (semantic_model.tg's mapping table), so payload stays
# None and kind + keys are the whole answer.
def session_revision_results(session: CompilerSession) -> QueryResults
  var keys: Vec[String] = Vec::new()
  keys.push(semantic_digest_render(&session.revision))
  QueryResults { kind: "revision", keys: keys }
end

# ———————————————————————————————————————————————————————————————
# The §39 operation registry (third-audit item 23)
# ———————————————————————————————————————————————————————————————
# ONE declared table of every op the service serves: name + the handler
# family word (the routing class: index / mir / explain / snapshot /
# diagnostic / type / ownership / contract / symbol / plan / replay /
# service).
# server_operations is the DECLARED AUTHORITY of the dispatch:
# session_query_results resolves the name FIRST and answers kind
# "unknown" for an unregistered name, then routes by the resolved
# handler_kind. The new item-23 families (type / ownership / contract /
# symbol / snapshot / plan / diagnostic / replay) route through the §38
# facade — query() built on demand with the session's retained store +
# evidence — so the §38 and §39 answers can never diverge; the residual
# families keep their server-only route because they consume pipeline
# state the facade does not carry: mir / mir.* (the session's final_mir)
# and service (the revision digest render). The existing §38-owned
# families (index / explain) already route through the same facade path
# every new family uses, so this registry plus the single facade route is
# the whole convergence step; a later pass only needs to fold the residual
# mir/service handlers into ServerOperation rows with their own family
# words, leaving this resolver and route unchanged.
pub struct ServerOperation
  name: String
  handler_kind: String
end

def server_operation(name: String, handler_kind: String) -> ServerOperation
  ServerOperation { name: name, handler_kind: handler_kind }
end

pub def server_operations() -> Vec[ServerOperation]
  Vec::from([
    server_operation("callers".to_string(), "index".to_string()),
    server_operation("callees".to_string(), "index".to_string()),
    server_operation("types".to_string(), "index".to_string()),
    server_operation("effects".to_string(), "index".to_string()),
    server_operation("capabilities".to_string(), "index".to_string()),
    server_operation("purity.get".to_string(), "index".to_string()),
    server_operation("contracts".to_string(), "index".to_string()),
    server_operation("fields".to_string(), "index".to_string()),
    server_operation("impls".to_string(), "index".to_string()),
    server_operation("properties".to_string(), "index".to_string()),
    server_operation("mir_function".to_string(), "index".to_string()),
    server_operation("symbol_get".to_string(), "index".to_string()),
    server_operation("symbol_search".to_string(), "index".to_string()),
    server_operation("contract_list".to_string(), "index".to_string()),
    server_operation("type_explain".to_string(), "index".to_string()),
    server_operation("ownership_explain".to_string(), "index".to_string()),
    server_operation("mir_slice".to_string(), "mir".to_string()),
    server_operation("mir.dominators".to_string(), "mir".to_string()),
    server_operation("mir.postdominators".to_string(), "mir".to_string()),
    server_operation("mir.loops".to_string(), "mir".to_string()),
    server_operation("mir.control".to_string(), "mir".to_string()),
    server_operation("mir.path".to_string(), "mir".to_string()),
    server_operation("mir.reaching".to_string(), "mir".to_string()),
    server_operation("mir.diff".to_string(), "mir".to_string()),
    # (the tool-discovery sweep's registry gap) mir.block is dispatched by
    # §38 semantic_query.query() beside the seven graph ops above; the
    # registered "mir" family routes it to the same session final_mir
    # engine (mir_graph_query) as its siblings.
    server_operation("mir.block".to_string(), "mir".to_string()),
    server_operation("type.explain".to_string(), "explain".to_string()),
    server_operation("trait.resolve".to_string(), "explain".to_string()),
    server_operation("trait.explain".to_string(), "explain".to_string()),
    server_operation("ownership.explain".to_string(), "explain".to_string()),
    server_operation("effect.explain".to_string(), "explain".to_string()),
    server_operation("capability.explain".to_string(), "explain".to_string()),
    server_operation("layout.explain".to_string(), "explain".to_string()),
    server_operation("optimization.explain".to_string(), "explain".to_string()),
    server_operation("diagnostic.explain".to_string(), "explain".to_string()),
    server_operation("type.get".to_string(), "type".to_string()),
    server_operation("type.layout".to_string(), "type".to_string()),
    server_operation("type.properties".to_string(), "type".to_string()),
    server_operation("ownership.moves".to_string(), "ownership".to_string()),
    server_operation("ownership.drop_plan".to_string(), "ownership".to_string()),
    server_operation("contract.obligations".to_string(), "contract".to_string()),
    server_operation("contract.verify".to_string(), "contract".to_string()),
    server_operation("symbol.references".to_string(), "symbol".to_string()),
    # (third-audit item 34) the §40 coverage ops — routed through the §38
    # facade like the other index-family ops (test.affected /
    # coverage.affected answer from the session snapshot's ingested
    # coverage rows; "<op>_unavailable" without them).
    server_operation("test.affected".to_string(), "index".to_string()),
    server_operation("coverage.affected".to_string(), "index".to_string()),
    server_operation("snapshot.get".to_string(), "snapshot".to_string()),
    server_operation("snapshot.diff".to_string(), "snapshot".to_string()),
    # (third-audit item 30) the source-edit application op: source-in /
    # edited-source-out through the semantic edit engine (§38 edit.apply).
    server_operation("edit.apply".to_string(), "edit".to_string()),
    server_operation("build.plan".to_string(), "plan".to_string()),
    server_operation("verify.plan".to_string(), "plan".to_string()),
    server_operation("diagnostic.get".to_string(), "diagnostic".to_string()),
    server_operation("diagnostic.repair_context".to_string(), "diagnostic".to_string()),
    server_operation("replay.trace_rows".to_string(), "replay".to_string()),
    server_operation("replay.digest".to_string(), "replay".to_string()),
    server_operation("replay.writes_to".to_string(), "replay".to_string()),
    server_operation("replay.value_at".to_string(), "replay".to_string()),
    server_operation("replay.causal_predecessors".to_string(), "replay".to_string()),
    server_operation("replay.first_divergence".to_string(), "replay".to_string()),
    server_operation("replay.minimal_causal_slice".to_string(), "replay".to_string()),
    # (P1-9) the typed record/run/compare entries: replay.record builds a
    # trace from supplied typed choices, replay.run extracts the
    # deterministic choice stream, replay.diff is the semantic-only
    # first-divergence compare (semantic_query.tg's module-scope
    # replay_query serves callers that hold a trace; a §38 session
    # carries none).
    server_operation("replay.record".to_string(), "replay".to_string()),
    server_operation("replay.run".to_string(), "replay".to_string()),
    server_operation("replay.diff".to_string(), "replay".to_string()),
    server_operation("revision".to_string(), "service".to_string())
  ])
end

pub def server_operation_resolve(name: String) -> Option[ServerOperation]
  for op in server_operations() do
    if op.name == name then
      return Option::Some(op)
    end
  end
  Option::None
end

pub def server_op_known(name: String) -> Bool
  match server_operation_resolve(&name)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# The registry's general route: the §38 facade of the session (snapshot +
# index + the retained diagnostic store + evidence) → query(). This is
# the arm every non-residual registered family uses — the index/explain
# families included, so diagnostic.explain answers the STORE-aware arm
# and the §38 and §39 answers can never diverge.
def session_facade_results(session: CompilerSession, operation: String, arg: String) -> QueryResults
  let facade = session_query(&session)
  query(&facade, operation, arg)
end

def session_query_results(session: CompilerSession, operation: String, arg: String) -> QueryResults
  match server_operation_resolve(&operation)
  when Option::None then QueryResults { kind: "unknown", keys: Vec::new() }
  when Option::Some(op) then
    # The resolved handler family word drives the route — the registry is
    # the authority, not the name text.
    match op.handler_kind
    # ———— the residual server-only families ————
    # These consume pipeline state the §38 facade does not carry (the
    # session's final_mir / the service revision).
    when "mir" then
      if operation == "mir_slice" then
        mir_slice(arg.clone(), &session.final_mir)
      else
        mir_graph_query(operation.clone(), arg.clone(), &session.final_mir)
      end
    when "service" then session_revision_results(&session)
    # ———— every other registered family: the §38 facade ————
    # index / explain / type / ownership / contract / symbol / snapshot /
    # plan / diagnostic / replay all answer through query() over the
    # session's retained store + evidence, so §38 and §39 can never
    # diverge.
    when _ then session_facade_results(&session, operation.clone(), arg.clone())
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The dispatch → typed wire record mapping (third-audit item 22)
# ———————————————————————————————————————————————————————————————
# The MECHANICAL wrapper over the §38 QueryResults rows: one branch per
# served operation, building the family record from the answer's canonical
# rows and the request arg (the identity field the rows do not repeat —
# callers.target, effects.function, ...). Option::None for every op with
# no record family and for the *_unavailable answers (an empty row set is
# never a fabricated record). The response constructor then serializes
# the record through its family's ONE renderer, so the wire rows ARE the
# record's canonical render.

def server_wire_first_row(rows: Vec[String]) -> String
  if rows.len() == 0 then
    return "".to_string()
  end
  rows[0].clone()
end

# The §32 effect row splitter mirror ("<dirty-word>;<cap-id>;..." — the
# same grammar semantic_query.tg's query_effects consumes): bits = the
# first segment parsed as an Int (0 on a non-numeric word), caps = the
# non-empty segments after the first.
def server_wire_effect_row_split(row: String) -> (Int, Vec[String])
  var bits = 0
  var caps: Vec[String] = Vec::new()
  var segment = 0
  var start = 0
  var i = 0
  while i <= row.len() do
    let is_separator = if i == row.len() then true else row.slice(i, i + 1) == ";" end
    if is_separator then
      let text = row.slice(start, i)
      if segment == 0 then
        match text.parse_int()
        when Result::Ok(n) then bits = n
        when Result::Err(_) then bits = 0
        end
      elsif text.len() > 0 then
        caps.push(text.clone())
      end
      segment = segment + 1
      start = i + 1
    end
    i = i + 1
  end
  (bits, caps)
end

def server_wire_effect_parts(rows: Vec[String]) -> (Int, Vec[String])
  if rows.len() == 0 then
    return (0, Vec::new())
  end
  server_wire_effect_row_split(rows[0].clone())
end

# The code component of a stable diagnostic id render
# ("owner|diagnostic|code|cause|...|#ordinal"): "" when the id text does
# not carry one.
def server_wire_diagnostic_code_of_id(id_text: String) -> String
  let parts = id_text.split("|")
  if parts.len() >= 3 then
    parts[2].clone()
  else
    "".to_string()
  end
end

# (fourth-audit P0-12) The contract kind word of one ContractFact kind
# (the same "Pre" / "Post" / "Invariant" render the §29/§31 row keys and the
# index row form use — one vocabulary, mirrored locally so the server never
# imports the query module's private renderer).
def server_contract_kind_text(kind: AstContractKind) -> String
  match kind
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The typed ContractResponse of ONE ContractFact built DIRECTLY from the
# record: id (the stable clause key), kind, canonical expression,
# fingerprint and message ride as DISTINCT fields. The message Option::None
# (no declared message) renders "". No row text is ever split — the
# canonical expression may contain '|' (P0-12).
pub def contract_response_of_fact(fact: ContractFact) -> ContractResponse
  let message = match fact.message.clone()
  when Option::Some(text) then text.clone()
  when Option::None then "".to_string()
  end
  ContractResponse {
    contract_id: fact.id.stable_key.clone(),
    kind: server_contract_kind_text(fact.kind.clone()),
    canonical_expression: semantic_contract_expr_text(&fact.canonical_expression),
    fingerprint: semantic_digest_render(&fact.expression_fingerprint),
    message: message
  }
end

# The ContractFact a single-clause contract answer row names, located in
# the session snapshot BY IDENTITY: the row must equal the fact's stable
# clause key ("<fn>|<kind>|<canonical>") or the index row form
# ("<kind>|<canonical>"), both DERIVED from the fact and compared — the
# answer row is never split into components. Option::None on a multi-row /
# unmatched answer (the record family is ONE clause; a row list keeps its
# §38 rows).
def server_wire_contract_fact(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[ContractFact]
  if rows.len() != 1 then
    return Option::None
  end
  var found: Option[ContractFact] = Option::None
  for contract in snapshot.contracts do
    let row_key = contract.id.stable_key.clone()
    let index_row = server_contract_kind_text(contract.kind.clone()) + "|" +
      semantic_contract_expr_text(&contract.canonical_expression)
    if rows[0] == row_key || rows[0] == index_row then
      found = Option::Some(contract.clone())
      break
    end
  end
  found
end

# The single-clause contract answer as the typed record, built from the
# underlying ContractFact (P0-12: never a split of the canonical clause
# text). Option::None when no fact in the snapshot owns the single row.
def server_wire_contract_of_row(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[ContractResponse]
  match server_wire_contract_fact(&snapshot, rows)
  when Option::Some(fact) then Option::Some(contract_response_of_fact(fact))
  when Option::None then Option::None
  end
end

# The typed-wire form of the single-clause contract helper (the enum wrap
# the dispatch mapping returns).
def server_wire_contract_payload(snapshot: SemanticSnapshot, rows: Vec[String]) -> Option[SemanticWirePayload]
  match server_wire_contract_of_row(&snapshot, rows)
  when Option::Some(record) then Option::Some(SemanticWirePayload::Contract(record))
  when Option::None then Option::None
  end
end

pub def semantic_wire_payload_of_results(
  operation: String, arg: String, results: QueryResults, snapshot: SemanticSnapshot
) -> Option[SemanticWirePayload]
  let rows = results.keys.clone()
  match operation
  when "callers" then
    Option::Some(SemanticWirePayload::Callers(CallersResponse {
      target: arg.clone(),
      callers: rows.clone()
    }))
  when "callees" then
    Option::Some(SemanticWirePayload::Callees(CalleesResponse {
      function: arg.clone(),
      callees: rows.clone()
    }))
  when "symbol_get" then
    Option::Some(SemanticWirePayload::Symbols(SymbolsResponse {
      query: arg.clone(),
      symbols: rows.clone()
    }))
  when "symbol_search" then
    Option::Some(SemanticWirePayload::Symbols(SymbolsResponse {
      query: arg.clone(),
      symbols: rows.clone()
    }))
  when "types" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: server_wire_first_row(rows.clone()),
      size: 0,
      alignment: 0,
      fields: Vec::new()
    }))
  when "type.get" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: server_wire_first_row(rows.clone()),
      size: 0,
      alignment: 0,
      fields: Vec::new()
    }))
  when "fields" then
    Option::Some(SemanticWirePayload::Type(TypeResponse {
      type_key: arg.clone(),
      kind: "".to_string(),
      size: 0,
      alignment: 0,
      fields: rows.clone()
    }))
  when "effects" then
    let parts = server_wire_effect_parts(rows.clone())
    Option::Some(SemanticWirePayload::Effects(EffectsResponse {
      function: arg.clone(),
      bits: parts.0,
      capabilities: parts.1.clone(),
      purity: "".to_string()
    }))
  when "capabilities" then
    Option::Some(SemanticWirePayload::Effects(EffectsResponse {
      function: arg.clone(),
      bits: 0,
      capabilities: rows.clone(),
      purity: "".to_string()
    }))
  when "ownership_explain" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "ownership.moves" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "ownership.drop_plan" then
    Option::Some(SemanticWirePayload::Ownership(OwnershipResponse {
      function: arg.clone(),
      rows: rows.clone()
    }))
  when "mir_function" then
    Option::Some(SemanticWirePayload::MirFunction(MirFunctionResponse {
      function: arg.clone(),
      summary: server_wire_first_row(rows.clone())
    }))
  when "abi_inspect" then
    Option::Some(SemanticWirePayload::Abi(AbiResponse {
      surface_id: arg.clone(),
      rows: rows.clone()
    }))
  when "contracts" then server_wire_contract_payload(&snapshot, rows.clone())
  when "contract_list" then server_wire_contract_payload(&snapshot, rows.clone())
  when "contract.obligations" then server_wire_contract_payload(&snapshot, rows.clone())
  when "diagnostic.get" then
    if results.kind != "diagnostic.get" then
      Option::None
    else
      var diagnostic_id = ""
      var message = ""
      var related: Vec[String] = Vec::new()
      for row in rows.clone() do
        match server_wire_split_row(row.clone())
        when Option::Some(parts) then
          if parts.0 == "id" then
            diagnostic_id = parts.1.clone()
          elsif parts.0 == "message" then
            message = parts.1.clone()
          elsif parts.0 == "related" then
            related.push(parts.1.clone())
          end
        when Option::None then ()
        end
      end
      if diagnostic_id.len() == 0 then
        Option::None
      else
        Option::Some(SemanticWirePayload::Diagnostic(DiagnosticResponse {
          diagnostic_id: diagnostic_id.clone(),
          code: server_wire_diagnostic_code_of_id(diagnostic_id.clone()),
          message: message,
          related: related
        }))
      end
    end
  when "snapshot.diff" then
    if results.kind == "snapshot.diff" then
      Option::Some(SemanticWirePayload::Delta(DeltaResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when "semantic_diff" then
    Option::Some(SemanticWirePayload::Delta(DeltaResponse { rows: rows.clone() }))
  when "build.plan" then
    if results.kind == "build.plan" then
      Option::Some(SemanticWirePayload::Plan(PlanResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when "verify.plan" then
    if results.kind == "verify.plan" then
      Option::Some(SemanticWirePayload::Plan(PlanResponse { rows: rows.clone() }))
    else
      Option::None
    end
  when _ then Option::None
  end
end

# Route one §38 result into the response: kind + keys ride the wire
# protocol; the typed payload (audit item 23) rides the response record
# (the in-process channel — the framing in semantic_response_frame never
# serializes it; a parse always yields None there). (Third-audit item 22)
# the typed WIRE record is built mechanically from the §38 rows and its
# canonical render becomes the keys field — the wire rows are the record's
# canonical render, never a second field. (Fourth-audit P0-12) the contract
# arm needs the session snapshot to locate the ContractFact the single-row
# answer belongs to.
def session_results_response(session: CompilerSession, req: SemanticRequest, results: QueryResults) -> SemanticResponse
  let payload = match results.payload
  when Option::Some(p) then Option::Some(p.clone())
  when Option::None then Option::None
  end
  let wire_payload = semantic_wire_payload_of_results(
    req.operation.clone(), req.payload.clone(), &results, &session.snapshot)
  let keys = match wire_payload.clone()
  when Option::Some(p) then semantic_wire_payload_render(p)
  when Option::None then results.keys.clone()
  end
  SemanticResponse {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: req.request_id,
    ok: true,
    kind: results.kind.clone(),
    keys: keys,
    payload: payload,
    wire_payload: wire_payload
  }
end

def session_protocol_error_response(req: SemanticRequest) -> SemanticResponse
  let message = "unsupported protocol_version " + req.protocol_version.to_string() +
    " (this server speaks " + SEMANTIC_PROTOCOL_VERSION.to_string() + ")"
  SemanticResponse {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: req.request_id,
    ok: false,
    kind: "protocol_error".to_string(),
    error: message
  }
end

# Handle one typed request: the version gate (fail closed) + §38 routing.
pub def session_handle_request(session: CompilerSession, req: SemanticRequest) -> SemanticResponse
  if req.protocol_version != SEMANTIC_PROTOCOL_VERSION then
    return session_protocol_error_response(&req)
  end
  let results = session_query_results(&session, req.operation.clone(), req.payload.clone())
  session_results_response(&session, &req, &results)
end

# ———————————————————————————————————————————————————————————————
# Wire helpers — 4-byte big-endian length-prefixed fields
# ———————————————————————————————————————————————————————————————

def server_push_u32(inout out: Vec[u8], n: Int) -> Unit
  out.push(((n >> 24) & 0xFF) as u8)
  out.push(((n >> 16) & 0xFF) as u8)
  out.push(((n >> 8) & 0xFF) as u8)
  out.push((n & 0xFF) as u8)
end

def server_push_text(inout out: Vec[u8], text: String) -> Unit
  server_push_u32(&mut out, text.len())
  for b in text.bytes() do
    out.push(b)
  end
end

def server_read_u32(bytes: Vec[u8], inout at: Int) -> Option[Int]
  if at < 0 || at + 4 > bytes.len() then
    return Option::None
  end
  let n = ((bytes[at] as Int) << 24) | ((bytes[at + 1] as Int) << 16) |
    ((bytes[at + 2] as Int) << 8) | (bytes[at + 3] as Int)
  at = at + 4
  Option::Some(n)
end

def server_read_text(bytes: Vec[u8], inout at: Int) -> Option[String]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(n) then
    # Audit item 25: the field length is checked against MAX_FIELD_BYTES
    # and the remaining body BEFORE the text is sliced out.
    if n < 0 || n > MAX_FIELD_BYTES || at + n > bytes.len() then
      Option::None
    else
      let text = String::from_bytes(bytes.slice(at, at + n))
      at = at + n
      Option::Some(text)
    end
  end
end

def server_read_int(bytes: Vec[u8], inout at: Int) -> Option[Int]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(text) then
    match text.parse_int()
    when Result::Ok(n) then Option::Some(n)
    when Result::Err(_) then Option::None
    end
  end
end

def server_frame_of(body: Vec[u8]) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  server_push_u32(&mut out, body.len())
  for b in body do
    out.push(b)
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Request framing — encode + strict parse
# ———————————————————————————————————————————————————————————————

pub def semantic_request_frame(req: SemanticRequest) -> Vec[u8]
  var body: Vec[u8] = Vec::new()
  server_push_text(&mut body, req.protocol_version.to_string())
  server_push_text(&mut body, req.request_id.to_string())
  server_push_text(&mut body, req.operation.clone())
  server_push_text(&mut body, req.payload.clone())
  server_frame_of(body)
end

def server_req_fields_1(bytes: Vec[u8], inout at: Int, protocol_version: Int) -> Option[SemanticRequest]
  match server_read_int(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(request_id) then
    match server_read_text(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(operation) then
      match server_read_text(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(payload) then
        Option::Some(SemanticRequest {
          protocol_version: protocol_version,
          request_id: request_id,
          operation: operation,
          payload: payload
        })
      end
    end
  end
end

# Parse ONE complete request frame (strict — None on any framing/field
# error). Audit item 25: a frame must be at least the 4-byte BE length
# header and at most MAX_FRAME_BYTES (checked before any field work), and
# the fields must end EXACTLY at the body's end — trailing bytes inside a
# frame fail closed.
pub def semantic_request_parse(bytes: Vec[u8]) -> Option[SemanticRequest]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let end = at + body_len
    if bytes.len() != end then
      Option::None
    else
      match server_read_int(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(protocol_version) then
        match server_req_fields_1(&bytes, &mut at, protocol_version)
        when Option::None then Option::None
        when Option::Some(req) then
          if at != end then Option::None else Option::Some(req) end
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Response framing — encode + strict parse
# ———————————————————————————————————————————————————————————————

pub def semantic_response_frame(resp: SemanticResponse) -> Vec[u8]
  let error_text = resp.error.clone()
  var body: Vec[u8] = Vec::new()
  server_push_text(&mut body, resp.protocol_version.to_string())
  server_push_text(&mut body, resp.request_id.to_string())
  server_push_text(&mut body, if resp.ok then "true" else "false" end)
  server_push_text(&mut body, resp.kind.clone())
  server_push_text(&mut body, resp.keys.len().to_string())
  for k in resp.keys do
    server_push_text(&mut body, k.clone())
  end
  server_push_text(&mut body, error_text)
  server_frame_of(body)
end

def server_response_keys(bytes: Vec[u8], inout at: Int, count: Int) -> Option[Vec[String]]
  var keys: Vec[String] = Vec::new()
  var i = 0
  while i < count do
    match server_read_text(&bytes, &mut at)
    when Option::None then return Option::None
    when Option::Some(k) then keys.push(k.clone())
    end
    i = i + 1
  end
  Option::Some(keys)
end

def server_resp_fields_1(
  bytes: Vec[u8], inout at: Int, protocol_version: Int, request_id: Int, ok: Bool
) -> Option[SemanticResponse]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(kind) then
    match server_read_int(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(count) then
      # Audit item 25: the keys-count is range-checked (0 <= count <=
      # MAX_KEYS) BEFORE server_response_keys allocates the keys vector;
      # its own byte length was already bounded by server_read_text.
      if count < 0 || count > MAX_KEYS then
        Option::None
      else
        match server_response_keys(&bytes, &mut at, count)
        when Option::None then Option::None
        when Option::Some(keys) then
          match server_read_text(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(error) then
            Option::Some(SemanticResponse {
              protocol_version: protocol_version,
              request_id: request_id,
              ok: ok,
              kind: kind,
              keys: keys,
              error: error
            })
          end
        end
      end
    end
  end
end

# Parse ONE complete response frame (strict like semantic_request_parse;
# audit item 25 applies the same frame cap and end-of-body check).
pub def semantic_response_parse(bytes: Vec[u8]) -> Option[SemanticResponse]
  if bytes.len() < 4 || bytes.len() > MAX_FRAME_BYTES then
    return Option::None
  end
  var at = 0
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(body_len) then
    let end = at + body_len
    if bytes.len() != end then
      Option::None
    else
      match server_read_int(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(protocol_version) then
        match server_read_int(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(request_id) then
          match server_read_text(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(ok_text) then
            if ok_text != "true" && ok_text != "false" then
              Option::None
            else
              match server_resp_fields_1(&bytes, &mut at, protocol_version, request_id, ok_text == "true")
              when Option::None then Option::None
              when Option::Some(resp) then
                if at != end then Option::None else Option::Some(resp) end
              end
            end
          end
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# PROTOCOL V2 — the typed tagged wire protocol (fourth-audit P0-11)
# ———————————————————————————————————————————————————————————————
# The v2 wire carries TYPED RECORDS instead of operation-name + payload
# text -> kind + row text. The §39 frame (4-byte BIG-ENDIAN body length ||
# body) is unchanged and shared with v1; the body is:
#
#   request  := version-word u32 || request_id u64 || request-tag u32 ||
#               <tagged request fields>
#   response := version-word u32 || request_id u64 || response-tag u32 ||
#               <tagged response fields>
#
# Field encodings (deterministic; no padding, no map iteration):
#   text   = u32 BE byte length || UTF-8 bytes   (MAX_FIELD_BYTES enforced
#            by the shared server_read_text BEFORE the slice is allocated)
#   u64    = 8 bytes big-endian; i64 = the same bytes viewed two's
#            complement; bool = 1 byte (0/1); option = presence byte || body
#   count  = u32 BE element count (0 <= count <= MAX_KEYS) || elements
# The version-word layout is `major << 16 | minor` (major 2, minor 0 today).
# READER VERSION POLICY (documented choice):
#   * a version-word with major != 2 is REJECTED (Option::None, fail closed
#     — the parser never guesses a foreign grammar);
#   * a same-major word (any minor) is parsed under this grammar; an
#     UNKNOWN TAG is also REJECTED, never skipped: the parser returns
#     Option::None and the serve loop terminates without a response, so an
#     unreadable request is never answered from a guessed interpretation and
#     the byte stream is never resynchronized onto a misparsed offset.
#   * the minor number is informational today (zero minor releases exist);
#     a future minor adds tags, and old readers fail closed on them by the
#     rule above — the safe direction (skip would risk answering garbage).
# The operation id is TYPED: a dense index into the §39 registry plus the
# 128-bit digest of the canonical operation name (semantic_operation_digest).
# The name text stays a DEBUG string; the wire carries the dense id and the
# digest words, and the decoder re-derives the name through the registry and
# verifies the digest (a forged dense id or digest fails closed).
#
# V1 COMPATIBILITY (negotiated): the v1 text-row protocol below is
# untouched and byte-compatible. semantic_frame_protocol_version probes the
# first body word (a v2 same-major word vs the v1 version-field length) and
# session_handle_frame routes: a version-1 request takes the v1 parse +
# session_handle_request + semantic_response_frame path, a version-2 request
# the v2 path, each answering in the version it was asked in.
#
# The request enum variants group the operation families:
#   Target  — the index / type / ownership / contract / symbol / explain
#             families: a text key (the op's arg grammar) plus the TYPED
#             subject id the key denotes (StableDeclId / StablePlaceId /
#             StableMirStmtId).
#   MirGraph— the mir graph ops: the function key + its StableDeclId, an
#             anchor key (mir.block) or right key (mir.diff), or a typed
#             StableMirStmtId node (mir.path / mir.reaching).
#   Slice   — mir_slice: the typed §33 MirSliceRequest (function key,
#             MirSliceKind, anchor).
#   Text    — the snapshot / diagnostic / plan / replay / edit families
#             (free-form payload grammar).
#   Service — the revision service op.

pub const SEMANTIC_PROTOCOL_VERSION_V2: Int = 2

# The version-word layout and the v2 fixed bits.
const SEMANTIC_V2_MAJOR: Int = 2
const SEMANTIC_V2_MINOR: Int = 0
const SEMANTIC_V2_HEADER: Int = 0x00020000

# Request payload tags (never renumber — they are wire identity).
const V2_REQ_TARGET: Int = 1
const V2_REQ_MIR_GRAPH: Int = 2
const V2_REQ_SLICE: Int = 3
const V2_REQ_TEXT: Int = 4
const V2_REQ_SERVICE: Int = 5

# Response payload tags (never renumber).
const V2_RESP_CALLERS: Int = 1
const V2_RESP_CALLEES: Int = 2
const V2_RESP_SYMBOLS: Int = 3
const V2_RESP_TYPE: Int = 4
const V2_RESP_EFFECTS: Int = 5
const V2_RESP_OWNERSHIP: Int = 6
const V2_RESP_CONTRACT: Int = 7
const V2_RESP_MIR_FUNCTION: Int = 8
const V2_RESP_ABI: Int = 9
const V2_RESP_DIAGNOSTIC: Int = 10
const V2_RESP_DELTA: Int = 11
const V2_RESP_PLAN: Int = 12
const V2_RESP_MIR_SLICE: Int = 13
const V2_RESP_EXPLAIN: Int = 14
const V2_RESP_ROWS: Int = 15
const V2_RESP_REVISION: Int = 16
const V2_RESP_STATUS: Int = 17

# Typed id tags inside the Target id union / the MirGraph node option.
const V2_ID_DECL: Int = 1
const V2_ID_PLACE: Int = 2
const V2_ID_MIR_STMT: Int = 3

# ———— The typed operation id ————

pub struct SemanticOperationId
  dense_id: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

def semantic_operation_id_text(id: SemanticOperationId) -> String
  "op:" + id.dense_id.to_string() + ":" + id.digest_hi.to_string() + "-" + id.digest_lo.to_string()
end

# The 128-bit digest of the canonical operation name (domain-separated:
# the "semantic-op|" prefix keeps the operation-id digest space disjoint
# from every stable key digest).
pub def semantic_operation_digest(name: String) -> StableDigest
  let text = "semantic-op|" + name
  stable_digest_of(&text)
end

# The typed id of a registered operation: the registry position (dense
# index — the registry is the dispatch authority) + the name digest words.
# Option::None for a name the registry does not declare.
pub def semantic_operation_id_of(name: String) -> Option[SemanticOperationId]
  var index = 0
  for op in server_operations() do
    if op.name == name then
      let digest = semantic_operation_digest(name.clone())
      return Option::Some(SemanticOperationId {
        dense_id: index,
        digest_hi: digest.hi,
        digest_lo: digest.lo
      })
    end
    index = index + 1
  end
  Option::None
end

# The registry name a typed id denotes: the dense index resolves the name
# and the digest words are RE-DERIVED and compared — a forged index or
# digest fails closed (Option::None). The name stays a debug string.
pub def semantic_operation_name_of(id: SemanticOperationId) -> Option[String]
  let operations = server_operations()
  if id.dense_id < 0 || id.dense_id >= operations.len() then
    return Option::None
  end
  let name = operations[id.dense_id].name.clone()
  let digest = semantic_operation_digest(name.clone())
  if digest.hi != id.digest_hi || digest.lo != id.digest_lo then
    return Option::None
  end
  Option::Some(name)
end

# ———— The typed v2 records ————

# The typed subject id a Target request names: a declaration identity, a
# place identity (the digest-words carrier: canonical place text + digest
# words) or a MIR statement identity.
pub enum SemanticTargetId
  Decl(decl: StableDeclId)
  Place(place: StablePlaceId)
  MirStmt(stmt: StableMirStmtId)
end

pub enum SemanticRequestV2Payload
  Target(operation: SemanticOperationId, key: String, target: SemanticTargetId)
  MirGraph(operation: SemanticOperationId, function_key: String, function: StableDeclId, anchor_key: String, right_key: String, node: Option[StableMirStmtId])
  Slice(operation: SemanticOperationId, request: MirSliceRequest)
  Text(operation: SemanticOperationId, arg: String)
  Service(operation: SemanticOperationId)
end

pub struct SemanticRequestV2
  protocol_version: Int
  request_id: Int
  payload: SemanticRequestV2Payload
end

# The typed MirSlice answer (the QueryResults §33 payload lifted, plus the
# §38 kind word so the unavailable/error answers stay typed).
pub struct MirSliceResponse
  kind: String
  statements: Vec[String] = Vec::new()
  externals: Vec[String] = Vec::new()
end

# The typed row-list answer of the ops with no dedicated record family:
# the §38 answer kind + the canonical rows. Every registry op is covered by
# one of the v2 response variants.
pub struct RowsResponse
  kind: String
  rows: Vec[String] = Vec::new()
end

# The typed revision service answer: the session's content-addressed
# revision digest WORDS (not the rendered text).
pub struct RevisionResponse
  revision_hi: UInt = 0
  revision_lo: UInt = 0
end

# The typed fail-closed / unavailable / unknown answer. ok=false only for a
# protocol error (an unresolvable operation id, a version mismatch);
# unavailable/unknown §38 kinds keep ok=true and their kind word, exactly
# like the v1 envelope's ok field.
pub struct StatusResponse
  ok: Bool
  kind: String
  message: String = ""
end

pub enum SemanticResponseV2Payload
  Callers(record: CallersResponse)
  Callees(record: CalleesResponse)
  Symbols(record: SymbolsResponse)
  Type(record: TypeResponse)
  Effects(record: EffectsResponse)
  Ownership(record: OwnershipResponse)
  Contract(record: ContractResponse)
  MirFunction(record: MirFunctionResponse)
  Abi(record: AbiResponse)
  Diagnostic(record: DiagnosticResponse)
  Delta(record: DeltaResponse)
  Plan(record: PlanResponse)
  MirSlice(record: MirSliceResponse)
  Explain(record: ExplainNode)
  Rows(record: RowsResponse)
  Revision(record: RevisionResponse)
  Status(record: StatusResponse)
end

pub struct SemanticResponseV2
  protocol_version: Int
  request_id: Int
  payload: SemanticResponseV2Payload
end

# The MirSliceKind wire code (stable across revisions — never renumbered)
# and the §33 request text grammar's kind word (the same vocabulary
# semantic_query's mir_slice adapter parses).
def v2_mir_slice_kind_code(kind: MirSliceKind) -> Int
  match kind
  when MirSliceKind::BackwardDataflow then 0
  when MirSliceKind::ForwardDataflow then 1
  when MirSliceKind::ControlDependence then 2
  when MirSliceKind::Ownership then 3
  when MirSliceKind::Effects then 4
  when MirSliceKind::Failure then 5
  when MirSliceKind::ReturnValue then 6
  when MirSliceKind::Dominators then 7
  when MirSliceKind::PostDominators then 8
  when MirSliceKind::Loops then 9
  when MirSliceKind::ReachingDefs then 10
  when MirSliceKind::Path then 11
  end
end

def v2_mir_slice_kind_of_code(code: Int) -> Option[MirSliceKind]
  match code
  when 0 then Option::Some(MirSliceKind::BackwardDataflow)
  when 1 then Option::Some(MirSliceKind::ForwardDataflow)
  when 2 then Option::Some(MirSliceKind::ControlDependence)
  when 3 then Option::Some(MirSliceKind::Ownership)
  when 4 then Option::Some(MirSliceKind::Effects)
  when 5 then Option::Some(MirSliceKind::Failure)
  when 6 then Option::Some(MirSliceKind::ReturnValue)
  when 7 then Option::Some(MirSliceKind::Dominators)
  when 8 then Option::Some(MirSliceKind::PostDominators)
  when 9 then Option::Some(MirSliceKind::Loops)
  when 10 then Option::Some(MirSliceKind::ReachingDefs)
  when 11 then Option::Some(MirSliceKind::Path)
  when _ then Option::None
  end
end

def v2_mir_slice_kind_word(kind: MirSliceKind) -> String
  match kind
  when MirSliceKind::BackwardDataflow then "backward"
  when MirSliceKind::ForwardDataflow then "forward"
  when MirSliceKind::ControlDependence then "control"
  when MirSliceKind::Ownership then "ownership"
  when MirSliceKind::Effects then "effects"
  when MirSliceKind::Failure then "failure"
  when MirSliceKind::ReturnValue then "return"
  when MirSliceKind::Dominators then "dominators"
  when MirSliceKind::PostDominators then "postdominators"
  when MirSliceKind::Loops then "loops"
  when MirSliceKind::ReachingDefs then "reaching"
  when MirSliceKind::Path then "path"
  end
end

# ———— The v2 encoding primitives ———

def v2_push_u64(inout out: Vec[u8], v: UInt) -> Unit
  out.push(((v >> 56) & 0xFF) as u8)
  out.push(((v >> 48) & 0xFF) as u8)
  out.push(((v >> 40) & 0xFF) as u8)
  out.push(((v >> 32) & 0xFF) as u8)
  out.push(((v >> 24) & 0xFF) as u8)
  out.push(((v >> 16) & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
  out.push((v & 0xFF) as u8)
end

def v2_read_u64(bytes: Vec[u8], inout at: Int) -> Option[UInt]
  if at < 0 || at + 8 > bytes.len() then
    return Option::None
  end
  var value: UInt = 0
  var i = 0
  while i < 8 do
    value = (value << 8) | (bytes[at + i] as UInt)
    i = i + 1
  end
  at = at + 8
  Option::Some(value)
end

def v2_push_i64(inout out: Vec[u8], v: Int) -> Unit
  v2_push_u64(out, v as UInt)
end

def v2_read_i64(bytes: Vec[u8], inout at: Int) -> Option[Int]
  match v2_read_u64(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(value) then Option::Some(value as Int)
  end
end

def v2_push_bool(inout out: Vec[u8], v: Bool) -> Unit
  if v then
    out.push(1 as u8)
  else
    out.push(0 as u8)
  end
end

def v2_read_bool(bytes: Vec[u8], inout at: Int) -> Option[Bool]
  if at < 0 || at >= bytes.len() then
    return Option::None
  end
  let byte = bytes[at]
  at = at + 1
  if byte == 1 as u8 then
    Option::Some(true)
  elsif byte == 0 as u8 then
    Option::Some(false)
  else
    Option::None
  end
end

def v2_push_count(inout out: Vec[u8], n: Int) -> Unit
  server_push_u32(out, n)
end

# A vector count is range-checked (0 <= n <= MAX_KEYS) BEFORE the loop
# allocates elements — the v2 reading of the §39 MAX_KEYS limit.
def v2_read_count(bytes: Vec[u8], inout at: Int) -> Option[Int]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(n) then
    if n < 0 || n > MAX_KEYS then
      Option::None
    else
      Option::Some(n)
    end
  end
end

def v2_push_texts(inout out: Vec[u8], texts: Vec[String]) -> Unit
  v2_push_count(out, texts.len())
  for text in texts do
    server_push_text(out, text.clone())
  end
end

def v2_read_texts(bytes: Vec[u8], inout at: Int) -> Option[Vec[String]]
  match v2_read_count(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(count) then
    var out: Vec[String] = Vec::new()
    var i = 0
    while i < count do
      match server_read_text(&bytes, &mut at)
      when Option::None then return Option::None
      when Option::Some(text) then out.push(text.clone())
      end
      i = i + 1
    end
    Option::Some(out)
  end
end

def v2_bytes_eq(a: Vec[u8], b: Vec[u8]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

# ———— The typed id codecs (StableDeclId / StablePlaceId / StableMirStmtId) ———

# A StableDeclId rides structurally: every package / module / lineage /
# kind / display-key field and the digest words. The decoder REBUILDS the
# nested records and verifies every digest pair against the total builders
# (stable_package_id_of / stable_module_id_of / stable_decl_lineage_id_of /
# stable_decl_identity_text_of) — a forged word or mismatched lineage fails
# closed.
def v2_push_decl(inout out: Vec[u8], decl: StableDeclId) -> Unit
  server_push_text(out, decl.package.key.clone())
  v2_push_u64(out, decl.package.digest_hi)
  v2_push_u64(out, decl.package.digest_lo)
  server_push_text(out, decl.module.package.key.clone())
  v2_push_u64(out, decl.module.package.digest_hi)
  v2_push_u64(out, decl.module.package.digest_lo)
  server_push_text(out, decl.module.path.clone())
  v2_push_u64(out, decl.module.digest_hi)
  v2_push_u64(out, decl.module.digest_lo)
  server_push_text(out, decl.lineage.package.key.clone())
  v2_push_u64(out, decl.lineage.package.digest_hi)
  v2_push_u64(out, decl.lineage.package.digest_lo)
  server_push_text(out, decl.lineage.module.package.key.clone())
  v2_push_u64(out, decl.lineage.module.package.digest_hi)
  v2_push_u64(out, decl.lineage.module.package.digest_lo)
  server_push_text(out, decl.lineage.module.path.clone())
  v2_push_u64(out, decl.lineage.module.digest_hi)
  v2_push_u64(out, decl.lineage.module.digest_lo)
  v2_push_i64(out, decl.lineage.lineage)
  v2_push_u64(out, decl.lineage.digest_hi)
  v2_push_u64(out, decl.lineage.digest_lo)
  server_push_text(out, decl.kind.clone())
  server_push_text(out, decl.display_key.clone())
  v2_push_u64(out, decl.digest_hi)
  v2_push_u64(out, decl.digest_lo)
end

def v2_decl_digests_ok(decl: StableDeclId) -> Bool
  let package = stable_package_id_of(decl.package.key.clone())
  if package.digest_hi != decl.package.digest_hi || package.digest_lo != decl.package.digest_lo then
    return false
  end
  let module_package = stable_package_id_of(decl.module.package.key.clone())
  if module_package.digest_hi != decl.module.package.digest_hi ||
    module_package.digest_lo != decl.module.package.digest_lo then
    return false
  end
  let module = stable_module_id_of(module_package.clone(), decl.module.path.clone())
  if module.digest_hi != decl.module.digest_hi || module.digest_lo != decl.module.digest_lo then
    return false
  end
  let lineage_package = stable_package_id_of(decl.lineage.package.key.clone())
  if lineage_package.digest_hi != decl.lineage.package.digest_hi ||
    lineage_package.digest_lo != decl.lineage.package.digest_lo then
    return false
  end
  let lineage_module_package = stable_package_id_of(decl.lineage.module.package.key.clone())
  if lineage_module_package.digest_hi != decl.lineage.module.package.digest_hi ||
    lineage_module_package.digest_lo != decl.lineage.module.package.digest_lo then
    return false
  end
  let lineage_module = stable_module_id_of(lineage_module_package.clone(), decl.lineage.module.path.clone())
  if lineage_module.digest_hi != decl.lineage.module.digest_hi ||
    lineage_module.digest_lo != decl.lineage.module.digest_lo then
    return false
  end
  let lineage = stable_decl_lineage_id_of(lineage_package.clone(), lineage_module.clone(), decl.lineage.lineage)
  if lineage.digest_hi != decl.lineage.digest_hi || lineage.digest_lo != decl.lineage.digest_lo then
    return false
  end
  let identity = stable_digest_of(&stable_decl_identity_text_of(&decl))
  identity.hi == decl.digest_hi && identity.lo == decl.digest_lo
end

def v2_read_decl(bytes: Vec[u8], inout at: Int) -> Option[StableDeclId]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(package_key) then
    match v2_read_u64(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(package_hi) then
      match v2_read_u64(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(package_lo) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(module_package_key) then
          match v2_read_u64(&bytes, &mut at)
          when Option::None then Option::None
          when Option::Some(module_package_hi) then
            match v2_read_u64(&bytes, &mut at)
            when Option::None then Option::None
            when Option::Some(module_package_lo) then
              match server_read_text(&bytes, &mut at)
              when Option::None then Option::None
              when Option::Some(module_path) then
                match v2_read_u64(&bytes, &mut at)
                when Option::None then Option::None
                when Option::Some(module_hi) then
                  match v2_read_u64(&bytes, &mut at)
                  when Option::None then Option::None
                  when Option::Some(module_lo) then
                    match server_read_text(&bytes, &mut at)
                    when Option::None then Option::None
                    when Option::Some(lineage_package_key) then
                      match v2_read_u64(&bytes, &mut at)
                      when Option::None then Option::None
                      when Option::Some(lineage_package_hi) then
                        match v2_read_u64(&bytes, &mut at)
                        when Option::None then Option::None
                        when Option::Some(lineage_package_lo) then
                          match server_read_text(&bytes, &mut at)
                          when Option::None then Option::None
                          when Option::Some(lineage_module_package_key) then
                            match v2_read_u64(&bytes, &mut at)
                            when Option::None then Option::None
                            when Option::Some(lineage_module_package_hi) then
                              match v2_read_u64(&bytes, &mut at)
                              when Option::None then Option::None
                              when Option::Some(lineage_module_package_lo) then
                                match server_read_text(&bytes, &mut at)
                                when Option::None then Option::None
                                when Option::Some(lineage_module_path) then
                                  match v2_read_u64(&bytes, &mut at)
                                  when Option::None then Option::None
                                  when Option::Some(lineage_module_hi) then
                                    match v2_read_u64(&bytes, &mut at)
                                    when Option::None then Option::None
                                    when Option::Some(lineage_module_lo) then
                                      match v2_read_i64(&bytes, &mut at)
                                      when Option::None then Option::None
                                      when Option::Some(lineage_number) then
                                        match v2_read_u64(&bytes, &mut at)
                                        when Option::None then Option::None
                                        when Option::Some(lineage_hi) then
                                          match v2_read_u64(&bytes, &mut at)
                                          when Option::None then Option::None
                                          when Option::Some(lineage_lo) then
                                            match server_read_text(&bytes, &mut at)
                                            when Option::None then Option::None
                                            when Option::Some(kind) then
                                              match server_read_text(&bytes, &mut at)
                                              when Option::None then Option::None
                                              when Option::Some(display_key) then
                                                match v2_read_u64(&bytes, &mut at)
                                                when Option::None then Option::None
                                                when Option::Some(decl_hi) then
                                                  match v2_read_u64(&bytes, &mut at)
                                                  when Option::None then Option::None
                                                  when Option::Some(decl_lo) then
                                                    let package = StablePackageId {
                                                      key: package_key,
                                                      digest_hi: package_hi,
                                                      digest_lo: package_lo
                                                    }
                                                    let module_package = StablePackageId {
                                                      key: module_package_key,
                                                      digest_hi: module_package_hi,
                                                      digest_lo: module_package_lo
                                                    }
                                                    let module = StableModuleId {
                                                      package: module_package,
                                                      path: module_path,
                                                      digest_hi: module_hi,
                                                      digest_lo: module_lo
                                                    }
                                                    let lineage_package = StablePackageId {
                                                      key: lineage_package_key,
                                                      digest_hi: lineage_package_hi,
                                                      digest_lo: lineage_package_lo
                                                    }
                                                    let lineage_module_package = StablePackageId {
                                                      key: lineage_module_package_key,
                                                      digest_hi: lineage_module_package_hi,
                                                      digest_lo: lineage_module_package_lo
                                                    }
                                                    let lineage_module = StableModuleId {
                                                      package: lineage_module_package,
                                                      path: lineage_module_path,
                                                      digest_hi: lineage_module_hi,
                                                      digest_lo: lineage_module_lo
                                                    }
                                                    let lineage = DeclLineageId {
                                                      package: lineage_package,
                                                      module: lineage_module,
                                                      lineage: lineage_number,
                                                      digest_hi: lineage_hi,
                                                      digest_lo: lineage_lo
                                                    }
                                                    let decl = StableDeclId {
                                                      package: package,
                                                      module: module,
                                                      lineage: lineage,
                                                      kind: kind,
                                                      display_key: display_key,
                                                      digest_hi: decl_hi,
                                                      digest_lo: decl_lo
                                                    }
                                                    if v2_decl_digests_ok(decl.clone()) then
                                                      Option::Some(decl)
                                                    else
                                                      Option::None
                                                    end
                                                  end
                                                end
                                              end
                                            end
                                          end
                                        end
                                      end
                                    end
                                  end
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# A StablePlaceId rides as its DIGEST WORDS + canonical text render (the
# structural record needs a type table the wire does not carry); the
# decoder re-parses the text with the total no-table parser and requires
# the digest words to agree — a mismatch fails closed. The text render is
# diagnostic-cargo, but here it is the canonical reconstruction input, and
# the digest compare makes any ambiguity detectable.
def v2_push_place(inout out: Vec[u8], place: StablePlaceId) -> Unit
  server_push_text(out, stable_place_text_of(place.clone()))
  v2_push_u64(out, place.digest_hi)
  v2_push_u64(out, place.digest_lo)
end

def v2_read_place(bytes: Vec[u8], inout at: Int) -> Option[StablePlaceId]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(text) then
    match v2_read_u64(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(digest_hi) then
      match v2_read_u64(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(digest_lo) then
        match stable_place_of_text(&text)
        when Option::None then Option::None
        when Option::Some(place) then
          if place.digest_hi == digest_hi && place.digest_lo == digest_lo then
            Option::Some(place)
          else
            Option::None
          end
        end
      end
    end
  end
end

# A StableMirStmtId rides structurally (dense id + canonical key + digest
# words); the decoder rebuilds it through stable_mir_stmt_of_key and
# requires every field to agree — a forged key or dense id fails closed.
def v2_push_mir_stmt(inout out: Vec[u8], stmt: StableMirStmtId) -> Unit
  v2_push_i64(out, stmt.dense_id)
  server_push_text(out, stmt.stable_key.clone())
  v2_push_u64(out, stmt.digest_hi)
  v2_push_u64(out, stmt.digest_lo)
end

def v2_read_mir_stmt(bytes: Vec[u8], inout at: Int) -> Option[StableMirStmtId]
  match v2_read_i64(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(dense_id) then
    match server_read_text(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(key) then
      match v2_read_u64(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(digest_hi) then
        match v2_read_u64(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(digest_lo) then
          match stable_mir_stmt_of_key(&key)
          when Option::None then Option::None
          when Option::Some(stmt) then
            if stmt.dense_id == dense_id && stmt.digest_hi == digest_hi && stmt.digest_lo == digest_lo then
              Option::Some(stmt)
            else
              Option::None
            end
          end
        end
      end
    end
  end
end

def v2_push_target(inout out: Vec[u8], target: SemanticTargetId) -> Unit
  match target
  when SemanticTargetId::Decl(decl) then
    server_push_u32(out, V2_ID_DECL)
    v2_push_decl(out, decl)
  when SemanticTargetId::Place(place) then
    server_push_u32(out, V2_ID_PLACE)
    v2_push_place(out, place)
  when SemanticTargetId::MirStmt(stmt) then
    server_push_u32(out, V2_ID_MIR_STMT)
    v2_push_mir_stmt(out, stmt)
  end
end

def v2_read_target(bytes: Vec[u8], inout at: Int) -> Option[SemanticTargetId]
  match server_read_u32(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(tag) then
    if tag == V2_ID_DECL then
      match v2_read_decl(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(decl) then Option::Some(SemanticTargetId::Decl(decl))
      end
    elsif tag == V2_ID_PLACE then
      match v2_read_place(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(place) then Option::Some(SemanticTargetId::Place(place))
      end
    elsif tag == V2_ID_MIR_STMT then
      match v2_read_mir_stmt(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(stmt) then Option::Some(SemanticTargetId::MirStmt(stmt))
      end
    else
      Option::None
    end
  end
end

def v2_push_operation_id(inout out: Vec[u8], id: SemanticOperationId) -> Unit
  v2_push_i64(out, id.dense_id)
  v2_push_u64(out, id.digest_hi)
  v2_push_u64(out, id.digest_lo)
end

def v2_read_operation_id(bytes: Vec[u8], inout at: Int) -> Option[SemanticOperationId]
  match v2_read_i64(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(dense_id) then
    match v2_read_u64(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(digest_hi) then
      match v2_read_u64(&bytes, &mut at)
      when Option::None then Option::None
      when Option::Some(digest_lo) then
        let id = SemanticOperationId {
          dense_id: dense_id,
          digest_hi: digest_hi,
          digest_lo: digest_lo
        }
        match semantic_operation_name_of(id.clone())
        when Option::None then Option::None
        when Option::Some(_) then Option::Some(id)
        end
      end
    end
  end
end

# The typed §33 request fields, and its canonical text-grammar render (the
# existing query adapter still consumes the text form).
def v2_push_slice_request(inout out: Vec[u8], request: MirSliceRequest) -> Unit
  server_push_text(out, request.function_key.clone())
  server_push_u32(out, v2_mir_slice_kind_code(request.kind.clone()))
  server_push_text(out, request.anchor.clone())
end

def v2_read_slice_request(bytes: Vec[u8], inout at: Int) -> Option[MirSliceRequest]
  match server_read_text(&bytes, &mut at)
  when Option::None then Option::None
  when Option::Some(function_key) then
    match server_read_u32(&bytes, &mut at)
    when Option::None then Option::None
    when Option::Some(kind_code) then
      match v2_mir_slice_kind_of_code(kind_code)
      when Option::None then Option::None
      when Option::Some(kind) then
        match server_read_text(&bytes, &mut at)
        when Option::None then Option::None
        when Option::Some(anchor) then
          Option::Some(MirSliceRequest {
            function_key: function_key,
            kind: kind,
            anchor: anchor
          })
        end
      end
    end
  end
end

def v2_slice_request_text(request: MirSliceRequest) -> String
  v2_mir_slice_kind_word(request.kind.clone()) + "|" + request.function_key + "|" + request.anchor
end

