  when "replay.minimal_causal_slice" then
    schema_no_arg_op("replay.minimal_causal_slice".to_string(), "replay".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
      Vec::new(), ToolStability::Experimental,
      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      schema_artifacts(false, false, false, false, false, false, true, false),
      schema_gated("replay.minimal_causal_slice_unavailable".to_string()))
  when "replay.record" then
    schema_no_arg_op("replay.record".to_string(), "replay".to_string(),
      schema_result1("rows".to_string(), RecordFamily::Rows),
