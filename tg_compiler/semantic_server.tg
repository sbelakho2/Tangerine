      DeterminismClass::Deterministic, QueryCostClass::EngineWalk,
      schema_artifacts(false, false, false, false, false, false, true, false),
      schema_gated("replay.value_at_unavailable".to_string()))
  when "replay.causal_predecessors" then
    schema_text_op("replay.causal_predecessors".to_string(), "replay".to_string(),
      "event".to_string(), TextKind::RowGrammar,
      schema_result1("rows".to_string(), RecordFamily::Rows),
