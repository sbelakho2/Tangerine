# Tangerine Compiler — Stable Semantic Identity Domains (audit §27)
# Self-hosting compiler written in Tangerine
#
# The STABLE face of the semantic domains — the revision-surviving
# identities the §29 snapshot / §31 delta / §32 index / §33 slice / §35
# repair / §36 budget / §37 patch rows key on — as strong records that
# separate:
#   DENSE ids  — per-compilation table indexes (TypeId.id, TraitId.id,
#                ImplId.id, MirBlockId.id, a statement index, the §11
#                CapabilityId band). A dense id exists only inside ONE
#                compilation's local tables; it NEVER survives a revision
#                and must NEVER be required where a semantic identity is
#                needed (a synthesized entity, or an external key, has no
#                dense id — both store -1).
#   STABLE ids — the canonical KEY TEXT plus the 128-bit STABLE DIGEST
#                (ids.tg StableDigest — stable_digest_of over the
#                length-prefixed canonical key) of that text. The digest is
#                the identity projection; the stored key makes an actual
#                digest collision detectable (ids.tg's collision policy: a
#                real collision is an internal failure, never a
#                counter-disambiguated identity). Because the digest is a
#                pure function of the key text, canonical-key TEXT equality
#                IS semantic identity equality — the §31/§36/§37 text
#                comparisons are semantic comparisons (stable_key_eq is the
#                ONE comparison to use); digest words are the
#                collision-detection cargo and the future digest-keyed map
#                key.
#
# THE RECORDS (one per domain; payload mirrors repair_candidates'
# StableSymbolId — the digest pair digest_hi/digest_lo — plus the dense
# slot). The key grammars are the EXISTING row-key grammars, mirrored here
# WITHOUT importing their producers (the identity layer stays a leaf over
# ids.tg / repair_candidates.tg):
#
#   Domain record       | dense id (when one exists)      | canonical stable key grammar
#   --------------------+---------------------------------+------------------------------------
#   StableTypeId        | TypeId.id                       | def digest key "path::name#sig"
#   StableTraitId       | TraitId.id                      | def digest key "path::name#sig"
#   StableImplId        | ImplId.id                       | def digest key (no rows exist yet — KEY GAP below)
#   StableContractId    | none (-1)                       | §31 contract row key "fn|Pre|Post|Invariant|clause"
#   StableEffectId      | none (-1)                       | §31 effect-row key = subject def digest key
#   StableCapabilityId  | parsed "cap<id>" (§11 fixed id) | §31 capability row key "fn|cap<id>|Requires|Provides"
#   StableInstanceId    | none (-1)                       | instance emission key "<fn-owner key>$<arg renders>"
#   StableMirFunctionId | none (-1)                       | def digest key of the def-keyed lowering
#   StableMirBlockId    | MirBlockId.id (parsed)          | §33 block key "<fn key>#B<block id>"
#   StableMirStmtId     | stmt index (parsed; -1 = "#T")  | §33 node key "<fn key>#B<block>#S<idx>" / "#T"
#   StableTestId        | none (-1)                       | def digest key of the test function
#   StableAbiSurfaceId  | none (-1)                       | def digest key of the exported fn
#
# SymbolId (the audit's symbol-domain name) IS repair_candidates'
# StableSymbolId — one record, never duplicated; re-exported unchanged.
#
# String authority is NOT removed here: every §29-§37 row table and
# membership set keeps its String keys (this slice is ADDITIVE — no call
# site changes). What this module removes is the authority of ad-hoc text
# comparison: stable_key_eq is the documented semantic comparison, and the
# typed accessors (stable_*_of_key) plus the from-existing constructors
# (stable_*_from_def / stable_symbol_of_key / stable_from_def_key) are the
# seam a later migration re-keys the residual String maps through (the
# inventory is the final section). DETERMINISM: key texts are canonical;
# digests are pure functions of them; dense ids never participate.

use std::core::{Option}
use std::collections::{Vec}

use tg_compiler::ids::{StableDigest, StableDefId, stable_digest_of}

use tg_compiler::repair_candidates::{StableSymbolId}

pub use tg_compiler::repair_candidates::{StableSymbolId}

# ———————————————————————————————————————————————————————————————
# 1. The domain records (each: dense_id + stable_key + digest pair —
#    mirroring StableSymbolId's digest pair; dense_id = -1 when the
#    compilation has no dense id for the entity)
# ———————————————————————————————————————————————————————————————
# A nominal TYPE declaration (the §29 SemanticType Struct/Enum rows).
struct StableTypeId
  dense_id: Int = -1   # TypeId.id of the producing TypeEnv, when one exists
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TRAIT declaration (the §29 Trait-kind rows); dense = TraitId.id.
struct StableTraitId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An IMPL declaration; dense = ImplId.id. KEY GAP (documented): no snapshot
# row family keys impls today (an impl method's registration key is the
# type-EXPRESSION text of the impl, which semantic_snapshot.tg never
# re-renders; the §32 type_impls index keys by the self-type's def key).
# The record reserves the def-key grammar for impl rows a later slice
# materializes.
struct StableImplId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 CONTRACT ROW: canonical key = the composite
# "fn-key|Pre|Post|Invariant|clause" (delta_contract_row_key — the clause is
# the LAST component and may itself contain '|'). No dense id.
struct StableContractId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 EFFECT ROW: the row identity is its SUBJECT function (delta keys
# effect rows by function.key alone; the summary's dirty word is row
# CONTENT, never identity). No dense id.
struct StableEffectId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 CAPABILITY ROW: the composite "fn-key|cap<id>|Requires|Provides"
# key of delta_capability_row_key; dense = the fixed §11 CapabilityId.id
# parsed from the "cap<id>" part, -1 when the key does not parse.
struct StableCapabilityId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A monomorphized INSTANCE: canonical key = the instance emission key (the
# fn-owner-key base "<module path>::<index>::<kind>" + mangle_name's
# "$"-joined canonical arg renders). No dense id (the MonoCache is keyed by
# the emission text itself).
struct StableInstanceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A def-keyed lowered MirFunction (the §29 MirSemanticSummary rows, keyed
# by the function's def digest key). dense = -1 (the MirProgram.functions
# Vec ordinal is not an identity; the §33 slice domain keys the same
# functions by EMISSION names — a documented residual, final section).
struct StableMirFunctionId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR BLOCK: canonical key "<fn key>#B<block id>"; dense =
# MirBlockId.id parsed from the key.
struct StableMirBlockId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR STATEMENT / TERMINATOR: "<fn key>#B<block id>#S<stmt index>"
# (terminator "#T" — its index is the block's statement count, so the
# spellings never collide). dense = the parsed statement index; -1 for "#T".
struct StableMirStmtId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TEST function (the §29 TestRelationship rows / the §40 TestId
# vocabulary, keyed by the test function's def digest key). No dense id.
struct StableTestId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An ABI-surface row (the §30 abi_hash domain: pub top-level non-generic
# Function defs, keyed by their def digest key). No dense id.
struct StableAbiSurfaceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———————————————————————————————————————————————————————————————
# 2. Canonical-key derivation helpers (the row-key grammars mirrored)
# ———————————————————————————————————————————————————————————————

# The registration key of a declaration — "path::name" (root module: the
# bare name). Byte-identical to semantic_snapshot.tg snapshot_qualified_key.
pub def stable_registration_key(module_path: Vec[String], name: String) -> String
  let joined = module_path.join("::")
  if joined.is_empty() then name.clone() else joined + "::" + name.clone() end
end

# The full def digest key "registration-key#signature" — the canonical key
# stable_def_id_digested digests for every def row of the snapshot.
pub def stable_def_key(reg_key: String, signature: String) -> String
  reg_key + "#" + signature
end

# The module-path component of a key (before the LAST "::"; "" for a
# root-scoped declaration) — the snapshot_key_module grammar.
pub def stable_key_module(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(0, pos - 2)
    end
    pos = pos - 1
  end
  "".to_string()
end

# The name component of a key (after the LAST "::") — snapshot_key_name.
pub def stable_key_name(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(pos, key.len())
    end
    pos = pos - 1
  end
  key.clone()
end

# The byte index of `needle` at or after `from` (-1 when absent) — the
# byte-text scan idiom of semantic_delta / repair_candidates.
def stable_index_of(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The entity name-part of a def digest key (before the FIRST "#") — the
# delta_key_name_part grammar.
pub def stable_key_name_part(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

# The signature component of a def digest key (after the first "#"; "" when
# the key has none).
pub def stable_key_signature(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then "".to_string() else key.slice(i + 1, key.len()) end
end

# The instance emission key: the fn-owner-key base + "$" + the canonical
# arg renders joined by "$" — mangle_name's grammar (mono.tg). The renders
# arrive canonical from the caller (type_canon_render CanonInternal /
# type_to_mangled / the snapshot type text) in InstanceId.substs DECLARATION
# order — substitutions are POSITIONAL (Vec<int,str> vs Vec<str,int>), so
# the renders are never sorted before joining; each render is itself
# deterministic (the audit's "sorted renders" is realized by the renders'
# determinism, never by reordering the args).
pub def stable_instance_key(def_key: String, arg_renders: Vec[String]) -> String
  var key = def_key + "$"
  var first = true
  for ty in arg_renders do
    if !first then
      key = key + "$"
    end
    key = key + ty
    first = false
  end
  key
end

# The §33 statement / terminator node keys (slice_stmt_key / slice_term_key
# grammars).
pub def stable_mir_stmt_key(fn_key: String, block_id: Int, stmt_idx: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#S" + stmt_idx.to_string()
end

pub def stable_mir_term_key(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#T"
end

# The §31 capability / contract row keys (delta_capability_row_key /
# delta_contract_row_key grammars; direction = "Requires"/"Provides",
# kind_word = "Pre"/"Post"/"Invariant" — the clause is final and may
# contain '|').
pub def stable_capability_row_key(fn_key: String, cap_id: Int, direction: String) -> String
  fn_key + "|cap" + cap_id.to_string() + "|" + direction
end

pub def stable_contract_row_key(fn_key: String, kind_word: String, clause: String) -> String
  fn_key + "|" + kind_word + "|" + clause
end

# ———————————————————————————————————————————————————————————————
# 3. The semantic comparisons (the String-authority rule)
# ———————————————————————————————————————————————————————————————
# Canonical stable-key texts ARE the semantic identity (digests are pure
# functions of the key text), so byte equality of two canonical key texts
# is identity equality. Use this helper — never an ad-hoc ==, never a
# name/path parse — at every §31/§36/§37 stable-key comparison (delta key
# comparisons, budget membership, patch affected-key checks). A migration
# that re-keys a map by digest compares words with ids.tg's stable_digest_eq
# over stable_key_digest's result.
pub def stable_key_eq(a: String, b: String) -> Bool
  a == b
end

# The 128-bit stable digest of a canonical key — the identity projection
# (records rebuilt from a key by the *_of_key accessors always agree with
# records built from an existing StableDefId by the *_from_def constructors).
pub def stable_key_digest(key: String) -> StableDigest
  stable_digest_of(&key)
end

# ———————————————————————————————————————————————————————————————
# 4. The typed accessors and from-existing constructors
# ———————————————————————————————————————————————————————————————
# The def-key shape test: a def digest key is "registration-key#signature"
# with a NON-EMPTY registration part (the signature may be empty). Every
# def-keyed row of the snapshot/delta/index tables carries this shape. The
# DOMAIN of a def key is decided by the producing row's kind metadata (a
# TypeName row is a type, a Function row a fn ...) — never by the key text
# — so the def-family accessors return Some for every well-shaped def key
# and the caller picks the record its row table owns.
def stable_def_key_shape(key: String) -> Bool
  stable_index_of(key, "#", 0) > 0
end

# Whether a text is all ASCII digits (the numeric-key-component check).
def stable_is_digits(text: String) -> Bool
  if text.len() == 0 then return false end
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch < "0" || ch > "9" then
      return false
    end
    i = i + 1
  end
  true
end

# The deterministic Int value of a non-empty ASCII-digit text.
def stable_text_to_int(text: String) -> Int
  var value = 0
  var i = 0
  while i < text.len() do
    let bs = text.slice(i, i + 1).bytes()
    if bs.len() > 0 then
      value = value * 10 + (bs[0] as Int - 48)
    end
    i = i + 1
  end
  value
end

# The digest words of a canonical key as the record's (hi, lo) fields.
def stable_words_of(key: String) -> (UInt, UInt)
  let d = stable_digest_of(&key)
  (d.hi, d.lo)
end

# The dense-id projection of Option[Int]: Some(id) rides the record
# verbatim; None (no dense id exists — a synthesized entity or an external
# key) is stored as -1. Dense ids never survive a revision.
def stable_dense_of(dense: Option[Int]) -> Int
  match dense
  when Option::Some(v) then v
  when Option::None then -1
  end
end

# The §36/§37 builder over the audit's SymbolId record: the EXACT canonical
# def-key payload (stable_key = the def digest key text, digest over that
# text) — the payload an allowed_symbols entry must carry to equal a §31
# delta key exactly (change_budget.tg's identity rule).
pub def stable_symbol_of_key(key: String) -> StableSymbolId
  let d = stable_digest_of(&key)
  StableSymbolId { key: key.clone(), path: key, digest_hi: d.hi, digest_lo: d.lo }
end

# The §35 advisory-vocabulary builder over a canonical def key (the audit's
# stable_from_def_key): kind_text scopes the key ("fn", "type", "local",
# ... — rc_stable_symbol's vocabulary over def keys instead of display
# texts). Advisory only: the kind-prefixed key NEVER equals a §31 delta key
# — the exact-match builder is stable_symbol_of_key.
pub def stable_from_def_key(kind_text: String, key: String) -> StableSymbolId
  let full = kind_text + "::" + key
  let d = stable_digest_of(&full)
  StableSymbolId { key: full, path: key, digest_hi: d.hi, digest_lo: d.lo }
end

# ———— Def-family typed accessors (dense_id = -1: a key text carries no
# dense id; attach the local table's id through the *_from_def constructors
# when one exists) ————

# The domain record of a TYPE row's def digest key.
pub def stable_type_of_key(key: String) -> Option[StableTypeId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTypeId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

pub def stable_trait_of_key(key: String) -> Option[StableTraitId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTraitId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An impl's def digest key (the reserved impl-rows grammar — see the
# record doc's KEY GAP).
pub def stable_impl_of_key(key: String) -> Option[StableImplId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableImplId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An effect row's subject-function def digest key.
pub def stable_effect_of_key(key: String) -> Option[StableEffectId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableEffectId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A def-keyed lowering's def digest key.
pub def stable_mir_function_of_key(key: String) -> Option[StableMirFunctionId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableMirFunctionId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A test function's def digest key.
pub def stable_test_of_key(key: String) -> Option[StableTestId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTestId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An ABI surface row's def digest key.
pub def stable_abi_surface_of_key(key: String) -> Option[StableAbiSurfaceId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableAbiSurfaceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# ———— Def-family from-existing constructors (copy the EXISTING digest
# words and key of the row's StableDefId — never recomputed — and attach
# the dense id of the producing compilation's local table; pass
# Option::None when no dense id exists — stored as -1) ————

pub def stable_type_from_def(sid: StableDefId, dense: Option[Int]) -> StableTypeId
  StableTypeId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_trait_from_def(sid: StableDefId, dense: Option[Int]) -> StableTraitId
  StableTraitId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_effect_from_def(sid: StableDefId, dense: Option[Int]) -> StableEffectId
  StableEffectId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_mir_function_from_def(sid: StableDefId, dense: Option[Int]) -> StableMirFunctionId
  StableMirFunctionId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_test_from_def(sid: StableDefId, dense: Option[Int]) -> StableTestId
  StableTestId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_abi_surface_from_def(sid: StableDefId, dense: Option[Int]) -> StableAbiSurfaceId
  StableAbiSurfaceId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

# ———— Composite-row typed accessors (the §31 row-key grammars) ————

# A contract row key "fn-key|Pre|Post|Invariant|clause": the first two
# components must be a def digest key and a kind word; the clause is the
# final component (may contain '|', may be empty).
pub def stable_contract_of_key(key: String) -> Option[StableContractId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let kind_word = key.slice(i1 + 1, i2)
  if kind_word != "Pre" && kind_word != "Post" && kind_word != "Invariant" then
    return Option::None
  end
  let w = stable_words_of(&key)
  Option::Some(StableContractId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A capability row key "fn-key|cap<id>|Requires|Provides": the middle part
# must be "cap<digits>" and the direction word one of the two spellings.
# The parsed CapabilityId.id rides the record's dense slot.
pub def stable_capability_of_key(key: String) -> Option[StableCapabilityId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let cap_part = key.slice(i1 + 1, i2)
  if !cap_part.starts_with("cap") then return Option::None end
  let cap_digits = cap_part.slice(3, cap_part.len())
  if !stable_is_digits(&cap_digits) then return Option::None end
  let dir_part = key.slice(i2 + 1, key.len())
  if dir_part != "Requires" && dir_part != "Provides" then return Option::None end
  let cap_id = stable_text_to_int(&cap_digits)
  let w = stable_words_of(&key)
  Option::Some(StableCapabilityId {
    dense_id: cap_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# An instance emission key: the fn-owner-key base never contains "#B" and
# the mangle_name grammar always appends "$" (an empty arg list still
# yields "base$").
pub def stable_instance_of_key(key: String) -> Option[StableInstanceId]
  let dollar = stable_index_of(key, "$", 0)
  if dollar <= 0 then return Option::None end
  if stable_index_of(key, "#B", 0) >= 0 then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableInstanceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A §33 block key "<fn key>#B<block digits>": a "#B" marker, all-digit
# block text, and NO "#S"/"#T" node suffix after it. The parsed MirBlockId
# rides the record's dense slot.
pub def stable_mir_block_of_key(key: String) -> Option[StableMirBlockId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      return Option::None
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 then return Option::None end
  let block_id = stable_text_to_int(&block_text)
  let w = stable_words_of(&key)
  Option::Some(StableMirBlockId {
    dense_id: block_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# A §33 node key "<fn key>#B<block>#S<idx>" or "<fn key>#B<block>#T": the
# block text must be all digits and the node suffix exactly "#S<digits>"
# (statement) or "#T" (terminator — dense stays -1).
pub def stable_mir_stmt_of_key(key: String) -> Option[StableMirStmtId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  var stmt_dense = -1
  if key.slice(i, key.len()) == "#T" then
    stmt_dense = -1
  else
    if key.slice(i, i + 2) != "#S" then return Option::None end
    let idx_text = key.slice(i + 2, key.len())
    if !stable_is_digits(&idx_text) then return Option::None end
    stmt_dense = stable_text_to_int(&idx_text)
  end
  let w = stable_words_of(&key)
  Option::Some(StableMirStmtId {
    dense_id: stmt_dense,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# ———————————————————————————————————————————————————————————————
# 5. Residual string-keyed semantic maps (the migration inventory)
# ———————————————————————————————————————————————————————————————
# This slice changes no call sites. The String-keyed semantic-authority
# sites a later migration re-keys through the records above:
#   §29 rows   — semantic_model.tg rows carry StableDefId values whose .key
#                TEXT is sorted/rendered; the symbol rows ARE the def domain
#                (SymbolId = StableSymbolId).
#   §31 delta  — semantic_delta.tg keys every row table by key TEXT
#                (Map[String, String] row maps; EntityDelta.stable_id and
#                created/removed/affected are Strings; the delta_*_row_key
#                composites are mirrored here). Migrating = keying row maps
#                by digest words (stable_key_digest) and comparing through
#                stable_key_eq / stable_digest_eq.
#   §32 index  — semantic_index.tg read-side maps keyed by the §29 key TEXT
#                (callers/callees Map[String, Vec[String]], symbol_types/
#                effects/capabilities/contracts/type_* Map[String, ...]).
#   §33 slice  — semantic_slice.tg node keys embed the MirFunction EMISSION
#                name, not the def digest key; migrating that authority
#                needs the MirFunction.callable DefId -> def digest key join
#                first (a separate slice).
#   §35 repair — repair_candidates.tg StableSymbolId.key texts and
#                rc_stable_symbol's "<domain>::<text>" vocabulary (the
#                records are already digest-carrying — the audit's SymbolId).
#   §36 budget — change_budget.tg allowed_symbols: Set[StableSymbolId]
#                compared by .key TEXT against the delta's String key lists
#                (budget_symbol_allowed); allow_new_effects / capabilities
#                are the dense EffectId/CapabilityId bands.
#   §37 patch  — proof_patch.tg derives the affected-key and unsafe-marker
#                rows from the §31 delta's String keys.
#   mono/types/mir caches — MonoCache.instances: Map[String, MirFunction]
#                keyed by instance_key mangle texts (mono.tg:67 — the
#                audit's instance-cache anchor); types.tg / mir.tg
#                owner-key maps (typed_fn_signatures, fn_call_graph,
#                fn_ret_types ... keyed by fn_owner_key renders). These are
#                COMPILATION-internal caches: re-keying them is a separate
#                high-risk slice — StableInstanceId is the target, never a
#                prerequisite of this one.
