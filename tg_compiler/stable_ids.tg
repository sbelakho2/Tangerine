# ———————————————————————————————————————————————————————————————
# 8. §33 statement locators vs revision-stable semantic node identity
#    (audit item 47)
# ———————————————————————————————————————————————————————————————
# The §33 statement/terminator key texts "<fn key>#B<block id>#S<stmt
# index>" / "<fn key>#B<block id>#T" (the section-1 grammar above) are
# DENSE WITHIN-SNAPSHOT LOCATORS: the statement's ordinal IS the key, so
# one simple unrelated insertion mid-block renumbers every later "#S"
# index of the block — the whole remaining tail of the block's node
# domain. The REVISION-STABLE identity of the same node is CONTENT-derived
# instead. Item 47 separates the faces as two records:
#
#   SnapshotMirLocator    — the dense locator as a record:
#                           function_key + block_ordinal (the MirBlockId.id
#                           the §33 grammar embeds) + stmt_ordinal (the
#                           statement index; -1 = the block TERMINATOR, the
#                           "#T" form — the same dense -1 spelling
#                           stable_mir_stmt_of_key parses). Round-trips
#                           with the §33 node key texts through
#                           snapshot_mir_locator_text /
#                           snapshot_mir_locator_of_key. A locator is only
#                           meaningful against ONE compilation's block/
#                           statement layout (the statement's index is its
#                           position, never its content): rows whose site
#                           fields carry these texts (the snapshot's
#                           indirect-call "<caller>#B<block>#T" sites, the
#                           slice layers' statement lists) reference the
#                           snapshot's own lowering; the locator is never a
#                           revision comparison key.
#   StableSemanticNodeId  — the revision-surviving identity of the node
#                           BEHIND a locator: owning function key +
#                           operation kind word + destination key text +
#                           operand key texts in RENDER ORDER (op
#                           semantics are order-sensitive — a binop's two
#                           operands are NEVER sorted) + predecessor
#                           context (below) + the 128-bit digest words of
#                           the canonical content-key text
#                           (stable_mir_node_key_text). Two nodes with the
#                           same pieces and the same predecessor context
#                           are THE SAME semantic node; the pieces are the
#                           collision-detection cargo / diagnostics surface
#                           and Eq/Hash fold the digest words only, like
#                           every section-6/7 record.
#
# PREDECESSOR-CONTEXT SEMANTICS (the chain): the predecessor_context of a
# node is the canonical content-key TEXT of the PREVIOUS statement in the
# same block — the block's §33 block key text "<fn key>#B<block id>" for
# the block's FIRST statement (the block entry marker). The identity of
# statement k therefore chains over the identities of 0..k-1, which is
# what makes an insertion mid-block re-key ONLY THE TAIL: an insertion
# before statement k leaves statements 0..k-1 byte-identical (same pieces,
# same predecessor chain) and re-keys exactly the chain from k onward —
# that tail-only re-keying is the audit item's documented acceptance ("a
# simple unrelated insertion should not renumber the ENTIRE identity
# domain"). An edit of one statement's own content re-keys that statement
# and its successors; an append at the block end re-keys nothing. The
# walk itself is per-block linear: deriving the id of node k reads the
# statements 0..k (the content-key text grows linearly with the position —
# documented cost; the derivation is a leaf over the same verified
# MirProgram the §33 slice layer walks).
#
# DENSE COMPONENTS that remain inside content keys BY DOCUMENTED POLICY
# (the §27/§33 boundaries the node key grammar already documents): an
# UNNAMED local renders its "l<id>" ordinal (the lowered program's own
# slot locator — the §27 dense local text of snapshot_local_name's
# grammar), control-flow targets render their MirBlockId.id numerics, and
# a type payload (a cast target, an aggregate element type, an instance
# substitution) renders its §33 type-table identity — the same dense
# ordinals the §33 key texts embed; they never renumber the node domain as
# a whole and are stable wherever the lowering itself is stable.
#
# CONTENT-KEY TEXT GRAMMAR (stable_mir_node_key_text): the five pieces —
# function_key, operation, dest_key, each operand text (in order),
# predecessor_context — as LENGTH-PREFIXED segments "<len>:<bytes>"
# concatenated. The length-prefixed concatenation is uniquely decodable,
# so two distinct piece vectors NEVER render to the same text: the digest
# words inherit the injectivity up to an actual 128-bit collision
# (detectable against the stored pieces at insert, never
# counter-disambiguated). The text is never re-parsed (the record pieces
# are the parse).
#
# WHERE THE DERIVATION LIVES: this module stays a leaf over ids.tg (the
# section-1 doctrine) — the records, the locator key grammar and the
# text-pieces constructor live here; rendering a MIR statement's pieces
# (operation/destination/operand texts from MirStatement/MirTerminator
# shapes over a MirProgram) lives in semantic_slice.tg (the layer with
# MirProgram access): its pub stable_node_id_of / stable_node_ids_of_slice
# build the StableSemanticNodeId records through stable_semantic_node_id_of
# below.

# The DENSE within-snapshot locator of one §33 node (grammar above):
# stmt_ordinal -1 = the block terminator ("#T"). Eq/Hash over the fields
# (a locator IS its position — the text is the identity, so field
# equality is full equality).
struct SnapshotMirLocator
  function_key: String
  block_ordinal: Int
  stmt_ordinal: Int
end

# The revision-stable identity of the semantic node behind a locator
# (section doc): the record pieces are the canonical content-key cargo;
# digest_hi/digest_lo are the 128-bit stable digest words of the canonical
# length-prefixed content-key text over ALL pieces.
struct StableSemanticNodeId
  function_key: String
  operation: String
  dest_key: String
  operands: Vec[String] = Vec::new()
  predecessor_context: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— The locator key grammar (the §33 node key texts, mirrored) ————

# The §33 node key text of a locator: "<fn key>#B<block id>#S<stmt index>"
# for a statement (stmt_ordinal >= 0), "<fn key>#B<block id>#T" for the
# terminator (stmt_ordinal < 0).
pub def snapshot_mir_locator_text(loc: SnapshotMirLocator) -> String
  var text = loc.function_key.clone() + "#B" + loc.block_ordinal.to_string()
  if loc.stmt_ordinal < 0 then
    text + "#T"
  else
    text + "#S" + loc.stmt_ordinal.to_string()
  end
end

# The locator of a §33 node key text: Option::None for any text that is
# not exactly "<fn key>#B<block digits>" followed by "#T" (the terminator
# — stmt_ordinal -1) or "#S<digits>" (a statement). Mirrors the
# stable_mir_stmt_of_key parse (same markers, same digit rules).
pub def snapshot_mir_locator_of_key(key: String) -> Option[SnapshotMirLocator]
  let mark = stable_index_of(&key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  var stmt_ord = -1
  if key.slice(i, key.len()) == "#T" then
    stmt_ord = -1
  else
    if key.slice(i, i + 2) != "#S" then return Option::None end
    let idx_text = key.slice(i + 2, key.len())
    if !stable_is_digits(&idx_text) then return Option::None end
    stmt_ord = stable_text_to_int(&idx_text)
  end
  Option::Some(SnapshotMirLocator {
    function_key: key.slice(0, mark),
    block_ordinal: stable_text_to_int(&block_text),
    stmt_ordinal: stmt_ord
  })
end

# ———— The content-key text grammar and the record constructor ————

# The length-prefixed segment "<len>:<bytes>" of the content-key grammar.
def stable_node_lenpref(piece: String) -> String
  piece.len().to_string() + ":" + piece
end

# The canonical content-key TEXT of a stable semantic node (the grammar
# the section doc defines): the five pieces as length-prefixed segments in
# fixed order — function_key, operation, dest_key, each operand text in
# render order, predecessor_context. The digest words of a node digest
# exactly this text.
pub def stable_mir_node_key_text(
  function_key: String,
  operation: String,
  dest_key: String,
  operands: Vec[String],
  predecessor_context: String
) -> String
  var text = stable_node_lenpref(function_key)
  text = text + stable_node_lenpref(operation)
  text = text + stable_node_lenpref(dest_key)
  for op in operands do
    text = text + stable_node_lenpref(op)
  end
  text + stable_node_lenpref(predecessor_context)
end

# The record of a content-key's pieces: digest words over the canonical
# length-prefixed text of the pieces (the section-6 doctrine — the pieces
# are the collision-detection cargo / diagnostics surface; the words are
# the identity). semantic_slice.tg's derivation (stable_node_id_of /
# stable_node_ids_of_slice — audit item 47) renders MIR statements into
# the pieces and calls this constructor.
pub def stable_semantic_node_id_of(
  function_key: String,
  operation: String,
  dest_key: String,
  operands: Vec[String],
  predecessor_context: String
) -> StableSemanticNodeId
  let text = stable_mir_node_key_text(
    function_key.clone(),
    operation.clone(),
    dest_key.clone(),
    operands.clone(),
    predecessor_context.clone()
  )
  let w = stable_words_of(&text)
  StableSemanticNodeId {
    function_key: function_key,
    operation: operation,
    dest_key: dest_key,
    operands: operands,
    predecessor_context: predecessor_context,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# ———— The Eq/Hash implementations (the digest-words fold) ————

impl Eq for SnapshotMirLocator
  # A locator IS its dense position: field equality (the canonical text is
  # a pure function of the fields, so equal fields are equal texts).
  def eq(self: Self, other: Self) -> Bool
    self.function_key == other.function_key &&
    self.block_ordinal == other.block_ordinal &&
    self.stmt_ordinal == other.stmt_ordinal
  end
end

impl Hash for SnapshotMirLocator
  # The canonical locator text's digest words through the unsigned fold
  # (equal locators have equal texts and therefore equal hashes).
  def hash(self: Self) -> Int
    let text = snapshot_mir_locator_text(self)
    let w = stable_words_of(&text)
    var h = 0
    h = ((h as UInt) * 31 + w.0) as Int
    h = ((h as UInt) * 31 + w.1) as Int
    h
  end
end

impl Eq for StableSemanticNodeId
  # Equality over the content-key digest words (equal pieces produce equal
  # canonical texts and therefore equal words; an actual 128-bit collision
  # is detectable against the stored pieces, never counter-disambiguated).
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableSemanticNodeId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# 9. STRUCTURED GENERIC-INSTANCE KEYS (audit item 49)
# ———————————————————————————————————————————————————————————————
# The structured face of the monomorphized-INSTANCE identity domain — the
# replacement model for the RENDERED-TEXT-CONCATENATION instance keys
# (mangle_name's "base$<arg renders>" text suffix — mono.tg's emission
# keys / MonoCache.instances Map[String, ...] keys / StableInstanceId's
# §1 text grammar). The audit's split: identity is a STRUCTURED record —
#
#   InstanceKey { callable: StableDeclId,
#                 type_args: Vec[CanonicalTypeKey],
#                 const_args: Vec[CanonicalConstValue] }
#
# — whose Eq and Hash FOLD THE DIGEST WORDS of the components (never a
# text concatenation with "$"). Each component carries its canonical key
# TEXT only as the collision-detection cargo / diagnostics surface (the
# section-6 doctrine): a real 128-bit collision is detectable against the
# stored texts at insert, never counter-disambiguated.
#
# THE KEY GRAMMAR THE CONSTRUCTORS PARSE (the grammar mono "actually
# uses" today): the emission-key suffix of mangle_name — the canonical
# CanonInternal-frame type renders (type_canon_render, types.tg:
# type_to_mangled) joined by "$". No render contains "$", so the suffix
# segments are unambiguous; the const-argument forms are exactly three
# disjoint render families, and NO type render starts with any of them
# (the type families are the primitives "int".."f64"/"unit"/"str"/...,
# the bracket-delimited forms "t<id>[...]", "fa[...]", "tuple(...)",
# "fnptr(...)", "ptr(...)", "eff(...)" ... and the dense words
# "param<n>", "dyn<id>", "var<id>", "err"):
#   "c<v>"              — a CONST VALUE argument (Type::Const(v)); the
#                         canonical text is "c" + v — sign included
#                         ("c-4") — byte-identical to the render of
#                         Type::Const(v) in the CanonInternal frame;
#   "constparam<n>"     — a FORWARDED const-parameter argument
#                         (Type::ConstParam — an enclosing declaration's
#                         parameter; n = its numeric GenericParamId);
#   "constsym(<tree>)"  — a SYMBOLIC const-EXPRESSION argument
#                         (Type::ConstSym — the ConstExprT tree rendered
#                         by const_sym_tree_render_numeric; the digest
#                         covers the whole segment byte-for-byte).
# Every other segment is a TYPE argument render. The classification is
# total and deterministic, so instance_key_of_renders (the mono-boundary
# constructor over the full declared-order positional render list) and
# instance_key_of (the audit constructor over the already-split lists)
# agree for every instance: a declaration fixes which of its declared
# positions are const parameters, and the grammar families are disjoint.
#
# CanonicalConstValue.kind is the VALUE-DOMAIN word of the row:
# "signed"/"unsigned" for a concrete VALUE (classified by the DECLARED
# scalar type of the const-parameter slot, when the caller holds it) and
# "constparam"/"constsym" for the two SYMBOLIC markers. A pure segment
# parse cannot recover the declared signedness (the canonical key grammar
# has ONE value form — the compiler's const domain is the host Int, and
# the declared scalar type is a property of the slot, never of the
# argument), so the parse tags value rows with the "signed" default and a
# caller that holds env.const_param_decl_types rebuilds the row with
# canonical_const_value_of("unsigned", v) — the digest words are the
# SAME either way (both value kinds digest the identical canonical text
# "c<v>"). kind is therefore ROW METADATA mirroring StableDeclId.kind:
# it is never consulted by Eq/Hash. The "constsym" marker's canonical
# text covers the tree bytes, so two different symbolic trees NEVER
# collide in the digest words even though value stays 0 — this is what
# keeps "2*N vs N*2" different as documented below.
#
# CONST-EXPRESSION NORMALIZATION MODEL (the audit's syntax-vs-semantics
# boundary): the canonical text of a symbolic tree is the tree as the
# LANGUAGE normalizes it. The ONLY declared equivalences are the IDENTITY
# FOLDS applied at the ConstSym fold helpers in types.tg
# (const_sym_tree_fold_identities, wired through const_sym_fold_type):
#   N + 0 -> N    0 + N -> N    N * 1 -> N
# Commutativity is NOT normalized: N + M and M + N stay DIFFERENT
# symbolic trees, and 2*N stays different from N*2 (the audit explicitly
# rejects syntax==semantic conflation without a defined model — the model
# here is exactly the identity rules above, nothing more). Two call-site
# spellings that fold to the same tree (N+0 vs N) therefore yield the
# same InstanceKey; spellings the model does not equate stay different.
#
# The callable component: the instance's callable is its fn-owner-key
# text (fn_owner_key_of_def — "<module path>::<index>::<kind word>"; the
# base of the emission key). stable_callable_decl_of parses that grammar
# into a StableDeclId whose lineage_key IS the full key text (digested
# whole — module path + index + kind word all ride the lineage, since
# the fn-owner grammar has no "#signature" split) and whose module_key /
# kind are the parse pieces (module_key = the text before the LAST "::",
# kind = the word after it). A callable text that is not fn-owner-shaped
# (a method template's "Type__method" emission name, a hand-built test
# name) falls back to the full-lineage form with empty pieces — identity
# is the digest of the whole text either way (mirror of
# stable_symbol_of_key's unparsed fallback).
#
# THREADING (additive; the residual inventory is section 5): the mono
# boundary computes the structured key ONCE per instantiation site —
# mono.tg's structured_instance_key / the MonoCache.structured_keys
# companion map (text key -> InstanceKey) filled at the same points where
# instance_key renders the text key today (the work-queue drain pop, the
# monomorphize_instance and mono_specialize_function entry points). The
# Map[String, ...] caches (MonoCache.instances, the worklist seen-set,
# the rewrite lookups) keep their text keys in THIS slice — re-keying
# them by digest words is the section-5 migration, whose records are
# defined here.
#
# instance_key_to_text is the DIAGNOSTICS render of a structured key: the
# callable text, then each type-arg text, then each const-arg canonical
# text, "$"-joined. Value and constparam rows re-render their canonical
# segment text byte-for-byte ("c4", "constparam5"); a "constsym" row
# re-renders as "constsym(<hi>,<lo>)" — its digest words — because the
# tree spelling was folded/canonicalized out of the row (the identity is
# the digest; documented degradation mirroring stable_fp_unparsed's empty
# parse pieces).

# ———— The records ————

# ONE type-argument identity of an instance: text = the canonical
# CanonInternal render of the argument type; digest words over that text.
struct CanonicalTypeKey
  text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE const-argument identity of an instance (section doc): kind =
# "signed"/"unsigned" (a concrete VALUE) or the symbolic markers
# "constparam"/"constsym"; value = the host-Int value, the numeric
# GenericParamId of a forwarded parameter, or 0 for a tree. The digest
# words digest the canonical const SEGMENT text ("c<v>",
# "constparam<n>", or the whole "constsym(<tree>)" segment as parsed).
struct CanonicalConstValue
  kind: String
  value: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The structured identity of one monomorphized instance (section doc):
# callable = the fn-owner-key declaration, type_args = the type
# arguments in DECLARED position order, const_args = the const
# arguments in DECLARED position order. Eq/Hash fold the digest words —
# never a "$"-joined text.
struct InstanceKey
  callable: StableDeclId
  type_args: Vec[CanonicalTypeKey] = Vec::new()
  const_args: Vec[CanonicalConstValue] = Vec::new()
end

# ———— Segment classification helpers ————

# Whether a word is one of the fn-owner-key kind words (fn_owner_key's
# DefKind rendering — fn_owner_key in types.tg).
def stable_is_kind_word(word: String) -> Bool
  word == "fn" || word == "method" || word == "static" || word == "const" ||
  word == "variant" || word == "field" || word == "intrinsic" ||
  word == "type" || word == "trait" || word == "other"
end

# The StableDeclId of a callable key text (section doc): the fn-owner
# grammar "<module path>::<index>::<kind word>" parses module_key =
# before the last "::" and kind = the word after it; every other text
# falls back to the full-lineage form (empty pieces). The digest words
# digest the FULL callable key text in both forms.
def stable_callable_decl_of(callable_key_text: String) -> StableDeclId
  var last = -1
  var i = 0
  while i + 2 <= callable_key_text.len() do
    if callable_key_text.slice(i, i + 2) == "::" then
      last = i
    end
    i = i + 1
  end
  if last >= 0 then
    let kind_word = callable_key_text.slice(last + 2, callable_key_text.len())
    if stable_is_kind_word(&kind_word) then
      let w = stable_words_of(&callable_key_text)
      return StableDeclId {
        module_key: callable_key_text.slice(0, last),
        kind: kind_word,
        lineage_key: callable_key_text.clone(),
        digest_hi: w.0,
        digest_lo: w.1
      }
    end
  end
  let w = stable_words_of(&callable_key_text)
  StableDeclId {
    module_key: "".to_string(),
    kind: "".to_string(),
    lineage_key: callable_key_text.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The canonical const text of a row (the diagnostics re-render; for a
# "constsym" row the tree spelling is not retained — the digest words
# render instead, documented in the section doc).
def stable_const_text_of(c: CanonicalConstValue) -> String
  if c.kind == "signed" || c.kind == "unsigned" then
    "c" + c.value.to_string()
  elsif c.kind == "constparam" then
    "constparam" + c.value.to_string()
  else
    "constsym(" + c.digest_hi.to_string() + "," + c.digest_lo.to_string() + ")"
  end
end

# Parse a const VALUE segment "c<v>" (v = optional "-" then digits) —
# the CanonInternal render of Type::Const(v). kind = "signed" (the
# parse default — the grammar has one value form; see the section doc).
def stable_const_value_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() < 2 || segment.slice(0, 1) != "c" then
    return Option::None
  end
  var rest = segment.slice(1, segment.len())
  var neg = false
  if rest.len() > 0 && rest.slice(0, 1) == "-" then
    neg = true
    rest = rest.slice(1, rest.len())
  end
  if !stable_is_digits(&rest) then return Option::None end
  var v = stable_text_to_int(&rest)
  if neg then
    v = 0 - v
  end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue { kind: "signed".to_string(), value: v, digest_hi: w.0, digest_lo: w.1 })
end

# Parse a FORWARDED const-parameter segment "constparam<n>" (n = the
# numeric GenericParamId of the enclosing parameter).
def stable_const_param_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() <= 10 || segment.slice(0, 10) != "constparam" then
    return Option::None
  end
  let id_text = segment.slice(10, segment.len())
  if !stable_is_digits(&id_text) then return Option::None end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue {
    kind: "constparam".to_string(),
    value: stable_text_to_int(&id_text),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# Parse a SYMBOLIC const-EXPRESSION segment "constsym(<tree render>)":
# the whole segment is the canonical text (the tree bytes digest);
# value stays 0. Option::Some for exactly the parenthesized form
# ("constsym(" is the 9-byte prefix; the canonical tree renders are
# never empty, so a segment of length >= 10 with the prefix and a
# closing ")" is the exact form).
def stable_const_sym_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() < 10 then return Option::None end
  if segment.slice(0, 9) != "constsym(" then return Option::None end
  if segment.slice(segment.len() - 1, segment.len()) != ")" then return Option::None end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue {
    kind: "constsym".to_string(),
    value: 0,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The const row of a mangle-suffix SEGMENT: Option::Some for exactly the
# three const render families ("c<v>" / "constparam<n>" /
# "constsym(<tree>)"), Option::None for a type render.
pub def canonical_const_of_segment(segment: String) -> Option[CanonicalConstValue]
  match stable_const_value_of_segment(&segment)
  when Option::Some(v) then Option::Some(v)
  when Option::None then
    match stable_const_param_of_segment(&segment)
    when Option::Some(p) then Option::Some(p)
    when Option::None then stable_const_sym_of_segment(&segment)
    end
  end
end

# ———— Constructors ————

# The type-key row of one canonical type render (text kept as the
# collision-detection cargo / diagnostics surface; words over the text).
pub def canonical_type_key_of(render: String) -> CanonicalTypeKey
  let w = stable_words_of(&render)
  CanonicalTypeKey { text: render, digest_hi: w.0, digest_lo: w.1 }
end

# The const row of a (kind, value) pair classified by a caller that
# holds the const parameter's DECLARED scalar type: kind "signed" or
# "unsigned" builds the VALUE row over the canonical text "c<value>";
# kind "constparam" builds the forwarding row over "constparam<value>".
# Any other kind word defaults to the value form — the only form a
# (kind, value) pair can faithfully express (a "constsym" TREE row
# cannot be built from a value — use canonical_const_of_segment over the
# tree's rendered segment). The digest words are identical for both
# value kinds (one value form in the key grammar — see the section doc),
# so identity never depends on the kind label.
pub def canonical_const_value_of(kind: String, value: Int) -> CanonicalConstValue
  var text = "c" + value.to_string()
  if kind == "constparam" then
    text = "constparam" + value.to_string()
  end
  let w = stable_words_of(&text)
  CanonicalConstValue { kind: kind, value: value, digest_hi: w.0, digest_lo: w.1 }
end

# The audit constructor: the callable's fn-owner key text plus the
# ALREADY-SPLIT argument lists (the caller holds the declared
# const/type split) — type_arg_renders become CanonicalTypeKey rows in
# order, const_arg_values ride as given.
pub def instance_key_of(
  callable_key_text: String,
  type_arg_renders: Vec[String],
  const_arg_values: Vec[CanonicalConstValue]
) -> InstanceKey
  var type_keys: Vec[CanonicalTypeKey] = Vec::new()
  for render in type_arg_renders do
    type_keys.push(canonical_type_key_of(&render))
  end
  InstanceKey {
    callable: stable_callable_decl_of(&callable_key_text),
    type_args: type_keys,
    const_args: const_arg_values
  }
end

# The TOTAL positional constructor (the mono boundary): the full
# declared-order render list of the emission suffix, classified by the
# segment grammar (const families vs type renders) — the classification
# is exact and deterministic, so this constructor and instance_key_of
# agree for every instance (a declaration fixes the const/type split,
# and the families are disjoint).
pub def instance_key_of_renders(callable_key_text: String, arg_renders: Vec[String]) -> InstanceKey
  var type_keys: Vec[CanonicalTypeKey] = Vec::new()
  var const_rows: Vec[CanonicalConstValue] = Vec::new()
  for segment in arg_renders do
    match canonical_const_of_segment(&segment)
    when Option::Some(cv) then const_rows.push(cv)
    when Option::None then type_keys.push(canonical_type_key_of(&segment))
    end
  end
  InstanceKey {
    callable: stable_callable_decl_of(&callable_key_text),
    type_args: type_keys,
    const_args: const_rows
  }
end

# The DIAGNOSTICS render of a structured key (section doc): the
# callable's full key text, then the type-arg texts, then the const-arg
# canonical texts, "$"-joined. Diagnostic only — the emission text of an
# instance remains mangle_name's render (the mono mangling boundary).
pub def instance_key_to_text(key: InstanceKey) -> String
  var text = key.callable.lineage_key.clone()
  for ty in key.type_args do
    text = text + "$" + ty.text
  end
  for cv in key.const_args do
    text = text + "$" + stable_const_text_of(cv)
  end
  text
end

# ———— Equality and hashing (digest words only) ————

# The digest-word equality of two structured instance keys: the callable
# words, then the type-arg rows and the const-arg rows POSITIONALLY (in
# declared order — the vectors are never sorted). Two instances of the
# same declaration are equal exactly when every aligned argument row is
# equal.
pub def instance_key_eq(a: InstanceKey, b: InstanceKey) -> Bool
  if a.callable.digest_hi != b.callable.digest_hi then return false end
  if a.callable.digest_lo != b.callable.digest_lo then return false end
  if a.type_args.len() != b.type_args.len() then return false end
  if a.const_args.len() != b.const_args.len() then return false end
  var i = 0
  while i < a.type_args.len() do
    if a.type_args[i].digest_hi != b.type_args[i].digest_hi then return false end
    if a.type_args[i].digest_lo != b.type_args[i].digest_lo then return false end
    i = i + 1
  end
  var j = 0
  while j < a.const_args.len() do
    if a.const_args[j].digest_hi != b.const_args[j].digest_hi then return false end
    if a.const_args[j].digest_lo != b.const_args[j].digest_lo then return false end
    j = j + 1
  end
  true
end

impl Eq for CanonicalTypeKey
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for CanonicalTypeKey
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for CanonicalConstValue
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for CanonicalConstValue
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for InstanceKey
  def eq(self: Self, other: Self) -> Bool
    instance_key_eq(self, other)
  end
end

impl Hash for InstanceKey
  # The structured fold: the callable's digest words, then every
  # type-arg row's digest words and every const-arg row's digest words,
  # folded through the unsigned 64-bit view (the section-6 fold). The
  # hash is a pure function of the digest words — never of a "$"-joined
  # text.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.callable.digest_hi) as Int
    h = ((h as UInt) * 31 + self.callable.digest_lo) as Int
    var i = 0
    while i < self.type_args.len() do
      h = ((h as UInt) * 31 + self.type_args[i].digest_hi) as Int
      h = ((h as UInt) * 31 + self.type_args[i].digest_lo) as Int
      i = i + 1
    end
    var j = 0
    while j < self.const_args.len() do
      h = ((h as UInt) * 31 + self.const_args[j].digest_hi) as Int
      h = ((h as UInt) * 31 + self.const_args[j].digest_lo) as Int
      j = j + 1
    end
    h
  end
end
