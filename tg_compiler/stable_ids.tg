# Tangerine Compiler — Stable Semantic Identity Domains (audit §27)
# Self-hosting compiler written in Tangerine
#
# The STABLE face of the semantic domains — the revision-surviving
# identities the §29 snapshot / §31 delta / §32 index / §33 slice / §35
# repair / §36 budget / §37 patch rows key on — as strong records that
# separate:
#   DENSE ids  — per-compilation table indexes (TypeId.id, TraitId.id,
#                ImplId.id, MirBlockId.id, a statement index, the §11
#                CapabilityId band). A dense id exists only inside ONE
#                compilation's local tables; it NEVER survives a revision
#                and must NEVER be required where a semantic identity is
#                needed (a synthesized entity, or an external key, has no
#                dense id — both store -1).
#   STABLE ids — the canonical KEY TEXT plus the 128-bit STABLE DIGEST
#                (ids.tg StableDigest — stable_digest_of over the
#                length-prefixed canonical key) of that text. The digest is
#                the identity projection; the stored key makes an actual
#                digest collision detectable (ids.tg's collision policy: a
#                real collision is an internal failure, never a
#                counter-disambiguated identity). Because the digest is a
#                pure function of the key text, canonical-key TEXT equality
#                IS semantic identity equality — the §31/§36/§37 text
#                comparisons are semantic comparisons (stable_key_eq is the
#                ONE comparison to use); digest words are the
#                collision-detection cargo and the future digest-keyed map
#                key.
#
# DECLARATION IDENTITY vs SIGNATURE FINGERPRINT (the audit's symbol split,
# section 6; third-audit item 11; fourth-audit P0-1): a def digest key
# "path::name#sig" carries TWO orthogonal identities. The DECLARATION
# identity is the PERSISTENT lineage number the DeclLineageStore assigned
# once — renaming or moving the declaration keeps it — digested over
# (package, lineage, kind domain) ONLY; the CURRENT module path, the
# declared name and the signature are REVISION METADATA / fingerprints
# (the store records them, the id never digests them), so one declaration
# moved from a::foo to b::foo keeps the SAME StableDeclId. The registration
# text is bootstrap / diagnostics cargo.
# The SIGNATURE FINGERPRINT — the parsed "#sig" text — digests over the
# sig component. Changing foo(Int)->Int to foo(Int,Int)->Int is therefore
# ONE declaration whose signature changed — a §31 signature-CHANGE pairing
# of the same entity, never a remove/create pairing (a phantom
# removed-then-recreated symbol row). The split records are StableDeclId /
# SignatureFingerprint / StableSymbolId (section 6; the def-keyed semantic
# tables key by StableDeclId — section 5 records each table's key state).
#
# THE RECORDS (one per domain; payload mirrors the digest pair
# digest_hi/digest_lo of repair_candidates.tg's §35 advisory symbol record
# — plus the dense slot). The key grammars are the EXISTING row-key
# grammars, mirrored here WITHOUT importing their producers (the identity
# layer stays a leaf over ids.tg):
#
#   Domain record       | dense id (when one exists)      | canonical stable key grammar
#   --------------------+---------------------------------+------------------------------------
#   StableTypeId        | TypeId.id                       | def digest key "path::name#sig"
#   StableTraitId       | TraitId.id                      | def digest key "path::name#sig"
#   StableImplId        | ImplId.id (attach at row build) | §7 impl text "trait_key|self_pattern|binders|preds"
#   StableContractId    | none (-1)                       | §31 contract row key "fn|Pre|Post|Invariant|clause"
#   StableEffectId      | none (-1)                       | §31 effect-row key = subject def digest key
#   StableCapabilityId  | parsed "cap<id>" (§11 fixed id) | §31 capability row key "fn|cap<id>|Requires|Provides"
#   StableInstanceId    | none (-1)                       | instance emission key "<fn-owner key>$<arg renders>"
#   StableMirFunctionId | none (-1)                       | def digest key of the def-keyed lowering
#   StableMirBlockId    | MirBlockId.id (parsed)          | §33 block key "<fn key>#B<block id>"
#   StableMirStmtId     | stmt index (parsed; -1 = "#T")  | §33 node key "<fn key>#B<block>#S<idx>" / "#T"
#   StableMirEdgeId     | source block id (parsed)        | §33 edge key "<fn key>#B<from>#E<to>"
#   StableCallId        | block id (parsed)               | §33 call site "<fn key>#B<block>#T#C"
#   StableAllocationSiteId | stmt index (-1 = terminator) | §33 node key of the allocating statement/terminator
#   SnapshotMirLocator  | block/stmt ordinals (parsed)    | §33 node key "<fn key>#B<block>#S<idx>" / "#T"
#   StableSemanticNodeId| none (-1)                       | item-47 role key (fn|hir-node / op+role_seq|role)
#   StableDecl lineage  | none (-1)                       | persistent store number (pkg|lineage|kind); module/name/sig are metadata
#   MemberLineageId     | none (-1)                       | persistent member number (owner identity|member kind|lineage); index/name are locator/metadata (P0-4)
#   BinderLineageId     | none (-1)                       | per-function persistent binder number (owner identity|lineage); seq is a locator (P0-4)
#   HirNodeLineageId    | none (-1)                       | per-owner persistent HIR-node number (owner identity|lineage); seq/anchor are locator/metadata (P0-4)
#   StableTestId        | none (-1)                       | def digest key of the test function
#   StableAbiSurfaceId  | none (-1)                       | def digest key of the exported fn
#   StableImplMethodId  | none (-1)                       | §7 impl method text = impl text "#" method name
#   StableLocalId       | none (-1)                       | structural instance + persistent binder lineage (typed); display name is metadata (P0-4/P0-6)
#   StablePlaceId       | none (-1)                       | typed root local + stable projections (typed)
#   StableValueId       | none (-1)                       | §7 value row text (reserved grammar)
#   StableDropGlueId    | none (-1)                       | §7 origin row key "drop-glue::<type key>"
#   StableClosureId     | none (-1)                       | §7 origin row key "closure::<emission key>"
#   StableDerivedBodyId | none (-1)                       | §7 origin row key "derived::<kind>::<key>"
#   StableShimId        | none (-1)                       | §7 origin row key "shim::<surface key>"
#   StructuralInstanceId| none (-1)                       | stable callable declaration + CanonicalGenericArg vector in declared order (P0-5/P0-6)
#
# (The record families of sections 6-7 replace the flat stable_key text of
# the table above with PARSE PIECES — declaration lineage + signature
# fingerprint for a def key, the impl-text components, the place-root and
# projection chain, ... — while keeping the digest pair as the identity;
# the pieces are the collision-detection cargo / the diagnostics surface
# and never replace the key text for identity.)
#
# SymbolId (the audit's symbol-domain name) IS THIS MODULE's StableSymbolId
# (section 6) — the split record {StableDeclId declaration lineage,
# SignatureFingerprint, full key text} — defined here, replacing the
# earlier delegation. repair_candidates.tg's same-named record remains the
# §35 ADVISORY vocabulary's record, unchanged, in repair_candidates.tg (its
# consumers import it directly; this module no longer imports or
# re-exports it).
#
# String authority is removed where the semantic tables key: the §31/§32/
# §36 maps key by the typed identities — StableDeclId / StableRowKey
# (sections 6-10; section 5 records every table's key state) — and the
# residual String carriers are the canonical-TEXT protocol rows, the §35
# advisory vocabulary and the compilation-internal caches. The §36/§37
# builders stable_symbol_of_key / stable_from_def_key are REBUILT over the
# section-6 record (they had no in-tree callers) and the former
# repair_candidates StableSymbolId re-export is dropped (its consumers
# import that record from repair_candidates directly). What this module
# removes is the authority of ad-hoc text comparison: stable_key_eq is the
# documented semantic comparison, and the typed accessors
# (stable_*_of_key) plus the from-existing constructors
# (stable_*_from_def / stable_symbol_of_key / stable_from_def_key) are the
# boundary parse seam (identity records digest the canonical text).
# DETERMINISM: key texts are canonical; digests are pure functions of
# them; dense ids never participate.
#
# ITEM 5 (the re-key this seam was built for) LANDS the two composite
# identities the semantic tables key on: def-keyed maps key by
# StableDeclId (section 6 — the declaration lineage; a signature edit is
# the same key with a changed StableSymbolId.full_key, never a
# remove/create pair), and composite row maps (call rows, capability
# pairs, ownership rows, contract rows) key by StableRowKey (section 10 —
# subject decl + domain + suffix + the full row text). The row-key
# builders parse once at the snapshot boundary (decl_id_of_full_key /
# stable_row_key_of), the digest words are the Eq/Hash authority, and the
# canonical text rides each record for diagnostics, protocol rendering and
# the stable_key_collision_check insert-site verification. The MonoCache
# instance cache / the monomorphizer's worklist are keyed by the
# structural StructuralInstanceId (section 9 — audit item 49; fourth-audit
# P0-5/P0-6); the types / mir compilation caches stay text-keyed (the
# documented residual).

use std::core::{Option, Result}
use std::collections::{Vec}

# (fourth-audit P0-2) The lineage store's ATOMIC persistence seam: the
# save text plus the repository's transactional publication pattern
# (write "<path>.tmp", then rename into place — the linker's publication
# discipline, linker.tg:2037-2097). std::fs::rename is the POSIX/Windows
# atomic-replace primitive; stable_ids stays a leaf over ids.tg for
# IDENTITY, never a leaf over the filesystem.
use std::fs::{write_file_bytes, rename, delete_file, file_exists, IoError}

use tg_compiler::ids::{StableDigest, StableDefId, stable_digest_of}

# ———————————————————————————————————————————————————————————————
# 1. The domain records (each: dense_id + stable_key + digest pair —
#    mirroring the digest pair of the §35 advisory symbol record; dense_id
#    = -1 when the compilation has no dense id for the entity)
# ———————————————————————————————————————————————————————————————
# A nominal TYPE declaration (the §29 SemanticType Struct/Enum rows).
struct StableTypeId
  dense_id: Int = -1   # TypeId.id of the producing TypeEnv, when one exists
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TRAIT declaration (the §29 Trait-kind rows); dense = TraitId.id.
struct StableTraitId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An IMPL declaration; dense = ImplId.id of the producing env's impls
# table when one exists. The §1 placeholder record (a def-digest-key KEY
# GAP shape — no snapshot row family keys impls; an impl method's
# registration key is the type-EXPRESSION text of the impl, which
# semantic_snapshot.tg never re-renders; the §32 type_impls index keys by
# the self-type's def key) is SUPERSEDED by section 7 (audit item 7): the
# canonical impl identity is the IMPL TEXT over the types.tg ImplInfo
# registration data (trait key, self type pattern, generic binders, where
# predicates) — StableImplId / StableImplMethodId / StableLocalId /
# StablePlaceId / StableValueId and the generated-executable ids live in
# section 7, with stable_impl_of_key rebuilt over the impl text.

# A §31 CONTRACT ROW: canonical key = the composite
# "fn-key|Pre|Post|Invariant|clause" (delta_contract_row_key — the clause is
# the LAST component and may itself contain '|'). No dense id.
struct StableContractId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 EFFECT ROW: the row identity is its SUBJECT function (delta keys
# effect rows by function.key alone; the summary's dirty word is row
# CONTENT, never identity). No dense id.
struct StableEffectId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 CAPABILITY ROW: the composite "fn-key|cap<id>|Requires|Provides"
# key of delta_capability_row_key; dense = the fixed §11 CapabilityId.id
# parsed from the "cap<id>" part, -1 when the key does not parse.
struct StableCapabilityId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A monomorphized INSTANCE: canonical key = the instance emission key (the
# fn-owner-key base "<module path>::<index>::<kind>" + mangle_name's
# "$"-joined canonical arg renders). No dense id (the MonoCache is keyed by
# the emission text itself).
struct StableInstanceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A def-keyed lowered MirFunction (the §29 MirSemanticSummary rows, keyed
# by the function's def digest key). dense = -1 (the MirProgram.functions
# Vec ordinal is not an identity; the §33 slice domain keys the same
# functions by EMISSION names — a documented residual, final section).
struct StableMirFunctionId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR BLOCK: canonical key "<fn key>#B<block id>" (the LOCATOR form —
# dense = MirBlockId.id parsed from the key) or, for the P0-7 semantic
# identity, "<fn key>#B@<hi>-<lo>" (the CONTROL-origin digest words;
# semantic = true, dense = -1).
struct StableMirBlockId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  semantic: Bool = false
end

# The block-id clone: the canonical key text duplicates, the dense/digest
# words and the semantic flag are immediates. Registered because block
# origins ride MirBlock as Option[StableMirBlockId].
impl Clone for StableMirBlockId
  def clone(self: Self) -> StableMirBlockId
    StableMirBlockId {
      dense_id: self.dense_id,
      stable_key: self.stable_key.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo,
      semantic: self.semantic
    }
  end
end

# A §33 MIR STATEMENT / TERMINATOR: "<fn key>#B<block id>#S<stmt index>"
# (terminator "#T" — its index is the block's statement count, so the
# spellings never collide). dense = the parsed statement index; -1 for "#T".
struct StableMirStmtId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR EDGE: canonical key "<fn key>#B<block id>#E<successor id>" —
# the source block's terminator edge to one successor (a MirGoto target,
# a MirSwitchInt arm target or its default target, a MirAssert's
# target). dense = the parsed SOURCE block id (the MirBlockId the edge
# leaves from); the successor id rides the key text only. The PGO
# edge-probability rows key here (third-audit item 39).
struct StableMirEdgeId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 CALL SITE: canonical key "<fn key>#B<block id>#T#C" — a MIR
# block carries exactly ONE terminator and a call terminator IS the call
# site, so (owner callable instance, block id) is the site identity. The
# "#C" suffix keeps the key disjoint from the block's "#T" terminator
# node key. dense = the parsed block id. The PGO call-frequency rows key
# here (third-audit item 39).
struct StableCallId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# AN ALLOCATION SITE: the canonical key is the §33 NODE key of the
# allocating node — a STATEMENT site "<fn key>#B<block>#S<idx>" (the
# §11 string-concat Add-over-strings lowering) or a TERMINATOR site
# "<fn key>#B<block>#T" (an allocating MirCall). The allocating node IS
# the site, so the domain reuses the node grammar. dense = the parsed
# statement index (-1 for a terminator site). The PGO allocation-
# frequency rows key here (third-audit item 39).
struct StableAllocationSiteId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TEST function (the §29 TestRelationship rows / the §40 TestId
# vocabulary, keyed by the test function's def digest key). No dense id.
struct StableTestId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An ABI-surface row (the §30 abi_hash domain: pub top-level non-generic
# Function defs, keyed by their def digest key). No dense id.
struct StableAbiSurfaceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The registered Clone surface of the §29-§33 row-id records: every one of
# these carries the same (dense id, canonical key text, digest words)
# shape, so the clone duplicates the key text and keeps the integer id and
# digest words verbatim. Registered because the semantic snapshot/delta row
# records carry these ids as fields.
impl Clone for StableTypeId
  def clone(self: Self) -> StableTypeId
    StableTypeId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableTraitId
  def clone(self: Self) -> StableTraitId
    StableTraitId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableContractId
  def clone(self: Self) -> StableContractId
    StableContractId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableEffectId
  def clone(self: Self) -> StableEffectId
    StableEffectId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableCapabilityId
  def clone(self: Self) -> StableCapabilityId
    StableCapabilityId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableInstanceId
  def clone(self: Self) -> StableInstanceId
    StableInstanceId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableMirFunctionId
  def clone(self: Self) -> StableMirFunctionId
    StableMirFunctionId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableMirStmtId
  def clone(self: Self) -> StableMirStmtId
    StableMirStmtId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableMirEdgeId
  def clone(self: Self) -> StableMirEdgeId
    StableMirEdgeId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableCallId
  def clone(self: Self) -> StableCallId
    StableCallId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableAllocationSiteId
  def clone(self: Self) -> StableAllocationSiteId
    StableAllocationSiteId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableTestId
  def clone(self: Self) -> StableTestId
    StableTestId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for StableAbiSurfaceId
  def clone(self: Self) -> StableAbiSurfaceId
    StableAbiSurfaceId { dense_id: self.dense_id, stable_key: self.stable_key.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

# ———————————————————————————————————————————————————————————————
# 2. Canonical-key derivation helpers (the row-key grammars mirrored)
# ———————————————————————————————————————————————————————————————

# The registration key of a declaration — "path::name" (root module: the
# bare name). Byte-identical to semantic_snapshot.tg snapshot_qualified_key.
pub def stable_registration_key(module_path: Vec[String], name: String) -> String
  let joined = module_path.join("::")
  if joined.is_empty() then name.clone() else joined + "::" + name.clone() end
end

# The full def digest key "registration-key#signature" — the canonical key
# stable_def_id_digested digests for every def row of the snapshot.
pub def stable_def_key(reg_key: String, signature: String) -> String
  reg_key + "#" + signature
end

# The module-path component of a key (before the LAST "::"; "" for a
# root-scoped declaration) — the snapshot_key_module grammar.
pub def stable_key_module(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(0, pos - 2)
    end
    pos = pos - 1
  end
  "".to_string()
end

# The name component of a key (after the LAST "::") — snapshot_key_name.
pub def stable_key_name(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(pos, key.len())
    end
    pos = pos - 1
  end
  key.clone()
end

# The byte index of `needle` at or after `from` (-1 when absent) — the
# byte-text scan idiom of semantic_delta / repair_candidates.
def stable_index_of(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The entity name-part of a def digest key (before the FIRST "#") — the
# delta_key_name_part grammar.
pub def stable_key_name_part(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

# The signature component of a def digest key (after the first "#"; "" when
# the key has none).
pub def stable_key_signature(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then "".to_string() else key.slice(i + 1, key.len()) end
end

# The instance emission key: the fn-owner-key base + "$" + the canonical
# arg renders joined by "$" — mangle_name's grammar (mono.tg). The renders
# arrive canonical from the caller (type_canon_render CanonInternal /
# type_to_mangled / the snapshot type text) in InstanceId.substs DECLARATION
# order — substitutions are POSITIONAL (Vec<int,str> vs Vec<str,int>), so
# the renders are never sorted before joining; each render is itself
# deterministic (the audit's "sorted renders" is realized by the renders'
# determinism, never by reordering the args).
pub def stable_instance_key(def_key: String, arg_renders: Vec[String]) -> String
  var key = def_key + "$"
  var first = true
  for ty in arg_renders do
    if !first then
      key = key + "$"
    end
    key = key + ty
    first = false
  end
  key
end

# The §33 statement / terminator node keys (slice_stmt_key / slice_term_key
# grammars).
pub def stable_mir_stmt_key(fn_key: String, block_id: Int, stmt_idx: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#S" + stmt_idx.to_string()
end

pub def stable_mir_term_key(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#T"
end

# The §33 block key "<fn key>#B<block id>" (the StableMirBlockId grammar
# — the key the PGO "blk" rows and the profile consumers key through).
pub def stable_mir_block_key(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string()
end

# The §33 MIR edge key "<fn key>#B<from block>#E<successor block>"
# (StableMirEdgeId; third-audit item 39).
pub def stable_mir_edge_key(fn_key: String, from_block: Int, to_block: Int) -> String
  fn_key + "#B" + from_block.to_string() + "#E" + to_block.to_string()
end

# The §33 call-site key "<fn key>#B<block id>#T#C" (StableCallId;
# third-audit item 39).
pub def stable_call_key(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#T#C"
end

# The allocation-site key of a STATEMENT node
# "<fn key>#B<block>#S<idx>" (stable_mir_stmt_key's grammar — the
# allocating statement IS the site; third-audit item 39).
pub def stable_allocation_stmt_key(fn_key: String, block_id: Int, stmt_idx: Int) -> String
  stable_mir_stmt_key(fn_key, block_id, stmt_idx)
end

# The allocation-site key of a TERMINATOR node "<fn key>#B<block>#T"
# (stable_mir_term_key's grammar — an allocating call terminator;
# third-audit item 39).
pub def stable_allocation_term_key(fn_key: String, block_id: Int) -> String
  stable_mir_term_key(fn_key, block_id)
end

# The §31 capability / contract row keys (delta_capability_row_key /
# delta_contract_row_key grammars; direction = "Requires"/"Provides",
# kind_word = "Pre"/"Post"/"Invariant" — the clause is final and may
# contain '|').
pub def stable_capability_row_key(fn_key: String, cap_id: Int, direction: String) -> String
  fn_key + "|cap" + cap_id.to_string() + "|" + direction
end

pub def stable_contract_row_key(fn_key: String, kind_word: String, clause: String) -> String
  fn_key + "|" + kind_word + "|" + clause
end

# ———————————————————————————————————————————————————————————————
# 3. The semantic comparisons (the String-authority rule)
# ———————————————————————————————————————————————————————————————
# Canonical stable-key texts ARE the semantic identity (digests are pure
# functions of the key text), so byte equality of two canonical key texts
# is identity equality. Use this helper — never an ad-hoc ==, never a
# name/path parse — at every §31/§36/§37 stable-key comparison (delta key
# comparisons, budget membership, patch affected-key checks). A migration
# that re-keys a map by digest compares words with ids.tg's stable_digest_eq
# over stable_key_digest's result.
pub def stable_key_eq(a: String, b: String) -> Bool
  a == b
end

# The 128-bit stable digest of a canonical key — the identity projection
# (records rebuilt from a key by the *_of_key accessors always agree with
# records built from an existing StableDefId by the *_from_def constructors).
pub def stable_key_digest(key: String) -> StableDigest
  stable_digest_of(&key)
end

# The length-prefixed identity segment "<len>:<bytes>" of the third-audit
# composite identity texts (sections 6-8): identity digests cover a
# length-prefixed concatenation so two distinct piece vectors NEVER render
# to the same text (the injectivity the section-8 node grammar relies on).
def stable_identity_lenpref(piece: String) -> String
  piece.len().to_string() + ":" + piece
end

# ———————————————————————————————————————————————————————————————
# 4. The typed accessors and from-existing constructors
# ———————————————————————————————————————————————————————————————
# The def-key shape test: a def digest key is "registration-key#signature"
# with a NON-EMPTY registration part (the signature may be empty). Every
# def-keyed row of the snapshot/delta/index tables carries this shape. The
# DOMAIN of a def key is decided by the producing row's kind metadata (a
# TypeName row is a type, a Function row a fn ...) — never by the key text
# — so the def-family accessors return Some for every well-shaped def key
# and the caller picks the record its row table owns.
def stable_def_key_shape(key: String) -> Bool
  stable_index_of(key, "#", 0) > 0
end

# Whether a text is all ASCII digits (the numeric-key-component check).
def stable_is_digits(text: String) -> Bool
  if text.len() == 0 then return false end
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch < "0" || ch > "9" then
      return false
    end
    i = i + 1
  end
  true
end

# The deterministic Int value of a non-empty ASCII-digit text.
def stable_text_to_int(text: String) -> Int
  var value = 0
  var i = 0
  while i < text.len() do
    let bs = text.slice(i, i + 1).bytes()
    if bs.len() > 0 then
      value = value * 10 + (bs[0] as Int - 48)
    end
    i = i + 1
  end
  value
end

# The deterministic UInt value of a non-empty ASCII-digit text (the store
# v2 codec's digest-word columns; the full unsigned 64-bit range).
def stable_text_to_uint(text: String) -> UInt
  var value: UInt = 0
  var i = 0
  while i < text.len() do
    let bs = text.slice(i, i + 1).bytes()
    if bs.len() > 0 then
      value = value * 10 + ((bs[0] as UInt) - 48)
    end
    i = i + 1
  end
  value
end

# The digest words of a canonical key as the record's (hi, lo) fields.
def stable_words_of(key: String) -> (UInt, UInt)
  let d = stable_digest_of(&key)
  (d.hi, d.lo)
end

# The dense-id projection of Option[Int]: Some(id) rides the record
# verbatim; None (no dense id exists — a synthesized entity or an external
# key) is stored as -1. Dense ids never survive a revision.
def stable_dense_of(dense: Option[Int]) -> Int
  match dense
  when Option::Some(v) then v
  when Option::None then -1
  end
end

# The §36/§37 builder over this module's StableSymbolId (section 6): the
# EXACT canonical def-key payload — the declaration lineage identity of the
# key's "path::name" part, the signature fingerprint of its "#sig" part,
# full_key = the def digest key text — the payload an allowed_symbols entry
# must carry to equal a §31 delta key exactly (change_budget.tg's identity
# rule; the key TEXT equality rule is unchanged — the §36 comparisons
# compare texts, and full_key carries the text verbatim). TOTAL (the legacy
# builder was total): a key without a "#signature" component builds the
# pure-lineage form — its fingerprint is the empty-sig fallback (digest of
# ""), which is the SAME fingerprint the shaped key "lineage#" carries
# (documented residual: no canonical row key omits the "#", so real §31
# delta keys are unaffected).
pub def stable_symbol_of_key(key: String) -> StableSymbolId
  match stable_symbol_id_of_full_key(&key)
  when Option::Some(s) then s
  when Option::None then
    let mkey = stable_key_module(&key)
    StableSymbolId {
      decl: stable_decl_id_of_lineage_texts_named(
        "".to_string(),
        mkey,
        stable_synthetic_lineage(&key),
        "".to_string(),
        key.clone()
      ),
      fingerprint: stable_fp_unparsed("".to_string()),
      full_key: key.clone()
    }
  end
end

# The §35 advisory-vocabulary builder over a canonical def key (the audit's
# stable_from_def_key): kind_text scopes the key ("fn", "type", "local",
# ... — rc_stable_symbol's vocabulary over def keys instead of display
# texts). Advisory only: the kind-prefixed key NEVER equals a §31 delta key
# — the exact-match builder is stable_symbol_of_key. The kind prefix rides
# the lineage text (so it digests), mirroring the legacy
# digest-over-the-full-prefixed-text scoping.
pub def stable_from_def_key(kind_text: String, key: String) -> StableSymbolId
  let full = kind_text + "::" + key
  stable_symbol_of_key(&full)
end

# ———— Def-family typed accessors (dense_id = -1: a key text carries no
# dense id; attach the local table's id through the *_from_def constructors
# when one exists) ————

# The domain record of a TYPE row's def digest key.
pub def stable_type_of_key(key: String) -> Option[StableTypeId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTypeId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

pub def stable_trait_of_key(key: String) -> Option[StableTraitId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTraitId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An effect row's subject-function def digest key.
pub def stable_effect_of_key(key: String) -> Option[StableEffectId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableEffectId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A def-keyed lowering's def digest key.
pub def stable_mir_function_of_key(key: String) -> Option[StableMirFunctionId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableMirFunctionId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A test function's def digest key.
pub def stable_test_of_key(key: String) -> Option[StableTestId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTestId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An ABI surface row's def digest key.
pub def stable_abi_surface_of_key(key: String) -> Option[StableAbiSurfaceId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableAbiSurfaceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# ———— Def-family from-existing constructors (copy the EXISTING digest
# words and key of the row's StableDefId — never recomputed — and attach
# the dense id of the producing compilation's local table; pass
# Option::None when no dense id exists — stored as -1) ————

pub def stable_type_from_def(sid: StableDefId, dense: Option[Int]) -> StableTypeId
  StableTypeId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_trait_from_def(sid: StableDefId, dense: Option[Int]) -> StableTraitId
  StableTraitId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_effect_from_def(sid: StableDefId, dense: Option[Int]) -> StableEffectId
  StableEffectId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_mir_function_from_def(sid: StableDefId, dense: Option[Int]) -> StableMirFunctionId
  StableMirFunctionId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_test_from_def(sid: StableDefId, dense: Option[Int]) -> StableTestId
  StableTestId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_abi_surface_from_def(sid: StableDefId, dense: Option[Int]) -> StableAbiSurfaceId
  StableAbiSurfaceId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

# ———— Composite-row typed accessors (the §31 row-key grammars) ————

# A contract row key "fn-key|Pre|Post|Invariant|clause": the first two
# components must be a def digest key and a kind word; the clause is the
# final component (may contain '|', may be empty).
pub def stable_contract_of_key(key: String) -> Option[StableContractId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let kind_word = key.slice(i1 + 1, i2)
  if kind_word != "Pre" && kind_word != "Post" && kind_word != "Invariant" then
    return Option::None
  end
  let w = stable_words_of(&key)
  Option::Some(StableContractId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A capability row key "fn-key|cap<id>|Requires|Provides": the middle part
# must be "cap<digits>" and the direction word one of the two spellings.
# The parsed CapabilityId.id rides the record's dense slot.
pub def stable_capability_of_key(key: String) -> Option[StableCapabilityId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let cap_part = key.slice(i1 + 1, i2)
  if !cap_part.starts_with("cap") then return Option::None end
  let cap_digits = cap_part.slice(3, cap_part.len())
  if !stable_is_digits(&cap_digits) then return Option::None end
  let dir_part = key.slice(i2 + 1, key.len())
  if dir_part != "Requires" && dir_part != "Provides" then return Option::None end
  let cap_id = stable_text_to_int(&cap_digits)
  let w = stable_words_of(&key)
  Option::Some(StableCapabilityId {
    dense_id: cap_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# An instance emission key: the fn-owner-key base never contains "#B" and
# the mangle_name grammar always appends "$" (an empty arg list still
# yields "base$").
pub def stable_instance_of_key(key: String) -> Option[StableInstanceId]
  let dollar = stable_index_of(key, "$", 0)
  if dollar <= 0 then return Option::None end
  if stable_index_of(key, "#B", 0) >= 0 then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableInstanceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A §33 block key: the LOCATOR form "<fn key>#B<block digits>" (dense = the
# parsed MirBlockId.id, semantic = false), or the P0-7 SEMANTIC form
# "<fn key>#B@<hi>-<lo>" (the control-origin digest words; dense = -1,
# semantic = true). A "#S"/"#T" node suffix after the block payload is
# rejected in both forms.
pub def stable_mir_block_of_key(key: String) -> Option[StableMirBlockId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  if i < key.len() && key.slice(i, i + 1) == "@" then
    let tail = key.slice(i + 1, key.len())
    let dash = stable_index_of(&tail, "-", 0)
    if dash <= 0 || dash + 1 >= tail.len() then return Option::None end
    if !stable_is_digits(&tail.slice(0, dash)) || !stable_is_digits(&tail.slice(dash + 1, tail.len())) then
      return Option::None
    end
    let w = stable_words_of(&key)
    return Option::Some(StableMirBlockId {
      dense_id: -1,
      stable_key: key.clone(),
      digest_hi: w.0,
      digest_lo: w.1,
      semantic: true
    })
  end
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      return Option::None
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 then return Option::None end
  let block_id = stable_text_to_int(&block_text)
  let w = stable_words_of(&key)
  Option::Some(StableMirBlockId {
    dense_id: block_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1,
    semantic: false
  })
end

# A §33 node key "<fn key>#B<block>#S<idx>" or "<fn key>#B<block>#T": the
# block text must be all digits and the node suffix exactly "#S<digits>"
# (statement) or "#T" (terminator — dense stays -1).
pub def stable_mir_stmt_of_key(key: String) -> Option[StableMirStmtId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  var stmt_dense = -1
  if key.slice(i, key.len()) == "#T" then
    stmt_dense = -1
  else
    if key.slice(i, i + 2) != "#S" then return Option::None end
    let idx_text = key.slice(i + 2, key.len())
    if !stable_is_digits(&idx_text) then return Option::None end
    stmt_dense = stable_text_to_int(&idx_text)
  end
  let w = stable_words_of(&key)
  Option::Some(StableMirStmtId {
    dense_id: stmt_dense,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# A §33 edge key "<fn key>#B<from digits>#E<to digits>": the block text
# after "#B" must be all digits and the successor suffix exactly
# "#E<digits>" to the key end. The parsed SOURCE block id rides the
# record's dense slot.
pub def stable_mir_edge_of_key(key: String) -> Option[StableMirEdgeId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var from_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    from_text = from_text + ch
    i = i + 1
  end
  if from_text.len() == 0 then return Option::None end
  if i + 2 > key.len() then return Option::None end
  if key.slice(i, i + 2) != "#E" then return Option::None end
  let to_text = key.slice(i + 2, key.len())
  if !stable_is_digits(&to_text) then return Option::None end
  let from_id = stable_text_to_int(&from_text)
  let w = stable_words_of(&key)
  Option::Some(StableMirEdgeId {
    dense_id: from_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# A §33 call-site key "<fn key>#B<block digits>#T#C": the block text
# after "#B" must be all digits and the suffix exactly "#T#C" to the key
# end. The parsed block id rides the record's dense slot.
pub def stable_call_of_key(key: String) -> Option[StableCallId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 then return Option::None end
  if key.slice(i, key.len()) != "#T#C" then return Option::None end
  let block_id = stable_text_to_int(&block_text)
  let w = stable_words_of(&key)
  Option::Some(StableCallId {
    dense_id: block_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# An allocation-site key: the §33 statement/terminator node key of the
# allocating node (the allocation-site domain's grammar IS the node
# grammar — see the record doc). A text outside the node grammar
# returns Option::None.
pub def stable_allocation_site_of_key(key: String) -> Option[StableAllocationSiteId]
  match stable_mir_stmt_of_key(key)
  when Option::Some(s) then
    Option::Some(StableAllocationSiteId {
      dense_id: s.dense_id,
      stable_key: s.stable_key,
      digest_hi: s.digest_hi,
      digest_lo: s.digest_lo
    })
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# 5. The per-table key state (the residual-text inventory)
# ———————————————————————————————————————————————————————————————
# The typed re-key has LANDED for the semantic tables (audit item 5) —
# each entry below records one table family's current key state and the
# String carriers that remain:
#   §29 rows   — semantic_model.tg rows carry StableDefId values whose .key
#                TEXT is sorted/rendered; the symbol rows ARE the def domain
#                (SymbolId = this module's section-6 StableSymbolId).
#   §31 delta  — MIGRATED (audit item 5): semantic_delta.tg's per-table
#                comparison maps key by the typed identities — symbol rows
#                Map[StableDeclId, SymbolRow] (value = the StableSymbolId +
#                payload; a signature edit is one decl with a changed
#                full_key, paired structurally instead of by name-part
#                text), effect/mir rows Map[StableDeclId, ...], call rows /
#                capability pairs / ownership rows / contract rows
#                Map[StableRowKey, ...]. The delta's PROTOCOL rows
#                (created/removed/affected key texts, EntityDelta.stable_id,
#                EdgeDelta.from/to, ContractDelta.contract_id, ...) stay
#                canonical-TEXT carriers rendered from the typed keys —
#                the text is attached cargo, never the comparison
#                authority. The item-41 affected-closure worklist stays
#                text-keyed (a derivative BFS frontier over canonical
#                texts; it reads the §32 index and snapshot rows directly).
#   §32 index  — MIGRATED (audit item 5): semantic_index.tg's maps key
#                by StableDeclId and the builder parses each row key ONCE
#                (stable_decl_of_key); the canonical full key text rides
#                the identity->text table def_texts (collision cargo /
#                protocol render source). type_layout_map is POPULATED by
#                the builder from the snapshot's persisted ABI TYPE rows
#                (build step 9 — index_abi_layout_text renders each value
#                "size=<n>;align=<n>;fields=<...>" from the layout engine;
#                a type with no successful ABI row keeps NO entry — never
#                a fabricated layout). The String-keyed accessors remain
#                as parse-at-the-boundary convenience wrappers; the
#                *_of_decl overloads take the typed key.
#   §33 slice  — semantic_slice.tg node keys embed the MirFunction EMISSION
#                name, not the def digest key; migrating that authority
#                needs the MirFunction.callable DefId -> def digest key join
#                first (a separate slice).
#   §35 repair — repair_candidates.tg's own advisory StableSymbolId.key
#                texts and rc_stable_symbol's "<domain>::<text>" vocabulary
#                (that digest-bearing §35 record is distinct from section
#                6's symbol-domain StableSymbolId and is not imported here).
#                Its consumers construct ChangeBudget.allowed_symbols with
#                StableDeclId entries (the §36 set below).
#   §36 budget — MIGRATED (audit item 5): allowed_symbols is
#                Set[StableDeclId] and budget membership compares digest
#                words (stable_decl_eq); the delta key TEXTS the checks
#                report stay texts (the violation lines render the
#                canonical key). allow_new_effects / capabilities remain
#                the dense EffectId/CapabilityId bands.
#   §37 patch  — proof_patch.tg derives the affected-key and unsafe-marker
#                rows from the §31 delta's protocol TEXT rows (the attached
#                canonical carriers); the typed comparison identities live
#                inside the delta's table maps, so the patch surface is
#                unchanged. repair_candidates.tg is untouched (advisory
#                vocabulary, no semantic-authority maps).
#   PGO profile — MIGRATED (third-audit item 39; fourth-audit P0-6): mir.tg's
#                PGO rows key by the stable domains — StructuralInstanceId
#                (function hotness, "fn|calls"), StableMirBlockId (block
#                execution count, "blk|exec"), StableMirEdgeId (edge
#                probability, "edge|prob"), StableCallId (call-site
#                frequency, "call|freq") and StableAllocationSiteId
#                (allocation-site frequency, "alloc|freq") — with the
#                canonical key texts built by stable_mir_block_key /
#                stable_mir_edge_key / stable_call_key /
#                stable_allocation_stmt_key / stable_allocation_term_key.
#                The legacy v1 PGO file's dense block ordinals are
#                converted at load and documented as revision-fragile
#                (mir.tg's PGO format doc).
#   mono/types/mir caches — MIGRATED (audit item 49; fourth-audit
#                P0-5/P0-6): MonoCache.instances is
#                Map[StructuralInstanceId, MirFunction] — the structural
#                record of section 9 (callable StableDeclId + the
#                CanonicalGenericArg vector in DECLARED cross-kind order),
#                never the rendered "$"-text — and the monomorphizer's
#                worklist seen-set is Set[StructuralInstanceId]; the
#                emission text survives only as the MirFunction.name label
#                DERIVED from the record, and every rewrite lookup derives
#                the structural instance once per instance via
#                structured_instance_key. No text-keyed mono cache remains.
#                types.tg / mir.tg owner-key maps (typed_fn_signatures,
#                fn_call_graph, fn_ret_types ... keyed by fn_owner_key
#                renders) stay text-keyed COMPILATION-internal caches — a
#                separate high-risk slice, StableInstanceId the target.
#                The checker's typed_call_instances (Map[Int, Vec[Type]]),
#                pending_call_instances and the MirConstant.instance
#                payloads are the text-free instance carriers.
#   member/binder/HIR — MIGRATED (fourth-audit P0-4): StableFieldId /
#                StableVariantId / StableBinderId / StableLocalId /
#                StableHirNodeId carry the persistent MemberLineageId /
#                BinderLineageId / HirNodeLineageId + a snapshot-locator
#                ordinal; the lineage store's v2 member/binder/HIR sections
#                persist them (stable_member_lineage_stamp_or_rebind /
#                stable_binder_lineage_stamp_or_rebind /
#                stable_hir_lineage_stamp_or_rebind), so inserting an
#                unrelated member/local/node before an existing one never
#                re-keys the survivor.
#   §7 reserved   — the domains of section 7 have NO row family to re-key
#                today: impl rows (the canonical impl text over ImplInfo's
#                registration data), impl-method rows, ownership place
#                texts (OwnershipFact.place_key and the place component of
#                the delta ownership row keys — digest-keyed through
#                StablePlaceId), local/value rows and the mir_functions
#                generated rows (snapshot_origin_key_text's non-Decl
#                families — digest-keyed through the four generated ids).
#                Section 7's records are the reserved identities the future
#                writers of those rows build through.
# ———————————————————————————————————————————————————————————————
# 6. Declaration lineage vs semantic fingerprint (the symbol split)
# ———————————————————————————————————————————————————————————————
# The audit's split of the def digest key "path::name#sig" into TWO
# orthogonal identities — a signature edit re-keys nothing; it changes ONE
# entity's fingerprint (an update pairing, never a remove/create pairing):
#
#   StableDeclId          — the DECLARATION (third-audit item 11;
#                           fourth-audit P0-1): the package record, the
#                           PERSISTENT DeclLineageId the store assigned
#                           once (rename/MOVE preserving) and the row-kind
#                           text; the 128-bit digest covers
#                           (package, lineage, kind) ONLY. The CURRENT
#                           module path and the name are store metadata,
#                           never identity. A text-only parse binds the
#                           deterministic synthetic lineage of the
#                           registration text (rename-fragile fallback —
#                           the store is the authority).
#   SignatureFingerprint  — the parsed "#sig" text of a CALLABLE def (fn /
#                           method — parse rules below) plus the digest of
#                           the FULL sig text as-is. The parse pieces are a
#                           diagnostics/rendering view; the digest words
#                           are the identity and always cover the text
#                           byte-for-byte, so a fingerprint built from a
#                           parse and a fingerprint built from the same
#                           text by the unparsed fallback agree exactly.
#   StableSymbolId        — decl + fingerprint + the full key text (the
#                           text is kept for diagnostics, rendering and
#                           ids.tg-style text verification of digest
#                           collisions at map-insert time).
#
# Eq/Hash (below) follow the id-record impl pattern of CapabilityId
# (types.tg:9073) over the DIGEST WORDS ONLY — words are the identity;
# texts are collision-detection cargo and the diagnostics surface (mirror
# of the StableDefId doctrine: a digest-keyed map insert text-verifies
# against the stored lineage/full-key text like ids.tg's stable-id
# registry, because an actual 128-bit collision is an internal failure,
# never a counter-disambiguated identity).
#
# PARSE RULES — signature_fingerprint_of_sig_text parses the canonical
# callable sig texts semantic_snapshot.tg renders (snapshot_fn_sig_text /
# snapshot_mir_fn_sig_text — semantic_snapshot.tg:422 and :434):
#
#   grammar:  "fn(" params ")->" return_type [effects]
#     params  = param ("," param)*          # the render joins with ","
#     param   = convention ":" type_text    # snapshot_conv_text words:
#                                           # "let" | "inout" | "sink" | "set"
#     effects = "" | "effects(" "e" id ("," "e" id)* ")"   # the declared
#                                           # effect ids, sorted, "e"-prefixed
#     type_text — snapshot_type_text's bracket-delimited type renders:
#       primitives ("int" .. "f64", "unit", "str" ...), Adt
#       "T[<qualified name>[arg]...]", FixedArray "A[elem;n]", the symbolic
#       "AS[elem;c<idx>]", FnPtr "F(conv:ty,...)->ret[effects]", Closure
#       "C(conv:ty,...)->ret{cap}[effects]", "Rmut[..]"/"Rref[..]",
#       "P[..]"/"Q[..]"/"D[..]", effects type "E{e...|inner}", tuples
#       "(a,b)", generic-binder references "P<idx>o<ownerNumeric>",
#       const-param references "CP<idx>", "const(v)", "var", "err".
#
#   A text parses (Option::Some) ONLY when it is exactly this callable
#   grammar. Every other def sig text — "" (a callable with no typed
#   record yet) and the type-row grammars "struct{...}", "enum{...}",
#   "trait{...}", "alias(...)" and declared-type renders — returns
#   Option::None; the symbol builders fall back to a digest-carrying
#   fingerprint with empty pieces (stable_fp_unparsed). Steps:
#     1. the text must open "fn(" at byte 0;
#     2. params = the text between "fn(" and the FIRST ")" that closes the
#        list — a depth scan over the three bracket families "()" "[]"
#        "{}"; canonical type texts are bracket-balanced, so the first
#        depth-0 close IS the list end (a naive first-"("/last-")" cut
#        would swallow the "->return" and the effects suffix);
#     3. after that close the text must continue "->" followed by a
#        non-empty return-type render;
#     4. effects = the LAST "effects(...)" group that starts at top level
#        and closes exactly at the text end (the render appends the
#        declared effects LAST, so the last balanced-to-end group is the
#        fn's own; a return type that is itself an F(...)/C(...) type
#        carrying its own trailing "effects(...)" conflates with the fn
#        suffix IN THE TEXT — documented corner; the digest covers the
#        whole text, so identity is unaffected). Everything before the
#        group is the return type;
#     5. each param splits at its FIRST ":"; the prefix must be one of the
#        four convention words (canonical renders always write it — a
#        param without it means the text is not canonical and the parse
#        fails). params collects the TYPE texts in declaration order;
#        conventions collects the convention words, ","-joined;
#     6. binder_count = the count of DISTINCT generic-binder reference
#        texts "P<idx>o<owner>" inside the param/return type texts;
#        const_params = the DISTINCT const-param reference texts "CP<idx>"
#        in first-occurrence order. The fn's own binder list is NOT part
#        of the def-key text (only is_generic row metadata records it), so
#        only REFERENCES are recoverable; a pathological module/type path
#        rendering as a digit-bearing "P"/"CP" sequence (e.g. a segment
#        "P3o5") could false-positive the token scans — advisory fields
#        only, digests unaffected;
#     7. the digest words digest the FULL sig text exactly as it appears
#        after the "#" — parse pieces never replace the text for identity.

# ———— The split records ————

# The parsed signature fingerprint of a callable def (parse rules above).
# The digest words digest the FULL "#sig" text as-is (identity authority);
# the parse pieces (conventions / params / binder_count / const_params /
# return_type / effects) are the structural view for diagnostics,
# rendering and the item-5 digest-keyed maps' equality aids — they never
# replace the text for identity.
struct SignatureFingerprint
  # The convention words of the params, ","-joined in declaration order
  # ("" for a parameterless list) — the snapshot_conv_text vocabulary
  # "let"/"inout"/"sink"/"set".
  conventions: String
  # The param TYPE texts in declaration order (each param's type part
  # after its "conv:" prefix) — the "params" grammar piece.
  params: Vec[String]
  # The count of DISTINCT generic-binder reference texts "P<idx>o<owner>"
  # inside the param/return type texts (the def-key text records binder
  # REFERENCES only — see parse rule 6).
  binder_count: Int
  # The DISTINCT const-parameter reference texts "CP<idx>", in
  # first-occurrence order (parse rule 6).
  const_params: Vec[String]
  # The return-type text (everything after the fn's "->" before the
  # effects suffix — parse rule 4).
  return_type: String
  # The effects suffix text "effects(...)" ("" when the def declares no
  # effects) — parse rule 4.
  effects: String
  digest_hi: UInt = 0   # the 128-bit stable digest of the FULL sig text
  digest_lo: UInt = 0
end

# ———— Persistent declaration lineage (third-audit items 11-13; fourth-audit P0-1) ————
#
# The audit's persistent identity model: a declaration's identity is a
# NUMBER the lineage store assigns once and preserves for the declaration's
# whole life. Renaming the declaration, moving it between modules, or
# inserting unrelated declarations around it never changes that number — so
# the digest computed over (package key, lineage number, kind domain) never
# changes either (fourth-audit P0-1: the MODULE PATH left the identity — it
# is revision LOCATION metadata now, exactly like the name). The NAME is
# NOT identity (store metadata for structural bootstrapping/diagnostics);
# the MODULE is NOT identity (a move preserves the id); the SIGNATURE is
# NOT identity (the SignatureFingerprint carries it); the SOURCE POSITION
# is NOT identity.
#
# BOOTSTRAP: the store matches declarations STRUCTURALLY on first sight —
# (package key, module path, kind, name) — and assigns a fresh number. A
# first sight can only see the location/name, so the initial lineages
# bootstrap structurally; from then on the store is the authority.
#
# RENAME/MOVE CONTINUITY (fourth-audit P0-3, conservative):
#   (a) an EXPLICIT DeclContinuation recorded in the store (from the
#       semantic edit engine or the API) ALWAYS preserves the identity: the
#       store claims the recorded lineage for the new location before any
#       heuristic runs;
#   (b) AUTOMATIC rebinding runs only on STRONG structural edit provenance:
#       the disappeared entry's signature digest must match the incoming
#       declaration, the new declaration must be the UNIQUE
#       same-package/same-kind/same-signature candidate whose old location
#       is NOT live in the current build, AND the store must have seen the
#       old location in the IMMEDIATELY PRECEDING revision
#       (last_seen_revision == previous revision). Anything else that
#       disappeared is tombstoned, and any other first sight gets a FRESH
#       lineage: ambiguous cases are removed+created, never guessed.
#
# STORE FORMAT (v2, fourth-audit P0-2): a header line
#   "tg-lineage-store v2|<revision>|<previous_revision>"
# then one entry line per lineage entry
#   e|pkg|module|kind|name|lineage|sig_hi|sig_lo|last_seen|tombstone|sig_fingerprint
# and one continuation line per explicit continuation
#   c|lineage|reason|old_location|new_location
# Every text field is escaped ('\' '|' LF CR and the empty string) so the
# codec is an exact round trip. The SIGNATURE DIGEST words and the
# structural fingerprint (the canonical signature text) are PERSISTED, so
# rename/move matching works after a restart exactly as in-process. A v1
# body (the legacy "pkg|module|kind|name|lineage" 5-column grammar, no
# header) is still read: sig digests convert to 0/0 (unknown), the
# fingerprint to "", the last-seen revision to "" and tombstone to false —
# a loaded v1 entry becomes rebind-matchable after the next build re-signs
# it. The text is the PERSISTED FORMAT only — never identity (identity is
# the number plus the digest).

# The PACKAGE identity of a declaration: the package key text ("std", the
# workspace package key, ...); the empty key is the DEFAULT package (the
# section-1..10 key grammars carry no package component, so a text parse
# binds the default package until a package-qualified grammar lands).
struct StablePackageId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The MODULE identity within a package: the package record + the
# package-relative module path ("" for the package root); digest over
# (package key, module path).
struct StableModuleId
  package: StablePackageId
  path: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The persistent lineage: the number the store assigned ONCE. digest over
# (package key, lineage number) — the MODULE is location metadata the
# store keeps current (fourth-audit P0-1: a moved declaration keeps its
# id); the declared name and the kind are NOT part of the lineage's own
# digest.
struct DeclLineageId
  package: StablePackageId
  module: StableModuleId
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The DECLARATION identity (third-audit item 11; fourth-audit P0-1): the
# package, the PERSISTENT lineage record and the row-kind text. The digest
# words cover (package, lineage, kind domain) ONLY — the CURRENT module
# path, the declared name, the signature and the source position never
# enter the identity, so a rename, a MOVE between modules or a nearby
# insertion leaves the id byte-identical (the store preserves the lineage
# number and records the new location as metadata). `module` rides the
# record as revision-location metadata; `kind` IS digested (a fn and a
# type of the same package/lineage cannot collide). display_key is
# DIAGNOSTICS CARGO ONLY (the registration / callable text a text parse
# saw, "" for a store-built record) — never digested, never compared.
struct StableDeclId
  package: StablePackageId
  module: StableModuleId
  lineage: DeclLineageId
  kind: String
  display_key: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# (fourth-audit P0-19) The typed UNSAFE-SITE identity: the DECLARATION
# identity of the function owning the unsafe marker, the marker's kind word
# (the UnsafeKind render — "unsafe-fn" / "extern-call" / "transmute" /
# "unknown-call" / ...) and the marker's site text (the extern/unknown
# callee name; "" for the site-less families). The digest words are the
# stable digest of the canonical text "<function key>|<kind>|<site>" — the
# content identity the budget's typed allowed_unsafe set keys on. Eq/Hash
# compare the declaration digest words plus the kind/site texts (no
# delimiter parsing at the membership boundary). The fields are the typed
# members a §31 unsafe-fact row carries; the budget NEVER re-parses a
# rendered marker row to decide membership.
struct StableUnsafeSiteId
  decl: StableDeclId
  kind: String
  site: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The unsafe-site-id clone: the declaration identity through its registered
# StableDeclId clone, the kind/site texts duplicated, the digest words as
# immediates. Registered because UnsafeFact.site_id is Option[StableUnsafeSiteId].
impl Clone for StableUnsafeSiteId
  def clone(self: Self) -> StableUnsafeSiteId
    StableUnsafeSiteId {
      decl: self.decl.clone(),
      kind: self.kind.clone(),
      site: self.site.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

# ONE lineage-store row: the structural registration data (package,
# module, kind, name) the bootstrap matcher matches on, the persistent
# lineage number, the declaration identity digest words (over package,
# lineage, kind — recomputed on load), the last recorded signature digest
# words (0/0 = unknown), the structural fingerprint (the canonical
# signature TEXT those words digest — collision-detection cargo; "" when
# unknown), the store revision the entry was last seen in ("" = unknown)
# and the tombstone bit (fourth-audit P0-2/P0-3: a removed declaration's
# entry is retired — its lineage is never reused — and only an explicit
# continuation can revive it).
struct LineageEntry
  package_key: String
  module_path: String
  kind: String
  name: String
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  sig_digest_hi: UInt = 0
  sig_digest_lo: UInt = 0
  sig_fingerprint: String = ""
  last_seen_revision: String = ""
  tombstone: Bool = false
end

# ONE EXPLICIT declaration continuation (fourth-audit P0-1/P0-3): the
# authoritative record that the declaration bound to `lineage` moved from
# `old_location` to `new_location` for `reason` ("rename" | "move"). The
# locations are `stable_lineage_scope_key` renders (package / module /
# kind / name — newline-joined; the store file escapes them). An explicit
# continuation ALWAYS preserves identity and takes precedence over every
# heuristic; it never matches across different packages or kind domains
# (those are digested).
struct DeclContinuation
  lineage: Int
  old_location: String
  new_location: String
  reason: String
end

# ———— The persistent MEMBER / BINDER / HIR-NODE lineages (fourth-audit P0-4) ————
#
# The P0-1 model generalizes below the declaration: a FIELD/VARIANT, a
# LOCAL/BINDER and an HIR NODE each own a PERSISTENT lineage number the
# store assigns ONCE, so inserting an unrelated member/local/node before
# them, reordering them or renaming a member never re-keys the surviving
# entities. The dense ordinal (the member index, the binder sequence, the
# HIR node seq) is a SNAPSHOT LOCATOR only — meaningful against ONE
# compilation's layout, never identity.
#
#   MemberLineageId   — one field or variant of an owner declaration:
#                       identity = (owner declaration identity, member
#                       kind "field"/"variant", lineage). The member
#                       KIND is part of the identity so a field and a
#                       variant can never collide. Members bootstrap
#                       structurally on (owner, kind, name) and support
#                       explicit continuations (a rename/reorder/move the
#                       store must obey) plus the conservative
#                       same-owner/same-kind/same-signature rebinding.
#   BinderLineageId   — one local/binder of an owner function declaration:
#                       identity = (owner function declaration identity,
#                       lineage). The lineage numbers are PER-FUNCTION
#                       (one binder section per owner): the fresh number
#                       is max(same-owner lineage) + 1, so two functions
#                       number their locals independently. Binders
#                       bootstrap structurally on (owner, binder kind,
#                       name) and rebind conservatively.
#   HirNodeLineageId  — one HIR/AST node of an owner declaration:
#                       identity = (owner declaration identity, lineage).
#                       Numbers are PER-OWNER (max(same-owner lineage) + 1).
#                       HIR nodes have no declared name, so the structural
#                       bootstrap key is the node's canonical ANCHOR text
#                       (the caller-supplied content render); the
#                       conservative rebinding matches the anchor digest.
#
# ONE lineage number is NEVER reused: a removed member/binder/node
# tombstones its entry and a later same-structural-key entity revives that
# entry (the exact location+name/anchor binding is not a guess); anything
# else bootstraps a fresh number unless an explicit continuation (members)
# or the strong conservative evidence proves a rename.

# ONE member-lineage-store row (a field or variant): the structural
# bootstrap key (owner identity words + member kind + declared name), the
# persistent lineage number, the member identity digest (recomputed on
# load), the member's signature digest words + canonical fingerprint (the
# declared type text — the conservative rebinding anchors; "sig digests
# where applicable"), the last-seen revision and the tombstone bit. The
# owner KEY text rides as diagnostics cargo (the registration render the
# stamp saw); matching uses the owner identity WORDS only.
struct MemberLineageEntry
  package_key: String
  owner_key: String
  owner_digest_hi: UInt
  owner_digest_lo: UInt
  member_kind: String
  name: String
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  sig_digest_hi: UInt = 0
  sig_digest_lo: UInt = 0
  sig_fingerprint: String = ""
  last_seen_revision: String = ""
  tombstone: Bool = false
end

# ONE EXPLICIT member continuation (P0-4): the authoritative record that
# the member bound to `lineage` moved from `old_location` to
# `new_location` for `reason` ("rename" | "reorder" | "move"). Locations
# are stable_member_scope_key renders (package / owner key / member kind /
# name); an explicit continuation always preserves identity and takes
# precedence over every heuristic, exactly like DeclContinuation.
struct MemberContinuation
  lineage: Int
  old_location: String
  new_location: String
  reason: String
end

# ONE binder-lineage-store row (a local/binder of one function): the
# structural bootstrap key (owner identity words + binder kind + declared
# name), the per-function lineage number, the identity digest, the
# binder's signature digest words + fingerprint (the declared type /
# pattern text), last-seen revision and tombstone.
struct BinderLineageEntry
  owner_key: String
  owner_digest_hi: UInt
  owner_digest_lo: UInt
  binder_kind: String
  name: String
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  sig_digest_hi: UInt = 0
  sig_digest_lo: UInt = 0
  sig_fingerprint: String = ""
  last_seen_revision: String = ""
  tombstone: Bool = false
end

# ONE HIR-node-lineage-store row: the structural bootstrap key (owner
# identity words + canonical anchor text), the per-owner lineage number,
# the identity digest, the anchor signature digest words + fingerprint
# (the caller-supplied deeper content digest), last-seen revision and
# tombstone.
struct HirNodeLineageEntry
  owner_key: String
  owner_digest_hi: UInt
  owner_digest_lo: UInt
  anchor: String
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  sig_digest_hi: UInt = 0
  sig_digest_lo: UInt = 0
  sig_fingerprint: String = ""
  last_seen_revision: String = ""
  tombstone: Bool = false
end

# The persistent lineage store: every bound declaration row, the explicit
# continuations (a list, scanned newest-first so a later record overrides
# an earlier one), the next fresh number and the revision bookkeeping the
# conservative rebinding rule reads (revision = the store pass currently
# being stamped; previous_revision = the immediately preceding pass).
# Fourth-audit P0-4 extends the SAME store with the member / binder /
# HIR-node sections above: one member continuation list, the member/binder/
# HIR entry lists and the member number counter (binder/HIR numbers are
# per-owner, derived from their own sections). Numbers are never reused: a
# removed entity tombstones its entry and a later same-key entity is a NEW
# entity unless the bootstrap binding or an explicit continuation proves
# otherwise.
struct DeclLineageStore
  entries: Vec[LineageEntry] = Vec::new()
  continuations: Vec[DeclContinuation] = Vec::new()
  member_entries: Vec[MemberLineageEntry] = Vec::new()
  member_continuations: Vec[MemberContinuation] = Vec::new()
  binder_entries: Vec[BinderLineageEntry] = Vec::new()
  hir_entries: Vec[HirNodeLineageEntry] = Vec::new()
  next: Int = 1
  member_next: Int = 1
  revision: String = ""
  previous_revision: String = ""
end

# The declaration-identity canonical text: the length-prefixed
# concatenation of the identity components (package key, lineage number
# text, kind domain). The digest of THIS text is the declaration identity;
# the current module path, the name, the signature and the source position
# never enter it (fourth-audit P0-1 — a move keeps the id because the
# module path is not in the preimage).
pub def stable_decl_identity_text(package: StablePackageId, lineage: Int, kind: String) -> String
  stable_identity_lenpref(&package.key) +
  stable_identity_lenpref(&lineage.to_string()) + stable_identity_lenpref(&kind)
end

# The declaration-identity text of an existing record (the digest preimage
# — usable to re-verify a record's words at insert time).
pub def stable_decl_identity_text_of(decl: StableDeclId) -> String
  stable_decl_identity_text(&decl.package, decl.lineage.lineage, &decl.kind)
end

# The persistent-lineage identity text: package key + lineage number (the
# lineage's own digest preimage; the module path is location metadata).
pub def stable_decl_lineage_identity_text(package: StablePackageId, lineage: Int) -> String
  stable_identity_lenpref(&package.key) + stable_identity_lenpref(&lineage.to_string())
end

# The package record of a package key text (digest over the key).
pub def stable_package_id_of(key: String) -> StablePackageId
  let w = stable_words_of(&key)
  StablePackageId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The module record of a package + package-relative path (digest over the
# length-prefixed pair).
pub def stable_module_id_of(package: StablePackageId, path: String) -> StableModuleId
  let text = stable_identity_lenpref(&package.key) + stable_identity_lenpref(&path)
  let w = stable_words_of(&text)
  StableModuleId { package: package, path: path, digest_hi: w.0, digest_lo: w.1 }
end

# The persistent lineage record: the store-assigned number over the
# package (digest over the length-prefixed package/number pair — the
# module is metadata and rides the record unchanged).
pub def stable_decl_lineage_id_of(package: StablePackageId, module: StableModuleId, lineage: Int) -> DeclLineageId
  let text = stable_decl_lineage_identity_text(&package, lineage)
  let w = stable_words_of(&text)
  DeclLineageId { package: package, module: module, lineage: lineage, digest_hi: w.0, digest_lo: w.1 }
end

# The PERSISTENT identity constructor: the digest covers
# (package, lineage, kind) ONLY — the module path is metadata.
pub def stable_decl_id_with_lineage(package: StablePackageId, module: StableModuleId, lineage: DeclLineageId, kind: String) -> StableDeclId
  stable_decl_id_with_lineage_named(package, module, lineage, kind, "".to_string())
end

# The persistent identity constructor with the diagnostics display text
# (carried verbatim; never digested).
pub def stable_decl_id_with_lineage_named(package: StablePackageId, module: StableModuleId, lineage: DeclLineageId, kind: String, display_key: String) -> StableDeclId
  let text = stable_decl_identity_text(&package, lineage.lineage, &kind)
  let w = stable_words_of(&text)
  StableDeclId {
    package: package,
    module: module,
    lineage: lineage,
    kind: kind,
    display_key: display_key,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The text-boundary convenience form of the persistent constructor.
pub def stable_decl_id_of_lineage_texts(package_key: String, module_path: String, lineage: Int, kind: String) -> StableDeclId
  stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, "".to_string())
end

# The text-boundary convenience form with the diagnostics display text.
pub def stable_decl_id_of_lineage_texts_named(package_key: String, module_path: String, lineage: Int, kind: String, display_key: String) -> StableDeclId
  let package = stable_package_id_of(package_key)
  let module = stable_module_id_of(package.clone(), module_path)
  let lid = stable_decl_lineage_id_of(package.clone(), module.clone(), lineage)
  stable_decl_id_with_lineage_named(package, module, lid, kind, display_key)
end

# The DETERMINISTIC synthetic lineage of a text-only parse (no store): the
# low 63 bits of the digest of the registration text, plus 1. Text-only
# construction is deterministic and collision-practical, but the number is
# NAME-DERIVED — a rename changes it (documented bootstrap fallback: only
# the store carries rename-surviving numbers).
pub def stable_synthetic_lineage(registration_text: String) -> Int
  let w = stable_words_of(&registration_text)
  ((w.1 >> 1) as Int) + 1
end

# The lineage-store lookup: the entry already binding the structural key
# (package, module, kind, name), else Option::None. An exact structural hit
# resolves regardless of tombstone state — the location+name binding IS
# the structural bootstrap key, so a re-appearing declaration revives its
# lineage through stable_decl_stamp.
pub def stable_lineage_store_get(store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String) -> Option[LineageEntry]
  for entry in store.entries do
    if entry.package_key == package_key && entry.module_path == module_path &&
       entry.kind == kind && entry.name == name then
      return Option::Some(entry)
    end
  end
  Option::None
end

# The lineage number bound to a structural key (-1 when unbound).
pub def stable_lineage_store_lineage_of(store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String) -> Int
  match stable_lineage_store_get(store, package_key, module_path, kind, name)
  when Option::Some(entry) then entry.lineage
  when Option::None then -1
  end
end

# The index of the entry carrying `lineage` (-1 when absent).
def stable_lineage_entry_index_of(store: DeclLineageStore, lineage: Int) -> Int
  var i = 0
  while i < store.entries.len() do
    if store.entries[i].lineage == lineage then
      return i
    end
    i = i + 1
  end
  -1
end

# The next revision text of the store's own monotonic pass counter: the
# first pass is "1", each further pass increments the decimal text. This
# counter is the store's PROVENANCE CLOCK: the snapshot's content-addressed
# revision is only known after a build, so it cannot date the stamping
# that produced the artifact; the store pass is the observable
# "immediately preceding revision" the conservative rebinding rule reads.
pub def stable_lineage_revision_next(text: String) -> String
  if stable_is_digits(&text) then
    (stable_text_to_int(&text) + 1).to_string()
  else
    "1".to_string()
  end
end

# Open the next store revision: the current pass becomes the previous
# revision (the conservative rebinding rule's evidence window) and the new
# pass text is assigned. Every stamp during the pass records it in the
# touched entry's last_seen_revision.
pub def stable_lineage_store_begin_revision(inout store: DeclLineageStore) -> Unit
  store.previous_revision = store.revision.clone()
  store.revision = stable_lineage_revision_next(store.revision.clone())
  ()
end

# Close the current store revision: every entry NOT seen in it (its
# last_seen_revision is not the current text) is tombstoned. The entries
# stay in the store — numbers are never reused, and an explicit
# continuation may still revive one. Fourth-audit P0-4: every section
# (declarations, members, binders, HIR nodes) is tombstoned by the SAME
# revision clock — a section a build does not stamp is not live.
pub def stable_lineage_store_finish_revision(inout store: DeclLineageStore) -> Unit
  var i = 0
  while i < store.entries.len() do
    let e = store.entries[i].clone()
    if e.last_seen_revision != store.revision && !e.tombstone then
      store.entries[i] = LineageEntry {
        package_key: e.package_key,
        module_path: e.module_path,
        kind: e.kind,
        name: e.name,
        lineage: e.lineage,
        digest_hi: e.digest_hi,
        digest_lo: e.digest_lo,
        sig_digest_hi: e.sig_digest_hi,
        sig_digest_lo: e.sig_digest_lo,
        sig_fingerprint: e.sig_fingerprint,
        last_seen_revision: e.last_seen_revision,
        tombstone: true
      }
    end
    i = i + 1
  end
  var mi = 0
  while mi < store.member_entries.len() do
    let m = store.member_entries[mi].clone()
    if m.last_seen_revision != store.revision && !m.tombstone then
      store.member_entries[mi] = MemberLineageEntry {
        package_key: m.package_key,
        owner_key: m.owner_key,
        owner_digest_hi: m.owner_digest_hi,
        owner_digest_lo: m.owner_digest_lo,
        member_kind: m.member_kind,
        name: m.name,
        lineage: m.lineage,
        digest_hi: m.digest_hi,
        digest_lo: m.digest_lo,
        sig_digest_hi: m.sig_digest_hi,
        sig_digest_lo: m.sig_digest_lo,
        sig_fingerprint: m.sig_fingerprint,
        last_seen_revision: m.last_seen_revision,
        tombstone: true
      }
    end
    mi = mi + 1
  end
  var bi = 0
  while bi < store.binder_entries.len() do
    let b = store.binder_entries[bi].clone()
    if b.last_seen_revision != store.revision && !b.tombstone then
      store.binder_entries[bi] = BinderLineageEntry {
        owner_key: b.owner_key,
        owner_digest_hi: b.owner_digest_hi,
        owner_digest_lo: b.owner_digest_lo,
        binder_kind: b.binder_kind,
        name: b.name,
        lineage: b.lineage,
        digest_hi: b.digest_hi,
        digest_lo: b.digest_lo,
        sig_digest_hi: b.sig_digest_hi,
        sig_digest_lo: b.sig_digest_lo,
        sig_fingerprint: b.sig_fingerprint,
        last_seen_revision: b.last_seen_revision,
        tombstone: true
      }
    end
    bi = bi + 1
  end
  var hi = 0
  while hi < store.hir_entries.len() do
    let h = store.hir_entries[hi].clone()
    if h.last_seen_revision != store.revision && !h.tombstone then
      store.hir_entries[hi] = HirNodeLineageEntry {
        owner_key: h.owner_key,
        owner_digest_hi: h.owner_digest_hi,
        owner_digest_lo: h.owner_digest_lo,
        anchor: h.anchor,
        lineage: h.lineage,
        digest_hi: h.digest_hi,
        digest_lo: h.digest_lo,
        sig_digest_hi: h.sig_digest_hi,
        sig_digest_lo: h.sig_digest_lo,
        sig_fingerprint: h.sig_fingerprint,
        last_seen_revision: h.last_seen_revision,
        tombstone: true
      }
    end
    hi = hi + 1
  end
end

# The STRUCTURAL BOOTSTRAP MATCHER (the audit's "initial matching can
# bootstrap lineages structurally"): the existing number when the
# structural key is bound (the exact location+name binding is not a guess,
# so a tombstoned entry revives here and is marked seen), else a fresh
# number assigned in place. No signature digest is recorded — use the
# signed variant when the store must support rename/move rebinding.
pub def stable_decl_bootstrap_lineage(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String) -> Int
  match stable_lineage_store_get(store, package_key.clone(), module_path.clone(), kind.clone(), name.clone())
  when Option::Some(entry) then
    let lineage = entry.lineage
    let idx = stable_lineage_entry_index_of(store, lineage)
    if idx >= 0 then
      let e = store.entries[idx].clone()
      store.entries[idx] = LineageEntry {
        package_key: e.package_key,
        module_path: e.module_path,
        kind: e.kind,
        name: e.name,
        lineage: e.lineage,
        digest_hi: e.digest_hi,
        digest_lo: e.digest_lo,
        sig_digest_hi: e.sig_digest_hi,
        sig_digest_lo: e.sig_digest_lo,
        sig_fingerprint: e.sig_fingerprint,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
    end
    lineage
  when Option::None then
    let lineage = store.next
    let identity = stable_decl_id_of_lineage_texts(package_key.clone(), module_path.clone(), lineage, kind.clone())
    store.entries.push(LineageEntry {
      package_key: package_key,
      module_path: module_path,
      kind: kind,
      name: name,
      lineage: lineage,
      digest_hi: identity.digest_hi,
      digest_lo: identity.digest_lo,
      sig_digest_hi: 0,
      sig_digest_lo: 0,
      sig_fingerprint: "".to_string(),
      last_seen_revision: store.revision.clone(),
      tombstone: false
    })
    store.next = store.next + 1
    lineage
  end
end

# Record (or overwrite) the signature digest words and the structural
# fingerprint of a bound structural key — the anchors the rebinding rule
# matches on — marks the entry seen in the current revision and revives it.
# Returns whether the key was bound (a re-sign of an unknown key is a
# no-op false).
pub def stable_lineage_store_sign(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Bool
  var i = 0
  while i < store.entries.len() do
    let e = store.entries[i].clone()
    if e.package_key == package_key && e.module_path == module_path && e.kind == kind && e.name == name then
      store.entries[i] = LineageEntry {
        package_key: e.package_key,
        module_path: e.module_path,
        kind: e.kind,
        name: e.name,
        lineage: e.lineage,
        digest_hi: e.digest_hi,
        digest_lo: e.digest_lo,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
      return true
    end
    i = i + 1
  end
  false
end

# The signed bootstrap variant: records the signature digest words and the
# canonical signature text on the entry so the conservative rebinding rule
# can prove the structural match.
pub def stable_decl_bootstrap_lineage_signed(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let lineage = stable_decl_bootstrap_lineage(store, package_key.clone(), module_path.clone(), kind.clone(), name.clone())
  stable_lineage_store_sign(store, package_key, module_path, kind, name, sig_digest_hi, sig_digest_lo, sig_text)
  lineage
end

# Re-point the entry at `index` to the (module, name, signature) the
# current build sees: the LINEAGE and the declaration-identity digest
# words are kept byte-identical (neither module nor name is digested), the
# signature digest/fingerprint are refreshed, and the entry is marked seen
# in the current revision and un-tombstoned.
def stable_lineage_entry_claim(inout store: DeclLineageStore, index: Int, module_path: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let old = store.entries[index].clone()
  store.entries[index] = LineageEntry {
    package_key: old.package_key,
    module_path: module_path,
    kind: old.kind,
    name: name,
    lineage: old.lineage,
    digest_hi: old.digest_hi,
    digest_lo: old.digest_lo,
    sig_digest_hi: sig_digest_hi,
    sig_digest_lo: sig_digest_lo,
    sig_fingerprint: sig_text,
    last_seen_revision: store.revision.clone(),
    tombstone: false
  }
  old.lineage
end

# Record an EXPLICIT declaration continuation (fourth-audit P0-1/P0-3): the
# authoritative rename/move instruction the semantic edit engine (or any
# API caller) hands the store. The locations are stable_lineage_scope_key
# renders. A later record for the same new location overrides an earlier
# one.
pub def stable_lineage_store_add_continuation(inout store: DeclLineageStore, lineage: Int, old_location: String, new_location: String, reason: String) -> Unit
  store.continuations.push(DeclContinuation {
    lineage: lineage,
    old_location: old_location,
    new_location: new_location,
    reason: reason
  })
  ()
end

# The NEWEST explicit continuation for a location, else Option::None.
pub def stable_lineage_store_continuation_for(store: DeclLineageStore, new_location: String) -> Option[DeclContinuation]
  var found: Option[DeclContinuation] = Option::None
  var i = 0
  while i < store.continuations.len() do
    let c = store.continuations[i].clone()
    if c.new_location == new_location then
      found = Option::Some(c)
    end
    i = i + 1
  end
  found
end

# The CONSERVATIVE AUTOMATIC-REBINDING CANDIDATE (fourth-audit P0-3) of a
# not-yet-bound first sight, as a store entry index (-1 = no rebind):
#   * same PACKAGE and same KIND (both are digested — a transfer across
#     either would change the identity);
#   * the recorded signature digest words AGREE;
#   * NOT tombstoned AND last seen in the immediately preceding revision
#     (STRONG provenance: the disappearance was observed last pass, so the
#     appearance now is a same-revision rename/move — never a stale delete
#     followed later by an unrelated creation);
#   * its location is NOT live in the current build;
#   * UNIQUE — zero or several matches leave the caller to bootstrap fresh.
# The scan is package-wide (NOT module-scoped): a declaration moved from
# a::foo to b::foo is exactly the same-kind/same-signature/same-package
# candidate the rule is for, and the module path is metadata.
def stable_lineage_rebind_candidate_index(store: DeclLineageStore, package_key: String, kind: String, sig_digest_hi: UInt, sig_digest_lo: UInt, live_keys: Vec[String]) -> Int
  var idx = -1
  var matches = 0
  var i = 0
  while i < store.entries.len() do
    let e = store.entries[i].clone()
    if e.package_key == package_key && e.kind == kind &&
       e.sig_digest_hi == sig_digest_hi && e.sig_digest_lo == sig_digest_lo &&
       !e.tombstone && store.previous_revision.len() > 0 &&
       e.last_seen_revision == store.previous_revision then
      let scope = stable_lineage_scope_key(e.package_key.clone(), e.module_path.clone(), e.kind.clone(), e.name.clone())
      if !live_keys.contains(&scope) then
        idx = i
        matches = matches + 1
      end
    end
    i = i + 1
  end
  if matches == 1 then idx else -1 end
end

# The RENAME/MOVE REBINDING RULE as a standalone helper (the whole-build
# path uses stable_lineage_rebind_candidate_index with its live-set; this
# form is for a caller that knows the old name and has no live-set):
# transfer the old declaration's number to `new_name` when, and only when,
# the match is UNIQUE and the STRONG provenance of fourth-audit P0-3
# holds — same package, same kind, signature digest agreement, not
# tombstoned and last seen in the immediately preceding revision.
#   1. no entry may already bind (new_name, kind) in scope — that would
#      fuse two live declarations under one identity;
#   2. exactly ONE entry may match (package, kind, old_name, sig_digest)
#      with the revision evidence — two candidates are ambiguous and NO
#      rebind happens;
#   3. the matched entry keeps package/lineage/identity digest and only
#      its location metadata changes (module and name were never digested,
#      so the identity is unaffected).
# Returns Option::Some(lineage) when the rebind happened, Option::None
# otherwise (the caller then bootstraps a fresh number). `scoped` restricts
# the OLD entry to the (package, module) scope; the package filter always
# applies (the package is digested).
def stable_lineage_rebind_scoped(inout store: DeclLineageStore, package_key: String, module_path: String, old_name: String, new_name: String, kind: String, sig_digest: StableDigest, scoped: Bool) -> Option[Int]
  var i = 0
  while i < store.entries.len() do
    let e = store.entries[i].clone()
    if e.kind == kind && e.name == new_name then
      if !scoped || (e.package_key == package_key && e.module_path == module_path) then
        return Option::None
      end
    end
    i = i + 1
  end
  var candidate = -1
  var matches = 0
  i = 0
  while i < store.entries.len() do
    let e2 = store.entries[i].clone()
    if e2.package_key == package_key && e2.kind == kind && e2.name == old_name &&
       e2.sig_digest_hi == sig_digest.hi && e2.sig_digest_lo == sig_digest.lo &&
       !e2.tombstone && store.previous_revision.len() > 0 &&
       e2.last_seen_revision == store.previous_revision then
      if !scoped || e2.module_path == module_path then
        candidate = i
        matches = matches + 1
      end
    end
    i = i + 1
  end
  if matches != 1 || candidate < 0 then
    return Option::None
  end
  let fingerprint = store.entries[candidate].sig_fingerprint.clone()
  let lineage = stable_lineage_entry_claim(store, candidate, module_path.clone(), new_name.clone(), sig_digest.hi, sig_digest.lo, fingerprint)
  Option::Some(lineage)
end

# The default-package global rename/move rebind (unique match in the
# default package; the scan is package-wide, so a move between modules is
# a rebind).
pub def stable_lineage_rebind(inout store: DeclLineageStore, old_name: String, new_name: String, kind: String, sig_digest: StableDigest) -> Option[Int]
  stable_lineage_rebind_scoped(store, "".to_string(), "".to_string(), old_name, new_name, kind, sig_digest, false)
end

# The package/module-scoped rename rebind (unique match inside one
# package/module scope).
pub def stable_lineage_rebind_in(inout store: DeclLineageStore, package_key: String, module_path: String, old_name: String, new_name: String, kind: String, sig_digest: StableDigest) -> Option[Int]
  stable_lineage_rebind_scoped(store, package_key, module_path, old_name, new_name, kind, sig_digest, true)
end

# The diagnostics display text of a store row: the registration key
# render "module::name" (the bare name at the package root) — cargo only.
def stable_store_display_key(module_path: String, name: String) -> String
  if module_path.len() == 0 then
    name
  else
    module_path.clone() + "::" + name
  end
end

# The bootstrap constructor over the store: bind (or revive) the lineage
# and return the full persistent declaration id (the display cargo is the
# registration key render).
pub def stable_decl_id_of_lineage_store(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String) -> StableDeclId
  let display = stable_store_display_key(module_path.clone(), name.clone())
  let lineage = stable_decl_bootstrap_lineage(store, package_key.clone(), module_path.clone(), kind.clone(), name)
  stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
end

# The single-call wiring seam for a declaration-registry walk (the §30
# snapshot builder's def / module_symbols enumeration): sign the structural
# key with the declaration's signature digest words and structural
# fingerprint and return its full persistent id. One call per walked
# declaration; the caller threads the same store across revisions to keep
# numbers stable.
pub def stable_decl_stamp(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> StableDeclId
  let display = stable_store_display_key(module_path.clone(), name.clone())
  let lineage = stable_decl_bootstrap_lineage_signed(store, package_key.clone(), module_path.clone(), kind.clone(), name, sig_digest_hi, sig_digest_lo, sig_text)
  stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
end

# The rename-aware stamp: try the conservative rebinding first (the old
# name disappeared with the strong fourth-audit P0-3 provenance), else
# sign a fresh lineage. Returns the full persistent id either way — the
# caller cannot tell a rebind from a first sight by design; the number is
# the identity.
pub def stable_decl_stamp_renamed(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, old_name: String, new_name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> StableDeclId
  match stable_lineage_rebind_in(store, package_key.clone(), module_path.clone(), old_name, new_name.clone(), kind.clone(), StableDigest { hi: sig_digest_hi, lo: sig_digest_lo })
  when Option::Some(lineage) then
    let display = stable_store_display_key(module_path.clone(), new_name.clone())
    stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
  when Option::None then
    stable_decl_stamp(store, package_key, module_path, kind, new_name, sig_digest_hi, sig_digest_lo, sig_text)
  end
end

# The structural SCOPE KEY of one build-visible declaration: the render of
# (package, module, kind, name) that the whole-build live-set membership
# test uses (and the LOCATION text of an explicit DeclContinuation). "\n"
# can occur in none of the four components (identifiers, "::"-joined
# module paths and kind words are newline-free), so the render is
# unambiguous. The store file escapes it; it is never an identity.
pub def stable_lineage_scope_key(package_key: String, module_path: String, kind: String, name: String) -> String
  package_key + "\n" + module_path + "\n" + kind + "\n" + name
end

# The whole-build stamp of ONE declaration (the §30 snapshot def walk's
# single store seam — stable_decl_stamp's documented wiring), in the
# fourth-audit P0-3 order:
#   1. an EXPLICIT continuation for this location claims its recorded
#      lineage (authoritative; it never crosses packages or kind domains,
#      and a continuation whose old location is still live is ignored so
#      two live declarations can never fuse);
#   2. an already-bound structural key keeps its number and is re-signed
#      with the current signature;
#   3. otherwise the conservative automatic rebinding applies iff the
#      strong evidence holds (stable_lineage_rebind_candidate_index);
#   4. every other first sight bootstraps a fresh number.
# Returns the declaration's persistent StableDeclId; the caller threads ONE
# store across builds so the numbers survive.
pub def stable_decl_stamp_or_rebind(inout store: DeclLineageStore, package_key: String, module_path: String, kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> StableDeclId
  let display = stable_store_display_key(module_path.clone(), name.clone())
  let location = stable_lineage_scope_key(package_key.clone(), module_path.clone(), kind.clone(), name.clone())
  # (1) explicit continuation — authoritative, heuristics never run.
  match stable_lineage_store_continuation_for(store, location.clone())
  when Option::Some(cont) then
    let idx = stable_lineage_entry_index_of(store, cont.lineage)
    if idx >= 0 then
      let e = store.entries[idx].clone()
      let current_scope = stable_lineage_scope_key(e.package_key.clone(), e.module_path.clone(), e.kind.clone(), e.name.clone())
      let not_fusing = current_scope == location.clone() || !live_keys.contains(&current_scope)
      if e.package_key == package_key && e.kind == kind && not_fusing then
        let lineage = stable_lineage_entry_claim(store, idx, module_path.clone(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text.clone())
        return stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
      end
    else
      # A continuation-only store (the entry was never persisted): the
      # explicit record itself claims the number.
      let identity = stable_decl_id_of_lineage_texts(package_key.clone(), module_path.clone(), cont.lineage, kind.clone())
      store.entries.push(LineageEntry {
        package_key: package_key.clone(),
        module_path: module_path.clone(),
        kind: kind.clone(),
        name: name.clone(),
        lineage: cont.lineage,
        digest_hi: identity.digest_hi,
        digest_lo: identity.digest_lo,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text.clone(),
        last_seen_revision: store.revision.clone(),
        tombstone: false
      })
      if cont.lineage >= store.next then
        store.next = cont.lineage + 1
      end
      return stable_decl_id_of_lineage_texts_named(package_key, module_path, cont.lineage, kind, display)
    end
  when Option::None then ()
  end
  # (2) the exact structural binding.
  match stable_lineage_store_get(store, package_key.clone(), module_path.clone(), kind.clone(), name.clone())
  when Option::Some(_) then
    stable_decl_stamp(store, package_key, module_path, kind, name, sig_digest_hi, sig_digest_lo, sig_text)
  when Option::None then
    # (3) the conservative automatic rebinding, else (4) a fresh number.
    let idx = stable_lineage_rebind_candidate_index(store, package_key.clone(), kind.clone(), sig_digest_hi, sig_digest_lo, live_keys)
    if idx >= 0 then
      let lineage = stable_lineage_entry_claim(store, idx, module_path.clone(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text)
      stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
    else
      stable_decl_stamp(store, package_key, module_path, kind, name, sig_digest_hi, sig_digest_lo, sig_text)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The persistent MEMBER / BINDER / HIR-NODE lineage store APIs (P0-4)
# ———————————————————————————————————————————————————————————————

# ———— Member lineages (fields and variants) ————

# The persistent MEMBER lineage of one field or variant of an owner
# declaration (fourth-audit P0-4): identity = (owner declaration
# identity, member kind, lineage). The owner's MODULE and the member's
# NAME are metadata (the store's structural bootstrap key), never
# identity — a member rename keeps its id and a member insertion never
# re-keys its neighbours. digest = the 128-bit digest of the identity
# text (the owner digest words + kind + lineage, length-prefixed).
struct MemberLineageId
  package: StablePackageId
  owner: StableDeclId
  member_kind: String
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The member-lineage identity text: the owner declaration's IDENTITY
# WORDS (the owner's own digest pair — the owner's module/name are not
# recoverable from a store-built id, and the words ARE the owner
# identity), the member kind and the lineage number. Injectivity: every
# piece is length-prefixed, so two distinct (owner, kind, lineage) triples
# never render to the same text.
pub def stable_member_lineage_identity_text_of_words(owner_digest_hi: UInt, owner_digest_lo: UInt, member_kind: String, lineage: Int) -> String
  stable_identity_lenpref(&owner_digest_hi.to_string()) +
  stable_identity_lenpref(&owner_digest_lo.to_string()) +
  stable_identity_lenpref(&member_kind) +
  stable_identity_lenpref(&lineage.to_string())
end

# The member-lineage identity text of an owner record.
pub def stable_member_lineage_identity_text(owner: StableDeclId, member_kind: String, lineage: Int) -> String
  stable_member_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, member_kind, lineage)
end

# The persistent member lineage record: digest over the identity text.
pub def stable_member_lineage_id_of(package: StablePackageId, owner: StableDeclId, member_kind: String, lineage: Int) -> MemberLineageId
  let text = stable_member_lineage_identity_text(owner.clone(), member_kind.clone(), lineage)
  let w = stable_words_of(&text)
  MemberLineageId {
    package: package,
    owner: owner,
    member_kind: member_kind,
    lineage: lineage,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The DETERMINISTIC synthetic member lineage of a text-only parse (no
# store): the low 63 bits of the digest of (owner identity words, kind,
# name) plus 1. Deterministic and collision-practical, but NAME-DERIVED —
# a member rename changes it (the documented bootstrap fallback; only the
# store carries rename-surviving numbers). The zero lineage slot in the
# digest keeps the synthetic preimage disjoint from the persistent one.
pub def stable_member_synthetic_lineage(owner: StableDeclId, member_kind: String, name: String) -> Int
  let text = stable_member_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, member_kind, 0) +
    stable_identity_lenpref(&name)
  let w = stable_words_of(&text)
  ((w.1 >> 1) as Int) + 1
end

# The structural SCOPE KEY of one member: (package, owner key, member
# kind, name), newline-joined — the whole-build live-set membership test
# and the member-continuation location render. Newline cannot occur in any
# component.
pub def stable_member_scope_key(package_key: String, owner_key: String, member_kind: String, name: String) -> String
  package_key + "\n" + owner_key + "\n" + member_kind + "\n" + name
end

# The member entry already binding the structural key (owner identity
# words, member kind, name), else Option::None.
pub def stable_lineage_store_member_get(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt, member_kind: String, name: String) -> Option[MemberLineageEntry]
  for entry in store.member_entries do
    if entry.owner_digest_hi == owner_digest_hi && entry.owner_digest_lo == owner_digest_lo &&
       entry.member_kind == member_kind && entry.name == name then
      return Option::Some(entry)
    end
  end
  Option::None
end

# The index of the member entry carrying `lineage` (-1 when absent).
def stable_member_entry_index_of(store: DeclLineageStore, lineage: Int) -> Int
  var i = 0
  while i < store.member_entries.len() do
    if store.member_entries[i].lineage == lineage then
      return i
    end
    i = i + 1
  end
  -1
end

# The member identity words of an (owner words, kind, lineage) triple —
# the load-time recomputation seam.
def stable_member_words_of(owner_digest_hi: UInt, owner_digest_lo: UInt, member_kind: String, lineage: Int) -> (UInt, UInt)
  stable_words_of(&stable_member_lineage_identity_text_of_words(owner_digest_hi, owner_digest_lo, member_kind, lineage))
end

# The STRUCTURAL BOOTSTRAP MATCHER of a member: the existing number when
# the structural key is bound (a tombstoned entry revives here — the exact
# owner+kind+name binding is not a guess), else a fresh number from the
# store's member counter. No signature digest is recorded — use the signed
# variant / the or-rebind stamp when the store must support renames.
pub def stable_member_bootstrap_lineage(inout store: DeclLineageStore, package_key: String, owner_key: String, owner: StableDeclId, member_kind: String, name: String) -> Int
  match stable_lineage_store_member_get(store, owner.digest_hi, owner.digest_lo, member_kind.clone(), name.clone())
  when Option::Some(entry) then
    let lineage = entry.lineage
    let idx = stable_member_entry_index_of(store, lineage)
    if idx >= 0 then
      let e = store.member_entries[idx].clone()
      store.member_entries[idx] = MemberLineageEntry {
        package_key: e.package_key,
        owner_key: e.owner_key,
        owner_digest_hi: e.owner_digest_hi,
        owner_digest_lo: e.owner_digest_lo,
        member_kind: e.member_kind,
        name: e.name,
        lineage: e.lineage,
        digest_hi: e.digest_hi,
        digest_lo: e.digest_lo,
        sig_digest_hi: e.sig_digest_hi,
        sig_digest_lo: e.sig_digest_lo,
        sig_fingerprint: e.sig_fingerprint,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
    end
    lineage
  when Option::None then
    let lineage = store.member_next
    let w = stable_member_words_of(owner.digest_hi, owner.digest_lo, member_kind.clone(), lineage)
    store.member_entries.push(MemberLineageEntry {
      package_key: package_key,
      owner_key: owner_key,
      owner_digest_hi: owner.digest_hi,
      owner_digest_lo: owner.digest_lo,
      member_kind: member_kind,
      name: name,
      lineage: lineage,
      digest_hi: w.0,
      digest_lo: w.1,
      sig_digest_hi: 0,
      sig_digest_lo: 0,
      sig_fingerprint: "".to_string(),
      last_seen_revision: store.revision.clone(),
      tombstone: false
    })
    store.member_next = store.member_next + 1
    lineage
  end
end

# Record (or overwrite) the member's signature digest words + canonical
# fingerprint, mark the entry seen in the current revision and revive it.
# Returns whether the structural key was bound.
pub def stable_lineage_store_member_sign(inout store: DeclLineageStore, owner: StableDeclId, member_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Bool
  var i = 0
  while i < store.member_entries.len() do
    let m = store.member_entries[i].clone()
    if m.owner_digest_hi == owner.digest_hi && m.owner_digest_lo == owner.digest_lo &&
       m.member_kind == member_kind && m.name == name then
      store.member_entries[i] = MemberLineageEntry {
        package_key: m.package_key,
        owner_key: m.owner_key,
        owner_digest_hi: m.owner_digest_hi,
        owner_digest_lo: m.owner_digest_lo,
        member_kind: m.member_kind,
        name: m.name,
        lineage: m.lineage,
        digest_hi: m.digest_hi,
        digest_lo: m.digest_lo,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
      return true
    end
    i = i + 1
  end
  false
end

# The signed member bootstrap: bind/revive the structural key and record
# its signature digest words + fingerprint.
pub def stable_member_bootstrap_lineage_signed(inout store: DeclLineageStore, package_key: String, owner_key: String, owner: StableDeclId, member_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let lineage = stable_member_bootstrap_lineage(store, package_key, owner_key, owner.clone(), member_kind.clone(), name.clone())
  stable_lineage_store_member_sign(store, owner, member_kind, name, sig_digest_hi, sig_digest_lo, sig_text)
  lineage
end

# Record an EXPLICIT member continuation (rename/reorder/move): a later
# record for the same new location overrides an earlier one.
pub def stable_lineage_store_member_add_continuation(inout store: DeclLineageStore, lineage: Int, old_location: String, new_location: String, reason: String) -> Unit
  store.member_continuations.push(MemberContinuation {
    lineage: lineage,
    old_location: old_location,
    new_location: new_location,
    reason: reason
  })
  ()
end

# The NEWEST explicit member continuation for a location, else
# Option::None.
pub def stable_lineage_store_member_continuation_for(store: DeclLineageStore, new_location: String) -> Option[MemberContinuation]
  var found: Option[MemberContinuation] = Option::None
  var i = 0
  while i < store.member_continuations.len() do
    let c = store.member_continuations[i].clone()
    if c.new_location == new_location then
      found = Option::Some(c)
    end
    i = i + 1
  end
  found
end

# Re-point the member entry at `index` to the (name, signature) the
# current build sees: the LINEAGE and the identity digest words are kept
# byte-identical (neither the name nor the signature is digested), the
# signature digest/fingerprint are refreshed, the entry is marked seen in
# the current revision and un-tombstoned.
def stable_member_entry_claim(inout store: DeclLineageStore, index: Int, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let old = store.member_entries[index].clone()
  store.member_entries[index] = MemberLineageEntry {
    package_key: old.package_key,
    owner_key: old.owner_key,
    owner_digest_hi: old.owner_digest_hi,
    owner_digest_lo: old.owner_digest_lo,
    member_kind: old.member_kind,
    name: name,
    lineage: old.lineage,
    digest_hi: old.digest_hi,
    digest_lo: old.digest_lo,
    sig_digest_hi: sig_digest_hi,
    sig_digest_lo: sig_digest_lo,
    sig_fingerprint: sig_text,
    last_seen_revision: store.revision.clone(),
    tombstone: false
  }
  old.lineage
end

# The CONSERVATIVE MEMBER-REBIND CANDIDATE of a not-yet-bound first sight
# (-1 = no rebind): same OWNER identity words and same member kind (both
# are identity), the recorded signature digest words AGREE, NOT tombstoned
# and last seen in the immediately preceding revision, its old location
# NOT live in this build, and UNIQUE. The scan is owner-scoped (the owner
# is part of the member identity; a member can never migrate between
# owners through the heuristic).
def stable_member_rebind_candidate_index(store: DeclLineageStore, owner: StableDeclId, member_kind: String, sig_digest_hi: UInt, sig_digest_lo: UInt, live_keys: Vec[String]) -> Int
  var idx = -1
  var matches = 0
  var i = 0
  while i < store.member_entries.len() do
    let m = store.member_entries[i].clone()
    if m.owner_digest_hi == owner.digest_hi && m.owner_digest_lo == owner.digest_lo &&
       m.member_kind == member_kind && m.sig_digest_hi == sig_digest_hi && m.sig_digest_lo == sig_digest_lo &&
       !m.tombstone && store.previous_revision.len() > 0 &&
       m.last_seen_revision == store.previous_revision then
      let scope = stable_member_scope_key(m.package_key.clone(), m.owner_key.clone(), m.member_kind.clone(), m.name.clone())
      if !live_keys.contains(&scope) then
        idx = i
        matches = matches + 1
      end
    end
    i = i + 1
  end
  if matches == 1 then idx else -1 end
end

# The whole-build member stamp (the P0-4 member seam), in the P0-3 order:
#   1. an EXPLICIT continuation for this location claims its recorded
#      lineage (authoritative; it never crosses owner identities or member
#      kinds, and a continuation whose old location is still live is
#      ignored so two live members can never fuse);
#   2. an already-bound structural key keeps its number and is re-signed;
#   3. otherwise the conservative rebinding applies iff the strong
#      evidence holds (stable_member_rebind_candidate_index);
#   4. every other first sight bootstraps a fresh number.
# Returns the member's persistent MemberLineageId (anchored on the SAME
# owner record the caller passed, so the identity words agree everywhere).
pub def stable_member_lineage_stamp_or_rebind(inout store: DeclLineageStore, package_key: String, owner_key: String, owner: StableDeclId, member_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> MemberLineageId
  let location = stable_member_scope_key(package_key.clone(), owner_key.clone(), member_kind.clone(), name.clone())
  # (1) explicit continuation — authoritative, heuristics never run.
  match stable_lineage_store_member_continuation_for(store, location.clone())
  when Option::Some(cont) then
    let idx = stable_member_entry_index_of(store, cont.lineage)
    if idx >= 0 then
      let m = store.member_entries[idx].clone()
      let current_scope = stable_member_scope_key(m.package_key.clone(), m.owner_key.clone(), m.member_kind.clone(), m.name.clone())
      let not_fusing = current_scope == location.clone() || !live_keys.contains(&current_scope)
      if m.owner_digest_hi == owner.digest_hi && m.owner_digest_lo == owner.digest_lo &&
         m.member_kind == member_kind && not_fusing then
        let lineage = stable_member_entry_claim(store, idx, name.clone(), sig_digest_hi, sig_digest_lo, sig_text.clone())
        return stable_member_lineage_id_of(owner.package.clone(), owner, member_kind, lineage)
      end
    else
      let w = stable_member_words_of(owner.digest_hi, owner.digest_lo, member_kind.clone(), cont.lineage)
      store.member_entries.push(MemberLineageEntry {
        package_key: package_key.clone(),
        owner_key: owner_key.clone(),
        owner_digest_hi: owner.digest_hi,
        owner_digest_lo: owner.digest_lo,
        member_kind: member_kind.clone(),
        name: name.clone(),
        lineage: cont.lineage,
        digest_hi: w.0,
        digest_lo: w.1,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text.clone(),
        last_seen_revision: store.revision.clone(),
        tombstone: false
      })
      if cont.lineage >= store.member_next then
        store.member_next = cont.lineage + 1
      end
      return stable_member_lineage_id_of(owner.package.clone(), owner, member_kind, cont.lineage)
    end
  when Option::None then ()
  end
  # (2) the exact structural binding.
  match stable_lineage_store_member_get(store, owner.digest_hi, owner.digest_lo, member_kind.clone(), name.clone())
  when Option::Some(_) then
    let lineage = stable_member_bootstrap_lineage_signed(store, package_key.clone(), owner_key.clone(), owner.clone(), member_kind.clone(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text)
    stable_member_lineage_id_of(owner.package.clone(), owner, member_kind, lineage)
  when Option::None then
    # (3) the conservative rebinding, else (4) a fresh number.
    let idx = stable_member_rebind_candidate_index(store, owner.clone(), member_kind.clone(), sig_digest_hi, sig_digest_lo, live_keys)
    if idx >= 0 then
      let lineage = stable_member_entry_claim(store, idx, name.clone(), sig_digest_hi, sig_digest_lo, sig_text)
      stable_member_lineage_id_of(owner.package.clone(), owner, member_kind, lineage)
    else
      let lineage = stable_member_bootstrap_lineage_signed(store, package_key.clone(), owner_key.clone(), owner.clone(), member_kind.clone(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text)
      stable_member_lineage_id_of(owner.package.clone(), owner, member_kind, lineage)
    end
  end
end

# ———— Binder lineages (locals and binders, per owner function) ————

# The persistent BINDER lineage of one local/binder of an owner function
# declaration (fourth-audit P0-4): identity = (owner function declaration
# identity, lineage). The lineage numbers are PER-FUNCTION (the fresh
# number is max(same-owner lineage) + 1), so the same number in two
# functions names two independent binders; the binder's NAME and ordinal
# are store metadata / snapshot locators only.
struct BinderLineageId
  owner_function: StableDeclId
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The binder-lineage identity text: the owner function declaration's
# identity words + the lineage number.
pub def stable_binder_lineage_identity_text_of_words(owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> String
  stable_identity_lenpref(&owner_digest_hi.to_string()) +
  stable_identity_lenpref(&owner_digest_lo.to_string()) +
  stable_identity_lenpref(&lineage.to_string())
end

pub def stable_binder_lineage_identity_text(owner: StableDeclId, lineage: Int) -> String
  stable_binder_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, lineage)
end

pub def stable_binder_lineage_id_of(owner: StableDeclId, lineage: Int) -> BinderLineageId
  let text = stable_binder_lineage_identity_text(owner.clone(), lineage)
  let w = stable_words_of(&text)
  BinderLineageId { owner_function: owner, lineage: lineage, digest_hi: w.0, digest_lo: w.1 }
end

# The deterministic synthetic binder lineage of a text-only parse.
pub def stable_binder_synthetic_lineage(owner: StableDeclId, name: String) -> Int
  let text = stable_binder_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, 0) +
    stable_identity_lenpref(&name)
  let w = stable_words_of(&text)
  ((w.1 >> 1) as Int) + 1
end

# The structural SCOPE KEY of one binder: (owner key, binder kind, name).
pub def stable_binder_scope_key(owner_key: String, binder_kind: String, name: String) -> String
  owner_key + "\n" + binder_kind + "\n" + name
end

# The binder entry already binding the structural key, else Option::None.
pub def stable_lineage_store_binder_get(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt, binder_kind: String, name: String) -> Option[BinderLineageEntry]
  for entry in store.binder_entries do
    if entry.owner_digest_hi == owner_digest_hi && entry.owner_digest_lo == owner_digest_lo &&
       entry.binder_kind == binder_kind && entry.name == name then
      return Option::Some(entry)
    end
  end
  Option::None
end

# The index of the binder entry carrying (owner identity words, `lineage`)
# (-1 when absent). The owner words are part of the key because binder
# numbers are PER-FUNCTION (the same number names different binders in
# different owners).
def stable_binder_entry_index_of(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> Int
  var i = 0
  while i < store.binder_entries.len() do
    if store.binder_entries[i].lineage == lineage &&
       store.binder_entries[i].owner_digest_hi == owner_digest_hi &&
       store.binder_entries[i].owner_digest_lo == owner_digest_lo then
      return i
    end
    i = i + 1
  end
  -1
end

# The binder identity words of a (owner words, lineage) pair.
def stable_binder_words_of(owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> (UInt, UInt)
  stable_words_of(&stable_binder_lineage_identity_text_of_words(owner_digest_hi, owner_digest_lo, lineage))
end

# The per-function fresh lineage: max(same-owner entry lineage) + 1 (at
# least 1). Numbers are never reused (tombstoned entries count).
def stable_binder_next_lineage(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt) -> Int
  var next = 1
  var i = 0
  while i < store.binder_entries.len() do
    let b = store.binder_entries[i].clone()
    if b.owner_digest_hi == owner_digest_hi && b.owner_digest_lo == owner_digest_lo && b.lineage >= next then
      next = b.lineage + 1
    end
    i = i + 1
  end
  return next
end

# The STRUCTURAL BOOTSTRAP MATCHER of a binder (exact owner+kind+name
# binding revives; else the per-function fresh number).
pub def stable_binder_bootstrap_lineage(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, binder_kind: String, name: String) -> Int
  match stable_lineage_store_binder_get(store, owner.digest_hi, owner.digest_lo, binder_kind.clone(), name.clone())
  when Option::Some(entry) then
    let lineage = entry.lineage
    let idx = stable_binder_entry_index_of(store, owner.digest_hi, owner.digest_lo, lineage)
    if idx >= 0 then
      let b = store.binder_entries[idx].clone()
      store.binder_entries[idx] = BinderLineageEntry {
        owner_key: b.owner_key,
        owner_digest_hi: b.owner_digest_hi,
        owner_digest_lo: b.owner_digest_lo,
        binder_kind: b.binder_kind,
        name: b.name,
        lineage: b.lineage,
        digest_hi: b.digest_hi,
        digest_lo: b.digest_lo,
        sig_digest_hi: b.sig_digest_hi,
        sig_digest_lo: b.sig_digest_lo,
        sig_fingerprint: b.sig_fingerprint,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
    end
    lineage
  when Option::None then
    let lineage = stable_binder_next_lineage(store, owner.digest_hi, owner.digest_lo)
    let w = stable_binder_words_of(owner.digest_hi, owner.digest_lo, lineage)
    store.binder_entries.push(BinderLineageEntry {
      owner_key: owner_key,
      owner_digest_hi: owner.digest_hi,
      owner_digest_lo: owner.digest_lo,
      binder_kind: binder_kind,
      name: name,
      lineage: lineage,
      digest_hi: w.0,
      digest_lo: w.1,
      sig_digest_hi: 0,
      sig_digest_lo: 0,
      sig_fingerprint: "".to_string(),
      last_seen_revision: store.revision.clone(),
      tombstone: false
    })
    lineage
  end
end

pub def stable_lineage_store_binder_sign(inout store: DeclLineageStore, owner: StableDeclId, binder_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Bool
  var i = 0
  while i < store.binder_entries.len() do
    let b = store.binder_entries[i].clone()
    if b.owner_digest_hi == owner.digest_hi && b.owner_digest_lo == owner.digest_lo &&
       b.binder_kind == binder_kind && b.name == name then
      store.binder_entries[i] = BinderLineageEntry {
        owner_key: b.owner_key,
        owner_digest_hi: b.owner_digest_hi,
        owner_digest_lo: b.owner_digest_lo,
        binder_kind: b.binder_kind,
        name: b.name,
        lineage: b.lineage,
        digest_hi: b.digest_hi,
        digest_lo: b.digest_lo,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
      return true
    end
    i = i + 1
  end
  false
end

pub def stable_binder_bootstrap_lineage_signed(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, binder_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let lineage = stable_binder_bootstrap_lineage(store, owner_key, owner.clone(), binder_kind.clone(), name.clone())
  stable_lineage_store_binder_sign(store, owner, binder_kind, name, sig_digest_hi, sig_digest_lo, sig_text)
  lineage
end

def stable_binder_entry_claim(inout store: DeclLineageStore, index: Int, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let old = store.binder_entries[index].clone()
  store.binder_entries[index] = BinderLineageEntry {
    owner_key: old.owner_key,
    owner_digest_hi: old.owner_digest_hi,
    owner_digest_lo: old.owner_digest_lo,
    binder_kind: old.binder_kind,
    name: name,
    lineage: old.lineage,
    digest_hi: old.digest_hi,
    digest_lo: old.digest_lo,
    sig_digest_hi: sig_digest_hi,
    sig_digest_lo: sig_digest_lo,
    sig_fingerprint: sig_text,
    last_seen_revision: store.revision.clone(),
    tombstone: false
  }
  old.lineage
end

def stable_binder_rebind_candidate_index(store: DeclLineageStore, owner: StableDeclId, binder_kind: String, sig_digest_hi: UInt, sig_digest_lo: UInt, live_keys: Vec[String]) -> Int
  var idx = -1
  var matches = 0
  var i = 0
  while i < store.binder_entries.len() do
    let b = store.binder_entries[i].clone()
    if b.owner_digest_hi == owner.digest_hi && b.owner_digest_lo == owner.digest_lo &&
       b.binder_kind == binder_kind && b.sig_digest_hi == sig_digest_hi && b.sig_digest_lo == sig_digest_lo &&
       !b.tombstone && store.previous_revision.len() > 0 &&
       b.last_seen_revision == store.previous_revision then
      let scope = stable_binder_scope_key(b.owner_key.clone(), b.binder_kind.clone(), b.name.clone())
      if !live_keys.contains(&scope) then
        idx = i
        matches = matches + 1
      end
    end
    i = i + 1
  end
  if matches == 1 then idx else -1 end
end

# The whole-build binder stamp: exact binding, conservative rebind, else
# per-function fresh — the binder section has no continuations (locals are
# addressed by name/kind within one owner function). CONTRACT: `name` must
# be the snapshot local's canonical name, UNIQUE per owner among the LIVE
# binders (shadowed/unnamed slots pass the "l<seq>" locator, exactly the
# name the §33 local keys render) — two live binders sharing (owner, kind,
# name) would fuse, so a caller that cannot name a binder uniquely uses
# the locator as its name (the ordinal stays a LOCATOR, never identity).
# Returns the binder's persistent BinderLineageId anchored on the SAME
# owner record passed.
pub def stable_binder_lineage_stamp_or_rebind(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, binder_kind: String, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> BinderLineageId
  match stable_lineage_store_binder_get(store, owner.digest_hi, owner.digest_lo, binder_kind.clone(), name.clone())
  when Option::Some(_) then
    let lineage = stable_binder_bootstrap_lineage_signed(store, owner_key, owner.clone(), binder_kind.clone(), name, sig_digest_hi, sig_digest_lo, sig_text)
    stable_binder_lineage_id_of(owner, lineage)
  when Option::None then
    let idx = stable_binder_rebind_candidate_index(store, owner.clone(), binder_kind.clone(), sig_digest_hi, sig_digest_lo, live_keys)
    if idx >= 0 then
      let lineage = stable_binder_entry_claim(store, idx, name, sig_digest_hi, sig_digest_lo, sig_text)
      stable_binder_lineage_id_of(owner, lineage)
    else
      let lineage = stable_binder_bootstrap_lineage_signed(store, owner_key, owner.clone(), binder_kind, name, sig_digest_hi, sig_digest_lo, sig_text)
      stable_binder_lineage_id_of(owner, lineage)
    end
  end
end

# ———— HIR-node lineages (per owner declaration) ————

# The persistent HIR-NODE lineage of one HIR/AST node of an owner
# declaration (fourth-audit P0-4): identity = (owner declaration
# identity, lineage). The numbers are PER-OWNER (max(same-owner lineage)
# + 1); the node's ordinal and its structural ANCHOR text are store
# metadata / snapshot locators only.
struct HirNodeLineageId
  owner: StableDeclId
  lineage: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The HIR-node-lineage identity text: the owner declaration's identity
# words + the lineage number.
pub def stable_hir_lineage_identity_text_of_words(owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> String
  stable_identity_lenpref(&owner_digest_hi.to_string()) +
  stable_identity_lenpref(&owner_digest_lo.to_string()) +
  stable_identity_lenpref(&lineage.to_string())
end

pub def stable_hir_lineage_identity_text(owner: StableDeclId, lineage: Int) -> String
  stable_hir_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, lineage)
end

pub def stable_hir_lineage_id_of(owner: StableDeclId, lineage: Int) -> HirNodeLineageId
  let text = stable_hir_lineage_identity_text(owner.clone(), lineage)
  let w = stable_words_of(&text)
  HirNodeLineageId { owner: owner, lineage: lineage, digest_hi: w.0, digest_lo: w.1 }
end

# The deterministic synthetic HIR lineage of a text-only parse (the anchor
# is the locator render "H<seq>" or the caller's node render).
pub def stable_hir_synthetic_lineage(owner: StableDeclId, anchor: String) -> Int
  let text = stable_hir_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, 0) +
    stable_identity_lenpref(&anchor)
  let w = stable_words_of(&text)
  ((w.1 >> 1) as Int) + 1
end

# The structural SCOPE KEY of one HIR node: (owner key, anchor).
pub def stable_hir_scope_key(owner_key: String, anchor: String) -> String
  owner_key + "\n" + anchor
end

pub def stable_lineage_store_hir_get(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt, anchor: String) -> Option[HirNodeLineageEntry]
  for entry in store.hir_entries do
    if entry.owner_digest_hi == owner_digest_hi && entry.owner_digest_lo == owner_digest_lo &&
       entry.anchor == anchor then
      return Option::Some(entry)
    end
  end
  Option::None
end

# The index of the HIR entry carrying (owner identity words, `lineage`)
# (-1 when absent). The owner words are part of the key because HIR
# numbers are PER-OWNER (the same number names different nodes in
# different owners).
def stable_hir_entry_index_of(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> Int
  var i = 0
  while i < store.hir_entries.len() do
    if store.hir_entries[i].lineage == lineage &&
       store.hir_entries[i].owner_digest_hi == owner_digest_hi &&
       store.hir_entries[i].owner_digest_lo == owner_digest_lo then
      return i
    end
    i = i + 1
  end
  -1
end

def stable_hir_words_of(owner_digest_hi: UInt, owner_digest_lo: UInt, lineage: Int) -> (UInt, UInt)
  stable_words_of(&stable_hir_lineage_identity_text_of_words(owner_digest_hi, owner_digest_lo, lineage))
end

def stable_hir_next_lineage(store: DeclLineageStore, owner_digest_hi: UInt, owner_digest_lo: UInt) -> Int
  var next = 1
  var i = 0
  while i < store.hir_entries.len() do
    let h = store.hir_entries[i].clone()
    if h.owner_digest_hi == owner_digest_hi && h.owner_digest_lo == owner_digest_lo && h.lineage >= next then
      next = h.lineage + 1
    end
    i = i + 1
  end
  return next
end

pub def stable_hir_bootstrap_lineage(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, anchor: String) -> Int
  match stable_lineage_store_hir_get(store, owner.digest_hi, owner.digest_lo, anchor.clone())
  when Option::Some(entry) then
    let lineage = entry.lineage
    let idx = stable_hir_entry_index_of(store, owner.digest_hi, owner.digest_lo, lineage)
    if idx >= 0 then
      let h = store.hir_entries[idx].clone()
      store.hir_entries[idx] = HirNodeLineageEntry {
        owner_key: h.owner_key,
        owner_digest_hi: h.owner_digest_hi,
        owner_digest_lo: h.owner_digest_lo,
        anchor: h.anchor,
        lineage: h.lineage,
        digest_hi: h.digest_hi,
        digest_lo: h.digest_lo,
        sig_digest_hi: h.sig_digest_hi,
        sig_digest_lo: h.sig_digest_lo,
        sig_fingerprint: h.sig_fingerprint,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
    end
    lineage
  when Option::None then
    let lineage = stable_hir_next_lineage(store, owner.digest_hi, owner.digest_lo)
    let w = stable_hir_words_of(owner.digest_hi, owner.digest_lo, lineage)
    store.hir_entries.push(HirNodeLineageEntry {
      owner_key: owner_key,
      owner_digest_hi: owner.digest_hi,
      owner_digest_lo: owner.digest_lo,
      anchor: anchor,
      lineage: lineage,
      digest_hi: w.0,
      digest_lo: w.1,
      sig_digest_hi: 0,
      sig_digest_lo: 0,
      sig_fingerprint: "".to_string(),
      last_seen_revision: store.revision.clone(),
      tombstone: false
    })
    lineage
  end
end

pub def stable_lineage_store_hir_sign(inout store: DeclLineageStore, owner: StableDeclId, anchor: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Bool
  var i = 0
  while i < store.hir_entries.len() do
    let h = store.hir_entries[i].clone()
    if h.owner_digest_hi == owner.digest_hi && h.owner_digest_lo == owner.digest_lo && h.anchor == anchor then
      store.hir_entries[i] = HirNodeLineageEntry {
        owner_key: h.owner_key,
        owner_digest_hi: h.owner_digest_hi,
        owner_digest_lo: h.owner_digest_lo,
        anchor: h.anchor,
        lineage: h.lineage,
        digest_hi: h.digest_hi,
        digest_lo: h.digest_lo,
        sig_digest_hi: sig_digest_hi,
        sig_digest_lo: sig_digest_lo,
        sig_fingerprint: sig_text,
        last_seen_revision: store.revision.clone(),
        tombstone: false
      }
      return true
    end
    i = i + 1
  end
  false
end

pub def stable_hir_bootstrap_lineage_signed(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, anchor: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let lineage = stable_hir_bootstrap_lineage(store, owner_key, owner.clone(), anchor.clone())
  stable_lineage_store_hir_sign(store, owner, anchor, sig_digest_hi, sig_digest_lo, sig_text)
  lineage
end

def stable_hir_entry_claim(inout store: DeclLineageStore, index: Int, anchor: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String) -> Int
  let old = store.hir_entries[index].clone()
  store.hir_entries[index] = HirNodeLineageEntry {
    owner_key: old.owner_key,
    owner_digest_hi: old.owner_digest_hi,
    owner_digest_lo: old.owner_digest_lo,
    anchor: anchor,
    lineage: old.lineage,
    digest_hi: old.digest_hi,
    digest_lo: old.digest_lo,
    sig_digest_hi: sig_digest_hi,
    sig_digest_lo: sig_digest_lo,
    sig_fingerprint: sig_text,
    last_seen_revision: store.revision.clone(),
    tombstone: false
  }
  old.lineage
end

def stable_hir_rebind_candidate_index(store: DeclLineageStore, owner: StableDeclId, sig_digest_hi: UInt, sig_digest_lo: UInt, live_keys: Vec[String]) -> Int
  var idx = -1
  var matches = 0
  var i = 0
  while i < store.hir_entries.len() do
    let h = store.hir_entries[i].clone()
    if h.owner_digest_hi == owner.digest_hi && h.owner_digest_lo == owner.digest_lo &&
       h.sig_digest_hi == sig_digest_hi && h.sig_digest_lo == sig_digest_lo &&
       !h.tombstone && store.previous_revision.len() > 0 &&
       h.last_seen_revision == store.previous_revision then
      let scope = stable_hir_scope_key(h.owner_key.clone(), h.anchor.clone())
      if !live_keys.contains(&scope) then
        idx = i
        matches = matches + 1
      end
    end
    i = i + 1
  end
  if matches == 1 then idx else -1 end
end

# The whole-build HIR-node stamp: exact (owner, anchor) binding, else the
# conservative owner-scoped rebind, else a per-owner fresh number.
# CONTRACT: `anchor` is the node's canonical content render and must be
# unique per owner for live nodes (two identical anchors would address the
# same node). Returns the node's persistent HirNodeLineageId anchored on
# the SAME owner record passed.
pub def stable_hir_lineage_stamp_or_rebind(inout store: DeclLineageStore, owner_key: String, owner: StableDeclId, anchor: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> HirNodeLineageId
  match stable_lineage_store_hir_get(store, owner.digest_hi, owner.digest_lo, anchor.clone())
  when Option::Some(_) then
    let lineage = stable_hir_bootstrap_lineage_signed(store, owner_key, owner.clone(), anchor, sig_digest_hi, sig_digest_lo, sig_text)
    stable_hir_lineage_id_of(owner, lineage)
  when Option::None then
    let idx = stable_hir_rebind_candidate_index(store, owner.clone(), sig_digest_hi, sig_digest_lo, live_keys)
    if idx >= 0 then
      let lineage = stable_hir_entry_claim(store, idx, anchor, sig_digest_hi, sig_digest_lo, sig_text)
      stable_hir_lineage_id_of(owner, lineage)
    else
      let lineage = stable_hir_bootstrap_lineage_signed(store, owner_key, owner.clone(), anchor, sig_digest_hi, sig_digest_lo, sig_text)
      stable_hir_lineage_id_of(owner, lineage)
    end
  end
end

# The snapshot-row def identity of a store-stamped declaration: a
# StableDefId whose DIGEST WORDS ARE the persistent declaration lineage's
# (stable_decl_stamp's StableDeclId) — the identity survives rename and
# movement — carrying the canonical full key text and the registration
# path as diagnostics / collision cargo. A text digest of full_key can
# only bind the DETERMINISTIC synthetic-lineage fallback
# (stable_def_id_digested / stable_symbol_of_key — boundary parsing); this
# constructor is the store-backed path that supersedes those parsers at
# the §30 snapshot boundary (semantic_snapshot.tg's snapshot_walk_defs).
pub def stable_def_id_of_decl(decl: StableDeclId, full_key: String, path: String) -> StableDefId
  StableDefId {
    hash: decl.digest_lo,
    key: full_key,
    path: path,
    id: decl.digest_lo,
    digest_hi: decl.digest_hi,
    digest_lo: decl.digest_lo
  }
end

# The fresh empty store (next = 1; numbers are never reused; the revision
# clock starts at "" — the first stable_lineage_store_begin_revision
# assigns "1"). The member number counter starts at 1; the binder and HIR
# sections derive their per-owner numbers from their own entries, so no
# separate counters exist.
pub def stable_lineage_store_new() -> DeclLineageStore
  DeclLineageStore {
    entries: Vec::new(),
    continuations: Vec::new(),
    member_entries: Vec::new(),
    member_continuations: Vec::new(),
    binder_entries: Vec::new(),
    hir_entries: Vec::new(),
    next: 1,
    member_next: 1,
    revision: "".to_string(),
    previous_revision: "".to_string()
  }
end

# The store text field escape: '\' -> "\\", '|' -> "\p", LF -> "\n", CR ->
# "\r" and the empty string -> "\e" (the rationale codec's exact
# round-trip discipline — the v2 line grammar is unambiguously decodable).
def stable_lineage_escape(s: String) -> String
  if s.len() == 0 then
    return "\\e"
  end
  var out = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "\\" then
      out = out + "\\\\"
    elsif ch == "|" then
      out = out + "\\p"
    elsif ch == "\n" then
      out = out + "\\n"
    elsif ch == "\r" then
      out = out + "\\r"
    else
      out = out + ch
    end
    i = i + 1
  end
  out
end

def stable_lineage_unescape(s: String) -> String
  var out = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "\\" && i + 1 < s.len() then
      let nxt = s.slice(i + 1, i + 2)
      if nxt == "\\" then
        out = out + "\\"
      elsif nxt == "p" then
        out = out + "|"
      elsif nxt == "n" then
        out = out + "\n"
      elsif nxt == "r" then
        out = out + "\r"
      elsif nxt == "e" then
        out = out + ""
      else
        out = out + nxt
      end
      i = i + 2
    else
      out = out + ch
      i = i + 1
    end
  end
  out
end

# Split a store line on raw '|' separators, preserving EMPTY parts (the v2
# fields are escaped, so no raw '|' occurs inside a field; legacy v1
# fields never carried one).
def stable_lineage_split_raw(line: String) -> Vec[String]
  var parts: Vec[String] = Vec::new()
  var current = ""
  var i = 0
  while i < line.len() do
    let ch = line.slice(i, i + 1)
    if ch == "|" then
      parts.push(current.clone())
      current = ""
    else
      current = current + ch
    end
    i = i + 1
  end
  parts.push(current)
  parts
end

def stable_lineage_bool_parse(text: String) -> Bool
  text == "1" || text == "true"
end

def stable_lineage_bool_text(value: Bool) -> String
  if value then "1" else "0" end
end

# The canonical store TEXT (v2, fourth-audit P0-2/P0-4): the header line
#   "tg-lineage-store v2|<revision>|<previous_revision>"
# then one "e|pkg|module|kind|name|lineage|sig_hi|sig_lo|last_seen|tombstone|sig_fingerprint"
# line per declaration entry, one "c|lineage|reason|old_location|new_location"
# line per explicit declaration continuation, then the P0-4 sections —
#   "m|pkg|owner_key|owner_hi|owner_lo|member_kind|name|lineage|digest_hi|digest_lo|sig_hi|sig_lo|last_seen|tombstone|sig_fingerprint"
#   per member entry,
#   "mc|lineage|reason|old_location|new_location" per member continuation,
#   "b|owner_key|owner_hi|owner_lo|binder_kind|name|lineage|digest_hi|digest_lo|sig_hi|sig_lo|last_seen|tombstone|sig_fingerprint"
#   per binder entry and
#   "h|owner_key|owner_hi|owner_lo|anchor|lineage|digest_hi|digest_lo|sig_hi|sig_lo|last_seen|tombstone|sig_fingerprint"
#   per HIR-node entry —
# in insertion order (trailing newline). The header carries the store's
# revision clock so a LOADED store continues the "immediately preceding
# revision" evidence across processes, and the signature digests/
# fingerprints persist so rename/move matching works after a restart
# exactly as in-process. The text is the STORE FORMAT only — never
# identity.
pub def stable_lineage_store_save(store: DeclLineageStore) -> String
  var out = "tg-lineage-store v2|" + store.revision.clone() + "|" + store.previous_revision.clone() + "\n"
  for entry in store.entries do
    out = out + "e|" + stable_lineage_escape(entry.package_key.clone()) + "|" +
      stable_lineage_escape(entry.module_path.clone()) + "|" +
      stable_lineage_escape(entry.kind.clone()) + "|" +
      stable_lineage_escape(entry.name.clone()) + "|" +
      entry.lineage.to_string() + "|" +
      entry.sig_digest_hi.to_string() + "|" + entry.sig_digest_lo.to_string() + "|" +
      stable_lineage_escape(entry.last_seen_revision.clone()) + "|" +
      stable_lineage_bool_text(entry.tombstone) + "|" +
      stable_lineage_escape(entry.sig_fingerprint.clone()) + "\n"
  end
  for cont in store.continuations do
    out = out + "c|" + cont.lineage.to_string() + "|" +
      stable_lineage_escape(cont.reason.clone()) + "|" +
      stable_lineage_escape(cont.old_location.clone()) + "|" +
      stable_lineage_escape(cont.new_location.clone()) + "\n"
  end
  for member in store.member_entries do
    out = out + "m|" + stable_lineage_escape(member.package_key.clone()) + "|" +
      stable_lineage_escape(member.owner_key.clone()) + "|" +
      member.owner_digest_hi.to_string() + "|" + member.owner_digest_lo.to_string() + "|" +
      stable_lineage_escape(member.member_kind.clone()) + "|" +
      stable_lineage_escape(member.name.clone()) + "|" +
      member.lineage.to_string() + "|" +
      member.digest_hi.to_string() + "|" + member.digest_lo.to_string() + "|" +
      member.sig_digest_hi.to_string() + "|" + member.sig_digest_lo.to_string() + "|" +
      stable_lineage_escape(member.last_seen_revision.clone()) + "|" +
      stable_lineage_bool_text(member.tombstone) + "|" +
      stable_lineage_escape(member.sig_fingerprint.clone()) + "\n"
  end
  for member_cont in store.member_continuations do
    out = out + "mc|" + member_cont.lineage.to_string() + "|" +
      stable_lineage_escape(member_cont.reason.clone()) + "|" +
      stable_lineage_escape(member_cont.old_location.clone()) + "|" +
      stable_lineage_escape(member_cont.new_location.clone()) + "\n"
  end
  for binder in store.binder_entries do
    out = out + "b|" + stable_lineage_escape(binder.owner_key.clone()) + "|" +
      binder.owner_digest_hi.to_string() + "|" + binder.owner_digest_lo.to_string() + "|" +
      stable_lineage_escape(binder.binder_kind.clone()) + "|" +
      stable_lineage_escape(binder.name.clone()) + "|" +
      binder.lineage.to_string() + "|" +
      binder.digest_hi.to_string() + "|" + binder.digest_lo.to_string() + "|" +
      binder.sig_digest_hi.to_string() + "|" + binder.sig_digest_lo.to_string() + "|" +
      stable_lineage_escape(binder.last_seen_revision.clone()) + "|" +
      stable_lineage_bool_text(binder.tombstone) + "|" +
      stable_lineage_escape(binder.sig_fingerprint.clone()) + "\n"
  end
  for hir in store.hir_entries do
    out = out + "h|" + stable_lineage_escape(hir.owner_key.clone()) + "|" +
      hir.owner_digest_hi.to_string() + "|" + hir.owner_digest_lo.to_string() + "|" +
      stable_lineage_escape(hir.anchor.clone()) + "|" +
      hir.lineage.to_string() + "|" +
      hir.digest_hi.to_string() + "|" + hir.digest_lo.to_string() + "|" +
      hir.sig_digest_hi.to_string() + "|" + hir.sig_digest_lo.to_string() + "|" +
      stable_lineage_escape(hir.last_seen_revision.clone()) + "|" +
      stable_lineage_bool_text(hir.tombstone) + "|" +
      stable_lineage_escape(hir.sig_fingerprint.clone()) + "\n"
  end
  out
end

# The transactional store publication (fourth-audit P0-2): write the v2
# text to "<path>.tmp", then rename it over <path>. std::fs::rename is the
# POSIX/Windows atomic-replace primitive — the repository's publication
# discipline (linker.tg:2037-2097): the destination is NOT deleted first,
# so a failed write never destroys the last good store. On a failed write
# or rename the temp file is removed and the error returned; the
# previously persisted store is untouched.
pub def stable_lineage_store_save_atomic(path: String, store: DeclLineageStore) -> Result[Unit, IoError]
  let text = stable_lineage_store_save(store)
  let tmp_path = path.clone() + ".tmp"
  if file_exists(tmp_path.clone()) then
    let _ = delete_file(tmp_path.clone())
  end
  match write_file_bytes(tmp_path.clone(), &text.bytes())
  when Result::Err(e) then
    let _ = delete_file(tmp_path.clone())
    Result::Err(e)
  when Result::Ok(_) then
    match rename(tmp_path.clone(), path.clone())
    when Result::Ok(_) then Result::Ok(())
    when Result::Err(e) then
      let _ = delete_file(tmp_path.clone())
      Result::Err(e)
    end
  end
end

# The store of a canonical store text (TOTAL): the v2 body when the
# "tg-lineage-store v2|..." header line is present — the declaration
# identity digest words are RECOMPUTED from the columns, the signature
# digest words / structural fingerprints / last-seen revisions /
# tombstones are restored verbatim and the revision clock continues from
# the header — else the v1 LEGACY body ("pkg|module|kind|name|lineage"):
# identity recomputed, sig digests 0/0 (unknown), fingerprint "",
# last-seen "" and tombstone false. next = max lineage + 1. A malformed
# line is skipped — a store text is persistent cargo, never the identity
# authority.
pub def stable_lineage_store_load(text: String) -> DeclLineageStore
  var store = stable_lineage_store_new()
  var is_v2 = false
  var header_seen = false
  for line in text.lines() do
    let trimmed = line.trim()
    if trimmed.len() == 0 then
      continue
    end
    if !header_seen then
      header_seen = true
      if trimmed.starts_with("tg-lineage-store v2") then
        is_v2 = true
        let hp = stable_lineage_split_raw(&trimmed)
        if hp.len() >= 2 then
          store.revision = stable_lineage_unescape(hp[1].clone())
        end
        if hp.len() >= 3 then
          store.previous_revision = stable_lineage_unescape(hp[2].clone())
        end
      end
    end
    if is_v2 then
      let parts = stable_lineage_split_raw(&line)
      if parts.len() >= 1 && parts[0] == "e" then
        if parts.len() == 11 && stable_is_digits(&parts[5]) &&
           stable_is_digits(&parts[6]) && stable_is_digits(&parts[7]) then
          let lineage = stable_text_to_int(&parts[5])
          let pkg = stable_lineage_unescape(parts[1].clone())
          let module_path = stable_lineage_unescape(parts[2].clone())
          let kind = stable_lineage_unescape(parts[3].clone())
          let name = stable_lineage_unescape(parts[4].clone())
          let identity = stable_decl_id_of_lineage_texts(pkg.clone(), module_path.clone(), lineage, kind.clone())
          store.entries.push(LineageEntry {
            package_key: pkg,
            module_path: module_path,
            kind: kind,
            name: name,
            lineage: lineage,
            digest_hi: identity.digest_hi,
            digest_lo: identity.digest_lo,
            sig_digest_hi: stable_text_to_uint(&parts[6]),
            sig_digest_lo: stable_text_to_uint(&parts[7]),
            sig_fingerprint: stable_lineage_unescape(parts[10].clone()),
            last_seen_revision: stable_lineage_unescape(parts[8].clone()),
            tombstone: stable_lineage_bool_parse(parts[9].clone())
          })
          if lineage >= store.next then
            store.next = lineage + 1
          end
        end
      elsif parts.len() >= 1 && parts[0] == "c" then
        if parts.len() == 5 && stable_is_digits(&parts[1]) then
          store.continuations.push(DeclContinuation {
            lineage: stable_text_to_int(&parts[1]),
            reason: stable_lineage_unescape(parts[2].clone()),
            old_location: stable_lineage_unescape(parts[3].clone()),
            new_location: stable_lineage_unescape(parts[4].clone())
          })
        end
      elsif parts.len() >= 1 && parts[0] == "m" then
        if parts.len() == 15 && stable_is_digits(&parts[3]) && stable_is_digits(&parts[4]) &&
           stable_is_digits(&parts[7]) && stable_is_digits(&parts[8]) &&
           stable_is_digits(&parts[9]) && stable_is_digits(&parts[10]) &&
           stable_is_digits(&parts[11]) then
          let lineage = stable_text_to_int(&parts[7])
          let owner_hi = stable_text_to_uint(&parts[3])
          let owner_lo = stable_text_to_uint(&parts[4])
          let member_kind = stable_lineage_unescape(parts[5].clone())
          let w = stable_member_words_of(owner_hi, owner_lo, member_kind.clone(), lineage)
          store.member_entries.push(MemberLineageEntry {
            package_key: stable_lineage_unescape(parts[1].clone()),
            owner_key: stable_lineage_unescape(parts[2].clone()),
            owner_digest_hi: owner_hi,
            owner_digest_lo: owner_lo,
            member_kind: member_kind,
            name: stable_lineage_unescape(parts[6].clone()),
            lineage: lineage,
            digest_hi: w.0,
            digest_lo: w.1,
            sig_digest_hi: stable_text_to_uint(&parts[10]),
            sig_digest_lo: stable_text_to_uint(&parts[11]),
            sig_fingerprint: stable_lineage_unescape(parts[14].clone()),
            last_seen_revision: stable_lineage_unescape(parts[12].clone()),
            tombstone: stable_lineage_bool_parse(parts[13].clone())
          })
          if lineage >= store.member_next then
            store.member_next = lineage + 1
          end
        end
      elsif parts.len() >= 1 && parts[0] == "mc" then
        if parts.len() == 5 && stable_is_digits(&parts[1]) then
          store.member_continuations.push(MemberContinuation {
            lineage: stable_text_to_int(&parts[1]),
            reason: stable_lineage_unescape(parts[2].clone()),
            old_location: stable_lineage_unescape(parts[3].clone()),
            new_location: stable_lineage_unescape(parts[4].clone())
          })
        end
      elsif parts.len() >= 1 && parts[0] == "b" then
        if parts.len() == 14 && stable_is_digits(&parts[2]) && stable_is_digits(&parts[3]) &&
           stable_is_digits(&parts[6]) && stable_is_digits(&parts[7]) &&
           stable_is_digits(&parts[8]) && stable_is_digits(&parts[9]) &&
           stable_is_digits(&parts[10]) then
          let lineage = stable_text_to_int(&parts[6])
          let owner_hi = stable_text_to_uint(&parts[2])
          let owner_lo = stable_text_to_uint(&parts[3])
          let w = stable_binder_words_of(owner_hi, owner_lo, lineage)
          store.binder_entries.push(BinderLineageEntry {
            owner_key: stable_lineage_unescape(parts[1].clone()),
            owner_digest_hi: owner_hi,
            owner_digest_lo: owner_lo,
            binder_kind: stable_lineage_unescape(parts[4].clone()),
            name: stable_lineage_unescape(parts[5].clone()),
            lineage: lineage,
            digest_hi: w.0,
            digest_lo: w.1,
            sig_digest_hi: stable_text_to_uint(&parts[9]),
            sig_digest_lo: stable_text_to_uint(&parts[10]),
            sig_fingerprint: stable_lineage_unescape(parts[13].clone()),
            last_seen_revision: stable_lineage_unescape(parts[11].clone()),
            tombstone: stable_lineage_bool_parse(parts[12].clone())
          })
        end
      elsif parts.len() >= 1 && parts[0] == "h" then
        if parts.len() == 13 && stable_is_digits(&parts[2]) && stable_is_digits(&parts[3]) &&
           stable_is_digits(&parts[5]) && stable_is_digits(&parts[6]) &&
           stable_is_digits(&parts[7]) && stable_is_digits(&parts[8]) &&
           stable_is_digits(&parts[9]) then
          let lineage = stable_text_to_int(&parts[5])
          let owner_hi = stable_text_to_uint(&parts[2])
          let owner_lo = stable_text_to_uint(&parts[3])
          let w = stable_hir_words_of(owner_hi, owner_lo, lineage)
          store.hir_entries.push(HirNodeLineageEntry {
            owner_key: stable_lineage_unescape(parts[1].clone()),
            owner_digest_hi: owner_hi,
            owner_digest_lo: owner_lo,
            anchor: stable_lineage_unescape(parts[4].clone()),
            lineage: lineage,
            digest_hi: w.0,
            digest_lo: w.1,
            sig_digest_hi: stable_text_to_uint(&parts[8]),
            sig_digest_lo: stable_text_to_uint(&parts[9]),
            sig_fingerprint: stable_lineage_unescape(parts[12].clone()),
            last_seen_revision: stable_lineage_unescape(parts[10].clone()),
            tombstone: stable_lineage_bool_parse(parts[11].clone())
          })
        end
      end
    else
      let parts = stable_lineage_split_raw(&line)
      if parts.len() >= 5 && stable_is_digits(&parts[4]) then
        let lineage = stable_text_to_int(&parts[4])
        let identity = stable_decl_id_of_lineage_texts(parts[0].clone(), parts[1].clone(), lineage, parts[2].clone())
        store.entries.push(LineageEntry {
          package_key: parts[0].clone(),
          module_path: parts[1].clone(),
          kind: parts[2].clone(),
          name: parts[3].clone(),
          lineage: lineage,
          digest_hi: identity.digest_hi,
          digest_lo: identity.digest_lo,
          sig_digest_hi: 0,
          sig_digest_lo: 0,
          sig_fingerprint: "".to_string(),
          last_seen_revision: "".to_string(),
          tombstone: false
        })
        if lineage >= store.next then
          store.next = lineage + 1
        end
      end
    end
  end
  store
end

# The digest words of a lineage entry (the declaration identity cargo).
pub def stable_lineage_entry_digest(entry: LineageEntry) -> (UInt, UInt)
  (entry.digest_hi, entry.digest_lo)
end

# The canonical LINEAGE REFERENCE text of a declaration: the record's
# display text when a text parse recorded one, else a deterministic
# diagnostics / ordering render built from the identity pieces (package,
# module, lineage number, kind) — NOT the identity (the digest words are).
# The §31/§32 protocol rows use it exactly where the old record's
# lineage_key text was used.
pub def stable_decl_reference_text(decl: StableDeclId) -> String
  if decl.display_key.len() > 0 then
    return decl.display_key.clone()
  end
  decl.package.key.clone() + "::" + decl.module.path.clone() + "#L" +
    decl.lineage.lineage.to_string() + ":" + decl.kind.clone()
end

# The symbol identity of a def: its declaration lineage plus its signature
# fingerprint, with the full def digest key text kept for diagnostics,
# rendering and ids.tg-style text verification of digest collisions.
struct StableSymbolId
  decl: StableDeclId
  fingerprint: SignatureFingerprint
  full_key: String
end

# The digest-carrying fallback fingerprint: pieces empty, digest over the
# sig text as-is (the text is not canonical callable grammar — a type-row
# sig, an empty sig, or a pure-lineage advisory key's "").
def stable_fp_unparsed(sig_text: String) -> SignatureFingerprint
  let w = stable_words_of(&sig_text)
  SignatureFingerprint {
    conventions: "".to_string(),
    params: Vec::new(),
    binder_count: 0,
    const_params: Vec::new(),
    return_type: "".to_string(),
    effects: "".to_string(),
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# Parse rule 4: the LAST "effects(" ... ")" group at or after `from` that
# closes exactly at the text end (-1 when none). Scanned downward so the
# first valid candidate IS the last group. Depth starts at 1 (the group's
# own opening paren); any nested "(" increments, and the group's final ")"
# must be the balance point at the very last text byte.
def stable_fp_effects_start(s: String, from: Int) -> Int
  var j = s.len() - 8
  while j >= from do
    if s.slice(j, j + 8) == "effects(" then
      var depth = 1
      var i = j + 8
      var ok = true
      while i < s.len() do
        let ch = s.slice(i, i + 1)
        if ch == "(" then
          depth = depth + 1
        elsif ch == ")" then
          depth = depth - 1
          if depth == 0 && i != s.len() - 1 then
            ok = false
            break
          end
        end
        i = i + 1
      end
      if ok && depth == 0 then
        return j
      end
    end
    j = j - 1
  end
  -1
end

# Parse rule 5: split a param body at depth-0 commas (the body between
# "fn(" and its closing ")"). Canonical bodies are bracket-balanced, so a
# depth-0 comma is always a param separator.
def stable_fp_split_params(body: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var depth = 0
  var seg_start = 0
  var i = 0
  while i < body.len() do
    let ch = body.slice(i, i + 1)
    if ch == "(" || ch == "[" || ch == "{" then
      depth = depth + 1
    elsif ch == ")" || ch == "]" || ch == "}" then
      depth = depth - 1
    elsif ch == "," && depth == 0 then
      out.push(body.slice(seg_start, i))
      seg_start = i + 1
    end
    i = i + 1
  end
  if seg_start < body.len() then
    out.push(body.slice(seg_start, body.len()))
  end
  out
end

# Parse rule 6: the DISTINCT generic-binder reference texts "P<idx>o<owner>"
# in a type-text region, in first-occurrence order. A token is a "P" whose
# previous char is not "C" ("CP" is the const-param form) followed by
# digits, "o" and MORE digits; the scan terminates at the first non-digit
# after the owner (canonical renders never run a digit into the owner, so
# "P0o5effects(e1)" — a Param return type before the fn's effects suffix —
# still yields "P0o5"). A pathological path segment rendered in an Adt
# name (e.g. a module "P3o5") over-matches — advisory fields only (see
# parse rule 6 in the section doc).
def stable_fp_binder_tokens(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var prev = "".to_string()
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch == "P" && prev != "C" then
      var j = i + 1
      while j < text.len() && text.slice(j, j + 1) >= "0" && text.slice(j, j + 1) <= "9" do
        j = j + 1
      end
      if j > i + 1 && j < text.len() && text.slice(j, j + 1) == "o" then
        var k = j + 1
        while k < text.len() && text.slice(k, k + 1) >= "0" && text.slice(k, k + 1) <= "9" do
          k = k + 1
        end
        if k > j + 1 then
          let tok = text.slice(i, k)
          if !out.contains(&tok) then out.push(tok) end
        end
      end
    end
    prev = ch
    i = i + 1
  end
  out
end

# Parse rule 6: the DISTINCT const-param reference texts "CP<idx>" in a
# type-text region, in first-occurrence order (digits, terminating at the
# first non-digit — same termination rule as the binder scan above).
def stable_fp_const_tokens(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var i = 0
  while i < text.len() do
    if i + 2 <= text.len() && text.slice(i, i + 2) == "CP" then
      var j = i + 2
      while j < text.len() && text.slice(j, j + 1) >= "0" && text.slice(j, j + 1) <= "9" do
        j = j + 1
      end
      if j > i + 2 then
        let tok = text.slice(i, j)
        if !out.contains(&tok) then out.push(tok) end
      end
    end
    i = i + 1
  end
  out
end

# The parsed signature fingerprint of a canonical callable "#sig" text
# (parse rules above): Option::None for any text that is not exactly the
# callable grammar — use stable_fp_unparsed's fallback (or the symbol
# builders, which do) for type-row sig texts.
pub def signature_fingerprint_of_sig_text(sig_text: String) -> Option[SignatureFingerprint]
  if !sig_text.starts_with("fn(") then return Option::None end
  var depth = 1
  var i = 3
  var close_at = -1
  while i < sig_text.len() do
    let ch = sig_text.slice(i, i + 1)
    if ch == "(" || ch == "[" || ch == "{" then
      depth = depth + 1
    elsif ch == ")" || ch == "]" || ch == "}" then
      depth = depth - 1
      if depth == 0 then
        close_at = i
        break
      end
    end
    i = i + 1
  end
  if close_at < 0 then return Option::None end
  if close_at + 3 > sig_text.len() then return Option::None end
  if sig_text.slice(close_at + 1, close_at + 3) != "->" then return Option::None end
  let ret_at = close_at + 3
  let eff_at = stable_fp_effects_start(&sig_text, ret_at)
  var return_text = "".to_string()
  var effects_text = "".to_string()
  if eff_at >= 0 then
    return_text = sig_text.slice(ret_at, eff_at)
    effects_text = sig_text.slice(eff_at, sig_text.len())
  else
    return_text = sig_text.slice(ret_at, sig_text.len())
  end
  if return_text.len() == 0 then return Option::None end
  let body = sig_text.slice(3, close_at)
  let segments = stable_fp_split_params(&body)
  var conventions: Vec[String] = Vec::new()
  var types: Vec[String] = Vec::new()
  var all_types = "".to_string()
  for seg in segments do
    let cpos = stable_index_of(&seg, ":", 0)
    if cpos <= 0 then return Option::None end
    let cw = seg.slice(0, cpos)
    if cw != "let" && cw != "inout" && cw != "sink" && cw != "set" then
      return Option::None
    end
    let ty_text = seg.slice(cpos + 1, seg.len())
    if ty_text.len() == 0 then return Option::None end
    conventions.push(cw)
    types.push(ty_text.clone())
    all_types = all_types + ty_text
  end
  all_types = all_types + return_text
  let binders = stable_fp_binder_tokens(&all_types)
  let consts = stable_fp_const_tokens(&all_types)
  let w = stable_words_of(&sig_text)
  Option::Some(SignatureFingerprint {
    conventions: conventions.join(","),
    params: types,
    binder_count: binders.len(),
    const_params: consts,
    return_type: return_text,
    effects: effects_text,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The declaration identity of a def digest key "path::name#sig": the whole
# text before the FIRST "#" is the registration lineage ("path::name" — the
# registration-key grammar). The persistent number is NOT recoverable from
# text, so the text-only parse binds the DETERMINISTIC synthetic lineage of
# the lineage text (stable_synthetic_lineage — deterministic within and
# across compilations, rename-FRAGILE): a writer that holds a
# DeclLineageStore must build through stable_decl_id_of_lineage_store
# instead, which is the ONLY constructor that survives renames/moves.
# THE STORE-BACKED PATH SUPERSEDES THIS PARSER at the §30 snapshot
# boundary: the builder's def walk stamps each declaration through
# stable_decl_stamp_or_rebind / stable_decl_stamp / stable_decl_stamp_renamed
# (semantic_snapshot.tg's snapshot_walk_defs) and roots the row identity on
# the assigned number (stable_def_id_of_decl). This function REMAINS the
# text-boundary fallback for keys that arrive as text only (§31 delta row
# maps, §32 index and §33/§36/§37 consumers that hold a canonical key
# text and no store) — it is exact for text-parsed records and can never
# recover a store number.
# Option::None when the text has no "#" or an empty lineage. kind stays ""
# — the key text carries no kind; the owning row's kind metadata stamps it
# through stable_decl_id_with_lineage (the kind IS digested, so stamping is
# an identity construction, never a field mutation). A composite key that
# EMBEDS a def key (a §33 node key "<fn key>#B<block>#S<idx>") parses the
# embedded def key's lineage — for the node's own function identity the
# caller passes the "<fn key>" part.
pub def decl_id_of_full_key(full_key: String) -> Option[StableDeclId]
  let i = stable_index_of(&full_key, "#", 0)
  if i <= 0 then return Option::None end
  let lineage = full_key.slice(0, i)
  let mkey = stable_key_module(&lineage)
  Option::Some(stable_decl_id_of_lineage_texts_named(
    "".to_string(),
    mkey,
    stable_synthetic_lineage(&lineage),
    "".to_string(),
    lineage
  ))
end

# The symbol identity of a def digest key: its declaration lineage id plus
# the signature fingerprint of its "#sig" component (parsed when the
# component is canonical callable grammar, digest-carrying fallback
# otherwise). Option::None when the key is not def-shaped (no "#" or an
# empty lineage).
pub def stable_symbol_id_of_full_key(full_key: String) -> Option[StableSymbolId]
  let i = stable_index_of(&full_key, "#", 0)
  if i <= 0 then return Option::None end
  let sig_text = full_key.slice(i + 1, full_key.len())
  let decl = match decl_id_of_full_key(&full_key)
    when Option::Some(d) then d
    when Option::None then return Option::None
  end
  let fingerprint = match signature_fingerprint_of_sig_text(&sig_text)
    when Option::Some(f) then f
    when Option::None then stable_fp_unparsed(&sig_text)
  end
  Option::Some(StableSymbolId {
    decl: decl,
    fingerprint: fingerprint,
    full_key: full_key.clone()
  })
end

# ———————————————————————————————————————————————————————————————
# The Eq/Hash implementations (the id-record impl pattern — CapabilityId,
# types.tg:9073): equality and hashing over the DIGEST WORDS ONLY. The
# stored pieces (package / module / lineage / kind / full_key and the
# fingerprint parse pieces) are the collision-detection cargo and the
# diagnostics surface — a digest-keyed map insert text-verifies against
# them (ids.tg's stable-id registry doctrine).
#
# CLONE (audit item 5; extended by third-audit item 11): the section-10
# StableRowKey carries a StableDeclId as a FIELD, and a derived clone of a
# record discharges every nominal field through its REGISTERED Clone impl
# (derivation does not recurse into nested nominals: the failure is "cannot
# derive Clone for StableRowKey: field `decl` ... no registered Clone").
# StableDeclId's nested records are registered here, so the composite row
# keys clone freely.
# ———————————————————————————————————————————————————————————————

impl Clone for StablePackageId
  def clone(self: Self) -> StablePackageId
    StablePackageId {
      key: self.key.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for StableModuleId
  def clone(self: Self) -> StableModuleId
    StableModuleId {
      package: self.package.clone(),
      path: self.path.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for DeclLineageId
  def clone(self: Self) -> DeclLineageId
    DeclLineageId {
      package: self.package.clone(),
      module: self.module.clone(),
      lineage: self.lineage,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for LineageEntry
  def clone(self: Self) -> LineageEntry
    LineageEntry {
      package_key: self.package_key.clone(),
      module_path: self.module_path.clone(),
      kind: self.kind.clone(),
      name: self.name.clone(),
      lineage: self.lineage,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo,
      sig_digest_hi: self.sig_digest_hi,
      sig_digest_lo: self.sig_digest_lo,
      sig_fingerprint: self.sig_fingerprint.clone(),
      last_seen_revision: self.last_seen_revision.clone(),
      tombstone: self.tombstone
    }
  end
end

impl Clone for DeclContinuation
  def clone(self: Self) -> DeclContinuation
    DeclContinuation {
      lineage: self.lineage,
      old_location: self.old_location.clone(),
      new_location: self.new_location.clone(),
      reason: self.reason.clone()
    }
  end
end

impl Clone for DeclLineageStore
  def clone(self: Self) -> DeclLineageStore
    DeclLineageStore {
      entries: self.entries.clone(),
      continuations: self.continuations.clone(),
      member_entries: self.member_entries.clone(),
      member_continuations: self.member_continuations.clone(),
      binder_entries: self.binder_entries.clone(),
      hir_entries: self.hir_entries.clone(),
      next: self.next,
      member_next: self.member_next,
      revision: self.revision.clone(),
      previous_revision: self.previous_revision.clone()
    }
  end
end

impl Clone for StableDeclId
  def clone(self: Self) -> StableDeclId
    StableDeclId {
      package: self.package.clone(),
      module: self.module.clone(),
      lineage: self.lineage.clone(),
      kind: self.kind.clone(),
      display_key: self.display_key.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Eq for StableDeclId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableDeclId
  # The two digest words folded through the unsigned 64-bit view (the
  # ProjectionChain hash fold, types.tg:2906): unsigned arithmetic wraps,
  # so the signed +-*-trap never fires inside the hash.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for StableSymbolId
  # Equality over BOTH digest pairs: the declaration words and the
  # fingerprint words (same lineage text AND same sig text ⟺ equal full
  # key text, up to an actual 128-bit collision — detectable against the
  # stored full_key at insert, never counter-disambiguated).
  def eq(self: Self, other: Self) -> Bool
    self.decl.digest_hi == other.decl.digest_hi &&
    self.decl.digest_lo == other.decl.digest_lo &&
    self.fingerprint.digest_hi == other.fingerprint.digest_hi &&
    self.fingerprint.digest_lo == other.fingerprint.digest_lo
  end
end

impl Hash for StableSymbolId
  # The four digest words (declaration hi/lo, fingerprint hi/lo) folded
  # through the unsigned 64-bit view — the same fold as StableDeclId's
  # hash, over both digests.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.decl.digest_hi) as Int
    h = ((h as UInt) * 31 + self.decl.digest_lo) as Int
    h = ((h as UInt) * 31 + self.fingerprint.digest_hi) as Int
    h = ((h as UInt) * 31 + self.fingerprint.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# 7. Impl, place/value and generated-executable identities (audit item 7)
# ———————————————————————————————————————————————————————————————
# The section-6 shape — piece-carrying records whose digest words digest
# the CANONICAL composite key text (identity is a pure function of the
# text; the stored pieces are collision-detection cargo / the diagnostics
# surface) — over domains NO §29-§37 row family materializes today. The
# canonical texts are defined against the producers that already exist:
#
#   StableImplId / StableImplMethodId — an IMPL declaration and one of its
#     methods, over types.tg ImplInfo's registration data:
#       impl-text = trait_key "|" self_pattern "|" binder_text "|" predicate_text
#     trait_key      — the trait's def digest key text
#                      ("path::Trait#trait{...}"); "" for an INHERENT impl
#                      (ImplInfo.trait_id is TraitId(-1)).
#     self_pattern   — the canonical type text of ImplInfo.for_type (the
#                      snapshot_type_text grammar of the §6 parse doc).
#     binder_text    — ImplInfo.generic_params in DECLARATION order, each
#                      the type-text Param reference "P<idx>o<owner>",
#                      ","-joined (positional, never sorted).
#     predicate_text — ImplInfo.obligations in registration order, each
#                      "<subject text>:<trait def key>[<arg texts>]"
#                      (args ","-joined; "[]" when none), ","-joined —
#                      the FINAL component, like the §31 contract clause.
#     A METHOD's key text = impl-text "#" method name (the declared NAME
#     the ImplInfo.methods entries register under), digested whole.
#     Parse corner: a canonical component carrying an effects TYPE
#     "E{...|...}" holds '|', and the text-parse (first three '|'s)
#     mis-splits such a component — digests cover the SAME canonical text
#     a writer produces, so identity is unaffected (no impl rows exist).
#
#   StableLocalId / StablePlaceId — one LOCAL slot of a lowered function,
#     and one PLACE of its ownership rows. The canonical place text IS the
#     row text semantic_snapshot.tg's ownership builder emits
#     (snapshot_place_key): the base local's name text (a DECLARED name or
#     the "l<ordinal>" locator of an unnamed slot — snapshot_local_name's
#     grammar), then the projection segments in order: "." name (a Field
#     or Variant — both render the declaration name; the text cannot tell
#     them apart), "." digits (a TupleIndex), "[" name "]" (a dynamic
#     ProjIndex), "[" digits "]" (a ProjConstantIndex), "*" (a ProjDeref).
#     stable_place_of_text parses EXACTLY that grammar into the advisory
#     chain (kind words Field / Tuple / Index / Deref; a name-only segment
#     — a field/variant name or a dynamic-index local — carries index -1).
#     The root's function_key is ROW METADATA ("" from a text parse — a
#     place text is function-scoped): diagnostics / text verification
#     only, never Eq/Hash. Local digest = the name text; place digest =
#     the full place text.
#
#   StableValueId — a VALUE row (reserved: no snapshot family renders
#     value rows today). kind = the producing row's value-family word;
#     digest text = kind "|" text.
#
#   StableDropGlueId / StableClosureId / StableDerivedBodyId /
#   StableShimId — the GENERATED-EXECUTABLE rows of the mir_functions
#     MirOrigin classifier (snapshot_origin_key_text's non-Decl families):
#     key IS the row key text the classifier emits — "drop-glue::<type
#     key>", "closure::<emission key>", "derived::<kind>::<key>",
#     "shim::<surface key>" — byte-identical with the rows. Constructors
#     take the ORIGIN piece: the drop-glue type key (the concrete type
#     identity key text of mir_type_identity_key's grammar, the
#     MirOrigin::DropGlue payload), the closure emission name, the derived
#     kind + emission key, the shim's extern surface name.
#
# Eq/Hash follow the section-6 doctrine over the digest words ONLY.

# An IMPL declaration: the impl-text pieces over the ImplInfo registration
# data plus the digest of the full impl text (grammar above).
struct StableImplId
  trait_key: String
  self_pattern: String
  binder_text: String
  predicate_text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE method of an impl: the impl record plus the method's declared name;
# the digest words cover impl-text "#" method name whole. (The field is
# impl_id — "impl" is a keyword token, not an identifier.)
struct StableImplMethodId
  impl_id: StableImplId
  method_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— Locals, binders and places (third-audit items 14-15; P0-4) ————
#
# A LOCAL of a lowered function: the OWNER structural instance, the BINDER
# identity within that owner and the display name. The binder's identity
# is the PERSISTENT BinderLineageId the store assigned once
# (stable_local_lineage_stamp — per-function numbering), so inserting a
# local before it never re-keys it; the binder ORDINAL rides as a
# snapshot locator only. Two same-named locals in different blocks of one
# function are distinguished by their store lineages (a text-only parse
# falls back to the synthetic lineage of the ordinal locator). The
# display name is metadata only — never identity.
#
# A local is per-INSTANCE post-monomorphization: the owner mirrors the
# function key the §33 rows carry — the def-keyed body's canonical key or
# the emission/origin key of a synthesized body. The owner is a
# StructuralInstanceId (P0-6); a text-only parse carries the empty
# instance as its documented bootstrap placeholder.
#
# A PLACE is a typed root local plus a chain of STABLE PROJECTIONS (item
# 15). Projection kinds: "field" (a resolved StableFieldId), "tuple" (a
# tuple position), "downcast" (a resolved StableVariantId) and "index" (a
# constant index projection). DYNAMIC index projections are NOT stable
# places — they name a runtime value, not a member, and no constructor
# produces them (the text parser returns Option::None on one). A
# field/variant projection's identity is the member's PERSISTENT lineage
# (P0-4), never its declared index.
# The BINDER identity of a local (section doc; fourth-audit P0-4): the
# owner function's stable declaration, the PERSISTENT BinderLineageId the
# store assigned once and the binder ORDINAL in the owner. The ordinal is
# a SNAPSHOT LOCATOR only (the lowered body's slot order); identity is
# (owner, lineage), so inserting a local before the binder never re-keys
# it. The digest words fold the lineage identity; the text-only fallback
# binds the deterministic synthetic lineage of the "l<ordinal>" locator
# (the documented bootstrap fallback — the store is the authority).
struct StableBinderId
  owner_function: StableDeclId
  binder_lineage: Option[BinderLineageId] = Option::None
  binder_seq: Int = -1
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE local slot of a lowered function (section doc; fourth-audit P0-4):
# the owner structural instance, the persistent binder identity and the
# display name (metadata only).
struct StableLocalId
  owner: StructuralInstanceId
  binder: StableBinderId
  display_name: String
end

# ONE resolved FIELD of a place projection (section doc; fourth-audit
# P0-4): the owner type's stable decl (Option::None from a text-only parse
# that had no type table — the name is then the carried metadata), the
# PERSISTENT MemberLineageId and the member INDEX. The INDEX is a SNAPSHOT
# LOCATOR ONLY (the declared position in the owner's layout): identity is
# (owner, member kind, lineage), so inserting/reordering fields never
# re-keys the survivors and a field rename never re-keys a place. A
# no-store parse binds the deterministic synthetic lineage of the declared
# name (name-derived bootstrap fallback); the store path is rename-stable.
struct StableFieldId
  owner_type: Option[StableDeclId] = Option::None
  member_lineage: Option[MemberLineageId] = Option::None
  index: Int = -1
  name: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE resolved VARIANT of a downcast projection: the same shape and the
# same identity rule as StableFieldId (owner + member kind "variant" +
# lineage; the index is a snapshot locator).
struct StableVariantId
  owner_type: Option[StableDeclId] = Option::None
  member_lineage: Option[MemberLineageId] = Option::None
  index: Int = -1
  name: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE stable projection segment of a place chain. kind is one of the four
# stable words "field" / "tuple" / "downcast" / "index"; field and variant
# carry the RESOLVED stable ids (the text parser without a type table
# carries the name with owner_type Option::None); tuple_index carries the
# tuple position / constant index. digest words cover the structural
# segment text (kind + the resolved member identity).
struct StableProjection
  kind: String
  field: Option[StableFieldId] = Option::None
  tuple_index: Int = -1
  variant: Option[StableVariantId] = Option::None
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE place of a function's ownership rows: the typed root local, the
# stable projection chain and the digest words of the STRUCTURAL place
# identity (stable_place_identity_text — root + projections; never a text
# render). The text render stable_place_text_of is DIAGNOSTICS ONLY.
struct StablePlaceId
  root: StableLocalId
  projections: Vec[StableProjection] = Vec::new()
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE value row (reserved grammar — no snapshot family renders value rows
# today): kind = the value-family word of the producing row, text = the
# canonical value text; the digest words digest kind "|" text.
struct StableValueId
  kind: String
  text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The four generated-executable ids: key = the mir_functions origin ROW
# key text of snapshot_origin_key_text's non-Decl families (prefixes keep
# the families disjoint from user emission names forever), digest words
# over that key text.
struct StableDropGlueId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableClosureId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableDerivedBodyId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableShimId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— The impl-text builder and accessor ————

# The impl record of an impl declaration's registration data: the pieces
# are canonical as documented above (the row writer renders them from
# ImplInfo); the digest words digest the full impl text
# "trait_key|self_pattern|binder_text|predicate_text".
pub def stable_impl_id_of(
  trait_key: String,
  self_pattern: String,
  binder_text: String,
  predicate_text: String
) -> StableImplId
  let text = trait_key + "|" + self_pattern + "|" + binder_text + "|" + predicate_text
  let w = stable_words_of(&text)
  StableImplId {
    trait_key: trait_key,
    self_pattern: self_pattern,
    binder_text: binder_text,
    predicate_text: predicate_text,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The impl record of an impl-text key: Option::None for any text that is
# not exactly the four-component impl-text grammar — three "|" separators,
# a trait part that is empty (an inherent impl) or a def digest key, and a
# NON-EMPTY self part (binders and predicates may be empty — an empty
# binder list and an impl with no obligations render empty segments). The
# digest words digest the key text as given.
pub def stable_impl_of_key(key: String) -> Option[StableImplId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 < 0 then return Option::None end
  let trait_part = key.slice(0, i1)
  if trait_part.len() > 0 && !stable_def_key_shape(&trait_part) then
    return Option::None
  end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 < 0 then return Option::None end
  let i3 = stable_index_of(key, "|", i2 + 1)
  if i3 < 0 then return Option::None end
  let self_part = key.slice(i1 + 1, i2)
  if self_part.len() == 0 then return Option::None end
  let binder_part = key.slice(i2 + 1, i3)
  let pred_part = key.slice(i3 + 1, key.len())
  let w = stable_words_of(&key)
  Option::Some(StableImplId {
    trait_key: trait_part,
    self_pattern: self_part,
    binder_text: binder_part,
    predicate_text: pred_part,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# ———— The typed place constructors and the text boundary (item 15) ————

# The end of a NAME RUN of a canonical place text starting at `from`: a
# maximal run of bytes that are not place-structure bytes (".", "[", "]",
# "*" — ASCII bytes no identifier/locator text carries; multi-byte XID
# identifier bytes pass through). Returns `from` when the run is empty.
def stable_place_run_end(s: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "." || ch == "[" || ch == "]" || ch == "*" then
      return i
    end
    i = i + 1
  end
  i
end

# The structural identity text of a binder: the owner function
# declaration's identity words + the PERSISTENT binder lineage when one is
# bound (the store path), else the locator-anchored bootstrap fallback
# (a text parse binds the deterministic synthetic lineage of the ordinal).
pub def stable_binder_identity_text(binder: StableBinderId) -> String
  match binder.binder_lineage
  when Option::Some(bl) then
    stable_binder_lineage_identity_text_of_words(binder.owner_function.digest_hi, binder.owner_function.digest_lo, bl.lineage)
  when Option::None then
    stable_binder_lineage_identity_text_of_words(binder.owner_function.digest_hi, binder.owner_function.digest_lo, 0) +
      stable_identity_lenpref("l") + stable_identity_lenpref(&binder.binder_seq.to_string())
  end
end

# The structural identity text of a local: the owner structural instance's
# identity words + the binder identity. The display name is NOT part of it.
pub def stable_local_identity_text(local: StableLocalId) -> String
  stable_identity_lenpref(&local.owner.digest_hi.to_string()) +
  stable_identity_lenpref(&local.owner.digest_lo.to_string()) +
  stable_binder_identity_text(&local.binder)
end

# The binder record of (owner declaration, ordinal in the owner) — the
# text-boundary fallback: the lineage binds the deterministic synthetic
# number of the ordinal locator (the store path is rename/insertion-stable).
pub def stable_binder_id_of(owner_function: StableDeclId, binder_seq: Int) -> StableBinderId
  let anchor = "l" + binder_seq.to_string()
  let lineage = stable_binder_synthetic_lineage(owner_function.clone(), anchor)
  let bl = stable_binder_lineage_id_of(owner_function.clone(), lineage)
  stable_binder_id_with_lineage(owner_function, bl, binder_seq)
end

# The store-backed binder record: the persistent lineage + the snapshot
# locator ordinal. The digest words are the lineage's identity words.
pub def stable_binder_id_with_lineage(owner_function: StableDeclId, lineage: BinderLineageId, binder_seq: Int) -> StableBinderId
  let text = stable_binder_lineage_identity_text_of_words(owner_function.digest_hi, owner_function.digest_lo, lineage.lineage)
  let w = stable_words_of(&text)
  StableBinderId {
    owner_function: owner_function,
    binder_lineage: Option::Some(lineage),
    binder_seq: binder_seq,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The whole-build LOCAL stamp (the P0-4 local seam): stamp the binder
# lineage through the store (per-function numbering, conservative rebind)
# and build the local record; the ordinal is the snapshot locator only.
pub def stable_local_lineage_stamp(inout store: DeclLineageStore, owner_instance: StructuralInstanceId, owner: StableDeclId, owner_key: String, binder_kind: String, binder_seq: Int, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> StableLocalId
  let bl = stable_binder_lineage_stamp_or_rebind(store, owner_key, owner.clone(), binder_kind, name.clone(), sig_digest_hi, sig_digest_lo, sig_text, live_keys)
  let binder = stable_binder_id_with_lineage(owner, bl, binder_seq)
  stable_local_id_of(owner_instance, binder, name)
end

# The local record of (owner structural instance, binder, display name).
pub def stable_local_id_of(owner: StructuralInstanceId, binder: StableBinderId, display_name: String) -> StableLocalId
  StableLocalId { owner: owner, binder: binder, display_name: display_name }
end

# The structural identity text of a resolved field: the persistent member
# lineage's identity text when one is bound (owner + member kind +
# lineage — a rename/reorder leaves it byte-identical), else the no-table
# placeholder over the carried name (the documented name-derived
# fallback). The index is a snapshot locator, never part of identity.
pub def stable_field_identity_text(field: StableFieldId) -> String
  match field.member_lineage
  when Option::Some(ml) then
    stable_member_lineage_identity_text_of_words(ml.owner.digest_hi, ml.owner.digest_lo, ml.member_kind.clone(), ml.lineage)
  when Option::None then
    stable_identity_lenpref("") + stable_identity_lenpref("field") + stable_identity_lenpref(&field.name)
  end
end

# The structural identity text of a resolved variant (same rule as the
# field: the persistent member lineage, else the name-derived placeholder).
pub def stable_variant_identity_text(variant: StableVariantId) -> String
  match variant.member_lineage
  when Option::Some(ml) then
    stable_member_lineage_identity_text_of_words(ml.owner.digest_hi, ml.owner.digest_lo, ml.member_kind.clone(), ml.lineage)
  when Option::None then
    stable_identity_lenpref("") + stable_identity_lenpref("variant") + stable_identity_lenpref(&variant.name)
  end
end

# The field record of (owner type, member index, declared name). A text
# parse with no type table passes Option::None and index -1 — the name
# rides the record as the documented metadata carrier. With an owner, the
# lineage binds the deterministic synthetic number of (owner, "field",
# name); the store stamp (stable_field_lineage_stamp) is the
# rename-surviving authority.
pub def stable_field_id_of(owner_type: Option[StableDeclId], index: Int, name: String) -> StableFieldId
  match owner_type
  when Option::Some(d) then
    let member_kind = "field".to_string()
    let lineage = stable_member_synthetic_lineage(d.clone(), member_kind.clone(), name.clone())
    let ml = stable_member_lineage_id_of(d.package.clone(), d, member_kind, lineage)
    stable_field_id_with_lineage(Option::Some(ml.owner.clone()), ml, index, name)
  when Option::None then
    let text = stable_identity_lenpref("") + stable_identity_lenpref("field") + stable_identity_lenpref(&name)
    let w = stable_words_of(&text)
    StableFieldId {
      owner_type: Option::None,
      member_lineage: Option::None,
      index: index,
      name: name,
      digest_hi: w.0,
      digest_lo: w.1
    }
  end
end

# The field record of a persistent member lineage + the snapshot locator.
pub def stable_field_id_with_lineage(owner_type: Option[StableDeclId], lineage: MemberLineageId, index: Int, name: String) -> StableFieldId
  let dhi = lineage.digest_hi
  let dlo = lineage.digest_lo
  StableFieldId {
    owner_type: owner_type,
    member_lineage: Option::Some(lineage),
    index: index,
    name: name,
    digest_hi: dhi,
    digest_lo: dlo
  }
end

# The whole-build FIELD stamp (the P0-4 member seam for fields): stamp the
# member lineage through the store and build the field record. The index
# is the snapshot locator (the declared position in the owner's layout).
pub def stable_field_lineage_stamp(inout store: DeclLineageStore, owner: StableDeclId, owner_key: String, index: Int, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> StableFieldId
  let ml = stable_member_lineage_stamp_or_rebind(store, owner.package.key.clone(), owner_key, owner.clone(), "field".to_string(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text, live_keys)
  stable_field_id_with_lineage(Option::Some(owner), ml, index, name)
end

# The variant record of (owner type, member index, declared name) — the
# downcast counterpart of stable_field_id_of.
pub def stable_variant_id_of(owner_type: Option[StableDeclId], index: Int, name: String) -> StableVariantId
  match owner_type
  when Option::Some(d) then
    let member_kind = "variant".to_string()
    let lineage = stable_member_synthetic_lineage(d.clone(), member_kind.clone(), name.clone())
    let ml = stable_member_lineage_id_of(d.package.clone(), d, member_kind, lineage)
    stable_variant_id_with_lineage(Option::Some(ml.owner.clone()), ml, index, name)
  when Option::None then
    let text = stable_identity_lenpref("") + stable_identity_lenpref("variant") + stable_identity_lenpref(&name)
    let w = stable_words_of(&text)
    StableVariantId {
      owner_type: Option::None,
      member_lineage: Option::None,
      index: index,
      name: name,
      digest_hi: w.0,
      digest_lo: w.1
    }
  end
end

# The variant record of a persistent member lineage + the snapshot locator.
pub def stable_variant_id_with_lineage(owner_type: Option[StableDeclId], lineage: MemberLineageId, index: Int, name: String) -> StableVariantId
  let dhi = lineage.digest_hi
  let dlo = lineage.digest_lo
  StableVariantId {
    owner_type: owner_type,
    member_lineage: Option::Some(lineage),
    index: index,
    name: name,
    digest_hi: dhi,
    digest_lo: dlo
  }
end

# The whole-build VARIANT stamp (the P0-4 member seam for variants).
pub def stable_variant_lineage_stamp(inout store: DeclLineageStore, owner: StableDeclId, owner_key: String, index: Int, name: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> StableVariantId
  let ml = stable_member_lineage_stamp_or_rebind(store, owner.package.key.clone(), owner_key, owner.clone(), "variant".to_string(), name.clone(), sig_digest_hi, sig_digest_lo, sig_text, live_keys)
  stable_variant_id_with_lineage(Option::Some(owner), ml, index, name)
end

# The four stable projection constructors (there is NO constructor for a
# dynamic index or a deref — those are not stable projections).
pub def stable_projection_field(field: StableFieldId) -> StableProjection
  let text = stable_identity_lenpref("field") + stable_field_identity_text(&field)
  let w = stable_words_of(&text)
  StableProjection {
    kind: "field".to_string(),
    field: Option::Some(field),
    tuple_index: -1,
    variant: Option::None,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

pub def stable_projection_tuple(index: Int) -> StableProjection
  let text = stable_identity_lenpref("tuple") + stable_identity_lenpref(&index.to_string())
  let w = stable_words_of(&text)
  StableProjection {
    kind: "tuple".to_string(),
    field: Option::None,
    tuple_index: index,
    variant: Option::None,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

pub def stable_projection_downcast(variant: StableVariantId) -> StableProjection
  let text = stable_identity_lenpref("downcast") + stable_variant_identity_text(&variant)
  let w = stable_words_of(&text)
  StableProjection {
    kind: "downcast".to_string(),
    field: Option::None,
    tuple_index: -1,
    variant: Option::Some(variant),
    digest_hi: w.0,
    digest_lo: w.1
  }
end

pub def stable_projection_index(index: Int) -> StableProjection
  let text = stable_identity_lenpref("index") + stable_identity_lenpref(&index.to_string())
  let w = stable_words_of(&text)
  StableProjection {
    kind: "index".to_string(),
    field: Option::None,
    tuple_index: index,
    variant: Option::None,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The TYPED place constructor (the primary constructor — the text parser
# below is the boundary seam): the identity text is the root local's
# structured identity + each projection's (kind, digest words). malformed
# projections (a "field"/"downcast" without its resolved member, a
# tuple/index without an index) return Option::None — a dynamic index
# never constructs.
pub def stable_place_id_of(root_local: StableLocalId, projections: Vec[StableProjection]) -> Option[StablePlaceId]
  var text = stable_local_identity_text(&root_local)
  var kept: Vec[StableProjection] = Vec::new()
  var ok = true
  for proj in projections do
    if proj.kind == "field" then
      if !proj.field.is_some() then ok = false end
    elsif proj.kind == "tuple" then
      if proj.tuple_index < 0 then ok = false end
    elsif proj.kind == "downcast" then
      if !proj.variant.is_some() then ok = false end
    elsif proj.kind == "index" then
      if proj.tuple_index < 0 then ok = false end
    else
      ok = false
    end
    if !ok then
      return Option::None
    end
    text = text + stable_identity_lenpref(&proj.kind) +
      stable_identity_lenpref(&proj.digest_hi.to_string()) + stable_identity_lenpref(&proj.digest_lo.to_string())
    kept.push(proj)
  end
  let w = stable_words_of(&text)
  Option::Some(StablePlaceId { root: root_local, projections: kept, digest_hi: w.0, digest_lo: w.1 })
end

# The DIAGNOSTICS-ONLY text render of a place: the root's display name
# followed by the projection text shapes (".name" for a field/downcast,
# ".<n>" for a tuple, "[<n>]" for a constant index). The render is never
# the identity — identity is the structured digest — and it cannot tell a
# field from a variant (the historic text limitation).
pub def stable_place_text_of(place: StablePlaceId) -> String
  var text = place.root.display_name.clone()
  for proj in place.projections do
    if proj.kind == "field" then
      match proj.field
      when Option::Some(f) then text = text + "." + f.name.clone()
      when Option::None then text = text + "."
      end
    elsif proj.kind == "tuple" then
      text = text + "." + proj.tuple_index.to_string()
    elsif proj.kind == "downcast" then
      match proj.variant
      when Option::Some(v) then text = text + "." + v.name.clone()
      when Option::None then text = text + "."
      end
    elsif proj.kind == "index" then
      text = text + "[" + proj.tuple_index.to_string() + "]"
    else
      text = text + "?"
    end
  end
  text
end

# The PLACEHOLDER root local of a text-only parse: the owner is the empty
# callable instance (documented bootstrap placeholder), the binder ordinal
# is the "l<ordinal>" locator's ordinal for an unnamed slot, else the
# deterministic synthetic sequence of the name. A caller that holds the
# real owner/binder must build the root through stable_local_id_of and use
# stable_place_id_of — only that path is revision-stable across
# re-lowering; the text path is the boundary fallback.
def stable_place_text_root(root_text: String) -> StableLocalId
  var binder_seq = stable_synthetic_lineage(&root_text)
  if root_text.len() > 0 && root_text.slice(0, 1) == "l" then
    let rest = root_text.slice(1, root_text.len())
    if stable_is_digits(&rest) then
      binder_seq = stable_text_to_int(&rest)
    end
  end
  let owner = stable_callable_instance_id_of("".to_string())
  let binder = stable_binder_id_of(owner.callable.clone(), binder_seq)
  StableLocalId { owner: owner, binder: binder, display_name: root_text }
end

# Parse a canonical place text into (root text, projection segments): each
# segment is ("field", name) / ("tuple", digits) / ("index", digits).
# Option::None for any text outside the snapshot_place_key grammar — the
# empty marker, an empty or bare-digit root, an empty segment, an unclosed
# bracket, a stray "]", a "*" DEREF (not a stable member projection) and a
# DYNAMIC index (a bracket segment that is not an all-digit constant —
# dynamic indexes do not construct stable places, item 15).
def stable_place_segments(place_text: String) -> Option[(String, Vec[(String, String)])]
  if place_text.len() == 0 then return Option::None end
  let root_end = stable_place_run_end(&place_text, 0)
  if root_end == 0 then return Option::None end
  let root_text = place_text.slice(0, root_end)
  if stable_is_digits(&root_text) then return Option::None end
  var segs: Vec[(String, String)] = Vec::new()
  var pos = root_end
  var ok = true
  while pos < place_text.len() && ok do
    let ch = place_text.slice(pos, pos + 1)
    if ch == "*" then
      ok = false
    elsif ch == "." then
      pos = pos + 1
      let seg_end = stable_place_run_end(&place_text, pos)
      if seg_end == pos then
        ok = false
      else
        let seg = place_text.slice(pos, seg_end)
        if stable_is_digits(&seg) then
          segs.push(("tuple".to_string(), seg))
        else
          segs.push(("field".to_string(), seg))
        end
        pos = seg_end
      end
    elsif ch == "[" then
      pos = pos + 1
      let seg_end = stable_place_run_end(&place_text, pos)
      if seg_end == pos then
        ok = false
      else
        let seg = place_text.slice(pos, seg_end)
        if seg_end >= place_text.len() || place_text.slice(seg_end, seg_end + 1) != "]" then
          ok = false
        elsif !stable_is_digits(&seg) then
          ok = false
        else
          segs.push(("index".to_string(), seg))
          pos = seg_end + 1
        end
      end
    else
      ok = false
    end
  end
  if !ok || pos != place_text.len() then return Option::None end
  Option::Some((root_text, segs))
end

# The place record of a canonical place text with NO type table: field
# segments carry the NAME as metadata (owner_type Option::None, index -1 —
# the documented no-table carrier) and the identity is the text-path
# placeholder root + the name-carrying projection digests. Use the
# lookup variant when a type table can resolve the names.
pub def stable_place_of_text(place_text: String) -> Option[StablePlaceId]
  match stable_place_segments(&place_text)
  when Option::Some(parsed) then
    let (root_text, seg_list) = parsed
    var projs: Vec[StableProjection] = Vec::new()
    for seg in seg_list do
      if seg.0 == "field" then
        projs.push(stable_projection_field(stable_field_id_of(Option::None, -1, seg.1.clone())))
      elsif seg.0 == "tuple" then
        projs.push(stable_projection_tuple(stable_text_to_int(&seg.1)))
      else
        projs.push(stable_projection_index(stable_text_to_int(&seg.1)))
      end
    end
    stable_place_id_of(stable_place_text_root(root_text), projs)
  when Option::None then Option::None
  end
end

# The member lookup result of the type-table-aware text parser: a resolved
# FIELD or VARIANT (the text cannot tell a "." name apart; the table can).
enum StableProjectionMember
  Field(StableFieldId)
  Variant(StableVariantId)
end

# The type-table-aware text parser: every "." name segment is resolved
# through `member_lookup`; a Some result builds the resolved projection
# (field or downcast), a None result falls back to the name-carrying
# field record (owner_type Option::None) exactly like the no-table parser.
# The lookup closes over the owner type table, so the resolved ids carry
# the real owner declarations. Dynamic indexes and derefs are rejected
# identically.
pub def stable_place_of_text_lookup(place_text: String, member_lookup: Fn(String) -> Option[StableProjectionMember]) -> Option[StablePlaceId]
  match stable_place_segments(&place_text)
  when Option::Some(parsed) then
    let (root_text, seg_list) = parsed
    var projs: Vec[StableProjection] = Vec::new()
    for seg in seg_list do
      if seg.0 == "field" then
        let name_text = seg.1.clone()
        match member_lookup(name_text.clone())
        when Option::Some(member) then
          match member
          when StableProjectionMember::Field(f) then projs.push(stable_projection_field(f))
          when StableProjectionMember::Variant(v) then projs.push(stable_projection_downcast(v))
          end
        when Option::None then
          projs.push(stable_projection_field(stable_field_id_of(Option::None, -1, name_text)))
        end
      elsif seg.0 == "tuple" then
        projs.push(stable_projection_tuple(stable_text_to_int(&seg.1)))
      else
        projs.push(stable_projection_index(stable_text_to_int(&seg.1)))
      end
    end
    stable_place_id_of(stable_place_text_root(root_text), projs)
  when Option::None then Option::None
  end
end

# ———— The generated-executable constructors (the origin row-key texts) ————

# The drop-glue row of one concrete type: key = "drop-glue::<type key>"
# where type_key is the concrete type identity key text the glue body
# registered under (mir_type_identity_key's grammar — the MirOrigin::
# DropGlue payload; the emission-name fallback text of the classifier is
# also accepted — the id mirrors the row key either way).
pub def stable_drop_glue_id_of_type_key(type_key: String) -> StableDropGlueId
  let key = "drop-glue::" + type_key
  let w = stable_words_of(&key)
  StableDropGlueId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The closure row of one lowered closure body: key = "closure::<emission
# key>" (the MirOrigin::Closure emission name, e.g. "_closure<counter>").
pub def stable_closure_id_of(emission_key: String) -> StableClosureId
  let key = "closure::" + emission_key
  let w = stable_words_of(&key)
  StableClosureId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The derived row of one synthesized body: key = "derived::<kind>::<key>"
# (MirOrigin::Derived — kind word "effect-dispatcher", key = the emission
# name).
pub def stable_derived_body_id_of(kind_text: String, key_text: String) -> StableDerivedBodyId
  let key = "derived::" + kind_text + "::" + key_text
  let w = stable_words_of(&key)
  StableDerivedBodyId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The shim row of one bodyless extern declaration: key = "shim::<surface
# key>" (MirOrigin::Shim — the extern surface name).
pub def stable_shim_id_of(surface_key: String) -> StableShimId
  let key = "shim::" + surface_key
  let w = stable_words_of(&key)
  StableShimId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The binder / instance / local clones (registered so composite records
