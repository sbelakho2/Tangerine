# ———————————————————————————————————————————————————————————————
# 8. §33 statement locators vs revision-stable semantic node identity
#    (audit item 47)
# ———————————————————————————————————————————————————————————————
# The §33 statement/terminator key texts "<fn key>#B<block id>#S<stmt
# index>" / "<fn key>#B<block id>#T" (the section-1 grammar above) are
# DENSE WITHIN-SNAPSHOT LOCATORS: the statement's ordinal IS the key, so
# one simple unrelated insertion mid-block renumbers every later "#S"
# index of the block — the whole remaining tail of the block's node
# domain. The REVISION-STABLE identity of the same node is CONTENT-derived
# instead. Item 47 separates the faces as two records:
#
#   SnapshotMirLocator    — the dense locator as a record:
#                           function_key + block_ordinal (the MirBlockId.id
#                           the §33 grammar embeds) + stmt_ordinal (the
#                           statement index; -1 = the block TERMINATOR, the
#                           "#T" form — the same dense -1 spelling
#                           stable_mir_stmt_of_key parses). Round-trips
#                           with the §33 node key texts through
#                           snapshot_mir_locator_text /
#                           snapshot_mir_locator_of_key. A locator is only
#                           meaningful against ONE compilation's block/
#                           statement layout (the statement's index is its
#                           position, never its content): rows whose site
#                           fields carry these texts (the snapshot's
#                           indirect-call "<caller>#B<block>#T" sites, the
#                           slice layers' statement lists) reference the
#                           snapshot's own lowering; the locator is never a
#                           revision comparison key.
#   StableSemanticNodeId  — the revision-surviving identity of the node
#                           BEHIND a locator (third-audit items 16 + 4):
#                           owning function key + operation kind word +
#                           destination key text + operand key texts in
#                           RENDER ORDER (op semantics are order-sensitive
#                           — a binop's two operands are NEVER sorted) +
#                           the ROLE scheme below + the 128-bit digest
#                           words of the canonical role-key text
#                           (stable_mir_node_key_text). Two nodes with the
#                           same identity pieces are THE SAME semantic
#                           node; the pieces are the collision-detection
#                           cargo / diagnostics surface and Eq/Hash fold
#                           the digest words only, like every section-6/7
#                           record.
#
# ROLE SEMANTICS (replacing the item-47 predecessor-context chain): a
# node's identity is (function, HIR node seq where available else
# operation + role_seq, lowering_role) — NEVER the predecessor chain. For
# a source statement with a recorded HIR origin the identity is the
# (owner, hir node) anchor itself; for a node the lowering synthesized (or
# a MIR-only walk with no HIR origin) the identity is the stable ROLE plus
# role_seq = the ordinal of this node among the SAME-role nodes of the
# function in block order. The consequence the audit asks for: inserting a
# statement of a DIFFERENT role shifts nobody's role_seq, so the suffix is
# NOT re-keyed; inserting the same role before a node shifts only the
# later same-role nodes. Compiler-generated statements use STABLE ROLES —
# the stable_mir_role_* constructors ("drop:<place>",
# "bounds-check:<index>:<container>", "contract-check:<contract id>",
# "alloc-for:<hir node>", "arg-writeback:<call>:<param>") instead of
# chaining over whatever came before them.
#
# FALLBACK CARGO: op/dest/operand pieces are kept for nodes with no HIR
# origin (every MIR statement today carries no stamped HIR node id) and
# ride the identity text of that path so a content edit re-keys the edited
# node without re-keying its differently-roled neighbours. The derivation
# cost is the same shape as the old chain walk: the role_seq of a node is
# the count of same-role nodes before it in the function.
#
# DENSE COMPONENTS that remain inside identity texts BY DOCUMENTED POLICY
# (the §27/§33 boundaries the node key grammar already documents): an
# UNNAMED local renders its "l<id>" ordinal (the lowered program's own
# slot locator — the §27 dense local text of snapshot_local_name's
# grammar), control-flow targets render their MirBlockId.id numerics, and
# a type payload (a cast target, an aggregate element type, an instance
# substitution) renders its §33 type-table identity — the same dense
# ordinals the §33 key texts embed; they never renumber the node domain as
# a whole and are stable wherever the lowering itself is stable.
#
# CONTENT-KEY TEXT GRAMMAR (stable_mir_node_key_text): length-prefixed
# segments "<len>:<bytes>" concatenated — function_key, lowering_role,
# then the HIR anchor ("hir" + node seq) when available, else the role
# path ("role" + role + role_seq + operation + dest_key + every operand
# text in order). The length-prefixed concatenation is uniquely decodable,
# so two distinct piece vectors NEVER render to the same text: the digest
# words inherit the injectivity up to an actual 128-bit collision
# (detectable against the stored pieces at insert, never
# counter-disambiguated). The text is never re-parsed (the record pieces
# are the parse).
#
# WHERE THE DERIVATION LIVES: this module stays a leaf over ids.tg (the
# section-1 doctrine) — the records, the locator key grammar and the
# text-pieces constructor live here; rendering a MIR statement's pieces
# (operation/destination/operand texts from MirStatement/MirTerminator
# shapes over a MirProgram) lives in semantic_slice.tg (the layer with
# MirProgram access): its pub stable_node_id_of / stable_node_ids_of_slice
# build the StableSemanticNodeId records through stable_semantic_node_id_of
# below.

# The DENSE within-snapshot locator of one §33 node (grammar above):
# stmt_ordinal -1 = the block terminator ("#T"). Eq/Hash over the fields
# (a locator IS its position — the text is the identity, so field
# equality is full equality).
struct SnapshotMirLocator
  function_key: String
  block_ordinal: Int
  stmt_ordinal: Int
end

# The revision-stable HIR/AST anchor of a source node (third-audit item
# 16; fourth-audit P0-4): the owning declaration, the PERSISTENT
# HirNodeLineageId the store assigned once and the node's ordinal within
# the owner. The ordinal is a SNAPSHOT LOCATOR only (the parse/
# assign_node_ids order); identity is (owner, lineage), so inserting an
# expression before the node never re-keys it. The digest words fold the
# lineage identity; the text-only fallback binds the deterministic
# synthetic lineage of the locator anchor ("H<seq>" — documented
# bootstrap fallback; the store is the authority).
struct StableHirNodeId
  owner: StableDeclId
  hir_lineage: Option[HirNodeLineageId] = Option::None
  node_seq: Int = -1
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The revision-stable identity of one lowered MIR statement (third-audit
# item 16; fourth-audit P0-6): the owning function's STRUCTURAL instance,
# the node's stable ROLE, the role ordinal (the index among the function's
# same-role nodes) and the HIR node seq when the lowering stamped one
# (-1 otherwise). Compiler-generated statements use the stable_mir_role_*
# role strings; source statements derive from (owner, HIR node, lowering
# role).
struct StableMirStatementId
  function: StructuralInstanceId
  role: String
  role_seq: Int
  hir_node_seq: Int = -1
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The revision-stable identity of the semantic node behind a locator
# (section doc): the record pieces are the canonical role-key cargo;
# digest_hi/digest_lo are the 128-bit stable digest words of the canonical
# length-prefixed role-key text over ALL pieces.
struct StableSemanticNodeId
  function_key: String
  operation: String
  dest_key: String
  operands: Vec[String] = Vec::new()
  role: String
  lowering_role: String
  hir_node_seq: Int = -1
  role_seq: Int = 0
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— The locator key grammar (the §33 node key texts, mirrored) ————

# The §33 node key text of a locator: "<fn key>#B<block id>#S<stmt index>"
# for a statement (stmt_ordinal >= 0), "<fn key>#B<block id>#T" for the
# terminator (stmt_ordinal < 0).
pub def snapshot_mir_locator_text(loc: SnapshotMirLocator) -> String
  var text = loc.function_key.clone() + "#B" + loc.block_ordinal.to_string()
  if loc.stmt_ordinal < 0 then
    text + "#T"
  else
    text + "#S" + loc.stmt_ordinal.to_string()
  end
end

# The locator of a §33 node key text: Option::None for any text that is
# not exactly "<fn key>#B<block digits>" followed by "#T" (the terminator
# — stmt_ordinal -1) or "#S<digits>" (a statement). Mirrors the
# stable_mir_stmt_of_key parse (same markers, same digit rules).
pub def snapshot_mir_locator_of_key(key: String) -> Option[SnapshotMirLocator]
  let mark = stable_index_of(&key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  var stmt_ord = -1
  if key.slice(i, key.len()) == "#T" then
    stmt_ord = -1
  else
    if key.slice(i, i + 2) != "#S" then return Option::None end
    let idx_text = key.slice(i + 2, key.len())
    if !stable_is_digits(&idx_text) then return Option::None end
    stmt_ord = stable_text_to_int(&idx_text)
  end
  Option::Some(SnapshotMirLocator {
    function_key: key.slice(0, mark),
    block_ordinal: stable_text_to_int(&block_text),
    stmt_ordinal: stmt_ord
  })
end

# ———— The role-key text grammar and the record constructors ————

# The stable ROLE strings of the compiler-generated statement families
# (third-audit item 16). Each role embeds the stable identity of the thing
# the statement was generated FOR, so two identical generated statements
# are distinguished by role_seq (their ordinal among same-role statements)
# and an insertion of a different role never re-keys them.
pub def stable_mir_role_drop(place_key_render: String) -> String
  "drop:" + place_key_render
end

pub def stable_mir_role_bounds_check(index_key: String, container_key: String) -> String
  "bounds-check:" + index_key + ":" + container_key
end

pub def stable_mir_role_contract_check(contract_id: String) -> String
  "contract-check:" + contract_id
end

pub def stable_mir_role_alloc_for(hir_node_key: String) -> String
  "alloc-for:" + hir_node_key
end

pub def stable_mir_role_arg_writeback(call_id: String, param_index: Int) -> String
  "arg-writeback:" + call_id + ":" + param_index.to_string()
end

# The canonical ROLE-KEY TEXT of a compatible pair of pieces — the HIR
# anchor path ("hir": function + lowering_role + the HIR owner identity +
# node seq) when a HIR node seq is available, else the role path
# ("role": function + lowering_role + role + role_seq + operation +
# dest_key + every operand text in render order). The digest words of a
# node digest exactly this text.
def stable_mir_node_key_text_impl(
  function_key: String,
  operation: String,
  dest_key: String,
  operands: Vec[String],
  role: String,
  lowering_role: String,
  hir_node_seq: Int,
  role_seq: Int,
  hir_owner: String
) -> String
  var text = stable_identity_lenpref(&function_key) + stable_identity_lenpref(&lowering_role)
  if hir_node_seq >= 0 then
    text = text + stable_identity_lenpref("hir") + stable_identity_lenpref(&hir_owner) +
      stable_identity_lenpref(&hir_node_seq.to_string())
  else
    text = text + stable_identity_lenpref("role") + stable_identity_lenpref(&role) +
      stable_identity_lenpref(&role_seq.to_string())
    text = text + stable_identity_lenpref(&operation) + stable_identity_lenpref(&dest_key)
    for op in operands do
      text = text + stable_identity_lenpref(&op)
    end
  end
  text
end

# The HIR-anchor-agnostic key text (the MIR walk's form: no HIR owner
# text, the node seq alone anchors).
pub def stable_mir_node_key_text(
  function_key: String,
  operation: String,
  dest_key: String,
  operands: Vec[String],
  role: String,
  lowering_role: String,
  hir_node_seq: Int,
  role_seq: Int
) -> String
  stable_mir_node_key_text_impl(
    function_key.clone(),
    operation.clone(),
    dest_key.clone(),
    operands.clone(),
    role.clone(),
    lowering_role.clone(),
    hir_node_seq,
    role_seq,
    "".to_string()
  )
end

# The structural identity text of a HIR node: the owner declaration's
# identity words + the PERSISTENT HIR lineage when one is bound (the store
# path), else the locator-anchored bootstrap fallback.
pub def stable_hir_node_identity_text(hir: StableHirNodeId) -> String
  match hir.hir_lineage
  when Option::Some(hl) then
    stable_hir_lineage_identity_text_of_words(hir.owner.digest_hi, hir.owner.digest_lo, hl.lineage)
  when Option::None then
    stable_hir_lineage_identity_text_of_words(hir.owner.digest_hi, hir.owner.digest_lo, 0) +
      stable_identity_lenpref("H") + stable_identity_lenpref(&hir.node_seq.to_string())
  end
end

# The HIR node record of (owner declaration, node ordinal in the owner) —
# the text-boundary fallback: the lineage binds the deterministic
# synthetic number of the "H<seq>" locator anchor (the store path is
# insertion/rename-stable; this fallback is the documented bootstrap).
pub def stable_hir_node_id_of(owner: StableDeclId, node_seq: Int) -> StableHirNodeId
  let anchor = "H" + node_seq.to_string()
  let lineage = stable_hir_synthetic_lineage(owner.clone(), anchor)
  let hl = stable_hir_lineage_id_of(owner.clone(), lineage)
  stable_hir_node_id_with_lineage(owner, hl, node_seq)
end

# The store-backed HIR node record: the persistent lineage + the snapshot
# locator ordinal.
pub def stable_hir_node_id_with_lineage(owner: StableDeclId, lineage: HirNodeLineageId, node_seq: Int) -> StableHirNodeId
  let text = stable_hir_lineage_identity_text_of_words(owner.digest_hi, owner.digest_lo, lineage.lineage)
  let w = stable_words_of(&text)
  StableHirNodeId {
    owner: owner,
    hir_lineage: Option::Some(lineage),
    node_seq: node_seq,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The whole-build HIR-node stamp (the P0-4 HIR seam): stamp the node
# lineage through the store (the anchor is the structural key; the
# conservative rebind matches the anchor signature) and build the record.
pub def stable_hir_node_lineage_stamp(inout store: DeclLineageStore, owner: StableDeclId, owner_key: String, node_seq: Int, anchor: String, sig_digest_hi: UInt, sig_digest_lo: UInt, sig_text: String, live_keys: Vec[String]) -> StableHirNodeId
  let hl = stable_hir_lineage_stamp_or_rebind(store, owner_key, owner.clone(), anchor, sig_digest_hi, sig_digest_lo, sig_text, live_keys)
  stable_hir_node_id_with_lineage(owner, hl, node_seq)
end

# The key text of a StableHirNodeId (the caller-supplied owner text form is
# for the record-free renderers).
pub def stable_hir_node_key_text(owner_key_text: String, node_seq: Int) -> String
  stable_identity_lenpref(&owner_key_text) + stable_identity_lenpref(&node_seq.to_string())
end

# The MIR statement id of a stable role + role ordinal (the compiler-
# generated families).
pub def stable_mir_statement_id_of_role(function_key: String, role: String, role_seq: Int) -> StableMirStatementId
  let w = stable_words_of(
    stable_mir_statement_role_key_text(function_key.clone(), role.clone(), role_seq, -1)
  )
  StableMirStatementId {
    function: stable_callable_instance_id_of(function_key),
    role: role,
    role_seq: role_seq,
    hir_node_seq: -1,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The MIR statement id of a SOURCE statement with a HIR origin: the
# (owner, hir node) anchor plus the lowering role. The HIR anchor is the
# StableHirNodeId's STRUCTURAL identity text (its persistent lineage when
# bound — an insertion never re-keys the statement).
pub def stable_mir_statement_id_of_source(function_key: String, hir_node: StableHirNodeId, lowering_role: String) -> StableMirStatementId
  let text = stable_identity_lenpref(&function_key) + stable_identity_lenpref(&lowering_role) +
    stable_identity_lenpref("hir") + stable_hir_node_identity_text(&hir_node)
  let w = stable_words_of(&text)
  StableMirStatementId {
    function: stable_callable_instance_id_of(function_key),
    role: lowering_role.clone() + ":" + hir_node.node_seq.to_string(),
    role_seq: 0,
    hir_node_seq: hir_node.node_seq,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The role-path key text of a StableMirStatementId (the record-side
# grammar; the HIR path adds the owner text).
def stable_mir_statement_role_key_text(function_key: String, role: String, role_seq: Int, hir_node_seq: Int) -> String
  var text = stable_identity_lenpref(&function_key)
  if hir_node_seq >= 0 then
    text + stable_identity_lenpref("hir") + stable_identity_lenpref(&hir_node_seq.to_string())
  else
    text + stable_identity_lenpref("role") + stable_identity_lenpref(&role) + stable_identity_lenpref(&role_seq.to_string())
  end
end

# The role-key text of a StableSemanticNodeId — the diagnostics /
# collision-check preimage of the node's digest words.
pub def stable_semantic_node_key_text(node: StableSemanticNodeId) -> String
  stable_mir_node_key_text(
    node.function_key.clone(),
    node.operation.clone(),
    node.dest_key.clone(),
    node.operands.clone(),
    node.role.clone(),
    node.lowering_role.clone(),
    node.hir_node_seq,
    node.role_seq
  )
end

# The record of a role-key's pieces: digest words over the canonical
# length-prefixed text of the pieces (the section-6 doctrine — the pieces
# are the collision-detection cargo / diagnostics surface; the words are
# the identity). semantic_slice.tg's derivation (stable_node_id_of /
# stable_node_ids_of_slice — items 47 + 16) renders MIR statements into
# the pieces and calls this constructor.
pub def stable_semantic_node_id_of(
  function_key: String,
  operation: String,
  dest_key: String,
  operands: Vec[String],
  role: String,
  lowering_role: String,
  hir_node_seq: Int,
  role_seq: Int
) -> StableSemanticNodeId
  let text = stable_mir_node_key_text(
    function_key.clone(),
    operation.clone(),
    dest_key.clone(),
    operands.clone(),
    role.clone(),
    lowering_role.clone(),
    hir_node_seq,
    role_seq
  )
  let w = stable_words_of(&text)
  StableSemanticNodeId {
    function_key: function_key,
    operation: operation,
    dest_key: dest_key,
    operands: operands,
    role: role,
    lowering_role: lowering_role,
    hir_node_seq: hir_node_seq,
    role_seq: role_seq,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# ———————————————————————————————————————————————————————————————
# 8b. THE PERSISTENT MIR NODE IDENTITY (fourth-audit P0-7)
# ———————————————————————————————————————————————————————————————
# The revision-stable identity of one MIR STATEMENT or TERMINATOR the
# lowering and every optimizer pass CARRY ON THE NODE (MirStatement.origin /
# MirTerminator.origin), instead of re-deriving a locator ordinal at read
# time:
#
#   source nodes     derive from {StableHirNodeId, LoweringRole}: the
#                    owning function's STRUCTURAL instance, the persistent
#                    HIR node the node was lowered FROM (the P0-4 lineage
#                    record, or the deterministic synthetic lineage of the
#                    node seq when the store is not threaded into lowering),
#                    and the lowering role (which statement/terminator
#                    family the node belongs to). Inserting an unrelated
#                    node before it never re-keys it — the locator
#                    (block/statement ordinal) is NOT part of the identity;
#
#   generated nodes  derive from {origin-set, transform-id, role, seq}: the
#                    origin-set identifies the construct the node was
#                    generated for (a HIR node identity text, a semantic
#                    node key, or the owning function key), the transform-id
#                    names the producer ("lower" for lowering; the pass
#                    name for an optimizer pass), the role is the
#                    deterministic generated role and seq the occurrence
#                    ordinal among same-role nodes of the same origin set.
#
# The canonical KEY TEXT grammar is "<function key>#N@<hi>-<lo>" (the
# digest words are the identity; the text is the collision-detection /
# wire face). The §33 "#B<ordinal>#S<index>/#T" spellings remain LOCATORS
# ONLY (SnapshotMirLocator); a PGO/coverage row identity is NEVER an
# ordinal.

# The generated-node provenance record {origin-set, transform-id, role,
# seq}; digest words fold the canonical identity text of the triple.
pub struct MirGeneratedOrigin
  origin_set: String
  transform_id: String
  role: String
  seq: Int
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The canonical text of a generated-origin record (diagnostics / collision
# cargo; the digest words are the identity).
pub def mir_generated_origin_text(g: MirGeneratedOrigin) -> String
  g.origin_set.clone() + "#gen@" + g.transform_id.clone() + "#" + g.role.clone() + "#" + g.seq.to_string()
end

# The generated-origin record of its pieces.
pub def mir_generated_origin_of(origin_set: String, transform_id: String, role: String, seq: Int) -> MirGeneratedOrigin
  let text = stable_identity_lenpref(&origin_set) + stable_identity_lenpref(&transform_id) +
    stable_identity_lenpref(&role) + stable_identity_lenpref(&seq.to_string())
  let w = stable_words_of(&text)
  MirGeneratedOrigin {
    origin_set: origin_set,
    transform_id: transform_id,
    role: role,
    seq: seq,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The revision-stable identity of one lowered MIR node (statement or
# terminator). Exactly ONE of origin / generated is populated: a source
# node carries its StableHirNodeId anchor, a generated node its
# {origin-set, transform-id, role, seq} record.
pub struct StableMirNodeId
  function: StructuralInstanceId
  function_key: String
  origin: Option[StableHirNodeId] = Option::None
  lowering_role: String = ""
  generated: Option[MirGeneratedOrigin] = Option::None
  # (fourth-audit P0-7) TRUE for the compiler-GENERATED families (the
  # lowering's synthesized drops/bounds checks/budget consumes and every
  # optimizer-synthesized node); FALSE for a source node lowered from a
  # HIR node.
  generated_node: Bool = false
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# Whether a node identity is compiler-generated (its origin is the
# {origin-set, transform-id, role, seq} record).
pub def stable_mir_node_is_generated(node: StableMirNodeId) -> Bool
  node.generated_node
end

# The SOURCE node identity of (function key, HIR node anchor, lowering
# role). The HIR anchor's STRUCTURAL identity text (its persistent lineage
# when bound) is the digest preimage — the node seq rides the record only
# as locator metadata.
pub def stable_mir_node_id_of_source(function_key: String, hir_node: StableHirNodeId, lowering_role: String) -> StableMirNodeId
  let text = stable_identity_lenpref(&function_key) + stable_identity_lenpref(&lowering_role) +
    stable_identity_lenpref(&stable_hir_node_identity_text(&hir_node))
  let w = stable_words_of(&text)
  StableMirNodeId {
    function: stable_callable_instance_id_of(&function_key),
    function_key: function_key,
    origin: Option::Some(hir_node),
    lowering_role: lowering_role,
    generated: Option::None,
    generated_node: false,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The GENERATED node identity of (function key, origin-set, transform-id,
# role, seq) — the deterministic rule every synthesized node follows.
pub def stable_mir_node_id_of_generated(
  function_key: String,
  origin_set: String,
  transform_id: String,
  role: String,
  seq: Int
) -> StableMirNodeId
  let g = mir_generated_origin_of(origin_set.clone(), transform_id.clone(), role.clone(), seq)
  let text = stable_identity_lenpref(&function_key) + stable_identity_lenpref(&role) +
    stable_identity_lenpref(&origin_set) + stable_identity_lenpref(&transform_id) +
    stable_identity_lenpref(&seq.to_string())
  let w = stable_words_of(&text)
  StableMirNodeId {
    function: stable_callable_instance_id_of(&function_key),
    function_key: function_key,
    origin: Option::None,
    lowering_role: role,
    generated: Option::Some(g),
    generated_node: true,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The canonical KEY TEXT of a MIR node identity: "<fn key>#N@<hi>-<lo>".
pub def stable_mir_node_key_of(node: StableMirNodeId) -> String
  node.function_key.clone() + "#N@" + node.digest_hi.to_string() + "-" + node.digest_lo.to_string()
end

# Parse a canonical MIR node key text. Option::None for any text outside
# the grammar (a non-empty function-key prefix, the LAST "#N@" marker, and
# exactly two non-empty decimal digest words separated by '-').
pub def stable_mir_node_of_key(key: String) -> Option[StableMirNodeId]
  var mark = -1
  var i = 0
  while i + 3 <= key.len() do
    if key.slice(i, i + 3) == "#N@" then
      mark = i
    end
    i = i + 1
  end
  if mark <= 0 then return Option::None end
  let tail = key.slice(mark + 3, key.len())
  let dash = stable_index_of(&tail, "-", 0)
  if dash <= 0 || dash + 1 >= tail.len() then return Option::None end
  let hi_text = tail.slice(0, dash)
  let lo_text = tail.slice(dash + 1, tail.len())
  if !stable_is_digits(&hi_text) || !stable_is_digits(&lo_text) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableMirNodeId {
    function: stable_callable_instance_id_of(&key.slice(0, mark)),
    function_key: key.slice(0, mark),
    origin: Option::None,
    lowering_role: "",
    generated: Option::None,
    generated_node: false,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The digest-word equality of two node identities (the identity words are
# the record: origin/generated metadata is collision cargo).
pub def stable_mir_node_id_eq(a: StableMirNodeId, b: StableMirNodeId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

# ———— The stable BLOCK control-origin identity ————
#
# A block's StableMirBlockId derives from the block's CONTROL ORIGIN — the
# condition/terminator HIR node and role (source) or the generated triple —
# NEVER the block ordinal. Source blocks take the identity of their control
# node's source record; generated blocks take the generated record.

# The block record of a control-origin node identity: the node's function
# key + the "#B@<hi>-<lo>" grammar (the digest words are the CONTROL
# origin's identity words, so a block's key is stable across insertions).
pub def stable_mir_block_id_of_node(node: StableMirNodeId) -> StableMirBlockId
  let key = node.function_key.clone() + "#B@" + node.digest_hi.to_string() + "-" + node.digest_lo.to_string()
  let w = stable_words_of(&key)
  StableMirBlockId {
    dense_id: -1,
    stable_key: key,
    digest_hi: w.0,
    digest_lo: w.1,
    semantic: true
  }
end

pub def stable_mir_block_id_of_control_source(function_key: String, hir_node: StableHirNodeId, lowering_role: String) -> StableMirBlockId
  stable_mir_block_id_of_node(stable_mir_node_id_of_source(function_key, hir_node, lowering_role))
end

pub def stable_mir_block_id_of_control_generated(
  function_key: String,
  origin_set: String,
  transform_id: String,
  role: String,
  seq: Int
) -> StableMirBlockId
  stable_mir_block_id_of_node(stable_mir_node_id_of_generated(function_key, origin_set, transform_id, role, seq))
end

# Whether a block key is a SEMANTIC (control-origin) key — its "#B" payload
# is the "@<hi>-<lo>" digest form, never an all-digit locator.
pub def stable_mir_block_key_is_semantic(key: String) -> Bool
  let mark = stable_index_of(&key, "#B", 0)
  if mark <= 0 then return false end
  mark + 2 < key.len() && key.slice(mark + 2, mark + 3) == "@"
end

# ———— The semantic EDGE / CALL / ALLOCATION key grammars (P0-8) ————
#
# The PGO/coverage re-key: an edge id is the two SEMANTIC block keys plus
# the edge kind word; a call id is the callee's StructuralInstanceId digest
# plus the call-site node key; an allocation site id is the allocating
# node's semantic key.

# The canonical semantic edge id "<from block key>|><to block key>|<kind>".
pub def stable_mir_semantic_edge_id(from_block_key: String, to_block_key: String, kind: String) -> String
  from_block_key + "|>" + to_block_key + "|" + kind
end

# The known edge kind words (the coverage trace vocabulary).
pub def stable_mir_edge_kind_is_known(kind: String) -> Bool
  kind == "goto" || kind == "switch" || kind == "switch-default" ||
    kind == "call-success" || kind == "call-unwind" ||
    kind == "deinit-success" || kind == "deinit-unwind" ||
    kind == "assert-success" || kind == "assert-unwind" || kind == "cf"
end

# Parse a canonical semantic edge id. Both sides must be SEMANTIC block
# keys and the kind an edge kind word; Option::None otherwise.
pub def stable_mir_semantic_edge_of_key(key: String) -> Option[StableMirEdgeId]
  let arrow = stable_index_of(&key, "|>", 0)
  if arrow <= 0 then return Option::None end
  let from_key = key.slice(0, arrow)
  let rest = key.slice(arrow + 2, key.len())
  let bar = stable_last_index_of(&rest, "|")
  if bar <= 0 then return Option::None end
  let to_key = rest.slice(0, bar)
  let kind = rest.slice(bar + 1, rest.len())
  if !stable_mir_block_key_is_semantic(&from_key) then return Option::None end
  if !stable_mir_block_key_is_semantic(&to_key) then return Option::None end
  if !stable_mir_edge_kind_is_known(&kind) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableMirEdgeId {
    dense_id: -1,
    stable_key: key,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The canonical semantic call-site id: the call-site node key + the
# callee's STRUCTURAL instance identity words.
pub def stable_structural_call_id(callsite: StableMirNodeId, callee: StructuralInstanceId) -> String
  stable_mir_node_key_of(callsite) + "|callee@" + callee.digest_hi.to_string() + "-" + callee.digest_lo.to_string()
end

# Parse a canonical semantic call id; Option::None otherwise.
pub def stable_structural_call_of_key(key: String) -> Option[StableCallId]
  var mark = -1
  var i = 0
  while i + 8 <= key.len() do
    if key.slice(i, i + 8) == "|callee@" then
      mark = i
    end
    i = i + 1
  end
  if mark <= 0 then return Option::None end
  let node_part = key.slice(0, mark)
  match stable_mir_node_of_key(node_part)
  when Option::None then return Option::None
  when Option::Some(_) then ()
  end
  let tail = key.slice(mark + 8, key.len())
  let dash = stable_index_of(&tail, "-", 0)
  if dash <= 0 || dash + 1 >= tail.len() then return Option::None end
  if !stable_is_digits(&tail.slice(0, dash)) || !stable_is_digits(&tail.slice(dash + 1, tail.len())) then
    return Option::None
  end
  let w = stable_words_of(&key)
  Option::Some(StableCallId {
    dense_id: -1,
    stable_key: key,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The allocation-site id of a semantic node (the allocating node IS the
# site).
pub def stable_allocation_node_id(node: StableMirNodeId) -> String
  stable_mir_node_key_of(node)
end

# ———— The typed-hole identity (third-audit item 16 / audit item 54) ————
#
# The hole's identity is the (owner declaration, origin HIR node) pair.
# The canonical TEXT grammar "<owner key>#hole<node seq>" is retained as
# the RENDER / wire form (the semantic_edit protocol carries it; the
# semantic_query hole.constraints op parses it), but it is no longer the
# identity — the record is. A record render therefore needs the owner key
# text supplied by the caller (stable_hole_text_of); a parsed text yields
# the record through stable_hole_id_of_key.

struct StableHoleId
  owner: StableDeclId
  origin: StableHirNodeId
end

# The canonical hole-key TEXT (the retained render/wire grammar).
pub def stable_hole_key_text(owner_key: String, hir_node_seq: Int) -> String
  owner_key + "#hole" + hir_node_seq.to_string()
end

# Parse a canonical hole key into (function key prefix, node id). The LAST
# "#hole" separates (the owner key itself carries '#'); the digits must be
# a non-empty decimal run. Option::None for any text outside the grammar.
pub def stable_hole_key_parts(key: String) -> Option[(String, Int)]
  var found = -1
  var i = 0
  while i + 5 <= key.len() do
    if key.slice(i, i + 5) == "#hole" then
      found = i
    end
    i = i + 1
  end
  if found < 0 then
    return Option::None
  end
  let digits = key.slice(found + 5, key.len())
  if !stable_is_digits(&digits) then
    return Option::None
  end
  Option::Some((key.slice(0, found), stable_text_to_int(&digits)))
end

# The hole record of (owner declaration, HIR node seq) — the origin node's
# owner IS the hole's owner (a hole belongs to one declaration).
pub def stable_hole_id_of(owner: StableDeclId, hir_node_seq: Int) -> StableHoleId
  let origin = stable_hir_node_id_of(owner.clone(), hir_node_seq)
  StableHoleId { owner: owner, origin: origin }
end

# The hole record of a canonical hole key text: the owner parses as a
# declaration (stable_decl_of_key — the total text-boundary builder) and
# the origin node seq is the "#hole" payload.
pub def stable_hole_id_of_key(key: String) -> Option[StableHoleId]
  match stable_hole_key_parts(&key)
  when Option::Some(parts) then
    let owner = stable_decl_of_key(&parts.0)
    Option::Some(stable_hole_id_of(owner, parts.1))
  when Option::None then Option::None
  end
end

# The wire render of a hole RECORD: the caller supplies the owner key text
# (the record's identity is structured and cannot reconstruct the name —
# documented render boundary).
pub def stable_hole_text_of(hole: StableHoleId, owner_key_text: String) -> String
  stable_hole_key_text(owner_key_text, hole.origin.node_seq)
end

impl Clone for StableHirNodeId
  def clone(self: Self) -> StableHirNodeId
    StableHirNodeId {
      owner: self.owner.clone(),
      hir_lineage: self.hir_lineage.clone(),
      node_seq: self.node_seq,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for StableMirStatementId
  def clone(self: Self) -> StableMirStatementId
    StableMirStatementId {
      function: self.function.clone(),
      role: self.role.clone(),
      role_seq: self.role_seq,
      hir_node_seq: self.hir_node_seq,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for MirGeneratedOrigin
  def clone(self: Self) -> MirGeneratedOrigin
    MirGeneratedOrigin {
      origin_set: self.origin_set.clone(),
      transform_id: self.transform_id.clone(),
      role: self.role.clone(),
      seq: self.seq,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for StableMirNodeId
  def clone(self: Self) -> StableMirNodeId
    StableMirNodeId {
      function: self.function.clone(),
      function_key: self.function_key.clone(),
      origin: self.origin.clone(),
      lowering_role: self.lowering_role.clone(),
      generated: self.generated.clone(),
      generated_node: self.generated_node,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Eq for MirGeneratedOrigin
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for MirGeneratedOrigin
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for StableMirNodeId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableMirNodeId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# ———— The Eq/Hash implementations (the digest-words fold) ————

impl Eq for SnapshotMirLocator
  # A locator IS its dense position: field equality (the canonical text is
  # a pure function of the fields, so equal fields are equal texts).
  def eq(self: Self, other: Self) -> Bool
    self.function_key == other.function_key &&
    self.block_ordinal == other.block_ordinal &&
    self.stmt_ordinal == other.stmt_ordinal
  end
end

impl Hash for SnapshotMirLocator
  # The canonical locator text's digest words through the unsigned fold
  # (equal locators have equal texts and therefore equal hashes).
  def hash(self: Self) -> Int
    let text = snapshot_mir_locator_text(self)
    let w = stable_words_of(&text)
    var h = 0
    h = ((h as UInt) * 31 + w.0) as Int
    h = ((h as UInt) * 31 + w.1) as Int
    h
  end
end

impl Eq for StableSemanticNodeId
  # Equality over the content-key digest words (equal pieces produce equal
  # canonical texts and therefore equal words; an actual 128-bit collision
  # is detectable against the stored pieces, never counter-disambiguated).
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableSemanticNodeId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# 9. STRUCTURED GENERIC-INSTANCE KEYS (audit item 49)
# ———————————————————————————————————————————————————————————————
# The structured face of the monomorphized-INSTANCE identity domain — the
# replacement model for the RENDERED-TEXT-CONCATENATION instance keys
# (mangle_name's "base$<arg renders>" text suffix — the emission labels /
# the former MonoCache.instances Map[String, ...] text keys /
# StableInstanceId's §1 text grammar). The audit's split: identity is a
# STRUCTURED record —
#
#   StructuralInstanceId { callable: StableDeclId,
#                          args: Vec[CanonicalGenericArg] }
#   CanonicalGenericArg  { Type(CanonicalTypeKey); Const(CanonicalConstValue) }
#
# — whose Eq and Hash FOLD THE DIGEST WORDS of the components (never a
# text concatenation with "$"). Each component carries its canonical key
# TEXT only as the collision-detection cargo / diagnostics surface (the
# section-6 doctrine): a real 128-bit collision is detectable against the
# stored texts at insert, never counter-disambiguated.
#
# CROSS-KIND ORDER (fourth-audit P0-5): the args are ONE vector in
# DECLARED position order — the former type_args/const_args SPLIT
# destroyed the interleaving, so [Type A, Const 3] and [Const 3, Type A]
# collapsed onto the same identity. The tag is part of the identity text
# and of Eq/Hash, and the vector is never sorted or regrouped.
#
# STRUCTURAL IDENTITY (fourth-audit P0-6): the callable component is a
# StableDeclId — the persistent declaration identity, not the
# index-bearing fn-owner emission text. The compilation-local
# fn_owner_key_of_def render (with its per-module definition index) is
# LOOKUP/DISPLAY only: the mono boundary resolves the callable's stable
# declaration through the store binding or, absent one, the REGISTRATION
# scope (stable_structural_callable_decl_of — module path + kind + name;
# the per-module index never enters the identity), and derives the
# mangled symbol from the record (structural_instance_mangle_text). A
# mangled name is never fed back into the identity.
#
# THE KEY GRAMMAR THE CONSTRUCTORS PARSE (the grammar mono "actually
# uses" today): the emission-key suffix of mangle_name — the canonical
# CanonInternal-frame type renders (type_canon_render, types.tg:
# type_to_mangled) joined by "$". No render contains "$", so the suffix
# segments are unambiguous; the const-argument forms are exactly three
# disjoint render families, and NO type render starts with any of them
# (the type families are the primitives "int".."f64"/"unit"/"str"/...,
# the bracket-delimited forms "t<id>[...]", "fa[...]", "tuple(...)",
# "fnptr(...)", "ptr(...)", "eff(...)" ... and the dense words
# "param<n>", "dyn<id>", "var<id>", "err"):
#   "c<v>"              — a CONST VALUE argument (Type::Const(v)); the
#                         canonical text is "c" + v — sign included
#                         ("c-4") — byte-identical to the render of
#                         Type::Const(v) in the CanonInternal frame;
#   "constparam<n>"     — a FORWARDED const-parameter argument
#                         (Type::ConstParam — an enclosing declaration's
#                         parameter; n = its numeric GenericParamId);
#   "constsym(<tree>)"  — a SYMBOLIC const-EXPRESSION argument
#                         (Type::ConstSym — the ConstExprT tree rendered
#                         by const_sym_tree_render_numeric; the digest
#                         covers the whole segment byte-for-byte).
# Every other segment is a TYPE argument render. The classification is
# total and deterministic, so instance_key_of_renders (the mono-boundary
# constructor over the full declared-order positional render list) and
# instance_key_of (the constructor over an already-built arg vector)
# agree for every instance: a declaration fixes which of its declared
# positions are const parameters, and the grammar families are disjoint.
#
# CanonicalConstValue.kind is the VALUE-DOMAIN word of the row:
# "signed"/"unsigned" for a concrete VALUE (classified by the DECLARED
# scalar type of the const-parameter slot, when the caller holds it) and
# "constparam"/"constsym" for the two SYMBOLIC markers. A pure segment
# parse cannot recover the declared signedness (the canonical key grammar
# has ONE value form — the compiler's const domain is the host Int, and
# the declared scalar type is a property of the slot, never of the
# argument), so the parse tags value rows with the "signed" default and a
# caller that holds env.const_param_decl_types rebuilds the row with
# canonical_const_value_of("unsigned", v) — the digest words are the
# SAME either way (both value kinds digest the identical canonical text
# "c<v>"). kind is therefore ROW METADATA mirroring StableDeclId.kind:
# it is never consulted by Eq/Hash. The "constsym" marker's canonical
# text covers the tree bytes, so two different symbolic trees NEVER
# collide in the digest words even though value stays 0 — this is what
# keeps "2*N vs N*2" different as documented below.
#
# CONST-EXPRESSION NORMALIZATION MODEL (the audit's syntax-vs-semantics
# boundary): the canonical text of a symbolic tree is the tree as the
# LANGUAGE normalizes it. The ONLY declared equivalences are the IDENTITY
# FOLDS applied at the ConstSym fold helpers in types.tg
# (const_sym_tree_fold_identities, wired through const_sym_fold_type):
#   N + 0 -> N    0 + N -> N    N * 1 -> N
# Commutativity is NOT normalized: N + M and M + N stay DIFFERENT
# symbolic trees, and 2*N stays different from N*2 (the audit explicitly
# rejects syntax==semantic conflation without a defined model — the model
# here is exactly the identity rules above, nothing more). Two call-site
# spellings that fold to the same tree (N+0 vs N) therefore yield the
# same StructuralInstanceId; spellings the model does not equate stay
# different.
#
# The callable component: structurally the callable's StableDeclId. The
# TEXT boundary stable_callable_decl_of still parses the fn-owner-key
# grammar "<module path>::<index>::<kind word>" (module path = before the
# LAST "::", kind = the word after it) into a StableDeclId whose synthetic
# lineage covers the whole text — that is the documented index-fragile
# fallback. The mono boundary (fourth-audit P0-6) instead resolves the
# callable through stable_structural_callable_decl_of — the REGISTRATION
# scope (module path + kind + name; the per-module index never enters) or
# a store-backed StableDeclId binding — so fn_owner_key_of_def stays
# compilation-local lookup/display. A callable text that is not
# fn-owner-shaped (a method template's "Type__method" emission name, a
# hand-built test name) falls back to the full-lineage form with empty
# pieces — identity is the digest of the whole text either way (mirror of
# stable_symbol_of_key's unparsed fallback).
#
# THREADING (the migration LANDED — audit item 49; P0-5/P0-6 re-key): the
# mono boundary computes the structural instance ONCE per instantiation
# site (mono.tg's structured_instance_key) and the record IS the mono
# identity — MonoCache.instances is Map[StructuralInstanceId, MirFunction]
# and the worklist seen-set is Set[StructuralInstanceId], written and read
# at the work-queue drain pop, the monomorphize_instance /
# mono_specialize_function entry points and the rewrite lookups. The
# emission text is DERIVED from the record at the mangling boundary only
# (structural_instance_mangle_text — the specialized body's `name` label /
# the diagnostics render); no text-keyed mono cache remains. The
# types/mir compilation caches are the residual text-keyed maps
# (section 5).
#
# instance_key_to_text is the DIAGNOSTICS render of a structured key: the
# callable text, then every arg text in DECLARED order, "$"-joined. Value,
# constparam and constsym rows re-render their canonical segment text
# byte-for-byte (the `text` cargo retains the exact render);
# structural_instance_mangle_text is the same render with mangle_name's
# trailing-"$" shape for the emission boundary.

# ———— The records ————

# ONE type-argument identity of an instance: text = the canonical
# CanonInternal render of the argument type; digest words over that text.
struct CanonicalTypeKey
  text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE const-argument identity of an instance (section doc; fourth-audit
# P0-5): kind = "signed"/"unsigned" (a concrete VALUE) or the symbolic
# markers "constparam"/"constsym"; value = the host-Int value, the numeric
# GenericParamId of a forwarded parameter, or 0 for a tree. The digest
# words digest the canonical const SEGMENT text ("c<v>",
# "constparam<n>", or the whole "constsym(<tree>)" segment as parsed) and
# `text` keeps that exact segment render as CARGO — never digested, never
# compared — so the emission render of a symbolic tree argument stays
# byte-identical after the structural re-key.
struct CanonicalConstValue
  kind: String
  value: Int
  text: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE generic argument of an instance in DECLARATION position order
# (fourth-audit P0-5): the cross-kind order is PRESERVED because the args
# live in ONE vector — a type argument and a const argument are distinct
# variants, so [Type A, Const 3] and [Const 3, Type A] never compare (or
# hash) equal, even when a non-canonical producer builds the second.
enum CanonicalGenericArg
  Type(CanonicalTypeKey)
  Const(CanonicalConstValue)
end

# The STRUCTURAL identity of one monomorphized instance (fourth-audit
# P0-5/P0-6) — the renamed/extended StableCallableInstanceId: callable =
# the stable declaration the instance derives from, args = EVERY generic
# argument in DECLARED position order (types and consts interleaved by
# position, never regrouped). Eq/Hash fold the digest words — never a
# "$"-joined text; the mangled symbol name is DERIVED from this record at
# the emission boundary (structural_instance_mangle_text), never fed into
# it.
struct StructuralInstanceId
  callable: StableDeclId
  args: Vec[CanonicalGenericArg] = Vec::new()
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— Segment classification helpers ————

# Whether a word is one of the fn-owner-key kind words (fn_owner_key's
# DefKind rendering — fn_owner_key in types.tg).
def stable_is_kind_word(word: String) -> Bool
  word == "fn" || word == "method" || word == "static" || word == "const" ||
  word == "variant" || word == "field" || word == "intrinsic" ||
  word == "type" || word == "trait" || word == "other"
end

# The StableDeclId of a callable key text (section doc): the fn-owner
# grammar "<module path>::<index>::<kind word>" parses module_path =
# before the last "::" and kind = the word after it; every other text
# falls back to the full-lineage form (empty module/kind pieces). The
# persistent number is not carried by the text, so both forms bind the
# deterministic synthetic lineage of the FULL callable key text — a
# callable text with a store should build through
# stable_decl_id_of_lineage_store instead. This TEXT boundary is the
# documented fallback; the index-free registration constructor below is
# what the mono boundary prefers (fourth-audit P0-6).
pub def stable_callable_decl_of(callable_key_text: String) -> StableDeclId
  var last = -1
  var i = 0
  while i + 2 <= callable_key_text.len() do
    if callable_key_text.slice(i, i + 2) == "::" then
      last = i
    end
    i = i + 1
  end
  if last >= 0 then
    let kind_word = callable_key_text.slice(last + 2, callable_key_text.len())
    if stable_is_kind_word(&kind_word) then
      return stable_decl_id_of_lineage_texts_named(
        "".to_string(),
        callable_key_text.slice(0, last),
        stable_synthetic_lineage(&callable_key_text),
        kind_word,
        callable_key_text.clone()
      )
    end
  end
  stable_decl_id_of_lineage_texts_named(
    "".to_string(),
    "".to_string(),
    stable_synthetic_lineage(&callable_key_text),
    "".to_string(),
    callable_key_text.clone()
  )
end

# The COMPILATION-LOCAL structural callable declaration of a def
# (fourth-audit P0-6): the identity preimage is the REGISTRATION scope
# (package, module path, kind, name) — the per-module definition INDEX
# never enters, so inserting an unrelated declaration before the callable
# leaves every structural instance id byte-identical across builds. The
# persistent DeclLineageStore supersedes this deterministic fallback
# exactly like stable_callable_decl_of's text form; `display` is the
# emission base render (diagnostics cargo, never digested).
pub def stable_structural_callable_decl_of(package_key: String, module_path: String, kind: String, name: String, display: String) -> StableDeclId
  let scope = stable_lineage_scope_key(package_key.clone(), module_path.clone(), kind.clone(), name.clone())
  let lineage = stable_synthetic_lineage(&scope)
  stable_decl_id_of_lineage_texts_named(package_key, module_path, lineage, kind, display)
end

# The canonical const text of a row (the exact segment render: the row's
# persisted `text` cargo when one was built/parsed, else the value-derived
# canonical form).
pub def stable_const_text_of(c: CanonicalConstValue) -> String
  if c.text.len() > 0 then
    return c.text.clone()
  end
  if c.kind == "signed" || c.kind == "unsigned" then
    "c" + c.value.to_string()
  elsif c.kind == "constparam" then
    "constparam" + c.value.to_string()
  else
    "constsym(" + c.digest_hi.to_string() + "," + c.digest_lo.to_string() + ")"
  end
end

# Parse a const VALUE segment "c<v>" (v = optional "-" then digits) —
# the CanonInternal render of Type::Const(v). kind = "signed" (the
# parse default — the grammar has one value form; see the section doc).
def stable_const_value_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() < 2 || segment.slice(0, 1) != "c" then
    return Option::None
  end
  var rest = segment.slice(1, segment.len())
  var neg = false
  if rest.len() > 0 && rest.slice(0, 1) == "-" then
    neg = true
    rest = rest.slice(1, rest.len())
  end
  if !stable_is_digits(&rest) then return Option::None end
  var v = stable_text_to_int(&rest)
  if neg then
    v = 0 - v
  end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue {
    kind: "signed".to_string(),
    value: v,
    text: segment,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# Parse a FORWARDED const-parameter segment "constparam<n>" (n = the
# numeric GenericParamId of the enclosing parameter).
def stable_const_param_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() <= 10 || segment.slice(0, 10) != "constparam" then
    return Option::None
  end
  let id_text = segment.slice(10, segment.len())
  if !stable_is_digits(&id_text) then return Option::None end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue {
    kind: "constparam".to_string(),
    value: stable_text_to_int(&id_text),
    text: segment,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# Parse a SYMBOLIC const-EXPRESSION segment "constsym(<tree render>)":
# the whole segment is the canonical text (the tree bytes digest);
# value stays 0. Option::Some for exactly the parenthesized form
# ("constsym(" is the 9-byte prefix; the canonical tree renders are
# never empty, so a segment of length >= 10 with the prefix and a
# closing ")" is the exact form).
def stable_const_sym_of_segment(segment: String) -> Option[CanonicalConstValue]
  if segment.len() < 10 then return Option::None end
  if segment.slice(0, 9) != "constsym(" then return Option::None end
  if segment.slice(segment.len() - 1, segment.len()) != ")" then return Option::None end
  let w = stable_words_of(&segment)
  Option::Some(CanonicalConstValue {
    kind: "constsym".to_string(),
    value: 0,
    text: segment,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The const row of a mangle-suffix SEGMENT: Option::Some for exactly the
# three const render families ("c<v>" / "constparam<n>" /
# "constsym(<tree>)"), Option::None for a type render.
pub def canonical_const_of_segment(segment: String) -> Option[CanonicalConstValue]
  match stable_const_value_of_segment(&segment)
  when Option::Some(v) then Option::Some(v)
  when Option::None then
    match stable_const_param_of_segment(&segment)
    when Option::Some(p) then Option::Some(p)
    when Option::None then stable_const_sym_of_segment(&segment)
    end
  end
end

# ———— Constructors ————

# The type-key row of one canonical type render (text kept as the
# collision-detection cargo / diagnostics surface; words over the text).
pub def canonical_type_key_of(render: String) -> CanonicalTypeKey
  let w = stable_words_of(&render)
  CanonicalTypeKey { text: render, digest_hi: w.0, digest_lo: w.1 }
end

# The const row of a (kind, value) pair classified by a caller that
# holds the const parameter's DECLARED scalar type: kind "signed" or
# "unsigned" builds the VALUE row over the canonical text "c<value>";
# kind "constparam" builds the forwarding row over "constparam<value>".
# Any other kind word defaults to the value form — the only form a
# (kind, value) pair can faithfully express (a "constsym" TREE row
# cannot be built from a value — use canonical_const_of_segment over the
# tree's rendered segment). The digest words are identical for both
# value kinds (one value form in the key grammar — see the section doc),
# so identity never depends on the kind label.
pub def canonical_const_value_of(kind: String, value: Int) -> CanonicalConstValue
  var text = "c" + value.to_string()
  if kind == "constparam" then
    text = "constparam" + value.to_string()
  end
  let w = stable_words_of(&text)
  CanonicalConstValue { kind: kind, value: value, text: text, digest_hi: w.0, digest_lo: w.1 }
end

# The ARG-vector classification of the full declared-order render list:
# every render becomes one CanonicalGenericArg IN POSITION (const families
# classify as Const rows; every other render as a Type row). The order is
# never rearranged — this is the P0-5 cross-kind-order guarantee.
pub def canonical_args_of_renders(arg_renders: Vec[String]) -> Vec[CanonicalGenericArg]
  var args: Vec[CanonicalGenericArg] = Vec::new()
  for segment in arg_renders do
    match canonical_const_of_segment(&segment)
    when Option::Some(cv) then args.push(CanonicalGenericArg::Const(cv))
    when Option::None then args.push(CanonicalGenericArg::Type(canonical_type_key_of(&segment)))
    end
  end
  args
end

# The STRUCTURAL identity text of an instance: the callable's identity
# words + every arg (kind tag + digest words) in order, length-prefixed.
# The kind tag keeps a Type and a Const at the same position distinct; the
# concatenation order keeps [Type A, Const 3] distinct from
# [Const 3, Type A] (P0-5).
pub def structural_instance_identity_text(id: StructuralInstanceId) -> String
  var text = stable_identity_lenpref(&id.callable.digest_hi.to_string()) +
    stable_identity_lenpref(&id.callable.digest_lo.to_string())
  for arg in id.args do
    match arg
    when CanonicalGenericArg::Type(t) then
      text = text + stable_identity_lenpref("type") +
        stable_identity_lenpref(&t.digest_hi.to_string()) +
        stable_identity_lenpref(&t.digest_lo.to_string())
    when CanonicalGenericArg::Const(c) then
      text = text + stable_identity_lenpref("const") +
        stable_identity_lenpref(&c.digest_hi.to_string()) +
        stable_identity_lenpref(&c.digest_lo.to_string())
    end
  end
  text
end

# The structural instance record of an already-built arg vector.
pub def structural_instance_id_of(callable: StableDeclId, args: Vec[CanonicalGenericArg]) -> StructuralInstanceId
  let id = StructuralInstanceId { callable: callable.clone(), args: args.clone() }
  let text = structural_instance_identity_text(id)
  let w = stable_words_of(&text)
  StructuralInstanceId {
    callable: callable,
    args: args,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The structural instance record of a callable record + the full
# declared-order render list (the mono boundary's positional constructor).
pub def structural_instance_id_of_renders(callable: StableDeclId, arg_renders: Vec[String]) -> StructuralInstanceId
  structural_instance_id_of(callable, canonical_args_of_renders(arg_renders))
end

# The text-boundary base component of an emission key: everything before
# the FIRST "$" (the mangle grammar never puts "$" inside the base or a
# render). No "$" = the whole text.
pub def stable_instance_base_of_text(instance_key: String) -> String
  let at = stable_index_of(&instance_key, "$", 0)
  if at < 0 then instance_key.clone() else instance_key.slice(0, at) end
end

# The text-boundary render components of an emission key: the "$"-split
# segments after the base, in order; an empty vector for a key with no
# "$" suffix.
pub def stable_instance_arg_renders_of_text(instance_key: String) -> Vec[String]
  var renders: Vec[String] = Vec::new()
  let at = stable_index_of(&instance_key, "$", 0)
  if at < 0 then
    return renders
  end
  var current = ""
  var i = at + 1
  while i < instance_key.len() do
    let ch = instance_key.slice(i, i + 1)
    if ch == "$" then
      renders.push(current.clone())
      current = ""
    else
      current = current + ch
    end
    i = i + 1
  end
  renders.push(current)
  renders
end

# The structural instance record of an emission-key TEXT: the callable is
# the base component's parse (stable_callable_decl_of — the documented
# text-boundary fallback), the args the declared-order "$" segments. This
# is the adapter behind the retained stable_callable_instance_id_of name.
pub def structural_instance_id_of_text(instance_key: String) -> StructuralInstanceId
  let base = stable_instance_base_of_text(&instance_key)
  let renders = stable_instance_arg_renders_of_text(&instance_key)
  structural_instance_id_of_renders(stable_callable_decl_of(&base), renders)
end

# The former StableCallableInstanceId constructor name, retained for the
# §33/PGO text boundaries that carry an emission-key render: the
# StructuralInstanceId the text structurally denotes (fourth-audit P0-6).
pub def stable_callable_instance_id_of(instance_key: String) -> StructuralInstanceId
  structural_instance_id_of_text(&instance_key)
end

# The audit constructor: the callable's fn-owner key text plus the
# ALREADY-BUILT positional arg vector (the caller holds the declared
# cross-kind order). Identity = the structured record; the text parse is
# only the callable boundary.
pub def instance_key_of(callable_key_text: String, args: Vec[CanonicalGenericArg]) -> StructuralInstanceId
  structural_instance_id_of(stable_callable_decl_of(&callable_key_text), args)
end

# The TOTAL positional constructor (the mono boundary): the full
# declared-order render list of the emission suffix, classified by the
# segment grammar IN POSITION (const families vs type renders) — the
# classification is exact and deterministic and the order is preserved.
pub def instance_key_of_renders(callable_key_text: String, arg_renders: Vec[String]) -> StructuralInstanceId
  structural_instance_id_of_renders(stable_callable_decl_of(&callable_key_text), arg_renders)
end

# The canonical render of ONE generic arg (the emission/diagnostics text).
pub def canonical_generic_arg_text(arg: CanonicalGenericArg) -> String
  match arg
  when CanonicalGenericArg::Type(t) then t.text.clone()
  when CanonicalGenericArg::Const(c) then stable_const_text_of(c)
  end
end

# The DIAGNOSTICS render of a structured key: the callable's stable
# reference text, then every arg text in DECLARED order, "$"-joined (no
# trailing "$" on an empty arg list). Diagnostic only — the emitted
# symbol uses structural_instance_mangle_text.
pub def instance_key_to_text(key: StructuralInstanceId) -> String
  var text = stable_decl_reference_text(&key.callable)
  for arg in key.args do
    text = text + "$" + canonical_generic_arg_text(arg)
  end
  text
end

# The EMISSION render of a structural instance — the mangled symbol text
# DERIVED from the record (never fed into it; fourth-audit P0-6): the
# callable's reference text, "$", then every arg render in DECLARED order
# "$"-joined. The byte shape mirrors mangle_name exactly (an empty arg
# list still carries the trailing "$"), so symbol bytes stay stable.
pub def structural_instance_mangle_text(key: StructuralInstanceId) -> String
  var text = stable_decl_reference_text(&key.callable) + "$"
  var first = true
  for arg in key.args do
    if !first then
      text = text + "$"
    end
    text = text + canonical_generic_arg_text(arg)
    first = false
  end
  text
end

# ———— Equality and hashing (digest words only) ————

# The digest-word equality of one generic arg (the kind tag is part of the
# comparison, so Type and Const rows never equal).
pub def canonical_generic_arg_eq(a: CanonicalGenericArg, b: CanonicalGenericArg) -> Bool
  match a
  when CanonicalGenericArg::Type(ta) then
    match b
    when CanonicalGenericArg::Type(tb) then ta.digest_hi == tb.digest_hi && ta.digest_lo == tb.digest_lo
    when _ then false
    end
  when CanonicalGenericArg::Const(ca) then
    match b
    when CanonicalGenericArg::Const(cb) then ca.digest_hi == cb.digest_hi && ca.digest_lo == cb.digest_lo
    when _ then false
    end
  end
end

# The digest-word equality of two structural instances: the callable
# words, then every arg POSITIONALLY (the vector is never sorted or
# regrouped — P0-5's cross-kind order).
pub def instance_key_eq(a: StructuralInstanceId, b: StructuralInstanceId) -> Bool
  if a.callable.digest_hi != b.callable.digest_hi then return false end
  if a.callable.digest_lo != b.callable.digest_lo then return false end
  if a.args.len() != b.args.len() then return false end
  var i = 0
  while i < a.args.len() do
    if !canonical_generic_arg_eq(a.args[i].clone(), b.args[i].clone()) then return false end
    i = i + 1
  end
  true
end

impl Eq for CanonicalTypeKey
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for CanonicalTypeKey
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for CanonicalConstValue
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for CanonicalConstValue
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Clone for CanonicalTypeKey
  def clone(self: Self) -> CanonicalTypeKey
    CanonicalTypeKey { text: self.text.clone(), digest_hi: self.digest_hi, digest_lo: self.digest_lo }
  end
end

impl Clone for CanonicalConstValue
  def clone(self: Self) -> CanonicalConstValue
    CanonicalConstValue {
      kind: self.kind.clone(),
      value: self.value,
      text: self.text.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Clone for CanonicalGenericArg
  def clone(self: Self) -> CanonicalGenericArg
    match self
    when CanonicalGenericArg::Type(t) then CanonicalGenericArg::Type(t.clone())
    when CanonicalGenericArg::Const(c) then CanonicalGenericArg::Const(c.clone())
    end
  end
end

impl Clone for StructuralInstanceId
  def clone(self: Self) -> StructuralInstanceId
    StructuralInstanceId {
      callable: self.callable.clone(),
      args: self.args.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

impl Eq for StructuralInstanceId
  def eq(self: Self, other: Self) -> Bool
    instance_key_eq(self, other)
  end
end

impl Hash for StructuralInstanceId
  # The structured fold: the callable's digest words, then every arg's
  # kind tag + digest words IN ORDER, folded through the unsigned 64-bit
  # view (the section-6 fold). The hash is a pure function of the digest
  # words — never of a "$"-joined text — and equal records (instance_key_eq)
  # always fold identically.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.callable.digest_hi) as Int
    h = ((h as UInt) * 31 + self.callable.digest_lo) as Int
    for arg in self.args do
      match arg
      when CanonicalGenericArg::Type(t) then
        h = ((h as UInt) * 31 + (1 as UInt)) as Int
        h = ((h as UInt) * 31 + t.digest_hi) as Int
        h = ((h as UInt) * 31 + t.digest_lo) as Int
      when CanonicalGenericArg::Const(c) then
        h = ((h as UInt) * 31 + (2 as UInt)) as Int
        h = ((h as UInt) * 31 + c.digest_hi) as Int
        h = ((h as UInt) * 31 + c.digest_lo) as Int
      end
    end
    h
  end
end

# ———————————————————————————————————————————————————————————————
# 10. COMPOSITE STABLE ROW KEYS (audit item 5)
# ———————————————————————————————————————————————————————————————
# The identity of a SEMANTIC TABLE ROW whose key is not a bare def key:
# the §31/§32 composite row keys the comparison engines key row maps by —
#
#   domain           | canonical row-key grammar
#   -----------------+----------------------------------------------
#   call             | "caller-def-key|callee-def-key|kind-numeric"
#   capability       | "fn-def-key|cap<id>"           (presence pair)
#   capability-row   | "fn-def-key|cap<id>|Requires|Provides"
#   ownership        | "fn-def-key|place-text"
#   ownership-row    | "fn-def-key|place-text|let|inout|sink|set"
#   contract         | "fn-def-key|Pre|Post|Invariant|clause"
#
# The record separates the row's SUBJECT declaration (decl — the first
# component's StableDeclId; its lineage digest is the subject identity),
# the DOMAIN word and the SUFFIX (the text after the first '|': the callee
# + kind for a call row, "cap<id>" for a capability pair, the place for an
# ownership row, "kind|clause" for a contract row). digest_hi/digest_lo
# digest the FULL canonical row-key text — the identity is that text,
# exactly like every section-1..9 record; `text` keeps the row key
# verbatim (the collision-detection cargo / diagnostics surface / protocol
# render source). Eq/Hash fold the digest words only, so a digest-keyed
# Map/Set keys on the stable identity; stable_row_key_collision_check
# verifies an insert's words against the text when both are available (an
# actual 128-bit collision is an internal failure, never a
# counter-disambiguated identity).
#
# PARSE RULES (stable_row_key_of): the first '|' always separates the
# subject def key; the remainder classifies by its documented shapes —
# "cap<digits>" (pair) / "cap<digits>|<direction>" (row), a clause kind
# word ("Pre"/"Post"/"Invariant") opening the remainder (contract; the
# clause is final and may contain '|'), a LAST component that is all
# digits (call) or a convention word (ownership-row), and a single
# remaining component (ownership pair). Option::None for any text outside
# the grammars; stable_row_key_or_text is the TOTAL builder for callers
# that parse a row they produced (it falls back to the full text as the
# lineage and an empty suffix — identity is the full-text digest either
# way; no canonical row key is affected).

struct StableRowKey
  domain: String
  decl: StableDeclId
  suffix: String
  text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The last occurrence of `needle` in `s` (-1 when absent).
def stable_last_index_of(s: String, needle: String) -> Int
  if needle.len() == 0 then
    return -1
  end
  var found = -1
  var i = 0
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      found = i
    end
    i = i + 1
  end
  found
end

# The row record of a subject key + suffix: text = subject "|" suffix (the
# canonical composite key), decl = the subject's StableDeclId (the total
# stable_decl_of_key fallback covers keys without a "#sig" component),
# digest words over the full text.
def stable_row_key_make(domain: String, subject_key: String, suffix: String) -> StableRowKey
  let text = subject_key.clone() + "|" + suffix.clone()
  let decl = stable_decl_of_key(&subject_key)
  let w = stable_words_of(&text)
  StableRowKey {
    domain: domain,
    decl: decl,
    suffix: suffix,
    text: text,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The PUBLIC composite builder for the row grammars whose subject is a def
# key (the builder side of the item-5 table maps: call rows, capability
# pairs, ownership pairs, ...): the caller holds the subject key text and
# the suffix it composed, so no re-parse is needed.
pub def stable_composite_row_key(domain: String, subject_key: String, suffix: String) -> StableRowKey
  stable_row_key_make(domain, subject_key, suffix)
end

# Parse a canonical composite row key (the grammar table above).
pub def stable_row_key_of(key_text: String) -> Option[StableRowKey]
  let i1 = stable_index_of(&key_text, "|", 0)
  if i1 <= 0 then
    return Option::None
  end
  let first = key_text.slice(0, i1)
  if !stable_def_key_shape(&first) then
    return Option::None
  end
  let rest = key_text.slice(i1 + 1, key_text.len())
  if rest.len() == 0 then
    return Option::None
  end
  # capability family: "cap<digits>" pair or "cap<digits>|<direction>" row.
  # A rest that only LOOKS like "cap..." but fails the grammar falls through
  # (a place may legitimately start with "cap").
  if rest.starts_with("cap") then
    let i2 = stable_index_of(&rest, "|", 0)
    if i2 < 0 then
      let cap_digits = rest.slice(3, rest.len())
      if stable_is_digits(&cap_digits) then
        return Option::Some(stable_row_key_make("capability", first.clone(), rest.clone()))
      end
    else
      let cap_digits = rest.slice(3, i2)
      let direction = rest.slice(i2 + 1, rest.len())
      if stable_is_digits(&cap_digits) && (direction == "Requires" || direction == "Provides") then
        return Option::Some(stable_row_key_make("capability-row", first.clone(), rest.clone()))
      end
    end
  end
  # contract family: the second component is a clause kind word.
  let i2 = stable_index_of(&rest, "|", 0)
  if i2 > 0 then
    let word = rest.slice(0, i2)
    if word == "Pre" || word == "Post" || word == "Invariant" then
      return Option::Some(stable_row_key_make("contract", first.clone(), rest.clone()))
    end
  end
  # call / ownership-row families: the LAST component is a kind digit run
  # or a convention word.
  let last = stable_last_index_of(&rest, "|")
  if last >= 0 then
    let tail = rest.slice(last + 1, rest.len())
    if stable_is_digits(&tail) then
      return Option::Some(stable_row_key_make("call", first.clone(), rest.clone()))
    end
    if tail == "let" || tail == "inout" || tail == "sink" || tail == "set" then
      return Option::Some(stable_row_key_make("ownership-row", first.clone(), rest.clone()))
    end
    return Option::None
  end
  # "fn|place": an ownership pair row.
  Option::Some(stable_row_key_make("ownership", first.clone(), rest.clone()))
end

# The TOTAL row-key builder: the grammar parse when it succeeds, else the
# full text as the lineage with an empty suffix (identity is the full-text
# digest in both forms — a builder that produced the row never fails the
# parse, and a non-canonical text still keys by its own digest).
pub def stable_row_key_or_text(domain: String, key_text: String) -> StableRowKey
  match stable_row_key_of(&key_text)
  when Option::Some(rk) then rk
  when Option::None then
    let i1 = stable_index_of(&key_text, "|", 0)
    if i1 > 0 then
      stable_row_key_make(domain, key_text.slice(0, i1), key_text.slice(i1 + 1, key_text.len()))
    else
      let w = stable_words_of(&key_text)
      StableRowKey {
        domain: domain,
        decl: stable_decl_of_key(&key_text),
        suffix: "".to_string(),
        text: key_text.clone(),
        digest_hi: w.0,
        digest_lo: w.1
      }
    end
  end
end

# The TOTAL declaration builder of a canonical key text: the lineage parse
# when the key is def-shaped, else the symbol-domain fallback (the whole
# text is the digest preimage). The item-5 table maps call this ONCE per
# snapshot row key.
pub def stable_decl_of_key(key: String) -> StableDeclId
  match decl_id_of_full_key(&key)
  when Option::Some(d) then d
  when Option::None then stable_symbol_of_key(&key).decl
  end
end

# The digest-word equality of two declaration ids (the section-6 Eq rule as
# a function — the §36/§31 hot spots compare without a Map lookup).
pub def stable_decl_eq(a: StableDeclId, b: StableDeclId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

# The digest-word equality of two composite row keys.
pub def stable_row_key_digest_eq(a: StableRowKey, b: StableRowKey) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

# (fourth-audit P0-19) The UNSAFE-SITE identity constructor: the
# declaration identity of the subject function (through the total
# stable_decl_of_key fallback) plus the marker kind word and site text; the
# digest words are the stable digest of "<function key>|<kind>|<site>".
# The budget's typed allowed_unsafe set inserts these records and compares
# them with stable_unsafe_site_eq — NEVER a rendered marker-row parse.
pub def stable_unsafe_site_id_of(function_key: String, kind: String, site: String) -> StableUnsafeSiteId
  let text = function_key.clone() + "|" + kind.clone() + "|" + site.clone()
  let w = stable_words_of(&text)
  StableUnsafeSiteId {
    decl: stable_decl_of_key(&function_key),
    kind: kind,
    site: site,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The equality of two unsafe-site identities: the declaration digest words
# plus the kind/site texts (the typed members — no text parse).
pub def stable_unsafe_site_eq(a: StableUnsafeSiteId, b: StableUnsafeSiteId) -> Bool
  a.decl.digest_hi == b.decl.digest_hi && a.decl.digest_lo == b.decl.digest_lo &&
    a.kind == b.kind && a.site == b.site
end

# (fourth-audit P0-19) The ABI-surface record's Eq/Hash — the §36 budget's
# typed allowed_abi set keys on the surface identity: the digest words plus
# the stable key text (the dense id is a per-compilation locator and never
# participates). Mirrors the StableDeclId fold.
impl Eq for StableAbiSurfaceId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo &&
      self.stable_key == other.stable_key
  end
end

impl Hash for StableAbiSurfaceId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for StableUnsafeSiteId
  def eq(self: Self, other: Self) -> Bool
    self.decl.digest_hi == other.decl.digest_hi && self.decl.digest_lo == other.decl.digest_lo &&
      self.kind == other.kind && self.site == other.site
  end
end

impl Hash for StableUnsafeSiteId
  # The declaration digest words folded through the unsigned 64-bit view
  # (the StableDeclId hash fold); the kind/site texts are Eq members only —
  # unequal records may share a hash, equal records never differ.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.decl.digest_hi) as Int
    h = ((h as UInt) * 31 + self.decl.digest_lo) as Int
    h
  end
end

# ———— The insert-site collision checks (the ids.tg doctrine: digest words
# are the identity, the canonical text makes a real 128-bit collision
# detectable; a mismatch is NEVER counter-disambiguated) ————

# Whether a stored digest pair IS the stable digest of the given canonical
# key text. True = the words and the text agree (the normal insert); false
# = the words do not belong to this text (an actual digest collision or a
# mis-paired record) — the caller keeps the recorded pair.
pub def stable_key_collision_check(key_text: String, digest_hi: UInt, digest_lo: UInt) -> Bool
  let w = stable_words_of(&key_text)
  w.0 == digest_hi && w.1 == digest_lo
end

# Whether a declaration record's words are the words the given
# registration lineage text ("path::name" — no "#sig") derives: the
# insert-site check of the decl-keyed tables. Under the persistent-lineage
# model a store-assigned number is NOT recoverable from text, so the check
# re-derives the TEXT-BOUNDARY record (stable_decl_of_key) and compares
# words — meaningful for text-parsed records (the semantic-table parser
# path), tautologically true for a text parse of the same lineage, and
# never true for a store-built record with a persistent number (the
# persistent insert-site guard is the store's own structural matcher, not
# this text check — documented boundary).
pub def stable_decl_collision_check(decl: StableDeclId, lineage_text: String) -> Bool
  let candidate = stable_decl_of_key(&lineage_text)
  candidate.digest_hi == decl.digest_hi && candidate.digest_lo == decl.digest_lo
end

# Whether a composite row key's words are the digest of the given full row
# key text — the insert-site check of the StableRowKey-keyed tables.
pub def stable_row_key_collision_check(rk: StableRowKey, key_text: String) -> Bool
  stable_key_collision_check(&key_text, rk.digest_hi, rk.digest_lo)
end

# ———— Eq/Hash (the digest-words fold; the text/domain/suffix are cargo) ————

impl Eq for StableRowKey
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableRowKey
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end
