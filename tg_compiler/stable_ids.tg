# Tangerine Compiler — Stable Semantic Identity Domains (audit §27)
# Self-hosting compiler written in Tangerine
#
# The STABLE face of the semantic domains — the revision-surviving
# identities the §29 snapshot / §31 delta / §32 index / §33 slice / §35
# repair / §36 budget / §37 patch rows key on — as strong records that
# separate:
#   DENSE ids  — per-compilation table indexes (TypeId.id, TraitId.id,
#                ImplId.id, MirBlockId.id, a statement index, the §11
#                CapabilityId band). A dense id exists only inside ONE
#                compilation's local tables; it NEVER survives a revision
#                and must NEVER be required where a semantic identity is
#                needed (a synthesized entity, or an external key, has no
#                dense id — both store -1).
#   STABLE ids — the canonical KEY TEXT plus the 128-bit STABLE DIGEST
#                (ids.tg StableDigest — stable_digest_of over the
#                length-prefixed canonical key) of that text. The digest is
#                the identity projection; the stored key makes an actual
#                digest collision detectable (ids.tg's collision policy: a
#                real collision is an internal failure, never a
#                counter-disambiguated identity). Because the digest is a
#                pure function of the key text, canonical-key TEXT equality
#                IS semantic identity equality — the §31/§36/§37 text
#                comparisons are semantic comparisons (stable_key_eq is the
#                ONE comparison to use); digest words are the
#                collision-detection cargo and the future digest-keyed map
#                key.
#
# DECLARATION IDENTITY vs SIGNATURE FINGERPRINT (the audit's symbol split,
# section 6): a def digest key "path::name#sig" carries TWO orthogonal
# identities. The DECLARATION lineage — the "path::name" registration key
# (stable_registration_key's grammar) — digests ALONE: a signature edit
# never changes it. The SIGNATURE FINGERPRINT — the parsed "#sig" text —
# digests over the sig component. Changing foo(Int)->Int to
# foo(Int,Int)->Int is therefore ONE declaration whose signature changed —
# a §31 signature-CHANGE pairing of the same entity, never a remove/create
# pairing (a phantom removed-then-recreated symbol row). The split records
# are StableDeclId / SignatureFingerprint / StableSymbolId (section 6;
# digest-keyed maps over them arrive in a later slice).
#
# THE RECORDS (one per domain; payload mirrors the digest pair
# digest_hi/digest_lo of repair_candidates.tg's §35 advisory symbol record
# — plus the dense slot). The key grammars are the EXISTING row-key
# grammars, mirrored here WITHOUT importing their producers (the identity
# layer stays a leaf over ids.tg):
#
#   Domain record       | dense id (when one exists)      | canonical stable key grammar
#   --------------------+---------------------------------+------------------------------------
#   StableTypeId        | TypeId.id                       | def digest key "path::name#sig"
#   StableTraitId       | TraitId.id                      | def digest key "path::name#sig"
#   StableImplId        | ImplId.id (attach at row build) | §7 impl text "trait_key|self_pattern|binders|preds"
#   StableContractId    | none (-1)                       | §31 contract row key "fn|Pre|Post|Invariant|clause"
#   StableEffectId      | none (-1)                       | §31 effect-row key = subject def digest key
#   StableCapabilityId  | parsed "cap<id>" (§11 fixed id) | §31 capability row key "fn|cap<id>|Requires|Provides"
#   StableInstanceId    | none (-1)                       | instance emission key "<fn-owner key>$<arg renders>"
#   StableMirFunctionId | none (-1)                       | def digest key of the def-keyed lowering
#   StableMirBlockId    | MirBlockId.id (parsed)          | §33 block key "<fn key>#B<block id>"
#   StableMirStmtId     | stmt index (parsed; -1 = "#T")  | §33 node key "<fn key>#B<block>#S<idx>" / "#T"
#   StableTestId        | none (-1)                       | def digest key of the test function
#   StableAbiSurfaceId  | none (-1)                       | def digest key of the exported fn
#   StableImplMethodId  | none (-1)                       | §7 impl method text = impl text "#" method name
#   StableLocalId       | none (-1)                       | §7 local name text within a function
#   StablePlaceId       | none (-1)                       | §7 canonical ownership place text "root.field[2]"
#   StableValueId       | none (-1)                       | §7 value row text (reserved grammar)
#   StableDropGlueId    | none (-1)                       | §7 origin row key "drop-glue::<type key>"
#   StableClosureId     | none (-1)                       | §7 origin row key "closure::<emission key>"
#   StableDerivedBodyId | none (-1)                       | §7 origin row key "derived::<kind>::<key>"
#   StableShimId        | none (-1)                       | §7 origin row key "shim::<surface key>"
#
# (The record families of sections 6-7 replace the flat stable_key text of
# the table above with PARSE PIECES — declaration lineage + signature
# fingerprint for a def key, the impl-text components, the place-root and
# projection chain, ... — while keeping the digest pair as the identity;
# the pieces are the collision-detection cargo / the diagnostics surface
# and never replace the key text for identity.)
#
# SymbolId (the audit's symbol-domain name) IS THIS MODULE's StableSymbolId
# (section 6) — the split record {StableDeclId declaration lineage,
# SignatureFingerprint, full key text} — defined here, replacing the
# earlier delegation. repair_candidates.tg's same-named record remains the
# §35 ADVISORY vocabulary's record, unchanged, in repair_candidates.tg (its
# consumers import it directly; this module no longer imports or
# re-exports it).
#
# String authority is NOT removed here: every §29-§37 row table and
# membership set keeps its String keys, and no in-tree call site changes —
# the §36/§37 builders stable_symbol_of_key / stable_from_def_key are
# REBUILT over the section-6 record (they had no in-tree callers) and the
# former repair_candidates StableSymbolId re-export is dropped (its
# consumers import that record from repair_candidates directly). What this
# module removes is the authority of ad-hoc text
# comparison: stable_key_eq is the documented semantic comparison, and the
# typed accessors (stable_*_of_key) plus the from-existing constructors
# (stable_*_from_def / stable_symbol_of_key / stable_from_def_key) are the
# seam a later migration re-keys the residual String maps through (the
# inventory is the final section). DETERMINISM: key texts are canonical;
# digests are pure functions of them; dense ids never participate.

use std::core::{Option}
use std::collections::{Vec}

use tg_compiler::ids::{StableDigest, StableDefId, stable_digest_of}

# ———————————————————————————————————————————————————————————————
# 1. The domain records (each: dense_id + stable_key + digest pair —
#    mirroring the digest pair of the §35 advisory symbol record; dense_id
#    = -1 when the compilation has no dense id for the entity)
# ———————————————————————————————————————————————————————————————
# A nominal TYPE declaration (the §29 SemanticType Struct/Enum rows).
struct StableTypeId
  dense_id: Int = -1   # TypeId.id of the producing TypeEnv, when one exists
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TRAIT declaration (the §29 Trait-kind rows); dense = TraitId.id.
struct StableTraitId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An IMPL declaration; dense = ImplId.id of the producing env's impls
# table when one exists. The §1 placeholder record (a def-digest-key KEY
# GAP shape — no snapshot row family keys impls; an impl method's
# registration key is the type-EXPRESSION text of the impl, which
# semantic_snapshot.tg never re-renders; the §32 type_impls index keys by
# the self-type's def key) is SUPERSEDED by section 7 (audit item 7): the
# canonical impl identity is the IMPL TEXT over the types.tg ImplInfo
# registration data (trait key, self type pattern, generic binders, where
# predicates) — StableImplId / StableImplMethodId / StableLocalId /
# StablePlaceId / StableValueId and the generated-executable ids live in
# section 7, with stable_impl_of_key rebuilt over the impl text.

# A §31 CONTRACT ROW: canonical key = the composite
# "fn-key|Pre|Post|Invariant|clause" (delta_contract_row_key — the clause is
# the LAST component and may itself contain '|'). No dense id.
struct StableContractId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 EFFECT ROW: the row identity is its SUBJECT function (delta keys
# effect rows by function.key alone; the summary's dirty word is row
# CONTENT, never identity). No dense id.
struct StableEffectId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §31 CAPABILITY ROW: the composite "fn-key|cap<id>|Requires|Provides"
# key of delta_capability_row_key; dense = the fixed §11 CapabilityId.id
# parsed from the "cap<id>" part, -1 when the key does not parse.
struct StableCapabilityId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A monomorphized INSTANCE: canonical key = the instance emission key (the
# fn-owner-key base "<module path>::<index>::<kind>" + mangle_name's
# "$"-joined canonical arg renders). No dense id (the MonoCache is keyed by
# the emission text itself).
struct StableInstanceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A def-keyed lowered MirFunction (the §29 MirSemanticSummary rows, keyed
# by the function's def digest key). dense = -1 (the MirProgram.functions
# Vec ordinal is not an identity; the §33 slice domain keys the same
# functions by EMISSION names — a documented residual, final section).
struct StableMirFunctionId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR BLOCK: canonical key "<fn key>#B<block id>"; dense =
# MirBlockId.id parsed from the key.
struct StableMirBlockId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A §33 MIR STATEMENT / TERMINATOR: "<fn key>#B<block id>#S<stmt index>"
# (terminator "#T" — its index is the block's statement count, so the
# spellings never collide). dense = the parsed statement index; -1 for "#T".
struct StableMirStmtId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# A TEST function (the §29 TestRelationship rows / the §40 TestId
# vocabulary, keyed by the test function's def digest key). No dense id.
struct StableTestId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# An ABI-surface row (the §30 abi_hash domain: pub top-level non-generic
# Function defs, keyed by their def digest key). No dense id.
struct StableAbiSurfaceId
  dense_id: Int = -1
  stable_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———————————————————————————————————————————————————————————————
# 2. Canonical-key derivation helpers (the row-key grammars mirrored)
# ———————————————————————————————————————————————————————————————

# The registration key of a declaration — "path::name" (root module: the
# bare name). Byte-identical to semantic_snapshot.tg snapshot_qualified_key.
pub def stable_registration_key(module_path: Vec[String], name: String) -> String
  let joined = module_path.join("::")
  if joined.is_empty() then name.clone() else joined + "::" + name.clone() end
end

# The full def digest key "registration-key#signature" — the canonical key
# stable_def_id_digested digests for every def row of the snapshot.
pub def stable_def_key(reg_key: String, signature: String) -> String
  reg_key + "#" + signature
end

# The module-path component of a key (before the LAST "::"; "" for a
# root-scoped declaration) — the snapshot_key_module grammar.
pub def stable_key_module(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(0, pos - 2)
    end
    pos = pos - 1
  end
  "".to_string()
end

# The name component of a key (after the LAST "::") — snapshot_key_name.
pub def stable_key_name(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(pos, key.len())
    end
    pos = pos - 1
  end
  key.clone()
end

# The byte index of `needle` at or after `from` (-1 when absent) — the
# byte-text scan idiom of semantic_delta / repair_candidates.
def stable_index_of(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The entity name-part of a def digest key (before the FIRST "#") — the
# delta_key_name_part grammar.
pub def stable_key_name_part(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

# The signature component of a def digest key (after the first "#"; "" when
# the key has none).
pub def stable_key_signature(key: String) -> String
  let i = stable_index_of(key, "#", 0)
  if i < 0 then "".to_string() else key.slice(i + 1, key.len()) end
end

# The instance emission key: the fn-owner-key base + "$" + the canonical
# arg renders joined by "$" — mangle_name's grammar (mono.tg). The renders
# arrive canonical from the caller (type_canon_render CanonInternal /
# type_to_mangled / the snapshot type text) in InstanceId.substs DECLARATION
# order — substitutions are POSITIONAL (Vec<int,str> vs Vec<str,int>), so
# the renders are never sorted before joining; each render is itself
# deterministic (the audit's "sorted renders" is realized by the renders'
# determinism, never by reordering the args).
pub def stable_instance_key(def_key: String, arg_renders: Vec[String]) -> String
  var key = def_key + "$"
  var first = true
  for ty in arg_renders do
    if !first then
      key = key + "$"
    end
    key = key + ty
    first = false
  end
  key
end

# The §33 statement / terminator node keys (slice_stmt_key / slice_term_key
# grammars).
pub def stable_mir_stmt_key(fn_key: String, block_id: Int, stmt_idx: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#S" + stmt_idx.to_string()
end

pub def stable_mir_term_key(fn_key: String, block_id: Int) -> String
  fn_key + "#B" + block_id.to_string() + "#T"
end

# The §31 capability / contract row keys (delta_capability_row_key /
# delta_contract_row_key grammars; direction = "Requires"/"Provides",
# kind_word = "Pre"/"Post"/"Invariant" — the clause is final and may
# contain '|').
pub def stable_capability_row_key(fn_key: String, cap_id: Int, direction: String) -> String
  fn_key + "|cap" + cap_id.to_string() + "|" + direction
end

pub def stable_contract_row_key(fn_key: String, kind_word: String, clause: String) -> String
  fn_key + "|" + kind_word + "|" + clause
end

# ———————————————————————————————————————————————————————————————
# 3. The semantic comparisons (the String-authority rule)
# ———————————————————————————————————————————————————————————————
# Canonical stable-key texts ARE the semantic identity (digests are pure
# functions of the key text), so byte equality of two canonical key texts
# is identity equality. Use this helper — never an ad-hoc ==, never a
# name/path parse — at every §31/§36/§37 stable-key comparison (delta key
# comparisons, budget membership, patch affected-key checks). A migration
# that re-keys a map by digest compares words with ids.tg's stable_digest_eq
# over stable_key_digest's result.
pub def stable_key_eq(a: String, b: String) -> Bool
  a == b
end

# The 128-bit stable digest of a canonical key — the identity projection
# (records rebuilt from a key by the *_of_key accessors always agree with
# records built from an existing StableDefId by the *_from_def constructors).
pub def stable_key_digest(key: String) -> StableDigest
  stable_digest_of(&key)
end

# ———————————————————————————————————————————————————————————————
# 4. The typed accessors and from-existing constructors
# ———————————————————————————————————————————————————————————————
# The def-key shape test: a def digest key is "registration-key#signature"
# with a NON-EMPTY registration part (the signature may be empty). Every
# def-keyed row of the snapshot/delta/index tables carries this shape. The
# DOMAIN of a def key is decided by the producing row's kind metadata (a
# TypeName row is a type, a Function row a fn ...) — never by the key text
# — so the def-family accessors return Some for every well-shaped def key
# and the caller picks the record its row table owns.
def stable_def_key_shape(key: String) -> Bool
  stable_index_of(key, "#", 0) > 0
end

# Whether a text is all ASCII digits (the numeric-key-component check).
def stable_is_digits(text: String) -> Bool
  if text.len() == 0 then return false end
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch < "0" || ch > "9" then
      return false
    end
    i = i + 1
  end
  true
end

# The deterministic Int value of a non-empty ASCII-digit text.
def stable_text_to_int(text: String) -> Int
  var value = 0
  var i = 0
  while i < text.len() do
    let bs = text.slice(i, i + 1).bytes()
    if bs.len() > 0 then
      value = value * 10 + (bs[0] as Int - 48)
    end
    i = i + 1
  end
  value
end

# The digest words of a canonical key as the record's (hi, lo) fields.
def stable_words_of(key: String) -> (UInt, UInt)
  let d = stable_digest_of(&key)
  (d.hi, d.lo)
end

# The dense-id projection of Option[Int]: Some(id) rides the record
# verbatim; None (no dense id exists — a synthesized entity or an external
# key) is stored as -1. Dense ids never survive a revision.
def stable_dense_of(dense: Option[Int]) -> Int
  match dense
  when Option::Some(v) then v
  when Option::None then -1
  end
end

# The §36/§37 builder over this module's StableSymbolId (section 6): the
# EXACT canonical def-key payload — the declaration lineage identity of the
# key's "path::name" part, the signature fingerprint of its "#sig" part,
# full_key = the def digest key text — the payload an allowed_symbols entry
# must carry to equal a §31 delta key exactly (change_budget.tg's identity
# rule; the key TEXT equality rule is unchanged — the §36 comparisons
# compare texts, and full_key carries the text verbatim). TOTAL (the legacy
# builder was total): a key without a "#signature" component builds the
# pure-lineage form — its fingerprint is the empty-sig fallback (digest of
# ""), which is the SAME fingerprint the shaped key "lineage#" carries
# (documented residual: no canonical row key omits the "#", so real §31
# delta keys are unaffected).
pub def stable_symbol_of_key(key: String) -> StableSymbolId
  match stable_symbol_id_of_full_key(&key)
  when Option::Some(s) then s
  when Option::None then
    let w = stable_words_of(&key)
    let mkey = stable_key_module(&key)
    let lineage = key.clone()
    StableSymbolId {
      decl: StableDeclId {
        module_key: mkey,
        kind: "".to_string(),
        lineage_key: lineage,
        digest_hi: w.0,
        digest_lo: w.1
      },
      fingerprint: stable_fp_unparsed("".to_string()),
      full_key: key.clone()
    }
  end
end

# The §35 advisory-vocabulary builder over a canonical def key (the audit's
# stable_from_def_key): kind_text scopes the key ("fn", "type", "local",
# ... — rc_stable_symbol's vocabulary over def keys instead of display
# texts). Advisory only: the kind-prefixed key NEVER equals a §31 delta key
# — the exact-match builder is stable_symbol_of_key. The kind prefix rides
# the lineage text (so it digests), mirroring the legacy
# digest-over-the-full-prefixed-text scoping.
pub def stable_from_def_key(kind_text: String, key: String) -> StableSymbolId
  let full = kind_text + "::" + key
  stable_symbol_of_key(&full)
end

# ———— Def-family typed accessors (dense_id = -1: a key text carries no
# dense id; attach the local table's id through the *_from_def constructors
# when one exists) ————

# The domain record of a TYPE row's def digest key.
pub def stable_type_of_key(key: String) -> Option[StableTypeId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTypeId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

pub def stable_trait_of_key(key: String) -> Option[StableTraitId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTraitId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An effect row's subject-function def digest key.
pub def stable_effect_of_key(key: String) -> Option[StableEffectId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableEffectId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A def-keyed lowering's def digest key.
pub def stable_mir_function_of_key(key: String) -> Option[StableMirFunctionId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableMirFunctionId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A test function's def digest key.
pub def stable_test_of_key(key: String) -> Option[StableTestId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableTestId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# An ABI surface row's def digest key.
pub def stable_abi_surface_of_key(key: String) -> Option[StableAbiSurfaceId]
  if !stable_def_key_shape(&key) then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableAbiSurfaceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# ———— Def-family from-existing constructors (copy the EXISTING digest
# words and key of the row's StableDefId — never recomputed — and attach
# the dense id of the producing compilation's local table; pass
# Option::None when no dense id exists — stored as -1) ————

pub def stable_type_from_def(sid: StableDefId, dense: Option[Int]) -> StableTypeId
  StableTypeId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_trait_from_def(sid: StableDefId, dense: Option[Int]) -> StableTraitId
  StableTraitId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_effect_from_def(sid: StableDefId, dense: Option[Int]) -> StableEffectId
  StableEffectId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_mir_function_from_def(sid: StableDefId, dense: Option[Int]) -> StableMirFunctionId
  StableMirFunctionId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_test_from_def(sid: StableDefId, dense: Option[Int]) -> StableTestId
  StableTestId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

pub def stable_abi_surface_from_def(sid: StableDefId, dense: Option[Int]) -> StableAbiSurfaceId
  StableAbiSurfaceId {
    dense_id: stable_dense_of(&dense),
    stable_key: sid.key.clone(),
    digest_hi: sid.digest_hi,
    digest_lo: sid.digest_lo
  }
end

# ———— Composite-row typed accessors (the §31 row-key grammars) ————

# A contract row key "fn-key|Pre|Post|Invariant|clause": the first two
# components must be a def digest key and a kind word; the clause is the
# final component (may contain '|', may be empty).
pub def stable_contract_of_key(key: String) -> Option[StableContractId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let kind_word = key.slice(i1 + 1, i2)
  if kind_word != "Pre" && kind_word != "Post" && kind_word != "Invariant" then
    return Option::None
  end
  let w = stable_words_of(&key)
  Option::Some(StableContractId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A capability row key "fn-key|cap<id>|Requires|Provides": the middle part
# must be "cap<digits>" and the direction word one of the two spellings.
# The parsed CapabilityId.id rides the record's dense slot.
pub def stable_capability_of_key(key: String) -> Option[StableCapabilityId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 <= 0 then return Option::None end
  let fn_part = key.slice(0, i1)
  if !stable_def_key_shape(&fn_part) then return Option::None end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 <= i1 + 1 then return Option::None end
  let cap_part = key.slice(i1 + 1, i2)
  if !cap_part.starts_with("cap") then return Option::None end
  let cap_digits = cap_part.slice(3, cap_part.len())
  if !stable_is_digits(&cap_digits) then return Option::None end
  let dir_part = key.slice(i2 + 1, key.len())
  if dir_part != "Requires" && dir_part != "Provides" then return Option::None end
  let cap_id = stable_text_to_int(&cap_digits)
  let w = stable_words_of(&key)
  Option::Some(StableCapabilityId {
    dense_id: cap_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# An instance emission key: the fn-owner-key base never contains "#B" and
# the mangle_name grammar always appends "$" (an empty arg list still
# yields "base$").
pub def stable_instance_of_key(key: String) -> Option[StableInstanceId]
  let dollar = stable_index_of(key, "$", 0)
  if dollar <= 0 then return Option::None end
  if stable_index_of(key, "#B", 0) >= 0 then return Option::None end
  let w = stable_words_of(&key)
  Option::Some(StableInstanceId { dense_id: -1, stable_key: key.clone(), digest_hi: w.0, digest_lo: w.1 })
end

# A §33 block key "<fn key>#B<block digits>": a "#B" marker, all-digit
# block text, and NO "#S"/"#T" node suffix after it. The parsed MirBlockId
# rides the record's dense slot.
pub def stable_mir_block_of_key(key: String) -> Option[StableMirBlockId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      return Option::None
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 then return Option::None end
  let block_id = stable_text_to_int(&block_text)
  let w = stable_words_of(&key)
  Option::Some(StableMirBlockId {
    dense_id: block_id,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# A §33 node key "<fn key>#B<block>#S<idx>" or "<fn key>#B<block>#T": the
# block text must be all digits and the node suffix exactly "#S<digits>"
# (statement) or "#T" (terminator — dense stays -1).
pub def stable_mir_stmt_of_key(key: String) -> Option[StableMirStmtId]
  let mark = stable_index_of(key, "#B", 0)
  if mark <= 0 then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  var stmt_dense = -1
  if key.slice(i, key.len()) == "#T" then
    stmt_dense = -1
  else
    if key.slice(i, i + 2) != "#S" then return Option::None end
    let idx_text = key.slice(i + 2, key.len())
    if !stable_is_digits(&idx_text) then return Option::None end
    stmt_dense = stable_text_to_int(&idx_text)
  end
  let w = stable_words_of(&key)
  Option::Some(StableMirStmtId {
    dense_id: stmt_dense,
    stable_key: key.clone(),
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# ———————————————————————————————————————————————————————————————
# 5. Residual string-keyed semantic maps (the migration inventory)
# ———————————————————————————————————————————————————————————————
# This slice changes no call sites. The String-keyed semantic-authority
# sites a later migration re-keys through the records above:
#   §29 rows   — semantic_model.tg rows carry StableDefId values whose .key
#                TEXT is sorted/rendered; the symbol rows ARE the def domain
#                (SymbolId = this module's section-6 StableSymbolId).
#   §31 delta  — semantic_delta.tg keys every row table by key TEXT
#                (Map[String, String] row maps; EntityDelta.stable_id and
#                created/removed/affected are Strings; the delta_*_row_key
#                composites are mirrored here). Migrating = keying row maps
#                by digest words (stable_key_digest) and comparing through
#                stable_key_eq / stable_digest_eq.
#   §32 index  — semantic_index.tg read-side maps keyed by the §29 key TEXT
#                (callers/callees Map[String, Vec[String]], symbol_types/
#                effects/capabilities/contracts/type_* Map[String, ...]).
#   §33 slice  — semantic_slice.tg node keys embed the MirFunction EMISSION
#                name, not the def digest key; migrating that authority
#                needs the MirFunction.callable DefId -> def digest key join
#                first (a separate slice).
#   §35 repair — repair_candidates.tg's own advisory StableSymbolId.key
#                texts and rc_stable_symbol's "<domain>::<text>" vocabulary
#                (that digest-bearing §35 record is distinct from section
#                6's symbol-domain StableSymbolId and is not imported here).
#   §36 budget — change_budget.tg allowed_symbols: Set[StableSymbolId]
#                (repair_candidates' record) compared by .key TEXT against
#                the delta's String key lists (budget_symbol_allowed);
#                allow_new_effects / capabilities are the dense
#                EffectId/CapabilityId bands.
#   §37 patch  — proof_patch.tg derives the affected-key and unsafe-marker
#                rows from the §31 delta's String keys.
#   mono/types/mir caches — MonoCache.instances: Map[String, MirFunction]
#                keyed by instance_key mangle texts (mono.tg:67 — the
#                audit's instance-cache anchor); types.tg / mir.tg
#                owner-key maps (typed_fn_signatures, fn_call_graph,
#                fn_ret_types ... keyed by fn_owner_key renders). These are
#                COMPILATION-internal caches: re-keying them is a separate
#                high-risk slice — StableInstanceId is the target, never a
#                prerequisite of this one.
#   §7 reserved   — the domains of section 7 have NO row family to re-key
#                today: impl rows (the canonical impl text over ImplInfo's
#                registration data), impl-method rows, ownership place
#                texts (OwnershipFact.place_key and the place component of
#                the delta ownership row keys — digest-keyed through
#                StablePlaceId), local/value rows and the mir_functions
#                generated rows (snapshot_origin_key_text's non-Decl
#                families — digest-keyed through the four generated ids).
#                Section 7's records are the reserved identities the future
#                writers of those rows build through.
# ———————————————————————————————————————————————————————————————
# 6. Declaration lineage vs semantic fingerprint (the symbol split)
# ———————————————————————————————————————————————————————————————
# The audit's split of the def digest key "path::name#sig" into TWO
# orthogonal identities — a signature edit re-keys nothing; it changes ONE
# entity's fingerprint (an update pairing, never a remove/create pairing):
#
#   StableDeclId          — the DECLARATION: module_key (the module part of
#                           the registration key, "" at root scope),
#                           lineage_key (the whole "path::name" text) and
#                           the 128-bit digest of the LINEAGE TEXT ONLY.
#                           kind rides the record as ROW METADATA ("" from
#                           a text parse — the key grammar carries no
#                           kind; the owning row's §29 kind metadata stamps
#                           it) and never participates in Eq/Hash.
#   SignatureFingerprint  — the parsed "#sig" text of a CALLABLE def (fn /
#                           method — parse rules below) plus the digest of
#                           the FULL sig text as-is. The parse pieces are a
#                           diagnostics/rendering view; the digest words
#                           are the identity and always cover the text
#                           byte-for-byte, so a fingerprint built from a
#                           parse and a fingerprint built from the same
#                           text by the unparsed fallback agree exactly.
#   StableSymbolId        — decl + fingerprint + the full key text (the
#                           text is kept for diagnostics, rendering and
#                           ids.tg-style text verification of digest
#                           collisions at map-insert time).
#
# Eq/Hash (below) follow the id-record impl pattern of CapabilityId
# (types.tg:9073) over the DIGEST WORDS ONLY — words are the identity;
# texts are collision-detection cargo and the diagnostics surface (mirror
# of the StableDefId doctrine: a digest-keyed map insert text-verifies
# against the stored lineage/full-key text like ids.tg's stable-id
# registry, because an actual 128-bit collision is an internal failure,
# never a counter-disambiguated identity).
#
# PARSE RULES — signature_fingerprint_of_sig_text parses the canonical
# callable sig texts semantic_snapshot.tg renders (snapshot_fn_sig_text /
# snapshot_mir_fn_sig_text — semantic_snapshot.tg:422 and :434):
#
#   grammar:  "fn(" params ")->" return_type [effects]
#     params  = param ("," param)*          # the render joins with ","
#     param   = convention ":" type_text    # snapshot_conv_text words:
#                                           # "let" | "inout" | "sink" | "set"
#     effects = "" | "effects(" "e" id ("," "e" id)* ")"   # the declared
#                                           # effect ids, sorted, "e"-prefixed
#     type_text — snapshot_type_text's bracket-delimited type renders:
#       primitives ("int" .. "f64", "unit", "str" ...), Adt
#       "T[<qualified name>[arg]...]", FixedArray "A[elem;n]", the symbolic
#       "AS[elem;c<idx>]", FnPtr "F(conv:ty,...)->ret[effects]", Closure
#       "C(conv:ty,...)->ret{cap}[effects]", "Rmut[..]"/"Rref[..]",
#       "P[..]"/"Q[..]"/"D[..]", effects type "E{e...|inner}", tuples
#       "(a,b)", generic-binder references "P<idx>o<ownerNumeric>",
#       const-param references "CP<idx>", "const(v)", "var", "err".
#
#   A text parses (Option::Some) ONLY when it is exactly this callable
#   grammar. Every other def sig text — "" (a callable with no typed
#   record yet) and the type-row grammars "struct{...}", "enum{...}",
#   "trait{...}", "alias(...)" and declared-type renders — returns
#   Option::None; the symbol builders fall back to a digest-carrying
#   fingerprint with empty pieces (stable_fp_unparsed). Steps:
#     1. the text must open "fn(" at byte 0;
#     2. params = the text between "fn(" and the FIRST ")" that closes the
#        list — a depth scan over the three bracket families "()" "[]"
#        "{}"; canonical type texts are bracket-balanced, so the first
#        depth-0 close IS the list end (a naive first-"("/last-")" cut
#        would swallow the "->return" and the effects suffix);
#     3. after that close the text must continue "->" followed by a
#        non-empty return-type render;
#     4. effects = the LAST "effects(...)" group that starts at top level
#        and closes exactly at the text end (the render appends the
#        declared effects LAST, so the last balanced-to-end group is the
#        fn's own; a return type that is itself an F(...)/C(...) type
#        carrying its own trailing "effects(...)" conflates with the fn
#        suffix IN THE TEXT — documented corner; the digest covers the
#        whole text, so identity is unaffected). Everything before the
#        group is the return type;
#     5. each param splits at its FIRST ":"; the prefix must be one of the
#        four convention words (canonical renders always write it — a
#        param without it means the text is not canonical and the parse
#        fails). params collects the TYPE texts in declaration order;
#        conventions collects the convention words, ","-joined;
#     6. binder_count = the count of DISTINCT generic-binder reference
#        texts "P<idx>o<owner>" inside the param/return type texts;
#        const_params = the DISTINCT const-param reference texts "CP<idx>"
#        in first-occurrence order. The fn's own binder list is NOT part
#        of the def-key text (only is_generic row metadata records it), so
#        only REFERENCES are recoverable; a pathological module/type path
#        rendering as a digit-bearing "P"/"CP" sequence (e.g. a segment
#        "P3o5") could false-positive the token scans — advisory fields
#        only, digests unaffected;
#     7. the digest words digest the FULL sig text exactly as it appears
#        after the "#" — parse pieces never replace the text for identity.

# ———— The split records ————

# The parsed signature fingerprint of a callable def (parse rules above).
# The digest words digest the FULL "#sig" text as-is (identity authority);
# the parse pieces (conventions / params / binder_count / const_params /
# return_type / effects) are the structural view for diagnostics,
# rendering and the item-5 digest-keyed maps' equality aids — they never
# replace the text for identity.
struct SignatureFingerprint
  # The convention words of the params, ","-joined in declaration order
  # ("" for a parameterless list) — the snapshot_conv_text vocabulary
  # "let"/"inout"/"sink"/"set".
  conventions: String
  # The param TYPE texts in declaration order (each param's type part
  # after its "conv:" prefix) — the "params" grammar piece.
  params: Vec[String]
  # The count of DISTINCT generic-binder reference texts "P<idx>o<owner>"
  # inside the param/return type texts (the def-key text records binder
  # REFERENCES only — see parse rule 6).
  binder_count: Int
  # The DISTINCT const-parameter reference texts "CP<idx>", in
  # first-occurrence order (parse rule 6).
  const_params: Vec[String]
  # The return-type text (everything after the fn's "->" before the
  # effects suffix — parse rule 4).
  return_type: String
  # The effects suffix text "effects(...)" ("" when the def declares no
  # effects) — parse rule 4.
  effects: String
  digest_hi: UInt = 0   # the 128-bit stable digest of the FULL sig text
  digest_lo: UInt = 0
end

# The DECLARATION lineage identity of a def digest key: the "path::name"
# registration key, digested WITHOUT its "#sig" component (a signature
# change keeps the declaration id — same declaration, changed fingerprint,
# never a remove/create pairing).
struct StableDeclId
  # The module-path part of the lineage_key ("" for a root-scope
  # declaration) — the snapshot_key_module grammar.
  module_key: String
  # The owning row's def-kind text when the caller stamps it; "" from a
  # pure text parse (the key grammar carries no kind). Row metadata only —
  # never consulted by Eq/Hash.
  kind: String
  # The full registration lineage "path::name" — the DIGESTED text (the
  # collision-detection cargo / diagnostics surface).
  lineage_key: String
  digest_hi: UInt = 0   # the 128-bit stable digest of the lineage text
  digest_lo: UInt = 0
end

# The symbol identity of a def: its declaration lineage plus its signature
# fingerprint, with the full def digest key text kept for diagnostics,
# rendering and ids.tg-style text verification of digest collisions.
struct StableSymbolId
  decl: StableDeclId
  fingerprint: SignatureFingerprint
  full_key: String
end

# The digest-carrying fallback fingerprint: pieces empty, digest over the
# sig text as-is (the text is not canonical callable grammar — a type-row
# sig, an empty sig, or a pure-lineage advisory key's "").
def stable_fp_unparsed(sig_text: String) -> SignatureFingerprint
  let w = stable_words_of(&sig_text)
  SignatureFingerprint {
    conventions: "".to_string(),
    params: Vec::new(),
    binder_count: 0,
    const_params: Vec::new(),
    return_type: "".to_string(),
    effects: "".to_string(),
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# Parse rule 4: the LAST "effects(" ... ")" group at or after `from` that
# closes exactly at the text end (-1 when none). Scanned downward so the
# first valid candidate IS the last group. Depth starts at 1 (the group's
# own opening paren); any nested "(" increments, and the group's final ")"
# must be the balance point at the very last text byte.
def stable_fp_effects_start(s: String, from: Int) -> Int
  var j = s.len() - 8
  while j >= from do
    if s.slice(j, j + 8) == "effects(" then
      var depth = 1
      var i = j + 8
      var ok = true
      while i < s.len() do
        let ch = s.slice(i, i + 1)
        if ch == "(" then
          depth = depth + 1
        elsif ch == ")" then
          depth = depth - 1
          if depth == 0 && i != s.len() - 1 then
            ok = false
            break
          end
        end
        i = i + 1
      end
      if ok && depth == 0 then
        return j
      end
    end
    j = j - 1
  end
  -1
end

# Parse rule 5: split a param body at depth-0 commas (the body between
# "fn(" and its closing ")"). Canonical bodies are bracket-balanced, so a
# depth-0 comma is always a param separator.
def stable_fp_split_params(body: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var depth = 0
  var seg_start = 0
  var i = 0
  while i < body.len() do
    let ch = body.slice(i, i + 1)
    if ch == "(" || ch == "[" || ch == "{" then
      depth = depth + 1
    elsif ch == ")" || ch == "]" || ch == "}" then
      depth = depth - 1
    elsif ch == "," && depth == 0 then
      out.push(body.slice(seg_start, i))
      seg_start = i + 1
    end
    i = i + 1
  end
  if seg_start < body.len() then
    out.push(body.slice(seg_start, body.len()))
  end
  out
end

# Parse rule 6: the DISTINCT generic-binder reference texts "P<idx>o<owner>"
# in a type-text region, in first-occurrence order. A token is a "P" whose
# previous char is not "C" ("CP" is the const-param form) followed by
# digits, "o" and MORE digits; the scan terminates at the first non-digit
# after the owner (canonical renders never run a digit into the owner, so
# "P0o5effects(e1)" — a Param return type before the fn's effects suffix —
# still yields "P0o5"). A pathological path segment rendered in an Adt
# name (e.g. a module "P3o5") over-matches — advisory fields only (see
# parse rule 6 in the section doc).
def stable_fp_binder_tokens(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var prev = "".to_string()
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch == "P" && prev != "C" then
      var j = i + 1
      while j < text.len() && text.slice(j, j + 1) >= "0" && text.slice(j, j + 1) <= "9" do
        j = j + 1
      end
      if j > i + 1 && j < text.len() && text.slice(j, j + 1) == "o" then
        var k = j + 1
        while k < text.len() && text.slice(k, k + 1) >= "0" && text.slice(k, k + 1) <= "9" do
          k = k + 1
        end
        if k > j + 1 then
          let tok = text.slice(i, k)
          if !out.contains(&tok) then out.push(tok) end
        end
      end
    end
    prev = ch
    i = i + 1
  end
  out
end

# Parse rule 6: the DISTINCT const-param reference texts "CP<idx>" in a
# type-text region, in first-occurrence order (digits, terminating at the
# first non-digit — same termination rule as the binder scan above).
def stable_fp_const_tokens(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var i = 0
  while i < text.len() do
    if i + 2 <= text.len() && text.slice(i, i + 2) == "CP" then
      var j = i + 2
      while j < text.len() && text.slice(j, j + 1) >= "0" && text.slice(j, j + 1) <= "9" do
        j = j + 1
      end
      if j > i + 2 then
        let tok = text.slice(i, j)
        if !out.contains(&tok) then out.push(tok) end
      end
    end
    i = i + 1
  end
  out
end

# The parsed signature fingerprint of a canonical callable "#sig" text
# (parse rules above): Option::None for any text that is not exactly the
# callable grammar — use stable_fp_unparsed's fallback (or the symbol
# builders, which do) for type-row sig texts.
pub def signature_fingerprint_of_sig_text(sig_text: String) -> Option[SignatureFingerprint]
  if !sig_text.starts_with("fn(") then return Option::None end
  var depth = 1
  var i = 3
  var close_at = -1
  while i < sig_text.len() do
    let ch = sig_text.slice(i, i + 1)
    if ch == "(" || ch == "[" || ch == "{" then
      depth = depth + 1
    elsif ch == ")" || ch == "]" || ch == "}" then
      depth = depth - 1
      if depth == 0 then
        close_at = i
        break
      end
    end
    i = i + 1
  end
  if close_at < 0 then return Option::None end
  if close_at + 3 > sig_text.len() then return Option::None end
  if sig_text.slice(close_at + 1, close_at + 3) != "->" then return Option::None end
  let ret_at = close_at + 3
  let eff_at = stable_fp_effects_start(&sig_text, ret_at)
  var return_text = "".to_string()
  var effects_text = "".to_string()
  if eff_at >= 0 then
    return_text = sig_text.slice(ret_at, eff_at)
    effects_text = sig_text.slice(eff_at, sig_text.len())
  else
    return_text = sig_text.slice(ret_at, sig_text.len())
  end
  if return_text.len() == 0 then return Option::None end
  let body = sig_text.slice(3, close_at)
  let segments = stable_fp_split_params(&body)
  var conventions: Vec[String] = Vec::new()
  var types: Vec[String] = Vec::new()
  var all_types = "".to_string()
  for seg in segments do
    let cpos = stable_index_of(&seg, ":", 0)
    if cpos <= 0 then return Option::None end
    let cw = seg.slice(0, cpos)
    if cw != "let" && cw != "inout" && cw != "sink" && cw != "set" then
      return Option::None
    end
    let ty_text = seg.slice(cpos + 1, seg.len())
    if ty_text.len() == 0 then return Option::None end
    conventions.push(cw)
    types.push(ty_text.clone())
    all_types = all_types + ty_text
  end
  all_types = all_types + return_text
  let binders = stable_fp_binder_tokens(&all_types)
  let consts = stable_fp_const_tokens(&all_types)
  let w = stable_words_of(&sig_text)
  Option::Some(SignatureFingerprint {
    conventions: conventions.join(","),
    params: types,
    binder_count: binders.len(),
    const_params: consts,
    return_type: return_text,
    effects: effects_text,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The declaration identity of a def digest key "path::name#sig": the whole
# text before the FIRST "#" is the lineage ("path::name" — the
# registration-key grammar); digest ONLY the lineage text, so a signature
# change keeps the declaration id byte-identical (same declaration, new
# fingerprint — no remove/create pairing). Option::None when the text has
# no "#" or an empty lineage. kind stays "" — the key text carries no
# kind; the owning row's kind metadata stamps it (Eq/Hash never consult
# it). A composite key that EMBEDS a def key (a §33 node key
# "<fn key>#B<block>#S<idx>") parses the embedded def key's lineage — for
# the node's own function identity the caller passes the "<fn key>" part.
pub def decl_id_of_full_key(full_key: String) -> Option[StableDeclId]
  let i = stable_index_of(&full_key, "#", 0)
  if i <= 0 then return Option::None end
  let lineage = full_key.slice(0, i)
  let mkey = stable_key_module(&lineage)
  let w = stable_words_of(&lineage)
  Option::Some(StableDeclId {
    module_key: mkey,
    kind: "".to_string(),
    lineage_key: lineage,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# The symbol identity of a def digest key: its declaration lineage id plus
# the signature fingerprint of its "#sig" component (parsed when the
# component is canonical callable grammar, digest-carrying fallback
# otherwise). Option::None when the key is not def-shaped (no "#" or an
# empty lineage).
pub def stable_symbol_id_of_full_key(full_key: String) -> Option[StableSymbolId]
  let i = stable_index_of(&full_key, "#", 0)
  if i <= 0 then return Option::None end
  let sig_text = full_key.slice(i + 1, full_key.len())
  let decl = match decl_id_of_full_key(&full_key)
    when Option::Some(d) then d
    when Option::None then return Option::None
  end
  let fingerprint = match signature_fingerprint_of_sig_text(&sig_text)
    when Option::Some(f) then f
    when Option::None then stable_fp_unparsed(&sig_text)
  end
  Option::Some(StableSymbolId {
    decl: decl,
    fingerprint: fingerprint,
    full_key: full_key.clone()
  })
end

# ———————————————————————————————————————————————————————————————
# The Eq/Hash implementations (the id-record impl pattern — CapabilityId,
# types.tg:9073): equality and hashing over the DIGEST WORDS ONLY. The
# stored texts (module_key / lineage_key / kind / full_key and the
# fingerprint parse pieces) are the collision-detection cargo and the
# diagnostics surface — a digest-keyed map insert text-verifies against
# them (ids.tg's stable-id registry doctrine).
# ———————————————————————————————————————————————————————————————

impl Eq for StableDeclId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableDeclId
  # The two digest words folded through the unsigned 64-bit view (the
  # ProjectionChain hash fold, types.tg:2906): unsigned arithmetic wraps,
  # so the signed +-*-trap never fires inside the hash.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for StableSymbolId
  # Equality over BOTH digest pairs: the declaration words and the
  # fingerprint words (same lineage text AND same sig text ⟺ equal full
  # key text, up to an actual 128-bit collision — detectable against the
  # stored full_key at insert, never counter-disambiguated).
  def eq(self: Self, other: Self) -> Bool
    self.decl.digest_hi == other.decl.digest_hi &&
    self.decl.digest_lo == other.decl.digest_lo &&
    self.fingerprint.digest_hi == other.fingerprint.digest_hi &&
    self.fingerprint.digest_lo == other.fingerprint.digest_lo
  end
end

impl Hash for StableSymbolId
  # The four digest words (declaration hi/lo, fingerprint hi/lo) folded
  # through the unsigned 64-bit view — the same fold as StableDeclId's
  # hash, over both digests.
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.decl.digest_hi) as Int
    h = ((h as UInt) * 31 + self.decl.digest_lo) as Int
    h = ((h as UInt) * 31 + self.fingerprint.digest_hi) as Int
    h = ((h as UInt) * 31 + self.fingerprint.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# 7. Impl, place/value and generated-executable identities (audit item 7)
# ———————————————————————————————————————————————————————————————
# The section-6 shape — piece-carrying records whose digest words digest
# the CANONICAL composite key text (identity is a pure function of the
# text; the stored pieces are collision-detection cargo / the diagnostics
# surface) — over domains NO §29-§37 row family materializes today. The
# canonical texts are defined against the producers that already exist:
#
#   StableImplId / StableImplMethodId — an IMPL declaration and one of its
#     methods, over types.tg ImplInfo's registration data:
#       impl-text = trait_key "|" self_pattern "|" binder_text "|" predicate_text
#     trait_key      — the trait's def digest key text
#                      ("path::Trait#trait{...}"); "" for an INHERENT impl
#                      (ImplInfo.trait_id is TraitId(-1)).
#     self_pattern   — the canonical type text of ImplInfo.for_type (the
#                      snapshot_type_text grammar of the §6 parse doc).
#     binder_text    — ImplInfo.generic_params in DECLARATION order, each
#                      the type-text Param reference "P<idx>o<owner>",
#                      ","-joined (positional, never sorted).
#     predicate_text — ImplInfo.obligations in registration order, each
#                      "<subject text>:<trait def key>[<arg texts>]"
#                      (args ","-joined; "[]" when none), ","-joined —
#                      the FINAL component, like the §31 contract clause.
#     A METHOD's key text = impl-text "#" method name (the declared NAME
#     the ImplInfo.methods entries register under), digested whole.
#     Parse corner: a canonical component carrying an effects TYPE
#     "E{...|...}" holds '|', and the text-parse (first three '|'s)
#     mis-splits such a component — digests cover the SAME canonical text
#     a writer produces, so identity is unaffected (no impl rows exist).
#
#   StableLocalId / StablePlaceId — one LOCAL slot of a lowered function,
#     and one PLACE of its ownership rows. The canonical place text IS the
#     row text semantic_snapshot.tg's ownership builder emits
#     (snapshot_place_key): the base local's name text (a DECLARED name or
#     the "l<ordinal>" locator of an unnamed slot — snapshot_local_name's
#     grammar), then the projection segments in order: "." name (a Field
#     or Variant — both render the declaration name; the text cannot tell
#     them apart), "." digits (a TupleIndex), "[" name "]" (a dynamic
#     ProjIndex), "[" digits "]" (a ProjConstantIndex), "*" (a ProjDeref).
#     stable_place_of_text parses EXACTLY that grammar into the advisory
#     chain (kind words Field / Tuple / Index / Deref; a name-only segment
#     — a field/variant name or a dynamic-index local — carries index -1).
#     The root's function_key is ROW METADATA ("" from a text parse — a
#     place text is function-scoped): diagnostics / text verification
#     only, never Eq/Hash. Local digest = the name text; place digest =
#     the full place text.
#
#   StableValueId — a VALUE row (reserved: no snapshot family renders
#     value rows today). kind = the producing row's value-family word;
#     digest text = kind "|" text.
#
#   StableDropGlueId / StableClosureId / StableDerivedBodyId /
#   StableShimId — the GENERATED-EXECUTABLE rows of the mir_functions
#     MirOrigin classifier (snapshot_origin_key_text's non-Decl families):
#     key IS the row key text the classifier emits — "drop-glue::<type
#     key>", "closure::<emission key>", "derived::<kind>::<key>",
#     "shim::<surface key>" — byte-identical with the rows. Constructors
#     take the ORIGIN piece: the drop-glue type key (the concrete type
#     identity key text of mir_type_identity_key's grammar, the
#     MirOrigin::DropGlue payload), the closure emission name, the derived
#     kind + emission key, the shim's extern surface name.
#
# Eq/Hash follow the section-6 doctrine over the digest words ONLY.

# An IMPL declaration: the impl-text pieces over the ImplInfo registration
# data plus the digest of the full impl text (grammar above).
struct StableImplId
  trait_key: String
  self_pattern: String
  binder_text: String
  predicate_text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE method of an impl: the impl record plus the method's declared name;
# the digest words cover impl-text "#" method name whole. (The field is
# impl_id — "impl" is a keyword token, not an identifier.)
struct StableImplMethodId
  impl_id: StableImplId
  method_key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE local slot of a lowered function: name = the local's canonical name
# text (snapshot_local_name's grammar); function_key = row metadata of the
# owning function's canonical key (its def digest key, or the origin row
# key text of §7's generated ids for a synthesized body) — "" from a text
# parse; never consulted by Eq/Hash. The digest words digest the NAME text.
struct StableLocalId
  function_key: String
  name: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE projection segment of a place chain (the advisory parse view): kind
# is the word of the segment's text shape — "Field" (a "." name segment;
# also a variant — the texts are byte-identical), "Tuple" (a "." digits
# segment), "Index" (a bracket segment) or "Deref" (a "*" segment).
# index is the numeric payload the text carries (the tuple position, the
# constant index) and -1 when the segment is name-only in the text (a
# field/variant name, a dynamic-index local) — the name bytes stay covered
# by the place digest.
struct StableProjection
  kind: String
  index: Int = -1
end

# ONE place of a function's ownership rows: root = the base local, the
# projections = the parsed chain, and the digest words of the FULL place
# text (byte-for-byte — parse pieces never replace the text for identity).
struct StablePlaceId
  root: StableLocalId
  projections: Vec[StableProjection] = Vec::new()
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE value row (reserved grammar — no snapshot family renders value rows
# today): kind = the value-family word of the producing row, text = the
# canonical value text; the digest words digest kind "|" text.
struct StableValueId
  kind: String
  text: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The four generated-executable ids: key = the mir_functions origin ROW
# key text of snapshot_origin_key_text's non-Decl families (prefixes keep
# the families disjoint from user emission names forever), digest words
# over that key text.
struct StableDropGlueId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableClosureId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableDerivedBodyId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

struct StableShimId
  key: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ———— The impl-text builder and accessor ————

# The impl record of an impl declaration's registration data: the pieces
# are canonical as documented above (the row writer renders them from
# ImplInfo); the digest words digest the full impl text
# "trait_key|self_pattern|binder_text|predicate_text".
pub def stable_impl_id_of(
  trait_key: String,
  self_pattern: String,
  binder_text: String,
  predicate_text: String
) -> StableImplId
  let text = trait_key + "|" + self_pattern + "|" + binder_text + "|" + predicate_text
  let w = stable_words_of(&text)
  StableImplId {
    trait_key: trait_key,
    self_pattern: self_pattern,
    binder_text: binder_text,
    predicate_text: predicate_text,
    digest_hi: w.0,
    digest_lo: w.1
  }
end

# The impl record of an impl-text key: Option::None for any text that is
# not exactly the four-component impl-text grammar — three "|" separators,
# a trait part that is empty (an inherent impl) or a def digest key, and a
# NON-EMPTY self part (binders and predicates may be empty — an empty
# binder list and an impl with no obligations render empty segments). The
# digest words digest the key text as given.
pub def stable_impl_of_key(key: String) -> Option[StableImplId]
  let i1 = stable_index_of(key, "|", 0)
  if i1 < 0 then return Option::None end
  let trait_part = key.slice(0, i1)
  if trait_part.len() > 0 && !stable_def_key_shape(&trait_part) then
    return Option::None
  end
  let i2 = stable_index_of(key, "|", i1 + 1)
  if i2 < 0 then return Option::None end
  let i3 = stable_index_of(key, "|", i2 + 1)
  if i3 < 0 then return Option::None end
  let self_part = key.slice(i1 + 1, i2)
  if self_part.len() == 0 then return Option::None end
  let binder_part = key.slice(i2 + 1, i3)
  let pred_part = key.slice(i3 + 1, key.len())
  let w = stable_words_of(&key)
  Option::Some(StableImplId {
    trait_key: trait_part,
    self_pattern: self_part,
    binder_text: binder_part,
    predicate_text: pred_part,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# ———— The place-text parse (the snapshot_place_key grammar) ————

# The end of a NAME RUN of a canonical place text starting at `from`: a
# maximal run of bytes that are not place-structure bytes (".", "[", "]",
# "*" — ASCII bytes no identifier/locator text carries; multi-byte XID
# identifier bytes pass through). Returns `from` when the run is empty.
def stable_place_run_end(s: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "." || ch == "[" || ch == "]" || ch == "*" then
      return i
    end
    i = i + 1
  end
  i
end

# The place record of a canonical place text (snapshot_place_key's
# grammar — see the section doc): Option::None for any text that is not
# exactly the grammar — the empty "no place" marker, an empty or
# bare-digit root (a local root is a name or an "l<ordinal>" locator,
# never a digit run), an empty dot/bracket segment, an unclosed bracket,
# a stray "]" or any byte outside a segment. The advisory chain uses the
# kind words Field / Tuple / Index / Deref (the projection text shapes of
# the section doc). The digest words digest the FULL place text as given.
pub def stable_place_of_text(place_text: String) -> Option[StablePlaceId]
  if place_text.len() == 0 then return Option::None end
  let root_end = stable_place_run_end(&place_text, 0)
  if root_end == 0 then return Option::None end
  let root_text = place_text.slice(0, root_end)
  if stable_is_digits(&root_text) then return Option::None end
  var projs: Vec[StableProjection] = Vec::new()
  var pos = root_end
  var ok = true
  while pos < place_text.len() && ok do
    let ch = place_text.slice(pos, pos + 1)
    if ch == "*" then
      projs.push(StableProjection { kind: "Deref".to_string(), index: -1 })
      pos = pos + 1
    elsif ch == "." then
      pos = pos + 1
      let seg_end = stable_place_run_end(&place_text, pos)
      if seg_end == pos then
        ok = false
      else
        let seg = place_text.slice(pos, seg_end)
        if stable_is_digits(&seg) then
          projs.push(StableProjection { kind: "Tuple".to_string(), index: stable_text_to_int(&seg) })
        else
          projs.push(StableProjection { kind: "Field".to_string(), index: -1 })
        end
        pos = seg_end
      end
    elsif ch == "[" then
      pos = pos + 1
      let seg_end = stable_place_run_end(&place_text, pos)
      if seg_end == pos then
        ok = false
      else
        let seg = place_text.slice(pos, seg_end)
        if seg_end >= place_text.len() || place_text.slice(seg_end, seg_end + 1) != "]" then
          ok = false
        else
          if stable_is_digits(&seg) then
            projs.push(StableProjection { kind: "Index".to_string(), index: stable_text_to_int(&seg) })
          else
            projs.push(StableProjection { kind: "Index".to_string(), index: -1 })
          end
          pos = seg_end + 1
        end
      end
    else
      ok = false
    end
  end
  if !ok || pos != place_text.len() then return Option::None end
  let wroot = stable_words_of(&root_text)
  let w = stable_words_of(&place_text)
  Option::Some(StablePlaceId {
    root: StableLocalId {
      function_key: "".to_string(),
      name: root_text,
      digest_hi: wroot.0,
      digest_lo: wroot.1
    },
    projections: projs,
    digest_hi: w.0,
    digest_lo: w.1
  })
end

# ———— The generated-executable constructors (the origin row-key texts) ————

# The drop-glue row of one concrete type: key = "drop-glue::<type key>"
# where type_key is the concrete type identity key text the glue body
# registered under (mir_type_identity_key's grammar — the MirOrigin::
# DropGlue payload; the emission-name fallback text of the classifier is
# also accepted — the id mirrors the row key either way).
pub def stable_drop_glue_id_of_type_key(type_key: String) -> StableDropGlueId
  let key = "drop-glue::" + type_key
  let w = stable_words_of(&key)
  StableDropGlueId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The closure row of one lowered closure body: key = "closure::<emission
# key>" (the MirOrigin::Closure emission name, e.g. "_closure<counter>").
pub def stable_closure_id_of(emission_key: String) -> StableClosureId
  let key = "closure::" + emission_key
  let w = stable_words_of(&key)
  StableClosureId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The derived row of one synthesized body: key = "derived::<kind>::<key>"
# (MirOrigin::Derived — kind word "effect-dispatcher", key = the emission
# name).
pub def stable_derived_body_id_of(kind_text: String, key_text: String) -> StableDerivedBodyId
  let key = "derived::" + kind_text + "::" + key_text
  let w = stable_words_of(&key)
  StableDerivedBodyId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# The shim row of one bodyless extern declaration: key = "shim::<surface
# key>" (MirOrigin::Shim — the extern surface name).
pub def stable_shim_id_of(surface_key: String) -> StableShimId
  let key = "shim::" + surface_key
  let w = stable_words_of(&key)
  StableShimId { key: key, digest_hi: w.0, digest_lo: w.1 }
end

# ———— The Eq/Hash implementations (the section-6 fold: digest words
# ONLY — the stored pieces are collision-detection cargo) ————
# Equality of an impl id is the digest pair of the full impl text (the
# pieces re-verify an actual collision against trait_key / self_pattern /
# binder_text / predicate_text at insert — never counter-disambiguated).

impl Eq for StableImplId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableImplId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

