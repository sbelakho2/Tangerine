# ———— The Eq/Hash implementations (the section-6 fold: digest words
# ONLY — the stored pieces are collision-detection cargo) ————
# Equality of an impl id is the digest pair of the full impl text (the
# pieces re-verify an actual collision against trait_key / self_pattern /
# binder_text / predicate_text at insert — never counter-disambiguated).

impl Eq for StableImplId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableImplId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

impl Eq for StableImplMethodId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

