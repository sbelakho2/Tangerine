impl Clone for StableBinderId
  def clone(self: Self) -> StableBinderId
    StableBinderId {
      owner_function: self.owner_function.clone(),
      binder_lineage: self.binder_lineage.clone(),
      binder_seq: self.binder_seq,
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

