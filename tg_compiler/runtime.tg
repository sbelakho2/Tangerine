# Tangerine Compiler — Runtime Library
# Full implementations of runtime functions for stdlib intrinsics
#
# This module contains the complete implementations of:
# - Array/Vec operations (dynamic arrays with growth)
# - Map operations (hash table with open addressing)
# - Set operations (hash set)
# - Memory allocation (mmap-based heap)
# - String conversion (int/float to string)
# - I/O operations

use std::core::{Option, Result, panic}
use tg_compiler::asm::{
  CodeBuffer, buf_new, buf_pos, align_to, emit8, emit32_le, emit64_le,
  def_label, add_reloc, add_symbol, RelocKind,
  AsmSymbol, Section, SymBinding, SymKind,
  Arch, OsAbi, AsmTarget,
  X64, A64,
  x64_mov_ri, x64_mov_rr, x64_mov_rm, x64_mov_mr, x64_mov_m8_r8, x64_mov_m16_r16, x64_mov_m32_r32,
  x64_movzx_r64_m8, x64_movzx_r64_m16, x64_mov_r32_m32,
  x64_add_rr, x64_add_ri, x64_sub_rr, x64_sub_ri,
  x64_imul_rr, x64_cqo, x64_idiv_r,
  x64_and_rr, x64_or_rr, x64_xor_rr, x64_and_ri,
  x64_cmp_rr, x64_cmp_ri, x64_test_rr,
  x64_jmp, x64_jcc, x64_call_label, x64_call_r, x64_call_extern,
  x64_ret, x64_push, x64_pop, x64_sub_ri, x64_shl_ri, x64_shr_ri, x64_cmova_rr,
  x64_lea_mem, x64_syscall, x64_ud2, x64_neg_r,
  a64_mov_ri, a64_mov_rr, a64_add_rrr, a64_add_rri,
  a64_sub_rrr, a64_sub_rri, a64_mul_rrr,
  a64_and_rrr, a64_orr_rrr, a64_eor_rrr,
  a64_cmp_rr, a64_cmp_ri,
  a64_ldr, a64_str, a64_ldur, a64_stur,
  a64_ldrb, a64_strb, a64_ldrh, a64_strh, a64_ldr_w, a64_str_w,
  a64_ldr_post, a64_stp_pre, a64_ldp_post,
  a64_bl, a64_blr, a64_ret, a64_b, a64_bcond, a64_brk,
  a64_svc, a64_udf, a64_nop, a64_lsl, a64_lsl_rrr,
  a64_sdiv_rrr, a64_udiv, a64_msub, a64_csel, a64_add_rrr_lsl, a64_lsr,
  a64_cc_eq, a64_cc_ne, a64_cc_lt, a64_cc_le, a64_cc_gt, a64_cc_ge, a64_cc_cs, a64_cc_cc,
  a64_neg, a64_code, CC
}

# ———————————————————————————————————————————————————————————————
# Runtime Emission Context
# ———————————————————————————————————————————————————————————————

struct RuntimeEmitCtx
  text: CodeBuffer
  target: AsmTarget
  lbl_counter: Int
end

def runtime_ctx_new(target: AsmTarget) -> RuntimeEmitCtx
  RuntimeEmitCtx {
    text: buf_new(),
    target: target,
    lbl_counter: 0
  }
end

def fresh_label(ctx: &mut RuntimeEmitCtx, prefix: String) -> String
  let lbl = prefix + "." + ctx.lbl_counter.to_string()
  ctx.lbl_counter = ctx.lbl_counter + 1
  lbl
end

# Emit both a label (for fixup resolution) AND a symbol (for linker resolution).
# This is required for all named runtime functions so the linker can find them.
def def_runtime_fn(ctx: &mut RuntimeEmitCtx, name: String) -> Unit
  # Align function start to 4 bytes (required for ARM64 instruction alignment)
  align_to(&mut ctx.text, 4, ctx.target.arch)
  let offset = buf_pos(&ctx.text)
  add_symbol(&mut ctx.text, AsmSymbol {
    name: name.clone(),
    section: Section::Text,
    offset: offset,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  def_label(&mut ctx.text, name)
end

# ———————————————————————————————————————————————————————————————
# Emit All Runtime Functions
# ———————————————————————————————————————————————————————————————

def emit_all_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_array_runtime(ctx)
  emit_map_runtime(ctx)
  emit_memory_runtime(ctx)
  emit_string_conv_runtime(ctx)
  emit_intrinsic_runtime(ctx)
  emit_arg_runtime(ctx)
  emit_posix_runtime(ctx)
  emit_bump_alloc_runtime(ctx)
end

# ———————————————————————————————————————————————————————————————
# Intrinsic Runtime Implementation (abort, longjmp, etc.)
# ———————————————————————————————————————————————————————————————

def emit_intrinsic_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_intrinsic_abort(ctx)
  emit_tg_intrinsic_setjmp(ctx)
  emit_tg_intrinsic_longjmp(ctx)
  emit_tg_get_argc(ctx)
  emit_tg_get_argv(ctx)
  emit_tg_get_envp(ctx)
end

# __intrinsic_abort: Abort execution with trap
def emit_tg_intrinsic_abort(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_abort")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# __intrinsic_setjmp(jmp_buf: Ptr[u8]) -> Int
# Save callee-saved registers + SP + return address into jmp_buf.
# Returns 0 on the initial call; when longjmp restores, setjmp returns
# the value passed to longjmp (or 1 if the value was 0).
#
# jmp_buf layout for AArch64 (13 × 8 = 104 bytes):
#   [0]   X19   [8]  X20   [16] X21   [24] X22
#   [32]  X23   [40] X24   [48] X25   [56] X26
#   [64]  X27   [72] X28   [80] FP    [88] LR
#   [96]  SP
#
# jmp_buf layout for x86_64 (8 × 8 = 64 bytes):
#   [0]  RBX  [8]  RBP  [16] R12  [24] R13
#   [32] R14  [40] R15  [48] RSP  [56] RIP (return address)
def emit_tg_intrinsic_setjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_setjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf pointer
    a64_str(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_str(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_str(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_str(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_str(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_str(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_str(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_str(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_str(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_str(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_str(&mut ctx.text, A64::LR, A64::X0, 88)
    # Store SP: MOV X9, SP; STR X9, [X0, #96]
    a64_mov_rr(&mut ctx.text, A64::X9, A64::SP)
    a64_str(&mut ctx.text, A64::X9, A64::X0, 96)
    # Return 0
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf pointer
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RBX)
    x64_mov_mr(&mut ctx.text, X64::RDI, 8, X64::RBP)
    x64_mov_mr(&mut ctx.text, X64::RDI, 16, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::RDI, 24, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RDI, 32, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::RDI, 40, X64::R15)
    # Save RSP (after call = RSP + 8, since CALL pushed return address)
    x64_lea_mem(&mut ctx.text, X64::RAX, X64::RSP, 8)
    x64_mov_mr(&mut ctx.text, X64::RDI, 48, X64::RAX)
    # Save return address (at [RSP])
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, 56, X64::RAX)
    # Return 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# __intrinsic_longjmp(jmp_buf: Ptr[u8], val: Int)
# Restore callee-saved registers + SP + return address from jmp_buf,
# then return to the setjmp call site with val (or 1 if val == 0).
def emit_tg_intrinsic_longjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_longjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf, X1 = val
    # Ensure val != 0 (longjmp(buf, 0) must return 1)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    # CSINC W1, W1, WZR, NE → if X1 == 0 then X1 = 1 else X1 = X1
    # 0x1A9F1421: verified as CSINC W1, W1, WZR, NE (0x5A9F1421 disassembles
    # to CSNEG W1, W1, WZR, NE — which maps longjmp(buf, 0) to 0, not 1)
    emit32_le(&mut ctx.text, 0x1A9F1421)  # CSINC W1, W1, WZR, NE
    # Restore callee-saved registers
    a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_ldr(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_ldr(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_ldr(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_ldr(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_ldr(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_ldr(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_ldr(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_ldr(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_ldr(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_ldr(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_ldr(&mut ctx.text, A64::LR, A64::X0, 88)
    # Restore SP
    a64_ldr(&mut ctx.text, A64::X9, A64::X0, 96)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::X9)
    # Return val
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf, RSI = val
    # Ensure val != 0
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    # if RSI == 0 then RSI = 1
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    # CMOVNZ RAX, RSI → RAX = (RSI != 0) ? RSI : 1
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x45)
    emit8(&mut ctx.text, 0xC6)  # cmovnz rax, rsi
    # Restore callee-saved regs
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RDI, 8)
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 16)
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RDI, 24)
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RDI, 32)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RDI, 40)
    # Restore RSP
    x64_mov_rm(&mut ctx.text, X64::RSP, X64::RDI, 48)
    # Jump to saved return address  
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 56)
    # JMP RCX
    emit8(&mut ctx.text, 0xFF)
    emit8(&mut ctx.text, 0xE1)  # jmp rcx
  end
end

def emit_load_data_global(ctx: &mut RuntimeEmitCtx, sym_name: String) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # ADRP X0, sym@PAGE
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, sym_name.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000)
    # ADD X0, X0, sym@PAGEOFF
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, sym_name, 0)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 0)
    # LDR X0, [X0]
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # LEA RAX, [RIP + sym]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8D)
    emit8(&mut ctx.text, 0x05)
    add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, sym_name, -4)
    emit32_le(&mut ctx.text, 0)
    # MOV RAX, [RAX]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_get_argc(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argc")
  emit_load_data_global(ctx, "_tg_saved_argc".to_string())
end

def emit_tg_get_argv(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argv")
  emit_load_data_global(ctx, "_tg_saved_argv".to_string())
end

def emit_tg_get_envp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_envp")
  emit_load_data_global(ctx, "_tg_saved_envp".to_string())
end

# _tg_cstring_new: Wrap a native C string pointer into a CString value.
# CString is a single pointer field at the native ABI, so this is an identity helper.
# Args: x0/rdi = C string pointer (a Tangerine String value)
# Returns: x0/rax = same pointer value, reinterpreted as CString
def emit_tg_cstring_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_cstring_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_bytes: Convert a C string to a Vec[u8] of its bytes.
# The Vec is a genuine Vec[u8]: stride 1 in the header, bytes stored
# CONTIGUOUSLY (data + i*1) — byte-exact consumers (indexing, as_bytes)
# read 1-byte slots.
# Args: x0/rdi = C string pointer (null-terminated)
# Returns: x0/rax = Vec pointer ({data:0, len:8, cap:16, stride:24})
def emit_tg_string_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_bytes")

  let lbl_len = fresh_label(ctx, ".Lsb_len")
  let lbl_lendone = fresh_label(ctx, ".Lsb_lendone")
  let lbl_sizeok = fresh_label(ctx, ".Lsb_sizeok")
  let lbl_copy = fresh_label(ctx, ".Lsb_copy")
  let lbl_copydone = fresh_label(ctx, ".Lsb_copydone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    # x19 = C string pointer
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)

    # strlen → x20
    a64_mov_ri(&mut ctx.text, A64::X20, 0)
    def_label(&mut ctx.text, lbl_len.clone())
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X19, A64::X20)
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_cmp_ri(&mut ctx.text, A64::X2, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_lendone.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
    a64_b(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    # Allocate Vec struct (32-byte header: data/len/cap/stride)
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # Allocate data buffer: len bytes (min 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_cmp_ri(&mut ctx.text, A64::X0, 8)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_sizeok.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    def_label(&mut ctx.text, lbl_sizeok.clone())
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)

    # Set Vec fields
    a64_stur(&mut ctx.text, A64::X22, A64::X21, 0)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 8)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 16)
    a64_mov_ri(&mut ctx.text, A64::X24, 1)  # u8 stride = 1
    a64_stur(&mut ctx.text, A64::X24, A64::X21, 24)

    # Copy bytes contiguously: data[i] = string[i]
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X19, A64::X23)
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X23)
     a64_strb(&mut ctx.text, A64::X2, A64::X1, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())

    # Return Vec pointer
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # string ptr

    # strlen → r12
    x64_mov_ri(&mut ctx.text, X64::R12, 0)
    def_label(&mut ctx.text, lbl_len.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_lendone.clone())
    x64_add_ri(&mut ctx.text, X64::R12, 1)
    x64_jmp(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    # Allocate Vec struct (32-byte header)
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # vec

    # Allocate data buffer: len bytes (min 8)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_cmp_ri(&mut ctx.text, X64::RDI, 8)
    x64_jcc(&mut ctx.text, CC::GE, lbl_sizeok.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    def_label(&mut ctx.text, lbl_sizeok.clone())
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # data

    # Set Vec fields
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::R15, 1)  # u8 stride = 1
    x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::R15)

    # Copy bytes contiguously: data[i] = string[i]; r15 = cursor into data
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R14)
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_ri(&mut ctx.text, X64::R12, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_copydone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RBX, 0)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov byte [r15], al
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_sub_ri(&mut ctx.text, X64::R12, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())

    # Return Vec pointer
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# Argument/process helper runtime emitters.
def emit_arg_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_env_count(ctx)
  emit_tg_str_skip(ctx)
  emit_tg_arg(ctx)
  emit_tg_arg_copy(ctx)
  emit_tg_env_entry(ctx)
  emit_tg_args_vec(ctx)
  emit_tg_effect_record(ctx)
  emit_tg_status(ctx)
  emit_tg_output(ctx)
  emit_tg_stdout_string(ctx)
  emit_tg_stderr_string(ctx)
end

# __tg_effect_record: Record an effect (name, value) in the effect log.
# UNSUPPORTED agentic hook: no effect-log implementation exists. MirEffectRecord
# is never constructed by source lowering (agentic-only), so this is reached
# only by a future agentic compile — fail closed with a trap instead of
# fabricating a record. The MirBudgetConsume data symbols (__tg_budget_*)
# likewise have no definitions and fail closed at link time if emitted.
def emit_tg_effect_record(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__tg_effect_record")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_env_count: Count environment variable entries (envp array length).
# Returns: number of envp entries before the NULL terminator.
def emit_tg_env_count(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_count")

  let lbl_loop = fresh_label(ctx, ".Lenvcount_loop")
  let lbl_done = fresh_label(ctx, ".Lenvcount_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "tg_get_envp")
    # X0 = envp pointer (array of char* pointers)
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_add_rrr_lsl(&mut ctx.text, A64::X10, A64::X0, A64::X9, 3)  # X10 = envp + counter * 8
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # X10 = envp[counter]
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)  # return count

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_call_label(&mut ctx.text, "tg_get_envp")
    # RAX = envp pointer
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RCX)
    x64_shl_ri(&mut ctx.text, X64::RBX, 3)
    x64_add_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg: Get command line argument at index.
# Args: x0/rdi = index
# Returns: raw char* from argv (String = C string at ABI level)
# Returns NULL if index is out of bounds (index < 0 || index >= argc)
def emit_tg_arg(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg")

  let lbl_valid = fresh_label(ctx, ".Larg_valid")
  let lbl_done = fresh_label(ctx, ".Larg_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    # Save index to X19
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    
    # Bounds check: if index < 0, return NULL
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_cmp_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    
    # Valid index: get argv[index]
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_b(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (String = C string at ABI level)

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    # Save index to RBX
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    
    # Bounds check: if index < 0, return NULL
    x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
    x64_jcc(&mut ctx.text, CC::L, lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
    x64_cmp_rr(&mut ctx.text, X64::RBX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    
    # Valid index: get argv[index]
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_jmp(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (String = C string at ABI level)

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg_copy: Get command line argument at index and copy it into
# a bump-allocated owned C string.
def emit_tg_arg_copy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg_copy")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "_tg_arg")
    a64_bl(&mut ctx.text, "_tg_string_bytes")
    a64_bl(&mut ctx.text, "_tg_string_from_bytes")

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)

    x64_call_label(&mut ctx.text, "_tg_arg")
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_bytes")
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_from_bytes")

    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_env_entry: Get environment variable entry at index.
# Args: x0/rdi = index
# Returns: raw char* from envp (null if past end), e.g. "KEY=value"
# _tg_str_skip(str: Ptr[u8], offset: Int) -> Ptr[u8]
# Returns str + offset (pointer arithmetic on C string)
def emit_tg_str_skip(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_skip")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_env_entry(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_entry")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bl(&mut ctx.text, "tg_get_envp")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # Return raw char* pointer or NULL

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    x64_call_label(&mut ctx.text, "tg_get_envp")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_args_vec: Get all command line arguments as Vec[String]
# Returns: Vec ptr containing Tangerine String values
def emit_tg_args_vec(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_args_vec")

  let lbl_loop = fresh_label(ctx, ".Largsvec_loop")
  let lbl_done = fresh_label(ctx, ".Largsvec_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue — save callee-saved registers we use
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    # Create empty Vec → x19 (elements are String values = 8-byte pointers)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)  # element stride
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)

    # Get argc → x20
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)

    # Get argv → x21
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # i = 0
    a64_mov_ri(&mut ctx.text, A64::X22, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    # if i >= argc → done
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())

    # x1 = argv[i] : load from [x21 + x22*8]
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X21, A64::X22, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # Raw char* is the String value (String = C string at ABI level)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)

    # _tg_array_push(vec, string)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    # i++
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    # Return the Vec
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)

    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    # Create empty Vec → rbx (elements are String values = 8-byte pointers)
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)  # element stride
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)

    # Get argc → r12
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)

    # Get argv → r13
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

    # i = 0
    x64_mov_ri(&mut ctx.text, X64::R14, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())

    # rsi = argv[i]
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RAX, 0)
    # Raw char* is the String value (String = C string at ABI level)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)

    # _tg_array_push(vec, string)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)

    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_from_bytes: Convert a Vec buffer (String-builder char Vec or a
# Vec[u8]) into a null-terminated runtime String.
# Args: x0/rdi = Vec pointer ({data:0, len:8, cap:16, stride:24}). Each slot
# holds one character code point as the value word (width = stride: 1 byte
# for Vec[u8], 4 for the Char Vec, 8 for legacy 8-byte slots); the LOW byte
# of each word is the UTF-8 byte emitted.
# Returns: x0/rax = pointer to a newly allocated null-terminated byte buffer.
def emit_tg_string_from_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_from_bytes")

  let lbl_copy = fresh_label(ctx, ".Lsfb_copy")
  let lbl_done = fresh_label(ctx, ".Lsfb_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 0)  # data ptr
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24) # stride (header authority)

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # dst ptr

    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    # word value = [data + i*stride] with width = stride; emit its low byte
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X23, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X21, A64::X10)
    emit_a64_load_width(ctx, A64::X11, A64::X10, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X23)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X20)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 8)  # len
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 0)  # data ptr

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # start ptr
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # cursor
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBX, 24)  # stride (header authority)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)          # i

    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    # word value = [data + i*stride] with width = stride; emit its low byte
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    emit_x64_load_width(ctx, X64::RAX, X64::RAX, X64::R8)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_status: Run a command and get exit status
# Args: x0/rdi = command string ptr
# Returns: exit code (Int)
# UNSUPPORTED: subprocess execution (fork/exec/wait) is not implemented in
# the runtime. Fail closed with a trap instead of fabricating success (0).
def emit_tg_status(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_status")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_output: Run a command and capture output
# Args: x0/rdi = command string ptr
# Returns: output string ptr
# UNSUPPORTED: command execution with output capture (pipe + fork + exec +
# read) is not implemented in the runtime. Fail closed with a trap instead
# of fabricating an empty string.
def emit_tg_output(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_output")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_stdout_string: Capture stdout as string
# Returns: string ptr
# UNSUPPORTED: delegates to _tg_output, which fails closed (trap) until
# command-output capture is implemented — no fabricated empty string.
def emit_tg_stdout_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stdout_string")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_stderr_string: Capture stderr as string
# Returns: string ptr
# UNSUPPORTED: delegates to _tg_output, which fails closed (trap) until
# command-output capture is implemented — no fabricated empty string.
def emit_tg_stderr_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stderr_string")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Array/Vec Runtime Implementation
# ———————————————————————————————————————————————————————————————
#
# Vec[T] layout (32 bytes — the HeapVecHeader row of the engine's F2 table,
# repr_header_size(Repr::HeapVecHeader); field offsets from
# container_field_offset):
#   [ptr+0]:  data   - pointer to the element buffer
#   [ptr+8]:  len    - current length (number of elements)
#   [ptr+16]: cap    - allocated capacity (number of element slots)
#   [ptr+24]: stride - element stride in bytes; set at creation from the
#                      CONCRETE element type (element_stride_bytes(T)):
#                      1/2/4/8 for immediate scalars, 8 for
#                      pointer-represented values, align_up(size, align)
#                      for fixed-array elements. EVERY element address is
#                      data + index*stride and every allocation is
#                      cap*stride bytes.
#
# Element VALUE word: each slot holds the value word (<= 8 bytes) — the
# scalar value (u8/i32/... width = min(stride,8)) or the pointer/handle for
# pointer-represented values (width 8). The store/load width is derived
# from the header stride by the width rule: stride in {1,2,4,8} -> stride,
# else 8 (fixed-array slots keep the 8-byte value word the codegen's
# ProjIndex reads).
#
# Initial capacity: 8 elements
# Growth factor: 2x

# Width-dispatch STORE: [addr] = value, width from stride.
# stride in {1,2,4,8} -> that width; any other stride -> 8 bytes (value word).
# Clobbers nothing but the flags; labels are local to the helper emission.
def emit_a64_store_width(ctx: &mut RuntimeEmitCtx, addr: A64, value: A64, stride: A64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_store_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_store_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_store_4")
  let lbl_done = fresh_label(ctx, ".Lw_store_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w1.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w2.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w4.clone())
  a64_str(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  a64_str_w(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  a64_strh(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  a64_strb(&mut ctx.text, value, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch LOAD: dst = [addr], width from stride, zero-extended.
def emit_a64_load_width(ctx: &mut RuntimeEmitCtx, dst: A64, addr: A64, stride: A64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_load_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_load_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_load_4")
  let lbl_done = fresh_label(ctx, ".Lw_load_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w1.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w2.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w4.clone())
  a64_ldr(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  a64_ldr_w(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  a64_ldrh(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  a64_ldrb(&mut ctx.text, dst, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch STORE (x86-64): [addr] = value, width from stride.
# Clobbers nothing; caller-saved registers passed in are preserved.
def emit_x64_store_width(ctx: &mut RuntimeEmitCtx, addr: X64, value: X64, stride: X64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_store_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_store_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_store_4")
  let lbl_done = fresh_label(ctx, ".Lw_store_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_w1.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_w2.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_w4.clone())
  x64_mov_mr(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  x64_mov_m32_r32(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  x64_mov_m16_r16(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  x64_mov_m8_r8(&mut ctx.text, addr, 0, value)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch LOAD (x86-64): dst = [addr], width from stride, zero-extended.
def emit_x64_load_width(ctx: &mut RuntimeEmitCtx, dst: X64, addr: X64, stride: X64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_load_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_load_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_load_4")
  let lbl_done = fresh_label(ctx, ".Lw_load_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_w1.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_w2.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_w4.clone())
  x64_mov_rm(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  x64_mov_r32_m32(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  x64_movzx_r64_m16(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  x64_movzx_r64_m8(&mut ctx.text, dst, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

def emit_array_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_array_new(ctx)
  emit_tg_array_push(ctx)
  emit_tg_array_grow(ctx)
  emit_tg_array_destroy(ctx)
  emit_tg_array_pop(ctx)
  emit_tg_array_get(ctx)
  emit_tg_array_set(ctx)
  emit_tg_array_remove(ctx)
  emit_tg_array_insert(ctx)
  emit_tg_array_insert_full(ctx)
  emit_tg_array_contains(ctx)
  emit_tg_array_reverse(ctx)
  emit_tg_array_extend(ctx)
  emit_tg_array_resize(ctx)
end

# _tg_array_new: Allocate empty vec struct
# Args: x0/rdi = element stride (bytes; computed by codegen from the concrete
# element type via element_stride_bytes — the layout values NEVER come from
# a hardcoded constant). Stored at header offset 24.
# Returns: ptr to vec (32 bytes: {data:0, len:8, cap:16, stride:24}, zeroed
# except the stride field)
def emit_tg_array_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_new")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # save caller stride
    # Array headers are tiny and extremely frequent during lex/parse.
    # Allocate them from the bump arena instead of page-rounded mmap.
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct (3 stores of 8 bytes each), then set stride.
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # Save vec ptr
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 0)   # data = null
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 8)   # len = 0
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 16)  # cap = 0
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 24)  # stride = caller's stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # Return vec ptr
    
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # save caller stride
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct, then set stride (r12 holds it)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # Save vec ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RCX)   # data = null
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)   # len = 0
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RCX)  # cap = 0
    x64_mov_mr(&mut ctx.text, X64::RBX, 24, X64::R12)  # stride = caller's stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)  # Return vec ptr
    
    # Epilogue
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_push: Append element to vec
# Args: x0/rdi = vec ptr, x1/rsi = element value word (scalar value or
# pointer/handle — the element layout comes from the header's stride field)
# Returns: void
def emit_tg_array_push(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_push")
  
  let lblGrow = fresh_label(ctx, ".Larr_push_grow")
  let lblDone = fresh_label(ctx, ".Larr_push_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)
    
    # Save args
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # element
    
    # Sanity check: if vec ptr is 0 or len > 1B, trap immediately
    let sanity_ok = fresh_label(ctx, ".Larr_push_sanity_ok")
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), sanity_ok.clone())  # skip check if null (trap later)
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_mov_ri(&mut ctx.text, A64::X0, 1000000000)
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), sanity_ok.clone())
    a64_brk(&mut ctx.text, 0xBEEF)  # trap with identifiable code
    def_label(&mut ctx.text, sanity_ok)
    
    # Load len and cap
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16)  # cap
    
    # if len < cap: skip grow
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblGrow.clone())
    
    # Need to grow: new_cap = max(cap * 2, 8)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X0)
    a64_csel(&mut ctx.text, A64::X0, A64::X22, A64::X0, a64_cc_ge())
    a64_lsl(&mut ctx.text, A64::X0, A64::X0, 1)  # new_cap = max(cap,8) * 2
    
    # Call _tg_array_grow(vec, new_cap)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # new_cap in x1
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # vec in x0
    a64_bl(&mut ctx.text, "_tg_array_grow")
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len] — element address = data + len * stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)   # data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X23)  # len * stride
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X2)
    emit_a64_store_width(ctx, A64::X0, A64::X20, A64::X23)
    
    # len++
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_stur(&mut ctx.text, A64::X21, A64::X19, 8)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    # Save args
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # element
    
    # Load len and cap
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 16)  # cap
    
    # if len < cap: skip grow
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::L, lblGrow.clone())
    
    # Need to grow
    x64_mov_ri(&mut ctx.text, X64::RAX, 8)
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_cmova_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 1)  # new_cap *= 2
    
    # Call _tg_array_grow
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_grow")
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len] — element address = data + len * stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)   # data ptr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)     # len * stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    emit_x64_store_width(ctx, X64::RAX, X64::R12, X64::RDX)
    
    # len++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_grow: Internal helper to grow array capacity
# Args: x0/rdi = vec ptr, x1/rsi = new_capacity
# _tg_array_destroy: release the array's mmap'ed data buffer. Args: x0 =
# vec (32-byte header: [0] data, [8] len, [16] cap, [24] stride). Elements
# were already finalized by the cleanup loop; this frees cap*stride bytes.
def emit_tg_array_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_destroy")
  let lblSkip = fresh_label(ctx, ".Larr_destroy_skip")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)  # cap * stride
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    def_label(&mut ctx.text, lblSkip.clone())
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblSkip.clone())
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 16)  # cap
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 24)  # stride
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)     # cap * stride
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)      # munmap(data, size)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    def_label(&mut ctx.text, lblSkip.clone())
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_array_grow(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_grow")
  
  match ctx.target.arch
   when Arch::AArch64 then
     # Prologue — save all callee-saved regs (svc clobbers them on macOS ARM64)
     a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
     a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
     a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X27, A64::X28, A64::SP, -16)
     
     a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
     a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # new_cap
     a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)  # stride (header authority)
     
     # Allocate new buffer: mmap(0, new_cap*stride, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
     a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X24)  # size = new_cap * stride
     a64_mov_ri(&mut ctx.text, A64::X0, 0)
     a64_mov_ri(&mut ctx.text, A64::X2, 3)
     match ctx.target.os
     when OsAbi::MacOS then
       a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
       a64_mov_ri(&mut ctx.text, A64::X4, -1)
       a64_mov_ri(&mut ctx.text, A64::X5, 0)
       a64_mov_ri(&mut ctx.text, A64::X16, 197)
       a64_svc(&mut ctx.text, 0x80)
     when OsAbi::Linux then
       a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
       a64_mov_ri(&mut ctx.text, A64::X4, -1)
       a64_mov_ri(&mut ctx.text, A64::X5, 0)
       a64_mov_ri(&mut ctx.text, A64::X8, 222)
       a64_svc(&mut ctx.text, 0)
     when _ then a64_brk(&mut ctx.text, 1)
     end
     
     a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # new_data
     
     # Copy old data to new buffer: len elements, width bytes each, stride apart
     a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)  # old_data
     a64_ldur(&mut ctx.text, A64::X25, A64::X19, 8)  # len
     
     let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
     let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
     
     a64_mov_ri(&mut ctx.text, A64::X1, 0)  # i = 0
     def_label(&mut ctx.text, lblCopyLoop.clone())
     a64_cmp_rr(&mut ctx.text, A64::X1, A64::X25)
     a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
     
     # x2 = old_data + i*stride; load width from stride (x24)
     a64_mul_rrr(&mut ctx.text, A64::X2, A64::X1, A64::X24)
     a64_add_rrr(&mut ctx.text, A64::X2, A64::X22, A64::X2)
     emit_a64_load_width(ctx, A64::X3, A64::X2, A64::X24)
     # x2 = new_data + i*stride; store width from stride (x24)
     a64_mul_rrr(&mut ctx.text, A64::X2, A64::X1, A64::X24)
     a64_add_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X2)
     emit_a64_store_width(ctx, A64::X2, A64::X3, A64::X24)
     
     a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
     a64_b(&mut ctx.text, lblCopyLoop)
     
     def_label(&mut ctx.text, lblCopyDone.clone())
     
     # Free old buffer if not null
     a64_cmp_ri(&mut ctx.text, A64::X22, 0)
     let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
     a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkipFree.clone())
     
     # munmap(old_data, old_cap * stride)
     a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
     a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
     a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X24)
     match ctx.target.os
     when OsAbi::MacOS then
       a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
       a64_svc(&mut ctx.text, 0x80)
     when OsAbi::Linux then
       a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
       a64_svc(&mut ctx.text, 0)
     when _ then ()
     end
     
     def_label(&mut ctx.text, lblSkipFree.clone())
     
     # Update vec: data = new_data, cap = new_cap (stride unchanged at [24])
     a64_stur(&mut ctx.text, A64::X21, A64::X19, 0)
     a64_stur(&mut ctx.text, A64::X20, A64::X19, 16)
     
     # Epilogue — pop exactly the 6 pairs pushed in the prologue, in reverse
     a64_ldp_post(&mut ctx.text, A64::X27, A64::X28, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
     a64_ret(&mut ctx.text)
     
  when Arch::X86_64 then
    # Similar implementation for x86-64
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # new_cap
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 24)  # stride (header authority)
    
    # mmap(0, new_cap*stride, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::R15)  # size = new_cap * stride
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # new_data
    
    # Copy loop: len elements, width bytes each, stride apart.
    # r14 = old_data, r15 = stride (callee-saved), len re-loaded per iteration.
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)  # old_data
    
    let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
    let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
    
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # i = 0
    def_label(&mut ctx.text, lblCopyLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 8)  # len
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RSI)
    x64_jcc(&mut ctx.text, CC::E, lblCopyDone.clone())
    
    # rax = old_data + i*stride; load width from stride (r15)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    emit_x64_load_width(ctx, X64::RSI, X64::RAX, X64::R15)
    # new_data + i*stride; store width from stride (r15)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    emit_x64_store_width(ctx, X64::RAX, X64::RSI, X64::R15)
    
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblCopyLoop)
    
    def_label(&mut ctx.text, lblCopyDone.clone())
    
    # Free old buffer: munmap(old_data, old_cap * stride)
    x64_test_rr(&mut ctx.text, X64::R14, X64::R14)
    let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
    x64_jcc(&mut ctx.text, CC::E, lblSkipFree.clone())
    
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 16)  # old_cap
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::R15)     # old_cap * stride
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    def_label(&mut ctx.text, lblSkipFree.clone())
    
    # Update vec: data = new_data, cap = new_cap (stride unchanged at [24])
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::R12)
    
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_pop: Remove and return last element
# Args: x0/rdi = vec ptr
# Returns: element value word (width from the header stride) or 0 if empty
def emit_tg_array_pop(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_pop")
  
  let lblEmpty = fresh_label(ctx, ".Larr_pop_empty")
  let lblDone = fresh_label(ctx, ".Larr_pop_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    
    # if len == 0: return 0
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblEmpty.clone())
    
    # len--
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    # return data[len] — element address = data + (len-1) * stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    emit_a64_load_width(ctx, A64::X0, A64::X0, A64::X2)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    
    # if len == 0: return 0
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblEmpty.clone())
    
    # len--
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    # return data[len] — element address = data + (len-1) * stride
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 0)  # data
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24) # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    emit_x64_load_width(ctx, X64::RAX, X64::RCX, X64::RDX)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_get: Get element at index
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: element ptr (address = data + index*stride) or null if out of bounds
def emit_tg_array_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_get")
  
  let lblOob = fresh_label(ctx, ".Larr_get_oob")
  let lblDone = fresh_label(ctx, ".Larr_get_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X1) # index
    
    # if index >= len: return null
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 8)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblOob.clone())
    
    # return &data[index] — element address = data + index * stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X9, 0)   # data
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X11)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X10)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblOob)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)  # index
    
    # if index >= len: return null
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 8)
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lblOob.clone())
    
    # return &data[index] — element address = data + index * stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RCX, 24)   # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblOob)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_set: Set element at index
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = element value word
def emit_tg_array_set(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_set")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec, x1 = index, x2 = element
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)   # data
    a64_ldur(&mut ctx.text, A64::X10, A64::X0, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X11, A64::X1, A64::X10)  # index * stride
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X11)
    emit_a64_store_width(ctx, A64::X9, A64::X2, A64::X10)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # rdi = vec, rsi = index, rdx = element
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 24)  # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)     # index * stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RSI)
    emit_x64_store_width(ctx, X64::RAX, X64::RDX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_remove: Remove element at index, shift remaining
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: removed element
def emit_tg_array_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_remove")
  
  let lblLoop = fresh_label(ctx, ".Larr_remove_loop")
  let lblDone = fresh_label(ctx, ".Larr_remove_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 24)  # stride (header authority)
    
    # Save removed element: data + index*stride, width from stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X21)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    emit_a64_load_width(ctx, A64::X0, A64::X0, A64::X21)  # removed element in x0
    
    # Shift: for i from index to len-2: data[i] = data[i+1]
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)  # len
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)  # len-1
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    
    # data[i] = data[i+1] — value word copied with width = stride
    a64_ldur(&mut ctx.text, A64::X4, A64::X19, 0)  # data
    a64_add_rri(&mut ctx.text, A64::X3, A64::X2, 1)  # i+1
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X3, A64::X21)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X4, A64::X3)  # &data[i+1]
    emit_a64_load_width(ctx, A64::X3, A64::X3, A64::X21)
    a64_mul_rrr(&mut ctx.text, A64::X5, A64::X2, A64::X21)  # i*stride
    a64_add_rrr(&mut ctx.text, A64::X5, A64::X4, A64::X5)   # &data[i]
    emit_a64_store_width(ctx, A64::X5, A64::X3, A64::X21)
    
    a64_add_rri(&mut ctx.text, A64::X2, A64::X2, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 24)  # stride (header authority)
    
    # Get removed element: data + index*stride, width from stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)
    emit_x64_load_width(ctx, X64::RAX, X64::RAX, X64::R13)
    x64_push(&mut ctx.text, X64::RAX)  # Save removed
    
    # Shift loop
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    
    # data[i] = data[i+1] — value word copied with width = stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)             # i+1
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)      # &data[i+1]
    emit_x64_load_width(ctx, X64::RDX, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RSI)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R13)      # i*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[i]
    emit_x64_store_width(ctx, X64::RAX, X64::RDX, X64::R13)
    
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)
    
    x64_pop(&mut ctx.text, X64::RAX)  # Restore removed element
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_insert: Insert element at index, shift remaining
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = element
def emit_tg_array_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert")
  
  # This requires growing if len == cap, then shifting elements up
  # Tail-call into the full implementation (no bl/call — preserves LR)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_array_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_array_insert_full")
  end
end

def emit_tg_array_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert_full")
  
  let lblLoop = fresh_label(ctx, ".Larr_insert_loop")
  let lblDone = fresh_label(ctx, ".Larr_insert_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # element
    
    # Ensure capacity by calling push with dummy element
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_array_push")
    
    # Shift elements down: for i from len-1 down to index+1: data[i] = data[i-1]
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # len (now incremented)
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)  # i = len-1
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 24)  # stride (header authority)
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblDone.clone())
    
    # data[i] = data[i-1] — value word copied with width = stride
    a64_ldur(&mut ctx.text, A64::X4, A64::X19, 0)  # data
    a64_sub_rri(&mut ctx.text, A64::X3, A64::X22, 1)  # i-1
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X3, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X4, A64::X3)  # &data[i-1]
    emit_a64_load_width(ctx, A64::X3, A64::X3, A64::X23)
    a64_mul_rrr(&mut ctx.text, A64::X5, A64::X22, A64::X23)  # i*stride
    a64_add_rrr(&mut ctx.text, A64::X5, A64::X4, A64::X5)   # &data[i]
    emit_a64_store_width(ctx, A64::X5, A64::X3, A64::X23)
    
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element — width from stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    emit_a64_store_width(ctx, A64::X0, A64::X21, A64::X23)
    
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # element
    
    # Push dummy to ensure capacity
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_call_label(&mut ctx.text, "_tg_array_push")
    
    # Shift loop
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)  # i = len-1
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 24)  # stride (header authority)
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_jcc(&mut ctx.text, CC::LE, lblDone.clone())
    
    # data[i] = data[i-1] — value word copied with width = stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RDX, 1)             # i-1
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)      # &data[i-1]
    emit_x64_load_width(ctx, X64::RDX, X64::RAX, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R14)      # i*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[i]
    emit_x64_store_width(ctx, X64::RAX, X64::RDX, X64::R14)
    
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element — width from stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R14)      # index*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[index]
    emit_x64_store_width(ctx, X64::RAX, X64::R13, X64::R14)
    
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_contains: Check if element exists (linear search)
# Args: x0/rdi = vec ptr, x1/rsi = element
# Returns: 1 if found, 0 if not
def emit_tg_array_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_contains")
  
  let lblLoop = fresh_label(ctx, ".Larr_contains_loop")
  let lblFound = fresh_label(ctx, ".Larr_contains_found")
  let lblNotFound = fresh_label(ctx, ".Larr_contains_notfound")
  let lblStringMaybe = fresh_label(ctx, ".Larr_contains_string_maybe")
  let lblStringLoop = fresh_label(ctx, ".Larr_contains_string_loop")
  let lblStringInner = fresh_label(ctx, ".Larr_contains_string_inner")
  let lblStringNext = fresh_label(ctx, ".Larr_contains_string_next")
  let lblDone = fresh_label(ctx, ".Larr_contains_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X1)  # element
    
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 8)  # len
    a64_ldur(&mut ctx.text, A64::X12, A64::X9, 0)  # data
    a64_ldur(&mut ctx.text, A64::X15, A64::X9, 16) # cap
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblStringMaybe.clone())
    a64_mov_ri(&mut ctx.text, A64::X14, 1073741824)
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblStringMaybe.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblStringMaybe.clone())
    a64_mov_ri(&mut ctx.text, A64::X14, 7)
    a64_and_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X14)
    a64_cmp_ri(&mut ctx.text, A64::X14, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblStringMaybe.clone())
    a64_ldur(&mut ctx.text, A64::X15, A64::X9, 24)  # stride (header authority)
    a64_mov_ri(&mut ctx.text, A64::X13, 0)         # i = 0
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    
    # if data[i] == element: found — element address = data + i*stride,
    # compare the width-matched value word
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X13, A64::X15)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X14)
    emit_a64_load_width(ctx, A64::X14, A64::X14, A64::X15)
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFound.clone())
    
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblLoop)

    # Some mislowered String.contains calls still reach this helper with a raw
    # C-string receiver. Detect obviously invalid Vec headers and fall back to
    # substring search instead of walking string bytes as pointer slots.
    def_label(&mut ctx.text, lblStringMaybe)
    a64_cmp_ri(&mut ctx.text, A64::X10, 4096)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblNotFound.clone())
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X9)

    def_label(&mut ctx.text, lblStringLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X11, A64::X15, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X10)

    def_label(&mut ctx.text, lblStringInner.clone())
    a64_ldrb(&mut ctx.text, A64::X14, A64::X13, 0)
    a64_cmp_ri(&mut ctx.text, A64::X14, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFound.clone())
    a64_ldrb(&mut ctx.text, A64::X16, A64::X12, 0)
    a64_cmp_rr(&mut ctx.text, A64::X16, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblStringNext.clone())
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblStringInner)

    def_label(&mut ctx.text, lblStringNext)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 1)
    a64_b(&mut ctx.text, lblStringLoop)
    
    def_label(&mut ctx.text, lblFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNotFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)  # element
    
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RCX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RCX, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::R11, X64::RCX, 16) # cap
    x64_cmp_rr(&mut ctx.text, X64::R11, X64::R8)
    x64_jcc(&mut ctx.text, CC::L, lblStringMaybe.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 1073741824)
    x64_cmp_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_jcc(&mut ctx.text, CC::G, lblStringMaybe.clone())
    x64_cmp_ri(&mut ctx.text, X64::R9, 0)
    x64_jcc(&mut ctx.text, CC::E, lblStringMaybe.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R9)
    x64_mov_ri(&mut ctx.text, X64::R11, 7)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R11)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::NE, lblStringMaybe.clone())
    x64_mov_rm(&mut ctx.text, X64::R11, X64::RCX, 24)  # stride (header authority)
    x64_mov_ri(&mut ctx.text, X64::R10, 0)            # i = 0
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R10, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    
    # if data[i] == element: found — element address = data + i*stride,
    # compare the width-matched value word
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R10)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R11)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R9)
    emit_x64_load_width(ctx, X64::RAX, X64::RAX, X64::R11)
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblFound.clone())
    
    x64_add_ri(&mut ctx.text, X64::R10, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblStringMaybe)
    x64_cmp_ri(&mut ctx.text, X64::RDX, 4096)
    x64_jcc(&mut ctx.text, CC::LE, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RDX)  # needle base

    def_label(&mut ctx.text, lblStringLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R10)

    def_label(&mut ctx.text, lblStringInner.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R9)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R8)
    emit8(&mut ctx.text, 0x40)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x37)
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblStringNext.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::R9, 1)
    x64_jmp(&mut ctx.text, lblStringInner)

    def_label(&mut ctx.text, lblStringNext)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblStringLoop)
    
    def_label(&mut ctx.text, lblFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNotFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_reverse: Reverse array in-place
# Args: x0/rdi = vec ptr
# Array layout: [data_ptr, length, capacity, stride]
def emit_tg_array_reverse(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_reverse")

  let lblLoop = fresh_label(ctx, ".Larr_rev_loop")
  let lblDone = fresh_label(ctx, ".Larr_rev_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec ptr
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)   # x9 = data ptr
    a64_ldur(&mut ctx.text, A64::X10, A64::X0, 8)   # x10 = length
    a64_ldur(&mut ctx.text, A64::X13, A64::X0, 24)  # x13 = stride (header authority)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)           # x11 = i = 0
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X10, 1) # x12 = j = len - 1

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # Swap data[i] and data[j] — value words with width = stride
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X11, A64::X13)  # i*stride
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X9, A64::X14)   # &data[i]
    emit_a64_load_width(ctx, A64::X15, A64::X14, A64::X13)    # tmp = data[i]
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X13)  # j*stride
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X9, A64::X14)   # &data[j]
    emit_a64_load_width(ctx, A64::X16, A64::X14, A64::X13)    # data[j]
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X11, A64::X13)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X9, A64::X14)
    emit_a64_store_width(ctx, A64::X14, A64::X16, A64::X13)   # data[i] = data[j]
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X13)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X9, A64::X14)
    emit_a64_store_width(ctx, A64::X14, A64::X15, A64::X13)   # data[j] = tmp

    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1) # i++
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1) # j--
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # R12 is used as a temp below and is callee-saved: preserve it.
    x64_push(&mut ctx.text, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data ptr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 8)  # length
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDI, 24) # stride (header authority)
    x64_mov_ri(&mut ctx.text, X64::R8, 0)              # i = 0
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)             # j = len - 1

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # r9 = &data[i], r10 = &data[j]
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R8)
    x64_imul_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::R10, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::R10, X64::RAX)

    # Swap data[i] and data[j] — value words with width = stride
    emit_x64_load_width(ctx, X64::R11, X64::R9, X64::RDX)   # tmp = data[i]
    emit_x64_load_width(ctx, X64::R12, X64::R10, X64::RDX)  # data[j]
    emit_x64_store_width(ctx, X64::R9, X64::R12, X64::RDX)  # data[i] = data[j]
    emit_x64_store_width(ctx, X64::R10, X64::R11, X64::RDX) # data[j] = tmp

    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R12)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_extend: Append all elements from source array to dest array.
# Args: x0 = dest vec ptr, x1 = source vec ptr
def emit_tg_array_extend(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_extend")

  let lblLoop = fresh_label(ctx, ".Larr_ext_loop")
  let lblDone = fresh_label(ctx, ".Larr_ext_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = dest vec ptr
    # x1 already holds the src Vec handle: codegen's array_extend arm calls
    # deref_arg_once_if_ref_like(args, 1) so the `&other` arg is deref'd at the
    # call site (same as map_get/array_contains). Do NOT deref again here.
    # Guard against a null/empty src handle (an empty Vec is a null handle);
    # extending by an empty src is a no-op, so skip to done to avoid a null deref.
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldur(&mut ctx.text, A64::X20, A64::X1, 0)  # x20 = src data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X1, 8)  # x21 = src length
    a64_ldur(&mut ctx.text, A64::X23, A64::X1, 24) # x23 = src stride (same T as dest)
    a64_mov_ri(&mut ctx.text, A64::X22, 0)          # x22 = index i

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # Load src[i] — element address = src_data + i*stride, width = stride
    a64_mul_rrr(&mut ctx.text, A64::X2, A64::X22, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X20, A64::X2)
    emit_a64_load_width(ctx, A64::X1, A64::X2, A64::X23)

    # Push to dest: _tg_array_push(dest, element)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # rbx = dest
    # rsi already holds the src Vec handle (deref'd at call site by codegen).
    # Guard against a null/empty src handle: extending by an empty src is a no-op.
    x64_cmp_ri(&mut ctx.text, X64::RSI, 0)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RSI, 0)  # r12 = src data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RSI, 8)  # r13 = src len
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RSI, 24) # r15 = src stride (same T as dest)
    x64_mov_ri(&mut ctx.text, X64::R14, 0)            # r14 = i

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # Load src[i] — element address = src_data + i*stride, width = stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    emit_x64_load_width(ctx, X64::RSI, X64::RAX, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_resize: Resize vec to new_len, filling new elements with fill_value
# Args: x0/rdi = vec ptr, x1/rsi = new_len, x2/rdx = fill_value
def emit_tg_array_resize(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_resize")

  let lblFill = fresh_label(ctx, ".Larr_resize_fill")
  let lblDone = fresh_label(ctx, ".Larr_resize_done")
  let lblTrunc = fresh_label(ctx, ".Larr_resize_trunc")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # new_len
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # fill_value
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8) # current len

    # If new_len <= current len, truncate
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblTrunc.clone())

    # Need to grow? Check if new_len > cap
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 16)  # cap
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblFill.clone())

    # Grow: call _tg_array_grow(vec, new_len)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_array_grow")

    # Fill loop: store fill_value from old len to new_len
    def_label(&mut ctx.text, lblFill.clone())
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # reload current len (index)
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)  # data ptr
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    # data[i] = fill_value — element address = data + i*stride, width = stride
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)  # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X22, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X23, A64::X9)
    emit_a64_store_width(ctx, A64::X9, A64::X21, A64::X24)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_stur(&mut ctx.text, A64::X22, A64::X19, 8)  # update len
    a64_b(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    # Just set len = new_len
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)    # new_len
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)    # fill_value
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8) # current len

    # If new_len <= current len, truncate
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lblTrunc.clone())

    # Need to grow?
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 16)  # cap
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R15)
    x64_jcc(&mut ctx.text, CC::LE, lblFill.clone())

    # Grow
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblFill.clone())
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8)   # reload len (index)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 0)   # data ptr
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    # data[i] = fill_value — element address = data + i*stride, width = stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 24)  # stride (header authority)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R14)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::R8, X64::R15)
    emit_x64_store_width(ctx, X64::R8, X64::R13, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R14)  # update len
    x64_jmp(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R12)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Map Runtime Implementation — INLINE-BUCKET HASH TABLE
# ———————————————————————————————————————————————————————————————
#
# CONTRACT (the map/set storage + dispatch contract, P0-MAP):
#
# Map header (88 bytes — a raw byte arena plus the layout parameters):
#   [ptr+0]:   buckets       - pointer to the bucket ARENA (mmap'ed)
#   [ptr+8]:   size          - live entry count
#   [ptr+16]:  capacity      - bucket count (power of 2; 256 at creation)
#   [ptr+24]:  key_stride    - key byte size (concrete K, from the layout
#                              engine at the codegen site)
#   [ptr+32]:  key_align     - key alignment
#   [ptr+40]:  value_stride  - value byte size (concrete V)
#   [ptr+48]:  value_align   - value alignment
#   [ptr+56]:  key_off       - key inline offset inside a bucket record
#   [ptr+64]:  value_off     - value inline offset inside a bucket record
#   [ptr+72]:  next_off      - chain-pointer offset inside a bucket record
#   [ptr+80]:  bucket_stride - one bucket record's byte size
#
# The FOUR derived layout fields (key_off/value_off/next_off/bucket_stride)
# are computed ONCE at map creation from the four layout parameters
# (map_new receives key_stride/key_align/value_stride/value_align — the
# concrete values NEVER come from a hardcoded constant) and stored in the
# header. Every operation (probe, insert, drain, destroy, clear, entries)
# reads them from the header: there is NO hardcoded bucket arithmetic
# (no fixed 32-byte records, no key@8/value@16/next@24) anywhere in the
# map/set paths.
#
# Bucket record (inline storage — the reviewer's preferred contract once
# monomorphized layout is available):
#   [0]:                 hash   - cached hash (0 = empty slot)
#   [key_off]:           key    - key_stride inline bytes
#   [value_off]:         value  - value_stride inline bytes
#   [next_off]:          next   - chain pointer (0 = end of chain)
#
# The record layout formula (mirrored by the codegen's bucket layout
# computation from the same four parameters):
#   key_off       = align_up(8, key_align)
#   value_off     = align_up(key_off + key_stride, value_align)
#   next_off      = align_up(value_off + value_stride, 8)
#   bucket_stride = next_off + 8
#
# Entry TUPLES (map_entries / drain_one payloads) use the concrete (K, V)
# tuple layout, computed by the codegen from the same parameters and passed
# per call: key at 0, value at t_v_off = align_up(key_stride, value_align),
# tuple size t_size = align_up(t_v_off + value_stride, 8).
#
# HASH / EQ DISPATCH CONTRACT:
#   - the hash of the lookup key is computed by a DIRECT call, emitted at
#     each map-operation site by the codegen, to the CONCRETE Hash::hash
#     instance of the map's key type (a user-defined `impl Hash for MyKey`
#     compiles to MyKey__hash and dispatches; the monomorphizer
#     specializes generic impls — e.g. Vec__hash$<K> — from the injected
#     dispatch calls the MIR lowering inserts at every map-operation site);
#   - the probe loop's key equality uses the CONCRETE Eq::eq instance of
#     the key type, passed to the runtime as a function pointer by the
#     codegen at each call site (the loop lives in the runtime, so the
#     pointer is the only dispatchable carrier);
#   - kernel key types (Int/String/StrView/...) dispatch to the typed
#     runtime helpers _tg_hash_* / _tg_eq_* below — their registered
#     std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
#     match the core `def hash(self) -> Int` ABI the map surface declares.
#   The heuristic _tg_runtime_hash_ptr / _tg_key_equal paths are REMOVED.

def emit_map_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_map_new(ctx)
  emit_tg_map_get(ctx)
  emit_tg_map_insert(ctx)
  emit_tg_map_insert_full(ctx)
  emit_tg_map_remove(ctx)
  emit_tg_map_remove_full(ctx)
  emit_tg_map_drain_one(ctx)
  emit_tg_map_drain_one_full(ctx)
  emit_tg_map_destroy(ctx)
  emit_tg_map_contains(ctx)
  emit_tg_map_clear(ctx)
  emit_tg_map_entries(ctx)
  emit_tg_map_keys(ctx)
  emit_tg_map_clone(ctx)
  emit_tg_set_drain_one(ctx)
  emit_tg_set_drain_one_full(ctx)
  emit_tg_hash_mem(ctx)
  emit_tg_hash_str(ctx)
  emit_tg_hash_str_view(ctx)
  emit_tg_eq_mem(ctx)
  emit_tg_eq_str(ctx)
  emit_tg_eq_str_view(ctx)
end

# Shared byte-copy loop (inline storage). Clobbers count/src/dst and X9.
def emit_a64_copy_loop(ctx: &mut RuntimeEmitCtx, count: A64, src: A64, dst: A64) -> Unit
  let lblLoop = fresh_label(ctx, ".Lcopy_loop")
  let lblDone = fresh_label(ctx, ".Lcopy_done")
  def_label(&mut ctx.text, lblLoop.clone())
  a64_cmp_ri(&mut ctx.text, count, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
  a64_ldrb(&mut ctx.text, A64::X9, src, 0)
  a64_strb(&mut ctx.text, A64::X9, dst, 0)
  a64_add_rri(&mut ctx.text, src, src, 1)
  a64_add_rri(&mut ctx.text, dst, dst, 1)
  a64_sub_rri(&mut ctx.text, count, count, 1)
  a64_b(&mut ctx.text, lblLoop)
  def_label(&mut ctx.text, lblDone)
end

# Shared byte-copy loop (x86-64). Clobbers count/src/dst and RAX.
def emit_x64_copy_loop(ctx: &mut RuntimeEmitCtx, count: X64, src: X64, dst: X64) -> Unit
  let lblLoop = fresh_label(ctx, ".Lcopy_loop")
  let lblDone = fresh_label(ctx, ".Lcopy_done")
  def_label(&mut ctx.text, lblLoop.clone())
  x64_cmp_ri(&mut ctx.text, count, 0)
  x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
  x64_movzx_r64_m8(&mut ctx.text, X64::RAX, src, 0)
  x64_mov_m8_r8(&mut ctx.text, dst, 0, X64::RAX)
  x64_add_ri(&mut ctx.text, src, 1)
  x64_add_ri(&mut ctx.text, dst, 1)
  x64_sub_ri(&mut ctx.text, count, 1)
  x64_jmp(&mut ctx.text, lblLoop)
  def_label(&mut ctx.text, lblDone)
end

# _tg_map_new: Create an empty map.
# Args: x0/rdi = key_stride, x1/rsi = key_align, x2/rdx = value_stride,
#       x3/rcx = value_align  (computed by codegen from the CONCRETE K/V —
#       the layout values NEVER come from a hardcoded constant).
# Returns: x0/rax = map pointer (the 88-byte header above).
def emit_tg_map_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # key_stride
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key_align
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # value_stride
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # value_align

    # Derived layout (alignments are powers of two:
    # align_up(v, a) = (v + a - 1) & ~(a - 1)).
    # key_off = align_up(8, key_align)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 7)
    a64_neg(&mut ctx.text, A64::X10, A64::X20)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    # value_off = align_up(key_off + key_stride, value_align)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X19)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X11, A64::X22)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_neg(&mut ctx.text, A64::X10, A64::X22)
    a64_and_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X10)
    # next_off = align_up(value_off + value_stride, 8)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X12, A64::X21)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 7)
    a64_mov_ri(&mut ctx.text, A64::X10, -8)
    a64_and_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X10)
    # bucket_stride = next_off + 8
    a64_add_rri(&mut ctx.text, A64::X13, A64::X11, 8)

    # Allocate the bucket arena: mmap(256 * bucket_stride) — zeroed pages.
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 256)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X13)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # buckets

    # Allocate the 88-byte header from the bump arena.
    a64_mov_ri(&mut ctx.text, A64::X0, 88)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)  # header

    # Recompute the derived offsets (X9-X13 were clobbered by the calls).
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 7)
    a64_neg(&mut ctx.text, A64::X10, A64::X20)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X19)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X11, A64::X22)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_neg(&mut ctx.text, A64::X10, A64::X22)
    a64_and_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X12, A64::X21)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 7)
    a64_mov_ri(&mut ctx.text, A64::X10, -8)
    a64_and_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X10)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X11, 8)

    # Initialize the header (all offsets are the CONTRACT layout).
    a64_stur(&mut ctx.text, A64::X23, A64::X24, 0)   # buckets
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 8)   # size = 0
    a64_mov_ri(&mut ctx.text, A64::X1, 256)
    a64_stur(&mut ctx.text, A64::X1, A64::X24, 16)   # capacity = 256
    a64_stur(&mut ctx.text, A64::X19, A64::X24, 24)  # key_stride
    a64_stur(&mut ctx.text, A64::X20, A64::X24, 32)  # key_align
    a64_stur(&mut ctx.text, A64::X21, A64::X24, 40)  # value_stride
    a64_stur(&mut ctx.text, A64::X22, A64::X24, 48)  # value_align
    a64_stur(&mut ctx.text, A64::X9, A64::X24, 56)   # key_off
    a64_stur(&mut ctx.text, A64::X12, A64::X24, 64)  # value_off
    a64_stur(&mut ctx.text, A64::X11, A64::X24, 72)  # next_off
    a64_stur(&mut ctx.text, A64::X13, A64::X24, 80)  # bucket_stride

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # key_stride
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key_align
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # value_stride
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # value_align

    # Derived layout into stack slots (computed before the first call):
    #   [rsp+0]  = bucket_stride, [rsp+8]  = next_off,
    #   [rsp+16] = value_off,     [rsp+24] = key_off
    x64_sub_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RAX, 7)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_neg_r(&mut ctx.text, X64::RCX)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # key_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 24, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RBX)          # + key_stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)          # + value_align
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_neg_r(&mut ctx.text, X64::RCX)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # value_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 16, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)          # + value_stride
    x64_add_ri(&mut ctx.text, X64::RAX, 7)
    x64_mov_ri(&mut ctx.text, X64::RCX, -8)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # next_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 8, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RAX, 8)                 # bucket_stride
    x64_mov_mr(&mut ctx.text, X64::RSP, 0, X64::RAX)

    # mmap(0, 256 * bucket_stride, ...)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RSP, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # buckets

    # Allocate the 88-byte header from the bump arena.
    x64_mov_ri(&mut ctx.text, X64::RDI, 88)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # header

    # Initialize the header (all offsets are the CONTRACT layout).
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::R15)   # buckets
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 8, X64::RAX)   # size = 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 256)
    x64_mov_mr(&mut ctx.text, X64::RCX, 16, X64::RAX)  # capacity = 256
    x64_mov_mr(&mut ctx.text, X64::RCX, 24, X64::RBX)  # key_stride
    x64_mov_mr(&mut ctx.text, X64::RCX, 32, X64::R12)  # key_align
    x64_mov_mr(&mut ctx.text, X64::RCX, 40, X64::R13)  # value_stride
    x64_mov_mr(&mut ctx.text, X64::RCX, 48, X64::R14)  # value_align
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 24)
    x64_mov_mr(&mut ctx.text, X64::RCX, 56, X64::RAX)   # key_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 16)
    x64_mov_mr(&mut ctx.text, X64::RCX, 64, X64::RAX)   # value_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 8)
    x64_mov_mr(&mut ctx.text, X64::RCX, 72, X64::RAX)   # next_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 80, X64::RAX)   # bucket_stride

    x64_add_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_get: Get the value address for a key.
# Args: x0/rdi = map, x1/rsi = key address, x2/rdx = hash (already computed
#       by the concrete Hash::hash instance at the call site),
#       x3/rcx = eq_fn (the concrete Eq::eq instance of K).
# Returns: x0/rax = address of the bucket's inline value, or 0 when absent.
def emit_tg_map_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_get")

  let lblLoop = fresh_label(ctx, ".Lmap_get_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_get_notfound")
  let lblDone = fresh_label(ctx, ".Lmap_get_done")
  let lblNext = fresh_label(ctx, ".Lmap_get_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # hash
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # eq_fn

    # probe (X24, callee-saved across the eq call) =
    # buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X22)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblDone.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X24, A64::X10, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_get_ret")

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)  # bucket + value_off

    def_label(&mut ctx.text, ".Lmap_get_ret")
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # eq_fn

    # probe (rbp, callee-saved across the eq call) =
    # buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # cached hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R14)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblDone.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_get_ret")

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RBP)  # bucket + value_off

    def_label(&mut ctx.text, ".Lmap_get_ret")
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_insert: Insert or update an entry (inline key/value bytes).
# Args: x0/rdi = map, x1/rsi = key address, x2/rdx = value address,
#       x3/rcx = hash, x4/r8 = eq_fn.
# Returns: x0/rax = 0 (the old value is not returned — pre-existing ABI).
def emit_tg_map_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_insert_full")
  end
end

def emit_tg_map_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert_full")

  let lblLoop = fresh_label(ctx, ".Lmap_insert_loop")
  let lblFound = fresh_label(ctx, ".Lmap_insert_found")
  let lblNew = fresh_label(ctx, ".Lmap_insert_new")
  let lblChain = fresh_label(ctx, ".Lmap_insert_chain")
  let lblDone = fresh_label(ctx, ".Lmap_insert_done")
  let lblNext = fresh_label(ctx, ".Lmap_insert_next")
  let lblFoundUnit = fresh_label(ctx, ".Lmap_insert_found_unit")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # value address
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # hash
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X4)  # eq_fn

    # probe (X24) = buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X22, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNew.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X23)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X10)
    a64_b(&mut ctx.text, lblLoop)

    # Update in place with the REPLACEMENT CONTRACT (extract-then-write):
    # preserve the old value BEFORE overwriting — allocate value_stride
    # bytes, copy the old value out (bucket+value_off -> fresh), then
    # write the new value (value address -> bucket+value_off). X0 = the
    # fresh owned allocation (the codegen's Option[V] payload); the Set
    # case (value_stride 0) returns the presence marker 1; a NEW key
    # returns 0 (lblDone).
    def_label(&mut ctx.text, lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 40)  # value_stride
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundUnit.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh object
    # copy the old value out: bucket + value_off -> fresh
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = bucket + value_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst = fresh
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # write the new value: value address -> bucket + value_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, ".Lmap_insert_ret")
    # Unit values (Set): value_stride == 0 — no payload; the replacement
    # marker 1 (a new key returns 0).
    def_label(&mut ctx.text, lblFoundUnit.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, ".Lmap_insert_ret")

    # Store the new entry into the empty slot: hash, key bytes, value bytes.
    def_label(&mut ctx.text, lblNew.clone())
    a64_str(&mut ctx.text, A64::X22, A64::X24, 0)  # hash
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)  # key_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)  # key_off
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)  # value_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)  # value_off
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)  # next_off
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_str(&mut ctx.text, A64::XZR, A64::X10, 0)  # next = 0
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_b(&mut ctx.text, lblDone)

    # Collision: bucket occupied but next == 0 — allocate an overflow
    # bucket (one bucket_stride-sized record, mmap'ed like the arena).
    def_label(&mut ctx.text, lblChain.clone())
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)  # bucket_stride
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)  # node
    a64_ldp_post(&mut ctx.text, A64::X14, A64::XZR, A64::SP, 16)  # old probe
    # link: old_probe->next = node
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X14, A64::X9)
    a64_str(&mut ctx.text, A64::X24, A64::X10, 0)
    # store hash, key bytes, value bytes into the node
    a64_str(&mut ctx.text, A64::X22, A64::X24, 0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_str(&mut ctx.text, A64::XZR, A64::X10, 0)  # node->next = 0
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, ".Lmap_insert_ret")
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # value address
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R8)   # eq_fn

    # probe (rbp) = buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # cached hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNew.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R15)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChain.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    # Update in place with the REPLACEMENT CONTRACT (extract-then-write):
    # preserve the old value BEFORE overwriting — allocate value_stride
    # bytes, copy the old value out (bucket+value_off -> fresh, saved on
    # the stack), then write the new value (value address -> bucket+
    # value_off). RAX = the fresh owned allocation (the codegen's
    # Option[V] payload); the Set case (value_stride 0) returns the
    # presence marker 1; a NEW key returns 0 (lblDone).
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblFoundUnit.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_push(&mut ctx.text, X64::RAX)  # fresh object
    # copy the old value out: bucket + value_off -> fresh
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = bucket + value_off
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RSP, 0)  # dst = fresh
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    # write the new value: value address -> bucket + value_off
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_pop(&mut ctx.text, X64::RAX)  # fresh object
    x64_jmp(&mut ctx.text, ".Lmap_insert_ret_x")
    # Unit values (Set): value_stride == 0 — no payload; the replacement
    # marker 1 (a new key returns 0).
    def_label(&mut ctx.text, lblFoundUnit.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, ".Lmap_insert_ret_x")

    # Store the new entry: hash, key bytes, value bytes, next = 0.
    def_label(&mut ctx.text, lblNew.clone())
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)  # next = 0
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_jmp(&mut ctx.text, lblDone)

    # Collision: allocate one bucket_stride-sized overflow node.
    def_label(&mut ctx.text, lblChain.clone())
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 80)  # bucket_stride
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # node
    x64_pop(&mut ctx.text, X64::RBP)               # old probe
    # link: old_probe->next = node
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::RCX)
    # store hash, key bytes, value bytes
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)  # src
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::RAX)  # node->next = 0
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, ".Lmap_insert_ret_x")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_remove: Remove an entry; the removed VALUE is copied out into a
# fresh allocation (inline storage: the bucket bytes are zeroed) and its
# address returned. Args: x0/rdi = map, x1/rsi = key address,
# x2/rdx = hash, x3/rcx = eq_fn. Returns: x0/rax = value address or 0;
# for Unit-valued maps (sets) the value_stride is 0 and 1 is returned.
def emit_tg_map_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_remove_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_remove_full")
  end
end

def emit_tg_map_remove_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove_full")

  let lblLoop = fresh_label(ctx, ".Lmap_remove_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_remove_notfound")
  let lblFound = fresh_label(ctx, ".Lmap_remove_found")
  let lblFoundOne = fresh_label(ctx, ".Lmap_remove_found_one")
  let lblNext = fresh_label(ctx, ".Lmap_remove_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # hash
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # eq_fn

    # probe (X24) = buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X22)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X24, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 40)  # value_stride
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundOne.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh value object
    # copy the old value out: bucket + value_off -> object (the copy-loop
    # call convention is (count, src, dst); the swap makes X1=src, X2=dst).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = bucket + value_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst = fresh value object
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # zero the hash field (empty marker); the chain link stays intact.
    a64_str(&mut ctx.text, A64::XZR, A64::X24, 0)
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, lblFoundOne.clone())
    # zero the hash field (empty marker); the chain link stays intact.
    a64_str(&mut ctx.text, A64::XZR, A64::X24, 0)
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)

    def_label(&mut ctx.text, ".Lmap_remove_ret")
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # eq_fn

    # probe (rbp) = buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R14)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 40)  # value_stride
    x64_test_rr(&mut ctx.text, X64::R15, X64::R15)
    x64_jcc(&mut ctx.text, CC::E, lblFoundOne.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # fresh value object
    # copy the old value out: bucket + value_off -> object (the copy-loop
    # call convention is (count, src, dst); the swap makes RSI=src,
    # RDI=dst).
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = bucket + value_off
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)  # dst = fresh value object
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    # zero the hash field (empty marker); the chain link stays intact.
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)
    # size--
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_jmp(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, lblFoundOne.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # zero the hash field
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)  # size--
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)

    def_label(&mut ctx.text, ".Lmap_remove_ret")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_destroy: release the map's bucket arena AND every mmap'ed
# overflow node. Args: x0/rdi = map.
def emit_tg_map_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_destroy")
  let lblBucketLoop = fresh_label(ctx, ".Lmap_destroy_bucket_loop")
  let lblChain = fresh_label(ctx, ".Lmap_destroy_chain")
  let lblChainDone = fresh_label(ctx, ".Lmap_destroy_chain_done")
  let lblSkip = fresh_label(ctx, ".Lmap_destroy_skip")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # buckets
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    # Free overflow chains first (separate mmap allocations).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 16)   # capacity
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 80)   # bucket_stride
    a64_mul_rrr(&mut ctx.text, A64::X23, A64::X21, A64::X22)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X20, A64::X23)  # end
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)  # current bucket
    def_label(&mut ctx.text, lblBucketLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblSkip.clone())
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 72)  # next_off
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X21, A64::X24)
    a64_ldr(&mut ctx.text, A64::X24, A64::X24, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainDone.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X9, A64::X9, 0)  # next->next (save across munmap)
    a64_stp_pre(&mut ctx.text, A64::X9, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)  # bucket_stride
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainDone.clone())
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X22)
    a64_b(&mut ctx.text, lblBucketLoop.clone())
    def_label(&mut ctx.text, lblSkip.clone())
    # Free the main bucket arena: munmap(buckets, capacity * bucket_stride).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # fail closed: x86 backing release is not implemented (bootstrap
    # targets AArch64) — a dangling arena would corrupt later maps.
    x64_ud2(&mut ctx.text)
  end
end

# _tg_map_drain_one: destructively remove the FIRST live entry and transfer
# it into the caller's sret Option[(K, V)] slot (AArch64: x8).
# The sret payload is the concrete (K, V) tuple: key at payload+0, value at
# payload + t_v_off (t_v_off passed by the codegen). Args:
# x0 = map, x8 = sret, x1 = t_v_off, x2 = t_size.
def emit_tg_map_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_drain_one_full")
  when Arch::X86_64  then x64_ud2(&mut ctx.text)
  end
end

def emit_tg_map_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lmap_drain_scan")
  let lblChain = fresh_label(ctx, ".Lmap_drain_chain")
  let lblChainEnd = fresh_label(ctx, ".Lmap_drain_chain_end")
  let lblFoundBucket = fresh_label(ctx, ".Lmap_drain_found_bucket")
  let lblFoundChain = fresh_label(ctx, ".Lmap_drain_found_chain")
  let lblRemove = fresh_label(ctx, ".Lmap_drain_remove")
  let lblDone = fresh_label(ctx, ".Lmap_drain_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X1)  # t_v_off

    # Default: None (disc = 1)
    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    # end = buckets + capacity * bucket_stride
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X2)  # current bucket

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    # Overflow chain scan (entries chained off an empty head must drain too).
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X23, A64::X1)
    a64_ldr(&mut ctx.text, A64::X24, A64::X1, 0)  # chain
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainEnd.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X24, 0)  # chain entry hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundChain.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    a64_ldr(&mut ctx.text, A64::X24, A64::X1, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainEnd.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X1)
    a64_b(&mut ctx.text, lblScan.clone())

    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X23)
    a64_b(&mut ctx.text, lblRemove.clone())
    def_label(&mut ctx.text, lblFoundChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X24)
    def_label(&mut ctx.text, lblRemove.clone())
    # sret: Some (disc = 0)
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)
    # key bytes: rec + key_off -> sret + 8
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # value bytes: rec + value_off -> sret + 8 + t_v_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X21)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # mark the record empty (hash = 0); the chain link stays intact.
    a64_str(&mut ctx.text, A64::XZR, A64::X22, 0)
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_set_drain_one: destructively remove the FIRST live element of a set
# (a Map[T, Unit]) into the caller's sret Option[T] slot. Args:
# x0 = set, x8 = sret.
def emit_tg_set_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_set_drain_one_full")
  when Arch::X86_64  then x64_ud2(&mut ctx.text)
  end
end

def emit_tg_set_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lset_drain_scan")
  let lblChain = fresh_label(ctx, ".Lset_drain_chain")
  let lblChainEnd = fresh_label(ctx, ".Lset_drain_chain_end")
  let lblFoundBucket = fresh_label(ctx, ".Lset_drain_found_bucket")
  let lblFoundChain = fresh_label(ctx, ".Lset_drain_found_chain")
  let lblRemove = fresh_label(ctx, ".Lset_drain_remove")
  let lblDone = fresh_label(ctx, ".Lset_drain_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # set
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret

    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X2)

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X23, A64::X1)
    a64_ldr(&mut ctx.text, A64::X24, A64::X1, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainEnd.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundChain.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    a64_ldr(&mut ctx.text, A64::X24, A64::X1, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainEnd.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X1)
    a64_b(&mut ctx.text, lblScan.clone())

    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X23)
    a64_b(&mut ctx.text, lblRemove.clone())
    def_label(&mut ctx.text, lblFoundChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X24)
    def_label(&mut ctx.text, lblRemove.clone())
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)  # Some (disc = 0)
    # element bytes: rec + key_off -> sret + 8
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_str(&mut ctx.text, A64::XZR, A64::X22, 0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_map_contains: Check if a key exists. Args: x0/rdi = map,
# x1/rsi = key address, x2/rdx = hash, x3/rcx = eq_fn.
# Returns: x0/rax = 1 when present, 0 otherwise.
def emit_tg_map_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_contains")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_map_get")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_cset(&mut ctx.text, A64::X0, a64_cc_ne())
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_map_get")
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_setcc(&mut ctx.text, CC::NE, X64::RAX)
    x64_movzx_r64_r8(&mut ctx.text, X64::RAX, X64::RAX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_clear: Zero the hash field of every table record (the empty
# marker), stepping by the header's bucket_stride; size = 0. Args: x0/rdi.
def emit_tg_map_clear(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_clear")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # map
    a64_ldur(&mut ctx.text, A64::X10, A64::X9, 0)   # buckets
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 16)  # capacity
    a64_ldur(&mut ctx.text, A64::X12, A64::X9, 80)  # bucket_stride

    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")

    a64_mov_ri(&mut ctx.text, A64::X13, 0)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X13, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X10, A64::X14)
    a64_str(&mut ctx.text, A64::XZR, A64::X14, 0)  # hash = 0
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_stur(&mut ctx.text, A64::XZR, A64::X9, 8)  # size = 0
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RCX)

    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # map
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)   # buckets
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RCX, 16)  # capacity
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RCX, 80)  # bucket_stride

    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")

    x64_mov_ri(&mut ctx.text, X64::R8, 0)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R8)
    x64_imul_rr(&mut ctx.text, X64::R9, X64::RSI)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::R10, 0)
    x64_mov_mr(&mut ctx.text, X64::R9, 0, X64::R10)  # hash = 0
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 8, X64::RAX)  # size = 0

    x64_pop(&mut ctx.text, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_entries: Collect all (key, value) pairs into a Vec.
# Each Vec element is an 8-byte word: a POINTER to a freshly allocated
# (K, V) tuple object with the CONCRETE tuple layout (key at 0, value at
# t_v_off, t_size bytes total — computed by the codegen from the same
# layout parameters). Args: x0/rdi = map, x1/rsi = t_v_off, x2/rdx = t_size.
# Returns: x0/rax = Vec pointer.
def emit_tg_map_entries(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_entries")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_entries_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_entries_chain")
  let lblDone = fresh_label(ctx, ".Lmap_entries_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_entries_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # t_v_off
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # t_size
    # result Vec (element stride 8: pointer words)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # vec
    # end = buckets + capacity * bucket_stride (X23); current = X24
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    # Allocate the tuple object and copy the inline key/value bytes.
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)  # save record
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)  # t_size
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_stp_pre(&mut ctx.text, A64::X0, A64::XZR, A64::SP, -16)  # save tuple
    # key bytes: rec + key_off -> tuple + 0
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_ldur(&mut ctx.text, A64::X10, A64::SP, 16)  # record
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X10, A64::X9)  # src
    a64_ldur(&mut ctx.text, A64::X2, A64::SP, 0)  # tuple
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # value bytes: rec + value_off -> tuple + t_v_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_ldur(&mut ctx.text, A64::X10, A64::SP, 16)  # record
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X10, A64::X9)  # src
    a64_ldur(&mut ctx.text, A64::X2, A64::SP, 0)  # tuple
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X20)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the tuple pointer
    a64_ldur(&mut ctx.text, A64::X1, A64::SP, 0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)  # drop tuple
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)  # record

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # fail closed: x86_64 map_entries is not implemented — an empty Vec
    # would be a fabricated default, so trap instead.
    x64_ud2(&mut ctx.text)
  end
end

# _tg_map_keys: Extract all keys into a new Vec (8-byte element words: the
# ADDRESS of each record's inline key). Args: x0/rdi = map.
# Returns: x0/rax = Vec pointer.
def emit_tg_map_keys(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_keys")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_keys_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_keys_chain")
  let lblDone = fresh_label(ctx, ".Lmap_keys_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_keys_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # vec
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)  # end
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # fail closed: x86_64 map_keys is not implemented — an empty Vec
    # would be a fabricated default, so trap instead.
    x64_ud2(&mut ctx.text)
  end
end

# _tg_map_clone: Create a shallow clone of a map by re-inserting all
# entries into a fresh map of the SAME layout (the layout parameters are
# read from the source header). The source records' cached hashes are
# re-inserted verbatim; eq_fn (x1/rsi) is forwarded to the probe loop
# (never invoked while the destination is empty). Args: x0/rdi = source
# map, x1/rsi = eq_fn. Returns: x0/rax = cloned map.
def emit_tg_map_clone(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_clone")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_clone_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_clone_chain")
  let lblDone = fresh_label(ctx, ".Lmap_clone_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_clone_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # source map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # eq_fn
    # destination map with the SAME layout (header fields → map_new args)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 32)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X3, A64::X19, 48)
    a64_bl(&mut ctx.text, "_tg_map_new")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # destination map

    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)  # end
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    # dst.insert(bucket + key_off, bucket + value_off, cached_hash, eq_fn)
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X24, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X11)
    a64_mov_rr(&mut ctx.text, A64::X4, A64::X20)
    a64_bl(&mut ctx.text, "_tg_map_insert")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # fail closed: x86_64 map clone is not implemented — an empty map
    # would be a fabricated default, so trap instead.
    x64_ud2(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Map/Set Hash and Equality Helpers (the kernel key-type dispatch targets)
# ———————————————————————————————————————————————————————————————
#
# These implement the CORE Hash/Eq ABI the map surface declares
# (hash(key_ptr) -> Int, eq(a_ptr, b_ptr) -> Bool). Kernel key types
# (Int/String/StrView/...) dispatch here because their registered
# std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
# match the core ABI; user-defined `impl Hash for MyKey` / `impl Eq for
# MyKey` dispatch to the compiled MyKey__hash / MyKey__eq functions
# instead. The heuristic _tg_runtime_hash_ptr / _tg_key_equal functions
# are deleted.

# djb2 hash over `size` bytes at `ptr`; the result is normalized to be
# NON-ZERO (the bucket's hash field uses 0 as the empty marker).
# Args: x0/rdi = ptr, x1/rsi = size. Returns: x0/rax = hash.
def emit_tg_hash_mem(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_mem")
  let lblLoop = fresh_label(ctx, ".Lhash_mem_loop")
  let lblDone = fresh_label(ctx, ".Lhash_mem_done")
  let lblRet = fresh_label(ctx, ".Lhash_mem_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)   # h
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X0)  # ptr
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X1)  # size
    a64_mov_ri(&mut ctx.text, A64::X12, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X13)
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RCX, 5381)   # h
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)  # ptr
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RSI)  # size
    x64_mov_ri(&mut ctx.text, X64::R8, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_sub_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# djb2 hash over the NUL-terminated bytes at the C string whose POINTER is
# stored at [x0/rdi] (String keys: the key slot holds the buffer pointer).
# Returns: x0/rax = hash.
def emit_tg_hash_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_str")
  let lblLoop = fresh_label(ctx, ".Lhash_str_loop")
  let lblDone = fresh_label(ctx, ".Lhash_str_done")
  let lblRet = fresh_label(ctx, ".Lhash_str_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X10, A64::X0, 0)  # buffer ptr
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)
    a64_mov_ri(&mut ctx.text, A64::X12, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X13)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDI, 0)  # buffer ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 5381)
    x64_mov_ri(&mut ctx.text, X64::R8, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# djb2 hash over the StrView at [x0/rdi]: { ptr @0, len @8 }.
# Returns: x0/rax = hash.
def emit_tg_hash_str_view(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_str_view")
  let lblLoop = fresh_label(ctx, ".Lhash_view_loop")
  let lblDone = fresh_label(ctx, ".Lhash_view_done")
  let lblRet = fresh_label(ctx, ".Lhash_view_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X10, A64::X0, 0)  # ptr
    a64_ldr(&mut ctx.text, A64::X11, A64::X0, 8)  # len
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)
