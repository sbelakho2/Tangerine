# Tangerine Compiler — Runtime Library
# Full implementations of runtime functions for stdlib intrinsics
#
# This module contains the complete implementations of:
# - Array/Vec operations (dynamic arrays with growth)
# - Map operations (hash table with open addressing)
# - Set operations (hash set)
# - Memory allocation (mmap-based heap)
# - String conversion (int/float to string)
# - I/O operations

use std::core::{Option, Result, panic}
use tg_compiler::asm::{
  CodeBuffer, buf_new, buf_pos, align_to, emit8, emit32_le, emit64_le,
  def_label, add_reloc, add_symbol, RelocKind,
  AsmSymbol, Section, SymBinding, SymKind,
  Arch, OsAbi, AsmTarget,
  X64, A64,
  x64_mov_ri, x64_mov_rr, x64_mov_rm, x64_mov_mr, x64_mov_m8_r8, x64_mov_m16_r16, x64_mov_m32_r32,
  x64_movzx_r64_m8, x64_movzx_r64_m16, x64_mov_r32_m32,
  x64_add_rr, x64_add_ri, x64_sub_rr, x64_sub_ri,
  x64_imul_rr, x64_cqo, x64_idiv_r,
  x64_and_rr, x64_or_rr, x64_xor_rr, x64_and_ri,
  x64_cmp_rr, x64_cmp_ri, x64_test_rr,
  x64_jmp, x64_jcc, x64_call_label, x64_call_r, x64_call_extern,
  x64_ret, x64_push, x64_pop, x64_sub_ri, x64_shl_ri, x64_shr_ri, x64_cmova_rr,
  x64_lea_mem, x64_syscall, x64_ud2, x64_neg_r,
  a64_mov_ri, a64_mov_rr, a64_add_rrr, a64_add_rri,
  a64_sub_rrr, a64_sub_rri, a64_mul_rrr,
  a64_and_rrr, a64_orr_rrr, a64_eor_rrr,
  a64_cmp_rr, a64_cmp_ri,
  a64_ldr, a64_str, a64_ldur, a64_stur,
  a64_ldrb, a64_strb, a64_ldrh, a64_strh, a64_ldr_w, a64_str_w,
  a64_ldr_post, a64_stp_pre, a64_ldp_post,
  a64_bl, a64_blr, a64_ret, a64_b, a64_bcond, a64_brk,
  a64_svc, a64_udf, a64_nop, a64_lsl, a64_lsl_rrr,
  a64_sdiv_rrr, a64_udiv, a64_msub, a64_csel, a64_add_rrr_lsl, a64_lsr,
  a64_cc_eq, a64_cc_ne, a64_cc_lt, a64_cc_le, a64_cc_gt, a64_cc_ge, a64_cc_cs, a64_cc_cc,
  a64_neg, a64_code, CC
}
# The canonical Map/Set header table (MAP_HEADER_FIELDS in layout_engine.tg)
# is the single machine-readable layout authority: the runtime emits its
# header offsets from these functions and asserts every literal against them
# at emit time (map_header_assert_contract in emit_map_runtime).
use tg_compiler::layout_engine::{map_header_field_offset, map_header_total_size, map_header_assert_contract}

# ———————————————————————————————————————————————————————————————
# Runtime Emission Context
# ———————————————————————————————————————————————————————————————

struct RuntimeEmitCtx
  text: CodeBuffer
  target: AsmTarget
  lbl_counter: Int
end

def runtime_ctx_new(target: AsmTarget) -> RuntimeEmitCtx
  RuntimeEmitCtx {
    text: buf_new(),
    target: target,
    lbl_counter: 0
  }
end

def fresh_label(ctx: &mut RuntimeEmitCtx, prefix: String) -> String
  let lbl = prefix + "." + ctx.lbl_counter.to_string()
  ctx.lbl_counter = ctx.lbl_counter + 1
  lbl
end

# Emit both a label (for fixup resolution) AND a symbol (for linker resolution).
# This is required for all named runtime functions so the linker can find them.
def def_runtime_fn(ctx: &mut RuntimeEmitCtx, name: String) -> Unit
  # Align function start to 4 bytes (required for ARM64 instruction alignment)
  align_to(&mut ctx.text, 4, ctx.target.arch)
  let offset = buf_pos(&ctx.text)
  add_symbol(&mut ctx.text, AsmSymbol {
    name: name.clone(),
    section: Section::Text,
    offset: offset,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  def_label(&mut ctx.text, name)
end

# ———————————————————————————————————————————————————————————————
# Emit All Runtime Functions
# ———————————————————————————————————————————————————————————————

def emit_all_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_array_runtime(ctx)
  emit_string_runtime(ctx)
  emit_map_runtime(ctx)
  emit_memory_runtime(ctx)
  emit_string_conv_runtime(ctx)
  emit_intrinsic_runtime(ctx)
  emit_arg_runtime(ctx)
  emit_posix_runtime(ctx)
  emit_bump_alloc_runtime(ctx)
end

# ———————————————————————————————————————————————————————————————
# Intrinsic Runtime Implementation (abort, longjmp, etc.)
# ———————————————————————————————————————————————————————————————

def emit_intrinsic_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_intrinsic_abort(ctx)
  emit_tg_intrinsic_setjmp(ctx)
  emit_tg_intrinsic_longjmp(ctx)
  emit_tg_get_argc(ctx)
  emit_tg_get_argv(ctx)
  emit_tg_get_envp(ctx)
end

# __intrinsic_abort: Abort execution with trap
def emit_tg_intrinsic_abort(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_abort")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# __intrinsic_setjmp(jmp_buf: Ptr[u8]) -> Int
# Save callee-saved registers + SP + return address into jmp_buf.
# Returns 0 on the initial call; when longjmp restores, setjmp returns
# the value passed to longjmp (or 1 if the value was 0).
#
# jmp_buf layout for AArch64 (13 × 8 = 104 bytes):
#   [0]   X19   [8]  X20   [16] X21   [24] X22
#   [32]  X23   [40] X24   [48] X25   [56] X26
#   [64]  X27   [72] X28   [80] FP    [88] LR
#   [96]  SP
#
# jmp_buf layout for x86_64 (8 × 8 = 64 bytes):
#   [0]  RBX  [8]  RBP  [16] R12  [24] R13
#   [32] R14  [40] R15  [48] RSP  [56] RIP (return address)
def emit_tg_intrinsic_setjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_setjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf pointer
    a64_str(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_str(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_str(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_str(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_str(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_str(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_str(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_str(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_str(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_str(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_str(&mut ctx.text, A64::LR, A64::X0, 88)
    # Store SP: MOV X9, SP; STR X9, [X0, #96]
    a64_mov_rr(&mut ctx.text, A64::X9, A64::SP)
    a64_str(&mut ctx.text, A64::X9, A64::X0, 96)
    # Return 0
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf pointer
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RBX)
    x64_mov_mr(&mut ctx.text, X64::RDI, 8, X64::RBP)
    x64_mov_mr(&mut ctx.text, X64::RDI, 16, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::RDI, 24, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RDI, 32, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::RDI, 40, X64::R15)
    # Save RSP (after call = RSP + 8, since CALL pushed return address)
    x64_lea_mem(&mut ctx.text, X64::RAX, X64::RSP, 8)
    x64_mov_mr(&mut ctx.text, X64::RDI, 48, X64::RAX)
    # Save return address (at [RSP])
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, 56, X64::RAX)
    # Return 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# __intrinsic_longjmp(jmp_buf: Ptr[u8], val: Int)
# Restore callee-saved registers + SP + return address from jmp_buf,
# then return to the setjmp call site with val (or 1 if val == 0).
def emit_tg_intrinsic_longjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_longjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf, X1 = val
    # Ensure val != 0 (longjmp(buf, 0) must return 1)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    # CSINC W1, W1, WZR, NE → if X1 == 0 then X1 = 1 else X1 = X1
    # 0x1A9F1421: verified as CSINC W1, W1, WZR, NE (0x5A9F1421 disassembles
    # to CSNEG W1, W1, WZR, NE — which maps longjmp(buf, 0) to 0, not 1)
    emit32_le(&mut ctx.text, 0x1A9F1421)  # CSINC W1, W1, WZR, NE
    # Restore callee-saved registers
    a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_ldr(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_ldr(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_ldr(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_ldr(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_ldr(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_ldr(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_ldr(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_ldr(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_ldr(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_ldr(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_ldr(&mut ctx.text, A64::LR, A64::X0, 88)
    # Restore SP
    a64_ldr(&mut ctx.text, A64::X9, A64::X0, 96)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::X9)
    # Return val
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf, RSI = val
    # Ensure val != 0
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    # if RSI == 0 then RSI = 1
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    # CMOVNZ RAX, RSI → RAX = (RSI != 0) ? RSI: 1
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x45)
    emit8(&mut ctx.text, 0xC6)  # cmovnz rax, rsi
    # Restore callee-saved regs
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RDI, 8)
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 16)
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RDI, 24)
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RDI, 32)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RDI, 40)
    # Restore RSP
    x64_mov_rm(&mut ctx.text, X64::RSP, X64::RDI, 48)
    # Jump to saved return address  
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 56)
    # JMP RCX
    emit8(&mut ctx.text, 0xFF)
    emit8(&mut ctx.text, 0xE1)  # jmp rcx
  end
end

def emit_load_data_global(ctx: &mut RuntimeEmitCtx, sym_name: String) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # ADRP X0, sym@PAGE
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, sym_name.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000)
    # ADD X0, X0, sym@PAGEOFF
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, sym_name, 0)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 0)
    # LDR X0, [X0]
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # LEA RAX, [RIP + sym]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8D)
    emit8(&mut ctx.text, 0x05)
    add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, sym_name, -4)
    emit32_le(&mut ctx.text, 0)
    # MOV RAX, [RAX]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_get_argc(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argc")
  emit_load_data_global(ctx, "_tg_saved_argc".to_string())
end

def emit_tg_get_argv(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argv")
  emit_load_data_global(ctx, "_tg_saved_argv".to_string())
end

def emit_tg_get_envp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_envp")
  emit_load_data_global(ctx, "_tg_saved_envp".to_string())
end

# _tg_cstring_new: Wrap a native C string pointer into a CString value.
# CString is a single pointer field at the native ABI.
# Args: x0/rdi = a Tangerine String OBJECT (owned String value)
# Returns: x0/rax = the object's data pointer, reinterpreted as CString
# (the borrowed str view of the owned buffer).
def emit_tg_cstring_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_cstring_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_bytes: Convert an owned String object to a Vec[u8] of its
# bytes. The Vec is a genuine Vec[u8]: stride 1 in the header, bytes
# stored CONTIGUOUSLY (data + i*1) — byte-exact consumers (indexing,
# as_bytes) read 1-byte slots.
# Args: x0/rdi = String object (header: data@0, len@8, cap@16, stride@24)
# Returns: x0/rax = Vec pointer ({data:0, len:8, cap:16, stride:24})
def emit_tg_string_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_bytes")

  let lbl_sizeok = fresh_label(ctx, ".Lsb_sizeok")
  let lbl_copy = fresh_label(ctx, ".Lsb_copy")
  let lbl_copydone = fresh_label(ctx, ".Lsb_copydone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    # Unwrap the String object: x19 = data, x20 = len (the cached header
    # length — no strlen).
    a64_ldur(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_ldur(&mut ctx.text, A64::X20, A64::X0, 8)

    # Allocate Vec struct (32-byte header: data/len/cap/stride)
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # Allocate data buffer: len bytes (min 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_cmp_ri(&mut ctx.text, A64::X0, 8)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_sizeok.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    def_label(&mut ctx.text, lbl_sizeok.clone())
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)

    # Set Vec fields
    a64_stur(&mut ctx.text, A64::X22, A64::X21, 0)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 8)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 16)
    a64_mov_ri(&mut ctx.text, A64::X24, 1)  # u8 stride = 1
    a64_stur(&mut ctx.text, A64::X24, A64::X21, 24)

    # Copy bytes contiguously: data[i] = string[i]
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X19, A64::X23)
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X23)
     a64_strb(&mut ctx.text, A64::X2, A64::X1, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())

    # Return Vec pointer
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    # Unwrap the String object: rbx = data, r12 = len
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 8)

    # Allocate Vec struct (32-byte header)
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # vec

    # Allocate data buffer: len bytes (min 8)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_cmp_ri(&mut ctx.text, X64::RDI, 8)
    x64_jcc(&mut ctx.text, CC::GE, lbl_sizeok.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    def_label(&mut ctx.text, lbl_sizeok.clone())
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # data

    # Set Vec fields
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::R15, 1)  # u8 stride = 1
    x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::R15)

    # Copy bytes contiguously: data[i] = string[i]
    x64_mov_ri(&mut ctx.text, X64::R15, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::R15, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_copydone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_mov_m8_r8(&mut ctx.text, X64::RCX, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())

    # Return Vec pointer
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# Argument/process helper runtime emitters.
def emit_arg_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_env_count(ctx)
  emit_tg_str_skip(ctx)
  emit_tg_arg(ctx)
  emit_tg_arg_copy(ctx)
  emit_tg_env_entry(ctx)
  emit_tg_args_vec(ctx)
  emit_tg_effect_record(ctx)
  emit_tg_status(ctx)
  emit_tg_output(ctx)
  emit_tg_stdout_string(ctx)
  emit_tg_stderr_string(ctx)
end

# __tg_effect_record: Record an effect (name, value) in the effect log.
# UNSUPPORTED agentic hook: no effect-log implementation exists. MirEffectRecord
# is never constructed by source lowering (agentic-only), so this is reached
# only by a future agentic compile — fail closed with a trap instead of
# fabricating a record. The MirBudgetConsume data symbols (__tg_budget_*)
# likewise have no definitions and fail closed at link time if emitted.
def emit_tg_effect_record(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__tg_effect_record")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_env_count: Count environment variable entries (envp array length).
# Returns: number of envp entries before the NULL terminator.
def emit_tg_env_count(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_count")

  let lbl_loop = fresh_label(ctx, ".Lenvcount_loop")
  let lbl_done = fresh_label(ctx, ".Lenvcount_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "tg_get_envp")
    # X0 = envp pointer (array of char* pointers)
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_add_rrr_lsl(&mut ctx.text, A64::X10, A64::X0, A64::X9, 3)  # X10 = envp + counter * 8
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # X10 = envp[counter]
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)  # return count

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_call_label(&mut ctx.text, "tg_get_envp")
    # RAX = envp pointer
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RCX)
    x64_shl_ri(&mut ctx.text, X64::RBX, 3)
    x64_add_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg: Get command line argument at index.
# Args: x0/rdi = index
# Returns: raw char* from argv (the BORROWED str view of the OS argv bytes
# — never freed, never mutated; convert with _tg_string_from_static when an
# owned String is required, as _tg_arg_copy does)
# Returns NULL if index is out of bounds (index < 0 || index >= argc)
def emit_tg_arg(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg")

  let lbl_valid = fresh_label(ctx, ".Larg_valid")
  let lbl_done = fresh_label(ctx, ".Larg_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    # Save index to X19
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    
    # Bounds check: if index < 0, return NULL
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_cmp_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    
    # Valid index: get argv[index]
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_b(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (the borrowed str view of argv bytes)

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    # Save index to RBX
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    
    # Bounds check: if index < 0, return NULL
    x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
    x64_jcc(&mut ctx.text, CC::L, lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
    x64_cmp_rr(&mut ctx.text, X64::RBX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    
    # Valid index: get argv[index]
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_jmp(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (the borrowed str view of argv bytes)

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg_copy: Get command line argument at index and copy it into an
# OWNED String object (the String ABI). The OS argv bytes are borrowed;
# the owned copy makes the result a real String value.
def emit_tg_arg_copy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg_copy")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "_tg_arg")
    a64_bl(&mut ctx.text, "_tg_string_from_static")

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)

    x64_call_label(&mut ctx.text, "_tg_arg")
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_from_static")

    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_env_entry: Get environment variable entry at index.
# Args: x0/rdi = index
# Returns: raw char* from envp (null if past end), e.g. "KEY=value"
# _tg_str_skip(str: Ptr[u8], offset: Int) -> Ptr[u8]
# Returns str + offset (pointer arithmetic on C string)
def emit_tg_str_skip(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_skip")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_env_entry(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_entry")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bl(&mut ctx.text, "tg_get_envp")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # Return raw char* pointer or NULL

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    x64_call_label(&mut ctx.text, "tg_get_envp")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_args_vec: Get all command line arguments as Vec[String]
# Returns: Vec ptr containing Tangerine String OBJECT values (the owned
# copies of the borrowed argv bytes — the String ABI).
def emit_tg_args_vec(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_args_vec")

  let lbl_loop = fresh_label(ctx, ".Largsvec_loop")
  let lbl_done = fresh_label(ctx, ".Largsvec_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue — save callee-saved registers we use
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    # Create empty Vec → x19 (elements are String objects = 8-byte pointers)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)  # element stride
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)

    # Get argc → x20
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)

    # Get argv → x21
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # i = 0
    a64_mov_ri(&mut ctx.text, A64::X22, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    # if i >= argc → done
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())

    # x0 = argv[i]: load from [x21 + x22*8]
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X21, A64::X22, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # The borrowed argv bytes become an OWNED String object
    a64_bl(&mut ctx.text, "_tg_string_from_static")
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)

    # _tg_array_push(vec, string_object)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    # i++
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    # Return the Vec
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)

    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    # Create empty Vec → rbx (elements are String objects = 8-byte pointers)
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)  # element stride
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)

    # Get argc → r12
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)

    # Get argv → r13
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

    # i = 0
    x64_mov_ri(&mut ctx.text, X64::R14, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())

    # rdi = argv[i]
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RAX, 0)
    # The borrowed argv bytes become an OWNED String object
    x64_call_label(&mut ctx.text, "_tg_string_from_static")
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)

    # _tg_array_push(vec, string_object)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)

    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_from_bytes: Convert a Vec[u8] buffer into an OWNED String
# object (the String ABI: {data:0, len:8, cap:16, stride:24}).
# Args: x0/rdi = Vec pointer ({data:0, len:8, cap:16, stride:24}).
# Returns: x0/rax = String object pointer.
def emit_tg_string_from_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_from_bytes")

  let lbl_copy = fresh_label(ctx, ".Lsfb_copy")
  let lbl_done = fresh_label(ctx, ".Lsfb_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 0)  # data ptr
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24) # stride (header authority)

    # Allocate the String object header (32 bytes) — the REAL heap
    # allocator (the _tg_mem_alloc/_tg_mem_free pair — the String drop
    # releases the object and this buffer).
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # string object

    # Allocate the data buffer: len bytes (min 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_cmp_ri(&mut ctx.text, A64::X0, 8)
    a64_bcond(&mut ctx.text, a64_cc_ge(), ".Lsfb_sizeok")
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    def_label(&mut ctx.text, ".Lsfb_sizeok")
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # data buffer

    # Set String object fields
    a64_stur(&mut ctx.text, A64::X23, A64::X22, 0)   # data
    a64_stur(&mut ctx.text, A64::X20, A64::X22, 8)   # len
    a64_stur(&mut ctx.text, A64::X20, A64::X22, 16)  # cap = len (min 8 at the buffer)
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    a64_stur(&mut ctx.text, A64::X9, A64::X22, 24)   # stride = 1

    # Copy: for a stride-1 Vec[u8] the bytes are contiguous; any other
    # stride keeps the historical low-byte-of-each-slot convention.
    a64_cmp_ri(&mut ctx.text, A64::X24, 1)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lsfb_contig")
    # Strided copy: byte i = low byte of [data + i*stride]
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X23, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X21, A64::X10)
    emit_a64_load_width(ctx, A64::X11, A64::X10, A64::X24)
    a64_ldur(&mut ctx.text, A64::X13, A64::X22, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X13, A64::X23)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, ".Lsfb_contig")
    # Contiguous copy: byte i = [data + i]
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X21, A64::X23)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_ldur(&mut ctx.text, A64::X12, A64::X22, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X23)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    a64_ldur(&mut ctx.text, A64::X12, A64::X22, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X20)
    a64_strb(&mut ctx.text, A64::XZR, A64::X12, 0)  # NUL at data[len]
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 8)  # len
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 0)  # data ptr
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 24) # stride

    # Allocate the String object header (32 bytes) — the REAL heap
    # allocator (the _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # string object

    # Allocate the data buffer: len bytes (min 8)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_cmp_ri(&mut ctx.text, X64::RDI, 8)
    x64_jcc(&mut ctx.text, CC::GE, ".Lsfb_sizeok")
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    def_label(&mut ctx.text, ".Lsfb_sizeok")
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # data buffer

    # Set String object fields
    x64_mov_mr(&mut ctx.text, X64::R14, 0, X64::RBX)   # data
    x64_mov_mr(&mut ctx.text, X64::R14, 8, X64::R12)   # len
    x64_mov_mr(&mut ctx.text, X64::R14, 16, X64::R12)  # cap = len
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::R14, 24, X64::RCX)  # stride = 1

    # Copy: contiguous for stride 1; low-byte-per-slot otherwise.
    x64_cmp_ri(&mut ctx.text, X64::R15, 1)
    x64_jcc(&mut ctx.text, CC::E, ".Lsfb_contig")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # i
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    emit_x64_load_width(ctx, X64::RAX, X64::RAX, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::RDI, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, ".Lsfb_contig")
    # Contiguous: rsi = src, rdi = dst, rcx = len, rep movsb
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R12)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)

    def_label(&mut ctx.text, lbl_done.clone())
    # NUL at data[len]
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::R14, 0)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RDI, 0, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# String Object Runtime — THE STRING ABI (, DECIDED)
# ———————————————————————————————————————————————————————————————
#
# String is an OWNED, MUTABLE string object. The String VALUE (the 8-byte
# word in locals, slots, Vec elements, map keys) is ONE pointer to a
# 32-byte String object header — the same shape as the Vec header:
#
#   [ptr+0]:  data   — pointer to the null-terminated UTF-8 byte buffer
#                      (the real heap — _tg_mem_alloc; NUL at data[len])
#   [ptr+8]:  len    — byte length (excluding the NUL)
#   [ptr+16]: cap    — byte capacity of the data buffer (>= len, >= 8)
#   [ptr+24]: stride — 1 (u8 byte stride; the header mirrors the Vec
#                      shape so the engine's StringPtr VALUE width (8)
#                      and the {data,len,cap,stride} field offsets stay
#                      the same object)
#
# The String ABI is the intrinsic-level contract:
#   - string_* intrinsic RECEIVERS and RESULTS are String OBJECTS
#     (header pointers);
#   - str-typed operands (&str params, str_* intrinsics) are RAW pointers
#     to NUL-terminated bytes — the static StrView form (interned
#     literals), borrowed buffers, OS argv.
# A string LITERAL is the static StrView (raw label — MIR carries the
# constant with Type::StrView, the view type, never the owned String); the
# conversion to an owned String is the explicit typed coercion:
# _tg_string_from_static (and the std's from_str_view path). Literal
# consumers that promise an owned String (by-value String params, String
# destinations, aggregate fields whose destination type is the owned
# String — struct/enum/tuple/array/vec! — concat results, to_string,
# clone) go through the owned coercion — never through the Array runtime.
# String::slice / str::slice delegate to _tg_string_slice, which returns an
# OWNED String object (the raw-buffer slice emitter is are not part of the model).
#
# EVERY OWNED STRING HAS REAL ALLOCATION/DEALLOCATION SEMANTICS ():
# the String OBJECT (32 bytes) and its data BUFFER are allocated from the
# real heap allocator (_tg_mem_alloc — the malloc-style pair with
# _tg_mem_free, the same allocator the Vec data buffers use), NEVER the
# raw bump arena; _tg_string_reserve releases the OLD buffer at the growth
# boundary; and the String drop (_tg_string_drop — the MIR's
# DeinitPlan::String destructor, emitted at the value's semantic lifetime
# boundary) frees BOTH the object and its buffer. Short-lived strings,
# clones, and temporary concatenations are reclaimed when their value
# dies — no unbounded arena growth for long-running apps.
#
# The old "String = raw C string" helpers that consumed/received String
# VALUES have been reworked to the object ABI (see _tg_string_bytes /
# _tg_string_from_bytes / _tg_cstring_new / _tg_str_chars / _tg_hash_str /
# _tg_eq_str / _tg_read_file_to_string / _tg_arg_copy / _tg_args_vec).

# _tg_string_new: Create an empty owned String object.
# Args: none.
# Returns: x0/rax = String object pointer (32-byte header + 8-byte data).
# ALLOCATION CONTRACT (— real lifetime): the String object (32 bytes)
# AND its data buffer come from the real heap allocator (_tg_mem_alloc —
# the malloc-style pair with _tg_mem_free, the same allocator the Vec data
# buffers use), NEVER the raw bump arena. The String drop (_tg_string_drop)
# frees both, so a String value has real allocation/deallocation semantics
# at its semantic lifetime boundary.
def emit_tg_string_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # header

    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # data (8 bytes, zeroed)

    a64_stur(&mut ctx.text, A64::X20, A64::X19, 0)   # data
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 8)   # len = 0
    a64_mov_ri(&mut ctx.text, A64::X9, 8)
    a64_stur(&mut ctx.text, A64::X9, A64::X19, 16)   # cap = 8
    a64_mov_ri(&mut ctx.text, A64::X10, 1)
    a64_stur(&mut ctx.text, A64::X10, A64::X19, 24)  # stride = 1
    a64_stur(&mut ctx.text, A64::XZR, A64::X20, 0)   # data[0] = NUL

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # header

    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # data

    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::R12)   # data
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)   # len = 0
    x64_mov_ri(&mut ctx.text, X64::RCX, 8)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RCX)  # cap = 8
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 24, X64::RCX)  # stride = 1
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::RCX)   # data[0] = NUL

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_reserve: Grow the owned String object's data buffer so that
# len + extra bytes fit.
# Args: x0/rdi = String object, x1/rsi = extra bytes.
# Returns: void. Never shrinks. ALLOCATION CONTRACT (— real lifetime):
# the new buffer comes from the real heap allocator (_tg_mem_alloc) and the
# OLD buffer is released through _tg_mem_free after the copy — an old
# buffer after growth is reclaimed at the growth boundary, never abandoned
# to an arena.
def emit_tg_string_reserve(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_reserve")

  let lbl_grow = fresh_label(ctx, ".Lstr_reserve_grow")
  let lbl_done = fresh_label(ctx, ".Lstr_reserve_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # String object
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # extra
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16) # cap

    a64_add_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X20)  # need = len + extra
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_done.clone())

    def_label(&mut ctx.text, lbl_grow.clone())
    # new_cap = max(cap * 2, need); floor 8
    a64_lsl(&mut ctx.text, A64::X10, A64::X22, 1)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X9)
    a64_csel(&mut ctx.text, A64::X10, A64::X10, A64::X9, a64_cc_ge())
    a64_mov_ri(&mut ctx.text, A64::X11, 8)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X11)
    a64_csel(&mut ctx.text, A64::X10, A64::X10, A64::X11, a64_cc_ge())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X10)  # new_cap

    # Allocate new data buffer: new_cap + 1 bytes (NUL room) — the REAL
    # heap allocator (the _tg_mem_alloc/_tg_mem_free pair).
    a64_add_rri(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)   # new data

    # Copy len bytes from old data to new data
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 0)  # old data
    a64_mov_ri(&mut ctx.text, A64::X10, 0)         # i = 0
    let lbl_copy = fresh_label(ctx, ".Lstr_reserve_copy")
    let lbl_copydone = fresh_label(ctx, ".Lstr_reserve_copy_done")
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X10)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())
    # NUL at data[len]
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X21)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)

    a64_stur(&mut ctx.text, A64::X20, A64::X19, 0)   # data = new data
    a64_stur(&mut ctx.text, A64::X22, A64::X19, 16)  # cap = new_cap

    # Release the OLD data buffer (X9 still holds it) — the real-heap
    # deallocation at the growth boundary, the pair of the _tg_mem_alloc
    # above.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_mem_free")

    def_label(&mut ctx.text, lbl_done.clone())
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # String object
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)   # extra
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 16)  # cap

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)   # need = len + extra
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lbl_done.clone())

    def_label(&mut ctx.text, lbl_grow.clone())
    # new_cap = max(cap * 2, need); floor 8
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RCX, 1)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_cmova_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RDX, 8)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_cmova_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)   # new_cap

    # Allocate new data buffer: new_cap + 1 — the REAL heap allocator (the
    # _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)   # new data

    # Save the OLD data pointer (R15 — the rep movsb below clobbers RSI).
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 0)
    # Copy len bytes: rdi = new data, rsi = old data, rcx = len
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)
    # NUL at data[len]
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x00)

    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::R12)   # data = new data
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::R14)  # cap = new_cap

    # Release the OLD data buffer (R15) — the real-heap deallocation at the
    # growth boundary, the pair of the _tg_mem_alloc above.
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_call_label(&mut ctx.text, "_tg_mem_free")

    def_label(&mut ctx.text, lbl_done.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_drop: Destroy an owned String value — release the data BUFFER
# and the String OBJECT through the real-heap deallocator (_tg_mem_free —
# the pair of the _tg_mem_alloc every String object/buffer came from). The
# drop-glue path (the MIR's DeinitPlan::String destructor) calls this with
# the ADDRESS of the String slot (the same place-address convention every
# finalizer receives); the runtime loads the object handle from the slot.
# Args: x0/rdi = address of the String value slot.
# Returns: void.
def emit_tg_string_drop(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_drop")

  let lbl_done = fresh_label(ctx, ".Lstr_drop_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_ldur(&mut ctx.text, A64::X19, A64::X0, 0)   # object = [slot]
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())

    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # buffer = [object]
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_mem_free")           # release the data buffer
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_mem_free")           # release the object

    def_label(&mut ctx.text, lbl_done.clone())
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)  # object = [slot]
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())

    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 0)  # buffer = [object]
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_call_label(&mut ctx.text, "_tg_mem_free")     # release the data buffer
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_call_label(&mut ctx.text, "_tg_mem_free")     # release the object

    def_label(&mut ctx.text, lbl_done.clone())
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_push: Append one character (UTF-8 encoded) to an owned String
# object.
# Args: x0/rdi = String object, x1/rsi = Char (code point).
# Returns: void.
def emit_tg_string_push(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_push")

  let lbl_ascii = fresh_label(ctx, ".Lstr_push_ascii")
  let lbl_two = fresh_label(ctx, ".Lstr_push_two")
  let lbl_three = fresh_label(ctx, ".Lstr_push_three")
  let lbl_four = fresh_label(ctx, ".Lstr_push_four")
  let lbl_packed = fresh_label(ctx, ".Lstr_push_packed")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # String object
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # code point

    # UTF-8 encode into X21 (bytes little-endian: byte i at bits 8i..8i+7),
    # byte count into X22 — same packing codegen_char_to_str uses.
    a64_cmp_ri(&mut ctx.text, A64::X20, 0x7F)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_ascii.clone())
    a64_cmp_ri(&mut ctx.text, A64::X20, 0x7FF)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_two.clone())
    a64_mov_ri(&mut ctx.text, A64::X15, 0xFFFF)
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X15)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_three.clone())

    def_label(&mut ctx.text, lbl_four.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_lsr(&mut ctx.text, A64::X21, A64::X21, 18)
    a64_and_ri(&mut ctx.text, A64::X21, 0x07)
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 0xF0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 12)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 24)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_ri(&mut ctx.text, A64::X22, 4)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_lsr(&mut ctx.text, A64::X21, A64::X21, 12)
    a64_and_ri(&mut ctx.text, A64::X21, 0x0F)
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 0xE0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_lsr(&mut ctx.text, A64::X15, A64::X15, 6)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 16)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_ri(&mut ctx.text, A64::X22, 3)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_lsr(&mut ctx.text, A64::X21, A64::X21, 6)
    a64_and_ri(&mut ctx.text, A64::X21, 0x1F)
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 0xC0)
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X20)
    a64_and_ri(&mut ctx.text, A64::X15, 0x3F)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 0x80)
    a64_lsl(&mut ctx.text, A64::X15, A64::X15, 8)
    a64_orr_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X15)
    a64_mov_ri(&mut ctx.text, A64::X22, 2)
    a64_b(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_mov_ri(&mut ctx.text, A64::X22, 1)

    def_label(&mut ctx.text, lbl_packed.clone())
    # Reserve: _tg_string_reserve(s, n)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_string_reserve")
    # Append: data = [s], len = [s+8]; store byte i at data[len+i]
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 0)   # data
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 8)  # len
    a64_mov_ri(&mut ctx.text, A64::X11, 0)           # i
    let lbl_app = fresh_label(ctx, ".Lstr_push_app")
    let lbl_appdone = fresh_label(ctx, ".Lstr_push_appdone")
    def_label(&mut ctx.text, lbl_app.clone())
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_appdone.clone())
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X10, A64::X11)  # data + len + i
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X9, A64::X12)
    a64_lsr(&mut ctx.text, A64::X13, A64::X21, 0)
    a64_and_ri(&mut ctx.text, A64::X13, 255)
    a64_strb(&mut ctx.text, A64::X13, A64::X12, 0)
    a64_lsr(&mut ctx.text, A64::X21, A64::X21, 8)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lbl_app.clone())
    def_label(&mut ctx.text, lbl_appdone.clone())
    # len += n; NUL at data[len]
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X22)
    a64_stur(&mut ctx.text, A64::X10, A64::X19, 8)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::XZR, A64::X12, 0)

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # String object
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)   # code point

    # UTF-8 encode into R13 (little-endian packed), byte count into R14.
    x64_cmp_ri(&mut ctx.text, X64::R12, 0x7F)
    x64_jcc(&mut ctx.text, CC::LE, lbl_ascii.clone())
    x64_cmp_ri(&mut ctx.text, X64::R12, 0x7FF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_two.clone())
    x64_cmp_ri(&mut ctx.text, X64::R12, 0xFFFF)
    x64_jcc(&mut ctx.text, CC::LE, lbl_three.clone())

    def_label(&mut ctx.text, lbl_four.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R13, 18)
    x64_and_ri(&mut ctx.text, X64::R13, 0x07)
    x64_add_ri(&mut ctx.text, X64::R13, 0xF0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R10, 12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 24)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_ri(&mut ctx.text, X64::R14, 4)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_three.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R13, 12)
    x64_and_ri(&mut ctx.text, X64::R13, 0x0F)
    x64_add_ri(&mut ctx.text, X64::R13, 0xE0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R10, 6)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 16)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_ri(&mut ctx.text, X64::R14, 3)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_two.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_shr_ri(&mut ctx.text, X64::R13, 6)
    x64_and_ri(&mut ctx.text, X64::R13, 0x1F)
    x64_add_ri(&mut ctx.text, X64::R13, 0xC0)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    x64_and_ri(&mut ctx.text, X64::R10, 0x3F)
    x64_add_ri(&mut ctx.text, X64::R10, 0x80)
    x64_shl_ri(&mut ctx.text, X64::R10, 8)
    x64_or_rr(&mut ctx.text, X64::R13, X64::R10)
    x64_mov_ri(&mut ctx.text, X64::R14, 2)
    x64_jmp(&mut ctx.text, lbl_packed.clone())

    def_label(&mut ctx.text, lbl_ascii.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::R14, 1)

    def_label(&mut ctx.text, lbl_packed.clone())
    # Reserve: _tg_string_reserve(s, n)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_string_reserve")
    # Append: data = [rbx], len = [rbx+8]; store byte i at data[len+i]
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 8)   # len
    x64_mov_ri(&mut ctx.text, X64::R8, 0)               # i
    let lbl_app = fresh_label(ctx, ".Lstr_push_app")
    let lbl_appdone = fresh_label(ctx, ".Lstr_push_appdone")
    def_label(&mut ctx.text, lbl_app.clone())
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::R14)
    x64_jcc(&mut ctx.text, CC::GE, lbl_appdone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R13)
    x64_and_ri(&mut ctx.text, X64::R9, 255)
    x64_mov_m8_r8(&mut ctx.text, X64::RAX, 0, X64::R9)
    x64_shr_ri(&mut ctx.text, X64::R13, 8)
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_jmp(&mut ctx.text, lbl_app.clone())
    def_label(&mut ctx.text, lbl_appdone.clone())
    # len += n; NUL at data[len]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RCX, 0, X64::RDX)

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_push_str: Append the bytes of a RAW NUL-terminated string
# (the str ABI — an interned literal label or a borrowed buffer) to an
# owned String object.
# Args: x0/rdi = String object, x1/rsi = raw byte pointer (str value).
# Returns: void.
def emit_tg_string_push_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_push_str")

  let lbl_len = fresh_label(ctx, ".Lstr_pushstr_len")
  let lbl_lendone = fresh_label(ctx, ".Lstr_pushstr_lendone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # String object
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # raw str ptr

    # strlen(other) → x21
    a64_mov_ri(&mut ctx.text, A64::X21, 0)
    def_label(&mut ctx.text, lbl_len.clone())
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X20, A64::X21)
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_lendone.clone())
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_b(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    # Reserve: _tg_string_reserve(s, strlen)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_string_reserve")
    # Append: data = [s], len = [s+8]; copy bytes
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)  # data
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 8)   # len
    a64_mov_ri(&mut ctx.text, A64::X10, 0)          # i
    let lbl_copy = fresh_label(ctx, ".Lstr_pushstr_copy")
    let lbl_copydone = fresh_label(ctx, ".Lstr_pushstr_copydone")
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X10)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X22, A64::X9)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X10)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())
    # len += n; NUL at data[len]
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X21)
    a64_stur(&mut ctx.text, A64::X9, A64::X19, 8)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X22, A64::X9)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # String object
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)   # raw str ptr

    # strlen(other) → r13
    x64_mov_ri(&mut ctx.text, X64::R13, 0)
    def_label(&mut ctx.text, lbl_len.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_lendone.clone())
    x64_add_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    # Reserve: _tg_string_reserve(s, strlen)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_string_reserve")
    # Append: data = [rbx], len = [rbx+8]; rdi = data + len
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)
    # len += n; NUL at data[len]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x00)

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_len: The byte length of an owned String object.
# Args: x0/rdi = String object. Returns: x0/rax = len (header field, O(1)).
def emit_tg_string_len(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_len")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 8)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 8)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_as_ptr / _tg_string_as_str: The data pointer of an owned
# String object (the borrowed str view of the object's bytes).
# Args: x0/rdi = String object. Returns: x0/rax = data pointer.
def emit_tg_string_as_ptr(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_as_ptr")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_string_as_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_as_str")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_clone: Deep-copy an owned String object (clone() allocates a
# new owned buffer — String is Clone, NOT Copy).
# Args: x0/rdi = String object. Returns: x0/rax = new String object.
def emit_tg_string_clone(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_clone")

  let lbl_copy = fresh_label(ctx, ".Lstr_clone_copy")
  let lbl_copydone = fresh_label(ctx, ".Lstr_clone_copydone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)      # source object
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)    # len
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)    # src data

    a64_bl(&mut ctx.text, "_tg_string_new")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)      # new object

    # Reserve(new, len) then set len (the buffer is cap >= len).
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_string_reserve")
    a64_ldur(&mut ctx.text, A64::X9, A64::X20, 0)     # new data
    a64_mov_ri(&mut ctx.text, A64::X10, 0)            # i
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X22, A64::X10)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X10)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())
    a64_stur(&mut ctx.text, A64::X21, A64::X20, 8)    # len
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X21)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)    # NUL

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)     # source object
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 8)  # len
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 0)  # src data

    x64_call_label(&mut ctx.text, "_tg_string_new")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)     # new object (callee-saved)

    # Reserve(new, len)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_call_label(&mut ctx.text, "_tg_string_reserve")

    # Copy: rdi = new data, rsi = src data, rcx = len
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::R14, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R12)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)
    # len = len; NUL at data[len]
    x64_mov_mr(&mut ctx.text, X64::R14, 8, X64::R12)
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x00)

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_from_static: The owned conversion of a static StrView — copy
# the bytes of a RAW NUL-terminated buffer (an interned literal label or
# any borrowed str) into a NEW owned String object. This is the explicit
# literal → String path (string_from_static / from_str_view family).
# Args: x0/rdi = raw byte pointer. Returns: x0/rax = String object.
def emit_tg_string_from_static(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_from_static")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # raw ptr
    a64_bl(&mut ctx.text, "_tg_string_new")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)   # new object
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X19)   # raw str ptr
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_string_push_str")
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # raw ptr
    x64_call_label(&mut ctx.text, "_tg_string_new")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)   # new object
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)   # raw str ptr
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_string_push_str")
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_wrap: Adopt a RAW NUL-terminated buffer as an owned String
# object (the buffer becomes the object's data; len = cap = strlen —
# further growth reallocates). Used by the String-producing conversions
# (int/float/bool/char to string, slice, concat, the file-read path) whose
# emitters already built a NUL-terminated buffer. ALLOCATION CONTRACT (
# — real lifetime): the adopted buffer MUST come from the real heap
# allocator (_tg_mem_alloc — the callers below allocate it there) and the
# OBJECT is allocated here with the same allocator, so the String drop
# (_tg_string_drop — _tg_mem_free on both) releases them.
# Args: x0/rdi = raw buffer pointer. Returns: x0/rax = String object.
def emit_tg_string_wrap(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_wrap")

  let lbl_len = fresh_label(ctx, ".Lstr_wrap_len")
  let lbl_lendone = fresh_label(ctx, ".Lstr_wrap_lendone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # raw buffer
    # strlen → x20
    a64_mov_ri(&mut ctx.text, A64::X20, 0)
    def_label(&mut ctx.text, lbl_len.clone())
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X19, A64::X20)
    a64_ldrb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_lendone.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
    a64_b(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_stur(&mut ctx.text, A64::X19, A64::X0, 0)   # data = raw buffer
    a64_stur(&mut ctx.text, A64::X20, A64::X0, 8)   # len
    a64_stur(&mut ctx.text, A64::X20, A64::X0, 16)  # cap = len
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    a64_stur(&mut ctx.text, A64::X9, A64::X0, 24)   # stride = 1

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # raw buffer
    # strlen → r12
    x64_mov_ri(&mut ctx.text, X64::R12, 0)
    def_label(&mut ctx.text, lbl_len.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_lendone.clone())
    x64_add_ri(&mut ctx.text, X64::R12, 1)
    x64_jmp(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RBX)    # data = raw buffer
    x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::R12)    # len
    x64_mov_mr(&mut ctx.text, X64::RAX, 16, X64::R12)   # cap = len
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::RAX, 24, X64::RCX)   # stride = 1

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_slice: Extract a substring and return it as an OWNED String
# object (— the owned slice). Computes sub_len = end - start
# (clamped to 0 when end < start), allocates the 32-byte String object
# header AND a sub_len+1 byte data buffer, copies the selected bytes from
# the raw source, NUL-terminates, fills the header {data, len, cap, stride}
# (cap = sub_len — the exact-fit buffer grows on demand), and returns the
# OBJECT HANDLE. A function returning String must return the String-object
# handle — the old raw-buffer (len+1 bytes + NUL, returned as a bare byte
# pointer) path is are not part of the model.
# Args: x0/rdi = raw source byte pointer (the str view — an interned
#       literal label or a String object's data pointer), x1/rsi = start,
#       x2/rdx = end.
# Returns: x0/rax = owned String object (the header pointer).
def emit_tg_string_slice(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_slice")

  let lbl_loop = fresh_label(ctx, ".Lstr_slice_loop")
  let lbl_done = fresh_label(ctx, ".Lstr_slice_done")
  let lbl_safe = fresh_label(ctx, ".Lstr_slice_safe")
  let lbl_copy = fresh_label(ctx, ".Lstr_slice_copy")
  let lbl_copydone = fresh_label(ctx, ".Lstr_slice_copy_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # src base (raw bytes)
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # start
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # end
    # x22 = sub_len = end - start; if start > end, clamp to 0.
    a64_sub_rrr(&mut ctx.text, A64::X22, A64::X21, A64::X20)
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_safe.clone())
    a64_mov_ri(&mut ctx.text, A64::X22, 0)
    def_label(&mut ctx.text, lbl_safe.clone())
    # src = data + start
    a64_add_rrr(&mut ctx.text, A64::X19, A64::X19, A64::X20)

    # Allocate the String object header (32 bytes) — the REAL heap
    # allocator (the _tg_mem_alloc/_tg_mem_free pair — the String drop
    # releases the object and this buffer). X23 is callee-saved and
    # survives the second alloc call.
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)   # header

    # Allocate the data buffer: sub_len + 1 bytes (NUL room)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)   # new data base

    # Copy sub_len bytes from src to the new buffer (x11 = offset)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X19, A64::X11)
    a64_ldrb(&mut ctx.text, A64::X13, A64::X12, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X24, A64::X11)
    a64_strb(&mut ctx.text, A64::X13, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    # NUL at data[sub_len]
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X22)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)

    # Fill the header { data, len, cap, stride }
    a64_stur(&mut ctx.text, A64::X24, A64::X23, 0)   # data
    a64_stur(&mut ctx.text, A64::X22, A64::X23, 8)   # len
    a64_stur(&mut ctx.text, A64::X22, A64::X23, 16)  # cap = len (exact fit)
    a64_mov_ri(&mut ctx.text, A64::X11, 1)
    a64_stur(&mut ctx.text, A64::X11, A64::X23, 24)  # stride = 1

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)     # return the object

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # src base (raw bytes)
    # rcx = sub_len = end - start; if start > end, clamp to 0.
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_jcc(&mut ctx.text, CC::GE, lbl_safe.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_safe.clone())
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_sub_rr(&mut ctx.text, X64::RCX, X64::RSI)
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RCX)   # sub_len
    x64_add_rr(&mut ctx.text, X64::RBX, X64::RSI)   # src = data + start

    # Allocate the String object header (32 bytes) — the REAL heap
    # allocator (the _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)   # header

    # Allocate the data buffer: sub_len + 1 bytes (NUL room)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)   # new data base

    # Copy sub_len bytes from src to the new buffer (rcx = offset)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_copydone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::RDX, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())
    # NUL at data[sub_len]
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RAX, 0, X64::RCX)

    # Fill the header { data, len, cap, stride }
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::R14)   # data
    x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)   # len
    x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)  # cap = len (exact fit)
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::RCX)  # stride = 1

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)      # return the object

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_trim: Trim ASCII whitespace (space, tab, CR, LF) from both
# ends of an OWNED String object and return a NEW owned String object with
# the trimmed span (the input is borrowed — the result is a fresh object
# whose buffer holds the trimmed bytes). The whitespace scan reads the
# object header's data/len; the span is extracted through _tg_string_slice
# (the same owned-slice path the std's slice uses).
# Args: x0/rdi = owned String object.
# Returns: x0/rax = owned String object (the trimmed result).
def emit_tg_string_trim(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_trim")

  let lbl_loop = fresh_label(ctx, ".Lstr_trim_loop")
  let lbl_loop2 = fresh_label(ctx, ".Lstr_trim_loop2")
  let lbl_wsend = fresh_label(ctx, ".Lstr_trim_wsend")
  let lbl_done = fresh_label(ctx, ".Lstr_trim_done")
  let lbl_done2 = fresh_label(ctx, ".Lstr_trim_done2")
  let lbl_slice = fresh_label(ctx, ".Lstr_trim_slice")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # object
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0) # data
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8) # len
    a64_mov_ri(&mut ctx.text, A64::X22, 0)         # start

    # Advance start while data[start] is whitespace.
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X22)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x20)  # ' '
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_slice.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x09)  # '\t'
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_slice.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x0D)  # '\r'
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_slice.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x0A)  # '\n'
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_slice.clone())
    a64_b(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_slice.clone())
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())

    # Retreat end while data[end-1] is whitespace (end stays >= start).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)
    def_label(&mut ctx.text, lbl_loop2.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_done2.clone())
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X21, 1)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X11)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x20)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_wsend.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x09)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_wsend.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x0D)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_wsend.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0x0A)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_wsend.clone())
    a64_b(&mut ctx.text, lbl_done2.clone())
    def_label(&mut ctx.text, lbl_wsend.clone())
    a64_sub_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_b(&mut ctx.text, lbl_loop2.clone())
    def_label(&mut ctx.text, lbl_done2.clone())

    # Extract the span through the owned-slice path.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_bl(&mut ctx.text, "_tg_string_slice")

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # object
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 0) # data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8) # len
    x64_mov_ri(&mut ctx.text, X64::R14, 0)           # start

    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x20)
    x64_jcc(&mut ctx.text, CC::E, lbl_slice.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x09)
    x64_jcc(&mut ctx.text, CC::E, lbl_slice.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x0D)
    x64_jcc(&mut ctx.text, CC::E, lbl_slice.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x0A)
    x64_jcc(&mut ctx.text, CC::E, lbl_slice.clone())
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_slice.clone())
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())

    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)
    def_label(&mut ctx.text, lbl_loop2.clone())
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lbl_done2.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x20)
    x64_jcc(&mut ctx.text, CC::E, lbl_wsend.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x09)
    x64_jcc(&mut ctx.text, CC::E, lbl_wsend.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x0D)
    x64_jcc(&mut ctx.text, CC::E, lbl_wsend.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0x0A)
    x64_jcc(&mut ctx.text, CC::E, lbl_wsend.clone())
    x64_jmp(&mut ctx.text, lbl_done2.clone())
    def_label(&mut ctx.text, lbl_wsend.clone())
    x64_sub_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, lbl_loop2.clone())
    def_label(&mut ctx.text, lbl_done2.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_string_slice")

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_trim_matches: Trim every byte of the pattern string from both
# ends of an OWNED String object and return a NEW owned String object with
# the trimmed span (the same owned-slice extraction as _tg_string_trim; a
# byte of the input is trimmed when it equals ANY pattern byte). An empty
# pattern trims nothing (the full span is copied).
# Args: x0/rdi = owned String object, x1/rsi = raw pattern bytes (the
#       static StrView or a String object's data pointer — NUL-terminated).
# Returns: x0/rax = owned String object (the trimmed result).
def emit_tg_string_trim_matches(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_trim_matches")

  let lbl_loop = fresh_label(ctx, ".Lstr_trimch_loop")
  let lbl_loop2 = fresh_label(ctx, ".Lstr_trimch_loop2")
  let lbl_pat = fresh_label(ctx, ".Lstr_trimch_pat")
  let lbl_pat2 = fresh_label(ctx, ".Lstr_trimch_pat2")
  let lbl_patend = fresh_label(ctx, ".Lstr_trimch_patend")
  let lbl_patnext = fresh_label(ctx, ".Lstr_trimch_patnext")
  let lbl_patnext2 = fresh_label(ctx, ".Lstr_trimch_patnext2")
  let lbl_done = fresh_label(ctx, ".Lstr_trimch_done")
  let lbl_done2 = fresh_label(ctx, ".Lstr_trimch_done2")
  let lbl_slice = fresh_label(ctx, ".Lstr_trimch_slice")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # object
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X1)   # pattern
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0) # data
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8) # len
    a64_mov_ri(&mut ctx.text, A64::X22, 0)         # start

    # Advance start while data[start] is a pattern byte.
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X22)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_mov_ri(&mut ctx.text, A64::X13, 0)
    def_label(&mut ctx.text, lbl_pat.clone())
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X23, A64::X13)
    a64_ldrb(&mut ctx.text, A64::X15, A64::X14, 0)
    a64_cmp_ri(&mut ctx.text, A64::X15, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_slice.clone())
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lbl_pat.clone())
    def_label(&mut ctx.text, lbl_slice.clone())
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())

    # Retreat end while data[end-1] is a pattern byte (end stays >= start).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)
    def_label(&mut ctx.text, lbl_loop2.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_done2.clone())
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X21, 1)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X11)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_mov_ri(&mut ctx.text, A64::X13, 0)
    def_label(&mut ctx.text, lbl_pat2.clone())
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X23, A64::X13)
    a64_ldrb(&mut ctx.text, A64::X15, A64::X14, 0)
    a64_cmp_ri(&mut ctx.text, A64::X15, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done2.clone())
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_patend.clone())
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lbl_pat2.clone())
    def_label(&mut ctx.text, lbl_patend.clone())
    a64_sub_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_b(&mut ctx.text, lbl_loop2.clone())
    def_label(&mut ctx.text, lbl_done2.clone())

    # Extract the span through the owned-slice path.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_bl(&mut ctx.text, "_tg_string_slice")

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # object
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RSI)   # pattern
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 0) # data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8) # len
    x64_mov_ri(&mut ctx.text, X64::R14, 0)           # start

    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_pat.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RDX, X64::RDX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RDX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_slice.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_pat.clone())
    def_label(&mut ctx.text, lbl_slice.clone())
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())

    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)
    def_label(&mut ctx.text, lbl_loop2.clone())
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lbl_done2.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_pat2.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RDX, X64::RDX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RDX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_done2.clone())
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_patend.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_pat2.clone())
    def_label(&mut ctx.text, lbl_patend.clone())
    x64_sub_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, lbl_loop2.clone())
    def_label(&mut ctx.text, lbl_done2.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_string_slice")

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_tolower: Map the ASCII uppercase bytes (A-Z) of an OWNED
# String object to their lowercase forms and return a NEW owned String
# object with the mapped bytes (non-ASCII bytes pass through unchanged;
# the input is borrowed). The result is a fresh object — the String ABI's
# NUL-terminated buffer and {data, len, cap, stride} header.
# Args: x0/rdi = owned String object.
# Returns: x0/rax = owned String object (the mapped result).
def emit_tg_string_tolower(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_string_case_map(ctx, "_tg_string_tolower", 32)
end

# _tg_string_toupper: Map the ASCII lowercase bytes (a-z) of an OWNED
# String object to their uppercase forms and return a NEW owned String
# object with the mapped bytes (non-ASCII bytes pass through unchanged;
# the input is borrowed).
# Args: x0/rdi = owned String object.
# Returns: x0/rax = owned String object (the mapped result).
def emit_tg_string_toupper(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_string_case_map(ctx, "_tg_string_toupper", -32)
end

# The shared ASCII case-map body (delta = +32 lowercases A-Z; -32
# uppercases a-z): allocates the object header + a len+1 buffer, maps each
# byte in the range, NUL-terminates, fills the header, returns the object.
def emit_tg_string_case_map(ctx: &mut RuntimeEmitCtx, fn_name: String, delta: Int) -> Unit
  def_runtime_fn(ctx, fn_name)

  let lbl_loop = fresh_label(ctx, ".Lstr_case_loop")
  let lbl_upper = fresh_label(ctx, ".Lstr_case_upper")
  let lbl_lower = fresh_label(ctx, ".Lstr_case_lower")
  let lbl_done = fresh_label(ctx, ".Lstr_case_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # object
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0) # data
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8) # len

    # Allocate the object header (x22) and the result buffer (x23) — the
    # REAL heap allocator (the _tg_mem_alloc/_tg_mem_free pair — the
    # String drop releases both).
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)   # header

    a64_add_rri(&mut ctx.text, A64::X0, A64::X21, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)   # new data base

    a64_mov_ri(&mut ctx.text, A64::X24, 0)         # i
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X24)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    if delta > 0 then
      a64_cmp_ri(&mut ctx.text, A64::X12, 0x41)   # 'A'
      a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_lower.clone())
      a64_cmp_ri(&mut ctx.text, A64::X12, 0x5A)   # 'Z'
      a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_lower.clone())
      a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 0x20)
    else
      a64_cmp_ri(&mut ctx.text, A64::X12, 0x61)   # 'a'
      a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_upper.clone())
      a64_cmp_ri(&mut ctx.text, A64::X12, 0x7A)   # 'z'
      a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_upper.clone())
      a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 0x20)
    end
    def_label(&mut ctx.text, lbl_lower.clone())
    def_label(&mut ctx.text, lbl_upper.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X24)
    a64_strb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X24, A64::X24, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X23, A64::X21)
    a64_strb(&mut ctx.text, A64::XZR, A64::X11, 0)   # NUL

    a64_stur(&mut ctx.text, A64::X23, A64::X22, 0)   # data
    a64_stur(&mut ctx.text, A64::X21, A64::X22, 8)   # len
    a64_stur(&mut ctx.text, A64::X21, A64::X22, 16)  # cap = len
    a64_mov_ri(&mut ctx.text, A64::X11, 1)
    a64_stur(&mut ctx.text, A64::X11, A64::X22, 24)  # stride = 1
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # object
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 0) # data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8) # len

    # Allocate the object header (x14) and the result buffer (rbx) — the
    # REAL heap allocator (the _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)   # header

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)   # new data base (rbx free now)

    x64_mov_ri(&mut ctx.text, X64::RCX, 0)          # i
    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    if delta > 0 then
      x64_cmp_ri(&mut ctx.text, X64::RAX, 0x41)
      x64_jcc(&mut ctx.text, CC::L, lbl_lower.clone())
      x64_cmp_ri(&mut ctx.text, X64::RAX, 0x5A)
      x64_jcc(&mut ctx.text, CC::G, lbl_lower.clone())
      x64_add_ri(&mut ctx.text, X64::RAX, 0x20)
    else
      x64_cmp_ri(&mut ctx.text, X64::RAX, 0x61)
      x64_jcc(&mut ctx.text, CC::L, lbl_upper.clone())
      x64_cmp_ri(&mut ctx.text, X64::RAX, 0x7A)
      x64_jcc(&mut ctx.text, CC::G, lbl_upper.clone())
      x64_sub_ri(&mut ctx.text, X64::RAX, 0x20)
    end
    def_label(&mut ctx.text, lbl_lower.clone())
    def_label(&mut ctx.text, lbl_upper.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::RDX, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RAX, 0, X64::RCX)   # NUL

    x64_mov_mr(&mut ctx.text, X64::R14, 0, X64::RBX)      # data
    x64_mov_mr(&mut ctx.text, X64::R14, 8, X64::R13)      # len
    x64_mov_mr(&mut ctx.text, X64::R14, 16, X64::R13)     # cap = len
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::R14, 24, X64::RCX)     # stride = 1
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_replace: Byte-pattern replacement over an OWNED String object:
# every non-overlapping occurrence of the `from` pattern (raw NUL-
# terminated bytes) is replaced by the `to` bytes, and the result is a NEW
# owned String object (the input is borrowed). An empty `from` pattern
# replaces nothing (the object is cloned). The result buffer is sized
# exactly (slen - n*flen + n*tlen) and NUL-terminated.
# Args: x0/rdi = owned String object, x1/rsi = raw `from` bytes,
#       x2/rdx = raw `to` bytes.
# Returns: x0/rax = owned String object (the replaced result).
def emit_tg_string_replace(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_replace")

  let lbl_flen = fresh_label(ctx, ".Lstr_rep_flen")
  let lbl_flen_next = fresh_label(ctx, ".Lstr_rep_flen_next")
  let lbl_tlen = fresh_label(ctx, ".Lstr_rep_tlen")
  let lbl_tlen_next = fresh_label(ctx, ".Lstr_rep_tlen_next")
  let lbl_epilogue = fresh_label(ctx, ".Lstr_rep_epilogue")
  let lbl_cnt = fresh_label(ctx, ".Lstr_rep_cnt")
  let lbl_count_start = fresh_label(ctx, ".Lstr_rep_count_start")
  let lbl_cnt_outer = fresh_label(ctx, ".Lstr_rep_cnt_outer")
  let lbl_cnt_cmp = fresh_label(ctx, ".Lstr_rep_cnt_cmp")
  let lbl_cnt_match = fresh_label(ctx, ".Lstr_rep_cnt_match")
  let lbl_cnt_advance = fresh_label(ctx, ".Lstr_rep_cnt_advance")
  let lbl_count_done = fresh_label(ctx, ".Lstr_rep_count_done")
  let lbl_bld = fresh_label(ctx, ".Lstr_rep_bld")
  let lbl_bld_cmp = fresh_label(ctx, ".Lstr_rep_bld_cmp")
  let lbl_bld_match = fresh_label(ctx, ".Lstr_rep_bld_match")
  let lbl_bld_cpto = fresh_label(ctx, ".Lstr_rep_bld_cpto")
  let lbl_bld_md = fresh_label(ctx, ".Lstr_rep_bld_md")
  let lbl_bld_byte = fresh_label(ctx, ".Lstr_rep_bld_byte")
  let lbl_tail = fresh_label(ctx, ".Lstr_rep_tail")
  let lbl_finish = fresh_label(ctx, ".Lstr_rep_finish")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)

    a64_ldur(&mut ctx.text, A64::X19, A64::X0, 0)  # data
    a64_ldur(&mut ctx.text, A64::X20, A64::X0, 8)  # slen
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X1)   # from
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X2)   # to

    # flen = strlen(from) -> x23
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_flen.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X21, A64::X23)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_tlen.clone())
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_flen.clone())
    # tlen = strlen(to) -> x24
    def_label(&mut ctx.text, lbl_tlen.clone())
    a64_mov_ri(&mut ctx.text, A64::X24, 0)
    def_label(&mut ctx.text, lbl_tlen_next.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X22, A64::X24)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_cnt.clone())
    a64_add_rri(&mut ctx.text, A64::X24, A64::X24, 1)
    a64_b(&mut ctx.text, lbl_tlen_next.clone())
    # Empty `from` pattern: nothing to replace — an owned clone of the
    # object is the no-op result (x0 still holds the object).
    def_label(&mut ctx.text, lbl_cnt.clone())
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_count_start.clone())
    a64_bl(&mut ctx.text, "_tg_string_clone")
    a64_b(&mut ctx.text, lbl_epilogue.clone())

    # Count occurrences: n in x11; cursor in x12; limit = data+slen-flen.
    def_label(&mut ctx.text, lbl_count_start.clone())
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X19)
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X19, A64::X20)
    a64_sub_rrr(&mut ctx.text, A64::X13, A64::X13, A64::X23)
    def_label(&mut ctx.text, lbl_cnt_outer.clone())
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_count_done.clone())
    a64_mov_ri(&mut ctx.text, A64::X14, 0)   # j
    def_label(&mut ctx.text, lbl_cnt_cmp.clone())
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_cnt_match.clone())
    a64_add_rrr(&mut ctx.text, A64::X15, A64::X12, A64::X14)
    a64_ldrb(&mut ctx.text, A64::X15, A64::X15, 0)
    a64_add_rrr(&mut ctx.text, A64::X16, A64::X21, A64::X14)
    a64_ldrb(&mut ctx.text, A64::X16, A64::X16, 0)
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X16)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_cnt_advance.clone())
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 1)
    a64_b(&mut ctx.text, lbl_cnt_cmp.clone())
    def_label(&mut ctx.text, lbl_cnt_match.clone())
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rr(&mut ctx.text, A64::X12, A64::X12, A64::X23)
    a64_b(&mut ctx.text, lbl_cnt_outer.clone())
    def_label(&mut ctx.text, lbl_cnt_advance.clone())
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_cnt_outer.clone())

    # result_len = slen - n*flen + n*tlen (n saved in x18; result in x11)
    def_label(&mut ctx.text, lbl_count_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X18, A64::X11)   # save n
    a64_mul_rrr(&mut ctx.text, A64::X15, A64::X11, A64::X23)
    a64_sub_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X15)
    a64_mul_rrr(&mut ctx.text, A64::X15, A64::X18, A64::X24)
    a64_add_rr(&mut ctx.text, A64::X11, A64::X11, A64::X15)

    # Allocate the object header (x25) and the result buffer (x26) — the
    # REAL heap allocator (the _tg_mem_alloc/_tg_mem_free pair — the
    # String drop releases both).
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X25, A64::X0)   # header
    a64_add_rri(&mut ctx.text, A64::X0, A64::X11, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X26, A64::X0)   # out base

    # Build: src cursor in x12, dst cursor in x13, match limit in x14.
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X26)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X19, A64::X20)
    a64_sub_rrr(&mut ctx.text, A64::X14, A64::X14, A64::X23)
    def_label(&mut ctx.text, lbl_bld.clone())
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_tail.clone())
    a64_mov_ri(&mut ctx.text, A64::X15, 0)   # j
    def_label(&mut ctx.text, lbl_bld_cmp.clone())
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_bld_match.clone())
    a64_add_rrr(&mut ctx.text, A64::X16, A64::X12, A64::X15)
    a64_ldrb(&mut ctx.text, A64::X16, A64::X16, 0)
    a64_add_rrr(&mut ctx.text, A64::X17, A64::X21, A64::X15)
    a64_ldrb(&mut ctx.text, A64::X17, A64::X17, 0)
    a64_cmp_rr(&mut ctx.text, A64::X16, A64::X17)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_bld_byte.clone())
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 1)
    a64_b(&mut ctx.text, lbl_bld_cmp.clone())
    def_label(&mut ctx.text, lbl_bld_match.clone())
    # copy tlen bytes from `to` to dst
    a64_mov_ri(&mut ctx.text, A64::X15, 0)
    def_label(&mut ctx.text, lbl_bld_cpto.clone())
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X24)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_bld_md.clone())
    a64_add_rrr(&mut ctx.text, A64::X16, A64::X22, A64::X15)
    a64_ldrb(&mut ctx.text, A64::X16, A64::X16, 0)
    a64_add_rrr(&mut ctx.text, A64::X17, A64::X13, A64::X15)
    a64_strb(&mut ctx.text, A64::X16, A64::X17, 0)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 1)
    a64_b(&mut ctx.text, lbl_bld_cpto.clone())
    def_label(&mut ctx.text, lbl_bld_md.clone())
    a64_add_rr(&mut ctx.text, A64::X13, A64::X13, A64::X24)
    a64_add_rr(&mut ctx.text, A64::X12, A64::X12, A64::X23)
    a64_b(&mut ctx.text, lbl_bld.clone())
    def_label(&mut ctx.text, lbl_bld_byte.clone())
    a64_ldrb(&mut ctx.text, A64::X16, A64::X12, 0)
    a64_strb(&mut ctx.text, A64::X16, A64::X13, 0)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lbl_bld.clone())
    # tail: copy the remaining (< flen) bytes
    def_label(&mut ctx.text, lbl_tail.clone())
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X19, A64::X20)
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_finish.clone())
    a64_ldrb(&mut ctx.text, A64::X16, A64::X12, 0)
    a64_strb(&mut ctx.text, A64::X16, A64::X13, 0)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lbl_tail.clone())

    # NUL-terminate, fill the header {data, len, cap, stride}, return.
    def_label(&mut ctx.text, lbl_finish.clone())
    a64_strb(&mut ctx.text, A64::XZR, A64::X13, 0)
    a64_stur(&mut ctx.text, A64::X26, A64::X25, 0)
    a64_stur(&mut ctx.text, A64::X11, A64::X25, 8)
    a64_stur(&mut ctx.text, A64::X11, A64::X25, 16)
    a64_mov_ri(&mut ctx.text, A64::X15, 1)
    a64_stur(&mut ctx.text, A64::X15, A64::X25, 24)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X25)
    def_label(&mut ctx.text, lbl_epilogue.clone())
    a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_sub_ri(&mut ctx.text, X64::RSP, 40)   # [rbp-8]=flen, [rbp-16]=tlen, [rbp-24]=out, [rbp-32]=obj, [rbp-40]=slen
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_mr(&mut ctx.text, X64::RBP, -32, X64::RDI) # object
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 8)   # slen
    x64_mov_mr(&mut ctx.text, X64::RBP, -40, X64::R12) # slen (saved)
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RSI)      # from
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RDX)      # to

    # flen = strlen(from) -> [rbp-8]
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_flen.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_tlen.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_flen.clone())
    def_label(&mut ctx.text, lbl_tlen.clone())
    x64_mov_mr(&mut ctx.text, X64::RBP, -8, X64::RCX)   # flen
    # tlen = strlen(to) -> [rbp-16]
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lbl_tlen_next.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_cnt.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_tlen_next.clone())
    # Empty `from` pattern: nothing to replace — an owned clone of the
    # object is the no-op result.
    def_label(&mut ctx.text, lbl_cnt.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -8)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::NE, lbl_count_start.clone())
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBP, -32)
    x64_call_label(&mut ctx.text, "_tg_string_clone")
    x64_jmp(&mut ctx.text, lbl_epilogue.clone())

    # Count occurrences: n in r15; cursor in rsi; limit in rdx.
    def_label(&mut ctx.text, lbl_count_start.clone())
    x64_mov_ri(&mut ctx.text, X64::R15, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_sub_rr(&mut ctx.text, X64::RDX, X64::RCX)
    def_label(&mut ctx.text, lbl_cnt_outer.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RDX)
    x64_jcc(&mut ctx.text, CC::G, lbl_count_done.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)   # j
    def_label(&mut ctx.text, lbl_cnt_cmp.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -8)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_cnt_match.clone())
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RSI)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R13)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R9, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::R9)
    x64_jcc(&mut ctx.text, CC::NE, lbl_cnt_advance.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_cnt_cmp.clone())
    def_label(&mut ctx.text, lbl_cnt_match.clone())
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_jmp(&mut ctx.text, lbl_cnt_outer.clone())
    def_label(&mut ctx.text, lbl_cnt_advance.clone())
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_cnt_outer.clone())

    # result_len = slen - n*flen + n*tlen (r15 = n; result in r12)
    def_label(&mut ctx.text, lbl_count_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)   # n*flen
    x64_sub_rr(&mut ctx.text, X64::R12, X64::RAX)    # slen - n*flen
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -16)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)   # n*tlen
    x64_add_rr(&mut ctx.text, X64::R12, X64::RAX)    # result_len

    # Allocate the object header (r15) and the result buffer ([rbp-24]) —
    # the REAL heap allocator (the _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)       # header
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_mr(&mut ctx.text, X64::RBP, -24, X64::RAX)  # out base

    # Build: src cursor in rsi, dst cursor in rdi, match limit in rdx.
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBP, -24)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_sub_rr(&mut ctx.text, X64::RDX, X64::RCX)
    def_label(&mut ctx.text, lbl_bld.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RDX)
    x64_jcc(&mut ctx.text, CC::G, lbl_tail.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)   # j
    def_label(&mut ctx.text, lbl_bld_cmp.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -8)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_bld_match.clone())
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RSI)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R13)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R9, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::R9)
    x64_jcc(&mut ctx.text, CC::NE, lbl_bld_byte.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_bld_cmp.clone())
    def_label(&mut ctx.text, lbl_bld_match.clone())
    # copy tlen bytes from `to` to dst
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)  # tlen
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)              # j
    def_label(&mut ctx.text, lbl_bld_cpto.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_bld_md.clone())
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R14)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDI)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::R9, 0, X64::R8)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_bld_cpto.clone())
    def_label(&mut ctx.text, lbl_bld_md.clone())
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)   # dst += tlen
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RCX)   # src += flen
    x64_jmp(&mut ctx.text, lbl_bld.clone())
    def_label(&mut ctx.text, lbl_bld_byte.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RSI, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RDI, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_jmp(&mut ctx.text, lbl_bld.clone())
    # tail: copy the remaining (< flen) bytes (bound = data + SLEN)
    def_label(&mut ctx.text, lbl_tail.clone())
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBP, -40)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RBX)
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RDX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_finish.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RSI, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RDI, 0, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_jmp(&mut ctx.text, lbl_tail.clone())

    # NUL-terminate, fill the header {data, len, cap, stride}, return.
    def_label(&mut ctx.text, lbl_finish.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_m8_r8(&mut ctx.text, X64::RDI, 0, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -24)
    x64_mov_mr(&mut ctx.text, X64::R15, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::R15, 8, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::R15, 16, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::R15, 24, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)

    def_label(&mut ctx.text, lbl_epilogue.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_add_ri(&mut ctx.text, X64::RSP, 40)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_split: Split an OWNED String object on a separator (raw
# NUL-terminated bytes) into a Vec[String] of OWNED String objects — the
# collection ABI result: the returned value is the Vec header pointer
# {data@0, len@8, cap@16, stride@24} with stride 8 (each element is the
# 8-byte handle of an owned String object produced by _tg_string_slice —
# the same owned-slice path the std's slice uses). An EMPTY separator
# splits into single characters (the std's documented behavior). The
# input object is borrowed; every segment is a fresh owned object.
# Args: x0/rdi = owned String object, x1/rsi = raw separator bytes.
# Returns: x0/rax = Vec[String] handle.
def emit_tg_string_split(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_split")

  let lbl_seplen = fresh_label(ctx, ".Lstr_split_seplen")
  let lbl_seplen_next = fresh_label(ctx, ".Lstr_split_seplen_next")
  let lbl_chars = fresh_label(ctx, ".Lstr_split_chars")
  let lbl_scan = fresh_label(ctx, ".Lstr_split_scan")
  let lbl_cmp = fresh_label(ctx, ".Lstr_split_cmp")
  let lbl_match = fresh_label(ctx, ".Lstr_split_match")
  let lbl_next = fresh_label(ctx, ".Lstr_split_next")
  let lbl_final = fresh_label(ctx, ".Lstr_split_final")
  let lbl_done = fresh_label(ctx, ".Lstr_split_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)

    a64_mov_ri(&mut ctx.text, A64::X19, 0)        # start
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # sep
    a64_ldur(&mut ctx.text, A64::X21, A64::X0, 0) # data
    a64_ldur(&mut ctx.text, A64::X22, A64::X0, 8) # slen

    # seplen = strlen(sep) -> x23
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_seplen.clone())
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X23)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_chars.clone())
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_seplen.clone())

    # The result Vec[String]: element stride 8 (the String-object handle).
    def_label(&mut ctx.text, lbl_chars.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)  # vec
    a64_mov_ri(&mut ctx.text, A64::X25, 0)        # i
    # Empty separator: split into single characters.
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_chars2.clone())
    a64_b(&mut ctx.text, lbl_scan.clone())
    def_label(&mut ctx.text, lbl_chars2.clone())
    a64_cmp_rr(&mut ctx.text, A64::X25, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X25)
    a64_add_rri(&mut ctx.text, A64::X2, A64::X25, 1)
    a64_bl(&mut ctx.text, "_tg_string_slice")
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)   # segment handle
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)  # vec
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_add_rri(&mut ctx.text, A64::X25, A64::X25, 1)
    a64_b(&mut ctx.text, lbl_chars2.clone())

    # Non-empty separator: scan for occurrences; limit = data+slen-seplen.
    def_label(&mut ctx.text, lbl_scan.clone())
    a64_add_rrr(&mut ctx.text, A64::X26, A64::X21, A64::X22)
    a64_sub_rrr(&mut ctx.text, A64::X26, A64::X26, A64::X23)
    a64_mov_ri(&mut ctx.text, A64::X25, 0)
    def_label(&mut ctx.text, lbl_cmp.clone())
    a64_cmp_rr(&mut ctx.text, A64::X25, A64::X26)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lbl_final.clone())
    a64_mov_ri(&mut ctx.text, A64::X11, 0)   # j
    def_label(&mut ctx.text, lbl_next.clone())
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_match.clone())
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X21, A64::X25)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X11)
    a64_ldrb(&mut ctx.text, A64::X12, A64::X12, 0)
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X20, A64::X11)
    a64_ldrb(&mut ctx.text, A64::X13, A64::X13, 0)
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_match2.clone())
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lbl_next.clone())
    # Match at i: push slice(data, start, i); i += seplen; start = i.
    def_label(&mut ctx.text, lbl_match.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X25)
    a64_bl(&mut ctx.text, "_tg_string_slice")
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_add_rr(&mut ctx.text, A64::X25, A64::X25, A64::X23)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X25)
    a64_b(&mut ctx.text, lbl_cmp.clone())
    # No match at i: advance one byte.
    def_label(&mut ctx.text, lbl_match2.clone())
    a64_add_rri(&mut ctx.text, A64::X25, A64::X25, 1)
    a64_b(&mut ctx.text, lbl_cmp.clone())

    # Final segment: slice(data, start, slen).
    def_label(&mut ctx.text, lbl_final.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X22)
    a64_bl(&mut ctx.text, "_tg_string_slice")
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)
    a64_bl(&mut ctx.text, "_tg_array_push")

    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)   # return the Vec handle
    a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_sub_ri(&mut ctx.text, X64::RSP, 16)   # [rbp-8]=start, [rbp-16]=i
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, -8, X64::RAX)  # start = 0
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RSI)      # sep
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 8)   # slen

    # seplen = strlen(sep) -> r14
    x64_mov_ri(&mut ctx.text, X64::R14, 0)
    def_label(&mut ctx.text, lbl_seplen.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_chars.clone())
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_seplen.clone())

    # The result Vec[String]: element stride 8 (the String-object handle).
    def_label(&mut ctx.text, lbl_chars.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)      # vec
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX) # i = 0
    # Empty separator: split into single characters.
    x64_cmp_ri(&mut ctx.text, X64::R14, 0)
    x64_jcc(&mut ctx.text, CC::NE, lbl_scan.clone())
    def_label(&mut ctx.text, lbl_chars2.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBP, -16)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBP, -16)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_call_label(&mut ctx.text, "_tg_string_slice")
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)      # segment handle
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)      # vec
    x64_call_label(&mut ctx.text, "_tg_array_push")
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX)
    x64_jmp(&mut ctx.text, lbl_chars2.clone())

    # Non-empty separator: scan for occurrences; limit = data+slen-seplen.
    def_label(&mut ctx.text, lbl_scan.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_sub_rr(&mut ctx.text, X64::RDX, X64::R14)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX) # i = 0
    def_label(&mut ctx.text, lbl_cmp.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::G, lbl_final.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)   # j
    def_label(&mut ctx.text, lbl_next.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_jcc(&mut ctx.text, CC::GE, lbl_match.clone())
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBP, -16)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RBX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R13)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R9, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::R9)
    x64_jcc(&mut ctx.text, CC::NE, lbl_match2.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_next.clone())
    # Match at i: push slice(data, start, i); i += seplen; start = i.
    def_label(&mut ctx.text, lbl_match.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBP, -8)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBP, -16)
    x64_call_label(&mut ctx.text, "_tg_string_slice")
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    x64_call_label(&mut ctx.text, "_tg_array_push")
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RBP, -8, X64::RAX)
    x64_jmp(&mut ctx.text, lbl_cmp.clone())
    # No match at i: advance one byte.
    def_label(&mut ctx.text, lbl_match2.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX)
    x64_jmp(&mut ctx.text, lbl_cmp.clone())

    # Final segment: slice(data, start, slen).
    def_label(&mut ctx.text, lbl_final.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBP, -8)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_string_slice")
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)      # return the Vec handle
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_add_ri(&mut ctx.text, X64::RSP, 16)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

def emit_string_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_string_new(ctx)
  emit_tg_string_reserve(ctx)
  emit_tg_string_drop(ctx)
  emit_tg_string_push(ctx)
  emit_tg_string_push_str(ctx)
  emit_tg_string_len(ctx)
  emit_tg_string_as_ptr(ctx)
  emit_tg_string_as_str(ctx)
  emit_tg_string_clone(ctx)
  emit_tg_string_from_static(ctx)
  emit_tg_string_wrap(ctx)
  emit_tg_string_slice(ctx)
  emit_tg_string_trim(ctx)
  emit_tg_string_trim_matches(ctx)
  emit_tg_string_tolower(ctx)
  emit_tg_string_toupper(ctx)
  emit_tg_string_replace(ctx)
  emit_tg_string_split(ctx)
end

# _tg_status: Run a command and get exit status
# Args: x0/rdi = command string ptr
# Returns: exit code (Int)
# UNSUPPORTED: subprocess execution (fork/exec/wait) is not implemented in
# the runtime. Fail closed with a trap instead of fabricating success (0).
def emit_tg_status(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_status")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_output: Run a command and capture output
# Args: x0/rdi = command string ptr
# Returns: output string ptr
# UNSUPPORTED: command execution with output capture (pipe + fork + exec +
# read) is not implemented in the runtime. Fail closed with a trap instead
# of fabricating an empty string.
def emit_tg_output(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_output")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_stdout_string: Capture stdout as string
# Returns: string ptr
# UNSUPPORTED: delegates to _tg_output, which fails closed (trap) until
# command-output capture is implemented — no fabricated empty string.
def emit_tg_stdout_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stdout_string")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_stderr_string: Capture stderr as string
# Returns: string ptr
# UNSUPPORTED: delegates to _tg_output, which fails closed (trap) until
# command-output capture is implemented — no fabricated empty string.
def emit_tg_stderr_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stderr_string")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Array/Vec Runtime Implementation
# ———————————————————————————————————————————————————————————————
#
# Vec[T] layout (32 bytes — the HeapVecHeader row of the engine's F2 table,
# repr_header_size(Repr::HeapVecHeader); field offsets from
# container_field_offset):
#   [ptr+0]:  data   - pointer to the element buffer
#   [ptr+8]:  len    - current length (number of elements)
#   [ptr+16]: cap    - allocated capacity (number of element slots)
#   [ptr+24]: stride - element stride in bytes; set at creation from the
#                      CONCRETE element type (element_stride_bytes(T) —
#                      category-derived, so stride == size_of(T) for every
#                      aligned aggregate). EVERY element address is
#                      data + index*stride, every allocation is
#                      cap*stride bytes, and every element TRANSFER is
#                      `stride` bytes.
#
# THE UNIFIED TRANSFER RULE: the element transfer uses the
# element's value category (classify_value_category — the layout engine's
# single authority):
#   ZeroSized        -> nothing is copied (stride 0)
#   Scalar(width)    -> the VALUE WORD in the register, stored/loaded at
#                       the width (the width dispatch, strides 1/2/4/8)
#   ScalarPair(16)   -> the 16-byte image ADDRESS in the register; the
#                       runtime byte-copies the full image
#   ByAddress(size)  -> the image ADDRESS in the register; the runtime
#                       byte-copies the complete image (size bytes)
# The transfer-size gate IS the header stride: stride in {1,2,4,8} -> the
# scalar width store/load (emit_*_transfer_store / emit_*_load_elem_arg
# dispatch to the width helpers); any other stride -> the byte-copy of
# `stride` bytes (the copy loops). Internal element moves (grow's copy,
# remove/insert shifts, reverse's swap) ALWAYS byte-copy the full image.
#
# Initial capacity: 8 elements
# Growth factor: 2x

# Width-dispatch STORE: [addr] = value, width from stride.
# stride in {1,2,4,8} -> that width; any other stride -> 8 bytes (value word).
# Clobbers nothing but the flags; labels are local to the helper emission.
def emit_a64_store_width(ctx: &mut RuntimeEmitCtx, addr: A64, value: A64, stride: A64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_store_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_store_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_store_4")
  let lbl_done = fresh_label(ctx, ".Lw_store_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w1.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w2.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w4.clone())
  a64_str(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  a64_str_w(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  a64_strh(&mut ctx.text, value, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  a64_strb(&mut ctx.text, value, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch LOAD: dst = [addr], width from stride, zero-extended.
def emit_a64_load_width(ctx: &mut RuntimeEmitCtx, dst: A64, addr: A64, stride: A64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_load_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_load_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_load_4")
  let lbl_done = fresh_label(ctx, ".Lw_load_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w1.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w2.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_w4.clone())
  a64_ldr(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  a64_ldr_w(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  a64_ldrh(&mut ctx.text, dst, addr, 0)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  a64_ldrb(&mut ctx.text, dst, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch STORE (x86-64): [addr] = value, width from stride.
# Clobbers nothing; caller-saved registers passed in are preserved.
def emit_x64_store_width(ctx: &mut RuntimeEmitCtx, addr: X64, value: X64, stride: X64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_store_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_store_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_store_4")
  let lbl_done = fresh_label(ctx, ".Lw_store_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_w1.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_w2.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_w4.clone())
  x64_mov_mr(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  x64_mov_m32_r32(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  x64_mov_m16_r16(&mut ctx.text, addr, 0, value)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  x64_mov_m8_r8(&mut ctx.text, addr, 0, value)
  def_label(&mut ctx.text, lbl_done)
end

# Width-dispatch LOAD (x86-64): dst = [addr], width from stride, zero-extended.
def emit_x64_load_width(ctx: &mut RuntimeEmitCtx, dst: X64, addr: X64, stride: X64) -> Unit
  let lbl_w1 = fresh_label(ctx, ".Lw_load_1")
  let lbl_w2 = fresh_label(ctx, ".Lw_load_2")
  let lbl_w4 = fresh_label(ctx, ".Lw_load_4")
  let lbl_done = fresh_label(ctx, ".Lw_load_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_w1.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_w2.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_w4.clone())
  x64_mov_rm(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w4)
  x64_mov_r32_m32(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w2)
  x64_movzx_r64_m16(&mut ctx.text, dst, addr, 0)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_w1)
  x64_movzx_r64_m8(&mut ctx.text, dst, addr, 0)
  def_label(&mut ctx.text, lbl_done)
end

# ———————————————————————————————————————————————————————————————
# — the CATEGORY-DRIVEN element transfer (the unified rule).
# For an element of concrete type T the collection intrinsic's transfer
# uses T's value category (classify_value_category — the layout engine's
# single authority):
#   ZeroSized        -> nothing is copied (stride 0)
#   Scalar(width)    -> the VALUE WORD in the register, stored/loaded at
#                       the width (the width dispatch, strides 1/2/4/8)
#   ScalarPair(16)   -> the 16-byte image ADDRESS in the register; the
#                       runtime byte-copies the full image
#   ByAddress(size)  -> the image ADDRESS in the register; the runtime
#                       byte-copies the complete image (size bytes)
# The transfer size is always the header stride: element_stride_bytes is
# category-derived (Scalar(w)->w, ScalarPair->16, ByAddress(size)->size),
# and the engine's inline aggregate layouts are alignment-rounded, so
# stride == size_of(T) for every aggregate — the stride field is BOTH the
# addressing stride and the byte-copy length.
#
# The width dispatch (emit_*_store_width / emit_*_load_width) remains for
# the SCALAR categories ONLY: these helpers gate on stride in {1,2,4,8}
# first; any other stride (16/24/32/... — ScalarPair/ByAddress, and stride
# 0 for ZeroSized) takes the byte-copy path.
# ———————————————————————————————————————————————————————————————

# Category-driven element STORE at [addr] (AArch64). stride in {1,2,4,8}:
# the scalar value word in `value` is stored at the width; any other
# stride: `value` is the element image ADDRESS and `stride` bytes are
# byte-copied from [value] to [addr].
# Clobbers addr/value/stride and X9 (the copy loop's byte temp) — NONE of
# addr/value/stride may be X9.
def emit_a64_transfer_store(ctx: &mut RuntimeEmitCtx, addr: A64, value: A64, stride: A64) -> Unit
  let lbl_scalar = fresh_label(ctx, ".Lts_store_scalar")
  let lbl_done = fresh_label(ctx, ".Lts_store_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 8)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  # ScalarPair / ByAddress (and ZeroSized: stride 0 copies nothing): the
  # full image — never a scalar width.
  emit_a64_copy_loop(ctx, stride, value, addr)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_scalar)
  emit_a64_store_width(ctx, addr, value, stride)
  def_label(&mut ctx.text, lbl_done)
end

# Category-driven element STORE at [addr] (x86-64). Same rule as the
# AArch64 helper; clobbers addr/value/stride and RAX (the copy loop's byte
# temp) — NONE of addr/value/stride may be RAX.
def emit_x64_transfer_store(ctx: &mut RuntimeEmitCtx, addr: X64, value: X64, stride: X64) -> Unit
  let lbl_scalar = fresh_label(ctx, ".Lts_store_scalar")
  let lbl_done = fresh_label(ctx, ".Lts_store_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 8)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  # ScalarPair / ByAddress (and ZeroSized: stride 0 copies nothing).
  emit_x64_copy_loop(ctx, stride, value, addr)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_scalar)
  emit_x64_store_width(ctx, addr, value, stride)
  def_label(&mut ctx.text, lbl_done)
end

# Category-driven element ARGUMENT load (AArch64): dst = the value word of
# [src] when stride is a scalar width (1/2/4/8), else dst = src (the
# element image ADDRESS — the runtime push byte-copies from it). Clobbers
# dst and the flags only (the width dispatch uses no fixed scratch).
def emit_a64_load_elem_arg(ctx: &mut RuntimeEmitCtx, dst: A64, src: A64, stride: A64) -> Unit
  let lbl_scalar = fresh_label(ctx, ".Lle_load_scalar")
  let lbl_done = fresh_label(ctx, ".Lle_load_done")
  a64_cmp_ri(&mut ctx.text, stride, 1)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 2)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 4)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  a64_cmp_ri(&mut ctx.text, stride, 8)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_scalar.clone())
  # ScalarPair / ByAddress: the image ADDRESS is the transfer source.
  a64_mov_rr(&mut ctx.text, dst, src)
  a64_b(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_scalar)
  emit_a64_load_width(ctx, dst, src, stride)
  def_label(&mut ctx.text, lbl_done)
end

# Category-driven element ARGUMENT load (x86-64). Same rule as the AArch64
# helper; clobbers dst and the flags only.
def emit_x64_load_elem_arg(ctx: &mut RuntimeEmitCtx, dst: X64, src: X64, stride: X64) -> Unit
  let lbl_scalar = fresh_label(ctx, ".Lle_load_scalar")
  let lbl_done = fresh_label(ctx, ".Lle_load_done")
  x64_cmp_ri(&mut ctx.text, stride, 1)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 2)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 4)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  x64_cmp_ri(&mut ctx.text, stride, 8)
  x64_jcc(&mut ctx.text, CC::E, lbl_scalar.clone())
  # ScalarPair / ByAddress: the image ADDRESS is the transfer source.
  x64_mov_rr(&mut ctx.text, dst, src)
  x64_jmp(&mut ctx.text, lbl_done)
  def_label(&mut ctx.text, lbl_scalar)
  emit_x64_load_width(ctx, dst, src, stride)
  def_label(&mut ctx.text, lbl_done)
end

def emit_array_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_array_new(ctx)
  emit_tg_array_push(ctx)
  emit_tg_array_grow(ctx)
  emit_tg_array_destroy(ctx)
  emit_tg_array_pop(ctx)
  emit_tg_array_get(ctx)
  emit_tg_array_set(ctx)
  emit_tg_array_remove(ctx)
  emit_tg_array_insert(ctx)
  emit_tg_array_insert_full(ctx)
  emit_tg_array_contains(ctx)
  emit_tg_array_reverse(ctx)
  emit_tg_array_extend(ctx)
  emit_tg_array_resize(ctx)
  emit_tg_array_slice(ctx)
  emit_tg_array_from_list(ctx)
end

# _tg_array_new: Allocate empty vec struct
# Args: x0/rdi = element stride (bytes; computed by codegen from the concrete
# element type via element_stride_bytes — the layout values NEVER come from
# a hardcoded constant). Stored at header offset 24.
# Returns: ptr to vec (32 bytes: {data:0, len:8, cap:16, stride:24}, zeroed
# except the stride field)
def emit_tg_array_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_new")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # save caller stride
    # Array headers are tiny and extremely frequent during lex/parse.
    # Allocate them from the bump arena instead of page-rounded mmap.
    a64_mov_ri(&mut ctx.text, A64::X0, 32)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct (3 stores of 8 bytes each), then set stride.
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # Save vec ptr
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 0)   # data = null
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 8)   # len = 0
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 16)  # cap = 0
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 24)  # stride = caller's stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # Return vec ptr
    
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # save caller stride
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct, then set stride (r12 holds it)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # Save vec ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RCX)   # data = null
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)   # len = 0
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RCX)  # cap = 0
    x64_mov_mr(&mut ctx.text, X64::RBX, 24, X64::R12)  # stride = caller's stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)  # Return vec ptr
    
    # Epilogue
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_push: Append element to vec
# Args: x0/rdi = vec ptr, x1/rsi = the element per its value category:
#   Scalar(width)    -> the VALUE WORD (stored at the width)
#   ScalarPair/ByAddress -> the element image ADDRESS (the runtime
#                           byte-copies the full image — stride bytes)
# The transfer size is the header stride (category-derived at the codegen
# site; stride == size_of(T) for every aligned aggregate).
# Returns: void
def emit_tg_array_push(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_push")
  
  let lblGrow = fresh_label(ctx, ".Larr_push_grow")
  let lblDone = fresh_label(ctx, ".Larr_push_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)
    
    # Save args
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # element
    
    # Sanity check: if vec ptr is 0 or len > 1B, trap immediately
    let sanity_ok = fresh_label(ctx, ".Larr_push_sanity_ok")
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), sanity_ok.clone())  # skip check if null (trap later)
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_mov_ri(&mut ctx.text, A64::X0, 1000000000)
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), sanity_ok.clone())
    a64_brk(&mut ctx.text, 0xBEEF)  # trap with identifiable code
    def_label(&mut ctx.text, sanity_ok)
    
    # Load len and cap
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16)  # cap
    
    # if len < cap: skip grow
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblGrow.clone())
    
    # Need to grow: new_cap = max(cap * 2, 8)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X0)
    a64_csel(&mut ctx.text, A64::X0, A64::X22, A64::X0, a64_cc_ge())
    a64_lsl(&mut ctx.text, A64::X0, A64::X0, 1)  # new_cap = max(cap,8) * 2
    
    # Call _tg_array_grow(vec, new_cap)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # new_cap in x1
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # vec in x0
    a64_bl(&mut ctx.text, "_tg_array_grow")
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len] — element address = data + len * stride.
    # The transfer is category-driven: the scalar value word at the width
    # (stride in 1/2/4/8) or the full element image byte-copied from the
    # element ADDRESS (any other stride).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)   # data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X23)  # len * stride
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X2)
    emit_a64_transfer_store(ctx, A64::X0, A64::X20, A64::X23)
    
    # len++
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_stur(&mut ctx.text, A64::X21, A64::X19, 8)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    # Save args
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # element
    
    # Load len and cap
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 16)  # cap
    
    # if len < cap: skip grow
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::L, lblGrow.clone())
    
    # Need to grow
    x64_mov_ri(&mut ctx.text, X64::RAX, 8)
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_cmova_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 1)  # new_cap *= 2
    
    # Call _tg_array_grow
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_grow")
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len] — element address = data + len * stride.
    # Category-driven transfer (see emit_x64_transfer_store): the scalar
    # value word at the width or the full image byte-copied from the
    # element ADDRESS. The address is kept out of RAX (the copy loop's
    # byte temp).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)   # data ptr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)     # len * stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RAX)
    emit_x64_transfer_store(ctx, X64::R8, X64::R12, X64::RDX)
    
    # len++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_grow: Internal helper to grow array capacity
# Args: x0/rdi = vec ptr, x1/rsi = new_capacity
# _tg_array_destroy: release the array's mmap'ed data buffer. Args: x0 =
# vec (32-byte header: [0] data, [8] len, [16] cap, [24] stride). Elements
# were already finalized by the cleanup loop; this frees cap*stride bytes.
def emit_tg_array_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_destroy")
  let lblSkip = fresh_label(ctx, ".Larr_destroy_skip")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)  # cap * stride
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    def_label(&mut ctx.text, lblSkip.clone())
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblSkip.clone())
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 16)  # cap
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 24)  # stride
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)     # cap * stride
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)      # munmap(data, size)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    def_label(&mut ctx.text, lblSkip.clone())
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_array_grow(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_grow")
  
  match ctx.target.arch
   when Arch::AArch64 then
     # Prologue — save all callee-saved regs (svc clobbers them on macOS ARM64)
     a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
     a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
     a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X27, A64::X28, A64::SP, -16)
     
     a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
     a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # new_cap
     a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)  # stride (header authority)
     
     # Allocate new buffer: mmap(0, new_cap*stride, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
     a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X24)  # size = new_cap * stride
     a64_mov_ri(&mut ctx.text, A64::X0, 0)
     a64_mov_ri(&mut ctx.text, A64::X2, 3)
     match ctx.target.os
     when OsAbi::MacOS then
       a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
       a64_mov_ri(&mut ctx.text, A64::X4, -1)
       a64_mov_ri(&mut ctx.text, A64::X5, 0)
       a64_mov_ri(&mut ctx.text, A64::X16, 197)
       a64_svc(&mut ctx.text, 0x80)
     when OsAbi::Linux then
       a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
       a64_mov_ri(&mut ctx.text, A64::X4, -1)
       a64_mov_ri(&mut ctx.text, A64::X5, 0)
       a64_mov_ri(&mut ctx.text, A64::X8, 222)
       a64_svc(&mut ctx.text, 0)
     when _ then a64_brk(&mut ctx.text, 1)
     end
     
     a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # new_data
     
     # Copy old data to new buffer: len elements, the FULL image (stride
     # bytes) each, stride apart — the category-driven element move (a
     # byte-copy, never a scalar width).
     a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)  # old_data
     a64_ldur(&mut ctx.text, A64::X25, A64::X19, 8)  # len
     
     let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
     let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
     
     a64_mov_ri(&mut ctx.text, A64::X1, 0)  # i = 0
     def_label(&mut ctx.text, lblCopyLoop.clone())
     a64_cmp_rr(&mut ctx.text, A64::X1, A64::X25)
     a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
     
     # x2 = old_data + i*stride (src); x3 = new_data + i*stride (dst);
     # byte-copy `stride` bytes (x24 — re-loaded per iteration, the copy
     # loop clobbers it).
     a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)
     a64_mul_rrr(&mut ctx.text, A64::X2, A64::X1, A64::X24)
     a64_add_rrr(&mut ctx.text, A64::X2, A64::X22, A64::X2)
     a64_mul_rrr(&mut ctx.text, A64::X3, A64::X1, A64::X24)
     a64_add_rrr(&mut ctx.text, A64::X3, A64::X21, A64::X3)
     emit_a64_copy_loop(ctx, A64::X24, A64::X2, A64::X3)
     
     a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
     a64_b(&mut ctx.text, lblCopyLoop)
     
     def_label(&mut ctx.text, lblCopyDone.clone())
     a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)  # stride for the free below
     
     # Free old buffer if not null
     a64_cmp_ri(&mut ctx.text, A64::X22, 0)
     let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
     a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkipFree.clone())
     
     # munmap(old_data, old_cap * stride)
     a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
     a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
     a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X24)
     match ctx.target.os
     when OsAbi::MacOS then
       a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
       a64_svc(&mut ctx.text, 0x80)
     when OsAbi::Linux then
       a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
       a64_svc(&mut ctx.text, 0)
     when _ then ()
     end
     
     def_label(&mut ctx.text, lblSkipFree.clone())
     
     # Update vec: data = new_data, cap = new_cap (stride unchanged at [24])
     a64_stur(&mut ctx.text, A64::X21, A64::X19, 0)
     a64_stur(&mut ctx.text, A64::X20, A64::X19, 16)
     
     # Epilogue — pop exactly the 6 pairs pushed in the prologue, in reverse
     a64_ldp_post(&mut ctx.text, A64::X27, A64::X28, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
     a64_ret(&mut ctx.text)
     
  when Arch::X86_64 then
    # Similar implementation for x86-64
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # new_cap
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 24)  # stride (header authority)
    
    # mmap(0, new_cap*stride, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::R15)  # size = new_cap * stride
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # new_data
    
    # Copy loop: len elements, the FULL image (stride bytes) each, stride apart.
    # r14 = old_data, r15 = stride (callee-saved), len re-loaded per iteration.
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)  # old_data
    
    let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
    let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
    
     x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # i = 0
     def_label(&mut ctx.text, lblCopyLoop.clone())
     x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 8)  # len
     x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RSI)
     x64_jcc(&mut ctx.text, CC::E, lblCopyDone.clone())
     
     # rax = old_data + i*stride (src); then new_data + i*stride (dst);
     # byte-copy `stride` bytes (count r8, src r9, dst r10 — RAX is the
     # copy loop's byte temp; r15 = stride survives as the count source).
     x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
     x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
     x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)
     x64_mov_rr(&mut ctx.text, X64::R9, X64::RAX)
     x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
     x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
     x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
     x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
     x64_mov_rr(&mut ctx.text, X64::R8, X64::R15)
     emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)
     
     x64_add_ri(&mut ctx.text, X64::RCX, 1)
     x64_jmp(&mut ctx.text, lblCopyLoop)
     
     def_label(&mut ctx.text, lblCopyDone.clone())
    
    # Free old buffer: munmap(old_data, old_cap * stride)
    x64_test_rr(&mut ctx.text, X64::R14, X64::R14)
    let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
    x64_jcc(&mut ctx.text, CC::E, lblSkipFree.clone())
    
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 16)  # old_cap
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::R15)     # old_cap * stride
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    def_label(&mut ctx.text, lblSkipFree.clone())
    
    # Update vec: data = new_data, cap = new_cap (stride unchanged at [24])
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::R12)
    
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_pop: Remove and return the LAST element's IMAGE ADDRESS
# (the VALUE-ABI result: the codegen constructs the complete Option[T]
# word from this address — codegen_option_payload_wrap — and the image
# must outlive the pop).
# Args: x0/rdi = vec ptr
# Returns: x0/rax = the popped element's image ADDRESS, or 0 when empty.
# The image persistence rule is category-derived from the header stride
# (the stride authority):
#   - stride <= 8 (ValueCategory::Scalar — the value word fits one slot):
#     the IN-BUFFER element address is returned. pop only decrements len;
#     the popped slot's bytes stay intact, and the codegen's width-matched
#     payload load reads exactly the slot (never across it).
#   - stride > 8 (ScalarPair / ByAddress): the FULL element image is
#     byte-copied into a FRESH bump allocation (the same arena the Option
#     wrap itself uses for the Some image) BEFORE the buffer can be
#     reused — the returned address is the persistent full-image payload.
# NO width-load into one register is ever emitted here: the returned
# address carries the complete element per its value category.
def emit_tg_array_pop(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_pop")
  
  let lblEmpty = fresh_label(ctx, ".Larr_pop_empty")
  let lblScalar = fresh_label(ctx, ".Larr_pop_scalar")
  let lblDone = fresh_label(ctx, ".Larr_pop_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::XZR, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    
    # if len == 0: return 0
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblEmpty.clone())
    
    # len--
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    # elem address = data + (len-1) * stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # elem address (callee-saved)
    
    # Scalar category: return the in-buffer slot address (intact after
    # len--; the codegen loads the width-matched value word immediately).
    a64_cmp_ri(&mut ctx.text, A64::X2, 8)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblScalar.clone())
    
    # ScalarPair / ByAddress: fresh bump image — the FULL element image
    # (stride bytes) is byte-copied, never a scalar width.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X2)   # size = stride
    a64_bl(&mut ctx.text, "_tg_bump_alloc")       # x0 = fresh image
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # fresh image (callee-saved)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # count = stride (reload)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # src = elem address
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X21)  # dst = fresh image
    emit_a64_copy_loop(ctx, A64::X2, A64::X1, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)  # return the fresh image
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblScalar)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)  # in-buffer slot address
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    
    # if len == 0: return 0
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblEmpty.clone())
    
    # len--
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    # elem address = data + (len-1) * stride
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 0)  # data
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24) # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RCX)  # elem address (callee-saved)
    
    # Scalar category: return the in-buffer slot address.
    x64_cmp_ri(&mut ctx.text, X64::RDX, 8)
    x64_jcc(&mut ctx.text, CC::LE, lblScalar.clone())
    
    # ScalarPair / ByAddress: fresh bump image — the FULL element image
    # (stride bytes) is byte-copied, never a scalar width.
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RDX)  # size = stride
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")  # rax = fresh image
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # fresh image (callee-saved)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # count = stride (reload)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)  # src = elem address
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R13)   # dst = fresh image
    emit_x64_copy_loop(ctx, X64::RCX, X64::RDX, X64::R8)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)  # return the fresh image
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblScalar)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)  # in-buffer slot address
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_get: the UNCHECKED element-address accessor (the VALUE-ABI
# address primitive).
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: x0/rax = &data[index] = data + index * stride — the element
# image ADDRESS, per the element's value category (Scalar -> the codegen
# loads the width-matched value word from it; ScalarPair/ByAddress -> the
# codegen byte-copies the full image to the destination place).
# THE BOUNDS CHECK IS THE CODEGEN'S (the ArrayGet arm is the checked
# path: index < len is verified and out-of-range traps BEFORE this
# primitive runs — panic-on-OOB is the defined std policy). This helper
# deliberately performs NO bounds test: it is the unchecked address
# accessor by contract.
def emit_tg_array_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_get")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)   # vec ptr (scratch)
    a64_ldur(&mut ctx.text, A64::X0, A64::X9, 0)   # data
    a64_ldur(&mut ctx.text, A64::X2, A64::X9, 24)  # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 24)  # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_set: Set element at index
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = the element per its
# value category (Scalar -> the value word; ScalarPair/ByAddress -> the
# element image ADDRESS — the runtime byte-copies the full image).
def emit_tg_array_set(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_set")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec, x1 = index, x2 = element
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)   # data
    a64_ldur(&mut ctx.text, A64::X10, A64::X0, 24) # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X11, A64::X1, A64::X10)  # index * stride
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X9, A64::X11)
    emit_a64_transfer_store(ctx, A64::X12, A64::X2, A64::X10)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # rdi = vec, rsi = index, rdx = element
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 24)  # stride (header authority)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)     # index * stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RAX)
    emit_x64_transfer_store(ctx, X64::R8, X64::RDX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_remove: Remove element at index, shift remaining. The result
# is the VALUE-ABI extraction — category-derived from the header stride:
#   - stride <= 8 (ValueCategory::Scalar): the removed VALUE WORD is
#     returned in x0/rax (the complete scalar T — the codegen stores it
#     through the general call machinery; no image extraction is ever
#     width-loaded into a register).
#   - stride > 8 (ScalarPair / ByAddress): the FULL element image is
#     byte-copied into a FRESH bump allocation BEFORE the shift loop
#     overwrites the removed slot, and the fresh image ADDRESS is
#     returned (the codegen materializes the complete T by copying the
#     image to the destination place).
# The internal shift always moves the FULL element image (stride bytes),
# never a scalar width.
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: x0/rax = the removed element's value word (scalar) or image
# address (ScalarPair/ByAddress).
def emit_tg_array_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_remove")
  
  let lblLoop = fresh_label(ctx, ".Larr_remove_loop")
  let lblScalar = fresh_label(ctx, ".Larr_remove_scalar")
  let lblShift = fresh_label(ctx, ".Larr_remove_shift")
  let lblDone = fresh_label(ctx, ".Larr_remove_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 24)  # stride (header authority)
    
    # Removed element address: data + index*stride
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X21)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # elem address (callee-saved)
    
    # Scalar category: the complete T is the width-matched VALUE WORD —
    # kept in x0 (the shift loop below never clobbers x0).
    a64_cmp_ri(&mut ctx.text, A64::X21, 8)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblScalar.clone())
    
    # ScalarPair / ByAddress: fresh bump image, FULL byte-copy BEFORE the
    # shift (the shift overwrites the removed slot).
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)  # size = stride
    a64_bl(&mut ctx.text, "_tg_bump_alloc")       # x0 = fresh image
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh image (callee-saved)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # count = stride (reload)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)  # src = removed slot
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X23)  # dst = fresh image
    emit_a64_copy_loop(ctx, A64::X2, A64::X1, A64::X3)
    # The result (the fresh image ADDRESS) rides in x0 across the shift
    # loop — the loop never clobbers x0.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, lblShift)
    
    def_label(&mut ctx.text, lblScalar)
    # The complete scalar T: the width-matched VALUE WORD (survives the
    # shift loop — x0 is never clobbered below).
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)  # elem address
    emit_a64_load_width(ctx, A64::X0, A64::X0, A64::X21)
    
    def_label(&mut ctx.text, lblShift)
    # Shift: for i from index to len-2: data[i] = data[i+1] (BOTH paths —
    # scalar and aggregate — enter here with the result in x0).
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)  # len
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)  # len-1
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    # stride is re-loaded per iteration (the copy loop clobbers it).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 24)
    a64_cmp_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    
    # data[i] = data[i+1] — the FULL element image (stride bytes) is
    # byte-copied, never a scalar width.
    a64_ldur(&mut ctx.text, A64::X4, A64::X19, 0)  # data
    a64_add_rri(&mut ctx.text, A64::X3, A64::X2, 1)  # i+1
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X3, A64::X21)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X4, A64::X3)  # &data[i+1]
    a64_mul_rrr(&mut ctx.text, A64::X5, A64::X2, A64::X21)  # i*stride
    a64_add_rrr(&mut ctx.text, A64::X5, A64::X4, A64::X5)   # &data[i]
    emit_a64_copy_loop(ctx, A64::X21, A64::X3, A64::X5)
    
    a64_add_rri(&mut ctx.text, A64::X2, A64::X2, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 24)  # stride (header authority)
    
    # Removed element address: data + index*stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # elem address (callee-saved)
    
    # Scalar category: the complete T is the width-matched VALUE WORD —
    # saved across the shift (the shift clobbers RAX).
    x64_cmp_ri(&mut ctx.text, X64::R13, 8)
    x64_jcc(&mut ctx.text, CC::LE, lblScalar.clone())
    
    # ScalarPair / ByAddress: fresh bump image, FULL byte-copy BEFORE the
    # shift (the shift overwrites the removed slot).
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # size = stride
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")  # rax = fresh image
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # fresh image (callee-saved)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # count = stride (reload)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R14)  # src = removed slot
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R15)   # dst = fresh image
    emit_x64_copy_loop(ctx, X64::RCX, X64::RDX, X64::R8)
    # The result (the fresh image ADDRESS) is saved across the shift loop
    # (RAX is the loop's byte temp; R15 is callee-saved).
    x64_push(&mut ctx.text, X64::R15)  # Save removed (image address)
    x64_jmp(&mut ctx.text, lblShift)
    
    def_label(&mut ctx.text, lblScalar)
    # The complete scalar T: the width-matched VALUE WORD, saved across
    # the shift loop.
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)  # elem address
    emit_x64_load_width(ctx, X64::RAX, X64::RAX, X64::R13)
    x64_push(&mut ctx.text, X64::RAX)  # Save removed (word)
    
    def_label(&mut ctx.text, lblShift)
    # Shift loop (BOTH paths — scalar and aggregate — enter here with the
    # removed value saved on the stack).
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    
    # data[i] = data[i+1] — the FULL element image (stride bytes) is
    # byte-copied, never a scalar width (count r8, src r9, dst r10 —
    # RAX is the copy loop's byte temp; r13 = stride survives).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)             # i+1
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)      # &data[i+1]
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RSI)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R13)      # i*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[i]
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R13)
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)
    
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)
    
    x64_pop(&mut ctx.text, X64::RAX)  # Restore removed (word or image address)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_insert: Insert element at index, shift remaining
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = the element per its
# value category (Scalar -> the value word; ScalarPair/ByAddress -> the
# element image ADDRESS — the runtime byte-copies the full image).
def emit_tg_array_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert")
  
  # This requires growing if len == cap, then shifting elements up
  # Tail-call into the full implementation (no bl/call — preserves LR)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_array_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_array_insert_full")
  end
end

def emit_tg_array_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert_full")
  
  let lblLoop = fresh_label(ctx, ".Larr_insert_loop")
  let lblDone = fresh_label(ctx, ".Larr_insert_done")
  let lblSkipGrow = fresh_label(ctx, ".Larr_insert_skip_grow")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # element (value word or image address)
    
    # Ensure capacity directly (never a dummy push — a dummy element WORD
    # would be misread as an image ADDRESS by the category-driven push for
    # aggregate strides): if len >= cap then grow(vec, max(cap, 8) * 2).
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 16) # cap
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblSkipGrow.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X0)
    a64_csel(&mut ctx.text, A64::X0, A64::X23, A64::X0, a64_cc_ge())
    a64_lsl(&mut ctx.text, A64::X0, A64::X0, 1)  # new_cap = max(cap, 8) * 2
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_grow")
    def_label(&mut ctx.text, lblSkipGrow.clone())
    
    # Shift elements down: for i from len-1 down to index+1: data[i] = data[i-1]
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # len (now grown)
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)  # i = len-1
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 24)  # stride (header authority)
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblDone.clone())
    
    # data[i] = data[i-1] — the FULL element image (stride bytes) is
    # byte-copied, never a scalar width. stride (x23) is re-loaded per
    # iteration (the copy loop clobbers it as the count).
    a64_ldur(&mut ctx.text, A64::X4, A64::X19, 0)  # data
    a64_sub_rri(&mut ctx.text, A64::X3, A64::X22, 1)  # i-1
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X3, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X4, A64::X3)  # &data[i-1]
    a64_mul_rrr(&mut ctx.text, A64::X5, A64::X22, A64::X23)  # i*stride
    a64_add_rrr(&mut ctx.text, A64::X5, A64::X4, A64::X5)   # &data[i]
    emit_a64_copy_loop(ctx, A64::X23, A64::X3, A64::X5)
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 24)
    
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element — the category-driven transfer (scalar value
    # word at the width, or the full image byte-copied from the address).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    emit_a64_transfer_store(ctx, A64::X0, A64::X21, A64::X23)
    
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # element (value word or image address)
    
    # Ensure capacity directly (never a dummy push — a dummy element WORD
    # would be misread as an image ADDRESS by the category-driven push for
    # aggregate strides): if len >= cap then grow(vec, max(cap, 8) * 2).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)  # len
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16) # cap
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::L, lblSkipGrow.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 8)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_cmova_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_shl_ri(&mut ctx.text, X64::RAX, 1)  # new_cap = max(cap, 8) * 2
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_grow")
    def_label(&mut ctx.text, lblSkipGrow.clone())
    
    # Shift loop
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len (now grown)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)  # i = len-1
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 24)  # stride (header authority)
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_jcc(&mut ctx.text, CC::LE, lblDone.clone())
    
    # data[i] = data[i-1] — the FULL element image (stride bytes) is
    # byte-copied, never a scalar width (count r8, src r9, dst r10 — RAX
    # is the copy loop's byte temp; r14 = stride survives).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RDX, 1)             # i-1
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RDX)      # &data[i-1]
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R14)      # i*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[i]
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R14)
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)
    
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element — the category-driven transfer (scalar value
    # word at the width, or the full image byte-copied from the address).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::R14)      # index*stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R8)       # &data[index]
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RAX)
    emit_x64_transfer_store(ctx, X64::R8, X64::R13, X64::R14)
    
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_contains: Check if an element exists (linear search through the
# CONCRETE Eq::eq instance — the same dispatch the map keys use; the old
# width-load/direct-register bit comparison is GONE).
# Args: x0/rdi = vec ptr, x1/rsi = item ADDRESS (the &T reference value —
#       NO deref: the runtime probes the element bytes by reference),
#       x2/rdx = eq_fn (the concrete Eq::eq instance address — resolved by
#       the codegen through map_eq_dispatch_label: the compiled
#       `impl Eq for T` instance, _tg_eq_str for String objects,
#       _tg_eq_str_view for StrView, or the _tg_eq_mem structural fallback).
# The probe per element i: eq_fn(&data[i*stride], item_addr, stride) — the
# eq call convention (a_addr, b_addr, size) the map probes use; _tg_eq_str /
# _tg_eq_str_view ignore the size argument (their structure carries it).
# Returns: 1 if found, 0 if not.
def emit_tg_array_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_contains")

  let lblLoop = fresh_label(ctx, ".Larr_contains_loop")
  let lblFound = fresh_label(ctx, ".Larr_contains_found")
  let lblNotFound = fresh_label(ctx, ".Larr_contains_notfound")
  let lblDone = fresh_label(ctx, ".Larr_contains_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # item address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # eq_fn (callee-saved)
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 24)  # stride (header authority)
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 8)   # len (callee-saved)
    a64_mov_ri(&mut ctx.text, A64::X24, 0)            # i = 0 (callee-saved)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblNotFound.clone())

    # eq_fn(&data[i*stride], item_addr, stride) — the element image ADDRESS
    # (the full stride bytes), never a width-loaded register.
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 0)   # data
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X22)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X10)  # &data[i]
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)    # item addr
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X22)    # stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X21)                # eq_fn(a, b, size)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())

    a64_add_rri(&mut ctx.text, A64::X24, A64::X24, 1)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lblDone)

    def_label(&mut ctx.text, lblNotFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lblDone)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)   # item address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)   # eq_fn (callee-saved)
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 24)  # stride (header authority)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 8)   # len (callee-saved)
    x64_mov_ri(&mut ctx.text, X64::RBP, 0)              # i = 0 (callee-saved)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RBP, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblNotFound.clone())

    # eq_fn(&data[i*stride], item_addr, stride) — the element image ADDRESS
    # (the full stride bytes), never a width-loaded register.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)   # data
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)      # &data[i]
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)      # a
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)      # b
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R14)      # size
    x64_call_r(&mut ctx.text, X64::R13)                # eq_fn(a, b, size)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())

    x64_add_ri(&mut ctx.text, X64::RBP, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lblDone)

    def_label(&mut ctx.text, lblNotFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lblDone)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_reverse: Reverse array in-place
# Args: x0/rdi = vec ptr
# Array layout: [data_ptr, length, capacity, stride]
# The swap moves the FULL element image (stride bytes — ScalarPair/
# ByAddress elements included), never a scalar width: a stride-byte temp
# buffer is taken from the bump arena and each pair is byte-copied
# through it.
def emit_tg_array_reverse(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_reverse")

  let lblLoop = fresh_label(ctx, ".Larr_rev_loop")
  let lblDone = fresh_label(ctx, ".Larr_rev_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec ptr. The bump_alloc call below clobbers LR, so the standard
    # FP/LR pair is saved (and the callee-saved X19-X25).
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    # Temp buffer = bump_alloc(stride) — the full image size.
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 24)  # stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # temp
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)  # data
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 8)  # length
    a64_sub_rri(&mut ctx.text, A64::X23, A64::X23, 1) # j = len - 1
    a64_mov_ri(&mut ctx.text, A64::X24, 0)            # i = 0

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # stride is re-loaded per iteration (the copy loops clobber it).
    a64_ldur(&mut ctx.text, A64::X25, A64::X19, 24)
    # x14 = &data[i], x15 = &data[j]
    a64_mul_rrr(&mut ctx.text, A64::X14, A64::X24, A64::X25)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X22, A64::X14)
    a64_mul_rrr(&mut ctx.text, A64::X15, A64::X23, A64::X25)
    a64_add_rrr(&mut ctx.text, A64::X15, A64::X22, A64::X15)

    # Swap the full images: tmp = data[i]; temp = data[j]; data[i] = temp.
    a64_mov_rr(&mut ctx.text, A64::X16, A64::X25)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X14)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    emit_a64_copy_loop(ctx, A64::X16, A64::X0, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X16, A64::X25)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    emit_a64_copy_loop(ctx, A64::X16, A64::X0, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X16, A64::X25)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X14)
    emit_a64_copy_loop(ctx, A64::X16, A64::X0, A64::X1)

    a64_add_rri(&mut ctx.text, A64::X24, A64::X24, 1) # i++
    a64_sub_rri(&mut ctx.text, A64::X23, A64::X23, 1) # j--
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X25, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    # Temp buffer = bump_alloc(stride) — the full image size.
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)  # stride
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # temp
    x64_mov_ri(&mut ctx.text, X64::R13, 0)          # i = 0
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8)  # length
    x64_sub_ri(&mut ctx.text, X64::R14, 1)          # j = len - 1

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # stride is re-loaded per iteration (the copy loops clobber it).
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 24)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)  # data
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)  # &data[i]
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R14)
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)  # &data[j]

    # Swap the full images: tmp = data[i]; temp = data[j]; data[i] = temp
    # (count r8, src r9, dst r10 — RAX is the copy loop's byte temp;
    # rcx/rdx hold the element addresses and survive).
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::R12)
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RCX)
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)

    x64_add_ri(&mut ctx.text, X64::R13, 1)
    x64_sub_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_extend: Append all elements from source array to dest array.
# Args: x0 = dest vec ptr, x1 = source vec ptr
def emit_tg_array_extend(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_extend")

  let lblLoop = fresh_label(ctx, ".Larr_ext_loop")
  let lblDone = fresh_label(ctx, ".Larr_ext_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = dest vec ptr
    # x1 already holds the src Vec handle: codegen's array_extend arm calls
    # deref_arg_once_if_ref_like(args, 1) so the `&other` arg is deref'd at the
    # call site (same as map_get/array_contains). Do NOT deref again here.
    # Guard against a null/empty src handle (an empty Vec is a null handle);
    # extending by an empty src is a no-op, so skip to done to avoid a null deref.
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldur(&mut ctx.text, A64::X20, A64::X1, 0)  # x20 = src data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X1, 8)  # x21 = src length
    a64_ldur(&mut ctx.text, A64::X23, A64::X1, 24) # x23 = src stride (same T as dest)
    a64_mov_ri(&mut ctx.text, A64::X22, 0)          # x22 = index i

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # Load src[i] — the element per its value category: the scalar value
    # word at the width (stride 1/2/4/8) or the element image ADDRESS
    # (any other stride — push byte-copies the full image from it).
    a64_mul_rrr(&mut ctx.text, A64::X2, A64::X22, A64::X23)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X20, A64::X2)
    emit_a64_load_elem_arg(ctx, A64::X1, A64::X2, A64::X23)

    # Push to dest: _tg_array_push(dest, element)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # rbx = dest
    # rsi already holds the src Vec handle (deref'd at call site by codegen).
    # Guard against a null/empty src handle: extending by an empty src is a no-op.
    x64_cmp_ri(&mut ctx.text, X64::RSI, 0)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RSI, 0)  # r12 = src data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RSI, 8)  # r13 = src len
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RSI, 24) # r15 = src stride (same T as dest)
    x64_mov_ri(&mut ctx.text, X64::R14, 0)            # r14 = i

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # Load src[i] — the element per its value category: the scalar value
    # word at the width (stride 1/2/4/8) or the element image ADDRESS
    # (any other stride — push byte-copies the full image from it).
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    emit_x64_load_elem_arg(ctx, X64::RSI, X64::RAX, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_resize: Resize vec to new_len, filling new elements with fill_value
# Args: x0/rdi = vec ptr, x1/rsi = new_len, x2/rdx = the fill element per
# its value category (Scalar -> the value word; ScalarPair/ByAddress -> the
# element image ADDRESS — each new slot is filled with the full image).
def emit_tg_array_resize(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_resize")

  let lblFill = fresh_label(ctx, ".Larr_resize_fill")
  let lblDone = fresh_label(ctx, ".Larr_resize_done")
  let lblTrunc = fresh_label(ctx, ".Larr_resize_trunc")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # new_len
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # fill_value
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8) # current len

    # If new_len <= current len, truncate
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblTrunc.clone())

    # Need to grow? Check if new_len > cap
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 16)  # cap
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblFill.clone())

    # Grow: call _tg_array_grow(vec, new_len)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_array_grow")

    # Fill loop: store fill_value from old len to new_len
    def_label(&mut ctx.text, lblFill.clone())
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # reload current len (index)
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)  # data ptr
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    # data[i] = fill_value — the category-driven transfer (scalar value
    # word at the width, or the full image byte-copied from the fill
    # ADDRESS; x21 = fill must survive, so a copy is the src).
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24)  # stride (header authority)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X23, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    emit_a64_transfer_store(ctx, A64::X1, A64::X0, A64::X24)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_stur(&mut ctx.text, A64::X22, A64::X19, 8)  # update len
    a64_b(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    # Just set len = new_len
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)    # new_len
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)    # fill_value
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8) # current len

    # If new_len <= current len, truncate
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lblTrunc.clone())

    # Need to grow?
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 16)  # cap
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R15)
    x64_jcc(&mut ctx.text, CC::LE, lblFill.clone())

    # Grow
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblFill.clone())
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8)   # reload len (index)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 0)   # data ptr
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    # data[i] = fill_value — the category-driven transfer (scalar value
    # word at the width, or the full image byte-copied from the fill
    # ADDRESS; r13 = fill must survive, so a copy is the src).
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # stride (header authority)
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R14)
    x64_imul_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::R8, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    emit_x64_transfer_store(ctx, X64::R8, X64::RDX, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R14)  # update len
    x64_jmp(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R12)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_slice: Extract the element span [start, end) of a Vec/Array
# (the heap header) into a NEW owned Vec — the collection ABI: the result
# is the fresh 32-byte header {data@0, len@8, cap@16, stride@24} whose
# data buffer is a byte copy of the span (the element stride is read from
# the SOURCE header — the same authority every collection op uses). The
# bounds are clamped to the source length (start>len -> start=len; end
# below start -> end=start; end>len -> end=len) — the memory-safe span.
# Args: x0/rdi = source Vec handle, x1/rsi = start, x2/rdx = end.
# Returns: x0/rax = the new owned Vec handle.
def emit_tg_array_slice(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_slice")

  let lbl_clamp1 = fresh_label(ctx, ".Larr_slice_clamp1")
  let lbl_clamp2 = fresh_label(ctx, ".Larr_slice_clamp2")
  let lbl_clamp3 = fresh_label(ctx, ".Larr_slice_clamp3")
  let lbl_empty = fresh_label(ctx, ".Larr_slice_empty")
  let lbl_copy = fresh_label(ctx, ".Larr_slice_copy")
  let lbl_fill = fresh_label(ctx, ".Larr_slice_fill")
  let lbl_done = fresh_label(ctx, ".Larr_slice_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # arr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # start
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # end
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0) # data
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 8) # slen
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 24) # stride

    # clamp start to [0, slen]; clamp end to [start, slen]
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_clamp1.clone())
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X23)
    def_label(&mut ctx.text, lbl_clamp1.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_clamp2.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)
    def_label(&mut ctx.text, lbl_clamp2.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_le(), lbl_clamp3.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X23)
    def_label(&mut ctx.text, lbl_clamp3.clone())
    a64_sub_rrr(&mut ctx.text, A64::X25, A64::X21, A64::X20)  # sub_len

    # The result Vec header: _tg_array_new(stride).
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X26, A64::X0)   # vec

    a64_cmp_ri(&mut ctx.text, A64::X25, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())

    # bytes = sub_len * stride; allocate the buffer; byte-copy the span.
    a64_mul_rrr(&mut ctx.text, A64::X11, A64::X25, A64::X24)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X11)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X0)   # out base
    # src base = data + start * stride
    a64_mul_rrr(&mut ctx.text, A64::X13, A64::X20, A64::X24)
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X22, A64::X13)
    a64_mov_ri(&mut ctx.text, A64::X14, 0)         # j
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_fill.clone())
    a64_add_rrr(&mut ctx.text, A64::X15, A64::X13, A64::X14)
    a64_ldrb(&mut ctx.text, A64::X15, A64::X15, 0)
    a64_add_rrr(&mut ctx.text, A64::X16, A64::X12, A64::X14)
    a64_strb(&mut ctx.text, A64::X15, A64::X16, 0)
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_fill.clone())
    a64_stur(&mut ctx.text, A64::X12, A64::X26, 0)   # data
    a64_stur(&mut ctx.text, A64::X25, A64::X26, 8)   # len
    a64_stur(&mut ctx.text, A64::X25, A64::X26, 16)  # cap = len
    a64_stur(&mut ctx.text, A64::X24, A64::X26, 24)  # stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X26)
    a64_b(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_empty.clone())
    a64_stur(&mut ctx.text, A64::XZR, A64::X26, 0)
    a64_stur(&mut ctx.text, A64::XZR, A64::X26, 8)
    a64_stur(&mut ctx.text, A64::XZR, A64::X26, 16)
    a64_stur(&mut ctx.text, A64::X24, A64::X26, 24)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X26)
    def_label(&mut ctx.text, lbl_done.clone())
    a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_sub_ri(&mut ctx.text, X64::RSP, 32)   # [rbp-8]=data, [rbp-16]=src_base, [rbp-24]=out, [rbp-32]=sub_len
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # arr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)   # start
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)   # end
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, -8, X64::RAX)  # data
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8)   # slen
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 24)  # stride

    # clamp start to [0, slen]
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lbl_clamp1.clone())
    x64_mov_rr(&mut ctx.text, X64::R12, X64::R14)
    def_label(&mut ctx.text, lbl_clamp1.clone())
    # clamp end to [start, slen]
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_clamp2.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    def_label(&mut ctx.text, lbl_clamp2.clone())
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lbl_clamp3.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R14)
    def_label(&mut ctx.text, lbl_clamp3.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_sub_rr(&mut ctx.text, X64::RAX, X64::R12)     # sub_len
    x64_mov_mr(&mut ctx.text, X64::RBP, -32, X64::RAX)

    # The result Vec header: _tg_array_new(stride).
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)     # vec

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -32)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())

    # bytes = sub_len * stride (rdx); allocate; byte-copy the span.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -32)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RAX)     # bytes
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_mr(&mut ctx.text, X64::RBP, -24, X64::RAX) # out base
    # src base = data + start * stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBP, -8)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX) # src base
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)             # j
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_fill.clone())
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBP, -16)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RBP, -24)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::R9, 0, X64::R8)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_fill.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -24)
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RAX)   # data
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -32)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)   # len
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RAX)  # cap = len
    x64_mov_mr(&mut ctx.text, X64::RBX, 24, X64::R15)  # stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_empty.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 24, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    def_label(&mut ctx.text, lbl_done.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_add_ri(&mut ctx.text, X64::RSP, 32)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_from_list: Construct a NEW owned Vec from a raw element
# buffer (the &[T] slice view's data pointer) plus the element count and
# the element stride — the owned Vec construction of the from-list path.
# The element bytes are copied (the std's from-list surface is Copy-
# gated); the result header is {data@0, len@8, cap@16, stride@24}.
# Args: x0/rdi = source data pointer, x1/rsi = element count,
#       x2/rdx = element stride.
# Returns: x0/rax = the new owned Vec handle.
def emit_tg_array_from_list(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_from_list")

  let lbl_copy = fresh_label(ctx, ".Larr_from_list_copy")
  let lbl_empty = fresh_label(ctx, ".Larr_from_list_empty")
  let lbl_fill = fresh_label(ctx, ".Larr_from_list_fill")
  let lbl_done = fresh_label(ctx, ".Larr_from_list_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # data
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # len
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # stride

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)   # vec

    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_empty.clone())

    # bytes = len * stride; allocate; byte-copy.
    a64_mul_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X11)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)   # out base
    a64_mov_ri(&mut ctx.text, A64::X12, 0)         # j
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_fill.clone())
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X19, A64::X12)
    a64_ldrb(&mut ctx.text, A64::X13, A64::X13, 0)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X23, A64::X12)
    a64_strb(&mut ctx.text, A64::X13, A64::X14, 0)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_fill.clone())
    a64_stur(&mut ctx.text, A64::X23, A64::X22, 0)   # data
    a64_stur(&mut ctx.text, A64::X20, A64::X22, 8)   # len
    a64_stur(&mut ctx.text, A64::X20, A64::X22, 16)  # cap = len
    a64_stur(&mut ctx.text, A64::X21, A64::X22, 24)  # stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_b(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_empty.clone())
    a64_stur(&mut ctx.text, A64::XZR, A64::X22, 0)
    a64_stur(&mut ctx.text, A64::XZR, A64::X22, 8)
    a64_stur(&mut ctx.text, A64::XZR, A64::X22, 16)
    a64_stur(&mut ctx.text, A64::X21, A64::X22, 24)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    def_label(&mut ctx.text, lbl_done.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_sub_ri(&mut ctx.text, X64::RSP, 16)   # [rbp-8]=data, [rbp-16]=out
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_mr(&mut ctx.text, X64::RBP, -8, X64::RDI)  # data
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RSI)      # len
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDX)      # stride

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)      # vec

    x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_empty.clone())

    # bytes = len * stride (rdx); allocate; byte-copy.
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RAX)      # bytes
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_mr(&mut ctx.text, X64::RBP, -16, X64::RAX) # out base
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)             # j
    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::GE, lbl_fill.clone())
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBP, -8)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_movzx_r64_m8(&mut ctx.text, X64::R8, X64::R8, 0)
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RBP, -16)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RCX)
    x64_mov_m8_r8(&mut ctx.text, X64::R9, 0, X64::R8)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_fill.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, -16)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RAX)   # data
    x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::RBX)   # len
    x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::RBX)  # cap = len
    x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::R12)  # stride
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jmp(&mut ctx.text, lbl_done.clone())
    def_label(&mut ctx.text, lbl_empty.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::RCX)
    x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    def_label(&mut ctx.text, lbl_done.clone())
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_add_ri(&mut ctx.text, X64::RSP, 16)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Map Runtime Implementation — INLINE-BUCKET HASH TABLE
# ———————————————————————————————————————————————————————————————
#
# CONTRACT (the map/set storage + dispatch contract):
#
# Map header (96 bytes — a raw byte arena plus the layout parameters).
# The canonical MAP_HEADER_FIELDS table in tg_compiler/layout_engine.tg
# (map_header_field_offset / map_header_total_size) is the SINGLE
# machine-readable authority for the offsets below — this comment documents
# that table, and emit_map_runtime asserts every literal offset emitted here
# against it (map_header_assert_contract), so a drift fails at compile time:
#   [ptr+0]:   buckets       - pointer to the bucket ARENA (mmap'ed)
#   [ptr+8]:   size          - live entry count
#   [ptr+16]:  capacity      - bucket count (power of 2; 256 at creation)
#   [ptr+24]:  key_stride    - key byte size (concrete K, from the layout
#                              engine at the codegen site)
#   [ptr+32]:  key_align     - key alignment
#   [ptr+40]:  value_stride  - value byte size (concrete V)
#   [ptr+48]:  value_align   - value alignment
#   [ptr+56]:  key_off       - key inline offset inside a bucket record
#   [ptr+64]:  value_off     - value inline offset inside a bucket record
#   [ptr+72]:  next_off      - chain-pointer offset inside a bucket record
#   [ptr+80]:  bucket_stride - one bucket record's byte size
#   [ptr+88]:  free_list     - head of the overflow-node free list (0 =
#                              empty); a free node's [0] word (the hash
#                              slot of a live record) holds the next free
#                              node's address. The clear path walks every
#                              chain and links every overflow node into
#                              this list; the insert chain path pops it
#                              before mmap'ing a fresh node; destroy
#                              munmaps the remaining nodes.
#
# The FOUR derived layout fields (key_off/value_off/next_off/bucket_stride)
# are computed ONCE at map creation from the four layout parameters
# (map_new receives key_stride/key_align/value_stride/value_align — the
# concrete values NEVER come from a hardcoded constant) and stored in the
# header. Every operation (probe, insert, drain, destroy, clear, entries)
# reads them from the header: there is NO hardcoded bucket arithmetic
# (no fixed 32-byte records, no key@8/value@16/next@24) anywhere in the
# map/set paths.
#
# STORED-HASH ENCODING: the bucket's cached hash field NEVER
# stores a raw user hash. Every map/set operation normalizes the hash
# argument at entry — stored = hash == 0 ? 1: hash (the raw user hash
# is replaced by the nonzero encoding 1 exactly when it is 0; every
# nonzero hash is unchanged, so the distribution and the probe mask are
# preserved) — and the probe mask computation and the cached-hash
# comparison ALWAYS use the normalized value. A key whose Hash::hash
# returns 0 is therefore stored as the encoding 1 and is found by the
# same encoding at lookup; the empty marker stays 0. The encoding is
# idempotent on stored values (they are always nonzero), so
# _tg_map_clone's verbatim re-insertion needs no special case.
#
# Bucket record (inline storage — the reviewer's preferred contract once
# monomorphized layout is available):
#   [0]:                 hash   - cached STORED hash (0 = empty slot; a
#                                 live record's stored hash is never 0)
#   [key_off]:           key    - key_stride inline bytes
#   [value_off]:         value  - value_stride inline bytes
#   [next_off]:          next   - chain pointer (0 = end of chain)
#
# The record layout formula (mirrored by the codegen's bucket layout
# computation from the same four parameters):
#   key_off       = align_up(8, key_align)
#   value_off     = align_up(key_off + key_stride, value_align)
#   next_off      = align_up(value_off + value_stride, 8)
#   bucket_stride = next_off + 8
#
# REMOVAL CONTRACT: removing a record REAL-unlinks it. When the
# removed record is a bucket head with a chain successor, the successor's
# FULL record image (hash/key/value/next — bucket_stride bytes) is copied
# into the head slot (PROMOTION) and the old successor node is pushed onto
# the free list; when the removed record is a chain node, the parent's
# next pointer is re-linked to the removed record's successor and the
# removed node itself is pushed onto the free list. A record is marked
# empty (hash = 0) ONLY when it is the tail — no live chain successor is
# ever hidden behind a zeroed hash, so every lookup finds every entry
# after any removal (remove / remove_key / drain_one).
#
# Entry TUPLES (map_entries / drain_one payloads) use the concrete (K, V)
# tuple layout, computed by the codegen from the same parameters and passed
# per call: key at 0, value at t_v_off = align_up(key_stride, value_align),
# tuple size t_size = align_up(t_v_off + value_stride, 8).
#
# HASH / EQ DISPATCH CONTRACT:
#   - the hash of the lookup key is computed by a DIRECT call, emitted at
#     each map-operation site by the codegen, to the CONCRETE Hash::hash
#     instance of the map's key type (a user-defined `impl Hash for MyKey`
#     compiles to MyKey__hash and dispatches; the monomorphizer
#     specializes generic impls — e.g. Vec__hash$<K> — from the injected
#     dispatch calls the MIR lowering inserts at every map-operation site);
#   - the probe loop's key equality uses the CONCRETE Eq::eq instance of
#     the key type, passed to the runtime as a function pointer by the
#     codegen at each call site (the loop lives in the runtime, so the
#     pointer is the only dispatchable carrier);
#   - kernel key types (Int/String/StrView/...) dispatch to the typed
#     runtime helpers _tg_hash_* / _tg_eq_* below — their registered
#     std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
#     match the core `def hash(self) -> Int` ABI the map surface declares.
#   The heuristic _tg_runtime_hash_ptr / _tg_key_equal paths are REMOVED.

def emit_map_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
 # assert every literal offset emitted below against the canonical
  # MAP_HEADER_FIELDS table (layout_engine.tg) — a drift between the runtime
  # and the single layout authority fails at compile time, never at runtime.
  map_header_assert_contract()
  emit_tg_map_new(ctx)
  emit_tg_map_get(ctx)
  emit_tg_map_insert(ctx)
  emit_tg_map_insert_full(ctx)
  emit_tg_map_remove(ctx)
  emit_tg_map_remove_full(ctx)
  emit_tg_map_remove_key(ctx)
  emit_tg_map_remove_key_full(ctx)
  emit_tg_map_drain_one(ctx)
  emit_tg_map_drain_one_full(ctx)
  emit_tg_map_destroy(ctx)
  emit_tg_map_contains(ctx)
  emit_tg_map_clear(ctx)
  emit_tg_map_entries(ctx)
  emit_tg_map_visit_begin(ctx)
  emit_tg_map_visit_next(ctx)
  emit_tg_map_visit_value(ctx)
  emit_tg_set_visit_begin(ctx)
  emit_tg_set_visit_next(ctx)
  emit_tg_map_keys(ctx)
  emit_tg_map_clone(ctx)
  emit_tg_set_drain_one(ctx)
  emit_tg_set_drain_one_full(ctx)
  emit_tg_hash_mem(ctx)
  emit_tg_hash_str(ctx)
  emit_tg_hash_str_view(ctx)
  emit_tg_eq_mem(ctx)
  emit_tg_eq_str(ctx)
  emit_tg_eq_str_view(ctx)
end

# Shared byte-copy loop (inline storage). Clobbers count/src/dst and X9.
def emit_a64_copy_loop(ctx: &mut RuntimeEmitCtx, count: A64, src: A64, dst: A64) -> Unit
  let lblLoop = fresh_label(ctx, ".Lcopy_loop")
  let lblDone = fresh_label(ctx, ".Lcopy_done")
  def_label(&mut ctx.text, lblLoop.clone())
  a64_cmp_ri(&mut ctx.text, count, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
  a64_ldrb(&mut ctx.text, A64::X9, src, 0)
  a64_strb(&mut ctx.text, A64::X9, dst, 0)
  a64_add_rri(&mut ctx.text, src, src, 1)
  a64_add_rri(&mut ctx.text, dst, dst, 1)
  a64_sub_rri(&mut ctx.text, count, count, 1)
  a64_b(&mut ctx.text, lblLoop)
  def_label(&mut ctx.text, lblDone)
end

# Shared byte-copy loop (x86-64). Clobbers count/src/dst and RAX.
def emit_x64_copy_loop(ctx: &mut RuntimeEmitCtx, count: X64, src: X64, dst: X64) -> Unit
  let lblLoop = fresh_label(ctx, ".Lcopy_loop")
  let lblDone = fresh_label(ctx, ".Lcopy_done")
  def_label(&mut ctx.text, lblLoop.clone())
  x64_cmp_ri(&mut ctx.text, count, 0)
  x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
  x64_movzx_r64_m8(&mut ctx.text, X64::RAX, src, 0)
  x64_mov_m8_r8(&mut ctx.text, dst, 0, X64::RAX)
  x64_add_ri(&mut ctx.text, src, 1)
  x64_add_ri(&mut ctx.text, dst, 1)
  x64_sub_ri(&mut ctx.text, count, 1)
  x64_jmp(&mut ctx.text, lblLoop)
  def_label(&mut ctx.text, lblDone)
end

# _tg_map_new: Create an empty map.
# Args: x0/rdi = key_stride, x1/rsi = key_align, x2/rdx = value_stride,
#       x3/rcx = value_align  (computed by codegen from the CONCRETE K/V —
#       the layout values NEVER come from a hardcoded constant).
# Returns: x0/rax = map pointer (the 96-byte header above).
def emit_tg_map_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # key_stride
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key_align
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # value_stride
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # value_align

    # Derived layout (alignments are powers of two:
    # align_up(v, a) = (v + a - 1) & ~(a - 1)).
    # key_off = align_up(8, key_align)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 7)
    a64_neg(&mut ctx.text, A64::X10, A64::X20)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    # value_off = align_up(key_off + key_stride, value_align)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X19)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X11, A64::X22)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_neg(&mut ctx.text, A64::X10, A64::X22)
    a64_and_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X10)
    # next_off = align_up(value_off + value_stride, 8)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X12, A64::X21)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 7)
    a64_mov_ri(&mut ctx.text, A64::X10, -8)
    a64_and_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X10)
    # bucket_stride = next_off + 8
    a64_add_rri(&mut ctx.text, A64::X13, A64::X11, 8)

    # Allocate the bucket arena: mmap(256 * bucket_stride) — zeroed pages.
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 256)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X13)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # buckets

    # Allocate the 96-byte header from the bump arena (the total size comes
    # from the canonical MAP_HEADER_FIELDS table).
    a64_mov_ri(&mut ctx.text, A64::X0, map_header_total_size())
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)  # header

    # Recompute the derived offsets (X9-X13 were clobbered by the calls).
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 7)
    a64_neg(&mut ctx.text, A64::X10, A64::X20)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X19)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X11, A64::X22)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_neg(&mut ctx.text, A64::X10, A64::X22)
    a64_and_rrr(&mut ctx.text, A64::X12, A64::X12, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X12, A64::X21)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 7)
    a64_mov_ri(&mut ctx.text, A64::X10, -8)
    a64_and_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X10)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X11, 8)

    # Initialize the header — every offset is READ from the canonical
    # MAP_HEADER_FIELDS table (layout_engine.tg map_header_field_offset),
    # never a literal: the table is the single layout authority.
    a64_stur(&mut ctx.text, A64::X23, A64::X24, map_header_field_offset(&"buckets".to_string()))  # buckets
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, map_header_field_offset(&"size".to_string()))  # size = 0
    a64_mov_ri(&mut ctx.text, A64::X1, 256)
    a64_stur(&mut ctx.text, A64::X1, A64::X24, map_header_field_offset(&"capacity".to_string()))  # capacity = 256
    a64_stur(&mut ctx.text, A64::X19, A64::X24, map_header_field_offset(&"key_stride".to_string()))  # key_stride
    a64_stur(&mut ctx.text, A64::X20, A64::X24, map_header_field_offset(&"key_align".to_string()))  # key_align
    a64_stur(&mut ctx.text, A64::X21, A64::X24, map_header_field_offset(&"value_stride".to_string()))  # value_stride
    a64_stur(&mut ctx.text, A64::X22, A64::X24, map_header_field_offset(&"value_align".to_string()))  # value_align
    a64_stur(&mut ctx.text, A64::X9, A64::X24, map_header_field_offset(&"key_off".to_string()))  # key_off
    a64_stur(&mut ctx.text, A64::X12, A64::X24, map_header_field_offset(&"value_off".to_string()))  # value_off
    a64_stur(&mut ctx.text, A64::X11, A64::X24, map_header_field_offset(&"next_off".to_string()))  # next_off
    a64_stur(&mut ctx.text, A64::X13, A64::X24, map_header_field_offset(&"bucket_stride".to_string()))  # bucket_stride
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, map_header_field_offset(&"free_list".to_string()))  # free_list = 0

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # key_stride
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key_align
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # value_stride
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # value_align

    # Derived layout into stack slots (computed before the first call):
    #   [rsp+0]  = bucket_stride, [rsp+8]  = next_off,
    #   [rsp+16] = value_off,     [rsp+24] = key_off
    x64_sub_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RAX, 7)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_neg_r(&mut ctx.text, X64::RCX)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # key_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 24, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RBX)          # + key_stride
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R14)          # + value_align
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
    x64_neg_r(&mut ctx.text, X64::RCX)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # value_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 16, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)          # + value_stride
    x64_add_ri(&mut ctx.text, X64::RAX, 7)
    x64_mov_ri(&mut ctx.text, X64::RCX, -8)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)          # next_off
    x64_mov_mr(&mut ctx.text, X64::RSP, 8, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RAX, 8)                 # bucket_stride
    x64_mov_mr(&mut ctx.text, X64::RSP, 0, X64::RAX)

    # mmap(0, 256 * bucket_stride,...)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RSP, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # buckets

    # Allocate the 96-byte header from the bump arena (the total size comes
    # from the canonical MAP_HEADER_FIELDS table).
    x64_mov_ri(&mut ctx.text, X64::RDI, map_header_total_size())
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # header

    # Initialize the header — every offset is READ from the canonical
    # MAP_HEADER_FIELDS table (layout_engine.tg map_header_field_offset),
    # never a literal: the table is the single layout authority.
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"buckets".to_string()), X64::R15)  # buckets
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"size".to_string()), X64::RAX)  # size = 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 256)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"capacity".to_string()), X64::RAX)  # capacity = 256
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"key_stride".to_string()), X64::RBX)  # key_stride
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"key_align".to_string()), X64::R12)  # key_align
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"value_stride".to_string()), X64::R13)  # value_stride
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"value_align".to_string()), X64::R14)  # value_align
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 24)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"key_off".to_string()), X64::RAX)  # key_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 16)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"value_off".to_string()), X64::RAX)  # value_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 8)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"next_off".to_string()), X64::RAX)  # next_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"bucket_stride".to_string()), X64::RAX)  # bucket_stride
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, map_header_field_offset(&"free_list".to_string()), X64::RAX)  # free_list = 0

    x64_add_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_get: Get the value address for a key.
# Args: x0/rdi = map, x1/rsi = key address, x2/rdx = hash (already computed
#       by the concrete Hash::hash instance at the call site),
#       x3/rcx = eq_fn (the concrete Eq::eq instance of K).
# Returns: x0/rax = address of the bucket's inline value, or 0 when absent.
def emit_tg_map_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_get")

  let lblLoop = fresh_label(ctx, ".Lmap_get_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_get_notfound")
  let lblDone = fresh_label(ctx, ".Lmap_get_done")
  let lblNext = fresh_label(ctx, ".Lmap_get_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # hash
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # eq_fn
 # STORED-HASH ENCODING: the hash argument is normalized at
    # entry — stored = hash == 0 ? 1: hash — so a user hash of 0 can
    # never be confused with the empty marker; the probe mask and the
    # cached-hash comparison below use the normalized value.
    let lblHashNz = fresh_label(ctx, ".Lmap_get_hash_nz")
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblHashNz.clone())
    a64_mov_ri(&mut ctx.text, A64::X21, 1)
    def_label(&mut ctx.text, lblHashNz)

    # probe (X24, callee-saved across the eq call) =
    # buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X22)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblDone.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X24, A64::X10, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_get_ret")

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)  # bucket + value_off

    def_label(&mut ctx.text, ".Lmap_get_ret")
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # eq_fn
 # STORED-HASH ENCODING: the hash argument is normalized at
    # entry — stored = hash == 0 ? 1: hash — so a user hash of 0 can
    # never be confused with the empty marker; the probe mask and the
    # cached-hash comparison below use the normalized value.
    let lblHashNz = fresh_label(ctx, ".Lmap_get_hash_nz")
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblHashNz.clone())
    x64_mov_ri(&mut ctx.text, X64::R13, 1)
    def_label(&mut ctx.text, lblHashNz)

    # probe (rbp, callee-saved across the eq call) =
    # buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # cached hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R14)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblDone.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_get_ret")

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RBP)  # bucket + value_off

    def_label(&mut ctx.text, ".Lmap_get_ret")
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_insert: Insert or update an entry (inline key/value bytes).
# Args: x0/rdi = map, x1/rsi = key address, x2/rdx = value address,
#       x3/rcx = hash, x4/r8 = eq_fn.
# Returns: x0/rax = the fresh owned allocation of the REPLACED value
# (0 for a NEW key — the incoming image was copied into the fresh slot);
# for Unit-valued maps (sets) the SET REPLACEMENT contract applies: the
# STORED key is replaced by the incoming image (extract-then-write) and
# the fresh owned allocation of the OLD stored key is returned (0 for a
# new key) — the MIR emits the old element's drop glue on it.
def emit_tg_map_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_insert_full")
  end
end

def emit_tg_map_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert_full")

  let lblLoop = fresh_label(ctx, ".Lmap_insert_loop")
  let lblFound = fresh_label(ctx, ".Lmap_insert_found")
  let lblNew = fresh_label(ctx, ".Lmap_insert_new")
  let lblChain = fresh_label(ctx, ".Lmap_insert_chain")
  let lblDone = fresh_label(ctx, ".Lmap_insert_done")
  let lblNext = fresh_label(ctx, ".Lmap_insert_next")
  let lblFoundUnit = fresh_label(ctx, ".Lmap_insert_found_unit")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # value address
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # hash
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X4)  # eq_fn
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 is stored as the encoding 1, never
    # as the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_insert_hash_nz")
    a64_cmp_ri(&mut ctx.text, A64::X22, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblHashNz.clone())
    a64_mov_ri(&mut ctx.text, A64::X22, 1)
    def_label(&mut ctx.text, lblHashNz)

    # probe (X24) = buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X22, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNew.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X23)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X10)
    a64_b(&mut ctx.text, lblLoop)

    # Update in place with the REPLACEMENT CONTRACT (extract-then-write):
    # preserve the old value BEFORE overwriting — allocate value_stride
    # bytes, copy the old value out (bucket+value_off -> fresh), then
    # write the new value (value address -> bucket+value_off). X0 = the
    # fresh owned allocation (the codegen's Option[V] payload); the Set
    # case (value_stride 0) replaces the STORED KEY instead (lblFoundUnit);
    # a NEW key returns 0 (lblDone).
    def_label(&mut ctx.text, lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 40)  # value_stride
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundUnit.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh object
    # copy the old value out: bucket + value_off -> fresh
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = bucket + value_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst = fresh
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # write the new value: value address -> bucket + value_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, ".Lmap_insert_ret")
    # Unit values (Set): value_stride == 0 — no payload. THE SET
    # REPLACEMENT CONTRACT (extract-then-write on the KEY, symmetric with
    # the map value replacement above): allocate key_stride bytes, copy
    # the OLD stored key out (record + key_off -> fresh), then write the
    # incoming key image (the key address arg) into the slot; X0 = the
    # fresh owned OLD-key object — the MIR emits the element drop glue on
    # it (the incoming image is now the stored key and owns itself; the
    # old image must be destroyed by the caller). A NEW key returns 0
    # (lblDone — the incoming image was copied into the fresh slot).
    def_label(&mut ctx.text, lblFoundUnit.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 24)  # key_stride
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh old-key object
    # copy the old key out: record + key_off -> fresh
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # write the incoming key image: key address arg -> record + key_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, ".Lmap_insert_ret")

    # Store the new entry into the empty slot: hash, key bytes, value bytes.
    def_label(&mut ctx.text, lblNew.clone())
    a64_str(&mut ctx.text, A64::X22, A64::X24, 0)  # hash
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)  # key_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)  # key_off
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)  # value_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)  # value_off
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # dst
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)  # src
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)  # next_off
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_str(&mut ctx.text, A64::XZR, A64::X10, 0)  # next = 0
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_b(&mut ctx.text, lblDone)

    # Collision: bucket occupied but next == 0 — take an overflow node
 # from the FREE LIST (the clear path reclaims every overflow
    # node there) or allocate a fresh one (one bucket_stride-sized record,
    # mmap'ed like the arena).
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)  # free_list
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Lmap_insert_fl_pop")
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)  # bucket_stride
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X0)  # node
    a64_ldp_post(&mut ctx.text, A64::X14, A64::XZR, A64::SP, 16)  # old probe
    a64_b(&mut ctx.text, ".Lmap_insert_fl_done")
    def_label(&mut ctx.text, ".Lmap_insert_fl_pop")
    a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)   # node[0] = next free node
    a64_stur(&mut ctx.text, A64::X10, A64::X19, 88)  # free_list = next
    a64_mov_rr(&mut ctx.text, A64::X14, A64::X24)  # old probe = current probe
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X9)   # node
    def_label(&mut ctx.text, ".Lmap_insert_fl_done")
    # link: old_probe->next = node
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X14, A64::X9)
    a64_str(&mut ctx.text, A64::X24, A64::X10, 0)
    # store hash, key bytes, value bytes into the node
    a64_str(&mut ctx.text, A64::X22, A64::X24, 0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X3)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_str(&mut ctx.text, A64::XZR, A64::X10, 0)  # node->next = 0
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, ".Lmap_insert_ret")
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # value address
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R8)   # eq_fn
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 is stored as the encoding 1, never
    # as the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_insert_hash_nz")
    x64_test_rr(&mut ctx.text, X64::R14, X64::R14)
    x64_jcc(&mut ctx.text, CC::NE, lblHashNz.clone())
    x64_mov_ri(&mut ctx.text, X64::R14, 1)
    def_label(&mut ctx.text, lblHashNz)

    # probe (rbp) = buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # cached hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNew.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R15)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChain.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    # Update in place with the REPLACEMENT CONTRACT (extract-then-write):
    # preserve the old value BEFORE overwriting — allocate value_stride
    # bytes, copy the old value out (bucket+value_off -> fresh, saved on
    # the stack), then write the new value (value address -> bucket+
    # value_off). RAX = the fresh owned allocation (the codegen's
    # Option[V] payload); the Set case (value_stride 0) replaces the
    # STORED KEY instead (lblFoundUnit); a NEW key returns 0 (lblDone).
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblFoundUnit.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_push(&mut ctx.text, X64::RAX)  # fresh object
    # copy the old value out: bucket + value_off -> fresh
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = bucket + value_off
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RSP, 0)  # dst = fresh
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    # write the new value: value address -> bucket + value_off
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_pop(&mut ctx.text, X64::RAX)  # fresh object
    x64_jmp(&mut ctx.text, ".Lmap_insert_ret_x")
    # Unit values (Set): value_stride == 0 — no payload. THE SET
    # REPLACEMENT CONTRACT (extract-then-write on the KEY, symmetric with
    # the map value replacement above): allocate key_stride bytes, copy
    # the OLD stored key out (record + key_off -> fresh, saved on the
    # stack), then write the incoming key image (the key address arg)
    # into the slot; RAX = the fresh owned OLD-key object — the MIR emits
    # the element drop glue on it. A NEW key returns 0 (lblDone).
    def_label(&mut ctx.text, lblFoundUnit.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # key_stride
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_push(&mut ctx.text, X64::RAX)  # fresh old-key object
    # copy the old key out: record + key_off -> fresh
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = record + key_off
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RSP, 0)  # dst = fresh
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    # write the incoming key image: key address arg -> record + key_off
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_pop(&mut ctx.text, X64::RAX)  # fresh old-key object
    x64_jmp(&mut ctx.text, ".Lmap_insert_ret_x")

    # Store the new entry: hash, key bytes, value bytes, next = 0.
    def_label(&mut ctx.text, lblNew.clone())
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDX)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)  # next = 0
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_jmp(&mut ctx.text, lblDone)

 # Collision: take an overflow node from the FREE LIST (the
    # clear path reclaims every overflow node there) or allocate a fresh
    # one (one bucket_stride-sized record, mmap'ed like the arena).
    def_label(&mut ctx.text, lblChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)  # free_list
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, ".Lmap_insert_fl_pop")
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 80)  # bucket_stride
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # node
    x64_pop(&mut ctx.text, X64::RBP)               # old probe
    x64_jmp(&mut ctx.text, ".Lmap_insert_fl_done")
    def_label(&mut ctx.text, ".Lmap_insert_fl_pop")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)   # node
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)  # node[0] = next free node
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RAX)  # free_list = next
    # RBP still holds the old probe (untouched in the pop path)
    def_label(&mut ctx.text, ".Lmap_insert_fl_done")
    # link: old_probe->next = node
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::RCX)
    # store hash, key bytes, value bytes
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)  # src
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # dst
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)  # src
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R9)
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::RAX)  # node->next = 0
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, ".Lmap_insert_ret_x")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_remove: Remove an entry; the removed VALUE is copied out into a
# fresh allocation (inline storage: the bucket bytes are zeroed) and its
# address returned. Args: x0/rdi = map, x1/rsi = key address,
# x2/rdx = hash, x3/rcx = eq_fn. Returns: x0/rax = value address or 0;
# for Unit-valued maps (sets) the value_stride is 0 and 1 is returned.
def emit_tg_map_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_remove_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_remove_full")
  end
end

def emit_tg_map_remove_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove_full")

  let lblLoop = fresh_label(ctx, ".Lmap_remove_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_remove_notfound")
  let lblFound = fresh_label(ctx, ".Lmap_remove_found")
  let lblFoundOne = fresh_label(ctx, ".Lmap_remove_found_one")
  let lblNext = fresh_label(ctx, ".Lmap_remove_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # hash
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # eq_fn
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 probes the same bucket as the
    # stored encoding and can never be confused with the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_remove_hash_nz")
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblHashNz.clone())
    a64_mov_ri(&mut ctx.text, A64::X21, 1)
    def_label(&mut ctx.text, lblHashNz)
    # X25 = the chain PARENT of the current record (0 = the record is the
 # bucket head) — the unlink authority: a head removal
    # PROMOTES its successor into the head slot; a chain-node removal
    # re-links the parent to the removed record's successor.
    a64_mov_ri(&mut ctx.text, A64::X25, 0)

    # probe (X24) = buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X22)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_mov_rr(&mut ctx.text, A64::X25, A64::X24)  # the current record becomes the parent
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X24, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_remove_ret")

 # the found record (X24, parent X25) is REAL-unlinked — the
    # removed VALUE was already extracted (X23 = the fresh object); the
    # head-with-successor case PROMOTES the successor's full record image
    # into the removed slot (the chain's links stay fixed) and the old
    # successor node is pushed onto the free list; the chain-node case
    # re-links the parent to the successor and pushes the removed node
    # itself onto the free list; a tail record is simply marked empty
    # (hash = 0 — nothing follows it, so nothing is hidden).
    def_label(&mut ctx.text, lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 40)  # value_stride
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundOne.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # fresh value object
    # copy the old value out: bucket + value_off -> object (the copy-loop
    # call convention is (count, src, dst); the swap makes X1=src, X2=dst).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = bucket + value_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst = fresh value object
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)

    def_label(&mut ctx.text, lblFoundOne.clone())
    a64_cmp_ri(&mut ctx.text, A64::X25, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Lmap_remove_chain_unlink")
    # head: promote the successor into the removed slot, or mark empty
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lmap_remove_zero_hash")
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 80)  # count = bucket_stride
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)  # src = successor
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X24)  # dst = removed slot
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the old successor node onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X11, 0)
    a64_stur(&mut ctx.text, A64::X11, A64::X19, 88)
    a64_b(&mut ctx.text, ".Lmap_remove_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_chain_unlink")
    # chain node: P->next = R->next; push R onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # R->next
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X25, A64::X9)
    a64_str(&mut ctx.text, A64::X11, A64::X12, 0)  # P->next = R->next
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X24, 0)  # R[0] = free_list
    a64_stur(&mut ctx.text, A64::X24, A64::X19, 88)  # free_list = R
    a64_b(&mut ctx.text, ".Lmap_remove_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_zero_hash")
    a64_str(&mut ctx.text, A64::XZR, A64::X24, 0)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_remove_size_dec")
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    # return the fresh value object (or the Unit marker 1 for sets)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 40)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Lmap_remove_ret_fresh")
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, ".Lmap_remove_ret")
    def_label(&mut ctx.text, ".Lmap_remove_ret_fresh")
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_b(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, ".Lmap_remove_ret")
    a64_ldp_post(&mut ctx.text, A64::X25, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # eq_fn
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 probes the same bucket as the
    # stored encoding and can never be confused with the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_remove_hash_nz")
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblHashNz.clone())
    x64_mov_ri(&mut ctx.text, X64::R13, 1)
    def_label(&mut ctx.text, lblHashNz)
    # R15 = the chain PARENT of the current record (0 = the record is the
 # bucket head) — the unlink authority (see the a64 arm).
    x64_mov_ri(&mut ctx.text, X64::R15, 0)

    # probe (rbp) = buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R14)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RBP)  # the current record becomes the parent
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_remove_ret")

 # the found record (RBP, parent R15) is REAL-unlinked — the
    # removed VALUE was already extracted (the fresh object on the stack);
    # the head-with-successor case PROMOTES the successor's full record
    # image into the removed slot and pushes the old successor node onto
    # the free list; the chain-node case re-links the parent to the
    # successor and pushes the removed node itself; a tail record is
    # simply marked empty (hash = 0 — nothing follows it, so nothing is
    # hidden). R15 stays the parent through the extraction (callee-saved).
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblFoundOne.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_push(&mut ctx.text, X64::RAX)  # fresh value object
    # copy the old value out: bucket + value_off -> object (the copy-loop
    # call convention is (count, src, dst); the swap makes RSI=src,
    # RDI=dst).
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = bucket + value_off
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RSP, 0)  # dst = fresh value object
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)

    def_label(&mut ctx.text, lblFoundOne.clone())
    x64_test_rr(&mut ctx.text, X64::R15, X64::R15)
    x64_jcc(&mut ctx.text, CC::NE, ".Lmap_remove_chain_unlink")
    # head: promote the successor into the removed slot, or mark empty
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, ".Lmap_remove_zero_hash")
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 80)  # count = bucket_stride
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)  # src = successor
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)  # dst = removed slot
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # push the old successor node onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RCX)
    x64_jmp(&mut ctx.text, ".Lmap_remove_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_chain_unlink")
    # chain node: P->next = R->next; push R onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # R->next
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R15)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)  # P + next_off
    x64_mov_mr(&mut ctx.text, X64::R9, 0, X64::RCX)  # P->next = R->next
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # R[0] = free_list
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RBP)  # free_list = R
    x64_jmp(&mut ctx.text, ".Lmap_remove_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_zero_hash")
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_remove_size_dec")
    # size--
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    # return the fresh value object (or the Unit marker 1 for sets)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, ".Lmap_remove_ret_unit")
    x64_pop(&mut ctx.text, X64::RAX)  # fresh value object
    x64_jmp(&mut ctx.text, ".Lmap_remove_ret")
    def_label(&mut ctx.text, ".Lmap_remove_ret_unit")
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, ".Lmap_remove_ret")

    def_label(&mut ctx.text, ".Lmap_remove_ret")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_remove_key: the OWNERSHIP-TRANSFER remove — a companion to
# _tg_map_remove whose result the MIR consumes for the stored-key drop.
# The removed VALUE is copied out into the CALLER-provided out slot
# (x4/r8 — the address of the caller's V-typed local; the runtime never
# allocates: ownership of the value image transfers to the caller's slot)
# and the removed record's KEY ADDRESS is returned so the MIR can emit the
# concrete K drop glue on the stored key's bytes. Args:
# x0/rdi = map, x1/rsi = key address, x2/rdx = hash, x3/rcx = eq_fn,
# x4/r8 = v_out (0 for Unit-valued maps — sets — nothing is copied).
# Returns: x0/rax = the address holding the removed KEY's image (a fresh
# copy when the removal clobbers the record's key bytes — the head-
# promotion case — or the record's key slot itself otherwise: the chain-
# node unlink and the tail case leave the key bytes in place), or 0 when
# the key is absent. the record is REAL-unlinked exactly like
# _tg_map_remove (head promotion / chain-node re-link / tail empty-mark);
# the removed key's image survives until the MIR's drop glue runs on the
# returned address.
def emit_tg_map_remove_key(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove_key")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_remove_key_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_remove_key_full")
  end
end

def emit_tg_map_remove_key_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove_key_full")

  let lblLoop = fresh_label(ctx, ".Lmap_remove_key_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_remove_key_notfound")
  let lblFound = fresh_label(ctx, ".Lmap_remove_key_found")
  let lblFoundUnit = fresh_label(ctx, ".Lmap_remove_key_found_unit")
  let lblNext = fresh_label(ctx, ".Lmap_remove_key_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key address
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # hash
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X3)  # eq_fn
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X4)  # v_out (0 for sets)
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 probes the same bucket as the
    # stored encoding and can never be confused with the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_remove_key_hash_nz")
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblHashNz.clone())
    a64_mov_ri(&mut ctx.text, A64::X21, 1)
    def_label(&mut ctx.text, lblHashNz)
    # X25 = the chain PARENT of the current record (0 = the bucket head) —
 # the unlink authority (see _tg_map_remove).
    a64_mov_ri(&mut ctx.text, A64::X25, 0)

    # probe (X24) = buckets + (hash & (capacity - 1)) * bucket_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X10, A64::X9)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    # eq_fn(bucket + key_off, key)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X24, A64::X9)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 24)  # key stride (mem-eq size)
    a64_blr(&mut ctx.text, A64::X22)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    a64_mov_rr(&mut ctx.text, A64::X25, A64::X24)  # the current record becomes the parent
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X24, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_remove_key_ret")

    def_label(&mut ctx.text, lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 40)  # value_stride
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundUnit.clone())
    # v_out != 0: copy the removed value's image into the caller's slot.
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFoundUnit.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)  # count = value_stride
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)  # value_off
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = record + value_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X23)  # dst = v_out
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)

    def_label(&mut ctx.text, lblFoundUnit.clone())
 # the removed KEY's image must survive the
    # unlink until the MIR's drop glue runs on the returned address. The
    # head-promotion case CLOBBERS the record's key bytes (the successor's
    # image is copied over them), so the key is extracted into a fresh
    # allocation first; the chain-node unlink and the tail case leave the
    # key bytes in place and return the record's key slot itself.
    a64_cmp_ri(&mut ctx.text, A64::X25, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Lmap_remove_key_ret_record")
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lmap_remove_key_ret_record")
    # fresh key copy (X20 = the returned key image address)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X9)  # src = record + key_off
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    a64_b(&mut ctx.text, ".Lmap_remove_key_unlink")
    def_label(&mut ctx.text, ".Lmap_remove_key_ret_record")
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X20, A64::X24, A64::X9)  # record + key_off
    def_label(&mut ctx.text, ".Lmap_remove_key_unlink")
    a64_cmp_ri(&mut ctx.text, A64::X25, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Lmap_remove_key_chain_unlink")
    # head: promote the successor into the removed slot, or mark empty
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lmap_remove_key_zero_hash")
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 80)  # count = bucket_stride
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)  # src = successor
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X24)  # dst = removed slot
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the old successor node onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X11, 0)
    a64_stur(&mut ctx.text, A64::X11, A64::X19, 88)
    a64_b(&mut ctx.text, ".Lmap_remove_key_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_key_chain_unlink")
    # chain node: P->next = R->next; push R onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # R->next
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X25, A64::X9)
    a64_str(&mut ctx.text, A64::X11, A64::X12, 0)  # P->next = R->next
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X24, 0)  # R[0] = free_list
    a64_stur(&mut ctx.text, A64::X24, A64::X19, 88)  # free_list = R
    a64_b(&mut ctx.text, ".Lmap_remove_key_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_key_zero_hash")
    a64_str(&mut ctx.text, A64::XZR, A64::X24, 0)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_remove_key_size_dec")
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    # return the removed key's image address (fresh copy or record slot)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)

    def_label(&mut ctx.text, ".Lmap_remove_key_ret")
    a64_ldp_post(&mut ctx.text, A64::X25, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key address
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # hash
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # eq_fn
    x64_push(&mut ctx.text, X64::R8)   # v_out preserved on the stack (0 for sets)
 # STORED-HASH ENCODING: stored = hash == 0 ? 1: hash (see the
    # map contract) — a user hash of 0 probes the same bucket as the
    # stored encoding and can never be confused with the empty marker.
    let lblHashNz = fresh_label(ctx, ".Lmap_remove_key_hash_nz")
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblHashNz.clone())
    x64_mov_ri(&mut ctx.text, X64::R13, 1)
    def_label(&mut ctx.text, lblHashNz)
    # R15 = the chain PARENT of the current record (0 = the bucket head) —
 # the unlink authority (see the a64 arm).
    x64_mov_ri(&mut ctx.text, X64::R15, 0)

    # probe (rbp) = buckets + (hash & (capacity - 1)) * bucket_stride
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    # eq_fn(bucket + key_off, key)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 24)  # key stride (mem-eq size)
    x64_call_r(&mut ctx.text, X64::R14)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    def_label(&mut ctx.text, lblNext.clone())
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RBP)  # the current record becomes the parent
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_remove_key_ret")

    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)  # value_stride
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblFoundUnit.clone())
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RSP, 0)  # v_out
    x64_test_rr(&mut ctx.text, X64::R8, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, lblFoundUnit.clone())
    # copy the removed value's image into the caller's slot: v_out is the
    # dst (r10) and src = record + value_off (r9); the copy-loop
    # convention is (count r8, src r9, dst r10 — RAX is the byte temp).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)  # src = record + value_off
    x64_mov_rm(&mut ctx.text, X64::R10, X64::RSP, 0)  # dst = v_out
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBX, 40)  # count = value_stride
    emit_x64_copy_loop(ctx, X64::R8, X64::R9, X64::R10)

    def_label(&mut ctx.text, lblFoundUnit.clone())
 # the removed KEY's image must survive the
    # unlink until the MIR's drop glue runs on the returned address (see
    # the a64 arm): the head-promotion case extracts the key into a fresh
    # allocation; the chain-node unlink and the tail case return the
    # record's key slot itself. R12 (dead key-address arg) carries the
    # returned key image address.
    x64_test_rr(&mut ctx.text, X64::R15, X64::R15)
    x64_jcc(&mut ctx.text, CC::NE, ".Lmap_remove_key_ret_record")
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, ".Lmap_remove_key_ret_record")
    # fresh key copy (R12 = the returned key image address)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = record + key_off
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)  # dst
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    x64_jmp(&mut ctx.text, ".Lmap_remove_key_unlink")
    def_label(&mut ctx.text, ".Lmap_remove_key_ret_record")
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::R12, X64::RAX)  # record + key_off
    def_label(&mut ctx.text, ".Lmap_remove_key_unlink")
    x64_test_rr(&mut ctx.text, X64::R15, X64::R15)
    x64_jcc(&mut ctx.text, CC::NE, ".Lmap_remove_key_chain_unlink")
    # head: promote the successor into the removed slot, or mark empty
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, ".Lmap_remove_key_zero_hash")
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 80)  # count = bucket_stride
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)  # src = successor
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)  # dst = removed slot
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # push the old successor node onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RCX)
    x64_jmp(&mut ctx.text, ".Lmap_remove_key_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_key_chain_unlink")
    # chain node: P->next = R->next; push R onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # R->next
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R15)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)  # P + next_off
    x64_mov_mr(&mut ctx.text, X64::R9, 0, X64::RCX)  # P->next = R->next
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # R[0] = free_list
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RBP)  # free_list = R
    x64_jmp(&mut ctx.text, ".Lmap_remove_key_size_dec")
    def_label(&mut ctx.text, ".Lmap_remove_key_zero_hash")
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_remove_key_size_dec")
    # size--
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    # return the removed key's image address (fresh copy or record slot)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)

    def_label(&mut ctx.text, ".Lmap_remove_key_ret")
    x64_pop(&mut ctx.text, X64::R8)   # discard the saved v_out
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_destroy: release the map's bucket arena AND every mmap'ed
# overflow node (the live chains AND the free-list nodes reclaimed by the
# clear/remove paths). Args: x0/rdi = map.
def emit_tg_map_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_destroy")
  let lblBucketLoop = fresh_label(ctx, ".Lmap_destroy_bucket_loop")
  let lblChain = fresh_label(ctx, ".Lmap_destroy_chain")
  let lblChainDone = fresh_label(ctx, ".Lmap_destroy_chain_done")
  let lblSkip = fresh_label(ctx, ".Lmap_destroy_skip")
  let lblFreeChain = fresh_label(ctx, ".Lmap_destroy_free_chain")
  let lblFreeDone = fresh_label(ctx, ".Lmap_destroy_free_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # buckets
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    # Free overflow chains first (separate mmap allocations).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 16)   # capacity
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 80)   # bucket_stride
    a64_mul_rrr(&mut ctx.text, A64::X23, A64::X21, A64::X22)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X20, A64::X23)  # end
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)  # current bucket
    def_label(&mut ctx.text, lblBucketLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblSkip.clone())
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 72)  # next_off
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X21, A64::X24)
    a64_ldr(&mut ctx.text, A64::X24, A64::X24, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainDone.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X24, A64::X9)
    a64_ldr(&mut ctx.text, A64::X9, A64::X9, 0)  # next->next (save across munmap)
    a64_stp_pre(&mut ctx.text, A64::X9, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)  # bucket_stride
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainDone.clone())
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X22)
    a64_b(&mut ctx.text, lblBucketLoop.clone())
    def_label(&mut ctx.text, lblSkip.clone())
    # Free the main bucket arena: munmap(buckets, capacity * bucket_stride).
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    # Free the FREE-LIST nodes (the overflow nodes reclaimed by clear /
    # remove / drain — each is its own mmap allocation; a node's [0] word
    # carries the next free node).
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFreeDone.clone())
    def_label(&mut ctx.text, lblFreeChain.clone())
    a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)  # next (save across munmap)
    a64_stp_pre(&mut ctx.text, A64::X10, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)  # bucket_stride
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X9, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFreeChain.clone())
    def_label(&mut ctx.text, lblFreeDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = map,
    # R12 = buckets, R13 = next/free-list node, R14 = current record,
    # R15 = arena end; RAX/RCX/RDI/RSI are call-clobbered scratch.
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 0)  # buckets
    x64_test_rr(&mut ctx.text, X64::R12, X64::R12)
    x64_jcc(&mut ctx.text, CC::E, lblSkip.clone())
    # Free overflow chains first (separate mmap allocations).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)  # capacity
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)  # bucket_stride
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R12)
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)  # end
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R12)  # current bucket
    def_label(&mut ctx.text, lblBucketLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblSkip.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_add_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::R13, X64::R13, 0)  # next
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lblChainDone.clone())
    def_label(&mut ctx.text, lblChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)  # next->next (save across munmap)
    x64_push(&mut ctx.text, X64::RDI)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # addr = node
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 80)  # size = bucket_stride
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)  # munmap
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)  # munmap
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_pop(&mut ctx.text, X64::R13)  # successor
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblChain.clone())
    def_label(&mut ctx.text, lblChainDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_jmp(&mut ctx.text, lblBucketLoop.clone())
    def_label(&mut ctx.text, lblSkip.clone())
    # Free the main bucket arena: munmap(buckets, capacity * bucket_stride).
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RSI, X64::RCX)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)  # munmap
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)  # munmap
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    # Free the FREE-LIST nodes (each is its own mmap allocation; a node's
    # [0] word carries the next free node).
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 88)
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lblFreeDone.clone())
    def_label(&mut ctx.text, lblFreeChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R13, 0)  # next (save across munmap)
    x64_push(&mut ctx.text, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # addr = node
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 80)  # size = bucket_stride
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)  # munmap
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)  # munmap
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_pop(&mut ctx.text, X64::R13)  # next
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::NE, lblFreeChain.clone())
    def_label(&mut ctx.text, lblFreeDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_drain_one: destructively remove the FIRST live entry and transfer
# it into the caller's sret Option[(K, V)] slot (AArch64: x8; x86-64: r8 —
# the drain sret register set by the codegen at the call site).
# The sret payload is the concrete (K, V) tuple: key at payload+0, value at
# payload + t_v_off (t_v_off passed by the codegen). Args:
# a64: x0 = map, x8 = sret, x1 = t_v_off, x2 = t_size;
# x86: rdi = map, r8 = sret, rsi = t_v_off, rdx = t_size.
# The drained record is REAL-unlinked: the successor's full
# record image is promoted into the drained slot and the old successor
# node is pushed onto the free list, or the tail is marked empty — no
# live entry is ever hidden behind a zeroed hash. After the chain
# fixes, an empty bucket head can never carry a chain, so the scan only
# looks at the bucket heads.
def emit_tg_map_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_drain_one_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_drain_one_full")
  end
end

def emit_tg_map_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lmap_drain_scan")
  let lblFoundBucket = fresh_label(ctx, ".Lmap_drain_found_bucket")
  let lblRemove = fresh_label(ctx, ".Lmap_drain_remove")
  let lblZeroHash = fresh_label(ctx, ".Lmap_drain_zero_hash")
  let lblDone = fresh_label(ctx, ".Lmap_drain_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X1)  # t_v_off

    # Default: None (disc = 1)
    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    # end = buckets + capacity * bucket_stride
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X2)  # current bucket

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)  # stored hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X1)
    a64_b(&mut ctx.text, lblScan.clone())

    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X23)
    def_label(&mut ctx.text, lblRemove.clone())
    # sret: Some (disc = 0)
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)
    # key bytes: rec + key_off -> sret + 8
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # value bytes: rec + value_off -> sret + 8 + t_v_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X21)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
 # promote the successor's full record image into the drained
    # slot (the drained entry's image was already copied to the sret), or
    # mark the tail empty.
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblZeroHash.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 80)  # count = bucket_stride
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)  # src = successor
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X22)  # dst = drained slot
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the old successor node onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X11, 0)
    a64_stur(&mut ctx.text, A64::X11, A64::X19, 88)
    a64_b(&mut ctx.text, ".Lmap_drain_size_dec")
    def_label(&mut ctx.text, lblZeroHash.clone())
    a64_str(&mut ctx.text, A64::XZR, A64::X22, 0)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_drain_size_dec")
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # t_v_off
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R8)   # sret

    # Default: None (disc = 1)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RAX)

    # end = buckets + capacity * bucket_stride (R15); current = R14
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R14)
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)

    def_label(&mut ctx.text, lblScan.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R14, 0)  # stored hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFoundBucket.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_jmp(&mut ctx.text, lblScan)

    def_label(&mut ctx.text, lblFoundBucket.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::R14)
    def_label(&mut ctx.text, lblRemove.clone())
    # sret: Some (disc = 0)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RAX)
    # key bytes: rec + key_off -> sret + 8
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RDI, 8)  # dst
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
    # value bytes: rec + value_off -> sret + 8 + t_v_off
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 40)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RDI, 8)  # dst
    x64_add_rr(&mut ctx.text, X64::RDI, X64::R12)
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
 # promote the successor's full record image into the drained
    # slot (the drained entry's image was already copied to the sret), or
    # mark the tail empty.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblZeroHash.clone())
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 80)  # count = bucket_stride
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)  # src = successor
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)  # dst = drained slot
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # push the old successor node onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RCX)
    x64_jmp(&mut ctx.text, ".Lmap_drain_size_dec")
    def_label(&mut ctx.text, lblZeroHash.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)  # tail: empty marker
    def_label(&mut ctx.text, ".Lmap_drain_size_dec")
    # size--
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_set_drain_one: destructively remove the FIRST live element of a set
# (a Map[T, Unit]) into the caller's sret Option[T] slot. Args:
# a64: x0 = set, x8 = sret; x86: rdi = set, r8 = sret.
# The drained record is REAL-unlinked (— the successor's full
# record image is promoted into the drained slot and the old successor
# node is pushed onto the free list, or the tail is marked empty), exactly
# like _tg_map_drain_one.
def emit_tg_set_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_set_drain_one_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_set_drain_one_full")
  end
end

def emit_tg_set_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lset_drain_scan")
  let lblFoundBucket = fresh_label(ctx, ".Lset_drain_found_bucket")
  let lblRemove = fresh_label(ctx, ".Lset_drain_remove")
  let lblZeroHash = fresh_label(ctx, ".Lset_drain_zero_hash")
  let lblDone = fresh_label(ctx, ".Lset_drain_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # set
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret

    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X3, A64::X1, A64::X2)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X2)

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 80)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X1)
    a64_b(&mut ctx.text, lblScan.clone())

    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X23)
    def_label(&mut ctx.text, lblRemove.clone())
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)  # Some (disc = 0)
    # element bytes: rec + key_off -> sret + 8
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)  # src
    a64_add_rri(&mut ctx.text, A64::X2, A64::X20, 8)  # dst
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
 # promote the successor's full record image into the drained
    # slot, or mark the tail empty.
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X9)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblZeroHash.clone())
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 80)  # count = bucket_stride
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)  # src = successor
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X22)  # dst = drained slot
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the old successor node onto the free list
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 88)
    a64_str(&mut ctx.text, A64::X9, A64::X11, 0)
    a64_stur(&mut ctx.text, A64::X11, A64::X19, 88)
    a64_b(&mut ctx.text, ".Lset_drain_size_dec")
    def_label(&mut ctx.text, lblZeroHash.clone())
    a64_str(&mut ctx.text, A64::XZR, A64::X22, 0)
    def_label(&mut ctx.text, ".Lset_drain_size_dec")
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # set
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R8)   # sret

    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RAX)

    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R14)
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)

    def_label(&mut ctx.text, lblScan.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R14, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFoundBucket.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_jmp(&mut ctx.text, lblScan)

    def_label(&mut ctx.text, lblFoundBucket.clone())
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::R14)
    def_label(&mut ctx.text, lblRemove.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RAX)  # Some (disc = 0)
    # element bytes: rec + key_off -> sret + 8
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 24)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RDI, 8)  # dst
    emit_x64_copy_loop(ctx, X64::RCX, X64::RSI, X64::RDI)
 # promote the successor's full record image into the drained
    # slot, or mark the tail empty.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDX, 0)  # successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblZeroHash.clone())
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 80)  # count = bucket_stride
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RCX)  # src = successor
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RBP)  # dst = drained slot
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # push the old successor node onto the free list
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 88)
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RBX, 88, X64::RCX)
    x64_jmp(&mut ctx.text, ".Lset_drain_size_dec")
    def_label(&mut ctx.text, lblZeroHash.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBP, 0, X64::RAX)
    def_label(&mut ctx.text, ".Lset_drain_size_dec")
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_contains: Check if a key exists. Args: x0/rdi = map,
# x1/rsi = key address, x2/rdx = hash, x3/rcx = eq_fn.
# Returns: x0/rax = 1 when present, 0 otherwise.
def emit_tg_map_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_contains")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_map_get")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_cset(&mut ctx.text, A64::X0, a64_cc_ne())
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_map_get")
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_setcc(&mut ctx.text, CC::NE, X64::RAX)
    x64_movzx_r64_r8(&mut ctx.text, X64::RAX, X64::RAX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_clear: Clear the map. Every bucket head's hash and
# next are zeroed, every chain's overflow nodes are linked into the
# header's FREE LIST (each node's [0] word becomes the free-list next
# pointer) so later insertions REUSE them instead of mmap'ing fresh ones,
# and size = 0. The chain link of every head is severed, so no lookup or
# drain can ever walk into a reclaimed node. Args: x0/rdi.
def emit_tg_map_clear(ctx: &mut RuntimeEmitCtx) -> Unit

  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # map
    a64_ldur(&mut ctx.text, A64::X10, A64::X9, 0)   # buckets
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 16)  # capacity
    a64_ldur(&mut ctx.text, A64::X12, A64::X9, 80)  # bucket_stride
    a64_mul_rrr(&mut ctx.text, A64::X11, A64::X11, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X10, A64::X11)  # end

    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")
    let lblChain = fresh_label(ctx, ".Lmap_clear_chain")
    let lblChainDone = fresh_label(ctx, ".Lmap_clear_chain_done")

    # X10 (buckets — consumed by the end computation) is reused as the
    # free-list temp inside the loop.
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X10)  # current record
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    # Collect the chain: every node at head->next and beyond goes onto the
 # free list — a free node's [0] word carries the free-list
    # next pointer.
    a64_ldur(&mut ctx.text, A64::X14, A64::X9, 72)  # next_off
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X13, A64::X14)
    a64_ldr(&mut ctx.text, A64::X14, A64::X14, 0)  # node
    def_label(&mut ctx.text, lblChain.clone())
    a64_cmp_ri(&mut ctx.text, A64::X14, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainDone.clone())
    a64_ldur(&mut ctx.text, A64::X15, A64::X9, 72)
    a64_add_rrr(&mut ctx.text, A64::X15, A64::X14, A64::X15)
    a64_ldr(&mut ctx.text, A64::X15, A64::X15, 0)  # next
    a64_ldur(&mut ctx.text, A64::X10, A64::X9, 88)  # free_list
    a64_str(&mut ctx.text, A64::X10, A64::X14, 0)  # node[0] = free_list
    a64_stur(&mut ctx.text, A64::X14, A64::X9, 88)  # free_list = node
    a64_mov_rr(&mut ctx.text, A64::X14, A64::X15)
    a64_b(&mut ctx.text, lblChain.clone())
    def_label(&mut ctx.text, lblChainDone.clone())
    # zero the head's hash AND its next link (the chain is severed).
    a64_str(&mut ctx.text, A64::XZR, A64::X13, 0)  # hash = 0
    a64_ldur(&mut ctx.text, A64::X14, A64::X9, 72)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X13, A64::X14)
    a64_str(&mut ctx.text, A64::XZR, A64::X14, 0)  # next = 0
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X13, A64::X12)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_stur(&mut ctx.text, A64::XZR, A64::X9, 8)  # size = 0
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RCX)

    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # map
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)   # buckets
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RCX, 16)  # capacity
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RCX, 80)  # bucket_stride
    x64_imul_rr(&mut ctx.text, X64::RDX, X64::RSI)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)  # end

    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")
    let lblChain = fresh_label(ctx, ".Lmap_clear_chain")
    let lblChainDone = fresh_label(ctx, ".Lmap_clear_chain_done")

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)  # current record
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RDI, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
 # Collect the chain onto the free list.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RDI)
    x64_add_rr(&mut ctx.text, X64::R8, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::R8, X64::R8, 0)  # node
    def_label(&mut ctx.text, lblChain.clone())
    x64_test_rr(&mut ctx.text, X64::R8, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, lblChainDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R8)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::R9, X64::R9, 0)  # next
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 88)  # free_list
    x64_mov_mr(&mut ctx.text, X64::R8, 0, X64::RAX)  # node[0] = free_list
    x64_mov_mr(&mut ctx.text, X64::RCX, 88, X64::R8)  # free_list = node
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R9)
    x64_jmp(&mut ctx.text, lblChain)
    def_label(&mut ctx.text, lblChainDone.clone())
    # zero the head's hash AND its next link (the chain is severed).
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RAX)  # hash = 0
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RDI)
    x64_add_rr(&mut ctx.text, X64::R9, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R9, 0, X64::RAX)  # next = 0
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 8, X64::RAX)  # size = 0

    x64_pop(&mut ctx.text, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end
# _tg_map_entries: Collect all (key, value) pairs into a Vec[(K, V)].
# The vec is a TRUE IMAGE vec: the header stride is the (K, V) tuple's
# category-derived element stride (x3/rcx — passed by the codegen, the same
# authority the caller's ProjIndex addressing uses), and each slot holds
# the tuple IMAGE (key at 0, value at t_v_off, t_size bytes total —
# computed by the codegen from the same layout parameters) — the tuple is
# assembled in a temp and the element transfer follows the unified rule
# (load_elem_arg: the scalar image word, or the image ADDRESS for
# ScalarPair/ByAddress, which the push byte-copies).
# Args: x0/rdi = map, x1/rsi = t_v_off, x2/rdx = t_size, x3/rcx = entry stride.
# Returns: x0/rax = Vec pointer.
def emit_tg_map_entries(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_entries")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_entries_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_entries_chain")
  let lblDone = fresh_label(ctx, ".Lmap_entries_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_entries_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X25, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # t_v_off
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # t_size
    a64_mov_rr(&mut ctx.text, A64::X25, A64::X3)  # entry stride (header authority)
    # result Vec (element stride = the tuple's category-derived stride)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X25)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # vec
    # end = buckets + capacity * bucket_stride (X23); current = X24
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    # Allocate the tuple object and copy the inline key/value bytes.
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)  # save record
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)  # t_size
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_stp_pre(&mut ctx.text, A64::X0, A64::XZR, A64::SP, -16)  # save tuple
    # key bytes: rec + key_off -> tuple + 0
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 56)
    a64_ldur(&mut ctx.text, A64::X10, A64::SP, 16)  # record
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X10, A64::X9)  # src
    a64_ldur(&mut ctx.text, A64::X2, A64::SP, 0)  # tuple
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # value bytes: rec + value_off -> tuple + t_v_off
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 64)
    a64_ldur(&mut ctx.text, A64::X10, A64::SP, 16)  # record
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X10, A64::X9)  # src
    a64_ldur(&mut ctx.text, A64::X2, A64::SP, 0)  # tuple
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X20)
    emit_a64_copy_loop(ctx, A64::X0, A64::X1, A64::X2)
    # push the tuple image: the element per its value category — the
    # scalar image word or the image ADDRESS (the push byte-copies the
    # full image for ScalarPair/ByAddress tuples).
    a64_ldur(&mut ctx.text, A64::X1, A64::SP, 0)
    emit_a64_load_elem_arg(ctx, A64::X1, A64::X1, A64::X25)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)  # drop tuple
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)  # record

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X25, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = map,
    # R12 = t_v_off, R13 = t_size, R14 = entry stride, R15 = vec,
    # RBP = current record, [RSP] = arena end (pushed once).
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # t_v_off
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # t_size
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # entry stride (header authority)
    # result Vec (element stride = the tuple's category-derived stride)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # vec
    # end = buckets + capacity * bucket_stride (pushed on the stack)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_push(&mut ctx.text, X64::RAX)  # [RSP] = end
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_cmp_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChainNext.clone())

    # Allocate the tuple object and copy the inline key/value bytes.
    x64_push(&mut ctx.text, X64::RBP)  # save record
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # t_size
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_push(&mut ctx.text, X64::RAX)  # save tuple
    # key bytes: rec + key_off -> tuple + 0
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)  # count = key_stride
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RSP, 16)  # record
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 56)  # key_off
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RSP, 0)  # tuple
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # value bytes: rec + value_off -> tuple + t_v_off
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 40)  # count = value_stride
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RSP, 16)  # record
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 64)  # value_off
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RSP, 0)  # tuple
    x64_add_rr(&mut ctx.text, X64::RDX, X64::R12)  # dst = tuple + t_v_off
    emit_x64_copy_loop(ctx, X64::RDI, X64::RSI, X64::RDX)
    # push the tuple image: the element per its value category — the
    # scalar image word or the image ADDRESS (the push byte-copies the
    # full image for ScalarPair/ByAddress tuples).
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RSP, 0)
    emit_x64_load_elem_arg(ctx, X64::RSI, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)  # vec
    x64_call_label(&mut ctx.text, "_tg_array_push")
    x64_add_ri(&mut ctx.text, X64::RSP, 16)  # drop tuple
    x64_add_ri(&mut ctx.text, X64::RSP, 16)  # drop record

    def_label(&mut ctx.text, lblChainNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RCX, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblChain.clone())
    # chain end: advance to the next TABLE record
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)  # bucket_stride
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblBuckLoop.clone())

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)  # vec
    x64_add_ri(&mut ctx.text, X64::RSP, 8)  # drop the pushed end
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# The clone-aware record traversal — __intrinsic_map_visit_begin /
# __intrinsic_map_visit_next / __intrinsic_map_visit_value (and the Set
# aliases __intrinsic_set_visit_begin / __intrinsic_set_visit_next).
#
# These are the NON-DESTRUCTIVE record walk that every Clone-bound surface
# (Map::entries_cloned, the Set algebra, the snapshot iterators) builds
# on. The walk yields the LIVE record's key/value ADDRESSES — the
# projected READ: the consumer (the std loop, lowered through the MIR)
# clones each key and value with its CONCRETE clone instance directly from
# the live slot. The runtime NEVER materializes an image of the stored
# key or value (no byte-copy of the record fields, no second owner), and
# it NEVER mutates the map: no unlink, no free-list churn, no size change.
# The traversal is therefore safe against any concurrent shared read of
# the map (mutation during iteration is implementation-defined, exactly
# like the raw entries snapshot).
#
# VISIT ORDER (deterministic): the bucket arena in address order; within a
# bucket, the head record first, then its chain successors (the chain
# next pointers). Every live record is visited exactly once: a table
# record is reached when its bucket's turn comes up in the scan, a chain
# node immediately after its predecessor.
#
# THE OPTION[&K] WORD (the begin/next returns): the standard TaggedPtr
# enum word. None = the inline discriminant (1). Some = the address of a
# fresh 16-byte image { disc = 0 @ 0, payload = the key ADDRESS @ 8 } —
# the same {disc, payload} image shape the drain helpers write, so the
# caller's MirDiscriminant / Variant payload projections read the
# projected address out of it. The payload is a REFERENCE (a pointer to
# the live slot), never an owned copy: the consumer clones through it.
#
# Args (begin): x0/rdi = map. Returns: the Option[&K] word in x0/rax.
# Args (next): x0/rdi = map, x1/rsi = the previous key ADDRESS (the
#   cursor — the projected read of the record the walk resumes from).
#   Returns: the Option[&K] word.
# Args (value): x0/rdi = map, x1/rsi = the key ADDRESS. Returns: the
#   value ADDRESS in x0/rax (the projected &V).
#
# All header reads route through the canonical MAP_HEADER_FIELDS table
# (layout_engine.tg map_header_field_offset) — never hardcoded literals.
# x86-64 parity: the a64 arms mirrored register-for-register below (the
# entries/drain family's fail-closed policy is gone for this surface).
# ———————————————————————————————————————————————————————————————
def emit_tg_map_visit_begin(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_map_visit_begin")
  let lblBuckLoop = fresh_label(ctx, ".Lmap_visit_begin_bloop")
  let lblFound = fresh_label(ctx, ".Lmap_visit_begin_found")
  let lblNone = fresh_label(ctx, ".Lmap_visit_begin_none")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    # None default: x0 = 1 (the inline None discriminant of Option[&K]).
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    # end = buckets + capacity * bucket_stride (X21); current = X22.
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, map_header_field_offset(&"buckets".to_string()))
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"capacity".to_string()))
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, map_header_field_offset(&"buckets".to_string()))

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblNone.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X22, 0)  # stored hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    # The record is empty: advance to the next table record.
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X22, A64::X22, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop.clone())

    # Found a live record (in X22): build the Some[&K] word — a fresh
    # 16-byte image { disc = 0 @ 0, payload = key_addr @ 8 } (the
    # projected READ of the live slot; the consumer clones through the
    # address).
    def_label(&mut ctx.text, lblFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_stur(&mut ctx.text, A64::XZR, A64::X0, 0)  # disc = 0 (Some)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"key_off".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X22, A64::X9)  # key address
    a64_stur(&mut ctx.text, A64::X9, A64::X0, 8)  # payload = the key address
    a64_b(&mut ctx.text, ".Lmap_visit_begin_ret")

    # Empty map: return the inline None word (x0 = 1).
    def_label(&mut ctx.text, lblNone)
    def_label(&mut ctx.text, ".Lmap_visit_begin_ret")
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = map,
    # R14 = current record, R15 = arena end; RAX/RCX/RDI/RSI scratch.
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    # None default: rax = 1 (the inline None discriminant of Option[&K]).
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    # end = buckets + capacity * bucket_stride (R15); current = R14.
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, map_header_field_offset(&"buckets".to_string()))
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"capacity".to_string()))
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::R15, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, map_header_field_offset(&"buckets".to_string()))

    def_label(&mut ctx.text, lblBuckLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblNone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R14, 0)  # stored hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    # The record is empty: advance to the next table record.
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_jmp(&mut ctx.text, lblBuckLoop.clone())

    # Found a live record (in R14): build the Some[&K] word — a fresh
    # 16-byte image { disc = 0 @ 0, payload = key_addr @ 8 }.
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)  # disc = 0 (Some)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"key_off".to_string()))
    x64_add_rr(&mut ctx.text, X64::RCX, X64::R14)  # key address
    x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RCX)  # payload = the key address
    x64_jmp(&mut ctx.text, ".Lmap_visit_begin_ret")

    # Empty map: return the inline None word (rax = 1).
    def_label(&mut ctx.text, lblNone.clone())
    def_label(&mut ctx.text, ".Lmap_visit_begin_ret")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_map_visit_next(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_map_visit_next")
  let lblBuckLoop = fresh_label(ctx, ".Lmap_visit_next_bloop")
  let lblFound = fresh_label(ctx, ".Lmap_visit_next_found")
  let lblNone = fresh_label(ctx, ".Lmap_visit_next_none")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # cursor: the previous key ADDRESS
    # None default: x0 = 1 (the inline None discriminant of Option[&K]).
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    # rec = key_addr - key_off (X21); the next pointer at [rec + next_off].
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"key_off".to_string()))
    a64_sub_rrr(&mut ctx.text, A64::X21, A64::X20, A64::X9)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"next_off".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X21, A64::X10)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)  # chain successor
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblBuckLoop.clone())
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X11)  # the successor record
    a64_b(&mut ctx.text, lblFound.clone())

    # Chain exhausted (or the record is a table record): continue the
    # bucket scan from the record's OWN bucket — the bucket index is
 # derived from the record's stored hash (the normalized
    # encoding, never 0 for a live record): head = buckets +
    # (stored_hash & (capacity - 1)) * bucket_stride; scan from
    # head + bucket_stride to the arena end.
    def_label(&mut ctx.text, lblBuckLoop)
    a64_ldr(&mut ctx.text, A64::X9, A64::X21, 0)  # stored hash
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"capacity".to_string()))
    a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 1)  # mask (capacity is a power of 2)
    a64_and_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)  # bucket index
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"buckets".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X22, A64::X10, A64::X9)  # head
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X22, A64::X22, A64::X9)  # scan from the NEXT bucket
    # end = buckets + capacity * bucket_stride (X21).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, map_header_field_offset(&"buckets".to_string()))
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"capacity".to_string()))
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)

    def_label(&mut ctx.text, ".Lmap_visit_next_scan")
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblNone.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X22, 0)  # stored hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, map_header_field_offset(&"bucket_stride".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X22, A64::X22, A64::X11)
    a64_b(&mut ctx.text, ".Lmap_visit_next_scan")

    # Found a live record (in X22): build the Some[&K] word — the fresh
    # 16-byte image { disc = 0 @ 0, payload = key_addr @ 8 }.
    def_label(&mut ctx.text, lblFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_stur(&mut ctx.text, A64::XZR, A64::X0, 0)  # disc = 0 (Some)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, map_header_field_offset(&"key_off".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X22, A64::X9)  # key address
    a64_stur(&mut ctx.text, A64::X9, A64::X0, 8)  # payload = the key address
    a64_b(&mut ctx.text, ".Lmap_visit_next_ret")

    # Walk exhausted: return the inline None word (x0 = 1).
    def_label(&mut ctx.text, lblNone)
    def_label(&mut ctx.text, ".Lmap_visit_next_ret")
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = map,
    # R12 = cursor (the previous key ADDRESS), R13 = rec, R14 = scan record,
    # R15 = arena end; RAX/RCX/RDX/RSI scratch.
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # cursor: the previous key ADDRESS
    # None default: rax = 1 (the inline None discriminant of Option[&K]).
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    # rec = key_addr - key_off (R13); the next pointer at [rec + next_off].
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"key_off".to_string()))
    x64_mov_rr(&mut ctx.text, X64::R13, X64::R12)
    x64_sub_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"next_off".to_string()))
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R13)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RCX, 0)  # chain successor
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblBuckLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)  # the successor record
    x64_jmp(&mut ctx.text, lblFound.clone())

    # Chain exhausted (or the record is a table record): continue the
    # bucket scan from the record's OWN bucket — head = buckets +
    # (stored_hash & (capacity - 1)) * bucket_stride; scan from
    # head + bucket_stride to the arena end.
    def_label(&mut ctx.text, lblBuckLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R13, 0)  # stored hash
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"capacity".to_string()))
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)  # mask (capacity is a power of 2)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)  # bucket index
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"buckets".to_string()))
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)  # head
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)  # scan from the NEXT bucket
    # end = buckets + capacity * bucket_stride (R15).
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, map_header_field_offset(&"buckets".to_string()))
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"capacity".to_string()))
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)

    def_label(&mut ctx.text, ".Lmap_visit_next_scan")
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_jcc(&mut ctx.text, CC::GE, lblNone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R14, 0)  # stored hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, map_header_field_offset(&"bucket_stride".to_string()))
    x64_add_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_jmp(&mut ctx.text, ".Lmap_visit_next_scan")

    # Found a live record (in R14): build the Some[&K] word — the fresh
    # 16-byte image { disc = 0 @ 0, payload = key_addr @ 8 }.
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 16)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)  # disc = 0 (Some)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, map_header_field_offset(&"key_off".to_string()))
    x64_add_rr(&mut ctx.text, X64::RCX, X64::R14)  # key address
    x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RCX)  # payload = the key address
    x64_jmp(&mut ctx.text, ".Lmap_visit_next_ret")

    # Walk exhausted: return the inline None word (rax = 1).
    def_label(&mut ctx.text, lblNone.clone())
    def_label(&mut ctx.text, ".Lmap_visit_next_ret")
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_map_visit_value(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_map_visit_value")
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = map, x1 = the key ADDRESS; value_addr = key_addr - key_off +
    # value_off (the projected &V of the live slot).
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, map_header_field_offset(&"key_off".to_string()))
    a64_sub_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X9)
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, map_header_field_offset(&"value_off".to_string()))
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X1, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # x86-64 PARITY: rdi = map, rsi = the key ADDRESS;
    # value_addr = key_addr - key_off + value_off (the projected &V).
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, map_header_field_offset(&"key_off".to_string()))
    x64_sub_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, map_header_field_offset(&"value_off".to_string()))
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RSI)
    x64_ret(&mut ctx.text)
  end
end

# Set traversal aliases: a Set IS a Map[T, Unit] under the same header
# contract, so the set walk IS the map walk (the element is the key; the
# value is never read by the set surfaces).
def emit_tg_set_visit_begin(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_set_visit_begin")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "__intrinsic_map_visit_begin")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "__intrinsic_map_visit_begin")
  end
end

def emit_tg_set_visit_next(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_set_visit_next")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "__intrinsic_map_visit_next")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "__intrinsic_map_visit_next")
  end
end

# _tg_map_keys: Extract all keys into a new Vec[T]. The vec is a TRUE
# IMAGE vec: the header stride is the key type's category-derived element
# stride (x1/rsi — passed by the codegen, the same authority the caller's
# ProjIndex addressing uses), and each slot holds the key IMAGE — the
# element per its value category (load_elem_arg: the scalar key VALUE word,
# or the key image ADDRESS for ScalarPair/ByAddress, which the push
# byte-copies). Args: x0/rdi = map, x1/rsi = key stride.
# Returns: x0/rax = Vec pointer.
def emit_tg_map_keys(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_keys")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_keys_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_keys_chain")
  let lblDone = fresh_label(ctx, ".Lmap_keys_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_keys_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key stride (header authority)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # vec
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)  # end
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    # The key per its value category: the scalar key VALUE word (loaded
    # from the record's inline key) or the key image ADDRESS (the push
    # byte-copies the full image for ScalarPair/ByAddress keys).
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    emit_a64_load_elem_arg(ctx, A64::X1, A64::X1, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_bl(&mut ctx.text, "_tg_array_push")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)  # next
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = map,
    # R12 = key stride, R15 = vec, RBP = current record, [RSP] = arena end.
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key stride (header authority)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # vec
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_push(&mut ctx.text, X64::RAX)  # [RSP] = end
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_cmp_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChainNext.clone())

    # The key per its value category: the scalar key VALUE word (loaded
    # from the record's inline key) or the key image ADDRESS (the push
    # byte-copies the full image for ScalarPair/ByAddress keys).
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 56)  # key_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 8)  # record
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # src = record + key_off
    emit_x64_load_elem_arg(ctx, X64::RSI, X64::RSI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)  # vec
    x64_call_label(&mut ctx.text, "_tg_array_push")
    x64_add_ri(&mut ctx.text, X64::RSP, 16)  # drop record

    def_label(&mut ctx.text, lblChainNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RCX, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblChain.clone())
    # chain end: advance to the next TABLE record
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)  # bucket_stride
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblBuckLoop.clone())

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)  # vec
    x64_add_ri(&mut ctx.text, X64::RSP, 8)  # drop the pushed end
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_clone: Create a shallow clone of a map by re-inserting all
# entries into a fresh map of the SAME layout (the layout parameters are
# read from the source header). The source records' cached hashes are
# re-inserted verbatim; eq_fn (x1/rsi) is forwarded to the probe loop
# (never invoked while the destination is empty). Args: x0/rdi = source
# map, x1/rsi = eq_fn. Returns: x0/rax = cloned map.
def emit_tg_map_clone(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_clone")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_clone_bloop")
  let lblChain = fresh_label(ctx, ".Lmap_clone_chain")
  let lblDone = fresh_label(ctx, ".Lmap_clone_done")
  let lblChainNext = fresh_label(ctx, ".Lmap_clone_chain_next")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # source map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # eq_fn
    # destination map with the SAME layout (header fields → map_new args)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 24)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 32)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 40)
    a64_ldur(&mut ctx.text, A64::X3, A64::X19, 48)
    a64_bl(&mut ctx.text, "_tg_map_new")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # destination map

    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X9, A64::X19, 16)
    a64_ldur(&mut ctx.text, A64::X10, A64::X19, 80)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X10)
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X9)  # end
    a64_ldur(&mut ctx.text, A64::X24, A64::X19, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X24, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X11, A64::X24, 0)  # cached hash
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainNext.clone())

    # dst.insert(bucket + key_off, bucket + value_off, cached_hash, eq_fn)
    a64_stp_pre(&mut ctx.text, A64::X24, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 56)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X24, A64::X1)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 64)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X24, A64::X2)
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X11)
    a64_mov_rr(&mut ctx.text, A64::X4, A64::X20)
    a64_bl(&mut ctx.text, "_tg_map_insert")
    a64_ldp_post(&mut ctx.text, A64::X24, A64::XZR, A64::SP, 16)

    def_label(&mut ctx.text, lblChainNext.clone())
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 72)
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X24, A64::X11)
    a64_ldr(&mut ctx.text, A64::X11, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    # chain end: advance to the next TABLE record
    a64_ldur(&mut ctx.text, A64::X11, A64::X19, 80)  # bucket_stride
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X24, A64::X11)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64 PARITY: the a64 body mirrored register-for-register. RBX = src
    # map, R12 = eq_fn, R13 = dst map, RBP = current record, [RSP] = end.
    x64_push(&mut ctx.text, X64::RBP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # source map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # eq_fn
    # destination map with the SAME layout (header fields → map_new args)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RBX, 24)  # key_stride
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 32)  # key_align
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 40)  # value_stride
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 48)  # value_align
    x64_call_label(&mut ctx.text, "_tg_map_new")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # destination map

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 80)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_push(&mut ctx.text, X64::RAX)  # [RSP] = end
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RBX, 0)  # current = buckets

    def_label(&mut ctx.text, lblBuckLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_cmp_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    def_label(&mut ctx.text, lblChain.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBP, 0)  # cached hash
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChainNext.clone())

    # dst.insert(bucket + key_off, bucket + value_off, cached_hash, eq_fn)
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)  # dst
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 56)  # key_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 8)  # record
    x64_add_rr(&mut ctx.text, X64::RSI, X64::RAX)  # key addr
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 64)  # value_off
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 8)  # record
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)  # value addr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RSP, 8)  # record
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RCX, 0)  # cached hash
    x64_mov_rr(&mut ctx.text, X64::R8, X64::R12)  # eq_fn
    x64_call_label(&mut ctx.text, "_tg_map_insert")
    x64_add_ri(&mut ctx.text, X64::RSP, 16)  # drop record

    def_label(&mut ctx.text, lblChainNext.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 72)  # next_off
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBP)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RCX, 0)  # next
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblChain.clone())
    # chain end: advance to the next TABLE record
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 80)  # bucket_stride
    x64_add_rr(&mut ctx.text, X64::RBP, X64::RAX)
    x64_jmp(&mut ctx.text, lblBuckLoop.clone())

    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)  # dst
    x64_add_ri(&mut ctx.text, X64::RSP, 8)  # drop the pushed end
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Map/Set Hash and Equality Helpers (the kernel key-type dispatch targets)
# ———————————————————————————————————————————————————————————————
#
# These implement the CORE Hash/Eq ABI the map surface declares
# (hash(key_ptr) -> Int, eq(a_ptr, b_ptr) -> Bool). Kernel key types
# (Int/String/StrView/...) dispatch here because their registered
# std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
# match the core ABI; user-defined `impl Hash for MyKey` / `impl Eq for
# MyKey` dispatch to the compiled MyKey__hash / MyKey__eq functions
# instead. The heuristic _tg_runtime_hash_ptr / _tg_key_equal functions
# are is not part of the model.

# djb2 hash over `size` bytes at `ptr`; the result is normalized to be
# NON-ZERO (the bucket's hash field uses 0 as the empty marker).
# Args: x0/rdi = ptr, x1/rsi = size. Returns: x0/rax = hash.
def emit_tg_hash_mem(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_mem")
  let lblLoop = fresh_label(ctx, ".Lhash_mem_loop")
  let lblDone = fresh_label(ctx, ".Lhash_mem_done")
  let lblRet = fresh_label(ctx, ".Lhash_mem_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)   # h
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X0)  # ptr
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X1)  # size
    a64_mov_ri(&mut ctx.text, A64::X12, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X13)
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RCX, 5381)   # h
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)  # ptr
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RSI)  # size
    x64_mov_ri(&mut ctx.text, X64::R8, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_sub_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# djb2 hash over the NUL-terminated bytes of a String KEY: the map key
# slot at [x0/rdi] holds the String OBJECT; [slot+0] is the object's data
# pointer (the String ABI — the runtime unwraps the object, never strlen
# on the header).
# Returns: x0/rax = hash.
def emit_tg_hash_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_str")
  let lblLoop = fresh_label(ctx, ".Lhash_str_loop")
  let lblDone = fresh_label(ctx, ".Lhash_str_done")
  let lblRet = fresh_label(ctx, ".Lhash_str_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X10, A64::X0, 0)   # String object
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # data ptr (header + 0)
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)
    a64_mov_ri(&mut ctx.text, A64::X12, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X13)
    a64_b(&mut ctx.text, lblLoop.clone())
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDI, 0)   # String object
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDX, 0)   # data ptr (header + 0)
    x64_mov_ri(&mut ctx.text, X64::RCX, 5381)
    x64_mov_ri(&mut ctx.text, X64::R8, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop.clone())
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# djb2 hash over the StrView at [x0/rdi]: { ptr @0, len @8 }.
# Returns: x0/rax = hash.
def emit_tg_hash_str_view(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_hash_str_view")
  let lblLoop = fresh_label(ctx, ".Lhash_view_loop")
  let lblDone = fresh_label(ctx, ".Lhash_view_done")
  let lblRet = fresh_label(ctx, ".Lhash_view_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X10, A64::X0, 0)  # ptr
    a64_ldr(&mut ctx.text, A64::X11, A64::X0, 8)  # len
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)
    a64_mov_ri(&mut ctx.text, A64::X12, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_mul_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X12)
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X13)
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 1)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDI, 0)  # ptr
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)  # len
    x64_mov_ri(&mut ctx.text, X64::RCX, 5381)
    x64_mov_ri(&mut ctx.text, X64::R8, 33)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_add_ri(&mut ctx.text, X64::RDX, 1)
    x64_imul_rr(&mut ctx.text, X64::RCX, X64::R8)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_sub_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 1)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# Byte equality: compare `size` bytes at a and b.
# Args: x0/rdi = a, x1/rsi = b, x2/rdx = size. Returns: 1 equal / 0 not.
def emit_tg_eq_mem(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_eq_mem")
  let lblLoop = fresh_label(ctx, ".Leq_mem_loop")
  let lblDone = fresh_label(ctx, ".Leq_mem_done")
  let lblRet = fresh_label(ctx, ".Leq_mem_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # a
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X1)  # b
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X2)  # size
    a64_mov_ri(&mut ctx.text, A64::X12, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X9, 0)
    a64_ldrb(&mut ctx.text, A64::X14, A64::X10, 0)
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X12)
    a64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RDI)  # a
    x64_mov_rr(&mut ctx.text, X64::R9, X64::RSI)  # b
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RDX)  # size
    x64_mov_ri(&mut ctx.text, X64::R11, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_test_rr(&mut ctx.text, X64::R10, X64::R10)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R8, 0)
    x64_movzx_r64_m8(&mut ctx.text, X64::RCX, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::R9, 1)
    x64_sub_ri(&mut ctx.text, X64::R10, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R11)
    x64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# String content equality: the key slots hold String OBJECT pointers at
# [a]/[b]; each object's data pointer is at [obj+0] (the String ABI — the
# runtime unwraps the objects before the byte comparison).
# Args: x0/rdi = a, x1/rsi = b. Returns: 1 equal / 0 not.
def emit_tg_eq_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_eq_str")
  let lblLoop = fresh_label(ctx, ".Leq_str_loop")
  let lblDone = fresh_label(ctx, ".Leq_str_done")
  let lblRet = fresh_label(ctx, ".Leq_str_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X9, A64::X0, 0)   # a object
    a64_ldr(&mut ctx.text, A64::X9, A64::X9, 0)   # a data
    a64_ldr(&mut ctx.text, A64::X10, A64::X1, 0)  # b object
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0) # b data
    a64_mov_ri(&mut ctx.text, A64::X12, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X9, 0)
    a64_ldrb(&mut ctx.text, A64::X14, A64::X10, 0)
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_b(&mut ctx.text, lblLoop.clone())
    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X12)
    a64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RDI, 0)   # a object
    x64_mov_rm(&mut ctx.text, X64::R8, X64::R8, 0)    # a data
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RSI, 0)   # b object
    x64_mov_rm(&mut ctx.text, X64::R9, X64::R9, 0)    # b data
    x64_mov_ri(&mut ctx.text, X64::R11, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R8, 0)
    x64_movzx_r64_m8(&mut ctx.text, X64::RCX, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::R9, 1)
    x64_jmp(&mut ctx.text, lblLoop.clone())
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R11)
    x64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# StrView equality: { ptr, len } at [a] and [b]; equal length and bytes.
# Args: x0/rdi = a, x1/rsi = b. Returns: 1 equal / 0 not.
def emit_tg_eq_str_view(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_eq_str_view")
  let lblLoop = fresh_label(ctx, ".Leq_view_loop")
  let lblDone = fresh_label(ctx, ".Leq_view_done")
  let lblRet = fresh_label(ctx, ".Leq_view_ret")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldr(&mut ctx.text, A64::X9, A64::X0, 0)   # a ptr
    a64_ldr(&mut ctx.text, A64::X11, A64::X0, 8)  # a len
    a64_ldr(&mut ctx.text, A64::X10, A64::X1, 0)  # b ptr
    a64_ldr(&mut ctx.text, A64::X12, A64::X1, 8)  # b len
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X13, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldrb(&mut ctx.text, A64::X14, A64::X9, 0)
    a64_ldrb(&mut ctx.text, A64::X15, A64::X10, 0)
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X15)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblRet.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_sub_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X13)
    a64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RDI, 0)   # a ptr
    x64_mov_rm(&mut ctx.text, X64::R10, X64::RDI, 8)  # a len
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RSI, 0)   # b ptr
    x64_mov_rm(&mut ctx.text, X64::R11, X64::RSI, 8)  # b len
    x64_cmp_rr(&mut ctx.text, X64::R10, X64::R11)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::R12, 1)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_test_rr(&mut ctx.text, X64::R10, X64::R10)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R8, 0)
    x64_movzx_r64_m8(&mut ctx.text, X64::RCX, X64::R9, 0)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::NE, lblRet.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::R9, 1)
    x64_sub_ri(&mut ctx.text, X64::R10, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_ret(&mut ctx.text)
    def_label(&mut ctx.text, lblRet.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Memory Runtime Implementation
# ———————————————————————————————————————————————————————————————

def emit_memory_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_mem_alloc(ctx)
  emit_tg_mem_free(ctx)
end

# _tg_mem_alloc: Allocate memory
# Args: x0/rdi = size
# Returns: ptr
def emit_tg_mem_alloc(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_mem_alloc")
  
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::Windows then
      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

      # Windows ARM64: Use VirtualAlloc
      # VirtualAlloc(NULL, size, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)
      # Emits a call to VirtualAlloc resolved by the linker at link time.
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)        # NULL (lpAddress)
      a64_mov_ri(&mut ctx.text, A64::X2, 0x3000)   # MEM_COMMIT|MEM_RESERVE
      a64_mov_ri(&mut ctx.text, A64::X3, 0x04)     # PAGE_READWRITE
      # Call VirtualAlloc via PLT (will be resolved by linker)
      a64_bl(&mut ctx.text, "VirtualAlloc")
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    when OsAbi::MacOS then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

      # Small allocations go through the bump arena; large ones keep mmap.
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
      a64_cmp_ri(&mut ctx.text, A64::X19, 0)
      a64_bcond(&mut ctx.text, a64_cc_ne(), size_ok_label.clone())
      a64_mov_ri(&mut ctx.text, A64::X19, 16)
      def_label(&mut ctx.text, size_ok_label)

      a64_mov_ri(&mut ctx.text, A64::X21, 23)
      a64_add_rrr(&mut ctx.text, A64::X20, A64::X19, A64::X21)
      a64_mov_ri(&mut ctx.text, A64::X21, -8)
      a64_and_rrr(&mut ctx.text, A64::X20, A64::X20, A64::X21)

      a64_mov_ri(&mut ctx.text, A64::X22, 65536)
      a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
      a64_bcond(&mut ctx.text, a64_cc_gt(), mmap_label.clone())

      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_bl(&mut ctx.text, "_tg_bump_alloc")
      a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X9, A64::X21)
      a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)
      def_label(&mut ctx.text, zero_loop_label)
      a64_cmp_ri(&mut ctx.text, A64::X10, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), zero_done_label.clone())
      a64_str(&mut ctx.text, A64::XZR, A64::X9, 0)
      a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 8)
      a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 8)
      a64_b(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X21, 16)
      a64_b(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 3)
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
      a64_mov_ri(&mut ctx.text, A64::X9, 1)
      a64_str(&mut ctx.text, A64::X9, A64::X0, 0)
      a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 16)

      def_label(&mut ctx.text, done_label)
      a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    when OsAbi::Linux then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
      a64_cmp_ri(&mut ctx.text, A64::X19, 0)
      a64_bcond(&mut ctx.text, a64_cc_ne(), size_ok_label.clone())
      a64_mov_ri(&mut ctx.text, A64::X19, 16)
      def_label(&mut ctx.text, size_ok_label)

      a64_mov_ri(&mut ctx.text, A64::X21, 23)
      a64_add_rrr(&mut ctx.text, A64::X20, A64::X19, A64::X21)
      a64_mov_ri(&mut ctx.text, A64::X21, -8)
      a64_and_rrr(&mut ctx.text, A64::X20, A64::X20, A64::X21)

      a64_mov_ri(&mut ctx.text, A64::X22, 65536)
      a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
      a64_bcond(&mut ctx.text, a64_cc_gt(), mmap_label.clone())

      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_bl(&mut ctx.text, "_tg_bump_alloc")
      a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X9, A64::X21)
      a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)
      def_label(&mut ctx.text, zero_loop_label)
      a64_cmp_ri(&mut ctx.text, A64::X10, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), zero_done_label.clone())
      a64_str(&mut ctx.text, A64::XZR, A64::X9, 0)
      a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 8)
      a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 8)
      a64_b(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X21, 16)
      a64_b(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 3)
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
      a64_mov_ri(&mut ctx.text, A64::X9, 1)
      a64_str(&mut ctx.text, A64::X9, A64::X0, 0)
      a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 16)

      def_label(&mut ctx.text, done_label)
      a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    end
    
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::Windows then
      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)

      # Windows x64: Use HeapAlloc from process heap
      # GetProcessHeap() returns the process heap handle
      # HeapAlloc(heap, 0, size) allocates memory
      # For simplicity, we use a static buffer or call malloc via CRT
      # The proper way is to call GetProcessHeap then HeapAlloc
      
      # Save size
      x64_push(&mut ctx.text, X64::RDI)
      
      # Call GetProcessHeap()
      x64_call_extern(&mut ctx.text, "GetProcessHeap")
      
      # HeapAlloc(heap, 0, size)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # heap
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)         # flags
      x64_pop(&mut ctx.text, X64::R8)                # size (was RDI)
      x64_call_extern(&mut ctx.text, "HeapAlloc")
      # Result in RAX
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    when OsAbi::MacOS then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)

      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::NE, size_ok_label.clone())
      x64_mov_ri(&mut ctx.text, X64::RBX, 16)
      def_label(&mut ctx.text, size_ok_label)

      x64_add_ri(&mut ctx.text, X64::RBX, 23)
      x64_mov_ri(&mut ctx.text, X64::RCX, -8)
      x64_and_rr(&mut ctx.text, X64::RBX, X64::RCX)

      x64_mov_ri(&mut ctx.text, X64::RCX, 65536)
      x64_cmp_rr(&mut ctx.text, X64::RBX, X64::RCX)
      x64_jcc(&mut ctx.text, CC::A, mmap_label.clone())

      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
      x64_call_label(&mut ctx.text, "_tg_bump_alloc")
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
      x64_xor_rr(&mut ctx.text, X64::RDX, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
      def_label(&mut ctx.text, zero_loop_label)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::E, zero_done_label.clone())
      x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RDX)
      x64_add_ri(&mut ctx.text, X64::RCX, 8)
      x64_sub_ri(&mut ctx.text, X64::RBX, 8)
      x64_jmp(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)
      x64_jmp(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)  # size
      x64_mov_ri(&mut ctx.text, X64::RDI, 0)
      x64_mov_ri(&mut ctx.text, X64::RDX, 3)
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
      x64_syscall(&mut ctx.text)
      x64_mov_ri(&mut ctx.text, X64::RCX, 1)
      x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)
      x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RBX)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)

      def_label(&mut ctx.text, done_label)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    when OsAbi::Linux then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)

      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::NE, size_ok_label.clone())
      x64_mov_ri(&mut ctx.text, X64::RBX, 16)
      def_label(&mut ctx.text, size_ok_label)

      x64_add_ri(&mut ctx.text, X64::RBX, 23)
      x64_mov_ri(&mut ctx.text, X64::RCX, -8)
      x64_and_rr(&mut ctx.text, X64::RBX, X64::RCX)

      x64_mov_ri(&mut ctx.text, X64::RCX, 65536)
      x64_cmp_rr(&mut ctx.text, X64::RBX, X64::RCX)
      x64_jcc(&mut ctx.text, CC::A, mmap_label.clone())

      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
      x64_call_label(&mut ctx.text, "_tg_bump_alloc")
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
      x64_xor_rr(&mut ctx.text, X64::RDX, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
      def_label(&mut ctx.text, zero_loop_label)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::E, zero_done_label.clone())
      x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RDX)
      x64_add_ri(&mut ctx.text, X64::RCX, 8)
      x64_sub_ri(&mut ctx.text, X64::RBX, 8)
      x64_jmp(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)
      x64_jmp(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)  # size
      x64_mov_ri(&mut ctx.text, X64::RDI, 0)
      x64_mov_ri(&mut ctx.text, X64::RDX, 3)
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
      x64_syscall(&mut ctx.text)
      x64_mov_ri(&mut ctx.text, X64::RCX, 1)
      x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)
      x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RBX)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)

      def_label(&mut ctx.text, done_label)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    end
  end
end

# _tg_mem_free: Free memory
# Args: x0/rdi = ptr, x1/rsi = size
def emit_tg_mem_free(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_mem_free")
  
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      a64_cmp_ri(&mut ctx.text, A64::X0, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), done_label.clone())
      a64_sub_rri(&mut ctx.text, A64::X9, A64::X0, 16)
      a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)
      a64_cmp_ri(&mut ctx.text, A64::X10, 1)
      a64_bcond(&mut ctx.text, a64_cc_ne(), done_label.clone())
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
      a64_ldr(&mut ctx.text, A64::X1, A64::X9, 8)
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
      def_label(&mut ctx.text, done_label)
    when OsAbi::Linux then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      a64_cmp_ri(&mut ctx.text, A64::X0, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), done_label.clone())
      a64_sub_rri(&mut ctx.text, A64::X9, A64::X0, 16)
      a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)
      a64_cmp_ri(&mut ctx.text, A64::X10, 1)
      a64_bcond(&mut ctx.text, a64_cc_ne(), done_label.clone())
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
      a64_ldr(&mut ctx.text, A64::X1, A64::X9, 8)
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
      def_label(&mut ctx.text, done_label)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
      x64_jcc(&mut ctx.text, CC::E, done_label.clone())
      x64_sub_ri(&mut ctx.text, X64::RDI, 16)
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
      x64_cmp_ri(&mut ctx.text, X64::RAX, 1)
      x64_jcc(&mut ctx.text, CC::NE, done_label.clone())
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
      x64_syscall(&mut ctx.text)
      def_label(&mut ctx.text, done_label)
    when OsAbi::Linux then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
      x64_jcc(&mut ctx.text, CC::E, done_label.clone())
      x64_sub_ri(&mut ctx.text, X64::RDI, 16)
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
      x64_cmp_ri(&mut ctx.text, X64::RAX, 1)
      x64_jcc(&mut ctx.text, CC::NE, done_label.clone())
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
      x64_syscall(&mut ctx.text)
      def_label(&mut ctx.text, done_label)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_ret(&mut ctx.text)
  end
end


# ———————————————————————————————————————————————————————————————
# String Conversion Runtime
# ———————————————————————————————————————————————————————————————

def emit_string_conv_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_cstring_new(ctx)
  emit_tg_string_bytes(ctx)
  emit_tg_string_from_bytes(ctx)
  emit_tg_int_to_str(ctx)
  emit_tg_float_to_str(ctx)
  emit_tg_str_to_int(ctx)
  emit_tg_str_to_float(ctx)
end

# _tg_int_to_str: Convert integer to string
# Args: x0/rdi = integer
# Returns: ptr to null-terminated string
def emit_tg_int_to_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_int_to_str")
  
  let lblLoop = fresh_label(ctx, ".Lint2str_loop")
  let lblDone = fresh_label(ctx, ".Lint2str_done")
  let lblNeg = fresh_label(ctx, ".Lint2str_neg")
  let lblPos = fresh_label(ctx, ".Lint2str_pos")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # value
    
    # Allocate buffer on stack (max 21 digits for int64 + sign)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 32)
    a64_mov_rr(&mut ctx.text, A64::X20, A64::SP)  # buffer
    
    # Handle negative
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblPos.clone())
    
    def_label(&mut ctx.text, lblNeg.clone())
    a64_neg(&mut ctx.text, A64::X19, A64::X19)
    a64_mov_ri(&mut ctx.text, A64::X21, 1)  # negative flag
    a64_b(&mut ctx.text, ".Lint2str_convert")
    
    def_label(&mut ctx.text, lblPos.clone())
    a64_mov_ri(&mut ctx.text, A64::X21, 0)
    
    def_label(&mut ctx.text, ".Lint2str_convert")
    a64_mov_ri(&mut ctx.text, A64::X22, 0)  # digit count
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 20)  # end of buffer
    
    def_label(&mut ctx.text, lblLoop.clone())
    # digit = value % 10
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_udiv(&mut ctx.text, A64::X11, A64::X19, A64::X10)  # quotient
    a64_msub(&mut ctx.text, A64::X12, A64::X11, A64::X10, A64::X19)  # remainder
    
    # *--ptr = '0' + digit
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 48)  # '0'
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X11)  # value = quotient
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())
    
    # Add negative sign if needed
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_mov_ri(&mut ctx.text, A64::X10, 45)  # '-'
    a64_strb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Allocate result string and copy
    a64_add_rri(&mut ctx.text, A64::X1, A64::X22, 1)  # len + 1
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    
    # Copy digits to result
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X0)  # result
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)  # src
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X22) # len
    
    let lblCopy = fresh_label(ctx, ".Lint2str_copy")
    let lblCopyDone = fresh_label(ctx, ".Lint2str_copy_done")
    
    a64_mov_ri(&mut ctx.text, A64::X13, 0)
    def_label(&mut ctx.text, lblCopy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
    a64_ldrb(&mut ctx.text, A64::X14, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X14, A64::X10, 0)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblCopy)
    
    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_strb(&mut ctx.text, A64::XZR, A64::X10, 0)  # null terminator
    
    a64_add_rri(&mut ctx.text, A64::SP, A64::SP, 32)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_sub_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # value
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSP)  # buffer
    
    # Handle sign
    x64_mov_ri(&mut ctx.text, X64::R13, 0)  # negative flag
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::GE, lblPos.clone())
    
    def_label(&mut ctx.text, lblNeg.clone())
    x64_neg_r(&mut ctx.text, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, ".Lint2str_convert")
    
    def_label(&mut ctx.text, lblPos.clone())
    
    def_label(&mut ctx.text, ".Lint2str_convert")
    x64_mov_ri(&mut ctx.text, X64::R14, 0)  # digit count
    x64_lea_mem(&mut ctx.text, X64::R15, X64::R12, 20)  # end of buffer
    
    def_label(&mut ctx.text, lblLoop.clone())
    # rax = value / 10, rdx = value % 10
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_cqo(&mut ctx.text)
    x64_idiv_r(&mut ctx.text, X64::RCX)
    
    # *--r15 = '0' + rdx
    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 48)
    # mov [r15], dl  (41 88 17 — REX.B for r15; 88 17 alone was mov [rdi], dl)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x17)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())
    
    # Add negative sign
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_mov_ri(&mut ctx.text, X64::RAX, 45)
    # mov [r15], al  (41 88 07 — REX.B for r15; 88 07 alone was mov [rdi], al)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Allocate and copy
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    # Copy result
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)  # rep movsb
    
    # Null terminate
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x00)
    
    x64_add_ri(&mut ctx.text, X64::RSP, 32)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_float_to_str: Convert f64 (IEEE 754 bits in x0/rdi) to string
# Strategy: reinterpret bits as double, extract sign/integer/fraction parts,
# convert integer part via _tg_int_to_str, then append "." + fraction digits.
# Handles: negative, zero, integer-only, up to 6 decimal digits.
def emit_tg_float_to_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_float_to_str")

  let lblNeg     = fresh_label(ctx, ".Lf2s_neg")
  let lblPos     = fresh_label(ctx, ".Lf2s_pos")
  let lblZero    = fresh_label(ctx, ".Lf2s_zero")
  let lblFrac    = fresh_label(ctx, ".Lf2s_frac")
  let lblFLoop   = fresh_label(ctx, ".Lf2s_floop")
  let lblFDone   = fresh_label(ctx, ".Lf2s_fdone")
  let lblCopy    = fresh_label(ctx, ".Lf2s_copy")
  let lblCopyD   = fresh_label(ctx, ".Lf2s_copyd")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = f64 bit pattern. Use FP regs for actual float math.
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 64)  # scratch buffer

    # Move bits to D0: fmov d0, x0  (opcode 0x9E670000 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, 0x9E670000 as u32)  # fmov d0, x0

    # Check sign: if x0 < 0 (MSB set) then negative
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # save bits
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblNeg.clone())
    a64_mov_ri(&mut ctx.text, A64::X20, 0)  # sign=0
    a64_b(&mut ctx.text, lblPos)

    def_label(&mut ctx.text, lblNeg.clone())
    a64_mov_ri(&mut ctx.text, A64::X20, 1)  # sign=1
    # fneg d0, d0  (opcode 0x1E614000)
    emit32_le(&mut ctx.text, 0x1E614000 as u32)

    def_label(&mut ctx.text, lblPos.clone())
    # fcvtzs x21, d0  — integer part  (opcode 0x9E780000 | Rd)
    emit32_le(&mut ctx.text, 0x9E780015 as u32)  # fcvtzs x21, d0

    # Convert integer part with _tg_int_to_str
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_int_to_str")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # int_str ptr (from mmap)

    # Build result: [sign] + int_str + "." + frac_digits
    # ptr in SP buffer
    a64_mov_rr(&mut ctx.text, A64::X9, A64::SP)  # dst
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # dst_len

    # If sign, prepend '-'
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lf2s_nosign")
    a64_mov_ri(&mut ctx.text, A64::X11, 45)  # '-'
    a64_strb(&mut ctx.text, A64::X11, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    def_label(&mut ctx.text, ".Lf2s_nosign")
    # Copy int_str digits
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X22)
    def_label(&mut ctx.text, lblCopy.clone())
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFrac.clone())
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblFrac.clone())
    # Append '.'
    a64_mov_ri(&mut ctx.text, A64::X12, 46)  # '.'
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    # Fraction: frac = abs(d0) - integer_part
    # scvtf d1, x21   (Rn=x21=21, Rd=d1=1 — verified 0x9E6202A1;
    # 0x9E6200A1 disassembles to scvtf d1, x5)
    emit32_le(&mut ctx.text, 0x9E6202A1 as u32)  # scvtf d1, x21
    # fsub d0, d0, d1  (opcode 0x1E613800 | Rm<<16 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, 0x1E613800 as u32)  # fsub d0, d0, d1

    # Generate 6 fraction digits
    a64_mov_ri(&mut ctx.text, A64::X13, 6)  # digit counter
    def_label(&mut ctx.text, lblFLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFDone.clone())

    # frac *= 10:  fmov d1, #10.0... too complex, use int mul
    # fcvtzs x14, d0 after *10 approach:
    # Load 10.0 into d1: mov x14, 0x4024000000000000 (10.0 bits); fmov d1, x14
    a64_mov_ri(&mut ctx.text, A64::X14, 0x4024000000000000 as i64)
    # fmov d1, x14  (opcode 0x9E670000 | Rn<<5 | Rd)  Rn=x14=14, Rd=d1=1
    emit32_le(&mut ctx.text, (0x9E6701C1) as u32)
    # fmul d0, d0, d1  (opcode 0x1E610800 | Rm<<16 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, (0x1E610800) as u32)

    # digit = fcvtzs x14, d0
    emit32_le(&mut ctx.text, 0x9E78000E as u32)  # fcvtzs x14, d0

    # Store '0' + digit
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 48)
    # Clamp to 0-9 range
    a64_and_ri(&mut ctx.text, A64::X14, 0xFF)
    a64_strb(&mut ctx.text, A64::X14, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    # frac -= digit: scvtf d1, x14-48; fsub d0, d0, d1
    a64_sub_rri(&mut ctx.text, A64::X14, A64::X14, 48)
    # scvtf d1, x14
    emit32_le(&mut ctx.text, (0x9E6201C1) as u32)
    # fsub d0, d0, d1
    emit32_le(&mut ctx.text, 0x1E613800 as u32)

    a64_sub_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # Null terminate
    a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

    # Allocate result via mmap and copy
    a64_add_rri(&mut ctx.text, A64::X1, A64::X10, 1)  # len+1
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    # Copy from SP buffer to result
    a64_mov_rr(&mut ctx.text, A64::X11, A64::SP)  # src
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X0)  # dst (mmap result)
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X10) # len
    a64_mov_ri(&mut ctx.text, A64::X14, 0)
    def_label(&mut ctx.text, lblCopyD.clone())
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lf2s_copydone")
    a64_ldrb(&mut ctx.text, A64::X15, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X15, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 1)
    a64_b(&mut ctx.text, lblCopyD)
    def_label(&mut ctx.text, ".Lf2s_copydone")
    a64_strb(&mut ctx.text, A64::XZR, A64::X12, 0)  # null term

    a64_add_rri(&mut ctx.text, A64::SP, A64::SP, 64)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64: full float-to-string with SSE2 fraction digit extraction
    let lbl_icopy = fresh_label(ctx, ".Lf2s_icopy")
    let lbl_icopyd = fresh_label(ctx, ".Lf2s_icopyd")
    let lbl_nosign = fresh_label(ctx, ".Lf2s_nosign")
    let lbl_floop = fresh_label(ctx, ".Lf2s_xfloop")
    let lbl_fdone = fresh_label(ctx, ".Lf2s_xfdone")
    let lbl_cpyd = fresh_label(ctx, ".Lf2s_xcpyd")
    let lbl_cpydone = fresh_label(ctx, ".Lf2s_xcpydone")

    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_sub_ri(&mut ctx.text, X64::RSP, 80)

    # movq xmm0, rdi  — load f64 bits into xmm0
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xC7)

    # Check sign bit (MSB of rdi)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # save original bits
    x64_mov_ri(&mut ctx.text, X64::R13, 0)          # sign=0
    x64_cmp_ri(&mut ctx.text, X64::R12, 0)
    x64_jcc(&mut ctx.text, CC::GE, lbl_nosign.clone())
    x64_mov_ri(&mut ctx.text, X64::R13, 1)          # sign=1
    # Negate: xorpd xmm0, [sign_mask] — use integer approach: clear sign bit
    # btc r12, 63 (clear sign bit), then movq xmm0, r12
    # Simpler: just abs(x) = x & 0x7FFFFFFFFFFFFFFF
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x7FFFFFFFFFFFFFFF as i64)
    x64_and_rr(&mut ctx.text, X64::R12, X64::RAX)
    # movq xmm0, r12  (66 49 0F 6E C4 — REX.W+B; 66 4C 0F 6E C4 was
    # movq xmm8, rsp, leaving the signed bits in xmm0)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x49)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xC4)  # movq xmm0, r12

    def_label(&mut ctx.text, lbl_nosign.clone())
    # Save xmm0 to stack [rbp-48] for later
    x64_movsd_store(&mut ctx.text, X64::RBP, -48, 0)  # [rbp-48] = xmm0

    # cvttsd2si rbx, xmm0 — integer part
    x64_cvttsd2si(&mut ctx.text, X64::RBX, 0)

    # Convert integer part with _tg_int_to_str
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_int_to_str")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # int_str ptr

    # Build result in stack buffer at RSP
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSP)  # dst ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)          # length counter in RCX

    # If sign, prepend '-'
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lbl_icopy.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 45)  # '-'
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)

    # Copy int_str digits
    def_label(&mut ctx.text, lbl_icopy.clone())
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    # Save RCX (length) in R14 temporarily
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)
    def_label(&mut ctx.text, lbl_icopyd.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [rsi]
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_floop.clone())  # done copying int digits
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_icopyd)

    # Append '.' and 6 fraction digits
    def_label(&mut ctx.text, lbl_floop.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 46)  # '.'
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)

    # Reload xmm0 from saved copy, subtract integer part
    x64_movsd_load(&mut ctx.text, 0, X64::RBP, -48)  # xmm0 = abs(original)
    # cvtsi2sd xmm1, rbx  — integer part as double
    x64_cvtsi2sd(&mut ctx.text, 1, X64::RBX)
    # xmm0 = xmm0 - xmm1  (fraction)
    x64_subsd(&mut ctx.text, 0, 1)

    # Generate 6 fraction digits: multiply by 10, extract digit, subtract
    x64_mov_ri(&mut ctx.text, X64::RCX, 6)  # digit counter
    # Load 10.0 into xmm2: mov rax, 0x4024000000000000; movq xmm2, rax
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x4024000000000000 as i64)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xD0)  # movq xmm2, rax

    let lbl_digit = fresh_label(ctx, ".Lf2s_xdigit")
    let lbl_digitd = fresh_label(ctx, ".Lf2s_xdigitd")
    def_label(&mut ctx.text, lbl_digit.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lbl_digitd.clone())

    # xmm0 *= 10.0
    x64_mulsd(&mut ctx.text, 0, 2)
    # digit = cvttsd2si rax, xmm0
    x64_cvttsd2si(&mut ctx.text, X64::RAX, 0)
    # Clamp digit to 0-9
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RAX)  # clear upper (it's already clean from cvt)
    # store '0' + digit
    x64_add_ri(&mut ctx.text, X64::RAX, 48)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    # xmm0 -= digit: sub 48 back, cvtsi2sd xmm1, rax; subsd xmm0, xmm1
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_cvtsi2sd(&mut ctx.text, 1, X64::RAX)
    x64_subsd(&mut ctx.text, 0, 1)

    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_digit)

    def_label(&mut ctx.text, lbl_digitd.clone())
    # Null terminate
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)

    # R14 = total length; allocate via mmap
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)  # +1 for null

    # mmap
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)

    # Copy from stack buffer to mmap result
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)  # dst (mmap result)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # save result ptr
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RSP)  # src
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)  # len
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xA4)  # movsb

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)  # return result ptr

    x64_add_ri(&mut ctx.text, X64::RSP, 80)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_str_to_int: Parse string to integer
def emit_tg_str_to_int(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_to_int")
  
  let lblLoop = fresh_label(ctx, ".Lstr2int_loop")
  let lblDone = fresh_label(ctx, ".Lstr2int_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)   # str ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)        # result
    a64_mov_ri(&mut ctx.text, A64::X11, 0)        # negative flag
    
    # Check for negative sign
    a64_ldrb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 45)  # '-'
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())
    a64_mov_ri(&mut ctx.text, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 48)  # '0'
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 57)  # '9'
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblDone.clone())
    
    # result = result * 10 + (digit - '0')
    a64_mov_ri(&mut ctx.text, A64::X13, 10)
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X13)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 48)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X12)
    
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lstr2int_ret")
    a64_neg(&mut ctx.text, A64::X10, A64::X10)
    
    def_label(&mut ctx.text, ".Lstr2int_ret")
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X10)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # str ptr
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)         # result
    x64_mov_ri(&mut ctx.text, X64::R8, 0)          # negative flag
    
    # Check for negative
    # movzx r9d, byte [rcx]  (44 0F B6 09 — REX.R; 0F B6 09 alone was
    # movzx ecx, byte [rcx], destroying the string pointer)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x09)
    x64_cmp_ri(&mut ctx.text, X64::R9, 45)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())
    x64_mov_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # movzx r9d, byte [rcx]  (44 0F B6 09 — REX.R)
    emit8(&mut ctx.text, 0x44)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x09)
    x64_cmp_ri(&mut ctx.text, X64::R9, 48)
    x64_jcc(&mut ctx.text, CC::L, lblDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::R9, 57)
    x64_jcc(&mut ctx.text, CC::G, lblDone.clone())
    
    # result = result * 10 + (digit - '0')
    x64_mov_ri(&mut ctx.text, X64::RDX, 10)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_sub_ri(&mut ctx.text, X64::R9, 48)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R9)
    
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::R8, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, ".Lstr2int_ret")
    x64_neg_r(&mut ctx.text, X64::RAX)
    
    def_label(&mut ctx.text, ".Lstr2int_ret")
    x64_ret(&mut ctx.text)
  end
end

# _tg_str_to_float: Parse string to f64 (IEEE 754 bits returned in x0/rax)
# Handles: optional sign, integer part, optional "." + fraction digits
def emit_tg_str_to_float(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_to_float")

  let lblILoop  = fresh_label(ctx, ".Ls2f_iloop")
  let lblIDone  = fresh_label(ctx, ".Ls2f_idone")
  let lblFLoop  = fresh_label(ctx, ".Ls2f_floop")
  let lblFDone  = fresh_label(ctx, ".Ls2f_fdone")
  let lblNoDot  = fresh_label(ctx, ".Ls2f_nodot")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # str ptr
    a64_mov_ri(&mut ctx.text, A64::X20, 0)         # negative flag

    # Check sign
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 45)  # '-'
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Ls2f_nosign")
    a64_mov_ri(&mut ctx.text, A64::X20, 1)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    def_label(&mut ctx.text, ".Ls2f_nosign")

    # Parse integer part into x21
    a64_mov_ri(&mut ctx.text, A64::X21, 0)
    def_label(&mut ctx.text, lblILoop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 48)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblIDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 57)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblIDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_mul_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X10)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 48)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    a64_b(&mut ctx.text, lblILoop)

    def_label(&mut ctx.text, lblIDone.clone())
    # Convert integer part to double: scvtf d0, x21
    emit32_le(&mut ctx.text, 0x9E6202A0 as u32)  # scvtf d0, x21

    # Check for '.'
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 46)  # '.'
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNoDot.clone())
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)

    # Parse fraction: accumulate digits, divide by power of 10
    a64_mov_ri(&mut ctx.text, A64::X21, 0)   # frac_int
    a64_mov_ri(&mut ctx.text, A64::X22, 1)   # divisor
    def_label(&mut ctx.text, lblFLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 48)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblFDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 57)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblFDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_mul_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X10)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 48)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)
    a64_mul_rrr(&mut ctx.text, A64::X22, A64::X22, A64::X10)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    a64_b(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # d1 = frac_int / divisor: scvtf d1, x21; scvtf d2, x22; fdiv d1, d1, d2
    emit32_le(&mut ctx.text, 0x9E6202A1 as u32)  # scvtf d1, x21
    emit32_le(&mut ctx.text, 0x9E6202C2 as u32)  # scvtf d2, x22
    # fdiv d1, d1, d2  (verified 0x1E621821 = fdiv d1, d1, d2;
    # 0x1E621820 disassembles to fdiv d0, d1, d2 and destroys the integer part)
    emit32_le(&mut ctx.text, 0x1E621821 as u32)
    # fadd d0, d0, d1  (0x1E612800)
    emit32_le(&mut ctx.text, 0x1E612800 as u32)

    def_label(&mut ctx.text, lblNoDot.clone())
    # Apply sign
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Ls2f_done")
    # fneg d0, d0
    emit32_le(&mut ctx.text, 0x1E614000 as u32)

    def_label(&mut ctx.text, ".Ls2f_done")
    # fmov x0, d0  (return bits)
    emit32_le(&mut ctx.text, 0x9E660000 as u32)  # fmov x0, d0

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64: parse integer + fraction using integer math, then use
    # cvtsi2sd to convert to double
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # str ptr
    x64_mov_ri(&mut ctx.text, X64::R12, 0)         # sign

    # Check sign
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 45)
    x64_jcc(&mut ctx.text, CC::NE, ".Ls2f_nosign")
    x64_mov_ri(&mut ctx.text, X64::R12, 1)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    def_label(&mut ctx.text, ".Ls2f_nosign")

    # Parse integer part into R13
    x64_mov_ri(&mut ctx.text, X64::R13, 0)
    def_label(&mut ctx.text, lblILoop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 48)
    x64_jcc(&mut ctx.text, CC::L, lblIDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 57)
    x64_jcc(&mut ctx.text, CC::G, lblIDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_imul_rr(&mut ctx.text, X64::R13, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_add_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_jmp(&mut ctx.text, lblILoop)

    def_label(&mut ctx.text, lblIDone.clone())
    # cvtsi2sd xmm0, r13  (F2 49 0F 2A C5 — REX.W+B; F2 4C 0F 2A C5 was
    # cvtsi2sd xmm8, rbp, leaving xmm0 = 0 and the integer part unused)
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x49)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x2A)
    emit8(&mut ctx.text, 0xC5)  # cvtsi2sd xmm0, r13

    # Check for '.'
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 46)
    x64_jcc(&mut ctx.text, CC::NE, lblNoDot.clone())
    x64_add_ri(&mut ctx.text, X64::RBX, 1)

    # For x86, just parse as integer and use simple division
    # Parse frac digits into R13, divisor into R14
    x64_mov_ri(&mut ctx.text, X64::R13, 0)
    x64_mov_ri(&mut ctx.text, X64::R14, 1)
    def_label(&mut ctx.text, lblFLoop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 48)
    x64_jcc(&mut ctx.text, CC::L, lblFDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 57)
    x64_jcc(&mut ctx.text, CC::G, lblFDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_imul_rr(&mut ctx.text, X64::R13, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_add_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_imul_rr(&mut ctx.text, X64::R14, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_jmp(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # Compute fraction: cvtsi2sd xmm1, r13; cvtsi2sd xmm2, r14; divsd xmm1, xmm2; addsd xmm0, xmm1
    # (raw encodings with REX.B — the x64_cvtsi2sd emitter omits REX.B for
    # high source registers, which would produce cvtsi2sd xmm1, rbp / xmm2, rsi)
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x49)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x2A)
    emit8(&mut ctx.text, 0xCD)  # cvtsi2sd xmm1, r13
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x49)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x2A)
    emit8(&mut ctx.text, 0xD6)  # cvtsi2sd xmm2, r14
    x64_divsd(&mut ctx.text, 1, 2)             # xmm1 = frac_int / divisor
    x64_addsd(&mut ctx.text, 0, 1)             # xmm0 += fraction

    def_label(&mut ctx.text, lblNoDot.clone())
    # Apply sign if needed: negate xmm0 by XOR with sign bit
    x64_test_rr(&mut ctx.text, X64::R12, X64::R12)
    x64_jcc(&mut ctx.text, CC::E, ".Ls2f_done")
    # Load sign mask (0x8000000000000000) into xmm3 via integer reg
    x64_mov_ri(&mut ctx.text, X64::RAX, -9223372036854775808 as i64)  # 0x8000000000000000
    # movq xmm3, rax
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xD8)  # movq xmm3, rax
    # xorpd xmm0, xmm3  (0x66 0x0F 0x57 0xC3)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x57)
    emit8(&mut ctx.text, 0xC3)

    def_label(&mut ctx.text, ".Ls2f_done")
    # movq rax, xmm0  (return f64 bits)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x7E)
    emit8(&mut ctx.text, 0xC0)  # movq rax, xmm0

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# String chars() runtime: convert null-terminated string to Vec[Char]
# ———————————————————————————————————————————————————————————————
#
# _tg_str_chars: Create a Vec[Char] (the standard 32-byte Vec header).
# ABI: x0 = &self (pointer to string pointer)
# Returns: pointer to Vec header {data:0, len:8, cap:16, stride:24}
#   stride = 4 (Char); the data buffer holds one 4-byte zero-extended char
#   per element (data + i*4), matching codegen's ProjIndex (Char stride 4,
#   W32 load).
#
# Vec layout at returned pointer:
#   [+0]: data_ptr (points to element array at returned_ptr + 32)
#   [+8]: length (number of chars)
#   [+16]: capacity (= length)
#   [+24]: stride (4 — Char element)
#   [+28]: (pad)
#   [+32]: element 0 (4 bytes, zero-extended byte)
#   [+36]: element 1
#  ...

def emit_str_chars_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_str_chars(ctx)
end

def emit_tg_str_chars(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_chars")

  match ctx.target.arch
  when Arch::AArch64 then
    emit_tg_str_chars_aarch64(ctx)
  when Arch::X86_64 then
    emit_tg_str_chars_x86_64(ctx)
  end
end

def emit_tg_str_chars_aarch64(ctx: &mut RuntimeEmitCtx) -> Unit
  let lbl_copy     = fresh_label(ctx, ".Lchars_copy")
  let lbl_copy_end = fresh_label(ctx, ".Lchars_copy_end")

  # Prologue: save callee-saved regs
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

  # Dereference &self to get the String OBJECT, then unwrap the object:
  # x19 = data pointer, x20 = len (the cached header length — no strlen).
  a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)   # x19 = String object
  a64_ldur(&mut ctx.text, A64::X19, A64::X19, 0) # x19 = data
  a64_ldr(&mut ctx.text, A64::X9, A64::X0, 0)
  a64_ldur(&mut ctx.text, A64::X20, A64::X9, 8)  # x20 = len

  # Allocate: 32 (header) + x20 * 4 (data) bytes
  a64_lsl(&mut ctx.text, A64::X0, A64::X20, 2)    # x0 = len * 4
  a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 32) # x0 += 32 (header size)
  a64_bl(&mut ctx.text, "_tg_mem_alloc")
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)     # x21 = allocated buffer

  # Store header
  a64_add_rri(&mut ctx.text, A64::X9, A64::X21, 32) # x9 = data_start = buf + 32
  a64_str(&mut ctx.text, A64::X9, A64::X21, 0)      # [buf+0] = data_ptr
  a64_str(&mut ctx.text, A64::X20, A64::X21, 8)     # [buf+8] = len
  a64_str(&mut ctx.text, A64::X20, A64::X21, 16)    # [buf+16] = cap = len
  a64_mov_ri(&mut ctx.text, A64::X15, 4)            # Char stride
  a64_str(&mut ctx.text, A64::X15, A64::X21, 24)    # [buf+24] = stride = 4

  # Copy loop: for i in 0..len, data[i*4] = string[i] (zero-extended W32)
  a64_mov_ri(&mut ctx.text, A64::X22, 0)            # x22 = i = 0
  def_label(&mut ctx.text, lbl_copy.clone())
  a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copy_end.clone())

  # Load byte: ldrb w10, [x19 + x22]
  a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
  a64_ldrb(&mut ctx.text, A64::X10, A64::X10, 0)   # x10 = string[i] (zero-ext)

  # Store as 4-byte word: str w10, [x9 + i*4]  (x9 = data_start)
  a64_mul_rrr(&mut ctx.text, A64::X11, A64::X22, A64::X15)  # i * stride
  a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X11)   # data + i*stride
  a64_str_w(&mut ctx.text, A64::X10, A64::X11, 0)

  a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1) # i++
  a64_b(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return buffer pointer
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

     # Epilogue — restore exactly the 3 pairs pushed in the prologue
     # (FP/LR, X19/X20, X21/X22); popping X23-X28 here unbalanced the stack
     # and returned through a garbage LR.
     a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
     a64_ret(&mut ctx.text)
end

def emit_tg_str_chars_x86_64(ctx: &mut RuntimeEmitCtx) -> Unit
  let lbl_copy     = fresh_label(ctx, ".Lchars_copy")
  let lbl_copy_end = fresh_label(ctx, ".Lchars_copy_end")

  # Prologue
  x64_push(&mut ctx.text, X64::RBP)
  x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)

  # Dereference &self → String object, then unwrap: rbx = data, r12 = len
  x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)  # rbx = String object
  x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 8)  # r12 = len
  x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)  # rbx = data

  # Allocate: 32 (header) + r12*4 (data, Char stride)
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
  x64_shl_ri(&mut ctx.text, X64::RDI, 2)
  x64_add_ri(&mut ctx.text, X64::RDI, 32)
  x64_call_label(&mut ctx.text, "_tg_mem_alloc")
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # r13 = buffer

  # Store header
  # [r13+0] = data_start = r13 + 32
  x64_lea_mem(&mut ctx.text, X64::RCX, X64::R13, 32)
  x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RCX)
  # [r13+8] = len
  x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)
  # [r13+16] = cap
  x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)
  # [r13+24] = stride = 4 (Char)
  x64_mov_ri(&mut ctx.text, X64::RCX, 4)
  x64_mov_mr(&mut ctx.text, X64::R13, 24, X64::RCX)

  # Copy loop
  x64_mov_ri(&mut ctx.text, X64::R14, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
  x64_jcc(&mut ctx.text, CC::GE, lbl_copy_end.clone())

  # movzx eax, byte [rbx + r14]
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x33)  # SIB: r14 + rbx

  # Store: [r13 + 32 + r14*4] = eax (W32)
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  x64_shl_ri(&mut ctx.text, X64::RCX, 2)
  x64_add_rr(&mut ctx.text, X64::RCX, X64::R13)
  x64_mov_m32_r32(&mut ctx.text, X64::RCX, 32, X64::RAX)

  x64_add_ri(&mut ctx.text, X64::R14, 1)
  x64_jmp(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_pop(&mut ctx.text, X64::RBP)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# POSIX / libc Runtime
# ———————————————————————————————————————————————————————————————
#
# These implement POSIX functions as raw syscalls so the statically-linked
# binary doesn't need dynamic library resolution.  Each function follows the
# standard C ABI for the target and issues the correct syscall for
# macOS, Linux, and Windows.
#
# macOS AArch64:  syscall number in X16, svc #0x80
# Linux AArch64:  syscall number in X8,  svc #0
# macOS x86-64:   RAX = 0x2000000 + nr, syscall
# Linux x86-64:   RAX = nr,             syscall
# Windows:        call kernel32 APIs via extern (resolved by PE linker)
#
# Syscall numbers (macOS / Linux):
#   exit    = 1 / 60
#   fork    = 2 / 57
#   read    = 3 / 0
#   write   = 4 / 1
#   open    = 5 / 2
#   close   = 6 / 3
#   wait4   = 7 / 61  (waitpid = wait4 + flags)
#   chdir   = 12 / 80
#   pipe    = 42 / 22
#   dup2    = 90 / 33
#   execve  = 59 / 59
# ———————————————————————————————————————————————————————————————

def emit_posix_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_posix_exit(ctx)
  emit_posix_fork(ctx)
  emit_posix_read(ctx)
  emit_posix_write(ctx)
  emit_posix_read_alias(ctx)
  emit_posix_write_alias(ctx)
  emit_posix_strdup(ctx)
  emit_posix_clock_gettime(ctx)
  emit_sync_fetch_and_add_runtime(ctx)
  emit_posix_open(ctx)
  emit_posix_close(ctx)
  emit_posix_close_alias(ctx)
  emit_tg_read_file_to_string(ctx)
  emit_tg_read_vec_u8(ctx)
  emit_tg_write_vec_u8(ctx)
  emit_posix_waitpid(ctx)
  emit_posix_wait(ctx)
  emit_posix_chdir(ctx)
  emit_posix_pipe(ctx)
  emit_posix_dup2(ctx)
  emit_posix_execve(ctx)
  emit_posix_execvp(ctx)
  emit_posix_getenv(ctx)
  emit_posix_create_directory_w(ctx)
end

def emit_posix_read_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_read")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_read")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_read")
  end
end

def emit_posix_write_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_write")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_write")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_write")
  end
end

def emit_posix_close_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_close")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_close")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_close")
  end
end

# Helper: emit a simple syscall that passes through args as-is.
# For AArch64: args already in X0-X5, syscall nr in X16 (macOS) or X8 (Linux).
# For x86-64: args in RDI,RSI,RDX,R10,R8,R9; syscall nr in RAX.

# _exit(status: Int) -> !
def emit_posix_exit(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_exit")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 1)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 93)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "ExitProcess")
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000001)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 60)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: ExitProcess(uExitCode) — RCX = exit code
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "ExitProcess")
    end
  end
  # No ret — _exit never returns
end

# fork() -> Int (pid)
def emit_posix_fork(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "fork")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 2)
      a64_svc(&mut ctx.text, 0x80)
      a64_ret(&mut ctx.text)
    when OsAbi::Linux then
      # Linux AArch64: clone with flags=SIGCHLD (fork equivalent)
      a64_mov_ri(&mut ctx.text, A64::X0, 17)  # SIGCHLD
      a64_mov_ri(&mut ctx.text, A64::X1, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 220)  # clone
      a64_svc(&mut ctx.text, 0)
      a64_ret(&mut ctx.text)
    when OsAbi::Windows then
      # Contract: Windows has no fork(2); -1 is the POSIX fork-failure
      # convention — an explicit unsupported-feature signal, not a default.
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
      a64_ret(&mut ctx.text)
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000002)
      x64_syscall(&mut ctx.text)
      x64_ret(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 57)
      x64_syscall(&mut ctx.text)
      x64_ret(&mut ctx.text)
    when OsAbi::Windows then
      # Contract: Windows has no fork(2); -1 is the POSIX fork-failure
      # convention — an explicit unsupported-feature signal, not a default.
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
      x64_ret(&mut ctx.text)
    end
  end
end

# _tg_posix_read(fd: Int, buf: &u8, count: UInt) -> Int
def emit_posix_read(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_read")
  let ok_label = fresh_label(ctx, ".Lposix_read_ok")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 3)
      a64_svc(&mut ctx.text, 0x80)
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 63)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # fail closed: the Windows AArch64 ReadFile path is not implemented —
      # a zero byte-count would be a fabricated success, so trap instead.
      a64_brk(&mut ctx.text, 1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000003)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: ReadFile via kernel32
      x64_sub_ri(&mut ctx.text, X64::RSP, 48)
      # hFile=RCX(=RDI), lpBuffer=RDX(=RSI), nBytes=R8(=RDX), lpBytesRead on stack, lpOverlapped=NULL
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::R8, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_lea_mem(&mut ctx.text, X64::R9, X64::RSP, 40)  # &bytesRead
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_mov_mr(&mut ctx.text, X64::RSP, 32, X64::RAX)  # lpOverlapped = NULL
      x64_call_extern(&mut ctx.text, "ReadFile")
      # bytesRead is at [RSP+40]
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 40)
      x64_add_ri(&mut ctx.text, X64::RSP, 48)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_posix_write(fd: Int, buf: &u8, count: UInt) -> Int
def emit_posix_write(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_write")
  let ok_label = fresh_label(ctx, ".Lposix_write_ok")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 4)
      a64_svc(&mut ctx.text, 0x80)
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 64)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # fail closed: the Windows AArch64 WriteFile path is not implemented —
      # a zero byte-count would be a fabricated success, so trap instead.
      a64_brk(&mut ctx.text, 1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000004)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 1)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: WriteFile via kernel32
      x64_sub_ri(&mut ctx.text, X64::RSP, 48)
      # hFile=RCX(=RDI), lpBuffer=RDX(=RSI), nBytes=R8(=RDX), lpBytesWritten on stack, lpOverlapped=NULL
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::R8, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_lea_mem(&mut ctx.text, X64::R9, X64::RSP, 40)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_mov_mr(&mut ctx.text, X64::RSP, 32, X64::RAX)
      x64_call_extern(&mut ctx.text, "WriteFile")
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 40)
      x64_add_ri(&mut ctx.text, X64::RSP, 48)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_read_vec_u8(fd: Int, vec: &mut Vec[u8], count: UInt) -> Int
# Reads packed bytes into a temporary buffer, then scatters them into the
# Vec's element slots (element address = data + i*stride, width = stride —
# stride 1 for a Vec[u8]) and updates vec.len to the byte count read.
def emit_tg_read_vec_u8(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_read_vec_u8")

  let lblReturn = fresh_label(ctx, ".Lread_vec_ret")
  let lblHaveCap = fresh_label(ctx, ".Lread_vec_have_cap")
  let lblCopy = fresh_label(ctx, ".Lread_vec_copy")
  let lblCopyDone = fresh_label(ctx, ".Lread_vec_copy_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # fd
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # &vec slot
    a64_ldur(&mut ctx.text, A64::X20, A64::X20, 0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # count

    # X23 holds the return value on every exit path — initialize it before
    # the count==0 early return so that path returns 0, not the caller's X23.
    a64_mov_ri(&mut ctx.text, A64::X23, 0)

    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_stur(&mut ctx.text, A64::X0, A64::X20, 8)  # vec.len = 0

    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblReturn.clone())

    a64_ldur(&mut ctx.text, A64::X22, A64::X20, 16)  # cap
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblHaveCap.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    a64_bl(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblHaveCap.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # temp buffer

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_bl(&mut ctx.text, "_tg_posix_read")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # result

    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblReturn.clone())

    a64_ldur(&mut ctx.text, A64::X24, A64::X20, 0)  # data ptr
    a64_ldur(&mut ctx.text, A64::X15, A64::X20, 24) # stride (header authority)
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # i

    def_label(&mut ctx.text, lblCopy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())

    # vec slot i = byte: address = data + i*stride, store width = stride
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X9)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_mul_rrr(&mut ctx.text, A64::X12, A64::X9, A64::X15)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X24, A64::X12)
    emit_a64_store_width(ctx, A64::X12, A64::X11, A64::X15)

    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_stur(&mut ctx.text, A64::X23, A64::X20, 8)

    def_label(&mut ctx.text, lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    x64_sub_ri(&mut ctx.text, X64::RSP, 8)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # fd
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # &vec slot
    x64_mov_rm(&mut ctx.text, X64::R12, X64::R12, 0)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # count

    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R12, 8, X64::RAX)  # vec.len = 0

    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::E, lblReturn.clone())

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R12, 16)  # cap
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblHaveCap.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblHaveCap.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # temp

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_posix_read")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # result

    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::LE, lblReturn.clone())

    x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)  # remaining

    def_label(&mut ctx.text, lblCopy.clone())
    x64_cmp_ri(&mut ctx.text, X64::R15, 0)
    x64_jcc(&mut ctx.text, CC::E, lblCopyDone.clone())

    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    emit8(&mut ctx.text, 0xAC)  # LODSB
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RSI)
    x64_movzx_r64_r8(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_jmp(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblCopyDone.clone())
    def_label(&mut ctx.text, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RSP, 8)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_write_vec_u8(fd: Int, vec: &Vec[u8], count: UInt) -> Int
# Gathers Vec element value words (width = stride from the header — 1 byte
# per element for Vec[u8]) into a packed temporary byte buffer before
# issuing the underlying byte-oriented write syscall.
def emit_tg_write_vec_u8(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_write_vec_u8")

  let lblCountOk = fresh_label(ctx, ".Lwrite_vec_count_ok")
  let lblReturn = fresh_label(ctx, ".Lwrite_vec_ret")
  let lblGather = fresh_label(ctx, ".Lwrite_vec_gather")
  let lblGatherDone = fresh_label(ctx, ".Lwrite_vec_gather_done")
  let lblWriteLoop = fresh_label(ctx, ".Lwrite_vec_write_loop")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # fd
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # &vec slot
    a64_ldur(&mut ctx.text, A64::X20, A64::X20, 0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # count

    a64_ldur(&mut ctx.text, A64::X22, A64::X20, 8)  # len
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblCountOk.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X22)

    def_label(&mut ctx.text, lblCountOk.clone())
    a64_mov_ri(&mut ctx.text, A64::X23, 0)  # total written = 0
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblReturn.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # temp buffer
    a64_ldur(&mut ctx.text, A64::X24, A64::X20, 0)  # data ptr
    a64_ldur(&mut ctx.text, A64::X15, A64::X20, 24) # stride (header authority)
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # i

    def_label(&mut ctx.text, lblGather.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblGatherDone.clone())

    # word value = [data + i*stride] with width = stride; emit its low byte
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X9, A64::X15)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X24, A64::X10)
    emit_a64_load_width(ctx, A64::X11, A64::X10, A64::X15)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X9)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)

    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblGather)

    def_label(&mut ctx.text, lblGatherDone.clone())
    # write-all loop: loop issuing _tg_posix_write until all bytes are flushed
    # (a single write syscall may do a partial write), stopping on error.
    def_label(&mut ctx.text, lblWriteLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)       # fd
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X23)  # buf + written
    a64_sub_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X23)  # remaining
    a64_bl(&mut ctx.text, "_tg_posix_write")
    # EINTR (-4) is not progress and not an error: retry the write.
    a64_cmp_ri(&mut ctx.text, A64::X0, -4)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblWriteLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblReturn.clone())  # <= 0: error/no progress, stop
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X0)   # written += result
    a64_b(&mut ctx.text, lblWriteLoop.clone())

    def_label(&mut ctx.text, lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    x64_sub_ri(&mut ctx.text, X64::RSP, 8)

    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # fd
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RSI)  # &vec slot
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # count

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)  # len
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_jcc(&mut ctx.text, CC::LE, lblCountOk.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

    def_label(&mut ctx.text, lblCountOk.clone())
    x64_mov_ri(&mut ctx.text, X64::R15, 0)  # total written = 0
    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::E, lblReturn.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # temp current ptr
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RBX, 24)  # stride (header authority)
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)  # data ptr
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)  # remaining

    def_label(&mut ctx.text, lblGather.clone())
    x64_cmp_ri(&mut ctx.text, X64::R14, 0)
    x64_jcc(&mut ctx.text, CC::E, lblGatherDone.clone())

    emit_x64_load_width(ctx, X64::RAX, X64::RBX, X64::R8)  # value word
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    emit8(&mut ctx.text, 0xAA)  # STOSB
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RDI)
    x64_add_rr(&mut ctx.text, X64::RBX, X64::R8)  # data += stride
    x64_sub_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblGather)

    def_label(&mut ctx.text, lblGatherDone.clone())
    # R14 = temp buffer start = end cursor (R15) - count (R13)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_sub_rr(&mut ctx.text, X64::R14, X64::R13)
    # write-all loop: written in R15, temp start in R14, count in R13
    x64_mov_ri(&mut ctx.text, X64::R15, 0)
    def_label(&mut ctx.text, lblWriteLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)   # fd
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::R15)   # buf + written
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_sub_rr(&mut ctx.text, X64::RDX, X64::R15)   # remaining
    x64_call_label(&mut ctx.text, "_tg_posix_write")
    # EINTR (-4) is not progress and not an error: retry the write.
    x64_cmp_ri(&mut ctx.text, X64::RAX, -4)
    x64_jcc(&mut ctx.text, CC::E, lblWriteLoop.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::LE, lblReturn.clone())  # <= 0: error/no progress, stop
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)   # written += result
    x64_jmp(&mut ctx.text, lblWriteLoop.clone())

    def_label(&mut ctx.text, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_ri(&mut ctx.text, X64::RSP, 8)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# libc_open(path: &u8, flags: Int, mode: Int) -> Int (fd)
# Windows: CreateFileA open path not implemented — returns -1 (the POSIX
# open-failure convention), an explicit unsupported-feature signal.
def emit_posix_open(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_open")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 5)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      # Linux AArch64 uses openat (SYS_openat=56) with AT_FDCWD=-100
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)  # mode -> x3
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)  # flags -> x2
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # path -> x1
      a64_mov_ri(&mut ctx.text, A64::X0, -100)     # AT_FDCWD
      a64_mov_ri(&mut ctx.text, A64::X8, 56)       # openat
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # Contract: CreateFileA open path not implemented; -1 (open-failure
      # convention) is the explicit unsupported-feature signal.
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000005)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 2)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Contract: CreateFileA open path not implemented; -1 (open-failure
      # convention) is the explicit unsupported-feature signal.
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_posix_close(fd: Int) -> Int
def emit_posix_close(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_close")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 6)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 57)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # CloseHandle
      a64_bl(&mut ctx.text, "CloseHandle")
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000006)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 3)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "CloseHandle")
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_read_file_to_string(path: *u8) -> *u8
# Opens file at path, reads entire contents into a bump-allocated NUL-terminated
# buffer, closes the file, and returns the buffer pointer (which IS a Tangerine
# String). Documented error contract: returns a valid empty string ("" — a
# bump-allocated NUL byte) on any error; the read path itself is fully
# implemented.
def emit_tg_read_file_to_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_read_file_to_string")

  let lblFail = fresh_label(ctx, ".Lrfts_fail")
  let lblDone = fresh_label(ctx, ".Lrfts_done")
  let lblOpenOk = fresh_label(ctx, ".Lrfts_open_ok")
  let lblReadLoop = fresh_label(ctx, ".Lrfts_read_loop")
  let lblReadDone = fresh_label(ctx, ".Lrfts_read_done")
  let lblReadFail = fresh_label(ctx, ".Lrfts_read_fail")
  let lblCopyLoop = fresh_label(ctx, ".Lrfts_copy_loop")
  let lblCopyDone = fresh_label(ctx, ".Lrfts_copy_done")
  let lblReturnBuffer = fresh_label(ctx, ".Lrfts_return_buf")
  let lblReturnEmpty = fresh_label(ctx, ".Lrfts_return_empty")
  let lblSeekOk = fresh_label(ctx, ".Lrfts_seek_ok")
  let lblSizeOk = fresh_label(ctx, ".Lrfts_size_ok")

  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue: save FP/LR and callee-saved X19-X22
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    # X0 = path String object (the String ABI) → unwrap to the data pointer
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # open(path, O_RDONLY=0, mode=0)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)   # O_RDONLY
    a64_mov_ri(&mut ctx.text, A64::X2, 0)   # mode
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 5)  # SYS_open
      a64_svc(&mut ctx.text, 0x80)
      # Normalize Darwin errors to negative errno like the std/fs syscall path.
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)  # mode → x3
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)  # flags → x2
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # path → x1
      a64_mov_ri(&mut ctx.text, A64::X0, -100)     # AT_FDCWD
      a64_mov_ri(&mut ctx.text, A64::X8, 56)       # openat
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    # Check if open failed (Linux: negative result, Windows: -1)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblReturnEmpty.clone())

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # X19 = fd
    a64_mov_ri(&mut ctx.text, A64::X21, 0)        # X21 = len
    a64_mov_ri(&mut ctx.text, A64::X22, 4096)     # X22 = cap

    # Allocate an initial buffer and grow it on demand while reading to EOF.
    # This avoids depending on lseek, which has been mis-sizing files under
    # native macOS stage1 and truncating compiler source reads. ALLOCATION
 # CONTRACT (— real lifetime): the read buffer becomes the OWNED
    # String's data via _tg_string_wrap, so it comes from the real heap
    # allocator (the _tg_mem_alloc/_tg_mem_free pair — the String drop
    # releases it).
    a64_add_rri(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # X20 = buf_ptr

    def_label(&mut ctx.text, lblReadLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblCopyDone.clone())

    # Buffer is full — grow to 2x capacity.
    # Compute new_cap = old_cap * 2, alloc new_cap + 1.
    # NOTE: X9 is caller-saved and clobbered by the alloc, so we
    # recompute the new capacity from X22 (callee-saved) after the call.
    a64_lsl(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    # Recompute new_cap from X22 (preserved across call)
    a64_lsl(&mut ctx.text, A64::X9, A64::X22, 1)
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X20)  # save OLD buf (grow-path free)
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)  # old buf
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X0)   # new buf
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X21)  # bytes to copy

    def_label(&mut ctx.text, lblCopyLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_strb(&mut ctx.text, A64::X13, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lblCopyLoop)

    # Grow-path only: release the OLD buffer (X23) — the real-heap
    # deallocation at the growth boundary.
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_mem_free")

    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblReadDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X9)

    def_label(&mut ctx.text, lblReadDone.clone())
    a64_sub_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X21)  # remaining cap
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X21)  # write cursor
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)              # fd
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)              # buf
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X10)              # count
    a64_bl(&mut ctx.text, "_tg_posix_read")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblReadFail.clone())
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())

    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X0)
    a64_b(&mut ctx.text, lblReadLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X20, A64::X21)
    a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

    # close(fd)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_posix_close")

    # Return buf_ptr
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_b(&mut ctx.text, lblReturnBuffer.clone())

    def_label(&mut ctx.text, lblReadFail.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_posix_close")
    a64_b(&mut ctx.text, lblReturnEmpty.clone())

    def_label(&mut ctx.text, lblReturnEmpty.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
    a64_strb(&mut ctx.text, A64::XZR, A64::X0, 0)

    def_label(&mut ctx.text, lblReturnBuffer.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    # The String ABI: the read buffer becomes an OWNED String object
    a64_bl(&mut ctx.text, "_tg_string_wrap")

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Prologue: save callee-saved registers
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    # RDI = path String object (the String ABI) → unwrap to the data pointer
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RDI, 0)
    # open(path, O_RDONLY=0, mode=0)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)   # O_RDONLY
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)   # mode
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000005)  # SYS_open
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblOpenOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblOpenOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 2)  # SYS_open
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    # Linux/Windows: check for negative return
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # RBX = fd

    # lseek(fd, 0, SEEK_END=2)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 2)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C7)  # SYS_lseek = 199
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblSizeOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblSizeOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 8)  # SYS_lseek
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    end
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # R12 = file_size

    # lseek(fd, 0, SEEK_SET=0)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C7)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblSeekOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblSeekOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 8)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then ()
    end
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())

    # Allocate (file_size + 8) — extra 7 bytes for safe qword NUL write.
 # ALLOCATION CONTRACT (— real lifetime): the read buffer becomes the
    # OWNED String's data via _tg_string_wrap, so it comes from the real
    # heap allocator (the _tg_mem_alloc/_tg_mem_free pair).
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # R13 = buf_ptr

    # read(fd, buf, file_size)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # fd
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)   # buf
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)   # count
    x64_call_label(&mut ctx.text, "_tg_posix_read")

    # NUL-terminate: buf[file_size] = 0 (writes 8 zero bytes, safe due to +8 alloc)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_add_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R14, 0, X64::RAX)

    # close(fd)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_posix_close")

    # Return buf_ptr
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jmp(&mut ctx.text, lblDone.clone())

    # Error path
    def_label(&mut ctx.text, lblFail.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_mem_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)

    def_label(&mut ctx.text, lblDone.clone())
    # The String ABI: the read buffer becomes an OWNED String object
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_wrap")
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# waitpid(pid: Int, status: &Int, options: Int) -> Int
# macOS: wait4(pid, status, options, rusage=NULL)
def emit_posix_waitpid(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "waitpid")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(pid, status, options, rusage=NULL)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)  # rusage = NULL
      a64_mov_ri(&mut ctx.text, A64::X16, 7)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 260)  # wait4
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # fail closed: Windows waitpid is not implemented — a zero pid/status
      # would be a fabricated success, so trap instead.
      a64_brk(&mut ctx.text, 1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0)   # rusage = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000007)  # wait4
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0)  # rusage = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 61)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # fail closed: Windows waitpid is not implemented — a zero pid/status
      # would be a fabricated success, so trap instead.
      x64_ud2(&mut ctx.text)
    end
    x64_ret(&mut ctx.text)
  end
end

# wait(status: &Int) -> Int
# Equivalent to waitpid(-1, status, 0)
# Windows: not implemented — returns -1 (POSIX wait-failure convention), an
# explicit unsupported-feature signal.
def emit_posix_wait(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "wait")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(-1, status, 0, NULL)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # status
      a64_mov_ri(&mut ctx.text, A64::X0, -1)       # pid = -1 (any child)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)        # options = 0
      a64_mov_ri(&mut ctx.text, A64::X3, 0)        # rusage = NULL
      a64_mov_ri(&mut ctx.text, A64::X16, 7)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 260)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(-1, status, 0, NULL)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)  # status
      x64_mov_ri(&mut ctx.text, X64::RDI, -1)
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::R10, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000007)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)
      x64_mov_ri(&mut ctx.text, X64::RDI, -1)
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::R10, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 61)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# chdir(path: &u8) -> Int
def emit_posix_chdir(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "chdir")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 12)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 49)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "SetCurrentDirectoryA")
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200000C)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 80)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "SetCurrentDirectoryA")
    end
    x64_ret(&mut ctx.text)
  end
end

# pipe(fds: &Int) -> Int
# fds points to [2]Int where fds[0]=read end, fds[1]=write end
# Windows: CreatePipe path not implemented — returns -1 (the POSIX
# pipe-failure convention), an explicit unsupported-feature signal.
def emit_posix_pipe(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "pipe")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 42)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 59)  # pipe2 with flags=0
      a64_mov_ri(&mut ctx.text, A64::X1, 0)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # Contract: CreatePipe path not implemented; -1 (pipe-failure
      # convention) is the explicit unsupported-feature signal.
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200002A)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 22)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# dup2(oldfd: Int, newfd: Int) -> Int
# Windows: not implemented — returns -1 (POSIX dup2-failure convention), an
# explicit unsupported-feature signal.
def emit_posix_dup2(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "dup2")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 90)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      # Linux AArch64: dup3(oldfd, newfd, flags=0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 24)  # dup3
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200005A)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 33)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# execve(path: &u8, argv: &&u8, envp: &&u8) -> Int
# Windows: not implemented — returns -1 (POSIX execve-failure convention), an
# explicit unsupported-feature signal.
def emit_posix_execve(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "execve")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 59)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 221)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200003B)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 59)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# execvp(file: &u8, argv: &&u8) -> Int
# Documented contract: execvp is implemented as execve with the path passed
# as-is (no PATH directory search). Windows: not implemented — returns -1
# (POSIX exec-failure convention), an explicit unsupported-feature signal.
def emit_posix_execvp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "execvp")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # execve(file, argv, environ=0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 59)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 221)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)  # envp = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200003B)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 59)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# strdup(src: &u8) -> String
# Allocate a fresh null-terminated copy of the input C string.
def emit_posix_strdup(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "strdup")
  let lbl_len = fresh_label(ctx, ".Lposix_strdup_len")
  let lbl_len_done = fresh_label(ctx, ".Lposix_strdup_len_done")
  let lbl_copy = fresh_label(ctx, ".Lposix_strdup_copy")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # src ptr
    a64_mov_ri(&mut ctx.text, A64::X20, 0)        # len

    def_label(&mut ctx.text, lbl_len.clone())
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X20)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_done.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
    a64_b(&mut ctx.text, lbl_len.clone())

    def_label(&mut ctx.text, lbl_len_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # dst ptr
    a64_mov_ri(&mut ctx.text, A64::X22, 0)        # index

    def_label(&mut ctx.text, lbl_copy.clone())
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X21, A64::X22)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_copy.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # src ptr
    x64_mov_ri(&mut ctx.text, X64::R12, 0)         # len
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)  # scan ptr

    def_label(&mut ctx.text, lbl_len.clone())
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [r14]
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_done.clone())
    x64_add_ri(&mut ctx.text, X64::R12, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_len.clone())

    def_label(&mut ctx.text, lbl_len_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # dst start
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)  # src cursor
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)  # dst cursor

    def_label(&mut ctx.text, lbl_copy.clone())
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [r14]
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [r15], al
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_copy.clone())

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# clock_gettime(clock_id: Int, tp: &u8) -> Int
# Real syscall passthrough: clock_id in x0/rdi, timespec out-pointer in x1/rsi.
# macOS AArch64: SYS_clock_gettime = 406; Linux AArch64: 113.
# macOS x86-64: 0x2000196 (406 + BSD class); Linux x86-64: 228.
# Windows: no clock_gettime — fail closed with a trap instead of zeroing the
# timespec and reporting success.
def emit_posix_clock_gettime(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "clock_gettime")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 406)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 113)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_brk(&mut ctx.text, 1)  # fail closed: no clock_gettime on Windows
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000196)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 228)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_ud2(&mut ctx.text)  # fail closed: no clock_gettime on Windows
    end
    x64_ret(&mut ctx.text)
  end
end

# __sync_fetch_and_add(ptr: Ptr[UInt], val: UInt) -> UInt
# Contract: single-threaded runtime — a plain load/add/store that returns the
# old value. Correct for single-threaded programs; NOT an atomic RMW (codegen
# lowers true atomics inline via ldaddal/casal, so this is only a fallback).
def emit_sync_fetch_and_add_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__sync_fetch_and_add")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X9, A64::X1)
    a64_stur(&mut ctx.text, A64::X10, A64::X0, 0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RSI)
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# libc_getenv(name: &u8) -> &u8
# getenv is not a syscall — it reads from the environ array in the process.
# The runtime saves the kernel-provided environ pointer in _tg_saved_envp,
# exposed through tg_get_envp; scan it for a "NAME=value" entry and return a
# pointer to the value part (or NULL when no entry matches).
def emit_posix_getenv(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_getenv")
  let lblLoop = fresh_label(ctx, ".Lgetenv_loop")
  let lblCmp = fresh_label(ctx, ".Lgetenv_cmp")
  let lblCheckEq = fresh_label(ctx, ".Lgetenv_check_eq")
  let lblNext = fresh_label(ctx, ".Lgetenv_next")
  let lblFound = fresh_label(ctx, ".Lgetenv_found")
  let lblNotFound = fresh_label(ctx, ".Lgetenv_notfound")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = name
    a64_bl(&mut ctx.text, "tg_get_envp")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)   # x20 = envp

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X9, A64::X20, 0)   # x9 = entry
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X19)  # x21 = p (name cursor)
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X9)   # x22 = q (entry cursor)

    def_label(&mut ctx.text, lblCmp.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X21, 0)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X22, 0)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCheckEq.clone())
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblCmp.clone())

    # Name fully matched: the entry must continue with '='.
    def_label(&mut ctx.text, lblCheckEq.clone())
    a64_ldrb(&mut ctx.text, A64::X10, A64::X22, 0)
    a64_mov_ri(&mut ctx.text, A64::X11, 61)   # '='
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNext.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_b(&mut ctx.text, lblFound.clone())

    def_label(&mut ctx.text, lblNext.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 8)
    a64_b(&mut ctx.text, lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)

    def_label(&mut ctx.text, lblFound.clone())
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)   # rbx = name
    x64_call_label(&mut ctx.text, "tg_get_envp")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)   # r12 = envp

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R12, 0)  # rax = entry
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RBX)     # r13 = p (name cursor)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)     # r14 = q (entry cursor)

    def_label(&mut ctx.text, lblCmp.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RDX, X64::R13, 0)
    x64_movzx_r64_m8(&mut ctx.text, X64::R10, X64::R14, 0)
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::R10)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lblCheckEq.clone())
    x64_add_ri(&mut ctx.text, X64::R13, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblCmp.clone())

    # Name fully matched: the entry must continue with '='.
    def_label(&mut ctx.text, lblCheckEq.clone())
    x64_movzx_r64_m8(&mut ctx.text, X64::RAX, X64::R14, 0)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 61)
    x64_jcc(&mut ctx.text, CC::NE, lblNext.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lblFound.clone())

    def_label(&mut ctx.text, lblNext.clone())
    x64_add_ri(&mut ctx.text, X64::R12, 8)
    x64_jmp(&mut ctx.text, lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)

    def_label(&mut ctx.text, lblFound.clone())
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# CreateDirectoryW(lpPathName: &u16, lpSecurityAttributes: Ptr) -> Bool
# Windows-only; on other platforms, this is a no-op returning 0 (failure)
# since it should never actually be called on macOS/Linux.
def emit_posix_create_directory_w(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "CreateDirectoryW")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "CreateDirectoryW_kernel32")
    when _ then
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_call_extern(&mut ctx.text, "CreateDirectoryW_kernel32")
    when _ then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    end
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Bump Allocator Runtime
# ———————————————————————————————————————————————————————————————
# A hardened bump allocator for struct aggregates and small allocations.
# Struct aggregates must survive function returns, so they cannot be
# stack-allocated in the callee's frame (the pointer would dangle after
# return). This allocator lazily mmaps 4 MB chunks and bumps a pointer.
#
# Properties (FROZEN contract):
#   * Guaranteed alignment: returned pointers are 16-byte aligned.
#   * Deterministic init: _tg_bump_ptr/_tg_bump_end are zero-initialized in
#    .data; the first call takes the slow path and establishes the arena.
#   * Checked failure: if mmap fails (MAP_FAILED), the runtime traps
#     (brk/ud2) instead of returning a bogus pointer.
#   * Fast path: bump _tg_bump_ptr when it fits in the current chunk.
#
# _tg_bump_alloc(size: i64) -> *void
#   Globals: _tg_bump_ptr (current pointer), _tg_bump_end (chunk end)
#   Fast path: bump pointer, return old pointer
#   Slow path: mmap new 4 MB chunk, reset pointers, bump
# ———————————————————————————————————————————————————————————————

def emit_bump_alloc_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_bump_alloc(ctx)
end

# _tg_bump_alloc: Bump-allocate `size` bytes (x0/rdi = size), 16-byte aligned.
# Returns pointer to allocated memory in x0/rax. Traps on allocation failure.
# Preserves X19/X20 and leaves X21-X28 untouched (callee-saved contract).
def emit_tg_bump_alloc(ctx: &mut RuntimeEmitCtx) -> Unit
   def_runtime_fn(ctx, "_tg_bump_alloc")
   match ctx.target.arch
   when Arch::AArch64 then
       let size_ok = fresh_label(ctx, ".Lbump_size_ok")
       let fast    = fresh_label(ctx, ".Lbump_fast")
       let slow    = fresh_label(ctx, ".Lbump_slow")
       let fail    = fresh_label(ctx, ".Lbump_fail")
       let done    = fresh_label(ctx, ".Lbump_done")

       a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
       a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
       a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
       a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
       a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

       # X19 = align16(X0): guaranteed 16-byte alignment.
       a64_add_rri(&mut ctx.text, A64::X19, A64::X0, 15)
       a64_lsr(&mut ctx.text, A64::X19, A64::X19, 4)
       a64_lsl(&mut ctx.text, A64::X19, A64::X19, 4)
       a64_cmp_ri(&mut ctx.text, A64::X19, 0)
       a64_mov_ri(&mut ctx.text, A64::X20, 16)
       a64_csel(&mut ctx.text, A64::X19, A64::X20, A64::X19, a64_cc_eq())

       # X22 = &_tg_bump_ptr (base; end lives at +8).
       add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_bump_ptr".to_string(), 0)
       emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X22))
       add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_bump_ptr".to_string(), 0)
       a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 0)

       # X20 = current ptr, X21 = chunk end.
       a64_ldr(&mut ctx.text, A64::X20, A64::X22, 0)
       a64_ldr(&mut ctx.text, A64::X21, A64::X22, 8)

       # Fast path: available = end - ptr >= size ?
       a64_sub_rrr(&mut ctx.text, A64::X23, A64::X21, A64::X20)
       a64_cmp_rr(&mut ctx.text, A64::X23, A64::X19)
       a64_bcond(&mut ctx.text, a64_cc_cs(), fast.clone())
       a64_b(&mut ctx.text, slow.clone())

       def_label(&mut ctx.text, fast.clone())
       a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X19)
       a64_str(&mut ctx.text, A64::X24, A64::X22, 0)
       a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
       a64_b(&mut ctx.text, done.clone())

       # Slow path: allocate a fresh chunk sized to the request.
       def_label(&mut ctx.text, slow.clone())

       # Large allocations (requested > 2 MiB) get a dedicated page-aligned
       # mapping so one oversized buffer never displaces the small-object arena.
       a64_cmp_ri(&mut ctx.text, A64::X19, 0x200000)
       let arena_path = fresh_label(ctx, ".Lbump_arena")
       a64_bcond(&mut ctx.text, a64_cc_le(), arena_path.clone())

       # Dedicated path: X1 = page_align(X19) = ((X19 + 0xFFF) >> 12) << 12.
       a64_add_rri(&mut ctx.text, A64::X21, A64::X19, 0xFFF)
       a64_lsr(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_lsl(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_mov_ri(&mut ctx.text, A64::X0, 0)
       a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
       a64_mov_ri(&mut ctx.text, A64::X2, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X16, 197)
         a64_svc(&mut ctx.text, 0x80)
       when OsAbi::Linux then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X8, 222)
         a64_svc(&mut ctx.text, 0)
       when _ then a64_brk(&mut ctx.text, 1)
       end
       # Checked failure: MAP_FAILED has the sign bit set.
       a64_cmp_ri(&mut ctx.text, A64::X0, 0)
       a64_bcond(&mut ctx.text, a64_cc_lt(), fail.clone())
       # Dedicated mapping is returned as-is; the bump arena is left untouched.
       a64_b(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, arena_path.clone())
       # mapping_size = max(4 MiB, page_align(X19)) computed in X23.
       a64_add_rri(&mut ctx.text, A64::X21, A64::X19, 0xFFF)
       a64_lsr(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_lsl(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_mov_ri(&mut ctx.text, A64::X23, 0x400000)
       a64_cmp_rr(&mut ctx.text, A64::X21, A64::X23)
       a64_csel(&mut ctx.text, A64::X23, A64::X21, A64::X23, a64_cc_gt())

       a64_mov_ri(&mut ctx.text, A64::X0, 0)
       a64_mov_rr(&mut ctx.text, A64::X1, A64::X23)
       a64_mov_ri(&mut ctx.text, A64::X2, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X16, 197)
         a64_svc(&mut ctx.text, 0x80)
       when OsAbi::Linux then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X8, 222)
         a64_svc(&mut ctx.text, 0)
       when _ then a64_brk(&mut ctx.text, 1)
       end
       # Checked failure: MAP_FAILED has the sign bit set.
       a64_cmp_ri(&mut ctx.text, A64::X0, 0)
       a64_bcond(&mut ctx.text, a64_cc_lt(), fail.clone())

       # Deterministic arena init: base = X0, end = base + mapping_size (X23).
       a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
       a64_add_rrr(&mut ctx.text, A64::X21, A64::X20, A64::X23)
       a64_str(&mut ctx.text, A64::X20, A64::X22, 0)
       a64_str(&mut ctx.text, A64::X21, A64::X22, 8)
       # Bump and return base.
       a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X19)
       a64_str(&mut ctx.text, A64::X24, A64::X22, 0)
       a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
       a64_b(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, fail.clone())
       a64_brk(&mut ctx.text, 1)

       def_label(&mut ctx.text, done.clone())
       a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
       a64_ret(&mut ctx.text)
   when Arch::X86_64 then
       let size_ok = fresh_label(ctx, ".Lbump_size_ok")
       let fast    = fresh_label(ctx, ".Lbump_fast")
       let slow    = fresh_label(ctx, ".Lbump_slow")
       let fail    = fresh_label(ctx, ".Lbump_fail")
       let done    = fresh_label(ctx, ".Lbump_done")

       x64_push(&mut ctx.text, X64::RBP)
       x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
       x64_push(&mut ctx.text, X64::RBX)
       x64_push(&mut ctx.text, X64::R12)
       x64_push(&mut ctx.text, X64::R13)
       x64_push(&mut ctx.text, X64::R14)
       x64_push(&mut ctx.text, X64::R15)

       # RBX = align16(RDI): guaranteed 16-byte alignment.
       x64_add_ri(&mut ctx.text, X64::RDI, 15)
       x64_and_ri(&mut ctx.text, X64::RDI, -16)
       x64_cmp_ri(&mut ctx.text, X64::RDI, 0)
       x64_jcc(&mut ctx.text, CC::NE, size_ok.clone())
       x64_mov_ri(&mut ctx.text, X64::RDI, 16)
       def_label(&mut ctx.text, size_ok.clone())
       x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)

       # R12 = &_tg_bump_ptr (RIP-relative; end lives at +8).
       emit8(&mut ctx.text, 0x48)
       emit8(&mut ctx.text, 0x8D)
       emit8(&mut ctx.text, 0x05)
       add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_bump_ptr".to_string(), -4)
       emit32_le(&mut ctx.text, 0)
       x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)

       # R13 = current ptr, R14 = chunk end.
       x64_mov_rm(&mut ctx.text, X64::R13, X64::R12, 0)
       x64_mov_rm(&mut ctx.text, X64::R14, X64::R12, 8)

       # Fast path: available = end - ptr >= size ?
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R14)
       x64_sub_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_cmp_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_jcc(&mut ctx.text, CC::AE, fast.clone())
       x64_jmp(&mut ctx.text, slow.clone())

       def_label(&mut ctx.text, fast.clone())
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R15)
       x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
       x64_jmp(&mut ctx.text, done.clone())

       # Slow path: allocate a fresh chunk sized to the request.
       def_label(&mut ctx.text, slow.clone())

       # Large allocations (requested > 2 MiB) get a dedicated page-aligned
       # mapping so one oversized buffer never displaces the small-object arena.
       x64_cmp_ri(&mut ctx.text, X64::RBX, 0x200000)
       let arena_path = fresh_label(ctx, ".Lbump_arena")
       x64_jcc(&mut ctx.text, CC::BE, arena_path.clone())

       # Dedicated path: RSI = page_align(RBX) = ((RBX + 0xFFF) >> 12) << 12.
       x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
       x64_add_ri(&mut ctx.text, X64::RSI, 0xFFF)
       x64_shr_ri(&mut ctx.text, X64::RSI, 12)
       x64_shl_ri(&mut ctx.text, X64::RSI, 12)
       x64_mov_ri(&mut ctx.text, X64::RDI, 0)
       x64_mov_ri(&mut ctx.text, X64::RDX, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
       when OsAbi::Linux then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 9)
       when _ then x64_ud2(&mut ctx.text)
       end
       x64_syscall(&mut ctx.text)
       # Checked failure: MAP_FAILED has the sign bit set.
       x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
       x64_jcc(&mut ctx.text, CC::S, fail.clone())
       # Dedicated mapping is returned as-is; the bump arena is left untouched.
       x64_jmp(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, arena_path.clone())
       # mapping_size = max(4 MiB, page_align(RBX)) computed in R15 (callee-saved).
       x64_mov_ri(&mut ctx.text, X64::R15, 0x400000)
       x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)
       x64_add_ri(&mut ctx.text, X64::R14, 0xFFF)
       x64_shr_ri(&mut ctx.text, X64::R14, 12)
       x64_shl_ri(&mut ctx.text, X64::R14, 12)
       x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
       x64_cmova_rr(&mut ctx.text, X64::R15, X64::R14)

       x64_mov_rr(&mut ctx.text, X64::RSI, X64::R15)
       x64_mov_ri(&mut ctx.text, X64::RDI, 0)
       x64_mov_ri(&mut ctx.text, X64::RDX, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
       when OsAbi::Linux then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 9)
       when _ then x64_ud2(&mut ctx.text)
       end
       x64_syscall(&mut ctx.text)
       # Checked failure: MAP_FAILED has the sign bit set.
       x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
       x64_jcc(&mut ctx.text, CC::S, fail.clone())

       # Deterministic arena init: base = RAX, end = base + mapping_size (R15).
       x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)
       x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R14, X64::R15)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R13)
       x64_mov_mr(&mut ctx.text, X64::R12, 8, X64::R14)
       # Bump and return base.
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R15)
       x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
       x64_jmp(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, fail.clone())
       x64_ud2(&mut ctx.text)

       def_label(&mut ctx.text, done.clone())
       x64_pop(&mut ctx.text, X64::R15)
       x64_pop(&mut ctx.text, X64::R14)
       x64_pop(&mut ctx.text, X64::R13)
       x64_pop(&mut ctx.text, X64::R12)
       x64_pop(&mut ctx.text, X64::RBX)
       x64_pop(&mut ctx.text, X64::RBP)
       x64_ret(&mut ctx.text)
   end
end

