# Tangerine Compiler — Runtime Library
# Full implementations of runtime functions for stdlib intrinsics
#
# This module contains the complete implementations of:
# - Array/Vec operations (dynamic arrays with growth)
# - Map operations (hash table with open addressing)
# - Set operations (hash set)
# - Memory allocation (mmap-based heap)
# - String conversion (int/float to string)
# - I/O operations

use std::core::{Option, Result, panic}
use tg_compiler::asm::{
  CodeBuffer, buf_new, buf_pos, align_to, emit8, emit32_le, emit64_le,
  def_label, add_reloc, add_symbol, RelocKind,
  AsmSymbol, Section, SymBinding, SymKind,
  Arch, OsAbi, AsmTarget,
  X64, A64,
  x64_mov_ri, x64_mov_rr, x64_mov_rm, x64_mov_mr,
  x64_add_rr, x64_add_ri, x64_sub_rr, x64_sub_ri,
  x64_imul_rr, x64_cqo, x64_idiv_r,
  x64_and_rr, x64_or_rr, x64_xor_rr, x64_and_ri,
  x64_cmp_rr, x64_cmp_ri, x64_test_rr,
  x64_jmp, x64_jcc, x64_call_label, x64_call_r, x64_call_extern,
  x64_ret, x64_push, x64_pop, x64_sub_ri, x64_shl_ri, x64_shr_ri, x64_cmova_rr,
  x64_lea_mem, x64_syscall, x64_ud2, x64_neg_r,
  a64_mov_ri, a64_mov_rr, a64_add_rrr, a64_add_rri,
  a64_sub_rrr, a64_sub_rri, a64_mul_rrr,
  a64_and_rrr, a64_orr_rrr, a64_eor_rrr,
  a64_cmp_rr, a64_cmp_ri,
  a64_ldr, a64_str, a64_ldur, a64_stur,
  a64_ldrb, a64_strb, a64_ldr_post, a64_stp_pre, a64_ldp_post,
  a64_bl, a64_blr, a64_ret, a64_b, a64_bcond, a64_brk,
  a64_svc, a64_udf, a64_nop, a64_lsl, a64_lsl_rrr,
  a64_sdiv_rrr, a64_udiv, a64_msub, a64_csel, a64_add_rrr_lsl, a64_lsr,
  a64_cc_eq, a64_cc_ne, a64_cc_lt, a64_cc_le, a64_cc_gt, a64_cc_ge, a64_cc_cs, a64_cc_cc,
  a64_neg, a64_code, CC
}

# ———————————————————————————————————————————————————————————————
# Runtime Emission Context
# ———————————————————————————————————————————————————————————————

struct RuntimeEmitCtx
  text: CodeBuffer
  target: AsmTarget
  lbl_counter: Int
end

def runtime_ctx_new(target: AsmTarget) -> RuntimeEmitCtx
  RuntimeEmitCtx {
    text: buf_new(),
    target: target,
    lbl_counter: 0
  }
end

def fresh_label(ctx: &mut RuntimeEmitCtx, prefix: String) -> String
  let lbl = prefix + "." + ctx.lbl_counter.to_string()
  ctx.lbl_counter = ctx.lbl_counter + 1
  lbl
end

# Emit both a label (for fixup resolution) AND a symbol (for linker resolution).
# This is required for all named runtime functions so the linker can find them.
def def_runtime_fn(ctx: &mut RuntimeEmitCtx, name: String) -> Unit
  # Align function start to 4 bytes (required for ARM64 instruction alignment)
  align_to(&mut ctx.text, 4, ctx.target.arch)
  let offset = buf_pos(&ctx.text)
  add_symbol(&mut ctx.text, AsmSymbol {
    name: name.clone(),
    section: Section::Text,
    offset: offset,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  def_label(&mut ctx.text, name)
end

# ———————————————————————————————————————————————————————————————
# Emit All Runtime Functions
# ———————————————————————————————————————————————————————————————

def emit_all_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_array_runtime(ctx)
  emit_map_runtime(ctx)
  emit_set_runtime(ctx)
  emit_memory_runtime(ctx)
  emit_string_conv_runtime(ctx)
  emit_intrinsic_runtime(ctx)
  emit_arg_runtime(ctx)
  emit_posix_runtime(ctx)
  emit_bump_alloc_runtime(ctx)
end

# ———————————————————————————————————————————————————————————————
# Intrinsic Runtime Implementation (abort, longjmp, etc.)
# ———————————————————————————————————————————————————————————————

def emit_intrinsic_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_intrinsic_abort(ctx)
  emit_tg_intrinsic_setjmp(ctx)
  emit_tg_intrinsic_longjmp(ctx)
  emit_tg_get_argc(ctx)
  emit_tg_get_argv(ctx)
  emit_tg_get_envp(ctx)
end

# __intrinsic_abort: Abort execution with trap
def emit_tg_intrinsic_abort(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_abort")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_brk(&mut ctx.text, 1)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# __intrinsic_setjmp(jmp_buf: Ptr[u8]) -> Int
# Save callee-saved registers + SP + return address into jmp_buf.
# Returns 0 on the initial call; when longjmp restores, setjmp returns
# the value passed to longjmp (or 1 if the value was 0).
#
# jmp_buf layout for AArch64 (13 × 8 = 104 bytes):
#   [0]   X19   [8]  X20   [16] X21   [24] X22
#   [32]  X23   [40] X24   [48] X25   [56] X26
#   [64]  X27   [72] X28   [80] FP    [88] LR
#   [96]  SP
#
# jmp_buf layout for x86_64 (8 × 8 = 64 bytes):
#   [0]  RBX  [8]  RBP  [16] R12  [24] R13
#   [32] R14  [40] R15  [48] RSP  [56] RIP (return address)
def emit_tg_intrinsic_setjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_setjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf pointer
    a64_str(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_str(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_str(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_str(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_str(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_str(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_str(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_str(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_str(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_str(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_str(&mut ctx.text, A64::LR, A64::X0, 88)
    # Store SP: MOV X9, SP; STR X9, [X0, #96]
    a64_mov_rr(&mut ctx.text, A64::X9, A64::SP)
    a64_str(&mut ctx.text, A64::X9, A64::X0, 96)
    # Return 0
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf pointer
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RBX)
    x64_mov_mr(&mut ctx.text, X64::RDI, 8, X64::RBP)
    x64_mov_mr(&mut ctx.text, X64::RDI, 16, X64::R12)
    x64_mov_mr(&mut ctx.text, X64::RDI, 24, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RDI, 32, X64::R14)
    x64_mov_mr(&mut ctx.text, X64::RDI, 40, X64::R15)
    # Save RSP (after call = RSP + 8, since CALL pushed return address)
    x64_lea_mem(&mut ctx.text, X64::RAX, X64::RSP, 8)
    x64_mov_mr(&mut ctx.text, X64::RDI, 48, X64::RAX)
    # Save return address (at [RSP])
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 0)
    x64_mov_mr(&mut ctx.text, X64::RDI, 56, X64::RAX)
    # Return 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# __intrinsic_longjmp(jmp_buf: Ptr[u8], val: Int)
# Restore callee-saved registers + SP + return address from jmp_buf,
# then return to the setjmp call site with val (or 1 if val == 0).
def emit_tg_intrinsic_longjmp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__intrinsic_longjmp")

  match ctx.target.arch
  when Arch::AArch64 then
    # X0 = jmp_buf, X1 = val
    # Ensure val != 0 (longjmp(buf, 0) must return 1)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    # CSINC X1, X1, XZR, NE → if X1 == 0 then X1 = 1 else X1 = X1
    emit32_le(&mut ctx.text, 0x5A9F1021)  # CSINC W1, W1, WZR, NE
    # Restore callee-saved registers
    a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)
    a64_ldr(&mut ctx.text, A64::X20, A64::X0, 8)
    a64_ldr(&mut ctx.text, A64::X21, A64::X0, 16)
    a64_ldr(&mut ctx.text, A64::X22, A64::X0, 24)
    a64_ldr(&mut ctx.text, A64::X23, A64::X0, 32)
    a64_ldr(&mut ctx.text, A64::X24, A64::X0, 40)
    a64_ldr(&mut ctx.text, A64::X25, A64::X0, 48)
    a64_ldr(&mut ctx.text, A64::X26, A64::X0, 56)
    a64_ldr(&mut ctx.text, A64::X27, A64::X0, 64)
    a64_ldr(&mut ctx.text, A64::X28, A64::X0, 72)
    a64_ldr(&mut ctx.text, A64::FP, A64::X0, 80)
    a64_ldr(&mut ctx.text, A64::LR, A64::X0, 88)
    # Restore SP
    a64_ldr(&mut ctx.text, A64::X9, A64::X0, 96)
    a64_mov_rr(&mut ctx.text, A64::SP, A64::X9)
    # Return val
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # RDI = jmp_buf, RSI = val
    # Ensure val != 0
    x64_test_rr(&mut ctx.text, X64::RSI, X64::RSI)
    # if RSI == 0 then RSI = 1
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    # CMOVNZ RAX, RSI → RAX = (RSI != 0) ? RSI : 1
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x45)
    emit8(&mut ctx.text, 0xC6)  # cmovnz rax, rsi
    # Restore callee-saved regs
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)
    x64_mov_rm(&mut ctx.text, X64::RBP, X64::RDI, 8)
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RDI, 16)
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RDI, 24)
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RDI, 32)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RDI, 40)
    # Restore RSP
    x64_mov_rm(&mut ctx.text, X64::RSP, X64::RDI, 48)
    # Jump to saved return address  
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 56)
    # JMP RCX
    emit8(&mut ctx.text, 0xFF)
    emit8(&mut ctx.text, 0xE1)  # jmp rcx
  end
end

def emit_load_data_global(ctx: &mut RuntimeEmitCtx, sym_name: String) -> Unit
  match ctx.target.arch
  when Arch::AArch64 then
    # ADRP X0, sym@PAGE
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, sym_name.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000)
    # ADD X0, X0, sym@PAGEOFF
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, sym_name, 0)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 0)
    # LDR X0, [X0]
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # LEA RAX, [RIP + sym]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8D)
    emit8(&mut ctx.text, 0x05)
    add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, sym_name, -4)
    emit32_le(&mut ctx.text, 0)
    # MOV RAX, [RAX]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_get_argc(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argc")
  emit_load_data_global(ctx, "_tg_saved_argc".to_string())
end

def emit_tg_get_argv(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_argv")
  emit_load_data_global(ctx, "_tg_saved_argv".to_string())
end

def emit_tg_get_envp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "tg_get_envp")
  emit_load_data_global(ctx, "_tg_saved_envp".to_string())
end

# _tg_cstring_new: Wrap a native C string pointer into a CString value.
# CString is a single pointer field at the native ABI, so this is an identity helper.
# Args: x0/rdi = C string pointer (a Tangerine String value)
# Returns: x0/rax = same pointer value, reinterpreted as CString
def emit_tg_cstring_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_cstring_new")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_bytes: Convert a C string to a Vec[Int] of its bytes.
# Each byte is stored as an 8-byte word in the Vec's data buffer.
# Args: x0/rdi = C string pointer (null-terminated)
# Returns: x0/rax = Vec pointer ([data_ptr, len, cap])
def emit_tg_string_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_bytes")

  let lbl_len = fresh_label(ctx, ".Lsb_len")
  let lbl_lendone = fresh_label(ctx, ".Lsb_lendone")
  let lbl_sizeok = fresh_label(ctx, ".Lsb_sizeok")
  let lbl_copy = fresh_label(ctx, ".Lsb_copy")
  let lbl_copydone = fresh_label(ctx, ".Lsb_copydone")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    # x19 = C string pointer
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)

    # strlen → x20
    a64_mov_ri(&mut ctx.text, A64::X20, 0)
    def_label(&mut ctx.text, lbl_len.clone())
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X19, A64::X20)
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_cmp_ri(&mut ctx.text, A64::X2, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_lendone.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
    a64_b(&mut ctx.text, lbl_len.clone())
    def_label(&mut ctx.text, lbl_lendone.clone())

    # Allocate Vec struct (24 bytes)
    a64_mov_ri(&mut ctx.text, A64::X0, 24)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # Allocate data buffer: len * 8 bytes (min 8)
    a64_lsl(&mut ctx.text, A64::X0, A64::X20, 3)
    a64_cmp_ri(&mut ctx.text, A64::X0, 8)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_sizeok.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    def_label(&mut ctx.text, lbl_sizeok.clone())
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)

    # Set Vec fields
    a64_stur(&mut ctx.text, A64::X22, A64::X21, 0)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 8)
    a64_stur(&mut ctx.text, A64::X20, A64::X21, 16)

    # Copy bytes as 8-byte words
    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copydone.clone())
     a64_add_rrr(&mut ctx.text, A64::X0, A64::X19, A64::X23)
     a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)
     a64_add_rrr_lsl(&mut ctx.text, A64::X1, A64::X22, A64::X23, 3)
     a64_stur(&mut ctx.text, A64::X2, A64::X1, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())
    def_label(&mut ctx.text, lbl_copydone.clone())

    # Return Vec pointer
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86_64: stub — just return null Vec for now (bootstrap targets AArch64)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# Argument/process helper runtime emitters.
def emit_arg_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_env_count(ctx)
  emit_tg_str_skip(ctx)
  emit_tg_arg(ctx)
  emit_tg_arg_copy(ctx)
  emit_tg_env_entry(ctx)
  emit_tg_args_vec(ctx)
  emit_tg_status(ctx)
  emit_tg_output(ctx)
  emit_tg_stdout_string(ctx)
  emit_tg_stderr_string(ctx)
end

# _tg_env_count: Count environment variable entries (envp array length).
# Returns: number of envp entries before the NULL terminator.
def emit_tg_env_count(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_count")

  let lbl_loop = fresh_label(ctx, ".Lenvcount_loop")
  let lbl_done = fresh_label(ctx, ".Lenvcount_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "tg_get_envp")
    # X0 = envp pointer (array of char* pointers)
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    a64_add_rrr_lsl(&mut ctx.text, A64::X10, A64::X0, A64::X9, 3)  # X10 = envp + counter * 8
    a64_ldr(&mut ctx.text, A64::X10, A64::X10, 0)  # X10 = envp[counter]
    a64_cmp_ri(&mut ctx.text, A64::X10, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done.clone())
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)  # return count

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_call_label(&mut ctx.text, "tg_get_envp")
    # RAX = envp pointer
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)  # counter = 0
    def_label(&mut ctx.text, lbl_loop.clone())
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RCX)
    x64_shl_ri(&mut ctx.text, X64::RBX, 3)
    x64_add_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_loop.clone())
    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RCX)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg: Get command line argument at index.
# Args: x0/rdi = index
# Returns: raw char* from argv (String = C string at ABI level)
# Returns NULL if index is out of bounds (index < 0 || index >= argc)
def emit_tg_arg(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg")

  let lbl_valid = fresh_label(ctx, ".Larg_valid")
  let lbl_done = fresh_label(ctx, ".Larg_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    # Save index to X19
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    
    # Bounds check: if index < 0, return NULL
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_cmp_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    
    # Valid index: get argv[index]
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_b(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (String = C string at ABI level)

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)

    # Save index to RBX
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    
    # Bounds check: if index < 0, return NULL
    x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
    x64_jcc(&mut ctx.text, CC::L, lbl_done.clone())
    
    # Get argc and check bounds: if index >= argc, return NULL
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
    x64_cmp_rr(&mut ctx.text, X64::RBX, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())
    
    # Valid index: get argv[index]
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)
    x64_jmp(&mut ctx.text, lbl_valid.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    # Return NULL for out-of-bounds
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lbl_valid.clone())
    # Return raw char* pointer (String = C string at ABI level)

    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_arg_copy: Get command line argument at index and copy it into
# a bump-allocated owned C string.
def emit_tg_arg_copy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_arg_copy")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

    a64_bl(&mut ctx.text, "_tg_arg")
    a64_bl(&mut ctx.text, "_tg_string_bytes")
    a64_bl(&mut ctx.text, "_tg_string_from_bytes")

    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)

    x64_call_label(&mut ctx.text, "_tg_arg")
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_bytes")
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_call_label(&mut ctx.text, "_tg_string_from_bytes")

    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_env_entry: Get environment variable entry at index.
# Args: x0/rdi = index
# Returns: raw char* from envp (null if past end), e.g. "KEY=value"
# _tg_str_skip(str: String, offset: Int) -> String
# Returns str + offset (pointer arithmetic on C string)
def emit_tg_str_skip(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_skip")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_add_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_ret(&mut ctx.text)
  end
end

def emit_tg_env_entry(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_env_entry")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    a64_bl(&mut ctx.text, "tg_get_envp")
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X19, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # Return raw char* pointer or NULL

    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    x64_call_label(&mut ctx.text, "tg_get_envp")
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)
    x64_shl_ri(&mut ctx.text, X64::RCX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RAX, 0)

    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_args_vec: Get all command line arguments as Vec[String]
# Returns: Vec ptr containing Tangerine String values
def emit_tg_args_vec(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_args_vec")

  let lbl_loop = fresh_label(ctx, ".Largsvec_loop")
  let lbl_done = fresh_label(ctx, ".Largsvec_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue — save callee-saved registers we use
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    # Create empty Vec → x19
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)

    # Get argc → x20
    a64_bl(&mut ctx.text, "tg_get_argc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)

    # Get argv → x21
    a64_bl(&mut ctx.text, "tg_get_argv")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)

    # i = 0
    a64_mov_ri(&mut ctx.text, A64::X22, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    # if i >= argc → done
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())

    # x1 = argv[i] : load from [x21 + x22*8]
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X21, A64::X22, 3)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    # Raw char* is the String value (String = C string at ABI level)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)

    # _tg_array_push(vec, string)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    # i++
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    # Return the Vec
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)

    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    # Create empty Vec → rbx
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)

    # Get argc → r12
    x64_call_label(&mut ctx.text, "tg_get_argc")
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)

    # Get argv → r13
    x64_call_label(&mut ctx.text, "tg_get_argv")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

    # i = 0
    x64_mov_ri(&mut ctx.text, X64::R14, 0)

    def_label(&mut ctx.text, lbl_loop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lbl_done.clone())

    # rsi = argv[i]
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_mov_rm(&mut ctx.text, X64::RDI, X64::RAX, 0)
    # Raw char* is the String value (String = C string at ABI level)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)

    # _tg_array_push(vec, string)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_loop)

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)

    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_string_from_bytes: Convert a Vec[u8]-style array buffer into a
# null-terminated runtime String.
# Args: x0/rdi = Vec pointer ([data_ptr, len, cap]) where each byte is stored
#        in an 8-byte slot.
# Returns: x0/rax = pointer to a newly allocated null-terminated byte buffer.
def emit_tg_string_from_bytes(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_string_from_bytes")

  let lbl_copy = fresh_label(ctx, ".Lsfb_copy")
  let lbl_done = fresh_label(ctx, ".Lsfb_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 8)  # len
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 0)  # data ptr

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # dst ptr

    a64_mov_ri(&mut ctx.text, A64::X23, 0)
    def_label(&mut ctx.text, lbl_copy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_done.clone())
    a64_add_rrr_lsl(&mut ctx.text, A64::X10, A64::X21, A64::X23, 3)
    a64_ldur(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X23)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lbl_copy.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X20)
    a64_mov_ri(&mut ctx.text, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RBX, 8)  # len
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 0)  # data ptr

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # start ptr
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # cursor

    def_label(&mut ctx.text, lbl_copy.clone())
    x64_cmp_ri(&mut ctx.text, X64::R12, 0)
    x64_jcc(&mut ctx.text, CC::E, lbl_done.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R13, 0)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_add_ri(&mut ctx.text, X64::R13, 8)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_sub_ri(&mut ctx.text, X64::R12, 1)
    x64_jmp(&mut ctx.text, lbl_copy.clone())

    def_label(&mut ctx.text, lbl_done.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)

    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_status: Run a command and get exit status
# Args: x0/rdi = command string ptr
# Returns: exit code (Int)
def emit_tg_status(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_status")
  # Return 0 (success) for now - full implementation would use system()
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# _tg_output: Run a command and capture output
# Args: x0/rdi = command string ptr
# Returns: output string ptr
def emit_tg_output(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_output")
  # Return empty string for now
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 1)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_strb(&mut ctx.text, A64::XZR, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_ri(&mut ctx.text, X64::RSI, 1)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# _tg_stdout_string: Capture stdout as string
# Returns: string ptr
def emit_tg_stdout_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stdout_string")
  # Return empty string for now — delegate to _tg_output with proper frame
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_stderr_string: Capture stderr as string
# Returns: string ptr
def emit_tg_stderr_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_stderr_string")
  # Return empty string for now — delegate to _tg_output with proper frame
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_output")
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_output")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Array/Vec Runtime Implementation
# ———————————————————————————————————————————————————————————————
#
# Vec[T] layout (24 bytes):
#   [ptr+0]:  data pointer  (8 bytes)
#   [ptr+8]:  length        (8 bytes)
#   [ptr+16]: capacity      (8 bytes)
#
# Initial capacity: 8 elements
# Growth factor: 2x

def emit_array_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_array_new(ctx)
  emit_tg_array_push(ctx)
  emit_tg_array_grow(ctx)
  emit_tg_array_destroy(ctx)
  emit_tg_array_pop(ctx)
  emit_tg_array_get(ctx)
  emit_tg_array_set(ctx)
  emit_tg_array_remove(ctx)
  emit_tg_array_insert(ctx)
  emit_tg_array_insert_full(ctx)
  emit_tg_array_contains(ctx)
  emit_tg_array_reverse(ctx)
  emit_tg_array_extend(ctx)
  emit_tg_array_resize(ctx)
end

# _tg_array_new: Allocate empty vec struct
# Returns: ptr to vec (24 bytes, all zeros)
def emit_tg_array_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_new")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    
    # Array headers are tiny and extremely frequent during lex/parse.
    # Allocate them from the bump arena instead of page-rounded mmap.
    a64_mov_ri(&mut ctx.text, A64::X0, 24)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct (3 stores of 8 bytes each)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # Save vec ptr
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 0)   # data = null
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 8)   # len = 0
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 16)  # cap = 0
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # Return vec ptr
    
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    
    x64_mov_ri(&mut ctx.text, X64::RDI, 24)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    
    # Zero the vec struct
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # Save vec ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RCX)   # data = null
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)   # len = 0
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RCX)  # cap = 0
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)  # Return vec ptr
    
    # Epilogue
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_push: Append element to vec
# Args: x0/rdi = vec ptr, x1/rsi = element (8 bytes)
# Returns: void
def emit_tg_array_push(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_push")
  
  let lblGrow = fresh_label(ctx, ".Larr_push_grow")
  let lblDone = fresh_label(ctx, ".Larr_push_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    # Save args
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # element
    
    # Sanity check: if vec ptr is 0 or len > 1B, trap immediately
    let sanity_ok = fresh_label(ctx, ".Larr_push_sanity_ok")
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), sanity_ok.clone())  # skip check if null (trap later)
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_mov_ri(&mut ctx.text, A64::X0, 1000000000)
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), sanity_ok.clone())
    a64_brk(&mut ctx.text, 0xBEEF)  # trap with identifiable code
    def_label(&mut ctx.text, sanity_ok)
    
    # Load len and cap
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)   # len
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16)  # cap
    
    # if len < cap: skip grow
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblGrow.clone())
    
    # Need to grow: new_cap = max(cap * 2, 8)
    a64_mov_ri(&mut ctx.text, A64::X0, 8)
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X0)
    a64_csel(&mut ctx.text, A64::X0, A64::X22, A64::X0, a64_cc_ge())
    a64_lsl(&mut ctx.text, A64::X0, A64::X0, 1)  # new_cap = max(cap,8) * 2
    
    # Call _tg_array_grow(vec, new_cap)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # new_cap in x1
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)  # vec in x0
    a64_bl(&mut ctx.text, "_tg_array_grow")
    
    # Reload data pointer
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16)  # cap (now updated)
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len]
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)   # data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 8)  # len
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X21, 3)  # data + len*8
    a64_str(&mut ctx.text, A64::X20, A64::X0, 0)
    
    # len++
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 1)
    a64_stur(&mut ctx.text, A64::X21, A64::X19, 8)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Prologue
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    # Save args
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # element
    
    # Load len and cap
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RBX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 16)  # cap
    
    # if len < cap: skip grow
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::R14)
    x64_jcc(&mut ctx.text, CC::L, lblGrow.clone())
    
    # Need to grow
    x64_mov_ri(&mut ctx.text, X64::RAX, 8)
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::RAX)
    x64_cmova_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 1)  # new_cap *= 2
    
    # Call _tg_array_grow
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_grow")
    
    def_label(&mut ctx.text, lblGrow.clone())
    # Store element at data[len]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)   # data ptr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    # lea rax, [rax + rcx*8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8D)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xC8)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::R12)
    
    # len++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Epilogue
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_grow: Internal helper to grow array capacity
# Args: x0/rdi = vec ptr, x1/rsi = new_capacity
# _tg_array_destroy: release the array's mmap'ed data buffer. Args: x0 =
# vec (24-byte header: [0] data, [8] len, [16] cap). Elements were already
# finalized by the cleanup loop; this frees the backing allocation.
def emit_tg_array_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_destroy")
  let lblSkip = fresh_label(ctx, ".Larr_destroy_skip")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 3)     # cap * 8 (element slots are pointers)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    def_label(&mut ctx.text, lblSkip.clone())
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)  # fail closed: x86 backing release not implemented
  end
end

def emit_tg_array_grow(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_grow")
  
  match ctx.target.arch
   when Arch::AArch64 then
     # Prologue — save all callee-saved regs (svc clobbers them on macOS ARM64)
     a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
     a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
     a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X25, A64::X26, A64::SP, -16)
     a64_stp_pre(&mut ctx.text, A64::X27, A64::X28, A64::SP, -16)
     
     a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # new_cap
    
    # Allocate new buffer: mmap(0, new_cap*8, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    a64_lsl(&mut ctx.text, A64::X1, A64::X20, 3)  # size = new_cap * 8
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # new_data
    
    # Copy old data to new buffer
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 0)  # old_data
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)   # len
    
    let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
    let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
    
    a64_mov_ri(&mut ctx.text, A64::X1, 0)  # i = 0
    def_label(&mut ctx.text, lblCopyLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X1, A64::X0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
    
    # new_data[i] = old_data[i]
    a64_lsl(&mut ctx.text, A64::X2, A64::X1, 3)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X22, A64::X2)
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 0)
    a64_lsl(&mut ctx.text, A64::X2, A64::X1, 3)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X2)
    a64_str(&mut ctx.text, A64::X3, A64::X2, 0)
    
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lblCopyLoop)
    
    def_label(&mut ctx.text, lblCopyDone.clone())
    
    # Free old buffer if not null
    a64_cmp_ri(&mut ctx.text, A64::X22, 0)
    let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkipFree.clone())
    
    # munmap(old_data, old_cap * 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    
    def_label(&mut ctx.text, lblSkipFree.clone())
    
    # Update vec: data = new_data, cap = new_cap
    a64_stur(&mut ctx.text, A64::X21, A64::X19, 0)
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 16)
    
    # Epilogue — pop exactly the 6 pairs pushed in the prologue, in reverse
    a64_ldp_post(&mut ctx.text, A64::X27, A64::X28, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar implementation for x86-64
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # new_cap
    
    # mmap(0, new_cap*8, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_shl_ri(&mut ctx.text, X64::RSI, 3)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # new_data
    
    # Copy loop
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 0)  # old_data
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 8)  # len
    
    let lblCopyLoop = fresh_label(ctx, ".Larr_grow_copy")
    let lblCopyDone = fresh_label(ctx, ".Larr_grow_copy_done")
    
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    def_label(&mut ctx.text, lblCopyLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R15)
    x64_jcc(&mut ctx.text, CC::E, lblCopyDone.clone())
    
    # rax = old_data[rcx]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xCE)  # mov rax, [rsi + rcx*8]
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    # new_data[rcx] = rax
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xCD)  # mov [rcx*8 + rdi], rax
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblCopyLoop)
    
    def_label(&mut ctx.text, lblCopyDone.clone())
    
    # Free old buffer
    x64_test_rr(&mut ctx.text, X64::R14, X64::R14)
    let lblSkipFree = fresh_label(ctx, ".Larr_grow_skip_free")
    x64_jcc(&mut ctx.text, CC::E, lblSkipFree.clone())
    
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R14)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RBX, 16)
    x64_shl_ri(&mut ctx.text, X64::RSI, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    def_label(&mut ctx.text, lblSkipFree.clone())
    
    # Update vec
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::R13)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::R12)
    
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_pop: Remove and return last element
# Args: x0/rdi = vec ptr
# Returns: element (8 bytes) or 0 if empty
def emit_tg_array_pop(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_pop")
  
  let lblEmpty = fresh_label(ctx, ".Larr_pop_empty")
  let lblDone = fresh_label(ctx, ".Larr_pop_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    
    # if len == 0: return 0
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblEmpty.clone())
    
    # len--
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    # return data[len]
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)  # data
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 3)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
    
    # if len == 0: return 0
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblEmpty.clone())
    
    # len--
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    # return data[len]
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 0)
    # mov rax, [rcx + rax*8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xC1)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblEmpty)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_get: Get element at index
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: element ptr (address) or null if out of bounds
def emit_tg_array_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_get")
  
  let lblOob = fresh_label(ctx, ".Larr_get_oob")
  let lblDone = fresh_label(ctx, ".Larr_get_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X1) # index
    
    # if index >= len: return null
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 8)
    a64_cmp_rr(&mut ctx.text, A64::X10, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblOob.clone())
    
    # return &data[index]
    a64_ldur(&mut ctx.text, A64::X0, A64::X9, 0)
    a64_add_rrr_lsl(&mut ctx.text, A64::X0, A64::X0, A64::X10, 3)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblOob)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)  # index
    
    # if index >= len: return null
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 8)
    x64_cmp_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::GE, lblOob.clone())
    
    # return &data[index]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)
    # lea rax, [rax + rdx*8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8D)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xD0)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblOob)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_set: Set element at index
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = element
def emit_tg_array_set(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_set")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec, x1 = index, x2 = element
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)  # data
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 3)   # index * 8
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X9, A64::X1)
    a64_str(&mut ctx.text, A64::X2, A64::X9, 0)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # rdi = vec, rsi = index, rdx = element
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data
    # mov [rax + rsi*8], rdx
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x14)
    emit8(&mut ctx.text, 0xF0)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_remove: Remove element at index, shift remaining
# Args: x0/rdi = vec ptr, x1/rsi = index
# Returns: removed element
def emit_tg_array_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_remove")
  
  let lblLoop = fresh_label(ctx, ".Larr_remove_loop")
  let lblDone = fresh_label(ctx, ".Larr_remove_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    
    # Save removed element
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_lsl(&mut ctx.text, A64::X1, A64::X20, 3)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ldr(&mut ctx.text, A64::X0, A64::X0, 0)  # removed element in x0
    
    # Shift: for i from index to len-2: data[i] = data[i+1]
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)  # len
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)  # len-1
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X20)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X2, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    
    # data[i] = data[i+1]
    a64_ldur(&mut ctx.text, A64::X3, A64::X19, 0)
    a64_lsl(&mut ctx.text, A64::X4, A64::X2, 3)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X3, A64::X4)
    a64_ldr(&mut ctx.text, A64::X4, A64::X3, 8)  # data[i+1]
    a64_str(&mut ctx.text, A64::X4, A64::X3, 0)  # data[i]
    
    a64_add_rri(&mut ctx.text, A64::X2, A64::X2, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 8)
    
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    
    # Get removed element
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    # mov rax, [rax + r12*8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x04)
    emit8(&mut ctx.text, 0xE4)
    x64_push(&mut ctx.text, X64::RAX)  # Save removed
    
    # Shift loop
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)  # i = index
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RCX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    
    # data[i] = data[i+1]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    # mov rdx, [rax + rsi*8 + 8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x54)
    emit8(&mut ctx.text, 0xF0)
    emit8(&mut ctx.text, 0x08)
    # mov [rax + rsi*8], rdx
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x14)
    emit8(&mut ctx.text, 0xF0)
    
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # len--
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RCX)
    
    x64_pop(&mut ctx.text, X64::RAX)  # Restore removed element
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_insert: Insert element at index, shift remaining
# Args: x0/rdi = vec ptr, x1/rsi = index, x2/rdx = element
def emit_tg_array_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert")
  
  # This requires growing if len == cap, then shifting elements up
  # Tail-call into the full implementation (no bl/call — preserves LR)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_array_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_array_insert_full")
  end
end

def emit_tg_array_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_insert_full")
  
  let lblLoop = fresh_label(ctx, ".Larr_insert_loop")
  let lblDone = fresh_label(ctx, ".Larr_insert_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # index
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # element
    
    # Ensure capacity by calling push with dummy element
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)
    a64_bl(&mut ctx.text, "_tg_array_push")
    
    # Shift elements down: for i from len-1 down to index+1: data[i] = data[i-1]
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # len (now incremented)
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)  # i = len-1
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblDone.clone())
    
    # data[i] = data[i-1]
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_lsl(&mut ctx.text, A64::X1, A64::X22, 3)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_ldr(&mut ctx.text, A64::X1, A64::X0, -8)  # data[i-1]
    a64_str(&mut ctx.text, A64::X1, A64::X0, 0)   # data[i]
    
    a64_sub_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_lsl(&mut ctx.text, A64::X1, A64::X20, 3)
    a64_add_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X1)
    a64_str(&mut ctx.text, A64::X21, A64::X0, 0)
    
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # index
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # element
    
    # Push dummy to ensure capacity
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_call_label(&mut ctx.text, "_tg_array_push")
    
    # Shift loop
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 8)  # len
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)  # i = len-1
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::R12)
    x64_jcc(&mut ctx.text, CC::LE, lblDone.clone())
    
    # data[i] = data[i-1]
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    # mov rdx, [rax + rcx*8 - 8]
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x8B)
    emit8(&mut ctx.text, 0x54)
    emit8(&mut ctx.text, 0xC8)
    emit8(&mut ctx.text, 0xF8)
    # mov [rax + rcx*8], rdx
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x14)
    emit8(&mut ctx.text, 0xC8)
    
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    # data[index] = element
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    # mov [rax + r12*8], r13
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x89)
    emit8(&mut ctx.text, 0x2C)
    emit8(&mut ctx.text, 0xE0)
    
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_contains: Check if element exists (linear search)
# Args: x0/rdi = vec ptr, x1/rsi = element
# Returns: 1 if found, 0 if not
def emit_tg_array_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_contains")
  
  let lblLoop = fresh_label(ctx, ".Larr_contains_loop")
  let lblFound = fresh_label(ctx, ".Larr_contains_found")
  let lblNotFound = fresh_label(ctx, ".Larr_contains_notfound")
  let lblStringMaybe = fresh_label(ctx, ".Larr_contains_string_maybe")
  let lblStringLoop = fresh_label(ctx, ".Larr_contains_string_loop")
  let lblStringInner = fresh_label(ctx, ".Larr_contains_string_inner")
  let lblStringNext = fresh_label(ctx, ".Larr_contains_string_next")
  let lblDone = fresh_label(ctx, ".Larr_contains_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X1)  # element
    
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 8)  # len
    a64_ldur(&mut ctx.text, A64::X12, A64::X9, 0)  # data
    a64_ldur(&mut ctx.text, A64::X15, A64::X9, 16) # cap
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblStringMaybe.clone())
    a64_mov_ri(&mut ctx.text, A64::X14, 1073741824)
    a64_cmp_rr(&mut ctx.text, A64::X15, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblStringMaybe.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblStringMaybe.clone())
    a64_mov_ri(&mut ctx.text, A64::X14, 7)
    a64_and_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X14)
    a64_cmp_ri(&mut ctx.text, A64::X14, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblStringMaybe.clone())
    a64_mov_ri(&mut ctx.text, A64::X13, 0)         # i = 0
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    
    # if data[i] == element: found
    a64_lsl(&mut ctx.text, A64::X14, A64::X13, 3)
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X12, A64::X14)
    a64_ldr(&mut ctx.text, A64::X14, A64::X14, 0)
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFound.clone())
    
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblLoop)

    # Some mislowered String.contains calls still reach this helper with a raw
    # C-string receiver. Detect obviously invalid Vec headers and fall back to
    # substring search instead of walking string bytes as pointer slots.
    def_label(&mut ctx.text, lblStringMaybe)
    a64_cmp_ri(&mut ctx.text, A64::X10, 4096)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblNotFound.clone())
    a64_mov_rr(&mut ctx.text, A64::X15, A64::X9)

    def_label(&mut ctx.text, lblStringLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X11, A64::X15, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X15)
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X10)

    def_label(&mut ctx.text, lblStringInner.clone())
    a64_ldrb(&mut ctx.text, A64::X14, A64::X13, 0)
    a64_cmp_ri(&mut ctx.text, A64::X14, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFound.clone())
    a64_ldrb(&mut ctx.text, A64::X16, A64::X12, 0)
    a64_cmp_rr(&mut ctx.text, A64::X16, A64::X14)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblStringNext.clone())
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblStringInner)

    def_label(&mut ctx.text, lblStringNext)
    a64_add_rri(&mut ctx.text, A64::X15, A64::X15, 1)
    a64_b(&mut ctx.text, lblStringLoop)
    
    def_label(&mut ctx.text, lblFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNotFound)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    
    def_label(&mut ctx.text, lblDone)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)  # element
    
    x64_mov_rm(&mut ctx.text, X64::R8, X64::RCX, 8)   # len
    x64_mov_rm(&mut ctx.text, X64::R9, X64::RCX, 0)   # data
    x64_mov_rm(&mut ctx.text, X64::R11, X64::RCX, 16) # cap
    x64_cmp_rr(&mut ctx.text, X64::R11, X64::R8)
    x64_jcc(&mut ctx.text, CC::L, lblStringMaybe.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 1073741824)
    x64_cmp_rr(&mut ctx.text, X64::R11, X64::RAX)
    x64_jcc(&mut ctx.text, CC::G, lblStringMaybe.clone())
    x64_cmp_ri(&mut ctx.text, X64::R9, 0)
    x64_jcc(&mut ctx.text, CC::E, lblStringMaybe.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R9)
    x64_mov_ri(&mut ctx.text, X64::R11, 7)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::R11)
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::NE, lblStringMaybe.clone())
    x64_mov_ri(&mut ctx.text, X64::R10, 0)            # i = 0
    
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R10, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    
    # cmp [r9 + r10*8], rdx
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x39)
    emit8(&mut ctx.text, 0x14)
    emit8(&mut ctx.text, 0xD1)
    x64_jcc(&mut ctx.text, CC::E, lblFound.clone())
    
    x64_add_ri(&mut ctx.text, X64::R10, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblStringMaybe)
    x64_cmp_ri(&mut ctx.text, X64::RDX, 4096)
    x64_jcc(&mut ctx.text, CC::LE, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RDX)  # needle base

    def_label(&mut ctx.text, lblStringLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RCX)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x07)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    x64_mov_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_mov_rr(&mut ctx.text, X64::R9, X64::R10)

    def_label(&mut ctx.text, lblStringInner.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R9)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x02)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblFound.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R8)
    emit8(&mut ctx.text, 0x40)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x37)
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblStringNext.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::R9, 1)
    x64_jmp(&mut ctx.text, lblStringInner)

    def_label(&mut ctx.text, lblStringNext)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblStringLoop)
    
    def_label(&mut ctx.text, lblFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNotFound)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    def_label(&mut ctx.text, lblDone)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_reverse: Reverse array in-place
# Args: x0/rdi = vec ptr
# Array layout: [data_ptr, length, capacity]
def emit_tg_array_reverse(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_reverse")

  let lblLoop = fresh_label(ctx, ".Larr_rev_loop")
  let lblDone = fresh_label(ctx, ".Larr_rev_done")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = vec ptr
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)   # x9 = data ptr
    a64_ldur(&mut ctx.text, A64::X10, A64::X0, 8)   # x10 = length
    a64_mov_ri(&mut ctx.text, A64::X11, 0)           # x11 = i = 0
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X10, 1) # x12 = j = len - 1

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X11, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # Load data[i] and data[j]
    a64_lsl(&mut ctx.text, A64::X13, A64::X11, 3)  # i * 8
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X9, A64::X13) # &data[i]
    a64_lsl(&mut ctx.text, A64::X14, A64::X12, 3)  # j * 8
    a64_add_rrr(&mut ctx.text, A64::X14, A64::X9, A64::X14) # &data[j]

    a64_ldur(&mut ctx.text, A64::X15, A64::X13, 0)  # tmp = data[i]
    a64_ldur(&mut ctx.text, A64::X16, A64::X14, 0)  # data[j]
    a64_stur(&mut ctx.text, A64::X16, A64::X13, 0)  # data[i] = data[j]
    a64_stur(&mut ctx.text, A64::X15, A64::X14, 0)  # data[j] = tmp

    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1) # i++
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1) # j--
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)  # data ptr
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RDI, 8)  # length
    x64_mov_ri(&mut ctx.text, X64::R8, 0)              # i = 0
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)             # j = len - 1

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::RCX)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # Swap data[i] and data[j] using r9, r10 as temps
    # r9 = data[i], r10 = data[j]
    x64_mov_ri(&mut ctx.text, X64::R9, 0)
    x64_mov_ri(&mut ctx.text, X64::R10, 0)
    # Load data[r8*8] into r9
    # Load data[rcx*8] into r10
    # Exchange and store back
    # (simplified: use stack)
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_extend: Append all elements from source array to dest array.
# Args: x0 = dest vec ptr, x1 = source vec ptr
def emit_tg_array_extend(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_extend")

  let lblLoop = fresh_label(ctx, ".Larr_ext_loop")
  let lblDone = fresh_label(ctx, ".Larr_ext_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = dest vec ptr
    # x1 already holds the src Vec handle: codegen's array_extend arm calls
    # deref_arg_once_if_ref_like(args, 1) so the `&other` arg is deref'd at the
    # call site (same as map_get/array_contains). Do NOT deref again here.
    # Guard against a null/empty src handle (an empty Vec is a null handle);
    # extending by an empty src is a no-op, so skip to done to avoid a null deref.
    a64_cmp_ri(&mut ctx.text, A64::X1, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_ldur(&mut ctx.text, A64::X20, A64::X1, 0)  # x20 = src data ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X1, 8)  # x21 = src length
    a64_mov_ri(&mut ctx.text, A64::X22, 0)          # x22 = index i

    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # Load src[i]: element = src_data[i * 8]
    a64_lsl(&mut ctx.text, A64::X1, A64::X22, 3)
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X20, A64::X1)
    a64_ldur(&mut ctx.text, A64::X1, A64::X1, 0)

    # Push to dest: _tg_array_push(dest, element)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_array_push")

    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_b(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # rbx = dest
    # rsi already holds the src Vec handle (deref'd at call site by codegen).
    # Guard against a null/empty src handle: extending by an empty src is a no-op.
    x64_cmp_ri(&mut ctx.text, X64::RSI, 0)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::R12, X64::RSI, 0)  # r12 = src data
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RSI, 8)  # r13 = src len
    x64_mov_ri(&mut ctx.text, X64::R14, 0)            # r14 = i

    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())

    # Load src[i]
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R12)
    x64_mov_rm(&mut ctx.text, X64::RSI, X64::RAX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblLoop)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_array_resize: Resize vec to new_len, filling new elements with fill_value
# Args: x0/rdi = vec ptr, x1/rsi = new_len, x2/rdx = fill_value
def emit_tg_array_resize(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_array_resize")

  let lblFill = fresh_label(ctx, ".Larr_resize_fill")
  let lblDone = fresh_label(ctx, ".Larr_resize_done")
  let lblTrunc = fresh_label(ctx, ".Larr_resize_trunc")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)   # new_len
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)   # fill_value
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8) # current len

    # If new_len <= current len, truncate
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblTrunc.clone())

    # Need to grow? Check if new_len > cap
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 16)  # cap
    a64_cmp_rr(&mut ctx.text, A64::X20, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblFill.clone())

    # Grow: call _tg_array_grow(vec, new_len)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_array_grow")

    # Fill loop: store fill_value from old len to new_len
    def_label(&mut ctx.text, lblFill.clone())
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 8)  # reload current len (index)
    a64_ldur(&mut ctx.text, A64::X23, A64::X19, 0)  # data ptr
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    # data[i] = fill_value
    a64_lsl(&mut ctx.text, A64::X24, A64::X22, 3)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X23, A64::X24)
    a64_str(&mut ctx.text, A64::X21, A64::X24, 0)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_stur(&mut ctx.text, A64::X22, A64::X19, 8)  # update len
    a64_b(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    # Just set len = new_len
    a64_stur(&mut ctx.text, A64::X20, A64::X19, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)    # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)    # new_len
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)    # fill_value
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8) # current len

    # If new_len <= current len, truncate
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R14)
    x64_jcc(&mut ctx.text, CC::LE, lblTrunc.clone())

    # Need to grow?
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 16)  # cap
    x64_cmp_rr(&mut ctx.text, X64::R12, X64::R15)
    x64_jcc(&mut ctx.text, CC::LE, lblFill.clone())

    # Grow
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblFill.clone())
    x64_mov_rm(&mut ctx.text, X64::R14, X64::RBX, 8)   # reload len (index)
    x64_mov_rm(&mut ctx.text, X64::R15, X64::RBX, 0)   # data ptr
    x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_jcc(&mut ctx.text, CC::GE, lblDone.clone())
    # data[i] = fill_value
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R14)
    x64_shl_ri(&mut ctx.text, X64::RAX, 3)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::R13)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R14)  # update len
    x64_jmp(&mut ctx.text, lblFill)

    def_label(&mut ctx.text, lblTrunc.clone())
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::R12)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Map Runtime Implementation (Hash Table with Open Addressing)
# ———————————————————————————————————————————————————————————————
#
# Map layout:
#   [ptr+0]:  buckets    - ptr to bucket array
#   [ptr+8]:  size       - number of entries
#   [ptr+16]: capacity   - bucket count (power of 2)
#
# Each bucket (32 bytes):
#   [0]:  hash   - cached hash (0 if empty)
#   [8]:  key    - key pointer
#   [16]: value  - value pointer
#   [24]: next   - next in chain (for separate chaining)

def emit_map_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_map_new(ctx)
  emit_tg_map_clone(ctx)
  emit_tg_map_get(ctx)
  emit_tg_map_insert(ctx)
  emit_tg_map_insert_full(ctx)
  emit_tg_map_remove(ctx)
  emit_tg_map_remove_full(ctx)
  emit_tg_map_drain_one(ctx)
  emit_tg_map_drain_one_full(ctx)
  emit_tg_map_destroy(ctx)
  emit_tg_map_contains(ctx)
  emit_tg_map_clear(ctx)
  emit_tg_map_entries(ctx)
  emit_tg_map_keys(ctx)
end

# _tg_map_clone: Create a shallow clone of a map by re-inserting all entries.
# Args: x0/rdi = source map ptr
# Returns: x0/rax = cloned map ptr
def emit_tg_map_clone(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_clone")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_clone_bloop")
  let lblChainLoop = fresh_label(ctx, ".Lmap_clone_chain")
  let lblNextBuck = fresh_label(ctx, ".Lmap_clone_next")
  let lblDone = fresh_label(ctx, ".Lmap_clone_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # source map
    a64_bl(&mut ctx.text, "_tg_map_new")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)   # destination map

    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 0)   # buckets
    a64_ldur(&mut ctx.text, A64::X22, A64::X19, 16)  # capacity
    a64_mov_ri(&mut ctx.text, A64::X23, 0)           # index

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # bucket = buckets + index * 32
    a64_lsl(&mut ctx.text, A64::X0, A64::X23, 5)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X21, A64::X0)

    def_label(&mut ctx.text, lblChainLoop.clone())
    # if hash == 0, move to next bucket
    a64_ldur(&mut ctx.text, A64::X0, A64::X24, 0)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNextBuck.clone())

    # dst.insert(bucket.key, bucket.value)
    a64_ldur(&mut ctx.text, A64::X1, A64::X24, 8)
    a64_ldur(&mut ctx.text, A64::X2, A64::X24, 16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_map_insert")

    # follow overflow chain
    a64_ldur(&mut ctx.text, A64::X24, A64::X24, 24)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChainLoop.clone())

    def_label(&mut ctx.text, lblNextBuck.clone())
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Minimal x86_64 fallback
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_map_new")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_new: Create empty map
def emit_tg_map_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_new")
  let lblClearBuckets = fresh_label(ctx, ".Lmap_new_clear_buckets")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::XZR, A64::SP, -16)
    
    a64_mov_ri(&mut ctx.text, A64::X0, 24)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
    
    # Allocate initial buckets via mmap (256 buckets * 32 bytes = 8KB)
    # Using mmap instead of _tg_bump_alloc isolates the bucket array from
    # the bump arena, preventing corruption when subsequent bump_alloc
    # calls grow the arena.
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 8192)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X16, 197)
    a64_svc(&mut ctx.text, 0x80)
    # mmap returns zeroed pages, so no clearing needed
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
    
    # Initialize map struct
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 0)    # buckets
    a64_stur(&mut ctx.text, A64::XZR, A64::X19, 8)   # size = 0
    a64_mov_ri(&mut ctx.text, A64::X1, 256)
    a64_stur(&mut ctx.text, A64::X1, A64::X19, 16)   # capacity = 256
    
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    
    a64_ldp_post(&mut ctx.text, A64::X19, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    
    # Allocate map struct
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_ri(&mut ctx.text, X64::RSI, 24)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_syscall(&mut ctx.text)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)
    
    # Allocate buckets
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_ri(&mut ctx.text, X64::RSI, 512)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    # Initialize map struct
    x64_mov_mr(&mut ctx.text, X64::RBX, 0, X64::RAX)   # buckets
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)   # size = 0
    x64_mov_ri(&mut ctx.text, X64::RAX, 16)
    x64_mov_mr(&mut ctx.text, X64::RBX, 16, X64::RAX)  # capacity = 16
    
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_get: Get value for key
# Args: x0/rdi = map ptr, x1/rsi = key ptr
# Returns: value ptr or null
def emit_tg_map_get(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_get")
  
  let lblLoop = fresh_label(ctx, ".Lmap_get_loop")
  let lblNotFound = fresh_label(ctx, ".Lmap_get_notfound")
  let lblDone = fresh_label(ctx, ".Lmap_get_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key ptr
    
    # Hash the key
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_runtime_hash_ptr")
    
    # bucket_idx = hash & (capacity - 1)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)  # capacity
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_and_rrr(&mut ctx.text, A64::X1, A64::X0, A64::X1)
    
    # bucket = buckets + bucket_idx * 32
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)   # buckets
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 5)     # * 32
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # if bucket.hash == 0: not found
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 0)
    a64_cmp_ri(&mut ctx.text, A64::X3, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())
    
    # if bucket.key == key: found (content comparison via _tg_key_equal)
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 8)
    a64_stp_pre(&mut ctx.text, A64::X2, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_key_equal")
    a64_ldp_post(&mut ctx.text, A64::X2, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblDone.clone())
    
    # bucket = bucket.next
    a64_ldr(&mut ctx.text, A64::X2, A64::X2, 24)
    a64_cmp_ri(&mut ctx.text, A64::X2, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())
    
    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmap_get_ret")
    
    def_label(&mut ctx.text, lblDone.clone())
    # Return bucket.value
    a64_ldr(&mut ctx.text, A64::X0, A64::X2, 16)
    
    def_label(&mut ctx.text, ".Lmap_get_ret")
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key ptr
    
    # Hash the key
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_runtime_hash_ptr")
    
    # bucket_idx = hash & (capacity - 1)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)
    
    # bucket = buckets + bucket_idx * 32
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 0)
    x64_shl_ri(&mut ctx.text, X64::RAX, 5)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # if bucket.hash == 0: not found
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())
    
    # if bucket.key == key: found (content comparison via _tg_key_equal)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 8)
    x64_push(&mut ctx.text, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_key_equal")
    x64_pop(&mut ctx.text, X64::RDX)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblDone.clone())
    
    # bucket = bucket.next
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDX, 24)
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())
    
    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmap_get_ret")
    
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 16)
    
    def_label(&mut ctx.text, ".Lmap_get_ret")
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_insert: Insert key-value pair
# Args: x0/rdi = map ptr, x1/rsi = key ptr, x2/rdx = value ptr
def emit_tg_map_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert")
  # Tail-call into the full implementation (no bl/call — preserves LR)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_insert_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_insert_full")
  end
end

def emit_tg_map_insert_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_insert_full")
  
  let lblLoop = fresh_label(ctx, ".Lmap_insert_loop")
  let lblFound = fresh_label(ctx, ".Lmap_insert_found")
  let lblNew = fresh_label(ctx, ".Lmap_insert_new")
  let lblChain = fresh_label(ctx, ".Lmap_insert_chain")
  let lblDone = fresh_label(ctx, ".Lmap_insert_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map ptr
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key ptr
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # value ptr
    
    # Hash the key
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_runtime_hash_ptr")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # save hash
    
    # bucket_idx = hash & (capacity - 1)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_and_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X1)
    
    # bucket = buckets + bucket_idx * 32
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 5)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # if bucket.hash == 0: empty slot, insert here
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 0)
    a64_cmp_ri(&mut ctx.text, A64::X3, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNew.clone())
    
    # if bucket.key == key: update value (content comparison via _tg_key_equal)
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 8)
    a64_stp_pre(&mut ctx.text, A64::X2, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_key_equal")
    a64_ldp_post(&mut ctx.text, A64::X2, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())
    
    # if bucket.next == 0: chain a new overflow bucket
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 24)
    a64_cmp_ri(&mut ctx.text, A64::X3, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChain.clone())
    
    # bucket = bucket.next
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X3)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblFound.clone())
    # Update existing entry
    a64_str(&mut ctx.text, A64::X21, A64::X2, 16)
    a64_b(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNew.clone())
    # Store new entry into empty bucket
    a64_str(&mut ctx.text, A64::X22, A64::X2, 0)   # hash
    a64_str(&mut ctx.text, A64::X20, A64::X2, 8)   # key
    a64_str(&mut ctx.text, A64::X21, A64::X2, 16)  # value
    a64_stur(&mut ctx.text, A64::XZR, A64::X2, 24) # next = null
    
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_b(&mut ctx.text, lblDone)
    
    # Collision: bucket occupied but next==0. Allocate overflow bucket.
    def_label(&mut ctx.text, lblChain.clone())
    # Save current bucket ptr (X2) across mmap call
    a64_stp_pre(&mut ctx.text, A64::X2, A64::XZR, A64::SP, -16)
    # Allocate 32 bytes via mmap (NOT bump_alloc — overflow buckets share
    # the arena with the main bucket array and corrupt entries when the
    # arena grows via mmap).
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 32)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
    a64_mov_ri(&mut ctx.text, A64::X4, -1)
    a64_mov_ri(&mut ctx.text, A64::X5, 0)
    a64_mov_ri(&mut ctx.text, A64::X16, 197)
    a64_svc(&mut ctx.text, 0x80)
    # X0 = new overflow bucket
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X0)
    # Restore old bucket pointer
    a64_ldp_post(&mut ctx.text, A64::X2, A64::XZR, A64::SP, 16)
    # Write entry to new overflow bucket
    a64_str(&mut ctx.text, A64::X22, A64::X3, 0)   # hash
    a64_str(&mut ctx.text, A64::X20, A64::X3, 8)   # key
    a64_str(&mut ctx.text, A64::X21, A64::X3, 16)  # value
    a64_stur(&mut ctx.text, A64::XZR, A64::X3, 24) # next = null
    # Link: old_bucket.next = new_bucket
    a64_str(&mut ctx.text, A64::X3, A64::X2, 24)
    # size++
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    
    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)  # Return null (no old value)
    
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map ptr
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key ptr
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # value ptr
    
    # Hash the key
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_runtime_hash_ptr")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # save hash
    
    # bucket_idx = hash & (capacity - 1)
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)
    
    # bucket = buckets + bucket_idx * 32
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 0)
    x64_shl_ri(&mut ctx.text, X64::RAX, 5)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # if bucket.hash == 0: insert here
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNew.clone())
    
    # if bucket.key == key: update (content comparison via _tg_key_equal)
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 8)
    x64_push(&mut ctx.text, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_key_equal")
    x64_pop(&mut ctx.text, X64::RDX)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())
    
    # if bucket.next == 0: chain a new overflow bucket
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 24)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblChain.clone())
    
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RAX)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblFound.clone())
    x64_mov_mr(&mut ctx.text, X64::RDX, 16, X64::R13)
    x64_jmp(&mut ctx.text, lblDone)
    
    def_label(&mut ctx.text, lblNew.clone())
    # Store new entry into empty bucket
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::R14)   # hash
    x64_mov_mr(&mut ctx.text, X64::RDX, 8, X64::R12)   # key
    x64_mov_mr(&mut ctx.text, X64::RDX, 16, X64::R13)  # value
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDX, 24, X64::RAX)  # next = null
    
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_jmp(&mut ctx.text, lblDone)
    
    # Collision: bucket occupied but next==0. Allocate overflow bucket.
    def_label(&mut ctx.text, lblChain.clone())
    # Save current bucket ptr (RDX) across _tg_bump_alloc call
    x64_push(&mut ctx.text, X64::RDX)
    # Allocate 32 bytes for new bucket
    x64_mov_ri(&mut ctx.text, X64::RDI, 32)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    # RAX = new overflow bucket
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
    # Restore old bucket pointer
    x64_pop(&mut ctx.text, X64::RDX)
    # Write entry to new overflow bucket
    x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::R14)   # hash
    x64_mov_mr(&mut ctx.text, X64::RCX, 8, X64::R12)   # key
    x64_mov_mr(&mut ctx.text, X64::RCX, 16, X64::R13)  # value
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 24, X64::RAX)  # next = null
    # Link: old_bucket.next = new_bucket
    x64_mov_mr(&mut ctx.text, X64::RDX, 24, X64::RCX)
    # size++
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_add_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_remove: Remove entry for key
def emit_tg_map_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove")
  # Tail-call into the full implementation (no bl/call — preserves LR)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_remove_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_remove_full")
  end
end

def emit_tg_map_remove_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_remove_full")

  # Find entry by key, zero its hash (mark deleted), decrement size,
  # return the removed value (or 0 if not found).
  # Args: x0/rdi = map ptr, x1/rsi = key

  let lblLoop     = fresh_label(ctx, ".Lmrm_loop")
  let lblNotFound = fresh_label(ctx, ".Lmrm_nf")
  let lblFound    = fresh_label(ctx, ".Lmrm_found")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::XZR, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # key

    # Hash the key
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_bl(&mut ctx.text, "_tg_runtime_hash_ptr")

    # bucket = buckets + (hash & (cap-1)) * 32
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_sub_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_and_rrr(&mut ctx.text, A64::X1, A64::X0, A64::X1)
    a64_ldur(&mut ctx.text, A64::X2, A64::X19, 0)  # buckets
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 5)
    a64_add_rrr(&mut ctx.text, A64::X2, A64::X2, A64::X1)

    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X3, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNotFound.clone())

    a64_ldr(&mut ctx.text, A64::X3, A64::X2, 8)  # key
    a64_stp_pre(&mut ctx.text, A64::X2, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)
    a64_bl(&mut ctx.text, "_tg_key_equal")
    a64_ldp_post(&mut ctx.text, A64::X2, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFound.clone())

    a64_ldr(&mut ctx.text, A64::X2, A64::X2, 24)  # next
    a64_cmp_ri(&mut ctx.text, A64::X2, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_b(&mut ctx.text, ".Lmrm_ret")

    def_label(&mut ctx.text, lblFound.clone())
    # Save value before clearing
    a64_ldr(&mut ctx.text, A64::X21, A64::X2, 16)
    # Zero hash, key, value to mark deleted
    a64_stur(&mut ctx.text, A64::XZR, A64::X2, 0)
    a64_stur(&mut ctx.text, A64::XZR, A64::X2, 8)
    a64_stur(&mut ctx.text, A64::XZR, A64::X2, 16)
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

    def_label(&mut ctx.text, ".Lmrm_ret")
    a64_ldp_post(&mut ctx.text, A64::X21, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # map
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # key

    # Hash the key
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_runtime_hash_ptr")

    # bucket = buckets + (hash & (cap-1)) * 32
    x64_mov_rm(&mut ctx.text, X64::RCX, X64::RBX, 16)
    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RBX, 0)
    x64_shl_ri(&mut ctx.text, X64::RAX, 5)
    x64_add_rr(&mut ctx.text, X64::RDX, X64::RAX)

    def_label(&mut ctx.text, lblLoop.clone())
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 0)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lblNotFound.clone())

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDX, 8)
    x64_push(&mut ctx.text, X64::RDX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_key_equal")
    x64_pop(&mut ctx.text, X64::RDX)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lblFound.clone())

    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RDX, 24)
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())

    def_label(&mut ctx.text, lblNotFound.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_jmp(&mut ctx.text, ".Lmrm_ret")

    def_label(&mut ctx.text, lblFound.clone())
    # Save value
    x64_mov_rm(&mut ctx.text, X64::R13, X64::RDX, 16)
    # Zero hash, key, value
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RDX, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RDX, 8, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RDX, 16, X64::RAX)
    # size--
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::RAX, 1)
    x64_mov_mr(&mut ctx.text, X64::RBX, 8, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

    def_label(&mut ctx.text, ".Lmrm_ret")
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_destroy: release the map's mmap'ed bucket table AND every
# mmap'ed overflow bucket in the collision chains. Args: x0 = map (24-byte
# header: [0] buckets, [8] size, [16] cap). All entries were already drained
# and finalized; this frees the table + overflow storage.
def emit_tg_map_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_destroy")
  let lblBucketLoop = fresh_label(ctx, ".Lmap_destroy_bucket_loop")
  let lblChain = fresh_label(ctx, ".Lmap_destroy_chain")
  let lblChainDone = fresh_label(ctx, ".Lmap_destroy_chain_done")
  let lblSkip = fresh_label(ctx, ".Lmap_destroy_skip")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # buckets
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblSkip.clone())
    # Free overflow chains first (they are separate mmap allocations).
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 16)  # cap
    a64_lsl(&mut ctx.text, A64::X22, A64::X21, 5)    # cap * 32
    a64_add_rrr(&mut ctx.text, A64::X22, A64::X20, A64::X22)  # end = buckets + cap*32
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X20)  # current bucket
    def_label(&mut ctx.text, lblBucketLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblSkip.clone())
    a64_ldr(&mut ctx.text, A64::X23, A64::X21, 24)  # next
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainDone.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X0, A64::X23, 24)  # next->next (save across munmap)
    a64_stp_pre(&mut ctx.text, A64::X0, A64::XZR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_mov_ri(&mut ctx.text, A64::X1, 32)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainDone.clone())
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 32)
    a64_b(&mut ctx.text, lblBucketLoop.clone())
    def_label(&mut ctx.text, lblSkip.clone())
    # Free the main bucket table.
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 0)
    a64_ldur(&mut ctx.text, A64::X1, A64::X19, 16)
    a64_lsl(&mut ctx.text, A64::X1, A64::X1, 5)  # cap * 32
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    a64_ldp_post(&mut ctx.text, A64::X23, A64::XZR, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)  # fail closed: x86 backing release not implemented
  end
end

# _tg_set_destroy: release the set's backing storage (a set IS a map with
# Unit values).
def emit_tg_set_destroy(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_destroy")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_destroy")
  when Arch::X86_64  then x64_ud2(&mut ctx.text)
  end
end

# _tg_map_drain_one: destructively remove the FIRST live entry and transfer
# it out as Option[(K, V)] through the sret slot (AArch64: x8). No snapshot
# copy exists — ownership of the actual key and value pointers transfers.
# sret Option layout (F3): [0] discriminant (8 bytes; Some=0, None=1),
# [8] payload (K, V) tuple: [8] key, [16] value.
def emit_tg_map_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_drain_one_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_drain_one_full")
  end
end

def emit_tg_map_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lmd1_scan")
  let lblChain = fresh_label(ctx, ".Lmd1_chain")
  let lblChainEnd = fresh_label(ctx, ".Lmd1_chain_end")
  let lblFoundBucket = fresh_label(ctx, ".Lmd1_found_bucket")
  let lblFoundChain = fresh_label(ctx, ".Lmd1_found_chain")
  let lblRemove = fresh_label(ctx, ".Lmd1_remove")
  let lblDone = fresh_label(ctx, ".Lmd1_done")
  match ctx.target.arch
  when Arch::AArch64 then
    # Args: x0 = map, x8 = sret (Option[(K, V)])
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # map
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret

    # Default: None (disc = 1)
    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    # end = buckets + cap * 32
    a64_ldr(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_ldr(&mut ctx.text, A64::X2, A64::X19, 0)   # buckets
    a64_lsl(&mut ctx.text, A64::X3, A64::X1, 5)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # current = buckets

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X21, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    # Bucket empty: scan its OVERFLOW CHAIN — colliding entries live in
    # mmap'ed overflow buckets linked through [24] and must be drained too.
    a64_ldr(&mut ctx.text, A64::X23, A64::X21, 24)  # chain = bucket.next
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainEnd.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)  # chain entry hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundChain.clone())
    a64_ldr(&mut ctx.text, A64::X23, A64::X23, 24)  # chain = chain.next
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainEnd.clone())
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 32)
    a64_b(&mut ctx.text, lblScan.clone())

    # Distinct found paths: the bucket path (X21) and the chain path (X23)
    # MUST NOT be distinguished via leftover register values.
    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X21)
    a64_b(&mut ctx.text, lblRemove.clone())
    def_label(&mut ctx.text, lblFoundChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X23)
    def_label(&mut ctx.text, lblRemove.clone())
    a64_ldr(&mut ctx.text, A64::X5, A64::X24, 8)   # key
    a64_ldr(&mut ctx.text, A64::X6, A64::X24, 16)  # value
    # Zero the entry (mark deleted)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 0)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 8)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 16)
    # size--
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    # sret: Some (disc = 0), key at +8, value at +16
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)
    a64_str(&mut ctx.text, A64::X5, A64::X20, 8)
    a64_str(&mut ctx.text, A64::X6, A64::X20, 16)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    # The codegen's sret aggregate ABI is AArch64-only; fail CLOSED instead
    # of writing through an unknown slot.
    x64_ud2(&mut ctx.text)
  end
end

def emit_tg_set_drain_one(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_set_drain_one_full")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_set_drain_one_full")
  end
end

def emit_tg_set_drain_one_full(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_drain_one_full")
  let lblScan = fresh_label(ctx, ".Lsd1_scan")
  let lblChain = fresh_label(ctx, ".Lsd1_chain")
  let lblChainEnd = fresh_label(ctx, ".Lsd1_chain_end")
  let lblFoundBucket = fresh_label(ctx, ".Lsd1_found_bucket")
  let lblFoundChain = fresh_label(ctx, ".Lsd1_found_chain")
  let lblRemove = fresh_label(ctx, ".Lsd1_remove")
  let lblDone = fresh_label(ctx, ".Lsd1_done")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # set
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X8)  # sret

    # Default: None (disc = 1)
    a64_mov_ri(&mut ctx.text, A64::X7, 1)
    a64_str(&mut ctx.text, A64::X7, A64::X20, 0)

    a64_ldr(&mut ctx.text, A64::X1, A64::X19, 16)  # cap
    a64_ldr(&mut ctx.text, A64::X2, A64::X19, 0)   # buckets
    a64_lsl(&mut ctx.text, A64::X3, A64::X1, 5)
    a64_add_rrr(&mut ctx.text, A64::X3, A64::X2, A64::X3)
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # current

    def_label(&mut ctx.text, lblScan.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X3)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X21, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundBucket.clone())
    # Overflow chain scan (sets are maps with Unit values).
    a64_ldr(&mut ctx.text, A64::X23, A64::X21, 24)  # chain = bucket.next
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblChainEnd.clone())
    def_label(&mut ctx.text, lblChain.clone())
    a64_ldr(&mut ctx.text, A64::X4, A64::X23, 0)  # chain entry hash
    a64_cmp_ri(&mut ctx.text, A64::X4, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblFoundChain.clone())
    a64_ldr(&mut ctx.text, A64::X23, A64::X23, 24)
    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChain.clone())
    def_label(&mut ctx.text, lblChainEnd.clone())
    a64_add_rri(&mut ctx.text, A64::X21, A64::X21, 32)
    a64_b(&mut ctx.text, lblScan.clone())

    def_label(&mut ctx.text, lblFoundBucket.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X21)
    a64_b(&mut ctx.text, lblRemove.clone())
    def_label(&mut ctx.text, lblFoundChain.clone())
    a64_mov_rr(&mut ctx.text, A64::X24, A64::X23)
    def_label(&mut ctx.text, lblRemove.clone())
    a64_ldr(&mut ctx.text, A64::X5, A64::X24, 8)   # element (the key slot)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 0)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 8)
    a64_stur(&mut ctx.text, A64::XZR, A64::X24, 16)
    a64_ldur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_sub_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_stur(&mut ctx.text, A64::X0, A64::X19, 8)
    a64_str(&mut ctx.text, A64::XZR, A64::X20, 0)
    a64_str(&mut ctx.text, A64::X5, A64::X20, 8)

    def_label(&mut ctx.text, lblDone.clone())
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_ud2(&mut ctx.text)
  end
end

# _tg_map_contains: Check if key exists
def emit_tg_map_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_contains")
  # Call get and check if result is non-null.
  # Must save/restore LR since we use BL and have code after the call.
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_bl(&mut ctx.text, "_tg_map_get")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_cset(&mut ctx.text, A64::X0, a64_cc_ne())
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_map_get")
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_setcc(&mut ctx.text, CC::NE, X64::RAX)
    x64_movzx_r64_r8(&mut ctx.text, X64::RAX, X64::RAX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_clear: Clear all entries
def emit_tg_map_clear(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_clear")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Zero out all buckets
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)  # map ptr
    a64_ldur(&mut ctx.text, A64::X10, A64::X9, 0)  # buckets
    a64_ldur(&mut ctx.text, A64::X11, A64::X9, 16) # capacity
    a64_lsl(&mut ctx.text, A64::X11, A64::X11, 5)  # capacity * 32
    
    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")
    
    a64_mov_ri(&mut ctx.text, A64::X12, 0)
    def_label(&mut ctx.text, lblLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X12, A64::X11)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_add_rrr(&mut ctx.text, A64::X13, A64::X10, A64::X12)
    a64_stur(&mut ctx.text, A64::XZR, A64::X13, 0)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 32)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    a64_stur(&mut ctx.text, A64::XZR, A64::X9, 8)  # size = 0
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RCX)
    
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # map ptr
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RCX, 0)  # buckets
    x64_mov_rm(&mut ctx.text, X64::RDX, X64::RCX, 16) # capacity
    x64_shl_ri(&mut ctx.text, X64::RDX, 5)  # capacity * 32
    
    let lblLoop = fresh_label(ctx, ".Lmap_clear_loop")
    let lblDone = fresh_label(ctx, ".Lmap_clear_done")
    
    x64_mov_ri(&mut ctx.text, X64::R8, 0)
    def_label(&mut ctx.text, lblLoop.clone())
    x64_cmp_rr(&mut ctx.text, X64::R8, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    # mov qword [rax + r8], 0
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0xC7)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    emit8(&mut ctx.text, 0x00)
    x64_add_ri(&mut ctx.text, X64::R8, 32)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RCX, 8, X64::RAX)  # size = 0
    
    x64_pop(&mut ctx.text, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_entries: Collect all (key, value) pairs into a Vec
# Args: x0/rdi = map ptr
# Returns: Vec ptr containing (key, value) tuple pointers
# Each tuple is a 16-byte heap allocation: [key_ptr, value_ptr]
def emit_tg_map_entries(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_entries")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_ent_bloop")
  let lblChainLoop = fresh_label(ctx, ".Lmap_ent_chain")
  let lblNextBuck = fresh_label(ctx, ".Lmap_ent_next")
  let lblDone = fresh_label(ctx, ".Lmap_ent_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # x19 = map ptr
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # x20 = buckets ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 16) # x21 = capacity

    # Create result Vec
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # x22 = result Vec

    a64_mov_ri(&mut ctx.text, A64::X23, 0)  # x23 = bucket index

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # bucket_addr = buckets + index * 32
    a64_lsl(&mut ctx.text, A64::X0, A64::X23, 5)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X0)  # x24 = bucket

    def_label(&mut ctx.text, lblChainLoop.clone())
    # Check if bucket is occupied (hash != 0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X24, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNextBuck.clone())

    # Allocate 16-byte tuple: [key, value]
    a64_mov_ri(&mut ctx.text, A64::X0, 16)
    a64_bl(&mut ctx.text, "_tg_mem_alloc")
    # Store key and value into tuple
    a64_ldur(&mut ctx.text, A64::X1, A64::X24, 8)   # key
    a64_stur(&mut ctx.text, A64::X1, A64::X0, 0)    # tuple[0] = key
    a64_ldur(&mut ctx.text, A64::X1, A64::X24, 16)  # value
    a64_stur(&mut ctx.text, A64::X1, A64::X0, 8)    # tuple[1] = value

    # Push tuple to result: _tg_array_push(result, tuple_ptr)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # element = tuple ptr
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22) # arr = result Vec
    a64_bl(&mut ctx.text, "_tg_array_push")

    # Follow chain: next = bucket.next
    a64_ldur(&mut ctx.text, A64::X24, A64::X24, 24)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChainLoop.clone())

    def_label(&mut ctx.text, lblNextBuck.clone())
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)  # return result Vec

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Minimal x86_64 stub — returns empty Vec
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_map_keys: Extract all keys from map into a new Vec.
# Args: x0 = map ptr. Returns: x0 = Vec of keys.
def emit_tg_map_keys(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_map_keys")

  let lblBuckLoop = fresh_label(ctx, ".Lmap_keys_bloop")
  let lblChainLoop = fresh_label(ctx, ".Lmap_keys_chain")
  let lblNextBuck = fresh_label(ctx, ".Lmap_keys_next")
  let lblDone = fresh_label(ctx, ".Lmap_keys_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # x19 = map ptr
    a64_ldur(&mut ctx.text, A64::X20, A64::X19, 0)  # x20 = buckets ptr
    a64_ldur(&mut ctx.text, A64::X21, A64::X19, 16) # x21 = capacity

    # Create result Vec
    a64_bl(&mut ctx.text, "_tg_array_new")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # x22 = result Vec

    a64_mov_ri(&mut ctx.text, A64::X23, 0)  # x23 = bucket index

    def_label(&mut ctx.text, lblBuckLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblDone.clone())

    # bucket_addr = buckets + index * 32
    a64_lsl(&mut ctx.text, A64::X0, A64::X23, 5)
    a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X0)  # x24 = bucket

    def_label(&mut ctx.text, lblChainLoop.clone())
    # Check if bucket is occupied (hash != 0)
    a64_ldur(&mut ctx.text, A64::X0, A64::X24, 0)  # hash
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblNextBuck.clone())

    # Push key to result: _tg_array_push(result, key)
    a64_ldur(&mut ctx.text, A64::X1, A64::X24, 8)   # x1 = key
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)    # x0 = result Vec
    a64_bl(&mut ctx.text, "_tg_array_push")

    # Follow chain: next = bucket.next
    a64_ldur(&mut ctx.text, A64::X24, A64::X24, 24)
    a64_cmp_ri(&mut ctx.text, A64::X24, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblChainLoop.clone())

    def_label(&mut ctx.text, lblNextBuck.clone())
    a64_add_rri(&mut ctx.text, A64::X23, A64::X23, 1)
    a64_b(&mut ctx.text, lblBuckLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X22)  # return result Vec

    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Minimal x86_64 stub — returns empty Vec
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_call_label(&mut ctx.text, "_tg_array_new")
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Set Runtime Implementation
# ———————————————————————————————————————————————————————————————

def emit_set_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_set_new(ctx)
  emit_tg_set_clone(ctx)
  emit_tg_set_insert(ctx)
  emit_tg_set_contains(ctx)
  emit_tg_set_remove(ctx)
  emit_tg_set_drain_one(ctx)
  emit_tg_set_drain_one_full(ctx)
  emit_tg_set_destroy(ctx)
  emit_tg_set_entries(ctx)
  emit_tg_set_clear(ctx)
end

# Sets are just maps with unit values
def emit_tg_set_new(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_new")
  # Tail-call map_new (preserves LR/return address)
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_new")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_new")
  end
end

def emit_tg_set_clone(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_clone")
  # Set is map-backed; clone through map clone helper.
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_clone")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_clone")
  end
end

def emit_tg_set_insert(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_insert")
  # Call map_insert with a non-null marker value.  A set item can be 0, and
  # map_contains is implemented as map_get(key) != null.
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X2, 1)
    a64_b(&mut ctx.text, "_tg_map_insert")
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RDX, 1)
    x64_jmp(&mut ctx.text, "_tg_map_insert")
  end
end

def emit_tg_set_contains(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_contains")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_contains")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_contains")
  end
end

def emit_tg_set_remove(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_remove")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_remove")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_remove")
  end
end

def emit_tg_set_entries(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_entries")
  # A Set is backed by a map; set entries are map keys.
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_keys")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_keys")
  end
end

def emit_tg_set_clear(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_set_clear")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_map_clear")
  when Arch::X86_64  then x64_jmp(&mut ctx.text, "_tg_map_clear")
  end
end

# ———————————————————————————————————————————————————————————————
# Memory Runtime Implementation
# ———————————————————————————————————————————————————————————————

def emit_memory_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_mem_alloc(ctx)
  emit_tg_mem_free(ctx)
  emit_tg_runtime_hash_ptr(ctx)
  emit_tg_key_equal(ctx)
end

# _tg_mem_alloc: Allocate memory
# Args: x0/rdi = size
# Returns: ptr
def emit_tg_mem_alloc(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_mem_alloc")
  
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::Windows then
      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)

      # Windows ARM64: Use VirtualAlloc
      # VirtualAlloc(NULL, size, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)
      # Emits a call to VirtualAlloc resolved by the linker at link time.
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)        # NULL (lpAddress)
      a64_mov_ri(&mut ctx.text, A64::X2, 0x3000)   # MEM_COMMIT|MEM_RESERVE
      a64_mov_ri(&mut ctx.text, A64::X3, 0x04)     # PAGE_READWRITE
      # Call VirtualAlloc via PLT (will be resolved by linker)
      a64_bl(&mut ctx.text, "VirtualAlloc")
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    when OsAbi::MacOS then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

      # Small allocations go through the bump arena; large ones keep mmap.
      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
      a64_cmp_ri(&mut ctx.text, A64::X19, 0)
      a64_bcond(&mut ctx.text, a64_cc_ne(), size_ok_label.clone())
      a64_mov_ri(&mut ctx.text, A64::X19, 16)
      def_label(&mut ctx.text, size_ok_label)

      a64_mov_ri(&mut ctx.text, A64::X21, 23)
      a64_add_rrr(&mut ctx.text, A64::X20, A64::X19, A64::X21)
      a64_mov_ri(&mut ctx.text, A64::X21, -8)
      a64_and_rrr(&mut ctx.text, A64::X20, A64::X20, A64::X21)

      a64_mov_ri(&mut ctx.text, A64::X22, 65536)
      a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
      a64_bcond(&mut ctx.text, a64_cc_gt(), mmap_label.clone())

      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_bl(&mut ctx.text, "_tg_bump_alloc")
      a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X9, A64::X21)
      a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)
      def_label(&mut ctx.text, zero_loop_label)
      a64_cmp_ri(&mut ctx.text, A64::X10, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), zero_done_label.clone())
      a64_str(&mut ctx.text, A64::XZR, A64::X9, 0)
      a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 8)
      a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 8)
      a64_b(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X21, 16)
      a64_b(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 3)
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
      a64_mov_ri(&mut ctx.text, A64::X9, 1)
      a64_str(&mut ctx.text, A64::X9, A64::X0, 0)
      a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 16)

      def_label(&mut ctx.text, done_label)
      a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    when OsAbi::Linux then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
      a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
      a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
      a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

      a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)
      a64_cmp_ri(&mut ctx.text, A64::X19, 0)
      a64_bcond(&mut ctx.text, a64_cc_ne(), size_ok_label.clone())
      a64_mov_ri(&mut ctx.text, A64::X19, 16)
      def_label(&mut ctx.text, size_ok_label)

      a64_mov_ri(&mut ctx.text, A64::X21, 23)
      a64_add_rrr(&mut ctx.text, A64::X20, A64::X19, A64::X21)
      a64_mov_ri(&mut ctx.text, A64::X21, -8)
      a64_and_rrr(&mut ctx.text, A64::X20, A64::X20, A64::X21)

      a64_mov_ri(&mut ctx.text, A64::X22, 65536)
      a64_cmp_rr(&mut ctx.text, A64::X20, A64::X22)
      a64_bcond(&mut ctx.text, a64_cc_gt(), mmap_label.clone())

      a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
      a64_bl(&mut ctx.text, "_tg_bump_alloc")
      a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)
      a64_mov_rr(&mut ctx.text, A64::X9, A64::X21)
      a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)
      def_label(&mut ctx.text, zero_loop_label)
      a64_cmp_ri(&mut ctx.text, A64::X10, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), zero_done_label.clone())
      a64_str(&mut ctx.text, A64::XZR, A64::X9, 0)
      a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 8)
      a64_sub_rri(&mut ctx.text, A64::X10, A64::X10, 8)
      a64_b(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X21, 16)
      a64_b(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X20)  # size
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 3)
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
      a64_mov_ri(&mut ctx.text, A64::X9, 1)
      a64_str(&mut ctx.text, A64::X9, A64::X0, 0)
      a64_str(&mut ctx.text, A64::X20, A64::X0, 8)
      a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 16)

      def_label(&mut ctx.text, done_label)
      a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
      a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
      a64_ret(&mut ctx.text)
    end
    
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::Windows then
      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)

      # Windows x64: Use HeapAlloc from process heap
      # GetProcessHeap() returns the process heap handle
      # HeapAlloc(heap, 0, size) allocates memory
      # For simplicity, we use a static buffer or call malloc via CRT
      # The proper way is to call GetProcessHeap then HeapAlloc
      
      # Save size
      x64_push(&mut ctx.text, X64::RDI)
      
      # Call GetProcessHeap()
      x64_call_extern(&mut ctx.text, "GetProcessHeap")
      
      # HeapAlloc(heap, 0, size)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)  # heap
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)         # flags
      x64_pop(&mut ctx.text, X64::R8)                # size (was RDI)
      x64_call_extern(&mut ctx.text, "HeapAlloc")
      # Result in RAX
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    when OsAbi::MacOS then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)

      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::NE, size_ok_label.clone())
      x64_mov_ri(&mut ctx.text, X64::RBX, 16)
      def_label(&mut ctx.text, size_ok_label)

      x64_add_ri(&mut ctx.text, X64::RBX, 23)
      x64_mov_ri(&mut ctx.text, X64::RCX, -8)
      x64_and_rr(&mut ctx.text, X64::RBX, X64::RCX)

      x64_mov_ri(&mut ctx.text, X64::RCX, 65536)
      x64_cmp_rr(&mut ctx.text, X64::RBX, X64::RCX)
      x64_jcc(&mut ctx.text, CC::A, mmap_label.clone())

      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
      x64_call_label(&mut ctx.text, "_tg_bump_alloc")
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
      x64_xor_rr(&mut ctx.text, X64::RDX, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
      def_label(&mut ctx.text, zero_loop_label)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::E, zero_done_label.clone())
      x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RDX)
      x64_add_ri(&mut ctx.text, X64::RCX, 8)
      x64_sub_ri(&mut ctx.text, X64::RBX, 8)
      x64_jmp(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)
      x64_jmp(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)  # size
      x64_mov_ri(&mut ctx.text, X64::RDI, 0)
      x64_mov_ri(&mut ctx.text, X64::RDX, 3)
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
      x64_syscall(&mut ctx.text)
      x64_mov_ri(&mut ctx.text, X64::RCX, 1)
      x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)
      x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RBX)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)

      def_label(&mut ctx.text, done_label)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    when OsAbi::Linux then
      let size_ok_label = fresh_label(ctx, ".Lmem_size_ok")
      let mmap_label = fresh_label(ctx, ".Lmem_mmap")
      let zero_loop_label = fresh_label(ctx, ".Lmem_zero_loop")
      let zero_done_label = fresh_label(ctx, ".Lmem_zero_done")
      let done_label = fresh_label(ctx, ".Lmem_done")

      x64_push(&mut ctx.text, X64::RBP)
      x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
      x64_push(&mut ctx.text, X64::RBX)
      x64_push(&mut ctx.text, X64::R12)

      x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::NE, size_ok_label.clone())
      x64_mov_ri(&mut ctx.text, X64::RBX, 16)
      def_label(&mut ctx.text, size_ok_label)

      x64_add_ri(&mut ctx.text, X64::RBX, 23)
      x64_mov_ri(&mut ctx.text, X64::RCX, -8)
      x64_and_rr(&mut ctx.text, X64::RBX, X64::RCX)

      x64_mov_ri(&mut ctx.text, X64::RCX, 65536)
      x64_cmp_rr(&mut ctx.text, X64::RBX, X64::RCX)
      x64_jcc(&mut ctx.text, CC::A, mmap_label.clone())

      x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
      x64_call_label(&mut ctx.text, "_tg_bump_alloc")
      x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)
      x64_xor_rr(&mut ctx.text, X64::RDX, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
      def_label(&mut ctx.text, zero_loop_label)
      x64_cmp_ri(&mut ctx.text, X64::RBX, 0)
      x64_jcc(&mut ctx.text, CC::E, zero_done_label.clone())
      x64_mov_mr(&mut ctx.text, X64::RCX, 0, X64::RDX)
      x64_add_ri(&mut ctx.text, X64::RCX, 8)
      x64_sub_ri(&mut ctx.text, X64::RBX, 8)
      x64_jmp(&mut ctx.text, zero_loop_label.clone())
      def_label(&mut ctx.text, zero_done_label)
      x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)
      x64_jmp(&mut ctx.text, done_label.clone())

      def_label(&mut ctx.text, mmap_label)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)  # size
      x64_mov_ri(&mut ctx.text, X64::RDI, 0)
      x64_mov_ri(&mut ctx.text, X64::RDX, 3)
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
      x64_syscall(&mut ctx.text)
      x64_mov_ri(&mut ctx.text, X64::RCX, 1)
      x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)
      x64_mov_mr(&mut ctx.text, X64::RAX, 8, X64::RBX)
      x64_add_ri(&mut ctx.text, X64::RAX, 16)

      def_label(&mut ctx.text, done_label)
      x64_pop(&mut ctx.text, X64::R12)
      x64_pop(&mut ctx.text, X64::RBX)
      x64_pop(&mut ctx.text, X64::RBP)
      x64_ret(&mut ctx.text)
    end
  end
end

# _tg_mem_free: Free memory
# Args: x0/rdi = ptr, x1/rsi = size
def emit_tg_mem_free(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_mem_free")
  
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      a64_cmp_ri(&mut ctx.text, A64::X0, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), done_label.clone())
      a64_sub_rri(&mut ctx.text, A64::X9, A64::X0, 16)
      a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)
      a64_cmp_ri(&mut ctx.text, A64::X10, 1)
      a64_bcond(&mut ctx.text, a64_cc_ne(), done_label.clone())
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
      a64_ldr(&mut ctx.text, A64::X1, A64::X9, 8)
      a64_mov_ri(&mut ctx.text, A64::X16, 73)  # munmap
      a64_svc(&mut ctx.text, 0x80)
      def_label(&mut ctx.text, done_label)
    when OsAbi::Linux then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      a64_cmp_ri(&mut ctx.text, A64::X0, 0)
      a64_bcond(&mut ctx.text, a64_cc_eq(), done_label.clone())
      a64_sub_rri(&mut ctx.text, A64::X9, A64::X0, 16)
      a64_ldr(&mut ctx.text, A64::X10, A64::X9, 0)
      a64_cmp_ri(&mut ctx.text, A64::X10, 1)
      a64_bcond(&mut ctx.text, a64_cc_ne(), done_label.clone())
      a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
      a64_ldr(&mut ctx.text, A64::X1, A64::X9, 8)
      a64_mov_ri(&mut ctx.text, A64::X8, 215)  # munmap
      a64_svc(&mut ctx.text, 0)
      def_label(&mut ctx.text, done_label)
    when _ then a64_brk(&mut ctx.text, 1)
    end
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
      x64_jcc(&mut ctx.text, CC::E, done_label.clone())
      x64_sub_ri(&mut ctx.text, X64::RDI, 16)
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
      x64_cmp_ri(&mut ctx.text, X64::RAX, 1)
      x64_jcc(&mut ctx.text, CC::NE, done_label.clone())
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000049)
      x64_syscall(&mut ctx.text)
      def_label(&mut ctx.text, done_label)
    when OsAbi::Linux then
      let done_label = fresh_label(ctx, ".Lmem_free_done")
      x64_test_rr(&mut ctx.text, X64::RDI, X64::RDI)
      x64_jcc(&mut ctx.text, CC::E, done_label.clone())
      x64_sub_ri(&mut ctx.text, X64::RDI, 16)
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
      x64_cmp_ri(&mut ctx.text, X64::RAX, 1)
      x64_jcc(&mut ctx.text, CC::NE, done_label.clone())
      x64_mov_rm(&mut ctx.text, X64::RSI, X64::RDI, 8)
      x64_mov_ri(&mut ctx.text, X64::RAX, 11)
      x64_syscall(&mut ctx.text)
      def_label(&mut ctx.text, done_label)
    when _ then x64_ud2(&mut ctx.text)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_runtime_hash_ptr: Content-aware hash
# Args: x0/rdi = key value (string pointer, packed inline string, or integer)
# Returns: hash
# Some bootstrap strings arrive as packed little-endian ASCII bytes in the value
# word. Detect that representation before pointer hashing so values like
# "Int__fmt" are not dereferenced as addresses.
def emit_tg_runtime_hash_ptr(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_runtime_hash_ptr")
  
  let lblInlineScan = fresh_label(ctx, ".Lhash_inline_scan")
  let lblInlineMaybeDone = fresh_label(ctx, ".Lhash_inline_maybe_done")
  let lblInlineHash = fresh_label(ctx, ".Lhash_inline")
  let lblInlineLoop = fresh_label(ctx, ".Lhash_inline_loop")
  let lblNotInline = fresh_label(ctx, ".Lhash_not_inline")
  let lblIntHash = fresh_label(ctx, ".Lhash_int")
  let lblStrHash = fresh_label(ctx, ".Lhash_str")
  let lblStrLoop = fresh_label(ctx, ".Lhash_str_loop")
  let lblDone = fresh_label(ctx, ".Lhash_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    # Skip inline scan — pointer values may have printable low bytes that
    # cause misclassification. Always use threshold-based classification.
    def_label(&mut ctx.text, lblNotInline.clone())
    # Pointers in native stage1 are high VM addresses. Smaller values are ints.
    a64_mov_ri(&mut ctx.text, A64::X9, 0x100000000)
    a64_cmp_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_bcond(&mut ctx.text, a64_cc_cs(), lblStrHash.clone())
    
    # Integer hash: seeded raw value hash
    def_label(&mut ctx.text, lblIntHash.clone())
    a64_mov_ri(&mut ctx.text, A64::X9, 5381)
    a64_eor_rrr(&mut ctx.text, A64::X0, A64::X9, A64::X0)
    a64_mov_ri(&mut ctx.text, A64::X9, 33)
    a64_mul_rrr(&mut ctx.text, A64::X0, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)

    # Inline string hash: hash bytes from the value word.
    def_label(&mut ctx.text, lblInlineHash.clone())
    a64_mov_rr(&mut ctx.text, A64::X3, A64::X0)
    a64_mov_ri(&mut ctx.text, A64::X4, 0)
    a64_mov_ri(&mut ctx.text, A64::X1, 5381)
    a64_mov_ri(&mut ctx.text, A64::X9, 33)
    a64_mov_ri(&mut ctx.text, A64::X10, 255)

    def_label(&mut ctx.text, lblInlineLoop.clone())
    a64_and_rrr(&mut ctx.text, A64::X2, A64::X3, A64::X10)
    a64_cmp_ri(&mut ctx.text, A64::X2, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_eor_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X9)
    a64_add_rri(&mut ctx.text, A64::X4, A64::X4, 1)
    a64_cmp_ri(&mut ctx.text, A64::X4, 8)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_lsr(&mut ctx.text, A64::X3, A64::X3, 8)
    a64_b(&mut ctx.text, lblInlineLoop.clone())
    
    # String hash: seeded byte hash
    def_label(&mut ctx.text, lblStrHash)
    a64_mov_ri(&mut ctx.text, A64::X1, 5381)
    a64_mov_ri(&mut ctx.text, A64::X9, 33)
    
    def_label(&mut ctx.text, lblStrLoop)
    a64_ldrb(&mut ctx.text, A64::X2, A64::X0, 0)    # load byte
    a64_cmp_ri(&mut ctx.text, A64::X2, 0)            # null terminator?
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_eor_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X2)   # hash ^= byte
    a64_mul_rrr(&mut ctx.text, A64::X1, A64::X1, A64::X9)    # hash *= prime
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)           # advance pointer
    a64_b(&mut ctx.text, lblStrLoop)
    
    def_label(&mut ctx.text, lblDone)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X1)    # return hash
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Inline packed ASCII string check.
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_ri(&mut ctx.text, X64::R8, 0)
    x64_mov_ri(&mut ctx.text, X64::R9, 255)
    def_label(&mut ctx.text, lblInlineScan.clone())
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RDX)
    x64_and_rr(&mut ctx.text, X64::R10, X64::R9)
    x64_test_rr(&mut ctx.text, X64::R10, X64::R10)
    x64_jcc(&mut ctx.text, CC::E, lblInlineMaybeDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::R10, 32)
    x64_jcc(&mut ctx.text, CC::B, lblNotInline.clone())
    x64_cmp_ri(&mut ctx.text, X64::R10, 127)
    x64_jcc(&mut ctx.text, CC::AE, lblNotInline.clone())
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_cmp_ri(&mut ctx.text, X64::R8, 8)
    x64_jcc(&mut ctx.text, CC::E, lblInlineHash.clone())
    x64_shr_ri(&mut ctx.text, X64::RDX, 8)
    x64_jmp(&mut ctx.text, lblInlineScan.clone())
    def_label(&mut ctx.text, lblInlineMaybeDone.clone())
    x64_test_rr(&mut ctx.text, X64::R8, X64::R8)
    x64_jcc(&mut ctx.text, CC::NE, lblInlineHash.clone())

    def_label(&mut ctx.text, lblNotInline.clone())
    # Check if value looks like a native pointer.
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x100000000)
    x64_cmp_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::AE, lblStrHash.clone())
    
    # Integer hash
    def_label(&mut ctx.text, lblIntHash.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 5381)
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDI)
    x64_mov_ri(&mut ctx.text, X64::RCX, 33)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_ret(&mut ctx.text)

    # Inline string hash: hash bytes from the value word.
    def_label(&mut ctx.text, lblInlineHash.clone())
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::RDI)
    x64_mov_ri(&mut ctx.text, X64::R8, 0)
    x64_mov_ri(&mut ctx.text, X64::R9, 255)
    x64_mov_ri(&mut ctx.text, X64::RAX, 5381)
    x64_mov_ri(&mut ctx.text, X64::RCX, 33)

    def_label(&mut ctx.text, lblInlineLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::R10, X64::RDX)
    x64_and_rr(&mut ctx.text, X64::R10, X64::R9)
    x64_test_rr(&mut ctx.text, X64::R10, X64::R10)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::R10)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::R8, 1)
    x64_cmp_ri(&mut ctx.text, X64::R8, 8)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_shr_ri(&mut ctx.text, X64::RDX, 8)
    x64_jmp(&mut ctx.text, lblInlineLoop.clone())
    
    # String hash: seeded byte hash
    def_label(&mut ctx.text, lblStrHash)
    x64_mov_ri(&mut ctx.text, X64::RAX, 5381)
    x64_mov_ri(&mut ctx.text, X64::RCX, 33)
    
    def_label(&mut ctx.text, lblStrLoop)
    x64_movzx_r64_m8(&mut ctx.text, X64::RDX, X64::RDI, 0)  # load byte
    x64_test_rr(&mut ctx.text, X64::RDX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_xor_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_jmp(&mut ctx.text, lblStrLoop)
    
    def_label(&mut ctx.text, lblDone)
    x64_ret(&mut ctx.text)
  end
end

# _tg_key_equal: Compare two map keys for equality.
# Pointer strings compare by bytes. Packed inline strings and integers compare by
# raw value; the hash helper classifies packed ASCII the same way on insert and lookup.
# Args: x0/rdi = key_a, x1/rsi = key_b
# Returns: x0/rax = 1 if equal, 0 if not. Clobbers x9,x10 (AArch64) or rcx,rdx (x86_64).
def emit_tg_key_equal(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_key_equal")
  
  let lblStrLoop = fresh_label(ctx, ".Lkeyeq_loop")
  let lblEqual = fresh_label(ctx, ".Lkeyeq_equal")
  let lblNotEqual = fresh_label(ctx, ".Lkeyeq_neq")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_cmp_rr(&mut ctx.text, A64::X0, A64::X1)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblEqual.clone())

    a64_mov_ri(&mut ctx.text, A64::X9, 0x100000000)
    a64_cmp_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_bcond(&mut ctx.text, a64_cc_cc(), lblNotEqual.clone())
    a64_cmp_rr(&mut ctx.text, A64::X1, A64::X9)
    a64_bcond(&mut ctx.text, a64_cc_cc(), lblNotEqual.clone())

    def_label(&mut ctx.text, lblStrLoop)
    a64_ldrb(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_ldrb(&mut ctx.text, A64::X10, A64::X1, 0)
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X10)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNotEqual.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblEqual.clone())
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_add_rri(&mut ctx.text, A64::X1, A64::X1, 1)
    a64_b(&mut ctx.text, lblStrLoop)

    def_label(&mut ctx.text, lblEqual)
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_ret(&mut ctx.text)

    def_label(&mut ctx.text, lblNotEqual)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_cmp_rr(&mut ctx.text, X64::RDI, X64::RSI)
    x64_jcc(&mut ctx.text, CC::E, lblEqual.clone())

    x64_mov_ri(&mut ctx.text, X64::RAX, 0x100000000)
    x64_cmp_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::B, lblNotEqual.clone())
    x64_cmp_rr(&mut ctx.text, X64::RSI, X64::RAX)
    x64_jcc(&mut ctx.text, CC::B, lblNotEqual.clone())

    def_label(&mut ctx.text, lblStrLoop)
    x64_movzx_r64_m8(&mut ctx.text, X64::RCX, X64::RDI, 0)
    x64_movzx_r64_m8(&mut ctx.text, X64::RDX, X64::RSI, 0)
    x64_cmp_rr(&mut ctx.text, X64::RCX, X64::RDX)
    x64_jcc(&mut ctx.text, CC::NE, lblNotEqual.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lblEqual.clone())
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lblStrLoop)

    def_label(&mut ctx.text, lblEqual)
    x64_mov_ri(&mut ctx.text, X64::RAX, 1)
    x64_ret(&mut ctx.text)

    def_label(&mut ctx.text, lblNotEqual)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# String Conversion Runtime
# ———————————————————————————————————————————————————————————————

def emit_string_conv_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_cstring_new(ctx)
  emit_tg_string_bytes(ctx)
  emit_tg_string_from_bytes(ctx)
  emit_tg_int_to_str(ctx)
  emit_tg_float_to_str(ctx)
  emit_tg_str_to_int(ctx)
  emit_tg_str_to_float(ctx)
end

# _tg_int_to_str: Convert integer to string
# Args: x0/rdi = integer
# Returns: ptr to null-terminated string
def emit_tg_int_to_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_int_to_str")
  
  let lblLoop = fresh_label(ctx, ".Lint2str_loop")
  let lblDone = fresh_label(ctx, ".Lint2str_done")
  let lblNeg = fresh_label(ctx, ".Lint2str_neg")
  let lblPos = fresh_label(ctx, ".Lint2str_pos")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # value
    
    # Allocate buffer on stack (max 21 digits for int64 + sign)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 32)
    a64_mov_rr(&mut ctx.text, A64::X20, A64::SP)  # buffer
    
    # Handle negative
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblPos.clone())
    
    def_label(&mut ctx.text, lblNeg.clone())
    a64_neg(&mut ctx.text, A64::X19, A64::X19)
    a64_mov_ri(&mut ctx.text, A64::X21, 1)  # negative flag
    a64_b(&mut ctx.text, ".Lint2str_convert")
    
    def_label(&mut ctx.text, lblPos.clone())
    a64_mov_ri(&mut ctx.text, A64::X21, 0)
    
    def_label(&mut ctx.text, ".Lint2str_convert")
    a64_mov_ri(&mut ctx.text, A64::X22, 0)  # digit count
    a64_add_rri(&mut ctx.text, A64::X9, A64::X20, 20)  # end of buffer
    
    def_label(&mut ctx.text, lblLoop.clone())
    # digit = value % 10
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_udiv(&mut ctx.text, A64::X11, A64::X19, A64::X10)  # quotient
    a64_msub(&mut ctx.text, A64::X12, A64::X11, A64::X10, A64::X19)  # remainder
    
    # *--ptr = '0' + digit
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 48)  # '0'
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X11)  # value = quotient
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())
    
    # Add negative sign if needed
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_mov_ri(&mut ctx.text, A64::X10, 45)  # '-'
    a64_strb(&mut ctx.text, A64::X10, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Allocate result string and copy
    a64_add_rri(&mut ctx.text, A64::X1, A64::X22, 1)  # len + 1
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    
    # Copy digits to result
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X0)  # result
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X9)  # src
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X22) # len
    
    let lblCopy = fresh_label(ctx, ".Lint2str_copy")
    let lblCopyDone = fresh_label(ctx, ".Lint2str_copy_done")
    
    a64_mov_ri(&mut ctx.text, A64::X13, 0)
    def_label(&mut ctx.text, lblCopy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X13, A64::X12)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
    a64_ldrb(&mut ctx.text, A64::X14, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X14, A64::X10, 0)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblCopy)
    
    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_strb(&mut ctx.text, A64::XZR, A64::X10, 0)  # null terminator
    
    a64_add_rri(&mut ctx.text, A64::SP, A64::SP, 32)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    # Similar x86-64 implementation
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    
    x64_sub_ri(&mut ctx.text, X64::RSP, 32)
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # value
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSP)  # buffer
    
    # Handle sign
    x64_mov_ri(&mut ctx.text, X64::R13, 0)  # negative flag
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::GE, lblPos.clone())
    
    def_label(&mut ctx.text, lblNeg.clone())
    x64_neg_r(&mut ctx.text, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::R13, 1)
    x64_jmp(&mut ctx.text, ".Lint2str_convert")
    
    def_label(&mut ctx.text, lblPos.clone())
    
    def_label(&mut ctx.text, ".Lint2str_convert")
    x64_mov_ri(&mut ctx.text, X64::R14, 0)  # digit count
    x64_lea_mem(&mut ctx.text, X64::R15, X64::R12, 20)  # end of buffer
    
    def_label(&mut ctx.text, lblLoop.clone())
    # rax = value / 10, rdx = value % 10
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_cqo(&mut ctx.text)
    x64_idiv_r(&mut ctx.text, X64::RCX)
    
    # *--r15 = '0' + rdx
    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_add_ri(&mut ctx.text, X64::RDX, 48)
    # mov [r15], dl
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x17)
    
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    
    x64_test_rr(&mut ctx.text, X64::RBX, X64::RBX)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())
    
    # Add negative sign
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lblDone.clone())
    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_mov_ri(&mut ctx.text, X64::RAX, 45)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    
    def_label(&mut ctx.text, lblDone.clone())
    # Allocate and copy
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)
    
    # Copy result
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R15)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
    emit8(&mut ctx.text, 0xF3)
    emit8(&mut ctx.text, 0xA4)  # rep movsb
    
    # Null terminate
    emit8(&mut ctx.text, 0xC6)
    emit8(&mut ctx.text, 0x07)
    emit8(&mut ctx.text, 0x00)
    
    x64_add_ri(&mut ctx.text, X64::RSP, 32)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_float_to_str: Convert f64 (IEEE 754 bits in x0/rdi) to string
# Strategy: reinterpret bits as double, extract sign/integer/fraction parts,
# convert integer part via _tg_int_to_str, then append "." + fraction digits.
# Handles: negative, zero, integer-only, up to 6 decimal digits.
def emit_tg_float_to_str(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_float_to_str")

  let lblNeg     = fresh_label(ctx, ".Lf2s_neg")
  let lblPos     = fresh_label(ctx, ".Lf2s_pos")
  let lblZero    = fresh_label(ctx, ".Lf2s_zero")
  let lblFrac    = fresh_label(ctx, ".Lf2s_frac")
  let lblFLoop   = fresh_label(ctx, ".Lf2s_floop")
  let lblFDone   = fresh_label(ctx, ".Lf2s_fdone")
  let lblCopy    = fresh_label(ctx, ".Lf2s_copy")
  let lblCopyD   = fresh_label(ctx, ".Lf2s_copyd")

  match ctx.target.arch
  when Arch::AArch64 then
    # x0 = f64 bit pattern. Use FP regs for actual float math.
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 64)  # scratch buffer

    # Move bits to D0: fmov d0, x0  (opcode 0x9E670000 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, 0x9E670000 as u32)  # fmov d0, x0

    # Check sign: if x0 < 0 (MSB set) then negative
    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # save bits
    a64_cmp_ri(&mut ctx.text, A64::X19, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblNeg.clone())
    a64_mov_ri(&mut ctx.text, A64::X20, 0)  # sign=0
    a64_b(&mut ctx.text, lblPos)

    def_label(&mut ctx.text, lblNeg.clone())
    a64_mov_ri(&mut ctx.text, A64::X20, 1)  # sign=1
    # fneg d0, d0  (opcode 0x1E614000)
    emit32_le(&mut ctx.text, 0x1E614000 as u32)

    def_label(&mut ctx.text, lblPos.clone())
    # fcvtzs x21, d0  — integer part  (opcode 0x9E780000 | Rd)
    emit32_le(&mut ctx.text, 0x9E780015 as u32)  # fcvtzs x21, d0

    # Convert integer part with _tg_int_to_str
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_int_to_str")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # int_str ptr (from mmap)

    # Build result: [sign] + int_str + "." + frac_digits
    # ptr in SP buffer
    a64_mov_rr(&mut ctx.text, A64::X9, A64::SP)  # dst
    a64_mov_ri(&mut ctx.text, A64::X10, 0)       # dst_len

    # If sign, prepend '-'
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lf2s_nosign")
    a64_mov_ri(&mut ctx.text, A64::X11, 45)  # '-'
    a64_strb(&mut ctx.text, A64::X11, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    def_label(&mut ctx.text, ".Lf2s_nosign")
    # Copy int_str digits
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X22)
    def_label(&mut ctx.text, lblCopy.clone())
    a64_ldrb(&mut ctx.text, A64::X12, A64::X11, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFrac.clone())
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_b(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblFrac.clone())
    # Append '.'
    a64_mov_ri(&mut ctx.text, A64::X12, 46)  # '.'
    a64_strb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    # Fraction: frac = abs(d0) - integer_part
    # scvtf d1, x21   (opcode 0x9E620020 | Rd=1)
    emit32_le(&mut ctx.text, 0x9E6200A1 as u32)  # scvtf d1, x21  (Rn=x21=21, Rd=d1=1)
    # fsub d0, d0, d1  (opcode 0x1E613800 | Rm<<16 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, 0x1E613800 as u32)  # fsub d0, d0, d1

    # Generate 6 fraction digits
    a64_mov_ri(&mut ctx.text, A64::X13, 6)  # digit counter
    def_label(&mut ctx.text, lblFLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X13, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblFDone.clone())

    # frac *= 10:  fmov d1, #10.0 ... too complex, use int mul
    # fcvtzs x14, d0 after *10 approach:
    # Load 10.0 into d1: mov x14, 0x4024000000000000 (10.0 bits); fmov d1, x14
    a64_mov_ri(&mut ctx.text, A64::X14, 0x4024000000000000 as i64)
    # fmov d1, x14  (opcode 0x9E670000 | Rn<<5 | Rd)  Rn=x14=14, Rd=d1=1
    emit32_le(&mut ctx.text, (0x9E6701C1) as u32)
    # fmul d0, d0, d1  (opcode 0x1E610800 | Rm<<16 | Rn<<5 | Rd)
    emit32_le(&mut ctx.text, (0x1E610800) as u32)

    # digit = fcvtzs x14, d0
    emit32_le(&mut ctx.text, 0x9E78000E as u32)  # fcvtzs x14, d0

    # Store '0' + digit
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 48)
    # Clamp to 0-9 range
    a64_and_ri(&mut ctx.text, A64::X14, 0xFF)
    a64_strb(&mut ctx.text, A64::X14, A64::X9, 0)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)

    # frac -= digit: scvtf d1, x14-48; fsub d0, d0, d1
    a64_sub_rri(&mut ctx.text, A64::X14, A64::X14, 48)
    # scvtf d1, x14
    emit32_le(&mut ctx.text, (0x9E6201C1) as u32)
    # fsub d0, d0, d1
    emit32_le(&mut ctx.text, 0x1E613800 as u32)

    a64_sub_rri(&mut ctx.text, A64::X13, A64::X13, 1)
    a64_b(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # Null terminate
    a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

    # Allocate result via mmap and copy
    a64_add_rri(&mut ctx.text, A64::X1, A64::X10, 1)  # len+1
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_mov_ri(&mut ctx.text, A64::X2, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 197)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
      a64_mov_ri(&mut ctx.text, A64::X4, -1)
      a64_mov_ri(&mut ctx.text, A64::X5, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 222)
      a64_svc(&mut ctx.text, 0)
    when _ then ()
    end
    # Copy from SP buffer to result
    a64_mov_rr(&mut ctx.text, A64::X11, A64::SP)  # src
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X0)  # dst (mmap result)
    a64_mov_rr(&mut ctx.text, A64::X13, A64::X10) # len
    a64_mov_ri(&mut ctx.text, A64::X14, 0)
    def_label(&mut ctx.text, lblCopyD.clone())
    a64_cmp_rr(&mut ctx.text, A64::X14, A64::X13)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lf2s_copydone")
    a64_ldrb(&mut ctx.text, A64::X15, A64::X11, 0)
    a64_strb(&mut ctx.text, A64::X15, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_add_rri(&mut ctx.text, A64::X14, A64::X14, 1)
    a64_b(&mut ctx.text, lblCopyD)
    def_label(&mut ctx.text, ".Lf2s_copydone")
    a64_strb(&mut ctx.text, A64::XZR, A64::X12, 0)  # null term

    a64_add_rri(&mut ctx.text, A64::SP, A64::SP, 64)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64: full float-to-string with SSE2 fraction digit extraction
    let lbl_icopy = fresh_label(ctx, ".Lf2s_icopy")
    let lbl_icopyd = fresh_label(ctx, ".Lf2s_icopyd")
    let lbl_nosign = fresh_label(ctx, ".Lf2s_nosign")
    let lbl_floop = fresh_label(ctx, ".Lf2s_xfloop")
    let lbl_fdone = fresh_label(ctx, ".Lf2s_xfdone")
    let lbl_cpyd = fresh_label(ctx, ".Lf2s_xcpyd")
    let lbl_cpydone = fresh_label(ctx, ".Lf2s_xcpydone")

    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_sub_ri(&mut ctx.text, X64::RSP, 80)

    # movq xmm0, rdi  — load f64 bits into xmm0
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xC7)

    # Check sign bit (MSB of rdi)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # save original bits
    x64_mov_ri(&mut ctx.text, X64::R13, 0)          # sign=0
    x64_cmp_ri(&mut ctx.text, X64::R12, 0)
    x64_jcc(&mut ctx.text, CC::GE, lbl_nosign.clone())
    x64_mov_ri(&mut ctx.text, X64::R13, 1)          # sign=1
    # Negate: xorpd xmm0, [sign_mask] — use integer approach: clear sign bit
    # btc r12, 63 (clear sign bit), then movq xmm0, r12
    # Simpler: just abs(x) = x & 0x7FFFFFFFFFFFFFFF
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x7FFFFFFFFFFFFFFF as i64)
    x64_and_rr(&mut ctx.text, X64::R12, X64::RAX)
    # movq xmm0, r12
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xC4)  # movq xmm0, r12

    def_label(&mut ctx.text, lbl_nosign.clone())
    # Save xmm0 to stack [rbp-48] for later
    x64_movsd_store(&mut ctx.text, X64::RBP, -48, 0)  # [rbp-48] = xmm0

    # cvttsd2si rbx, xmm0 — integer part
    x64_cvttsd2si(&mut ctx.text, X64::RBX, 0)

    # Convert integer part with _tg_int_to_str
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_int_to_str")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # int_str ptr

    # Build result in stack buffer at RSP
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RSP)  # dst ptr
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)          # length counter in RCX

    # If sign, prepend '-'
    x64_test_rr(&mut ctx.text, X64::R13, X64::R13)
    x64_jcc(&mut ctx.text, CC::E, lbl_icopy.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 45)  # '-'
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)

    # Copy int_str digits
    def_label(&mut ctx.text, lbl_icopy.clone())
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    # Save RCX (length) in R14 temporarily
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RCX)
    def_label(&mut ctx.text, lbl_icopyd.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [rsi]
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_floop.clone())  # done copying int digits
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_add_ri(&mut ctx.text, X64::RSI, 1)
    x64_jmp(&mut ctx.text, lbl_icopyd)

    # Append '.' and 6 fraction digits
    def_label(&mut ctx.text, lbl_floop.clone())
    x64_mov_ri(&mut ctx.text, X64::RAX, 46)  # '.'
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)

    # Reload xmm0 from saved copy, subtract integer part
    x64_movsd_load(&mut ctx.text, 0, X64::RBP, -48)  # xmm0 = abs(original)
    # cvtsi2sd xmm1, rbx  — integer part as double
    x64_cvtsi2sd(&mut ctx.text, 1, X64::RBX)
    # xmm0 = xmm0 - xmm1  (fraction)
    x64_subsd(&mut ctx.text, 0, 1)

    # Generate 6 fraction digits: multiply by 10, extract digit, subtract
    x64_mov_ri(&mut ctx.text, X64::RCX, 6)  # digit counter
    # Load 10.0 into xmm2: mov rax, 0x4024000000000000; movq xmm2, rax
    x64_mov_ri(&mut ctx.text, X64::RAX, 0x4024000000000000 as i64)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xD0)  # movq xmm2, rax

    let lbl_digit = fresh_label(ctx, ".Lf2s_xdigit")
    let lbl_digitd = fresh_label(ctx, ".Lf2s_xdigitd")
    def_label(&mut ctx.text, lbl_digit.clone())
    x64_test_rr(&mut ctx.text, X64::RCX, X64::RCX)
    x64_jcc(&mut ctx.text, CC::E, lbl_digitd.clone())

    # xmm0 *= 10.0
    x64_mulsd(&mut ctx.text, 0, 2)
    # digit = cvttsd2si rax, xmm0
    x64_cvttsd2si(&mut ctx.text, X64::RAX, 0)
    # Clamp digit to 0-9
    x64_and_rr(&mut ctx.text, X64::RAX, X64::RAX)  # clear upper (it's already clean from cvt)
    # store '0' + digit
    x64_add_ri(&mut ctx.text, X64::RAX, 48)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [rdi], al
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    # xmm0 -= digit: sub 48 back, cvtsi2sd xmm1, rax; subsd xmm0, xmm1
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_cvtsi2sd(&mut ctx.text, 1, X64::RAX)
    x64_subsd(&mut ctx.text, 0, 1)

    x64_sub_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lbl_digit)

    def_label(&mut ctx.text, lbl_digitd.clone())
    # Null terminate
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)

    # R14 = total length; allocate via mmap
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::R14)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)  # +1 for null

    # mmap
    x64_mov_ri(&mut ctx.text, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RDX, 3)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
      x64_mov_ri(&mut ctx.text, X64::R8, -1)
      x64_mov_ri(&mut ctx.text, X64::R9, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 9)
    when _ then ()
    end
    x64_syscall(&mut ctx.text)

    # Copy from stack buffer to mmap result
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RAX)  # dst (mmap result)
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # save result ptr
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::RSP)  # src
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RBX)  # len
    emit8(&mut ctx.text, 0xF3)  # rep
    emit8(&mut ctx.text, 0xA4)  # movsb

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R12)  # return result ptr

    x64_add_ri(&mut ctx.text, X64::RSP, 80)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_str_to_int: Parse string to integer
def emit_tg_str_to_int(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_to_int")
  
  let lblLoop = fresh_label(ctx, ".Lstr2int_loop")
  let lblDone = fresh_label(ctx, ".Lstr2int_done")
  
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_rr(&mut ctx.text, A64::X9, A64::X0)   # str ptr
    a64_mov_ri(&mut ctx.text, A64::X10, 0)        # result
    a64_mov_ri(&mut ctx.text, A64::X11, 0)        # negative flag
    
    # Check for negative sign
    a64_ldrb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 45)  # '-'
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblLoop.clone())
    a64_mov_ri(&mut ctx.text, A64::X11, 1)
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X12, A64::X9, 0)
    a64_cmp_ri(&mut ctx.text, A64::X12, 48)  # '0'
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 57)  # '9'
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblDone.clone())
    
    # result = result * 10 + (digit - '0')
    a64_mov_ri(&mut ctx.text, A64::X13, 10)
    a64_mul_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X13)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 48)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X10, A64::X12)
    
    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Lstr2int_ret")
    a64_neg(&mut ctx.text, A64::X10, A64::X10)
    
    def_label(&mut ctx.text, ".Lstr2int_ret")
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X10)
    a64_ret(&mut ctx.text)
    
  when Arch::X86_64 then
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)  # str ptr
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)         # result
    x64_mov_ri(&mut ctx.text, X64::R8, 0)          # negative flag
    
    # Check for negative
    # movzx r9, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x09)
    x64_cmp_ri(&mut ctx.text, X64::R9, 45)
    x64_jcc(&mut ctx.text, CC::NE, lblLoop.clone())
    x64_mov_ri(&mut ctx.text, X64::R8, 1)
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    
    def_label(&mut ctx.text, lblLoop.clone())
    # movzx r9, byte [rcx]
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x09)
    x64_cmp_ri(&mut ctx.text, X64::R9, 48)
    x64_jcc(&mut ctx.text, CC::L, lblDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::R9, 57)
    x64_jcc(&mut ctx.text, CC::G, lblDone.clone())
    
    # result = result * 10 + (digit - '0')
    x64_mov_ri(&mut ctx.text, X64::RDX, 10)
    x64_imul_rr(&mut ctx.text, X64::RAX, X64::RDX)
    x64_sub_ri(&mut ctx.text, X64::R9, 48)
    x64_add_rr(&mut ctx.text, X64::RAX, X64::R9)
    
    x64_add_ri(&mut ctx.text, X64::RCX, 1)
    x64_jmp(&mut ctx.text, lblLoop)
    
    def_label(&mut ctx.text, lblDone.clone())
    x64_test_rr(&mut ctx.text, X64::R8, X64::R8)
    x64_jcc(&mut ctx.text, CC::E, ".Lstr2int_ret")
    x64_neg_r(&mut ctx.text, X64::RAX)
    
    def_label(&mut ctx.text, ".Lstr2int_ret")
    x64_ret(&mut ctx.text)
  end
end

# _tg_str_to_float: Parse string to f64 (IEEE 754 bits returned in x0/rax)
# Handles: optional sign, integer part, optional "." + fraction digits
def emit_tg_str_to_float(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_to_float")

  let lblILoop  = fresh_label(ctx, ".Ls2f_iloop")
  let lblIDone  = fresh_label(ctx, ".Ls2f_idone")
  let lblFLoop  = fresh_label(ctx, ".Ls2f_floop")
  let lblFDone  = fresh_label(ctx, ".Ls2f_fdone")
  let lblNoDot  = fresh_label(ctx, ".Ls2f_nodot")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)   # str ptr
    a64_mov_ri(&mut ctx.text, A64::X20, 0)         # negative flag

    # Check sign
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 45)  # '-'
    a64_bcond(&mut ctx.text, a64_cc_ne(), ".Ls2f_nosign")
    a64_mov_ri(&mut ctx.text, A64::X20, 1)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    def_label(&mut ctx.text, ".Ls2f_nosign")

    # Parse integer part into x21
    a64_mov_ri(&mut ctx.text, A64::X21, 0)
    def_label(&mut ctx.text, lblILoop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 48)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblIDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 57)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblIDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_mul_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X10)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 48)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    a64_b(&mut ctx.text, lblILoop)

    def_label(&mut ctx.text, lblIDone.clone())
    # Convert integer part to double: scvtf d0, x21
    emit32_le(&mut ctx.text, 0x9E6202A0 as u32)  # scvtf d0, x21

    # Check for '.'
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 46)  # '.'
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblNoDot.clone())
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)

    # Parse fraction: accumulate digits, divide by power of 10
    a64_mov_ri(&mut ctx.text, A64::X21, 0)   # frac_int
    a64_mov_ri(&mut ctx.text, A64::X22, 1)   # divisor
    def_label(&mut ctx.text, lblFLoop.clone())
    a64_ldrb(&mut ctx.text, A64::X9, A64::X19, 0)
    a64_cmp_ri(&mut ctx.text, A64::X9, 48)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblFDone.clone())
    a64_cmp_ri(&mut ctx.text, A64::X9, 57)
    a64_bcond(&mut ctx.text, a64_cc_gt(), lblFDone.clone())
    a64_mov_ri(&mut ctx.text, A64::X10, 10)
    a64_mul_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X10)
    a64_sub_rri(&mut ctx.text, A64::X9, A64::X9, 48)
    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X9)
    a64_mul_rrr(&mut ctx.text, A64::X22, A64::X22, A64::X10)
    a64_add_rri(&mut ctx.text, A64::X19, A64::X19, 1)
    a64_b(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # d1 = frac_int / divisor: scvtf d1, x21; scvtf d2, x22; fdiv d1, d1, d2
    emit32_le(&mut ctx.text, 0x9E6202A1 as u32)  # scvtf d1, x21
    emit32_le(&mut ctx.text, 0x9E6202C2 as u32)  # scvtf d2, x22
    # fdiv d1, d1, d2  (0x1E621820)
    emit32_le(&mut ctx.text, 0x1E621820 as u32)
    # fadd d0, d0, d1  (0x1E612800)
    emit32_le(&mut ctx.text, 0x1E612800 as u32)

    def_label(&mut ctx.text, lblNoDot.clone())
    # Apply sign
    a64_cmp_ri(&mut ctx.text, A64::X20, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), ".Ls2f_done")
    # fneg d0, d0
    emit32_le(&mut ctx.text, 0x1E614000 as u32)

    def_label(&mut ctx.text, ".Ls2f_done")
    # fmov x0, d0  (return bits)
    emit32_le(&mut ctx.text, 0x9E660000 as u32)  # fmov x0, d0

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # x86-64: parse integer + fraction using integer math, then use
    # cvtsi2sd to convert to double
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # str ptr
    x64_mov_ri(&mut ctx.text, X64::R12, 0)         # sign

    # Check sign
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 45)
    x64_jcc(&mut ctx.text, CC::NE, ".Ls2f_nosign")
    x64_mov_ri(&mut ctx.text, X64::R12, 1)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    def_label(&mut ctx.text, ".Ls2f_nosign")

    # Parse integer part into R13
    x64_mov_ri(&mut ctx.text, X64::R13, 0)
    def_label(&mut ctx.text, lblILoop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 48)
    x64_jcc(&mut ctx.text, CC::L, lblIDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 57)
    x64_jcc(&mut ctx.text, CC::G, lblIDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_imul_rr(&mut ctx.text, X64::R13, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_add_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_jmp(&mut ctx.text, lblILoop)

    def_label(&mut ctx.text, lblIDone.clone())
    # cvtsi2sd xmm0, r13  (0xF2 0x4C 0x0F 0x2A 0xC5)
    emit8(&mut ctx.text, 0xF2)
    emit8(&mut ctx.text, 0x4C)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x2A)
    emit8(&mut ctx.text, 0xC5)  # cvtsi2sd xmm0, r13 (approximate encoding)

    # Check for '.'
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 46)
    x64_jcc(&mut ctx.text, CC::NE, lblNoDot.clone())
    x64_add_ri(&mut ctx.text, X64::RBX, 1)

    # For x86, just parse as integer and use simple division
    # Parse frac digits into R13, divisor into R14
    x64_mov_ri(&mut ctx.text, X64::R13, 0)
    x64_mov_ri(&mut ctx.text, X64::R14, 1)
    def_label(&mut ctx.text, lblFLoop.clone())
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x03)  # movzx eax, byte [rbx]
    x64_cmp_ri(&mut ctx.text, X64::RAX, 48)
    x64_jcc(&mut ctx.text, CC::L, lblFDone.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 57)
    x64_jcc(&mut ctx.text, CC::G, lblFDone.clone())
    x64_mov_ri(&mut ctx.text, X64::RCX, 10)
    x64_imul_rr(&mut ctx.text, X64::R13, X64::RCX)
    x64_sub_ri(&mut ctx.text, X64::RAX, 48)
    x64_add_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_imul_rr(&mut ctx.text, X64::R14, X64::RCX)
    x64_add_ri(&mut ctx.text, X64::RBX, 1)
    x64_jmp(&mut ctx.text, lblFLoop)

    def_label(&mut ctx.text, lblFDone.clone())
    # Compute fraction: cvtsi2sd xmm1, r13; cvtsi2sd xmm2, r14; divsd xmm1, xmm2; addsd xmm0, xmm1
    x64_cvtsi2sd(&mut ctx.text, 1, X64::R13)   # xmm1 = frac_int
    x64_cvtsi2sd(&mut ctx.text, 2, X64::R14)   # xmm2 = divisor
    x64_divsd(&mut ctx.text, 1, 2)             # xmm1 = frac_int / divisor
    x64_addsd(&mut ctx.text, 0, 1)             # xmm0 += fraction

    def_label(&mut ctx.text, lblNoDot.clone())
    # Apply sign if needed: negate xmm0 by XOR with sign bit
    x64_test_rr(&mut ctx.text, X64::R12, X64::R12)
    x64_jcc(&mut ctx.text, CC::E, ".Ls2f_done")
    # Load sign mask (0x8000000000000000) into xmm3 via integer reg
    x64_mov_ri(&mut ctx.text, X64::RAX, -9223372036854775808 as i64)  # 0x8000000000000000
    # movq xmm3, rax
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x6E)
    emit8(&mut ctx.text, 0xD8)  # movq xmm3, rax
    # xorpd xmm0, xmm3  (0x66 0x0F 0x57 0xC3)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x57)
    emit8(&mut ctx.text, 0xC3)

    def_label(&mut ctx.text, ".Ls2f_done")
    # movq rax, xmm0  (return f64 bits)
    emit8(&mut ctx.text, 0x66)
    emit8(&mut ctx.text, 0x48)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0x7E)
    emit8(&mut ctx.text, 0xC0)  # movq rax, xmm0

    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# String chars() runtime: convert null-terminated string to Vec[Char]
# ———————————————————————————————————————————————————————————————
#
# _tg_str_chars: Create a Vec-like structure from a string
# ABI: x0 = &self (pointer to string pointer)
# Returns: pointer to Vec header {data_ptr, len, cap}
#   data_ptr points to array of 8-byte zero-extended char values
#
# Vec layout at returned pointer:
#   [+0] : data_ptr (points to element array at returned_ptr + 24)
#   [+8] : length (number of chars)
#   [+16]: capacity (= length)
#   [+24]: element 0 (8 bytes, zero-extended byte)
#   [+32]: element 1
#   ...

def emit_str_chars_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_str_chars(ctx)
end

def emit_tg_str_chars(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_str_chars")

  match ctx.target.arch
  when Arch::AArch64 then
    emit_tg_str_chars_aarch64(ctx)
  when Arch::X86_64 then
    emit_tg_str_chars_x86_64(ctx)
  end
end

def emit_tg_str_chars_aarch64(ctx: &mut RuntimeEmitCtx) -> Unit
  let lbl_strlen   = fresh_label(ctx, ".Lchars_strlen")
  let lbl_done_len = fresh_label(ctx, ".Lchars_done_len")
  let lbl_copy     = fresh_label(ctx, ".Lchars_copy")
  let lbl_copy_end = fresh_label(ctx, ".Lchars_copy_end")

  # Prologue: save callee-saved regs
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
  a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

  # Dereference &self to get string data pointer
  # x0 = &self → load string pointer
  a64_ldr(&mut ctx.text, A64::X19, A64::X0, 0)   # x19 = string data ptr

  # strlen(x19) → x20
  a64_mov_ri(&mut ctx.text, A64::X20, 0)          # x20 = counter = 0
  def_label(&mut ctx.text, lbl_strlen.clone())
  a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X20)  # x10 = ptr + i
  a64_ldrb(&mut ctx.text, A64::X10, A64::X10, 0)  # x10 = byte at [ptr+i]
  a64_cmp_ri(&mut ctx.text, A64::X10, 0)
  a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_done_len.clone())
  a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
  a64_b(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())
  # x20 = strlen

  # Allocate: 24 (header) + x20 * 8 (data) bytes
  a64_lsl(&mut ctx.text, A64::X0, A64::X20, 3)    # x0 = len * 8
  a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 24) # x0 += 24 (header size)
  a64_bl(&mut ctx.text, "_tg_mem_alloc")
  a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)     # x21 = allocated buffer

  # Store header
  a64_add_rri(&mut ctx.text, A64::X9, A64::X21, 24) # x9 = data_start = buf + 24
  a64_str(&mut ctx.text, A64::X9, A64::X21, 0)      # [buf+0] = data_ptr
  a64_str(&mut ctx.text, A64::X20, A64::X21, 8)     # [buf+8] = len
  a64_str(&mut ctx.text, A64::X20, A64::X21, 16)    # [buf+16] = cap = len

  # Copy loop: for i in 0..len, data[i*8] = string[i] (zero-extended)
  a64_mov_ri(&mut ctx.text, A64::X22, 0)            # x22 = i = 0
  def_label(&mut ctx.text, lbl_copy.clone())
  a64_cmp_rr(&mut ctx.text, A64::X22, A64::X20)
  a64_bcond(&mut ctx.text, a64_cc_ge(), lbl_copy_end.clone())

  # Load byte: ldrb w10, [x19 + x22]
  a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
  a64_ldrb(&mut ctx.text, A64::X10, A64::X10, 0)   # x10 = string[i] (zero-ext)

  # Store as 8-byte: str x10, [x9 + i*8]  (x9 = data_start)
  a64_lsl(&mut ctx.text, A64::X11, A64::X22, 3)    # x11 = i * 8
  a64_add_rrr(&mut ctx.text, A64::X11, A64::X9, A64::X11) # x11 = data + i*8
  a64_str(&mut ctx.text, A64::X10, A64::X11, 0)    # [data + i*8] = char_val

  a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1) # i++
  a64_b(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return buffer pointer
  a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)

     # Epilogue — restore all callee-saved regs
     a64_ldp_post(&mut ctx.text, A64::X27, A64::X28, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X25, A64::X26, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
     a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
     a64_ret(&mut ctx.text)
end

def emit_tg_str_chars_x86_64(ctx: &mut RuntimeEmitCtx) -> Unit
  let lbl_strlen   = fresh_label(ctx, ".Lchars_strlen")
  let lbl_done_len = fresh_label(ctx, ".Lchars_done_len")
  let lbl_copy     = fresh_label(ctx, ".Lchars_copy")
  let lbl_copy_end = fresh_label(ctx, ".Lchars_copy_end")

  # Prologue
  x64_push(&mut ctx.text, X64::RBP)
  x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
  x64_push(&mut ctx.text, X64::RBX)
  x64_push(&mut ctx.text, X64::R12)
  x64_push(&mut ctx.text, X64::R13)
  x64_push(&mut ctx.text, X64::R14)

  # Dereference &self → string pointer
  x64_mov_rm(&mut ctx.text, X64::RBX, X64::RDI, 0)  # rbx = string data ptr

  # strlen(rbx) → r12
  x64_mov_ri(&mut ctx.text, X64::R12, 0)
  def_label(&mut ctx.text, lbl_strlen.clone())
  # movzx eax, byte [rbx + r12]
  emit8(&mut ctx.text, 0x42)  # REX.X
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)  # modrm: SIB
  emit8(&mut ctx.text, 0x23)  # SIB: r12 + rbx
  x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
  x64_jcc(&mut ctx.text, CC::E, lbl_done_len.clone())
  x64_add_ri(&mut ctx.text, X64::R12, 1)
  x64_jmp(&mut ctx.text, lbl_strlen.clone())
  def_label(&mut ctx.text, lbl_done_len.clone())

  # Allocate: 24 + r12*8
  x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
  x64_shl_ri(&mut ctx.text, X64::RDI, 3)
  x64_add_ri(&mut ctx.text, X64::RDI, 24)
  x64_call_label(&mut ctx.text, "_tg_mem_alloc")
  x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # r13 = buffer

  # Store header
  # [r13+0] = data_start = r13 + 24
  x64_lea_mem(&mut ctx.text, X64::RCX, X64::R13, 24)
  x64_mov_mr(&mut ctx.text, X64::R13, 0, X64::RCX)
  # [r13+8] = len
  x64_mov_mr(&mut ctx.text, X64::R13, 8, X64::R12)
  # [r13+16] = cap
  x64_mov_mr(&mut ctx.text, X64::R13, 16, X64::R12)

  # Copy loop
  x64_mov_ri(&mut ctx.text, X64::R14, 0)
  def_label(&mut ctx.text, lbl_copy.clone())
  x64_cmp_rr(&mut ctx.text, X64::R14, X64::R12)
  x64_jcc(&mut ctx.text, CC::GE, lbl_copy_end.clone())

  # movzx eax, byte [rbx + r14]
  emit8(&mut ctx.text, 0x42)
  emit8(&mut ctx.text, 0x0F)
  emit8(&mut ctx.text, 0xB6)
  emit8(&mut ctx.text, 0x04)
  emit8(&mut ctx.text, 0x33)  # SIB: r14 + rbx

  # Store: [r13 + 24 + r14*8] = rax
  x64_mov_rr(&mut ctx.text, X64::RCX, X64::R14)
  x64_shl_ri(&mut ctx.text, X64::RCX, 3)
  x64_add_rr(&mut ctx.text, X64::RCX, X64::R13)
  x64_mov_mr(&mut ctx.text, X64::RCX, 24, X64::RAX)

  x64_add_ri(&mut ctx.text, X64::R14, 1)
  x64_jmp(&mut ctx.text, lbl_copy.clone())
  def_label(&mut ctx.text, lbl_copy_end.clone())

  # Return
  x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)

  # Epilogue
  x64_pop(&mut ctx.text, X64::R14)
  x64_pop(&mut ctx.text, X64::R13)
  x64_pop(&mut ctx.text, X64::R12)
  x64_pop(&mut ctx.text, X64::RBX)
  x64_pop(&mut ctx.text, X64::RBP)
  x64_ret(&mut ctx.text)
end

# ———————————————————————————————————————————————————————————————
# POSIX / libc Runtime Stubs
# ———————————————————————————————————————————————————————————————
#
# These implement POSIX functions as raw syscalls so the statically-linked
# binary doesn't need dynamic library resolution.  Each stub follows the
# standard C ABI for the target and issues the correct syscall for
# macOS, Linux, and Windows.
#
# macOS AArch64:  syscall number in X16, svc #0x80
# Linux AArch64:  syscall number in X8,  svc #0
# macOS x86-64:   RAX = 0x2000000 + nr, syscall
# Linux x86-64:   RAX = nr,             syscall
# Windows:        call kernel32 APIs via extern (resolved by PE linker)
#
# Syscall numbers (macOS / Linux):
#   exit    = 1 / 60
#   fork    = 2 / 57
#   read    = 3 / 0
#   write   = 4 / 1
#   open    = 5 / 2
#   close   = 6 / 3
#   wait4   = 7 / 61  (waitpid = wait4 + flags)
#   chdir   = 12 / 80
#   pipe    = 42 / 22
#   dup2    = 90 / 33
#   execve  = 59 / 59
# ———————————————————————————————————————————————————————————————

def emit_posix_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_posix_exit(ctx)
  emit_posix_fork(ctx)
  emit_posix_read(ctx)
  emit_posix_write(ctx)
  emit_posix_read_alias(ctx)
  emit_posix_write_alias(ctx)
  emit_posix_strdup(ctx)
  emit_posix_clock_gettime(ctx)
  emit_sync_fetch_and_add_runtime(ctx)
  emit_posix_open(ctx)
  emit_posix_close(ctx)
  emit_posix_close_alias(ctx)
  emit_tg_read_file_to_string(ctx)
  emit_tg_read_vec_u8(ctx)
  emit_tg_write_vec_u8(ctx)
  emit_posix_waitpid(ctx)
  emit_posix_wait(ctx)
  emit_posix_chdir(ctx)
  emit_posix_pipe(ctx)
  emit_posix_dup2(ctx)
  emit_posix_execve(ctx)
  emit_posix_execvp(ctx)
  emit_posix_getenv(ctx)
  emit_posix_create_directory_w(ctx)
end

def emit_posix_read_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_read")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_read")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_read")
  end
end

def emit_posix_write_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_write")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_write")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_write")
  end
end

def emit_posix_close_alias(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_close")
  match ctx.target.arch
  when Arch::AArch64 then a64_b(&mut ctx.text, "_tg_posix_close")
  when Arch::X86_64 then x64_jmp(&mut ctx.text, "_tg_posix_close")
  end
end

# Helper: emit a simple syscall that passes through args as-is.
# For AArch64: args already in X0-X5, syscall nr in X16 (macOS) or X8 (Linux).
# For x86-64: args in RDI,RSI,RDX,R10,R8,R9; syscall nr in RAX.

# _exit(status: Int) -> !
def emit_posix_exit(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_exit")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 1)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 93)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "ExitProcess")
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000001)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 60)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: ExitProcess(uExitCode) — RCX = exit code
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "ExitProcess")
    end
  end
  # No ret — _exit never returns
end

# fork() -> Int (pid)
def emit_posix_fork(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "fork")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 2)
      a64_svc(&mut ctx.text, 0x80)
      a64_ret(&mut ctx.text)
    when OsAbi::Linux then
      # Linux AArch64: clone with flags=SIGCHLD (fork equivalent)
      a64_mov_ri(&mut ctx.text, A64::X0, 17)  # SIGCHLD
      a64_mov_ri(&mut ctx.text, A64::X1, 0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 220)  # clone
      a64_svc(&mut ctx.text, 0)
      a64_ret(&mut ctx.text)
    when OsAbi::Windows then
      # Windows has no fork — return -1
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
      a64_ret(&mut ctx.text)
    end
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000002)
      x64_syscall(&mut ctx.text)
      x64_ret(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 57)
      x64_syscall(&mut ctx.text)
      x64_ret(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
      x64_ret(&mut ctx.text)
    end
  end
end

# _tg_posix_read(fd: Int, buf: &u8, count: UInt) -> Int
def emit_posix_read(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_read")
  let ok_label = fresh_label(ctx, ".Lposix_read_ok")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 3)
      a64_svc(&mut ctx.text, 0x80)
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 63)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # ReadFile(hFile, lpBuffer, nBytesToRead, &bytesRead, NULL)
      # Simplified: just return 0 for bootstrap
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000003)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: ReadFile via kernel32
      x64_sub_ri(&mut ctx.text, X64::RSP, 48)
      # hFile=RCX(=RDI), lpBuffer=RDX(=RSI), nBytes=R8(=RDX), lpBytesRead on stack, lpOverlapped=NULL
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::R8, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_lea_mem(&mut ctx.text, X64::R9, X64::RSP, 40)  # &bytesRead
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_mov_mr(&mut ctx.text, X64::RSP, 32, X64::RAX)  # lpOverlapped = NULL
      x64_call_extern(&mut ctx.text, "ReadFile")
      # bytesRead is at [RSP+40]
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 40)
      x64_add_ri(&mut ctx.text, X64::RSP, 48)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_posix_write(fd: Int, buf: &u8, count: UInt) -> Int
def emit_posix_write(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_write")
  let ok_label = fresh_label(ctx, ".Lposix_write_ok")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 4)
      a64_svc(&mut ctx.text, 0x80)
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 64)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000004)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, ok_label.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, ok_label.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 1)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # Windows: WriteFile via kernel32
      x64_sub_ri(&mut ctx.text, X64::RSP, 48)
      # hFile=RCX(=RDI), lpBuffer=RDX(=RSI), nBytes=R8(=RDX), lpBytesWritten on stack, lpOverlapped=NULL
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::R8, X64::RDX)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_lea_mem(&mut ctx.text, X64::R9, X64::RSP, 40)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
      x64_mov_mr(&mut ctx.text, X64::RSP, 32, X64::RAX)
      x64_call_extern(&mut ctx.text, "WriteFile")
      x64_mov_rm(&mut ctx.text, X64::RAX, X64::RSP, 40)
      x64_add_ri(&mut ctx.text, X64::RSP, 48)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_read_vec_u8(fd: Int, vec: &mut Vec[u8], count: UInt) -> Int
# Reads packed bytes into a temporary buffer, then scatters them into the
# runtime's 8-byte slot Vec layout and updates vec.len to the byte count read.
def emit_tg_read_vec_u8(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_read_vec_u8")

  let lblReturn = fresh_label(ctx, ".Lread_vec_ret")
  let lblHaveCap = fresh_label(ctx, ".Lread_vec_have_cap")
  let lblCopy = fresh_label(ctx, ".Lread_vec_copy")
  let lblCopyDone = fresh_label(ctx, ".Lread_vec_copy_done")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # fd
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # &vec slot
    a64_ldur(&mut ctx.text, A64::X20, A64::X20, 0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # count

    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_stur(&mut ctx.text, A64::X0, A64::X20, 8)  # vec.len = 0

    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblReturn.clone())

    a64_ldur(&mut ctx.text, A64::X22, A64::X20, 16)  # cap
    a64_cmp_rr(&mut ctx.text, A64::X22, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblHaveCap.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
    a64_bl(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblHaveCap.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # temp buffer

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X22)
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X21)
    a64_bl(&mut ctx.text, "_tg_posix_read")
    a64_mov_rr(&mut ctx.text, A64::X23, A64::X0)  # result

    a64_cmp_ri(&mut ctx.text, A64::X23, 0)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblReturn.clone())

    a64_ldur(&mut ctx.text, A64::X24, A64::X20, 0)  # data ptr
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # i

    def_label(&mut ctx.text, lblCopy.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X23)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())

    a64_add_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X9)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_add_rrr_lsl(&mut ctx.text, A64::X12, A64::X24, A64::X9, 3)
    a64_str(&mut ctx.text, A64::X11, A64::X12, 0)

    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_stur(&mut ctx.text, A64::X23, A64::X20, 8)

    def_label(&mut ctx.text, lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    x64_sub_ri(&mut ctx.text, X64::RSP, 8)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # fd
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RSI)  # &vec slot
    x64_mov_rm(&mut ctx.text, X64::R12, X64::R12, 0)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # count

    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R12, 8, X64::RAX)  # vec.len = 0

    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::E, lblReturn.clone())

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::R12, 16)  # cap
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblHaveCap.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_array_grow")

    def_label(&mut ctx.text, lblHaveCap.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RAX)  # temp

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_posix_read")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # result

    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::LE, lblReturn.clone())

    x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)  # remaining

    def_label(&mut ctx.text, lblCopy.clone())
    x64_cmp_ri(&mut ctx.text, X64::R15, 0)
    x64_jcc(&mut ctx.text, CC::E, lblCopyDone.clone())

    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    emit8(&mut ctx.text, 0xAC)  # LODSB
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RSI)
    x64_movzx_r64_r8(&mut ctx.text, X64::RSI, X64::RAX)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_call_label(&mut ctx.text, "_tg_array_push")

    x64_sub_ri(&mut ctx.text, X64::R15, 1)
    x64_jmp(&mut ctx.text, lblCopy)

    def_label(&mut ctx.text, lblCopyDone.clone())
    def_label(&mut ctx.text, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_add_ri(&mut ctx.text, X64::RSP, 8)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# _tg_write_vec_u8(fd: Int, vec: &Vec[u8], count: UInt) -> Int
# Gathers 8-byte slot Vec elements into a packed temporary byte buffer before
# issuing the underlying byte-oriented write syscall.
def emit_tg_write_vec_u8(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_write_vec_u8")

  let lblCountOk = fresh_label(ctx, ".Lwrite_vec_count_ok")
  let lblReturn = fresh_label(ctx, ".Lwrite_vec_ret")
  let lblGather = fresh_label(ctx, ".Lwrite_vec_gather")
  let lblGatherDone = fresh_label(ctx, ".Lwrite_vec_gather_done")
  let lblWriteLoop = fresh_label(ctx, ".Lwrite_vec_write_loop")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # fd
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X1)  # &vec slot
    a64_ldur(&mut ctx.text, A64::X20, A64::X20, 0)  # vec ptr
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X2)  # count

    a64_ldur(&mut ctx.text, A64::X22, A64::X20, 8)  # len
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblCountOk.clone())
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X22)

    def_label(&mut ctx.text, lblCountOk.clone())
    a64_mov_ri(&mut ctx.text, A64::X23, 0)  # total written = 0
    a64_cmp_ri(&mut ctx.text, A64::X21, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblReturn.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X0)  # temp buffer
    a64_ldur(&mut ctx.text, A64::X24, A64::X20, 0)  # data ptr
    a64_mov_ri(&mut ctx.text, A64::X9, 0)  # i

    def_label(&mut ctx.text, lblGather.clone())
    a64_cmp_rr(&mut ctx.text, A64::X9, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblGatherDone.clone())

    a64_add_rrr_lsl(&mut ctx.text, A64::X10, A64::X24, A64::X9, 3)
    a64_ldr(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X22, A64::X9)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)

    a64_add_rri(&mut ctx.text, A64::X9, A64::X9, 1)
    a64_b(&mut ctx.text, lblGather)

    def_label(&mut ctx.text, lblGatherDone.clone())
    # write-all loop: loop issuing _tg_posix_write until all bytes are flushed
    # (a single write syscall may do a partial write), stopping on error.
    def_label(&mut ctx.text, lblWriteLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X23, A64::X21)
    a64_bcond(&mut ctx.text, a64_cc_ge(), lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)       # fd
    a64_add_rrr(&mut ctx.text, A64::X1, A64::X22, A64::X23)  # buf + written
    a64_sub_rrr(&mut ctx.text, A64::X2, A64::X21, A64::X23)  # remaining
    a64_bl(&mut ctx.text, "_tg_posix_write")
    # EINTR (-4) is not progress and not an error: retry the write.
    a64_cmp_ri(&mut ctx.text, A64::X0, -4)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblWriteLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_le(), lblReturn.clone())  # <= 0: error/no progress, stop
    a64_add_rrr(&mut ctx.text, A64::X23, A64::X23, A64::X0)   # written += result
    a64_b(&mut ctx.text, lblWriteLoop.clone())

    def_label(&mut ctx.text, lblReturn.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X23)
    a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)
    x64_sub_ri(&mut ctx.text, X64::RSP, 8)

    x64_mov_rr(&mut ctx.text, X64::R12, X64::RDI)  # fd
    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RSI)  # &vec slot
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)  # vec ptr
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RDX)  # count

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 8)  # len
    x64_cmp_rr(&mut ctx.text, X64::R13, X64::RAX)
    x64_jcc(&mut ctx.text, CC::LE, lblCountOk.clone())
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)

    def_label(&mut ctx.text, lblCountOk.clone())
    x64_mov_ri(&mut ctx.text, X64::R15, 0)  # total written = 0
    x64_cmp_ri(&mut ctx.text, X64::R13, 0)
    x64_jcc(&mut ctx.text, CC::E, lblReturn.clone())

    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R13)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RAX)  # temp current ptr
    x64_mov_rm(&mut ctx.text, X64::RBX, X64::RBX, 0)  # data ptr
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)  # remaining

    def_label(&mut ctx.text, lblGather.clone())
    x64_cmp_ri(&mut ctx.text, X64::R14, 0)
    x64_jcc(&mut ctx.text, CC::E, lblGatherDone.clone())

    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RBX, 0)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R15)
    emit8(&mut ctx.text, 0xAA)  # STOSB
    x64_mov_rr(&mut ctx.text, X64::R15, X64::RDI)
    x64_add_ri(&mut ctx.text, X64::RBX, 8)
    x64_sub_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lblGather)

    def_label(&mut ctx.text, lblGatherDone.clone())
    # R14 = temp buffer start = end cursor (R15) - count (R13)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R15)
    x64_sub_rr(&mut ctx.text, X64::R14, X64::R13)
    # write-all loop: written in R15, temp start in R14, count in R13
    x64_mov_ri(&mut ctx.text, X64::R15, 0)
    def_label(&mut ctx.text, lblWriteLoop.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_cmp_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jcc(&mut ctx.text, CC::GE, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)   # fd
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R14)
    x64_add_rr(&mut ctx.text, X64::RSI, X64::R15)   # buf + written
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R13)
    x64_sub_rr(&mut ctx.text, X64::RDX, X64::R15)   # remaining
    x64_call_label(&mut ctx.text, "_tg_posix_write")
    # EINTR (-4) is not progress and not an error: retry the write.
    x64_cmp_ri(&mut ctx.text, X64::RAX, -4)
    x64_jcc(&mut ctx.text, CC::E, lblWriteLoop.clone())
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::LE, lblReturn.clone())  # <= 0: error/no progress, stop
    x64_add_rr(&mut ctx.text, X64::R15, X64::RAX)   # written += result
    x64_jmp(&mut ctx.text, lblWriteLoop.clone())

    def_label(&mut ctx.text, lblReturn.clone())
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R15)
    x64_add_ri(&mut ctx.text, X64::RSP, 8)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# libc_open(path: &u8, flags: Int, mode: Int) -> Int (fd)
def emit_posix_open(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_open")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 5)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      # Linux AArch64 uses openat (SYS_openat=56) with AT_FDCWD=-100
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)  # mode -> x3
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)  # flags -> x2
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # path -> x1
      a64_mov_ri(&mut ctx.text, A64::X0, -100)     # AT_FDCWD
      a64_mov_ri(&mut ctx.text, A64::X8, 56)       # openat
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000005)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 2)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # CreateFileA approximate — return -1 for now
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_posix_close(fd: Int) -> Int
def emit_posix_close(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_posix_close")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 6)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 57)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # CloseHandle
      a64_bl(&mut ctx.text, "CloseHandle")
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000006)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 3)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "CloseHandle")
    end
    x64_ret(&mut ctx.text)
  end
end

# _tg_read_file_to_string(path: *u8) -> *u8
# Opens file at path, reads entire contents into a bump-allocated NUL-terminated
# buffer, closes the file, and returns the buffer pointer (which IS a Tangerine
# String). Returns empty string on any error.
def emit_tg_read_file_to_string(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "_tg_read_file_to_string")

  let lblFail = fresh_label(ctx, ".Lrfts_fail")
  let lblDone = fresh_label(ctx, ".Lrfts_done")
  let lblOpenOk = fresh_label(ctx, ".Lrfts_open_ok")
  let lblReadLoop = fresh_label(ctx, ".Lrfts_read_loop")
  let lblReadDone = fresh_label(ctx, ".Lrfts_read_done")
  let lblReadFail = fresh_label(ctx, ".Lrfts_read_fail")
  let lblCopyLoop = fresh_label(ctx, ".Lrfts_copy_loop")
  let lblCopyDone = fresh_label(ctx, ".Lrfts_copy_done")
  let lblReturnBuffer = fresh_label(ctx, ".Lrfts_return_buf")
  let lblReturnEmpty = fresh_label(ctx, ".Lrfts_return_empty")
  let lblSeekOk = fresh_label(ctx, ".Lrfts_seek_ok")
  let lblSizeOk = fresh_label(ctx, ".Lrfts_size_ok")

  match ctx.target.arch
  when Arch::AArch64 then
    # Prologue: save FP/LR and callee-saved X19-X22
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    # X0 = path_ptr (already in X0)
    # open(path, O_RDONLY=0, mode=0)
    a64_mov_ri(&mut ctx.text, A64::X1, 0)   # O_RDONLY
    a64_mov_ri(&mut ctx.text, A64::X2, 0)   # mode
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 5)  # SYS_open
      a64_svc(&mut ctx.text, 0x80)
      # Normalize Darwin errors to negative errno like the std/fs syscall path.
      a64_neg(&mut ctx.text, A64::X15, A64::X0)
      a64_csel(&mut ctx.text, A64::X0, A64::X15, A64::X0, a64_cc_cs())
    when OsAbi::Linux then
      a64_mov_rr(&mut ctx.text, A64::X3, A64::X2)  # mode → x3
      a64_mov_rr(&mut ctx.text, A64::X2, A64::X1)  # flags → x2
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # path → x1
      a64_mov_ri(&mut ctx.text, A64::X0, -100)     # AT_FDCWD
      a64_mov_ri(&mut ctx.text, A64::X8, 56)       # openat
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    # Check if open failed (Linux: negative result, Windows: -1)
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblReturnEmpty.clone())

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # X19 = fd
    a64_mov_ri(&mut ctx.text, A64::X21, 0)        # X21 = len
    a64_mov_ri(&mut ctx.text, A64::X22, 4096)     # X22 = cap

    # Allocate an initial buffer and grow it on demand while reading to EOF.
    # This avoids depending on lseek, which has been mis-sizing files under
    # native macOS stage1 and truncating compiler source reads.
    a64_add_rri(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)  # X20 = buf_ptr

    def_label(&mut ctx.text, lblReadLoop.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblCopyDone.clone())

    # Buffer is full — grow to 2x capacity.
    # Compute new_cap = old_cap * 2, alloc new_cap + 1.
    # NOTE: X9 is caller-saved and clobbered by _tg_bump_alloc, so we
    # recompute the new capacity from X22 (callee-saved) after the call.
    a64_lsl(&mut ctx.text, A64::X0, A64::X22, 1)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    # Recompute new_cap from X22 (preserved across call)
    a64_lsl(&mut ctx.text, A64::X9, A64::X22, 1)
    a64_mov_rr(&mut ctx.text, A64::X10, A64::X20)  # old buf
    a64_mov_rr(&mut ctx.text, A64::X11, A64::X0)   # new buf
    a64_mov_rr(&mut ctx.text, A64::X12, A64::X21)  # bytes to copy

    def_label(&mut ctx.text, lblCopyLoop.clone())
    a64_cmp_ri(&mut ctx.text, A64::X12, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblCopyDone.clone())
    a64_ldrb(&mut ctx.text, A64::X13, A64::X10, 0)
    a64_strb(&mut ctx.text, A64::X13, A64::X11, 0)
    a64_add_rri(&mut ctx.text, A64::X10, A64::X10, 1)
    a64_add_rri(&mut ctx.text, A64::X11, A64::X11, 1)
    a64_sub_rri(&mut ctx.text, A64::X12, A64::X12, 1)
    a64_b(&mut ctx.text, lblCopyLoop)

    def_label(&mut ctx.text, lblCopyDone.clone())
    a64_cmp_rr(&mut ctx.text, A64::X21, A64::X22)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lblReadDone.clone())
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
    a64_mov_rr(&mut ctx.text, A64::X22, A64::X9)

    def_label(&mut ctx.text, lblReadDone.clone())
    a64_sub_rrr(&mut ctx.text, A64::X10, A64::X22, A64::X21)  # remaining cap
    a64_add_rrr(&mut ctx.text, A64::X11, A64::X20, A64::X21)  # write cursor
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)              # fd
    a64_mov_rr(&mut ctx.text, A64::X1, A64::X11)              # buf
    a64_mov_rr(&mut ctx.text, A64::X2, A64::X10)              # count
    a64_bl(&mut ctx.text, "_tg_posix_read")
    a64_cmp_ri(&mut ctx.text, A64::X0, 0)
    a64_bcond(&mut ctx.text, a64_cc_lt(), lblReadFail.clone())
    a64_bcond(&mut ctx.text, a64_cc_eq(), lblDone.clone())

    a64_add_rrr(&mut ctx.text, A64::X21, A64::X21, A64::X0)
    a64_b(&mut ctx.text, lblReadLoop)

    def_label(&mut ctx.text, lblDone.clone())
    a64_add_rrr(&mut ctx.text, A64::X9, A64::X20, A64::X21)
    a64_strb(&mut ctx.text, A64::XZR, A64::X9, 0)

    # close(fd)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_posix_close")

    # Return buf_ptr
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_b(&mut ctx.text, lblReturnBuffer.clone())

    def_label(&mut ctx.text, lblReadFail.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X19)
    a64_bl(&mut ctx.text, "_tg_posix_close")
    a64_b(&mut ctx.text, lblReturnEmpty.clone())

    def_label(&mut ctx.text, lblReturnEmpty.clone())
    a64_mov_ri(&mut ctx.text, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
    a64_strb(&mut ctx.text, A64::XZR, A64::X0, 0)

    def_label(&mut ctx.text, lblReturnBuffer.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)

    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    # Prologue: save callee-saved registers
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)

    # RDI = path_ptr (already in RDI)
    # open(path, O_RDONLY=0, mode=0)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)   # O_RDONLY
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)   # mode
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000005)  # SYS_open
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblOpenOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblOpenOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 2)  # SYS_open
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    # Linux/Windows: check for negative return
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RAX)  # RBX = fd

    # lseek(fd, 0, SEEK_END=2)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 2)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C7)  # SYS_lseek = 199
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblSizeOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblSizeOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 8)  # SYS_lseek
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    end
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())
    x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)  # R12 = file_size

    # lseek(fd, 0, SEEK_SET=0)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_mov_ri(&mut ctx.text, X64::RSI, 0)
    x64_mov_ri(&mut ctx.text, X64::RDX, 0)
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C7)
      x64_syscall(&mut ctx.text)
      x64_jcc(&mut ctx.text, CC::AE, lblSeekOk.clone())
      x64_neg_r(&mut ctx.text, X64::RAX)
      def_label(&mut ctx.text, lblSeekOk.clone())
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 8)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then ()
    end
    x64_cmp_ri(&mut ctx.text, X64::RAX, 0)
    x64_jcc(&mut ctx.text, CC::L, lblFail.clone())

    # Allocate (file_size + 8) — extra 7 bytes for safe qword NUL write
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # R13 = buf_ptr

    # read(fd, buf, file_size)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)   # fd
    x64_mov_rr(&mut ctx.text, X64::RSI, X64::R13)   # buf
    x64_mov_rr(&mut ctx.text, X64::RDX, X64::R12)   # count
    x64_call_label(&mut ctx.text, "_tg_posix_read")

    # NUL-terminate: buf[file_size] = 0 (writes 8 zero bytes, safe due to +8 alloc)
    x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)
    x64_add_rr(&mut ctx.text, X64::R14, X64::R12)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::R14, 0, X64::RAX)

    # close(fd)
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::RBX)
    x64_call_label(&mut ctx.text, "_tg_posix_close")

    # Return buf_ptr
    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_jmp(&mut ctx.text, lblDone.clone())

    # Error path
    def_label(&mut ctx.text, lblFail.clone())
    x64_mov_ri(&mut ctx.text, X64::RDI, 8)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_ri(&mut ctx.text, X64::RCX, 0)
    x64_mov_mr(&mut ctx.text, X64::RAX, 0, X64::RCX)

    def_label(&mut ctx.text, lblDone.clone())
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# waitpid(pid: Int, status: &Int, options: Int) -> Int
# macOS: wait4(pid, status, options, rusage=NULL)
def emit_posix_waitpid(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "waitpid")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(pid, status, options, rusage=NULL)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)  # rusage = NULL
      a64_mov_ri(&mut ctx.text, A64::X16, 7)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 260)  # wait4
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # WaitForSingleObject + GetExitCodeProcess — stub returns 0
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::R10, 0)   # rusage = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000007)  # wait4
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::R10, 0)  # rusage = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 61)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      # WaitForSingleObject(hProcess=RCX, INFINITE)
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_ri(&mut ctx.text, X64::RDX, -1)
      x64_call_extern(&mut ctx.text, "WaitForSingleObject")
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    end
    x64_ret(&mut ctx.text)
  end
end

# wait(status: &Int) -> Int
# Equivalent to waitpid(-1, status, 0)
def emit_posix_wait(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "wait")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(-1, status, 0, NULL)
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)  # status
      a64_mov_ri(&mut ctx.text, A64::X0, -1)       # pid = -1 (any child)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)        # options = 0
      a64_mov_ri(&mut ctx.text, A64::X3, 0)        # rusage = NULL
      a64_mov_ri(&mut ctx.text, A64::X16, 7)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_rr(&mut ctx.text, A64::X1, A64::X0)
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X3, 0)
      a64_mov_ri(&mut ctx.text, A64::X4, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 260)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # wait4(-1, status, 0, NULL)
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)  # status
      x64_mov_ri(&mut ctx.text, X64::RDI, -1)
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::R10, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x2000007)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_rr(&mut ctx.text, X64::RSI, X64::RDI)
      x64_mov_ri(&mut ctx.text, X64::RDI, -1)
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::R10, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 61)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# chdir(path: &u8) -> Int
def emit_posix_chdir(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "chdir")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 12)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 49)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "SetCurrentDirectoryA")
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200000C)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 80)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_call_extern(&mut ctx.text, "SetCurrentDirectoryA")
    end
    x64_ret(&mut ctx.text)
  end
end

# pipe(fds: &Int) -> Int
# fds points to [2]Int where fds[0]=read end, fds[1]=write end
def emit_posix_pipe(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "pipe")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 42)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 59)  # pipe2 with flags=0
      a64_mov_ri(&mut ctx.text, A64::X1, 0)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      # CreatePipe — stub returns -1
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200002A)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 22)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# dup2(oldfd: Int, newfd: Int) -> Int
def emit_posix_dup2(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "dup2")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 90)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      # Linux AArch64: dup3(oldfd, newfd, flags=0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 24)  # dup3
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200005A)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 33)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# execve(path: &u8, argv: &&u8, envp: &&u8) -> Int
def emit_posix_execve(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "execve")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      a64_mov_ri(&mut ctx.text, A64::X16, 59)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X8, 221)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200003B)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RAX, 59)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# execvp(file: &u8, argv: &&u8) -> Int
# execvp searches PATH for the executable; we implement it by calling execve
# with the path as-is (no PATH search), which is adequate for bootstrap.
# A full implementation would iterate $PATH directories.
def emit_posix_execvp(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "execvp")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::MacOS then
      # execve(file, argv, environ=0)
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X16, 59)
      a64_svc(&mut ctx.text, 0x80)
    when OsAbi::Linux then
      a64_mov_ri(&mut ctx.text, A64::X2, 0)
      a64_mov_ri(&mut ctx.text, A64::X8, 221)
      a64_svc(&mut ctx.text, 0)
    when OsAbi::Windows then
      a64_mov_ri(&mut ctx.text, A64::X0, -1)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::MacOS then
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)  # envp = NULL
      x64_mov_ri(&mut ctx.text, X64::RAX, 0x200003B)
      x64_syscall(&mut ctx.text)
    when OsAbi::Linux then
      x64_mov_ri(&mut ctx.text, X64::RDX, 0)
      x64_mov_ri(&mut ctx.text, X64::RAX, 59)
      x64_syscall(&mut ctx.text)
    when OsAbi::Windows then
      x64_mov_ri(&mut ctx.text, X64::RAX, -1)
    end
    x64_ret(&mut ctx.text)
  end
end

# strdup(src: &u8) -> String
# Allocate a fresh null-terminated copy of the input C string.
def emit_posix_strdup(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "strdup")
  let lbl_len = fresh_label(ctx, ".Lposix_strdup_len")
  let lbl_len_done = fresh_label(ctx, ".Lposix_strdup_len_done")
  let lbl_copy = fresh_label(ctx, ".Lposix_strdup_copy")

  match ctx.target.arch
  when Arch::AArch64 then
    a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
    a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
    a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
    a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)

    a64_mov_rr(&mut ctx.text, A64::X19, A64::X0)  # src ptr
    a64_mov_ri(&mut ctx.text, A64::X20, 0)        # len

    def_label(&mut ctx.text, lbl_len.clone())
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X20)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_eq(), lbl_len_done.clone())
    a64_add_rri(&mut ctx.text, A64::X20, A64::X20, 1)
    a64_b(&mut ctx.text, lbl_len.clone())

    def_label(&mut ctx.text, lbl_len_done.clone())
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
    a64_add_rri(&mut ctx.text, A64::X0, A64::X0, 1)
    a64_bl(&mut ctx.text, "_tg_bump_alloc")
    a64_mov_rr(&mut ctx.text, A64::X21, A64::X0)  # dst ptr
    a64_mov_ri(&mut ctx.text, A64::X22, 0)        # index

    def_label(&mut ctx.text, lbl_copy.clone())
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X19, A64::X22)
    a64_ldrb(&mut ctx.text, A64::X11, A64::X10, 0)
    a64_add_rrr(&mut ctx.text, A64::X12, A64::X21, A64::X22)
    a64_strb(&mut ctx.text, A64::X11, A64::X12, 0)
    a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 1)
    a64_cmp_ri(&mut ctx.text, A64::X11, 0)
    a64_bcond(&mut ctx.text, a64_cc_ne(), lbl_copy.clone())

    a64_mov_rr(&mut ctx.text, A64::X0, A64::X21)
    a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
    a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
    a64_ret(&mut ctx.text)

  when Arch::X86_64 then
    x64_push(&mut ctx.text, X64::RBP)
    x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
    x64_push(&mut ctx.text, X64::RBX)
    x64_push(&mut ctx.text, X64::R12)
    x64_push(&mut ctx.text, X64::R13)
    x64_push(&mut ctx.text, X64::R14)
    x64_push(&mut ctx.text, X64::R15)

    x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)  # src ptr
    x64_mov_ri(&mut ctx.text, X64::R12, 0)         # len
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)  # scan ptr

    def_label(&mut ctx.text, lbl_len.clone())
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [r14]
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::E, lbl_len_done.clone())
    x64_add_ri(&mut ctx.text, X64::R12, 1)
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_jmp(&mut ctx.text, lbl_len.clone())

    def_label(&mut ctx.text, lbl_len_done.clone())
    x64_mov_rr(&mut ctx.text, X64::RDI, X64::R12)
    x64_add_ri(&mut ctx.text, X64::RDI, 1)
    x64_call_label(&mut ctx.text, "_tg_bump_alloc")
    x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)  # dst start
    x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)  # src cursor
    x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)  # dst cursor

    def_label(&mut ctx.text, lbl_copy.clone())
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x0F)
    emit8(&mut ctx.text, 0xB6)
    emit8(&mut ctx.text, 0x06)  # movzx eax, byte [r14]
    emit8(&mut ctx.text, 0x41)
    emit8(&mut ctx.text, 0x88)
    emit8(&mut ctx.text, 0x07)  # mov [r15], al
    x64_add_ri(&mut ctx.text, X64::R14, 1)
    x64_add_ri(&mut ctx.text, X64::R15, 1)
    x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
    x64_jcc(&mut ctx.text, CC::NE, lbl_copy.clone())

    x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
    x64_pop(&mut ctx.text, X64::R15)
    x64_pop(&mut ctx.text, X64::R14)
    x64_pop(&mut ctx.text, X64::R13)
    x64_pop(&mut ctx.text, X64::R12)
    x64_pop(&mut ctx.text, X64::RBX)
    x64_pop(&mut ctx.text, X64::RBP)
    x64_ret(&mut ctx.text)
  end
end

# clock_gettime(clock_id: Int, tp: &u8) -> Int
# Bootstrap fallback: zero the timespec buffer and report success.
def emit_posix_clock_gettime(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "clock_gettime")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X9, 0)
    a64_stur(&mut ctx.text, A64::X9, A64::X1, 0)
    a64_stur(&mut ctx.text, A64::X9, A64::X1, 8)
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_mov_mr(&mut ctx.text, X64::RSI, 0, X64::RAX)
    x64_mov_mr(&mut ctx.text, X64::RSI, 8, X64::RAX)
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# __sync_fetch_and_add(ptr: Ptr[UInt], val: UInt) -> UInt
# Single-threaded bootstrap fallback: plain load/add/store returning the old value.
def emit_sync_fetch_and_add_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "__sync_fetch_and_add")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_ldur(&mut ctx.text, A64::X9, A64::X0, 0)
    a64_add_rrr(&mut ctx.text, A64::X10, A64::X9, A64::X1)
    a64_stur(&mut ctx.text, A64::X10, A64::X0, 0)
    a64_mov_rr(&mut ctx.text, A64::X0, A64::X9)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_rm(&mut ctx.text, X64::RAX, X64::RDI, 0)
    x64_mov_rr(&mut ctx.text, X64::RCX, X64::RAX)
    x64_add_rr(&mut ctx.text, X64::RCX, X64::RSI)
    x64_mov_mr(&mut ctx.text, X64::RDI, 0, X64::RCX)
    x64_ret(&mut ctx.text)
  end
end

# libc_getenv(name: &u8) -> &u8
# getenv is not a syscall — it reads from the environ array in the process.
# For the bootstrap compiler, we implement a minimal version that scans
# the environ pointer (set by the kernel at program startup).
# We use a global variable _tg_environ that _start should initialize.
# For now, return NULL (0) — the compiler won't need env vars to produce output.
def emit_posix_getenv(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "libc_getenv")
  match ctx.target.arch
  when Arch::AArch64 then
    a64_mov_ri(&mut ctx.text, A64::X0, 0)
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    x64_ret(&mut ctx.text)
  end
end

# CreateDirectoryW(lpPathName: &u16, lpSecurityAttributes: Ptr) -> Bool
# Windows-only; on other platforms, this is a no-op returning 0 (failure)
# since it should never actually be called on macOS/Linux.
def emit_posix_create_directory_w(ctx: &mut RuntimeEmitCtx) -> Unit
  def_runtime_fn(ctx, "CreateDirectoryW")
  match ctx.target.arch
  when Arch::AArch64 then
    match ctx.target.os
    when OsAbi::Windows then
      a64_bl(&mut ctx.text, "CreateDirectoryW_kernel32")
    when _ then
      a64_mov_ri(&mut ctx.text, A64::X0, 0)
    end
    a64_ret(&mut ctx.text)
  when Arch::X86_64 then
    match ctx.target.os
    when OsAbi::Windows then
      x64_mov_rr(&mut ctx.text, X64::RCX, X64::RDI)
      x64_mov_rr(&mut ctx.text, X64::RDX, X64::RSI)
      x64_call_extern(&mut ctx.text, "CreateDirectoryW_kernel32")
    when _ then
      x64_mov_ri(&mut ctx.text, X64::RAX, 0)
    end
    x64_ret(&mut ctx.text)
  end
end

# ———————————————————————————————————————————————————————————————
# Bump Allocator Runtime
# ———————————————————————————————————————————————————————————————
# A hardened bump allocator for struct aggregates and small allocations.
# Struct aggregates must survive function returns, so they cannot be
# stack-allocated in the callee's frame (the pointer would dangle after
# return). This allocator lazily mmaps 4 MB chunks and bumps a pointer.
#
# Properties (FROZEN contract):
#   * Guaranteed alignment: returned pointers are 16-byte aligned.
#   * Deterministic init: _tg_bump_ptr/_tg_bump_end are zero-initialized in
#     .data; the first call takes the slow path and establishes the arena.
#   * Checked failure: if mmap fails (MAP_FAILED), the runtime traps
#     (brk/ud2) instead of returning a bogus pointer.
#   * Fast path: bump _tg_bump_ptr when it fits in the current chunk.
#
# _tg_bump_alloc(size: i64) -> *void
#   Globals: _tg_bump_ptr (current pointer), _tg_bump_end (chunk end)
#   Fast path: bump pointer, return old pointer
#   Slow path: mmap new 4 MB chunk, reset pointers, bump
# ———————————————————————————————————————————————————————————————

def emit_bump_alloc_runtime(ctx: &mut RuntimeEmitCtx) -> Unit
  emit_tg_bump_alloc(ctx)
end

# _tg_bump_alloc: Bump-allocate `size` bytes (x0/rdi = size), 16-byte aligned.
# Returns pointer to allocated memory in x0/rax. Traps on allocation failure.
# Preserves X19/X20 and leaves X21-X28 untouched (callee-saved contract).
def emit_tg_bump_alloc(ctx: &mut RuntimeEmitCtx) -> Unit
   def_runtime_fn(ctx, "_tg_bump_alloc")
   match ctx.target.arch
   when Arch::AArch64 then
       let size_ok = fresh_label(ctx, ".Lbump_size_ok")
       let fast    = fresh_label(ctx, ".Lbump_fast")
       let slow    = fresh_label(ctx, ".Lbump_slow")
       let fail    = fresh_label(ctx, ".Lbump_fail")
       let done    = fresh_label(ctx, ".Lbump_done")

       a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
       a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
       a64_stp_pre(&mut ctx.text, A64::X19, A64::X20, A64::SP, -16)
       a64_stp_pre(&mut ctx.text, A64::X21, A64::X22, A64::SP, -16)
       a64_stp_pre(&mut ctx.text, A64::X23, A64::X24, A64::SP, -16)

       # X19 = align16(X0): guaranteed 16-byte alignment.
       a64_add_rri(&mut ctx.text, A64::X19, A64::X0, 15)
       a64_lsr(&mut ctx.text, A64::X19, A64::X19, 4)
       a64_lsl(&mut ctx.text, A64::X19, A64::X19, 4)
       a64_cmp_ri(&mut ctx.text, A64::X19, 0)
       a64_mov_ri(&mut ctx.text, A64::X20, 16)
       a64_csel(&mut ctx.text, A64::X19, A64::X20, A64::X19, a64_cc_eq())

       # X22 = &_tg_bump_ptr (base; end lives at +8).
       add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, "_tg_bump_ptr".to_string(), 0)
       emit32_le(&mut ctx.text, 0x90000000 | a64_code(A64::X22))
       add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, "_tg_bump_ptr".to_string(), 0)
       a64_add_rri(&mut ctx.text, A64::X22, A64::X22, 0)

       # X20 = current ptr, X21 = chunk end.
       a64_ldr(&mut ctx.text, A64::X20, A64::X22, 0)
       a64_ldr(&mut ctx.text, A64::X21, A64::X22, 8)

       # Fast path: available = end - ptr >= size ?
       a64_sub_rrr(&mut ctx.text, A64::X23, A64::X21, A64::X20)
       a64_cmp_rr(&mut ctx.text, A64::X23, A64::X19)
       a64_bcond(&mut ctx.text, a64_cc_cs(), fast.clone())
       a64_b(&mut ctx.text, slow.clone())

       def_label(&mut ctx.text, fast.clone())
       a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X19)
       a64_str(&mut ctx.text, A64::X24, A64::X22, 0)
       a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
       a64_b(&mut ctx.text, done.clone())

       # Slow path: allocate a fresh chunk sized to the request.
       def_label(&mut ctx.text, slow.clone())

       # Large allocations (requested > 2 MiB) get a dedicated page-aligned
       # mapping so one oversized buffer never displaces the small-object arena.
       a64_cmp_ri(&mut ctx.text, A64::X19, 0x200000)
       let arena_path = fresh_label(ctx, ".Lbump_arena")
       a64_bcond(&mut ctx.text, a64_cc_le(), arena_path.clone())

       # Dedicated path: X1 = page_align(X19) = ((X19 + 0xFFF) >> 12) << 12.
       a64_add_rri(&mut ctx.text, A64::X21, A64::X19, 0xFFF)
       a64_lsr(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_lsl(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_mov_ri(&mut ctx.text, A64::X0, 0)
       a64_mov_rr(&mut ctx.text, A64::X1, A64::X21)
       a64_mov_ri(&mut ctx.text, A64::X2, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X16, 197)
         a64_svc(&mut ctx.text, 0x80)
       when OsAbi::Linux then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X8, 222)
         a64_svc(&mut ctx.text, 0)
       when _ then a64_brk(&mut ctx.text, 1)
       end
       # Checked failure: MAP_FAILED has the sign bit set.
       a64_cmp_ri(&mut ctx.text, A64::X0, 0)
       a64_bcond(&mut ctx.text, a64_cc_lt(), fail.clone())
       # Dedicated mapping is returned as-is; the bump arena is left untouched.
       a64_b(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, arena_path.clone())
       # mapping_size = max(4 MiB, page_align(X19)) computed in X23.
       a64_add_rri(&mut ctx.text, A64::X21, A64::X19, 0xFFF)
       a64_lsr(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_lsl(&mut ctx.text, A64::X21, A64::X21, 12)
       a64_mov_ri(&mut ctx.text, A64::X23, 0x400000)
       a64_cmp_rr(&mut ctx.text, A64::X21, A64::X23)
       a64_csel(&mut ctx.text, A64::X23, A64::X21, A64::X23, a64_cc_gt())

       a64_mov_ri(&mut ctx.text, A64::X0, 0)
       a64_mov_rr(&mut ctx.text, A64::X1, A64::X23)
       a64_mov_ri(&mut ctx.text, A64::X2, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x1002)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X16, 197)
         a64_svc(&mut ctx.text, 0x80)
       when OsAbi::Linux then
         a64_mov_ri(&mut ctx.text, A64::X3, 0x22)
         a64_mov_ri(&mut ctx.text, A64::X4, -1)
         a64_mov_ri(&mut ctx.text, A64::X5, 0)
         a64_mov_ri(&mut ctx.text, A64::X8, 222)
         a64_svc(&mut ctx.text, 0)
       when _ then a64_brk(&mut ctx.text, 1)
       end
       # Checked failure: MAP_FAILED has the sign bit set.
       a64_cmp_ri(&mut ctx.text, A64::X0, 0)
       a64_bcond(&mut ctx.text, a64_cc_lt(), fail.clone())

       # Deterministic arena init: base = X0, end = base + mapping_size (X23).
       a64_mov_rr(&mut ctx.text, A64::X20, A64::X0)
       a64_add_rrr(&mut ctx.text, A64::X21, A64::X20, A64::X23)
       a64_str(&mut ctx.text, A64::X20, A64::X22, 0)
       a64_str(&mut ctx.text, A64::X21, A64::X22, 8)
       # Bump and return base.
       a64_add_rrr(&mut ctx.text, A64::X24, A64::X20, A64::X19)
       a64_str(&mut ctx.text, A64::X24, A64::X22, 0)
       a64_mov_rr(&mut ctx.text, A64::X0, A64::X20)
       a64_b(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, fail.clone())
       a64_brk(&mut ctx.text, 1)

       def_label(&mut ctx.text, done.clone())
       a64_ldp_post(&mut ctx.text, A64::X23, A64::X24, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::X21, A64::X22, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::X19, A64::X20, A64::SP, 16)
       a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
       a64_ret(&mut ctx.text)
   when Arch::X86_64 then
       let size_ok = fresh_label(ctx, ".Lbump_size_ok")
       let fast    = fresh_label(ctx, ".Lbump_fast")
       let slow    = fresh_label(ctx, ".Lbump_slow")
       let fail    = fresh_label(ctx, ".Lbump_fail")
       let done    = fresh_label(ctx, ".Lbump_done")

       x64_push(&mut ctx.text, X64::RBP)
       x64_mov_rr(&mut ctx.text, X64::RBP, X64::RSP)
       x64_push(&mut ctx.text, X64::RBX)
       x64_push(&mut ctx.text, X64::R12)
       x64_push(&mut ctx.text, X64::R13)
       x64_push(&mut ctx.text, X64::R14)
       x64_push(&mut ctx.text, X64::R15)

       # RBX = align16(RDI): guaranteed 16-byte alignment.
       x64_add_ri(&mut ctx.text, X64::RDI, 15)
       x64_and_ri(&mut ctx.text, X64::RDI, -16)
       x64_cmp_ri(&mut ctx.text, X64::RDI, 0)
       x64_jcc(&mut ctx.text, CC::NE, size_ok.clone())
       x64_mov_ri(&mut ctx.text, X64::RDI, 16)
       def_label(&mut ctx.text, size_ok.clone())
       x64_mov_rr(&mut ctx.text, X64::RBX, X64::RDI)

       # R12 = &_tg_bump_ptr (RIP-relative; end lives at +8).
       emit8(&mut ctx.text, 0x48)
       emit8(&mut ctx.text, 0x8D)
       emit8(&mut ctx.text, 0x05)
       add_reloc(&mut ctx.text, RelocKind::R_X86_64_PC32, "_tg_bump_ptr".to_string(), -4)
       emit32_le(&mut ctx.text, 0)
       x64_mov_rr(&mut ctx.text, X64::R12, X64::RAX)

       # R13 = current ptr, R14 = chunk end.
       x64_mov_rm(&mut ctx.text, X64::R13, X64::R12, 0)
       x64_mov_rm(&mut ctx.text, X64::R14, X64::R12, 8)

       # Fast path: available = end - ptr >= size ?
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R14)
       x64_sub_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_cmp_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_jcc(&mut ctx.text, CC::AE, fast.clone())
       x64_jmp(&mut ctx.text, slow.clone())

       def_label(&mut ctx.text, fast.clone())
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R15)
       x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
       x64_jmp(&mut ctx.text, done.clone())

       # Slow path: allocate a fresh chunk sized to the request.
       def_label(&mut ctx.text, slow.clone())

       # Large allocations (requested > 2 MiB) get a dedicated page-aligned
       # mapping so one oversized buffer never displaces the small-object arena.
       x64_cmp_ri(&mut ctx.text, X64::RBX, 0x200000)
       let arena_path = fresh_label(ctx, ".Lbump_arena")
       x64_jcc(&mut ctx.text, CC::A, arena_path.clone())

       # Dedicated path: RSI = page_align(RBX) = ((RBX + 0xFFF) >> 12) << 12.
       x64_mov_rr(&mut ctx.text, X64::RSI, X64::RBX)
       x64_add_ri(&mut ctx.text, X64::RSI, 0xFFF)
       x64_shr_ri(&mut ctx.text, X64::RSI, 12)
       x64_shl_ri(&mut ctx.text, X64::RSI, 12)
       x64_mov_ri(&mut ctx.text, X64::RDI, 0)
       x64_mov_ri(&mut ctx.text, X64::RDX, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
       when OsAbi::Linux then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 9)
       when _ then x64_ud2(&mut ctx.text)
       end
       x64_syscall(&mut ctx.text)
       # Checked failure: MAP_FAILED has the sign bit set.
       x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
       x64_jcc(&mut ctx.text, CC::S, fail.clone())
       # Dedicated mapping is returned as-is; the bump arena is left untouched.
       x64_jmp(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, arena_path.clone())
       # mapping_size = max(4 MiB, page_align(RBX)) computed in R15 (callee-saved).
       x64_mov_ri(&mut ctx.text, X64::R15, 0x400000)
       x64_mov_rr(&mut ctx.text, X64::R14, X64::RBX)
       x64_add_ri(&mut ctx.text, X64::R14, 0xFFF)
       x64_shr_ri(&mut ctx.text, X64::R14, 12)
       x64_shl_ri(&mut ctx.text, X64::R14, 12)
       x64_cmp_rr(&mut ctx.text, X64::R14, X64::R15)
       x64_cmova_rr(&mut ctx.text, X64::R15, X64::R14)

       x64_mov_rr(&mut ctx.text, X64::RSI, X64::R15)
       x64_mov_ri(&mut ctx.text, X64::RDI, 0)
       x64_mov_ri(&mut ctx.text, X64::RDX, 3)   # PROT_READ|PROT_WRITE
       match ctx.target.os
       when OsAbi::MacOS then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x1002)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 0x20000C5)
       when OsAbi::Linux then
         x64_mov_ri(&mut ctx.text, X64::R10, 0x22)
         x64_mov_ri(&mut ctx.text, X64::R8, -1)
         x64_mov_ri(&mut ctx.text, X64::R9, 0)
         x64_mov_ri(&mut ctx.text, X64::RAX, 9)
       when _ then x64_ud2(&mut ctx.text)
       end
       x64_syscall(&mut ctx.text)
       # Checked failure: MAP_FAILED has the sign bit set.
       x64_test_rr(&mut ctx.text, X64::RAX, X64::RAX)
       x64_jcc(&mut ctx.text, CC::S, fail.clone())

       # Deterministic arena init: base = RAX, end = base + mapping_size (R15).
       x64_mov_rr(&mut ctx.text, X64::R13, X64::RAX)
       x64_mov_rr(&mut ctx.text, X64::R14, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R14, X64::R15)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R13)
       x64_mov_mr(&mut ctx.text, X64::R12, 8, X64::R14)
       # Bump and return base.
       x64_mov_rr(&mut ctx.text, X64::R15, X64::R13)
       x64_add_rr(&mut ctx.text, X64::R15, X64::RBX)
       x64_mov_mr(&mut ctx.text, X64::R12, 0, X64::R15)
       x64_mov_rr(&mut ctx.text, X64::RAX, X64::R13)
       x64_jmp(&mut ctx.text, done.clone())

       def_label(&mut ctx.text, fail.clone())
       x64_ud2(&mut ctx.text)

       def_label(&mut ctx.text, done.clone())
       x64_pop(&mut ctx.text, X64::R15)
       x64_pop(&mut ctx.text, X64::R14)
       x64_pop(&mut ctx.text, X64::R13)
       x64_pop(&mut ctx.text, X64::R12)
       x64_pop(&mut ctx.text, X64::RBX)
       x64_pop(&mut ctx.text, X64::RBP)
       x64_ret(&mut ctx.text)
   end
end

