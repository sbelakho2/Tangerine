# Tangerine Compiler — Semantic Slices over lowered MIR (audit §33)
# Self-hosting compiler written in Tangerine
#
# Compiler-derived SLICES over the VERIFIED MIR program (the instance the
# compile phases guard with verify_mir — every entry takes a lowered
# MirProgram; no AST/typed/env state is read). A slice is a set of
# statement-level MIR nodes + external anchors as stable key texts — never
# MIR indices, never spans (SliceResult.span_keys are presentation-only
# and never enter slice_digest — the §29 spans-are-metadata protocol).
#
# STATEMENT IDENTITY — MirStatement records carry NO stable id (the only
# MIR ids are the per-function MirLocalId/MirBlockId domains), so nodes
# are indexed DETERMINISTICALLY by (function key, block index, statement
# index) as the audit prescribes:
#   function key = the MirFunction EMISSION NAME (f.name — the only
#     identity the lowered program carries; the snapshot walks use the
#     same text). The stable DEF key text ("path::name#signature")
#     resolves only through the typed program's resolver tables —
#     MirProgram-only slices cannot build it — DOCUMENTED GAP (the §30
#     boundary for IR-synthesized bodies).
#   block index  = MirBlockId.id (deterministic at lowering; passes may
#     DELETE blocks and leave gaps, so ids — never Vec positions).
#   stmt index   = the index in MirBlock.statements; the block TERMINATOR
#     is the block's final node.
#   Statement key text "<fn emission name>#B<block id>#S<stmt index>",
#   terminator key text "<fn emission name>#B<block id>#T". Deterministic
#   per verified program; the digest form rides slice_digest.
#
# THE LOCATOR-vs-STABLE SPLIT (audit item 47): the node key texts above —
# and every statement list / snapshot site field that carries them — are
# DENSE WITHIN-SNAPSHOT LOCATORS (SnapshotMirLocator records,
# stable_ids.tg section 8): the statement ordinal IS the key, so one
# unrelated insertion mid-block renumbers the whole tail of the block's
# "#S" domain. The REVISION-STABLE identity of the node behind a locator
# is CONTENT-derived — StableSemanticNodeId (stable_ids.tg section 8) —
# by the derivation section at the bottom of this module
# (stable_node_id_of / stable_node_ids_of_slice): operation kind word +
# destination place/local key + operand key texts in render order +
# predecessor context (the previous statement's own content key, or the
# block entry marker — an insertion before statement k re-keys only the
# chain from k onward). Locators stay the slice rows' and snapshot site
# fields' text; stable node ids are derived on demand from the same
# verified program.
#
# THE DEF-USE MODEL:
#   - A VALUE is one local slot (MirLocalId.id — the §33 ValueId
#     adaptation; the mir.tg optimizer's collect_operand_read /
#     collect_rvalue_reads / collect_call_arg_read /
#     collect_terminator_reads helpers all reason in local ids). Local 0
#     is the "_ret" RETURN PLACE (start_function's convention): MirReturn
#     terminators READ local 0 (no statement reads the slot).
#   - READ of a value: operand reads (place roots), MirRef/MirDiscriminant/
#     MirLen places, phi sources, call FUNC operands, and call ARGUMENTS —
#     mirroring collect_call_arg_read VERBATIM: a BARE local passed with
#     the Initialize (set) effect is a WRITE, not a read. A MirDeinit
#     READS the destroyed place (its final use).
#   - DEF of a value: a MirAssign/MirCall whose destination is the BARE
#     local (the write that ENDS a def chain). A projected destination is
#     a PARTIAL DEF: it affects a piece of the value, is included, feeds
#     its operand reads into the chain, but does NOT end it (the aggregate
#     base is defined earlier).
#   - Def-use edge: a use U is fed by the nearest def of the same local
#     scanning BACKWARD over the block's linear order (in-block exact); a
#     use with no def in its block is fed from the PREDECESSOR blocks (a
#     bounded worklist over the CFG — Goto/SwitchInt/Call/Assert/Deinit
#     targets, never a full reaching-def fixed point). MIR is NOT
#     single-assignment: def chains resolve per use, so slice_value seeds
#     one backward walk per use site.
#
# THE FOUR SLICES:
#   slice_value(fn_key, value_id) — the value's def chain (its def, the
#     partial defs affecting it, the defs of every operand those defs read
#     — recursively), resolved from every use site. A value with NO use
#     sites yields the empty slice (documented).
#   slice_statement(fn_key, stmt_key) — the forward use slice of the
#     statement's defs: nodes transitively reading the defined value,
#     forward per block and propagated to SUCCESSOR blocks (a bare
#     redefinition KILLS the chain; partial defs pass through). A def
#     escaping through a call edge records the external anchor
#     "call:<callee emission name>:arg<n>"; a node with no defs yields
#     the empty slice (documented).
#   slice_failure(diag) — the statements contributing to a diagnostic:
#     its primary site maps to a MIR node through the SPAN MAP (below);
#     the result = the FAILURE TRACE (the enclosing block's statements
#     from its head through the mapped node) UNION the anchored def chains
#     of the failing node's read operands (an assert's condition+bounds).
#   slice_effect(class) — one result per function whose DIRECT §11 summary
#     has the class: the class's DIRECT sites (MirCall/MirDeinit
#     terminators whose §11 classification dirties the class —
#     mir_effect_classify_call/_deinit reused verbatim — plus the
#     string-concat MirBinOp::Add assignment and the fail-closed algebraic
#     perform) plus each site's anchored def chains of the values it
#     reads. A class reaching a function only through in-program callees
#     is NOT re-listed: its sites live in the callee's own row.
#
# THE TYPED ENTRY (audit item 22): mir_slice(Option[MirProgram],
# MirSliceRequest) routes ONE kind onto those engines (Failure onto the
# node-anchored slice_failure machinery above) plus the module-local
# walks: ControlDependence (the TRANSITIVE closure of the standard
# Ferrante/Ottenstein/Warren control-dependence graph over the anchor
# block — the CFG-only slice; the conditions' def chains stay the
# dataflow kinds' business) and Ownership (the nodes whose operand/place
# keys touch the anchor's local/place family — conservative). Third-audit
# item 20/22 adds the MIR GRAPH REASONING kinds at the bottom of this
# module — Dominators / PostDominators / Loops / ReachingDefs / Path —
# keyed by the item-16 role-derived stable statement ids and the §1
# StableMirBlockId.stable_key texts. Request anchors are the §33
# node key texts "<fn emission name>#B<block id>#S<stmt index>" / "#T",
# the §27 local key texts (declared name or the "l<id>" locator), the §7
# place key texts (root + projections over the MIR type table) or the
# effect-class words "alloc" / "block" / "io" — the per-kind grammar and
# the error mapping live at the entry's own doc below.
#
# SPAN MAP (how diagnostics map to statements): every lowered node
# carries its source Span (synthesized nodes carry span_dummy). A
# diagnostic's Option[Span] resolves deterministically over program order
# (functions in MirProgram.functions order, blocks in Vec order,
# statements in index order, then the terminator): tier 1 CONTAINS the
# diagnostic start offset; tier 2 overlaps it; tier 3 the smallest |start
# gap|; file texts compare only when both are non-empty. No
# span-to-statement table exists (presentation-grade); an unmapped
# diagnostic yields the empty result (documented).
#
# BOUNDEDNESS / APPROXIMATIONS (deterministic, documented): at most
# slice_max_items work items per call; a wanted PARAMETER reaching the
# ENTRY block's head records the "param:<index>:<name>" anchor; any other
# never-defined wanted local drops silently; a walk exhausting its budget
# stops adding (the deterministic FIFO-worklist prefix). Control
# dependence is not modeled by the FOUR BASE SLICES below (the failure
# trace is the only control-flow term there); the typed entry's
# ControlDependence kind models it properly (the item-20/22 CDG closure in
# the MIR GRAPH REASONING section). Goto/Abort/Unreachable carry no
# operands and are never reads.
#
# COMPLETENESS (audit item 9): EVERY result carries the shared
# semantic_model.tg CompletenessInfo (SliceResult.info / MirSlice.info /
# the query envelope's QueryResults.completeness):
#   Complete — the analysis is exact and within caps (an in-block def
#     chain, a converged whole-function graph, an exact projected-place
#     Ownership anchor, a real zero answer).
#   ConservativeSuperset — the engine may include extra nodes: the
#     path-insensitive predecessor/successor union of the def-chain walks
#     (a def/use on an infeasible CFG path), the root-only Ownership
#     family, the anchored def chains of Failure/Effects/Path.
#   ConservativeSubset — a known limitation may omit: the reaching-def
#     SELF-LOOP residual (ctx.preds/succs drop self edges — a def later in
#     a block reaching an earlier use through the block's own self-loop
#     edge is not propagated; the reason names the model) and a CDG anchor
#     without a postdominator position (a non-terminating region).
#   Truncated — a cap fired; the reason names the cap and
#     omitted_lower_bound carries the unprocessed work items.
# The class/reason/visited/returned/omitted/model fields are populated at
# the engine (slice_back_info / slice_fwd_info / the per-engine builders)
# and the WORST class wins. The typed entry's `require` gate
# (SliceRequirement::ProofComplete) fails with
# MirSliceError::IncompleteRequirement naming the class + reason instead
# of returning an incomplete answer (BestEffort, the default, returns the
# annotated answer).
#
# DETERMINISM: bounded worklists process FIFO; every result Vec sorts
# (statements, span keys and externals textually) before leaving the
# module; slice_digest hashes the SORTED canonical JSONL row set (spans
# and digest words never serialize; the completeness info is proof
# metadata, not slice identity, so it never enters the preimage).

use std::collections::{Vec, Map, Set}

use tg_compiler::ids::{
  StableDigest, InstanceId, CallableId, DefId, ModuleId,
  generic_arg_type_view,
  stable_digest_of
}
use tg_compiler::token::{Span, span_dummy}
use tg_compiler::parser::{Diagnostic}
use tg_compiler::stable_ids::{
  SnapshotMirLocator, StableSemanticNodeId, StableMirBlockId, StableMirStatementId,
  stable_mir_node_key_text, stable_semantic_node_id_of, stable_semantic_node_id_of_origin,
  snapshot_mir_locator_of_key, stable_decl_of_key, stable_hir_node_id_of,
  mir_node_origin_stable_id,
  stable_mir_block_of_key, stable_mir_role_drop, stable_mir_role_bounds_check,
  stable_mir_role_contract_check, stable_mir_statement_id_of_role,
  stable_mir_statement_id_of_origin, stable_mir_statement_role_key_text, instance_key_to_text
}
use tg_compiler::types::{
  AccessEffect, EffectClass, EffectSummary, Type,
  effect_class_slot_index, effect_summary_has_class, type_query_kind_name
}
use tg_compiler::mono::{type_to_mangled}
use tg_compiler::semantic_model::{
  semantic_json_escape, semantic_strings_sort, semantic_ints_sort,
  SliceCompleteness, CompletenessInfo,
  slice_completeness_word, slice_completeness_of_word, slice_completeness_is_complete,
  completeness_info_complete, completeness_info_superset, completeness_info_subset,
  completeness_info_truncated, completeness_info_eq, completeness_info_render
}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirStatement, MirStatementKind, MirRvalue, MirRvalueKind, MirBinOp,
  MirUnOp, CastKind, MirOperand, MirOperandKind, MirConstant, MirConstantKind, MirTerminator,
  MirTerminatorKind, MirTypeDefKind, AggregateKind, MirCallArg, MirCallValue, Place,
  Projection, AssertMessage, MirContract, MirContractKind, MirEffectState,
  MirBlock, MirLocal, MirBlockId, MirLocalId, SwitchTarget, place_local, operand_copy, operand_constant,
  compute_dominators, mir_idom_dominates, terminator_successor_ids,
  mir_effect_scan_function, mir_effect_classify_call,
  mir_effect_classify_deinit, mir_effect_place_type,
  mir_effect_operand_is_string, mir_effect_type_is_string_like,
  MirNodeOrigin, mir_node_origin_of_stable_id, mir_node_origin_text
}

# ———————————————————————————————————————————————————————————————
# Result record and budgets
# ———————————————————————————————————————————————————————————————

# One slice's result: sorted stable key texts of the included statements,
# sorted external anchors (call edges the defs escape through; parameters
# the def chains end at), presentation-only span keys ("<stmt key>|<
# file>:<start>-<end>", one per included node with a real span) and the
# shared completeness record (audit item 9 — semantic_model.tg's
# CompletenessInfo: the class, the truncation/limitation reason, the
# visited/returned counts, the omitted lower bound and the analysis-model
# word). span_keys never enter the digest (presentation-only); the
# completeness info is proof metadata, not slice IDENTITY, so it stays out
# of slice_digest's preimage too (documented).
struct SliceResult
  function_key: String
  statements: Vec[String] = Vec::new()
  external: Vec[String] = Vec::new()
  span_keys: Vec[String] = Vec::new()
  info: CompletenessInfo = CompletenessInfo {}
end

# The empty result (an invalid key, an unmapped span, a no-def slice): an
# exact answer with no nodes (the analysis ran and found nothing —
# Complete, model "slice-empty").
def slice_result_empty() -> SliceResult
  SliceResult {
    function_key: "",
    statements: Vec::new(),
    external: Vec::new(),
    span_keys: Vec::new(),
    info: completeness_info_complete("slice-empty".to_string(), 0, 0)
  }
end

# The deterministic cap of every engine below.
def slice_max_items() -> Int
  4096
end

# ———————————————————————————————————————————————————————————————
# The analysis-model vocabulary (the completeness records' trust key)
# ———————————————————————————————————————————————————————————————
# ONE stable word per engine; every result of one engine carries its word
# (documented in the engine's completeness rule). The models are:
#   mir-value-def-chain          — slice_value's per-use backward chains.
#   mir-node-def-chain           — the node-anchored BackwardDataflow slice.
#   mir-forward-use-chain        — slice_statement's forward use chains.
#   mir-local-use-chain          — the local-anchored ForwardDataflow slice.
#   mir-failure-trace-def-chain  — slice_failure's trace + anchored chains.
#   mir-effect-direct-sites-def-chain — slice_effect's direct sites + chains.
#   mir-place-family-touch       — the Ownership walk's place-family match.
#   mir-cdg-fow-closure          — the standard CDG closure walk.
#   mir-dominators-chk           — the Cooper/Harvey/Kennedy idom.
#   mir-postdominators-reverse-fixpoint — the reverse-CFG postdominator sets.
#   mir-natural-loops            — the natural-loop forest.
#   mir-reaching-defs-may-inblock-scan — the may-reaching-def fixpoint.
#   mir-path-site-def-chain      — the drop/effect path slice.
#   slice-empty                  — an exact empty answer.
def slice_model_value_chain() -> String
  "mir-value-def-chain"
end

def slice_model_node_chain() -> String
  "mir-node-def-chain"
end

def slice_model_forward_chain() -> String
  "mir-forward-use-chain"
end

def slice_model_local_forward() -> String
  "mir-local-use-chain"
end

def slice_model_failure() -> String
  "mir-failure-trace-def-chain"
end

def slice_model_effect() -> String
  "mir-effect-direct-sites-def-chain"
end

def slice_model_ownership() -> String
  "mir-place-family-touch"
end

def slice_model_cdg() -> String
  "mir-cdg-fow-closure"
end

def slice_model_dominators() -> String
  "mir-dominators-chk"
end

def slice_model_postdominators() -> String
  "mir-postdominators-reverse-fixpoint"
end

def slice_model_loops() -> String
  "mir-natural-loops"
end

def slice_model_reaching() -> String
  "mir-reaching-defs-may-inblock-scan"
end

def slice_model_path() -> String
  "mir-path-site-def-chain"
end

# ———————————————————————————————————————————————————————————————
# Statement-key text helpers (the §33 stable text domain)
# ———————————————————————————————————————————————————————————————

# Node keys: statements "#S<idx>"; the terminator "#T" (its index is
# MirBlock.statements.len(), so the spellings never collide).
def slice_stmt_key(name: String, block_id: Int, idx: Int) -> String
  name + "#B" + block_id.to_string() + "#S" + idx.to_string()
end

def slice_term_key(name: String, block_id: Int) -> String
  name + "#B" + block_id.to_string() + "#T"
end

# A fresh copy of a span (field-clone idiom).
def slice_span_copy(sp: Span) -> Span
  Span { file: sp.file.clone(), start: sp.start, end_pos: sp.end_pos }
end

# The presentation span key "<stmt key>|<file>:<start>-<end>" ("" when dummy).
def slice_span_key(node_key: String, span: Span) -> String
  if span.start == 0 && span.end_pos == 0 && span.file.len() == 0 then
    return ""
  end
  node_key + "|" + span.file.clone() + ":" + span.start.to_string() + "-" + span.end_pos.to_string()
end

# Whether a text is all ASCII digits (the key-component validation).
def slice_is_digits(text: String) -> Bool
  if text.len() == 0 then return false end
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch < "0" || ch > "9" then
      return false
    end
    i = i + 1
  end
  true
end

# The deterministic Int parse of a non-empty digit text.
def slice_text_to_int(text: String) -> Int
  var value = 0
  var i = 0
  while i < text.len() do
    let bs = text.slice(i, i + 1).bytes()
    if bs.len() > 0 then
      value = value * 10 + (bs[0] as Int - 48)
    end
    i = i + 1
  end
  value
end

# The LAST "#B" marker of a key (-1 when absent; emission names never
# contain "#", so the last marker is the key's).
def slice_key_marker(key: String) -> Int
  var i = key.len() - 2
  while i >= 0 do
    if key.slice(i, i + 2) == "#B" then
      return i
    end
    i = i - 1
  end
  -1
end

# Parse a node key into (block id, node index, is_terminator); the fn prefix
# must equal name; Option::None when malformed.
def slice_key_parts(name: String, key: String) -> Option[(Int, Int, Bool)]
  let mark = slice_key_marker(&key)
  if mark <= 0 then return Option::None end
  if key.slice(0, mark) != name then return Option::None end
  var i = mark + 2
  var block_text = ""
  while i < key.len() do
    let ch = key.slice(i, i + 1)
    if ch == "#" then
      break
    elsif ch < "0" || ch > "9" then
      return Option::None
    end
    block_text = block_text + ch
    i = i + 1
  end
  if block_text.len() == 0 || i >= key.len() then return Option::None end
  if key.slice(i, key.len()) == "#T" then
    return Option::Some((slice_text_to_int(&block_text), -1, true))
  end
  if key.slice(i, i + 2) != "#S" then return Option::None end
  let idx_text = key.slice(i + 2, key.len())
  if !slice_is_digits(&idx_text) then return Option::None end
  Option::Some((slice_text_to_int(&block_text), slice_text_to_int(&idx_text), false))
end

# ———————————————————————————————————————————————————————————————
# Per-function index — the program's node universe, built once per call
# ———————————————————————————————————————————————————————————————

struct SliceFnCtx
  # the function's emission name (its slice function key).
  name: String
  # the function body.
  f: MirFunction
  # MirBlockId.id -> block Vec index.
  block_of_id: Map[Int, Int]
  # predecessor / successor blocks (their Vec indices) per block Vec idx.
  preds: Map[Int, Vec[Int]]
  succs: Map[Int, Vec[Int]]
end

# The registered Clone surface of the per-function slice index: the walk
# states (SliceBack / SliceFwd) own one ctx each and read a cloned
# snapshot in their completeness classifiers, so cloning a walk state
# must duplicate the index — the name and the MirFunction duplicate
# through their own Clone, the maps through Map's.  Registering it lets
# the walk states' derived clones discharge their `ctx` component.
impl Clone for SliceFnCtx
  def clone(self: Self) -> SliceFnCtx
    SliceFnCtx {
      name: self.name.clone(),
      f: self.f.clone(),
      block_of_id: self.block_of_id.clone(),
      preds: self.preds.clone(),
      succs: self.succs.clone()
    }
  end
end

# The FIRST function's ctx by emission name (first-wins on duplicates);
# Option::None when absent.
def slice_fn_find(mir: MirProgram, name: String) -> Option[SliceFnCtx]
  var found = -1
  var fi = 0
  while fi < mir.functions.len() do
    if mir.functions[fi].name == name then
      found = fi
      break
    end
    fi = fi + 1
  end
  if found < 0 then return Option::None end
  let f = mir.functions[found]
  var block_of_id: Map[Int, Int] = Map::new()
  var preds: Map[Int, Vec[Int]] = Map::new()
  var succs: Map[Int, Vec[Int]] = Map::new()
  var bi = 0
  while bi < f.blocks.len() do
    block_of_id.insert(f.blocks[bi].id.id, bi)
    preds.insert(bi, Vec::new())
    succs.insert(bi, Vec::new())
    bi = bi + 1
  end
  # The CFG edge maps (by Vec index), from the terminator targets (return,
  # abort and unreachable end the flow).
  var pi = 0
  while pi < f.blocks.len() do
    var out_targets: Vec[Int] = Vec::new()
    match f.blocks[pi].terminator.kind
    when MirTerminatorKind::MirGoto(target) then out_targets.push(target.id)
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      for arm in targets do
        out_targets.push(arm.target.id)
      end
      out_targets.push(default_target.id)
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
      out_targets.push(success.id)
      match unwind
      when Option::Some(u) then out_targets.push(u.id)
      when Option::None then ()
      end
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      out_targets.push(target.id)
      match unwind
      when Option::Some(u2) then out_targets.push(u2.id)
      when Option::None then ()
      end
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      out_targets.push(target.id)
      match unwind
      when Option::Some(u3) then out_targets.push(u3.id)
      when Option::None then ()
      end
    when _ then ()
    end
    var ti = 0
    while ti < out_targets.len() do
      var tv = -1
      match block_of_id.get(out_targets[ti])
      when Option::Some(v2) then tv = v2
      when Option::None then ()
      end
      if tv >= 0 && tv != pi then
        var pred_rows: Vec[Int] = Vec::new()
        match preds.get(tv)
        when Option::Some(rows) then pred_rows = rows.clone()
        when Option::None then ()
        end
        if !pred_rows.contains(&pi) then
          pred_rows.push(pi)
          preds.insert(tv, pred_rows)
        end
        var succ_rows: Vec[Int] = Vec::new()
        match succs.get(pi)
        when Option::Some(srows) then succ_rows = srows.clone()
        when Option::None then ()
        end
        if !succ_rows.contains(&tv) then
          succ_rows.push(tv)
          succs.insert(pi, succ_rows)
        end
      end
      ti = ti + 1
    end
    pi = pi + 1
  end
  Option::Some(SliceFnCtx {
    name: name.clone(),
    f: f,
    block_of_id: block_of_id,
    preds: preds,
    succs: succs
  })
end

# The block Vec index of a block id (-1 when absent).
def slice_block_vec_index(ctx: SliceFnCtx, block_id: Int) -> Int
  match ctx.block_of_id.get(block_id)
  when Option::Some(v) then v
  when Option::None then -1
  end
end

# The emission-name -> function index map (the §11 scan's fn index).
def slice_fn_index(mir: MirProgram) -> Map[String, Int]
  var out: Map[String, Int] = Map::new()
  var i = 0
  while i < mir.functions.len() do
    let n = mir.functions[i].name.clone()
    if !out.contains_key(&n) then
      out.insert(n, i)
    end
    i = i + 1
  end
  out
end

# The §11 type name index: MirTypeDef id -> registered type name.
def slice_type_index(mir: MirProgram) -> Map[Int, String]
  var out: Map[Int, String] = Map::new()
  for td in mir.types do
    out.insert(td.id.id, td.name.clone())
  end
  out
end

# ———————————————————————————————————————————————————————————————
# The self-loop residual probes (the ConservativeSubset condition of every
# def-chain walk)
# ———————————————————————————————————————————————————————————————
# ctx.preds / ctx.succs (slice_fn_find) drop SELF edges by construction,
# while the raw graph keeps them (the loop forest's back edges). A def
# chain crossing a block boundary therefore misses the defs that reach
# through a block's own self-loop edge — the reaching-def self-loop
# residual the ReachingDefs kind documents. These probes decide, per walk,
# whether that omission can actually bite (a self edge exists AND a
# candidate node sits on the far side of the scan boundary).

# The number of RAW self edges in the function (the omission footprint).
def slice_fn_self_edge_count(ctx: SliceFnCtx) -> Int
  var count = 0
  var bi = 0
  while bi < ctx.f.blocks.len() do
    let id = ctx.f.blocks[bi].id.id
    for target in terminator_successor_ids(&ctx.f.blocks[bi].terminator) do
      if target == id then
        count = count + 1
      end
    end
    bi = bi + 1
  end
  count
end

# Whether one block's terminator has a self edge.
def slice_block_has_self_edge(ctx: SliceFnCtx, v: Int) -> Bool
  let id = ctx.f.blocks[v].id.id
  terminator_successor_ids(&ctx.f.blocks[v].terminator).contains(&id)
end

# Whether the block carries a def (bare or partial) of `local` at a node
# index AFTER `from` (the backward scan's boundary): the defs a self-loop
# edge could carry back to an earlier use.
def slice_block_has_later_def(ctx: SliceFnCtx, v: Int, from: Int, local: Int) -> Bool
  let block_len = ctx.f.blocks[v].statements.len()
  var si = from + 1
  while si < block_len do
    let defs = slice_stmt_defs(ctx.f.blocks[v].statements[si])
    if defs.0 == local || defs.1 == local then
      return true
    end
    si = si + 1
  end
  let tdefs = slice_term_defs(&ctx.f.blocks[v].terminator)
  tdefs.0 == local || tdefs.1 == local
end

# Whether the block carries a read of `local` at a node index BEFORE `from`
# (the forward scan's boundary): the uses a self-loop edge could carry the
# def forward to.
def slice_block_has_earlier_read(ctx: SliceFnCtx, v: Int, from: Int, local: Int) -> Bool
  let block_len = ctx.f.blocks[v].statements.len()
  var si = 0
  while si < from && si < block_len do
    for r in slice_stmt_reads(ctx.f.blocks[v].statements[si]) do
      if r == local then
        return true
      end
    end
    si = si + 1
  end
  if from > block_len then
    for tr in slice_term_reads(&ctx.f.blocks[v].terminator) do
      if tr == local then
        return true
      end
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Node reads and defs — the def-use atoms (the mir.tg optimizer
# vocabulary, self-contained)
# ———————————————————————————————————————————————————————————————

# The local read by a MirOperand (None for constants — collect_operand_read
# shape).
def slice_operand_read(op: MirOperand) -> Option[Int]
  match op.kind
  when MirOperandKind::MirCopy(place) then Option::Some(place.local.id)
  when MirOperandKind::MirMovePlace(place) then Option::Some(place.local.id)
  when MirOperandKind::MirRead(place) then Option::Some(place.local.id)
  when MirOperandKind::MirConsume(place) then Option::Some(place.local.id)
  when _ then Option::None
  end
end

# The BARE root of a place-kind operand (mir.tg's mir_operand_bare_root):
# Some(local) for a place with EMPTY projections; None for projected
# places and constants.
def slice_operand_bare_root(op: MirOperand) -> Option[Int]
  match op.kind
  when MirOperandKind::MirCopy(p) then
    if p.projections.is_empty() then Option::Some(p.local.id) else Option::None end
  when MirOperandKind::MirMovePlace(p) then
    if p.projections.is_empty() then Option::Some(p.local.id) else Option::None end
  when MirOperandKind::MirRead(p) then
    if p.projections.is_empty() then Option::Some(p.local.id) else Option::None end
  when MirOperandKind::MirConsume(p) then
    if p.projections.is_empty() then Option::Some(p.local.id) else Option::None end
  when _ then Option::None
  end
end

# The rvalue reads (collect_rvalue_reads shape: every operand / place /
# phi-source local).
def slice_rvalue_reads(rv: MirRvalueKind, inout out: Vec[Int]) -> Unit
  match rv
  when MirRvalueKind::MirMove(op) then
    match slice_operand_read(&op)
    when Option::Some(l) then out.push(l)
    when Option::None then ()
    end
  when MirRvalueKind::MirRef(place) then out.push(place.local.id)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      match slice_operand_read(&op)
      when Option::Some(l2) then out.push(l2)
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    match slice_operand_read(&lhs)
    when Option::Some(la) then out.push(la)
    when Option::None then ()
    end
    match slice_operand_read(&rhs)
    when Option::Some(ra) then out.push(ra)
    when Option::None then ()
    end
  when MirRvalueKind::MirUnOp(_, op) then
    match slice_operand_read(&op)
    when Option::Some(u) then out.push(u)
    when Option::None then ()
    end
  when MirRvalueKind::MirDiscriminant(place) then out.push(place.local.id)
  when MirRvalueKind::MirLen(place) then out.push(place.local.id)
  when MirRvalueKind::MirCast(_, op, _) then
    match slice_operand_read(&op)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
  when MirRvalueKind::MirRepeat(op, _) then
    match slice_operand_read(&op)
    when Option::Some(r) then out.push(r)
    when Option::None then ()
    end
  when MirRvalueKind::MirPhi(entries) then
    for entry in entries do
      out.push(entry.1.id)
    end
  end
end

# Whether a call argument observes its operand's value — collect_call_arg_read's
# refinement: BARE Initialize args are writes, everything else reads.
def slice_call_arg_read(arg: MirCallArg) -> Option[Int]
  match arg.value
  when MirCallValue::Place(p) then
    match arg.effect
    when AccessEffect::Initialize then
      if p.projections.is_empty() then Option::None else Option::Some(p.local.id) end
    when _ then Option::Some(p.local.id)
    end
  when MirCallValue::Value(op) then
    match arg.effect
    when AccessEffect::Initialize then
      match slice_operand_bare_root(&op)
      when Option::Some(_) then Option::None
      when Option::None then slice_operand_read(&op)
      end
    when _ then slice_operand_read(&op)
    end
  end
end

# The reads of one MirStatement (its operands only — the DEST is a def).
def slice_stmt_reads(st: MirStatement) -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  match st.kind
  when MirStatementKind::MirAssign(_, rvalue) then
    slice_rvalue_reads(rvalue.kind, &mut out)
  when MirStatementKind::MirContractCheck(contract, operand) then
    match slice_operand_read(&contract.condition)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
    match slice_operand_read(&operand)
    when Option::Some(o) then out.push(o)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectRecord(_, operand) then
    match slice_operand_read(&operand)
    when Option::Some(e) then out.push(e)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectPerform(_, _, _, payload_ptr, result_ptr) then
    match slice_operand_read(&payload_ptr)
    when Option::Some(p) then out.push(p)
    when Option::None then ()
    end
    match slice_operand_read(&result_ptr)
    when Option::Some(r) then out.push(r)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectFrameEnter(_, _, _, _, env_ptr) then
    match slice_operand_read(&env_ptr)
    when Option::Some(e2) then out.push(e2)
    when Option::None then ()
    end
  when _ then ()
  end
  out
end

# The terminator reads — collect_terminator_reads shape plus MirDeinit-reads-its-place
# and MirReturn-reads-local-0 ("_ret").
def slice_term_reads(term: MirTerminator) -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    match slice_operand_read(&op)
    when Option::Some(s) then out.push(s)
    when Option::None then ()
    end
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    match slice_operand_read(&func)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
    for arg in args do
      match slice_call_arg_read(&arg)
      when Option::Some(a) then out.push(a)
      when Option::None then ()
      end
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    match slice_operand_read(&cond)
    when Option::Some(cc) then out.push(cc)
    when Option::None then ()
    end
    match msg
    when AssertMessage::BoundsCheck(index_op, len_op) then
      match slice_operand_read(&index_op)
      when Option::Some(io) then out.push(io)
      when Option::None then ()
      end
      match slice_operand_read(&len_op)
      when Option::Some(lo) then out.push(lo)
      when Option::None then ()
      end
    when _ then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    # a destruction reads the value's current content — its final use.
    out.push(place.local.id)
  when MirTerminatorKind::MirReturn then
    # locals[0] is the function's return place ("_ret"): MirReturn leaves
    # it behind and therefore reads it.
    out.push(0)
  when _ then ()
  end
  out
end

# Node defs as (bare local, partial root), -1 = none: a bare write ENDS a def
# chain; a projected dest AFFECTS its root but does not end the chain.
def slice_stmt_defs(st: MirStatement) -> (Int, Int)
  match st.kind
  when MirStatementKind::MirAssign(place, _) then
    if place.projections.is_empty() then
      (place.local.id, -1)
    else
      (-1, place.local.id)
    end
  when _ then (-1, -1)
  end
end

def slice_term_defs(term: MirTerminator) -> (Int, Int)
  match term.kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    if dest.projections.is_empty() then
      (dest.local.id, -1)
    else
      (-1, dest.local.id)
    end
  when _ then (-1, -1)
  end
end

# The callee emission name of a named MirCall (the MirFnItem constant's
# name); "" for value/indirect calls (no row identity — documented).
def slice_call_callee_name(term: MirTerminator) -> String
  match term.kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    match func.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirFnItem(name) then return name.clone()
      when _ then return ""
      end
    when _ then return ""
    end
  when _ then ""
  end
end

# ———————————————————————————————————————————————————————————————
# The backward engine — def chains of wanted locals
# ———————————————————————————————————————————————————————————————
# Work items (block, from, local) resolve def chains backward: the first BARE
# def is included and its reads become new items; a PARTIAL def is included
# but the local STAYS wanted (the aggregate base is defined earlier); a scan
# ending at the block head propagates to the PREDECESSORS; a want reaching
# the ENTRY head resolves as a parameter anchor or drops silently. Dedupe
# texts + the item budget terminate cyclic pred graphs deterministically.
#
# COMPLETENESS (audit item 9): the in-block scan is EXACT — the nearest def
# below the use is the reaching def of the current iteration. Predecessor
# propagation is PATH-INSENSITIVE (every predecessor's defs are unioned, so
# a def on an infeasible predecessor path may be included —
# ConservativeSuperset). The ONE documented omission is the reaching-def
# SELF-LOOP residual: ctx.preds drops self edges (slice_fn_find), so a def
# of the wanted local lexically AFTER the scan start, reaching the use
# through the block's own self-loop edge, is not propagated
# (ConservativeSubset). The item budget's exhaustion is Truncated. The
# helper below is the ONE classifier every backward-engine result uses.

struct SliceBack
  ctx: SliceFnCtx
  # work items: (block Vec index, from node index inclusive, local id).
  work: Vec[(Int, Int, Int)] = Vec::new()
  # processed-item dedupe texts ("<block>@<from>#<local>").
  seen: Set[String] = Set::new()
  # included nodes: stmt key -> presentation span key ("" when dummy).
  included: Map[String, String] = Map::new()
  # external anchors ("param:<index>:<name>").
  external: Set[String] = Set::new()
  # items popped so far (the budget).
  items: Int = 0
  # path-insensitive predecessor propagation happened (may include extra
  # nodes — ConservativeSuperset unless a stronger class applies).
  approximated: Bool = false
  # the self-loop omission condition fired (ConservativeSubset).
  subset_limited: Bool = false
  # the function's self-loop edge count (the omission footprint).
  self_edges: Int = 0
end

def slice_back_new(ctx: SliceFnCtx) -> SliceBack
  SliceBack {
    ctx: ctx.clone(),
    work: Vec::new(),
    seen: Set::new(),
    included: Map::new(),
    external: Set::new(),
    items: 0,
    approximated: false,
    subset_limited: false,
    self_edges: slice_fn_self_edge_count(&ctx)
  }
end

def slice_back_item_text(v: Int, from: Int, local: Int) -> String
  v.to_string() + "@" + from.to_string() + "#" + local.to_string()
end

def slice_back_push(inout back: SliceBack, v: Int, from: Int, local: Int) -> Unit
  if v < 0 then return end
  let key = slice_back_item_text(v, from, local)
  if back.seen.contains(&key) then return end
  back.seen.insert(key)
  back.work.push((v, from, local))
  ()
end

def slice_back_include(inout back: SliceBack, v: Int, idx: Int, span: Span) -> Unit
  let block_id = back.ctx.f.blocks[v].id.id
  let block_len = back.ctx.f.blocks[v].statements.len()
  var node_key = ""
  if idx >= block_len then
    node_key = slice_term_key(&back.ctx.name, block_id)
  else
    node_key = slice_stmt_key(&back.ctx.name, block_id, idx)
  end
  if !back.included.contains_key(&node_key) then
    let span_key = slice_span_key(&node_key, span)
    back.included.insert(node_key, span_key)
  end
  ()
end

# Whether a local is a parameter of the ctx function (the def chain's
# caller-side boundary).
def slice_is_param(ctx: SliceFnCtx, local: Int) -> Bool
  for p in ctx.f.params do
    if p.id.id == local then
      return true
    end
  end
  false
end

def slice_back_external_param(inout back: SliceBack, local: Int) -> Unit
  if local >= 0 && local < back.ctx.f.locals.len() then
    let name = back.ctx.f.locals[local].name.clone()
    back.external.insert("param:" + local.to_string() + ":" + name)
  end
  ()
end

# The completeness of a FINISHED backward-engine walk (the class, the
# reason, the omitted lower bound): Truncated when the item cap stopped
# the worklist with work left (omitted = the remaining items); else
# ConservativeSubset when the self-loop omission condition fired (omitted
# = the function's self-edge count); else ConservativeSuperset when
# predecessor propagation happened (the path-insensitive union may include
# extra nodes); else Complete. The worst class wins (see the module doc).
def slice_back_completeness(back: SliceBack) -> (SliceCompleteness, String, Int)
  if back.work.len() > 0 && back.items >= slice_max_items() then
    return (
      SliceCompleteness::Truncated,
      "cap: slice_max_items=" + slice_max_items().to_string() +
        " work items exhausted; " + back.work.len().to_string() + " work item(s) remain unprocessed",
      back.work.len()
    )
  end
  if back.subset_limited then
    return (
      SliceCompleteness::ConservativeSubset,
      "the reaching-def self-loop residual (model " + slice_model_reaching() +
        "): predecessor propagation rides ctx.preds, which drops self edges, so a def of the wanted local " +
        "lexically after the scan start reaching the use through a self-loop edge is not propagated (" +
        back.self_edges.to_string() + " self edge(s) in the function)",
      back.self_edges
    )
  end
  if back.approximated then
    return (
      SliceCompleteness::ConservativeSuperset,
      "path-insensitive predecessor union: defs on infeasible predecessor paths may be included",
      0
    )
  end
  (SliceCompleteness::Complete, "", 0)
end

# The CompletenessInfo of a finished backward walk under ONE analysis
# model (the returned count is filled by slice_result_build).
def slice_back_info(back: SliceBack, analysis_model: String) -> CompletenessInfo
  let parts = slice_back_completeness(back.clone())
  let level = parts.0.clone()
  let reason = parts.1.clone()
  let omitted = parts.2
  match level
  when SliceCompleteness::Complete then completeness_info_complete(analysis_model, back.items, 0)
  when SliceCompleteness::ConservativeSuperset then completeness_info_superset(analysis_model, reason, back.items, 0)
  when SliceCompleteness::ConservativeSubset then completeness_info_subset(analysis_model, reason, back.items, 0, omitted)
  when SliceCompleteness::Truncated then completeness_info_truncated(analysis_model, reason, back.items, 0, omitted)
  end
end

# Run the worklist to the budget (FIFO, deterministic).
def slice_back_run(inout back: SliceBack) -> Unit
  while back.work.len() > 0 && back.items < slice_max_items() do
    back.items = back.items + 1
    let item = back.work[0]
    back.work.remove(0)
    let v = item.0
    let from = item.1
    let wanted = item.2
    let block_len = back.ctx.f.blocks[v].statements.len()
    var found = false
    # the terminator is the first candidate when the scan starts at or
    # after the block end (a def in the terminator feeds the entry of a
    # SUCCESSOR block; it can never feed a use in this block).
    if from >= block_len then
      let term = back.ctx.f.blocks[v].terminator
      let term_defs = slice_term_defs(&term)
      let bare = term_defs.0
      let partial = term_defs.1
      if bare == wanted then
        let span = slice_span_copy(term.span)
        slice_back_include(&mut back, v, block_len, span)
        found = true
        let reads = slice_term_reads(&term)
        for r in reads do
          slice_back_push(&mut back, v, block_len - 1, r)
        end
      elsif partial == wanted then
        # a projected terminator write affects the value but does not end
        # the chain: include it, feed its operand reads, keep scanning.
        let span = slice_span_copy(term.span)
        slice_back_include(&mut back, v, block_len, span)
        let reads = slice_term_reads(&term)
        for r in reads do
          slice_back_push(&mut back, v, block_len - 1, r)
        end
      end
    end
    # then the statements, from the scan start down to the block head.
    var si = from
    if si > block_len - 1 then
      si = block_len - 1
    end
    while si >= 0 && !found do
      let st = back.ctx.f.blocks[v].statements[si]
      let st_defs = slice_stmt_defs(st)
      let bare = st_defs.0
      let partial = st_defs.1
      if bare == wanted then
        let span = slice_span_copy(st.span)
        slice_back_include(&mut back, v, si, span)
        found = true
        let reads = slice_stmt_reads(st)
        for r in reads do
          slice_back_push(&mut back, v, si - 1, r)
        end
      elsif partial == wanted then
        # a projected write affects the value but does not end the chain
        # (the aggregate base is defined earlier): include it, feed its
        # operand reads, keep scanning for the base def.
        let span = slice_span_copy(st.span)
        slice_back_include(&mut back, v, si, span)
        let reads = slice_stmt_reads(st)
        for r in reads do
          slice_back_push(&mut back, v, si - 1, r)
        end
      end
      si = si - 1
    end
    if !found then
      if slice_is_param(back.ctx.clone(), wanted) then
        slice_back_external_param(&mut back, wanted)
      else
        # the scan ran off the block head: the defs of every predecessor
        # are unioned (path-insensitive — ConservativeSuperset), and the
        # self-loop residual may bite (see slice_back_completeness).
        back.approximated = true
        if slice_block_has_self_edge(back.ctx.clone(), v) &&
           slice_block_has_later_def(back.ctx.clone(), v, from, wanted) then
          back.subset_limited = true
        end
        var pred_rows: Vec[Int] = Vec::new()
        match back.ctx.preds.get(v)
        when Option::Some(rows) then pred_rows = rows.clone()
        when Option::None then ()
        end
        for p in pred_rows do
          let p_len = back.ctx.f.blocks[p].statements.len()
          slice_back_push(&mut back, p, p_len, wanted)
        end
      end
    end
  end
  ()
end

# Seed one anchored def-chain walk: the defs of `local` that feed its use
# at (block Vec index v, node index idx). The scan starts BELOW the use
# node (a def AT the use node — a call reading and writing the same
# local — feeds later uses, never this one).
def slice_backward_at(inout back: SliceBack, v: Int, idx: Int, local: Int) -> Unit
  slice_back_push(&mut back, v, idx - 1, local)
  slice_back_run(&mut back)
  ()
end

# ———————————————————————————————————————————————————————————————
# The forward engine — transitive uses of a statement's defs
# ———————————————————————————————————————————————————————————————
# Work items (block, from, local) follow a def forward: every node READING
# the local is included; a bare redefinition KILLS the chain (a partial
# redefinition passes through); an included node's own defs become new items
# (transitive uses). Chains surviving the terminator propagate to SUCCESSORS;
# a def escaping as a named call argument records the "call:<callee>:arg<n>"
# anchor. A MirDeinit consumes the local (the chain dies there).
#
# COMPLETENESS (audit item 9): the in-block scan from the def's position is
# EXACT. SUCCESSOR propagation is path-insensitive (uses on infeasible
# successor paths may be included — ConservativeSuperset). The documented
# omission is the self-loop residual: ctx.succs drops self edges, so a read
# of the local lexically BEFORE the scan start, fed by the def through the
# block's own self-loop edge (the previous iteration), is not followed
# (ConservativeSubset). The item budget's exhaustion is Truncated.

struct SliceFwd
  ctx: SliceFnCtx
  # work items: (block Vec index, from node index inclusive, local id).
  work: Vec[(Int, Int, Int)] = Vec::new()
  seen: Set[String] = Set::new()
  included: Map[String, String] = Map::new()
  external: Set[String] = Set::new()
  items: Int = 0
  # path-insensitive successor propagation happened (ConservativeSuperset
  # unless a stronger class applies).
  approximated: Bool = false
  # the self-loop omission condition fired (ConservativeSubset).
  subset_limited: Bool = false
  # the function's self-loop edge count (the omission footprint).
  self_edges: Int = 0
end

def slice_fwd_new(ctx: SliceFnCtx) -> SliceFwd
  SliceFwd {
    ctx: ctx.clone(),
    work: Vec::new(),
    seen: Set::new(),
    included: Map::new(),
    external: Set::new(),
    items: 0,
    approximated: false,
    subset_limited: false,
    self_edges: slice_fn_self_edge_count(&ctx)
  }
end

# The completeness of a FINISHED forward-engine walk (the mirrored rule of
# slice_back_completeness: see the engine doc).
def slice_fwd_completeness(fwd: SliceFwd) -> (SliceCompleteness, String, Int)
  if fwd.work.len() > 0 && fwd.items >= slice_max_items() then
    return (
      SliceCompleteness::Truncated,
      "cap: slice_max_items=" + slice_max_items().to_string() +
        " work items exhausted; " + fwd.work.len().to_string() + " work item(s) remain unprocessed",
      fwd.work.len()
    )
  end
  if fwd.subset_limited then
    return (
      SliceCompleteness::ConservativeSubset,
      "the reaching-def self-loop residual (model " + slice_model_reaching() +
        "): successor propagation rides ctx.succs, which drops self edges, so a read of the sliced def " +
        "lexically before the scan start, fed through a self-loop edge (the previous iteration), is not followed (" +
        fwd.self_edges.to_string() + " self edge(s) in the function)",
      fwd.self_edges
    )
  end
  if fwd.approximated then
    return (
      SliceCompleteness::ConservativeSuperset,
      "path-insensitive successor propagation: uses on infeasible successor paths may be included",
      0
    )
  end
  (SliceCompleteness::Complete, "", 0)
end

# The CompletenessInfo of a finished forward walk under ONE analysis model.
def slice_fwd_info(fwd: SliceFwd, analysis_model: String) -> CompletenessInfo
  let parts = slice_fwd_completeness(fwd.clone())
  let level = parts.0.clone()
  let reason = parts.1.clone()
  let omitted = parts.2
  match level
  when SliceCompleteness::Complete then completeness_info_complete(analysis_model, fwd.items, 0)
  when SliceCompleteness::ConservativeSuperset then completeness_info_superset(analysis_model, reason, fwd.items, 0)
  when SliceCompleteness::ConservativeSubset then completeness_info_subset(analysis_model, reason, fwd.items, 0, omitted)
  when SliceCompleteness::Truncated then completeness_info_truncated(analysis_model, reason, fwd.items, 0, omitted)
  end
end

def slice_fwd_push(inout fwd: SliceFwd, v: Int, from: Int, local: Int) -> Unit
  if v < 0 then return end
  let key = slice_back_item_text(v, from, local)
  if fwd.seen.contains(&key) then return end
  fwd.seen.insert(key)
  fwd.work.push((v, from, local))
  ()
end

def slice_fwd_include(inout fwd: SliceFwd, v: Int, idx: Int, span: Span) -> Unit
  let block_id = fwd.ctx.f.blocks[v].id.id
  let block_len = fwd.ctx.f.blocks[v].statements.len()
  var node_key = ""
  if idx >= block_len then
    node_key = slice_term_key(&fwd.ctx.name, block_id)
  else
    node_key = slice_stmt_key(&fwd.ctx.name, block_id, idx)
  end
  if !fwd.included.contains_key(&node_key) then
    let span_key = slice_span_key(&node_key, span)
    fwd.included.insert(node_key, span_key)
  end
  ()
end

# "call:<callee>:arg<n>" anchors for every arg of a named call reading the
# tracked local (the def's escape edges).
def slice_fwd_call_anchors(term: MirTerminator, local: Int) -> Vec[String]
  var out: Vec[String] = Vec::new()
  let callee = slice_call_callee_name(term)
  if callee.len() == 0 then return out end
  match term.kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    var ai = 0
    while ai < args.len() do
      match slice_call_arg_read(&args[ai])
      when Option::Some(l) then
        if l == local then
          out.push("call:" + callee.clone() + ":arg" + ai.to_string())
        end
      when Option::None then ()
      end
      ai = ai + 1
    end
  when _ then ()
  end
  out
end

# Run the forward worklist to the budget (FIFO, deterministic).
def slice_fwd_run(inout fwd: SliceFwd) -> Unit
  while fwd.work.len() > 0 && fwd.items < slice_max_items() do
    fwd.items = fwd.items + 1
    let item = fwd.work[0]
    fwd.work.remove(0)
    let v = item.0
    let from = item.1
    let local = item.2
    let block_len = fwd.ctx.f.blocks[v].statements.len()
    var killed = false
    # the self-loop omission condition: a read of the tracked local BEFORE
    # the scan start, fed by the def through the block's self edge (see
    # slice_fwd_completeness). The condition is per ITEM (the scan
    # boundary is where this item starts).
    if slice_block_has_self_edge(fwd.ctx.clone(), v) &&
       slice_block_has_earlier_read(fwd.ctx.clone(), v, from, local) then
      fwd.subset_limited = true
    end
    var si = from
    while si < block_len && !killed do
      let st = fwd.ctx.f.blocks[v].statements[si]
      let st_defs = slice_stmt_defs(st)
      let bare = st_defs.0
      let reads = slice_stmt_reads(st)
      var uses = false
      for r in reads do
        if r == local then
          uses = true
        end
      end
      if uses then
        let span = slice_span_copy(st.span)
        slice_fwd_include(&mut fwd, v, si, span)
        # the value flows through this node: its own def (when any) is a
        # transitive carrier of the sliced def.
        if bare >= 0 then
          slice_fwd_push(&mut fwd, v, si + 1, bare)
        end
      end
      if bare == local then
        # the sliced def is overwritten here — its life ends at this node
        # (a read at the same node was already counted above).
        killed = true
      end
      si = si + 1
    end
    if !killed && from <= block_len then
      # the block terminator is a candidate node of the chain.
      let term = fwd.ctx.f.blocks[v].terminator
      let term_defs = slice_term_defs(&term)
      let bare = term_defs.0
      let reads = slice_term_reads(&term)
      var uses = false
      for r in reads do
        if r == local then
          uses = true
        end
      end
      if uses then
        let span = slice_span_copy(term.span)
        slice_fwd_include(&mut fwd, v, block_len, span)
        # a def read as a named call argument escapes through the call
        # edge: anchor the callee row even when the call's dest overwrites
        # the tracked local.
        let anchors = slice_fwd_call_anchors(&term, local)
        for a in anchors do
          fwd.external.insert(a.clone())
        end
        if bare >= 0 then
          slice_fwd_push(&mut fwd, v, block_len + 1, bare)
        end
      end
      if bare == local then
        killed = true
      end
      match term.kind
      when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
        # a destruction consumes the value: the chain dies there (reads
        # after a drop are invalid verified MIR).
        if place.local.id == local then
          killed = true
        end
      when _ then ()
      end
    end
    if !killed then
      # the chain survived the block: the value flows to the successors
      # (path-insensitive — ConservativeSuperset unless the self-loop
      # condition already raised the class).
      fwd.approximated = true
      var succ_rows: Vec[Int] = Vec::new()
      match fwd.ctx.succs.get(v)
      when Option::Some(rows) then succ_rows = rows.clone()
      when Option::None then ()
      end
      for s in succ_rows do
        slice_fwd_push(&mut fwd, s, 0, local)
      end
    end
  end
  ()
end

# ———————————————————————————————————————————————————————————————
# Result assembly — sorted stable ids + presentation span keys
# ———————————————————————————————————————————————————————————————

def slice_result_build(ctx: SliceFnCtx, included: Map[String, String], external: Set[String], info: CompletenessInfo) -> SliceResult
  var keys: Vec[String] = Vec::new()
  var entries: Vec[(String, String)] = included.entries()
  for entry in entries do
    keys.push(entry.0.clone())
  end
  semantic_strings_sort(&mut keys)
  var span_rows: Vec[String] = Vec::new()
  for k in keys do
    match included.get(k.clone())
    when Option::Some(span_key) then
      if span_key.len() > 0 then
        span_rows.push(span_key.clone())
      end
    when Option::None then ()
    end
  end
  var exts: Vec[String] = Vec::new()
  for e in external do
    exts.push(e.clone())
  end
  semantic_strings_sort(&mut exts)
  # the returned count is the included node count — the ONE place it is
  # filled (the engine passes the class/reason/visited/omitted).
  var final_info = info
  final_info.returned_nodes = keys.len()
  SliceResult {
    function_key: ctx.name.clone(),
    statements: keys,
    external: exts,
    span_keys: span_rows,
    info: final_info
  }
end

# ———————————————————————————————————————————————————————————————
# slice_value — the backward def chain of one value
# ———————————————————————————————————————————————————————————————
# Seeds one anchored walk per USE SITE of the value (a node reading the
# local; a MirReturn reads the "_ret" local 0). A value with NO use sites
# yields the empty slice (nothing later observes it — documented).

pub def slice_value(mir: MirProgram, fn_key: String, value_id: Int) -> SliceResult
  match slice_fn_find(mir, fn_key.clone())
  when Option::Some(ctx) then
    if value_id < 0 || value_id >= ctx.f.locals.len() then
      return slice_result_empty()
    end
    var back = slice_back_new(ctx)
    # seed one anchored def-chain walk per USE SITE of the value (a node
    # reading the local; a MirReturn reads the "_ret" local 0). A value
    # with no use sites yields the empty slice (documented).
    var bi = 0
    while bi < back.ctx.f.blocks.len() do
      let block_len = back.ctx.f.blocks[bi].statements.len()
      var si = 0
      while si < block_len do
        let st = back.ctx.f.blocks[bi].statements[si]
        let reads = slice_stmt_reads(st)
        for r in reads do
          if r == value_id then
            slice_backward_at(&mut back, bi, si, value_id)
          end
        end
        si = si + 1
      end
      let term = back.ctx.f.blocks[bi].terminator
      let treads = slice_term_reads(&term)
      for tr in treads do
        if tr == value_id then
          slice_backward_at(&mut back, bi, block_len, value_id)
        end
      end
      bi = bi + 1
    end
    slice_result_build(&back.ctx, &back.included, &back.external,
      slice_back_info(back, slice_model_value_chain()))
  when Option::None then slice_result_empty()
  end
end

# ———————————————————————————————————————————————————————————————
# slice_statement — the forward use slice of one statement's defs
# ———————————————————————————————————————————————————————————————

pub def slice_statement(mir: MirProgram, fn_key: String, stmt_key: String) -> SliceResult
  match slice_fn_find(mir, fn_key.clone())
  when Option::Some(ctx) then
    match slice_key_parts(&fn_key, &stmt_key)
    when Option::Some(parts) then
      let block_id = parts.0
      let node_idx = parts.1
      let is_term = parts.2
      let v = slice_block_vec_index(&ctx, block_id)
      if v < 0 || v >= ctx.f.blocks.len() then
        return slice_result_empty()
      end
      let block_len = ctx.f.blocks[v].statements.len()
      var defs = (-1, -1)
      if is_term then
        defs = slice_term_defs(&ctx.f.blocks[v].terminator)
      elsif node_idx >= 0 && node_idx < block_len then
        let st = ctx.f.blocks[v].statements[node_idx]
        defs = slice_stmt_defs(st)
      end
      if defs.0 < 0 && defs.1 < 0 then
        # a node with no defs defines nothing for later nodes to use
        # (asserts, checks, switches...): the use slice is empty
        # (documented).
        return slice_result_empty()
      end
      var fwd = slice_fwd_new(ctx)
      var seed = defs.0
      if seed < 0 then
        seed = defs.1
      end
      var from = node_idx + 1
      if is_term then
        from = block_len + 1
      end
      slice_fwd_push(&mut fwd, v, from, seed)
      slice_fwd_run(&mut fwd)
      slice_result_build(&fwd.ctx, &fwd.included, &fwd.external,
        slice_fwd_info(fwd, slice_model_forward_chain()))
    when Option::None then slice_result_empty()
    end
  when Option::None then slice_result_empty()
  end
end

# ———————————————————————————————————————————————————————————————
# slice_failure — the statements contributing to one diagnostic
# ———————————————————————————————————————————————————————————————
# Trace + anchored condition slices of the mapped failing node (see the SPAN
# MAP section of the module doc).

# Whether a span textually contains the diagnostic start offset (empty
# files compare equal; a dummy span contains nothing).
def slice_span_contains(span: Span, d: Span) -> Bool
  if span.start == 0 && span.end_pos == 0 && span.file.len() == 0 then
    return false
  end
  if d.file.len() > 0 && span.file.len() > 0 && d.file != span.file then
    return false
  end
  span.start <= d.start && d.start <= span.end_pos
end

# The strict better-than relation over mapping tiers (see above); the
# walk replaces only on strictly-better, so ties keep the EARLIER node.
def slice_span_better(a: Span, b: Span, d: Span) -> Bool
  var a_contain = slice_span_contains(&a, &d)
  var b_contain = slice_span_contains(&b, &d)
  if a_contain != b_contain then
    return a_contain
  end
  var a_overlap = (a.start <= d.end_pos) && (d.start <= a.end_pos)
  var b_overlap = (b.start <= d.end_pos) && (d.start <= b.end_pos)
  if a_overlap != b_overlap then
    return a_overlap
  end
  var a_gap = a.start - d.start
  if a_gap < 0 then a_gap = -a_gap end
  var b_gap = b.start - d.start
  if b_gap < 0 then b_gap = -b_gap end
  if a_gap != b_gap then
    return a_gap < b_gap
  end
  var a_egap = a.end_pos - d.end_pos
  if a_egap < 0 then a_egap = -a_egap end
  var b_egap = b.end_pos - d.end_pos
  if b_egap < 0 then b_egap = -b_egap end
  a_egap < b_egap
end

# The best-mapped (ctx, block Vec index, node index); None when nothing maps.
def slice_failure_map(mir: MirProgram, diag: Diagnostic) -> Option[(SliceFnCtx, Int, Int)]
  match diag.span.clone()
  when Option::Some(dspan) then
    var best_ctx: Option[SliceFnCtx] = Option::None
    var best_v = -1
    var best_idx = -1
    var best_span = Span { file: "", start: 0, end_pos: 0 }
    var best_set = false
    for f in mir.functions do
      match slice_fn_find(mir, f.name.clone())
      when Option::Some(ctx) then
        var bi = 0
        while bi < ctx.f.blocks.len() do
          let block_len = ctx.f.blocks[bi].statements.len()
          var si = 0
          while si < block_len do
            let st = ctx.f.blocks[bi].statements[si]
            let sp = slice_span_copy(st.span)
            if !best_set || slice_span_better(&sp, &best_span, &dspan) then
              best_set = true
              best_span = sp
              best_ctx = Option::Some(ctx.clone())
              best_v = bi
              best_idx = si
            end
            si = si + 1
          end
          let term = ctx.f.blocks[bi].terminator
          let tsp = slice_span_copy(term.span)
          if !best_set || slice_span_better(&tsp, &best_span, &dspan) then
            best_set = true
            best_span = tsp
            best_ctx = Option::Some(ctx.clone())
            best_v = bi
            best_idx = block_len
          end
          bi = bi + 1
        end
      when Option::None then ()
      end
    end
    match best_ctx
    when Option::Some(bc) then Option::Some((bc, best_v, best_idx))
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# The node-anchored FAILURE slice: the failing node's read operands' anchored
# def chains UNION the failure trace (the enclosing block's statements from
# its head through the node — the failing terminator included). Shared by
# slice_failure (span-mapped anchors through slice_failure_map) and the typed
# mir_slice Failure kind (direct node-key anchors).
def slice_failure_node_slice(ctx: SliceFnCtx, v: Int, idx: Int) -> SliceResult
  let block_len = ctx.f.blocks[v].statements.len()
  var back = slice_back_new(ctx)
  # the failing node's read operands (the failing condition and its
  # bounds, the switch scrutinee, the call's arguments...): the anchored
  # def chains of each.
  var reads: Vec[Int] = Vec::new()
  if idx >= block_len then
    let term = ctx.f.blocks[v].terminator
    reads = slice_term_reads(&term)
  else
    let st = ctx.f.blocks[v].statements[idx]
    reads = slice_stmt_reads(st)
  end
  for r in reads do
    slice_backward_at(&mut back, v, idx, r)
  end
  # the failure trace: the enclosing block's statements from its head
  # through the failing node (the failing terminator included).
  var ti = 0
  while ti <= idx && ti <= block_len do
    var node_key = ""
    var nspan = Span { file: "", start: 0, end_pos: 0 }
    if ti >= block_len then
      node_key = slice_term_key(&ctx.name, ctx.f.blocks[v].id.id)
      nspan = slice_span_copy(ctx.f.blocks[v].terminator.span)
    else
      node_key = slice_stmt_key(&ctx.name, ctx.f.blocks[v].id.id, ti)
      nspan = slice_span_copy(ctx.f.blocks[v].statements[ti].span)
    end
    if !back.included.contains_key(&node_key) then
      let span_key = slice_span_key(&node_key, nspan)
      back.included.insert(node_key, span_key)
    end
    ti = ti + 1
  end
  slice_result_build(&ctx, &back.included, &back.external,
    slice_back_info(back, slice_model_failure()))
end

pub def slice_failure(mir: MirProgram, diag: Diagnostic) -> SliceResult
  match slice_failure_map(mir, diag)
  when Option::Some(triple) then slice_failure_node_slice(triple.0, triple.1, triple.2)
  when Option::None then slice_result_empty()
  end
end

# ———————————————————————————————————————————————————————————————
# slice_effect — the statements contributing one effect class
# ———————————————————————————————————————————————————————————————
# One row per function whose DIRECT §11 summary has the class: the class's
# direct sites (per the §11 evidence — classify_call/_deinit reuse, the
# string-concat MirBinOp::Add, the fail-closed perform) + each site's
# anchored def chains of the values it reads (the module doc's model).

# Per-statement class evidence (3 slots: Alloc/Block/Io per
# effect_class_slot_index), mirroring mir_effect_scan_function's two arms.
def slice_stmt_effect_evidence(f: MirFunction, st: MirStatement) -> Vec[String]
  var ev: Vec[String] = Vec::from(["".to_string(), "".to_string(), "".to_string()])
  match st.kind
  when MirStatementKind::MirAssign(dest, rvalue) then
    match rvalue.kind
    when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
      let dest_ty = mir_effect_place_type(&f, &dest)
      let dest_str = mir_effect_type_is_string_like(&dest_ty)
      let lhs_str = mir_effect_operand_is_string(&f, &lhs)
      let rhs_str = mir_effect_operand_is_string(&f, &rhs)
      if dest_str || lhs_str || rhs_str then
        ev[0] = "the `+` String concatenation (the _tg_str_concat owned heap String wrap)"
      end
    when _ then ()
    end
  when MirStatementKind::MirEffectPerform(_, _, _, _, _) then
    ev[0] = "an algebraic-effects perform whose handler's allocation behavior cannot be proven"
    ev[1] = "an algebraic-effects perform whose handler's blocking behavior cannot be proven"
    ev[2] = "an algebraic-effects perform whose handler's I/O behavior cannot be proven"
  when _ then ()
  end
  ev
end

# Per-terminator class evidence (the §11 classifier's direct records;
# assert/abort sites are panic-class only).
def slice_term_effect_evidence(mir: MirProgram, f: MirFunction, term: MirTerminator, type_index: Map[Int, String], fn_index: Map[String, Int]) -> Vec[String]
  var ev: Vec[String] = Vec::from(["".to_string(), "".to_string(), "".to_string()])
  match term.kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail: _ } then
    let cc = mir_effect_classify_call(mir, &f, &type_index, &fn_index, &func, &args, intrinsic)
    var i = 0
    while i < 3 && i < cc.evidence.len() do
      ev[i] = cc.evidence[i].clone()
      i = i + 1
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    let cd = mir_effect_classify_deinit(mir, &fn_index, &deinit_fn)
    var i2 = 0
    while i2 < 3 && i2 < cd.evidence.len() do
      ev[i2] = cd.evidence[i2].clone()
      i2 = i2 + 1
    end
  when _ then ()
  end
  ev
end

pub def slice_effect(mir: MirProgram, class: EffectClass) -> Vec[SliceResult]
  let type_index = slice_type_index(&mir)
  let fn_index = slice_fn_index(&mir)
  var state = MirEffectState {}
  for f in mir.functions do
    mir_effect_scan_function(&mir, &mut state, &type_index, &fn_index, &f)
  end
  var slot = effect_class_slot_index(class)
  var rows_by_name: Map[String, SliceResult] = Map::new()
  var seen_fns: Set[String] = Set::new()
  for f in mir.functions do
    var summary = EffectSummary {}
    match state.direct.get(f.name.clone())
    when Option::Some(s) then summary = s.clone()
    when Option::None then ()
    end
    if effect_summary_has_class(&summary, &class) then
      if !seen_fns.contains(&f.name) then
        seen_fns.insert(f.name.clone())
        match slice_fn_find(&mir, f.name.clone())
        when Option::Some(ctx) then
          var back = slice_back_new(ctx.clone())
          var bi = 0
          while bi < ctx.f.blocks.len() do
            let block_id = ctx.f.blocks[bi].id.id
            let block_len = ctx.f.blocks[bi].statements.len()
            var si = 0
            while si < block_len do
              let st = ctx.f.blocks[bi].statements[si]
              let ev = slice_stmt_effect_evidence(&f, st)
              if slot < ev.len() && ev[slot].len() > 0 then
                let node_key = slice_stmt_key(&ctx.name, block_id, si)
                if !back.included.contains_key(&node_key) then
                  let nspan = slice_span_copy(st.span)
                  let span_key = slice_span_key(&node_key, nspan)
                  back.included.insert(node_key, span_key)
                end
                let reads = slice_stmt_reads(st)
                for r in reads do
                  slice_backward_at(&mut back, bi, si, r)
                end
              end
              si = si + 1
            end
            let term = ctx.f.blocks[bi].terminator
            let tev = slice_term_effect_evidence(&mir, &f, &term, &type_index, &fn_index)
            if slot < tev.len() && tev[slot].len() > 0 then
              let node_key = slice_term_key(&ctx.name, block_id)
              if !back.included.contains_key(&node_key) then
                let nspan = slice_span_copy(term.span)
                let span_key = slice_span_key(&node_key, nspan)
                back.included.insert(node_key, span_key)
              end
              let treads = slice_term_reads(&term)
              for tr in treads do
                slice_backward_at(&mut back, bi, block_len, tr)
              end
            end
            bi = bi + 1
          end
          let row = slice_result_build(&ctx, &back.included, &back.external,
            slice_back_info(back, slice_model_effect()))
          rows_by_name.insert(f.name.clone(), row)
        when Option::None then ()
        end
      end
    end
  end
  # rows sorted by function key (deterministic order).
  var names: Vec[String] = Vec::new()
  var entries: Vec[(String, SliceResult)] = rows_by_name.entries()
  for entry in entries do
    names.push(entry.0.clone())
  end
  semantic_strings_sort(&mut names)
  var sorted: Vec[SliceResult] = Vec::new()
  for n in names do
    match rows_by_name.get(n.clone())
    when Option::Some(r2) then sorted.push(r2.clone())
    when Option::None then ()
    end
  end
  sorted
end

# ———————————————————————————————————————————————————————————————
# slice_digest — the content-addressed digest of slice results
# ———————————————————————————————————————————————————————————————
# The digest preimage is the SORTED canonical JSONL row set of the
# results (function / statement / external rows — the semantic_index.tg
# line style). span_keys NEVER serialize (spans are presentation, never
# identity).

def slice_digest_lines(results: Vec[SliceResult]) -> Vec[String]
  var lines: Vec[String] = Vec::new()
  lines.push("{\"s\":\"header\",\"format\":\"tg-semantic-slice/v1\"}")
  for r in results do
    let fkey = r.function_key.clone()
    if fkey.len() > 0 then
      lines.push("{\"s\":\"slice\",\"f\":\"" + semantic_json_escape(&fkey) + "\"}")
      for k in r.statements do
        lines.push("{\"s\":\"stmt\",\"f\":\"" + semantic_json_escape(&fkey) + "\",\"k\":\"" + semantic_json_escape(&k) + "\"}")
      end
      for e in r.external do
        lines.push("{\"s\":\"ext\",\"f\":\"" + semantic_json_escape(&fkey) + "\",\"k\":\"" + semantic_json_escape(&e) + "\"}")
      end
    end
  end
  semantic_strings_sort(&mut lines)
  lines
end

pub def slice_digest(results: Vec[SliceResult]) -> StableDigest
  var text = ""
  let lines = slice_digest_lines(results)
  for l in lines do
    text = text + l + "\n"
  end
  stable_digest_of(&text)
end

# ———————————————————————————————————————————————————————————————
# THE TYPED §33 SLICE ENTRY (audit item 22) — mir_slice
# ———————————————————————————————————————————————————————————————
# mir_slice is the ONE typed slicing entry over an optional verified
# MirProgram: a MirSliceRequest (function_key + kind + anchor) in, a typed
# Result[MirSlice, MirSliceError] out. The four slices above stay the
# engines; each MirSliceKind routes onto them (plus the module-local
# ControlDependence / Ownership walks below):
#
#   BackwardDataflow   → slice_value-style backward def chains.
#   ForwardDataflow    → slice_statement-style forward use chains.
#   ControlDependence  → the standard CDG closure of the anchor block.
#   Ownership          → the place-family walk below.
#   Effects            → slice_effect's §11 classifier row of the fn.
#   Failure            → the node-anchored slice_failure machinery.
#   ReturnValue        → the backward slice of the "_ret" local 0.
#   Dominators         → mir_dominators (entry-anchored "block|idom" rows).
#   PostDominators     → mir_postdominators (reverse CFG, virtual exit).
#   Loops              → mir_loops (the natural-loop forest rows).
#   ReachingDefs       → mir_reaching_defs (node anchor; per-operand rows).
#   Path               → mir_paths (drop/effect site anchor; the dataflow
#                        path with the item-16 stable statement texts).
#
# REQUEST ANCHOR GRAMMAR (per kind):
#   node anchors    — the §33 statement/terminator key texts
#                     "<fn emission name>#B<block id>#S<stmt index>" and
#                     "<fn emission name>#B<block id>#T" (BackwardDataflow,
#                     ForwardDataflow, ControlDependence, Failure). The
#                     key's function prefix must equal the request's
#                     function_key (a foreign-prefixed key never resolves
#                     inside this function: AnchorNotFound).
#   local anchors   — the §27 local key text of ONE slot: the declared
#                     name (name-first over ALL slots, first-wins) or the
#                     "l<id>" locator of an unnamed slot; out-of-range ids
#                     never resolve (BackwardDataflow, ForwardDataflow):
#                     the slice of the LOCAL's value.
#   place anchors   — the §7 place key text (local root + projection
#                     segments: ".field"/".variant" names from the MIR
#                     type table, ".digits" tuple indexes, "[name]"/"[n]"
#                     element indexes, "*" derefs) whose root resolves to
#                     a local (Ownership). A root-only anchor matches the
#                     WHOLE place family of the local; a projected anchor
#                     matches exactly the anchored place and its textual
#                     descendants.
#   class words     — "alloc" / "block" / "io", plus the claim spellings
#                     "no_alloc" / "no_block" / "no_io" and the message
#                     words "allocation" / "blocking" / "I/O" (Effects).
#   ReturnValue     — the anchor text is ignored (pass "").
#   Dominators / PostDominators / Loops — the anchor text is ignored (the
#                     rows cover the whole function).
#   ReachingDefs    — the node-key anchor of the USE statement/terminator.
#   Path            — the node-key anchor of a MirDeinit terminator (drop)
#                     or a §11 effect site (call/deinit/perform/record).
#
# ERROR MAPPING: Option::None → MirProgramUnavailable; a function_key
# naming no emission name → FunctionNotFound; an anchor that is not a key
# of its kind or whose key does not resolve (a missing block/statement, an
# unresolvable local/place root, an unknown class word, a non-site Path
# anchor) → AnchorNotFound.
# MirSliceError::UnsupportedKind is the RESERVED variant of the typed
# surface: every kind routes today, so the error never leaves the module
# (documented).
#
# The MirSlice payload carries the sorted statement key texts + sorted
# external anchors + the shared CompletenessInfo (audit item 9); span_keys
# never cross this boundary (spans are presentation-only per the module
# doc). The MIR-graph kinds answer their
# canonical ROW grammar in statements: "block|idom" (Dominators /
# PostDominators, an empty right side = the virtual exit), "header|parent|
# blocks" (Loops) and "local|def1,def2" (ReachingDefs). Empty Ok slices are
# documented per kind: a node-anchored BackwardDataflow whose node reads
# nothing, a ForwardDataflow node whose defs nothing reads, an Effects
# request whose function has no DIRECT class row (a class reaching it only
# through in-program callees lives in the callee rows), a value with no use
# sites (slice_value's rule) and the CFG walks with nothing to report.
#
# THE REQUEST REQUIREMENT (audit item 9): MirSliceRequest.require is
# BestEffort (the default — the answer returns with its annotated
# completeness whatever the class) or ProofComplete. ProofComplete is a
# GATE: when the routed answer's completeness is not Complete, the entry
# fails with MirSliceError::IncompleteRequirement carrying the class and
# the truncation/limitation reason — an incomplete answer is NEVER
# returned to a proof-demanding caller. The other typed errors
# (FunctionNotFound / AnchorNotFound / MirProgramUnavailable) are
# unchanged by the requirement.

enum MirSliceKind
  BackwardDataflow
  ForwardDataflow
  ControlDependence
  Ownership
  Effects
  Failure
  ReturnValue
  # (third-audit item 20/22) the MIR-graph reasoning kinds — dependence
  # outputs keyed by the item-16 role-derived stable statement ids and the
  # §1 StableMirBlockId.stable_key texts (the MIR GRAPH REASONING section
  # at the bottom of this module).
  Dominators
  PostDominators
  Loops
  ReachingDefs
  Path
end

# The ProofComplete gate (audit item 9): what a request demands of the
# answer's completeness. BestEffort (the default) returns the answer with
# its CompletenessInfo whatever the class; ProofComplete FAILS with
# MirSliceError::IncompleteRequirement naming the class and the
# truncation/limitation reason instead of returning an incomplete answer.
enum SliceRequirement
  BestEffort
  ProofComplete
end

# The canonical requirement word (the v1 text suffix / wire vocabulary).
pub def slice_requirement_word(require: SliceRequirement) -> String
  match require
  when SliceRequirement::BestEffort then "best-effort"
  when SliceRequirement::ProofComplete then "proof-complete"
  end
end

# The requirement of a canonical word (Option::None outside the two).
pub def slice_requirement_of_word(word: String) -> Option[SliceRequirement]
  if word == "best-effort" then
    return Option::Some(SliceRequirement::BestEffort)
  end
  if word == "proof-complete" then
    return Option::Some(SliceRequirement::ProofComplete)
  end
  Option::None
end

# ONE typed slice request. Anchor texts follow the per-kind grammar above.
# require defaults to BestEffort (the historical behavior — an existing
# caller keeps receiving annotated answers); ProofComplete turns the entry
# into a proof gate (see SliceRequirement).
struct MirSliceRequest
  function_key: String
  kind: MirSliceKind
  anchor: String
  require: SliceRequirement = SliceRequirement::BestEffort
end

# The typed error of a slice request. UnsupportedKind is reserved (never
# produced: every MirSliceKind routes — documented above).
# IncompleteRequirement carries the shared completeness class + the
# truncation/limitation reason of the answer a ProofComplete request
# refused (audit item 9).
enum MirSliceError
  FunctionNotFound
  AnchorNotFound
  MirProgramUnavailable
  UnsupportedKind
  IncompleteRequirement(completeness: SliceCompleteness, reason: String)
end

# The canonical single-line render of a slice error (the query adapter's
# diagnostic carrier; the incomplete form names the completeness class and
# the truncation reason, never a bare "incomplete").
pub def mir_slice_error_text(err: MirSliceError) -> String
  match err
  when MirSliceError::FunctionNotFound then "function-not-found"
  when MirSliceError::AnchorNotFound then "anchor-not-found"
  when MirSliceError::MirProgramUnavailable then "mir-program-unavailable"
  when MirSliceError::UnsupportedKind then "unsupported-kind"
  when MirSliceError::IncompleteRequirement(completeness, reason) then
    "incomplete-requirement: completeness=" + slice_completeness_word(completeness.clone()) +
      " reason=" + reason.clone()
  end
end

# ONE typed slice result: the sorted stable statement key texts, the
# sorted external anchors, the kind that produced the row and the shared
# completeness record (audit item 9 — every engine populates it; span_keys
# do not ride this record, presentation-only, never identity).
struct MirSlice
  function_key: String
  statements: Vec[String] = Vec::new()
  externals: Vec[String] = Vec::new()
  kind: MirSliceKind
  info: CompletenessInfo = CompletenessInfo {}
end

# ———————————————————————————————————————————————————————————————
# Anchor parsers (the typed entry's key texts)
# ———————————————————————————————————————————————————————————————

# A node-key anchor resolved inside a function ctx: (block Vec index, node
# index; the terminator's node index IS the block's statement count).
# Option::None when the key does not parse or names a missing node.
def slice_node_anchor_at(ctx: SliceFnCtx, anchor: String) -> Option[(Int, Int)]
  match slice_key_parts(&ctx.name, &anchor)
  when Option::Some(parts) then
    let block_id = parts.0
    let node_idx = parts.1
    let is_term = parts.2
    let v = slice_block_vec_index(&ctx, block_id)
    if v < 0 || v >= ctx.f.blocks.len() then
      return Option::None
    end
    let block_len = ctx.f.blocks[v].statements.len()
    if is_term then
      return Option::Some((v, block_len))
    end
    if node_idx >= 0 && node_idx < block_len then
      return Option::Some((v, node_idx))
    end
    Option::None
  when Option::None then Option::None
  end
end

# The canonical local key text of one slot (snapshot_local_name's grammar:
# the declared name when the slot has one, else the "l<id>" locator).
def slice_local_canonical_text(f: MirFunction, local: Int) -> String
  if local >= 0 && local < f.locals.len() then
    let name = f.locals[local].name.clone()
    if name.len() > 0 then
      return name
    end
  end
  "l" + local.to_string()
end

# A local/key anchor resolved inside a function ctx: the declared-name
# match first (over ALL slots, first-wins — a local literally named "l7"
# wins over the locator), then the "l<id>" locator of a slot in range.
# Option::None when neither resolves.
def slice_local_anchor_at(ctx: SliceFnCtx, anchor: String) -> Option[Int]
  var i = 0
  while i < ctx.f.locals.len() do
    if ctx.f.locals[i].name == anchor then
      return Option::Some(ctx.f.locals[i].id.id)
    end
    i = i + 1
  end
  if anchor.len() > 1 && anchor.slice(0, 1) == "l" then
    let digits = anchor.slice(1, anchor.len())
    if digits.len() <= 9 && slice_is_digits(&digits) then
      let id = slice_text_to_int(&digits)
      if id >= 0 && id < ctx.f.locals.len() then
        return Option::Some(id)
      end
    end
  end
  Option::None
end

# The canonical spellings of an effect CLASS word (the claims' names, the
# class message words and the class names themselves).
def slice_effect_class_of_anchor(anchor: String) -> Option[EffectClass]
  if anchor == "alloc" || anchor == "no_alloc" || anchor == "allocation" then
    return Option::Some(EffectClass::Alloc)
  end
  if anchor == "block" || anchor == "no_block" || anchor == "blocking" then
    return Option::Some(EffectClass::Block)
  end
  if anchor == "io" || anchor == "no_io" || anchor == "I/O" then
    return Option::Some(EffectClass::Io)
  end
  Option::None
end

# Whether one rendered place text is AT or BELOW another (the anchored
# place itself or a projection descendant — boundary-aware, so "x.f" never
# matches "x.f2").
def slice_place_text_touches(anchor_text: String, place_text: String) -> Bool
  if place_text == anchor_text then
    return true
  end
  if place_text.len() > anchor_text.len() then
    if place_text.slice(0, anchor_text.len()) == anchor_text then
      let nxt = place_text.slice(anchor_text.len(), anchor_text.len() + 1)
      if nxt == "." || nxt == "[" || nxt == "*" then
        return true
      end
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Place collectors — the operand/place keys of one node (the Ownership
# walk's atoms; place-payloaded mirrors of the reads collectors)
# ———————————————————————————————————————————————————————————————

# The place of a place-kind operand (None for constants).
def slice_operand_place(op: MirOperand) -> Option[Place]
  match op.kind
  when MirOperandKind::MirCopy(p) then Option::Some(p)
  when MirOperandKind::MirMovePlace(p) then Option::Some(p)
  when MirOperandKind::MirRead(p) then Option::Some(p)
  when MirOperandKind::MirConsume(p) then Option::Some(p)
  when _ then Option::None
  end
end

# The rvalue's place sources (the slice_rvalue_reads mirror with the full
# places; MirPhi sources are VALUES — no places).
def slice_rvalue_places(rv: MirRvalueKind, inout out: Vec[Place]) -> Unit
  match rv
  when MirRvalueKind::MirMove(op) then
    match slice_operand_place(&op)
    when Option::Some(p) then out.push(p)
    when Option::None then ()
    end
  when MirRvalueKind::MirRef(place) then out.push(place)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      match slice_operand_place(&op)
      when Option::Some(p2) then out.push(p2)
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    match slice_operand_place(&lhs)
    when Option::Some(la) then out.push(la)
    when Option::None then ()
    end
    match slice_operand_place(&rhs)
    when Option::Some(ra) then out.push(ra)
    when Option::None then ()
    end
  when MirRvalueKind::MirUnOp(_, op) then
    match slice_operand_place(&op)
    when Option::Some(u) then out.push(u)
    when Option::None then ()
    end
  when MirRvalueKind::MirDiscriminant(place) then out.push(place)
  when MirRvalueKind::MirLen(place) then out.push(place)
  when MirRvalueKind::MirCast(_, op, _) then
    match slice_operand_place(&op)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
  when MirRvalueKind::MirRepeat(op, _) then
    match slice_operand_place(&op)
    when Option::Some(r) then out.push(r)
    when Option::None then ()
    end
  when _ then ()
  end
end

# The place of a call argument (Place-valued args and place-kind operand
# args; BARE write-args still touch their place — the ownership view keeps
# the site even when the dataflow read rule drops it).
def slice_call_arg_place(arg: MirCallArg) -> Option[Place]
  match arg.value
  when MirCallValue::Place(p) then Option::Some(p)
  when MirCallValue::Value(op) then slice_operand_place(&op)
  end
end

# The places one statement touches: the assignment DEST plus the rvalue's
# place sources (contract checks, effect records/performs and effect frame
# enters contribute their operand places).
def slice_stmt_places(st: MirStatement) -> Vec[Place]
  var out: Vec[Place] = Vec::new()
  match st.kind
  when MirStatementKind::MirAssign(dest, rvalue) then
    out.push(dest)
    slice_rvalue_places(rvalue.kind, &mut out)
  when MirStatementKind::MirContractCheck(contract, operand) then
    match slice_operand_place(&contract.condition)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
    match slice_operand_place(&operand)
    when Option::Some(o) then out.push(o)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectRecord(_, operand) then
    match slice_operand_place(&operand)
    when Option::Some(e) then out.push(e)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectPerform(_, _, _, payload_ptr, result_ptr) then
    match slice_operand_place(&payload_ptr)
    when Option::Some(p) then out.push(p)
    when Option::None then ()
    end
    match slice_operand_place(&result_ptr)
    when Option::Some(r) then out.push(r)
    when Option::None then ()
    end
  when MirStatementKind::MirEffectFrameEnter(_, _, _, _, env_ptr) then
    match slice_operand_place(&env_ptr)
    when Option::Some(e2) then out.push(e2)
    when Option::None then ()
    end
  when _ then ()
  end
  out
end

# The places one terminator touches: the switch scrutinee, the call's
# dest/func/arguments, the assert's condition (+ bounds operands), the
# deinit's place (a destruction IS a place touch).
def slice_term_places(term: MirTerminator) -> Vec[Place]
  var out: Vec[Place] = Vec::new()
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets: _, default_target: _ } then
    match slice_operand_place(&op)
    when Option::Some(s) then out.push(s)
    when Option::None then ()
    end
  when MirTerminatorKind::MirCall { dest, func, args, success: _, unwind: _, intrinsic: _, tail: _ } then
    out.push(dest)
    match slice_operand_place(&func)
    when Option::Some(c) then out.push(c)
    when Option::None then ()
    end
    for arg in args do
      match slice_call_arg_place(&arg)
      when Option::Some(a) then out.push(a)
      when Option::None then ()
      end
    end
  when MirTerminatorKind::MirAssert { cond, expected: _, msg, target: _, unwind: _ } then
    match slice_operand_place(&cond)
    when Option::Some(cc) then out.push(cc)
    when Option::None then ()
    end
    match msg
    when AssertMessage::BoundsCheck(index_op, len_op) then
      match slice_operand_place(&index_op)
      when Option::Some(io) then out.push(io)
      when Option::None then ()
      end
      match slice_operand_place(&len_op)
      when Option::Some(lo) then out.push(lo)
      when Option::None then ()
      end
    when _ then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn: _, target: _, unwind: _ } then
    out.push(place)
  when _ then ()
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Place-text rendering — the §7 canonical place key over the MIR type
# table (declaration names; a type the program table does not carry falls
# back to the deterministic "f<index>" / "v<index>" render — documented;
# the fallback never appears for verified programs whose types table is
# complete).
# ———————————————————————————————————————————————————————————————

# The struct FIELD name of an owner TypeId (the deterministic "f<index>"
# fallback when the owner is not a Struct of the program table).
def slice_field_name_text(mir: MirProgram, owner_id: Int, index: Int) -> String
  for td in mir.types do
    if td.id.id == owner_id then
      match td.kind
      when MirTypeDefKind::Struct(fields) then
        if index >= 0 && index < fields.len() then
          return fields[index].name.clone()
        end
      when _ then ()
      end
      return "f" + index.to_string()
    end
  end
  "f" + index.to_string()
end

# The enum VARIANT name of an owner TypeId (the deterministic "v<index>"
# fallback, see slice_field_name_text).
def slice_variant_name_text(mir: MirProgram, owner_id: Int, index: UInt) -> String
  let vi = index as Int
  for td in mir.types do
    if td.id.id == owner_id then
      match td.kind
      when MirTypeDefKind::Enum(variants) then
        if vi >= 0 && vi < variants.len() then
          return variants[vi].name.clone()
        end
      when _ then ()
      end
      return "v" + vi.to_string()
    end
  end
  "v" + vi.to_string()
end

# The canonical place key text of one place (the module doc's §7 grammar:
# canonical root local text + ".field"/".variant" name segments from the
# MIR type table, ".digits" tuple indexes, "[name]"/"[digits]" element
# indexes, "*" derefs).
def slice_render_place(mir: MirProgram, f: MirFunction, p: Place) -> String
  var text = slice_local_canonical_text(&f, p.local.id)
  for proj in p.projections do
    match proj
    when Projection::ProjDeref then text = text + "*"
    when Projection::Field(fid) then
      text = text + "." + slice_field_name_text(&mir, fid.owner.id, fid.index)
    when Projection::Variant(vid) then
      text = text + "." + slice_variant_name_text(&mir, vid.owner.id, vid.index)
    when Projection::TupleIndex(idx) then text = text + "." + idx.to_string()
    when Projection::ProjIndex(local_id) then
      text = text + "[" + slice_local_canonical_text(&f, local_id.id) + "]"
    when Projection::ProjConstantIndex(idx2) then text = text + "[" + idx2.to_string() + "]"
    end
  end
  text
end

# ———————————————————————————————————————————————————————————————
# The Ownership walk — nodes whose operand/place keys touch the anchor
# ———————————————————————————————————————————————————————————————
# A root-only anchor (tail == "") matches the WHOLE place family rooted at
# the local (every node whose read/write/dest place has that root — the
# conservative family). A projected anchor (tail != "") matches the nodes
# whose rendered place key sits AT or BELOW the anchor's canonical text
# (slice_place_text_touches). One deterministic single pass over the
# function's nodes — no worklist, bounded by the function's size.

# Whether any collected place touches (root, tail) — see the walk doc.
def slice_places_touch(mir: MirProgram, f: MirFunction, places: Vec[Place], root: Int, tail: String) -> Bool
  if tail.len() == 0 then
    for p in places do
      if p.local.id == root then
        return true
      end
    end
    return false
  end
  let canonical = slice_local_canonical_text(&f, root) + tail
  for p in places do
    if p.local.id == root then
      let pkey = slice_render_place(&mir, &f, &p)
      if slice_place_text_touches(&canonical, &pkey) then
        return true
      end
    end
  end
  false
end

def slice_ownership_walk(mir: MirProgram, ctx: SliceFnCtx, root: Int, tail: String) -> SliceResult
  var included: Map[String, String] = Map::new()
  var visited = 0
  var bi = 0
  while bi < ctx.f.blocks.len() do
    let block_id = ctx.f.blocks[bi].id.id
    let block_len = ctx.f.blocks[bi].statements.len()
    var si = 0
    while si < block_len do
      visited = visited + 1
      let st = ctx.f.blocks[bi].statements[si]
      if slice_places_touch(&mir, &ctx.f, slice_stmt_places(st), root, &tail) then
        let node_key = slice_stmt_key(&ctx.name, block_id, si)
        if !included.contains_key(&node_key) then
          let nspan = slice_span_copy(st.span)
          included.insert(node_key, slice_span_key(&node_key, nspan))
        end
      end
      si = si + 1
    end
    visited = visited + 1
    if slice_places_touch(&mir, &ctx.f, slice_term_places(&ctx.f.blocks[bi].terminator), root, &tail) then
      let node_key = slice_term_key(&ctx.name, block_id)
      if !included.contains_key(&node_key) then
        let nspan = slice_span_copy(ctx.f.blocks[bi].terminator.span)
        included.insert(node_key, slice_span_key(&node_key, nspan))
      end
    end
    bi = bi + 1
  end
  let empty_ext: Set[String] = Set::new()
  # COMPLETENESS (audit item 9): a projected anchor matches the anchored
  # place and its textual descendants EXACTLY (Complete); a root-only
  # anchor is the documented CONSERVATIVE whole-family match — nodes
  # touching ANY projection of the local, hence possibly extra
  # (ConservativeSuperset).
  var info = completeness_info_complete(slice_model_ownership(), visited, 0)
  if tail.len() == 0 then
    info = completeness_info_superset(slice_model_ownership(),
      "the root-only anchor matches the local's WHOLE place family (every node touching any projection of the " +
        "local): the family view is conservative by construction",
      visited, 0)
  end
  slice_result_build(&ctx, &included, &empty_ext, info)
end

# ———————————————————————————————————————————————————————————————
# The ControlDependence walk — the STANDARD CDG closure of the anchor block
# ———————————————————————————————————————————————————————————————
# The Ferrante/Ottenstein/Warren definition (the CDG builder lives in the
# MIR GRAPH REASONING section at the bottom; the walk here consumes it):
# a block Y is control dependent on a block X when X's terminator branches
# and some successor S of X does NOT postdominate X, with Y on the
# postdominator path from S up to (excluding) ipdom(X). The branch sites
# that decide whether control reaches the ANCHOR are therefore the CDG
# controllers of the anchor and, transitively, THEIR controllers — the
# closure this walk collects (one FIFO worklist, deduped, capped at
# slice_max_items() popped blocks). The anchor's own terminator is not
# included; each reached controller's TERMINATOR is (with its presentation
# span). Pure CFG slice: the conditions' own def chains stay the dataflow
# kinds' business (documented); no external anchors.

def slice_control_dependence_walk(ctx: SliceFnCtx, v: Int) -> SliceResult
  var included: Map[String, String] = Map::new()
  let ipdom_status = slice_graph_ipdom_status(ctx.clone())
  let cdg = slice_graph_cdg_with(ctx.clone(), ipdom_status.ipdom.clone())
  var seen: Set[Int] = Set::new()
  var work: Vec[Int] = Vec::new()
  var items = 0
  seen.insert(v)
  work.push(v)
  while work.len() > 0 && items < slice_max_items() do
    items = items + 1
    let b = work[0]
    work.remove(0)
    # the anchor's own terminator is included only when the anchor is one
    # of its own controllers (a loop header — its branch decides the next
    # iteration); every other reached controller's terminator is included.
    var include_node = b != v
    if b == v then
      match cdg.get(v)
      when Option::Some(rows) then
        if rows.contains(&v) then
          include_node = true
        end
      when Option::None then ()
      end
    end
    if include_node then
      let node_key = slice_term_key(&ctx.name, ctx.f.blocks[b].id.id)
      if !included.contains_key(&node_key) then
        let nspan = slice_span_copy(ctx.f.blocks[b].terminator.span)
        included.insert(node_key, slice_span_key(&node_key, nspan))
      end
    end
    var controllers: Vec[Int] = Vec::new()
    match cdg.get(b)
    when Option::Some(rows) then controllers = rows.clone()
    when Option::None then ()
    end
    for c in controllers do
      if !seen.contains(&c) then
        seen.insert(c)
        work.push(c)
      end
    end
  end
  let empty_ext: Set[String] = Set::new()
  # COMPLETENESS (audit item 9): the standard CDG closure is EXACT once the
  # postdominator sets converged and the anchor block carries a position
  # (every controller of an exit-reaching anchor itself reaches an exit,
  # so no controller goes missing). A non-converged fixpoint (the round
  # cap) is Truncated; an unpositioned anchor (it cannot reach a structural
  # exit — the non-terminating-region case) is ConservativeSubset: its
  # control dependences are not decided.
  var info = completeness_info_complete(slice_model_cdg(), items, 0)
  if work.len() > 0 && items >= slice_max_items() then
    info = completeness_info_truncated(slice_model_cdg(),
      "cap: slice_max_items=" + slice_max_items().to_string() +
        " work items exhausted; " + work.len().to_string() + " block(s) remain unprocessed",
      items, 0, work.len())
  elsif !ipdom_status.converged then
    info = completeness_info_truncated(slice_model_cdg(),
      "cap: the postdominator set fixpoint round cap 2*|blocks|+8 was exhausted without a fixed point",
      items, 0, ipdom_status.domain_size)
  elsif !ipdom_status.ipdom.contains_key(&v) then
    info = completeness_info_subset(slice_model_cdg(),
      "the anchor block cannot reach a structural exit (no postdominator position): its control dependences are not decided",
      items, 0, 1)
  end
  slice_result_build(&ctx, &included, &empty_ext, info)
end

# ———————————————————————————————————————————————————————————————
# The node-anchored BackwardDataflow slice
# ———————————————————————————————————————————————————————————————
# The anchor node + the anchored def chains of every value the node reads
# (one shared SliceBack engine — the slice_value machinery seeded at the
# anchor's use sites; a node reading nothing yields the anchor node alone;
# a node with no defs below the reads stops at the parameters/externals
# per the engine's rules).

def slice_backward_node_slice(ctx: SliceFnCtx, v: Int, idx: Int) -> SliceResult
  var back = slice_back_new(ctx.clone())
  let block_len = back.ctx.f.blocks[v].statements.len()
  var reads: Vec[Int] = Vec::new()
  var span = Span { file: "", start: 0, end_pos: 0 }
  if idx >= block_len then
    let term = back.ctx.f.blocks[v].terminator
    reads = slice_term_reads(&term)
    span = slice_span_copy(term.span)
  else
    let st = back.ctx.f.blocks[v].statements[idx]
    reads = slice_stmt_reads(st)
    span = slice_span_copy(st.span)
  end
  # the anchor node itself, then one anchored def-chain walk per read.
  slice_back_include(&mut back, v, idx, span)
  for r in reads do
    slice_backward_at(&mut back, v, idx, r)
  end
  slice_result_build(&back.ctx, &back.included, &back.external,
    slice_back_info(back, slice_model_node_chain()))
end

# ———————————————————————————————————————————————————————————————
# The local-anchored ForwardDataflow slice
# ———————————————————————————————————————————————————————————————
# The forward use slice of ONE local's value: the entry-value chain (the
# value as it enters the first block — a parameter's uses, for example)
# UNION one chain per def site of the local (the def node itself is
# included; the engine follows the def's uses forward until a later def
# kills the chain). One shared SliceFwd engine = one 4096-item budget,
# deterministic FIFO order.

def slice_forward_value_slice(ctx: SliceFnCtx, local: Int) -> SliceResult
  var fwd = slice_fwd_new(ctx.clone())
  # (a) the value as it enters the entry block.
  let entry_v = slice_block_vec_index(&fwd.ctx, fwd.ctx.f.entry_block.id)
  slice_fwd_push(&mut fwd, entry_v, 0, local)
  # (b) one chain per def site (bare or partial) with the def node itself.
  var bi = 0
  while bi < fwd.ctx.f.blocks.len() do
    let block_len = fwd.ctx.f.blocks[bi].statements.len()
    var si = 0
    while si < block_len do
      let st = fwd.ctx.f.blocks[bi].statements[si]
      let st_defs = slice_stmt_defs(st)
      if st_defs.0 == local || st_defs.1 == local then
        let span = slice_span_copy(st.span)
        slice_fwd_include(&mut fwd, bi, si, span)
        slice_fwd_push(&mut fwd, bi, si + 1, local)
      end
      si = si + 1
    end
    let term = fwd.ctx.f.blocks[bi].terminator
    let term_defs = slice_term_defs(&term)
    if term_defs.0 == local || term_defs.1 == local then
      let tspan = slice_span_copy(term.span)
      slice_fwd_include(&mut fwd, bi, block_len, tspan)
      slice_fwd_push(&mut fwd, bi, block_len + 1, local)
    end
    bi = bi + 1
  end
  slice_fwd_run(&mut fwd)
  slice_result_build(&fwd.ctx, &fwd.included, &fwd.external,
    slice_fwd_info(fwd, slice_model_local_forward()))
end

# ———————————————————————————————————————————————————————————————
# The typed surface — conversion + per-kind routes
# ———————————————————————————————————————————————————————————————

# The MirSlice view of a slice result (span_keys never cross this
# boundary — presentation-only per the module doc). A result carrying the
# EMPTY marker function key (slice_result_empty — the documented "no
# slice" marker of the four defs, e.g. a def-less ForwardDataflow node)
# is normalized onto the request's function key: an empty Ok slice still
# names its function.
def slice_mir_of_result(fn_key: String, r: SliceResult, kind: MirSliceKind) -> MirSlice
  var fk = r.function_key.clone()
  if fk.len() == 0 then
    fk = fn_key
  end
  MirSlice {
    function_key: fk,
    statements: r.statements.clone(),
    externals: r.external.clone(),
    kind: kind,
    info: r.info.clone()
  }
end

# BackwardDataflow: node anchors slice the node + its reads' def chains;
# local anchors delegate the whole slice_value walk of the local.
def slice_mir_backward(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    if slice_key_marker(&anchor) > 0 then
      match slice_node_anchor_at(&ctx, &anchor)
      when Option::Some(parts) then
        return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_backward_node_slice(&ctx, parts.0, parts.1), MirSliceKind::BackwardDataflow))
      when Option::None then
        return Result::Err(MirSliceError::AnchorNotFound)
      end
    else
      match slice_local_anchor_at(&ctx, &anchor)
      when Option::Some(local) then
        return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_value(mir, fn_key, local), MirSliceKind::BackwardDataflow))
      when Option::None then
        return Result::Err(MirSliceError::AnchorNotFound)
      end
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# ForwardDataflow: node anchors delegate slice_statement (a def-less node —
# asserts, checks, switches — yields the documented empty slice); local
# anchors delegate the forward value slice below.
def slice_mir_forward(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    if slice_key_marker(&anchor) > 0 then
      # validated here (a def-less node — asserts, checks, switches —
      # yields the documented empty slice through slice_statement).
      match slice_node_anchor_at(&ctx, &anchor)
      when Option::Some(_) then
        return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_statement(mir, fn_key, anchor), MirSliceKind::ForwardDataflow))
      when Option::None then
        return Result::Err(MirSliceError::AnchorNotFound)
      end
    else
      match slice_local_anchor_at(&ctx, &anchor)
      when Option::Some(local) then
        return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_forward_value_slice(&ctx, local), MirSliceKind::ForwardDataflow))
      when Option::None then
        return Result::Err(MirSliceError::AnchorNotFound)
      end
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# ControlDependence: a node-key anchor names the block whose reachability
# the walk decides (its block Vec index + the conditional terminators on
# its predecessor chains — see the walk doc).
def slice_mir_control(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &anchor)
    when Option::Some(parts) then
      return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_control_dependence_walk(&ctx, parts.0), MirSliceKind::ControlDependence))
    when Option::None then
      return Result::Err(MirSliceError::AnchorNotFound)
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# Ownership: the anchor is a §27 local key text (the whole family under
# the local) or a §7 place key text rooted at a local (the anchored place
# and its descendants) — see the walk doc.
def slice_mir_ownership(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    # the root segment: the text up to the first projection character.
    var root_end = 0
    while root_end < anchor.len() do
      let ch = anchor.slice(root_end, root_end + 1)
      if ch == "." || ch == "[" || ch == "*" then
        break
      end
      root_end = root_end + 1
    end
    let root_text = anchor.slice(0, root_end)
    match slice_local_anchor_at(&ctx, &root_text)
    when Option::Some(root) then
      let tail = anchor.slice(root_end, anchor.len())
      return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_ownership_walk(&mir, &ctx, root, &tail), MirSliceKind::Ownership))
    when Option::None then
      return Result::Err(MirSliceError::AnchorNotFound)
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# Effects: the anchor is a class word; the result is the request function's
# DIRECT §11 row (slice_effect's per-function rows — the class's direct
# sites + their anchored def chains). A function whose summary reaches the
# class only through in-program callees has no DIRECT row: the empty Ok
# slice (the sites live in the callees' rows — documented).
def slice_mir_effects(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_effect_class_of_anchor(&anchor)
    when Option::Some(class) then
      let rows = slice_effect(mir, class)
      var row: Option[SliceResult] = Option::None
      for r in rows do
        if r.function_key == ctx.name then
          row = Option::Some(r.clone())
          break
        end
      end
      match row
      when Option::Some(res) then
        return Result::Ok(slice_mir_of_result(fn_key.clone(), res.clone(), MirSliceKind::Effects))
      when Option::None then
        return Result::Ok(MirSlice {
          function_key: ctx.name.clone(),
          statements: Vec::new(),
          externals: Vec::new(),
          kind: MirSliceKind::Effects,
          info: completeness_info_complete(slice_model_effect(), 0, 0)
        })
      end
    when Option::None then
      return Result::Err(MirSliceError::AnchorNotFound)
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# Failure: the anchor is the node key of the failing site; the result is
# the failure trace + the anchored def chains of its reads — the exact
# slice_failure machinery over the direct node anchor.
def slice_mir_failure(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &anchor)
    when Option::Some(parts) then
      return Result::Ok(slice_mir_of_result(fn_key.clone(), slice_failure_node_slice(&ctx, parts.0, parts.1), MirSliceKind::Failure))
    when Option::None then
      return Result::Err(MirSliceError::AnchorNotFound)
    end
    # unreachable: every path above returned.
    Result::Err(MirSliceError::AnchorNotFound)
  end
end

# ReturnValue: the backward slice of the return local — local 0, the "_ret"
# place of start_function's convention (MirReturn terminators read it, so
# slice_value resolves one def chain per return site). The anchor text is
# ignored (documented). A bodyless function (no locals) yields the empty
# Ok slice.
def slice_mir_return(mir: MirProgram, fn_key: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir, fn_key.clone())
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    if ctx.f.locals.len() <= 0 then
      return Result::Ok(MirSlice {
        function_key: ctx.name.clone(),
        statements: Vec::new(),
        externals: Vec::new(),
        kind: MirSliceKind::ReturnValue,
        info: completeness_info_complete(slice_model_value_chain(), 0, 0)
      })
    end
    let r = slice_value(mir, fn_key, 0)
    Result::Ok(slice_mir_of_result(fn_key.clone(), r, MirSliceKind::ReturnValue))
  end
end

# Dominators: the whole-function "block|idom" row set (mir_dominator_rows;
# the anchor text is ignored). Rows are the §1 StableMirBlockId.stable_key
# texts — never the dense §33 node locators.
def slice_mir_graph_dominators(mir: MirProgram, fn_key: String) -> Result[MirSlice, MirSliceError]
  match mir_dominator_rows(mir.clone(), fn_key.clone())
  when Option::Some(rows) then
    Result::Ok(MirSlice {
      function_key: fn_key.clone(),
      statements: rows.clone(),
      externals: Vec::new(),
      kind: MirSliceKind::Dominators,
      info: completeness_info_complete(slice_model_dominators(),
        mir_graph_visited_blocks(mir, fn_key), rows.len())
    })
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  end
end

# PostDominators: the reverse-CFG/virtual-exit row set (an empty right side
# marks the virtual exit — see mir_postdominators).
def slice_mir_graph_postdominators(mir: MirProgram, fn_key: String) -> Result[MirSlice, MirSliceError]
  match mir_postdominator_query(mir, fn_key.clone())
  when Option::Some(pair) then
    Result::Ok(MirSlice {
      function_key: fn_key,
      statements: pair.0.clone(),
      externals: Vec::new(),
      kind: MirSliceKind::PostDominators,
      info: pair.1.clone()
    })
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  end
end

# Loops: the natural-loop forest rows "header|parent|block,block,...".
def slice_mir_graph_loops(mir: MirProgram, fn_key: String) -> Result[MirSlice, MirSliceError]
  match mir_loop_rows(mir.clone(), fn_key.clone())
  when Option::Some(rows) then
    Result::Ok(MirSlice {
      function_key: fn_key.clone(),
      statements: rows.clone(),
      externals: Vec::new(),
      kind: MirSliceKind::Loops,
      info: completeness_info_complete(slice_model_loops(),
        mir_graph_visited_blocks(mir, fn_key), rows.len())
    })
  when Option::None then
    Result::Err(MirSliceError::FunctionNotFound)
  end
end

# ReachingDefs: a node anchor — "local|def1,def2" rows for the use node's
# read operands (see mir_reaching_defs).
def slice_mir_graph_reaching(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  let present = mir_function_present(mir.clone(), fn_key.clone())
  match mir_reaching_def_query(mir, fn_key.clone(), anchor)
  when Option::Some(pair) then
    Result::Ok(MirSlice {
      function_key: fn_key,
      statements: pair.0.clone(),
      externals: Vec::new(),
      kind: MirSliceKind::ReachingDefs,
      info: pair.1.clone()
    })
  when Option::None then
    if present then
      Result::Err(MirSliceError::AnchorNotFound)
    else
      Result::Err(MirSliceError::FunctionNotFound)
    end
  end
end

# Path: a drop/effect site anchor — mir_paths' typed slice (the stable
# statement id texts of the contributing path).
def slice_mir_graph_path(mir: MirProgram, fn_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  mir_paths(mir, fn_key, anchor)
end

# The ONE typed slicing entry — routes the request per kind onto the
# engines above; see the section doc for the anchor grammar and the error
# mapping.
pub def mir_slice(program: Option[MirProgram], request: MirSliceRequest) -> Result[MirSlice, MirSliceError]
  match program
  when Option::None then
    Result::Err(MirSliceError::MirProgramUnavailable)
  when Option::Some(mir) then
    let routed = match request.kind
      when MirSliceKind::BackwardDataflow then slice_mir_backward(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::ForwardDataflow then slice_mir_forward(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::ControlDependence then slice_mir_control(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::Ownership then slice_mir_ownership(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::Effects then slice_mir_effects(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::Failure then slice_mir_failure(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::ReturnValue then slice_mir_return(mir.clone(), request.function_key.clone())
      when MirSliceKind::Dominators then slice_mir_graph_dominators(mir.clone(), request.function_key.clone())
      when MirSliceKind::PostDominators then slice_mir_graph_postdominators(mir.clone(), request.function_key.clone())
      when MirSliceKind::Loops then slice_mir_graph_loops(mir.clone(), request.function_key.clone())
      when MirSliceKind::ReachingDefs then slice_mir_graph_reaching(mir.clone(), request.function_key.clone(), request.anchor.clone())
      when MirSliceKind::Path then slice_mir_graph_path(mir.clone(), request.function_key.clone(), request.anchor.clone())
    end
    # THE ProofComplete GATE (audit item 9): a ProofComplete request never
    # receives an incomplete answer — the typed error names the
    # completeness class and the truncation/limitation reason.
    match request.require
    when SliceRequirement::ProofComplete then
      match routed
      when Result::Ok(slice) then
        if !slice_completeness_is_complete(slice.info.completeness.clone()) then
          return Result::Err(MirSliceError::IncompleteRequirement(
            slice.info.completeness.clone(),
            slice.info.truncation_reason.clone()
          ))
        end
        Result::Ok(slice)
      when Result::Err(e) then Result::Err(e)
      end
    when SliceRequirement::BestEffort then routed
    end
  end
end

# ———————————————————————————————————————————————————————————————
# STABLE SEMANTIC NODE IDENTITY (audit items 47 + 16) — the PROVENANCE-derived
# derivation over the statements BEHIND the §33 locators
# ———————————————————————————————————————————————————————————————
# The record vocabulary (SnapshotMirLocator / StableSemanticNodeId, the
# length-prefixed role-key grammar stable_mir_node_key_text and the piece
# constructor stable_semantic_node_id_of) lives in stable_ids.tg section 8.
# THIS section renders MIR nodes into the identity pieces — the only place
# a node's identity can be derived, because the canonical text needs the
# MIR shapes (operation kind word, destination, operands in render order)
# and the FUNCTION context the locators alone cannot carry.
#
# IDENTITY SCHEME (third-audit item 16 + the P0-7 provenance extension):
# a node's identity derives from its STAMPED provenance
# (MirStatement.provenance / MirTerminator.provenance):
#   FromHir(hir node, lowering role, sibling)  — the HIR-anchored path: the
#       persistent HIR node identity + lowering role + the node's ordinal
#       among the nodes lowered from that same (HIR node, role) pair.
#       Inserting an UNRELATED node (of any role, anywhere in the MIR)
#       re-keys nothing: none of the pieces is a block/statement ordinal.
#   Derived(parent, transform, sibling)        — the parent node's identity
#       + the transform word + the sibling ordinal.
#   CompilerGenerated(decl, purpose, key)      — the owning declaration's
#       identity + the semantic purpose + the deterministic generation key.
# A node without provenance falls back to the variant its stable origin id
# encodes (mir_node_origin_of_stable_id — exact for every stamped/
# synthesized node). The LAST-RESORT role + role_seq scheme (the operation
# word plus the ordinal among the function's SAME-role nodes in block
# order, with the operation/destination/operand pieces as collision cargo)
# survives ONLY for hand-built/test MIR whose nodes carry no origin at all;
# the tracked derivation (slice_node_derive_tracked /
# stable_node_id_of_tracked) answers the documented untracked marker
# (Option::None) for that input instead of fabricating an id.
#
# RENDER VOCABULARY (deterministic, ASCII; every entry is opaque to the
# length-prefixed grammar, so the delimiters below are readability only):
#   operation words  — statement nodes: "assign" / "storage-live" /
#                      "storage-dead" / "nop" / "contract-check" /
#                      "budget-consume" / "effect-record" /
#                      "effect-perform" / "effect-frame-enter" /
#                      "effect-frame-exit"; terminator nodes: "goto" /
#                      "return" / "unreachable" / "switch" / "call" /
#                      "assert" / "abort" / "deinit".
#   roles            — the operation word for source statements, except the
#                      generated families the stable_mir_role_* builders
#                      name: a contract check carries
#                      "contract-check:<kind>:<message render>", a
#                      bounds-check assert carries
#                      "bounds-check:<index>:<container>", a deinit
#                      carries "drop:<place key render>". Lowering roles
#                      are "stmt" and "term".
#   destination      — the CANONICAL PLACE KEY TEXT of the node's write
#                      (slice_render_place's §7 grammar over the MIR type
#                      table: local name / "l<id>" root + projection
#                      segments) for MirAssign and MirCall; "" for every
#                      node with no destination.
#   operands         — the node's semantic payload texts IN RENDER ORDER
#                      (a binop's lhs precedes its rhs — never sorted):
#                      place texts, operand texts ("copy:"/"move:"/
#                      "read:"/"consume:"/"const:" prefixes + payload),
#                      call args ("place:<access-word>:<place>" /
#                      "value:<access-word>:<operand>"; access words
#                      "read"/"modify"/"consume"/"init"), control targets
#                      ("b<id>", "arm:<value>:b<id>", "success:b<id>",
#                      "unwind:b<id>"), assert messages, constants
#                      (value words: "unit", "bool:true", "int:<n>",
#                      "float:<64-bit bit pattern>", "char:<code point>",
#                      "str:<bytes>", "fn:<emission name>", "zst",
#                      "static-ref:<module>#<index>",
#                      "static-addr:<module>#<index>",
#                      "constparam:<numeric>"), aggregate kinds, phi
#                      sources ("src:b<block>@<local key>"), contract
#                      pieces, budget/effect-frame payloads.
#
# DENSE COMPONENTS by documented policy (stable_ids.tg section 8): the
# "l<id>" ordinals of unnamed locals, MirBlockId.id targets, the type
# payload render of a nominal type the program table does not carry
# (type_to_mangled's CanonInternal "t<id>" fallback) and the
# def-numeric render of an unresolvable MirDeinit instance. Function keys
# are the MirFunction EMISSION names (the §33 slice domain's documented
# gap — the def digest key resolves only through the typed program's
# resolver tables, which MirProgram-only derivation cannot reach).

# The canonical binop word of the payload (op-kind vocabulary).
def slice_node_binop_word(op: MirBinOp) -> String
  match op
  when MirBinOp::Add then "add"
  when MirBinOp::Sub then "sub"
  when MirBinOp::Mul then "mul"
  when MirBinOp::Div then "div"
  when MirBinOp::Mod then "mod"
  when MirBinOp::BitAnd then "bitand"
  when MirBinOp::BitOr then "bitor"
  when MirBinOp::BitXor then "bitxor"
  when MirBinOp::Shl then "shl"
  when MirBinOp::Shr then "shr"
  when MirBinOp::Eq then "eq"
  when MirBinOp::Ne then "ne"
  when MirBinOp::Lt then "lt"
  when MirBinOp::Le then "le"
  when MirBinOp::Gt then "gt"
  when MirBinOp::Ge then "ge"
  end
end

# The canonical unop word of the payload.
def slice_node_unop_word(op: MirUnOp) -> String
  match op
  when MirUnOp::Neg then "neg"
  when MirUnOp::Not then "not"
  when MirUnOp::BitNot then "bitnot"
  end
end

# The canonical cast word of the payload.
def slice_node_cast_word(kind: CastKind) -> String
  match kind
  when CastKind::IntToInt then "i2i"
  when CastKind::IntToFloat then "i2f"
  when CastKind::FloatToInt then "f2i"
  when CastKind::FloatToFloat then "f2f"
  when CastKind::Pointer then "ptr"
  when CastKind::Transmute then "transmute"
  end
end

# The canonical access word of a call-arg effect.
def slice_node_access_word(effect: AccessEffect) -> String
  match effect
  when AccessEffect::Read then "read"
  when AccessEffect::Modify then "modify"
  when AccessEffect::Consume then "consume"
  when AccessEffect::Initialize then "init"
  end
end

# The registered name text of a MirTypeDef by its TypeId.id (the
# "t<id>" fallback of the slice place renderers when the program table
# does not carry the type).
def slice_node_type_name(mir: MirProgram, type_id: Int) -> String
  for td in mir.types do
    if td.id.id == type_id then
      let n = td.name.clone()
      if n.len() > 0 then
        return n
      end
      return "t" + type_id.to_string()
    end
  end
  "t" + type_id.to_string()
end

# The canonical node-content text of a Type payload: a nominal Adt renders
# by the MirProgram's REGISTERED type name when the program carries it
# ("n:<name>[<arg texts>]" — args recursively); every other form renders
# through the ONE canonical internal type encoding (types.tg
# type_to_mangled — the "m:<render>" prefix; the CanonInternal frame
# renders a nominal Adt the program table does not carry by its
# per-compilation TypeId ordinal — the documented §33 type-table boundary
# of the section doc).
def slice_node_type_text(mir: MirProgram, ty: Type) -> String
  var text = "m:" + type_to_mangled(&ty)
  match ty
  when Type::Adt(tid, args) then
    var named = "n:" + slice_node_type_name(&mir, tid.id)
    if args.len() > 0 then
      var parts: Vec[String] = Vec::new()
      for a in args do
        parts.push(slice_node_type_text(&mir, a))
      end
      named = named + "[" + parts.join(",") + "]"
    end
    text = named
  when _ then ()
  end
  text
end

# The canonical constant payload text of a MirConstantKind (the value
# words of the section doc; MirFloat renders its exact 64-bit bit pattern
# through the std to_bits view, MirChar its code point, MirString its raw
# bytes — every payload is length-prefixed by the content-key grammar).
def slice_node_constant_text(c: MirConstantKind) -> String
  match c
  when MirConstantKind::MirUnit then "unit"
  when MirConstantKind::MirBool(b) then
    if b then "bool:true" else "bool:false" end
  when MirConstantKind::MirInt(n) then "int:" + n.to_string()
  when MirConstantKind::MirConstParamValue(n) then "constparam:" + n.to_string()
  when MirConstantKind::MirTypeQuery(k, _) then "typequery:" + type_query_kind_name(k)
  when MirConstantKind::MirFloat(f) then "float:" + (f.to_bits() as Int).to_string()
  when MirConstantKind::MirChar(ch) then "char:" + (ch as Int).to_string()
  when MirConstantKind::MirString(s) then "str:" + s
  when MirConstantKind::MirFnItem(name) then "fn:" + name
  when MirConstantKind::MirZeroSized then "zst"
  when MirConstantKind::MirStaticRef(d) then
    "static-ref:" + d.module.id.to_string() + "#" + (d.index as Int).to_string()
  when MirConstantKind::MirStaticAddr(d2) then
    "static-addr:" + d2.module.id.to_string() + "#" + (d2.index as Int).to_string()
  end
end

# The canonical text of one MirOperand (the access word + payload; a
# place renders its §7 canonical place key text through slice_render_place,
# a constant renders its value word).
def slice_node_operand_text(mir: MirProgram, f: MirFunction, op: MirOperand) -> String
  match op.kind
  when MirOperandKind::MirCopy(p) then "copy:" + slice_render_place(&mir, &f, &p)
  when MirOperandKind::MirMovePlace(p) then "move:" + slice_render_place(&mir, &f, &p)
  when MirOperandKind::MirRead(p) then "read:" + slice_render_place(&mir, &f, &p)
  when MirOperandKind::MirConsume(p) then "consume:" + slice_render_place(&mir, &f, &p)
  when MirOperandKind::MirConstant(c) then "const:" + slice_node_constant_text(c.kind)
  end
end

# The canonical text of one call argument: the access word (the effect
# word — "init" marks a write) plus the place/operand text, order kept.
def slice_node_call_arg_text(mir: MirProgram, f: MirFunction, arg: MirCallArg) -> String
  let word = slice_node_access_word(arg.effect)
  match arg.value
  when MirCallValue::Place(p) then "place:" + word + ":" + slice_render_place(&mir, &f, &p)
  when MirCallValue::Value(op) then "value:" + word + ":" + slice_node_operand_text(&mir, &f, op)
  end
end

# The payload entries of one MirRvalue (the rvalue's shape entry first,
# then the operand entries IN RENDER ORDER).
def slice_rvalue_node_texts(mir: MirProgram, f: MirFunction, rv: MirRvalueKind) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match rv
  when MirRvalueKind::MirMove(op) then
    out.push("kind:move")
    out.push(slice_node_operand_text(&mir, &f, op))
  when MirRvalueKind::MirRef(place) then
    out.push("kind:ref")
    out.push("place:" + slice_render_place(&mir, &f, &place))
  when MirRvalueKind::MirAggregate(kind, ops) then
    match kind
    when AggregateKind::MirArray(elem_ty) then
      out.push("kind:aggregate-array:" + slice_node_type_text(&mir, elem_ty))
    when AggregateKind::Tuple then
      out.push("kind:aggregate-tuple")
    when AggregateKind::Struct(tid, field_names) then
      out.push("kind:aggregate-struct:" + slice_node_type_name(&mir, tid.id) + ":" + field_names.join("."))
    when AggregateKind::Closure(cid) then
      out.push("kind:aggregate-closure:" + cid.id.to_string())
    when AggregateKind::Generator(tid2) then
      out.push("kind:aggregate-generator:" + slice_node_type_name(&mir, tid2.id))
    end
    for op in ops do
      out.push(slice_node_operand_text(&mir, &f, op))
    end
  when MirRvalueKind::MirBinOp(bop, lhs, rhs) then
    out.push("kind:binop:" + slice_node_binop_word(bop))
    out.push(slice_node_operand_text(&mir, &f, lhs))
    out.push(slice_node_operand_text(&mir, &f, rhs))
  when MirRvalueKind::MirUnOp(uop, op) then
    out.push("kind:unop:" + slice_node_unop_word(uop))
    out.push(slice_node_operand_text(&mir, &f, op))
  when MirRvalueKind::MirDiscriminant(place) then
    out.push("kind:discriminant")
    out.push("place:" + slice_render_place(&mir, &f, &place))
  when MirRvalueKind::MirLen(place) then
    out.push("kind:len")
    out.push("place:" + slice_render_place(&mir, &f, &place))
  when MirRvalueKind::MirCast(ck, op, ty) then
    out.push("kind:cast:" + slice_node_cast_word(ck))
    out.push(slice_node_operand_text(&mir, &f, op))
    out.push("type:" + slice_node_type_text(&mir, ty))
  when MirRvalueKind::MirRepeat(op, count) then
    out.push("kind:repeat")
    out.push(slice_node_operand_text(&mir, &f, op))
    out.push(slice_node_operand_text(&mir, &f, count))
  when MirRvalueKind::MirPhi(entries) then
    out.push("kind:phi")
    for entry in entries do
      out.push("src:b" + entry.0.id.to_string() + "@" + slice_local_canonical_text(&f, entry.1.id))
    end
  end
  out
end

# The content pieces (operation word, destination key text, operand
# payload texts) of ONE statement node.
def slice_stmt_node_pieces(mir: MirProgram, f: MirFunction, st: MirStatement) -> (String, String, Vec[String])
  match st.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    ("assign", slice_render_place(&mir, &f, &place), slice_rvalue_node_texts(&mir, &f, rvalue.kind))
  when MirStatementKind::MirStorageLive(local) then
    ("storage-live", "", Vec::from(["local:" + slice_local_canonical_text(&f, local.id)]))
  when MirStatementKind::MirStorageDead(local) then
    ("storage-dead", "", Vec::from(["local:" + slice_local_canonical_text(&f, local.id)]))
  when MirStatementKind::MirNop then
    ("nop", "", Vec::new())
  when MirStatementKind::MirContractCheck(contract, operand) then
    var ops: Vec[String] = Vec::new()
    let kw = match contract.kind
      when MirContractKind::Pre then "pre"
      when MirContractKind::Post then "post"
      when MirContractKind::Invariant then "invariant"
    end
    ops.push("kind:" + kw)
    ops.push("cond:" + slice_node_operand_text(&mir, &f, contract.condition))
    ops.push("msg:" + contract.message.clone())
    ops.push("val:" + slice_node_operand_text(&mir, &f, operand))
    ("contract-check", "", ops)
  when MirStatementKind::MirBudgetConsume(resource, limit) then
    ("budget-consume", "", Vec::from(["resource:" + resource, "limit:" + limit.to_string()]))
  when MirStatementKind::MirEffectRecord(name, operand) then
    ("effect-record", "", Vec::from(["name:" + name, slice_node_operand_text(&mir, &f, operand)]))
  when MirStatementKind::MirEffectPerform(eid, op_index, name, payload_ptr, result_ptr) then
    var ops: Vec[String] = Vec::new()
    ops.push("effect:e" + eid.id.to_string())
    ops.push("op-index:" + op_index.to_string())
    ops.push("name:" + name)
    ops.push(slice_node_operand_text(&mir, &f, payload_ptr))
    ops.push(slice_node_operand_text(&mir, &f, result_ptr))
    ("effect-perform", "", ops)
  when MirStatementKind::MirEffectFrameEnter(eid, op_count, bitmap, dispatcher, env_ptr) then
    var ops: Vec[String] = Vec::new()
    ops.push("effect:e" + eid.id.to_string())
    ops.push("op-count:" + op_count.to_string())
    ops.push("mask:" + bitmap.to_string())
    ops.push("dispatcher:" + dispatcher)
    ops.push(slice_node_operand_text(&mir, &f, env_ptr))
    ("effect-frame-enter", "", ops)
  when MirStatementKind::MirEffectFrameExit then
    ("effect-frame-exit", "", Vec::new())
  end
end

# The canonical text of one MirDeinit's destruction instance: the
# program's emission-name tables resolve the def numeric (drop-glue
# instances and registered finalizers — mir.tg's drop_glue_fns /
# method_names_by_def joins); an instance the tables do not carry renders
# its def numeric "def<module>#<index>" (documented dense fallback). The
# instance's substitution types ride the text when any exist (distinct
# specializations never collapse onto one id).
def slice_node_deinit_text(mir: MirProgram, inst: InstanceId) -> String
  let defid = inst.def.def
  let num = (defid.module.id << 32) + (defid.index as Int)
  var text = ""
  match mir.drop_glue_fns.get(num)
  when Option::Some(nm) then text = nm.clone()
  when Option::None then
    match mir.method_names_by_def.get(num)
    when Option::Some(nm2) then text = nm2.clone()
    when Option::None then
      text = "def" + defid.module.id.to_string() + "#" + (defid.index as Int).to_string()
    end
  end
  if inst.args.len() > 0 then
    var parts: Vec[String] = Vec::new()
    for a in inst.args do
      parts.push(slice_node_type_text(&mir, generic_arg_type_view(a)))
    end
    text = text + "$[" + parts.join(",") + "]"
  end
  text
end

# The content pieces of ONE terminator node.
def slice_term_node_pieces(mir: MirProgram, f: MirFunction, term: MirTerminator) -> (String, String, Vec[String])
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    ("goto", "", Vec::from(["target:b" + target.id.to_string()]))
  when MirTerminatorKind::MirReturn then
    ("return", "", Vec::new())
  when MirTerminatorKind::MirUnreachable then
    ("unreachable", "", Vec::new())
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    var ops: Vec[String] = Vec::new()
    ops.push("scrut:" + slice_node_operand_text(&mir, &f, op))
    for arm in targets do
      ops.push("arm:" + arm.value.to_string() + ":b" + arm.target.id.to_string())
    end
    ops.push("default:b" + default_target.id.to_string())
    ("switch", "", ops)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic: _, tail: _ } then
    var ops: Vec[String] = Vec::new()
    ops.push("func:" + slice_node_operand_text(&mir, &f, func))
    for arg in args do
      ops.push("arg:" + slice_node_call_arg_text(&mir, &f, arg))
    end
    ops.push("success:b" + success.id.to_string())
    match unwind
    when Option::Some(u) then ops.push("unwind:b" + u.id.to_string())
    when Option::None then ()
    end
    ("call", slice_render_place(&mir, &f, &dest), ops)
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    var ops: Vec[String] = Vec::new()
    ops.push("cond:" + slice_node_operand_text(&mir, &f, cond))
    if expected then
      ops.push("expected:true")
    else
      ops.push("expected:false")
    end
    match msg
    when AssertMessage::BoundsCheck(index_op, len_op) then
      ops.push("msg:bounds-check")
      ops.push(slice_node_operand_text(&mir, &f, index_op))
      ops.push(slice_node_operand_text(&mir, &f, len_op))
    when AssertMessage::Overflow(bop) then
      ops.push("msg:overflow:" + slice_node_binop_word(bop))
    when AssertMessage::DivisionByZero then
      ops.push("msg:division-by-zero")
    when AssertMessage::RemainderByZero then
      ops.push("msg:remainder-by-zero")
    when AssertMessage::NullPointer then
      ops.push("msg:null-pointer")
    when AssertMessage::ContractViolation(text) then
      ops.push("msg:contract:" + text)
    end
    ops.push("target:b" + target.id.to_string())
    match unwind
    when Option::Some(u2) then ops.push("unwind:b" + u2.id.to_string())
    when Option::None then ()
    end
    ("assert", "", ops)
  when MirTerminatorKind::MirAbort then
    ("abort", "", Vec::new())
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    var ops: Vec[String] = Vec::new()
    ops.push("place:" + slice_render_place(&mir, &f, &place))
    ops.push("glue:" + slice_node_deinit_text(&mir, deinit_fn))
    ops.push("target:b" + target.id.to_string())
    match unwind
    when Option::Some(u3) then ops.push("unwind:b" + u3.id.to_string())
    when Option::None then ()
    end
    ("deinit", "", ops)
  end
end

# The stable ROLE of one statement node (third-audit item 16): the
# operation word for the source-shaped kinds; the stable_mir_role_* string
# for the compiler-generated contract-check family (the MIR carries the
# contract kind + message, the §31 contract row key is not reachable from
# a MirProgram alone).
def slice_stmt_node_role(mir: MirProgram, f: MirFunction, st: MirStatement) -> String
  match st.kind
  when MirStatementKind::MirContractCheck(contract, _) then
    stable_mir_role_contract_check(slice_contract_node_id_text(&contract))
  when MirStatementKind::MirAssign(_, _) then "assign"
  when MirStatementKind::MirStorageLive(_) then "storage-live"
  when MirStatementKind::MirStorageDead(_) then "storage-dead"
  when MirStatementKind::MirNop then "nop"
  when MirStatementKind::MirBudgetConsume(_, _) then "budget-consume"
  when MirStatementKind::MirEffectRecord(_, _) then "effect-record"
  when MirStatementKind::MirEffectPerform(_, _, _, _, _) then "effect-perform"
  when MirStatementKind::MirEffectFrameEnter(_, _, _, _, _) then "effect-frame-enter"
  when MirStatementKind::MirEffectFrameExit then "effect-frame-exit"
  end
end

# The canonical contract ID render of a MirContract (the MIR-local cargo
# of the contract-check role; the §31 row key needs the typed program).
def slice_contract_node_id_text(contract: MirContract) -> String
  let msg = contract.message.clone()
  let kw = match contract.kind
    when MirContractKind::Pre then "pre"
    when MirContractKind::Post then "post"
    when MirContractKind::Invariant then "invariant"
  end
  kw + ":" + msg
end

# The stable ROLE of one terminator node: the operation word except the
# generated families — a bounds-check assert carries
# "bounds-check:<index>:<container>" and a deinit carries "drop:<place>".
def slice_term_node_role(mir: MirProgram, f: MirFunction, term: MirTerminator) -> String
  match term.kind
  when MirTerminatorKind::MirGoto(_) then "goto"
  when MirTerminatorKind::MirReturn then "return"
  when MirTerminatorKind::MirUnreachable then "unreachable"
  when MirTerminatorKind::MirSwitchInt { op: _, targets: _, default_target: _ } then "switch"
  when MirTerminatorKind::MirCall { dest: _, func: _, args: _, success: _, unwind: _, intrinsic: _, tail: _ } then "call"
  when MirTerminatorKind::MirAssert { cond: _, expected: _, msg, target: _, unwind: _ } then
    match msg
    when AssertMessage::BoundsCheck(index_op, len_op) then
      stable_mir_role_bounds_check(
        slice_node_operand_text(&mir, &f, index_op),
        slice_node_operand_text(&mir, &f, len_op)
      )
    when _ then "assert"
    end
  when MirTerminatorKind::MirAbort then "abort"
  when MirTerminatorKind::MirDeinit { place, deinit_fn: _, target: _, unwind: _ } then
    stable_mir_role_drop(slice_render_place(&mir, &f, &place))
  end
end

# The ROLE ORDINAL of the target node: the count of same-role nodes before
# it in the function's block order. The walk is the section's documented
# derivation cost (the same shape as the old predecessor-chain walk), and
# it is what makes a DIFFERENT-role insertion leave every existing
# role_seq untouched.
def slice_node_role_seq(mir: MirProgram, f: MirFunction, target_block: Int, target_node: Int, target_role: String, target_lowering_role: String) -> Int
  var seq = 0
  var b = 0
  while b < f.blocks.len() do
    var s = 0
    while s < f.blocks[b].statements.len() do
      if b == target_block && s == target_node && target_lowering_role == "stmt" then
        return seq
      end
      let st = f.blocks[b].statements[s]
      if target_lowering_role == "stmt" && slice_stmt_node_role(&mir, &f, st) == target_role then
        seq = seq + 1
      end
      s = s + 1
    end
    if b == target_block && target_node == f.blocks[b].statements.len() && target_lowering_role == "term" then
      return seq
    end
    let term = f.blocks[b].terminator
    if target_lowering_role == "term" && slice_term_node_role(&mir, &f, &term) == target_role then
      seq = seq + 1
    end
    b = b + 1
  end
  seq
end

# The typed provenance of a node from its two origin faces: the stamped
# variant, else the one its stable origin id encodes (mir.tg's
# mir_node_origin_of_stable_id — the exact inverse of the
# lowering/synthesis constructors). Option::None only for an ORIGIN-LESS
# node (hand-built/test MIR with no persistent origin): the persistent
# derivation never fabricates an id for it.
def slice_node_provenance(prov: Option[MirNodeOrigin], origin: Option[StableMirNodeId]) -> Option[MirNodeOrigin]
  match prov
  when Option::Some(p) then Option::Some(p)
  when Option::None then
    match origin
    when Option::Some(node) then Option::Some(mir_node_origin_of_stable_id(node))
    when Option::None then Option::None
    end
  end
end

# The provenance-backed semantic node identity of one node — the primary
# derivation: stable_semantic_node_id_of_origin over the stamped variant
# (HIR-anchored for FromHir — insertion into an unrelated position never
# re-keys it — and the deterministic provenance role text for the
# synthesized families). The operation/destination/operand pieces stay the
# collision cargo.
def slice_node_derive_from_provenance(
  fn_key: String,
  prov: MirNodeOrigin,
  pieces: (String, String, Vec[String])
) -> StableSemanticNodeId
  stable_semantic_node_id_of_origin(fn_key, prov, pieces.0, pieces.1, pieces.2)
end

# The LAST-RESORT role + role_seq derivation for hand-built/test MIR (the
# pre-provenance scheme, kept ONLY for nodes with no provenance and no
# origin): operation/lowering role plus the ordinal among same-role nodes,
# with the operation/destination/operand pieces as cargo. The persistent
# consumers never take this path — they use the tracked derivation below.
def slice_node_derive_role_fallback(
  mir: MirProgram,
  ctx: SliceFnCtx,
  v: Int,
  p: Int,
  block_len: Int
) -> Option[StableSemanticNodeId]
  if p == block_len then
    let term = ctx.f.blocks[v].terminator
    let pieces = slice_term_node_pieces(&mir, &ctx.f, &term)
    let role = slice_term_node_role(&mir, &ctx.f, &term)
    let seq = slice_node_role_seq(&mir, &ctx.f, v, p, role.clone(), "term".to_string())
    Option::Some(stable_semantic_node_id_of(
      ctx.name.clone(),
      pieces.0,
      pieces.1,
      pieces.2,
      role,
      "term".to_string(),
      -1,
      seq
    ))
  else
    let st = ctx.f.blocks[v].statements[p]
    let pieces = slice_stmt_node_pieces(&mir, &ctx.f, st)
    let st2 = ctx.f.blocks[v].statements[p]
    let role = slice_stmt_node_role(&mir, &ctx.f, st2)
    let seq = slice_node_role_seq(&mir, &ctx.f, v, p, role.clone(), "stmt".to_string())
    Option::Some(stable_semantic_node_id_of(
      ctx.name.clone(),
      pieces.0,
      pieces.1,
      pieces.2,
      role,
      "stmt".to_string(),
      -1,
      seq
    ))
  end
end

# Derive the StableSemanticNodeId of the node at (block Vec index v, node
# index p — p == the block's statement count = the terminator). PRIMARY:
# the stamped provenance (FromHir / Derived / CompilerGenerated) — an
# unrelated insertion before the node never re-keys it because none of the
# variant pieces is a locator ordinal. FALLBACK: the role + role_seq
# scheme, ONLY for a node with no provenance and no origin (hand-built /
# test MIR). Option::None when p is out of the node range.
def slice_node_derive(mir: MirProgram, ctx: SliceFnCtx, v: Int, p: Int) -> Option[StableSemanticNodeId]
  let block_len = ctx.f.blocks[v].statements.len()
  if p < 0 || p > block_len then
    return Option::None
  end
  if p == block_len then
    let term = ctx.f.blocks[v].terminator
    match slice_node_provenance(term.provenance.clone(), term.origin.clone())
    when Option::Some(prov) then
      let pieces = slice_term_node_pieces(&mir, &ctx.f, &term)
      Option::Some(slice_node_derive_from_provenance(ctx.name.clone(), prov, pieces))
    when Option::None then
      slice_node_derive_role_fallback(&mir, &ctx, v, p, block_len)
    end
  else
    let st = ctx.f.blocks[v].statements[p]
    match slice_node_provenance(st.provenance.clone(), st.origin.clone())
    when Option::Some(prov) then
      let pieces = slice_stmt_node_pieces(&mir, &ctx.f, st)
      Option::Some(slice_node_derive_from_provenance(ctx.name.clone(), prov, pieces))
    when Option::None then
      slice_node_derive_role_fallback(&mir, &ctx, v, p, block_len)
    end
  end
end

# The TRACKED (persistent) derivation: the provenance-backed identity ONLY.
# Option::None for an origin-less node — the documented untracked marker
# (the persistent consumers report/skip it; they never fabricate a
# role + role_seq id for input that carries no persistent origin).
def slice_node_derive_tracked(mir: MirProgram, ctx: SliceFnCtx, v: Int, p: Int) -> Option[StableSemanticNodeId]
  let block_len = ctx.f.blocks[v].statements.len()
  if p < 0 || p > block_len then
    return Option::None
  end
  if p == block_len then
    let term = ctx.f.blocks[v].terminator
    match slice_node_provenance(term.provenance.clone(), term.origin.clone())
    when Option::Some(prov) then
      let pieces = slice_term_node_pieces(&mir, &ctx.f, &term)
      Option::Some(slice_node_derive_from_provenance(ctx.name.clone(), prov, pieces))
    when Option::None then Option::None
    end
  else
    let st = ctx.f.blocks[v].statements[p]
    match slice_node_provenance(st.provenance.clone(), st.origin.clone())
    when Option::Some(prov) then
      let pieces = slice_stmt_node_pieces(&mir, &ctx.f, st)
      Option::Some(slice_node_derive_from_provenance(ctx.name.clone(), prov, pieces))
    when Option::None then Option::None
    end
  end
end

# The audit-item-47/16 derivation: the revision-stable semantic node
# identity of the node BEHIND a dense §33 locator (SnapshotMirLocator —
# parseable from the "#B"/"#S"/"#T" key texts through
# snapshot_mir_locator_of_key). Option::None when the locator names no
# function of the program, no block of that function, or no node of that
# block (the locator's own function_key is authoritative — mirror of the
# slice engines' prefix rule). Derivation semantics: the STAMPED provenance
# (FromHir / Derived / CompilerGenerated) is the identity — an unrelated
# insertion before the node never re-keys it; the role + role_seq scheme is
# the documented fallback for hand-built/test MIR with no origin at all.
pub def stable_node_id_of(mir: MirProgram, locator: SnapshotMirLocator) -> Option[StableSemanticNodeId]
  match slice_fn_find(mir, locator.function_key.clone())
  when Option::None then
    Option::None
  when Option::Some(ctx) then
    let v = slice_block_vec_index(&ctx, locator.block_ordinal)
    if v < 0 then
      return Option::None
    end
    let block_len = ctx.f.blocks[v].statements.len()
    var p = -1
    if locator.stmt_ordinal < 0 then
      # the "#T" terminator — its node index IS the block's statement count.
      p = block_len
    elsif locator.stmt_ordinal < block_len then
      p = locator.stmt_ordinal
    end
    if p < 0 then
      return Option::None
    end
    slice_node_derive(&mir, &ctx, v, p)
  end
end

# The TRACKED derivation of the node behind a §33 locator: identical to
# stable_node_id_of except that an ORIGIN-LESS node (no stamped provenance
# and no persistent origin id) answers Option::None — the documented
# untracked marker the persistent consumers propagate, never a fabricated
# role + role_seq id.
pub def stable_node_id_of_tracked(mir: MirProgram, locator: SnapshotMirLocator) -> Option[StableSemanticNodeId]
  match slice_fn_find(mir, locator.function_key.clone())
  when Option::None then
    Option::None
  when Option::Some(ctx) then
    let v = slice_block_vec_index(&ctx, locator.block_ordinal)
    if v < 0 then
      return Option::None
    end
    let block_len = ctx.f.blocks[v].statements.len()
    var p = -1
    if locator.stmt_ordinal < 0 then
      p = block_len
    elsif locator.stmt_ordinal < block_len then
      p = locator.stmt_ordinal
    end
    if p < 0 then
      return Option::None
    end
    slice_node_derive_tracked(&mir, &ctx, v, p)
  end
end

# The audit-item-47 slice-level derivation: the stable semantic node ids
# of the nodes BEHIND a slice row list (the sorted §33 node key texts a
# SliceResult/MirSlice carries). Each row must resolve inside
# function_key (a foreign-prefixed row is skipped); rows are deduped and
# the result sorted by the canonical content-key text — a deterministic
# row set for ANY input order. This is a PERSISTENT consumer: a resolved
# node with NO stamped provenance and NO persistent origin is SKIPPED (the
# documented untracked marker — the id is never fabricated from a
# locator). Option::None program: the derivation needs the MIR shapes
# behind the locators, so an absent MirProgram yields the EMPTY vector (a
# bare locator text carries no content — documented; the rows themselves
# stay meaningful as dense within-snapshot references).
pub def stable_node_ids_of_slice(
  function_key: String,
  slice_rows: Vec[String],
  program: Option[MirProgram]
) -> Vec[StableSemanticNodeId]
  match program
  when Option::None then
    Vec::new()
  when Option::Some(mir) then
    match slice_fn_find(mir, function_key.clone())
    when Option::None then
      Vec::new()
    when Option::Some(ctx) then
      var by_key: Map[String, StableSemanticNodeId] = Map::new()
      for row in slice_rows do
        match snapshot_mir_locator_of_key(row.clone())
        when Option::None then ()
        when Option::Some(loc) then
          if loc.function_key == ctx.name then
            let v = slice_block_vec_index(&ctx, loc.block_ordinal)
            if v >= 0 then
              let block_len = ctx.f.blocks[v].statements.len()
              var p = -1
              if loc.stmt_ordinal < 0 then
                p = block_len
              elsif loc.stmt_ordinal < block_len then
                p = loc.stmt_ordinal
              end
              if p >= 0 then
                match slice_node_derive_tracked(&mir, &ctx, v, p)
                when Option::Some(nid) then
                  let canon = stable_mir_node_key_text(
                    nid.function_key.clone(),
                    nid.operation.clone(),
                    nid.dest_key.clone(),
                    nid.operands.clone(),
                    nid.role.clone(),
                    nid.lowering_role.clone(),
                    nid.hir_node_seq,
                    nid.role_seq
                  )
                  if !by_key.contains_key(&canon) then
                    by_key.insert(canon, nid)
                  end
                when Option::None then ()
                end
              end
            end
          end
        end
      end
      var keys: Vec[String] = Vec::new()
      var entries: Vec[(String, StableSemanticNodeId)] = by_key.entries()
      for entry in entries do
        keys.push(entry.0.clone())
      end
      semantic_strings_sort(&mut keys)
      var out: Vec[StableSemanticNodeId] = Vec::new()
      for k in keys do
        match by_key.get(k.clone())
        when Option::Some(nid) then out.push(nid.clone())
        when Option::None then ()
        end
      end
      out
    end
  end
end

# ———————————————————————————————————————————————————————————————
# (P0-7 provenance extension) The provenance-derivation lane
# ———————————————————————————————————————————————————————————————
# The self-checking lane rows for the new derivation: a FromHir-stamped
# call terminator B keeps its StableSemanticNodeId when an unrelated
# origin-less call is inserted BEFORE its block (the role + role_seq scheme
# would re-key it — same lowering role); the origin-derived variant of a
# node whose stamped provenance was dropped (an optimizer/legacy rebuild)
# answers the same id; a Derived node's identity is a pure function of its
# parent; an ORIGIN-LESS node answers Option::None from the tracked
# derivation (the documented untracked marker) while the interactive
# fallback still resolves it positionally.

def slice_prov_lane_call_kind(dest_lid: Int, target: String, success: Int) -> MirTerminatorKind
  MirTerminatorKind::MirCall {
    dest: place_local(MirLocalId { id: dest_lid }),
    func: operand_constant(MirConstant {
      kind: MirConstantKind::MirFnItem(target),
      ty: Type::FnPtr(Vec::new(), Type::Unit, Vec::new()),
      instance: Option::None
    }),
    args: Vec::new(),
    success: MirBlockId { id: success },
    unwind: Option::None,
    intrinsic: Option::None,
    tail: false
  }
end

def slice_prov_lane_call_prov(name: String, hir_seq: Int) -> MirNodeOrigin
  let owner = stable_decl_of_key(&name)
  MirNodeOrigin::FromHir(
    stable_hir_node_id_of(owner, hir_seq),
    "call".to_string(),
    0
  )
end

def slice_prov_lane_call_block(id: Int, target: String, success: Int, name: String, hir_seq: Int) -> MirBlock
  let prov = slice_prov_lane_call_prov(name.clone(), hir_seq)
  let node = mir_node_origin_stable_id(name.clone(), prov.clone())
  mir_lane_block(id, Vec::new(), MirTerminator {
    kind: slice_prov_lane_call_kind(0, target, success),
    span: span_dummy(),
    origin: Option::Some(node.clone()),
    provenance: Option::Some(prov)
  })
end

def slice_prov_lane_function(insert_unrelated: Bool) -> MirProgram
  let name = "lane_slice_prov".to_string()
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Int))
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, Vec::new(), mir_lane_goto(1)))
  if insert_unrelated then
    # the unrelated origin-less call (a pass/runtime-inserted node) in a NEW
    # block before bb1; the entry goto is rerouted to it below.
    blocks.push(mir_lane_block(4, Vec::new(), MirTerminator {
      kind: slice_prov_lane_call_kind(0, "lane_unrelated".to_string(), 1),
      span: span_dummy()
    }))
  end
  blocks.push(slice_prov_lane_call_block(1, "lane_b".to_string(), 2, name.clone(), 202))
  blocks.push(slice_prov_lane_call_block(2, "lane_c".to_string(), 3, name.clone(), 303))
  blocks.push(mir_lane_block(3, Vec::new(), mir_lane_return()))
  var f = mir_lane_fn(name.clone(), locals, blocks)
  f.ret_type = Type::Int
  if insert_unrelated then
    f.blocks[0].terminator = MirTerminator {
      kind: MirTerminatorKind::MirGoto(MirBlockId { id: 4 }),
      span: span_dummy()
    }
  end
  mir_lane_program(f)
end

def slice_prov_lane_sid_text(name: String, sid: StableSemanticNodeId) -> String
  stable_mir_node_key_text(
    name,
    sid.operation.clone(),
    sid.dest_key.clone(),
    sid.operands.clone(),
    sid.role.clone(),
    sid.lowering_role.clone(),
    sid.hir_node_seq,
    sid.role_seq
  )
end

pub def mir_slice_provenance_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let name = "lane_slice_prov".to_string()
  let loc_b = SnapshotMirLocator { function_key: name.clone(), block_ordinal: 1, stmt_ordinal: -1 }
  let base_prog = slice_prov_lane_function(false)
  let ins_prog = slice_prov_lane_function(true)

  # ——— S1: B's FromHir identity is unchanged by the unrelated insertion ———
  match stable_node_id_of(base_prog.clone(), loc_b.clone())
  when Option::Some(base_id) then
    mir_graph_lane_row(&mut out, "S1-provenance-derives-from-hir",
      Vec::from([base_id.lowering_role.clone() + ":" + base_id.hir_node_seq.to_string()]),
      Vec::from(["call:202".to_string()]))
    match stable_node_id_of(ins_prog.clone(), loc_b.clone())
    when Option::Some(ins_id) then
      mir_graph_lane_row(&mut out, "S1-insertion-keeps-id",
        Vec::from([slice_prov_lane_sid_text(name.clone(), ins_id)]),
        Vec::from([slice_prov_lane_sid_text(name.clone(), base_id)]))
    when Option::None then
      out.push("S1-insertion-keeps-id: the inserted program lost B")
    end
  when Option::None then
    out.push("S1-provenance-derives-from-hir: the base program lost B")
  end

  # ——— S2: the origin-derived variant (provenance dropped) is identical ———
  var stripped = base_prog.functions[0].clone()
  var sb: Vec[MirBlock] = Vec::new()
  for blk in stripped.blocks do
    var nb = blk.clone()
    nb.terminator.provenance = Option::None
    sb.push(nb)
  end
  stripped.blocks = sb
  let stripped_prog = mir_lane_program(stripped)
  match stable_node_id_of(stripped_prog, loc_b.clone())
  when Option::Some(sid2) then
    match stable_node_id_of(base_prog.clone(), loc_b.clone())
    when Option::Some(sid1) then
      mir_graph_lane_row(&mut out, "S2-origin-recovery-identical",
        Vec::from([slice_prov_lane_sid_text(name.clone(), sid2)]),
        Vec::from([slice_prov_lane_sid_text(name.clone(), sid1)]))
    when Option::None then out.push("S2-origin-recovery-identical: base lost B")
    end
  when Option::None then
    out.push("S2-origin-recovery-identical: the stripped program lost B")
  end

  # ——— S3: a Derived node's identity is a pure function of its parent ———
  let parent = mir_node_origin_stable_id(name.clone(), slice_prov_lane_call_prov(name.clone(), 202))
  let derived = MirNodeOrigin::Derived(parent, "sroa-promote".to_string(), 3)
  let derived_a = stable_semantic_node_id_of_origin(name.clone(), derived.clone(), "assign".to_string(), "".to_string(), Vec::new())
  let derived_b = stable_semantic_node_id_of_origin(name.clone(), derived, "assign".to_string(), "".to_string(), Vec::new())
  mir_graph_lane_row(&mut out, "S3-derived-deterministic",
    Vec::from([slice_prov_lane_sid_text(name.clone(), derived_b)]),
    Vec::from([slice_prov_lane_sid_text(name.clone(), derived_a)]))

  # ——— S4: origin-less input answers the untracked marker ———
  let originless = mir_lane_reach()
  let oloc = SnapshotMirLocator { function_key: "lane_reach".to_string(), block_ordinal: 0, stmt_ordinal: 0 }
  match stable_node_id_of_tracked(originless.clone(), oloc.clone())
  when Option::Some(_) then
    out.push("S4-untracked-marker: tracked derivation fabricated an id for origin-less MIR")
  when Option::None then ()
  end
  match stable_node_id_of(originless, oloc)
  when Option::Some(_) then ()
  when Option::None then
    out.push("S4-role-fallback: hand-built fallback lost the node")
  end

  out
end


# ———————————————————————————————————————————————————————————————
# MIR GRAPH REASONING (third-audit item 20/22) — dominators,
# postdominators, the loop forest, control dependence, reaching
# definitions and the drop/effect paths
# ———————————————————————————————————————————————————————————————
# The dependence layer over the VERIFIED MirProgram: the CFG reasoning the
# audit's item 20/22 asks for, keyed by the NEW stable ids of the identity
# work (item 16/47):
#
#   BLOCKS      — the §1 StableMirBlockId.stable_key text
#                 "<fn emission key>#B<block id>" (slice_graph_block_key;
#                 the SAME text snapshot_mir_locator_text prefixes).
#   STATEMENTS  — the STAMPED-provenance StableMirStatementId of the node
#                 (the canonical role-key text stable_mir_statement_role_key_text
#                 over the provenance's identity pieces — the HIR-anchored
#                 path for FromHir, the provenance role text for the
#                 synthesized families), NEVER the dense "#S<ordinal>"
#                 locator. Only the compact MirSlice-machinery rows (def
#                 chains, span keys) stay in the §33 locator domain; the
#                 graph outputs below translate to the stable statement ids
#                 at the boundary. Hand-built/test fixtures with no origin
#                 still take the documented role + role_seq fallback.
#
# THE ALGORITHMS (all over the function's terminator edges; determinism
# comes from block/edge order plus the final textual sorts):
#
#   MIR_DOMINATORS — the existing optimizer machinery: mir.tg's
#     compute_dominators (Cooper/Harvey/Kennedy over the entry's RPO,
#     self edges included) reused verbatim; idom[entry] = entry; blocks
#     unreachable from the entry carry no row (no dominator-tree position).
#   MIR_POSTDOMINATORS — the reverse CFG with a VIRTUAL EXIT (-1): the
#     structural exits are the return/abort/unreachable terminators; blocks
#     that cannot reach an exit have no postdominator position. The
#     postdominator sets are the standard downward fixpoint
#     postdom[b] = {b} ∪ ∩ postdom[succ(b)] (exits start {exit, -1}); the
#     immediate postdominator is the strict postdominator postdominated by
#     every other strict postdominator (the closest one); -1 = the virtual
#     exit. Bounded by 2*|blocks|+8 rounds (a conservative cap — documented).
#   MIR_LOOPS — natural loops over the RAW back edges: an edge tail -> header
#     with header dominating tail (mir_idom_dominates over the forward idom,
#     the mir.tg helper verbatim). The body is the header plus the reverse
#     flood from the tail over the raw predecessor map (nodes reaching the
#     tail without passing through the header). Back edges sharing a header
#     merge into ONE natural loop (per-header forest — documented). The
#     parent is the innermost other loop header strictly dominating this
#     header (max dominator depth); top-level loops carry "".
#   MIR_CONTROL_DEPENDENCE — the STANDARD Ferrante/Ottenstein/Warren graph:
#     for every terminator X and successor S with S NOT postdominating X,
#     every block on the postdominator path from S up to (excluding)
#     ipdom(X) is control dependent on X. Rows are (dependent block,
#     controller block) — the controller's TERMINATOR is the branch site.
#     The anchored MirSliceKind::ControlDependence walk consumes the CDG's
#     transitive closure (the old bounded predecessor approximation is
#     gone).
#   MIR_REACHING_DEFS — the MAY (union over all paths) reaching-definition
#     answers for a USE node's read operands, mirroring the lir.tg
#     def-before-use model over MIR statements: IN[b] = ∪ OUT[pred];
#     OUT applies the block's writes in order — a BARE dest write KILLS the
#     local's earlier defs, a PROJECTED (partial) dest write ACCUMULATES
#     (the module's def-use model: a partial def does not end the chain).
#     A use resolves the nearest bare def BELOW it in-block (plus the
#     partial defs between it and the use); with no in-block bare def the
#     block's IN carries the predecessor defs. Parameters/never-defined
#     locals answer the row with an empty def list. The worklist is bounded
#     by slice_max_items() (documented).
#   MIR_DROP_PATHS / MIR_EFFECT_PATHS — the PATH slice of a site node: the
#     site + its block's statement prefix (the local path) + the anchored
#     backward def chains of the values the site reads (the contributing
#     dataflow path — the SliceBack machinery reused). A DROP site is a
#     MirDeinit terminator; an EFFECT site is a §11-classified call/deinit
#     terminator, a MirEffectPerform / MirEffectRecord statement or the
#     string-concat Add assignment (slice_effect's direct-site vocabulary).
#     The control predication of a path stays the ControlDependence kind's
#     business (documented separation); statements are emitted as the
#     item-16 stable statement id texts.
#
# ROW GRAMMAR (the query layer's keys; every row is one sorted text):
#   dominators/postdominators  "<block key>|<idom/ipdom block key>"
#                              ("" right side = the virtual exit)
#   loops                      "<header key>|<parent header key>|<block key>,..."
#   control dependence         "<dependent block key>|<controller block key>"
#   reaching defs              "<operand local key>|<def id>,<def id>,..."
#   paths                      the stable statement id texts in statements
#
# BOUNDS: every walk uses the module's deterministic budgets (slice_max_items
# work items, 4096-hop dominance walks). The row sets are sorted before
# leaving the module. RESIDUAL (documented): the reaching-def fixpoint rides
# the module's ctx.preds/ctx.succs maps, which drop SELF edges — a def later
# in a block reaching a use earlier in the SAME block through a self-loop
# edge is not propagated by the fixpoint (the in-block scan still resolves
# every lexically-earlier def); the loop forest itself uses the RAW edge maps
# (self edges included), so single-block self-loops ARE natural loops there.

# ———— Shared graph atoms ————

# The §1 StableMirBlockId.stable_key text "<fn key>#B<block id>".
def slice_graph_block_key(name: String, block_id: Int) -> String
  name + "#B" + block_id.to_string()
end

# One node slot inside the reaching-def dataflow ("<block vec idx>@<node
# idx>"; the node index equals the block's statement count at the
# terminator).
def slice_graph_slot_text(v: Int, p: Int) -> String
  v.to_string() + "@" + p.to_string()
end

def slice_graph_slot_parts(slot: String) -> (Int, Int)
  var at = -1
  var i = 0
  while i < slot.len() do
    if slot.slice(i, i + 1) == "@" then
      at = i
      break
    end
    i = i + 1
  end
  if at < 0 then
    return (-1, -1)
  end
  let left = slot.slice(0, at)
  let right = slot.slice(at + 1, slot.len())
  var v = -1
  var p = -1
  if slice_is_digits(&left) then v = slice_text_to_int(&left) end
  if slice_is_digits(&right) then p = slice_text_to_int(&right) end
  (v, p)
end

# The revision-stable StableMirStatementId text of the node at (block Vec
# index v, node index p — p == the block's statement count = the
# terminator): the canonical role-key text over the STAMPED provenance
# (FromHir renders the HIR-anchored path, the synthesized families the
# provenance role path). A node with no provenance and no origin falls back
# to the role + role_seq scheme (hand-built/test MIR only).
def slice_graph_node_stmt_text(mir: MirProgram, ctx: SliceFnCtx, v: Int, p: Int) -> String
  let block_len = ctx.f.blocks[v].statements.len()
  if p < 0 || p > block_len then
    return "".to_string()
  end
  var prov: Option[MirNodeOrigin] = Option::None
  if p == block_len then
    let term = ctx.f.blocks[v].terminator
    prov = slice_node_provenance(term.provenance.clone(), term.origin.clone())
  else
    let st = ctx.f.blocks[v].statements[p]
    prov = slice_node_provenance(st.provenance.clone(), st.origin.clone())
  end
  match prov
  when Option::Some(pv) then
    let sid = stable_mir_statement_id_of_origin(ctx.name.clone(), pv)
    stable_mir_statement_role_key_text(instance_key_to_text(sid.function.clone()), sid.role.clone(), sid.role_seq, sid.hir_node_seq)
  when Option::None then
    match slice_node_derive(&mir, &ctx, v, p)
    when Option::Some(nid) then
      let sid = stable_mir_statement_id_of_role(ctx.name.clone(), nid.role.clone(), nid.role_seq)
      stable_mir_statement_role_key_text(instance_key_to_text(sid.function.clone()), sid.role.clone(), sid.role_seq, sid.hir_node_seq)
    when Option::None then ""
    end
  end
end

# The StableMirBlockId record of one block of a function (the §1 stable
# block identity; Option::None for an absent function/block key).
pub def mir_block_stable_id(function_key: String, block_id: Int) -> Option[StableMirBlockId]
  stable_mir_block_of_key(slice_graph_block_key(&function_key, block_id))
end

# The revision-stable StableMirStatementId record of the node BEHIND a §33
# node-key locator (the STAMPED provenance over the derivation in this
# module; Option::None for a function/block/node the locator cannot
# resolve, and for an ORIGIN-LESS node — the documented untracked marker:
# a persistent consumer never fabricates a role + role_seq id).
pub def mir_node_statement_id(mir: MirProgram, function_key: String, node_key: String) -> Option[StableMirStatementId]
  match slice_fn_find(mir, function_key.clone())
  when Option::None then Option::None
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &node_key)
    when Option::None then Option::None
    when Option::Some(parts) then
      let block_len = ctx.f.blocks[parts.0].statements.len()
      var prov: Option[MirNodeOrigin] = Option::None
      if parts.1 == block_len then
        let term = ctx.f.blocks[parts.0].terminator
        prov = slice_node_provenance(term.provenance.clone(), term.origin.clone())
      elsif parts.1 >= 0 && parts.1 < block_len then
        let st = ctx.f.blocks[parts.0].statements[parts.1]
        prov = slice_node_provenance(st.provenance.clone(), st.origin.clone())
      end
      match prov
      when Option::Some(pv) then
        Option::Some(stable_mir_statement_id_of_origin(ctx.name.clone(), pv))
      when Option::None then
        match slice_node_derive_tracked(&mir, &ctx, parts.0, parts.1)
        when Option::Some(nid) then
          Option::Some(stable_mir_statement_id_of_role(ctx.name.clone(), nid.role.clone(), nid.role_seq))
        when Option::None then Option::None
        end
      end
    end
  end
end

# The RAW CFG of a function ctx: successor/predecessor maps over block Vec
# indices, from terminator_successor_ids (mir.tg — the optimizer's own edge
# vocabulary). SELF EDGES ARE KEPT (a self-loop is a natural-loop back edge)
# and duplicate targets deduped per block in target order.
struct SliceRawCfg
  succs: Map[Int, Vec[Int]]
  preds: Map[Int, Vec[Int]]
end

def slice_graph_raw_cfg(ctx: SliceFnCtx) -> SliceRawCfg
  var succs: Map[Int, Vec[Int]] = Map::new()
  var preds: Map[Int, Vec[Int]] = Map::new()
  var bi = 0
  while bi < ctx.f.blocks.len() do
    succs.insert(bi, Vec::new())
    preds.insert(bi, Vec::new())
    bi = bi + 1
  end
  bi = 0
  while bi < ctx.f.blocks.len() do
    let targets = terminator_successor_ids(&ctx.f.blocks[bi].terminator)
    var rows: Vec[Int] = Vec::new()
    for id in targets do
      let v = slice_block_vec_index(&ctx, id)
      if v >= 0 && !rows.contains(&v) then
        rows.push(v)
      end
    end
    succs.insert(bi, rows.clone())
    for v2 in rows do
      var prows: Vec[Int] = Vec::new()
      match preds.get(v2)
      when Option::Some(existing) then prows = existing.clone()
      when Option::None then ()
      end
      if !prows.contains(&bi) then
        prows.push(bi)
      end
      preds.insert(v2, prows)
    end
    bi = bi + 1
  end
  SliceRawCfg { succs: succs, preds: preds }
end

# ———— Dominators ————

# The forward idom map (block id -> idom block id) through mir.tg's
# compute_dominators — the existing optimizer machinery reused verbatim.
# Only blocks reachable from the entry carry an idom.
def slice_graph_fwd_idom(ctx: SliceFnCtx) -> Map[Int, Int]
  let dom = compute_dominators(ctx.f.clone())
  dom.idom
end

# The dominator-tree depth of one block (hops to the entry/root).
def slice_graph_dom_depth(idom: Map[Int, Int], v: Int) -> Int
  var depth = 0
  var cur = v
  var hops = 0
  while hops < 4096 do
    match idom.get(cur)
    when Option::Some(d) then
      if d == cur then
        return depth
      end
      cur = d
      depth = depth + 1
    when Option::None then
      return depth
    end
    hops = hops + 1
  end
  depth
end

# The whole-function immediate-dominator rows as (block key, idom key)
# pairs; idom[entry] = entry; unreachable blocks are omitted (no row).
pub def mir_dominators(mir: MirProgram, function_key: String) -> Vec[(String, String)]
  match slice_fn_find(mir, function_key.clone())
  when Option::None then Vec::new()
  when Option::Some(ctx) then
    let idom = slice_graph_fwd_idom(ctx.clone())
    var rows: Vec[(String, String)] = Vec::new()
    var bi = 0
    while bi < ctx.f.blocks.len() do
      match idom.get(ctx.f.blocks[bi].id.id)
      when Option::Some(d) then
        rows.push((
          slice_graph_block_key(&ctx.name, ctx.f.blocks[bi].id.id),
          slice_graph_block_key(&ctx.name, d)
        ))
      when Option::None then ()
      end
      bi = bi + 1
    end
    var insert_i = 1
    while insert_i < rows.len() do
      let insert_current = rows[insert_i].clone()
      var insert_j = insert_i
      while insert_j > 0 && (insert_current.0 < rows[insert_j - 1].0 ||
        (insert_current.0 == rows[insert_j - 1].0 && insert_current.1 < rows[insert_j - 1].1)) do
        rows[insert_j] = rows[insert_j - 1].clone()
        insert_j = insert_j - 1
      end
      rows[insert_j] = insert_current
      insert_i = insert_i + 1
    end
    rows
  end
end

# ———— Postdominators (reverse CFG + virtual exit) ————

# The structural EXIT blocks: the terminators that end the flow (return /
# abort / unreachable). Verified MIR has no dangling edges, so the exit set
# is exactly these terminators.
def slice_graph_exit_blocks(ctx: SliceFnCtx) -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  var bi = 0
  while bi < ctx.f.blocks.len() do
    var is_exit = false
    match ctx.f.blocks[bi].terminator.kind
    when MirTerminatorKind::MirReturn then is_exit = true
    when MirTerminatorKind::MirAbort then is_exit = true
    when MirTerminatorKind::MirUnreachable then is_exit = true
    when _ then ()
    end
    if is_exit then
      out.push(bi)
    end
    bi = bi + 1
  end
  out
end

# The blocks that can reach an exit (the postdominator domain): reverse BFS
# from the exits over the raw predecessor map. A non-terminating region has
# no postdominator position (documented).
def slice_graph_can_reach_exit(raw_preds: Map[Int, Vec[Int]], exits: Vec[Int]) -> Set[Int]
  var seen: Set[Int] = Set::new()
  var work: Vec[Int] = Vec::new()
  for e in exits do
    if !seen.contains(&e) then
      seen.insert(e)
      work.push(e)
    end
  end
  while work.len() > 0 do
    let b = work[0]
    work.remove(0)
    var rows: Vec[Int] = Vec::new()
    match raw_preds.get(b)
    when Option::Some(p) then rows = p.clone()
    when Option::None then ()
    end
    for p2 in rows do
      if !seen.contains(&p2) then
        seen.insert(p2)
        work.push(p2)
      end
    end
  end
  seen
end

def slice_graph_set_text(s: Set[Int]) -> String
  var xs: Vec[Int] = Vec::new()
  for x in s do
    xs.push(x)
  end
  semantic_ints_sort(&mut xs)
  var parts: Vec[String] = Vec::new()
  for x2 in xs do
    parts.push(x2.to_string())
  end
  parts.join(",")
end

def slice_graph_set_intersect(a: Set[Int], b: Set[Int]) -> Set[Int]
  var out: Set[Int] = Set::new()
  for x in a do
    if b.contains(&x) then
      out.insert(x)
    end
  end
  out
end

# The postdominator fixpoint's status (audit item 9): the ipdom map PLUS
# whether the round cap held (converged) and the positioned/domain counts
# the completeness records report.
struct SliceIpdomStatus
  # block Vec index -> immediate postdominator (-1 = the virtual exit).
  ipdom: Map[Int, Int] = Map::new()
  # whether the set fixpoint reached a fixed point within the round cap.
  converged: Bool = true
  # the blocks that can reach a structural exit (the postdominator domain).
  domain_size: Int = 0
  # the domain blocks that received an ipdom position.
  positioned: Int = 0
end

# The postdominator map (block Vec index -> immediate postdominator; -1 =
# the VIRTUAL EXIT) over the standard set fixpoint. Only blocks that can
# reach an exit are positioned. See the section doc for the algorithm and
# the round cap. The status form exposes the convergence/domain counts the
# completeness records need; slice_graph_ipdom is the map-only view.
def slice_graph_ipdom_status(ctx: SliceFnCtx) -> SliceIpdomStatus
  let raw = slice_graph_raw_cfg(ctx.clone())
  let exits = slice_graph_exit_blocks(ctx.clone())
  let domain = slice_graph_can_reach_exit(raw.preds.clone(), exits.clone())
  var universe: Set[Int] = Set::new()
  universe.insert(-1)
  for b0 in domain do
    universe.insert(b0)
  end
  var post: Map[Int, Set[Int]] = Map::new()
  var block_list: Vec[Int] = Vec::new()
  var bi = 0
  while bi < ctx.f.blocks.len() do
    if domain.contains(&bi) then
      block_list.push(bi)
      var is_exit = false
      for e in exits do
        if e == bi then
          is_exit = true
        end
      end
      if is_exit then
        var s: Set[Int] = Set::new()
        s.insert(bi)
        s.insert(-1)
        post.insert(bi, s)
      else
        post.insert(bi, universe.clone())
      end
    end
    bi = bi + 1
  end
  var changed = true
  var rounds = 0
  let round_cap = block_list.len() * 2 + 8
  while changed && rounds < round_cap do
    changed = false
    rounds = rounds + 1
    var li = 0
    while li < block_list.len() do
      let b = block_list[li]
      var is_exit = false
      for e2 in exits do
        if e2 == b then
          is_exit = true
        end
      end
      if !is_exit then
        var rows: Vec[Int] = Vec::new()
        match raw.succs.get(b)
        when Option::Some(s2) then rows = s2.clone()
        when Option::None then ()
        end
        var inter: Set[Int] = Set::new()
        var first = true
        for s3 in rows do
          if domain.contains(&s3) then
            match post.get(s3)
            when Option::Some(ps) then
              if first then
                inter = ps.clone()
                first = false
              else
                inter = slice_graph_set_intersect(inter, ps.clone())
              end
            when Option::None then ()
            end
          end
        end
        var new_set: Set[Int] = inter.clone()
        new_set.insert(b)
        var old_text = ""
        match post.get(b)
        when Option::Some(old) then old_text = slice_graph_set_text(old.clone())
        when Option::None then ()
        end
        if slice_graph_set_text(new_set.clone()) != old_text then
          post.insert(b, new_set)
          changed = true
        end
      end
      li = li + 1
    end
  end
  # the virtual root's postdominator set (the ipdom selection compares
  # against it, so the root is the furthest strict postdominator).
  var virt: Set[Int] = Set::new()
  virt.insert(-1)
  post.insert(-1, virt)
  # the immediate postdominator: the strict postdominator x that every
  # OTHER strict postdominator y postdominates (y ∈ postdom[x]).
  var ipdom: Map[Int, Int] = Map::new()
  for b2 in block_list do
    match post.get(b2)
    when Option::Some(s4) then
      var strict: Vec[Int] = Vec::new()
      for x in s4 do
        if x != b2 then
          strict.push(x)
        end
      end
      var best = -2
      for cand in strict do
        var cand_set: Set[Int] = Set::new()
        match post.get(cand)
        when Option::Some(sc) then cand_set = sc.clone()
        when Option::None then ()
        end
        var ok = true
        for y in strict do
          if y != cand then
            if !cand_set.contains(&y) then
              ok = false
            end
          end
        end
        if ok then
          best = cand
        end
      end
      if best != -2 then
        ipdom.insert(b2, best)
      end
    when Option::None then ()
    end
  end
  SliceIpdomStatus {
    ipdom: ipdom.clone(),
    converged: !changed,
    domain_size: block_list.len(),
    positioned: ipdom.entries().len()
  }
end

# The map-only view (the engines that do not need the status counts).
def slice_graph_ipdom(ctx: SliceFnCtx) -> Map[Int, Int]
  slice_graph_ipdom_status(ctx.clone()).ipdom.clone()
end

# The whole-function immediate-postdominator rows as (block key, ipdom key)
# pairs; an empty right side marks the virtual exit (ipdom == -1). Blocks
# that cannot reach an exit are omitted.
pub def mir_postdominators(mir: MirProgram, function_key: String) -> Vec[(String, String)]
  match slice_fn_find(mir, function_key.clone())
  when Option::None then Vec::new()
  when Option::Some(ctx) then
    let ipdom = slice_graph_ipdom(ctx.clone())
    var rows: Vec[(String, String)] = Vec::new()
    var bi = 0
    while bi < ctx.f.blocks.len() do
      match ipdom.get(bi)
      when Option::Some(d) then
        var ip_key = ""
        if d >= 0 then
          ip_key = slice_graph_block_key(&ctx.name, ctx.f.blocks[d].id.id)
        end
        rows.push((slice_graph_block_key(&ctx.name, ctx.f.blocks[bi].id.id), ip_key))
      when Option::None then ()
      end
      bi = bi + 1
    end
    var insert_i = 1
    while insert_i < rows.len() do
      let insert_current = rows[insert_i].clone()
      var insert_j = insert_i
      while insert_j > 0 && (insert_current.0 < rows[insert_j - 1].0 ||
        (insert_current.0 == rows[insert_j - 1].0 && insert_current.1 < rows[insert_j - 1].1)) do
        rows[insert_j] = rows[insert_j - 1].clone()
        insert_j = insert_j - 1
      end
      rows[insert_j] = insert_current
      insert_i = insert_i + 1
    end
    rows
  end
end

# ———— The natural-loop forest ————

# ONE natural loop of the forest: the header, its body blocks (header
# included) and the enclosing loop header ("" = top level). The keys are
# StableMirBlockId.stable_key texts; block_keys is sorted.
struct MirLoopInfo
  header_key: String
  block_keys: Vec[String] = Vec::new()
  parent_header_key: String = ""
end

# The natural-loop forest: back edges (tail -> header with header dominating
# tail) merged by header; the parent is the innermost other loop header
# strictly dominating this header. See the section doc.
pub def mir_loops(mir: MirProgram, function_key: String) -> Vec[MirLoopInfo]
  match slice_fn_find(mir, function_key.clone())
  when Option::None then Vec::new()
  when Option::Some(ctx) then
    let idom = slice_graph_fwd_idom(ctx.clone())
    let raw = slice_graph_raw_cfg(ctx.clone())
    var bodies: Map[Int, Set[Int]] = Map::new()
    var bi = 0
    while bi < ctx.f.blocks.len() do
      var rows: Vec[Int] = Vec::new()
      match raw.succs.get(bi)
      when Option::Some(s) then rows = s.clone()
      when Option::None then ()
      end
      for h in rows do
        # the forward idom map is keyed by MirBlockId.id (compute_dominators'
        # domain); raw.succs is keyed by block Vec index — translate.
        let h_id = ctx.f.blocks[h].id.id
        let bi_id = ctx.f.blocks[bi].id.id
        if idom.contains_key(&h_id) && idom.contains_key(&bi_id) && mir_idom_dominates(&idom, h_id, bi_id) then
          # back edge bi -> h (h dominates bi): the natural loop of h.
          var body: Set[Int] = Set::new()
          body.insert(h)
          var work: Vec[Int] = Vec::new()
          work.push(bi)
          while work.len() > 0 do
            let n = work[0]
            work.remove(0)
            if !body.contains(&n) then
              body.insert(n)
              var prows: Vec[Int] = Vec::new()
              match raw.preds.get(n)
              when Option::Some(p) then prows = p.clone()
              when Option::None then ()
              end
              for p2 in prows do
                if !body.contains(&p2) then
                  work.push(p2)
                end
              end
            end
          end
          # merge the back edges sharing a header (one natural loop per header).
          var merged: Set[Int] = Set::new()
          match bodies.get(h)
          when Option::Some(existing) then merged = existing.clone()
          when Option::None then ()
          end
          for b in body do
            merged.insert(b)
          end
          bodies.insert(h, merged)
        end
      end
      bi = bi + 1
    end
    var headers: Vec[Int] = Vec::new()
    var entries: Vec[(Int, Set[Int])] = bodies.entries()
    for e in entries do
      headers.push(e.0)
    end
    semantic_ints_sort(&mut headers)
    var out: Vec[MirLoopInfo] = Vec::new()
    var hi = 0
    while hi < headers.len() do
      let h = headers[hi]
      var parent = -1
      var parent_depth = 0
      var hj = 0
      while hj < headers.len() do
        let h2 = headers[hj]
        let h2_id = ctx.f.blocks[h2].id.id
        let h_id = ctx.f.blocks[h].id.id
        if h2 != h && mir_idom_dominates(&idom, h2_id, h_id) then
          let depth = slice_graph_dom_depth(&idom, h2_id)
          if parent < 0 || depth > parent_depth then
            parent = h2
            parent_depth = depth
          end
        end
        hj = hj + 1
      end
      var parent_key = ""
      if parent >= 0 then
        parent_key = slice_graph_block_key(&ctx.name, ctx.f.blocks[parent].id.id)
      end
      var block_keys: Vec[String] = Vec::new()
      match bodies.get(h)
      when Option::Some(set) then
        for b2 in set do
          block_keys.push(slice_graph_block_key(&ctx.name, ctx.f.blocks[b2].id.id))
        end
      when Option::None then ()
      end
      semantic_strings_sort(&mut block_keys)
      out.push(MirLoopInfo {
        header_key: slice_graph_block_key(&ctx.name, ctx.f.blocks[h].id.id),
        block_keys: block_keys,
        parent_header_key: parent_key
      })
      hi = hi + 1
    end
    var insert_i = 1
    while insert_i < out.len() do
      let insert_current = out[insert_i].clone()
      var insert_j = insert_i
      while insert_j > 0 && insert_current.header_key < out[insert_j - 1].header_key do
        out[insert_j] = out[insert_j - 1].clone()
        insert_j = insert_j - 1
      end
      out[insert_j] = insert_current
      insert_i = insert_i + 1
    end
    out
  end
end

# ———— Control dependence ————

# The control-dependence graph: dependent block Vec index -> controlling
# block Vec indices (the standard Ferrante/Ottenstein/Warren construction;
# see the section doc). The controller's TERMINATOR is the branch site.
# slice_graph_cdg derives the ipdom map through the status form and
# delegates; slice_graph_cdg_with consumes a caller-supplied map (the
# completeness-aware ControlDependence walk computes the status once).
def slice_graph_cdg(ctx: SliceFnCtx) -> Map[Int, Vec[Int]]
  let ipdom = slice_graph_ipdom_status(ctx.clone()).ipdom.clone()
  slice_graph_cdg_with(ctx.clone(), ipdom)
end

def slice_graph_cdg_with(ctx: SliceFnCtx, ipdom: Map[Int, Int]) -> Map[Int, Vec[Int]]
  var out: Map[Int, Vec[Int]] = Map::new()
  let raw = slice_graph_raw_cfg(ctx.clone())
  var bi = 0
  while bi < ctx.f.blocks.len() do
    if ipdom.contains_key(&bi) then
      var subrows: Vec[Int] = Vec::new()
      match raw.succs.get(bi)
      when Option::Some(s) then subrows = s.clone()
      when Option::None then ()
      end
      for s2 in subrows do
        if ipdom.contains_key(&s2) && !mir_idom_dominates(&ipdom, s2, bi) then
          var stop = -1
          match ipdom.get(bi)
          when Option::Some(d) then stop = d
          when Option::None then ()
          end
          var runner = s2
          var guard = 0
          while runner != stop && runner >= 0 && guard < 4096 do
            guard = guard + 1
            var existing: Vec[Int] = Vec::new()
            match out.get(runner)
            when Option::Some(e) then existing = e.clone()
            when Option::None then ()
            end
            if !existing.contains(&bi) then
              existing.push(bi)
              out.insert(runner, existing)
            end
            match ipdom.get(runner)
            when Option::Some(nxt) then runner = nxt
            when Option::None then runner = -1
            end
          end
        end
      end
    end
    bi = bi + 1
  end
  out
end

# The whole-function control-dependence rows: (dependent block key,
# controller block key) pairs — the controller's terminator is the deciding
# branch site.
pub def mir_control_dependence(mir: MirProgram, function_key: String) -> Vec[(String, String)]
  match slice_fn_find(mir, function_key.clone())
  when Option::None then Vec::new()
  when Option::Some(ctx) then
    let cdg = slice_graph_cdg(ctx.clone())
    var rows: Vec[(String, String)] = Vec::new()
    var entries: Vec[(Int, Vec[Int])] = cdg.entries()
    for e in entries do
      for c in e.1 do
        rows.push((
          slice_graph_block_key(&ctx.name, ctx.f.blocks[e.0].id.id),
          slice_graph_block_key(&ctx.name, ctx.f.blocks[c].id.id)
        ))
      end
    end
    var insert_i = 1
    while insert_i < rows.len() do
      let insert_current = rows[insert_i].clone()
      var insert_j = insert_i
      while insert_j > 0 && (insert_current.0 < rows[insert_j - 1].0 ||
        (insert_current.0 == rows[insert_j - 1].0 && insert_current.1 < rows[insert_j - 1].1)) do
        rows[insert_j] = rows[insert_j - 1].clone()
        insert_j = insert_j - 1
      end
      rows[insert_j] = insert_current
      insert_i = insert_i + 1
    end
    rows
  end
end

# ———— Reaching definitions (may / union over all paths) ————

def slice_reach_state_text(state: Map[Int, Set[String]]) -> String
  var rows: Vec[String] = Vec::new()
  var entries: Vec[(Int, Set[String])] = state.entries()
  for e in entries do
    var defs: Vec[String] = Vec::new()
    for d in e.1 do
      defs.push(d.clone())
    end
    semantic_strings_sort(&mut defs)
    rows.push(e.0.to_string() + ">" + defs.join(","))
  end
  semantic_strings_sort(&mut rows)
  rows.join(";")
end

# The OUT state of one block given its IN: deep-copy the IN and apply the
# block's writes in order — a bare dest write replaces the local's def set
# (KILL), a projected (partial) dest write accumulates (no kill).
def slice_reach_block_out(ctx: SliceFnCtx, b: Int, in_state: Map[Int, Set[String]]) -> Map[Int, Set[String]]
  var out: Map[Int, Set[String]] = Map::new()
  var entries: Vec[(Int, Set[String])] = in_state.entries()
  for e in entries do
    out.insert(e.0, e.1.clone())
  end
  let block_len = ctx.f.blocks[b].statements.len()
  var si = 0
  while si < block_len do
    let st = ctx.f.blocks[b].statements[si]
    let defs = slice_stmt_defs(st)
    if defs.0 >= 0 then
      var set: Set[String] = Set::new()
      set.insert(slice_graph_slot_text(b, si))
      out.insert(defs.0, set)
    end
    if defs.1 >= 0 then
      var set2: Set[String] = Set::new()
      match out.get(defs.1)
      when Option::Some(existing) then set2 = existing.clone()
      when Option::None then ()
      end
      set2.insert(slice_graph_slot_text(b, si))
      out.insert(defs.1, set2)
    end
    si = si + 1
  end
  let term = ctx.f.blocks[b].terminator
  let tdefs = slice_term_defs(&term)
  if tdefs.0 >= 0 then
    var tset: Set[String] = Set::new()
    tset.insert(slice_graph_slot_text(b, block_len))
    out.insert(tdefs.0, tset)
  end
  if tdefs.1 >= 0 then
    var tset2: Set[String] = Set::new()
    match out.get(tdefs.1)
    when Option::Some(existing2) then tset2 = existing2.clone()
    when Option::None then ()
    end
    tset2.insert(slice_graph_slot_text(b, block_len))
    out.insert(tdefs.1, tset2)
  end
  out
end

# The per-block IN/OUT facts of the may-reach fixpoint: FIFO worklist over
# the block Vec order, a changed block requeues its successors (bounded by
# slice_max_items() — documented).
struct SliceReachFacts
  in_map: Map[Int, Map[Int, Set[String]]]
  out_map: Map[Int, Map[Int, Set[String]]]
  # the item budget was exhausted with queue entries left (Truncated).
  truncated: Bool = false
  # the unprocessed queue length at exhaustion (the omitted lower bound).
  omitted: Int = 0
  # items popped (the visited count).
  items: Int = 0
end

def slice_reach_in_out(ctx: SliceFnCtx) -> SliceReachFacts
  var in_map: Map[Int, Map[Int, Set[String]]] = Map::new()
  var out_map: Map[Int, Map[Int, Set[String]]] = Map::new()
  var queue: Vec[Int] = Vec::new()
  var queued: Set[Int] = Set::new()
  var bi = 0
  while bi < ctx.f.blocks.len() do
    in_map.insert(bi, Map::new())
    out_map.insert(bi, Map::new())
    queue.push(bi)
    queued.insert(bi)
    bi = bi + 1
  end
  var items = 0
  while queue.len() > 0 && items < slice_max_items() do
    items = items + 1
    let b = queue[0]
    queue.remove(0)
    queued.remove(&b)
    var new_in: Map[Int, Set[String]] = Map::new()
    var pred_rows: Vec[Int] = Vec::new()
    match ctx.preds.get(b)
    when Option::Some(rows) then pred_rows = rows.clone()
    when Option::None then ()
    end
    for p in pred_rows do
      var pout: Map[Int, Set[String]] = Map::new()
      match out_map.get(p)
      when Option::Some(o) then pout = o.clone()
      when Option::None then ()
      end
      var entries: Vec[(Int, Set[String])] = pout.entries()
      for e in entries do
        var acc: Set[String] = Set::new()
        match new_in.get(e.0)
        when Option::Some(a) then acc = a.clone()
        when Option::None then ()
        end
        for d in e.1 do
          acc.insert(d.clone())
        end
        new_in.insert(e.0, acc)
      end
    end
    var old_text = ""
    match in_map.get(b)
    when Option::Some(old) then old_text = slice_reach_state_text(old.clone())
    when Option::None then ()
    end
    let new_text = slice_reach_state_text(new_in.clone())
    if new_text != old_text then
      in_map.insert(b, new_in.clone())
      let new_out = slice_reach_block_out(ctx.clone(), b, new_in)
      out_map.insert(b, new_out)
      var succ_rows: Vec[Int] = Vec::new()
      match ctx.succs.get(b)
      when Option::Some(s) then succ_rows = s.clone()
      when Option::None then ()
      end
      for s2 in succ_rows do
        if !queued.contains(&s2) then
          queued.insert(s2)
          queue.push(s2)
        end
      end
    end
  end
  SliceReachFacts {
    in_map: in_map,
    out_map: out_map,
    truncated: queue.len() > 0 && items >= slice_max_items(),
    omitted: queue.len(),
    items: items
  }
end

# The reaching definitions of a USE node's read operands: for every
# distinct read local, the in-block defs from the nearest bare def up to
# the use (partial defs included) or, when no bare def is below the use,
# the block's IN set — answered as (operand local key, sorted stable def
# ids). An unknown function or anchor yields the empty vector (the query
# layer's mir_reaching_def_rows distinguishes the two against the
# function table).
#
# COMPLETENESS (audit item 9): the in-block scan resolves every
# lexically-earlier def exactly. The may fixpoint rides ctx.preds (SELF
# EDGES DROPPED), so a def later in a block reaching a lexically-earlier
# use through the block's own self-loop edge is not propagated — the
# documented ConservativeSubset limitation, named under
# slice_model_reaching(). The item budget's exhaustion is Truncated.
pub def mir_reaching_defs(mir: MirProgram, function_key: String, stmt_key: String) -> Vec[(String, Vec[String])]
  mir_reaching_defs_with_info(mir, function_key, stmt_key).0
end

# The rows + the shared completeness record of ONE reaching-def query (the
# typed route's form; mir_reaching_defs above is the rows-only view).
pub def mir_reaching_defs_with_info(mir: MirProgram, function_key: String, stmt_key: String) -> (Vec[(String, Vec[String])], CompletenessInfo)
  let empty_info = completeness_info_complete(slice_model_reaching(), 0, 0)
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then (Vec::new(), empty_info.clone())
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &stmt_key)
    when Option::None then (Vec::new(), empty_info.clone())
    when Option::Some(parts) then
      let v = parts.0
      let p = parts.1
      let block_len = ctx.f.blocks[v].statements.len()
      var reads: Vec[Int] = Vec::new()
      if p >= block_len then
        reads = slice_term_reads(&ctx.f.blocks[v].terminator)
      else
        reads = slice_stmt_reads(ctx.f.blocks[v].statements[p])
      end
      var locals: Vec[Int] = Vec::new()
      for r in reads do
        if !locals.contains(&r) then
          locals.push(r)
        end
      end
      let facts = slice_reach_in_out(ctx.clone())
      var rows: Vec[(String, Vec[String])] = Vec::new()
      var li = 0
      while li < locals.len() do
        let l = locals[li]
        var slots: Vec[String] = Vec::new()
        var found_bare = false
        var si = p - 1
        if si > block_len - 1 then
          si = block_len - 1
        end
        while si >= 0 && !found_bare do
          let st = ctx.f.blocks[v].statements[si]
          let defs = slice_stmt_defs(st)
          if defs.0 == l then
            slots.push(slice_graph_slot_text(v, si))
            found_bare = true
          elsif defs.1 == l then
            slots.push(slice_graph_slot_text(v, si))
          end
          si = si - 1
        end
        if !found_bare then
          match facts.in_map.get(v)
          when Option::Some(vin) then
            match vin.get(l)
            when Option::Some(s) then
              for d in s do
                if !slots.contains(&d) then
                  slots.push(d.clone())
                end
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
        end
        var def_keys: Vec[String] = Vec::new()
        for slot in slots do
          let slot_parts = slice_graph_slot_parts(slot)
          if slot_parts.0 >= 0 && slot_parts.1 >= 0 then
            let key = slice_graph_node_stmt_text(&mir, &ctx, slot_parts.0, slot_parts.1)
            if key.len() > 0 && !def_keys.contains(&key) then
              def_keys.push(key)
            end
          end
        end
        semantic_strings_sort(&mut def_keys)
        rows.push((slice_local_canonical_text(&ctx.f, l), def_keys))
        li = li + 1
      end
      var insert_i = 1
      while insert_i < rows.len() do
        let insert_current = rows[insert_i].clone()
        var insert_j = insert_i
        while insert_j > 0 && (insert_current.0 < rows[insert_j - 1].0 ||
          (insert_current.0 == rows[insert_j - 1].0 && insert_current.1.join(",") < rows[insert_j - 1].1.join(","))) do
          rows[insert_j] = rows[insert_j - 1].clone()
          insert_j = insert_j - 1
        end
        rows[insert_j] = insert_current
        insert_i = insert_i + 1
      end
      # the completeness class: Truncated (cap) > ConservativeSubset
      # (self-loop residual) > Complete. The self-edge count is the
      # omission footprint the record reports.
      var info = completeness_info_complete(slice_model_reaching(), facts.items, rows.len())
      if facts.truncated then
        info = completeness_info_truncated(slice_model_reaching(),
          "cap: slice_max_items=" + slice_max_items().to_string() +
            " work items exhausted; " + facts.omitted.to_string() + " block queue entr(ies) remain unprocessed",
          facts.items, rows.len(), facts.omitted)
      elsif slice_fn_self_edge_count(ctx.clone()) > 0 then
        info = completeness_info_subset(slice_model_reaching(),
          "the reaching-def self-loop residual: the may fixpoint rides ctx.preds, which drops self edges, so a def " +
            "later in a block reaching a lexically-earlier use through a self-loop edge is not propagated (" +
            slice_fn_self_edge_count(ctx.clone()).to_string() + " self edge(s) in the function)",
          facts.items, rows.len(), slice_fn_self_edge_count(ctx.clone()))
      end
      (rows, info)
    end
  end
end

# The typed query form (the typed route + the query-layer adapter): the
# canonical "local|def1,def2" rows + the shared completeness record;
# Option::None when the function or the node anchor does not resolve.
pub def mir_reaching_def_query(mir: MirProgram, function_key: String, stmt_key: String) -> Option[(Vec[String], CompletenessInfo)]
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then Option::None
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &stmt_key)
    when Option::None then Option::None
    when Option::Some(_) then
      let pair = mir_reaching_defs_with_info(mir, function_key, stmt_key)
      let row_pairs = pair.0.clone()
      let info = pair.1.clone()
      var out: Vec[String] = Vec::new()
      for r in row_pairs do
        out.push(r.0.clone() + "|" + r.1.join(","))
      end
      Option::Some((out, info))
    end
  end
end

# ———— Drop / effect paths ————

# A DROP site: the node is the block's terminator (p == the statement
# count) and the terminator is a MirDeinit.
def slice_path_site_is_drop(ctx: SliceFnCtx, v: Int, p: Int) -> Bool
  let block_len = ctx.f.blocks[v].statements.len()
  if p != block_len then
    return false
  end
  match ctx.f.blocks[v].terminator.kind
  when MirTerminatorKind::MirDeinit { place: _, deinit_fn: _, target: _, unwind: _ } then true
  when _ then false
  end
end

# An EFFECT site: a §11-classified call/deinit terminator, a
# MirEffectPerform / MirEffectRecord statement or the string-concat
# MirBinOp::Add assignment (slice_effect's direct-site vocabulary).
def slice_path_site_is_effect(mir: MirProgram, ctx: SliceFnCtx, v: Int, p: Int) -> Bool
  let block_len = ctx.f.blocks[v].statements.len()
  if p >= block_len then
    let term = ctx.f.blocks[v].terminator
    let type_index = slice_type_index(&mir)
    let fn_index = slice_fn_index(&mir)
    let ev = slice_term_effect_evidence(&mir, &ctx.f, &term, &type_index, &fn_index)
    for e in ev do
      if e.len() > 0 then
        return true
      end
    end
    return false
  end
  let st = ctx.f.blocks[v].statements[p]
  let ev2 = slice_stmt_effect_evidence(&ctx.f, st)
  for e2 in ev2 do
    if e2.len() > 0 then
      return true
    end
  end
  false
end

# The path slice of a site node: the site + its block's statement prefix
# (the local path) + the anchored backward def chains of the values the
# site reads (the contributing dataflow path). Statements are emitted as
# the item-16 stable statement id texts; the SliceBack externals ride
# along (sorted).
def slice_path_mir(mir: MirProgram, ctx: SliceFnCtx, v: Int, p: Int) -> MirSlice
  var back = slice_back_new(ctx.clone())
  let block_len = ctx.f.blocks[v].statements.len()
  var reads: Vec[Int] = Vec::new()
  var span = Span { file: "", start: 0, end_pos: 0 }
  if p >= block_len then
    let term = ctx.f.blocks[v].terminator
    reads = slice_term_reads(&term)
    span = slice_span_copy(term.span)
  else
    let st = ctx.f.blocks[v].statements[p]
    reads = slice_stmt_reads(st)
    span = slice_span_copy(st.span)
  end
  slice_back_include(&mut back, v, p, span)
  var ti = 0
  while ti < p && ti < block_len do
    let st2 = ctx.f.blocks[v].statements[ti]
    let tspan = slice_span_copy(st2.span)
    slice_back_include(&mut back, v, ti, tspan)
    ti = ti + 1
  end
  for r in reads do
    slice_backward_at(&mut back, v, p, r)
  end
  let res = slice_result_build(&back.ctx, &back.included, &back.external,
    slice_back_info(back, slice_model_path()))
  var stable: Vec[String] = Vec::new()
  for row in res.statements do
    match snapshot_mir_locator_of_key(row.clone())
    when Option::Some(loc) then
      let rv = slice_block_vec_index(&ctx, loc.block_ordinal)
      if rv >= 0 then
        let rlen = ctx.f.blocks[rv].statements.len()
        var rp = -1
        if loc.stmt_ordinal < 0 then
          rp = rlen
        elsif loc.stmt_ordinal < rlen then
          rp = loc.stmt_ordinal
        end
        if rp >= 0 then
          let key = slice_graph_node_stmt_text(&mir, &ctx, rv, rp)
          if key.len() > 0 && !stable.contains(&key) then
            stable.push(key)
          end
        end
      end
    when Option::None then ()
    end
  end
  semantic_strings_sort(&mut stable)
  MirSlice {
    function_key: ctx.name.clone(),
    statements: stable,
    externals: res.external.clone(),
    kind: MirSliceKind::Path,
    info: res.info.clone()
  }
end

# The typed DROP-path slice of a MirDeinit site (AnchorNotFound when the
# node is not a deinit).
pub def mir_drop_paths(mir: MirProgram, function_key: String, site_key: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &site_key)
    when Option::None then Result::Err(MirSliceError::AnchorNotFound)
    when Option::Some(parts) then
      if slice_path_site_is_drop(ctx.clone(), parts.0, parts.1) then
        Result::Ok(slice_path_mir(mir, ctx, parts.0, parts.1))
      else
        Result::Err(MirSliceError::AnchorNotFound)
      end
    end
  end
end

# The typed EFFECT-path slice of a §11 effect site (AnchorNotFound when the
# node is not an effect site).
pub def mir_effect_paths(mir: MirProgram, function_key: String, site_key: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &site_key)
    when Option::None then Result::Err(MirSliceError::AnchorNotFound)
    when Option::Some(parts) then
      if slice_path_site_is_effect(mir.clone(), ctx.clone(), parts.0, parts.1) then
        Result::Ok(slice_path_mir(mir, ctx, parts.0, parts.1))
      else
        Result::Err(MirSliceError::AnchorNotFound)
      end
    end
  end
end

# The typed Path kind dispatcher: a MirDeinit terminator is a DROP path; any
# §11 effect site is an EFFECT path; anything else is AnchorNotFound.
pub def mir_paths(mir: MirProgram, function_key: String, anchor: String) -> Result[MirSlice, MirSliceError]
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then Result::Err(MirSliceError::FunctionNotFound)
  when Option::Some(ctx) then
    match slice_node_anchor_at(&ctx, &anchor)
    when Option::None then Result::Err(MirSliceError::AnchorNotFound)
    when Option::Some(parts) then
      let is_drop = slice_path_site_is_drop(ctx.clone(), parts.0, parts.1)
      var is_effect = false
      if !is_drop then
        is_effect = slice_path_site_is_effect(mir.clone(), ctx.clone(), parts.0, parts.1)
      end
      if is_drop || is_effect then
        Result::Ok(slice_path_mir(mir, ctx, parts.0, parts.1))
      else
        Result::Err(MirSliceError::AnchorNotFound)
      end
    end
  end
end

# ———— The query-layer row builders ————

pub def mir_function_present(mir: MirProgram, function_key: String) -> Bool
  match slice_fn_find(mir, function_key)
  when Option::Some(_) then true
  when Option::None then false
  end
end

pub def mir_dominator_rows(mir: MirProgram, function_key: String) -> Option[Vec[String]]
  if !mir_function_present(mir.clone(), function_key.clone()) then
    return Option::None
  end
  let rows = mir_dominators(mir, function_key)
  var out: Vec[String] = Vec::new()
  for r in rows do
    out.push(r.0.clone() + "|" + r.1.clone())
  end
  Option::Some(out)
end

pub def mir_postdominator_rows(mir: MirProgram, function_key: String) -> Option[Vec[String]]
  if !mir_function_present(mir.clone(), function_key.clone()) then
    return Option::None
  end
  let rows = mir_postdominators(mir, function_key)
  var out: Vec[String] = Vec::new()
  for r in rows do
    out.push(r.0.clone() + "|" + r.1.clone())
  end
  Option::Some(out)
end

# The function's block count (the whole-function graph answers' visited
# count).
def mir_graph_visited_blocks(mir: MirProgram, function_key: String) -> Int
  match slice_fn_find(mir, function_key)
  when Option::Some(ctx) then ctx.f.blocks.len()
  when Option::None then 0
  end
end

# The postdominator rows WITH the shared completeness record (audit item
# 9): the round-cap exhaustion is Truncated (the positioned sets never
# reached a fixed point — the answer may be unsound and the omitted lower
# bound is the whole domain); a converged answer is Complete (a block that
# cannot reach a structural exit has no postdominator position — exact,
# not an omission).
pub def mir_postdominator_query(mir: MirProgram, function_key: String) -> Option[(Vec[String], CompletenessInfo)]
  match slice_fn_find(mir.clone(), function_key.clone())
  when Option::None then Option::None
  when Option::Some(ctx) then
    let status = slice_graph_ipdom_status(ctx.clone())
    let rows = mir_postdominators(mir, function_key)
    var out: Vec[String] = Vec::new()
    for r in rows do
      out.push(r.0.clone() + "|" + r.1.clone())
    end
    var info = completeness_info_complete(slice_model_postdominators(), ctx.f.blocks.len(), out.len())
    if !status.converged then
      info = completeness_info_truncated(slice_model_postdominators(),
        "cap: the postdominator set fixpoint round cap 2*|blocks|+8 was exhausted without a fixed point; " +
          status.domain_size.to_string() + " domain block(s) have unsettled positions",
        status.domain_size, out.len(), status.domain_size)
    end
    Option::Some((out, info))
  end
end

pub def mir_loop_rows(mir: MirProgram, function_key: String) -> Option[Vec[String]]
  if !mir_function_present(mir.clone(), function_key.clone()) then
    return Option::None
  end
  let loops = mir_loops(mir, function_key)
  var out: Vec[String] = Vec::new()
  for l in loops do
    out.push(l.header_key.clone() + "|" + l.parent_header_key.clone() + "|" + l.block_keys.join(","))
  end
  Option::Some(out)
end

pub def mir_control_dependence_rows(mir: MirProgram, function_key: String) -> Option[Vec[String]]
  if !mir_function_present(mir.clone(), function_key.clone()) then
    return Option::None
  end
  let rows = mir_control_dependence(mir, function_key)
  var out: Vec[String] = Vec::new()
  for r in rows do
    out.push(r.0.clone() + "|" + r.1.clone())
  end
  Option::Some(out)
end

pub def mir_reaching_def_rows(mir: MirProgram, function_key: String, stmt_key: String) -> Option[Vec[String]]
  match mir_reaching_def_query(mir, function_key, stmt_key)
  when Option::Some(pair) then Option::Some(pair.0)
  when Option::None then Option::None
  end
end

pub def mir_path_slice(mir: MirProgram, function_key: String, anchor: String) -> Option[MirSlice]
  match mir_paths(mir, function_key, anchor)
  when Result::Ok(slice) then Option::Some(slice)
  when Result::Err(_) then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# The mir.graph lane check (the sibling lane-def pattern): hand-built
# MirPrograms asserting the graph algorithms' structural answers
# (verifier_projection_tests.tg's construction style). Empty = the lane
# verifies.
# ———————————————————————————————————————————————————————————————

def mir_lane_switch_operand() -> MirOperand
  operand_constant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int, instance: Option::None })
end

def mir_lane_instance() -> InstanceId
  InstanceId {
    def: CallableId { def: DefId { module: ModuleId { id: 0 }, index: 0 } },
    args: Vec::new()
  }
end

def mir_lane_assign(dest_local: Int, rvalue: MirRvalue) -> MirStatement
  MirStatement {
    kind: MirStatementKind::MirAssign(place_local(MirLocalId { id: dest_local }), rvalue),
    span: span_dummy()
  }
end

def mir_lane_copy_rvalue(src_local: Int) -> MirRvalue
  MirRvalue {
    kind: MirRvalueKind::MirMove(operand_copy(place_local(MirLocalId { id: src_local })))
  }
end

def mir_lane_add_rvalue(l: Int, r: Int) -> MirRvalue
  MirRvalue {
    kind: MirRvalueKind::MirBinOp(MirBinOp::Add, operand_copy(place_local(MirLocalId { id: l })), operand_copy(place_local(MirLocalId { id: r })))
  }
end

def mir_lane_goto(id: Int) -> MirTerminator
  MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: id }), span: span_dummy() }
end

def mir_lane_return() -> MirTerminator
  MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
end

def mir_lane_switch(if_true: Int, if_false: Int) -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirSwitchInt {
      op: mir_lane_switch_operand(),
      targets: Vec::from([SwitchTarget { value: 1, target: MirBlockId { id: if_true } }]),
      default_target: MirBlockId { id: if_false }
    },
    span: span_dummy()
  }
end

def mir_lane_deinit(place_local_id: Int, target: Int) -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirDeinit {
      place: place_local(MirLocalId { id: place_local_id }),
      deinit_fn: mir_lane_instance(),
      target: MirBlockId { id: target },
      unwind: Option::None
    },
    span: span_dummy()
  }
end

def mir_lane_block(id: Int, stmts: Vec[MirStatement], term: MirTerminator) -> MirBlock
  MirBlock { id: MirBlockId { id: id }, statements: stmts, terminator: term }
end

def mir_lane_local(id: Int, name: String, ty: Type) -> MirLocal
  MirLocal { id: MirLocalId { id: id }, name: name, ty: ty, is_mut: false, span: span_dummy() }
end

def mir_lane_fn(name: String, locals: Vec[MirLocal], blocks: Vec[MirBlock]) -> MirFunction
  MirFunction {
    name: name,
    params: Vec::new(),
    ret_type: Type::Unit,
    locals: locals,
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span_dummy()
  }
end

def mir_lane_program(f: MirFunction) -> MirProgram
  MirProgram { functions: Vec::from([f]), statics: Vec::new(), types: Vec::new() }
end

# The diamond: 0 branches to 1/2, both join at 3.
def mir_lane_diamond() -> MirProgram
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, Vec::new(), mir_lane_switch(1, 2)))
  blocks.push(mir_lane_block(1, Vec::new(), mir_lane_goto(3)))
  blocks.push(mir_lane_block(2, Vec::new(), mir_lane_goto(3)))
  blocks.push(mir_lane_block(3, Vec::new(), mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_diamond".to_string(), Vec::new(), blocks))
end

# The loop: 1 is the header (2 its body), 3 the exit.
def mir_lane_loop() -> MirProgram
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, Vec::new(), mir_lane_goto(1)))
  blocks.push(mir_lane_block(1, Vec::new(), mir_lane_switch(2, 3)))
  blocks.push(mir_lane_block(2, Vec::new(), mir_lane_goto(1)))
  blocks.push(mir_lane_block(3, Vec::new(), mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_loop".to_string(), Vec::new(), blocks))
end

# The nested loops: outer header 1 (body 2,3,4), inner header 3 (body 4).
def mir_lane_nested() -> MirProgram
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, Vec::new(), mir_lane_goto(1)))
  blocks.push(mir_lane_block(1, Vec::new(), mir_lane_switch(2, 5)))
  blocks.push(mir_lane_block(2, Vec::new(), mir_lane_goto(3)))
  blocks.push(mir_lane_block(3, Vec::new(), mir_lane_switch(4, 1)))
  blocks.push(mir_lane_block(4, Vec::new(), mir_lane_goto(3)))
  blocks.push(mir_lane_block(5, Vec::new(), mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_nested".to_string(), Vec::new(), blocks))
end

# The straight-line reaching-def fixture: b = a; c = b + b; b = c; a = b.
def mir_lane_reach() -> MirProgram
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Unit))
  locals.push(mir_lane_local(1, "a".to_string(), Type::Int))
  locals.push(mir_lane_local(2, "b".to_string(), Type::Int))
  locals.push(mir_lane_local(3, "c".to_string(), Type::Int))
  var stmts: Vec[MirStatement] = Vec::new()
  stmts.push(mir_lane_assign(2, mir_lane_copy_rvalue(1)))
  stmts.push(mir_lane_assign(3, mir_lane_add_rvalue(2, 2)))
  stmts.push(mir_lane_assign(2, mir_lane_copy_rvalue(3)))
  stmts.push(mir_lane_assign(1, mir_lane_copy_rvalue(2)))
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, stmts, mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_reach".to_string(), locals, blocks))
end

# The cross-block reaching-def fixture: block0 defines b, block1 uses it.
def mir_lane_reach_cross() -> MirProgram
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Unit))
  locals.push(mir_lane_local(1, "a".to_string(), Type::Int))
  locals.push(mir_lane_local(2, "b".to_string(), Type::Int))
  locals.push(mir_lane_local(3, "c".to_string(), Type::Int))
  var b0: Vec[MirStatement] = Vec::new()
  b0.push(mir_lane_assign(2, mir_lane_copy_rvalue(1)))
  var b1: Vec[MirStatement] = Vec::new()
  b1.push(mir_lane_assign(3, mir_lane_add_rvalue(2, 2)))
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, b0, mir_lane_goto(1)))
  blocks.push(mir_lane_block(1, b1, mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_reach_cross".to_string(), locals, blocks))
end

# The drop fixture: block0 defines b, block1 deinits it, block2 returns.
def mir_lane_drop() -> MirProgram
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Unit))
  locals.push(mir_lane_local(1, "a".to_string(), Type::Int))
  locals.push(mir_lane_local(2, "b".to_string(), Type::Int))
  var b0: Vec[MirStatement] = Vec::new()
  b0.push(mir_lane_assign(2, mir_lane_copy_rvalue(1)))
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, b0, mir_lane_goto(1)))
  blocks.push(mir_lane_block(1, Vec::new(), mir_lane_deinit(2, 2)))
  blocks.push(mir_lane_block(2, Vec::new(), mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_drop".to_string(), locals, blocks))
end

# (audit item 9) the constant rvalue the completeness fixtures seed with.
def mir_lane_const_rvalue(n: Int) -> MirRvalue
  MirRvalue {
    kind: MirRvalueKind::MirMove(operand_constant(MirConstant {
      kind: MirConstantKind::MirInt(n), ty: Type::Int, instance: Option::None
    }))
  }
end

# (audit item 9) the self-loop completeness fixture: block1 reads x at s0
# and defines it at s1, with a self edge — the reaching-def residual case
# both the def-chain walks and the ReachingDefs fixpoint report as
# ConservativeSubset.
def mir_lane_selfloop() -> MirProgram
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Unit))
  locals.push(mir_lane_local(1, "x".to_string(), Type::Int))
  locals.push(mir_lane_local(2, "y".to_string(), Type::Int))
  var b1: Vec[MirStatement] = Vec::new()
  b1.push(mir_lane_assign(2, mir_lane_copy_rvalue(1)))
  b1.push(mir_lane_assign(1, mir_lane_const_rvalue(7)))
  var blocks: Vec[MirBlock] = Vec::new()
  blocks.push(mir_lane_block(0, Vec::new(), mir_lane_goto(1)))
  blocks.push(mir_lane_block(1, b1, mir_lane_switch(1, 2)))
  blocks.push(mir_lane_block(2, Vec::new(), mir_lane_return()))
  mir_lane_program(mir_lane_fn("lane_selfloop".to_string(), locals, blocks))
end

# (audit item 9) the truncation fixture: n blocks each reading x (never
# redefined), so the forward worklist outgrows slice_max_items() with work
# left (the Truncated case).
def mir_lane_long_chain(n: Int) -> MirProgram
  var locals: Vec[MirLocal] = Vec::new()
  locals.push(mir_lane_local(0, "_ret".to_string(), Type::Unit))
  locals.push(mir_lane_local(1, "x".to_string(), Type::Int))
  var i = 0
  while i < n do
    locals.push(mir_lane_local(2 + i, "t" + i.to_string(), Type::Int))
    i = i + 1
  end
  var blocks: Vec[MirBlock] = Vec::new()
  var b0: Vec[MirStatement] = Vec::new()
  b0.push(mir_lane_assign(1, mir_lane_const_rvalue(1)))
  blocks.push(mir_lane_block(0, b0, mir_lane_goto(1)))
  var b = 1
  while b <= n do
    var stmts: Vec[MirStatement] = Vec::new()
    stmts.push(mir_lane_assign(2 + (b - 1), mir_lane_copy_rvalue(1)))
    var term = mir_lane_return()
    if b < n then
      term = mir_lane_goto(b + 1)
    end
    blocks.push(mir_lane_block(b, stmts, term))
    b = b + 1
  end
  mir_lane_program(mir_lane_fn("lane_trunc".to_string(), locals, blocks))
end

def mir_lane_bkey(name: String, id: Int) -> String
  slice_graph_block_key(&name, id)
end

def mir_graph_lane_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def mir_graph_lane_contains(rows: Vec[String], key: String) -> Bool
  for r in rows do
    if r == key then
      return true
    end
  end
  false
end

def mir_graph_lane_row(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !mir_graph_lane_same(got, expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

# Run the lane rows. Returns every mismatch row (empty = the lane verifies).
pub def mir_graph_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  # —— the diamond: dominance, postdominance, no loops, branch control
  # dependence ——
  let diamond = mir_lane_diamond()
  let dname = "lane_diamond".to_string()
  var d_dom: Vec[String] = Vec::from([
    mir_lane_bkey(&dname, 0) + "|" + mir_lane_bkey(&dname, 0),
    mir_lane_bkey(&dname, 1) + "|" + mir_lane_bkey(&dname, 0),
    mir_lane_bkey(&dname, 2) + "|" + mir_lane_bkey(&dname, 0),
    mir_lane_bkey(&dname, 3) + "|" + mir_lane_bkey(&dname, 0)
  ])
  semantic_strings_sort(&mut d_dom)
  mir_graph_lane_row(&mut out, "dom.diamond", mir_dominator_rows(diamond.clone(), dname.clone()).unwrap_or(Vec::new()), d_dom)
  var d_post: Vec[String] = Vec::from([
    mir_lane_bkey(&dname, 0) + "|" + mir_lane_bkey(&dname, 3),
    mir_lane_bkey(&dname, 1) + "|" + mir_lane_bkey(&dname, 3),
    mir_lane_bkey(&dname, 2) + "|" + mir_lane_bkey(&dname, 3),
    mir_lane_bkey(&dname, 3) + "|"
  ])
  semantic_strings_sort(&mut d_post)
  mir_graph_lane_row(&mut out, "post.diamond", mir_postdominator_rows(diamond.clone(), dname.clone()).unwrap_or(Vec::new()), d_post)
  mir_graph_lane_row(&mut out, "loops.diamond", mir_loop_rows(diamond.clone(), dname.clone()).unwrap_or(Vec::new()), Vec::new())
  var d_cd: Vec[String] = Vec::from([
    mir_lane_bkey(&dname, 1) + "|" + mir_lane_bkey(&dname, 0),
    mir_lane_bkey(&dname, 2) + "|" + mir_lane_bkey(&dname, 0)
  ])
  semantic_strings_sort(&mut d_cd)
  mir_graph_lane_row(&mut out, "cd.diamond", mir_control_dependence_rows(diamond.clone(), dname.clone()).unwrap_or(Vec::new()), d_cd)

  # —— the loop: one natural loop, header self-control, header/exit ipdom ——
  let loop_fn = mir_lane_loop()
  let lname = "lane_loop".to_string()
  var l_dom: Vec[String] = Vec::from([
    mir_lane_bkey(&lname, 0) + "|" + mir_lane_bkey(&lname, 0),
    mir_lane_bkey(&lname, 1) + "|" + mir_lane_bkey(&lname, 0),
    mir_lane_bkey(&lname, 2) + "|" + mir_lane_bkey(&lname, 1),
    mir_lane_bkey(&lname, 3) + "|" + mir_lane_bkey(&lname, 1)
  ])
  semantic_strings_sort(&mut l_dom)
  mir_graph_lane_row(&mut out, "dom.loop", mir_dominator_rows(loop_fn.clone(), lname.clone()).unwrap_or(Vec::new()), l_dom)
  var l_post: Vec[String] = Vec::from([
    mir_lane_bkey(&lname, 0) + "|" + mir_lane_bkey(&lname, 1),
    mir_lane_bkey(&lname, 1) + "|" + mir_lane_bkey(&lname, 3),
    mir_lane_bkey(&lname, 2) + "|" + mir_lane_bkey(&lname, 1),
    mir_lane_bkey(&lname, 3) + "|"
  ])
  semantic_strings_sort(&mut l_post)
  mir_graph_lane_row(&mut out, "post.loop", mir_postdominator_rows(loop_fn.clone(), lname.clone()).unwrap_or(Vec::new()), l_post)
  var l_loops: Vec[String] = Vec::from([
    mir_lane_bkey(&lname, 1) + "||" + mir_lane_bkey(&lname, 1) + "," + mir_lane_bkey(&lname, 2)
  ])
  mir_graph_lane_row(&mut out, "loops.loop", mir_loop_rows(loop_fn.clone(), lname.clone()).unwrap_or(Vec::new()), l_loops)
  var l_cd: Vec[String] = Vec::from([
    mir_lane_bkey(&lname, 1) + "|" + mir_lane_bkey(&lname, 1),
    mir_lane_bkey(&lname, 2) + "|" + mir_lane_bkey(&lname, 1)
  ])
  semantic_strings_sort(&mut l_cd)
  mir_graph_lane_row(&mut out, "cd.loop", mir_control_dependence_rows(loop_fn.clone(), lname.clone()).unwrap_or(Vec::new()), l_cd)

  # —— the nested loops: the forest parent — the inner header's parent is
  # the outer header ——
  let nested = mir_lane_nested()
  let nname = "lane_nested".to_string()
  var n_dom: Vec[String] = Vec::from([
    mir_lane_bkey(&nname, 0) + "|" + mir_lane_bkey(&nname, 0),
    mir_lane_bkey(&nname, 1) + "|" + mir_lane_bkey(&nname, 0),
    mir_lane_bkey(&nname, 2) + "|" + mir_lane_bkey(&nname, 1),
    mir_lane_bkey(&nname, 3) + "|" + mir_lane_bkey(&nname, 2),
    mir_lane_bkey(&nname, 4) + "|" + mir_lane_bkey(&nname, 3),
    mir_lane_bkey(&nname, 5) + "|" + mir_lane_bkey(&nname, 1)
  ])
  semantic_strings_sort(&mut n_dom)
  mir_graph_lane_row(&mut out, "dom.nested", mir_dominator_rows(nested.clone(), nname.clone()).unwrap_or(Vec::new()), n_dom)
  var n_post: Vec[String] = Vec::from([
    mir_lane_bkey(&nname, 0) + "|" + mir_lane_bkey(&nname, 1),
    mir_lane_bkey(&nname, 1) + "|" + mir_lane_bkey(&nname, 5),
    mir_lane_bkey(&nname, 2) + "|" + mir_lane_bkey(&nname, 3),
    mir_lane_bkey(&nname, 3) + "|" + mir_lane_bkey(&nname, 1),
    mir_lane_bkey(&nname, 4) + "|" + mir_lane_bkey(&nname, 3),
    mir_lane_bkey(&nname, 5) + "|"
  ])
  semantic_strings_sort(&mut n_post)
  mir_graph_lane_row(&mut out, "post.nested", mir_postdominator_rows(nested.clone(), nname.clone()).unwrap_or(Vec::new()), n_post)
  var n_loops: Vec[String] = Vec::from([
    mir_lane_bkey(&nname, 1) + "||" + mir_lane_bkey(&nname, 1) + "," + mir_lane_bkey(&nname, 2) + "," + mir_lane_bkey(&nname, 3) + "," + mir_lane_bkey(&nname, 4),
    mir_lane_bkey(&nname, 3) + "|" + mir_lane_bkey(&nname, 1) + "|" + mir_lane_bkey(&nname, 3) + "," + mir_lane_bkey(&nname, 4)
  ])
  semantic_strings_sort(&mut n_loops)
  mir_graph_lane_row(&mut out, "loops.nested", mir_loop_rows(nested.clone(), nname.clone()).unwrap_or(Vec::new()), n_loops)

  # —— the reaching defs: the kill (nearest bare def) and the cross-block
  # predecessor def ——
  let reach = mir_lane_reach()
  let rname = "lane_reach".to_string()
  match slice_fn_find(reach.clone(), rname.clone())
  when Option::Some(rctx) then
    let kill_key = slice_graph_node_stmt_text(&reach, &rctx, 0, 2)
    let kill_use = slice_stmt_key(&rname, 0, 3)
    mir_graph_lane_row(&mut out, "reach.kill", mir_reaching_def_rows(reach.clone(), rname.clone(), kill_use).unwrap_or(Vec::new()), Vec::from(["b|" + kill_key]))
    let first_key = slice_graph_node_stmt_text(&reach, &rctx, 0, 0)
    let first_use = slice_stmt_key(&rname, 0, 1)
    mir_graph_lane_row(&mut out, "reach.first", mir_reaching_def_rows(reach.clone(), rname.clone(), first_use).unwrap_or(Vec::new()), Vec::from(["b|" + first_key]))
  when Option::None then
    out.push("reach: fixture function not found")
  end
  let cross = mir_lane_reach_cross()
  let cname = "lane_reach_cross".to_string()
  match slice_fn_find(cross.clone(), cname.clone())
  when Option::Some(cctx) then
    let cross_key = slice_graph_node_stmt_text(&cross, &cctx, 0, 0)
    let cross_use = slice_stmt_key(&cname, 1, 0)
    mir_graph_lane_row(&mut out, "reach.cross", mir_reaching_def_rows(cross.clone(), cname.clone(), cross_use).unwrap_or(Vec::new()), Vec::from(["b|" + cross_key]))
  when Option::None then
    out.push("reach.cross: fixture function not found")
  end

  # —— the drop path: the site + its destroyed place's def chain ——
  let drop_fn = mir_lane_drop()
  let dname2 = "lane_drop".to_string()
  let drop_site = slice_term_key(&dname2, 1)
  match slice_fn_find(drop_fn.clone(), dname2.clone())
  when Option::Some(dctx) then
    let site_key = slice_graph_node_stmt_text(&drop_fn, &dctx, 1, 0)
    let def_key = slice_graph_node_stmt_text(&drop_fn, &dctx, 0, 0)
    match mir_path_slice(drop_fn.clone(), dname2.clone(), drop_site)
    when Option::Some(slice) then
      if !mir_graph_lane_contains(&slice.statements, &site_key) then
        out.push("path.drop: missing site " + site_key.clone())
      end
      if !mir_graph_lane_contains(&slice.statements, &def_key) then
        out.push("path.drop: missing def " + def_key.clone())
      end
    when Option::None then
      out.push("path.drop: expected a resolved path slice, got none")
    end
  when Option::None then
    out.push("path.drop: fixture function not found")
  end

  # —— (audit item 9) the shared completeness model, per case ——
  # 1. an EXACT in-block slice is Complete and the ProofComplete gate
  # ACCEPTS it.
  match slice_fn_find(reach.clone(), rname.clone())
  when Option::Some(_) then
    let exact = slice_statement(reach.clone(), rname.clone(), slice_stmt_key(&rname, 0, 0))
    if !slice_completeness_is_complete(exact.info.completeness.clone()) then
      out.push("completeness.exact: expected complete, got " + completeness_info_render(exact.info.clone()))
    end
    if exact.info.analysis_model != slice_model_forward_chain() then
      out.push("completeness.exact: unexpected model " + exact.info.analysis_model.clone())
    end
    match mir_slice(Option::Some(reach.clone()), MirSliceRequest {
      function_key: rname.clone(),
      kind: MirSliceKind::ForwardDataflow,
      anchor: slice_stmt_key(&rname, 0, 0),
      require: SliceRequirement::ProofComplete
    })
    when Result::Ok(_) then ()
    when Result::Err(_) then out.push("completeness.gate.complete: expected Ok")
    end
  when Option::None then ()
  end
  # 2. a slice crossing blocks without a self edge may include extra nodes:
  # ConservativeSuperset.
  let cross2 = mir_lane_reach_cross()
  let sup = slice_value(cross2.clone(), cname.clone(), 2)
  if slice_completeness_word(sup.info.completeness.clone()) != "conservative-superset" then
    out.push("completeness.superset: expected conservative-superset, got " + completeness_info_render(sup.info.clone()))
  end
  # 3. the self-loop limitation is ConservativeSubset naming the model —
  # for the def-chain walk AND the ReachingDefs fixpoint.
  let selfloop = mir_lane_selfloop()
  let slname = "lane_selfloop".to_string()
  match slice_fn_find(selfloop.clone(), slname.clone())
  when Option::Some(_) then
    let sl = slice_value(selfloop.clone(), slname.clone(), 1)
    if slice_completeness_word(sl.info.completeness.clone()) != "conservative-subset" then
      out.push("completeness.subset: expected conservative-subset, got " + completeness_info_render(sl.info.clone()))
    end
    if sl.info.omitted_lower_bound <= 0 then
      out.push("completeness.subset: expected omitted_lower_bound > 0")
    end
    if !sl.info.truncation_reason.contains("self-loop") then
      out.push("completeness.subset: reason does not name the self-loop residual: " + sl.info.truncation_reason.clone())
    end
    match mir_reaching_def_query(selfloop.clone(), slname.clone(), slice_stmt_key(&slname, 1, 0))
    when Option::Some(pair) then
      if slice_completeness_word(pair.1.completeness.clone()) != "conservative-subset" then
        out.push("completeness.reach.subset: expected conservative-subset, got " + completeness_info_render(pair.1.clone()))
      end
      if pair.1.analysis_model != slice_model_reaching() then
        out.push("completeness.reach.subset: unexpected model " + pair.1.analysis_model.clone())
      end
    when Option::None then out.push("completeness.reach.subset: no rows")
    end
  when Option::None then out.push("completeness.subset: fixture function not found")
  end
  # 4. the item cap is Truncated with a positive omitted lower bound and the
  # cap named; ProofComplete REFUSES it with the typed error carrying the
  # class + reason.
  let long = mir_lane_long_chain(2100)
  let tname = "lane_trunc".to_string()
  let trunc_req = MirSliceRequest {
    function_key: tname.clone(),
    kind: MirSliceKind::ForwardDataflow,
    anchor: slice_stmt_key(&tname, 0, 0),
    require: SliceRequirement::BestEffort
  }
  match mir_slice(Option::Some(long.clone()), trunc_req.clone())
  when Result::Ok(truncated_slice) then
    if slice_completeness_word(truncated_slice.info.completeness.clone()) != "truncated" then
      out.push("completeness.truncated: expected truncated, got " + completeness_info_render(truncated_slice.info.clone()))
    end
    if truncated_slice.info.omitted_lower_bound <= 0 then
      out.push("completeness.truncated: expected omitted_lower_bound > 0")
    end
    if !truncated_slice.info.truncation_reason.contains("slice_max_items") then
      out.push("completeness.truncated: reason does not name the cap: " + truncated_slice.info.truncation_reason.clone())
    end
  when Result::Err(_) then out.push("completeness.truncated: expected Ok under BestEffort")
  end
  var proof_req = trunc_req.clone()
  proof_req.require = SliceRequirement::ProofComplete
  match mir_slice(Option::Some(long.clone()), proof_req.clone())
  when Result::Ok(_) then out.push("completeness.gate.truncated: expected Err, got Ok")
  when Result::Err(MirSliceError::IncompleteRequirement(class, reason)) then
    if slice_completeness_word(class.clone()) != "truncated" then
      out.push("completeness.gate.truncated: expected the truncated class, got " + slice_completeness_word(class.clone()))
    end
    if reason.len() == 0 then
      out.push("completeness.gate.truncated: empty reason")
    end
  when Result::Err(_) then out.push("completeness.gate.truncated: expected IncompleteRequirement")
  end
  out
end
