## Tangerine Compiler — Capability Drift Baseline
##
## §68-74: Capability drift detection and baseline management
## Prevents accidental security footprint expansion.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::mode::{Mode, Span}
use tg_compiler::cqs::{SurfaceClass, sha256}
use tg_compiler::util::{to_float, max_int}

# ═══════════════════════════════════════════════════════════════
# §69 — Capability Vocabulary (v0.2)
# ═══════════════════════════════════════════════════════════════

# Normative capability IDs
def CAP_NET() -> String       "NetCap" end
def CAP_FS() -> String        "FsCap" end
def CAP_FS_READ() -> String   "FsReadCap" end
def CAP_PROC() -> String      "ProcCap" end
def CAP_ENV() -> String       "EnvCap" end
def CAP_DB() -> String        "DbCap" end
def CAP_CLOCK() -> String     "ClockCap" end
def CAP_RANDOM() -> String    "RandomCap" end
def CAP_FFI() -> String       "FfiCap" end
def CAP_UNSAFE() -> String    "UnsafeCap" end

# Vec[String] join under the T: Display surface — the element-wise loop form
# (Array::join is Copy-gated; String is Clone-not-Copy).
def join_vec_strings(src: Vec[String], sep: String) -> String
  var result = "".to_string()
  var i = 0
  while i < src.len() do
    if i > 0 then
      result = result + sep
    end
    result = result + src[i].clone()
    i = i + 1
  end
  result
end

def all_builtin_caps() -> Vec[String]
  let caps = Vec::new()
  caps.push(CAP_NET())
  caps.push(CAP_FS())
  caps.push(CAP_FS_READ())
  caps.push(CAP_PROC())
  caps.push(CAP_ENV())
  caps.push(CAP_DB())
  caps.push(CAP_CLOCK())
  caps.push(CAP_RANDOM())
  caps.push(CAP_FFI())
  caps.push(CAP_UNSAFE())
  caps
end

# Custom caps must be namespaced: MyOrg::SecretsCap
def is_valid_custom_cap(name: String) -> Bool
  name.contains("::")
end

# ═══════════════════════════════════════════════════════════════
# §70 — Baseline File
# ═══════════════════════════════════════════════════════════════

# §70.1 — Default:.tg_capability_baseline.json
# Generated by `tg quality --bless` or `tg release`

struct CapBaseline
  schema_version: String
  edition: String
  tgc_version: String
  target: String
  build_id: String
  generated_utc: String
  package_name: String
  package_version: String
  symbols: Vec[SymbolCaps]
  modules: Vec[ModuleCaps]
end

struct SymbolCaps
  symbol_id: String
  surface_class: SurfaceClass
  caps: Set[String]
end

struct ModuleCaps
  module_path: String
  caps: Set[String]
end

def new_baseline(
  target: String,
  build_id: String,
  pkg_name: String,
  pkg_version: String
) -> CapBaseline
  CapBaseline {
    schema_version: "cap_baseline.v1",
    edition: "2026",
    tgc_version: "0.1.0",
    target: target,
    build_id: build_id,
    generated_utc: "unknown".to_string(),
    package_name: pkg_name,
    package_version: pkg_version,
    symbols: Vec::new(),
    modules: Vec::new()
  }
end

# ═══════════════════════════════════════════════════════════════
# §71 — Capability Extraction Algorithm
# ═══════════════════════════════════════════════════════════════

struct CapExtractResult
  direct: Set[String]       # From parameter types
  transitive: Set[String]   # From callees
  from_effects: Set[String] # From effect-to-cap mapping
  has_unsafe: Bool
end

# Direct caps: parameter types → cap IDs
def extract_direct_caps(param_types: Vec[String]) -> Set[String]
  let caps = Set::new()
  for ty in param_types
    match ty
    when "Net" then caps.insert(CAP_NET())
    when "FS" then caps.insert(CAP_FS())
    when "FsRead" then caps.insert(CAP_FS_READ())
    when "Proc" then caps.insert(CAP_PROC())
    when "Db" then caps.insert(CAP_DB())
    when "Env" then caps.insert(CAP_ENV())
    when "Clock" then caps.insert(CAP_CLOCK())
    when "Random" then caps.insert(CAP_RANDOM())
    when _ then ()
    end
  end
  caps
end

# Effect-to-cap mapping
def effect_to_cap(effect: String) -> Option[String]
  match effect
  when "net.read" then Option::Some(CAP_NET())
  when "net.write" then Option::Some(CAP_NET())
  when "fs.read" then Option::Some(CAP_FS_READ())
  when "fs.write" then Option::Some(CAP_FS())
  when "process.spawn" then Option::Some(CAP_PROC())
  when "ffi.call" then Option::Some(CAP_FFI())
  when "env.read" then Option::Some(CAP_ENV())
  when "env.write" then Option::Some(CAP_ENV())
  when "db.read" then Option::Some(CAP_DB())
  when "db.write" then Option::Some(CAP_DB())
  when "clock.now" then Option::Some(CAP_CLOCK())
  when "random.gen" then Option::Some(CAP_RANDOM())
  when _ then
    let lowered = effect.to_lowercase()
    if lowered.starts_with("net.") then
      Option::Some(CAP_NET())
    elsif lowered.starts_with("fs.") then
      if lowered.contains("read") then Option::Some(CAP_FS_READ()) else Option::Some(CAP_FS()) end
    elsif lowered.starts_with("process.") then
      Option::Some(CAP_PROC())
    elsif lowered.starts_with("ffi.") then
      Option::Some(CAP_FFI())
    elsif lowered.starts_with("env.") then
      Option::Some(CAP_ENV())
    elsif lowered.starts_with("db.") then
      Option::Some(CAP_DB())
    elsif lowered.starts_with("clock.") || lowered.starts_with("time.") then
      Option::Some(CAP_CLOCK())
    elsif lowered.starts_with("random.") || lowered.starts_with("rand.") then
      Option::Some(CAP_RANDOM())
    else
      Option::None
    end
  end
end

# Full extraction: direct + transitive + effects + unsafe
def extract_all_caps(
  param_types: Vec[String],
  callee_caps: Vec[Set[String]],
  effects: Vec[String],
  has_unsafe: Bool
) -> CapExtractResult
  let direct = extract_direct_caps(param_types)

  # Transitive: union of callee caps
  let transitive = Set::new()
  for callee in callee_caps
    for cap in callee
      transitive.insert(cap)
    end
  end

  # Effects → caps
  let from_effects = Set::new()
  for eff in effects
    match effect_to_cap(eff)
    when Option::Some(cap) then from_effects.insert(cap)
    when Option::None then ()
    end
  end

  # Unsafe → UnsafeCap
  if has_unsafe then
    from_effects.insert(CAP_UNSAFE())
  end

  CapExtractResult {
    direct: direct,
    transitive: transitive,
    from_effects: from_effects,
    has_unsafe: has_unsafe
  }
end

# Analyze a single function declaration and return its extracted capabilities.
# Walks the function's parameters, body, and annotations to determine all
# capabilities it requires.
def analyze_function_caps(
  func: FunctionDecl,
  attrs: Vec[Attribute],
  callee_caps: Vec[Set[String]]
) -> CapExtractResult
  # Collect parameter type names for direct capability extraction
  mut param_types = Vec::new()
  for param in func.params do
    param_types.push(param.ty.to_string())
  end

  # Collect declared effects from explicit function metadata and annotations.
  mut effects = Vec::new()
  for eff in func.effects do
    if !effects.contains(&eff) then
      effects.push(eff.clone())
    end
  end

  for attr in attrs do
    if attr.name == "effect" || attr.name == "effects" then
      for arg in attr.args do
        effects.push(arg.clone())
      end
    end
  end

  # Collect inferred effects from AST body traversal.
  # This keeps capability extraction tied to parsed structure instead of
  # relying only on textual annotations.
  let inferred_effects = collect_effects_from_function(func)
  for eff in inferred_effects do
    if !effects.contains(&eff) then
      effects.push(eff)
    end
  end

  # Check for unsafe blocks in the function body
  let has_unsafe = function_has_unsafe(func)

  # Start from extracted caps, then merge explicit required capability declarations.
  let extracted = extract_all_caps(&param_types, callee_caps, &effects, has_unsafe)
  let merged_direct = extracted.direct.clone()
  for cap in func.required_caps do
    merged_direct.insert(cap.clone())
  end

  CapExtractResult {
    direct: merged_direct,
    transitive: extracted.transitive,
    from_effects: extracted.from_effects,
    has_unsafe: extracted.has_unsafe
  }
end

def collect_effects_from_function(func: FunctionDecl) -> Vec[String]
  let effects = Vec::new()
  match func.body
  when FnBody::FnBlock(block) then
    collect_effects_from_block(&block, &effects)
  when _ then ()
  end
  effects
end

def push_effect_once(effects: Vec[String], sink effect: String) -> Unit
  if !effects.contains(effect) then
    effects.push(effect)
  end
end

def maybe_effect_from_name(name: String) -> Option[String]
  let lowered = name.to_lowercase()

  if lowered.contains("net") || lowered.contains("socket") || lowered.contains("http") then
    if lowered.contains("read") || lowered.contains("recv") then
      return Option::Some("net.read")
    end
    if lowered.contains("write") || lowered.contains("send") || lowered.contains("connect") || lowered.contains("bind") then
      return Option::Some("net.write")
    end
  end

  if lowered.contains("file") || lowered.contains("fs") || lowered.contains("path") then
    if lowered.contains("read") || lowered.contains("open") || lowered.contains("load") then
      return Option::Some("fs.read")
    end
    if lowered.contains("write") || lowered.contains("create") || lowered.contains("append") || lowered.contains("remove") then
      return Option::Some("fs.write")
    end
  end

  if lowered.contains("spawn") || lowered.contains("exec") || lowered.contains("system") || lowered.contains("process") then
    return Option::Some("process.spawn")
  end

  if lowered.contains("ffi") then
    return Option::Some("ffi.call")
  end

  if lowered.contains("env") then
    if lowered.contains("set") || lowered.contains("write") then
      return Option::Some("env.write")
    end
    return Option::Some("env.read")
  end

  if lowered.contains("db") || lowered.contains("sql") || lowered.contains("query") then
    if lowered.contains("read") || lowered.contains("select") || lowered.contains("query") then
      return Option::Some("db.read")
    end
    if lowered.contains("write") || lowered.contains("insert") || lowered.contains("update") || lowered.contains("delete") then
      return Option::Some("db.write")
    end
  end

  if lowered.contains("time") || lowered.contains("clock") || lowered == "now" then
    return Option::Some("clock.now")
  end

  if lowered.contains("random") || lowered.contains("rand") then
    return Option::Some("random.gen")
  end

  Option::None
end

def maybe_effect_from_path_call(path_name: String) -> Option[String]
  let lowered = path_name.to_lowercase()

  if lowered.starts_with("std::fs::") || lowered.contains("::fs::") then
    if lowered.ends_with("::read") || lowered.ends_with("::open") || lowered.ends_with("::load") then
      return Option::Some("fs.read")
    end
    if lowered.ends_with("::write") || lowered.ends_with("::create") || lowered.ends_with("::append") || lowered.ends_with("::remove") then
      return Option::Some("fs.write")
    end
  end

  if lowered.starts_with("std::net::") || lowered.contains("::net::") || lowered.starts_with("std::http::") || lowered.contains("::http::") then
    if lowered.ends_with("::recv") || lowered.ends_with("::read") then
      return Option::Some("net.read")
    end
    if lowered.ends_with("::send") || lowered.ends_with("::write") || lowered.ends_with("::connect") || lowered.ends_with("::bind") || lowered.ends_with("::listen") then
      return Option::Some("net.write")
    end
  end

  if lowered.starts_with("std::process::") || lowered.contains("::process::") then
    if lowered.ends_with("::spawn") || lowered.ends_with("::exec") || lowered.ends_with("::system") then
      return Option::Some("process.spawn")
    end
  end

  if lowered.starts_with("std::env::") || lowered.contains("::env::") then
    if lowered.ends_with("::set") || lowered.ends_with("::set_var") then
      return Option::Some("env.write")
    end
    if lowered.ends_with("::get") || lowered.ends_with("::get_env") || lowered.ends_with("::var") || lowered.ends_with("::getenv") then
      return Option::Some("env.read")
    end
  end

  if lowered.starts_with("std::db::") || lowered.contains("::db::") then
    if lowered.ends_with("::select") || lowered.ends_with("::query") || lowered.ends_with("::fetch") then
      return Option::Some("db.read")
    end
    if lowered.ends_with("::insert") || lowered.ends_with("::update") || lowered.ends_with("::delete") || lowered.ends_with("::execute") then
      return Option::Some("db.write")
    end
  end

  if lowered.starts_with("std::time::") || lowered.contains("::time::") || lowered.starts_with("std::clock::") || lowered.contains("::clock::") then
    if lowered.ends_with("::now") then
      return Option::Some("clock.now")
    end
  end

  if lowered.starts_with("std::random::") || lowered.contains("::random::") then
    return Option::Some("random.gen")
  end

  Option::None
end

def maybe_effect_from_method_call(recv_path: String, method: String) -> Option[String]
  let base = recv_path.to_lowercase()
  let op = method.to_lowercase()

  if base.contains("::fs") || base.ends_with("fs") || base.contains("file") then
    if op == "read" || op == "open" || op == "load" then return Option::Some("fs.read") end
    if op == "write" || op == "append" || op == "create" || op == "remove" then return Option::Some("fs.write") end
  end

  if base.contains("::net") || base.contains("::http") || base.contains("socket") then
    if op == "recv" || op == "read" then return Option::Some("net.read") end
    if op == "send" || op == "write" || op == "connect" || op == "bind" || op == "listen" then return Option::Some("net.write") end
  end

  if base.contains("::process") || base.contains("process") then
    if op == "spawn" || op == "exec" || op == "system" then return Option::Some("process.spawn") end
  end

  if base.contains("::env") || base.contains("env") then
    if op == "set" || op == "set_var" then return Option::Some("env.write") end
    if op == "get" || op == "get_env" || op == "var" || op == "getenv" then return Option::Some("env.read") end
  end

  if base.contains("::db") || base.contains("database") then
    if op == "select" || op == "query" || op == "fetch" then return Option::Some("db.read") end
    if op == "insert" || op == "update" || op == "delete" || op == "execute" then return Option::Some("db.write") end
  end

  if base.contains("::time") || base.contains("::clock") || base.contains("clock") then
    if op == "now" then return Option::Some("clock.now") end
  end

  if base.contains("::random") || base.contains("random") then
    return Option::Some("random.gen")
  end

  Option::None
end

def collect_effects_from_block(block: Block, effects: Vec[String]) -> Unit
  for stmt in block.stmts do
    collect_effects_from_stmt(&stmt, effects)
  end
end

def collect_effects_from_stmt(stmt: Stmt, effects: Vec[String]) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then
    collect_effects_from_expr(&value, effects)

  when StmtKind::StmtAssign(target, value) then
    collect_effects_from_expr(&target, effects)
    collect_effects_from_expr(&value, effects)

  when StmtKind::StmtExpr(expr) then
    collect_effects_from_expr(&expr, effects)

  when StmtKind::StmtIf(if_stmt) then
    collect_effects_from_expr(&if_stmt.cond, effects)
    collect_effects_from_block(&if_stmt.then_block, effects)
    for entry in if_stmt.elsif_branches do
      let elsif_cond = entry.0
      let elsif_block = entry.1
      collect_effects_from_expr(&elsif_cond, effects)
      collect_effects_from_block(&elsif_block, effects)
    end
    match if_stmt.else_block
    when Option::Some(else_block) then collect_effects_from_block(&else_block, effects)
    when Option::None then ()
    end

  when StmtKind::StmtWhile(cond, body) then
    collect_effects_from_expr(&cond, effects)
    collect_effects_from_block(&body, effects)

  when StmtKind::StmtFor(for_stmt) then
    collect_effects_from_expr(&for_stmt.iter, effects)
    collect_effects_from_block(&for_stmt.body, effects)

  when StmtKind::StmtLoop(body) then
    collect_effects_from_block(&body, effects)

  when StmtKind::StmtReturn(ret_opt) then
    match ret_opt
    when Option::Some(ret_expr) then collect_effects_from_expr(&ret_expr, effects)
    when Option::None then ()
    end

  when StmtKind::StmtMatch(m) then
    collect_effects_from_expr(&m.scrutinee, effects)
    for arm in m.arms do
      match arm.guard_expr
      when Option::Some(g) then collect_effects_from_expr(&g, effects)
      when Option::None then ()
      end
      collect_effects_from_block(&arm.body, effects)
    end

  when StmtKind::StmtUnsafe(_, body) then
    collect_effects_from_block(&body, effects)

  when StmtKind::StmtDefer(body) then
    collect_effects_from_block(&body, effects)

  when StmtKind::StmtGuard(cond, _) then
    collect_effects_from_expr(&cond, effects)

  when StmtKind::StmtTry(try_body, catches, finally_opt) then
    collect_effects_from_block(&try_body, effects)
    for c in catches do
      collect_effects_from_block(&c.body, effects)
    end
    match finally_opt
    when Option::Some(fb) then collect_effects_from_block(&fb, effects)
    when Option::None then ()
    end

  when StmtKind::StmtWith(resource, _, with_body) then
    collect_effects_from_expr(&resource, effects)
    collect_effects_from_block(&with_body, effects)

  when StmtKind::StmtHandleWith(effect_expr, handlers) then
    collect_effects_from_expr(&effect_expr, effects)
    for h in handlers do
      for arm in h.arms do
        collect_effects_from_block(&arm.body, effects)
      end
    end

  when _ then ()
  end
end

def collect_effects_from_expr(expr: Expr, effects: Vec[String]) -> Unit
  match expr.kind
  when ExprKind::ExprCall(callee, args) then
    match callee.kind
    when ExprKind::ExprIdent(name) then
      match maybe_effect_from_name(name)
      when Option::Some(effect_id) then push_effect_once(effects, effect_id)
      when Option::None then ()
      end
    when ExprKind::ExprPath(path) then
      let joined = join_vec_strings(&path.segments, "::")
      match maybe_effect_from_path_call(joined)
      when Option::Some(effect_id) then push_effect_once(effects, effect_id)
      when Option::None then
        match maybe_effect_from_name(joined)
        when Option::Some(fallback_effect) then push_effect_once(effects, fallback_effect)
        when Option::None then ()
        end
      end
    when ExprKind::ExprFieldAccess(recv, method_name) then
      match recv.kind
      when ExprKind::ExprPath(path) then
        let recv_joined = join_vec_strings(&path.segments, "::")
        match maybe_effect_from_method_call(recv_joined, method_name)
        when Option::Some(effect_id) then push_effect_once(effects, effect_id)
        when Option::None then ()
        end
      when _ then ()
      end
    when _ then ()
    end
    collect_effects_from_expr(&callee, effects)
    for a in args do
      collect_effects_from_expr(&a, effects)
    end

  when ExprKind::ExprMethodCall(recv, method, _, args) then
    match recv.kind
    when ExprKind::ExprPath(path) then
      let recv_joined = join_vec_strings(&path.segments, "::")
      match maybe_effect_from_method_call(recv_joined, method)
      when Option::Some(effect_id) then push_effect_once(effects, effect_id)
      when Option::None then ()
      end
    when _ then ()
    end
    match maybe_effect_from_name(method)
    when Option::Some(fallback_effect) then push_effect_once(effects, fallback_effect)
    when Option::None then ()
    end
    collect_effects_from_expr(&recv, effects)
    for a in args do
      collect_effects_from_expr(&a, effects)
    end

  when ExprKind::ExprBinaryOp(_, left, right) then
    collect_effects_from_expr(&left, effects)
    collect_effects_from_expr(&right, effects)

  when ExprKind::ExprUnaryOp(_, inner) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprFieldAccess(recv, _) then
    collect_effects_from_expr(&recv, effects)

  when ExprKind::ExprIndex(recv, index) then
    collect_effects_from_expr(&recv, effects)
    collect_effects_from_expr(&index, effects)

  when ExprKind::ExprAccess(inner) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprRawDeref(inner) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprArrayLit(elems) then
    for e in elems do
      collect_effects_from_expr(&e, effects)
    end

  when ExprKind::ExprTupleLit(elems) then
    for e in elems do
      collect_effects_from_expr(&e, effects)
    end

  when ExprKind::ExprMapLit(entries) then
    for entry in entries do
      let k = entry.0
      let v = entry.1
      collect_effects_from_expr(&k, effects)
      collect_effects_from_expr(&v, effects)
    end

  when ExprKind::ExprStructLit(_, fields) then
    for entry in fields do
      let val = entry.1
      collect_effects_from_expr(&val, effects)
    end

  when ExprKind::ExprClosure(_, _, body) then
    collect_effects_from_expr(&body, effects)

  when ExprKind::ExprIf(if_stmt) then
    collect_effects_from_expr(&if_stmt.cond, effects)
    collect_effects_from_block(&if_stmt.then_block, effects)
    for entry in if_stmt.elsif_branches do
      let elsif_cond = entry.0
      let elsif_block = entry.1
      collect_effects_from_expr(&elsif_cond, effects)
      collect_effects_from_block(&elsif_block, effects)
    end
    match if_stmt.else_block
    when Option::Some(else_block) then collect_effects_from_block(&else_block, effects)
    when Option::None then ()
    end

  when ExprKind::ExprMatch(m) then
    collect_effects_from_expr(&m.scrutinee, effects)
    for arm in m.arms do
      match arm.guard_expr
      when Option::Some(g) then collect_effects_from_expr(&g, effects)
      when Option::None then ()
      end
      collect_effects_from_block(&arm.body, effects)
    end

  when ExprKind::ExprBlock(block) then
    collect_effects_from_block(&block, effects)

  when ExprKind::ExprAsync(block) then
    collect_effects_from_block(&block, effects)

  when ExprKind::ExprAwait(inner) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprTry(inner) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprRange(start_opt, end_opt, _) then
    match start_opt
    when Option::Some(start_expr) then collect_effects_from_expr(&start_expr, effects)
    when Option::None then ()
    end
    match end_opt
    when Option::Some(end_expr) then collect_effects_from_expr(&end_expr, effects)
    when Option::None then ()
    end

  when ExprKind::ExprCast(inner, _) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprTypeCheck(inner, _) then
    collect_effects_from_expr(&inner, effects)

  when ExprKind::ExprComptime(block) then
    collect_effects_from_block(&block, effects)

  when ExprKind::ExprEnumVariant(_, args) then
    for a in args do
      collect_effects_from_expr(&a, effects)
    end

  when ExprKind::ExprAssign(target, value) then
    collect_effects_from_expr(&target, effects)
    collect_effects_from_expr(&value, effects)

  when ExprKind::ExprPipe(left, right) then
    collect_effects_from_expr(&left, effects)
    collect_effects_from_expr(&right, effects)

  when _ then ()
  end
end

# Check whether a function's body contains any unsafe blocks.
def function_has_unsafe(func: FunctionDecl) -> Bool
  match func.body
  when FnBody::FnBlock(block) then
    block_has_unsafe(&block)
  when _ then false
  end
end

def block_has_unsafe(block: Block) -> Bool
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtExpr(expr) then
      if expr_has_unsafe(&expr) then return true end
    when _ then ()
    end
  end
  false
end

def expr_has_unsafe(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprUnsafe(_, _) then true
  when ExprKind::ExprBlock(b) then block_has_unsafe(&b)
  when ExprKind::ExprIf(if_stmt) then
    if expr_has_unsafe(&if_stmt.cond) then return true end
    if block_has_unsafe(&if_stmt.then_block) then return true end
    match if_stmt.else_block
    when Option::Some(eb) then block_has_unsafe(&eb)
    when Option::None then false
    end
  when _ then false
  end
end

# Walk an entire program and produce a mapping from function name to
# its extracted capabilities.  This is the main public entry point
# for capability analysis.
pub def check_program_capabilities(program: Program) -> Map[String, CapExtractResult]
  mut results = Map::new()

  # First pass: collect each function's own caps (no transitive yet)
  mut direct_caps: Map[String, Set[String]] = Map::new()
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(func) then
      let empty_callee_caps: Vec[Set[String]] = Vec::new()
      let caps = analyze_function_caps(&func, &item.attrs, &empty_callee_caps)
      # Merge direct + effects into one set for transitive resolution
      let merged = Set::new()
      for c in caps.direct do merged.insert(c) end
      for c in caps.from_effects do merged.insert(c) end
      direct_caps.insert(func.name.clone(), merged)
    when _ then ()
    end
  end

  # Second pass: resolve transitive capabilities from callees
  for item in program.items do
    match item.kind
    when ItemKind::ItemFunction(func) then
      # Collect callee caps from direct_caps of called functions
      mut callee_caps_list: Vec[Set[String]] = Vec::new()
      let callees = collect_callees_from_function(&func)
      for callee_name in callees do
        match direct_caps.get(&callee_name)
        when Option::Some(caps) then callee_caps_list.push(caps.clone())
        when Option::None then ()
        end
      end

      let full_caps = analyze_function_caps(&func, &item.attrs, &callee_caps_list)
      results.insert(func.name.clone(), full_caps)
    when _ then ()
    end
  end

  results
end

# Collect names of functions called from within a function body.
def collect_callees_from_function(func: FunctionDecl) -> Vec[String]
  mut callees = Vec::new()
  match func.body
  when FnBody::FnBlock(block) then
    collect_callees_from_block(&block, &mut callees)
  when _ then ()
  end
  callees
end

def collect_callees_from_block(block: Block, inout callees: Vec[String]) -> Unit
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtExpr(expr) then
      collect_callees_from_expr(&expr, callees)
    when StmtKind::StmtLet(_, _, init, _) then
      collect_callees_from_expr(&init, callees)
    when _ then ()
    end
  end
end

def collect_callees_from_expr(expr: Expr, inout callees: Vec[String]) -> Unit
  match expr.kind
  when ExprKind::ExprCall(callee, args) then
    match callee.kind
    when ExprKind::ExprIdent(name) then
      ## Filter out type constructors: in Tangerine, types are PascalCase,
      ## functions are snake_case. A PascalCase call is a struct/enum constructor.
      if !name.is_empty() && !name.char_at(0).is_uppercase() then
        callees.push(name.clone())
      end
    when _ then ()
    end
    for a in args do
      collect_callees_from_expr(&a, callees)
    end
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    collect_callees_from_expr(&recv, callees)
    for a in args do
      collect_callees_from_expr(&a, callees)
    end
  when ExprKind::ExprBlock(b) then
    collect_callees_from_block(&b, callees)
  when _ then ()
  end
end

# ═══════════════════════════════════════════════════════════════
# §72 — Drift Detection (CP-1)
# ═══════════════════════════════════════════════════════════════

# Drift = current_caps − baseline_caps
# Emit CP-1 if drift non-empty
# Severity: |drift| / max(|drift|, n_cap_max) where n_cap_max = 10

struct DriftResult
  symbol_id: String
  new_caps: Vec[String]
  removed_caps: Vec[String]
  severity: Float
  has_drift: Bool
end

def detect_drift(
  symbol_id: String,
  current_caps: Set[String],
  baseline_caps: Set[String]
) -> DriftResult
  let new_caps = Vec::new()
  let removed_caps = Vec::new()

  for cap in current_caps
    if !baseline_caps.contains(cap)
      new_caps.push(cap)
    end
  end
  for cap in baseline_caps
    if !current_caps.contains(cap)
      removed_caps.push(cap)
    end
  end

  let n_cap_max = 10
  let drift_count = new_caps.len()
  let severity = if drift_count > 0
    to_float(drift_count) / to_float(max_int(drift_count, n_cap_max))
  else
    0.0
  end

  DriftResult {
    symbol_id: symbol_id,
    new_caps: new_caps,
    removed_caps: removed_caps,
    severity: severity,
    has_drift: drift_count > 0
  }
end

# ═══════════════════════════════════════════════════════════════
# §73 — Baseline Lifecycle Rules
# ═══════════════════════════════════════════════════════════════

# §73.1 — Blessing: only updated by tg quality --bless or tg release
# --bless requires clean build + tests + optional approval token

struct BlessConfig
  require_clean_tree: Bool
  require_passing_tests: Bool
  require_approval_token: Bool
  allow_dirty: Bool
end

def default_bless_config() -> BlessConfig
  BlessConfig {
    require_clean_tree: true,
    require_passing_tests: true,
    require_approval_token: false,
    allow_dirty: false
  }
end

# §73.2 — Matching: same edition, same target, compatible tgc_version
def baseline_compatible(baseline: CapBaseline, edition: String, target: String, tgc_version: String) -> Bool
  baseline.edition == edition && baseline.target == target && baseline.tgc_version == tgc_version
end

# §73.3 — Multi-target: separate baseline per target
#.tg_capability_baseline.<target>.json
def baseline_path(target: String) -> String
  ".tg_capability_baseline." + target + ".json"
end

# ═══════════════════════════════════════════════════════════════
# §74 — Integration with tg quality
# ═══════════════════════════════════════════════════════════════

# Consumes: symbol graph + CQS signals + optional coverage + optional baseline
# If coverage missing: CV signals omitted, marked available=false
# If baseline missing: CP-1 omitted, marked baseline_available=false

struct QualityIntegration
  coverage_available: Bool
  baseline_available: Bool
  coverage_path: Option[String]
  baseline_path: Option[String]
end

def resolve_integration(
  coverage_dir: Option[String],
  baseline_dir: Option[String],
  target: String
) -> QualityIntegration
  let cov_path = match coverage_dir
  when Option::Some(dir) then
    let path = dir + "/coverage.merged.tgcov"
    Option::Some(path)
  when Option::None then Option::None
  end

  let bl_path = match baseline_dir
  when Option::Some(dir) then
    let path = dir + "/.tg_capability_baseline." + target + ".json"
    Option::Some(path)
  when Option::None then Option::None
  end

  QualityIntegration {
    coverage_available: cov_path.is_some(),
    baseline_available: bl_path.is_some(),
    coverage_path: cov_path,
    baseline_path: bl_path
  }
end

