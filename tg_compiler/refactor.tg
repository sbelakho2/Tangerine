## Tangerine Compiler — Semantic Refactor Primitives
##
## §15: `tg refactor rename`, `tg refactor extract`
## The compiler guarantees correctness or refuses. No silent breakage.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{read_file}
use tg_compiler::ast::{
  Expr, Stmt, Item, ItemKind, FunctionDecl, TypeExpr, Block, Span, PatternKind
}
use tg_compiler::resolver::{ResolvedSymbol, ScopeMap, Binding}
use tg_compiler::symbol_graph::{SymbolGraph, GraphKind}
use tg_compiler::types::{Type, TypeId, TypeEnv}

# ═══════════════════════════════════════════════════════════════
# §15.1 — Refactor Kinds
# ═══════════════════════════════════════════════════════════════

enum RefactorKind
  Rename
  ExtractFunction
  ExtractVariable
  InlineVariable
  InlineFunction
  MoveItem
end

# ═══════════════════════════════════════════════════════════════
# §15.2 — Refactor Request & Result
# ═══════════════════════════════════════════════════════════════

struct RefactorRequest
  kind: RefactorKind
  target_span: Span             # What to refactor
  new_name: Option[String]      # For rename, extract
  destination: Option[String]   # For move: module path
end

struct RefactorResult
  success: Bool
  edits: Vec[TextEdit]
  diagnostics: Vec[RefactorDiagnostic]
  affected_files: Vec[String]
  requires_recheck: Bool
end

struct TextEdit
  file: String
  start: Int
  end_pos: Int
  new_text: String
end

enum RefactorSeverity
  Error     # Cannot proceed
  Warning   # Proceeds but user should review
  Info      # Informational
end

struct RefactorDiagnostic
  severity: RefactorSeverity
  message: String
  span: Option[Span]
end

# ═══════════════════════════════════════════════════════════════
# §15.3 — Rename Refactoring
# ═══════════════════════════════════════════════════════════════

## `tg refactor rename` — rename a symbol everywhere it's referenced.
## Refuses if:
##   - New name collides in any scope
##   - Symbol is from extern/FFI (name matters)
##   - Symbol is a public API in Production mode (unless --force)

def refactor_rename(
  symbol: &ResolvedSymbol,
  new_name: String,
  scope_map: &ScopeMap,
  graph: &SymbolGraph,
  pub_api: Bool
) -> RefactorResult
  let edits = Vec::new()
  let diagnostics = Vec::new()

  # Reject renaming to a language keyword
  if _is_keyword(&new_name) then
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot rename to '" + new_name + "': it is a reserved keyword",
        span: Option::None
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  # Check for name collisions in all scopes
  for scope in scope_map.scopes_containing(symbol.id) do
    if scope.has_binding(new_name)
      return RefactorResult {
        success: false,
        edits: Vec::new(),
        diagnostics: vec![RefactorDiagnostic {
          severity: RefactorSeverity::Error,
          message: "Name '" + new_name + "' already exists in scope at "
                   + scope.span.to_string(),
          span: Option::Some(scope.span)
        }],
        affected_files: Vec::new(),
        requires_recheck: false
      }
    end
  end

  # Check for extern symbols
  if symbol.is_extern
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot rename extern symbol '" + symbol.name
                 + "': FFI name is significant",
        span: Option::Some(symbol.def_span)
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  # Check pub API in Production
  if pub_api
    diagnostics.push(RefactorDiagnostic {
      severity: RefactorSeverity::Warning,
      message: "Renaming public API symbol '" + symbol.name
               + "' in Production mode. This is a breaking change.",
      span: Option::Some(symbol.def_span)
    })
  end

  # Collect all references
  let refs = graph.query_all_references(symbol.id.to_string())
  let files_changed = Set::new()

  # Create edit for definition
  edits.push(TextEdit {
    file: symbol.def_span.file,
    start: symbol.def_span.start,
    end_pos: symbol.def_span.end_pos,
    new_text: new_name
  })
  files_changed.insert(symbol.def_span.file)

  # Create edits for all references
  for ref_span in &refs do
    edits.push(TextEdit {
      file: ref_span.file,
      start: ref_span.start,
      end_pos: ref_span.end_pos,
      new_text: new_name
    })
    files_changed.insert(ref_span.file)
  end

  RefactorResult {
    success: true,
    edits: edits,
    diagnostics: diagnostics,
    affected_files: files_changed.into_vec(),
    requires_recheck: true
  }
end

# ═══════════════════════════════════════════════════════════════
# §15.4 — Extract Function
# ═══════════════════════════════════════════════════════════════

## `tg refactor extract` — extract selected code into a new function.
## Refuses if:
##   - Selection contains partial control flow (break/continue across boundary)
##   - Selection has multiple live-out variables with no struct wrapper
##   - Selection has complex borrow interactions that can't be serialized

struct ExtractedFunction
  name: String
  params: Vec[ExtractedParam]
  return_type: Option[TypeExpr]
  body: Block
  effects: Vec[String]
  capabilities: Vec[String]
end

struct ExtractedParam
  name: String
  typ: TypeExpr
  is_mut: Bool
  is_ref: Bool
end

def refactor_extract_function(
  selection_span: Span,
  new_name: String,
  stmts: &Vec[Stmt],
  type_env: &TypeEnv,
  scope: &ScopeMap
) -> RefactorResult
  let diagnostics = Vec::new()

  # Identify selected statements
  let selected = stmts.iter()
    .filter(|s| span_contains(selection_span, s.span))
    .collect()

  if selected.is_empty()
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "No complete statements in selection",
        span: Option::Some(selection_span)
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  # Check control flow integrity: no partial break/continue/return
  let cf_check = check_control_flow_integrity(&selected)
  if !cf_check.ok
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot extract: " + cf_check.reason,
        span: cf_check.span
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  # Compute live-in and live-out variables
  let live_in = compute_live_in(&selected, scope)
  let live_out = compute_live_out(&selected, scope)

  # Refuse if too many live-out vars
  if live_out.len() > 3
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot extract: " + live_out.len().to_string()
                 + " live-out variables (max 3). Consider creating a struct.",
        span: Option::Some(selection_span)
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  # Build parameter list from live-in
  let params = Vec::new()
  for live_var in &live_in do
    let typ = type_env.lookup(live_var.type_id)
    params.push(ExtractedParam {
      name: live_var.name,
      typ: typ.to_type_expr(),
      is_mut: live_var.is_mutated_in(&selected),
      is_ref: !typ.is_copy()
    })
  end

  # Build return type from live-out
  let return_type = if live_out.is_empty()
    Option::None
  elsif live_out.len() == 1
    Option::Some(type_env.lookup(live_out[0].type_id).to_type_expr())
  else
    # Construct a tuple type
    let fields = live_out.iter()
      .map(|v| type_env.lookup(v.type_id).to_type_expr())
      .collect()
    Option::Some(TypeExpr::Tuple(fields))
  end

  # Generate edits: Insert function + Replace selection with call
  let file = selection_span.file
  let edits = Vec::new()
  let insert_pos = find_enclosing_function_end(selection_span)

  # Insert the new function after the current function
  let fn_text = generate_function_text(new_name, &params, &return_type, &selected)
  edits.push(TextEdit {
    file: file,
    start: insert_pos,
    end_pos: insert_pos,
    new_text: "\n\n" + fn_text
  })

  # Replace selection with call
  let call_text = generate_call_text(new_name, &params, &live_out)
  edits.push(TextEdit {
    file: file,
    start: selection_span.start,
    end_pos: selection_span.end_pos,
    new_text: call_text
  })

  RefactorResult {
    success: true,
    edits: edits,
    diagnostics: diagnostics,
    affected_files: vec![file],
    requires_recheck: true
  }
end

# ═══════════════════════════════════════════════════════════════
# §15.5 — Inline Variable / Inline Function
# ═══════════════════════════════════════════════════════════════

def refactor_inline_variable(
  binding: &Binding,
  scope: &ScopeMap,
  graph: &SymbolGraph
) -> RefactorResult
  # Inline is only safe if:
  # - Variable is assigned exactly once
  # - Initializer has no side effects
  # - All uses see the same value (no mutation between def and use)
  let diagnostics = Vec::new()

  if binding.assignment_count != 1
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot inline: variable '" + binding.name
                 + "' is assigned " + binding.assignment_count.to_string()
                 + " times (need exactly 1)",
        span: Option::Some(binding.def_span)
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  if binding.initializer_has_side_effects
    return RefactorResult {
      success: false,
      edits: Vec::new(),
      diagnostics: vec![RefactorDiagnostic {
        severity: RefactorSeverity::Error,
        message: "Cannot inline: initializer of '" + binding.name
                 + "' has side effects",
        span: Option::Some(binding.def_span)
      }],
      affected_files: Vec::new(),
      requires_recheck: false
    }
  end

  let refs = graph.query_all_references(binding.symbol_id)
  let edits = Vec::new()
  let init_text = binding.initializer_text

  # Replace each use with the initializer
  for ref_span in &refs do
    edits.push(TextEdit {
      file: ref_span.file,
      start: ref_span.start,
      end_pos: ref_span.end_pos,
      new_text: "(" + init_text + ")"
    })
  end

  # Remove the variable declaration
  edits.push(TextEdit {
    file: binding.def_span.file,
    start: binding.stmt_span.start,
    end_pos: binding.stmt_span.end_pos,
    new_text: ""
  })

  RefactorResult {
    success: true,
    edits: edits,
    diagnostics: diagnostics,
    affected_files: vec![binding.def_span.file],
    requires_recheck: true
  }
end

# ═══════════════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════════════

struct ControlFlowCheck
  ok: Bool
  reason: String
  span: Option[Span]
end

def check_control_flow_integrity(stmts: &Vec[&Stmt]) -> ControlFlowCheck
  ## Check for break/continue/return that would escape the extraction boundary
  ## Recurses into nested blocks (if/else, for, while, match, block)
  for stmt in stmts do
    let result = _check_cf_stmt(stmt, stmts)
    if !result.ok then
      return result
    end
  end
  ControlFlowCheck { ok: true, reason: "", span: Option::None }
end

def _check_cf_stmt(stmt: &Stmt, selection: &Vec[&Stmt]) -> ControlFlowCheck
  match stmt.kind
    when StmtKind::StmtBreak(_) then
      return ControlFlowCheck {
        ok: false,
        reason: "break targets a loop outside selection",
        span: Option::Some(stmt.span)
      }
    when StmtKind::StmtContinue then
      return ControlFlowCheck {
        ok: false,
        reason: "continue targets a loop outside selection",
        span: Option::Some(stmt.span)
      }
    when StmtKind::StmtReturn(_) then
      return ControlFlowCheck {
        ok: false,
        reason: "return statement would change function semantics",
        span: Option::Some(stmt.span)
      }
    when StmtKind::StmtIf(if_stmt) then
      for s in &if_stmt.then_block.stmts do
        let r = _check_cf_stmt(s, selection)
        if !r.ok then return r end
      end
      match if_stmt.else_block
      when Option::Some(else_blk) then
        for s in &else_blk.stmts do
          let r = _check_cf_stmt(s, selection)
          if !r.ok then return r end
        end
      when Option::None then ()
      end
    when StmtKind::StmtFor(for_stmt) then
      for s in for_stmt.body.stmts do
        let r = _check_cf_stmt(s, selection)
        if !r.ok then return r end
      end
    when StmtKind::StmtWhile(_, body) then
      for s in body.stmts do
        let r = _check_cf_stmt(s, selection)
        if !r.ok then return r end
      end
    when StmtKind::StmtMatch(match_expr) then
      for arm in &match_expr.arms do
        for s in &arm.body.stmts do
          let r = _check_cf_stmt(s, selection)
          if !r.ok then return r end
        end
      end
    else ()
  end
  ControlFlowCheck { ok: true, reason: "", span: Option::None }
end

def compute_live_in(stmts: &Vec[&Stmt], scope: &ScopeMap) -> Vec[Binding]
  # Variables read in stmts that are defined outside
  let used = collect_used_variables(stmts)
  let defined = collect_defined_variables(stmts)
  used.iter().filter(|v| !defined.contains(v.name)).collect()
end

def compute_live_out(stmts: &Vec[&Stmt], scope: &ScopeMap) -> Vec[Binding]
  # Variables defined in stmts that are used after
  let defined = collect_defined_variables(stmts)
  defined.iter().filter(|v| scope.has_uses_after(v, stmts)).collect()
end

def span_contains(outer: Span, inner: Span) -> Bool
  outer.file == inner.file && outer.start <= inner.start && inner.end_pos <= outer.end_pos
end

def generate_function_text(
  name: String,
  params: &Vec[ExtractedParam],
  ret: &Option[TypeExpr],
  stmts: &Vec[&Stmt]
) -> String
  mut s = "def " + name + "("
  for i in 0..params.len() do
    if i > 0 then s = s + ", " end
    let p = &params[i]
    if p.is_ref then s = s + "&" end
    if p.is_mut then s = s + "mut " end
    s = s + p.name + ": " + p.typ.to_string()
  end
  s = s + ")"
  match ret
    when Option::Some(t) then s = s + " -> " + t.to_string()
    when Option::None then ()
  end
  s = s + "\n"
  for stmt in stmts do
    s = s + "  " + stmt.to_source() + "\n"
  end
  s = s + "end"
  s
end

def generate_call_text(
  name: String,
  params: &Vec[ExtractedParam],
  live_out: &Vec[Binding]
) -> String
  mut call = name + "("
  for i in 0..params.len() do
    if i > 0 then call = call + ", " end
    if params[i].is_mut then call = call + "&mut " end
    call = call + params[i].name
  end
  call = call + ")"

  if live_out.is_empty()
    call
  elsif live_out.len() == 1
    "let " + live_out[0].name + " = " + call
  else
    let names = live_out.iter().map(|v| v.name).collect()
    "let (" + names.join(", ") + ") = " + call
  end
end

def find_enclosing_function_end(span: Span) -> Int
  # Walk the source forward from span.end_pos to find the matching `end` keyword.
  # We track nesting depth: block-opening keywords increase depth, `end` decreases it.
  # When depth reaches 0 we've found the enclosing function's `end`.
  mut depth = 1
  mut pos = span.end_pos
  let source = match read_file(span.file.clone())
  when Result::Ok(content) then content
  when Result::Err(_) then
    return span.end_pos
  end

  while pos < source.len() do
    # Skip string literals so we don't confuse keywords inside strings
    if pos < source.len() && source.char_at(pos) == '"' then
      pos = pos + 1
      while pos < source.len() && source.char_at(pos) != '"' do
        if source.char_at(pos) == '\\' then
          pos = pos + 1  # skip escaped character
        end
        pos = pos + 1
      end
      if pos < source.len() then pos = pos + 1 end
      next
    end

    # Skip single-line comments
    if pos + 1 < source.len() && source.char_at(pos) == '#' then
      while pos < source.len() && source.char_at(pos) != '\n' do
        pos = pos + 1
      end
      next
    end

    # Try to match a keyword at the current position. Only match whole words
    # (preceded and followed by a non-identifier character).
    let before_ok = pos == 0 || !is_ident_char_refactor(source.char_at(pos - 1))

    if before_ok then
      # Block-opening keywords that require a matching `end`
      let openers = ["def", "do", "if", "unless", "match", "while", "until", "for", "loop",
                      "struct", "enum", "impl", "trait", "module", "unsafe"]
      mut matched_opener = false
      for kw in openers do
        let kw_len = kw.len()
        if pos + kw_len <= source.len() then
          let slice = source.slice(pos, pos + kw_len)
          if slice == kw then
            let after_pos = pos + kw_len
            let after_ok = after_pos >= source.len() || !is_ident_char_refactor(source.char_at(after_pos))
            if after_ok then
              depth = depth + 1
              pos = after_pos
              matched_opener = true
              break
            end
          end
        end
      end
      if matched_opener then next end

      # Check for `end`
      if pos + 3 <= source.len() then
        let maybe_end = source.slice(pos, pos + 3)
        if maybe_end == "end" then
          let after_pos = pos + 3
          let after_ok = after_pos >= source.len() || !is_ident_char_refactor(source.char_at(after_pos))
          if after_ok then
            depth = depth - 1
            if depth == 0 then
              return after_pos
            end
            pos = after_pos
            next
          end
        end
      end
    end

    pos = pos + 1
  end

  # If we ran off the end of the file, return the file length
  source.len()
end

def is_ident_char_refactor(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
end

def label_target_in_selection(label: Option[String], stmts: &Vec[&Stmt]) -> Bool
  # Check if a break/next label's target loop is within the selected statements
  match label
  when Option::None then true  # Unlabeled — targets nearest loop which is presumably selected
  when Option::Some(lbl) then
    let _ = lbl
    for stmt in stmts do
      match stmt.kind
      when StmtKind::StmtLoop(_) then return false
      when StmtKind::StmtWhile(_, _) then return false
      when StmtKind::StmtFor(_) then return false
      when _ then ()
      end
    end
    false
  end
end

def collect_used_variables(stmts: &Vec[&Stmt]) -> Vec[Binding]
  # Collect all variable names that are referenced within the given statements
  mut used = Vec::new()
  mut seen = Set::new()
  for stmt in stmts do
    let vars = extract_referenced_names(stmt)
    for v in vars do
      if !seen.contains(&v.name) then
        seen.insert(v.name.clone())
        used.push(v)
      end
    end
  end
  used
end

def collect_defined_variables(stmts: &Vec[&Stmt]) -> Vec[Binding]
  # Collect all variable names that are defined (let/mut) within the given statements
  mut defined = Vec::new()
  for stmt in stmts do
    match stmt.kind
    when StmtKind::StmtLet(pattern, _, _, _) then
      match pattern.kind
      when PatternKind::Ident(name, _) then
        defined.push(Binding {
          name: name.clone(),
          symbol_id: name.clone(),
          def_span: stmt.span,
          stmt_span: stmt.span,
          assignment_count: 1,
          initializer_has_side_effects: false,
          initializer_text: "".to_string()
        })
      when _ then ()
      end
    when _ then ()
    end
  end
  defined
end

def extract_referenced_names(stmt: &Stmt) -> Vec[Binding]
  # Simple extraction of variable name references from a statement
  mut refs = Vec::new()
  match stmt.kind
  when StmtKind::StmtExpr(e) then
    collect_expr_refs(e, &mut refs)
  when StmtKind::StmtLet(_, _, init, _) then
    collect_expr_refs(init, &mut refs)
  when _ then ()
  end
  refs
end

def collect_expr_refs(expr: &Expr, out: &mut Vec[Binding]) -> Unit
  match expr.kind
  when ExprKind::ExprIdent(name) then
    out.push(Binding {
      name: name.clone(),
      symbol_id: name.clone(),
      def_span: expr.span,
      stmt_span: expr.span,
      assignment_count: 0,
      initializer_has_side_effects: false,
      initializer_text: "".to_string()
    })
  when ExprKind::ExprCall(callee, args) then
    collect_expr_refs(callee, out)
    for arg in args do
      collect_expr_refs(arg, out)
    end
  when ExprKind::ExprFieldAccess(recv, _) then
    collect_expr_refs(recv, out)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    collect_expr_refs(recv, out)
    for arg in args do
      collect_expr_refs(arg, out)
    end
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    collect_expr_refs(lhs, out)
    collect_expr_refs(rhs, out)
  when ExprKind::ExprUnaryOp(_, inner) then
    collect_expr_refs(inner, out)
  when ExprKind::ExprIf(if_stmt) then
    collect_expr_refs(&if_stmt.cond, out)
  when _ then ()
  end
end

def _is_keyword(name: &str) -> Bool
  name == "def" || name == "let" || name == "mut" || name == "if" || name == "then"
    || name == "else" || name == "elsif" || name == "end" || name == "match"
    || name == "when" || name == "for" || name == "in" || name == "while"
    || name == "do" || name == "loop" || name == "break" || name == "next"
    || name == "return" || name == "struct" || name == "enum" || name == "trait"
    || name == "impl" || name == "module" || name == "use" || name == "pub"
    || name == "true" || name == "false" || name == "nil" || name == "self"
    || name == "as" || name == "is" || name == "and" || name == "or"
    || name == "not" || name == "type" || name == "fn" || name == "const"
    || name == "static" || name == "unsafe" || name == "extern" || name == "async"
    || name == "await" || name == "yield" || name == "move" || name == "copy"
    || name == "ref" || name == "where" || name == "super" || name == "import"
end
