# ———————————————————————————————————————————————————————————————
# The edit vocabulary
# ———————————————————————————————————————————————————————————————

# One semantic edit request (audit item 53). Every payload is a CANONICAL
# stable key / row text / source fragment — never a dense id:
#   ReplaceCall      — the call ROW key ("caller|callee|kind") + the new
#                      callee key text.
#   InsertStatement  — the function stable key, the statement anchor the
#                      new statement is inserted BEFORE — the HIR anchor
#                      "<fn key>#H<node id>" (P0-14; resolved by the AST
#                      walk) or a §33 MIR locator "<fn key>#B<block>#S<idx>"
#                      (resolved only through an explicit MirOrigin) — and
#                      the statement source text.
#   ChangeContract   — the StableContractId.stable_key of the clause row +
#                      the new canonical expression text ("op(arg,...)").
#   Rename           — the declaration stable key (or a unique bare /
#                      qualified name) + the new name.
#   ChangeSignature  — the declaration stable key (or unique name) + the
#                      new signature text.
#   FillHole         — the canonical hole key ("<fn key>#hole<n>") + the
#                      replacement expression source text.
enum SemanticEdit
  ReplaceCall(call_site_key: String, callee: String)
  InsertStatement(function_key: String, before_stmt_key: String, statement_text: String)
  ChangeContract(contract_id: String, new_expression_text: String)
  Rename(decl: String, new_name: String)
  ChangeSignature(decl: String, new_signature_text: String)
  FillHole(hole_key: String, expression_text: String)
end

# The RESOLVED edit: the typed index resolution of the target(s), the
# dependency-closure affected set, the resolved precondition facts and the
# delta rows the apply is expected to produce. All key lists are canonical
# texts (the protocol carrier domain).
struct ResolvedEdit
  edit: SemanticEdit
  targets: Vec[String] = Vec::new()
  affected: Vec[String] = Vec::new()
  # (fourth-audit P0-9) the completeness verdict of the affected closure:
  # "complete" / "partial" / "unavailable" plus the sorted relation-family
  # names whose producer knowledge was incomplete or absent. An unavailable
  # family contributes no affected entities and is reported here — the
  # closure never substitutes the caller closure for it.
  affected_completeness: String = "complete"
  missing_relations: Vec[String] = Vec::new()
  preconditions: Vec[String] = Vec::new()
  expected_delta: Vec[String] = Vec::new()
  # (P0-15) the planned write set (the identities the edit creates/updates;
  # for a rename the NEW stable key, for ReplaceCall the new call row key,
  # for the other source edits the target/row key). The actual-delta
  # comparison admits an actual row when its identity is named by one of
  # these sets; an under-planned edit is UnexpectedDelta.
  expected_write: Vec[String] = Vec::new()
  # (P0-15) the planned effect / ABI / public-api row sets. The reachable
  # front-end comparison emits no rows of these families (see the module
  # doc's library-boundary paragraph); the sets are carried so a caller
  # holding the full snapshot delta can compare the complete plan.
  expected_effect: Vec[String] = Vec::new()
  expected_abi: Vec[String] = Vec::new()
  expected_public_api: Vec[String] = Vec::new()
end

# The typed edit failure (no prose payloads; the precise remaining surface
# of an ApplyUnavailable rides semantic_edit_unavailable_reason):
#   TargetNotFound      — the referenced key/name matches no row.
#   AmbiguousTarget     — a bare/qualified NAME matches more than one row.
#   UnsupportedEdit     — the apply entry does not serve this edit kind
#                         (e.g. apply_fill_hole on a non-FillHole edit).
#   PreconditionFailed  — a resolved precondition is violated at apply time
#                         (a malformed canonical contract text; the patch
#                         node is not a hole).
#   ApplyUnavailable    — the edit resolves but has no apply surface in the
#                         current representation (the AST/HIR rewrite is
#                         named by semantic_edit_unavailable_reason).
#   AmbiguousSource     — a source anchor has no unique source insertion
#                         point (P0-14: a MIR-originated InsertStatement
#                         with no explicit MirOrigin entry, or an entry
#                         marked non-unique; the evidence text names the
#                         reason — desugared for/match, contract-generated
#                         MIR, nested block, multi-MIR-node expression).
#   UnexpectedDelta     — the applied edit's actual semantic delta carries
#                         rows outside the planned ResolvedEdit sets (or
#                         fails to produce a planned row): an edit failure
#                         even when the regenerated source compiles (P0-15).
enum EditError
  TargetNotFound
  AmbiguousTarget
  UnsupportedEdit
  PreconditionFailed
  ApplyUnavailable
  AmbiguousSource
  UnexpectedDelta
end

# The result of an applied edit. `applied` carries the canonical rows the
# apply actually produced; `snapshot` is the updated model for the
# snapshot-level applies (ChangeContract) and `delta` the §31 delta of the
# before/after pair (the real proof of application).
#
# (third-audit item 30) The SOURCE-EDIT pipeline fills the second half of
# the record: `resolved` carries the typed resolution the application was
# driven from, `edited_source` the regenerated source text, `parsed` /
# `revalidated` / `validation_detail` the front-end re-validation of the
# regenerated text, and `delta_rows` the expected §31 delta rows.
#
# (fourth-audit P0-15) The source entry now runs the delta comparison the
# caller's stage used to own: the reachable pre/post semantic rows are
# diffed into `actual_delta_rows`, compared against the planned
# ResolvedEdit sets (`delta_match`, `unexpected_rows`,
# `planned_unmatched_rows`), the ChangeBudget envelope is checked over the
# actual delta (`budget_result`) and the §37 proof summary is assembled
# (`proof_summary`). An actual row outside the plan (or a planned row the
# application did not produce) is EditError::UnexpectedDelta — an edit
# failure even when the regenerated source compiles. The finalized
# SemanticSnapshot builder additionally needs the MirProgram the lowering
# layer produces; this module's import surface stops at the front end, so
# the comparison runs over the reachable front-end rows (entity / signature
# / call / statement) and the effect/ABI/public-api planned sets ride
# ResolvedEdit for the caller that runs the full snapshot stage — the
# exact boundary, stated once in the module doc.
# The snapshot-level applies (ChangeContract) and the typed-program apply
# (FillHole) keep their original fields; the source pipeline leaves them
# None.
struct EditApplication
  edit: SemanticEdit
  applied: Vec[String] = Vec::new()
  snapshot: Option[SemanticSnapshot] = Option::None
  delta: Option[SemanticDelta] = Option::None
  resolved: Option[ResolvedEdit] = Option::None
  edited_source: String = ""
  parsed: Bool = false
  revalidated: Bool = false
  validation_detail: String = ""
  delta_rows: Vec[String] = Vec::new()
  # (P0-15) the actual-delta verification record: the reachable actual
  # delta rows (sorted canonical texts — entity-created/removed/
  # signature-changed, call-created/removed, stmt-inserted), whether the
  # actual rows match the planned sets, the unexpected actual rows, the
  # ChangeBudget envelope verdict lines over the actual delta and the §37
  # proof summary (the proven stage-field names, fixed pipeline order).
  actual_delta_rows: Vec[String] = Vec::new()
  delta_match: Bool = false
  unexpected_rows: Vec[String] = Vec::new()
  planned_unmatched_rows: Vec[String] = Vec::new()
  budget_result: Vec[String] = Vec::new()
  proof_summary: Vec[String] = Vec::new()
end

# ———————————————————————————————————————————————————————————————
# Resolution helpers over the typed index / snapshot
# ———————————————————————————————————————————————————————————————

# The name part of a stable def key (everything before "#signature").
def edit_name_part(key: String) -> String
  let i = edit_char_index(&key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

def edit_char_index(s: String, needle: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    if s.slice(i, i + 1) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# Resolve a declaration reference to its canonical full stable key: an exact
# full key (contains '#') must match a symbol row byte-for-byte; a bare /
# qualified NAME must match exactly one row's name / name-part (two matches
# are AmbiguousTarget, none TargetNotFound).
pub def edit_resolve_symbol_key(snapshot: SemanticSnapshot, decl: String) -> Result[String, EditError]
  if decl.contains("#") then
    for row in snapshot.symbols do
      if stable_key_eq(row.stable_id.key, decl) then
        return Result::Ok(row.stable_id.key.clone())
      end
    end
    return Result::Err(EditError::TargetNotFound)
  end
  var matches: Vec[String] = Vec::new()
  for row in snapshot.symbols do
    let name_part = edit_name_part(&row.stable_id.key)
    if row.name == decl || name_part == decl then
      if !matches.contains(&row.stable_id.key) then
        matches.push(row.stable_id.key.clone())
      end
    end
  end
  if matches.len() == 0 then
    return Result::Err(EditError::TargetNotFound)
  end
  if matches.len() > 1 then
    return Result::Err(EditError::AmbiguousTarget)
  end
  Result::Ok(matches[0].clone())
end

# The contract row of a StableContractId.stable_key (Option::None = absent).
def edit_find_contract(snapshot: SemanticSnapshot, contract_id: String) -> Option[ContractFact]
  for c in snapshot.contracts do
    if stable_key_eq(c.id.stable_key, contract_id) then
      return Option::Some(c)
    end
  end
  Option::None
end

# The canonical §31 call-row key of a CallEdge ("caller|callee|<digit>" —
# the delta's delta_call_row_key grammar; the digit authority is
# semantic_call_edge_kind_numeric).
def edit_call_row_key(c: CallEdge) -> String
  c.caller.key.clone() + "|" + c.callee.key.clone() + "|" +
    semantic_call_edge_kind_numeric(&c.kind).to_string()
end

# The call row whose canonical key equals call_site_key: the key must parse
# as a "call" StableRowKey AND a CallEdge row must reproduce it exactly.
def edit_find_call(snapshot: SemanticSnapshot, call_site_key: String) -> Option[CallEdge]
  match stable_row_key_of(call_site_key.clone())
  when Option::Some(rk) then
    if rk.domain != "call" then
      return Option::None
    end
  when Option::None then
    return Option::None
  end
  for c in snapshot.calls do
    if stable_key_eq(edit_call_row_key(c.clone()), call_site_key) then
      return Option::Some(c)
    end
  end
  Option::None
end

# The contract kind word of the row key grammar.
def edit_contract_kind_word(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The default dependency-closure kinds (the data-bearing classes; the
# no-row classes are covered by the call closure — see the module doc).
pub def semantic_edit_default_kinds() -> Vec[DependencyEdgeKind]
  var kinds: Vec[DependencyEdgeKind] = Vec::new()
  kinds.push(DependencyEdgeKind::Call)
  kinds.push(DependencyEdgeKind::EffectPropagation)
  kinds.push(DependencyEdgeKind::CapabilityPropagation)
  kinds.push(DependencyEdgeKind::Implements)
  kinds.push(DependencyEdgeKind::ContainsType)
  kinds.push(DependencyEdgeKind::AbiConsumer)
  kinds.push(DependencyEdgeKind::ContractReferences)
  kinds.push(DependencyEdgeKind::TestReferences)
  kinds
end

# The affected closure of one seed key: a one-seed delta walked through
# affected_closure over the default kinds. The seed itself is included (the
# closure's own contract). The returned AffectedResult carries the typed
# completeness verdict (fourth-audit P0-9): an unavailable relation family
# is reported in missing_relations, never substituted by the caller
# closure.
pub def edit_seed_affected(snapshot: SemanticSnapshot, index: SemanticIndex, seed: String) -> AffectedResult
  var d = semantic_delta_empty()
  d.created = Vec::from([seed])
  affected_closure(&d, &snapshot, &index, semantic_edit_default_kinds())
end

# The row whose text starts with prefix (helper for the lane rows).
def edit_rows_with_prefix(rows: Vec[String], prefix: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for r in rows do
    if r.starts_with(prefix.clone()) then
      out.push(r.clone())
    end
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Resolver identity accessors (fourth-audit P0-13)
# ———————————————————————————————————————————————————————————————
# The edit pipeline runs resolve_names over the parsed source and carries
# the ResolvedNames snapshot through every rewrite. A reference's identity
# is the resolver DefId's REGISTRATION KEY (the module_symbols key the
# DefId was registered under — module path + declared name). Two
# references to same-spelled declarations in different modules carry
# different registration keys, and a reference to a local carries no
# declaration key at all (LocalVar/Parameter — the binder's LocalId), so
# the comparison is never a spelling comparison.

# DefId equality is (module id, index) — the ids.tg contract (DefId
# carries no kind).
pub def edit_def_id_eq(a: DefId, b: DefId) -> Bool
  a.module.id == b.module.id && a.index == b.index
end

# The registration key ("path::name") of a resolver DefId: the reverse
# module_symbols lookup. Option::None when the DefId registered no symbol
# (a synthetic/intrinsic id, a recovery id) — an unregistered reference is
# never identity-matched.
pub def edit_reg_key_of_def(res: ResolvedNames, did: DefId) -> Option[String]
  for entry in res.module_symbols.entries() do
    if edit_def_id_eq(&entry.1, &did) then
      return Option::Some(entry.0.clone())
    end
  end
  Option::None
end

# The resolved declaration registration key of an expression node:
# call_targets first (the resolver keys every resolved callable at the
# callee / ident / path node id), then the ResolvedExpr kind for the
# non-call reference forms. Local binders and unresolved references
# return Option::None — they can never equal a declaration target.
pub def edit_ref_reg_key(res: ResolvedNames, node_id: Int) -> Option[String]
  match res.call_targets.get(node_id)
  when Option::Some(did) then edit_reg_key_of_def(&res, did)
  when Option::None then
    match res.expr_resolutions.get(node_id)
    when Option::Some(re) then
      match re.kind
      when ResolvedExprKind::Function(did) then edit_reg_key_of_def(&res, did)
      when ResolvedExprKind::Method(did) then edit_reg_key_of_def(&res, did)
      when ResolvedExprKind::Constant(did) then edit_reg_key_of_def(&res, did)
      when ResolvedExprKind::Static(did) then edit_reg_key_of_def(&res, did)
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  end
end

# The LOCAL binder identity of an identifier (the P0-13 local rule): the
# binding's LocalId. Option::None for a declaration reference / unresolved
# identifier.
pub def edit_ref_local_id(res: ResolvedNames, node_id: Int) -> Option[LocalId]
  match res.expr_resolutions.get(node_id)
  when Option::Some(re) then
    match re.kind
    when ResolvedExprKind::LocalVar(lid, _) then Option::Some(lid)
    when ResolvedExprKind::Parameter(lid, _, _) then Option::Some(lid)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# Whether the reference resolved at node_id is the target declaration
# (registration-key equality — resolver identity, never spelling).
pub def edit_ref_is_target(res: ResolvedNames, node_id: Int, target_reg: String) -> Bool
  match edit_ref_reg_key(&res, node_id)
  when Option::Some(k) then stable_key_eq(k, target_reg)
  when Option::None then false
  end
end

# The registration-key text of a declaration at (module_path, declared
# name) — the module_symbols grammar the resolver registers with.
pub def edit_reg_key_text(module_path: Vec[String], name: String) -> String
  let joined = module_path.join("::")
  if joined.is_empty() then name.clone() else joined.clone() + "::" + name.clone() end
end

# The name part before the first "#" (the registration key of a full
# stable key); the whole text when it carries no "#".
pub def edit_key_reg_part(key: String) -> String
  edit_name_part(&key)
end

# The signature part after the first "#" ("" when the key carries none).
def edit_key_sig_part(key: String) -> String
  let i = edit_char_index(&key, "#", 0)
  if i < 0 then "".to_string() else key.slice(i + 1, key.len()) end
end

# The full stable key a rename produces: the target's module/owner prefix +
# the new name + the target's signature part. A bare target keeps the bare
# shape. Method targets keep their owner segment ("m::T::old" ->
# "m::T::new").
pub def edit_rename_key(old_key: String, new_name: String) -> String
  let name_part = edit_name_part(&old_key)
  let sig = edit_key_sig_part(&old_key)
  var owner = "".to_string()
  var pos = name_part.len()
  while pos >= 2 do
    if name_part.slice(pos - 2, pos) == "::" then
      owner = name_part.slice(0, pos - 2)
      break
    end
    pos = pos - 1
  end
  var prefix = "".to_string()
  if owner.len() > 0 then
    prefix = owner + "::"
  end
  var out = prefix + new_name.clone()
  if sig.len() > 0 || old_key.contains("#") then
    out = out + "#" + sig
  end
  out
end

# ———————————————————————————————————————————————————————————————
# P0-14: HIR statement anchors + the explicit MIR->HIR origin map
# ———————————————————————————————————————————————————————————————
# The canonical HIR anchor text "<fn key>#H<node id>": the function's
# stable key plus the HIR node id assign_node_ids assigned (the §54 hole
# key's node space). The typed form of the anchor is stable_ids'
# StableHirNodeId { owner: StableDeclId, node_seq } — semantic_edit carries
# the text on the wire and builds the typed record through
# stable_hir_node_id_of at every identity comparison. The node id is read
# in the parse/assign_node_ids pass of the source being edited (the same
# pass whose ResolvedNames the rewrite gates compare); an anchor that names
# no statement of that pass resolves to no source insertion point and the
# edit fails closed.
#
# A §33 MIR locator ("<fn key>#B<block>#S<idx>", SnapshotMirLocator /
# StableMirStmtId) is NEVER mapped back to a top-level AST statement
# ordinal. It resolves through the explicit MirOriginMap below; without a
# unique entry the request is EditError::AmbiguousSource.

pub def semantic_hir_stmt_key_of(function_key: String, hir_node: Int) -> String
  function_key.clone() + "#H" + hir_node.to_string()
end

# Parse "<fn key>#H<digits>" at the LAST "#H" (the function key itself may
# carry "#"); Option::None outside the grammar.
pub def semantic_hir_stmt_key_parts(key: String) -> Option[(String, Int)]
  let at = edit_last_str_index(&key, "#H".to_string())
  if at <= 0 then
    return Option::None
  end
  let seq_text = key.slice(at + 2, key.len())
  if !edit_is_digits(&seq_text) then
    return Option::None
  end
  match seq_text.parse_int()
  when Result::Ok(v) then Option::Some((key.slice(0, at), v))
  when Result::Err(_) then Option::None
  end
end

# The typed HIR anchor record of (function stable key, node id).
pub def semantic_hir_node_of(function_key: String, hir_node: Int) -> StableHirNodeId
  stable_hir_node_id_of(stable_decl_of_key(function_key), hir_node)
end

# ONE entry of the explicit MIR -> HIR origin map. unique = true carries
# the resolved HIR anchor; unique = false carries the ambiguity reason
# (the same reason vocabulary the typed error's evidence names:
# desugared-for, desugared-match, contract-generated, nested-block,
# multi-mir-node-expression).
pub struct MirOrigin
  function_key: String = ""
  block: Int = 0
  stmt: Int = -1
  hir_owner_key: String = ""
  hir_node: Int = -1
  unique: Bool = false
  reason: String = ""
end

pub struct MirOriginMap
  entries: Vec[MirOrigin] = Vec::new()
end

pub def mir_origin_map_new() -> MirOriginMap
  MirOriginMap {}
end

pub def mir_origin_map_add(inout map: MirOriginMap, origin: MirOrigin) -> Unit
  map.entries.push(origin)
end

# Register the unique source insertion point of one MIR statement.
pub def mir_origin_map_add_unique(
  inout map: MirOriginMap, function_key: String, block: Int, stmt: Int,
  hir_owner_key: String, hir_node: Int
) -> Unit
  map.entries.push(MirOrigin {
    function_key: function_key,
    block: block,
    stmt: stmt,
    hir_owner_key: hir_owner_key,
    hir_node: hir_node,
    unique: true,
    reason: ""
  })
end

# Register a MIR statement whose lowering has NO unique source insertion
# point (the reason is the exact class: desugared-for / desugared-match /
# contract-generated / nested-block / multi-mir-node-expression).
pub def mir_origin_map_add_ambiguous(
  inout map: MirOriginMap, function_key: String, block: Int, stmt: Int, reason: String
) -> Unit
  map.entries.push(MirOrigin {
    function_key: function_key,
    block: block,
    stmt: stmt,
    hir_owner_key: "",
    hir_node: -1,
    unique: false,
    reason: reason
  })
end

pub def mir_origin_map_lookup(
  map: MirOriginMap, function_key: String, block: Int, stmt: Int
) -> Option[MirOrigin]
  for e in map.entries do
    if e.function_key == function_key && e.block == block && e.stmt == stmt then
      return Option::Some(e)
    end
  end
  Option::None
end

# The digits test (a numeric key component).
def edit_is_digits(text: String) -> Bool
  if text.len() == 0 then
    return false
  end
  var i = 0
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch < "0" || ch > "9" then
      return false
    end
    i = i + 1
  end
  true
end

# The index of the LAST occurrence of `needle` in s (-1 absent).
def edit_last_str_index(s: String, needle: String) -> Int
  if needle.len() == 0 then
    return -1
  end
  var found = -1
  var i = 0
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      found = i
    end
    i = i + 1
  end
  found
end

# ———————————————————————————————————————————————————————————————
# P0-15: reachable actual-delta rows + the planned-set comparison
# ———————————————————————————————————————————————————————————————
# The REACHABLE semantic rows of one front-end artifact (the resolver's
# registration symbols + the per-declaration canonical signature texts +
# the resolved call-target multiset). The finalized snapshot builder
# (semantic_snapshot_of_final_state) additionally needs the MirProgram the
# lowering layer produces; this module's import surface stops at the front
# end, so the actual-delta comparison runs over these rows. The
# effect/ABI/public-api planned sets ride ResolvedEdit for the full
# snapshot stage (module doc boundary paragraph).

pub struct EditReachableRows
  symbols: Vec[String] = Vec::new()
  signatures: Vec[String] = Vec::new()
  calls: Vec[String] = Vec::new()
end

# A declaration row: the registration key (the symbol identity).
# A signature row: "<registration key>|<canonical signature text>".
# A call row: one entry per resolver call target, the callee registration
# key (a multiset — duplicates are significant).

def edit_reachable_rows(program: Program, res: ResolvedNames) -> EditReachableRows
  var rows = EditReachableRows {}
  edit_reachable_collect_items(&mut rows, program.items, Vec::new())
  var ci = 0
  let call_entries = res.call_targets.entries()
  while ci < call_entries.len() do
    match edit_reg_key_of_def(&res, call_entries[ci].1)
    when Option::Some(k) then rows.calls.push(k)
    when Option::None then ()
    end
    ci = ci + 1
  end
  rows.symbols.sort()
  rows.signatures.sort()
  rows.calls.sort()
  rows
end

def edit_reachable_collect_items(inout rows: EditReachableRows, items: Vec[Item], module_path: Vec[String]) -> Unit
  var i = 0
  while i < items.len() do
    let item = items[i]
    match item.kind
    when ItemKind::ItemFunction(f) then
      let reg = edit_reg_key_text(module_path.clone(), f.name.clone())
      rows.symbols.push(reg.clone())
      rows.signatures.push(reg + "|" + edit_signature_text(f))
    when ItemKind::ItemStruct(s) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), s.name.clone()))
      var m = 0
      while m < s.methods.len() do
        let mreg = edit_reg_key_text(module_path.clone(), s.name.clone() + "::" + s.methods[m].name.clone())
        rows.symbols.push(mreg.clone())
        rows.signatures.push(mreg + "|" + edit_signature_text(s.methods[m]))
        m = m + 1
      end
    when ItemKind::ItemImpl(im) then
      var mi = 0
      while mi < im.methods.len() do
        let mreg = edit_reg_key_text(module_path.clone(),
          type_expr_name(im.for_type) + "::" + im.methods[mi].name.clone())
        rows.symbols.push(mreg.clone())
        rows.signatures.push(mreg + "|" + edit_signature_text(im.methods[mi]))
        mi = mi + 1
      end
    when ItemKind::ItemEnum(e) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), e.name.clone()))
    when ItemKind::ItemTrait(t) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), t.name.clone()))
    when ItemKind::ItemTypeAlias(ta) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), ta.name.clone()))
    when ItemKind::ItemConst(c) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), c.name.clone()))
    when ItemKind::ItemStatic(s) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), s.name.clone()))
    when ItemKind::ItemMacro(mac) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), mac.name.clone()))
    when ItemKind::ItemCapabilityDecl(cap) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), cap.name.clone()))
    when ItemKind::ItemEffectDecl(eff) then
      rows.symbols.push(edit_reg_key_text(module_path.clone(), eff.name.clone()))
    when ItemKind::ItemModule(mod_decl) then
      var inner_path = module_path.clone()
      inner_path.push(mod_decl.name.clone())
      edit_reachable_collect_items(rows, mod_decl.items, inner_path)
    when _ then ()
    end
    i = i + 1
  end
end

# The canonical signature text of a function/method declaration (params
# with their access conventions and type renders, then the return render).
# The text is the reachable signature fingerprint; the full snapshot's
# StableSymbolId.full_key is the authoritative signature render.
pub def edit_signature_text(f: FunctionDecl) -> String
  var parts: Vec[String] = Vec::new()
  var i = 0
  while i < f.params.len() do
    parts.push(edit_access_convention_word(f.params[i].convention) + " " +
      f.params[i].name.clone() + ":" + edit_type_opt_text(&f.params[i].ty))
    i = i + 1
  end
  "(" + parts.join(",") + ")->" + edit_type_opt_text(&f.ret_type)
end

def edit_access_convention_word(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

def edit_type_opt_text(ty: Option[TypeExpr]) -> String
  match ty
  when Option::Some(t) then edit_type_expr_text(t)
  when Option::None then ""
  end
end

# The canonical render of one type expression (the reachable signature
# fingerprint component; the Digest-domain type render is the snapshot
# stage's authority).
pub def edit_type_expr_text(te: TypeExpr) -> String
  match te.kind
  when TypeExprKind::Named(name, args) then
    if args.len() == 0 then name.clone()
    else name.clone() + "[" + edit_type_list_text(args) + "]" end
  when TypeExprKind::ConstArg(v) then v.to_string()
  when TypeExprKind::ConstExpr(_) then "const"
  when TypeExprKind::Unit then "()"
  when TypeExprKind::Never then "!"
  when TypeExprKind::Tuple(items) then "(" + edit_type_list_text(items) + ")"
  when TypeExprKind::Array(elem, _) then "[" + edit_type_expr_text(elem) + "]"
  when TypeExprKind::Slice(elem) then "[" + edit_type_expr_text(elem) + "]"
  when TypeExprKind::Ptr(elem) then "*" + edit_type_expr_text(elem)
  when TypeExprKind::PtrMut(elem) then "*mut " + edit_type_expr_text(elem)
  when TypeExprKind::Ref(elem, is_mut) then
    if is_mut then "&mut " + edit_type_expr_text(elem) else "&" + edit_type_expr_text(elem) end
  when TypeExprKind::Fn(params, ret) then
    var ps: Vec[String] = Vec::new()
    for p in params do
      ps.push(edit_type_expr_text(p.ty))
    end
    "fn(" + ps.join(",") + ")->" + edit_type_expr_text(ret)
  when TypeExprKind::Async(inner) then "async " + edit_type_expr_text(inner)
  when TypeExprKind::Effect(name, inner) then name.clone() + "(" + edit_type_expr_text(inner) + ")"
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Infer then "_"
  end
end

def edit_type_list_text(items: Vec[TypeExpr]) -> String
  var parts: Vec[String] = Vec::new()
  for it in items do
    parts.push(edit_type_expr_text(it))
  end
  parts.join(",")
end

# The actual delta rows of a before/after reachable-row pair, sorted:
#   entity-created:<registration key>
#   entity-removed:<registration key>
#   entity-signature-changed:<registration key>
#   call-created:<callee registration key>
#   call-removed:<callee registration key>
# The insertion row (stmt-inserted) is added by the pipeline from the
# applied transform's HIR anchor.
pub def edit_reachable_delta_rows(before: EditReachableRows, after: EditReachableRows) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var removed = edit_vector_diff(before.symbols.clone(), after.symbols.clone())
  for k in removed do
    out.push("entity-removed:" + k)
  end
  var created = edit_vector_diff(after.symbols.clone(), before.symbols.clone())
  for k in created do
    out.push("entity-created:" + k)
  end
  # Signature changes: the same registration key on both sides whose
  # canonical signature text differs.
  var si = 0
  while si < after.signatures.len() do
    let arow = after.signatures[si].clone()
    let reg = edit_signature_row_reg(&arow)
    match edit_signature_row_of(before.signatures.clone(), reg.clone())
    when Option::Some(brow) then
      if brow != arow then
        out.push("entity-signature-changed:" + reg)
      end
    when Option::None then ()
    end
    si = si + 1
  end
  var call_removed = edit_vector_diff(before.calls.clone(), after.calls.clone())
  for k in call_removed do
    out.push("call-removed:" + k)
  end
  var call_created = edit_vector_diff(after.calls.clone(), before.calls.clone())
  for k in call_created do
    out.push("call-created:" + k)
  end
  out.sort()
  out
end

# The multiset difference a - b (sorted inputs, sorted output): every
# element of a beyond b's multiplicity.
def edit_vector_diff(a: Vec[String], b: Vec[String]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var i = 0
  var j = 0
  while i < a.len() do
    if j < b.len() && b[j] == a[i] then
      j = j + 1
    else
      out.push(a[i].clone())
    end
    i = i + 1
  end
  out
end

def edit_signature_row_reg(row: String) -> String
  let i = edit_str_index(&row, "|".to_string(), 0)
  if i < 0 then row.clone() else row.slice(0, i) end
end

def edit_signature_row_of(rows: Vec[String], reg: String) -> Option[String]
  for r in rows do
    if edit_signature_row_reg(&r) == reg then
      return Option::Some(r)
    end
  end
  Option::None
end

# The registration keys named by one canonical planned row: split at '|'
# (composite call/capability rows), then take each component's
# registration part. The result feeds the planned-set membership and the
# budget allowance.
pub def edit_plan_reg_keys(row_key: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  let parts = edit_pipe_parts(row_key.clone())
  for p in parts do
    let reg = edit_name_part(&p)
    if reg.len() > 0 then
      out.push(reg)
    end
  end
  out
end

# Whether a planned registration set names the actual registration key:
# exact membership, or the key is a MEMBER/key of a planned owner
# ("T::m" is planned when "T" is named) — the owner-qualified descendants
# a declaration rename re-keys.
pub def edit_plan_names_key(planned: Vec[String], key: String) -> Bool
  for p in planned do
    if p == key then
      return true
    end
    if key.starts_with(p.clone() + "::") || p.starts_with(key.clone() + "::") then
      return true
    end
  end
  false
end

# The subject registration keys of one actual delta row (the keys the
# planned sets must name).
pub def edit_actual_row_subjects(row: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  let colon = edit_char_index(&row, ":", 0)
  if colon <= 0 then
    return out
  end
  let op = row.slice(0, colon)
  let body = row.slice(colon + 1, row.len())
  if op == "entity-created" || op == "entity-removed" || op == "entity-signature-changed" then
    out.push(body.clone())
  elsif op == "call-created" || op == "call-removed" then
    out.push(body.clone())
  elsif op == "stmt-inserted" then
    out.push(edit_name_part(&body))
  end
  out
end

# The planned-set comparison result.
pub struct EditPlanComparison
  unexpected: Vec[String] = Vec::new()
  unmatched: Vec[String] = Vec::new()
  matched: Bool = false
end

# Compare the actual delta rows with the planned ResolvedEdit sets. The
# planned keys are the registration keys named by expected_delta rows,
# expected_write, expected_effect / expected_abi / expected_public_api,
# resolved.affected and resolved.targets. An actual row whose subject is
# not planned is unexpected; a planned expected_delta row with no actual
# counterpart is unmatched. matched = both lists empty.
pub def edit_compare_actual_plan(resolved: ResolvedEdit, actual_rows: Vec[String]) -> EditPlanComparison
  var planned: Vec[String] = Vec::new()
  for r in resolved.expected_delta do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_write do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_effect do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_abi do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_public_api do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.affected do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.targets do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end

  var comparison = EditPlanComparison {}
  # Unexpected: an actual row subject no planned key names.
  for row in actual_rows do
    let subjects = edit_actual_row_subjects(row.clone())
    var ok = subjects.len() == 0
    for s in subjects do
      if edit_plan_names_key(planned.clone(), s.clone()) then
        ok = true
      end
    end
    if !ok then
      comparison.unexpected.push(row.clone())
    end
  end
  # Missing: every planned expected_delta row must have an actual
  # counterpart (the plan's own operations).
  for plan_row in resolved.expected_delta do
    if !edit_plan_row_matches(plan_row.clone(), actual_rows.clone()) then
      comparison.unmatched.push(plan_row.clone())
    end
  end
  comparison.matched = comparison.unexpected.len() == 0 && comparison.unmatched.len() == 0
  comparison
end

# Whether one planned expected_delta row has an actual counterpart.
def edit_plan_row_matches(plan_row: String, actual_rows: Vec[String]) -> Bool
  let colon = edit_char_index(&plan_row, ":", 0)
  if colon <= 0 then
    return false
  end
  let op = plan_row.slice(0, colon)
  let body = plan_row.slice(colon + 1, plan_row.len())
  let reg = edit_name_part(&body)
  if op == "entity-modified" then
    for row in actual_rows do
      if row.starts_with("entity-created:".to_string()) ||
         row.starts_with("entity-removed:".to_string()) ||
         row.starts_with("entity-signature-changed:".to_string()) then
        let c = edit_char_index(&row, ":", 0)
        let subject = row.slice(c + 1, row.len())
        if edit_plan_names_key(Vec::from([reg.clone()]), subject) then
          return true
        end
      end
    end
    return false
  end
  if op == "call-modified" then
    let parts = edit_pipe_parts(body.clone())
    if parts.len() < 2 then
      return false
    end
    let old_callee = edit_name_part(&parts[1])
    for row in actual_rows do
      if row.starts_with("call-removed:".to_string()) || row.starts_with("call-created:".to_string()) then
        let c2 = edit_char_index(&row, ":", 0)
        let subject = row.slice(c2 + 1, row.len())
        if edit_plan_names_key(Vec::from([old_callee.clone()]), subject) then
          return true
        end
      end
    end
    return false
  end
  if op == "stmt-inserted" then
    for row in actual_rows do
      if row.starts_with("stmt-inserted:".to_string()) then
        let c3 = edit_char_index(&row, ":", 0)
        let subject = row.slice(c3 + 1, row.len())
        if edit_plan_names_key(Vec::from([reg.clone()]), subject) then
          return true
        end
      end
    end
    return false
  end
  # The snapshot / typed surfaces (contract-created, contract-removed,
  # hole-filled) do not ride the source pipeline; a plan row of those
  # families on the source surface is unmatched (fail closed).
  false
end

# The SemanticDelta record the actual reachable rows project onto (the
# ChangeBudget / proof-patch input): entity rows become created / removed /
# modified, call rows become EdgeDelta entries, and the changed subjects
# seed the affected list.
def edit_actual_delta_record(actual_rows: Vec[String]) -> SemanticDelta
  var d = semantic_delta_empty()
  var affected: Vec[String] = Vec::new()
  for row in actual_rows do
    let colon = edit_char_index(&row, ":", 0)
    if colon <= 0 then
      next
    end
    let op = row.slice(0, colon)
    let body = row.slice(colon + 1, row.len())
    if op == "entity-created" then
      d.created.push(body.clone())
      affected.push(body.clone())
    elsif op == "entity-removed" then
      d.removed.push(body.clone())
      affected.push(body.clone())
    elsif op == "entity-signature-changed" then
      d.modified.push(EntityDelta {
        stable_id: body.clone(),
        signature_changed: true,
        mir_changed: false,
        effects_changed: false,
        capabilities_changed: false,
        ownership_changed: false,
        contracts_changed: false,
        abi_changed: false,
        kind: DeltaKind::Modified
      })
      affected.push(body.clone())
    elsif op == "call-created" then
      d.call_delta.push(EdgeDelta {
        key: body.clone(),
        kind: DeltaKind::Created,
        from: "".to_string(),
        to: body.clone()
      })
      affected.push(body.clone())
    elsif op == "call-removed" then
      d.call_delta.push(EdgeDelta {
        key: body.clone(),
        kind: DeltaKind::Removed,
        from: "".to_string(),
        to: body.clone()
      })
      affected.push(body.clone())
    elsif op == "stmt-inserted" then
      affected.push(body.clone())
    end
  end
  d.affected = affected
  d
end

# The ChangeBudget allowance of one planned key list: every planned
# registration key parses to the declaration identity the budget gate
# compares (registration keys on both sides — the budget's identity
# comparison stays a StableDeclId digest comparison).
pub def edit_budget_for_plan(planned_regs: Vec[String]) -> ChangeBudget
  var allowed: Set[StableDeclId] = Set::new()
  for k in planned_regs do
    allowed.insert(stable_decl_of_key(k.clone()))
  end
  var b = ChangeBudget {}
  b.allowed_symbols = allowed
  b
end

# The planned registration keys of a ResolvedEdit (the union the comparison
# and the budget allowance share).
pub def edit_plan_regs(resolved: ResolvedEdit) -> Vec[String]
  var planned: Vec[String] = Vec::new()
  for r in resolved.expected_delta do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_write do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.affected do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.targets do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_effect do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_abi do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  for r in resolved.expected_public_api do
    for k in edit_plan_reg_keys(r.clone()) do
      planned.push(k)
    end
  end
  planned
end

# ———————————————————————————————————————————————————————————————
# The canonical hole key (audit item 54 identity, audit item 53 target;
# third-audit item 16 record migration)
# ———————————————————————————————————————————————————————————————
# The TYPED identity is stable_ids' StableHoleId { owner: StableDeclId,
# origin: StableHirNodeId } — the owner declaration plus the HIR node
# anchor. The canonical TEXT grammar "<fn stable def key>#hole<node seq>"
# is retained as the RENDER / wire form: these helpers are the protocol's
# thin text boundary over stable_ids' stable_hole_key_text /
# stable_hole_key_parts (the semantic_query hole.constraints op parses
# through the same functions). The typed constraints are read back by node
# id through types.tg's accessors.

pub def semantic_hole_key_of(function_key: String, hole_node: Int) -> String
  stable_hole_key_text(function_key, hole_node)
end

# Parse a canonical hole key into (function key prefix, node id). The LAST
# "#hole" separates (the function key itself carries '#'); the digits must
# be a non-empty decimal run. Option::None for any text outside the
# grammar.
pub def semantic_hole_key_parts(key: String) -> Option[(String, Int)]
  stable_hole_key_parts(&key)
end

# ———————————————————————————————————————————————————————————————
# resolve_edit — the typed resolution of one edit
# ———————————————————————————————————————————————————————————————
# The snapshot parameter is REQUIRED for the affected closure:
# affected_closure reads the b-side rows (callers, contracts, type texts,
# test rows — semantic_delta.tg), and the index alone carries no row
# payloads for it. index MUST be built from snapshot (the §32 contract).
pub def resolve_edit(
  index: SemanticIndex,
  snapshot: SemanticSnapshot,
  edit: SemanticEdit
) -> Result[ResolvedEdit, EditError]
  match edit
  when SemanticEdit::Rename(decl, new_name) then
    edit_resolve_rename(&snapshot, &index, decl, new_name)
  when SemanticEdit::ChangeSignature(decl, new_signature_text) then
    edit_resolve_change_signature(&snapshot, &index, decl, new_signature_text)
  when SemanticEdit::ChangeContract(contract_id, new_expression_text) then
    edit_resolve_change_contract(&snapshot, &index, contract_id, new_expression_text)
  when SemanticEdit::ReplaceCall(call_site_key, callee) then
    edit_resolve_replace_call(&snapshot, &index, call_site_key, callee)
  when SemanticEdit::InsertStatement(function_key, before_stmt_key, statement_text) then
    edit_resolve_insert_statement(&snapshot, &index, function_key, before_stmt_key, statement_text)
  when SemanticEdit::FillHole(hole_key, expression_text) then
    edit_resolve_fill_hole(&snapshot, &index, hole_key, expression_text)
  end
end

def edit_resolve_rename(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  decl: String,
  new_name: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, decl.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The resolved StableDeclId is the index's caller-map key (the typed id,
  # not the raw text): stable_decl_of_key re-derives the exact record from
  # the canonical key (the *_of_key accessor contract).
  let decl_id = stable_decl_of_key(target.clone())
  let callers = index_callers_of_decl(&index, decl_id)
  let affected_result = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("target:" + target.clone())
  pre.push("new-name:" + new_name.clone())
  pre.push("direct-callers:" + callers.len().to_string())
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  # P0-15 plan: the NEW stable key the rename writes (the module/owner
  # prefix + the new name + the old signature part).
  let new_key = edit_rename_key(target.clone(), new_name.clone())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::Rename(decl, new_name),
    targets: Vec::from([target.clone()]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: Vec::from(["entity-modified:" + target]),
    expected_write: Vec::from([new_key])
  })
end

def edit_resolve_change_signature(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  decl: String,
  new_signature_text: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, decl.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The callsites-that-must-update count comes from the typed index's
  # reverse call map keyed by the resolved StableDeclId.
  let decl_id = stable_decl_of_key(target.clone())
  let callers = index_callers_of_decl(&index, decl_id)
  let affected_result = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("target:" + target.clone())
  pre.push("new-signature:" + new_signature_text.clone())
  pre.push("callsites-to-update:" + callers.len().to_string())
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(decl, new_signature_text),
    targets: Vec::from([target.clone()]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: Vec::from(["entity-modified:" + target]),
    # The declaration identity is unchanged (the signature part of the
    # stable key is the change) — the write set names it.
    expected_write: Vec::from([target])
  })
end

def edit_resolve_change_contract(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  contract_id: String,
  new_expression_text: String
) -> Result[ResolvedEdit, EditError]
  let row = match edit_find_contract(&snapshot, contract_id.clone())
  when Option::Some(c) then c
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let fn_key = row.function.key.clone()
  let clause = semantic_contract_expr_text(&row.canonical_expression)
  let affected_result = edit_seed_affected(snapshot, index, fn_key.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("contract-row:" + contract_id.clone())
  pre.push("function:" + fn_key.clone())
  pre.push("canonical-clause:" + clause.clone())
  pre.push("new-clause:" + new_expression_text.clone())
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  # The clause TEXT is part of the StableContractId, so a canonical-content
  # edit re-keys the row: the expected §31 delta is the Removed old key +
  # Created new key pair. A text outside the canonical grammar is not
  # resolved as a delta (the apply fails PreconditionFailed) — the expected
  # row then names the malformed precondition instead of a fabricated key.
  var expected: Vec[String] = Vec::new()
  var writes: Vec[String] = Vec::new()
  match edit_parse_canonical_expr(new_expression_text.clone())
  when Option::Some(new_ir) then
    let new_key = stable_contract_row_key(fn_key.clone(), edit_contract_kind_word(row.kind),
      semantic_contract_expr_text(&new_ir))
    expected.push("contract-created:" + new_key.clone())
    expected.push("contract-removed:" + contract_id.clone())
    writes.push(new_key)
  when Option::None then
    expected.push("contract-precondition-failed:" + contract_id.clone())
  end
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ChangeContract(contract_id.clone(), new_expression_text),
    targets: Vec::from([contract_id.clone(), fn_key]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: expected,
    expected_write: writes
  })
end

def edit_resolve_replace_call(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  call_site_key: String,
  callee: String
) -> Result[ResolvedEdit, EditError]
  let call = match edit_find_call(&snapshot, call_site_key.clone())
  when Option::Some(c) then c
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let new_callee = match edit_resolve_symbol_key(&snapshot, callee.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  let caller_key = call.caller.key.clone()
  let old_callee_key = call.callee.key.clone()
  let affected_result = edit_seed_affected(snapshot, index, caller_key.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("call-row:" + call_site_key.clone())
  pre.push("caller:" + caller_key.clone())
  pre.push("old-callee:" + old_callee_key.clone())
  pre.push("new-callee:" + new_callee.clone())
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  # P0-15 plan: the NEW call row key (same caller/kind, the resolved new
  # callee key).
  let kind_numeric = semantic_call_edge_kind_numeric(&call.kind)
  let new_call_key = caller_key.clone() + "|" + new_callee.clone() + "|" + kind_numeric.to_string()
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(call_site_key.clone(), callee),
    targets: Vec::from([call_site_key.clone(), new_callee]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: Vec::from(["call-modified:" + call_site_key]),
    expected_write: Vec::from([new_call_key])
  })
end

def edit_resolve_insert_statement(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  function_key: String,
  before_stmt_key: String,
  statement_text: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, function_key.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The statement anchor must belong to the resolved function: either the
  # HIR anchor "<fn key>#H<node id>" (the P0-14 source-cited form) or the
  # §33 MIR locator "<fn key>#B<block>#S<idx>" (or "#T"). The MIR origin
  # map is not part of the index, so the unique-source-insertion-point
  # requirement is verified at apply; the function membership is verified
  # here.
  if !before_stmt_key.starts_with(target.clone() + "#H") &&
     !before_stmt_key.starts_with(target.clone() + "#B") then
    return Result::Err(EditError::TargetNotFound)
  end
  let affected_result = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("function:" + target.clone())
  pre.push("before-stmt:" + before_stmt_key.clone())
  pre.push("statement:" + statement_text.clone())
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::InsertStatement(function_key, before_stmt_key.clone(), statement_text),
    targets: Vec::from([target, before_stmt_key.clone()]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: Vec::from(["stmt-inserted:" + before_stmt_key.clone()]),
    expected_write: Vec::from([before_stmt_key])
  })
end

def edit_resolve_fill_hole(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  hole_key: String,
  expression_text: String
) -> Result[ResolvedEdit, EditError]
  let parts = match semantic_hole_key_parts(hole_key.clone())
  when Option::Some(p) then p
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let fn_prefix = parts.0.clone()
  let node = parts.1
  let target = match edit_resolve_symbol_key(&snapshot, fn_prefix.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  let canonical_hole = semantic_hole_key_of(target.clone(), node)
  let affected_result = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("hole:" + canonical_hole.clone())
  pre.push("function:" + target.clone())
  pre.push("hole-node:" + node.to_string())
  pre.push("constraints-accessor:types.hole_constraints_of")
  pre.push("affected-total:" + affected_result.entities.len().to_string())
  pre.push("affected-completeness:" + affected_result.completeness.clone())
  if affected_result.missing_relations.len() > 0 then
    pre.push("affected-missing:" + affected_result.missing_relations.join(","))
  end
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::FillHole(hole_key.clone(), expression_text),
    targets: Vec::from([target, canonical_hole.clone()]),
    affected: affected_result.entities.clone(),
    affected_completeness: affected_result.completeness.clone(),
    missing_relations: affected_result.missing_relations.clone(),
    preconditions: pre,
    expected_delta: Vec::from(["hole-filled:" + canonical_hole.clone()]),
    expected_write: Vec::from([canonical_hole])
  })
end

# ———————————————————————————————————————————————————————————————
# apply_edit — the tractable apply surface
# ———————————————————————————————————————————————————————————————
# The snapshot-level apply entry. ChangeContract applies for real (the
# updated snapshot + the semantic_delta_of proof); FillHole applies on the
# typed-program surface via apply_fill_hole (this entry names it through
# ApplyUnavailable); Rename / ChangeSignature / ReplaceCall /
# InsertStatement carry no SNAPSHOT surface (their authority is source
# text), so this entry returns ApplyUnavailable for them — the REAL
# application is the source rewrite engine (third-audit item 30):
# apply_edit_to_source / edit_apply_to_source.
pub def apply_edit(snapshot: SemanticSnapshot, resolved: ResolvedEdit) -> Result[EditApplication, EditError]
  match resolved.edit
  when SemanticEdit::ChangeContract(contract_id, new_expression_text) then
    edit_apply_change_contract(&snapshot, contract_id, new_expression_text)
  when SemanticEdit::FillHole(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::Rename(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::ChangeSignature(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::ReplaceCall(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::InsertStatement(_, _, _) then
    Result::Err(EditError::ApplyUnavailable)
  end
end

# Parse a canonical contract expression text "op(arg,arg,...)" (the
# semantic_contract_expr_text grammar; args split at depth-0 commas).
# Option::None for any text outside the grammar (no '(' / no trailing ')' /
# unbalanced brackets) — the caller reports PreconditionFailed.
pub def edit_parse_canonical_expr(text: String) -> Option[ContractExprIR]
  let open = edit_char_index(&text, "(", 0)
  if open <= 0 then
    return Option::None
  end
  if text.len() < open + 2 then
    return Option::None
  end
  if text.slice(text.len() - 1, text.len()) != ")" then
    return Option::None
  end
  let op = text.slice(0, open)
  let body = text.slice(open + 1, text.len() - 1)
  var args: Vec[String] = Vec::new()
  if body.len() > 0 then
    var depth = 0
    var seg_start = 0
    var i = 0
    var ok = true
    # Quote-aware: canonical string-literal args ("str(<text>)") carry raw
    # text that may contain commas / brackets; a quote run keeps its inner
    # bytes out of the depth/split scan (an unterminated quote is rejected).
    var in_str = false
    var quote = "".to_string()
    while i < body.len() do
      let ch = body.slice(i, i + 1)
      if in_str then
        if ch == "\\" then
          i = i + 2
        elsif ch == quote then
          in_str = false
          i = i + 1
        else
          i = i + 1
        end
      else
        if ch == "\"" || ch == "'" then
          in_str = true
          quote = ch.clone()
        elsif ch == "(" || ch == "[" || ch == "{" then
          depth = depth + 1
        elsif ch == ")" || ch == "]" || ch == "}" then
          depth = depth - 1
          if depth < 0 then
            ok = false
          end
        elsif ch == "," && depth == 0 then
          args.push(body.slice(seg_start, i))
          seg_start = i + 1
        end
        i = i + 1
      end
    end
    if !ok || depth != 0 || in_str then
      return Option::None
    end
    args.push(body.slice(seg_start, body.len()))
  end
  Option::Some(ContractExprIR { op: op, args: args })
end

# The REAL snapshot apply: rebuild the contract row from the canonical text
# (canonical_expression + fingerprint + the re-keyed StableContractId),
# copy the snapshot, and diff before/after — the returned EditApplication
# carries both the updated snapshot and the actual §31 delta.
def edit_apply_change_contract(
  snapshot: SemanticSnapshot,
  contract_id: String,
  new_expression_text: String
) -> Result[EditApplication, EditError]
  let new_ir = match edit_parse_canonical_expr(new_expression_text.clone())
  when Option::Some(ir) then ir
  when Option::None then return Result::Err(EditError::PreconditionFailed)
  end
  let new_clause = semantic_contract_expr_text(&new_ir)
  var new_rows: Vec[ContractFact] = Vec::new()
  var found = false
  for c in snapshot.contracts do
    if stable_key_eq(c.id.stable_key, contract_id.clone()) then
      found = true
      let fn_key = c.function.key.clone()
      let new_key = stable_contract_row_key(fn_key, edit_contract_kind_word(c.kind), new_clause.clone())
      let fp = stable_digest_of(&new_clause)
      let key_words = stable_digest_of(&new_key)
      new_rows.push(ContractFact {
        id: StableContractId {
          dense_id: c.id.dense_id,
          stable_key: new_key.clone(),
          digest_hi: key_words.hi,
          digest_lo: key_words.lo
        },
        function: c.function.clone(),
        kind: c.kind,
        expression_fingerprint: fp,
        canonical_expression: new_ir.clone(),
        message: c.message.clone(),
        span: c.span.clone()
      })
    else
      new_rows.push(c)
    end
  end
  if !found then
    return Result::Err(EditError::TargetNotFound)
  end
  var after = snapshot
  after.contracts = new_rows
  let delta = semantic_delta_of(&snapshot, &after)
  Result::Ok(EditApplication {
    edit: SemanticEdit::ChangeContract(contract_id, new_expression_text),
    applied: Vec::from(["contract-updated:" + new_clause]),
    snapshot: Option::Some(after),
    delta: Option::Some(delta)
  })
end

# The typed-program patch surface for FillHole: verify the hole's node
# carries TypedExprKind::Hole, then replace the recorded typed node with the
# checker-produced replacement. `replacement` is the "provided expression's
# typed form" — the source text rides the edit, but only the front end can
# produce the typed node, so the caller supplies it (the honest split of
# this representation; the alternative — type-checking text inside the
# patch — needs the checker env, which the TypedProgram does not carry).
# SCOPE: this replaces the SEMANTIC record; the transitional MIR lowering
# is still AST-driven, so compiling the patched program additionally needs
# the AST/HIR expression rewrite (the MIR hole arm reports exactly that
# when it meets a filled typed node whose source is still `???`) — the
# patch never pretends the hole vanished from the AST.
pub def apply_fill_hole(
  inout program: TypedProgram,
  resolved: ResolvedEdit,
  replacement: TypedExpr
) -> Result[EditApplication, EditError]
  match resolved.edit
  when SemanticEdit::FillHole(hole_key, expression_text) then
    let parts = match semantic_hole_key_parts(hole_key.clone())
    when Option::Some(p) then p
    when Option::None then return Result::Err(EditError::TargetNotFound)
    end
    let node = parts.1
    match program.typed_exprs.get(node)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Hole then ()
      when _ then return Result::Err(EditError::PreconditionFailed)
      end
    when Option::None then
      return Result::Err(EditError::TargetNotFound)
    end
    program.typed_exprs.insert(node, replacement)
    Result::Ok(EditApplication {
      edit: SemanticEdit::FillHole(hole_key.clone(), expression_text),
      applied: Vec::from([
        "hole-filled:" + hole_key.clone(),
        "typed-node-replaced:" + node.to_string()
      ])
    })
  when _ then
    Result::Err(EditError::UnsupportedEdit)
  end
end

# The precise remaining-step text for an ApplyUnavailable result (the typed
# error carries no payload; this companion names the exact surface, never a
# marker token). For an edit that DOES apply, the text is the empty string.
pub def semantic_edit_unavailable_reason(edit: SemanticEdit) -> String
  match edit
  when SemanticEdit::Rename(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the declaration whose resolver registration key equals the target's is renamed and only references whose resolver registration key equals it are rewritten on the AST, rendered by the formatter and re-validated (third-audit item 30; fourth-audit P0-13 identity rewriting)"
  when SemanticEdit::ChangeSignature(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the declaration's signature is spliced on the AST and re-validated; call sites are NOT auto-updated in this slice (they ride ResolvedEdit.affected / callsites-to-update) (third-audit item 30)"
  when SemanticEdit::ChangeContract(_, _) then
    ""  # applies on the snapshot surface (edit_apply_change_contract)
  when SemanticEdit::ReplaceCall(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — every direct call site of the caller's body whose resolved call target equals the old callee registration key is replaced with the new callee, rendered and re-validated (third-audit item 30; fourth-audit P0-13 identity rewriting)"
  when SemanticEdit::InsertStatement(_, _, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the statement text is parsed and spliced before the HIR anchor <fn key>#H<node id> resolved by the AST walk, or before the HIR anchor of an explicit MirOriginMap entry for a §33 MIR locator; rendered and re-validated. A §33 locator with no unique source insertion point is the typed AmbiguousSource naming the reason (third-audit item 30; fourth-audit P0-14 HIR anchoring)"
  when SemanticEdit::FillHole(_, _) then
    "typed-program patch surface: call apply_fill_hole(program, resolved, replacement) with the checker-produced replacement TypedExpr (the snapshot-only apply entry does not carry the typed program)"
  end
end

# ———————————————————————————————————————————————————————————————
# Lane rows (self-checking helpers a behavior lane can call)
# ———————————————————————————————————————————————————————————————
# The sibling style of semantic_delta.tg's affected_closure_lane_check: no
# test-file lane exists for this module, so the rows are self-checking
# helpers and each row records a mismatch string. Empty = all rows verify.

def edit_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 8,
    endian: "little".to_string(),
    abi: "lp64".to_string(),
    float_abi: "soft".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def edit_lane_snapshot() -> SemanticSnapshot
  semantic_snapshot_new("lane".to_string(), edit_lane_target())
end

def edit_lane_sid(key: String) -> StableDefId
  stable_def_id_digested(key.clone(), edit_name_part(&key))
end

def edit_lane_fn_symbol(key: String, name: String, is_pub: Bool) -> SemanticSymbol
  SemanticSymbol {
    stable_id: edit_lane_sid(&key),
    kind: DefKind::Function,
    name: name,
    module_path: "m".to_string(),
    is_pub: is_pub,
    is_generic: false
  }
end

def edit_lane_lists_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def edit_lane_row(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !edit_lane_lists_same(got, expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

def edit_lane_single_row(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

pub def edit_error_word(e: EditError) -> String
  match e
  when EditError::TargetNotFound then "TargetNotFound"
  when EditError::AmbiguousTarget then "AmbiguousTarget"
  when EditError::UnsupportedEdit then "UnsupportedEdit"
  when EditError::PreconditionFailed then "PreconditionFailed"
  when EditError::ApplyUnavailable then "ApplyUnavailable"
  when EditError::AmbiguousSource then "AmbiguousSource"
  when EditError::UnexpectedDelta then "UnexpectedDelta"
  end
end

# Run the resolve/apply lane rows over constructed index/snapshot fixtures.
# Returns every mismatch row (empty = the whole lane verifies).
pub def semantic_edit_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— L1: Rename target resolution + affected callers ————
  let k_a = "m::A#fn()->unit".to_string()
  let k_b = "m::B#fn()->unit".to_string()
  var s1 = edit_lane_snapshot()
  var s1_syms: Vec[SemanticSymbol] = Vec::new()
  s1_syms.push(edit_lane_fn_symbol(&k_a, "A".to_string(), false))
  s1_syms.push(edit_lane_fn_symbol(&k_b, "B".to_string(), false))
  s1.symbols = s1_syms
  var s1_calls: Vec[CallEdge] = Vec::new()
  s1_calls.push(CallEdge {
    caller: edit_lane_sid(&k_a),
    callee: edit_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  s1.calls = s1_calls
  let idx1 = build_semantic_index(&s1)
  match resolve_edit(&idx1, &s1, SemanticEdit::Rename(k_b.clone(), "C".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "rename-targets", r.targets.clone(), Vec::from([k_b.clone()]))
    edit_lane_row(&mut out, "rename-affected", r.affected.clone(), Vec::from([k_a.clone(), k_b.clone()]))
    # P0-9: the closure verdict rides the resolved edit. This fixture
    # carries call rows only, so Call/TestReferences are complete while the
    # graph families without a completeness entry are reported (the walk
    # still returned {A, B} through the real call rows): partial.
    edit_lane_single_row(&mut out, "rename-affected-completeness",
      r.affected_completeness.clone(), "partial")
    edit_lane_row(&mut out, "rename-affected-missing", r.missing_relations.clone(),
      Vec::from(["AbiDependency".to_string(), "ContractReference".to_string(),
        "LayoutDependency".to_string(), "TraitImpl".to_string(), "TraitSelection".to_string()]))
    edit_lane_row(&mut out, "rename-precondition-callers",
      edit_rows_with_prefix(r.preconditions.clone(), "direct-callers:".to_string()),
      Vec::from(["direct-callers:1".to_string()]))
    edit_lane_row(&mut out, "rename-expected-delta", r.expected_delta.clone(),
      Vec::from(["entity-modified:" + k_b.clone()]))
    # A resolved Rename has no apply surface: typed ApplyUnavailable.
    match apply_edit(&s1, r)
    when Result::Ok(_) then out.push("rename-apply: expected ApplyUnavailable, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "rename-apply", edit_error_word(e), "ApplyUnavailable")
    end
  when Result::Err(e) then
    out.push("rename-resolve: expected Ok, got " + edit_error_word(e))
  end

  # ———— L2: ambiguous bare name / unknown key ————
  let k_dup1 = "m::Dup#fn()->unit".to_string()
  let k_dup2 = "m2::Dup#fn()->unit".to_string()
  var s2 = edit_lane_snapshot()
  var s2_syms: Vec[SemanticSymbol] = Vec::new()
  s2_syms.push(edit_lane_fn_symbol(&k_dup1, "Dup".to_string(), false))
  s2_syms.push(edit_lane_fn_symbol(&k_dup2, "Dup".to_string(), false))
  s2.symbols = s2_syms
  let idx2 = build_semantic_index(&s2)
  match resolve_edit(&idx2, &s2, SemanticEdit::Rename("Dup".to_string(), "Z".to_string()))
  when Result::Ok(_) then out.push("rename-ambiguous: expected AmbiguousTarget, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "rename-ambiguous", edit_error_word(e), "AmbiguousTarget")
  end
  match resolve_edit(&idx2, &s2, SemanticEdit::Rename("m::Nope#fn()->unit".to_string(), "Z".to_string()))
  when Result::Ok(_) then out.push("rename-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "rename-missing", edit_error_word(e), "TargetNotFound")
  end

  # ———— L3: ChangeContract target + REAL apply (snapshot + delta) ————
  let k_f = "m::F#fn()->unit".to_string()
  let clause0 = "bingt(ident(amount),int(0))".to_string()
  let clause1 = "bingt(ident(amount),int(10))".to_string()
  let ckey0 = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause0.clone())
  var s3 = edit_lane_snapshot()
  var s3_syms: Vec[SemanticSymbol] = Vec::new()
  s3_syms.push(edit_lane_fn_symbol(&k_f, "F".to_string(), false))
  s3.symbols = s3_syms
  var c_args0: Vec[String] = Vec::new()
  c_args0.push("ident(amount)".to_string())
  c_args0.push("int(0)".to_string())
  var s3_contracts: Vec[ContractFact] = Vec::new()
  s3_contracts.push(ContractFact {
    id: StableContractId { dense_id: -1, stable_key: ckey0.clone() },
    function: edit_lane_sid(&k_f),
    kind: AstContractKind::AstPre,
    expression_fingerprint: stable_digest_of(&clause0),
    canonical_expression: ContractExprIR { op: "bingt".to_string(), args: c_args0 },
    message: Option::None
  })
  s3.contracts = s3_contracts
  let idx3 = build_semantic_index(&s3)
  match resolve_edit(&idx3, &s3, SemanticEdit::ChangeContract(ckey0.clone(), clause1.clone()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "contract-targets", r.targets.clone(),
      Vec::from([ckey0.clone(), k_f.clone()]))
    let expected_new_key = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone())
    edit_lane_row(&mut out, "contract-expected-delta", r.expected_delta.clone(),
      Vec::from(["contract-created:" + expected_new_key, "contract-removed:" + ckey0.clone()]))
    match apply_edit(&s3, r)
    when Result::Ok(app) then
      match app.snapshot
      when Option::Some(s_after) then
        if s_after.contracts.len() != 1 then
          out.push("contract-apply-snapshot: expected 1 row, got " + s_after.contracts.len().to_string())
        else
          let row0 = s_after.contracts[0]
          edit_lane_single_row(&mut out, "contract-apply-clause",
            semantic_contract_expr_text(&row0.canonical_expression), clause1.clone())
          edit_lane_single_row(&mut out, "contract-apply-key",
            row0.id.stable_key.clone(),
            stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone()))
        end
      when Option::None then
        out.push("contract-apply-snapshot: expected Some, got None")
      end
      match app.delta
      when Option::Some(d) then
        # The clause TEXT is part of the StableContractId key, so a canonical
        # expression edit re-keys the row: the delta carries the Removed old
        # key + Created new key pair (2 rows), not one Modified row.
        if d.contract_delta.len() != 2 then
          out.push("contract-apply-delta: expected 2 contract rows (Removed+Created), got " + d.contract_delta.len().to_string())
        else
          let new_key = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone())
          var saw_new = false
          var saw_old = false
          for cd in d.contract_delta do
            if cd.contract_id == new_key then
              saw_new = true
            end
            if cd.contract_id == ckey0 then
              saw_old = true
            end
          end
          if !saw_new then
            out.push("contract-apply-delta: missing the Created row for the new key")
          end
          if !saw_old then
            out.push("contract-apply-delta: missing the Removed row for the old key")
          end
        end
      when Option::None then
        out.push("contract-apply-delta: expected Some, got None")
      end
    when Result::Err(e) then
      out.push("contract-apply: expected Ok, got " + edit_error_word(e))
    end
  when Result::Err(e) then
    out.push("contract-resolve: expected Ok, got " + edit_error_word(e))
  end
  # A malformed canonical text is PreconditionFailed at apply (the text
  # resolves as a row edit, then fails the apply parse).
  match resolve_edit(&idx3, &s3, SemanticEdit::ChangeContract(ckey0.clone(), "not-canonical".to_string()))
  when Result::Ok(r2) then
    match apply_edit(&s3, r2)
    when Result::Ok(_) then out.push("contract-malformed: expected PreconditionFailed, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "contract-malformed", edit_error_word(e), "PreconditionFailed")
    end
  when Result::Err(e) then
    out.push("contract-malformed-resolve: expected Ok, got " + edit_error_word(e))
  end

  # ———— L4: ReplaceCall target / InsertStatement prefix ————
  let call_key = edit_call_row_key(CallEdge {
    caller: edit_lane_sid(&k_a),
    callee: edit_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall(call_key.clone(), k_b.clone()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "call-targets", r.targets.clone(), Vec::from([call_key.clone(), k_b.clone()]))
    edit_lane_row(&mut out, "call-precondition-old-callee",
      edit_rows_with_prefix(r.preconditions.clone(), "old-callee:".to_string()),
      Vec::from(["old-callee:" + k_b.clone()]))
  when Result::Err(e) then
    out.push("call-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall("m::A#fn()->unit|m::Z#fn()->unit|0".to_string(), k_b.clone()))
  when Result::Ok(_) then out.push("call-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "call-missing", edit_error_word(e), "TargetNotFound")
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall(call_key.clone(), "m::Z#fn()->unit".to_string()))
  when Result::Ok(_) then out.push("call-newcallee-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "call-newcallee-missing", edit_error_word(e), "TargetNotFound")
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::InsertStatement(k_a.clone(), k_a.clone() + "#B0#S0", "let x = 1".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "insert-targets", r.targets.clone(),
      Vec::from([k_a.clone(), k_a.clone() + "#B0#S0"]))
  when Result::Err(e) then
    out.push("insert-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::InsertStatement(k_a.clone(), k_b.clone() + "#B0#S0", "let x = 1".to_string()))
  when Result::Ok(_) then out.push("insert-foreign-stmt: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "insert-foreign-stmt", edit_error_word(e), "TargetNotFound")
  end

  # ———— L5: FillHole target resolution ————
  let hole_key = semantic_hole_key_of(k_a.clone(), 7)
  match resolve_edit(&idx1, &s1, SemanticEdit::FillHole(hole_key.clone(), "42".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "hole-targets", r.targets.clone(), Vec::from([k_a.clone(), hole_key.clone()]))
    edit_lane_row(&mut out, "hole-expected-delta", r.expected_delta.clone(),
      Vec::from(["hole-filled:" + hole_key.clone()]))
    match apply_edit(&s1, r)
    when Result::Ok(_) then out.push("hole-apply: expected ApplyUnavailable, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "hole-apply", edit_error_word(e), "ApplyUnavailable")
    end
  when Result::Err(e) then
    out.push("hole-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::FillHole("no-hole-tag".to_string(), "42".to_string()))
  when Result::Ok(_) then out.push("hole-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "hole-missing", edit_error_word(e), "TargetNotFound")
  end

  # ———— L6: canonical hole key round-trip ————
  let hk = semantic_hole_key_of(k_b.clone(), 123)
  edit_lane_single_row(&mut out, "hole-key-text", hk.clone(), k_b.clone() + "#hole123")
  match semantic_hole_key_parts(hk.clone())
  when Option::Some(p) then
    edit_lane_single_row(&mut out, "hole-key-prefix", p.0, k_b.clone())
    edit_lane_single_row(&mut out, "hole-key-node", p.1.to_string(), "123")
  when Option::None then
    out.push("hole-key-parse: expected Some, got None")
  end

  out
end

# ———————————————————————————————————————————————————————————————
# The typed-hole lane (audit item 54): parser + checker end to end
# ———————————————————————————————————————————————————————————————
# Parses a tiny program whose body is `???`, then:
#   hole mode — checks cleanly, records the constraints, the typed node is
#     TypedExprKind::Hole, and typed_hole_constraints_of reads the resolved
#     expected type back through the artifact;
#   non-hole mode — the checker rejects the hole with a diagnostic naming
#     it ("unfilled typed hole");
#   apply_fill_hole — replaces the hole's recorded typed node.
pub def typed_hole_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let src = "def f() -> Int do ??? end"
  let tokens = tokenize(src, "hole_lane.tg")
  let parsed = parse(tokens)
  var program = parsed.program
  assign_node_ids(&mut program)
  let resolutions = match resolve_names(program.clone())
  when Result::Ok(r) then r
  when Result::Err(_) then
    out.push("hole-lane: resolution failed on the lane program")
    return out
  end

  # ———— hole mode: checks cleanly, constraints + typed node recorded ————
  var env = type_env_new()
  let r = type_check_typed_holes(&mut env, program.clone(), resolutions.clone())
  if !r.errors.is_empty() then
    out.push("hole-mode: expected no errors, got " + r.errors.len().to_string())
  end
  var hole_node = -1
  var holes_seen = 0
  for entry in env.hole_constraints.entries() do
    holes_seen = holes_seen + 1
    hole_node = entry.0
    match hole_constraints_of(&env, entry.0)
    when Option::Some(hc) then
      edit_lane_single_row(&mut out, "hole-expected-type", hc.expected_type.clone(), "Int".to_string())
    when Option::None then
      out.push("hole-constraints-of: expected Some, got None")
    end
    match r.program.typed.typed_exprs.get(entry.0)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Hole then ()
      when _ then out.push("hole-typed-node: expected Hole")
      end
    when Option::None then
      out.push("hole-typed-node: expected a recorded typed node, got None")
    end
    match typed_hole_constraints_of(&r.program.typed, entry.0)
    when Option::Some(hc2) then
      edit_lane_single_row(&mut out, "hole-artifact-expected-type", hc2.expected_type.clone(), "Int".to_string())
    when Option::None then
      out.push("typed-hole-constraints-of: expected Some, got None")
    end
  end
  if holes_seen != 1 then
    out.push("hole-count: expected 1 constraint record, got " + holes_seen.to_string())
  end

  # ———— non-hole mode: the hole is rejected, naming itself ————
  var env2 = type_env_new()
  let r2 = type_check_typed(&mut env2, program.clone(), resolutions.clone())
  if r2.errors.is_empty() then
    out.push("hole-reject: expected at least one error, got none")
  else
    var named = false
    var ei = 0
    while ei < r2.errors.len() do
      if r2.errors[ei].message.contains("hole") then
        named = true
      end
      ei = ei + 1
    end
    if !named then
      out.push("hole-reject: no error message names the hole")
    end
  end

  # ———— apply_fill_hole replaces the recorded typed node ————
  if hole_node >= 0 then
    var typed = r.program.typed
    let hole_key = semantic_hole_key_of("m::F#fn()->unit".to_string(), hole_node)
    var pre: Vec[String] = Vec::new()
    pre.push("hole:" + hole_key.clone())
    let resolved_fill = ResolvedEdit {
      edit: SemanticEdit::FillHole(hole_key.clone(), "42".to_string()),
      targets: Vec::from([hole_key.clone()]),
      affected: Vec::new(),
      preconditions: pre,
      expected_delta: Vec::from(["hole-filled:" + hole_key.clone()])
    }
    let replacement = TypedExpr {
      id: hole_node,
      ty: Type::Int,
      kind: TypedExprKind::Literal(hole_node)
    }
    match apply_fill_hole(&mut typed, resolved_fill, replacement)
    when Result::Ok(_) then
      match typed.typed_exprs.get(hole_node)
      when Option::Some(te2) then
        match te2.kind
        when TypedExprKind::Hole then out.push("fill-apply: typed node still Hole")
        when _ then ()
        end
      when Option::None then out.push("fill-apply: typed node missing after apply")
      end
    when Result::Err(e) then
      out.push("fill-apply: expected Ok, got " + edit_error_word(e))
    end
  end

  out
end

# ———————————————————————————————————————————————————————————————
# THE SOURCE REWRITE ENGINE (third-audit item 30)
# ———————————————————————————————————————————————————————————————
# The semantic edit protocol becomes a REAL rewrite engine: a resolved
# edit (resolve_edit above) is applied to the PARSED AST of one source
# text and the edited tree is RENDERED back to source through the
# canonical formatter. The engine is bounded and conservative:
#   Rename           — locate the declaration the resolved stable key
#                      names (by name inside the source; the stable id was
#                      already resolved), rename the declaration and
#                      every identifier/type/path occurrence whose text
#                      matches the old name. Reference-level precision is
#                      bounded by the re-validation: the regenerated source
#                      is re-parsed, re-resolved, re-type-checked and
#                      re-ownership-checked, and any edit the resolver/
#                      checker rejects fails closed with
#                      EditError::PreconditionFailed (the evidence text
#                      rides apply_edit_to_source_checked).
#   ReplaceCall      — locate the caller function the call-row key names,
#                      replace every direct call site in its body whose
#                      callee name equals the old callee with the new
#                      callee (bare name or qualified path). Indirect /
#                      intrinsic call rows are PreconditionFailed — their
#                      callee is not a name in the source.
#   InsertStatement  — parse the statement text, map the §33 anchor
#                      "<fn key>#B<block>#S<idx>" to the function's
#                      top-level body block (block 0) and splice the
#                      statement before that statement ordinal. An anchor
#                      outside the mappable surface (non-zero block,
#                      out-of-range index, non-block body) is
#                      PreconditionFailed with the reason.
#   ChangeSignature  — parse the replacement signature text and splice the
#                      declaration's name/generics/params/return/where
#                      clause. Call sites are NOT rewritten in this slice:
#                      the resolved callers ride ResolvedEdit.affected /
#                      the "callsites-to-update:<n>" precondition and the
#                      apply records a "callsites-not-updated:<n>" row.
#   ChangeContract   — stays on the snapshot surface (apply_edit).
#   FillHole         — stays on the typed-program surface (apply_fill_hole).
#
# VALIDATION DEPTH: edit_revalidate_source runs parse -> assign_node_ids
# -> resolve_names -> type_check_typed -> build_typed_cfg -> access_check
# -> resource_check, i.e. the same front-end depth compiler_core's
# analyze_source reaches (minus the macro-expansion / @cfg prologue, which
# compiler_core's prepare_parsed owns and this module cannot import without
# dragging the backend in; a source whose semantics depend on unexpanded
# macros fails closed at resolution/checking). No env gates, no driver.

# ———————————————————————————————————————————————————————————————
# Declaration sites and key-text helpers
# ———————————————————————————————————————————————————————————————

# The declaration site a resolved stable key maps to inside one parsed
# source module: a top-level item, a struct method or an impl method (the
# only three shapes the source engine rewrites).
enum EditItemSite
  EditSiteNone
  EditSiteTop(Int)
  EditSiteStructMethod(Int, Int)
  EditSiteImplMethod(Int, Int)
end

# The byte index of `needle` (any length) at or after `from` (-1 absent).
def edit_str_index(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The FINAL "::" segment of a stable key's name part ("m::A::b" -> "b").
pub def edit_key_name_segment(key: String) -> String
  let name_part = edit_name_part(&key)
  var found = -1
  var pos = name_part.len()
  while pos >= 2 do
    if name_part.slice(pos - 2, pos) == "::" then
      found = pos
      break
    end
    pos = pos - 1
  end
  if found < 0 then name_part.clone() else name_part.slice(found, name_part.len()) end
end

# The segment BEFORE the final one ("m::A::b" -> "A"; "m::A" -> "m"; a
# single-segment name -> "").
pub def edit_key_owner_segment(key: String) -> String
  let name_part = edit_name_part(&key)
  var last = -1
  var pos = name_part.len()
  while pos >= 2 do
    if name_part.slice(pos - 2, pos) == "::" then
      last = pos - 2
      break
    end
    pos = pos - 1
  end
  if last < 0 then
    return "".to_string()
  end
  let head = name_part.slice(0, last)
  var prev = -1
  var p2 = head.len()
  while p2 >= 2 do
    if head.slice(p2 - 2, p2) == "::" then
      prev = p2
      break
    end
    p2 = p2 - 1
  end
  if prev < 0 then head.clone() else head.slice(prev, head.len()) end
end

# Split a "a::b::c" text at every "::" (the callee path shape).
pub def edit_colon_segments(s: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var start = 0
  var i = 0
  while i + 2 <= s.len() do
    if s.slice(i, i + 2) == "::" then
      out.push(s.slice(start, i))
      i = i + 2
      start = i
    else
      i = i + 1
    end
  end
  out.push(s.slice(start, s.len()))
  out
end

# Split a call-row key "caller|callee|kind" at every '|'.
def edit_pipe_parts(s: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var start = 0
  var i = 0
  while i < s.len() do
    if s.slice(i, i + 1) == "|" then
      out.push(s.slice(start, i))
      start = i + 1
    end
    i = i + 1
  end
  out.push(s.slice(start, s.len()))
  out
end

# The declared name of an item ("" for the anonymous kinds: impl / extern
# block / attribute-only items).
def edit_item_decl_name(item: Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then f.name.clone()
  when ItemKind::ItemStruct(s) then s.name.clone()
  when ItemKind::ItemEnum(e) then e.name.clone()
  when ItemKind::ItemTrait(t) then t.name.clone()
  when ItemKind::ItemModule(m) then m.name.clone()
  when ItemKind::ItemTypeAlias(ta) then ta.name.clone()
  when ItemKind::ItemConst(c) then c.name.clone()
  when ItemKind::ItemStatic(s) then s.name.clone()
  when ItemKind::ItemMacro(m) then m.name.clone()
  when ItemKind::ItemCapabilityDecl(c) then c.name.clone()
  when ItemKind::ItemEffectDecl(e) then e.name.clone()
  when _ then "".to_string()
  end
end

# The first top-level item whose declared name equals `name` (a duplicate
# name is not this engine's discovery — a valid module has one).
def edit_locate_top(program: Program, name: String) -> EditItemSite
  var found = EditItemSite::EditSiteNone
  var hits = 0
  var i = 0
  while i < program.items.len() do
    if edit_item_decl_name(program.items[i]) == name then
      if hits == 0 then
        found = EditItemSite::EditSiteTop(i)
      end
      hits = hits + 1
    end
    i = i + 1
  end
  if hits == 1 then found else EditItemSite::EditSiteNone end
end

# The struct/impl method whose owner type name and method name match.
def edit_locate_method(program: Program, owner: String, name: String) -> EditItemSite
  if owner.len() == 0 then
    return EditItemSite::EditSiteNone
  end
  var i = 0
  while i < program.items.len() do
    match program.items[i].kind
    when ItemKind::ItemStruct(s) then
      if s.name == owner then
        var m = 0
        while m < s.methods.len() do
          if s.methods[m].name == name then
            return EditItemSite::EditSiteStructMethod(i, m)
          end
          m = m + 1
        end
      end
    when ItemKind::ItemImpl(im) then
      if type_expr_name(im.for_type) == owner then
        var m2 = 0
        while m2 < im.methods.len() do
          if im.methods[m2].name == name then
            return EditItemSite::EditSiteImplMethod(i, m2)
          end
          m2 = m2 + 1
        end
      end
    when _ then ()
    end
    i = i + 1
  end
  EditItemSite::EditSiteNone
end

# Locate the declaration a resolved stable key names: the owner-qualified
# method first (the stable key's "Type::method" shape), then the top-level
# declaration by final segment.
pub def edit_locate_decl(program: Program, key: String) -> EditItemSite
  let name = edit_key_name_segment(key.clone())
  let owner = edit_key_owner_segment(key.clone())
  let method = edit_locate_method(program.clone(), owner, name.clone())
  match method
  when EditItemSite::EditSiteNone then edit_locate_top(program, name)
  when _ then method
  end
end

# Locate the FUNCTION the key names (a top-level function or a method); a
# matching non-function item resolves to EditSiteNone.
def edit_locate_function_site(program: Program, key: String) -> EditItemSite
  let site = edit_locate_decl(program.clone(), key)
  match site
  when EditItemSite::EditSiteTop(i) then
    match program.items[i].kind
    when ItemKind::ItemFunction(_) then site
    when _ then EditItemSite::EditSiteNone
    end
  when _ then site
  end
end

# The declared name at a located site.
def edit_site_decl_name(program: Program, site: EditItemSite) -> String
  match site
  when EditItemSite::EditSiteTop(i) then edit_item_decl_name(program.items[i])
  when EditItemSite::EditSiteStructMethod(i, m) then
    match program.items[i].kind
    when ItemKind::ItemStruct(s) then s.methods[m].name.clone()
    when _ then "".to_string()
    end
  when EditItemSite::EditSiteImplMethod(i, m) then
    match program.items[i].kind
    when ItemKind::ItemImpl(im) then im.methods[m].name.clone()
    when _ then "".to_string()
    end
  when EditItemSite::EditSiteNone then "".to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# Rename rewriting (identity-gated, fourth-audit P0-13)
# ———————————————————————————————————————————————————————————————
# The rename context every reference walker carries: the resolver snapshot
# of the parsed source, the target declaration's registration key and the
# old/new spellings. A leaf identifier/path is rewritten ONLY when the
# resolver registration key of its node equals target_reg; binding
# patterns (locals) are never renamed by a declaration rename and pattern/
# type positions (not keyed by resolve_names) are left untouched — an edit
# whose re-validation then fails is rejected rather than falling back to
# spelling.

pub struct EditRefCtx
  resolutions: ResolvedNames
  target_reg: String
  old_name: String
  new_name: String
end

def edit_mk_expr(kind: ExprKind, like: Expr) -> Expr
  Expr { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_stmt(kind: StmtKind, like: Stmt) -> Stmt
  Stmt { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_pattern(kind: PatternKind, like: Pattern) -> Pattern
  Pattern { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_type(kind: TypeExprKind, like: TypeExpr) -> TypeExpr
  TypeExpr { kind: kind, span: like.span.clone() }
end

# Whether the context's target spelling is the segment to rewrite.
def edit_ctx_names_target(ctx: EditRefCtx, name: String) -> Bool
  name == ctx.old_name
end

# Replace the segment equal to ctx.old_name in a resolved target path (the
# caller has already established the path's identity); a path with no
# matching segment is unchanged.
def edit_rename_path(ctx: EditRefCtx, path: AstPath) -> AstPath
  var segs: Vec[String] = Vec::new()
  for seg in path.segments do
    if seg == ctx.old_name then segs.push(ctx.new_name.clone()) else segs.push(seg.clone()) end
  end
  AstPath { segments: segs, span: path.span.clone() }
end

# Effect names / alias name lists carry no resolver key in ResolvedNames;
# they are preserved (the identity boundary stated in the module doc).
def edit_rw_strings(ctx: EditRefCtx, items: Vec[String]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for it in items do
    out.push(it.clone())
  end
  out
end

def edit_rw_string_opt(ctx: EditRefCtx, item: Option[String]) -> Option[String]
  match item
  when Option::Some(s) then Option::Some(s.clone())
  when Option::None then Option::None
  end
end

def edit_rw_exprs(ctx: EditRefCtx, exprs: Vec[Expr]) -> Vec[Expr]
  var out: Vec[Expr] = Vec::new()
  var i = 0
  while i < exprs.len() do
    out.push(edit_rename_expr(ctx, exprs[i]))
    i = i + 1
  end
  out
end

def edit_rw_expr_opt(ctx: EditRefCtx, item: Option[Expr]) -> Option[Expr]
  match item
  when Option::Some(e) then Option::Some(edit_rename_expr(ctx, e))
  when Option::None then Option::None
  end
end

def edit_rw_expr_box_opt(ctx: EditRefCtx, item: Option[Box[Expr]]) -> Option[Box[Expr]]
  match item
  when Option::Some(e) then Option::Some(Box::new(edit_rename_expr(ctx, e)))
  when Option::None then Option::None
  end
end

def edit_rw_expr_field_pairs(ctx: EditRefCtx, pairs: Vec[(String, Expr)]) -> Vec[(String, Expr)]
  var out: Vec[(String, Expr)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((pairs[i].0.clone(), edit_rename_expr(ctx, pairs[i].1)))
    i = i + 1
  end
  out
end

def edit_rw_expr_pairs(ctx: EditRefCtx, pairs: Vec[(Expr, Expr)]) -> Vec[(Expr, Expr)]
  var out: Vec[(Expr, Expr)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((
      edit_rename_expr(ctx, pairs[i].0),
      edit_rename_expr(ctx, pairs[i].1)
    ))
    i = i + 1
  end
  out
end

def edit_rw_patterns(ctx: EditRefCtx, pats: Vec[Pattern]) -> Vec[Pattern]
  var out: Vec[Pattern] = Vec::new()
  var i = 0
  while i < pats.len() do
    out.push(edit_rename_pattern(ctx, pats[i]))
    i = i + 1
  end
  out
end

def edit_rw_pattern_pairs(ctx: EditRefCtx, pairs: Vec[(String, Pattern)]) -> Vec[(String, Pattern)]
  var out: Vec[(String, Pattern)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((pairs[i].0.clone(), edit_rename_pattern(ctx, pairs[i].1)))
    i = i + 1
  end
  out
end

def edit_rw_types(ctx: EditRefCtx, items: Vec[TypeExpr]) -> Vec[TypeExpr]
  var out: Vec[TypeExpr] = Vec::new()
  var i = 0
  while i < items.len() do
    out.push(edit_rename_type(ctx, items[i]))
    i = i + 1
  end
  out
end

def edit_rw_type_opt(ctx: EditRefCtx, item: Option[TypeExpr]) -> Option[TypeExpr]
  match item
  when Option::Some(t) then Option::Some(edit_rename_type(ctx, t))
  when Option::None then Option::None
  end
end

# Type positions carry no resolver key in ResolvedNames (the resolver
# leaves type_resolutions empty), so a declaration rename never rewrites a
# type spelling: the tree is rebuilt with its type names intact and the
# re-validation is the gate that rejects a stale type reference. The
# structural recursion still reaches nested expressions (const-generic
# arguments, array sizes) so a rename IS applied where a nested expression
# carries a resolved identity.
def edit_rename_type(ctx: EditRefCtx, te: TypeExpr) -> TypeExpr
  match te.kind
  when TypeExprKind::Named(name, args) then
    edit_mk_type(TypeExprKind::Named(name.clone(), edit_rw_types(ctx, args)), te)
  when TypeExprKind::ConstArg(v) then te.clone()
  when TypeExprKind::ConstExpr(e) then
    edit_mk_type(TypeExprKind::ConstExpr(edit_rename_expr(ctx, e)), te)
  when TypeExprKind::Unit then te.clone()
  when TypeExprKind::Never then te.clone()
  when TypeExprKind::Tuple(items) then
    edit_mk_type(TypeExprKind::Tuple(edit_rw_types(ctx, items)), te)
  when TypeExprKind::Array(elem, size) then
    edit_mk_type(TypeExprKind::Array(
      edit_rename_type(ctx, elem), edit_rw_expr_opt(ctx, size)), te)
  when TypeExprKind::Slice(elem) then
    edit_mk_type(TypeExprKind::Slice(edit_rename_type(ctx, elem)), te)
  when TypeExprKind::Ptr(elem) then
    edit_mk_type(TypeExprKind::Ptr(edit_rename_type(ctx, elem)), te)
  when TypeExprKind::PtrMut(elem) then
    edit_mk_type(TypeExprKind::PtrMut(edit_rename_type(ctx, elem)), te)
  when TypeExprKind::Ref(elem, is_mut) then
    edit_mk_type(TypeExprKind::Ref(edit_rename_type(ctx, elem), is_mut), te)
  when TypeExprKind::Fn(params, ret) then
    var ps: Vec[ParamTypeExpr] = Vec::new()
    var i = 0
    while i < params.len() do
      ps.push(ParamTypeExpr {
        ty: edit_rename_type(ctx, params[i].ty),
        convention: params[i].convention
      })
      i = i + 1
    end
    edit_mk_type(TypeExprKind::Fn(ps, edit_rename_type(ctx, ret)), te)
  when TypeExprKind::Async(inner) then
    edit_mk_type(TypeExprKind::Async(edit_rename_type(ctx, inner)), te)
  when TypeExprKind::Effect(name, inner) then
    edit_mk_type(TypeExprKind::Effect(name.clone(), edit_rename_type(ctx, inner)), te)
  when TypeExprKind::Path(path) then
    edit_mk_type(TypeExprKind::Path(path.clone()), te)
  when TypeExprKind::Infer then te.clone()
  end
end

def edit_rename_expr(ctx: EditRefCtx, expr: Expr) -> Expr
  match expr.kind
  when ExprKind::ExprIntLit(_) then expr.clone()
  when ExprKind::ExprFloatLit(_) then expr.clone()
  when ExprKind::ExprStringLit(_) then expr.clone()
  when ExprKind::ExprCharLit(_) then expr.clone()
  when ExprKind::ExprBoolLit(_) then expr.clone()
  when ExprKind::ExprNilLit then expr.clone()
  when ExprKind::ExprArrayLit(elems) then
    edit_mk_expr(ExprKind::ExprArrayLit(edit_rw_exprs(ctx, elems)), expr)
  when ExprKind::ExprArrayRepeat(elem, count) then
    edit_mk_expr(ExprKind::ExprArrayRepeat(
      Box::new(edit_rename_expr(ctx, elem)),
      Box::new(edit_rename_expr(ctx, count))), expr)
  when ExprKind::ExprTupleLit(elems) then
    edit_mk_expr(ExprKind::ExprTupleLit(edit_rw_exprs(ctx, elems)), expr)
  when ExprKind::ExprStructLit(path, fields) then
    # The struct construction PATH is not keyed by resolve_names (the type
    # checker resolves it): it is preserved (identity boundary).
    edit_mk_expr(ExprKind::ExprStructLit(
      path.clone(), edit_rw_expr_field_pairs(ctx, fields)), expr)
  when ExprKind::ExprMapLit(entries) then
    edit_mk_expr(ExprKind::ExprMapLit(edit_rw_expr_pairs(ctx, entries)), expr)
  when ExprKind::ExprIdent(name) then
    if name == ctx.old_name && edit_ref_is_target(&ctx.resolutions, expr.node_id, ctx.target_reg.clone()) then
      edit_mk_expr(ExprKind::ExprIdent(ctx.new_name.clone()), expr)
    else
      expr.clone()
    end
  when ExprKind::ExprPath(path) then
    if edit_ref_is_target(&ctx.resolutions, expr.node_id, ctx.target_reg.clone()) then
      edit_mk_expr(ExprKind::ExprPath(edit_rename_path(ctx, path)), expr)
    else
      expr.clone()
    end
  when ExprKind::ExprSelfRef then expr.clone()
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    edit_mk_expr(ExprKind::ExprBinaryOp(op,
      Box::new(edit_rename_expr(ctx, lhs)),
      Box::new(edit_rename_expr(ctx, rhs))), expr)
  when ExprKind::ExprUnaryOp(op, operand) then
    edit_mk_expr(ExprKind::ExprUnaryOp(op, Box::new(edit_rename_expr(ctx, operand))), expr)
  when ExprKind::ExprFieldAccess(base, field) then
    edit_mk_expr(ExprKind::ExprFieldAccess(
      Box::new(edit_rename_expr(ctx, base)), field), expr)
  when ExprKind::ExprMethodCall(recv, name, targs, args) then
    # Method-member names are resolved by the checker, not by resolve_names
    # (no resolver key exists): the member spelling is preserved.
    edit_mk_expr(ExprKind::ExprMethodCall(
      Box::new(edit_rename_expr(ctx, recv)),
      name.clone(), edit_rw_types(ctx, targs),
      edit_rw_exprs(ctx, args)), expr)
  when ExprKind::ExprIndex(base, index) then
    edit_mk_expr(ExprKind::ExprIndex(
      Box::new(edit_rename_expr(ctx, base)),
      Box::new(edit_rename_expr(ctx, index))), expr)
  when ExprKind::ExprCall(callee, args) then
    edit_mk_expr(ExprKind::ExprCall(
      Box::new(edit_rename_expr(ctx, callee)),
      edit_rw_exprs(ctx, args)), expr)
  when ExprKind::ExprClosure(params, ret, body) then
    var ps: Vec[ClosureParam] = Vec::new()
    var i = 0
    while i < params.len() do
      ps.push(ClosureParam {
        pat: edit_rename_pattern(ctx, params[i].pat),
        ty: edit_rw_type_opt(ctx, params[i].ty),
        span: params[i].span.clone()
      })
      i = i + 1
    end
    edit_mk_expr(ExprKind::ExprClosure(
      ps, edit_rw_type_opt(ctx, ret),
      Box::new(edit_rename_expr(ctx, body))), expr)
  when ExprKind::ExprAccess(inner) then
    edit_mk_expr(ExprKind::ExprAccess(Box::new(edit_rename_expr(ctx, inner))), expr)
  when ExprKind::ExprRawDeref(inner) then
    edit_mk_expr(ExprKind::ExprRawDeref(Box::new(edit_rename_expr(ctx, inner))), expr)
  when ExprKind::ExprIf(if_stmt) then
    edit_mk_expr(ExprKind::ExprIf(edit_rename_if(ctx, if_stmt)), expr)
  when ExprKind::ExprMatch(m) then
    edit_mk_expr(ExprKind::ExprMatch(edit_rename_match(ctx, m)), expr)
  when ExprKind::ExprBlock(block) then
    edit_mk_expr(ExprKind::ExprBlock(edit_rename_block(ctx, block)), expr)
  when ExprKind::ExprUnsafe(reason, block) then
    edit_mk_expr(ExprKind::ExprUnsafe(reason, edit_rename_block(ctx, block)), expr)
  when ExprKind::ExprAsync(block) then
    edit_mk_expr(ExprKind::ExprAsync(edit_rename_block(ctx, block)), expr)
  when ExprKind::ExprAwait(inner) then
    edit_mk_expr(ExprKind::ExprAwait(Box::new(edit_rename_expr(ctx, inner))), expr)
  when ExprKind::ExprTry(inner) then
    edit_mk_expr(ExprKind::ExprTry(Box::new(edit_rename_expr(ctx, inner))), expr)
  when ExprKind::ExprRange(start, stop, inclusive) then
    edit_mk_expr(ExprKind::ExprRange(
      edit_rw_expr_box_opt(ctx, start),
      edit_rw_expr_box_opt(ctx, stop), inclusive), expr)
  when ExprKind::ExprCast(inner, ty) then
    edit_mk_expr(ExprKind::ExprCast(
      Box::new(edit_rename_expr(ctx, inner)),
      edit_rename_type(ctx, ty)), expr)
  when ExprKind::ExprTypeCheck(inner, ty) then
    edit_mk_expr(ExprKind::ExprTypeCheck(
      Box::new(edit_rename_expr(ctx, inner)),
      edit_rename_type(ctx, ty)), expr)
  when ExprKind::ExprComptime(block) then
    edit_mk_expr(ExprKind::ExprComptime(edit_rename_block(ctx, block)), expr)
  when ExprKind::ExprEnumVariant(path, targs, args) then
    var new_path = path.clone()
    if edit_ref_is_target(&ctx.resolutions, expr.node_id, ctx.target_reg.clone()) then
      new_path = edit_rename_path(ctx, path)
    end
    edit_mk_expr(ExprKind::ExprEnumVariant(
      new_path, edit_rw_types(ctx, targs),
      edit_rw_exprs(ctx, args)), expr)
  when ExprKind::ExprAssign(target, value) then
    edit_mk_expr(ExprKind::ExprAssign(
      Box::new(edit_rename_expr(ctx, target)),
      Box::new(edit_rename_expr(ctx, value))), expr)
  when ExprKind::ExprPipe(lhs, rhs) then
    edit_mk_expr(ExprKind::ExprPipe(
      Box::new(edit_rename_expr(ctx, lhs)),
      Box::new(edit_rename_expr(ctx, rhs))), expr)
  when ExprKind::ExprMacroCall(name, args) then
    edit_mk_expr(ExprKind::ExprMacroCall(name.clone(), edit_rw_exprs(ctx, args)), expr)
  when ExprKind::ExprHole then expr.clone()
  when ExprKind::ExprError(_) then expr.clone()
  end
end

# Pattern BINDINGS are local binders: a declaration rename never rewrites
# a PatternKind::Ident spelling (nested shadowing is preserved). Struct/
# variant pattern PATHS carry no resolver key in ResolvedNames, so they
# are preserved as well; only literal/range expressions recurse (their
# identifiers can be resolved target references).
def edit_rename_pattern(ctx: EditRefCtx, pat: Pattern) -> Pattern
  match pat.kind
  when PatternKind::Wildcard then pat.clone()
  when PatternKind::Ident(_, _) then pat.clone()
  when PatternKind::Literal(e) then
    edit_mk_pattern(PatternKind::Literal(edit_rename_expr(ctx, e)), pat)
  when PatternKind::Tuple(items) then
    edit_mk_pattern(PatternKind::Tuple(edit_rw_patterns(ctx, items)), pat)
  when PatternKind::Array(items) then
    edit_mk_pattern(PatternKind::Array(edit_rw_patterns(ctx, items)), pat)
  when PatternKind::Struct(path, fields) then
    edit_mk_pattern(PatternKind::Struct(
      path.clone(),
      edit_rw_pattern_pairs(ctx, fields)), pat)
  when PatternKind::Variant(path, items) then
    edit_mk_pattern(PatternKind::Variant(
      path.clone(),
      edit_rw_patterns(ctx, items)), pat)
  when PatternKind::Or(items) then
    edit_mk_pattern(PatternKind::Or(edit_rw_patterns(ctx, items)), pat)
  when PatternKind::Range(lo, hi, inclusive) then
    edit_mk_pattern(PatternKind::Range(
      edit_rw_expr_opt(ctx, lo),
      edit_rw_expr_opt(ctx, hi), inclusive), pat)
  end
end

def edit_rename_block(ctx: EditRefCtx, block: Block) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    stmts.push(edit_rename_stmt(ctx, block.stmts[i]))
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

def edit_rename_guard_else(ctx: EditRefCtx, action: GuardElse) -> GuardElse
  match action
  when GuardElse::Return(v) then GuardElse::Return(edit_rw_expr_opt(ctx, v))
  when GuardElse::Panic(msg) then GuardElse::Panic(msg.clone())
  when GuardElse::Break(v) then GuardElse::Break(edit_rw_expr_opt(ctx, v))
  when GuardElse::Continue then GuardElse::Continue
  end
end

def edit_rename_if(ctx: EditRefCtx, if_stmt: IfStmt) -> IfStmt
  var elsifs: Vec[(Expr, Block)] = Vec::new()
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    elsifs.push((
      edit_rename_expr(ctx, if_stmt.elsif_branches[i].0),
      edit_rename_block(ctx, if_stmt.elsif_branches[i].1)
    ))
    i = i + 1
  end
  var else_block: Option[Block] = Option::None
  match if_stmt.else_block
  when Option::Some(b) then else_block = Option::Some(edit_rename_block(ctx, b))
  when Option::None then ()
  end
  IfStmt {
    cond: edit_rename_expr(ctx, if_stmt.cond),
    then_block: edit_rename_block(ctx, if_stmt.then_block),
    elsif_branches: elsifs,
    else_block: else_block,
    span: if_stmt.span.clone()
  }
end

def edit_rename_match(ctx: EditRefCtx, m: MatchExpr) -> MatchExpr
  var arms: Vec[MatchArm] = Vec::new()
  var i = 0
  while i < m.arms.len() do
    arms.push(MatchArm {
      pattern: edit_rename_pattern(ctx, m.arms[i].pattern),
      guard_expr: edit_rw_expr_opt(ctx, m.arms[i].guard_expr),
      body: edit_rename_block(ctx, m.arms[i].body),
      span: m.arms[i].span.clone()
    })
    i = i + 1
  end
  MatchExpr {
    scrutinee: edit_rename_expr(ctx, m.scrutinee),
    arms: arms,
    span: m.span.clone()
  }
end

def edit_rename_stmt(ctx: EditRefCtx, stmt: Stmt) -> Stmt
  match stmt.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    edit_mk_stmt(StmtKind::StmtLet(
      edit_rename_pattern(ctx, pat),
      edit_rw_type_opt(ctx, ty),
      edit_rename_expr(ctx, value), is_mut), stmt)
  when StmtKind::StmtAssign(target, value) then
    edit_mk_stmt(StmtKind::StmtAssign(
      edit_rename_expr(ctx, target),
      edit_rename_expr(ctx, value)), stmt)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    edit_mk_stmt(StmtKind::StmtCompoundAssign(op,
      edit_rename_expr(ctx, target),
      edit_rename_expr(ctx, value)), stmt)
  when StmtKind::StmtIf(if_stmt) then
    edit_mk_stmt(StmtKind::StmtIf(edit_rename_if(ctx, if_stmt)), stmt)
  when StmtKind::StmtMatch(m) then
    edit_mk_stmt(StmtKind::StmtMatch(edit_rename_match(ctx, m)), stmt)
  when StmtKind::StmtWhile(cond, body) then
    edit_mk_stmt(StmtKind::StmtWhile(
      edit_rename_expr(ctx, cond),
      edit_rename_block(ctx, body)), stmt)
  when StmtKind::StmtFor(for_stmt) then
    edit_mk_stmt(StmtKind::StmtFor(ForStmt {
      pattern: edit_rename_pattern(ctx, for_stmt.pattern),
      iter: edit_rename_expr(ctx, for_stmt.iter),
      body: edit_rename_block(ctx, for_stmt.body),
      span: for_stmt.span.clone()
    }), stmt)
  when StmtKind::StmtLoop(body) then
    edit_mk_stmt(StmtKind::StmtLoop(edit_rename_block(ctx, body)), stmt)
  when StmtKind::StmtReturn(v) then
    edit_mk_stmt(StmtKind::StmtReturn(edit_rw_expr_opt(ctx, v)), stmt)
  when StmtKind::StmtBreak(v) then
    edit_mk_stmt(StmtKind::StmtBreak(edit_rw_expr_opt(ctx, v)), stmt)
  when StmtKind::StmtContinue then stmt.clone()
  when StmtKind::StmtExpr(e) then
    edit_mk_stmt(StmtKind::StmtExpr(edit_rename_expr(ctx, e)), stmt)
  when StmtKind::StmtUnsafe(reason, body) then
    edit_mk_stmt(StmtKind::StmtUnsafe(reason, edit_rename_block(ctx, body)), stmt)
  when StmtKind::StmtDefer(body) then
    edit_mk_stmt(StmtKind::StmtDefer(edit_rename_block(ctx, body)), stmt)
  when StmtKind::StmtGuard(cond, action) then
    edit_mk_stmt(StmtKind::StmtGuard(
      edit_rename_expr(ctx, cond),
      edit_rename_guard_else(ctx, action)), stmt)
  when StmtKind::StmtTry(body, catches, finally_block) then
    var cs: Vec[CatchArm] = Vec::new()
    var i = 0
    while i < catches.len() do
      cs.push(CatchArm {
        pattern: edit_rename_pattern(ctx, catches[i].pattern),
        body: edit_rename_block(ctx, catches[i].body),
        span: catches[i].span.clone()
      })
      i = i + 1
    end
    var fb: Option[Block] = Option::None
    match finally_block
    when Option::Some(b) then fb = Option::Some(edit_rename_block(ctx, b))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtTry(
      edit_rename_block(ctx, body), cs, fb), stmt)
  when StmtKind::StmtWith(e, pat, body) then
    edit_mk_stmt(StmtKind::StmtWith(
      edit_rename_expr(ctx, e),
      edit_rename_pattern(ctx, pat),
      edit_rename_block(ctx, body)), stmt)
  when StmtKind::StmtHandleWith(e, handlers) then
    var hs: Vec[EffectHandler] = Vec::new()
    var i2 = 0
    while i2 < handlers.len() do
      var arms: Vec[HandlerArm] = Vec::new()
      var j = 0
      while j < handlers[i2].arms.len() do
        arms.push(HandlerArm {
          operation: handlers[i2].arms[j].operation.clone(),
          params: edit_rw_patterns(ctx, handlers[i2].arms[j].params),
          body: edit_rename_block(ctx, handlers[i2].arms[j].body),
          span: handlers[i2].arms[j].span.clone()
        })
        j = j + 1
      end
      hs.push(EffectHandler {
        effect_name: handlers[i2].effect_name.clone(),
        arms: arms,
        span: handlers[i2].span.clone()
      })
      i2 = i2 + 1
    end
    edit_mk_stmt(StmtKind::StmtHandleWith(
      edit_rename_expr(ctx, e), hs), stmt)
  end
end

# ———————————————————————————————————————————————————————————————
# Function / item reference rewriting
# ———————————————————————————————————————————————————————————————

def edit_rename_generic_params(ctx: EditRefCtx, gps: Vec[GenericParam]) -> Vec[GenericParam]
  var out: Vec[GenericParam] = Vec::new()
  var i = 0
  while i < gps.len() do
    let gp = gps[i]
    let kind = match gp.kind
    when GenericParamKind::ConstParam(te) then
      GenericParamKind::ConstParam(edit_rename_type(ctx, te))
    when _ then gp.kind.clone()
    end
    out.push(GenericParam {
      name: gp.name.clone(),
      kind: kind,
      bounds: edit_rw_types(ctx, gp.bounds),
      default: edit_rw_type_opt(ctx, gp.default),
      const_range: gp.const_range.clone(),
      span: gp.span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_params(ctx: EditRefCtx, params: Vec[Param]) -> Vec[Param]
  var out: Vec[Param] = Vec::new()
  var i = 0
  while i < params.len() do
    out.push(Param {
      convention: params[i].convention,
      name: params[i].name.clone(),
      ty: edit_rw_type_opt(ctx, params[i].ty),
      default: edit_rw_expr_opt(ctx, params[i].default),
      span: params[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_where(ctx: EditRefCtx, wc: Vec[WherePredicate]) -> Vec[WherePredicate]
  var out: Vec[WherePredicate] = Vec::new()
  var i = 0
  while i < wc.len() do
    out.push(WherePredicate {
      ty: edit_rename_type(ctx, wc[i].ty),
      bounds: edit_rw_types(ctx, wc[i].bounds),
      span: wc[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_contracts(ctx: EditRefCtx, contracts: Vec[ContractClause]) -> Vec[ContractClause]
  var out: Vec[ContractClause] = Vec::new()
  var i = 0
  while i < contracts.len() do
    out.push(ContractClause {
      kind: contracts[i].kind,
      expr: edit_rename_expr(ctx, contracts[i].expr),
      message: contracts[i].message.clone(),
      span: contracts[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_fnbody(ctx: EditRefCtx, body: FnBody) -> FnBody
  match body
  when FnBody::FnBlock(b) then FnBody::FnBlock(edit_rename_block(ctx, b))
  when FnBody::FnExpr(e) then FnBody::FnExpr(edit_rename_expr(ctx, e))
  when FnBody::FnExtern(name) then FnBody::FnExtern(name.clone())
  when FnBody::FnNone then FnBody::FnNone
  end
end

# A function's references (body / contracts / parameter defaults / generic
# bounds), preserving its declared name.
def edit_rename_function_refs(ctx: EditRefCtx, f: FunctionDecl) -> FunctionDecl
  FunctionDecl {
    vis: f.vis,
    name: f.name.clone(),
    generic_params: edit_rename_generic_params(ctx, f.generic_params),
    params: edit_rename_params(ctx, f.params),
    ret_type: edit_rw_type_opt(ctx, f.ret_type),
    where_clause: edit_rename_where(ctx, f.where_clause),
    body: edit_rename_fnbody(ctx, f.body),
    is_async: f.is_async,
    is_unsafe: f.is_unsafe,
    is_const: f.is_const,
    is_inline: f.is_inline,
    is_pure: f.is_pure,
    contracts: edit_rename_contracts(ctx, f.contracts),
    budget_val: f.budget_val.clone(),
    required_caps: f.required_caps.clone(),
    effects: edit_rw_strings(ctx, f.effects),
    span: f.span.clone()
  }
end

def edit_rename_item_refs(ctx: EditRefCtx, item: Item) -> Item
  let kind = match item.kind
  when ItemKind::ItemFunction(f) then
    ItemKind::ItemFunction(edit_rename_function_refs(ctx, f))
  when ItemKind::ItemStruct(s) then
    var fields: Vec[FieldDecl] = Vec::new()
    var i = 0
    while i < s.fields.len() do
      fields.push(FieldDecl {
        vis: s.fields[i].vis,
        name: s.fields[i].name.clone(),
        ty: edit_rename_type(ctx, s.fields[i].ty),
        default: edit_rw_expr_opt(ctx, s.fields[i].default),
        span: s.fields[i].span.clone()
      })
      i = i + 1
    end
    var methods: Vec[FunctionDecl] = Vec::new()
    var j = 0
    while j < s.methods.len() do
      methods.push(edit_rename_function_refs(ctx, s.methods[j]))
      j = j + 1
    end
    ItemKind::ItemStruct(StructDecl {
      vis: s.vis, name: s.name.clone(),
      generic_params: edit_rename_generic_params(ctx, s.generic_params),
      fields: fields, methods: methods, derives: s.derives.clone(),
      kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
    })
  when ItemKind::ItemEnum(e) then
    var variants: Vec[VariantDecl] = Vec::new()
    var i2 = 0
    while i2 < e.variants.len() do
      let v = e.variants[i2]
      var field_names: Vec[Option[String]] = Vec::new()
      for fname in v.field_names do
        field_names.push(fname.clone())
      end
      variants.push(VariantDecl {
        name: v.name.clone(),
        fields: edit_rw_types(ctx, v.fields),
        field_names: field_names,
        discriminant: edit_rw_expr_opt(ctx, v.discriminant),
        span: v.span.clone()
      })
      i2 = i2 + 1
    end
    ItemKind::ItemEnum(EnumDecl {
      vis: e.vis, name: e.name.clone(),
      generic_params: edit_rename_generic_params(ctx, e.generic_params),
      variants: variants, derives: e.derives.clone(),
      layout_attrs: e.layout_attrs.clone(), span: e.span.clone()
    })
  when ItemKind::ItemTrait(t) then
    var methods2: Vec[TraitMethod] = Vec::new()
    var k = 0
    while k < t.methods.len() do
      let tm = t.methods[k]
      methods2.push(TraitMethod {
        sig: FunctionSig {
          name: tm.sig.name.clone(),
          generic_params: edit_rename_generic_params(ctx, tm.sig.generic_params),
          params: edit_rename_params(ctx, tm.sig.params),
          ret_type: edit_rw_type_opt(ctx, tm.sig.ret_type),
          span: tm.sig.span.clone()
        },
        default_body: edit_rename_fnbody(ctx, tm.default_body),
        span: tm.span.clone()
      })
      k = k + 1
    end
    var assoc: Vec[AssocType] = Vec::new()
    var a = 0
    while a < t.assoc_types.len() do
      assoc.push(AssocType {
        name: t.assoc_types[a].name.clone(),
        bounds: edit_rw_types(ctx, t.assoc_types[a].bounds),
        default: edit_rw_type_opt(ctx, t.assoc_types[a].default),
        span: t.assoc_types[a].span.clone()
      })
      a = a + 1
    end
    ItemKind::ItemTrait(TraitDecl {
      vis: t.vis, name: t.name.clone(),
      generic_params: edit_rename_generic_params(ctx, t.generic_params),
      super_traits: edit_rw_types(ctx, t.super_traits),
      methods: methods2, assoc_types: assoc, span: t.span.clone()
    })
  when ItemKind::ItemImpl(im) then
    var impl_methods: Vec[FunctionDecl] = Vec::new()
    var imi = 0
    while imi < im.methods.len() do
      impl_methods.push(edit_rename_function_refs(ctx, im.methods[imi]))
      imi = imi + 1
    end
    var impl_assoc: Vec[AssocTypeImpl] = Vec::new()
    var ai = 0
    while ai < im.assoc_types.len() do
      impl_assoc.push(AssocTypeImpl {
        name: im.assoc_types[ai].name.clone(),
        ty: edit_rename_type(ctx, im.assoc_types[ai].ty),
        span: im.assoc_types[ai].span.clone()
      })
      ai = ai + 1
    end
    ItemKind::ItemImpl(ImplDecl {
      vis: im.vis,
      generic_params: edit_rename_generic_params(ctx, im.generic_params),
      trait_name: edit_rw_string_opt(ctx, im.trait_name),
      trait_type_args: edit_rw_types(ctx, im.trait_type_args),
      for_type: edit_rename_type(ctx, im.for_type),
      self_type: edit_rename_type(ctx, im.self_type),
      where_clause: edit_rename_where(ctx, im.where_clause),
      methods: impl_methods, assoc_types: impl_assoc, span: im.span.clone()
    })
  when ItemKind::ItemModule(m) then
    ItemKind::ItemModule(ModuleDecl {
      vis: m.vis, name: m.name.clone(),
      items: edit_rename_items_refs(ctx, m.items),
      is_inline: m.is_inline, span: m.span.clone()
    })
  when ItemKind::ItemUse(u) then
    var names: Option[Vec[String]] = Option::None
    match u.names
    when Option::Some(ns) then names = Option::Some(edit_rw_strings(ctx, ns))
    when Option::None then ()
    end
    ItemKind::ItemUse(UseDecl {
      vis: u.vis, path: u.path.clone(),
      alias_name: u.alias_name.clone(), names: names, glob: u.glob, span: u.span.clone()
    })
  when ItemKind::ItemMacro(m) then
    ItemKind::ItemMacro(MacroDecl {
      vis: m.vis, name: m.name.clone(),
      params: edit_rename_params(ctx, m.params),
      body: edit_rename_block(ctx, m.body), span: m.span.clone()
    })
  when ItemKind::ItemTypeAlias(ta) then
    ItemKind::ItemTypeAlias(TypeAliasDecl {
      vis: ta.vis, name: ta.name.clone(),
      generic_params: edit_rename_generic_params(ctx, ta.generic_params),
      ty: edit_rename_type(ctx, ta.ty), span: ta.span.clone()
    })
  when ItemKind::ItemConst(c) then
    ItemKind::ItemConst(ConstDecl {
      vis: c.vis, name: c.name.clone(),
      ty: edit_rw_type_opt(ctx, c.ty),
      value: edit_rename_expr(ctx, c.value), span: c.span.clone()
    })
  when ItemKind::ItemStatic(s) then
    ItemKind::ItemStatic(StaticDecl {
      vis: s.vis, name: s.name.clone(),
      ty: edit_rename_type(ctx, s.ty),
      value: edit_rename_expr(ctx, s.value),
      is_mut: s.is_mut, span: s.span.clone()
    })
  when ItemKind::ItemCapabilityDecl(c) then
    ItemKind::ItemCapabilityDecl(CapabilityDecl {
      vis: c.vis, name: c.name.clone(),
      parent: edit_rw_string_opt(ctx, c.parent),
      permissions: c.permissions.clone(), span: c.span.clone()
    })
  when ItemKind::ItemEffectDecl(e) then
    var ops: Vec[EffectOpSig] = Vec::new()
    var oi = 0
    while oi < e.ops.len() do
      var op_params: Vec[EffectOpParamSig] = Vec::new()
      var pi = 0
      while pi < e.ops[oi].params.len() do
        op_params.push(EffectOpParamSig {
          name: e.ops[oi].params[pi].name.clone(),
          ty: edit_rename_type(ctx, e.ops[oi].params[pi].ty)
        })
        pi = pi + 1
      end
      ops.push(EffectOpSig {
        name: e.ops[oi].name.clone(), params: op_params,
        ret: edit_rw_type_opt(ctx, e.ops[oi].ret),
        span: e.ops[oi].span.clone()
      })
      oi = oi + 1
    end
    ItemKind::ItemEffectDecl(EffectDecl {
      vis: e.vis, name: e.name.clone(),
      parent: edit_rw_string_opt(ctx, e.parent),
      ops: ops, span: e.span.clone()
    })
  when ItemKind::ItemExternBlock(ext) then
    var ext_items: Vec[ExternItem] = Vec::new()
    var ei = 0
    while ei < ext.items.len() do
      match ext.items[ei]
      when ExternItem::Function(ef) then
        ext_items.push(ExternItem::Function(ExternFn {
          name: ef.name.clone(),
          generic_params: edit_rename_generic_params(ctx, ef.generic_params),
          params: edit_rename_params(ctx, ef.params),
          variadic: ef.variadic,
          ret_type: edit_rw_type_opt(ctx, ef.ret_type),
          span: ef.span.clone()
        }))
      when ExternItem::Static(es) then
        ext_items.push(ExternItem::Static(ExternStatic {
          name: es.name.clone(),
          ty: edit_rename_type(ctx, es.ty),
          is_mut: es.is_mut, span: es.span.clone()
        }))
      end
      ei = ei + 1
    end
    ItemKind::ItemExternBlock(ExternBlock {
      abi: ext.abi.clone(), items: ext_items, span: ext.span.clone()
    })
  when ItemKind::ItemRationaleBlock(r) then
    ItemKind::ItemRationaleBlock(RationaleBlock {
      title: r.title.clone(), body: r.body.clone(),
      author: r.author.clone(), tags: r.tags.clone(), span: r.span.clone()
    })
  when ItemKind::ItemEditionDecl(ed) then
    ItemKind::ItemEditionDecl(EditionDecl { version: ed.version.clone(), span: ed.span.clone() })
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

def edit_rename_items_refs(ctx: EditRefCtx, items: Vec[Item]) -> Vec[Item]
  var out: Vec[Item] = Vec::new()
  var i = 0
  while i < items.len() do
    out.push(edit_rename_item_refs(ctx, items[i]))
    i = i + 1
  end
  out
end

def edit_rename_item_name(item: Item, new_name: String) -> Item
  let kind = match item.kind
  when ItemKind::ItemFunction(f) then
    var f2 = f
    f2.name = new_name.clone()
    ItemKind::ItemFunction(f2)
  when ItemKind::ItemStruct(s) then
    var s2 = s
    s2.name = new_name.clone()
    ItemKind::ItemStruct(s2)
  when ItemKind::ItemEnum(e) then
    var e2 = e
    e2.name = new_name.clone()
    ItemKind::ItemEnum(e2)
  when ItemKind::ItemTrait(t) then
    var t2 = t
    t2.name = new_name.clone()
    ItemKind::ItemTrait(t2)
  when ItemKind::ItemModule(m) then
    var m2 = m
    m2.name = new_name.clone()
    ItemKind::ItemModule(m2)
  when ItemKind::ItemTypeAlias(ta) then
    var ta2 = ta
    ta2.name = new_name.clone()
    ItemKind::ItemTypeAlias(ta2)
  when ItemKind::ItemConst(c) then
    var c2 = c
    c2.name = new_name.clone()
    ItemKind::ItemConst(c2)
  when ItemKind::ItemStatic(s) then
    var s3 = s
    s3.name = new_name.clone()
    ItemKind::ItemStatic(s3)
  when ItemKind::ItemMacro(m) then
    var m3 = m
    m3.name = new_name.clone()
    ItemKind::ItemMacro(m3)
  when ItemKind::ItemCapabilityDecl(c) then
    var c3 = c
    c3.name = new_name.clone()
    ItemKind::ItemCapabilityDecl(c3)
  when ItemKind::ItemEffectDecl(e) then
    var e3 = e
    e3.name = new_name.clone()
    ItemKind::ItemEffectDecl(e3)
  when _ then item.kind.clone()
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

def edit_replace_function(vec: Vec[FunctionDecl], idx: Int, val: FunctionDecl) -> Vec[FunctionDecl]
  var out: Vec[FunctionDecl] = Vec::new()
  var i = 0
  while i < vec.len() do
    if i == idx then out.push(val.clone()) else out.push(vec[i].clone()) end
    i = i + 1
  end
  out
end

def edit_rename_method_at(item: Item, m_index: Int, new_name: String) -> Item
  let kind = match item.kind
  when ItemKind::ItemStruct(s) then
    var methods = s.methods.clone()
    var meth = methods[m_index]
    meth.name = new_name.clone()
    methods = edit_replace_function(methods, m_index, meth)
    ItemKind::ItemStruct(StructDecl {
      vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
      fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
      kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
    })
  when ItemKind::ItemImpl(im) then
    var methods2 = im.methods.clone()
    var meth2 = methods2[m_index]
    meth2.name = new_name.clone()
    methods2 = edit_replace_function(methods2, m_index, meth2)
    ItemKind::ItemImpl(ImplDecl {
      vis: im.vis, generic_params: im.generic_params.clone(),
      trait_name: im.trait_name.clone(), trait_type_args: im.trait_type_args.clone(),
      for_type: im.for_type.clone(), self_type: im.self_type.clone(),
      where_clause: im.where_clause.clone(), methods: methods2,
      assoc_types: im.assoc_types.clone(), span: im.span.clone()
    })
  when _ then item.kind.clone()
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

# The declared-name registration key of an item ("" for items that declare
# no registered name). The module path is threaded by the walker.
def edit_item_identity_reg(item: Item, module_path: Vec[String]) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then edit_reg_key_text(module_path, f.name.clone())
  when ItemKind::ItemStruct(s) then edit_reg_key_text(module_path, s.name.clone())
  when ItemKind::ItemEnum(e) then edit_reg_key_text(module_path, e.name.clone())
  when ItemKind::ItemTrait(t) then edit_reg_key_text(module_path, t.name.clone())
  when ItemKind::ItemTypeAlias(ta) then edit_reg_key_text(module_path, ta.name.clone())
  when ItemKind::ItemConst(c) then edit_reg_key_text(module_path, c.name.clone())
  when ItemKind::ItemStatic(s) then edit_reg_key_text(module_path, s.name.clone())
  when ItemKind::ItemMacro(m) then edit_reg_key_text(module_path, m.name.clone())
  when ItemKind::ItemCapabilityDecl(c) then edit_reg_key_text(module_path, c.name.clone())
  when ItemKind::ItemEffectDecl(e) then edit_reg_key_text(module_path, e.name.clone())
  when _ then ""
  end
end

# The number of methods an item owns (0 for non-struct/impl kinds).
def edit_item_method_count(item: Item) -> Int
  match item.kind
  when ItemKind::ItemStruct(s) then s.methods.len()
  when ItemKind::ItemImpl(im) then im.methods.len()
  when _ then 0
  end
end

# The registration key of the item's method m_index ("Struct::method" /
# "ForType::method" under the item's module path).
def edit_item_method_reg(item: Item, module_path: Vec[String], m_index: Int) -> String
  match item.kind
  when ItemKind::ItemStruct(s) then
    edit_reg_key_text(module_path, s.name.clone() + "::" + s.methods[m_index].name.clone())
  when ItemKind::ItemImpl(im) then
    edit_reg_key_text(module_path, type_expr_name(im.for_type) + "::" + im.methods[m_index].name.clone())
  when _ then ""
  end
end

# The identity-based declaration walk (P0-13): every item's references are
# rewritten through the resolver-gated context, the declaration whose
# registration key equals the target is renamed (a top-level/nested item
# or one struct/impl method), and modules recurse with their path segment.
# Returns the rebuilt item vector; `hits` counts the renamed declarations.
def edit_rename_items(ctx: EditRefCtx, items: Vec[Item], module_path: Vec[String], inout hits: Int) -> Vec[Item]
  var out: Vec[Item] = Vec::new()
  var i = 0
  while i < items.len() do
    var cur = items[i]
    let decl_reg = edit_item_identity_reg(cur.clone(), module_path.clone())
    if decl_reg.len() > 0 && stable_key_eq(decl_reg.clone(), ctx.target_reg.clone()) then
      cur = edit_rename_item_name(cur, ctx.new_name.clone())
      hits = hits + 1
    else
      let mcount = edit_item_method_count(cur.clone())
      var mi = 0
      while mi < mcount do
        let mreg = edit_item_method_reg(cur.clone(), module_path.clone(), mi)
        if mreg.len() > 0 && stable_key_eq(mreg, ctx.target_reg.clone()) then
          cur = edit_rename_method_at(cur, mi, ctx.new_name.clone())
          hits = hits + 1
        end
        mi = mi + 1
      end
    end
    match cur.kind
    when ItemKind::ItemModule(m) then
      var inner_path = module_path.clone()
      inner_path.push(m.name.clone())
      let new_items = edit_rename_items(ctx, m.items, inner_path, hits)
      cur = Item {
        kind: ItemKind::ItemModule(ModuleDecl {
          vis: m.vis, name: m.name.clone(), items: new_items,
          is_inline: m.is_inline, span: m.span.clone()
        }),
        attrs: cur.attrs.clone(), span: cur.span.clone(),
        is_pub: cur.is_pub, owner_module: cur.owner_module
      }
    when _ then ()
    end
    out.push(edit_rename_item_refs(ctx, cur))
    i = i + 1
  end
  out
end

# The whole-program identity rename entry: returns the edited program and
# the renamed-declaration hit count (0 = the declaration is not in this
# source — the caller fails closed).
pub def edit_rename_program_identity(
  program: Program, resolutions: ResolvedNames, target_key: String, new_name: String
) -> (Program, Int)
  let ctx = EditRefCtx {
    resolutions: resolutions,
    target_reg: edit_name_part(&target_key),
    old_name: edit_key_name_segment(target_key.clone()),
    new_name: new_name
  }
  var hits = 0
  let new_items = edit_rename_items(&ctx, program.items, Vec::new(), &mut hits)
  (Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }, hits)
end

# ———————————————————————————————————————————————————————————————
# ReplaceCall rewriting (direct call sites in the caller body)
# ———————————————————————————————————————————————————————————————

def edit_new_callee(like: Expr, new_name: String, new_segs: Vec[String]) -> Expr
  if new_segs.len() <= 1 then
    Expr { kind: ExprKind::ExprIdent(new_name.clone()), span: like.span.clone(), node_id: 0 }
  else
    var segs: Vec[String] = Vec::new()
    for s in new_segs do
      segs.push(s.clone())
    end
    Expr {
      kind: ExprKind::ExprPath(AstPath { segments: segs, span: like.span.clone() }),
      span: like.span.clone(),
      node_id: 0
    }
  end
end

# The ReplaceCall context: the resolver snapshot of the parsed source, the
# OLD callee's registration key (from the call row's callee component) and
# the new callee render. A call site is rewritten exactly when the callee
# node's resolver call target carries the old registration key.
pub struct EditCallCtx
  resolutions: ResolvedNames
  old_callee_reg: String
  new_name: String
  new_segs: Vec[String]
end

# The node the resolver keyed a call target under, given the callee
# expression (mirrors types.tg's typed_callee_target_node): an ident / path
# callee is its own node; an access wrapper and an explicit-generic index
# callee resolve through their inner node; -1 for callee shapes that carry
# no resolver key.
pub def edit_callee_target_node(callee: Expr) -> Int
  match callee.kind
  when ExprKind::ExprIdent(_) then callee.node_id
  when ExprKind::ExprPath(_) then callee.node_id
  when ExprKind::ExprAccess(inner) then edit_callee_target_node(inner)
  when ExprKind::ExprIndex(base, _) then edit_callee_target_node(base)
  when _ then -1
  end
end

def edit_replace_callee(ctx: EditCallCtx, callee: Expr, inout count: Int) -> Expr
  let target_node = edit_callee_target_node(callee.clone())
  if target_node >= 0 &&
     edit_ref_is_target(&ctx.resolutions, target_node, ctx.old_callee_reg.clone()) then
    count = count + 1
    return edit_new_callee(callee, ctx.new_name.clone(), ctx.new_segs.clone())
  end
  match callee.kind
  when ExprKind::ExprIdent(_) then callee.clone()
  when ExprKind::ExprPath(_) then callee.clone()
  when _ then
    edit_replace_calls_expr(ctx, callee, count)
  end
end

def edit_replace_calls_exprs(ctx: EditCallCtx, exprs: Vec[Expr], inout count: Int) -> Vec[Expr]
  var out: Vec[Expr] = Vec::new()
  var i = 0
  while i < exprs.len() do
    out.push(edit_replace_calls_expr(ctx, exprs[i], count))
    i = i + 1
  end
  out
end

def edit_replace_calls_expr(ctx: EditCallCtx, expr: Expr, inout count: Int) -> Expr
  match expr.kind
  when ExprKind::ExprIntLit(_) then expr.clone()
  when ExprKind::ExprFloatLit(_) then expr.clone()
  when ExprKind::ExprStringLit(_) then expr.clone()
  when ExprKind::ExprCharLit(_) then expr.clone()
  when ExprKind::ExprBoolLit(_) then expr.clone()
  when ExprKind::ExprNilLit then expr.clone()
  when ExprKind::ExprIdent(_) then expr.clone()
  when ExprKind::ExprSelfRef then expr.clone()
  when ExprKind::ExprHole then expr.clone()
  when ExprKind::ExprError(_) then expr.clone()
  when ExprKind::ExprPath(_) then expr.clone()
  when ExprKind::ExprArrayLit(elems) then
    edit_mk_expr(ExprKind::ExprArrayLit(
      edit_replace_calls_exprs(ctx, elems, count)), expr)
  when ExprKind::ExprArrayRepeat(elem, n) then
    edit_mk_expr(ExprKind::ExprArrayRepeat(
      Box::new(edit_replace_calls_expr(ctx, elem, count)),
      Box::new(edit_replace_calls_expr(ctx, n, count))), expr)
  when ExprKind::ExprTupleLit(elems) then
    edit_mk_expr(ExprKind::ExprTupleLit(
      edit_replace_calls_exprs(ctx, elems, count)), expr)
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields: Vec[(String, Expr)] = Vec::new()
    var fi = 0
    while fi < fields.len() do
      new_fields.push((fields[fi].0.clone(),
        edit_replace_calls_expr(ctx, fields[fi].1, count)))
      fi = fi + 1
    end
    edit_mk_expr(ExprKind::ExprStructLit(path, new_fields), expr)
  when ExprKind::ExprMapLit(entries) then
    var new_entries: Vec[(Expr, Expr)] = Vec::new()
    var mi = 0
    while mi < entries.len() do
      new_entries.push((
        edit_replace_calls_expr(ctx, entries[mi].0, count),
        edit_replace_calls_expr(ctx, entries[mi].1, count)
      ))
      mi = mi + 1
    end
    edit_mk_expr(ExprKind::ExprMapLit(new_entries), expr)
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    edit_mk_expr(ExprKind::ExprBinaryOp(op,
      Box::new(edit_replace_calls_expr(ctx, lhs, count)),
      Box::new(edit_replace_calls_expr(ctx, rhs, count))), expr)
  when ExprKind::ExprUnaryOp(op, operand) then
    edit_mk_expr(ExprKind::ExprUnaryOp(op,
      Box::new(edit_replace_calls_expr(ctx, operand, count))), expr)
  when ExprKind::ExprFieldAccess(base, field) then
    edit_mk_expr(ExprKind::ExprFieldAccess(
      Box::new(edit_replace_calls_expr(ctx, base, count)), field), expr)
  when ExprKind::ExprMethodCall(recv, name, targs, args) then
    # Method-member names carry no resolver call target (method resolution
    # is the checker's): the member spelling is preserved (identity
    # boundary), while receiver/args still traverse.
    edit_mk_expr(ExprKind::ExprMethodCall(
      Box::new(edit_replace_calls_expr(ctx, recv, count)),
      name, targs,
      edit_replace_calls_exprs(ctx, args, count)), expr)
  when ExprKind::ExprIndex(base, index) then
    edit_mk_expr(ExprKind::ExprIndex(
      Box::new(edit_replace_calls_expr(ctx, base, count)),
      Box::new(edit_replace_calls_expr(ctx, index, count))), expr)
  when ExprKind::ExprCall(callee, args) then
    let nc = edit_replace_callee(ctx, callee, count)
    edit_mk_expr(ExprKind::ExprCall(
      Box::new(nc), edit_replace_calls_exprs(ctx, args, count)), expr)
  when ExprKind::ExprClosure(params, ret, body) then
    var ps: Vec[ClosureParam] = Vec::new()
    var pi = 0
    while pi < params.len() do
      ps.push(ClosureParam {
        pat: edit_replace_calls_pattern(ctx, params[pi].pat, count),
        ty: params[pi].ty.clone(),
        span: params[pi].span.clone()
      })
      pi = pi + 1
    end
    edit_mk_expr(ExprKind::ExprClosure(
      ps, ret, Box::new(edit_replace_calls_expr(ctx, body, count))), expr)
  when ExprKind::ExprAccess(inner) then
    edit_mk_expr(ExprKind::ExprAccess(Box::new(
      edit_replace_calls_expr(ctx, inner, count))), expr)
  when ExprKind::ExprRawDeref(inner) then
    edit_mk_expr(ExprKind::ExprRawDeref(Box::new(
      edit_replace_calls_expr(ctx, inner, count))), expr)
  when ExprKind::ExprIf(if_stmt) then
    edit_mk_expr(ExprKind::ExprIf(
      edit_replace_calls_if(ctx, if_stmt, count)), expr)
  when ExprKind::ExprMatch(m) then
    edit_mk_expr(ExprKind::ExprMatch(
      edit_replace_calls_match(ctx, m, count)), expr)
  when ExprKind::ExprBlock(block) then
    edit_mk_expr(ExprKind::ExprBlock(
      edit_replace_calls_block(ctx, block, count)), expr)
  when ExprKind::ExprUnsafe(reason, block) then
    edit_mk_expr(ExprKind::ExprUnsafe(reason,
      edit_replace_calls_block(ctx, block, count)), expr)
  when ExprKind::ExprAsync(block) then
    edit_mk_expr(ExprKind::ExprAsync(
      edit_replace_calls_block(ctx, block, count)), expr)
  when ExprKind::ExprAwait(inner) then
    edit_mk_expr(ExprKind::ExprAwait(Box::new(
      edit_replace_calls_expr(ctx, inner, count))), expr)
  when ExprKind::ExprTry(inner) then
    edit_mk_expr(ExprKind::ExprTry(Box::new(
      edit_replace_calls_expr(ctx, inner, count))), expr)
  when ExprKind::ExprRange(start, stop, inclusive) then
    var ns: Option[Box[Expr]] = Option::None
    var ne: Option[Box[Expr]] = Option::None
    match start
    when Option::Some(s) then
      ns = Option::Some(Box::new(edit_replace_calls_expr(ctx, s, count)))
    when Option::None then ()
    end
    match stop
    when Option::Some(e) then
      ne = Option::Some(Box::new(edit_replace_calls_expr(ctx, e, count)))
    when Option::None then ()
    end
    edit_mk_expr(ExprKind::ExprRange(ns, ne, inclusive), expr)
  when ExprKind::ExprCast(inner, ty) then
    edit_mk_expr(ExprKind::ExprCast(Box::new(
      edit_replace_calls_expr(ctx, inner, count)), ty), expr)
  when ExprKind::ExprTypeCheck(inner, ty) then
    edit_mk_expr(ExprKind::ExprTypeCheck(Box::new(
      edit_replace_calls_expr(ctx, inner, count)), ty), expr)
  when ExprKind::ExprComptime(block) then
    edit_mk_expr(ExprKind::ExprComptime(
      edit_replace_calls_block(ctx, block, count)), expr)
  when ExprKind::ExprEnumVariant(path, targs, args) then
    edit_mk_expr(ExprKind::ExprEnumVariant(
      path, targs, edit_replace_calls_exprs(ctx, args, count)), expr)
  when ExprKind::ExprAssign(target, value) then
    edit_mk_expr(ExprKind::ExprAssign(
      Box::new(edit_replace_calls_expr(ctx, target, count)),
      Box::new(edit_replace_calls_expr(ctx, value, count))), expr)
  when ExprKind::ExprPipe(lhs, rhs) then
    edit_mk_expr(ExprKind::ExprPipe(
      Box::new(edit_replace_calls_expr(ctx, lhs, count)),
      Box::new(edit_replace_calls_expr(ctx, rhs, count))), expr)
  when ExprKind::ExprMacroCall(name, args) then
    edit_mk_expr(ExprKind::ExprMacroCall(name,
      edit_replace_calls_exprs(ctx, args, count)), expr)
  end
end

def edit_replace_calls_pattern(ctx: EditCallCtx, pat: Pattern, inout count: Int) -> Pattern
  match pat.kind
  when PatternKind::Literal(e) then
    edit_mk_pattern(PatternKind::Literal(
      edit_replace_calls_expr(ctx, e, count)), pat)
  when PatternKind::Tuple(items) then
    var out: Vec[Pattern] = Vec::new()
    var i = 0
    while i < items.len() do
      out.push(edit_replace_calls_pattern(ctx, items[i], count))
      i = i + 1
    end
    edit_mk_pattern(PatternKind::Tuple(out), pat)
  when PatternKind::Array(items) then
    var out2: Vec[Pattern] = Vec::new()
    var j = 0
    while j < items.len() do
      out2.push(edit_replace_calls_pattern(ctx, items[j], count))
      j = j + 1
    end
    edit_mk_pattern(PatternKind::Array(out2), pat)
  when PatternKind::Struct(path, fields) then
    var out3: Vec[(String, Pattern)] = Vec::new()
    var k = 0
    while k < fields.len() do
      out3.push((fields[k].0.clone(),
        edit_replace_calls_pattern(ctx, fields[k].1, count)))
      k = k + 1
    end
    edit_mk_pattern(PatternKind::Struct(path, out3), pat)
  when PatternKind::Variant(path, items) then
    var out4: Vec[Pattern] = Vec::new()
    var l = 0
    while l < items.len() do
      out4.push(edit_replace_calls_pattern(ctx, items[l], count))
      l = l + 1
    end
    edit_mk_pattern(PatternKind::Variant(path, out4), pat)
  when PatternKind::Or(items) then
    var out5: Vec[Pattern] = Vec::new()
    var m = 0
    while m < items.len() do
      out5.push(edit_replace_calls_pattern(ctx, items[m], count))
      m = m + 1
    end
    edit_mk_pattern(PatternKind::Or(out5), pat)
  when PatternKind::Range(lo, hi, inclusive) then
    var nlo: Option[Expr] = Option::None
    var nhi: Option[Expr] = Option::None
    match lo
    when Option::Some(e) then
      nlo = Option::Some(edit_replace_calls_expr(ctx, e, count))
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then
      nhi = Option::Some(edit_replace_calls_expr(ctx, e, count))
    when Option::None then ()
    end
    edit_mk_pattern(PatternKind::Range(nlo, nhi, inclusive), pat)
  when _ then pat.clone()
  end
end

def edit_replace_calls_block(ctx: EditCallCtx, block: Block, inout count: Int) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    stmts.push(edit_replace_calls_stmt(ctx, block.stmts[i], count))
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

def edit_replace_calls_if(ctx: EditCallCtx, if_stmt: IfStmt, inout count: Int) -> IfStmt
  var elsifs: Vec[(Expr, Block)] = Vec::new()
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    elsifs.push((
      edit_replace_calls_expr(ctx, if_stmt.elsif_branches[i].0, count),
      edit_replace_calls_block(ctx, if_stmt.elsif_branches[i].1, count)
    ))
    i = i + 1
  end
  var else_block: Option[Block] = Option::None
  match if_stmt.else_block
  when Option::Some(b) then
    else_block = Option::Some(edit_replace_calls_block(ctx, b, count))
  when Option::None then ()
  end
  IfStmt {
    cond: edit_replace_calls_expr(ctx, if_stmt.cond, count),
    then_block: edit_replace_calls_block(ctx, if_stmt.then_block, count),
    elsif_branches: elsifs,
    else_block: else_block,
    span: if_stmt.span.clone()
  }
end

def edit_replace_calls_match(ctx: EditCallCtx, m: MatchExpr, inout count: Int) -> MatchExpr
  var arms: Vec[MatchArm] = Vec::new()
  var i = 0
  while i < m.arms.len() do
    var arm_guard: Option[Expr] = Option::None
    match m.arms[i].guard_expr
    when Option::Some(g) then
      arm_guard = Option::Some(edit_replace_calls_expr(ctx, g, count))
    when Option::None then ()
    end
    arms.push(MatchArm {
      pattern: edit_replace_calls_pattern(ctx, m.arms[i].pattern, count),
      guard_expr: arm_guard,
      body: edit_replace_calls_block(ctx, m.arms[i].body, count),
      span: m.arms[i].span.clone()
    })
    i = i + 1
  end
  MatchExpr {
    scrutinee: edit_replace_calls_expr(ctx, m.scrutinee, count),
    arms: arms,
    span: m.span.clone()
  }
end

def edit_replace_calls_stmt(ctx: EditCallCtx, stmt: Stmt, inout count: Int) -> Stmt
  match stmt.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    edit_mk_stmt(StmtKind::StmtLet(pat, ty,
      edit_replace_calls_expr(ctx, value, count), is_mut), stmt)
  when StmtKind::StmtAssign(target, value) then
    edit_mk_stmt(StmtKind::StmtAssign(
      edit_replace_calls_expr(ctx, target, count),
      edit_replace_calls_expr(ctx, value, count)), stmt)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    edit_mk_stmt(StmtKind::StmtCompoundAssign(op,
      edit_replace_calls_expr(ctx, target, count),
      edit_replace_calls_expr(ctx, value, count)), stmt)
  when StmtKind::StmtIf(if_stmt) then
    edit_mk_stmt(StmtKind::StmtIf(
      edit_replace_calls_if(ctx, if_stmt, count)), stmt)
  when StmtKind::StmtMatch(m) then
    edit_mk_stmt(StmtKind::StmtMatch(
      edit_replace_calls_match(ctx, m, count)), stmt)
  when StmtKind::StmtWhile(cond, body) then
    edit_mk_stmt(StmtKind::StmtWhile(
      edit_replace_calls_expr(ctx, cond, count),
      edit_replace_calls_block(ctx, body, count)), stmt)
  when StmtKind::StmtFor(for_stmt) then
    edit_mk_stmt(StmtKind::StmtFor(ForStmt {
      pattern: edit_replace_calls_pattern(ctx, for_stmt.pattern, count),
      iter: edit_replace_calls_expr(ctx, for_stmt.iter, count),
      body: edit_replace_calls_block(ctx, for_stmt.body, count),
      span: for_stmt.span.clone()
    }), stmt)
  when StmtKind::StmtLoop(body) then
    edit_mk_stmt(StmtKind::StmtLoop(
      edit_replace_calls_block(ctx, body, count)), stmt)
  when StmtKind::StmtReturn(v) then
    var nv: Option[Expr] = Option::None
    match v
    when Option::Some(e) then nv = Option::Some(edit_replace_calls_expr(ctx, e, count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtReturn(nv), stmt)
  when StmtKind::StmtBreak(v) then
    var nv2: Option[Expr] = Option::None
    match v
    when Option::Some(e) then nv2 = Option::Some(edit_replace_calls_expr(ctx, e, count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtBreak(nv2), stmt)
  when StmtKind::StmtContinue then stmt.clone()
  when StmtKind::StmtExpr(e) then
    edit_mk_stmt(StmtKind::StmtExpr(
      edit_replace_calls_expr(ctx, e, count)), stmt)
  when StmtKind::StmtUnsafe(reason, body) then
    edit_mk_stmt(StmtKind::StmtUnsafe(reason,
      edit_replace_calls_block(ctx, body, count)), stmt)
  when StmtKind::StmtDefer(body) then
    edit_mk_stmt(StmtKind::StmtDefer(
      edit_replace_calls_block(ctx, body, count)), stmt)
  when StmtKind::StmtGuard(cond, action) then
    let new_action = match action
    when GuardElse::Return(v) then
      var nv3: Option[Expr] = Option::None
      match v
      when Option::Some(e) then nv3 = Option::Some(edit_replace_calls_expr(ctx, e, count))
      when Option::None then ()
      end
      GuardElse::Return(nv3)
    when GuardElse::Break(v) then
      var nv4: Option[Expr] = Option::None
      match v
      when Option::Some(e) then nv4 = Option::Some(edit_replace_calls_expr(ctx, e, count))
      when Option::None then ()
      end
      GuardElse::Break(nv4)
    when GuardElse::Panic(msg) then GuardElse::Panic(msg.clone())
    when GuardElse::Continue then GuardElse::Continue
    end
    edit_mk_stmt(StmtKind::StmtGuard(
      edit_replace_calls_expr(ctx, cond, count), new_action), stmt)
  when StmtKind::StmtTry(body, catches, finally_block) then
    var cs: Vec[CatchArm] = Vec::new()
    var i = 0
    while i < catches.len() do
      cs.push(CatchArm {
        pattern: catches[i].pattern.clone(),
        body: edit_replace_calls_block(ctx, catches[i].body, count),
        span: catches[i].span.clone()
      })
      i = i + 1
    end
    var fb: Option[Block] = Option::None
    match finally_block
    when Option::Some(b) then fb = Option::Some(edit_replace_calls_block(ctx, b, count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtTry(
      edit_replace_calls_block(ctx, body, count), cs, fb), stmt)
  when StmtKind::StmtWith(e, pat, body) then
    edit_mk_stmt(StmtKind::StmtWith(
      edit_replace_calls_expr(ctx, e, count),
      pat,
      edit_replace_calls_block(ctx, body, count)), stmt)
  when StmtKind::StmtHandleWith(e, handlers) then
    edit_mk_stmt(StmtKind::StmtHandleWith(
      edit_replace_calls_expr(ctx, e, count), handlers), stmt)
  end
end

# The caller-function call replacement: only the caller's body is rewritten;
# the returned count is the number of replaced call sites.
def edit_replace_calls_in_function(ctx: EditCallCtx, f: FunctionDecl, inout count: Int) -> FunctionDecl
  let body = match f.body
  when FnBody::FnBlock(b) then FnBody::FnBlock(edit_replace_calls_block(ctx, b, count))
  when FnBody::FnExpr(e) then FnBody::FnExpr(edit_replace_calls_expr(ctx, e, count))
  when _ then f.body.clone()
  end
  FunctionDecl {
    vis: f.vis, name: f.name.clone(), generic_params: f.generic_params.clone(),
    params: f.params.clone(), ret_type: f.ret_type.clone(), where_clause: f.where_clause.clone(),
    body: body, is_async: f.is_async, is_unsafe: f.is_unsafe, is_const: f.is_const,
    is_inline: f.is_inline, is_pure: f.is_pure, contracts: f.contracts.clone(),
    budget_val: f.budget_val.clone(), required_caps: f.required_caps.clone(),
    effects: f.effects.clone(), span: f.span.clone()
  }
end

# ———————————————————————————————————————————————————————————————
# Identity-located function sites (P0-13/P0-14: nested-module aware)
# ———————————————————————————————————————————————————————————————
# A function declaration's location: the item-index path into
# program.items (descending through inline module item lists) plus the
# method index (-1 = the item is itself the function, >= 0 = a struct/impl
# method). Location is by resolver registration key (module path +
# declared name / "Owner::method"), never by top-level spelling.

pub struct EditFunctionSite
  path: Vec[Int] = Vec::new()
  method_index: Int = -1
end

pub def edit_locate_function_site_resolved(
  program: Program, target_reg: String
) -> Option[EditFunctionSite]
  edit_locate_fn_site_items(program.items, Vec::new(), Vec::new(), target_reg.clone())
end

def edit_locate_fn_site_items(
  items: Vec[Item], path: Vec[Int], module_path: Vec[String],
  target_reg: String
) -> Option[EditFunctionSite]
  var i = 0
  while i < items.len() do
    let item = items[i]
    match item.kind
    when ItemKind::ItemFunction(f) then
      if stable_key_eq(edit_reg_key_text(module_path.clone(), f.name.clone()), target_reg.clone()) then
        var p = path.clone()
        p.push(i)
        return Option::Some(EditFunctionSite { path: p, method_index: -1 })
      end
    when ItemKind::ItemStruct(_) then
      var m = 0
      while m < edit_item_method_count(item.clone()) do
        if stable_key_eq(edit_item_method_reg(item.clone(), module_path.clone(), m), target_reg.clone()) then
          var p2 = path.clone()
          p2.push(i)
          return Option::Some(EditFunctionSite { path: p2, method_index: m })
        end
        m = m + 1
      end
    when ItemKind::ItemImpl(_) then
      var mi = 0
      while mi < edit_item_method_count(item.clone()) do
        if stable_key_eq(edit_item_method_reg(item.clone(), module_path.clone(), mi), target_reg.clone()) then
          var p3 = path.clone()
          p3.push(i)
          return Option::Some(EditFunctionSite { path: p3, method_index: mi })
        end
        mi = mi + 1
      end
    when ItemKind::ItemModule(mod_decl) then
      var inner_path = path.clone()
      inner_path.push(i)
      var inner_mod = module_path.clone()
      inner_mod.push(mod_decl.name.clone())
      match edit_locate_fn_site_items(mod_decl.items, inner_path, inner_mod, target_reg.clone())
      when Option::Some(site) then return Option::Some(site)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  Option::None
end

pub def edit_function_at_site(program: Program, site: EditFunctionSite) -> Option[FunctionDecl]
  edit_function_at_path(program.items, site.path, 0, site.method_index)
end

def edit_function_at_path(items: Vec[Item], path: Vec[Int], depth: Int, method_index: Int) -> Option[FunctionDecl]
  if depth >= path.len() then
    return Option::None
  end
  let idx = path[depth]
  if idx >= items.len() then
    return Option::None
  end
  let item = items[idx]
  if depth == path.len() - 1 then
    if method_index < 0 then
      match item.kind
      when ItemKind::ItemFunction(f) then return Option::Some(f)
      when _ then return Option::None
      end
    end
    match item.kind
    when ItemKind::ItemStruct(s) then
      if method_index < s.methods.len() then
        return Option::Some(s.methods[method_index])
      end
    when ItemKind::ItemImpl(im) then
      if method_index < im.methods.len() then
        return Option::Some(im.methods[method_index])
      end
    when _ then ()
    end
    return Option::None
  end
  match item.kind
  when ItemKind::ItemModule(m) then
    return edit_function_at_path(m.items, path, depth + 1, method_index)
  when _ then return Option::None
  end
end

pub def edit_program_replace_function_at_site(
  program: Program, site: EditFunctionSite, f: FunctionDecl
) -> Option[Program]
  let (items, ok) = edit_replace_fn_path(program.items, site.path, 0, site.method_index, f)
  if !ok then
    return Option::None
  end
  Option::Some(Program { items: items, crate: program.crate.clone(), span: program.span.clone() })
end

def edit_replace_fn_path(
  items: Vec[Item], path: Vec[Int], depth: Int, method_index: Int, f: FunctionDecl
) -> (Vec[Item], Bool)
  var out: Vec[Item] = Vec::new()
  var ok = false
  if depth >= path.len() then
    return (items, false)
  end
  var i = 0
  while i < items.len() do
    let item = items[i]
    if i == path[depth] then
      if depth == path.len() - 1 then
        if method_index < 0 then
          match item.kind
          when ItemKind::ItemFunction(_) then
            out.push(Item {
              kind: ItemKind::ItemFunction(f),
              attrs: item.attrs.clone(), span: item.span.clone(),
              is_pub: item.is_pub, owner_module: item.owner_module
            })
            ok = true
          when _ then out.push(item.clone())
          end
        else
          match item.kind
          when ItemKind::ItemStruct(s) then
            var methods = edit_replace_function(s.methods.clone(), method_index, f)
            out.push(Item {
              kind: ItemKind::ItemStruct(StructDecl {
                vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
                fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
                kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
              }),
              attrs: item.attrs.clone(), span: item.span.clone(),
              is_pub: item.is_pub, owner_module: item.owner_module
            })
            ok = true
          when ItemKind::ItemImpl(im) then
            var methods2 = edit_replace_function(im.methods.clone(), method_index, f)
            out.push(Item {
              kind: ItemKind::ItemImpl(ImplDecl {
                vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
                trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
                self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
                methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
              }),
              attrs: item.attrs.clone(), span: item.span.clone(),
              is_pub: item.is_pub, owner_module: item.owner_module
            })
            ok = true
          when _ then out.push(item.clone())
          end
        end
      else
        match item.kind
        when ItemKind::ItemModule(m) then
          let (inner, inner_ok) = edit_replace_fn_path(m.items, path, depth + 1, method_index, f)
          out.push(Item {
            kind: ItemKind::ItemModule(ModuleDecl {
              vis: m.vis, name: m.name.clone(), items: inner,
              is_inline: m.is_inline, span: m.span.clone()
            }),
            attrs: item.attrs.clone(), span: item.span.clone(),
            is_pub: item.is_pub, owner_module: item.owner_module
          })
          ok = inner_ok
        when _ then out.push(item.clone())
        end
      end
    else
      out.push(item.clone())
    end
    i = i + 1
  end
  (out, ok)
end

# ———————————————————————————————————————————————————————————————
# InsertStatement / ChangeSignature splices
# ———————————————————————————————————————————————————————————————

def edit_function_with_body(f: FunctionDecl, body: FnBody) -> FunctionDecl
  FunctionDecl {
    vis: f.vis, name: f.name.clone(), generic_params: f.generic_params.clone(),
    params: f.params.clone(), ret_type: f.ret_type.clone(), where_clause: f.where_clause.clone(),
    body: body, is_async: f.is_async, is_unsafe: f.is_unsafe, is_const: f.is_const,
    is_inline: f.is_inline, is_pure: f.is_pure, contracts: f.contracts.clone(),
    budget_val: f.budget_val.clone(), required_caps: f.required_caps.clone(),
    effects: f.effects.clone(), span: f.span.clone()
  }
end

# The signature splice: the replacement signature's generics / params /
# return / where clause replace the declaration's; the name changes only
# when the replacement text carried one; contracts, effects, capabilities,
# budget and body are untouched. Call sites are NOT updated (documented
# partial contract).
def edit_function_with_signature(f: FunctionDecl, sig: FunctionDecl) -> FunctionDecl
  let new_name = if sig.name == "__semantic_edit_sig__" then f.name.clone() else sig.name.clone() end
  FunctionDecl {
    vis: f.vis, name: new_name,
    generic_params: sig.generic_params.clone(), params: sig.params.clone(),
    ret_type: sig.ret_type.clone(), where_clause: sig.where_clause.clone(),
    body: f.body.clone(), is_async: f.is_async, is_unsafe: f.is_unsafe,
    is_const: f.is_const, is_inline: f.is_inline, is_pure: f.is_pure,
    contracts: f.contracts.clone(), budget_val: f.budget_val.clone(),
    required_caps: f.required_caps.clone(), effects: f.effects.clone(),
    span: f.span.clone()
  }
end

def edit_insert_into_block(block: Block, idx: Int, stmt: Stmt) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i <= block.stmts.len() do
    if i == idx then
      stmts.push(stmt.clone())
    end
    if i < block.stmts.len() then
      stmts.push(block.stmts[i].clone())
    end
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

# Splice `stmt` before statement `idx` of the located function's body. The
# body must be a block and `idx` must be an EXISTING statement ordinal —
# anything else reports (program, false) and the caller fails closed.
def edit_splice_insert(program: Program, site: EditItemSite, idx: Int, stmt: Stmt) -> (Program, Bool)
  var ok = false
  var new_items: Vec[Item] = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    var new_kind = item.kind.clone()
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then
        match item.kind
        when ItemKind::ItemFunction(f) then
          match f.body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              new_kind = ItemKind::ItemFunction(edit_function_with_body(f, FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemStruct(s) then
          match s.methods[mi].body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              var methods = s.methods.clone()
              methods = edit_replace_function(methods, mi,
                edit_function_with_body(s.methods[mi], FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              new_kind = ItemKind::ItemStruct(StructDecl {
                vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
                fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
                kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
              })
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemImpl(im) then
          match im.methods[mi].body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              var methods2 = im.methods.clone()
              methods2 = edit_replace_function(methods2, mi,
                edit_function_with_body(im.methods[mi], FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              new_kind = ItemKind::ItemImpl(ImplDecl {
                vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
                trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
                self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
                methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
              })
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(Item {
      kind: new_kind, attrs: item.attrs.clone(), span: item.span.clone(),
      is_pub: item.is_pub, owner_module: item.owner_module
    })
    i = i + 1
  end
  (Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }, ok)
end

def edit_splice_signature(program: Program, site: EditItemSite, sig: FunctionDecl) -> (Program, Bool)
  var ok = false
  var new_items: Vec[Item] = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    var new_kind = item.kind.clone()
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then
        match item.kind
        when ItemKind::ItemFunction(f) then
          new_kind = ItemKind::ItemFunction(edit_function_with_signature(f, sig.clone()))
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemStruct(s) then
          var methods = s.methods.clone()
          methods = edit_replace_function(methods, mi, edit_function_with_signature(s.methods[mi], sig.clone()))
          new_kind = ItemKind::ItemStruct(StructDecl {
            vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
            fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
            kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
          })
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemImpl(im) then
          var methods2 = im.methods.clone()
          methods2 = edit_replace_function(methods2, mi, edit_function_with_signature(im.methods[mi], sig.clone()))
          new_kind = ItemKind::ItemImpl(ImplDecl {
            vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
            trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
            self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
            methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
          })
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(Item {
      kind: new_kind, attrs: item.attrs.clone(), span: item.span.clone(),
      is_pub: item.is_pub, owner_module: item.owner_module
    })
    i = i + 1
  end
  (Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }, ok)
end

# ———————————————————————————————————————————————————————————————
# Edit-fragment parsing (statement / signature text)
# ———————————————————————————————————————————————————————————————

# Parse one statement text by parsing it inside a synthetic function body
# and extracting the single resulting statement. Option::None for any text
# that does not parse as EXACTLY one statement.
pub def edit_parse_statement_text(text: String) -> Option[Stmt]
  let src = "def __semantic_edit_probe__()\n" + text + "\nend\n"
  let out = parse(tokenize(src, "<semantic-edit>".to_string()))
  if diag_has_errors(&out.diagnostics) then
    return Option::None
  end
  for item in out.program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      match f.body
      when FnBody::FnBlock(b) then
        if b.stmts.len() == 1 then
          return Option::Some(b.stmts[0])
        end
      when _ then ()
      end
    when _ then ()
    end
  end
  Option::None
end

# Parse one signature text ("(x: Int) -> Int" or "name[T](x: Int) -> Int")
# by parsing a synthetic function declaration and extracting it. A
# parameter-list-only text gets the synthetic name; the caller splices
# the name only when the text carried one. The synthetic body is the bare
# newline form the parser accepts for a function body (`do` is not a
# function-body separator; the canonical formatter emits the bare form).
pub def edit_parse_signature_decl(text: String) -> Option[FunctionDecl]
  let trimmed = text.trim()
  var decl_text = trimmed.clone()
  if !decl_text.starts_with("def ") then
    if decl_text.starts_with("(") then
      decl_text = "__semantic_edit_sig__" + decl_text
    end
    decl_text = "def " + decl_text
  end
  let src = decl_text + "\nend\n"
  let out = parse(tokenize(src, "<semantic-edit>".to_string()))
  if diag_has_errors(&out.diagnostics) then
    return Option::None
  end
  for item in out.program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      return Option::Some(f)
    when _ then ()
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# The transform dispatch
# ———————————————————————————————————————————————————————————————

# The transformation outcome: the edited program, or the typed error plus
# the evidence text (the reason an anchor / declaration / fragment did not
# map — carried into EditApplication.validation_detail by the pipeline).
pub struct EditTransformResult
  program: Option[Program] = Option::None
  error: Option[EditError] = Option::None
  evidence: String = ""
end

def edit_transform_ok(program: Program, evidence: String) -> EditTransformResult
  EditTransformResult { program: Option::Some(program), error: Option::None, evidence: evidence }
end

def edit_transform_fail(error: EditError, evidence: String) -> EditTransformResult
  EditTransformResult { program: Option::None, error: Option::Some(error), evidence: evidence }
end

pub def edit_transform_error(result: EditTransformResult) -> EditError
  match result.error
  when Option::Some(e) then e
  when Option::None then EditError::PreconditionFailed
  end
end

# Parse "<digits>#S<digits>" (the §33 anchor tail after the function key's
# "#B") into (block id, statement ordinal, well_formed).
def edit_parse_block_stmt(rest: String) -> (Int, Int, Bool)
  let at_s = edit_str_index(rest.clone(), "#S".to_string(), 0)
  if at_s <= 0 then
    return (0, 0, false)
  end
  let btext = rest.slice(0, at_s)
  let stext = rest.slice(at_s + 2, rest.len())
  let bi = match btext.parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return (0, 0, false)
  end
  let si = match stext.parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return (0, 0, false)
  end
  (bi, si, true)
end

def edit_transform_rename(
  program: Program, resolved: ResolvedEdit, new_name: String, res: ResolvedNames
) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "rename-target-missing")
  end
  let target = resolved.targets[0].clone()
  let old = edit_key_name_segment(target.clone())
  if old == new_name then
    return edit_transform_fail(EditError::PreconditionFailed, "rename-no-op: " + old)
  end
  let (edited, hits) = edit_rename_program_identity(program, res, target.clone(), new_name.clone())
  if hits == 0 then
    return edit_transform_fail(EditError::PreconditionFailed,
      "declaration-not-in-source (no resolver registration key): " + edit_name_part(&target))
  end
  edit_transform_ok(edited,
    "rename:" + target + ":" + old + "->" + new_name + " hits:" + hits.to_string())
end

def edit_transform_replace_call(
  program: Program, resolved: ResolvedEdit, callee: String, res: ResolvedNames
) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "replace-call-target-missing")
  end
  let call_key = resolved.targets[0].clone()
  let parts = edit_pipe_parts(call_key.clone())
  if parts.len() != 3 then
    return edit_transform_fail(EditError::PreconditionFailed, "call-row-key-malformed: " + call_key)
  end
  let caller_key = parts[0].clone()
  let old_callee = parts[1].clone()
  let kind_word = parts[2].clone()
  if kind_word != "0" then
    return edit_transform_fail(EditError::PreconditionFailed,
      "call-row-kind-not-direct: " + kind_word + " (only a Direct call row names a source callee)")
  end
  var new_key = callee.clone()
  if resolved.targets.len() > 1 then
    new_key = resolved.targets[1].clone()
  end
  let caller_reg = edit_name_part(&caller_key)
  let old_reg = edit_name_part(&old_callee)
  let new_reg = edit_name_part(&new_key)
  if new_reg == old_reg then
    return edit_transform_fail(EditError::PreconditionFailed, "replace-call-no-op: " + old_reg)
  end
  let site = match edit_locate_function_site_resolved(program.clone(), caller_reg.clone())
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "caller-not-in-source: " + caller_reg)
  when Option::Some(s) then s
  end
  let f = match edit_function_at_site(program.clone(), site.clone())
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "caller-splice-failed: " + caller_reg)
  when Option::Some(func) then func
  end
  let ctx = EditCallCtx {
    resolutions: res,
    old_callee_reg: old_reg.clone(),
    new_name: edit_key_name_segment(new_key.clone()),
    new_segs: edit_colon_segments(new_reg.clone())
  }
  # P0-13: a cited §33 StableCallId ("<fn>#B<block>#T#C") pins the rewrite
  # to exactly ONE source call site. The MIR block/terminator has no AST
  # node in this import surface, so a multi-site match is the typed
  # AmbiguousSource naming that reason and a zero-site match is
  # PreconditionFailed — never a name-search fallback that rewrites an
  # unrelated same-named call.
  var stable_call: Option[String] = Option::None
  for t in resolved.targets do
    match stable_call_of_key(t.clone())
    when Option::Some(sid) then stable_call = Option::Some(sid.stable_key.clone())
    when Option::None then ()
    end
  end
  match stable_call
  when Option::Some(sid) then
    var probe = 0
    let _ = edit_replace_calls_in_function(&ctx, f.clone(), &mut probe)
    if probe == 0 then
      return edit_transform_fail(EditError::PreconditionFailed,
        "stable-call-id-not-in-source: " + sid + " caller:" + caller_reg)
    end
    if probe > 1 then
      return edit_transform_fail(EditError::AmbiguousSource,
        "stable-call-id-matches-multiple-source-sites: " + sid +
        " sites:" + probe.to_string() +
        " (the MIR block/terminator cannot select one AST call site; cite the call row key or refine the source)")
    end
  when Option::None then ()
  end
  var count = 0
  let f2 = edit_replace_calls_in_function(&ctx, f, &mut count)
  if count == 0 then
    return edit_transform_fail(EditError::PreconditionFailed,
      "call-site-not-in-source: " + old_reg + " caller:" + caller_reg)
  end
  match edit_program_replace_function_at_site(program, site, f2)
  when Option::None then
    edit_transform_fail(EditError::PreconditionFailed, "caller-splice-failed: " + caller_reg)
  when Option::Some(p2) then
    edit_transform_ok(p2,
      "replace-call:" + old_reg + "->" + new_reg + " sites:" + count.to_string())
  end
end

# ————— P0-14: HIR-anchored insertion —————
# Insert `stmt` immediately before the statement whose HIR node id equals
# hir_node inside the function declaration at `site`. The traversal
# mirrors assign_stmt_ids (statements inside every block-bearing
# expression are reachable), so the anchor resolves wherever the source
# statement actually sits — never by top-level ordinal.
def edit_splice_insert_hir(
  program: Program, site: EditFunctionSite, hir_node: Int, stmt: Stmt
) -> (Program, Bool)
  let f = match edit_function_at_site(program.clone(), site.clone())
  when Option::None then return (program, false)
  when Option::Some(func) then func
  end
  let (body, ok) = edit_hir_insert_fnbody(f.body, hir_node, stmt)
  if !ok then
    return (program, false)
  end
  let f2 = edit_function_with_body(f, body)
  match edit_program_replace_function_at_site(program, site, f2)
  when Option::None then (program, false)
  when Option::Some(p2) then (p2, true)
  end
end

# The node id of the first statement nested inside a block-bearing
# statement of the function (the descender the lane uses to mint a nested
# HIR anchor without hard-coding assign_node_ids numbering). -1 when the
# function has no nested statement.
def edit_first_nested_stmt_node(program: Program, fn_key: String) -> Int
  match edit_locate_function_site_resolved(program.clone(), edit_name_part(&fn_key))
  when Option::None then return -1
  when Option::Some(site) then
    match edit_function_at_site(program, site)
    when Option::None then return -1
    when Option::Some(f) then
      match f.body
      when FnBody::FnBlock(b) then return edit_first_nested_of_block(b)
      when _ then return -1
      end
    end
  end
end

def edit_first_nested_of_block(block: Block) -> Int
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtFor(fs) then
      if fs.body.stmts.len() > 0 then return fs.body.stmts[0].node_id end
    when StmtKind::StmtWhile(_, b) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
    when StmtKind::StmtLoop(b) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
    when StmtKind::StmtIf(i) then
      if i.then_block.stmts.len() > 0 then return i.then_block.stmts[0].node_id end
      var ei = 0
      while ei < i.elsif_branches.len() do
        if i.elsif_branches[ei].1.stmts.len() > 0 then
          return i.elsif_branches[ei].1.stmts[0].node_id
        end
        ei = ei + 1
      end
      match i.else_block
      when Option::Some(b) then
        if b.stmts.len() > 0 then return b.stmts[0].node_id end
      when Option::None then ()
      end
    when StmtKind::StmtMatch(m) then
      var ai = 0
      while ai < m.arms.len() do
        if m.arms[ai].body.stmts.len() > 0 then return m.arms[ai].body.stmts[0].node_id end
        ai = ai + 1
      end
    when StmtKind::StmtUnsafe(_, b) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
    when StmtKind::StmtDefer(b) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
    when StmtKind::StmtTry(b, catches, fin) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
      var ci = 0
      while ci < catches.len() do
        if catches[ci].body.stmts.len() > 0 then return catches[ci].body.stmts[0].node_id end
        ci = ci + 1
      end
      match fin
      when Option::Some(fb) then
        if fb.stmts.len() > 0 then return fb.stmts[0].node_id end
      when Option::None then ()
      end
    when StmtKind::StmtWith(_, _, b) then
      if b.stmts.len() > 0 then return b.stmts[0].node_id end
    when StmtKind::StmtHandleWith(_, handlers) then
      var hi = 0
      while hi < handlers.len() do
        var aj = 0
        while aj < handlers[hi].arms.len() do
          if handlers[hi].arms[aj].body.stmts.len() > 0 then
            return handlers[hi].arms[aj].body.stmts[0].node_id
          end
          aj = aj + 1
        end
        hi = hi + 1
      end
    when _ then ()
    end
  end
  -1
end

def edit_hir_insert_fnbody(body: FnBody, hir_node: Int, stmt: Stmt) -> (FnBody, Bool)
  match body
  when FnBody::FnBlock(b) then
    let (nb, ok) = edit_hir_insert_block(b, hir_node, stmt)
    (FnBody::FnBlock(nb), ok)
  when FnBody::FnExpr(e) then
    var done = false
    let ne = edit_hir_insert_expr(e, hir_node, stmt, &mut done)
    (FnBody::FnExpr(ne), done)
  when _ then (body.clone(), false)
  end
end

def edit_hir_insert_block(block: Block, hir_node: Int, stmt: Stmt) -> (Block, Bool)
  var out: Vec[Stmt] = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    if block.stmts[i].node_id == hir_node then
      out.push(stmt.clone())
      out.push(block.stmts[i].clone())
      var j = i + 1
      while j < block.stmts.len() do
        out.push(block.stmts[j].clone())
        j = j + 1
      end
      return (Block { stmts: out, span: block.span.clone() }, true)
    end
    var done = false
    let rebuilt = edit_hir_insert_stmt(block.stmts[i], hir_node, stmt.clone(), &mut done)
    out.push(rebuilt)
    if done then
      var j2 = i + 1
      while j2 < block.stmts.len() do
        out.push(block.stmts[j2].clone())
        j2 = j2 + 1
      end
      return (Block { stmts: out, span: block.span.clone() }, true)
    end
    i = i + 1
  end
  (Block { stmts: out, span: block.span.clone() }, false)
end

def edit_hir_insert_stmt(stmt: Stmt, hir_node: Int, ins: Stmt, inout done: Bool) -> Stmt
  if done then
    return stmt.clone()
  end
  match stmt.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    let nv = edit_hir_insert_expr(value, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtLet(pat, ty, nv, is_mut), stmt) end
    stmt.clone()
  when StmtKind::StmtAssign(target, value) then
    let nt = edit_hir_insert_expr(target, hir_node, ins.clone(), done)
    let nv2 = edit_hir_insert_expr(value, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtAssign(nt, nv2), stmt) end
    stmt.clone()
  when StmtKind::StmtCompoundAssign(op, target, value) then
    let nt2 = edit_hir_insert_expr(target, hir_node, ins.clone(), done)
    let nv3 = edit_hir_insert_expr(value, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtCompoundAssign(op, nt2, nv3), stmt) end
    stmt.clone()
  when StmtKind::StmtIf(if_stmt) then
    let nifs = edit_hir_insert_if(if_stmt, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtIf(nifs), stmt) end
    stmt.clone()
  when StmtKind::StmtMatch(m) then
    let nm = edit_hir_insert_match(m, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtMatch(nm), stmt) end
    stmt.clone()
  when StmtKind::StmtWhile(cond, body) then
    let nc = edit_hir_insert_expr(cond, hir_node, ins.clone(), done)
    let (nb, ok) = edit_hir_insert_block(body, hir_node, ins)
    done = done || ok
    if done then return edit_mk_stmt(StmtKind::StmtWhile(nc, nb), stmt) end
    stmt.clone()
  when StmtKind::StmtFor(for_stmt) then
    let ni = edit_hir_insert_expr(for_stmt.iter, hir_node, ins.clone(), done)
    let (nb2, ok2) = edit_hir_insert_block(for_stmt.body, hir_node, ins)
    done = done || ok2
    if done then
      return edit_mk_stmt(StmtKind::StmtFor(ForStmt {
        pattern: for_stmt.pattern.clone(), iter: ni, body: nb2, span: for_stmt.span.clone()
      }), stmt)
    end
    stmt.clone()
  when StmtKind::StmtLoop(body) then
    let (nb3, ok3) = edit_hir_insert_block(body, hir_node, ins)
    if ok3 then return edit_mk_stmt(StmtKind::StmtLoop(nb3), stmt) end
    stmt.clone()
  when StmtKind::StmtReturn(v) then
    match v
    when Option::Some(e) then
      let nv4 = edit_hir_insert_expr(e, hir_node, ins, done)
      if done then return edit_mk_stmt(StmtKind::StmtReturn(Option::Some(nv4)), stmt) end
      stmt.clone()
    when Option::None then stmt.clone()
    end
  when StmtKind::StmtBreak(v) then
    match v
    when Option::Some(e) then
      let nv5 = edit_hir_insert_expr(e, hir_node, ins, done)
      if done then return edit_mk_stmt(StmtKind::StmtBreak(Option::Some(nv5)), stmt) end
      stmt.clone()
    when Option::None then stmt.clone()
    end
  when StmtKind::StmtContinue then stmt.clone()
  when StmtKind::StmtExpr(e) then
    let ne = edit_hir_insert_expr(e, hir_node, ins, done)
    if done then return edit_mk_stmt(StmtKind::StmtExpr(ne), stmt) end
    stmt.clone()
  when StmtKind::StmtUnsafe(reason, body) then
    let (nb4, ok4) = edit_hir_insert_block(body, hir_node, ins)
    if ok4 then return edit_mk_stmt(StmtKind::StmtUnsafe(reason, nb4), stmt) end
    stmt.clone()
  when StmtKind::StmtDefer(body) then
    let (nb5, ok5) = edit_hir_insert_block(body, hir_node, ins)
    if ok5 then return edit_mk_stmt(StmtKind::StmtDefer(nb5), stmt) end
    stmt.clone()
  when StmtKind::StmtGuard(cond, action) then
    let nc2 = edit_hir_insert_expr(cond, hir_node, ins.clone(), done)
    let na = match action
    when GuardElse::Return(v) then
      match v
      when Option::Some(e) then
        let ne2 = edit_hir_insert_expr(e, hir_node, ins, done)
        GuardElse::Return(Option::Some(ne2))
      when Option::None then GuardElse::Return(Option::None)
      end
    when GuardElse::Break(v) then
      match v
      when Option::Some(e) then
        let ne3 = edit_hir_insert_expr(e, hir_node, ins, done)
        GuardElse::Break(Option::Some(ne3))
      when Option::None then GuardElse::Break(Option::None)
      end
    when GuardElse::Panic(msg) then GuardElse::Panic(msg.clone())
    when GuardElse::Continue then GuardElse::Continue
    end
    if done then return edit_mk_stmt(StmtKind::StmtGuard(nc2, na), stmt) end
    stmt.clone()
  when StmtKind::StmtTry(body, catches, finally_block) then
    let (nb6, ok6) = edit_hir_insert_block(body, hir_node, ins.clone())
    var cs: Vec[CatchArm] = Vec::new()
    var ci = 0
    while ci < catches.len() do
      if done then
        cs.push(catches[ci].clone())
      else
        let (cb, cok) = edit_hir_insert_block(catches[ci].body, hir_node, ins.clone())
        done = done || cok
        cs.push(CatchArm { pattern: catches[ci].pattern.clone(), body: cb, span: catches[ci].span.clone() })
      end
      ci = ci + 1
    end
    done = done || ok6
    var fb: Option[Block] = Option::None
    match finally_block
    when Option::Some(b) then
      if done then
        fb = Option::Some(b.clone())
      else
        let (nb7, ok7) = edit_hir_insert_block(b, hir_node, ins)
        done = done || ok7
        fb = Option::Some(nb7)
      end
    when Option::None then ()
    end
    if done then return edit_mk_stmt(StmtKind::StmtTry(nb6, cs, fb), stmt) end
    stmt.clone()
  when StmtKind::StmtWith(e, pat, body) then
    let ne4 = edit_hir_insert_expr(e, hir_node, ins.clone(), done)
    let (nb8, ok8) = edit_hir_insert_block(body, hir_node, ins)
    done = done || ok8
    if done then return edit_mk_stmt(StmtKind::StmtWith(ne4, pat, nb8), stmt) end
    stmt.clone()
  when StmtKind::StmtHandleWith(e, handlers) then
    let ne5 = edit_hir_insert_expr(e, hir_node, ins.clone(), done)
    var hs: Vec[EffectHandler] = Vec::new()
    var hi = 0
    while hi < handlers.len() do
      var arms: Vec[HandlerArm] = Vec::new()
      var aj = 0
      while aj < handlers[hi].arms.len() do
        if done then
          arms.push(handlers[hi].arms[aj].clone())
        else
          let (ab, aok) = edit_hir_insert_block(handlers[hi].arms[aj].body, hir_node, ins.clone())
          done = done || aok
          arms.push(HandlerArm {
            operation: handlers[hi].arms[aj].operation.clone(),
            params: handlers[hi].arms[aj].params.clone(),
            body: ab,
            span: handlers[hi].arms[aj].span.clone()
          })
        end
        aj = aj + 1
      end
      hs.push(EffectHandler {
        effect_name: handlers[hi].effect_name.clone(), arms: arms, span: handlers[hi].span.clone()
      })
      hi = hi + 1
    end
    if done then return edit_mk_stmt(StmtKind::StmtHandleWith(ne5, hs), stmt) end
    stmt.clone()
  end
end

def edit_hir_insert_if(if_stmt: IfStmt, hir_node: Int, ins: Stmt, inout done: Bool) -> IfStmt
  let cond = edit_hir_insert_expr(if_stmt.cond, hir_node, ins.clone(), done)
  let (then_block, tok) = edit_hir_insert_block(if_stmt.then_block, hir_node, ins.clone())
  done = done || tok
  var elsifs: Vec[(Expr, Block)] = Vec::new()
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    if done then
      elsifs.push((if_stmt.elsif_branches[i].0.clone(), if_stmt.elsif_branches[i].1.clone()))
    else
      let ec = edit_hir_insert_expr(if_stmt.elsif_branches[i].0, hir_node, ins.clone(), done)
      let (eb, eok) = edit_hir_insert_block(if_stmt.elsif_branches[i].1, hir_node, ins.clone())
      done = done || eok
      elsifs.push((ec, eb))
    end
    i = i + 1
  end
  var else_block: Option[Block] = Option::None
  match if_stmt.else_block
  when Option::Some(b) then
    if done then
      else_block = Option::Some(b.clone())
    else
      let (nb, ok) = edit_hir_insert_block(b, hir_node, ins)
      done = done || ok
      else_block = Option::Some(nb)
    end
  when Option::None then ()
  end
  IfStmt {
    cond: cond, then_block: then_block, elsif_branches: elsifs,
    else_block: else_block, span: if_stmt.span.clone()
  }
end

def edit_hir_insert_match(m: MatchExpr, hir_node: Int, ins: Stmt, inout done: Bool) -> MatchExpr
  let scrutinee = edit_hir_insert_expr(m.scrutinee, hir_node, ins.clone(), done)
  var arms: Vec[MatchArm] = Vec::new()
  var i = 0
  while i < m.arms.len() do
    var guard: Option[Expr] = m.arms[i].guard_expr.clone()
    if !done then
      match m.arms[i].guard_expr
      when Option::Some(g) then guard = Option::Some(edit_hir_insert_expr(g, hir_node, ins.clone(), done))
      when Option::None then ()
      end
    end
    var body = m.arms[i].body.clone()
    if !done then
      let (nb, ok) = edit_hir_insert_block(m.arms[i].body, hir_node, ins.clone())
      done = done || ok
      body = nb
    end
    arms.push(MatchArm {
      pattern: m.arms[i].pattern.clone(), guard_expr: guard, body: body,
      span: m.arms[i].span.clone()
    })
    i = i + 1
  end
  MatchExpr { scrutinee: scrutinee, arms: arms, span: m.span.clone() }
end

# The expression walk for HIR insertion: recurses into every expression so
# a statement inside a block-bearing expression (if/match/block/closure
# bodies) is reachable; the first block holding the anchor inserts there.
def edit_hir_insert_expr(e: Expr, hir_node: Int, ins: Stmt, inout done: Bool) -> Expr
  if done then
    return e.clone()
  end
  match e.kind
  when ExprKind::ExprBlock(b) then
    let (nb, ok) = edit_hir_insert_block(b, hir_node, ins)
    done = ok
    edit_mk_expr(ExprKind::ExprBlock(nb), e)
  when ExprKind::ExprUnsafe(reason, b) then
    let (nb2, ok2) = edit_hir_insert_block(b, hir_node, ins)
    done = ok2
    edit_mk_expr(ExprKind::ExprUnsafe(reason, nb2), e)
  when ExprKind::ExprAsync(b) then
    let (nb3, ok3) = edit_hir_insert_block(b, hir_node, ins)
    done = ok3
    edit_mk_expr(ExprKind::ExprAsync(nb3), e)
  when ExprKind::ExprComptime(b) then
    let (nb4, ok4) = edit_hir_insert_block(b, hir_node, ins)
    done = ok4
    edit_mk_expr(ExprKind::ExprComptime(nb4), e)
  when ExprKind::ExprIf(if_stmt) then
    let nif = edit_hir_insert_if(if_stmt, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprIf(nif), e)
  when ExprKind::ExprMatch(m) then
    let nm = edit_hir_insert_match(m, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprMatch(nm), e)
  when ExprKind::ExprClosure(params, ret, body) then
    var ps: Vec[ClosureParam] = Vec::new()
    var pi = 0
    while pi < params.len() do
      ps.push(ClosureParam {
        pat: params[pi].pat.clone(), ty: params[pi].ty.clone(), span: params[pi].span.clone()
      })
      pi = pi + 1
    end
    let nb5 = edit_hir_insert_expr(body, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprClosure(ps, ret, Box::new(nb5)), e)
  when ExprKind::ExprArrayLit(elems) then
    edit_mk_expr(ExprKind::ExprArrayLit(edit_hir_insert_exprs(elems, hir_node, ins, done)), e)
  when ExprKind::ExprArrayRepeat(elem, n) then
    let ne = edit_hir_insert_expr(elem, hir_node, ins.clone(), done)
    let nn = edit_hir_insert_expr(n, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprArrayRepeat(Box::new(ne), Box::new(nn)), e)
  when ExprKind::ExprTupleLit(elems) then
    edit_mk_expr(ExprKind::ExprTupleLit(edit_hir_insert_exprs(elems, hir_node, ins, done)), e)
  when ExprKind::ExprStructLit(path, fields) then
    var nf: Vec[(String, Expr)] = Vec::new()
    var fi = 0
    while fi < fields.len() do
      nf.push((fields[fi].0.clone(), edit_hir_insert_expr(fields[fi].1, hir_node, ins.clone(), done)))
      fi = fi + 1
    end
    edit_mk_expr(ExprKind::ExprStructLit(path, nf), e)
  when ExprKind::ExprMapLit(entries) then
    var ne2: Vec[(Expr, Expr)] = Vec::new()
    var mi = 0
    while mi < entries.len() do
      let k2 = edit_hir_insert_expr(entries[mi].0, hir_node, ins.clone(), done)
      let v2 = edit_hir_insert_expr(entries[mi].1, hir_node, ins.clone(), done)
      ne2.push((k2, v2))
      mi = mi + 1
    end
    edit_mk_expr(ExprKind::ExprMapLit(ne2), e)
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    let nl = edit_hir_insert_expr(lhs, hir_node, ins.clone(), done)
    let nr = edit_hir_insert_expr(rhs, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprBinaryOp(op, Box::new(nl), Box::new(nr)), e)
  when ExprKind::ExprUnaryOp(op, operand) then
    let no = edit_hir_insert_expr(operand, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprUnaryOp(op, Box::new(no)), e)
  when ExprKind::ExprFieldAccess(base, field) then
    let nb6 = edit_hir_insert_expr(base, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprFieldAccess(Box::new(nb6), field), e)
  when ExprKind::ExprMethodCall(recv, name, targs, args) then
    let nr2 = edit_hir_insert_expr(recv, hir_node, ins.clone(), done)
    let na = edit_hir_insert_exprs(args, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprMethodCall(Box::new(nr2), name, targs, na), e)
  when ExprKind::ExprIndex(base, index) then
    let nb7 = edit_hir_insert_expr(base, hir_node, ins.clone(), done)
    let ni2 = edit_hir_insert_expr(index, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprIndex(Box::new(nb7), Box::new(ni2)), e)
  when ExprKind::ExprCall(callee, args) then
    let nc = edit_hir_insert_expr(callee, hir_node, ins.clone(), done)
    let na2 = edit_hir_insert_exprs(args, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprCall(Box::new(nc), na2), e)
  when ExprKind::ExprAccess(inner) then
    let ni3 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprAccess(Box::new(ni3)), e)
  when ExprKind::ExprRawDeref(inner) then
    let ni4 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprRawDeref(Box::new(ni4)), e)
  when ExprKind::ExprAwait(inner) then
    let ni5 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprAwait(Box::new(ni5)), e)
  when ExprKind::ExprTry(inner) then
    let ni6 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprTry(Box::new(ni6)), e)
  when ExprKind::ExprRange(start, stop, inclusive) then
    var ns: Option[Box[Expr]] = Option::None
    var nq: Option[Box[Expr]] = Option::None
    match start
    when Option::Some(s) then ns = Option::Some(Box::new(edit_hir_insert_expr(s, hir_node, ins.clone(), done)))
    when Option::None then ()
    end
    match stop
    when Option::Some(t) then nq = Option::Some(Box::new(edit_hir_insert_expr(t, hir_node, ins, done)))
    when Option::None then ()
    end
    edit_mk_expr(ExprKind::ExprRange(ns, nq, inclusive), e)
  when ExprKind::ExprCast(inner, ty) then
    let ni7 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprCast(Box::new(ni7), ty), e)
  when ExprKind::ExprTypeCheck(inner, ty) then
    let ni8 = edit_hir_insert_expr(inner, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprTypeCheck(Box::new(ni8), ty), e)
  when ExprKind::ExprEnumVariant(path, targs, args) then
    edit_mk_expr(ExprKind::ExprEnumVariant(
      path, targs, edit_hir_insert_exprs(args, hir_node, ins, done)), e)
  when ExprKind::ExprAssign(target, value) then
    let nt3 = edit_hir_insert_expr(target, hir_node, ins.clone(), done)
    let nv6 = edit_hir_insert_expr(value, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprAssign(Box::new(nt3), Box::new(nv6)), e)
  when ExprKind::ExprPipe(lhs, rhs) then
    let nl2 = edit_hir_insert_expr(lhs, hir_node, ins.clone(), done)
    let nr3 = edit_hir_insert_expr(rhs, hir_node, ins, done)
    edit_mk_expr(ExprKind::ExprPipe(Box::new(nl2), Box::new(nr3)), e)
  when ExprKind::ExprMacroCall(name, args) then
    edit_mk_expr(ExprKind::ExprMacroCall(name, edit_hir_insert_exprs(args, hir_node, ins, done)), e)
  when _ then e.clone()
  end
end

def edit_hir_insert_exprs(exprs: Vec[Expr], hir_node: Int, ins: Stmt, inout done: Bool) -> Vec[Expr]
  var out: Vec[Expr] = Vec::new()
  var i = 0
  while i < exprs.len() do
    out.push(edit_hir_insert_expr(exprs[i], hir_node, ins.clone(), done))
    i = i + 1
  end
  out
end

# The insert entry: the anchor is the typed StableHirNodeId (built from
# the source-cited HIR key, or from an explicit MirOrigin entry); locate
# the function by its resolver registration key, then splice by the HIR
# node seq.
def edit_transform_insert_hir_anchor(
  program: Program, fn_key: String, hir: StableHirNodeId,
  stmt: Stmt, before_key: String, text: String
) -> EditTransformResult
  let fn_reg = edit_name_part(&fn_key)
  let site = match edit_locate_function_site_resolved(program.clone(), fn_reg.clone())
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "function-not-in-source: " + fn_reg)
  when Option::Some(s) then s
  end
  let spliced = edit_splice_insert_hir(program, site, hir.node_seq, stmt)
  if !spliced.1 then
    edit_transform_fail(EditError::PreconditionFailed,
      "statement-anchor-hir-not-found: " + before_key)
  else
    edit_transform_ok(spliced.0,
      "insert-statement:" + before_key + " hir:" + hir.node_seq.to_string() + " text:" + text)
  end
end

def edit_transform_insert(
  program: Program, resolved: ResolvedEdit, statement_text: String,
  origins: MirOriginMap
) -> EditTransformResult
  if resolved.targets.len() < 2 then
    return edit_transform_fail(EditError::PreconditionFailed, "insert-target-missing")
  end
  let fn_key = resolved.targets[0].clone()
  let before_key = resolved.targets[1].clone()
  let stmt = match edit_parse_statement_text(statement_text.clone())
  when Option::Some(s) then s
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "statement-text-unparsable: " + statement_text)
  end
  # HIR anchor: "<fn key>#H<node id>".
  match semantic_hir_stmt_key_parts(before_key.clone())
  when Option::Some(parts) then
    if parts.0 != fn_key then
      return edit_transform_fail(EditError::PreconditionFailed,
        "statement-anchor-foreign: " + before_key + " owner:" + parts.0)
    end
    let hir = semantic_hir_node_of(fn_key.clone(), parts.1)
    return edit_transform_insert_hir_anchor(
      program, fn_key.clone(), hir, stmt, before_key.clone(), statement_text)
  when Option::None then ()
  end
  # §33 MIR locator: resolved through the explicit MirOriginMap only.
  match snapshot_mir_locator_of_key(before_key.clone())
  when Option::Some(loc) then
    if loc.function_key != fn_key then
      return edit_transform_fail(EditError::PreconditionFailed,
        "statement-anchor-foreign: " + before_key + " owner:" + loc.function_key)
    end
    match mir_origin_map_lookup(origins, fn_key.clone(), loc.block_ordinal, loc.stmt_ordinal)
    when Option::Some(origin) then
      if !origin.unique then
        return edit_transform_fail(EditError::AmbiguousSource,
          "statement-anchor-mir-ambiguous: " + before_key + " reason:" + origin.reason)
      end
      if origin.hir_owner_key != fn_key then
        return edit_transform_fail(EditError::PreconditionFailed,
          "statement-anchor-origin-owner-mismatch: " + before_key +
          " origin-owner:" + origin.hir_owner_key)
      end
      let hir2 = semantic_hir_node_of(origin.hir_owner_key.clone(), origin.hir_node)
      return edit_transform_insert_hir_anchor(
        program, fn_key.clone(), hir2, stmt, before_key.clone(), statement_text)
    when Option::None then
      return edit_transform_fail(EditError::AmbiguousSource,
        "statement-anchor-mir-unmapped: " + before_key +
        " (a MIR statement locator has no unique source insertion point by itself; cite the HIR anchor <fn key>#H<node id> or register an explicit MirOrigin)")
    end
  when Option::None then ()
  end
  edit_transform_fail(EditError::PreconditionFailed, "statement-anchor-unparsable: " + before_key)
end

def edit_transform_signature(
  program: Program, resolved: ResolvedEdit, sig_text: String
) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "change-signature-target-missing")
  end
  let target = resolved.targets[0].clone()
  let target_reg = edit_name_part(&target)
  let site = match edit_locate_function_site_resolved(program.clone(), target_reg.clone())
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "function-not-in-source: " + target_reg)
  when Option::Some(s) then s
  end
  let sig = match edit_parse_signature_decl(sig_text.clone())
  when Option::Some(s) then s
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "signature-text-unparsable: " + sig_text)
  end
  let f = match edit_function_at_site(program.clone(), site.clone())
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "function-splice-failed: " + target_reg)
  when Option::Some(func) then func
  end
  let f2 = edit_function_with_signature(f, sig)
  match edit_program_replace_function_at_site(program, site, f2)
  when Option::None then
    edit_transform_fail(EditError::PreconditionFailed, "function-splice-failed: " + target_reg)
  when Option::Some(p2) then
    var calls = "0".to_string()
    for pc in resolved.preconditions do
      if pc.starts_with("callsites-to-update:") then
        calls = pc.slice("callsites-to-update:".len(), pc.len())
      end
    end
    edit_transform_ok(p2, "change-signature:" + target + " callsites-not-updated:" + calls)
  end
end

# The AST transformation of one resolved edit (no rendering, no
# validation — the two pipeline entries below add those). The parsed
# source is node-id stamped and resolved (assign_node_ids ->
# resolve_names) and every rewrite consumes that ResolvedNames snapshot:
# a source whose resolution fails never reaches a spelling-based fallback
# (PreconditionFailed instead). ChangeContract and FillHole keep their
# existing (real) apply surfaces and are reported UnsupportedEdit on the
# SOURCE surface.
pub def edit_transform_source_with_origins(
  source: String, resolved: ResolvedEdit, origins: MirOriginMap
) -> EditTransformResult
  let parsed = parse(tokenize(source, "<semantic-edit>".to_string()))
  if diag_has_errors(&parsed.diagnostics) then
    return edit_transform_fail(EditError::PreconditionFailed,
      "source-parse: " + edit_first_diag_text(&parsed.diagnostics))
  end
  match resolved.clone().edit
  when SemanticEdit::ChangeContract(_, _) then
    return edit_transform_fail(EditError::UnsupportedEdit,
      "ChangeContract applies on the snapshot surface (apply_edit)")
  when SemanticEdit::FillHole(_, _) then
    return edit_transform_fail(EditError::UnsupportedEdit,
      "FillHole applies on the typed-program surface (apply_fill_hole)")
  when _ then ()
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  let res = match resolve_names(program.clone())
  when Result::Ok(r) then r
  when Result::Err(errs) then
    return edit_transform_fail(EditError::PreconditionFailed,
      "source-resolve: " + edit_first_resolution_text(errs))
  end
  match resolved.clone().edit
  when SemanticEdit::Rename(_, new_name) then
    edit_transform_rename(program, resolved, new_name, res)
  when SemanticEdit::ReplaceCall(_, callee) then
    edit_transform_replace_call(program, resolved, callee, res)
  when SemanticEdit::InsertStatement(_, _, statement_text) then
    edit_transform_insert(program, resolved, statement_text, origins)
  when SemanticEdit::ChangeSignature(_, new_signature_text) then
    edit_transform_signature(program, resolved, new_signature_text)
  when SemanticEdit::ChangeContract(_, _) then
    edit_transform_fail(EditError::UnsupportedEdit,
      "ChangeContract applies on the snapshot surface (apply_edit)")
  when SemanticEdit::FillHole(_, _) then
    edit_transform_fail(EditError::UnsupportedEdit,
      "FillHole applies on the typed-program surface (apply_fill_hole)")
  end
end

pub def edit_transform_source(source: String, resolved: ResolvedEdit) -> EditTransformResult
  edit_transform_source_with_origins(source, resolved, mir_origin_map_new())
end

# ———————————————————————————————————————————————————————————————
# The REQUIRED source entry: transform + render + re-parse
# ———————————————————————————————————————————————————————————————
# edit_apply_to_source(source_text, resolved) -> Result[String, EditError]:
# the AST transformation above (which resolves the parsed source itself and
# gates every rewrite on resolver identity), rendered through the canonical
# formatter, with a final re-parse of the emitted text (a render the parser
# cannot read back is PreconditionFailed — never a confidently returned
# corrupt source). edit_apply_to_source does NOT re-run the type/access/
# ownership chain; use apply_edit_to_source for the validated + actual-
# delta application record.
pub def edit_apply_to_source(source: String, resolved: ResolvedEdit) -> Result[String, EditError]
  let transform = edit_transform_source(source, resolved)
  let program_opt = transform.program.clone()
  match program_opt
  when Option::None then
    Result::Err(edit_transform_error(transform.clone()))
  when Option::Some(program) then
    let rendered = format_program_to_string(program)
    let out = parse(tokenize(rendered.clone(), "<semantic-edit>".to_string()))
    if diag_has_errors(&out.diagnostics) then
      Result::Err(EditError::PreconditionFailed)
    else
      Result::Ok(rendered)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Re-validation (parse -> resolve -> type -> access -> ownership)
# ———————————————————————————————————————————————————————————————

pub struct EditRevalidation
  parsed: Bool
  resolved: Bool
  typechecked: Bool
  ownership_checked: Bool
  detail: String
  # (P0-15) the reachable front-end artifact of this re-validation: the
  # node-id stamped AST and the resolver snapshot (both present through
  # the resolve stage onward). The actual-delta comparison reads the
  # pre-edit and post-edit pairs.
  ast: Option[Program] = Option::None
  resolutions: Option[ResolvedNames] = Option::None
end

def edit_first_diag_text(diags: Vec[Diagnostic]) -> String
  for d in diags do
    if d.level == DiagLevel::Error then
      return d.message.clone()
    end
  end
  "unknown".to_string()
end

def edit_first_resolution_text(errors: Vec[ResolutionError]) -> String
  for e in errors do
    return e.message.clone()
  end
  "unknown".to_string()
end

# Re-run the front end over one (already regenerated) source text: parse,
# node-id assignment, name resolution, typed checking, and the two CFG
# analyses (access exclusivity + resource ownership). The detail text names
# the first failing phase and its first message — the evidence the caller
# pipeline records. NOTE: the macro-expansion / @cfg prologue of
# compiler_core's prepare_parsed is not re-run here (see the section doc).
pub def edit_revalidate_source(source: String, file: String) -> EditRevalidation
  let out = parse(tokenize(source, file))
  if diag_has_errors(&out.diagnostics) then
    return EditRevalidation {
      parsed: false, resolved: false, typechecked: false, ownership_checked: false,
      detail: "parse: " + edit_first_diag_text(&out.diagnostics)
    }
  end
  var program = out.program
  assign_node_ids(&mut program)
  let resolutions = match resolve_names(program.clone())
  when Result::Ok(r) then r
  when Result::Err(errors) then
    return EditRevalidation {
      parsed: true, resolved: false, typechecked: false, ownership_checked: false,
      detail: "resolve: " + edit_first_resolution_text(&errors),
      ast: Option::Some(program)
    }
  end
  var env = type_env_new()
  let tr = type_check_typed(&mut env, program.clone(), resolutions.clone())
  if !tr.errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: false, ownership_checked: false,
      detail: "type: " + tr.errors[0].message.clone(),
      ast: Option::Some(program.clone()), resolutions: Option::Some(resolutions.clone())
    }
  end
  let typed = tr.program.typed
  let cfg = build_typed_cfg(program.clone(), &typed)
  var ctx = analysis_context_new()
  let access_errors = access_check(program.clone(), &typed, &cfg, &mut ctx)
  if !access_errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: true, ownership_checked: false,
      detail: "access: " + access_errors[0].message.clone(),
      ast: Option::Some(program.clone()), resolutions: Option::Some(resolutions.clone())
    }
  end
  var engine_snapshot = tr.program.engine_snapshot
  let res = resource_check(program.clone(), &typed, &cfg, &mut ctx, &mut engine_snapshot)
  if !res.errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: true, ownership_checked: false,
      detail: "ownership: " + res.errors[0].message.clone(),
      ast: Option::Some(program.clone()), resolutions: Option::Some(resolutions.clone())
    }
  end
  EditRevalidation {
    parsed: true, resolved: true, typechecked: true, ownership_checked: true,
    detail: "parse:ok;resolve:ok;type:ok;access:ok;ownership:ok",
    ast: Option::Some(program.clone()), resolutions: Option::Some(resolutions.clone())
  }
end

# ———————————————————————————————————————————————————————————————
# apply_edit_to_source — the validated + actual-delta pipeline record
# ———————————————————————————————————————————————————————————————
# The full source-edit pipeline (P0-15): the pre-edit reachable artifact
# (parse/resolve/type) -> transform -> render -> the post-edit
# parse/resolve/type/access/ownership chain -> the ACTUAL reachable delta
# rows -> the planned-set comparison -> the ChangeBudget envelope over the
# actual delta -> the §37 proof summary. A re-validation failure is
# PreconditionFailed; an actual delta outside the planned sets is
# EditError::UnexpectedDelta even when the regenerated source compiles.
# The evidence text and the full application record (including the
# unexpected rows) ride SourceEditCheck, so the caller never has to guess.
pub struct SourceEditCheck
  result: Result[EditApplication, EditError]
  evidence: String = ""
  # The application record even on the UnexpectedDelta path (None only
  # before the transform produced a rendered program).
  application: Option[EditApplication] = Option::None
end

pub def edit_kind_word(edit: SemanticEdit) -> String
  match edit
  when SemanticEdit::Rename(_, _) then "rename"
  when SemanticEdit::ChangeSignature(_, _) then "change-signature"
  when SemanticEdit::ChangeContract(_, _) then "change-contract"
  when SemanticEdit::ReplaceCall(_, _) then "replace-call"
  when SemanticEdit::InsertStatement(_, _, _) then "insert-statement"
  when SemanticEdit::FillHole(_, _) then "fill-hole"
  end
end

def edit_reachable_of_revalidation(r: EditRevalidation) -> Option[EditReachableRows]
  match r.ast.clone()
  when Option::Some(p) then
    match r.resolutions.clone()
    when Option::Some(res) then Option::Some(edit_reachable_rows(p, res))
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# The actual-delta verification record (P0-15), filled by
# edit_verify_actual_delta over the pre/post reachable artifacts.
struct EditVerification
  actual: Vec[String] = Vec::new()
  match_ok: Bool = false
  unexpected: Vec[String] = Vec::new()
  unmatched: Vec[String] = Vec::new()
  budget: Vec[String] = Vec::new()
  proof: Vec[String] = Vec::new()
end

# The full P0-15 chain over the two reachable artifacts: the actual delta
# rows (the applied InsertStatement contributes its stmt-inserted row),
# the planned-set comparison, the budget envelope and the proof summary.
# When a reachable artifact is absent (the pre-edit source never resolved,
# or the re-validation failed before resolution) the record stays empty
# and match_ok false — fail closed.
def edit_verify_actual_delta(
  before: EditRevalidation, after: EditRevalidation,
  resolved: ResolvedEdit, revalidated: Bool
) -> EditVerification
  var v = EditVerification {}
  let bf = edit_reachable_of_revalidation(before)
  let af = edit_reachable_of_revalidation(after)
  match bf
  when Option::Some(brows) then
    match af
    when Option::Some(arows) then
      v.actual = edit_reachable_delta_rows(brows, arows)
      match resolved.edit.clone()
      when SemanticEdit::InsertStatement(_, _, _) then
        if revalidated && resolved.targets.len() >= 2 then
          v.actual.push("stmt-inserted:" + edit_name_part(&resolved.targets[1]))
        end
      when _ then ()
      end
      v.actual.sort()
      let cmp = edit_compare_actual_plan(resolved.clone(), v.actual.clone())
      v.unexpected = cmp.unexpected
      v.unmatched = cmp.unmatched
      v.match_ok = cmp.matched && revalidated
      let budget = edit_budget_for_plan(edit_plan_regs(resolved.clone()))
      let delta = edit_actual_delta_record(v.actual.clone())
      v.budget = budget_verify(budget.clone(), delta.clone())
      # (fourth-audit P0-16) the revalidation ran exactly the five stages
      # below; the remaining stages are UNAVAILABLE (not captured) and the
      # patch's status rows render them so.
      let evidence = verified_compilation_evidence_stages(
        "".to_string(), true, true, true, true, true,
        false, false, false, false, false, false,
        Vec::from([
          "parse".to_string(), "resolve".to_string(), "type".to_string(),
          "access".to_string(), "resource".to_string()
        ]))
      let patch = proof_patch_of_delta(budget, delta, evidence)
      v.proof = proof_patch_proven_fields(patch)
    when Option::None then ()
    end
  when Option::None then ()
  end
  v
end

def edit_verified_application(
  source: String, resolved: ResolvedEdit, origins: MirOriginMap
) -> SourceEditCheck
  let before = edit_revalidate_source(source.clone(), "<semantic-edit>".to_string())
  if !before.parsed || !before.resolved || !before.typechecked then
    return SourceEditCheck {
      result: Result::Err(EditError::PreconditionFailed),
      evidence: "pre-edit-source-invalid: " + before.detail.clone()
    }
  end
  let transform = edit_transform_source_with_origins(source, resolved.clone(), origins)
  match transform.program.clone()
  when Option::None then
    SourceEditCheck {
      result: Result::Err(edit_transform_error(transform.clone())),
      evidence: transform.evidence.clone()
    }
  when Option::Some(program) then
    let rendered = format_program_to_string(program)
    let after = edit_revalidate_source(rendered.clone(), "<semantic-edit>".to_string())
    if !after.parsed then
      return SourceEditCheck {
        result: Result::Err(EditError::PreconditionFailed),
        evidence: "render-parse: " + after.detail.clone()
      }
    end
    let revalidated = after.resolved && after.typechecked && after.ownership_checked
    let v = edit_verify_actual_delta(before, after.clone(), resolved.clone(), revalidated)
    let app = EditApplication {
      edit: resolved.edit.clone(),
      applied: Vec::from([
        "source-edited:" + edit_kind_word(resolved.edit.clone()),
        transform.evidence.clone()
      ]),
      resolved: Option::Some(resolved.clone()),
      edited_source: rendered.clone(),
      parsed: true,
      revalidated: revalidated,
      validation_detail: after.detail.clone(),
      delta_rows: resolved.expected_delta.clone(),
      actual_delta_rows: v.actual.clone(),
      delta_match: v.match_ok,
      unexpected_rows: v.unexpected.clone(),
      planned_unmatched_rows: v.unmatched.clone(),
      budget_result: v.budget.clone(),
      proof_summary: v.proof.clone()
    }
    if !revalidated then
      SourceEditCheck {
        result: Result::Err(EditError::PreconditionFailed),
        evidence: after.detail.clone(),
        application: Option::Some(app)
      }
    elsif !v.match_ok then
      SourceEditCheck {
        result: Result::Err(EditError::UnexpectedDelta),
        evidence: "actual-delta-mismatch: unexpected=[" + v.unexpected.join(",") +
          "] unmatched=[" + v.unmatched.join(",") + "] actual=[" + v.actual.join(",") + "]",
        application: Option::Some(app)
      }
    else
      SourceEditCheck {
        result: Result::Ok(app),
        evidence: after.detail.clone(),
        application: Option::Some(app)
      }
    end
  end
end

pub def apply_edit_to_source_checked_with_origins(
  source: String, resolved: ResolvedEdit, origins: MirOriginMap
) -> SourceEditCheck
  edit_verified_application(source, resolved, origins)
end

pub def apply_edit_to_source_checked(source: String, resolved: ResolvedEdit) -> SourceEditCheck
  edit_verified_application(source, resolved, mir_origin_map_new())
end

# The plain pipeline entry: Ok carries the validated application, Err the
# typed error (the evidence and the application record are available
# through the _checked entry above).
pub def apply_edit_to_source(source: String, resolved: ResolvedEdit) -> Result[EditApplication, EditError]
  let check = apply_edit_to_source_checked(source, resolved)
  check.result
end

pub def apply_edit_to_source_with_origins(
  source: String, resolved: ResolvedEdit, origins: MirOriginMap
) -> Result[EditApplication, EditError]
  apply_edit_to_source_checked_with_origins(source, resolved, origins).result
end

# ———————————————————————————————————————————————————————————————
# Source-engine lane (third-audit item 30 + fourth-audit P0-13/14/15)
# ———————————————————————————————————————————————————————————————
# S1 Rename: the declaration + references are rewritten by resolver
#    identity and the output re-parses + revalidates; the actual delta is
#    planned exactly.
# S1b actual-delta exceeds the plan: the same edit with an empty plan is
#    UnexpectedDelta and carries the unexpected rows.
# S2 ReplaceCall: the caller's resolved direct call site is spliced by
#    resolver identity (a same-named unrelated callee is left alone).
# S3 InsertStatement: the HIR anchor "<fn>#H<node id>" is resolved by the
#    AST walk; a §33 MIR anchor without an explicit MirOrigin is
#    AmbiguousSource (never a top-level ordinal).
# S3b the desugared for-loop MIR origin (an explicitly ambiguous
#    MirOrigin entry) is AmbiguousSource naming the reason.
# S4 ChangeSignature: parameter/return splice + actual signature delta.
# S5 Fail-closed: absent declaration, rename collision, unmapped MIR
#    anchor, unparsable statement, unmatched call site, unparsable
#    signature, foreign anchor owner.
# T1 Shadowed same-name rename: two modules define foo; only the resolved
#    references of the target module change and a local `foo` binder is
#    untouched.
# Returns the mismatch rows (empty = the whole lane verifies).

def edit_lane_count(haystack: String, needle: String) -> Int
  var count = 0
  var i = 0
  while i + needle.len() <= haystack.len() do
    if haystack.slice(i, i + needle.len()) == needle then
      count = count + 1
      i = i + needle.len()
    else
      i = i + 1
    end
  end
  count
end

def edit_lane_bool_row(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def edit_lane_error_row(
  inout out: Vec[String], name: String, result: Result[EditApplication, EditError], expected: String
) -> Unit
  match result
  when Result::Ok(_) then
    out.push(name + ": expected " + expected + ", got Ok")
  when Result::Err(e) then
    if edit_error_word(e) != expected then
      out.push(name + ": expected " + expected + ", got " + edit_error_word(e))
    end
  end
  ()
end

def edit_lane_check_error_row(
  inout out: Vec[String], name: String, check: SourceEditCheck, expected: String
) -> Unit
  match check.result
  when Result::Ok(_) then
    out.push(name + ": expected " + expected + ", got Ok")
  when Result::Err(e) then
    if edit_error_word(e) != expected then
      out.push(name + ": expected " + expected + ", got " + edit_error_word(e))
    end
  end
  ()
end

def edit_lane_check_evidence(
  inout out: Vec[String], name: String, check: SourceEditCheck, needle: String
) -> Unit
  if !check.evidence.contains(needle.clone()) then
    out.push(name + ": evidence missing '" + needle + "': " + check.evidence.clone())
  end
  ()
end

def edit_lane_rows_contain(rows: Vec[String], needle: String) -> Bool
  for r in rows do
    if r == needle then
      return true
    end
  end
  false
end

pub def semantic_source_edit_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  let src1 = "def old() -> Int\n  1\nend\n\ndef caller() -> Int\n  old()\nend\n"
  let fn_key = "f#fn()->Int".to_string()

  # ———— S1: identity rename + exact actual delta ————
  let r1 = ResolvedEdit {
    edit: SemanticEdit::Rename("old#fn()->Int".to_string(), "renamed".to_string()),
    targets: Vec::from(["old#fn()->Int".to_string()]),
    expected_delta: Vec::from(["entity-modified:old#fn()->Int".to_string()]),
    expected_write: Vec::from(["renamed#fn()->Int".to_string()])
  }
  match apply_edit_to_source(src1.clone(), r1)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-rename-parsed", app.parsed)
    edit_lane_bool_row(&mut out, "source-rename-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-rename-decl", app.edited_source.contains("def renamed()"))
    edit_lane_bool_row(&mut out, "source-rename-reference",
      edit_lane_count(app.edited_source.clone(), "renamed()".to_string()) == 2)
    edit_lane_bool_row(&mut out, "source-rename-no-stale", !app.edited_source.contains("old"))
    edit_lane_bool_row(&mut out, "source-rename-delta-rows",
      app.delta_rows.len() == 1 && app.delta_rows[0] == "entity-modified:old#fn()->Int")
    edit_lane_bool_row(&mut out, "source-rename-delta-match", app.delta_match)
    edit_lane_bool_row(&mut out, "source-rename-actual-removed",
      edit_lane_rows_contain(app.actual_delta_rows.clone(), "entity-removed:old".to_string()))
    edit_lane_bool_row(&mut out, "source-rename-actual-created",
      edit_lane_rows_contain(app.actual_delta_rows.clone(), "entity-created:renamed".to_string()))
    edit_lane_bool_row(&mut out, "source-rename-budget-clean", app.budget_result.len() == 0)
    edit_lane_bool_row(&mut out, "source-rename-proof",
      edit_lane_rows_contain(app.proof_summary.clone(), "parses".to_string()))
  when Result::Err(e) then
    out.push("source-rename: expected Ok, got " + edit_error_word(e))
  end

  # ———— S1b: the actual delta exceeds the (empty) plan ————
  let r1_under = ResolvedEdit {
    edit: SemanticEdit::Rename("old#fn()->Int".to_string(), "renamed".to_string()),
    targets: Vec::from(["old#fn()->Int".to_string()])
  }
  let check1_under = apply_edit_to_source_checked(src1.clone(), r1_under)
  edit_lane_check_error_row(&mut out, "source-delta-over-plan", check1_under.clone(),
    "UnexpectedDelta".to_string())
  edit_lane_check_evidence(&mut out, "source-delta-over-plan-evidence", check1_under.clone(),
    "entity-removed:old".to_string())
  match check1_under.application
  when Option::Some(app) then
    edit_lane_bool_row(&mut out, "source-delta-over-plan-app", !app.delta_match)
    edit_lane_bool_row(&mut out, "source-delta-over-plan-rows",
      edit_lane_rows_contain(app.unexpected_rows.clone(), "entity-created:renamed".to_string()))
  when Option::None then
    out.push("source-delta-over-plan-app: expected the application record")
  end

  # ———— S2: ReplaceCall identity splice ————
  let src2 = "def a() -> Int\n  1\nend\n\ndef b() -> Int\n  2\nend\n\ndef c() -> Int\n  a()\nend\n"
  let call_key = "c|a|0".to_string()
  let r2 = ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(call_key.clone(), "b#fn()->Int".to_string()),
    targets: Vec::from([call_key.clone(), "b#fn()->Int".to_string()]),
    expected_delta: Vec::from(["call-modified:c|a|0".to_string()]),
    expected_write: Vec::from(["c|b|0".to_string()])
  }
  match apply_edit_to_source(src2.clone(), r2)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-replace-call-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-replace-call-site",
      edit_lane_count(app.edited_source.clone(), "b()".to_string()) == 2)
    edit_lane_bool_row(&mut out, "source-replace-call-clean", !app.edited_source.contains("\n  a()"))
    edit_lane_bool_row(&mut out, "source-replace-call-delta-match", app.delta_match)
  when Result::Err(e) then
    out.push("source-replace-call: expected Ok, got " + edit_error_word(e))
  end

  # ———— S3: HIR-anchored InsertStatement ————
  let before3 = fn_key.clone() + "#H1"
  let r3 = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), before3.clone(), "let tmp = 1".to_string()),
    targets: Vec::from([fn_key.clone(), before3.clone()]),
    expected_delta: Vec::from(["stmt-inserted:" + before3.clone()]),
    expected_write: Vec::from([before3.clone()])
  }
  match apply_edit_to_source("def f() -> Int\n  42\nend\n", r3)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-insert-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-insert-present", app.edited_source.contains("let tmp = 1"))
    edit_lane_bool_row(&mut out, "source-insert-before-anchor",
      edit_char_index(&app.edited_source, "let tmp = 1", 0) <
        edit_char_index(&app.edited_source, "42", 0))
    edit_lane_bool_row(&mut out, "source-insert-delta-match", app.delta_match)
    edit_lane_bool_row(&mut out, "source-insert-actual-row",
      edit_lane_rows_contain(app.actual_delta_rows.clone(), "stmt-inserted:f".to_string()))
  when Result::Err(e) then
    out.push("source-insert: expected Ok, got " + edit_error_word(e))
  end

  # ———— S3b: a MIR anchor with no MirOrigin is ambiguous ————
  let mir_anchor = fn_key.clone() + "#B0#S0"
  let r3_mir = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), mir_anchor.clone(), "let tmp = 1".to_string()),
    targets: Vec::from([fn_key.clone(), mir_anchor.clone()])
  }
  let check3_mir = apply_edit_to_source_checked("def f() -> Int\n  42\nend\n", r3_mir)
  edit_lane_check_error_row(&mut out, "source-insert-mir-unmapped", check3_mir.clone(),
    "AmbiguousSource".to_string())
  edit_lane_check_evidence(&mut out, "source-insert-mir-unmapped-evidence", check3_mir.clone(),
    "statement-anchor-mir-unmapped".to_string())

  # ———— S3c: a desugared for-loop MIR origin is ambiguous (named reason) ————
  let src_for = "def g() -> Int\n  var acc = 0\n  for i in 0..3 do\n    acc = acc + i\n  end\n  acc\nend\n"
  let for_anchor = "g#fn()->Int#B1#S0".to_string()
  let r3_for = ResolvedEdit {
    edit: SemanticEdit::InsertStatement("g#fn()->Int".to_string(), for_anchor.clone(),
      "let y = 1".to_string()),
    targets: Vec::from(["g#fn()->Int".to_string(), for_anchor.clone()])
  }
  var origins = mir_origin_map_new()
  mir_origin_map_add_ambiguous(&mut origins, "g#fn()->Int".to_string(), 1, 0,
    "desugared-for".to_string())
  let check3_for = apply_edit_to_source_checked_with_origins(src_for.clone(), r3_for, origins)
  edit_lane_check_error_row(&mut out, "source-insert-desugared-for", check3_for.clone(),
    "AmbiguousSource".to_string())
  edit_lane_check_evidence(&mut out, "source-insert-desugared-for-evidence", check3_for.clone(),
    "desugared-for".to_string())

  # ———— S3d: a UNIQUE MirOrigin entry maps the MIR locator to a nested
  # HIR statement (the first for-body statement, resolved through the same
  # assign_node_ids pass the transform runs) ————
  let r3_for_unique = ResolvedEdit {
    edit: SemanticEdit::InsertStatement("g#fn()->Int".to_string(), for_anchor.clone(),
      "let y = 1".to_string()),
    targets: Vec::from(["g#fn()->Int".to_string(), for_anchor.clone()]),
    expected_delta: Vec::from(["stmt-inserted:" + for_anchor.clone()]),
    expected_write: Vec::from([for_anchor.clone()])
  }
  # The nested anchor node id comes from the same assign_node_ids pass the
  # transform runs (the first for-body statement), never a hard-coded id.
  let parsed_for = parse(tokenize(src_for.clone(), "<semantic-edit>".to_string()))
  var program_for = parsed_for.program
  assign_node_ids(&mut program_for)
  let nested_node = edit_first_nested_stmt_node(program_for, "g#fn()->Int".to_string())
  var origins_unique = mir_origin_map_new()
  mir_origin_map_add_unique(&mut origins_unique, "g#fn()->Int".to_string(), 1, 0,
    "g#fn()->Int".to_string(), nested_node)
  let check3_unique = apply_edit_to_source_checked_with_origins(src_for, r3_for_unique, origins_unique)
  match check3_unique.result
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-insert-mir-mapped-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-insert-mir-mapped-present",
      app.edited_source.contains("let y = 1"))
    edit_lane_bool_row(&mut out, "source-insert-mir-mapped-delta", app.delta_match)
  when Result::Err(e) then
    out.push("source-insert-mir-mapped: expected Ok, got " + edit_error_word(e))
  end

  # ———— S4: ChangeSignature declaration splice + actual signature delta ————
  let r4 = ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(fn_key.clone(), "(x: Int) -> Int".to_string()),
    targets: Vec::from([fn_key.clone()]),
    expected_delta: Vec::from(["entity-modified:" + fn_key.clone()]),
    expected_write: Vec::from([fn_key.clone()])
  }
  match edit_apply_to_source("def f() -> Int\n  1\nend\n", r4.clone())
  when Result::Ok(text) then
    edit_lane_bool_row(&mut out, "source-signature-text", text.contains("def f(x: Int) -> Int"))
  when Result::Err(e) then
    out.push("source-signature-edit-apply: expected Ok, got " + edit_error_word(e))
  end
  match apply_edit_to_source("def f() -> Int\n  1\nend\n", r4)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-signature-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-signature-delta-match", app.delta_match)
    edit_lane_bool_row(&mut out, "source-signature-actual",
      edit_lane_rows_contain(app.actual_delta_rows.clone(), "entity-signature-changed:f".to_string()))
  when Result::Err(e) then
    out.push("source-signature: expected Ok, got " + edit_error_word(e))
  end

  # ———— T1: shadowed same-name rename (two modules + local shadowing) ————
  # Module a and module b each define foo and call it from their own
  # function (the current-module registration key wins the bare-name
  # resolution, so each `foo()` resolves to its own module's declaration).
  # Renaming a::foo changes only a's declaration/reference; b's foo and the
  # root local `foo` binder are untouched.
  let src_shadow = "mod a\n  def foo() -> Int\n    1\n  end\n  def use_a() -> Int\n    foo()\n  end\nend\n\nmod b\n  def foo() -> Int\n    2\n  end\n  def use_b() -> Int\n    foo()\n  end\nend\n\ndef shadow() -> Int\n  let foo = 3\n  foo\nend\n"
  let r_shadow = ResolvedEdit {
    edit: SemanticEdit::Rename("a::foo#fn()->Int".to_string(), "bar".to_string()),
    targets: Vec::from(["a::foo#fn()->Int".to_string()]),
    expected_delta: Vec::from(["entity-modified:a::foo#fn()->Int".to_string()]),
    expected_write: Vec::from(["a::bar#fn()->Int".to_string()])
  }
  match apply_edit_to_source(src_shadow, r_shadow)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-shadow-rename-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-shadow-rename-decl",
      app.edited_source.contains("def bar()"))
    edit_lane_bool_row(&mut out, "source-shadow-rename-other-module",
      edit_lane_count(app.edited_source.clone(), "def foo()".to_string()) == 1)
    edit_lane_bool_row(&mut out, "source-shadow-rename-refs",
      edit_lane_count(app.edited_source.clone(), "bar()".to_string()) == 2 &&
        edit_lane_count(app.edited_source.clone(), "foo()".to_string()) == 2)
    edit_lane_bool_row(&mut out, "source-shadow-local-kept",
      app.edited_source.contains("let foo = 3") && !app.edited_source.contains("let bar = 3"))
    edit_lane_bool_row(&mut out, "source-shadow-delta-match", app.delta_match)
  when Result::Err(e) then
    out.push("source-shadow-rename: expected Ok, got " + edit_error_word(e))
  end

  # ———— T2: ReplaceCall with a same-named unrelated function present ————
  # Module a's user calls a::foo; module b defines (and calls) its own foo —
  # the same-named unrelated declaration. The resolved call is replaced
  # with the root-module bar; b's foo reference is left alone.
  let src_dup = "def bar() -> Int\n  2\nend\n\nmod a\n  def foo() -> Int\n    1\n  end\n  def user_a() -> Int\n    foo()\n  end\nend\n\nmod b\n  def foo() -> Int\n    3\n  end\n  def user_b() -> Int\n    foo()\n  end\nend\n"
  let dup_call = "a::user_a|a::foo|0".to_string()
  let r_dup = ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(dup_call.clone(), "bar#fn()->Int".to_string()),
    targets: Vec::from([dup_call.clone(), "bar#fn()->Int".to_string()]),
    expected_delta: Vec::from(["call-modified:a::user_a|a::foo|0".to_string()]),
    expected_write: Vec::from(["a::user_a|bar|0".to_string()])
  }
  match apply_edit_to_source(src_dup, r_dup)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-dup-call-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-dup-call-rewritten",
      edit_lane_count(app.edited_source.clone(), "bar()".to_string()) == 2 &&
        edit_lane_count(app.edited_source.clone(), "foo()".to_string()) == 3)
    edit_lane_bool_row(&mut out, "source-dup-call-delta-match", app.delta_match)
  when Result::Err(e) then
    out.push("source-dup-call: expected Ok, got " + edit_error_word(e))
  end

  # ———— S5: fail-closed cases ————
  let r_missing = ResolvedEdit {
    edit: SemanticEdit::Rename("nope#fn()->Int".to_string(), "z".to_string()),
    targets: Vec::from(["nope#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-rename-missing",
    apply_edit_to_source(src1.clone(), r_missing), "PreconditionFailed".to_string())

  let r_collide = ResolvedEdit {
    edit: SemanticEdit::Rename("old#fn()->Int".to_string(), "caller".to_string()),
    targets: Vec::from(["old#fn()->Int".to_string()]),
    expected_write: Vec::from(["caller#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-rename-collision",
    apply_edit_to_source(src1.clone(), r_collide), "PreconditionFailed".to_string())

  let r_bad_stmt = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), before3.clone(), "let =".to_string()),
    targets: Vec::from([fn_key.clone(), before3.clone()])
  }
  edit_lane_error_row(&mut out, "source-insert-bad-statement",
    apply_edit_to_source("def f() -> Int\n  42\nend\n", r_bad_stmt), "PreconditionFailed".to_string())

  let foreign_anchor = "g#fn()->Int#H1".to_string()
  let r_foreign = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), foreign_anchor.clone(), "let tmp = 1".to_string()),
    targets: Vec::from([fn_key.clone(), foreign_anchor.clone()])
  }
  edit_lane_error_row(&mut out, "source-insert-foreign-anchor",
    apply_edit_to_source("def f() -> Int\n  42\nend\n", r_foreign), "PreconditionFailed".to_string())

  let no_call_key = "c|z|0".to_string()
  let r_nocall = ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(no_call_key.clone(), "b#fn()->Int".to_string()),
    targets: Vec::from([no_call_key.clone(), "b#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-replace-call-missing",
    apply_edit_to_source(src2.clone(), r_nocall), "PreconditionFailed".to_string())

  let r_badsig = ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(fn_key.clone(), "(x: ->".to_string()),
    targets: Vec::from([fn_key.clone()])
  }
  edit_lane_error_row(&mut out, "source-signature-bad-text",
    apply_edit_to_source("def f() -> Int\n  1\nend\n", r_badsig), "PreconditionFailed".to_string())

  out
end
