  CatchArm, ClosureParam, ConstDecl, ContractClause,
  EditionDecl, EffectDecl, EffectHandler, EffectOpParamSig, EffectOpSig, EnumDecl, Expr,
  ExprKind, ExternBlock, ExternFn, ExternItem, ExternStatic, FieldDecl, FnBody, ForStmt,
  FunctionDecl, FunctionSig, GenericParam, GuardElse, HandlerArm, IfStmt, ImplDecl, Item,
  ItemKind, MacroDecl, MatchArm, MatchExpr, ModuleDecl, Param,
  ParamTypeExpr, Pattern, PatternKind, Program, RationaleBlock, StaticDecl, Stmt, StmtKind,
  StructDecl, TraitDecl, TraitMethod, TypeAliasDecl, TypeExpr, TypeExprKind, UseDecl,
  VariantDecl, WherePredicate, assign_node_ids, type_expr_name
}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors, Diagnostic, DiagLevel}
use tg_compiler::resolver::{resolve_names, ResolutionError}
use tg_compiler::access_check::{access_check}
use tg_compiler::resource_check::{resource_check, build_typed_cfg, analysis_context_new}
use tg_compiler::formatter::{format_program_to_string}
use tg_compiler::types::{
  Type, TypedProgram, TypedExpr, TypedExprKind, type_env_new,
  type_check_typed, type_check_typed_holes, hole_constraints_of,
  typed_hole_constraints_of
}
use tg_compiler::stable_ids::{
  StableContractId, stable_key_eq, stable_contract_row_key, stable_row_key_of,
  stable_decl_of_key, stable_hole_key_text, stable_hole_key_parts
}
use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticSymbol, StableTargetId, CallEdge, CallEdgeKind,
  ContractFact, ContractExprIR, semantic_contract_expr_text,
  semantic_call_edge_kind_numeric, semantic_snapshot_new, DependencyEdgeKind
}
use tg_compiler::semantic_index::{
  SemanticIndex, build_semantic_index, index_callers_of_decl
}
use tg_compiler::semantic_delta::{
  SemanticDelta, semantic_delta_empty, semantic_delta_of, affected_closure
}

# ———————————————————————————————————————————————————————————————
# The edit vocabulary
# ———————————————————————————————————————————————————————————————

# One semantic edit request (audit item 53). Every payload is a CANONICAL
# stable key / row text / source fragment — never a dense id:
#   ReplaceCall      — the call ROW key ("caller|callee|kind") + the new
#                      callee key text.
#   InsertStatement  — the function stable key, the §33 statement key the
#                      new statement is inserted BEFORE, and the statement
#                      source text.
#   ChangeContract   — the StableContractId.stable_key of the clause row +
#                      the new canonical expression text ("op(arg,...)").
#   Rename           — the declaration stable key (or a unique bare /
#                      qualified name) + the new name.
#   ChangeSignature  — the declaration stable key (or unique name) + the
#                      new signature text.
#   FillHole         — the canonical hole key ("<fn key>#hole<n>") + the
#                      replacement expression source text.
enum SemanticEdit
  ReplaceCall(call_site_key: String, callee: String)
  InsertStatement(function_key: String, before_stmt_key: String, statement_text: String)
  ChangeContract(contract_id: String, new_expression_text: String)
  Rename(decl: String, new_name: String)
  ChangeSignature(decl: String, new_signature_text: String)
  FillHole(hole_key: String, expression_text: String)
end

# The RESOLVED edit: the typed index resolution of the target(s), the
# dependency-closure affected set, the resolved precondition facts and the
# delta rows the apply is expected to produce. All key lists are canonical
# texts (the protocol carrier domain).
struct ResolvedEdit
  edit: SemanticEdit
  targets: Vec[String] = Vec::new()
  affected: Vec[String] = Vec::new()
  preconditions: Vec[String] = Vec::new()
  expected_delta: Vec[String] = Vec::new()
end

# The typed edit failure (no prose payloads; the precise remaining surface
# of an ApplyUnavailable rides semantic_edit_unavailable_reason):
#   TargetNotFound      — the referenced key/name matches no row.
#   AmbiguousTarget     — a bare/qualified NAME matches more than one row.
#   UnsupportedEdit     — the apply entry does not serve this edit kind
#                         (e.g. apply_fill_hole on a non-FillHole edit).
#   PreconditionFailed  — a resolved precondition is violated at apply time
#                         (a malformed canonical contract text; the patch
#                         node is not a hole).
#   ApplyUnavailable    — the edit resolves but has no apply surface in the
#                         current representation (the AST/HIR rewrite is
#                         named by semantic_edit_unavailable_reason).
enum EditError
  TargetNotFound
  AmbiguousTarget
  UnsupportedEdit
  PreconditionFailed
  ApplyUnavailable
end

# The result of an applied edit. `applied` carries the canonical rows the
# apply actually produced; `snapshot` is the updated model for the
# snapshot-level applies (ChangeContract) and `delta` the §31 delta of the
# before/after pair (the real proof of application).
#
# (third-audit item 30) The SOURCE-EDIT pipeline fills the second half of
# the record: `resolved` carries the typed resolution the application was
# driven from, `edited_source` the regenerated source text, `parsed` /
# `revalidated` / `validation_detail` the front-end re-validation of the
# regenerated text, and `delta_rows` the expected §31 delta rows the
# caller's delta stage must confirm. The full pipeline chain is:
#   SemanticEdit -> resolve StableSemanticId (resolve_edit)
#   -> AST transformation (edit_transform_source)
#   -> formatter render (format_program_to_string)
#   -> re-parse + resolve + type + access + ownership validation
#      (edit_revalidate_source)
#   -> SemanticSnapshot' -> SemanticDelta -> ChangeBudget ->
#      ProofCarryingPatch (the CALLER's pipeline: the engine stops at the
#      validated source + the expected delta rows).
# The snapshot-level applies (ChangeContract) and the typed-program apply
# (FillHole) keep their original fields; the source pipeline leaves them
# None.
struct EditApplication
  edit: SemanticEdit
  applied: Vec[String] = Vec::new()
  snapshot: Option[SemanticSnapshot] = Option::None
  delta: Option[SemanticDelta] = Option::None
  resolved: Option[ResolvedEdit] = Option::None
  edited_source: String = ""
  parsed: Bool = false
  revalidated: Bool = false
  validation_detail: String = ""
  delta_rows: Vec[String] = Vec::new()
end

# ———————————————————————————————————————————————————————————————
# Resolution helpers over the typed index / snapshot
# ———————————————————————————————————————————————————————————————

# The name part of a stable def key (everything before "#signature").
def edit_name_part(key: String) -> String
  let i = edit_char_index(&key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

def edit_char_index(s: String, needle: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    if s.slice(i, i + 1) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# Resolve a declaration reference to its canonical full stable key: an exact
# full key (contains '#') must match a symbol row byte-for-byte; a bare /
# qualified NAME must match exactly one row's name / name-part (two matches
# are AmbiguousTarget, none TargetNotFound).
pub def edit_resolve_symbol_key(snapshot: SemanticSnapshot, decl: String) -> Result[String, EditError]
  if decl.contains("#") then
    for row in snapshot.symbols do
      if stable_key_eq(row.stable_id.key, decl) then
        return Result::Ok(row.stable_id.key.clone())
      end
    end
    return Result::Err(EditError::TargetNotFound)
  end
  var matches: Vec[String] = Vec::new()
  for row in snapshot.symbols do
    let name_part = edit_name_part(&row.stable_id.key)
    if row.name == decl || name_part == decl then
      if !matches.contains(&row.stable_id.key) then
        matches.push(row.stable_id.key.clone())
      end
    end
  end
  if matches.len() == 0 then
    return Result::Err(EditError::TargetNotFound)
  end
  if matches.len() > 1 then
    return Result::Err(EditError::AmbiguousTarget)
  end
  Result::Ok(matches[0].clone())
end

# The contract row of a StableContractId.stable_key (Option::None = absent).
def edit_find_contract(snapshot: SemanticSnapshot, contract_id: String) -> Option[ContractFact]
  for c in snapshot.contracts do
    if stable_key_eq(c.id.stable_key, contract_id) then
      return Option::Some(c)
    end
  end
  Option::None
end

# The canonical §31 call-row key of a CallEdge ("caller|callee|<digit>" —
# the delta's delta_call_row_key grammar; the digit authority is
# semantic_call_edge_kind_numeric).
def edit_call_row_key(c: CallEdge) -> String
  c.caller.key.clone() + "|" + c.callee.key.clone() + "|" +
    semantic_call_edge_kind_numeric(&c.kind).to_string()
end

# The call row whose canonical key equals call_site_key: the key must parse
# as a "call" StableRowKey AND a CallEdge row must reproduce it exactly.
def edit_find_call(snapshot: SemanticSnapshot, call_site_key: String) -> Option[CallEdge]
  match stable_row_key_of(call_site_key.clone())
  when Option::Some(rk) then
    if rk.domain != "call" then
      return Option::None
    end
  when Option::None then
    return Option::None
  end
  for c in snapshot.calls do
    if stable_key_eq(edit_call_row_key(c.clone()), call_site_key) then
      return Option::Some(c)
    end
  end
  Option::None
end

# The contract kind word of the row key grammar.
def edit_contract_kind_word(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The default dependency-closure kinds (the data-bearing classes; the
# no-row classes are covered by the call closure — see the module doc).
pub def semantic_edit_default_kinds() -> Vec[DependencyEdgeKind]
  var kinds: Vec[DependencyEdgeKind] = Vec::new()
  kinds.push(DependencyEdgeKind::Call)
  kinds.push(DependencyEdgeKind::EffectPropagation)
  kinds.push(DependencyEdgeKind::CapabilityPropagation)
  kinds.push(DependencyEdgeKind::Implements)
  kinds.push(DependencyEdgeKind::ContainsType)
  kinds.push(DependencyEdgeKind::AbiConsumer)
  kinds.push(DependencyEdgeKind::ContractReferences)
  kinds.push(DependencyEdgeKind::TestReferences)
  kinds
end

# The affected closure of one seed key: a one-seed delta walked through
# affected_closure over the default kinds. The seed itself is included (the
# closure's own contract).
pub def edit_seed_affected(snapshot: SemanticSnapshot, index: SemanticIndex, seed: String) -> Vec[String]
  var d = semantic_delta_empty()
  d.created = Vec::from([seed])
  affected_closure(&d, &snapshot, &index, semantic_edit_default_kinds())
end

# The row whose text starts with prefix (helper for the lane rows).
def edit_rows_with_prefix(rows: Vec[String], prefix: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for r in rows do
    if r.starts_with(prefix.clone()) then
      out.push(r.clone())
    end
  end
  out
end

# ———————————————————————————————————————————————————————————————
# The canonical hole key (audit item 54 identity, audit item 53 target;
# third-audit item 16 record migration)
# ———————————————————————————————————————————————————————————————
# The TYPED identity is stable_ids' StableHoleId { owner: StableDeclId,
# origin: StableHirNodeId } — the owner declaration plus the HIR node
# anchor. The canonical TEXT grammar "<fn stable def key>#hole<node seq>"
# is retained as the RENDER / wire form: these helpers are the protocol's
# thin text boundary over stable_ids' stable_hole_key_text /
# stable_hole_key_parts (the semantic_query hole.constraints op parses
# through the same functions). The typed constraints are read back by node
# id through types.tg's accessors.

pub def semantic_hole_key_of(function_key: String, hole_node: Int) -> String
  stable_hole_key_text(function_key, hole_node)
end

# Parse a canonical hole key into (function key prefix, node id). The LAST
# "#hole" separates (the function key itself carries '#'); the digits must
# be a non-empty decimal run. Option::None for any text outside the
# grammar.
pub def semantic_hole_key_parts(key: String) -> Option[(String, Int)]
  stable_hole_key_parts(&key)
end

# ———————————————————————————————————————————————————————————————
# resolve_edit — the typed resolution of one edit
# ———————————————————————————————————————————————————————————————
# The snapshot parameter is REQUIRED for the affected closure:
# affected_closure reads the b-side rows (callers, contracts, type texts,
# test rows — semantic_delta.tg), and the index alone carries no row
# payloads for it. index MUST be built from snapshot (the §32 contract).
pub def resolve_edit(
  index: SemanticIndex,
  snapshot: SemanticSnapshot,
  edit: SemanticEdit
) -> Result[ResolvedEdit, EditError]
  match edit
  when SemanticEdit::Rename(decl, new_name) then
    edit_resolve_rename(&snapshot, &index, decl, new_name)
  when SemanticEdit::ChangeSignature(decl, new_signature_text) then
    edit_resolve_change_signature(&snapshot, &index, decl, new_signature_text)
  when SemanticEdit::ChangeContract(contract_id, new_expression_text) then
    edit_resolve_change_contract(&snapshot, &index, contract_id, new_expression_text)
  when SemanticEdit::ReplaceCall(call_site_key, callee) then
    edit_resolve_replace_call(&snapshot, &index, call_site_key, callee)
  when SemanticEdit::InsertStatement(function_key, before_stmt_key, statement_text) then
    edit_resolve_insert_statement(&snapshot, &index, function_key, before_stmt_key, statement_text)
  when SemanticEdit::FillHole(hole_key, expression_text) then
    edit_resolve_fill_hole(&snapshot, &index, hole_key, expression_text)
  end
end

def edit_resolve_rename(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  decl: String,
  new_name: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, decl.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The resolved StableDeclId is the index's caller-map key (the typed id,
  # not the raw text): stable_decl_of_key re-derives the exact record from
  # the canonical key (the *_of_key accessor contract).
  let decl_id = stable_decl_of_key(target.clone())
  let callers = index_callers_of_decl(&index, decl_id)
  let affected = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("target:" + target.clone())
  pre.push("new-name:" + new_name.clone())
  pre.push("direct-callers:" + callers.len().to_string())
  pre.push("affected-total:" + affected.len().to_string())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::Rename(decl, new_name),
    targets: Vec::from([target.clone()]),
    affected: affected,
    preconditions: pre,
    expected_delta: Vec::from(["entity-modified:" + target])
  })
end

def edit_resolve_change_signature(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  decl: String,
  new_signature_text: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, decl.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The callsites-that-must-update count comes from the typed index's
  # reverse call map keyed by the resolved StableDeclId.
  let decl_id = stable_decl_of_key(target.clone())
  let callers = index_callers_of_decl(&index, decl_id)
  let affected = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("target:" + target.clone())
  pre.push("new-signature:" + new_signature_text.clone())
  pre.push("callsites-to-update:" + callers.len().to_string())
  pre.push("affected-total:" + affected.len().to_string())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(decl, new_signature_text),
    targets: Vec::from([target.clone()]),
    affected: affected,
    preconditions: pre,
    expected_delta: Vec::from(["entity-modified:" + target])
  })
end

def edit_resolve_change_contract(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  contract_id: String,
  new_expression_text: String
) -> Result[ResolvedEdit, EditError]
  let row = match edit_find_contract(&snapshot, contract_id.clone())
  when Option::Some(c) then c
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let fn_key = row.function.key.clone()
  let clause = semantic_contract_expr_text(&row.canonical_expression)
  let affected = edit_seed_affected(snapshot, index, fn_key.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("contract-row:" + contract_id.clone())
  pre.push("function:" + fn_key.clone())
  pre.push("canonical-clause:" + clause.clone())
  pre.push("new-clause:" + new_expression_text.clone())
  pre.push("affected-total:" + affected.len().to_string())
  # The clause TEXT is part of the StableContractId, so a canonical-content
  # edit re-keys the row: the expected §31 delta is the Removed old key +
  # Created new key pair. A text outside the canonical grammar is not
  # resolved as a delta (the apply fails PreconditionFailed) — the expected
  # row then names the malformed precondition instead of a fabricated key.
  var expected: Vec[String] = Vec::new()
  match edit_parse_canonical_expr(new_expression_text.clone())
  when Option::Some(new_ir) then
    let new_key = stable_contract_row_key(fn_key.clone(), edit_contract_kind_word(row.kind),
      semantic_contract_expr_text(&new_ir))
    expected.push("contract-created:" + new_key)
    expected.push("contract-removed:" + contract_id.clone())
  when Option::None then
    expected.push("contract-precondition-failed:" + contract_id.clone())
  end
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ChangeContract(contract_id.clone(), new_expression_text),
    targets: Vec::from([contract_id.clone(), fn_key]),
    affected: affected,
    preconditions: pre,
    expected_delta: expected
  })
end

def edit_resolve_replace_call(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  call_site_key: String,
  callee: String
) -> Result[ResolvedEdit, EditError]
  let call = match edit_find_call(&snapshot, call_site_key.clone())
  when Option::Some(c) then c
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let new_callee = match edit_resolve_symbol_key(&snapshot, callee.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  let caller_key = call.caller.key.clone()
  let old_callee_key = call.callee.key.clone()
  let affected = edit_seed_affected(snapshot, index, caller_key.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("call-row:" + call_site_key.clone())
  pre.push("caller:" + caller_key.clone())
  pre.push("old-callee:" + old_callee_key.clone())
  pre.push("new-callee:" + new_callee.clone())
  pre.push("affected-total:" + affected.len().to_string())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(call_site_key.clone(), callee),
    targets: Vec::from([call_site_key.clone(), new_callee]),
    affected: affected,
    preconditions: pre,
    expected_delta: Vec::from(["call-modified:" + call_site_key])
  })
end

def edit_resolve_insert_statement(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  function_key: String,
  before_stmt_key: String,
  statement_text: String
) -> Result[ResolvedEdit, EditError]
  let target = match edit_resolve_symbol_key(&snapshot, function_key.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  # The §33 statement key must belong to the resolved function: the node key
  # grammar is "<fn key>#B<block>#S<idx>" (or "#T" for a terminator). The
  # MIR statement table is not part of the index, so existence is verified
  # at apply on the AST/MIR surface; the function membership is verified
  # here.
  if !before_stmt_key.starts_with(target.clone() + "#B") then
    return Result::Err(EditError::TargetNotFound)
  end
  let affected = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("function:" + target.clone())
  pre.push("before-stmt:" + before_stmt_key.clone())
  pre.push("statement:" + statement_text.clone())
  pre.push("affected-total:" + affected.len().to_string())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::InsertStatement(function_key, before_stmt_key.clone(), statement_text),
    targets: Vec::from([target, before_stmt_key.clone()]),
    affected: affected,
    preconditions: pre,
    expected_delta: Vec::from(["stmt-inserted:" + before_stmt_key])
  })
end

def edit_resolve_fill_hole(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  hole_key: String,
  expression_text: String
) -> Result[ResolvedEdit, EditError]
  let parts = match semantic_hole_key_parts(hole_key.clone())
  when Option::Some(p) then p
  when Option::None then return Result::Err(EditError::TargetNotFound)
  end
  let fn_prefix = parts.0.clone()
  let node = parts.1
  let target = match edit_resolve_symbol_key(&snapshot, fn_prefix.clone())
  when Result::Ok(k) then k
  when Result::Err(e) then return Result::Err(e)
  end
  let canonical_hole = semantic_hole_key_of(target.clone(), node)
  let affected = edit_seed_affected(snapshot, index, target.clone())
  var pre: Vec[String] = Vec::new()
  pre.push("hole:" + canonical_hole.clone())
  pre.push("function:" + target.clone())
  pre.push("hole-node:" + node.to_string())
  pre.push("constraints-accessor:types.hole_constraints_of")
  pre.push("affected-total:" + affected.len().to_string())
  Result::Ok(ResolvedEdit {
    edit: SemanticEdit::FillHole(hole_key.clone(), expression_text),
    targets: Vec::from([target, canonical_hole.clone()]),
    affected: affected,
    preconditions: pre,
    expected_delta: Vec::from(["hole-filled:" + canonical_hole])
  })
end

# ———————————————————————————————————————————————————————————————
# apply_edit — the tractable apply surface
# ———————————————————————————————————————————————————————————————
# The snapshot-level apply entry. ChangeContract applies for real (the
# updated snapshot + the semantic_delta_of proof); FillHole applies on the
# typed-program surface via apply_fill_hole (this entry names it through
# ApplyUnavailable); Rename / ChangeSignature / ReplaceCall /
# InsertStatement carry no SNAPSHOT surface (their authority is source
# text), so this entry returns ApplyUnavailable for them — the REAL
# application is the source rewrite engine (third-audit item 30):
# apply_edit_to_source / edit_apply_to_source.
pub def apply_edit(snapshot: SemanticSnapshot, resolved: ResolvedEdit) -> Result[EditApplication, EditError]
  match resolved.edit
  when SemanticEdit::ChangeContract(contract_id, new_expression_text) then
    edit_apply_change_contract(&snapshot, contract_id, new_expression_text)
  when SemanticEdit::FillHole(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::Rename(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::ChangeSignature(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::ReplaceCall(_, _) then
    Result::Err(EditError::ApplyUnavailable)
  when SemanticEdit::InsertStatement(_, _, _) then
    Result::Err(EditError::ApplyUnavailable)
  end
end

# Parse a canonical contract expression text "op(arg,arg,...)" (the
# semantic_contract_expr_text grammar; args split at depth-0 commas).
# Option::None for any text outside the grammar (no '(' / no trailing ')' /
# unbalanced brackets) — the caller reports PreconditionFailed.
pub def edit_parse_canonical_expr(text: String) -> Option[ContractExprIR]
  let open = edit_char_index(&text, "(", 0)
  if open <= 0 then
    return Option::None
  end
  if text.len() < open + 2 then
    return Option::None
  end
  if text.slice(text.len() - 1, text.len()) != ")" then
    return Option::None
  end
  let op = text.slice(0, open)
  let body = text.slice(open + 1, text.len() - 1)
  var args: Vec[String] = Vec::new()
  if body.len() > 0 then
    var depth = 0
    var seg_start = 0
    var i = 0
    var ok = true
    # Quote-aware: canonical string-literal args ("str(<text>)") carry raw
    # text that may contain commas / brackets; a quote run keeps its inner
    # bytes out of the depth/split scan (an unterminated quote is rejected).
    var in_str = false
    var quote = "".to_string()
    while i < body.len() do
      let ch = body.slice(i, i + 1)
      if in_str then
        if ch == "\\" then
          i = i + 2
        elsif ch == quote then
          in_str = false
          i = i + 1
        else
          i = i + 1
        end
      else
        if ch == "\"" || ch == "'" then
          in_str = true
          quote = ch.clone()
        elsif ch == "(" || ch == "[" || ch == "{" then
          depth = depth + 1
        elsif ch == ")" || ch == "]" || ch == "}" then
          depth = depth - 1
          if depth < 0 then
            ok = false
          end
        elsif ch == "," && depth == 0 then
          args.push(body.slice(seg_start, i))
          seg_start = i + 1
        end
        i = i + 1
      end
    end
    if !ok || depth != 0 || in_str then
      return Option::None
    end
    args.push(body.slice(seg_start, body.len()))
  end
  Option::Some(ContractExprIR { op: op, args: args })
end

# The REAL snapshot apply: rebuild the contract row from the canonical text
# (canonical_expression + fingerprint + the re-keyed StableContractId),
# copy the snapshot, and diff before/after — the returned EditApplication
# carries both the updated snapshot and the actual §31 delta.
def edit_apply_change_contract(
  snapshot: SemanticSnapshot,
  contract_id: String,
  new_expression_text: String
) -> Result[EditApplication, EditError]
  let new_ir = match edit_parse_canonical_expr(new_expression_text.clone())
  when Option::Some(ir) then ir
  when Option::None then return Result::Err(EditError::PreconditionFailed)
  end
  let new_clause = semantic_contract_expr_text(&new_ir)
  var new_rows: Vec[ContractFact] = Vec::new()
  var found = false
  for c in snapshot.contracts do
    if stable_key_eq(c.id.stable_key, contract_id.clone()) then
      found = true
      let fn_key = c.function.key.clone()
      let new_key = stable_contract_row_key(fn_key, edit_contract_kind_word(c.kind), new_clause.clone())
      let fp = stable_digest_of(&new_clause)
      let key_words = stable_digest_of(&new_key)
      new_rows.push(ContractFact {
        id: StableContractId {
          dense_id: c.id.dense_id,
          stable_key: new_key.clone(),
          digest_hi: key_words.hi,
          digest_lo: key_words.lo
        },
        function: c.function.clone(),
        kind: c.kind,
        expression_fingerprint: fp,
        canonical_expression: new_ir.clone(),
        message: c.message.clone(),
        span: c.span.clone()
      })
    else
      new_rows.push(c)
    end
  end
  if !found then
    return Result::Err(EditError::TargetNotFound)
  end
  var after = snapshot
  after.contracts = new_rows
  let delta = semantic_delta_of(&snapshot, &after)
  Result::Ok(EditApplication {
    edit: SemanticEdit::ChangeContract(contract_id, new_expression_text),
    applied: Vec::from(["contract-updated:" + new_clause]),
    snapshot: Option::Some(after),
    delta: Option::Some(delta)
  })
end

# The typed-program patch surface for FillHole: verify the hole's node
# carries TypedExprKind::Hole, then replace the recorded typed node with the
# checker-produced replacement. `replacement` is the "provided expression's
# typed form" — the source text rides the edit, but only the front end can
# produce the typed node, so the caller supplies it (the honest split of
# this representation; the alternative — type-checking text inside the
# patch — needs the checker env, which the TypedProgram does not carry).
# SCOPE: this replaces the SEMANTIC record; the transitional MIR lowering
# is still AST-driven, so compiling the patched program additionally needs
# the AST/HIR expression rewrite (the MIR hole arm reports exactly that
# when it meets a filled typed node whose source is still `???`) — the
# patch never pretends the hole vanished from the AST.
pub def apply_fill_hole(
  inout program: TypedProgram,
  resolved: ResolvedEdit,
  replacement: TypedExpr
) -> Result[EditApplication, EditError]
  match resolved.edit
  when SemanticEdit::FillHole(hole_key, expression_text) then
    let parts = match semantic_hole_key_parts(hole_key.clone())
    when Option::Some(p) then p
    when Option::None then return Result::Err(EditError::TargetNotFound)
    end
    let node = parts.1
    match program.typed_exprs.get(node)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Hole then ()
      when _ then return Result::Err(EditError::PreconditionFailed)
      end
    when Option::None then
      return Result::Err(EditError::TargetNotFound)
    end
    program.typed_exprs.insert(node, replacement)
    Result::Ok(EditApplication {
      edit: SemanticEdit::FillHole(hole_key.clone(), expression_text),
      applied: Vec::from([
        "hole-filled:" + hole_key.clone(),
        "typed-node-replaced:" + node.to_string()
      ])
    })
  when _ then
    Result::Err(EditError::UnsupportedEdit)
  end
end

# The precise remaining-step text for an ApplyUnavailable result (the typed
# error carries no payload; this companion names the exact surface, never a
# marker token). For an edit that DOES apply, the text is the empty string.
pub def semantic_edit_unavailable_reason(edit: SemanticEdit) -> String
  match edit
  when SemanticEdit::Rename(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the declaration and every matching identifier/type/path occurrence are rewritten on the AST, rendered by the formatter and re-validated (third-audit item 30)"
  when SemanticEdit::ChangeSignature(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the declaration's signature is spliced on the AST and re-validated; call sites are NOT auto-updated in this slice (they ride ResolvedEdit.affected / callsites-to-update) (third-audit item 30)"
  when SemanticEdit::ChangeContract(_, _) then
    ""  # applies on the snapshot surface (edit_apply_change_contract)
  when SemanticEdit::ReplaceCall(_, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — every direct call site of the caller's body whose callee matches the old callee is replaced with the new callee, rendered and re-validated (third-audit item 30)"
  when SemanticEdit::InsertStatement(_, _, _) then
    "source rewrite surface: call apply_edit_to_source(source, resolved) — the statement text is parsed and spliced before the mapped §33 anchor (top-level body block B0), rendered and re-validated; a non-mappable anchor is PreconditionFailed with the reason (third-audit item 30)"
  when SemanticEdit::FillHole(_, _) then
    "typed-program patch surface: call apply_fill_hole(program, resolved, replacement) with the checker-produced replacement TypedExpr (the snapshot-only apply entry does not carry the typed program)"
  end
end

# ———————————————————————————————————————————————————————————————
# Lane rows (self-checking helpers a behavior lane can call)
# ———————————————————————————————————————————————————————————————
# The sibling style of semantic_delta.tg's affected_closure_lane_check: no
# test-file lane exists for this module, so the rows are self-checking
# helpers and each row records a mismatch string. Empty = all rows verify.

def edit_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 8,
    endian: "little".to_string(),
    abi: "lp64".to_string(),
    float_abi: "soft".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def edit_lane_snapshot() -> SemanticSnapshot
  semantic_snapshot_new("lane".to_string(), edit_lane_target())
end

def edit_lane_sid(key: String) -> StableDefId
  stable_def_id_digested(key.clone(), edit_name_part(&key))
end

def edit_lane_fn_symbol(key: String, name: String, is_pub: Bool) -> SemanticSymbol
  SemanticSymbol {
    stable_id: edit_lane_sid(&key),
    kind: DefKind::Function,
    name: name,
    module_path: "m".to_string(),
    is_pub: is_pub,
    is_generic: false
  }
end

def edit_lane_lists_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def edit_lane_row(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !edit_lane_lists_same(got, expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

def edit_lane_single_row(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

pub def edit_error_word(e: EditError) -> String
  match e
  when EditError::TargetNotFound then "TargetNotFound"
  when EditError::AmbiguousTarget then "AmbiguousTarget"
  when EditError::UnsupportedEdit then "UnsupportedEdit"
  when EditError::PreconditionFailed then "PreconditionFailed"
  when EditError::ApplyUnavailable then "ApplyUnavailable"
  end
end

# Run the resolve/apply lane rows over constructed index/snapshot fixtures.
# Returns every mismatch row (empty = the whole lane verifies).
pub def semantic_edit_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— L1: Rename target resolution + affected callers ————
  let k_a = "m::A#fn()->unit".to_string()
  let k_b = "m::B#fn()->unit".to_string()
  var s1 = edit_lane_snapshot()
  var s1_syms: Vec[SemanticSymbol] = Vec::new()
  s1_syms.push(edit_lane_fn_symbol(&k_a, "A".to_string(), false))
  s1_syms.push(edit_lane_fn_symbol(&k_b, "B".to_string(), false))
  s1.symbols = s1_syms
  var s1_calls: Vec[CallEdge] = Vec::new()
  s1_calls.push(CallEdge {
    caller: edit_lane_sid(&k_a),
    callee: edit_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  s1.calls = s1_calls
  let idx1 = build_semantic_index(&s1)
  match resolve_edit(&idx1, &s1, SemanticEdit::Rename(k_b.clone(), "C".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "rename-targets", r.targets.clone(), Vec::from([k_b.clone()]))
    edit_lane_row(&mut out, "rename-affected", r.affected.clone(), Vec::from([k_a.clone(), k_b.clone()]))
    edit_lane_row(&mut out, "rename-precondition-callers",
      edit_rows_with_prefix(r.preconditions.clone(), "direct-callers:".to_string()),
      Vec::from(["direct-callers:1".to_string()]))
    edit_lane_row(&mut out, "rename-expected-delta", r.expected_delta.clone(),
      Vec::from(["entity-modified:" + k_b.clone()]))
    # A resolved Rename has no apply surface: typed ApplyUnavailable.
    match apply_edit(&s1, r)
    when Result::Ok(_) then out.push("rename-apply: expected ApplyUnavailable, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "rename-apply", edit_error_word(e), "ApplyUnavailable")
    end
  when Result::Err(e) then
    out.push("rename-resolve: expected Ok, got " + edit_error_word(e))
  end

  # ———— L2: ambiguous bare name / unknown key ————
  let k_dup1 = "m::Dup#fn()->unit".to_string()
  let k_dup2 = "m2::Dup#fn()->unit".to_string()
  var s2 = edit_lane_snapshot()
  var s2_syms: Vec<SemanticSymbol> = Vec::new()
  s2_syms.push(edit_lane_fn_symbol(&k_dup1, "Dup".to_string(), false))
  s2_syms.push(edit_lane_fn_symbol(&k_dup2, "Dup".to_string(), false))
  s2.symbols = s2_syms
  let idx2 = build_semantic_index(&s2)
  match resolve_edit(&idx2, &s2, SemanticEdit::Rename("Dup".to_string(), "Z".to_string()))
  when Result::Ok(_) then out.push("rename-ambiguous: expected AmbiguousTarget, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "rename-ambiguous", edit_error_word(e), "AmbiguousTarget")
  end
  match resolve_edit(&idx2, &s2, SemanticEdit::Rename("m::Nope#fn()->unit".to_string(), "Z".to_string()))
  when Result::Ok(_) then out.push("rename-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "rename-missing", edit_error_word(e), "TargetNotFound")
  end

  # ———— L3: ChangeContract target + REAL apply (snapshot + delta) ————
  let k_f = "m::F#fn()->unit".to_string()
  let clause0 = "bingt(ident(amount),int(0))".to_string()
  let clause1 = "bingt(ident(amount),int(10))".to_string()
  let ckey0 = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause0.clone())
  var s3 = edit_lane_snapshot()
  var s3_syms: Vec[SemanticSymbol] = Vec::new()
  s3_syms.push(edit_lane_fn_symbol(&k_f, "F".to_string(), false))
  s3.symbols = s3_syms
  var c_args0: Vec[String] = Vec::new()
  c_args0.push("ident(amount)".to_string())
  c_args0.push("int(0)".to_string())
  var s3_contracts: Vec[ContractFact] = Vec::new()
  s3_contracts.push(ContractFact {
    id: StableContractId { dense_id: -1, stable_key: ckey0.clone() },
    function: edit_lane_sid(&k_f),
    kind: AstContractKind::AstPre,
    expression_fingerprint: stable_digest_of(&clause0),
    canonical_expression: ContractExprIR { op: "bingt".to_string(), args: c_args0 },
    message: Option::None
  })
  s3.contracts = s3_contracts
  let idx3 = build_semantic_index(&s3)
  match resolve_edit(&idx3, &s3, SemanticEdit::ChangeContract(ckey0.clone(), clause1.clone()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "contract-targets", r.targets.clone(),
      Vec::from([ckey0.clone(), k_f.clone()]))
    let expected_new_key = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone())
    edit_lane_row(&mut out, "contract-expected-delta", r.expected_delta.clone(),
      Vec::from(["contract-created:" + expected_new_key, "contract-removed:" + ckey0.clone()]))
    match apply_edit(&s3, r)
    when Result::Ok(app) then
      match app.snapshot
      when Option::Some(s_after) then
        if s_after.contracts.len() != 1 then
          out.push("contract-apply-snapshot: expected 1 row, got " + s_after.contracts.len().to_string())
        else
          let row0 = s_after.contracts[0]
          edit_lane_single_row(&mut out, "contract-apply-clause",
            semantic_contract_expr_text(&row0.canonical_expression), clause1.clone())
          edit_lane_single_row(&mut out, "contract-apply-key",
            row0.id.stable_key.clone(),
            stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone()))
        end
      when Option::None then
        out.push("contract-apply-snapshot: expected Some, got None")
      end
      match app.delta
      when Option::Some(d) then
        # The clause TEXT is part of the StableContractId key, so a canonical
        # expression edit re-keys the row: the delta carries the Removed old
        # key + Created new key pair (2 rows), not one Modified row.
        if d.contract_delta.len() != 2 then
          out.push("contract-apply-delta: expected 2 contract rows (Removed+Created), got " + d.contract_delta.len().to_string())
        else
          let new_key = stable_contract_row_key(k_f.clone(), "Pre".to_string(), clause1.clone())
          var saw_new = false
          var saw_old = false
          for cd in d.contract_delta do
            if cd.contract_id == new_key then
              saw_new = true
            end
            if cd.contract_id == ckey0 then
              saw_old = true
            end
          end
          if !saw_new then
            out.push("contract-apply-delta: missing the Created row for the new key")
          end
          if !saw_old then
            out.push("contract-apply-delta: missing the Removed row for the old key")
          end
        end
      when Option::None then
        out.push("contract-apply-delta: expected Some, got None")
      end
    when Result::Err(e) then
      out.push("contract-apply: expected Ok, got " + edit_error_word(e))
    end
  when Result::Err(e) then
    out.push("contract-resolve: expected Ok, got " + edit_error_word(e))
  end
  # A malformed canonical text is PreconditionFailed at apply (the text
  # resolves as a row edit, then fails the apply parse).
  match resolve_edit(&idx3, &s3, SemanticEdit::ChangeContract(ckey0.clone(), "not-canonical".to_string()))
  when Result::Ok(r2) then
    match apply_edit(&s3, r2)
    when Result::Ok(_) then out.push("contract-malformed: expected PreconditionFailed, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "contract-malformed", edit_error_word(e), "PreconditionFailed")
    end
  when Result::Err(e) then
    out.push("contract-malformed-resolve: expected Ok, got " + edit_error_word(e))
  end

  # ———— L4: ReplaceCall target / InsertStatement prefix ————
  let call_key = edit_call_row_key(CallEdge {
    caller: edit_lane_sid(&k_a),
    callee: edit_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall(call_key.clone(), k_b.clone()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "call-targets", r.targets.clone(), Vec::from([call_key.clone(), k_b.clone()]))
    edit_lane_row(&mut out, "call-precondition-old-callee",
      edit_rows_with_prefix(r.preconditions.clone(), "old-callee:".to_string()),
      Vec::from(["old-callee:" + k_b.clone()]))
  when Result::Err(e) then
    out.push("call-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall("m::A#fn()->unit|m::Z#fn()->unit|0".to_string(), k_b.clone()))
  when Result::Ok(_) then out.push("call-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "call-missing", edit_error_word(e), "TargetNotFound")
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::ReplaceCall(call_key.clone(), "m::Z#fn()->unit".to_string()))
  when Result::Ok(_) then out.push("call-newcallee-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "call-newcallee-missing", edit_error_word(e), "TargetNotFound")
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::InsertStatement(k_a.clone(), k_a.clone() + "#B0#S0", "let x = 1".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "insert-targets", r.targets.clone(),
      Vec::from([k_a.clone(), k_a.clone() + "#B0#S0"]))
  when Result::Err(e) then
    out.push("insert-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::InsertStatement(k_a.clone(), k_b.clone() + "#B0#S0", "let x = 1".to_string()))
  when Result::Ok(_) then out.push("insert-foreign-stmt: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "insert-foreign-stmt", edit_error_word(e), "TargetNotFound")
  end

  # ———— L5: FillHole target resolution ————
  let hole_key = semantic_hole_key_of(k_a.clone(), 7)
  match resolve_edit(&idx1, &s1, SemanticEdit::FillHole(hole_key.clone(), "42".to_string()))
  when Result::Ok(r) then
    edit_lane_row(&mut out, "hole-targets", r.targets.clone(), Vec::from([k_a.clone(), hole_key.clone()]))
    edit_lane_row(&mut out, "hole-expected-delta", r.expected_delta.clone(),
      Vec::from(["hole-filled:" + hole_key.clone()]))
    match apply_edit(&s1, r)
    when Result::Ok(_) then out.push("hole-apply: expected ApplyUnavailable, got Ok")
    when Result::Err(e) then edit_lane_single_row(&mut out, "hole-apply", edit_error_word(e), "ApplyUnavailable")
    end
  when Result::Err(e) then
    out.push("hole-resolve: expected Ok, got " + edit_error_word(e))
  end
  match resolve_edit(&idx1, &s1, SemanticEdit::FillHole("no-hole-tag".to_string(), "42".to_string()))
  when Result::Ok(_) then out.push("hole-missing: expected TargetNotFound, got Ok")
  when Result::Err(e) then edit_lane_single_row(&mut out, "hole-missing", edit_error_word(e), "TargetNotFound")
  end

  # ———— L6: canonical hole key round-trip ————
  let hk = semantic_hole_key_of(k_b.clone(), 123)
  edit_lane_single_row(&mut out, "hole-key-text", hk.clone(), k_b.clone() + "#hole123")
  match semantic_hole_key_parts(hk.clone())
  when Option::Some(p) then
    edit_lane_single_row(&mut out, "hole-key-prefix", p.0, k_b.clone())
    edit_lane_single_row(&mut out, "hole-key-node", p.1.to_string(), "123")
  when Option::None then
    out.push("hole-key-parse: expected Some, got None")
  end

  out
end

# ———————————————————————————————————————————————————————————————
# The typed-hole lane (audit item 54): parser + checker end to end
# ———————————————————————————————————————————————————————————————
# Parses a tiny program whose body is `???`, then:
#   hole mode — checks cleanly, records the constraints, the typed node is
#     TypedExprKind::Hole, and typed_hole_constraints_of reads the resolved
#     expected type back through the artifact;
#   non-hole mode — the checker rejects the hole with a diagnostic naming
#     it ("unfilled typed hole");
#   apply_fill_hole — replaces the hole's recorded typed node.
pub def typed_hole_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let src = "def f() -> Int do ??? end"
  let tokens = tokenize(src, "hole_lane.tg")
  let parsed = parse(tokens)
  var program = parsed.program
  assign_node_ids(&mut program)
  let resolutions = match resolve_names(program.clone())
  when Result::Ok(r) then r
  when Result::Err(_) then
    out.push("hole-lane: resolution failed on the lane program")
    return out
  end

  # ———— hole mode: checks cleanly, constraints + typed node recorded ————
  var env = type_env_new()
  let r = type_check_typed_holes(&mut env, program.clone(), resolutions.clone())
  if !r.errors.is_empty() then
    out.push("hole-mode: expected no errors, got " + r.errors.len().to_string())
  end
  var hole_node = -1
  var holes_seen = 0
  for entry in env.hole_constraints.entries() do
    holes_seen = holes_seen + 1
    hole_node = entry.0
    match hole_constraints_of(&env, entry.0)
    when Option::Some(hc) then
      edit_lane_single_row(&mut out, "hole-expected-type", hc.expected_type.clone(), "Int".to_string())
    when Option::None then
      out.push("hole-constraints-of: expected Some, got None")
    end
    match r.program.typed.typed_exprs.get(entry.0)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Hole then ()
      when _ then out.push("hole-typed-node: expected Hole")
      end
    when Option::None then
      out.push("hole-typed-node: expected a recorded typed node, got None")
    end
    match typed_hole_constraints_of(&r.program.typed, entry.0)
    when Option::Some(hc2) then
      edit_lane_single_row(&mut out, "hole-artifact-expected-type", hc2.expected_type.clone(), "Int".to_string())
    when Option::None then
      out.push("typed-hole-constraints-of: expected Some, got None")
    end
  end
  if holes_seen != 1 then
    out.push("hole-count: expected 1 constraint record, got " + holes_seen.to_string())
  end

  # ———— non-hole mode: the hole is rejected, naming itself ————
  var env2 = type_env_new()
  let r2 = type_check_typed(&mut env2, program.clone(), resolutions.clone())
  if r2.errors.is_empty() then
    out.push("hole-reject: expected at least one error, got none")
  else
    var named = false
    var ei = 0
    while ei < r2.errors.len() do
      if r2.errors[ei].message.contains("hole") then
        named = true
      end
      ei = ei + 1
    end
    if !named then
      out.push("hole-reject: no error message names the hole")
    end
  end

  # ———— apply_fill_hole replaces the recorded typed node ————
  if hole_node >= 0 then
    var typed = r.program.typed
    let hole_key = semantic_hole_key_of("m::F#fn()->unit".to_string(), hole_node)
    var pre: Vec[String] = Vec::new()
    pre.push("hole:" + hole_key.clone())
    let resolved_fill = ResolvedEdit {
      edit: SemanticEdit::FillHole(hole_key.clone(), "42".to_string()),
      targets: Vec::from([hole_key.clone()]),
      affected: Vec::new(),
      preconditions: pre,
      expected_delta: Vec::from(["hole-filled:" + hole_key.clone()])
    }
    let replacement = TypedExpr {
      id: hole_node,
      ty: Type::Int,
      kind: TypedExprKind::Literal(hole_node)
    }
    match apply_fill_hole(&mut typed, resolved_fill, replacement)
    when Result::Ok(_) then
      match typed.typed_exprs.get(hole_node)
      when Option::Some(te2) then
        match te2.kind
        when TypedExprKind::Hole then out.push("fill-apply: typed node still Hole")
        when _ then ()
        end
      when Option::None then out.push("fill-apply: typed node missing after apply")
      end
    when Result::Err(e) then
      out.push("fill-apply: expected Ok, got " + edit_error_word(e))
    end
  end

  out
end

# ———————————————————————————————————————————————————————————————
# THE SOURCE REWRITE ENGINE (third-audit item 30)
# ———————————————————————————————————————————————————————————————
# The semantic edit protocol becomes a REAL rewrite engine: a resolved
# edit (resolve_edit above) is applied to the PARSED AST of one source
# text and the edited tree is RENDERED back to source through the
# canonical formatter. The engine is bounded and conservative:
#   Rename           — locate the declaration the resolved stable key
#                      names (by name inside the source; the stable id was
#                      already resolved), rename the declaration and
#                      every identifier/type/path occurrence whose text
#                      matches the old name. Reference-level precision is
#                      bounded by the re-validation: the regenerated source
#                      is re-parsed, re-resolved, re-type-checked and
#                      re-ownership-checked, and any edit the resolver/
#                      checker rejects fails closed with
#                      EditError::PreconditionFailed (the evidence text
#                      rides apply_edit_to_source_checked).
#   ReplaceCall      — locate the caller function the call-row key names,
#                      replace every direct call site in its body whose
#                      callee name equals the old callee with the new
#                      callee (bare name or qualified path). Indirect /
#                      intrinsic call rows are PreconditionFailed — their
#                      callee is not a name in the source.
#   InsertStatement  — parse the statement text, map the §33 anchor
#                      "<fn key>#B<block>#S<idx>" to the function's
#                      top-level body block (block 0) and splice the
#                      statement before that statement ordinal. An anchor
#                      outside the mappable surface (non-zero block,
#                      out-of-range index, non-block body) is
#                      PreconditionFailed with the reason.
#   ChangeSignature  — parse the replacement signature text and splice the
#                      declaration's name/generics/params/return/where
#                      clause. Call sites are NOT rewritten in this slice:
#                      the resolved callers ride ResolvedEdit.affected /
#                      the "callsites-to-update:<n>" precondition and the
#                      apply records a "callsites-not-updated:<n>" row.
#   ChangeContract   — stays on the snapshot surface (apply_edit).
#   FillHole         — stays on the typed-program surface (apply_fill_hole).
#
# VALIDATION DEPTH: edit_revalidate_source runs parse -> assign_node_ids
# -> resolve_names -> type_check_typed -> build_typed_cfg -> access_check
# -> resource_check, i.e. the same front-end depth compiler_core's
# analyze_source reaches (minus the macro-expansion / @cfg prologue, which
# compiler_core's prepare_parsed owns and this module cannot import without
# dragging the backend in; a source whose semantics depend on unexpanded
# macros fails closed at resolution/checking). No env gates, no driver.

# ———————————————————————————————————————————————————————————————
# Declaration sites and key-text helpers
# ———————————————————————————————————————————————————————————————

# The declaration site a resolved stable key maps to inside one parsed
# source module: a top-level item, a struct method or an impl method (the
# only three shapes the source engine rewrites).
enum EditItemSite
  EditSiteNone
  EditSiteTop(Int)
  EditSiteStructMethod(Int, Int)
  EditSiteImplMethod(Int, Int)
end

# The byte index of `needle` (any length) at or after `from` (-1 absent).
def edit_str_index(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The FINAL "::" segment of a stable key's name part ("m::A::b" -> "b").
pub def edit_key_name_segment(key: String) -> String
  let name_part = edit_name_part(&key)
  var found = -1
  var pos = name_part.len()
  while pos >= 2 do
    if name_part.slice(pos - 2, pos) == "::" then
      found = pos
      break
    end
    pos = pos - 1
  end
  if found < 0 then name_part.clone() else name_part.slice(found, name_part.len()) end
end

# The segment BEFORE the final one ("m::A::b" -> "A"; "m::A" -> "m"; a
# single-segment name -> "").
pub def edit_key_owner_segment(key: String) -> String
  let name_part = edit_name_part(&key)
  var last = -1
  var pos = name_part.len()
  while pos >= 2 do
    if name_part.slice(pos - 2, pos) == "::" then
      last = pos - 2
      break
    end
    pos = pos - 1
  end
  if last < 0 then
    return "".to_string()
  end
  let head = name_part.slice(0, last)
  var prev = -1
  var p2 = head.len()
  while p2 >= 2 do
    if head.slice(p2 - 2, p2) == "::" then
      prev = p2
      break
    end
    p2 = p2 - 1
  end
  if prev < 0 then head.clone() else head.slice(prev, head.len()) end
end

# Split a "a::b::c" text at every "::" (the callee path shape).
pub def edit_colon_segments(s: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var start = 0
  var i = 0
  while i + 2 <= s.len() do
    if s.slice(i, i + 2) == "::" then
      out.push(s.slice(start, i))
      i = i + 2
      start = i
    else
      i = i + 1
    end
  end
  out.push(s.slice(start, s.len()))
  out
end

# Split a call-row key "caller|callee|kind" at every '|'.
def edit_pipe_parts(s: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var start = 0
  var i = 0
  while i < s.len() do
    if s.slice(i, i + 1) == "|" then
      out.push(s.slice(start, i))
      start = i + 1
    end
    i = i + 1
  end
  out.push(s.slice(start, s.len()))
  out
end

# The declared name of an item ("" for the anonymous kinds: impl / extern
# block / attribute-only items).
def edit_item_decl_name(item: Item) -> String
  match item.kind
  when ItemKind::ItemFunction(f) then f.name.clone()
  when ItemKind::ItemStruct(s) then s.name.clone()
  when ItemKind::ItemEnum(e) then e.name.clone()
  when ItemKind::ItemTrait(t) then t.name.clone()
  when ItemKind::ItemModule(m) then m.name.clone()
  when ItemKind::ItemTypeAlias(ta) then ta.name.clone()
  when ItemKind::ItemConst(c) then c.name.clone()
  when ItemKind::ItemStatic(s) then s.name.clone()
  when ItemKind::ItemMacro(m) then m.name.clone()
  when ItemKind::ItemCapabilityDecl(c) then c.name.clone()
  when ItemKind::ItemEffectDecl(e) then e.name.clone()
  when _ then "".to_string()
  end
end

# The first top-level item whose declared name equals `name` (a duplicate
# name is not this engine's discovery — a valid module has one).
def edit_locate_top(program: Program, name: String) -> EditItemSite
  var found = EditItemSite::EditSiteNone
  var hits = 0
  var i = 0
  while i < program.items.len() do
    if edit_item_decl_name(program.items[i]) == name then
      if hits == 0 then
        found = EditItemSite::EditSiteTop(i)
      end
      hits = hits + 1
    end
    i = i + 1
  end
  if hits == 1 then found else EditItemSite::EditSiteNone end
end

# The struct/impl method whose owner type name and method name match.
def edit_locate_method(program: Program, owner: String, name: String) -> EditItemSite
  if owner.len() == 0 then
    return EditItemSite::EditSiteNone
  end
  var i = 0
  while i < program.items.len() do
    match program.items[i].kind
    when ItemKind::ItemStruct(s) then
      if s.name == owner then
        var m = 0
        while m < s.methods.len() do
          if s.methods[m].name == name then
            return EditItemSite::EditSiteStructMethod(i, m)
          end
          m = m + 1
        end
      end
    when ItemKind::ItemImpl(im) then
      if type_expr_name(im.for_type) == owner then
        var m2 = 0
        while m2 < im.methods.len() do
          if im.methods[m2].name == name then
            return EditItemSite::EditSiteImplMethod(i, m2)
          end
          m2 = m2 + 1
        end
      end
    when _ then ()
    end
    i = i + 1
  end
  EditItemSite::EditSiteNone
end

# Locate the declaration a resolved stable key names: the owner-qualified
# method first (the stable key's "Type::method" shape), then the top-level
# declaration by final segment.
pub def edit_locate_decl(program: Program, key: String) -> EditItemSite
  let name = edit_key_name_segment(key.clone())
  let owner = edit_key_owner_segment(key.clone())
  let method = edit_locate_method(program.clone(), owner, name.clone())
  match method
  when EditItemSite::EditSiteNone then edit_locate_top(program, name)
  when _ then method
  end
end

# Locate the FUNCTION the key names (a top-level function or a method); a
# matching non-function item resolves to EditSiteNone.
def edit_locate_function_site(program: Program, key: String) -> EditItemSite
  let site = edit_locate_decl(program.clone(), key)
  match site
  when EditItemSite::EditSiteTop(i) then
    match program.items[i].kind
    when ItemKind::ItemFunction(_) then site
    when _ then EditItemSite::EditSiteNone
    end
  when _ then site
  end
end

# The declared name at a located site.
def edit_site_decl_name(program: Program, site: EditItemSite) -> String
  match site
  when EditItemSite::EditSiteTop(i) then edit_item_decl_name(program.items[i])
  when EditItemSite::EditSiteStructMethod(i, m) then
    match program.items[i].kind
    when ItemKind::ItemStruct(s) then s.methods[m].name.clone()
    when _ then "".to_string()
    end
  when EditItemSite::EditSiteImplMethod(i, m) then
    match program.items[i].kind
    when ItemKind::ItemImpl(im) then im.methods[m].name.clone()
    when _ then "".to_string()
    end
  when EditItemSite::EditSiteNone then "".to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# Rename rewriting (declaration + reference occurrences)
# ———————————————————————————————————————————————————————————————

def edit_mk_expr(kind: ExprKind, like: Expr) -> Expr
  Expr { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_stmt(kind: StmtKind, like: Stmt) -> Stmt
  Stmt { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_pattern(kind: PatternKind, like: Pattern) -> Pattern
  Pattern { kind: kind, span: like.span.clone(), node_id: like.node_id }
end

def edit_mk_type(kind: TypeExprKind, like: TypeExpr) -> TypeExpr
  TypeExpr { kind: kind, span: like.span.clone() }
end

def edit_rename_path(path: AstPath, old: String, new: String) -> AstPath
  var segs: Vec[String] = Vec::new()
  for seg in path.segments do
    if seg == old then segs.push(new.clone()) else segs.push(seg.clone()) end
  end
  AstPath { segments: segs, span: path.span.clone() }
end

def edit_rw_strings(items: Vec[String], old: String, new: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for it in items do
    if it == old then out.push(new.clone()) else out.push(it.clone()) end
  end
  out
end

def edit_rw_string_opt(item: Option[String], old: String, new: String) -> Option[String]
  match item
  when Option::Some(s) then
    if s == old then Option::Some(new.clone()) else Option::Some(s.clone()) end
  when Option::None then Option::None
  end
end

def edit_rw_exprs(exprs: Vec[Expr], old: String, new: String) -> Vec[Expr]
  var out: Vec[Expr] = Vec::new()
  var i = 0
  while i < exprs.len() do
    out.push(edit_rename_expr(exprs[i], old.clone(), new.clone()))
    i = i + 1
  end
  out
end

def edit_rw_expr_opt(item: Option[Expr], old: String, new: String) -> Option[Expr]
  match item
  when Option::Some(e) then Option::Some(edit_rename_expr(e, old, new))
  when Option::None then Option::None
  end
end

def edit_rw_expr_box_opt(item: Option[Box[Expr]], old: String, new: String) -> Option[Box[Expr]]
  match item
  when Option::Some(e) then Option::Some(Box::new(edit_rename_expr(e, old, new)))
  when Option::None then Option::None
  end
end

def edit_rw_expr_field_pairs(pairs: Vec[(String, Expr)], old: String, new: String) -> Vec[(String, Expr)]
  var out: Vec[(String, Expr)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((pairs[i].0.clone(), edit_rename_expr(pairs[i].1, old.clone(), new.clone())))
    i = i + 1
  end
  out
end

def edit_rw_expr_pairs(pairs: Vec[(Expr, Expr)], old: String, new: String) -> Vec[(Expr, Expr)]
  var out: Vec[(Expr, Expr)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((
      edit_rename_expr(pairs[i].0, old.clone(), new.clone()),
      edit_rename_expr(pairs[i].1, old.clone(), new.clone())
    ))
    i = i + 1
  end
  out
end

def edit_rw_patterns(pats: Vec[Pattern], old: String, new: String) -> Vec[Pattern]
  var out: Vec[Pattern] = Vec::new()
  var i = 0
  while i < pats.len() do
    out.push(edit_rename_pattern(pats[i], old.clone(), new.clone()))
    i = i + 1
  end
  out
end

def edit_rw_pattern_pairs(pairs: Vec[(String, Pattern)], old: String, new: String) -> Vec[(String, Pattern)]
  var out: Vec[(String, Pattern)] = Vec::new()
  var i = 0
  while i < pairs.len() do
    out.push((pairs[i].0.clone(), edit_rename_pattern(pairs[i].1, old.clone(), new.clone())))
    i = i + 1
  end
  out
end

def edit_rw_types(items: Vec[TypeExpr], old: String, new: String) -> Vec[TypeExpr]
  var out: Vec[TypeExpr] = Vec::new()
  var i = 0
  while i < items.len() do
    out.push(edit_rename_type(items[i], old.clone(), new.clone()))
    i = i + 1
  end
  out
end

def edit_rw_type_opt(item: Option[TypeExpr], old: String, new: String) -> Option[TypeExpr]
  match item
  when Option::Some(t) then Option::Some(edit_rename_type(t, old, new))
  when Option::None then Option::None
  end
end

def edit_rename_type(te: TypeExpr, old: String, new: String) -> TypeExpr
  match te.kind
  when TypeExprKind::Named(name, args) then
    let nn = if name == old then new.clone() else name.clone() end
    edit_mk_type(TypeExprKind::Named(nn, edit_rw_types(args, old, new)), te)
  when TypeExprKind::ConstArg(v) then te.clone()
  when TypeExprKind::ConstExpr(e) then
    edit_mk_type(TypeExprKind::ConstExpr(edit_rename_expr(e, old, new)), te)
  when TypeExprKind::Unit then te.clone()
  when TypeExprKind::Never then te.clone()
  when TypeExprKind::Tuple(items) then
    edit_mk_type(TypeExprKind::Tuple(edit_rw_types(items, old, new)), te)
  when TypeExprKind::Array(elem, size) then
    edit_mk_type(TypeExprKind::Array(
      edit_rename_type(elem, old, new), edit_rw_expr_opt(size, old, new)), te)
  when TypeExprKind::Slice(elem) then
    edit_mk_type(TypeExprKind::Slice(edit_rename_type(elem, old, new)), te)
  when TypeExprKind::Ptr(elem) then
    edit_mk_type(TypeExprKind::Ptr(edit_rename_type(elem, old, new)), te)
  when TypeExprKind::PtrMut(elem) then
    edit_mk_type(TypeExprKind::PtrMut(edit_rename_type(elem, old, new)), te)
  when TypeExprKind::Ref(elem, is_mut) then
    edit_mk_type(TypeExprKind::Ref(edit_rename_type(elem, old, new), is_mut), te)
  when TypeExprKind::Fn(params, ret) then
    var ps: Vec[ParamTypeExpr] = Vec::new()
    var i = 0
    while i < params.len() do
      ps.push(ParamTypeExpr {
        ty: edit_rename_type(params[i].ty, old.clone(), new.clone()),
        convention: params[i].convention
      })
      i = i + 1
    end
    edit_mk_type(TypeExprKind::Fn(ps, edit_rename_type(ret, old, new)), te)
  when TypeExprKind::Async(inner) then
    edit_mk_type(TypeExprKind::Async(edit_rename_type(inner, old, new)), te)
  when TypeExprKind::Effect(name, inner) then
    let nn = if name == old then new.clone() else name.clone() end
    edit_mk_type(TypeExprKind::Effect(nn, edit_rename_type(inner, old, new)), te)
  when TypeExprKind::Path(path) then
    edit_mk_type(TypeExprKind::Path(edit_rename_path(path, old, new)), te)
  when TypeExprKind::Infer then te.clone()
  end
end

def edit_rename_expr(expr: Expr, old: String, new: String) -> Expr
  match expr.kind
  when ExprKind::ExprIntLit(_) then expr.clone()
  when ExprKind::ExprFloatLit(_) then expr.clone()
  when ExprKind::ExprStringLit(_) then expr.clone()
  when ExprKind::ExprCharLit(_) then expr.clone()
  when ExprKind::ExprBoolLit(_) then expr.clone()
  when ExprKind::ExprNilLit then expr.clone()
  when ExprKind::ExprArrayLit(elems) then
    edit_mk_expr(ExprKind::ExprArrayLit(edit_rw_exprs(elems, old, new)), expr)
  when ExprKind::ExprArrayRepeat(elem, count) then
    edit_mk_expr(ExprKind::ExprArrayRepeat(
      Box::new(edit_rename_expr(elem, old.clone(), new.clone())),
      Box::new(edit_rename_expr(count, old, new))), expr)
  when ExprKind::ExprTupleLit(elems) then
    edit_mk_expr(ExprKind::ExprTupleLit(edit_rw_exprs(elems, old, new)), expr)
  when ExprKind::ExprStructLit(path, fields) then
    edit_mk_expr(ExprKind::ExprStructLit(
      edit_rename_path(path, old.clone(), new.clone()),
      edit_rw_expr_field_pairs(fields, old, new)), expr)
  when ExprKind::ExprMapLit(entries) then
    edit_mk_expr(ExprKind::ExprMapLit(edit_rw_expr_pairs(entries, old, new)), expr)
  when ExprKind::ExprIdent(name) then
    if name == old then
      edit_mk_expr(ExprKind::ExprIdent(new.clone()), expr)
    else
      expr.clone()
    end
  when ExprKind::ExprPath(path) then
    edit_mk_expr(ExprKind::ExprPath(edit_rename_path(path, old, new)), expr)
  when ExprKind::ExprSelfRef then expr.clone()
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    edit_mk_expr(ExprKind::ExprBinaryOp(op,
      Box::new(edit_rename_expr(lhs, old.clone(), new.clone())),
      Box::new(edit_rename_expr(rhs, old, new))), expr)
  when ExprKind::ExprUnaryOp(op, operand) then
    edit_mk_expr(ExprKind::ExprUnaryOp(op, Box::new(edit_rename_expr(operand, old, new))), expr)
  when ExprKind::ExprFieldAccess(base, field) then
    edit_mk_expr(ExprKind::ExprFieldAccess(
      Box::new(edit_rename_expr(base, old, new)), field), expr)
  when ExprKind::ExprMethodCall(recv, name, targs, args) then
    let nn = if name == old then new.clone() else name.clone() end
    edit_mk_expr(ExprKind::ExprMethodCall(
      Box::new(edit_rename_expr(recv, old.clone(), new.clone())),
      nn, edit_rw_types(targs, old.clone(), new.clone()),
      edit_rw_exprs(args, old, new)), expr)
  when ExprKind::ExprIndex(base, index) then
    edit_mk_expr(ExprKind::ExprIndex(
      Box::new(edit_rename_expr(base, old.clone(), new.clone())),
      Box::new(edit_rename_expr(index, old, new))), expr)
  when ExprKind::ExprCall(callee, args) then
    edit_mk_expr(ExprKind::ExprCall(
      Box::new(edit_rename_expr(callee, old.clone(), new.clone())),
      edit_rw_exprs(args, old, new)), expr)
  when ExprKind::ExprClosure(params, ret, body) then
    var ps: Vec[ClosureParam] = Vec::new()
    var i = 0
    while i < params.len() do
      ps.push(ClosureParam {
        pat: edit_rename_pattern(params[i].pat, old.clone(), new.clone()),
        ty: edit_rw_type_opt(params[i].ty, old.clone(), new.clone()),
        span: params[i].span.clone()
      })
      i = i + 1
    end
    edit_mk_expr(ExprKind::ExprClosure(
      ps, edit_rw_type_opt(ret, old.clone(), new.clone()),
      Box::new(edit_rename_expr(body, old, new))), expr)
  when ExprKind::ExprAccess(inner) then
    edit_mk_expr(ExprKind::ExprAccess(Box::new(edit_rename_expr(inner, old, new))), expr)
  when ExprKind::ExprRawDeref(inner) then
    edit_mk_expr(ExprKind::ExprRawDeref(Box::new(edit_rename_expr(inner, old, new))), expr)
  when ExprKind::ExprIf(if_stmt) then
    edit_mk_expr(ExprKind::ExprIf(edit_rename_if(if_stmt, old, new)), expr)
  when ExprKind::ExprMatch(m) then
    edit_mk_expr(ExprKind::ExprMatch(edit_rename_match(m, old, new)), expr)
  when ExprKind::ExprBlock(block) then
    edit_mk_expr(ExprKind::ExprBlock(edit_rename_block(block, old, new)), expr)
  when ExprKind::ExprUnsafe(reason, block) then
    edit_mk_expr(ExprKind::ExprUnsafe(reason, edit_rename_block(block, old, new)), expr)
  when ExprKind::ExprAsync(block) then
    edit_mk_expr(ExprKind::ExprAsync(edit_rename_block(block, old, new)), expr)
  when ExprKind::ExprAwait(inner) then
    edit_mk_expr(ExprKind::ExprAwait(Box::new(edit_rename_expr(inner, old, new))), expr)
  when ExprKind::ExprTry(inner) then
    edit_mk_expr(ExprKind::ExprTry(Box::new(edit_rename_expr(inner, old, new))), expr)
  when ExprKind::ExprRange(start, stop, inclusive) then
    edit_mk_expr(ExprKind::ExprRange(
      edit_rw_expr_box_opt(start, old.clone(), new.clone()),
      edit_rw_expr_box_opt(stop, old, new), inclusive), expr)
  when ExprKind::ExprCast(inner, ty) then
    edit_mk_expr(ExprKind::ExprCast(
      Box::new(edit_rename_expr(inner, old.clone(), new.clone())),
      edit_rename_type(ty, old, new)), expr)
  when ExprKind::ExprTypeCheck(inner, ty) then
    edit_mk_expr(ExprKind::ExprTypeCheck(
      Box::new(edit_rename_expr(inner, old.clone(), new.clone())),
      edit_rename_type(ty, old, new)), expr)
  when ExprKind::ExprComptime(block) then
    edit_mk_expr(ExprKind::ExprComptime(edit_rename_block(block, old, new)), expr)
  when ExprKind::ExprEnumVariant(path, targs, args) then
    edit_mk_expr(ExprKind::ExprEnumVariant(
      edit_rename_path(path, old.clone(), new.clone()),
      edit_rw_types(targs, old.clone(), new.clone()),
      edit_rw_exprs(args, old, new)), expr)
  when ExprKind::ExprAssign(target, value) then
    edit_mk_expr(ExprKind::ExprAssign(
      Box::new(edit_rename_expr(target, old.clone(), new.clone())),
      Box::new(edit_rename_expr(value, old, new))), expr)
  when ExprKind::ExprPipe(lhs, rhs) then
    edit_mk_expr(ExprKind::ExprPipe(
      Box::new(edit_rename_expr(lhs, old.clone(), new.clone())),
      Box::new(edit_rename_expr(rhs, old, new))), expr)
  when ExprKind::ExprMacroCall(name, args) then
    let nn = if name == old then new.clone() else name.clone() end
    edit_mk_expr(ExprKind::ExprMacroCall(nn, edit_rw_exprs(args, old, new)), expr)
  when ExprKind::ExprHole then expr.clone()
  when ExprKind::ExprError(_) then expr.clone()
  end
end

def edit_rename_pattern(pat: Pattern, old: String, new: String) -> Pattern
  match pat.kind
  when PatternKind::Wildcard then pat.clone()
  when PatternKind::Ident(name, is_mut) then
    if name == old then
      edit_mk_pattern(PatternKind::Ident(new.clone(), is_mut), pat)
    else
      pat.clone()
    end
  when PatternKind::Literal(e) then
    edit_mk_pattern(PatternKind::Literal(edit_rename_expr(e, old, new)), pat)
  when PatternKind::Tuple(items) then
    edit_mk_pattern(PatternKind::Tuple(edit_rw_patterns(items, old, new)), pat)
  when PatternKind::Array(items) then
    edit_mk_pattern(PatternKind::Array(edit_rw_patterns(items, old, new)), pat)
  when PatternKind::Struct(path, fields) then
    edit_mk_pattern(PatternKind::Struct(
      edit_rename_path(path, old.clone(), new.clone()),
      edit_rw_pattern_pairs(fields, old, new)), pat)
  when PatternKind::Variant(path, items) then
    edit_mk_pattern(PatternKind::Variant(
      edit_rename_path(path, old.clone(), new.clone()),
      edit_rw_patterns(items, old, new)), pat)
  when PatternKind::Or(items) then
    edit_mk_pattern(PatternKind::Or(edit_rw_patterns(items, old, new)), pat)
  when PatternKind::Range(lo, hi, inclusive) then
    edit_mk_pattern(PatternKind::Range(
      edit_rw_expr_opt(lo, old.clone(), new.clone()),
      edit_rw_expr_opt(hi, old, new), inclusive), pat)
  end
end

def edit_rename_block(block: Block, old: String, new: String) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    stmts.push(edit_rename_stmt(block.stmts[i], old.clone(), new.clone()))
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

def edit_rename_guard_else(action: GuardElse, old: String, new: String) -> GuardElse
  match action
  when GuardElse::Return(v) then GuardElse::Return(edit_rw_expr_opt(v, old, new))
  when GuardElse::Panic(msg) then GuardElse::Panic(msg.clone())
  when GuardElse::Break(v) then GuardElse::Break(edit_rw_expr_opt(v, old, new))
  when GuardElse::Continue then GuardElse::Continue
  end
end

def edit_rename_if(if_stmt: IfStmt, old: String, new: String) -> IfStmt
  var elsifs: Vec[(Expr, Block)] = Vec::new()
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    elsifs.push((
      edit_rename_expr(if_stmt.elsif_branches[i].0, old.clone(), new.clone()),
      edit_rename_block(if_stmt.elsif_branches[i].1, old.clone(), new.clone())
    ))
    i = i + 1
  end
  var else_block: Option[Block] = Option::None
  match if_stmt.else_block
  when Option::Some(b) then else_block = Option::Some(edit_rename_block(b, old.clone(), new.clone()))
  when Option::None then ()
  end
  IfStmt {
    cond: edit_rename_expr(if_stmt.cond, old.clone(), new.clone()),
    then_block: edit_rename_block(if_stmt.then_block, old.clone(), new.clone()),
    elsif_branches: elsifs,
    else_block: else_block,
    span: if_stmt.span.clone()
  }
end

def edit_rename_match(m: MatchExpr, old: String, new: String) -> MatchExpr
  var arms: Vec[MatchArm] = Vec::new()
  var i = 0
  while i < m.arms.len() do
    arms.push(MatchArm {
      pattern: edit_rename_pattern(m.arms[i].pattern, old.clone(), new.clone()),
      guard_expr: edit_rw_expr_opt(m.arms[i].guard_expr, old.clone(), new.clone()),
      body: edit_rename_block(m.arms[i].body, old.clone(), new.clone()),
      span: m.arms[i].span.clone()
    })
    i = i + 1
  end
  MatchExpr {
    scrutinee: edit_rename_expr(m.scrutinee, old.clone(), new.clone()),
    arms: arms,
    span: m.span.clone()
  }
end

def edit_rename_stmt(stmt: Stmt, old: String, new: String) -> Stmt
  match stmt.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    edit_mk_stmt(StmtKind::StmtLet(
      edit_rename_pattern(pat, old.clone(), new.clone()),
      edit_rw_type_opt(ty, old.clone(), new.clone()),
      edit_rename_expr(value, old, new), is_mut), stmt)
  when StmtKind::StmtAssign(target, value) then
    edit_mk_stmt(StmtKind::StmtAssign(
      edit_rename_expr(target, old.clone(), new.clone()),
      edit_rename_expr(value, old, new)), stmt)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    edit_mk_stmt(StmtKind::StmtCompoundAssign(op,
      edit_rename_expr(target, old.clone(), new.clone()),
      edit_rename_expr(value, old, new)), stmt)
  when StmtKind::StmtIf(if_stmt) then
    edit_mk_stmt(StmtKind::StmtIf(edit_rename_if(if_stmt, old, new)), stmt)
  when StmtKind::StmtMatch(m) then
    edit_mk_stmt(StmtKind::StmtMatch(edit_rename_match(m, old, new)), stmt)
  when StmtKind::StmtWhile(cond, body) then
    edit_mk_stmt(StmtKind::StmtWhile(
      edit_rename_expr(cond, old.clone(), new.clone()),
      edit_rename_block(body, old, new)), stmt)
  when StmtKind::StmtFor(for_stmt) then
    edit_mk_stmt(StmtKind::StmtFor(ForStmt {
      pattern: edit_rename_pattern(for_stmt.pattern, old.clone(), new.clone()),
      iter: edit_rename_expr(for_stmt.iter, old.clone(), new.clone()),
      body: edit_rename_block(for_stmt.body, old.clone(), new.clone()),
      span: for_stmt.span.clone()
    }), stmt)
  when StmtKind::StmtLoop(body) then
    edit_mk_stmt(StmtKind::StmtLoop(edit_rename_block(body, old, new)), stmt)
  when StmtKind::StmtReturn(v) then
    edit_mk_stmt(StmtKind::StmtReturn(edit_rw_expr_opt(v, old, new)), stmt)
  when StmtKind::StmtBreak(v) then
    edit_mk_stmt(StmtKind::StmtBreak(edit_rw_expr_opt(v, old, new)), stmt)
  when StmtKind::StmtContinue then stmt.clone()
  when StmtKind::StmtExpr(e) then
    edit_mk_stmt(StmtKind::StmtExpr(edit_rename_expr(e, old, new)), stmt)
  when StmtKind::StmtUnsafe(reason, body) then
    edit_mk_stmt(StmtKind::StmtUnsafe(reason, edit_rename_block(body, old, new)), stmt)
  when StmtKind::StmtDefer(body) then
    edit_mk_stmt(StmtKind::StmtDefer(edit_rename_block(body, old, new)), stmt)
  when StmtKind::StmtGuard(cond, action) then
    edit_mk_stmt(StmtKind::StmtGuard(
      edit_rename_expr(cond, old.clone(), new.clone()),
      edit_rename_guard_else(action, old, new)), stmt)
  when StmtKind::StmtTry(body, catches, finally_block) then
    var cs: Vec[CatchArm] = Vec::new()
    var i = 0
    while i < catches.len() do
      cs.push(CatchArm {
        pattern: edit_rename_pattern(catches[i].pattern, old.clone(), new.clone()),
        body: edit_rename_block(catches[i].body, old.clone(), new.clone()),
        span: catches[i].span.clone()
      })
      i = i + 1
    end
    var fb: Option[Block] = Option::None
    match finally_block
    when Option::Some(b) then fb = Option::Some(edit_rename_block(b, old.clone(), new.clone()))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtTry(
      edit_rename_block(body, old.clone(), new.clone()), cs, fb), stmt)
  when StmtKind::StmtWith(e, pat, body) then
    edit_mk_stmt(StmtKind::StmtWith(
      edit_rename_expr(e, old.clone(), new.clone()),
      edit_rename_pattern(pat, old.clone(), new.clone()),
      edit_rename_block(body, old, new)), stmt)
  when StmtKind::StmtHandleWith(e, handlers) then
    var hs: Vec[EffectHandler] = Vec::new()
    var i2 = 0
    while i2 < handlers.len() do
      var arms: Vec[HandlerArm] = Vec::new()
      var j = 0
      while j < handlers[i2].arms.len() do
        arms.push(HandlerArm {
          operation: handlers[i2].arms[j].operation.clone(),
          params: edit_rw_patterns(handlers[i2].arms[j].params, old.clone(), new.clone()),
          body: edit_rename_block(handlers[i2].arms[j].body, old.clone(), new.clone()),
          span: handlers[i2].arms[j].span.clone()
        })
        j = j + 1
      end
      hs.push(EffectHandler {
        effect_name: if handlers[i2].effect_name == old then new.clone() else handlers[i2].effect_name.clone() end,
        arms: arms,
        span: handlers[i2].span.clone()
      })
      i2 = i2 + 1
    end
    edit_mk_stmt(StmtKind::StmtHandleWith(
      edit_rename_expr(e, old.clone(), new.clone()), hs), stmt)
  end
end

# ———————————————————————————————————————————————————————————————
# Function / item reference rewriting
# ———————————————————————————————————————————————————————————————

def edit_rename_generic_params(gps: Vec[GenericParam], old: String, new: String) -> Vec[GenericParam]
  var out: Vec[GenericParam] = Vec::new()
  var i = 0
  while i < gps.len() do
    let gp = gps[i]
    let kind = match gp.kind
    when GenericParamKind::ConstParam(te) then
      GenericParamKind::ConstParam(edit_rename_type(te, old.clone(), new.clone()))
    when _ then gp.kind.clone()
    end
    out.push(GenericParam {
      name: gp.name.clone(),
      kind: kind,
      bounds: edit_rw_types(gp.bounds, old.clone(), new.clone()),
      default: edit_rw_type_opt(gp.default, old.clone(), new.clone()),
      const_range: gp.const_range.clone(),
      span: gp.span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_params(params: Vec[Param], old: String, new: String) -> Vec[Param]
  var out: Vec[Param] = Vec::new()
  var i = 0
  while i < params.len() do
    out.push(Param {
      convention: params[i].convention,
      name: params[i].name.clone(),
      ty: edit_rw_type_opt(params[i].ty, old.clone(), new.clone()),
      default: edit_rw_expr_opt(params[i].default, old.clone(), new.clone()),
      span: params[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_where(wc: Vec[WherePredicate], old: String, new: String) -> Vec[WherePredicate]
  var out: Vec[WherePredicate] = Vec::new()
  var i = 0
  while i < wc.len() do
    out.push(WherePredicate {
      ty: edit_rename_type(wc[i].ty, old.clone(), new.clone()),
      bounds: edit_rw_types(wc[i].bounds, old.clone(), new.clone()),
      span: wc[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_contracts(contracts: Vec[ContractClause], old: String, new: String) -> Vec[ContractClause]
  var out: Vec[ContractClause] = Vec::new()
  var i = 0
  while i < contracts.len() do
    out.push(ContractClause {
      kind: contracts[i].kind,
      expr: edit_rename_expr(contracts[i].expr, old.clone(), new.clone()),
      message: contracts[i].message.clone(),
      span: contracts[i].span.clone()
    })
    i = i + 1
  end
  out
end

def edit_rename_fnbody(body: FnBody, old: String, new: String) -> FnBody
  match body
  when FnBody::FnBlock(b) then FnBody::FnBlock(edit_rename_block(b, old, new))
  when FnBody::FnExpr(e) then FnBody::FnExpr(edit_rename_expr(e, old, new))
  when FnBody::FnExtern(name) then FnBody::FnExtern(name.clone())
  when FnBody::FnNone then FnBody::FnNone
  end
end

# A function's references (body / contracts / parameter defaults / generic
# bounds), preserving its declared name.
def edit_rename_function_refs(f: FunctionDecl, old: String, new: String) -> FunctionDecl
  FunctionDecl {
    vis: f.vis,
    name: f.name.clone(),
    generic_params: edit_rename_generic_params(f.generic_params, old.clone(), new.clone()),
    params: edit_rename_params(f.params, old.clone(), new.clone()),
    ret_type: edit_rw_type_opt(f.ret_type, old.clone(), new.clone()),
    where_clause: edit_rename_where(f.where_clause, old.clone(), new.clone()),
    body: edit_rename_fnbody(f.body, old.clone(), new.clone()),
    is_async: f.is_async,
    is_unsafe: f.is_unsafe,
    is_const: f.is_const,
    is_inline: f.is_inline,
    is_pure: f.is_pure,
    contracts: edit_rename_contracts(f.contracts, old.clone(), new.clone()),
    budget_val: f.budget_val.clone(),
    required_caps: f.required_caps.clone(),
    effects: edit_rw_strings(f.effects, old, new),
    span: f.span.clone()
  }
end

def edit_rename_item_refs(item: Item, old: String, new: String) -> Item
  let kind = match item.kind
  when ItemKind::ItemFunction(f) then
    ItemKind::ItemFunction(edit_rename_function_refs(f, old.clone(), new.clone()))
  when ItemKind::ItemStruct(s) then
    var fields: Vec[FieldDecl] = Vec::new()
    var i = 0
    while i < s.fields.len() do
      fields.push(FieldDecl {
        vis: s.fields[i].vis,
        name: s.fields[i].name.clone(),
        ty: edit_rename_type(s.fields[i].ty, old.clone(), new.clone()),
        default: edit_rw_expr_opt(s.fields[i].default, old.clone(), new.clone()),
        span: s.fields[i].span.clone()
      })
      i = i + 1
    end
    var methods: Vec[FunctionDecl] = Vec::new()
    var j = 0
    while j < s.methods.len() do
      methods.push(edit_rename_function_refs(s.methods[j], old.clone(), new.clone()))
      j = j + 1
    end
    ItemKind::ItemStruct(StructDecl {
      vis: s.vis, name: s.name.clone(),
      generic_params: edit_rename_generic_params(s.generic_params, old.clone(), new.clone()),
      fields: fields, methods: methods, derives: s.derives.clone(),
      kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
    })
  when ItemKind::ItemEnum(e) then
    var variants: Vec[VariantDecl] = Vec::new()
    var i2 = 0
    while i2 < e.variants.len() do
      let v = e.variants[i2]
      var field_names: Vec[Option[String]] = Vec::new()
      for fname in v.field_names do
        field_names.push(fname.clone())
      end
      variants.push(VariantDecl {
        name: v.name.clone(),
        fields: edit_rw_types(v.fields, old.clone(), new.clone()),
        field_names: field_names,
        discriminant: edit_rw_expr_opt(v.discriminant, old.clone(), new.clone()),
        span: v.span.clone()
      })
      i2 = i2 + 1
    end
    ItemKind::ItemEnum(EnumDecl {
      vis: e.vis, name: e.name.clone(),
      generic_params: edit_rename_generic_params(e.generic_params, old.clone(), new.clone()),
      variants: variants, derives: e.derives.clone(),
      layout_attrs: e.layout_attrs.clone(), span: e.span.clone()
    })
  when ItemKind::ItemTrait(t) then
    var methods2: Vec[TraitMethod] = Vec::new()
    var k = 0
    while k < t.methods.len() do
      let tm = t.methods[k]
      methods2.push(TraitMethod {
        sig: FunctionSig {
          name: tm.sig.name.clone(),
          generic_params: edit_rename_generic_params(tm.sig.generic_params, old.clone(), new.clone()),
          params: edit_rename_params(tm.sig.params, old.clone(), new.clone()),
          ret_type: edit_rw_type_opt(tm.sig.ret_type, old.clone(), new.clone()),
          span: tm.sig.span.clone()
        },
        default_body: edit_rename_fnbody(tm.default_body, old.clone(), new.clone()),
        span: tm.span.clone()
      })
      k = k + 1
    end
    var assoc: Vec[AssocType] = Vec::new()
    var a = 0
    while a < t.assoc_types.len() do
      assoc.push(AssocType {
        name: t.assoc_types[a].name.clone(),
        bounds: edit_rw_types(t.assoc_types[a].bounds, old.clone(), new.clone()),
        default: edit_rw_type_opt(t.assoc_types[a].default, old.clone(), new.clone()),
        span: t.assoc_types[a].span.clone()
      })
      a = a + 1
    end
    ItemKind::ItemTrait(TraitDecl {
      vis: t.vis, name: t.name.clone(),
      generic_params: edit_rename_generic_params(t.generic_params, old.clone(), new.clone()),
      super_traits: edit_rw_types(t.super_traits, old.clone(), new.clone()),
      methods: methods2, assoc_types: assoc, span: t.span.clone()
    })
  when ItemKind::ItemImpl(im) then
    var impl_methods: Vec[FunctionDecl] = Vec::new()
    var imi = 0
    while imi < im.methods.len() do
      impl_methods.push(edit_rename_function_refs(im.methods[imi], old.clone(), new.clone()))
      imi = imi + 1
    end
    var impl_assoc: Vec[AssocTypeImpl] = Vec::new()
    var ai = 0
    while ai < im.assoc_types.len() do
      impl_assoc.push(AssocTypeImpl {
        name: im.assoc_types[ai].name.clone(),
        ty: edit_rename_type(im.assoc_types[ai].ty, old.clone(), new.clone()),
        span: im.assoc_types[ai].span.clone()
      })
      ai = ai + 1
    end
    ItemKind::ItemImpl(ImplDecl {
      vis: im.vis,
      generic_params: edit_rename_generic_params(im.generic_params, old.clone(), new.clone()),
      trait_name: edit_rw_string_opt(im.trait_name, old.clone(), new.clone()),
      trait_type_args: edit_rw_types(im.trait_type_args, old.clone(), new.clone()),
      for_type: edit_rename_type(im.for_type, old.clone(), new.clone()),
      self_type: edit_rename_type(im.self_type, old.clone(), new.clone()),
      where_clause: edit_rename_where(im.where_clause, old.clone(), new.clone()),
      methods: impl_methods, assoc_types: impl_assoc, span: im.span.clone()
    })
  when ItemKind::ItemModule(m) then
    ItemKind::ItemModule(ModuleDecl {
      vis: m.vis, name: m.name.clone(),
      items: edit_rename_items_refs(m.items, old.clone(), new.clone()),
      is_inline: m.is_inline, span: m.span.clone()
    })
  when ItemKind::ItemUse(u) then
    var names: Option[Vec[String]] = Option::None
    match u.names
    when Option::Some(ns) then names = Option::Some(edit_rw_strings(ns, old.clone(), new.clone()))
    when Option::None then ()
    end
    ItemKind::ItemUse(UseDecl {
      vis: u.vis, path: edit_rename_path(u.path, old.clone(), new.clone()),
      alias_name: u.alias_name.clone(), names: names, glob: u.glob, span: u.span.clone()
    })
  when ItemKind::ItemMacro(m) then
    ItemKind::ItemMacro(MacroDecl {
      vis: m.vis, name: m.name.clone(),
      params: edit_rename_params(m.params, old.clone(), new.clone()),
      body: edit_rename_block(m.body, old.clone(), new.clone()), span: m.span.clone()
    })
  when ItemKind::ItemTypeAlias(ta) then
    ItemKind::ItemTypeAlias(TypeAliasDecl {
      vis: ta.vis, name: ta.name.clone(),
      generic_params: edit_rename_generic_params(ta.generic_params, old.clone(), new.clone()),
      ty: edit_rename_type(ta.ty, old.clone(), new.clone()), span: ta.span.clone()
    })
  when ItemKind::ItemConst(c) then
    ItemKind::ItemConst(ConstDecl {
      vis: c.vis, name: c.name.clone(),
      ty: edit_rw_type_opt(c.ty, old.clone(), new.clone()),
      value: edit_rename_expr(c.value, old.clone(), new.clone()), span: c.span.clone()
    })
  when ItemKind::ItemStatic(s) then
    ItemKind::ItemStatic(StaticDecl {
      vis: s.vis, name: s.name.clone(),
      ty: edit_rename_type(s.ty, old.clone(), new.clone()),
      value: edit_rename_expr(s.value, old.clone(), new.clone()),
      is_mut: s.is_mut, span: s.span.clone()
    })
  when ItemKind::ItemCapabilityDecl(c) then
    ItemKind::ItemCapabilityDecl(CapabilityDecl {
      vis: c.vis, name: c.name.clone(),
      parent: edit_rw_string_opt(c.parent, old.clone(), new.clone()),
      permissions: c.permissions.clone(), span: c.span.clone()
    })
  when ItemKind::ItemEffectDecl(e) then
    var ops: Vec[EffectOpSig] = Vec::new()
    var oi = 0
    while oi < e.ops.len() do
      var op_params: Vec[EffectOpParamSig] = Vec::new()
      var pi = 0
      while pi < e.ops[oi].params.len() do
        op_params.push(EffectOpParamSig {
          name: e.ops[oi].params[pi].name.clone(),
          ty: edit_rename_type(e.ops[oi].params[pi].ty, old.clone(), new.clone())
        })
        pi = pi + 1
      end
      ops.push(EffectOpSig {
        name: e.ops[oi].name.clone(), params: op_params,
        ret: edit_rw_type_opt(e.ops[oi].ret, old.clone(), new.clone()),
        span: e.ops[oi].span.clone()
      })
      oi = oi + 1
    end
    ItemKind::ItemEffectDecl(EffectDecl {
      vis: e.vis, name: e.name.clone(),
      parent: edit_rw_string_opt(e.parent, old.clone(), new.clone()),
      ops: ops, span: e.span.clone()
    })
  when ItemKind::ItemExternBlock(ext) then
    var ext_items: Vec[ExternItem] = Vec::new()
    var ei = 0
    while ei < ext.items.len() do
      match ext.items[ei]
      when ExternItem::Function(ef) then
        ext_items.push(ExternItem::Function(ExternFn {
          name: ef.name.clone(),
          generic_params: edit_rename_generic_params(ef.generic_params, old.clone(), new.clone()),
          params: edit_rename_params(ef.params, old.clone(), new.clone()),
          variadic: ef.variadic,
          ret_type: edit_rw_type_opt(ef.ret_type, old.clone(), new.clone()),
          span: ef.span.clone()
        }))
      when ExternItem::Static(es) then
        ext_items.push(ExternItem::Static(ExternStatic {
          name: es.name.clone(),
          ty: edit_rename_type(es.ty, old.clone(), new.clone()),
          is_mut: es.is_mut, span: es.span.clone()
        }))
      end
      ei = ei + 1
    end
    ItemKind::ItemExternBlock(ExternBlock {
      abi: ext.abi.clone(), items: ext_items, span: ext.span.clone()
    })
  when ItemKind::ItemRationaleBlock(r) then
    ItemKind::ItemRationaleBlock(RationaleBlock {
      title: r.title.clone(), body: r.body.clone(),
      author: r.author.clone(), tags: r.tags.clone(), span: r.span.clone()
    })
  when ItemKind::ItemEditionDecl(ed) then
    ItemKind::ItemEditionDecl(EditionDecl { version: ed.version.clone(), span: ed.span.clone() })
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

def edit_rename_items_refs(items: Vec[Item], old: String, new: String) -> Vec[Item]
  var out: Vec[Item] = Vec::new()
  var i = 0
  while i < items.len() do
    out.push(edit_rename_item_refs(items[i], old.clone(), new.clone()))
    i = i + 1
  end
  out
end

def edit_rename_item_name(item: Item, new_name: String) -> Item
  let kind = match item.kind
  when ItemKind::ItemFunction(f) then
    var f2 = f
    f2.name = new_name.clone()
    ItemKind::ItemFunction(f2)
  when ItemKind::ItemStruct(s) then
    var s2 = s
    s2.name = new_name.clone()
    ItemKind::ItemStruct(s2)
  when ItemKind::ItemEnum(e) then
    var e2 = e
    e2.name = new_name.clone()
    ItemKind::ItemEnum(e2)
  when ItemKind::ItemTrait(t) then
    var t2 = t
    t2.name = new_name.clone()
    ItemKind::ItemTrait(t2)
  when ItemKind::ItemModule(m) then
    var m2 = m
    m2.name = new_name.clone()
    ItemKind::ItemModule(m2)
  when ItemKind::ItemTypeAlias(ta) then
    var ta2 = ta
    ta2.name = new_name.clone()
    ItemKind::ItemTypeAlias(ta2)
  when ItemKind::ItemConst(c) then
    var c2 = c
    c2.name = new_name.clone()
    ItemKind::ItemConst(c2)
  when ItemKind::ItemStatic(s) then
    var s3 = s
    s3.name = new_name.clone()
    ItemKind::ItemStatic(s3)
  when ItemKind::ItemMacro(m) then
    var m3 = m
    m3.name = new_name.clone()
    ItemKind::ItemMacro(m3)
  when ItemKind::ItemCapabilityDecl(c) then
    var c3 = c
    c3.name = new_name.clone()
    ItemKind::ItemCapabilityDecl(c3)
  when ItemKind::ItemEffectDecl(e) then
    var e3 = e
    e3.name = new_name.clone()
    ItemKind::ItemEffectDecl(e3)
  when _ then item.kind.clone()
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

def edit_replace_function(vec: Vec[FunctionDecl], idx: Int, val: FunctionDecl) -> Vec[FunctionDecl]
  var out: Vec[FunctionDecl] = Vec::new()
  var i = 0
  while i < vec.len() do
    if i == idx then out.push(val.clone()) else out.push(vec[i].clone()) end
    i = i + 1
  end
  out
end

def edit_rename_method_at(item: Item, m_index: Int, new_name: String) -> Item
  let kind = match item.kind
  when ItemKind::ItemStruct(s) then
    var methods = s.methods.clone()
    var meth = methods[m_index]
    meth.name = new_name.clone()
    methods = edit_replace_function(methods, m_index, meth)
    ItemKind::ItemStruct(StructDecl {
      vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
      fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
      kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
    })
  when ItemKind::ItemImpl(im) then
    var methods2 = im.methods.clone()
    var meth2 = methods2[m_index]
    meth2.name = new_name.clone()
    methods2 = edit_replace_function(methods2, m_index, meth2)
    ItemKind::ItemImpl(ImplDecl {
      vis: im.vis, generic_params: im.generic_params.clone(),
      trait_name: im.trait_name.clone(), trait_type_args: im.trait_type_args.clone(),
      for_type: im.for_type.clone(), self_type: im.self_type.clone(),
      where_clause: im.where_clause.clone(), methods: methods2,
      assoc_types: im.assoc_types.clone(), span: im.span.clone()
    })
  when _ then item.kind.clone()
  end
  Item {
    kind: kind,
    attrs: item.attrs.clone(),
    span: item.span.clone(),
    is_pub: item.is_pub,
    owner_module: item.owner_module
  }
end

# The whole-program rename: every item's references are rewritten, then the
# located declaration (top-level item or method) is renamed.
def edit_rename_program(program: Program, site: EditItemSite, old: String, new: String) -> Program
  var new_items: Vec[Item] = Vec::new()
  var i = 0
  while i < program.items.len() do
    var it = edit_rename_item_refs(program.items[i], old.clone(), new.clone())
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then it = edit_rename_item_name(it, new.clone()) end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then it = edit_rename_method_at(it, mi, new.clone()) end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then it = edit_rename_method_at(it, mi, new.clone()) end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(it)
    i = i + 1
  end
  Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }
end

# ———————————————————————————————————————————————————————————————
# ReplaceCall rewriting (direct call sites in the caller body)
# ———————————————————————————————————————————————————————————————

def edit_new_callee(like: Expr, new_name: String, new_segs: Vec[String]) -> Expr
  if new_segs.len() <= 1 then
    Expr { kind: ExprKind::ExprIdent(new_name.clone()), span: like.span.clone(), node_id: 0 }
  else
    var segs: Vec[String] = Vec::new()
    for s in new_segs do
      segs.push(s.clone())
    end
    Expr {
      kind: ExprKind::ExprPath(AstPath { segments: segs, span: like.span.clone() }),
      span: like.span.clone(),
      node_id: 0
    }
  end
end

def edit_replace_callee(
  callee: Expr, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Expr
  match callee.kind
  when ExprKind::ExprIdent(name) then
    if name == old then
      count = count + 1
      edit_new_callee(callee, new_name, new_segs)
    else
      callee.clone()
    end
  when ExprKind::ExprPath(path) then
    if path.segments.len() > 0 && path.segments[path.segments.len() - 1] == old then
      count = count + 1
      edit_new_callee(callee, new_name, new_segs)
    else
      callee.clone()
    end
  when _ then
    edit_replace_calls_expr(callee, old, new_name, new_segs, count)
  end
end

def edit_replace_calls_exprs(
  exprs: Vec[Expr], old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Vec[Expr]
  var out: Vec[Expr] = Vec::new()
  var i = 0
  while i < exprs.len() do
    out.push(edit_replace_calls_expr(exprs[i], old.clone(), new_name.clone(), new_segs.clone(), count))
    i = i + 1
  end
  out
end

def edit_replace_calls_expr(
  expr: Expr, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Expr
  match expr.kind
  when ExprKind::ExprIntLit(_) then expr.clone()
  when ExprKind::ExprFloatLit(_) then expr.clone()
  when ExprKind::ExprStringLit(_) then expr.clone()
  when ExprKind::ExprCharLit(_) then expr.clone()
  when ExprKind::ExprBoolLit(_) then expr.clone()
  when ExprKind::ExprNilLit then expr.clone()
  when ExprKind::ExprIdent(_) then expr.clone()
  when ExprKind::ExprSelfRef then expr.clone()
  when ExprKind::ExprHole then expr.clone()
  when ExprKind::ExprError(_) then expr.clone()
  when ExprKind::ExprPath(_) then expr.clone()
  when ExprKind::ExprArrayLit(elems) then
    edit_mk_expr(ExprKind::ExprArrayLit(
      edit_replace_calls_exprs(elems, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprArrayRepeat(elem, n) then
    edit_mk_expr(ExprKind::ExprArrayRepeat(
      Box::new(edit_replace_calls_expr(elem, old.clone(), new_name.clone(), new_segs.clone(), count)),
      Box::new(edit_replace_calls_expr(n, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprTupleLit(elems) then
    edit_mk_expr(ExprKind::ExprTupleLit(
      edit_replace_calls_exprs(elems, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields: Vec[(String, Expr)] = Vec::new()
    var fi = 0
    while fi < fields.len() do
      new_fields.push((fields[fi].0.clone(),
        edit_replace_calls_expr(fields[fi].1, old.clone(), new_name.clone(), new_segs.clone(), count)))
      fi = fi + 1
    end
    edit_mk_expr(ExprKind::ExprStructLit(path, new_fields), expr)
  when ExprKind::ExprMapLit(entries) then
    var new_entries: Vec[(Expr, Expr)] = Vec::new()
    var mi = 0
    while mi < entries.len() do
      new_entries.push((
        edit_replace_calls_expr(entries[mi].0, old.clone(), new_name.clone(), new_segs.clone(), count),
        edit_replace_calls_expr(entries[mi].1, old.clone(), new_name.clone(), new_segs.clone(), count)
      ))
      mi = mi + 1
    end
    edit_mk_expr(ExprKind::ExprMapLit(new_entries), expr)
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    edit_mk_expr(ExprKind::ExprBinaryOp(op,
      Box::new(edit_replace_calls_expr(lhs, old.clone(), new_name.clone(), new_segs.clone(), count)),
      Box::new(edit_replace_calls_expr(rhs, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprUnaryOp(op, operand) then
    edit_mk_expr(ExprKind::ExprUnaryOp(op,
      Box::new(edit_replace_calls_expr(operand, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprFieldAccess(base, field) then
    edit_mk_expr(ExprKind::ExprFieldAccess(
      Box::new(edit_replace_calls_expr(base, old, new_name, new_segs, count)), field), expr)
  when ExprKind::ExprMethodCall(recv, name, targs, args) then
    var nn = name.clone()
    if name == old then
      count = count + 1
      nn = new_name.clone()
    end
    edit_mk_expr(ExprKind::ExprMethodCall(
      Box::new(edit_replace_calls_expr(recv, old.clone(), new_name.clone(), new_segs.clone(), count)),
      nn, targs,
      edit_replace_calls_exprs(args, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprIndex(base, index) then
    edit_mk_expr(ExprKind::ExprIndex(
      Box::new(edit_replace_calls_expr(base, old.clone(), new_name.clone(), new_segs.clone(), count)),
      Box::new(edit_replace_calls_expr(index, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprCall(callee, args) then
    let nc = edit_replace_callee(callee, old.clone(), new_name.clone(), new_segs.clone(), count)
    edit_mk_expr(ExprKind::ExprCall(
      Box::new(nc), edit_replace_calls_exprs(args, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprClosure(params, ret, body) then
    var ps: Vec[ClosureParam] = Vec::new()
    var pi = 0
    while pi < params.len() do
      ps.push(ClosureParam {
        pat: edit_replace_calls_pattern(params[pi].pat, old.clone(), new_name.clone(), new_segs.clone(), count),
        ty: params[pi].ty.clone(),
        span: params[pi].span.clone()
      })
      pi = pi + 1
    end
    edit_mk_expr(ExprKind::ExprClosure(
      ps, ret, Box::new(edit_replace_calls_expr(body, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprAccess(inner) then
    edit_mk_expr(ExprKind::ExprAccess(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprRawDeref(inner) then
    edit_mk_expr(ExprKind::ExprRawDeref(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprIf(if_stmt) then
    edit_mk_expr(ExprKind::ExprIf(
      edit_replace_calls_if(if_stmt, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprMatch(m) then
    edit_mk_expr(ExprKind::ExprMatch(
      edit_replace_calls_match(m, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprBlock(block) then
    edit_mk_expr(ExprKind::ExprBlock(
      edit_replace_calls_block(block, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprUnsafe(reason, block) then
    edit_mk_expr(ExprKind::ExprUnsafe(reason,
      edit_replace_calls_block(block, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprAsync(block) then
    edit_mk_expr(ExprKind::ExprAsync(
      edit_replace_calls_block(block, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprAwait(inner) then
    edit_mk_expr(ExprKind::ExprAwait(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprTry(inner) then
    edit_mk_expr(ExprKind::ExprTry(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprRange(start, stop, inclusive) then
    var ns: Option[Box[Expr]] = Option::None
    var ne: Option[Box[Expr]] = Option::None
    match start
    when Option::Some(s) then
      ns = Option::Some(Box::new(edit_replace_calls_expr(s, old.clone(), new_name.clone(), new_segs.clone(), count)))
    when Option::None then ()
    end
    match stop
    when Option::Some(e) then
      ne = Option::Some(Box::new(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count)))
    when Option::None then ()
    end
    edit_mk_expr(ExprKind::ExprRange(ns, ne, inclusive), expr)
  when ExprKind::ExprCast(inner, ty) then
    edit_mk_expr(ExprKind::ExprCast(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count)), ty), expr)
  when ExprKind::ExprTypeCheck(inner, ty) then
    edit_mk_expr(ExprKind::ExprTypeCheck(Box::new(
      edit_replace_calls_expr(inner, old, new_name, new_segs, count)), ty), expr)
  when ExprKind::ExprComptime(block) then
    edit_mk_expr(ExprKind::ExprComptime(
      edit_replace_calls_block(block, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprEnumVariant(path, targs, args) then
    edit_mk_expr(ExprKind::ExprEnumVariant(
      path, targs, edit_replace_calls_exprs(args, old, new_name, new_segs, count)), expr)
  when ExprKind::ExprAssign(target, value) then
    edit_mk_expr(ExprKind::ExprAssign(
      Box::new(edit_replace_calls_expr(target, old.clone(), new_name.clone(), new_segs.clone(), count)),
      Box::new(edit_replace_calls_expr(value, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprPipe(lhs, rhs) then
    edit_mk_expr(ExprKind::ExprPipe(
      Box::new(edit_replace_calls_expr(lhs, old.clone(), new_name.clone(), new_segs.clone(), count)),
      Box::new(edit_replace_calls_expr(rhs, old, new_name, new_segs, count))), expr)
  when ExprKind::ExprMacroCall(name, args) then
    edit_mk_expr(ExprKind::ExprMacroCall(name,
      edit_replace_calls_exprs(args, old, new_name, new_segs, count)), expr)
  end
end

def edit_replace_calls_pattern(
  pat: Pattern, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Pattern
  match pat.kind
  when PatternKind::Literal(e) then
    edit_mk_pattern(PatternKind::Literal(
      edit_replace_calls_expr(e, old, new_name, new_segs, count)), pat)
  when PatternKind::Tuple(items) then
    var out: Vec[Pattern] = Vec::new()
    var i = 0
    while i < items.len() do
      out.push(edit_replace_calls_pattern(items[i], old.clone(), new_name.clone(), new_segs.clone(), count))
      i = i + 1
    end
    edit_mk_pattern(PatternKind::Tuple(out), pat)
  when PatternKind::Array(items) then
    var out2: Vec[Pattern] = Vec::new()
    var j = 0
    while j < items.len() do
      out2.push(edit_replace_calls_pattern(items[j], old.clone(), new_name.clone(), new_segs.clone(), count))
      j = j + 1
    end
    edit_mk_pattern(PatternKind::Array(out2), pat)
  when PatternKind::Struct(path, fields) then
    var out3: Vec[(String, Pattern)] = Vec::new()
    var k = 0
    while k < fields.len() do
      out3.push((fields[k].0.clone(),
        edit_replace_calls_pattern(fields[k].1, old.clone(), new_name.clone(), new_segs.clone(), count)))
      k = k + 1
    end
    edit_mk_pattern(PatternKind::Struct(path, out3), pat)
  when PatternKind::Variant(path, items) then
    var out4: Vec[Pattern] = Vec::new()
    var l = 0
    while l < items.len() do
      out4.push(edit_replace_calls_pattern(items[l], old.clone(), new_name.clone(), new_segs.clone(), count))
      l = l + 1
    end
    edit_mk_pattern(PatternKind::Variant(path, out4), pat)
  when PatternKind::Or(items) then
    var out5: Vec[Pattern] = Vec::new()
    var m = 0
    while m < items.len() do
      out5.push(edit_replace_calls_pattern(items[m], old.clone(), new_name.clone(), new_segs.clone(), count))
      m = m + 1
    end
    edit_mk_pattern(PatternKind::Or(out5), pat)
  when PatternKind::Range(lo, hi, inclusive) then
    var nlo: Option[Expr] = Option::None
    var nhi: Option[Expr] = Option::None
    match lo
    when Option::Some(e) then
      nlo = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then
      nhi = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    edit_mk_pattern(PatternKind::Range(nlo, nhi, inclusive), pat)
  when _ then pat.clone()
  end
end

def edit_replace_calls_block(
  block: Block, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    stmts.push(edit_replace_calls_stmt(block.stmts[i], old.clone(), new_name.clone(), new_segs.clone(), count))
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

def edit_replace_calls_if(
  if_stmt: IfStmt, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> IfStmt
  var elsifs: Vec[(Expr, Block)] = Vec::new()
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    elsifs.push((
      edit_replace_calls_expr(if_stmt.elsif_branches[i].0, old.clone(), new_name.clone(), new_segs.clone(), count),
      edit_replace_calls_block(if_stmt.elsif_branches[i].1, old.clone(), new_name.clone(), new_segs.clone(), count)
    ))
    i = i + 1
  end
  var else_block: Option[Block] = Option::None
  match if_stmt.else_block
  when Option::Some(b) then
    else_block = Option::Some(edit_replace_calls_block(b, old.clone(), new_name.clone(), new_segs.clone(), count))
  when Option::None then ()
  end
  IfStmt {
    cond: edit_replace_calls_expr(if_stmt.cond, old.clone(), new_name.clone(), new_segs.clone(), count),
    then_block: edit_replace_calls_block(if_stmt.then_block, old.clone(), new_name.clone(), new_segs.clone(), count),
    elsif_branches: elsifs,
    else_block: else_block,
    span: if_stmt.span.clone()
  }
end

def edit_replace_calls_match(
  m: MatchExpr, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> MatchExpr
  var arms: Vec[MatchArm] = Vec::new()
  var i = 0
  while i < m.arms.len() do
    var arm_guard: Option[Expr] = Option::None
    match m.arms[i].guard_expr
    when Option::Some(g) then
      arm_guard = Option::Some(edit_replace_calls_expr(g, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    arms.push(MatchArm {
      pattern: edit_replace_calls_pattern(m.arms[i].pattern, old.clone(), new_name.clone(), new_segs.clone(), count),
      guard_expr: arm_guard,
      body: edit_replace_calls_block(m.arms[i].body, old.clone(), new_name.clone(), new_segs.clone(), count),
      span: m.arms[i].span.clone()
    })
    i = i + 1
  end
  MatchExpr {
    scrutinee: edit_replace_calls_expr(m.scrutinee, old.clone(), new_name.clone(), new_segs.clone(), count),
    arms: arms,
    span: m.span.clone()
  }
end

def edit_replace_calls_stmt(
  stmt: Stmt, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Stmt
  match stmt.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    edit_mk_stmt(StmtKind::StmtLet(pat, ty,
      edit_replace_calls_expr(value, old, new_name, new_segs, count), is_mut), stmt)
  when StmtKind::StmtAssign(target, value) then
    edit_mk_stmt(StmtKind::StmtAssign(
      edit_replace_calls_expr(target, old.clone(), new_name.clone(), new_segs.clone(), count),
      edit_replace_calls_expr(value, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    edit_mk_stmt(StmtKind::StmtCompoundAssign(op,
      edit_replace_calls_expr(target, old.clone(), new_name.clone(), new_segs.clone(), count),
      edit_replace_calls_expr(value, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtIf(if_stmt) then
    edit_mk_stmt(StmtKind::StmtIf(
      edit_replace_calls_if(if_stmt, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtMatch(m) then
    edit_mk_stmt(StmtKind::StmtMatch(
      edit_replace_calls_match(m, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtWhile(cond, body) then
    edit_mk_stmt(StmtKind::StmtWhile(
      edit_replace_calls_expr(cond, old.clone(), new_name.clone(), new_segs.clone(), count),
      edit_replace_calls_block(body, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtFor(for_stmt) then
    edit_mk_stmt(StmtKind::StmtFor(ForStmt {
      pattern: edit_replace_calls_pattern(for_stmt.pattern, old.clone(), new_name.clone(), new_segs.clone(), count),
      iter: edit_replace_calls_expr(for_stmt.iter, old.clone(), new_name.clone(), new_segs.clone(), count),
      body: edit_replace_calls_block(for_stmt.body, old, new_name, new_segs, count),
      span: for_stmt.span.clone()
    }), stmt)
  when StmtKind::StmtLoop(body) then
    edit_mk_stmt(StmtKind::StmtLoop(
      edit_replace_calls_block(body, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtReturn(v) then
    var nv: Option[Expr] = Option::None
    match v
    when Option::Some(e) then nv = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtReturn(nv), stmt)
  when StmtKind::StmtBreak(v) then
    var nv2: Option[Expr] = Option::None
    match v
    when Option::Some(e) then nv2 = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtBreak(nv2), stmt)
  when StmtKind::StmtContinue then stmt.clone()
  when StmtKind::StmtExpr(e) then
    edit_mk_stmt(StmtKind::StmtExpr(
      edit_replace_calls_expr(e, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtUnsafe(reason, body) then
    edit_mk_stmt(StmtKind::StmtUnsafe(reason,
      edit_replace_calls_block(body, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtDefer(body) then
    edit_mk_stmt(StmtKind::StmtDefer(
      edit_replace_calls_block(body, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtGuard(cond, action) then
    let new_action = match action
    when GuardElse::Return(v) then
      var nv3: Option[Expr] = Option::None
      match v
      when Option::Some(e) then nv3 = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
      when Option::None then ()
      end
      GuardElse::Return(nv3)
    when GuardElse::Break(v) then
      var nv4: Option[Expr] = Option::None
      match v
      when Option::Some(e) then nv4 = Option::Some(edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count))
      when Option::None then ()
      end
      GuardElse::Break(nv4)
    when GuardElse::Panic(msg) then GuardElse::Panic(msg.clone())
    when GuardElse::Continue then GuardElse::Continue
    end
    edit_mk_stmt(StmtKind::StmtGuard(
      edit_replace_calls_expr(cond, old, new_name, new_segs, count), new_action), stmt)
  when StmtKind::StmtTry(body, catches, finally_block) then
    var cs: Vec[CatchArm] = Vec::new()
    var i = 0
    while i < catches.len() do
      cs.push(CatchArm {
        pattern: catches[i].pattern.clone(),
        body: edit_replace_calls_block(catches[i].body, old.clone(), new_name.clone(), new_segs.clone(), count),
        span: catches[i].span.clone()
      })
      i = i + 1
    end
    var fb: Option[Block] = Option::None
    match finally_block
    when Option::Some(b) then fb = Option::Some(edit_replace_calls_block(b, old.clone(), new_name.clone(), new_segs.clone(), count))
    when Option::None then ()
    end
    edit_mk_stmt(StmtKind::StmtTry(
      edit_replace_calls_block(body, old.clone(), new_name.clone(), new_segs.clone(), count), cs, fb), stmt)
  when StmtKind::StmtWith(e, pat, body) then
    edit_mk_stmt(StmtKind::StmtWith(
      edit_replace_calls_expr(e, old.clone(), new_name.clone(), new_segs.clone(), count),
      pat,
      edit_replace_calls_block(body, old, new_name, new_segs, count)), stmt)
  when StmtKind::StmtHandleWith(e, handlers) then
    edit_mk_stmt(StmtKind::StmtHandleWith(
      edit_replace_calls_expr(e, old, new_name, new_segs, count), handlers), stmt)
  end
end

# The whole-program call replacement for the located caller function: only
# the caller's body is rewritten; the returned count is the number of
# replaced call sites.
def edit_replace_calls_in_function(
  f: FunctionDecl, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> FunctionDecl
  let body = match f.body
  when FnBody::FnBlock(b) then FnBody::FnBlock(edit_replace_calls_block(b, old, new_name, new_segs, count))
  when FnBody::FnExpr(e) then FnBody::FnExpr(edit_replace_calls_expr(e, old, new_name, new_segs, count))
  when _ then f.body.clone()
  end
  FunctionDecl {
    vis: f.vis, name: f.name.clone(), generic_params: f.generic_params.clone(),
    params: f.params.clone(), ret_type: f.ret_type.clone(), where_clause: f.where_clause.clone(),
    body: body, is_async: f.is_async, is_unsafe: f.is_unsafe, is_const: f.is_const,
    is_inline: f.is_inline, is_pure: f.is_pure, contracts: f.contracts.clone(),
    budget_val: f.budget_val.clone(), required_caps: f.required_caps.clone(),
    effects: f.effects.clone(), span: f.span.clone()
  }
end

def edit_replace_calls_program(
  program: Program, site: EditItemSite, old: String, new_name: String, new_segs: Vec[String], inout count: Int
) -> Program
  var new_items: Vec[Item] = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    var new_kind = item.kind.clone()
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then
        match item.kind
        when ItemKind::ItemFunction(f) then
          new_kind = ItemKind::ItemFunction(
            edit_replace_calls_in_function(f, old.clone(), new_name.clone(), new_segs.clone(), count))
        when _ then ()
        end
      end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemStruct(s) then
          var methods = s.methods.clone()
          methods = edit_replace_function(methods, mi,
            edit_replace_calls_in_function(s.methods[mi], old.clone(), new_name.clone(), new_segs.clone(), count))
          new_kind = ItemKind::ItemStruct(StructDecl {
            vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
            fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
            kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
          })
        when _ then ()
        end
      end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemImpl(im) then
          var methods2 = im.methods.clone()
          methods2 = edit_replace_function(methods2, mi,
            edit_replace_calls_in_function(im.methods[mi], old.clone(), new_name.clone(), new_segs.clone(), count))
          new_kind = ItemKind::ItemImpl(ImplDecl {
            vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
            trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
            self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
            methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
          })
        when _ then ()
        end
      end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(Item {
      kind: new_kind, attrs: item.attrs.clone(), span: item.span.clone(),
      is_pub: item.is_pub, owner_module: item.owner_module
    })
    i = i + 1
  end
  Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }
end

# ———————————————————————————————————————————————————————————————
# InsertStatement / ChangeSignature splices
# ———————————————————————————————————————————————————————————————

def edit_function_with_body(f: FunctionDecl, body: FnBody) -> FunctionDecl
  FunctionDecl {
    vis: f.vis, name: f.name.clone(), generic_params: f.generic_params.clone(),
    params: f.params.clone(), ret_type: f.ret_type.clone(), where_clause: f.where_clause.clone(),
    body: body, is_async: f.is_async, is_unsafe: f.is_unsafe, is_const: f.is_const,
    is_inline: f.is_inline, is_pure: f.is_pure, contracts: f.contracts.clone(),
    budget_val: f.budget_val.clone(), required_caps: f.required_caps.clone(),
    effects: f.effects.clone(), span: f.span.clone()
  }
end

# The signature splice: the replacement signature's generics / params /
# return / where clause replace the declaration's; the name changes only
# when the replacement text carried one; contracts, effects, capabilities,
# budget and body are untouched. Call sites are NOT updated (documented
# partial contract).
def edit_function_with_signature(f: FunctionDecl, sig: FunctionDecl) -> FunctionDecl
  let new_name = if sig.name == "__semantic_edit_sig__" then f.name.clone() else sig.name.clone() end
  FunctionDecl {
    vis: f.vis, name: new_name,
    generic_params: sig.generic_params.clone(), params: sig.params.clone(),
    ret_type: sig.ret_type.clone(), where_clause: sig.where_clause.clone(),
    body: f.body.clone(), is_async: f.is_async, is_unsafe: f.is_unsafe,
    is_const: f.is_const, is_inline: f.is_inline, is_pure: f.is_pure,
    contracts: f.contracts.clone(), budget_val: f.budget_val.clone(),
    required_caps: f.required_caps.clone(), effects: f.effects.clone(),
    span: f.span.clone()
  }
end

def edit_insert_into_block(block: Block, idx: Int, stmt: Stmt) -> Block
  var stmts: Vec[Stmt] = Vec::new()
  var i = 0
  while i <= block.stmts.len() do
    if i == idx then
      stmts.push(stmt.clone())
    end
    if i < block.stmts.len() then
      stmts.push(block.stmts[i].clone())
    end
    i = i + 1
  end
  Block { stmts: stmts, span: block.span.clone() }
end

# Splice `stmt` before statement `idx` of the located function's body. The
# body must be a block and `idx` must be an EXISTING statement ordinal —
# anything else reports (program, false) and the caller fails closed.
def edit_splice_insert(program: Program, site: EditItemSite, idx: Int, stmt: Stmt) -> (Program, Bool)
  var ok = false
  var new_items: Vec[Item] = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    var new_kind = item.kind.clone()
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then
        match item.kind
        when ItemKind::ItemFunction(f) then
          match f.body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              new_kind = ItemKind::ItemFunction(edit_function_with_body(f, FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemStruct(s) then
          match s.methods[mi].body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              var methods = s.methods.clone()
              methods = edit_replace_function(methods, mi,
                edit_function_with_body(s.methods[mi], FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              new_kind = ItemKind::ItemStruct(StructDecl {
                vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
                fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
                kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
              })
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemImpl(im) then
          match im.methods[mi].body
          when FnBody::FnBlock(b) then
            if idx >= 0 && idx < b.stmts.len() then
              var methods2 = im.methods.clone()
              methods2 = edit_replace_function(methods2, mi,
                edit_function_with_body(im.methods[mi], FnBody::FnBlock(edit_insert_into_block(b, idx, stmt.clone()))))
              new_kind = ItemKind::ItemImpl(ImplDecl {
                vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
                trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
                self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
                methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
              })
              ok = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(Item {
      kind: new_kind, attrs: item.attrs.clone(), span: item.span.clone(),
      is_pub: item.is_pub, owner_module: item.owner_module
    })
    i = i + 1
  end
  (Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }, ok)
end

def edit_splice_signature(program: Program, site: EditItemSite, sig: FunctionDecl) -> (Program, Bool)
  var ok = false
  var new_items: Vec<Item> = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    var new_kind = item.kind.clone()
    match site
    when EditItemSite::EditSiteTop(si) then
      if i == si then
        match item.kind
        when ItemKind::ItemFunction(f) then
          new_kind = ItemKind::ItemFunction(edit_function_with_signature(f, sig.clone()))
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteStructMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemStruct(s) then
          var methods = s.methods.clone()
          methods = edit_replace_function(methods, mi, edit_function_with_signature(s.methods[mi], sig.clone()))
          new_kind = ItemKind::ItemStruct(StructDecl {
            vis: s.vis, name: s.name.clone(), generic_params: s.generic_params.clone(),
            fields: s.fields.clone(), methods: methods, derives: s.derives.clone(),
            kind: s.kind, layout_attrs: s.layout_attrs.clone(), span: s.span.clone()
          })
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteImplMethod(si, mi) then
      if i == si then
        match item.kind
        when ItemKind::ItemImpl(im) then
          var methods2 = im.methods.clone()
          methods2 = edit_replace_function(methods2, mi, edit_function_with_signature(im.methods[mi], sig.clone()))
          new_kind = ItemKind::ItemImpl(ImplDecl {
            vis: im.vis, generic_params: im.generic_params.clone(), trait_name: im.trait_name.clone(),
            trait_type_args: im.trait_type_args.clone(), for_type: im.for_type.clone(),
            self_type: im.self_type.clone(), where_clause: im.where_clause.clone(),
            methods: methods2, assoc_types: im.assoc_types.clone(), span: im.span.clone()
          })
          ok = true
        when _ then ()
        end
      end
    when EditItemSite::EditSiteNone then ()
    end
    new_items.push(Item {
      kind: new_kind, attrs: item.attrs.clone(), span: item.span.clone(),
      is_pub: item.is_pub, owner_module: item.owner_module
    })
    i = i + 1
  end
  (Program { items: new_items, crate: program.crate.clone(), span: program.span.clone() }, ok)
end

# ———————————————————————————————————————————————————————————————
# Edit-fragment parsing (statement / signature text)
# ———————————————————————————————————————————————————————————————

# Parse one statement text by parsing it inside a synthetic function body
# and extracting the single resulting statement. Option::None for any text
# that does not parse as EXACTLY one statement.
pub def edit_parse_statement_text(text: String) -> Option[Stmt]
  let src = "def __semantic_edit_probe__()\n" + text + "\nend\n"
  let out = parse(tokenize(src, "<semantic-edit>".to_string()))
  if diag_has_errors(&out.diagnostics) then
    return Option::None
  end
  for item in out.program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      match f.body
      when FnBody::FnBlock(b) then
        if b.stmts.len() == 1 then
          return Option::Some(b.stmts[0])
        end
      when _ then ()
      end
    when _ then ()
    end
  end
  Option::None
end

# Parse one signature text ("(x: Int) -> Int" or "name[T](x: Int) -> Int")
# by parsing a synthetic function declaration and extracting it. A
# parameter-list-only text gets the synthetic name; the caller splices
# the name only when the text carried one. The synthetic body is the bare
# newline form the parser accepts for a function body (`do` is not a
# function-body separator; the canonical formatter emits the bare form).
pub def edit_parse_signature_decl(text: String) -> Option[FunctionDecl]
  let trimmed = text.trim()
  var decl_text = trimmed.clone()
  if !decl_text.starts_with("def ") then
    if decl_text.starts_with("(") then
      decl_text = "__semantic_edit_sig__" + decl_text
    end
    decl_text = "def " + decl_text
  end
  let src = decl_text + "\nend\n"
  let out = parse(tokenize(src, "<semantic-edit>".to_string()))
  if diag_has_errors(&out.diagnostics) then
    return Option::None
  end
  for item in out.program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      return Option::Some(f)
    when _ then ()
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# The transform dispatch
# ———————————————————————————————————————————————————————————————

# The transformation outcome: the edited program, or the typed error plus
# the evidence text (the reason an anchor / declaration / fragment did not
# map — carried into EditApplication.validation_detail by the pipeline).
pub struct EditTransformResult
  program: Option[Program] = Option::None
  error: Option[EditError] = Option::None
  evidence: String = ""
end

def edit_transform_ok(program: Program, evidence: String) -> EditTransformResult
  EditTransformResult { program: Option::Some(program), error: Option::None, evidence: evidence }
end

def edit_transform_fail(error: EditError, evidence: String) -> EditTransformResult
  EditTransformResult { program: Option::None, error: Option::Some(error), evidence: evidence }
end

pub def edit_transform_error(result: EditTransformResult) -> EditError
  match result.error
  when Option::Some(e) then e
  when Option::None then EditError::PreconditionFailed
  end
end

# Parse "<digits>#S<digits>" (the §33 anchor tail after the function key's
# "#B") into (block id, statement ordinal, well_formed).
def edit_parse_block_stmt(rest: String) -> (Int, Int, Bool)
  let at_s = edit_str_index(rest.clone(), "#S".to_string(), 0)
  if at_s <= 0 then
    return (0, 0, false)
  end
  let btext = rest.slice(0, at_s)
  let stext = rest.slice(at_s + 2, rest.len())
  let bi = match btext.parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return (0, 0, false)
  end
  let si = match stext.parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return (0, 0, false)
  end
  (bi, si, true)
end

def edit_transform_rename(program: Program, resolved: ResolvedEdit, new_name: String) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "rename-target-missing")
  end
  let target = resolved.targets[0].clone()
  let site = edit_locate_decl(program.clone(), target.clone())
  match site
  when EditItemSite::EditSiteNone then
    edit_transform_fail(EditError::PreconditionFailed, "declaration-not-in-source: " + target)
  when _ then
    let old = edit_site_decl_name(program.clone(), site)
    if old.len() == 0 then
      return edit_transform_fail(EditError::PreconditionFailed, "declaration-site-empty: " + target)
    end
    if old == new_name then
      return edit_transform_fail(EditError::PreconditionFailed, "rename-no-op: " + old)
    end
    edit_transform_ok(
      edit_rename_program(program, site, old.clone(), new_name.clone()),
      "rename:" + target + ":" + old + "->" + new_name
    )
  end
end

def edit_transform_replace_call(program: Program, resolved: ResolvedEdit, callee: String) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "replace-call-target-missing")
  end
  let call_key = resolved.targets[0].clone()
  let parts = edit_pipe_parts(call_key.clone())
  if parts.len() != 3 then
    return edit_transform_fail(EditError::PreconditionFailed, "call-row-key-malformed: " + call_key)
  end
  let caller_key = parts[0].clone()
  let old_callee = parts[1].clone()
  let kind_word = parts[2].clone()
  if kind_word != "0" then
    return edit_transform_fail(EditError::PreconditionFailed,
      "call-row-kind-not-direct: " + kind_word + " (only a Direct call row names a source callee)")
  end
  var new_key = callee.clone()
  if resolved.targets.len() > 1 then
    new_key = resolved.targets[1].clone()
  end
  if new_key == old_callee then
    return edit_transform_fail(EditError::PreconditionFailed, "replace-call-no-op: " + old_callee)
  end
  let site = edit_locate_function_site(program.clone(), caller_key.clone())
  match site
  when EditItemSite::EditSiteNone then
    edit_transform_fail(EditError::PreconditionFailed, "caller-not-in-source: " + caller_key)
  when _ then
    let old_name = edit_key_name_segment(old_callee.clone())
    let new_name = edit_key_name_segment(new_key.clone())
    let new_segs = edit_colon_segments(edit_name_part(&new_key))
    var count = 0
    let new_program = edit_replace_calls_program(
      program, site, old_name.clone(), new_name.clone(), new_segs, count)
    if count == 0 then
      edit_transform_fail(EditError::PreconditionFailed,
        "call-site-not-in-source: " + old_name + " caller:" + caller_key)
    else
      edit_transform_ok(new_program,
        "replace-call:" + old_name + "->" + new_name + " sites:" + count.to_string())
    end
  end
end

def edit_transform_insert(program: Program, resolved: ResolvedEdit, statement_text: String) -> EditTransformResult
  if resolved.targets.len() < 2 then
    return edit_transform_fail(EditError::PreconditionFailed, "insert-target-missing")
  end
  let fn_key = resolved.targets[0].clone()
  let before_key = resolved.targets[1].clone()
  let prefix = fn_key.clone() + "#B"
  if !before_key.starts_with(prefix.clone()) then
    return edit_transform_fail(EditError::PreconditionFailed, "statement-anchor-foreign: " + before_key)
  end
  let rest = before_key.slice(prefix.len(), before_key.len())
  let anchor = edit_parse_block_stmt(rest)
  if !anchor.2 then
    return edit_transform_fail(EditError::PreconditionFailed, "statement-anchor-unparsable: " + before_key)
  end
  let block_id = anchor.0
  let stmt_idx = anchor.1
  if block_id != 0 then
    return edit_transform_fail(EditError::PreconditionFailed,
      "statement-anchor-block-not-top: B" + block_id.to_string() + " (only the function's top-level body block B0 maps onto the AST)")
  end
  let stmt = match edit_parse_statement_text(statement_text.clone())
  when Option::Some(s) then s
  when Option::None then
    return edit_transform_fail(EditError::PreconditionFailed, "statement-text-unparsable: " + statement_text)
  end
  let site = edit_locate_function_site(program.clone(), fn_key.clone())
  match site
  when EditItemSite::EditSiteNone then
    edit_transform_fail(EditError::PreconditionFailed, "function-not-in-source: " + fn_key)
  when _ then
    let spliced = edit_splice_insert(program, site, stmt_idx, stmt)
    if !spliced.1 then
      edit_transform_fail(EditError::PreconditionFailed, "statement-anchor-unmappable: " + before_key)
    else
      edit_transform_ok(spliced.0,
        "insert-statement:" + before_key + " text:" + statement_text)
    end
  end
end

def edit_transform_signature(program: Program, resolved: ResolvedEdit, sig_text: String) -> EditTransformResult
  if resolved.targets.len() == 0 then
    return edit_transform_fail(EditError::PreconditionFailed, "change-signature-target-missing")
  end
  let target = resolved.targets[0].clone()
  let site = edit_locate_function_site(program.clone(), target.clone())
  match site
  when EditItemSite::EditSiteNone then
    edit_transform_fail(EditError::PreconditionFailed, "function-not-in-source: " + target)
  when _ then
    let sig = match edit_parse_signature_decl(sig_text.clone())
    when Option::Some(s) then s
    when Option::None then
      return edit_transform_fail(EditError::PreconditionFailed, "signature-text-unparsable: " + sig_text)
    end
    let spliced = edit_splice_signature(program, site, sig)
    if !spliced.1 then
      edit_transform_fail(EditError::PreconditionFailed, "signature-splice-failed: " + target)
    else
      var calls = "0".to_string()
      for p in resolved.preconditions do
        if p.starts_with("callsites-to-update:") then
          calls = p.slice("callsites-to-update:".len(), p.len())
        end
      end
      edit_transform_ok(spliced.0,
        "change-signature:" + target + " callsites-not-updated:" + calls)
    end
  end
end

# The AST transformation of one resolved edit (no rendering, no
# validation — the two pipeline entries below add those). ChangeContract
# and FillHole keep their existing (real) apply surfaces and are reported
# UnsupportedEdit on the SOURCE surface.
pub def edit_transform_source(source: String, resolved: ResolvedEdit) -> EditTransformResult
  let parsed = parse(tokenize(source, "<semantic-edit>".to_string()))
  if diag_has_errors(&parsed.diagnostics) then
    return edit_transform_fail(EditError::PreconditionFailed,
      "source-parse: " + edit_first_diag_text(&parsed.diagnostics))
  end
  match resolved.clone().edit
  when SemanticEdit::Rename(_, new_name) then
    edit_transform_rename(parsed.program, resolved, new_name)
  when SemanticEdit::ReplaceCall(_, callee) then
    edit_transform_replace_call(parsed.program, resolved, callee)
  when SemanticEdit::InsertStatement(_, _, statement_text) then
    edit_transform_insert(parsed.program, resolved, statement_text)
  when SemanticEdit::ChangeSignature(_, new_signature_text) then
    edit_transform_signature(parsed.program, resolved, new_signature_text)
  when SemanticEdit::ChangeContract(_, _) then
    edit_transform_fail(EditError::UnsupportedEdit,
      "ChangeContract applies on the snapshot surface (apply_edit)")
  when SemanticEdit::FillHole(_, _) then
    edit_transform_fail(EditError::UnsupportedEdit,
      "FillHole applies on the typed-program surface (apply_fill_hole)")
  end
end

# ———————————————————————————————————————————————————————————————
# The REQUIRED source entry: transform + render + re-parse
# ———————————————————————————————————————————————————————————————
# edit_apply_to_source(source_text, resolved) -> Result[String, EditError]:
# the AST transformation above, rendered through the canonical formatter,
# with a final re-parse of the emitted text (a render the parser cannot
# read back is PreconditionFailed — never a confidently returned corrupt
# source). edit_apply_to_source does NOT re-run resolution/typing; use
# apply_edit_to_source for the validated application record.
pub def edit_apply_to_source(source: String, resolved: ResolvedEdit) -> Result[String, EditError]
  let transform = edit_transform_source(source, resolved)
  let program_opt = transform.program.clone()
  match program_opt
  when Option::None then
    Result::Err(edit_transform_error(transform.clone()))
  when Option::Some(program) then
    let rendered = format_program_to_string(program)
    let out = parse(tokenize(rendered.clone(), "<semantic-edit>".to_string()))
    if diag_has_errors(&out.diagnostics) then
      Result::Err(EditError::PreconditionFailed)
    else
      Result::Ok(rendered)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Re-validation (parse -> resolve -> type -> access -> ownership)
# ———————————————————————————————————————————————————————————————

pub struct EditRevalidation
  parsed: Bool
  resolved: Bool
  typechecked: Bool
  ownership_checked: Bool
  detail: String
end

def edit_first_diag_text(diags: Vec[Diagnostic]) -> String
  for d in diags do
    if d.level == DiagLevel::Error then
      return d.message.clone()
    end
  end
  "unknown".to_string()
end

def edit_first_resolution_text(errors: Vec[ResolutionError]) -> String
  for e in errors do
    return e.message.clone()
  end
  "unknown".to_string()
end

# Re-run the front end over one (already regenerated) source text: parse,
# node-id assignment, name resolution, typed checking, and the two CFG
# analyses (access exclusivity + resource ownership). The detail text names
# the first failing phase and its first message — the evidence the caller
# pipeline records. NOTE: the macro-expansion / @cfg prologue of
# compiler_core's prepare_parsed is not re-run here (see the section doc).
pub def edit_revalidate_source(source: String, file: String) -> EditRevalidation
  let out = parse(tokenize(source, file))
  if diag_has_errors(&out.diagnostics) then
    return EditRevalidation {
      parsed: false, resolved: false, typechecked: false, ownership_checked: false,
      detail: "parse: " + edit_first_diag_text(&out.diagnostics)
    }
  end
  var program = out.program
  assign_node_ids(&mut program)
  let resolutions = match resolve_names(program.clone())
  when Result::Ok(r) then r
  when Result::Err(errors) then
    return EditRevalidation {
      parsed: true, resolved: false, typechecked: false, ownership_checked: false,
      detail: "resolve: " + edit_first_resolution_text(&errors)
    }
  end
  var env = type_env_new()
  let tr = type_check_typed(&mut env, program.clone(), resolutions.clone())
  if !tr.errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: false, ownership_checked: false,
      detail: "type: " + tr.errors[0].message.clone()
    }
  end
  let typed = tr.program.typed
  let cfg = build_typed_cfg(program.clone(), &typed)
  var ctx = analysis_context_new()
  let access_errors = access_check(program.clone(), &typed, &cfg, &mut ctx)
  if !access_errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: true, ownership_checked: false,
      detail: "access: " + access_errors[0].message.clone()
    }
  end
  var engine_snapshot = tr.program.engine_snapshot
  let res = resource_check(program.clone(), &typed, &cfg, &mut ctx, &mut engine_snapshot)
  if !res.errors.is_empty() then
    return EditRevalidation {
      parsed: true, resolved: true, typechecked: true, ownership_checked: false,
      detail: "ownership: " + res.errors[0].message.clone()
    }
  end
  EditRevalidation {
    parsed: true, resolved: true, typechecked: true, ownership_checked: true,
    detail: "parse:ok;resolve:ok;type:ok;access:ok;ownership:ok"
  }
end

# ———————————————————————————————————————————————————————————————
# apply_edit_to_source — the validated pipeline record
# ———————————————————————————————————————————————————————————————
# The full source-edit pipeline: transform -> render -> validate ->
# EditApplication (edited source + validation status + the expected delta
# rows). The delta/snapshot/budget/patch stages are the caller's pipeline
# (see the EditApplication type doc). A re-validation failure is
# PreconditionFailed; the evidence text rides SourceEditCheck.evidence
# (apply_edit_to_source_checked), so the caller never has to guess.
pub struct SourceEditCheck
  result: Result[EditApplication, EditError]
  evidence: String = ""
end

pub def edit_kind_word(edit: SemanticEdit) -> String
  match edit
  when SemanticEdit::Rename(_, _) then "rename"
  when SemanticEdit::ChangeSignature(_, _) then "change-signature"
  when SemanticEdit::ChangeContract(_, _) then "change-contract"
  when SemanticEdit::ReplaceCall(_, _) then "replace-call"
  when SemanticEdit::InsertStatement(_, _, _) then "insert-statement"
  when SemanticEdit::FillHole(_, _) then "fill-hole"
  end
end

pub def apply_edit_to_source_checked(source: String, resolved: ResolvedEdit) -> SourceEditCheck
  let transform = edit_transform_source(source, resolved.clone())
  let program_opt = transform.program.clone()
  match program_opt
  when Option::None then
    SourceEditCheck {
      result: Result::Err(edit_transform_error(transform.clone())),
      evidence: transform.evidence.clone()
    }
  when Option::Some(program) then
    let rendered = format_program_to_string(program)
    let validation = edit_revalidate_source(rendered.clone(), "<semantic-edit>".to_string())
    if !validation.parsed then
      return SourceEditCheck {
        result: Result::Err(EditError::PreconditionFailed),
        evidence: "render-parse: " + validation.detail
      }
    end
    let revalidated = validation.resolved && validation.typechecked && validation.ownership_checked
    let app = EditApplication {
      edit: resolved.edit.clone(),
      applied: Vec::from([
        "source-edited:" + edit_kind_word(resolved.edit.clone()),
        transform.evidence.clone()
      ]),
      resolved: Option::Some(resolved.clone()),
      edited_source: rendered.clone(),
      parsed: true,
      revalidated: revalidated,
      validation_detail: validation.detail.clone(),
      delta_rows: resolved.expected_delta.clone()
    }
    if !revalidated then
      SourceEditCheck {
        result: Result::Err(EditError::PreconditionFailed),
        evidence: validation.detail.clone()
      }
    else
      SourceEditCheck {
        result: Result::Ok(app),
        evidence: validation.detail.clone()
      }
    end
  end
end

# The plain pipeline entry: Ok carries the validated application, Err the
# typed error (the evidence is available through the _checked entry above).
pub def apply_edit_to_source(source: String, resolved: ResolvedEdit) -> Result[EditApplication, EditError]
  let check = apply_edit_to_source_checked(source, resolved)
  check.result
end

# ———————————————————————————————————————————————————————————————
# Source-engine lane (third-audit item 30 executable rows)
# ———————————————————————————————————————————————————————————————
# S1 Rename: declaration + references rewritten, output re-parses and
#    revalidates (parse/resolve/type/access/ownership).
# S2 ReplaceCall: the caller's direct call site is spliced to the new
#    callee and revalidates.
# S3 InsertStatement: the statement text is spliced before the mapped
#    top-level-body anchor and revalidates.
# S4 ChangeSignature: the declaration's parameter/return syntax is spliced
#    (edit_apply_to_source direct + the validated application record).
# S5 Fail-closed: absent declaration, rename collision, non-top statement
#    anchor, unparsable statement, unmatched call site, unparsable
#    signature — every one PreconditionFailed.
# Returns the mismatch rows (empty = the whole lane verifies).

def edit_lane_count(haystack: String, needle: String) -> Int
  var count = 0
  var i = 0
  while i + needle.len() <= haystack.len() do
    if haystack.slice(i, i + needle.len()) == needle then
      count = count + 1
      i = i + needle.len()
    else
      i = i + 1
    end
  end
  count
end

def edit_lane_bool_row(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def edit_lane_error_row(
  inout out: Vec[String], name: String, result: Result[EditApplication, EditError], expected: String
) -> Unit
  match result
  when Result::Ok(_) then
    out.push(name + ": expected " + expected + ", got Ok")
  when Result::Err(e) then
    if edit_error_word(e) != expected then
      out.push(name + ": expected " + expected + ", got " + edit_error_word(e))
    end
  end
  ()
end

pub def semantic_source_edit_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  let src1 = "def old() -> Int\n  1\nend\n\ndef caller() -> Int\n  old()\nend\n"
  let fn_key = "m::f#fn()->Int".to_string()

  # ———— S1: Rename declaration + references ————
  let r1 = ResolvedEdit {
    edit: SemanticEdit::Rename("m::old#fn()->Int".to_string(), "renamed".to_string()),
    targets: Vec::from(["m::old#fn()->Int".to_string()])
  }
  match apply_edit_to_source(src1.clone(), r1)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-rename-parsed", app.parsed)
    edit_lane_bool_row(&mut out, "source-rename-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-rename-decl", app.edited_source.contains("def renamed()"))
    edit_lane_bool_row(&mut out, "source-rename-reference",
      edit_lane_count(app.edited_source.clone(), "renamed()".to_string()) == 2)
    edit_lane_bool_row(&mut out, "source-rename-no-stale", !app.edited_source.contains("old"))
    edit_lane_bool_row(&mut out, "source-rename-delta-rows",
      app.delta_rows.len() == 1 && app.delta_rows[0] == "entity-modified:m::old#fn()->Int")
  when Result::Err(e) then
    out.push("source-rename: expected Ok, got " + edit_error_word(e))
  end

  # ———— S2: ReplaceCall splice ————
  let src2 = "def a() -> Int\n  1\nend\n\ndef b() -> Int\n  2\nend\n\ndef c() -> Int\n  a()\nend\n"
  let call_key = "m::c#fn()->Int|m::a#fn()->Int|0".to_string()
  let r2 = ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(call_key.clone(), "m::b#fn()->Int".to_string()),
    targets: Vec::from([call_key.clone(), "m::b#fn()->Int".to_string()])
  }
  match apply_edit_to_source(src2.clone(), r2)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-replace-call-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-replace-call-site",
      edit_lane_count(app.edited_source.clone(), "b()".to_string()) == 2)
    edit_lane_bool_row(&mut out, "source-replace-call-clean", !app.edited_source.contains("\n  a()"))
  when Result::Err(e) then
    out.push("source-replace-call: expected Ok, got " + edit_error_word(e))
  end

  # ———— S3: InsertStatement splice ————
  let before_key = fn_key.clone() + "#B0#S0"
  let r3 = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), before_key.clone(), "let tmp = 1".to_string()),
    targets: Vec::from([fn_key.clone(), before_key.clone()])
  }
  match apply_edit_to_source("def f() -> Int\n  42\nend\n", r3)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-insert-revalidated", app.revalidated)
    edit_lane_bool_row(&mut out, "source-insert-present", app.edited_source.contains("let tmp = 1"))
  when Result::Err(e) then
    out.push("source-insert: expected Ok, got " + edit_error_word(e))
  end

  # ———— S4: ChangeSignature declaration splice ————
  let r4 = ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(fn_key.clone(), "(x: Int) -> Int".to_string()),
    targets: Vec::from([fn_key.clone()])
  }
  match edit_apply_to_source("def f() -> Int\n  1\nend\n", r4.clone())
  when Result::Ok(text) then
    edit_lane_bool_row(&mut out, "source-signature-text", text.contains("def f(x: Int) -> Int"))
  when Result::Err(e) then
    out.push("source-signature-edit-apply: expected Ok, got " + edit_error_word(e))
  end
  match apply_edit_to_source("def f() -> Int\n  1\nend\n", r4)
  when Result::Ok(app) then
    edit_lane_bool_row(&mut out, "source-signature-revalidated", app.revalidated)
  when Result::Err(e) then
    out.push("source-signature: expected Ok, got " + edit_error_word(e))
  end

  # ———— S5: fail-closed cases ————
  let r_missing = ResolvedEdit {
    edit: SemanticEdit::Rename("m::nope#fn()->Int".to_string(), "z".to_string()),
    targets: Vec::from(["m::nope#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-rename-missing",
    apply_edit_to_source(src1.clone(), r_missing), "PreconditionFailed".to_string())

  let r_collide = ResolvedEdit {
    edit: SemanticEdit::Rename("m::old#fn()->Int".to_string(), "caller".to_string()),
    targets: Vec::from(["m::old#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-rename-collision",
    apply_edit_to_source(src1.clone(), r_collide), "PreconditionFailed".to_string())

  let r_block9 = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), fn_key.clone() + "#B9#S0", "let tmp = 1".to_string()),
    targets: Vec::from([fn_key.clone(), fn_key.clone() + "#B9#S0"])
  }
  edit_lane_error_row(&mut out, "source-insert-anchor-block",
    apply_edit_to_source("def f() -> Int\n  42\nend\n", r_block9), "PreconditionFailed".to_string())

  let r_bad_stmt = ResolvedEdit {
    edit: SemanticEdit::InsertStatement(fn_key.clone(), before_key.clone(), "let =".to_string()),
    targets: Vec::from([fn_key.clone(), before_key.clone()])
  }
  edit_lane_error_row(&mut out, "source-insert-bad-statement",
    apply_edit_to_source("def f() -> Int\n  42\nend\n", r_bad_stmt), "PreconditionFailed".to_string())

  let no_call_key = "m::c#fn()->Int|m::z#fn()->Int|0".to_string()
  let r_nocall = ResolvedEdit {
    edit: SemanticEdit::ReplaceCall(no_call_key.clone(), "m::b#fn()->Int".to_string()),
    targets: Vec::from([no_call_key.clone(), "m::b#fn()->Int".to_string()])
  }
  edit_lane_error_row(&mut out, "source-replace-call-missing",
    apply_edit_to_source(src2.clone(), r_nocall), "PreconditionFailed".to_string())

  let r_badsig = ResolvedEdit {
    edit: SemanticEdit::ChangeSignature(fn_key.clone(), "(x: ->".to_string()),
    targets: Vec::from([fn_key.clone()])
  }
  edit_lane_error_row(&mut out, "source-signature-bad-text",
    apply_edit_to_source("def f() -> Int\n  1\nend\n", r_badsig), "PreconditionFailed".to_string())

  out
end
