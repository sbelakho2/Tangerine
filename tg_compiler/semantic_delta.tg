# Tangerine Compiler — Semantic Delta Core (audit §31)
# Self-hosting compiler written in Tangerine
#
# semantic_delta_of compares two SemanticSnapshot values table-by-table by
# stable key and renders one SemanticDelta describing what changed between
# two compilations. The module reads ONLY snapshot rows (never AST / typed /
# MIR state) and mirrors the semantic_model.tg / semantic_snapshot.tg idioms.
# The extended closure API (affected_closure — audit item 41) additionally
# reads the §32 read-side index (semantic_index.tg — itself a pure fold of
# snapshot rows) for the closure's edge lookups; it still never touches AST /
# typed / MIR state.
#
# TABLE ANCHORS: symbols -> entity diff (created/removed/modified); calls /
# effects / capabilities / ownership / contracts -> the *_delta rows;
# mir_functions -> the mir_changed flag; the public_api_hash / abi_hash WORD
# pairs -> public_api_delta / abi_delta; the abi_surfaces table (audit
# item 18) -> the abi view rows and the per-surface before/after row texts.
# The api view rows are reconstructed from the pub symbol+type rows (the
# snapshot writer's public_api text domain); the abi view rows are the
# persisted canonical ABI/layout row texts, falling back to the
# pub-Function keys for pre-item-18 snapshots. The types table is read for
# those api rows only; tests/coverage carry no rows today and no delta
# signal (documented); the unsafe_facts table feeds unsafe_delta (audit
# item 16 — the created/removed UnsafeFact row lists).
#
# TYPED DELTAS (audit item 14): the effect/capability/ownership/contract
# delta rows are TYPED before/after records — the diff core compares the
# domain values structurally (the §11 dirty-word projection + capability-id
# view for effect rows, row presence for capability edges, per-place state
# words for ownership, the ContractFact semantic projection for contract
# rows), never by reconstructing comparison strings. Each record carries
# its before/after payloads; lifecycle falls out of the payloads (Created =
# before-empty/None/Absent, Removed = after-empty/None/Absent, Modified =
# both sides present and different) — see the per-record docs below. The
# row differs are computed per key over the union of both sides' rows; rows
# present on both sides with equal values are NOT emitted (an unchanged row
# is no delta row).
#
# KEY IDENTITY SCHEME (report): model rows key on their StableDefId — the
# canonical key TEXT (stable_id.key = "module_path::name#signature") with the
# 128-bit digest words alongside. Since audit item 5 the COMPARISON maps key
# on the TYPED stable identity (stable_ids.tg), never on raw text: the
# def-keyed row maps (symbols / effects / mir function rows) key by
# StableDeclId (the declaration lineage — a signature edit is the SAME
# declaration whose StableSymbolId.full_key changed, and the diff pairs it
# structurally as ONE signature_changed entity instead of text-matching a
# removed/created pair), and the composite row maps key by StableRowKey
# (call rows "caller|callee|kind"; capability pairs "fn|cap<id>";
# ownership pairs "fn|place"; contract rows "fn|kind|clause") whose digest
# words ARE the row identity and whose `text` field carries the canonical
# row key for protocol rendering. Row keys are built once from the
# snapshot's canonical texts (stable_decl_of_key / stable_composite_row_key
# / stable_row_key_of); the DELTA'S PUBLIC protocol rows (created /
# removed / affected key texts, EntityDelta.stable_id, EdgeDelta.from/to,
# ContractDelta.contract_id, ...) remain canonical-TEXT carriers rendered
# from the typed keys — attached cargo, never the comparison authority:
#   symbol stable_id.key (rendered from the row's StableSymbolId)
#   call caller.key|callee.key|kind-numeric (StableRowKey.text)
#   effect/mir function.key (StableDeclId -> attached text)
#   capability function.key|cap<id>|Requires|Provides
#   ownership function.key|place|let|inout|sink|set
#   contract function.key|Pre|Post|Invariant|clause
#
# ROW PAYLOADS (canonical renders; spans and digest words never participate —
# identity is the key): symbol kind|pub|generic (name/module/signature ride
# the key); call "" (content IS the key); effect the §11 projection — the
# dirty word and sorted capability ids (delta_effect_view_of's
# EffectSummaryView); capability "" with the row's presence as its value;
# ownership the per-place convention state words (sorted, ";"-joined);
# contract the ContractSemantic projection (kind word / fingerprint /
# canonical text / message — the message is the only field NOT inside the
# row key, so a message-only edit yields a Modified contract row); mir
# blocks|statements|locals|reachable|unsafe|unknown|effect-payload. Same key
# + identical value = unchanged; the delta records carry the differing
# before/after values (Created/Removed/Modified per the payload rule above).
#
# PER-ENTITY FLAG DERIVATION:
#   signature_changed — the SAME StableDeclId present on both sides whose
#     canonical full key text differs (the "#" component changed) is ONE
#     declaration with a changed signature: it reports once as Modified,
#     keyed by the b-side full key. The DefKind payload gate is kept — a
#     same-decl pair whose kind word differs is a remove + create, never a
#     signature change.
#   mir_changed — the decl-keyed mir payloads differ.
#   effects_changed — the decl-keyed EffectSummaryView values differ.
#   capabilities_changed / ownership_changed / contracts_changed — the
#     per-fn row multiset (the typed row-key suffixes under the fn decl)
#     differs.
#   abi_changed — Function kind both sides, pub on either side, and the
#     (pub, generic, mir-row presence) slice or the signature changed
#     (approximation: layout-only ABI drift is visible only via the hash).
# An entity gets an EntityDelta entry iff its symbol payload changed or any
# flag fired (emit-nothing: a function with no domain change yields none).
#
# affected: seeds = created/removed/modified keys; closes over b's call rows
# to a fixed point — a caller row whose callee (the row's `to`) is affected
# becomes affected — capped at the b call-table size. This is the §31
# call-closure core of audit item 41; the FULL semantic-dependency-graph
# closure over every edge class the snapshot/index data supports is
# affected_closure below (its doc carries the per-kind data matrix and the
# documented residual gaps).
#
# public_api / abi deltas: the hash-word pairs of §29 become the typed
# AbiDeltaView surfaces (audit item 14): one view per surface carrying the
# FULL sorted before/after row sets (api = the reconstructed pub rows; abi =
# the persisted abi_surfaces canonical row texts, pub-Function keys for
# pre-item-18 snapshots). The digest text derives the changed flag and the
#   symmetric-difference rows from the views; consumers needing the surface
#   delta use semantic_delta_rows_same / semantic_delta_rows_diff. The abi
#   view ALSO carries surface_rows — the per-surface before/after row texts
#   (audit item 18), keyed by the row's stable surface id, so a consumer
#   can name the exact layout/class change without re-keying the view rows.
#
# CONTRACT RELATIONS (audit items 17 + 27): the module ALSO exposes the
# typed strengthening/weakening comparison of contract clauses —
# ContractRelation + contract_relation_of(before, after) over the
# ContractSemantic projections, with a SMALL SOUND implication prover over
# the canonical op-word trees (section "Contract relations ..." below: equal
# trees, AND-conjunct containment (x ∧ y) ⇒ x, and the numeric-bound lattice
# of the comparison words over identical operand texts with int-literal
# bounds). contract_relation_of is orientation-NEUTRAL: Strengthened is
# after ⇒ before and Weakened is before ⇒ after for EVERY kind. The §36
# change-budget gate's clause comparator is the kind-aware orientation —
# ContractCompatibility + contract_compatibility_of(kind, relation) in the
# "contract-compatibility orientation" section below (third audit item 27):
# Pre + Strengthened and Post + Weakened are compatibility-Breaking (old
# callers / consumers become illegal), Pre + Weakened and Post +
# Strengthened are Compatible, every non-Equivalent Invariant change is
# Breaking, Equivalent is Compatible, and every Incomparable is Unknown
# (not provably safe — fail-closed). change_budget.tg check 4 consumes the
# classification: Breaking / Unknown violate unless the budget authorizes
# contract evolution, and the default-refactor budget
# (allow_contract_evolution = false) admits zero contract deltas. The
# relation depends ONLY on the kind word and the canonical clause texts —
# the message never participates — and a message-only edit (a Modified
# row) is always Equivalent.

use std::collections::{Vec, Map}

use tg_compiler::ids::{StableDigest, stable_digest_of, DefKind, stable_def_id_digested}
use tg_compiler::ast::{AccessConvention, AstContractKind}
use tg_compiler::types::{EffectSummary}
use tg_compiler::stable_ids::{
  StableContractId, StableDeclId, StableSymbolId, StableEffectId, StableRowKey,
  stable_decl_of_key, stable_decl_eq, stable_row_key_digest_eq,
  stable_symbol_id_of_full_key, stable_symbol_of_key,
  stable_composite_row_key, stable_row_key_or_text, stable_effect_from_def,
  stable_decl_reference_text
}
use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticSymbol, SemanticType, SemanticTypeKind, StableTargetId,
  CallEdge, CallEdgeKind, ContractExprIR, ContractFact, MirSemanticSummary,
  TestRelationship, UnsafeFact, UnsafeDelta, DependencyEdgeKind,
  semantic_digest_render, semantic_json_escape, semantic_summary_dirty_word,
  semantic_def_kind_text, semantic_stable_def_id_digest, semantic_call_edge_kind_numeric,
  semantic_contract_expr_text, semantic_unsafe_kind_text, semantic_unsafe_fact_lt,
  semantic_abi_surface_row_text, semantic_dependency_edge_kind_numeric,
  SemanticDependencyGraph, TypeUseEdge, TraitImplEdge, TraitSelectionEdge,
  GenericInstantiationEdge, LayoutDependencyEdge, ConstEvalDependencyEdge,
  DerivedBodyEdge, ContractReferenceEdge, AbiDependencyEdge
}
use tg_compiler::semantic_index::{
  SemanticIndex, build_semantic_index, index_callers_of, index_tests_for_symbol
}

# ———— The §31 protocol records ————

enum DeltaKind
  Created
  Removed
  Modified
end

# One modified entity. stable_id is the current (b-side) stable key text;
# the flags say which domain slice changed (see the module doc). kind is
# DeltaKind::Modified for every entry (created/removed ride the key lists).
struct EntityDelta
  stable_id: String
  signature_changed: Bool
  mir_changed: Bool
  effects_changed: Bool
  capabilities_changed: Bool
  ownership_changed: Bool
  contracts_changed: Bool
  abi_changed: Bool
  kind: DeltaKind
end

# One changed relationship row (calls): key = the row's composite key text;
# from/to = the subject/object endpoint texts (caller/callee stable keys).
struct EdgeDelta
  key: String
  kind: DeltaKind
  from: String
  to: String
end

# The presence vocabulary of the capability rows (a capability row's only
# content is its presence under its row key).
enum Presence
  Present
  Absent
end

# The §11 effect projection used as the effect-row COMPARISON VALUE (audit
# item 14): the dirty-class word (semantic_summary_dirty_word — allocate=1,
# block=2, io=4, spawn=8, sleep=16, panic=32, unsafe=64) plus the sorted
# capability-id texts of the summary's capability set — the two §11
# projections semantic_snapshot.tg serializes (snapshot_effect_line's
# "flags"/"caps"). No String is ever reconstructed to compare effect rows:
# the view is compared field-wise.
struct EffectSummaryView
  bits: Int
  capabilities: Vec[String] = Vec::new()
end

# One def-keyed comparison row under its declaration identity (audit item
# 5): the row's full stable symbol identity (declaration lineage + parsed
# signature fingerprint + full key text) plus the canonical fixed-field
# payload text (delta_sym_payload). The map key (StableDeclId) is the
# declaration; a changed signature is the SAME key with a different
# SymbolRow.id.full_key, which the diff pairs as one signature_changed
# entity.
struct SymbolRow
  id: StableSymbolId
  payload: String
end

# One def-keyed effect row under its declaration identity (audit item 5):
# the row's full stable effect identity (the canonical function key text +
# digest pair) plus the typed §11 comparison view. The StableDeclId map
# key is the comparison identity; the id supplies the canonical function
# key text the protocol rows render.
struct EffectRow
  id: StableEffectId
  view: EffectSummaryView
end

# ONE changed effect row (audit item 14): the function's summary gained,
# lost or changed classes/capabilities. before/after hold the §11 views of
# the two snapshots' effect rows (the EMPTY view — bits 0, no capabilities —
# stands for the absent row); lifecycle: Created = before empty and the row
# existed only on the b side, Removed = after empty, Modified = both sides
# present with different views.
struct EffectDelta
  function: String
  before: EffectSummaryView
  after: EffectSummaryView
end

# ONE changed capability edge (audit item 14): presence per (function,
# capability) pair — a function either requires/provides a capability id on
# a side or it does not (direction words ride the snapshot row keys, but a
# function has at most ONE capability row per (function, capability) in the
# snapshot domain — the capability-edge presence is the row's content).
# capability is the row's "cap<id>" text (the fixed §11 CapabilityId render).
# before/after: Present = the pair's row exists on that side.
struct CapabilityDelta
  function: String
  capability: String
  before: Presence
  after: Presence
end

# ONE changed ownership fact (audit item 14): the per-place row of a
# function carries the place's convention STATE — the sorted convention
# words (let/inout/sink/set) of every ownership row under the
# (function, place) pair, ";"-joined (a place with several conventions in a
# body is one row whose state word lists them). before/after = the a/b-side
# state words ("" = the place row did not exist on that side).
struct OwnershipDelta
  function: String
  place: String
  before: String
  after: String
end

# The semantic projection of ONE ContractFact row (audit item 14) — the
# typed comparison value of the contract domain: kind = the canonical kind
# word (Pre|Post|Invariant), expression_fingerprint = the digest render of
# the clause's canonical-text digest, canonical_text = the flattened
# canonical clause text (the row key's content component), message = the
# declared message (None = none declared). Everything except the message
# rides the row's StableContractId key, so two rows with the same id can
# differ ONLY in the message (a message-only edit -> a Modified row).
struct ContractSemantic
  kind: String
  expression_fingerprint: String
  canonical_text: String
  message: Option[String]
end

# ONE changed contract clause (audit item 14): contract_id = the clause's
# StableContractId stable key text (the current b-side spelling of the row
# identity); before/after = the semantic projections of the row on each
# side (None = the clause did not exist on that side).
struct ContractDelta
  contract_id: String
  before: Option[ContractSemantic] = Option::None
  after: Option[ContractSemantic] = Option::None
end

# The §37 REPORT surfaces (retained payload records — the SemanticDelta
# itself carries the typed AbiDeltaView surfaces below; the proof-carrying
# patch rebuilds these changed-flag + symmetric-row records from the views
# in proof_patch_of_delta).
struct ApiDelta
  public_api_changed: Bool
  public_api_rows: Vec[String] = Vec::new()
end

struct AbiDelta
  abi_changed: Bool
  abi_rows: Vec[String] = Vec::new()
end

# The typed BEFORE/AFTER surface of one hash domain (audit item 14): the
# public-api and abi deltas carry no per-key data richer than the sorted
# surface row texts (api = the reconstructed "<digest> <kind> <key>" pub
# rows; abi = the persisted abi_surfaces canonical row texts when present,
# the pub-Function stable keys otherwise), so AbiSurfaceView { rows } IS
# the comparison payload and AbiDeltaView pairs the two sides under the
# surface's id word ("api" | "abi" — the digest text domain's own tags). The hash pair of §29 is
# derivable: the rows differ iff the surface changed.
struct AbiSurfaceView
  rows: Vec[String] = Vec::new()
end

# One ABI surface row's BEFORE/AFTER text (audit item 18): the canonical
# semantic_abi_surface_row_text of the row under its surface id, None when
# the surface id is absent from that side. Only CHANGED surfaces are
# carried (an unchanged row is no delta row); the surface id is the row's
# stable join key ("fn:<full stable key>" | "type:<full stable key>").
struct AbiSurfaceRowDelta
  surface_id: String
  before: Option[String] = Option::None
  after: Option[String] = Option::None
end

struct AbiDeltaView
  surface_id: String
  before: AbiSurfaceView
  after: AbiSurfaceView
  # The per-surface before/after row texts of the persisted abi_surfaces
  # table (item 18) — empty for pre-item-18 snapshots and for the api
  # surface (whose rows are symbol-row reconstructions, not a persisted
  # table). A convenience projection of the view rows' symmetric
  # difference, never an independent payload.
  surface_rows: Vec[AbiSurfaceRowDelta] = Vec::new()
end

struct SemanticDelta
  created: Vec[String] = Vec::new()
  removed: Vec[String] = Vec::new()
  modified: Vec[EntityDelta] = Vec::new()
  call_delta: Vec[EdgeDelta] = Vec::new()
  effect_delta: Vec[EffectDelta] = Vec::new()
  capability_delta: Vec[CapabilityDelta] = Vec::new()
  ownership_delta: Vec[OwnershipDelta] = Vec::new()
  contract_delta: Vec[ContractDelta] = Vec::new()
  unsafe_delta: UnsafeDelta = UnsafeDelta {}
  public_api_delta: AbiDeltaView
  abi_delta: AbiDeltaView
  affected: Vec[String] = Vec::new()
end

# An EMPTY delta (the emit-nothing value: diffing identical snapshots
# returns this record and digests to a constant).
def semantic_delta_empty() -> SemanticDelta
  SemanticDelta {
    public_api_delta: AbiDeltaView {
      surface_id: "api".to_string(),
      before: AbiSurfaceView { rows: Vec::new() },
      after: AbiSurfaceView { rows: Vec::new() }
    },
    abi_delta: AbiDeltaView {
      surface_id: "abi".to_string(),
      before: AbiSurfaceView { rows: Vec::new() },
      after: AbiSurfaceView { rows: Vec::new() }
    }
  }
end

# ———— Text helpers ————

def delta_bool_text(b: Bool) -> String
  if b then "true" else "false" end
end

def delta_kind_text(k: DeltaKind) -> String
  match k
  when DeltaKind::Created then "Created"
  when DeltaKind::Removed then "Removed"
  when DeltaKind::Modified then "Modified"
  end
end

# The index of the first needle occurrence at or after from (-1 if none).
def delta_char_index(s: String, needle: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    if s.slice(i, i + 1) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The entity name-part of a stable key: everything before "#signature".
def delta_key_name_part(key: String) -> String
  let i = delta_char_index(key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

# Split a composite key at its first two '|' separators; the third part is
# the remainder (a contract clause text may itself contain '|').
def delta_key_parts(key: String) -> (String, String, String)
  let i1 = delta_char_index(key, "|", 0)
  let i2 = if i1 < 0 then -1 else delta_char_index(key, "|", i1 + 1) end
  var p1 = if i1 < 0 then key.clone() else key.slice(0, i1) end
  var p2 = if i1 < 0 || i2 < 0 then "".to_string() else key.slice(i1 + 1, i2) end
  var p3 = if i2 < 0 then "".to_string() else key.slice(i2 + 1, key.len()) end
  (p1, p2, p3)
end

# ———— Per-table canonical keys and payload texts ————

# The §11 summary payload text — the dirty-class word and the sorted
# capability ids (the snapshot writer's canonical caps projection). Used
# for the MIR row payload only; the effect TABLE rows compare typed views
# (delta_effect_view_of), never this text.
def delta_summary_text(s: EffectSummary) -> String
  var ids: Vec[Int] = Vec::new()
  for c in s.capabilities do
    ids.push(c.id)
  end
  ids.sort()
  var caps_text = ""
  var i = 0
  while i < ids.len() do
    if i > 0 then caps_text = caps_text + ";" end
    caps_text = caps_text + ids[i].to_string()
    i = i + 1
  end
  semantic_summary_dirty_word(&s).to_string() + ";" + caps_text
end

# The typed §11 view of an effect summary (audit item 14): the dirty word
# plus the numeric-sorted capability-id texts of the summary's capability
# set — the two projections semantic_snapshot.tg's effect rows serialize.
def delta_effect_view_of(s: EffectSummary) -> EffectSummaryView
  var ids: Vec[Int] = Vec::new()
  for c in s.capabilities do
    ids.push(c.id)
  end
  ids.sort()
  var caps: Vec[String] = Vec::new()
  for id in ids do
    caps.push(id.to_string())
  end
  EffectSummaryView {
    bits: semantic_summary_dirty_word(&s),
    capabilities: caps
  }
end

def delta_effect_view_empty() -> EffectSummaryView
  EffectSummaryView { bits: 0, capabilities: Vec::new() }
end

# Field-wise equality of two views (never a reconstructed String).
def delta_effect_views_same(a: EffectSummaryView, b: EffectSummaryView) -> Bool
  if a.bits != b.bits then
    return false
  end
  if a.capabilities.len() != b.capabilities.len() then
    return false
  end
  var i = 0
  while i < a.capabilities.len() do
    if a.capabilities[i] != b.capabilities[i] then
      return false
    end
    i = i + 1
  end
  true
end

# The canonical render of a view — the "<word>;<cap-ids>" text of the
# §11 payload (byte-identical to delta_summary_text's render of the same
# summary). Used for the delta's canonical TEXT lines and by consumers
# that display an effect row's payload.
pub def semantic_delta_effect_view_text(v: EffectSummaryView) -> String
  v.bits.to_string() + ";" + v.capabilities.join(";")
end

# The convention WORD of an ownership convention (let|inout|sink|set).
def delta_convention_word(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

# The contract kind WORD of a clause (Pre|Post|Invariant).
def delta_contract_kind_word(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

def delta_call_row_key(c: CallEdge) -> String
  c.caller.key.clone() + "|" + c.callee.key.clone() + "|" +
    semantic_call_edge_kind_numeric(&c.kind).to_string()
end

# The typed ContractSemantic projection of one ContractFact row.
def delta_contract_semantic_of(c: ContractFact) -> ContractSemantic
  ContractSemantic {
    kind: delta_contract_kind_word(&c.kind),
    expression_fingerprint: semantic_digest_render(&c.expression_fingerprint),
    canonical_text: semantic_contract_expr_text(&c.canonical_expression),
    message: c.message.clone()
  }
end

def delta_contract_semantics_same(a: Option[ContractSemantic], b: Option[ContractSemantic]) -> Bool
  match a
  when Option::Some(av) then
    match b
    when Option::Some(bv) then
      if av.kind != bv.kind then
        return false
      end
      if av.expression_fingerprint != bv.expression_fingerprint then
        return false
      end
      if av.canonical_text != bv.canonical_text then
        return false
      end
      delta_option_strings_same(&av.message, &bv.message)
    when Option::None then false
    end
  when Option::None then
    match b
    when Option::Some(_) then false
    when Option::None then true
    end
  end
end

def delta_option_strings_same(a: Option[String], b: Option[String]) -> Bool
  match a
  when Option::Some(av) then
    match b
    when Option::Some(bv) then av == bv
    when Option::None then false
    end
  when Option::None then
    match b
    when Option::Some(_) then false
    when Option::None then true
    end
  end
end

def delta_mir_row_payload(m: MirSemanticSummary) -> String
  m.block_count.to_string() + "|" + m.statement_count.to_string() + "|" +
    m.local_count.to_string() + "|" + delta_bool_text(m.reachable) + "|" +
    delta_bool_text(m.calls_unsafe) + "|" + delta_bool_text(m.calls_unknown) + "|" +
    delta_summary_text(&m.effect_summary)
end

# The symbol row payload: kind|is_pub|is_generic — the non-identity fields
# (name/module_path/signature ride the key text).
def delta_sym_payload(row: SemanticSymbol) -> String
  semantic_def_kind_text(&row.kind) + "|" + delta_bool_text(row.is_pub) + "|" +
    delta_bool_text(row.is_generic)
end

# ———— Row-map construction (one keyed map per table per snapshot) ————
# Audit item 5: every per-table comparison map keys on the TYPED stable
# identity — def-keyed rows by StableDeclId (symbols carry their
# StableSymbolId + payload; effects their StableEffectId + typed view; mir
# rows their payload text), composite rows by StableRowKey (calls,
# capability pairs, ownership pairs, contract rows). The builders parse the
# snapshot's canonical row key TEXT once (stable_symbol_id_of_full_key /
# stable_decl_of_key / stable_composite_row_key / stable_row_key_or_text)
# and insert the typed key; identity Eq/Hash folds the digest words and the
# canonical text rides the record (StableSymbolId.full_key /
# StableRowKey.text) for the protocol rows.
#
# TEXT-BOUNDARY FALLBACK (third-audit item 11): these parsers re-derive the
# SYNTHETIC-lineage declaration id from the row's key text — the persistent
# store number is NOT in the text and cannot be recovered by a parse
# (stable_ids' decl_id_of_full_key). Store-backed snapshot writers root
# each def row's StableDefId digest words on the stamped lineage
# (stable_def_id_of_decl, semantic_snapshot.tg's snapshot_walk_defs), so
# the artifact itself carries the persistent identity; these maps stay
# text-keyed until the comparison path consumes the row digest words
# (documented residual — the parsers keep working unchanged for keys that
# arrive as text only, e.g. §35/§36/§37 consumers and hand-built fixtures).

def delta_table_rows(
  s: SemanticSnapshot,
  inout syms: Map[StableDeclId, SymbolRow],
  inout calls: Map[StableRowKey, String],
  inout mirs: Map[StableDeclId, String]
) -> Unit
  for row in s.symbols do
    let sid = match stable_symbol_id_of_full_key(&row.stable_id.key)
    when Option::Some(x) then x
    when Option::None then stable_symbol_of_key(&row.stable_id.key.clone())
    end
    syms.insert(sid.decl.clone(), SymbolRow { id: sid, payload: delta_sym_payload(&row) })
  end
  for c in s.calls do
    let suffix = c.callee.key.clone() + "|" + semantic_call_edge_kind_numeric(&c.kind).to_string()
    let rk = stable_composite_row_key("call".to_string(), c.caller.key.clone(), suffix)
    calls.insert(rk, "".to_string())
  end
  for m in s.mir_functions do
    mirs.insert(stable_decl_of_key(&m.function.key), delta_mir_row_payload(m))
  end
  ()
end

def delta_typed_table_rows(
  s: SemanticSnapshot,
  inout effects: Map[StableDeclId, EffectRow],
  inout caps: Map[StableRowKey, String],
  inout ownership: Map[StableRowKey, String],
  inout contracts: Map[StableRowKey, ContractSemantic]
) -> Unit
  # Effect rows: function decl -> the typed §11 view (row presence = the
  # def-keyed lowering's summary row; missing key = no row).
  for e in s.effects do
    let id = stable_effect_from_def(e.function.clone(), Option::None)
    effects.insert(stable_decl_of_key(&e.function.key), EffectRow { id: id, view: delta_effect_view_of(&e.summary) })
  end
  # Capability edges: presence keyed by the directionless (function,
  # capability) pair "fn.key|cap<id>" (a function has at most one row per
  # pair in the snapshot domain — the edge-direction words ride the row
  # keys but never the row content; the typed CapabilityDelta models the
  # pair's presence, documented).
  for ce in s.capabilities do
    let rk = stable_composite_row_key("capability".to_string(), ce.function.key.clone(),
      "cap" + ce.capability.id.to_string())
    caps.insert(rk, "".to_string())
  end
  # Ownership rows: (function, place) -> the place's convention STATE (the
  # sorted convention words of every row under the pair, ";"-joined).
  for o in s.ownership do
    let rk = stable_composite_row_key("ownership".to_string(), o.function.key.clone(), o.place_key.clone())
    delta_own_state_add(&mut ownership, rk, delta_convention_word(&o.convention))
  end
  # Contract rows: the clause's StableContractId stable key -> the typed
  # semantic projection.
  for ct in s.contracts do
    let rk = stable_row_key_or_text("contract".to_string(), ct.id.stable_key.clone())
    contracts.insert(rk, delta_contract_semantic_of(ct))
  end
  ()
end

def delta_own_state_add(inout m: Map[StableRowKey, String], key: StableRowKey, word: String) -> Unit
  var words: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(cur) then
    for part in cur.split(";") do
      words.push(part.clone())
    end
  when Option::None then ()
  end
  if !words.contains(&word) then
    words.push(word.clone())
  end
  words.sort_by(|x, y| x < y)
  m.insert(key, words.join(";"))
  ()
end

def delta_decl_map_text(m: Map[StableDeclId, String], key: StableDeclId) -> String
  match m.get(key.clone())
  when Option::Some(v) then v.clone()
  when Option::None then "".to_string()
  end
end

def delta_row_map_text(m: Map[StableRowKey, String], key: StableRowKey) -> String
  match m.get(key.clone())
  when Option::Some(v) then v.clone()
  when Option::None then "".to_string()
  end
end

# The deduped union of two typed decl key lists, sorted by the attached
# lineage text (the deterministic order the old sorted text union
# produced; two decls are equal exactly when their digest words agree).
def delta_decl_keys_union(a: Vec[StableDeclId], b: Vec[StableDeclId]) -> Vec[StableDeclId]
  var keys: Vec[StableDeclId] = Vec::new()
  for k in a do
    keys.push(k.clone())
  end
  for k in b do
    var found = false
    for e in keys do
      if stable_decl_eq(&e, &k) then
        found = true
      end
    end
    if !found then
      keys.push(k.clone())
    end
  end
  keys.sort_by(|x, y| stable_decl_reference_text(x) < stable_decl_reference_text(y))
  keys
end

def delta_decl_keys_of_syms(m: Map[StableDeclId, SymbolRow]) -> Vec[StableDeclId]
  var keys: Vec[StableDeclId] = Vec::new()
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  keys
end

def delta_decl_keys_of_effects(m: Map[StableDeclId, EffectRow]) -> Vec[StableDeclId]
  var keys: Vec[StableDeclId] = Vec::new()
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  keys
end

def delta_symbol_payload(m: Map[StableDeclId, SymbolRow], key: StableDeclId) -> String
  match m.get(key.clone())
  when Option::Some(row) then row.payload.clone()
  when Option::None then "".to_string()
  end
end

# The canonical FULL key text of the symbol row under a decl (the protocol
# stable_id row); the stable-reference fallback covers an absent row.
def delta_symbol_key_text(m: Map[StableDeclId, SymbolRow], key: StableDeclId) -> String
  match m.get(key.clone())
  when Option::Some(row) then row.id.full_key.clone()
  when Option::None then stable_decl_reference_text(&key)
  end
end

# The deduped union of two StableRowKey lists, sorted by the canonical row
# key text (the deterministic order the old sorted text union produced).
def delta_row_key_union(a: Vec[StableRowKey], b: Vec[StableRowKey]) -> Vec[StableRowKey]
  var keys: Vec[StableRowKey] = Vec::new()
  for k in a do
    keys.push(k.clone())
  end
  for k in b do
    var found = false
    for e in keys do
      if stable_row_key_digest_eq(&e, &k) then
        found = true
      end
    end
    if !found then
      keys.push(k.clone())
    end
  end
  keys.sort_by(|x, y| x.text < y.text)
  keys
end

def delta_row_keys_of(m: Map[StableRowKey, String]) -> Vec[StableRowKey]
  var keys: Vec[StableRowKey] = Vec::new()
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  keys
end

def delta_row_keys_of_contracts(m: Map[StableRowKey, ContractSemantic]) -> Vec[StableRowKey]
  var keys: Vec[StableRowKey] = Vec::new()
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  keys
end

# The sorted suffix texts of every keyed row whose SUBJECT declaration is
# `key` — the per-function domain multiset projection of a row-key list
# (caps / contracts; the inputs are the typed map key sets).
def delta_key_rows_of(keys: Vec[StableRowKey], key: StableDeclId) -> Vec[String]
  var parts: Vec[String] = Vec::new()
  for rk in keys do
    if stable_decl_eq(&rk.decl, &key) then
      parts.push(rk.suffix.clone())
    end
  end
  parts.sort_by(|x, y| x < y)
  parts
end

# The per-function projection of the ownership table: the suffix rows
# ("place") WITH their state words ("<place>|<state>" per row) — the
# convention state participates in the multiset, so a convention change at
# an existing place flips the ownership_changed flag.
def delta_own_rows_text(m: Map[StableRowKey, String], key: StableDeclId) -> String
  var parts: Vec[String] = Vec::new()
  for entry in m.entries() do
    if stable_decl_eq(&entry.0.decl, &key) then
      parts.push(entry.0.suffix.clone() + "|" + entry.1.clone())
    end
  end
  parts.sort_by(|x, y| x < y)
  parts.join("\n")
end

# Two sorted text lists' equality (element-wise; the row projections are
# sorted by construction).
def delta_text_lists_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

# ———— The generic row diff — (row-key text, current-side payload, kind) triples ————
# Same identity + identical payload = unchanged; same identity + different
# payload = Modified; identity only in b = Created; only in a = Removed.
# The triple carries the canonical row-key TEXT (protocol rendering); the
# comparison runs on the StableRowKey digest words. The payload is the
# b-side text for Created/Modified rows and the a-side text for Removed
# rows.

def delta_pair_diff(a: Map[StableRowKey, String], b: Map[StableRowKey, String]) -> Vec[(String, String, DeltaKind)]
  var out: Vec[(String, String, DeltaKind)] = Vec::new()
  var keys = delta_row_key_union(&delta_row_keys_of(&a), &delta_row_keys_of(&b))
  for key in keys do
    let has_a = a.contains_key(&key)
    let has_b = b.contains_key(&key)
    let ta = delta_row_map_text(&a, key.clone())
    let tb = delta_row_map_text(&b, key.clone())
    if has_a && has_b then
      if ta != tb then
        out.push((key.text.clone(), tb, DeltaKind::Modified))
      end
    elsif has_b then
      out.push((key.text.clone(), tb, DeltaKind::Created))
    else
      out.push((key.text.clone(), ta, DeltaKind::Removed))
    end
  end
  out
end

# The sorted symmetric difference of two text lists.
def delta_lines_diff(a: Vec[String], b: Vec[String]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for l in a do
    if !b.contains(&l) then
      out.push(l.clone())
    end
  end
  for l in b do
    if !a.contains(&l) then
      out.push(l.clone())
    end
  end
  out.sort_by(|x, y| x < y)
  out
end

# ———— The typed row diff — one per domain (audit item 14; typed keys per
# audit item 5) ————
# Every emitter walks the SORTED key union of the two sides' typed maps,
# reads the before/after values from the maps (never reconstructing a
# comparison string) and emits a delta record per CHANGED row. Unchanged
# rows (both sides present, equal values) emit nothing. The identity keys
# are typed (StableDeclId / StableRowKey); every emitted record carries the
# canonical TEXT its protocol line renders.

# Split a composite key at its first '|' separator — the two-component row
# keys of the typed tables (capability pair "fn.key|cap<id>"; ownership
# "fn.key|place" — neither endpoint text ever contains '|'). Used to
# recover the subject function key text for the protocol rows.
def delta_key_first_split(key: String) -> (String, String)
  let i1 = delta_char_index(key, "|", 0)
  if i1 < 0 then
    (key.clone(), "".to_string())
  else
    (key.slice(0, i1), key.slice(i1 + 1, key.len()))
  end
end

def delta_effect_at(m: Map[StableDeclId, EffectRow], key: StableDeclId) -> EffectSummaryView
  match m.get(key.clone())
  when Option::Some(row) then row.view.clone()
  when Option::None then delta_effect_view_empty()
  end
end

# The canonical function key text of an effect row under a decl: the
# b-side row's StableEffectId.stable_key when present, else the a-side's,
# else the lineage text (a synthesized fallback — no canonical row key).
def delta_effect_key_text(
  a: Map[StableDeclId, EffectRow],
  b: Map[StableDeclId, EffectRow],
  key: StableDeclId
) -> String
  match b.get(key.clone())
  when Option::Some(row_b) then row_b.id.stable_key.clone()
  when Option::None then
    match a.get(key.clone())
    when Option::Some(row_a) then row_a.id.stable_key.clone()
    when Option::None then stable_decl_reference_text(&key)
    end
  end
end

def delta_effect_diffs(
  a: Map[StableDeclId, EffectRow],
  b: Map[StableDeclId, EffectRow]
) -> Vec[EffectDelta]
  var out: Vec[EffectDelta] = Vec::new()
  let keys = delta_decl_keys_union(&delta_decl_keys_of_effects(&a), &delta_decl_keys_of_effects(&b))
  for key in keys do
    let has_a = a.contains_key(&key)
    let has_b = b.contains_key(&key)
    let va = delta_effect_at(&a, key.clone())
    let vb = delta_effect_at(&b, key.clone())
    if !(has_a && has_b && delta_effect_views_same(&va, &vb)) then
      out.push(EffectDelta {
        function: delta_effect_key_text(&a, &b, key.clone()),
        before: va,
        after: vb
      })
    end
  end
  out
end

def delta_presence_of(has: Bool) -> Presence
  if has then Presence::Present else Presence::Absent end
end

# The capability diffs over the StableRowKey presence maps (a "cap<id>"
# pair row exists on exactly the sides that carry the capability edge).
def delta_capability_diffs(a: Map[StableRowKey, String], b: Map[StableRowKey, String]) -> Vec[CapabilityDelta]
  var out: Vec[CapabilityDelta] = Vec::new()
  for key in delta_row_key_union(&delta_row_keys_of(&a), &delta_row_keys_of(&b)) do
    let has_a = a.contains_key(&key)
    let has_b = b.contains_key(&key)
    if has_a != has_b then
      let parts = delta_key_first_split(&key.text)
      out.push(CapabilityDelta {
        function: parts.0.clone(),
        capability: key.suffix.clone(),
        before: delta_presence_of(has_a),
        after: delta_presence_of(has_b)
      })
    end
  end
  out
end

def delta_own_state_at(m: Map[StableRowKey, String], key: StableRowKey) -> String
  delta_row_map_text(&m, key.clone())
end

# The ownership diffs over the (function, place) state row maps: a record
# per place whose state word (or presence) changed.
def delta_ownership_diffs(a: Map[StableRowKey, String], b: Map[StableRowKey, String]) -> Vec[OwnershipDelta]
  var out: Vec[OwnershipDelta] = Vec::new()
  for key in delta_row_key_union(&delta_row_keys_of(&a), &delta_row_keys_of(&b)) do
    let before = delta_own_state_at(&a, key.clone())
    let after = delta_own_state_at(&b, key.clone())
    if before != after then
      let parts = delta_key_first_split(&key.text)
      out.push(OwnershipDelta {
        function: parts.0.clone(),
        place: key.suffix.clone(),
        before: before,
        after: after
      })
    end
  end
  out
end

# The contract diffs over the StableRowKey clause maps: a record per clause
# whose semantic projection (or presence) changed — rows present on both
# sides with equal projections (identical rows) emit nothing.
def delta_contract_diffs(
  a: Map[StableRowKey, ContractSemantic],
  b: Map[StableRowKey, ContractSemantic]
) -> Vec[ContractDelta]
  var out: Vec[ContractDelta] = Vec::new()
  for key in delta_row_key_union(&delta_row_keys_of_contracts(&a), &delta_row_keys_of_contracts(&b)) do
    let va = a.get(key.clone())
    let vb = b.get(key.clone())
    if !delta_contract_semantics_same(&va, &vb) then
      out.push(ContractDelta {
        contract_id: key.text.clone(),
        before: va,
        after: vb
      })
    end
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Contract relations over the canonical clauses (audit item 17)
# ———————————————————————————————————————————————————————————————
# The structured comparison of two ContractSemantic projections of one
# clause position (before = the a-side clause; after = the b-side clause;
# Option::None = the side carries no clause). The relation is decided by
# the kind word and the CANONICAL clause texts ONLY — the message never
# participates (a message-only edit is Equivalent) and the fingerprint is
# the digest of the canonical text, so equal texts carry equal fingerprints
# by construction.
#
# RELATION SEMANTICS PER KIND (the item's kind rules, verbatim in effect):
#   - Precondition ("Pre"): Weakened iff before ⇒ after is provable over
#     the canonical trees (the new pre admits a superset of the old pre's
#     inputs); Strengthened iff after ⇒ before is provable (the new pre
#     admits a subset); anything else is Incomparable.
#   - Postcondition ("Post") / Invariant ("Invariant"): Strengthened iff
#     after ⇒ before (a stricter post — the new clause holds whenever the
#     old one held); Weakened iff before ⇒ after; anything else is
#     Incomparable.
#   The item notes preconditions have different CALLER compatibility
#   semantics than postconditions; the relation LABELS map the provable
#   implication direction identically for every kind (Strengthened =
#   after ⇒ before, Weakened = before ⇒ after) — the per-kind wording above
#   is the audit's anchor and the budget gate consumes both kinds through
#   the same mapping.
# The absence rules fall out of the same mapping (Option::None stands for
# the trivially-true clause): a removed clause (Some, None) is Weakened, an
# added clause (None, Some) is Strengthened, both None is Equivalent. A
# before/after pair whose kind words differ is Incomparable (a Pre clause
# is never compared against a Post clause).
#
# THE TRACTABLE IMPLICATION SUBSET (a SMALL, SOUND prover over the
# canonical op-word trees; everything outside the subset is Incomparable —
# never guessed):
#   1. Equal trees imply both directions (textual equality of the whole
#      canonical clause text).
#   2. AND-conjunction weakening: (x ∧ y) ⇒ x only — an antecedent implies
#      a conjunct when every conjunct of the consequent appears among the
#      antecedent's conjuncts (the "binand" tree flattens through nested
#      ANDs; conjunct identity is the canonical text). No rule proves
#      a ⇒ (a ∧ b) — a clause that ADDS conjuncts is only comparable
#      through the same containment rule in the reverse direction.
#   3. The numeric-bound lattice of the comparison words — bingt / binge /
#      binlt / binle (the lowering's "bin" + lt/le/gt/ge) — over the SAME
#      operand canonical text (args[0] byte-equal) with int-LITERAL bounds
#      ("int(<n>)"): lower bounds: > c ⇒ > c' when c >= c'; > c ⇒ >= c'
#      when c >= c'; >= c ⇒ >= c' when c >= c'; >= c ⇒ > c' when c > c';
#      upper bounds mirrored with <=; a >-family word never implies a
#      <-family word. bineq / binne participate ONLY through tree equality
#      (== cases are Incomparable except equality). Floats, named
#      constants, negated and nested bound operands never fire.
# Every implication the prover reports is sound for the represented
# propositions; "not provable" always means Incomparable.

enum ContractRelation
  Equivalent
  Strengthened
  Weakened
  Incomparable
end

# The canonical op word of a canonical expression text ("" when the text
# does not open "op(" — a malformed text is never an op word and no rule
# fires on it).
def delta_contract_expr_op(text: String) -> String
  let open = delta_char_index(&text, "(", 0)
  if open <= 0 then
    "".to_string()
  else
    text.slice(0, open)
  end
end

# The top-level argument texts of a canonical "op(a1,a2,...)" text (the
# comma split at paren depth 0; empty when the text is not well-formed).
def delta_contract_expr_args(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  let open = delta_char_index(&text, "(", 0)
  if open < 0 then
    return out
  end
  if !text.ends_with(")") then
    return out
  end
  var depth = 0
  var start = open + 1
  var i = open + 1
  while i < text.len() do
    let ch = text.slice(i, i + 1)
    if ch == "(" then
      depth = depth + 1
    elsif ch == ")" then
      if depth == 0 then
        # The top-level close must end the text.
        if i != text.len() - 1 then
          return Vec::new()
        end
        if start < i then
          out.push(text.slice(start, i))
        end
        i = text.len()
      else
        depth = depth - 1
        i = i + 1
      end
    elsif ch == "," && depth == 0 then
      out.push(text.slice(start, i))
      start = i + 1
      i = i + 1
    else
      i = i + 1
    end
  end
  out
end

# The int value of a canonical "int(<n>)" bound text (Option::None for any
# other bound text — floats, non-numeric and malformed bounds never fire).
def delta_contract_int_bound_text(bound: String) -> Option[Int]
  if !bound.starts_with("int(") then
    return Option::None
  end
  if !bound.ends_with(")") then
    return Option::None
  end
  let inner = bound.slice(4, bound.len() - 1)
  if inner.len() == 0 then
    return Option::None
  end
  var neg = false
  var i = 0
  if inner.slice(0, 1) == "-" then
    neg = true
    i = 1
  end
  if i >= inner.len() then
    return Option::None
  end
  var value = 0
  while i < inner.len() do
    let b = inner.slice(i, i + 1).bytes()
    if b.len() == 0 then
      return Option::None
    end
    let byte = b[0] as Int
    if byte < 48 || byte > 57 then
      return Option::None
    end
    value = value * 10 + (byte - 48)
    i = i + 1
  end
  if neg then
    value = -value
  end
  Option::Some(value)
end

# Whether an op word is one of the bound-lattice comparison words.
def delta_contract_compare_op_word(op: String) -> Bool
  op == "bingt" || op == "binge" || op == "binlt" || op == "binle"
end

# The bound-lattice implication between two comparison words over the SAME
# operand with int bounds (lower bounds: > c ⇒ > c' when c >= c'; > c ⇒
# >= c' when c >= c'; >= c ⇒ >= c' when c >= c'; >= c ⇒ > c' when c > c';
# the <-family mirrors with <=). A >-family word never implies a
# <-family word. Callers verify the operand texts and the bound parses.
def delta_contract_bound_implies(op_a: String, op_b: String, ba: Int, bb: Int) -> Bool
  var a_lower = op_a == "bingt" || op_a == "binge"
  var b_lower = op_b == "bingt" || op_b == "binge"
  if a_lower != b_lower then
    return false
  end
  var a_incl = op_a == "binge" || op_a == "binle"
  var b_incl = op_b == "binge" || op_b == "binle"
  if a_lower then
    if ba > bb then
      return true
    end
    ba == bb && (!a_incl || b_incl)
  else
    if ba < bb then
      return true
    end
    ba == bb && (!a_incl || b_incl)
  end
end

# The single-clause implication subset: a ⇒ b for two conjunct-leaves —
# equal canonical texts, or the numeric-bound lattice over the same
# operand. Everything else is not provable.
def delta_contract_single_implies(a: String, b: String) -> Bool
  if a == b then
    return true
  end
  let op_a = delta_contract_expr_op(&a)
  let op_b = delta_contract_expr_op(&b)
  if !delta_contract_compare_op_word(&op_a) || !delta_contract_compare_op_word(&op_b) then
    return false
  end
  let args_a = delta_contract_expr_args(&a)
  let args_b = delta_contract_expr_args(&b)
  if args_a.len() != 2 || args_b.len() != 2 then
    return false
  end
  # The lattice fires only over the SAME operand canonical text.
  if args_a[0] != args_b[0] then
    return false
  end
  let bound_a = delta_contract_int_bound_text(&args_a[1])
  let bound_b = delta_contract_int_bound_text(&args_b[1])
  match bound_a
  when Option::Some(ba) then
    match bound_b
    when Option::Some(bb) then
      delta_contract_bound_implies(&op_a, &op_b, ba, bb)
    when Option::None then false
    end
  when Option::None then false
  end
end

# The canonical conjunct texts of a clause: the "binand" tree flattens
# through nested AND children; any other clause is its own single conjunct
# (an AND under a comparison or a negation is an atom and never
# decomposes). Conjunct identity is the canonical text.
def delta_contract_conjuncts(text: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  if delta_contract_expr_op(&text) != "binand" then
    out.push(text.clone())
    return out
  end
  for arg in delta_contract_expr_args(&text) do
    if delta_contract_expr_op(&arg) == "binand" then
      for sub in delta_contract_conjuncts(&arg) do
        out.push(sub)
      end
    else
      out.push(arg)
    end
  end
  out
end

# The tractable implication prover over two canonical clause texts: a ⇒ b
# iff EVERY conjunct of b is implied by SOME conjunct of a (equal texts, or
# the bound lattice). Sound: ∧(a-conjuncts) ⇒ a-conjunct ⇒ b-conjunct for
# every b-conjunct. Conjunct dropping (x ∧ y) ⇒ x is exactly the case
# where b's conjunct set is a subset of a's; a ⇒ (a ∧ b) never proves.
def delta_contract_expr_implies(a: String, b: String) -> Bool
  let a_conj = delta_contract_conjuncts(&a)
  let b_conj = delta_contract_conjuncts(&b)
  if a_conj.len() == 0 || b_conj.len() == 0 then
    return false
  end
  for cb in b_conj do
    var implied = false
    for ca in a_conj do
      if delta_contract_single_implies(&ca, &cb) then
        implied = true
      end
    end
    if !implied then
      return false
    end
  end
  true
end

# The strengthening/weakening relation between two contract projections of
# one clause position (audit item 17) — see the section doc for the
# per-kind semantics and the prover subset. The relation is
# orientation-NEUTRAL (Strengthened = after ⇒ before, Weakened = before ⇒
# after, whatever the kind); contract_compatibility_of below (third audit
# item 27) maps the relation + kind to the §36 compatibility
# classification.
pub def contract_relation_of(before: Option[ContractSemantic], after: Option[ContractSemantic]) -> ContractRelation
  match before
  when Option::Some(bv) then
    match after
    when Option::Some(av) then
      if bv.kind != av.kind then
        ContractRelation::Incomparable
      elsif bv.canonical_text == av.canonical_text then
        ContractRelation::Equivalent
      else
        let after_implies_before = delta_contract_expr_implies(&av.canonical_text, &bv.canonical_text)
        let before_implies_after = delta_contract_expr_implies(&bv.canonical_text, &av.canonical_text)
        if after_implies_before && before_implies_after then
          ContractRelation::Equivalent
        elsif after_implies_before then
          ContractRelation::Strengthened
        elsif before_implies_after then
          ContractRelation::Weakened
        else
          ContractRelation::Incomparable
        end
      end
    when Option::None then ContractRelation::Weakened
    end
  when Option::None then
    match after
    when Option::Some(_) then ContractRelation::Strengthened
    when Option::None then ContractRelation::Equivalent
    end
  end
end

# The canonical word of a relation (the budget violation rows and the
# behavior-lane rows render the enum through this word).
pub def contract_relation_word(rel: ContractRelation) -> String
  match rel
  when ContractRelation::Equivalent then "Equivalent"
  when ContractRelation::Strengthened then "Strengthened"
  when ContractRelation::Weakened then "Weakened"
  when ContractRelation::Incomparable then "Incomparable"
  end
end

# ———————————————————————————————————————————————————————————————
# The contract-compatibility orientation (third audit item 27)
# ———————————————————————————————————————————————————————————————
# contract_relation_of is orientation-NEUTRAL: for every kind it reports
# Strengthened when after ⇒ before and Weakened when before ⇒ after.
# COMPATIBILITY is not neutral — the caller's obligation sense differs by
# contract kind, so the relation + kind map to the §36 budget's
# compatibility classification:
#
#   kind       relation      compatibility   reason
#   Pre        Strengthened  Breaking        the precondition grew: old
#                                            callers may be illegal
#   Pre        Weakened      Compatible      the precondition shrank: a
#                                            superset of callers passes
#   Post       Weakened      Breaking        the guarantee shrank:
#                                            consumers may rely on the old
#                                            postcondition
#   Post       Strengthened  Compatible      the guarantee only grew
#   Invariant  Strengthened  Breaking        any non-Equivalent invariant
#                                            change breaks the invariant
#   Invariant  Weakened      Breaking        contract (both directions)
#   any        Equivalent    Compatible      no change
#   any        Incomparable  Unknown         not provably safe (fail-closed)
#   unknown    any           Unknown         unknown kind word (fail-closed)
#
# The §36 budget gate is the only consumer: under an evolution-authorized
# budget, Compatible passes while Breaking and Unknown violate; under the
# zero-delta default-refactor policy (allow_contract_evolution = false)
# every non-Equivalent change violates whatever its classification.
enum ContractCompatibility
  Compatible
  Breaking
  Unknown
end

# The compatibility classification of one relation under one contract kind
# word (the table above). The kind words are the canonical clause kind
# renders ("Pre" | "Post" | "Invariant", delta_contract_kind_word).
pub def contract_compatibility_of(kind: String, rel: ContractRelation) -> ContractCompatibility
  match rel
  when ContractRelation::Equivalent then ContractCompatibility::Compatible
  when ContractRelation::Incomparable then ContractCompatibility::Unknown
  when ContractRelation::Strengthened then delta_contract_compat_strengthened(&kind)
  when ContractRelation::Weakened then delta_contract_compat_weakened(&kind)
  end
end

# The Strengthened (after ⇒ before) half of the orientation table.
def delta_contract_compat_strengthened(kind: String) -> ContractCompatibility
  if kind == "Pre" then
    ContractCompatibility::Breaking
  elsif kind == "Post" then
    ContractCompatibility::Compatible
  elsif kind == "Invariant" then
    ContractCompatibility::Breaking
  else
    ContractCompatibility::Unknown
  end
end

# The Weakened (before ⇒ after) half of the orientation table.
def delta_contract_compat_weakened(kind: String) -> ContractCompatibility
  if kind == "Pre" then
    ContractCompatibility::Compatible
  elsif kind == "Post" then
    ContractCompatibility::Breaking
  elsif kind == "Invariant" then
    ContractCompatibility::Breaking
  else
    ContractCompatibility::Unknown
  end
end

# The canonical word of a compatibility classification (the §36 violation
# rows and the orientation lane render the enum through this word).
pub def contract_compatibility_word(c: ContractCompatibility) -> String
  match c
  when ContractCompatibility::Compatible then "Compatible"
  when ContractCompatibility::Breaking then "Breaking"
  when ContractCompatibility::Unknown then "Unknown"
  end
end

# The relationship-row emitter for the CALL rows (triples -> EdgeDelta;
# the row key's from/to parts are the caller/callee endpoint keys).
def delta_call_rows(triples: Vec[(String, String, DeltaKind)]) -> Vec[EdgeDelta]
  var out: Vec[EdgeDelta] = Vec::new()
  for t in triples do
    let parts = delta_key_parts(t.0)
    out.push(EdgeDelta { key: t.0.clone(), kind: t.2, from: parts.0.clone(), to: parts.1.clone() })
  end
  out
end

# Whether the b-side unsafe_facts table carries the fact (Eq over the
# digest words — the stable-id doctrine; Vec scans, never a Set).
def delta_unsafe_has(facts: Vec[UnsafeFact], f: UnsafeFact) -> Bool
  for g in facts do
    if g.digest_hi == f.digest_hi && g.digest_lo == f.digest_lo then
      return true
    end
  end
  false
end

# The unsafe-fact delta (audit item 16): created = the b-side facts absent
# from the a side; removed = the a-side facts absent from the b side. Both
# lists are sorted in the model's digest order (deterministic row order
# for the consumers).
def delta_unsafe_delta_of(a: SemanticSnapshot, b: SemanticSnapshot) -> UnsafeDelta
  var created: Vec[UnsafeFact] = Vec::new()
  for f in b.unsafe_facts do
    if !delta_unsafe_has(&a.unsafe_facts, f) then
      created.push(f.clone())
    end
  end
  created.sort_by(|x, y| semantic_unsafe_fact_lt(x, y))
  var removed: Vec[UnsafeFact] = Vec::new()
  for f in a.unsafe_facts do
    if !delta_unsafe_has(&b.unsafe_facts, f) then
      removed.push(f.clone())
    end
  end
  removed.sort_by(|x, y| semantic_unsafe_fact_lt(x, y))
  UnsafeDelta { created: created, removed: removed }
end

# The canonical marker TEXT of one unsafe fact — "<function> <kind-word>"
# with the site appended as ":<site>" when the fact carries one (the
# snapshot marker vocabulary of the produced kinds: "unsafe-fn",
# "extern-call:<name>", "transmute", "unknown-call:<name>"). Shared by the
# §36 unsafe counting rule and the §37 patch's unsafe_delta rows.
pub def semantic_delta_unsafe_marker_text(f: UnsafeFact) -> String
  var text = f.function.clone() + " " + semantic_unsafe_kind_text(&f.kind)
  if f.site.len() > 0 then
    text = text + ":" + f.site.clone()
  end
  text
end

# The §31 surface-row predicates over the typed AbiDeltaView surfaces
# (public api / abi) — the digest text and the consumers derive the
# changed flag and the symmetric-difference rows from the views.
pub def semantic_delta_rows_same(a_rows: Vec[String], b_rows: Vec[String]) -> Bool
  delta_text_lists_same(&a_rows, &b_rows)
end

pub def semantic_delta_rows_diff(a_rows: Vec[String], b_rows: Vec[String]) -> Vec[String]
  delta_lines_diff(&a_rows, &b_rows)
end

# ———————————————————————————————————————————————————————————————
# The structural signature pairing (audit item 5) — the SAME StableDeclId
# on both sides whose canonical full key text changed describes ONE def
# whose signature changed. The former text-matching pairing
# (delta_sym_pairs over removed/created name parts) is replaced by the
# typed-key classification in semantic_delta_of; the DefKind gate is kept:
# a pair whose payload kind word differs is reported as a remove + create,
# never a signature change.
# ———————————————————————————————————————————————————————————————

# ———— Per-entity flag derivations (the domain slices) ————
# mir rows are keyed by the function's StableDeclId; the effect rows
# compare their TYPED views field-wise; the caps / contract / ownership
# projections compare the per-fn row multisets of the typed row-key sets.

# mir rows: the decl-keyed payload texts differ.
def delta_entity_map_changed(
  a_map: Map[StableDeclId, String],
  b_map: Map[StableDeclId, String],
  a_key: StableDeclId,
  b_key: StableDeclId
) -> Bool
  delta_decl_map_text(&a_map, a_key) != delta_decl_map_text(&b_map, b_key)
end

# The typed effect flag: the fn's §11 view differs between the sides (row
# presence counts: a row present on one side only is a changed effect
# surface even when the summary projection is empty).
def delta_entity_effects_changed(
  a_eff: Map[StableDeclId, EffectRow],
  b_eff: Map[StableDeclId, EffectRow],
  a_key: StableDeclId,
  b_key: StableDeclId
) -> Bool
  let has_a = a_eff.contains_key(&a_key)
  let has_b = b_eff.contains_key(&b_key)
  if has_a != has_b then
    return true
  end
  !delta_effect_views_same(&delta_effect_at(&a_eff, a_key), &delta_effect_at(&b_eff, b_key))
end

# The typed row-multiset flag over two sides' row-key sets (caps /
# contracts): the "<fn-key>|" suffix rows of the two sides differ.
def delta_entity_rowsets_changed(
  a_keys: Vec[StableRowKey],
  b_keys: Vec[StableRowKey],
  a_key: StableDeclId,
  b_key: StableDeclId
) -> Bool
  !delta_text_lists_same(&delta_key_rows_of(&a_keys, a_key), &delta_key_rows_of(&b_keys, b_key))
end

# The ABI-row slice: Function kind both sides, pub on either side, and the
# (pub, generic, mir-row presence) slice or the signature changed.
def delta_entity_abi_changed(
  a_syms: Map[StableDeclId, SymbolRow],
  b_syms: Map[StableDeclId, SymbolRow],
  a_mirs: Map[StableDeclId, String],
  b_mirs: Map[StableDeclId, String],
  a_key: StableDeclId,
  b_key: StableDeclId,
  signature_changed: Bool
) -> Bool
  let pa = delta_key_parts(delta_symbol_payload(&a_syms, a_key))
  let pb = delta_key_parts(delta_symbol_payload(&b_syms, b_key))
  if pa.0 != "Function" || pb.0 != "Function" then
    return false
  end
  if pa.1 != "true" && pb.1 != "true" then
    return false
  end
  if signature_changed then
    return true
  end
  var slice_a = pa.1.clone() + "|" + pa.2.clone() + "|" + delta_bool_text(a_mirs.contains_key(&a_key))
  var slice_b = pb.1.clone() + "|" + pb.2.clone() + "|" + delta_bool_text(b_mirs.contains_key(&b_key))
  slice_a != slice_b
end

# ———— The public-api / abi surface rows (hash-domain reconstructions) ————
# api rows mirror the snapshot writer's public_api rows ("digest kind key" /
# "digest type key" over pub symbol+type rows). abi rows: the snapshot lacks
# the mono-classifier ABI row text, so the abi rows are the pub-Function keys.

def delta_public_api_rows(s: SemanticSnapshot) -> Vec[String]
  var lines: Vec[String] = Vec::new()
  for row in s.symbols do
    if row.is_pub then
      lines.push(semantic_digest_render(&semantic_stable_def_id_digest(&row.stable_id)) + " " +
        semantic_def_kind_text(&row.kind) + " " + row.stable_id.key.clone())
    end
  end
  for trow in s.types do
    if trow.is_pub then
      lines.push(semantic_digest_render(&semantic_stable_def_id_digest(&trow.stable_id)) + " " +
        "type " + trow.stable_id.key.clone())
    end
  end
  lines.sort_by(|x, y| x < y)
  lines
end

def delta_abi_keys(s: SemanticSnapshot) -> Vec[String]
  var keys: Vec[String] = Vec::new()
  for row in s.symbols do
    if row.is_pub && semantic_def_kind_text(&row.kind) == "Function" then
      keys.push(row.stable_id.key.clone())
    end
  end
  keys.sort_by(|x, y| x < y)
  keys
end

# The abi surface row texts of one snapshot (audit item 18): the canonical
# semantic_abi_surface_row_text renders of the persisted abi_surfaces
# table, sorted; the pub-Function key reconstruction is the fallback for
# pre-item-18 snapshots whose table is empty.
def delta_abi_row_texts(s: SemanticSnapshot) -> Vec[String]
  if s.abi_surfaces.len() > 0 then
    var rows: Vec[String] = Vec::new()
    for r in s.abi_surfaces do
      rows.push(semantic_abi_surface_row_text(&r))
    end
    rows.sort_by(|x, y| x < y)
    rows
  else
    delta_abi_keys(s)
  end
end

# The Option text of a per-surface side ("" when absent) — the comparison
# projection used to emit only CHANGED surface rows.
def delta_surface_side_text(o: Option[String]) -> String
  match o
  when Option::Some(t) then t
  when Option::None then "".to_string()
  end
end

# The per-surface before/after row deltas of two snapshots (audit item 18):
# the union of both abi_surfaces surface ids, each changed id carrying its
# canonical row text on each side (None = the surface id is absent from
# that side). Unchanged ids are NOT emitted (the emit-nothing rule); the
# list is sorted by surface id.
#
# RESIDUAL (audit item 5): these two maps are keyed by the abi_surfaces
# SURFACE ID text ("fn:<key>" | "type:<key>") — a protocol identifier
# domain of its own (stable_ids §9's StableAbiSurfaceId stable_key), not a
# §31/§32 semantic-authority table: the maps are function-local scratch,
# live for one comparison, and their values ARE the row texts being
# compared. Re-keying them would require a surface-domain record; the
# stable id type exists (stable_abi_surface_of_key) and can follow up
# without touching the delta's protocol rows.
def delta_abi_surface_row_deltas(a: SemanticSnapshot, b: SemanticSnapshot) -> Vec[AbiSurfaceRowDelta]
  var a_map: Map[String, String] = Map::new()
  var b_map: Map[String, String] = Map::new()
  for r in a.abi_surfaces do
    a_map.insert(r.surface_id.clone(), semantic_abi_surface_row_text(&r))
  end
  for r in b.abi_surfaces do
    b_map.insert(r.surface_id.clone(), semantic_abi_surface_row_text(&r))
  end
  var ids: Vec[String] = Vec::new()
  for r in a.abi_surfaces do
    ids.push(r.surface_id.clone())
  end
  for r in b.abi_surfaces do
    if !a_map.contains_key(&r.surface_id) then
      ids.push(r.surface_id.clone())
    end
  end
  ids.sort_by(|x, y| x < y)
  var out: Vec[AbiSurfaceRowDelta] = Vec::new()
  for id in ids do
    var before: Option[String] = Option::None
    var after: Option[String] = Option::None
    match a_map.get(id.clone())
    when Option::Some(t) then before = Option::Some(t.clone())
    when Option::None then ()
    end
    match b_map.get(id.clone())
    when Option::Some(t2) then after = Option::Some(t2.clone())
    when Option::None then ()
    end
    if delta_surface_side_text(before.clone()) != delta_surface_side_text(after.clone()) then
      out.push(AbiSurfaceRowDelta {
        surface_id: id.clone(),
        before: before,
        after: after
      })
    end
  end
  out
end

# ———— THE DIFF CORE ————

pub def semantic_delta_of(a: SemanticSnapshot, b: SemanticSnapshot) -> SemanticDelta
  var result = semantic_delta_empty()

  # 1. The per-table keyed row maps of both snapshots — ALL keyed by the
  #    typed stable identities (audit item 5): def-keyed rows by
  #    StableDeclId, composite rows by StableRowKey (delta_table_rows /
  #    delta_typed_table_rows). The protocol rows the diff emits render
  #    the canonical text each typed key/row carries.
  var a_syms: Map[StableDeclId, SymbolRow] = Map::new()
  var a_calls: Map[StableRowKey, String] = Map::new()
  var a_mirs: Map[StableDeclId, String] = Map::new()
  var a_effects: Map[StableDeclId, EffectRow] = Map::new()
  var a_caps: Map[StableRowKey, String] = Map::new()
  var a_ownership: Map[StableRowKey, String] = Map::new()
  var a_contracts: Map[StableRowKey, ContractSemantic] = Map::new()
  delta_table_rows(&a, &mut a_syms, &mut a_calls, &mut a_mirs)
  delta_typed_table_rows(&a, &mut a_effects, &mut a_caps, &mut a_ownership, &mut a_contracts)
  var b_syms: Map[StableDeclId, SymbolRow] = Map::new()
  var b_calls: Map[StableRowKey, String] = Map::new()
  var b_mirs: Map[StableDeclId, String] = Map::new()
  var b_effects: Map[StableDeclId, EffectRow] = Map::new()
  var b_caps: Map[StableRowKey, String] = Map::new()
  var b_ownership: Map[StableRowKey, String] = Map::new()
  var b_contracts: Map[StableRowKey, ContractSemantic] = Map::new()
  delta_table_rows(&b, &mut b_syms, &mut b_calls, &mut b_mirs)
  delta_typed_table_rows(&b, &mut b_effects, &mut b_caps, &mut b_ownership, &mut b_contracts)

  # The per-side row-key lists of the typed row maps (the per-entity
  # row-multiset projections below scan these).
  let a_cap_keys = delta_row_keys_of(&a_caps)
  let b_cap_keys = delta_row_keys_of(&b_caps)
  let a_contract_keys = delta_row_keys_of_contracts(&a_contracts)
  let b_contract_keys = delta_row_keys_of_contracts(&b_contracts)

  # 2. The entity classification (symbols) over the StableDeclId union:
  #    a decl present on both sides is COMMON when its canonical full key
  #    text is unchanged, SIGNATURE-CHANGED when the same declaration
  #    carries a different full key (the item-6 split: one declaration,
  #    changed signature — never a remove/create pairing), and otherwise
  #    the created/removed sides keep their full key texts. A same-decl
  #    pair whose DefKind payload differs is never a signature change
  #    (remove + create — the former pairing's kind gate).
  var raw_created: Vec[String] = Vec::new()
  var raw_removed: Vec[String] = Vec::new()
  var common: Vec[StableDeclId] = Vec::new()
  var sig_changed: Vec[StableDeclId] = Vec::new()
  for key in delta_decl_keys_union(&delta_decl_keys_of_syms(&a_syms), &delta_decl_keys_of_syms(&b_syms)) do
    let has_a = a_syms.contains_key(&key)
    let has_b = b_syms.contains_key(&key)
    if has_a && has_b then
      let full_a = delta_symbol_key_text(&a_syms, key.clone())
      let full_b = delta_symbol_key_text(&b_syms, key.clone())
      if full_a == full_b then
        common.push(key.clone())
      else
        let ka = delta_key_parts(delta_symbol_payload(&a_syms, key.clone()))
        let kb = delta_key_parts(delta_symbol_payload(&b_syms, key.clone()))
        if ka.0 == kb.0 && ka.0.len() > 0 then
          sig_changed.push(key.clone())
        else
          raw_removed.push(full_a)
          raw_created.push(full_b)
        end
      end
    elsif has_b then
      raw_created.push(delta_symbol_key_text(&b_syms, key.clone()))
    else
      raw_removed.push(delta_symbol_key_text(&a_syms, key.clone()))
    end
  end
  raw_created.sort_by(|x, y| x < y)
  raw_removed.sort_by(|x, y| x < y)
  let created: Vec[String] = raw_created
  let removed: Vec[String] = raw_removed

  # 3. The modified entities. The domain flags read the TYPED per-key
  #    values (effect views) and the per-fn row-multiset projections of the
  #    typed key sets (caps / contracts / ownership states) under the SAME
  #    typed decl key on both sides.
  var modified: Vec[EntityDelta] = Vec::new()
  for key in common do
    let payload_changed = delta_symbol_payload(&a_syms, key.clone()) !=
      delta_symbol_payload(&b_syms, key.clone())
    let mir_changed = delta_entity_map_changed(&a_mirs, &b_mirs, key.clone(), key.clone())
    let effects_changed = delta_entity_effects_changed(&a_effects, &b_effects, key.clone(), key.clone())
    let caps_changed = delta_entity_rowsets_changed(&a_cap_keys, &b_cap_keys, key.clone(), key.clone())
    let ownership_changed = delta_own_rows_text(&a_ownership, key.clone()) !=
      delta_own_rows_text(&b_ownership, key.clone())
    let contracts_changed = delta_entity_rowsets_changed(&a_contract_keys, &b_contract_keys, key.clone(), key.clone())
    let abi_changed = delta_entity_abi_changed(&a_syms, &b_syms, &a_mirs, &b_mirs,
      key.clone(), key.clone(), false)
    if payload_changed || mir_changed || effects_changed || caps_changed ||
      ownership_changed || contracts_changed || abi_changed then
      modified.push(EntityDelta {
        stable_id: delta_symbol_key_text(&b_syms, key.clone()),
        signature_changed: false,
        mir_changed: mir_changed,
        effects_changed: effects_changed,
        capabilities_changed: caps_changed,
        ownership_changed: ownership_changed,
        contracts_changed: contracts_changed,
        abi_changed: abi_changed,
        kind: DeltaKind::Modified
      })
    end
  end
  for key in sig_changed do
    modified.push(EntityDelta {
      stable_id: delta_symbol_key_text(&b_syms, key.clone()),
      signature_changed: true,
      mir_changed: delta_entity_map_changed(&a_mirs, &b_mirs, key.clone(), key.clone()),
      effects_changed: delta_entity_effects_changed(&a_effects, &b_effects, key.clone(), key.clone()),
      capabilities_changed: delta_entity_rowsets_changed(&a_cap_keys, &b_cap_keys, key.clone(), key.clone()),
      ownership_changed: delta_own_rows_text(&a_ownership, key.clone()) !=
        delta_own_rows_text(&b_ownership, key.clone()),
      contracts_changed: delta_entity_rowsets_changed(&a_contract_keys, &b_contract_keys, key.clone(), key.clone()),
      abi_changed: delta_entity_abi_changed(&a_syms, &b_syms, &a_mirs, &b_mirs,
        key.clone(), key.clone(), true),
      kind: DeltaKind::Modified
    })
  end
  modified.sort_by(|x, y| x.stable_id < y.stable_id)

  # 5. The row-level diffs of the relationship tables (typed per-domain
  #    emitters — audit item 14).
  let call_rows = delta_call_rows(delta_pair_diff(&a_calls, &b_calls))
  let effect_rows = delta_effect_diffs(&a_effects, &b_effects)
  let capability_rows = delta_capability_diffs(&a_caps, &b_caps)
  let ownership_rows = delta_ownership_diffs(&a_ownership, &b_ownership)
  let contract_rows = delta_contract_diffs(&a_contracts, &b_contracts)
  let unsafe_rows = delta_unsafe_delta_of(&a, &b)

  # 6. The public-api / abi surface deltas (typed before/after views —
  #    audit item 14: the full sorted row sets of both sides). The abi
  #    side consumes the persisted abi_surfaces rows (audit item 18) and
  #    additionally carries the per-surface before/after row texts.
  let api_rows_a = delta_public_api_rows(&a)
  let api_rows_b = delta_public_api_rows(&b)
  let abi_rows_a = delta_abi_row_texts(&a)
  let abi_rows_b = delta_abi_row_texts(&b)
  let abi_surface_changes = delta_abi_surface_row_deltas(&a, &b)

  # 7. The affected closure over b's call rows (callers of affected callees;
  #    fixed point capped at the b call-table size). RESIDUAL (audit
  #    item 5): the worklist is keyed by the canonical seed/step TEXTS —
  #    the closure's frontier is a derivative graph walk over the protocol
  #    rows the delta emits (created/removed/modified/affected are TEXT
  #    carriers), not a semantic table; the typed comparison identities
  #    live inside the maps above. The b-side call walk reads the model
  #    snapshot's own canonical caller/callee key texts.
  var in_aff: Map[String, Bool] = Map::new()
  var affected: Vec[String] = Vec::new()
  for key in created do
    if !in_aff.contains_key(&key) then
      in_aff.insert(key.clone(), true)
      affected.push(key.clone())
    end
  end
  for key in removed do
    if !in_aff.contains_key(&key) then
      in_aff.insert(key.clone(), true)
      affected.push(key.clone())
    end
  end
  for entry in modified do
    if !in_aff.contains_key(&entry.stable_id) then
      in_aff.insert(entry.stable_id.clone(), true)
      affected.push(entry.stable_id.clone())
    end
  end
  var grew = true
  var rounds = 0
  while grew && rounds < b.calls.len() do
    grew = false
    for c in b.calls do
      if in_aff.contains_key(&c.callee.key) then
        if !in_aff.contains_key(&c.caller.key) then
          in_aff.insert(c.caller.key.clone(), true)
          affected.push(c.caller.key.clone())
          grew = true
        end
      end
    end
    rounds = rounds + 1
  end
  affected.sort_by(|x, y| x < y)

  result.created = created
  result.removed = removed
  result.modified = modified
  result.call_delta = call_rows
  result.effect_delta = effect_rows
  result.capability_delta = capability_rows
  result.ownership_delta = ownership_rows
  result.contract_delta = contract_rows
  result.unsafe_delta = unsafe_rows
  result.public_api_delta = AbiDeltaView {
    surface_id: "api".to_string(),
    before: AbiSurfaceView { rows: api_rows_a },
    after: AbiSurfaceView { rows: api_rows_b }
  }
  result.abi_delta = AbiDeltaView {
    surface_id: "abi".to_string(),
    before: AbiSurfaceView { rows: abi_rows_a },
    after: AbiSurfaceView { rows: abi_rows_b },
    surface_rows: abi_surface_changes
  }
  result.affected = affected
  result
end

# ———————————————————————————————————————————————————————————————
# The affected closure over the FULL semantic dependency graph (audit item 41)
# ———————————————————————————————————————————————————————————————
# semantic_delta_of's affected closes over the CALL rows only. Audit item 41
# requires the closure over the full semantic dependency graph; the extended
# API below computes the fixed-point closure over EXACTLY the requested
# DependencyEdgeKind classes (semantic_model.tg), from the changed keys (the
# delta's created/removed/modified — the same seeds affected uses) to every
# entity reachable through the requested classes' edges. snapshot MUST be the
# delta's b-side snapshot and index MUST be built from it (the closure reads
# the CURRENT side's edges exactly like affected reads b's call rows).
#
# PER-KIND DATA MATRIX (what each kind traverses, and why). The kinds that
# carry rows in the snapshot's PERSISTED typed dependency graph
# (snapshot.dependencies — third-audit item 18) walk those REAL edge rows;
# NO kind re-parses a rendered canonical string:
#   Call — the snapshot's call rows, walked callee -> caller
#     (index_callers_of): a changed callee affects its callers. FULL data.
#   Implements — the graph's TraitImplEdge + TraitSelectionEdge rows: a
#     changed trait affects its implementors' self types and the impl
#     methods selecting it; a changed self type affects the methods
#     selected for it; a changed impl method affects its self type (the
#     owner-type direction the old owner_of path scan provided). The rows
#     come from the typed ImplInfo records; extension impls (for_type =
#     Param) and methods with no recoverable def key stay out (documented
#     at the producer).
#   TypeUse — the graph's TypeUseEdge rows: a changed used type affects
#     every def/type whose typed signature or field shapes use it. This is
#     the audit's TypeUse class; ContainsType below is its field-level
#     companion.
#   ContainsType / LayoutDependent — the graph's LayoutDependencyEdge rows
#     (typed field/variant containment): a changed contained type affects
#     its container. Both selectors read the same real rows (ContainsType
#     is the historical name of the containment relation; LayoutDependent
#     is the layout-consumer selector) — the old "T[<qname>" signature-text
#     scan is GONE.
#   GenericInstantiation — the graph's GenericInstantiationEdge rows: a
#     changed generic template affects its mono instance bodies (the
#     instance mir row keys).
#   ConstEvalDependent — the graph's ConstEvalDependencyEdge rows
#     (MirStaticRef / MirStaticAddr operands): a changed module const
#     affects every lowering that reads it.
#   DerivedImpl — the graph's DerivedBodyEdge rows (the MirOrigin::Derived
#     effect-dispatcher family): a changed nominal source type affects the
#     derived body that references it.
#   ContractReferences — the graph's ContractReferenceEdge rows (the
#     clause's RESOLVED reference set, collected structurally at clause
#     lowering): a changed referenced def affects the functions owning the
#     referencing clauses. The old canonical-text "path(" token scan is
#     GONE.
#   AbiConsumer — the pub surface: a changed pub Function affects its
#     callers (call rows — the in-snapshot consumers of its ABI); a changed
#     pub TYPE affects every ABI surface whose typed signature/layout
#     references it (the graph's AbiDependencyEdge rows, joined through
#     the surface id to the owning def). Non-pub defs add no ABI edges
#     (their consumers ride Call / ContainsType); surfaces that fail
#     closed carry no typed references and emit no edge.
#   TestReferences — the snapshot's test rows, walked target -> test
#     (index_tests_for_symbol): a changed exercised function affects its
#     tests. FULL data when test rows exist.
#   EffectPropagation — the §11 effect facts propagate to CALLERS through
#     the call graph (the transitive summaries are fixed points over the
#     lowered call graph); the edge data IS the call rows. The kind exists so
#     a caller can request this propagation class alone.
#   CapabilityPropagation — capability facts propagate to callers the same
#     way; edge data = the call rows again.
#
# FALLBACK RULE: a kind whose graph family has NO rows at all in the
# snapshot (an empty table, e.g. a snapshot built before the family's
# producer emitted anything, or a hand-built test fixture that does not
# populate it) falls back to the CALLER CLOSURE (index_callers_of) — the
# documented conservative fallback: the only cross-def edges the snapshot
# always carries. A family WITH rows never falls back, even when the
# changed key has no dependent in it (the real-edge answer). The
# empty-family fallback is a conservative over-approximation, never a
# silent substitution for a family that has data.
#
# ALGORITHM: seeds = the delta's created + removed + modified stable keys.
# The closure is the least fixed point over the UNION of the requested
# kinds' edges, computed by a worklist WITHOUT per-key revisits: a key is
# enqueued at most once; each processed key expands through every requested
# kind exactly once. The iteration cap is the total row count of the
# dependency tables (the sibling b-call-table cap of semantic_delta_of
# generalized to every table the edges read) — BFS reaches every key in
# fewer visits than the cap, so the cap only guards pathological key growth.
# The result is the sorted reachable key list (deterministic whatever the
# insertion order).

def delta_kinds_has(kinds: Vec[DependencyEdgeKind], want: DependencyEdgeKind) -> Bool
  let wn = semantic_dependency_edge_kind_numeric(&want)
  for k in kinds do
    if semantic_dependency_edge_kind_numeric(&k) == wn then
      return true
    end
  end
  false
end

# Append one dependent row under a key, deduped (the index's map-push idiom;
# builds are order-insensitive, readers compare membership only).
def delta_vec_map_push(inout m: Map[String, Vec[String]], key: String, val: String) -> Unit
  match m.get(key.clone())
  when Option::Some(rows) then
    var new_rows = rows.clone()
    if !new_rows.contains(&val) then
      new_rows.push(val)
      m.insert(key, new_rows)
    end
  when Option::None then
    m.insert(key, Vec::from([val]))
  end
  ()
end

# The keyed rows of a string-list map ([] when the key is absent).
def delta_closure_map_dependents(m: Map[String, Vec[String]], key: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match m.get(key.clone())
  when Option::Some(rows) then
    for r in rows do
      out.push(r.clone())
    end
  when Option::None then ()
  end
  out
end

# The pub-Function ABI consumers of one changed key: its callers — the
# in-snapshot consumers of its ABI (real call rows). Non-pub keys add no
# ABI edge here.
def delta_closure_pub_fn_callers(
  pub_fns: Map[String, Bool],
  index: SemanticIndex,
  key: String
) -> Vec[String]
  var out: Vec[String] = Vec::new()
  if pub_fns.contains_key(&key) then
    for caller in index_callers_of(&index, key.clone()) do
      if !out.contains(&caller) then
        out.push(caller.clone())
      end
    end
  end
  out
end

# The owner def key of an ABI surface id ("fn:<key>" / "type:<key>"; ""
# for an id outside the grammar — never produced).
def delta_surface_owner_key(surface_id: String) -> String
  if surface_id.starts_with("fn:") then
    return surface_id.slice(3, surface_id.len())
  end
  if surface_id.starts_with("type:") then
    return surface_id.slice(5, surface_id.len())
  end
  "".to_string()
end

# The typed-surface ABI dependents of one changed key: the owning def keys
# of every AbiDependencyEdge whose type reference is the changed type (the
# graph rows the builder emitted from the surface's typed signature/layout
# references — never from a signature text scan).
def delta_closure_abi_surface_dependents(
  abi_deps: Vec[AbiDependencyEdge],
  key: String
) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for e in abi_deps do
    if e.type_key == key then
      let owner = delta_surface_owner_key(&e.surface_id)
      if owner.len() > 0 && !out.contains(&owner) then
        out.push(owner)
      end
    end
  end
  out
end

# Merge newly reached keys into the closure state (deduped; the queue only
# grows — a key is enqueued at most once).
def delta_closure_absorb(
  inout in_aff: Map[String, Bool],
  inout queue: Vec[String],
  deps: Vec[String]
) -> Unit
  for dep in deps do
    if !in_aff.contains_key(&dep) then
      in_aff.insert(dep.clone(), true)
      queue.push(dep)
    end
  end
  ()
end

# The audit item-41 closure: the sorted keys reachable from the delta's
# changed entities through EXACTLY the requested dependency edge kinds. See
# the section doc for the per-kind data matrix and the residual gaps.
pub def affected_closure(
  delta: SemanticDelta,
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  kinds: Vec[DependencyEdgeKind]
) -> Vec[String]
  # 1. Seeds: the delta's changed keys (the same seed set affected uses).
  var in_aff: Map[String, Bool] = Map::new()
  var queue: Vec[String] = Vec::new()
  for key in delta.created do
    if !in_aff.contains_key(&key) then
      in_aff.insert(key.clone(), true)
      queue.push(key.clone())
    end
  end
  for key in delta.removed do
    if !in_aff.contains_key(&key) then
      in_aff.insert(key.clone(), true)
      queue.push(key.clone())
    end
  end
  for entry in delta.modified do
    if !in_aff.contains_key(&entry.stable_id) then
      in_aff.insert(entry.stable_id.clone(), true)
      queue.push(entry.stable_id.clone())
    end
  end
  if queue.len() == 0 then
    return queue
  end
  if kinds.len() == 0 then
    queue.sort_by(|x, y| x < y)
    return queue
  end

  # 2. The per-kind edge maps, built once per requested class from the
  #    PERSISTED typed dependency graph (snapshot.dependencies — third-
  #    audit item 18). Each family's presence decides real-edge traversal
  #    vs the documented empty-family caller fallback (the section doc's
  #    FALLBACK RULE).
  let want_type_use = delta_kinds_has(&kinds, DependencyEdgeKind::TypeUse)
  let want_impls = delta_kinds_has(&kinds, DependencyEdgeKind::Implements)
  let want_contains = delta_kinds_has(&kinds, DependencyEdgeKind::ContainsType)
  let want_layout = delta_kinds_has(&kinds, DependencyEdgeKind::LayoutDependent)
  let want_generic = delta_kinds_has(&kinds, DependencyEdgeKind::GenericInstantiation)
  let want_const = delta_kinds_has(&kinds, DependencyEdgeKind::ConstEvalDependent)
  let want_derived = delta_kinds_has(&kinds, DependencyEdgeKind::DerivedImpl)
  let want_contracts = delta_kinds_has(&kinds, DependencyEdgeKind::ContractReferences)
  let want_abi = delta_kinds_has(&kinds, DependencyEdgeKind::AbiConsumer)

  let has_type_uses = snapshot.dependencies.type_uses.len() > 0
  let has_layout = snapshot.dependencies.layout_dependencies.len() > 0
  let has_generic = snapshot.dependencies.generic_instantiations.len() > 0
  let has_const = snapshot.dependencies.const_eval_dependencies.len() > 0
  let has_derived = snapshot.dependencies.derived_bodies.len() > 0
  let has_contracts = snapshot.dependencies.contract_references.len() > 0
  let has_abi = snapshot.dependencies.abi_dependencies.len() > 0
  let has_impls = snapshot.dependencies.trait_impls.len() > 0 ||
    snapshot.dependencies.trait_selections.len() > 0

  # TypeUse: used type -> users (defs / types whose typed shapes use it).
  var type_users_of: Map[String, Vec[String]] = Map::new()
  if want_type_use then
    for e in snapshot.dependencies.type_uses do
      delta_vec_map_push(&mut type_users_of, e.used_type.clone(), e.user.clone())
    end
  end

  # ContainsType / LayoutDependent: contained type -> containers (the typed
  # field-containment rows; the two selectors share the family).
  var layout_dependents_of: Map[String, Vec[String]] = Map::new()
  if want_contains || want_layout then
    for e in snapshot.dependencies.layout_dependencies do
      delta_vec_map_push(&mut layout_dependents_of, e.source_type.clone(), e.dependent_type.clone())
    end
  end

  # GenericInstantiation: template -> instance mir row keys.
  var instances_of: Map[String, Vec[String]] = Map::new()
  if want_generic then
    for e in snapshot.dependencies.generic_instantiations do
      delta_vec_map_push(&mut instances_of, e.template.clone(), e.instance_key.clone())
    end
  end

  # ConstEvalDependent: referenced const -> dependent lowering keys.
  var const_dependents_of: Map[String, Vec[String]] = Map::new()
  if want_const then
    for e in snapshot.dependencies.const_eval_dependencies do
      delta_vec_map_push(&mut const_dependents_of, e.referenced_const.clone(), e.dependent.clone())
    end
  end

  # DerivedImpl: source type -> derived body keys.
  var derived_of: Map[String, Vec[String]] = Map::new()
  if want_derived then
    for e in snapshot.dependencies.derived_bodies do
      delta_vec_map_push(&mut derived_of, e.source_type.clone(), e.derived_key.clone())
    end
  end

  # ContractReferences: referenced def -> owning functions, joined through
  # the contract rows (id.stable_key -> function.key). A reference row whose
  # contract row is absent from this snapshot contributes no dependent.
  var contract_users_of: Map[String, Vec[String]] = Map::new()
  if want_contracts then
    var contract_owner_of: Map[String, String] = Map::new()
    for cr in snapshot.contracts do
      contract_owner_of.insert(cr.id.stable_key.clone(), cr.function.key.clone())
    end
    for e in snapshot.dependencies.contract_references do
      match contract_owner_of.get(e.contract_id.clone())
      when Option::Some(owner) then
        delta_vec_map_push(&mut contract_users_of, e.referenced_symbol.clone(), owner.clone())
      when Option::None then ()
      end
    end
  end

  # Implements: trait -> self types and selected methods; self type ->
  # selected methods; selected method -> self type. The synthetic impl_key
  # is the join identity only (never enqueued/dependent).
  var self_functions_of: Map[String, Vec[String]] = Map::new()
  var trait_functions_of: Map[String, Vec[String]] = Map::new()
  var function_selfs_of: Map[String, Vec[String]] = Map::new()
  var trait_selfs_of: Map[String, Vec[String]] = Map::new()
  if want_impls && has_impls then
    var impl_self_of: Map[String, String] = Map::new()
    for e in snapshot.dependencies.trait_impls do
      impl_self_of.insert(e.impl_key.clone(), e.self_type.clone())
      if e.self_type.len() > 0 then
        delta_vec_map_push(&mut trait_selfs_of, e.trait_key.clone(), e.self_type.clone())
      end
    end
    for e2 in snapshot.dependencies.trait_selections do
      delta_vec_map_push(&mut trait_functions_of, e2.trait_key.clone(), e2.function.clone())
      match impl_self_of.get(e2.impl_key.clone())
      when Option::Some(st) then
        if st.len() > 0 then
          delta_vec_map_push(&mut self_functions_of, st.clone(), e2.function.clone())
          delta_vec_map_push(&mut function_selfs_of, e2.function.clone(), st.clone())
        end
      when Option::None then ()
      end
    end
  end

  # AbiConsumer: the pub Function keys (their callers ride the call rows)
  # and the pub TYPE keys (the typed surface rows expand for them only —
  # non-pub types add no ABI edges).
  var pub_fns: Map[String, Bool] = Map::new()
  var pub_types: Map[String, Bool] = Map::new()
  if want_abi then
    for row in snapshot.symbols do
      if row.is_pub && semantic_def_kind_text(&row.kind) == "Function" then
        pub_fns.insert(row.stable_id.key.clone(), true)
      end
    end
    for t in snapshot.types do
      if t.is_pub then
        pub_types.insert(t.stable_id.key.clone(), true)
      end
    end
  end

  # 3. The worklist fixed point over the union of the requested kinds'
  #    edges. Each processed key expands through every requested kind once;
  #    the cap is the total dependency-table row count (the sibling
  #    b-call-table cap generalized — see the section doc).
  let graph_rows = snapshot.dependencies.type_uses.len() +
    snapshot.dependencies.trait_impls.len() +
    snapshot.dependencies.trait_selections.len() +
    snapshot.dependencies.generic_instantiations.len() +
    snapshot.dependencies.layout_dependencies.len() +
    snapshot.dependencies.const_eval_dependencies.len() +
    snapshot.dependencies.derived_bodies.len() +
    snapshot.dependencies.contract_references.len() +
    snapshot.dependencies.abi_dependencies.len()
  var cap = snapshot.calls.len() + snapshot.symbols.len() + snapshot.types.len() +
    snapshot.contracts.len() + snapshot.tests.len() + graph_rows + 1
  var head = 0
  var rounds = 0
  while head < queue.len() && rounds < cap do
    let key = queue[head].clone()
    head = head + 1
    rounds = rounds + 1
    for kind in kinds do
      match kind
      when DependencyEdgeKind::Call then
        delta_closure_absorb(&mut in_aff, &mut queue,
          index_callers_of(&index, key.clone()))
      when DependencyEdgeKind::EffectPropagation then
        delta_closure_absorb(&mut in_aff, &mut queue,
          index_callers_of(&index, key.clone()))
      when DependencyEdgeKind::CapabilityPropagation then
        delta_closure_absorb(&mut in_aff, &mut queue,
          index_callers_of(&index, key.clone()))
      when DependencyEdgeKind::TypeUse then
        if has_type_uses then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&type_users_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::GenericInstantiation then
        if has_generic then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&instances_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::ContainsType then
        if has_layout then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&layout_dependents_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::LayoutDependent then
        if has_layout then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&layout_dependents_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::ConstEvalDependent then
        if has_const then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&const_dependents_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::DerivedImpl then
        if has_derived then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&derived_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::Implements then
        if has_impls then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&trait_selfs_of, key.clone()))
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&trait_functions_of, key.clone()))
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&self_functions_of, key.clone()))
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&function_selfs_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::AbiConsumer then
        delta_closure_absorb(&mut in_aff, &mut queue,
          delta_closure_pub_fn_callers(&pub_fns, &index, key.clone()))
        if has_abi then
          if pub_types.contains_key(&key) then
            delta_closure_absorb(&mut in_aff, &mut queue,
              delta_closure_abi_surface_dependents(&snapshot.dependencies.abi_dependencies, key.clone()))
          end
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::ContractReferences then
        if has_contracts then
          delta_closure_absorb(&mut in_aff, &mut queue,
            delta_closure_map_dependents(&contract_users_of, key.clone()))
        else
          delta_closure_absorb(&mut in_aff, &mut queue,
            index_callers_of(&index, key.clone()))
        end
      when DependencyEdgeKind::TestReferences then
        delta_closure_absorb(&mut in_aff, &mut queue,
          index_tests_for_symbol(&index, key.clone()))
      end
    end
  end
  queue.sort_by(|x, y| x < y)
  queue
end

# ———— The canonical delta text + the content-addressed delta digest ————
# The canonical text form mirrors the snapshot style: line-oriented JSON
# records; every line sorted (the delta emitter already sorts each section;
# the serializer re-sorts the whole row set — the digest is a pure function
# of the delta's content).

def delta_json_key_line(tag: String, key: String) -> String
  "{\"s\":\"" + tag + "\",\"key\":\"" + semantic_json_escape(&key) + "\"}"
end

def delta_entity_line(e: EntityDelta) -> String
  "{\"s\":\"modified\",\"key\":\"" + semantic_json_escape(&e.stable_id) + "\"," +
    "\"sig\":" + delta_bool_text(e.signature_changed) + "," +
    "\"mir\":" + delta_bool_text(e.mir_changed) + "," +
    "\"effects\":" + delta_bool_text(e.effects_changed) + "," +
    "\"caps\":" + delta_bool_text(e.capabilities_changed) + "," +
    "\"ownership\":" + delta_bool_text(e.ownership_changed) + "," +
    "\"contracts\":" + delta_bool_text(e.contracts_changed) + "," +
    "\"abi\":" + delta_bool_text(e.abi_changed) + "}"
end

def delta_edge_line(tag: String, e: EdgeDelta) -> String
  "{\"s\":\"" + tag + "\",\"key\":\"" + semantic_json_escape(&e.key) + "\"," +
    "\"kind\":\"" + delta_kind_text(&e.kind) + "\"," +
    "\"from\":\"" + semantic_json_escape(&e.from) + "\"," +
    "\"to\":\"" + semantic_json_escape(&e.to) + "\"}"
end

def delta_presence_text(p: Presence) -> String
  match p
  when Presence::Present then "Present"
  when Presence::Absent then "Absent"
  end
end

def delta_effect_line(e: EffectDelta) -> String
  "{\"s\":\"effect\",\"key\":\"" + semantic_json_escape(&e.function) + "\"," +
    "\"before\":\"" + semantic_delta_effect_view_text(&e.before) + "\"," +
    "\"after\":\"" + semantic_delta_effect_view_text(&e.after) + "\"}"
end

def delta_capability_line(c: CapabilityDelta) -> String
  "{\"s\":\"capability\",\"key\":\"" + semantic_json_escape(&c.function) + "\"," +
    "\"cap\":\"" + semantic_json_escape(&c.capability) + "\"," +
    "\"before\":\"" + delta_presence_text(&c.before) + "\"," +
    "\"after\":\"" + delta_presence_text(&c.after) + "\"}"
end

def delta_ownership_line(o: OwnershipDelta) -> String
  "{\"s\":\"ownership\",\"key\":\"" + semantic_json_escape(&o.function) + "\"," +
    "\"place\":\"" + semantic_json_escape(&o.place) + "\"," +
    "\"before\":\"" + semantic_json_escape(&o.before) + "\"," +
    "\"after\":\"" + semantic_json_escape(&o.after) + "\"}"
end

def delta_contract_semantic_json(sem: ContractSemantic) -> String
  var msg_text = match sem.message
  when Option::Some(m) then "\"" + semantic_json_escape(&m) + "\""
  when Option::None then "null"
  end
  "{\"kind\":\"" + semantic_json_escape(&sem.kind) + "\"," +
    "\"fp\":\"" + semantic_json_escape(&sem.expression_fingerprint) + "\"," +
    "\"text\":\"" + semantic_json_escape(&sem.canonical_text) + "\"," +
    "\"msg\":" + msg_text + "}"
end

def delta_contract_side_json(prefix: String, side: Option[ContractSemantic]) -> String
  match side
  when Option::Some(sem) then "\"" + prefix + "\":" + delta_contract_semantic_json(&sem)
  when Option::None then "\"" + prefix + "\":null"
  end
end

def delta_contract_line(c: ContractDelta) -> String
  "{\"s\":\"contract\",\"id\":\"" + semantic_json_escape(&c.contract_id) + "\"," +
    delta_contract_side_json("before", &c.before) + "," +
    delta_contract_side_json("after", &c.after) + "}"
end

def delta_unsafe_line(state: String, f: UnsafeFact) -> String
  "{\"s\":\"unsafe\",\"state\":\"" + state + "\"," +
    "\"f\":\"" + semantic_json_escape(&f.function) + "\"," +
    "\"ukind\":\"" + semantic_unsafe_kind_text(&f.kind) + "\"," +
    "\"site\":\"" + semantic_json_escape(&f.site) + "\"," +
    "\"hi\":" + f.digest_hi.to_string() + "," +
    "\"lo\":" + f.digest_lo.to_string() + "}"
end

# The api / abi surface lines of the digest text: the changed flag derives
# from the typed before/after views; the row lines carry the symmetric
# difference of the two sides (empty when the surface is unchanged).
def delta_surface_lines(surface: AbiDeltaView) -> (String, Vec[String])
  var rows: Vec[String] = Vec::new()
  let changed = !semantic_delta_rows_same(&surface.before.rows, &surface.after.rows)
  if changed then
    rows = semantic_delta_rows_diff(&surface.before.rows, &surface.after.rows)
  end
  let flag_line = "{\"s\":\"" + surface.surface_id + "\",\"changed\":" +
    delta_bool_text(changed) + "}"
  (flag_line, rows)
end

# The canonical text form of a delta (sorted, line per record).
def semantic_delta_digest_text(d: SemanticDelta) -> String
  var lines: Vec[String] = Vec::new()
  lines.push("{\"s\":\"header\",\"format\":\"tg-semantic-delta/v1\"}")
  for key in d.created do
    lines.push(delta_json_key_line("created", key))
  end
  for key in d.removed do
    lines.push(delta_json_key_line("removed", key))
  end
  for e in d.modified do
    lines.push(delta_entity_line(&e))
  end
  for e in d.call_delta do
    lines.push(delta_edge_line("call", e))
  end
  for e in d.effect_delta do
    lines.push(delta_effect_line(&e))
  end
  for c in d.capability_delta do
    lines.push(delta_capability_line(&c))
  end
  for o in d.ownership_delta do
    lines.push(delta_ownership_line(&o))
  end
  for c in d.contract_delta do
    lines.push(delta_contract_line(&c))
  end
  for f in d.unsafe_delta.created do
    lines.push(delta_unsafe_line("created", f))
  end
  for f in d.unsafe_delta.removed do
    lines.push(delta_unsafe_line("removed", f))
  end
  let api_surface = delta_surface_lines(&d.public_api_delta)
  lines.push(api_surface.0)
  for row in api_surface.1 do
    lines.push("{\"s\":\"api\",\"row\":\"" + semantic_json_escape(&row) + "\"}")
  end
  let abi_surface = delta_surface_lines(&d.abi_delta)
  lines.push(abi_surface.0)
  for row in abi_surface.1 do
    lines.push("{\"s\":\"abi\",\"row\":\"" + semantic_json_escape(&row) + "\"}")
  end
  for key in d.affected do
    lines.push(delta_json_key_line("affected", key))
  end
  lines.sort_by(|x, y| x < y)
  var text = ""
  for l in lines do
    text = text + l + "\n"
  end
  text
end

# The content-addressed digest of a delta (mirror the snapshot digest: the
# stable digest of the canonical sorted text form).
def semantic_delta_digest(d: SemanticDelta) -> StableDigest
  stable_digest_of(&semantic_delta_digest_text(&d))
end

# ———————————————————————————————————————————————————————————————
# The audit items 17 + 27 behavior rows
# (contract_relation_of + contract_compatibility_of unit-style lane)
# ———————————————————————————————————————————————————————————————
# The item's unit rows, mirrored as documented helper rows (the sibling
# style — the rows are self-checking helpers a behavior lane can call;
# tests/change_budget_test.tg drives this lane):
#   R1  Pre  amount > 0  vs  amount >= 0        -> Weakened
#       (> c ⇒ >= c on the same operand and bound — before ⇒ after is
#       provable; the new pre admits a superset: the precondition kind
#       rule).
#   R2  Post amount > 0  vs  amount >= 0        -> Weakened
#       (the SAME clause change under the postcondition kind rule — the
#       relation labels map the provable implication identically per kind;
#       the row pins the per-kind wording of the item).
#   R3  Invariant amount > 0 vs amount >= 0     -> Weakened (the invariant
#       kind rule row).
#   R4  Pre  (amount > 0) vs amount > 0         -> Equivalent
#       (parens/formatting never reach the canonical text — the clause
#       texts are equal).
#   R5  Pre  amount > 0 vs amount > 0 with a DIFFERING message -> Equivalent
#       (and R4's identical-message twin: the message never participates; a
#       message-only edit is a Modified row that never fires in the budget).
#   R6  Pre  amount > 0  vs  amount > 1000      -> Strengthened
#       (> 1000 ⇒ > 0 provable on the bound lattice — after ⇒ before; the
#       new pre is narrower). The row's contrast: the pair is NOT
#       Incomparable under the lattice — the bounds compare numerically
#       (c' < c in the provable direction).
#   R7  Pre  amount > 0  vs  fee > 0            -> Incomparable
#       (the operand canonical texts differ — the bound rule never fires).
#   R8  Pre  amount > 0  vs  amount == 0        -> Incomparable
#       (bineq is outside the bound lattice — == cases are Incomparable
#       except tree equality).
#   R9  Pre  amount > 0 ∧ amount < 100  vs  amount > 0   -> Weakened
#       ((x ∧ y) ⇒ x: the dropped conjunct weakens the clause — before ⇒
#       after is provable by conjunct containment).
#   R10 Pre  amount > 0  vs  amount > 0 ∧ amount < 100   -> Strengthened
#       (the added conjunct narrows the clause — after ⇒ before; the
#       prover never proves a ⇒ (a ∧ b)).
#   R11 Pre  amount > 0  vs  amount > 1000      -> Strengthened/Breaking
#       (the audit item-27 correction: a stronger precondition breaks old
#       callers — the relation stays Strengthened, the compatibility is
#       Breaking).
#   R12 Pre  amount > 0  vs  amount >= 0        -> Weakened/Compatible
#       (a superset of callers is admitted).
#   R13 Post amount > 0  vs  amount >= 0        -> Weakened/Breaking
#       (a weaker postcondition breaks consumers relying on the old
#       guarantee).
#   R14 Post amount > 0  vs  amount > 1000      -> Strengthened/Compatible
#       (the guarantee only grew).
#   R15 Invariant amount > 0 vs amount >= 0     -> Weakened/Breaking
#       (R16's Strengthened twin below).
#   R16 Invariant amount > 0 vs amount > 1000   -> Strengthened/Breaking
#       (any non-Equivalent invariant change breaks the invariant
#       contract, both directions).
#   R17 Pre  amount > 0  vs  fee > 0            -> Incomparable/Unknown
#       (not provably safe — fail-closed).
# Rows R1-R17 use the canonical op-word texts the snapshot lowering
# produces (comparison words "bin" + lt/le/gt/ge/eq, conjunction "binand",
# operand "ident(...)", bounds "int(<n>)").

# The lane ContractSemantic builder (the fingerprint digests the canonical
# text exactly like the snapshot builder's expression_fingerprint).
def contract_relation_lane_sem(kind: String, text: String, message: Option[String]) -> ContractSemantic
  let fingerprint = semantic_digest_render(&stable_digest_of(&text))
  ContractSemantic {
    kind: kind,
    expression_fingerprint: fingerprint,
    canonical_text: text,
    message: message
  }
end

def delta_contract_relation_same(a: ContractRelation, b: ContractRelation) -> Bool
  match a
  when ContractRelation::Equivalent then
    match b
    when ContractRelation::Equivalent then true
    when _ then false
    end
  when ContractRelation::Strengthened then
    match b
    when ContractRelation::Strengthened then true
    when _ then false
    end
  when ContractRelation::Weakened then
    match b
    when ContractRelation::Weakened then true
    when _ then false
    end
  when ContractRelation::Incomparable then
    match b
    when ContractRelation::Incomparable then true
    when _ then false
    end
  end
end

# Whether two compatibility classifications are the same variant (the
# orientation lane's comparison — relation the same shape as
# delta_contract_relation_same).
def delta_contract_compatibility_same(a: ContractCompatibility, b: ContractCompatibility) -> Bool
  match a
  when ContractCompatibility::Compatible then
    match b
    when ContractCompatibility::Compatible then true
    when _ then false
    end
  when ContractCompatibility::Breaking then
    match b
    when ContractCompatibility::Breaking then true
    when _ then false
    end
  when ContractCompatibility::Unknown then
    match b
    when ContractCompatibility::Unknown then true
    when _ then false
    end
  end
end

# One orientation row (third audit item 27): compare the two projections,
# check the relation AND its kind-specific compatibility classification
# (the R11-R17 rows below). A mismatch records a
# "contract-orientation-lane" row.
def contract_orientation_lane_row(
  inout out: Vec[String],
  kind: String,
  before_text: String,
  after_text: String,
  expected_rel: ContractRelation,
  expected_compat: ContractCompatibility
) -> Unit
  let no_message: Option[String] = Option::None
  let before = Option::Some(contract_relation_lane_sem(&kind, &before_text, &no_message))
  let after = Option::Some(contract_relation_lane_sem(&kind, &after_text, &no_message))
  let got_rel = contract_relation_of(&before, &after)
  if !delta_contract_relation_same(&got_rel, &expected_rel) then
    out.push("contract-orientation-lane " + kind + " " + before_text + " vs " + after_text +
      ": expected relation " + contract_relation_word(&expected_rel) + ", got " +
      contract_relation_word(&got_rel))
  else
    let got_compat = contract_compatibility_of(&kind, &got_rel)
    if !delta_contract_compatibility_same(&got_compat, &expected_compat) then
      out.push("contract-orientation-lane " + kind + " " + before_text + " vs " + after_text +
        ": expected compatibility " + contract_compatibility_word(&expected_compat) + ", got " +
        contract_compatibility_word(&got_compat))
    end
  end
  ()
end

# One expected row: compare the two projections and record any mismatch as
# a "contract-relation-lane" row (the check's output is empty when every
# row verifies — the budget_verify sibling shape).
def contract_relation_lane_row(
  inout out: Vec[String],
  kind: String,
  before_text: String,
  after_text: String,
  before_message: Option[String],
  after_message: Option[String],
  expected: ContractRelation
) -> Unit
  let before = Option::Some(contract_relation_lane_sem(&kind, &before_text, &before_message))
  let after = Option::Some(contract_relation_lane_sem(&kind, &after_text, &after_message))
  let got = contract_relation_of(&before, &after)
  if !delta_contract_relation_same(&got, &expected) then
    out.push("contract-relation-lane " + kind + " " + before_text + " vs " + after_text +
      ": expected " + contract_relation_word(&expected) + ", got " + contract_relation_word(&got))
  end
  ()
end

# Run the R1-R17 rows; the returned list names every mismatch (empty = the
# whole lane verifies). Exported for a behavior lane: the module's rows are
# documented above and the lane function is the executable form.
pub def contract_relation_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let no_message: Option[String] = Option::None
  let positive_message: Option[String] = Option::Some("amount must be positive".to_string())

  # R1/R2/R3 — the bound-lattice row under the Pre / Post / Invariant kind
  # words (per-kind relation semantics; the labels map the provable
  # implication identically for every kind).
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Weakened)
  contract_relation_lane_row(&mut out, "Post",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Weakened)
  contract_relation_lane_row(&mut out, "Invariant",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Weakened)

  # R4 — formatting/parens never reach the canonical text: the two clauses
  # ARE the same canonical row.
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Equivalent)

  # R5 — messages identical vs differing: the message never participates.
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(0))",
    &no_message, &positive_message, ContractRelation::Equivalent)
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(0))",
    &positive_message, &positive_message, ContractRelation::Equivalent)

  # R6 — amount > 0 vs amount > 1000: > 1000 ⇒ > 0 on the bound lattice
  # (after ⇒ before) — Strengthened under the kind rules (NOT Incomparable:
  # the numeric bounds compare in the provable direction).
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(1000))",
    &no_message, &no_message, ContractRelation::Strengthened)

  # R7 — different operand canonical texts: Incomparable.
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(fee),int(0))",
    &no_message, &no_message, ContractRelation::Incomparable)

  # R8 — == is outside the bound lattice: Incomparable except tree equality.
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bineq(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Incomparable)

  # R9/R10 — the AND-conjunct rows: (x ∧ y) ⇒ x by conjunct containment.
  contract_relation_lane_row(&mut out, "Pre",
    "binand(bingt(ident(amount),int(0)),binlt(ident(amount),int(100)))",
    "bingt(ident(amount),int(0))",
    &no_message, &no_message, ContractRelation::Weakened)
  contract_relation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))",
    "binand(bingt(ident(amount),int(0)),binlt(ident(amount),int(100)))",
    &no_message, &no_message, ContractRelation::Strengthened)

  # R11-R17 — the third-audit item-27 orientation mapping: the relation
  # label plus the clause kind decides compatibility. The SAME
  # (before, after) clause texts classify differently per kind — the
  # point of the audit correction.
  contract_orientation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(1000))",
    ContractRelation::Strengthened, ContractCompatibility::Breaking)
  contract_orientation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    ContractRelation::Weakened, ContractCompatibility::Compatible)
  contract_orientation_lane_row(&mut out, "Post",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    ContractRelation::Weakened, ContractCompatibility::Breaking)
  contract_orientation_lane_row(&mut out, "Post",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(1000))",
    ContractRelation::Strengthened, ContractCompatibility::Compatible)
  contract_orientation_lane_row(&mut out, "Invariant",
    "bingt(ident(amount),int(0))", "binge(ident(amount),int(0))",
    ContractRelation::Weakened, ContractCompatibility::Breaking)
  contract_orientation_lane_row(&mut out, "Invariant",
    "bingt(ident(amount),int(0))", "bingt(ident(amount),int(1000))",
    ContractRelation::Strengthened, ContractCompatibility::Breaking)
  contract_orientation_lane_row(&mut out, "Pre",
    "bingt(ident(amount),int(0))", "bingt(ident(fee),int(0))",
    ContractRelation::Incomparable, ContractCompatibility::Unknown)

  out
end

# ———————————————————————————————————————————————————————————————
# The audit item-41 affected-closure lane rows
# ———————————————————————————————————————————————————————————————
# The sibling style (no test-file lane exists for the §31 module; the rows
# are self-checking helpers a behavior lane can call). Each row builds a
# minimal snapshot/delta fixture — including HAND-BUILT rows of the typed
# dependency graph (snapshot.dependencies) where the family is under test —
# runs affected_closure over one (or a union of) DependencyEdgeKind
# class(es) and records a mismatch row when the result differs from the
# documented expectation:
#   L1 — fn A calls fn B (call rows) with a delta pair that modifies B: the
#        KEPT §31 affected (semantic_delta_of's call closure) is {A, B}, and
#        affected_closure over [Call] is identical. The EMPTY-family rows
#        (GenericInstantiation / LayoutDependent / ConstEvalDependent /
#        DerivedImpl with no graph rows) exercise the documented fallback:
#        the caller-closure answer. EffectPropagation and
#        CapabilityPropagation ride the call rows and yield it too.
#   L2 — type T's typed shape contains type U (a LayoutDependencyEdge row):
#        a delta modifying U affects T under [ContainsType] and
#        [LayoutDependent] with NO call edge ([Call] alone yields {U}); a
#        TypeUseEdge row additionally covers the audit's TypeUse class; a
#        graph-LESS twin exercises the empty-family caller fallback.
#   L3 — the TraitImpl/TraitSelection rows (impl of m::Tr for m::T with
#        method m::T::f): a delta modifying the method affects its owner
#        type under [Implements]; a delta modifying the TRAIT affects the
#        self type and the selected method (the former missing direction).
#   L4 — fn F's contract clause carries resolved refs [m::G] and a
#        ContractReferenceEdge row: a delta modifying G affects F under
#        [ContractReferences] (the clause TEXT alone creates no edge).
#   L5 — a test row "TE exercises B": a delta modifying B affects TE under
#        [TestReferences] (the target -> test walk).
#   L6 — ABI consumers: a changed pub Function affects its callers; a
#        changed pub TYPE affects the owning def of every AbiDependencyEdge
#        row that references it; a changed NON-pub type adds no ABI surface
#        edges (the pub gating — the edge row exists but never expands).
#   L7 — a GenericInstantiationEdge row: a delta modifying the generic
#        template affects the mono instance body key.
#   L8 — a ConstEvalDependencyEdge row: a delta modifying the referenced
#        module const affects the referencing lowering.
#   L9 — a DerivedBodyEdge row: a delta modifying the source type affects
#        the derived body key.

def delta_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 8,
    endian: "little".to_string(),
    abi: "lp64".to_string(),
    float_abi: "soft".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def delta_lane_snapshot() -> SemanticSnapshot
  semantic_snapshot_new("lane".to_string(), delta_lane_target())
end

def delta_lane_sid(key: String) -> StableDefId
  stable_def_id_digested(key.clone(), delta_key_name_part(&key))
end

def delta_lane_fn_symbol(key: String, name: String, is_pub: Bool) -> SemanticSymbol
  SemanticSymbol {
    stable_id: delta_lane_sid(&key),
    kind: DefKind::Function,
    name: name,
    module_path: "m".to_string(),
    is_pub: is_pub,
    is_generic: false
  }
end

def delta_lane_type_row(key: String, name: String, kind: SemanticTypeKind, is_pub: Bool) -> SemanticType
  SemanticType {
    stable_id: delta_lane_sid(&key),
    kind: kind,
    name: name,
    module_path: "m".to_string(),
    generic_arity: 0,
    is_pub: is_pub
  }
end

def delta_lane_seed_delta(seeds: Vec[String]) -> SemanticDelta
  var d = semantic_delta_empty()
  d.created = seeds
  d
end

def delta_lane_closure(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  delta: SemanticDelta,
  kind: DependencyEdgeKind
) -> Vec[String]
  var kinds: Vec[DependencyEdgeKind] = Vec::new()
  kinds.push(kind)
  affected_closure(&delta, &snapshot, &index, kinds)
end

def delta_lane_row(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !delta_text_lists_same(&got, &expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

# Run the L1-L6 rows; the returned list names every mismatch (empty = the
# whole lane verifies). Exported for a behavior lane: the rows are
# documented above and this function is their executable form.
pub def affected_closure_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— L1: call fixture (A -> B), delta pair modifies B via a pub flip ————
  let k_a = "m::A#fn()->unit".to_string()
  let k_b = "m::B#fn()->unit".to_string()
  var a1 = delta_lane_snapshot()
  var a1_syms: Vec[SemanticSymbol] = Vec::new()
  a1_syms.push(delta_lane_fn_symbol(&k_a, "A", true))
  a1_syms.push(delta_lane_fn_symbol(&k_b, "B", true))
  a1.symbols = a1_syms
  var a1_calls: Vec[CallEdge] = Vec::new()
  a1_calls.push(CallEdge {
    caller: delta_lane_sid(&k_a),
    callee: delta_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  a1.calls = a1_calls
  var b1 = delta_lane_snapshot()
  var b1_syms: Vec[SemanticSymbol] = Vec::new()
  b1_syms.push(delta_lane_fn_symbol(&k_a, "A", true))
  b1_syms.push(delta_lane_fn_symbol(&k_b, "B", false))
  b1.symbols = b1_syms
  var b1_calls: Vec[CallEdge] = Vec::new()
  b1_calls.push(CallEdge {
    caller: delta_lane_sid(&k_a),
    callee: delta_lane_sid(&k_b),
    kind: CallEdgeKind::Direct
  })
  b1.calls = b1_calls
  let idx1 = build_semantic_index(&b1)
  let d1 = semantic_delta_of(&a1, &b1)
  let l1_call = Vec::from([k_a.clone(), k_b.clone()])

  # The kept §31 semantics and the Call kind agree on the call closure.
  delta_lane_row(&mut out, "affected-call-l1", d1.affected.clone(), l1_call.clone())
  delta_lane_row(&mut out, "closure-call-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::Call), l1_call.clone())

  # The empty-family rows: with NO graph rows for these families the
  # documented conservative fallback yields the caller-closure answer.
  delta_lane_row(&mut out, "closure-empty-generic-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::GenericInstantiation), l1_call.clone())
  delta_lane_row(&mut out, "closure-empty-layout-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::LayoutDependent), l1_call.clone())
  delta_lane_row(&mut out, "closure-empty-const-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::ConstEvalDependent), l1_call.clone())
  delta_lane_row(&mut out, "closure-empty-derived-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::DerivedImpl), l1_call.clone())

  # The propagation classes ride the call rows.
  delta_lane_row(&mut out, "closure-effect-prop-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::EffectPropagation), l1_call.clone())
  delta_lane_row(&mut out, "closure-cap-prop-l1",
    delta_lane_closure(&b1, &idx1, &d1, DependencyEdgeKind::CapabilityPropagation), l1_call.clone())

  # ———— L2: type T's typed shape contains type U ————
  let k_t2 = "m::T#struct{f:T[m::U]}".to_string()
  let k_u2 = "m::U#struct{v:int}".to_string()
  var b2 = delta_lane_snapshot()
  var b2_types: Vec[SemanticType] = Vec::new()
  b2_types.push(delta_lane_type_row(&k_t2, "T", SemanticTypeKind::Struct, false))
  b2_types.push(delta_lane_type_row(&k_u2, "U", SemanticTypeKind::Struct, false))
  b2.types = b2_types
  # The typed graph rows: T's layout contains U; T's shape uses U too.
  var dep2 = SemanticDependencyGraph {}
  dep2.layout_dependencies = Vec::from([
    LayoutDependencyEdge { dependent_type: k_t2.clone(), source_type: k_u2.clone() }
  ])
  dep2.type_uses = Vec::from([
    TypeUseEdge { user: k_t2.clone(), used_type: k_u2.clone() }
  ])
  b2.dependencies = dep2
  let idx2 = build_semantic_index(&b2)
  let d2 = delta_lane_seed_delta(Vec::from([k_u2.clone()]))
  delta_lane_row(&mut out, "closure-contains-l2",
    delta_lane_closure(&b2, &idx2, &d2, DependencyEdgeKind::ContainsType),
    Vec::from([k_t2.clone(), k_u2.clone()]))
  # The layout-only change propagates through the REAL edge with NO call
  # edge in the snapshot: Call alone stays {U}.
  delta_lane_row(&mut out, "closure-layout-l2",
    delta_lane_closure(&b2, &idx2, &d2, DependencyEdgeKind::LayoutDependent),
    Vec::from([k_t2.clone(), k_u2.clone()]))
  delta_lane_row(&mut out, "closure-call-vs-contains-l2",
    delta_lane_closure(&b2, &idx2, &d2, DependencyEdgeKind::Call),
    Vec::from([k_u2.clone()]))
  delta_lane_row(&mut out, "closure-type-use-l2",
    delta_lane_closure(&b2, &idx2, &d2, DependencyEdgeKind::TypeUse),
    Vec::from([k_t2.clone(), k_u2.clone()]))
  var kinds2: Vec[DependencyEdgeKind] = Vec::new()
  kinds2.push(DependencyEdgeKind::Call)
  kinds2.push(DependencyEdgeKind::ContainsType)
  delta_lane_row(&mut out, "closure-union-l2",
    affected_closure(&d2, &b2, &idx2, kinds2),
    Vec::from([k_t2.clone(), k_u2.clone()]))
  # The graph-less twin: the empty family falls back to the caller closure
  # (NO textual containment reconstruction).
  var b2b = delta_lane_snapshot()
  b2b.types = b2_types.clone()
  let idx2b = build_semantic_index(&b2b)
  delta_lane_row(&mut out, "closure-empty-contains-l2",
    delta_lane_closure(&b2b, &idx2b, &d2, DependencyEdgeKind::ContainsType),
    Vec::from([k_u2.clone()]))

  # ———— L3: impl of m::Tr for type T, method m::T::f (Implements) ————
  let k_t3 = "m::T#struct{v:int}".to_string()
  let k_m3 = "m::T::f#fn()->unit".to_string()
  let k_tr3 = "m::Tr#trait{f()}".to_string()
  let impl3 = "impl::" + k_t3.clone() + "|as|" + k_tr3.clone()
  var b3 = delta_lane_snapshot()
  var b3_types: Vec[SemanticType] = Vec::new()
  b3_types.push(delta_lane_type_row(&k_t3, "T", SemanticTypeKind::Struct, false))
  b3_types.push(delta_lane_type_row(&k_tr3, "Tr", SemanticTypeKind::Trait, false))
  b3.types = b3_types
  var b3_syms: Vec<SemanticSymbol> = Vec::new()
  b3_syms.push(SemanticSymbol {
    stable_id: delta_lane_sid(&k_m3),
    kind: DefKind::Method,
    name: "f".to_string(),
    module_path: "m::T".to_string(),
    is_pub: false,
    is_generic: false
  })
  b3.symbols = b3_syms
  var dep3 = SemanticDependencyGraph {}
  dep3.trait_impls = Vec::from([
    TraitImplEdge { impl_key: impl3.clone(), trait_key: k_tr3.clone(), self_type: k_t3.clone() }
  ])
  dep3.trait_selections = Vec::from([
    TraitSelectionEdge { function: k_m3.clone(), trait_key: k_tr3.clone(), impl_key: impl3.clone() }
  ])
  b3.dependencies = dep3
  let idx3 = build_semantic_index(&b3)
  let d3 = delta_lane_seed_delta(Vec::from([k_m3.clone()]))
  delta_lane_row(&mut out, "closure-impls-l3",
    delta_lane_closure(&b3, &idx3, &d3, DependencyEdgeKind::Implements),
    Vec::from([k_t3.clone(), k_m3.clone()]))
  # The former missing direction: a changed TRAIT affects its implementor's
  # self type and the selected method.
  let d3t = delta_lane_seed_delta(Vec::from([k_tr3.clone()]))
  delta_lane_row(&mut out, "closure-impls-trait-l3",
    delta_lane_closure(&b3, &idx3, &d3t, DependencyEdgeKind::Implements),
    Vec::from([k_t3.clone(), k_m3.clone(), k_tr3.clone()]))
  # Graph-less twin: the empty impl family falls back to the caller closure.
  var b3b = delta_lane_snapshot()
  b3b.types = b3_types.clone()
  b3b.symbols = b3_syms.clone()
  let idx3b = build_semantic_index(&b3b)
  delta_lane_row(&mut out, "closure-empty-impls-l3",
    delta_lane_closure(&b3b, &idx3b, &d3, DependencyEdgeKind::Implements),
    Vec::from([k_m3.clone()]))

  # ———— L4: fn F's contract clause references fn G (ContractReferences) ————
  let k_f4 = "m::F#fn()->unit".to_string()
  let k_g4 = "m::G#fn()->unit".to_string()
  let clause4 = "bingt(path(m::G),int(0))".to_string()
  var b4 = delta_lane_snapshot()
  var b4_syms: Vec[SemanticSymbol] = Vec::new()
  b4_syms.push(delta_lane_fn_symbol(&k_f4, "F", false))
  b4_syms.push(delta_lane_fn_symbol(&k_g4, "G", false))
  b4.symbols = b4_syms
  let contract_id4 = "m::F#fn()->unit|Pre|bingt(path(m::G),int(0))".to_string()
  var b4_contracts: Vec[ContractFact] = Vec::new()
  var clause_args4: Vec[String] = Vec::new()
  clause_args4.push("path(m::G)".to_string())
  clause_args4.push("int(0)".to_string())
  # The clause's RESOLVED reference set (the builder resolves the structural
  # path refs; no text scanning anywhere).
  b4_contracts.push(ContractFact {
    id: StableContractId {
      stable_key: contract_id4.clone()
    },
    function: delta_lane_sid(&k_f4),
    kind: AstContractKind::AstPre,
    expression_fingerprint: stable_digest_of(&clause4),
    canonical_expression: ContractExprIR {
      op: "bingt".to_string(),
      args: clause_args4,
      resolved_refs: Vec::from([k_g4.clone()])
    },
    message: Option::None
  })
  b4.contracts = b4_contracts
  var dep4 = SemanticDependencyGraph {}
  dep4.contract_references = Vec::from([
    ContractReferenceEdge { contract_id: contract_id4.clone(), referenced_symbol: k_g4.clone() }
  ])
  b4.dependencies = dep4
  let idx4 = build_semantic_index(&b4)
  let d4 = delta_lane_seed_delta(Vec::from([k_g4.clone()]))
  delta_lane_row(&mut out, "closure-contract-refs-l4",
    delta_lane_closure(&b4, &idx4, &d4, DependencyEdgeKind::ContractReferences),
    Vec::from([k_f4.clone(), k_g4.clone()]))
  # Graph-less twin: the clause text alone creates no edge — the empty
  # family falls back to the caller closure.
  var b4b = delta_lane_snapshot()
  b4b.symbols = b4_syms.clone()
  b4b.contracts = b4_contracts.clone()
  let idx4b = build_semantic_index(&b4b)
  delta_lane_row(&mut out, "closure-empty-contract-l4",
    delta_lane_closure(&b4b, &idx4b, &d4, DependencyEdgeKind::ContractReferences),
    Vec::from([k_g4.clone()]))

  # ———— L5: test TE exercises fn B (TestReferences) ————
  let k_te5 = "m::TE#fn()->unit".to_string()
  let k_b5 = "m::B#fn()->unit".to_string()
  var b5 = delta_lane_snapshot()
  var b5_syms: Vec[SemanticSymbol] = Vec::new()
  b5_syms.push(delta_lane_fn_symbol(&k_te5, "TE", false))
  b5_syms.push(delta_lane_fn_symbol(&k_b5, "B", false))
  b5.symbols = b5_syms
  var b5_tests: Vec[TestRelationship] = Vec::new()
  b5_tests.push(TestRelationship {
    test: delta_lane_sid(&k_te5),
    target: delta_lane_sid(&k_b5)
  })
  b5.tests = b5_tests
  let idx5 = build_semantic_index(&b5)
  let d5 = delta_lane_seed_delta(Vec::from([k_b5.clone()]))
  delta_lane_row(&mut out, "closure-test-refs-l5",
    delta_lane_closure(&b5, &idx5, &d5, DependencyEdgeKind::TestReferences),
    Vec::from([k_b5.clone(), k_te5.clone()]))

  # ———— L6a: a pub Function's ABI consumers are its callers ————
  var b6 = delta_lane_snapshot()
  var b6_syms: Vec[SemanticSymbol] = Vec::new()
  b6_syms.push(delta_lane_fn_symbol(&k_a, "A", false))
  b6_syms.push(delta_lane_fn_symbol(&k_b, "B", true))
  b6.symbols = b6_syms
  b6.calls = a1_calls.clone()
  let idx6 = build_semantic_index(&b6)
  let d6 = delta_lane_seed_delta(Vec::from([k_b.clone()]))
  delta_lane_row(&mut out, "closure-abi-pubfn-l6",
    delta_lane_closure(&b6, &idx6, &d6, DependencyEdgeKind::AbiConsumer),
    Vec::from([k_a.clone(), k_b.clone()]))

  # ———— L6b: a pub TYPE's ABI consumers are its surfaces' owners ————
  let k_u6 = "m::U6#struct{v:int}".to_string()
  let k_f6 = "m::F6#fn(let:T[m::U6])->unit".to_string()
  var b7 = delta_lane_snapshot()
  var b7_types: Vec[SemanticType] = Vec::new()
  b7_types.push(delta_lane_type_row(&k_u6, "U6", SemanticTypeKind::Struct, true))
  b7.types = b7_types
  var b7_syms: Vec<SemanticSymbol> = Vec::new()
  b7_syms.push(delta_lane_fn_symbol(&k_f6, "F6", true))
  b7.symbols = b7_syms
  # The AbiDependencyEdge row the builder emits for F6's pub fn surface
  # (typed signature reference), never a signature-text scan.
  var dep7 = SemanticDependencyGraph {}
  dep7.abi_dependencies = Vec::from([
    AbiDependencyEdge { surface_id: "fn:" + k_f6.clone(), type_key: k_u6.clone() }
  ])
  b7.dependencies = dep7
  let idx7 = build_semantic_index(&b7)
  let d7 = delta_lane_seed_delta(Vec::from([k_u6.clone()]))
  delta_lane_row(&mut out, "closure-abi-pubtype-l6",
    delta_lane_closure(&b7, &idx7, &d7, DependencyEdgeKind::AbiConsumer),
    Vec::from([k_f6.clone(), k_u6.clone()]))

  # ———— L6c: a NON-pub type's edge row never expands (pub gating) ————
  let k_u7 = "m::U7#struct{v:int}".to_string()
  let k_f7 = "m::F7#fn(let:T[m::U7])->unit".to_string()
  var b8 = delta_lane_snapshot()
  var b8_types: Vec<SemanticType> = Vec::new()
  b8_types.push(delta_lane_type_row(&k_u7, "U7", SemanticTypeKind::Struct, false))
  b8.types = b8_types
  var b8_syms: Vec<SemanticSymbol> = Vec::new()
  b8_syms.push(delta_lane_fn_symbol(&k_f7, "F7", false))
  b8.symbols = b8_syms
  var dep8 = SemanticDependencyGraph {}
  dep8.abi_dependencies = Vec::from([
    AbiDependencyEdge { surface_id: "type:" + k_u7.clone(), type_key: k_u7.clone() }
  ])
  b8.dependencies = dep8
  let idx8 = build_semantic_index(&b8)
  let d8 = delta_lane_seed_delta(Vec::from([k_u7.clone()]))
  delta_lane_row(&mut out, "closure-abi-private-type-l6",
    delta_lane_closure(&b8, &idx8, &d8, DependencyEdgeKind::AbiConsumer),
    Vec::from([k_u7.clone()]))

  # ———— L7: a generic template's mono instance (GenericInstantiation) ————
  let k_tpl7 = "m::G7#fn[T]()->unit".to_string()
  let k_inst7 = "instance::m::G7$Int".to_string()
  var b9 = delta_lane_snapshot()
  var b9_syms: Vec<SemanticSymbol> = Vec::new()
  b9_syms.push(delta_lane_fn_symbol(&k_tpl7, "G7", false))
  b9.symbols = b9_syms
  var dep9 = SemanticDependencyGraph {}
  dep9.generic_instantiations = Vec::from([
    GenericInstantiationEdge { instance_key: k_inst7.clone(), template: k_tpl7.clone() }
  ])
  b9.dependencies = dep9
  let idx9 = build_semantic_index(&b9)
  let d9 = delta_lane_seed_delta(Vec::from([k_tpl7.clone()]))
  delta_lane_row(&mut out, "closure-generic-inst-l7",
    delta_lane_closure(&b9, &idx9, &d9, DependencyEdgeKind::GenericInstantiation),
    Vec::from([k_inst7.clone(), k_tpl7.clone()]))
  delta_lane_row(&mut out, "closure-generic-call-vs-l7",
    delta_lane_closure(&b9, &idx9, &d9, DependencyEdgeKind::Call),
    Vec::from([k_tpl7.clone()]))

  # ———— L8: a lowering reads a module const (ConstEvalDependent) ————
  let k_dep8 = "m::dep#fn()->int".to_string()
  let k_c8 = "m::LIMIT#int".to_string()
  var b10 = delta_lane_snapshot()
  var b10_syms: Vec<SemanticSymbol> = Vec::new()
  b10_syms.push(delta_lane_fn_symbol(&k_dep8, "dep", false))
  b10.symbols = b10_syms
  var dep10 = SemanticDependencyGraph {}
  dep10.const_eval_dependencies = Vec::from([
    ConstEvalDependencyEdge { dependent: k_dep8.clone(), referenced_const: k_c8.clone() }
  ])
  b10.dependencies = dep10
  let idx10 = build_semantic_index(&b10)
  let d10 = delta_lane_seed_delta(Vec::from([k_c8.clone()]))
  delta_lane_row(&mut out, "closure-const-eval-l8",
    delta_lane_closure(&b10, &idx10, &d10, DependencyEdgeKind::ConstEvalDependent),
    Vec::from([k_c8.clone(), k_dep8.clone()]))
  delta_lane_row(&mut out, "closure-const-call-vs-l8",
    delta_lane_closure(&b10, &idx10, &d10, DependencyEdgeKind::Call),
    Vec::from([k_c8.clone()]))

  # ———— L9: a derived body references a source type (DerivedImpl) ————
  let k_derived9 = "derived::effect-dispatcher::_effect_dispatcher3".to_string()
  let k_src9 = "m::Payload#struct{v:int}".to_string()
  var b11 = delta_lane_snapshot()
  var b11_types: Vec[SemanticType] = Vec::new()
  b11_types.push(delta_lane_type_row(&k_src9, "Payload", SemanticTypeKind::Struct, false))
  b11.types = b11_types
  var dep11 = SemanticDependencyGraph {}
  dep11.derived_bodies = Vec::from([
    DerivedBodyEdge { derived_key: k_derived9.clone(), source_type: k_src9.clone() }
  ])
  b11.dependencies = dep11
  let idx11 = build_semantic_index(&b11)
  let d11 = delta_lane_seed_delta(Vec::from([k_src9.clone()]))
  delta_lane_row(&mut out, "closure-derived-body-l9",
    delta_lane_closure(&b11, &idx11, &d11, DependencyEdgeKind::DerivedImpl),
    Vec::from([k_derived9.clone(), k_src9.clone()]))
  delta_lane_row(&mut out, "closure-derived-call-vs-l9",
    delta_lane_closure(&b11, &idx11, &d11, DependencyEdgeKind::Call),
    Vec::from([k_src9.clone()]))

  out
end
