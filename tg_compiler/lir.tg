# ———————————————————————————————————————————————————————————————
# Register model
# ———————————————————————————————————————————————————————————————
# Virtual registers are plain Int ids with TWO register classes:
#   ids 0..7     — FIXED (precolored) ABI GENERAL registers x0..x7 on
#                  the aarch64 mode (x0..x3 — r0..r3 — on the cortex-m
#                  AAPCS mode, whose lowering never emits fixed ids
#                  4..7: every parameter/argument index >= 4 takes the
#                  caller stack under that mode — see
#                  lir_arg_reg_count);
#   ids 8..15    — FIXED (precolored) ABI FLOATING-POINT registers
#                  d0..d7 (the SIMD&FP V0..V7 registers; d_i is the low
#                  64 bits of V_i, s_i its low 32 — the float slice
#                  never uses the 128-bit Q forms). They appear only as
#                  the SOURCE of float-parameter entry binds and the
#                  DESTINATION of float call-argument moves (LirFMove
#                  operands — see the statement docs below), never as
#                  allocated vregs; on the cortex-m mode (AAPCS32) they
#                  are the float ABI registers of the same per-class
#                  positional model — float parameters 0..7 bind from
#                  them and float returns cross through id 8 (d0/s0)
#                  since the float-ABI slice (see
#                  lower_mir_fn_to_lir_mode_ty);
#   ids >= 16    — ordinary (allocatable) virtual registers of either
#                  class. The class of an ordinary id is decided ONCE
#                  at lowering: every FLOATING-POINT value (Float/F32/
#                  F64 locals, params, temps) receives a vreg id
#                  recorded in LirFunction.fp_widths (the map is the
#                  class table — an id in it is FP-class and carries
#                  its width; every other ordinary id is a general
#                  register word). Fixed ids are never interval-
#                  allocated: their physical register IS the vreg id
#                  (0..7 -> x0..x7 via lir_reg_a64; 8..15 -> d0..d7 via
#                  lir_fp_reg_a64v).
# This keeps the precolored argument/result traffic disjoint from the
# allocatable pools by construction (invariant I2) in BOTH register
# files: the general pools (x9..x14 / x19..x28) and the floating-point
# pool (d16..d29) never intersect the fixed ABI sets.

# Fixed (precolored) ABI general-register vreg count: ids 0..7 ==
# x0..x7 (aarch64 mode) / r0..r3 (cortex-m mode).
def lir_fixed_vregs() -> Int = 8

# The fixed (precolored) ABI floating-point vregs: ids 8..15 == d0..d7
# (aarch64 mode; on the cortex-m mode they are the float-ABI edge
# registers of the cortex-m float slice — float params 0..7 bind from
# them and float returns cross through id 8 since the float-ABI slice;
# the thumb emitter resolves id 8+k to the d-index k, with an F32
# value riding the low single s = 2k, see backend_thumb.tg's
# thumb_fp_d_of).
def lir_fixed_fp_vregs() -> Int = 8

# The first id of the fixed floating-point ABI block: 8 + k == d_k for
# k in 0..7.
def lir_fixed_fp_base() -> Int = 8

# First ordinary (allocatable) virtual register id: fixed general
# (0..7) plus fixed floating-point (8..15).
def lir_first_alloc_vreg() -> Int = 16

# Is vreg id `id` a fixed (precolored) floating-point ABI vreg (8..15 —
# the physical register IS d_{id-8})? Such ids never appear in the
# def/use occurrence walks (they are excluded by the
# lir_first_alloc_vreg() gate like the fixed general ids) and are
# resolved directly by the float emission helpers.
def lir_is_fixed_fp_id(id: Int) -> Bool
  id >= lir_fixed_fp_base() && id < lir_first_alloc_vreg()
end

# The physical d-register of a fixed floating-point vreg id (8..15):
# id 8 == d0 (A64V::V0), ..., id 15 == d7 (A64V::V7).
def lir_fp_reg_a64v(id: Int) -> A64V
  match id - lir_fixed_fp_base()
  when 0 then A64V::V0
  when 1 then A64V::V1
  when 2 then A64V::V2
  when 3 then A64V::V3
  when 4 then A64V::V4
  when 5 then A64V::V5
  when 6 then A64V::V6
  when 7 then A64V::V7
  when _ then panic("lir_fp_reg_a64v: no register for id " + id.to_string())
  end
end

# The ABI argument-register count of a parameter-fetch mode. The aarch64
# mode (param_stack_mode == false — the default) passes parameter and
# argument indexes 0..7 in the fixed x0..x7 vregs and puts every index
# >= 8 on the caller's stack in 16-byte slots. The cortex-m mode
# (param_stack_mode == true — the AAPCS32 rule this module feeds
# backend_thumb.tg with) passes indexes 0..3 in the fixed r0..r3 vregs
# and puts EVERY index >= 4 on the caller's stack in 4-byte words; the
# lowering therefore never binds a parameter or argument onto fixed
# vregs 4..7 in that mode (see the entry-binding loop and lir_lower_call
# — the mode mirrors the div_ok/width_ok gate pattern: one Bool on the
# lowering context, decided per route at the entry points below).
def lir_arg_reg_count(param_stack_mode: Bool) -> Int
  if param_stack_mode then 4 else 8 end
end

# The canonical frame-pointer offset of a stack-class GENERAL
# parameter or argument at index `i` (>= the mode's arg-register
# count; the word the CALLEE binds at function entry, laid down by the
# CALLER's pushes) — the general-class slots of the per-class walk,
# whose FLOAT-class overflow slots share the same positional stream
# (see the entry-binding walk in lower_mir_fn_to_lir_mode_ty):
#   aarch64 mode: 16 + 16*(i-8) — the callee's x29 frame pointer sits 16
#     bytes below the incoming stack area (the stp fp,lr prologue), so
#     the caller's first 16-byte slot — argument 8 — is at [FP + 16];
#   cortex-m mode: 8 + 4*(i-4) — the AAPCS canonical fp = incoming sp
#     minus the {fp,lr} 8-byte push, so the first stacked general word
#     (the lowest stacked address) is at [FP + 8], the next at
#     [FP + 12], and so on (the formula holds for the route's
#     float-free signatures — the pre-float AAPCS geometry; when float
#     parameters overflow alongside, the walk's shared stream carries
#     the width-aware F32/F64 float words at the same 8 + 4*stk base,
#     and this helper is not used for them).
# The offset payload of a LirLoadFrame statement is exactly this value;
# each backend resolves its own frame pointer against it (see the
# LirLoadFrame statement doc and the thumb emitter).
def lir_stack_arg_offset(param_stack_mode: Bool, i: Int) -> Int
  if param_stack_mode then 8 + 4 * (i - 4) else 16 + 16 * (i - 8) end
end

# The CALLER-SAVED pool: x9..x14 (x15 = address scratch, x16/x17 =
# instruction temporaries, x18 = platform reserved — all four stay
# outside the allocatable pools, and x8 is the sret register of the
# direct emitter — the caller-supplied indirect-return pointer this
# slice's aggregate-return functions save and reload — also never
# allocated). Segments that do not cross a call are allocated from this
# pool; a caller-saved register value that IS live across a call still
# spills to its slot around the call (I2).
def lir_pool_regs() -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  out.push(9)
  out.push(10)
  out.push(11)
  out.push(12)
  out.push(13)
  out.push(14)
  out
end

# The FLOATING-POINT allocatable pool: d16..d29 (the SIMD&FP V16..V29
# registers — caller-saved under AAPCS64, so a register-resident float
# value live across a call spills to its slot around the call exactly
# like the x9..x14 class; the float slice allocates NO callee-saved
# FP registers, so no FP save/restore block ever exists and the
# callee-saved d8..d15 are deliberately never allocated). Pool entries
# are PHYSICAL ids in the FP namespace 100 + (V-register code): the
# allocator's segment/phys fields then can never collide with the
# general-register physical ids (9..14, 19..28) — class predicates
# like lir_is_cc_reg stay safe without per-vreg class tests — and the
# emitter maps them back with lir_fp_reg_of_phys (d_{phys - 100}).
# V30/V31 (phys 130/131) are the FP instruction temporaries (the
# d-register counterparts of X16/X17): never allocated.
def lir_fp_pool_regs() -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  var code = 16
  while code <= 29 do
    out.push(100 + code)
    code = code + 1
  end
  out
end

# The physical d-register of an allocated FP physical id (100 + code).
def lir_fp_reg_of_phys(phys: Int) -> A64V
  let code = phys - 100
  match code
  when 0 then A64V::V0
  when 1 then A64V::V1
  when 2 then A64V::V2
  when 3 then A64V::V3
  when 4 then A64V::V4
  when 5 then A64V::V5
  when 6 then A64V::V6
  when 7 then A64V::V7
  when 8 then A64V::V8
  when 9 then A64V::V9
  when 10 then A64V::V10
  when 11 then A64V::V11
  when 12 then A64V::V12
  when 13 then A64V::V13
  when 14 then A64V::V14
  when 15 then A64V::V15
  when 16 then A64V::V16
  when 17 then A64V::V17
  when 18 then A64V::V18
  when 19 then A64V::V19
  when 20 then A64V::V20
  when 21 then A64V::V21
  when 22 then A64V::V22
  when 23 then A64V::V23
  when 24 then A64V::V24
  when 25 then A64V::V25
  when 26 then A64V::V26
  when 27 then A64V::V27
  when 28 then A64V::V28
  when 29 then A64V::V29
  when 30 then A64V::V30
  when 31 then A64V::V31
  when _ then panic("lir_fp_reg_of_phys: no register for physical id " + phys.to_string())
  end
end

# The FP instruction temporaries: V30 is the def-target temp for
# memory-resident FP defs (the X16 counterpart) and V31 the spill-load
# temp / constant-bits scratch (the X17 counterpart). Both are outside
# the FP pool (V30/V31 are never allocated), free at every FP
# statement position.
def lir_fp_def_temp() -> A64V = A64V::V30
def lir_fp_use_temp() -> A64V = A64V::V31

# The CALLEE-SAVED pool: x19..x28 (the AAPCS64 callee-saved set the
# aarch64 route may use for values live across calls — the callee
# preserves them, so such values ride the call in the register at the
# price of one 8-byte frame slot each for the prologue/epilogue
# save/restore; see the call-crossing rule in lir_alloc_registers_mode).
def lir_cc_pool_regs() -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  out.push(19)
  out.push(20)
  out.push(21)
  out.push(22)
  out.push(23)
  out.push(24)
  out.push(25)
  out.push(26)
  out.push(27)
  out.push(28)
  out
end

# Is aarch64 register id `id` one of the callee-saved pool registers?
# (Segment/call-boundary handling uses this class test; it must agree
# exactly with lir_cc_pool_regs' range.)
def lir_is_cc_reg(id: Int) -> Bool
  id >= 19 && id <= 28
end

def lir_reg_a64(id: Int) -> A64
  # Fixed GENERAL vreg ids (0..7), pool/temp/scratch general registers
  # (x9..x28 by id). FIXED FLOAT vreg ids (8..15) belong to the FP file
  # and are resolved by lir_fp_reg_a64v — never through this function
  # (a fixed float id reaching it is a lowering divergence).
  match id
  when 0 then A64::X0
  when 1 then A64::X1
  when 2 then A64::X2
  when 3 then A64::X3
  when 4 then A64::X4
  when 5 then A64::X5
  when 6 then A64::X6
  when 7 then A64::X7
  when 8 then A64::X8
  when 9 then A64::X9
  when 10 then A64::X10
  when 11 then A64::X11
  when 12 then A64::X12
  when 13 then A64::X13
  when 14 then A64::X14
  when 15 then A64::X15
  when 16 then A64::X16
  when 17 then A64::X17
  when 18 then A64::X18
  when 19 then A64::X19
  when 20 then A64::X20
  when 21 then A64::X21
  when 22 then A64::X22
  when 23 then A64::X23
  when 24 then A64::X24
  when 25 then A64::X25
  when 26 then A64::X26
  when 27 then A64::X27
  when 28 then A64::X28
  when 29 then A64::FP
  when 30 then A64::LR
  when _ then panic("lir_reg_a64: no register for id " + id.to_string())
  end
end

# P1-14 slice 1: the LIR backend's accessor for the CANONICAL target
# description (audit P1-14 — data-driven target data; target_desc.tg is
# the single source, driver.tg's LIR route consults this accessor at its
# gate). This backend is aarch64-only for the current slices, so the
# description is aarch64_desc(). The register-model constants above
# (lir_fixed_vregs / lir_pool_regs / lir_cc_pool_regs / lir_reg_a64 —
# fixed precolored x0-x7, caller-saved pool x9-x14, callee-saved pool
# x19-x28, scratch x15-x17) remain authoritative for THIS slice's
# emission; they migrate onto desc fields (arg_regs / reg_caller_saved)
# in a later slice, with no emission behavior change here.
def lir_target_desc() -> TargetDesc
  aarch64_desc()
end

# ———————————————————————————————————————————————————————————————
# LIR IR — Slice 1
# ———————————————————————————————————————————————————————————————
# Machine-width arithmetic: 64-bit words on aarch64 for this slice. The
# sized integer types (I8/I16/I32/U8/U16/U32, ISize/USize) share the
# full-word model — their MIR width affects only narrowing IntToInt
# casts (canonical AND masks) and signedness-driven op selection (see
# the module header's WIDTH MODEL); the direct emitter's local slots are
# full words too, so spill slots stay the allocator's per-vreg 8-byte
# homes, FP-relative (emitted as load/store code at the points the
# allocation decides — never implicit).

struct LirBlock
  id: Int
  stmts: Vec[LirStmt]
  term: LirTerm
end

# One by-value aggregate PARAMETER's entry-binding record (the
# aggregate-param slice — see the sret-return slice section's sibling
# note below): an admitted parameter whose image binds through an image
# ADDRESS — an address-class plain-struct parameter whose image takes
# an ADDRESS-class ABI category (exactly 16 bytes — ScalarPair — or more
# than 8 bytes — ByAddress; the shape gate admits exactly these shapes
# on the aarch64 program route) OR a PAYLOADED tagged-enum parameter
# (the LIR-internal enum ABI — the payloaded image's mirror shape keys
# the same lir_agg_sret_words test) — consumes ONE ABI arg slot — its
# GENERAL-class position among all parameters (the per-class ABI walk:
# general scalars and aggregate-address words share the x-file
# numbering; float parameters consume the separate d-file positions
# and never advance this counter — for signatures without float
# parameters the GP position equals the parameter's index, the
# codegen.tg classify_argument order) — and receives the image's
# ADDRESS in that slot. The callee-side binding is machine-level, at
# function entry: the
# emitter loads the address from the slot (x_slot for slots 0..7, the
# caller's 16-byte stack slot [FP + 16 + 16*(slot-8)] beyond — the
# scalar-parameter geometry; a stack-class parameter's slot field
# carries the 8+stk encoding, stk = the parameter's position in the
# shared caller-stack stream) and copies shape.words whole words from
# [addr + 8*k] into the parameter aggregate's fixed frame slots
# (base_slot + k, at [FP - 8 - 8*(base_slot + k)]), so the parameter
# then behaves exactly like an aggregate local. Lowering records one
# entry per such parameter, in parameter declaration order; the
# copy never goes through a virtual register (aggregate parameters have
# no scalar vreg — they are not in LirFunction.params). The
# WORD-binding parameters NEVER produce a record here: a PAYLOAD-LESS
# TAGGED-ENUM parameter's raw-
# discriminant tag word and a one-word (Scalar-class) plain-struct
# parameter's single word cross in their ONE slot like a scalar word
# and bind through the entry STATEMENTS (see the binding walk). The
# record is kind-agnostic — words/base_slot/slot are all the machine
# level reads, so the payloaded-enum and plain-struct forms share it
# with no kind field.
struct LirAggParamBind
  slot: Int       # the parameter's GENERAL-class ABI slot (0..7: the
                  # register x_slot the image address arrives in; 8+stk:
                  # the caller-stack word at [FP + 16 + 16*stk])
  base_slot: Int  # first 8-byte frame slot of the parameter aggregate's
                  # fixed-slot area (the ctx.agg_of slot assignment)
  words: Int      # shape.words whole words copied at entry
end

# One caller-side aggregate ARGUMENT record (the aggregate-argument
# slice — the CALLER-side mirror of LirAggParamBind, see the sret-return
# slice section's paragraph on by-value aggregate arguments): an
# admitted plain-struct argument (a whole plain-struct local with empty
# projections, carried by MIR as MirCallValue::Place, or as a place-
# like Value operand over the constructed temporary's whole local) OR a
# whole PAYLOADED tagged-enum argument (the LIR-internal enum ABI —
# the caller-side mirror of the payloaded-enum parameter binding)
# consumes ONE ABI
# arg slot — its GENERAL-class position among ALL call arguments (the
# per-class ABI walk of lir_lower_call; float arguments never advance
# it) — and the slot carries the ADDRESS of the source
# aggregate word-group's first frame slot (base_slot, at [FP - 8 -
# 8*base_slot]; the source local is stack-homed by the fixed-slot
# rule). The aggregate never rides a virtual register: lowering records
# one entry per aggregate argument of a call, keyed by the term's block
# id on LirFunction.agg_call_args (the sret_call_slots pattern), and
# the aarch64 call emitter forms the address at the call site — x_slot
# for register-class slots (slot 0..7), the reserved caller word at
# [SP + 16*(slot-8)] == [SP + 16*stk] for stack-class slots (the 8+stk
# encoding — mirroring the sret x8 lea emission (after the pre-call
# spill stores, right before the branch). The WORD-crossing arguments
# never produce a record: a PAYLOAD-LESS TAGGED-ENUM
# argument's tag word and a one-word (Scalar-class) plain-struct
# argument's single word cross BY VALUE in
# the argument's ONE slot through the ordinary scalar-argument move
# path (the caller-side mirror of the payload-less enum parameter
# binding). The record is kind-agnostic — slot/base_slot are all the
# machine level reads — so the payloaded-enum form shares it with the
# plain-struct form with no kind field.
struct LirAggCallArg
  slot: Int       # the argument's GENERAL-class ABI slot (0..7: the
                  # register x_slot the source address travels in;
                  # 8+stk: the reserved caller word at [SP + 16*stk])
  base_slot: Int  # first 8-byte frame slot of the source aggregate's
                  # fixed-slot area (the ctx.agg_of slot assignment)
end

struct LirFunction
  name: String
  # (P1-18 @cold) The DECLARED code-layout hint, stamped from the MIR
  # function at lowering (MirFunction.attr_cold — recorded from the
  # item's attribute list by mir.tg's lower_program PASS 2; see
  # codegen.tg's codegen_function @cold consumption point). It is
  # ADVISORY — no correctness rule depends on it. The routes' whole-
  # program drivers emit attr_cold functions in a DEFERRED pass (after
  # the runtime merge) so their bodies form the contiguous cold tail of
  # the code stream, and the per-route symbol registrations
  # (lir_emit_fn / thumb_emit_fn_symbol / rv_emit_fn_symbol) route them
  # into the cold section (Section::ColdText — the object writers
  # emit .text.cold with real bytes from the tail).
  attr_cold: Bool = false
  # Total virtual-register count (ids 0..vregs-1; 0..7 are fixed ABI
  # general registers and 8..15 the fixed ABI float registers d0..d7).
  vregs: Int
  # The FLOATING-POINT class table (the float slice): ordinary vreg id
  # -> its float width, one entry per FP-class ordinary vreg (locals,
  # parameters and lowering temporaries of the Float/F32/F64 types).
  # The map is the class authority for ordinary ids: an id in it is
  # FP-class (spill slots hold its width's image; allocation picks the
  # d-register pool; emission uses the SIMD&FP encoders), an id absent
  # from it is a general word. Fixed ids 0..7 (general) and 8..15
  # (float) are classes by construction and never appear here. Empty
  # for functions without float values (including every riscv-rv
  # function — its gate rejects float types; the cortex-m route's gate
  # admits float locals since the float-body slice and float params/
  # returns since the float-ABI slice, so its float functions carry
  # records here).
  fp_widths: Map[Int, LirFpWidth] = Map::new()
  # Parameter virtual registers, in ABI order. ABI class derives from
  # the per-class walk AND the route's parameter-fetch mode (fixed at
  # lowering; a LIR function is never shared between modes): on the
  # aarch64 mode a general parameter at GP position i < 8 is x_i
  # (register class) and i >= 8 the caller's stack slot
  # [FP + 16 + 16*(i-8)] (stack class), a float parameter at FP
  # position i the d_i register class; on the cortex-m mode (the AAPCS
  # entry lower_mir_fn_to_lir_cm) a general parameter at GP position
  # i < 4 is r_i and i >= 4 the
  # caller's stack word [FP + 8 + 4*(i-4)] of the shared stream, a
  # float parameter at FP position i < 8 the d_i register class and
  # i >= 8 the width-aware AAPCS float word of the same shared stream
  # (see the entry-binding walk in lower_mir_fn_to_lir_mode_ty). Every
  # parameter vreg is
  # ordinary (allocatable) on both modes — the fixed vregs 0..7 and
  # 8..15 appear
  # only as the SOURCE of the register-class binds and the DESTINATION
  # of register-class call-argument moves. Aggregate parameters have no
  # scalar vreg and are NOT in this list (address-class plain-struct
  # parameters AND payloaded tagged-enum parameters bind at machine
  # level — see agg_params; payload-less
  # tagged-enum parameters bind through entry statements into their
  # fixed tag-word vreg, also absent here).
  params: Vec[Int]
  # The return-slot virtual register (the value MirReturn returns) when
  # the function's return type is a scalar; aggregate-return functions
  # (sret and one-word Scalar-class alike — the Scalar-class set
  # includes the payload-less tagged-enum returns) carry Option::None
  # (their return aggregate lives in fixed frame slots — the sret
  # copy-out rides the sret fields below, and the Scalar-class return
  # word is read from its fixed slot by each Ret term, which carries
  # the word's fixed vreg — see the sret fields below and the LirRet
  # doc).
  ret_vreg: Option[Int]
  blocks: Vec[LirBlock]
  entry_block: Int
  # Aggregate-slice frame state (plain-struct AND tagged-enum locals):
  # agg_slots is the
  # number of 8-byte slots the function's aggregate locals occupy — the
  # aggregate slot region holds indexes 0..agg_slots-1 and every vreg
  # spill slot is numbered from agg_slots up (see
  # lir_alloc_registers_mode). agg_word_slots maps each aggregate image
  # word's
  # FIXED virtual register to its slot index: those vregs are pure
  # memory (never register-resident), their segments carry phys = -1 and
  # this preassigned slot, and their defs store / uses load through the
  # ordinary spill machinery. Both fields are empty (0) for functions
  # without aggregate locals.
  agg_slots: Int = 0
  agg_word_slots: Map[Int, Int] = Map::new()
  # sret-return state (the per-function sret record — see the sret-return
  # slice section): when the function's return type is an admitted
  # aggregate with an sret image — a plain struct (exactly 16 bytes —
  # the ScalarPair class — or more than 8 bytes — the ByAddress class;
  # see lir_agg_sret_words) OR a payloaded tagged-enum image (the
  # LIR-internal enum ABI, whose mirror shape keys the same test) —
  # sret_words is the number of whole 8-byte words
  # every Ret copies from the return aggregate's fixed frame slots to
  # the caller-supplied x8 buffer, and sret_base_slot is the first slot
  # of the return aggregate's slot area (locals[0] is the first local,
  # so the area opens the aggregate region at base_slot 0 — the copy
  # reads [FP - 8 - 8*(sret_base_slot + k)] for k in 0..sret_words-1).
  # Both stay 0 for scalar/Unit returns, on the routes whose gate
  # rejects aggregates, for one-word (Scalar-class, <= 8 bytes)
  # aggregate images — those cross in x0, so no x8 state exists: each
  # Ret carries the return word's fixed vreg and the emitter's ordinary
  # load-to-x0 handles it (see the LirRet doc), and the payload-less
  # tagged-enum's tag-word image is exactly such a one-word return.
  sret_words: Int = 0
  sret_base_slot: Int = 0
  # Caller-side sret-return state (see the sret-return slice section's
  # caller-side paragraph): block id -> the destination aggregate's
  # base_slot, one entry per CALL whose destination is a whole
  # aggregate local with an sret image — a plain-struct image or a
  # payloaded tagged-enum image under the LIR-internal enum ABI (the
  # callee's return crosses
  # through x8). The block id keys the term (every block carries exactly
  # one terminator), and the base_slot is the aggregate-slot index whose
  # FP offset — lir_slot_offset(base_slot) == [FP - 8 - 8*base_slot] —
  # the call emitter materializes in x8 right before the branch; the
  # term's dest is None for such calls (no scalar result to capture).
  # Empty on functions without such call sites (including every thumb/
  # rv function — their gate rejects aggregate locals, so no entry can
  # ever lower there).
  sret_call_slots: Map[Int, Int] = Map::new()
  # By-value aggregate-parameter binding records (the aggregate-param
  # slice — see LirAggParamBind): one entry per admitted parameter
  # whose image binds through an image address — an address-class
  # plain-struct parameter (16-byte ScalarPair /
  # ByAddress over 8 bytes — the parameter-side mirror of the sret
  # admission above) or a payloaded tagged-enum parameter (the
  # LIR-internal enum ABI), in parameter declaration order. The aarch64
  # emitter's function-entry prologue reads this list and copies each
  # parameter's words from its incoming image into its fixed frame
  # slots. Empty on scalar-only functions, on the routes whose gate
  # rejects aggregates (thumb/rv/cortex-m — their emitters never read
  # it), and on a64 entries without the program type-def table.
  agg_params: Vec[LirAggParamBind] = Vec::new()
  # Caller-side aggregate-argument records (the aggregate-argument
  # slice — see LirAggCallArg): block id -> the aggregate arguments of
  # that block's call terminator, in argument order, one entry per
  # admitted by-reference aggregate argument — an address-class
  # plain-struct argument (16-byte ScalarPair / ByAddress over 8 bytes
  # — the caller-side
  # mirror of the aggregate-param admission above) or a payloaded
  # tagged-enum argument (the LIR-internal enum ABI); the one-word
  # (Scalar-class) plain-struct and payload-less tagged-enum arguments
  # cross BY VALUE through the ordinary scalar-argument path and never
  # record here. The aarch64
  # emitter's call arm reads this list and places each source
  # word-group's frame address into the argument's ABI slot right
  # before the branch (x_slot for slots 0..7, the reserved caller word
  # for slots >= 8). Empty on functions without such call sites
  # (including every thumb/rv/a64-no-table function — their gate
  # rejects aggregate locals, so no aggregate argument can ever lower
  # there).
  agg_call_args: Map[Int, Vec[LirAggCallArg]] = Map::new()
end

enum LirValue
  LirReg(Int)   # a virtual register (fixed id 0..7, or an ordinary id)
  LirImm(Int)   # 64-bit immediate payload
end

# Comparison condition: signed forms plus the unsigned aarch64 forms
# (unsigned LT = LO/cc, LE = LS, GT = HI, GE = HS/cs). Unsignedness is
# decided at lowering from the MIR operand types, never re-derived.
enum LirCond
  LirEq
  LirNe
  LirLt
  LirLe
  LirGt
  LirGe
  LirUlt
  LirUle
  LirUgt
  LirUge
end

enum LirBinOp
  LirAdd
  LirSub
  LirMul
  LirAnd
  LirOr
  LirXor
  LirShl
  LirAsr     # signed (arithmetic) shift right
  LirLsr     # unsigned (logical) shift right
end

enum LirUnOp
  LirNeg
  LirBitNot
end

# The width of a floating-point value: F32 (single precision — values
# ride d/s registers in canonical single form: the low 32 bits of the
# S register, so every S-form op rounds exactly once under the default
# FPCR) or F64 (double — Float and F64 types share it; Float is this
# compiler's legacy name for the 8-byte double). The width of an
# ordinary FP vreg lives in LirFunction.fp_widths; float statements
# that need the width at emission time (binops, compares, casts,
# constants) carry it explicitly as a payload (LirFMove does not: its
# two operands are always the same width, resolved from the ordinary
# operand's class record).
enum LirFpWidth
  LirF32
  LirF64
end

# Floating-point arithmetic statement ops (single/double dispatch is
# the statement's LirFpWidth payload). Strict IEEE-754 semantics under
# the P1-6 STRICT spec (types.tg): exactly-one rounding per op, no
# contraction, no reassociation, subnormals preserved, RNE default —
# the identical emission for strict and @fp(fast) functions until
# fp_fast-gated fast paths land (mirroring codegen.tg's float
# emission, where @fp(fast) currently records the per-function mode
# without changing the instruction stream).
enum LirFpBinOp
  LirFAdd
  LirFSub
  LirFMul
  LirFDiv
end

enum LirStmtKind
  # dst vreg <- Reg(vreg)|Imm
  LirMove(Int, LirValue)
  # op, dst vreg, left operand (register), right operand (reg or imm)
  LirBinop(LirBinOp, Int, LirValue, LirValue)
  # op, dst vreg, src vreg
  LirUnop(LirUnOp, Int, Int)
  # sets NZCV (invariant I1); left register, right reg or imm
  LirCmp(LirValue, LirValue)
  # dst = (flags satisfy cond) ? 1 : 0 — reads the flags of the most
  # recent LirCmp in program order (I1)
  LirCset(LirCond, Int)
  # Load the stack-parameter word at canonical frame-pointer offset
  # `off` into dst (used only to bind parameters at function entry).
  # The offset is route-correct by construction — lir_stack_arg_offset
  # with the lowering's parameter-fetch mode:
  #   aarch64 mode: the 8-byte word at [FP + off], off = 16 + 16*(i-8),
  #     binding parameters at index i >= 8;
  #   cortex-m mode: the 4-byte word at [FP + off], off = 8 + 4*(i-4),
  #     binding general parameters at index i >= 4 (AAPCS32 — indexes
  #     4..7 have no register; every general parameter beyond r0..r3
  #     arrives on the caller's stack). A
  #     FLOAT stack parameter (a float beyond the d0..d7 register
  #     file) binds through the same statement shape with an
  #     FP-class dst (the parameter's ordinary vreg in fp_widths):
  #     the load reads the value's WIDTH at the offset — 4 bytes for
  #     an F32 (the caller's str s), 8 bytes for an F64 (str d) — and
  #     the offset is the walk's width-aware AAPCS32 float offset
  #     (see the mixed-overflow arithmetic in the entry-binding walk
  #     of lower_mir_fn_to_lir_mode_ty), never the general-class
  #     formula above. On the aarch64 mode a float at FP position
  #     p >= 8 binds the shared positional stream the same way: its
  #     16-byte caller slot sits at [FP + 16 + 16*stk] (one slot per
  #     stacked parameter of either class, in argument order — the
  #     fp-class dst makes the load read the value's width at the
  #     slot base).
  LirLoadFrame(Int, Int)
  # dst <- the MACHINE WORD at the static symbol `sym` (the whole-program
  # static references of the LIR slice — the MirStaticRef lowering; see
  # the statics section below). The symbol is a program static's emission
  # name (the .data/.bss symbol the route's whole-program entry emitted —
  # or, on the thumb/rv routes, its .data image); the statement lowers to
  # an address materialization + one machine-word load per route:
  #   aarch64: ADRP+ADD (R_AARCH64_ADR_PREL_PG_HI21 +
  #     R_AARCH64_ADD_ABS_LO12_NC — the direct emitter's emit_lea_label
  #     pair) then LDR;
  #   cortex-m (thumb): MOVW+MOVT (R_ARM_THM_MOVW_ABS_NC +
  #     R_ARM_THM_MOVT_ABS — the absolute-address pair of the ELF ARM
  #     ABI) then LDR;
  #   riscv: LUI+ADDI (R_RISCV_HI20 + R_RISCV_LO12_I — the
  #     rv_li-style absolute pair of the RV psABI medlow model) then
  #     LD (xlen 8) / LW (xlen 4).
  # The route's data layout pads every static image with zeros to the
  # route's word boundary and starts each image at the route's word
  # alignment, so the full-word load of a narrower declared type (Bool,
  # sized integers on the width-ok routes) reads the zero-extended
  # canonical word — the direct emitter's static-read image (the data
  # bytes mirror codegen_static's). The load is emitted exactly like a
  # register def (memory-resident defs use the route's def temp and
  # store the slot afterwards).
  LirStaticLoad(Int, String)
  # Caller-side stack argument: reserve the argument's caller-slot word
  # below SP and store the value there. The slot geometry is a property
  # of the lowering's mode (never mixed within one LIR function):
  #   aarch64 mode: one 16-byte slot per statement (the codegen.tg
  #     caller-slot convention; statements cover argument indexes >= 8,
  #     emitted in DESCENDING index order);
  #   cortex-m mode: one 4-byte word per statement (the AAPCS32 caller
  #     convention; statements cover argument indexes >= 4, emitted in
  #     DESCENDING index order — argument 4 is the LAST push, so it sits
  #     at the lowest address, [SP] at the branch — with the alignment
  #     padding of lir_lower_call keeping the word count even).
  # An aggregate stack-class ARGUMENT's slot is reserved by the same
  # statement shape (the source's first-word vreg rides as a
  # placeholder value — the LirCall term's aggregate-argument emission
  # overwrites the reserved word with the source address right before
  # the branch, so the placeholder never reaches the callee).
  # A FLOATING-POINT argument (a vreg recorded in the function's
  # fp_widths) stores its value at the slot's base address at the
  # value's width — 8 bytes (str d) for F64, the low 4 bytes (str s)
  # for an F32 canonical single — the callee's entry bind reads the
  # same width from the same base ([FP + 16 + 16*stk] on the aarch64
  # mode: a float beyond d0..d7 joins the shared positional stream —
  # one 16-byte slot per stacked argument of either class — and the
  # cortex-m mode's width-aware AAPCS32 caller pushes are the next
  # slice). The upper bytes of an F32's 16-byte caller slot are never
  # read.
  LirPushArg(Int)
  # FLOATING-POINT statements (the float slice): a dst/src Int is an
  # FP vreg — a FIXED ABI vreg id 8..15 (d0..d7) or an ordinary vreg
  # id >= 16 recorded in LirFunction.fp_widths (the width map is the
  # FP class table). They lower on the aarch64 route and — in the
  # register-resident envelope of its float-slice arms — on the
  # cortex-m route (whose gate admits float locals and, since the
  # float-ABI slice, float parameters/returns — the entry binds of the
  # latter reach this emitter as LirFMove statements from the fixed
  # d0..d7 vregs; the riscv-rv shape
  # gate still rejects every float type, so no float statement ever
  # reaches that emitter; its exhaustive match fails closed on the
  # variants below with rule-naming errors).
  # FP register move dst <- src (same width on both sides; FMOV s/d).
  # The fixed ABI ids appear here as the SOURCE of float-parameter
  # entry binds (dst is the parameter's ordinary vreg) and as the
  # DESTINATION of float call-argument moves (src is the argument's
  # ordinary vreg) — never as both, so the emission width always
  # resolves from the ordinary operand's class record.
  LirFMove(Int, Int)
  # Floating-point arithmetic dst = left op right (three register
  # operands — lowering materializes float constants into registers;
  # FADD/FSUB/FMUL/FDIV under the statement's width).
  LirFBinop(LirFpBinOp, LirFpWidth, Int, Int, Int)
  # dst = -src (FNEG s/d).
  LirFNeg(LirFpWidth, Int, Int)
  # Compare two float registers (FCMP s/d) — writes NZCV exactly like
  # LirCmp (invariant I1: the allocator inserts only flag-neutral code
  # between it and its LirCset consumer); ordered IEEE semantics under
  # the strict spec, the six LirCond conditions EQ/NE/Lt(MI)/Le(LS)/
  # Gt/Ge reading the flags exactly as codegen.tg's float compares do
  # (a NaN operand sets no condition except NE).
  LirFCmp(LirFpWidth, Int, Int)
  # Materialize a float constant's 64-bit BITS into dst. F64: the bits
  # ARE the double's bit pattern (the MirFloat value is the compiler's
  # host double — codegen.tg's MirFloat materialization, mov+store+
  # load, compressed into fmov d, xn). F32: the bits are the double
  # bit pattern of the literal and the emission rounds it to the
  # canonical single under the default FPCR (fcvt s, d) — the single
  # rounding all F32 arithmetic applies, and the only rounding an F32
  # constant ever receives (the compiler performs no host-side float
  # math).
  LirFConst(LirFpWidth, Int, Int)
  # Signed/unsigned 64-bit integer word -> float: fdst = (float) gsrc
  # (SCVTF/UCVTF under the statement's width — the codegen.tg
  # IntToFloat aarch64 shape, width-corrected: the 64-bit-source S/D
  # forms).
  LirIntToFloat(LirFpWidth, Int, Int, Bool)
  # Float -> signed 64-bit integer word: gdst = (int) fsrc (FCVTZS Xd
  # from the statement width's S/D register — the P1-6 trap-free
  # truncation rule: NaN -> 0, out-of-range saturates).
  LirFloatToInt(LirFpWidth, Int, Int)
  # Float <-> float width cast: fdst = (w2) fsrc, w2 = the dst vreg's
  # class width, w1 = src_w != w2 (FCVT: single->double exact
  # widening, double->single exactly-once RNE rounding).
  LirFcvt(LirFpWidth, Int, Int)
end

# aarch64-slice division op codes carried on LirStmt.div (see the
# struct). Deliberately NOT LirBinOp variants: LirBinOp/LirStmtKind are
# matched exhaustively by the thumb/rv LIR backends (a hard
# exhaustiveness error the moment a variant appears), so the division
# reuses the two-register LirBinop(MUL, dst, num, den) shape and only
# the aarch64 emitter (lir_emit_stmt) interprets the marker — SDIV/UDIV
# for the signed/unsigned operand pair. Only the aarch64 lowering route
# (lower_mir_fn_to_lir_a64) produces marked DIVISION statements, so the
# thumb/rv routes never receive one (the POINTER/ATOMIC markers of
# LirStmt.ptr, by contrast, reach the cortex-m and riscv routes once
# their atomic surfaces open — see the LirPtrOp section).
enum LirDivOp
  LirSdiv   # signed quotient: a64 SDIV (Int operands)
  LirUdiv   # unsigned quotient: a64 UDIV (UInt operands)
end

# The register-CLASS BIT-MOVE marker (see LirStmt.bm): a marked
# statement moves the bit pattern of one register file into the other
# — the aarch64 route's int<->float TRANSMUTE machinery and the F32/F64
# word crossings of the float slice:
#   LirBitsGpToFp — carrier LirUnop(dst = FP-class vreg, src = GP word
#     vreg): FMOV d/s from the general register (a64_fmov_dx /
#     a64_fmov_sw — the S-form reads the source word's low 32 bits,
#     exactly the F32 canonical single image);
#   LirBitsFpToGp — carrier LirUnop(dst = GP word vreg, src = FP-class
#     vreg): FMOV x/w from the FP register (a64_fmov_xd /
#     a64_fmov_ws — the W form zero-extends the S bits into the full
#     word, the width model's canonical zero-extended narrow word).
# The width is never carried: it resolves from the FP-class record
# (LirFunction.fp_widths) of the FP-side operand at emission time, so
# a bit move never changes width — the GP side is always the word that
# holds the exact-width bit image (64 bits for F64, the low 32 for
# F32). The marker rides the LirStmt struct (never a LirStmtKind
# variant) for exactly the LirStmt.div reason: LirStmtKind is matched
# exhaustively by the thumb/rv LIR backends, and the aarch64 emitter
# dispatches the marker before any nominal emission (lir_emit_fn).
# Only the aarch64 route's lowering produces marked statements (the
# transmute arms and the float-field crossings), so the thumb/rv
# emitters never receive one; the cortex-m route's float slice keeps
# its fail-closed transmute rejection.
enum LirBitMoveOp
  LirBitsGpToFp
  LirBitsFpToGp
end

# The pointer/atomic-slice statements (see the LirStmt.ptr marker
# field — emitted by the aarch64 emitter as LSE/load/store
# instructions, by the thumb emitter as ARMv7-M LDREX/STREX/DMB
# sequences, and by the riscv emitter as A-extension LR/SC + FENCE
# sequences once the cortex-m/riscv atomic surfaces open; the
# DIVISION markers of LirStmt.div are a separate aarch64-only slice).
# Every variant's vreg payloads are GPR word vregs; the
# statements are flag-neutral (invariant I1 — none writes NZCV) and
# perform no call (they never interact with the call-spill machinery):
#   LirPtrLea(dst, off) — dst = FP + off: the ADDRESS of a fixed frame
#     slot (a fixed-slot scalar local forced to memory by an address-of,
#     or an aggregate local's slot area). The offset is a static
#     lir_slot_offset (always negative); the emitter's lea handles the
#     full 64-bit offset range via the X15 scratch.
#   LirPtrAddr(dst, base, off) — dst = base + off: the ADDRESS of a
#     place inside a pointed-to image (a MirRef over a deref place with
#     a nonzero field byte offset). It is an explicit marked form — not
#     a plain LirBinop add — so the MADD/MSUB fusion probe never
#     confuses it with an arithmetic product+immediate add.
#   LirPtrLoad(dst, base, off, w, sign) — dst = load(base + off): the
#     register-indirect deref READ of a scalar place. `base` is the
#     address word's vreg; `off` the place's byte offset within the
#     pointed-to image; `w` the STORAGE width in bytes (1/2/4/8) of the
#     loaded value; `sign` requests sign extension into the canonical
#     word for the signed narrow types (the codegen.tg sized-load mirror
#     — the direct emitter's sign rules; unsigned/8-byte loads
#     zero-extend).
#   LirPtrStore(base, off, src, w) — store(base + off) = src: the
#     register-indirect deref WRITE of a scalar place (`w` = the storage
#     width in bytes; the store keeps the value's low w bytes).
#   LirAtomLoad(form, w, dst, addr) — ONE arm of an atomic load's
#     per-ordering dispatch: dst = atomic_load(addr), form 0 = the plain
#     LDR width form (Relaxed), form 1 = the LDAR width form (Acquire/
#     SeqCst — an acquire load; the per-ordering block dispatch selects
#     the arm). `w` = the atomic's width in bytes (1/2/4/8).
#   LirAtomStore(form, w, addr, val) — ONE arm of an atomic store's
#     per-ordering dispatch: atomic_store(addr) = val, form 0 = plain
#     STR (Relaxed), form 1 = STLR (Release/SeqCst — the SC store).
#   LirAtomRmw(family, form, w, dst, addr, val) — ONE arm of an atomic
#     RMW/exchange's per-ordering dispatch: dst = the OLD value of the
#     LSE operation family `family` (0 = LDADD, 1 = LDCLR (the
#     complemented AND), 2 = LDSET (OR), 3 = LDEOR (XOR), 4 = SWP
#     (exchange)) at ordering form `form` (0 = plain, 1 = acquire +A,
#     2 = release +L, 3 = acq_rel/seq_cst +AL) on [addr] with the value
#     operand val. The old value lands zero-extended in dst (the LSE
#     register discipline: the statement's emitter keeps the address,
#     value and result registers pairwise distinct — CONSTRAINED
#     UNPREDICTABLE per the ARM ARM).
#   LirAtomCas(form, w, dst, exp, des, addr) — ONE arm of an atomic
#     compare_exchange's per-ordering dispatch: the CAS Xs, Xt, [Xn]
#     form (form codes as above) compares [addr] with the EXPECTED value
#     exp; when equal, des is stored. The instruction returns the
#     ORIGINAL [addr] through its Xs register, which the emitter
#     resolves to the statement's dst def (the old value; the lowering's
#     merge tail compares it against a preserved expected copy and
#     writes it back through the expected slot on the failure path).
#   LirPtrFence(form) — ONE arm of the widthless per-ordering fence
#     dispatch (__intrinsic_atomic_fence; the fence is the atomic
#     slice's only intrinsic without the _u<width> suffix): form 0 =
#     the Acquire arm — DMB ISHLD (the load-acquire barrier); form 1 =
#     the Release/AcqRel/SeqCst arm — the FULL DMB ISH (the codegen
#     fence arm's mapping: a release fence must also keep later loads
#     from being observed before the prior stores, a store->load
#     crossing that the store-store-only DMB ISHST does NOT prevent, so
#     the full barrier serves Release/AcqRel/SeqCst — and the
#     out-of-domain orders deterministically take this strongest arm).
#     Relaxed NEVER constructs a statement: the codegen fence arm emits
#     no instruction for it — the static-ordering lowering pushes
#     nothing and the runtime-ordering dispatch routes order code 0
#     straight to the success block.
# The def/use shapes (recorded by lir_stmt_occ_full — the marker-aware
# walker lir_linearize consults):
#   LirPtrLea: def dst.  LirPtrLoad: def dst, use base.
#   LirPtrStore: use base, use src.  LirAtomLoad: def dst, use addr.
#   LirAtomStore: use addr, use val.  LirAtomRmw: def dst, use addr,
#   use val.  LirAtomCas: def dst, use exp, use des, use addr.
#   LirPtrAddr: def dst, use base.  LirPtrFence: no defs, no uses (a
#   pure instruction side effect).
# (The nominal kinds of the marked statements never reach a backend
# validator's nominal semantics — the thumb and riscv validators
# check the MARKER first and their nominal walks tolerate every
# carrier shape (the riscv LirCmp arm is marker-aware: the fence
# even rides a compare of two immediates, the one LirStmtKind
# payload that references no vreg at all). The thumb validator's
# thumb_validate_ptr_stmt enforces
# the cortex-m surface (widths 1/2/4, per-form order codes, vreg/
# offset geometry) and its emitter translates each marker into the
# ARMv7-M exclusive/barrier sequence; the riscv validator's
# rv_validate_ptr_stmt enforces the RISC-V surface (the A extension's
# word/doubleword LR/SC widths, per-form order codes, vreg geometry)
# and its emitter translates each marker into the LR/SC + FENCE
# sequences — see the pointer/atomic emission sections of
# backend_thumb.tg and backend_rv.tg.)
enum LirPtrOp
  LirPtrLea(Int, Int)
  LirPtrAddr(Int, Int, Int)
  LirPtrLoad(Int, Int, Int, Int, Bool)
  LirPtrStore(Int, Int, Int, Int)
  LirAtomLoad(Int, Int, Int, Int)
  LirAtomStore(Int, Int, Int, Int)
  LirAtomRmw(Int, Int, Int, Int, Int, Int)
  LirAtomCas(Int, Int, Int, Int, Int, Int)
  LirPtrFence(Int)
end

# The storage-width code of a ptr/atomic statement width in bytes
# (1/2/4/8) mapped onto the aarch64 load/store/LSE size field ([31:30]:
# 0 = byte, 1 = halfword, 2 = word, 3 = doubleword — the codegen.tg
# a64_atomic_size_code mirror).
def lir_atomic_size_code(width: Int) -> u32
  match width
  when 1 then 0
  when 2 then 1
  when 4 then 2
  when 8 then 3
  when _ then 3
  end
end

# The RMW family code of an atomic op name (codegen.tg's
# emit_a64_rmw_ordered family mapping): fetch_sub/sub_fetch negate the
# value FIRST (the lowering emits the LirUnop(LirNeg) prep — the
# subtraction is the atomic add of -v; the low-width agreement of the
# full-word neg is the codegen rule) and fetch_and/and_fetch complement
# it first (LirUnop(LirBitNot) — LDCLR clears the bits SET in its
# operand); the family codes are the LirAtomRmw payloads above.
def lir_atomic_rmw_family(op: String) -> Option[Int]
  match op
  when "exchange" then Option::Some(4)
  when "fetch_add" | "add_fetch" then Option::Some(0)
  when "fetch_sub" | "sub_fetch" then Option::Some(0)
  when "fetch_and" | "and_fetch" then Option::Some(1)
  when "fetch_or" | "or_fetch" then Option::Some(2)
  when "fetch_xor" | "xor_fetch" then Option::Some(3)
  when _ then Option::None
  end
end

# Does the op need the value-operand PREP (the negation of
# fetch_sub/sub_fetch, the complement of fetch_and/and_fetch)?
def lir_atomic_rmw_prep(op: String) -> Option[LirUnOp]
  match op
  when "fetch_sub" | "sub_fetch" then Option::Some(LirUnOp::LirNeg)
  when "fetch_and" | "and_fetch" then Option::Some(LirUnOp::LirBitNot)
  when _ then Option::None
  end
end

# The *_fetch merge-op of an atomic op name: Option::Some(binop) for
# add_fetch/sub_fetch/and_fetch/or_fetch/xor_fetch (the destination is
# old <op> val, computed by the dispatch's merge tail — codegen.tg's
# post-LSE X0/X9/X1 arithmetic), Option::None for the fetch_*/exchange
# forms (their LSE result IS the destination).
def lir_atomic_fetch_binop(op: String) -> Option[LirBinOp]
  match op
  when "add_fetch" then Option::Some(LirBinOp::LirAdd)
  when "sub_fetch" then Option::Some(LirBinOp::LirSub)
  when "and_fetch" then Option::Some(LirBinOp::LirAnd)
  when "or_fetch" then Option::Some(LirBinOp::LirOr)
  when "xor_fetch" then Option::Some(LirBinOp::LirXor)
  when _ then Option::None
  end
end

struct LirStmt
  kind: LirStmtKind
  # aarch64-slice division marker: Option::Some(op) makes this statement
  # an integer division dst = num / den with kind == the Mul shape above
  # (both operands registers — lowering materializes constants). The
  # generic def/use walks and the allocator need no changes because the
  # Mul shape already carries two reads and one write; the emitter
  # dispatches SDIV/UDIV on the marker instead of MUL.
  div: Option[LirDivOp]
  # pointer/atomic-slice marker (the pointer/atomic slice — see
  # the module header and the marker's section): Option::Some(op) makes
  # this statement one of the register-indirect memory / frame-address /
  # atomic statements of LirPtrOp, whatever the nominal kind is. Same
  # reasoning as LirStmt.div: LirStmtKind is matched exhaustively by the
  # thumb/rv LIR backends (a hard exhaustiveness error the moment a
  # variant appears), so the pointer/atomic slice rides this marker on
  # the LirStmt struct instead. The aarch64 whole-program lowering
  # (the a64 routes, whose shape gates admit pointer words) produces
  # marked statements, and so do the cortex-m route (cm_atomics) and
  # the riscv route (rv_atomics) once their atomic surfaces open —
  # their shape gates admit the same pointer words at the route's
  # machine word and their emitters translate the markers (the
  # thumb/rv/cortex-m routes reject every pointer form before any
  # statement lowers ONLY while the surface flag is closed); the SHARED walks (lir_linearize's
  # def/use collection, lir_stmt_reads_reg, the MADD/MSUB fusion probe)
  # consult the marker and use the marker's own def/use shape — the
  # nominal kind's shape would be wrong for every marked statement that
  # is not arity-compatible with its nominal kind (the nominal kinds are
  # chosen arity-nearest purely for the exhaustive matches: LirPtrLea
  # rides LirCset's def-only shape, the marked loads/atomics ride
  # LirUnop/LirBinop/LirCmp shapes as documented on the enum above, and
  # the payload-less fence rides LirCmp's shape with immediate
  # operands (no vreg payloads at all).
  ptr: Option[LirPtrOp] = Option::None
  # register-class BIT-MOVE marker (the float slice's int<->float
  # transmute / word-crossing statements — see LirBitMoveOp): a marked
  # statement is a register-file bit move whose carrier is the
  # arity-compatible LirUnop shape (def dst, use src). The aarch64
  # emitter dispatches the marker before any nominal semantics
  # (lir_emit_fn); the shared walks need no changes because the LirUnop
  # def/use shape already matches the move's. Mutually exclusive with
  # the div/ptr markers by construction (the lowering never combines
  # them). The cortex-m/thumb route never receives a marked statement:
  # the aarch64-only lowering gates keep the cm float slice's
  # fail-closed rejection.
  bm: Option[LirBitMoveOp] = Option::None
end

struct LirSwitchArm
  value: Int
  target: Int
end

enum LirTermKind
  LirJump(Int)                            # target block id
  LirSwitch(Int, Vec[LirSwitchArm], Int)  # vreg, arms, default block
  # Some(vreg): load the value to x0; None: bare return. A scalar
  # function's Ret carries the return scalar's vreg; a FLOAT-returning
  # function's Ret carries the return float's vreg (the emitter moves
  # it to the FP return register V0 at its width — d0 for F64/Float,
  # s0 for F32 — on the aarch64 route; on the cortex-m route the same
  # statement shape carries the float return of the cm float-ABI
  # slice, the value crossing in the VFP return register d0/s0 (fixed
  # float vreg 8 — the emitter-side arm is pending with the call-side
  # slice)); a Scalar-class
  # (<= 8-byte, one-word) aggregate-return function's Ret carries the
  # return word's FIXED memory-home vreg — the ordinary load-to-x0
  # resolves it through the spill machinery, so its one word crosses in
  # x0 exactly like a scalar (a payload-less tagged-enum return is
  # exactly this: the tag word IS the direct crossing value). An sret
  # (16-byte / > 8-byte
  # aggregate-return) function — an sret-class plain-struct image OR a
  # payloaded tagged-enum image under the LIR-internal enum ABI — has a
  # Ret that is always None: its copy-out to
  # the caller's x8 buffer is function-wide state on LirAlloc, emitted
  # by the Ret arm of lir_emit_term.
  LirRet(Option[Int])
  LirTrap
  # Direct call: target = the callee's emission name; args = the arg
  # vregs (GENERAL-class register args are moved into the fixed ABI
  # x-regs by LirMove statements, FLOAT-class register args into the
  # fixed d-regs by LirFMove statements, and every
  # stack-class arg is pushed via LirPushArg statements in DESCENDING
  # stack-position order immediately before this terminator — the
  # per-class walk decides the classes, see lir_lower_call); stack_args
  # = the number of
  # pushed caller-slot units — 16-byte slots on the aarch64 mode
  # (stack-class positions beyond the register files), 4-byte words on
  # the cortex-m mode
  # (always EVEN — lir_lower_call pads odd AAPCS
  # word counts so the caller's SP is 8-byte aligned at the branch) —
  # and the emitter adds that many slot units back to SP right after
  # the call; dest = the result vreg (Some when
  # the callee's return type is a scalar OR a one-word Scalar-class
  # plain struct OR a payload-less tagged enum OR a FLOAT — the
  # emitter captures x0 into the
  # general destination / V0 at its width into the float destination
  # after the call; for
  # the aggregate form the vreg is the destination's single word's
  # fixed memory-home vreg, whose post-call def stores the slot, so the
  # destination local is defined exactly like a one-word scalar
  # destination); success = the MirCall success block (jumped to
  # after the dest write). A call whose destination is a WHOLE
  # aggregate local with an sret image — a whole
  # plain-struct local OR a whole payloaded tagged-enum local under the
  # LIR-internal enum ABI — lowers with dest = None — no
  # scalar result exists — and records the destination's frame slot on
  # LirFunction.sret_call_slots (keyed by the term's block id), which
  # makes the emitter form &dest in x8 before the call (the caller-side
  # sret slice; the callee's copy-out writes the destination, so there
  # is no post-call store). A call carrying ADMITTED by-reference
  # aggregate
  # ARGUMENTS (aggregate args over whole aggregate locals — address-
  # class plain-struct images and payloaded tagged-enum images under
  # the LIR-internal enum ABI, the
  # aggregate-argument slice; MirCallValue::Place, or a place-like
  # operand over a constructed temporary's whole local) keeps an
  # ordinary args entry per
  # argument — the aggregate's first-word vreg as a placeholder, moved
  # or pushed like a scalar — and records each aggregate argument's
  # (general-class slot, source base_slot) on
  # LirFunction.agg_call_args (keyed by the
  # term's block id, the sret_call_slots pattern), which makes the
  # emitter form the source word-group's address in the argument's ABI
  # slot right before the call (x_slot for register-class slots — no
  # scalar move is emitted for them — and the reserved caller word for
  # stack-class slots). A whole tagged-enum destination whose image is
  # the payload-less tag word crosses back in x0 like a Scalar-class
  # destination (dest = the tag word's fixed vreg); a PAYLOADED enum
  # destination crosses back through the sret x8 protocol above
  # (dest = None, block recorded on sret_call_slots) — the
  # LIR-internal enum ABI (extern-boundary crossings are rejected by
  # the whole-program entries; see lir_check_extern_enum_calls).
  # A one-word (Scalar-class) plain-struct ARGUMENT and a payload-less
  # tagged-enum ARGUMENT cross by VALUE in their one slot — their
  # entries are ordinary scalar argument moves of the word vreg, never
  # agg_call_args records — and a PAYLOADED enum
  # argument crosses BY REFERENCE, an agg_call_args record carrying
  # the source image group's frame address (the LIR-internal enum ABI;
  # a payloaded-enum argument to an extern callee fails closed at the
  # whole-program entries).
  LirCall(String, Vec[Int], Int, Option[Int], Int)
end

struct LirTerm
  kind: LirTermKind
end

# ———————————————————————————————————————————————————————————————
# Scalar-subset type helpers and the width model
# ———————————————————————————————————————————————————————————————
# Width model (module header): a value of ANY supported scalar type is a
# full 64-bit machine word in vregs/slots/ABI registers. A type's MIR
# width matters only at (a) IntToInt narrowing casts — the canonical AND
# mask — and (b) the signedness-driven op selection below. The direct
# emitter keeps narrow locals in full 8-byte slots (load_place /
# store_place / allocate_locals), so there are no sized slot accesses in
# this slice either; sized memory appears at aggregate-field sites only
# for sub-word packed fields, and the aggregate gate (below) rejects
# every struct whose fields would need one — accepted fields sit one per
# 8-byte word and move full words.

# The bit width of a supported integer type (0 = not an integer of this
# slice). I64/U64/I128/U128, Char and the float kinds yield 0 — floats
# are the float slice's separate class (lir_fp_width_of).
def lir_int_width_bits(ty: Type) -> Int
  match ty
  when Type::I8 then 8
  when Type::U8 then 8
  when Type::I16 then 16
  when Type::U16 then 16
  when Type::I32 then 32
  when Type::U32 then 32
  when Type::Int then 64
  when Type::UInt then 64
  when Type::ISize then 64
  when Type::USize then 64
  when _ then 0
  end
end

# Is the type an integer scalar of this slice (Int/UInt/ISize/USize and
# the sized I8..U32)? Every one of them occupies a full 64-bit machine
# word under the width model — hence the helper name; only the 64-bit
# kinds are full-range.
def lir_is_int_word(ty: Type) -> Bool
  lir_int_width_bits(ty) > 0
end

# Is the type an allowed Bool local (comparison results/constants)?
def lir_is_bool_word(ty: Type) -> Bool
  match ty
  when Type::Bool then true
  when _ then false
  end
end

# Any scalar this slice can place in a virtual register.
def lir_is_scalar_word(ty: Type) -> Bool
  lir_is_int_word(ty) || lir_is_bool_word(ty)
end

# Unsignedness of an integer word (false for the signed kinds: Int,
# I8/I16/I32, ISize).
def lir_is_unsigned(ty: Type) -> Bool
  match ty
  when Type::UInt then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::USize then true
  when _ then false
  end
end

# Is the type Unit (the no-representation scalar)?
def lir_is_unit_word(ty: Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end
end

# The float width of a floating-point scalar type: Float (this
# compiler's legacy name for the 8-byte double — the direct pipeline's
# layout engine gives it the same 8-byte size/alignment as F64) and F64
# are double precision; F32 is single precision. Option::None for every
# non-float type (integers, Bool, Unit, aggregates, strings — the
# float-slice fail-closed set).
def lir_fp_width_of(ty: Type) -> Option[LirFpWidth]
  match ty
  when Type::Float then Option::Some(LirFpWidth::LirF64)
  when Type::F64 then Option::Some(LirFpWidth::LirF64)
  when Type::F32 then Option::Some(LirFpWidth::LirF32)
  when _ then Option::None
  end
end

# Is the type a floating-point scalar of the float slice?
def lir_is_fp_type(ty: Type) -> Bool
  match lir_fp_width_of(ty)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# The byte image a float width occupies in memory (F32 values ride the
# low 4 bytes of their 8-byte-indexed spill slot — loads/stores use the
# 32-bit forms so the canonical single never depends on the slot's
# upper bytes).
def lir_fp_bytes(w: LirFpWidth) -> Int
  match w
  when LirFpWidth::LirF32 then 4
  when LirFpWidth::LirF64 then 8
  end
end

# Any scalar this slice keeps in a machine register/slot: the integer
# words, Bool and the floating-point scalars (the float slice). The
# "value-word" test replaces lir_is_scalar_word at every site that
# assigns vregs or admits locals/params/returns/call values; the
# integer/bool-only tests stay at the integer-op gates.
def lir_is_value_word(ty: Type) -> Bool
  lir_is_scalar_word(ty) || lir_is_fp_type(ty)
end

# Is the type a RAW POINTER / INTERNAL-REFERENCE word — an OPAQUE
# address word admitted on the aarch64 whole-program route and on the
# cortex-m / riscv atomic surfaces (the
# pointer/atomic slice; Type::Ptr and Type::PtrMut — the MIR raw
# pointer forms std::atomic's extern declarations carry — plus
# Type::RefInternal, the MIR internal-ABI reference form MirRef
# rvalues produce and `inout`/ref parameters carry)? On those routes such
# a word is machine-identical to an Int word: LIR's type system never
# dereferences — every memory access is either the emitter's frame
# addressing (fixed slots / LirLoadFrame / the marked pointer-address
# forms below) or an explicit deref place lowered to a marked
# register-indirect load/store — so an address that only rides in
# vregs/slots, crosses in an ABI slot, is copied, or is deref-loaded/
# stored through the explicit deref forms is a plain word (64-bit on
# the aarch64 and riscv64 routes, 32-bit on the cortex-m and riscv32
# routes). The
# soundness note of the admission (the drop-glue slice's note, now
# general): LIR never dereferences THROUGH its type system, so no
# borrow/alias/ownership invariant needs a runtime representation —
# deref access is an explicit machine-level load/store of the pointed-to
# memory exactly where the MIR place says so. The admission is opened by
# width_ok in lir_check_fn_shape (the aarch64
# whole-program route) and by the cm_atomics / rv_atomics surface
# flags (the cortex-m and riscv routes — the plain thumb/rv entries
# keep the pointer rejections), and every
# deref through a word that is NOT a Ptr/PtrMut/RefInternal local still
# fails closed. MirRef (address-of) rvalues lower as the pointed-to
# frame slot's LEA / a deref-base + byte-offset add (see the MirRef arm
# of lir_lower_scalar_dst).
def lir_is_ptr_word(ty: Type) -> Bool
  match ty
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when Type::RefInternal(_, _) then true
  when _ then false
  end
end

# Any type this slice keeps as one opaque 64-bit machine word on the
# aarch64 route: the scalar words (integers/Bool), the floats and the
# pointer/ref words. The vreg/slot/ABI mechanics are uniform over the
# whole class — this is the "assigns a vreg" test of the lowering
# context (the float statements additionally consult the width table).
# (The pointer words are route-gated by lir_check_fn_shape before this
# helper ever sees them on the non-aarch64 routes.)
def lir_is_reg_word(ty: Type) -> Bool
  lir_is_value_word(ty) || lir_is_ptr_word(ty)
end

# ———————————————————————————————————————————————————————————————
# Aggregate locals — the layout model (plain structs + tagged enums)
# ———————————————————————————————————————————————————————————————
# An aggregate local is a Type::Adt whose MirTypeDef kind is Struct or
# Enum, admitted by the shape gate below when its whole image is
# representable as whole 8-byte WORDS at the direct layout engine's
# natural-alignment offsets. The local occupies N consecutive 8-byte
# frame slots (N = the direct layout size / 8 for every admitted
# shape) and is pure memory: every word owns one FIXED memory-home
# virtual register (never register-resident; see the allocator's
# fixed-slot rule in lir_alloc_registers_mode), and all aggregate
# traffic (construction stores, scalar field reads/writes, whole-
# aggregate word copies, enum tag/payload traffic) lowers to ordinary
# statements over those vregs, so the emitter needs no new statement
# kinds.
#
# PLAIN-STRUCT locals: the substituted fields are ALL scalar words of
# this slice (the FLOAT fields included — see the FLOAT FIELDS note
# below), each starting on its OWN 8-byte boundary. Field byte
# offsets mirror the direct layout engine's natural-alignment rule
# (compute_struct_layout with plain layout attrs) EXACTLY: field i is
# placed at align_up(prev_end, align_i) with the engine's scalar
# sizes/alignments (Bool is 1 byte / align 1; I8..U32 are their byte
# width; Int/UInt/ISize/USize are 8; F32 is 4; Float/F64 are 8).
# Every admitted placement lands
# fields at bytes 0, 8, 16, ... (a narrow field followed by an 8-byte
# field realigns the run), so word == field index == byte_off / 8.
#
# FLOAT FIELDS (the float-field slice): a field whose type is
# Float/F32/F64 is admitted exactly like a scalar word — it occupies
# the 8-byte word slot at its (8-boundary) direct offset, and its
# FIXED memory-home word vreg carries an entry in
# LirFunction.fp_widths (the float slice's class table), so every
# statement touching the field routes through the FP machinery at the
# field's width (the same statements, def/use walks and allocator the
# float locals use — no new shapes). The field's IN-MEMORY image is
# the float-LOCAL image model: F64/Float fills the whole 8-byte slot;
# F32 rides the LOW 4 bytes of its slot (the direct image is 4 bytes
# at the slot's byte offset — the mirror offsets stay byte-exact with
# the direct layout — and the slot's upper bytes are never read, by
# the same rule that governs F32 spill slots). Whole-word copies of
# an F32 field copy the value at its 4-byte width (an FMove), never
# the slot's padding; an aggregate whose F32 fields would PACK at
# 4-byte offsets (two F32s in one word, an F32 followed by a 4-byte
# or narrower field) still needs sized field memory and stays
# fail-closed at the gate's offset rule below.
#
# TAGGED-ENUM locals (the tagged-enum slice): a Type::Adt whose def
# kind is Enum with admitted VARIANT PAYLOADS — every variant's payload
# fields are scalar words of this slice (float payload fields included,
# under the same float-field model), each starting on an 8-byte
# boundary in the direct layout. The image mirrors compute_enum_layout's
# natural placement (F3 — tag at offset 0) and codegen.tg's flat
# payload offsets EXACTLY: the TAG is the 8-byte word at byte 0 (slot
# 0), and each variant's payload fields sit at the engine's
# natural-alignment offsets from the payload base (byte 8): field j of
# every admitted variant lands at byte 8 + 8*j, i.e. slot 1 + j. The
# image size is the direct total: tag (8) + align_up(max over variants
# of the sum of payload field sizes, 8), 8-aligned — slot count = size /
# 8. The tag word is written by construction (the MIR aggregate's first
# operand — the variant's raw discriminant), read by MirDiscriminant
# lowering (a plain tag-word load — this slice stores the raw
# discriminant inline, so no deref/normalization ever exists: the
# direct pipeline's TaggedPtr value-encoding word (raw discriminant
# below the inline-tag threshold / heap pointer above) is a REGISTER
# convention of codegen's heap images, not an image property), and
# read for the downcast payload addressing (which is pure static slot
# addressing here — the direct emitter's no-runtime-check downcast
# mirror: the tag -> active-variant correspondence is MIR's match
# guarantee, exactly as in codegen.tg). Because the payload words of
# DIFFERENT variants share image slots (a union), the gate enforces a
# per-image-word CLASS-CONSISTENCY rule: an image word that carries a
# float payload field in one variant must carry the SAME float width
# in every variant that uses the word — a word can never be both a
# float and an integer (or two float widths): its one fixed word vreg
# has one class record, and the image would otherwise need both
# register files (fail-closed with a rule naming the conflict).
#
# The acceptance gate rejects every shape whose image would need sized
# memory — a field/payload field starting inside an 8-byte word
# (sub-word packing: two narrow/F32 fields sharing a word, an F32
# followed by a 4-byte field), @packed/@align-attributed layouts,
# zero-field
# structs, zero-variant enums, non-scalar (nested aggregate/enum/ref/
# string/collection) fields and payloads, tuples and fixed arrays —
# with a reason naming the concrete missing rule.
struct LirAggField
  name: String
  word: Int        # the field's word (== its slot offset within the local)
  byte_off: Int    # the direct layout's byte offset of the field
  ty: Type         # the concrete (substituted) field type
end

struct LirAggShape
  words: Int       # 8-byte slots the local occupies (== fields.len())
  size: Int        # the direct layout's total byte size (mirror)
  fields: Vec[LirAggField]   # declaration order
end

# One admitted enum variant's payload record (see the section header):
# the payload fields in declaration order (MirVariantDef carries no
# payload names — construction and downcast access are positional, so
# LirAggField.name stays "").
struct LirAggVariant
  name: String
  discriminant: Int        # the variant's declared raw discriminant
  fields: Vec[LirAggField] # payload fields; word == slot in the image
end

# The admitted image record of a tagged-enum local: the union image of
# the tag word and every variant's payload words, mirroring the direct
# enum layout (tag @ byte 0; payload words at the engine's absolute
# offsets — every admitted payload field starts on an 8-byte boundary,
# so its word == byte_off / 8).
struct LirEnumShape
  words: Int                 # image slots (tag word + payload union)
  size: Int                  # the direct layout's total byte size (mirror)
  variants: Vec[LirAggVariant]   # declaration order
end

# The direct layout byte size of a FIELD scalar of the aggregate slice
# (aarch64: the layout engine's primitive sizes on the codegen layout
# target): the scalar words of lir_scalar_word_size plus the FLOAT
# scalars — Float/F64 are 8 bytes (the legacy Float spelling is this
# compiler's double) and F32 is 4, exactly the engine's sizes. The
# aggregate shapes' mirror offsets/sizes use it, so an admitted float
# field's byte image matches the direct layout exactly: an F32 field
# occupies the LOW 4 bytes of its 8-byte word slot at the engine's
# byte offset (the float-LOCAL memory model — F32 images ride the low
# half of their 8-byte-indexed slots, with the slot's upper bytes
# never read), and an F64/Float field fills its word slot.
def lir_field_size_bytes(ty: Type) -> Int
  match lir_fp_width_of(ty)
  when Option::Some(w) then lir_fp_bytes(w)
  when Option::None then lir_scalar_word_size(ty)
  end
end

# The direct layout byte size of the scalar words of this slice
# (aarch64: the layout engine's primitive_size/align on the codegen
# layout target; each accepted scalar's size equals its alignment).
def lir_scalar_word_size(ty: Type) -> Int
  match ty
  when Type::Bool then 1
  when Type::I8 then 1
  when Type::U8 then 1
  when Type::I16 then 2
  when Type::U16 then 2
  when Type::I32 then 4
  when Type::U32 then 4
  when Type::Int then 8
  when Type::UInt then 8
  when Type::ISize then 8
  when Type::USize then 8
  when _ then 0
  end
end

# The storage width and sign-extension of a deref word READ/WRITE over
# a deref place of the pointer/atomic slice (the LirPtrLoad/LirPtrStore
# payloads — see lir_lower_deref_word_read / lir_lower_deref_word_store).
# On the aarch64 routes this is lir_scalar_word_size with sign extension
# for the signed narrow integer types below the 8-byte word. On the
# cortex-m route (ctx.cm_atomics) the machine word is 4 BYTES: the
# 64-bit-width kinds (Int/UInt/ISize/USize) deref as the route's 4-byte
# machine words (their local images are 32-bit words — the same
# truncation the whole word-only route applies), the pointer/ref
# pointees deref as 4-byte address words, and sign extension applies
# below the 4-byte word only (a 4-byte load is the full word — never
# sign-extended). Width 0 = no storage width on the route (the
# existing fail-closed rules name it).
#
# The riscv atomic surface (ctx.rv_atomics) opens the same deref
# geometry at the route's MACHINE WORD (ctx.rv_word64): riscv32
# (rv_word64 false) is exactly the 4-byte cortex-m model above, and
# riscv64 (rv_word64 true) is the same model with the machine word at
# 8 BYTES — the 64-bit-width kinds and the pointer/ref pointees deref
# as 8-byte words, and sign extension applies below the 8-byte word
# (the signed 32-bit kinds keep their sign flag at width 4 — the
# riscv64 lw sign-extends, mirroring the aarch64 sxtw rule). Sign
# extension applies below the MACHINE WORD only (a full-word load is
# never sign-extended): the cm io code previously returned a sign
# flag for signed 32-bit kinds at the full 4-byte word — a form the
# thumb validator rejects as never lowering — and this merged branch
# implements the documented rule for the cortex-m route and the
# riscv32 route alike (an I32-typed deref is the full 4-byte word,
# loaded unsigned).
def lir_deref_word_io(ctx: LirLowerCtx, ty: Type) -> (Int, Bool)
  if ctx.cm_atomics || ctx.rv_atomics then
    let mw = if ctx.rv_word64 then 8 else 4 end
    match ty
    when Type::Bool then (1, false)
    when Type::Ptr(_) then (mw, false)
    when Type::PtrMut(_) then (mw, false)
    when Type::RefInternal(_, _) then (mw, false)
    when _ then
      let wb = lir_int_width_bits(ty)
      if wb >= 64 then
        (mw, false)
      else
        let w = lir_scalar_word_size(ty)
        (w, w > 0 && !lir_is_unsigned(ty) && w < mw)
      end
    end
  else
    let w = lir_scalar_word_size(ty)
    (w, w < 8 && !lir_is_unsigned(ty) && !lir_is_bool_word(ty))
  end
end

# Align a byte offset up to `align` (the engine's layout_align_up).
def lir_layout_align_up(value: Int, align: Int) -> Int
  if align <= 1 then
    value
  else
    let rem = value % align
    if rem == 0 then value else value + (align - rem) end
  end
end

# Substitute the concrete Adt args into one field type of a generic
# def: a Type::Param whose GenericParamId matches the def's k-th
# declared generic parameter (compared by owner module/id and index —
# identity is the id, never the name) becomes args[k]. Option::None
# when no declared parameter matches (an unresolved Param must fail
# closed, never reach the layout).
def lir_subst_type_arg(params: Vec[GenericParamId], args: Vec[Type], fty: Type) -> Option[Type]
  match fty
  when Type::Param(gp) then
    var found: Option[Type] = Option::None
    var k = 0
    while k < params.len() do
      let gpk = params[k]
      if gpk.owner.module.id == gp.owner.module.id && gpk.owner.index == gp.owner.index && gpk.index == gp.index then
        if k < args.len() then
          found = Option::Some(args[k].clone())
        end
        k = params.len() + 1
      else
        k = k + 1
      end
    end
    found
  when _ then Option::Some(fty.clone())
  end
end

# The admitted aggregate SHAPE of `ty` — see the section header. The
# Err strings are bare rule reasons (the callers prefix the fn/local
# context); Ok(None) means `ty` is not an aggregate type at all.
# The kinded result lets the shape-gate callers (the function/local
# gates and the lowering) apply the struct rules and the tagged-enum
# rules separately: both kinds share the word-group frame machinery,
# but construction, payload access, discriminant reads and the ABI
# classification are kind-specific.
enum LirAggShapeKind
  LirAggStruct(LirAggShape)
  LirAggEnum(LirEnumShape)
end

def lir_plain_struct_shape(type_defs: Map[Int, MirTypeDef], ty: Type) -> Result[Option[LirAggShapeKind], String]
  match ty
  when Type::Adt(tid, args) then
    let td = match type_defs.get(tid.id)
    when Option::Some(t) then t
    when Option::None then
      return Result::Err("aggregate type id " + tid.id.to_string() + " has no MirTypeDef record in this program (the aggregate-local slices need the program type-def table)")
    end
    # Layout attributes are read before the kind match consumes the def:
    # only attributed aggregates need them, and @packed/@align(N) layouts
    # are outside the slice (mirrored offsets exist for natural layouts
    # only). @repr(C) changes nothing for scalar fields (the direct
    # engine lays it out identically — and enum ABI classification
    # ignores it too, the EnumLayout being the enum authority), so it is
    # not rejected.
    let td_name = td.name.clone()
    let td_params = td.generic_params.clone()
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      if td.layout.is_packed then
        return Result::Err("struct " + td_name + " is @packed; packed (sub-word) field offsets are not implemented")
      end
      match td.layout.align
      when Option::Some(n) then
        return Result::Err("struct " + td_name + " declares @align(" + n.to_string() + "); alignment-attributed layouts are not implemented")
      when Option::None then ()
      end
      if fields.len() == 0 then
        return Result::Err("struct " + td_name + " has no fields; zero-size struct locals are not implemented")
      end
      var byte_off = 0
      var max_align = 1
      var out_fields: Vec[LirAggField] = Vec::new()
      var fi = 0
      while fi < fields.len() do
        let fty = match lir_subst_type_arg(td_params, args, fields[fi].ty)
        when Option::Some(t) then t
        when Option::None then
          return Result::Err("struct " + td_name + " field " + fields[fi].name + " has an unresolved generic parameter type (concrete-arg substitution is not implemented for that shape)")
        end
        let fsz = lir_field_size_bytes(fty)
        if fsz == 0 then
          return Result::Err("struct " + td_name + " field " + fields[fi].name + " is not a scalar word of this slice (only Int/UInt/ISize/USize/Bool/I8/I16/I32/U8/U16/U32/Float/F32/F64 fields lower; nested aggregates, enums, references, strings and collections are not implemented)")
        end
        byte_off = lir_layout_align_up(byte_off, fsz)
        if fsz > max_align then
          max_align = fsz
        end
        if byte_off % 8 != 0 then
          return Result::Err("struct " + td_name + " field " + fields[fi].name + " starts at byte offset " + byte_off.to_string() + ", inside an 8-byte word: sub-word fields sharing or straddling an 8-byte slot need sized field memory, which is not implemented (only fields that start on an 8-byte boundary lower; a float field is admitted exactly when its direct offset is an 8-byte boundary — a run of two F32 fields packs at 4-byte offsets and stays fail-closed)")
        end
        out_fields.push(LirAggField { name: fields[fi].name.clone(), word: out_fields.len(), byte_off: byte_off, ty: fty })
        byte_off = byte_off + fsz
        fi = fi + 1
      end
      let size = lir_layout_align_up(byte_off, max_align)
      Result::Ok(Option::Some(LirAggShapeKind::LirAggStruct(LirAggShape { words: out_fields.len(), size: size, fields: out_fields })))
    when MirTypeDefKind::Enum(variants) then
      lir_tagged_enum_shape(tid, args, td, variants)
    end
  when Type::Tuple(_) then
    Result::Err("tuple aggregates do not lower (tuple layouts are not implemented)")
  when Type::FixedArray(_, _) then
    Result::Err("fixed-array [T; N] aggregates do not lower (array element layouts are not implemented)")
  when _ then
    Result::Ok(Option::None)
  end
end

# The tagged-enum admission — see the section header. Mirrors
# compute_enum_layout's natural placement EXACTLY (the direct pipeline's
# single enum-layout authority; codegen.tg never contains a payload
# offset policy — the flat per-variant payload offsets it stores to
# come from this computation): the tag is the frozen 8-byte word at
# byte 0; every variant's payload fields are placed from the payload
# base (byte 8) at their natural alignment (payload field sizes are the
# same scalar sizes lir_scalar_word_size mirrors from the engine). An
# admitted variant's payload fields therefore land at bytes 8, 16, 24,
# ... — every payload field starts on its own 8-byte boundary — and the
# image slot count is the direct total size / 8: total = align_up(8 +
# align_up(max over variants of the payload byte sum, 8), 8).
def lir_tagged_enum_shape(tid: TypeId, args: Vec[Type], td: MirTypeDef, variants: Vec[MirVariantDef]) -> Result[Option[LirAggShapeKind], String]
  let td_name = td.name.clone()
  let td_params = td.generic_params.clone()
  if td.layout.is_packed then
    return Result::Err("enum " + td_name + " is @packed; packed (sub-word) payload field offsets are not implemented (the tagged-enum slice mirrors the direct layout engine's natural-alignment placement only)")
  end
  match td.layout.align
  when Option::Some(n) then
    return Result::Err("enum " + td_name + " declares @align(" + n.to_string() + "); alignment-attributed enum layouts are not implemented")
  when Option::None then ()
  end
  if variants.len() == 0 then
    return Result::Err("enum " + td_name + " has no variants; zero-variant (uninhabited) enum locals are not implemented")
  end
  var out_variants: Vec[LirAggVariant] = Vec::new()
  var max_payload_sum = 0
  # The per-image-word CLASS-CONSISTENCY table (see the layout-model
  # section's FLOAT FIELDS note): word index -> the class code of every
  # payload field placed there so far (1 = integer/Bool word, 2 = F32,
  # 3 = F64). Payload words of different variants UNION in the image,
  # and a word has ONE fixed memory-home vreg with ONE fp_widths class
  # record, so a word that is a float in any variant must be the SAME
  # float width in every variant that reaches it (and an integer word
  # must never share its slot with a float payload).
  var word_class: Map[Int, Int] = Map::new()
  var vi = 0
  while vi < variants.len() do
    let v = variants[vi]
    var payload_fields: Vec[LirAggField] = Vec::new()
    var payload_sum = 0
    var off = 8   # F3 mirror: the payload base sits right after the tag word
    var pj = 0
    while pj < v.fields.len() do
      let fty = match lir_subst_type_arg(td_params, args, v.fields[pj])
      when Option::Some(t) then t
      when Option::None then
        return Result::Err("enum " + td_name + " variant " + v.name + " payload field " + pj.to_string() + " has an unresolved generic parameter type (concrete-arg substitution is not implemented for that shape)")
      end
      let fsz = lir_field_size_bytes(fty)
      if fsz == 0 then
        return Result::Err("enum " + td_name + " variant " + v.name + " payload field " + pj.to_string() + " is not a scalar word of this slice (only Int/UInt/ISize/USize/Bool/I8/I16/I32/U8/U16/U32/Float/F32/F64 payload fields lower; nested aggregates, enums, references, strings and collections are not implemented)")
      end
      off = lir_layout_align_up(off, fsz)
      if off % 8 != 0 then
        return Result::Err("enum " + td_name + " variant " + v.name + " payload field " + pj.to_string() + " starts at byte offset " + off.to_string() + ", inside an 8-byte word: sub-word payload fields sharing or straddling an 8-byte slot need sized field memory, which is not implemented (only payload fields that start on an 8-byte boundary lower; a float payload field is admitted exactly when its direct offset is an 8-byte boundary)")
      end
      let cls = match lir_fp_width_of(fty)
      when Option::Some(LirFpWidth::LirF32) then 2
      when Option::Some(LirFpWidth::LirF64) then 3
      when Option::None then 1
      end
      let word = off / 8
      match word_class.get(word)
      when Option::Some(prev) then
        if prev != cls then
          return Result::Err("enum " + td_name + " variant " + v.name + " payload field " + pj.to_string() + " lands on image word " + word.to_string() + ", which another variant's payload field already occupies as a " + (if prev == 1 then "non-float word" elsif prev == 2 then "F32" else "F64" end) + "; the union word would need BOTH classes (or two float widths) in one fixed word vreg, which does not lower — float payload fields are admitted per image word only when every variant agrees on the word's class and width (fail-closed)")
        end
      when Option::None then word_class.insert(word, cls)
      end
      payload_fields.push(LirAggField { name: "", word: word, byte_off: off, ty: fty })
      off = off + fsz
      payload_sum = payload_sum + fsz
      pj = pj + 1
    end
    if payload_sum > max_payload_sum then
      max_payload_sum = payload_sum
    end
    out_variants.push(LirAggVariant { name: v.name.clone(), discriminant: v.discriminant, fields: payload_fields })
    vi = vi + 1
  end
  let size = lir_layout_align_up(8 + lir_layout_align_up(max_payload_sum, 8), 8)
  let words = size / 8
  Result::Ok(Option::Some(LirAggShapeKind::LirAggEnum(LirEnumShape { words: words, size: size, variants: out_variants })))
end

# ———————————————————————————————————————————————————————————————
# The sret-return slice — aggregate returns (aarch64 route): the
# register-class Scalar returns and the sret x8 classes
# ———————————————————————————————————————————————————————————————
# A function whose return type (locals[0], the return place) is an
# admitted PLAIN-STRUCT aggregate delivers its value exactly as the
# direct layout engine would classify the return image (codegen.tg's
# category_uses_sret over classify_value_category /
# inline_aggregate_category — the single return-class authority of the
# direct pipeline, mirrored here on the mirror layout size):
#   size == 0   -> ZeroSized  (never returned: no payload; the LIR
#                              shape gate rejects the only zero-size
#                              shapes — empty structs — outright, so
#                              no empty image can ever reach this
#                              slice's gates or a frame slot area)
#   size <= 8   -> Scalar     (one ABI word: the value crosses in x0 —
#                              the register-class aggregate return,
#                              implemented here: the callee's every Ret
#                              loads the return aggregate's single word
#                              from its fixed frame slot into x0
#                              exactly like a scalar return, and the
#                              caller's destination capture writes the
#                              same single word slot. A Scalar-class
#                              image whose ONE word is a FLOAT field
#                              (word-0's fp record — the float-field
#                              slice) crosses its word like a scalar
#                              float of the field's width instead: the
#                              value IS the field — F32 images are the
#                              canonical single (4 bytes), F64/Float
#                              the 8-byte double — so the Ret arm's
#                              fp-class dispatch loads the word at its
#                              width into V0 (s0/d0, the AAPCS64 HFA
#                              single-float register placement) and
#                              the caller's capture reads V0 the same
#                              way; both sides of a call agree by
#                              construction, and the arguments/binds
#                              walks classify one-word float-field
#                              images on the float stream identically)
#   size == 16  -> ScalarPair (the exactly-two-word image: sret — the
#                              caller-supplied buffer receives 16 bytes)
#   size 9..15 / > 16 -> ByAddress (sret; the admitted shapes realize
#                              the class only from 24 bytes up — whole
#                              words per image — so the copy-out is the
#                              same per-word loop)
# The aggregate gate admits only whole-word-per-field shapes (each field
# starts on its own 8-byte boundary), whose mirror size is always 8 *
# shape.words for multi-word images; a <= 8-byte (Scalar-class) image
# therefore has exactly ONE word and every admitted shape lands in
# exactly one of the classes above. The ScalarPair/ByAddress split is
# decided by the image size exactly as in the direct pipeline, and the
# word-slot copy of shape.words words is byte-exact with
# codegen_epilogue's sret copy (8-byte chunks then 4/2/1-byte tails —
# the tails never fire for whole-word images).
#
# TAGGED-ENUM returns — the LIR-INTERNAL ENUM ABI (a deliberate,
# documented divergence from the direct pipeline; see the
# lir_enum_crossing_rule section): the direct pipeline classifies
# every registered enum by its EnumLayout as ONE Scalar(8) crossing
# word (the TaggedPtr VALUE encoding — raw discriminant or heap
# pointer) and never gives an enum an sret class, because its one
# crossing word fits a register. This slice keeps enum images INLINE
# in fixed frame slots (no heap image exists to point at), so it
# mirrors that crossing word exactly for the PAYLOAD-LESS form — the
# 8-byte tag-word image, whose word IS the raw-discriminant value —
# and replaces the payloaded form's unrepresentable heap-pointer word
# with the by-reference image crossing of the aggregate machinery
# below: a PAYLOADED enum return (a >= 16-byte image — admitted enum
# images are whole words, so every multi-word image is sret-class by
# the same size rule) crosses through the caller-supplied x8 buffer
# exactly like an sret-class plain struct, with the callee's every Ret
# copying the image words out. The two sides of the convention agree
# by construction — the caller classifies its destination image the
# same way (below) — so the convention is coherent between
# LIR-compiled functions even though it diverges from the direct
# TaggedPtr ABI; the route is whole-program and self-contained, and
# the divergence is contained by the extern-boundary guard (see
# lir_check_extern_enum_calls), the only place the direct value-word
# convention still applies.
#
# The callee side of the sret ABI, implemented here: the function
# reserves one 8-byte frame slot for the caller's x8 (allocated after
# the vreg spill slots), the prologue stores x8 into it before any
# callee work (the codegen allocate_locals sret_offset rule), and every
# Ret term reloads x8 and stores each word of the return aggregate's
# fixed frame slots to [x8 + 8*k] — never writing x0. The callee side
# of the Scalar-class register ABI is implemented with it: a function
# whose return image is <= 8 bytes (exactly one word — a one-word
# plain struct OR a payload-less tagged-enum's tag word) never sees
# x8 — no sret slot is reserved, no prologue save runs — and every Ret
# carries the return word's fixed memory-home vreg, whose ordinary
# use-at-Ret resolution loads the fixed frame slot and moves it to x0
# (the width model: the full word crosses, exactly like a scalar
# return's value; the fixed-slot vreg machinery needs no new statement
# shapes). The enum kind never reaches the machine level: the per-word
# copy-out reads the return local's mirror shape (words/base_slot),
# which is identical for a multi-word plain struct and a payloaded
# enum image.
#
# The CALLER side of the ABI (the caller-side slice, implemented with
# it): a call whose destination is a whole aggregate local (empty
# projections) is classified by the destination image with the same
# callee-side rule. A whole plain-struct destination whose image is an
# sret class (lir_agg_sret_words:
# exactly 16 bytes or more than 8 bytes) lowers to the x8 protocol:
# the emitter forms &dest — the address of the aggregate's FIRST word
# slot, [FP - 8 - 8*base_slot] — in x8 immediately before the call
# (add/sub of FP, codegen.tg's emit_lea_fp mirror), then skips the
# ordinary post-call scalar capture: the callee's per-word copy-out IS
# the destination's write, so the LirCall carries no result vreg and no
# later machinery expects a post-call store. A Scalar-class
# destination (<= 8 bytes — one word: a one-word plain struct OR a
# payload-less tagged-enum's tag word) is NOT an sret call: lowering
# treats it exactly like a one-word scalar destination — the LirCall
# carries the destination word's fixed memory-home vreg as its result
# vreg and the emitter's ordinary post-call capture (x0 -> the vreg
# def, which stores its fixed slot) writes the destination after the
# call, mirroring codegen's classify_return Scalar path (a direct
# result store into the stack-homed destination). A whole PAYLOADED
# tagged-enum destination is classified by the same size rule and
# takes the sret x8 protocol above — its record on the caller-side
# sret map is identical to a plain-struct sret destination's (the
# destination's mirror words/size and base_slot are all the machine
# level reads); no LIR callee crosses the direct pipeline's one-word
# TaggedPtr enum return, and an extern callee still does, which the
# whole-program entries reject (see lir_check_extern_enum_calls).
#
# The PARAMETER side of the by-value aggregate ABI (the aggregate-param
# slice, implemented with it): a function whose PARAMETER is an
# admitted plain-struct aggregate with an ADDRESS-class image (the
# same lir_agg_sret_words test the return gate applies — exactly 16
# bytes / more than 8 bytes) receives the caller's
# image ADDRESS in ONE
# ABI arg slot: the parameter's position among ALL parameters (scalars
# consume one slot each; each aggregate consumes exactly one address
# slot — codegen.tg's classify_argument order, in which the direct
# prologue binds ScalarPair/ByAddress parameters from arg_reg(arch,
# idx)). The lowering records one LirAggParamBind per such parameter
# (LirFunction.agg_params, in parameter declaration order) and the
# entry emission in lir_emit_fn binds it at machine level, between the
# sret x8 save and the main/_start entry capture: the address is read
# from x_slot (slots 0..7) or from the caller's 16-byte stack slot at
# [FP + 16 + 16*(slot-8)] (slots >= 8 — the scalar stack-parameter
# geometry of lir_stack_arg_offset), and each word of the image at
# [addr + 8*k] is stored into the parameter aggregate's fixed frame
# slot [FP - 8 - 8*(base_slot + k)] — the sret Ret copy-out's
# X16/X17 load-store pattern with the loads and stores exchanged
# (X16 = the image base, X17 = the copied word). The stores are direct
# slot writes invisible to the allocator, exactly like the sret
# prologue's x8 save: the fixed-slot word vregs only ever READ those
# slots (their uses load through the ordinary spill machinery), so
# after the copy the parameter behaves exactly like an aggregate
# local. A one-word (<= 8 bytes, Scalar-class) plain-struct parameter
# — the register-class rule — instead crosses BY VALUE as that single
# word in the parameter's slot register and binds through an ordinary
# entry STATEMENT into the parameter aggregate's fixed word-0 vreg (a
# def of a fixed memory-home vreg stores the slot), exactly like the
# payload-less enum parameter below. A
# PAYLOAD-LESS TAGGED-ENUM parameter crosses as its one value word
# (the raw-discriminant tag): the direct pipeline's enum parameters
# are Scalar(8) words in their ABI slots (classify_argument), so the
# entry binding for such a parameter is an ordinary scalar-style
# statement into the enum local's fixed tag-word vreg (see the
# binding walk), NOT a LirAggParamBind. A PAYLOADED TAGGED-ENUM
# parameter takes the address class instead (the LIR-internal enum
# ABI — the mirror of the return-side sret admission, exactly as for
# a plain struct): it consumes ONE slot carrying the caller's inline
# image address and produces a LirAggParamBind whose entry copy moves
# the image words (tag + payload) into the parameter's fixed frame
# slots, so the parameter behaves exactly like a payloaded-enum local
# afterwards.
#
# The ARGUMENT side of the by-value aggregate ABI (the
# aggregate-argument slice, the CALLER-side mirror of the aggregate-
# param slice, implemented with it): a call ARGUMENT that is an
# admitted plain-struct aggregate (a whole plain-struct local with
# empty projections, carried by MIR as a MirCallValue::Place — the
# codegen.tg aggregate-argument rule) consumes ONE positional ABI slot
# — its position among ALL arguments — and its image class decides
# what the CALLER places in that slot: an ADDRESS-class image
# (lir_agg_sret_words > 0) gets the
# source word-group's ADDRESS (the source local is
# stack-homed by the fixed-slot rule, so the address is the frame
# address of its first word slot, [FP - 8 - 8*base_slot]), while a
# Scalar-class one-word image gets its single WORD by value through
# the ordinary scalar-argument move path (the register-class rule
# below). Lowering
# records one LirAggCallArg per ADDRESS-class argument (LirFunction.
# agg_call_args, keyed by the term's block id — the sret_call_slots
# pattern) and the call emission in lir_emit_term forms the addresses
# at the call site, after the pre-call spill stores and right before
# the branch (the sret x8 lea ordering): x_slot for slots 0..7 (no
# scalar move is emitted for such an argument — the lea IS its
# definition, the exact counterpart of the prologue's x_slot fetch),
# and for slots >= 8 the address is stored into the 16-byte caller
# word the argument's LirPushArg statement reserved at [SP +
# 16*(slot-8)] (the push rides the ordinary descending stream with the
# source's first-word vreg as a placeholder value, which the store
# overwrites — its contents never reach the callee). The callee's
# entry binding fetches the image address and copies the words exactly
# as the aggregate-param slice does, so aggregate parameters and
# aggregate arguments now lower end to end on this route. A one-word
# (<= 8 bytes, Scalar-class) plain-struct argument crosses BY VALUE as
# its single word in the argument's slot register through the ordinary
# scalar-argument move path (the register-class rule, mirroring the
# parameter gate's own admission); aggregate VALUE arguments are admitted only in
# their whole-local-operand form (a place-like operand over a
# constructed temporary's whole aggregate local — the only shape an
# aggregate-typed value can take in this MIR, whose word group the
# construction filled before the call) and every other non-scalar
# value argument fails closed. A PAYLOAD-LESS TAGGED-ENUM argument
# crosses by VALUE — its raw-discriminant tag word in the argument's
# ONE general-class slot, the ordinary scalar-argument move path (the
# caller-side mirror of the payload-less enum parameter binding; the
# direct classify_argument Scalar path for enum arguments). A
# PAYLOADED TAGGED-ENUM argument crosses by REFERENCE (the
# LIR-internal enum ABI — the caller-side mirror of the payloaded-enum
# parameter binding): its record is an ordinary LirAggCallArg carrying
# the source image group's frame address in the argument's ONE slot,
# exactly like an address-class plain-struct argument — the enum kind
# is decided at lowering (the argument's whole-enum source), and the
# shared record keeps the machine level kind-agnostic.
#
# The sret-return words of an admitted aggregate shape: shape.words when
# the image takes an sret category (exactly 16 bytes — ScalarPair — or
# more than 8 bytes — ByAddress; between 9 and 15 no admitted shape can
# land, and > 8 is written as the size rule so the two categories read
# exactly like the engine's), 0 when the image returns in x0 (the
# Scalar class: a one-word image of 1/2/4/8 bytes — the register-class
# aggregate returns, implemented through the Ret word load and the
# caller-side word capture described above) and for non-aggregate
# returns. The SAME test is the address-class admission of by-value
# aggregate PARAMETERS and payloaded-enum parameters (the
# aggregate-param slice and the LIR-internal enum ABI): a param with
# lir_agg_sret_words > 0 binds through its ABI slot's image address,
# while a one-word Scalar-class param image (<= 8 bytes) crosses by
# value as that one word in the slot register and binds through the
# entry STATEMENTS (the register-class slice). (Tagged-enum shapes reach this
# test with a nonzero result exactly when their image carries payload
# words: the image mirror shape — words/size only — classifies a
# payloaded enum like an sret-class plain struct of the same size, so
# the enum crossings ride the plain-struct records with no kind
# field.)
def lir_agg_sret_words(shape: LirAggShape) -> Int
  if shape.size == 16 || shape.size > 8 then
    shape.words
  else
    0
  end
end

# Is the aggregate shape a Scalar-class return image (<= 8 bytes —
# codegen.tg's ValueCategory::Scalar: the value crosses as ONE word in
# x0)? Every admitted whole-word-per-field shape whose image is <= 8
# bytes has exactly ONE word (each field starts on its own 8-byte
# boundary, so a second word would put the image at >= 16 bytes), so
# the class test doubles as "the return is the shape's single word".
# The size == 0 (ZeroSized) case never reaches this test: the shape
# gate rejects zero-field structs, mirroring codegen's "no payload:
# nothing is returned" rule by non-admission. The sibling
# lir_agg_sret_words test (> 0) covers the sret classes; admitted
# shapes always satisfy exactly one of the two.
def lir_agg_is_scalar_class(shape: LirAggShape) -> Bool
  shape.size <= 8
end

# The image record of a tagged-enum shape as an aggregate image shape —
# the words/size the shared class tests read (an enum's image never has
# struct fields; payload access goes through the variant table).
def lir_enum_image_shape(eshape: LirEnumShape) -> LirAggShape
  LirAggShape { words: eshape.words, size: eshape.size, fields: Vec::new() }
end

# THE ENUM CROSSING RULE — the DIRECT pipeline's enum ABI and the
# LIR-INTERNAL divergence that replaces it between LIR-compiled
# functions: the direct pipeline classifies every REGISTERED enum as
# ValueCategory::Scalar(8) — ONE crossing word, the EnumLayout's
# TaggedPtr VALUE encoding (layout_engine.tg
# EnumValueRepresentation::TaggedPtr, codegen.tg's
# normalize_enum_value_to_tag / store_place / the enum-eq helpers): a
# raw discriminant below the 256-byte inline-tag threshold, or a heap
# pointer at/above it to the inline {tag @ 0, payload @ 8} image. This
# slice keeps enum images INLINE in fixed frame slots and never
# heap-allocates, so it mirrors that crossing word exactly for a
# PAYLOAD-LESS enum — whose whole 8-byte image IS the raw-discriminant
# word (the register form the direct encoding uses for values below
# its threshold) — and, for a PAYLOADED enum (whose direct crossing
# word would be a heap pointer this slice cannot form), crosses the
# INLINE IMAGE BY REFERENCE instead: the payloaded image rides the
# aggregate machinery above on all four paths (returns through the
# sret x8 copy-out, parameters and arguments through the image address
# in the parameter/argument's ONE slot, destinations through the
# caller-side sret record) — the LIR-INTERNAL ENUM ABI. The
# divergence is documented and coherent because the route is
# whole-program and self-contained: every non-extern callee lowers
# with the same convention, and the only crossings whose counterpart
# follows the direct value-word convention are calls to EXTERN
# symbols, which the whole-program entries reject with this rule (see
# lir_check_extern_enum_calls) — the ONE remaining fail-closed enum
# crossing. Locals, construction, discriminant reads, downcast payload
# access and whole-value copies of payloaded enums lower inside a
# function (see the layout-model section).
def lir_enum_crossing_rule() -> String
  "a tagged enum whose image carries payload words crossing a call boundary with a NON-LIR (extern) callee: the direct pipeline classifies every registered enum as Scalar(8) — ONE crossing word — the TaggedPtr value encoding (layout_engine.tg's EnumValueRepresentation::TaggedPtr: a raw discriminant below the 256-byte inline-tag threshold, or a heap pointer at/above it to the inline {tag @ 0, payload @ 8} image), and the extern's callee side reads that value word. This slice keeps enum images inline in fixed frame slots and crosses a payloaded image by reference between LIR-compiled functions (the LIR-internal enum ABI — the sret x8 copy-out for returns/destinations and the image address in the argument/parameter's ONE slot for calls/parameters), so the extern-boundary crossing — whose word would be the heap pointer this slice cannot materialize — fails closed here. Locals, construction, discriminant reads, downcast payload access and whole-value copies of payloaded enums DO lower inside a function, and payload-less enums cross extern boundaries by their raw-discriminant tag word (the same value word in both conventions)"
end

# The width record of an integer type: storage bits and signedness. The
# per-local copy of this record lives on LirLowerCtx (widths_of), built
# by lir_lower_ctx_new.
struct LirWidth
  bits: Int
  unsigned: Bool
end

def lir_int_width_of(ty: Type) -> Option[LirWidth]
  let bits = lir_int_width_bits(ty)
  if bits == 0 then
    Option::None
  else
    Option::Some(LirWidth { bits: bits, unsigned: lir_is_unsigned(ty) })
  end
end

# The canonical narrowing mask of a width < 64: (1 << bits) - 1 (the
# direct emitter's CastKind::IntToInt AND-mask constant).
def lir_width_mask(w: LirWidth) -> Int
  (1 << w.bits) - 1
end

# The aarch64 condition code of a LirCond (Cset and branches).
def lir_cond_code(c: LirCond) -> u32
  match c
  when LirCond::LirEq then a64_cc_eq()
  when LirCond::LirNe then a64_cc_ne()
  when LirCond::LirLt then a64_cc_lt()
  when LirCond::LirLe then a64_cc_le()
  when LirCond::LirGt then a64_cc_gt()
  when LirCond::LirGe then a64_cc_ge()
  when LirCond::LirUlt then a64_cc_cc()  # unsigned lower = LO (CC)
  when LirCond::LirUle then a64_cc_ls()
  when LirCond::LirUgt then a64_cc_hi()
  when LirCond::LirUge then a64_cc_cs()  # unsigned higher-or-same = HS
  end
end

# The LirCond for an MIR integer comparison under the operands'
# signedness.
def lir_cond_of(op: MirBinOp, unsigned: Bool) -> LirCond
  if unsigned then
    match op
    when MirBinOp::Eq then LirCond::LirEq
    when MirBinOp::Ne then LirCond::LirNe
    when MirBinOp::Lt then LirCond::LirUlt
    when MirBinOp::Le then LirCond::LirUle
    when MirBinOp::Gt then LirCond::LirUgt
    when MirBinOp::Ge then LirCond::LirUge
    when _ then panic("lir_cond_of: non-comparison op")
    end
  else
    match op
    when MirBinOp::Eq then LirCond::LirEq
    when MirBinOp::Ne then LirCond::LirNe
    when MirBinOp::Lt then LirCond::LirLt
    when MirBinOp::Le then LirCond::LirLe
    when MirBinOp::Gt then LirCond::LirGt
    when MirBinOp::Ge then LirCond::LirGe
    when _ then panic("lir_cond_of: non-comparison op")
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Lowering: MIR -> LIR (Slice 2)
# ———————————————————————————————————————————————————————————————
# Fail-closed: every unsupported construct returns Result::Err with a
# rule-naming message. See the module header for the supported subset.

# One aggregate local's lowering record: its accepted layout plus the
# fixed memory-home word vregs and the slot area assigned to it.
# Plain-struct locals carry their field table in shape/name_index;
# tagged-enum locals carry the image record in shape (words/size only —
# fields is empty) plus the full variant table in enum_shape (a tag
# word at image word 0 followed by the variants' payload words).
struct LirAggLocal
  type_id: Int             # the TypeId of the local's Adt type
  shape: LirAggShape       # structs: words/size/fields (declaration
                           # order); enums: words/size of the image with
                           # an empty field list
  enum_shape: Option[LirEnumShape]   # Some iff the local's def is an
                           # admitted tagged enum (the variant table)
  base_slot: Int           # first 8-byte slot of this local's area
  word_vregs: Vec[Int]     # one fixed memory-home vreg per image word
  name_index: Map[String, Int]   # struct field name -> field index
                           # (empty for enum locals)
end

struct LirLowerCtx
  fn_name: String
  # MirLocalId.id -> type (locals include parameters in this MIR)
  local_tys: Map[Int, Type]
  # MirLocalId.id -> width record of the local's integer type (integer
  # locals and parameters only; Bool/Unit locals carry none)
  widths_of: Map[Int, LirWidth]
  # Ordinary vreg id -> float width: the float-slice class table of
  # every FP vreg created by this lowering (the ctx-side copy of the
  # LirFunction.fp_widths authority), kept in step with vreg_of /
  # next_vreg. The parallel-move cycle scratch vregs below are
  # registered here too.
  fp_widths: Map[Int, LirFpWidth]
  # MirLocalId.id -> virtual register
  vreg_of: Map[Int, Int]
  next_vreg: Int
  # Aggregate slice state (aarch64 program route only): accepted
  # plain-struct AND tagged-enum locals (aggregate parameters included —
  # parameters are locals in this MIR), keyed by MirLocalId.id. Each
  # occupies shape.words consecutive 8-byte slots starting at base_slot;
  # the aggregate slot region is numbered from 0 and precedes every vreg
  # spill slot (see lir_alloc_registers_mode).
  agg_of: Map[Int, LirAggLocal]
  # Aggregate word vreg -> its slot index (flattened from agg_of; the
  # allocator's fixed-slot map, copied onto the LirFunction).
  agg_word_slots: Map[Int, Int]
  # Next free aggregate slot index (== the function's agg_slots count
  # at assembly time).
  next_agg_slot: Int
  # Per-block statement accumulation, keyed by block id
  block_stmts: Map[Int, Vec[LirStmt]]
  # Per-block terminator, keyed by block id
  block_terms: Map[Int, LirTerm]
  # Caller-side sret-return state (see the sret-return slice section):
  # block id -> the destination aggregate's base_slot, recorded when a
  # call terminator's destination is a whole aggregate local with an
  # sret image (lir_agg_sret_words > 0: an sret-class plain-struct
  # local OR a payloaded tagged-enum local under the LIR-internal enum
  # ABI — payload-less enum destinations cross in x0 and never record
  # here); copied onto the LirFunction
  # at assembly, where the aarch64 call emitter reads it.
  sret_call_slots: Map[Int, Int]
  # Caller-side aggregate-argument state (the aggregate-argument slice
  # — see LirAggCallArg): block id -> the aggregate arguments of that
  # block's call terminator, in argument order, recorded when a call
  # carries an admitted by-reference aggregate argument
  # (lir_agg_sret_words > 0 — an address-class plain-struct argument
  # OR a payloaded tagged-enum argument under the LIR-internal enum
  # ABI;
  # payload-less enum arguments and one-word Scalar-class plain-struct
  # arguments cross BY VALUE through the ordinary
  # scalar-argument path and never record here);
  # copied onto the LirFunction at assembly, where the aarch64 call
  # emitter reads it (the sret_call_slots pattern).
  agg_call_args: Map[Int, Vec[LirAggCallArg]]
  # One function-wide scratch virtual register for parallel-move cycles
  scratch: Int
  # The FP counterparts of ctx.scratch for parallel-move cycles over
  # FLOATING-POINT locals: one scratch per width (a cycle's edges all
  # carry one width — a phi rotates values among locals of one type —
  # so the width-matched scratch is always safe). Both are ordinary FP
  # vregs (registered in fp_widths), never used by the aarch64 scalar
  # code paths; like ctx.scratch they only ever appear in moves.
  scratch_fp32: Int
  scratch_fp64: Int
  # aarch64-route gate: Div/Mod lower (sdiv/udiv markers) only when true —
  # every non-aarch64 route (the shared rv entry, the cortex-m entry
  # lower_mir_fn_to_lir_cm) keeps div_ok == false and fails closed,
  # because their emitters cannot express division.
  div_ok: Bool
  # Parameter-fetch mode (the div_ok gate pattern, extended to the
  # parameter/caller-argument ABI): false = the aarch64 rule — the
  # per-class walk binds GENERAL parameters at GP positions 0..7 to
  # the fixed x0..x7 vregs and FLOAT parameters at FP positions 0..7
  # to the fixed d0..d7 vregs; general positions >= 8 ride the
  # caller's stack in 16-byte slots at [FP + 16 + 16*stk] (float
  # stack positions fail closed at both ends);
  # true = the cortex-m AAPCS32 rule — GENERAL parameters at GP
  # positions 0..3 bind to the fixed
  # r0..r3 vregs and every general parameter beyond is fetched from /
  # pushed onto the
  # caller's stack as a 4-byte word at the shared stream's
  # [FP + 8 + 4*stk] offset, and FLOAT parameters at FP positions
  # 0..7 bind to the fixed d0..d7 vregs with the FP positions beyond
  # fetched from the same shared stream at the width-aware float
  # offsets (see
  # lir_arg_reg_count / lir_stack_arg_offset / the entry-binding walk
  # in lower_mir_fn_to_lir_mode_ty). The lowering branches on
  # this field at the entry binding and the call-argument emission; the
  # LIR statement shapes (LirLoadFrame / LirPushArg / LirCall stack_args)
  # are shared with the aarch64 rule — only the geometry differs.
  param_stack_mode: Bool
  # The cortex-m atomic-surface gate (the cm_atomics route flag of
  # lower_mir_fn_to_lir_mode_ty — see its doc; true only through the
  # cortex-m entry lower_mir_fn_to_lir_cm, whose backend_thumb.tg
  # emitter implements the ARMv7-M LDREX/STREX/DMB atomic forms). It
  # opens, on the cortex-m route:
  #   - the pointer/atomic slice admissions that the aarch64 width-ok
  #     shape gate opens for the a64 routes — Ptr/PtrMut/RefInternal
  #     words in the function surface, the sized integer words of the
  #     atomic data kinds (I8/I16/I32/U8/U16/U32), Bool params/
  #     returns (the compare_exchange Bool result) and ISize/USize
  #     returns — with every deref/MirRef/atomic-call form of the
  #     slice lowering exactly as on the a64 routes (the lowering is
  #     type-driven; only the shape gates were route-scoped);
  #   - the atomic-intrinsic call recognition (lir_lower_call's gate —
  #     on the a64 routes it is ctx.div_ok && !ctx.param_stack_mode)
  #     with the cortex-m width cap: only the widths 1/2/4 lower here
  #     (the desc's atomic_widths [1,2,4] — ARMv7-M has no 8-byte
  #     LDREXD/STREXD exclusives and no doubleword atomic form; a _u64
  #     intrinsic fails closed at lir_lower_atomic_call with the
  #     target reason). The marked LirPtrOp statements the slice emits
  #     then reach backend_thumb.tg, whose exclusive-access arms
  #     translate each form into its LDREX/STREX loop (see that
  #     backend's atomic section). The a64 routes leave this flag
  #     false (their slice is keyed to width_ok as before).
  cm_atomics: Bool
  # The riscv atomic-surface gates (the rv_atomics/rv_word64 route
  # flags of lower_mir_fn_to_lir_mode_ty — see its doc; rv_atomics is
  # true only through the riscv entries lower_mir_fn_to_lir_rv32 /
  # lower_mir_fn_to_lir_rv64, whose backend_rv.tg emitter implements
  # the RISC-V A-extension LR/SC + FENCE atomic forms). rv_atomics
  # opens, on the riscv route, THE SAME atomic surface the cm_atomics
  # flag opens on the cortex-m route (pointer/ref words, the sized
  # atomic data kinds, Bool results, the deref/MirRef/atomic-call
  # forms and the atomic-intrinsic call recognition — the two flags
  # never both open: cm_atomics names the cortex-m surface and
  # rv_atomics the riscv surface, and the shape gate admits the same
  # type set under either). rv_word64 records the riscv route's
  # MACHINE-WORD width: true = the riscv64 (RV64, LP64) model with
  # 8-byte words — deref accesses at 8 bytes and the _u64 atomic
  # width admitted (LR.D/SC.D exist on RV64) — and false = the
  # riscv32 (RV32, ILP32) model with 4-byte words (the same
  # machine-word semantics as the cortex-m route: deref accesses
  # clamp to 4 bytes and a _u64 atomic width fails closed at
  # lir_lower_atomic_call with the riscv32 reason). rv_word64 also
  # selects the riscv frame-slot LEA payloads
  # (lir_lower_ref_of_place multiplies a slot by the machine word in
  # bytes, mirroring the cm route's 4*slot payloads). The sub-word
  # widths 1/2 open on BOTH riscv xlens (their naturally-aligned
  # single-copy-atomic plain loads/stores lower); the RISC-V A
  # extension's LR/SC carry only the word and — RV64 — the doubleword
  # width, which is the backend's rv_validate_fn width surface: the
  # sub-word atomic RMW/CAS forms fail closed there with the
  # A-extension rule (the masked word-width emulation is a later
  # slice).
  rv_atomics: Bool
  rv_word64: Bool
  # Set when an assert with a register condition lowers: the function then
  # gets a synthetic trap block (see lir_trap_block_id) appended by
  # lower_mir_fn_to_lir_mode.
  trap_used: Bool
  # MirDeinit slice state (the aarch64 whole-program route only — the
  # entries without the program tables keep BOTH maps empty and fail
  # closed at any MirDeinit, exactly as before): the program's CONCRETE
  # deinit-plan table (mir_type_identity_key(concrete type) -> DeinitPlan
  # — MirProgram.deinit_plans, the same authority codegen.tg's
  # ctx.deinit_plans consumes) and the finalizer identity table
  # (def_id_numeric(finalizer DefId) -> the finalizer function's mangled
  # emission name — MirProgram.method_names_by_def). MirTypeDef carries
  # NO finalizer registration (the registered deinit identities live in
  # the checker's deinit_targets and reach this route only through the
  # concrete plans and the name table), so the MirDeinit slice
  # classifies every destroyed place by these program tables.
  deinit_plans: Map[String, DeinitPlan]
  finalizer_names: Map[Int, String]
  # The whole-program static label table (DefId-render key ->
  # emission name — the codegen.tg build_static_label_table pairing the
  # route entries build from the program; empty on the entries without
  # a program). The MirStaticRef lowering resolves a static reference's
  # DefId through it (lir_static_symbol_of) to the .data/.bss symbol the
  # route's whole-program static emission registered (see the statics
  # section above). A reference whose DefId never registered fails
  # closed at lowering — never a name-derived or guessed address.
  static_labels: Map[String, String]
  # Generated drop-glue admission state (the aarch64 whole-program route
  # only — see lir_resolve_glue_head_bind): for a generated drop-glue
  # function (name in MirProgram.drop_glue_fns), glue_head_ptr is the
  # MirLocalId.id of its Ptr-typed `ptr` parameter and glue_value_local
  # the MirLocalId.id of the whole `value` aggregate local its head copy
  # (`value = *ptr`, the first statement of block 0) writes. Lowering
  # turns that copy into a MACHINE-LEVEL ENTRY BIND (a LirAggParamBind
  # record assembled into agg_params whose slot is the ptr parameter's
  # ONE general-class ABI slot and whose words land in the value
  # local's fixed frame area — the aggregate-param slice's entry copy,
  # whose emitter loads [x_slot + 8k]); the head-copy statement itself
  # is skipped. Option::None for every ordinary function.
  glue_head_ptr: Option[Int] = Option::None
  glue_value_local: Option[Int] = Option::None
  # The program's MirTypeDef table (TypeId.id -> def — the aggregate
  # gate's table, kept on the ctx for the pointer/atomic slice's deref
  # place resolution: the byte offsets of a deref'd pointed-to
  # struct/enum image come from lir_plain_struct_shape over the
  # POINTEE type, which is not a local of this function). Empty on the
  # entries that carry no program table; deref places over pointed-to
  # aggregate images then fail closed at classification.
  type_defs: Map[Int, MirTypeDef] = Map::new()
  # Pointer/atomic dispatch state (the atomic slice — the runtime
  # per-ordering dispatch lowers to a LirSwitch over the order word
  # whose ARM blocks and optional MERGE block are synthetic): the block
  # ids of every extra block created during lowering, appended AFTER
  # the MIR blocks at assembly (mirroring the trap-block append), and
  # the fresh-id counter (negative ids below the trap block's -1).
  extra_blocks: Vec[Int] = Vec::new()
  next_blk: Int = -2
end

# The synthetic per-function trap block id: negative, so it can never
# collide with a MIR block id (dense, >= 0). The block carries no
# statements and LirTrap as its terminator; MirAssert failure edges jump
# to it (the direct emitter's udf fallthrough mirror).
def lir_trap_block_id() -> Int = -1

def lir_lower_ctx_new(f: MirFunction, div_ok: Bool, param_stack_mode: Bool, cm_atomics: Bool, rv_atomics: Bool, rv_word64: Bool, type_defs: Map[Int, MirTypeDef], deinit_plans: Map[String, DeinitPlan], finalizer_names: Map[Int, String], static_labels: Map[String, String]) -> LirLowerCtx
  var local_tys: Map[Int, Type] = Map::new()
  var widths_of: Map[Int, LirWidth] = Map::new()
  var fp_widths: Map[Int, LirFpWidth] = Map::new()
  var li = 0
  while li < f.locals.len() do
    let lty = f.locals[li].ty.clone()
    local_tys.insert(f.locals[li].id.id, lty.clone())
    match lir_int_width_of(lty)
    when Option::Some(w) then widths_of.insert(f.locals[li].id.id, w)
    when Option::None then ()
    end
    li = li + 1
  end
  var vreg_of: Map[Int, Int] = Map::new()
  var next = lir_first_alloc_vreg()
  var block_stmts: Map[Int, Vec[LirStmt]] = Map::new()
  var block_terms: Map[Int, LirTerm] = Map::new()
  var sret_call_slots: Map[Int, Int] = Map::new()
  var agg_call_args: Map[Int, Vec[LirAggCallArg]] = Map::new()
  # The scratch vregs are reserved up front (the general scratch first,
  # then one float scratch per width) so parallel-move cycle breaking
  # can always materialize; ordinary vregs follow.
  let scratch = next
  next = next + 1
  let scratch_fp64 = next
  next = next + 1
  fp_widths.insert(scratch_fp64, LirFpWidth::LirF64)
  let scratch_fp32 = next
  next = next + 1
  fp_widths.insert(scratch_fp32, LirFpWidth::LirF32)
  # Assign the return slot first (locals[0] is the return place).
  if f.locals.len() > 0 && lir_is_reg_word(f.locals[0].ty) then
    vreg_of.insert(f.locals[0].id.id, next)
    match lir_fp_width_of(f.locals[0].ty)
    when Option::Some(w) then fp_widths.insert(next, w)
    when Option::None then ()
    end
    next = next + 1
  end
  # Parameters in declaration order (they also appear in locals).
  var pi = 0
  while pi < f.params.len() do
    let p = f.params[pi]
    if !vreg_of.contains_key(&p.id.id) then
      if lir_is_reg_word(p.ty) then
        vreg_of.insert(p.id.id, next)
        match lir_fp_width_of(p.ty)
        when Option::Some(w) then fp_widths.insert(next, w)
        when Option::None then ()
        end
        next = next + 1
      end
    end
    pi = pi + 1
  end
  # Aggregate locals — aggregate PARAMETERS included, because parameters
  # also appear in f.locals (aarch64 program route only; the shape gate
  # has already admitted every local whose type classifies here, so an
  # Err at this point is a gate/ctx divergence — fail closed). Areas and
  # word vregs are assigned in locals DECLARATION order so both the
  # slot numbering and the vreg numbering are deterministic. (The
  # ADDRESS-class aggregate parameters' — and PAYLOADED tagged-enum
  # parameters' — entry BINDING is not a vreg
  # matter — it is the machine-level per-word copy of the
  # aggregate-param slice, whose records are assembled onto the
  # LirFunction at the end of lowering; PAYLOAD-LESS tagged-enum
  # parameters bind their tag word through ordinary entry STATEMENTS
  # into the fixed word vreg assigned here.)
  var agg_of: Map[Int, LirAggLocal] = Map::new()
  var agg_word_slots: Map[Int, Int] = Map::new()
  var next_agg_slot = 0
  var li2 = 0
  while li2 < f.locals.len() do
    let lid2 = f.locals[li2].id.id
    let lty2 = f.locals[li2].ty.clone()
    let shape_o = match lir_plain_struct_shape(type_defs, lty2)
    when Result::Err(e) then
      panic("lir: internal aggregate-shape divergence in " + f.name + ": " + e)
    when Result::Ok(o) then o
    end
    match shape_o
    when Option::Some(kind) then
      let type_id = match lty2
      when Type::Adt(tid, _) then tid.id
      when _ then panic("lir: internal: aggregate shape for a non-Adt local in " + f.name)
      end
      # The word group: the image words (struct: one word per field;
      # enum: the tag word + the payload union — the LirAggShape record
      # carries words/size for both kinds).
      let shape = match kind
      when LirAggShapeKind::LirAggStruct(s) then s
      when LirAggShapeKind::LirAggEnum(e) then LirAggShape { words: e.words, size: e.size, fields: Vec::new() }
      end
      let enum_shape = match kind
      when LirAggShapeKind::LirAggStruct(_) then Option::None
      when LirAggShapeKind::LirAggEnum(e) then Option::Some(e)
      end
      let base = next_agg_slot
      next_agg_slot = next_agg_slot + shape.words
      var word_vregs: Vec[Int] = Vec::new()
      var wk = 0
      while wk < shape.words do
        let wv = next
        next = next + 1
        word_vregs.push(wv)
        agg_word_slots.insert(wv, base + wk)
        wk = wk + 1
      end
      # FLOAT-FIELD word vregs (the float-field slice): every image word
      # that carries a Float/F32/F64 field — a plain-struct field or a
      # tagged-enum payload field, the gate's per-word class-consistency
      # rule guarantees the word's class and width are uniform across
      # the image — receives the field width's fp record, making it an
      # FP-class vreg whose statements ride the float slice's machinery
      # (the fixed memory-home slot stays the 8-byte image word; F32
      # field images live in the slot's low half like F32 locals).
      match kind
      when LirAggShapeKind::LirAggStruct(s) then
        var fi2 = 0
        while fi2 < s.fields.len() do
          let fty2 = s.fields[fi2].ty.clone()
          match lir_fp_width_of(fty2)
          when Option::Some(fw2) then
            fp_widths.insert(word_vregs[s.fields[fi2].word], fw2)
          when Option::None then ()
          end
          fi2 = fi2 + 1
        end
      when LirAggShapeKind::LirAggEnum(e) then
        var vi2 = 0
        while vi2 < e.variants.len() do
          var pj2 = 0
          while pj2 < e.variants[vi2].fields.len() do
            let pty2 = e.variants[vi2].fields[pj2].ty.clone()
            match lir_fp_width_of(pty2)
            when Option::Some(pw2) then
              fp_widths.insert(word_vregs[e.variants[vi2].fields[pj2].word], pw2)
            when Option::None then ()
            end
            pj2 = pj2 + 1
          end
          vi2 = vi2 + 1
        end
      end
      var name_index: Map[String, Int] = Map::new()
      var nk = 0
      while nk < shape.fields.len() do
        name_index.insert(shape.fields[nk].name.clone(), nk)
        nk = nk + 1
      end
      agg_of.insert(lid2, LirAggLocal {
        type_id: type_id,
        shape: shape,
        enum_shape: enum_shape,
        base_slot: base,
        word_vregs: word_vregs,
        name_index: name_index
      })
    when Option::None then ()
    end
    li2 = li2 + 1
  end
  LirLowerCtx {
    fn_name: f.name.clone(),
    local_tys: local_tys,
    widths_of: widths_of,
    fp_widths: fp_widths,
    vreg_of: vreg_of,
    next_vreg: next,
    agg_of: agg_of,
    agg_word_slots: agg_word_slots,
    next_agg_slot: next_agg_slot,
    block_stmts: block_stmts,
    block_terms: block_terms,
    sret_call_slots: sret_call_slots,
    agg_call_args: agg_call_args,
    scratch: scratch,
    scratch_fp32: scratch_fp32,
    scratch_fp64: scratch_fp64,
    div_ok: div_ok,
    param_stack_mode: param_stack_mode,
    cm_atomics: cm_atomics,
    rv_atomics: rv_atomics,
    rv_word64: rv_word64,
    trap_used: false,
    deinit_plans: deinit_plans,
    finalizer_names: finalizer_names,
    static_labels: static_labels,
    glue_head_ptr: Option::None,
    glue_value_local: Option::None,
    type_defs: type_defs,
    extra_blocks: Vec::new(),
    next_blk: -2
  }
end

# A fresh ordinary virtual register (lowered temporaries).
def lir_fresh_vreg(inout ctx: LirLowerCtx) -> Int
  let id = ctx.next_vreg
  ctx.next_vreg = id + 1
  id
end

# A fresh ordinary FLOATING-POINT virtual register of width `w`,
# registered in the ctx's class table (the fp_widths map is the class
# authority for ordinary ids — every FP vreg must be created through
# this helper or explicitly registered, never by lir_fresh_vreg alone).
def lir_fresh_fp_vreg(inout ctx: LirLowerCtx, w: LirFpWidth) -> Int
  let id = lir_fresh_vreg(ctx)
  ctx.fp_widths.insert(id, w)
  id
end

# The type of a MIR local by id (parameters included).
def lir_local_ty(ctx: LirLowerCtx, id: Int) -> Type
  match ctx.local_tys.get(id)
  when Option::Some(ty) then ty.clone()
  when Option::None then panic("lir_local_ty: no local " + id.to_string() + " in " + ctx.fn_name)
  end
end

# Virtual register for a scalar local (allocating one on first touch).
# Fail-closed for non-scalar locals (aggregate locals have no single
# vreg — their words are the fixed memory-home vregs of ctx.agg_of).
def lir_vreg_of_local(inout ctx: LirLowerCtx, id: Int) -> Result[Int, String]
  match ctx.vreg_of.get(id)
  when Option::Some(v) then Result::Ok(v)
  when Option::None then
    let ty = lir_local_ty(ctx, id)
    if lir_is_reg_word(ty) then
      let v = lir_fresh_vreg(ctx)
      match lir_fp_width_of(ty)
      when Option::Some(w) then ctx.fp_widths.insert(v, w)
      when Option::None then ()
      end
      ctx.vreg_of.insert(id, v)
      Result::Ok(v)
    else
      Result::Err("lir: local " + id.to_string() + " in " + ctx.fn_name + " is not a scalar local (no virtual register exists for it; plain-struct and tagged-enum aggregate locals live in fixed frame slots, and string/collection locals do not lower)")
    end
  end
end

# The fixed memory-home word vreg of an accepted aggregate local's
# image word (word 0 of a plain struct is its first field; word 0 of a
# tagged enum is the tag word, and payload words follow at their
# variant offsets).
def lir_agg_word_vreg(ctx: LirLowerCtx, local_id: Int, word: Int) -> Int
  match ctx.agg_of.get(local_id)
  when Option::Some(agg) then
    if word >= 0 && word < agg.word_vregs.len() then
      agg.word_vregs[word]
    else
      panic("lir: aggregate word " + word.to_string() + " out of range for local " + local_id.to_string() + " in " + ctx.fn_name)
    end
  when Option::None then
    panic("lir: local " + local_id.to_string() + " in " + ctx.fn_name + " is not an aggregate local")
  end
end

# The whole-aggregate LOCAL id referenced by a place, when the place is
# a whole plain-struct or tagged-enum local with EMPTY projections
# admitted in this function (ctx.agg_of): Option::Some(local id) then,
# Option::None for every other place shape (whole scalar/Unit locals,
# projected places). Used by lir_lower_call's aggregate-argument
# normalization: a place-form aggregate argument (MirCallValue::Place)
# and a value-form aggregate argument (a place-like operand over a
# constructed temporary's whole local — the temp's word group was
# filled by the construction's MirAssign before the call) normalize to
# the SAME source word group, which the argument's ABI slot then
# carries (its image address for the address-class struct arguments
# and the payloaded-enum arguments — the LIR-internal enum ABI — and
# its single word by value for the one-word Scalar-class struct
# arguments and the payload-less enum arguments).
def lir_whole_agg_local_id(ctx: LirLowerCtx, p: Place) -> Option[Int]
  if p.projections.len() == 0 then
    match ctx.agg_of.get(p.local.id)
    when Option::Some(_) then Option::Some(p.local.id)
    when Option::None then Option::None
    end
  else
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Generated drop-glue admission — the glue body contract
# ———————————————————————————————————————————————————————————————
# Every generated drop-glue function (mir.tg's
# mir_build_drop_glue_for_type — the (ptr: Ptr[T], mask: Int) bodies
# appended to MirProgram.functions for the concrete types with
# non-trivial deinit plans) has ONE fixed body shape:
#   entry block (block 0), FIRST statement:
#     value = *ptr          (a MirMove of the deref place of the
#                            Ptr-typed `ptr` parameter into the whole
#                            `value` aggregate local)
#   then: the plan walk (emit_plan_deinit over the value local, in the
#   mask_local mode) — per-field/per-payload initialized-bit gates
#   (Int BitAnd + MirSwitchInt over `mask & (1<<k)` — and the whole-
#   value `mask != 0` gate), MirDiscriminant + MirSwitchInt for enum
#   types, MirDeinit terminators over WHOLE value-local places (the
#   registered finalizer / child glue calls), and MirReturn — with NO
#   MirRef rvalues and NO address arithmetic: the walk addresses the
#   value local's projected PLACES and the addresses of child
#   destruction sites are formed at the MirDeinit call sites (this
#   route's MirDeinit slice does that through the aggregate-argument
#   word-group machinery), never as MIR values. (Read carefully:
#   "child finalizer calls with Ptr+mask args" exist only at the CALL
#   boundary — codegen's MirDeinit arm materializes the place address
#   + the -1 mask there; the LIR MirDeinit slice calls the registered
#   finalizer directly with the word-group address, which for the
#   reachable glue subset is the glue's whole observable.)
# Because the value image arrives at an ADDRESS (x0 — the ptr
# parameter's ONE ABI slot), this route does NOT compile the head copy
# as an ordinary whole-copy statement (no register-indirect load
# statement exists in the LIR statement set — and none is added here:
# the LirStmtKind enum is shared with the thumb/rv backends). Instead
# the copy is performed by the AGGREGATE-PARAMETER slice's machine-
# level ENTRY COPY: the lowering records one LirAggParamBind whose
# slot is the ptr parameter's general-class ABI slot, whose base_slot
# is the `value` local's fixed frame area and whose words are the
# value image's whole words — the emitter then loads [x_slot + 8k]
# into the value local's slots at function entry, byte-identical to
# the aggregate-param entry bind of an address-class by-value
# parameter of the same shape (the caller's image and the pointed-to
# image are both whole-word direct-layout images at the same byte
# offsets). The head-copy statement itself is skipped during lowering
# (lir_lower_agg_dst).
# The resolver below runs for every function whose name is in the
# program's glue-name set (MirProgram.drop_glue_fns values) and fails
# CLOSED when the body does not match the contract (a divergence from
# the builder's shape — never a silently mis-lowered copy).
def lir_resolve_glue_head_bind(inout ctx: LirLowerCtx, f: MirFunction, glue_names: Set[String]) -> Result[Unit, String]
  if !glue_names.contains(&f.name) then
    return Result::Ok(())
  end
  # The Ptr-typed parameter — the glue signature's `ptr` (exactly one;
  # the builder's mask parameter is Int).
  var ptr_param: Option[Int] = Option::None
  var pi = 0
  while pi < f.params.len() do
    if lir_is_ptr_word(f.params[pi].ty) then
      match ptr_param
      when Option::Some(_) then
        return Result::Err("lir: generated drop-glue function " + f.name + " carries more than one Ptr-typed parameter (the glue signature is (ptr: Ptr[T], mask: Int) — fail-closed)")
      when Option::None then ptr_param = Option::Some(f.params[pi].id.id)
      end
    end
    pi = pi + 1
  end
  match ptr_param
  when Option::None then
    return Result::Err("lir: generated drop-glue function " + f.name + " has no Ptr-typed parameter (the glue signature is (ptr: Ptr[T], mask: Int) — fail-closed)")
  when Option::Some(_) then ()
  end
  if f.blocks.len() == 0 then
    return Result::Err("lir: generated drop-glue function " + f.name + " has no blocks (fail-closed)")
  end
  # The head copy is the first EXECUTABLE statement of the entry block
  # (storage-live/dead annotations and nops may precede it — they have
  # no machine representation).
  var head_assign: Option[(Place, MirRvalue)] = Option::None
  var si = 0
  while si < f.blocks[0].statements.len() do
    match f.blocks[0].statements[si].kind
    when MirStatementKind::MirStorageLive(_) then ()
    when MirStatementKind::MirStorageDead(_) then ()
    when MirStatementKind::MirNop then ()
    when MirStatementKind::MirAssign(p, rv) then
      head_assign = Option::Some((p, rv))
      si = f.blocks[0].statements.len() + 1
    when _ then
      return Result::Err("lir: generated drop-glue function " + f.name + " entry block starts with a non-assignment statement (the builder emits `value = *ptr` as its first statement — fail-closed)")
    end
    si = si + 1
  end
  match head_assign
  when Option::None then
    return Result::Err("lir: generated drop-glue function " + f.name + " entry block has no head copy assignment (the builder emits `value = *ptr` as its first statement — fail-closed)")
  when Option::Some((dst_place, rvalue)) then
    if dst_place.projections.len() != 0 then
      return Result::Err("lir: generated drop-glue function " + f.name + " head copy writes a projected place (the builder writes the whole `value` local — fail-closed)")
    end
    let dst_id = dst_place.local.id
    match ctx.agg_of.get(dst_id)
    when Option::None then
      return Result::Err("lir: generated drop-glue function " + f.name + " head copy destination is not an admitted aggregate local (its value image cannot bind through the aggregate-param entry copy — fail-closed)")
    when Option::Some(_) then ()
    end
    match rvalue.kind
    when MirRvalueKind::MirMove(op) then
      let src_ok = match op.kind
      when MirOperandKind::MirCopy(p) then lir_is_deref_of_local(p, ptr_param)
      when MirOperandKind::MirMovePlace(p) then lir_is_deref_of_local(p, ptr_param)
      when MirOperandKind::MirRead(p) then lir_is_deref_of_local(p, ptr_param)
      when MirOperandKind::MirConsume(p) then lir_is_deref_of_local(p, ptr_param)
      when _ then false
      end
      if src_ok then
        ctx.glue_head_ptr = ptr_param
        ctx.glue_value_local = Option::Some(dst_id)
        Result::Ok(())
      else
        Result::Err("lir: generated drop-glue function " + f.name + " head copy source is not the deref of its Ptr-typed parameter (the builder copies `*ptr` — fail-closed)")
      end
    when _ then
      Result::Err("lir: generated drop-glue function " + f.name + " entry block does not start with the head copy rvalue (the builder emits `value = *ptr` as its first statement — fail-closed)")
    end
  end
end

# Is place `p` the deref of the whole local `local_id` (p == *local_id)?
def lir_is_deref_of_local(p: Place, local_id: Option[Int]) -> Bool
  var ok = false
  match local_id
  when Option::Some(lid) then
    if p.local.id == lid && p.projections.len() == 1 then
      match p.projections[0]
      when Projection::ProjDeref then ok = true
      when _ then ()
      end
    end
  when Option::None then ()
  end
  ok
end

# Fail-closed whole-function shape check (types/params/return/contracts).
# `width_ok` is the aarch64-route width gate: the sized integer types
# (I8/I16/I32/U8/U16/U32/ISize/USize), Bool crossing the ABI AND the
# float types (Float/F32/F64 — the float slice) lower
# only on the aarch64 route (the thumb/rv word-only entries keep the
# word-only accept set — Int/UInt/Unit shapes, Int/UInt/Bool locals —
# because their emitters' width model predates this one; their float
# rejections name the aarch64-route rule; the SIZED integer and Bool
# forms additionally open on the cortex-m and riscv routes through
# the cm_atomics / rv_atomics surface flags below — see the
# pointer/atomic-slice note and the atomic-surface arms). `fp_ok` is the
# cortex-m float admission (lower_mir_fn_to_lir_cm passes true, every
# other entry false): it opens the FLOAT forms of the cortex-m float
# slice — the LOCAL forms (with the register-resident float statements
# of the cortex-m backend's float slice; backend_thumb.tg resolves
# float operands through thumb_fp_d_of and fails closed on
# memory-resident ones) since the float-body slice, and, since the
# float-ABI slice, the PARAMETER and RETURN forms: their crossings
# bind through the LIR-internal float ABI the aarch64 route uses (the
# fixed float vregs 8..15 = d0..d7 by float position; the FP return
# value crosses in the fixed float vreg 8 = d0/s0) under the AAPCS32
# caller-stack mode — see the entry-binding walk in
# lower_mir_fn_to_lir_mode_ty for the geometry. The thumb/rv routes
# (fp_ok false) keep the word-only accept set with the rule-naming
# rejections below. `type_defs` is the
# program's MirTypeDef table (MirTypeDef.id -> def), needed to admit
# plain-struct AND tagged-enum aggregate locals AND parameters; routes
# that carry no table reject every aggregate local/parameter with a
# rule-naming reason. Aggregate parameters open exactly where the
# aggregate locals do — the aarch64 program route
# (lower_mir_fn_to_lir_prog). Plain-struct parameters admit BOTH image
# classes, mirroring the plain-struct return gate: the ADDRESS-class
# images (16-byte ScalarPair / ByAddress over 8 bytes, the mirror of
# the aggregate-return gate's sret admission; their binding is the
# aggregate-param slice at function entry — the machine-level
# image-address copy) and the Scalar-class one-word images (<= 8
# bytes, the register-class slice: the parameter's single word
# arrives BY VALUE in its ONE slot and binds through an entry
# STATEMENT like a scalar). TAGGED-ENUM
# parameters admit BOTH image forms under the LIR-internal enum ABI
# (see the sret-return slice section and lir_enum_crossing_rule): the
# PAYLOAD-LESS image, whose whole value is the raw-discriminant tag
# word, crosses BY VALUE in the parameter's ONE slot like a scalar
# word, and a PAYLOADED image crosses BY REFERENCE — one slot carrying
# the caller's inline image address, the words copied into the
# parameter's fixed frame slots at entry exactly like an
# address-class plain-struct parameter (a LirAggParamBind record). The
# direct pipeline's enum ABI (classify_value_category's EnumLayout
# arm) crosses every registered enum as its ONE TaggedPtr value word
# (Scalar(8) — raw discriminant below the inline-tag threshold, heap
# pointer above); this slice mirrors the payload-less value word
# exactly and replaces the payloaded image's unrepresentable
# heap-pointer word with the by-reference image crossing — a
# divergence that is coherent between LIR-compiled functions (the
# route is whole-program and self-contained) and fails closed at the
# extern boundary, where the direct value-word convention applies
# (see lir_check_extern_enum_calls).
#
# GENERATED DROP-GLUE ADMISSION (the Ptr-word rule): `glue_names` is
# the name set of the program's generated drop-glue functions
# (MirProgram.drop_glue_fns values — the (ptr: Ptr[T], mask: Int)
# functions mir_build_drop_glue_for_type appends to MirProgram.
# functions; every other route/entry passes an empty set). A function
# whose name is in that set is a generated glue body and admits a
# Ptr-typed PARAMETER as an opaque 64-bit address word — the
# whole-word model applies (an address rides a general-class ABI slot
# and a vreg/slot exactly like an Int word; nothing in LIR dereferences
# through the type system, so no pointer semantics are ever attached).
# The address word is bound at machine level, not by a scalar bind:
# the glue body's head copy (`value = *ptr` — see
# lir_resolve_glue_head_bind) turns the parameter's ONE ABI slot into
# an entry copy of the pointed-to image into the `value` local's fixed
# frame slots, exactly like an address-class aggregate parameter.
#
# POINTER/ATOMIC SLICE (the Ptr-word rule GENERALIZED — see the
# marker/LirPtrOp section and the atomic-call lowering section): on
# the aarch64 whole-program route the pointer-word admission extends
# to the WHOLE function surface — Ptr/PtrMut/RefInternal PARAMETERS,
# LOCALS and RETURNS are opaque 64-bit address words on that route
# (lir_is_ptr_word; the parameter/local gates admit them wherever a
# scalar word is admitted, and they bind, assign and return through
# the ordinary word machinery), the CORTEX-M route opens the SAME
# surface at its 4-byte word size through the cm_atomics shape-gate
# flag (the cortex-m atomic slice — opaque 32-bit address words on
# that route; see the shape-gate doc and the backend_thumb.tg atomic
# section), and the RISCV route opens it through the rv_atomics flag
# at the route's machine word — opaque 32-bit address words on
# riscv32 (rv_word64 false, the cortex-m word model) and opaque
# 64-bit address words on riscv64 (rv_word64 true; see the shape-gate
# doc and the backend_rv.tg atomic section). MirRef (address-of) rvalues lower as
# the addressed place's frame-slot LEA (scalar places under an
# address-of are FORCED to fixed frame slots, so the address stays
# stable) or as the base-word + byte-offset of a deref word place;
# deref places over Ptr/PtrMut/RefInternal word locals lower their ONE
# scalar word through marked register-indirect loads/stores
# (LirPtrLoad/LirPtrStore — reads materialize at the read sites, never
# cached), and the atomic-intrinsic calls
# (__intrinsic_atomic_<op>_u<width>) lower INLINE as the per-ordering
# LSE/load/store sequences (LirAtomLoad/LirAtomStore/LirAtomRmw/
# LirAtomCas) with codegen.tg's exact arm table — static arms when the
# ordering word is an MIR constant, otherwise a LirSwitch per-ordering
# dispatch over synthetic arm/merge blocks — and the widthless fence
# (__intrinsic_atomic_fence) as the per-ordering DMB fence statement
# (LirPtrOp::LirPtrFence). The aarch64 route emits those marked forms
# as LSE/load/store instructions (lir_emit_ptr_stmt); the cortex-m
# route emits them as ARMv7-M LDREX/STREX/DMB sequences
# (backend_thumb.tg's pointer/atomic statement section); the riscv
# route emits them as A-extension LR/SC loops with the FENCE ordering
# fences (backend_rv.tg's pointer/atomic statement section). The soundness note is the
# glue note's: LIR never dereferences THROUGH its type system, so
# address words only ever ride the word model, and every memory access
# through them is the explicit machine-level form the lowering emits.
# The thumb/rv word-only routes (the plain lower_mir_fn_to_lir entry)
# and the table-less aarch64 entries keep the pointer rejections
# (their shape gates admit no pointer words, so the MirRef/deref/
# atomic forms never lower there); the cortex-m and riscv routes open
# the same surface through the cm_atomics / rv_atomics flags below.
# The non-width-ok route rejection of a return form that only an
# atomic-surface flag opens (cm_atomics / rv_atomics): the message
# names the route through fp_ok (the cm float admission flag — true
# only on the cortex-m route), the surface flags and the concrete
# form rule.
def lir_atomic_ret_reject(fname: String, fp_ok: Bool, cm_atomics: Bool, rv_atomics: Bool, form_desc: String) -> String
  if rv_atomics then
    "lir: function " + fname + " returns an unsupported type on the riscv route with its atomic surface open (only Unit/Int/UInt and the atomic-surface words Bool/I8/I16/I32/U8/U16/U32/ISize/USize/Ptr/PtrMut/RefInternal returns lower; " + form_desc + " - fail-closed)"
  elsif fp_ok then
    "lir: function " + fname + " returns an unsupported type on the cortex-m route (only Unit/Int/UInt and the float types Float/F32/F64 returns lower; " + form_desc + " - fail-closed)"
  else
    "lir: function " + fname + " returns an unsupported type on this route (thumb/rv routes: Int/UInt words only; " + form_desc + " - fail-closed)"
  end
end

# The per-function shape gate: every type in the function's surface
# (return, parameters, locals) must belong to the route's accept set,
# with the concrete rule named in the Err. `width_ok` opens the
# aarch64 width accept set (the sized integers, aggregate returns/
# params via `type_defs`, pointer words). `cm_atomics` opens the
# CORTEX-M atomic-surface accept set of the otherwise word-only route:
# the pointer/ref words (Ptr/PtrMut/RefInternal — the opaque 4-byte
# address words of the 32-bit route), the sized integer words of the
# atomic data kinds I8/I16/I32/U8/U16/U32 (their storage is at most
# the 4-byte machine word — no width exceeds the 32-bit register
# model), Bool parameters/returns (compare_exchange results), and the
# ISize/USize returns (their 64-bit-width kinds are machine words on
# this route, mirroring the already-admitted locals/params).
# `rv_atomics` opens the SAME accept set on the RISCV route (both
# riscv xlens — the set is xlen-independent: the 64-bit-width kinds
# ride the base word arms, the sized atomic data kinds are at most
# the 8-byte riscv64 machine word, and the _u64 atomic WIDTHS are
# admitted at lowering by the rv_word64 half of the route flag — see
# lir_lower_atomic_call — while the backend's rv_validate_fn applies
# the per-xlen instruction widths). Both surface flags are false on
# the a64 routes (whose width-ok arms govern) and on the plain
# thumb/rv word-only entries (which keep every rejection below).
def lir_check_fn_shape(f: MirFunction, width_ok: Bool, fp_ok: Bool, cm_atomics: Bool, rv_atomics: Bool, type_defs: Map[Int, MirTypeDef], glue_names: Set[String]) -> Result[Unit, String]
  if width_ok then
    match f.ret_type
    when Type::Unit then ()
    when Type::Int then ()
    when Type::UInt then ()
    when Type::Bool then ()
    when Type::I8 then ()
    when Type::I16 then ()
    when Type::I32 then ()
    when Type::U8 then ()
    when Type::U16 then ()
    when Type::U32 then ()
    when Type::ISize then ()
    when Type::USize then ()
    when Type::Float then ()
    when Type::F32 then ()
    when Type::F64 then ()
    when Type::Ptr(_) then
      # (pointer/atomic slice — the pointer-word return admission): a
      # Ptr/PtrMut-typed return is an OPAQUE 64-bit address word (see
      # lir_is_ptr_word) — it crosses back in x0 through the ordinary
      # scalar-return machinery exactly like any word. (RefInternal
      # returns never exist in typed MIR — the verifier rejects a
      # function returning a ref value.)
      ()
    when Type::PtrMut(_) then
      ()
    when _ then
      # The aggregate-return gate (aggregate returns, aarch64 program
      # route): an admitted PLAIN-STRUCT return type lowers when its
      # image takes EITHER aggregate-return ABI class — the Scalar
      # class (<= 8 bytes, one word in x0: the register-class slice —
      # every Ret loads the return aggregate's single word into x0 like
      # a scalar return) or an sret class (exactly 16 bytes (ScalarPair)
      # or more than 8 bytes (ByAddress): the sret-return slice below,
      # whose callee side copies the words out through x8). An admitted
      # TAGGED-ENUM return type lowers in BOTH forms under the
      # LIR-internal enum ABI: the payload-less 8-byte tag-word image
      # crosses in x0 exactly like a Scalar-class plain struct (its
      # every Ret loads the tag word like any one-word return), and a
      # PAYLOADED image — 16 bytes or more — crosses through the same
      # sret x8 machinery as an sret-class plain struct (the direct
      # pipeline's enum returns, by contrast, are ONE Scalar(8)
      # TaggedPtr value word — the heap-pointer form a payloaded image
      # would take there is what this slice's inline images replace;
      # see the sret-return slice section and lir_enum_crossing_rule).
      # Every
      # other return type fails closed with the concrete missing rule:
      # the shape gate's own reason when the type is an aggregate shape
      # this slice rejects (sub-word/@packed/@align layouts, zero-field
      # structs, zero-variant enums — the ZeroSized images codegen
      # never returns — tuples, fixed arrays, or "no MirTypeDef record"
      # on the a64 entries that carry no program type-def table), and
      # the original
      # unsupported-type reason for non-aggregate types
      # (Char/pointers/strings).
      match lir_plain_struct_shape(type_defs, f.ret_type)
      when Result::Err(e) then
        return Result::Err("lir: function " + f.name + " returns " + e)
      when Result::Ok(o) then
        match o
        when Option::Some(LirAggShapeKind::LirAggStruct(shape)) then
          if lir_agg_sret_words(shape) > 0 then
            ()
          elsif lir_agg_is_scalar_class(shape) then
            ()
          else
            return Result::Err("lir: function " + f.name + " returns a plain struct whose admitted image classifies as neither the Scalar class (<= 8 bytes — one word in x0) nor an sret class (exactly 16 bytes or more than 8 bytes — the x8 copy-out); no admitted whole-word shape lands between the two, so this is a shape-gate divergence (fail-closed)")
          end
        when Option::Some(LirAggShapeKind::LirAggEnum(eshape)) then
          # The tagged-enum return admission, under the LIR-internal
          # enum ABI (see the sret-return slice section and
          # lir_enum_crossing_rule): BOTH image classes lower. A
          # payload-less image (<= 8 bytes — exactly the one tag word)
          # crosses through the Scalar-class x0 machinery, its every
          # Ret loading the tag word from the return local's fixed
          # frame slot like any one-word return. A PAYLOADED image
          # (>= 16 bytes — whole words only, so the class split is
          # exact) crosses through the SAME sret x8 machinery a
          # 16-byte/> 8-byte plain-struct return uses: the callee's
          # every Ret copies the image words out to the
          # caller-supplied x8 buffer (the LIR callee receives x8
          # because its caller classified the destination the same
          # way — both sides of this self-contained route agree; the
          # DIRECT pipeline, by contrast, crosses every registered
          # enum as ONE Scalar(8) TaggedPtr VALUE word — raw
          # discriminant or heap pointer — which is why a payloaded
          # image can never ride the direct x0 crossing convention).
          if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) || lir_agg_sret_words(lir_enum_image_shape(eshape)) > 0 then
            ()
          else
            return Result::Err("lir: function " + f.name + " returns a tagged enum whose admitted image classifies as neither the Scalar class (<= 8 bytes — the payload-less 8-byte tag-word image, one word in x0) nor an sret class (exactly 16 bytes or more than 8 bytes — the payloaded image, copied out through the caller-supplied x8 buffer); no admitted whole-word enum image lands between the two, so this is a shape-gate divergence (fail-closed)")
          end
        when Option::None then
          return Result::Err("lir: function " + f.name + " returns an unsupported type (supported returns: Unit, the scalar words Int/UInt/Bool/ISize/USize/I8/I16/I32/U8/U16/U32, the floats Float/F32/F64, plus plain-struct aggregates of the scalar words and the floats (a one-word image whose word is a float field crosses its word on the float stream) — a Scalar-class image (<= 8 bytes) crosses as one word in x0 and an sret image (exactly 16 bytes or more than 8 bytes) crosses through the caller-supplied x8 buffer — and TAGGED-ENUM images, which cross under the LIR-internal enum ABI: the payload-less 8-byte tag-word image as one word in x0 and a payloaded image through the same x8 buffer machinery (see lir_enum_crossing_rule for the divergence from the direct pipeline's one-word TaggedPtr enum crossing); tuple/fixed-array returns and Char/pointer/string returns are not implemented)")
        end
      end
    end
  else
    match f.ret_type
    when Type::Unit then ()
    when Type::Int then ()
    when Type::UInt then ()
    when Type::Float then
      # The cortex-m float-RETURN admission (fp_ok — the cm route only):
      # a scalar-class float return lowers exactly like the aarch64
      # route's — the MirReturn Ret term carries the return float's
      # ordinary vreg and the value crosses in the fixed float ABI
      # register d0/s0 (fixed vreg 8) at the emitter, see the LirRet
      # doc (the thumb emitter's float-return arm is the emitter-side
      # half of this ABI, pending with the call-side slice).
      if !fp_ok then
        return Result::Err("lir: function " + f.name + " returns a floating-point type on a route whose shape gate keeps the word-only accept set (thumb/rv routes: float returns are not implemented there; the float slice is an aarch64-route and cortex-m-route rule)")
      end
    when Type::F32 then
      if !fp_ok then
        return Result::Err("lir: function " + f.name + " returns a floating-point type on a route whose shape gate keeps the word-only accept set (thumb/rv routes: float returns are not implemented there; the float slice is an aarch64-route and cortex-m-route rule)")
      end
    when Type::F64 then
      if !fp_ok then
        return Result::Err("lir: function " + f.name + " returns a floating-point type on a route whose shape gate keeps the word-only accept set (thumb/rv routes: float returns are not implemented there; the float slice is an aarch64-route and cortex-m-route rule)")
      end
    when Type::Bool then
      # (atomic surface): the compare_exchange intrinsic's Bool result —
      # a word crossing like any scalar — is admitted on the cortex-m
      # route (cm_atomics) and on the riscv route (rv_atomics) with the
      # atomic slice. The aarch64 route admits Bool through its width-ok
      # arm; the plain word-only routes keep the rejection below.
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the Bool return form opens with the cortex-m/riscv atomic surface"))
      end
    when Type::I8 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::I16 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::I32 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::U8 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::U16 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::U32 then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the sized integer returns open with the cortex-m/riscv atomic surface (atomic data widths 1/2/4 bytes — 8 too on riscv64)"))
      end
    when Type::ISize then
      # (atomic surface): ISize/USize are 64-bit-width kinds whose
      # machine image on the 32-bit cortex-m/riscv32 routes is the 4-byte
      # word (the full 8-byte word on riscv64) — their locals/params are
      # already admitted; the return form opens with the atomic surface
      # for parity.
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the ISize/USize return form opens with the cortex-m/riscv atomic surface"))
      end
    when Type::USize then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the ISize/USize return form opens with the cortex-m/riscv atomic surface"))
      end
    when Type::Ptr(_) then
      # (atomic surface): a pointer/ref-word return is an OPAQUE address
      # word crossing through the ordinary scalar-return machinery — the
      # aarch64 route's pointer-word return admission (width-ok arm
      # above) mirrored on the 32-bit routes (4-byte words) and on
      # riscv64 (8-byte words).
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the pointer/ref-word return form opens with the cortex-m/riscv atomic surface"))
      end
    when Type::PtrMut(_) then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the pointer/ref-word return form opens with the cortex-m/riscv atomic surface"))
      end
    when Type::RefInternal(_, _) then
      if !cm_atomics && !rv_atomics then
        return Result::Err(lir_atomic_ret_reject(f.name, fp_ok, cm_atomics, rv_atomics, "the pointer/ref-word return form opens with the cortex-m/riscv atomic surface"))
      end
    when _ then
      if rv_atomics then
        return Result::Err("lir: function " + f.name + " returns an unsupported type on the riscv route (only Unit/Int/UInt and the atomic-surface words Bool/I8/I16/I32/U8/U16/U32/ISize/USize/Ptr/PtrMut/RefInternal returns lower; float/aggregate and every other type stay fail-closed)")
      end
      if fp_ok then
        if cm_atomics then
          return Result::Err("lir: function " + f.name + " returns an unsupported type on the cortex-m route (only Unit/Int/UInt, the float types Float/F32/F64 and the atomic-surface words Bool/I8/I16/I32/U8/U16/U32/ISize/USize/Ptr/PtrMut/RefInternal returns lower; aggregates and every other type stay fail-closed)")
        end
        return Result::Err("lir: function " + f.name + " returns an unsupported type on the cortex-m route (only Unit/Int/UInt and the float types Float/F32/F64 returns lower; the sized integer, Bool and aggregate return forms are aarch64-route rules — fail-closed)")
      end
      return Result::Err("lir: function " + f.name + " returns an unsupported type on this route (only Unit/Int/UInt returns lower on the thumb/rv routes; the sized integer, Bool and float ABI forms are aarch64-route rules)")
    end
  end
  var pi = 0
  while pi < f.params.len() do
    let pty = f.params[pi].ty
    # (pointer/atomic slice — the pointer-word PARAMETER admission, the
    # drop-glue admission generalized to the aarch64 route and opened
    # on the cortex-m route by the atomic surface and on the riscv
    # route by rv_atomics): a
    # Ptr/PtrMut/RefInternal-typed parameter is an opaque 64-bit
    # address word on the aarch64 route, an opaque 4-byte address
    # word on the cortex-m and riscv32 routes, and an opaque 8-byte
    # address word on the riscv64 route (see lir_is_ptr_word) — it
    # crosses in ONE general-class ABI slot like any word and binds at
    # function entry like a scalar word (a RefInternal parameter is the
    # internal-ABI reference form the checker re-wraps `inout`/ref
    # parameters into; its address word arrives in the slot). The
    # generated drop-glue functions' (ptr: Ptr[T], mask: Int) `ptr`
    # parameters are exactly this admission on the aarch64 route — their
    # head-copy entry
    # bind (lir_resolve_glue_head_bind) keeps working, now over a word
    # that ALSO binds into a vreg like any scalar. Every OTHER pointer
    # form (deref through a non-word base, MirRef over aggregate
    # images the gate rejects) still fails closed at its own gate.
    let ptr_ok = (width_ok || cm_atomics || rv_atomics) && lir_is_ptr_word(pty)
    let ok = if ptr_ok then
      true
    else
      if width_ok then
        lir_is_scalar_word(pty) || lir_is_fp_type(pty)
      else
        # The non-width-ok accept set: the route's machine words
        # (Int/UInt — 64-bit-width kinds on this route's 32-bit word
        # model) plus, under the cortex-m float admission (fp_ok), the
        # float types Float/F32/F64 — the float-PARAMETER admission of
        # this slice, the entry-binding walk's counterpart to the
        # caller-side per-class float walk (see the walk in
        # lower_mir_fn_to_lir_mode_ty). Under the cortex-m ATOMIC
        # surface (cm_atomics) and the RISCV atomic surface
        # (rv_atomics) the pointer/ref words (the opaque
        # 4-byte addresses the atomic intrinsics take on the 32-bit
        # routes, 8-byte on riscv64), the sized
        # integer words of the atomic data kinds (widths <= 32 bits —
        # at most the 4-byte machine word on the 32-bit routes, within
        # the 8-byte riscv64 word) and Bool (the CAS results)
        # are additionally admitted; the ptr_ok test above lets the
        # same pointer words bind like any scalar word.
        (lir_is_int_word(pty) && lir_int_width_bits(pty) == 64) || (fp_ok && lir_is_fp_type(pty)) || ((cm_atomics || rv_atomics) && ((lir_is_int_word(pty) && lir_int_width_bits(pty) <= 32) || lir_is_bool_word(pty)))
      end
    end
    if !ok then
      if width_ok then
        # The aggregate-param gate (aggregate params, aarch64 program
        # route): an admitted plain-struct PARAMETER lowers when its
        # image takes EITHER aggregate-parameter ABI category. An
        # ADDRESS-class image — exactly 16 bytes (ScalarPair) or more
        # than 8 bytes (ByAddress); the callee receives the image's
        # address in the parameter's ONE ABI slot (the parameter's
        # GP-class position — see the ABI walk note in lir_lower_call —
        # the codegen.tg classify_argument order for float-free
        # signatures) and the machine-level entry copy binds the words
        # into the parameter's aggregate frame slots (the
        # aggregate-param slice below — the mirror of the aggregate-
        # return gate's ScalarPair/ByAddress (address-class) admission
        # on the PARAMETER side). A Scalar-class image (<= 8 bytes —
        # the register-class slice: every admitted <= 8-byte
        # plain-struct image is exactly its ONE word, a single
        # whole-word field; whole-word fields only, so no smaller image
        # can carry two) crosses BY VALUE as that word in the
        # parameter's ONE ABI slot, and the entry binding walks it into
        # the parameter's fixed word-0 vreg like a scalar word — the
        # register-class plain-struct parameter admission, the mirror
        # of the payload-less tagged-enum parameter binding below. A
        # PAYLOAD-LESS TAGGED-ENUM parameter lowers in the register
        # class the same way — the direct pipeline crosses enum
        # parameters as their one Scalar(8) value word, which this
        # slice represents as the raw-discriminant tag word (bound from
        # the parameter's ABI slot at entry like a scalar word) — and a
        # PAYLOADED tagged-enum parameter lowers in the ADDRESS class
        # (the LIR-internal enum ABI: one slot carrying the caller's
        # image address, the words copied in at entry like an
        # address-class plain struct; see lir_enum_crossing_rule for
        # the divergence from the direct pipeline's TaggedPtr
        # value-word crossing).
        # Every other non-scalar parameter type fails closed with the
        # concrete missing rule: the shape gate's own reason when the
        # type is an aggregate shape this slice rejects (tuples,
        # fixed arrays, @packed/@align layouts, zero-field structs,
        # sub-word fields sharing or straddling an 8-byte word — the
        # two-small-fields structs that would pack into one word at
        # offsets 0 and 4 fail here with the shape gate's field-offset
        # reason, their layout never clearing the gate — or "no
        # MirTypeDef record" on the a64 entries that carry no program
        # type-def table), the payloaded-enum divergence
        # (extern-boundary crossings only — see
        # lir_check_extern_enum_calls), and the unsupported-type
        # reason for non-aggregate types (Char/pointers/strings).
        match lir_plain_struct_shape(type_defs, pty)
        when Result::Err(e) then
          return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + ": " + e)
        when Result::Ok(o) then
          match o
          when Option::Some(LirAggShapeKind::LirAggStruct(shape)) then
            if lir_agg_sret_words(shape) > 0 then
              ()
            elsif lir_agg_is_scalar_class(shape) then
              ()
            else
              return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " is a plain struct whose admitted image classifies as neither an sret class (exactly 16 bytes or more than 8 bytes — bound through the slot-carried image address) nor the Scalar class (<= 8 bytes — its one word crossing by value in the parameter's slot); no admitted whole-word shape lands between the two, so this is a shape-gate divergence (fail-closed)")
            end
          when Option::Some(LirAggShapeKind::LirAggEnum(eshape)) then
            # The tagged-enum parameter admission, under the LIR-
            # internal enum ABI (see the sret-return slice section and
            # lir_enum_crossing_rule): the payload-less image's raw-
            # discriminant tag word crosses BY VALUE in the parameter's
            # ONE slot exactly like a scalar word (bound from the slot
            # at entry — see the binding walk), while a PAYLOADED
            # image crosses BY REFERENCE, mirroring the address-class
            # plain-struct parameter: it consumes ONE general-class
            # slot carrying the caller's inline image ADDRESS and the
            # machine-level entry copy (a LirAggParamBind record) moves
            # the image words into the parameter aggregate's fixed
            # frame slots at function entry. (The direct pipeline, by
            # contrast, crosses every registered enum parameter as its
            # one TaggedPtr value word — for a payloaded enum a heap
            # pointer this slice never materializes.)
            if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) || lir_agg_sret_words(lir_enum_image_shape(eshape)) > 0 then
              ()
            else
              return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " is a tagged enum whose admitted image classifies as neither the Scalar class (<= 8 bytes — the payload-less tag word, crossing by value in the parameter's slot) nor an sret class (exactly 16 bytes or more than 8 bytes — the payloaded image, crossing as its address in the parameter's slot); no admitted whole-word enum image lands between the two, so this is a shape-gate divergence (fail-closed)")
            end
          when Option::None then
            return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " has an unsupported type on the aarch64 route (supported parameters: the scalar words Int/UInt/Bool/ISize/USize/I8/I16/I32/U8/U16/U32, the floats Float/F32/F64, plus — where the route carries the program type-def table — plain-struct aggregates of the scalar words and the floats with an ADDRESS-class image — exactly 16 bytes or more than 8 bytes, bound at entry from the slot-carried image address — or a Scalar-class image (<= 8 bytes, the single-whole-word-field structs), whose one word arrives BY VALUE in its slot (a one-word image whose word is a FLOAT field crosses that word on the float stream at the field's width — see the float-field slice), and TAGGED-ENUM parameters, which cross under the LIR-internal enum ABI: a payload-less enum's raw-discriminant tag word arrives by value in its slot, a payloaded enum's caller-image address arrives in its slot (see lir_enum_crossing_rule); Char/pointer/string parameters are not implemented)")
          end
        end
      else
        if lir_is_fp_type(pty) then
          # (fp_ok — the cortex-m route — admits floats in the `ok`
          # test above, so this arm is reached only on the thumb/rv
          # word-only routes and on the riscv atomic surface, which
          # admits no floats.)
          return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " is a floating-point parameter on a route whose shape gate keeps the word-only accept set (thumb/rv routes: float parameters are not implemented there; the float slice is an aarch64-route and cortex-m-route rule)")
        end
        if rv_atomics then
          return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " has an unsupported type on the riscv route (Int/UInt words, the atomic-surface words Bool/I8/I16/I32/U8/U16/U32/ISize/USize and the pointer/ref words Ptr/PtrMut/RefInternal only; float/aggregate and every other type stay fail-closed)")
        end
        if fp_ok then
          if cm_atomics then
            return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " has an unsupported type on the cortex-m route (Int/UInt words, the float types Float/F32/F64, the atomic-surface words Bool/I8/I16/I32/U8/U16/U32/ISize/USize and the pointer/ref words Ptr/PtrMut/RefInternal only; aggregates and every other type stay fail-closed)")
          end
          return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " has an unsupported type on the cortex-m route (Int/UInt words and the float types Float/F32/F64 only; Bool, sized-integer and aggregate parameter forms are aarch64-route rules — fail-closed)")
        end
        return Result::Err("lir: parameter " + f.params[pi].name + " of " + f.name + " has an unsupported type on this route (thumb/rv routes: Int/UInt words only; the sized/aggregate ABI forms are aarch64-route rules)")
      end
    end
    pi = pi + 1
  end
  var li = 0
  while li < f.locals.len() do
    let lty = f.locals[li].ty
    # Unit is allowed on the aarch64 route as the "_ret" return-place
    # type of a Unit-returning function (start_function always creates
    # locals[0] with the declared return type); Unit locals have no
    # machine representation and assignments into them lower to no-ops.
    # (pointer/atomic slice — the pointer-word LOCAL admission): a
    # Ptr/PtrMut/RefInternal-typed local (parameters included —
    # parameters are locals in this MIR) is an opaque address word on
    # the aarch64 route and on the riscv atomic surface (see
    # lir_is_ptr_word), admitted by the same rule as the parameter
    # gate. MirRef (address-of) rvalues and deref
    # places (the pointer/atomic slice's lowering) define and read such
    # locals; every deref through a non-word base still fails closed at
    # the place gates.
    let ptr_local_ok = (width_ok || cm_atomics || rv_atomics) && lir_is_ptr_word(lty)
    if width_ok then
      if !ptr_local_ok && !lir_is_scalar_word(lty) && !lir_is_unit_word(lty) && !lir_is_fp_type(lty) then
        match lir_plain_struct_shape(type_defs, lty)
        when Result::Err(e) then
          return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + ": " + e)
        when Result::Ok(o) then
          match o
          when Option::Some(_) then ()
          when Option::None then
            return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " has an unsupported type on the aarch64 route (supported locals: the scalar words Int/UInt/Bool/ISize/USize/I8/I16/I32/U8/U16/U32, the floats Float/F32/F64, the pointer/ref words Ptr/PtrMut/RefInternal, Unit, plain structs of the scalar words and the floats (whole-word-per-field shapes), and tagged enums whose variant payloads are whole-word scalars (floats included); Char/I64/U64/I128/U128/string and unresolved generic-parameter locals do not lower)")
          end
        end
      end
    else
      # The non-width-ok local accept set: Int/UInt/ISize/USize
      # (64-bit-width kinds whose image is the 4-byte machine word) and
      # Bool; under the cortex-m float admission (fp_ok) the float
      # types; under the cortex-m ATOMIC surface (cm_atomics) and the
      # RISCV atomic surface (rv_atomics) the
      # pointer/ref words (opaque 4-byte addresses on the 32-bit
      # routes, 8-byte on riscv64 — ptr_local_ok
      # above) and the sized integer words of the atomic data kinds
      # (I8..U32 — widths at most the 4-byte machine word on the
      # 32-bit routes, within the 8-byte riscv64 word).
      let ok = (lir_is_int_word(lty) && lir_int_width_bits(lty) == 64) || lir_is_bool_word(lty) || (fp_ok && lir_is_fp_type(lty)) || ((cm_atomics || rv_atomics) && (lir_is_ptr_word(lty) || (lir_is_int_word(lty) && lir_int_width_bits(lty) <= 32)))
      if !ok then
        if lir_is_fp_type(lty) then
          # Only reachable when fp_ok is false (a float local was
          # admitted above whenever the route opens the float bodies;
          # the riscv atomic surface admits no floats).
          return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " is a floating-point local on a route whose shape gate keeps the word-only accept set (thumb/rv routes: float locals are not implemented there; the float slice is an aarch64-route and cortex-m-route rule)")
        end
        if rv_atomics then
          return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " has an unsupported type on the riscv route (Int/UInt/Bool words, the atomic-surface words I8/I16/I32/U8/U16/U32/ISize/USize and the pointer/ref words Ptr/PtrMut/RefInternal lower as locals; float/aggregate and every other type stay fail-closed)")
        end
        if fp_ok then
          if cm_atomics then
            return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " has an unsupported type on the cortex-m route (Int/UInt/Bool words, the float types Float/F32/F64, the atomic-surface words I8/I16/I32/U8/U16/U32/ISize/USize and the pointer/ref words Ptr/PtrMut/RefInternal lower as locals; aggregates and every other type stay fail-closed)")
          end
          return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " has an unsupported type on the cortex-m route (Int/UInt/Bool words and the float types Float/F32/F64 lower as locals; sized integer and aggregate local forms are aarch64-route rules)")
        end
        return Result::Err("lir: local " + f.locals[li].name + " of " + f.name + " has an unsupported type on this route (thumb/rv routes: Int/UInt/Bool words only; the sized/aggregate/float local forms are aarch64-route rules)")
      end
    end
    li = li + 1
  end
  if f.contracts.len() > 0 then
    return Result::Err("lir: function " + f.name + " carries MIR contracts (agentic contract lowering has no rule yet)")
  end
  Result::Ok(())
end

# The accepted place shapes of this slice: a whole local (Unit / scalar
# word / plain struct / tagged enum), ONE Field projection over a
# plain-struct local (a scalar field), or the enum DOWNCAST form — a
# Field projection preceded by the active Variant projection
# (local.Variant(vid).Field(fid): a variant payload field — the shape
# the match-arm pattern bindings and payload accesses use; a scalar
# word exactly like a struct field), or — the pointer/atomic slice's
# deref form — a place whose FIRST projection is ProjDeref over a
# Ptr/PtrMut/RefInternal word local, followed by nothing (a scalar-word
# pointee) or by the same Field / downcast tails a frame place takes:
# the deref of ONE SCALAR WORD at a static byte offset of the pointed-to
# image (LirPlaceDerefWord — its reads lower to LirPtrLoad and its
# writes to LirPtrStore at the read/write sites; whole-image deref
# places stay fail-closed with the whole-deref rule below, and so do
# deref chains of two or more ProjDeref projections). Every other
# projection shape fails closed with the concrete missing rule.
enum LirPlaceShape
  LirPlaceUnit(Int)          # whole Unit local id (no representation)
  LirPlaceScalarLocal(Int)   # whole scalar local id
  LirPlaceAggLocal(Int)      # whole plain-struct / tagged-enum local id
  LirPlaceField(Int, Int)    # struct local id + declaration field index
  LirPlaceEnumField(Int, Int, Int)  # enum local id + variant index +
                             # payload field index (after the downcast)
  LirPlaceDerefWord(Int, Int, Type) # deref word place: base local id
                             # (the Ptr/PtrMut/RefInternal word local
                             # holding the address) + byte offset within
                             # the pointed-to image + the concrete
                             # scalar word type (its storage width and
                             # signedness decide the load/store width)
end

# The byte offset + concrete type of a deref place's FIELD tail: after
# the leading ProjDeref, the projection chain resolves against the
# POINTEE image's layout exactly like a frame place's chain resolves
# against a local image — Field over an admitted plain-struct pointee,
# Variant+Field over an admitted tagged-enum pointee. The image is the
# direct layout image (whole words at the admitted shapes), so the
# resolved FIELD byte offset is the deref access offset. Option::None
# never classifies a scalar deref (the whole-image / deep-chain shapes
# error below).
def lir_deref_tail_off(ctx: LirLowerCtx, pointee: Type, projections: Vec[Projection], from: Int) -> Result[(Int, Type), String]
  var pointee_tid = -1
  match pointee
  when Type::Adt(tid, _) then pointee_tid = tid.id
  when _ then
    return Result::Err("lir: " + ctx.fn_name + ": deref place tail over a pointed-to type that is not an aggregate (fail-closed)")
  end
  match lir_plain_struct_shape(ctx.type_defs, pointee)
  when Result::Err(e) then
    Result::Err("lir: " + ctx.fn_name + ": deref place over a pointed-to type with no admitted aggregate shape: " + e)
  when Result::Ok(o) then
    match o
    when Option::None then
      Result::Err("lir: " + ctx.fn_name + ": deref place tail over a pointed-to type that is not an admitted plain struct or tagged enum (fail-closed)")
    when Option::Some(kind) then
      match kind
      when LirAggShapeKind::LirAggStruct(shape) then
        if from >= projections.len() then
          Result::Err("lir: " + ctx.fn_name + ": whole-image deref places of pointed-to aggregates do not lower (the deref slice reads/writes ONE scalar word of the image; whole-image copies through a pointer are not implemented — fail-closed)")
        end
        var off = 0
        var fty: Type = Type::Unit
        var fi = from
        while fi < projections.len() do
          match projections[fi]
          when Projection::Field(fid) then
            if fid.owner.id != pointee_tid || fid.index < 0 || fid.index >= shape.fields.len() then
              return Result::Err("lir: " + ctx.fn_name + ": deref field projection index " + fid.index.to_string() + " does not name a field of the pointed-to struct (fail-closed)")
            end
            off = off + shape.fields[fid.index].byte_off
            fty = shape.fields[fid.index].ty.clone()
            if !lir_is_scalar_word(fty) then
              return Result::Err("lir: " + ctx.fn_name + ": deref field projection reaches a non-scalar-word field (nested aggregate derefs do not lower — fail-closed)")
            end
          when _ then
            return Result::Err("lir: " + ctx.fn_name + ": deref place projection chains lower as Field (and downcast) tails only (nested/len/index deref chains are not implemented — fail-closed)")
          end
          fi = fi + 1
        end
        Result::Ok((off, fty))
      when LirAggShapeKind::LirAggEnum(eshape) then
        # The downcast tail: Variant(v).Field(f) over the deref'd enum
        # image (the pointee's admitted tagged-enum image — the direct
        # layout {tag @ byte 0, payload words from byte 8}).
        if from + 1 >= projections.len() then
          return Result::Err("lir: " + ctx.fn_name + ": whole-image / bare-downcast deref places of pointed-to tagged enums do not lower (the deref slice reads/writes ONE scalar payload word — fail-closed)")
        end
        match projections[from]
        when Projection::Variant(vid) then
          match projections[from + 1]
          when Projection::Field(fid) then
            if from + 2 != projections.len() then
              return Result::Err("lir: " + ctx.fn_name + ": deref place projection chains lower as a single downcast tail only (fail-closed)")
            end
            if vid.owner.id != pointee_tid || fid.owner.id != pointee_tid then
              return Result::Err("lir: " + ctx.fn_name + ": deref downcast chain over a pointed-to enum carries a foreign owner (fail-closed)")
            end
            if vid.index < 0 || vid.index >= eshape.variants.len() then
              return Result::Err("lir: " + ctx.fn_name + ": deref downcast names variant index " + vid.index.to_string() + ", outside the pointed-to enum's variants (fail-closed)")
            end
            if fid.index < 0 || fid.index >= eshape.variants[vid.index].fields.len() then
              return Result::Err("lir: " + ctx.fn_name + ": deref downcast payload field index " + fid.index.to_string() + " does not name a payload field of the pointed-to variant (fail-closed)")
            end
            let pf = eshape.variants[vid.index].fields[fid.index]
            if !lir_is_scalar_word(pf.ty) then
              return Result::Err("lir: " + ctx.fn_name + ": deref downcast payload field is not a scalar word (fail-closed)")
            end
            Result::Ok((pf.byte_off, pf.ty.clone()))
          when _ then
            Result::Err("lir: " + ctx.fn_name + ": the deref downcast tail is Variant(v).Field(f) (fail-closed)")
          end
        when _ then
          Result::Err("lir: " + ctx.fn_name + ": the deref downcast tail is Variant(v).Field(f) over a pointed-to enum (fail-closed)")
        end
      end
    end
  end
end

def lir_classify_place(ctx: LirLowerCtx, place: Place) -> Result[LirPlaceShape, String]
  if place.projections.len() > 0 && place.projections[0] == Projection::ProjDeref then
    # The deref place form (the pointer/atomic slice): the base local
    # must be a Ptr/PtrMut/RefInternal word (an opaque address); the
    # chain after the leading deref resolves one SCALAR WORD of the
    # pointed-to image at a static byte offset.
    let base_id = place.local.id
    let base_ty = lir_local_ty(ctx, base_id)
    var pointee: Type = Type::Unit
    match base_ty
    when Type::Ptr(inner) then pointee = inner.clone()
    when Type::PtrMut(inner) then pointee = inner.clone()
    when Type::RefInternal(inner, _) then pointee = inner.clone()
    when _ then
      return Result::Err("lir: " + ctx.fn_name + ": deref places lower over Ptr/PtrMut/RefInternal word locals only (the base local " + base_id.to_string() + " is not a pointer word — fail-closed)")
    end
    if lir_is_scalar_word(pointee) || lir_is_ptr_word(pointee) then
      if place.projections.len() != 1 then
        return Result::Err("lir: " + ctx.fn_name + ": deref places over a scalar-word pointee carry no trailing projections (a whole deref of a scalar word; a deeper chain would need nested derefs — fail-closed)")
      end
      return Result::Ok(LirPlaceShape::LirPlaceDerefWord(base_id, 0, pointee))
    end
    if lir_is_fp_type(pointee) then
      return Result::Err("lir: " + ctx.fn_name + ": deref places over floating-point pointees do not lower (the deref slice is a general-word rule — fail-closed)")
    end
    match lir_deref_tail_off(ctx, pointee, place.projections, 1)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok((off, ty)) then Result::Ok(LirPlaceShape::LirPlaceDerefWord(base_id, off, ty))
    end
  elsif place.projections.len() == 0 then
    let id = place.local.id
    let ty = lir_local_ty(ctx, id)
    if lir_is_unit_word(ty) then
      Result::Ok(LirPlaceShape::LirPlaceUnit(id))
    elsif lir_is_reg_word(ty) then
      Result::Ok(LirPlaceShape::LirPlaceScalarLocal(id))
    else
      match ctx.agg_of.get(id)
      when Option::Some(_) then Result::Ok(LirPlaceShape::LirPlaceAggLocal(id))
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": local " + id.to_string() + " has a type with no lowering rule in this function (the function shape gate and the lowering disagree — fail-closed)")
      end
    end
  elsif place.projections.len() == 1 then
    match place.projections[0]
    when Projection::Field(fid) then
      match ctx.agg_of.get(place.local.id)
      when Option::Some(agg) then
        # A Field over a PLAIN-STRUCT local names a declared struct
        # field. A Field whose owner is an ENUM (or a Field over an
        # enum-typed local — the two coincide for typed MIR) is a
        # downcast payload field and needs the Variant projection first;
        # a bare Field over it is a typed-MIR divergence (fail-closed).
        match agg.enum_shape
        when Option::Some(_) then
          if agg.type_id == fid.owner.id then
            Result::Err("lir: " + ctx.fn_name + ": a Field projection over an enum local requires the active Variant (downcast) projection (local.Variant(v).Field(f)); the local's variant payload fields are reached through the downcast only — fail-closed)")
          else
            Result::Err("lir: " + ctx.fn_name + ": field projection over an enum-typed local does not lower (field owner " + fid.owner.id.to_string() + " is not the local's struct type " + agg.type_id.to_string() + "; typed MIR never produces this shape — fail-closed)")
          end
        when Option::None then
          if agg.type_id == fid.owner.id && fid.index >= 0 && fid.index < agg.shape.fields.len() then
            Result::Ok(LirPlaceShape::LirPlaceField(place.local.id, fid.index))
          else
            Result::Err("lir: " + ctx.fn_name + ": field projection index " + fid.index.to_string() + " does not name a field of the local's struct (fail-closed)")
          end
        end
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": field projection over a local that is not a plain struct does not lower (the local's type has no fields in this slice)")
      end
    when Projection::ProjDeref then
      Result::Err("lir: " + ctx.fn_name + ": deref places do not lower (references and pointers are not implemented)")
    when Projection::TupleIndex(_) then
      Result::Err("lir: " + ctx.fn_name + ": tuple element places do not lower (tuple aggregates are not implemented)")
    when Projection::Variant(vid) then
      # A bare downcast (no payload field after it) has no machine
      # access of its own: payload-less variants carry nothing, and a
      # payloaded variant's value is reached field by field — typed MIR
      # never reads/writes a whole downcast variant (fail-closed).
      match ctx.agg_of.get(place.local.id)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then
          if agg.type_id != vid.owner.id then
            Result::Err("lir: " + ctx.fn_name + ": enum downcast owner " + vid.owner.id.to_string() + " does not match the local enum type " + agg.type_id.to_string() + " (fail-closed)")
          elsif vid.index < 0 || vid.index >= eshape.variants.len() then
            Result::Err("lir: " + ctx.fn_name + ": enum downcast names variant index " + vid.index.to_string() + ", outside the local enum's " + eshape.variants.len().to_string() + " variants (fail-closed)")
          elsif eshape.variants[vid.index].fields.len() == 0 then
            Result::Err("lir: " + ctx.fn_name + ": bare enum downcast places do not lower (variant " + eshape.variants[vid.index].name + " of a payload-less variant carries no payload; whole-enum values read the whole local — fail-closed)")
          else
            Result::Err("lir: " + ctx.fn_name + ": bare enum downcast places do not lower (variant " + eshape.variants[vid.index].name + " carries payload fields, reached through the downcast's Field projections — a whole-downcast place has no machine value; fail-closed)")
          end
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": enum downcast place over a local that is not a tagged-enum local does not lower (fail-closed)")
        end
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": enum downcast place over a local that is not a tagged-enum local does not lower (fail-closed)")
      end
    when Projection::ProjIndex(_) then
      Result::Err("lir: " + ctx.fn_name + ": indexed element places do not lower (collections and fixed arrays are not implemented)")
    when Projection::ProjConstantIndex(_) then
      Result::Err("lir: " + ctx.fn_name + ": constant-index element places do not lower (collections and fixed arrays are not implemented)")
    end
  elsif place.projections.len() == 2 then
    # The enum downcast payload form: local.Variant(vid).Field(fid) —
    # the shape the match-arm pattern bindings and the payload accesses
    # use (fid.owner is the enum; fid.index is the PAYLOAD field index,
    # declaration order). There is no runtime downcast check — the
    # tag->active-variant correspondence is MIR's match guarantee,
    # exactly as in the direct emitter, whose downcast addressing is
    # purely static too.
    match place.projections[0]
    when Projection::Variant(vid) then
      match place.projections[1]
      when Projection::Field(fid) then
        match ctx.agg_of.get(place.local.id)
        when Option::Some(agg) then
          match agg.enum_shape
          when Option::Some(eshape) then
            if agg.type_id != vid.owner.id || agg.type_id != fid.owner.id then
              Result::Err("lir: " + ctx.fn_name + ": enum downcast chain over local type " + agg.type_id.to_string() + " carries a Variant owner " + vid.owner.id.to_string() + " or Field owner " + fid.owner.id.to_string() + " that does not match (typed MIR never produces this — fail-closed)")
            elsif vid.index < 0 || vid.index >= eshape.variants.len() then
              Result::Err("lir: " + ctx.fn_name + ": enum downcast names variant index " + vid.index.to_string() + ", outside the local enum's " + eshape.variants.len().to_string() + " variants (fail-closed)")
            elsif fid.index < 0 || fid.index >= eshape.variants[vid.index].fields.len() then
              Result::Err("lir: " + ctx.fn_name + ": enum downcast payload field index " + fid.index.to_string() + " does not name a payload field of variant " + eshape.variants[vid.index].name + " (the variant carries " + eshape.variants[vid.index].fields.len().to_string() + " payload fields; typed MIR never produces this — fail-closed)")
            else
              Result::Ok(LirPlaceShape::LirPlaceEnumField(place.local.id, vid.index, fid.index))
            end
          when Option::None then
            Result::Err("lir: " + ctx.fn_name + ": enum downcast chain over a local that is not a tagged-enum local does not lower (fail-closed)")
          end
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": enum downcast chain over a non-aggregate local does not lower (fail-closed)")
        end
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": the enum downcast place form is local.Variant(v).Field(f) (a Variant projection followed by anything but a Field does not lower — fail-closed)")
      end
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": two-projection places lower only as the enum downcast form local.Variant(v).Field(f); nested aggregates and other projection chains are not implemented")
    end
  else
    Result::Err("lir: " + ctx.fn_name + ": multi-projection places do not lower (nested aggregates and projection chains beyond the single enum downcast are not implemented)")
  end
end

# The static type of an accepted place (whole local type, the concrete
# scalar type of a struct field, or the payload field type after an
# enum downcast).
def lir_place_ty(ctx: LirLowerCtx, place: Place) -> Result[Type, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceUnit(id) then Result::Ok(lir_local_ty(ctx, id))
    when LirPlaceShape::LirPlaceScalarLocal(id) then Result::Ok(lir_local_ty(ctx, id))
    when LirPlaceShape::LirPlaceAggLocal(id) then Result::Ok(lir_local_ty(ctx, id))
    when LirPlaceShape::LirPlaceField(lid, fidx) then
      match ctx.agg_of.get(lid)
      when Option::Some(agg) then Result::Ok(agg.shape.fields[fidx].ty.clone())
      when Option::None then Result::Err("lir: " + ctx.fn_name + ": field place of a non-aggregate local (fail-closed)")
      end
    when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
      match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then Result::Ok(eshape.variants[vidx].fields[fidx].ty.clone())
        when Option::None then Result::Err("lir: " + ctx.fn_name + ": enum payload place of a non-enum local (fail-closed)")
        end
      when Option::None then Result::Err("lir: " + ctx.fn_name + ": enum payload place of a non-aggregate local (fail-closed)")
      end
    when LirPlaceShape::LirPlaceDerefWord(_, _, ty) then
      Result::Ok(ty)
    end
  end
end

# The scalar VALUE source of an accepted place: a whole scalar local
# resolves to its (lazily assigned) vreg; a struct field — or an enum
# variant's payload field after its downcast — resolves to the field's
# fixed memory-home word vreg (the aggregate's slot memory IS the
# local, so an ordinary read of the word vreg is a field read). Whole
# aggregate/Unit places are not scalar sources (fail-closed); a DEREF
# word place is not a vreg source either — its read materializes as a
# LirPtrLoad at the read sites (lir_value_of_operand /
# lir_move_from_place / lir_rhs_from_place), never as an existing vreg.
def lir_place_src_vreg(inout ctx: LirLowerCtx, place: Place) -> Result[Int, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceUnit(_) then
      Result::Err("lir: " + ctx.fn_name + ": a Unit-typed place has no machine value")
    when LirPlaceShape::LirPlaceScalarLocal(id) then
      let v = match lir_vreg_of_local(ctx, id)
      when Result::Ok(vv) then vv
      when Result::Err(e) then return Result::Err(e)
      end
      Result::Ok(v)
    when LirPlaceShape::LirPlaceAggLocal(_) then
      Result::Err("lir: " + ctx.fn_name + ": a whole aggregate local is not a scalar value (whole-aggregate values lower only as whole-copy rvalues into another aggregate local; enum tags read through MirDiscriminant and payload fields through the downcast)")
    when LirPlaceShape::LirPlaceField(lid, fidx) then
      Result::Ok(lir_agg_word_vreg(ctx, lid, fidx))
    when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
      let payload_word = match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then eshape.variants[vidx].fields[fidx].word
        when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload place of a non-enum local (fail-closed)")
        end
      when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload place of a non-aggregate local (fail-closed)")
      end
      Result::Ok(lir_agg_word_vreg(ctx, lid, payload_word))
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      Result::Err("lir: " + ctx.fn_name + ": deref place reads materialize as register-indirect loads at the read sites, never as an existing vreg source (fail-closed)")
    end
  end
end

# Emit the deref word READ of a classified deref place into `dst_v`:
# one LirPtrLoad (the marked register-indirect load at the place's
# byte offset, at the place's concrete scalar type's storage width and
# signedness). Every read-site funnel lowers deref places through this
# helper, so a deref place read is always a fresh load — never a
# cached/stale value.
def lir_lower_deref_word_read(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, place: Place) -> Result[Unit, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(base_id, off, ty) then
      let base_v = match lir_vreg_of_local(ctx, base_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      let (width, sign) = lir_deref_word_io(ctx, ty)
      if width <= 0 then
        return Result::Err("lir: " + ctx.fn_name + ": deref word read of a type with no storage width (fail-closed)")
      end
      var stmt = LirStmt {
        kind: LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, base_v),
        div: Option::None,
        ptr: Option::Some(LirPtrOp::LirPtrLoad(dst_v, base_v, off, width, sign))
      }
      lir_block_push(ctx, block_id, stmt)
      Result::Ok(())
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": deref read helper on a non-deref place (the shape gate and the lowering disagree — fail-closed)")
    end
  end
end

# Emit the deref word WRITE of a classified deref destination: one
# LirPtrStore of `src_v` (the lowered rvalue word) at the place's byte
# offset, at the place's concrete scalar type's storage width.
def lir_lower_deref_word_store(inout ctx: LirLowerCtx, block_id: Int, src_v: Int, place: Place) -> Result[Unit, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(base_id, off, ty) then
      let base_v = match lir_vreg_of_local(ctx, base_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      let (width, _) = lir_deref_word_io(ctx, ty)
      if width <= 0 then
        return Result::Err("lir: " + ctx.fn_name + ": deref word store of a type with no storage width (fail-closed)")
      end
      var stmt = LirStmt {
        kind: LirStmtKind::LirCmp(LirValue::LirReg(base_v), LirValue::LirReg(src_v)),
        div: Option::None,
        ptr: Option::Some(LirPtrOp::LirPtrStore(base_v, off, src_v, width))
      }
      lir_block_push(ctx, block_id, stmt)
      Result::Ok(())
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": deref store helper on a non-deref place (the shape gate and the lowering disagree — fail-closed)")
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Pointer/atomic slice — address-of lowering (the MirRef rvalues)
# ———————————————————————————————————————————————————————————————
# A MirRef (address-of) rvalue assigns a Ptr/PtrMut/RefInternal word
# local the ADDRESS of a place. The place is either a FRAME place (the
# address of a fixed frame slot — the lowered MirRef of a local /
# aggregate field, and the receiver autorefs over whole aggregate
# locals) or a DEREF word place (the address of a scalar word inside a
# pointed-to image — the address is the base word plus the place's byte
# offset). Lowering:
#   - frame places: LirPtrLea(dst, fp_off) over the place's frame slot.
#     A SCALAR (non-aggregate) place's slot does not exist until the
#     allocator homes the vreg, so an address-of over a scalar/ptr-word
#     local FORCES a fixed slot (ctx.agg_word_slots, allocated from the
#     aggregate slot region — the same fixed-slot mechanism the
#     aggregate word vregs use: the vreg is then memory-home
#     everywhere, every def stores its slot and every read loads it, so
#     the address stays stable for the local's whole lifetime);
#   - deref word places: the base word itself when the byte offset is
#     0 (a plain move), LirPtrAddr(dst, base, off) otherwise.

# The frame slot of an addressed place (aggregate places resolve
# through ctx.agg_of; a scalar/ptr-word local gets a FORCED fixed slot
# allocated from the aggregate slot region on first address-of).
def lir_frame_place_slot(inout ctx: LirLowerCtx, shape: LirPlaceShape) -> Result[Int, String]
  match shape
  when LirPlaceShape::LirPlaceScalarLocal(id) then
    let v = match lir_vreg_of_local(ctx, id)
    when Result::Ok(vv) then vv
    when Result::Err(e) then return Result::Err(e)
    end
    # (cortex-m atomic surface): an address-of over a FLOATING-POINT
    # local does not lower on the cortex-m route — the forced fixed
    # slot of the address-of slice is one 4-byte word, but an F64
    # local's image home is the two-word 8-byte-aligned slot pair the
    # cm allocator reserves (an F32's is the single word at the
    # allocator's slot), so the forced-slot machinery cannot host a
    # stable address for either width. (The aarch64 route's 8-byte
    # slot units host its float locals; this guard is cm-only.)
    if ctx.cm_atomics then
      match ctx.fp_widths.get(v)
      when Option::Some(_) then
        return Result::Err("lir: " + ctx.fn_name + ": MirRef (address-of) over a floating-point local does not lower on the cortex-m route (the forced fixed slot of an address-of is one 4-byte word, which cannot host the cm allocator's width-aware float image home; atomic locations on this route are the integer/Bool data words — fail-closed)")
      when Option::None then ()
      end
    end
    match ctx.agg_word_slots.get(v)
    when Option::Some(s) then Result::Ok(s)
    when Option::None then
      let s = ctx.next_agg_slot
      ctx.next_agg_slot = s + 1
      ctx.agg_word_slots.insert(v, s)
      Result::Ok(s)
    end
  when LirPlaceShape::LirPlaceAggLocal(lid) then
    match ctx.agg_of.get(lid)
    when Option::Some(agg) then Result::Ok(agg.base_slot)
    when Option::None then Result::Err("lir: " + ctx.fn_name + ": address-of over a non-aggregate whole local (fail-closed)")
    end
  when LirPlaceShape::LirPlaceField(lid, fidx) then
    match ctx.agg_of.get(lid)
    when Option::Some(agg) then Result::Ok(agg.base_slot + agg.shape.fields[fidx].word)
    when Option::None then Result::Err("lir: " + ctx.fn_name + ": address-of over a field of a non-aggregate local (fail-closed)")
    end
  when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
    match ctx.agg_of.get(lid)
    when Option::Some(agg) then
      match agg.enum_shape
      when Option::Some(eshape) then Result::Ok(agg.base_slot + eshape.variants[vidx].fields[fidx].word)
      when Option::None then Result::Err("lir: " + ctx.fn_name + ": address-of over a payload field of a non-enum local (fail-closed)")
      end
    when Option::None then Result::Err("lir: " + ctx.fn_name + ": address-of over a payload field of a non-aggregate local (fail-closed)")
    end
  when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
    Result::Err("lir: " + ctx.fn_name + ": deref places have no frame slot (their addresses come from the base word — fail-closed)")
  when LirPlaceShape::LirPlaceUnit(_) then
    Result::Err("lir: " + ctx.fn_name + ": address-of over a Unit place does not lower")
  end
end

# Emit `dst_v <- &place` (a MirRef rvalue): the address of a frame
# place as a marked LEA of its fixed slot, or of a deref word place as
# the base word (offset 0) / a marked base+off add. The dst word is a
# Ptr/PtrMut/RefInternal-typed local — already admitted by the shape
# gate; the address is stable for the addressed slot's lifetime by the
# fixed-slot forcing above.
def lir_lower_ref_of_place(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, ref_place: Place) -> Result[Unit, String]
  match lir_classify_place(ctx, ref_place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(base_id, off, _) then
      let base_v = match lir_vreg_of_local(ctx, base_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      if off == 0 then
        if dst_v != base_v then
          lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirReg(base_v))
        end
      else
        var stmt = LirStmt {
          kind: LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, base_v),
          div: Option::None,
          ptr: Option::Some(LirPtrOp::LirPtrAddr(dst_v, base_v, off))
        }
        lir_block_push(ctx, block_id, stmt)
      end
      Result::Ok(())
    when LirPlaceShape::LirPlaceUnit(_) then
      Result::Err("lir: " + ctx.fn_name + ": MirRef over a Unit place does not lower")
    when _ then
      let slot = match lir_frame_place_slot(ctx, shape)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(s) then s
      end
      # The LEA payload is the frame geometry of the addressed slot's
      # route: the aarch64 routes carry the canonical FP offset
      # lir_slot_offset(slot) ([FP - 8 - 8*slot] — the a64 emitter
      # decodes it); on the cortex-m route (param_stack_mode) a slot is
      # the 4-byte word at [r7 + 4*slot], so the marked LEA carries the
      # machine byte offset 4*slot (the thumb emitter adds it to r7);
      # on the riscv atomic surface (rv_atomics) a slot is the route's
      # machine word at [s0 + mw*slot] (mw = 4 on riscv32, 8 on
      # riscv64 — the same slot convention as the rv backend's spill
      # slots), so the marked LEA carries the machine byte offset
      # mw*slot (the riscv emitter adds it to s0).
      var lea_off = lir_slot_offset(slot)
      if ctx.param_stack_mode then
        lea_off = 4 * slot
      elsif ctx.rv_atomics then
        lea_off = (if ctx.rv_word64 then 8 else 4 end) * slot
      end
      var stmt = LirStmt {
        kind: LirStmtKind::LirCset(LirCond::LirEq, dst_v),
        div: Option::None,
        ptr: Option::Some(LirPtrOp::LirPtrLea(dst_v, lea_off))
      }
      lir_block_push(ctx, block_id, stmt)
      Result::Ok(())
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Whole-program static references (the MirStaticRef lowering)
# ———————————————————————————————————————————————————————————————
# A static's CURRENT VALUE arrives at lowering as a MirConstant whose
# kind is MirStaticRef(DefId) — the same form the direct emitter's
# static-read arms consume (its MirStaticRef arm resolves the DefId to
# the static's emission label and emits LEA + load). The LIR slice
# resolves the DefId through the WHOLE-PROGRAM static label table
# (ctx.static_labels — the DefId-render -> emission-name pairing built
# by the route entries with codegen.tg's build_static_label_table, the
# same table the direct emitter's codegen_program builds) and lowers
# the read to ONE shared statement, LirStaticLoad(dst, sym) — the
# route emitters materialize the symbol address (ADRP+ADD /
# MOVW+MOVT / LUI+ADDI with the route's relocation pairs) and load the
# machine word. MirStaticAddr constants (address-of uses — static
# writes, address temps) stay fail-closed everywhere: their only MIR
# shapes are Ptr-typed address temps and deref places, which no LIR
# shape gate admits, and no address-in-register statement exists (the
# LirStaticLoad loads the value; the load's own address materialization
# is internal to the statement).

# The emission symbol of a static reference's DefId: the whole-program
# static label table's value (the static's MirStatic.name — the symbol
# the route's data emission registered). A DefId outside the table is
# an internal error (the table is built from the very program being
# compiled; fail-closed, never a name-derived or guessed address).
def lir_static_symbol_of(ctx: LirLowerCtx, did: DefId) -> Result[String, String]
  match ctx.static_labels.get(static_def_id_key(did))
  when Option::Some(name) then Result::Ok(name.clone())
  when Option::None then
    Result::Err("lir: " + ctx.fn_name + ": a static reference carries an unregistered DefId (module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") — the whole-program static label table has no entry for it (the route entries build the table from the program's statics and its reference constants, mirroring the direct emitter; fail-closed)")
  end
end

# Materialize a MirStaticRef constant (a static's current scalar value)
# into a fresh ordinary vreg through LirStaticLoad(dst, sym). The
# symbol resolution and the append are inlined here (this helper is
# used by the operand funnels, which precede lir_append_stmt's
# definition). MirStaticAddr fails closed with the address-of rule
# (see the section header).
def lir_materialize_static_ref(inout ctx: LirLowerCtx, block_id: Int, cst: MirConstant) -> Result[Int, String]
  match cst.kind
  when MirConstantKind::MirStaticRef(did) then
    let sym = match lir_static_symbol_of(ctx, did)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(s) then s
    end
    let tmp = lir_fresh_vreg(ctx)
    let stmt = LirStmt {
      kind: LirStmtKind::LirStaticLoad(tmp, sym),
      div: Option::None,
      ptr: Option::None
    }
    match ctx.block_stmts.get(block_id)
    when Option::Some(list) then
      var l = list.clone()
      l.push(stmt)
      ctx.block_stmts.insert(block_id, l)
    when Option::None then
      var fresh: Vec[LirStmt] = Vec::new()
      fresh.push(stmt)
      ctx.block_stmts.insert(block_id, fresh)
    end
    Result::Ok(tmp)
  when MirConstantKind::MirStaticAddr(did) then
    Result::Err("lir: " + ctx.fn_name + ": a static ADDRESS constant (MirStaticAddr, module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") does not lower — address-of forms over STATIC storage (static writes through an address temp, &static / deref access) are not implemented on the pointer/atomic slice, which admits address words over FRAME storage only; a static's current VALUE (MirStaticRef) lowers as LirStaticLoad (fail-closed)")
  when _ then
    Result::Err("lir: " + ctx.fn_name + ": lir_materialize_static_ref on a non-static constant (internal error)")
  end
end

# The value source of a place-like MIR operand, or the marker for a
# scalar constant. MirCopy/MirMovePlace/MirRead/MirConsume all read the
# place's value (ownership moves of scalars and plain structs have no
# runtime representation: the value is copied and MIR's storage
# accounting owns the local — the legalization contract, no drops).
def lir_operand_value(inout ctx: LirLowerCtx, op: MirOperand) -> Result[Option[Int], String]
  match op.kind
  when MirOperandKind::MirCopy(place) then
    lir_operand_place_value(ctx, place)
  when MirOperandKind::MirMovePlace(place) then
    lir_operand_place_value(ctx, place)
  when MirOperandKind::MirRead(place) then
    lir_operand_place_value(ctx, place)
  when MirOperandKind::MirConsume(place) then
    lir_operand_place_value(ctx, place)
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(_) then Result::Ok(Option::None)
    when MirConstantKind::MirBool(_) then Result::Ok(Option::None)
    when MirConstantKind::MirUnit then Result::Ok(Option::None)
    when MirConstantKind::MirFloat(_) then Result::Ok(Option::None)
    when MirConstantKind::MirStaticRef(_) then
      # A whole-program static's CURRENT VALUE (the MirStaticRef constant
      # form of the direct emitter's static read): not an immediate and
      # not a place — the marker for the materializing consumers
      # (lir_value_of_operand / lir_binop_rhs / lir_lower_move_value /
      # lir_lower_switch / lir_lower_assert), which lower it to a
      # LirStaticLoad into a register (the statics section below).
      Result::Ok(Option::None)
    when MirConstantKind::MirStaticAddr(_) then
      Result::Err("lir: " + ctx.fn_name + ": static ADDRESS constants (MirStaticAddr) do not lower as scalar operands — the address-of forms over STATIC storage (static writes through an address temp, &static deref access) are not implemented on the pointer/atomic slice, which admits address words over FRAME storage only (fail-closed); a static's current VALUE (MirStaticRef) lowers, as a load from its .data/.bss symbol")
    when _ then Result::Err("lir: " + ctx.fn_name + ": non-integer/bool/float/static constants do not lower as scalar operands (char/string/function constants are not implemented)")
    end
  end
end

# The place-like operand value source: a vreg source for the frame
# place shapes (lir_place_src_vreg), the Option::None marker for a
# DEREF word place (its read materializes at the read sites — the
# marker funnels lir_value_of_operand / lir_move_from_place /
# lir_rhs_from_place lower it to a LirPtrLoad into a register).
def lir_operand_place_value(inout ctx: LirLowerCtx, place: Place) -> Result[Option[Int], String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then Result::Ok(Option::None)
    when _ then lir_place_src_vreg_opt(ctx, place)
    end
  end
end
def lir_place_src_vreg_opt(inout ctx: LirLowerCtx, place: Place) -> Result[Option[Int], String]
  let v = match lir_place_src_vreg(ctx, place)
  when Result::Ok(vv) then vv
  when Result::Err(e) then return Result::Err(e)
  end
  Result::Ok(Option::Some(v))
end

# The static MIR type of an operand (constants carry ty; places resolve
# through their projection — a scalar field operand types as the field).
def lir_operand_ty(ctx: LirLowerCtx, op: MirOperand) -> Result[Type, String]
  match op.kind
  when MirOperandKind::MirConstant(cst) then Result::Ok(cst.ty.clone())
  when MirOperandKind::MirCopy(place) then lir_place_ty(ctx, place)
  when MirOperandKind::MirMovePlace(place) then lir_place_ty(ctx, place)
  when MirOperandKind::MirRead(place) then lir_place_ty(ctx, place)
  when MirOperandKind::MirConsume(place) then lir_place_ty(ctx, place)
  end
end

# Signedness of an integer operand pair: both sides must be integers of
# the slice with the SAME signedness (I8/I16/I32/ISize/Int are signed,
# U8/U16/U32/USize/UInt unsigned). Mixed signedness is rejected
# (fail-closed; an explicit cast is the documented remedy). Bool operand
# pairs do not go through this INTEGER gate — comparisons classify them
# separately (lir_lower_cmp) and the Bool logical ops lower through
# lir_lower_bool_logical.
def lir_operand_signedness(ctx: LirLowerCtx, left: MirOperand, right: MirOperand) -> Result[Bool, String]
  match lir_operand_ty(ctx, left)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(lt) then
    match lir_operand_ty(ctx, right)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(rt) then
      if !lir_is_int_word(lt) || !lir_is_int_word(rt) then
        return Result::Err("lir: " + ctx.fn_name + ": binop operands must be integers of the slice (Bool words lower only through the Bool logical/comparison shapes; aggregates are outside the slice)")
      end
      let lu = lir_is_unsigned(lt)
      let ru = lir_is_unsigned(rt)
      if lu != ru then
        return Result::Err("lir: " + ctx.fn_name + ": mixed signed/unsigned arithmetic does not lower (an explicit cast is required; fail-closed)")
      end
      Result::Ok(lu)
    end
  end
end

# Register value of an operand: a place's source vreg, or a fresh
# temporary loaded with the immediate for a constant (constants are
# materialized, never folded — the optimizer owns folding).
def lir_value_of_operand(inout ctx: LirLowerCtx, block_id: Int, op: MirOperand) -> Result[Int, String]
  match lir_operand_value(ctx, op)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(oval) then
    match oval
    when Option::Some(src_v) then
      Result::Ok(src_v)
    when Option::None then
      match op.kind
      when MirOperandKind::MirConstant(cst) then
        match cst.kind
        when MirConstantKind::MirStaticRef(_) then
          # A static's current value is NOT an immediate: it is loaded
          # from the static's symbol into a fresh register (the load
          # statement the route emitters relocate — see the statics
          # section above).
          lir_materialize_static_ref(ctx, block_id, cst)
        when _ then
          let tmp = lir_fresh_vreg(ctx)
          lir_emit_move_vreg(ctx, block_id, tmp, LirValue::LirImm(lir_const_imm(cst)))
          Result::Ok(tmp)
        end
      when MirOperandKind::MirCopy(place) then
        lir_value_of_deref_place(ctx, block_id, place)
      when MirOperandKind::MirMovePlace(place) then
        lir_value_of_deref_place(ctx, block_id, place)
      when MirOperandKind::MirRead(place) then
        lir_value_of_deref_place(ctx, block_id, place)
      when MirOperandKind::MirConsume(place) then
        lir_value_of_deref_place(ctx, block_id, place)
      when _ then Result::Err("lir: " + ctx.fn_name + ": operand did not resolve to a scalar value source")
      end
    end
  end
end

# Materialize a DEREF word place's value into a fresh register (the
# Option::None marker path of lir_value_of_operand): classify the
# place as the deref word form and emit the marked register-indirect
# load; every other shape is a lowering divergence (fail closed).
def lir_value_of_deref_place(inout ctx: LirLowerCtx, block_id: Int, place: Place) -> Result[Int, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      let tmp = lir_fresh_vreg(ctx)
      match lir_lower_deref_word_read(ctx, block_id, tmp, place)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      Result::Ok(tmp)
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": a place operand that resolved to no vreg source is not a deref word place (fail-closed)")
    end
  end
end

# The immediate payload of a scalar MIR constant (MirUnit yields 0; it is
# only ever moved into Unit destinations, which have no virtual register).
def lir_const_imm(cst: MirConstant) -> Int
  match cst.kind
  when MirConstantKind::MirInt(v) then v
  when MirConstantKind::MirBool(b) then if b then 1 else 0 end
  when MirConstantKind::MirUnit then 0
  when _ then panic("lir_const_imm: non-scalar constant")
  end
end

# Push one already-built statement onto a block's accumulated list.
def lir_block_push(inout ctx: LirLowerCtx, block_id: Int, stmt: LirStmt) -> Unit
  match ctx.block_stmts.get(block_id)
  when Option::Some(list) then
    var l = list.clone()
    l.push(stmt)
    ctx.block_stmts.insert(block_id, l)
  when Option::None then
    var l: Vec[LirStmt] = Vec::new()
    l.push(stmt)
    ctx.block_stmts.insert(block_id, l)
  end
end

# Append a statement to a block's accumulated list.
def lir_append_stmt(inout ctx: LirLowerCtx, block_id: Int, kind: LirStmtKind) -> Unit
  lir_block_push(ctx, block_id, LirStmt { kind: kind, div: Option::None, ptr: Option::None })
end

# Append an aarch64-slice division statement (see LirDivOp): the quotient
# dst = num / den, signed/unsigned per `div`. Lowering materializes both
# operands into registers; the aarch64 emitter reads the marker off the
# Mul-shaped kind and emits SDIV/UDIV. Emitted by lir_lower_divmod only
# on the aarch64 route (ctx.div_ok), so no other backend ever sees it.
def lir_append_div_stmt(inout ctx: LirLowerCtx, block_id: Int, div: LirDivOp, dst: Int, num: Int, den: Int) -> Unit
  lir_block_push(ctx, block_id, LirStmt {
    kind: LirStmtKind::LirBinop(LirBinOp::LirMul, dst, LirValue::LirReg(num), LirValue::LirReg(den)),
    div: Option::Some(div),
    ptr: Option::None
  })
end

def lir_emit_move_vreg(inout ctx: LirLowerCtx, block_id: Int, dst: Int, val: LirValue) -> Unit
  lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(dst, val))
end

# Append an FP register move (LirFMove — the float-slice counterpart of
# lir_emit_move_vreg; see the LirFMove statement doc).
def lir_emit_fp_move_vreg(inout ctx: LirLowerCtx, block_id: Int, dst: Int, src: Int) -> Unit
  lir_append_stmt(ctx, block_id, LirStmtKind::LirFMove(dst, src))
end

# The 64-bit bit pattern of a MirFloat constant (the compiler's host
# double; codegen.tg's MirFloat materialization carries exactly these
# bits). Only ever called for MirFloat constants.
def lir_const_fp_bits(cst: MirConstant) -> Int
  match cst.kind
  when MirConstantKind::MirFloat(f) then f.to_bits() as Int
  when _ then panic("lir_const_fp_bits: non-float constant")
  end
end

# The float width of a lowering-context vreg (Option::None for
# general-word vregs and the fixed ids 0..15). The FP class test for
# ordinary vregs: an id recorded in ctx.fp_widths IS an FP vreg.
def lir_ctx_fp_width_of(ctx: LirLowerCtx, vreg: Int) -> Option[LirFpWidth]
  match ctx.fp_widths.get(vreg)
  when Option::Some(w) then Option::Some(w)
  when Option::None then Option::None
  end
end

# Materialize a floating-point operand into a register of width `w`:
# a place operand resolves to its (FP) source vreg; a MirFloat constant
# is materialized into a fresh FP vreg through LirFConst (its 64-bit
# host-double bits; the F32 emission rounds to the canonical single).
# Every other operand shape fails closed — float binops/comparisons
# never take immediate operands.
def lir_fp_value_of_operand(inout ctx: LirLowerCtx, block_id: Int, w: LirFpWidth, op: MirOperand) -> Result[Int, String]
  match lir_operand_value(ctx, op)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(oval) then
    match oval
    when Option::Some(src_v) then
      # The source must be an FP vreg of the operand's width (the MIR
      # has typed the expression; a class mismatch here is a lowering
      # divergence — fail closed).
      match lir_ctx_fp_width_of(ctx, src_v)
      when Option::Some(sv_w) then
        if sv_w == w then
          Result::Ok(src_v)
        else
          Result::Err("lir: " + ctx.fn_name + ": float operand of width " + (if sv_w == LirFpWidth::LirF32 then "f32" else "f64" end) + " in a " + (if w == LirFpWidth::LirF32 then "f32" else "f64" end) + " context (a width cast is required; fail-closed)")
        end
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": float op consumes a non-float register operand (fail-closed)")
      end
    when Option::None then
      match op.kind
      when MirOperandKind::MirConstant(cst) then
        match cst.kind
        when MirConstantKind::MirFloat(_) then
          let tmp = lir_fresh_fp_vreg(ctx, w)
          lir_append_stmt(ctx, block_id, LirStmtKind::LirFConst(w, tmp, lir_const_fp_bits(cst)))
          Result::Ok(tmp)
        when _ then
          Result::Err("lir: " + ctx.fn_name + ": non-float constant cannot be a float operand (fail-closed)")
        end
      when _ then Result::Err("lir: " + ctx.fn_name + ": operand did not resolve to a float value source")
      end
    end
  end
end
# ———————————————————————————————————————————————————————————————
# Lowering — statements and rvalues
# ———————————————————————————————————————————————————————————————

# Prefix a block's statement list with the entry parameter bindings.
def lir_append_bindings(inout ctx: LirLowerCtx, block_id: Int, binds: Vec[LirStmt]) -> Unit
  match ctx.block_stmts.get(block_id)
  when Option::Some(list) then
    var merged: Vec[LirStmt] = Vec::new()
    var bi = 0
    while bi < binds.len() do
      merged.push(binds[bi].clone())
      bi = bi + 1
    end
    var si = 0
    while si < list.len() do
      merged.push(list[si].clone())
      si = si + 1
    end
    ctx.block_stmts.insert(block_id, merged)
  when Option::None then
    ctx.block_stmts.insert(block_id, binds.clone())
  end
end

# Record a block's terminator.
def lir_set_term(inout ctx: LirLowerCtx, block_id: Int, kind: LirTermKind) -> Unit
  ctx.block_terms.insert(block_id, LirTerm { kind: kind })
end

# Lower one MirAssign statement into LIR statements of the block. The
# destination may be a whole local (Unit / scalar word / plain struct /
# tagged enum), a scalar field of a plain-struct local, or a variant
# payload field of a tagged-enum local (the downcast form); the rvalue
# must fit the destination's kind (aggregate destinations take
# construction and whole-value copies only — fail-closed otherwise).
def lir_lower_assign(inout ctx: LirLowerCtx, block_id: Int, place: Place, rvalue: MirRvalue) -> Result[Unit, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceUnit(_) then
      # Unit places (the "_ret" local of a Unit-returning function) have
      # no machine representation: an assignment into one carries no
      # value and its rvalue is pure (calls are terminators, never
      # assignment rvalues), so the statement is a no-op — mirroring the
      # direct emitter, which stores nothing observable for Unit.
      Result::Ok(())
    when LirPlaceShape::LirPlaceScalarLocal(dst_id) then
      let dst_v = match lir_vreg_of_local(ctx, dst_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      lir_lower_scalar_dst(ctx, block_id, lir_local_ty(ctx, dst_id), dst_v, rvalue)
    when LirPlaceShape::LirPlaceField(lid, fidx) then
      match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        lir_lower_scalar_dst(ctx, block_id, agg.shape.fields[fidx].ty.clone(), agg.word_vregs[fidx], rvalue)
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": field destination of a non-aggregate local (fail-closed)")
      end
    when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
      # A payload-field destination after the downcast: the field is a
      # scalar word in the enum image, written like a struct field (no
      # runtime check — the downcast's active-variant guarantee is
      # MIR's, exactly as in the direct emitter).
      match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then
          let pf = eshape.variants[vidx].fields[fidx]
          lir_lower_scalar_dst(ctx, block_id, pf.ty.clone(), agg.word_vregs[pf.word], rvalue)
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-enum local (fail-closed)")
        end
      when Option::None then
        Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-aggregate local (fail-closed)")
      end
    when LirPlaceShape::LirPlaceDerefWord(_, _, ty) then
      # A DEREF word destination (the pointer/atomic slice): the rvalue
      # lowers into a fresh word temporary exactly as into a scalar
      # local, then one marked register-indirect store writes the
      # temporary's low width bytes at the place's byte offset. (The
      # temporary isolates the store from the rvalue lowering — a store
      # can never alias a live rvalue source in the middle of its own
      # evaluation.)
      let tmp = lir_fresh_vreg(ctx)
      match lir_lower_scalar_dst(ctx, block_id, ty.clone(), tmp, rvalue)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      lir_lower_deref_word_store(ctx, block_id, tmp, place)
    when LirPlaceShape::LirPlaceAggLocal(dst_id) then
      lir_lower_agg_dst(ctx, block_id, dst_id, rvalue)
    end
  end
end
# Lower an assign whose destination is a scalar word: a whole scalar
# local's vreg or a plain-struct field's fixed word vreg (every def of
# a fixed word vreg stores through its slot, so this is a field store).
def lir_lower_scalar_dst(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, rvalue: MirRvalue) -> Result[Unit, String]
  match rvalue.kind
  when MirRvalueKind::MirPhi(_) then
    # Phi rvalues are lowered as PREDECESSOR-EDGE copies (see the
    # terminator lowering); the in-block occurrence is a no-op (the
    # codegen.tg emit_phi_copies convention).
    Result::Ok(())
  when MirRvalueKind::MirMove(op) then
    lir_lower_move_value(ctx, block_id, dst_ty, dst_v, op)
  when MirRvalueKind::MirCast(kind, op, target_ty) then
    match kind
    when CastKind::IntToInt then
      if !lir_is_int_word(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": IntToInt cast into a non-integer destination does not lower")
      end
      # Width-changing casts mirror codegen's CastKind::IntToInt rule
      # exactly: a target narrower than 64 bits is the canonical
      # narrowing mask (keep the low bits, zero the upper ones — the
      # same and-mask the direct emitter applies to every `as i8`
      # style cast); a 64-bit target is a plain full-word move
      # (widening/same-width casts are register no-ops in the direct
      # emitter — no sign/zero extension is ever inserted here).
      match lir_int_width_of(target_ty)
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": IntToInt cast target is not an integer of this slice (supported: Int/UInt/ISize/USize/I8/I16/I32/U8/U16/U32)")
      when Option::Some(tw) then
        if tw.bits < 64 then
          let sv = match lir_value_of_operand(ctx, block_id, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(LirBinOp::LirAnd, dst_v, LirValue::LirReg(sv), LirValue::LirImm(lir_width_mask(tw))))
          Result::Ok(())
        else
          lir_lower_move_value(ctx, block_id, dst_ty, dst_v, op)
        end
      end
    when CastKind::IntToFloat then
      # Signed/unsigned 64-bit integer word -> float (codegen.tg's
      # CastKind::IntToFloat aarch64 rule — SCVTF from the integer
      # register — width-corrected: the 64-bit-source S-form for an
      # F32 destination and the D-form for F64, with the UCVTF form
      # for unsigned sources). The conversion rounds under the default
      # FPCR (RNE), like every int->float path.
      let dw = match lir_fp_width_of(dst_ty)
      when Option::Some(w) then w
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": IntToFloat cast into a non-float destination does not lower")
      end
      let unsigned = match lir_operand_ty(ctx, op)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(oty) then
        if !lir_is_int_word(oty) then
          return Result::Err("lir: " + ctx.fn_name + ": IntToFloat cast operand is not an integer word (fail-closed)")
        end
        lir_is_unsigned(oty)
      end
      let sv = match lir_value_of_operand(ctx, block_id, op)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      lir_append_stmt(ctx, block_id, LirStmtKind::LirIntToFloat(dw, dst_v, sv, unsigned))
      Result::Ok(())
    when CastKind::FloatToInt then
      # Float -> signed 64-bit integer word (codegen.tg's
      # CastKind::FloatToInt aarch64 rule — FCVTZS from the float
      # register; the P1-6 strict spec's trap-free truncation: toward
      # zero, NaN -> 0, out-of-range saturates).
      if !lir_is_int_word(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": FloatToInt cast into a non-integer destination does not lower")
      end
      let sw = match lir_operand_ty(ctx, op)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(oty) then
        match lir_fp_width_of(oty)
        when Option::Some(w) then w
        when Option::None then
          return Result::Err("lir: " + ctx.fn_name + ": FloatToInt cast operand is not a float (fail-closed)")
        end
      end
      let sv = match lir_fp_value_of_operand(ctx, block_id, sw, op)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      lir_append_stmt(ctx, block_id, LirStmtKind::LirFloatToInt(sw, dst_v, sv))
      Result::Ok(())
    when CastKind::FloatToFloat then
      # Float <-> float width cast (codegen.tg's CastKind::FloatToFloat
      # rule: a plain no-op there because its registers are
      # width-agnostic words; the float slice's registers are
      # width-canonical, so the width-changing form emits FCVT — the
      # single rounding every F32 boundary applies — and the
      # same-width form is an ordinary float move). codegen.tg's
      # no-op rule is the direct pipeline's only width-blind spot;
      # this slice keeps the canonical-width semantics of the P1-6
      # spec (a double->single cast must round exactly once).
      let dw = match lir_fp_width_of(dst_ty)
      when Option::Some(w) then w
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": FloatToFloat cast into a non-float destination does not lower")
      end
      let sw = match lir_operand_ty(ctx, op)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(oty) then
        match lir_fp_width_of(oty)
        when Option::Some(w) then w
        when Option::None then
          return Result::Err("lir: " + ctx.fn_name + ": FloatToFloat cast operand is not a float (fail-closed)")
        end
      end
      let sv = match lir_fp_value_of_operand(ctx, block_id, sw, op)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      if sw == dw then
        if sv != dst_v then
          lir_emit_fp_move_vreg(ctx, block_id, dst_v, sv)
        end
      else
        lir_append_stmt(ctx, block_id, LirStmtKind::LirFcvt(sw, dst_v, sv))
      end
      Result::Ok(())
    when CastKind::Pointer then
      # A pointer/ref cast (the checker's `&x as Ptr[T]`/`as PtrMut[T]`
      # spellings and the Int<->Ptr round trips): an opaque word
      # no-op — every admitted source (an address word — a RefInternal/
      # Ptr/PtrMut local or deref word place, an integer word) already
      # rides the word model, so the value moves like any word (the
      # codegen.tg CastKind::Pointer rule is a no-op for exactly the
      # same reason).
      if !lir_is_ptr_word(dst_ty) && !lir_is_int_word(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": Pointer cast into a destination that is neither a pointer word nor an integer word does not lower (fail-closed)")
      end
      let sv = match lir_value_of_operand(ctx, block_id, op)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      if dst_v != sv then
        lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirReg(sv))
      end
      Result::Ok(())
    when CastKind::Transmute then
      # A bit reinterpretation between scalar words of the SAME bit
      # width — the generic cast kind the front end emits for every
      # source `as` cast (mir.tg's ExprCast lowering; the typed
      # backends classify by the source/target types at their own
      # levels). The codegen.tg rule is a register NO-OP because its
      # float values ride GP words (a word move is already a bit
      # move); this slice's floats live in the SIMD&FP file, so the
      # class-crossing pairs lower to the marked register-class bit
      # moves (LirBitMoveOp: fmov d/x — and the F32 s/w forms, whose
      # W side is the canonical zero-extended low-32 image):
      #   - int word <-> float: the exact-width pairs only — F64/Float
      #     (8 bytes) with the 64-bit integer words Int/UInt/ISize/
      #     USize, and F32 (4 bytes) with the 32-bit words I32/U32.
      #     Any other pair's widths cannot meet in one bit image
      #     (fail-closed; a numeric conversion is the IntToFloat/
      #     FloatToInt/FloatToFloat cast kinds);
      #   - same-class same-width pairs (int -> int, fp -> fp) are the
      #     corresponding ordinary word moves (the codegen no-op
      #     mirror — no mask, no rounding: the bits cross untouched;
      #     a width-changing IntToInt narrowing is the explicit
      #     IntToInt cast).
      # The marked statements only lower on the aarch64 route (the
      # div_ok && !param_stack_mode gate — the same gate the div
      # markers use): the cortex-m float slice keeps the fail-closed
      # rejection below, and no other backend's emitter knows the
      # marker.
      let st = match lir_operand_ty(ctx, op)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(t) then t
      end
      match lir_fp_width_of(dst_ty)
      when Option::Some(dw) then
        # int word -> float bit move (the GP word's bits become the
        # FP value's bits at the destination's width).
        match lir_fp_width_of(st)
        when Option::Some(sw) then
          # fp -> fp transmute: same-width pairs are ordinary float
          # moves (F64/Float share one width; F32 is the other);
          # cross-width pairs are not bit moves (fail-closed).
          if dw != sw then
            return Result::Err("lir: " + ctx.fn_name + ": transmute between float widths " + (if sw == LirFpWidth::LirF32 then "f32" else "f64" end) + " and " + (if dw == LirFpWidth::LirF32 then "f32" else "f64" end) + " does not lower (a transmute preserves the bit image; width changes are the FloatToFloat cast — fail-closed)")
          end
          let fv = match lir_fp_value_of_operand(ctx, block_id, dw, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          if fv != dst_v then
            lir_emit_fp_move_vreg(ctx, block_id, dst_v, fv)
          end
          Result::Ok(())
        when Option::None then
          if !lir_is_int_word(st) then
            return Result::Err("lir: " + ctx.fn_name + ": transmute into a float destination needs an integer-word or float source (fail-closed)")
          end
          let src_bits = lir_int_width_bits(st)
          let want_bits = if dw == LirFpWidth::LirF32 then 32 else 64 end
          if src_bits != want_bits then
            return Result::Err("lir: " + ctx.fn_name + ": transmute of an integer of width " + src_bits.to_string() + " into a float of width " + want_bits.to_string() + " does not lower (a transmute preserves the bit image; only the exact-width pairs lower: Int/UInt/ISize/USize <-> Float/F64 and I32/U32 <-> F32 — the numeric conversions are the IntToFloat/FloatToInt casts — fail-closed)")
          end
          if !ctx.div_ok || ctx.param_stack_mode then
            return Result::Err("lir: " + ctx.fn_name + ": transmute of an integer word into a float does not lower on this route (the register-class bit move is an aarch64-route rule; the cortex-m float slice keeps transmutes fail-closed)")
          end
          let gv = match lir_value_of_operand(ctx, block_id, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          lir_block_push(ctx, block_id, LirStmt {
            kind: LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, gv),
            div: Option::None,
            ptr: Option::None,
            bm: Option::Some(LirBitMoveOp::LirBitsGpToFp)
          })
          Result::Ok(())
        end
      when Option::None then
        # int/ptr word destination: a float -> int transmute is the
        # reverse bit move; same-class words are plain moves (no mask —
        # the bits cross untouched, the direct emitter's no-op mirror).
        match lir_fp_width_of(st)
        when Option::Some(sw) then
          if !lir_is_int_word(dst_ty) then
            return Result::Err("lir: " + ctx.fn_name + ": transmute of a float into a destination that is neither an integer word nor a float does not lower (fail-closed)")
          end
          let dst_bits = lir_int_width_bits(dst_ty)
          let want_bits = if sw == LirFpWidth::LirF32 then 32 else 64 end
          if dst_bits != want_bits then
            return Result::Err("lir: " + ctx.fn_name + ": transmute of a float of width " + want_bits.to_string() + " into an integer of width " + dst_bits.to_string() + " does not lower (a transmute preserves the bit image; only the exact-width pairs lower — fail-closed)")
          end
          if !ctx.div_ok || ctx.param_stack_mode then
            return Result::Err("lir: " + ctx.fn_name + ": transmute of a float into an integer word does not lower on this route (the register-class bit move is an aarch64-route rule; the cortex-m float slice keeps transmutes fail-closed)")
          end
          let fv = match lir_fp_value_of_operand(ctx, block_id, sw, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          lir_block_push(ctx, block_id, LirStmt {
            kind: LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, fv),
            div: Option::None,
            ptr: Option::None,
            bm: Option::Some(LirBitMoveOp::LirBitsFpToGp)
          })
          Result::Ok(())
        when Option::None then
          if !lir_is_int_word(dst_ty) || !lir_is_int_word(st) then
            if lir_is_ptr_word(dst_ty) || lir_is_ptr_word(st) then
              return Result::Err("lir: " + ctx.fn_name + ": transmute casts involving pointer/ref words do not lower (pointer words reinterpret through the Pointer cast kind — fail-closed)")
            end
            return Result::Err("lir: " + ctx.fn_name + ": transmute casts do not lower between these scalar types (only the exact-width int<->float pairs and the same-class same-width word moves lower — fail-closed)")
          end
          let wv = match lir_value_of_operand(ctx, block_id, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          if dst_v != wv then
            lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirReg(wv))
          end
          Result::Ok(())
        end
      end
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": only IntToInt/IntToFloat/FloatToInt/FloatToFloat/Pointer casts lower (an unknown cast kind does not lower — fail-closed)")
    end
  when MirRvalueKind::MirBinOp(op, left, right) then
    lir_lower_binop(ctx, block_id, dst_ty, dst_v, op, left, right)
  when MirRvalueKind::MirUnOp(op, operand) then
    lir_lower_unop(ctx, block_id, dst_ty, dst_v, op, operand)
  when MirRvalueKind::MirRef(ref_place) then
    # A MirRef (address-of) rvalue: dst <- &ref_place — the address of
    # a frame place (the marked LEA of its forced/fixed frame slot) or
    # of a deref word place (the base word, plus the place's byte
    # offset when nonzero) — see lir_lower_ref_of_place. The dst is a
    # Ptr/PtrMut/RefInternal word local admitted by the shape gate.
    if !lir_is_ptr_word(dst_ty) then
      return Result::Err("lir: " + ctx.fn_name + ": MirRef (address-of) rvalues assign a pointer/ref word local only (the destination is not Ptr/PtrMut/RefInternal — fail-closed)")
    end
    lir_lower_ref_of_place(ctx, block_id, dst_v, ref_place)
  when MirRvalueKind::MirAggregate(_, _) then
    Result::Err("lir: " + ctx.fn_name + ": aggregate construction into a scalar-word destination does not lower (rvalue and destination types disagree — fail-closed)")
  when MirRvalueKind::MirDiscriminant(disc_place) then
    # A discriminant read: dst <- the enum's TAG WORD. The tag is the
    # image's word 0 — construction stored the raw discriminant there —
    # so the read is an ordinary load of the whole enum local's first
    # fixed word vreg (the direct emitter's load-then-normalize is a
    # REGISTER-encoding matter of its TaggedPtr value words (raw tag
    # below the inline-tag threshold / heap pointer above); this slice's
    # inline images carry the raw tag in the tag word by construction,
    # so no normalization exists here). The destination is the integer
    # word the match lowering reads the discriminant into.
    if !lir_is_int_word(dst_ty) then
      return Result::Err("lir: " + ctx.fn_name + ": discriminant reads into a non-integer destination do not lower (typed MIR reads discriminants into Int words — fail-closed)")
    end
    match lir_classify_place(ctx, disc_place)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(shape) then
      match shape
      when LirPlaceShape::LirPlaceAggLocal(src_id) then
        match ctx.agg_of.get(src_id)
        when Option::Some(src_agg) then
          match src_agg.enum_shape
          when Option::Some(_) then
            let tag_v = src_agg.word_vregs[0]
            if dst_v != tag_v then
              lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirReg(tag_v))
            end
            Result::Ok(())
          when Option::None then
            Result::Err("lir: " + ctx.fn_name + ": discriminant read over a plain-struct local does not lower (typed MIR reads discriminants of enum values only — fail-closed)")
          end
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": discriminant read over a non-aggregate local (fail-closed)")
        end
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": discriminant reads lower over a whole tagged-enum local only (the scrutinee's tag word; projected/downcast discriminant places do not occur in typed MIR — fail-closed)")
      end
    end
  when MirRvalueKind::MirLen(_) then
    Result::Err("lir: " + ctx.fn_name + ": length reads do not lower (collections and slices are not implemented)")
  when MirRvalueKind::MirRepeat(_, _) then
    Result::Err("lir: " + ctx.fn_name + ": array-repeat does not lower (fixed-array aggregates are not implemented)")
  end
end

# Lower an assign whose destination is a WHOLE aggregate local (a plain
# struct or a tagged enum): only aggregate construction, whole-value
# copies and (in-block, no-op) phis may write one. A generated
# drop-glue function's HEAD COPY (`value = *ptr` — the first statement
# of its entry block) is the one whole-aggregate write that emits
# NOTHING: the machine-level entry bind (the LirAggParamBind record
# lir_resolve_glue_head_bind resolved and the agg_params walk
# assembled) already loaded the pointed-to image's words into this
# local's fixed frame slots before the first block ran — the copy
# would be a redundant register-indirect load this statement set
# cannot express (and needs no separate statement: see the generated
# drop-glue admission section). Any OTHER write into the resolved glue
# value local is a divergence from the builder's body shape and fails
# closed.
def lir_lower_agg_dst(inout ctx: LirLowerCtx, block_id: Int, dst_id: Int, rvalue: MirRvalue) -> Result[Unit, String]
  match ctx.glue_value_local
  when Option::Some(gv) then
    if gv == dst_id then
      match rvalue.kind
      when MirRvalueKind::MirMove(op) then
        let src_ok = match op.kind
        when MirOperandKind::MirCopy(p) then lir_is_deref_of_local(p, ctx.glue_head_ptr)
        when MirOperandKind::MirMovePlace(p) then lir_is_deref_of_local(p, ctx.glue_head_ptr)
        when MirOperandKind::MirRead(p) then lir_is_deref_of_local(p, ctx.glue_head_ptr)
        when MirOperandKind::MirConsume(p) then lir_is_deref_of_local(p, ctx.glue_head_ptr)
        when _ then false
        end
        if src_ok then
          Result::Ok(())
        else
          Result::Err("lir: " + ctx.fn_name + ": the generated drop-glue `value` local receives a write that is not its head copy (`value = *ptr` — the only write the builder emits into it; the machine-level entry bind performs the copy; fail-closed)")
        end
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": the generated drop-glue `value` local receives a write that is not its head copy (`value = *ptr` — the only write the builder emits into it; fail-closed)")
      end
    else
      lir_lower_agg_dst_after_glue(ctx, block_id, dst_id, rvalue)
    end
  when Option::None then
    lir_lower_agg_dst_after_glue(ctx, block_id, dst_id, rvalue)
  end
end

# The ordinary whole-aggregate-destination lowering (see
# lir_lower_agg_dst — split out so the glue head-copy skip sits in one
# place).
def lir_lower_agg_dst_after_glue(inout ctx: LirLowerCtx, block_id: Int, dst_id: Int, rvalue: MirRvalue) -> Result[Unit, String]
  match rvalue.kind
  when MirRvalueKind::MirPhi(_) then
    # Predecessor-edge copies (terminator lowering) write aggregate
    # locals word-by-word; the in-block occurrence is a no-op.
    Result::Ok(())
  when MirRvalueKind::MirAggregate(kind, operands) then
    lir_lower_agg_construction(ctx, block_id, dst_id, kind, operands)
  when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirCopy(place) then
      lir_lower_whole_copy(ctx, block_id, dst_id, place)
    when MirOperandKind::MirMovePlace(place) then
      lir_lower_whole_copy(ctx, block_id, dst_id, place)
    when MirOperandKind::MirRead(place) then
      lir_lower_whole_copy(ctx, block_id, dst_id, place)
    when MirOperandKind::MirConsume(place) then
      lir_lower_whole_copy(ctx, block_id, dst_id, place)
    when MirOperandKind::MirConstant(_) then
      Result::Err("lir: " + ctx.fn_name + ": aggregate-typed constants do not lower as whole-copy sources (aggregate/static constants are not implemented)")
    end
  when _ then
    Result::Err("lir: " + ctx.fn_name + ": a whole aggregate local accepts only aggregate construction (MirAggregate) or a whole-value copy/move; other rvalue kinds write scalar words only (fail-closed)")
  end
end

# Aggregate construction: MirAggregate(Struct(tid, literal_names))
# over a WHOLE PLAIN-STRUCT destination stores each literal operand
# into the slot of the DECLARED field it names — literals may list
# fields in any order, and a literal that omits a field leaves that
# field's slot untouched (mirroring the direct emitter's
# codegen_aggregate, which stores exactly the operands it is given).
# Each operand lowers through the scalar move path with its field's
# type, so narrow/Bool fields store their full canonical word like
# every other slot in this slice. The TAGGED-ENUM destination routes
# to lir_lower_enum_construction (the tag operand + the constructed
# variant's payload operands, stored at the variant's payload word
# offsets).
def lir_lower_agg_construction(inout ctx: LirLowerCtx, block_id: Int, dst_id: Int, kind: AggregateKind, operands: Vec[MirOperand]) -> Result[Unit, String]
  match kind
  when AggregateKind::Struct(tid, names) then
    match ctx.agg_of.get(dst_id)
    when Option::Some(agg) then
      if agg.type_id != tid.id then
        return Result::Err("lir: " + ctx.fn_name + ": aggregate construction names type id " + tid.id.to_string() + " but the destination local's aggregate type id is " + agg.type_id.to_string() + " (fail-closed)")
      end
      match agg.enum_shape
      when Option::Some(eshape) then
        lir_lower_enum_construction(ctx, block_id, dst_id, agg, eshape, operands)
      when Option::None then
        if operands.len() != names.len() then
          return Result::Err("lir: " + ctx.fn_name + ": aggregate construction carries " + operands.len().to_string() + " operands for " + names.len().to_string() + " field names (fail-closed)")
        end
        var oi = 0
        while oi < operands.len() do
          let fld = match agg.name_index.get(names[oi])
          when Option::Some(fi) then fi
          when Option::None then
            return Result::Err("lir: " + ctx.fn_name + ": aggregate construction names field `" + names[oi] + "`, which is not a field of the destination struct (fail-closed)")
          end
          let fty = agg.shape.fields[fld].ty.clone()
          let fv = agg.word_vregs[fld]
          match lir_lower_move_value(ctx, block_id, fty, fv, operands[oi])
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
          oi = oi + 1
        end
        Result::Ok(())
      end
    when Option::None then
      Result::Err("lir: " + ctx.fn_name + ": aggregate construction destination is not an aggregate local (fail-closed)")
    end
  when AggregateKind::MirArray(_) then
    Result::Err("lir: " + ctx.fn_name + ": array construction does not lower (fixed-array and collection aggregates are not implemented)")
  when AggregateKind::Tuple then
    Result::Err("lir: " + ctx.fn_name + ": tuple construction does not lower (tuple aggregates are not implemented)")
  when AggregateKind::Closure(_) then
    Result::Err("lir: " + ctx.fn_name + ": closure construction does not lower (closures are not implemented)")
  when AggregateKind::Generator(_) then
    Result::Err("lir: " + ctx.fn_name + ": generator construction does not lower (generators are not implemented)")
  end
end

# Enum construction: MirAggregate(Struct(enum_tid, ...), ops) over a
# whole tagged-enum local, mirroring the direct emitter's
# codegen_aggregate enum arm EXACTLY: the aggregate's FIRST operand is
# the tag — the constructed variant's raw discriminant, always a
# MirInt constant written by the MIR lowering (lr_enum_construct /
# lr_enum_record_construct) — and it is stored into the image's tag
# word (byte 0). The remaining operands are the constructed variant's
# PAYLOAD fields in declaration order (the direct emitter resolves the
# variant from the tag via the discriminant and stores payload operand
# k at the variant's k-th payload field offset — enum payloads carry no
# names, so the literal names are ignored, exactly as codegen ignores
# them), each stored as a full canonical word into its payload word
# slot. A construction that omits payload fields or stores into a
# variant whose payload shape differs is a typed-MIR divergence
# (fail-closed).
def lir_lower_enum_construction(inout ctx: LirLowerCtx, block_id: Int, dst_id: Int, agg: LirAggLocal, eshape: LirEnumShape, operands: Vec[MirOperand]) -> Result[Unit, String]
  if operands.len() == 0 then
    return Result::Err("lir: " + ctx.fn_name + ": enum construction carries no tag operand (the MIR lowering always writes the discriminant constant first — fail-closed)")
  end
  let tag = match operands[0].kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(v) then v
    when _ then return Result::Err("lir: " + ctx.fn_name + ": enum construction's tag operand is not an integer constant (the direct emitter reads the discriminant from the constant the MIR lowering wrote; a non-constant tag cannot resolve the variant — fail-closed)")
    end
  when _ then
    return Result::Err("lir: " + ctx.fn_name + ": enum construction's tag operand is not an integer constant (the direct emitter reads the discriminant from the constant the MIR lowering wrote; a non-constant tag cannot resolve the variant — fail-closed)")
  end
  # The constructed variant: resolved by DISCRIMINANT from the admitted
  # variant table (declaration order is never the discriminant) — the
  # mirror of codegen's enum_variant_index_of_discriminant.
  var vidx = -1
  var vi = 0
  while vi < eshape.variants.len() do
    if eshape.variants[vi].discriminant == tag then
      vidx = vi
      vi = eshape.variants.len() + 1
    else
      vi = vi + 1
    end
  end
  if vidx < 0 then
    return Result::Err("lir: " + ctx.fn_name + ": enum construction tag " + tag.to_string() + " matches no variant of the destination enum (typed MIR never produces this — fail-closed)")
  end
  let variant = eshape.variants[vidx]
  if operands.len() != 1 + variant.fields.len() then
    return Result::Err("lir: " + ctx.fn_name + ": enum construction of variant " + variant.name + " carries " + operands.len().to_string() + " operands for a variant with " + variant.fields.len().to_string() + " payload fields (typed MIR writes exactly the tag plus the variant's payload operands — fail-closed)")
  end
  # The tag word: store the discriminant into image word 0.
  match lir_lower_move_value(ctx, block_id, Type::Int, agg.word_vregs[0], operands[0])
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var oi = 1
  while oi < operands.len() do
    let pf = variant.fields[oi - 1]
    let fv = agg.word_vregs[pf.word]
    match lir_lower_move_value(ctx, block_id, pf.ty.clone(), fv, operands[oi])
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    oi = oi + 1
  end
  Result::Ok(())
end

# Whole-aggregate copy dst_local <- the whole aggregate place `src`
# (MirCopy/MirMovePlace/MirRead/MirConsume rvalues all lower
# identically — plain structs of scalar words and admitted enums have
# no drops, so a move is a copy). For a plain struct the N words are
# copied slot-by-slot between the two locals' fixed word vregs,
# mirroring the direct emitter's aggregate copy loop over the layout
# size. For a TAGGED ENUM the copy is the same loop over the IMAGE
# words — the tag word plus every payload word, i.e. a per-word whole-
# enum copy that carries the active variant's discriminant AND its
# payload together (the direct pipeline's enum whole-copy moves its
# one encoded value word instead — an encoding difference, see the
# layout-model section; the LIR image copy is the representable mirror
# of the direct image bytes).
def lir_lower_whole_copy(inout ctx: LirLowerCtx, block_id: Int, dst_id: Int, src_place: Place) -> Result[Unit, String]
  let dst_agg = match ctx.agg_of.get(dst_id)
  when Option::Some(a) then a
  when Option::None then
    return Result::Err("lir: " + ctx.fn_name + ": whole-copy destination is not an aggregate local (fail-closed)")
  end
  match lir_classify_place(ctx, src_place)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceAggLocal(src_id) then
      let src_agg = match ctx.agg_of.get(src_id)
      when Option::Some(a) then a
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": whole-copy source is not an aggregate local (fail-closed)")
      end
      if src_agg.shape.words != dst_agg.shape.words then
        return Result::Err("lir: " + ctx.fn_name + ": whole-copy between aggregate locals of different shapes does not lower (fail-closed)")
      end
      var wk = 0
      while wk < dst_agg.shape.words do
        let dv = dst_agg.word_vregs[wk]
        let sv = src_agg.word_vregs[wk]
        if dv != sv then
          # A FLOAT-field word (an image word carrying a Float/F32/F64
          # field — the word vreg's fp record is the class table)
          # copies through the FP move at the field's width (F64/Float
          # fills the word; F32 moves its 4-byte canonical image — the
          # slot's padding half is never read); integer/Bool/tag words
          # keep the full-word move.
          match lir_ctx_fp_width_of(ctx, dv)
          when Option::Some(_) then lir_emit_fp_move_vreg(ctx, block_id, dv, sv)
          when Option::None then lir_emit_move_vreg(ctx, block_id, dv, LirValue::LirReg(sv))
          end
        end
        wk = wk + 1
      end
      Result::Ok(())
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": whole-aggregate copy source is not a whole aggregate local (rvalue and destination types disagree — fail-closed)")
    end
  end
end

# Move/cast a scalar operand into dst_v.
def lir_lower_move_value(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, op: MirOperand) -> Result[Unit, String]
  match lir_fp_width_of(dst_ty)
  when Option::Some(dw) then
    # A FLOATING-POINT destination: MirFloat constants materialize
    # through LirFConst at the destination's width (the F32 emission
    # rounds the constant's host-double bits to the canonical single);
    # place-like operands must be float sources of the same width —
    # both lowered as LirFMove (the MIR has typed the move, so the
    # width check is a lowering divergence guard).
    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirFloat(_) then
        lir_append_stmt(ctx, block_id, LirStmtKind::LirFConst(dw, dst_v, lir_const_fp_bits(cst)))
        Result::Ok(())
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": only float constants move into float destinations (fail-closed)")
      end
    when MirOperandKind::MirCopy(place) then lir_fp_move_from_place(ctx, block_id, dw, dst_v, place)
    when MirOperandKind::MirMovePlace(place) then lir_fp_move_from_place(ctx, block_id, dw, dst_v, place)
    when MirOperandKind::MirRead(place) then lir_fp_move_from_place(ctx, block_id, dw, dst_v, place)
    when MirOperandKind::MirConsume(place) then lir_fp_move_from_place(ctx, block_id, dw, dst_v, place)
    end
  when Option::None then
    match op.kind
    when MirOperandKind::MirConstant(cst) then
      if !lir_is_scalar_word(dst_ty) && !lir_is_ptr_word(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": constant into a non-scalar destination does not lower (aggregate-typed constants are not implemented)")
      end
      match cst.kind
      when MirConstantKind::MirInt(_) then
        # An integer constant moves into an integer word OR a
        # pointer/ref word destination (the pointer/atomic slice — a
        # cast of the constant 0 materializes a null address word the
        # same way).
        if lir_is_int_word(dst_ty) || lir_is_ptr_word(dst_ty) then
          lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirImm(lir_const_imm(cst)))
          Result::Ok(())
        else
          Result::Err("lir: " + ctx.fn_name + ": integer constant into a Bool destination does not lower (Bool locals hold comparison results and Bool constants only)")
        end
      when MirConstantKind::MirBool(_) then
        if lir_is_bool_word(dst_ty) then
          lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirImm(lir_const_imm(cst)))
          Result::Ok(())
        else
          Result::Err("lir: " + ctx.fn_name + ": Bool constant into a non-Bool destination does not lower")
        end
      when MirConstantKind::MirUnit then
        Result::Err("lir: " + ctx.fn_name + ": unit constant move into a scalar destination does not lower")
      when MirConstantKind::MirStaticRef(did) then
        # A static's current value moved into a scalar destination: the
        # whole-word load from the static's symbol, written straight to
        # the destination vreg (the direct emitter's MirStaticRef move —
        # LEA + load — compressed into the single LirStaticLoad; the
        # data image's zero padding makes the full-word load the
        # zero-extended canonical word for narrow declared types, and
        # Bool images read back 0/1).
        if !lir_is_scalar_word(dst_ty) && !lir_is_bool_word(dst_ty) then
          return Result::Err("lir: " + ctx.fn_name + ": a static value constant moves into a scalar-word destination only (destination type is outside the scalar word set — fail-closed)")
        end
        let sym = match lir_static_symbol_of(ctx, did)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(s) then s
        end
        lir_append_stmt(ctx, block_id, LirStmtKind::LirStaticLoad(dst_v, sym))
        Result::Ok(())
      when MirConstantKind::MirStaticAddr(did) then
        Result::Err("lir: " + ctx.fn_name + ": a static ADDRESS constant (MirStaticAddr, module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") does not move into a scalar destination — address-of forms do not lower on the LIR slice (static writes and &static need pointer locals and deref places, which no shape gate admits; fail-closed)")
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": non-integer/bool/float/static constant moves do not lower (char/string/function constants are not implemented)")
      end
    when MirOperandKind::MirCopy(_) then
      lir_emit_move_from_place(ctx, block_id, dst_v, op)
    when MirOperandKind::MirMovePlace(_) then
      lir_emit_move_from_place(ctx, block_id, dst_v, op)
    when MirOperandKind::MirRead(_) then
      lir_emit_move_from_place(ctx, block_id, dst_v, op)
    when MirOperandKind::MirConsume(_) then
      # Scalar ownership move: the value is read and MIR's storage
      # accounting owns the local (the legalization contract — no runtime
      # drop exists for scalars).
      lir_emit_move_from_place(ctx, block_id, dst_v, op)
    end
  end
end

# Move dst_v <- the float value of a float-typed place (a whole float
# local), at the destination width `dw`. Class/width mismatches are
# lowering divergences (fail closed).
def lir_fp_move_from_place(inout ctx: LirLowerCtx, block_id: Int, dw: LirFpWidth, dst_v: Int, place: Place) -> Result[Unit, String]
  let src_v = match lir_place_src_vreg(ctx, place)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  match lir_ctx_fp_width_of(ctx, src_v)
  when Option::Some(sw) then
    if sw == dw then
      if src_v != dst_v then
        lir_emit_fp_move_vreg(ctx, block_id, dst_v, src_v)
      end
      Result::Ok(())
    else
      Result::Err("lir: " + ctx.fn_name + ": float move of width " + (if sw == LirFpWidth::LirF32 then "f32" else "f64" end) + " into a " + (if dw == LirFpWidth::LirF32 then "f32" else "f64" end) + " destination (a FloatToFloat cast is required; fail-closed)")
    end
  when Option::None then
    Result::Err("lir: " + ctx.fn_name + ": non-float source moved into a float destination (fail-closed)")
  end
end

# Move dst_v <- the scalar value of a place-like operand (a whole
# scalar local or a scalar field of a plain-struct local).
def lir_emit_move_from_place(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, op: MirOperand) -> Result[Unit, String]
  match op.kind
  when MirOperandKind::MirCopy(place) then
    lir_move_from_place(ctx, block_id, dst_v, place)
  when MirOperandKind::MirMovePlace(place) then
    lir_move_from_place(ctx, block_id, dst_v, place)
  when MirOperandKind::MirRead(place) then
    lir_move_from_place(ctx, block_id, dst_v, place)
  when MirOperandKind::MirConsume(place) then
    lir_move_from_place(ctx, block_id, dst_v, place)
  when MirOperandKind::MirConstant(_) then
    Result::Err("lir: " + ctx.fn_name + ": constant operands lower through the constant path, not the place path (fail-closed)")
  end
end

def lir_move_from_place(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, place: Place) -> Result[Unit, String]
  # A DEREF word place source reads through the marked register-
  # indirect load into the destination (the pointer/atomic slice's
  # deref read — one load, never a stale cached value).
  match lir_classify_place(ctx, place)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      return lir_lower_deref_word_read(ctx, block_id, dst_v, place)
    when _ then ()
    end
  end
  let src_v = match lir_place_src_vreg(ctx, place)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  # A float source place moves through the FP statement shape; the
  # destination is the mirror of the source's class (typed MIR moves
  # within one float type).
  match lir_ctx_fp_width_of(ctx, src_v)
  when Option::Some(_) then
    match lir_ctx_fp_width_of(ctx, dst_v)
    when Option::Some(_) then
      if src_v != dst_v then
        lir_emit_fp_move_vreg(ctx, block_id, dst_v, src_v)
      end
      Result::Ok(())
    when Option::None then
      Result::Err("lir: " + ctx.fn_name + ": float source moved into a general-word destination without a cast (fail-closed)")
    end
  when Option::None then
    if src_v != dst_v then
      lir_emit_move_vreg(ctx, block_id, dst_v, LirValue::LirReg(src_v))
    end
    Result::Ok(())
  end
end

# Right operand of a binop: registers stay registers; scalar constants
# stay immediates (the emitter materializes as needed). A MirStaticRef
# (a static's current value) is not an immediate: it materializes into
# a fresh register through LirStaticLoad and returns as LirReg.
def lir_binop_rhs(inout ctx: LirLowerCtx, block_id: Int, op: MirOperand) -> Result[LirValue, String]
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(_) then Result::Ok(LirValue::LirImm(lir_const_imm(cst)))
    when MirConstantKind::MirBool(_) then Result::Ok(LirValue::LirImm(lir_const_imm(cst)))
    when MirConstantKind::MirStaticRef(_) then
      let sv = match lir_materialize_static_ref(ctx, block_id, cst)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(v) then v
      end
      Result::Ok(LirValue::LirReg(sv))
    when MirConstantKind::MirStaticAddr(did) then
      Result::Err("lir: " + ctx.fn_name + ": a static ADDRESS constant (MirStaticAddr, module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") cannot be a binop operand — address-of forms do not lower on the LIR slice (static writes and &static need pointer locals and deref places, which no shape gate admits; fail-closed)")
    when MirConstantKind::MirUnit then Result::Err("lir: " + ctx.fn_name + ": unit constant cannot be a binop operand")
    when _ then Result::Err("lir: " + ctx.fn_name + ": non-integer/bool constants cannot be binop operands (float/char/string/function constants are not implemented)")
    end
  when MirOperandKind::MirCopy(place) then
    lir_rhs_from_place(ctx, block_id, place)
  when MirOperandKind::MirMovePlace(place) then
    lir_rhs_from_place(ctx, block_id, place)
  when MirOperandKind::MirRead(place) then
    lir_rhs_from_place(ctx, block_id, place)
  when MirOperandKind::MirConsume(place) then
    lir_rhs_from_place(ctx, block_id, place)
  end
end

# The LirValue of a place-like binop operand: a frame place's source
# vreg, or a DEREF word place materialized into a fresh register
# through the marked load (the read-site funnel).
def lir_rhs_from_place(inout ctx: LirLowerCtx, block_id: Int, place: Place) -> Result[LirValue, String]
  match lir_classify_place(ctx, place)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      let tmp = lir_fresh_vreg(ctx)
      match lir_lower_deref_word_read(ctx, block_id, tmp, place)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      Result::Ok(LirValue::LirReg(tmp))
    when _ then
      let v = match lir_place_src_vreg(ctx, place)
      when Result::Ok(vv) then vv
      when Result::Err(e) then return Result::Err(e)
      end
      Result::Ok(LirValue::LirReg(v))
    end
  end
end

# The float width of an operand pair when BOTH operands are floats of
# the SAME width (a typed float expression); Option::None for integer/
# Bool pairs. A float/int MIX (or a float width mismatch between two
# non-constant operands) is a typed-MIR divergence — fail closed with
# the concrete rule. MirFloat constants whose own type is the legacy
# Float spelling are width-NEUTRAL here (the MIR literal lowering
# stamps every float literal Float even when the checked expression
# type is F32/F64): when one operand is such a constant and the other
# is not, the pair's width is the NON-CONSTANT operand's width (the
# constant is then materialized and rounded at that width — see
# lir_fp_value_of_operand); two constants fall back to the left one's
# width.
def lir_operand_is_mir_float_const(op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFloat(_) then true
    when _ then false
    end
  when _ then false
  end
end

def lir_operand_pair_fp_width(ctx: LirLowerCtx, left: MirOperand, right: MirOperand) -> Result[Option[LirFpWidth], String]
  match lir_operand_ty(ctx, left)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(lt) then
    match lir_operand_ty(ctx, right)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(rt) then
      let lw = lir_fp_width_of(lt)
      let rw = lir_fp_width_of(rt)
      match lw
      when Option::Some(w) then
        match rw
        when Option::Some(rww) then
          if w == LirFpWidth::LirF64 && lir_operand_is_mir_float_const(left) && !lir_operand_is_mir_float_const(right) then
            # A Float-typed MirFloat constant on the left of a narrower
            # (F32) float context: the non-constant operand's width
            # decides.
            Result::Ok(Option::Some(rww))
          else
            Result::Ok(Option::Some(w))
          end
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": mixed float/integer binop operands do not lower (the typed MIR never produces them; fail-closed)")
        end
      when Option::None then
        match rw
        when Option::Some(_) then
          Result::Err("lir: " + ctx.fn_name + ": mixed float/integer binop operands do not lower (the typed MIR never produces them; fail-closed)")
        when Option::None then Result::Ok(Option::None)
        end
      end
    end
  end
end

# The float binop statement op for an MIR float arithmetic op.
def lir_fp_op_of(op: MirBinOp) -> Option[LirFpBinOp]
  match op
  when MirBinOp::Add then Option::Some(LirFpBinOp::LirFAdd)
  when MirBinOp::Sub then Option::Some(LirFpBinOp::LirFSub)
  when MirBinOp::Mul then Option::Some(LirFpBinOp::LirFMul)
  when MirBinOp::Div then Option::Some(LirFpBinOp::LirFDiv)
  when _ then Option::None
  end
end

# Lower a float arithmetic binop (dst is the float destination):
# three-register FADD/FSUB/FMUL/FDIV at the pair's width. The direct
# emitter's exact instruction choices (codegen_float_binop's aarch64
# stream) apply width-corrected: the strict IEEE semantics of the
# P1-6 spec are the S/D forms themselves — F32 ops round to single
# exactly once per op, F64 ops round to double — and @fp(fast)
# functions emit the identical stream (the fast paths are recorded
# mode state, see the LirFpBinOp doc).
def lir_lower_fp_arith(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, w: LirFpWidth, fop: LirFpBinOp, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  let lv = match lir_fp_value_of_operand(ctx, block_id, w, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let rv = match lir_fp_value_of_operand(ctx, block_id, w, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  lir_append_stmt(ctx, block_id, LirStmtKind::LirFBinop(fop, w, dst_v, lv, rv))
  Result::Ok(())
end

# Lower a float comparison: FCMP + Cset into the Bool destination,
# mirroring codegen.tg's float-compare sequence exactly — the six
# conditions EQ/NE/MI(lt)/LS(le)/GT/GE over the FCMP flags give the
# ordered IEEE semantics of the strict spec (a NaN operand makes every
# compare except != false), and the LirFCmp/LirCset pair obeys the
# LirCmp/LirCset flag discipline of invariant I1.
def lir_lower_fp_cmp(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, op: MirBinOp, w: LirFpWidth, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  let lv = match lir_fp_value_of_operand(ctx, block_id, w, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let rv = match lir_fp_value_of_operand(ctx, block_id, w, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  lir_append_stmt(ctx, block_id, LirStmtKind::LirFCmp(w, lv, rv))
  # The float conditions coincide with the SIGNED integer codes (lt =
  # MI, le = LS, gt = GT, ge = GE), so the signed lir_cond_of table is
  # exactly the codegen float cset table.
  lir_append_stmt(ctx, block_id, LirStmtKind::LirCset(lir_cond_of(op, false), dst_v))
  Result::Ok(())
end

def lir_lower_binop(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, op: MirBinOp, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  # The FLOAT dispatch (the float slice): a float operand pair routes
  # to the float shapes — the four arithmetic ops (Add/Sub/Mul/Div —
  # a float Mod stays fail-closed) and the six comparisons, whose
  # destination is the Bool word the compare produces.
  match lir_operand_pair_fp_width(ctx, left, right)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(pair_w) then
    match pair_w
    when Option::Some(w) then
      match lir_fp_op_of(op)
      when Option::Some(fop) then
        match lir_fp_width_of(dst_ty)
        when Option::Some(dw) then
          if dw != w then
            return Result::Err("lir: " + ctx.fn_name + ": float arithmetic writes a " + (if dw == LirFpWidth::LirF32 then "f32" else "f64" end) + " destination from " + (if w == LirFpWidth::LirF32 then "f32" else "f64" end) + " operands (fail-closed)")
          end
          lir_lower_fp_arith(ctx, block_id, dst_v, w, fop, left, right)
        when Option::None then
          Result::Err("lir: " + ctx.fn_name + ": float arithmetic writes a non-float destination (fail-closed)")
        end
      when Option::None then
        match op
        when MirBinOp::Mod then
          Result::Err("lir: " + ctx.fn_name + ": float remainder does not lower (no fmod instruction exists in the float slice's op set — a runtime fmod call is not implemented)")
        when MirBinOp::BitAnd then
          Result::Err("lir: " + ctx.fn_name + ": bitwise-and over floats does not lower (float bitwise ops are not implemented)")
        when MirBinOp::BitOr then
          Result::Err("lir: " + ctx.fn_name + ": bitwise-or over floats does not lower (float bitwise ops are not implemented)")
        when MirBinOp::BitXor then
          Result::Err("lir: " + ctx.fn_name + ": bitwise-xor over floats does not lower (float bitwise ops are not implemented)")
        when MirBinOp::Shl then
          Result::Err("lir: " + ctx.fn_name + ": shifts over floats do not lower (float bitwise ops are not implemented)")
        when MirBinOp::Shr then
          Result::Err("lir: " + ctx.fn_name + ": shifts over floats do not lower (float bitwise ops are not implemented)")
        when _ then
          # The six comparisons.
          lir_lower_fp_cmp(ctx, block_id, dst_v, op, w, left, right)
        end
      end
    when Option::None then
      match op
      when MirBinOp::Add then
        lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirAdd, left, right)
      when MirBinOp::Sub then
        lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirSub, left, right)
      when MirBinOp::Mul then
        lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirMul, left, right)
      when MirBinOp::BitAnd then
        # A Bool destination routes the checked-chain logical ops (BitAnd of
        # two comparisons, etc.) to the Bool path; integer destinations keep
        # the integer path.
        if lir_is_bool_word(dst_ty) then
          lir_lower_bool_logical(ctx, block_id, dst_v, LirBinOp::LirAnd, left, right)
        else
          lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirAnd, left, right)
        end
      when MirBinOp::BitOr then
        if lir_is_bool_word(dst_ty) then
          lir_lower_bool_logical(ctx, block_id, dst_v, LirBinOp::LirOr, left, right)
        else
          lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirOr, left, right)
        end
      when MirBinOp::BitXor then
        if lir_is_bool_word(dst_ty) then
          lir_lower_bool_logical(ctx, block_id, dst_v, LirBinOp::LirXor, left, right)
        else
          lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirXor, left, right)
        end
      when MirBinOp::Shl then
        lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirShl, left, right)
      when MirBinOp::Shr then
        match lir_operand_signedness(ctx, left, right)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(unsigned) then
          if unsigned then
            lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirLsr, left, right)
          else
            lir_lower_int_binop(ctx, block_id, dst_ty, dst_v, LirBinOp::LirAsr, left, right)
          end
        end
      when MirBinOp::Div then
        lir_lower_divmod(ctx, block_id, dst_ty, dst_v, false, left, right)
      when MirBinOp::Mod then
        lir_lower_divmod(ctx, block_id, dst_ty, dst_v, true, left, right)
      when MirBinOp::Eq then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      when MirBinOp::Ne then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      when MirBinOp::Lt then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      when MirBinOp::Le then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      when MirBinOp::Gt then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      when MirBinOp::Ge then lir_lower_cmp(ctx, block_id, dst_v, op, left, right)
      end
    end
  end
end

def lir_lower_int_binop(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, lop: LirBinOp, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  if !lir_is_int_word(dst_ty) then
    return Result::Err("lir: " + ctx.fn_name + ": arithmetic writes a non-integer destination (Bool-typed logical ops lower through the Bool shapes)")
  end
  match lir_operand_signedness(ctx, left, right)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let lv = match lir_value_of_operand(ctx, block_id, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let rv = match lir_binop_rhs(ctx, block_id, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(lop, dst_v, LirValue::LirReg(lv), rv))
  Result::Ok(())
end

# A Bool-typed logical op (the MirAssert/checked-chain shapes: BitAnd of
# two comparisons, etc.). Bool words are 0/1; the direct emitter lowers
# these as plain word and/orr/eor over the full-width operands, so LIR
# emits the corresponding LirBinop — identical results on 0/1 operands.
def lir_lower_bool_logical(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, lop: LirBinOp, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  match lir_operand_ty(ctx, left)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(lt) then
    match lir_operand_ty(ctx, right)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(rt) then
      if !lir_is_bool_word(lt) || !lir_is_bool_word(rt) then
        return Result::Err("lir: " + ctx.fn_name + ": Bool-typed logical ops need Bool operands (integer logical ops write integer destinations)")
      end
    end
  end
  let lv = match lir_value_of_operand(ctx, block_id, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let rv = match lir_binop_rhs(ctx, block_id, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(lop, dst_v, LirValue::LirReg(lv), rv))
  Result::Ok(())
end

# Lower Div/Mod (aarch64 route; see LirDivOp/LirStmt.div for why the
# division is a marked statement rather than a LirBinOp variant).
#
# DIVISION SEMANTICS (mirroring the direct emitter — codegen.tg emits
# sdiv/msub with NO guard, and the MIR front end emits no division-by-zero
# or MIN/-1 MirAssert today: the signed checked-op set is Add/Sub/Mul
# only, so a plain `/` or `%` reaches codegen unguarded):
#   quotient  = a64 SDIV (Int operands) / UDIV (UInt operands)
#               — MIN/-1 yields the ARCHITECTURAL result MIN (aarch64
#               sdiv does not trap; x86 idiv would — the divergence is
#               pre-existing in the direct emitter, and this slice is
#               aarch64-only, so the LIR route is bit-identical to it);
#   remainder = num - q*den via a mul/sub pair the emitter fuses into one
#               MSUB (the codegen emit_smod shape; q = the sdiv/udiv
#               quotient above). Truncation is toward zero, so the
#               remainder carries the dividend's sign, exactly like the
#               aarch64 direct emitter's msub sequence.
#   /0 and %0 do NOT trap in this slice: sdiv/udiv by zero are
#               architectural (quotient 0; the msub remainder form yields
#               the dividend), no MIR guard exists to lower, and the
#               direct emitter behaves identically. When a MirAssert
#               (DivisionByZero/RemainderByZero/Overflow/BoundsCheck —
#               all uniform) DOES guard the division in MIR, its lowering
#               (lir_lower_assert) branches to the function's trap block
#               BEFORE this rvalue can execute.
def lir_lower_divmod(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, is_mod: Bool, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  if !ctx.div_ok then
    return Result::Err("lir: " + ctx.fn_name + ": integer " + (if is_mod then "remainder" else "division") + " does not lower on this LIR route (sdiv/udiv lowering is aarch64-slice-only; the riscv/cortex-m LIR slices have no division encoders — fail-closed)")
  end
  if !lir_is_int_word(dst_ty) then
    return Result::Err("lir: " + ctx.fn_name + ": division writes a non-integer destination")
  end
  let unsigned = match lir_operand_signedness(ctx, left, right)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(u) then u
  end
  let num = match lir_value_of_operand(ctx, block_id, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let den = match lir_value_of_operand(ctx, block_id, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let dop = if unsigned then LirDivOp::LirUdiv else LirDivOp::LirSdiv end
  if is_mod then
    # q = num / den (marked quotient); r = num - q*den as a mul/sub pair —
    # the emitter's MADD/MSUB fusion collapses the pair into one MSUB
    # (the aarch64 codegen emit_smod form) whenever the allocation allows;
    # the unfused mul+sub is equally correct (identical mod-2^64 wrap).
    let q = lir_fresh_vreg(ctx)
    lir_append_div_stmt(ctx, block_id, dop, q, num, den)
    let u = lir_fresh_vreg(ctx)
    lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(LirBinOp::LirMul, u, LirValue::LirReg(q), LirValue::LirReg(den)))
    lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(LirBinOp::LirSub, dst_v, LirValue::LirReg(num), LirValue::LirReg(u)))
  else
    lir_append_div_stmt(ctx, block_id, dop, dst_v, num, den)
  end
  Result::Ok(())
end

# An integer comparison (Eq..Ge) materializing 0/1 into a Bool
# destination via Cmp + Cset (invariant I1 keeps the pair fused).
# Bool/Bool comparisons (the checked chains compare their flags with
# Eq/Ne) classify as signed words — the direct emitter compares the
# full-width 0/1 words with the signed condition; integer pairs use the
# integer signedness rule (lir_operand_signedness).
def lir_lower_cmp(inout ctx: LirLowerCtx, block_id: Int, dst_v: Int, op: MirBinOp, left: MirOperand, right: MirOperand) -> Result[Unit, String]
  var unsigned = false
  match lir_operand_ty(ctx, left)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(lt) then
    match lir_operand_ty(ctx, right)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(rt) then
      if lir_is_bool_word(lt) && lir_is_bool_word(rt) then
        unsigned = false
      elsif lir_is_ptr_word(lt) && lir_is_ptr_word(rt) then
        # Pointer/ref comparisons (the pointer/atomic slice): addresses
        # are unsigned machine words — every comparison (equality and
        # the ordering tests alike) lowers unsigned (the direct emitter
        # treats pointer values as words; a null test compares against
        # the cast 0 word).
        unsigned = true
      else
        let u = match lir_operand_signedness(ctx, left, right)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        unsigned = u
      end
    end
  end
  let lv = match lir_value_of_operand(ctx, block_id, left)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let rv = match lir_binop_rhs(ctx, block_id, right)
  when Result::Ok(v) then v
  when Result::Err(e) then return Result::Err(e)
  end
  let cond = lir_cond_of(op, unsigned)
  lir_append_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirReg(lv), rv))
  lir_append_stmt(ctx, block_id, LirStmtKind::LirCset(cond, dst_v))
  Result::Ok(())
end

def lir_lower_unop(inout ctx: LirLowerCtx, block_id: Int, dst_ty: Type, dst_v: Int, op: MirUnOp, operand: MirOperand) -> Result[Unit, String]
  match op
  when MirUnOp::Not then
    # Bool Not (the checked chains negate their overflow flag with it):
    # codegen emits test r,r / setcc eq, normalizing the 0/1 word; LIR
    # mirrors it with Cmp 0 + Cset eq (invariant I1 keeps the pair
    # fused).
    if !lir_is_bool_word(dst_ty) then
      return Result::Err("lir: " + ctx.fn_name + ": Not writes a Bool destination only (integer bitwise-not lowers as BitNot; a float Not has no rule — float values are not 0/1 words)")
    end
    let sv = match lir_value_of_operand(ctx, block_id, operand)
    when Result::Ok(v) then v
    when Result::Err(e) then return Result::Err(e)
    end
    lir_append_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirReg(sv), LirValue::LirImm(0)))
    lir_append_stmt(ctx, block_id, LirStmtKind::LirCset(LirCond::LirEq, dst_v))
    Result::Ok(())
  when MirUnOp::Neg then
    # A float destination negates with FNEG (s/d by the width); an
    # integer destination keeps the integer neg path. Both mirror the
    # direct emitter's unop choices (codegen's float Neg lowers
    # through the D-form FNEG; the width-correct S/D split below is
    # the float slice's canonical-width rule).
    match lir_fp_width_of(dst_ty)
    when Option::Some(w) then
      let sv = match lir_fp_value_of_operand(ctx, block_id, w, operand)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      lir_append_stmt(ctx, block_id, LirStmtKind::LirFNeg(w, dst_v, sv))
      Result::Ok(())
    when Option::None then
      if !lir_is_int_word(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": Neg writes a non-integer/non-float destination")
      end
      let sv = match lir_value_of_operand(ctx, block_id, operand)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      lir_append_stmt(ctx, block_id, LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, sv))
      Result::Ok(())
    end
  when MirUnOp::BitNot then
    if !lir_is_int_word(dst_ty) then
      if lir_is_fp_type(dst_ty) then
        return Result::Err("lir: " + ctx.fn_name + ": BitNot over a float destination does not lower (float bitwise ops are not implemented)")
      end
      return Result::Err("lir: " + ctx.fn_name + ": BitNot writes a non-integer destination")
    end
    let sv = match lir_value_of_operand(ctx, block_id, operand)
    when Result::Ok(v) then v
    when Result::Err(e) then return Result::Err(e)
    end
    lir_append_stmt(ctx, block_id, LirStmtKind::LirUnop(LirUnOp::LirBitNot, dst_v, sv))
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# Lowering — terminators
# ———————————————————————————————————————————————————————————————

# Successor block ids of an MIR terminator (codegen.tg's successor list —
# the phi-edge scan authority).
def lir_succ_ids(term: MirTerminator) -> Vec[Int]
  var succs: Vec[Int] = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    succs.push(target.id)
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    var ti = 0
    while ti < targets.len() do
      succs.push(targets[ti].target.id)
      ti = ti + 1
    end
    succs.push(default_target.id)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    succs.push(success.id)
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    succs.push(target.id)
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    succs.push(target.id)
  when _ then ()
  end
  succs
end

# Is local id `s` the DESTINATION of a pending parallel move other than
# index `skip`?
def lir_parallel_is_pending_dst(pending: Vec[(Int, Int)], s: Int, skip: Int) -> Bool
  var i = 0
  while i < pending.len() do
    if i != skip then
      if pending[i].0 == s then
        return true
      end
    end
    i = i + 1
  end
  false
end

# Resolve a parallel move problem (dst, src) LOCAL pairs into a safe
# sequential LirMove sequence appended to the current block: sources are
# read before any of their writers; cycles are broken with the function's
# scratch virtual register (canonical algorithm: emit free moves until
# stuck, save a cycle source to the scratch, then walk the chain of pairs
# whose destination equals the saved source back to the saved pair).
# A pair whose locals are AGGREGATES (plain structs or tagged enums —
# an enum phi rotates the whole image: the tag word plus every payload
# word, one pair per word) expands to one pair
# per word (dst word k <- src word k) BEFORE the cycle resolution, so
# whole-aggregate phi edges stay parallel and cycle-safe like scalar
# edges. A dst/src pair whose shapes disagree fails closed.
def lir_emit_parallel_moves(inout ctx: LirLowerCtx, block_id: Int, pairs: Vec[(Int, Int)]) -> Result[Unit, String]
  var pending: Vec[(Int, Int)] = Vec::new()
  var pi = 0
  while pi < pairs.len() do
    let dst_id = pairs[pi].0
    let src_id = pairs[pi].1
    match ctx.agg_of.get(dst_id)
    when Option::Some(dst_agg) then
      # Aggregate destination: the source local must be an aggregate of
      # the same shape (MIR-typed phis copy equal types).
      match ctx.agg_of.get(src_id)
      when Option::Some(src_agg) then
        if src_agg.shape.words != dst_agg.shape.words then
          return Result::Err("lir: " + ctx.fn_name + ": phi edge between aggregate locals of different shapes does not lower (fail-closed)")
        end
        var wk = 0
        while wk < dst_agg.shape.words do
          let dv = dst_agg.word_vregs[wk]
          let sv = src_agg.word_vregs[wk]
          if dv != sv then
            pending.push((dv, sv))
          end
          wk = wk + 1
        end
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": phi edge from a non-aggregate local into an aggregate local does not lower (fail-closed)")
      end
    when Option::None then
      let dst_v = match lir_vreg_of_local(ctx, dst_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      let src_v = match lir_vreg_of_local(ctx, src_id)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      if dst_v != src_v then
        pending.push((dst_v, src_v))
      end
    end
    pi = pi + 1
  end
  while pending.len() > 0 do
    var progress = false
    var i = 0
    while i < pending.len() do
      let d = pending[i].0
      let s = pending[i].1
      if s == d then
        var pruned: Vec[(Int, Int)] = Vec::new()
        var j = 0
        while j < pending.len() do
          if j != i then
            pruned.push(pending[j])
          end
          j = j + 1
        end
        pending = pruned
        progress = true
      elsif !lir_parallel_is_pending_dst(pending, s, i) then
        # A float pair (an FP destination vreg) moves through the
        # float statement shape; general pairs keep the word move.
        match lir_ctx_fp_width_of(ctx, d)
        when Option::Some(_) then lir_emit_fp_move_vreg(ctx, block_id, d, s)
        when Option::None then lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(d, LirValue::LirReg(s)))
        end
        var pruned: Vec[(Int, Int)] = Vec::new()
        var j = 0
        while j < pending.len() do
          if j != i then
            pruned.push(pending[j])
          end
          j = j + 1
        end
        pending = pruned
        progress = true
      else
        i = i + 1
      end
    end
    if !progress then
      # A cycle: save the source of the first pair to the scratch, then
      # follow the chain of pairs whose destination equals the saved
      # source until the chain returns to the first pair's destination;
      # close with the scratch move. A float cycle uses the width's FP
      # scratch vreg (a cycle's edges all rotate locals of one type —
      # the width is uniform); a general cycle uses ctx.scratch.
      let d0 = pending[0].0
      let s0 = pending[0].1
      let cycle_scratch = match lir_ctx_fp_width_of(ctx, d0)
      when Option::Some(w) then
        match w
        when LirFpWidth::LirF32 then ctx.scratch_fp32
        when LirFpWidth::LirF64 then ctx.scratch_fp64
        end
      when Option::None then ctx.scratch
      end
      match lir_ctx_fp_width_of(ctx, cycle_scratch)
      when Option::Some(_) then lir_emit_fp_move_vreg(ctx, block_id, cycle_scratch, s0)
      when Option::None then lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(cycle_scratch, LirValue::LirReg(s0)))
      end
      var cur = s0
      while cur != d0 do
        var found = false
        var ci = 0
        while ci < pending.len() do
          if pending[ci].0 == cur then
            let dd = pending[ci].0
            let ss = pending[ci].1
            match lir_ctx_fp_width_of(ctx, dd)
            when Option::Some(_) then lir_emit_fp_move_vreg(ctx, block_id, dd, ss)
            when Option::None then lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(dd, LirValue::LirReg(ss)))
            end
            var pruned: Vec[(Int, Int)] = Vec::new()
            var j = 0
            while j < pending.len() do
              if j != ci then
                pruned.push(pending[j])
              end
              j = j + 1
            end
            pending = pruned
            cur = ss
            found = true
            ci = pending.len() + 1
          else
            ci = ci + 1
          end
        end
        if !found then
          return Result::Err("lir: " + ctx.fn_name + ": internal parallel-move cycle resolution failure (fail-closed)")
        end
      end
      match lir_ctx_fp_width_of(ctx, cycle_scratch)
      when Option::Some(_) then lir_emit_fp_move_vreg(ctx, block_id, d0, cycle_scratch)
      when Option::None then lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(d0, LirValue::LirReg(cycle_scratch)))
      end
      var pruned: Vec[(Int, Int)] = Vec::new()
      var j = 0
      while j < pending.len() do
        if pending[j].0 != d0 then
          pruned.push(pending[j])
        end
        j = j + 1
      end
      pending = pruned
    end
  end
  Result::Ok(())
end

# Gather the phi-edge (dst, src) local pairs every successor expects from
# the current block, then append their cycle-safe copies to the current
# block's statements (the codegen.tg emit_phi_copies convention: copies
# run at the end of the predecessor, before its terminator).
def lir_lower_phi_edges(inout ctx: LirLowerCtx, f: MirFunction, block: MirBlock) -> Result[Unit, String]
  let succs = lir_succ_ids(block.terminator)
  let cur_id = block.id.id
  var si = 0
  while si < succs.len() do
    let succ_id = succs[si]
    if succ_id < f.blocks.len() then
      var pairs: Vec[(Int, Int)] = Vec::new()
      let succ_block = f.blocks[succ_id]
      var st_i = 0
      while st_i < succ_block.statements.len() do
        let stmt = succ_block.statements[st_i]
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          match rvalue.kind
          when MirRvalueKind::MirPhi(ph_entries) then
            if place.projections.len() != 0 then
              return Result::Err("lir: " + ctx.fn_name + ": phi destinations with projections do not lower (only whole locals receive phi edges)")
            end
            var pe = 0
            while pe < ph_entries.len() do
              if ph_entries[pe].0.id == cur_id then
                pairs.push((place.local.id, ph_entries[pe].1.id))
              end
              pe = pe + 1
            end
          when _ then ()
          end
        when _ then ()
        end
        st_i = st_i + 1
      end
      if pairs.len() > 0 then
        match lir_emit_parallel_moves(ctx, block.id.id, pairs)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
    end
    si = si + 1
  end
  Result::Ok(())
end

# Lower one block's terminator (phi edges first, then the terminator;
# call argument moves/pushes precede the call terminator).
def lir_lower_terminator(inout ctx: LirLowerCtx, f: MirFunction, block: MirBlock) -> Result[Unit, String]
  let block_id = block.id.id
  match block.terminator.kind
  when MirTerminatorKind::MirGoto(target) then
    match lir_lower_phi_edges(ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    lir_set_term(ctx, block_id, LirTermKind::LirJump(target.id))
    Result::Ok(())
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    match lir_lower_phi_edges(ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    lir_lower_switch(ctx, block_id, op, targets, default_target)
  when MirTerminatorKind::MirReturn then
    # The value MirReturn returns is locals[0] (the return place): a
    # scalar local resolves to its vreg (loaded to x0 by the emitter).
    # A Scalar-class aggregate return local (an admitted <= 8-byte
    # image — a one-word plain struct OR the payload-less tagged-enum
    # image, whose tag word is the whole value) also resolves to ONE
    # word: its fixed memory-home vreg,
    # which the emitter's ordinary Ret load resolves through the spill
    # machinery into x0 exactly like a scalar return. An sret
    # (16-byte / > 8-byte) function's aggregate return local — an
    # sret-class plain-struct image OR a payloaded tagged-enum image
    # under the LIR-internal enum ABI — has no
    # single return word, so its Ret lowers bare — the emitter's sret
    # copy-out (function-wide state on LirAlloc) performs the [x8]
    # stores at every Ret.
    let rv: Option[Int] = if f.locals.len() > 0 then
      match ctx.vreg_of.get(f.locals[0].id.id)
      when Option::Some(v) then Option::Some(v)
      when Option::None then
        # Aggregate return local: the Scalar-class (<= 8-byte) image
        # returns its single word in x0 (admitted one-word shapes
        # always occupy exactly one word — see
        # lir_agg_is_scalar_class); every larger (sret-class) image
        # returns through the x8 copy-out and stays bare.
        match ctx.agg_of.get(f.locals[0].id.id)
        when Option::Some(ret_agg) then
          if lir_agg_is_scalar_class(ret_agg.shape) then
            Option::Some(lir_agg_word_vreg(ctx, f.locals[0].id.id, 0))
          else
            Option::None
          end
        when Option::None then Option::None
        end
      end
    else
      Option::None
    end
    lir_set_term(ctx, block_id, LirTermKind::LirRet(rv))
    Result::Ok(())
  when MirTerminatorKind::MirUnreachable then
    lir_set_term(ctx, block_id, LirTermKind::LirTrap)
    Result::Ok(())
  when MirTerminatorKind::MirAbort then
    lir_set_term(ctx, block_id, LirTermKind::LirTrap)
    Result::Ok(())
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    match lir_lower_phi_edges(ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match unwind
    when Option::Some(_) then
      return Result::Err("lir: " + ctx.fn_name + ": calls with an unwind continuation do not lower (unwind/cleanup is not implemented)")
    when Option::None then ()
    end
    match intrinsic
    when Option::Some(_) then
      return Result::Err("lir: " + ctx.fn_name + ": intrinsic calls do not lower (no intrinsic body exists in the LIR subset)")
    when Option::None then ()
    end
    match func.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirFnItem(callee_name) then
        # (pointer/atomic slice — the atomic-intrinsic call recognition):
        # a call whose callee is one of the __intrinsic_atomic_* extern
        # names (the std::atomic declarations — codegen.tg's
        # try_emit_atomic_builtin name test) lowers INLINE on the
        # aarch64 routes, on the cortex-m route with the atomic
        # surface open, and on the riscv route with the atomic surface
        # open (rv_atomics): the per-ordering LSE/load/store sequences of
        # lir_lower_atomic_call (the a64 route) or the same marked
        # statements at the route's widths (the cm route — the
        # thumb backend translates each marked form into its ARMv7-M
        # LDREX/STREX/DMB sequence — and the riscv route — the rv
        # backend translates each marked form into its A-extension
        # LR/SC + FENCE sequence) replace the ordinary call machinery
        # (these names have no symbol; an ordinary extern call would
        # never link). The aarch64-route gate (div_ok, no AAPCS
        # param-stack mode) mirrors the statement markers' route scope;
        # the cortex-m gate is the cm_atomics flag and the riscv gate
        # the rv_atomics flag (see their ctx docs).
        if (ctx.div_ok && !ctx.param_stack_mode || ctx.cm_atomics || ctx.rv_atomics) && callee_name.starts_with("__intrinsic_atomic_") then
          lir_lower_atomic_call(ctx, block_id, callee_name, dest, args, success)
        else
          lir_lower_call(ctx, block_id, callee_name, dest, args, success)
        end
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": non-function-item call operands do not lower (fn items only; indirect calls through function values are not implemented)")
      end
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": indirect call operands do not lower (function pointers and closures are not implemented)")
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    # The MirDeinit slice (see lir_lower_deinit): whole-value destruction
    # lowers as a no-op or a direct finalizer call on the aarch64
    # whole-program route; the table-less entries keep the fail-closed
    # rejection. The phi edges run first (the target block's phis read
    # the current block's locals — the MirCall convention), then the
    # destruction lowering, whose terminator branches to the MirDeinit
    # target (the direct emitter's MirDeinit arm: call, then jump).
    match unwind
    when Option::Some(_) then
      return Result::Err("lir: " + ctx.fn_name + ": MirDeinit with an unwind continuation does not lower (unwind/cleanup is not implemented; the MIR emits MirDeinit without unwind)")
    when Option::None then ()
    end
    match lir_lower_phi_edges(ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    lir_lower_deinit(ctx, block, place, target)
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    lir_lower_assert(ctx, f, block, cond, expected, target)
  end
end

# Lower a MirAssert terminator — the generic assert -> trap rule that
# guards Div/Mod (division/remainder by zero), signed checked arithmetic
# (Overflow) and bounds/contract checks. ALL AssertMessage variants share
# one mechanism (the message payload only names the diagnostic), mirroring
# the direct emitter's MirAssert arm (codegen.tg: load cond, test, branch
# to the continuation when the condition's TRUTH VALUE equals expected —
# `test` + jcc Ne for expected=true, jcc Eq for expected=false — trap
# otherwise; unwind is not represented in this slice, so an assert failure
# always traps). The condition is any scalar word: Bool locals are 0/1,
# an Int condition is nonzero == true, so a future division-by-zero guard
# can test the divisor operand itself:
#   constant condition: folded statically — LirJump(target) when the
#     assert holds (nonzero == expected), LirTrap when it always fails
#     (the block itself becomes the trap; the target stays a normal block
#     for its other predecessors);
#   register condition: a one-arm zero-test LirSwitch whose polarity
#     mirrors the codegen jcc — expected=false tests cond == 0 to
#     continue, expected=true tests cond == 0 to TRAP:
#       expected=false -> LirSwitch(cond, [arm { 0 -> target }], trap)
#       expected=true  -> LirSwitch(cond, [arm { 0 -> trap }], target)
#     (LirCond needs no additions; the default arm is the continuation or
#     the function's synthetic trap block). The trap block is appended
#     after the MIR blocks by lower_mir_fn_to_lir_mode when ctx.trap_used
#     is set.
def lir_lower_assert(inout ctx: LirLowerCtx, f: MirFunction, block: MirBlock, cond: MirOperand, expected: Bool, target: MirBlockId) -> Result[Unit, String]
  let block_id = block.id.id
  var cond_known: Option[Bool] = Option::None
  match cond.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirBool(b) then cond_known = Option::Some(b)
    when MirConstantKind::MirStaticRef(_) then
      # A static condition's VALUE is not statically known: it takes the
      # register-condition path below (lir_value_of_operand materializes
      # the LirStaticLoad of the Bool static's word).
      ()
    when MirConstantKind::MirStaticAddr(did) then
      return Result::Err("lir: " + ctx.fn_name + ": a static ADDRESS constant (MirStaticAddr, module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") cannot be an assert condition — address-of forms do not lower on the LIR slice (fail-closed)")
    when _ then
      return Result::Err("lir: " + ctx.fn_name + ": MirAssert condition constant must be Bool (fail-closed)")
    end
  when _ then ()
  end
  match cond_known
  when Option::Some(b) then
    if b == expected then
      match lir_lower_phi_edges(ctx, f, block)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      lir_set_term(ctx, block_id, LirTermKind::LirJump(target.id))
    else
      lir_set_term(ctx, block_id, LirTermKind::LirTrap)
    end
    Result::Ok(())
  when Option::None then
    match lir_lower_phi_edges(ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    let cv = match lir_value_of_operand(ctx, block_id, cond)
    when Result::Ok(v) then v
    when Result::Err(e) then return Result::Err(e)
    end
    ctx.trap_used = true
    if expected then
      # cond nonzero continues (jcc NE mirror): the zero arm traps.
      var arms: Vec[LirSwitchArm] = Vec::new()
      arms.push(LirSwitchArm { value: 0, target: lir_trap_block_id() })
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(cv, arms, target.id))
    else
      # cond zero continues (jcc EQ mirror): the zero arm is the target.
      var arms: Vec[LirSwitchArm] = Vec::new()
      arms.push(LirSwitchArm { value: 0, target: target.id })
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(cv, arms, lir_trap_block_id()))
    end
    Result::Ok(())
  end
end

# Lower a MirSwitchInt: a register operand is compared per arm (value
# equality) with branches to the arm targets, falling through the default
# jump; a CONSTANT operand resolves statically — except a static
# reference constant (MirStaticRef), whose VALUE is not statically
# known: it materializes through the register path (LirStaticLoad into
# a vreg) exactly like a register operand.
def lir_lower_switch(inout ctx: LirLowerCtx, block_id: Int, op: MirOperand, targets: Vec[SwitchTarget], default_target: MirBlockId) -> Result[Unit, String]
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(v) then
      var ti = 0
      var chosen: Option[Int] = Option::None
      while ti < targets.len() do
        if targets[ti].value == v then
          chosen = Option::Some(targets[ti].target.id)
          ti = targets.len() + 1
        else
          ti = ti + 1
        end
      end
      match chosen
      when Option::Some(tid) then
        lir_set_term(ctx, block_id, LirTermKind::LirJump(tid))
        Result::Ok(())
      when Option::None then
        lir_set_term(ctx, block_id, LirTermKind::LirJump(default_target.id))
        Result::Ok(())
      end
    when MirConstantKind::MirStaticRef(_) then
      # A static's value is only known at load time: lower the register
      # switch over the loaded word (the MirStaticRef materialization of
      # lir_value_of_operand; MirSwitchInt is an integer terminator, so
      # the static is a scalar word of the slice).
      let vreg = match lir_value_of_operand(ctx, block_id, op)
      when Result::Ok(v) then v
      when Result::Err(e) then return Result::Err(e)
      end
      var arms: Vec[LirSwitchArm] = Vec::new()
      var ti2 = 0
      while ti2 < targets.len() do
        arms.push(LirSwitchArm { value: targets[ti2].value, target: targets[ti2].target.id })
        ti2 = ti2 + 1
      end
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(vreg, arms, default_target.id))
      Result::Ok(())
    when MirConstantKind::MirStaticAddr(did) then
      Result::Err("lir: " + ctx.fn_name + ": a static ADDRESS constant (MirStaticAddr, module " + did.module.id.to_string() + ", index " + did.index.to_string() + ") cannot be a switch operand — address-of forms do not lower on the LIR slice (static writes and &static need pointer locals and deref places, which no shape gate admits; fail-closed)")
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": constant switch operands must be integers (float switch operands do not lower — MirSwitchInt is an integer terminator; fail-closed)")
    end
  when _ then
    # MirSwitchInt is an integer-only terminator: a float register
    # operand would lower into a switch the aarch64 zero-test encoders
    # cannot consume (cbz/cbnz are general-register forms). The typed
    # front end never produces one — the guard is defensive.
    match lir_operand_ty(ctx, op)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(oty) then
      if lir_is_fp_type(oty) then
        return Result::Err("lir: " + ctx.fn_name + ": switch over a float operand does not lower (MirSwitchInt is an integer terminator; float comparisons produce Bool locals, which switch as 0/1 words — fail-closed)")
      end
    end
    let vreg = match lir_value_of_operand(ctx, block_id, op)
    when Result::Ok(v) then v
    when Result::Err(e) then return Result::Err(e)
    end
    var arms: Vec[LirSwitchArm] = Vec::new()
    var ti = 0
    while ti < targets.len() do
      arms.push(LirSwitchArm { value: targets[ti].value, target: targets[ti].target.id })
      ti = ti + 1
    end
    lir_set_term(ctx, block_id, LirTermKind::LirSwitch(vreg, arms, default_target.id))
    Result::Ok(())
  end
end

# Lower a MirCall terminator: run the per-class ABI walk (GENERAL-class
# arguments — integer/Bool words and by-value aggregate addresses —
# into the fixed x-register vregs 0..(abi_regs-1); FLOAT-class arguments
# into the fixed float vregs 8..15 (d0..d7); stack-class arguments of
# either class pushed in DESCENDING stack-position order — 16-byte
# caller slots on the aarch64 mode, 4-byte AAPCS words (even in count,
# padding included) on the cortex-m mode), and register the call
# terminator (SP cleanup and the success jump are emitted with it).
def lir_lower_call(inout ctx: LirLowerCtx, block_id: Int, callee_name: String, dest: Place, args: Vec[MirCallArg], success: MirBlockId) -> Result[Unit, String]
  if args.len() > 32 then
    return Result::Err("lir: " + ctx.fn_name + ": calls with more than 32 arguments do not lower (fail-closed; the caller-slot area below that is bounded by construction)")
  end
  # Destination: a scalar destination (a whole scalar local — an
  # integer/Bool word OR a float local — or a scalar field of a
  # plain-struct local — the field's fixed word vreg) receives the
  # full-width result (the direct emitter's post-call store rule for
  # compiled callees — narrow widths are not re-normalized here; see
  # the module header's call-ABI note; a FLOAT destination's result
  # crosses back in the FP return register d0/s0, captured by the
  # emitter's float capture arm); a Unit
  # destination carries no vreg; a whole plain-struct destination whose
  # image takes an sret class lowers through the CALLER side of the
  # sret ABI (the caller-side slice — see the sret-return slice
  # section): the destination local is stack-homed by construction (the
  # fixed-slot rule), the term carries NO result vreg (dest = None —
  # the callee's copy-out writes the destination through the x8 it
  # receives), and this block is recorded on ctx.sret_call_slots with
  # the destination aggregate's base_slot so the aarch64 call emitter
  # can form &dest ([FP - 8 - 8*base_slot]) in x8 right before the
  # call. A whole-aggregate destination whose image is the Scalar class
  # (<= 8 bytes — its ONE word crosses back in x0) lowers through the
  # SAME word capture a scalar destination uses: dest carries the
  # destination word's fixed memory-home vreg and the emitter's
  # ordinary post-call capture (x0 -> the vreg def, which stores its
  # fixed slot) writes the destination — the codegen.tg classify_return
  # Direct path, now taken instead of failing closed. A whole
  # TAGGED-ENUM destination lowers under the LIR-internal enum ABI (one
  # crossing convention per image class): a payload-less enum's
  # raw-discriminant tag word captures x0 into the tag word's fixed
  # vreg like any Scalar-class destination, and a PAYLOADED enum
  # destination is an sret-class destination — the x8 protocol, exactly
  # like a 16-byte / > 8-byte plain-struct destination (see
  # lir_enum_crossing_rule for the divergence from the direct
  # pipeline's one-word TaggedPtr enum return, which no LIR callee
  # follows; an extern callee still does, and the whole-program
  # entries reject that crossing — see lir_check_extern_enum_calls).
  var dest_v: Option[Int] = Option::None
  match lir_classify_place(ctx, dest)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceUnit(_) then ()
    when LirPlaceShape::LirPlaceScalarLocal(dst_id) then
      let v = match lir_vreg_of_local(ctx, dst_id)
      when Result::Ok(vv) then vv
      when Result::Err(e) then return Result::Err(e)
      end
      dest_v = Option::Some(v)
    when LirPlaceShape::LirPlaceField(lid, fidx) then
      dest_v = Option::Some(lir_agg_word_vreg(ctx, lid, fidx))
    when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
      # A scalar-returning call whose destination is a variant payload
      # field (a scalar word of the enum image): the x0 capture defines
      # the payload word's fixed vreg exactly like a struct field
      # destination.
      let payload_word = match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then eshape.variants[vidx].fields[fidx].word
        when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-enum local (fail-closed)")
        end
      when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-aggregate local (fail-closed)")
      end
      dest_v = Option::Some(lir_agg_word_vreg(ctx, lid, payload_word))
    when LirPlaceShape::LirPlaceAggLocal(dst_id) then
      # Whole-aggregate destination: the LirPlaceAggLocal arm only
      # classifies a whole local with EMPTY projections (field/other
      # projections classify as scalar field places or fail earlier), so
      # the empty-projection + stack-home conditions of codegen.tg's
      # classify_return are satisfied by construction; the class is the
      # same classification the callee side applies — a whole
      # PLAIN-STRUCT destination whose image is an sret image
      # (lir_agg_sret_words: exactly 16 bytes or more than 8 bytes)
      # lowers through the x8 protocol, a Scalar-class image (<= 8
      # bytes — exactly one word, see lir_agg_is_scalar_class) lowers
      # as a one-word destination whose post-call x0 capture defines
      # its fixed slot. A whole TAGGED-ENUM destination mirrors the
      # enum return classification of the callee side under the
      # LIR-internal enum ABI (see the section above): the payload-less
      # tag-word image captures x0 into the tag word like any
      # Scalar-class destination, and a PAYLOADED image takes the sret
      # x8 protocol below (no LIR callee crosses the direct pipeline's
      # one-word TaggedPtr enum return — a payloaded enum's direct
      # crossing word would be the heap-pointer encoding this slice
      # cannot materialize; see lir_enum_crossing_rule).
      match ctx.agg_of.get(dst_id)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then
          # The whole tagged-enum destination, under the LIR-internal
          # enum ABI (see the sret-return slice section and
          # lir_enum_crossing_rule): a payload-less image's raw-
          # discriminant tag word captures x0 into the tag word's
          # fixed vreg like any Scalar-class destination, and a
          # PAYLOADED image is an sret-class destination — this block
          # is recorded on ctx.sret_call_slots exactly like a whole
          # plain-struct sret destination, the emitter forms &dest in
          # x8 right before the call, and the callee's copy-out (its
          # own sret Ret) writes the destination's image words.
          if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) then
            dest_v = Option::Some(agg.word_vregs[0])
          else
            ctx.sret_call_slots.insert(block_id, agg.base_slot)
          end
        when Option::None then
          if lir_agg_sret_words(agg.shape) > 0 then
            ctx.sret_call_slots.insert(block_id, agg.base_slot)
          elsif lir_agg_is_scalar_class(agg.shape) then
            dest_v = Option::Some(agg.word_vregs[0])
          else
            return Result::Err("lir: " + ctx.fn_name + ": call destination of aggregate type whose admitted image classifies as neither an sret class (exactly 16 bytes or more than 8 bytes — delivered through x8) nor the Scalar class (<= 8 bytes — one word crossing back in x0); no admitted whole-word shape lands between the two, so this is a shape-gate divergence (fail-closed)")
          end
        end
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": call destination classifies as a whole aggregate local with no lowering record in this function (the function shape gate and the lowering disagree — fail-closed)")
      end
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      # A deref-word call destination would need a post-call
      # register-indirect store the ordinary call capture does not
      # express; the atomic-intrinsic lowering (lir_lower_atomic_call)
      # supports deref destinations of its inline results, ordinary
      # calls do not (fail-closed).
      return Result::Err("lir: " + ctx.fn_name + ": call destinations that are deref places do not lower (the ordinary call capture writes a scalar local / aggregate word group only; fail-closed)")
    end
  end
  # Arguments: scalar words of any supported width travel in full 64-bit
  # words as MirCallValue::Value operands; scalar FIELD arguments
  # resolve like any scalar place. A whole TAGGED-ENUM argument (place-
  # or value-form over a whole enum local) lowers under the LIR-internal
  # enum ABI (see the sret-return slice section): the payload-less
  # form's raw-discriminant tag word crosses BY VALUE
  # in the argument's ONE general-class slot (the ordinary scalar move
  # path below; a stack-class slot pushes the tag word), and a
  # PAYLOADED form crosses BY REFERENCE — the argument's ONE slot
  # carries the source image group's frame address, exactly like an
  # address-class plain-struct argument (an agg_call_args record; the
  # caller-side mirror of the payloaded-enum parameter binding).
  # An ADMITTED plain-struct aggregate
  # argument (the aggregate-argument slice — see LirAggCallArg) is a
  # whole plain-struct LOCAL with empty projections: MIR carries it as a
  # MirCallValue::Place (codegen.tg's aggregate-argument rule — every
  # source-level struct argument is place-like), or, for a
  # CONSTRUCTED-TEMPORARY aggregate (a struct literal lowered by an
  # earlier MirAssign into a fresh whole-local word group, which the
  # call operand then references), as a place-like MirCallValue::Value
  # operand over that whole local — either way the argument's words sit
  # in the source local's stack-homed word group. It consumes ONE
  # positional ABI slot — its index among ALL arguments, exactly the
  # aggregate-param geometry. An ADDRESS-class image (lir_agg_sret_words
  # > 0: exactly 16 bytes or more than 8 bytes) has the slot carry the
  # ADDRESS of the
  # source word-group's first frame slot ([FP - 8 - 8*base_slot]): the
  # source aggregate never rides a virtual register. Lowering therefore
  # records the argument (slot + source base_slot) on ctx.agg_call_args
  # for this block's call terminator and lets the aarch64 call emitter
  # form the address at the call site (x_slot for slots 0..7; for
  # slots >= 8 the argument's 16-byte caller slot is reserved by the
  # ordinary LirPushArg statement stream below — pushing the source's
  # first-word vreg as a placeholder word — and the emitter overwrites
  # that word with the address right before the branch, in the sret x8
  # lea ordering). A Scalar-class image (<= 8 bytes — every admitted
  # such shape is exactly its ONE word, a single whole-word field)
  # crosses BY VALUE as that word in the argument's ONE slot through
  # the ordinary scalar-argument move path (the register-class
  # plain-struct argument slice — the caller-side mirror of the
  # register-class plain-struct parameter binding and of the
  # payload-less tagged-enum argument above; the word rides the
  # source's fixed memory-home vreg, so the arg move loads it).
  # Scalar (and Unit/field) Place arguments keep the by-reference
  # rejection: they are access semantics, not this slice's aggregate
  # ABI.
  var arg_vregs: Vec[Int] = Vec::new()
  var arg_is_agg: Vec[Bool] = Vec::new()
  # FLOAT-class arguments (a value-word of the Float/F32/F64 types):
  # they cross in the SIMD&FP ABI register file (d0..d7 by their FP
  # position) or the caller stack, never in the general registers —
  # the per-class ABI walk below.
  var arg_is_fp: Vec[Bool] = Vec::new()
  # Per-argument ABI classification of the per-class walk: arg_reg_pos
  # = the argument's register-class position (-1 = stack-class) and
  # arg_stack_pos = its caller-stack position (-1 = register-class).
  # GENERAL-class register arguments cross in x[gp_pos]; FLOAT-class
  # register arguments in d[fp_pos]; stack-class arguments of BOTH
  # classes share ONE positional stream (the arg's position among the
  # stack-class arguments, in argument order) — the AAPCS64 geometry
  # of the module-header ABI note.
  var arg_reg_pos: Vec[Int] = Vec::new()
  var arg_stack_pos: Vec[Int] = Vec::new()
  var agg_call_recs: Vec[LirAggCallArg] = Vec::new()
  # The per-class register-position counters of the walk (the aarch64
  # mode passes the first 8 register-class arguments of each class in
  # x0..x7 / d0..d7 with INDEPENDENT positional numbering; the
  # cortex-m mode's general register count is lir_arg_reg_count(mode)
  # — r0..r3 — and its gate rejects every float, so the FP counter
  # never advances there). stk counts the stack-class arguments — the
  # shared caller-stack stream — in argument order.
  let abi_regs = lir_arg_reg_count(ctx.param_stack_mode)
  var gp_pos = 0
  var fp_pos = 0
  var stk_pos = 0
  var ai = 0
  while ai < args.len() do
    # Normalize the argument to its aggregate source: Option::Some(lid)
    # when the argument is a whole-aggregate argument over the admitted
    # aggregate local `lid` (its word group is the ABI image source),
    # Option::None when it is a scalar/Unit argument, a scalar field
    # argument or a by-reference shape (handled below).
    var agg_src: Option[Int] = Option::None
    match args[ai].value
    when MirCallValue::Place(p) then
      match lir_classify_place(ctx, p)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(shape) then
        match shape
        when LirPlaceShape::LirPlaceAggLocal(lid) then agg_src = Option::Some(lid)
        when _ then ()
        end
      end
    when MirCallValue::Value(op) then
      # The value-form aggregate argument: a place-like operand over a
      # whole aggregate local — the constructed-temporary case, whose
      # word group the construction's MirAssign already filled. The
      # source address travels in the slot exactly like the place form
      # (the callee's entry copy reads the words from the caller's
      # frame at its own entry, before any caller-side write can
      # intervene, so the value semantics hold through the address).
      match op.kind
      when MirOperandKind::MirCopy(agg_p) then agg_src = lir_whole_agg_local_id(ctx, agg_p)
      when MirOperandKind::MirMovePlace(agg_p) then agg_src = lir_whole_agg_local_id(ctx, agg_p)
      when MirOperandKind::MirRead(agg_p) then agg_src = lir_whole_agg_local_id(ctx, agg_p)
      when MirOperandKind::MirConsume(agg_p) then agg_src = lir_whole_agg_local_id(ctx, agg_p)
      when _ then ()
      end
    end
    match agg_src
    when Option::Some(agg_lid) then
      # The aggregate-argument admission. The source local is stack-
      # homed by the fixed-slot rule (empty projections by construction
      # of the classification above); the KIND decides the crossing:
      #   - a whole PLAIN-STRUCT argument lowers by its image class
      #     (the mirror of the aggregate-param gate): an ADDRESS-class
      #     image consumes ONE
      #     GENERAL-class slot carrying the source word-group's ADDRESS
      #     (one general-register position per argument — the image
      #     address is a general word, never a float one; for
      #     signatures without float arguments the GP position equals
      #     the argument's index, the codegen.tg classify_argument
      #     geometry), while a one-word Scalar-class image crosses BY
      #     VALUE as its single word in the ONE general-class slot —
      #     the register-class plain-struct argument slice, the exact
      #     mirror of the payload-less tagged-enum argument below;
      #   - a whole TAGGED-ENUM argument lowers under the LIR-internal
      #     enum ABI (the caller-side mirror of the tagged-enum
      #     parameter binding): the PAYLOAD-LESS image's
      #     raw-discriminant tag word travels in the argument's ONE
      #     general-class slot as an ordinary VALUE (the tag vreg is
      #     the value source, exactly like a scalar-word argument),
      #     while a PAYLOADED image crosses BY REFERENCE like an
      #     address-class plain-struct argument — its ONE slot carries
      #     the source image group's frame ADDRESS (the crossing word
      #     of the direct pipeline's enum ABI would be the TaggedPtr
      #     heap-pointer encoding; see lir_enum_crossing_rule).
      let agg = match ctx.agg_of.get(agg_lid)
      when Option::Some(a) then a
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": call argument " + ai.to_string() + " classifies as a whole aggregate local with no lowering record in this function (the function shape gate and the lowering disagree — fail-closed)")
      end
      match agg.enum_shape
      when Option::Some(eshape) then
        if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) then
          # The payload-less enum argument: the tag word crosses BY
          # VALUE in the argument's one general-class slot, exactly like
          # a scalar-word argument (the tag vreg is the value source; a
          # stack-class argument pushes the word through the ordinary
          # LirPushArg stream).
          arg_vregs.push(lir_agg_word_vreg(ctx, agg_lid, 0))
          arg_is_agg.push(false)
          arg_is_fp.push(false)
          if gp_pos < abi_regs then
            arg_reg_pos.push(gp_pos)
            arg_stack_pos.push(-1)
            gp_pos = gp_pos + 1
          else
            arg_reg_pos.push(-1)
            arg_stack_pos.push(stk_pos)
            stk_pos = stk_pos + 1
          end
        else
          # The PAYLOADED tagged-enum argument — the LIR-internal enum
          # ABI: the exact by-reference mirror of the address-class
          # plain-struct argument below. The source's inline image
          # group sits in its fixed frame slots; ONE positional ABI
          # slot carries its address (formed by the call emitter right
          # before the branch), and the callee's entry copy reads the
          # words from it. The record is the SHARED LirAggCallArg form
          # — the machine-level act is kind-agnostic.
          if lir_agg_sret_words(agg.shape) == 0 then
            return Result::Err("lir: " + ctx.fn_name + ": call argument " + ai.to_string() + " is a tagged enum whose admitted image classifies as neither the Scalar class (<= 8 bytes — the payload-less tag word crossing by value) nor an sret class (exactly 16 bytes or more than 8 bytes — the payloaded image crossing as its frame address); no admitted whole-word enum image lands between the two, so this is a shape-gate divergence (fail-closed)")
          end
          if gp_pos < abi_regs then
            agg_call_recs.push(LirAggCallArg { slot: gp_pos, base_slot: agg.base_slot })
            arg_reg_pos.push(gp_pos)
            arg_stack_pos.push(-1)
            gp_pos = gp_pos + 1
          else
            # Stack-class aggregate argument: the record's slot carries
            # the emitter's 8+stk convention (the caller word at
            # [SP + 16*(slot-8)] == [SP + 16*stk] after all pushes —
            # the LirAggCallArg doc).
            agg_call_recs.push(LirAggCallArg { slot: 8 + stk_pos, base_slot: agg.base_slot })
            arg_reg_pos.push(-1)
            arg_stack_pos.push(stk_pos)
            stk_pos = stk_pos + 1
          end
          # The placeholder word for the argument's positional slot: the
          # source's first-word vreg (the tag word). Register-class
          # slots never read it (no move is emitted for an aggregate
          # argument — the call site forms the address in the fixed ABI
          # register instead); stack-class slots push it to reserve the
          # 16-byte caller word in the descending stream, and the call
          # site overwrites the pushed word with the source address
          # before the branch.
          arg_vregs.push(lir_agg_word_vreg(ctx, agg_lid, 0))
          arg_is_agg.push(true)
          arg_is_fp.push(false)
        end
      when Option::None then
        if lir_agg_is_scalar_class(agg.shape) then
          # A one-word (Scalar-class) plain-struct argument: the
          # admitted image IS its single word, which crosses BY VALUE
          # in the argument's ONE class slot exactly like a
          # scalar-word argument — the register-class plain-struct
          # argument slice, the caller-side mirror of the register-
          # class plain-struct parameter binding (and of the payload-
          # less enum argument above). The source is the word's fixed
          # memory-home vreg, so the register move loads it; a
          # stack-class argument pushes the word through the ordinary
          # LirPushArg stream. A one-word image whose word is a FLOAT
          # field (word-0's fp record — the float-field slice) takes
          # the FLOAT-class slot instead: the argument IS the field
          # value, so it crosses like a scalar float of the word's
          # width (register-class moves through the fixed float ABI
          # registers at FP position fp_pos; beyond d0..d7 it joins
          # the float stack stream like any float argument) — the
          # callee's binding walk classifies the parameter the same
          # way, so both sides agree.
          let wv = lir_agg_word_vreg(ctx, agg_lid, 0)
          match lir_ctx_fp_width_of(ctx, wv)
          when Option::Some(_) then
            arg_vregs.push(wv)
            arg_is_agg.push(false)
            arg_is_fp.push(true)
            if fp_pos < 8 then
              arg_reg_pos.push(fp_pos)
              arg_stack_pos.push(-1)
            else
              arg_reg_pos.push(-1)
              arg_stack_pos.push(stk_pos)
              stk_pos = stk_pos + 1
            end
            fp_pos = fp_pos + 1
          when Option::None then
            arg_vregs.push(wv)
            arg_is_agg.push(false)
            arg_is_fp.push(false)
            if gp_pos < abi_regs then
              arg_reg_pos.push(gp_pos)
              arg_stack_pos.push(-1)
              gp_pos = gp_pos + 1
            else
              arg_reg_pos.push(-1)
              arg_stack_pos.push(stk_pos)
              stk_pos = stk_pos + 1
            end
          end
        else
          # An ADDRESS-class plain-struct argument (defensive
          # divergence gate: every admitted plain-struct image beyond
          # the Scalar class is an sret class — exactly 16 bytes or
          # more than 8 bytes).
          if lir_agg_sret_words(agg.shape) == 0 then
            return Result::Err("lir: " + ctx.fn_name + ": call argument " + ai.to_string() + " is a plain struct whose admitted image classifies as neither the Scalar class (<= 8 bytes — its one word crossing by value in the argument's slot) nor an sret class (exactly 16 bytes or more than 8 bytes — carrying the source word-group's address in the argument's ONE ABI slot); no admitted whole-word shape lands between the two, so this is a shape-gate divergence (fail-closed)")
          end
          if gp_pos < abi_regs then
            agg_call_recs.push(LirAggCallArg { slot: gp_pos, base_slot: agg.base_slot })
            arg_reg_pos.push(gp_pos)
            arg_stack_pos.push(-1)
            gp_pos = gp_pos + 1
          else
            # Stack-class aggregate argument: the record's slot carries the
            # emitter's 8+stk convention (the caller word at
            # [SP + 16*(slot-8)] == [SP + 16*stk] after all pushes — the
            # LirAggCallArg doc).
            agg_call_recs.push(LirAggCallArg { slot: 8 + stk_pos, base_slot: agg.base_slot })
            arg_reg_pos.push(-1)
            arg_stack_pos.push(stk_pos)
            stk_pos = stk_pos + 1
          end
          # The placeholder word for the argument's positional slot: the
          # source's first-word vreg. Register-class slots never read it
          # (no move is emitted for an aggregate argument — the call
          # site forms the address in the fixed ABI register instead);
          # stack-class slots push it to reserve the 16-byte caller word
          # in the descending stream, and the call site overwrites the
          # pushed word with the source address before the branch.
          arg_vregs.push(lir_agg_word_vreg(ctx, agg_lid, 0))
          arg_is_agg.push(true)
          arg_is_fp.push(false)
        end
      end
    when Option::None then
      match args[ai].value
      when MirCallValue::Place(_) then
        # A whole scalar/Unit local, a scalar field, or any other
        # by-reference shape: access semantics, not this slice's ABI.
        return Result::Err("lir: " + ctx.fn_name + ": by-reference (Place) call arguments do not lower (references and access semantics are not implemented; whole aggregate places lower as call arguments — a whole plain-struct place carrying the source word-group's address in the argument's ONE ABI slot, a whole payload-less tagged-enum place carrying its tag word by value, and a whole payloaded tagged-enum place carrying its source image group's address in the ONE slot under the LIR-internal enum ABI — and every other Place argument stays fail-closed)")
      when MirCallValue::Value(op) then
        let aty = match lir_operand_ty(ctx, op)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(t) then t
        end
        if !lir_is_scalar_word(aty) && !lir_is_fp_type(aty) && !lir_is_ptr_word(aty) then
          # A non-scalar value argument that is NOT a whole-aggregate
          # operand (Unit values, and non-scalar constants/operands a
          # lowerable callee can never declare — the normalization
          # above already admitted every whole-aggregate operand):
          # fail closed rather than silently dropping the words.
          return Result::Err("lir: " + ctx.fn_name + ": call arguments must be scalar words, pointer/ref words or floats in this slice (Int/UInt/Bool/ISize/USize/I8/I16/I32/U8/U16/U32/Ptr/PtrMut/RefInternal/Float/F32/F64; whole plain-struct aggregate arguments lower on the program-level aarch64 route when their words sit in a whole aggregate local's word group — an admitted image: the address-class images (exactly 16 bytes or more than 8 bytes) carry the source word-group's address in the ONE slot, the Scalar-class one-word images cross by value — as MirCallValue::Place, or as a place-like operand over the constructed temporary's local, and whole tagged-enum arguments lower there too under the LIR-internal enum ABI: a payload-less image's tag word by value or a payloaded image's frame address in the ONE slot — and every other non-scalar value argument stays fail-closed)")
        end
        match lir_fp_width_of(aty)
        when Option::Some(_) then
          # A FLOAT-class argument: it crosses in the FP register file
          # by its float position (d0..d7 while fp_pos < 8) or — on the
          # aarch64 mode — on the caller stack in the shared stream (a
          # float at FP position >= 8 joins the general overflow words
          # on the SAME positional caller-stack stream, one 16-byte
          # slot each in argument order — the callee's entry bind
          # reads the value at its width from the slot base, so the
          # stream advances one slot per stacked argument of either
          # class). The cortex-m mode (AAPCS32) has bound float stack
          # PARAMETERS since its float-ABI slice but its caller side
          # (the width-aware AAPCS float pushes) is the next slice, so
          # it keeps the fail-closed rejection below.
          let aw = match lir_fp_width_of(aty)
          when Option::Some(v) then v
          when Option::None then panic("lir: internal: float arg width vanished (fail-closed)")
          end
          let av = match lir_fp_value_of_operand(ctx, block_id, aw, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          arg_vregs.push(av)
          arg_is_agg.push(false)
          arg_is_fp.push(true)
          if fp_pos < 8 then
            arg_reg_pos.push(fp_pos)
            arg_stack_pos.push(-1)
          else
            if ctx.param_stack_mode then
              return Result::Err("lir: " + ctx.fn_name + ": call argument " + ai.to_string() + " is a float beyond the eight float-class argument registers (d0..d7); float STACK arguments do not lower on the cortex-m route (the width-aware AAPCS32 float-stack caller pushes are the next slice — its callee side has bound float stack parameters since the float-ABI slice; fail-closed)")
            end
            arg_reg_pos.push(-1)
            arg_stack_pos.push(stk_pos)
            stk_pos = stk_pos + 1
          end
          fp_pos = fp_pos + 1
        when Option::None then
          # A GENERAL-class value argument (integer/Bool word).
          let av = match lir_value_of_operand(ctx, block_id, op)
          when Result::Ok(v) then v
          when Result::Err(e) then return Result::Err(e)
          end
          arg_vregs.push(av)
          arg_is_agg.push(false)
          arg_is_fp.push(false)
          if gp_pos < abi_regs then
            arg_reg_pos.push(gp_pos)
            arg_stack_pos.push(-1)
            gp_pos = gp_pos + 1
          else
            arg_reg_pos.push(-1)
            arg_stack_pos.push(stk_pos)
            stk_pos = stk_pos + 1
          end
        end
      end
    end
    ai = ai + 1
  end
  # Register-class arguments, per the per-class walk: a GENERAL-class
  # argument at GP position p moves into the fixed general vreg p
  # (x_p — 0..7 on the aarch64 mode, 0..3 on the cortex-m mode); a
  # FLOAT-class argument at FP position p moves into the fixed float
  # vreg 8+p (d_p). An AGGREGATE argument in a register-class slot
  # gets NO move: its slot must receive the source word-group's
  # ADDRESS, not a value, and no LIR statement can form a frame
  # address — the call emitter writes the address into the fixed ABI
  # register at the call site (the aggregate-argument slice,
  # machine-level like the sret x8 lea), so the placeholder word in
  # arg_vregs is deliberately skipped.
  var mi = 0
  while mi < arg_vregs.len() do
    if !arg_is_agg[mi] && arg_reg_pos[mi] >= 0 then
      if arg_is_fp[mi] then
        lir_append_stmt(ctx, block_id, LirStmtKind::LirFMove(lir_fixed_fp_base() + arg_reg_pos[mi], arg_vregs[mi]))
      else
        lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(arg_reg_pos[mi], LirValue::LirReg(arg_vregs[mi])))
      end
    end
    mi = mi + 1
  end
  # Stack-class arguments, pushed in DESCENDING stack-position order
  # (the highest-position argument pushed FIRST — the highest
  # address — and stack position 0 pushed LAST, so it sits at the
  # LOWEST address: [SP] at the branch from the callee's viewpoint,
  # exactly where the entry binding's canonical [FP + off] loads read
  # it — the walk's shared stream, mirroring the AAPCS64 positional
  # stack geometry).
  #   aarch64 mode: each statement reserves one 16-byte slot, so the
  #     pushes keep SP 16-aligned throughout;
  #   cortex-m mode: each statement pushes one 4-byte AAPCS word, so
  #     the pushes use 4-byte words — and the AAPCS public-interface
  #     rule (the caller's SP must be 8-byte aligned AT the branch)
  #     forces an EVEN word count. An odd count is padded by one extra
  #     word at the TOP of the caller block (the highest address — the
  #     first push), whose contents the AAPCS leaves architecturally
  #     unconstrained; pushing the first stack argument's own word
  #     again is the cheapest padding (no dead vreg to define) and the
  #     pad never reaches the callee. The chosen padding therefore
  #     keeps every even-count call word-exact and gives odd-count
  #     calls one duplicated word above the real arguments.
  #   AGGREGATE stack-class arguments ride the SAME descending stream:
  #   their arg_vregs entry is the source's first-word placeholder, so
  #   the statement reserves the argument's 16-byte caller word at the
  #   exact final position [SP + 16*stk] the callee's entry binding
  #   reads (the geometry is positional — the pushed placeholder word
  #   is overwritten with the source address by the call emitter before
  #   the branch, so its value never reaches the callee). The cortex-m
  #   mode never sees an aggregate arg (its gate rejects aggregate
  #   locals, so arg_is_agg stays all-false there and the AAPCS
  #   even-count padding below is unaffected). FLOAT stack arguments
  #   (a float beyond d0..d7) lower on the AARCH64 mode since the
  #   float-stack-argument slice: each one joins the shared positional
  #   stream (one 16-byte slot per stacked argument of either class —
  #   see the float arm above), and its LirPushArg reserves the slot
  #   and stores the value at its width like any float argument. The
  #   CORTEX-M mode's callee side has bound float stack parameters
  #   since the float-ABI slice while its caller side (float stack
  #   arguments — the width-aware AAPCS pushes) is the next slice, so
  #   the shared rejection above still guards that crossing.
  var words = stk_pos
  if ctx.param_stack_mode && words % 2 != 0 then
    # Pad with the first stack-class argument's word (by argument
    # order — the walk's stk_pos ordering).
    var pi = 0
    while pi < arg_vregs.len() do
      if arg_stack_pos[pi] == 0 then
        lir_append_stmt(ctx, block_id, LirStmtKind::LirPushArg(arg_vregs[pi]))
        pi = arg_vregs.len() + 1
      else
        pi = pi + 1
      end
    end
    words = words + 1
  end
  var si = arg_vregs.len()
  while si > 0 do
    si = si - 1
    if arg_stack_pos[si] >= 0 then
      lir_append_stmt(ctx, block_id, LirStmtKind::LirPushArg(arg_vregs[si]))
    end
  end
  # stack_args = the number of pushed caller-slot units the emitter adds
  # back to SP after the call: 16-byte slots on the aarch64 mode, 4-byte
  # words (even, the padding included) on the cortex-m mode.
  let stack_count = words
  # Register the call's aggregate arguments (the aggregate-argument
  # slice): block id -> the LirAggCallArg records in argument order,
  # read by the aarch64 call emitter to form each source word-group's
  # address in the argument's ABI slot at the call site (the
  # sret_call_slots pattern — this block's terminator is the call, so
  # the block id keys the record).
  if agg_call_recs.len() > 0 then
    ctx.agg_call_args.insert(block_id, agg_call_recs)
  end
  lir_set_term(ctx, block_id, LirTermKind::LirCall(callee_name.clone(), arg_vregs, stack_count, dest_v, success.id))
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# The pointer/atomic slice — atomic-intrinsic call lowering
# (__intrinsic_atomic_* on the aarch64, cortex-m and riscv routes)
# ———————————————————————————————————————————————————————————————
# A call whose callee is one of the __intrinsic_atomic_* extern names
# (the std::atomic declarations; the codegen.tg try_emit_atomic_builtin
# name test — these externs have NO symbol, the direct emitter inlines
# them) lowers INLINE on the aarch64 routes, on the cortex-m route
# with the atomic surface open (ctx.cm_atomics — the route flag of
# lower_mir_fn_to_lir_cm; see the shape-gate and LirLowerCtx docs; the
# width cap 1/2/4 for the cortex-m target is enforced at the top of
# lir_lower_atomic_call) and on the riscv route with the atomic
# surface open (ctx.rv_atomics — the route flag of the
# lower_mir_fn_to_lir_rv32 / lower_mir_fn_to_lir_rv64 entries; the
# width cap is the route's machine word — 1/2/4 on riscv32, 1/2/4/8
# on riscv64 — enforced at the top of lir_lower_atomic_call). The MIR call's operands are
# ordinary word operands: args[0] is the ADDRESS word of the atomic
# location (a Ptr/PtrMut/RefInternal word — from a MirRef address-of /
# a raw pointer word), the value/expected-pointer arguments follow, and
# the ORDERING code arrives as the final argument(s) — the runtime
# c_int ordering_to_c code: 0 = Relaxed, 2 = Acquire, 3 = Release,
# 4 = AcqRel, 5 = SeqCst, exactly as codegen's per-ordering dispatch
# reads it. When the order operand is an MIR integer constant the
# lowering selects the single arm statically; a runtime order word
# lowers to the per-ordering DISPATCH of codegen's emit_a64_rmw_ordered
# / cas arms — a LirSwitch over the order word whose arm blocks carry
# one marked LSE/load/store statement each (plain / +A / +L / +AL per
# the arm table) and whose optional MERGE block carries the shared tail
# (the *_fetch arithmetic, the CAS compare/bool/store-back). Every arm
# writes its defs, so the shared tail reads them like a phi implemented
# by duplication (the blocks' defs and uses stay in the linear order the
# allocator walks). The marked statements (LirPtrOp) are interpreted
# by the aarch64 emitter (the LSE/load/store arms of lir_emit_ptr_stmt),
# by the thumb emitter (the ARMv7-M LDREX/STREX/DMB sequences of
# backend_thumb.tg's pointer/atomic emission section) and by the riscv
# emitter (the A-extension LR/SC + FENCE sequences of backend_rv.tg's
# pointer/atomic emission section); this lowering
# runs only where the statement markers can be emitted (the aarch64
# routes — ctx.div_ok && !param_stack_mode, whose shape gates admit the
# pointer-word types — the cortex-m route with cm_atomics — whose
# shape gate opens the same surface at the 4-byte word — and the
# riscv route with rv_atomics — whose shape gate opens the same
# surface at the route's machine word; the plain thumb/rv
# word-only entries never reach a call site here).

# The arm form of an ordering code: 0 = Relaxed -> plain (no A/L),
# 2 = Acquire -> +A, 3 = Release -> +L, and every other code
# (4 = AcqRel, 5 = SeqCst, out-of-domain) -> +AL (the strongest form —
# the codegen dispatch's deterministic default arm).
def lir_atomic_order_form(order: Int) -> Int
  match order
  when 0 then 0
  when 2 then 1
  when 3 then 2
  when _ then 3
  end
end

# The op + storage width (in bytes) of an atomic intrinsic name
# (codegen.tg's atomic_intrinsic_op_and_width mirror): the op is the
# text before the final "_u<width>" suffix ("fetch_add", "load",
# "compare_exchange", ...), the width suffix names the atomic's memory
# width in bits (8/16/32/64 -> 1/2/4/8 bytes). "fence" has no width
# suffix (width 0). Result::Err for a malformed name / unknown width.
def lir_atomic_intrinsic_op_and_width(name: String) -> Result[(String, Int), String]
  let prefix = "__intrinsic_atomic_"
  if !name.starts_with(prefix) then
    return Result::Err("lir: atomic intrinsic name " + name + " does not carry the __intrinsic_atomic_ prefix (internal error)")
  end
  let rest = name.slice(prefix.len(), name.len())
  match rest.find("_u")
  when Option::Some(pos) then
    let op = rest.slice(0, pos)
    let wstr = rest.slice(pos + 2, rest.len())
    let width = match wstr
    when "8" then 1
    when "16" then 2
    when "32" then 4
    when "64" then 8
    when _ then 0
    end
    if width == 0 then
      Result::Err("lir: atomic intrinsic " + name + " carries an unknown width suffix (only the _u8/_u16/_u32/_u64 forms exist)")
    else
      Result::Ok((op, width))
    end
  when Option::None then
    if rest == "fence" then
      Result::Ok(("fence", 0))
    else
      Result::Err("lir: atomic intrinsic " + name + " carries no width suffix (only the width-suffixed __intrinsic_atomic_<op>_u<8|16|32|64> forms and __intrinsic_atomic_fence exist)")
    end
  end
end

# The scalar destination word of an atomic call result: Unit -> None
# (the store form), a whole scalar local / scalar field / enum payload
# field -> its vreg. Deref-word destinations do not lower for atomic
# results (like the ordinary call capture; the atomic lowering returns
# an actionable rule).
def lir_atomic_dest_v(inout ctx: LirLowerCtx, dest: Place) -> Result[Option[Int], String]
  match lir_classify_place(ctx, dest)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceUnit(_) then Result::Ok(Option::None)
    when LirPlaceShape::LirPlaceScalarLocal(dst_id) then
      let v = match lir_vreg_of_local(ctx, dst_id)
      when Result::Ok(vv) then vv
      when Result::Err(e) then return Result::Err(e)
      end
      Result::Ok(Option::Some(v))
    when LirPlaceShape::LirPlaceField(lid, fidx) then
      Result::Ok(Option::Some(lir_agg_word_vreg(ctx, lid, fidx)))
    when LirPlaceShape::LirPlaceEnumField(lid, vidx, fidx) then
      let payload_word = match ctx.agg_of.get(lid)
      when Option::Some(agg) then
        match agg.enum_shape
        when Option::Some(eshape) then eshape.variants[vidx].fields[fidx].word
        when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-enum local (fail-closed)")
        end
      when Option::None then return Result::Err("lir: " + ctx.fn_name + ": enum payload destination of a non-aggregate local (fail-closed)")
      end
      Result::Ok(Option::Some(lir_agg_word_vreg(ctx, lid, payload_word)))
    when LirPlaceShape::LirPlaceAggLocal(_) then
      Result::Err("lir: " + ctx.fn_name + ": atomic-intrinsic results write a scalar word destination only (a whole-aggregate destination does not lower for an inline atomic result — fail-closed)")
    when LirPlaceShape::LirPlaceDerefWord(_, _, _) then
      Result::Err("lir: " + ctx.fn_name + ": atomic-intrinsic results write a scalar word destination only (a deref-place destination of an atomic result would need a post-op register-indirect store the atomic lowering does not carry; fail-closed)")
    end
  end
end

# Resolve one atomic-call argument to a word vreg: a place-like
# operand resolves through the ordinary word-value funnel (a deref word
# place materializes its marked load — an atomic argument CAN be
# *ptr), a MirCallValue::Place argument lowers only when it is a whole
# scalar-word local (a bare ref/address word; every other Place form
# keeps the access-semantics rule). The arm validates the count.
def lir_atomic_arg_v(inout ctx: LirLowerCtx, block_id: Int, args: Vec[MirCallArg], idx: Int, what: String) -> Result[Int, String]
  if idx >= args.len() then
    return Result::Err("lir: " + ctx.fn_name + ": atomic call missing its " + what + " argument (the call carries " + args.len().to_string() + " arguments; fail-closed)")
  end
  match args[idx].value
  when MirCallValue::Place(p) then
    match lir_classify_place(ctx, p)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok(shape) then
      match shape
      when LirPlaceShape::LirPlaceScalarLocal(id) then
        let v = match lir_vreg_of_local(ctx, id)
        when Result::Ok(vv) then vv
        when Result::Err(e) then return Result::Err(e)
        end
        Result::Ok(v)
      when _ then
        Result::Err("lir: " + ctx.fn_name + ": by-reference (Place) atomic arguments do not lower (an atomic argument crosses as a word value; fail-closed)")
      end
    end
  when MirCallValue::Value(op) then lir_value_of_operand(ctx, block_id, op)
  end
end

# The constant ordering code of the atomic order argument, when the
# argument is an MIR integer constant (the common std form after
# inlining); Option::None for a runtime order word.
def lir_atomic_order_const(args: Vec[MirCallArg], idx: Int) -> Option[Int]
  if idx >= args.len() then
    return Option::None
  end
  match args[idx].value
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(v) then Option::Some(v)
      when _ then Option::None
      end
    when _ then Option::None
    end
  when MirCallValue::Place(_) then Option::None
  end
end

# A fresh synthetic dispatch block (see ctx.extra_blocks): negative
# ids below the trap block's -1, appended after the MIR blocks at
# assembly in creation order.
def lir_fresh_dispatch_block(inout ctx: LirLowerCtx) -> Int
  let id = ctx.next_blk
  ctx.next_blk = id - 1
  ctx.extra_blocks.push(id)
  id
end

# Append one marked pointer/atomic statement (LirPtrOp) to a block.
def lir_push_ptr_stmt(inout ctx: LirLowerCtx, block_id: Int, kind: LirStmtKind, pop: LirPtrOp) -> Unit
  var stmt = LirStmt { kind: kind, div: Option::None, ptr: Option::Some(pop) }
  lir_block_push(ctx, block_id, stmt)
end

# Lower one __intrinsic_atomic_* call inline (the atomic slice's call
# recognition — see the section header). Mirrors codegen.tg's
# emit_atomic_intrinsic_a64 per-ordering dispatch exactly: op families,
# arm forms and the deterministic out-of-domain default arms. The
# phi-edge copies of the success block already ran (the MirCall
# convention); the lowering ends block `block_id` with its own term.
def lir_lower_atomic_call(inout ctx: LirLowerCtx, block_id: Int, callee_name: String, dest: Place, args: Vec[MirCallArg], success: MirBlockId) -> Result[Unit, String]
  let (op, width) = match lir_atomic_intrinsic_op_and_width(callee_name)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(pair) then pair
  end
  # The route width caps (the atomic widths of the route's machine
  # word): on the cortex-m route only the 1/2/4-byte atomic forms
  # lower — ARMv7-M has no LDREXD/STREXD-class 8-byte exclusives and
  # no doubleword atomic instruction (even the plain 8-byte LDRD/STRD
  # pair is not single-copy atomic) — and on the riscv32 route only
  # the 1/2/4-byte atomic forms lower (the RV32 machine word is 4
  # bytes; an 8-byte access has no RV32 instruction). A _u64
  # intrinsic therefore fails closed here, on those routes, with the
  # target reason before any marked statement is produced. The
  # riscv64 route (rv_word64) admits the full 1/2/4/8-byte set at
  # lowering; the per-xlen INSTRUCTION widths (the A extension's
  # LR/SC carry only the word — and, on RV64, the doubleword — so
  # the sub-word RMW/CAS forms have no instruction) are enforced by
  # the backend's rv_validate_fn before emission.
  if ctx.cm_atomics && width > 4 then
    return Result::Err("lir: " + ctx.fn_name + ": atomic intrinsic " + callee_name + " needs an 8-byte atomic access, which the cortex-m target does not provide — ARMv7-M (the M3/M4 class) has no LDREXD/STREXD exclusives and no doubleword atomic form, and the target description's atomic widths are [1, 2, 4] bytes (fail-closed)")
  end
  if ctx.rv_atomics && !ctx.rv_word64 && width > 4 then
    return Result::Err("lir: " + ctx.fn_name + ": atomic intrinsic " + callee_name + " needs an 8-byte atomic access, which the riscv32 target does not provide — the RV32 machine word is 4 bytes, the RISC-V A extension's LR.D/SC.D doubleword exclusives are RV64 instructions, and no 8-byte atomic form exists on riscv32 (fail-closed)")
  end
  match op
  when "fence" then
    # __intrinsic_atomic_fence(order): the widthless per-ordering DMB
    # fence. Mirrors codegen.tg's emit_atomic_intrinsic_a64 fence arm
    # exactly: order code 0 (Relaxed) = NO instruction; 2 (Acquire) =
    # DMB ISHLD (the load-acquire barrier); every other code
    # (3 = Release, 4 = AcqRel, 5 = SeqCst and the out-of-domain
    # orders) = the FULL DMB ISH (a release fence must also keep later
    # loads from being observed before the prior stores — a store->load
    # crossing the store-store-only DMB ISHST does NOT prevent).
    # Unit result (nothing is written, nothing is read: the fence
    # statement's marker carries no vreg payload).
    match lir_atomic_dest_v(ctx, dest)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match lir_atomic_order_const(args, 0)
    when Option::Some(ord) then
      # Static ordering: Relaxed (0) pushes NOTHING — the codegen
      # fence arm's no-op; Acquire (2) is the ISHLD arm; every other
      # code is the full ISH arm (the deterministic strongest arm).
      if ord == 2 then
        lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirImm(0), LirValue::LirImm(0)), LirPtrOp::LirPtrFence(0))
      elsif ord != 0 then
        lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirImm(0), LirValue::LirImm(0)), LirPtrOp::LirPtrFence(1))
      end
      lir_set_term(ctx, block_id, LirTermKind::LirJump(success.id))
      Result::Ok(())
    when Option::None then
      # Runtime ordering word: the LirSwitch over the order code —
      # arm 0 (Relaxed) jumps straight to the success block (no
      # instruction, the codegen no-op), arm 2 (Acquire) runs the
      # ISHLD fence block, and the default (Release/AcqRel/SeqCst and
      # every out-of-domain code) runs the full ISH fence block — the
      # codegen chain's deterministic fall-through arm.
      let ord_v = match lir_atomic_arg_v(ctx, block_id, args, 0, "ordering")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(v) then v
      end
      let b_acq = lir_fresh_dispatch_block(ctx)
      let b_full = lir_fresh_dispatch_block(ctx)
      lir_push_ptr_stmt(ctx, b_acq, LirStmtKind::LirCmp(LirValue::LirImm(0), LirValue::LirImm(0)), LirPtrOp::LirPtrFence(0))
      lir_set_term(ctx, b_acq, LirTermKind::LirJump(success.id))
      lir_push_ptr_stmt(ctx, b_full, LirStmtKind::LirCmp(LirValue::LirImm(0), LirValue::LirImm(0)), LirPtrOp::LirPtrFence(1))
      lir_set_term(ctx, b_full, LirTermKind::LirJump(success.id))
      var arms: Vec[LirSwitchArm] = Vec::new()
      arms.push(LirSwitchArm { value: 0, target: success.id })
      arms.push(LirSwitchArm { value: 2, target: b_acq })
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(ord_v, arms, b_full))
      Result::Ok(())
    end
  when "load" then
    # __intrinsic_atomic_load_u<w>(ptr, order) -> the loaded word.
    # Arms: order 0 = the plain LDR width form (Relaxed); every other
    # code (Acquire/SeqCst/out-of-domain) = the LDAR width form (the
    # codegen load arm's deterministic strongest arm).
    let addr_v = match lir_atomic_arg_v(ctx, block_id, args, 0, "address")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    let dst_v = match lir_atomic_dest_v(ctx, dest)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(Option::Some(v)) then v
    when Result::Ok(Option::None) then
      return Result::Err("lir: " + ctx.fn_name + ": an atomic LOAD writes its result (the call destination is Unit — a typed-MIR divergence; fail-closed)")
    end
    match lir_atomic_order_const(args, 1)
    when Option::Some(ord) then
      let form = lir_atomic_order_form(ord)
      let arm = if form == 0 then 0 else 1 end
      lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, addr_v), LirPtrOp::LirAtomLoad(arm, width, dst_v, addr_v))
      lir_set_term(ctx, block_id, LirTermKind::LirJump(success.id))
      Result::Ok(())
    when Option::None then
      let ord_v = match lir_atomic_arg_v(ctx, block_id, args, 1, "ordering")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(v) then v
      end
      let b_plain = lir_fresh_dispatch_block(ctx)
      let b_strong = lir_fresh_dispatch_block(ctx)
      lir_push_ptr_stmt(ctx, b_plain, LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, addr_v), LirPtrOp::LirAtomLoad(0, width, dst_v, addr_v))
      lir_set_term(ctx, b_plain, LirTermKind::LirJump(success.id))
      lir_push_ptr_stmt(ctx, b_strong, LirStmtKind::LirUnop(LirUnOp::LirNeg, dst_v, addr_v), LirPtrOp::LirAtomLoad(1, width, dst_v, addr_v))
      lir_set_term(ctx, b_strong, LirTermKind::LirJump(success.id))
      var arms: Vec[LirSwitchArm] = Vec::new()
      arms.push(LirSwitchArm { value: 0, target: b_plain })
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(ord_v, arms, b_strong))
      Result::Ok(())
    end
  when "store" then
    # __intrinsic_atomic_store_u<w>(ptr, value, order): Unit result.
    # Arms: order 0 = plain STR (Relaxed); every other code
    # (Release/SeqCst/out-of-domain) = STLR (the codegen store arm's
    # deterministic strongest arm).
    let addr_v = match lir_atomic_arg_v(ctx, block_id, args, 0, "address")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    let val_v = match lir_atomic_arg_v(ctx, block_id, args, 1, "value")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    match lir_atomic_dest_v(ctx, dest)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match lir_atomic_order_const(args, 2)
    when Option::Some(ord) then
      let form = lir_atomic_order_form(ord)
      let arm = if form == 0 then 0 else 1 end
      lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirReg(addr_v), LirValue::LirReg(val_v)), LirPtrOp::LirAtomStore(arm, width, addr_v, val_v))
      lir_set_term(ctx, block_id, LirTermKind::LirJump(success.id))
      Result::Ok(())
    when Option::None then
      let ord_v = match lir_atomic_arg_v(ctx, block_id, args, 2, "ordering")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(v) then v
      end
      let b_plain = lir_fresh_dispatch_block(ctx)
      let b_strong = lir_fresh_dispatch_block(ctx)
      lir_push_ptr_stmt(ctx, b_plain, LirStmtKind::LirCmp(LirValue::LirReg(addr_v), LirValue::LirReg(val_v)), LirPtrOp::LirAtomStore(0, width, addr_v, val_v))
      lir_set_term(ctx, b_plain, LirTermKind::LirJump(success.id))
      lir_push_ptr_stmt(ctx, b_strong, LirStmtKind::LirCmp(LirValue::LirReg(addr_v), LirValue::LirReg(val_v)), LirPtrOp::LirAtomStore(1, width, addr_v, val_v))
      lir_set_term(ctx, b_strong, LirTermKind::LirJump(success.id))
      var arms2: Vec[LirSwitchArm] = Vec::new()
      arms2.push(LirSwitchArm { value: 0, target: b_plain })
      lir_set_term(ctx, block_id, LirTermKind::LirSwitch(ord_v, arms2, b_strong))
      Result::Ok(())
    end
  when "exchange" then
    lir_atomic_lower_rmw(ctx, block_id, 4, width, dest, args, success, op)
  when "fetch_add" | "add_fetch" then
    lir_atomic_lower_rmw(ctx, block_id, 0, width, dest, args, success, op)
  when "fetch_sub" | "sub_fetch" then
    lir_atomic_lower_rmw(ctx, block_id, 0, width, dest, args, success, op)
  when "fetch_and" | "and_fetch" then
    lir_atomic_lower_rmw(ctx, block_id, 1, width, dest, args, success, op)
  when "fetch_or" | "or_fetch" then
    lir_atomic_lower_rmw(ctx, block_id, 2, width, dest, args, success, op)
  when "fetch_xor" | "xor_fetch" then
    lir_atomic_lower_rmw(ctx, block_id, 3, width, dest, args, success, op)
  when "compare_exchange" then
    lir_atomic_lower_cas(ctx, block_id, width, dest, args, success)
  when _ then
    Result::Err("lir: " + ctx.fn_name + ": atomic intrinsic op " + op + " does not lower (the LSE RMW/exchange/load/store and compare_exchange families lower; fail-closed)")
  end
end

# One arm of the LSE RMW dispatch: the marked LirAtomRmw statement with
# the given ordering form, defining dst_v (the OLD value) and using the
# prepped value and the address. Option::Some(target) additionally ends
# the block with a jump to `target` (a dispatch ARM block); the static
# ordering path passes Option::None and keeps the block open for the
# inline tail.
def lir_atomic_rmw_arm(inout ctx: LirLowerCtx, arm_block: Int, family: Int, form: Int, width: Int, dst_v: Int, addr_v: Int, val_p: Int, target: Option[Int]) -> Unit
  lir_push_ptr_stmt(ctx, arm_block, LirStmtKind::LirBinop(LirBinOp::LirMul, dst_v, LirValue::LirReg(addr_v), LirValue::LirReg(val_p)), LirPtrOp::LirAtomRmw(family, form, width, dst_v, addr_v, val_p))
  match target
  when Option::Some(t) then lir_set_term(ctx, arm_block, LirTermKind::LirJump(t))
  when Option::None then ()
  end
end

# The LSE RMW / exchange family lowering (fetch_add/fetch_sub/
# fetch_and/fetch_or/fetch_xor/exchange and their *_fetch twins):
# __intrinsic_atomic_<op>_u<w>(ptr, value, order). The fetch_sub/
# sub_fetch and fetch_and/and_fetch forms PREP the value operand first
# (the negation / complement that turns subtraction into LDADD of -v
# and AND into LDCLR of ~v — the full-width prep is codegen's rule: the
# memory op reads the low w bits only, where the full-width forms agree
# 2-adically); every other op uses the value as-is. Arms: plain / +A /
# +L / +AL by the ordering code (codegen's emit_a64_rmw_ordered
# dispatch). The OLD value (the LSE result) IS the call result for the
# fetch_*/exchange forms; the *_fetch forms compute the new value in
# the merge tail (old <op> val at the original value — full-width, the
# codegen mirror).
def lir_atomic_lower_rmw(inout ctx: LirLowerCtx, block_id: Int, family: Int, width: Int, dest: Place, args: Vec[MirCallArg], success: MirBlockId, op: String) -> Result[Unit, String]
  let addr_v = match lir_atomic_arg_v(ctx, block_id, args, 0, "address")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let val_v = match lir_atomic_arg_v(ctx, block_id, args, 1, "value")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let dst_v = match lir_atomic_dest_v(ctx, dest)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(Option::Some(v)) then v
  when Result::Ok(Option::None) then
    return Result::Err("lir: " + ctx.fn_name + ": an atomic RMW writes its result (the call destination is Unit — a typed-MIR divergence; fail-closed)")
  end
  # The *_fetch twin's shared tail computes the new value from the old
  # (defined by the arms) and the ORIGINAL value operand; it lives in a
  # merge block the arms jump to (dynamic dispatch) or inline in this
  # block (static ordering).
  let fetch_tail = lir_atomic_fetch_binop(op)
  # The value-operand prep (fetch_sub/sub_fetch/and_fetch only): a
  # fresh prepped word the LSE reads instead of the raw value.
  var val_p = val_v
  match lir_atomic_rmw_prep(op)
  when Option::Some(prep) then
    val_p = lir_fresh_vreg(ctx)
    lir_append_stmt(ctx, block_id, LirStmtKind::LirUnop(prep, val_p, val_v))
  when Option::None then ()
  end
  # The OLD value the arms define: the fetch_*/exchange result itself
  # or the *_fetch tail's input.
  let old_v = match fetch_tail
  when Option::Some(_) then lir_fresh_vreg(ctx)
  when Option::None then dst_v
  end
  match lir_atomic_order_const(args, 2)
  when Option::Some(ord) then
    let form = lir_atomic_order_form(ord)
    lir_atomic_rmw_arm(ctx, block_id, family, form, width, old_v, addr_v, val_p, Option::None)
    match fetch_tail
    when Option::Some(bop) then
      lir_append_stmt(ctx, block_id, LirStmtKind::LirBinop(bop, dst_v, LirValue::LirReg(old_v), LirValue::LirReg(val_v)))
    when Option::None then ()
    end
    lir_set_term(ctx, block_id, LirTermKind::LirJump(success.id))
    Result::Ok(())
  when Option::None then
    let ord_v = match lir_atomic_arg_v(ctx, block_id, args, 2, "ordering")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    let b_plain = lir_fresh_dispatch_block(ctx)
    let b_acq = lir_fresh_dispatch_block(ctx)
    let b_rel = lir_fresh_dispatch_block(ctx)
    let b_al = lir_fresh_dispatch_block(ctx)
    var merge = -1
    match fetch_tail
    when Option::Some(_) then
      merge = lir_fresh_dispatch_block(ctx)
    when Option::None then ()
    end
    let arm_target: Option[Int] = if merge >= 0 then Option::Some(merge) else Option::Some(success.id) end
    lir_atomic_rmw_arm(ctx, b_plain, family, 0, width, old_v, addr_v, val_p, arm_target)
    lir_atomic_rmw_arm(ctx, b_acq, family, 1, width, old_v, addr_v, val_p, arm_target)
    lir_atomic_rmw_arm(ctx, b_rel, family, 2, width, old_v, addr_v, val_p, arm_target)
    lir_atomic_rmw_arm(ctx, b_al, family, 3, width, old_v, addr_v, val_p, arm_target)
    if merge >= 0 then
      match fetch_tail
      when Option::Some(bop) then
        lir_append_stmt(ctx, merge, LirStmtKind::LirBinop(bop, dst_v, LirValue::LirReg(old_v), LirValue::LirReg(val_v)))
      when Option::None then ()
      end
      lir_set_term(ctx, merge, LirTermKind::LirJump(success.id))
    end
    var arms: Vec[LirSwitchArm] = Vec::new()
    arms.push(LirSwitchArm { value: 0, target: b_plain })
    arms.push(LirSwitchArm { value: 2, target: b_acq })
    arms.push(LirSwitchArm { value: 3, target: b_rel })
    lir_set_term(ctx, block_id, LirTermKind::LirSwitch(ord_v, arms, b_al))
    Result::Ok(())
  end
end

# The compare_exchange lowering:
# __intrinsic_atomic_compare_exchange_u<w>(ptr, expected_ptr, desired,
# weak, success_order, failure_order): args[0] is the atomic location's
# address, args[1] the ADDRESS of the expected slot (the in/out
# expected value of the direct ABI), args[2] the desired value, args[3]
# the (unused) weak flag, args[4] the success ordering and args[5] the
# failure ordering — ignored exactly like codegen's cas arm (the
# checker validates failure <= success; the emitted CAS strength is the
# success order's). Lowering:
#   1. t_exp = the expected slot's current word (a marked deref load
#      from [expected_ptr] — the CAS instruction needs the expected
#      VALUE, and the compare after it needs the preserved copy);
#   2. the per-ordering CAS arms (plain / CASA / CASL / CASAL by the
#      success code — codegen's dispatch), each defining old_v with the
#      original [ptr] word;
#   3. the merge tail: old_v vs t_exp -> the Bool destination (1 =
#      swapped), and the FAILURE write-back of the current value into
#      the expected slot — conditional on inequality (the codegen
#      mirror: on success the slot already holds the expected value, so
#      the store only ever runs on the NE path) — lowered as a branch
#      on the Bool via a LirSwitch whose failure block stores old_v
#      back through [expected_ptr] and jumps to success.
def lir_atomic_lower_cas(inout ctx: LirLowerCtx, block_id: Int, width: Int, dest: Place, args: Vec[MirCallArg], success: MirBlockId) -> Result[Unit, String]
  let addr_v = match lir_atomic_arg_v(ctx, block_id, args, 0, "address")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let exp_ptr_v = match lir_atomic_arg_v(ctx, block_id, args, 1, "expected-slot address")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let des_v = match lir_atomic_arg_v(ctx, block_id, args, 2, "desired")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let dst_v = match lir_atomic_dest_v(ctx, dest)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(Option::Some(v)) then v
  when Result::Ok(Option::None) then
    return Result::Err("lir: " + ctx.fn_name + ": an atomic compare_exchange writes its Bool result (the call destination is Unit — a typed-MIR divergence; fail-closed)")
  end
  # Step 1: the expected slot's current word (zero-extended at the
  # width — the unsigned atomic widths; codegen loads the expected word
  # before the dispatch). The value is preserved in t_exp across the
  # CAS (the emitter resolves the CAS's expected register to the OLD
  # def target, never to t_exp's own vreg register, so the compare in
  # the tail always sees the ORIGINAL expected word).
  let t_exp = lir_fresh_vreg(ctx)
  lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirUnop(LirUnOp::LirNeg, t_exp, exp_ptr_v), LirPtrOp::LirPtrLoad(t_exp, exp_ptr_v, 0, width, false))
  # The old-value def of the arms (fresh — never aliases t_exp, the
  # destination or any argument word).
  let old_v = lir_fresh_vreg(ctx)
  match lir_atomic_order_const(args, 4)
  when Option::Some(ord) then
    # The static-ordering path: the CAS arm runs inline in this block,
    # then the tail compares old_v against the preserved expected word
    # and sets the Bool destination, and the block ends with the
    # conditional store-back dispatch (the Bool word: 0 = the NE
    # failure path -> b_fail; 1 = success -> the success block). The
    # failure block is created after the def (it reads old_v, defined
    # above it in the linear order).
    let form = lir_atomic_order_form(ord)
    lir_emit_cas_inline(ctx, block_id, form, width, old_v, t_exp, des_v, addr_v)
    lir_append_stmt(ctx, block_id, LirStmtKind::LirCmp(LirValue::LirReg(old_v), LirValue::LirReg(t_exp)))
    lir_append_stmt(ctx, block_id, LirStmtKind::LirCset(LirCond::LirEq, dst_v))
    let b_fail = lir_fresh_dispatch_block(ctx)
    lir_push_ptr_stmt(ctx, b_fail, LirStmtKind::LirCmp(LirValue::LirReg(exp_ptr_v), LirValue::LirReg(old_v)), LirPtrOp::LirPtrStore(exp_ptr_v, 0, old_v, width))
    lir_set_term(ctx, b_fail, LirTermKind::LirJump(success.id))
    var arms: Vec[LirSwitchArm] = Vec::new()
    arms.push(LirSwitchArm { value: 0, target: b_fail })
    lir_set_term(ctx, block_id, LirTermKind::LirSwitch(dst_v, arms, success.id))
    Result::Ok(())
  when Option::None then
    # The runtime-ordering path: the per-ordering CAS arms (plain /
    # CASA / CASL / CASAL by the success-order code) jump to the merge
    # block, which carries the shared tail (compare + Bool + the
    # conditional store-back dispatch). Creation order: arms, then the
    # merge, then the failure block — every later block's reads of
    # old_v / dst_v follow the arm defs in the linear order.
    let ord_v = match lir_atomic_arg_v(ctx, block_id, args, 4, "success ordering")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    let b_plain = lir_fresh_dispatch_block(ctx)
    let b_acq = lir_fresh_dispatch_block(ctx)
    let b_rel = lir_fresh_dispatch_block(ctx)
    let b_al = lir_fresh_dispatch_block(ctx)
    let merge = lir_fresh_dispatch_block(ctx)
    lir_emit_cas_inline(ctx, b_plain, 0, width, old_v, t_exp, des_v, addr_v)
    lir_set_term(ctx, b_plain, LirTermKind::LirJump(merge))
    lir_emit_cas_inline(ctx, b_acq, 1, width, old_v, t_exp, des_v, addr_v)
    lir_set_term(ctx, b_acq, LirTermKind::LirJump(merge))
    lir_emit_cas_inline(ctx, b_rel, 2, width, old_v, t_exp, des_v, addr_v)
    lir_set_term(ctx, b_rel, LirTermKind::LirJump(merge))
    lir_emit_cas_inline(ctx, b_al, 3, width, old_v, t_exp, des_v, addr_v)
    lir_set_term(ctx, b_al, LirTermKind::LirJump(merge))
    # The merge tail: compare old vs the preserved expected word, set
    # the Bool destination, and dispatch the conditional write-back.
    lir_append_stmt(ctx, merge, LirStmtKind::LirCmp(LirValue::LirReg(old_v), LirValue::LirReg(t_exp)))
    lir_append_stmt(ctx, merge, LirStmtKind::LirCset(LirCond::LirEq, dst_v))
    let b_fail2 = lir_fresh_dispatch_block(ctx)
    lir_push_ptr_stmt(ctx, b_fail2, LirStmtKind::LirCmp(LirValue::LirReg(exp_ptr_v), LirValue::LirReg(old_v)), LirPtrOp::LirPtrStore(exp_ptr_v, 0, old_v, width))
    lir_set_term(ctx, b_fail2, LirTermKind::LirJump(success.id))
    var arms2: Vec[LirSwitchArm] = Vec::new()
    arms2.push(LirSwitchArm { value: 0, target: b_fail2 })
    lir_set_term(ctx, merge, LirTermKind::LirSwitch(dst_v, arms2, success.id))
    # The dispatch over the success-order word in this block.
    var arms3: Vec[LirSwitchArm] = Vec::new()
    arms3.push(LirSwitchArm { value: 0, target: b_plain })
    arms3.push(LirSwitchArm { value: 2, target: b_acq })
    arms3.push(LirSwitchArm { value: 3, target: b_rel })
    lir_set_term(ctx, block_id, LirTermKind::LirSwitch(ord_v, arms3, b_al))
    Result::Ok(())
  end
end

# One CAS arm statement: the marked LirAtomCas of ordering form `form`
# defining old_v (the original [addr] word, written through the CAS's
# Xs register which the emitter resolves to old_v's def target and
# pre-loads with the expected word).
def lir_emit_cas_inline(inout ctx: LirLowerCtx, block_id: Int, form: Int, width: Int, old_v: Int, exp_v: Int, des_v: Int, addr_v: Int) -> Unit
  lir_push_ptr_stmt(ctx, block_id, LirStmtKind::LirBinop(LirBinOp::LirAdd, old_v, LirValue::LirReg(exp_v), LirValue::LirReg(des_v)), LirPtrOp::LirAtomCas(form, width, old_v, exp_v, des_v, addr_v))
end


# ———————————————————————————————————————————————————————————————
# The MirDeinit slice — whole-value destruction (drop/finalizer)
# lowering
# ———————————————————————————————————————————————————————————————
# MirDeinit is the MIR's WHOLE-VALUE destruction terminator: the drop of
# one place (function-exit cleanup chains, assignment old-value drops,
# defer chains), which the direct pipeline lowers as ONE call of the
# type's generated DROP-GLUE function with the place's address and the
# full mask -1 — the MirTerminatorKind::MirDeinit arm of
# codegen_terminator → codegen_finalizer_call (codegen.tg) — where the
# glue body (mir.tg's mir_build_drop_glue_for_type / emit_plan_deinit)
# walks the type's concrete DeinitPlan. The generated glue FUNCTIONS
# reach this route too (they are appended to MirProgram.functions and
# the whole-program entries lower every body): they are admitted by the
# generated drop-glue admission of lir_check_fn_shape (the Ptr-word
# rule — their (ptr: Ptr[T], mask: Int) signatures) and their bodies
# compile through the ordinary machinery once the head copy
# `value = *ptr` binds at machine level
# (lir_resolve_glue_head_bind) — the mask gates are Int ops, the
# enum walks MirDiscriminant reads over the value local, and the walk's
# child destruction terms are MirDeinit terminators over WHOLE
# value-local places, which the slice's own classification below
# lowers. Inside a glue body those MirDeinit places carry the
# FINALIZER instance of the destroyed value's plan — for the reachable
# glue subset (admitted aggregates of whole-word scalars) the walk is
# the finalizer call plus trivial mask gates, and the observable of
# lowering a DROP SITE (mask -1) as the direct finalizer call matches
# the glue call exactly (the inlining below is the whole-value mirror
# of calling the glue with the full mask). The
# lowering classifies every destruction term by the DESTROYED PLACE's
# concrete type
# (the type lookup: lir_place_ty over ctx.local_tys and the aggregate
# shape records — the MirTypeDef itself carries NO finalizer
# registration; the registered deinit identities live in the checker's
# deinit_targets and reach this route only through the CONCRETE DEINIT
# PLANS, ctx.deinit_plans — MirProgram.deinit_plans keyed by
# mir_type_identity_key, the exact table codegen's ctx.deinit_plans
# consumes):
#   - plan absent or Trivial: NO-OP (category 1). The direct emitter
#     emits no destruction code for such a value: the MIR's whole-value
#     drop sites consult mir_try_glue_instance and emit no MirDeinit
#     for a trivial plan ("a trivial plan is destruction-free"), and
#     the checker never schedules a drop for a type the engine answers
#     requires_drop_glue=false — the admitted scalars and the plain
#     aggregates without a registered finalizer. The value is dead and
#     the LIR frame memory needs no cleanup (a MirDeinit over such a
#     local is a front-end artifact the slice tolerates as the no-op
#     the direct emitter would have emitted for the drop);
#   - DeinitPlan::Call(finalizer), or DeinitPlan::UserFinalizer
#     (finalizer, walk) whose structural walk emits nothing (every
#     field plan Trivial — the only walk an admitted aggregate can
#     carry, its fields being slice scalars): DIRECT FINALIZER CALL
#     (category 2). The glue walk would run exactly the finalizer and
#     nothing else, so the terminator lowers as an ordinary call of the
#     finalizer function — an ordinary program function whose mangled
#     emission name resolves from ctx.finalizer_names
#     (MirProgram.method_names_by_def, keyed by def_id_numeric of the
#     finalizer's DefId — the codegen_deinit_label mirror) — with the
#     dropped word group's frame ADDRESS in the ONE argument slot for a
#     multi-word image ([FP - 8 - 8*base_slot] of the local's first
#     word — the tag word of a tagged-enum image, the first field word
#     of a plain struct — formed by the call emitter through the
#     aggregate-argument machinery, the LirAggCallArg record), or the
#     tag WORD by value for a one-word (payload-less) image — in both
#     cases exactly what the finalizer's own LIR-compiled by-value
#     parameter binds at entry (the direct MirDeinit call's extra -1
#     mask argument belongs to the generated glue's (ptr, mask)
#     signature, which no LIR-visible callee carries);
#   - every other plan shape — a structural walk with non-trivial
#     leaves (nested finalizer/owning fields), the String/collection/
#     Box/Rc destructor plans, and the recursion-by-symbol Call of a
#     drop-glue identity — fails closed with the concrete plan rule
#     (category 3): such walks belong to types this route cannot host
#     as locals (their glue bodies' value locals would carry
#     string/collection/nested shapes the local gate rejects), so the
#     rule stays fail-closed.
# The slice runs only on the aarch64 whole-program route (the only
# entries whose ctx carries ctx.deinit_plans / ctx.finalizer_names /
# the glue-name set);
# the table-less entries fail closed at every MirDeinit with the
# original drop/cleanup rule, and MirDeinit's unwind (None by MIR
# construction) fails closed like MirCall's unwind rule.
# ———————————————————————————————————————————————————————————————

# The plan-shape name for the fail-closed diagnostics (category 3 rule
# naming).
def lir_deinit_plan_name(plan: DeinitPlan) -> String
  match plan
  when DeinitPlan::Trivial then "Trivial"
  when DeinitPlan::Call(_) then "Call"
  when DeinitPlan::UserFinalizer(_, _) then "UserFinalizer"
  when DeinitPlan::Aggregate(_) then "Aggregate"
  when DeinitPlan::Enum(_) then "Enum"
  when DeinitPlan::Array(_) then "Array"
  when DeinitPlan::Set(_) then "Set"
  when DeinitPlan::Map(_, _) then "Map"
  when DeinitPlan::Tuple(_) then "Tuple"
  when DeinitPlan::Option(_) then "Option"
  when DeinitPlan::Result(_, _) then "Result"
  when DeinitPlan::Box(_) then "Box"
  when DeinitPlan::PlanLimit then "PlanLimit"
  when DeinitPlan::SelfRecursive then "SelfRecursive"
  when DeinitPlan::Deferred then "Deferred"
  when DeinitPlan::String then "String"
  end
end

# Whether a plan list walks empty (every element's walk emits nothing).
def lir_deinit_plans_walk_empty(ps: Vec[DeinitPlan]) -> Bool
  var all = true
  var i = 0
  while i < ps.len() do
    if !lir_deinit_walk_empty(ps[i]) then
      all = false
    end
    i = i + 1
  end
  all
end

# Whether a concrete deinit plan's structural WALK emits no destruction
# code: Trivial, and Aggregate/Tuple/Enum plans whose children all walk
# empty. This is the "the glue walk is exactly the user finalizer and
# nothing else" test of the MirDeinit slice.
def lir_deinit_walk_empty(plan: DeinitPlan) -> Bool
  match plan
  when DeinitPlan::Trivial then true
  when DeinitPlan::Aggregate(ps) then lir_deinit_plans_walk_empty(ps)
  when DeinitPlan::Tuple(ps) then lir_deinit_plans_walk_empty(ps)
  when DeinitPlan::Enum(vmap) then
    var all_empty = true
    for (_, vinfo) in vmap do
      if !lir_deinit_plans_walk_empty(vinfo.1) then
        all_empty = false
      end
    end
    all_empty
  when _ then false
  end
end

# Lower one MirDeinit terminator's destruction and set the block's
# terminator (the phi-edge copies and the unwind/route gates already ran
# in the terminator arm). The three classes of the MirDeinit slice
# above: no-op (LirJump to the MirDeinit target — the direct arm's
# nothing-then-branch), the direct finalizer call (a LirCall whose
# success block IS the MirDeinit target — the direct arm's
# call-then-branch), or the fail-closed plan rule.
def lir_lower_deinit(inout ctx: LirLowerCtx, block: MirBlock, place: Place, target: MirBlockId) -> Result[Unit, String]
  let block_id = block.id.id
  # The destroyed place's concrete type — the whole-value destruction
  # the MirDeinit slice classifies by.
  let pty = match lir_place_ty(ctx, place)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(t) then t
  end
  let plan_o = ctx.deinit_plans.get(mir_type_identity_key(pty))
  match plan_o
  when Option::Some(plan) then
    match plan
    when DeinitPlan::Trivial then
      # Category 1: the value's destruction is the no-op of the direct
      # pipeline (a trivial plan is destruction-free).
      lir_set_term(ctx, block_id, LirTermKind::LirJump(target.id))
      Result::Ok(())
    when DeinitPlan::Call(inst) then
      lir_lower_deinit_finalizer_call(ctx, block_id, place, inst, target)
    when DeinitPlan::UserFinalizer(inst, walk) then
      if lir_deinit_walk_empty(walk) then
        # Category 2: the user finalizer runs first and the structural
        # walk emits nothing — the glue's whole observable is the
        # finalizer call.
        lir_lower_deinit_finalizer_call(ctx, block_id, place, inst, target)
      else
        Result::Err("lir: " + ctx.fn_name + ": MirDeinit over a value whose destruction runs a user finalizer followed by a non-empty structural field walk (plan shape UserFinalizer); the MirDeinit slice lowers finalizer-only drops directly, and a non-empty structural walk belongs to a type this route cannot host as a local (its generated glue body's value image would carry shapes the aggregate gate rejects) — fail-closed")
      end
    when _ then
      # Category 3: every other plan shape (named by the rule).
      let pname = match plan_o
      when Option::Some(pp) then lir_deinit_plan_name(pp)
      when Option::None then "?"
      end
      Result::Err("lir: " + ctx.fn_name + ": MirDeinit over a value whose concrete deinit plan is not lowerable on this route (plan shape " + pname + "); the MirDeinit slice implements the plan-less/trivial drops (no-op) and the registered-finalizer drops (direct finalizer call) of the admitted scalar/plain-struct/tagged-enum subset — generated drop-glue destruction (structural cleanup over owning fields, the String/collection/Box/Rc destructors, recursion-by-symbol) is not implemented (fail-closed)")
    end
  when Option::None then
    if !ctx.deinit_plans.is_empty() || !ctx.finalizer_names.is_empty() then
      # The program route carries deinit knowledge but no plan for this
      # type: nothing was registered for it (a type no drop site ever
      # planned — the engine answers requires_drop_glue=false), so the
      # direct emitter emits nothing at the drop — category 1's no-op.
      lir_set_term(ctx, block_id, LirTermKind::LirJump(target.id))
      Result::Ok(())
    else
      # A route without the program's deinit tables: keep the original
      # fail-closed rule (the thumb/rv routes and the table-less
      # aarch64 entries have no destruction knowledge).
      Result::Err("lir: " + ctx.fn_name + ": MirDeinit does not lower on this route (drop/cleanup knowledge is not carried here; the MirDeinit slice runs on the aarch64 whole-program route, whose program deinit tables classify every destruction term — plain scalar/struct/enum-of-scalar-word programs carry no destruction terms)")
    end
  end
end

# Lower category 2 of the MirDeinit slice: the DIRECT FINALIZER CALL of
# a registered user finalizer over the destroyed place. The finalizer's
# emission name resolves from the identity tables (method_names_by_def
# — the codegen_deinit_label authority); the call crosses the dropped
# word group exactly like the finalizer's own by-value parameter binds
# it at entry (the aggregate-argument machinery for an ADDRESS-class
# image:
# the image's frame address in the ONE general slot, formed by the call
# emitter from the LirAggCallArg record; the fixed vreg-0 move for a
# one-word image — a payload-less tagged-enum's tag word or a
# Scalar-class plain-struct's single word — crossing BY VALUE).
def lir_lower_deinit_finalizer_call(inout ctx: LirLowerCtx, block_id: Int, place: Place, inst: InstanceId, target: MirBlockId) -> Result[Unit, String]
  let inst_key = def_id_numeric(&inst.def.def)
  let callee = match ctx.finalizer_names.get(inst_key)
  when Option::Some(n) then n.clone()
  when Option::None then
    return Result::Err("lir: " + ctx.fn_name + ": MirDeinit destruction identity (def_id_numeric " + inst_key.to_string() + ") is not a registered finalizer function (the MirDeinit slice calls registered finalizer identities only — the plan's finalizer, resolved through MirProgram.method_names_by_def; a drop-glue identity in a MirDeinit payload is classified by the destroyed place's plan instead, never called directly — fail-closed)")
  end
  # The destroyed place must be a WHOLE aggregate local: the finalizer
  # types of this slice are admitted plain-struct / tagged-enum Adts
  # whose word-group images live in the local's fixed frame slots (every
  # other place over an admitted aggregate is a scalar word — a slice
  # scalar never carries a plan, and the plan-less no-op handled it
  # above).
  match lir_classify_place(ctx, place)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(shape) then
    match shape
    when LirPlaceShape::LirPlaceAggLocal(lid) then
      let agg = match ctx.agg_of.get(lid)
      when Option::Some(a) then a
      when Option::None then
        return Result::Err("lir: " + ctx.fn_name + ": MirDeinit over a whole aggregate local with no lowering record in this function (the function shape gate and the lowering disagree — fail-closed)")
      end
      match agg.enum_shape
      when Option::Some(eshape) then
        if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) then
          # The one-word (payload-less) tagged-enum image: the whole
          # value IS the tag word, and the finalizer's by-value
          # parameter binds it from the ONE slot like a scalar word —
          # the tag crosses BY VALUE (a by-reference address would feed
          # the callee a value word; this route compiles its own
          # callee, whose binding is the by-value tag).
          let tag_v = lir_agg_word_vreg(ctx, lid, 0)
          lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(0, LirValue::LirReg(tag_v)))
          var one_args: Vec[Int] = Vec::new()
          one_args.push(tag_v)
          lir_set_term(ctx, block_id, LirTermKind::LirCall(callee.clone(), one_args, 0, Option::None, target.id))
          Result::Ok(())
        else
          # The payloaded tagged-enum image crosses by reference like an
          # address-class plain struct: the ONE slot carries the source
          # image group's frame address (the aggregate-argument slice
          # record — the emitter forms [FP - 8 - 8*base_slot] in x0 at
          # the call site), and the finalizer's entry binding copies the
          # words from it.
          var recs: Vec[LirAggCallArg] = Vec::new()
          recs.push(LirAggCallArg { slot: 0, base_slot: agg.base_slot })
          ctx.agg_call_args.insert(block_id, recs)
          var agg_args: Vec[Int] = Vec::new()
          agg_args.push(lir_agg_word_vreg(ctx, lid, 0))
          lir_set_term(ctx, block_id, LirTermKind::LirCall(callee.clone(), agg_args, 0, Option::None, target.id))
          Result::Ok(())
        end
      when Option::None then
        if lir_agg_is_scalar_class(agg.shape) then
          # The one-word (Scalar-class) plain-struct image: the whole
          # value IS the image's single word, and the finalizer's
          # by-value parameter binds it from the ONE slot like a scalar
          # word — the word crosses BY VALUE (the register-class
          # plain-struct argument slice, mirroring the payload-less
          # enum arm above). A one-word image whose word is a FLOAT
          # field (word-0's fp record — the float-field slice) crosses
          # like a scalar float of the word's width instead: the value
          # moves into the finalizer's fixed float ABI register (FP
          # position 0 — the single argument), the caller-side mirror
          # of the finalizer's own fp-class entry binding.
          let wv = lir_agg_word_vreg(ctx, lid, 0)
          match lir_ctx_fp_width_of(ctx, wv)
          when Option::Some(_) then
            lir_append_stmt(ctx, block_id, LirStmtKind::LirFMove(lir_fixed_fp_base(), wv))
          when Option::None then
            lir_append_stmt(ctx, block_id, LirStmtKind::LirMove(0, LirValue::LirReg(wv)))
          end
          var one_args: Vec[Int] = Vec::new()
          one_args.push(wv)
          lir_set_term(ctx, block_id, LirTermKind::LirCall(callee.clone(), one_args, 0, Option::None, target.id))
          Result::Ok(())
        elsif lir_agg_sret_words(agg.shape) > 0 then
          # The address-class plain-struct image: the same by-reference
          # crossing as the payloaded enum above.
          var recs2: Vec[LirAggCallArg] = Vec::new()
          recs2.push(LirAggCallArg { slot: 0, base_slot: agg.base_slot })
          ctx.agg_call_args.insert(block_id, recs2)
          var agg_args2: Vec[Int] = Vec::new()
          agg_args2.push(lir_agg_word_vreg(ctx, lid, 0))
          lir_set_term(ctx, block_id, LirTermKind::LirCall(callee.clone(), agg_args2, 0, Option::None, target.id))
          Result::Ok(())
        else
          Result::Err("lir: " + ctx.fn_name + ": MirDeinit over a plain-struct image whose admitted shape classifies as neither the Scalar class (<= 8 bytes — its one word crossing by value) nor an sret class (exactly 16 bytes or more than 8 bytes — crossing by reference); no admitted whole-word shape lands between the two, so this is a shape-gate divergence (fail-closed)")
        end
      end
    when _ then
      Result::Err("lir: " + ctx.fn_name + ": MirDeinit's finalizer destruction over a projected or scalar place does not lower (the finalizer types of this slice are whole admitted aggregate locals; a finalizer-typed place can never be a slice scalar — fail-closed)")
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Lowering — whole function (Slice 2 entry point)
# ———————————————————————————————————————————————————————————————

def lower_mir_fn_to_lir(f: MirFunction, static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, false, false, false, false, false, false, false, Map::new(), Map::new(), Map::new(), Set::new(), static_labels)
end

# The aarch64-route entry: same lowering with div_ok == true, so
# Div/Mod lower as the marked sdiv/udiv statements only the aarch64
# emitter interprets. The riscv routes call lower_mir_fn_to_lir_rv32 /
# lower_mir_fn_to_lir_rv64 and the cortex-m route calls
# lower_mir_fn_to_lir_cm (all keep the fail-closed Div/Mod rejection —
# their emitters cannot express a division). This entry
# carries no MirTypeDef table, so aggregate locals AND aggregate
# parameters fail closed here too (the program-level aarch64 route,
# lower_mir_fn_to_lir_prog, opens them). `static_labels` is the
# whole-program static label table (see the statics section above);
# entries without a program pass the empty map and any MirStaticRef
# then fails closed at lowering.
def lower_mir_fn_to_lir_a64(f: MirFunction, static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, true, true, false, false, false, false, false, Map::new(), Map::new(), Map::new(), Set::new(), static_labels)
end

# The cortex-m route entry (backend_thumb.tg): the word-only accept set
# with NO division and the AAPCS32 parameter-fetch mode —
# param_stack_mode == true. General-class parameters 0..3 bind from the
# fixed r0..r3 vregs; every general-class parameter beyond is fetched
# at function entry from its caller-stack word at the canonical
# [FP + 8 + 4*stk] offset of the shared caller-stack stream
# (LirLoadFrame into the ordinary parameter vreg); call sites move
# general arguments 0..3 into the fixed r0..r3 vregs and push every
# general argument beyond as a 4-byte AAPCS caller word (LirPushArg,
# even word count — the lir_lower_call padding rule). This entry ALSO
# opens the float bodies of the cortex-m float slice (fp_ok == true —
# the gate flag admits the LOCAL forms since the float-body slice and,
# since the float-ABI slice of this route, the float PARAMETER and
# RETURN forms too): float locals lower (their register-resident
# statements emit through the thumb backend's float arms), float
# parameters bind at entry by their float-class position — position
# p < 8 from the fixed float vreg 8+p (d0..d7) by a LirFMove, position
# p >= 8 from the caller stack at the width-aware AAPCS32 float
# offsets of the shared stream (a LirLoadFrame whose dst is the
# parameter's FP-class vreg) — and scalar-class float returns cross
# through the fixed float vreg 8 (d0/s0) exactly like the aarch64
# route's (see the entry-binding walk in lower_mir_fn_to_lir_mode_ty
# for the arithmetic). The call-argument and emitter halves of the
# cortex-m float ABI (float call args, float call destinations and the
# thumb emitter's float arms at the crossings) are the next slice.
# The statement shapes are the
# SAME LirLoadFrame / LirPushArg / LirCall statements the aarch64 rule
# uses; only the geometry differs, so the allocator, the peephole and
# every def/use walk are mode-agnostic. This entry ALSO opens the
# cortex-m atomic surface (cm_atomics == true): the pointer/atomic
# slice of the aarch64 routes — Ptr/PtrMut/RefInternal words and the
# sized atomic data words in the function surface (see the shape-gate
# arms and the ctx flag doc) — with the __intrinsic_atomic_* calls
# lowered INLINE at the desc's cortex-m atomic widths 1/2/4 into the
# marked LirPtrOp statements the thumb emitter translates into its
# ARMv7-M LDREX/STREX/DMB sequences (backend_thumb.tg's atomic
# section); a _u64 atomic width fails closed in
# lir_lower_atomic_call with the cortex-m reason (ARMv7-M has no
# 8-byte exclusive/doubleword atomic form). `static_labels` is the
# whole-program static label table (DefId-render -> emission name) the
# whole-program routes build from the program (build_static_label_table
# — see the statics section above); entries without a program pass the
# empty map and any MirStaticRef then fails closed at lowering.
def lower_mir_fn_to_lir_cm(f: MirFunction, static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, false, false, true, true, true, false, false, Map::new(), Map::new(), Map::new(), Set::new(), static_labels)
end

# The riscv route entries (backend_rv.tg — TANGERINE_LIR_TARGET=riscv32
# / riscv64): the word-only accept set with NO division (div_ok false)
# and the aarch64 register-fetch geometry (param_stack_mode false —
# fixed argument vregs 0..7 ARE a0..a7 on the riscv route; ≤ 8
# parameters, never the AAPCS caller stack), with the riscv ATOMIC
# surface open (rv_atomics == true): the pointer/atomic slice of the
# aarch64 routes — Ptr/PtrMut/RefInternal words and the sized atomic
# data words in the function surface (see the shape-gate arms and the
# ctx flag doc) — with the __intrinsic_atomic_* calls lowered INLINE
# into the marked LirPtrOp statements the riscv backend translates
# into its RISC-V A-extension LR/SC + FENCE sequences
# (backend_rv.tg's pointer/atomic emission section). `rv_word64`
# selects the machine word: true on the riscv64 entry (lower_mir_fn_to_lir_rv64
# — the 8-byte LP64 word, deref geometry at 8 bytes and the _u64
# atomic width admitted: LR.D/SC.D exist on RV64) and false on the
# riscv32 entry (lower_mir_fn_to_lir_rv32 — the 4-byte ILP32 word,
# the cortex-m deref geometry and the _u64 width failing closed in
# lir_lower_atomic_call with the riscv32 reason; RV32 has no 8-byte
# exclusive form). `static_labels` is the
# whole-program static label table (DefId-render -> emission name) the
# whole-program routes build from the program (build_static_label_table
# — see the statics section above); entries without a program pass the
# empty map and any MirStaticRef then fails closed at lowering.
def lower_mir_fn_to_lir_rv32(f: MirFunction, static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, false, false, false, false, false, true, false, Map::new(), Map::new(), Map::new(), Set::new(), static_labels)
end

def lower_mir_fn_to_lir_rv64(f: MirFunction, static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, false, false, false, false, false, true, true, Map::new(), Map::new(), Map::new(), Set::new(), static_labels)
end

# The program-level aarch64 route (used by lir_compile_object /
# lir_link_object): same as lower_mir_fn_to_lir_a64 with the program's
# MirTypeDef table, so plain-struct AND tagged-enum aggregate locals
# AND the aggregate
# returns of BOTH ABI classes lower (the aggregate-return slice — the
# only entry that opens the return-type gate, for the sret
# ScalarPair/ByAddress images AND the Scalar-class (<= 8-byte) images —
# one-word structs and the payload-less enums —
# whose one-word returns ride the ordinary Ret x0 load; the PAYLOADED
# tagged-enum returns ride the sret x8 machinery under the LIR-internal
# enum ABI) AND
# aggregate-return call sites lower (the caller-side slice: sret
# destinations — sret-class plain-struct AND payloaded tagged-enum
# destinations alike — are recorded on LirFunction.sret_call_slots,
# while
# Scalar-class destinations ride the ordinary post-call word capture)
# AND
# by-value aggregate PARAMETERS lower (the aggregate-param slice — the
# only entry that opens the parameter gate for address-class plain-
# struct images AND payloaded tagged-enum images (the LIR-internal
# enum ABI), binding each one's words at function entry, plus the
# payload-less tagged-enum parameters, which bind their raw-
# discriminant tag word from the slot like a scalar) AND their
# caller side, the by-value aggregate ARGUMENTS of admitted address-
# class images (and the payloaded tagged-enum arguments, crossing by
# reference, plus the payload-less enum arguments, crossing by
# value), lowers here too (the aggregate-argument slice — the
# only route whose call-argument classification resolves aggregate
# places through ctx.agg_of, recording them on LirFunction.
# agg_call_args); the
# routes without the table reject every aggregate return/parameter with
# the shape gate's rule-naming reason. It is ALSO the only entry that
# carries the program's deinit tables (deinit_plans — the concrete
# MirProgram.deinit_plans — and finalizer_names —
# MirProgram.method_names_by_def): the MirDeinit slice (see
# lir_lower_deinit) classifies destruction terms by them; every other
# entry keeps both maps empty and retains the fail-closed MirDeinit
# rule. It is ALSO the only entry that
# carries the program's deinit tables (deinit_plans — the concrete
# MirProgram.deinit_plans — and finalizer_names —
# MirProgram.method_names_by_def): the MirDeinit slice (see
# lir_lower_deinit) classifies destruction terms by them; every other
# entry keeps both maps empty and retains the fail-closed MirDeinit
# rule. `glue_names` is the name set of the program's generated
# drop-glue functions (MirProgram.drop_glue_fns values — see the
# generated drop-glue admission note in lir_check_fn_shape): the
# route builds it once per program, and the gate admits those
# functions' Ptr-typed `ptr` parameters as opaque address words while
# the resolver (lir_resolve_glue_head_bind) turns their head copy into
# the machine-level entry bind. Every other entry passes the empty set
# and keeps the Ptr rejections. `static_labels` is the whole-program
# static label table (DefId-render -> emission name) built from the
# program at the route entries (build_static_label_table — see the
# statics section above); MirStaticRef lowering resolves through it.
def lower_mir_fn_to_lir_prog(f: MirFunction, type_defs: Map[Int, MirTypeDef], deinit_plans: Map[String, DeinitPlan], finalizer_names: Map[Int, String], glue_names: Set[String], static_labels: Map[String, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, true, true, false, false, false, false, false, type_defs, deinit_plans, finalizer_names, glue_names, static_labels)
end

# The aarch64 route also opens the full width model (sized integer
# locals/params/returns/casts — width_ok); the thumb/rv routes keep the
# word-only accept set of the original slice. `fp_ok` opens the float
# admission on a word-only route (true only through
# lower_mir_fn_to_lir_cm — the cortex-m float slice): float LOCALS
# lower since the float-body slice, and float PARAMETERS and RETURNS
# since the float-ABI slice of the cortex-m route — the float ABI
# walks of lower_mir_fn_to_lir_mode_ty bind their crossings under the
# AAPCS32 mode (see lir_check_fn_shape). `param_stack_mode` selects
# the parameter-fetch ABI (see lir_arg_reg_count): false = the aarch64
# rule (the default — every route that does not name the cortex-m mode),
# true = the AAPCS32 rule fed by lower_mir_fn_to_lir_cm. `cm_atomics`
# opens the CORTEX-M atomic surface on the otherwise word-only shape
# gate (true only from lower_mir_fn_to_lir_cm — the cortex-m atomic
# slice: pointer/ref words and the sized atomic data words I8..U32 in
# the surface, the __intrinsic_atomic_* calls lowered INLINE at the
# widths 1/2/4; see lir_check_fn_shape and the LirLowerCtx flag doc).
# `rv_atomics` opens the RISCV atomic surface on the otherwise
# word-only shape gate (true only from the riscv entries
# lower_mir_fn_to_lir_rv32 / lower_mir_fn_to_lir_rv64 — the riscv
# atomic slice: the same pointer/ref + sized atomic data word
# admissions as the cortex-m surface, with the __intrinsic_atomic_*
# calls lowered INLINE at the route's machine-word widths), and
# `rv_word64` selects the riscv route's machine word (true = the
# riscv64 8-byte word — the _u64 atomic width admitted, deref
# geometry at 8 bytes; false = the riscv32 4-byte word — the _u64
# width fails closed; see the LirLowerCtx flag doc).
# `type_defs`
# feeds the plain-struct/tagged-enum aggregate gate (empty on the
# routes that reject aggregates). `deinit_plans`/`finalizer_names` feed
# the MirDeinit slice (empty on every entry but the program-level one,
# which the whole-program routes call with the MirProgram tables — see
# the MirDeinit slice section).
def lower_mir_fn_to_lir_mode(f: MirFunction, div_ok: Bool, width_ok: Bool) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_mode_ty(f, div_ok, width_ok, false, false, false, false, false, Map::new(), Map::new(), Map::new(), Set::new(), Map::new())
end

# The shared lowering body (the route entries above and the program
# routes below differ only in the flags and tables they feed it).
# `cm_atomics` opens the CORTEX-M atomic-surface admissions of the
# otherwise word-only shape gate (true only from the cortex-m entry
# lower_mir_fn_to_lir_cm — see the flag doc on LirLowerCtx and the
# pointer/atomic-slice admissions in lir_check_fn_shape): the
# route's 32-bit-word model admits the pointer/ref words and the
# sized atomic data words (I8..U32) of the slice and lowers the
# __intrinsic_atomic_* calls INLINE at the widths 1/2/4 (the desc's
# cortex-m atomic widths; a _u64 width fails closed in
# lir_lower_atomic_call — ARMv7-M has no 8-byte atomic form). All
# route geometry (AAPCS32 parameter fetch, 4-byte words, the float
# admission) is unchanged. `rv_atomics` opens the SAME atomic-surface
# admissions on the RISCV route (true only from the riscv entries
# lower_mir_fn_to_lir_rv32 / lower_mir_fn_to_lir_rv64 — see the flag
# doc on LirLowerCtx): the __intrinsic_atomic_* calls lower INLINE at
# the route's widths (1/2/4 on riscv32 — the 4-byte machine word,
# exactly the cortex-m cap; 1/2/4/8 on riscv64 via rv_word64), the
# deref geometry follows the route's machine word (rv_word64 in
# lir_deref_word_io), the frame-slot LEA payloads are the route's
# machine byte offsets (lir_lower_ref_of_place) and the riscv route
# geometry is otherwise the aarch64 rule (a0..a7 argument registers —
# param_stack_mode false; no floats, no division, no aggregates).
def lower_mir_fn_to_lir_mode_ty(f: MirFunction, div_ok: Bool, width_ok: Bool, fp_ok: Bool, param_stack_mode: Bool, cm_atomics: Bool, rv_atomics: Bool, rv_word64: Bool, type_defs: Map[Int, MirTypeDef], deinit_plans: Map[String, DeinitPlan], finalizer_names: Map[Int, String], glue_names: Set[String], static_labels: Map[String, String]) -> Result[LirFunction, String]
  match lir_check_fn_shape(f, width_ok, fp_ok, cm_atomics, rv_atomics, type_defs, glue_names)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var ctx = lir_lower_ctx_new(f, div_ok, param_stack_mode, cm_atomics, rv_atomics, rv_word64, type_defs, deinit_plans, finalizer_names, static_labels)
  # (generated drop-glue admission): resolve the glue body contract —
  # the Ptr-typed `ptr` parameter and the head copy's `value` local —
  # before any statement/terminator lowering, so the entry walks and
  # the statement phase can bind and skip the copy.
  match lir_resolve_glue_head_bind(&mut ctx, f, glue_names)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end

  # Entry parameter binding, per the parameter-fetch mode AND the
  # per-class ABI walk (the exact mirror of the caller-side walk in
  # lir_lower_call): each parameter is classified by its class —
  # GENERAL (integer/Bool words and the ADDRESS words of by-value
  # aggregate parameters) or FLOAT (Float/F32/F64) — and bound from
  # the class's next register or from the shared caller-stack stream:
  #   aarch64 mode: a general parameter at GP position p arrives in
  #     x_p (p < 8) or on the caller's stack (p >= 8); a float
  #     parameter at FP position p arrives in d_p (p < 8 — the
  #     SIMD&FP ABI registers d0..d7; a float parameter at p >= 8
  #     fails closed, mirroring the caller-side float-stack-argument
  #     rejection, because the aarch64 route's 16-byte caller slots
  #     have no float-stack rule) — the AAPCS64 independent register
  #     files with positional numbering per class, exactly the
  #     convention the caller side lowers;
  #   cortex-m mode (AAPCS32): GENERAL parameters at GP positions
  #     0..3 arrive in r0..r3 (the fixed vregs 0..3); a general
  #     parameter at GP position >= 4 arrives on the caller's stack —
  #     each word at the canonical [FP + 8 + 4*stk] offset of the
  #     walk's shared stream (r0..r3 are the only general ABI
  #     registers, so the load is a LirLoadFrame into the parameter's
  #     ORDINARY vreg — fixed vregs 4..7 never appear in this mode).
  #     FLOAT parameters bind by the same LIR-internal float ABI the
  #     aarch64 mode uses, one FP-class position per float parameter
  #     (the width never splits a position): a float at FP position
  #     p < 8 arrives in the fixed float vreg 8+p (d_p — d0..d7) and
  #     binds by a LirFMove; a float at FP position p >= 8 overflows
  #     to the SAME shared caller-stack stream, at the width-aware
  #     AAPCS32 float offsets below (a LirLoadFrame whose dst is the
  #     parameter's ordinary FP-class vreg; the load reads the value's
  #     width — 4 bytes for F32, 8 for F64 — at the offset).
  #   THE MIXED-OVERFLOW STREAM ARITHMETIC (cortex-m mode): AAPCS32
  #   consumes the general file r0..r3 and the VFP file s0..s15
  #   (modeled as the eight d0..d7 positions above) independently in
  #   parameter order; a parameter of either class whose file is
  #   exhausted crosses on the caller's stack, and the stacked
  #   parameters of BOTH classes share ONE stream in PARAMETER ORDER
  #   (the aarch64 mode's shared positional stream mirrored onto the
  #   4-byte AAPCS words): `stk_pos` is the running 4-byte word index
  #   of that stream — a general parameter or an F32 float advances it
  #   by one word, an F64 float occupies an 8-byte unit and advances
  #   it by two words, with a skipped pad word inserted when the unit
  #   would start at an odd index (the AAPCS32 double-word rule: an
  #   8-byte stack argument is 8-byte aligned, and [FP + 8 + 4*k] is
  #   8-byte aligned exactly when k is even; the pad word's contents
  #   are architecturally unconstrained). The load offset of any
  #   stacked parameter is therefore [FP + 8 + 4*stk_pos] with the
  #   width-aware advancement — the general-only signatures of the
  #   earlier slice keep their exact [FP + 8 + 4*(i-4)] geometry (an
  #   all-word stream advances one word per stacked parameter), and
  #   the caller-side push stream (lir_lower_call, the next slice)
  #   lays the same stream down in descending word-index order. The
  #   aarch64 mode's stream is the same model with one uniform 16-byte
  #   slot per stacked parameter ([FP + 16 + 16*stk]).
  # LirLoadFrame statements therefore only ever occur at the top of the
  # entry block, before any other statement. Scalar parameters bind
  # here; one-word by-value parameters bind HERE too — a Scalar-class
  # (<= 8 bytes) plain-struct parameter and a PAYLOAD-LESS tagged-enum
  # parameter alike: their whole value is the one word crossing in the
  # parameter's ONE slot, and the entry statement defs the parameter
  # aggregate's fixed word-0 vreg (the register-class binds; for an
  # enum that word is the raw-discriminant tag) — while ADDRESS-class
  # plain-struct AGGREGATE parameters AND PAYLOADED
  # tagged-enum parameters have no scalar
  # vreg (ctx.vreg_of carries none for them) and are skipped — the
  # machine-level per-word entry copy of the aggregate-param slice
  # binds them instead, from the LirAggParamBind records assembled onto
  # the LirFunction (their ABI slot fields are the GP positions this
  # walk computes — see below).
  var binds: Vec[LirStmt] = Vec::new()
  let abi_regs = lir_arg_reg_count(ctx.param_stack_mode)
  var gp_pos = 0
  var fp_pos = 0
  var stk_pos = 0
  var bi = 0
  while bi < f.params.len() do
    let pty = f.params[bi].ty
    match lir_fp_width_of(pty)
    when Option::Some(fw) then
      # A FLOAT parameter. ctx.vreg_of carries its vreg (the gate and
      # ctx-new assigned one). A float at FP position p < 8 binds from
      # the fixed float ABI vreg 8+p (d_p) on BOTH float-capable
      # routes — the per-class positional mirror of the caller-side
      # walk. A float at FP position p >= 8 is a float STACK
      # parameter, fetched from the shared caller-stack stream at its
      # width (a LirLoadFrame whose FP-class dst makes the emitter
      # load the value's width — 4 bytes for F32, 8 for F64 — at the
      # slot base):
      #   cortex-m mode (AAPCS32): the mixed-overflow arithmetic
      #     below — the load offset is [FP + 8 + 4*stk_pos], with an
      #     F64 unit padded to an even word index (an 8-byte AAPCS32
      #     stack argument is 8-byte aligned) and advancing the stream
      #     by two words;
      #   aarch64 mode: the SAME shared positional stream the general
      #     overflow parameters use — one uniform 16-byte caller slot
      #     per stacked parameter of either class at [FP + 16 +
      #     16*stk_pos], advancing the stream by one slot (the
      #     caller-side walk of lir_lower_call mirrors this exactly:
      #     a float argument beyond d0..d7 pushes its value at its
      #     width into the slot's base, and the load reads the same
      #     width from the same base).
      match ctx.vreg_of.get(f.params[bi].id.id)
      when Option::Some(pv) then
        if fp_pos < 8 then
          binds.push(LirStmt { kind: LirStmtKind::LirFMove(pv, lir_fixed_fp_base() + fp_pos), div: Option::None, ptr: Option::None })
        else
          if ctx.param_stack_mode then
            if lir_fp_bytes(fw) == 8 then
              if stk_pos % 2 != 0 then
                stk_pos = stk_pos + 1
              end
              binds.push(LirStmt { kind: LirStmtKind::LirLoadFrame(pv, 8 + 4 * stk_pos), div: Option::None, ptr: Option::None })
              stk_pos = stk_pos + 2
            else
              binds.push(LirStmt { kind: LirStmtKind::LirLoadFrame(pv, 8 + 4 * stk_pos), div: Option::None, ptr: Option::None })
              stk_pos = stk_pos + 1
            end
          else
            binds.push(LirStmt { kind: LirStmtKind::LirLoadFrame(pv, 16 + 16 * stk_pos), div: Option::None, ptr: Option::None })
            stk_pos = stk_pos + 1
          end
        end
        fp_pos = fp_pos + 1
      when Option::None then
        return Result::Err("lir: function " + f.name + ": float parameter " + f.params[bi].name + " has no vreg (the shape gate and the lowering disagree — fail-closed)")
      end
    when Option::None then
      if lir_is_reg_word(pty) then
        # A GENERAL scalar parameter (an integer/Bool/float word OR a
        # pointer/ref ADDRESS word — the pointer/atomic slice's word
        # admission binds Ptr/PtrMut/RefInternal parameters exactly like
        # any scalar word).
        match ctx.vreg_of.get(f.params[bi].id.id)
        when Option::Some(pv) then
          if gp_pos < abi_regs then
            binds.push(LirStmt { kind: LirStmtKind::LirMove(pv, LirValue::LirReg(gp_pos)), div: Option::None, ptr: Option::None })
            gp_pos = gp_pos + 1
          else
            # A stack-class general scalar parameter: its slot is the
            # shared caller-stack stream's NEXT position (one 16-byte
            # slot on the aarch64 mode, one 4-byte AAPCS word on the
            # cortex-m mode — the walk's stream, shared with the
            # stacked float parameters below), so the load runs at the
            # current stream position and the stream advances by one.
            binds.push(LirStmt {
              kind: LirStmtKind::LirLoadFrame(pv, if ctx.param_stack_mode then 8 + 4 * stk_pos else 16 + 16 * stk_pos end),
              div: Option::None,
              ptr: Option::None
            })
            stk_pos = stk_pos + 1
          end
        when Option::None then
          return Result::Err("lir: function " + f.name + ": scalar parameter " + f.params[bi].name + " has no vreg (the shape gate and the lowering disagree — fail-closed)")
        end
      else
        if ctx.glue_head_ptr == Option::Some(f.params[bi].id.id) then
          # (generated drop-glue admission — the glue head `ptr`
          # parameter, unreachable here since the pointer/atomic slice
          # admits the Ptr word in the scalar branch above — kept as
          # the defensive fallback): no entry STATEMENT binds it: its
          # ONE general-class slot carries the pointed-to image's
          # address, and the machine-level entry copy (the
          # LirAggParamBind record assembled into LirFunction.agg_params
          # below — the glue entry bind) loads the `value` local's words
          # from [slot + 8k] at function entry, exactly like an
          # address-class aggregate parameter's bind. The walk only
          # advances the per-class counters.
          if gp_pos < abi_regs then
            gp_pos = gp_pos + 1
          else
            stk_pos = stk_pos + 1
          end
        else
          # An aggregate parameter — ctx.vreg_of carries no scalar vreg
          # for it. The kind decides the binding:
          #   - an ADDRESS-class by-value PLAIN-STRUCT parameter (the
          #     aggregate-param slice): it consumes ONE general-class slot
          #     carrying the image address; the machine-level entry copy
          #     binds it (recorded on LirFunction.agg_params);
          #   - a Scalar-class (<= 8 bytes) by-value PLAIN-STRUCT
          #     parameter (the register-class slice): its ONE word — a
          #     single whole-word field — crosses BY VALUE in its ONE
          #     general-class slot exactly like a scalar word and binds
          #     HERE as an entry statement into the parameter aggregate's
          #     fixed word-0 vreg, the exact mirror of the payload-less
          #     tagged-enum parameter below;
          #   - a PAYLOAD-LESS TAGGED-ENUM parameter: its whole value is
          #     the raw-discriminant tag word, which crosses in its ONE
          #     general-class slot exactly like a scalar word — bound
          #     HERE as an entry statement into the enum local's fixed
          #     tag-word vreg (a def of a fixed memory-home vreg stores
          #     the slot; register-class slots bind from x_gp, stack-class
          #     slots load the caller word at the walk's shared offset);
          #   - a PAYLOADED TAGGED-ENUM parameter (the LIR-internal enum
          #     ABI — see the aggregate-param slice section): like the
          #     address-class plain-struct parameter, it consumes ONE
          #     general-class slot carrying the CALLER's inline image
          #     ADDRESS and binds through the machine-level per-word
          #     entry copy of the aggregate-param slice (the
          #     LirAggParamBind records assembled below), so it is
          #     skipped here too — the walk only advances the per-class
          #     counters.
          match ctx.agg_of.get(f.params[bi].id.id)
          when Option::Some(agg) then
            match agg.enum_shape
            when Option::Some(eshape) then
              if lir_agg_is_scalar_class(lir_enum_image_shape(eshape)) then
                let tag_v = agg.word_vregs[0]
                if gp_pos < abi_regs then
                  binds.push(LirStmt { kind: LirStmtKind::LirMove(tag_v, LirValue::LirReg(gp_pos)), div: Option::None, ptr: Option::None })
                else
                  binds.push(LirStmt {
                    kind: LirStmtKind::LirLoadFrame(tag_v, if ctx.param_stack_mode then 8 + 4 * stk_pos else 16 + 16 * stk_pos end),
                    div: Option::None,
                    ptr: Option::None
                  })
                end
              else
                # The payloaded tagged-enum parameter: binds at machine
                # level through its LirAggParamBind record (see above) —
                # no entry statement exists for its words.
                ()
              end
              if gp_pos < abi_regs then
                gp_pos = gp_pos + 1
              else
                stk_pos = stk_pos + 1
              end
            when Option::None then
              # A by-value plain-struct parameter. An ADDRESS-class
              # image binds at machine level through its LirAggParamBind
              # record (assembled below) — no entry statement — while a
              # Scalar-class (<= 8 bytes) one-word image crosses BY
              # VALUE and binds HERE like a scalar word, mirroring the
              # payload-less enum binding
              # above (the def of the parameter's fixed word-0 vreg
              # stores the slot; register-class slots bind from x_gp,
              # stack-class slots load the caller word at the walk's
              # shared offset). A one-word image whose word is a
              # FLOAT field (word-0's fp record — the float-field
              # slice) crosses on the FLOAT-class stream instead:
              # its single word IS the field value, so it binds like a
              # scalar float of the word's width — the register-class
              # bind defs the fixed word-0 vreg from the float ABI
              # register at FP position fp_pos, and an FP position
              # beyond d0..d7 (a float stack parameter) binds the
              # aarch64 shared-stream slot at the fp width (the caller
              # pushed the value at that width; the same geometry as
              # the scalar float stack parameters above).
              if lir_agg_is_scalar_class(agg.shape) then
                let wv = agg.word_vregs[0]
                match lir_ctx_fp_width_of(ctx, wv)
                when Option::Some(_) then
                  if fp_pos < 8 then
                    binds.push(LirStmt { kind: LirStmtKind::LirFMove(wv, lir_fixed_fp_base() + fp_pos), div: Option::None, ptr: Option::None })
                  else
                    binds.push(LirStmt { kind: LirStmtKind::LirLoadFrame(wv, 16 + 16 * stk_pos), div: Option::None, ptr: Option::None })
                    stk_pos = stk_pos + 1
                  end
                  fp_pos = fp_pos + 1
                when Option::None then
                  if gp_pos < abi_regs then
                    binds.push(LirStmt { kind: LirStmtKind::LirMove(wv, LirValue::LirReg(gp_pos)), div: Option::None, ptr: Option::None })
                  else
                    binds.push(LirStmt {
                      kind: LirStmtKind::LirLoadFrame(wv, if ctx.param_stack_mode then 8 + 4 * stk_pos else 16 + 16 * stk_pos end),
                      div: Option::None,
                      ptr: Option::None
                    })
                  end
                  if gp_pos < abi_regs then
                    gp_pos = gp_pos + 1
                  else
                    stk_pos = stk_pos + 1
                  end
                end
              else
                if gp_pos < abi_regs then
                  gp_pos = gp_pos + 1
                else
                  stk_pos = stk_pos + 1
                end
              end
            end
          when Option::None then
            return Result::Err("lir: function " + f.name + ": parameter " + f.params[bi].name + " is an aggregate parameter with no aggregate record in this function (the shape gate and the lowering disagree — fail-closed)")
          end
        end
      end
    end
    bi = bi + 1
  end
  if f.blocks.len() > 0 then
    lir_append_bindings(&mut ctx, f.blocks[0].id.id, binds)
  end

  # Phase 1: the statements of every block.
  var b0 = 0
  while b0 < f.blocks.len() do
    let block = f.blocks[b0]
    var si = 0
    while si < block.statements.len() do
      let stmt = block.statements[si]
      match stmt.kind
      when MirStatementKind::MirStorageLive(_) then ()
      when MirStatementKind::MirStorageDead(_) then ()
      when MirStatementKind::MirNop then ()
      when MirStatementKind::MirAssign(place, rvalue) then
        match lir_lower_assign(&mut ctx, block.id.id, place, rvalue)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when MirStatementKind::MirContractCheck(_, _) then
        return Result::Err("lir: " + f.name + ": contract-check statements do not lower (no rule yet)")
      when MirStatementKind::MirBudgetConsume(_, _) then
        return Result::Err("lir: " + f.name + ": budget statements do not lower (no rule yet)")
      when MirStatementKind::MirEffectRecord(_, _) then
        return Result::Err("lir: " + f.name + ": effect statements do not lower (no rule yet)")
      when MirStatementKind::MirEffectPerform(_, _, _, _, _) then
        return Result::Err("lir: " + f.name + ": effect-perform statements do not lower (no rule yet)")
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, _) then
        return Result::Err("lir: " + f.name + ": effect-frame statements do not lower (no rule yet)")
      when MirStatementKind::MirEffectFrameExit then
        return Result::Err("lir: " + f.name + ": effect-frame statements do not lower (no rule yet)")
      end
      si = si + 1
    end
    b0 = b0 + 1
  end

  # Phase 2: terminators (phi edges and call argument moves are appended
  # to the CURRENT block's statements, immediately before its terminator).
  var b1 = 0
  while b1 < f.blocks.len() do
    let block = f.blocks[b1]
    match lir_lower_terminator(&mut ctx, f, block)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    b1 = b1 + 1
  end

  # Assemble the LirFunction: blocks keep the MIR order (the MIR builder
  # guarantees the entry block is blocks[0]; codegen.tg emits in the same
  # order and the direct emitter relies on it).
  var lir_blocks: Vec[LirBlock] = Vec::new()
  var bk = 0
  while bk < f.blocks.len() do
    let mblock = f.blocks[bk]
    var stmts: Vec[LirStmt] = Vec::new()
    match ctx.block_stmts.get(mblock.id.id)
    when Option::Some(list) then stmts = list.clone()
    when Option::None then ()
    end
    var term = LirTerm { kind: LirTermKind::LirTrap }
    match ctx.block_terms.get(mblock.id.id)
    when Option::Some(t) then term = t.clone()
    when Option::None then ()
    end
    lir_blocks.push(LirBlock { id: mblock.id.id, stmts: stmts, term: term })
    bk = bk + 1
  end
  # MirAssert failure edges (lir_lower_assert) jump to a shared synthetic
  # trap block; it is appended AFTER the MIR blocks (never executed except
  # by those jumps) when any register-conditioned assert lowered.
  # Pointer/atomic dispatch blocks (the atomic slice's per-ordering arms
  # and merge/failure blocks — negative ids below the trap id, created by
  # lir_fresh_dispatch_block) are appended BETWEEN the MIR blocks and the
  # trap block, in creation order: the linearization and the emission
  # walk the same array order, so the dispatch arms' defs always precede
  # the merge tail's uses in the linear order (the arm blocks are
  # reachable only through their block's switch term).
  var eb = 0
  while eb < ctx.extra_blocks.len() do
    let eid = ctx.extra_blocks[eb]
    var estmts: Vec[LirStmt] = Vec::new()
    match ctx.block_stmts.get(eid)
    when Option::Some(list) then estmts = list.clone()
    when Option::None then ()
    end
    var eterm = LirTerm { kind: LirTermKind::LirTrap }
    match ctx.block_terms.get(eid)
    when Option::Some(t) then eterm = t.clone()
    when Option::None then ()
    end
    lir_blocks.push(LirBlock { id: eid, stmts: estmts, term: eterm })
    eb = eb + 1
  end
  if ctx.trap_used then
    var trap_stmts: Vec[LirStmt] = Vec::new()
    lir_blocks.push(LirBlock {
      id: lir_trap_block_id(),
      stmts: trap_stmts,
      term: LirTerm { kind: LirTermKind::LirTrap }
    })
  end
  # The scalar-parameter vreg list. AGGREGATE parameters have no scalar
  # vreg: the shape gate admits them as aggregate locals (ctx.agg_of),
  # and their entry binding is either the machine-level per-word copy
  # of the aggregate-param slice (the LirAggParamBind records above —
  # the ADDRESS-class images) or an entry STATEMENT into the
  # aggregate's fixed word-0 vreg (the one-word Scalar-class
  # plain-struct and payload-less tagged-enum parameters — the
  # register-class binds of the walk above), never a scalar bind
  # statement, so they are deliberately absent from this list.
  var params: Vec[Int] = Vec::new()
  var pi = 0
  while pi < f.params.len() do
    match ctx.vreg_of.get(f.params[pi].id.id)
    when Option::Some(pv) then params.push(pv)
    when Option::None then ()
    end
    pi = pi + 1
  end
  # The return-slot vreg (locals[0] is the return place; Unit-returning
  # functions carry None — MirReturn lowers to a bare Ret; aggregate-
  # return functions carry None too — their return aggregate lives in
  # fixed frame slots: the sret copy-out state rides the sret fields
  # below, and the Scalar-class return word is read by each Ret term,
  # which carries the word's fixed vreg (see the LirRet lowering)).
  var ret_vreg: Option[Int] = Option::None
  if f.locals.len() > 0 then
    match ctx.vreg_of.get(f.locals[0].id.id)
    when Option::Some(v) then ret_vreg = Option::Some(v)
    when Option::None then ()
    end
  end
  # The per-function sret record: locals[0] (the return place) is an
  # admitted aggregate — a plain struct OR a payloaded tagged-enum image
  # (the LIR-internal enum ABI) — whose image takes an sret class
  # (exactly 16 bytes / more than 8 bytes — the return-type gate admits
  # those AND the Scalar-class one-word images on this route; the
  # Scalar-class functions — one-word structs and the payload-less
  # enum's tag word alike — never set this record: their return word
  # crosses in x0 through the Ret term's word vreg), so every Ret
  # copies shape.words whole words from the aggregate's fixed frame
  # slots (first slot = its base_slot) to the caller's x8 buffer. The
  # gate guarantees the shape admits here, so the record is always
  # complete when it is nonzero.
  var sret_words = 0
  var sret_base_slot = 0
  if f.locals.len() > 0 then
    match ctx.agg_of.get(f.locals[0].id.id)
    when Option::Some(agg) then
      let sw = lir_agg_sret_words(agg.shape)
      if sw > 0 then
        sret_words = sw
        sret_base_slot = agg.base_slot
      end
    when Option::None then ()
    end
  end
  # The per-function aggregate-parameter record (the aggregate-param
  # slice): one LirAggParamBind per admitted parameter whose image
  # binds through an image ADDRESS — an address-class plain-struct
  # parameter (16-byte ScalarPair / ByAddress over 8 bytes) OR a
  # payloaded tagged-enum parameter (the LIR-internal enum ABI; both
  # are lir_agg_sret_words > 0, the parameter-side mirror of
  # the sret admission above; the shape gate has admitted exactly these
  # shapes on this route — the one-word Scalar-class plain-struct
  # images bind through the entry STATEMENTS instead and never reach
  # this record). The ABI slot fields come from the SAME
  # per-class walk the entry binding uses: slot = the parameter's
  # GENERAL-class position when it crosses in a register (the emitter
  # fetches the image address from x_slot — for signatures without
  # float parameters this equals the parameter's index, the codegen.tg
  # classify_argument order), or the 8+stk encoding for a stack-class
  # parameter (the emitter's [FP + 16 + 16*(slot-8)] == [FP + 16 +
  # 16*stk] fetch). The parameter's aggregate frame area is already
  # assigned (parameters are locals; ctx.agg_of records base_slot and
  # the word vregs), so this record only carries what the machine-level
  # entry copy needs.
  var agg_params: Vec[LirAggParamBind] = Vec::new()
  var ap_gp = 0
  var ap_stk = 0
  var ap_fp = 0
  var api = 0
  while api < f.params.len() do
    let ap_ty = f.params[api].ty
    match lir_fp_width_of(ap_ty)
    when Option::Some(fw) then
      # A float parameter consumes a float register (never an address
      # slot) while float positions remain, so it advances neither
      # general counter here. On the aarch64 route a float beyond the
      # eight d0..d7 registers consumes ONE SHARED caller-stack slot
      # (the binding walk's fp-stack rule — one 16-byte slot on the
      # same positional stream the stacked general parameters use), so
      # this walk must consume it the same way when ap_fp >= 8, or the
      # address-class records assembled after it would fetch their
      # images from the wrong caller slot. (The cortex-m route mirrors
      # its width-aware AAPCS32 binding arithmetic here for the same
      # reason — it carries no aggregate records today, but the
      # counters must stay structurally identical to the binding
      # walk's.)
      if ap_fp < 8 then
        ap_fp = ap_fp + 1
      else
        if ctx.param_stack_mode then
          if lir_fp_bytes(fw) == 8 then
            if ap_stk % 2 != 0 then
              ap_stk = ap_stk + 1
            end
            ap_stk = ap_stk + 2
          else
            ap_stk = ap_stk + 1
          end
        else
          ap_stk = ap_stk + 1
        end
      end
    when Option::None then
      if ctx.glue_head_ptr == Option::Some(f.params[api].id.id) then
        # (generated drop-glue admission — the glue ENTRY BIND): the
        # glue function's Ptr-typed `ptr` head parameter consumes ONE
        # general-class slot carrying the POINTED-TO image's address
        # (the `value` image the head copy would load); the record
        # below makes the machine-level entry copy load the value
        # local's words from [slot + 8k] into its fixed frame area at
        # function entry, exactly like an address-class by-value
        # aggregate parameter's bind (the resolver
        # lir_resolve_glue_head_bind verified the value local and the
        # head-copy contract before lowering). The per-class positions
        # stay identical to the binding walk's — both walks consume
        # this parameter's slot here and no record exists on the
        # binding side.
        let glue_val = match ctx.glue_value_local
        when Option::Some(gv) then gv
        when Option::None then
          return Result::Err("lir: function " + f.name + ": glue head parameter has no resolved value local (the shape gate and the lowering disagree — fail-closed)")
        end
        let glue_agg = match ctx.agg_of.get(glue_val)
        when Option::Some(ga) then ga
        when Option::None then
          return Result::Err("lir: function " + f.name + ": glue head value local has no aggregate record (the shape gate and the lowering disagree — fail-closed)")
        end
        if ap_gp < abi_regs then
          agg_params.push(LirAggParamBind {
            slot: ap_gp,
            base_slot: glue_agg.base_slot,
            words: glue_agg.shape.words
          })
          ap_gp = ap_gp + 1
        else
          agg_params.push(LirAggParamBind {
            slot: 8 + ap_stk,
            base_slot: glue_agg.base_slot,
            words: glue_agg.shape.words
          })
          ap_stk = ap_stk + 1
        end
      else
        match ctx.agg_of.get(f.params[api].id.id)
        when Option::Some(agg) then
          # An image-address parameter: lir_agg_sret_words reads the
          # mirror words/size every aggregate local carries (plain
          # structs AND tagged enums — a payloaded enum's image shape
          # yields the same > 0 test as an sret-class plain struct; the
          # kind never reaches this record, whose words/base_slot/slot
          # fields the machine-level entry copy reads kind-agnostically).
          if lir_agg_sret_words(agg.shape) > 0 then
            if ap_gp < abi_regs then
              agg_params.push(LirAggParamBind {
                slot: ap_gp,
                base_slot: agg.base_slot,
                words: agg.shape.words
              })
              ap_gp = ap_gp + 1
            else
              agg_params.push(LirAggParamBind {
                slot: 8 + ap_stk,
                base_slot: agg.base_slot,
                words: agg.shape.words
              })
              ap_stk = ap_stk + 1
            end
          else
            # A parameter that binds as a WORD, not through an image
            # address, cannot produce an aggregate record here: the
            # one-word Scalar-class plain-struct parameters bind through
            # the entry STATEMENTS (their single word arrives in the
            # slot like a scalar — the register-class binds of the
            # binding walk above), and so do the payload-less
            # tagged-enum parameters (their tag word arrives in the
            # slot like a scalar — see the binding walk above), so the
            # slot is consumed and no record
            # is made. (Payloaded tagged-enum parameters take the
            # address-class IF branch above — their images are
            # lir_agg_sret_words > 0 under the LIR-internal enum ABI.)
            # A one-word plain-struct parameter whose word is a FLOAT
            # field (the float-field slice) consumes a FLOAT position
            # instead — its single word is the field value, binding
            # like a scalar float (the binding walk's fp arm: FP
            # position ap_fp < 8, or one shared caller-stack slot
            # beyond on the aarch64 route) — so it advances neither
            # general counter here, exactly like a float parameter
            # above (the shared-slot consumption mirrored the same
            # way).
            # (Consuming keeps this walk's per-class positions identical
            # to the binding walk's — the two sides must agree by
            # construction.)
            match lir_ctx_fp_width_of(ctx, agg.word_vregs[0])
            when Option::Some(_) then
              if ap_fp < 8 then
                ap_fp = ap_fp + 1
              else
                ap_stk = ap_stk + 1
              end
            when Option::None then
              if ap_gp < abi_regs then
                ap_gp = ap_gp + 1
              else
                ap_stk = ap_stk + 1
              end
            end
          end
        when Option::None then
          # A general scalar parameter: advance the walk only (no
          # aggregate record exists for it).
          if ap_gp < abi_regs then
            ap_gp = ap_gp + 1
          else
            ap_stk = ap_stk + 1
          end
        end
      end
    end
    api = api + 1
  end
  let entry = if f.blocks.len() > 0 then f.blocks[0].id.id else 0 end
  Result::Ok(LirFunction {
    name: f.name.clone(),
    attr_cold: f.attr_cold,
    vregs: ctx.next_vreg,
    fp_widths: ctx.fp_widths,
    params: params,
    ret_vreg: ret_vreg,
    blocks: lir_blocks,
    entry_block: entry,
    agg_slots: ctx.next_agg_slot,
    agg_word_slots: ctx.agg_word_slots,
    sret_words: sret_words,
    sret_base_slot: sret_base_slot,
    sret_call_slots: ctx.sret_call_slots,
    agg_call_args: ctx.agg_call_args,
    agg_params: agg_params
  })
end

# ———————————————————————————————————————————————————————————————
# Peephole — Slice 5 (trivially-safe rewrites only)
# ———————————————————————————————————————————————————————————————
# Implemented: self-move elimination (Move d <- Reg(d) is a no-op; the
# float LirFMove self-move is a no-op the same way).
# Compare-and-branch FUSION where the encoders allow it lives in the
# emitter (a LirSwitch arm with value 0 lowers to cbz/cbnz — see
# lir_emit_switch); the remaining scheduling backlog (move elimination
# via subsumption, further cmp+branch fusion, fallthrough layout,
# constant rematerialization) is not implemented. Every rewrite
# preserves interval/position bookkeeping, so the peephole runs on the
# IR BEFORE allocation and only removes statements.

def lir_peephole_stmts(stmts: Vec[LirStmt]) -> Vec[LirStmt]
  var out: Vec[LirStmt] = Vec::new()
  var i = 0
  while i < stmts.len() do
    let stmt = stmts[i]
    var keep = true
    match stmt.kind
    when LirStmtKind::LirMove(dst, val) then
      match val
      when LirValue::LirReg(src) then
        if dst == src then
          keep = false
        end
      when _ then ()
      end
    when LirStmtKind::LirFMove(dst, src) then
      if dst == src then
        keep = false
      end
    when _ then ()
    end
    if keep then
      out.push(stmt.clone())
    end
    i = i + 1
  end
  out
end

def lir_peephole(f: LirFunction) -> LirFunction
  var blocks: Vec[LirBlock] = Vec::new()
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    blocks.push(LirBlock {
      id: b.id,
      stmts: lir_peephole_stmts(b.stmts),
      term: b.term.clone()
    })
    bi = bi + 1
  end
  LirFunction {
    name: f.name.clone(),
    attr_cold: f.attr_cold,
    vregs: f.vregs,
    fp_widths: f.fp_widths,
    params: f.params.clone(),
    ret_vreg: f.ret_vreg,
    blocks: blocks,
    entry_block: f.entry_block,
    agg_slots: f.agg_slots,
    agg_word_slots: f.agg_word_slots,
    sret_words: f.sret_words,
    sret_base_slot: f.sret_base_slot,
    sret_call_slots: f.sret_call_slots,
    agg_call_args: f.agg_call_args,
    agg_params: f.agg_params.clone()
  }
end
# ———————————————————————————————————————————————————————————————
# Linear-scan register allocation (Slice 3)
# ———————————————————————————————————————————————————————————————
# Intervals: per-vreg convex hulls over the linearized positions (I3),
# cut at every call position (I2). Allocation is a deterministic first-
# fit scan over the segments sorted by start: each segment gets one pool
# register for its whole span, or memory (then every def stores and every
# use loads, and the segment's vreg gets a spill slot).
#   Caller-saved pool x9..x14 — the default class (and the ONLY class on
#   the riscv/cortex-m routes, which call lir_alloc_registers /
#   lir_alloc_registers_cm): a register-
#   resident pre-call segment stores to its slot right before the call; a
#   register-resident post-call segment whose first event is a read
#   reloads at that first read (I2).
#   Callee-saved pool x19..x28 (aarch64 route only — the callee-saved
#   class): a vreg whose value is live across a call is allocated WHOLE
#   — one
#   first-fit callee-saved register shared by every segment of its hull —
#   so the value rides each call in the register the callee preserves,
#   and NO store-before-call/reload record or slot exists for it; the
#   prologue saves exactly the callee-saved registers actually used
#   (LirAlloc.cc_used) and the epilogue restores them. A crossing vreg
#   that finds no free callee-saved register across its hull falls back
#   to ordinary per-segment caller-saved allocation, keeping the
#   store/reload semantics unchanged.
#   Fixed-slot vregs (aggregate word vregs — LirFunction.agg_word_slots):
#   never register-resident. Their segments are preset phys = -1 with
#   the preassigned aggregate-slot index at build time; they skip both
#   pools and the slot-numbering pass, so their defs store / uses load
#   through the ordinary spill machinery at every occurrence — including
#   the terminator positions the aggregate-return slice adds: a
#   Scalar-class aggregate call destination defs its fixed word at the
#   call position (the post-call x0 capture) and a Scalar-class
#   aggregate-return function's Ret reads its return word at the Ret
#   position (the load-to-x0).
#   FLOAT-class vregs (LirFunction.fp_widths — the class table): the
#   scan picks the FP pool d16..d29 (physical ids 100+code — disjoint
#   from the general physical ids, so no class test ever guards the
#   segment records) for every FP segment — EXCEPT an F32-class vreg
#   on the cortex-m route, whose F32 values are MEMORY-CLASS (the cm
#   entry keeps them out of the pool — their single image has no
#   register alias above d15 on the cortex-m model; see
#   lir_alloc_registers_cm) — and FP vregs never enter the
#   callee-saved class (their crossing candidates are excluded before
#   the whole-hull attempt), so a float value live across a call takes
#   the ordinary caller-saved path — store before the call, reload at
#   its first post-call read — exactly like the x9..x14 class. FP
#   spill slots carry the value's width image (see the emitter helpers):
#   the a64 route's uniform 8-byte slots hold both widths; the cortex-m
#   route's cm entry (lir_alloc_registers_cm) numbers its slots as
#   4-byte words and sizes an F64 image's home to TWO words at an
#   8-byte-aligned base (lir_cm_vreg_slot_words — the per-base word
#   counts ride out in LirAlloc.slot_words).
# Everything the emitter needs (segment decisions, store-before-call
# records, first-read reload records, the cc_used save list) is
# PRECOMPUTED here, so emission stays stateless.

struct LirSeg
  start: Int
  end: Int     # inclusive
  vreg: Int
  phys: Int    # physical register id — the X-file ids 9..14/19..28 for
               # general vregs, the FP namespace 100+code (d16..d29) for
               # float vregs (on the cortex-m route an F32-class vreg is
               # always memory-resident — phys -1 — by the entry's
               # memory-class rule) — or -1 when memory-resident
  slot: Int    # spill-slot index (aggregate word vregs carry their
               # preassigned aggregate-slot index), or -1; on the
               # cortex-m route the index counts 4-byte words and an
               # F64 vreg's slot is its 8-byte image's BASE word (see
               # lir_alloc_registers_cm)
  needs_reload: Bool
end

struct LirAlloc
  slots: Int                 # total number of slot units — one uniform
                             # unit per vreg home on the aarch64/riscv
                             # routes (8-byte slots on a64 — aggregate
                             # region + vreg spill slots + the sret x8-save
                             # slot when the function returns through x8;
                             # the riscv route reads the count at its
                             # xlen — see rv_frame_bytes); 4-byte WORDS on
                             # the cortex-m route, where an F64-class
                             # vreg's width-sized image takes two (see
                             # lir_alloc_registers_cm)
  frame_bytes: Int           # frame allocation size — 16-aligned (8-byte
                             # slot units + the callee-saved save block,
                             # 8 bytes per used register) on the aarch64
                             # route; 8-aligned word bytes on the
                             # cortex-m route (slot i at [FP + 4*i], no
                             # per-register save block — the cm prologue
                             # pushes its whole pool block)
  segs_of: Map[Int, Vec[LirSeg]]   # vreg -> segments, sorted by start
  # (call position, vreg): store the register value to its slot right
  # before the call at that position
  spills: Vec[(Int, Int)]
  # (position, vreg): the post-call segment's FIRST read — reload the
  # slot into the segment register before the instruction at that
  # position
  reloads: Vec[(Int, Int)]
  # Callee-saved aarch64 registers (x19..x28) the allocation actually
  # assigned, ASCENDING: the aarch64 emitter saves exactly these in the
  # prologue and restores them in the epilogue, at the bottom of the
  # frame — used[k] at [FP - frame_bytes + 8*k] (the codegen.tg aarch64
  # convention). Empty on the riscv/cortex-m routes and for functions
  # whose intervals never cross a call. Defaulted so constructors that
  # do not set it stay valid.
  cc_used: Vec[Int] = Vec::new()
  # sret-return frame state (aggregate returns; see the sret-return
  # slice section). sret_slot is the frame-slot index (the lir_slot_offset
  # convention: [FP - 8 - 8*sret_slot]) of the word that saves the
  # caller-supplied x8 pointer — the allocator reserves it AFTER the vreg
  # spill slots, so the slot numbering above never moves once fixed, and
  # the slot region (slots/frame_bytes) covers it; -1 = not an sret
  # function. sret_words / sret_base_slot repeat the LirFunction copy-out
  # record the emitter needs at every Ret — the emitter is stateless, so
  # the copy-out reads everything from here (never from the function).
  # All three are defaulted so the thumb/rv routes (whose gate rejects
  # aggregate returns) and non-sret functions stay valid.
  sret_slot: Int = -1
  sret_words: Int = 0
  sret_base_slot: Int = 0
  # The function's FLOATING-POINT class table (LirFunction.fp_widths,
  # copied at allocation): the emitter's class/width authority for the
  # spill loads/stores and the FP def/use resolution (slot images,
  # register moves and memory accesses dispatch on the width). Empty
  # for functions without float values.
  fp_widths: Map[Int, LirFpWidth] = Map::new()
  # The cortex-m route's per-slot width record (see
  # lir_alloc_registers_cm — the route whose slot numbering is width-
  # aware): slot_words maps each spill slot's BASE index to the number
  # of 4-byte WORDS the image reserved there occupies — 2 for an
  # F64-class vreg's slot (an 8-byte double image at an 8-byte-aligned
  # base — even word index), 1 for F32-class and general vregs' slots.
  # Defaulted empty: the aarch64/riscv routes index one uniform 8-byte
  # slot unit per vreg (the image width resolves from fp_widths there)
  # and never fill it, so constructors that do not set it stay valid.
  slot_words: Map[Int, Int] = Map::new()
end

struct LirOcc
  pos: Int
  is_def: Bool
end

# Record one occurrence (def or use) for a vreg during the linearization
# walk. Fixed vregs (0..7 — x0..x7 — and 8..15 — d0..d7) are excluded:
# they are never allocated and the
# emitter resolves them directly to their physical registers.
def lir_occ_push(inout occs: Map[Int, Vec[LirOcc]], vreg: Int, pos: Int, is_def: Bool) -> Unit
  if vreg >= lir_first_alloc_vreg() then
    match occs.get(vreg)
    when Option::Some(list) then
      var l = list.clone()
      l.push(LirOcc { pos: pos, is_def: is_def })
      occs.insert(vreg, l)
    when Option::None then
      var l: Vec[LirOcc] = Vec::new()
      l.push(LirOcc { pos: pos, is_def: is_def })
      occs.insert(vreg, l)
    end
  end
end

# A statement's vregs: (defs, uses). Imm/`unit` payloads carry nothing.
def lir_stmt_occ(occ_kind: LirStmtKind, inout defs: Vec[Int], inout uses: Vec[Int]) -> Unit
  match occ_kind
  when LirStmtKind::LirMove(dst, val) then
    defs.push(dst)
    match val
    when LirValue::LirReg(src) then uses.push(src)
    when _ then ()
    end
  when LirStmtKind::LirBinop(_, dst, left, right) then
    defs.push(dst)
    match left
    when LirValue::LirReg(lv) then uses.push(lv)
    when _ then ()
    end
    match right
    when LirValue::LirReg(rv) then uses.push(rv)
    when _ then ()
    end
  when LirStmtKind::LirUnop(_, dst, src) then
    defs.push(dst)
    uses.push(src)
  when LirStmtKind::LirCmp(left, right) then
    match left
    when LirValue::LirReg(lv) then uses.push(lv)
    when _ then ()
    end
    match right
    when LirValue::LirReg(rv) then uses.push(rv)
    when _ then ()
    end
  when LirStmtKind::LirCset(_, dst) then
    defs.push(dst)
  when LirStmtKind::LirLoadFrame(dst, _) then
    defs.push(dst)
  when LirStmtKind::LirStaticLoad(dst, _) then
    # A static-value load is a pure register def (the address and the
    # load are the statement's own emission; nothing else is read).
    defs.push(dst)
  when LirStmtKind::LirPushArg(vreg) then
    uses.push(vreg)
  when LirStmtKind::LirFMove(dst, src) then
    defs.push(dst)
    uses.push(src)
  when LirStmtKind::LirFBinop(_, _, dst, left, right) then
    defs.push(dst)
    uses.push(left)
    uses.push(right)
  when LirStmtKind::LirFNeg(_, dst, src) then
    defs.push(dst)
    uses.push(src)
  when LirStmtKind::LirFCmp(_, left, right) then
    uses.push(left)
    uses.push(right)
  when LirStmtKind::LirFConst(_, dst, _) then
    defs.push(dst)
  when LirStmtKind::LirIntToFloat(_, dst, src, _) then
    defs.push(dst)
    uses.push(src)
  when LirStmtKind::LirFloatToInt(_, dst, src) then
    defs.push(dst)
    uses.push(src)
  when LirStmtKind::LirFcvt(_, dst, src) then
    defs.push(dst)
    uses.push(src)
  end
end

# The def/use traffic of a MARKED pointer/atomic statement (LirStmt.ptr)
# — the marker-aware walk lir_linearize consults instead of the nominal
# kind's shape: LirPtrLea/LirPtrAddr/LirPtrLoad/LirAtomLoad def dst and
# use their base/addr operand; the stores use their two source words;
# the LSE arms def the result and use the sources (a CAS arm uses THREE
# source words). Uses are recorded BEFORE defs so a hypothetical
# in-out aliasing between a marked statement's result and a source
# stays within one segment (the emitter reads every source before it
# writes the result — the LSE register discipline).
def lir_ptr_stmt_occ(pop: LirPtrOp, inout defs: Vec[Int], inout uses: Vec[Int]) -> Unit
  match pop
  when LirPtrOp::LirPtrLea(dst, _) then defs.push(dst)
  when LirPtrOp::LirPtrAddr(dst, base, _) then
    uses.push(base)
    defs.push(dst)
  when LirPtrOp::LirPtrLoad(dst, base, _, _, _) then
    uses.push(base)
    defs.push(dst)
  when LirPtrOp::LirPtrStore(base, _, src, _) then
    uses.push(base)
    uses.push(src)
  when LirPtrOp::LirAtomLoad(_, _, dst, addr) then
    uses.push(addr)
    defs.push(dst)
  when LirPtrOp::LirAtomStore(_, _, addr, val) then
    uses.push(addr)
    uses.push(val)
  when LirPtrOp::LirAtomRmw(_, _, _, dst, addr, val) then
    uses.push(addr)
    uses.push(val)
    defs.push(dst)
  when LirPtrOp::LirAtomCas(_, _, dst, exp, des, addr) then
    uses.push(exp)
    uses.push(des)
    uses.push(addr)
    defs.push(dst)
  when LirPtrOp::LirPtrFence(_) then ()
  end
end

# A terminator's vreg traffic at its own position: Call reads no vregs at
# the call position itself (argument moves/pushes are statements before
# it) and defines dest AFTER the clobber; Ret reads the return vreg.
# Jump/Switch/Trap read nothing here beyond the switch operand.
def lir_term_occ(kind: LirTermKind, inout defs: Vec[Int], inout uses: Vec[Int]) -> Unit
  match kind
  when LirTermKind::LirJump(_) then ()
  when LirTermKind::LirSwitch(vreg, _, _) then uses.push(vreg)
  when LirTermKind::LirRet(rv) then
    match rv
    when Option::Some(v) then uses.push(v)
    when Option::None then ()
    end
  when LirTermKind::LirTrap then ()
  when LirTermKind::LirCall(_, _, _, dest, _) then
    match dest
    when Option::Some(v) then defs.push(v)
    when Option::None then ()
    end
  end
end

# Is a terminator a direct call? (Only calls cut intervals.)
def lir_term_is_call(kind: LirTermKind) -> Bool
  match kind
  when LirTermKind::LirCall(_, _, _, _, _) then true
  when _ then false
  end
end


# The earliest use at or after `from` (defs do not satisfy a use).
def lir_first_use_after(occs: Vec[LirOcc], from: Int) -> Option[Int]
  var i = 0
  while i < occs.len() do
    let o = occs[i]
    if o.pos >= from && !o.is_def then
      return Option::Some(o.pos)
    end
    i = i + 1
  end
  Option::None
end

# The earliest def at or after `from`.
def lir_first_def_after(occs: Vec[LirOcc], from: Int) -> Option[Int]
  var i = 0
  while i < occs.len() do
    let o = occs[i]
    if o.pos >= from && o.is_def then
      return Option::Some(o.pos)
    end
    i = i + 1
  end
  Option::None
end

# Linearize the function (block order, statements then terminator per
# block), collecting per-vreg occurrences and the call positions. The
# emitter walks in EXACTLY this order (I3).
def lir_linearize(f: LirFunction, inout occs: Map[Int, Vec[LirOcc]], inout calls: Vec[Int]) -> Unit
  var pos = 0
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    var si = 0
    while si < b.stmts.len() do
      var defs: Vec[Int] = Vec::new()
      var uses: Vec[Int] = Vec::new()
      # The marked pointer/atomic statements use their OWN def/use shape
      # (the nominal kind's shape is arity-nearest only — see LirPtrOp).
      match b.stmts[si].ptr
      when Option::Some(pop) then lir_ptr_stmt_occ(pop, defs, uses)
      when Option::None then lir_stmt_occ(b.stmts[si].kind, defs, uses)
      end
      var di = 0
      while di < defs.len() do
        lir_occ_push(occs, defs[di], pos, true)
        di = di + 1
      end
      var ui = 0
      while ui < uses.len() do
        lir_occ_push(occs, uses[ui], pos, false)
        ui = ui + 1
      end
      pos = pos + 1
      si = si + 1
    end
    var tdefs: Vec[Int] = Vec::new()
    var tuses: Vec[Int] = Vec::new()
    lir_term_occ(b.term.kind, tdefs, tuses)
    var tdi = 0
    while tdi < tdefs.len() do
      lir_occ_push(occs, tdefs[tdi], pos, true)
      tdi = tdi + 1
    end
    var tui = 0
    while tui < tuses.len() do
      lir_occ_push(occs, tuses[tui], pos, false)
      tui = tui + 1
    end
    if lir_term_is_call(b.term.kind) then
      calls.push(pos)
    end
    pos = pos + 1
    bi = bi + 1
  end
end

# Build the initial (undecided) segments of a vreg: the convex hull
# [first, last] cut at every call position strictly inside it. Position
# p of a call cuts [.., p-1] | [p, ..]: the pre-call side excludes the
# call (values read there live in statements before the call), and the
# post-call side starts at the call (the dest def writes after the
# clobber).
def lir_build_vreg_segs(occs: Vec[LirOcc], vreg: Int, calls: Vec[Int]) -> Vec[LirSeg]
  var segs: Vec[LirSeg] = Vec::new()
  if occs.len() == 0 then
    return segs
  end
  let first = occs[0].pos
  let last = occs[occs.len() - 1].pos
  var cur = first
  var ci = 0
  while ci < calls.len() do
    let c = calls[ci]
    if c > first && c <= last then
      if cur <= c - 1 then
        segs.push(LirSeg { start: cur, end: c - 1, vreg: vreg, phys: -1, slot: -1, needs_reload: false })
      end
      cur = c
    end
    ci = ci + 1
  end
  segs.push(LirSeg { start: cur, end: last, vreg: vreg, phys: -1, slot: -1, needs_reload: false })
  segs
end

# Is vreg `v` live across any call — the callee-saved-pool test? The hull
# segments of one vreg tile [first..last] contiguously (lir_build_vreg_segs
# cuts at every call strictly inside), so consecutive segments always meet
# at a call position c = segs[i].end + 1 = segs[i + 1].start. The pre-call
# value survives c exactly when the vreg's first event at/after c is a READ
# (a def at/after c before that read — the call-dest write — would kill the
# old value first). This mirrors the per-segment reload decision the
# finalize pass makes for caller-saved post-call segments.
def lir_vreg_crosses_call(occs: Vec[LirOcc], segs: Vec[LirSeg]) -> Bool
  var i = 0
  while i + 1 < segs.len() do
    let c = segs[i].end + 1
    if segs[i + 1].start == c then
      var reads_old = false
      match lir_first_use_after(occs, c)
      when Option::Some(upos) then
        reads_old = true
        match lir_first_def_after(occs, c)
        when Option::Some(dpos) then
          if dpos <= upos then
            reads_old = false
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
      if reads_old then
        return true
      end
    end
    i = i + 1
  end
  false
end

# Does this vreg need a spill slot? Yes when any segment is memory-
# resident, or when a CALLER-SAVED register segment ends right before a
# call (its value must survive the call through the slot). A callee-saved
# register segment rides the call in the register the callee preserves —
# it never needs a slot on that account. Everything else (pure-register
# values that never cross a call) needs no slot.
def lir_vreg_needs_slot(segs: Vec[LirSeg], calls_set: Set[Int]) -> Bool
  var i = 0
  while i < segs.len() do
    let s = segs[i]
    if s.phys < 0 then
      return true
    end
    if calls_set.contains(&(s.end + 1)) && !lir_is_cc_reg(s.phys) then
      return true
    end
    i = i + 1
  end
  false
end

# The linear-scan entry used by the riscv backend — the ORIGINAL
# caller-saved-only contract: its register model is a machine
# callee-saved pool already and its emitter saves the whole register
# block unconditionally, so the x19..x28 class must stay closed here and
# the decisions stay byte-identical to the pre-callee-saved scan. Slot
# numbering keeps the uniform one-slot-per-vreg model (the rv route's
# frame math reads slots at its xlen unit; its gate rejects float
# types, so no width-sized image ever needs a home). f32_pool_ok stays
# true: the route admits no FP-class vregs at all, so the flag is inert.
def lir_alloc_registers(f: LirFunction) -> LirAlloc
  lir_alloc_registers_mode(f, Vec::new(), false, true)
end

# The aarch64-route entry: opens the callee-saved pool (x19..x28) for
# call-crossing intervals (see lir_alloc_registers_mode). F32 values
# stay POOL-ELIGIBLE (f32_pool_ok = true): on the aarch64 register
# model every V register has an encodable S view (the S-form encoders
# of asm.tg index the V file directly — an F32 in pool register
# d16..d29 IS the S-form s16..s29, the low 32 bits of V16..V29), so a
# register-resident F32 lowers exactly like an F64 one.
def lir_alloc_registers_a64(f: LirFunction) -> LirAlloc
  lir_alloc_registers_mode(f, lir_cc_pool_regs(), false, true)
end

# The cortex-m-route entry (backend_thumb.tg — the AAPCS32 route over
# 4-byte words): the caller-saved-only contract (cc_pool stays empty —
# the cm machine pool registers are the desc's callee-saved set, pushed
# unconditionally by the prologue, so no per-register save block and no
# x19..x28 class exist here) with the cm slot geometry: a spill slot is
# a 4-byte WORD (slot i at [FP + 4*i] — thumb_slot_offset), and a
# needing-slot F64-class vreg's home is WIDTH-SIZED — two consecutive
# words at an even (8-byte-aligned) base (lir_cm_vreg_slot_words) —
# while F32-class and general vregs keep one word. The numbering
# reserves each F64 image's full pair (never handing the neighbour
# word to another vreg) and records every image's word count by its
# base slot in LirAlloc.slot_words; LirAlloc.slots / frame_bytes count
# words, so the cm float arms can lay down and read an 8-byte double
# image soundly (backend_thumb.tg's width-dispatched slot forms —
# thumb_slot_fp_load / thumb_slot_fp_store — address the base word at
# the image width).
# F32 values are MEMORY-CLASS on this route (f32_pool_ok = false): the
# cm allocator never places an F32-class vreg in the FP pool (d16..d29
# — its registers have no single-register alias on the cortex-m model,
# s0..s31 alias d0..d15 only, so a pool-resident F32 has no encodable
# view), leaving every F32 segment phys = -1 with its width-correct
# one-word slot; the cm float arms lower every F32 statement load-op-
# store through the FP statement scratches (d15/s30, d14/s28). F64
# values keep the pool.
def lir_alloc_registers_cm(f: LirFunction) -> LirAlloc
  lir_alloc_registers_mode(f, Vec::new(), true, false)
end

# The width of one cortex-m spill image (see lir_alloc_registers_cm):
# the number of 4-byte WORD slots a needing-slot vreg's home occupies —
# 2 for an F64-class vreg (an 8-byte double image; the numbering gives
# it an even base word, so the image is 8-byte-aligned), 1 for
# F32-class and general vregs. The a64/rv routes size every vreg's
# home as one uniform slot unit and never call this.
def lir_cm_vreg_slot_words(f: LirFunction, vreg: Int) -> Int
  var words = 1
  match f.fp_widths.get(vreg)
  when Option::Some(w) then
    if w == LirFpWidth::LirF64 then
      words = 2
    end
  when Option::None then ()
  end
  words
end

# The linear-scan body: decide every segment, then assign slots.
# Deterministic: segments are considered in (start, vreg) order; pool
# registers are tried in pool order; slots are numbered by vreg order.
# `cc_pool` is the route's callee-saved class — empty on the
# riscv/cortex-m routes (their caller-saved-only entries above), x19..x28
# on the aarch64 route. `cm_word_slots` selects the slot geometry:
# false = the uniform a64/rv model (one 8-byte slot unit per needing-
# slot vreg, frame_bytes 16-aligned); true = the cortex-m model (slots
# are 4-byte words, an F64-class image takes two words at an even base,
# frame_bytes is the 8-aligned word total — see lir_alloc_registers_cm
# and lir_cm_vreg_slot_words). `f32_pool_ok` admits F32-class vregs to
# the FP pool: true on the aarch64/riscv routes (an aarch64 F32 in the
# pool rides the S view of its V register — s16..s29 — and the riscv
# gate admits no floats at all); false on the cortex-m route, whose
# F32 values are MEMORY-CLASS (the pool registers d16..d29 have no
# single-register alias on the cortex-m model, s0..s31 alias d0..d15
# only) — see lir_alloc_registers_cm.
# AGGREGATE WORD VREGS (f.agg_word_slots): plain-struct/enum image
# words are FIXED-SLOT vregs — the map holds their preassigned slot indexes
# (assigned at lowering, in the aggregate slot region 0..agg_slots-1).
# Their segments are preset phys = -1 / slot = fixed at build time,
# they never enter a register pool or the callee-saved whole-hull
# class, and the slot-numbering pass skips them (vreg spill slots are
# numbered from f.agg_slots up). Every def of such a vreg stores to its
# slot and every use loads from it through the ordinary spill
# machinery, so the aggregate local's slot area is its ONLY storage —
# exactly the direct emitter's stack-homed aggregate locals.
def lir_alloc_registers_mode(f: LirFunction, cc_pool: Vec[Int], cm_word_slots: Bool, f32_pool_ok: Bool) -> LirAlloc
  var occs: Map[Int, Vec[LirOcc]] = Map::new()
  var calls: Vec[Int] = Vec::new()
  lir_linearize(f, occs, calls)
  var calls_set: Set[Int] = Set::new()
  var ci = 0
  while ci < calls.len() do
    calls_set.insert(calls[ci])
    ci = ci + 1
  end
  var pool = lir_pool_regs()
  var no_pool: Vec[Int] = Vec::new()
  let fixed_slots = f.agg_word_slots

  # Build every vreg's segment list and the global consideration order.
  # Fixed-slot (aggregate word) vregs get their preset memory segments
  # here: phys = -1, slot = the preassigned index — they are decided at
  # build time and the first-fit scan below skips them.
  var segs_of: Map[Int, Vec[LirSeg]] = Map::new()
  var order: Vec[(Int, Int)] = Vec::new()   # (start, vreg) pairs
  var v = lir_first_alloc_vreg()
  while v < f.vregs do
    match occs.get(v)
    when Option::Some(list) then
      var segs = lir_build_vreg_segs(list, v, calls)
      match fixed_slots.get(v)
      when Option::Some(fix_slot) then
        var fixed = segs.clone()
        var fi = 0
        while fi < fixed.len() do
          fixed[fi] = LirSeg { start: fixed[fi].start, end: fixed[fi].end, vreg: v, phys: -1, slot: fix_slot, needs_reload: false }
          fi = fi + 1
        end
        segs = fixed
      when Option::None then ()
      end
      if segs.len() > 0 then
        segs_of.insert(v, segs)
        var si = 0
        while si < segs.len() do
          order.push((segs[si].start, v))
          si = si + 1
        end
      end
    when Option::None then ()
    end
    v = v + 1
  end

  # Stable insertion sort of `order` by start (duplicates keep vreg
  # order because the sort is stable).
  var oi = 1
  while oi < order.len() do
    let cur_start = order[oi].0
    let cur_vreg = order[oi].1
    var j = oi
    while j > 0 && order[j - 1].0 > cur_start do
      order[j] = order[j - 1]
      j = j - 1
    end
    if j != oi then
      order[j] = (cur_start, cur_vreg)
    end
    oi = oi + 1
  end

  # The call-crossing vregs — the callee-saved-pool candidates. Only
  # computed when the route opens the class (`cc_pool` non-empty); on the
  # riscv/cortex-m routes (cc_pool empty — lir_alloc_registers /
  # lir_alloc_registers_cm) the scan below stays the pure caller-saved
  # first-fit.
  # FLOAT-class vregs are deliberately excluded: the float slice
  # allocates no callee-saved FP registers (its pool d16..d29 is all
  # caller-saved — see lir_fp_pool_regs), so a call-crossing float value
  # always takes the ordinary per-segment path whose store-before-call/
  # reload records protect it across the call.
  var crossing: Set[Int] = Set::new()
  if cc_pool.len() > 0 then
    var cv = lir_first_alloc_vreg()
    while cv < f.vregs do
      if !f.fp_widths.contains_key(&cv) then
        match occs.get(cv)
        when Option::Some(list) then
          match segs_of.get(cv)
          when Option::Some(segs) then
            if lir_vreg_crosses_call(list, segs) then
              crossing.insert(cv)
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
      cv = cv + 1
    end
  end

  # First-fit scan over the sorted units. active_x holds (end, phys) of
  # caller-saved register segments whose end >= the current start;
  # active_cc holds (hull end, phys) of whole callee-saved hulls. A
  # call-crossing vreg is allocated as ONE unit at its first segment's
  # start: every segment of its hull shares the chosen callee-saved
  # register. A hull tiles its [first..last] contiguously (segments meet
  # at call cuts), so a single (hull end, phys) entry is an exact
  # interference record: it blocks exactly the later units whose hulls
  # overlap [first..last], and expires the moment they do not. When no
  # callee-saved register is free across the whole hull the vreg falls
  # back to the ordinary per-segment scan over the caller-saved pool,
  # whose call-boundary store/reload machinery (the finalize pass below)
  # then applies unchanged.
  var active_x: Vec[(Int, Int)] = Vec::new()
  var active_cc: Vec[(Int, Int)] = Vec::new()
  var cc_whole: Set[Int] = Set::new()      # vregs riding one cc register
  var cc_assigned: Set[Int] = Set::new()   # cc registers actually used
  var oi2 = 0
  while oi2 < order.len() do
    let cur_start = order[oi2].0
    let cur_vreg = order[oi2].1
    # Fixed-slot (aggregate word) vregs are decided at build time (their
    # segments already carry phys = -1 and the preassigned slot): they
    # never enter a pool, so their units only advance the scan.
    if !cc_whole.contains(&cur_vreg) && !fixed_slots.contains_key(&cur_vreg) then
      let seg_list = match segs_of.get(cur_vreg)
      when Option::Some(l) then l.clone()
      when Option::None then Vec::new()
      end
      # The segment being decided is the first one of this vreg whose
      # start equals cur_start.
      var seg_index = 0
      while seg_list[seg_index].start != cur_start do
        seg_index = seg_index + 1
      end
      # Expire finished active units of both pools.
      var kept_x: Vec[(Int, Int)] = Vec::new()
      var ai = 0
      while ai < active_x.len() do
        if active_x[ai].0 >= cur_start then
          kept_x.push(active_x[ai])
        end
        ai = ai + 1
      end
      active_x = kept_x
      var kept_cc: Vec[(Int, Int)] = Vec::new()
      var ai2 = 0
      while ai2 < active_cc.len() do
        if active_cc[ai2].0 >= cur_start then
          kept_cc.push(active_cc[ai2])
        end
        ai2 = ai2 + 1
      end
      active_cc = kept_cc
      # The callee-saved whole-hull attempt: a call-crossing vreg whose
      # FIRST segment this is, when the route opens the class. First-fit
      # over cc_pool; any active whole hull of the same register that
      # reaches this start blocks the candidate.
      var cc_phys = -1
      if cc_pool.len() > 0 && crossing.contains(&cur_vreg) && seg_list[0].start == cur_start then
        let hull_last = seg_list[seg_list.len() - 1].end
        var cpi = 0
        while cpi < cc_pool.len() do
          let cand = cc_pool[cpi]
          var busy = false
          var cbi = 0
          while cbi < active_cc.len() do
            if active_cc[cbi].1 == cand then
              busy = true
              cbi = active_cc.len() + 1
            else
              cbi = cbi + 1
            end
          end
          if !busy then
            cc_phys = cand
            cpi = cc_pool.len() + 1
          else
            cpi = cpi + 1
          end
        end
        if cc_phys >= 0 then
          var updated = seg_list.clone()
          var usi = 0
          while usi < updated.len() do
            updated[usi] = LirSeg {
              start: seg_list[usi].start,
              end: seg_list[usi].end,
              vreg: cur_vreg,
              phys: cc_phys,
              slot: -1,
              needs_reload: false
            }
            usi = usi + 1
          end
          segs_of.insert(cur_vreg, updated)
          active_cc.push((hull_last, cc_phys))
          cc_whole.insert(cur_vreg)
          cc_assigned.insert(cc_phys)
        end
      end
      if cc_phys < 0 then
        # Ordinary per-segment allocation over the segment's class
        # caller-saved pool: a FLOAT-class vreg draws from the FP pool
        # (d16..d29 — its segments' phys ids are the 100+code FP
        # namespace, disjoint from every general pool id, so the
        # active-list equality tests and the cc-class tests below need
        # no class checks); a general vreg draws from x9..x14. The ONE
        # class/pool exclusion: an F32-class vreg on a route with
        # f32_pool_ok == false (the cortex-m entry) draws from NO pool
        # — its F32 single image has no register-resident home in the
        # cm FP pool (d16..d29 — no single-register alias above d15 on
        # the cortex-m register model, s0..s31 alias d0..d15 only), so
        # F32 is MEMORY-CLASS there: the empty pool leaves the segment
        # phys = -1 below and the width-correct one-word slot comes
        # from the numbering pass, exactly like a spilled register
        # segment (the cm float arms lower every F32 statement load-
        # op-store through the FP statement scratches).
        var f32_mem_class = false
        match f.fp_widths.get(cur_vreg)
        when Option::Some(LirFpWidth::LirF32) then
          if !f32_pool_ok then
            f32_mem_class = true
          end
        when Option::Some(LirFpWidth::LirF64) then ()
        when Option::None then ()
        end
        let seg_pool = if f.fp_widths.contains_key(&cur_vreg) then
          if f32_mem_class then no_pool else lir_fp_pool_regs() end
        else
          pool
        end
        var chosen = -1
        var pi = 0
        while pi < seg_pool.len() do
          let cand = seg_pool[pi]
          var busy = false
          var bi = 0
          while bi < active_x.len() do
            if active_x[bi].1 == cand then
              busy = true
              bi = active_x.len() + 1
            else
              bi = bi + 1
            end
          end
          if !busy then
            chosen = cand
            pi = seg_pool.len() + 1
          else
            pi = pi + 1
          end
        end
        # Rewrite the decided segment.
        var updated = seg_list.clone()
        if chosen >= 0 then
          updated[seg_index] = LirSeg {
            start: seg_list[seg_index].start,
            end: seg_list[seg_index].end,
            vreg: cur_vreg,
            phys: chosen,
            slot: -1,
            needs_reload: false
          }
          active_x.push((seg_list[seg_index].end, chosen))
        else
          updated[seg_index] = LirSeg {
            start: seg_list[seg_index].start,
            end: seg_list[seg_index].end,
            vreg: cur_vreg,
            phys: -1,
            slot: -1,
            needs_reload: false
          }
        end
        segs_of.insert(cur_vreg, updated)
      end
    end
    oi2 = oi2 + 1
  end

  # Slot numbering (vreg order) for vregs that need a home. Spill slots
  # are numbered from f.agg_slots up: the aggregate slot region occupies
  # indexes 0..agg_slots-1 (assigned at lowering), so the numbering must
  # never touch a fixed-slot (aggregate word) vreg — its slot is already
  # preset on every segment. On the cortex-m route (cm_word_slots — see
  # lir_alloc_registers_cm) a slot is a 4-byte WORD and an F64-class
  # vreg's width-sized image takes TWO consecutive words at an even
  # (8-byte-aligned) base: the numbering reserves the whole pair, never
  # hands the neighbour word to another vreg, and records every image's
  # word count by its base slot in slot_words (the LirAlloc.slot_words
  # record); F32-class and general vregs take one word.
  var slot_of: Map[Int, Int] = Map::new()
  var slot_words: Map[Int, Int] = Map::new()
  var next_slot = f.agg_slots
  var sv = lir_first_alloc_vreg()
  while sv < f.vregs do
    if !fixed_slots.contains_key(&sv) then
      match segs_of.get(sv)
      when Option::Some(segs) then
        if lir_vreg_needs_slot(segs, calls_set) then
          if cm_word_slots then
            let words = lir_cm_vreg_slot_words(f, sv)
            if words == 2 && (next_slot % 2) != 0 then
              next_slot = next_slot + 1
            end
            slot_of.insert(sv, next_slot)
            slot_words.insert(next_slot, words)
            next_slot = next_slot + words
          else
            slot_of.insert(sv, next_slot)
            next_slot = next_slot + 1
          end
        end
      when Option::None then ()
      end
    end
    sv = sv + 1
  end

  # Finalize: slot indexes, reload flags, spill/reload records. A post-
  # call CALLER-SAVED register segment whose FIRST event is a read needs
  # one reload at that read (its value crossed the call in the slot); a
  # pre-call CALLER-SAVED register segment ending at a call stores at the
  # call. Callee-saved segments (whole-hull vregs) do neither — the
  # register rides the call — so every record below is cc-guarded.
  var spills: Vec[(Int, Int)] = Vec::new()
  var reloads: Vec[(Int, Int)] = Vec::new()
  var fv = lir_first_alloc_vreg()
  while fv < f.vregs do
    match segs_of.get(fv)
    when Option::Some(segs) then
      match slot_of.get(fv)
      when Option::Some(slot_id) then
        var updated = segs.clone()
        var si = 0
        while si < updated.len() do
          let s = updated[si]
          if s.phys < 0 then
            updated[si] = LirSeg { start: s.start, end: s.end, vreg: s.vreg, phys: s.phys, slot: slot_id, needs_reload: false }
          elsif calls_set.contains(&(s.end + 1)) && !lir_is_cc_reg(s.phys) then
            # Caller-saved register-resident pre-call segment: store at
            # the call (a callee-saved value rides the call in the
            # register — no store, no slot).
            spills.push((s.end + 1, fv))
            updated[si] = LirSeg { start: s.start, end: s.end, vreg: s.vreg, phys: s.phys, slot: slot_id, needs_reload: false }
          end
          si = si + 1
        end
        segs_of.insert(fv, updated)
      when Option::None then ()
      end
    when Option::None then ()
    end
    fv = fv + 1
  end
  # Reload flags: independent of slot presence (a value can cross a call
  # only through its slot, so a reloading segment's vreg always HAS a
  # slot — the store side guaranteed it above). Whole callee-saved hulls
  # are excluded by the cc guard: their post-call reads hit the register
  # the value rode the call in.
  var rv = lir_first_alloc_vreg()
  while rv < f.vregs do
    match segs_of.get(rv)
    when Option::Some(segs) then
      var updated = segs.clone()
      var si = 0
      while si < updated.len() do
        let s = updated[si]
        if s.phys >= 0 && calls_set.contains(&s.start) && !lir_is_cc_reg(s.phys) then
          # The segment starts AT a call: decide whether its first event
          # is a read (the dest def would count as the first event when
          # present at the same position).
          match occs.get(rv)
          when Option::Some(list) then
            let first_use = lir_first_use_after(list, s.start)
            let first_def = lir_first_def_after(list, s.start)
            var reload = false
            match first_use
            when Option::Some(upos) then
              match first_def
              when Option::Some(dpos) then
                if upos < dpos then
                  reload = true
                end
              when Option::None then reload = true
              end
            when Option::None then ()
            end
            if reload then
              updated[si] = LirSeg { start: s.start, end: s.end, vreg: s.vreg, phys: s.phys, slot: s.slot, needs_reload: true }
              match first_use
              when Option::Some(upos) then
                reloads.push((upos, rv))
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        end
        si = si + 1
      end
      segs_of.insert(rv, updated)
    when Option::None then ()
    end
    rv = rv + 1
  end

  # The callee-saved registers actually assigned, ASCENDING (x19..x28):
  # the aarch64 prologue saves exactly these and the epilogue restores
  # them, in this order — the codegen.tg saved-register convention.
  # Deterministic: cc_assigned is probed in ascending register order,
  # never iterated.
  var cc_used: Vec[Int] = Vec::new()
  var cr = 19
  while cr <= 28 do
    if cc_assigned.contains(&cr) then
      cc_used.push(cr)
    end
    cr = cr + 1
  end

  # The sret-return slice: an sret function (f.sret_words > 0 — its
  # return aggregate copies out through the caller-supplied x8 pointer)
  # reserves one frame word for the x8 save. The reservation happens
  # HERE, after the vreg spill slots are numbered (and after the
  # fixed-slot aggregate words, which never enter this pass): the slot
  # index is deterministic, no later pass renumbers or moves it, and the
  # frame size below covers it — the LIR mirror of codegen.tg's
  # allocate_locals rule ("reserve the sret slot before other
  # allocations so the offset is fixed"). The saved word sits between
  # the spill slots and the callee-saved save block; the prologue stores
  # x8 to lir_slot_offset(sret_slot) and every Ret reloads it from the
  # same offset.
  var sret_slot = -1
  if f.sret_words > 0 then
    sret_slot = next_slot
    next_slot = next_slot + 1
  end

  # Frame size (route slot geometry):
  #   a64/rv (cm_word_slots false): slots are 8 bytes each at
  #     [FP - 8 - 8*slot] — the aggregate region (indexes 0..agg_slots-1)
  #     first, then the vreg spill slots, then the sret x8-save slot when
  #     the function returns through x8; the callee-saved save block is 8
  #     bytes per used register at the BOTTOM of the frame — used[k] at
  #     [FP - frame_bytes + 8*k], the codegen.tg aarch64 layout (saved[i]
  #     at [fp - stack_size + i*8]) — and the total is 16-aligned.
  #   cortex-m (cm_word_slots true): a slot is the 4-byte word at
  #     [FP + 4*i] (thumb_slot_offset), an F64 image occupies the two
  #     words the numbering reserved above (slot_words), and the frame is
  #     the 8-aligned word total — the thumb_frame_bytes rule — with no
  #     per-register save block (the cm prologue pushes its whole pool
  #     register block unconditionally).
  var frame_bytes = 0
  if cm_word_slots then
    let raw = next_slot * 4
    let rem = raw % 8
    if rem != 0 then
      frame_bytes = raw + (8 - rem)
    else
      frame_bytes = raw
    end
  else
    let raw = next_slot * 8 + cc_used.len() * 8
    let rem = raw % 16
    if rem != 0 then
      frame_bytes = raw + (16 - rem)
    else
      frame_bytes = raw
    end
  end
  LirAlloc {
    slots: next_slot,
    frame_bytes: frame_bytes,
    segs_of: segs_of,
    spills: spills,
    reloads: reloads,
    cc_used: cc_used,
    sret_slot: sret_slot,
    sret_words: f.sret_words,
    sret_base_slot: f.sret_base_slot,
    fp_widths: f.fp_widths,
    slot_words: slot_words
  }
end

# ———————————————————————————————————————————————————————————————
# Allocation query helpers (used by the emitter)
# ———————————————————————————————————————————————————————————————

# The segment of `vreg` containing position `p` (last segment with
# start <= p <= end). Callers guarantee the position lies inside the
# vreg's hull.
def lir_seg_at(segs: Vec[LirSeg], p: Int) -> Option[LirSeg]
  var found = Option::None
  var i = 0
  while i < segs.len() do
    let s = segs[i]
    if s.start <= p && p <= s.end then
      found = Option::Some(s)
    end
    i = i + 1
  end
  found
end


# Does the reload record list reload vreg `vreg` at position `pos`?
def lir_reload_at(reloads: Vec[(Int, Int)], pos: Int, vreg: Int) -> Bool
  var i = 0
  while i < reloads.len() do
    if reloads[i].0 == pos && reloads[i].1 == vreg then
      return true
    end
    i = i + 1
  end
  false
end

# The FP offset of spill slot `slot`: [FP - 8 - 8*slot].
def lir_slot_offset(slot: Int) -> Int
  -(8 + 8 * slot)
end
# ———————————————————————————————————————————————————————————————
# aarch64 emission (Slice 4)
# ———————————————————————————————————————————————————————————————
# Emits an allocated LirFunction into ctx.text reusing the asm.tg a64
# encoders. Layout conventions (mirroring codegen.tg):
#   prologue: stp fp,lr,[sp,#-16]!; mov fp,sp; sub sp,sp,#frame;
#             callee-saved saves at the bottom of the frame, used[k] at
#             [FP - frame_bytes + 8*k] (the codegen.tg aarch64 rule
#             saved[i] at [fp - stack_size + i*8]; spill slots stay at
#             [FP - 8 - 8*i], near the top — no overlap)
#   spill slot i at [FP - 8 - 8*i]
#   epilogue: restore the saved callee-saved registers from the same
#             offsets, then mov sp,fp; ldp fp,lr,[sp],#16; ret
#   entry of "main"/"_start" captures argc/argv via codegen.tg's
#   emit_save_argc_argv (the shared ctx helper; a self-contained LIR
#   capture sequence is not implemented)
#   parameters >= 8 are bound from [FP + 16 + 16*k] (general words by
#   the per-class walk's stack positions); float parameters bind from
#   the fixed ABI d-registers d0..d7 (LirFMove statements) at their
#   width; by-value aggregate
#   parameters (address-class images — the aggregate-param slice) bind
#   at machine level in the prologue: the image address is read from
#   x_slot / the caller's stack slot and each word is copied into the
#   parameter aggregate's fixed frame slots (see the entry copy below)
# FLOATING-POINT values (the float slice) ride the SIMD&FP register
# file: allocatable d16..d29 (the FP pool, caller-saved — values live
# across a call spill to their slots like the x9..x14 class), the FP
# temps V30 (memory-def target) and V31 (spill-load/constant scratch),
# fixed ABI d0..d7 for float args/results. Spill slots hold the value's
# width image at [FP - 8 - 8*i] (8 bytes for F64, the low 4 for F32).
# The emitter is stateless: every load/store/reload/spill decision comes
# from the precomputed LirAlloc (Slice 3), keyed by the linear position
# of the statement/terminator being emitted (invariant I3 — this walk is
# identical to lir_linearize's).

# The a64 register for a fixed (precolored) vreg id 0..7, or any other
# register id (used for pool/temp/scratch registers).
def lir_block_label(fn_name: String, block_id: Int) -> String
  ".L" + fn_name + ".bb" + block_id.to_string()
end

# 8-byte memory access [base + off] with the codegen.tg aarch64 offset
# strategy (scaled ldr/str for aligned non-negative, ldur/stur for
# -256..255, address computation through X15 — reserved, never
# allocated — beyond that). is_load selects load/store.
def lir_emit_mem8(inout ctx: CodegenCtx, dst: A64, base: A64, off: Int, is_load: Bool) -> Unit
  if off >= 0 && (off % 8) == 0 && off < 32768 then
    if is_load then
      a64_ldr(&mut ctx.text, dst, base, off as u32)
    else
      a64_str(&mut ctx.text, dst, base, off as u32)
    end
  elsif off >= -256 && off <= 255 then
    if is_load then
      a64_ldur(&mut ctx.text, dst, base, off as i32)
    else
      a64_stur(&mut ctx.text, dst, base, off as i32)
    end
  elsif off < 0 then
    # Large negative offset: address = base - abs(off), via X15.
    let abs_off = -off
    a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
    a64_sub_rrr(&mut ctx.text, A64::X15, base, A64::X15)
    if is_load then
      a64_ldur(&mut ctx.text, dst, A64::X15, 0)
    else
      a64_stur(&mut ctx.text, dst, A64::X15, 0)
    end
  else
    # Large positive offset: address = base + off, via X15.
    a64_mov_ri(&mut ctx.text, A64::X15, off)
    a64_add_rrr(&mut ctx.text, A64::X15, base, A64::X15)
    if is_load then
      a64_ldur(&mut ctx.text, dst, A64::X15, 0)
    else
      a64_stur(&mut ctx.text, dst, A64::X15, 0)
    end
  end
end

# Load the spill slot of `slot` into `dst`.
def lir_emit_slot_load(inout ctx: CodegenCtx, dst: A64, slot: Int) -> Unit
  lir_emit_mem8(ctx, dst, A64::FP, lir_slot_offset(slot), true)
end

# Store `src` into the spill slot of `slot`.
def lir_emit_slot_store(inout ctx: CodegenCtx, src: A64, slot: Int) -> Unit
  lir_emit_mem8(ctx, src, A64::FP, lir_slot_offset(slot), false)
end

# ———————————————————————————————————————————————————————————————
# FLOATING-POINT emission helpers (the float slice)
# ———————————————————————————————————————————————————————————————
# The FP register file (A64V d/s registers) shares the frame's 8-byte-
# indexed spill slots with the general words: an F64 value occupies the
# slot's 8 bytes (str/ldr d), an F32 canonical single its low 4 bytes
# (str/ldr s — the upper bytes of the slot are never read, so stale
# contents are harmless). The slot/register machinery below mirrors the
# general def/use helpers (LirDefTarget/lir_emit_use) with A64V targets
# and the width-dispatched memory forms; the width always resolves from
# the function's fp_widths table (LirAlloc.fp_widths — the emitter is
# stateless) or the statement payloads.

# The float width of an ordinary vreg (the alloc's class table). Fixed
# FP ABI vregs 8..15 carry no record — their width is decided by the
# statement's other (ordinary) operand.
def lir_alloc_fp_width_of(alloc: LirAlloc, vreg: Int) -> Option[LirFpWidth]
  match alloc.fp_widths.get(vreg)
  when Option::Some(w) then Option::Some(w)
  when Option::None then Option::None
  end
end

# The FMOV (register, same width) / FMOV-from-GPR encoders by width.
def lir_fp_mov_rr(inout ctx: CodegenCtx, w: LirFpWidth, d: A64V, n: A64V) -> Unit
  match w
  when LirFpWidth::LirF32 then a64_fmov_ss(&mut ctx.text, d, n)
  when LirFpWidth::LirF64 then a64_fmov_dd(&mut ctx.text, d, n)
  end
end

# FP memory access [base + off] at width `w`, mirroring lir_emit_mem8's
# offset strategy (scaled ldr/str for aligned in-range non-negative
# offsets — 8-byte units for F64, 4-byte units for F32 — ldur/stur for
# -256..255, address computation through X15 — reserved, never
# allocated — beyond that). is_load selects load/store. All forms are
# flag-neutral (invariant I1).
def lir_emit_fp_mem8(inout ctx: CodegenCtx, reg: A64V, w: LirFpWidth, base: A64, off: Int, is_load: Bool) -> Unit
  let unit = if w == LirFpWidth::LirF32 then 4 else 8 end
  # The scaled offset field is 12 bits of imm12 UNITS: F32 offsets
  # reach 4095*4 = 16380 and F64 offsets 4095*8 = 32760.
  let scaled_max = if w == LirFpWidth::LirF32 then 16384 else 32768 end
  if off >= 0 && (off % unit) == 0 && off < scaled_max then
    if is_load then
      match w
      when LirFpWidth::LirF32 then a64_ldr_s(&mut ctx.text, reg, base, off as u32)
      when LirFpWidth::LirF64 then a64_ldr_d(&mut ctx.text, reg, base, off as u32)
      end
    else
      match w
      when LirFpWidth::LirF32 then a64_str_s(&mut ctx.text, reg, base, off as u32)
      when LirFpWidth::LirF64 then a64_str_d(&mut ctx.text, reg, base, off as u32)
      end
    end
  elsif off >= -256 && off <= 255 then
    if is_load then
      match w
      when LirFpWidth::LirF32 then a64_ldur_s(&mut ctx.text, reg, base, off as i32)
      when LirFpWidth::LirF64 then a64_ldur_d(&mut ctx.text, reg, base, off as i32)
      end
    else
      match w
      when LirFpWidth::LirF32 then a64_stur_s(&mut ctx.text, reg, base, off as i32)
      when LirFpWidth::LirF64 then a64_stur_d(&mut ctx.text, reg, base, off as i32)
      end
    end
  elsif off < 0 then
    # Large negative offset: address = base - abs(off), via X15.
    let abs_off = -off
    a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
    a64_sub_rrr(&mut ctx.text, A64::X15, base, A64::X15)
    if is_load then
      match w
      when LirFpWidth::LirF32 then a64_ldur_s(&mut ctx.text, reg, A64::X15, 0)
      when LirFpWidth::LirF64 then a64_ldur_d(&mut ctx.text, reg, A64::X15, 0)
      end
    else
      match w
      when LirFpWidth::LirF32 then a64_stur_s(&mut ctx.text, reg, A64::X15, 0)
      when LirFpWidth::LirF64 then a64_stur_d(&mut ctx.text, reg, A64::X15, 0)
      end
    end
  else
    # Large positive offset: address = base + off, via X15.
    a64_mov_ri(&mut ctx.text, A64::X15, off)
    a64_add_rrr(&mut ctx.text, A64::X15, base, A64::X15)
    if is_load then
      match w
      when LirFpWidth::LirF32 then a64_ldur_s(&mut ctx.text, reg, A64::X15, 0)
      when LirFpWidth::LirF64 then a64_ldur_d(&mut ctx.text, reg, A64::X15, 0)
      end
    else
      match w
      when LirFpWidth::LirF32 then a64_stur_s(&mut ctx.text, reg, A64::X15, 0)
      when LirFpWidth::LirF64 then a64_stur_d(&mut ctx.text, reg, A64::X15, 0)
      end
    end
  end
end

# Load the spill slot of `slot` into `reg` at width `w`.
def lir_emit_slot_fp_load(inout ctx: CodegenCtx, reg: A64V, w: LirFpWidth, slot: Int) -> Unit
  lir_emit_fp_mem8(ctx, reg, w, A64::FP, lir_slot_offset(slot), true)
end

# Store `reg` into the spill slot of `slot` at width `w`.
def lir_emit_slot_fp_store(inout ctx: CodegenCtx, reg: A64V, w: LirFpWidth, slot: Int) -> Unit
  lir_emit_fp_mem8(ctx, reg, w, A64::FP, lir_slot_offset(slot), false)
end

# The FP destination target of a def at position `pos`: the segment's
# d-register, the fixed ABI d-register of a fixed FP id (8..15 — the
# float-argument moves), or the V30 temp with a pending slot store for
# a memory-resident def (the FP counterpart of X16).
struct LirFpDefTarget
  reg: A64V
  store_slot: Int   # >= 0: store reg to this slot after the def
end

def lir_fp_def_target(alloc: LirAlloc, vreg: Int, pos: Int) -> LirFpDefTarget
  if lir_is_fixed_fp_id(vreg) then
    # Fixed ABI float vregs (float call-argument moves): the register
    # IS the target (d_{vreg-8}).
    return LirFpDefTarget { reg: lir_fp_reg_a64v(vreg), store_slot: -1 }
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        LirFpDefTarget { reg: lir_fp_reg_of_phys(s.phys), store_slot: -1 }
      else
        LirFpDefTarget { reg: lir_fp_def_temp(), store_slot: s.slot }
      end
    when Option::None then
      panic("lir: fp def outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    # Never-occurring vreg.
    LirFpDefTarget { reg: lir_fp_def_temp(), store_slot: -1 }
  end
end

# Materialize the float value of `vreg` at position `pos` into an FP
# register, choosing `pref` (normally V31) when a spill load is needed;
# a reload record at (pos, vreg) loads the slot into the segment
# register first (invariant I2). Returns the register holding the
# value. `w` is the vreg's width (the caller's class record or the
# statement payload; fixed FP ids carry no record and are never
# memory-resident — the fixed-id arm ignores the width).
def lir_fp_emit_use(inout ctx: CodegenCtx, alloc: LirAlloc, vreg: Int, pos: Int, w: LirFpWidth, pref: A64V) -> A64V
  if lir_is_fixed_fp_id(vreg) then
    return lir_fp_reg_a64v(vreg)
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        if lir_reload_at(alloc.reloads, pos, vreg) then
          lir_emit_slot_fp_load(ctx, lir_fp_reg_of_phys(s.phys), w, s.slot)
        end
        lir_fp_reg_of_phys(s.phys)
      else
        lir_emit_slot_fp_load(ctx, pref, w, s.slot)
        pref
      end
    when Option::None then
      panic("lir: fp use outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    panic("lir: fp use of vreg with no intervals: " + vreg.to_string())
  end
end

# The FP load-temp convention mirrors the GP X16/X17 pattern: with the
# def temp V30 and the load temp V31, a statement's FIRST spilled
# operand loads into V31 when the def target occupies V30 (a
# memory-resident def) and into V30 otherwise; a SECOND spilled
# operand loads into the other temp. Reads always precede the def
# write within the single instruction, so a load may reuse the def
# temp exactly as the GP code reuses X16.
def lir_fp_first_pref(dt_reg: A64V) -> A64V
  if dt_reg == lir_fp_def_temp() then lir_fp_use_temp() else lir_fp_def_temp() end
end

def lir_fp_second_pref(first: A64V) -> A64V
  if first == lir_fp_def_temp() then lir_fp_use_temp() else lir_fp_def_temp() end
end

# LEA rd, [FP + off] — the register-address counterpart of the FP-
# relative memory forms above, mirroring codegen.tg's emit_lea_fp
# aarch64 arm exactly (add/sub of the frame pointer; the same X15
# scratch path covers offsets beyond the 12-bit immediate range). The
# flag-neutral add/sub forms never write NZCV, so the instruction
# sequence is safe anywhere the memory forms are (invariant I1). Used
# by the caller-side sret slice (the LirCall arm of lir_emit_term) to
# form &dest = [FP - 8 - 8*base] in x8 right before the call; X15 is
# the file's address scratch (never allocated), free at that position.
def lir_emit_lea_fp(inout ctx: CodegenCtx, rd: A64, off: Int) -> Unit
  if off >= 0 && off < 4096 then
    a64_add_rri(&mut ctx.text, rd, A64::FP, off as u32)
  elsif off < 0 && off > -4096 then
    let abs_off = -off
    a64_sub_rri(&mut ctx.text, rd, A64::FP, abs_off as u32)
  elsif off < 0 then
    # Large negative offset: address = FP - abs(off), via X15.
    let abs_off = -off
    a64_mov_ri(&mut ctx.text, A64::X15, abs_off)
    a64_sub_rrr(&mut ctx.text, rd, A64::FP, A64::X15)
  else
    # Large positive offset: address = FP + off, via X15.
    a64_mov_ri(&mut ctx.text, A64::X15, off)
    a64_add_rrr(&mut ctx.text, rd, A64::FP, A64::X15)
  end
end

# Compare a register against an arbitrary 64-bit immediate (the aarch64
# cmp-immediate encodings only cover positive 12/24-bit patterns; every
# other value is materialized into a reserved scratch register first).
def lir_emit_cmp_imm(inout ctx: CodegenCtx, r: A64, imm: Int) -> Unit
  if imm >= 0 && imm <= 4294967295 then
    a64_cmp_ri(&mut ctx.text, r, imm as u32)
  else
    let scratch = if r == A64::X16 then A64::X17 else A64::X16 end
    a64_mov_ri(&mut ctx.text, scratch, imm)
    a64_cmp_rr(&mut ctx.text, r, scratch)
  end
end

# The destination target of a def at position `pos`: either the segment
# register or the X16 temp with a pending slot store.
struct LirDefTarget
  reg: A64
  store_slot: Int   # >= 0: store reg to this slot after the def
end

def lir_def_target(alloc: LirAlloc, vreg: Int, pos: Int) -> LirDefTarget
  if vreg < lir_first_alloc_vreg() then
    # Fixed ABI vregs (argument moves): the register IS the target.
    return LirDefTarget { reg: lir_reg_a64(vreg), store_slot: -1 }
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        LirDefTarget { reg: lir_reg_a64(s.phys), store_slot: -1 }
      else
        LirDefTarget { reg: A64::X16, store_slot: s.slot }
      end
    when Option::None then
      panic("lir: def outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    # Never-occurring vreg (e.g. an unused parameter's bind still emits).
    LirDefTarget { reg: A64::X16, store_slot: -1 }
  end
end

# Materialize the value of `vreg` at position `pos` into a register,
# choosing `pref` (normally X16) when a spill load is needed; a reload
# record at (pos, vreg) loads the slot into the segment register first
# (invariant I2). Returns the register holding the value.
def lir_emit_use(inout ctx: CodegenCtx, alloc: LirAlloc, vreg: Int, pos: Int, pref: A64) -> A64
  if vreg < lir_first_alloc_vreg() then
    return lir_reg_a64(vreg)
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        if lir_reload_at(alloc.reloads, pos, vreg) then
          lir_emit_slot_load(ctx, lir_reg_a64(s.phys), s.slot)
        end
        lir_reg_a64(s.phys)
      else
        lir_emit_slot_load(ctx, pref, s.slot)
        pref
      end
    when Option::None then
      panic("lir: use outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    panic("lir: use of vreg with no intervals: " + vreg.to_string())
  end
end

# Emit a spill store for a register-resident pre-call segment whose end
# precedes the call at `pos` (invariant I2). A FLOAT-class vreg stores
# through the FP slot machinery at its width (alloc.fp_widths — the
# class table); a general vreg keeps the X-register store.
def lir_emit_call_spills(inout ctx: CodegenCtx, alloc: LirAlloc, pos: Int) -> Unit
  var i = 0
  while i < alloc.spills.len() do
    if alloc.spills[i].0 == pos then
      let vreg = alloc.spills[i].1
      match alloc.segs_of.get(vreg)
      when Option::Some(segs) then
        match lir_seg_at(segs, pos - 1)
        when Option::Some(s) then
          if s.phys >= 0 && s.slot >= 0 then
            match alloc.fp_widths.get(vreg)
            when Option::Some(w) then
              lir_emit_slot_fp_store(ctx, lir_fp_reg_of_phys(s.phys), w, s.slot)
            when Option::None then
              lir_emit_slot_store(ctx, lir_reg_a64(s.phys), s.slot)
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
    i = i + 1
  end
end

# A register-register binop.
def lir_emit_binop_rr(inout ctx: CodegenCtx, op: LirBinOp, d: A64, n: A64, m: A64) -> Unit
  match op
  when LirBinOp::LirAdd then a64_add_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirSub then a64_sub_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirMul then a64_mul_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirAnd then a64_and_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirOr then a64_orr_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirXor then a64_eor_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirShl then a64_lsl_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirAsr then a64_asr_rrr(&mut ctx.text, d, n, m)
  when LirBinOp::LirLsr then a64_lsr_rrr(&mut ctx.text, d, n, m)
  end
end

# The X16/X17 instruction temp used to materialize a binop immediate:
# the choice must avoid the left operand register `n` — a spill-loaded
# left occupies X16 (or X17 when the def temp is X16), and materializing
# over it would destroy the value before the op reads it. Choosing X16
# whenever n is not X16 is safe even when that IS the destination d: the
# single op reads n and the materialized immediate before writing d, and
# a d == X16 memory-resident def stores only after the op completes.
def lir_imm_scratch(n: A64) -> A64
  if n == A64::X16 then A64::X17 else A64::X16 end
end

# Emit an add/sub of an immediate (the only aarch64 binop encodings with
# a 12-bit immediate form); everything else materializes the immediate
# into the reserved X16/X17 scratch first. Exception — the zero-register
# exploitation form (P2): a second operand of constant 0 never needs
# materialization for add/sub/and/orr/xor. Those five register forms are
# emitted with the second source = XZR (reg 31; the a64_*_rrr encoders
# treat reg 31 as XZR, NOT SP — see the asm.tg note on a64_sub_rrr, and
# the neg/mvn encoders already use XZR as an operand). All five are
# non-flag-setting (non-S) forms, so invariant I1's flag discipline is
# untouched. LirMul keeps the scratch path even for imm == 0 (out of the
# form's scope; see the LirMul note in the fallback arm).
def lir_emit_binop_imm(inout ctx: CodegenCtx, op: LirBinOp, d: A64, n: A64, imm: Int) -> Unit
  match op
  when LirBinOp::LirAdd then
    if imm == 0 then
      a64_add_rrr(&mut ctx.text, d, n, A64::XZR)
    elsif imm > 0 && imm <= 4095 then
      a64_add_rri(&mut ctx.text, d, n, imm as u32)
    elsif imm < 0 && imm >= -4095 then
      a64_sub_rri(&mut ctx.text, d, n, (-imm) as u32)
    else
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      a64_add_rrr(&mut ctx.text, d, n, scratch)
    end
  when LirBinOp::LirSub then
    if imm == 0 then
      a64_sub_rrr(&mut ctx.text, d, n, A64::XZR)
    elsif imm > 0 && imm <= 4095 then
      a64_sub_rri(&mut ctx.text, d, n, imm as u32)
    elsif imm < 0 && imm >= -4095 then
      a64_add_rri(&mut ctx.text, d, n, (-imm) as u32)
    else
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      a64_sub_rrr(&mut ctx.text, d, n, scratch)
    end
  when LirBinOp::LirShl then
    if imm >= 0 && imm <= 63 then
      a64_lsl(&mut ctx.text, d, n, imm as u32)
    else
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      a64_lsl_rrr(&mut ctx.text, d, n, scratch)
    end
  when LirBinOp::LirAsr then
    if imm >= 0 && imm <= 63 then
      a64_asr(&mut ctx.text, d, n, imm as u32)
    else
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      a64_asr_rrr(&mut ctx.text, d, n, scratch)
    end
  when LirBinOp::LirLsr then
    if imm >= 0 && imm <= 63 then
      a64_lsr(&mut ctx.text, d, n, imm as u32)
    else
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      a64_lsr_rrr(&mut ctx.text, d, n, scratch)
    end
  when _ then
    # Logical ops AND/ORR/XOR of the constant 0 (the ops this arm
    # receives with no 12-bit immediate encoding of their own): emit the
    # register form with XZR — `and xd, xn, xzr` zeroes, `orr`/`eor`
    # copy xn — dropping the movz-into-scratch the fallback would emit.
    if imm == 0 && (op == LirBinOp::LirAnd || op == LirBinOp::LirOr || op == LirBinOp::LirXor) then
      match op
      when LirBinOp::LirAnd then a64_and_rrr(&mut ctx.text, d, n, A64::XZR)
      when LirBinOp::LirOr then a64_orr_rrr(&mut ctx.text, d, n, A64::XZR)
      when LirBinOp::LirXor then a64_eor_rrr(&mut ctx.text, d, n, A64::XZR)
      end
    else
      # LirMul and any future op — including a multiply by the constant
      # 0 (a64_mul_rrr would accept XZR there too, but MUL is outside
      # the zero-register form's add/sub/and/orr/xor scope): keep the
      # movz-into-scratch materialization unchanged.
      let scratch = lir_imm_scratch(n)
      a64_mov_ri(&mut ctx.text, scratch, imm)
      lir_emit_binop_rr(ctx, op, d, n, scratch)
    end
  end
end

# An aarch64-slice division (a LirStmt.div marker): SDIV/UDIV d = n / m.
# Never flag-setting, so invariant I1's flag discipline is untouched.
def lir_emit_div_rr(inout ctx: CodegenCtx, op: LirDivOp, d: A64, n: A64, m: A64) -> Unit
  match op
  when LirDivOp::LirSdiv then a64_sdiv_rrr(&mut ctx.text, d, n, m)
  when LirDivOp::LirUdiv then a64_udiv(&mut ctx.text, d, n, m)
  end
end

# Emit one statement at position `pos`.
# ———————————————————————————————————————————————————————————————
# aarch64 emission — the marked pointer/atomic statements (LirPtrOp)
# ———————————————————————————————————————————————————————————————
# The aarch64-only arms of the marked pointer/atomic statements (see
# LirStmt.ptr / LirPtrOp). All are flag-neutral (invariant I1) and
# call-free; each uses only the X16/X17 instruction temporaries and
# the reserved X15 address scratch around its own memory access (the
# slot loads/stores of the def/use resolution may transiently use X15
# — nothing live ever rides X15 between this statement's own
# instructions). The register discipline of the LSE statements keeps
# the address (Xn), the value (Xs) and the result (Rt) registers
# PAIRWISE DISTINCT: the ARM ARM makes register aliasing of the LSE
# forms CONSTRAINED UNPREDICTABLE (the codegen.tg RMW note: "Avoid Wt
# aliasing Xn"). The allocator already keeps every distinct vreg's
# live segments in distinct physical registers, so the resolutions
# below only need to route the SPILL LOADS into distinct temps: the
# def target (dt) is avoided first, then the other resolved registers.

# A spill-load preference register for a marked statement's first
# source: X16 unless the def target already uses it (a memory-resident
# def writes X16), then X17. Register-resident sources ignore the
# preference (their segment registers are pool registers, never
# X16/X17/X15).
def lir_ptr_pref1(dt: A64) -> A64
  if dt == A64::X16 then A64::X17 else A64::X16 end
end

# A spill-load preference for a marked statement's SECOND source,
# avoiding the def target AND the first resolved register: the first
# free of X16/X17/X15 (X15 only when both temps are taken).
def lir_ptr_pref2(dt: A64, r1: A64) -> A64
  if dt != A64::X16 && r1 != A64::X16 then
    A64::X16
  elsif dt != A64::X17 && r1 != A64::X17 then
    A64::X17
  else
    A64::X15
  end
end

# A sized (1/2/4/8-byte) memory access [base + off] for the
# deref/atomic forms: the 8-byte accesses go through lir_emit_mem8
# (its full offset strategy); the narrow accesses mirror the codegen.tg
# sized-memory rule — the aarch64 narrow load/store encodings take an
# unsigned scaled immediate, so a nonzero offset materializes the
# effective address in the reserved X15 first and accesses at offset 0
# (X15 is free here: it is never a def target, and the source
# resolutions above never place a live value in it — when a spill load
# DID need X15 as its temp, the store below has already consumed it).
# Sign extension applies to the narrow SIGNED loads (the codegen
# lsl/asr/sxtw mirror) — the loaded value zero-extends into the
# destination register otherwise.
def lir_emit_sized_mem(inout ctx: CodegenCtx, val_reg: A64, base: A64, off: Int, w: Int, is_load: Bool, sign: Bool) -> Unit
  let size = lir_atomic_size_code(w)
  if size == 3 then
    lir_emit_mem8(ctx, val_reg, base, off, is_load)
  else
    var ab = base
    var aoff = off
    if off != 0 then
      a64_mov_ri(&mut ctx.text, A64::X15, off)
      a64_add_rrr(&mut ctx.text, A64::X15, base, A64::X15)
      ab = A64::X15
      aoff = 0
    end
    if is_load then
      match w
      when 1 then a64_ldrb(&mut ctx.text, val_reg, ab, aoff as u32)
      when 2 then a64_ldrh(&mut ctx.text, val_reg, ab, aoff as u32)
      when 4 then a64_ldr_w(&mut ctx.text, val_reg, ab, aoff as u32)
      end
      if sign then
        match w
        when 1 then
          a64_lsl(&mut ctx.text, val_reg, val_reg, 56)
          a64_mov_ri(&mut ctx.text, A64::X15, 56)
          a64_asr_rrr(&mut ctx.text, val_reg, val_reg, A64::X15)
        when 2 then
          a64_lsl(&mut ctx.text, val_reg, val_reg, 48)
          a64_mov_ri(&mut ctx.text, A64::X15, 48)
          a64_asr_rrr(&mut ctx.text, val_reg, val_reg, A64::X15)
        when 4 then a64_sxtw(&mut ctx.text, val_reg, val_reg)
        end
      end
    else
      match w
      when 1 then a64_strb(&mut ctx.text, val_reg, ab, aoff as u32)
      when 2 then a64_strh(&mut ctx.text, val_reg, ab, aoff as u32)
      when 4 then a64_str_w(&mut ctx.text, val_reg, ab, aoff as u32)
      end
    end
  end
end

# The marked LSE opcode emitter: family (0 = LDADD, 1 = LDCLR,
# 2 = LDSET, 3 = LDEOR, 4 = SWP) x form (0 = plain, 1 = +A, 2 = +L,
# 3 = +AL) -> the asm.tg encoder with the statement's size code.
def lir_emit_lse_op(inout ctx: CodegenCtx, family: Int, form: Int, size: u32, s: A64, t: A64, n: A64) -> Unit
  match family
  when 0 then
    match form
    when 0 then a64_ldadd(&mut ctx.text, s, t, n, size)
    when 1 then a64_ldadda(&mut ctx.text, s, t, n, size)
    when 2 then a64_ldaddl(&mut ctx.text, s, t, n, size)
    when 3 then a64_ldaddal(&mut ctx.text, s, t, n, size)
    end
  when 1 then
    match form
    when 0 then a64_ldclr(&mut ctx.text, s, t, n, size)
    when 1 then a64_ldclra(&mut ctx.text, s, t, n, size)
    when 2 then a64_ldclrl(&mut ctx.text, s, t, n, size)
    when 3 then a64_ldclral(&mut ctx.text, s, t, n, size)
    end
  when 2 then
    match form
    when 0 then a64_ldset(&mut ctx.text, s, t, n, size)
    when 1 then a64_ldseta(&mut ctx.text, s, t, n, size)
    when 2 then a64_ldsetl(&mut ctx.text, s, t, n, size)
    when 3 then a64_ldsetal(&mut ctx.text, s, t, n, size)
    end
  when 3 then
    match form
    when 0 then a64_ldeor(&mut ctx.text, s, t, n, size)
    when 1 then a64_ldeora(&mut ctx.text, s, t, n, size)
    when 2 then a64_ldeorl(&mut ctx.text, s, t, n, size)
    when 3 then a64_ldeoral(&mut ctx.text, s, t, n, size)
    end
  when 4 then
    match form
    when 0 then a64_swp(&mut ctx.text, s, t, n, size)
    when 1 then a64_swpa(&mut ctx.text, s, t, n, size)
    when 2 then a64_swpl(&mut ctx.text, s, t, n, size)
    when 3 then a64_swpal(&mut ctx.text, s, t, n, size)
    end
  end
end

# Emit the MARKED pointer/atomic statement at position `pos` (the
# aarch64-only arms of lir_emit_fn's statement loop — never the
# nominal kind's semantics). See LirPtrOp for the per-variant
# semantics; every def resolves through lir_def_target (register or
# X16 + slot store) and every use through lir_emit_use.
def lir_emit_ptr_stmt(inout ctx: CodegenCtx, alloc: LirAlloc, pop: LirPtrOp, pos: Int) -> Unit
  match pop
  when LirPtrOp::LirPtrLea(dst, off) then
    # dst = FP + off (the address of the fixed frame slot `off` —
    # always negative; the lea handles the full range via X15).
    let dt = lir_def_target(alloc, dst, pos)
    lir_emit_lea_fp(ctx, dt.reg, off)
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirPtrAddr(dst, base, off) then
    # dst = base + off (an address inside a pointed-to image; the off
    # is a positive byte offset).
    let dt = lir_def_target(alloc, dst, pos)
    let br = lir_emit_use(ctx, alloc, base, pos, lir_ptr_pref1(dt.reg))
    if off >= 0 && off < 4096 then
      a64_add_rri(&mut ctx.text, dt.reg, br, off as u32)
    else
      a64_mov_ri(&mut ctx.text, A64::X15, off)
      a64_add_rrr(&mut ctx.text, dt.reg, br, A64::X15)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirPtrLoad(dst, base, off, w, sign) then
    # dst = load(base + off) at storage width w.
    let dt = lir_def_target(alloc, dst, pos)
    let br = lir_emit_use(ctx, alloc, base, pos, lir_ptr_pref1(dt.reg))
    lir_emit_sized_mem(ctx, dt.reg, br, off, w, true, sign)
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirPtrStore(base, off, src, w) then
    # store(base + off) = src at storage width w (the value's low w
    # bytes; both sources stay live to the store, so two spill loads
    # take two distinct temps).
    let sv = lir_emit_use(ctx, alloc, src, pos, A64::X16)
    let bv = lir_emit_use(ctx, alloc, base, pos, lir_ptr_pref2(A64::X16, sv))
    lir_emit_sized_mem(ctx, sv, bv, off, w, false, false)
  when LirPtrOp::LirAtomLoad(form, w, dst, addr) then
    # One arm of the per-ordering atomic load: dst = load(addr),
    # form 0 = the plain LDR width form, form 1 = LDAR.
    let dt = lir_def_target(alloc, dst, pos)
    let ar = lir_emit_use(ctx, alloc, addr, pos, lir_ptr_pref1(dt.reg))
    if form == 0 then
      lir_emit_sized_mem(ctx, dt.reg, ar, 0, w, true, false)
    else
      a64_ldar(&mut ctx.text, dt.reg, ar, lir_atomic_size_code(w))
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirAtomStore(form, w, addr, val) then
    # One arm of the per-ordering atomic store: store(addr) = val,
    # form 0 = plain STR, form 1 = STLR (val/addr kept distinct).
    let sv = lir_emit_use(ctx, alloc, val, pos, A64::X16)
    let ar = lir_emit_use(ctx, alloc, addr, pos, lir_ptr_pref2(A64::X16, sv))
    if form == 0 then
      lir_emit_sized_mem(ctx, sv, ar, 0, w, false, false)
    else
      a64_stlr(&mut ctx.text, sv, ar, lir_atomic_size_code(w))
    end
  when LirPtrOp::LirAtomRmw(family, form, w, dst, addr, val) then
    # One arm of the per-ordering LSE RMW/exchange: Rt(dst) <- the old
    # [addr] word of the family op with the value operand. Register
    # discipline: Xs (value), Rt (result), Xn (addr) pairwise distinct
    # (CONSTRAINED UNPREDICTABLE on aliasing — see asm.tg's LSE note).
    let dt = lir_def_target(alloc, dst, pos)
    # The value (Xs): when the destination and the value are the SAME
    # vreg (MIR storage reuse could make the result local the value
    # local), the value must move into a temp first — the instruction
    # would otherwise alias Xs with Rt.
    var sv = A64::X16
    if dst == val then
      let r = lir_emit_use(ctx, alloc, val, pos, lir_ptr_pref1(dt.reg))
      if r != A64::X16 && r != A64::X17 && r != A64::X15 then
        let tp = lir_ptr_pref1(dt.reg)
        a64_mov_rr(&mut ctx.text, tp, r)
        sv = tp
      else
        sv = r
      end
    else
      sv = lir_emit_use(ctx, alloc, val, pos, lir_ptr_pref1(dt.reg))
    end
    let ar = lir_emit_use(ctx, alloc, addr, pos, lir_ptr_pref2(dt.reg, sv))
    lir_emit_lse_op(ctx, family, form, lir_atomic_size_code(w), sv, dt.reg, ar)
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirAtomCas(form, w, dst, exp, des, addr) then
    # One arm of the per-ordering CAS: Xs (the CAS's compare/in-out
    # register — the original [addr] word lands there) resolves to the
    # def target; the EXPECTED word is loaded into it first (the
    # expected vreg's own register is never touched, so the merge
    # tail's compare reads the preserved expected copy). Xt (desired)
    # and Xn (addr) resolve into registers distinct from Xs and each
    # other.
    let dt = lir_def_target(alloc, dst, pos)
    # The expected word into the def target: a spill load prefers the
    # def temp when it is X16 (the read happens before the write-back)
    # and loads straight into the segment register otherwise.
    let e_pref = if dt.reg == A64::X16 then A64::X16 else dt.reg end
    let er = lir_emit_use(ctx, alloc, exp, pos, e_pref)
    if er != dt.reg then
      a64_mov_rr(&mut ctx.text, dt.reg, er)
    end
    let tr = lir_emit_use(ctx, alloc, des, pos, lir_ptr_pref2(dt.reg, er))
    let ar = lir_emit_use(ctx, alloc, addr, pos, lir_ptr_pref2(dt.reg, tr))
    match form
    when 0 then a64_cas(&mut ctx.text, dt.reg, tr, ar, lir_atomic_size_code(w))
    when 1 then a64_casa(&mut ctx.text, dt.reg, tr, ar, lir_atomic_size_code(w))
    when 2 then a64_casl(&mut ctx.text, dt.reg, tr, ar, lir_atomic_size_code(w))
    when 3 then a64_casal(&mut ctx.text, dt.reg, tr, ar, lir_atomic_size_code(w))
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirPtrOp::LirPtrFence(form) then
    # One arm of the per-ordering fence: form 0 = the Acquire DMB ISHLD
    # (the load-acquire barrier), form 1 = the full DMB ISH
    # (Release/AcqRel/SeqCst — the codegen fence arm's instruction;
    # Relaxed never constructs a statement). No defs or uses — the
    # statement is a pure instruction side effect, flag-neutral
    # (invariant I1) and call-free.
    match form
    when 0 then a64_dmb_ishld(&mut ctx.text)
    when 1 then a64_dmb_ish(&mut ctx.text)
    end
  end
end

# Emit a marked register-class BIT-MOVE statement (LirStmt.bm — see
# LirBitMoveOp): the carrier is the LirUnop shape (def dst, use src),
# and the width resolves from the FP-class record of the FP side.
#   LirBitsGpToFp (int word -> float): the GP value materializes in
#     X16 (free at FP statements) and moves into the FP def target —
#     FMOV Dd, Xn for F64 (the full 64-bit pattern) and FMOV Sd, Wn
#     for F32 (the source word's low 32 bits — the F32 canonical
#     single image; the S-form never reads the word's upper bits). A
#     memory-resident FP def stores its slot at the width, exactly
#     like any FP def.
#   LirBitsFpToGp (float -> int word): the FP value materializes in
#     the FP load temp (V30/V31 by the def-target convention) and
#     moves into the GP def target — FMOV Xd, Dn for F64 and FMOV Wd,
#     Sn for F32 (the W form ZERO-EXTENDS the single's 32 bits into
#     the 64-bit word — the width model's canonical narrow word; the
#     D register's upper half is never observed, so the 32-bit form
#     is the only sound F32 read-back). A memory-resident GP def
#     stores its full word afterwards.
def lir_emit_bitmove_stmt(inout ctx: CodegenCtx, alloc: LirAlloc, stmt: LirStmt, pos: Int) -> Unit
  match stmt.bm
  when Option::Some(bm) then
    match stmt.kind
    when LirStmtKind::LirUnop(_, dst, src) then
      match bm
      when LirBitMoveOp::LirBitsGpToFp then
        let w = match lir_alloc_fp_width_of(alloc, dst)
        when Option::Some(v) then v
        when Option::None then panic("lir: GP->FP bit move into a vreg with no FP class record (lowering invariant)")
        end
        let sr = lir_emit_use(ctx, alloc, src, pos, A64::X16)
        let dt = lir_fp_def_target(alloc, dst, pos)
        match w
        when LirFpWidth::LirF32 then a64_fmov_sw(&mut ctx.text, dt.reg, sr)
        when LirFpWidth::LirF64 then a64_fmov_dx(&mut ctx.text, dt.reg, sr)
        end
        if dt.store_slot >= 0 then
          lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
        end
      when LirBitMoveOp::LirBitsFpToGp then
        let w = match lir_alloc_fp_width_of(alloc, src)
        when Option::Some(v) then v
        when Option::None then panic("lir: FP->GP bit move from a vreg with no FP class record (lowering invariant)")
        end
        let sr = lir_fp_emit_use(ctx, alloc, src, pos, w, lir_fp_use_temp())
        let dt = lir_def_target(alloc, dst, pos)
        match w
        when LirFpWidth::LirF32 then a64_fmov_ws(&mut ctx.text, dt.reg, sr)
        when LirFpWidth::LirF64 then a64_fmov_xd(&mut ctx.text, dt.reg, sr)
        end
        if dt.store_slot >= 0 then
          lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
        end
      end
    when _ then panic("lir: bit-move marker on a non-LirUnop carrier (lowering invariant)")
    end
  when Option::None then panic("lir: bit-move emitter on an unmarked statement (internal error)")
  end
end

def lir_emit_stmt(inout ctx: CodegenCtx, alloc: LirAlloc, stmt: LirStmt, pos: Int) -> Unit
  match stmt.kind
  when LirStmtKind::LirMove(dst, val) then
    # A fixed FLOAT ABI dst (8..15) is written only by the float
    # statement shapes (LirFMove); a general move into one would
    # silently target the X-file register of the same id.
    if lir_is_fixed_fp_id(dst) then
      panic("lir: general move into a fixed float ABI vreg (lowering invariant — float arguments move through LirFMove)")
    end
    let dt = lir_def_target(alloc, dst, pos)
    match val
    when LirValue::LirImm(imm) then
      if imm == 0 then
        # Constant-zero Move (zero-register form P2): pin the cheapest
        # zero materialization — the single `movz xd, #0` (a64_mov_ri
        # would emit exactly this encoding for 0, its movk lanes being
        # skipped; the branch states the selection explicitly).
        a64_movz(&mut ctx.text, dt.reg, 0, 0)
      else
        a64_mov_ri(&mut ctx.text, dt.reg, imm)
      end
    when LirValue::LirReg(src) then
      if src < lir_first_alloc_vreg() then
        let sr = lir_reg_a64(src)
        if dt.reg != sr then
          a64_mov_rr(&mut ctx.text, dt.reg, sr)
        end
      else
        let pref = if dt.reg == A64::X16 then A64::X17 else A64::X16 end
        let sr = lir_emit_use(ctx, alloc, src, pos, pref)
        if dt.reg != sr then
          a64_mov_rr(&mut ctx.text, dt.reg, sr)
        end
      end
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirBinop(op, dst, left, right) then
    let dt = lir_def_target(alloc, dst, pos)
    let left_pref = if dt.reg == A64::X16 then A64::X17 else A64::X16 end
    let left_reg = match left
    when LirValue::LirReg(lv) then lir_emit_use(ctx, alloc, lv, pos, left_pref)
    when LirValue::LirImm(_) then panic("lir: binop left operand must be a register (lowering invariant)")
    end
    match right
    when LirValue::LirImm(imm) then
      # A division marker always carries register operands (lowering
      # materializes the divisor) — an immediate divisor is a lowering bug.
      var is_div = false
      match stmt.div
      when Option::Some(_) then is_div = true
      when Option::None then ()
      end
      if is_div then
        panic("lir: division statement with an immediate divisor (lowering invariant)")
      end
      lir_emit_binop_imm(ctx, op, dt.reg, left_reg, imm)
    when LirValue::LirReg(rv) then
      # A register right operand: resolve it with a temp that avoids the
      # left temp (they only collide when both spill-load; a single
      # instruction reads both before writing dt, so a dst-temp reuse is
      # safe by read-before-write).
      let right_pref = if left_reg == A64::X16 then A64::X17 else A64::X16 end
      let right_reg = lir_emit_use(ctx, alloc, rv, pos, right_pref)
      match stmt.div
      when Option::Some(dop) then lir_emit_div_rr(ctx, dop, dt.reg, left_reg, right_reg)
      when Option::None then lir_emit_binop_rr(ctx, op, dt.reg, left_reg, right_reg)
      end
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirUnop(op, dst, src) then
    let dt = lir_def_target(alloc, dst, pos)
    let pref = if dt.reg == A64::X16 then A64::X17 else A64::X16 end
    let sr = lir_emit_use(ctx, alloc, src, pos, pref)
    match op
    when LirUnOp::LirNeg then a64_neg(&mut ctx.text, dt.reg, sr)
    when LirUnOp::LirBitNot then a64_mvn(&mut ctx.text, dt.reg, sr)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirCmp(left, right) then
    let left_reg = match left
    when LirValue::LirReg(lv) then lir_emit_use(ctx, alloc, lv, pos, A64::X16)
    when LirValue::LirImm(_) then panic("lir: cmp left operand must be a register (lowering invariant)")
    end
    match right
    when LirValue::LirImm(imm) then
      lir_emit_cmp_imm(ctx, left_reg, imm)
    when LirValue::LirReg(rv) then
      let right_pref = if left_reg == A64::X16 then A64::X17 else A64::X16 end
      let right_reg = lir_emit_use(ctx, alloc, rv, pos, right_pref)
      a64_cmp_rr(&mut ctx.text, left_reg, right_reg)
    end
  when LirStmtKind::LirCset(cond, dst) then
    let dt = lir_def_target(alloc, dst, pos)
    a64_cset(&mut ctx.text, dt.reg, lir_cond_code(cond))
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirLoadFrame(dst, off) then
    match alloc.fp_widths.get(dst)
    when Option::Some(w) then
      # A FLOAT stack-parameter bind: load the caller word at width w
      # ([FP + 16 + 16*stk] on the aarch64 mode — the walk's shared
      # stream — into the parameter's FP vreg).
      let fdt = lir_fp_def_target(alloc, dst, pos)
      lir_emit_fp_mem8(ctx, fdt.reg, w, A64::FP, off, true)
      if fdt.store_slot >= 0 then
        lir_emit_slot_fp_store(ctx, fdt.reg, w, fdt.store_slot)
      end
    when Option::None then
      let dt = lir_def_target(alloc, dst, pos)
      lir_emit_mem8(ctx, dt.reg, A64::FP, off, true)
      if dt.store_slot >= 0 then
        lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
      end
    end
  when LirStmtKind::LirStaticLoad(dst, sym) then
    # The static-value load (see the statement doc): materialize the
    # symbol's address with the direct emitter's emit_lea_label pair —
    # ADRP (R_AARCH64_ADR_PREL_PG_HI21) + ADD (R_AARCH64_ADD_ABS_LO12_NC),
    # both against the static's .data/.bss symbol — then load the
    # 8-byte machine word at [addr]. The relocation record precedes
    # each instruction word, so the recorded offset points at the
    # instruction being relocated (the add_reloc/emit ordering of
    # codegen.tg's emit_lea_label); the object writers and the internal
    # linker resolve the pair against the data symbol exactly like the
    # direct emitter's ADRP/ADD uses (_tg_saved_argc and the runtime
    # string loads). The def temp (X16 for memory-resident defs) may be
    # the ADRP/ADD destination: the load reads [X16] after the address
    # is complete, so the def-target alias is safe.
    if lir_is_fixed_fp_id(dst) then
      panic("lir: static load into a fixed float ABI vreg (lowering invariant — float values never ride LirStaticLoad)")
    end
    let dt = lir_def_target(alloc, dst, pos)
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADR_PREL_PG_HI21, sym.clone(), 0)
    emit32_le(&mut ctx.text, 0x90000000 | a64_code(dt.reg))
    add_reloc(&mut ctx.text, RelocKind::R_AARCH64_ADD_ABS_LO12_NC, sym.clone(), 0)
    a64_add_rri(&mut ctx.text, dt.reg, dt.reg, 0)
    a64_ldr(&mut ctx.text, dt.reg, dt.reg, 0)
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirPushArg(vreg) then
    match alloc.fp_widths.get(vreg)
    when Option::Some(w) then
      # A FLOAT caller-stack argument: reserve one 16-byte aligned
      # caller slot below SP and store the value at its width into the
      # slot's base ([SP - 16]) — the callee's entry bind reads the
      # same base at the same width. (Only the aarch64 route lowers
      # float stack ARGUMENTS today — its 16-byte caller slots; the
      # cortex-m route's float-stack-argument pushes are the next
      # slice, whose callee side has bound float stack parameters
      # since the float-ABI slice.)
      let sr = lir_fp_emit_use(ctx, alloc, vreg, pos, w, lir_fp_use_temp())
      match w
      when LirFpWidth::LirF32 then a64_stur_s(&mut ctx.text, sr, A64::SP, -16)
      when LirFpWidth::LirF64 then a64_stur_d(&mut ctx.text, sr, A64::SP, -16)
      end
      a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 16)
    when Option::None then
      let sr = lir_emit_use(ctx, alloc, vreg, pos, A64::X16)
      # Reserve one 16-byte aligned caller slot below SP and store the
      # value into it (the codegen.tg emit_push convention on aarch64).
      a64_stur(&mut ctx.text, sr, A64::SP, -16)
      a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, 16)
    end
  when LirStmtKind::LirFMove(dst, src) then
    # FP register move. The width comes from the FP class record of the
    # ordinary operand: the fixed ABI ids (8..15) carry no record, so a
    # move whose dst is fixed (a float call-argument move) reads the
    # width of src and a move whose src is fixed (a float parameter
    # bind) reads the width of dst; moves between two ordinary vregs
    # share one width (typed float moves never cross widths — a width
    # change is an explicit LirFcvt).
    let w = match lir_alloc_fp_width_of(alloc, dst)
    when Option::Some(dw) then dw
    when Option::None then
      match lir_alloc_fp_width_of(alloc, src)
      when Option::Some(sw) then sw
      when Option::None then
        panic("lir: LirFMove between two fixed FP vregs (lowering invariant)")
      end
    end
    let dt = lir_fp_def_target(alloc, dst, pos)
    let pref = lir_fp_first_pref(dt.reg)
    let sr = lir_fp_emit_use(ctx, alloc, src, pos, w, pref)
    if dt.reg != sr then
      lir_fp_mov_rr(ctx, w, dt.reg, sr)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
    end
  when LirStmtKind::LirFBinop(fop, w, dst, left, right) then
    let dt = lir_fp_def_target(alloc, dst, pos)
    let left_pref = lir_fp_first_pref(dt.reg)
    let left_reg = lir_fp_emit_use(ctx, alloc, left, pos, w, left_pref)
    let right_pref = lir_fp_second_pref(left_reg)
    let right_reg = lir_fp_emit_use(ctx, alloc, right, pos, w, right_pref)
    match fop
    when LirFpBinOp::LirFAdd then
      match w
      when LirFpWidth::LirF32 then a64_fadd_sss(&mut ctx.text, dt.reg, left_reg, right_reg)
      when LirFpWidth::LirF64 then a64_fadd_ddd(&mut ctx.text, dt.reg, left_reg, right_reg)
      end
    when LirFpBinOp::LirFSub then
      match w
      when LirFpWidth::LirF32 then a64_fsub_sss(&mut ctx.text, dt.reg, left_reg, right_reg)
      when LirFpWidth::LirF64 then a64_fsub_ddd(&mut ctx.text, dt.reg, left_reg, right_reg)
      end
    when LirFpBinOp::LirFMul then
      match w
      when LirFpWidth::LirF32 then a64_fmul_sss(&mut ctx.text, dt.reg, left_reg, right_reg)
      when LirFpWidth::LirF64 then a64_fmul_ddd(&mut ctx.text, dt.reg, left_reg, right_reg)
      end
    when LirFpBinOp::LirFDiv then
      match w
      when LirFpWidth::LirF32 then a64_fdiv_sss(&mut ctx.text, dt.reg, left_reg, right_reg)
      when LirFpWidth::LirF64 then a64_fdiv_ddd(&mut ctx.text, dt.reg, left_reg, right_reg)
      end
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
    end
  when LirStmtKind::LirFNeg(w, dst, src) then
    let dt = lir_fp_def_target(alloc, dst, pos)
    let pref = lir_fp_first_pref(dt.reg)
    let sr = lir_fp_emit_use(ctx, alloc, src, pos, w, pref)
    match w
    when LirFpWidth::LirF32 then a64_fneg_ss(&mut ctx.text, dt.reg, sr)
    when LirFpWidth::LirF64 then a64_fneg_dd(&mut ctx.text, dt.reg, sr)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
    end
  when LirStmtKind::LirFCmp(w, left, right) then
    # Writes NZCV like LirCmp (invariant I1): only flag-neutral code
    # may separate it from its LirCset consumer, and the allocator
    # inserts none.
    let left_reg = lir_fp_emit_use(ctx, alloc, left, pos, w, lir_fp_use_temp())
    let right_pref = lir_fp_second_pref(left_reg)
    let right_reg = lir_fp_emit_use(ctx, alloc, right, pos, w, right_pref)
    match w
    when LirFpWidth::LirF32 then a64_fcmp_ss(&mut ctx.text, left_reg, right_reg)
    when LirFpWidth::LirF64 then a64_fcmp_dd(&mut ctx.text, left_reg, right_reg)
    end
  when LirStmtKind::LirFConst(w, dst, bits) then
    # Materialize the constant's bits (codegen.tg's MirFloat rule:
    # mov the 64-bit pattern into a general register, then move it
    # into the FP file). F64: fmov d{dst}, x16. F32: the bits are the
    # HOST DOUBLE pattern of the literal (MirFloat carries doubles),
    # so the emission first moves them into the FP scratch d{V31} and
    # rounds to the canonical single with fcvt s{dst}, d{V31} — the
    # single rounding every F32 constant receives (the compiler
    # performs no host-side float math; the default FPCR RNE is the
    # same rounding all F32 arithmetic applies). X16 is the GP
    # instruction temp — free at FP statements — and V31 the FP
    # scratch; the memory-resident def target V30 is never needed
    # before the rounding completes.
    let dt = lir_fp_def_target(alloc, dst, pos)
    a64_mov_ri(&mut ctx.text, A64::X16, bits)
    match w
    when LirFpWidth::LirF32 then
      a64_fmov_dx(&mut ctx.text, lir_fp_use_temp(), A64::X16)
      a64_fcvt_sd(&mut ctx.text, dt.reg, lir_fp_use_temp())
    when LirFpWidth::LirF64 then
      a64_fmov_dx(&mut ctx.text, dt.reg, A64::X16)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
    end
  when LirStmtKind::LirIntToFloat(w, dst, src, unsigned) then
    # SCVTF/UCVTF (signed/unsigned 64-bit integer word -> float at the
    # statement's width; codegen.tg's IntToFloat aarch64 rule with the
    # width-correct S/D forms).
    let dt = lir_fp_def_target(alloc, dst, pos)
    let sr = lir_emit_use(ctx, alloc, src, pos, A64::X16)
    match w
    when LirFpWidth::LirF32 then
      if unsigned then
        a64_ucvtf_sx(&mut ctx.text, dt.reg, sr)
      else
        a64_scvtf_sx(&mut ctx.text, dt.reg, sr)
      end
    when LirFpWidth::LirF64 then
      if unsigned then
        a64_ucvtf_dx(&mut ctx.text, dt.reg, sr)
      else
        a64_scvtf_dx(&mut ctx.text, dt.reg, sr)
      end
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
    end
  when LirStmtKind::LirFloatToInt(w, dst, src) then
    # FCVTZS (float -> signed 64-bit integer word; truncation toward
    # zero, the strict spec's trap-free rule).
    let dt = lir_def_target(alloc, dst, pos)
    let sr = lir_fp_emit_use(ctx, alloc, src, pos, w, lir_fp_use_temp())
    match w
    when LirFpWidth::LirF32 then a64_fcvtzs_xs(&mut ctx.text, dt.reg, sr)
    when LirFpWidth::LirF64 then a64_fcvtzs_xd(&mut ctx.text, dt.reg, sr)
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
    end
  when LirStmtKind::LirFcvt(src_w, dst, src) then
    # FCVT between the widths: src_w = the source's width; the dst
    # vreg's class record is the target width (a width mismatch with
    # the record would be a lowering divergence — the encoder only
    # implements the two cross-width directions).
    let dw = match lir_alloc_fp_width_of(alloc, dst)
    when Option::Some(v) then v
    when Option::None then panic("lir: LirFcvt into a vreg with no FP class record (lowering invariant)")
    end
    let dt = lir_fp_def_target(alloc, dst, pos)
    let pref = lir_fp_first_pref(dt.reg)
    let sr = lir_fp_emit_use(ctx, alloc, src, pos, src_w, pref)
    if dw == LirFpWidth::LirF32 && src_w == LirFpWidth::LirF64 then
      a64_fcvt_sd(&mut ctx.text, dt.reg, sr)
    elsif dw == LirFpWidth::LirF64 && src_w == LirFpWidth::LirF32 then
      a64_fcvt_ds(&mut ctx.text, dt.reg, sr)
    else
      panic("lir: LirFcvt between identical widths (lowering invariant; same-width casts lower as moves)")
    end
    if dt.store_slot >= 0 then
      lir_emit_slot_fp_store(ctx, dt.reg, dw, dt.store_slot)
    end
  end
end

# Emit the function epilogue (value already in x0): restore the saved
# callee-saved registers (alloc.cc_used, ascending) from the bottom of
# the frame — used[k] at [FP - frame_bytes + 8*k], the prologue's
# offsets — then release the frame and return. The restores read only
# x19..x28 and never touch x0, flags or memory below the frame, so they
# are flag-neutral (invariant I1) and safe at every Ret.
def lir_emit_epilogue(inout ctx: CodegenCtx, alloc: LirAlloc) -> Unit
  var si = 0
  while si < alloc.cc_used.len() do
    lir_emit_mem8(ctx, lir_reg_a64(alloc.cc_used[si]), A64::FP, -(alloc.frame_bytes - 8 * si), true)
    si = si + 1
  end
  a64_mov_rr(&mut ctx.text, A64::SP, A64::FP)
  a64_ldp_post(&mut ctx.text, A64::FP, A64::LR, A64::SP, 16)
  a64_ret(&mut ctx.text)
end

# Emit one terminator at position `pos`. The call terminator also runs
# the pre-call spill stores, the caller-side sret setup (x8 = &dest
# when `sret_base` is Some — see the LirCall arm), the caller-side
# aggregate-argument setup (each admitted aggregate argument's source
# address formed in its ABI slot when `agg_args` is non-empty — the
# aggregate-argument slice), the stack-slot
# cleanup, the result capture into the dest vreg and the jump to the
# success block (fixups are resolved later, at the whole-buffer level).
def lir_emit_term(inout ctx: CodegenCtx, alloc: LirAlloc, fn_name: String, kind: LirTermKind, pos: Int, externs: Set[String], defined: Set[String], sret_base: Option[Int], agg_args: Vec[LirAggCallArg]) -> Unit
  match kind
  when LirTermKind::LirJump(target) then
    let lbl = lir_block_label(fn_name, target)
    a64_b(&mut ctx.text, lbl)
  when LirTermKind::LirSwitch(vreg, arms, default_target) then
    let operand = lir_emit_use(ctx, alloc, vreg, pos, A64::X16)
    var ai = 0
    while ai < arms.len() do
      let arm = arms[ai]
      if arm.value == 0 then
        # Encoder-supported zero-test fusion (Slice 5): cbz equals
        # cmp r, #0 + b.eq and is flag-neutral, so later arms' compares
        # are unaffected.
        let lbl = lir_block_label(fn_name, arm.target)
        a64_cbz(&mut ctx.text, operand, lbl)
      else
        let lbl = lir_block_label(fn_name, arm.target)
        lir_emit_cmp_imm(ctx, operand, arm.value)
        a64_bcond(&mut ctx.text, lir_cond_code(LirCond::LirEq), lbl)
      end
      ai = ai + 1
    end
    let dlbl = lir_block_label(fn_name, default_target)
    a64_b(&mut ctx.text, dlbl)
  when LirTermKind::LirRet(rv) then
    if alloc.sret_words > 0 then
      # An sret Ret carries no return vreg by construction (the return
      # aggregate has no single scalar vreg — lowering always emits
      # Ret(None) for it); a Some here is a lowering divergence and must
      # never be silently dropped.
      match rv
      when Option::Some(_) then panic("lir: sret-return function emitted a scalar-value Ret (lowering invariant)")
      when Option::None then ()
      end
      # sret-return copy-out (aggregate returns): the caller's buffer
      # address was saved at the prologue — reload it from the reserved
      # frame slot into X16, then store each word of the return
      # aggregate's fixed frame slots (sret_base_slot + k, at
      # [FP - 8 - 8*(sret_base_slot + k)]) to [X16 + 8*k]. The word-slot
      # loads mirror codegen_epilogue's sret arm exactly: it copies the
      # direct layout size in 8-byte chunks then 4/2/1-byte tails, and
      # every admitted aggregate image is whole words (size == 8*words
      # for the sret classes), so the per-word stores ARE the chunk loop
      # — byte-exact, and the sized tails never fire. X0 is never
      # written: the value crosses in memory, not the return register.
      # X16 (the buffer base) and X17 (the copied word) are the
      # instruction temporaries, free at a terminator; the loads may
      # address through X15 (large frames) without touching either.
      lir_emit_mem8(ctx, A64::X16, A64::FP, lir_slot_offset(alloc.sret_slot), true)
      var wk = 0
      while wk < alloc.sret_words do
        lir_emit_mem8(ctx, A64::X17, A64::FP, lir_slot_offset(alloc.sret_base_slot + wk), true)
        lir_emit_mem8(ctx, A64::X17, A64::X16, 8 * wk, false)
        wk = wk + 1
      end
    else
      match rv
      when Option::Some(vreg) then
        # Uniform value resolution (reloads and memory segments are handled
        # exactly like any other read at this position). The vreg is a
        # scalar return local OR the single word of a Scalar-class
        # (<= 8-byte) aggregate return — the latter is a fixed memory-
        # home word vreg, so the load resolves its fixed frame slot
        # through the ordinary spill machinery and the word crosses in
        # x0 exactly like a scalar return's value. A FLOAT return local
        # (Float/F32/F64) loads at its width and moves into the FP
        # return register V0 (fmov s/d — F32 crosses in s0, F64 in d0,
        # per AAPCS64) — and so does the return word of a Scalar-class
        # aggregate return whose single word is a FLOAT field (word-0's
        # fp record): the float-field slice's one-word images ARE the
        # field value, so they cross on the float stream at the field's
        # width (the caller-side destination capture reads V0 the same
        # way — both sides of a call agree by construction).
        match alloc.fp_widths.get(vreg)
        when Option::Some(w) then
          let sr = lir_fp_emit_use(ctx, alloc, vreg, pos, w, lir_fp_use_temp())
          if sr != A64V::V0 then
            lir_fp_mov_rr(ctx, w, A64V::V0, sr)
          end
        when Option::None then
          let sr = lir_emit_use(ctx, alloc, vreg, pos, A64::X16)
          if sr != A64::X0 then
            a64_mov_rr(&mut ctx.text, A64::X0, sr)
          end
        end
      when Option::None then ()
      end
    end
    lir_emit_epilogue(ctx, alloc)
  when LirTermKind::LirTrap then
    a64_udf(&mut ctx.text)
  when LirTermKind::LirCall(target, args, stack_args, dest, success) then
    # Pre-call spill stores (register-resident values crossing the call).
    lir_emit_call_spills(ctx, alloc, pos)
    # Caller-side sret setup (the caller-side slice — aggregate-return
    # call sites): when this term's block is recorded on
    # LirFunction.sret_call_slots, form &dest — the address of the
    # destination aggregate's FIRST word slot, lir_slot_offset(base) ==
    # [FP - 8 - 8*base] — in x8 right before the branch (codegen.tg's
    # emit_lea_fp mirror). The lea runs AFTER the spill stores, writes
    # only X8 (never allocated; holds nothing live at a call position;
    # X15 is only the large-frame address scratch) and is flag-neutral
    # (invariant I1), so it disturbs neither the values riding the call
    # nor the pre-call spill traffic. Lowering records exactly the sret
    # calls and always lowers their dest to None — a Some here is a
    # divergence that must never be silently dropped (the scalar
    # capture would store x0 — garbage at an sret call — over the
    # callee's copy-out). A Scalar-class (<= 8-byte) aggregate
    # destination is NOT recorded here: lowering gave its call a Some
    # dest — the destination word's fixed memory-home vreg — and the
    # ordinary result capture below stores x0 into that word's fixed
    # slot, exactly like a one-word scalar destination (a destination
    # word carrying a FLOAT field's fp record captures V0 at the
    # field's width instead — the float-field slice's float-stream
    # crossing of the one-word float-field images; the callee's Ret
    # crossed the same width in V0).
    match sret_base
    when Option::Some(base) then
      match dest
      when Option::Some(_) then panic("lir: sret-return call site carried a scalar result vreg (lowering invariant)")
      when Option::None then ()
      end
      lir_emit_lea_fp(ctx, A64::X8, lir_slot_offset(base))
    when Option::None then ()
    end
    # Caller-side aggregate-ARGUMENT setup (the aggregate-argument
    # slice — by-value aggregate call arguments): every admitted
    # aggregate argument occupies ONE positional ABI slot whose word is
    # the ADDRESS of the source aggregate's first word slot
    # (lir_slot_offset(base_slot) == [FP - 8 - 8*base_slot] — the
    # lir_emit_lea_fp form of the aggregate-param fetch geometry, the
    # mirror of the sret x8 lea right above). The runs AFTER the spill
    # stores (same ordering as the sret lea), writes only the argument's
    # fixed ABI register and X16/X15 (never allocated; X16/X15 hold
    # nothing live at a call position) and is flag-neutral (invariant
    # I1), so it disturbs neither the values riding the call nor the
    # pre-call spill traffic:
    #   - slot < 8 (register class): the address is formed directly in
    #     the slot's fixed ABI register x_slot. Lowering emitted NO
    #     scalar move for such an argument (its arg_vregs entry is a
    #     placeholder that nothing reads), so this lea IS the
    #     argument's definition — the callee's entry binding fetches the
    #     image address from x_slot exactly like the aggregate-param
    #     slice's prologue fetch.
    #   - slot >= 8 (stack class): the argument's 16-byte caller slot
    #     was reserved by the ordinary LirPushArg statement stream
    #     (which pushed the placeholder word); after all pushes the
    #     slot's word sits at [SP + 16*(slot-8)], so the address is
    #     formed in X16 and stored there, replacing the placeholder
    #     before the branch (SP is at its post-push value here — the
    #     pushes are statements before this terminator, and nothing
    #     between them and this point moves SP).
    var agi = 0
    while agi < agg_args.len() do
      let aa = agg_args[agi]
      if aa.slot < 8 then
        lir_emit_lea_fp(ctx, lir_reg_a64(aa.slot), lir_slot_offset(aa.base_slot))
      else
        lir_emit_lea_fp(ctx, A64::X16, lir_slot_offset(aa.base_slot))
        lir_emit_mem8(ctx, A64::X16, A64::SP, 16 * (aa.slot - 8), false)
      end
      agi = agi + 1
    end
    # args is carried for the allocator's benefit (its fixed moves and
    # pushes are ordinary statements); nothing else reads it here (the
    # aggregate-argument records above carry the aggregate slots).
    let is_extern = externs.contains(&target) || !defined.contains(&target)
    if is_extern then
      add_reloc(&mut ctx.text, RelocKind::R_AARCH64_CALL26, target.clone(), 0)
      emit32_le(&mut ctx.text, 0x94000000)
    else
      a64_bl(&mut ctx.text, target.clone())
    end
    if stack_args > 0 then
      a64_add_rri(&mut ctx.text, A64::SP, A64::SP, (16 * stack_args) as u32)
    end
    # Result capture: x0 -> dest (a fixed or ordinary vreg def at pos)
    # for a general-word destination, or V0 -> dest for a FLOAT
    # destination (fmov s/d from the FP return register — the callee
    # crossed its float result in d0/s0; a Scalar-class aggregate
    # destination whose single word is a FLOAT field — the fixed
    # memory-home word vreg carries the field's fp record — captures
    # V0 the same way, the float-field slice's float-stream crossing
    # of the one-word float-field images). A memory-resident dest vreg
    # (a Scalar-class aggregate destination's fixed word — the
    # aggregate dests' only form — or a spilled float local) defs
    # through the class's def temp and stores its fixed slot, which
    # writes the destination local's word.
    match dest
    when Option::Some(dv) then
      match alloc.fp_widths.get(dv)
      when Option::Some(w) then
        let dt = lir_fp_def_target(alloc, dv, pos)
        if dt.reg != A64V::V0 then
          lir_fp_mov_rr(ctx, w, dt.reg, A64V::V0)
        end
        if dt.store_slot >= 0 then
          lir_emit_slot_fp_store(ctx, dt.reg, w, dt.store_slot)
        end
      when Option::None then
        let dt = lir_def_target(alloc, dv, pos)
        if dt.reg != A64::X0 then
          a64_mov_rr(&mut ctx.text, dt.reg, A64::X0)
        end
        if dt.store_slot >= 0 then
          lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
        end
      end
    when Option::None then ()
    end
    let lbl = lir_block_label(fn_name, success)
    a64_b(&mut ctx.text, lbl)
  end
end

# ———————————————————————————————————————————————————————————————
# Multiply-add fusion — P2 form (aarch64), emission-time peephole
# ———————————————————————————————————————————————————————————————
# A multiply whose result register is consumed ONLY by the immediately
# following add/sub of the same block fuses into one MADD/MSUB:
#     mul rd = ra * rb
#     add rx = rd + rc   ->   madd rx, ra, rb, rc
#     sub rx = rc - rd   ->   msub rx, ra, rb, rc
# and both statements vanish. The form needs THREE register sources,
# which no LirStmtKind carries; rather than add a variant (every
# exhaustive LirStmtKind match would have to grow — lir_stmt_occ, the
# thumb/rv emitters), the fusion runs in lir_emit_fn's own walk: the
# mul's position `pos` emits the fused instruction, the add's position
# `pos+1` emits nothing, and the allocator's per-statement position
# records (I3) need no renumbering. The emitter also sees the
# allocation, so the safety conditions below are checked against the
# real segment/reload records instead of conservatively.
#
# Safety conditions (ALL must hold, else the pair emits unfused):
#   - the mul has two register operands (no immediates) and the add/sub
#     is the register-register form;
#   - the add is `rx = rd + rc` with rd on either side, or the sub is
#     `rx = rc - rd` (rd the subtrahend; `rx = rd - rc` would need a
#     negated addend). The other operand rc must be a register OTHER
#     than rd — `rx = rd + rd` would read rd twice after its only def
#     was deleted. Neither instruction sets flags (non-S forms), so I1
#     is untouched, and both wrap identically mod 2^64;
#   - rd is read nowhere else: not in statements pos+2..end, not in the
#     block terminator. (A later DEF of rd is fine — defs don't read.
#     The add's dest rx may itself BE rd, ra, rb or rc: MADD/MSUB
#     reads every source before writing the destination, so intra-
#     instruction aliasing is safe by construction.)
#   - at most two of ra/rb/rc are memory-resident at their read
#     positions, so the two X16/X17 load temps suffice (a fused read of
#     three spill slots would have no third temp). No other spill/
#     reload effect can intervene between the pair: a call is a
#     terminator, and positions between adjacent statements carry
#     nothing but this (deleted) add.
#   - ra/rb resolve at `pos` (their original read positions); rc and
#     the def of rx resolve at `pos+1`, where their reload/store
#     records live.

# The fused form: dst = a*b + c (madd) or dst = c - a*b (msub).
struct LirFuseMacc
  is_msub: Bool   # true: MSUB; false: MADD
  dst: Int        # the add/sub destination vreg
  a: Int          # mul left operand
  b: Int          # mul right operand
  c: Int          # the add's other operand (addend / minuend)
  prod: Int       # the mul's result vreg (deleted; the tail-scan key)
end

# Does an operand slot read vreg r?
def lir_value_reads_reg(val: LirValue, r: Int) -> Bool
  match val
  when LirValue::LirReg(vreg) then vreg == r
  when LirValue::LirImm(_) then false
  end
end

# Does a statement read vreg r? (Defs never count.)
def lir_stmt_reads_reg(kind: LirStmtKind, r: Int) -> Bool
  match kind
  when LirStmtKind::LirMove(_, val) then lir_value_reads_reg(val, r)
  when LirStmtKind::LirBinop(_, _, left, right) then
    lir_value_reads_reg(left, r) || lir_value_reads_reg(right, r)
  when LirStmtKind::LirUnop(_, _, src) then src == r
  when LirStmtKind::LirCmp(left, right) then
    lir_value_reads_reg(left, r) || lir_value_reads_reg(right, r)
  when LirStmtKind::LirCset(_, _) then false
  when LirStmtKind::LirLoadFrame(_, _) then false
  when LirStmtKind::LirStaticLoad(_, _) then false
  when LirStmtKind::LirPushArg(vreg) then vreg == r
  when LirStmtKind::LirFMove(_, src) then src == r
  when LirStmtKind::LirFBinop(_, _, _, left, right) then left == r || right == r
  when LirStmtKind::LirFNeg(_, _, src) then src == r
  when LirStmtKind::LirFCmp(_, left, right) then left == r || right == r
  when LirStmtKind::LirFConst(_, _, _) then false
  when LirStmtKind::LirIntToFloat(_, _, src, _) then src == r
  when LirStmtKind::LirFloatToInt(_, _, src) then src == r
  when LirStmtKind::LirFcvt(_, _, src) then src == r
  end
end

# Does the block terminator read vreg r? (A call reads nothing at its
# own position — the argument moves are statements before it.)
def lir_term_reads_reg(kind: LirTermKind, r: Int) -> Bool
  match kind
  when LirTermKind::LirJump(_) then false
  when LirTermKind::LirSwitch(vreg, _, _) then vreg == r
  when LirTermKind::LirRet(rv) then
    match rv
    when Option::Some(v) then v == r
    when Option::None then false
    end
  when LirTermKind::LirTrap then false
  when LirTermKind::LirCall(_, _, _, _, _) then false
  end
end

# Shape probe: is `mul_kind` a register mul whose result the
# register-register `add_kind` consumes exactly once? Returns the fused
# form on a shape match; the caller still checks the tail scan and the
# allocation.
def lir_fuse_macc_probe(mul_kind: LirStmtKind, add_kind: LirStmtKind) -> Option[LirFuseMacc]
  match mul_kind
  when LirStmtKind::LirBinop(LirBinOp::LirMul, rd, LirValue::LirReg(ra), LirValue::LirReg(rb)) then
    match add_kind
    when LirStmtKind::LirBinop(LirBinOp::LirAdd, rx, LirValue::LirReg(l), LirValue::LirReg(r)) then
      if l == rd && r != rd then
        Option::Some(LirFuseMacc { is_msub: false, dst: rx, a: ra, b: rb, c: r, prod: rd })
      elsif r == rd && l != rd then
        Option::Some(LirFuseMacc { is_msub: false, dst: rx, a: ra, b: rb, c: l, prod: rd })
      else
        Option::None
      end
    when LirStmtKind::LirBinop(LirBinOp::LirSub, rx, LirValue::LirReg(l), LirValue::LirReg(r)) then
      if r == rd && l != rd then
        Option::Some(LirFuseMacc { is_msub: true, dst: rx, a: ra, b: rb, c: l, prod: rd })
      else
        Option::None
      end
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# Any read of the mul's result after the add (statements `from`..end,
# or the block terminator) blocks the fusion — its only def is being
# deleted.
def lir_macc_tail_ok(stmts: Vec[LirStmt], term_kind: LirTermKind, from: Int, rd: Int) -> Bool
  var j = from
  while j < stmts.len() do
    # A marked pointer/atomic statement's reads are its OWN source words
    # (the nominal kind's shape is arity-nearest only — see LirPtrOp);
    # consult the marker so a marked store/atomic that reads the fused
    # product is never missed.
    match stmts[j].ptr
    when Option::Some(_) then
      var defs: Vec[Int] = Vec::new()
      var uses: Vec[Int] = Vec::new()
      match stmts[j].ptr
      when Option::Some(pop) then lir_ptr_stmt_occ(pop, defs, uses)
      when Option::None then ()
      end
      var uk = 0
      while uk < uses.len() do
        if uses[uk] == rd then
          return false
        end
        uk = uk + 1
      end
    when Option::None then
      if lir_stmt_reads_reg(stmts[j].kind, rd) then
        return false
      end
    end
    j = j + 1
  end
  !lir_term_reads_reg(term_kind, rd)
end

# Would resolving vreg at `pos` spill-load into an X16/X17 temp?
# (Register-resident segments — even with a first-read reload — load
# into their own segment register, so they need no temp.)
def lir_use_needs_temp(alloc: LirAlloc, vreg: Int, pos: Int) -> Bool
  if vreg < lir_first_alloc_vreg() then
    return false
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then s.phys < 0
    when Option::None then false
    end
  when Option::None then false
  end
end

# The fused instruction reads ra/rb at the mul's position and rc at the
# add's; at most two of the three may need a load temp (the same limit
# every statement in this emitter respects).
def lir_macc_temps_ok(alloc: LirAlloc, m: LirFuseMacc, pos: Int) -> Bool
  var need = 0
  if lir_use_needs_temp(alloc, m.a, pos) then need = need + 1 end
  if lir_use_needs_temp(alloc, m.b, pos) then need = need + 1 end
  if lir_use_needs_temp(alloc, m.c, pos + 1) then need = need + 1 end
  need <= 2
end

# A free X16/X17 load temp for a spill-loading use: prefer the temp
# that is not the destination register. Loading the destination temp is
# still safe (that load is the LAST one and the fused instruction reads
# it before writing), but an occupied temp is never reused.
def lir_macc_pref(dt_reg: A64, busy16: Bool, busy17: Bool) -> A64
  if dt_reg == A64::X16 then
    if busy17 then A64::X16 else A64::X17 end
  else
    if busy16 then A64::X17 else A64::X16 end
  end
end

# Emit one fused MADD/MSUB for the pair occupying positions `pos` (the
# mul) and `pos+1` (the add).
def lir_emit_macc(inout ctx: CodegenCtx, alloc: LirAlloc, m: LirFuseMacc, pos: Int) -> Unit
  let dt = lir_def_target(alloc, m.dst, pos + 1)
  var busy16 = false
  var busy17 = false
  let ra = lir_emit_use(ctx, alloc, m.a, pos, lir_macc_pref(dt.reg, busy16, busy17))
  if ra == A64::X16 then busy16 = true elsif ra == A64::X17 then busy17 = true end
  let rb = lir_emit_use(ctx, alloc, m.b, pos, lir_macc_pref(dt.reg, busy16, busy17))
  if rb == A64::X16 then busy16 = true elsif rb == A64::X17 then busy17 = true end
  let rc = lir_emit_use(ctx, alloc, m.c, pos + 1, lir_macc_pref(dt.reg, busy16, busy17))
  # a64_madd/msub take (d, m, a, n) and compute d = n +/− m*a, so the
  # resolved registers map ra -> m, rb -> a, rc -> n directly.
  if m.is_msub then
    a64_msub(&mut ctx.text, dt.reg, ra, rb, rc)
  else
    a64_madd(&mut ctx.text, dt.reg, ra, rb, rc)
  end
  if dt.store_slot >= 0 then
    lir_emit_slot_store(ctx, dt.reg, dt.store_slot)
  end
end

# Try to fuse the mul at stmts[si] (machine position `pos`) with the
# add/sub at stmts[si + 1]. Returns true (having emitted the fused
# instruction) when every safety condition holds; the caller then
# advances past both statements.
def lir_macc_try(inout ctx: CodegenCtx, alloc: LirAlloc, stmts: Vec[LirStmt], term_kind: LirTermKind, si: Int, pos: Int) -> Bool
  if si + 1 >= stmts.len() then
    return false
  end
  # A division-marker statement is a DIVIDE, not a multiply (its kind
  # reuses the Mul shape — see LirStmt.div): neither it nor its successor
  # may enter the MADD/MSUB fusion.
  match stmts[si].div
  when Option::Some(_) then return false
  when Option::None then ()
  end
  match stmts[si + 1].div
  when Option::Some(_) then return false
  when Option::None then ()
  end
  # A marked pointer/atomic statement (LirStmt.ptr) is never a fuseable
  # multiply/add either: the marked LSE arms and the LirPtrAddr/LEA
  # forms ride Binop/Unop nominal shapes whose nominal geometry only
  # approximately matches their real semantics.
  match stmts[si].ptr
  when Option::Some(_) then return false
  when Option::None then ()
  end
  match stmts[si + 1].ptr
  when Option::Some(_) then return false
  when Option::None then ()
  end
  match lir_fuse_macc_probe(stmts[si].kind, stmts[si + 1].kind)
  when Option::Some(m) then
    if !lir_macc_tail_ok(stmts, term_kind, si + 2, m.prod) then
      return false
    end
    if !lir_macc_temps_ok(alloc, m, pos) then
      return false
    end
    lir_emit_macc(ctx, alloc, m, pos)
    true
  when Option::None then
    false
  end
end

# Emit an entire function: symbol, prologue, entry capture for
# main/_start, blocks (statements then terminator), walking positions
# exactly like lir_linearize (I3).
def lir_emit_fn(inout ctx: CodegenCtx, f: LirFunction, alloc: LirAlloc, externs: Set[String], defined: Set[String]) -> Unit
  # Symbol + entry label (block 0's label is defined by the block loop).
  # (P1-18 @cold): an attr_cold function's symbol is routed into the
  # cold section (Section::ColdText — the .text.cold region); its body
  # is emitted into ctx.text either way (the driver's deferred cold
  # pass placed it in the stream's cold tail).
  align_to(&mut ctx.text, 4, Arch::AArch64)
  let fn_start = buf_pos(&ctx.text)
  let fn_section = if f.attr_cold then Section::ColdText else Section::Text end
  add_symbol(&mut ctx.text, AsmSymbol {
    name: f.name.clone(),
    section: fn_section,
    offset: fn_start,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  def_label(&mut ctx.text, f.name.clone())

  # Prologue.
  a64_stp_pre(&mut ctx.text, A64::FP, A64::LR, A64::SP, -16)
  a64_mov_rr(&mut ctx.text, A64::FP, A64::SP)
  if alloc.frame_bytes > 0 then
    if alloc.frame_bytes <= 4095 then
      a64_sub_rri(&mut ctx.text, A64::SP, A64::SP, alloc.frame_bytes as u32)
    else
      a64_mov_ri(&mut ctx.text, A64::X15, alloc.frame_bytes)
      a64_sub_sp_sp_r(&mut ctx.text, A64::X15)
    end
  end

  # Save the callee-saved registers this function actually uses
  # (alloc.cc_used, ascending) at the BOTTOM of the frame — used[k] at
  # [FP - frame_bytes + 8*k], the codegen.tg aarch64 rule (saved[i] at
  # [fp - stack_size + i*8]; the spill slots above never overlap). Each
  # access is a stur/ldur or an X15-addressed load/store, all
  # flag-neutral (invariant I1). These runs before the entry capture so
  # the capture helpers can never see unsaved callee-saved values.
  var si0 = 0
  while si0 < alloc.cc_used.len() do
    lir_emit_mem8(ctx, lir_reg_a64(alloc.cc_used[si0]), A64::FP, -(alloc.frame_bytes - 8 * si0), false)
    si0 = si0 + 1
  end

  # sret ABI (aggregate returns): save the caller-supplied indirect-return
  # pointer (x8) into its reserved frame slot — lir_slot_offset
  # (alloc.sret_slot) — before any callee work can clobber it, mirroring
  # codegen.tg's prologue rule (emit_store_mem fp, frame.sret_offset, x8).
  # The store is flag-neutral (invariant I1). sret functions are never
  # "main"/"_start" (an OS entry returns no aggregate), so this cannot
  # collide with the entry capture.
  if alloc.sret_slot >= 0 then
    lir_emit_mem8(ctx, A64::X8, A64::FP, lir_slot_offset(alloc.sret_slot), false)
  end

  # By-value aggregate PARAMETER binding (the aggregate-param slice):
  # for each admitted image-address parameter — an address-class
  # plain-struct parameter OR a payloaded tagged-enum parameter under
  # the LIR-internal enum ABI (the record is kind-agnostic; the enum
  # kind never reaches the machine level) — the caller supplied the
  # image's ADDRESS in the parameter's ONE ABI arg slot (slot = the
  # parameter's position among all parameters — see LirAggParamBind):
  # the address of a parameter at slot k < 8 arrives in the ABI
  # register x_k (the register-class geometry the scalar binds read —
  # codegen.tg binds ScalarPair/ByAddress parameters from
  # arg_reg(arch, idx) in its prologue), and the address of a parameter
  # at slot k >= 8 was pushed by the caller in the 16-byte slot at the
  # canonical [FP + 16 + 16*(k-8)] offset (the same caller-slot
  # geometry the scalar stack-parameter loads read). Nothing between
  # function entry and this point has touched x0..x7 (the prologue's
  # stp/mov/sub, the callee-saved saves at the bottom of the frame and
  # the x8 save use only FP/SP/X8/X15/X19..x28), so the register
  # addresses are still live here; the run sits before the "main"/
  # "_start" entry capture, which may clobber x0/x1. Each copy mirrors
  # the sret-return slice's X16/X17 load-store pattern (the Ret
  # copy-out with its loads and stores exchanged): X16 holds the
  # incoming image base, X17 the copied word, and each word of the
  # image at [X16 + 8*j] is stored to the parameter aggregate's fixed
  # frame slot [FP - 8 - 8*(base_slot + j)]. The stores are direct
  # frame-slot writes (flag-neutral, invariant I1) exactly like the
  # sret prologue's x8 save — invisible to the allocator, which only
  # ever reads those slots through the fixed-slot word vregs' spill
  # loads, so after this copy the parameter behaves exactly like an
  # aggregate local. The loads may address through X15 (deep slots /
  # large frames) without touching the base in X16.
  var ap = 0
  while ap < f.agg_params.len() do
    let bind = f.agg_params[ap]
    if bind.slot < 8 then
      a64_mov_rr(&mut ctx.text, A64::X16, lir_reg_a64(bind.slot))
    else
      lir_emit_mem8(ctx, A64::X16, A64::FP, lir_stack_arg_offset(false, bind.slot), true)
    end
    var wj = 0
    while wj < bind.words do
      lir_emit_mem8(ctx, A64::X17, A64::X16, 8 * wj, true)
      lir_emit_mem8(ctx, A64::X17, A64::FP, lir_slot_offset(bind.base_slot + wj), false)
      wj = wj + 1
    end
    ap = ap + 1
  end

  # The entry capture for the OS entry points (argc/argv/envp) — shared
  # codegen.tg ctx helper (a self-contained LIR capture is not
  # implemented).
  if f.name == "main" || f.name == "_start" then
    emit_save_argc_argv(ctx)
  end

  # Blocks, in order, with the SAME position walk the allocator used.
  var pos = 0
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    def_label(&mut ctx.text, lir_block_label(f.name.clone(), b.id))
    var si = 0
    while si < b.stmts.len() do
      # A MARKED register-class bit-move statement (LirStmt.bm — the
      # float slice's int<->float transmute/word-crossing moves)
      # emits through its own aarch64 arm (lir_emit_bitmove_stmt) —
      # never through the nominal kind's semantics, and never into the
      # MADD/MSUB fusion.
      match b.stmts[si].bm
      when Option::Some(_) then
        lir_emit_bitmove_stmt(ctx, alloc, b.stmts[si], pos)
        pos = pos + 1
        si = si + 1
      when Option::None then
        # A MARKED pointer/atomic statement (LirStmt.ptr) emits through
        # its own aarch64 arm (lir_emit_ptr_stmt) — never through the
        # nominal kind's semantics, and never into the MADD/MSUB fusion.
        match b.stmts[si].ptr
        when Option::Some(pop) then
          lir_emit_ptr_stmt(ctx, alloc, pop, pos)
          pos = pos + 1
          si = si + 1
        when Option::None then
          # Multiply-add fusion (P2 form, see the section above): when the
          # mul at si is immediately consumed by the add/sub at si + 1, one
          # MADD/MSUB replaces both statements.
          if lir_macc_try(ctx, alloc, b.stmts, b.term.kind, si, pos) then
            pos = pos + 2
            si = si + 2
          else
            lir_emit_stmt(ctx, alloc, b.stmts[si], pos)
            pos = pos + 1
            si = si + 1
          end
        end
      end
    end
    # The terminator's caller-side sret record: the destination
    # aggregate's base_slot when THIS block's call lowers through the
    # sret ABI (see LirFunction.sret_call_slots), None otherwise — a
    # Scalar-class aggregate destination is NOT recorded here: its call
    # term carries the destination word's vreg and the ordinary
    # post-call capture below defines it. The
    # caller-side aggregate-argument record (LirFunction.agg_call_args)
    # resolves the same way: the block's aggregate-argument list, empty
    # when the call carries none.
    let sret_base = match f.sret_call_slots.get(b.id)
    when Option::Some(s) then Option::Some(s)
    when Option::None then Option::None
    end
    let agg_args = match f.agg_call_args.get(b.id)
    when Option::Some(list) then list.clone()
    when Option::None then Vec::new()
    end
    lir_emit_term(ctx, alloc, f.name.clone(), b.term.kind, pos, externs, defined, sret_base, agg_args)
    pos = pos + 1
    bi = bi + 1
  end
end
# ———————————————————————————————————————————————————————————————
# Whole-program static data emission (the LIR slice's scalar subset)
# ———————————————————————————————————————————————————————————————
# Every LIR whole-program route (lir_compile_object / lir_link_object,
# thumb_compile_object, rv_compile_object) now emits the program's
# statics into the object file instead of failing closed. The admitted
# subset mirrors the DIRECT emitter's static model for the scalar
# shapes only:
#   - the DECLARED TYPE must be a scalar word of the route's accept set
#     (lir_static_scalar_ok below — the same sets the function shape
#     gates admit for locals: the full width model on the aarch64
#     route — Bool + every integer word — and the 64-bit words plus
#     Bool on the word-only thumb/rv routes). Float/F32/F64, Char,
#     String, pointer, Vec/Array/Slice/UnsafeSlice and every other
#     aggregate/collection static fails closed with its concrete rule
#     (the direct emitter's data arms for those shapes — rodata string
#     pointers, HeapVecHeader pointers, empty views — are not mirrored
#     on the LIR slice, whose reads are machine-word loads only).
#   - the INITIALIZER must be the scalar-constant subset the MIR
#     builder admits for such declarations: a MirInt value (integer
#     words — the enum-discriminant/collection-zero forms carry MirInt
#     constants too, but their declared types are not scalar words and
#     are rejected above) or a MirBool value (Bool). MirFloat/MirChar/
#     MirString and non-constant initializers fail closed with their
#     concrete rule. Option::None (uninitialized/extern statics) is
#     admitted and emitted as a zero image (the .bss mirror on the
#     aarch64 route).
#   The emitted .data image mirrors codegen_static's scalar byte
#   layout: each static starts on the route's word boundary, the
#   initializer's bytes sit at the declared type's STORAGE width in
#   the low bytes (emit_scalar_constant_for_storage — little-endian,
#   value & width mask), and zero padding fills to the route's word
#   boundary, so a full machine-word load of any admitted static reads
#   the value's zero-extended canonical word (the direct emitter's
#   static-read image). The symbol is GLOBAL (SymBinding::Global,
#   SymKind::Data — codegen_static's binding), so the text relocations
#   of every reference (LirStaticLoad) resolve against it.
#   The bss mirror (init None) deviates from codegen_static in ONE
#   documented way: direct bss symbols are packed at the LAYOUT
#   alignment (a Bool static may sit at offset 1), which is fine for
#   the direct emitter's sized reads but corrupts the LIR route's
#   FULL-WORD reads (an 8-byte load at offset 1 would swallow the next
#   symbol's bytes). LIR bss symbols are therefore placed at the
#   route's word alignment, keeping every full-word window zero-padded.
#   Reads never reference .rodata, so no rodata content is produced by
#   the scalar subset.
#
# The type/init checks below are shared by the three routes
# (lir_static_scalar_ok / lir_static_init_word_value); each route
# emits its own image (the aarch64 emission here, the thumb/rv
# emissions in backend_thumb.tg / backend_rv.tg) and applies its own
# word-width and immediate-range rules.

# Is `ty` a static-emittable scalar of the route? `width_ok` selects
# the route's scalar-word accept set (true = the aarch64 width model —
# Bool + every integer word of lir_int_width_bits; false = the
# thumb/rv word-only set — the 64-bit integer words plus Bool). The
# rule mirrors the routes' LOCAL gates, so every static a function can
# reference has an image and every image has a read model.
def lir_static_scalar_ok(width_ok: Bool, ty: Type) -> Bool
  if width_ok then
    lir_is_scalar_word(ty) || lir_is_bool_word(ty)
  else
    (lir_is_int_word(ty) && lir_int_width_bits(ty) == 64) || lir_is_bool_word(ty)
  end
end

# The scalar word image value of a static's initializer, with the
# initializer/type pairing validated: Result::Ok(None) for no
# initializer (the uninitialized/extern form — zero image), Ok(Some(w))
# for the scalar-constant subset (MirBool normalizes to its 0/1 word;
# MirInt keeps its value — the per-route emission masks it to the
# route's word width). Every initializer outside the subset fails
# closed with a rule naming the concrete missing form.
def lir_static_init_word_value(st: MirStatic) -> Result[Option[Int], String]
  let ty = st.ty.clone()
  match st.init
  when Option::Some(op) then
    match op.kind
    when MirOperandKind::MirConstant(cst) then
      match cst.kind
      when MirConstantKind::MirInt(v) then
        if lir_is_bool_word(ty) then
          return Result::Err("static '" + st.name + "' is Bool-declared but its initializer is an integer constant (the MIR builder writes MirBool for Bool statics — a typed-MIR divergence; fail-closed)")
        end
        if !lir_is_int_word(ty) then
          return Result::Err("static '" + st.name + "' carries an integer initializer on a non-integer declared type (the scalar-constant subset pairs MirInt with integer words only; fail-closed)")
        end
        Result::Ok(Option::Some(v))
      when MirConstantKind::MirBool(b) then
        if !lir_is_bool_word(ty) then
          return Result::Err("static '" + st.name + "' carries a Bool initializer on a non-Bool declared type (the scalar-constant subset pairs MirBool with Bool only; fail-closed)")
        end
        Result::Ok(Option::Some(if b then 1 else 0 end))
      when _ then
        Result::Err("static '" + st.name + "' has an initializer outside the LIR scalar-constant subset — float/char/string and static/function constants do not lower as static data on the LIR slice (the direct emitter's rodata/pointer data arms are not mirrored; fail-closed)")
      end
    when _ then
      Result::Err("static '" + st.name + "' has a non-constant initializer — the MIR builder writes scalar constants only; a non-constant shape is a lowering divergence (fail-closed)")
    end
  when Option::None then Result::Ok(Option::None)
  end
end

# The error text for a static whose declared type is outside the
# route's scalar set (the reason lists the concrete missing rules).
def lir_static_unsupported_type_rule(st_name: String) -> String
  "static '" + st_name + "' has no data-emission rule on the LIR slice — the scalar-constant subset admits Bool and the integer scalar words only, and float/char/string/pointer and aggregate/collection statics (Vec/Array/Slice/UnsafeSlice and every other non-scalar image) are not implemented on the LIR routes (fail-closed)"
end

# Emit ONE admitted static into the aarch64 route's CodegenCtx (.data
# image or the .bss mirror — see the section header). The .data byte
# stream mirrors codegen_static's scalar arms exactly (8-aligned
# symbols, value at the declared type's storage width in the low
# bytes, zero padding to the layout size and the 8-byte boundary); the
# symbol record (name, Section::Data, size = the layout size, global)
# is what the object writers and the reference relocations consume.
def lir_emit_static_a64(inout ctx: CodegenCtx, st: MirStatic) -> Result[Unit, String]
  let ty = st.ty.clone()
  if !lir_static_scalar_ok(true, ty) then
    return Result::Err("lir: " + lir_static_unsupported_type_rule(st.name.clone()))
  end
  let sz = lir_scalar_word_size(ty)
  if sz <= 0 then
    return Result::Err("lir: " + lir_static_unsupported_type_rule(st.name.clone()))
  end
  match st.init
  when Option::Some(_) then
    let word_o = match lir_static_init_word_value(st)
    when Result::Err(e) then return Result::Err("lir: " + e)
    when Result::Ok(o) then o
    end
    # Initialized: the .data image (codegen_static's scalar layout —
    # 8-aligned symbol, storage-width value bytes, zero padding to the
    # layout size, then the trailing 8-byte alignment pad).
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end
    add_symbol(&mut ctx.data, AsmSymbol {
      name: st.name.clone(),
      section: Section::Data,
      offset: buf_pos(&ctx.data),
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    def_label(&mut ctx.data, st.name.clone())
    if lir_is_bool_word(ty) then
      # Bool: the single byte (the init word value is the 0/1 of the
      # MirBool normalizer) followed by the layout-size zero padding.
      emit8(&mut ctx.data, word_o as u8)
      var pad_bool = sz - 1
      while pad_bool > 0 do
        emit8(&mut ctx.data, 0)
        pad_bool = pad_bool - 1
      end
    else
      # Integer word: the value at the declared type's storage width
      # (codegen_static's emit_scalar_constant_for_storage arm). For an
      # integer scalar the storage width IS the layout size (1/2/4/8 —
      # lir_scalar_word_size), so no intra-symbol padding exists; the
      # trailing 8-byte alignment pad below fills the read window.
      emit_scalar_constant_for_storage(&mut ctx.data, word_o as i64, sz)
    end
    # Trailing 8-byte alignment pad (codegen_static's post-emission
    # pad) — the zero bytes that keep every full-word read window
    # zero-padded above a narrow static's value bytes.
    while buf_pos(&ctx.data) % 8 != 0 do
      emit8(&mut ctx.data, 0)
    end
  when Option::None then
    # Uninitialized/extern static: the .bss mirror (ctx.bss_symbols /
    # ctx.bss_size — the ObjectFile fields lir_object_file consumes).
    # Symbols are placed at the 8-byte word alignment (the documented
    # deviation from codegen_static's layout-alignment packing — see
    # the section header: the LIR reads are full 8-byte words and the
    # window must stay zero-padded).
    while ctx.bss_size % 8 != 0 do
      ctx.bss_size = ctx.bss_size + 1
    end
    ctx.bss_symbols.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Bss,
      offset: ctx.bss_size,
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    ctx.bss_size = ctx.bss_size + sz
  end
  Result::Ok(())
end

# Emit the whole program's statics into the aarch64 route's ctx (the
# mirror of codegen_program's static loop, subset-gated). The route
# entries run this right after the static label table is built, so the
# .data/.bss symbols exist before any function lowering references
# them (the reference relocations carry the symbol NAMES, so the
# ordering is belt-and-braces).
def lir_emit_program_statics_a64(inout ctx: CodegenCtx, program: MirProgram) -> Result[Unit, String]
  var si = 0
  while si < program.statics.len() do
    match lir_emit_static_a64(ctx, &program.statics[si])
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    si = si + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Whole-program route (Slice 4 wiring)
# ———————————————————————————————————————————————————————————————
# The route is invoked by driver.tg's compile_lir_route behind the
# TANGERINE_LIR gate (default off). It lowers EVERY non-extern function
# through the LIR pipeline (fail-closed: one unsupported construct fails
# the whole compile with the rule-naming reason), emits the bodies into a
# CodegenCtx text buffer, merges the standard runtime (reusing codegen's
# emit_all_runtime merge and data-emission helpers), and assembles the
# same object layout the direct emitter produces. Program-level STATICS
# lower through the scalar-constant subset (see the statics section
# above — the .data/.bss emission mirrors codegen_static's scalar
# layout and MirStaticRef reads emit the ADRP+ADD relocation pair +
# LDR against the emitted symbols); plain-struct
# AND tagged-enum
# aggregate locals lower per function (the aggregate slice), and so do
# aggregate RETURNS of BOTH classes (the aggregate-return slice: the
# Scalar-class (<= 8-byte) images return their one word in x0 through
# the ordinary Ret word load, and the sret-eligible images — 16 bytes
# / more than 8 bytes — return through the x8 copy-out; a tagged-enum
# image takes its class by size under the LIR-internal enum ABI — the
# payload-less tag word in x0, a payloaded image through x8), the
# aggregate-return CALL SITES that consume them (the caller-side slice:
# sret destinations form &dest in x8 before the call, Scalar-class
# destinations capture x0 into their single word slot after it) — the
# aggregate return ABI now lowers end to end — and by-value aggregate
# PARAMETERS (the aggregate-param slice: address-class plain-struct
# images AND payloaded tagged-enum images bind word-by-word at
# function entry, and one-word Scalar-class plain-struct images bind
# their single word from the parameter's slot at entry like a scalar —
# the register-class slice), whose caller side — the
# by-value aggregate ARGUMENTS (the address-class images carry the
# source word-group's frame address, the one-word Scalar-class images
# carry their single word BY VALUE in the ordinary scalar-argument
# move path, and the payloaded tagged-enum arguments cross by
# reference under the
# LIR-internal enum ABI) — now
# lowers too (the aggregate-argument slice: one positional ABI slot per
# argument carrying the source word-group's frame address, formed at
# the call site in the sret x8 lea ordering — the aggregate call ABI
# lowers end to end with the params side). What remains outside the
# aggregate slice fails closed per function or per call site: the
# aggregate shapes whose LAYOUTS the shape gate rejects (tuples,
# fixed arrays, @packed/@align, sub-word fields sharing or straddling
# an 8-byte word — the packed-pair structs whose two small fields
# would share one word never clear the shape gate — zero-field
# structs) fail at their own gates; non-scalar VALUE arguments that do
# not reference a whole aggregate local (aggregate values always sit
# in one — a constructed temporary's word group — and pass through
# its local) fail closed defensively at call lowering; and
# payloaded-enum crossings to EXTERN symbols fail closed at this
# route's entries (lir_check_extern_enum_calls — the extern's callee
# side follows the direct pipeline's one-word TaggedPtr value-word
# convention, which only the payload-less tag word matches; see
# lir_enum_crossing_rule).

# The emission names of every program function (externs and bodies).
def lir_collect_callees(f: LirFunction) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    match b.term.kind
    when LirTermKind::LirCall(target, _, _, _, _) then
      out.push(target.clone())
    when _ then ()
    end
    bi = bi + 1
  end
  out
end

# Every call target must resolve to a body this route emits or to an
# extern symbol (fail-closed: an unknown label would otherwise fall into
# the direct emitter's RET-stub path — a silent miscompile).
def lir_validate_callees(f: LirFunction, defined: Set[String], externs: Set[String]) -> Result[Unit, String]
  let callees = lir_collect_callees(f)
  var ci = 0
  while ci < callees.len() do
    let t = callees[ci]
    if !defined.contains(&t) && !externs.contains(&t) then
      return Result::Err("lir: function " + f.name + " calls unknown target `" + t + "` (not a program function, not an extern — fail-closed)")
    end
    ci = ci + 1
  end
  Result::Ok(())
end

# Is `ty` an ADMITTED PAYLOADED tagged-enum image — an admitted enum
# whose image carries payload words (a crossing type whose direct
# value word would be the TaggedPtr heap-pointer encoding)? Only the
# extern-boundary guard below consults this: inside the route every
# such image crosses BY REFERENCE under the LIR-internal enum ABI (the
# payload-less 8-byte tag-word image — the same raw-discriminant value
# word in both conventions — returns false here), and every
# non-admitted shape fails closed in its own lowering gate.
def lir_ty_is_payloaded_enum(type_defs: Map[Int, MirTypeDef], ty: Type) -> Bool
  match lir_plain_struct_shape(type_defs, ty)
  when Result::Err(_) then false
  when Result::Ok(o) then
    match o
    when Option::Some(kind) then
      match kind
      when LirAggShapeKind::LirAggStruct(_) then false
      when LirAggShapeKind::LirAggEnum(eshape) then
        !lir_agg_is_scalar_class(lir_enum_image_shape(eshape))
      end
    when Option::None then false
    end
  end
end

# THE EXTERN-BOUNDARY ENUM GUARD — the ONLY remaining
# lir_enum_crossing_rule enforcement site (see the rule's section and
# the LIR-internal enum ABI note): the LIR-internal by-reference
# crossing of a payloaded enum is coherent only between LIR-compiled
# functions, because the whole route compiles every non-extern body
# with the same convention. An EXTERN symbol's crossing convention is
# the DIRECT pipeline's instead — every registered enum crosses as ONE
# Scalar(8) TaggedPtr VALUE word, and a payloaded image's value word
# would be a heap pointer this slice never materializes — so a call to
# an extern whose ARGUMENT or call DESTINATION is an admitted
# payloaded tagged-enum image fails closed here (a payload-less enum
# crosses by its raw-discriminant tag word in BOTH conventions, so
# payload-less extern crossings keep lowering; the caller's tag word is
# exactly the value word the direct callee expects). The guard runs on
# the MIR function in the whole-program entries (lir_compile_object /
# lir_link_object), where the extern table and the argument/
# destination types both still exist — per-function lowering sees
# neither, so the gate can only live here.
def lir_check_extern_enum_calls(f: MirFunction, type_defs: Map[Int, MirTypeDef], externs: Set[String]) -> Result[Unit, String]
  var bi = 0
  while bi < f.blocks.len() do
    let block = f.blocks[bi]
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      # The callee name, resolved exactly as lir_lower_terminator does
      # (any other operand shape fails closed at lowering with its own
      # reason — skipping it here only defers that Err).
      var target: String = ""
      match func.kind
      when MirOperandKind::MirConstant(cst) then
        match cst.kind
        when MirConstantKind::MirFnItem(name) then target = name.clone()
        when _ then ()
        end
      when _ then ()
      end
      if target.len() > 0 && externs.contains(&target) then
        # The call DESTINATION: a payloaded-enum-typed whole local
        # would lower through the caller-side sret x8 protocol (its
        # LIR callee would copy the image words out through the x8 it
        # receives), while the extern callee returns its one TaggedPtr
        # VALUE word in x0 — the destination's words would never be
        # written (fail closed). Projected destinations are scalar
        # captures and cannot carry a payloaded-enum type.
        if dest.projections.len() == 0 then
          match mir_opt_local_type(f, dest.local.id)
          when Option::Some(dty) then
            if lir_ty_is_payloaded_enum(type_defs, dty) then
              return Result::Err("lir: function " + f.name + " calls extern `" + target + "` into a payloaded-enum destination — " + lir_enum_crossing_rule())
            end
          when Option::None then ()
          end
        end
        # The ARGUMENTS: a payloaded-enum-typed argument would lower as
        # the source image group's frame address in its ONE ABI slot
        # (the aggregate-argument slice), while the extern callee reads
        # its one TaggedPtr VALUE word — it would dereference the frame
        # address as a heap pointer (fail closed). A payloaded-enum type
        # can only reach a call through a whole-enum local/operand
        # (every projection of an enum is a scalar), so the operand
        # type check below mirrors the caller-side crossing exactly.
        var ai = 0
        while ai < args.len() do
          var aty_o: Option[Type] = Option::None
          match args[ai].value
          when MirCallValue::Place(p) then
            if p.projections.len() == 0 then
              aty_o = mir_opt_local_type(f, p.local.id)
            end
            ()
          when MirCallValue::Value(op) then
            match op.kind
            when MirOperandKind::MirCopy(pl) then aty_o = mir_opt_local_type(f, pl.local.id)
            when MirOperandKind::MirMovePlace(pl) then aty_o = mir_opt_local_type(f, pl.local.id)
            when MirOperandKind::MirRead(pl) then aty_o = mir_opt_local_type(f, pl.local.id)
            when MirOperandKind::MirConsume(pl) then aty_o = mir_opt_local_type(f, pl.local.id)
            when MirOperandKind::MirConstant(cst) then aty_o = Option::Some(cst.ty.clone())
            end
            ()
          end
          match aty_o
          when Option::Some(aty) then
            if lir_ty_is_payloaded_enum(type_defs, aty) then
              return Result::Err("lir: function " + f.name + " calls extern `" + target + "` with a payloaded-enum argument " + ai.to_string() + ": " + lir_enum_crossing_rule())
            end
          when Option::None then ()
          end
          ai = ai + 1
        end
      end
      ()
    when _ then ()
    end
    bi = bi + 1
  end
  Result::Ok(())
end

# Convert the final text labels into local symbols and assemble the
# ObjectFile (the generate_native/generate_executable layout: sorted
# label-name iteration for deterministic symbol order).
def lir_object_file(inout ctx: CodegenCtx, target: AsmTarget) -> ObjectFile
  var all_symbols: Vec[AsmSymbol] = Vec::new()
  var si = 0
  while si < ctx.text.symbols.len() do
    all_symbols.push(ctx.text.symbols[si].clone())
    si = si + 1
  end
  var bi = 0
  while bi < ctx.data.symbols.len() do
    all_symbols.push(ctx.data.symbols[bi].clone())
    bi = bi + 1
  end
  var ri = 0
  while ri < ctx.rodata.symbols.len() do
    all_symbols.push(ctx.rodata.symbols[ri].clone())
    ri = ri + 1
  end
  var bss_i = 0
  while bss_i < ctx.bss_symbols.len() do
    all_symbols.push(ctx.bss_symbols[bss_i].clone())
    bss_i = bss_i + 1
  end
  # Convert .rodata labels to symbols (deterministic order).
  let rodata_labels = ctx.rodata.labels
  var rodata_names: Vec[String] = Vec::new()
  for (rname, _) in rodata_labels do
    rodata_names.push(rname)
  end
  rodata_names.sort()
  var rn = 0
  while rn < rodata_names.len() do
    match rodata_labels.get(rodata_names[rn])
    when Option::Some(offset) then
      all_symbols.push(AsmSymbol {
        name: rodata_names[rn].clone(),
        section: Section::Rodata,
        offset: offset,
        size: 0,
        binding: SymBinding::Local,
        kind: SymKind::Data
      })
    when Option::None then ()
    end
    rn = rn + 1
  end
  # Convert .L text labels (block labels and local runtime labels) to
  # local function symbols. (P1-18 @cold): a label defined inside the
  # cold tail ([ctx.cold_text_start, len) — the attr_cold function
  # bodies of the deferred cold pass) belongs to the cold section,
  # exactly like the function symbols lir_emit_fn routed there.
  let text_labels = ctx.text.labels
  var text_names: Vec[String] = Vec::new()
  for (tname, _) in text_labels do
    text_names.push(tname)
  end
  text_names.sort()
  var tn = 0
  while tn < text_names.len() do
    if text_names[tn].starts_with(".L") then
      match text_labels.get(text_names[tn])
      when Option::Some(offset) then
        let label_section = if ctx.cold_text_start >= 0 && offset >= ctx.cold_text_start then Section::ColdText else Section::Text end
        all_symbols.push(AsmSymbol {
          name: text_names[tn].clone(),
          section: label_section,
          offset: offset,
          size: 0,
          binding: SymBinding::Local,
          kind: SymKind::Func
        })
      when Option::None then ()
      end
    end
    tn = tn + 1
  end
  let text_relocs = ctx.text.relocations
  let data_relocs = ctx.data.relocations
  ObjectFile {
    target: target.clone(),
    text: ctx.text.bytes,
    data: ctx.data.bytes,
    rodata: ctx.rodata.bytes,
    bss_size: ctx.bss_size,
    symbols: all_symbols,
    relocations: text_relocs.clone(),
    data_relocations: data_relocs.clone(),
    string_table: Vec::new(),
    strings: Map::new(),
    cold_start: ctx.cold_text_start
  }
end

# (P1-18 @cold) Lower and emit ONE program function on the aarch64
# LIR route: the extern-boundary enum guard, the program-level lowering
# (lower_mir_fn_to_lir_prog — the a64 div/width model and the
# aggregate/deinit slices), the callee validation, the peephole, the
# register allocation and lir_emit_fn. Shared by the whole-program
# drivers' two function passes (the hot pass and the deferred @cold
# pass — see lir_compile_object / lir_link_object), so every function
# takes the identical lowering path whichever pass emits it.
def lir_lower_emit_prog_a64(inout ctx: CodegenCtx, f: MirFunction, type_defs: Map[Int, MirTypeDef], deinit_plans: Map[String, DeinitPlan], finalizer_names: Map[Int, String], glue_names: Set[String], externs: Set[String], defined: Set[String]) -> Result[Unit, String]
  match lir_check_extern_enum_calls(f, type_defs, externs)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let lir_fn = match lower_mir_fn_to_lir_prog(f, type_defs, deinit_plans, finalizer_names, glue_names, ctx.static_labels)
  when Result::Err(e) then
    return Result::Err(e)
  when Result::Ok(lf) then lf
  end
  match lir_validate_callees(lir_fn, defined, externs)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let peeped = lir_peephole(lir_fn)
  let alloc = lir_alloc_registers_a64(peeped)
  lir_emit_fn(&mut ctx, peeped, alloc, externs, defined)
  Result::Ok(())
end

# Compile the whole program through LIR into an object file's bytes.
# Only reachable through the driver's default-off gate — the direct
# emitter is untouched. Program statics lower through the scalar
# subset (see the statics section above): the .data/.bss emission
# mirrors codegen_static's scalar layout, and text references
# (MirStaticRef reads) emit the ADRP+ADD relocation pair + LDR against
# the emitted symbols.
def lir_compile_object(program: MirProgram, target: AsmTarget) -> Result[Vec[u8], String]
  if target.arch != Arch::AArch64 then
    return Result::Err("lir: the LIR route is aarch64-only in this slice (machine legalization for x86-64 is not implemented)")
  end
  var ctx = codegen_new(target)
  # The whole-program static label table (DefId-render -> emission
  # name) — the SAME table the direct emitter's codegen_program builds
  # (and with it the same unique-pairing constraint: a static
  # reference's type must pair with exactly one program static). The
  # MirStaticRef lowering resolves through it; the statics themselves
  # are emitted right after, so the symbols exist before any function
  # body references them.
  var static_labels: Map[String, String] = Map::new()
  build_static_label_table(program, &mut static_labels)
  ctx.static_labels = static_labels
  match lir_emit_program_statics_a64(&mut ctx, program)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var externs: Set[String] = Set::new()
  var defined: Set[String] = Set::new()
  # The program's MirTypeDef table (TypeId.id -> def): the aggregate
  # slice's gate resolves plain-struct locals through it.
  var type_defs: Map[Int, MirTypeDef] = Map::new()
  var tdi = 0
  while tdi < program.types.len() do
    type_defs.insert(program.types[tdi].id.id, program.types[tdi].clone())
    tdi = tdi + 1
  end
  # The program's deinit tables (the MirDeinit slice): the CONCRETE
  # deinit plans (mir_type_identity_key -> DeinitPlan — the drop-glue
  # authority codegen.tg consumes) and the finalizer identity table
  # (def_id_numeric -> the mangled emission name of every registered
  # finalizer function — MirProgram.method_names_by_def).
  let deinit_plans = program.deinit_plans.clone()
  let finalizer_names = program.method_names_by_def.clone()
  # The generated drop-glue name set (the generated drop-glue
  # admission — see lir_check_fn_shape): the emission names of the
  # (ptr: Ptr[T], mask: Int) glue bodies MirProgram.functions carries
  # (MirProgram.drop_glue_fns maps the glue identities to these names —
  # the same authority codegen's codegen_deinit_label consumes). The
  # whole-program lowering admits exactly these functions' Ptr-typed
  # head parameters.
  var glue_names: Set[String] = Set::new()
  for (_, glue_nm) in program.drop_glue_fns do
    glue_names.insert(glue_nm.clone())
  end
  var fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      externs.insert(f.name.clone())
    else
      defined.insert(f.name.clone())
    end
    fi = fi + 1
  end
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      # Extern functions get no body — an undefined symbol entry so the
      # linker resolves them (the direct emitter's extern convention).
      add_symbol(&mut ctx.text, AsmSymbol {
        name: f.name.clone(),
        section: Section::Extern,
        offset: 0,
        size: 0,
        binding: SymBinding::Global,
        kind: SymKind::Func
      })
    else if !f.attr_cold then
      # (P1-18 @cold — the HOT pass): every function whose body is not
      # @cold lowers and emits here (program order). An attr_cold
      # function is DEFERRED to the cold pass below, which emits the
      # @cold bodies as a contiguous tail of the code stream after the
      # runtime merge — the .text.cold region the symbol registration
      # in lir_emit_fn routes them into (Section::ColdText). Programs
      # without @cold functions take the cold pass as a zero-iteration
      # no-op and the stream is byte-identical to the pre-@cold layout.
      match lir_lower_emit_prog_a64(&mut ctx, f, type_defs, deinit_plans, finalizer_names, glue_names, externs, defined)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
    fi = fi + 1
  end

  # Runtime helpers (mirror codegen_program's tail order: string helpers,
  # the full runtime buffer merge, RET stubs for any leftover fixup
  # label, then fixup resolution).
  emit_runtime_str_concat(&mut ctx)
  emit_runtime_str_chars(&mut ctx)
  var runtime_ctx = runtime_ctx_new(target.clone())
  emit_all_runtime(&mut runtime_ctx)
  merge_code_buffer(&mut ctx.text, &runtime_ctx.text)

  # (P1-18 @cold — the deferred COLD pass): lower and emit the
  # attr_cold function bodies HERE, after the runtime merge, so they
  # form the contiguous cold tail of the code stream (the .text.cold
  # region; ctx.cold_text_start records its start for the object
  # assembly). The cold bodies' labels, fixups, relocations and symbols
  # all ride ctx.text exactly like the hot pass's — the single-stream
  # geometry is unchanged, only the position of the cold functions
  # moves to the tail (branch deltas are recomputed at the final
  # resolve_fixups below against the final positions), and the runtime
  # labels they call were defined by the merge above. The stub scan
  # below then covers the cold bodies' fixups too (the stubs it emits
  # close the cold tail, still inside the region). Programs without
  # @cold functions take this pass as a zero-iteration no-op.
  var has_cold_fn = false
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if !f.is_extern && f.attr_cold then
      has_cold_fn = true
    end
    fi = fi + 1
  end
  if has_cold_fn then
    ctx.cold_text_start = buf_pos(&ctx.text)
    fi = 0
    while fi < program.functions.len() do
      let f = program.functions[fi]
      if !f.is_extern && f.attr_cold then
        match lir_lower_emit_prog_a64(&mut ctx, f, type_defs, deinit_plans, finalizer_names, glue_names, externs, defined)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
      fi = fi + 1
    end
  end
  var fi2 = 0
  while fi2 < ctx.text.fixups.len() do
    let fix = ctx.text.fixups[fi2]
    match ctx.text.labels.get(fix.label.clone())
    when Option::None then
      align_to(&mut ctx.text, 4, Arch::AArch64)
      def_label(&mut ctx.text, fix.label.clone())
      a64_ret(&mut ctx.text)
    when Option::Some(_) then ()
    end
    fi2 = fi2 + 1
  end
  match resolve_fixups(&mut ctx.text)
  when Result::Err(e) then
    return Result::Err("lir: fixup resolution failed: " + e)
  when Result::Ok(_) then ()
  end

  # Data sections (argc/argv/envp slots and the free-list allocator
  # state) — the codegen.tg helpers keep the .data layout identical to
  # the direct pipeline, so a LIR object links against the same runtime.
  emit_argc_argv_data(&mut ctx)
  emit_allocator_runtime_data(&mut ctx)

  let obj = lir_object_file(&mut ctx, target)
  let obj_bytes = build_object(&obj)
  Result::Ok(obj_bytes)
end

# Compile the whole program through LIR and link an executable (the
# entry selection mirrors generate_executable).
def lir_compile_executable(program: MirProgram, target: AsmTarget, output_path: String) -> Result[Unit, String]
  lir_link_object(program, target, output_path)
end

# The executable route shares lir_compile_object's emission and then
# performs the link (entry by OS, mirroring generate_executable).
# Program statics lower exactly as in lir_compile_object (the scalar
# subset; the linked executable's internal linker resolves the static
# references' ADRP/ADD pairs and the .data/.bss symbols like the
# direct emitter's _tg_saved_* references).
def lir_link_object(program: MirProgram, target: AsmTarget, output_path: String) -> Result[Unit, String]
  var ctx = codegen_new(target.clone())
  # The whole-program static label table + the statics' data emission
  # (the lir_compile_object wiring — the table feeds MirStaticRef
  # lowering, the emission registers the .data/.bss symbols).
  var static_labels: Map[String, String] = Map::new()
  build_static_label_table(program, &mut static_labels)
  ctx.static_labels = static_labels
  match lir_emit_program_statics_a64(&mut ctx, program)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var externs: Set[String] = Set::new()
  var defined: Set[String] = Set::new()
  var type_defs: Map[Int, MirTypeDef] = Map::new()
  var tdi = 0
  while tdi < program.types.len() do
    type_defs.insert(program.types[tdi].id.id, program.types[tdi].clone())
    tdi = tdi + 1
  end
  # The program's deinit tables (the MirDeinit slice — same wiring as
  # lir_compile_object).
  let deinit_plans = program.deinit_plans.clone()
  let finalizer_names = program.method_names_by_def.clone()
  # The generated drop-glue name set (same wiring as lir_compile_object —
  # the generated drop-glue admission of lir_check_fn_shape).
  var glue_names: Set[String] = Set::new()
  for (_, glue_nm) in program.drop_glue_fns do
    glue_names.insert(glue_nm.clone())
  end
  var fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      externs.insert(f.name.clone())
    else
      defined.insert(f.name.clone())
    end
    fi = fi + 1
  end
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      add_symbol(&mut ctx.text, AsmSymbol {
        name: f.name.clone(),
        section: Section::Extern,
        offset: 0,
        size: 0,
        binding: SymBinding::Global,
        kind: SymKind::Func
      })
    else if !f.attr_cold then
      # (P1-18 @cold — the HOT pass, mirroring lir_compile_object):
      # non-@cold bodies lower and emit here; attr_cold functions are
      # deferred to the COLD pass below (after the runtime merge) so
      # their bodies form the stream's contiguous cold tail — the
      # .text.cold region their symbols are routed into (see
      # lir_emit_fn's Section::ColdText registration). Programs without
      # @cold functions take the cold pass as a zero-iteration no-op.
      match lir_lower_emit_prog_a64(&mut ctx, f, type_defs, deinit_plans, finalizer_names, glue_names, externs, defined)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
    fi = fi + 1
  end
  emit_runtime_str_concat(&mut ctx)
  emit_runtime_str_chars(&mut ctx)
  var runtime_ctx = runtime_ctx_new(target.clone())
  emit_all_runtime(&mut runtime_ctx)
  merge_code_buffer(&mut ctx.text, &runtime_ctx.text)

  # (P1-18 @cold — the deferred COLD pass, mirroring
  # lir_compile_object): lower and emit the attr_cold function bodies
  # after the runtime merge so they form the contiguous cold tail of
  # the code stream; ctx.cold_text_start records the region's start
  # for the object assembly. The stub scan below covers the cold
  # bodies' fixups too.
  var has_cold_fn = false
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if !f.is_extern && f.attr_cold then
      has_cold_fn = true
    end
    fi = fi + 1
  end
  if has_cold_fn then
    ctx.cold_text_start = buf_pos(&ctx.text)
    fi = 0
    while fi < program.functions.len() do
      let f = program.functions[fi]
      if !f.is_extern && f.attr_cold then
        match lir_lower_emit_prog_a64(&mut ctx, f, type_defs, deinit_plans, finalizer_names, glue_names, externs, defined)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
      fi = fi + 1
    end
  end
  var fi2 = 0
  while fi2 < ctx.text.fixups.len() do
    let fix = ctx.text.fixups[fi2]
    match ctx.text.labels.get(fix.label.clone())
    when Option::None then
      align_to(&mut ctx.text, 4, Arch::AArch64)
      def_label(&mut ctx.text, fix.label.clone())
      a64_ret(&mut ctx.text)
    when Option::Some(_) then ()
    end
    fi2 = fi2 + 1
  end
  match resolve_fixups(&mut ctx.text)
  when Result::Err(e) then
    return Result::Err("lir: fixup resolution failed: " + e)
  when Result::Ok(_) then ()
  end
  emit_argc_argv_data(&mut ctx)
  emit_allocator_runtime_data(&mut ctx)

  let obj = lir_object_file(&mut ctx, target.clone())
  let entry = match target.os
  when OsAbi::MacOS then "main"
  when OsAbi::Linux then "_start"
  when OsAbi::Windows then "mainCRTStartup"
  end
  var objects: Vec[ObjectFile] = Vec::new()
  objects.push(obj)
  let input = LinkerInput {
    objects: objects,
    entry: entry.to_string(),
    entry_offset: -1,
    output: output_path,
    target: target.clone()
  }
  let link_result = link_executable(&input)
  link_result
end
