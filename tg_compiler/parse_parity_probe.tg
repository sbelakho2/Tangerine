# tg_compiler/parse_parity_probe.tg — kernel-grammar parse-parity probe.
#
# The bootstrap authority is the kernel parser (tg_compiler/parser.tg) produced
# by the OCaml seed; the closure it must parse is bootstrap/compiler_kernel.manifest.
# A grammar divergence between the seed parser and the kernel parser surfaces
# only after the whole stage1 build (tens of minutes). This probe runs the REAL
# kernel lexer + parser over every closure source inside the seed VM and
# reports every file whose parse records error diagnostics — the parse-parity
# gate catches this class (std/bench.tg's match-tail `end  end  end`) in ~1
# minute instead of the full ladder.
#
# The probe resolves the closure from bootstrap/compiler_kernel.manifest itself
# (std:/compiler: entries, resolved against the harness repo root), so the gate
# cannot drift from the manifest the bootstrap compiles. Kernel args are unused
# beyond the conventional leading marker.
#
# It ALSO enforces the deliberate grammar-conformance corpus
# (tests/grammar_conformance/manifest.txt): every `accept` specimen must parse
# with zero error diagnostics and every `reject` specimen must record at least
# one. The same corpus runs through the OCaml seed parser in the tg_parse_parity
# harness, so a spec decision is enforced on BOTH implementations.
#
# main returns 0 iff every closure file parsed clean AND every corpus
# expectation held; 1 otherwise. The per-file rows (path + diagnostic message +
# byte offset) are written to build/parse_parity_report.txt and echoed to
# stdout.

use std::core::{Option, Result, String}
use std::collections::{Vec}
use std::fs::{read_file, write_file}
use std::io::{println}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}

def parse_parity_collect_paths(source: String) -> Vec[String]
  var paths = Vec::new()
  for line in source.split("\n") do
    let trimmed = line.trim()
    if !trimmed.is_empty() && !trimmed.starts_with("#") then
      match trimmed.split_once(" ")
      when Option::Some(parts) then
        let kind = parts.0.trim()
        let rel = parts.1.trim()
        if kind == "std:" then
          paths.push("std/" + rel)
        elsif kind == "compiler:" then
          paths.push("tg_compiler/" + rel)
        end
      when Option::None then ()
      end
    end
  end
  paths
end

# Split the corpus manifest into parallel verb/path vectors. Verbs are
# "accept" (must parse with zero error diagnostics) or "reject" (must record
# at least one); any other non-comment directive is a malformed manifest and
# the probe fails closed.
def grammar_corpus_collect(source: String, inout verbs: Vec[String], inout paths: Vec[String], inout malformed: Vec[String]) -> Unit
  for line in source.split("\n") do
    let trimmed = line.trim()
    if !trimmed.is_empty() && !trimmed.starts_with("#") then
      match trimmed.split_once(" ")
      when Option::Some(parts) then
        let verb = parts.0.trim()
        let rel = parts.1.trim()
        if (verb == "accept" || verb == "reject") && !rel.is_empty() then
          verbs.push(verb)
          paths.push(rel)
        else
          malformed.push(trimmed.clone())
        end
      when Option::None then
        malformed.push(trimmed.clone())
      end
    end
  end
end

def parse_parity_diag_rows(inout report: String, parsed: ParseOutput) -> Unit
  for d in parsed.diagnostics do
    match d.span
    when Option::Some(sp) then
      report = report + "  @" + sp.start.to_string() + ": " + d.message + "\n"
      println("  @" + sp.start.to_string() + ": " + d.message)
    when Option::None then
      report = report + "  " + d.message + "\n"
      println("  " + d.message)
    end
  end
end

def main() -> Int
  let manifest_src = match read_file("bootstrap/compiler_kernel.manifest")
  when Result::Ok(s) then s
  when Result::Err(_) then
    println("parse-parity: READ FAIL bootstrap/compiler_kernel.manifest")
    return 1
  end
  let paths = parse_parity_collect_paths(manifest_src)
  if paths.is_empty() then
    println("parse-parity: FAIL no std:/compiler: closure entries in bootstrap/compiler_kernel.manifest")
    return 1
  end

  let report_path = "build/parse_parity_report.txt"
  var report = ""
  mut bad = 0
  mut clean = 0
  mut i = 0
  while i < paths.len() do
    let path = paths[i].clone()
    match read_file(path.clone())
    when Result::Ok(source) then
      let parsed = parse(tokenize(source, path.clone()))
      if diag_has_errors(&parsed.diagnostics) then
        bad = bad + 1
        report = report + "FAIL " + path + " (" + parsed.diagnostics.len().to_string() + " diagnostics)\n"
        println("parse-parity: FAIL " + path + " (" + parsed.diagnostics.len().to_string() + " diagnostics)")
        parse_parity_diag_rows(&mut report, &parsed)
      else
        clean = clean + 1
      end
    when Result::Err(_) then
      bad = bad + 1
      report = report + "READ FAIL " + path + "\n"
      println("parse-parity: READ FAIL " + path)
    end
    i = i + 1
  end

  # ——— grammar-conformance corpus (tests/grammar_conformance/manifest.txt) ———
  # The kernel side of the corpus decision: `accept` must parse clean, and
  # `reject` must produce at least one error diagnostic. The same expectations
  # are enforced for the seed parser by the tg_parse_parity harness.
  var corpus_verbs = Vec::new()
  var corpus_paths = Vec::new()
  var corpus_malformed = Vec::new()
  let corpus_manifest_path = "tests/grammar_conformance/manifest.txt"
  let corpus_src = match read_file(corpus_manifest_path.clone())
  when Result::Ok(s) then s
  when Result::Err(_) then
    report = report + "CORPUS READ FAIL " + corpus_manifest_path + "\n"
    println("parse-parity: CORPUS READ FAIL " + corpus_manifest_path)
    match write_file(report_path.clone(), report)
    when Result::Ok(_) then ()
    when Result::Err(_) then ()
    end
    return 1
  end
  grammar_corpus_collect(corpus_src, &mut corpus_verbs, &mut corpus_paths, &mut corpus_malformed)
  mut corpus_bad = 0
  mut corpus_accept = 0
  mut corpus_reject = 0
  if corpus_malformed.len() > 0 then
    corpus_bad = corpus_bad + 1
    for row in corpus_malformed do
      report = report + "CORPUS MALFORMED DIRECTIVE: " + row + "\n"
      println("parse-parity: CORPUS MALFORMED DIRECTIVE: " + row)
    end
  end
  if corpus_paths.is_empty() then
    corpus_bad = corpus_bad + 1
    report = report + "CORPUS EMPTY " + corpus_manifest_path + " (no accept/reject cases)\n"
    println("parse-parity: CORPUS EMPTY " + corpus_manifest_path)
  end
  mut c = 0
  while c < corpus_paths.len() do
    let verb = corpus_verbs[c].clone()
    let rel = corpus_paths[c].clone()
    let full = "tests/grammar_conformance/" + rel.clone()
    if verb == "accept" then
      corpus_accept = corpus_accept + 1
    else
      corpus_reject = corpus_reject + 1
    end
    match read_file(full.clone())
    when Result::Ok(source) then
      let parsed = parse(tokenize(source, full.clone()))
      let has_errors = diag_has_errors(&parsed.diagnostics)
      if verb == "accept" && has_errors then
        corpus_bad = corpus_bad + 1
        report = report + "FAIL accept " + rel + " (" + parsed.diagnostics.len().to_string() + " diagnostics)\n"
        println("parse-parity: FAIL accept " + rel + " (" + parsed.diagnostics.len().to_string() + " diagnostics)")
        parse_parity_diag_rows(&mut report, &parsed)
      elsif verb == "reject" && !has_errors then
        corpus_bad = corpus_bad + 1
        report = report + "FAIL reject " + rel + " (parsed with ZERO diagnostics)\n"
        println("parse-parity: FAIL reject " + rel + " (parsed with ZERO diagnostics)")
      end
    when Result::Err(_) then
      corpus_bad = corpus_bad + 1
      report = report + "CORPUS READ FAIL " + full + "\n"
      println("parse-parity: CORPUS READ FAIL " + full)
    end
    c = c + 1
  end

  if bad > 0 || corpus_bad > 0 then
    report = report + "parse-parity: FAILED (" + bad.to_string() + " closure file(s) with grammar diagnostics, " + clean.to_string() + " clean; corpus " + corpus_bad.to_string() + " failure(s) over " + corpus_accept.to_string() + " accept / " + corpus_reject.to_string() + " reject cases)\n"
    match write_file(report_path.clone(), report)
    when Result::Ok(_) then ()
    when Result::Err(_) then ()
    end
    println("parse-parity: FAILED (" + bad.to_string() + " closure file(s) with grammar diagnostics, " + clean.to_string() + " clean; corpus " + corpus_bad.to_string() + " failure(s) over " + corpus_accept.to_string() + " accept / " + corpus_reject.to_string() + " reject cases)")
    return 1
  end
  let ok_row = "OK " + clean.to_string() + " closure files parsed clean by the kernel parser; corpus " + corpus_accept.to_string() + " accept / " + corpus_reject.to_string() + " reject cases agreed\n"
  match write_file(report_path.clone(), ok_row)
  when Result::Ok(_) then ()
  when Result::Err(_) then ()
  end
  println("parse-parity: OK (" + clean.to_string() + " closure files parsed clean; corpus " + corpus_accept.to_string() + " accept / " + corpus_reject.to_string() + " reject cases agreed)")
  0
end
