    (MirBinOp::BitOr, 0x72), (MirBinOp::BitXor, 0x73), (MirBinOp::Shl, 0x74),
    (MirBinOp::Shr, 0x75), (MirBinOp::Eq, 0x46), (MirBinOp::Ne, 0x47),
