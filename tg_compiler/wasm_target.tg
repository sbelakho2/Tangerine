@test
def test_wasm_binop_unsupported_diagnostics() -> Unit
  ## the float-family gaps: wasm has no bitwise float opcodes.
  wasm_test_check(_wasm_test_compile_error(_wasm_test_binop_program(MirBinOp::BitAnd, Type::Float)) ==
    "unsupported MIR binop BitAnd for the wasm f64 operand family", "f64 BitAnd fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(_wasm_test_binop_program(MirBinOp::Mod, Type::F32)) ==
    "unsupported MIR binop Mod for the wasm f32 operand family", "f32 Mod fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(_wasm_test_binop_program(MirBinOp::Shl, Type::Float)) ==
    "unsupported MIR binop Shl for the wasm f64 operand family", "f64 Shl fails with the stable diagnostic")
  ## mixed operand families: no promotion exists — fail closed.
  let mixed = _wasm_test_rvalue_program("f_mixed", Type::Int, vec![Type::Int, Type::I32],
    MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Add, operand_copy_local(MirLocalId { id: 1 }), operand_copy_local(MirLocalId { id: 2 })) })
  wasm_test_check(_wasm_test_compile_error(mixed) ==
    "unsupported MIR binop Add on mixed wasm operand types (i32, i64) for the wasm target", "mixed-family binop fails with the stable diagnostic")
end

@test
def test_wasm_unop_table() -> Unit
  ## the integer families: Neg/Not/BitNot are real.
  let body_neg_i64 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Neg, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_neg_i64, vec![0x7E]), "Neg on i64 emits i64.mul (0x7E)")
  let body_not_i64 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Not, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_not_i64, vec![0x50]), "Not on i64 emits i64.eqz (0x50)")
  let body_bn_i64 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::BitNot, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_bn_i64, vec![0x85]), "BitNot on i64 emits i64.xor (0x85)")
  let body_neg_i32 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Neg, Type::I32)))
  wasm_test_check(_wasm_test_contains(body_neg_i32, vec![0x6C]), "Neg on i32 emits i32.mul (0x6C)")
  let body_not_i32 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Not, Type::I32)))
  wasm_test_check(_wasm_test_contains(body_not_i32, vec![0x45]), "Not on i32 emits i32.eqz (0x45)")
  let body_bn_i32 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::BitNot, Type::I32)))
  wasm_test_check(_wasm_test_contains(body_bn_i32, vec![0x73]), "BitNot on i32 emits i32.xor (0x73)")
  ## the float families: Neg is real, Not/BitNot are the explicit
  ## Unsupported diagnostics.
  let body_neg_f64 = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Neg, Type::Float)))
  wasm_test_check(_wasm_test_contains(body_neg_f64, vec![0x9A]), "Neg on f64 emits f64.neg (0x9A)")
  wasm_test_check(_wasm_test_compile_error(_wasm_test_unop_program(MirUnOp::Not, Type::Float)) ==
    "unsupported MIR unop Not for the wasm target", "Not on f64 fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(_wasm_test_unop_program(MirUnOp::BitNot, Type::F32)) ==
    "unsupported MIR unop BitNot for the wasm target", "BitNot on f32 fails with the stable diagnostic")
end

@test
def test_wasm_cast_table() -> Unit
  ## the convertible pairs emit the real conversion opcodes.
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::IntToInt, Type::I32, Type::Int))), vec![0xAC]),
    "IntToInt i32 -> i64 emits i64.extend_i32_s (0xAC)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::IntToInt, Type::Int, Type::I32))), vec![0xA7]),
    "IntToInt i64 -> i32 emits i32.wrap_i64 (0xA7)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::IntToFloat, Type::I32, Type::F32))), vec![0xB2]),
    "IntToFloat i32 -> f32 emits f32.convert_i32_s (0xB2)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::IntToFloat, Type::Int, Type::Float))), vec![0xB9]),
    "IntToFloat i64 -> f64 emits f64.convert_i64_s (0xB9)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::FloatToInt, Type::Float, Type::Int))), vec![0xB0]),
    "FloatToInt f64 -> i64 emits i64.trunc_f64_s (0xB0)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::FloatToInt, Type::F32, Type::I32))), vec![0xA8]),
    "FloatToInt f32 -> i32 emits i32.trunc_f32_s (0xA8)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::FloatToFloat, Type::Float, Type::F32))), vec![0xB6]),
    "FloatToFloat f64 -> f32 emits f32.demote_f64 (0xB6)")
  wasm_test_check(_wasm_test_contains(_wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::FloatToFloat, Type::F32, Type::Float))), vec![0xBB]),
    "FloatToFloat f32 -> f64 emits f64.promote_f32 (0xBB)")
  ## the same-family casts are identity — NO conversion opcode is emitted.
  let body_id = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_cast_program(CastKind::IntToInt, Type::Int, Type::Int)))
  wasm_test_check(!_wasm_test_contains(body_id, vec![0xAC]) && !_wasm_test_contains(body_id, vec![0xA7]),
    "IntToInt within the i64 family is the identity (no conversion opcode)")
  ## Pointer casts: every pointer is an i32 linear address — identity.
  let _ = _wasm_test_compile(_wasm_test_cast_program(CastKind::Pointer, Type::Ptr(Type::U8), Type::Ptr(Type::U8)))
  ## the gap pairs and Transmute are the explicit Unsupported diagnostics.
  wasm_test_check(_wasm_test_compile_error(_wasm_test_cast_program(CastKind::Transmute, Type::Int, Type::Int)) ==
    "unsupported MIR rvalue MirCast (Transmute i64 -> i64) for the wasm target", "Transmute fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(_wasm_test_cast_program(CastKind::IntToFloat, Type::Int, Type::I32)) ==
    "unsupported MIR rvalue MirCast (IntToFloat i64 -> i32) for the wasm target", "the IntToFloat i64 -> i32 gap fails with the stable diagnostic")
end

@test
def test_wasm_rvalues_unsupported_diagnostics() -> Unit
  ## MirLen on a non-fixed-array source: no wasm length metadata — fail
  ## closed, never a pushed zero.
  let prog_len = _wasm_test_rvalue_program("f_len_bad", Type::Int, vec![Type::Int, Type::String],
    MirRvalue { kind: MirRvalueKind::MirLen(place_local(MirLocalId { id: 1 })) })
  wasm_test_check(_wasm_test_compile_error(prog_len) ==
    "unsupported MIR rvalue MirLen for the wasm target", "MirLen on a non-fixed-array source fails with the stable diagnostic")
  ## MirPhi: the wasm dispatch model has no phi placement — fail closed.
  let prog_phi = _wasm_test_rvalue_program("f_phi", Type::Int, vec![Type::Int],
    MirRvalue { kind: MirRvalueKind::MirPhi(vec![]) })
  wasm_test_check(_wasm_test_compile_error(prog_phi) ==
    "unsupported MIR rvalue MirPhi for the wasm target", "MirPhi fails with the stable diagnostic")
end

@test
def test_wasm_constants_table() -> Unit
  ## the SUPPORTED constants emit their real values.
  let body_int = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_cint", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(_wasm_test_int_constant(7)) }) })))
  wasm_test_check(_wasm_test_contains(body_int, vec![0x42, 0x07]), "MirInt(7) emits i64.const 7 (0x42 0x07)")
  let body_bool = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_cbool", Type::Bool, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(_wasm_test_bool_constant(true)) }) })))
  wasm_test_check(_wasm_test_contains(body_bool, vec![0x41, 0x01]), "MirBool(true) emits i32.const 1 (0x41 0x01)")
  ## MirUnit / MirZeroSized are zero-sized: no machine value — the compile
  ## succeeds without any push.
  let _ = _wasm_test_compile(
    _wasm_test_rvalue_program("f_cunit", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(
        MirConstant { kind: MirConstantKind::MirUnit, ty: Type::Unit, instance: Option::None }) }) }))
  let _ = _wasm_test_compile(
    _wasm_test_rvalue_program("f_czs", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(
        MirConstant { kind: MirConstantKind::MirZeroSized, ty: Type::Unit, instance: Option::None }) }) }))
  ## the UNSUPPORTED constants fail the compilation with the stable
  ## diagnostics — never a pushed zero.
  wasm_test_check(_wasm_test_compile_error(
    _wasm_test_rvalue_program("f_cfn", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(
        MirConstant { kind: MirConstantKind::MirFnItem("f".to_string()), ty: Type::Int, instance: Option::None }) }) })) ==
    "unsupported MIR constant MirFnItem for the wasm target", "MirFnItem fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(
    _wasm_test_rvalue_program("f_csr", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(
        MirConstant { kind: MirConstantKind::MirStaticRef(DefId { module: ModuleId { id: 0 }, index: 0 }), ty: Type::Int, instance: Option::None }) }) })) ==
    "unsupported MIR constant MirStaticRef for the wasm target", "MirStaticRef fails with the stable diagnostic")
  wasm_test_check(_wasm_test_compile_error(
    _wasm_test_rvalue_program("f_csa", Type::Int, vec![],
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirConstant(
        MirConstant { kind: MirConstantKind::MirStaticAddr(DefId { module: ModuleId { id: 0 }, index: 0 }), ty: Type::Int, instance: Option::None }) }) })) ==
    "unsupported MIR constant MirStaticAddr for the wasm target", "MirStaticAddr fails with the stable diagnostic")
end

@test
def test_wasm_statements_supported() -> Unit
  ## MirAssign: the real store.
  let body_assign = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_binop_program(MirBinOp::Add, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_assign, vec![0x7C]), "MirAssign emits the rvalue's real opcode")

  ## MirContractCheck: SUPPORTED — the condition is tested and a failure
  ## TRAPS (i32.eqz / if / unreachable / end — the MirAssert shape).
  var contract_locals = Vec::new()
  contract_locals.push(_wasm_test_local(0, "_0", Type::Unit))
  contract_locals.push(_wasm_test_local(1, "c", Type::Bool))
  var contract_stmts = Vec::new()
  contract_stmts.push(MirStatement {
    kind: MirStatementKind::MirContractCheck(
      MirContract { kind: MirContractKind::Pre, condition: operand_copy_local(MirLocalId { id: 1 }), message: "".to_string(), span: span_dummy() },
      operand_copy_local(MirLocalId { id: 1 })),
    span: span_dummy()
  })
  let body_contract = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_stmt_program("f_contract", Type::Unit, contract_locals, contract_stmts)))
  wasm_test_check(_wasm_test_contains(body_contract, vec![0x45, 0x04, 0x40, 0x00, 0x0B]),
    "MirContractCheck emits the i32.eqz / if / unreachable / end trap check")

  ## MirStorageLive / MirStorageDead / MirNop: SUPPORTED with their real
  ## semantics (the statically allocated slots need no machine emission) —
  ## the compile succeeds and no no-op fallthrough exists.
  var stmt_locals = Vec::new()
  stmt_locals.push(_wasm_test_local(0, "_0", Type::Unit))
  stmt_locals.push(_wasm_test_local(1, "t", Type::Int))
  var stmt_list = Vec::new()
  stmt_list.push(MirStatement { kind: MirStatementKind::MirStorageLive(MirLocalId { id: 1 }), span: span_dummy() })
  stmt_list.push(MirStatement { kind: MirStatementKind::MirNop, span: span_dummy() })
  stmt_list.push(MirStatement { kind: MirStatementKind::MirStorageDead(MirLocalId { id: 1 }), span: span_dummy() })
  let _ = _wasm_test_compile(_wasm_test_stmt_program("f_storage", Type::Unit, stmt_locals, stmt_list))
end

@test
def test_wasm_statements_unsupported_diagnostics() -> Unit
  var base_locals = Vec::new()
  base_locals.push(_wasm_test_local(0, "_0", Type::Unit))
  var base_stmts = Vec::new()

  base_stmts = Vec::new()
  base_stmts.push(MirStatement { kind: MirStatementKind::MirBudgetConsume("alloc".to_string(), 10), span: span_dummy() })
  wasm_test_check(_wasm_test_compile_error(_wasm_test_stmt_program("f_budget", Type::Unit, base_locals.clone(), base_stmts)) ==
    "unsupported MIR statement MirBudgetConsume for the wasm target", "MirBudgetConsume fails with the stable diagnostic")

  base_stmts = Vec::new()
  base_stmts.push(MirStatement { kind: MirStatementKind::MirEffectRecord("evt".to_string(), operand_copy_local(MirLocalId { id: 0 })), span: span_dummy() })
  wasm_test_check(_wasm_test_compile_error(_wasm_test_stmt_program("f_erec", Type::Unit, base_locals.clone(), base_stmts)) ==
    "unsupported MIR statement MirEffectRecord for the wasm target", "MirEffectRecord fails with the stable diagnostic")

  base_stmts = Vec::new()
  base_stmts.push(MirStatement {
    kind: MirStatementKind::MirEffectPerform(EffectId { id: 1 }, 0, "op".to_string(),
      operand_copy_local(MirLocalId { id: 0 }), operand_copy_local(MirLocalId { id: 0 })),
    span: span_dummy()
  })
  wasm_test_check(_wasm_test_compile_error(_wasm_test_stmt_program("f_eperf", Type::Unit, base_locals.clone(), base_stmts)) ==
    "unsupported MIR statement MirEffectPerform for the wasm target", "MirEffectPerform fails with the stable diagnostic")

  base_stmts = Vec::new()
  base_stmts.push(MirStatement {
    kind: MirStatementKind::MirEffectFrameEnter(EffectId { id: 1 }, 1, 1, "disp".to_string(),
      operand_copy_local(MirLocalId { id: 0 })),
    span: span_dummy()
  })
  wasm_test_check(_wasm_test_compile_error(_wasm_test_stmt_program("f_fenter", Type::Unit, base_locals.clone(), base_stmts)) ==
    "unsupported MIR statement MirEffectFrameEnter for the wasm target", "MirEffectFrameEnter fails with the stable diagnostic")

  base_stmts = Vec::new()
  base_stmts.push(MirStatement { kind: MirStatementKind::MirEffectFrameExit, span: span_dummy() })
  wasm_test_check(_wasm_test_compile_error(_wasm_test_stmt_program("f_fexit", Type::Unit, base_locals.clone(), base_stmts)) ==
    "unsupported MIR statement MirEffectFrameExit for the wasm target", "MirEffectFrameExit fails with the stable diagnostic")
end
