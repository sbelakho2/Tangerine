## tg_compiler::wasm_target — WebAssembly compilation backend
## Compiles Tangerine MIR to WASM bytecode.
## Spec: §tooling.wasm

module tg_compiler::wasm_target

use std::core::{Option, Result, Display, panic}
use std::collections::{Map, Array}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::layout_engine::{
  LayoutEngine, LayoutError, LayoutFailureClass,
  ValueCategory, classify_value_category
}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirBlock, MirLocal,
  MirStatement, MirStatementKind,
  MirTerminator, MirTerminatorKind,
  MirRvalue, MirRvalueKind,
  MirOperand, MirOperandKind,
  MirConstant, MirConstantKind,
  MirCallArg, mir_call_arg_operand,
  MirBinOp, MirUnOp, CastKind,
  AggregateKind, Place, Projection, MirLocalId, MirBlockId
}
use tg_compiler::cross_compile::{TargetTriple, OptLevel}

# ─── WASM binary sections ───────────────────────────────────────────

pub struct WasmBinary
  pub sections: Array[WasmSection]
end

pub enum WasmSection
  Type(TypeSection)
  Import(ImportSection)
  Function(FunctionSection)
  Table(TableSection)
  Memory(MemorySection)
  Global(GlobalSection)
  Export(ExportSection)
  ## start function index
  Start(UInt)
  Element(ElementSection)
  Code(CodeSection)
  Data(DataSection)
  Custom { name: String, data: Array[u8] }
end

pub struct TypeSection
  pub types: Array[FuncType]
end

pub struct FuncType
  pub params: Array[WasmValType]
  pub results: Array[WasmValType]
end

pub enum WasmValType
  I32
  I64
  F32
  F64
  ## the host-reference type (0x6F) — the wasm-side bridge for the
  ## std::wasm ExternRef handle (see the type mapping table below)
  ExternRef
end

pub struct ImportSection
  pub imports: Array[WasmImport]
end

pub struct WasmImport
  ## "module" is a reserved keyword in Tangerine (TokenKind::Module) — the
  ## field must not shadow it or the module cannot be parsed.
  pub module_name: String
  pub name: String
  pub desc: ImportDesc
end

pub enum ImportDesc
  ## type index
  Func(UInt)
  Memory(Limits)
  Table(TableType)
  Global(GlobalType)
end

pub struct Limits
  pub min: UInt
  pub max: Option[UInt]
end

pub struct TableType
  pub element: WasmValType
  pub limits: Limits
end

pub struct GlobalType
  pub val_type: WasmValType
  pub mutable: Bool
end

pub struct FunctionSection
  pub type_indices: Array[UInt]
end

pub struct TableSection
  pub tables: Array[TableType]
end

pub struct MemorySection
  pub memories: Array[Limits]
end

pub struct GlobalSection
  ## type + init expr
  pub globals: Array[(GlobalType, Array[u8])]
end

pub struct ExportSection
  pub exports: Array[WasmExport]
end

pub struct WasmExport
  pub name: String
  pub desc: ExportDesc
end

pub enum ExportDesc
  Func(UInt)
  Memory(UInt)
  Table(UInt)
  Global(UInt)
end

pub struct ElementSection
  pub elements: Array[Element]
end

pub struct Element
  pub table_index: UInt
  ## init expr
  pub offset: Array[u8]
  pub func_indices: Array[UInt]
end

pub struct CodeSection
  pub bodies: Array[FunctionBody]
end

pub struct FunctionBody
  ## count, type
  pub locals: Array[(UInt, WasmValType)]
  ## WASM bytecode
  pub code: Array[u8]
end

pub struct DataSection
  pub segments: Array[DataSegment]
end

pub struct DataSegment
  pub memory_index: UInt
  ## init expr
  pub offset: Array[u8]
  pub data: Array[u8]
end

# ─── Compilation config ──────────────────────────────────────────────

pub struct WasmCompileConfig
  pub target: WasmTarget
  pub opt_level: OptLevel
  pub initial_memory_pages: UInt
  pub max_memory_pages: Option[UInt]
  pub export_memory: Bool
  pub import_memory: Bool
  ## bulk-memory proposal
  pub bulk_memory: Bool
  ## SIMD proposal
  pub simd: Bool
  ## threads proposal
  pub threads: Bool
  pub exception_handling: Bool
  pub stack_size: UInt
  pub strip_debug: Bool
  pub producer_section: Bool
  ## the START section: the name of the function the binary starts at
  ## (Option::None = no start section — the default)
  pub start_function: Option[String]
end

pub enum WasmTarget
  ## Freestanding wasm32
  Wasm32Unknown
  ## WASI target
  Wasm32Wasi
  Wasm32Emscripten
end

impl WasmCompileConfig
  pub def default() -> WasmCompileConfig
    WasmCompileConfig {
      target: WasmTarget::Wasm32Wasi,
      opt_level: OptLevel::O2,
      initial_memory_pages: 16,
      max_memory_pages: Some(256),
      export_memory: true,
      import_memory: false,
      bulk_memory: true,
      simd: false,
      threads: false,
      exception_handling: false,
      stack_size: 65536,
      strip_debug: true,
      producer_section: true,
      start_function: Option::None,
    }
  end
end

# ─── WASM Compiler ──────────────────────────────────────────────────

pub struct WasmCompiler
  config: WasmCompileConfig
  type_section: TypeSection
  import_section: ImportSection
  function_section: FunctionSection
  export_section: ExportSection
  code_section: CodeSection
  memory_section: MemorySection
  data_section: DataSection
  global_section: GlobalSection
  ## the funcref table and element sections (absent by design in the
  ## current subset — no call_indirect; the fields complete the section
  ## universe so the binary struct mirrors the wasm spec)
  table_section: TableSection
  element_section: ElementSection
  ## func signature -> type index
  type_cache: Map[String, UInt]
  func_index: UInt
  ## string -> data offset
  string_pool: Map[String, UInt]
  data_offset: UInt
  ## global index of __stack_pointer
  stack_ptr_global: UInt
  ## the START section's function index (Option::None = no start section)
  start_fn: Option[UInt]
end

impl WasmCompiler
  pub def new(config: WasmCompileConfig) -> WasmCompiler
    WasmCompiler {
      config: config,
      type_section: TypeSection { types: Array::new() },
      import_section: ImportSection { imports: Array::new() },
      function_section: FunctionSection { type_indices: Array::new() },
      export_section: ExportSection { exports: Array::new() },
      code_section: CodeSection { bodies: Array::new() },
      memory_section: MemorySection { memories: Array::new() },
      data_section: DataSection { segments: Array::new() },
      global_section: GlobalSection { globals: Array::new() },
      table_section: TableSection { tables: Array::new() },
      element_section: ElementSection { elements: Array::new() },
      type_cache: Map::new(),
      func_index: 0,
      string_pool: Map::new(),
      data_offset: 0,
      stack_ptr_global: 0,
      start_fn: Option::None,
    }
  end

  /// Compile a MIR program to WASM binary.
  pub def compile(inout self, mir: MirProgram) -> Result[Array[u8], WasmCompileError]
    ## Setup memory
    self.setup_memory()

    ## Setup stack pointer global for aggregate allocation
    self.setup_stack_pointer()

    ## Intern every string constant into the data segment BEFORE any
    ## function body is emitted (the emit_operand string arm reads the
    ## string pool for the constant's linear-memory offset — the pool is
    ## the single authority, never an ad-hoc 0).
    self.intern_program_strings(&mir)

    ## Add WASI imports if targeting WASI
    match self.config.target
    when Wasm32Wasi then self.add_wasi_imports()
    else ()
    end

    ## Build function name -> index mapping for calls
    mut func_map: Map[String, UInt] = Map::new()
    for func in mir.functions do
      func_map.insert(func.name.clone(), self.func_index)
      self.func_index = self.func_index + 1
    end
    ## The START section's function index (the config's named start
    ## function; a name with no compiled function is an internal error —
    ## never a silently absent start section).
    match self.config.start_function
    when Option::Some(sf) then
      match func_map.get(&sf)
      when Option::Some(idx) then self.start_fn = Option::Some(*idx)
      when Option::None then
        panic("wasm: start function `" + sf + "` is not a compiled function (the start section must name a real function)")
      end
    when Option::None then ()
    end
    ## Reset index for actual compilation
    self.func_index = self.func_index - mir.functions.len() as UInt

    ## Compile each function
    for func in mir.functions do
      self.compile_function(func, &func_map)?
    end

    ## Emit binary
    self.encode()
  end

  def setup_memory(inout self) -> Unit
    ## Validate initial <= max if max is set
    match self.config.max_memory_pages
    when Option::Some(max_pages) then
      if self.config.initial_memory_pages > max_pages then
        let msg = "WASM memory error: initial_memory_pages=" + self.config.initial_memory_pages.to_string() + " exceeds max_memory_pages=" + max_pages.to_string()
        panic(msg)
      end
    when Option::None then ()
    end

    let limits = if self.config.import_memory then
      self.import_section.imports.push(WasmImport {
        module_name: "env".to_string(),
        name: "memory".to_string(),
        desc: ImportDesc::Memory(Limits {
          min: self.config.initial_memory_pages,
          max: self.config.max_memory_pages,
        }),
      })
      return
    else
      Limits {
        min: self.config.initial_memory_pages,
        max: self.config.max_memory_pages,
      }
    end
    self.memory_section.memories.push(limits)

    if self.config.export_memory then
      self.export_section.exports.push(WasmExport {
        name: "memory".to_string(),
        desc: ExportDesc::Memory(0),
      })
    end
  end

  def setup_stack_pointer(inout self) -> Unit
    ## Add a mutable i32 global for the linear-memory stack pointer.
    ## Grows downward from top of the stack area.
    self.stack_ptr_global = self.global_section.globals.len() as UInt
    let stack_top = self.config.stack_size as i32
    var init_expr: Array[u8] = Array::new()
    emit_i32_const(&mut init_expr, stack_top)
    let global_type = GlobalType { val_type: WasmValType::I32, mutable: true }
    self.global_section.globals.push((
      global_type,
      init_expr,
    ))
  end

  # Intern ONE string constant: append a data segment at the current
  # data offset (the pool is the single authority — the same string is
  # interned once and every reference reads the recorded offset).
  def intern_string_data(inout self, s: String) -> UInt
    match self.string_pool.get(&s)
    when Option::Some(off) then
      *off
    when Option::None then
      let off = self.data_offset
      var offset_expr: Array[u8] = Array::new()
      emit_i32_const(&mut offset_expr, off as i32)
      self.data_section.segments.push(DataSegment {
        memory_index: 0,
        offset: offset_expr,
        data: s.as_bytes(),
      })
      self.data_offset = self.data_offset + s.as_bytes().len() as UInt
      self.string_pool.insert(s.clone(), off)
      off
    end
  end

  # THE DATA-SECTION CLOSURE: every string constant in the program is
  # interned before any body is emitted, so no MirString reference can
  # ever read a missing pool entry.
  def intern_program_strings(inout self, mir: MirProgram) -> Unit
    for func in mir.functions do
      for local in func.locals do
        match local.ty
        when Type::String then ()
        when _ then ()
        end
      end
      for block in func.blocks do
        for stmt in block.statements do
          match stmt.kind
          when MirStatementKind::MirAssign(_, rvalue) then
            self.intern_rvalue_strings(rvalue)
          when _ then ()
          end
        end
        self.intern_terminator_strings(&block.terminator)
      end
    end
    for st in mir.statics do
      match st.init
      when Option::Some(op) then self.intern_operand_strings(op)
      when Option::None then ()
      end
    end
  end

  def intern_rvalue_strings(inout self, rvalue: MirRvalue) -> Unit
    match rvalue.kind
    when MirRvalueKind::MirMove(operand) | MirRvalueKind::MirUnOp(_, operand) |
         MirRvalueKind::MirCast(_, operand, _) | MirRvalueKind::MirRepeat(operand, _) then
      self.intern_operand_strings(&operand)
    when MirRvalueKind::MirBinOp(_, lhs, rhs) then
      self.intern_operand_strings(&lhs)
      self.intern_operand_strings(&rhs)
    when MirRvalueKind::MirAggregate(_, operands) then
      for op in operands do
        self.intern_operand_strings(op)
      end
    ## MirRef/MirDiscriminant/MirLen carry places only and MirPhi carries
    ## (block, local) pairs — no constant operands to intern.
    when _ then ()
    end
  end

  def intern_terminator_strings(inout self, term: MirTerminator) -> Unit
    match term.kind
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      self.intern_operand_strings(op)
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      for arg in args do
        let arg_op = mir_call_arg_operand(arg)
        self.intern_operand_strings(&arg_op)
      end
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      self.intern_operand_strings(cond)
    when _ then ()
    end
  end

  def intern_operand_strings(inout self, op: MirOperand) -> Unit
    match op.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirString(s) then
        let _ = self.intern_string_data(s)
      when _ then ()
      end
    when _ then ()
    end
  end

  def add_wasi_imports(inout self) -> Unit
    ## WASI snapshot_preview1 imports
    let wasi_funcs = vec![
      ("fd_write", vec![WasmValType::I32, WasmValType::I32, WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
      ("fd_read", vec![WasmValType::I32, WasmValType::I32, WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
      ("fd_close", vec![WasmValType::I32], vec![WasmValType::I32]),
      ("clock_time_get", vec![WasmValType::I32, WasmValType::I64, WasmValType::I32], vec![WasmValType::I32]),
      ("proc_exit", vec![WasmValType::I32], vec![]),
      ("args_get", vec![WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
      ("args_sizes_get", vec![WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
      ("environ_get", vec![WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
      ("environ_sizes_get", vec![WasmValType::I32, WasmValType::I32], vec![WasmValType::I32]),
    ]
    for (name, params, results) in wasi_funcs do
      let type_idx = self.intern_type(FuncType { params: params, results: results })
      self.import_section.imports.push(WasmImport {
        module_name: "wasi_snapshot_preview1".to_string(),
        name: name.to_string(),
        desc: ImportDesc::Func(type_idx),
      })
      self.func_index = self.func_index + 1
    end
  end

  def compile_function(inout self, func: MirFunction, func_map: Map[String, UInt]) -> Result[Unit, WasmCompileError]
    let param_types = Array::new()
    for param in func.params do
      param_types.push(mir_type_to_wasm(&param.ty))
    end
    let result_types = if matches!(&func.ret_type, Type::Unit | Type::Never) then
      Array::new()
    else
      vec![mir_type_to_wasm(&func.ret_type)]
    end
    let func_type = FuncType { params: param_types, results: result_types }
    let type_idx = self.intern_type(func_type)
    self.function_section.type_indices.push(type_idx)

    ## Compile function body
    if func.is_extern then
      ## Extern functions have no body — emit a trapping stub so every
      ## function-section entry has a matching code-section body (a wasm
      ## validation rule: functions without bodies must be imports).
      let stub = FunctionBody { locals: Array::new(), code: vec![0x00] }
      self.code_section.bodies.push(stub)
      self.func_index = self.func_index + 1
      return Ok(())
    end
    let body = self.compile_body(func, func_map)?
    self.code_section.bodies.push(body)

    ## Export if marked
    if func.name == "main" || !func.name.starts_with("_") then
      self.export_section.exports.push(WasmExport {
        name: func.name.clone(),
        desc: ExportDesc::Func(self.func_index),
      })
    end

    self.func_index = self.func_index + 1
    Ok(())
  end

  def compile_body(self, func: MirFunction, func_map: Map[String, UInt]) -> Result[FunctionBody, WasmCompileError]
    var locals = Array::new()
    var code = Array::new()

    ## Declare WASM locals for each MIR local
    for local in func.locals do
      locals.push((1, mir_type_to_wasm(&local.ty)))
    end

    ## Dispatch-loop pattern for block-based control flow:
    ## loop $loop
    ##   block $bN... block $b0 block $dispatch
    ##     local.get $target
    ##     br_table 0 1 2... N
    ##   end ;; dispatch -> block 0 code
    ##   end ;; b0 -> block 1 code
    ##  ...
    ##   end ;; bN-1 -> block N code
    ## end ;; loop

    let num_blocks = func.blocks.len()
    if num_blocks == 0 then
      code.push(0x0B)  ## end
      return Ok(FunctionBody { locals: locals, code: code })
    end

    ## Reserve an extra local for the dispatch target variable
    let target_local = func.locals.len() + func.params.len()
    locals.push((1, WasmValType::I32))

    ## Set initial target to entry block
    emit_i32_const(&mut code, func.entry_block.id as i32)
    code.push(0x21)  ## local.set
    _encode_leb128_u32(&mut code, target_local as UInt)

    ## Outer loop for back-edges
    code.push(0x03)  ## loop
    code.push(0x40)  ## void block type

    ## Nested blocks: one per MIR block + dispatch block
    for _ in 0..num_blocks do
      code.push(0x02)  ## block
      code.push(0x40)  ## void block type
    end
    ## Innermost dispatch block
    code.push(0x02)  ## block
    code.push(0x40)  ## void

    ## Dispatch: br_table based on target local.
    ## The blocks are NESTED (loop > b0 > b1 >... > b_{N-1} > dispatch), so
    ## from the dispatch block label 0 is the dispatch block itself, label
    ## 1 is b_{N-1} (block 0's code region),..., label N is b0 (block N-1's
    ## region), label N+1 is the loop. Target value v must branch to label
    ## v+1 — the old v mapping targeted the dispatch block itself for v=0
    ## (infinite loop) and shifted every block by one.
    code.push(0x20)  ## local.get
    _encode_leb128_u32(&mut code, target_local as UInt)
    code.push(0x0E)  ## br_table
    _encode_leb128_u32(&mut code, num_blocks as UInt)  ## number of targets
    for i in 0..num_blocks do
      _encode_leb128_u32(&mut code, (i + 1) as UInt)  ## label i+1 -> block i's region
    end
    _encode_leb128_u32(&mut code, 1)  ## default -> block 0 (label 1)

    code.push(0x0B)  ## end dispatch block

    ## Emit code for each block (block 0 is emitted first, inside the
    ## innermost b_{N-1}; block i's code runs inside b_{N-1-i})
    var block_idx = 0
    while block_idx < func.blocks.len() do
      let block = func.blocks[block_idx]
      ## Emit statements
      for stmt in block.statements do
        self.emit_statement(&mut code, stmt, func)?
      end

      ## Emit terminator. The br-to-loop depth depends on the block's
      ## nesting level: block i sits inside b_{N-1-i}, so the loop is
      ## num_blocks - block_idx levels up (the old fixed num_blocks depth
      ## was only correct for block 0 and escaped the frame for i > 0).
      self.emit_terminator(&mut code, &block.terminator, target_local, num_blocks, block_idx, func, func_map)?

      code.push(0x0B)  ## end block $b{block_idx}
      block_idx = block_idx + 1
    end

    code.push(0x0C)  ## br
    _encode_leb128_u32(&mut code, 0)  ## br $loop
    code.push(0x0B)  ## end loop

    Ok(FunctionBody { locals: locals, code: code })
  end

  # THE STATEMENT TABLE: every MirStatementKind is enumerated here —
  # SUPPORTED arms emit the REAL machine semantics, UNSUPPORTED arms fail
  # the compilation with the stable "unsupported MIR statement <name> for
  # the wasm target" diagnostic. There is NO fallthrough and no silent
  # no-op for an unhandled statement.
  def emit_statement(self, inout code: Array[u8], stmt: MirStatement, func: MirFunction) -> Result[Unit, WasmCompileError]
    match stmt.kind
    when MirStatementKind::MirAssign(place, rvalue) then
      if place.projections.is_empty() then
        self.emit_rvalue(code, rvalue, func)?
        ## Store result into local
        code.push(0x21)  ## local.set
        _encode_leb128_u32(code, place.local.id as UInt)
      else
        ## Projected assign: push the slot ADDRESS first, then the value,
        ## then i32.store — the store lands in the projected slot instead
        ## of overwriting the whole local.
        _emit_place_address_wasm(code, place)
        self.emit_rvalue(code, rvalue, func)?
        code.push(0x36)  ## i32.store
        code.push(0x02)  ## align=4
        _encode_leb128_u32(code, 0)  ## offset=0
      end
    when MirStatementKind::MirStorageLive(_) then
      ## SUPPORTED — the real semantics of the liveness marker: the wasm
      ## backend statically allocates every local (no stack slot is ever
      ## reused), so the marker's contract — the slot's storage is live
      ## from this point — is fully realized by the static allocation and
      ## requires no machine emission. (An explicit arm, never a
      ## fallthrough.)
      ()
    when MirStatementKind::MirStorageDead(_) then
      ## SUPPORTED — the symmetric liveness marker (see MirStorageLive):
      ## the statically allocated slot outlives the marker, so no machine
      ## emission is required.
      ()
    when MirStatementKind::MirNop then
      ## SUPPORTED — the MIR-level no-op statement: its real semantics IS
      ## "emit nothing".
      ()
    when MirStatementKind::MirContractCheck(_, cond) then
      ## SUPPORTED — the real contract check: evaluate the condition and
      ## TRAP when it fails (the native backend's contract arm tests the
      ## condition and traps on false; the wasm arm emits the identical
      ## check — the eqz/if/unreachable shape of MirAssert).
      self.emit_operand(code, cond)?
      match _operand_wasm_type(cond, func)
      when WasmValType::I64 then code.push(0x50)  ## i64.eqz
      when WasmValType::I32 then code.push(0x45)  ## i32.eqz
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR statement MirContractCheck on a non-integer condition for the wasm target"))
      end
      code.push(0x04)  ## if
      code.push(0x40)  ## void
      code.push(0x00)  ## unreachable
      code.push(0x0B)  ## end if
    when MirStatementKind::MirBudgetConsume(_, _) then
      ## UNSUPPORTED — the wasm backend has no budget frame-slot
      ## machinery (the native backend's per-frame counters); the emission
      ## FAILS the compilation with the stable diagnostic.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR statement MirBudgetConsume for the wasm target"))
    when MirStatementKind::MirEffectRecord(_, _) then
      ## UNSUPPORTED — the wasm backend has no __tg_effect_record import
      ## (the native runtime's effect log); fail the compilation, never a
      ## silent no-op.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR statement MirEffectRecord for the wasm target"))
    when MirStatementKind::MirEffectPerform(_, _, _, _, _) then
      ## UNSUPPORTED — the wasm backend has no __tg_effect_perform import
      ## (the native runtime's handler-stack dispatch); fail the
      ## compilation, never a silent no-op.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR statement MirEffectPerform for the wasm target"))
    when MirStatementKind::MirEffectFrameEnter(_, _, _, _, _) then
      ## UNSUPPORTED — the wasm backend has no __tg_effect_frame_push
      ## import; fail the compilation.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR statement MirEffectFrameEnter for the wasm target"))
    when MirStatementKind::MirEffectFrameExit then
      ## UNSUPPORTED — the wasm backend has no __tg_effect_frame_pop
      ## import; fail the compilation.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR statement MirEffectFrameExit for the wasm target"))
    end
    Ok(())
  end

  # THE RVALUE TABLE: every MirRvalueKind is enumerated here — SUPPORTED
  # arms emit the REAL wasm semantics, UNSUPPORTED arms fail the
  # compilation with the stable "unsupported MIR rvalue <name> for the
  # wasm target" diagnostic. There is NO fallback: an unhandled rvalue
  # NEVER pushes a zero.
  def emit_rvalue(self, inout code: Array[u8], rvalue: MirRvalue, func: MirFunction) -> Result[Unit, WasmCompileError]
    match rvalue.kind
    when MirRvalueKind::MirMove(operand) then
      ## SUPPORTED — MirMove: the operand's value IS the moved value (a
      ## move is a value copy in the wasm linear-memory model).
      self.emit_operand(code, operand)?
    when MirRvalueKind::MirRef(place) then
      ## SUPPORTED — MirRef: the address of the place (in wasm32 the
      ## aggregate's handle is its local value; a projected place walks
      ## the canonical address chain).
      if place.projections.is_empty() then
        code.push(0x20)  ## local.get
        _encode_leb128_u32(code, place.local.id as UInt)
      else
        _emit_place_address_wasm(code, place)
      end
    when MirRvalueKind::MirAggregate(_, operands) then
      ## SUPPORTED — MirAggregate: the slot-image construction. Allocate
      ## n 4-byte slots below the stack pointer, store every operand at
      ## base + i*4, leave the base handle. The SAME uniform image model
      ## covers every AggregateKind (array/tuple/struct/closure/generator
      ## fields are all 4-byte slots; an enum aggregate stores the
      ## discriminant as operand 0 — the tag at slot 0, exactly what the
      ## Variant projection's payload shift expects).
      let num_fields = operands.len()
      let alloc_size = (num_fields * 4) as i32
      if num_fields == 0 then
        emit_i32_const(code, 0)
      else
        ## Decrement stack pointer: sp -= alloc_size
        code.push(0x23)  ## global.get
        _encode_leb128_u32(code, self.stack_ptr_global)
        emit_i32_const(code, alloc_size)
        code.push(0x6B)  ## i32.sub
        code.push(0x24)  ## global.set
        _encode_leb128_u32(code, self.stack_ptr_global)

        ## Store each field at base + i*4
        var op_i = 0
        while op_i < operands.len() do
          let op = operands[op_i]
          code.push(0x23)  ## global.get (base address)
          _encode_leb128_u32(code, self.stack_ptr_global)
          self.emit_operand(code, op)?
          ## Convert to i32 if the operand produces i64
          let wtype = _operand_wasm_type(op, func)
          match wtype
          when WasmValType::I64 then code.push(0xA7)  ## i32.wrap_i64
          when WasmValType::F64 then code.push(0xAA)  ## i32.trunc_f64_s
          when WasmValType::F32 then code.push(0xA8)  ## i32.trunc_f32_s
          when _ then ()  ## already i32
          end
          code.push(0x36)  ## i32.store
          code.push(0x02)  ## align=4
          _encode_leb128_u32(code, (op_i * 4) as UInt)  ## offset
          op_i = op_i + 1
        end

        ## Leave the pointer (base address) on the stack
        code.push(0x23)  ## global.get
        _encode_leb128_u32(code, self.stack_ptr_global)
      end
    when MirRvalueKind::MirBinOp(op, lhs, rhs) then
      ## SUPPORTED — MirBinOp: the per-family real wasm opcode (the
      ## i32/i64/f32/f64 tables in emit_binop); an op without a wasm
      ## opcode in the operand family is the explicit Unsupported
      ## diagnostic.
      self.emit_operand(code, lhs)?
      self.emit_operand(code, rhs)?
      let lhs_vt = _operand_wasm_type(lhs, func)
      let rhs_vt = _operand_wasm_type(rhs, func)
      self.emit_binop(code, op, lhs_vt, rhs_vt)?
    when MirRvalueKind::MirUnOp(op, operand) then
      ## SUPPORTED — MirUnOp: the per-family real opcodes (Neg/Not/BitNot
      ## are exhaustive; the family gaps are the explicit Unsupported
      ## diagnostic).
      self.emit_operand(code, operand)?
      let operand_vt = _operand_wasm_type(operand, func)
      self.emit_unaryop(code, op, operand_vt)?
    when MirRvalueKind::MirDiscriminant(place) then
      ## SUPPORTED — MirDiscriminant: read the enum VALUE word (the image
      ## handle), then the tag at the image base ([word + 0] — the wasm
      ## image stores the discriminant as slot 0, exactly like the native
      ## image's tag at offset 0).
      if place.projections.is_empty() then
        code.push(0x20)  ## local.get
        _encode_leb128_u32(code, place.local.id as UInt)
      else
        _emit_place_address_wasm(code, place)
        code.push(0x28)  ## i32.load — the enum value word
        code.push(0x02)
        code.push(0x00)
      end
      code.push(0x28)  ## i32.load — the tag word at the image base
      code.push(0x02)
      code.push(0x00)
    when MirRvalueKind::MirLen(place) then
      ## SUPPORTED for the fixed-array form only: the length is the
      ## compile-time count carried in the TYPE (Type::FixedArray(elem,
      ## n)) — emitted as the i64 constant, exactly the native backend's
      ## fixed-array arm. Every other MirLen source (heap collections,
      ## slice views) has no wasm metadata — the explicit Unsupported
      ## diagnostic, never a pushed zero.
      match _place_local_type(func, place)
      when Option::Some(Type::FixedArray(_, n)) then emit_i64_const(code, n)
      when Option::None then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR rvalue MirLen for the wasm target"))
      when Option::Some(_) then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR rvalue MirLen for the wasm target"))
      end
    when MirRvalueKind::MirCast(cast_kind, operand, target_ty) then
      ## SUPPORTED for the cast pairs with real wasm conversion opcodes
      ## (the per-pair table in emit_cast_wasm — identity when the source
      ## and destination share a representation); every other pair is the
      ## explicit Unsupported diagnostic, never a silently dropped
      ## conversion.
      self.emit_operand(code, operand)?
      let src_vt = _operand_wasm_type(operand, func)
      let dst_vt = mir_type_to_wasm(target_ty)
      emit_cast_wasm(code, cast_kind, src_vt, dst_vt)?
    when MirRvalueKind::MirRepeat(operand, count) then
      ## SUPPORTED — MirRepeat: the [value; n] array initializer under
      ## the slot-image model: allocate n 4-byte slots, store the element
      ## into each slot (wrapping the i64/f64/f32 operand words exactly
      ## like the MirAggregate field stores), leave the base handle.
      if count <= 0 then
        emit_i32_const(code, 0)
      else
        code.push(0x23)  ## global.get
        _encode_leb128_u32(code, self.stack_ptr_global)
        emit_i32_const(code, (count * 4) as i32)
        code.push(0x6B)  ## i32.sub
        code.push(0x24)  ## global.set
        _encode_leb128_u32(code, self.stack_ptr_global)

        var rep_i = 0
        while rep_i < count do
          code.push(0x23)  ## global.get (base address)
          _encode_leb128_u32(code, self.stack_ptr_global)
          self.emit_operand(code, operand)?
          let wtype = _operand_wasm_type(operand, func)
          match wtype
          when WasmValType::I64 then code.push(0xA7)  ## i32.wrap_i64
          when WasmValType::F64 then code.push(0xAA)  ## i32.trunc_f64_s
          when WasmValType::F32 then code.push(0xA8)  ## i32.trunc_f32_s
          when _ then ()  ## already i32
          end
          code.push(0x36)  ## i32.store
          code.push(0x02)  ## align=4
          _encode_leb128_u32(code, (rep_i * 4) as UInt)  ## offset
          rep_i = rep_i + 1
        end

        ## Leave the base handle on the stack
        code.push(0x23)  ## global.get
        _encode_leb128_u32(code, self.stack_ptr_global)
      end
    when MirRvalueKind::MirPhi(_) then
      ## UNSUPPORTED — MirPhi: the wasm dispatch-loop model has no phi
      ## placement pass (the native backend's "values already placed by
      ## predecessors" skip cannot be reproduced — the runtime
      ## predecessor is not statically known); fail the compilation,
      ## never a pushed zero.
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR rvalue MirPhi for the wasm target"))
    end
    Ok(())
  end

  def emit_operand(self, inout code: Array[u8], operand: MirOperand) -> Result[Unit, WasmCompileError]
    match operand.kind
    when MirOperandKind::MirCopy(place) | MirOperandKind::MirMovePlace(place) |
         MirOperandKind::MirRead(place) | MirOperandKind::MirConsume(place) then
      if place.projections.is_empty() then
        code.push(0x20)  ## local.get
        _encode_leb128_u32(code, place.local.id as UInt)
      else
        ## Projected place: compute the slot address through the canonical
        ## walker (the enum-payload tag shift included), then load the slot.
        _emit_place_address_wasm(code, place)
        code.push(0x28)  ## i32.load
        code.push(0x02)
        code.push(0x00)
      end
    when MirOperandKind::MirConstant(c) then
      ## THE CONSTANT TABLE: every MirConstantKind is enumerated here —
      ## the SUPPORTED kinds emit their real value, the UNSUPPORTED kinds
      ## fail the compilation with the stable diagnostic. There is NO
      ## push-zero fallback for an unhandled constant.
      match c.kind
      when MirConstantKind::MirUnit then ()  ## zero-sized: no machine value
      when MirConstantKind::MirBool(b) then emit_i32_const(code, if *b then 1 else 0 end)
      when MirConstantKind::MirInt(n) then emit_i64_const(code, *n)
      when MirConstantKind::MirFloat(f) then emit_f64_const(code, *f)
      when MirConstantKind::MirChar(cv) then emit_i32_const(code, *cv as i32)
      when MirConstantKind::MirString(s) then
        ## String literals: the data segment offset, interned by the
        ## pre-emission pass (intern_program_strings — the pool is the
        ## single authority; a missing entry is an internal error).
        match self.string_pool.get(s)
        when Option::Some(off) then emit_i32_const(code, *off as i32)
        when Option::None then
          panic("wasm: string constant `" + s + "` was not interned before emission (the data-section closure is broken)")
        end
      when MirConstantKind::MirZeroSized then ()  ## zero-sized: no machine value
      when MirConstantKind::MirFnItem(_) then
        ## UNSUPPORTED — a function item as a VALUE (a function pointer):
        ## the wasm subset has no call_indirect/table to materialize the
        ## address; fail the compilation, never a pushed zero.
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR constant MirFnItem for the wasm target"))
      when MirConstantKind::MirStaticRef(_) then
        ## UNSUPPORTED — the wasm backend interns STRING constants only;
        ## no static-image labels exist for general statics; fail the
        ## compilation, never a pushed zero.
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR constant MirStaticRef for the wasm target"))
      when MirConstantKind::MirStaticAddr(_) then
        ## UNSUPPORTED — see MirStaticRef.
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR constant MirStaticAddr for the wasm target"))
      end
    end
    Ok(())
  end

  # THE BINOP TABLE: every MirBinOpKind is dispatched to the REAL wasm
  # opcode of the operands' value family (the i32/i64/f32/f64 families
  # per the type mapping table — see _binop_opcode). An op with no wasm
  # opcode in the operand family (the float bitwise/shift/rem gaps) and a
  # mixed-family operand pair are the explicit Unsupported diagnostics.
  # There is NO fallback opcode.
  def emit_binop(self, inout code: Array[u8], op: MirBinOp, lhs_vt: WasmValType, rhs_vt: WasmValType) -> Result[Unit, WasmCompileError]
    if lhs_vt != rhs_vt then
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR binop " + _binop_name(op) + " on mixed wasm operand types (" + _valtype_str(lhs_vt) + ", " + _valtype_str(rhs_vt) + ") for the wasm target"))
    end
    match _binop_opcode(op, lhs_vt)
    when Option::Some(opcode) then code.push(*opcode)
    when Option::None then
      return Result::Err(WasmCompileError::UnsupportedMir(
        "unsupported MIR binop " + _binop_name(op) + " for the wasm " + _valtype_str(lhs_vt) + " operand family"))
    end
    Ok(())
  end

  # THE UNARY TABLE: every MirUnOpKind is enumerated with the REAL wasm
  # opcode for the operand's value family (Neg exists for all four
  # families; Not/BitNot are integer-family only — the float/externref
  # forms are the explicit Unsupported diagnostic). No fallback.
  def emit_unaryop(self, inout code: Array[u8], op: MirUnOp, operand_vt: WasmValType) -> Result[Unit, WasmCompileError]
    match op
    when MirUnOp::Neg then
      match operand_vt
      when WasmValType::I64 then
        emit_i64_const(code, -1)
        code.push(0x7E)  ## i64.mul
      when WasmValType::I32 then
        emit_i32_const(code, -1)
        code.push(0x6C)  ## i32.mul
      when WasmValType::F64 then code.push(0x9A)  ## f64.neg
      when WasmValType::F32 then code.push(0x8C)  ## f32.neg
      when WasmValType::ExternRef then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR unop Neg for the wasm target"))
      end
    when MirUnOp::Not then
      match operand_vt
      when WasmValType::I64 then code.push(0x50)  ## i64.eqz
      when WasmValType::I32 then code.push(0x45)  ## i32.eqz
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR unop Not for the wasm target"))
      end
    when MirUnOp::BitNot then
      match operand_vt
      when WasmValType::I64 then
        emit_i64_const(code, -1)
        code.push(0x85)  ## i64.xor
      when WasmValType::I32 then
        emit_i32_const(code, -1)
        code.push(0x73)  ## i32.xor
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(WasmCompileError::UnsupportedMir(
          "unsupported MIR unop BitNot for the wasm target"))
      end
    end
    Ok(())
  end

  def emit_terminator(self, inout code: Array[u8], term: MirTerminator, target_local: Int, num_blocks: Int, block_idx: Int, func: MirFunction, func_map: Map[String, UInt]) -> Result[Unit, WasmCompileError]
    ## Block i's code runs inside b_{N-1-i} (see compile_body), so the loop
    ## is exactly (num_blocks - block_idx) frames up; a br inside an `if`
    ## adds one more level. The former fixed num_blocks(+1) depths were only
    ## correct for block 0 and escaped the function frame for every other
    ## block (validation error).
    let loop_depth = (num_blocks - block_idx) as UInt
    let loop_depth_in_if = (num_blocks - block_idx + 1) as UInt
    match term.kind
    when MirTerminatorKind::MirGoto(block_id) then
      emit_i32_const(code, block_id.id as i32)
      code.push(0x21)  ## local.set $target
      _encode_leb128_u32(code, target_local as UInt)
      ## br to enclosing loop
      code.push(0x0C)  ## br
      _encode_leb128_u32(code, loop_depth)
    when MirTerminatorKind::MirReturn then
      ## Load return value from local 0 if function has a return type
      if !matches!(&func.ret_type, Type::Unit | Type::Never) then
        code.push(0x20)  ## local.get _0 (return place)
        _encode_leb128_u32(code, 0)
      end
      code.push(0x0F)  ## return
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      ## Emit operand, then if/else chain for each target
      for target in targets do
        self.emit_operand(code, op)?
        emit_i64_const(code, target.value)
        code.push(0x51)  ## i64.eq
        code.push(0x04)  ## if
        code.push(0x40)  ## void
        emit_i32_const(code, target.target.id as i32)
        code.push(0x21)  ## local.set $target
        _encode_leb128_u32(code, target_local as UInt)
        code.push(0x0C)  ## br to loop
        _encode_leb128_u32(code, loop_depth_in_if)
        code.push(0x0B)  ## end if
      end
      ## Default: branch to the default block
      emit_i32_const(code, default_target.id as i32)
      code.push(0x21)  ## local.set
      _encode_leb128_u32(code, target_local as UInt)
      code.push(0x0C)  ## br
      _encode_leb128_u32(code, loop_depth)
    when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
      ## Push arguments
      for arg in args do
        let arg_op = mir_call_arg_operand(arg)
        self.emit_operand(code, &arg_op)?
      end
      ## Call function
      let callee_name = _call_callee_name(callee)
      match func_map.get(&callee_name)
      when Option::Some(idx) then
        code.push(0x10)  ## call
        _encode_leb128_u32(code, *idx)
      when Option::None then
        ## Unknown function — unreachable (fail closed)
        code.push(0x00)
      end
      ## Store result if the destination local actually holds a value
      ## (void-returning calls must not local.set — nothing is on the stack).
      match _place_wasm_type(func, dest)
      when Option::Some(_) then
        code.push(0x21)  ## local.set
        _encode_leb128_u32(code, dest.local.id as UInt)
      when Option::None then ()
      end
      ## Goto next block
      emit_i32_const(code, success.id as i32)
      code.push(0x21)  ## local.set $target
      _encode_leb128_u32(code, target_local as UInt)
      code.push(0x0C)  ## br
      _encode_leb128_u32(code, loop_depth)
    when MirTerminatorKind::MirUnreachable then
      code.push(0x00)  ## unreachable
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      ## WASM backend has no drop glue: destruction is a no-op, continue at
      ## the target block.
      emit_i32_const(code, target.id as i32)
      code.push(0x21)  ## local.set $target
      _encode_leb128_u32(code, target_local as UInt)
      code.push(0x0C)  ## br
      _encode_leb128_u32(code, loop_depth)
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      self.emit_operand(code, cond)?
      if expected then
        code.push(0x45)  ## i32.eqz — trap when the condition is false
      else
        ## expected == false: trap when the condition is true
        emit_i32_const(code, 0)
        code.push(0x46)  ## i32.ne
      end
      code.push(0x04)  ## if
      code.push(0x40)  ## void
      code.push(0x00)  ## unreachable (assertion failed)
      code.push(0x0B)  ## end if
      emit_i32_const(code, target.id as i32)
      code.push(0x21)  ## local.set $target
      _encode_leb128_u32(code, target_local as UInt)
      code.push(0x0C)  ## br
      _encode_leb128_u32(code, loop_depth)
    when MirTerminatorKind::MirAbort then
      code.push(0x00)  ## unreachable
    when _ then
      code.push(0x00)  ## unreachable for unknown terminators
    end
    Ok(())
  end

  def intern_type(inout self, sink ft: FuncType) -> UInt
    let key = _func_type_key(&ft)
    match self.type_cache.get(&key)
    when Some(idx) then *idx
    when None then
      let idx = self.type_section.types.len() as UInt
      self.type_section.types.push(ft)
      self.type_cache.insert(key, idx)
      idx
    end
  end

  def encode(self) -> Result[Array[u8], WasmCompileError]
    var binary = Array::new()

    ## Magic number and version
    binary.extend_from_slice(&[0x00, 0x61, 0x73, 0x6D])  ## \0asm
    binary.extend_from_slice(&[0x01, 0x00, 0x00, 0x00])  ## version 1

    ## Section 1: Type
    if !self.type_section.types.is_empty() then
      _encode_section(&mut binary, 0x01, &_encode_type_section(&self.type_section))
    end

    ## Section 2: Import
    if !self.import_section.imports.is_empty() then
      _encode_section(&mut binary, 0x02, &_encode_import_section(&self.import_section))
    end

    ## Section 3: Function
    if !self.function_section.type_indices.is_empty() then
      _encode_section(&mut binary, 0x03, &_encode_function_section(&self.function_section))
    end

    ## Section 4: Table (absent by design in the current subset — no
    ## call_indirect; emitted whenever a table exists)
    if !self.table_section.tables.is_empty() then
      _encode_section(&mut binary, 0x04, &_encode_table_section(&self.table_section))
    end

    ## Section 5: Memory
    if !self.memory_section.memories.is_empty() then
      _encode_section(&mut binary, 0x05, &_encode_memory_section(&self.memory_section))
    end

    ## Section 6: Global
    if !self.global_section.globals.is_empty() then
      _encode_section(&mut binary, 0x06, &_encode_global_section(&self.global_section))
    end

    ## Section 7: Export
    if !self.export_section.exports.is_empty() then
      _encode_section(&mut binary, 0x07, &_encode_export_section(&self.export_section))
    end

    ## Section 8: Start
    match self.start_fn
    when Option::Some(idx) then
      var start_payload: Array[u8] = Array::new()
      _encode_leb128_u32(&mut start_payload, idx)
      _encode_section(&mut binary, 0x08, &start_payload)
    when Option::None then ()
    end

    ## Section 9: Element (absent by design in the current subset — no
    ## table initializers; emitted whenever an element list exists)
    if !self.element_section.elements.is_empty() then
      _encode_section(&mut binary, 0x09, &_encode_element_section(&self.element_section))
    end

    ## Section 10: Code
    if !self.code_section.bodies.is_empty() then
      _encode_section(&mut binary, 0x0A, &_encode_code_section(&self.code_section))
    end

    ## Section 11: Data
    if !self.data_section.segments.is_empty() then
      _encode_section(&mut binary, 0x0B, &_encode_data_section(&self.data_section))
    end

    ## The producer custom section (section 0) — the toolchain provenance
    ## record, emitted last per the custom-section convention.
    if self.config.producer_section then
      _encode_section(&mut binary, 0x00, &_encode_producer_section())
    end

    Ok(binary)
  end
end

# ─── Errors ──────────────────────────────────────────────────────────

pub enum WasmCompileError
  UnsupportedType(String)
  UnsupportedInstruction(String)
  ## The stable compile-time diagnostic for an MIR variant the wasm
  ## backend cannot implement faithfully: "unsupported MIR <kind> <name>
  ## for the wasm target". The Display renders the message VERBATIM (the
  ## string IS the diagnostic — no prefix), so the conformance tests can
  ## assert the exact text. Emission FAILS the compilation; nothing is
  ## ever silently emitted for an unhandled variant.
  UnsupportedMir(String)
  TooManyLocals
  FunctionTooLarge
  MemoryOverflow
end

impl Display for WasmCompileError
  def fmt(self: Self) -> String
    match self
    when UnsupportedType(t) then "unsupported WASM type: " + t
    when UnsupportedInstruction(i) then "unsupported WASM instruction: " + i
    when UnsupportedMir(m) then m
    when TooManyLocals then "too many locals in function"
    when FunctionTooLarge then "function body too large"
    when MemoryOverflow then "data segment exceeds memory"
    end
  end
end

# ─── Helpers ─────────────────────────────────────────────────────────

# ─── WASM value categories ──────────────────────────────
# The wasm32 backend's ABI classification, mirroring the layout engine's
# value-category model (classify_value_category — the single authority;
# every size comes from the centralized layout engine, never an independent
# estimate). wasm32 words are 4 bytes, so the categories map as:
#   ZeroSized     -> no wasm value (Unit, Never, empty aggregates)
#   Scalar(width) -> ONE wasm value: 1/2/4 bytes -> i32, 8 bytes -> i64,
#                    floats -> f32/f64
#   ScalarPair    -> BY ADDRESS: every aggregate value — 16-byte pairs
#                    (the Slice view { ptr, len }), larger structs, tuples,
#                    enums — is materialized as a pointer to its linear-
#                    memory image (MirAggregate allocates n*4-byte slots
#                    and pushes the base), and the caller/callee emission
#                    in this backend uses exactly ONE slot (an i32) per
#                    parameter/result. The classifier therefore maps both
#                    ScalarPair and ByAddress to the single-slot address
#                    convention — a two-value wasm pair is NOT the wasm32
#                    ABI here.
#   ByAddress     -> the linear-memory ADDRESS of the >16-byte aggregate
#                    (i32)
# FAIL-CLOSED: unresolved types (Var/Param/Error) are Result::Err — the
# caller must fail, never assume a guessed word.
enum WasmValueCategory
  WasmZeroSized
  WasmScalar(WasmValType)
  WasmByAddress
end

# The wasm value type for a byte width (1/2/4 -> i32, 8 -> i64); 16-byte
# values are pairs, not single slots.
def wasm_valtype_for_width(width: Int) -> Option[WasmValType]
  match width
  when 1 then Option::Some(WasmValType::I32)
  when 2 then Option::Some(WasmValType::I32)
  when 4 then Option::Some(WasmValType::I32)
  when 8 then Option::Some(WasmValType::I64)
  when _ then Option::None
  end
end

# THE wasm value-category classifier: asks the layout engine's single
# authority and maps the category to wasm32 value slots. Result::Err
# propagates fail-closed for unresolved/unsupported types.
def classify_wasm_value_category(inout engine: LayoutEngine, ty: Type) -> Result[WasmValueCategory, LayoutError]
  match classify_value_category(engine, ty)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(ValueCategory::ZeroSized) then
    Result::Ok(WasmValueCategory::WasmZeroSized)
  when Result::Ok(ValueCategory::Scalar(w)) then
    # Float scalars map to the float value types; everything else maps by
    # width (1/2/4 -> i32, 8 -> i64).
    match ty
    when Type::Float | Type::F32 then Result::Ok(WasmValueCategory::WasmScalar(WasmValType::F32))
    when Type::F64 then Result::Ok(WasmValueCategory::WasmScalar(WasmValType::F64))
    when _ then
      match wasm_valtype_for_width(w)
      when Option::Some(vt) then Result::Ok(WasmValueCategory::WasmScalar(vt))
      when Option::None then
        Result::Err(LayoutError {
          class: LayoutFailureClass::UNSUPPORTED_TYPE,
          message: "Scalar width has no wasm32 value type",
          type_name: "unknown",
          expected: 0,
          actual: w,
          context: "classify_wasm_value_category"
        })
      end
    end
  when Result::Ok(ValueCategory::Vector(_)) then
    # THE VECTOR CASE: a SIMD vector crosses by its linear-memory ADDRESS
    # (the wasm SIMD v128 proposal is not in this backend's subset; the
    # 16-byte vector's register classification is a native-ABI notion —
    # wasm32 has no vector registers, so every vector crosses as its
    # image handle).
    Result::Ok(WasmValueCategory::WasmByAddress)
  when Result::Ok(ValueCategory::ScalarPair(_, _)) then
    # A 16-byte aggregate (the Slice view { ptr, len } and other 16-byte
    # values) crosses the wasm32 ABI as its LINEAR-MEMORY ADDRESS: every
    # aggregate value is a single i32 handle (MirAggregate materializes it
    # as a pointer), and the caller/callee emission in this backend uses
    # one slot per parameter/result. The two-value pair form is NOT the
    # wasm32 convention here — a 16-byte value must never occupy two slots.
    Result::Ok(WasmValueCategory::WasmByAddress)
  when Result::Ok(ValueCategory::ByAddress(_)) then
    # >16-byte aggregates cross by their linear-memory address.
    Result::Ok(WasmValueCategory::WasmByAddress)
  end
end

# ———————————————————————————————————————————————————————————————
# THE WASM TYPE MAPPING TABLE (wasm32-unknown-unknown)
# ———————————————————————————————————————————————————————————————
# THE Tangerine → wasm32 value-type mapping (the single authority; the
# ABI classification above is the category-level authority and this table
# is the value-type level). The memory model: the wasm32 linear memory is
# the program's address space — pointers and handles are 32-bit linear
# addresses (i32), aggregates live in linear-memory images addressed by
# i32 handles, and the wasm stack holds the i32/i64/f32/f64 values.
#
#   Tangerine primitive              | wasm value type
#   ————————————————————————————————+——————————————————
#   Bool, Char, I8, I16, I32,        | i32
#   U8, U16, U32                     |
#   Int, I64, U64, ISize, USize      | i64
#   F32                              | f32
#   Float, F64                       | f64
#   Ptr[T], PtrMut[T], RefInternal,  | i32 (the 32-bit linear address)
#   StaticStrPtr, String (the        |
#   handle), Adt (the image handle), |
#   FnPtr, Dyn, Effect, Closure      |
#   Unit, Never                      | NO value (zero-sized)
#   I128, U128                       | FAIL CLOSED (no wasm value type)
#   ExternRef (the std::wasm host-   | externref — the host-reference
#   reference bridge)                | bridge; in the CURRENT subset the
#                                    | handle word crosses as the i32
#                                    | address form (see below)
#   SIMD vectors (Vec2/4/8/16)       | by ADDRESS (i32 image handle; the
#                                    | wasm SIMD v128 proposal is NOT in
#                                    | the subset)
#
# The externref row: externref is a first-class wasm value type in this
# backend's type universe (the encoder emits 0x6F), reserved for the
# std::wasm ExternRef host-reference bridge. No Tangerine PRIMITIVE maps
# to it in the current subset (the std::wasm ExternRef struct value is
# its 4-byte _handle word — an i32 linear address); the mapping function
# refuses a primitive for which no wasm value type exists (fail closed).
def map_primitive_to_wasm(ty: Type) -> Option[WasmValType]
  match ty
  when Type::Bool | Type::Char | Type::I8 | Type::I16 | Type::I32 |
       Type::U8 | Type::U16 | Type::U32 then Option::Some(WasmValType::I32)
  when Type::Int | Type::I64 | Type::U64 | Type::ISize | Type::USize then Option::Some(WasmValType::I64)
  when Type::F32 then Option::Some(WasmValType::F32)
  when Type::Float | Type::F64 then Option::Some(WasmValType::F64)
  when Type::I128 | Type::U128 then Option::None
  when _ then Option::None
  end
end

## Determine the WASM value type an operand will produce on the stack.
def _operand_wasm_type(operand: MirOperand, func: MirFunction) -> WasmValType
  match operand.kind
  when MirOperandKind::MirCopy(place) | MirOperandKind::MirMovePlace(place) |
       MirOperandKind::MirRead(place) | MirOperandKind::MirConsume(place) then
    let id = place.local.id
    if id < func.params.len() then
      mir_type_to_wasm(&func.params[id].ty)
    else
      let local_idx = id - func.params.len()
      if local_idx < func.locals.len() then
        mir_type_to_wasm(&func.locals[local_idx].ty)
      else
        WasmValType::I32
      end
    end
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirInt(_) then WasmValType::I64
    when MirConstantKind::MirFloat(_) then WasmValType::F64
    when _ then WasmValType::I32
    end
  end
end

## WASM value type of a place's local, or None for Unit/Never locals (which
## occupy no wasm value slot — a call into one must not local.set).
def _place_wasm_type(func: MirFunction, place: Place) -> Option[WasmValType]
  let id = place.local.id
  if id < func.params.len() then
    let t = &func.params[id].ty
    match t
    when Type::Unit | Type::Never then Option::None
    when _ then Option::Some(mir_type_to_wasm(t))
    end
  else
    let local_idx = id - func.params.len()
    if local_idx < func.locals.len() then
      let t = &func.locals[local_idx].ty
      match t
      when Type::Unit | Type::Never then Option::None
      when _ then Option::Some(mir_type_to_wasm(t))
      end
    else
      Option::None
    end
  end
end

## Extract the callable's symbol name from a call's func operand
## (MirFnItem constants carry the mangled emission name).
def _call_callee_name(op: MirOperand) -> String
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFnItem(n) then n.clone()
    when _ then "".to_string()
    end
  when _ then "".to_string()
  end
end

# The declared type of a place's LOCAL (params and locals are
# function-scoped — the same id discipline _operand_wasm_type and
# _place_wasm_type use; an id outside both ranges is an internal defect
# and Option::None fails the caller closed).
def _place_local_type(func: MirFunction, place: Place) -> Option[Type]
  let id = place.local.id
  if id < func.params.len() then
    let t = &func.params[id].ty
    Option::Some(t.clone())
  else
    let local_idx = id - func.params.len()
    if local_idx < func.locals.len() then
      let t = &func.locals[local_idx].ty
      Option::Some(t.clone())
    else
      Option::None
    end
  end
end

# The stable diagnostic name of a MirBinOpKind.
def _binop_name(op: MirBinOp) -> String
  match op
  when MirBinOp::Add then "Add"
  when MirBinOp::Sub then "Sub"
  when MirBinOp::Mul then "Mul"
  when MirBinOp::Div then "Div"
  when MirBinOp::Mod then "Mod"
  when MirBinOp::BitAnd then "BitAnd"
  when MirBinOp::BitOr then "BitOr"
  when MirBinOp::BitXor then "BitXor"
  when MirBinOp::Shl then "Shl"
  when MirBinOp::Shr then "Shr"
  when MirBinOp::Eq then "Eq"
  when MirBinOp::Ne then "Ne"
  when MirBinOp::Lt then "Lt"
  when MirBinOp::Le then "Le"
  when MirBinOp::Gt then "Gt"
  when MirBinOp::Ge then "Ge"
  end
end

# THE BINOP OPCODE TABLE: every MirBinOpKind x value-family pair with a
# REAL wasm opcode. Option::None = no wasm opcode exists for the op in
# that family (the float bitwise/shift/rem gaps — wasm has no such
# opcodes; the externref family has no arithmetic at all) — the caller
# turns None into the explicit Unsupported diagnostic.
def _binop_opcode(op: MirBinOp, vt: WasmValType) -> Option[u8]
  match vt
  when WasmValType::I64 then
    match op
    when MirBinOp::Add then Option::Some(0x7C)  ## i64.add
    when MirBinOp::Sub then Option::Some(0x7D)  ## i64.sub
    when MirBinOp::Mul then Option::Some(0x7E)  ## i64.mul
    when MirBinOp::Div then Option::Some(0x7F)  ## i64.div_s
    when MirBinOp::Mod then Option::Some(0x81)  ## i64.rem_s
    when MirBinOp::BitAnd then Option::Some(0x83)  ## i64.and
    when MirBinOp::BitOr then Option::Some(0x84)  ## i64.or
    when MirBinOp::BitXor then Option::Some(0x85)  ## i64.xor
    when MirBinOp::Shl then Option::Some(0x86)  ## i64.shl
    when MirBinOp::Shr then Option::Some(0x87)  ## i64.shr_s
    when MirBinOp::Eq then Option::Some(0x51)  ## i64.eq
    when MirBinOp::Ne then Option::Some(0x52)  ## i64.ne
    when MirBinOp::Lt then Option::Some(0x53)  ## i64.lt_s
    when MirBinOp::Le then Option::Some(0x57)  ## i64.le_s
    when MirBinOp::Gt then Option::Some(0x55)  ## i64.gt_s
    when MirBinOp::Ge then Option::Some(0x59)  ## i64.ge_s
    end
  when WasmValType::I32 then
    match op
    when MirBinOp::Add then Option::Some(0x6A)  ## i32.add
    when MirBinOp::Sub then Option::Some(0x6B)  ## i32.sub
    when MirBinOp::Mul then Option::Some(0x6C)  ## i32.mul
    when MirBinOp::Div then Option::Some(0x6D)  ## i32.div_s
    when MirBinOp::Mod then Option::Some(0x6F)  ## i32.rem_s
    when MirBinOp::BitAnd then Option::Some(0x71)  ## i32.and
    when MirBinOp::BitOr then Option::Some(0x72)  ## i32.or
    when MirBinOp::BitXor then Option::Some(0x73)  ## i32.xor
    when MirBinOp::Shl then Option::Some(0x74)  ## i32.shl
    when MirBinOp::Shr then Option::Some(0x75)  ## i32.shr_s
    when MirBinOp::Eq then Option::Some(0x46)  ## i32.eq
    when MirBinOp::Ne then Option::Some(0x47)  ## i32.ne
    when MirBinOp::Lt then Option::Some(0x48)  ## i32.lt_s
    when MirBinOp::Le then Option::Some(0x4C)  ## i32.le_s
    when MirBinOp::Gt then Option::Some(0x4A)  ## i32.gt_s
    when MirBinOp::Ge then Option::Some(0x4E)  ## i32.ge_s
    end
  when WasmValType::F64 then
    match op
    when MirBinOp::Add then Option::Some(0xA0)  ## f64.add
    when MirBinOp::Sub then Option::Some(0xA1)  ## f64.sub
    when MirBinOp::Mul then Option::Some(0xA2)  ## f64.mul
    when MirBinOp::Div then Option::Some(0xA3)  ## f64.div
    when MirBinOp::Eq then Option::Some(0x61)  ## f64.eq
    when MirBinOp::Ne then Option::Some(0x62)  ## f64.ne
    when MirBinOp::Lt then Option::Some(0x63)  ## f64.lt
    when MirBinOp::Le then Option::Some(0x65)  ## f64.le
    when MirBinOp::Gt then Option::Some(0x64)  ## f64.gt
    when MirBinOp::Ge then Option::Some(0x66)  ## f64.ge
    ## the float-family gaps: wasm has NO bitwise/shift/rem float opcodes
    when MirBinOp::Mod | MirBinOp::BitAnd | MirBinOp::BitOr | MirBinOp::BitXor |
         MirBinOp::Shl | MirBinOp::Shr then Option::None
    end
  when WasmValType::F32 then
    match op
    when MirBinOp::Add then Option::Some(0x92)  ## f32.add
    when MirBinOp::Sub then Option::Some(0x93)  ## f32.sub
    when MirBinOp::Mul then Option::Some(0x94)  ## f32.mul
    when MirBinOp::Div then Option::Some(0x95)  ## f32.div
    when MirBinOp::Eq then Option::Some(0x5B)  ## f32.eq
    when MirBinOp::Ne then Option::Some(0x5C)  ## f32.ne
    when MirBinOp::Lt then Option::Some(0x5D)  ## f32.lt
    when MirBinOp::Le then Option::Some(0x5F)  ## f32.le
    when MirBinOp::Gt then Option::Some(0x5E)  ## f32.gt
    when MirBinOp::Ge then Option::Some(0x60)  ## f32.ge
    ## the float-family gaps (see the F64 arm)
    when MirBinOp::Mod | MirBinOp::BitAnd | MirBinOp::BitOr | MirBinOp::BitXor |
         MirBinOp::Shl | MirBinOp::Shr then Option::None
    end
  when WasmValType::ExternRef then
    ## the externref family has NO binops at all — every op is the
    ## explicit Unsupported classification
    Option::None
  end
end

# The stable Unsupported diagnostic for a MirCast pair without a wasm
# conversion.
def _cast_unsupported_error(cast_name: String, src_vt: WasmValType, dst_vt: WasmValType) -> WasmCompileError
  WasmCompileError::UnsupportedMir(
    "unsupported MIR rvalue MirCast (" + cast_name + " " + _valtype_str(src_vt) + " -> " + _valtype_str(dst_vt) + ") for the wasm target")
end

# THE CAST TABLE: every CastKind is dispatched to the REAL wasm
# conversion opcode(s) for the (source, destination) value-family pair —
# identity (no conversion) when both families already share the
# representation; the specific convert opcode otherwise. A pair with no
# wasm conversion (Transmute always; a family pair without a convert
# instruction) is the explicit Unsupported diagnostic — the conversion is
# NEVER silently dropped.
def emit_cast_wasm(inout code: Array[u8], kind: CastKind, src_vt: WasmValType, dst_vt: WasmValType) -> Result[Unit, WasmCompileError]
  match kind
  when CastKind::IntToInt then
    match src_vt
    when WasmValType::I32 then
      match dst_vt
      when WasmValType::I32 then ()  ## identity (same family)
      when WasmValType::I64 then code.push(0xAC)  ## i64.extend_i32_s
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("IntToInt", src_vt, dst_vt))
      end
    when WasmValType::I64 then
      match dst_vt
      when WasmValType::I64 then ()  ## identity (same family)
      when WasmValType::I32 then code.push(0xA7)  ## i32.wrap_i64
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("IntToInt", src_vt, dst_vt))
      end
    when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
      return Result::Err(_cast_unsupported_error("IntToInt", src_vt, dst_vt))
    end
  when CastKind::IntToFloat then
    match src_vt
    when WasmValType::I32 then
      match dst_vt
      when WasmValType::F32 then code.push(0xB2)  ## f32.convert_i32_s
      when WasmValType::F64 then code.push(0xB7)  ## f64.convert_i32_s
      when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("IntToFloat", src_vt, dst_vt))
      end
    when WasmValType::I64 then
      match dst_vt
      when WasmValType::F32 then code.push(0xB4)  ## f32.convert_i64_s
      when WasmValType::F64 then code.push(0xB9)  ## f64.convert_i64_s
      when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("IntToFloat", src_vt, dst_vt))
      end
    when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
      return Result::Err(_cast_unsupported_error("IntToFloat", src_vt, dst_vt))
    end
  when CastKind::FloatToInt then
    match src_vt
    when WasmValType::F32 then
      match dst_vt
      when WasmValType::I32 then code.push(0xA8)  ## i32.trunc_f32_s
      when WasmValType::I64 then code.push(0xAE)  ## i64.trunc_f32_s
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("FloatToInt", src_vt, dst_vt))
      end
    when WasmValType::F64 then
      match dst_vt
      when WasmValType::I32 then code.push(0xAA)  ## i32.trunc_f64_s
      when WasmValType::I64 then code.push(0xB0)  ## i64.trunc_f64_s
      when WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("FloatToInt", src_vt, dst_vt))
      end
    when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
      return Result::Err(_cast_unsupported_error("FloatToInt", src_vt, dst_vt))
    end
  when CastKind::FloatToFloat then
    match src_vt
    when WasmValType::F32 then
      match dst_vt
      when WasmValType::F32 then ()  ## identity (same family)
      when WasmValType::F64 then code.push(0xBB)  ## f64.promote_f32
      when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("FloatToFloat", src_vt, dst_vt))
      end
    when WasmValType::F64 then
      match dst_vt
      when WasmValType::F64 then ()  ## identity (same family)
      when WasmValType::F32 then code.push(0xB6)  ## f32.demote_f64
      when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("FloatToFloat", src_vt, dst_vt))
      end
    when WasmValType::I32 | WasmValType::I64 | WasmValType::ExternRef then
      return Result::Err(_cast_unsupported_error("FloatToFloat", src_vt, dst_vt))
    end
  when CastKind::Pointer then
    match src_vt
    when WasmValType::I32 then
      match dst_vt
      when WasmValType::I32 then ()  ## identity — every pointer is an i32 linear address
      when WasmValType::I64 | WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
        return Result::Err(_cast_unsupported_error("Pointer", src_vt, dst_vt))
      end
    when WasmValType::I64 | WasmValType::F32 | WasmValType::F64 | WasmValType::ExternRef then
      return Result::Err(_cast_unsupported_error("Pointer", src_vt, dst_vt))
    end
  when CastKind::Transmute then
    ## UNSUPPORTED — Transmute is a bit reinterpretation between ARBITRARY
    ## types; the wasm backend has no type-safe transmute — fail the
    ## compilation, never a silently dropped conversion.
    return Result::Err(_cast_unsupported_error("Transmute", src_vt, dst_vt))
  end
  Ok(())
end

# Push the BYTE ADDRESS of `place` onto the wasm stack: the base is the
# local's value (in wasm32 every aggregate/enum value is one i32 handle —
# the pointer to its linear-memory image of 4-byte slots), and each
# projection adjusts it. The projection walk mirrors the native backend's
# canonical place-addressing primitive:
#   - Variant(vid)      an enum downcast: subsequent payload fields sit ONE
#                       slot past the image's tag slot (the wasm image is
#                       [tag @ 0, payload @ 1,...] — MirAggregate stores
#                       the discriminant as operand 0), so the payload
#                       shift is set to 1 and applied to every following
#                       Field/TupleIndex offset; the shift resets after a
#                       loaded projection (the base then points at the
#                       field's own value, which has no tag);
#   - Field(fid)        + (fid.index + shift) * 4; loaded when not last
#                       (the field's value becomes the new base);
#   - TupleIndex(idx)   + (idx + shift) * 4; loaded when not last;
#   - ProjIndex / ProjConstantIndex — + index * 4 (+ the shift);
#   - ProjDeref         load the pointed-to word (a deref's address IS the
#                       loaded value; as the LAST projection a deref is a
#                       no-op — the final load resolves it).
# A last projection only adds its offset — the caller loads the slot.
def _emit_place_address_wasm(inout code: Array[u8], place: Place) -> Unit
  code.push(0x20)  ## local.get
  _encode_leb128_u32(code, place.local.id as UInt)
  var payload_shift = 0
  var proj_i = 0
  while proj_i < place.projections.len() do
    let proj = place.projections[proj_i]
    let is_last = proj_i == place.projections.len() - 1
    match proj
    when Projection::Field(fid) then
      emit_i32_const(code, ((fid.index + payload_shift) * 4) as i32)
      code.push(0x6A)  ## i32.add
      if !is_last then
        code.push(0x28)  ## i32.load
        code.push(0x02)
        code.push(0x00)
        payload_shift = 0
      end
    when Projection::TupleIndex(idx) then
      emit_i32_const(code, ((*idx + payload_shift) * 4) as i32)
      code.push(0x6A)  ## i32.add
      if !is_last then
        code.push(0x28)  ## i32.load
        code.push(0x02)
        code.push(0x00)
        payload_shift = 0
      end
    when Projection::ProjIndex(idx_local) then
      code.push(0x20)  ## local.get index
      _encode_leb128_u32(code, idx_local.id as UInt)
      emit_i32_const(code, 4)  ## element slot size
      code.push(0x6C)  ## i32.mul
      if payload_shift != 0 then
        emit_i32_const(code, (payload_shift * 4) as i32)  ## tag slot shift
        code.push(0x6A)  ## i32.add
      end
      code.push(0x6A)  ## i32.add
      if !is_last then
        code.push(0x28)  ## i32.load
        code.push(0x02)
        code.push(0x00)
        payload_shift = 0
      end
    when Projection::ProjConstantIndex(ci) then
      emit_i32_const(code, ((*ci + payload_shift) * 4) as i32)
      code.push(0x6A)  ## i32.add
      if !is_last then
        code.push(0x28)  ## i32.load
        code.push(0x02)
        code.push(0x00)
        payload_shift = 0
      end
    when Projection::ProjDeref then
      if !is_last then
        code.push(0x28)  ## i32.load (deref pointer)
        code.push(0x02)
        code.push(0x00)
      end
    when Projection::Variant(_) then
      payload_shift = 1
    end
    proj_i = proj_i + 1
  end
end

def mir_type_to_wasm(ty: Type) -> WasmValType
  # FAIL-CLOSED: an unresolved type (Var/Param/Error) has NO wasm value type
  # — never a guessed word. The engine-based classifier
  # (classify_wasm_value_category) is the single authority for value
  # categories; this single-slot mapper serves the stub's local/param
  # declarations and refuses unresolved types.
  match ty
  when Type::Var(_) | Type::Param(_) | Type::Error then
    panic("wasm: mir_type_to_wasm on an unresolved type (Var/Param/Error) — layout queries fail closed, never a guessed word")
  when _ then ()
  end
  match map_primitive_to_wasm(ty)
  when Option::Some(vt) then
    vt
  when Option::None then
    # The primitive table's fail-closed rows (I128/U128) and the
    # non-primitive forms: pointers/handles are 32-bit linear addresses
    # in the wasm32 memory model; an I128/U128 has no wasm value type.
    match ty
    when Type::I128 | Type::U128 then
      panic("wasm: I128/U128 has no wasm32 value type (the i64 form is the widest integer)")
    when Type::RefInternal(_, _) | Type::Ptr(_) | Type::PtrMut(_) | Type::StaticStrPtr then WasmValType::I32
    when Type::String then WasmValType::I32
    when Type::Adt(_, _) then WasmValType::I32
    when Type::FnPtr(_, _, _) then WasmValType::I32
    when Type::Dyn(_) | Type::Effect(_, _) | Type::Closure(_, _, _, _, _) then WasmValType::I32
    when _ then WasmValType::I32
    end
  end
end

def emit_i32_const(inout code: Array[u8], value: i32) -> Unit
  code.push(0x41)  ## i32.const
  _encode_leb128_s32(code, value)
end

def emit_i64_const(inout code: Array[u8], value: Int) -> Unit
  code.push(0x42)  ## i64.const
  _encode_leb128_s64(code, value)
end

def emit_f64_const(inout code: Array[u8], value: Float) -> Unit
  code.push(0x44)  ## f64.const
  let bits = value.to_bits()
  for i in 0..8 do
    code.push(((bits >> (i * 8)) & 0xFF) as u8)
  end
end

def _encode_leb128_s32(inout buf: Array[u8], inout value: i32) -> Unit
  loop
    let byte = (value & 0x7F) as u8
    value = value >> 7
    if (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0) then
      buf.push(byte)
      break
    else
      buf.push(byte | 0x80)
    end
  end
end

def _encode_leb128_s64(inout buf: Array[u8], inout value: Int) -> Unit
  loop
    let byte = (value & 0x7F) as u8
    value = value >> 7
    if (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0) then
      buf.push(byte)
      break
    else
      buf.push(byte | 0x80)
    end
  end
end

def _func_type_key(ft: FuncType) -> String
  var s = "(".to_string()
  var pi = 0
  while pi < ft.params.len() do
    if pi > 0 then s = s + "," end
    s = s + _valtype_str(ft.params[pi])
    pi = pi + 1
  end
  s = s + ")->("
  var ri = 0
  while ri < ft.results.len() do
    if ri > 0 then s = s + "," end
    s = s + _valtype_str(ft.results[ri])
    ri = ri + 1
  end
  s + ")"
end

def _valtype_str(vt: WasmValType) -> String
  match vt
  when I32 then "i32"
  when I64 then "i64"
  when F32 then "f32"
  when F64 then "f64"
  when ExternRef then "externref"
  end
end

## LEB128 encoding
def _encode_leb128_u32(inout buf: Array[u8], inout value: UInt) -> Unit
  loop
    let byte = (value & 0x7F) as u8
    value = value >> 7
    if value == 0 then
      buf.push(byte)
      break
    else
      buf.push(byte | 0x80)
    end
  end
end

def _encode_section(inout binary: Array[u8], id: u8, payload: Array[u8]) -> Unit
  binary.push(id)
  _encode_leb128_u32(binary, payload.len() as UInt)
  binary.extend_from_slice(payload)
end

## ─── Section encoders (WASM binary format) ─────────────────────────

def _encode_valtype(inout buf: Array[u8], vt: WasmValType) -> Unit
  match vt
  when I32 then buf.push(0x7F)
  when I64 then buf.push(0x7E)
  when F32 then buf.push(0x7D)
  when F64 then buf.push(0x7C)
  when ExternRef then buf.push(0x6F)
  end
end

def _encode_name(inout buf: Array[u8], name: String) -> Unit
  let bytes = name.as_bytes()
  _encode_leb128_u32(buf, bytes.len() as UInt)
  buf.extend_from_slice(&bytes)
end

def _encode_limits(inout buf: Array[u8], limits: Limits) -> Unit
  match limits.max
  when Some(max) then
    buf.push(0x01)  ## has max
    _encode_leb128_u32(buf, limits.min)
    _encode_leb128_u32(buf, *max)
  when None then
    buf.push(0x00)  ## no max
    _encode_leb128_u32(buf, limits.min)
  end
end

def _encode_type_section(ts: TypeSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, ts.types.len() as UInt)
  for ft in ts.types do
    buf.push(0x60)  ## functype marker
    _encode_leb128_u32(&mut buf, ft.params.len() as UInt)
    for p in ft.params do
      _encode_valtype(&mut buf, p)
    end
    _encode_leb128_u32(&mut buf, ft.results.len() as UInt)
    for r in ft.results do
      _encode_valtype(&mut buf, r)
    end
  end
  buf
end

def _encode_import_section(imp_sec: ImportSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, imp_sec.imports.len() as UInt)
  for imp in imp_sec.imports do
    _encode_name(&mut buf, &imp.module_name)
    _encode_name(&mut buf, &imp.name)
    match imp.desc
    when ImportDesc::Func(type_idx) then
      buf.push(0x00)
      _encode_leb128_u32(&mut buf, *type_idx)
    when ImportDesc::Memory(limits) then
      buf.push(0x02)
      _encode_limits(&mut buf, limits)
    when ImportDesc::Table(table_type) then
      buf.push(0x01)
      _encode_valtype(&mut buf, &table_type.element)
      _encode_limits(&mut buf, &table_type.limits)
    when ImportDesc::Global(global_type) then
      buf.push(0x03)
      _encode_valtype(&mut buf, &global_type.val_type)
      if global_type.mutable then buf.push(0x01) else buf.push(0x00) end
    end
  end
  buf
end

def _encode_function_section(fs: FunctionSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, fs.type_indices.len() as UInt)
  for idx in fs.type_indices do
    _encode_leb128_u32(&mut buf, *idx)
  end
  buf
end

def _encode_memory_section(ms: MemorySection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, ms.memories.len() as UInt)
  for mem in ms.memories do
    _encode_limits(&mut buf, mem)
  end
  buf
end

def _encode_table_section(ts: TableSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, ts.tables.len() as UInt)
  for tt in ts.tables do
    _encode_valtype(&mut buf, &tt.element)
    _encode_limits(&mut buf, &tt.limits)
  end
  buf
end

def _encode_element_section(es: ElementSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, es.elements.len() as UInt)
  for elem in es.elements do
    ## The active segment form: table index, offset init expr, funcs.
    _encode_leb128_u32(&mut buf, elem.table_index)
    buf.extend_from_slice(&elem.offset)
    buf.push(0x0B)  ## end opcode for the offset init expr
    _encode_leb128_u32(&mut buf, elem.func_indices.len() as UInt)
    for fi in elem.func_indices do
      _encode_leb128_u32(&mut buf, fi)
    end
  end
  buf
end

## The producer custom section payload: the toolchain provenance record
## ({"language": [Tangerine], "processed-by": [tg]}).
def _encode_producer_section() -> Array[u8]
  var buf = Array::new()
  _encode_name(&mut buf, "producer")
  _encode_leb128_u32(&mut buf, 2)  ## two fields
  ## field 1: language
  _encode_name(&mut buf, "language")
  _encode_leb128_u32(&mut buf, 1)
  _encode_name(&mut buf, "Tangerine")
  _encode_leb128_u32(&mut buf, 0)  ## no version
  ## field 2: processed-by
  _encode_name(&mut buf, "processed-by")
  _encode_leb128_u32(&mut buf, 1)
  _encode_name(&mut buf, "tg")
  _encode_leb128_u32(&mut buf, 0)  ## no version
  buf
end

def _encode_global_section(gs: GlobalSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, gs.globals.len() as UInt)
  for (global_type, init_expr) in gs.globals do
    _encode_valtype(&mut buf, &global_type.val_type)
    if global_type.mutable then buf.push(0x01) else buf.push(0x00) end
    buf.extend_from_slice(init_expr)
    buf.push(0x0B)  ## end opcode for init expr
  end
  buf
end

def _encode_export_section(es: ExportSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, es.exports.len() as UInt)
  for exp in es.exports do
    _encode_name(&mut buf, &exp.name)
    match exp.desc
    when ExportDesc::Func(idx) then
      buf.push(0x00)
      _encode_leb128_u32(&mut buf, *idx)
    when ExportDesc::Table(idx) then
      buf.push(0x01)
      _encode_leb128_u32(&mut buf, *idx)
    when ExportDesc::Memory(idx) then
      buf.push(0x02)
      _encode_leb128_u32(&mut buf, *idx)
    when ExportDesc::Global(idx) then
      buf.push(0x03)
      _encode_leb128_u32(&mut buf, *idx)
    end
  end
  buf
end

def _encode_code_section(cs: CodeSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, cs.bodies.len() as UInt)
  for body in cs.bodies do
    ## Encode the function body into a temporary buffer to get its length
    var func_buf = Array::new()
    _encode_leb128_u32(&mut func_buf, body.locals.len() as UInt)
    for (count, valtype) in body.locals do
      _encode_leb128_u32(&mut func_buf, *count)
      _encode_valtype(&mut func_buf, valtype)
    end
    func_buf.extend_from_slice(&body.code)
    func_buf.push(0x0B)  ## end opcode
    ## Write length-prefixed body
    _encode_leb128_u32(&mut buf, func_buf.len() as UInt)
    buf.extend_from_slice(&func_buf)
  end
  buf
end

def _encode_data_section(ds: DataSection) -> Array[u8]
  var buf = Array::new()
  _encode_leb128_u32(&mut buf, ds.segments.len() as UInt)
  for seg in ds.segments do
    _encode_leb128_u32(&mut buf, seg.memory_index)
    buf.extend_from_slice(&seg.offset)
    buf.push(0x0B)  ## end opcode for offset init expr
    _encode_leb128_u32(&mut buf, seg.data.len() as UInt)
    buf.extend_from_slice(&seg.data)
  end
  buf
end

end ## module tg_compiler::wasm_target
# ———————————————————————————————————————————————————————————————
# THE WASM CONFORMANCE SUITE — the P0.1 negative/positive additions
# (the TOP-LEVEL test section: the driver's @test discovery scans the
# file's TOP-LEVEL items — the module-scoped tests would never run).
# ———————————————————————————————————————————————————————————————
# Every MirRvalueKind / MirStatementKind / MirBinOpKind / MirUnOpKind /
# CastKind / MirConstantKind the wasm emitter handles is exercised here:
#
#   SUPPORTED variants  -> the program COMPILES and the emitted function
#                         body carries the asserted REAL wasm opcodes;
#   UNSUPPORTED variants -> the compilation FAILS with the stable
#                         "unsupported MIR <kind> <name> for the wasm
#                         target" diagnostic — never a silently emitted
#                         zero, fallback opcode, or no-op statement.
#
# THE INVENTORY (variant -> classification):
#   MirRvalueKind:
#     MirMove        SUPPORTED (value copy)          MirRef        SUPPORTED (address handle)
#     MirAggregate   SUPPORTED (slot-image build)    MirBinOp      SUPPORTED (per-family opcode table)
#     MirUnOp        SUPPORTED (per-family opcodes)  MirDiscriminant SUPPORTED (tag load)
#     MirLen         SUPPORTED (FixedArray count) | UNSUPPORTED (other sources)
#     MirCast        SUPPORTED (per-pair convert) | UNSUPPORTED (Transmute / gap pairs)
#     MirRepeat      SUPPORTED (slot-fill init)      MirPhi        UNSUPPORTED (no wasm phi placement)
#   MirBinOp:        Add/Sub/Mul/Div/Mod/BitAnd/BitOr/BitXor/Shl/Shr/Eq/Ne/Lt/Le/Gt/Ge
#                    SUPPORTED in the i32/i64 families; the arith+compare ops also in the
#                    f32/f64 families; the float bitwise/shift/rem gaps and mixed families
#                    UNSUPPORTED (diagnostic)
#   MirUnOp:         Neg SUPPORTED (all families); Not/BitNot SUPPORTED (int families),
#                    UNSUPPORTED (float/externref)
#   CastKind:        IntToInt/IntToFloat/FloatToInt/FloatToFloat/Pointer SUPPORTED for the
#                    convertible pairs; Transmute UNSUPPORTED
#   MirConstantKind: MirUnit/MirBool/MirInt/MirFloat/MirChar/MirString/MirZeroSized
#                    SUPPORTED; MirFnItem/MirStaticRef/MirStaticAddr UNSUPPORTED
#   MirStatementKind: MirAssign/MirStorageLive/MirStorageDead/MirNop/MirContractCheck
#                    SUPPORTED; MirBudgetConsume/MirEffectRecord/MirEffectPerform/
#                    MirEffectFrameEnter/MirEffectFrameExit UNSUPPORTED
#
# Run with: tg test tg_compiler/wasm_target.tg

use std::core::{Option, Result, Unit, Bool, panic}
use std::collections::{Vec}
use tg_compiler::types::{Type}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirBlock, MirLocal,
  MirStatement, MirStatementKind,
  MirTerminator, MirTerminatorKind,
  MirRvalue, MirRvalueKind,
  MirOperand, MirOperandKind,
  MirConstant, MirConstantKind,
  MirBinOp, MirUnOp, CastKind,
  AggregateKind, MirLocalId, MirBlockId,
  MirContract, MirContractKind, operand_copy_local, place_local
}
use tg_compiler::ids::{DefId, ModuleId, EffectId}
use tg_compiler::token::{span_dummy}

def wasm_test_check(cond: Bool, msg: String) -> Unit
  if !cond then
    panic("wasm conformance: " + msg)
  end
end

def wasm_test_check_eq(expected: Int, actual: Int, msg: String) -> Unit
  if expected != actual then
    panic("wasm conformance: " + msg + " (expected " + expected.to_string() + ", got " + actual.to_string() + ")")
  end
end

def _wasm_test_local(id: Int, name: String, ty: Type) -> MirLocal
  MirLocal { id: MirLocalId { id: id }, name: name, ty: ty, is_mut: false, span: span_dummy() }
end

# A single-block program `fn_name(p0, p1, ...)`: `_0 = rvalue; return`.
# The conformance convention (the committed make_add_program shape): the
# params are ALSO listed in `locals` (locals[0] is the return place).
def _wasm_test_rvalue_program(fn_name: String, ret_ty: Type, param_types: Vec[Type], rvalue: MirRvalue) -> MirProgram
  var locals = Vec::new()
  locals.push(_wasm_test_local(0, "_0", ret_ty))
  var params = Vec::new()
  var pi = 0
  while pi < param_types.len() do
    locals.push(_wasm_test_local(pi + 1, "p" + pi.to_string(), param_types[pi]))
    params.push(locals[locals.len() - 1].clone())
    pi = pi + 1
  end
  var stmts = Vec::new()
  stmts.push(MirStatement {
    kind: MirStatementKind::MirAssign(place_local(MirLocalId { id: 0 }), rvalue),
    span: span_dummy()
  })
  var blocks = Vec::new()
  blocks.push(MirBlock {
    id: MirBlockId { id: 0 },
    statements: stmts,
    terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  })
  var functions = Vec::new()
  functions.push(MirFunction {
    name: fn_name,
    params: params,
    ret_type: ret_ty,
    locals: locals,
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  })
  MirProgram { functions: functions, statics: Vec::new(), types: Vec::new() }
end

# A single-block program whose body is the given statement list.
def _wasm_test_stmt_program(fn_name: String, ret_ty: Type, locals: Vec[MirLocal], stmts: Vec[MirStatement]) -> MirProgram
  var blocks = Vec::new()
  blocks.push(MirBlock {
    id: MirBlockId { id: 0 },
    statements: stmts,
    terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  })
  var functions = Vec::new()
  functions.push(MirFunction {
    name: fn_name,
    params: Vec::new(),
    ret_type: ret_ty,
    locals: locals,
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  })
  MirProgram { functions: functions, statics: Vec::new(), types: Vec::new() }
end

def _wasm_test_compile(program: MirProgram) -> Vec[u8]
  let mut cfg = tg_compiler::wasm_target::WasmCompileConfig::default()
  cfg.target = tg_compiler::wasm_target::WasmTarget::Wasm32Unknown
  match tg_compiler::wasm_target::WasmCompiler::new(cfg).compile(&program)
  when Result::Ok(bytes) then bytes
  when Result::Err(e) then
    panic("wasm conformance: unexpected compile failure: " + e.to_string())
  end
end

# Compile and return the ERROR message; a successful compile is a test
# failure (the Unsupported variants must FAIL the compilation).
def _wasm_test_compile_error(program: MirProgram) -> String
  let mut cfg = tg_compiler::wasm_target::WasmCompileConfig::default()
  cfg.target = tg_compiler::wasm_target::WasmTarget::Wasm32Unknown
  match tg_compiler::wasm_target::WasmCompiler::new(cfg).compile(&program)
  when Result::Ok(_) then
    panic("wasm conformance: expected the compile to FAIL with the Unsupported diagnostic, but it succeeded")
  when Result::Err(e) then e.to_string()
  end
end

# The minimal independent wasm section walk: header, then each section's
# (id, len, payload); the CODE section's first body is decoded (the locals
# declaration groups are skipped) and its instruction bytes returned.
struct WasmTestCursor
  bytes: Vec[u8]
  pos: Int
end

def _wasm_test_u8(inout c: WasmTestCursor) -> Int
  let b = c.bytes[c.pos] as Int
  c.pos = c.pos + 1
  b
end

def _wasm_test_leb(inout c: WasmTestCursor) -> Int
  var result = 0
  var shift = 0
  var done = false
  while !done do
    let b = _wasm_test_u8(c)
    result = result | ((b & 0x7F) << shift)
    if (b & 0x80) == 0 then done = true else shift = shift + 7 end
  end
  result
end

def _wasm_test_body_bytes(bytes: Vec[u8]) -> Vec[u8]
  mut c = WasmTestCursor { bytes: bytes, pos: 8 }
  while c.pos < c.bytes.len() do
    let id = _wasm_test_u8(&mut c)
    let len = _wasm_test_leb(&mut c)
    let payload_start = c.pos
    if id == 10 then
      let _ = _wasm_test_leb(&mut c)  ## the code-section body count
      let body_len = _wasm_test_leb(&mut c)
      let body_end = c.pos + body_len
      let ngroups = _wasm_test_leb(&mut c)
      var g = 0
      while g < ngroups do
        let _ = _wasm_test_leb(&mut c)  ## the group count
        let _ = _wasm_test_u8(&mut c)   ## the group valtype
        g = g + 1
      end
      var out = Vec::new()
      while c.pos < body_end do
        out.push(_wasm_test_u8(&mut c) as u8)
      end
      return out
    end
    c.pos = payload_start + len
  end
  panic("wasm conformance: the binary carries no code section")
end

def _wasm_test_contains(bytes: Vec[u8], needle: Vec[u8]) -> Bool
  if needle.len() == 0 then return true end
  var i = 0
  while i <= bytes.len() - needle.len() do
    var j = 0
    var matches = true
    while j < needle.len() do
      if bytes[i + j] != needle[j] then
        matches = false
        break
      end
      j = j + 1
    end
    if matches then return true end
    i = i + 1
  end
  false
end

def _wasm_test_count_byte(bytes: Vec[u8], b: u8) -> Int
  var count = 0
  var i = 0
  while i < bytes.len() do
    if bytes[i] == b then count = count + 1 end
    i = i + 1
  end
  count
end

def _wasm_test_binop_program(op: MirBinOp, ty: Type) -> MirProgram
  _wasm_test_rvalue_program("f_binop", ty, vec![ty, ty],
    MirRvalue { kind: MirRvalueKind::MirBinOp(op, operand_copy_local(MirLocalId { id: 1 }), operand_copy_local(MirLocalId { id: 2 })) })
end

def _wasm_test_unop_program(op: MirUnOp, ty: Type) -> MirProgram
  _wasm_test_rvalue_program("f_unop", ty, vec![ty, ty],
    MirRvalue { kind: MirRvalueKind::MirUnOp(op, operand_copy_local(MirLocalId { id: 1 })) })
end

def _wasm_test_cast_program(kind: CastKind, p_ty: Type, target_ty: Type) -> MirProgram
  _wasm_test_rvalue_program("f_cast", target_ty, vec![p_ty, p_ty],
    MirRvalue { kind: MirRvalueKind::MirCast(kind, operand_copy_local(MirLocalId { id: 1 }), target_ty) })
end

def _wasm_test_int_constant(value: Int) -> MirConstant
  MirConstant { kind: MirConstantKind::MirInt(value), ty: Type::Int, instance: Option::None }
end

def _wasm_test_bool_constant(value: Bool) -> MirConstant
  MirConstant { kind: MirConstantKind::MirBool(value), ty: Type::Bool, instance: Option::None }
end

@test
def test_wasm_rvalues_supported() -> Unit
  ## MirMove: SUPPORTED — the operand's value.
  let body_move = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_move", Type::Int, vec![Type::Int],
      MirRvalue { kind: MirRvalueKind::MirMove(operand_copy_local(MirLocalId { id: 1 })) })))
  wasm_test_check(_wasm_test_contains(body_move, vec![0x20, 0x01]), "MirMove emits the operand's local.get")

  ## MirRef: SUPPORTED — the address handle.
  let body_ref = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_ref", Type::Int, vec![Type::Int],
      MirRvalue { kind: MirRvalueKind::MirRef(place_local(MirLocalId { id: 1 })) })))
  wasm_test_check(_wasm_test_contains(body_ref, vec![0x20, 0x01]), "MirRef emits the place's local.get")

  ## MirAggregate: SUPPORTED — the slot-image build (i32.sub, one
  ## i32.store per field, the base handle).
  let body_agg = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_agg", Type::Int, vec![Type::Int, Type::Int],
      MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple,
        vec![operand_copy_local(MirLocalId { id: 1 }), operand_copy_local(MirLocalId { id: 2 })]) })))
  wasm_test_check(_wasm_test_contains(body_agg, vec![0x6B]), "MirAggregate decrements the stack pointer (i32.sub)")
  wasm_test_check_eq(2, _wasm_test_count_byte(body_agg, 0x36), "MirAggregate stores one slot per field (i32.store)")

  ## MirBinOp: SUPPORTED — the i64 family opcode.
  let body_binop = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_binop_program(MirBinOp::Add, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_binop, vec![0x7C]), "MirBinOp(Add) on Int operands emits i64.add (0x7C)")

  ## MirUnOp: SUPPORTED — the i64 family opcode.
  let body_unop = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_unop_program(MirUnOp::Neg, Type::Int)))
  wasm_test_check(_wasm_test_contains(body_unop, vec![0x7E]), "MirUnOp(Neg) on an Int operand emits i64.mul -1 (0x7E)")

  ## MirDiscriminant: SUPPORTED — the tag word loads.
  let body_disc = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_disc", Type::Int, vec![Type::Int],
      MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(MirLocalId { id: 1 })) })))
  wasm_test_check(_wasm_test_contains(body_disc, vec![0x28, 0x02, 0x00, 0x28, 0x02, 0x00]), "MirDiscriminant emits the two i32.load tag reads")

  ## MirLen: SUPPORTED for the fixed-array form — the compile-time count.
  let body_len = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_len", Type::Int, vec![Type::Int, Type::FixedArray(Type::Int, 5)],
      MirRvalue { kind: MirRvalueKind::MirLen(place_local(MirLocalId { id: 1 })) })))
  wasm_test_check(_wasm_test_contains(body_len, vec![0x42, 0x05]), "MirLen of a FixedArray emits the i64.const count (5)")

  ## MirCast: SUPPORTED for the convertible pairs — the real convert opcode.
  let body_cast = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_cast_program(CastKind::IntToFloat, Type::Int, Type::Float)))
  wasm_test_check(_wasm_test_contains(body_cast, vec![0xB9]), "MirCast(IntToFloat i64 -> f64) emits f64.convert_i64_s (0xB9)")

  ## MirRepeat: SUPPORTED — the slot-fill initializer (alloc + one store
  ## per repetition).
  let body_rep = _wasm_test_body_bytes(_wasm_test_compile(
    _wasm_test_rvalue_program("f_rep", Type::Int, vec![Type::Int, Type::Int],
      MirRvalue { kind: MirRvalueKind::MirRepeat(operand_copy_local(MirLocalId { id: 1 }), 3) })))
  wasm_test_check(_wasm_test_contains(body_rep, vec![0x6B]), "MirRepeat allocates the slots (i32.sub)")
  wasm_test_check_eq(3, _wasm_test_count_byte(body_rep, 0x36), "MirRepeat stores the element once per repetition (3 x i32.store)")
end

@test
def test_wasm_binop_i64_family_opcodes() -> Unit
  var cases = vec![
    (MirBinOp::Add, 0x7C), (MirBinOp::Sub, 0x7D), (MirBinOp::Mul, 0x7E),
    (MirBinOp::Div, 0x7F), (MirBinOp::Mod, 0x81), (MirBinOp::BitAnd, 0x83),
    (MirBinOp::BitOr, 0x84), (MirBinOp::BitXor, 0x85), (MirBinOp::Shl, 0x86),
    (MirBinOp::Shr, 0x87), (MirBinOp::Eq, 0x51), (MirBinOp::Ne, 0x52),
    (MirBinOp::Lt, 0x53), (MirBinOp::Le, 0x57), (MirBinOp::Gt, 0x55),
    (MirBinOp::Ge, 0x59)
  ]
  for (op, opcode) in cases do
    let body = _wasm_test_body_bytes(_wasm_test_compile(_wasm_test_binop_program(op, Type::Int)))
    wasm_test_check(_wasm_test_contains(body, vec![opcode as u8]), "the i64 binop family emitted opcode 0x" + (opcode as Int).to_string())
  end
end

