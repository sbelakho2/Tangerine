use std::core::{Option, Result}
use std::args::{raw_arg_count, raw_arg_copy}
use tg_compiler::compiler_core::{compile_file, compile_startup_entry, default_options, StopAfter, CompilerOptions}
use tg_compiler::version::{VERSION}

def main() -> Int
  let argc = raw_arg_count()
  if argc < 2 then
    bootstrap_print_help()
    return 0
  end

  let command = raw_arg_copy(1)
  if command == "-h" || command == "--help" then
    bootstrap_print_help()
    return 0
  end
  if command == "-V" || command == "--version" then
    bootstrap_print_version()
    return 0
  end
  if command == "compile" then
    bootstrap_cmd_compile()
  elsif command == "check" then
    bootstrap_cmd_check()
  else
    println("error: unknown command: " + command)
    bootstrap_print_help()
    1
  end
end

def bootstrap_cmd_compile() -> Int
  var opts = default_options()
  opts.strict_resolution = true
  var file = ""
  var output_path = ""
  var i = 2
  let argc = raw_arg_count()
  while i < argc do
    let arg = raw_arg_copy(i)
    if arg == "-o" || arg == "--output" then
      i = i + 1
      if i >= argc then
        println("error: missing argument for " + arg)
        return 1
      end
      output_path = raw_arg_copy(i)
    elsif arg == "--target" then
      i = i + 1
      if i >= argc then
        println("error: missing argument for --target")
        return 1
      end
      opts.target_triple = Option::Some(raw_arg_copy(i))
    elsif arg == "-O0" then
      opts.opt_level = 0
    elsif arg == "-O1" then
      opts.opt_level = 1
    elsif arg == "-O2" then
      opts.opt_level = 2
    elsif arg == "-O3" then
      opts.opt_level = 3
    elsif arg == "--strict-resolution" then
      opts.strict_resolution = true
    elsif arg == "--dump-tokens" then
      opts.print_tokens = true
      opts.dump_phase = Option::Some("tokens")
    elsif arg == "--dump-ast" then
      opts.dump_phase = Option::Some("ast")
    elsif arg == "--dump-resolved-ast" then
      opts.dump_phase = Option::Some("resolved-ast")
    elsif arg == "--dump-mir-lowered" then
      opts.dump_phase = Option::Some("mir-lowered")
      opts.emit_mir = true
    elsif arg == "--dump-mir-mono" then
      opts.dump_phase = Option::Some("mir-mono")
      opts.emit_mir = true
    elsif arg == "--verbose" || arg == "-v" then
      opts.verbose = true
    elsif arg.starts_with("-") then
      println("error: unknown option: " + arg)
      return 1
    else
      if file.len() > 0 then
        println("error: multiple input files are not supported by the bootstrap entry")
        return 1
      end
      file = arg
    end
    i = i + 1
  end
  if file.len() == 0 then
    println("error: no input file")
    return 1
  end
  if output_path.len() == 0 then
    if file.ends_with(".tg") then
      output_path = file.slice(0, file.len() - 3)
    else
      output_path = file
    end
  end
  compile_startup_entry(&opts, file, output_path)
end

def bootstrap_cmd_check() -> Int
  var opts = default_options()
  opts.strict_resolution = true
  opts.check_only = true
  opts.stop_after = StopAfter::Mir
  var file = ""
  var i = 2
  let argc = raw_arg_count()
  while i < argc do
    let arg = raw_arg_copy(i)
    if arg == "--strict-resolution" then
      opts.strict_resolution = true
    elsif arg.starts_with("-") then
      println("error: unknown option: " + arg)
      return 1
    else
      if file.len() > 0 then
        println("error: multiple input files are not supported by the bootstrap entry")
        return 1
      end
      file = arg
    end
    i = i + 1
  end
  if file.len() == 0 then
    println("error: no input file")
    return 1
  end
  var exit_code = 0
  match compile_file(&opts, file)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    println(e)
    exit_code = 1
  end
  exit_code
end

def bootstrap_print_version() -> Unit
  println("Tangerine compiler v" + VERSION)
  println("Self-hosting edition")
end

def bootstrap_print_help() -> Unit
  println("Usage: tg-bootstrap <command> [options]")
  println("")
  println("Commands:")
  println("  compile <file> -o <out> --target <triple> [OPTIONS]")
  println("  check <file>")
  println("  --version, -V")
  println("  --help, -h")
  println("")
  println("Compile options:")
  println("  -o, --output <FILE>   Output executable path")
  println("  --target <TRIPLE>     Target triple (e.g. aarch64-apple-darwin)")
  println("  -O0 / -O1 / -O2 / -O3 Optimization level")
  println("  --strict-resolution   Treat unresolved names as errors (always on)")
  println("  --dump-tokens         Dump tokens and stop (driver phase hook)")
  println("  --dump-ast            Dump the parsed AST and stop")
  println("  --dump-resolved-ast   Dump the expanded/resolved AST and stop")
  println("  --dump-mir-lowered    Dump MIR after lowering and stop")
  println("  --dump-mir-mono       Dump MIR after monomorphization and stop")
end
