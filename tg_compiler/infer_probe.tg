# infer_probe.tg — focused probe for the kernel checker's inference /
# expected-type propagation families:
#   VAR    — "unresolved inference variable (Type::Var) ..." gate rows
#   PARAM  — "generic parameter (Type::Param) ..." gate rows
#   INFER  — "cannot infer type parameter/const parameter ..." rows
#   UNIFY  — "cannot unify ..." rows
#   IMPLCONF — the impl-conformance rows (E0229 trait argument count,
#              E0226 return type, E0224 parameter type) that the in-VM
#              kernel must agree with the host typechecker on.
#
# Modes:
#   1. a standalone battery of the representative expected-type shapes
#      (call results solved from the use-site's declared type, generic
#      call instantiation from the expected type, enum-path values,
#      casts, chained destinations);
#   2. the merged corpus mode (flag build/infer_merged.flag) — the
#      differential corpus entry + the std preludes merged exactly like
#      the kernel's compile path AND prepared with the SAME canonical
#      preparation the real compile path runs (apply_cfg_elimination +
#      prepare_parsed: macro expansion + node-id assignment), then
#      type-checked by the REAL kernel checker; every family row is
#      counted and written to build/infer_probe.txt.
#
# Plus the MIR LOWERING regression (flag build/infer_lower.flag, the
# `tg_infer --lower` mode): the REAL compile path (analyze_parsed) then
# lower_to_mir TWICE over the same borrowed tree — the lowering
# ownership contract's executable pin (the pre-fix `into_inner()`
# extractions freed the borrowed tree's boxes and the second pass
# trapped on the freed region).
#
# bootstrap/infer_mini.manifest closes it under the seed VM;
# stage0_ocaml/selfcheck/tg_infer.ml runs it as the focused regression.
use std::core::{Option, Result}
use std::collections::{Vec, Map, Set}
use std::fs::{read_file, write_file, file_exists, delete_file}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors, Diagnostic}
use tg_compiler::ast::{assign_node_ids, Program, Item, ItemId, ModuleId, Module, Crate, UseDecl, Span}
use tg_compiler::token::{span_dummy}
use tg_compiler::resolver::{resolve_names}
use tg_compiler::ids::{TypeId, TraitId, GenericParamId, DefId, ModuleId, ClosureId, GenericArg, def_id_numeric, IntrinsicId, intrinsic_id_numeric}
use tg_compiler::types::{type_env_new, type_check_typed, verify_typed_channel_completeness, TypeCheckResult, type_display, unify, TypeEnv, ImplInfo, TraitRefTemplate, impl_candidate_indices, register_impl_candidate_index, subst_snapshot, subst_restore, errors_truncate, try_head_unify, impl_head_bucket, TypeVarId, GlobalBinding, fn_owner_key_of_def}
use tg_compiler::compiler_core::{default_options, apply_cfg_elimination, prepare_parsed, analyze_parsed}
use tg_compiler::mir::{lower_to_mir, verify_mir, MirProgram, MirRvalue, MirOperand, MirStatementKind, MirRvalueKind, MirOperandKind, MirConstantKind}
use tg_compiler::access_check::{access_check, AccessError}
use tg_compiler::resource_check::{resource_check, build_typed_cfg, analysis_context_new, ResourceError, engine_env_empty}

# The family classification: every kernel diagnostic that names one of the
# four inference/expected-type families. The order resolves the only
# overlap (a gate row never contains "cannot unify").
def infer_probe_n(n: Int) -> Int
  n
end

def infer_probe_class_of(msg: String) -> String
  if msg.contains("unresolved inference variable (Type::Var)") then return "VAR" end
  if msg.contains("generic parameter (Type::Param)") then return "PARAM" end
  if msg.contains("cannot infer type parameter") || msg.contains("cannot infer const parameter") then return "INFER" end
  if msg.contains("cannot unify") then return "UNIFY" end
  infer_probe_residual_class(msg.clone())
end

# ———————————————————————————————————————————————————————————————
# Residual re-bucketing: every non-family diagnostic is canonically
# normalized so the class table collapses the id-varying duplicates — the
# variance channels in the kernel's messages are the embedded TypeId
# ("Named#123") and the numeric node/var/literal ids ("node 11334",
# "?T501", "IntLiteral(61440)"). Every DIGIT RUN of length >= 2 becomes
# "N" (single digits stay: "u8" is a type spelling, not an id). The class
# is the whole normalized message (capped) so distinct shapes stay
# distinct rows.
# ———————————————————————————————————————————————————————————————

def infer_probe_is_digit(ch: String) -> Bool
  ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
  ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
end

def infer_probe_norm_ids(s: String) -> String
  var out = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if infer_probe_is_digit(ch.clone()) then
      var j = i
      while j < s.len() do
        if infer_probe_is_digit(s.slice(j, j + 1)) then
          j = j + 1
        else
          break
        end
      end
      if j - i >= 2 then
        out = out + "N"
      else
        out = out + ch
      end
      i = j
    else
      out = out + ch
      i = i + 1
    end
  end
  out
end

def infer_probe_residual_class(msg: String) -> String
  let norm = infer_probe_norm_ids(msg.clone())
  if norm.len() > 140 then norm.slice(0, 140) else norm end
end

# The structural renderer for the unresolved-node dump (the family work's
# construct identification): Var -> "?<id>", Adt -> "#<id>[..]", the
# wrappers recurse; everything else is a scalar tag.
def infer_probe_render(ty: Type) -> String
  match ty
  when Type::Var(id) then "?" + id.to_string()
  when Type::Param(p) then "P#" + p.index.to_string()
  when Type::Adt(tid, args) then
    var out = "#" + tid.id.to_string() + "["
    var i = 0
    while i < args.len() do
      if i > 0 then out = out + "," end
      out = out + infer_probe_render(args[i].clone())
      i = i + 1
    end
    out + "]"
  when Type::Ptr(inner) then "Ptr[" + infer_probe_render(inner) + "]"
  when Type::PtrMut(inner) then "PtrMut[" + infer_probe_render(inner) + "]"
  when Type::RefInternal(inner, _) then "Ref[" + infer_probe_render(inner) + "]"
  when Type::Tuple(fs) then
    var out2 = "("
    var j = 0
    while j < fs.len() do
      if j > 0 then out2 = out2 + "," end
      out2 = out2 + infer_probe_render(fs[j].clone())
      j = j + 1
    end
    out2 + ")"
  when Type::FixedArray(elem, n) then "[" + infer_probe_render(elem) + ";" + n.to_string() + "]"
  when Type::FixedArraySym(elem, _) then "[" + infer_probe_render(elem) + ";N]"
  when Type::FnPtr(ps, ret, _) then
    var out3 = "fn("
    var k = 0
    while k < ps.len() do
      if k > 0 then out3 = out3 + "," end
      out3 = out3 + infer_probe_render(ps[k].ty.clone())
      k = k + 1
    end
    out3 + ")->" + infer_probe_render(ret)
  when Type::Closure(_, ps, ret, _, _) then
    var out4 = "clo("
    var m = 0
    while m < ps.len() do
      if m > 0 then out4 = out4 + "," end
      out4 = out4 + infer_probe_render(ps[m].ty.clone())
      m = m + 1
    end
    out4 + ")->" + infer_probe_render(ret)
  when Type::IntLiteral(v) then "lit(" + v.to_string() + ")"
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::String then "String"
  when Type::Never then "Never"
  when Type::Error then "Error"
  when _ then "t"
  end
end

def infer_probe_has_var(ty: Type) -> Bool
  match ty
  when Type::Var(_) then true
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if infer_probe_has_var(a) then found = true end
    end
    found
  when Type::Ptr(inner) then infer_probe_has_var(inner)
  when Type::PtrMut(inner) then infer_probe_has_var(inner)
  when Type::RefInternal(inner, _) then infer_probe_has_var(inner)
  when Type::Tuple(fs) then
    var found2 = false
    for f in fs do
      if infer_probe_has_var(f) then found2 = true end
    end
    found2
  when Type::FixedArray(elem, _) then infer_probe_has_var(elem)
  when Type::FixedArraySym(elem, _) then infer_probe_has_var(elem)
  when Type::FnPtr(ps, ret, _) then
    var found3 = infer_probe_has_var(ret)
    for p in ps do
      if infer_probe_has_var(p.ty.clone()) then found3 = true end
    end
    found3
  when Type::Closure(_, ps, ret, _, _) then
    var found4 = infer_probe_has_var(ret)
    for p in ps do
      if infer_probe_has_var(p.ty.clone()) then found4 = true end
    end
    found4
  when _ then false
  end
end

# The source line at a byte offset (the construct-identification channel
# for the unresolved dump): the merged source's first line from the span.
def infer_probe_src_snippet(inout cache: Map[String, String], file: String, start: Int) -> String
  var src = ""
  match cache.get(file.clone())
  when Option::Some(s) then src = s.clone()
  when Option::None then
    if file.len() > 0 then
      match read_file(file.clone())
      when Result::Ok(s2) then src = s2.clone()
      when Result::Err(_) then ()
      end
    end
    cache.insert(file.clone(), src.clone())
  end
  if src.len() == 0 then return "-" end
  if start < 0 || start >= src.len() then return "-" end
  var endp = start + 64
  if endp > src.len() then endp = src.len() end
  let raw = src.slice(start, endp)
  let lines = raw.split("\n")
  if lines.len() > 0 then lines[0].clone() else raw end
end

# The unresolved-record dump: the first 160 expression nodes / locals whose
# recorded type still carries an inference variable, with the node's span
# and owner — the family work's construct identification channel.
def infer_probe_dump_unresolved(env: TypeEnv, inout report: String) -> Unit
  var shown = 0
  var file_cache: Map[String, String] = Map::new()
  let entries = env.typed_expr_types.entries()
  var i = 0
  while i < entries.len() do
    let nid = entries[i].0
    let ty = entries[i].1
    if infer_probe_has_var(ty.clone()) && shown < 160 then
      let sp = match env.typed_node_spans.get(nid)
      when Option::Some(s) then s.clone()
      when Option::None then Span { file: "", start: 0, end_pos: 0 }
      end
      let owner = match env.typed_node_owners.get(nid)
      when Option::Some(o) then o.clone()
      when Option::None then "".to_string()
      end
      report = report + "  NR node=" + nid.to_string() + " owner=" + owner.clone() + " file=" + sp.file.clone() + ":" + sp.start.to_string() + " ty=" + infer_probe_render(ty.clone()) + " src=" + infer_probe_src_snippet(&mut file_cache, sp.file.clone(), sp.start) + "\n"
      shown = shown + 1
    end
    i = i + 1
  end
  let lentries = env.typed_local_bindings.entries()
  var li = 0
  var lshown = 0
  while li < lentries.len() do
    let lid = lentries[li].0
    let lb = lentries[li].1
    if infer_probe_has_var(lb.ty.clone()) && lshown < 60 then
      let owner2 = match env.typed_local_owners.get(lid)
      when Option::Some(o) then o.clone()
      when Option::None then "".to_string()
      end
      report = report + "  NL local=" + lid.to_string() + " name=" + lb.name.clone() + " owner=" + owner2.clone() + " ty=" + infer_probe_render(lb.ty.clone()) + "\n"
      lshown = lshown + 1
    end
    li = li + 1
  end
end

# (name resolution for the residual table): the merged env's TypeDef table
# rows for every user-level id (>= 140 — above the builtin/primitive
# domain), so a "Named#N" class is identifiable by name. Printed once per
# merged run.
def infer_probe_type_kind_tag(td: TypeDef) -> String
  match td.def_kind
  when TypeDefKind::Struct(_) then "Struct"
  when TypeDefKind::Enum(_) then "Enum"
  when TypeDefKind::Trait(_) then "Trait"
  when TypeDefKind::Alias(_) then "Alias"
  when TypeDefKind::Opaque then "Opaque"
  when TypeDefKind::Primitive then "Primitive"
  when _ then "Other"
  end  end
end

def infer_probe_dump_types(env: TypeEnv, inout report: String) -> Unit
  report = report + "  LANG option=" + env.lang_items.option.to_string() +
    " result=" + env.lang_items.result.to_string() +
    " vec=" + env.lang_items.vec.to_string() +
    " array=" + env.lang_items.array.to_string() +
    " map=" + env.lang_items.map.to_string() +
    " set=" + env.lang_items.set.to_string() +
    " box=" + env.lang_items.box_.to_string() +
    " rc=" + env.lang_items.rc.to_string() +
    " slice=" + env.lang_items.slice.to_string() +
    " ptr=" + env.lang_items.ptr.to_string() +
    " ptr_mut=" + env.lang_items.ptr_mut.to_string() + "\n"
  var i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    if td.id.id >= 100 then
      report = report + "  TY #" + td.id.id.to_string() + " " + td.name.clone() + " " + infer_probe_type_kind_tag(td) + "\n"
    end
    i = i + 1
  end
end

# (cfg elimination, focused): the probe host is macOS. The kernel's real
# compile path eliminates @cfg-gated items before checking; the probe
# drops the windows/linux-gated items so its diagnostics match the real
# target's closure (an item with any other cfg — macos, any/all/not
# forms — is kept).
def infer_probe_item_active(item: Item) -> Bool
  for attr in item.attrs do
    if attr.name == "cfg" then
      var drop_it = false
      for a in attr.args do
        if a == "windows" || a == "linux" then drop_it = true end
      end
      if drop_it then return false end
    end
  end
  true
end

def infer_probe_run_case(label: String, source: String, inout report: String, inout counts: Vec[Int]) -> Int
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "CASE " + label.clone() + ": parse-failed\n"
    return 0
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var case_var = 0
    var case_param = 0
    var case_infer = 0
    var case_unify = 0
    var i = 0
    while i < result.errors.len() do
      let msg = result.errors[i].message.clone()
      let cls = infer_probe_class_of(msg.clone())
      if cls == "VAR" then
        case_var = case_var + 1
        report = report + "  V " + label.clone() + "@" + result.errors[i].span.start.to_string() + ": " + msg.clone() + "\n"
      end
      if cls == "PARAM" then
        case_param = case_param + 1
        report = report + "  P " + label.clone() + "@" + result.errors[i].span.start.to_string() + ": " + msg.clone() + "\n"
      end
      if cls == "INFER" then
        case_infer = case_infer + 1
        report = report + "  I " + label.clone() + "@" + result.errors[i].span.start.to_string() + ": " + msg.clone() + "\n"
      end
      if cls == "UNIFY" then
        case_unify = case_unify + 1
        report = report + "  U " + label.clone() + "@" + result.errors[i].span.start.to_string() + ": " + msg.clone() + "\n"
      end
      i = i + 1
    end
    counts.set(0, counts[0] + case_var)
    counts.set(1, counts[1] + case_param)
    counts.set(2, counts[2] + case_infer)
    counts.set(3, counts[3] + case_unify)
    counts.set(4, counts[4] + result.errors.len())
    report = report + "CASE " + label.clone() + ": errors=" + result.errors.len().to_string() + " VAR=" + case_var.to_string() + " PARAM=" + case_param.to_string() + " INFER=" + case_infer.to_string() + " UNIFY=" + case_unify.to_string() + "\n"
    0
  when Result::Err(errs) then
    report = report + "CASE " + label.clone() + ": resolve-failed=" + errs.len().to_string() + "\n"
    var rei = 0
    while rei < errs.len() && rei < 4 do
      report = report + "    RE: " + errs[rei].message.clone() + " @" + errs[rei].span.file.clone() + ":" + errs[rei].span.start.to_string() + "\n"
      rei = rei + 1
    end
    0
  end
end

# ———————————————————————————————————————————————————————————————
# the INTEGRATED resource/access pass (the gate's [6/10] lane consumed
# through the kernel's own checkers): the SAME sequence the real compile
# path runs in compiler_core's analyze_parsed — build_typed_cfg ONCE,
# access_check over the shared AnalysisContext, then resource_check with
# the typechecker's engine snapshot. Every ResourceError is bucketed by
# class (maybe-consumed / let-param-readonly / owned-result-dropped /
# consume-in-loop / created-in-loop / inout-param / consumed-twice /
# use-after-consume / use-uninitialized / other) and reported with its
# file:site and source snippet, plus a per-file tally. This is the
# iteration harness: the resource parity work is measured here without
# the full compile.
# ———————————————————————————————————————————————————————————————

# (temporary effect-channel debug): dump every recorded access effect with
# its node's resolved type, so a Consume record on an argument can be
# attributed to the exact call shape. Gated on build/infer_effects.flag.
def infer_probe_dump_effects(typed: TypedProgram, label: String, inout report: String) -> Unit
  report = report + "EFFECTS " + label.clone() + " count=" + typed.access_effects.len().to_string() + "\n"
  for (nid, eff) in typed.access_effects do
    var word = "read"
    match eff
    when AccessEffect::Read then word = "read"
    when AccessEffect::Consume then word = "consume"
    when AccessEffect::Modify then word = "modify"
    when AccessEffect::Initialize then word = "initialize"
    end
    var ty_s = "?"
    match typed.expr_types.get(nid)
    when Option::Some(t) then ty_s = type_display(engine_env_empty(), t.clone())
    when Option::None then ()
    end
    var local_s = ""
    match typed.ident_resolutions.get(nid)
    when Option::Some(lid) then local_s = " local=" + lid.to_string()
    when Option::None then ()
    end
    var call_s = ""
    match typed.call_targets.get(nid)
    when Option::Some(_) then call_s = " call-target"
    when Option::None then ()
    end
    report = report + "  EFF " + label.clone() + " node=" + nid.to_string() + " " + word + " type=" + ty_s + local_s + call_s + "\n"
  end
end

def infer_probe_resource_class(msg: String) -> String
  if msg.contains("may be consumed on one path") then return "maybe-consumed" end
  if msg.contains("let parameter is read-only") then return "let-param-readonly" end
  if msg.contains("owned resource result must be consumed") then return "owned-result-dropped" end
  if msg.contains("cannot be consumed inside a repeatable loop") then return "consume-in-loop" end
  if msg.contains("created in loop") then return "created-in-loop" end
  if msg.contains("inout parameter may be modified but not consumed") then return "inout-param" end
  if msg.contains("consumed twice") then return "consumed-twice" end
  if msg.contains("use of consumed") then return "use-after-consume" end
  if msg.contains("use of uninitialized") then return "use-uninitialized" end
  "other"
end

def infer_probe_resource_class_index(cls: String) -> Int
  if cls == "maybe-consumed" then 0
  elsif cls == "let-param-readonly" then 1
  elsif cls == "owned-result-dropped" then 2
  elsif cls == "consume-in-loop" then 3
  elsif cls == "created-in-loop" then 4
  elsif cls == "inout-param" then 5
  elsif cls == "consumed-twice" then 6
  elsif cls == "use-after-consume" then 7
  elsif cls == "use-uninitialized" then 8
  else 9
  end
end

def infer_probe_resource_class_name(i: Int) -> String
  if i == 0 then "maybe-consumed"
  elsif i == 1 then "let-param-readonly"
  elsif i == 2 then "owned-result-dropped"
  elsif i == 3 then "consume-in-loop"
  elsif i == 4 then "created-in-loop"
  elsif i == 5 then "inout-param"
  elsif i == 6 then "consumed-twice"
  elsif i == 7 then "use-after-consume"
  elsif i == 8 then "use-uninitialized"
  else "other"
  end
end

def infer_probe_resource_note_file(inout keys: Vec[String], inout counts: Vec[Int], file: String) -> Unit
  var ki = 0
  var found = -1
  while ki < keys.len() do
    if keys[ki] == file then found = ki end
    ki = ki + 1
  end
  if found < 0 then
    keys.push(file.clone())
    counts.push(1)
  else
    counts.set(found, counts[found] + 1)
  end
end

# Run the integrated access + resource pass over an already-prepared
# program (the typechecker's result carries the typed HIR and the engine
# snapshot). Every resource diagnostic is classified, counted and (for the
# first 60 of each class) printed with its source line. Returns the number
# of access findings (must be 0 for a clean closure).
def infer_probe_run_resource_pass(program: Program, tr: TypeCheckResult, label: String, inout report: String, inout res_counts: Vec[Int], inout res_shown: Vec[Int], inout res_rows: Vec[String], inout res_row_counts: Vec[Int], inout res_row_samples: Vec[String], inout res_files: Vec[String], inout res_file_counts: Vec[Int], inout snippet_cache: Map[String, String], show_all: Bool) -> Int
  let cfg = build_typed_cfg(&program, &tr.program.typed)
  var actx = analysis_context_new()
  let access_errors = access_check(&program, &tr.program.typed, &cfg, &mut actx)
  var engine_snapshot = tr.program.engine_snapshot
  let res_result = resource_check(&program, &tr.program.typed, &cfg, &mut actx, &mut engine_snapshot)
  var ai = 0
  while ai < access_errors.len() do
    if show_all && ai < 60 then
      let asp = access_errors[ai].span.clone()
      report = report + "  AR " + label.clone() + " " + asp.file.clone() + ":" + asp.start.to_string() + ": " + access_errors[ai].message.clone() + "\n"
    end
    ai = ai + 1
  end
  var i = 0
  while i < res_result.errors.len() do
    let err = res_result.errors[i]
    let cls = infer_probe_resource_class(err.message.clone())
    let ci = infer_probe_resource_class_index(cls.clone())
    res_counts.set(ci, res_counts[ci] + 1)
    let sp = err.span.clone()
    infer_probe_resource_note_file(&mut res_files, &mut res_file_counts, sp.file.clone())
    let snippet = infer_probe_src_snippet(&mut snippet_cache, sp.file.clone(), sp.start)
    let sample = err.message.clone() + " @" + sp.file.clone() + ":" + sp.start.to_string() + " | " + snippet.clone()
    infer_probe_note_row(&mut res_rows, &mut res_row_counts, &mut res_row_samples, cls.clone(), sp.file.clone(), sp.start, sample)
    if res_shown[ci] < 60 then
      report = report + "  RR " + label.clone() + " " + sp.file.clone() + ":" + sp.start.to_string() + " [" + cls.clone() + "] " + err.message.clone() + " | " + snippet.clone() + "\n"
      res_shown.set(ci, res_shown[ci] + 1)
    end
    i = i + 1
  end
  report = report + label.clone() + ": items=" + program.items.len().to_string() + " access=" + access_errors.len().to_string() + " resource=" + res_result.errors.len().to_string() + "\n"
  res_result.errors.len()
end

# ———————————————————————————————————————————————————————————————
# the MIR LOWERING stage (the freed-region regression): the kernel's
# lowering is a READ-ONLY pass over a BORROWED, aliased AST (mir.tg's
# lower_program contract comment). This stage runs the REAL compile
# path — analyze_parsed (canonical preparation + strict resolve +
# typecheck + access + resource) — and then lowers the SAME tree TWICE:
# the second pass re-reads every Box[Expr] the first pass read, so any
# ownership-taking extraction (the pre-fix `into_inner()` sites) has
# deallocated a region the owner still holds and the VM traps with
# `host call __intrinsic_ptr_read: access to freed region` — the exact
# bootstrap failure (`... in qualify_field_callee_name ...`). The rows
# are the assertion targets of `tg_infer --lower`:
#   MIR_LOWER <label> functions=N errors=0
#   MIR_RELOWER <label> functions=N errors=0
# ———————————————————————————————————————————————————————————————
# ———————————————————————————————————————————————————————————————
# (table-persistence regression): the builder-state copy bug class. Every
# lowered MirFunction MUST carry its return-place local (local 0 = the
# `_ret` slot, added by start_function) and the parameter table of its
# declaration — `match b.current_fn when Option::Some(f) then
# f.locals.push(...)` without the `b.current_fn = Option::Some(f)`
# write-back mutated a COPY, so every function ended with locals=0/params=0
# and `lookup_local_type` answered Type::Unit for every id (the
# missing-scrutinee-identity ICE). The row below is the executable pin:
# empty_locals counts functions with an EMPTY local table (must be 0 — the
# return place is unconditional) and params_total sums every function's
# parameter table (must be >= the shape's declared parameter minimum).
# `MIR_LOCALCHECK <label> pass` is the assertion target of tg_infer
# --lower/--lower-shapes (the lower_enum_payload / lower_match_field /
# lower_closure_capture rows are the direct regression set).
def infer_probe_check_mir_tables(mir: MirProgram, label: String, min_params: Int, inout report: String) -> Bool
  var empty_locals = 0
  var empty_params = 0
  var bodyless = 0
  var params_total = 0
  var fi = 0
  while fi < mir.functions.len() do
    let f = mir.functions[fi]
    # (the declaration class): an extern function (or any declaration
    # without a lowered body) carries NO local/parameter table by
    # construction — the MirFunction record is the declaration surface, not
    # a lowered body. The table-persistence invariant is about LOWERED
    # functions (the return place is unconditional there); counting
    # declarations was the empty_locals=30 false row.
    if f.is_extern || f.blocks.is_empty() then
      bodyless = bodyless + 1
    else
      if f.locals.is_empty() then
        empty_locals = empty_locals + 1
        if empty_locals <= 8 then
          report = report + "MIR_EMPTY_LOCALS " + label.clone() + " fn=" + f.name.clone() + "\n"
        end
      end
      if f.params.is_empty() then
        empty_params = empty_params + 1
      end
      params_total = params_total + f.params.len()
    end
    fi = fi + 1
  end
  report = report + "MIR_LOCALS " + label.clone() + " functions=" + mir.functions.len().to_string() + " bodyless=" + bodyless.to_string() + " empty_locals=" + empty_locals.to_string() + " empty_params=" + empty_params.to_string() + " params_total=" + params_total.to_string() + "\n"
  if empty_locals == 0 && params_total >= min_params then
    report = report + "MIR_LOCALCHECK " + label.clone() + " pass\n"
    true
  else
    report = report + "MIR_LOCALCHECK " + label.clone() + " fail empty_locals=" + empty_locals.to_string() + " params_total=" + params_total.to_string() + " min_params=" + min_params.to_string() + "\n"
    false
  end
end

def infer_probe_lower_program(program: Program, label: String, min_params: Int, inout report: String) -> Int
  var env = type_env_new()
  env.strict_resolution = true
  let opts = default_options()
  report = report + "MIR_ANALYZE " + label.clone() + " begin\n"
  let _ = write_file("build/infer_probe.txt", report.clone())
  match analyze_parsed(&mut env, &mut program, opts)
  when Result::Ok(analyzed) then
    report = report + "MIR_ANALYZE " + label.clone() + " ok\n"
    let _ = write_file("build/infer_probe.txt", report.clone())
    match lower_to_mir(&program, &analyzed)
    when Result::Ok(mir) then
      report = report + "MIR_LOWER " + label.clone() + " functions=" + mir.functions.len().to_string() + " errors=0\n"
      # (MIR_VERIFY row dump): the post-lower verify_mir faces over the
      # SAME lowered program, row by row — the corpus-probe parity channel
      # (the kernel's compile pipeline reports the identical rows; this
      # probe makes them iterable without the full kernel closure run).
      let vrows = verify_mir(mir.clone())
      report = report + "MIR_VERIFY " + label.clone() + " rows=" + vrows.len().to_string() + "\n"
      var vri = 0
      while vri < vrows.len() do
        report = report + "MIR_VERIFY_ROW " + label.clone() + " " + vrows[vri].clone() + "\n"
        vri = vri + 1
      end
      let _ = infer_probe_check_mir_tables(mir, label.clone(), min_params, &mut report)
      let _ = write_file("build/infer_probe.txt", report.clone())
      match lower_to_mir(&program, &analyzed)
      when Result::Ok(mir2) then
        report = report + "MIR_RELOWER " + label.clone() + " functions=" + mir2.functions.len().to_string() + " errors=0\n"
        let _ = infer_probe_check_mir_tables(mir2, label.clone() + "-relower", min_params, &mut report)
        let _ = write_file("build/infer_probe.txt", report.clone())
        0
      when Result::Err(e2) then
        report = report + "MIR_RELOWER " + label.clone() + " error=" + e2.clone() + "\n"
        let _ = write_file("build/infer_probe.txt", report.clone())
        2
      end
    when Result::Err(e) then
      report = report + "MIR_LOWER " + label.clone() + " error=" + e.clone() + "\n"
      let _ = write_file("build/infer_probe.txt", report.clone())
      2
    end
  when Result::Err(diags) then
    report = report + "MIR_LOWER " + label.clone() + " analyze-diags=" + diags.len().to_string() + "\n"
    var di = 0
    while di < diags.len() && di < 6 do
      report = report + "  MDA " + label.clone() + " " + diags[di].message.clone() + "\n"
      di = di + 1
    end
    let _ = write_file("build/infer_probe.txt", report.clone())
    2
  end
end

# the lowering SHAPE entry: a tiny inline program through the SAME
# analyze + double-lowering sequence as the merged stage. `min_params` is
# the shape's declared parameter minimum — the table-persistence leg
# (MIR_LOCALCHECK) asserts every function carries its return place and the
# shape's parameter tables survive lowering.
def infer_probe_run_lower_shape(label: String, source: String, min_params: Int, inout report: String) -> Int
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "MIR_LOWER " + label.clone() + " parse-failed\n"
    return 2
  end
  var program = parsed.program
  infer_probe_lower_program(program, label, min_params, &mut report)
end

def infer_probe_resource_totals_word(res_counts: Vec[Int]) -> String
  "RESOURCE errors=" + (res_counts[0] + res_counts[1] + res_counts[2] + res_counts[3] + res_counts[4] + res_counts[5] + res_counts[6] + res_counts[7] + res_counts[8] + res_counts[9]).to_string() +
    " maybe-consumed=" + res_counts[0].to_string() +
    " let-param-readonly=" + res_counts[1].to_string() +
    " owned-result-dropped=" + res_counts[2].to_string() +
    " consume-in-loop=" + res_counts[3].to_string() +
    " created-in-loop=" + res_counts[4].to_string() +
    " inout-param=" + res_counts[5].to_string() +
    " consumed-twice=" + res_counts[6].to_string() +
    " use-after-consume=" + res_counts[7].to_string() +
    " use-uninitialized=" + res_counts[8].to_string() +
    " other=" + res_counts[9].to_string()
end

# the SHAPE battery entry: a tiny inline program through the SAME
# preparation (assign_node_ids -> resolve -> typecheck -> the integrated
# resource pass), every diagnostic printed verbatim — the construct-level
# kernel-vs-seed parity channel of the resource work.
def infer_probe_run_shape(label: String, source: String, inout report: String, inout res_counts: Vec[Int], inout res_shown: Vec[Int], inout res_rows: Vec[String], inout res_row_counts: Vec[Int], inout res_row_samples: Vec[String], inout res_files: Vec[String], inout res_file_counts: Vec[Int], inout snippet_cache: Map[String, String]) -> Int
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "SHAPE " + label.clone() + ": parse-failed\n"
    return 0
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() > 0 then
      report = report + "SHAPE " + label.clone() + ": typecheck errors=" + result.errors.len().to_string() + "\n"
      var ei = 0
      while ei < result.errors.len() && ei < 6 do
        report = report + "    TE " + result.errors[ei].message.clone() + "\n"
        ei = ei + 1
      end
      return 0
    end
    report = report + "SHAPE " + label.clone() + ":\n"
    # seed the snippet cache under the shape's label so every diagnostic's
    # offset renders the exact source text at the span.
    snippet_cache.insert(label.clone(), source.clone())
    if file_exists("build/infer_effects.flag") then
      infer_probe_dump_effects(result.program.typed, label.clone(), &mut report)
    end
    infer_probe_run_resource_pass(program, result, "shape:" + label.clone(), report, res_counts, res_shown, res_rows, res_row_counts, res_row_samples, res_files, res_file_counts, snippet_cache, true)
    0
  when Result::Err(errs) then
    report = report + "SHAPE " + label.clone() + ": resolve-failed=" + errs.len().to_string() + "\n"
    0
  end
end

# ———————————————————————————————————————————————————————————————
# merged corpus mode — the a4/c3/c5 probe loader pattern (strip
# debug_assert statements, load the preludes + their `use` dependencies,
# merge every item into one program with per-item owner modules, then run
# the real kernel checker).
# ———————————————————————————————————————————————————————————————

def infer_probe_strip_debug_assert_pass(source: String) -> String
  let parts = source.split("debug_assert!")
  if parts.len() <= 1 then
    return source
  end
  var out = parts[0].clone()
  var pi = 1
  while pi < parts.len() do
    let seg = parts[pi].clone()
    if seg.starts_with("(") then
      var depth = 0
      var i = 0
      var close_idx = -1
      var comma_idx = -1
      var saw_comma = false
      while i < seg.len() do
        let ch = seg.slice(i, i + 1)
        if ch == "(" then depth = depth + 1 end
        if ch == ")" then
          depth = depth - 1
          if depth == 0 then
            close_idx = i
            break
          end
        end
        if ch == "," && depth == 1 && !saw_comma then
          comma_idx = i
          saw_comma = true
        end
        i = i + 1
      end
      if close_idx < 0 then
        out = out + "debug_assert!" + seg
      else
        let inner_end = if comma_idx >= 0 then comma_idx else close_idx end
        out = out + "(" + seg.slice(1, inner_end) + ")"
        out = out + seg.slice(close_idx + 1, seg.len())
      end
    else
      out = out + "debug_assert!" + seg
    end
    pi = pi + 1
  end
  out
end

def infer_probe_strip_debug_assert(source: String) -> String
  var cur = source.clone()
  var pass = 0
  while pass < 8 && cur.contains("debug_assert!") do
    cur = infer_probe_strip_debug_assert_pass(cur)
    pass = pass + 1
  end
  cur
end

def infer_probe_join_path(segments: Vec[String]) -> String
  var out = ""
  var i = 0
  while i < segments.len() do
    if i > 0 then out = out + "::" end
    out = out + segments[i].clone()
    i = i + 1
  end
  out
end

def infer_probe_module_path_from_file(path: String) -> Vec[String]
  var segments = Vec::new()
  let parts = path.split("/")
  var pi = 0
  while pi < parts.len() do
    var seg = parts[pi].clone()
    if pi == parts.len() - 1 && seg.ends_with(".tg") then
      seg = seg.slice(0, seg.len() - 3)
    end
    if !seg.is_empty() then
      segments.push(seg)
    end
    pi = pi + 1
  end
  segments
end

def infer_probe_build_dep_file_path(segments: Vec[String], count: Int) -> Option[String]
  if count < 2 then
    return Option::None
  end
  let root = segments[0]
  var path = if root == "std" then "std/" elsif root == "tg_compiler" then "tg_compiler/" else return Option::None end
  var i = 1
  while i < count do
    if i > 1 then path = path + "/" end
    path = path + segments[i]
    i = i + 1
  end
  Option::Some(path + ".tg")
end

def infer_probe_dep_use_to_file(u: UseDecl) -> Option[String]
  let segment_count = u.path.segments.len()
  if segment_count < 2 then
    return Option::None
  end
  match u.names
  when Option::Some(_) then return infer_probe_build_dep_file_path(u.path.segments.clone(), segment_count)
  when Option::None then ()
  end
  if u.glob then
    return infer_probe_build_dep_file_path(u.path.segments.clone(), segment_count)
  end
  match infer_probe_build_dep_file_path(u.path.segments.clone(), segment_count)
  when Option::Some(full_path) then
    if file_exists(full_path.clone()) then
      return Option::Some(full_path)
    end
    if segment_count > 2 then
      match infer_probe_build_dep_file_path(u.path.segments.clone(), segment_count - 1)
      when Option::Some(parent_path) then
        if file_exists(parent_path.clone()) then
          return Option::Some(parent_path)
        end
      when Option::None then ()
      end
    end
    Option::None
  when Option::None then Option::None
  end
end

def infer_probe_collect_dep_file(path: String, inout out: Vec[Item], inout loaded: Set[String], inout modules: Map[ModuleId, Module]) -> Int
  if loaded.contains(&path) then
    return 0
  end
  loaded.insert(path.clone())
  if !file_exists(path.clone()) then
    return 2
  end
  let source = match read_file(path.clone())
  when Result::Ok(s) then s
  when Result::Err(_) then return 2
  end
  let parsed = parse(tokenize(infer_probe_strip_debug_assert(source), path.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    return 3
  end
  let dep_ast = parsed.program
  for item in dep_ast.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      match infer_probe_dep_use_to_file(u.clone())
      when Option::Some(p) then
        let rc = infer_probe_collect_dep_file(p, &mut out, &mut loaded, &mut modules)
        if rc != 0 then return rc end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  var mod_start = out.len()
  let dep_id = ModuleId { id: modules.len() }
  for item in dep_ast.items do
    if infer_probe_item_active(item.clone()) then
      var owned = item.clone()
      owned.owner_module = dep_id
      out.push(owned)
    end
  end
  var mod_items = Vec::new()
  var mi = mod_start
  while mi < out.len() do
    mod_items.push(ItemId { id: mi })
    mi = mi + 1
  end
  var mod_imports = Vec::new()
  for item in dep_ast.items do
    match item.kind
    when ItemKind::ItemUse(u) then mod_imports.push(infer_probe_join_path(u.path.segments.clone()))
    when _ then ()
    end
  end
  modules.insert(dep_id, Module {
    id: dep_id,
    path: infer_probe_module_path_from_file(path.clone()),
    items: mod_items,
    imports: mod_imports
  })
  0
end

# Per-construct tally: the (class, file) pairs and the first message of
# each pair — the "with their constructs" extraction the report needs.
def infer_probe_note_row(inout keys: Vec[String], inout counts: Vec[Int], inout samples: Vec[String], cls: String, file: String, start: Int, msg: String) -> Unit
  let key = cls.clone() + " " + file.clone()
  var ki = 0
  var found = -1
  while ki < keys.len() do
    if keys[ki] == key then found = ki end
    ki = ki + 1
  end
  if found < 0 then
    keys.push(key.clone())
    counts.push(1)
    samples.push(msg.clone())
  else
    counts.set(found, counts[found] + 1)
  end
end

# The impl-conformance class: the trait-impl conformance diagnostics
# (E0229 trait argument count, E0226 return type, E0224 parameter type,
# E0225 access convention) — the rows the in-VM kernel must agree with
# the host typechecker on.
def infer_probe_implconf_code(code: String) -> Bool
  code == "E0229" || code == "E0226" || code == "E0224" || code == "E0225"
end

def infer_probe_run_merged(corpus_path: String, inout report: String, inout counts: Vec[Int], inout rows: Vec[String], inout row_counts: Vec[Int], inout row_samples: Vec[String], inout res_counts: Vec[Int], inout res_shown: Vec[Int], inout res_rows: Vec[String], inout res_row_counts: Vec[Int], inout res_row_samples: Vec[String], inout res_files: Vec[String], inout res_file_counts: Vec[Int], inout snippet_cache: Map[String, String]) -> Int
  let source = match read_file(corpus_path.clone())
  when Result::Ok(s) then s
  when Result::Err(_) then
    report = report + "MERGED: cannot read corpus\n"
    return 2
  end
  let parsed = parse(tokenize(infer_probe_strip_debug_assert(source), corpus_path.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "MERGED: corpus parse failed\n"
    return 2
  end
  var merged_items = Vec::new()
  for item in parsed.program.items do
    if infer_probe_item_active(item.clone()) then merged_items.push(item.clone()) end
  end
  var root_items = Vec::new()
  var ri = 0
  while ri < merged_items.len() do
    root_items.push(ItemId { id: ri })
    ri = ri + 1
  end
  let root_id = ModuleId { id: 0 }
  var merged_modules = Map::new()
  merged_modules.insert(root_id, Module {
    id: root_id,
    path: Vec::new(),
    items: root_items,
    imports: Vec::new()
  })
  var loaded = Set::new()
  let preludes = ["std/alloc.tg", "std/collections.tg", "std/core.tg", "std/ffi.tg", "std/fmt.tg", "std/fs.tg", "std/io.tg", "std/taint.tg"]
  var pi = 0
  while pi < preludes.len() do
    let rc = infer_probe_collect_dep_file(preludes[pi].clone(), &mut merged_items, &mut loaded, &mut merged_modules)
    if rc != 0 then
      report = report + "MERGED: load failed (" + rc.to_string() + ") " + preludes[pi].clone() + "\n"
      return 2
    end
    pi = pi + 1
  end
  var program = Program {
    items: merged_items,
    crate: Crate { root: root_id, modules: merged_modules },
    span: parsed.program.span.clone()
  }
  # (the lowering regression input): the RAW merged program — the
  # lowering stage below feeds analyze_parsed (which runs its own
  # canonical preparation), so it must start from the unprepared tree.
  let raw_program = program.clone()
  # (canonical preparation — the REAL compile path's analyze_parsed head):
  # @cfg elimination, then prepare_parsed (macro expansion + node-id
  # assignment). The merged mode MUST run this: the kernel's impl
  # conformance reads the impl's DECLARED trait instantiation
  # (`impl[K, V] Iterator[K] for ...` -> 1 trait argument), so any
  # preparation pass that rewrites impl items must preserve it end to
  # end — skipping the preparation would hide exactly the family this
  # probe exists to pin.
  let prep_opts = default_options()
  apply_cfg_elimination(&mut program, prep_opts)
  var prep_diags: Vec[Diagnostic] = Vec::new()
  prepare_parsed(&mut program, &mut prep_diags)
  if diag_has_errors(&prep_diags) then
    report = report + "MERGED: canonical preparation failed (" + prep_diags.len().to_string() + " diagnostic(s))\n"
    return 2
  end
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var n_var = 0
    var n_param = 0
    var n_infer = 0
    var n_unify = 0
    var n_implconf = 0
    var shown_var = 0
    var shown_param = 0
    var shown_infer = 0
    var shown_unify = 0
    var shown_implconf = 0
    var snippet_cache: Map[String, String] = Map::new()
    var shown_residual = 0
    var i = 0
    while i < result.errors.len() do
      let msg = result.errors[i].message.clone()
      let sp = result.errors[i].span.clone()
      let cls = infer_probe_class_of(msg.clone())
      if cls == "VAR" then
        n_var = n_var + 1
        if shown_var < 60 then
          report = report + "  MV " + sp.file + ":" + sp.start.to_string() + ": " + msg.clone() + "\n"
          shown_var = shown_var + 1
        end
      end
      if cls == "PARAM" then
        n_param = n_param + 1
        if shown_param < 60 then
          report = report + "  MP " + sp.file + ":" + sp.start.to_string() + ": " + msg.clone() + "\n"
          shown_param = shown_param + 1
        end
      end
      if cls == "INFER" then
        n_infer = n_infer + 1
        if shown_infer < 60 then
          report = report + "  MI " + sp.file + ":" + sp.start.to_string() + ": " + msg.clone() + "\n"
          shown_infer = shown_infer + 1
        end
      end
      if cls == "UNIFY" then
        n_unify = n_unify + 1
        if shown_unify < 60 then
          report = report + "  MU " + sp.file + ":" + sp.start.to_string() + ": " + msg.clone() + "\n"
          shown_unify = shown_unify + 1
        end
      end
      # (impl-conformance class): the E0229/E0226/E0224/E0225 rows — the
      # in-VM kernel's trait-impl conformance verdicts. These MUST be 0:
      # the host typechecker reports 0 errors on the same modules.
      let ecode = match result.errors[i].code
      when Option::Some(c) then c.clone()
      when Option::None then ""
      end
      if infer_probe_implconf_code(ecode.clone()) then
        n_implconf = n_implconf + 1
        if shown_implconf < 60 then
          report = report + "  IC " + sp.file.clone() + ":" + sp.start.to_string() + " [" + ecode.clone() + "]: " + msg.clone() + "\n"
          shown_implconf = shown_implconf + 1
        end
      end
      if cls != "VAR" && cls != "PARAM" && cls != "INFER" && cls != "UNIFY" then
        if shown_residual < 140 then
          report = report + "  RE " + sp.file.clone() + ":" + sp.start.to_string() + " [" + cls.clone() + "] | " + infer_probe_src_snippet(&mut snippet_cache, sp.file.clone(), sp.start) + "\n"
          shown_residual = shown_residual + 1
        end
      end
      if cls != "other" then
        let snippet = infer_probe_src_snippet(&mut snippet_cache, sp.file.clone(), sp.start)
        let sample = msg.clone() + " @" + sp.file.clone() + ":" + sp.start.to_string() + " | " + snippet
        infer_probe_note_row(&mut rows, &mut row_counts, &mut row_samples, cls.clone(), sp.file.clone(), sp.start, sample)
      else
        # (residual re-bucketing): the non-family diagnostics are the
        # class-table rows too — the normalized message as the class and
        # the message + the source line of the first occurrence as the
        # representative.
        let snippet = infer_probe_src_snippet(&mut snippet_cache, sp.file.clone(), sp.start)
        let sample = msg.clone() + " @" + sp.file.clone() + ":" + sp.start.to_string() + " | " + snippet
        infer_probe_note_row(&mut rows, &mut row_counts, &mut row_samples, cls.clone(), sp.file.clone(), sp.start, sample)
      end
      i = i + 1
    end
    counts.set(0, counts[0] + n_var)
    counts.set(1, counts[1] + n_param)
    counts.set(2, counts[2] + n_infer)
    counts.set(3, counts[3] + n_unify)
    counts.set(4, counts[4] + result.errors.len())
    counts.set(5, counts[5] + n_implconf)
    infer_probe_dump_unresolved(env, &mut report)
    infer_probe_dump_types(env, &mut report)
    report = report + "MERGED: items=" + program.items.len().to_string() + " errors=" + result.errors.len().to_string() + " VAR=" + n_var.to_string() + " PARAM=" + n_param.to_string() + " INFER=" + n_infer.to_string() + " UNIFY=" + n_unify.to_string() + " IMPLCONF=" + n_implconf.to_string() + "\n"
    if result.errors.len() == 0 then
      report = report + "RESOURCE_BEGIN merged\n"
      let _ = write_file("build/infer_probe.txt", report.clone())
      let merged_resource_errors = infer_probe_run_resource_pass(program, result, "merged", &mut report, &mut res_counts, &mut res_shown, &mut res_rows, &mut res_row_counts, &mut res_row_samples, &mut res_files, &mut res_file_counts, &mut snippet_cache, false)
      report = report + "MERGED_RESOURCE errors=" + merged_resource_errors.to_string() + "\n"
      report = report + infer_probe_resource_totals_word(res_counts.clone()) + "\n"
      # (the MIR lowering regression, flag build/infer_lower_merged.flag):
      # the REAL compile path from the raw merged closure — analyze_parsed
      # then lower_to_mir TWICE over the same borrowed tree. Any
      # ownership-taking lowering extraction leaves a freed region and
      # this stage (or the VM itself) fails closed. The flag is separate
      # from the shape battery's (build/infer_lower.flag) so the
      # minutes-scale merged leg is opt-in on its own.
      if file_exists("build/infer_lower_merged.flag") then
        report = report + "MIR_LOWER_BEGIN merged\n"
        let _ = write_file("build/infer_probe.txt", report.clone())
        let _ = infer_probe_lower_program(raw_program, "merged", 1, &mut report)
        report = report + "MIR_LOWER_END merged\n"
        let _ = write_file("build/infer_probe.txt", report.clone())
      end
    else
      report = report + "RESOURCE_SKIPPED merged: typecheck errors=" + result.errors.len().to_string() + "\n"
    end
    # The per-construct tally, sorted by class then count (insertion sort —
    # deterministic).
    var si = 1
    while si < rows.len() do
      var sj = si
      while sj > 0 && row_counts[sj] > row_counts[sj - 1] do
        let tk = rows[sj]
        let tc = row_counts[sj]
        let ts = row_samples[sj]
        rows.set(sj, rows[sj - 1])
        row_counts.set(sj, row_counts[sj - 1])
        row_samples.set(sj, row_samples[sj - 1])
        rows.set(sj - 1, tk)
        row_counts.set(sj - 1, tc)
        row_samples.set(sj - 1, ts)
        sj = sj - 1
      end
      si = si + 1
    end
    var rj = 0
    while rj < rows.len() do
      report = report + "ROW " + rows[rj] + " count=" + row_counts[rj].to_string() + " sample=" + row_samples[rj] + "\n"
      rj = rj + 1
    end
    0
  when Result::Err(errs) then
    report = report + "MERGED: resolve failed -> " + errs.len().to_string() + "\n"
    2
  end
end

# ———————————————————————————————————————————————————————————————
# direct kernel-unify battery (the F32/F64/StaticStrPtr regression):
# calls the kernel's `unify` on constructed Types and pins BOTH the
# Boolean and the exact single "type mismatch: <a> vs <b>" diagnostic.
# The self-host preflight only reached this arm at ~43.4e9 steps (a
# non-exhaustive outer match aborted the kernel the first time an
# f32/f64/static-string comparison reached unification), so this cheap
# direct invocation is the regression's unit test:
#   unify(F32,F32)=true, unify(F64,F64)=true,
#   unify(StaticStrPtr,StaticStrPtr)=true,
#   unify(F32,F64)=false + one mismatch,
#   unify(F64,Float)=false + one mismatch (distinct scalars — the
#     declared exact-match policy; no implicit F64/Float conversion),
#   unify(StaticStrPtr,String)=false + one mismatch (the explicit
#     string_from_static coercion bridges the pair; bare unification
#     never does).
# ———————————————————————————————————————————————————————————————
def infer_probe_unify_mismatch(inout env: TypeEnv, inout report: String, a: Type, b: Type, want: String, sp: Span) -> Int
  let before = env.errors.len()
  let ok = unify(&mut env, a.clone(), b.clone(), sp)
  let added = env.errors.len() - before
  var fails = 0
  if ok then
    report = report + "UNIFY_BATTERY " + want.clone() + " expected=false got=true\n"
    fails = fails + 1
  end
  if added != 1 then
    report = report + "UNIFY_BATTERY " + want.clone() + " diagnostics=" + added.to_string() + " (want 1)\n"
    fails = fails + 1
  elsif !env.errors[before].message.contains("type mismatch: " + want.clone()) then
    report = report + "UNIFY_BATTERY " + want.clone() + " diagnostic=" + env.errors[before].message.clone() + "\n"
    fails = fails + 1
  end
  fails
end

def infer_probe_unify_battery(inout report: String) -> Int
  var fails = 0
  let sp = span_dummy()
  var env = type_env_new()
  if !unify(&mut env, Type::F32, Type::F32, sp.clone()) then
    report = report + "UNIFY_BATTERY F32_F32 expected=true got=false\n"
    fails = fails + 1
  end
  if !unify(&mut env, Type::F64, Type::F64, sp.clone()) then
    report = report + "UNIFY_BATTERY F64_F64 expected=true got=false\n"
    fails = fails + 1
  end
  if !unify(&mut env, Type::StaticStrPtr, Type::StaticStrPtr, sp.clone()) then
    report = report + "UNIFY_BATTERY StaticStrPtr_StaticStrPtr expected=true got=false\n"
    fails = fails + 1
  end
  fails = fails + infer_probe_unify_mismatch(&mut env, &mut report, Type::F32, Type::F64, "F32 vs F64", sp.clone())
  fails = fails + infer_probe_unify_mismatch(&mut env, &mut report, Type::F64, Type::Float, "F64 vs Float", sp.clone())
  fails = fails + infer_probe_unify_mismatch(&mut env, &mut report, Type::StaticStrPtr, Type::String, "StaticStrPtr vs String", sp.clone())
  report = report + "UNIFY_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# direct obligation-candidate-index battery (the candidate-scan wall):
# builds a synthetic impl corpus across three traits and several head
# shapes, indexes it exactly like registration does, and for a battery of
# self types verifies:
#   * every returned index carries the queried trait;
#   * the result is strictly ascending registration order;
#   * NO candidate whose head unifies with the self type is ever dropped
#     (the index may over-include — a pre-filter, never a decision —
#     but a false negative would change solver results).
# ———————————————————————————————————————————————————————————————
def infer_probe_args1(a: Type) -> Vec[Type]
  var v = Vec::new()
  v.push(a)
  v
end

def infer_probe_args2(a: Type, b: Type) -> Vec[Type]
  var v = Vec::new()
  v.push(a)
  v.push(b)
  v
end

def infer_probe_synth_impl(trait_id: Int, head: Type) -> ImplInfo
  ImplInfo {
    trait_id: TraitId { id: trait_id },
    trait_name: "Synthetic",
    for_type: head,
    obligations: Vec::new(),
    methods: Vec::new(),
    generic_params: Vec::new(),
    trait_ref: TraitRefTemplate { trait_id: TraitId { id: trait_id }, args: Vec::new() }
  }
end

def infer_probe_index_contains(v: Vec[Int], x: Int) -> Bool
  var i = 0
  while i < v.len() do
    if v[i] == x then return true end
    i = i + 1
  end
  false
end

def infer_probe_impl_index_check(inout env: TypeEnv, inout report: String, trait_id: Int, self_ty: Type, idxs: Vec[Int]) -> Int
  var fails = 0
  var prev = -1
  var k = 0
  while k < idxs.len() do
    let idx = idxs[k]
    if idx <= prev then
      report = report + "IMPL_INDEX_BATTERY not ascending: trait=" + trait_id.to_string() + " idx=" + idx.to_string() + "\n"
      fails = fails + 1
    end
    prev = idx
    if env.impls[idx].trait_id.id != trait_id then
      report = report + "IMPL_INDEX_BATTERY wrong trait: expected=" + trait_id.to_string() + " idx=" + idx.to_string() + "\n"
      fails = fails + 1
    end
    k = k + 1
  end
  # completeness: every trait candidate whose head unifies with the self
  # must be returned.  A dropped unifying candidate is a solver-visible
  # false negative and fails the battery.
  var i = 0
  while i < env.impls.len() do
    let imp = env.impls[i]
    if imp.trait_id.id == trait_id then
      let snap = subst_snapshot(env)
      let errs = env.errors.len()
      let unifies = try_head_unify(&mut env, imp.for_type.clone(), self_ty.clone())
      subst_restore(&mut env, &snap)
      errors_truncate(&mut env, errs)
      if unifies && !infer_probe_index_contains(idxs, i) then
        report = report + "IMPL_INDEX_BATTERY dropped a unifying candidate: trait=" + trait_id.to_string() + " idx=" + i.to_string() + "\n"
        fails = fails + 1
      end
    end
    i = i + 1
  end
  fails
end

def infer_probe_impl_index_battery(inout report: String) -> Int
  var env = type_env_new()
  var heads = Vec::new()
  heads.push((9001, Type::Int))
  heads.push((9001, Type::U8))
  heads.push((9001, Type::String))
  heads.push((9001, Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::Int))))
  heads.push((9001, Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::String))))
  heads.push((9001, Type::Adt(TypeId { id: 9102 }, infer_probe_args1(Type::Int))))
  heads.push((9001, Type::Ptr(Type::Int)))
  heads.push((9001, Type::PtrMut(Type::Int)))
  heads.push((9001, Type::Tuple(infer_probe_args2(Type::Int, Type::String))))
  heads.push((9001, Type::FixedArray(Type::Int, 4)))
  heads.push((9001, Type::Never))
  heads.push((9001, Type::Error))
  heads.push((9002, Type::Int))
  heads.push((9002, Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::Int))))
  heads.push((9003, Type::Adt(TypeId { id: 9103 }, infer_probe_args1(Type::Int))))
  var i = 0
  while i < heads.len() do
    let pair = heads[i]
    env.impls.push(infer_probe_synth_impl(pair.0, pair.1.clone()))
    register_impl_candidate_index(&mut env, env.impls.len() - 1, pair.0)
    i = i + 1
  end
  var selves = Vec::new()
  selves.push(Type::Int)
  selves.push(Type::U8)
  selves.push(Type::String)
  selves.push(Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::Int)))
  selves.push(Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::U8)))
  selves.push(Type::Adt(TypeId { id: 9102 }, infer_probe_args1(Type::Int)))
  selves.push(Type::Adt(TypeId { id: 9103 }, infer_probe_args1(Type::Int)))
  selves.push(Type::Ptr(Type::Int))
  selves.push(Type::PtrMut(Type::Int))
  selves.push(Type::Tuple(infer_probe_args2(Type::Int, Type::String)))
  selves.push(Type::Tuple(infer_probe_args1(Type::Int)))
  selves.push(Type::FixedArray(Type::Int, 4))
  selves.push(Type::Never)
  selves.push(Type::Error)
  var fails = 0
  var q = 0
  while q < selves.len() do
    var tr = 9001
    while tr <= 9004 do
      let idxs = impl_candidate_indices(&env, tr, selves[q].clone())
      fails = fails + infer_probe_impl_index_check(&mut env, &mut report, tr, selves[q].clone(), idxs)
      tr = tr + 1
    end
    q = q + 1
  end
  report = report + "IMPL_INDEX_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# compiler-private intrinsic enforcement: `__intrinsic_map_clone` is the
# persistent-map snapshot, NOT generic Clone semantics.  The kernel
# matrix proves seed/kernel parity and the two-factor authorization:
#   A. untrusted declaration + call             -> REJECTED
#   B. untrusted declaration only               -> REJECTED
#   C. same-named ordinary user FUNCTION        -> ACCEPTED (parity)
#   F. trusted origin + NON-compiler module     -> REJECTED (trust alone
#      is insufficient; the exact compiler module is also required)
# The module-path spoofing cases live in the seed matrix
# (tg_intrinsic_privacy D/E), where the parse entry can carry a
# synthetic `tg_compiler::types` module path; the kernel's authorization
# is origin-first, so an untrusted spoofed path is rejected by the same
# untrusted gate as A/B.
# ———————————————————————————————————————————————————————————————
def infer_probe_private_run(source: String, trusted: Bool) -> (Int, Bool, Int)
  let parsed = parse(tokenize(source, "privacy"))
  if diag_has_errors(&parsed.diagnostics) then
    return (1, false, 0)
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    env.trusted_compiler_origin = trusted
    let result = type_check_typed(&mut env, &program, &res)
    var found = false
    var i = 0
    while i < result.errors.len() do
      if result.errors[i].message.contains("compiler-internal intrinsic") then
        found = true
      end
      i = i + 1
    end
    (result.errors.len(), found, typed_intrinsic_classification_count(&env))
  when Result::Err(errs) then
    (errs.len() + 1000, false, 0)
  end
end

# whether any checker diagnostic contains `needle` (a fresh check pass).
def infer_probe_has_error(source: String, needle: String) -> Bool
  let parsed = parse(tokenize(source, "battery"))
  if diag_has_errors(&parsed.diagnostics) then
    return false
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var found = false
    var i = 0
    while i < result.errors.len() do
      if result.errors[i].message.contains(needle.clone()) then
        found = true
      end
      i = i + 1
    end
    found
  when Result::Err(_errs) then
    false
  end
end

def infer_probe_restricted_intrinsic_battery(inout report: String) -> Int
  var fails = 0
  let a_src = "extern def __intrinsic_map_clone(v: Int) -> Int\n\ndef main() -> Int\n  let w = __intrinsic_map_clone(1)\n  0\nend\n"
  let (a_n, a_found, _ai) = infer_probe_private_run(a_src, false)
  if !a_found then
    report = report + "RESTRICTED_INTRINSIC_BATTERY A: ordinary declaration+call was not rejected (errors=" + a_n.to_string() + ")\n"
    fails = fails + 1
  end
  let b_src = "extern def __intrinsic_map_clone(v: Int) -> Int\n\ndef main() -> Int\n  0\nend\n"
  let (b_n, b_found, _bi) = infer_probe_private_run(b_src, false)
  if !b_found then
    report = report + "RESTRICTED_INTRINSIC_BATTERY B: declaration-only was not rejected (errors=" + b_n.to_string() + ")\n"
    fails = fails + 1
  end
  let c_src = "def __intrinsic_map_clone(v: Int) -> Int\n  v\nend\n\ndef main() -> Int\n  let w = __intrinsic_map_clone(1)\n  0\nend\n"
  let (c_n, c_found, c_i) = infer_probe_private_run(c_src, false)
  if c_n != 0 || c_found || c_i != 0 then
    report = report + "RESTRICTED_INTRINSIC_BATTERY C: same-named ordinary function was not ACCEPTED as a user call (errors=" + c_n.to_string() + " intrinsics=" + c_i.to_string() + ")\n"
    fails = fails + 1
  end
  # C2 (identity-level parity): a SIGNATURE-COMPATIBLE same-named user
  # function resolves to the user callable and must never be re-stamped
  # by the name-based intrinsic router (intrinsics=0).
  let c2_src = "def __intrinsic_map_clone[K, V](m: Map[K, V]) -> Map[K, V]\n  m\nend\n\ndef main() -> Int\n  var m: Map[Int, Int] = Map::new()\n  let m2 = __intrinsic_map_clone(m)\n  0\nend\n"
  let (c2_n, c2_found, c2_i) = infer_probe_private_run(c2_src, false)
  if c2_n != 0 || c2_found || c2_i != 0 then
    report = report + "RESTRICTED_INTRINSIC_BATTERY C2: signature-compatible same-named function was re-interpreted (errors=" + c2_n.to_string() + " intrinsics=" + c2_i.to_string() + ")\n"
    fails = fails + 1
  end
  # F: trusted origin, but the item's module is not a compiler module —
  # the second authorization factor must still reject the declaration.
  let (f_n, f_found, _fi) = infer_probe_private_run(a_src, true)
  if !f_found then
    report = report + "RESTRICTED_INTRINSIC_BATTERY F: trusted origin without the exact compiler module was not rejected (errors=" + f_n.to_string() + ")\n"
    fails = fails + 1
  end
  report = report + "RESTRICTED_INTRINSIC_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# head-bucket CROSS-PRODUCT property (future-proofing the candidate
# prefilter against new Type variants): for every representative pair
# (A as candidate head, B as obligation self), if the ordinary unifier
# accepts A against B then the bucket prefilter must NOT separate them
# (bucket(A) == bucket(B), or either side is the always-scanned wild
# bucket).  A deliberate under-inclusion — the only solver-visible
# failure mode of the index — is reported per pair.
# ———————————————————————————————————————————————————————————————
def infer_probe_head_cross_product(inout report: String) -> Int
  var env = type_env_new()
  let gpid = GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }
  var reps = Vec::new()
  reps.push(Type::Unit)
  reps.push(Type::Bool)
  reps.push(Type::Int)
  reps.push(Type::UInt)
  reps.push(Type::Float)
  reps.push(Type::Char)
  reps.push(Type::String)
  reps.push(Type::StaticStrPtr)
  reps.push(Type::Never)
  reps.push(Type::I8)
  reps.push(Type::I64)
  reps.push(Type::U8)
  reps.push(Type::U64)
  reps.push(Type::ISize)
  reps.push(Type::USize)
  reps.push(Type::F32)
  reps.push(Type::F64)
  reps.push(Type::IntLiteral(5))
  reps.push(Type::Ptr(Type::Int))
  reps.push(Type::PtrMut(Type::Int))
  reps.push(Type::RefInternal(Type::Int, false))
  reps.push(Type::RefInternal(Type::Int, true))
  reps.push(Type::Tuple(infer_probe_args1(Type::Int)))
  reps.push(Type::Tuple(infer_probe_args2(Type::Int, Type::String)))
  reps.push(Type::FixedArray(Type::Int, 4))
  reps.push(Type::FixedArraySym(Type::Int, gpid.clone()))
  reps.push(Type::FnPtr(Vec::new(), Type::Int, Vec::new()))
  reps.push(Type::Closure(ClosureId { id: 1 }, Vec::new(), Type::Int, Type::Int, Vec::new()))
  reps.push(Type::Dyn(TypeId { id: 9101 }))
  reps.push(Type::Dyn(TypeId { id: 9102 }))
  reps.push(Type::Effect(Vec::new(), Type::Int))
  reps.push(Type::Var(TypeVarId { id: 7001 }))
  reps.push(Type::Param(gpid.clone()))
  reps.push(Type::Const(3))
  reps.push(Type::ConstParam(gpid.clone()))
  reps.push(Type::Adt(TypeId { id: 9101 }, infer_probe_args1(Type::Int)))
  reps.push(Type::Adt(TypeId { id: 9102 }, infer_probe_args1(Type::Int)))
  reps.push(Type::Error)
  var fails = 0
  var ai = 0
  while ai < reps.len() do
    var bi = 0
    while bi < reps.len() do
      let a = reps[ai]
      let b = reps[bi]
      let snap = subst_snapshot(env)
      let errs = env.errors.len()
      let unifies = try_head_unify(&mut env, a.clone(), b.clone())
      subst_restore(&mut env, &snap)
      errors_truncate(&mut env, errs)
      if unifies then
        let ba = impl_head_bucket(&env, a.clone())
        let bb = impl_head_bucket(&env, b.clone())
        if ba != "wild" && bb != "wild" && ba != bb then
          report = report + "HEAD_CROSS_PRODUCT underincludes: head=" + type_display(env, a.clone()) + " self=" + type_display(env, b.clone()) + " bucket(head)=" + ba + " bucket(self)=" + bb + "\n"
          fails = fails + 1
        end
      end
      bi = bi + 1
    end
    ai = ai + 1
  end
  report = report + "HEAD_CROSS_PRODUCT fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# struct-literal completeness (E0203): a supplied field is checked; an
# omitted field WITH a declaration default is legal (the default is
# declared-typed at registration and materialized by lowering); an
# omitted field with NO declaration default is a checker error; an
# unknown field is rejected; a wrong-typed default fails at the
# DECLARATION even when no literal ever omits it.
# ———————————————————————————————————————————————————————————————
def infer_probe_default_field_battery(inout report: String) -> Int
  var fails = 0
  let ok_src = "struct Holder\n  value: Int\n  tag: String = \"none\"\n  items: Vec[Int] = Vec::new()\nend\n\ndef main() -> Int\n  let h = Holder { value: 3 }\n  0\nend\n"
  let (ok_n, _ok_f, _ok_i) = infer_probe_private_run(ok_src, false)
  if ok_n != 0 then
    report = report + "DEFAULT_FIELD_BATTERY: omitting a DEFAULTED field was not accepted (errors=" + ok_n.to_string() + ")\n"
    fails = fails + 1
  end
  let missing_src = "struct Strict\n  value: Int\n  other: Int\nend\n\ndef main() -> Int\n  let s = Strict { value: 3 }\n  0\nend\n"
  let (missing_n, _missing_f, _missing_i) = infer_probe_private_run(missing_src, false)
  if missing_n == 0 || !infer_probe_has_error(missing_src, "missing required field") then
    report = report + "DEFAULT_FIELD_BATTERY: omitting a REQUIRED field was not rejected with E0203\n"
    fails = fails + 1
  end
  let bad_default_src = "struct Bad\n  x: Int = \"abc\"\nend\n\ndef main() -> Int\n  0\nend\n"
  let (bad_n, _bad_f, _bad_i) = infer_probe_private_run(bad_default_src, false)
  if bad_n == 0 then
    report = report + "DEFAULT_FIELD_BATTERY: a WRONG-TYPED default was accepted at the declaration\n"
    fails = fails + 1
  end
  let unknown_src = "struct Strict2\n  value: Int\nend\n\ndef main() -> Int\n  let s = Strict2 { value: 3, nope: 4 }\n  0\nend\n"
  if !infer_probe_has_error(unknown_src, "unknown field") then
    report = report + "DEFAULT_FIELD_BATTERY: an UNKNOWN field was accepted\n"
    fails = fails + 1
  end
  report = report + "DEFAULT_FIELD_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# (semantic field defaults): the declaration-bound default battery.
#
# Shape (the seed's tg_struct_literals F/G program): `const X: Int = 1`,
# `struct Inner v: Int = 2`, `struct Outer n: Int = Inner {}.v + X`, and a
# `main` that declares a LOCAL `X: Int = 99` before constructing `Outer {}`.
# The default's `X` must resolve to the DECLARED const, never the use-site
# local (the pre-fix capture evaluated the field to 101 instead of 3).
#
# Two witnesses, both required:
#   1. the checker's typed_global_bindings record for the default's X node
#      is the GbConst identity — exactly one global binding in the program,
#      and it is a const (a local capture records no global binding);
#   2. the lowered `main` contains a MirStaticRef to that exact DefId — the
#      MIR consumption is identity-keyed; with the consumption removed the
#      use-site local wins and no static ref to the const appears.
# The battery fails if EITHER the recording or the consumption is removed.
# ———————————————————————————————————————————————————————————————
def infer_probe_operand_has_static_ref(op: MirOperand, did_num: Int) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirStaticRef(did) then def_id_numeric(&did) == did_num
    when MirConstantKind::MirStaticAddr(did) then def_id_numeric(&did) == did_num
    when _ then false
    end
  when _ then false
  end
end

def infer_probe_rvalue_has_static_ref(rv: MirRvalue, did_num: Int) -> Bool
  match rv.kind
  when MirRvalueKind::MirMove(op) then infer_probe_operand_has_static_ref(op, did_num)
  when MirRvalueKind::MirBinOp(_, l, r) then infer_probe_operand_has_static_ref(l, did_num) || infer_probe_operand_has_static_ref(r, did_num)
  when MirRvalueKind::MirUnOp(_, o) then infer_probe_operand_has_static_ref(o, did_num)
  when MirRvalueKind::MirAggregate(_, ops) then
    var ag_found = false
    for o in ops do
      if infer_probe_operand_has_static_ref(o, did_num) then ag_found = true end
    end
    ag_found
  when MirRvalueKind::MirCast(_, o2, _) then infer_probe_operand_has_static_ref(o2, did_num)
  when MirRvalueKind::MirRepeat(a, b) then infer_probe_operand_has_static_ref(a, did_num) || infer_probe_operand_has_static_ref(b, did_num)
  when _ then false
  end
end

# Scan one lowered function's statements for a MirStaticRef to `did_num`.
# Only the operand-bearing statement forms are walked (the assignment
# rvalue recursively); the default's read is stored through a MirAssign
# whose rvalue is the binary operation carrying the static-ref operand.
def infer_probe_mir_has_static_ref(mir: MirProgram, fn_name: String, did_num: Int) -> Bool
  var found = false
  var fi = 0
  while fi < mir.functions.len() do
    let f = mir.functions[fi]
    if f.name == fn_name || f.name.ends_with("::" + fn_name) then
      var bi = 0
      while bi < f.blocks.len() do
        var si = 0
        while si < f.blocks[bi].statements.len() do
          let st = f.blocks[bi].statements[si]
          match st.kind
          when MirStatementKind::MirAssign(_, rv) then
            if infer_probe_rvalue_has_static_ref(rv, did_num) then found = true end
          when MirStatementKind::MirContractCheck(_, op) then
            if infer_probe_operand_has_static_ref(op, did_num) then found = true end
          when MirStatementKind::MirEffectRecord(_, op) then
            if infer_probe_operand_has_static_ref(op, did_num) then found = true end
          when MirStatementKind::MirEffectPerform(_, _, _, a, bop) then
            if infer_probe_operand_has_static_ref(a, did_num) || infer_probe_operand_has_static_ref(bop, did_num) then found = true end
          when MirStatementKind::MirEffectFrameEnter(_, _, _, _, op) then
            if infer_probe_operand_has_static_ref(op, did_num) then found = true end
          when _ then ()
          end
          si = si + 1
        end
        bi = bi + 1
      end
    end
    fi = fi + 1
  end
  found
end

def infer_probe_semantic_default_battery(inout report: String) -> Int
  var fails = 0
  let source = "const X: Int = 1\n\nstruct Inner\n  v: Int = 2\nend\n\nstruct Outer\n  n: Int = Inner {}.v + X\nend\n\ndef main() -> Int\n  let X: Int = 99\n  let o = Outer {}\n  o.n\nend\n"
  let parsed = parse(tokenize(source.clone(), "semantic_default"))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "SEMANTIC_DEFAULT_BATTERY: parse failed\n"
    return 1
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    report = report + "SEMANTIC_DEFAULT_BATTERY: resolve failed=" + errs.len().to_string() + "\n"
    fails = fails + 1
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() != 0 then
      report = report + "SEMANTIC_DEFAULT_BATTERY: typecheck errors=" + result.errors.len().to_string() + "\n"
      var ei = 0
      while ei < result.errors.len() && ei < 4 do
        report = report + "    TE " + result.errors[ei].message.clone() + "\n"
        ei = ei + 1
      end
      fails = fails + 1
    end
    var const_bindings = 0
    var other_bindings = 0
    var x_did_num = -1
    let entries = env.typed_global_bindings.entries()
    var bi = 0
    while bi < entries.len() do
      match entries[bi].1
      when GlobalBinding::GbConst(did) then
        const_bindings = const_bindings + 1
        x_did_num = def_id_numeric(&did)
      when _ then other_bindings = other_bindings + 1
      end
      bi = bi + 1
    end
    if const_bindings != 1 || other_bindings != 0 then
      report = report + "SEMANTIC_DEFAULT_BATTERY: expected exactly one global binding (the default's X -> the const identity), got const=" + const_bindings.to_string() + " other=" + other_bindings.to_string() + "\n"
      fails = fails + 1
    end
    if x_did_num < 0 then
      report = report + "SEMANTIC_DEFAULT_BATTERY: no recorded GbConst identity to verify in the lowered MIR\n"
    else
      let opts = default_options()
      var lower_prog = program
      # a FRESH env: analyze_parsed typechecks internally, and the checker
      # env is not re-entrant over an already-checked program (type
      # registration is append-only).
      var lower_env = type_env_new()
      lower_env.strict_resolution = true
      match analyze_parsed(&mut lower_env, &mut lower_prog, opts)
      when Result::Ok(analyzed) then
        # the lowering run's OWN recorded binding is the identity lr_ident
        # consumes (the two runs are separate checks of the same source).
        var lower_did_num = -1
        var lower_consts = 0
        let lower_entries = analyzed.typed.global_bindings.entries()
        var lei = 0
        while lei < lower_entries.len() do
          match lower_entries[lei].1
          when GlobalBinding::GbConst(did) then
            lower_consts = lower_consts + 1
            lower_did_num = def_id_numeric(&did)
          when _ then ()
          end
          lei = lei + 1
        end
        if lower_consts != 1 then
          report = report + "SEMANTIC_DEFAULT_BATTERY: the lowering run recorded " + lower_consts.to_string() + " const global binding(s), expected exactly 1\n"
          fails = fails + 1
        end
        match lower_to_mir(&lower_prog, &analyzed)
        when Result::Ok(mir) then
          if !infer_probe_mir_has_static_ref(mir, "main", lower_did_num) then
            report = report + "SEMANTIC_DEFAULT_BATTERY: the lowered main has no static reference to the default's const identity (first-run def " + x_did_num.to_string() + ", lowering-run def " + lower_did_num.to_string() + ") — the declaration-bound default was captured by the use-site local\n"
            fails = fails + 1
          end
        when Result::Err(e) then
          report = report + "SEMANTIC_DEFAULT_BATTERY: lower failed: " + e.clone() + "\n"
          fails = fails + 1
        end
      when Result::Err(diags) then
        report = report + "SEMANTIC_DEFAULT_BATTERY: analyze failed=" + diags.len().to_string() + "\n"
        fails = fails + 1
      end
    end
  end
  report = report + "SEMANTIC_DEFAULT_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# The self-host channel probe: run one shape and return the CHANNEL
# counters, not merely the diagnostic count — (errors, expr_error_nodes,
# expr_var_nodes, bad_call_instance_args, readiness_ok, first_gate_detail).
# The readiness leg is the kernel's own verify_typed_channel_completeness
# (the same verifier whose HIR_INVALID rows the closure preflight prints).
# ———————————————————————————————————————————————————————————————
def infer_probe_type_has_error_state(ty: Type) -> Bool
  match ty
  when Type::Error then true
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if infer_probe_type_has_error_state(a) then found = true end
    end
    found
  when Type::Ptr(inner) then infer_probe_type_has_error_state(inner)
  when Type::PtrMut(inner) then infer_probe_type_has_error_state(inner)
  when Type::RefInternal(inner, _) then infer_probe_type_has_error_state(inner)
  when Type::Tuple(fs) then
    var found2 = false
    for f in fs do
      if infer_probe_type_has_error_state(f) then found2 = true end
    end
    found2
  when Type::FixedArray(elem, _) then infer_probe_type_has_error_state(elem)
  when Type::FixedArraySym(elem, _) then infer_probe_type_has_error_state(elem)
  when Type::FnPtr(ps, ret, _) then
    var found3 = infer_probe_type_has_error_state(ret)
    for p in ps do
      if infer_probe_type_has_error_state(p.ty.clone()) then found3 = true end
    end
    found3
  when Type::Closure(_, ps, ret, _, _) then
    var found4 = infer_probe_type_has_error_state(ret)
    for p in ps do
      if infer_probe_type_has_error_state(p.ty.clone()) then found4 = true end
    end
    found4
  when Type::Effect(_, inner) then infer_probe_type_has_error_state(inner)
  when _ then false
  end
end

def infer_probe_channel_probe(source: String) -> (Int, Int, Int, Int, Bool, String)
  let parsed = parse(tokenize(source, "selfhostchannels"))
  if diag_has_errors(&parsed.diagnostics) then
    let pd = parsed.diagnostics[0]
    var pd_where = ""
    match pd.span
    when Option::Some(sp) then pd_where = "@" + sp.start.to_string() + ":" + sp.end_pos.to_string()
    when Option::None then ()
    end
    return (1, -1, -1, -1, false, "parse failed: " + pd.message.clone() + pd_where)
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var expr_err = 0
    var expr_var = 0
    for (_nid, ty) in env.typed_expr_types.entries() do
      if infer_probe_type_has_error_state(ty.clone()) then expr_err = expr_err + 1 end
      if infer_probe_has_var(ty.clone()) then expr_var = expr_var + 1 end
    end
    var inst_bad = 0
    for (_nid2, args) in env.typed_call_instances.entries() do
      for a in args do
        match a
        when GenericArg::Type(aty) then
          if infer_probe_type_has_error_state(aty.clone()) || infer_probe_has_var(aty.clone()) then
            inst_bad = inst_bad + 1
          end
        when GenericArg::Const(_) then ()
        end
      end
    end
    let errs_before = env.errors.len()
    let readiness_ok = verify_typed_channel_completeness(&mut env, &program)
    var detail = ""
    if !readiness_ok && env.errors.len() > errs_before then
      detail = env.errors[env.errors.len() - 1].message.clone()
    end
    (result.errors.len(), expr_err, expr_var, inst_bad, readiness_ok, detail)
  when Result::Err(errs) then
    (errs.len() + 1000, -1, -1, -1, false, "resolve failed")
  end
end

# (batch 5 — the closure-divergence battery): the program-based channel
# probe. Same four counters + readiness as infer_probe_channel_probe, but
# over a pre-built Program (the multi-module crate scaffolding the
# module-qualified free-call family needs); the source-based probe
# delegates here.
def infer_probe_channel_probe_program(program0: Program) -> (Int, Int, Int, Int, Bool, String)
  var program = program0
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var expr_err = 0
    var expr_var = 0
    for (_nid, ty) in env.typed_expr_types.entries() do
      if infer_probe_type_has_error_state(ty.clone()) then expr_err = expr_err + 1 end
      if infer_probe_has_var(ty.clone()) then expr_var = expr_var + 1 end
    end
    var inst_bad = 0
    for (_nid2, args) in env.typed_call_instances.entries() do
      for a in args do
        match a
        when GenericArg::Type(aty) then
          if infer_probe_type_has_error_state(aty.clone()) || infer_probe_has_var(aty.clone()) then
            inst_bad = inst_bad + 1
          end
        when GenericArg::Const(_) then ()
        end
      end
    end
    let errs_before = env.errors.len()
    let readiness_ok = verify_typed_channel_completeness(&mut env, &program)
    var detail = ""
    if !readiness_ok && env.errors.len() > errs_before then
      detail = env.errors[env.errors.len() - 1].message.clone()
    end
    (result.errors.len(), expr_err, expr_var, inst_bad, readiness_ok, detail)
  when Result::Err(errs) then
    (errs.len() + 1000, -1, -1, -1, false, "resolve failed")
  end
end

# The first checker diagnostic of a single-program probe source (the
# battery's BEFORE/AFTER detail row) — the same pipeline as
# infer_probe_channel_probe, reduced to the first message.
def infer_probe_channel_first_error(source: String) -> String
  let parsed = parse(tokenize(source, "selfhostchannels"))
  if diag_has_errors(&parsed.diagnostics) then
    if parsed.diagnostics.len() > 0 then
      return "parse: " + parsed.diagnostics[0].message.clone()
    end
    return "parse"
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    if errs.len() > 0 then "resolve: " + errs[0].message.clone() else "resolve" end
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() > 0 then result.errors[0].message.clone() else "-" end
  end
end

def infer_probe_channel_first_error_program(program0: Program) -> String
  var program = program0
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    if errs.len() > 0 then "resolve: " + errs[0].message.clone() else "resolve" end
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() > 0 then result.errors[0].message.clone() else "-" end
  end
end

# ———————————————————————————————————————————————————————————————
# pending_call_instances / finalize channel: a generic constructor whose
# argument is solvable ONLY from the caller's context — the annotation,
# the dest, or a later method use — must be SOLVED before readiness,
# never left as Type::Var or poisoned into Type::Error.
# ———————————————————————————————————————————————————————————————
def infer_probe_pending_inference_battery(inout report: String) -> Int
  var fails = 0
  let case_a = "def a() -> Int\n  var xs: Vec[Int] = Vec::new()\n  0\nend\n"
  let (a_n, _af, _ai) = infer_probe_private_run(case_a, false)
  if a_n != 0 then
    report = report + "PENDING_INFERENCE_BATTERY A: annotation-only Vec inference failed (errors=" + a_n.to_string() + ")\n"
    fails = fails + 1
  end
  let case_b = "def b() -> Int\n  var xs = Vec::new()\n  xs.push(1)\n  0\nend\n"
  let (b_n, _bf, _bi) = infer_probe_private_run(case_b, false)
  if b_n != 0 then
    report = report + "PENDING_INFERENCE_BATTERY B: later-method-use Vec inference failed (errors=" + b_n.to_string() + ")\n"
    fails = fails + 1
  end
  let case_c = "def c() -> Vec[Int]\n  Vec::new()\nend\n"
  let (c_n, _cf, _ci) = infer_probe_private_run(case_c, false)
  if c_n != 0 then
    report = report + "PENDING_INFERENCE_BATTERY C: return-type Vec inference failed (errors=" + c_n.to_string() + ")\n"
    fails = fails + 1
  end
  let case_d = "def d() -> Int\n  var m: Map[String, Int] = Map::new()\n  0\nend\n"
  let (d_n, _df, _di) = infer_probe_private_run(case_d, false)
  if d_n != 0 then
    report = report + "PENDING_INFERENCE_BATTERY D: Map constructor inference failed (errors=" + d_n.to_string() + ")\n"
    fails = fails + 1
  end
  let case_e = "def e() -> Int\n  var v: Vec[Vec[Int]] = Vec::new()\n  var inner: Vec[Int] = Vec::new()\n  inner.push(1)\n  v.push(inner)\n  0\nend\n"
  let (e_n, _ef, _ei) = infer_probe_private_run(case_e, false)
  if e_n != 0 then
    report = report + "PENDING_INFERENCE_BATTERY E: nested generic constructor inference failed (errors=" + e_n.to_string() + ")\n"
    fails = fails + 1
  end
  # (self-host channel legs): the closure preflight's exact failing forms —
  # annotate every channel so a Type::Error/Type::Var in a solved generic-call
  # substitution (or a readiness HIR_INVALID row) fails the battery even when
  # the diagnostic COUNT alone would pass.
  # F: the annotated `Vec[String] = Vec::new()` + push + len baseline (the
  #    seed accepts; the kernel must keep it accepted with concrete channels).
  let case_f = "def build() -> Int\n  var keys: Vec[String] = Vec::new()\n  keys.push(\"a\".to_string())\n  keys.len()\nend\n\ndef main() -> Int\n  build()\nend\n"
  let (f_n, f_e, f_v, f_i, f_ok, f_d) = infer_probe_channel_probe(case_f)
  if f_n != 0 || f_e != 0 || f_v != 0 || f_i != 0 || !f_ok then
    report = report + "PENDING_INFERENCE_BATTERY F: annotated Vec[String] channels not concrete (errors=" + f_n.to_string() + " expr_error=" + f_e.to_string() + " expr_var=" + f_v.to_string() + " inst_bad=" + f_i.to_string() + " readiness=" + f_ok.to_string() + " detail=" + f_d.clone() + ")\n"
    fails = fails + 1
  end
  # G: the resolver.tg:1854 shape — unannotated `var keys = Vec::new()` filled
  #    from a Copy-gated Map.entries() for-loop over non-Copy K/V (String
  #    keys): the seed's name-keyed resolution accepts; the kernel must not
  #    reject the entries candidate and poison the Vec element with Error.
  #    The inline Hash/Eq impls mirror std/core's so the first unsatisfied
  #    bound is exactly `K: Copy` (the closure's diagnostic).
  let case_g = "struct Mods\n  name: String\nend\n\nimpl Eq for String\n  def eq(self: Self, other: Self) -> Bool\n    self == other\n  end\nend\n\nimpl Hash for String\n  def hash(self: Self) -> Int\n    0\n  end\nend\n\nimpl[K: Hash + Eq + Copy, V: Copy] Map[K, V]\n  def entries(self: Self) -> Vec[(K, V)]\n    Vec::new()\n  end\nend\n\ndef collect(inout tables: Map[String, Mods]) -> Int\n  var keys = Vec::new()\n  for (k, m) in tables.entries() do\n    keys.push(k.clone())\n    let _ = m\n  end\n  var ki = 0\n  while ki < keys.len() do\n    ki = ki + 1\n  end\n  ki\nend\n\ndef main() -> Int\n  var t: Map[String, Mods] = Map::new()\n  collect(&t)\nend\n"
  let (g_n, g_e, g_v, g_i, g_ok, g_d) = infer_probe_channel_probe(case_g)
  if g_n != 0 || g_e != 0 || g_v != 0 || g_i != 0 || !g_ok then
    report = report + "PENDING_INFERENCE_BATTERY G: Map[String,..].entries() loop channels not concrete (errors=" + g_n.to_string() + " expr_error=" + g_e.to_string() + " expr_var=" + g_v.to_string() + " inst_bad=" + g_i.to_string() + " readiness=" + g_ok.to_string() + " detail=" + g_d.clone() + ")\n"
    fails = fails + 1
  end
  # H: std/time.tg's Timespec::lt shape — bare-qualified method declarations
  #    (`def Type::method`) with a method call compared against `0`. The
  #    seed registers these as methods (Ast.Function's "::" arm); the kernel
  #    must resolve them or the `<` operand records Type::Error.
  let case_h = "struct TS\n  a: Int\nend\n\ndef TS::compare(self: TS, other: TS) -> Int\n  self.a - other.a\nend\n\ndef TS::lt(self: TS, other: TS) -> Bool\n  self.compare(other) < 0\nend\n\ndef main() -> Int\n  let x = TS { a: 1 }\n  let y = TS { a: 2 }\n  if x.lt(y) then 1 else 0 end\nend\n"
  let (h_n, h_e, h_v, h_i, h_ok, h_d) = infer_probe_channel_probe(case_h)
  if h_n != 0 || h_e != 0 || h_v != 0 || h_i != 0 || !h_ok then
    report = report + "PENDING_INFERENCE_BATTERY H: bare-qualified method channels not concrete (errors=" + h_n.to_string() + " expr_error=" + h_e.to_string() + " expr_var=" + h_v.to_string() + " inst_bad=" + h_i.to_string() + " readiness=" + h_ok.to_string() + " detail=" + h_d.clone() + ")\n"
    fails = fails + 1
  end
  # H2: the Duration shape — a typealias owner with its own bare method and a
  #     same-named-free static call (`Dur::from_n`) alongside a receiver-style
  #     call on the alias (`d.total()`), both routed through the folded
  #     nominal identity.
  let case_h2 = "struct TS\n  a: Int\nend\n\ntypealias Dur = TS\n\ndef TS::total(self: TS) -> Int\n  self.a\nend\n\ndef Dur::from_n(n: Int) -> Dur\n  TS { a: n }\nend\n\ndef Dur::double(self: Dur) -> Dur\n  TS { a: self.a * 2 }\nend\n\ndef main() -> Int\n  let d = Dur::from_n(3)\n  let e = d.double()\n  d.total() + e.total()\nend\n"
  let (h2_n, h2_e, h2_v, h2_i, h2_ok, h2_d) = infer_probe_channel_probe(case_h2)
  if h2_n != 0 || h2_e != 0 || h2_v != 0 || h2_i != 0 || !h2_ok then
    report = report + "PENDING_INFERENCE_BATTERY H2: alias-owner bare-method channels not concrete (errors=" + h2_n.to_string() + " expr_error=" + h2_e.to_string() + " expr_var=" + h2_v.to_string() + " inst_bad=" + h2_i.to_string() + " readiness=" + h2_ok.to_string() + " detail=" + h2_d.clone() + ")\n"
    fails = fails + 1
  end
  # H3: the std/time.tg static self-less surface — `Type::zero()` /
  #     `Type::from_n(...)` declarations without a self receiver
  #     (Timespec::zero / Instant::now / SystemTime::now shapes), plus a
  #     receiver-style call on the same type.
  let case_h3 = "struct Clock\n  base: Int\nend\n\ndef Clock::zero() -> Clock\n  Clock { base: 0 }\nend\n\ndef Clock::from_n(n: Int) -> Clock\n  Clock { base: n }\nend\n\ndef Clock::base_of(self: Clock) -> Int\n  self.base\nend\n\ndef main() -> Int\n  let c = Clock::from_n(4)\n  let z = Clock::zero()\n  c.base_of() + z.base_of()\nend\n"
  let (h3_n, h3_e, h3_v, h3_i, h3_ok, h3_d) = infer_probe_channel_probe(case_h3)
  if h3_n != 0 || h3_e != 0 || h3_v != 0 || h3_i != 0 || !h3_ok then
    report = report + "PENDING_INFERENCE_BATTERY H3: static bare-method channels not concrete (errors=" + h3_n.to_string() + " expr_error=" + h3_e.to_string() + " expr_var=" + h3_v.to_string() + " inst_bad=" + h3_i.to_string() + " readiness=" + h3_ok.to_string() + " detail=" + h3_d.clone() + ")\n"
    fails = fails + 1
  end
  # I: std/ast.tg's assign_pattern_ids shape — `(String, Nominal).clone()`
  #    where the nominal (like Pattern) has a REGISTERED clone impl while the
  #    structural derived-clone walk fails (here through the non-langitem
  #    opaque `Any` payload). The seed discharges registered clones first.
  let case_i = "struct Inner\n  kind: Int\nend\n\nenum Holder\n  A(Inner, Any)\n  B\nend\n\nimpl Clone for Holder\n  def clone(self: Self) -> Holder\n    Holder::B\n  end\nend\n\ndef f() -> Int\n  let p = (\"a\".to_string(), Holder::B)\n  let q = p.clone()\n  match q.1\n  when Holder::A(_i, _x) then 1\n  when Holder::B then 0\n  end\nend\n\ndef main() -> Int\n  f()\nend\n"
  let (i_n, i_e, i_v, i_i, i_ok, i_d) = infer_probe_channel_probe(case_i)
  if i_n != 0 || i_e != 0 || i_v != 0 || i_i != 0 || !i_ok then
    report = report + "PENDING_INFERENCE_BATTERY I: tuple clone over registered-clone nominal channels not concrete (errors=" + i_n.to_string() + " expr_error=" + i_e.to_string() + " expr_var=" + i_v.to_string() + " inst_bad=" + i_i.to_string() + " readiness=" + i_ok.to_string() + " detail=" + i_d.clone() + ")\n"
    fails = fails + 1
  end
  # J: the nested generic push — an unannotated `Vec::new()` fed a whole
  #    `Vec[String]` value (the task's shape d).
  let case_j = "def f(other: Vec[String]) -> Vec[String]\n  var xs = Vec::new()\n  xs.push(other)\n  xs\nend\n\ndef main() -> Int\n  var v: Vec[String] = Vec::new()\n  let r = f(v)\n  r.len()\nend\n"
  let (j_n, j_e, j_v, j_i, j_ok, j_d) = infer_probe_channel_probe(case_j)
  if j_n != 0 || j_e != 0 || j_v != 0 || j_i != 0 || !j_ok then
    report = report + "PENDING_INFERENCE_BATTERY J: nested generic push channels not concrete (errors=" + j_n.to_string() + " expr_error=" + j_e.to_string() + " expr_var=" + j_v.to_string() + " inst_bad=" + j_i.to_string() + " readiness=" + j_ok.to_string() + " detail=" + j_d.clone() + ")\n"
    fails = fails + 1
  end
  # K: the linker.tg/resolver.tg Copy-gated span ops — `Vec[String].slice`
  #    and `Vec[String].extend` on a NON-Copy element, where the std impl's
  #    `impl[T: Copy] Array[T]` bounds block the candidate but the seed
  #    selects by name. The builtin surface must answer (ArraySlice /
  #    ArrayExtend are already the intrinsic classifications).
  let case_k = "def cp(v: Vec[String], more: Vec[String]) -> Int\n  v.extend(more)\n  let s = v.slice(0, v.len())\n  s.len()\nend\n\ndef main() -> Int\n  var a: Vec[String] = Vec::new()\n  var b: Vec[String] = Vec::new()\n  cp(a, b)\nend\n"
  let (k_n, k_e, k_v, k_i, k_ok, k_d) = infer_probe_channel_probe(case_k)
  if k_n != 0 || k_e != 0 || k_v != 0 || k_i != 0 || !k_ok then
    report = report + "PENDING_INFERENCE_BATTERY K: Vec[String] slice/extend channels not concrete (errors=" + k_n.to_string() + " expr_error=" + k_e.to_string() + " expr_var=" + k_v.to_string() + " inst_bad=" + k_i.to_string() + " readiness=" + k_ok.to_string() + " detail=" + k_d.clone() + ")\n"
    fails = fails + 1
  end
  # L: std/bench.tg's measure_single, first half — the std::time BUILTIN
  #    module symbols (`use std::time::{instant_now, duration_nanos}`).
  #    These have no source definition: the seed types them from its
  #    builtin signature table (instant_now -> the Instant nominal;
  #    duration_nanos[T] -> UInt). A kernel ident that falls through to
  #    `unknown symbol` records Type::Error, so instant_now's call result
  #    never types and readiness fails with the HIR_INVALID|ident shape.
  let case_l = "use std::time::{instant_now, duration_nanos}\n\nstruct Instant\n  ts: Int\nend\n\ndef take() -> UInt\n  let start = instant_now()\n  let elapsed = duration_nanos(start)\n  elapsed\nend\n"
  let (l_n, l_e, l_v, l_i, l_ok, l_d) = infer_probe_channel_probe(case_l)
  if l_n != 0 || l_e != 0 || l_v != 0 || l_i != 0 || !l_ok then
    report = report + "PENDING_INFERENCE_BATTERY L: std::time builtin module symbol channels not concrete (errors=" + l_n.to_string() + " expr_error=" + l_e.to_string() + " expr_var=" + l_v.to_string() + " inst_bad=" + l_i.to_string() + " readiness=" + l_ok.to_string() + " detail=" + l_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "PENDING_INFERENCE_BATTERY L PASS errors=" + l_n.to_string() + " expr_error=" + l_e.to_string() + " expr_var=" + l_v.to_string() + " inst_bad=" + l_i.to_string() + " readiness=" + l_ok.to_string() + "\n"
  end
  # M: the FULL measure_single mirror — the source-declared Instant struct
  #    (whose methods resolve on the builtin's result), the `def() -> Unit`
  #    parameter call, the method call on a call result, and the generic
  #    builtin duration_nanos.
  let case_m = "use std::time::{instant_now, duration_nanos}\n\nstruct Instant\n  ts: Int\nend\n\nimpl Instant\n  def elapsed(self: Instant) -> Int\n    self.ts\n  end\nend\n\ndef noop() -> Unit\n  ()\nend\n\ndef measure_mirror(func: def() -> Unit) -> UInt\n  let start = instant_now()\n  func()\n  let elapsed = start.elapsed()\n  duration_nanos(elapsed)\nend\n"
  let (m_n, m_e, m_v, m_i, m_ok, m_d) = infer_probe_channel_probe(case_m)
  if m_n != 0 || m_e != 0 || m_v != 0 || m_i != 0 || !m_ok then
    report = report + "PENDING_INFERENCE_BATTERY M: measure_single builtin mirror channels not concrete (errors=" + m_n.to_string() + " expr_error=" + m_e.to_string() + " expr_var=" + m_v.to_string() + " inst_bad=" + m_i.to_string() + " readiness=" + m_ok.to_string() + " detail=" + m_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "PENDING_INFERENCE_BATTERY M PASS errors=" + m_n.to_string() + " expr_error=" + m_e.to_string() + " expr_var=" + m_v.to_string() + " inst_bad=" + m_i.to_string() + " readiness=" + m_ok.to_string() + "\n"
  end
  # N: the same shape with LOCAL helpers in place of the builtins — isolates
  #    the `def() -> Unit` parameter call, the method call on a call result
  #    and the ident read of a call result from the builtin-symbol path.
  let case_n = "struct TS\n  v: Int\nend\n\nimpl TS\n  def elapsed(self: TS) -> Int\n    self.v\n  end\nend\n\ndef make_ts() -> TS\n  TS { v: 1 }\nend\n\ndef duration_nanos_local(x: Int) -> UInt\n  x as UInt\nend\n\ndef noop() -> Unit\n  ()\nend\n\ndef measure_local(func: def() -> Unit) -> UInt\n  let start = make_ts()\n  func()\n  let elapsed = start.elapsed()\n  duration_nanos_local(elapsed)\nend\n"
  let (n_n, n_e, n_v, n_i, n_ok, n_d) = infer_probe_channel_probe(case_n)
  if n_n != 0 || n_e != 0 || n_v != 0 || n_i != 0 || !n_ok then
    report = report + "PENDING_INFERENCE_BATTERY N: measure_single local-helper mirror channels not concrete (errors=" + n_n.to_string() + " expr_error=" + n_e.to_string() + " expr_var=" + n_v.to_string() + " inst_bad=" + n_i.to_string() + " readiness=" + n_ok.to_string() + " detail=" + n_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "PENDING_INFERENCE_BATTERY N PASS errors=" + n_n.to_string() + " expr_error=" + n_e.to_string() + " expr_var=" + n_v.to_string() + " inst_bad=" + n_i.to_string() + " readiness=" + n_ok.to_string() + "\n"
  end
  # O: a call through a `def() -> Unit` PARAMETER alone (the minimal
  #    function-valued-ident path).
  let case_o = "def noop() -> Unit\n  ()\nend\n\ndef call_it(f: def() -> Unit) -> Unit\n  f()\nend\n"
  let (o_n, o_e, o_v, o_i, o_ok, o_d) = infer_probe_channel_probe(case_o)
  if o_n != 0 || o_e != 0 || o_v != 0 || o_i != 0 || !o_ok then
    report = report + "PENDING_INFERENCE_BATTERY O: def()-parameter call channels not concrete (errors=" + o_n.to_string() + " expr_error=" + o_e.to_string() + " expr_var=" + o_v.to_string() + " inst_bad=" + o_i.to_string() + " readiness=" + o_ok.to_string() + " detail=" + o_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "PENDING_INFERENCE_BATTERY O PASS errors=" + o_n.to_string() + " expr_error=" + o_e.to_string() + " expr_var=" + o_v.to_string() + " inst_bad=" + o_i.to_string() + " readiness=" + o_ok.to_string() + "\n"
  end
  # P: passing a declared function as the VALUE of a `def() -> Unit`
  #    parameter (the fn-item -> FnPtr unification at the call argument).
  let case_p = "def noop() -> Unit\n  ()\nend\n\ndef call_it(f: def() -> Unit) -> Unit\n  f()\nend\n\ndef use_it() -> Unit\n  call_it(noop)\nend\n"
  let (p_n, p_e, p_v, p_i, p_ok, p_d) = infer_probe_channel_probe(case_p)
  if p_n != 0 || p_e != 0 || p_v != 0 || p_i != 0 || !p_ok then
    report = report + "PENDING_INFERENCE_BATTERY P: fn-item value into def() parameter channels not concrete (errors=" + p_n.to_string() + " expr_error=" + p_e.to_string() + " expr_var=" + p_v.to_string() + " inst_bad=" + p_i.to_string() + " readiness=" + p_ok.to_string() + " detail=" + p_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "PENDING_INFERENCE_BATTERY P PASS errors=" + p_n.to_string() + " expr_error=" + p_e.to_string() + " expr_var=" + p_v.to_string() + " inst_bad=" + p_i.to_string() + " readiness=" + p_ok.to_string() + "\n"
  end
  report = report + "PENDING_INFERENCE_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# Option/Result `expect(msg)` surface (the resolver module_table_for
# fingerprint class): the seed's builtin method table answers
# Option::expect / Result::expect (success payload extraction), but the
# kernel's Adt surface omitted them, so
# `map.get(&key).expect("...")` recorded `no method expect` + Type::Error
# and the typed-channel gate fired
# `HIR_INVALID|tg_compiler::resolver|module_table_for|Node=81940`.
# The battery asserts the channel contract directly (errors=0,
# Error/Var-free typed_expr_types + typed_call_instances, completeness
# true) AND that the call is classified as the Unwrap intrinsic so the
# MIR/verifier/codegen route is pinned, not just the checker surface.
# ———————————————————————————————————————————————————————————————
def infer_probe_expect_intrinsic_count(source: String) -> Int
  let parsed = parse(tokenize(source, "expectintr"))
  if diag_has_errors(&parsed.diagnostics) then
    return -1
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(_) then -1
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let _ = type_check_typed(&mut env, &program, &res)
    var n = 0
    for (_nid, iid) in env.typed_intrinsics.entries() do
      if intrinsic_id_numeric(&iid) == intrinsic_id_numeric(&IntrinsicId::Unwrap) then
        n = n + 1
      end
    end
    n
  end
end

def infer_probe_option_expect_battery(inout report: String) -> Int
  var fails = 0
  # X1: Option::expect on a declared-parameter receiver.
  let case_x1 = "def pick(o: Option[Int]) -> Int\n  o.expect(\"missing\")\nend\n\ndef main() -> Int\n  pick(Option::Some(1))\nend\n"
  let (x1_n, x1_e, x1_v, x1_i, x1_ok, x1_d) = infer_probe_channel_probe(case_x1)
  let x1_intr = infer_probe_expect_intrinsic_count(case_x1)
  if x1_n != 0 || x1_e != 0 || x1_v != 0 || x1_i != 0 || !x1_ok || x1_intr < 1 then
    report = report + "OPTION_EXPECT_BATTERY X1: Option::expect channels not concrete or not routed (errors=" + x1_n.to_string() + " expr_error=" + x1_e.to_string() + " expr_var=" + x1_v.to_string() + " inst_bad=" + x1_i.to_string() + " readiness=" + x1_ok.to_string() + " unwrap_intrinsics=" + x1_intr.to_string() + " detail=" + x1_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "OPTION_EXPECT_BATTERY X1 PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true unwrap_intrinsics=" + x1_intr.to_string() + "\n"
  end
  # X2: Result::expect shares the success-payload surface.
  let case_x2 = "def pick(r: Result[Int, String]) -> Int\n  r.expect(\"missing\")\nend\n\ndef main() -> Int\n  pick(Result::Ok(1))\nend\n"
  let (x2_n, x2_e, x2_v, x2_i, x2_ok, x2_d) = infer_probe_channel_probe(case_x2)
  if x2_n != 0 || x2_e != 0 || x2_v != 0 || x2_i != 0 || !x2_ok then
    report = report + "OPTION_EXPECT_BATTERY X2: Result::expect channels not concrete (errors=" + x2_n.to_string() + " expr_error=" + x2_e.to_string() + " expr_var=" + x2_v.to_string() + " inst_bad=" + x2_i.to_string() + " readiness=" + x2_ok.to_string() + " detail=" + x2_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "OPTION_EXPECT_BATTERY X2 PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
  end
  # X3: the exact resolver.tg:853 construct — `map.get(&key).expect(...)`
  #     (a Map[String, Int] receiver, an owned reference argument).
  let case_x3 = "def lookup(m: Map[String, Int], k: String) -> Int\n  m.get(&k).expect(\"per-module symbol table not found\")\nend\n\ndef main() -> Int\n  var m: Map[String, Int] = Map::new()\n  lookup(m, \"a\")\nend\n"
  let (x3_n, x3_e, x3_v, x3_i, x3_ok, x3_d) = infer_probe_channel_probe(case_x3)
  let x3_intr = infer_probe_expect_intrinsic_count(case_x3)
  if x3_n != 0 || x3_e != 0 || x3_v != 0 || x3_i != 0 || !x3_ok || x3_intr < 1 then
    report = report + "OPTION_EXPECT_BATTERY X3: Map.get().expect() channels not concrete or not routed (errors=" + x3_n.to_string() + " expr_error=" + x3_e.to_string() + " expr_var=" + x3_v.to_string() + " inst_bad=" + x3_i.to_string() + " readiness=" + x3_ok.to_string() + " unwrap_intrinsics=" + x3_intr.to_string() + " detail=" + x3_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "OPTION_EXPECT_BATTERY X3 PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true unwrap_intrinsics=" + x3_intr.to_string() + "\n"
  end
  report = report + "OPTION_EXPECT_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# KERNEL semantic defaults: the checker records a node-keyed resolution
# for the default's identifiers (typed_ident_resolutions, consumed by
# lr_ident BEFORE any use-site name lookup), so a declaration-bound
# default must resolve identically whether or not the constructor site
# has a shadowing local.  This battery pins that identity recording: a
# missing record fails, and a use-site-dependent resolution (the capture
# class) fails because the plain and shadowed programs would disagree.
# (The lowering-consumption half is the kernel's own `lr_ident` order —
# typed local id by NODE before lookup_current_local_id_by_name.)
# ———————————————————————————————————————————————————————————————
def infer_probe_default_x_node(program: Program) -> Int
  for item in program.items do
    match item.kind
    when ItemKind::ItemStruct(sd) then
      if sd.name == "Outer" then
        for f in sd.fields do
          if f.name == "n" then
            match f.default
            when Option::Some(e) then
              match e.kind
              when ExprKind::ExprBinaryOp(_op, _lhs, rhs) then
                match rhs.get().kind
                when ExprKind::ExprIdent(_) then
                  return rhs.get().node_id
                when _ then ()
                end
              when _ then ()
              end
            when Option::None then ()
            end
          end
        end
      end
    when _ then ()
    end
  end
  -1
end

def infer_probe_semantic_default_probe(source: String) -> (Bool, Int)
  let parsed = parse(tokenize(source, "defaultprobe"))
  if diag_has_errors(&parsed.diagnostics) then
    return (false, -1)
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  let node = infer_probe_default_x_node(&program)
  if node < 0 then
    return (false, -1)
  end
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let _result = type_check_typed(&mut env, &program, &res)
    match env.typed_ident_resolutions.get(node)
    when Option::Some(lid) then (true, lid)
    when Option::None then (false, -1)
    end
  when Result::Err(_errs) then
    (false, -1)
  end
end

def infer_probe_semantic_default_battery(inout report: String) -> Int
  var fails = 0
  let plain = "const X: Int = 1\n\nstruct Inner\n  v: Int = 2\nend\n\nstruct Outer\n  n: Int = Inner {}.v + X\nend\n\ndef main() -> Int\n  let o = Outer {}\n  o.n\nend\n"
  let shadowed = "const X: Int = 1\n\nstruct Inner\n  v: Int = 2\nend\n\nstruct Outer\n  n: Int = Inner {}.v + X\nend\n\ndef main() -> Int\n  let X: Int = 99\n  let o = Outer {}\n  o.n + X\nend\n"
  let (p_ok, p_id) = infer_probe_semantic_default_probe(plain)
  let (s_ok, s_id) = infer_probe_semantic_default_probe(shadowed)
  if !p_ok || !s_ok then
    report = report + "SEMANTIC_DEFAULT_BATTERY: the default's X node has no checker-recorded resolution (plain=" + p_ok.to_string() + " shadowed=" + s_ok.to_string() + ")\n"
    fails = fails + 1
  elsif p_id != s_id then
    report = report + "SEMANTIC_DEFAULT_BATTERY: the declaration-bound default resolved differently under a use-site local (plain=" + p_id.to_string() + " shadowed=" + s_id.to_string() + ")\n"
    fails = fails + 1
  end
  report = report + "SEMANTIC_DEFAULT_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# PARITY battery (the seed-vs-kernel semantic parity lane):
# stage0_ocaml/selfcheck/tg_semantic_parity.ml writes the case sources to
# build/parity_cases.txt (length-prefixed, one CASE record per program) and
# runs this probe inside the VM; the rows below are the KERNEL checker's
# verdicts on exactly those sources, compared against the seed's own
# check+lower+verify+VM verdict by the OCaml lane.
#
#   PARITY <label> verdict=accept|reject|parse-reject|resolve-reject
#          errors=N main_ret=<display|-> first=<normalized first message|->
#
# The battery ALSO runs the no-fallback mutation cases (deliverable 6):
# after a real analyze_parsed, one checker-recorded typed record is deleted
# for one node and the lowering MUST fail closed with an internal error
# naming that node — never a silent name-based fallback and never a wrong
# value. The rows are PARITY_MUTATION ..., and the battery's fails counter
# (asserted by tg_infer's PARITY_BATTERY fails=0) is nonzero if any
# mutation lowers successfully or the error does not name the node.
#
# When build/parity_cases.txt is absent (a standalone tg_infer run) the
# battery still runs the mutations and emits an explicit
# `PARITY_BATTERY no-cases ... cases=0` row — zero compared cases is
# reported as no-cases, NEVER as semantic agreement.
# ———————————————————————————————————————————————————————————————
def infer_probe_parity_parse_cases(source: String) -> Vec[(String, String)]
  var cases: Vec[(String, String)] = Vec::new()
  var pos = 0
  let n = source.len()
  while pos < n do
    var le = pos
    while le < n && source.slice(le, le + 1) != "\n" do
      le = le + 1
    end
    let line = source.slice(pos, le)
    pos = if le < n then le + 1 else le end
    if line.starts_with("CASE ") then
      var sp = -1
      var i = line.len() - 1
      while i >= 5 do
        if line.slice(i, i + 1) == " " then
          sp = i
          break
        end
        i = i - 1
      end
      if sp > 5 then
        let label = line.slice(5, sp)
        let lenstr = line.slice(sp + 1, line.len())
        match lenstr.parse_int()
        when Result::Ok(clen) then
          if clen >= 0 && pos + clen <= n then
            cases.push((label.clone(), source.slice(pos, pos + clen)))
            pos = pos + clen
            # one optional separator newline follows each payload
            if pos < n && source.slice(pos, pos + 1) == "\n" then
              pos = pos + 1
            end
          end
        when Result::Err(_) then ()
        end
      end
    end
  end
  cases
end

def infer_probe_parity_case(label: String, source: String, inout report: String) -> Unit
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "PARITY " + label.clone() + " verdict=parse-reject errors=" + parsed.diagnostics.len().to_string() + " main_ret=- first=parse\n"
    return ()
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    var rfirst = "-"
    if errs.len() > 0 then rfirst = infer_probe_norm_ids(errs[0].message.clone()) end
    report = report + "PARITY " + label.clone() + " verdict=resolve-reject errors=" + errs.len().to_string() + " main_ret=- first=" + rfirst.clone() + "\n"
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() == 0 then
      # main's resolved return type: typed_fn_signatures keys are
      # DefId-rendered (fn::<module>::<index>), so compute the key from
      # the resolver's item_defs entry for the main item — never a
      # name-based scan.
      var ret = "-"
      var main_idx = -1
      var mi = 0
      while mi < program.items.len() do
        match program.items[mi].kind
        when ItemKind::ItemFunction(f) then
          if f.name == "main" then main_idx = mi end
        when _ then ()
        end
        mi = mi + 1
      end
      if main_idx >= 0 then
        match res.item_defs.get(main_idx)
        when Option::Some(dids) then
          if dids.len() > 0 then
            let did0 = dids[0].clone()
            let mk = fn_owner_key_of_def(program, &res, &did0)
            match env.typed_fn_signatures.get(&mk)
            when Option::Some(sig) then ret = type_display(engine_env_empty(), sig.ret_type.clone())
            when Option::None then ()
            end
          end
        when Option::None then ()
        end
      end
      report = report + "PARITY " + label.clone() + " verdict=accept errors=0 main_ret=" + ret.clone() + " first=-\n"
    else
      report = report + "PARITY " + label.clone() + " verdict=reject errors=" + result.errors.len().to_string() + " main_ret=- first=" + infer_probe_norm_ids(result.errors[0].message.clone()) + "\n"
    end
  end
end

# The mutation witnesses: delete one checker-recorded typed record for one
# node after a REAL analyze_parsed and require lower_to_mir to fail closed
# with an internal error naming that node. A successful lowering (silent
# name fallback) or a non-naming error is a battery failure.
def infer_probe_parity_mutation_check(label: String, node: Int, lower: Result[MirProgram, String], inout report: String) -> Int
  match lower
  when Result::Ok(_) then
    report = report + "PARITY_MUTATION " + label.clone() + " FAIL: lowering silently accepted a deleted typed record (node " + node.to_string() + ") — a name-based fallback or a wrong value\n"
    1
  when Result::Err(e) then
    if e.contains("internal error") && e.contains(node.to_string()) then
      report = report + "PARITY_MUTATION " + label.clone() + " PASS node=" + node.to_string() + " error=" + e.clone() + "\n"
      0
    else
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: the error neither names the node nor is an internal error: " + e.clone() + "\n"
      1
    end
  end
end

def infer_probe_parity_mutation_global(inout report: String) -> Int
  let label = "mut_global_const_deleted"
  let source = "const X: Int = 1\n\ndef add(a: Int, b: Int) -> Int\n  a + b\nend\n\ndef main() -> Int\n  add(X, 2)\nend\n"
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "PARITY_MUTATION " + label.clone() + " FAIL: parse failed\n"
    return 1
  end
  var program = parsed.program
  var env = type_env_new()
  env.strict_resolution = true
  let opts = default_options()
  match analyze_parsed(&mut env, &mut program, opts)
  when Result::Err(_diags) then
    report = report + "PARITY_MUTATION " + label.clone() + " FAIL: analyze failed\n"
    1
  when Result::Ok(a) then
    var analyzed = a
    let entries = analyzed.typed.global_bindings.entries()
    # the program records a global binding for the const read AND (as the
    # checker's value-position callable recording) for the `add` callee;
    # the mutation deletes EVERY typed record for the GbConst node(s).
    var const_nodes: Vec[Int] = Vec::new()
    var const_def_nums: Vec[Int] = Vec::new()
    var gi = 0
    while gi < entries.len() do
      match entries[gi].1
      when GlobalBinding::GbConst(did) then
        const_nodes.push(entries[gi].0)
        const_def_nums.push(def_id_numeric(&did))
      when _ then ()
      end
      gi = gi + 1
    end
    if const_nodes.len() == 0 then
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: no recorded GbConst binding to delete (" + entries.len().to_string() + " binding(s))\n"
      return 1
    end
    # CONTROL: the unmutated lowering consumes the recorded identity (a
    # static reference to the const's DefId appears in main).
    var control = "-"
    match lower_to_mir(&program, &analyzed)
    when Result::Ok(mir) then
      if infer_probe_mir_has_static_ref(mir, "main", const_def_nums[0]) then
        control = "static-ref"
      else
        control = "no-static-ref"
      end
    when Result::Err(e) then control = "err:" + e.clone()
    end
    if control != "static-ref" then
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: the control lowering does not consume the recorded const identity (" + control.clone() + ")\n"
      return 1
    end
    # MUTATE: delete every typed record for the GbConst node(s).
    var typed = analyzed.typed
    var di = 0
    while di < const_nodes.len() do
      let dn = const_nodes[di]
      let _ = typed.global_bindings.remove(dn)
      let _ = typed.const_param_reads.remove(dn)
      let _ = typed.ident_resolutions.remove(dn)
      let _ = typed.typed_exprs.remove(dn)
      di = di + 1
    end
    analyzed.typed = typed
    match lower_to_mir(&program, &analyzed)
    when Result::Ok(mir) then
      var still = false
      if infer_probe_mir_has_static_ref(mir, "main", const_def_nums[0]) then still = true end
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: lowering silently accepted deleted GbConst records (" + const_nodes.len().to_string() + " node(s); control=" + control.clone() + " still_static_ref=" + still.to_string() + ")\n"
      1
    when Result::Err(e) then
      var matched2 = 0
      var mk = 0
      while mk < const_nodes.len() do
        if e.contains(const_nodes[mk].to_string()) then matched2 = matched2 + 1 end
        mk = mk + 1
      end
      if e.contains("internal error") && matched2 > 0 then
        report = report + "PARITY_MUTATION " + label.clone() + " PASS nodes=" + const_nodes.len().to_string() + " matched=" + matched2.to_string() + " error=" + e.clone() + "\n"
        0
      else
        report = report + "PARITY_MUTATION " + label.clone() + " FAIL: the error neither names a deleted node nor is an internal error: " + e.clone() + "\n"
        1
      end
    end
  end
end

def infer_probe_parity_mutation_local(inout report: String) -> Int
  let label = "mut_local_resolution_deleted"
  let source = "def main() -> Int\n  let a = 3\n  a + 1\nend\n"
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "PARITY_MUTATION " + label.clone() + " FAIL: parse failed\n"
    return 1
  end
  var program = parsed.program
  var env = type_env_new()
  env.strict_resolution = true
  let opts = default_options()
  match analyze_parsed(&mut env, &mut program, opts)
  when Result::Err(_diags) then
    report = report + "PARITY_MUTATION " + label.clone() + " FAIL: analyze failed\n"
    1
  when Result::Ok(a) then
    var analyzed = a
    let entries = analyzed.typed.ident_resolutions.entries()
    if entries.len() == 0 then
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: no recorded local resolution to delete\n"
      return 1
    end
    var typed = analyzed.typed
    var ei = 0
    while ei < entries.len() do
      let node = entries[ei].0
      let _ = typed.ident_resolutions.remove(node)
      let _ = typed.typed_exprs.remove(node)
      ei = ei + 1
    end
    analyzed.typed = typed
    # at least one removed node is actually lowered; the lowering must fail
    # closed naming it.  Check every removed node id for a naming witness.
    var matched = 0
    match lower_to_mir(&program, &analyzed)
    when Result::Ok(_) then
      report = report + "PARITY_MUTATION " + label.clone() + " FAIL: lowering silently accepted deleted local resolutions (" + entries.len().to_string() + " node(s))\n"
      1
    when Result::Err(e) then
      if !e.contains("internal error") then
        report = report + "PARITY_MUTATION " + label.clone() + " FAIL: not an internal error: " + e.clone() + "\n"
        return 1
      end
      var ei2 = 0
      while ei2 < entries.len() do
        if e.contains(entries[ei2].0.to_string()) then matched = matched + 1 end
        ei2 = ei2 + 1
      end
      if matched == 0 then
        report = report + "PARITY_MUTATION " + label.clone() + " FAIL: the error names no deleted node: " + e.clone() + "\n"
        1
      else
        report = report + "PARITY_MUTATION " + label.clone() + " PASS nodes=" + entries.len().to_string() + " matched=" + matched.to_string() + " error=" + e.clone() + "\n"
        0
      end
    end
  end
end

# The duplicate-names-across-modules dimension cannot ride the
# single-program cases file: the kernel resolver's get_current_module
# Option::expect traps on inline `module ... end` blocks in the
# standalone probe surface (observed: host call __intrinsic_option_expect
# module not found), and the parity lane must not fake the row.  Build
# the two-module program with the same crate scaffolding
# resolution_parity_probe uses, resolve/typecheck it, and emit the
# PARITY row directly (the OCaml lane compares it like any other row).
def infer_probe_parity_multi_program(label: String, names: Vec[String], sources: Vec[String]) -> Option[Program]
  var items = Vec::new()
  var modules: Map[ModuleId, Module] = Map::new()
  var bad = false
  var i = 0
  while i < names.len() do
    let parsed = parse(tokenize(sources[i].clone(), label.clone() + "::" + names[i].clone()))
    if diag_has_errors(&parsed.diagnostics) then
      bad = true
    else
      var mid = ModuleId { id: i }
      var start = items.len()
      for item in parsed.program.items do
        var owned = item.clone()
        owned.owner_module = ModuleId { id: mid.id }
        items.push(owned)
      end
      var mod_items = Vec::new()
      var k = start
      while k < items.len() do
        mod_items.push(ItemId { id: k })
        k = k + 1
      end
      var mod_imports = Vec::new()
      for item in parsed.program.items do
        match item.kind
        when ItemKind::ItemUse(u) then mod_imports.push(u.path.segments.join("::"))
        when _ then ()
        end
      end
      modules.insert(mid, Module {
        id: mid,
        path: names[i].clone().split("::"),
        items: mod_items,
        imports: mod_imports
      })
    end
    i = i + 1
  end
  if bad then
    Option::None
  else
    Option::Some(Program {
      items: items,
      crate: Crate { root: ModuleId { id: 0 }, modules: modules },
      span: Span { file: label.clone(), start: 0, end_pos: 0 }
    })
  end
end

def infer_probe_parity_multi_module_case(inout report: String) -> Unit
  let label = "dup_names_across_modules"
  let names = vec!["a", "b"]
  let sources = vec![
    "const X: Int = 1\nconst STATE: Int = 10\n\nstruct Config\n  n: Int = 111\n  only_a: Int\nend\n\nstruct State\n  count: Int\nend\n\nenum Ready\n  Ready(Int)\n  Idle\nend\n\ndef make() -> Int\n  let c = Config { n: 1, only_a: 2 }\n  c.n * 10 + c.only_a\nend\n\ndef value() -> Int = X + STATE\n",
    "const X: Int = 2\nconst STATE: Int = 20\n\nstruct Config\n  text: String\n  flag: Bool = false\nend\n\nstruct State\n  label: String\nend\n\nenum Ready\n  Ready(Bool)\n  Done\nend\n\ndef make() -> Int\n  let c = Config { text: \"b\" }\n  let base = c.text.len()\n  if c.flag then base + 100 else base end\nend\n\ndef value() -> Int = X + STATE\n"
  ]
  match infer_probe_parity_multi_program(label, names, sources)
  when Option::None then
    report = report + "PARITY " + label + " verdict=parse-reject errors=1 main_ret=- first=parse\n"
  when Option::Some(program) then
    var program = program
    assign_node_ids(&mut program)
    match resolve_names(program)
    when Result::Err(errs) then
      var rfirst = "-"
      if errs.len() > 0 then rfirst = infer_probe_norm_ids(errs[0].message.clone()) end
      report = report + "PARITY " + label + " verdict=resolve-reject errors=" + errs.len().to_string() + " main_ret=- first=" + rfirst.clone() + "\n"
    when Result::Ok(res) then
      var env = type_env_new()
      env.strict_resolution = true
      let result = type_check_typed(&mut env, &program, &res)
      if result.errors.len() == 0 then
        report = report + "PARITY " + label + " verdict=accept errors=0 main_ret=- first=-\n"
      else
        report = report + "PARITY " + label + " verdict=reject errors=" + result.errors.len().to_string() + " main_ret=- first=" + infer_probe_norm_ids(result.errors[0].message.clone()) + "\n"
      end
    end
  end
end

def infer_probe_parity_battery(inout report: String) -> Int
  var fails = 0
  fails = fails + infer_probe_parity_mutation_global(&mut report)
  fails = fails + infer_probe_parity_mutation_local(&mut report)
  # the multi-module dimension built with the crate scaffolding (never
  # shipped in the single-program cases file — see the builder comment)
  infer_probe_parity_multi_module_case(&mut report)
  var cases: Vec[(String, String)] = Vec::new()
  if file_exists("build/parity_cases.txt") then
    let source = match read_file("build/parity_cases.txt")
    when Result::Ok(s) then s
    when Result::Err(_) then ""
    end
    cases = infer_probe_parity_parse_cases(source)
    if cases.len() == 0 then
      report = report + "PARITY_BATTERY FAIL: build/parity_cases.txt present but no CASE record parsed\n"
      fails = fails + 1
    end
  else
    report = report + "PARITY_BATTERY no-cases: build/parity_cases.txt absent (tg_semantic_parity writes it) — cases=0 is NOT a semantic agreement claim\n"
  end
  var i = 0
  while i < cases.len() do
    infer_probe_parity_case(cases[i].0.clone(), cases[i].1.clone(), &mut report)
    i = i + 1
  end
  report = report + "PARITY_BATTERY fails=" + fails.to_string() + " cases=" + cases.len().to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# HIR_COMPLETE battery (the mandatory typed-channel completeness
# verifier): a generic constructor whose type parameter is only solvable
# from a LATER use — the `var keys = Vec::new()` + `push(x)` shape of the
# 78B frontier's `rs_resolve_imports` site — typechecked through the REAL
# checker. The positive leg asserts the channels DIRECTLY by exact
# NodeId: the constructor call node's typed record, its concrete
# finalized type and solved substitution, the parent later-use call's
# typed record + call-target identity, and the argument's typed record +
# recorded access effect. The mutation leg deletes the argument's typed
# HIR record and requires verify_typed_channel_completeness to fail with
# the EXACT HIR_MISSING fingerprint naming that node (a verifier that
# were removed or false-green cannot pass this branch).
# ———————————————————————————————————————————————————————————————
def infer_probe_ty_has_error(ty: Type) -> Bool
  match ty
  when Type::Error then true
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if infer_probe_ty_has_error(a) then found = true end
    end
    found
  when Type::Ptr(inner) then infer_probe_ty_has_error(inner)
  when Type::PtrMut(inner) then infer_probe_ty_has_error(inner)
  when Type::RefInternal(inner, _) then infer_probe_ty_has_error(inner)
  when Type::Tuple(fs) then
    var found2 = false
    for f in fs do
      if infer_probe_ty_has_error(f) then found2 = true end
    end
    found2
  when Type::FixedArray(elem, _) then infer_probe_ty_has_error(elem)
  when Type::FixedArraySym(elem, _) then infer_probe_ty_has_error(elem)
  when Type::FnPtr(ps, ret, _) then
    var found3 = infer_probe_ty_has_error(ret)
    for p in ps do
      if infer_probe_ty_has_error(p.ty.clone()) then found3 = true end
    end
    found3
  when Type::Closure(_, ps, ret, _, _) then
    var found4 = infer_probe_ty_has_error(ret)
    for p in ps do
      if infer_probe_ty_has_error(p.ty.clone()) then found4 = true end
    end
    found4
  when _ then false
  end
end

def infer_probe_hir_complete_battery(inout report: String) -> Int
  var fails = 0
  let source = "struct Bag[T]\n  count: Int = 0\nend\n\ndef bag_new[T]() -> Bag[T]\n  Bag { count: 0 }\nend\n\ndef bag_push[T](inout b: Bag[T], v: T) -> Unit\nend\n\ndef collect(n: Int) -> Int\n  var keys = bag_new()\n  var i = 0\n  while i < n do\n    bag_push(keys, i)\n    i = i + 1\n  end\n  keys.count\nend\n\ndef main() -> Int\n  collect(3)\nend\n"
  let parsed = parse(tokenize(source, "hir_complete"))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "HIR_COMPLETE_BATTERY: parse failed\n"
    return 1
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    report = report + "HIR_COMPLETE_BATTERY: resolve failed=" + errs.len().to_string() + "\n"
    return 1
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() != 0 then
      report = report + "HIR_COMPLETE_BATTERY: positive shape rejected errors=" + result.errors.len().to_string() + " first=" + result.errors[0].message.clone() + "\n"
      return 1
    end
    # locate the shape by exact node id: `bag_new()` (constructor),
    # `bag_push(keys, i)` (later use), and its first argument.
    var new_node = -1
    var push_node = -1
    var arg_node = -1
    for item in program.items do
      match item.kind
      when ItemKind::ItemFunction(f) then
        match f.body
        when FnBody::FnBlock(b) then
          var si = 0
          while si < b.stmts.len() do
            match b.stmts[si].kind
            when StmtKind::StmtLet(_, _, value, _) then
              match value.kind
              when ExprKind::ExprCall(callee, _) then
                match callee.get().kind
                when ExprKind::ExprIdent(name) then
                  if name == "bag_new" then new_node = value.node_id end
                when _ then ()
                end
              when _ then ()
              end
            when StmtKind::StmtWhile(_, body) then
              var sj = 0
              while sj < body.stmts.len() do
                match body.stmts[sj].kind
                when StmtKind::StmtExpr(e) then
                  match e.kind
                  when ExprKind::ExprCall(callee2, args) then
                    match callee2.get().kind
                    when ExprKind::ExprIdent(name2) then
                      if name2 == "bag_push" then
                        push_node = e.node_id
                        if args.len() > 0 then arg_node = args[0].node_id end
                      end
                    when _ then ()
                    end
                  when _ then ()
                  end
                when _ then ()
                end
                sj = sj + 1
              end
            when _ then ()
            end
            si = si + 1
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    if new_node < 0 || push_node < 0 || arg_node < 0 then
      report = report + "HIR_COMPLETE_BATTERY: node scan failed new=" + new_node.to_string() + " push=" + push_node.to_string() + " arg=" + arg_node.to_string() + "\n"
      return 1
    end
    # (1) the constructor call node: typed record + concrete finalized
    # type + concrete solved substitution.
    if !env.typed_exprs.contains_key(new_node) then
      report = report + "HIR_COMPLETE_BATTERY: constructor call node " + new_node.to_string() + " has no typed HIR record\n"
      fails = fails + 1
    end
    match env.typed_expr_types.get(new_node)
    when Option::Some(ty) then
      if infer_probe_has_var(ty.clone()) || infer_probe_ty_has_error(ty.clone()) then
        report = report + "HIR_COMPLETE_BATTERY: constructor call node " + new_node.to_string() + " finalized type is not concrete: " + infer_probe_render(ty.clone()) + "\n"
        fails = fails + 1
      end
    when Option::None then
      report = report + "HIR_COMPLETE_BATTERY: constructor call node " + new_node.to_string() + " has no recorded type\n"
      fails = fails + 1
    end
    match env.typed_call_instances.get(new_node)
    when Option::Some(inst_args) then
      var gi = 0
      while gi < inst_args.len() do
        let gi_arg = inst_args[gi].clone()
        match gi_arg
        when GenericArg::Type(aty) then
          if infer_probe_has_var(aty.clone()) || infer_probe_ty_has_error(aty.clone()) then
            report = report + "HIR_COMPLETE_BATTERY: constructor node " + new_node.to_string() + " solved substitution is not concrete: " + infer_probe_render(aty.clone()) + "\n"
            fails = fails + 1
          end
        when GenericArg::Const(_) then ()
        end
        gi = gi + 1
      end
    when Option::None then
      report = report + "HIR_COMPLETE_BATTERY: constructor node " + new_node.to_string() + " has no solved call substitution\n"
      fails = fails + 1
    end
    # (2) the parent later-use call + its argument.
    if !env.typed_exprs.contains_key(push_node) then
      report = report + "HIR_COMPLETE_BATTERY: parent call node " + push_node.to_string() + " has no typed HIR record\n"
      fails = fails + 1
    end
    if !env.typed_call_targets.contains_key(push_node) then
      report = report + "HIR_COMPLETE_BATTERY: parent call node " + push_node.to_string() + " has no call-target identity\n"
      fails = fails + 1
    end
    if !env.typed_exprs.contains_key(arg_node) then
      report = report + "HIR_COMPLETE_BATTERY: argument node " + arg_node.to_string() + " has no typed HIR record\n"
      fails = fails + 1
    end
    if !env.typed_access_effects.contains_key(arg_node) then
      report = report + "HIR_COMPLETE_BATTERY: argument node " + arg_node.to_string() + " has no recorded access effect\n"
      fails = fails + 1
    end
    # (3) the verifier passes on the accepted channels.
    let pre_ok = env.errors.len()
    let ok = verify_typed_channel_completeness(&mut env, &program)
    if !ok || env.errors.len() != pre_ok then
      report = report + "HIR_COMPLETE_BATTERY: positive verifier leg failed (ok=" + ok.to_string() + " delta=" + (env.errors.len() - pre_ok).to_string() + ")\n"
      fails = fails + 1
    end
    # (4) the mutation: delete the argument record and require the EXACT
    # HIR_MISSING fingerprint naming that node.
    let _ = env.typed_exprs.remove(arg_node)
    let before = env.errors.len()
    let ok2 = verify_typed_channel_completeness(&mut env, &program)
    let delta = env.errors.len() - before
    if ok2 || delta != 1 then
      report = report + "HIR_COMPLETE_BATTERY: mutation was not rejected (ok=" + ok2.to_string() + " delta=" + delta.to_string() + ")\n"
      fails = fails + 1
    else
      let got = env.errors[env.errors.len() - 1].message.clone()
      let node_mark = "|collect|Node=" + arg_node.to_string() + "|ident|no typed HIR record"
      if !got.starts_with("HIR_MISSING|") || !got.contains(node_mark) then
        report = report + "HIR_COMPLETE_BATTERY: mutation fingerprint mismatch: " + got.clone() + "\n"
        fails = fails + 1
      else
        report = report + "HIR_COMPLETE_MUTATION PASS node=" + arg_node.to_string() + " fp=" + got.clone() + "\n"
      end
    end
  end
  report = report + "HIR_COMPLETE_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# patch 3 item B: the kernel checker's builtin String/str method surface.
# The seed types the receiver methods from its builtin_methods m_string
# table (typecheck.ml): parse_float/parse_int are builtin receiver methods
# even though std/core.tg declares parse_float as a FREE function — the
# std/bench.tg load_baseline shape `parts[1].trim().parse_float()` is the
# canonical consumer. Without the kernel builtin arm the method resolution
# records `no method` + Type::Error and the tuple literal fails the
# typed-channel completeness gate with HIR_INVALID|tuple-literal. The
# shapes assert Error/Var-free channels and readiness.
# ———————————————————————————————————————————————————————————————
def infer_probe_builtin_string_surface_battery(inout report: String) -> Int
  var fails = 0
  # Q: the EXACT std/bench.tg load_baseline mirror — String.split(","),
  #    indexing, trim() and parse_float() in a tuple match.
  let case_q = "def pick(line: String) -> Float\n  let parts = line.trim().split(\",\")\n  match (parts[1].trim().parse_float(), parts[2].trim().parse_float())\n  when (Option::Some(mean), Option::Some(sd)) then mean + sd\n  when _ then 0.0\n  end\nend\n\ndef main() -> Int\n  let f = pick(\"a,1.5,2.5\")\n  0\nend\n"
  let (q_n, q_e, q_v, q_i, q_ok, q_d) = infer_probe_channel_probe(case_q)
  if q_n != 0 || q_e != 0 || q_v != 0 || q_i != 0 || !q_ok then
    report = report + "BUILTIN_STRING Q: load_baseline split/index/trim/parse_float channels not concrete (errors=" + q_n.to_string() + " expr_error=" + q_e.to_string() + " expr_var=" + q_v.to_string() + " inst_bad=" + q_i.to_string() + " readiness=" + q_ok.to_string() + " detail=" + q_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "BUILTIN_STRING Q PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
  end
  # R: the rest of the seed m_string surface — is_empty/replace/
  #    starts_with/ends_with/contains/parse_int/lines/as_bytes.
  let case_r = "def norm(s: String) -> Int\n  let p = s.trim()\n  if p.is_empty() then return 0 end\n  let q = p.replace(\",\", \"_\")\n  if q.starts_with(\"-\") || q.ends_with(\".\") || q.contains(\"x\") then return -1 end\n  let _ = p.lines()\n  let _ = p.as_bytes()\n  match q.parse_int()\n  when Result::Ok(n) then n\n  when Result::Err(_m) then -2\n  end\nend\n\ndef main() -> Int\n  norm(\"42\")\nend\n"
  let (r_n, r_e, r_v, r_i, r_ok, r_d) = infer_probe_channel_probe(case_r)
  if r_n != 0 || r_e != 0 || r_v != 0 || r_i != 0 || !r_ok then
    report = report + "BUILTIN_STRING R: parse_int/replace/is_empty/prefix family channels not concrete (errors=" + r_n.to_string() + " expr_error=" + r_e.to_string() + " expr_var=" + r_v.to_string() + " inst_bad=" + r_i.to_string() + " readiness=" + r_ok.to_string() + " detail=" + r_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "BUILTIN_STRING R PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
  end
  report = report + "BUILTIN_STRING_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# patch 3 item A: the all-failures enumeration mode. The verifier walks
# the WHOLE program when env.hir_report_all is set (TANGERINE_HIR_REPORT=
# all), appending every failure fingerprint (deduped/sorted/capped when
# reported) while recording exactly ONE error (the first failure) so the
# pre-MIR gate keeps failing at the same coordinate. This battery injects
# TWO independent failures and requires >= 2 unique fingerprints.
# ———————————————————————————————————————————————————————————————
def infer_probe_hir_all_failures_battery(inout report: String) -> Int
  var fails = 0
  let source = "struct Bag[T]\n  count: Int = 0\nend\n\ndef bag_new[T]() -> Bag[T]\n  Bag { count: 0 }\nend\n\ndef bag_push[T](inout b: Bag[T], v: T) -> Unit\nend\n\ndef collect(n: Int) -> Int\n  var keys = bag_new()\n  var i = 0\n  while i < n do\n    bag_push(keys, i)\n    i = i + 1\n  end\n  keys.count\nend\n\ndef main() -> Int\n  collect(3)\nend\n"
  let parsed = parse(tokenize(source, "hir_all_failures"))
  if diag_has_errors(&parsed.diagnostics) then
    report = report + "HIR_ALL_FAILURES_BATTERY: parse failed\n"
    return 1
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    report = report + "HIR_ALL_FAILURES_BATTERY: resolve failed=" + errs.len().to_string() + "\n"
    return 1
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() != 0 then
      report = report + "HIR_ALL_FAILURES_BATTERY: shape rejected errors=" + result.errors.len().to_string() + " first=" + result.errors[0].message.clone() + "\n"
      return 1
    end
    var new_node = -1
    var arg_node = -1
    for item in program.items do
      match item.kind
      when ItemKind::ItemFunction(f) then
        match f.body
        when FnBody::FnBlock(b) then
          var si = 0
          while si < b.stmts.len() do
            match b.stmts[si].kind
            when StmtKind::StmtLet(_, _, value, _) then
              match value.kind
              when ExprKind::ExprCall(callee, _) then
                match callee.get().kind
                when ExprKind::ExprIdent(name) then
                  if name == "bag_new" then new_node = value.node_id end
                when _ then ()
                end
              when _ then ()
              end
            when StmtKind::StmtWhile(_, body) then
              var sj = 0
              while sj < body.stmts.len() do
                match body.stmts[sj].kind
                when StmtKind::StmtExpr(e) then
                  match e.kind
                  when ExprKind::ExprCall(callee2, args) then
                    match callee2.get().kind
                    when ExprKind::ExprIdent(name2) then
                      if name2 == "bag_push" && args.len() > 0 then arg_node = args[0].node_id end
                    when _ then ()
                    end
                  when _ then ()
                  end
                when _ then ()
                end
                sj = sj + 1
              end
            when _ then ()
            end
            si = si + 1
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    if new_node < 0 || arg_node < 0 then
      report = report + "HIR_ALL_FAILURES_BATTERY: node scan failed new=" + new_node.to_string() + " arg=" + arg_node.to_string() + "\n"
      return 1
    end
    # all-failures mode: two independent typed records removed.  FIRST
    # assert the GATE is observed END TO END: the probe writes the flag
    # file the kernel verifier reads, then a FRESH env's verifier run
    # must flip the mode on by itself. (TANGERINE_HIR_REPORT=all is the
    # documented primary gate; the seed VM's closure path does not
    # surface the host environment to the guest — probed: get_env
    # returns None even for PATH — so build/hir_report_all.flag is the
    # operational signal and is exercised here.) Then remove the flag
    # and continue with the two-failure injection on `env`.
    let _flagw = write_file("build/hir_report_all.flag", "all".to_string())
    var gate_env = type_env_new()
    gate_env.strict_resolution = true
    let _gate_result = type_check_typed(&mut gate_env, &program, &res)
    if !gate_env.hir_report_all then
      report = report + "HIR_ALL_FAILURES_BATTERY: the all-failures gate was not observed by a fresh verifier run (TANGERINE_HIR_REPORT and build/hir_report_all.flag both unread)\n"
      fails = fails + 1
    end
    let _ = delete_file("build/hir_report_all.flag".to_string())
    env.hir_report_all = true
    env.hir_report_fingerprints.clear()
    env.hir_report_all = true
    env.hir_report_base = 0
    let _ = env.typed_exprs.remove(arg_node)
    let _ = env.typed_exprs.remove(new_node)
    let before = env.errors.len()
    let ok = verify_typed_channel_completeness(&mut env, &program)
    let delta = env.errors.len() - before
    var uniq: Map[String, Bool] = Map::new()
    var total = 0
    for fp in env.hir_report_fingerprints do
      total = total + 1
      uniq.insert(fp.clone(), true)
    end
    var uniq_n = 0
    for (_k, _v) in uniq.entries() do
      uniq_n = uniq_n + 1
    end
    if ok then
      report = report + "HIR_ALL_FAILURES_BATTERY: all-mode verifier accepted two injected failures\n"
      fails = fails + 1
    elsif delta != 1 then
      report = report + "HIR_ALL_FAILURES_BATTERY: expected exactly one recorded error (the first failure), delta=" + delta.to_string() + "\n"
      fails = fails + 1
    elsif uniq_n < 2 then
      report = report + "HIR_ALL_FAILURES_BATTERY: all-mode reported " + uniq_n.to_string() + " unique fingerprint(s) for two injected failures (total=" + total.to_string() + ")\n"
      fails = fails + 1
    else
      report = report + "HIR_ALL_FAILURES PASS ok=false delta=1 fingerprints=" + uniq_n.to_string() + "\n"
    end
  end
  report = report + "HIR_ALL_FAILURES_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# patch 3 item D: imported / aliased values, including a struct field
# DEFAULT shaped by an import. Built on the crate-scaffolded multi-module
# builder (the single-file probe cannot import across modules). The
# resolver must accept the import (module_symbols target check), the
# checker must type the imported (bare and ALIASED) name in the declaration
# scope of the default, and the lowering consumes the recorded GbConst
# identity. The inline-module leg pins the resolver panic fix: resolution
# must RETURN (clean verdict or the recorded UnresolvedModule diagnostic),
# never abort the VM.
# ———————————————————————————————————————————————————————————————
def infer_probe_imported_defaults_battery(inout report: String) -> Int
  var fails = 0
  # D1: exact import in a field default (`use values::{X}`).
  match infer_probe_parity_multi_program("imported_default_exact", vec!["values", "main"], vec!["const X: Int = 7\n", "use values::{X}\n\nstruct S\n  n: Int = X\nend\n\ndef get() -> Int\n  let s = S {}\n  s.n\nend\n"])
  when Option::None then
    report = report + "IMPORTED_DEFAULTS D1: parse failed\n"
    fails = fails + 1
  when Option::Some(program0) then
    var program = program0
    assign_node_ids(&mut program)
    match resolve_names(program)
    when Result::Err(errs) then
      var rfirst = "-"
      if errs.len() > 0 then rfirst = errs[0].message.clone() end
      report = report + "IMPORTED_DEFAULTS D1: resolve failed=" + errs.len().to_string() + " first=" + rfirst.clone() + "\n"
      fails = fails + 1
    when Result::Ok(res) then
      var env = type_env_new()
      env.strict_resolution = true
      let result = type_check_typed(&mut env, &program, &res)
      let readiness = verify_typed_channel_completeness(&mut env, &program)
      var gb = 0
      for (_n, b) in env.typed_global_bindings.entries() do
        match b
        when GlobalBinding::GbConst(_) then gb = gb + 1
        when _ then ()
        end
      end
      if result.errors.len() != 0 || !readiness || gb == 0 then
        var efirst = "-"
        if result.errors.len() > 0 then efirst = result.errors[0].message.clone() end
        report = report + "IMPORTED_DEFAULTS D1: errors=" + result.errors.len().to_string() + " readiness=" + readiness.to_string() + " gbconst=" + gb.to_string() + " first=" + efirst.clone() + "\n"
        fails = fails + 1
      else
        report = report + "IMPORTED_DEFAULTS D1 PASS errors=0 readiness=true gbconst=" + gb.to_string() + "\n"
      end
    end
  end
  # D2: aliased import in a field default (`use values::X as Y`).
  match infer_probe_parity_multi_program("imported_default_alias", vec!["values", "main"], vec!["const X: Int = 7\n", "use values::X as Y\n\nstruct S\n  n: Int = Y\nend\n\ndef get() -> Int\n  let s = S {}\n  s.n\nend\n"])
  when Option::None then
    report = report + "IMPORTED_DEFAULTS D2: parse failed\n"
    fails = fails + 1
  when Option::Some(program0) then
    var program = program0
    assign_node_ids(&mut program)
    match resolve_names(program)
    when Result::Err(errs) then
      var rfirst2 = "-"
      if errs.len() > 0 then rfirst2 = errs[0].message.clone() end
      report = report + "IMPORTED_DEFAULTS D2: resolve failed=" + errs.len().to_string() + " first=" + rfirst2.clone() + "\n"
      fails = fails + 1
    when Result::Ok(res) then
      var env = type_env_new()
      env.strict_resolution = true
      let result = type_check_typed(&mut env, &program, &res)
      let readiness = verify_typed_channel_completeness(&mut env, &program)
      var gb2 = 0
      for (_n2, b2) in env.typed_global_bindings.entries() do
        match b2
        when GlobalBinding::GbConst(_) then gb2 = gb2 + 1
        when _ then ()
        end
      end
      if result.errors.len() != 0 || !readiness || gb2 == 0 then
        var efirst2 = "-"
        if result.errors.len() > 0 then efirst2 = result.errors[0].message.clone() end
        report = report + "IMPORTED_DEFAULTS D2: errors=" + result.errors.len().to_string() + " readiness=" + readiness.to_string() + " gbconst=" + gb2.to_string() + " first=" + efirst2.clone() + "\n"
        fails = fails + 1
      else
        report = report + "IMPORTED_DEFAULTS D2 PASS errors=0 readiness=true gbconst=" + gb2.to_string() + "\n"
      end
    end
  end
  # D3: inline-module resolution must never abort the VM (the former
  # get_current_module Option::expect trap). Either verdict is accepted;
  # the row proves the resolver returned.
  let inline_src = "module inner\n  const Z: Int = 1\nend\n\ndef main() -> Int\n  0\nend\n"
  let parsed3 = parse(tokenize(inline_src, "inline_module_probe"))
  if diag_has_errors(&parsed3.diagnostics) then
    report = report + "IMPORTED_DEFAULTS D3: inline parse failed\n"
    fails = fails + 1
  else
    var program3 = parsed3.program
    assign_node_ids(&mut program3)
    match resolve_names(program3)
    when Result::Ok(_r3) then
      report = report + "IMPORTED_DEFAULTS D3 PASS no-trap verdict=accept\n"
    when Result::Err(errs3) then
      var first3 = ""
      if errs3.len() > 0 then first3 = errs3[0].message.clone() end
      report = report + "IMPORTED_DEFAULTS D3 PASS no-trap verdict=reject errors=" + errs3.len().to_string() + " first=" + first3.clone() + "\n"
    end
  end
  report = report + "IMPORTED_DEFAULTS_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# patch 3 item E: std::time builtin module symbols by SEMANTIC identity
# (the resolver's BuiltinBinding per resolved node id). Exact import,
# aliased import, fully-qualified path; local shadow; unimported; and the
# missing canonical Instant hard error (never a fresh inference variable).
# ———————————————————————————————————————————————————————————————
def infer_probe_time_binding_battery(inout report: String) -> Int
  var fails = 0
  # E1: exact group import.
  let case_e1 = "use std::time::{instant_now, duration_nanos}\n\nstruct Instant\n  ts: Int\nend\n\ndef take() -> UInt\n  let start = instant_now()\n  duration_nanos(start)\nend\n\ndef main() -> Int\n  let u = take()\n  0\nend\n"
  let (e1_n, e1_e, e1_v, e1_i, e1_ok, e1_d) = infer_probe_channel_probe(case_e1)
  if e1_n != 0 || e1_e != 0 || e1_v != 0 || e1_i != 0 || !e1_ok then
    report = report + "TIME_BINDING E1 exact: channels not concrete (errors=" + e1_n.to_string() + " expr_error=" + e1_e.to_string() + " expr_var=" + e1_v.to_string() + " inst_bad=" + e1_i.to_string() + " readiness=" + e1_ok.to_string() + " detail=" + e1_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E1 PASS exact\n"
  end
  # E2: aliased imports (`use std::time.instant_now as now`).
  let case_e2 = "use std::time::instant_now as now\nuse std::time::duration_nanos as dur\n\nstruct Instant\n  ts: Int\nend\n\ndef take() -> UInt\n  let start = now()\n  dur(start)\nend\n\ndef main() -> Int\n  let u = take()\n  0\nend\n"
  let (e2_n, e2_e, e2_v, e2_i, e2_ok, e2_d) = infer_probe_channel_probe(case_e2)
  if e2_n != 0 || e2_e != 0 || e2_v != 0 || e2_i != 0 || !e2_ok then
    report = report + "TIME_BINDING E2 alias: channels not concrete (errors=" + e2_n.to_string() + " expr_error=" + e2_e.to_string() + " expr_var=" + e2_v.to_string() + " inst_bad=" + e2_i.to_string() + " readiness=" + e2_ok.to_string() + " detail=" + e2_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E2 PASS alias\n"
  end
  # E3: fully-qualified path (no import required).
  let case_e3 = "struct Instant\n  ts: Int\nend\n\ndef take() -> UInt\n  let start = std::time::instant_now()\n  std::time::duration_nanos(start)\nend\n\ndef main() -> Int\n  let u = take()\n  0\nend\n"
  let (e3_n, e3_e, e3_v, e3_i, e3_ok, e3_d) = infer_probe_channel_probe(case_e3)
  if e3_n != 0 || e3_e != 0 || e3_v != 0 || e3_i != 0 || !e3_ok then
    report = report + "TIME_BINDING E3 qualified: channels not concrete (errors=" + e3_n.to_string() + " expr_error=" + e3_e.to_string() + " expr_var=" + e3_v.to_string() + " inst_bad=" + e3_i.to_string() + " readiness=" + e3_ok.to_string() + " detail=" + e3_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E3 PASS qualified\n"
  end
  # E4: a local shadows the aliased builtin name — the local wins and the
  # program stays clean.
  let case_e4 = "use std::time::instant_now as now\n\nstruct Instant\n  ts: Int\nend\n\ndef take() -> Int\n  let now: Int = 5\n  now + 1\nend\n\ndef main() -> Int\n  take()\nend\n"
  let (e4_n, e4_e, e4_v, e4_i, e4_ok, e4_d) = infer_probe_channel_probe(case_e4)
  if e4_n != 0 || e4_e != 0 || e4_v != 0 || e4_i != 0 || !e4_ok then
    report = report + "TIME_BINDING E4 local-shadow: channels not concrete (errors=" + e4_n.to_string() + " expr_error=" + e4_e.to_string() + " expr_var=" + e4_v.to_string() + " inst_bad=" + e4_i.to_string() + " readiness=" + e4_ok.to_string() + " detail=" + e4_d.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E4 PASS local-shadow\n"
  end
  # E5: UNIMPORTED bare spelling must be rejected (never typed by
  # spelling). The resolver rejects the unresolved name first; either
  # verdict is a reject — an ACCEPT is the bug.
  let case_e5 = "struct Instant\n  ts: Int\nend\n\ndef take() -> UInt\n  duration_nanos(instant_now())\nend\n\ndef main() -> Int\n  let u = take()\n  0\nend\n"
  let (e5_n, e5_e, e5_v, e5_i, e5_ok, e5_d) = infer_probe_channel_probe(case_e5)
  if e5_n == 0 && e5_ok then
    report = report + "TIME_BINDING E5 unimported: WRONGLY accepted (errors=0 readiness=true)\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E5 PASS unimported-reject errors=" + e5_n.to_string() + " readiness=" + e5_ok.to_string() + "\n"
  end
  # E6: missing canonical Instant -> hard semantic error, NEVER a fresh
  # inference variable.
  let case_e6 = "use std::time::{instant_now}\n\ndef take() -> Int\n  let _t = instant_now()\n  0\nend\n\ndef main() -> Int\n  take()\nend\n"
  let (e6_n, e6_e, e6_v, e6_i, e6_ok, e6_d) = infer_probe_channel_probe(case_e6)
  if e6_n == 0 && e6_ok then
    report = report + "TIME_BINDING E6 missing-Instant: WRONGLY accepted\n"
    fails = fails + 1
  elsif e6_v != 0 then
    report = report + "TIME_BINDING E6 missing-Instant: a fresh inference variable leaked (expr_var=" + e6_v.to_string() + ")\n"
    fails = fails + 1
  else
    report = report + "TIME_BINDING E6 PASS missing-Instant-reject errors=" + e6_n.to_string() + " expr_var=0 readiness=" + e6_ok.to_string() + " detail=" + e6_d.clone() + "\n"
  end
  report = report + "TIME_BINDING_BATTERY fails=" + fails.to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# RUNTIME_PARITY battery (Patch 4: kernel runtime parity).
#
# The kernel compiler has NO MIR interpreter (lib.tg: "tg_compiler has
# no MIR interpreter"; equivalence.tg's differential layer documents
# "requires a runner"), so the kernel-side observable is the strongest
# channel that proves the SAME value semantics as the seed VM's
# execution:
#
#   * DIMENSION=lowered_constants — the kernel's own lower_to_mir output
#     is inspected: the aggregate operand its struct-literal lowering
#     materialized for an omitted declared default (and the constant /
#     static-init chain that defines it) is decoded to the executed
#     value;
#   * DIMENSION=channel_identity — the checker/lowering IDENTITY record:
#     the recorded GbConst the default's declared name resolves to and
#     the MirStaticRef consuming it, two same-named mutable statics
#     lowering to DISTINCT static identities, the solved callable
#     instance / intrinsic stamp of a same-named private-intrinsic
#     spelling, or the concrete solved generic channels (no Type::Var /
#     Type::Error before readiness).
#
# Each row reports its dimension and observable explicitly.  The OCaml
# lane (stage0_ocaml/selfcheck/tg_kernel_runtime_parity.ml) writes the
# case sources to build/runtime_parity_cases.txt; this battery
# byte-compares its embedded sources against that file (drift is a hard
# failure) and asserts every kernel observable against the expected
# token shared with the OCaml lane.  fails=0 is asserted by tg_infer.
# ———————————————————————————————————————————————————————————————
struct KrpCaseFile
  kind: String
  name: String
  body: String
end

struct KrpCase
  label: String
  kind: String
  names: Vec[String]
  files: Vec[KrpCaseFile]
  dimension: String
  expected: String
end

# the decoded value of a kernel MIR operand chain.  KrpStatic keeps the
# static's identity; the numeric value is resolved through the lowered
# program's MirStatic.init (the same declaration the seed executes).
enum KrpVal
  KrpInt(Int)
  KrpStr(String)
  KrpStatic(Int)
  KrpUnknown(String)
end

enum KrpLowered
  KrpLowerOk(Program, AnalyzedProgram, MirProgram)
  KrpLowerErr(String)
end

struct KrpStaticWrite
  value: Int
  target_def: Int
  module_path: String
end

def infer_probe_krp_find_fn_index(mir: MirProgram, name: String) -> Option[Int]
  var i = 0
  while i < mir.functions.len() do
    let f = mir.functions[i]
    if f.name == name || f.name.ends_with("::" + name) then
      return Option::Some(i)
    end
    i = i + 1
  end
  Option::None
end

def infer_probe_krp_defining_rvalue(f: MirFunction, lid: Int) -> Option[MirRvalue]
  var found: Option[MirRvalue] = Option::None
  var bi = 0
  while bi < f.blocks.len() do
    let blk = f.blocks[bi]
    var si = 0
    while si < blk.statements.len() do
      let st = blk.statements[si]
      match st.kind
      when MirStatementKind::MirAssign(place, rv) then
        if place.local.id == lid && place.projections.is_empty() then
          found = Option::Some(rv.clone())
        end
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  found
end

def infer_probe_krp_static_value(mir: MirProgram, did_num: Int) -> Option[Int]
  var i = 0
  while i < mir.statics.len() do
    let st = mir.statics[i]
    match st.def_id
    when Option::Some(did) then
      if def_id_numeric(&did) == did_num then
        match st.init
        when Option::Some(op) then
          match op.kind
          when MirOperandKind::MirConstant(c) then
            match c.kind
            when MirConstantKind::MirInt(n) then return Option::Some(n)
            when _ then ()
            end
          when _ then ()
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
    i = i + 1
  end
  Option::None
end

def infer_probe_krp_force_int(mir: MirProgram, v: KrpVal) -> Option[Int]
  match v
  when KrpInt(n) then Option::Some(n)
  when KrpStatic(d) then infer_probe_krp_static_value(mir, d)
  when _ then Option::None
  end
end

def infer_probe_krp_binop(op: MirBinOp, a: Int, b: Int) -> Int
  match op
  when MirBinOp::Add then a + b
  when MirBinOp::Sub then a - b
  when MirBinOp::Mul then a * b
  when MirBinOp::Div then if b == 0 then 0 else a / b end
  when MirBinOp::Mod then if b == 0 then 0 else a % b end
  when MirBinOp::BitAnd then a & b
  when MirBinOp::BitOr then a | b
  when MirBinOp::BitXor then a ^ b
  when MirBinOp::Shl then a << b
  when MirBinOp::Shr then a >> b
  when MirBinOp::Eq then if a == b then 1 else 0 end
  when MirBinOp::Ne then if a != b then 1 else 0 end
  when MirBinOp::Lt then if a < b then 1 else 0 end
  when MirBinOp::Le then if a <= b then 1 else 0 end
  when MirBinOp::Gt then if a > b then 1 else 0 end
  when MirBinOp::Ge then if a >= b then 1 else 0 end
  end
end

def infer_probe_krp_rvalue_tag(rv: MirRvalue) -> String
  match rv.kind
  when MirRvalueKind::MirMove(_) then "move"
  when MirRvalueKind::MirAggregate(_, _) then "aggregate"
  when MirRvalueKind::MirBinOp(_, _, _) then "binop"
  when MirRvalueKind::MirUnOp(_, _) then "unop"
  when MirRvalueKind::MirDiscriminant(_) then "discriminant"
  when MirRvalueKind::MirLen(_) then "len"
  when MirRvalueKind::MirCast(_, _, _) then "cast"
  when MirRvalueKind::MirRepeat(_, _) then "repeat"
  when MirRvalueKind::MirRef(_) then "ref"
  when _ then "other"
  end
end

def infer_probe_krp_rvalue(mir: MirProgram, f: MirFunction, rv: MirRvalue, depth: Int) -> KrpVal
  if depth > 40 then
    return KrpUnknown("depth")
  end
  match rv.kind
  when MirRvalueKind::MirMove(op) then infer_probe_krp_operand(mir, f, op, depth + 1)
  when MirRvalueKind::MirBinOp(op, l, r) then
    let lv = infer_probe_krp_operand(mir, f, l, depth + 1)
    let rvv = infer_probe_krp_operand(mir, f, r, depth + 1)
    match infer_probe_krp_force_int(mir, lv)
    when Option::Some(a) then
      match infer_probe_krp_force_int(mir, rvv)
      when Option::Some(b) then KrpInt(infer_probe_krp_binop(op, a, b))
      when Option::None then KrpUnknown("rhs:" + infer_probe_krp_render(rvv))
      end
    when Option::None then KrpUnknown("lhs:" + infer_probe_krp_render(lv))
    end
  when MirRvalueKind::MirUnOp(op, o) then
    match infer_probe_krp_force_int(mir, infer_probe_krp_operand(mir, f, o, depth + 1))
    when Option::Some(a) then
      match op
      when MirUnOp::Neg then KrpInt(0 - a)
      when MirUnOp::Not then
        if a == 0 then KrpInt(1) else KrpInt(0) end
      when MirUnOp::BitNot then KrpInt(0 - a - 1)
      end
    when Option::None then KrpUnknown("unop")
    end
  when MirRvalueKind::MirCast(_kind, o, _ty) then infer_probe_krp_operand(mir, f, o, depth + 1)
  when _ then KrpUnknown("rvalue")
  end
end

def infer_probe_krp_operand(mir: MirProgram, f: MirFunction, op: MirOperand, depth: Int) -> KrpVal
  if depth > 40 then
    return KrpUnknown("depth")
  end
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirInt(n) then KrpInt(n)
    when MirConstantKind::MirBool(b) then
      if b then KrpInt(1) else KrpInt(0) end
    when MirConstantKind::MirString(s) then KrpStr(s)
    when MirConstantKind::MirStaticRef(did) then KrpStatic(def_id_numeric(&did))
    when _ then KrpUnknown("const")
    end
  when MirOperandKind::MirCopy(place) then infer_probe_krp_place(mir, f, place, depth + 1)
  when MirOperandKind::MirMovePlace(place) then infer_probe_krp_place(mir, f, place, depth + 1)
  when MirOperandKind::MirRead(place) then infer_probe_krp_place(mir, f, place, depth + 1)
  when MirOperandKind::MirConsume(place) then infer_probe_krp_place(mir, f, place, depth + 1)
  end
end

def infer_probe_krp_place(mir: MirProgram, f: MirFunction, place: Place, depth: Int) -> KrpVal
  if depth > 40 then
    return KrpUnknown("depth")
  end
  if place.projections.is_empty() then
    match infer_probe_krp_defining_rvalue(f, place.local.id)
    when Option::Some(rv) then infer_probe_krp_rvalue(mir, f, rv, depth + 1)
    when Option::None then KrpUnknown("no-def:" + place.local.id.to_string())
    end
  elsif place.projections.len() == 1 then
    match place.projections[0]
    when Projection::Field(fid) then
      match infer_probe_krp_defining_rvalue(f, place.local.id)
      when Option::Some(rv) then
        match rv.kind
        when MirRvalueKind::MirAggregate(_kind, ops) then
          if fid.index >= 0 && fid.index < ops.len() then
            infer_probe_krp_operand(mir, f, ops[fid.index].clone(), depth + 1)
          else
            KrpUnknown("field-range")
          end
        when _ then KrpUnknown("not-agg:" + infer_probe_krp_rvalue_tag(rv))
        end
      when Option::None then KrpUnknown("no-def-field:" + place.local.id.to_string())
      end
    when _ then KrpUnknown("proj")
    end
  else
    KrpUnknown("multi-proj")
  end
end

def infer_probe_krp_render(v: KrpVal) -> String
  match v
  when KrpInt(n) then "int:" + n.to_string()
  when KrpStr(s) then "str:" + s.clone()
  when KrpStatic(d) then "static:" + d.to_string()
  when KrpUnknown(r) then "unknown:" + r.clone()
  end
end

def infer_probe_krp_type_name(mir: MirProgram, tid_num: Int) -> String
  var i = 0
  while i < mir.types.len() do
    if mir.types[i].id.id == tid_num then
      return mir.types[i].name.clone()
    end
    i = i + 1
  end
  ""
end

# the materialized operand for `struct_name.field_name` in `fn_name`'s
# lowered body: the struct-literal aggregate's field operand, decoded.
def infer_probe_krp_struct_field(mir: MirProgram, fn_name: String, struct_name: String, field_name: String) -> Option[KrpVal]
  match infer_probe_krp_find_fn_index(mir, fn_name)
  when Option::None then Option::None
  when Option::Some(fi) then
    let f = mir.functions[fi]
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      var si = 0
      while si < blk.statements.len() do
        let st = blk.statements[si]
        match st.kind
        when MirStatementKind::MirAssign(_place, rv) then
          match rv.kind
          when MirRvalueKind::MirAggregate(kind, ops) then
            match kind
            when AggregateKind::Struct(tid, names) then
              if infer_probe_krp_type_name(mir, tid.id) == struct_name then
                var nfi = 0
                while nfi < names.len() do
                  if names[nfi] == field_name && nfi < ops.len() then
                    return Option::Some(infer_probe_krp_operand(mir, f, ops[nfi].clone(), 0))
                  end
                  nfi = nfi + 1
                end
              end
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
        si = si + 1
      end
      bi = bi + 1
    end
    Option::None
  end
end

# the payload operand of the `enum_name` construction with tag `disc`
# (payload index 0) in `fn_name`'s lowered body.
def infer_probe_krp_enum_payload(mir: MirProgram, fn_name: String, enum_name: String, disc: Int) -> Option[KrpVal]
  match infer_probe_krp_find_fn_index(mir, fn_name)
  when Option::None then Option::None
  when Option::Some(fi) then
    let f = mir.functions[fi]
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      var si = 0
      while si < blk.statements.len() do
        let st = blk.statements[si]
        match st.kind
        when MirStatementKind::MirAssign(_place, rv) then
          match rv.kind
          when MirRvalueKind::MirAggregate(kind, ops) then
            match kind
            when AggregateKind::Struct(tid, names) then
              if infer_probe_krp_type_name(mir, tid.id) == enum_name && ops.len() >= 2 then
                let tag = infer_probe_krp_force_int(mir, infer_probe_krp_operand(mir, f, ops[0].clone(), 0))
                match tag
                when Option::Some(d) then
                  if d == disc then
                    return Option::Some(infer_probe_krp_operand(mir, f, ops[1].clone(), 0))
                  end
                when Option::None then ()
                end
              end
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
        si = si + 1
      end
      bi = bi + 1
    end
    Option::None
  end
end

# the checker-recorded GbConst DefId for `struct_name.field_name`'s
# default expression (its declaration-scope binding identity).
def infer_probe_krp_default_rhs_node(program: Program, struct_name: String, field_name: String) -> Int
  for item in program.items do
    match item.kind
    when ItemKind::ItemStruct(sd) then
      if sd.name == struct_name then
        for f in sd.fields do
          if f.name == field_name then
            match f.default
            when Option::Some(e) then
              match e.kind
              when ExprKind::ExprIdent(_) then return e.node_id
              when ExprKind::ExprBinaryOp(_op, _lhs, rhs) then
                match rhs.get().kind
                when ExprKind::ExprIdent(_) then return rhs.get().node_id
                when _ then ()
                end
              when _ then ()
              end
            when Option::None then ()
            end
          end
        end
      end
    when _ then ()
    end
  end
  -1
end

def infer_probe_krp_analyze_lower(program: Program, label: String) -> KrpLowered
  match resolve_names(program)
  when Result::Err(errs) then KrpLowerErr("resolve=" + errs.len().to_string())
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    var prog = program
    match analyze_parsed(&mut env, &mut prog, default_options())
    when Result::Err(diags) then
      var first = "-"
      if diags.len() > 0 then first = diags[0].message.clone() end
      KrpLowerErr("analyze=" + diags.len().to_string() + ":" + first.clone())
    when Result::Ok(analyzed) then
      match lower_to_mir(&prog, &analyzed)
      when Result::Err(e) then KrpLowerErr("lower: " + e.clone())
      when Result::Ok(mir) then KrpLowerOk(prog, analyzed, mir)
      end
    end
  end
end

def infer_probe_krp_lower_one(source: String, label: String) -> KrpLowered
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    var first = "-"
    if parsed.diagnostics.len() > 0 then first = parsed.diagnostics[0].message.clone() end
    return KrpLowerErr("parse: " + first.clone())
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  infer_probe_krp_analyze_lower(program, label)
end

def infer_probe_krp_multi_program(label: String, names: Vec[String], sources: Vec[String]) -> Result[Program, String]
  var items = Vec::new()
  var modules: Map[ModuleId, Module] = Map::new()
  var i = 0
  while i < names.len() do
    let parsed = parse(tokenize(sources[i].clone(), label.clone() + "::" + names[i].clone()))
    if diag_has_errors(&parsed.diagnostics) then
      var first = "parse"
      if parsed.diagnostics.len() > 0 then first = parsed.diagnostics[0].message.clone() end
      return Result::Err(names[i].clone() + ":" + first.clone())
    end
    var mid = ModuleId { id: i }
    var start = items.len()
    for item in parsed.program.items do
      var owned = item.clone()
      owned.owner_module = ModuleId { id: mid.id }
      items.push(owned)
    end
    var mod_items = Vec::new()
    var k = start
    while k < items.len() do
      mod_items.push(ItemId { id: k })
      k = k + 1
    end
    var mod_imports = Vec::new()
    for item in parsed.program.items do
      match item.kind
      when ItemKind::ItemUse(u) then mod_imports.push(u.path.segments.join("::"))
      when _ then ()
      end
    end
    modules.insert(mid, Module {
      id: mid,
      path: names[i].clone().split("::"),
      items: mod_items,
      imports: mod_imports
    })
    i = i + 1
  end
  Result::Ok(Program {
    items: items,
    crate: Crate { root: ModuleId { id: 0 }, modules: modules },
    span: Span { file: label.clone(), start: 0, end_pos: 0 }
  })
end

def infer_probe_krp_lower_multi(names: Vec[String], sources: Vec[String], label: String) -> KrpLowered
  match infer_probe_krp_multi_program(label, names, sources)
  when Result::Err(e) then KrpLowerErr("parse:" + e.clone())
  when Result::Ok(program0) then
    var program = program0
    assign_node_ids(&mut program)
    infer_probe_krp_analyze_lower(program, label)
  end
end

# —————— per-case observation ——————

def infer_probe_krp_nospace(s: String) -> String
  s.split(" ").join("_")
end

# k8 diagnostic: the lowered `main` locals and call frames (intrinsic id,
# callee name, solved instance args) — reveals where the unannotated
# `Vec::new()` element identity actually lands in the kernel's lowering.
def infer_probe_krp_vec_diag(env: TypeEnv, mir: MirProgram) -> String
  match infer_probe_krp_find_fn_index(mir, "main")
  when Option::None then "blocked:no-main"
  when Option::Some(fi) then
    let f = mir.functions[fi]
    var s = "locals:"
    for l in f.locals do
      s = s + l.name.clone() + "=" + infer_probe_krp_nospace(type_display(&env, l.ty.clone())) + "|"
    end
    s = s + ",calls:"
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      match blk.terminator.kind
      when MirTerminatorKind::MirCall { dest: _, func, args: _, success: _, unwind: _, intrinsic, tail: _ } then
        s = s + "intr="
        match intrinsic
        when Option::Some(i) then s = s + i.to_string()
        when Option::None then s = s + "-"
        end
        s = s + ",fn="
        match func.kind
        when MirOperandKind::MirConstant(c) then
          match c.kind
          when MirConstantKind::MirFnItem(nm) then s = s + infer_probe_krp_nospace(nm.clone())
          when _ then s = s + "?"
          end
          s = s + ",inst="
          match c.instance
          when Option::Some(inst) then
            var ai = 0
            while ai < inst.args.len() do
              s = s + infer_probe_krp_nospace(infer_probe_krp_arg_display(inst.args[ai].clone())) + "|"
              ai = ai + 1
            end
          when Option::None then s = s + "-"
          end
        when _ then s = s + "?"
        end
        s = s + ";"
      when _ then ()
      end
      bi = bi + 1
    end
    s
  end
end

def infer_probe_krp_single_token(label: String, program: Program, analyzed: AnalyzedProgram, mir: MirProgram) -> String
  if label == "simple_field_default" then
    match infer_probe_krp_struct_field(mir, "main", "S", "n")
    when Option::Some(v) then infer_probe_krp_render(v)
    when Option::None then "blocked:no-aggregate-operand"
    end
  elsif label == "local_shadow_field_default" then
    let node = infer_probe_krp_default_rhs_node(program, "S", "n")
    if node < 0 then
      return "blocked:no-default-node"
    end
    match analyzed.typed.global_bindings.get(node)
    when Option::Some(binding) then
      match binding
      when GlobalBinding::GbConst(did) then
        let want = def_id_numeric(&did)
        match infer_probe_krp_struct_field(mir, "main", "S", "n")
        when Option::Some(v) then
          match v
          when KrpStatic(got) then
            if got != want then
              "mismatch:identity=" + got.to_string() + "!=" + want.to_string()
            else
              match infer_probe_krp_static_value(mir, got)
              when Option::Some(n) then "gbconst:" + n.to_string()
              when Option::None then "blocked:static-init"
              end
            end
          when _ then "mismatch:not-static:" + infer_probe_krp_render(v)
          end
        when Option::None then "blocked:no-aggregate-operand"
        end
      when _ then "blocked:not-gbconst"
      end
    when Option::None then "blocked:no-recorded-binding"
    end
  elsif label == "nested_field_default" then
    match infer_probe_krp_struct_field(mir, "main", "Outer", "n")
    when Option::Some(v) then infer_probe_krp_render(v)
    when Option::None then "blocked:no-aggregate-operand"
    end
  elsif label == "enum_payload_match" then
    match infer_probe_krp_enum_payload(mir, "main", "E", 0)
    when Option::Some(v) then infer_probe_krp_render(v)
    when Option::None then "blocked:no-enum-payload"
    end
  elsif label == "owning_field_default" then
    match infer_probe_krp_struct_field(mir, "main", "Holder", "n")
    when Option::Some(nv) then
      match infer_probe_krp_struct_field(mir, "main", "Holder", "text")
      when Option::Some(tv) then
        match nv
        when KrpInt(n) then
          match tv
          when KrpStr(s) then
            if s.len() == 1 then "int:" + n.to_string() else "mismatch:strlen=" + s.len().to_string() end
          when _ then "mismatch:text=" + infer_probe_krp_render(tv)
          end
        when _ then "mismatch:n=" + infer_probe_krp_render(nv)
        end
      when Option::None then "blocked:no-text-operand"
      end
    when Option::None then "blocked:no-n-operand"
    end
  elsif label == "generic_vec_new_inference" then
    infer_probe_krp_vec_diag(analyzed.engine_snapshot.clone(), mir)
  elsif label == "private_intrinsic_same_name" then
    infer_probe_krp_user_call_token(mir)
  else
    "blocked:unknown-single"
  end
end

def infer_probe_krp_multi_token(label: String, program: Program, analyzed: AnalyzedProgram, mir: MirProgram) -> String
  let _ = analyzed;
  if label == "imported_aliased_default" then
    match infer_probe_krp_struct_field(mir, "main", "S", "n")
    when Option::Some(nv) then
      match infer_probe_krp_struct_field(mir, "main", "T", "m")
      when Option::Some(mv) then
        match nv
        when KrpStatic(nd) then
          match mv
          when KrpStatic(md) then
            if nd != md then
              "mismatch:alias-identity=" + nd.to_string() + "!=" + md.to_string()
            else
              match infer_probe_krp_static_value(mir, nd)
              when Option::Some(n) then "gbconst:" + (n * 10 + n).to_string()
              when Option::None then "blocked:static-init"
              end
            end
          when _ then "mismatch:m-not-static:" + infer_probe_krp_render(mv)
          end
        when _ then "mismatch:n-not-static:" + infer_probe_krp_render(nv)
        end
      when Option::None then "blocked:no-m-operand"
      end
    when Option::None then "blocked:no-n-operand"
    end
  elsif label == "duplicate_module_static_write" then
    infer_probe_krp_statics_token(program, mir)
  else
    "blocked:unknown-multi"
  end
end

# k10: the user function's call must lower as an ordinary resolved call
# (intrinsic stamp absent, a solved callable instance whose DefId names a
# lowered body carrying the `+ 6` constant) — never the private intrinsic.
def infer_probe_krp_fn_has_int(f: MirFunction, want: Int) -> Bool
  var found = false
  var bi = 0
  while bi < f.blocks.len() do
    let blk = f.blocks[bi]
    var si = 0
    while si < blk.statements.len() do
      let st = blk.statements[si]
      match st.kind
      when MirStatementKind::MirAssign(_place, rv) then
        if infer_probe_krp_rvalue_has_int(rv, want) then found = true end
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  found
end

def infer_probe_krp_rvalue_has_int(rv: MirRvalue, want: Int) -> Bool
  match rv.kind
  when MirRvalueKind::MirMove(op) then infer_probe_krp_operand_has_int(op, want)
  when MirRvalueKind::MirBinOp(_op, l, r) then
    infer_probe_krp_operand_has_int(l, want) || infer_probe_krp_operand_has_int(r, want)
  when MirRvalueKind::MirUnOp(_op, o) then infer_probe_krp_operand_has_int(o, want)
  when MirRvalueKind::MirCast(_k, o, _t) then infer_probe_krp_operand_has_int(o, want)
  when MirRvalueKind::MirAggregate(_kind, ops) then
    var found = false
    for o in ops do
      if infer_probe_krp_operand_has_int(o, want) then found = true end
    end
    found
  when _ then false
  end
end

def infer_probe_krp_operand_has_int(op: MirOperand, want: Int) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirInt(n) then n == want
    when _ then false
    end
  when _ then false
  end
end

def infer_probe_krp_user_call_token(mir: MirProgram) -> String
  match infer_probe_krp_find_fn_index(mir, "main")
  when Option::None then "blocked:no-main"
  when Option::Some(fi) then
    let f = mir.functions[fi]
    var found = false
    var intrinsic_some = false
    var inst_present = false
    var callee_def = -1
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      match blk.terminator.kind
      when MirTerminatorKind::MirCall { dest: _, func, args: _, success: _, unwind: _, intrinsic, tail: _ } then
        found = true
        match intrinsic
        when Option::Some(_) then intrinsic_some = true
        when Option::None then ()
        end
        match func.kind
        when MirOperandKind::MirConstant(c) then
          match c.instance
          when Option::Some(inst) then
            inst_present = true
            callee_def = def_id_numeric(&inst.def.def)
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
      bi = bi + 1
    end
    if !found then
      "blocked:no-call"
    elsif intrinsic_some then
      "mismatch:intrinsic-stamp"
    elsif !inst_present then
      "mismatch:no-instance"
    else
      var target_found = false
      var has_six = false
      var fi2 = 0
      while fi2 < mir.functions.len() do
        match mir.functions[fi2].callable
        when Option::Some(cb) then
          if def_id_numeric(&cb.def) == callee_def then
            target_found = true
            if infer_probe_krp_fn_has_int(mir.functions[fi2], 6) then has_six = true end
          end
        when Option::None then ()
        end
        fi2 = fi2 + 1
      end
      if !target_found then
        "blocked:no-target-body"
      elsif !has_six then
        "mismatch:no-body-constant"
      else
        "user_call_intrinsic=none"
      end
    end
  end
end

# k5: every static write in the lowered program, with its module path —
# the module path comes from the STORE'S OWN MirStaticAddr DefId (the
# semantic identity the checker recorded), never from a name-derived
# lookup of MirStatic.def_id (the root module's static registration can
# legitimately omit it).
def infer_probe_krp_place_base_static(f: MirFunction, place: Place, program: Program) -> Option[(Int, String)]
  if place.projections.len() != 1 then
    return Option::None
  end
  match place.projections[0]
  when Projection::ProjDeref then
    match infer_probe_krp_defining_rvalue(f, place.local.id)
    when Option::Some(rv) then
      match rv.kind
      when MirRvalueKind::MirMove(op) then
        match op.kind
        when MirOperandKind::MirConstant(c) then
          match c.kind
          when MirConstantKind::MirStaticAddr(did) then
            let mod_path = crate_module_path_of(program, &did.module).join("::")
            Option::Some((def_id_numeric(&did), mod_path))
          when _ then Option::None
          end
        when _ then Option::None
        end
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def infer_probe_krp_rvalue_const_int(rv: MirRvalue) -> Option[Int]
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirInt(n) then Option::Some(n)
      when _ then Option::None
      end
    when _ then Option::None
    end
  when _ then Option::None
  end
end

def infer_probe_krp_stmt_write(stmt: MirStatement, f: MirFunction, mir: MirProgram, program: Program) -> Option[KrpStaticWrite]
  match stmt.kind
  when MirStatementKind::MirAssign(place, rv) then
    match infer_probe_krp_place_base_static(f, place, program)
    when Option::Some(target) then
      match infer_probe_krp_force_int(mir, infer_probe_krp_rvalue(mir, f, rv, 0))
      when Option::Some(v) then
        Option::Some(KrpStaticWrite { value: v, target_def: target.0, module_path: target.1.clone() })
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def infer_probe_krp_statics_token(program: Program, mir: MirProgram) -> String
  var writes: Vec[KrpStaticWrite] = Vec::new()
  var fi = 0
  while fi < mir.functions.len() do
    let f = mir.functions[fi]
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      var si = 0
      while si < blk.statements.len() do
        match infer_probe_krp_stmt_write(blk.statements[si].clone(), f, mir, program)
        when Option::Some(w) then writes.push(w)
        when Option::None then ()
        end
        si = si + 1
      end
      bi = bi + 1
    end
    fi = fi + 1
  end
  var e11a = false
  var e22b = false
  var def11 = -1
  var def22 = -1
  for w in writes do
    if w.value == 11 then
      if w.module_path == "a" then
        e11a = true
        def11 = w.target_def
      end
    end
    if w.value == 22 then
      if w.module_path == "b" then
        e22b = true
        def22 = w.target_def
      end
    end
  end
  var seen = ""
  for w in writes do
    seen = seen + w.value.to_string() + "@" + w.module_path.clone() + ";"
  end
  if !e11a then
    "mismatch:no-11-write-to-a:seen=[" + seen.clone() + "]"
  elsif !e22b then
    "mismatch:no-22-write-to-b:seen=[" + seen.clone() + "]"
  elsif def11 == def22 then
    "mismatch:aliased-slots"
  else
    "writes:11@a,22@b_distinct"
  end
end

# k8/k9: the concrete solved generic channels + readiness (no Type::Var /
# Type::Error before readiness), plus the solved call-instance identity.
def infer_probe_krp_arg_display(a: GenericArg) -> String
  match a
  when GenericArg::Type(t) then type_display(engine_env_empty(), t.clone())
  when GenericArg::Const(_) then "const"
  end
end

def infer_probe_krp_is_vec_int(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if args.len() == 1 && args[0] == Type::Int && (tid.id == env.lang_items.vec || tid.id == env.lang_items.array) then
      true
    else
      false
    end
  when _ then false
  end
end

def infer_probe_krp_is_map_si(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if args.len() == 2 && tid.id == env.lang_items.map then
      if args[1] == Type::Int && args[0] == Type::String then true else false end
    else
      false
    end
  when _ then false
  end
end

def infer_probe_krp_is_set_int(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if args.len() == 1 && args[0] == Type::Int && tid.id == env.lang_items.set then true else false end
  when _ then false
  end
end

def infer_probe_krp_channel_token(source: String, label: String) -> String
  let parsed = parse(tokenize(source.clone(), label.clone()))
  if diag_has_errors(&parsed.diagnostics) then
    return "blocked:parse"
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    "blocked:resolve=" + errs.len().to_string()
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() != 0 then
      return "blocked:check=" + result.errors.len().to_string() + ":" + result.errors[0].message.clone()
    end
    var expr_err = 0
    var expr_var = 0
    for (_nid, ty) in env.typed_expr_types.entries() do
      if infer_probe_type_has_error_state(ty.clone()) then expr_err = expr_err + 1 end
      if infer_probe_has_var(ty.clone()) then expr_var = expr_var + 1 end
    end
    let readiness = verify_typed_channel_completeness(&mut env, &program)
    if !readiness || expr_err != 0 || expr_var != 0 then
      return "blocked:channels=err" + expr_err.to_string() + ",var" + expr_var.to_string() + ",readiness" + readiness.to_string()
    end
    var vec_int = false
    var map_si = false
    var set_int = false
    var seen = ""
    let expr_entries = env.typed_expr_types.entries()
    var ii = 0
    while ii < expr_entries.len() do
      let t = expr_entries[ii].1.clone()
      if infer_probe_krp_is_vec_int(&env, t.clone()) then vec_int = true end
      if infer_probe_krp_is_map_si(&env, t.clone()) then map_si = true end
      if infer_probe_krp_is_set_int(&env, t.clone()) then set_int = true end
      seen = seen + type_display(&env, t.clone()) + ";"
      ii = ii + 1
    end
    # the local bindings are the SOLVED channel for an unannotated
    # `var v = Vec::new()` whose constructor expression keeps the
    # pre-solution element (the later push/len receiver drives the
    # unification) — the kernel must record the concrete element identity
    # on the binding, exactly the type the seed's inference materializes.
    let local_entries = env.typed_local_bindings.entries()
    var li = 0
    while li < local_entries.len() do
      let t = local_entries[li].1.ty.clone()
      if infer_probe_krp_is_vec_int(&env, t.clone()) then vec_int = true end
      if infer_probe_krp_is_map_si(&env, t.clone()) then map_si = true end
      if infer_probe_krp_is_set_int(&env, t.clone()) then set_int = true end
      seen = seen + "local:" + type_display(&env, t.clone()) + ";"
      li = li + 1
    end
    # the typed expression records are the second solved channel (the
    # checker's per-node resolved types after the fixpoint; a receiver
    # `v` in `v.push(1)` is recorded here even when the constructor
    # expression retained its pre-solution view).
    let typed_expr_entries = env.typed_exprs.entries()
    var ti = 0
    while ti < typed_expr_entries.len() do
      let t = typed_expr_entries[ti].1.ty.clone()
      if infer_probe_krp_is_vec_int(&env, t.clone()) then vec_int = true end
      if infer_probe_krp_is_map_si(&env, t.clone()) then map_si = true end
      if infer_probe_krp_is_set_int(&env, t.clone()) then set_int = true end
      seen = seen + "expr:" + type_display(&env, t.clone()) + ";"
      ti = ti + 1
    end
    if label == "generic_vec_new_inference" then
      if vec_int then "vec_new_elem=Int" else "mismatch:no-Int-instance:seen=" + seen.clone() end
    elsif label == "map_set_construct_lookup" then
      if map_si && set_int then "map_new=String,Int" else "mismatch:no-String-Int-instance:seen=" + seen.clone() end
    else
      "blocked:unknown-channels"
    end
  end
end

# —————— k8 std-informed channel ——————
# The standalone probe surface carries the builtin container tables but
# NOT the std impls, so an unannotated `Vec::new()` there is answered by
# the builtin surface alone (no impl receiver unification): the lowered
# local stays `[Never]` and the calls carry no solved instance — NOT the
# kernel's real semantics when std is present (the seed lane executes the
# same case with the real 14-file std closure).  The faithful kernel
# context is a program carrying the REAL std files read from the repo
# plus the case, prepared exactly like the compile path
# (apply_cfg_elimination + prepare_parsed -> resolve_names ->
# type_check_typed); the observable is the case-scoped solved channel
# identity, resolved through the checker's substitution.
#
# When the kernel checker cannot even construct that context (its own
# std prelude does not typecheck yet), the case is BLOCKED with the exact
# first kernel diagnostic — never silently skipped and never reported as
# a value divergence the context cannot support.
def infer_probe_krp_std_case_source() -> String
  "use std::collections::Vec\n\ndef vec_probe() -> Int\n  var v = Vec::new()\n  v.push(1)\n  v.len()\nend\n\ndef main() -> Int\n  vec_probe()\nend\n"
end

def infer_probe_krp_std_read(rel: String) -> Option[String]
  match read_file(rel.clone())
  when Result::Ok(s) then Option::Some(s)
  when Result::Err(_) then Option::None
  end
end

def infer_probe_krp_scoped(env: TypeEnv, nid: Int) -> Bool
  match env.typed_node_spans.get(nid)
  when Option::Some(sp) then sp.file.contains("krp_channels")
  when Option::None then false
  end
end

def infer_probe_krp_std_vec_probe() -> (String, String)
  # EXACTLY mirror the live closure check's feeding of std (the merged
  # differential corpus path, infer_probe_run_merged): the case source is
  # the ROOT module and the prelude files are loaded through the same
  # collector (use-dependency recursion, @cfg item filter, debug_assert
  # stripping) in the same order, then the SAME canonical preparation
  # (apply_cfg_elimination + prepare_parsed) and the REAL kernel checker
  # run.  The observable is the case-scoped (span file "krp_channels")
  # solved channel identity after the checker's substitution plus the
  # readiness gate: the element identity the seed's inference materializes
  # and the no-Var/no-Error channel state.  Returns (token, detail).
  let src = infer_probe_strip_debug_assert(infer_probe_krp_std_case_source())
  let parsed = parse(tokenize(src.clone(), "krp_channels"))
  if diag_has_errors(&parsed.diagnostics) then
    return ("blocked:std-case-parse", "case_parse_failed")
  end
  var merged_items = Vec::new()
  for item in parsed.program.items do
    if infer_probe_item_active(item.clone()) then merged_items.push(item.clone()) end
  end
  var root_items = Vec::new()
  var ri = 0
  while ri < merged_items.len() do
    root_items.push(ItemId { id: ri })
    ri = ri + 1
  end
  let root_id = ModuleId { id: 0 }
  var merged_modules: Map[ModuleId, Module] = Map::new()
  merged_modules.insert(root_id, Module {
    id: root_id,
    path: Vec::new(),
    items: root_items,
    imports: Vec::new()
  })
  var loaded: Set[String] = Set::new()
  let preludes = ["std/alloc.tg", "std/collections.tg", "std/core.tg", "std/ffi.tg", "std/fmt.tg", "std/fs.tg", "std/io.tg", "std/taint.tg"]
  var pi = 0
  while pi < preludes.len() do
    let rc = infer_probe_collect_dep_file(preludes[pi].clone(), &mut merged_items, &mut loaded, &mut merged_modules)
    if rc != 0 then
      return ("blocked:std-load=" + rc.to_string() + ":" + infer_probe_krp_nospace(preludes[pi].clone()), "load_failed")
    end
    pi = pi + 1
  end
  var program = Program {
    items: merged_items,
    crate: Crate { root: root_id, modules: merged_modules },
    span: parsed.program.span.clone()
  }
  apply_cfg_elimination(&mut program, default_options())
  var macro_diags: Vec[Diagnostic] = Vec::new()
  prepare_parsed(&mut program, &mut macro_diags)
  if diag_has_errors(&macro_diags) then
    return ("blocked:std-macros=" + macro_diags.len().to_string(), "macro_prep_failed")
  end
  match resolve_names(program)
  when Result::Err(errs) then
    var rfirst = "-"
    if errs.len() > 0 then rfirst = errs[0].message.clone() end
    let tok = "blocked:std-resolve=" + errs.len().to_string() + ":" + infer_probe_krp_nospace(rfirst.clone())
    (tok.clone(), "resolve_failed")
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() != 0 then
      var first = "-"
      var fspan = "-"
      if result.errors.len() > 0 then
        first = result.errors[0].message.clone()
        fspan = result.errors[0].span.file.clone() + ":" + result.errors[0].span.start.to_string()
      end
      let tok = "blocked:std-check=" + result.errors.len().to_string() + ":" + infer_probe_krp_nospace(first.clone()) + "@" + infer_probe_krp_nospace(fspan.clone())
      (tok.clone(), "check_errors=" + result.errors.len().to_string())
    else
      # the readiness gate's fail-fast row: if the FIRST incomplete channel
      # is case-scoped (span file krp_channels) the case witness is
      # incomplete and must block; a prelude-only first failure is the
      # subset's business (the live closure's readiness gate runs over the
      # full closure), so the case-scoped channels remain the witness.
      let errs_before = env.errors.len()
      let readiness_ok = verify_typed_channel_completeness(&mut env, &program)
      var case_ready = true
      var ready_note = "readiness=true"
      if !readiness_ok then
        var rfp = "-"
        var rfile = "-"
        if env.errors.len() > errs_before then
          rfp = infer_probe_krp_nospace(env.errors[errs_before].message.clone())
          rfile = infer_probe_krp_nospace(env.errors[errs_before].span.file.clone())
        end
        if rfile.contains("krp_channels") then
          case_ready = false
        end
        ready_note = "readiness=false first=" + rfp.clone() + "@" + rfile.clone()
      end
      if !case_ready then
        return ("blocked:std-readiness", ready_note.clone())
      end
      var vec_ok = false
      var bad = 0
      var seen = ""
      var matched = ""
      var nmatched = 0
      let entries1 = env.typed_local_bindings.entries()
      var e1 = 0
      while e1 < entries1.len() do
        let nid = entries1[e1].0
        let t = resolve_type_var(&env, entries1[e1].1.ty.clone())
        if infer_probe_krp_scoped(&env, nid) then
          if infer_probe_krp_is_vec_int(&env, t.clone()) then
            vec_ok = true
            if nmatched < 4 then
              matched = matched + "local_" + entries1[e1].1.name.clone() + "=" + infer_probe_krp_nospace(type_display(&env, t.clone())) + " "
              nmatched = nmatched + 1
            end
          end
          if infer_probe_has_var(t.clone()) || infer_probe_type_has_error_state(t.clone()) then bad = bad + 1 end
          seen = seen + "L:" + infer_probe_krp_nospace(type_display(&env, t.clone())) + ";"
        end
        e1 = e1 + 1
      end
      let entries2 = env.typed_expr_types.entries()
      var e2 = 0
      while e2 < entries2.len() do
        let nid = entries2[e2].0
        let t = resolve_type_var(&env, entries2[e2].1.clone())
        if infer_probe_krp_scoped(&env, nid) then
          if infer_probe_krp_is_vec_int(&env, t.clone()) then
            vec_ok = true
            if nmatched < 4 then
              matched = matched + "expr=" + infer_probe_krp_nospace(type_display(&env, t.clone())) + " "
              nmatched = nmatched + 1
            end
          end
          if infer_probe_has_var(t.clone()) || infer_probe_type_has_error_state(t.clone()) then bad = bad + 1 end
          seen = seen + "E:" + infer_probe_krp_nospace(type_display(&env, t.clone())) + ";"
        end
        e2 = e2 + 1
      end
      if vec_ok && bad == 0 then
        ("vec_new_elem=Int", "check_errors=0 " + ready_note.clone() + " var_error_rows=" + bad.to_string() + " solved=[" + matched.clone() + "]")
      else
        ("mismatch:std-vec:seen=" + seen.clone(), "check_errors=0 " + ready_note.clone() + " var_error_rows=" + bad.to_string() + " seen=[" + seen.clone() + "]")
      end
    end
  end
end

def infer_probe_krp_observe(c: KrpCase, vec_token: String) -> String
  if c.kind == "single" then
    match infer_probe_krp_lower_one(c.files[0].body.clone(), c.label.clone())
    when KrpLowerOk(program, analyzed, mir) then infer_probe_krp_single_token(c.label.clone(), program, analyzed, mir)
    when KrpLowerErr(e) then "blocked:" + e.clone()
    end
  elsif c.kind == "multi" then
    var sources: Vec[String] = Vec::new()
    for f in c.files do
      if f.kind == "selfcheck" then sources.push(f.body.clone()) end
    end
    match infer_probe_krp_lower_multi(c.names.clone(), sources, c.label.clone())
    when KrpLowerOk(program, analyzed, mir) then infer_probe_krp_multi_token(c.label.clone(), program, analyzed, mir)
    when KrpLowerErr(e) then "blocked:" + e.clone()
    end
  elsif c.label == "generic_vec_new_inference" then
    vec_token.clone()
  else
    infer_probe_krp_channel_token(c.files[0].body.clone(), c.label.clone())
  end
end

# —————— the embedded corpus (byte-identical to the OCaml lane's
#         build/runtime_parity_cases.txt; drift is reported) ——————
def infer_probe_krp_one_file(kind: String, name: String, body: String) -> Vec[KrpCaseFile]
  var v: Vec[KrpCaseFile] = Vec::new()
  v.push(KrpCaseFile { kind: kind, name: name, body: body })
  v
end

def infer_probe_krp_two_files(a: KrpCaseFile, b: KrpCaseFile) -> Vec[KrpCaseFile]
  var v: Vec[KrpCaseFile] = Vec::new()
  v.push(a)
  v.push(b)
  v
end

def infer_probe_krp_cases() -> Vec[KrpCase]
  var cases: Vec[KrpCase] = Vec::new()
  cases.push(KrpCase {
    label: "simple_field_default",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "struct S\n  n: Int = 7\nend\n\ndef main() -> Int\n  let s = S {}\n  s.n\nend\n"),
    dimension: "lowered_constants",
    expected: "int:7"
  })
  cases.push(KrpCase {
    label: "local_shadow_field_default",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "const X: Int = 1\n\nstruct S\n  n: Int = X\nend\n\ndef main() -> Int\n  let X: Int = 99\n  let s = S {}\n  s.n\nend\n"),
    dimension: "channel_identity",
    expected: "gbconst:1"
  })
  cases.push(KrpCase {
    label: "nested_field_default",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "const X: Int = 1\n\nstruct Inner\n  v: Int = 2\nend\n\nstruct Outer\n  n: Int = Inner {}.v + X\nend\n\ndef main() -> Int\n  let X: Int = 99\n  let o = Outer {}\n  o.n\nend\n"),
    dimension: "lowered_constants",
    expected: "int:3"
  })
  cases.push(KrpCase {
    label: "imported_aliased_default",
    kind: "multi",
    names: vec!["stage0_ocaml::selfcheck::values", "stage0_ocaml::selfcheck::main"],
    files: infer_probe_krp_two_files(
      KrpCaseFile { kind: "selfcheck", name: "values.tg", body: "const X: Int = 7\n" },
      KrpCaseFile { kind: "selfcheck", name: "main.tg", body: "use stage0_ocaml::selfcheck::values::{X}\nuse stage0_ocaml::selfcheck::values::X as Y\n\nstruct S\n  n: Int = X\nend\n\nstruct T\n  m: Int = Y\nend\n\ndef main() -> Int\n  let s = S {}\n  let t = T {}\n  s.n * 10 + t.m\nend\n" }
    ),
    dimension: "channel_identity",
    expected: "gbconst:77"
  })
  cases.push(KrpCase {
    label: "duplicate_module_static_write",
    kind: "multi",
    names: vec!["a", "b"],
    files: infer_probe_krp_two_files(
      KrpCaseFile { kind: "selfcheck", name: "a.tg", body: "static mut CELL: Int = 10\n\ndef set() -> Int\n  CELL = 11\n  CELL\nend\n\ndef cell() -> Int = CELL\n" },
      KrpCaseFile { kind: "selfcheck", name: "b.tg", body: "static mut CELL: Int = 20\n\ndef set() -> Int\n  CELL = 22\n  CELL\nend\n\ndef cell() -> Int = CELL\n\ndef main() -> Int\n  let xa = a::set()\n  let xb = set()\n  let read_a = a::cell()\n  let read_b = cell()\n  xa * 1000000 + xb * 10000 + read_a * 100 + read_b\nend\n" }
    ),
    dimension: "channel_identity",
    expected: "writes:11@a,22@b_distinct"
  })
  cases.push(KrpCase {
    label: "enum_payload_match",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "enum E\n  Ready(Int)\n  Idle\nend\n\ndef main() -> Int\n  let e = E::Ready(4)\n  match e\n  when E::Ready(v) then v\n  when E::Idle then 0\n  end\nend\n"),
    dimension: "lowered_constants",
    expected: "int:4"
  })
  cases.push(KrpCase {
    label: "owning_field_default",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "struct Holder\n  n: Int = 7\n  text: String = \"d\"\nend\n\ndef main() -> Int\n  let h = Holder {}\n  if h.text.len() == 1 then h.n else 0 end\nend\n"),
    dimension: "lowered_constants",
    expected: "int:7"
  })
  cases.push(KrpCase {
    label: "generic_vec_new_inference",
    kind: "channels",
    names: Vec::new(),
    files: infer_probe_krp_one_file("selfcheck", "vec_case.tg", "def main() -> Int\n  var v = Vec::new()\n  v.push(1)\n  v.len()\nend\n"),
    dimension: "channel_identity",
    expected: "vec_new_elem=Int"
  })
  cases.push(KrpCase {
    label: "map_set_construct_lookup",
    kind: "channels",
    names: Vec::new(),
    files: infer_probe_krp_one_file("selfcheck", "map_case.tg", "def main() -> Int\n  var m: Map[String, Int] = Map::new()\n  let _old = m.insert(\"a\", 1)\n  let _old2 = m.insert(\"b\", 2)\n  var s: Set[Int] = Set::new()\n  let _i = s.insert(7)\n  let hit = m.contains_key(\"a\")\n  if hit && s.contains(7) then m.len() else 0 end\nend\n"),
    dimension: "channel_identity",
    expected: "map_new=String,Int"
  })
  cases.push(KrpCase {
    label: "private_intrinsic_same_name",
    kind: "single",
    names: Vec::new(),
    files: infer_probe_krp_one_file("single", "__root__.tg", "def __intrinsic_map_clone(v: Int) -> Int\n  v + 6\nend\n\ndef main() -> Int\n  __intrinsic_map_clone(1)\nend\n"),
    dimension: "channel_identity",
    expected: "user_call_intrinsic=none"
  })
  cases
end

# the cases-file byte-identity check: build/runtime_parity_cases.txt is
# written by tg_kernel_runtime_parity.ml; when present, every embedded
# source and expected token must match it byte-for-byte (drift is a hard
# failure).  Absent (a standalone tg_infer run) the embedded corpus is
# still fully asserted; the row reports no-file and is NOT a drift pass.
def infer_probe_krp_strip_prefix(line: String, prefix: String) -> String
  if line.starts_with(prefix.clone()) then
    line.slice(prefix.len(), line.len())
  else
    ""
  end
end

def infer_probe_krp_field_word(line: String, idx: Int) -> String
  let parts = line.split(" ")
  if idx >= 0 && idx < parts.len() then parts[idx].clone() else "" end
end

def infer_probe_krp_cases_file_check(cases: Vec[KrpCase], inout report: String) -> Int
  if !file_exists("build/runtime_parity_cases.txt") then
    report = report + "RUNTIME_PARITY SOURCES no-file cases=" + cases.len().to_string() + " (embedded corpus asserted; a standalone run cannot byte-compare against the OCaml lane)\n"
    return 0
  end
  let source = match read_file("build/runtime_parity_cases.txt")
  when Result::Ok(s) then s
  when Result::Err(_) then ""
  end
  var pos = 0
  let n = source.len()
  var checked = 0
  var fails = 0
  while pos < n do
    var le = pos
    while le < n && source.slice(le, le + 1) != "\n" do
      le = le + 1
    end
    let line = source.slice(pos, le)
    pos = if le < n then le + 1 else le end
    if line.starts_with("KRP_CASE ") then
      let label = infer_probe_krp_field_word(line.clone(), 1)
      let nfiles_s = infer_probe_krp_field_word(line.clone(), 2)
      let dimension = infer_probe_krp_field_word(line.clone(), 3)
      let token = infer_probe_krp_field_word(line.clone(), 4)
      let seed = infer_probe_krp_field_word(line.clone(), 5)
      var nfiles = 0
      match nfiles_s.parse_int()
      when Result::Ok(v) then nfiles = v
      when Result::Err(_) then ()
      end
      var matched_case = false
      for c in cases do
        if c.label == label then
          matched_case = true
          if c.dimension != dimension || c.expected != token then
            report = report + "RUNTIME_PARITY FILE drift " + label.clone() + ": dimension/token mismatch (embedded " + c.dimension.clone() + "/" + c.expected.clone() + " vs file " + dimension.clone() + "/" + token.clone() + ")\n"
            fails = fails + 1
          end
        end
      end
      if !matched_case then
        report = report + "RUNTIME_PARITY FILE unknown-case " + label.clone() + "\n"
        fails = fails + 1
      end
      var fi = 0
      while fi < nfiles do
        var hle = pos
        while hle < n && source.slice(hle, hle + 1) != "\n" do
          hle = hle + 1
        end
        let fline = source.slice(pos, hle)
        pos = if hle < n then hle + 1 else hle end
        if fline.starts_with("KRP_FILE ") then
          let kind = infer_probe_krp_field_word(fline.clone(), 1)
          let name = infer_probe_krp_field_word(fline.clone(), 2)
          let len_s = infer_probe_krp_field_word(fline.clone(), 3)
          var body_len = 0
          match len_s.parse_int()
          when Result::Ok(v2) then body_len = v2
          when Result::Err(_) then ()
          end
          var body = ""
          if body_len > 0 && pos + body_len <= n then
            body = source.slice(pos, pos + body_len)
          end
          pos = pos + body_len
          if pos < n && source.slice(pos, pos + 1) == "\n" then
            pos = pos + 1
          end
          if kind != "std" then
            var file_matched = false
            for c in cases do
              if c.label == label then
                for f in c.files do
                  if f.kind == kind && f.name == name then
                    file_matched = true
                    if f.body != body then
                      report = report + "RUNTIME_PARITY FILE drift " + label.clone() + ":" + name.clone() + ": source bytes differ from the embedded corpus\n"
                      fails = fails + 1
                    end
                  end
                end
              end
            end
            if !file_matched then
              report = report + "RUNTIME_PARITY FILE unknown-file " + label.clone() + ":" + name.clone() + "\n"
              fails = fails + 1
            end
          end
          checked = checked + 1
        end
        fi = fi + 1
      end
    end
  end
  report = report + "RUNTIME_PARITY SOURCES match=" + checked.to_string() + " drift_fails=" + fails.to_string() + "\n"
  fails
end

def infer_probe_krp_battery(inout report: String) -> Int
  var fails = 0
  let cases = infer_probe_krp_cases()
  fails = fails + infer_probe_krp_cases_file_check(cases.clone(), &mut report)
  let (krp_vec_token, krp_vec_detail) = infer_probe_krp_std_vec_probe()
  report = report + "RUNTIME_PARITY_DETAIL generic_vec_new_inference " + krp_vec_detail.clone() + "\n"
  var blocked = 0
  var i = 0
  while i < cases.len() do
    let c = cases[i]
    let obs = infer_probe_krp_observe(c.clone(), krp_vec_token.clone())
    if obs.starts_with("blocked:") then
      report = report + "RUNTIME_PARITY " + c.label.clone() + " dimension=" + c.dimension.clone() + " observable=" + obs.clone() + " verdict=blocked reason=" + obs.slice(8, obs.len()) + "\n"
      blocked = blocked + 1
    elsif obs == c.expected then
      report = report + "RUNTIME_PARITY " + c.label.clone() + " dimension=" + c.dimension.clone() + " observable=" + obs.clone() + " verdict=match\n"
    else
      report = report + "RUNTIME_PARITY " + c.label.clone() + " dimension=" + c.dimension.clone() + " observable=" + obs.clone() + " verdict=MISMATCH expected=" + c.expected.clone() + "\n"
      fails = fails + 1
    end
    i = i + 1
  end
  report = report + "RUNTIME_PARITY_BATTERY fails=" + fails.to_string() + " blocked=" + blocked.to_string() + " cases=" + cases.len().to_string() + "\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# (batch 5) CLOSURE_FAMILY_BATTERY — the full-closure HIR divergence
# families reduced to small scale, asserting the four channel counters
# plus readiness for every leg:
#   CL*: >host unsuffixed integer literals (FNV offset bases, 2^63) that
#        the cast/expected integer type must adopt (the seeds's
#        Int_literal rule);
#   IC*: indexing a local whose recorded type is a call result (the
#        linker's sections[i].data.len(), the budget/verifier lane's
#        rows[0].contains(...), the slice/mir effect helpers' ev[slot]);
#   VF*: `Vec::from([...])` over the std Array impl's `from`;
#   QC*: module-qualified free-function calls (`std::env::get_env(...)`)
#        parsed as ExprEnumVariant (multi-module crate scaffolding).
# ———————————————————————————————————————————————————————————————
def infer_probe_family_single_leg(inout report: String, inout fails: Int, label: String, source: String) -> Unit
  let (n, e, v, ib, ok, d) = infer_probe_channel_probe(source.clone())
  if n != 0 || e != 0 || v != 0 || ib != 0 || !ok then
    report = report + "CLOSURE_FAMILY " + label.clone() + ": errors=" + n.to_string() + " expr_error=" + e.to_string() + " expr_var=" + v.to_string() + " inst_bad=" + ib.to_string() + " readiness=" + ok.to_string() + " detail=" + d.clone() + " first=" + infer_probe_channel_first_error(source) + "\n"
    fails = fails + 1
  else
    report = report + "CLOSURE_FAMILY " + label.clone() + ": PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
  end
end

def infer_probe_family_multi_leg(inout report: String, inout fails: Int, label: String, names: Vec[String], sources: Vec[String]) -> Unit
  match infer_probe_parity_multi_program(label.clone(), names, sources)
  when Option::None then
    report = report + "CLOSURE_FAMILY " + label.clone() + ": parse-failed\n"
    fails = fails + 1
  when Option::Some(program) then
    let (n, e, v, ib, ok, d) = infer_probe_channel_probe_program(program.clone())
    if n != 0 || e != 0 || v != 0 || ib != 0 || !ok then
      report = report + "CLOSURE_FAMILY " + label.clone() + ": errors=" + n.to_string() + " expr_error=" + e.to_string() + " expr_var=" + v.to_string() + " inst_bad=" + ib.to_string() + " readiness=" + ok.to_string() + " detail=" + d.clone() + " first=" + infer_probe_channel_first_error_program(program.clone()) + "\n"
      fails = fails + 1
    else
      report = report + "CLOSURE_FAMILY " + label.clone() + ": PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
    end
  end
end

def infer_probe_closure_family_battery(inout report: String) -> Int
  var fails = 0
  # (1) the integer-literal / cast family.
  infer_probe_family_single_leg(&mut report, &mut fails, "CL1-large-hex-cast-arg",
    "def take(v: i64) -> i64\n  v\nend\n\ndef fnv_hash() -> i64\n  take(0xcbf29ce484222325 as i64)\nend\n\ndef main() -> Int\n  let _ = fnv_hash()\n  0\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "CL2-large-hex-annotated-uint",
    "def digest() -> UInt\n  var hi: UInt = 0xcbf29ce484222325\n  hi = hi * 0x100000001b3\n  hi\nend\n\ndef main() -> Int\n  let _ = digest()\n  0\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "CL3-neg-min-cast",
    "def sat() -> i64\n  -9223372036854775808 as i64\nend\n\ndef main() -> Int\n  let _ = sat()\n  0\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "CL4-u64-shift-cast-mul",
    "def split_words(x: u64) -> u64\n  let z = (x >> 32) as u32\n  (z as u64) * 1099511628211\nend\n\ndef main() -> Int\n  let _ = split_words(0xABCDEF0123456789)\n  0\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "CL5-small-cast-chain",
    "def widen() -> u64\n  let y = 1 as u32\n  y as u64\nend\n\ndef main() -> Int\n  let _ = widen()\n  0\nend\n")
  # (2) the index-after-call family.
  infer_probe_family_single_leg(&mut report, &mut fails, "IC1-index-call-result",
    "def mk() -> Vec[String]\n  Vec::new()\nend\n\ndef first_has() -> Bool\n  let xs = mk()\n  xs[0].contains(\"a\")\nend\n\ndef main() -> Int\n  if first_has() then 1 else 0 end\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "IC2-index-then-clone-then-method",
    "def errs() -> Vec[String]\n  Vec::new()\nend\n\ndef lane() -> Bool\n  let es = errs()\n  if es.len() == 1 then\n    let msg = es[0].clone()\n    msg.contains(\"fn\")\n  else\n    false\n  end\nend\n\ndef main() -> Int\n  if lane() then 1 else 0 end\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "IC3-index-field-len-cast",
    "struct Sec\n  data: Vec[u8]\nend\n\ndef merge() -> Vec[Sec]\n  Vec::new()\nend\n\ndef total_len() -> u64\n  let secs = merge()\n  var t: u64 = 0\n  var i = 0\n  while i < secs.len() do\n    t = t + (secs[i].data.len() as u64)\n    i = i + 1\n  end\n  t\nend\n\ndef main() -> Int\n  let _ = total_len()\n  0\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "IC4-index-call-result-in-loop",
    "def ev_empty() -> Vec[String]\n  Vec::new()\nend\n\ndef ann_slots() -> Int\n  var cur_ev = ev_empty()\n  cur_ev = ev_empty()\n  var n = 0\n  var slot = 0\n  while slot < 4 do\n    if cur_ev[slot].len() == 0 then\n      n = n + 1\n    end\n    slot = slot + 1\n  end\n  n\nend\n\ndef main() -> Int\n  ann_slots()\nend\n")
  # (3) Vec::from over the std Array impl shape.
  infer_probe_family_single_leg(&mut report, &mut fails, "VF1-vec-from-len",
    "struct Slice[T]\n  inner: Int\nend\n\nimpl[T: Copy] Array[T]\n  def from(items: [T]) -> Array[T]\n    Vec::new()\n  end\nend\n\ndef reentry_len() -> Int\n  var todo = Vec::from([1, 2, 3])\n  todo.len()\nend\n\ndef main() -> Int\n  reentry_len()\nend\n")
  infer_probe_family_single_leg(&mut report, &mut fails, "VF2-vec-from-push",
    "struct Slice[T]\n  inner: Int\nend\n\nimpl[T: Copy] Array[T]\n  def from(items: [T]) -> Array[T]\n    Vec::new()\n  end\nend\n\ndef reentry_push() -> Int\n  var path = Vec::from([1, 2])\n  path.push(3)\n  path.len()\nend\n\ndef main() -> Int\n  reentry_push()\nend\n")
  # (4) module-qualified free calls (the asm/codegen std::env::get_env shapes).
  let qc_names = Vec::from(["m", "app"])
  let qc_m = "def fetch(key: String) -> Option[String]\n  Option::None\nend\n"
  infer_probe_family_multi_leg(&mut report, &mut fails, "QC1-qualified-call-match-bind-method", qc_names.clone(),
    Vec::from([qc_m.clone(), "def probe() -> Bool\n  match m::fetch(\"X\")\n  when Option::Some(w) then w.contains(\"x\")\n  when Option::None then false\n  end\nend\n\ndef main() -> Int\n  if probe() then 1 else 0 end\nend\n"]))
  infer_probe_family_multi_leg(&mut report, &mut fails, "QC2-qualified-call-unwrap-or", qc_names,
    Vec::from([qc_m.clone(), "def probe2() -> Bool\n  let o = m::fetch(\"X\")\n  o.unwrap_or(\"d\".to_string()).contains(\"x\")\nend\n\ndef main() -> Int\n  if probe2() then 1 else 0 end\nend\n"]))
  report = report + "CLOSURE_FAMILY_BATTERY fails=" + fails.to_string() + " cases=13\n"
  fails
end

# ———————————————————————————————————————————————————————————————
# KERNEL_PARITY_BATTERY — the remaining kernel-checker semantic
# divergences at small scale (the class 1-4 set plus the small
# families), each asserted against the seed's acceptance:
#   KP1  Vec[Box-enum] index (the shared-container rule false positive)
#   KP2  Map[String, Box-enum].get
#   KP3  declare-resource Map.get (canary: must STILL reject)
#   KP4  declare-resource fixed-array index (canary: must STILL reject)
#   KP5  cross-module size_of/align_of bare query (type-query form)
#   KP6  Unit fn tail: if-without-else whose branch has a named type
#   KP7  Unit fn tail: if/else branches Named vs Unit
#   KP8  discarded match with Unit/valuable-divergent arms (non-Unit wins)
#   KP9  for _ in 0..n with n: UInt
#   KP10 f64 operand + unsuffixed float literal
#   KP11 u32 operand + unsuffixed int literal
#   KP12 Result::Ok(()) unit payload pattern
#   KP13 nullary-variant or-pattern coverage
#   KP14 deref of an inout parameter (direct access)
#   KP15 closed-enum match missing a variant: STILL an error (gate)
#   KP16 deref of a non-mutable non-pointer: STILL an error (gate)
#   KP17 `case`-prefixed enum variants: match over the real variants
# ———————————————————————————————————————————————————————————————
def infer_probe_kp_accept_leg(inout report: String, inout fails: Int, label: String, source: String) -> Unit
  let (n, e, v, ib, ok, d) = infer_probe_channel_probe(source.clone())
  if n != 0 || e != 0 || v != 0 || ib != 0 || !ok then
    report = report + "KERNEL_PARITY " + label.clone() + ": FAIL errors=" + n.to_string() + " expr_error=" + e.to_string() + " expr_var=" + v.to_string() + " inst_bad=" + ib.to_string() + " readiness=" + ok.to_string() + " detail=" + d.clone() + " first=" + infer_probe_channel_first_error(source) + "\n"
    fails = fails + 1
  else
    report = report + "KERNEL_PARITY " + label.clone() + ": PASS errors=0 expr_error=0 expr_var=0 inst_bad=0 readiness=true\n"
  end
end

def infer_probe_kp_run(source: String) -> (Int, String)
  let parsed = parse(tokenize(source, "kernelparity"))
  if diag_has_errors(&parsed.diagnostics) then
    return (1, "parse")
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    if errs.len() > 0 then (errs.len() + 1000, errs[0].message.clone()) else (1001, "resolve") end
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    let first = if result.errors.len() > 0 then result.errors[0].message.clone() else "-".to_string() end
    (result.errors.len(), first)
  end
end

def infer_probe_kp_run_msgs(source: String) -> (Int, Vec[String])
  let parsed = parse(tokenize(source, "kernelparity"))
  if diag_has_errors(&parsed.diagnostics) then
    return (1, Vec::from(["parse"]))
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Err(errs) then
    var msgs = Vec::new()
    var i = 0
    while i < errs.len() do
      msgs.push(errs[i].message.clone())
      i = i + 1
    end
    (errs.len() + 1000, msgs)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    var msgs = Vec::new()
    var i = 0
    while i < result.errors.len() do
      msgs.push(result.errors[i].message.clone())
      i = i + 1
    end
    (result.errors.len(), msgs)
  end
end

# The ABSENT-message leg: the standalone probe environment cannot register
# the std Drop impls, so an acceptance leg that moves a Box-owning element
# carries an unrelated "Box has no registered Drop impl" deinit-plan error
# in type_check_typed itself. The class-1 parity claim is that the
# resource-extraction diagnostic is NOT emitted — assert the needle is
# absent and report the residual (environment) error count.
def infer_probe_kp_absent_leg(inout report: String, inout fails: Int, label: String, source: String, needle: String) -> Unit
  let (n, msgs) = infer_probe_kp_run_msgs(source.clone())
  var hits = 0
  var first = "-".to_string()
  var i = 0
  while i < msgs.len() do
    if first == "-" then first = msgs[i].clone() end
    if msgs[i].contains(needle.clone()) then hits = hits + 1 end
    i = i + 1
  end
  if hits > 0 then
    report = report + "KERNEL_PARITY " + label.clone() + ": FAIL errors=" + n.to_string() + " matches=" + hits.to_string() + " first=" + infer_probe_norm_ids(first) + " (must not contain " + needle.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "KERNEL_PARITY " + label.clone() + ": PASS errors=" + n.to_string() + " (no " + needle.clone() + ")\n"
  end
end

def infer_probe_kp_reject_leg(inout report: String, inout fails: Int, label: String, source: String, needle: String) -> Unit
  let (n, first) = infer_probe_kp_run(source.clone())
  if n < 1 || !first.contains(needle.clone()) then
    report = report + "KERNEL_PARITY " + label.clone() + ": FAIL errors=" + n.to_string() + " first=" + infer_probe_norm_ids(first) + " (want contains " + needle.clone() + ")\n"
    fails = fails + 1
  else
    report = report + "KERNEL_PARITY " + label.clone() + ": PASS (rejected) errors=" + n.to_string() + " first=" + infer_probe_norm_ids(first) + "\n"
  end
end

def infer_probe_kernel_parity_battery(inout report: String) -> Int
  var fails = 0
  # class 1: container extraction of a compiler-shaped enum (linearity
  # from Box children, no declared resource kind) must be accepted — the
  # shared-extraction diagnostic must be ABSENT (the standalone probe
  # has no std Drop impl for Box, so the acceptance is asserted as the
  # absence of the resource message plus the residual report).
  infer_probe_kp_absent_leg(&mut report, &mut fails, "KP1-index-box-enum",
    "enum KpNode\n  KpLeaf(Int)\n  KpChild(Box[KpNode])\nend\n\ndef kp_take(n: KpNode) -> Int\n  match n\n  when KpNode::KpLeaf(v) then v\n  when KpNode::KpChild(_) then 0\n  end\nend\n\ndef kp_first(xs: Vec[KpNode]) -> Int\n  let n = xs[0]\n  kp_take(n)\nend\n\ndef main() -> Int\n  kp_first(Vec::new())\nend\n",
    "cannot extract resource element")
  infer_probe_kp_absent_leg(&mut report, &mut fails, "KP2-map-get-box-enum",
    "enum KpNode2\n  KpLeaf2(Int)\n  KpChild2(Box[KpNode2])\nend\n\ndef kp_lookup(m: Map[String, KpNode2], k: String) -> Int\n  match m.get(k)\n  when Option::Some(n) then\n    match n\n    when KpNode2::KpLeaf2(v) then v\n    when KpNode2::KpChild2(_) then 0\n    end\n  when Option::None then 0\n  end\nend\n\ndef main() -> Int\n  kp_lookup(Map::new(), \"k\")\nend\n",
    "cannot extract resource element")
  # class 1 gates preserved: declared-resource elements still reject.
  infer_probe_kp_reject_leg(&mut report, &mut fails, "KP3-canary-map-get-resource",
    "struct Map[K, V]\n  count: Int\nend\n\nresource KpFile\n  fd: Int\nend\n\ndef kp_map_res(files: Map[String, KpFile]) -> Int\n  let f = files.get(\"a\")\n  0\nend\n\ndef main() -> Int\n  0\nend\n",
    "cannot extract resource element")
  infer_probe_kp_reject_leg(&mut report, &mut fails, "KP4-canary-index-resource",
    "resource KpFile\n  fd: Int\nend\n\ndef main() -> Int\n  let files = [KpFile { fd: 1 }]\n  let f = files[0]\n  0\nend\n",
    "cannot extract resource element")
  # class 2: the type-query special form across modules.
  let kp_names = Vec::from(["kpa", "kpb", "kpc"])
  let kp_a = "def size_of[T]() -> UInt\n  0 as UInt\nend\n\ndef align_of[T]() -> UInt\n  0 as UInt\nend\n"
  let kp_b = "def size_of[T]() -> UInt\n  1 as UInt\nend\n"
  let kp_c = "def kp_sz[T]() -> Int\n  size_of[T]() as Int\nend\n\ndef main() -> Int\n  kp_sz[u8]()\nend\n"
  match infer_probe_parity_multi_program("kernel_parity_sizeof", kp_names, Vec::from([kp_a, kp_b, kp_c]))
  when Option::None then
    report = report + "KERNEL_PARITY KP5-sizeof-cross-module: FAIL parse-failed\n"
    fails = fails + 1
  when Option::Some(program) then
    # The type-query callee HIR readiness is asserted by the closure lane;
    # here the class-2 parity claim is the absence of the ambiguity
    # diagnostic when the query name is declared in several modules.
    let (n, e, v, ib, ok, d) = infer_probe_channel_probe_program(program.clone())
    if n != 0 then
      report = report + "KERNEL_PARITY KP5-sizeof-cross-module: FAIL errors=" + n.to_string() + " expr_error=" + e.to_string() + " expr_var=" + v.to_string() + " inst_bad=" + ib.to_string() + " readiness=" + ok.to_string() + " detail=" + d.clone() + " first=" + infer_probe_channel_first_error_program(program.clone()) + "\n"
      fails = fails + 1
    else
      report = report + "KERNEL_PARITY KP5-sizeof-cross-module: PASS errors=0 (readiness=" + ok.to_string() + ")\n"
    end
  end
  # class 3: the statement/block value-discard family.
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP6-unit-tail-if-no-else-named",
    "struct KpTok\n  kind: Int\nend\n\ndef kp_advance() -> KpTok\n  KpTok { kind: 1 }\nend\n\ndef kp_expect_end(flag: Bool) -> Unit\n  if flag then\n    kp_advance()\n  end\nend\n\ndef main() -> Int\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP7-unit-tail-if-else-named-vs-unit",
    "struct KpTok2\n  kind: Int\nend\n\ndef kp_adv2() -> KpTok2\n  KpTok2 { kind: 1 }\nend\n\ndef kp_maybe(flag: Bool) -> Unit\n  if flag then\n    kp_adv2()\n  else\n    let x = 1\n    let _ = x\n  end\nend\n\ndef main() -> Int\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP8-discarded-match-unit-divergent",
    "struct KpV\n  x: Int\nend\n\ndef kp_mkv() -> KpV\n  KpV { x: 1 }\nend\n\ndef kp_discarded_match(flag: Bool) -> KpV\n  match flag\n  when true then\n    kp_mkv()\n  when false then\n    let _ = 1\n  end\nend\n\ndef main() -> Int\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP9-for-range-uint",
    "def kp_range_uint(n: UInt) -> UInt\n  var r: UInt = 0\n  for _ in 0..n do\n    r = r + 1\n  end\n  r\nend\n\ndef main() -> Int\n  let _ = kp_range_uint(3)\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP10-f64-float-literal",
    "def kp_f64_lit(s: f64) -> f64\n  s + 1.5\nend\n\ndef main() -> Int\n  let _ = kp_f64_lit(0.5)\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP11-u32-int-literal",
    "def kp_u32_lit(x: u32) -> u32\n  x | 0x8B000000\nend\n\ndef main() -> Int\n  let _ = kp_u32_lit(1)\n  0\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP12-ok-unit-pattern",
    "def kp_ok_unit(r: Result[Unit, String]) -> Int\n  match r\n  when Result::Ok(()) then 1\n  when Result::Err(_) then 0\n  end\nend\n\ndef main() -> Int\n  kp_ok_unit(Result::Ok(()))\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP13-or-pattern-nullary-variants",
    "enum KpLane\n  KpL16\n  KpL32\n  KpL64\nend\n\ndef kp_width(l: KpLane) -> Int\n  match l\n  when KpL16 | KpL32 then 32\n  when KpL64 then 64\n  end\nend\n\ndef main() -> Int\n  kp_width(KpLane::KpL16)\nend\n")
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP14-deref-inout-param",
    "def kp_store(inout p: Int) -> Unit\n  *p = 5\nend\n\ndef main() -> Int\n  var v = 1\n  kp_store(&mut v)\n  0\nend\n")
  # the gate-preservation negatives.
  infer_probe_kp_reject_leg(&mut report, &mut fails, "KP15-closed-enum-partial-match",
    "enum KpClosed\n  KpA\n  KpB\nend\n\ndef kp_partial(c: KpClosed) -> Int\n  match c\n  when KpA then 1\n  end\nend\n",
    "non-exhaustive match")
  infer_probe_kp_reject_leg(&mut report, &mut fails, "KP16-deref-immutable-value",
    "def kp_bad(p: Int) -> Unit\n  *p = 5\nend\n",
    "safe dereference removed")
  # class 4: `case`-prefixed enum variants.
  infer_probe_kp_accept_leg(&mut report, &mut fails, "KP17-case-prefixed-enum",
    "enum KpCase\n  case KpX\n  case KpY\nend\n\ndef kp_case_use(c: KpCase) -> Int\n  match c\n  when KpCase::KpX then 1\n  when KpCase::KpY then 2\n  end\nend\n\ndef main() -> Int\n  kp_case_use(KpCase::KpX)\nend\n")
  # the same-named-enum identity class (the closure's asm::Arch vs
  # target_desc::Arch): the qualifier in `KpArch::KpX` resolves through
  # the import chain to the OTHER module's same-named enum, but the
  # SUBJECT/EXPECTED enum owns the variant — the seed's via_subject /
  # constructor_via_expected rules. Both the pattern and the value
  # comparison are pinned.
  let kp_arch_names = Vec::from(["kpe1", "kpe2"])
  let kp_arch_a = "enum KpArch\n  KpX\n  KpY\nend\n\nstruct KpDesc\n  arch: KpArch\nend\n"
  let kp_arch_b = "use kpe1::{KpDesc}\n\nenum KpArch\n  KpX\n  KpY\nend\n\ndef kp_arch_ok(d: KpDesc) -> Int\n  match d.arch\n  when KpArch::KpX then 1\n  when KpArch::KpY then\n    if d.arch != KpArch::KpX then 2 else 3 end\n  end\nend\n"
  match infer_probe_parity_multi_program("kernel_parity_arch", kp_arch_names, Vec::from([kp_arch_a, kp_arch_b]))
  when Option::None then
    report = report + "KERNEL_PARITY KP18-same-named-enum-subject: FAIL parse-failed\n"
    fails = fails + 1
  when Option::Some(program) then
    let (n, e, v, ib, ok, d) = infer_probe_channel_probe_program(program.clone())
    if n != 0 then
      report = report + "KERNEL_PARITY KP18-same-named-enum-subject: FAIL errors=" + n.to_string() + " expr_error=" + e.to_string() + " expr_var=" + v.to_string() + " inst_bad=" + ib.to_string() + " readiness=" + ok.to_string() + " detail=" + d.clone() + " first=" + infer_probe_channel_first_error_program(program.clone()) + "\n"
      fails = fails + 1
    else
      report = report + "KERNEL_PARITY KP18-same-named-enum-subject: PASS errors=0 expr_error=" + e.to_string() + " readiness=" + ok.to_string() + "\n"
    end
  end
  report = report + "KERNEL_PARITY_BATTERY fails=" + fails.to_string() + " cases=18\n"
  fails
end

def main() -> Int
  var report = ""
  # the direct kernel-unify unit battery runs FIRST so its rows precede
  # every checker-family row in the report.
  let _ = infer_probe_unify_battery(&mut report)
  let _ = infer_probe_impl_index_battery(&mut report)
  let _ = infer_probe_restricted_intrinsic_battery(&mut report)
  let _ = infer_probe_head_cross_product(&mut report)
  let _ = infer_probe_default_field_battery(&mut report)
  let _ = infer_probe_semantic_default_battery(&mut report)
  let _ = infer_probe_pending_inference_battery(&mut report)
  # the Option/Result expect(msg) builtin surface (the resolver
  # module_table_for fingerprint class) + its Unwrap intrinsic route.
  let _ = infer_probe_option_expect_battery(&mut report)
  let _ = infer_probe_semantic_default_battery(&mut report)
  # the seed-vs-kernel parity battery + the no-fallback mutation witnesses
  let _ = infer_probe_parity_battery(&mut report)
  # the typed-channel completeness verifier + its deleted-record mutation
  let _ = infer_probe_hir_complete_battery(&mut report)
  # patch 3 item B: the kernel builtin String/str method surface battery
  let _ = infer_probe_builtin_string_surface_battery(&mut report)
  # patch 3 item A: the all-failures enumeration (TANGERINE_HIR_REPORT=all)
  let _ = infer_probe_hir_all_failures_battery(&mut report)
  # patch 3 item D: imported / aliased defaults + the resolver no-trap leg
  let _ = infer_probe_imported_defaults_battery(&mut report)
  # patch 3 item E: std::time builtin identity by semantic binding
  let _ = infer_probe_time_binding_battery(&mut report)
  # Patch 4: seed-vs-kernel runtime observable parity (tg_kernel_runtime_parity)
  let _ = infer_probe_krp_battery(&mut report)
  # batch 5: the full-closure HIR divergence families at small scale
  let _ = infer_probe_closure_family_battery(&mut report)
  # the remaining closure-checker semantic divergences at small scale.
  let _ = infer_probe_kernel_parity_battery(&mut report)
  let _ = write_file("build/infer_probe.txt", report.clone())
  var counts = Vec::from([infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0)])
  var rows = Vec::new()
  var row_counts = Vec::new()
  var row_samples = Vec::new()
  var res_counts = Vec::from([infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0)])
  var res_shown = Vec::from([infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0), infer_probe_n(0)])
  var res_rows = Vec::new()
  var res_row_counts = Vec::new()
  var res_row_samples = Vec::new()
  var res_files = Vec::new()
  var res_file_counts = Vec::new()
  var snippet_cache: Map[String, String] = Map::new()
  let cases = Vec::from([
    ("result_ok_call_expected", "def inc(x: Int) -> Int\n  x + 1\nend\n\ndef main() -> Int\n  let r: Result[Int, String] = Result::Ok(inc(1))\n  0\nend\n"),
    ("call_expected_annotation", "def make[T](x: T) -> Option[T]\n  Option::Some(x)\nend\n\ndef main() -> Int\n  let o: Option[Int] = make(1)\n  0\nend\n"),
    ("enum_none_expected", "def main() -> Int\n  let o: Option[Int] = Option::None\n  0\nend\n"),
    ("enum_none_then_some", "def main() -> Int\n  var o = Option::None\n  o = Option::Some(1)\n  0\nend\n"),
    ("chained_dest", "def main() -> Int\n  let a: Result[Int, String] = Result::Ok(1)\n  let b = a.map(|x| x + 1)\n  let c: Result[Int, String] = b\n  0\nend\n"),
    ("size_of_cast", "def size_of[T]() -> UInt\n  0 as UInt\nend\n\ndef align_of[T]() -> UInt\n  0 as UInt\nend\n\ndef sz[T]() -> Int\n  size_of[T]() as Int\nend\n\ndef main() -> Int\n  sz[u8]()\nend\n"),
    ("layout_chain", "struct Layout\n  size: Int\n  align: Int\nend\n\ndef size_of[T]() -> UInt\n  0 as UInt\nend\n\ndef align_of[T]() -> UInt\n  0 as UInt\nend\n\ndef layout_for2[T]() -> Layout\n  Layout { size: size_of[T]() as Int, align: align_of[T]() as Int }\nend\n\ndef main() -> Int\n  let l = layout_for2[u8]()\n  l.size\nend\n"),
    ("generic_alloc_arg", "def alloc2[T]() -> Ptr[T]\n  Ptr::null()\nend\n\ndef main() -> Int\n  let p: Ptr[u8] = alloc2[u8]()\n  0\nend\n"),
    ("vec_new_push", "def main() -> Int\n  var v = Vec::new()\n  v.push(1)\n  0\nend\n"),
    ("vec_new_annotation", "def main() -> Int\n  let v: Vec[u8] = Vec::new()\n  0\nend\n"),
    ("ret_tail_call", "def mk() -> Option[Int]\n  Option::None\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("arg_expected_tuple", "def takes(t: Option[Int]) -> Int\n  0\nend\n\ndef main() -> Int\n  takes(Option::None)\nend\n")
  ])
  var i = 0
  while i < cases.len() do
    let label = cases[i].0.clone()
    report = report + "BEGIN " + label.clone() + "\n"
    let _ = write_file("build/infer_probe.txt", report.clone())
    let rc = infer_probe_run_case(label, cases[i].1.clone(), &mut report, &mut counts)
    i = i + 1
  end
  # the SHAPE battery: the kernel resource checker's verdict on the
  # construct shapes the gate's [6/10] lane must agree with the seed on
  # (branch joins with returning arms, value-position tails, by-value
  # params, match-arm payload bindings, loop-created/per-iteration cleanup,
  # projected for-bindings, discards). Each shape's diagnostics print
  # verbatim; the merged closure counts are the parity measure.
  let shapes = Vec::from([
    ("tail_move_owned", "def mk() -> String\n  let s = \"x\".to_string()\n  s\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("tail_discard_unit", "def sink_it() -> Unit\n  let s = \"x\".to_string()\n  s\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("discard_expr_stmt", "def make() -> String\n  \"x\".to_string()\nend\n\ndef main() -> Int\n  make()\n  0\nend\n"),
    ("let_param_into_aggregate", "struct Box2\n  message: String\nend\n\ndef wrap(message: String) -> Box2\n  Box2 { message: message }\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("match_arm_payload_consumed", "def pick(r: Result[String, String]) -> Option[String]\n  match r\n  when Result::Ok(_) then Option::None\n  when Result::Err(msg) then Option::Some(msg)\n  end\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("returning_arm_then_use", "def first_ok(out: Vec[u8]) -> Result[String, String]\n  loop\n    if out.len() > 3 then\n      return Result::Ok(\"stop\")\n    end\n    out.push(1u8)\n  end\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("loop_outer_consume_return", "def take_bytes(bytes: Vec[u8], stop: Bool) -> Result[Vec[u8], Vec[u8]]\n  loop\n    if stop then\n      return Result::Ok(bytes)\n    end\n    bytes.push(1u8)\n  end\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("loop_outer_consume_continue", "def take_bytes2(bytes: Vec[u8], stop: Bool) -> Vec[u8]\n  loop\n    if stop then\n      next\n    end\n    let b = bytes\n    bytes.push(1u8)\n    return b\n  end\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("loop_created_partial_consume", "def pick_names(buf: Vec[u8]) -> Vec[String]\n  var out: Vec[String] = Vec::new()\n  for i in 0..3 do\n    let name = String::from_utf8_range(buf.clone(), 0, i)\n    if name != \".\" then\n      out.push(name)\n    end\n  end\n  out\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("for_binding_projected_consume", "def push_all(parts: Vec[String]) -> Vec[String]\n  var result: Vec[String] = Vec::new()\n  for part in parts do\n    result.push(part)\n  end\n  result\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("borrow_arg_of_outer_local", "def from_range(data: Vec[u8], start: Int, len: Int) -> String\n  \"x\".to_string()\nend\n\ndef scan(buf: Vec[u8]) -> String\n  for i in 0..2 do\n    let name = from_range(&buf, i, 1)\n    buf.push(1u8)\n  end\n  \"done\".to_string()\nend\n\ndef main() -> Int\n  0\nend\n"),
    # the fs.tg read_dir shape: the STANDARD associated function consumes
    # nothing (the seed records `read` for the `&buf` argument) — the probe
    # isolates whether the kernel's effect table agrees.
    ("borrow_std_assoc_utf8", "def scan_utf8(buf: Vec[u8]) -> Int\n  let name = String::from_utf8_range(&buf, 0, 1)\n  let _ = name\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("borrow_std_assoc_utf8_loop", "def scan_utf8_loop(buf: Vec[u8]) -> Int\n  for i in 0..2 do\n    let name = String::from_utf8_range(&buf, i, 1)\n    let _ = name\n  end\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    # the Vec receiver/method shapes of the read loops: as_mut_ptr /
    # as_mut_slice / resize / capacity on a borrowed Vec param.
    ("vec_as_mut_ptr_read", "def scan_ptr(buf: Vec[u8]) -> Int\n  let p = buf.as_mut_ptr() as Int\n  let _ = p\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("vec_as_mut_slice_read", "def scan_slice(buf: Vec[u8]) -> Int\n  let s = buf.as_mut_slice()\n  let _ = s\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("vec_resize_read", "def scan_resize(buf: Vec[u8]) -> Int\n  buf.resize(8, 0)\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    # the buf_reader_read projected-receiver shape: methods on a FIELD of an
    # inout struct receiver, then whole reads of the struct.
    ("projected_receiver_reads", "struct Buf\n  data: Vec[u8]\n  pos: Int\n  len: Int\nend\n\ndef refill(inout b: Buf) -> Int\n  if b.pos >= b.len then\n    b.data.resize(b.data.capacity(), 0)\n    b.len = 1\n    b.pos = 0\n  end\n  let available = b.len - b.pos\n  b.pos = b.pos + available\n  available\nend\n\ndef main() -> Int\n  0\nend\n"),
    # the negative canary's shape (kernel-only inout rule): the diagnostic
    # class the canary lane asserts.
    ("inout_param_consume_negative", "resource File\n  fd: Int\nend\n\ndef destroy(sink x: File) -> Unit\nend\n\ndef inspect(inout x: File) -> Unit\n  destroy(x)\nend\n\ndef main() -> Int\n  var f = File { fd: 1 }\n  inspect(f)\n  0\nend\n"),
    # the buf_reader_read call shape: a borrowed FIELD argument (`&h.file`)
    # into a by-value owning param, then whole reads of the struct.
    ("borrow_projected_field_arg", "resource File\n  fd: Int\nend\n\nstruct Holder\n  file: File\n  buf: Vec[u8]\n  pos: Int\nend\n\ndef take(file: File, buf: SliceMut[u8]) -> Int\n  0\nend\n\ndef scan(inout h: Holder) -> Int\n  let n = take(&h.file, h.buf.as_mut_slice())\n  let _ = n\n  h.buf.len() + h.pos\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("borrow_std_assoc_utf8_stmt", "def scan_utf8_stmt(buf: Vec[u8]) -> Int\n  String::from_utf8_range(&buf, 0, 1)\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("borrow_marker_let", "def scan_marker_let(buf: Vec[u8]) -> Int\n  let f = &buf\n  let _ = f\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("borrow_std_assoc_bare", "def scan_utf8_bare(buf: Vec[u8]) -> Int\n  let name = String::from_utf8_range(buf, 0, 1)\n  let _ = name\n  buf.len()\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("value_tail_conditional_consume", "def read_link(buf: Vec[u8], result: Int) -> String\n  if result < 0 then\n    \"err\".to_string()\n  else\n    buf.truncate(result)\n    String::from_bytes(buf)\n  end\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("inout_param_field_after_return", "struct Arena\n  offset: Int\n  capacity: Int\nend\n\ndef reset(inout arena: Arena) -> Unit\n  if arena.capacity == 0 then\n    arena.offset = 0\n    return\n  end\n  arena.offset = 0\nend\n\ndef main() -> Int\n  0\nend\n"),
    ("replace_owned_field_conditional", "struct Holder\n  name: String\n  tag: Int\nend\n\ndef main() -> Int\n  var h = Holder { name: \"a\".to_string(), tag: 1 }\n  if h.tag == 1 then\n    h.name = \"b\".to_string()\n  end\n  let t = h.tag\n  t - 1\nend\n"),
    ("match_arm_returning_use", "def conv(r: Result[String, String]) -> Result[String, String]\n  match r\n  when Result::Ok(v) then\n    if v.len() == 0 then\n      return Result::Err(\"empty\".to_string())\n    end\n    Result::Ok(v)\n  when Result::Err(e) then Result::Err(e)\n  end\nend\n\ndef main() -> Int\n  0\nend\n")
  ])
  var sh = 0
  while sh < shapes.len() do
    let label = shapes[sh].0.clone()
    report = report + "BEGIN shape " + label.clone() + "\n"
    let _ = write_file("build/infer_probe.txt", report.clone())
    let _ = infer_probe_run_shape(label, shapes[sh].1.clone(), &mut report, &mut res_counts, &mut res_shown, &mut res_rows, &mut res_row_counts, &mut res_row_samples, &mut res_files, &mut res_file_counts, &mut snippet_cache)
    sh = sh + 1
  end
  # the MIR LOWERING regression battery (flag build/infer_lower.flag): each
  # shape goes through the REAL analyze_parsed + lower_to_mir TWICE over
  # the same borrowed tree (mir.tg's lowering ownership contract). The
  # pre-fix `into_inner()` extractions freed the boxes the second pass
  # re-read — the VM trapped on the freed region. Every row must read
  # `functions=N errors=0` on BOTH passes (asserted by tg_infer --lower).
  if file_exists("build/infer_lower.flag") then
    let lower_shapes = Vec::from([
      # binary/unary/raw-deref operand boxes (lr_binary/lr_unary/lr_deref)
      ("lower_arith", "def main() -> Int\n  let a = 1 + 2\n  let b = a * 3 - 1\n  b\nend\n", 0),
      # nested field access + method receiver chain (lower_place /
      # lower_callee_operand / qualify_field_callee_name)
      ("lower_field_chain", "struct Inner\n  v: Int\nend\n\nstruct Outer\n  inner: Inner\nend\n\ndef take(o: Outer) -> Int\n  o.inner.v + 1\nend\n\ndef main() -> Int\n  let o = Outer { inner: Inner { v: 4 } }\n  take(o)\nend\n", 1),
      # enum variant payload arguments (lr_enum_variant / lower_call_arg):
      # the enum is declared IN the shape program (an isolated program has
      # no std type tables, so std's Option/Result matches are covered by
      # the merged closure leg instead).
      ("lower_enum_payload", "enum E\n  Pair(Int, Int)\n  Nil\nend\n\ndef mk(v: Int) -> E\n  E::Pair(v + 1, v)\nend\n\ndef main() -> Int\n  let e = mk(1)\n  match e\n  when E::Pair(a, _b) then a\n  when E::Nil then 0\n  end\nend\n", 1),
      # (enum associated fn vs variant construction): `Type::assoc_fn(args)`
      # over an ENUM owner parses as an ExprEnumVariant, but only a path
      # whose LAST segment is a registered variant may construct (the
      # seed's ctor_of lookup). The pre-fix owner-only check routed
      # `Budget::capped(4)` into the variant-construction arm, whose
      # discriminant lookup failed closed with `unknown enum variant
      # 'Budget::capped'` — the std/fs.tg `IoError::from_errno` corpus
      # trap. The impl-registry static-path call must lower instead.
      ("lower_enum_assoc_fn", "enum Budget\n  Capped(Int)\n  Uncapped\nend\n\nimpl Budget\n  def capped(limit: Int) -> Budget\n    Budget::Capped(limit)\n  end\nend\n\ndef main() -> Int\n  match Budget::capped(4)\n  when Budget::Capped(v) then v\n  when Budget::Uncapped then 0\n  end\nend\n", 1),
      # assignment expression target/value boxes (lower_expr_assign_to /
      # lr_enum_variant)
      ("lower_enum_assign", "struct Holder\n  v: Int\nend\n\ndef main() -> Int\n  var h = Holder { v: 1 }\n  match h.v\n  when 1 then h.v = 2\n  when _ then ()\n  end\n  h.v\nend\n", 0),
      # match-to-place with a field payload (lower_match_to_place); the
      # enum is declared in the shape (see lower_enum_payload).
      ("lower_match_field", "struct Inner\n  v: Int\nend\n\nenum Boxed\n  Has(Inner)\n  None\nend\n\ndef pick(o: Boxed) -> Int\n  let x = match o\n  when Boxed::Has(inner) then inner.v\n  when Boxed::None then 0\n  end\n  x\nend\n\ndef main() -> Int\n  let i = Inner { v: 3 }\n  pick(Boxed::Has(i))\nend\n", 1),
      # closure body retention (the deep-clone boundary) + capture: the
      # capture is a PARAMETER (its semantic id is registered at the
      # function head, the shape the parameter-capture channel supports)
      ("lower_closure_capture", "def apply_base(base: Int) -> Int\n  let f = |x: Int| x + base\n  f(2)\nend\n\ndef main() -> Int\n  apply_base(10)\nend\n", 1),
      # for-range bound boxes (lower_for)
      ("lower_for_range", "def hi() -> Int\n  3\nend\n\ndef main() -> Int\n  var acc = 0\n  for i in 0..hi() do\n    acc = acc + i\n  end\n  acc\nend\n", 0),
      # (const-call pattern): `when FOUR() then` against a non-enum subject
      # is the checker's const-call fallback (types.tg pattern_const_calls);
      # the pre-fix MIR routed the 1-segment Variant path into the
      # variant-construction arm and failed closed with `enum variant path
      # needs at least two segments` — the std/fs.tg `when DT_DIR() then`
      # corpus trap. The declaration's literal body folds to the test value.
      ("lower_const_call_pattern", "def FOUR() -> Int = 4\n\ndef classify(x: Int) -> Int\n  match x\n  when FOUR() then 1\n  when _ then 0\n  end\nend\n\ndef main() -> Int\n  classify(4) + classify(5) * 10\nend\n", 1),
      # array/index/cast operand boxes (lr_array_lit / ExprIndex / cast)
      ("lower_array_index", "def main() -> Int\n  let arr: [Int; 3] = [1, 2, 3]\n  let i = 1\n  let x = arr[i] as Int\n  x + arr[0]\nend\n", 0),
      # the ffi.tg RubyValue shape: a field access in a binary comparison
      # whose OTHER operand is a field access on a CALL result (the
      # merged-closure lowering's `missing typed field target for field
      # 'raw'` site)
      ("lower_field_call_recv", "struct V\n  raw: UInt\nend\n\ndef nil_v() -> V\n  V { raw: 8 }\nend\n\ndef is_nil(v: V) -> Bool\n  v.raw == nil_v().raw\nend\n\ndef main() -> Int\n  0\nend\n", 1),
      ("lower_field_bitand", "struct V\n  raw: UInt\nend\n\ndef odd(v: V) -> Bool\n  (v.raw & 1) == 1\nend\n\ndef main() -> Int\n  0\nend\n", 1),
      ("lower_field_shr_cast", "struct V\n  raw: UInt\nend\n\ndef to_int(v: V) -> Int\n  (v.raw >> 1) as Int\nend\n\ndef main() -> Int\n  0\nend\n", 1),
      # the expression-bodied declaration form (`def f() -> T = expr`)
      ("lower_expr_body_field", "struct V\n  raw: UInt\nend\n\ndef make() -> V = V { raw: 1 }\n\ndef main() -> Int\n  0\nend\n", 0),
      # a payload-less enum variant VALUE in a match arm (the IoError::code /
      # SmallErrorCode::code shape): the constant must carry the ENUM's type,
      # never the bare Int, and the switch must read the Discriminant.
      ("lower_enum_value_match", "enum EC\n  A\n  B\nend\n\ndef pick(x: Int) -> EC\n  match x\n  when 1 then EC::A\n  when _ then EC::B\n  end\nend\n\ndef main() -> Int\n  0\nend\n", 1),
      # an inout parameter assigned as a bare target: the store goes through
      # the pointee (ProjDeref), never into the reference slot.
      ("lower_inout_self_assign", "enum E\n  Some(Int)\n  None\nend\n\ndef take(inout e: E) -> E\n  let old = e\n  e = E::None\n  old\nend\n\ndef main() -> Int\n  0\nend\n", 1),
      # an annotated scalar local with an unsuffixed literal initializer and
      # a call argument in a declared scalar slot (the dest-typed and
      # call-site literal expectations).
      ("lower_scalar_literal_slots", "def add(x: UInt, y: UInt) -> UInt\n  x + y\nend\n\ndef main() -> Int\n  let a: UInt = 0\n  let b: u8 = 8\n  let c = add(1, 2)\n  (a + c + (b as UInt)) as Int\nend\n", 1)
    ])
    var lsi = 0
    while lsi < lower_shapes.len() do
      let label = lower_shapes[lsi].0.clone()
      report = report + "BEGIN lower-shape " + label.clone() + "\n"
      let _ = write_file("build/infer_probe.txt", report.clone())
      let _ = infer_probe_run_lower_shape(label, lower_shapes[lsi].1.clone(), lower_shapes[lsi].2, &mut report)
      lsi = lsi + 1
    end
  end
  if file_exists("build/infer_merged.flag") then
    report = report + "BEGIN merged\n"
    let _ = write_file("build/infer_probe.txt", report.clone())
    let rcm = infer_probe_run_merged("tests/differential/corpus/01_defs_arith.tg", &mut report, &mut counts, &mut rows, &mut row_counts, &mut row_samples, &mut res_counts, &mut res_shown, &mut res_rows, &mut res_row_counts, &mut res_row_samples, &mut res_files, &mut res_file_counts, &mut snippet_cache)
    let _ = rcm
  end
  # the resource class table + per-file tally (deterministic order), then
  # the totals rows.
  var ri2 = 0
  while ri2 < res_files.len() do
    report = report + "RESFILE " + res_files[ri2] + " count=" + res_file_counts[ri2].to_string() + "\n"
    ri2 = ri2 + 1
  end
  var rc2 = 0
  while rc2 < res_rows.len() do
    report = report + "RESROW " + res_rows[rc2] + " count=" + res_row_counts[rc2].to_string() + " sample=" + res_row_samples[rc2] + "\n"
    rc2 = rc2 + 1
  end
  report = report + "TOTALS errors=" + counts[4].to_string() + " VAR=" + counts[0].to_string() + " PARAM=" + counts[1].to_string() + " INFER=" + counts[2].to_string() + " UNIFY=" + counts[3].to_string() + " IMPLCONF=" + counts[5].to_string() + "\n"
  report = report + infer_probe_resource_totals_word(res_counts.clone()) + "\n"
  let _ = write_file("build/infer_probe.txt", report.clone())
  println("infer_probe: TOTALS errors=" + counts[4].to_string() + " VAR=" + counts[0].to_string() + " PARAM=" + counts[1].to_string() + " INFER=" + counts[2].to_string() + " UNIFY=" + counts[3].to_string() + " IMPLCONF=" + counts[5].to_string())
  println("infer_probe: " + infer_probe_resource_totals_word(res_counts.clone()))
  0
end
