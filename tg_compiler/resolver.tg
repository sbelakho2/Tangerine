# Tangerine Compiler — Name Resolution
#
# Dedicated name resolution pass that runs before type checking:
#   - Builds symbol tables
#   - Resolves imports and use declarations
#   - Resolves paths (module::item::member)
#   - Enforces visibility (pub/priv)
#   - Reports unresolved names

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}

use tg_compiler::ast::{Program, Item, ItemKind, Expr, ExprKind, Stmt, StmtKind,
                        Pattern, PatternKind, TypeExpr, TypeExprKind, UseDecl, ModuleDecl, Visibility, AstPath,
                        Param, TraitMethod, GenericParam, Function, ExternItem}
use tg_compiler::token::{Span}
use tg_compiler::ids::{DefId, DefKind, FieldId, StableDefId, TypeId, ModuleId, VariantId, LocalId,
                       synthetic_module_id, SYNTHETIC_MODULE_INTRINSIC, IntrinsicId}

# ———————————————————————————————————————————————————————————————
# Resolution Errors
# ———————————————————————————————————————————————————————————————

struct ResolutionError
  message: String
  span: Span
  kind: ResolutionErrorKind
end

enum ResolutionErrorKind
  UnresolvedName
  UnresolvedType
  UnresolvedModule
  UnresolvedImport
  DuplicateDefinition
  VisibilityViolation
  CyclicImport
  AmbiguousName
  Unsupported
end

# ———————————————————————————————————————————————————————————————
# Symbol Table
# ———————————————————————————————————————————————————————————————

struct SymbolTable
  # Root module
  root: ModuleSymbols

  # Current path for resolution
  current_module: Vec[String]

 # (per-module identity — registration authority): one ModuleSymbols
  # per module, keyed by the module path join (the owner Module's path
  # from Program.crate — the Crate merge_imported_deps builds — plus inline
  # module segments). The FIRST-WINS REGISTRATION DECISION for every item
  # consults THIS table — the (owner ModuleId, namespace, name) duplicate
  # test — never the root bare-name occupancy, so a second same-named
  # declaration in a DIFFERENT file module registers its own qualified entry
  # instead of failing the root occupancy test. Each table owns its symbol
  # indices; the DefIds built from them are the identity (module_symbols,
 # item_defs, call targets all carry the same per-module index).: the
 # root bare-name tables are not part of the model — the root tree carries no name maps;
  # this per-module table and the module_symbols entries below are the only
  # authorities.
  module_tables: Map[String, ModuleSymbols]

 # (DefKind metadata): DefId no longer carries a kind (ids.tg — the
  # kind is definition METADATA, not identity). This map renders each
  # registered DefId as "<module_id>::<index>" -> DefKind, so the kind of
  # every resolver-produced DefId (module_symbols entries, item_defs,
  # call targets) stays recoverable — the resolver-side
  # metadata map (def_kind_of). The
  # snapshot in ResolvedNames carries the same map for the type checker's
  # module-qualified lookups.
  def_kinds: Map[String, DefKind]

 # (structural foundation — module identity): module-qualified symbol
  # keys "path::name" (path = the owner Module's path from Program.crate,
  # i.e. the module of the item being registered) -> DefId. Same-named items
  # in different modules are distinguishable here — the qualified IDENTITY
  # the per-module tables above register into; the type checker's
  # module-qualified lookups, the resolver's own record_path_call_target,
 # and () every bare-name resolution (the 0/1/>1 rule — the bare-name
  # first-wins compatibility tables) consume them.
  module_symbols: Map[String, DefId]

  # Errors collected during resolution
  errors: Vec[ResolutionError]

  # Import graph for cycle detection
  import_graph: Map[String, Set[String]]
end

struct ModuleSymbols
  name: String

 # (owner identity): the ModuleId.id of the FILE module this table
  # belongs to (0 = root, from Program.crate; inline submodules inherit
  # their enclosing file module's id). The per-module registration tables
  # (SymbolTable.module_tables) carry it so the first-wins duplicate test is
  # literally an (owner ModuleId, namespace, name) decision.
  module_id: Int

  # Items defined in this module
  types: Map[String, TypeDefSymbol]
  functions: Map[String, FunctionSymbol]
  constants: Map[String, ConstantSymbol]
  statics: Map[String, StaticSymbol]
  traits: Map[String, TraitSymbol]
  capabilities: Map[String, CapabilitySymbol]

  # Every enum variant name defined in this module (for bare variant refs
  # like `Some`/`None`/`Zero` in expression position).
  variants: Set[String]

  # Re-exports and imports
  imports: Vec[ImportSymbol]
  glob_imports: Vec[Vec[String]]

  # Child modules
  submodules: Map[String, ModuleSymbols]

  # Visibility of this module
  visibility: Visibility

  next_symbol_index: Int
  symbol_indices: Map[String, Int]
  variant_indices: Map[String, Int]
end

struct TypeDefSymbol
  name: String
  kind: TypeDefSymbolKind
  type_params: Vec[String]
  visibility: Visibility
  span: Span
end

enum TypeDefSymbolKind
  Struct
  Enum
  Union
  TypeAlias
end

struct FunctionSymbol
  name: String
  params: Vec[(String, Option[TypeExpr])]
  return_type: Option[TypeExpr]
  type_params: Vec[String]
  visibility: Visibility
  is_method: Bool
  receiver_type: Option[String]
  span: Span
end

struct ConstantSymbol
  name: String
  ty: Option[TypeExpr]
  visibility: Visibility
  span: Span
end

struct StaticSymbol
  name: String
  ty: Option[TypeExpr]
  is_mut: Bool
  visibility: Visibility
  span: Span
end

struct TraitSymbol
  name: String
  type_params: Vec[String]
  super_traits: Vec[String]
  methods: Vec[String]
  visibility: Visibility
  span: Span
end

struct CapabilitySymbol
  name: String
  visibility: Visibility
  span: Span
end

struct ImportSymbol
  path: Vec[String]
  alias_name: Option[String]
  is_glob: Bool
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Resolved References
# ———————————————————————————————————————————————————————————————

struct ResolvedNames
  # Map from span (or node id) to resolved symbol
  expr_resolutions: Map[Int, ResolvedExpr]
  type_resolutions: Map[Int, ResolvedType]
  pattern_resolutions: Map[Int, ResolvedPattern]
  call_targets: Map[Int, DefId]

 # the TypeId -> DefId association — the DIRECT type-to-declaration
  # identity, filled by the type checker's registration (store_type_def in
  # types.tg records each nominal TypeId's defining DefId — the
  # module_symbols DefKind::TypeName/Trait entry of its (module path,
  # name) — here at the end of type checking). The public ABI's
  # type-to-declaration association reads this table (no name/order
  # correlation). The resolver leaves it empty; the MIR builder's
  # ResolvedNames snapshot construction initializes it empty.
  type_def_ids: Map[Int, DefId]

 # the INTRINSIC-KIND classification per call — call node id -> the
  # semantic IntrinsicId the type checker attached at call-recording time
  # (the frontend classifies the intrinsic calls; the MIR serializes this
  # table so codegen dispatches on the typed classification instead of
  # name-matching). The resolver leaves it empty; the checker fills the
  # snapshot at the end of type checking (type_check_typed).
  intrinsic_ids: Map[Int, IntrinsicId]

  # Item index (position in the merged Program.items) -> DefIds in
  # declaration order, recorded for every function/method item during
  # symbol-table construction. This gives the type checker, resource checker
  # and MIR lowering a stable, cross-file collision-free owner identity for
  # items (DefIds carry the module name, so two functions at the same byte
  # offset in different files never collide — unlike span.start-based keys).
  item_defs: Map[Int, Vec[DefId]]

 # (next layer — module-qualified type identity): snapshot of the
  # symbol table's module_symbols ("path::name" -> DefId, see
  # SymbolTable.module_symbols), taken after symbol-table construction so
  # the type checker can consult module-qualified symbol identity when the
  # same bare name is registered from multiple module paths. The type
  # checker's record_module_type_name mirrors the DefKind::TypeName entries
  # into its own module_type_names map at type-registration time, and
  # lookup_module_symbol / module_path_of operate over the live symbol
 # table.: the per-module tables (SymbolTable.module_tables) hold the
  # registration authority, the qualified entries hold the identity, and
  # every bare-name resolution (the 0/1/>1 rule) feeds on this snapshot.
  module_symbols: Map[String, DefId]

 # (DefKind metadata snapshot): the symbol table's def_kinds map —
  # "module_id::index" -> DefKind for every resolver-produced DefId (the
  # resolver metadata map; DefId itself carries no
  # kind). Consumers render kinds via def_kind_of, never from the DefId.
  def_kinds: Map[String, DefKind]

  # Stable IDs for incremental compilation
  stable_ids: StableIdMap
end

# ———————————————————————————————————————————————————————————————
# Stable IDs for Incremental Compilation
# ———————————————————————————————————————————————————————————————

# StableDefId (the id record itself) lives in ids.tg.

struct StableIdMap
  # Ephemeral node ID -> stable def ID
  node_to_stable: Map[Int, StableDefId]
  # Stable hash -> ephemeral node ID (for cache lookup)
  stable_to_node: Map[UInt, Int]
  # Cache fingerprints: stable ID -> hash of result
  fingerprints: Map[UInt, UInt]
  # Registered id -> canonical key (id -> key), populated at assignment
  # and verified at every stable-id lookup: finding a DIFFERENT key for an
  # already-registered id is an internal error (a digest collision — the
 # sequential-counter disambiguation is not part of the model; an order-dependent
  # alternate identity is never created).
  stable_keys: Map[UInt, String]
end

def stable_id_map_new() -> StableIdMap
  StableIdMap {
    node_to_stable: Map::new(),
    stable_to_node: Map::new(),
    fingerprints: Map::new(),
    stable_keys: Map::new()
  }
end

# (digest model — ids.tg): the stable identity of a definition is the
# 128-bit STABLE DIGEST of its canonical key (path + "#" + signature).
# The builder is ids.tg's stable_def_id_digested — it digests the key
# (stable_digest_of), stores the canonical key alongside the record (so a
# digest collision is detectable instead of silently mapping two
# definitions to the same id), and derives the registered id from the
# digest's LOW 64-bit word (the projection the UInt-keyed incremental
# cache maps key by). The old resolver-side FNV-1a pass (fnv1a_hash) and
# the hash + sequential-counter disambiguation is not part of the model — hashing and
# collision policy live in ids.tg only.
def compute_stable_def_id(module_path: Vec[String], name: String, signature: String) -> StableDefId
  # Build canonical path
  var path = ""
  for seg in module_path do
    if !path.is_empty() then path = path + "::" end
    path = path + seg
  end
  if !path.is_empty() then path = path + "::" end
  path = path + name

  # The canonical key (path + "#" + signature). The stable id derives ONLY
  # from this canonical string — no counters, no item indices — so it is
  # independent of the order of merged program items.
  let full = path.clone() + "#" + signature

  stable_def_id_digested(full, path)
end

def register_stable_id(inout map: StableIdMap, inout symbols: SymbolTable, node_id: Int, sink stable_id: StableDefId) -> Unit
 # (digest model): the registered id is the LOW 64-bit word of the
  # 128-bit digest of the canonical key (the record stable_def_id_digested
  # produced — stable_def_id_digest / digest_hi / digest_lo are the full
 # identity). The sequential-counter disambiguation branch is not part of the model: a
  # DIFFERENT canonical key under the same registered id is an actual
  # digest collision — an INTERNAL FAILURE — and stable_digest_verify
  # (ids.tg) is the ONLY outcome: it panics, and an order-dependent
  # alternate identity is never created. The stored canonical key makes
  # every lower-width projection collision equally detectable at lookup
  # (verify_stable_key compares the key, not the hash).
  match map.stable_keys.get(stable_id.hash)
  when Option::Some(existing) then
    if existing.clone() == stable_id.key then
      # Same canonical key re-registered (e.g. a deduplicated item):
      # keep the original hash mapping.
      map.node_to_stable.insert(node_id, stable_id)
      return
    end
    # A DIFFERENT canonical key under the same registered id: an actual
    # digest collision. The enforcement point is ids.tg's
    # stable_digest_verify — the panic is the ONLY outcome (the stored
    # key can never match the recomputed key; no counter-disambiguated
    # identity is created).
    let stored = StableDefId {
      hash: stable_id.hash,
      key: existing.clone(),
      path: stable_id.path.clone(),
      id: stable_id.id,
      digest_hi: stable_id.digest_hi,
      digest_lo: stable_id.digest_lo
    }
    stable_digest_verify(&stored, &stable_id.key)
    return
  when Option::None then
    ()
  end
  map.stable_keys.insert(stable_id.hash, stable_id.key.clone())
  map.stable_to_node.insert(stable_id.hash, node_id)
  map.node_to_stable.insert(node_id, stable_id)
end

def lookup_stable(map: StableIdMap, node_id: Int) -> Option[StableDefId]
  map.node_to_stable.get(node_id)
end

# Verify that the canonical key stored for an id is the one the caller
# recomputed. A mismatch means two distinct keys were assigned the same
# id — an internal error, not a user error. (digest model): the stored
# key is compared, never assumed — the id is the digest's low word, so
# every lower-width projection collision is equally detectable here.
def verify_stable_key(map: StableIdMap, id: UInt, expected_key: String) -> Unit
  match map.stable_keys.get(id)
  when Option::Some(stored) then
    if stored.clone() != expected_key.clone() then
      panic("internal error: stable id " + id.to_string() + " was registered for `" + stored + "` but lookup expected `" + expected_key + "`")
    end
  when Option::None then
    ()
  end  end  end
end

def lookup_by_stable_hash(map: StableIdMap, hash: UInt, expected_key: String) -> Option[Int]
  verify_stable_key(map, hash, expected_key)
  match map.stable_to_node.get(hash)
  when Option::Some(id) then Option::Some(id)
  when Option::None then Option::None
  end
end

# Check if a definition's results are still valid (fingerprint matches)
def is_cache_valid(map: StableIdMap, stable_hash: UInt, current_fingerprint: UInt) -> Bool
  match map.fingerprints.get(stable_hash)
  when Option::Some(cached) then cached == current_fingerprint
  when Option::None then false
  end  end
end

def update_fingerprint(inout map: StableIdMap, stable_hash: UInt, fingerprint: UInt) -> Unit
  map.fingerprints.insert(stable_hash, fingerprint)
end

struct ResolvedExpr
  kind: ResolvedExprKind
  module_path: Vec[String]
end

enum ResolvedExprKind
 # the LOCAL/parameter forms carry the binding's LocalId (the
  # resolver-side local identity allocated at define_local); the NAME is
  # retained for diagnostics only — identity is the id, never the name.
  LocalVar(LocalId, String)
  Parameter(LocalId, String, Int)
  Function(DefId)  # the resolved function's DefId (module + symbol index)
  Method(DefId)    # DefId from the semantic registration
                   # (module_symbols "path::Type::method" -> DefId)
  Constant(DefId)  # ID-based identity: the same DefId call_targets records
  Static(DefId)    # ID-based identity: the same DefId call_targets records
  Variant(VariantId)  #: ids.tg's VariantId { owner: TypeId, index: UInt }
                      # — the variant identity (the resolver records the
                      # per-module variant index it owns; the owner TypeId
                      # is completed by the type checker at consumption —
                      # the resolver cannot fabricate type-checker ids; see
                      # ResolvedPatternKind::Variant). The old ad hoc
                      # (DefId, UInt) form is are not part of the model.
  Field(FieldId)        # (owner TypeId, index)
end

# a successful type resolution carries ONLY the semantic identity —
# the declaration's DefId (the module-qualified TypeName entry). The
# source spelling (module path/name strings, is_builtin) is diagnostic
# metadata: it appears only in the error record of a failed resolution
# (the "unresolved type: <spelling>" / ambiguity diagnostics), never in
# the resolution record. Option::None marks a builtin type, which has no
# resolver-domain declaration (its TypeId is the type checker's
# registration).
struct ResolvedType
  def: Option[DefId]
end

struct ResolvedPattern
  kind: ResolvedPatternKind
end

enum ResolvedPatternKind
  Variable(String)
  Struct(TypeId)       # the owner struct's TypeId (checker-filled; resolver
                       # records no TypeId-domain entry — it cannot fabricate
                       # type-checker ids)
  Variant(VariantId)   # ids.tg's VariantId { owner: TypeId, index: UInt } —
                       # the TypeId-domain identity (checker-filled)
  Tuple(Vec[ResolvedPattern])
  Wildcard
end

# ———————————————————————————————————————————————————————————————
# Resolved Symbols, Scopes, and Bindings
# ———————————————————————————————————————————————————————————————

struct ResolverSymbol
  id: Int
  name: String
  is_extern: Bool
  def_span: Span
end

struct ScopeMap
  scopes: Vec[Scope]
end

struct Scope
  span: Span
  bindings: Map[String, Binding]
end

struct Binding
  name: String
  symbol_id: String
  def_span: Span
  stmt_span: Span
  assignment_count: Int
  initializer_has_side_effects: Bool
  initializer_text: String
end

def scopes_containing(self: ScopeMap, id: Int) -> Vec[Scope]
  var result = Vec::new()
  for scope in self.scopes do
    if scope.span.start <= id && id <= scope.span.end_pos then
      result.push(scope)
    end
  end
  result
end

def has_binding(self: Scope, name: String) -> Bool
  self.bindings.contains_key(&name)
end

def has_uses_after(self: ScopeMap, binding: Binding, stmts: Vec[Stmt]) -> Bool
  for stmt in stmts do
    if stmt.span.start > binding.def_span.end_pos then
      return true
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Scoped Resolution Context
# ———————————————————————————————————————————————————————————————

struct ResolutionContext
  # Symbol table being built/used
  symbols: SymbolTable

  # Current scope stack for local variables
  local_scopes: Vec[Map[String, ResolverLocalBinding]]

  # Output: resolved references
  resolved: ResolvedNames

  # Config
  prelude_imports: Vec[String]

 # the owner module path (from Program.crate, threaded by
  # resolve_program's flat-item walk) of the item whose body is currently
  # being resolved. Free-function call-target DefIds use this path as their
  # module component so they render IDENTICALLY to the item's own item_defs
  # DefId (record_item_def's owner DefId) — the MIR emission-name
  # call-site names (fn_owner_key of the InstanceId) against
  # function names (fn_owner_key of item_defs), so the two must agree.
  current_owner_path: Vec[String]

 # the OWNER MODULE of the item whose body is currently being
  # resolved (the ModuleId from Program.crate, threaded by resolve_program
  # alongside current_owner_path). Phase-3 call-target DefIds use this as
  # their module component — the DefId's owner ModuleId, never a path
  # String (ids.tg: DefId.module is a ModuleId).
  current_owner_module: ModuleId

  # Dedicated counter for runtime intrinsic DefIds (synthetic module -1)
  next_builtin_index: Int

 # the resolver-side LOCAL identity counter — define_local stamps each
  # binding with a fresh LocalId (the ids.tg LocalId domain; the type
  # checker allocates its OWN LocalIds in its own domain).
  next_local_id: Int
end

struct ResolverLocalBinding
  name: String
  kind: LocalBindingKind
  is_mut: Bool
  span: Span
 # the LOCAL identity of this binding — a fresh LocalId allocated by
  # define_local (the resolver's own counter, ctx.next_local_id). The
  # resolver's local forms (ResolvedExprKind::LocalVar / Parameter) carry
  # THIS id; the NAME is retained for diagnostics only. The type checker
  # allocates its OWN LocalIds (bind_var's counter) in its own domain —
  # the two never cross (the checker's ident resolution is
  # typed_ident_resolutions; nobody consumes the resolver's local forms
  # beyond resolution).
  local_id: LocalId
end

enum LocalBindingKind
  Variable
  Parameter(Int)  # Parameter index
  LoopVariable
  MatchBinding
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def resolve_names(program: Program) -> Result[ResolvedNames, Vec[ResolutionError]]
  var ctx = context_new()

  # Phase 1: Build symbol table from all items
  build_resolver_symbol_table(&mut ctx, program)

  # Phase 2: Resolve imports
  rs_resolve_imports(&mut ctx)

  # Phase 3: Resolve all name references
  resolve_program(&mut ctx, program)

 # (next layer): snapshot the module-qualified symbol map
  # ("path::name" -> DefId) for the type checker, which mirrors the
  # TypeName entries into its own module_type_names at type-registration
  # time (see record_module_type_name in types.tg), and the DefKind
  # metadata map (DefId carries no kind — def_kind_of consults this).
  ctx.resolved.module_symbols = ctx.symbols.module_symbols.clone()
  ctx.resolved.def_kinds = ctx.symbols.def_kinds.clone()

  if ctx.symbols.errors.is_empty() then
    Result::Ok(ctx.resolved)
  else
    Result::Err(ctx.symbols.errors)
  end
end

def context_new() -> ResolutionContext
  ResolutionContext {
    symbols: symbol_table_new(),
    local_scopes: Vec::new(),
    resolved: ResolvedNames {
      expr_resolutions: Map::new(),
      type_resolutions: Map::new(),
      pattern_resolutions: Map::new(),
      call_targets: Map::new(),
      type_def_ids: Map::new(),
      intrinsic_ids: Map::new(),
      item_defs: Map::new(),
      module_symbols: Map::new(),
      def_kinds: Map::new(),
      stable_ids: stable_id_map_new()
    },
    prelude_imports: vec!["std", "core"],
    current_owner_path: Vec::new(),
    current_owner_module: ModuleId { id: 0 },
    next_builtin_index: 0,
    next_local_id: 0
  }
end

def symbol_table_new() -> SymbolTable
  SymbolTable {
    root: module_symbols_new("".to_string(), 0),
    current_module: Vec::new(),
    module_tables: Map::new(),
    module_symbols: Map::new(),
    def_kinds: Map::new(),
    errors: Vec::new(),
    import_graph: Map::new()
  }
end

def module_symbols_new(name: String, module_id: Int) -> ModuleSymbols
  ModuleSymbols {
    name: name,
    module_id: module_id,
    types: Map::new(),
    functions: Map::new(),
    constants: Map::new(),
    statics: Map::new(),
    traits: Map::new(),
    capabilities: Map::new(),
    variants: Set::new(),
    imports: Vec::new(),
    glob_imports: Vec::new(),
    submodules: Map::new(),
    visibility: Visibility::Private,
    next_symbol_index: 0,
    symbol_indices: Map::new(),
    variant_indices: Map::new()
  }
end

# (per-module registration): the per-module symbol table for a module
# path — the owner Module's path from Program.crate (the module table
# merge_imported_deps builds) joined by "::", plus any inline module
# segments currently being processed. Every FIRST-WINS REGISTRATION
# DECISION consults this table: the (owner ModuleId, namespace, name)
# duplicate test. The table is created on first touch so every module gets
# its own independent table — a second same-named declaration in a
# DIFFERENT file module registers into ITS OWN table and its own qualified
# entry instead of failing the root bare-name occupancy.
def module_table_for(inout ctx: ResolutionContext, qualified_path: Vec[String], owner_module: ModuleId) -> ModuleSymbols
  let key = qualified_path.join("::")
  if !ctx.symbols.module_tables.contains_key(&key) then
    ctx.symbols.module_tables.insert(key.clone(), module_symbols_new(key.clone(), owner_module.id))
  end
  ctx.symbols.module_tables.get(&key).expect("per-module symbol table not found")
end

def assign_symbol_index(inout module: ModuleSymbols, name: String) -> Unit
  if !module.symbol_indices.contains_key(name) then
    module.symbol_indices.insert(name.clone(), module.next_symbol_index)
    module.next_symbol_index = module.next_symbol_index + 1
  end
end

def assign_variant_index(inout module: ModuleSymbols, name: String) -> Unit
  if !module.variant_indices.contains_key(name) then
    module.variant_indices.insert(name.clone(), module.next_symbol_index)
    module.next_symbol_index = module.next_symbol_index + 1
  end
end

# ———————————————————————————————————————————————————————————————
# DefKind metadata (DefId carries no kind)
# ———————————————————————————————————————————————————————————————

# Render the metadata key of a DefId: "<module_id>::<index>". DefId
# equality is (module, index); the DefKind is METADATA stored in the
# resolver's def_kinds map (ids.tg: "the resolver's metadata map, consulted
# by def_kind_of") — never a field of the DefId.
def def_metadata_key(did: DefId) -> String
  did.module.id.to_string() + "::" + did.index.to_string()
end

# Record the kind of a resolver-produced DefId at its construction site so
# every DefId's kind stays recoverable (module_symbols entries, item_defs,
# call targets).
def record_def_kind(inout ctx: ResolutionContext, did: DefId, kind: DefKind) -> Unit
  ctx.symbols.def_kinds.insert(def_metadata_key(did), kind)
end

# The kind of a resolver-produced DefId, from the DefKind metadata snapshot
# (ResolvedNames.def_kinds). Consumers that need a DefId's kind — the type
# checker's module-qualified lookups, the fn_owner_key rendering at the
# mangling boundary — consult this; DefId itself carries no kind.
def def_kind_of(res: ResolvedNames, did: DefId) -> Option[DefKind]
  match res.def_kinds.get(def_metadata_key(did))
  when Option::Some(k) then Option::Some(k)
  when Option::None then Option::None
  end  end
end

# ———————————————————————————————————————————————————————————————
# Phase 1: Build Symbol Table
# ———————————————————————————————————————————————————————————————

def build_resolver_symbol_table(inout ctx: ResolutionContext, program: Program) -> Unit
 # (module context): program.crate.modules is the module table — one
  # Module per module, each carrying its OWN item list (Module.items:
  # Vec[ItemId] into the flat Program.items) and path, and EVERY item
  # carries its owner ModuleId directly (Item.owner_module, stamped at the
  # module-assembly construction sites). The walk below resolves the owner
  # Module (path + ModuleId) for every top-level item — a TABLE READ via
  # module_path_of_item_resolver (item.owner_module -> crate.modules), no
  # range scan; add_item_to_symbols records each symbol in its OWNER's
  # per-module table (module_tables) and under its module-qualified key
 # "path::name" in module_symbols (: the bare-name first-wins tables are
 # are not part of the model — the qualified entries are the only resolution authority).
  var item_idx = 0
  while item_idx < program.items.len() do
    let (owner_path, owner_module) = module_path_of_item_resolver(program, item_idx)
    let item = program.items[item_idx]
    add_item_to_symbols(ctx, &item, &owner_path, owner_module)
    record_item_def(ctx, &item, item_idx, &owner_path, owner_module)
    item_idx = item_idx + 1
  end
end

# Record the DefId of every item that owns symbols (functions, methods,
# statics, constants) keyed by its index in the merged Program.items. The
# DefId's module (the owner's ModuleId from Program.crate) + per-module
# symbol index make the key unique across all files merged into one
# compilation (see ResolvedNames.item_defs). the DefId's module is
# the item's OWNER ModuleId (threaded by build_resolver_symbol_table) and
# the index comes from the OWNER's per-module table (module_tables) —
# IDENTICAL to the module component and index of the same function's
# module_symbols DefId (add_item_to_symbols's qualified entry), so the
# ownership-layer key rendered from item_defs identifies the
# module-qualified function, not just a per-module index. The DefKind is
# recorded as metadata (def_kinds) — DefId carries no kind.
def record_item_def(inout ctx: ResolutionContext, item: Item, item_idx: Int, owner_path: Vec[String], owner_module: ModuleId) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    # Free function: a single-element DefId vector (the value type is
    # Vec[DefId]; inserting a bare DefId would be a type error).
    let module = module_table_for(ctx, owner_path, owner_module)
 # EVERY top-level function gets a DefId. The normal case is the
    # name's registered per-module symbol index; when the name is already in
    # use within the SAME module (a same-module duplicate, or a cross-kind
    # collision — the per-module tables are first-wins), a fresh index is
    # allocated from the module's counter. The index is metadata-only (never
    # consulted by resolution), so first-wins semantics are untouched — but
    # the OWNERSHIP layer needs the entry: the type checker, resource
    # checker and MIR all key their owner-key derivations off item_defs,
    # and a missing entry would force their name/positional fallbacks to
    # diverge (MIR's positional fallback would miss the checker's
    # name-based finalize-plan key and error out).
    let f_idx = match symbol_index_of(module, &f.name)
    when Option::Some(midx) then midx
    when Option::None then
      let fresh = module.next_symbol_index as UInt
      module.next_symbol_index = module.next_symbol_index + 1
      fresh
    end
    var fn_defs = Vec::new()
    let f_did = DefId {
      module: owner_module,
      index: f_idx
    }
    record_def_kind(ctx, &f_did, DefKind::Function)
    fn_defs.push(f_did)
    ctx.resolved.item_defs.insert(item_idx, fn_defs)
  when ItemKind::ItemStruct(s) then
    # Collect ALL method DefIds into one vector, then insert once — inserting
 # per method would overwrite the preceding method's entry.: the
    # method DefIds come from the SEMANTIC registration — the module_symbols
    # entries add_item_to_symbols registered for the struct methods
    # ("path::StructName::method", MODULE-QUALIFIED by the item's owner
    # path) — the bare-keyed method table is are not part of the model.
    var method_ids_vec = Vec::new()
    var mi = 0
    while mi < s.methods.len() do
      let m = s.methods[mi]
      let key = s.name.clone() + "::" + m.name.clone()
      let qualified = module_qualified_key(owner_path, &key)
      match ctx.symbols.module_symbols.get(qualified)
      when Option::Some(did) then
        method_ids_vec.push(did.clone())
      when Option::None then ()
      end
      mi = mi + 1
    end
    ctx.resolved.item_defs.insert(item_idx, method_ids_vec)
  when ItemKind::ItemImpl(imp) then
    var impl_defs = Vec::new()
    var mi2 = 0
    while mi2 < imp.methods.len() do
      let m2 = imp.methods[mi2]
      let key2 = type_expr_to_string(&imp.for_type) + "::" + m2.name.clone()
      let qualified2 = module_qualified_key(owner_path, &key2)
      match ctx.symbols.module_symbols.get(qualified2)
      when Option::Some(did2) then
        impl_defs.push(did2.clone())
      when Option::None then ()
      end
      mi2 = mi2 + 1
    end
    ctx.resolved.item_defs.insert(item_idx, impl_defs)
  when _ then ()
  end  end
end

# the ownership layer's per-item DefId lookup by flat item index. The
# per-item DefId structure is ResolvedNames.item_defs (item index -> DefIds
# in declaration order; a free function is a single-element vector, methods
# follow in declaration order), recorded by record_item_def. Returns the
# FIRST recorded DefId (a free function's own DefId) and Option::None for
# items that recorded none — the same map the type checker, resource checker
# and MIR consume, so the DefId-derived owner key never diverges across the
# three consumers.
def def_id_of_item(resolved: ResolvedNames, item_idx: Int) -> Option[DefId]
  match resolved.item_defs.get(item_idx)
  when Option::Some(dids) then
    if dids.len() > 0 then
      Option::Some(dids[0].clone())
    else
      Option::None
    end
  when Option::None then Option::None
  end  end
end

# (module graph consumption): the resolver-side mirror of the type
# checker's module_path_of_item (types.tg) — the owner module identity of a
# flat item index. (table read — NO range scan): every item carries its
# OWNER ModuleId directly (Item.owner_module, stamped at the module-assembly
# construction sites — the parser's make_item defaults to the root module,
# compiler_core's collect_dep_file stamps each dependency item with its file
# module's ModuleId), so the owner is read off the item and the owner
# Module's path comes from Program.crate.modules by key — the Crate
# merge_imported_deps builds: one Module per distinct module, each carrying
# its OWN item list (Module.items: Vec[ItemId]) and path. STRICT (the
# compile path): a missing module table entry is an internal compiler
# error — it never falls back to the root module, id 0, empty path (a
# stamped owner that is not a Crate.modules key is a module-graph identity
# loss). Returns the owner path and the owner ModuleId — the (owner
# ModuleId,...) component of the per-module duplicate test.
def module_path_of_item_resolver(program: Program, item_idx: Int) -> (Vec[String], ModuleId)
  let owner = program.items[item_idx].owner_module
  match program.crate.modules.get(owner)
  when Option::Some(info) then
    var owner_path = Vec::new()
    for seg in info.path do
      owner_path.push(seg.clone())
    end
    (owner_path, owner)
  when Option::None then
    panic("internal error: ModuleId " + owner.id.to_string() + " (owner of item " + item_idx.to_string() + ") is not a key of Crate.modules — the compile path never falls back to the root module")
  end
end

def module_name_in_use(module: ModuleSymbols, name: String) -> Bool
  module.functions.contains_key(name) ||
  module.types.contains_key(name) ||
  module.constants.contains_key(name) ||
  module.statics.contains_key(name) ||
  module.traits.contains_key(name) ||
  module.capabilities.contains_key(name) ||
  module.submodules.contains_key(name)
end

# the module-qualified symbol key "path::name" for SymbolTable
#.module_symbols. The path comes from the owner Module (Program.crate);
# root-module symbols (empty path) degenerate to the bare name (: the
# bare-name first-wins table they used to superset is are not part of the model — these
# entries ARE the resolution authority now).
def module_qualified_key(qualified_path: Vec[String], name: String) -> String
  let joined = qualified_path.join("::")
  if joined.is_empty() then
    name.clone()
  else
    joined + "::" + name
  end
end

# (next layer): lookup a module-qualified symbol by its exact owner
# path and bare name — the "path::name" key form module_symbols uses. The
# path is the owner Module's path from Program.crate (plus any inline
# module segments); the root module's empty path degenerates to the bare
# name, matching module_qualified_key. Returns the DefId registered for
# exactly this (path, name) pair, or None if no such symbol exists.
def lookup_module_symbol(symbols: SymbolTable, path: Vec[String], name: String) -> Option[DefId]
  let key = module_qualified_key(path, &name)
  symbols.module_symbols.get(key)
end

# Module-qualified CALLABLE lookup — the module_symbols
# entry for exactly this (path, name) pair, filtered to the requested DefKind
# (Function/Constant/Static). The kind filter guarantees a type name and a
# function name never collide through this path, even when the same bare
# name serves both roles in different modules. The type checker consumes
# this for its function/const/static bare-name identity: the current
# module's own qualified definition shadows other modules' same-named
# definitions, and a bare name with >= 2 DISTINCT qualified definitions is
# ambiguous (see resolve_bare_callable in types.tg). the kind is
# metadata (def_kinds — DefId carries no kind), and the first parameter is
# the snapshot (ResolvedNames) or the live table (SymbolTable); both carry
# module_symbols + def_kinds.
def lookup_module_callable(symbols: SymbolTable, path: Vec[String], name: String, kind: DefKind) -> Option[DefId]
  let key = module_qualified_key(path, &name)
  match symbols.module_symbols.get(key)
  when Option::Some(did) then
    let did_kind = match symbols.def_kinds.get(def_metadata_key(did))
    when Option::Some(k) then k
    when Option::None then DefKind::Other
    end
    if did_kind == kind then
      Option::Some(did)
    else
      Option::None
    end
  when Option::None then
    Option::None
  end
end

# (next layer): recover the module path segments recorded for a DefId
# by parsing the module_symbols keys ("path::name"): find the key whose
# value is the given DefId and strip the trailing "::name" (rfind = last
# separator, so paths containing "::" are handled). The root module's
# bare key (no separator) yields an empty path. Returns an empty path if
# the DefId was never registered in module_symbols. DefId equality
# is (module, index) — module is a ModuleId (compared by id); the kind is
# metadata and does not participate.
def module_path_of(symbols: SymbolTable, def_id: DefId) -> Vec[String]
  for (key, did) in symbols.module_symbols.entries() do
    if did.module.id == def_id.module.id && did.index == def_id.index then
      match key.rfind("::")
      when Option::Some(pos) then
        return key.slice(0, pos).split("::")
      when Option::None then
        return Vec::new()
      end
    end
  end
  Vec::new()
end

# The module-qualified key of the CURRENT module's own qualified
# definition of a bare name: the owner file path (ctx.current_owner_path,
# threaded by resolve_program) plus the inline-module nesting
# (symbols.current_module) — the exact composition add_item_to_symbols
# registers the item's "path::name" key with, so the own-entry test
# compares the same spelling.
def current_module_qualified_key(ctx: ResolutionContext, name: String) -> String
  var full = ctx.current_owner_path.clone()
  for seg in ctx.symbols.current_module do
    full.push(seg.clone())
  end
  module_qualified_key(&full, name)
end

# ———————————————————————————————————————————————————————————————
# the bare-name 0/1/>1 resolution rule
# ———————————————————————————————————————————————————————————————
#
# A bare name resolves ONLY against the DISTINCT module-qualified
# definitions (SymbolTable.module_symbols — "path::name" -> DefId — with
# the DefKind metadata from def_kinds):
#   - the CURRENT module's own qualified definition shadows the others
#     (the per-module tables are first-wins, so there is at most one own
#     entry);
#   - with no own definition: 0 candidates -> the caller falls through to
#     the next authority (imports); exactly 1 -> that definition;
#     >= 2 -> AMBIGUOUS — the ambiguity diagnostic is recorded and is the
#     ONLY outcome. A first-wins pick is NEVER made (the bare-name
#     root-tree compatibility tables).

# The outcome of a bare-name resolution.
enum BareNameResolution
  NoCandidate            # 0 DISTINCT qualified definitions — the caller
                         # falls through to the next authority (imports)
  Resolved(DefId)        # exactly 1 — the definition's DefId
  Ambiguous              # >= 2 — the ambiguity diagnostic was recorded;
                         # resolution is FINAL (no pick, ever)
end

# The 0/1/>1 rule: the current module's own qualified definition wins
# when present; otherwise 0 -> NoCandidate, 1 -> Resolved, >= 2 ->
# Ambiguous (the diagnostic is recorded and NO definition is returned —
# the first-wins fallback is are not part of the model). Candidates are the DISTINCT
# module_symbols entries whose key IS the bare name (the root module's
# empty path degenerates to it) or ends with "::" + name, filtered by
# DefKind (metadata — DefId carries no kind); entries are deduplicated by
# the DefId (module id + index).
def bare_name_resolve(inout ctx: ResolutionContext, name: String, kinds: Vec[DefKind], span: Span) -> BareNameResolution
  let own_key = current_module_qualified_key(ctx, name)
  var own_did = Option::None
  var foreign = Vec::new()
  var foreign_seen = Map::new()
  let suffix = "::" + name.clone()
  for (key, did) in ctx.symbols.module_symbols.entries() do
    var matches = false
    if key == name.clone() then
      matches = true
    elsif key.ends_with(suffix) then
      matches = true
    end
    if matches then
      let did_kind = match ctx.symbols.def_kinds.get(def_metadata_key(did))
      when Option::Some(k) then k
      when Option::None then DefKind::Other
      end
      var kind_found = false
      var ki = 0
      while ki < kinds.len() do
        if kinds[ki] == did_kind then kind_found = true end
        ki = ki + 1
      end
      if kind_found then
        if key == own_key then
          own_did = Option::Some(did.clone())
        else
          let dkey = def_metadata_key(did)
          if !foreign_seen.contains_key(&dkey) then
            foreign_seen.insert(dkey, true)
            foreign.push(did.clone())
          end
        end
      end
    end
  end
  match own_did
  when Option::Some(did) then
    BareNameResolution::Resolved(did)
  when Option::None then
    if foreign.len() == 0 then
      BareNameResolution::NoCandidate
    elsif foreign.len() == 1 then
      BareNameResolution::Resolved(foreign[0].clone())
    else
      # The ambiguity diagnostic — the ONLY outcome of >= 2 DISTINCT
      # qualified definitions; the first-wins fallback is are not part of the model.
      rs_add_error(&mut ctx.symbols, ResolutionErrorKind::AmbiguousName,
        "ambiguous name `" + name + "`: " + foreign.len().to_string() + " distinct modules define it; qualify the path", span.clone())
      BareNameResolution::Ambiguous
    end
  end
end

def add_item_to_symbols(inout ctx: ResolutionContext, item: Item, module_path: Vec[String], owner_module: ModuleId) -> Unit
# the module-qualified path of this item's owner — the Module's
  # path from Program.crate (file-level module identity) plus any inline
  # module segments the resolver is currently inside. The FIRST-WINS
  # REGISTRATION DECISION for the item consults the per-module table for
  # this path (module_tables — the (owner ModuleId, namespace, name)
  # duplicate test), NOT the root bare-name occupancy, so a second
  # same-named declaration in a DIFFERENT file module registers its own
  # qualified entry ("path::name" in symbols.module_symbols) instead of
 # failing the root occupancy test first.: the root bare-name
 # first-wins mirror (the "module" tree name maps) are not part of the model — the
  # per-module tables + module_symbols are the only registration
  # authority; the root tree survives ONLY as the inline-module
  # structure (submodules) and the import lists (imports/glob_imports).
  var qualified_path = module_path.clone()
  for seg in ctx.symbols.current_module do
    qualified_path.push(seg.clone())
  end
  var qualified_regs = Vec::new()
 # The root-tree current module (inline-nested): it carries NO name
  # maps anymore (the bare-name mirror is are not part of the model) — it survives ONLY as
  # the inline-module structure (ItemModule's submodule registration) and
  # the import lists (ItemUse).
  let module = get_current_module(&mut ctx.symbols)
  let mtab = module_table_for(ctx, &qualified_path, owner_module)

  match item.kind
  when ItemKind::ItemFunction(f) then
    let sym = FunctionSymbol {
      name: f.name.clone(),
      params: extract_params(&f.params),
      return_type: f.ret_type.clone(),
      type_params: extract_type_params(&f.generic_params),
      visibility: f.vis,
      is_method: false,
      receiver_type: Option::None,
      span: item.span.clone()
    }

    if !module_name_in_use(mtab, &f.name) then
      mtab.functions.insert(f.name.clone(), sym.clone())
      assign_symbol_index(mtab, &f.name)
      match symbol_index_of(mtab, &f.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::Function)
        qualified_regs.push((module_qualified_key(&qualified_path, &f.name), did))
      when Option::None then ()
      end
    end

  when ItemKind::ItemStruct(s) then
    let sym = TypeDefSymbol {
      name: s.name.clone(),
      kind: TypeDefSymbolKind::Struct,
      type_params: extract_type_params(&s.generic_params),
      visibility: s.vis,
      span: item.span.clone()
    }

    if !module_name_in_use(mtab, &s.name) then
      mtab.types.insert(s.name.clone(), sym.clone())
      assign_symbol_index(mtab, &s.name)
      match symbol_index_of(mtab, &s.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::TypeName)
        qualified_regs.push((module_qualified_key(&qualified_path, &s.name), did))
      when Option::None then ()
      end
    end

 # (item 2 audit — struct-defined methods): register every struct
    # method under its "StructName::method" key with ONE DefId — the same
    # id goes to module_symbols (the qualified entry below — the SEMANTIC
    # registration record_item_def's ItemStruct arm reads) and the method
    # metadata — so a struct-defined method never splits into two DefIds.
 # Per-module first-wins. The bare-keyed method table
    # is are not part of the model; the module_symbols qualified entries are the authority.
    for m in s.methods do
      let mkey = s.name.clone() + "::" + m.name.clone()
      let msym = FunctionSymbol {
        name: m.name.clone(),
        params: extract_params(&m.params),
        return_type: m.ret_type.clone(),
        type_params: extract_type_params(&m.generic_params),
        visibility: m.vis,
        is_method: true,
        receiver_type: Option::Some(s.name.clone()),
        span: m.span.clone()
      }
      if !module_name_in_use(mtab, &mkey) then
        mtab.functions.insert(mkey.clone(), msym.clone())
        assign_symbol_index(mtab, &mkey)
        match symbol_index_of(mtab, &mkey)
        when Option::Some(midx) then
          let mdid = DefId {
            module: owner_module,
            index: midx
          }
          record_def_kind(ctx, &mdid, DefKind::Method)
          qualified_regs.push((module_qualified_key(&qualified_path, &mkey), mdid.clone()))
        when Option::None then ()
        end
      end
    end

  when ItemKind::ItemEnum(e) then
    let sym = TypeDefSymbol {
      name: e.name.clone(),
      kind: TypeDefSymbolKind::Enum,
      type_params: extract_type_params(&e.generic_params),
      visibility: e.vis,
      span: item.span.clone()
    }

    if !module_name_in_use(mtab, &e.name) then
      mtab.types.insert(e.name.clone(), sym.clone())
      assign_symbol_index(mtab, &e.name)
      match symbol_index_of(mtab, &e.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::TypeName)
        qualified_regs.push((module_qualified_key(&qualified_path, &e.name), did))
      when Option::None then ()
      end
    end
    # Record every variant name so bare references (`Some`, `None`, `Zero`)
    # in expression position resolve as enum variants. The per-module
    # variant table owns the decision and the variant index (the DefId
    # identity).
    for v in e.variants do
      if !mtab.variants.contains(&v.name) then
        mtab.variants.insert(v.name.clone())
        assign_variant_index(mtab, &v.name)
        match variant_index_of(mtab, &v.name)
        when Option::Some(vidx) then
          let vdid = DefId {
            module: owner_module,
            index: vidx
          }
          record_def_kind(ctx, &vdid, DefKind::EnumVariant)
          qualified_regs.push((module_qualified_key(&qualified_path, &v.name), vdid))
        when Option::None then ()
        end
      end
    end

  when ItemKind::ItemTrait(t) then
    let sym = TraitSymbol {
      name: t.name.clone(),
      type_params: extract_type_params(&t.generic_params),
      super_traits: extract_super_traits(&t.super_traits),
      methods: extract_method_names(&t.methods),
      visibility: t.vis,
      span: item.span.clone()
    }

    if !module_name_in_use(mtab, &t.name) then
      mtab.traits.insert(t.name.clone(), sym.clone())
      assign_symbol_index(mtab, &t.name)
 # (module-semantic trait identity): every trait declaration
      # registers its module-qualified qualified entry ("path::name" ->
      # DefId, DefKind::Trait metadata) exactly like types and callables —
      # the same (module, name) qualified-key registration machinery
      # (module_symbols + def_kinds), so trait names resolve
      # module-semantically: an import brings the trait into scope and two
      # traits with the same name in different modules are distinct. The
      # type checker mirrors these entries into its module-qualified map
      # at trait-registration time (record_module_type_name's Trait guard)
      # and derives the TraitId from the declaration identity.
      match symbol_index_of(mtab, &t.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::Trait)
        qualified_regs.push((module_qualified_key(&qualified_path, &t.name), did))
      when Option::None then ()
      end
    end

  when ItemKind::ItemImpl(impl_block) then
    # Process impl items as methods
    for f in impl_block.methods do
      let sym = FunctionSymbol {
        name: f.name.clone(),
        params: extract_params(&f.params),
        return_type: f.ret_type.clone(),
        type_params: extract_type_params(&f.generic_params),
        visibility: f.vis,
        is_method: true,
        receiver_type: Option::Some(type_expr_to_string(&impl_block.for_type)),
        span: f.span.clone()
      }
      # Store with qualified name: Type::method (first definition wins per
      # module — the per-module table owns the decision).
      let key = type_expr_to_string(&impl_block.for_type) + "::" + f.name
      if !module_name_in_use(mtab, &key) then
        mtab.functions.insert(key.clone(), sym.clone())
        assign_symbol_index(mtab, &key)
        match symbol_index_of(mtab, &key)
        when Option::Some(midx) then
 # (item 2 — the impl-method DefId split): construct the
          # method DefId ONCE with the owner module's ModuleId and
          # per-module index, and insert THE SAME did into module_symbols
          # (the qualified entry below — the SEMANTIC registration
          # record_item_def's ItemImpl arm reads) and the method metadata
 # — a method never gets two different DefIds.: the
          # bare-keyed method table is are not part of the model; the qualified
          # entries are the authority. The kind is recorded as metadata
          # (DefId carries no kind).
          let did = DefId {
            module: owner_module,
            index: midx
          }
          record_def_kind(ctx, &did, DefKind::Method)
          qualified_regs.push((module_qualified_key(&qualified_path, &key), did.clone()))
        when Option::None then ()
        end
      end
    end

  when ItemKind::ItemUse(use_decl) then
    let imports = flatten_use_decl(&use_decl, Vec::new())
    # Shared iteration is projected: clone each import into the module's
    # table (consuming iteration is not supported yet).
    for import in imports do
      module.imports.push(import.clone())
    end

  when ItemKind::ItemConst(c) then
    let csym = ConstantSymbol {
      name: c.name.clone(),
      ty: match c.ty
      when Option::Some(ty_expr) then Option::Some(ty_expr.clone())
      when Option::None then Option::None
      end,
      visibility: c.vis,
      span: item.span.clone()
    }
    if !module_name_in_use(mtab, &c.name) then
      mtab.constants.insert(c.name.clone(), csym.clone())
      assign_symbol_index(mtab, &c.name)
      match symbol_index_of(mtab, &c.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::Constant)
        qualified_regs.push((module_qualified_key(&qualified_path, &c.name), did))
      when Option::None then ()
      end
    end

  when ItemKind::ItemModule(m) then
    # Register a submodule (merged programs keep items flat, so this is
    # typically a no-op container), then register the module's nested
    # items so every declaration is registered exactly once in this
    # first pass. The inline module inherits the enclosing FILE module's
    # ModuleId (inline modules are not separate file modules); its NAME is
    # still registered in the per-module table so a same-file declaration
    # colliding with the module name is caught by the per-module test.
    if !module.submodules.contains_key(m.name.clone()) then
      let sub = module_symbols_new(m.name.clone(), owner_module.id)
      module.submodules.insert(m.name.clone(), sub)
    end
    if !mtab.submodules.contains_key(m.name.clone()) then
      mtab.submodules.insert(m.name.clone(), module_symbols_new(m.name.clone(), owner_module.id))
    end
    ctx.symbols.current_module.push(m.name.clone())
    for inner in m.items do
      add_item_to_symbols(ctx, &inner, module_path, owner_module)
    end
    let _ = ctx.symbols.current_module.pop()

  when ItemKind::ItemStatic(s) then
    let sym = StaticSymbol {
      name: s.name.clone(),
      ty: Option::Some(s.ty.clone()),
      is_mut: s.is_mut,
      visibility: s.vis,
      span: item.span.clone()
    }
    if !module_name_in_use(mtab, &s.name) then
      mtab.statics.insert(s.name.clone(), sym.clone())
      assign_symbol_index(mtab, &s.name)
      match symbol_index_of(mtab, &s.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::Static)
        qualified_regs.push((module_qualified_key(&qualified_path, &s.name), did))
      when Option::None then ()
      end
    end

  when ItemKind::ItemTypeAlias(t) then
    let sym = TypeDefSymbol {
      name: t.name.clone(),
      kind: TypeDefSymbolKind::TypeAlias,
      type_params: extract_type_params(&t.generic_params),
      visibility: t.vis,
      span: item.span.clone()
    }
    if !module_name_in_use(mtab, &t.name) then
      mtab.types.insert(t.name.clone(), sym.clone())
      assign_symbol_index(mtab, &t.name)
      match symbol_index_of(mtab, &t.name)
      when Option::Some(idx) then
        let did = DefId {
          module: owner_module,
          index: idx
        }
        record_def_kind(ctx, &did, DefKind::TypeName)
        qualified_regs.push((module_qualified_key(&qualified_path, &t.name), did))
      when Option::None then ()
      end
    end

  when ItemKind::ItemExternBlock(ext) then
    for extern_item in ext.items do
      match extern_item
      when ExternItem::Function(f) then
        let sym = FunctionSymbol {
          name: f.name.clone(),
          params: extract_params(&f.params),
          return_type: f.ret_type.clone(),
          type_params: Vec::new(),
          visibility: Visibility::Public,
          is_method: false,
          receiver_type: Option::None,
          span: f.span.clone()
        }
        if !module_name_in_use(mtab, &f.name) then
          mtab.functions.insert(f.name.clone(), sym.clone())
          assign_symbol_index(mtab, &f.name)
          match symbol_index_of(mtab, &f.name)
          when Option::Some(idx) then
            let did = DefId {
              module: owner_module,
              index: idx
            }
            record_def_kind(ctx, &did, DefKind::Function)
            qualified_regs.push((module_qualified_key(&qualified_path, &f.name), did))
          when Option::None then ()
          end
        end
      when ExternItem::Static(s) then
        let sym = StaticSymbol {
          name: s.name.clone(),
          ty: Option::Some(s.ty.clone()),
          is_mut: s.is_mut,
          visibility: Visibility::Public,
          span: s.span.clone()
        }
        if !module_name_in_use(mtab, &s.name) then
          mtab.statics.insert(s.name.clone(), sym.clone())
          assign_symbol_index(mtab, &s.name)
          match symbol_index_of(mtab, &s.name)
          when Option::Some(idx) then
            let did = DefId {
              module: owner_module,
              index: idx
            }
            record_def_kind(ctx, &did, DefKind::Static)
            qualified_regs.push((module_qualified_key(&qualified_path, &s.name), did))
          when Option::None then ()
          end
        end
      end
    end

  when ItemKind::ItemCapabilityDecl(cap) then
    let csym = CapabilitySymbol {
      name: cap.name.clone(),
      visibility: cap.vis,
      span: item.span.clone()
    }
    if !module_name_in_use(mtab, &cap.name) then
      mtab.capabilities.insert(cap.name.clone(), csym.clone())
      assign_symbol_index(mtab, &cap.name)
    end
 # capabilities get no module-qualified entry yet — DefKind
    # (ids.tg) has no Capability variant; they arrive with the Crate
    # when the kind set is extended.

  when _ then ()
  end

 # flush the module-qualified keys into the symbol table. The
  # per-module tables above own the first-wins REGISTRATION decision; this
# flush records the qualified IDENTITY — "path::name" with the path of
  # the owner Module and the per-module symbol index — so same-named
 # items in different modules are distinguishable.: the bare-name
  # first-wins tables are is not part of the model — this flush is the ONLY authority.
  for reg in qualified_regs do
    ctx.symbols.module_symbols.insert(reg.0.clone(), reg.1.clone())
  end
end

def get_current_module(inout symbols: SymbolTable) -> ModuleSymbols
  var module = symbols.root
  for segment in symbols.current_module do
    module = module.submodules.get(&segment).expect("module not found")
  end
  module
end

def extract_params(params: Vec[Param]) -> Vec[(String, Option[TypeExpr])]
  var result = Vec::new()
  for p in params do
    result.push((p.name.clone(), p.ty.clone()))
  end
  result
end

def extract_type_params(params: Vec[GenericParam]) -> Vec[String]
  var result = Vec::new()
  for p in params do
    result.push(p.name.clone())
  end
  result
end

def extract_super_traits(super_traits: Vec[TypeExpr]) -> Vec[String]
  var result = Vec::new()
  for super_trait in super_traits do
    result.push(type_expr_to_string(&super_trait))
  end
  result
end

def extract_method_names(methods: Vec[TraitMethod]) -> Vec[String]
  var result = Vec::new()
  for m in methods do
    result.push(m.sig.name.clone())
  end
  result
end

def type_expr_to_string(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      name.clone() + "[...]"
    end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Unit then "Unit".to_string()
  when TypeExprKind::Never then "Never".to_string()
  when _ then "<type>".to_string()
  end  end
end

def flatten_use_decl(use_decl: UseDecl, prefix: Vec[String]) -> Vec[ImportSymbol]
  var result = Vec::new()

  # Build the full path from prefix + use_decl path segments
  var full_path = prefix.clone()
  for segment in use_decl.path.segments do
    full_path.push(segment.clone())
  end

  if use_decl.glob then
    # Glob import: use foo::bar::*
    result.push(ImportSymbol {
      path: full_path,
      alias_name: Option::None,
      is_glob: true,
      span: use_decl.span.clone()
    })
  else
    match use_decl.names
    when Option::Some(names) then
      # Named imports: use foo::bar::{Baz, Qux}
      for name in names do
        var item_path = full_path.clone()
        item_path.push(name.clone())
        result.push(ImportSymbol {
          path: item_path,
          alias_name: Option::None,
          is_glob: false,
          span: use_decl.span.clone()
        })
      end
    when Option::None then
      # Single import: use foo::bar or use foo::bar as alias
      result.push(ImportSymbol {
        path: full_path,
        alias_name: use_decl.alias_name.clone(),
        is_glob: false,
        span: use_decl.span.clone()
      })
    end
  end

  result
end

# ———————————————————————————————————————————————————————————————
# Phase 2: Resolve Imports
# ———————————————————————————————————————————————————————————————

def rs_resolve_imports(inout ctx: ResolutionContext) -> Unit
  resolve_module_imports(&mut ctx.symbols, &mut ctx.symbols.root, Vec::new())
end

def resolve_module_imports(inout symbols: SymbolTable, inout module: ModuleSymbols,
                           path: Vec[String]) -> Unit
  for import in module.imports do
    # Check for cycles
    let path_str = path.join("::")
    let import_str = import.path.join("::")

    if cycle_in_import_graph(symbols, &path_str, &import_str) then
      rs_add_error(symbols, ResolutionErrorKind::CyclicImport,
        "cyclic import detected: " + import_str, import.span.clone())
      next
    end

    # Add to import graph
    match symbols.import_graph.get(&path_str)
    when Option::Some(deps) then
      var new_deps = deps
      new_deps.insert(import_str.clone())
      symbols.import_graph.insert(path_str.clone(), new_deps)
    when Option::None then
      var deps = Set::new()
      deps.insert(import_str.clone())
      symbols.import_graph.insert(path_str.clone(), deps)
    end

    # Verify import exists
    if !resolve_import_path(symbols, &import.path) then
      rs_add_error(symbols, ResolutionErrorKind::UnresolvedImport,
        "unresolved import: " + import_str, import.span.clone())
    end
  end

  # Recurse into submodules
  for entry in module.submodules.entries() do
    let name = entry.0
    let submod = entry.1
    var sub_path = path.clone()
    sub_path.push(name.clone())
    resolve_module_imports(symbols, submod, sub_path)
  end
end

def cycle_in_import_graph(symbols: SymbolTable, from: String, to: String) -> Bool
  # Check if adding edge from->to would create a cycle
  # by checking if 'to' can reach 'from'
  var visited = Set::new()
  var stack = Vec::new()
  stack.push(to.clone())

  while !stack.is_empty() do
    let current = match stack.pop()
    when Option::Some(value) then value
    when Option::None then break
    end

    if current == from.clone() then
      return true
    end

    if visited.contains(&current) then
      next
    end
    visited.insert(current.clone())

    match symbols.import_graph.get(&current)
    when Option::Some(deps) then
      for dep in deps do
        stack.push(dep.clone())
      end
    when Option::None then ()
    end
  end

  false
end

# DFS helper: detect cycle starting from a single node
def detect_cycles_from(symbols: SymbolTable, start: String,
                       inout visited: Set[String], inout in_stack: Set[String],
                       inout path: Vec[String], inout cycles: Vec[Vec[String]]) -> Unit
  visited.insert(start.clone())
  in_stack.insert(start.clone())
  path.push(start.clone())

  let deps_opt = symbols.import_graph.get(start)
  match deps_opt
  when Option::Some(deps) then
    for dep in deps do
      if in_stack.contains(&dep) then
        # Found a back-edge: extract the cycle
        var cycle = Vec::new()
        var found = false
        for p_node in path do
          if p_node == dep then
            found = true
          end
          if found then
            cycle.push(p_node.clone())
          end
        end
        cycles.push(cycle)
      end
      if !visited.contains(&dep) then
        detect_cycles_from(symbols, &dep, visited, in_stack, path, cycles)
      end
    end
  when Option::None then ()
  end

  let _ = path.pop()
  in_stack.remove(start)
end

# Detect all import cycles in the full import graph via DFS
def detect_all_import_cycles(symbols: SymbolTable) -> Vec[Vec[String]]
  var visited = Set::new()
  var in_stack = Set::new()
  var path = Vec::new()
  var cycles = Vec::new()

  for entry in symbols.import_graph do
    let node = entry.0
    if !visited.contains(node) then
      detect_cycles_from(symbols, node, &mut visited, &mut in_stack,
                         &mut path, &mut cycles)
    end
  end

  cycles
end

def resolve_import_path(symbols: SymbolTable, path: Vec[String]) -> Bool
  if path.is_empty() then return false end

  let known_compiler = [
    "access_check", "ast", "ids", "token", "lexer", "parser", "types", "trait_resolve",
    "resolver", "mir", "mono", "codegen", "asm", "object",
    "linker", "driver", "formatter", "linter", "docgen", "cqs",
    "coverage", "agentic", "symbol_graph", "context_pack",
    "refactor", "mode", "lib", "cap_baseline",
    "layout_engine", "runtime", "version", "lib_kernel"
  ]

  # Check built-in modules — validate sub-path structure
  let first = path[0]
  if first == "std" then
    if path.len() < 2 then return false end
    let component = path[1].clone()
    let known_std = [
      "core", "collections", "io", "fs", "net", "http", "async",
      "thread", "time", "fmt", "json", "toml", "regex", "crypto",
      "log", "test", "bench", "env", "cli", "url", "db", "web",
      "ui", "compress", "serde", "unicode", "locale", "ffi",
      "alloc", "backtrace", "budget", "capabilities", "contracts",
      "effects", "profile", "replay", "secure_types", "snapshot",
      "supply_chain", "taint", "test_gen", "semantic_diff",
      "args", "process", "gfx_errors"
    "audio", "auth", "blas", "budget", "cbor", "cli", "compress", "config", "contracts", "crypto", "csv", "db", "debug", "doc_gen", "effects", "embedded", "encoding", "exec", "fft", "float_control", "fuzz", "gfx", "gfx_gpu", "geom", "graph", "gui", "hal", "hash", "http2", "image", "input", "linalg", "lint", "log", "lsp", "math", "metrics", "migrate", "mmap", "net", "obligations", "opentelemetry", "patch", "path", "platform", "postgres", "profile", "random", "regex", "registry", "secure_types", "semver", "serde", "signal", "snapshot", "sql", "supply_chain", "sync", "tensor", "test", "tls", "toml", "tui", "ui", "validation", "wasm", "wasm_js", "web", "web_ext", "web_server", "websocket", "window", ]
    return known_std.contains(&component)
  end
  if first == "tg_compiler" then
    if path.len() < 2 then return false end
    let component = path[1].clone()
    return known_compiler.contains(&component)
  end
  # Bare compiler-module first segment (`use version::{...}` inside the
  # compiler): accept it, then validate the remaining path against the flat
  # root symbol table.
  if known_compiler.contains(&first.clone()) then
    if path.len() < 2 then return false end
    return true
  end

  # Try to find in symbol table
  var module = symbols.root
  for segment in path do
    match module.submodules.get(&segment)
    when Option::Some(submod) then module = submod
    when Option::None then
 # the import target is verified against the module-qualified
      # authority — the full "path::name" key in module_symbols (the
      # bare-name root-tree name maps). The inline-module
      # item keys and the file-module item keys are both "path::name"
      # spellings, so one check covers them.
      if symbols.module_symbols.contains_key(&path.join("::")) then
        return true
      end
      return false
    end
  end

  true
end

# ———————————————————————————————————————————————————————————————
# Phase 3: Resolve References
# ———————————————————————————————————————————————————————————————

def resolve_program(inout ctx: ResolutionContext, program: Program) -> Unit
  # All declarations were registered once during symbol-table construction
  # (build_resolver_symbol_table). This phase only resolves bodies and impl
  # blocks, which may reference later-defined items.
 # the flat-item walk threads each item's OWNER module path (the same
  # module_path_of_item_resolver table read build_resolver_symbol_table uses
  # — item.owner_module -> crate.modules, no range scan) into
  # ctx.current_owner_path, so free-function call-target DefIds recorded
  # while resolving this item's body render with the item's module — the
  # rendering item_defs' record_item_def uses, keeping call-site identity
  # (InstanceId.def) byte-identical to the function's own DefId.
  var item_idx = 0
  while item_idx < program.items.len() do
    let (owner_path, owner_module) = module_path_of_item_resolver(program, item_idx)
    ctx.current_owner_path = owner_path
    ctx.current_owner_module = owner_module
    let item = program.items[item_idx]
    resolve_item(ctx, &item)
    ctx.current_owner_path = Vec::new()
    ctx.current_owner_module = ModuleId { id: 0 }
    item_idx = item_idx + 1
  end
end

def resolve_item(inout ctx: ResolutionContext, item: Item) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    resolve_function(ctx, &f)
  when ItemKind::ItemImpl(impl_block) then
    # Impl-level generic parameters (e.g. `impl[T] Iterator[T] for X`) are in
    # scope for every method body.
    rs_push_scope(ctx)
    for gp in impl_block.generic_params do
      define_local(ctx, gp.name.clone(), ResolverLocalBinding {
        name: gp.name.clone(),
        kind: LocalBindingKind::Parameter(-1),
        is_mut: false,
        span: impl_block.span.clone()
      })
    end
    for method in impl_block.methods do
      resolve_function(ctx, &method)
    end
    rs_pop_scope(ctx)
  when ItemKind::ItemModule(m) then
    ctx.symbols.current_module.push(m.name.clone())
    for inner in m.items do
      resolve_item(ctx, &inner)
    end
    let _ = ctx.symbols.current_module.pop()
  when _ then ()
  end  end
end

def resolve_function(inout ctx: ResolutionContext, f: FunctionDecl) -> Unit
  rs_push_scope(ctx)

  # Add generic type parameters to scope so `T` in `def f[T](x: T)` resolves.
  for gp in f.generic_params do
    define_local(ctx, gp.name.clone(), ResolverLocalBinding {
      name: gp.name.clone(),
      kind: LocalBindingKind::Parameter(-1),
      is_mut: false,
      span: f.span.clone()
    })
  end

  # Add parameters to scope
  var param_idx = 0
  for param in f.params do
    define_local(ctx, param.name.clone(), ResolverLocalBinding {
      name: param.name.clone(),
      kind: LocalBindingKind::Parameter(param_idx),
      is_mut: param_is_mut(&param),
      span: param.span.clone()
    })
    param_idx = param_idx + 1
  end

  # Resolve body
  match f.body
  when FnBody::FnBlock(body) then
    for stmt_val in body.stmts do
      resolve_stmt(ctx, &stmt_val)
    end
  when FnBody::FnExpr(body) then resolve_expr(ctx, &body)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end

  rs_pop_scope(ctx)
end

# (ParamModifier deletion): mutability is the ONE access convention —
# the `mut` / `&mut` spellings convert to AccessConvention::Inout at
# parse time, so the mutating-parameter test is the convention comparison.
def param_is_mut(param: Param) -> Bool
  param.convention == AccessConvention::Inout
end

def resolve_stmt(inout ctx: ResolutionContext, stmt: Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(e) then resolve_expr(ctx, &e)
  when StmtKind::StmtAssign(target, value) then
    # Assignment (statement form): resolve both sides — the target's base
    # expressions and the assigned value.
    resolve_expr(ctx, &target)
    resolve_expr(ctx, &value)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    resolve_expr(ctx, &target)
    resolve_expr(ctx, &value)
  when StmtKind::StmtLet(pattern, ty, init, _) then
    resolve_expr(ctx, &init)
    resolve_pattern_definition(ctx, &pattern)
  when StmtKind::StmtIf(if_stmt) then
    resolve_expr(ctx, &if_stmt.cond)
    rs_push_scope(ctx)
    for s in if_stmt.then_block.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
    for branch in if_stmt.elsif_branches do
      resolve_expr(ctx, &branch.0)
      rs_push_scope(ctx)
      for s in branch.1.stmts do resolve_stmt(ctx, &s) end
      rs_pop_scope(ctx)
    end
    match if_stmt.else_block
    when Option::Some(eb) then
      rs_push_scope(ctx)
      for s in eb.stmts do
        resolve_stmt(ctx, &s)
      end
      rs_pop_scope(ctx)
    when Option::None then ()
    end
  when StmtKind::StmtMatch(m) then
    resolve_expr(ctx, &m.scrutinee)
    for arm in m.arms do
      rs_push_scope(ctx)
      resolve_pattern(ctx, &arm.pattern)
      match arm.guard_expr
      when Option::Some(g) then resolve_expr(ctx, &g)
      when Option::None then ()
      end
      for s in arm.body.stmts do
        resolve_stmt(ctx, &s)
      end
      rs_pop_scope(ctx)
    end
  when StmtKind::StmtWhile(cond, body) then
    resolve_expr(ctx, &cond)
    rs_push_scope(ctx)
    for s in body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtFor(for_stmt) then
    resolve_expr(ctx, &for_stmt.iter)
    rs_push_scope(ctx)
    resolve_pattern(ctx, &for_stmt.pattern)
    for stmt_val in for_stmt.body.stmts do
      resolve_stmt(ctx, &stmt_val)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtLoop(body) then
    rs_push_scope(ctx)
    for s in body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtReturn(e_opt) then
    match e_opt
    when Option::Some(e) then resolve_expr(ctx, &e)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(e_opt) then
    match e_opt
    when Option::Some(e) then resolve_expr(ctx, &e)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtDefer(body) then
    rs_push_scope(ctx)
    for s in body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtUnsafe(_, body) then
    rs_push_scope(ctx)
    for s in body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtGuard(cond, else_action) then
    resolve_expr(ctx, &cond)
    match else_action
    when GuardElse::Return(e_opt) then
      match e_opt
      when Option::Some(e) then resolve_expr(ctx, &e)
      when Option::None then ()
      end
    when GuardElse::Break(e_opt) then
      match e_opt
      when Option::Some(e) then resolve_expr(ctx, &e)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(try_body, catches, finally_opt) then
    rs_push_scope(ctx)
    for s in try_body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
    for catch_arm in catches do
      rs_push_scope(ctx)
      resolve_pattern(ctx, &catch_arm.pattern)
      for s in catch_arm.body.stmts do
        resolve_stmt(ctx, &s)
      end
      rs_pop_scope(ctx)
    end
    match finally_opt
    when Option::Some(f) then
      rs_push_scope(ctx)
      for s in f.stmts do
      resolve_stmt(ctx, &s)
    end
      rs_pop_scope(ctx)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pattern, body) then
    # With (context manager): resolve the managed expression, then bind the
    # pattern as a definition inside the body's scope.
    resolve_expr(ctx, &expr)
    rs_push_scope(ctx)
    resolve_pattern_definition(ctx, &pattern)
    for s in body.stmts do
      resolve_stmt(ctx, &s)
    end
    rs_pop_scope(ctx)
  when StmtKind::StmtHandleWith(expr, handlers) then
    # Handle/with (effect handlers): resolve the handled expression and every
    # handler arm's patterns and bodies.
    resolve_expr(ctx, &expr)
    for handler in handlers do
      for arm in handler.arms do
        rs_push_scope(ctx)
        for p in arm.params do
          resolve_pattern(ctx, &p)
        end
        for s in arm.body.stmts do
          resolve_stmt(ctx, &s)
        end
        rs_pop_scope(ctx)
      end
    end
  end  end
end

def resolve_pattern(inout ctx: ResolutionContext, pattern: Pattern) -> Unit
  match pattern.kind
  when PatternKind::Ident(name, is_mut) then
    define_local(ctx, name.clone(), ResolverLocalBinding {
      name: name.clone(),
      kind: LocalBindingKind::MatchBinding,
      is_mut: is_mut.clone(),
      span: Span { file: "", start: 0, end_pos: 0 }
    })
  when PatternKind::Tuple(patterns) then
    for p in patterns do
      resolve_pattern(ctx, &p)
    end
  when PatternKind::Struct(path, fields) then
    for entry in fields do
      let name = entry.0
      let pat = entry.1
      resolve_pattern(ctx, &pat)
    end
  when PatternKind::Variant(path, patterns) then
    for p in patterns do
      resolve_pattern(ctx, &p)
    end
  when PatternKind::Literal(_) then ()
  when PatternKind::Wildcard then ()
  when PatternKind::Array(patterns) then
    for p in patterns do
      resolve_pattern(ctx, &p)
    end
  when PatternKind::Or(patterns) then
    for p in patterns do
      resolve_pattern(ctx, &p)
    end
  when PatternKind::Range(_, _, _) then ()
  end  end
end

def resolve_pattern_definition(inout ctx: ResolutionContext, pattern: Pattern) -> Unit
  match pattern.kind
  when PatternKind::Ident(name, is_mut) then
    define_local(ctx, name.clone(), ResolverLocalBinding {
      name: name.clone(),
      kind: LocalBindingKind::Variable,
      is_mut: is_mut.clone(),
      span: Span { file: "", start: 0, end_pos: 0 }
    })
  when PatternKind::Tuple(patterns) then
    for p in patterns do
      resolve_pattern_definition(ctx, &p)
    end
  when PatternKind::Array(patterns) then
    for p in patterns do
      resolve_pattern_definition(ctx, &p)
    end
  when PatternKind::Struct(_, fields) then
    for entry in fields do
      let p = entry.1
      resolve_pattern_definition(ctx, &p)
    end
  when PatternKind::Variant(_, patterns) then
    for p in patterns do
      resolve_pattern_definition(ctx, &p)
    end
  when PatternKind::Or(patterns) then
    for p in patterns do
      resolve_pattern_definition(ctx, &p)
    end
  when PatternKind::Wildcard then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Range(_, _, _) then ()
  end  end
end

def resolve_path(inout ctx: ResolutionContext, path: Vec[String], node_id: Int, span: Span) -> Unit
  if path.is_empty() then return end

  let first = path[0]

 # (type-path branch): Type::method / Enum::Variant paths resolve the
  # OWNER through the module-qualified TypeName machinery — the 0/1/>1
  # rule (the bare-name root-tree lookup is are not part of the model; an ambiguous owner is
  # FINAL — the ambiguity diagnostic, no first-wins pick). The variant
  # identity comes from the owner module's qualified EnumVariant entry
  # ("path::VariantName" -> DefId — the same registration machinery that
  # recorded the owner), so the resolution record and the call target
  # carry the OWNER-module identities end to end.
  if path.len() >= 2 then
    match bare_name_resolve(ctx, &first, &vec![DefKind::TypeName], &span)
    when BareNameResolution::Resolved(owner_did) then
      let owner_path = module_path_of(&ctx.symbols, owner_did.clone())
      let second = path[1]
      match ctx.symbols.module_symbols.get(module_qualified_key(&owner_path, &second))
      when Option::Some(var_did) then
        # The variant's own module-qualified EnumVariant DefId. The
 # resolution record carries the VariantId form (): the owner
        # TypeId is completed by the type checker at consumption (the
        # resolver cannot fabricate type-checker ids; TypeId { id: -1 }
        # marks an unset owner — the codebase's convention); the index is
        # the variant's per-module index. The identity keys are the
        # expression's NODE ids (never spans).
        ctx.resolved.call_targets.insert(node_id, var_did.clone())
        ctx.resolved.expr_resolutions.insert(node_id, ResolvedExpr {
          kind: ResolvedExprKind::Variant(VariantId {
            owner: TypeId { id: -1 },
            index: var_did.index
          }),
          module_path: ctx.symbols.current_module.clone()
        })
      when Option::None then
        # The qualified path names no registered EnumVariant entry (the
        # Type::new / Vec::from static-path shapes): carry the provisional
        # VariantId form with a degenerate index.
        ctx.resolved.expr_resolutions.insert(node_id, ResolvedExpr {
          kind: ResolvedExprKind::Variant(VariantId {
            owner: TypeId { id: -1 },
            index: 0 as UInt
          }),
          module_path: ctx.symbols.current_module.clone()
        })
      end
      return
    when BareNameResolution::Ambiguous then
      return
    when BareNameResolution::NoCandidate then
      ()
    end
  end

  # Try resolving as module path
 # record the call target when the path names a registered top-level
  # function (full-path or import-alias form) — purely additive; a path that
  # names no registered function records nothing and keeps the name-based
  # fallback, and no new error behavior is introduced.
  record_path_call_target(ctx, path, node_id)
  if resolve_via_imports_path(ctx, path, span) then
    return
  end

  # Could not resolve
  rs_add_error(&mut ctx.symbols, ResolutionErrorKind::UnresolvedName,
    "unresolved path: " + path.join("::"), span)
end

def rs_resolve_type_expr(inout ctx: ResolutionContext, ty: TypeExpr, span: Span) -> Unit
  match ty.kind
  when TypeExprKind::Named(name, args) then
 # check the type exists through the module-qualified TypeName
    # machinery — the 0/1/>1 rule (the bare-name root-tree lookup is
    # are not part of the model; >= 2 DISTINCT qualified definitions is the ambiguity
    # diagnostic — its ONLY outcome; a first-wins pick is never made).
    if !is_builtin_type_name(&name) then
      match bare_name_resolve(ctx, &name, &vec![DefKind::TypeName], &span)
      when BareNameResolution::Resolved(_) then ()
      when BareNameResolution::Ambiguous then ()
      when BareNameResolution::NoCandidate then
        if !resolve_type_via_imports(ctx, &vec![name.clone()]) then
          rs_add_error(&mut ctx.symbols, ResolutionErrorKind::UnresolvedType,
            "unresolved type: " + name, span)
        end
      end
    end
    # Resolve type arguments
    for arg in args do
      rs_resolve_type_expr(ctx, &arg, span.clone())
    end
  when TypeExprKind::Path(path) then
    if !resolve_type_via_imports(ctx, &path.segments) then
      if path.segments.is_empty() then
        rs_add_error(&mut ctx.symbols, ResolutionErrorKind::UnresolvedType,
          "unresolved type: " + path.segments.join("::"), span)
      else
 # the terminal segment's module-qualified TypeName identity
        # (the bare-name root-tree lookup is are not part of the model).
        let last = path.segments[path.segments.len() - 1]
        match bare_name_resolve(ctx, &last, &vec![DefKind::TypeName], &span)
        when BareNameResolution::Resolved(_) then ()
        when BareNameResolution::Ambiguous then ()
        when BareNameResolution::NoCandidate then
          rs_add_error(&mut ctx.symbols, ResolutionErrorKind::UnresolvedType,
            "unresolved type: " + path.segments.join("::"), span)
        end
      end
    end
  when TypeExprKind::Tuple(elems) then
    for e in elems do
      rs_resolve_type_expr(ctx, &e, span.clone())
    end
  when TypeExprKind::Array(elem, _) then
    rs_resolve_type_expr(ctx, &elem, span.clone())
  when TypeExprKind::Slice(elem) then
    rs_resolve_type_expr(ctx, &elem, span.clone())
  when TypeExprKind::Fn(params, ret) then
    for p in params do
      rs_resolve_type_expr(ctx, &p.ty, span.clone())
    end
    rs_resolve_type_expr(ctx, &ret, span.clone())
  when TypeExprKind::Unit then ()
  when TypeExprKind::Never then ()
  when TypeExprKind::Ptr(elem) then
    rs_resolve_type_expr(ctx, &elem, span.clone())
  when TypeExprKind::PtrMut(elem) then
    rs_resolve_type_expr(ctx, &elem, span.clone())
  when TypeExprKind::Async(inner) then
    rs_resolve_type_expr(ctx, &inner, span.clone())
  when TypeExprKind::Effect(_, inner) then
    rs_resolve_type_expr(ctx, &inner, span.clone())
  when TypeExprKind::Infer then ()
  end  end
end

def is_builtin_type_name(name: String) -> Bool
  name == "Int" || name == "UInt" || name == "Float" || name == "Bool" ||
  name == "Char" || name == "String" || name == "Unit" || name == "Never" ||
  name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" ||
  name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" ||
    name == "isize" || name == "usize" ||
    name == "f32" || name == "f64" ||
  name == "Vec" || name == "Map" || name == "Set" || name == "Option" || name == "Result" ||
  name == "Ptr" || name == "Box" || name == "Rc" || name == "Arc"
end

def resolve_via_imports(inout ctx: ResolutionContext, name: String, expr: Expr) -> Bool
  let module = get_current_module_ref(&ctx.symbols)

  for import in module.imports do
    if import.is_glob then
      # Would need to search the imported module
      next
    end

    let import_name = match import.alias_name
    when Option::Some(alias_val) then alias_val.clone()
    when Option::None then
      if import.path.is_empty() then next end
      import.path[import.path.len() - 1].clone()
    end

    if import_name == name.clone() then
      # DefId.module is the TARGET module's ModuleId (the per-module table
      # of the import path carries it — module_tables are keyed by path join
      # and stamped with the owner ModuleId); the symbol index comes from
      # the TARGET module's symbol table under the imported item's name.
      var module_path = Vec::new()
      var mpi = 0
      while mpi < import.path.len() - 1 do
        module_path.push(import.path[mpi].clone())
        mpi = mpi + 1
      end
      let target_name = import.path[import.path.len() - 1].clone()
      let target_kind = import_target_kind(ctx, &module_path, &target_name)
      let target_mod = match ctx.symbols.module_tables.get(module_path.join("::"))
      when Option::Some(tab) then ModuleId { id: tab.module_id }
      when Option::None then ModuleId { id: 0 }
      end
      let target_idx = match symbol_index_for(ctx, &module_path, &target_name)
      when Option::Some(target_idx) then
        let target_did = DefId {
          module: target_mod,
          index: target_idx
        }
        record_def_kind(ctx, &target_did, target_kind)
        ctx.resolved.call_targets.insert(expr.node_id, target_did)
        target_idx
      when Option::None then 0 as UInt
      end
      # The resolved-expression kind carries the semantic DefId (never the
      # source name); the id matches the call_targets entry exactly. The
      # identity key is the expression's NODE id.
      let target_did = DefId {
        module: target_mod,
        index: target_idx
      }
      record_def_kind(ctx, &target_did, target_kind)
      let resolved_kind = match target_kind
      when DefKind::Static then ResolvedExprKind::Static(target_did.clone())
      when DefKind::Constant then ResolvedExprKind::Constant(target_did.clone())
      when DefKind::EnumVariant then
 # the imported item is an enum variant — the record carries the
        # VariantId form (the owner TypeId is completed by the type checker
        # at consumption; TypeId { id: -1 } marks an unset owner — the
        # resolver cannot fabricate type-checker ids); the variant's own
        # DefId (call_targets, recorded above) is the module-qualified
        # EnumVariant identity.
        ResolvedExprKind::Variant(VariantId {
          owner: TypeId { id: -1 },
          index: target_idx
        })
      when DefKind::Trait then
 # an imported trait resolves with its declaration DefId (the
        # module-qualified trait identity); expression-position trait refs
        # carry it like a callable (traits are not invocable — the DefId is
        # identity metadata for the checker's trait resolution).
        ResolvedExprKind::Function(target_did)
      when _ then
        ResolvedExprKind::Function(target_did)
      end
      ctx.resolved.expr_resolutions.insert(expr.node_id, ResolvedExpr {
        kind: resolved_kind,
        module_path: import.path.clone()
      })
      return true
    end
  end

  false
end

# the DefKind of an import target, from the module-qualified
# authority — the def_kinds METADATA of the module_symbols entry for
# exactly this (module_path, name) pair ("path::name"). The bare-name
# root-tree lookups (per-module tree AND the root fallback) are not part of the model.
def import_target_kind(ctx: ResolutionContext, module_path: Vec[String], name: String) -> DefKind
  let key = module_qualified_key(module_path, name)
  match ctx.symbols.module_symbols.get(key)
  when Option::Some(did) then
    match ctx.symbols.def_kinds.get(def_metadata_key(did))
    when Option::Some(k) then k
    when Option::None then DefKind::Other
    end
  when Option::None then
    DefKind::Function
  end
end

def resolve_via_imports_path(inout ctx: ResolutionContext, path: Vec[String], span: Span) -> Bool
  # Try to match path against imports in the current module
  # Returns true only if a matching import is found AND the target symbol exists

  if path.is_empty() then
    return false
  end

  let module = get_current_module_ref(&ctx.symbols)

  # Check exact imports (use foo::bar::Baz)
  for import in module.imports do
    if import.path == path.clone() then
      return true
    end
    # Check if this is a prefix import that covers the path.
    # After prefix match, verify the remaining segments resolve to an
    # exported symbol in the target module.
    if import.path.len() < path.len() then
      var matches = true
      for i in 0..import.path.len() do
        if import.path[i] != path[i] then
          matches = false
        end
      end
      if matches then
        # Extract the remaining path after the import prefix
        let remaining = path.slice(import.path.len(), path.len())
        # Verify the target symbol exists in the imported module's exports
        if verify_symbol_in_module(ctx, &import.path, &remaining) then
          return true
        end
      end
    end
  end

  # Check glob imports (use foo::*)
  for glob in module.glob_imports do
    if glob.len() < path.len() then
      var matches = true
      for i in 0..glob.len() do
        if glob[i] != path[i] then
          matches = false
        end
      end
      if matches then
        # For glob imports, verify the remaining symbol exists as an export
        let remaining = path.slice(glob.len(), path.len())
        if verify_symbol_in_module(ctx, &glob, &remaining) then
          return true
        end
      end
    end
  end

  # No matching import found
  false
end

# record the call target of a module-qualified path when it names a
# KNOWN top-level function. The target DefId comes from the symbol table's
# module_symbols entries ("<full owner module path>::<name>" -> DefId — the
# entries add_item_to_symbols registered for EVERY top-level item, carrying
# module = the item's owner ModuleId). The rendering therefore
# matches the same item's item_defs DefId byte-for-byte (record_item_def
# walks the same owner modules and per-module indices),
# the MIR emission-name needs: a call-site name derived from the
# InstanceId's DefId must equal the callee function's own DefId-derived
# emission name.
#
# Key attempts, in order:
#   1. The path AS WRITTEN — covers fully-qualified calls that name the
#      item's registered key directly ("std::env::get_env").
#   2. Import-alias expansion — the first segment is an import alias
#      ("driver" for `use tg_compiler::driver`): the full path is
#      import.path + the remaining segments, so "driver::driver_main"
#      resolves against the registered "tg_compiler::driver::driver_main".
#
# Only DefKind::Function targets are recorded (methods keep their
# "Type__method" mangled names; intrinsic/extern symbols keep source names;
# constants/statics/variants never participate in emission-name derivation).
# No resolution errors are added here — a path that names no registered
# function simply stays name-based (the MIR-side fallback for that shape).
# The identity key is the call expression's NODE id.
def record_path_call_target(inout ctx: ResolutionContext, path: Vec[String], node_id: Int) -> Unit
  if path.len() < 2 then return end
  var key_attempts: Vec[Vec[String]] = Vec::new()
  key_attempts.push(path.clone())
  let module = get_current_module_ref(&ctx.symbols)
  for import in module.imports do
    if import.path.is_empty() then next end
    let import_alias = match import.alias_name
    when Option::Some(alias_val) then alias_val.clone()
    when Option::None then import.path[import.path.len() - 1].clone()
    end
    if import_alias == path[0] then
      var cand = import.path.clone()
      var pi = 1
      while pi < path.len() do
        cand.push(path[pi].clone())
        pi = pi + 1
      end
      key_attempts.push(cand)
    end
  end
  for cand in key_attempts do
    if cand.len() < 2 then next end
    var mod_segs = Vec::new()
    var ci = 0
    while ci < cand.len() - 1 do
      mod_segs.push(cand[ci].clone())
      ci = ci + 1
    end
    let key = module_qualified_key(&mod_segs, &cand[cand.len() - 1])
    match ctx.symbols.module_symbols.get(key)
    when Option::Some(did) then
 # the DefKind is metadata (DefId carries no kind) — check the
      # def_kinds map, not the DefId.
      let did_kind = match ctx.symbols.def_kinds.get(def_metadata_key(did))
      when Option::Some(k) then k
      when Option::None then DefKind::Other
      end
      if did_kind == DefKind::Function then
        ctx.resolved.call_targets.insert(node_id, did.clone())
        return
      end
    when Option::None then ()
    end
  end
end

# verify that a symbol identified by `remaining` path segments exists
# under the module identified by `module_path` — the module-qualified
# authority: the import target is verified against the registered
# "path::name" keys (module_symbols), the module path plus the remaining
# segments joined. The bare-name root-tree walk and its flat root
# fallback is not part of the model.
def verify_symbol_in_module(ctx: ResolutionContext, module_path: Vec[String], remaining: Vec[String]) -> Bool
  if remaining.is_empty() then
    return false
  end
  var full = module_path.clone()
  var ri = 0
  while ri < remaining.len() - 1 do
    full.push(remaining[ri].clone())
    ri = ri + 1
  end
  let name = remaining[remaining.len() - 1]
  let key = module_qualified_key(&full, &name)
  ctx.symbols.module_symbols.contains_key(&key)
end

def resolve_type_via_imports(ctx: ResolutionContext, path: Vec[String]) -> Bool
  # Check if type is imported
  let module = get_current_module_ref(&ctx.symbols)

  for import in module.imports do
    if import.path == path.clone() then
      return true
    end
  end

  false
end

# ———————————————————————————————————————————————————————————————
# Scope Management
# ———————————————————————————————————————————————————————————————

def rs_push_scope(inout ctx: ResolutionContext) -> Unit
  ctx.local_scopes.push(Map::new())
end

def rs_pop_scope(inout ctx: ResolutionContext) -> Unit
  let _ = ctx.local_scopes.pop()
end

# define a local binding in the current scope. Every binding is
# stamped with a FRESH LocalId (ctx.next_local_id — the resolver-side
# local identity; the name stays for diagnostics); the binding's kind
# (Variable/Parameter/LoopVariable/MatchBinding) is carried through.
def define_local(inout ctx: ResolutionContext, name: String, inout binding: ResolverLocalBinding) -> Unit
  binding.local_id = LocalId { id: ctx.next_local_id }
  ctx.next_local_id = ctx.next_local_id + 1
  if !ctx.local_scopes.is_empty() then
    let idx = ctx.local_scopes.len() - 1
    ctx.local_scopes[idx].insert(name, binding)
  end
end

def lookup_local(ctx: ResolutionContext, name: String) -> Option[ResolverLocalBinding]
  var i = ctx.local_scopes.len()
  while i > 0 do
    i = i - 1
    match ctx.local_scopes[i].get(name)
    when Option::Some(binding) then return Option::Some(binding.clone())
    when Option::None then ()
    end
  end
  Option::None
end

def get_current_module_ref(symbols: SymbolTable) -> ModuleSymbols
  var module = symbols.root
  for seg in symbols.current_module do
    module = module.submodules.get(&seg).expect("module not found")
  end
  module
end

def symbol_index_of(module: ModuleSymbols, name: String) -> Option[UInt]
  match module.symbol_indices.get(name)
  when Option::Some(idx) then Option::Some(idx as UInt)
  when Option::None then Option::None
  end  end
end

def variant_index_of(module: ModuleSymbols, name: String) -> Option[UInt]
  match module.variant_indices.get(name)
  when Option::Some(idx) then Option::Some(idx as UInt)
  when Option::None then Option::None
  end  end
end

# the per-module symbol index of a name in the module identified by
# `module_path` — read from the OWNER module's per-module table
# (module_tables, keyed by the path join — the same table
# add_item_to_symbols registered the symbol's index into, so the returned
# index matches the module_symbols DefId byte-for-byte). The bare-name
# root-tree walk and its root fallback is not part of the model.
def symbol_index_for(ctx: ResolutionContext, module_path: Vec[String], name: String) -> Option[UInt]
  match ctx.symbols.module_tables.get(module_path.join("::"))
  when Option::Some(m) then
    match m.symbol_indices.get(name)
    when Option::Some(idx) then Option::Some(idx as UInt)
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end  end
end

# ———————————————————————————————————————————————————————————————
# Error Reporting
# ———————————————————————————————————————————————————————————————

def rs_add_error(inout symbols: SymbolTable, kind: ResolutionErrorKind,
              message: String, span: Span) -> Unit
  symbols.errors.push(ResolutionError {
    message: message,
    span: span,
    kind: kind
  })
end

def resolve_ident_expr(inout ctx: ResolutionContext, name: String, expr: Expr) -> Unit
  # Look up in local scopes first. The identity keys are the expression's
  # NODE ids (never spans).: the resolved local forms carry the
  # binding's LocalId (the resolver-side local identity); the name is
  # retained for diagnostics only.
  match lookup_local(ctx, name)
  when Option::Some(binding) then
    let lid = binding.local_id
    match binding.kind
    when LocalBindingKind::Variable then
      let resolved_expr = ResolvedExpr {
        kind: ResolvedExprKind::LocalVar(lid, name.clone()),
        module_path: ctx.symbols.current_module.clone()
      }
      let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    when LocalBindingKind::Parameter(idx) then
      let resolved_expr = ResolvedExpr {
        kind: ResolvedExprKind::Parameter(lid, name.clone(), idx),
        module_path: ctx.symbols.current_module.clone()
      }
      let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    when LocalBindingKind::LoopVariable then
      let resolved_expr = ResolvedExpr {
        kind: ResolvedExprKind::LocalVar(lid, name.clone()),
        module_path: ctx.symbols.current_module.clone()
      }
      let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    when LocalBindingKind::MatchBinding then
      let resolved_expr = ResolvedExpr {
        kind: ResolvedExprKind::LocalVar(lid, name.clone()),
        module_path: ctx.symbols.current_module.clone()
      }
      let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    end
    return
  when Option::None then
    ()
  end

 # (bare-name 0/1/>1 rule): callable candidates (Function/Constant/
  # Static) through the module-qualified machinery — module_symbols +
 # def_kinds. The bare-name root-tree first-wins lookups are not part of the model: a
  # bare name with >= 2 DISTINCT qualified definitions is ambiguous — the
  # diagnostic is recorded and is the ONLY outcome (no first-wins pick).
  # The resolved DefId is the module-qualified entry itself, so the
  # call-target identity equals the module_symbols / item_defs identity
  # byte-for-byte (a call-site
  # name derived from the InstanceId's DefId must equal the callee's own
  # DefId-derived emission name). The kinds are metadata (def_kinds) —
  # DefId carries no kind.
  let callable_kinds = vec![DefKind::Function, DefKind::Constant, DefKind::Static]
  match bare_name_resolve(ctx, name, &callable_kinds, &expr.span)
  when BareNameResolution::Resolved(did) then
    let did_kind = match ctx.symbols.def_kinds.get(def_metadata_key(&did))
    when Option::Some(k) then k
    when Option::None then DefKind::Other
    end
    ctx.resolved.call_targets.insert(expr.node_id, did.clone())
    let resolved_kind = match did_kind
    when DefKind::Constant then ResolvedExprKind::Constant(did.clone())
    when DefKind::Static then ResolvedExprKind::Static(did.clone())
    when _ then ResolvedExprKind::Function(did.clone())
    end
    let resolved_expr = ResolvedExpr {
      kind: resolved_kind,
      module_path: ctx.symbols.current_module.clone()
    }
    let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    return
  when BareNameResolution::Ambiguous then
    return
  when BareNameResolution::NoCandidate then
    ()
  end

  # Runtime intrinsics (__intrinsic_*) are provided by the runtime, not by
  # source definitions; they are always resolvable. Their DefId lives in
  # the compiler-synthetic definition domain (SYNTHETIC_MODULE_INTRINSIC —
  # module id -1 — the negative synthetic band, never a Program.crate
  # module); the kind is metadata.
  if name.starts_with("__intrinsic") then
    let bidx = ctx.next_builtin_index
    ctx.next_builtin_index = ctx.next_builtin_index + 1
    let bdid = DefId {
      module: synthetic_module_id(SYNTHETIC_MODULE_INTRINSIC),
      index: bidx as UInt
    }
    record_def_kind(ctx, &bdid, DefKind::Intrinsic)
    let resolved_expr = ResolvedExpr {
      kind: ResolvedExprKind::Function(bdid.clone()),
      module_path: ctx.symbols.current_module.clone()
    }
    let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    ctx.resolved.call_targets.insert(expr.node_id, bdid)
    return
  end

  # Type names used in expression position (e.g. generic call type args such as
  # `alloc[RcInner[T]]()`) resolve as type references, not errors — through
  # the module-qualified TypeName machinery (0/1/>1; the bare-name
  # root-tree lookup is are not part of the model).
  match bare_name_resolve(ctx, name, &vec![DefKind::TypeName], &expr.span)
  when BareNameResolution::Resolved(did) then
    # The resolved expression carries the TYPE NAME's DefId (kind TypeName,
    # metadata); call_targets gets the same id, so a `Type::new`-style call
    # keeps one ID-based identity end to end.
    ctx.resolved.call_targets.insert(expr.node_id, did.clone())
    let resolved_expr = ResolvedExpr {
      kind: ResolvedExprKind::Function(did.clone()),
      module_path: ctx.symbols.current_module.clone()
    }
    let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    return
  when BareNameResolution::Ambiguous then
    return
  when BareNameResolution::NoCandidate then
    ()
  end

  # Bare enum variant references (`Some`, `None`, `Zero`) resolve as
  # variants — through the module-qualified EnumVariant machinery (0/1/>1;
  # the bare-name root-tree lookup is are not part of the model). The record carries the
 # VariantId form (): the owner TypeId is completed by the type checker
  # at consumption (the resolver cannot fabricate type-checker ids;
  # TypeId { id: -1 } marks an unset owner — the codebase's convention);
  # the variant's DefId (call_targets) is the module-qualified EnumVariant
  # identity.
  match bare_name_resolve(ctx, name, &vec![DefKind::EnumVariant], &expr.span)
  when BareNameResolution::Resolved(did) then
    ctx.resolved.call_targets.insert(expr.node_id, did.clone())
    let resolved_expr = ResolvedExpr {
      kind: ResolvedExprKind::Variant(VariantId {
        owner: TypeId { id: -1 },
        index: did.index
      }),
      module_path: ctx.symbols.current_module.clone()
    }
    let _ = ctx.resolved.expr_resolutions.insert(expr.node_id, resolved_expr)
    return
  when BareNameResolution::Ambiguous then
    return
  when BareNameResolution::NoCandidate then
    ()
  end

  # Check imports
  if !resolve_via_imports(ctx, name, expr) then
    rs_add_error(&mut ctx.symbols, ResolutionErrorKind::UnresolvedName,
      "unresolved name: " + name + " @" + expr.span.start.to_string(), expr.span.clone())
  end
end

# The operation-call surface callee test (the resolver's mirror of the
# type checker's effect_perform_callee_path): the literal 3-segment path
# "std::effects::perform" — the ONLY callee shape whose first argument is
# an effect operation REFERENCE (resolved by the checker, never here).
def effect_perform_callee_path_resolver(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprPath(p) then
    p.segments.len() == 3 && p.segments[0] == "std" && p.segments[1] == "effects" && p.segments[2] == "perform"
  when _ then false
  end  end
end

def resolve_expr(inout ctx: ResolutionContext, expr: Expr) -> Unit
 # (exhaustive visitor): EVERY ExprKind variant has an explicit arm —
  # no `when _` fallback — so an expression form the resolver does not
  # handle is a compile-time error here, never a silent omission. Literal
  # arms are no-ops (nothing to resolve); genuinely unsupported forms
  # (residual macro calls) get an explicit diagnostic.
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()

  when ExprKind::ExprIdent(name) then
    resolve_ident_expr(ctx, &name, expr)

  when ExprKind::ExprPath(path) then
    resolve_path(ctx, &path.segments, expr.node_id, expr.span.clone())

  when ExprKind::ExprSelfRef then
    # `self` binds to the enclosing function's receiver; the type checker
    # resolves the binding. Nothing to record here.
    ()

  when ExprKind::ExprEnumVariant(path, _) then
 # module-qualified CALL paths ("driver::driver_main(...)",
    # "std::env::get_env(...)") parse as ExprEnumVariant. Record the call
    # target when the path names a registered top-level function so the MIR
    # call site carries the InstanceId and derives the callee's emission
    # name from its DefId. No error is added for unresolvable paths (the
    # pre-existing behavior for this expression form is silent; the MIR
    # name-based fallback covers those shapes).
    record_path_call_target(ctx, &path.segments, expr.node_id)

  when ExprKind::ExprStructLit(path, fields) then
    # Struct construction: resolve every field initializer. The type path
    # resolves during type checking.
    for entry in fields do
      let fv = entry.1
      resolve_expr(ctx, &fv)
    end

  when ExprKind::ExprCall(callee, args) then
    resolve_expr(ctx, &callee)
    # The operation-call surface: std::effects::perform(EFFECT.op, ...) —
    # the FIRST argument is the operation REFERENCE (an EFFECT.op path the
    # type checker resolves against the declared effect's typed op table),
    # NOT a value expression — the resolver must not report the effect
    # name as an unresolved symbol. The remaining arguments are ordinary
    # payload expressions.
    if effect_perform_callee_path_resolver(&callee) then
      var rarg = 1
      while rarg < args.len() do
        resolve_expr(ctx, &args[rarg])
        rarg = rarg + 1
      end
    else
      for arg in args do
        resolve_expr(ctx, &arg)
      end
    end

  when ExprKind::ExprMethodCall(receiver, method, type_args, args) then
    resolve_expr(ctx, &receiver)
    for arg in args do
      resolve_expr(ctx, &arg)
    end
    # Method resolution happens during type checking

  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    resolve_expr(ctx, &lhs)
    resolve_expr(ctx, &rhs)

  when ExprKind::ExprUnaryOp(op, operand) then
    resolve_expr(ctx, &operand)

  when ExprKind::ExprBlock(block) then
    rs_push_scope(ctx)
    for stmt in block.stmts do
      resolve_stmt(ctx, &stmt)
    end
    rs_pop_scope(ctx)

  when ExprKind::ExprUnsafe(_, block) then
    # Unsafe blocks introduce a scope exactly like plain blocks.
    rs_push_scope(ctx)
    for stmt in block.stmts do
      resolve_stmt(ctx, &stmt)
    end
    rs_pop_scope(ctx)

  when ExprKind::ExprIf(if_stmt) then
    resolve_expr(ctx, &if_stmt.cond)
    for stmt in if_stmt.then_block.stmts do
      resolve_stmt(ctx, &stmt)
    end
    for entry in if_stmt.elsif_branches do
      let elsif_cond = entry.0
      let elsif_block = entry.1
      resolve_expr(ctx, &elsif_cond)
      for stmt in elsif_block.stmts do
        resolve_stmt(ctx, &stmt)
      end
    end
    match if_stmt.else_block
    when Option::Some(e) then
      for stmt in e.stmts do
        resolve_stmt(ctx, &stmt)
      end
    when Option::None then ()
    end

  when ExprKind::ExprMatch(m) then
    resolve_expr(ctx, &m.scrutinee)
    for arm in m.arms do
      rs_push_scope(ctx)
      resolve_pattern(ctx, &arm.pattern)
      for stmt in arm.body.stmts do
        resolve_stmt(ctx, &stmt)
      end
      rs_pop_scope(ctx)
    end

  when ExprKind::ExprArrayLit(elems) then
    for elem in elems do
      resolve_expr(ctx, &elem)
    end

  when ExprKind::ExprTupleLit(elems) then
    for elem in elems do
      resolve_expr(ctx, &elem)
    end

  when ExprKind::ExprMapLit(entries) then
    for entry in entries do
      let k = entry.0
      let v = entry.1
      resolve_expr(ctx, &k)
      resolve_expr(ctx, &v)
    end

  when ExprKind::ExprIndex(base, index) then
    resolve_expr(ctx, &base)
    resolve_expr(ctx, &index)

  when ExprKind::ExprFieldAccess(base, _) then
    resolve_expr(ctx, &base)

  when ExprKind::ExprTypeCheck(expr, _) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprCast(expr, _) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprAccess(expr) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprRawDeref(expr) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprAwait(expr) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprTry(expr) then
    resolve_expr(ctx, &expr)

  when ExprKind::ExprPipe(left, right) then
    resolve_expr(ctx, &left)
    resolve_expr(ctx, &right)

  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then resolve_expr(ctx, &s)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then resolve_expr(ctx, &e)
    when Option::None then ()
    end

  when ExprKind::ExprAsync(block) then
    rs_push_scope(ctx)
    for stmt in block.stmts do
      resolve_stmt(ctx, &stmt)
    end
    rs_pop_scope(ctx)

  when ExprKind::ExprComptime(block) then
    rs_push_scope(ctx)
    for stmt in block.stmts do
      resolve_stmt(ctx, &stmt)
    end
    rs_pop_scope(ctx)

  when ExprKind::ExprClosure(params, _, body) then
    rs_push_scope(ctx)
    for p in params do
      resolve_pattern_definition(ctx, &p.pat)
    end
    resolve_expr(ctx, &body)
    rs_pop_scope(ctx)

  when ExprKind::ExprAssign(target, value) then
    # Assignment (expression form): resolve both sides.
    resolve_expr(ctx, &target)
    resolve_expr(ctx, &value)

  when ExprKind::ExprMacroCall(name, args) then
    # Macro invocations are expanded by prepare_parsed BEFORE resolution; a
    # residual macro call is an unsupported construct here — report it
    # explicitly instead of silently skipping it.
    for arg in args do
      resolve_expr(ctx, &arg)
    end
    rs_add_error(&mut ctx.symbols, ResolutionErrorKind::Unsupported,
      "unsupported expression: residual macro call `" + name + "`", expr.span.clone())

  when ExprKind::ExprError(_) then
    # Skip error expressions (the parser's recovery sentinel; the parse
    # error is already reported)
    ()
  end
end