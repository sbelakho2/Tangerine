use std::core::{Option}
use std::collections::{Vec, Map}
use tg_compiler::token::{Span}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FunctionSig, FnBody, TraitMethod, ExternItem,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind, Param,
  AccessConvention, GuardElse, MatchExpr, IfStmt, ForStmt, ClosureParam
}
use tg_compiler::types::{Type, TypeKind, ParamType, AccessEffect, TypedProgram}

enum ResourceState
  Uninitialized
  Live
  Consumed
  MaybeLive
end

struct ResourceError
  message: String
  span: Span
end

struct ResFrame
  names: Vec[Int]
  states: Map[Int, ResourceState]
  caps: Vec[Int]
  spans: Map[Int, Span]
end

enum FlowKind
  Linear
  IfSplit
  Join
  LoopHeader
  LoopAfter
  MatchSplit
  MatchJoin
  TrySplit
  TryJoin
  Terminator
end

struct FlowNode
  kind: FlowKind
  stmt: &Stmt
end

enum ResBlockKind
  Entry
  Body
  Join
  Terminator
end

struct ResBlock
  kind: ResBlockKind
  start: Int
  end_index: Int
  successors: Vec[Int]
end

struct ResFlow
  nodes: Vec[FlowNode]
  blocks: Vec[ResBlock]
end

pub def resource_check(program: &Program, typed: &TypedProgram) -> Vec[ResourceError]
  mut errors = Vec::new()
  mut i = 0
  while i < program.items.len() do
    check_item(program, typed, &program.items[i], &mut errors)
    i = i + 1
  end
  errors
end

def type_kind_contains_resource(kinds: &Map[Int, TypeKind], ty: &Type) -> Bool
  match ty
  when Type::Named(id, args) then
    match kinds.get(id.id)
    when Option::Some(k) then
      if k == TypeKind::Resource then
        true
      elsif k == TypeKind::Capability then
        true
      else
        type_args_contain_resource(kinds, &args)
      end
    when Option::None then type_args_contain_resource(kinds, &args)
    end
  when Type::Option(inner) then type_kind_contains_resource(kinds, &inner)
  when Type::Result(ok, err) then
    type_kind_contains_resource(kinds, &ok) || type_kind_contains_resource(kinds, &err)
  when Type::Map(k, v) then
    type_kind_contains_resource(kinds, &k) || type_kind_contains_resource(kinds, &v)
  when Type::Set(inner) then type_kind_contains_resource(kinds, &inner)
  when Type::Slice(inner) then type_kind_contains_resource(kinds, &inner)
  when Type::Array(inner, _) then type_kind_contains_resource(kinds, &inner)
  when Type::Tuple(fields) then
    type_fields_contain_resource(kinds, &fields)
  when Type::Function(params, ret) then
    if type_params_contain_resource(kinds, &params) then
      true
    else
      type_kind_contains_resource(kinds, &ret)
    end
  when Type::RefInternal(inner, _) then type_kind_contains_resource(kinds, &inner)
  when _ then false
  end
end

def type_args_contain_resource(kinds: &Map[Int, TypeKind], args: &Vec[Type]) -> Bool
  mut i = 0
  while i < args.len() do
    if type_kind_contains_resource(kinds, &args[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_fields_contain_resource(kinds: &Map[Int, TypeKind], fields: &Vec[Type]) -> Bool
  mut i = 0
  while i < fields.len() do
    if type_kind_contains_resource(kinds, &fields[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_params_contain_resource(kinds: &Map[Int, TypeKind], params: &Vec[ParamType]) -> Bool
  mut i = 0
  while i < params.len() do
    if type_kind_contains_resource(kinds, &params[i].ty) then
      return true
    end
    i = i + 1
  end
  false
end

def type_kind_contains_capability(kinds: &Map[Int, TypeKind], ty: &Type) -> Bool
  match ty
  when Type::Named(id, args) then
    match kinds.get(id.id)
    when Option::Some(k) then
      if k == TypeKind::Capability then
        true
      else
        type_args_contain_capability(kinds, &args)
      end
    when Option::None then type_args_contain_capability(kinds, &args)
    end
  when Type::Option(inner) then type_kind_contains_capability(kinds, &inner)
  when Type::Result(ok, err) then
    type_kind_contains_capability(kinds, &ok) || type_kind_contains_capability(kinds, &err)
  when Type::Map(k, v) then
    type_kind_contains_capability(kinds, &k) || type_kind_contains_capability(kinds, &v)
  when Type::Set(inner) then type_kind_contains_capability(kinds, &inner)
  when Type::Slice(inner) then type_kind_contains_capability(kinds, &inner)
  when Type::Array(inner, _) then type_kind_contains_capability(kinds, &inner)
  when Type::Tuple(fields) then
    type_fields_contain_capability(kinds, &fields)
  when Type::Function(params, ret) then
    if type_params_contain_capability(kinds, &params) then
      true
    else
      type_kind_contains_capability(kinds, &ret)
    end
  when Type::RefInternal(inner, _) then type_kind_contains_capability(kinds, &inner)
  when _ then false
  end
end

def type_args_contain_capability(kinds: &Map[Int, TypeKind], args: &Vec[Type]) -> Bool
  mut i = 0
  while i < args.len() do
    if type_kind_contains_capability(kinds, &args[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_fields_contain_capability(kinds: &Map[Int, TypeKind], fields: &Vec[Type]) -> Bool
  mut i = 0
  while i < fields.len() do
    if type_kind_contains_capability(kinds, &fields[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_params_contain_capability(kinds: &Map[Int, TypeKind], params: &Vec[ParamType]) -> Bool
  mut i = 0
  while i < params.len() do
    if type_kind_contains_capability(kinds, &params[i].ty) then
      return true
    end
    i = i + 1
  end
  false
end

def binding_lid(typed: &TypedProgram, frame: &ResFrame, name: &String, floor: Int) -> Option[Int]
  mut best: Option[Int] = Option::None
  mut best_nid = 2147483647
  let entries = typed.ident_resolutions.entries()
  mut i = 0
  while i < entries.len() do
    let nid = entries[i].0
    let lid = entries[i].1
    if nid > floor then
      if !res_frame_has(frame, &lid) then
        match typed.local_bindings.get(lid)
        when Option::Some(lb) then
          if lb.name == name then
            if nid < best_nid then
              best = Option::Some(lid)
              best_nid = nid
            end
          end
        when Option::None then ()
        end
      end
    end
    i = i + 1
  end
  match best
  when Option::Some(l) then Option::Some(l)
  when Option::None then
    mut newest: Option[Int] = Option::None
    mut best_id = -1
    let binds = typed.local_bindings.entries()
    mut j = 0
    while j < binds.len() do
      if binds[j].1.name == name then
        if binds[j].0 > best_id then
          newest = Option::Some(binds[j].0)
          best_id = binds[j].0
        end
      end
      j = j + 1
    end
    newest
  end
end

def binding_name(typed: &TypedProgram, id: Int) -> String
  match typed.local_bindings.get(id)
  when Option::Some(lb) then lb.name.clone()
  when Option::None then ""
  end
end

def check_item(program: &Program, typed: &TypedProgram, item: &Item, errors: &mut Vec[ResourceError]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    check_function(program, typed, &f, errors)
  when ItemKind::ItemStruct(s) then
    mut frame = res_frame_new()
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then check_expr(program, typed, &e, &Vec::new(), &mut frame, errors)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      check_function(program, typed, &s.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut frame = res_frame_new()
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then check_expr(program, typed, &d, &Vec::new(), &mut frame, errors)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      check_trait_method(program, typed, &t.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      check_function(program, typed, &im.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      check_item(program, typed, &m.items[i], errors)
      i = i + 1
    end
  when ItemKind::ItemUse(_) then ()
  when ItemKind::ItemMacro(mac) then
    mut frame = res_frame_new()
    check_block(program, typed, &mac.body, &Vec::new(), &mut frame, errors)
  when ItemKind::ItemTypeAlias(_) then ()
  when ItemKind::ItemConst(c) then
    mut frame = res_frame_new()
    check_expr(program, typed, &c.value, &Vec::new(), &mut frame, errors)
  when ItemKind::ItemStatic(s) then
    mut frame = res_frame_new()
    check_expr(program, typed, &s.value, &Vec::new(), &mut frame, errors)
  when ItemKind::ItemCapabilityDecl(_) then ()
  when ItemKind::ItemEffectDecl(_) then ()
  when ItemKind::ItemRationaleBlock(_) then ()
  when ItemKind::ItemEditionDecl(_) then ()
  when ItemKind::ItemExternBlock(ext) then
    mut frame = res_frame_new()
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        check_params_defaults(program, typed, &ef.params, &mut frame, errors)
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  end
end

def check_function(program: &Program, typed: &TypedProgram, f: &FunctionDecl, errors: &mut Vec[ResourceError]) -> Unit
  mut frame = res_frame_new()
  let entry_ids = bind_params(typed, &f.params, &mut frame, fn_floor(f))
  check_params_defaults(program, typed, &f.params, &mut frame, errors)
  mut i = 0
  while i < f.contracts.len() do
    check_expr(program, typed, &f.contracts[i].expr, &Vec::new(), &mut frame, errors)
    i = i + 1
  end
  check_fn_body(program, typed, &f.body, &mut frame, errors)
  exit_scope(&mut frame, &entry_ids, typed, errors)
  check_uninitialized_exit(&frame, typed, errors)
end

def check_trait_method(program: &Program, typed: &TypedProgram, m: &TraitMethod, errors: &mut Vec[ResourceError]) -> Unit
  mut frame = res_frame_new()
  let entry_ids = bind_params(typed, &m.sig.params, &mut frame, sig_floor(&m.sig, &m.default_body))
  check_params_defaults(program, typed, &m.sig.params, &mut frame, errors)
  check_fn_body(program, typed, &m.default_body, &mut frame, errors)
  exit_scope(&mut frame, &entry_ids, typed, errors)
  check_uninitialized_exit(&frame, typed, errors)
end

def fn_floor(f: &FunctionDecl) -> Int
  mut acc = 2147483647
  mut i = 0
  while i < f.params.len() do
    match f.params[i].default
    when Option::Some(e) then
      if e.node_id < acc then acc = e.node_id end
    when Option::None then ()
    end
    i = i + 1
  end
  i = 0
  while i < f.contracts.len() do
    if f.contracts[i].expr.node_id < acc then acc = f.contracts[i].expr.node_id end
    i = i + 1
  end
  fn_body_floor(&f.body, &mut acc)
  acc
end

def sig_floor(s: &FunctionSig, body: &FnBody) -> Int
  mut acc = 2147483647
  mut i = 0
  while i < s.params.len() do
    match s.params[i].default
    when Option::Some(e) then
      if e.node_id < acc then acc = e.node_id end
    when Option::None then ()
    end
    i = i + 1
  end
  fn_body_floor(body, &mut acc)
  acc
end

def fn_body_floor(body: &FnBody, acc: &mut Int) -> Unit
  match body
  when FnBody::FnBlock(b) then
    if b.stmts.len() > 0 then
      if b.stmts[0].node_id < acc then acc = b.stmts[0].node_id end
    end
  when FnBody::FnExpr(e) then
    if e.node_id < acc then acc = e.node_id end
  when _ then ()
  end
end

def bind_params(typed: &TypedProgram, params: &Vec[Param], frame: &mut ResFrame, floor: Int) -> Vec[Int]
  mut out = Vec::new()
  mut i = 0
  while i < params.len() do
    match bind_param(typed, &params[i], frame, floor)
    when Option::Some(id) then out.push(id)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

def bind_param(typed: &TypedProgram, p: &Param, frame: &mut ResFrame, floor: Int) -> Option[Int]
  if p.convention == AccessConvention::Inout then
    return Option::None
  end
  match binding_lid(typed, frame, &p.name, floor)
  when Option::Some(id) then
    match typed.local_bindings.get(id)
    when Option::Some(lb) then
      if type_kind_contains_resource(&typed.type_kinds, &lb.ty) then
        let init_state = match p.convention
        when AccessConvention::Set then ResourceState::Uninitialized
        when _ then ResourceState::Live
        end
        res_frame_set(frame, id, init_state)
        res_frame_set_span(frame, &id, p.span)
      end
      if type_kind_contains_capability(&typed.type_kinds, &lb.ty) then
        res_frame_mark_cap(frame, &id)
      end
      Option::Some(id)
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

def check_params_defaults(program: &Program, typed: &TypedProgram, params: &Vec[Param], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  mut i = 0
  while i < params.len() do
    match params[i].default
    when Option::Some(e) then check_expr(program, typed, &e, &Vec::new(), frame, errors)
    when Option::None then ()
    end
    i = i + 1
  end
end

def check_fn_body(program: &Program, typed: &TypedProgram, body: &FnBody, frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match body
  when FnBody::FnBlock(b) then check_block(program, typed, &b, &Vec::new(), frame, errors)
  when FnBody::FnExpr(e) then
    check_expr(program, typed, &e, &Vec::new(), frame, errors)
    transfer_consume(typed, &e, &Vec::new(), frame, errors)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end
end

def flatten_flow(stmt: &Stmt, out: &mut Vec[FlowNode]) -> Unit
  # Structural statements (if/match/loops/try/with/guard/handle-with) are
  # Linear nodes: their internal branch flow is analyzed by the corresponding
  # check_* handler (branch clones + merge_frames). Only statements that
  # terminate the current flow end a block.
  match stmt.kind
  when StmtKind::StmtReturn(_) then out.push(FlowNode { kind: FlowKind::Terminator, stmt: stmt })
  when StmtKind::StmtBreak(_) then out.push(FlowNode { kind: FlowKind::Terminator, stmt: stmt })
  when StmtKind::StmtContinue then out.push(FlowNode { kind: FlowKind::Terminator, stmt: stmt })
  when StmtKind::StmtYield(_) then out.push(FlowNode { kind: FlowKind::Terminator, stmt: stmt })
  when _ then out.push(FlowNode { kind: FlowKind::Linear, stmt: stmt })
  end
end

def flatten_block(block: &Block, out: &mut Vec[FlowNode]) -> Unit
  mut i = 0
  while i < block.stmts.len() do
    flatten_flow(&block.stmts[i], out)
    i = i + 1
  end
end

def build_res_blocks(block: &Block) -> Vec[ResBlock]
  mut nodes = Vec::new()
  flatten_block(block, &mut nodes)
  let mut blocks = build_blocks_from_nodes(&nodes)
  set_block_successors(&mut blocks)
  blocks
end

def build_blocks_from_nodes(nodes: &Vec[FlowNode]) -> Vec[ResBlock]
  mut blocks = Vec::new()
  mut block_start = 0
  mut has_term = false
  mut i = 0
  while i < nodes.len() do
    match nodes[i].kind
    when FlowKind::Linear then
      i = i + 1
    when FlowKind::Terminator then
      has_term = true
      i = i + 1
    when _ then
      if i > block_start then
        blocks.push(res_block_for(nodes, block_start, i, has_term, blocks.len()))
        has_term = false
      end
      blocks.push(res_block_for(nodes, i, i + 1, false, blocks.len()))
      block_start = i + 1
      i = i + 1
    end
  end
  if nodes.len() > block_start then
    blocks.push(res_block_for(nodes, block_start, nodes.len(), has_term, blocks.len()))
  end
  blocks
end

def res_block_for(nodes: &Vec[FlowNode], start: Int, end_index: Int, has_term: Bool, index: Int) -> ResBlock
  let kind = if has_term then
    ResBlockKind::Terminator
  elsif index == 0 then
    ResBlockKind::Entry
  elsif end_index - start == 1 then
    match nodes[start].kind
    when FlowKind::Join then ResBlockKind::Join
    when _ then ResBlockKind::Body
    end
  else
    ResBlockKind::Body
  end
  ResBlock { kind: kind, start: start, end_index: end_index, successors: Vec::new() }
end

def set_block_successors(blocks: &mut Vec[ResBlock]) -> Unit
  mut i = 0
  while i < blocks.len() do
    if i + 1 < blocks.len() then
      match blocks[i].kind
      when ResBlockKind::Terminator then ()
      when _ then blocks[i].successors.push(i + 1)
      end
    end
    i = i + 1
  end
end

def block_predecessors(flow: &ResFlow, idx: Int) -> Vec[Int]
  mut out = Vec::new()
  mut i = 0
  while i < flow.blocks.len() do
    if flow.blocks[i].successors.contains(&idx) then
      out.push(i)
    end
    i = i + 1
  end
  out
end

def build_res_flow(block: &Block) -> ResFlow
  mut nodes = Vec::new()
  flatten_block(block, &mut nodes)
  let blocks = build_res_blocks(block)
  ResFlow { nodes: nodes, blocks: blocks }
end

def check_block(program: &Program, typed: &TypedProgram, block: &Block, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  let entry_names = res_frame_names_clone(frame)
  let flow = build_res_flow(block)
  if flow.blocks.len() > 0 then
    run_res_flow(program, typed, &flow, loop_outer, frame, errors)
  end
  exit_scope(frame, &entry_names, typed, errors)
end

def run_res_flow(program: &Program, typed: &TypedProgram, flow: &ResFlow, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  let n = flow.blocks.len()
  mut incoming = Vec::new()
  mut exits = Vec::new()
  mut seen = Vec::new()
  mut i = 0
  while i < n do
    incoming.push(res_frame_new())
    exits.push(res_frame_new())
    seen.push(false)
    i = i + 1
  end
  mut queue = Vec::new()
  queue.push(0)
  mut iters = 0
  while queue.len() > 0 && iters < 2000 do
    match queue.pop()
    when Option::Some(bi) then
      iters = iters + 1
      let preds = block_predecessors(flow, bi)
      let new_incoming = if preds.len() == 0 then
        res_frame_clone(frame)
      else
        mut arms = Vec::new()
        mut pi = 0
        while pi < preds.len() do
          arms.push(res_frame_clone(&exits[preds[pi]]))
          pi = pi + 1
        end
        merge_frames(&arms)
      end
      if !seen[bi] || !res_frame_equal(&new_incoming, &incoming[bi]) then
        incoming[bi] = new_incoming
        seen[bi] = true
        let rb = &flow.blocks[bi]
        mut bf = res_frame_clone(&incoming[bi])
        mut dead = false
        mut ni = rb.start
        while ni < rb.end_index do
          let node = &flow.nodes[ni]
          match node.kind
          when FlowKind::Linear then
            if !dead then
              check_stmt(program, typed, node.stmt, loop_outer, &mut bf, errors)
            end
          when FlowKind::Terminator then
            if !dead then
              check_terminator_stmt(program, typed, node.stmt, loop_outer, &mut bf, errors)
              dead = true
            end
          when _ then ()
          end
          ni = ni + 1
        end
        exits[bi] = bf
        let succs = &rb.successors
        mut si = 0
        while si < succs.len() do
          queue.push(succs[si])
          si = si + 1
        end
      end
    when Option::None then ()
    end
  end
  mut tails = Vec::new()
  i = 0
  while i < n do
    if seen[i] then
      if flow.blocks[i].successors.len() == 0 then
        tails.push(res_frame_clone(&exits[i]))
      end
    end
    i = i + 1
  end
  let final_frame = merge_frames(&tails)
  frame_assign(frame, &final_frame)
end

def check_return_stmt(program: &Program, typed: &TypedProgram, val_opt: Option[Expr], loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match val_opt
  when Option::Some(val) then
    check_expr(program, typed, &val, loop_outer, frame, errors)
    transfer_consume(typed, &val, loop_outer, frame, errors)
  when Option::None then ()
  end
end

def check_break_stmt(program: &Program, typed: &TypedProgram, val_opt: Option[Expr], loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match val_opt
  when Option::Some(val) then
    check_expr(program, typed, &val, loop_outer, frame, errors)
    transfer_consume(typed, &val, loop_outer, frame, errors)
  when Option::None then ()
  end
end

def check_yield_stmt(program: &Program, typed: &TypedProgram, val_opt: Option[Expr], loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match val_opt
  when Option::Some(val) then
    check_expr(program, typed, &val, loop_outer, frame, errors)
    transfer_consume(typed, &val, loop_outer, frame, errors)
  when Option::None then ()
  end
end

def check_terminator_stmt(program: &Program, typed: &TypedProgram, stmt: &Stmt, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match stmt.kind
  when StmtKind::StmtReturn(val_opt) then check_return_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when StmtKind::StmtBreak(val_opt) then check_break_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtYield(val_opt) then check_yield_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when _ then ()
  end
end

def check_stmt(program: &Program, typed: &TypedProgram, stmt: &Stmt, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    check_expr(program, typed, &value, loop_outer, frame, errors)
    transfer_consume(typed, &value, loop_outer, frame, errors)
    bind_pattern(typed, &pattern, value.node_id, stmt.span, frame)
  when StmtKind::StmtAssign(target, value) then
    check_assign_target(program, typed, &target, loop_outer, frame, errors)
    check_expr(program, typed, &value, loop_outer, frame, errors)
    transfer_consume(typed, &value, loop_outer, frame, errors)
    match expr_root_id(typed, &target)
    when Option::Some(id) then
      if res_frame_has(frame, &id) then
        apply_set(frame, id)
      end
    when Option::None then ()
    end
  when StmtKind::StmtCompoundAssign(_, target, value) then
    check_expr(program, typed, &target, loop_outer, frame, errors)
    check_expr(program, typed, &value, loop_outer, frame, errors)
  when StmtKind::StmtIf(if_stmt) then
    check_if(program, typed, &if_stmt, loop_outer, frame, errors)
  when StmtKind::StmtMatch(m) then
    check_match(program, typed, &m, loop_outer, frame, errors)
  when StmtKind::StmtWhile(cond, body) then
    check_loop(program, typed, Option::Some(&cond), &body, loop_outer, frame, errors)
  when StmtKind::StmtFor(for_stmt) then
    check_for(program, typed, &for_stmt, loop_outer, frame, errors)
  when StmtKind::StmtLoop(body) then
    check_loop(program, typed, Option::None, &body, loop_outer, frame, errors)
  when StmtKind::StmtReturn(val_opt) then check_return_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when StmtKind::StmtBreak(val_opt) then check_break_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtYield(val_opt) then check_yield_stmt(program, typed, val_opt, loop_outer, frame, errors)
  when StmtKind::StmtExpr(e) then
    check_expr(program, typed, &e, loop_outer, frame, errors)
  when StmtKind::StmtUnsafe(_, body) then
    check_block(program, typed, &body, loop_outer, frame, errors)
  when StmtKind::StmtDefer(body) then
    check_block(program, typed, &body, loop_outer, frame, errors)
  when StmtKind::StmtGuard(cond, else_action) then
    check_expr(program, typed, &cond, loop_outer, frame, errors)
    match else_action
    when GuardElse::Return(val_opt) then check_return_stmt(program, typed, val_opt, loop_outer, frame, errors)
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then check_break_stmt(program, typed, val_opt, loop_outer, frame, errors)
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    mut try_frame = res_frame_clone(frame)
    check_block(program, typed, &body, loop_outer, &mut try_frame, errors)
    mut arms = Vec::new()
    arms.push(res_frame_clone(&try_frame))
    mut i = 0
    while i < catches.len() do
      mut cf = res_frame_clone(&try_frame)
      check_block(program, typed, &catches[i].body, loop_outer, &mut cf, errors)
      arms.push(cf)
      i = i + 1
    end
    let merged = merge_frames(&arms)
    frame_assign(frame, &merged)
    match finally_block
    when Option::Some(fb) then check_block(program, typed, &fb, loop_outer, frame, errors)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, name, body) then
    check_expr(program, typed, &expr, loop_outer, frame, errors)
    let with_pat = Pattern { kind: PatternKind::Ident(name.clone(), false), span: stmt.span }
    bind_pattern(typed, &with_pat, expr.node_id, stmt.span, frame)
    check_block(program, typed, &body, loop_outer, frame, errors)
  when StmtKind::StmtHandleWith(expr, handlers) then
    check_expr(program, typed, &expr, loop_outer, frame, errors)
    mut i = 0
    while i < handlers.len() do
      mut arms = Vec::new()
      mut j = 0
      while j < handlers[i].arms.len() do
        mut hf = res_frame_clone(frame)
        check_block(program, typed, &handlers[i].arms[j].body, loop_outer, &mut hf, errors)
        arms.push(hf)
        j = j + 1
      end
      let merged = merge_frames(&arms)
      frame_assign(frame, &merged)
      i = i + 1
    end
  end
end

def check_if(program: &Program, typed: &TypedProgram, if_stmt: &IfStmt, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  check_expr(program, typed, &if_stmt.cond, loop_outer, frame, errors)
  mut arms = Vec::new()
  mut then_frame = res_frame_clone(frame)
  check_block(program, typed, &if_stmt.then_block, loop_outer, &mut then_frame, errors)
  arms.push(then_frame)
  mut i = 0
  while i < if_stmt.elsif_branches.len() do
    check_expr(program, typed, &if_stmt.elsif_branches[i].0, loop_outer, frame, errors)
    mut arm = res_frame_clone(frame)
    check_block(program, typed, &if_stmt.elsif_branches[i].1, loop_outer, &mut arm, errors)
    arms.push(arm)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then
    mut arm = res_frame_clone(frame)
    check_block(program, typed, &eb, loop_outer, &mut arm, errors)
    arms.push(arm)
  when Option::None then
    arms.push(res_frame_clone(frame))
  end
  let merged = merge_frames(&arms)
  frame_assign(frame, &merged)
end

def check_match(program: &Program, typed: &TypedProgram, m: &MatchExpr, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  check_expr(program, typed, &m.scrutinee, loop_outer, frame, errors)
  mut arms = Vec::new()
  mut i = 0
  while i < m.arms.len() do
    # Each arm's pattern bindings and guard are evaluated on a private clone
    # of the pre-match frame; the clone is discarded after the arm, so an
    # effect in one arm's guard cannot leak into another arm or the join.
    mut arm_pre = res_frame_clone(frame)
    check_pattern(program, typed, &m.arms[i].pattern, loop_outer, &mut arm_pre, errors)
    bind_pattern(typed, &m.arms[i].pattern, m.scrutinee.node_id, m.arms[i].pattern.span, &mut arm_pre)
    match m.arms[i].guard_expr
    when Option::Some(g) then check_expr(program, typed, &g, loop_outer, &mut arm_pre, errors)
    when Option::None then ()
    end
    mut arm = res_frame_clone(&arm_pre)
    check_block(program, typed, &m.arms[i].body, loop_outer, &mut arm, errors)
    arms.push(arm)
    i = i + 1
  end
  let merged = merge_frames(&arms)
  frame_assign(frame, &merged)
end

def check_loop(program: &Program, typed: &TypedProgram, cond: Option[&Expr], body: &Block, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  let entry = res_frame_clone(frame)
  let entry_names = res_frame_names_clone(&entry)
  match cond
  when Option::Some(c) then
    check_expr(program, typed, c, &entry_names, frame, errors)
  when Option::None then ()
  end
  let after = check_loop_body(program, typed, body, &entry, &entry_names, errors)
  frame_assign(frame, &after)
end

def check_for(program: &Program, typed: &TypedProgram, for_stmt: &ForStmt, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  let pre_entry = res_frame_clone(frame)
  let pre_entry_names = res_frame_names_clone(&pre_entry)
  check_pattern(program, typed, &for_stmt.pattern, &pre_entry_names, frame, errors)
  bind_pattern(typed, &for_stmt.pattern, for_stmt.iter.node_id, for_stmt.span, frame)
  check_expr(program, typed, &for_stmt.iter, &pre_entry_names, frame, errors)
  let entry = res_frame_clone(frame)
  let entry_names = res_frame_names_clone(&entry)
  let after = check_loop_body(program, typed, &for_stmt.body, &entry, &entry_names, errors)
  frame_assign(frame, &after)
end

def check_loop_body(program: &Program, typed: &TypedProgram, body: &Block, entry: &ResFrame, entry_names: &Vec[Int], errors: &mut Vec[ResourceError]) -> ResFrame
  mut bf = res_frame_clone(entry)
  mut i = 0
  while i < body.stmts.len() do
    check_stmt(program, typed, &body.stmts[i], entry_names, &mut bf, errors)
    i = i + 1
  end
  let to_forget = check_loop_created(entry, entry_names, &bf, typed, errors)
  i = 0
  while i < to_forget.len() do
    res_frame_forget(&mut bf, &to_forget[i])
    i = i + 1
  end
  res_frame_clone(entry)
end

def check_loop_created(entry: &ResFrame, entry_names: &Vec[Int], bf: &ResFrame, typed: &TypedProgram, errors: &mut Vec[ResourceError]) -> Vec[Int]
  mut to_forget = Vec::new()
  mut i = 0
  while i < bf.names.len() do
    let id = bf.names[i]
    match res_frame_get(bf, &id)
    when Option::Some(ResourceState::Live) then
      if is_loop_created(entry, entry_names, &id) then
        errors.push(ResourceError {
          message: "resource `" + binding_name(typed, id) + "` created in loop must be consumed each iteration",
          span: frame_span(bf, &id)
        })
        to_forget.push(id)
      end
    when Option::Some(ResourceState::MaybeLive) then
      if is_loop_created(entry, entry_names, &id) then
        errors.push(ResourceError {
          message: "resource `" + binding_name(typed, id) + "` created in loop must be consumed each iteration",
          span: frame_span(bf, &id)
        })
        to_forget.push(id)
      end
    when _ then ()
    end
    i = i + 1
  end
  to_forget
end

def is_loop_created(entry: &ResFrame, entry_names: &Vec[Int], id: &Int) -> Bool
  if !entry_names.contains(id) then
    return true
  end
  match res_frame_get(entry, id)
  when Option::Some(ResourceState::Uninitialized) then true
  when _ then false
  end
end

def check_pattern(program: &Program, typed: &TypedProgram, pat: &Pattern, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(e) then check_expr(program, typed, &e, loop_outer, frame, errors)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], loop_outer, frame, errors)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], loop_outer, frame, errors)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      check_pattern(program, typed, &field_pats[i].1, loop_outer, frame, errors)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], loop_outer, frame, errors)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      check_pattern(program, typed, &alts[i], loop_outer, frame, errors)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then check_expr(program, typed, &e, loop_outer, frame, errors)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then check_expr(program, typed, &e, loop_outer, frame, errors)
    when Option::None then ()
    end
  end
end

def bind_pattern(typed: &TypedProgram, pat: &Pattern, floor: Int, span: Span, frame: &mut ResFrame) -> Unit
  match pat.kind
  when PatternKind::Ident(name, _) then
    match binding_lid(typed, frame, &name, floor)
    when Option::Some(id) then
      match typed.local_bindings.get(id)
      when Option::Some(lb) then
        if type_kind_contains_resource(&typed.type_kinds, &lb.ty) then
          res_frame_set(frame, id, ResourceState::Live)
          res_frame_set_span(frame, &id, span)
        end
        if type_kind_contains_capability(&typed.type_kinds, &lb.ty) then
          res_frame_mark_cap(frame, &id)
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

def check_expr(program: &Program, typed: &TypedProgram, expr: &Expr, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, &elems[i], loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, &elems[i], loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      check_expr(program, typed, &fields[i].1, loop_outer, frame, errors)
      transfer_consume(typed, &fields[i].1, loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      check_expr(program, typed, &entries[i].0, loop_outer, frame, errors)
      check_expr(program, typed, &entries[i].1, loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then check_use(typed, l, expr.span, frame, errors)
    when Option::None then ()
    end
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    check_expr(program, typed, &lhs, loop_outer, frame, errors)
    check_expr(program, typed, &rhs, loop_outer, frame, errors)
  when ExprKind::ExprUnaryOp(_, operand) then
    check_expr(program, typed, &operand, loop_outer, frame, errors)
  when ExprKind::ExprFieldAccess(base, _) then
    check_expr(program, typed, &base, loop_outer, frame, errors)
  when ExprKind::ExprMethodCall(recv, method, _, args) then
    check_expr_method_call(program, typed, &recv, &method, &args, loop_outer, frame, errors)
  when ExprKind::ExprIndex(base, index) then
    check_expr(program, typed, &base, loop_outer, frame, errors)
    check_expr(program, typed, &index, loop_outer, frame, errors)
  when ExprKind::ExprCall(callee, args) then
    check_expr_call(program, typed, &callee, &args, loop_outer, frame, errors)
  when ExprKind::ExprClosure(params, _, body) then
    mut cframe = res_frame_new()
    let entry_ids = bind_closure_params(typed, &params, &mut cframe, expr.node_id)
    check_expr(program, typed, &body, &Vec::new(), &mut cframe, errors)
    exit_scope(&mut cframe, &entry_ids, typed, errors)
    check_uninitialized_exit(&cframe, typed, errors)
  when ExprKind::ExprAccess(inner) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprRawDeref(inner) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprIf(if_stmt) then
    check_if(program, typed, &if_stmt, loop_outer, frame, errors)
  when ExprKind::ExprMatch(m) then
    check_match(program, typed, &m, loop_outer, frame, errors)
  when ExprKind::ExprBlock(block) then
    check_block(program, typed, &block, loop_outer, frame, errors)
  when ExprKind::ExprUnsafe(_, block) then
    check_block(program, typed, &block, loop_outer, frame, errors)
  when ExprKind::ExprAsync(block) then
    check_block(program, typed, &block, loop_outer, frame, errors)
  when ExprKind::ExprAwait(inner) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprTry(inner) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then check_expr(program, typed, &s, loop_outer, frame, errors)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then check_expr(program, typed, &e, loop_outer, frame, errors)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprTypeCheck(inner, _) then check_expr(program, typed, &inner, loop_outer, frame, errors)
  when ExprKind::ExprComptime(block) then
    check_block(program, typed, &block, loop_outer, frame, errors)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, &args[i], loop_outer, frame, errors)
      transfer_consume(typed, &args[i], loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    check_assign_target(program, typed, &target, loop_outer, frame, errors)
    check_expr(program, typed, &value, loop_outer, frame, errors)
    transfer_consume(typed, &value, loop_outer, frame, errors)
    match expr_root_id(typed, &target)
    when Option::Some(id) then
      if res_frame_has(frame, &id) then
        apply_set(frame, id)
      end
    when Option::None then ()
    end
  when ExprKind::ExprPipe(lhs, rhs) then
    check_expr(program, typed, &lhs, loop_outer, frame, errors)
    check_expr(program, typed, &rhs, loop_outer, frame, errors)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, &args[i], loop_outer, frame, errors)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end
end

def check_expr_call(program: &Program, typed: &TypedProgram, callee: &Expr, args: &Vec[Expr], loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  check_expr(program, typed, callee, loop_outer, frame, errors)
  match callee_name(callee)
  when Option::Some(name) then
    match find_function(program, &name)
    when Option::Some(params) then
      mut i = 0
      while i < args.len() do
        let eff = match typed.access_effects.get(args[i].node_id)
        when Option::Some(e) then e
        when Option::None then
          if i < params.len() then convention_effect(params[i].convention) else AccessEffect::Read end
        end
        apply_arg_effect(program, typed, &args[i], eff, loop_outer, frame, errors)
        i = i + 1
      end
    when Option::None then
      mut i = 0
      while i < args.len() do
        let eff = match typed.access_effects.get(args[i].node_id)
        when Option::Some(e) then e
        when Option::None then AccessEffect::Read
        end
        apply_arg_effect(program, typed, &args[i], eff, loop_outer, frame, errors)
        i = i + 1
      end
    end
  when Option::None then
    mut i = 0
    while i < args.len() do
      let eff = match typed.access_effects.get(args[i].node_id)
      when Option::Some(e) then e
      when Option::None then AccessEffect::Read
      end
      apply_arg_effect(program, typed, &args[i], eff, loop_outer, frame, errors)
      i = i + 1
    end
  end
end

def check_expr_method_call(program: &Program, typed: &TypedProgram, receiver: &Expr, method: &String, args: &Vec[Expr], loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  let is_deinit = method == "deinit"
  match find_method(program, method)
  when Option::Some(params) then
    mut self_idx = -1
    mut i = 0
    while i < params.len() do
      if params[i].name == "self" then
        self_idx = i
        break
      end
      i = i + 1
    end
    let recv_effect = if is_deinit then
      AccessEffect::Consume
    elsif self_idx >= 0 then
      match params[self_idx].convention
      when AccessConvention::Inout then AccessEffect::Modify
      when AccessConvention::Sink then AccessEffect::Consume
      when _ then AccessEffect::Read
      end
    else AccessEffect::Read end
    apply_arg_effect(program, typed, receiver, recv_effect, loop_outer, frame, errors)
    i = 0
    while i < args.len() do
      let param_idx = if self_idx >= 0 then self_idx + 1 + i else i end
      let eff = match typed.access_effects.get(args[i].node_id)
      when Option::Some(e) then e
      when Option::None then
        if param_idx < params.len() then convention_effect(params[param_idx].convention) else AccessEffect::Read end
      end
      apply_arg_effect(program, typed, &args[i], eff, loop_outer, frame, errors)
      i = i + 1
    end
  when Option::None then
    let recv_effect = if is_deinit then AccessEffect::Consume else AccessEffect::Read end
    apply_arg_effect(program, typed, receiver, recv_effect, loop_outer, frame, errors)
    mut i = 0
    while i < args.len() do
      let eff = match typed.access_effects.get(args[i].node_id)
      when Option::Some(e) then e
      when Option::None then AccessEffect::Read
      end
      apply_arg_effect(program, typed, &args[i], eff, loop_outer, frame, errors)
      i = i + 1
    end
  end
end

def check_assign_target(program: &Program, typed: &TypedProgram, target: &Expr, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match expr_root_id(typed, target)
  when Option::Some(id) then
    if res_frame_has(frame, &id) then
      match res_frame_get(frame, &id)
      when Option::Some(ResourceState::Uninitialized) then
        if expr_is_plain(target) then
          apply_set(frame, id)
        else
          check_use(typed, id, target.span, frame, errors)
        end
      when _ then
        check_use(typed, id, target.span, frame, errors)
      end
    end
  when Option::None then
    check_expr(program, typed, target, loop_outer, frame, errors)
  end
end

def apply_arg_effect(program: &Program, typed: &TypedProgram, arg: &Expr, effect: AccessEffect, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match expr_root_id(typed, arg)
  when Option::Some(id) then
    if res_frame_has(frame, &id) then
      if expr_is_plain(arg) then
        match effect
        when AccessEffect::Consume then apply_consume(typed, id, arg.span, loop_outer, frame, errors)
        when AccessEffect::Initialize then apply_set(frame, id)
        when _ then check_use(typed, id, arg.span, frame, errors)
        end
      else
        check_use(typed, id, arg.span, frame, errors)
      end
    end
  when Option::None then
    check_expr(program, typed, arg, loop_outer, frame, errors)
  end
end

def apply_consume(typed: &TypedProgram, id: Int, span: Span, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  if loop_outer.contains(&id) then
    errors.push(ResourceError {
      message: "resource `" + binding_name(typed, id) + "` cannot be consumed inside a repeatable loop",
      span: span
    })
  end
  match res_frame_get(frame, &id)
  when Option::Some(ResourceState::Consumed) then
    errors.push(ResourceError {
      message: "resource `" + binding_name(typed, id) + "` consumed twice",
      span: span
    })
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized resource `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::MaybeLive) then
    errors.push(ResourceError {
      message: "resource `" + binding_name(typed, id) + "` may be consumed on one path",
      span: span
    })
  when _ then ()
  end
  res_frame_set(frame, id, ResourceState::Consumed)
end

def apply_set(frame: &mut ResFrame, id: Int) -> Unit
  res_frame_set(frame, id, ResourceState::Live)
end

def check_use(typed: &TypedProgram, id: Int, span: Span, frame: &ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  match res_frame_get(frame, &id)
  when Option::Some(ResourceState::Consumed) then
    errors.push(ResourceError {
      message: "use of consumed resource `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized resource `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::MaybeLive) then
    errors.push(ResourceError {
      message: "resource `" + binding_name(typed, id) + "` may be consumed on one path",
      span: span
    })
  when _ then ()
  end
end

def exit_scope(frame: &mut ResFrame, entry_names: &Vec[Int], typed: &TypedProgram, errors: &mut Vec[ResourceError]) -> Unit
  mut to_forget = Vec::new()
  mut i = 0
  while i < frame.names.len() do
    let id = frame.names[i]
    if !entry_names.contains(&id) then
      match res_frame_get(frame, &id)
      when Option::Some(ResourceState::Live) then
        if frame.caps.contains(&id) then
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id) + "` silently discarded",
            span: frame_span(frame, &id)
          })
        end
      when Option::Some(ResourceState::MaybeLive) then
        if frame.caps.contains(&id) then
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id) + "` silently discarded",
            span: frame_span(frame, &id)
          })
        end
      when Option::Some(ResourceState::Uninitialized) then
        errors.push(ResourceError {
          message: "resource `" + binding_name(typed, id) + "` left uninitialized",
          span: frame_span(frame, &id)
        })
      when _ then ()
      end
      to_forget.push(id)
    end
    i = i + 1
  end
  i = 0
  while i < to_forget.len() do
    res_frame_forget(frame, &to_forget[i])
    i = i + 1
  end
end

def check_uninitialized_exit(frame: &ResFrame, typed: &TypedProgram, errors: &mut Vec[ResourceError]) -> Unit
  mut i = 0
  while i < frame.names.len() do
    let id = frame.names[i]
    match res_frame_get(frame, &id)
    when Option::Some(ResourceState::Uninitialized) then
      errors.push(ResourceError {
        message: "resource `" + binding_name(typed, id) + "` left uninitialized",
        span: frame_span(frame, &id)
      })
    when _ then ()
    end
    i = i + 1
  end
end

def res_frame_new() -> ResFrame
  ResFrame {
    names: Vec::new(),
    states: Map::new(),
    caps: Vec::new(),
    spans: Map::new()
  }
end

def res_frame_has(frame: &ResFrame, id: &Int) -> Bool
  frame.states.contains_key(id)
end

def res_frame_get(frame: &ResFrame, id: &Int) -> Option[ResourceState]
  match frame.states.get(id)
  when Option::Some(s) then Option::Some(s)
  when Option::None then Option::None
  end
end

def res_frame_set(frame: &mut ResFrame, id: Int, state: ResourceState) -> Unit
  if !frame.states.contains_key(&id) then
    frame.names.push(id)
  end
  frame.states.insert(id, state)
end

def res_frame_set_span(frame: &mut ResFrame, id: &Int, span: Span) -> Unit
  frame.spans.insert(id, span)
end

def frame_span(frame: &ResFrame, id: &Int) -> Span
  match frame.spans.get(id)
  when Option::Some(s) then s
  when Option::None then Span { file: String::new(), start: 0, end_pos: 0 }
  end
end

def res_frame_mark_cap(frame: &mut ResFrame, id: &Int) -> Unit
  frame.caps.push(id)
end

def res_frame_forget(frame: &mut ResFrame, id: &Int) -> Unit
  frame.states.remove(id)
  frame.spans.remove(id)
  mut i = 0
  while i < frame.names.len() do
    if frame.names[i] == id then
      frame.names.remove(i)
      break
    end
    i = i + 1
  end
  mut j = 0
  while j < frame.caps.len() do
    if frame.caps[j] == id then
      frame.caps.remove(j)
      break
    end
    j = j + 1
  end
end

def res_frame_names_clone(frame: &ResFrame) -> Vec[Int]
  mut out = Vec::new()
  mut i = 0
  while i < frame.names.len() do
    out.push(frame.names[i])
    i = i + 1
  end
  out
end

def res_frame_clone(frame: &ResFrame) -> ResFrame
  mut out = res_frame_new()
  mut i = 0
  while i < frame.names.len() do
    match res_frame_get(frame, &frame.names[i])
    when Option::Some(s) then
      res_frame_set(&mut out, frame.names[i], s)
      res_frame_set_span(&mut out, &frame.names[i], frame_span(frame, &frame.names[i]))
    when Option::None then ()
    end
    i = i + 1
  end
  mut j = 0
  while j < frame.caps.len() do
    out.caps.push(frame.caps[j])
    j = j + 1
  end
  out
end

def res_frame_equal(a: &ResFrame, b: &ResFrame) -> Bool
  if a.names.len() != b.names.len() then return false end
  mut i = 0
  while i < a.names.len() do
    let id = a.names[i]
    match res_frame_get(b, &id)
    when Option::Some(sb) then
      match res_frame_get(a, &id)
      when Option::Some(sa) then
        if !(sa == sb) then return false end
      when Option::None then return false
      end
    when Option::None then return false
    end
    i = i + 1
  end
  if a.caps.len() != b.caps.len() then return false end
  mut j = 0
  while j < a.caps.len() do
    if !b.caps.contains(&a.caps[j]) then return false end
    j = j + 1
  end
  true
end

def frame_assign(dst: &mut ResFrame, src: &ResFrame) -> Unit
  while dst.names.len() > 0 do
    let id = dst.names[0]
    res_frame_forget(dst, &id)
  end
  mut i = 0
  while i < src.names.len() do
    match res_frame_get(src, &src.names[i])
    when Option::Some(s) then
      res_frame_set(dst, src.names[i], s)
      res_frame_set_span(dst, &src.names[i], frame_span(src, &src.names[i]))
    when Option::None then ()
    end
    i = i + 1
  end
  mut j = 0
  while j < src.caps.len() do
    dst.caps.push(src.caps[j])
    j = j + 1
  end
end

def merge_frames(arms: &Vec[ResFrame]) -> ResFrame
  mut out = res_frame_new()
  mut union = Vec::new()
  mut a = 0
  while a < arms.len() do
    let arm = &arms[a]
    mut i = 0
    while i < arm.names.len() do
      if !union.contains(&arm.names[i]) then
        union.push(arm.names[i])
      end
      i = i + 1
    end
    a = a + 1
  end
  mut i = 0
  while i < union.len() do
    let id = union[i]
    let first = res_frame_get(&arms[0], &id)
    match first
    when Option::Some(s0) then
      mut same = true
      mut a = 1
      while a < arms.len() do
        match res_frame_get(&arms[a], &id)
        when Option::Some(sx) then
          if !(s0 == sx) then same = false end
        when Option::None then same = false
        end
        a = a + 1
      end
      if same then
        res_frame_set(&mut out, id, s0)
      else
        res_frame_set(&mut out, id, ResourceState::MaybeLive)
      end
      res_frame_set_span(&mut out, &id, frame_span_any(arms, &id))
      if frame_caps_any(arms, &id) then
        out.caps.push(id)
      end
    when Option::None then
      mut absent_all = true
      mut a = 1
      while a < arms.len() do
        match res_frame_get(&arms[a], &id)
        when Option::Some(_) then absent_all = false
        when Option::None then ()
        end
        a = a + 1
      end
      if !absent_all then
        res_frame_set(&mut out, id, ResourceState::MaybeLive)
        res_frame_set_span(&mut out, &id, frame_span_any(arms, &id))
        if frame_caps_any(arms, &id) then
          out.caps.push(id)
        end
      end
    end
    i = i + 1
  end
  out
end

def frame_caps_any(arms: &Vec[ResFrame], id: &Int) -> Bool
  mut a = 0
  while a < arms.len() do
    let arm = &arms[a]
    if arm.caps.contains(id) then
      return true
    end
    a = a + 1
  end
  false
end

def frame_span_any(arms: &Vec[ResFrame], id: &Int) -> Span
  mut a = 0
  while a < arms.len() do
    let arm = &arms[a]
    match arm.spans.get(id)
    when Option::Some(s) then return s
    when Option::None then ()
    end
    a = a + 1
  end
  Span { file: String::new(), start: 0, end_pos: 0 }
end

def bind_closure_params(typed: &TypedProgram, params: &Vec[ClosureParam], frame: &mut ResFrame, floor: Int) -> Vec[Int]
  mut out = Vec::new()
  mut i = 0
  while i < params.len() do
    match bind_closure_param(typed, &params[i], frame, floor)
    when Option::Some(id) then out.push(id)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

def bind_closure_param(typed: &TypedProgram, cp: &ClosureParam, frame: &mut ResFrame, floor: Int) -> Option[Int]
  match cp.pat.kind
  when PatternKind::Ident(name, _) then
    match binding_lid(typed, frame, &name, floor)
    when Option::Some(id) then
      match typed.local_bindings.get(id)
      when Option::Some(lb) then
        if type_kind_contains_resource(&typed.type_kinds, &lb.ty) then
          res_frame_set(frame, id, ResourceState::Live)
          res_frame_set_span(frame, &id, cp.span)
        end
        if type_kind_contains_capability(&typed.type_kinds, &lb.ty) then
          res_frame_mark_cap(frame, &id)
        end
        Option::Some(id)
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def expr_root_id(typed: &TypedProgram, expr: &Expr) -> Option[Int]
  match expr.kind
  when ExprKind::ExprIdent(_) then
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then Option::Some(l)
    when Option::None then Option::None
    end
  when ExprKind::ExprFieldAccess(base, _) then expr_root_id(typed, &base)
  when ExprKind::ExprIndex(base, _) then expr_root_id(typed, &base)
  when ExprKind::ExprRawDeref(inner) then expr_root_id(typed, &inner)
  when ExprKind::ExprAccess(inner) then expr_root_id(typed, &inner)
  when ExprKind::ExprCast(inner, _) then expr_root_id(typed, &inner)
  when _ then Option::None
  end
end

def expr_is_plain(expr: &Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprAccess(inner) then expr_is_plain(&inner)
  when ExprKind::ExprCast(inner, _) then expr_is_plain(&inner)
  when _ then false
  end
end

def expr_type_has_resource(typed: &TypedProgram, expr: &Expr) -> Bool
  match typed.expr_types.get(expr.node_id)
  when Option::Some(t) then type_kind_contains_resource(&typed.type_kinds, t)
  when Option::None then false
  end
end

def transfer_consume(typed: &TypedProgram, expr: &Expr, loop_outer: &Vec[Int], frame: &mut ResFrame, errors: &mut Vec[ResourceError]) -> Unit
  if expr_type_has_resource(typed, expr) then
    match expr_root_id(typed, expr)
    when Option::Some(id) then
      if res_frame_has(frame, &id) then
        apply_consume(typed, id, expr.span, loop_outer, frame, errors)
      end
    when Option::None then ()
    end
  end
end

def callee_name(expr: &Expr) -> Option[String]
  match expr.kind
  when ExprKind::ExprIdent(n) then Option::Some(n.clone())
  when ExprKind::ExprPath(p) then
    if p.segments.len() > 0 then
      Option::Some(p.segments[p.segments.len() - 1].clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

def find_function(program: &Program, name: &String) -> Option[Vec[Param]]
  find_function_in_items(&program.items, name)
end

def find_function_in_items(items: &Vec[Item], name: &String) -> Option[Vec[Param]]
  mut i = 0
  while i < items.len() do
    match items[i].kind
    when ItemKind::ItemFunction(f) then
      if f.name == name then
        return Option::Some(f.params.clone())
      end
    when ItemKind::ItemExternBlock(ext) then
      mut j = 0
      while j < ext.items.len() do
        match ext.items[j]
        when ExternItem::Function(ef) then
          if ef.name == name then
            return Option::Some(ef.params.clone())
          end
        when ExternItem::Static(_) then ()
        end
        j = j + 1
      end
    when ItemKind::ItemModule(m) then
      match find_function_in_items(&m.items, name)
      when Option::Some(ps) then return Option::Some(ps)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  Option::None
end

def find_method(program: &Program, name: &String) -> Option[Vec[Param]]
  find_method_in_items(&program.items, name)
end

def find_method_in_items(items: &Vec[Item], name: &String) -> Option[Vec[Param]]
  mut i = 0
  while i < items.len() do
    match items[i].kind
    when ItemKind::ItemImpl(im) then
      mut j = 0
      while j < im.methods.len() do
        if im.methods[j].name == name then
          return Option::Some(im.methods[j].params.clone())
        end
        j = j + 1
      end
    when ItemKind::ItemStruct(s) then
      mut j = 0
      while j < s.methods.len() do
        if s.methods[j].name == name then
          return Option::Some(s.methods[j].params.clone())
        end
        j = j + 1
      end
    when ItemKind::ItemModule(m) then
      match find_method_in_items(&m.items, name)
      when Option::Some(ps) then return Option::Some(ps)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  Option::None
end

def convention_effect(c: AccessConvention) -> AccessEffect
  match c
  when AccessConvention::Let then AccessEffect::Read
  when AccessConvention::Inout then AccessEffect::Modify
  when AccessConvention::Sink then AccessEffect::Consume
  when AccessConvention::Set then AccessEffect::Initialize
  end
end
