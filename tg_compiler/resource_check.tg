use std::core::{Option}
use std::collections::{Vec, Map, Set}
use tg_compiler::token::{Span, parsed_int_to_host}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody, TraitMethod, ExternItem,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind, Param,
  AccessConvention, GuardElse, MatchExpr, IfStmt, ForStmt, ClosureParam
}
use tg_compiler::types::{Type, TypeKind, ParamType, AccessEffect, TypedProgram, TypeId, TypeEnv, type_properties_of, TypeDef, TypeDefKind, FieldInfo, VariantInfo, LangItems, ImplInfo, TraitRefTemplate, fn_owner_key, fn_owner_key_of_item, is_trivially_copyable, is_slice_view_type_of, is_shared_view_type_of, finalizer_kind_of_callable, FunctionCleanupTable, FunctionCleanup, ScopeId, DeferId, AssignExactDrop, function_cleanup_table_new, crate_module_path_of, def_id_kind_of, ProjectionKey, ProjectionChain, projection_chain_of, projection_key_eq, place_move_path_of, TypedExprKind, chain_contains_key, effect_handler_synth_key}
use tg_compiler::resolver::{module_path_of_item_resolver, def_kind_of, ResolvedNames}
use tg_compiler::access_check::{AccessError}
use tg_compiler::ids::{DefId, DefKind, LocalId, TraitId, FinalizerKind, generic_param_table_new, NodeId, AccessId, CfgEdgeId, CallableId, FieldId}

enum ResourceState
  Uninitialized
  Live
  Consumed
  MaybeLive
end

struct ResourceError
  message: String
  span: Span
end

# Availability states: whether a local currently holds a valid value.
# Access permission / origin of a resource local: the convention that
# granted it. `let` params are read-only (never consume, never finalize by
# the callee); `inout` params may be modified but never consumed/escaped and
# are caller-owned; `sink` params own their value (may be consumed, must be
# finalized by the callee if still live); `set` params are initialized by the
# callee; owned locals have normal ownership.
enum ParamOrigin
  Let
  Inout
  Sink
  Set
  OwnedLocal
  # The `self` of a deinit finalizer: compiler-owned (the wrapper finalizes
  # the subject and its fields exactly once) — the user hook must not
  # independently consume or re-finalize it.
  DeinitSelf
end

# One logical local = ONE record. Availability, permission origin,
# capability flag, and span live in a single map entry, so removing a local
# (forget/exit_scope/frame_assign) removes the whole record — no parallel
# collection can be left with stale spans/origins/caps for a forgotten id.
struct LocalState
  availability: ResourceState
  origin: ParamOrigin
  is_capability: Bool
  span: Span
end

# The assignment-target transition computed WITHOUT mutating the frame.
# prior is the target's state captured BEFORE any transition; next is the
# state the store commits; drops_old says whether the old owning value must
# be destroyed before the store (the MIR's assign-drop chain). The drop
# decision MUST come from the prior state: the destination's availability at
# the moment of the store decides whether a drop-before-store is owed, and
# the frame is never mutated during that decision (a target transitioned
# during validation would make the surrounding logic drop-before-store for
# storage that was never initialized — deinitializing uninitialized memory).
# Origin/span/capability are immutable per local, so prior/next carry only
# the availability.
struct AssignmentTransition
  lid: tg_compiler::ids::LocalId
  prior: ResourceState
  next: ResourceState
  drops_old: Bool
end

struct ResFrame
  # Strong IDs: the frame is keyed by the SEMANTIC LOCAL identity
  # (ids.tg's LocalId — the type checker's local-binding ids), NOT by a
  # naked Int, so a pattern node id or a MIR local slot cannot index the
  # frame by accident. The semantic ids still cross into the frame at the
  # bind_* boundaries as tg_compiler::ids::LocalId { id: <int> }.
  locals: Map[tg_compiler::ids::LocalId, LocalState]
  # (partial moves — the frame's per-field lattice): root semantic local ->
  # per SEMANTIC projection chain (Vec[ProjectionKey] — the FieldId/
  # VariantId/TupleIndex identities, NEVER string-shaped paths) -> the
  # chain's move state. A chain recorded Consumed was moved out
  # (extracted) while the root stays Live — the root's drop glue excludes
  # it (the registry's partial-drop conditioning) and the chain's storage
  # is dead (a store re-lives it). A chain recorded MaybeLive was consumed
  # on one path only (a control-flow join) — rejected at the scope
  # boundaries (the cleanup cannot be conditional). An absent chain is
  # Live (the field holds its value) — the lattice records only the
  # deviations. The root's OWN availability stays in `locals`.
  place_moves: Map[tg_compiler::ids::LocalId, Map[ProjectionChain, ResourceState]]
end

# The ONE TypedCFG: build_typed_cfg pre-builds every CfgBlock record
# (lexical blocks, expression splits, loop bodies — one record per lexical
# block, id = the block's first statement node id; the if/match/while/
# for/loop joins and the ExprIf expression-split records get their ids
# from the guaranteed-disjoint synthetic allocator cfg_synthetic_alloc —
# the negative domain, never reused, disjoint from the statement ids by
# construction). The resource state
# computation walks those pre-built records (run_cfg_block executes a
# block's statements against its entry frame and records the (entry, exit)
# frame pair under the block record's id — the join frames under the
# record's allocated synthetic id, read back through cfg_join_record_id),
# the loop-body walk moves INTO
# that same traversal (its blocks get recorded exit frames through the
# identical machinery), and the access checker walks the same
# statements/records. Terminator classification is the single
# stmt_is_terminator predicate — there is exactly one flow model, and both
# analyses share it.

# ONE cleanup step of an edge's obligation, in execution order:
#   - Drop(lid)     drop the local (the semantic LocalId; reverse drop order)
#   - RunDefer(nid) run the registered defer (the StmtDefer's NodeId; LIFO —
#                   innermost scope first, within a scope reverse
#                   registration order)
#   - EndAccess(aid) end an access the edge's transfer performed (the access
#                   checker's AccessId — the shared ACCESS_REGISTRY
#                   accumulator). Emitted by the access checker's CFG walk
#                   and appended FIRST to the edge's cleanup (borrows end
#                   before any deferred code runs or memory is freed).
pub enum CleanupAction
  Drop(tg_compiler::ids::LocalId)
  RunDefer(tg_compiler::ids::NodeId)
  EndAccess(tg_compiler::ids::AccessId)
end

# The REAL control-flow edge model of the resource checker. One edge
# per control-flow transfer the checker analyzes, so the cleanup a transfer
# requires is unambiguously attached to that transfer:
#   - Normal      the lexical block's fallthrough
#   - True/False  the if-split branches (cond -> then / false continuation)
#   - Break       a break terminator
#   - Continue    a continue terminator
#   - Return      a return terminator
#   - Backedge    the loop body -> header backedge
#   - GuardElse   a guard's else exit
# Convention: source is the semantic node id of the transfer's originator
# (stmt/cond/loop-stmt node id, or the block's first-statement id for the
# fallthrough). destination is the static target when one exists: the next
# flow segment / branch block key / the innermost enclosing loop's body
# block key (loop-context identity of Break/Continue/Backedge edges), and 0
# when the target is dynamic (function exit, merge, absent branch).
pub enum CfgEdgeKind
  Normal
  True
  False
  Break
  Continue
  Return
  Backedge
  GuardElse
end

pub struct CfgEdge
  kind: CfgEdgeKind
  source: Int
  destination: Int
 # the cleanup obligation attached to THIS edge as an ACTION
  # SEQUENCE in execution order — RunDefer actions (the exited scopes'
  # defers, LIFO — innermost scope first, within a scope reverse
  # registration order), then Drop actions (the live Sink/OwnedLocal locals
  # of the exit the edge exits, in reverse drop order). EndAccess actions
  # (the accesses the edge's transfer performed) are prepended at the
  # recording sites from the shared access registry. The string-key
  # serializations ("return::<id>"/"break::<id>"/"continue::<id>"/
  # "backedge::<id>"/"block::<id>" and the "edge::..." edge_cleanup map)
# are not part of the model: the MIR consumes the CleanupEdge records derived from
  # these actions. True/False branch edges carry no obligation of their own
  # (their cleanups serialize through the branch blocks' own Normal edges);
  # their actions stay empty.
 # the drop-local actions are GROUNDED on the source block's
  # EXIT frame — the locals live at the exit the edge exits, per the edge
  # kind's scope-exit frontier. The block-grounded derivation
  # (block_grounded_drop_ids) is THE AUTHORITY
  # for what an edge drops; the statement-level recording sites
  # (record_block_exit_plan / record_exit_edge_plan) produce the same sets
  # and validate_cfg_edges checks the recorded actions against the block
  # frames.
 # the block frames are the PRIMARY computation (the per-block
  # execution — run_cfg_block — captures (entry, exit) per block);
  # the recording sites READ them: record_block_exit_plan derives the Normal
  # edge's drops from the recorded frames (block_frames_get), the terminator
  # recording sites derive through block_grounded_drop_ids from the exit
  # frame (the terminator-point frame IS the block exit frame), and
  # verify_terminator_edge_grounding reconciles the recorded obligations
  # against the recorded (entry, exit) — a divergence is an internal error.
  actions: Vec[CleanupAction]
end

# / the CFG BLOCK model — the flow-analysis authority behind
# the edge list. One CfgBlock record per block the checker's CFG
# distinguishes:
#   id     — the block's DISJOINT identity, guaranteed unique across the
#            WHOLE CFG by construction:
#            - LEXICAL blocks (the flow blocks, loop-body blocks, defer-
#              body blocks) keep the first-statement semantic node id.
#              Statement node ids are positive (ast.tg's assign_item_ids
#              mints them from 1), so the lexical keys are positive and
#              globally unique.
#            - SYNTHETIC blocks (the if/match/while/for/loop JOIN records
#              and the ExprIf expression-split records) are allocated the
#              NEXT id from the guaranteed-disjoint synthetic counter
#              (cfg_synthetic_alloc — one program-wide counter per
#              build_typed_cfg run, starting at -1 and descending, never
#              reused). The synthetic domain is negative, the statement-id
#              domain positive — the disjointness holds BY CONSTRUCTION,
#              with no numeric convention to audit: the P0 collision class
#              (`for x in xs ... end; after()` — the lexical block key and
#              the for-loop's continuation id both deriving from the for
#              statement) cannot exist.
#   origin — the construct's ORIGIN node id for the synthetic records (the
#            if's condition / the match's scrutinee / the for or loop
#            statement / the ExprIf's condition) — the semantic handle the
#            state walk uses to READ the join's allocated id from the
#            pre-built record (cfg_join_record_id — the state walk never
#            allocates block ids, so the recorded block_frames keys always
#            equal the structural records' ids). 0 for lexical records.
#   edges  — the CfgEdge LIST INDICES of the transfers that originate in
#            this block (attach_block_cfg_record attaches by source node id
#            membership: the block's statement ids plus its if/elsif
#            condition ids — the sources of its Normal/terminator/True/False/
#            GuardElse/Backedge edges); for the JOIN records the edges are
#            the INCOMING transfers (the branch fallthroughs / the loop's
#            exit edge).
# (the gaps CLOSED): every control-flow decision produces a CfgBlock
# record:
#   - Expression-level if-splits (ExprIf) get their own expression-split
#     block records (synthetic id, origin = the condition's node id,
#     referencing the True/False split edges) — previously recorded in the
#     edge list but attributed to no block record;
#   - Loop-body-originated edges (return/break/continue/backedge) are
#     attributed to the loop BODY's flow-block records — the body is now
#     walked with flow machinery by the structural CFG pass (the
#     build_typed_cfg walk), so the body's blocks are distinguished exactly
#     like any other lexical block's.
#   - Statement-level ifs get their IF-JOIN block record (synthetic id,
#     origin = the condition's node id): the continuation block the branch
#     exits merge into. The branch blocks' Normal (fallthrough) edges
#     target the join, and the no-else path's trailing False edge targets
#     it directly; the state walk records the merged branch exits as the
#     join block's (entry, exit) frames.
#   - Matches get their MATCH-JOIN block record (synthetic id, origin =
#     the scrutinee's node id): the continuation block the arm exits merge
#     into; the arm blocks' Normal (fallthrough) edges target it; the
#     state walk records the merged arm exits as the join's (entry, exit)
#     frames.
#   - Loops get their LOOP-JOIN block records (synthetic id, origin = the
#     while's cond node id / the cond-less loop's statement node id — the
#     loop's continuation): the while's False (exit) edge targets the
#     join; the state walk records the loop's after-frame (the fixed
#     point) as the join's (entry, exit) frames.
# The CFG is built BEFORE the resource state runs (build_typed_cfg, the
# structural pass); the state computation (run_cfg_block and the check_*
# recording sites) walks the pre-built blocks and attaches the cleanup
# actions to the pre-built edges. validate_cfg_blocks verifies the block-id
# universe at the end of every run: the UNIQUENESS INVARIANT (the number of
# CfgBlock records == the number of unique CfgBlock ids), the allocator's
# domain discipline, and the edge destinations.
pub struct CfgBlock
  id: Int
  origin: Int
  edges: Vec[Int]
end

# ———————————————————————————————————————————————————————————————
# THE SYNTHETIC BLOCK-ID TEST TABLE — the reviewer's P0 collision list,
# each scenario as a canary_pos test (tests/canary/) whose frames/cleanup
# must stay correct under the guaranteed-disjoint allocator, plus the
# uniqueness invariant's own assertion:
#   (a) canary_pos_cfg_for_first_stmt — `for x in xs ... end; after()`:
#       the for-join's synthetic (negative) id and the lexical block key
#       (the for stmt's positive node id) are DISTINCT — the P0 collision
#       class — so the lexical (entry, exit) frames and the for-join
#       (after, after) frames are two separate block_frames entries, and
#       after()'s own drops are unaffected by the loop's continuation
#       record.
#   (b) canary_pos_cfg_loop_first_stmt — `loop { ... break } after()`:
#       the cond-less loop-join's synthetic id vs the lexical block key —
#       the same by-construction disjointness as (a).
#   (c) canary_pos_cfg_nested_loops — a for inside a for: each loop's
#       join allocates its own synthetic id (never reused), the inner
#       backedge targets the inner body key, the outer backedge the outer
#       body key; the per-iteration cleanup finalizes each body's own
#       locals exactly once per iteration.
#   (d) canary_pos_cfg_loop_in_match — a loop inside a match arm: the
#       match-join and the loop-join both carry synthetic ids; the arm
#       fallthroughs target the match-join, the loop's break/backedge
#       edges target the loop's own body — the merges stay distinct.
#   (e) canary_pos_cfg_loop_after_partial_move — a resource field moved
#       out (the per-field lattice chain Consumed), then a loop: the
#       consumed chain stays dead across the loop's fixed point — the
#       backedge never finalizes the moved-out field, and the scope-exit
#       drop mask excludes it.
#   (f) canary_pos_cfg_break_continue_defer — break/continue edges with
#       defers registered in the loop body scope: the edges run the
#       body-scope defers (LIFO) and the loop-created drops, and NEVER
#       the loop-persistent locals (the loop-entry exclude).
#   (g) canary_pos_cfg_return_from_loop — a return inside the loop body:
#       the Return edge's cleanup covers every scope (the whole defer
#       chain), and the loop-join's (after, after) frame is the fixed
#       point — the loop's exit state.
#   (h) canary_pos_cfg_loop_body_owned_locals — `loop { let p =
#       Probe{} }`: the loop-body-owned local is finalized exactly once
#       per iteration by the backedge cleanup (check_loop_created's
#       is_loop_created filter), and forgotten before the next iteration.
# Each test compiles and runs structurally through the canary harness with
# the frames/cleanup assertions above. THE UNIQUENESS INVARIANT'S OWN
# ASSERTION is validate_cfg_blocks — LIVE on every resource_check run:
# the number of CfgBlock records == the number of unique CfgBlock ids
# (the duplicate detection), plus the allocator's domain discipline (the
# synthetic ids negative, the statement ids positive, disjoint by
# construction) and the edge-destination resolution. (The tests/canary
# files + MANIFEST/harness counts are out of the single-file edit scope of
# this change; the table fixes the contract each canary must assert.)
# ———————————————————————————————————————————————————————————————

# the CleanupEdge — the semantic cleanup record of ONE real CFG edge.
# The MIR's edge-driven cleanup emission consumes THIS table (keyed by the
# edge's CfgEdgeId, the edge's index in the TypedCFG edge list) instead of
# the String-keyed serializations. actions is the edge's full
# obligation in execution order: EndAccess actions (the accesses the edge's
# transfer performed, reverse registration order — borrows end before any
# deferred code runs or memory is freed), then RunDefer actions (the exited
# scopes' defers, LIFO), then Drop actions (the live owning locals, reverse
# drop order).
pub struct CleanupEdge
  edge: CfgEdgeId
  actions: Vec[CleanupAction]
end

# / the TYPED CFG — the ONE complete control-flow graph both
# analyses (the resource checker and the access checker) consume. Built by
# build_typed_cfg BEFORE the resource state runs; the state computation
# walks the blocks; the access checker walks the same blocks/edges and
# registers its accesses on them (the shared ACCESS_REGISTRY).
#   edges   — every CFG transfer of the program; a CfgEdge's index IS its
#             CfgEdgeId;
#   blocks  — every CfgBlock record (flow blocks, expression-split blocks,
#             loop-body blocks);
#   cleanup — one CleanupEdge per edge (parallel to `edges`; cleanup[i] is
#             edge i's CleanupEdge), serialized by the resource checker at
#             the end of a run from the edges' actions.
pub struct TypedCFG
  edges: Vec[CfgEdge]
  blocks: Vec[CfgBlock]
  cleanup: Vec[CleanupEdge]
end

# CLEANUP-EDGE ARCHITECTURE: the finalize_plan edge string keys
# ("block::<id>", "return::<id>", "break::<id>", "continue::<id>",
# "backedge::<id>") and the "edge::..." edge_cleanup map are not part of
# the model. The destination is a single semantic CleanupEdge { edge:
# CfgEdgeId, actions: Vec[CleanupAction] } attached to each real CFG edge of
# the ONE TypedCFG, so an edge can never accidentally reuse another edge's
# plan (the loop-exit double-clean and the nested block::/edge:: double-drop
# were exactly this class of bug). MIR merely materializes the resolved edge
# cleanup.
# The CFG is the analysis authority, not an additive
# record. CfgBlock records the blocks the CFG distinguishes (flow blocks,
# expression-split blocks, loop-body blocks), each referencing its
# originating CfgEdge indices; each CfgEdge carries its cleanup obligation
# as an action sequence (CleanupAction: Drop/RunDefer/EndAccess) from which
# the CleanupEdge records are serialized; and validate_cfg_edges checks
# every edge's actions reference valid locals/defer ids/access ids and every
# block's edges are consistent with their kinds (Return edges are terminal,
# Normal edges are fallthroughs, Backedges originate in a loop body).
# The CFG is built BEFORE the resource state runs (build_typed_cfg,
# the structural pass over the whole program); the state computation walks
# the blocks and attaches the cleanup actions to the pre-built edges.
# Result of resource checking: the diagnostics plus the authoritative
# per-function finalize plan (fn owner key -> local ids that must be
# finalized at function end because they are live with Sink/OwnedLocal
# permission). MIR consumes finalize_plan for cleanup emission instead of
# re-deriving ownership from declared locals.
struct ResourceCheckResult
  errors: Vec[ResourceError]
  finalize_plan: FunctionCleanupTable
 # / the ONE complete Typed CFG of the program — every
  # control-flow decision's CfgEdge/CfgBlock records (built by
  # build_typed_cfg before the state computation) plus the parallel
  # CleanupEdge table (cleanup[i] = edge i's CleanupEdge, serialized at the
  # end of the run from the edges' actions). The MIR consumes THIS table at
  # every cleanup-lookup site — the String-keyed serializations are is not part of the model.
  cfg: TypedCFG
 # the TYPED iteration plans, keyed by the for-statement's node id
  # (the same node id the MIR's loop_id uses). Produced in check_for;
  # consumed by the MIR (lower_for) for the projected-vs-consuming decision
  # — see IterationPlan below.
  iteration_plans: Map[Int, IterationPlan]
 # (phase 2): the TYPED iteration records (TypedIteration { plan })
  # — the typed-HIR serialization of the plans above, produced at the same
  # check_for site; consumed by the MIR (lower_for / typed_iteration_of)
  # through the typed statement record's join key (TypedStmtKind::
  # For.iteration = the for-stmt node id).
  typed_iterations: Map[Int, TypedIteration]
 # the authoritative per-flow-block frame states — (entry, exit)
  # per CfgBlock id (the lexical records' first-statement semantic node id
  # — the same id attach_block_cfg_record gives the CfgBlock record; the
  # synthetic join/split records' ALLOCATED negative id — the id the
  # structural pass allocated and the state walk read back through
  # cfg_join_record_id, so every frame key equals a CfgBlock record's id
  # and the uniqueness invariant (validate_cfg_blocks) guards the whole
  # key domain). Entry is
  # the frame entering the block — at a join, the merged predecessor-exit
  # frames; exit is the frame after the block's statements — the
  # scope-exit frontier the block's originating edges' obligations derive
  # from. Populated by run_cfg_block at the block transitions;
  # self-contained per run (reset/snapshot, the iteration_plans
  # convention).
 # the block frames are the GROUNDING of the edge model's drop
  # obligations: the drop-local actions of a block-originating edge derive
  # from its SOURCE block's exit frame (the locals live at the exit the
  # edge exits, per the edge kind's scope-exit frontier — Normal exits the
  # block's own scope, Return exits every scope, Break/Continue exit the
  # loop's scope with the loop-entry exclude). The block-grounded
  # derivation (block_grounded_drop_ids) is THE AUTHORITY; the statement-
  # level recording produces the same sets and remains the byte-identical
  # emission path, and validate_cfg_edges checks every block-originating
  # edge's drop actions against these frames (a drop of a local not live at
  # the source block's exit is an inconsistency).
 # the block frames are the PRIMARY computation of the flow
  # analysis (run_cfg_block's per-block execution under the block
  # fixed-point worklist). The recording sites READ them — the Normal
  # edge's derivation looks the recorded frames up (record_block_exit_plan
  # / block_frames_get), the terminator recording sites derive through the
  # same block_grounded_drop_ids from the exit frame (the terminator-point
  # frame IS the block exit frame), and verify_terminator_edge_grounding
  # reconciles every block-originating Return/Break/Continue edge against
  # these recorded frames.
  block_frames: Map[Int, (ResFrame, ResFrame)]
end

# the typed iteration plan for a for-statement, produced by check_for.
# The resource checker is the semantic authority for the projected
# (zero-copy, by-reference) iteration decision that the MIR used to re-derive
# from the loop body with its own name-use scan. The checker resolves the
# iterable's kind and element type, collects the pattern's binding ids, and
# applies the projected-safety predicate ported from the MIR (see the
# plan_* functions below) — the semantic decision belongs HERE, before MIR;
# the MIR consumes the plan keyed by the for-stmt node id and keeps its own
# heuristic only as the documented fallback for IR-only loops that never
# passed through the checker.
# Fields:
#   source_kind  — the iterable's projected-iteration class:
#                  0 = array/vec/slice, 1 = map, 2 = set, 3 = range.
#   access       — AccessEffect::Read: projected iteration — the binding is
#                  bound by REFERENCE into the iterated collection. The
#                  checker's projected-iteration guard
#                  (check_iter_binding_escape) is the authority that the
#                  binding cannot be moved out of the loop body, and the
#                  projected-mutation rule (check_loop_body's
#                  plan_stmt_mutates_place scan) rejects mutation of the
#                  iterated collection inside the body, so the MIR needs no
#                  name-use scan of its own for this decision.
#                  AccessEffect::Consume: snapshot iteration — each element
#                  is copied/moved into the binding (sound only for Copy
#                  element types, or for materialized-snapshot iterables).
#   element_type — the per-iteration binding type (the iterable's element
#                  type; Int for ranges).
#   binding_ids  — the semantic local ids bound by the for pattern, in
#                  pattern order — exactly the ids check_iter_binding_escape
#                  tracks, so the MIR can map the iteration binding(s) (e.g.
#                  for per-iteration cleanup once consuming iteration lands;
# the comment in check_for documents that prerequisite).
#   iter_root_id — the semantic local id of the iterated collection's ROOT
#                  place (the collection whose storage the projected access
#                  reads), or -1 when the iterable is not a rootable place
#                  (ranges, method-call results, unresolved). The projected-
#                  mutation rule in check_loop_body uses it (with the
#                  iterable's field chain) to reject mutation of the
#                  iterated collection inside the loop body; snapshot-based
#                  iteration (Map/Set, or a materialized entries array) is
#                  not affected by the rule.
struct IterationPlan
  source_kind: Int
  access: AccessEffect
  element_type: Type
  binding_ids: Vec[Int]
  iter_root_id: Int
end

# (, phase 2): the TYPED iteration record — the
# typed-HIR serialization of the iteration plan. The typed statement
# record for a for-statement (TypedStmtKind::For.iteration, types.tg)
# carries the for-stmt node id, and the MIR joins it with this record
# (mir.tg lower_program / typed_iteration_of — the same channel that
# carries the finalize plan and the CleanupEdge table). Produced at
# check_for (record_typed_iteration, the same site as the plan itself);
# the MIR consumes the TYPED record and never re-derives the plan from
# the AST. (The record lives here — beside its plan — because the
# one-way module graph (resource_check imports types) forbids types.tg
# from referencing the checker's IterationPlan.)
struct TypedIteration
  plan: IterationPlan
end

# ———————————————————————————————————————————————————————————————
# (AnalysisContext): the PER-COMPILATION analysis state — the
# checker-scoped accumulators and the shared access registry — owned by ONE
# compilation and threaded through the pipeline (analyze_parsed creates it,
# access_check and resource_check consume it, the AnalyzedProgram carries
# it). NO process-global semantic state: the former module-level mut
# accumulators (ITERATION_PLANS / TYPED_ITERATIONS / BLOCK_FRAMES /
# SLICE_VIEWS / ACCESS_REGISTRY / ACCESS_COUNTER) are fields here, so a
# long-lived compiler process (LSP, parallel compilations) never shares a
# program's analysis state and no reset protocol exists — a context is
# fresh per compilation and dies with it.
# Fields:
#   iteration_plans — for-stmt node id -> IterationPlan (check_for's
#                     projected-vs-consuming decision; consumed by the MIR
#                     through the artifact).
#   typed_iterations — for-stmt node id -> TypedIteration (the typed-HIR
#                     serialization of the plans, consumed by the MIR's
#                     lower_for).
#   block_frames   — CfgBlock id -> (entry, exit) ResFrame pair (the
#                     PRIMARY computation of the flow analysis; the
#                     recording sites read them through block_frames_get).
#                     The keys are the CfgBlock records' ids — the lexical
#                     first-statement ids (positive) and the synthetic
#                     join/split ids (negative, allocated by the
#                     structural pass's cfg_synthetic_alloc and read back
#                     by the state walk through cfg_join_record_id — the
#                     state walk never allocates block ids). The
#                     uniqueness invariant (validate_cfg_blocks) guards
#                     the domain.
#   slice_views    — view local id -> SliceViewInfo (the live RAW-view
#                     registry, mutation-while-live authority — the
#                     shared/pinned forms are never registered).
# access_registry — CfgEdgeId (the edge's index in the ONE
#                     TypedCFG edge list) -> the AccessIds the access
#                     checker opened on THAT edge, in registration order.
#                     The source node id is diagnostic metadata only — an
#                     access is registered on the exact set of successor
#                     edges of its site (a condition node's True/False
#                     splits both carry the condition's accesses).
#   access_counter — the fresh-AccessId counter of the run.
struct AnalysisContext
  iteration_plans: Map[Int, IterationPlan]
  typed_iterations: Map[Int, TypedIteration]
  block_frames: Map[Int, (ResFrame, ResFrame)]
  slice_views: Map[Int, SliceViewInfo]
  access_registry: Map[Int, Vec[AccessId]]
  access_counter: Int
end

# one fresh context per compilation — the pipeline (analyze_parsed,
# the driver's LSP diagnostic path) calls this once and threads the same
# context through access_check and resource_check; the AnalyzedProgram
# carries the finished context (immutable from then on).
pub def analysis_context_new() -> AnalysisContext
  AnalysisContext {
    iteration_plans: Map::new(),
    typed_iterations: Map::new(),
    block_frames: Map::new(),
    slice_views: Map::new(),
    access_registry: Map::new(),
    access_counter: 0
  }
end

# ———————————————————————————————————————————————————————————————
# (AnalyzedProgram): the ONE immutable analysis artifact of a
# compilation — the single result of analyze_parsed and the ONLY input the
# MIR lowering consumes. It carries the typed HIR (the TypedProgram), the
# ONE TypedCFG (with the CleanupEdge table serialized into cfg.cleanup —
# cleanup_edges_serialize's output), the semantic finalize plan, the whole
# AnalysisContext (the iteration plans, the typed iterations, the block
# frames, the slice-view registry, the CfgEdgeId-keyed access registry),
# the engine snapshot TypeEnv the resource checker ran on, and the two
# checkers' error lists (empty on the Ok path). The MIR's lowering
# (lower_program, mir.tg) consumes THIS artifact — resource_check is never
# re-run during lowering, and no analysis result is recovered by a second
# invocation.
#   ast / resolutions — the program + resolver snapshot mirrors the
#   library API reads off the analyze result (lib.tg / lib_kernel.tg
#   compile/check: typed.ast / typed.resolutions), identical to the
#   TypedProgram's own snapshots.
pub struct AnalyzedProgram
  typed: TypedProgram
  ast: Program
  resolutions: ResolvedNames
  cfg: TypedCFG
  finalize_plan: FunctionCleanupTable
  context: AnalysisContext
  engine_snapshot: TypeEnv
  access_errors: Vec[AccessError]
  resource_errors: Vec[ResourceError]
end

# the checker-side iteration-plan accumulator is AnalysisContext
# state (context.iteration_plans — keyed by for-stmt node id). A context is
# fresh per compilation, so there is NO reset protocol (the former
# module-level mut ITERATION_PLANS and its per-run reset) and a
# long-lived compiler process never sees another program's plans.

def record_iteration_plan(inout ctx: AnalysisContext, for_node_id: Int, plan: IterationPlan) -> Unit
  ctx.iteration_plans.insert(for_node_id, plan)
end

def iteration_plans_snapshot(ctx: AnalysisContext) -> Map[Int, IterationPlan]
  ctx.iteration_plans.clone()
end

# (phase 2): the TYPED iteration records (TypedIteration) live in the
# context with the plans (context.typed_iterations — the ITERATION_PLANS
# convention; no reset protocol).
def record_typed_iteration(inout ctx: AnalysisContext, for_node_id: Int, plan: IterationPlan) -> Unit
  ctx.typed_iterations.insert(for_node_id, TypedIteration { plan: plan })
end

def typed_iterations_snapshot(ctx: AnalysisContext) -> Map[Int, TypedIteration]
  ctx.typed_iterations.clone()
end

# the block-level frame accumulator is AnalysisContext state
# (context.block_frames — the authoritative (entry, exit) per-block states
# of the flow analysis, keyed by CfgBlock id — the lexical first-statement
# ids and the synthetic join/split ids, the exact ids the CfgBlock records
# carry; the ITERATION_PLANS
# convention — no reset protocol).
def record_block_frame(inout ctx: AnalysisContext, block_id: Int, entry: ResFrame, exit: ResFrame) -> Unit
  ctx.block_frames.insert(block_id, (entry, exit))
end

def block_frames_snapshot(ctx: AnalysisContext) -> Map[Int, (ResFrame, ResFrame)]
  ctx.block_frames.clone()
end

# a block's RECORDED (entry, exit) frames — the primary computation
# of the flow analysis (run_cfg_block's record_block_frame). The statement-
# level recording sites READ these frames (record_block_exit_plan's Normal
# derivation) or produce byte-identical sets from the equivalent exit frame
# (record_exit_edge_plan; the post-block reconciliation in run_cfg_block
# verifies the recorded obligations against these recorded frames).
def block_frames_get(ctx: AnalysisContext, block_id: Int) -> Option[(ResFrame, ResFrame)]
  match ctx.block_frames.get(&block_id)
  when Option::Some(pair) then Option::Some(pair)
  when Option::None then Option::None
  end  end  end
end

# ———————————————————————————————————————————————————————————————
# THE RAW-VIEW REGISTRY (the P0-SL rules) — AnalysisContext state
# (context.slice_views — view local id -> backing place; the ITERATION_PLANS
# convention — no reset protocol). The registry polices ONLY the RAW
# {ptr,len} views (the compiler's Slice builtin — source-spelled
# UnsafeSlice): the SAFE shared/pinned forms (Slice/StrView — the
# Arc-class views) are ordinary OWNING values whose backing owns — they
# need NO escape tracking and are never registered here. The raw views
# are unsafe/FFI-only (safe code cannot produce them); the only raw views
# safe code ever sees are the compiler-scoped loop-consumed iterable
# forms and the vec! literal coercion, and the mutation-while-live rule
# below keeps even those from outliving their backing buffer.
struct SliceViewInfo
  backing_root: Int
  backing_fields: Vec[String]
end

def slice_views_snapshot_keys(ctx: AnalysisContext) -> Vec[Int]
  var keys = Vec::new()
  for (k, _) in ctx.slice_views do
    keys.push(k)
  end
  keys
end

def slice_views_register(inout ctx: AnalysisContext, view_id: Int, backing_root: Int, backing_fields: Vec[String]) -> Unit
  ctx.slice_views.insert(view_id, SliceViewInfo { backing_root: backing_root, backing_fields: backing_fields.clone() })
end

def slice_views_lookup(ctx: AnalysisContext, view_id: Int) -> Option[SliceViewInfo]
  match ctx.slice_views.get(view_id)
  when Option::Some(info) then Option::Some(info)
  when Option::None then Option::None
  end  end
end

# drop the view registrations added AFTER the entry snapshot — the
# views whose binding scope just exited. Called at every scope boundary
# that is NOT a lexical check_block exit_scope (loop bodies, defer bodies,
# closure bodies) as well as by check_block itself (the loop-created view
# locals are non-owning, so exit_scope's to_forget never covers them — the
# snapshot protocol is the liveness authority).
def slice_views_remove_after(inout ctx: AnalysisContext, entry_keys: Vec[Int]) -> Unit
  var to_remove = Vec::new()
  for (k, _) in ctx.slice_views do
    if !entry_keys.contains(&k) then
      to_remove.push(k)
    end
  end
  for k in to_remove do
    ctx.slice_views.remove(&k)
  end
end

# (channel d): the backing place of a slice-view value — the
# receiver place of the view-producing call (chars/bytes/split/iter/...)
# or the value itself for a plain place; a view derived from ANOTHER view
# local chains to that local's registered backing (the original owner
# place). Option::None when no place-like root exists (a method-call
# result with no receiver place — no backing to protect).
def slice_view_backing(ctx: AnalysisContext, typed: TypedProgram, value: Expr) -> Option[(Int, Vec[String])]
  let base = match value.kind
  when ExprKind::ExprMethodCall(recv, _, _, _) then recv
  when _ then value
  end
  match expr_root_id(typed, &base)
  when Option::Some(root) then
    match base.kind
    when ExprKind::ExprIdent(_) then
      match slice_views_lookup(ctx, root)
      when Option::Some(info) then Option::Some((info.backing_root, info.backing_fields.clone()))
      when Option::None then
        var chain = Vec::new()
        collect_place_field_chain(typed, &base, &mut chain)
        Option::Some((root, chain))
      end
    when _ then
      var chain = Vec::new()
      collect_place_field_chain(typed, &base, &mut chain)
      Option::Some((root, chain))
    end
  when Option::None then Option::None
  end
end

# (channel d): register a let-bound RAW Slice view local (the value's
# type is the raw view — the Slice builtin / UnsafeSlice — and the
# pattern binds exactly one ident) under its backing place, so the
# mutation-while-live rule can protect the backing while the raw view
# local is live. The SAFE shared/pinned forms (Slice/StrView — the
# Arc-backed views) are explicitly EXCLUDED: the backing owns, so they
# need no escape tracking. Skip registrations without a place-like root
# (a temporary view has no backing to protect).
def register_slice_view_local(inout ctx: AnalysisContext, inout env: TypeEnv, typed: TypedProgram, pattern: Pattern, value: Expr) -> Unit
  match typed.expr_types.get(value.node_id)
  when Option::Some(vt) then
    if !is_shared_view_type_of(env, &vt) && is_slice_view_type_of(env, &vt) then
      var binding_ids = Vec::new()
      collect_pattern_binding_ids(typed, pattern, &mut binding_ids)
      if binding_ids.len() == 1 then
        match slice_view_backing(ctx, typed, value)
        when Option::Some((root, chain)) then
          slice_views_register(ctx, binding_ids[0], root, chain)
        when Option::None then ()
        end
      end
    end
  when Option::None then ()
  end  end
end

# (channel d): the mutation-while-raw-view-live check — every live
# registered RAW view's backing place is scanned against the statement
# with the IterationPlan mutation machinery (plan_stmt_mutates_place —
# the projected-iteration conflict rule); a match means the statement
# mutates/reallocates a buffer a live raw-view local views. The SAFE
# shared/pinned forms are never registered, so mutating their source is
# always allowed (the pinned backing is unaffected). Reported ONCE per
# statement (the first offending view's name).
def check_slice_view_backing_mutation(ctx: AnalysisContext, typed: TypedProgram, stmt: Stmt, inout errors: Vec[ResourceError]) -> Unit
  var reported = false
  for (view_id, info) in ctx.slice_views do
    if !reported then
      if plan_stmt_mutates_place(typed, stmt, info.backing_root, &info.backing_fields) then
        reported = true
        errors.push(ResourceError {
          message: "cannot mutate the backing buffer of `" + binding_name(typed, view_id) + "`: the local holds a live raw Slice view (UnsafeSlice) of that buffer (a raw {ptr,len} view must not outlive its backing — use the shared/pinned form: Vec::as_slice / String::as_str_view)",
          span: stmt.span
        })
      end
    end
  end
end

# (access registry keyed by CfgEdgeId): the shared ACCESS REGISTRY —
# the access checker's per-EDGE access records, keyed by the CFG EDGE'S
# CfgEdgeId (the edge's index in the ONE TypedCFG edge list — the same
# identity CleanupEdge.edge and the resource checker's attach sites use).
# Each entry is the Vec of AccessIds the access checker opened on THAT edge,
# in registration order. The source node id of a site is DIAGNOSTIC
# METADATA ONLY: record_access (access_check.tg) registers every access on
# the EXACT SET of successor edges of its site (successor_edge_ids — all
# edges whose source is the site's node), so a condition node with two
# outgoing CFG edges (True/False splits) carries its accesses on BOTH edges
# and neither edge can leak another's accesses.
# PIPELINE PAIRING: the registry lives in the AnalysisContext — reset per
# compilation by construction (analysis_context_new; the former
# access_registry_reset protocol). access_check populates it
# through the SAME context the resource checker reads
# (attach_edge_actions prepends EndAccess actions per edge; the MIR's
# lowering never re-runs the checkers — the artifact carries the registry).
def access_registry_fresh_id(inout ctx: AnalysisContext) -> AccessId
  let n = ctx.access_counter
  ctx.access_counter = n + 1
  AccessId { id: n }
end

def access_registry_register(inout ctx: AnalysisContext, edge_id: Int, aid: AccessId) -> Unit
  match ctx.access_registry.get(edge_id)
  when Option::Some(existing) then
    var ext = existing.clone()
    ext.push(aid)
    ctx.access_registry.insert(edge_id, ext)
  when Option::None then
    var ids = Vec::new()
    ids.push(aid)
    ctx.access_registry.insert(edge_id, ids)
  end  end
end

# the access ids registered on ONE CFG edge (its CfgEdgeId), in
# registration order (the resource checker prepends them to the edge's
# cleanup as EndAccess actions in REVERSE order — borrows end LIFO).
def access_registry_for_edge(ctx: AnalysisContext, edge_id: Int) -> Vec[AccessId]
  match ctx.access_registry.get(edge_id)
  when Option::Some(ids) then ids.clone()
  when Option::None then Vec::new()
  end  end
end

# is the id a registered access (any edge)? validate_cfg_edges
# checks every EndAccess action against the run's registry.
def access_registry_has(ctx: AnalysisContext, aid: AccessId) -> Bool
  var found = false
  for (_, ids) in ctx.access_registry do
    if !found then
      if ids.contains(aid) then found = true end
    end
  end
  found
end

pub def resource_check(program: Program, typed: TypedProgram, cfg_in: TypedCFG, inout ctx: AnalysisContext, inout env_snapshot: TypeEnv) -> ResourceCheckResult
 # the accumulators (iteration plans, typed iterations, block
  # frames, slice views, the access registry) live in the AnalysisContext —
  # fresh per compilation, so NO reset protocol exists here.
 # (ONE TypedCFG): the CFG arrives from the PIPELINE — the ONE
  # instance built by compiler_core's analyze_parsed (build_typed_cfg is
  # never called here) and already consumed by the access checker. The
  # state computation below (check_item -> check_function -> check_fn_body
  # -> run_cfg_block, the block frames) WALKS THE BLOCKS and attaches the
  # cleanup actions to the pre-built edges; the working copy keeps the
  # pipeline's pristine instance untouched. The access checker consumed the
  # same TypedCFG earlier in the pipeline and populated the shared
  # context.access_registry (keyed by CfgEdgeId — the edge's index in this
  # very edge list), whose EndAccess obligations are prepended at the
  # recording sites.
  var cfg = TypedCFG { edges: cfg_in.edges.clone(), blocks: cfg_in.blocks.clone(), cleanup: Vec::new() }
 # the engine snapshot TypeEnv is built ONCE by the pipeline
  # (compiler_core's analyze_parsed — engine_snapshot_env) and consumed
  # here through env_snapshot; the finished snapshot is carried into the
  # AnalyzedProgram so the MIR's lowering never rebuilds it.
  # Every ownership decision below queries type_properties_of through it.
  mut errors = Vec::new()
  var finalize_plan = function_cleanup_table_new()
 # each top-level item is checked under its OWNER module path — the
  # same Program.modules pointer walk the type checker performs
  # (module_path_of_item_resolver) — so the owner-key fallback of a
  # no-DefId free function is qualified with the item's FULL module path,
  # not the bare root path. The path also feeds the nested-module fallback
  # threading (check_item's module_path param).
  mut i = 0
  while i < program.items.len() do
    let (owner_path, _) = module_path_of_item_resolver(program, i)
    check_item(program, typed, env_snapshot, ctx, &program.items[i], i, &mut errors, &mut finalize_plan, &mut cfg.edges, &mut cfg.blocks, &owner_path)
    i = i + 1
  end
 # / the CFG model must be structurally sound — every edge's
  # actions reference valid locals (typed local bindings), registered
  # defers, and registered accesses; every block's edges are consistent
  # with their kinds; and the drop actions are grounded on the block exit
  # frames (the recorded frames are run-scoped and node ids are globally
  # unique, so the lookup by block id is unambiguous program-wide). Runs
  # ONCE per program over the whole CFG (the per-function edge lists the
  # validation used to receive are gone — the CFG is global now).
  let body_block_frames = block_frames_snapshot(ctx)
  # the block-id UNIQUENESS INVARIANT — the number of CfgBlock records
  # must equal the number of unique CfgBlock ids (the P0 duplicate
  # detection; the allocator keeps the synthetic join domain disjoint
  # from the statement-id domain by construction, and this assertion
  # machine-checks it on every run).
  validate_cfg_blocks(&cfg.blocks, &cfg.edges, &mut errors)
  validate_cfg_edges(ctx, typed, &finalize_plan, &cfg.edges, &cfg.blocks, &body_block_frames, &mut errors)
 # serialize the edges' actions into the parallel CleanupEdge table
  # (cleanup[i] is edge i's CleanupEdge; the edge's index IS its CfgEdgeId).
  let cleanup_edges = cleanup_edges_serialize(&cfg.edges)
  ResourceCheckResult {
    errors: errors,
    finalize_plan: finalize_plan,
    cfg: TypedCFG { edges: cfg.edges, blocks: cfg.blocks, cleanup: cleanup_edges },
    iteration_plans: iteration_plans_snapshot(ctx),
    typed_iterations: typed_iterations_snapshot(ctx),
    block_frames: body_block_frames
  }
end

# ———————————————————————————————————————————————————————————————
# the STRUCTURAL CFG PASS — the ONE complete CFG, built BEFORE
# the resource state runs
# ———————————————————————————————————————————————————————————————
#
# build_typed_cfg walks the same AST the state computation walks (items,
# functions, blocks, statements, expressions) and records EVERY
# control-flow decision as a CfgEdge + CfgBlock record, with NO frame
# state:
#   - every lexical block's flow blocks get CfgBlock records (the
#     the block records, walked by the state computation);
#   - if/elsif conditions get True/False split edges;
#   - STATEMENT-level ifs get their IF-JOIN block record (synthetic id,
#     origin = the condition's node id — allocated by cfg_synthetic_alloc,
#     the disjoint negative domain): the branch blocks' Normal (fallthrough) edges
#     target it (the no-else trailing False edge targets it directly), and
#     the join's CfgBlock record carries those incoming edges — the
#     continuation the state walk records the merged branch exits under;
#   - EXPRESSION-level splits (ExprIf) get their own expression-split
#     CfgBlock records (synthetic id, origin = the condition's node id) — the documented gap
#     CLOSED (previously recorded in the edge list but attributed to no
#     block record);
#   - LOOP BODIES are walked with flow machinery: the body's flow blocks
#     get CfgBlock records and the body-originated edges (return/break/
#     continue) are attributed to them, plus the Backedge edge — the
#     documented gap CLOSED (the body was previously walked without flow
#     machinery, so its edges belonged to no block record);
#   - guards get GuardElse edges;
#   - try-related forms (StmtTry/StmtWith/StmtHandleWith/ExprTry) get
#     their constituent blocks' flow-block records;
#   - terminators get Return/Break/Continue edges;
#   - fallthrough blocks get their Normal edge.
# The CFG is produced with EMPTY edge actions; the state computation
# (resource_check -> check_item -> check_* -> run_cfg_block) WALKS THE
# BLOCKS and attaches the cleanup obligations to the pre-built edges by
# their (kind, source) identity (attach_edge_actions). The access checker
# consumes the SAME TypedCFG (build_typed_cfg is its entry too) and
# registers its accesses on the edges (the shared ACCESS_REGISTRY).

pub def build_typed_cfg(program: Program, typed: TypedProgram) -> TypedCFG
  var edges = Vec::new()
  var blocks = Vec::new()
  # the ONE synthetic block-id counter of this run (cfg_synthetic_alloc).
  # The counter is PROGRAM-WIDE (one per build_typed_cfg call), not
  # per-function: the CfgBlock ids must be unique across the WHOLE CFG —
  # the block_frames map and the uniqueness invariant
  # (validate_cfg_blocks) are program-wide, so a per-function reset would
  # let function A's for-join and function B's for-join share an id.
  mut synth = 0
  mut i = 0
  while i < program.items.len() do
    cfg_item(&program.items[i], &mut edges, &mut blocks, &mut synth)
    i = i + 1
  end
  TypedCFG { edges: edges, blocks: blocks, cleanup: Vec::new() }
end

# the guaranteed-disjoint SYNTHETIC BLOCK-ID ALLOCATOR — the P0 fix.
# Every synthetic block (the if/match/while/for/loop joins and the ExprIf
# expression-split blocks) allocates the NEXT id from the counter: the
# first allocation is -1 and the counter descends, so the synthetic domain
# is negative, never reused, and never touches the positive statement node
# ids the lexical block records keep — the disjointness holds BY
# CONSTRUCTION (no numeric convention to audit, no sign arithmetic on node
# ids). The reviewer's accepted alternative: "allocate synthetic block IDs
# through a guaranteed-disjoint block-ID allocator".
def cfg_synthetic_alloc(inout next_id: Int) -> Int
  next_id = next_id - 1
  next_id
end

# the SYNTHETIC join/split block id of the construct whose ORIGIN node id
# is `origin` — READ from the pre-built CfgBlock record (the structural
# pass allocated the id through cfg_synthetic_alloc; the state walk NEVER
# allocates, so the join frames it records under this id always match the
# record the validation and the invariant see). The origin is the
# construct's own node identity (the if's condition / the match's
# scrutinee / the for or loop statement), globally unique, and each
# construct creates exactly one synthetic record, so the match is
# unambiguous. 0 when no record carries the origin — the defensive miss
# path (the structural pass records every join, so a miss would mean the
# state walk visited a construct the structural pass never saw; the
# callers skip the frame recording silently, the same tolerance the
# block-frame lookups use).
def cfg_join_record_id(blocks: Vec[CfgBlock], origin: Int) -> Int
  mut bi = 0
  while bi < blocks.len() do
    if blocks[bi].origin == origin then
      return blocks[bi].id
    end
    bi = bi + 1
  end
  0
end

# the item-level structural walk — mirrors check_item's dispatch.
# Struct field defaults, enum discriminants, const/static values, and
# macro bodies are expression-level walks with a fresh, item-local defer
# chain (the state walk's item_defer_chain mirror). `synth` is the run's
# synthetic block-id counter (cfg_synthetic_alloc).
def cfg_item(item: Item, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout synth: Int) -> Unit
  var item_chain = Vec::new()
  match item.kind
  when ItemKind::ItemFunction(f) then cfg_function(&f, edges, blocks, synth)
  when ItemKind::ItemStruct(s) then
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then cfg_expr(&e, edges, blocks, &mut item_chain, synth)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      cfg_function(&s.methods[i], edges, blocks, synth)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then cfg_expr(&d, edges, blocks, &mut item_chain, synth)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      cfg_trait_method(&t.methods[i], edges, blocks, synth)
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      cfg_function(&im.methods[i], edges, blocks, synth)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      cfg_item(&m.items[i], edges, blocks, synth)
      i = i + 1
    end
  when ItemKind::ItemUse(_) then ()
  when ItemKind::ItemMacro(mac) then cfg_block(&mac.body, edges, blocks, &mut item_chain, synth)
  when ItemKind::ItemTypeAlias(_) then ()
  when ItemKind::ItemConst(c) then cfg_expr(&c.value, edges, blocks, &mut item_chain, synth)
  when ItemKind::ItemStatic(s) then cfg_expr(&s.value, edges, blocks, &mut item_chain, synth)
  when ItemKind::ItemCapabilityDecl(_) then ()
  when ItemKind::ItemEffectDecl(_) then ()
  when ItemKind::ItemRationaleBlock(_) then ()
  when ItemKind::ItemEditionDecl(_) then ()
  when ItemKind::ItemExternBlock(_) then ()
  end
end

# a function's structural walk — contracts + body (the
# check_function mirror). The function's own defer chain.
def cfg_function(f: FunctionDecl, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout synth: Int) -> Unit
  var chain = Vec::new()
  mut i = 0
  while i < f.contracts.len() do
    cfg_expr(&f.contracts[i].expr, edges, blocks, &mut chain, synth)
    i = i + 1
  end
  cfg_fn_body(&f.body, edges, blocks, &mut chain, synth)
end

def cfg_trait_method(m: TraitMethod, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout synth: Int) -> Unit
  var chain = Vec::new()
  cfg_fn_body(&m.default_body, edges, blocks, &mut chain, synth)
end

# is the statement a top-level CONTROL-FLOW split — the partition points
# of the function body's basic-block lowering? A top-level block is a
# maximal run of linear statements followed by at most one control-flow
# statement (the split's INTERNAL branches remain the statement recursion's
# domain — the top-level graph's edges are the linear continuations).
def stmt_is_control_flow(stmt: Stmt) -> Bool
  match stmt.kind
  when StmtKind::StmtIf(_) then true
  when StmtKind::StmtMatch(_) then true
  when StmtKind::StmtWhile(_, _) then true
  when StmtKind::StmtFor(_) then true
  when StmtKind::StmtLoop(_) then true
  when _ then false
  end  end
end

# The top-level basic-block partition: the body's statement list is split
# at each control-flow statement. Returns the per-block (starts, ends)
# statement-index ranges in order (each block: [starts[i], ends[i])).
def top_block_ranges(stmts: Vec[Stmt]) -> (Vec[Int], Vec[Int])
  var starts = Vec::new()
  var ends = Vec::new()
  var s = 0
  while s < stmts.len() do
    starts.push(s)
    var e = s
    while e < stmts.len() do
      e = e + 1
      if e < stmts.len() && stmt_is_control_flow(&stmts[e - 1]) then
        break
      end
    end
    ends.push(e)
    s = e
  end
  (starts, ends)
end

# The statement-range node-id attribution (the block_stmt_ids mirror for a
# top-level block range [st, en)).
def block_stmt_ids_range(block: Block, st: Int, en: Int) -> Vec[Int]
  var ids = Vec::new()
  var i = st
  while i < en do
    ids.push(block.stmts[i].node_id)
    match block.stmts[i].kind
    when StmtKind::StmtIf(if_stmt) then
      ids.push(if_stmt.cond.node_id)
      var b = 0
      while b < if_stmt.elsif_branches.len() do
        ids.push(if_stmt.elsif_branches[b].0.node_id)
        b = b + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  ids
end

# does the statement RANGE [st, en) end in a terminator?
def block_ends_with_terminator_range(block: Block, st: Int, en: Int) -> Bool
  if en <= st then
    return false
  end
  match block.stmts[en - 1].kind
  when StmtKind::StmtReturn(_) then true
  when StmtKind::StmtBreak(_) then true
  when StmtKind::StmtContinue then true
  when _ then false
  end
end

# The structural walk over the TOP-LEVEL basic blocks (the function body's
# partition): each block's statements' edges are recorded (cfg_stmt), the
# block's CfgBlock record is appended over the block's edge range (id =
# the block's first-statement node id), and the LINEAR continuation edge
# (the block's fallthrough to the next top-level block — Normal, source =
# the block's last statement, destination = the next block's key) is
# recorded for every block except the last. The last block keeps the
# function's fallthrough Normal edge (source = the block's key — the
# attach convention). The block key is pushed on the structural defer
# chain while its statements are walked (the check_block mirror).
def cfg_top_blocks(block: Block, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  let (starts, ends) = top_block_ranges(&block.stmts)
  var bi = 0
  while bi < starts.len() do
    let st = starts[bi]
    let en = ends[bi]
    let blk_key = block.stmts[st].node_id
    let edge_base = edges.len()
    if blk_key != 0 then
      chain.push(blk_key)
    end
    var si = st
    while si < en do
      cfg_stmt(&block.stmts[si], edges, blocks, chain, synth)
      si = si + 1
    end
    if blk_key != 0 then
      chain.pop()
    end
    if bi < starts.len() - 1 then
      let next_key = block.stmts[starts[bi + 1]].node_id
      edges.push(CfgEdge { kind: CfgEdgeKind::Normal, source: block.stmts[en - 1].node_id, destination: next_key, actions: Vec::new() })
    else
      if !block_ends_with_terminator_range(block, st, en) then
        edges.push(CfgEdge { kind: CfgEdgeKind::Normal, source: blk_key, destination: 0, actions: Vec::new() })
      end
    end
    let rec = blocks.len()
    blocks.push(CfgBlock { id: blk_key, origin: 0, edges: Vec::new() })
    attach_block_cfg_record(edges, blocks, rec, &block_stmt_ids_range(block, st, en), edge_base)
    bi = bi + 1
  end
end

def cfg_fn_body(body: FnBody, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  match body
  when FnBody::FnBlock(b) then cfg_top_blocks(&b, edges, blocks, chain, synth)
  when FnBody::FnExpr(e) then cfg_expr(&e, edges, blocks, chain, synth)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end  end
end

# (one TypedCFG): the node ids a lexical block's CfgBlock record
# originates from — the block's OWN statement node ids (the sources of its
# Normal/terminator/GuardElse/Backedge edges) plus the condition-expression
# node ids of its StmtIf/elsif statements (the sources of the True/False
# split edges). Statement-level if-splits are the only edges whose source
# is not a statement id; expression-level if-splits (ExprIf) get their OWN
# expression-split CfgBlock records (cfg_expr's ExprIf arm) — they are
# attributed to those records, never to a block record. This is the
# one-block-per-lexical-block attribution the flow machinery
# (the originating-ids scan over the single flattened statement list)
# performed; the flat list is now derived directly from the statements.
def block_stmt_ids(block: Block) -> Vec[Int]
  var ids = Vec::new()
  mut i = 0
  while i < block.stmts.len() do
    ids.push(block.stmts[i].node_id)
    match block.stmts[i].kind
    when StmtKind::StmtIf(if_stmt) then
      ids.push(if_stmt.cond.node_id)
      var b = 0
      while b < if_stmt.elsif_branches.len() do
        ids.push(if_stmt.elsif_branches[b].0.node_id)
        b = b + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  ids
end

# does the block END in a terminator? The statement-
# flattening classified StmtReturn/StmtBreak/StmtContinue as flow terminators
# nodes — a block whose last statement is one of them terminates, so it
# records no Normal fallthrough edge.
def block_ends_with_terminator(block: Block) -> Bool
  if block.stmts.len() == 0 then
    return false
  end
  let last = block.stmts[block.stmts.len() - 1]
  match last.kind
  when StmtKind::StmtReturn(_) then true
  when StmtKind::StmtBreak(_) then true
  when StmtKind::StmtContinue then true
  when _ then false
  end
end

# is the statement a flow terminator (the statement-flattening
# Linear/Terminator split — the ONLY split that ever fired)?
pub def stmt_is_terminator(stmt: Stmt) -> Bool
  match stmt.kind
  when StmtKind::StmtReturn(_) then true
  when StmtKind::StmtBreak(_) then true
  when StmtKind::StmtContinue then true
  when _ then false
  end  end
end

# / attach the edges a block's transfers originate from to
# its CfgBlock record — every edge in [e_start, edges.len()) whose source
# node id is in the block's originating ids. The range restriction keeps
# earlier/later flow analyses (and the function's other blocks) out of the
# record; source-id membership keeps nested blocks' and loop-body-originated
# edges out (their sources belong to other ids). The direct statement-
# derived attribution replaces the flow-block record builder (the
# flow-block splitting produced exactly one record per lexical block with
# this same id and edge set).
def attach_block_cfg_record(edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], rec: Int, orig_ids: Vec[Int], e_start: Int) -> Unit
  var e = e_start
  while e < edges.len() do
    if orig_ids.contains(&edges[e].source) then
      blocks[rec].edges.push(e)
    end
    e = e + 1
  end
end

# one lexical block's structural walk. The block's statements are
# walked (their edges recorded), the block's own Normal fallthrough edge is
# recorded when the block does not end in a terminator (the check_block
# mirror), and the block's CfgBlock record is appended over the block's
# edge range (attach_block_cfg_record — the ONE block record per lexical
# block, id = the block's first-statement node id; the record exists
# BEFORE the state computation). The block key is pushed on the structural
# defer chain while its statements are walked (the check_block mirror) so
# nested Break/Continue/GuardElse edges' destinations (enclosing_loop_key)
# resolve identically.
def cfg_block(block: Block, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  let edge_base = edges.len()
  let blk_key = block_exit_key(block)
  if blk_key != 0 then
    chain.push(blk_key)
  end
  mut i = 0
  while i < block.stmts.len() do
    cfg_stmt(&block.stmts[i], edges, blocks, chain, synth)
    i = i + 1
  end
  if blk_key != 0 then
    chain.pop()
  end
  if !block_ends_with_terminator(block) then
    # The block's NORMAL fallthrough edge (empty actions — the state walk
    # attaches the cleanup obligation; empty blocks (key 0) have no
    # statements, hence no cleanup-bearing fallthrough edge).
    if blk_key != 0 then
      edges.push(CfgEdge { kind: CfgEdgeKind::Normal, source: blk_key, destination: 0, actions: Vec::new() })
    end
  end
  if blk_key != 0 then
    let rec = blocks.len()
    blocks.push(CfgBlock { id: blk_key, origin: 0, edges: Vec::new() })
    let orig_ids = block_stmt_ids(block)
    attach_block_cfg_record(edges, blocks, rec, &orig_ids, edge_base)
  end
end

# a LOOP BODY's structural walk — the documented gap CLOSED. The
# body is walked (its statements' edges recorded, its CfgBlock record
# appended over the body's edge range) exactly like any lexical block,
# except that NO Normal edge is recorded (the Backedge edge carries the
# per-iteration cleanup). The body scope is pushed NEGATED on the
# structural defer chain while its statements are walked (the
# check_loop_body mirror) so nested Break/Continue/GuardElse destinations
# stop at the loop boundary. the body's block record is the SAME
# record the state walk's check_loop_body executes against — the loop
# body's (entry, exit) frames are recorded under this record's id.
def cfg_loop_body(body: Block, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  let body_key = block_exit_key(body)
  if body_key != 0 then
    chain.push(0 - body_key)
  end
  let body_base = edges.len()
  mut i = 0
  while i < body.stmts.len() do
    cfg_stmt(&body.stmts[i], edges, blocks, chain, synth)
    i = i + 1
  end
  if body_key != 0 then
    chain.pop()
  end
  if body_key != 0 then
    let rec = blocks.len()
    blocks.push(CfgBlock { id: body_key, origin: 0, edges: Vec::new() })
    let orig_ids = block_stmt_ids(body)
    attach_block_cfg_record(edges, blocks, rec, &orig_ids, body_base)
  end
end

# the loop's BACKEDGE edge — the loop body -> header transfer
# (empty actions; the state walk's check_loop_created attaches the
# per-iteration cleanup). Recorded whenever the loop has a body scope to
# re-enter (body_key != 0); the destination is the loop body's block key —
# the SAME loop-context identity the Break/Continue edges of this loop
# carry (enclosing_loop_key), so validate_cfg_edges can verify the loop
# edges name a real loop.
def cfg_loop_backedge(loop_stmt_id: Int, body: Block, inout edges: Vec[CfgEdge]) -> Unit
  let body_key = block_exit_key(body)
  if body_key != 0 then
    edges.push(CfgEdge { kind: CfgEdgeKind::Backedge, source: loop_stmt_id, destination: body_key, actions: Vec::new() })
  end
end

# a defer body's structural walk — block record over the body's
# edge range, NO Normal edge (a defer body records no fallthrough
# obligation — the check_defer_body mirror). The defer body's CfgBlock
# record (id = the body's first statement node id) is the record the state
# walk's check_defer_body executes against.
def cfg_defer_body(body: Block, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  let body_base = edges.len()
  mut i = 0
  while i < body.stmts.len() do
    cfg_stmt(&body.stmts[i], edges, blocks, chain, synth)
    i = i + 1
  end
  let body_key = block_exit_key(body)
  if body_key != 0 then
    let rec = blocks.len()
    blocks.push(CfgBlock { id: body_key, origin: 0, edges: Vec::new() })
    let orig_ids = block_stmt_ids(body)
    attach_block_cfg_record(edges, blocks, rec, &orig_ids, body_base)
  end
end

# the branch block's own Normal (fallthrough) edge — the edge cfg_block
# recorded for the branch (kind Normal, source = the branch's block key),
# or -1 when the branch ends in a terminator (no fallthrough — that branch
# exit never reaches the if-join / match-join). Scanned over the branch's
# own edge range [base, edges.len()): the branch's statements' edges carry
# nested sources, and the branch's fallthrough Normal edge is the LAST edge
# with the branch key as its source.
def cfg_branch_fallthrough_edge(edges: Vec[CfgEdge], base: Int, branch_key: Int) -> Int
  var e = base
  var found = -1
  while e < edges.len() do
    if edges[e].kind == CfgEdgeKind::Normal && edges[e].source == branch_key then
      found = e
    end
    e = e + 1
  end
  found
end

# the statement-level structural dispatch — the check_stmt mirror
# (every transfer the state walk attaches to is recorded HERE, empty).
# `synth` is the run's synthetic block-id counter (cfg_synthetic_alloc).
def cfg_stmt(stmt: Stmt, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then
    cfg_expr(&value, edges, blocks, chain, synth)
  when StmtKind::StmtAssign(target, value) then
    cfg_assign_target(&target, edges, blocks, chain, synth)
    cfg_expr(&value, edges, blocks, chain, synth)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    cfg_expr(&target, edges, blocks, chain, synth)
    cfg_expr(&value, edges, blocks, chain, synth)
  when StmtKind::StmtIf(if_stmt) then
 # the if-split's two branch edges (True: cond -> then arm;
    # False: cond -> the false continuation). They carry no cleanup of
    # their own — the branch cleanups serialize through the branch blocks'
    # own Normal edges and the enclosing scopes' edge plans. destination
    # is the branch block's first-statement id (0 when the branch is
    # empty; the no-else TRAILING False edge's destination is the if-join
    # — see the join block below). The statement-level split's edges are
    # attributed to the enclosing flow block's record (the cond's node id
    # is one of the flow block's originating ids).
    edges.push(CfgEdge { kind: CfgEdgeKind::True, source: if_stmt.cond.node_id, destination: block_exit_key(&if_stmt.then_block), actions: Vec::new() })
    edges.push(CfgEdge { kind: CfgEdgeKind::False, source: if_stmt.cond.node_id, destination: 0, actions: Vec::new() })
    var trail_false = edges.len() - 1
    cfg_expr(&if_stmt.cond, edges, blocks, chain, synth)
    # per-branch (block key, edge base) — the branch blocks' own
    # fallthrough Normal edges are found in their own ranges below.
    var branches: Vec[(Int, Int)] = Vec::new()
    branches.push((block_exit_key(&if_stmt.then_block), edges.len()))
    cfg_block(&if_stmt.then_block, edges, blocks, chain, synth)
    mut i = 0
    while i < if_stmt.elsif_branches.len() do
      edges.push(CfgEdge { kind: CfgEdgeKind::True, source: if_stmt.elsif_branches[i].0.node_id, destination: block_exit_key(&if_stmt.elsif_branches[i].1), actions: Vec::new() })
      edges.push(CfgEdge { kind: CfgEdgeKind::False, source: if_stmt.elsif_branches[i].0.node_id, destination: 0, actions: Vec::new() })
      trail_false = edges.len() - 1
      cfg_expr(&if_stmt.elsif_branches[i].0, edges, blocks, chain, synth)
      branches.push((block_exit_key(&if_stmt.elsif_branches[i].1), edges.len()))
      cfg_block(&if_stmt.elsif_branches[i].1, edges, blocks, chain, synth)
      i = i + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then
      branches.push((block_exit_key(&eb), edges.len()))
      cfg_block(&eb, edges, blocks, chain, synth)
    when Option::None then ()
    end
  # / THE IF-JOIN — the continuation block the if's branch exits
    # merge into (the state walk records the join block's ENTRY frame —
    # the merged branch exits — under this same id). The branch blocks'
    # Normal (fallthrough) edges target the join; the no-else path's
    # trailing False edge (the false continuation) targets it directly.
    # The join record's id is ALLOCATED from the guaranteed-disjoint
    # synthetic counter (cfg_synthetic_alloc — the negative domain, never
    # reused), with the CONDITION's node id as its origin — the state
    # walk's handle for reading the id back (cfg_join_record_id). (The
    # if-stmt's OWN node id keys the top-level partition's lexical block
    # when the if opens a block, and the cond's node id is an expression
    # id — neither can key the join under the allocator: the join is the
    # if's continuation, a distinct block.) The join executes no
    # statements — its CfgBlock record carries the INCOMING edges.
    let join_id = cfg_synthetic_alloc(synth)
    let join_origin = if_stmt.cond.node_id
    var join_edges = Vec::new()
    for (bk, base) in branches do
      let nidx = cfg_branch_fallthrough_edge(edges, base, bk)
      if nidx >= 0 then
        edges[nidx].destination = join_id
        join_edges.push(nidx)
      end
    end
    match if_stmt.else_block
    when Option::Some(_) then ()
    when Option::None then
      edges[trail_false].destination = join_id
      join_edges.push(trail_false)
    end
    blocks.push(CfgBlock { id: join_id, origin: join_origin, edges: join_edges })
  when StmtKind::StmtMatch(m) then cfg_match(&m, edges, blocks, chain, synth)
  when StmtKind::StmtWhile(cond, body) then
    # the while-condition's EXIT edge — the False edge the loop exits
    # through when the condition fails. The single-shot loop cleanup
    # (check_loop_created) attaches the loop-created obligations to it
    # when the loop executes at most once (the backedge is unreachable
    # then); the edge carries no obligation of its own otherwise. The
    # edge's target is the WHILE-JOIN — the loop's continuation — whose id
    # is ALLOCATED from the synthetic counter (the cond's node id is its
    # origin; the loop statement's OWN node id keys the enclosing flow
    # block — the allocator keeps every domain apart).
    let while_join_id = cfg_synthetic_alloc(synth)
    edges.push(CfgEdge { kind: CfgEdgeKind::False, source: cond.node_id, destination: while_join_id, actions: Vec::new() })
    let while_exit_edge = edges.len() - 1
    cfg_expr(&cond, edges, blocks, chain, synth)
    cfg_loop_body(&body, edges, blocks, chain, synth)
    cfg_loop_backedge(stmt.node_id, &body, edges)
    # / THE WHILE-JOIN — the loop's continuation block record (the
    # state walk records the after-frame — the loop's exit state — as
    # the join's (entry, exit) under this same id). The join executes no
    # statements; its record carries the INCOMING edge (the loop's EXIT
    # edge — the False edge, the loop's transfer into the continuation).
    var while_join_edges = Vec::new()
    while_join_edges.push(while_exit_edge)
    blocks.push(CfgBlock { id: while_join_id, origin: cond.node_id, edges: while_join_edges })
  when StmtKind::StmtFor(for_stmt) then
    cfg_pattern(&for_stmt.pattern, edges, blocks, chain, synth)
    cfg_expr(&for_stmt.iter, edges, blocks, chain, synth)
    cfg_loop_body(&for_stmt.body, edges, blocks, chain, synth)
    cfg_loop_backedge(stmt.node_id, &for_stmt.body, edges)
    # / THE FOR-JOIN — the for loop's continuation block record. The
    # id is ALLOCATED from the synthetic counter with the for statement's
    # node id as its origin — the P0 collision class (`for x in xs ...
    # end; after()` — the for stmt's node id ALSO keys the enclosing
    # top-level block's lexical record when the for opens the block) is
    # gone BY CONSTRUCTION: the lexical record keeps the positive
    # statement id, the continuation record gets the disjoint negative
    # synthetic id. The state walk records the after-frame as the join's
    # (entry, exit). The for has no natural exit edge (its exits are the
    # body's Break/Return edges, which target the body's key), so the
    # record carries no incoming edges.
    let for_join_id = cfg_synthetic_alloc(synth)
    var for_join_edges = Vec::new()
    blocks.push(CfgBlock { id: for_join_id, origin: stmt.node_id, edges: for_join_edges })
  when StmtKind::StmtLoop(body) then
    cfg_loop_body(&body, edges, blocks, chain, synth)
    cfg_loop_backedge(stmt.node_id, &body, edges)
    # / THE LOOP-JOIN — the cond-less `loop`'s continuation block
    # record. The id is ALLOCATED from the synthetic counter with the loop
    # statement's node id as its origin — the same by-construction
    # disjointness as the for-join (the loop stmt's node id keys the
    # enclosing top-level block's lexical record when the loop opens the
    # block; the continuation record is the distinct negative synthetic
    # id). The state walk records the after-frame as the join's (entry,
    # exit); the cond-less loop's exits are the body's Break/Return edges,
    # so the record carries no incoming edges.
    let loop_join_id = cfg_synthetic_alloc(synth)
    var loop_join_edges = Vec::new()
    blocks.push(CfgBlock { id: loop_join_id, origin: stmt.node_id, edges: loop_join_edges })
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then cfg_expr(&val, edges, blocks, chain, synth)
    when Option::None then ()
    end
    edges.push(CfgEdge { kind: CfgEdgeKind::Return, source: stmt.node_id, destination: 0, actions: Vec::new() })
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then cfg_expr(&val, edges, blocks, chain, synth)
    when Option::None then ()
    end
    edges.push(CfgEdge { kind: CfgEdgeKind::Break, source: stmt.node_id, destination: enclosing_loop_key(chain), actions: Vec::new() })
  when StmtKind::StmtContinue then
    edges.push(CfgEdge { kind: CfgEdgeKind::Continue, source: stmt.node_id, destination: enclosing_loop_key(chain), actions: Vec::new() })
  when StmtKind::StmtExpr(e) then cfg_expr(&e, edges, blocks, chain, synth)
  when StmtKind::StmtUnsafe(_, body) then cfg_block(&body, edges, blocks, chain, synth)
  when StmtKind::StmtDefer(body) then cfg_defer_body(&body, edges, blocks, chain, synth)
  when StmtKind::StmtGuard(cond, else_action) then
    cfg_expr(&cond, edges, blocks, chain, synth)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then cfg_expr(&val, edges, blocks, chain, synth)
      when Option::None then ()
      end
      edges.push(CfgEdge { kind: CfgEdgeKind::GuardElse, source: stmt.node_id, destination: 0, actions: Vec::new() })
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then cfg_expr(&val, edges, blocks, chain, synth)
      when Option::None then ()
      end
      edges.push(CfgEdge { kind: CfgEdgeKind::GuardElse, source: stmt.node_id, destination: enclosing_loop_key(chain), actions: Vec::new() })
    when GuardElse::Continue then
      edges.push(CfgEdge { kind: CfgEdgeKind::GuardElse, source: stmt.node_id, destination: enclosing_loop_key(chain), actions: Vec::new() })
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    cfg_block(&body, edges, blocks, chain, synth)
    mut i = 0
    while i < catches.len() do
      cfg_block(&catches[i].body, edges, blocks, chain, synth)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then cfg_block(&fb, edges, blocks, chain, synth)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, _, body) then
    cfg_expr(&expr, edges, blocks, chain, synth)
    cfg_block(&body, edges, blocks, chain, synth)
  when StmtKind::StmtHandleWith(expr, handlers) then
    cfg_expr(&expr, edges, blocks, chain, synth)
    mut i = 0
    while i < handlers.len() do
      mut j = 0
      while j < handlers[i].arms.len() do
        cfg_block(&handlers[i].arms[j].body, edges, blocks, chain, synth)
        j = j + 1
      end
      i = i + 1
    end
  end  end
end

# the assign-target structural walk. The state walk's
# check_assign_target only expression-walks a ROOTLESS target; a rootful
# target's expression-level splits are recorded here too (extra True/False
# split edges with empty actions are harmless — the state computation
# never attaches cleanup to split edges).
def cfg_assign_target(target: Expr, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  cfg_expr(target, edges, blocks, chain, synth)
end

# the match structural walk (the check_match mirror — the
# scrutinee's and the arm patterns'/guards' expression-level splits plus
# the arm bodies' blocks).
def cfg_match(m: MatchExpr, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  cfg_expr(&m.scrutinee, edges, blocks, chain, synth)
  # per-arm (block key, edge base) — the arm bodies' own fallthrough
  # Normal edges are found in their own ranges below (the pattern-guard
  # edges precede each arm body; the base is taken at the arm body, so
  # the range covers the body's own edges only).
  var branches: Vec[(Int, Int)] = Vec::new()
  mut i = 0
  while i < m.arms.len() do
    cfg_pattern(&m.arms[i].pattern, edges, blocks, chain, synth)
    match m.arms[i].guard_expr
    when Option::Some(g) then cfg_expr(&g, edges, blocks, chain, synth)
    when Option::None then ()
    end
    branches.push((block_exit_key(&m.arms[i].body), edges.len()))
    cfg_block(&m.arms[i].body, edges, blocks, chain, synth)
    i = i + 1
  end
  # / THE MATCH-JOIN — the continuation block the arm exits merge
  # into (the state walk records the join block's ENTRY frame — the
  # merged arm exits — under this same id). The arm blocks' Normal
  # (fallthrough) edges target the join. The join record's id is
  # ALLOCATED from the guaranteed-disjoint synthetic counter with the
  # SCRUTINEE's node id as its origin — the state walk's handle for
  # reading the id back (cfg_join_record_id). The scrutinee's expression
  # id and the match stmt's own node id (the enclosing flow block's key)
  # both stay out of the synthetic domain. The join executes no
  # statements — its CfgBlock record carries the INCOMING edges.
  let join_id = cfg_synthetic_alloc(synth)
  let join_origin = m.scrutinee.node_id
  var join_edges = Vec::new()
  for (bk, base) in branches do
    let nidx = cfg_branch_fallthrough_edge(edges, base, bk)
    if nidx >= 0 then
      edges[nidx].destination = join_id
      join_edges.push(nidx)
    end
  end
  blocks.push(CfgBlock { id: join_id, origin: join_origin, edges: join_edges })
end

# the pattern structural walk (the check_pattern mirror — only
# literal/range-bound expressions can carry expression-level splits).
def cfg_pattern(pat: Pattern, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(e) then cfg_expr(&e, edges, blocks, chain, synth)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      cfg_pattern(&pats[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      cfg_pattern(&pats[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      cfg_pattern(&field_pats[i].1, edges, blocks, chain, synth)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      cfg_pattern(&pats[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      cfg_pattern(&alts[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then cfg_expr(&e, edges, blocks, chain, synth)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then cfg_expr(&e, edges, blocks, chain, synth)
    when Option::None then ()
    end
  end  end
end

# the expression-level structural dispatch — the check_expr
# mirror. Expression-level splits (ExprIf) get their True/False edges AND
# their own expression-split CfgBlock record (the documented gap CLOSED).
# Closures get a fresh defer chain (the check_expr mirror). `synth` is the
# run's synthetic block-id counter (cfg_synthetic_alloc).
def cfg_expr(expr: Expr, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout chain: Vec[Int], inout synth: Int) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      cfg_expr(&elems[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      cfg_expr(&elems[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      cfg_expr(&fields[i].1, edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      cfg_expr(&entries[i].0, edges, blocks, chain, synth)
      cfg_expr(&entries[i].1, edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then ()
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    cfg_expr(&lhs, edges, blocks, chain, synth)
    cfg_expr(&rhs, edges, blocks, chain, synth)
  when ExprKind::ExprUnaryOp(_, operand) then cfg_expr(&operand, edges, blocks, chain, synth)
  when ExprKind::ExprFieldAccess(base, _) then cfg_expr(&base, edges, blocks, chain, synth)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    cfg_expr(&recv, edges, blocks, chain, synth)
    mut i = 0
    while i < args.len() do
      cfg_expr(&args[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprIndex(base, index) then
    cfg_expr(&base, edges, blocks, chain, synth)
    cfg_expr(&index, edges, blocks, chain, synth)
  when ExprKind::ExprCall(callee, args) then
    cfg_expr(&callee, edges, blocks, chain, synth)
    mut i = 0
    while i < args.len() do
      cfg_expr(&args[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprClosure(_, _, body) then
    var closure_chain = Vec::new()
    cfg_expr(&body, edges, blocks, &mut closure_chain, synth)
  when ExprKind::ExprAccess(inner) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprRawDeref(inner) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprIf(if_stmt) then
 # the EXPRESSION-level if-split — the True/False edges PLUS the
    # expression-split CfgBlock record (the documented gap CLOSED). The
    # split record's id is ALLOCATED from the guaranteed-disjoint
    # synthetic counter with the CONDITION's node id as its origin (the
    # state walk's cfg_join_record_id handle — check_if records the
    # merged branch exits under this id). The branch blocks get their own
    # flow-block records.
    let split_id = cfg_synthetic_alloc(synth)
    let split_origin = if_stmt.cond.node_id
    let t_idx = edges.len()
    edges.push(CfgEdge { kind: CfgEdgeKind::True, source: if_stmt.cond.node_id, destination: block_exit_key(&if_stmt.then_block), actions: Vec::new() })
    let f_idx = edges.len()
    edges.push(CfgEdge { kind: CfgEdgeKind::False, source: if_stmt.cond.node_id, destination: 0, actions: Vec::new() })
    var split_edges = Vec::new()
    split_edges.push(t_idx)
    split_edges.push(f_idx)
    blocks.push(CfgBlock { id: split_id, origin: split_origin, edges: split_edges })
    cfg_expr(&if_stmt.cond, edges, blocks, chain, synth)
    cfg_block(&if_stmt.then_block, edges, blocks, chain, synth)
    match if_stmt.else_block
    when Option::Some(eb) then cfg_block(&eb, edges, blocks, chain, synth)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then cfg_match(&m, edges, blocks, chain, synth)
  when ExprKind::ExprBlock(block) then cfg_block(&block, edges, blocks, chain, synth)
  when ExprKind::ExprUnsafe(_, block) then cfg_block(&block, edges, blocks, chain, synth)
  when ExprKind::ExprAsync(block) then cfg_block(&block, edges, blocks, chain, synth)
  when ExprKind::ExprAwait(inner) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprTry(inner) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then cfg_expr(&s, edges, blocks, chain, synth)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then cfg_expr(&e, edges, blocks, chain, synth)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprTypeCheck(inner, _) then cfg_expr(&inner, edges, blocks, chain, synth)
  when ExprKind::ExprComptime(block) then cfg_block(&block, edges, blocks, chain, synth)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      cfg_expr(&args[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    cfg_assign_target(&target, edges, blocks, chain, synth)
    cfg_expr(&value, edges, blocks, chain, synth)
  when ExprKind::ExprPipe(lhs, rhs) then
    cfg_expr(&lhs, edges, blocks, chain, synth)
    cfg_expr(&rhs, edges, blocks, chain, synth)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      cfg_expr(&args[i], edges, blocks, chain, synth)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end  end
end

# the index of the pre-built edge with the given (kind, source)
# identity, or -1. The structural CFG pass records every transfer the
# state computation attaches to, so a miss at an attach site is an
# internal error (reported by attach_edge_actions).
pub def find_edge_index(edges: Vec[CfgEdge], kind: CfgEdgeKind, source: Int) -> Int
  mut i = 0
  while i < edges.len() do
    if edges[i].kind == kind && edges[i].source == source then
      return i
    end
    i = i + 1
  end
  -1
end

# / attach a cleanup obligation to a PRE-BUILT edge (by its
# (kind, source) identity) — the state computation's way of filling an
# edge's actions (the structural pass recorded the edge with empty
# actions). The EndAccess actions for the accesses the edge's transfer
# performed (the access checker's registry — keyed by the edge's
# CfgEdgeId, its index in the edge list, so the found index is the key) are
# PREPENDED in reverse registration order (borrows end LIFO — before any
# deferred code runs or memory is freed), then the recording site's actions
# (RunDefer LIFO, then Drop in reverse drop order).
pub def attach_edge_actions(ctx: AnalysisContext, inout edges: Vec[CfgEdge], kind: CfgEdgeKind, source: Int, actions: Vec[CleanupAction], inout errors: Vec[ResourceError]) -> Unit
  let idx = find_edge_index(edges, kind, source)
  if idx >= 0 then
    var full_actions = Vec::new()
    let access_ids = access_registry_for_edge(ctx, idx)
    var ai = access_ids.len()
    while ai > 0 do
      ai = ai - 1
      full_actions.push(CleanupAction::EndAccess(access_ids[ai]))
    end
    for act in actions do
      full_actions.push(act)
    end
    edges[idx].actions = full_actions
  else
    errors.push(ResourceError {
      message: "internal error: resource-check state walk attached actions to an edge the structural CFG pass never recorded",
      span: Span { file: "", start: 0, end_pos: 0 }
    })
  end
end

# serialize the edges' actions into the parallel CleanupEdge table —
# cleanup[i] is edge i's CleanupEdge; the edge's index IS its CfgEdgeId.
# One record per edge (empty actions included — a record exists for every
# real CFG transfer; the MIR's "no record" case is only a synthesized/
# IR-only edge that never passed through the checker).
pub def cleanup_edges_serialize(edges: Vec[CfgEdge]) -> Vec[CleanupEdge]
  var out = Vec::new()
  mut i = 0
  while i < edges.len() do
    out.push(CleanupEdge { edge: CfgEdgeId { id: i }, actions: edges[i].actions.clone() })
    i = i + 1
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Type-property consumption — the ENGINE QUERY layer ()
# ———————————————————————————————————————————————————————————————
# Type-property consumption — the ENGINE QUERY layer ()
# ———————————————————————————————————————————————————————————————
#
# THE PASS CONSUMES THE TYPES.TG TYPE-PROPERTY ENGINE DIRECTLY.
#
# The engine (types.tg) decides ONE property bundle per CONCRETE type:
#
#   type_properties_of(env: &mut TypeEnv, ty: &Type) -> TypeProperties
#       { owns_state, requires_drop_glue, is_linear, is_capability,
#         contains_capability, is_trivially_copyable, is_deferred }
#
# via type_props_walk / type_named_props (the named-properties computation)
# and is_named_trivially_copyable, memoized by the concrete (TypeId, substs)
# identity (type_identity_key_resolved — Wrapper[Int] and Wrapper[File] are
# distinct cache entries).
#
# This checker receives only Program + TypedProgram (no TypeEnv reference is
# threaded by the pipeline), and the engine runs on the TypeEnv tables
# (env.type_list / env.lang_items / env.impls / env.type_prop_cache). The
# TypedProgram carries the engine's OWN tables in serialized form
# (type_names / type_kinds / type_fields / type_variants / type_params /
# deinit_targets — exactly the tables type_named_props and
# type_has_registered_drop read), so the ENGINE-CONSUMPTION BRIDGE below
# re-registers them into a snapshot TypeEnv (engine_snapshot_env) and every
# ownership question in this file then calls type_properties_of(env, ty)
# directly. There is no second ownership analysis: the DECISION PROCEDURE
# runs in types.tg, table for table, with the engine's memoization.
#
# The snapshot is built ONCE per resource_check run (resource_check ->
# engine_snapshot_env) and threaded as &mut TypeEnv through the checker
# call chain — the pipeline-threading migration target documented at the
# former checker_type_props layer, satisfied inside this file.
#
# Corrected engine state (build-on): Vec/Map/Set (and the Vec-backed
# Array) owns_state = requires_drop_glue = TRUE unconditionally (the
# container layer owns its backing storage — Vec[Int] must still release
# its buffer); is_linear = Resource/Capability kinds + Box/UniquePtr ONLY
# (Rc/WeakRc/ArcStrong/WeakArc are drop-only); no depth fail-open anywhere;
# a Type::Param / Type::Var in the graph yields is_deferred=true and NEVER
# a concrete semantic answer; String owns_state=true per the FROZEN StringPtr
# ABI ownership contract (std/core.tg "String ownership contract" — moves
# transfer, clone allocates, never bitwise-copyable) with
# requires_drop_glue=TRUE (— real String lifetime: the owned String
# object and its buffer are real-heap allocations and the String drop —
# the DeinitPlan::String destructor — frees both, so the MIR drop plan
# for String is the real glue). The
# checker consumes the OWNS_STATE axis (is_owning_typed); the MIR's
# deinit-plan gate consumes requires_drop_glue; the MIR Copy verifier
# consumes is_trivially_copyable. PENDING: generated drop glue for
# recursive owning types (docs/memory_model.md §15.2).
#
# DEFERRED-CONTRACT note (— the generic ownership policy): a
# Type::Param's bundle is is_deferred=true with the six semantic fields
# non-authoritative (false = "not proven true"). The policy has TWO halves:
#   - the DEFERRAL half: the checker delays Param-position ownership
#     decisions (is_owning_typed answers false for the deferred bundle —
#     "not DECIDED owning" — so an unconstrained T is neither assumed
#     owning nor assumed free in a way that fabricates drops; legal
#     generic patterns whose concrete move semantics the post-mono
#     verifier sanctions stay accepted);
#   - the FAIL-CLOSED half at every DECISION point: the MIR Copy verifier
#     answers a deferred type NOT copyable (never "copyable"); the
#     drop-glue axis answers DeinitPlan::Deferred (never Trivial — a
#     substituted resource instantiation can never silently degrade to
#     "no destructor"); the mono wave substitutes MirDeinit payloads so
#     the concrete drop glue after substitution is what the instance
#     destroys with. An unknown answer NEVER degrades to "copyable" and
#     NEVER degrades to a concrete "no destructor" plan.

# The empty TypeEnv the snapshot tables are registered into. Mirrors
# type_env_new's defaults (types.tg) minus the builtin registrations: the
# ids in the snapshot come from the TYPED program's own tables, never from
# a fresh registration order.
pub def engine_env_empty() -> TypeEnv
  TypeEnv {
    type_list: Vec::new(),
    type_name_index: Map::new(),
    module_type_names: Map::new(),
    module_callable_types: Map::new(),
    callable_first_wins: Map::new(),
    type_id_index: Map::new(),
    type_id_counter: 100,
    subst: Map::new(),
    var_counter: 0,
    scopes: Vec::new(),
    check_ctx: "",
    current_module_path: Vec::new(),
    strict_resolution: false,
    expected_return: Option::None,
    binding_plans: Map::new(),
    pattern_variant_resolutions: Map::new(),
    effects: effect_registry_new(),
    typed_intrinsics: Map::new(),
    impls: Vec::new(),
    method_lookup: Map::new(),
    trait_registry: Map::new(),
    lang_items: LangItems {
      option: -1,
      result: -1,
      vec: -1,
      map: -1,
      set: -1,
      box_: -1,
      rc: -1,
      array: -1,
      slice: -1,
      string: -1,
      str_view: -1,
      unique_ptr: -1,
      arc_strong: -1,
      weak_rc: -1,
      weak_arc: -1,
      affine_handle: -1,
      ptr: -1,
      ptr_mut: -1,
      drop_trait: -1,
      clone_trait: -1,
      copy_trait: -1,
      eq_trait: -1,
      hash_trait: -1,
      transferable_trait: -1,
      shareable_trait: -1
    },
    const_values: Map::new(),
    param_for_type_impls: Vec::new(),
    param_bounds: Map::new(),
    pending_call_instances: Map::new(),
    non_send_types: Set::new(),
    non_sync_types: Set::new(),
    errors: Vec::new(),
    warnings: Vec::new(),
    typed_expr_types: Map::new(),
    local_id_counter: 0,
    local_ids: Vec::new(),
    resolutions: Option::None,
    typed_call_targets: Map::new(),
    typed_call_instances: Map::new(),
    typed_field_targets: Map::new(),
    typed_local_bindings: Map::new(),
    typed_ident_resolutions: Map::new(),
    param_binding_resolutions: Map::new(),
    pattern_binding_resolutions: Map::new(),
    typed_access_effects: Map::new(),
    typed_exprs: Map::new(),
    typed_stmts: Map::new(),
    typed_patterns: Map::new(),
    typed_aggregate_ownership: Map::new(),
    closure_captures: Map::new(),
    access_marker_depth: 0,
    generic_param_table: generic_param_table_new(),
    generic_param_ids: Map::new(),
    type_prop_cache: Map::new()
  }
end

# Re-register the TypedProgram's serialized engine tables (type_names /
# type_kinds / type_fields / type_variants / type_params / deinit_targets)
# into a TypeEnv the engine can run on. The registered ids ARE the typed
# program's semantic TypeIds (the same universe every Type value in this
# pass carries), so type_properties_of answers exactly as it did during
# type checking — including the LangItems selection (the builtin ids are
# recovered by the registered names, the same identity the MIR's
# mir_lang_item_id resolves) and the Drop registration (deinit_targets is
# the serialization of the Drop-impl table type_has_registered_drop scans).
# The engine memoizes in env.type_prop_cache, which starts empty here.
pub def engine_snapshot_env(typed: TypedProgram) -> TypeEnv
  var env = engine_env_empty()
  var type_list = Vec::new()
  var name_index: Map[String, Int] = Map::new()
  var id_index: Map[Int, Int] = Map::new()
  var id_by_name: Map[String, Int] = Map::new()
  var idx = 0
  for (tid, tname) in typed.type_names do
    let kind = match typed.type_kinds.get(tid)
    when Option::Some(k) then k
    when Option::None then TypeKind::Value
    end
    let gen_params = match typed.type_params.get(tid)
    when Option::Some(p) then p.clone()
    when Option::None then Vec::new()
    end
    # def_kind reconstruction: the serialized field/variant tables map onto
    # TypeDefKind::Struct / TypeDefKind::Enum (the engine's named-props walk
    # substitutes td.generic_params with the concrete args, exactly as the
    # parallel layer did). A type with no serialized shape is Opaque
    # — the builtins select by LangItems id / registered name BEFORE the
    # def_kind walk, and an unresolved id answers non-owning (the same
    # fail-safe the former typed-table walk had).
    var def_kind = TypeDefKind::Opaque
    match typed.type_fields.get(tid)
    when Option::Some(fields) then
      var finfo = Vec::new()
      for f in fields do
        finfo.push(FieldInfo { name: f.0.clone(), ty: f.1.clone(), is_public: false })
      end
      def_kind = TypeDefKind::Struct(finfo)
    when Option::None then
      match typed.type_variants.get(tid)
      when Option::Some(variants) then
        var vinfo = Vec::new()
        for v in variants do
          vinfo.push(VariantInfo { name: v.0.clone(), fields: v.1.clone(), discriminant: v.2 })
        end
        def_kind = TypeDefKind::Enum(vinfo)
      when Option::None then ()
      end
    end
    type_list.push(TypeDef { id: TypeId { id: tid }, name: tname.clone(), def_kind: def_kind, generic_params: gen_params, kind: kind, def: Option::None })
    name_index.insert(tname.clone(), idx)
    id_index.insert(tid, idx)
    id_by_name.insert(tname.clone(), tid)
    idx = idx + 1
  end
  env.type_list = type_list
  env.type_name_index = name_index
  env.type_id_index = id_index
  # LangItems selection: the builtin compound ids by their registered names
  # (the engine's own identity table — Option/Result/Vec/Map/Set/Box/Rc/
  # Array/Slice/String/Ptr/PtrMut are registered builtins; StrView/
  # UniquePtr/ArcStrong/WeakRc/WeakArc are std-declared and registered in
  # the typed program's tables). drop_trait is resolved from the registered
  # "Drop" type id (the builtin Drop trait's declaration identity — the same
  # id the checker's lang_items.drop_trait carries; the synthetic 1 is the
  # fallback only for a snapshot with no Drop registration, which cannot
  # happen for the prelude-carrying program).
  var drop_trait_id = 1
  match id_by_name.get("Drop")
  when Option::Some(v) then drop_trait_id = v
  when Option::None then ()
  end
  var li = LangItems {
    option: -1,
    result: -1,
    vec: -1,
    map: -1,
    set: -1,
    box_: -1,
    rc: -1,
    array: -1,
    slice: -1,
    string: -1,
    str_view: -1,
    unique_ptr: -1,
    arc_strong: -1,
    weak_rc: -1,
    weak_arc: -1,
    affine_handle: -1,
    ptr: -1,
    ptr_mut: -1,
    drop_trait: drop_trait_id,
    clone_trait: -1,
    copy_trait: -1,
    eq_trait: -1,
    hash_trait: -1,
    transferable_trait: -1,
    shareable_trait: -1
  }
  match id_by_name.get("Option")
  when Option::Some(v) then li.option = v
  when Option::None then ()
  end
  match id_by_name.get("Result")
  when Option::Some(v) then li.result = v
  when Option::None then ()
  end
  match id_by_name.get("Vec")
  when Option::Some(v) then li.vec = v
  when Option::None then ()
  end
  match id_by_name.get("Map")
  when Option::Some(v) then li.map = v
  when Option::None then ()
  end
  match id_by_name.get("Set")
  when Option::Some(v) then li.set = v
  when Option::None then ()
  end
  match id_by_name.get("Box")
  when Option::Some(v) then li.box_ = v
  when Option::None then ()
  end
  match id_by_name.get("Rc")
  when Option::Some(v) then li.rc = v
  when Option::None then ()
  end
  match id_by_name.get("Array")
  when Option::Some(v) then li.array = v
  when Option::None then ()
  end
  match id_by_name.get("Slice")
  when Option::Some(v) then li.slice = v
  when Option::None then ()
  end
  match id_by_name.get("String")
  when Option::Some(v) then li.string = v
  when Option::None then ()
  end
  match id_by_name.get("StrView")
  when Option::Some(v) then li.str_view = v
  when Option::None then ()
  end
  match id_by_name.get("UniquePtr")
  when Option::Some(v) then li.unique_ptr = v
  when Option::None then ()
  end
  match id_by_name.get("ArcStrong")
  when Option::Some(v) then li.arc_strong = v
  when Option::None then ()
  end
  match id_by_name.get("WeakRc")
  when Option::Some(v) then li.weak_rc = v
  when Option::None then ()
  end
  match id_by_name.get("WeakArc")
  when Option::Some(v) then li.weak_arc = v
  when Option::None then ()
  end
  match id_by_name.get("AffineHandle")
  when Option::Some(v) then li.affine_handle = v
  when Option::None then ()
  end
  match id_by_name.get("Ptr")
  when Option::Some(v) then li.ptr = v
  when Option::None then ()
  end
  match id_by_name.get("PtrMut")
  when Option::Some(v) then li.ptr_mut = v
  when Option::None then ()
  end
  env.lang_items = li
  # Drop registration: deinit_targets (TypeId -> drop-glue name) is the
  # serialized `impl Drop for T` table. The engine's type_has_registered_drop
  # scans env.impls for lang_items.drop_trait with for_type = Adt(tid, _)
  # (args ignored — registration is per type, not per instantiation).
  var impls = Vec::new()
  for (tid, _) in typed.deinit_targets do
    impls.push(ImplInfo {
      trait_id: TraitId { id: drop_trait_id },
      trait_name: "Drop",
      for_type: Type::Adt(TypeId { id: tid }, Vec::new()),
      obligations: Vec::new(),
      methods: Vec::new(),
      generic_params: Vec::new(),
      trait_ref: TraitRefTemplate { trait_id: TraitId { id: drop_trait_id }, args: Vec::new() }
    })
  end
  env.impls = impls
  env
end


# Capability containment — the engine's contains_capability query. The
# TypeProperties bundle carries contains_capability (types.tg): a
# TypeKind::Capability named type contains a capability (itself), and the
# engine propagates it through composites — an aggregate containing a
# capability FIELD, a container with capability ELEMENTS, Option/Result
# containing capabilities, tuples/fixed arrays, aliases, and refs (the
# engine walks the substituted fields/elements in type_props_walk /
# type_named_props, exactly the tables this checker's snapshot env
# carries). The checker's capability machinery (res_frame_mark_cap — a
# capability local must be consumed at scope end) needs the CONTAINMENT
# answer (Option[Cap] holds a capability), which is now the engine's
# contains_capability axis — queried on the CONCRETE type identity like
# every other ownership question in this file. The former parallel walk
# over the typed tables is are not part of the model: no second containment analysis.
def type_kind_contains_capability(inout env: TypeEnv, ty: Type) -> Bool
  type_properties_of(env, ty).contains_capability
end

def binding_name(typed: TypedProgram, id: Int) -> String
  match typed.local_bindings.get(id)
  when Option::Some(lb) then lb.name.clone()
  when Option::None then ""
  end  end
end

# The owner key of a FREE function item is derived by types.tg's
# fn_owner_key_of_item — the SINGLE key derivation shared with the type
# checker and MIR: the item's DefId via fn_owner_key (from the resolver's
# item_defs / def_id_of_item), or the module-path-qualified name fallback
# ("module::<full path>::<name>") for the no-DefId cases. One semantic
# callable -> one DefId -> one owner key in all three consumers.

# Derive the owner key for an item's function/method from the typed
# program's resolver output (DefId-based; unique across merged files).
# Methods without a recorded DefId fall back to a per-item positional key.
def item_owner_key(typed: TypedProgram, item_idx: Int, method_index: Int) -> String
  match typed.resolutions.item_defs.get(item_idx)
  when Option::Some(dids) then
    if method_index < dids.len() then
      let did = dids[method_index]
 # the DefId carries the owner ModuleId (NEVER a path String)
      # and NO kind — the render derives the module path from the typed
      # program's crate through the ONE shared lookup (types.tg's
      # crate_module_path_of — an O(1) Crate.modules table read by the
      # ModuleId key, never a containment scan) and the DefKind from the
      # resolver's def_kinds snapshot (def_kind_of — STRICT: a missing
      # kind is an internal error, never a DefKind::Other degradation).
      # The rendered key is byte-identical to the pre-migration form
      # ("<module path>::<index>::<kind>"), so the parameter-binding and
      # finalize-plan keys stay in agreement with the type checker and
      # MIR.
      let module_path = module_path_of_did(typed, &did)
      let kind = def_id_kind_of(&typed.resolutions, &did)
      return fn_owner_key(module_path, did.index, kind)
    end
  when Option::None then ()
  end
  "item::" + item_idx.to_string() + "::method::" + method_index.to_string()  end
end

# the owner-module path String of a resolver-produced DefId. The
# DefId's module is the ModuleId identity into Program.crate.modules — the
# path is derived HERE at the mangling boundary through the ONE shared
# lookup (types.tg's crate_module_path_of — an O(1) table read by the
# ModuleId key, never a containment scan). STRICT (the compile path): a
# missing module is an internal compiler error (ICE) — it never
# degenerates to the root-module render "".
def module_path_of_did(typed: TypedProgram, did: DefId) -> String
  crate_module_path_of(&typed.ast, &did.module).join("::")
end

# the SEMANTIC callable identity of an item's free function — the
# resolver's item_defs first DefId (the SAME map def_id_of_item /
# mir_fn_owner_key consume). Option::None when the resolver recorded none
# (the module-qualified-name fallback case — the semantic cleanup table is
# keyed by CallableId, so no entry is recorded; the MIR never lowers those
# items). One semantic callable -> one DefId -> one CallableId across the
# checker and the MIR.
def item_callable(typed: TypedProgram, item_idx: Int) -> Option[CallableId]
  match typed.resolutions.item_defs.get(item_idx)
  when Option::Some(dids) then
    if dids.len() > 0 then
      Option::Some(CallableId { def: dids[0].clone() })
    else
      Option::None
    end
  when Option::None then Option::None
  end  end
end

# the semantic callable identity of an item's method at
# (item index, method index) — the resolver's item_defs entry (the SAME
# map item_owner_key / mir_item_owner_key derive the String owner key
# from). Option::None when the resolver recorded none.
def item_method_callable(typed: TypedProgram, item_idx: Int, method_index: Int) -> Option[CallableId]
  match typed.resolutions.item_defs.get(item_idx)
  when Option::Some(dids) then
    if method_index < dids.len() then
      Option::Some(CallableId { def: dids[method_index].clone() })
    else
      Option::None
    end
  when Option::None then Option::None
  end  end
end

def check_item(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, item: Item, item_idx: Int, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], module_path: Vec[String]) -> Unit
  var item_entry = Vec::new()
 # the item-level expression checks (struct field defaults,
  # const/static values, macro bodies) run against the PRE-BUILT global CFG
  # (build_typed_cfg recorded the item-level edges/blocks; the state walk
  # attaches the cleanup actions to them). The item-level structure is
  # otherwise discarded — validation runs over the whole CFG at the end of
  # resource_check.
  # The enclosing-scope chain of block keys (outermost first) for defer
  # registration and LIFO edge attachment. Item-level expressions (struct
  # field defaults, const/static values, macro bodies) have no enclosing
  # lexical scope; functions create their own chain (check_function).
  var item_defer_chain = Vec::new()
  match item.kind
  when ItemKind::ItemFunction(f) then
    # THE SAME owner key derivation as the type checker and MIR: types.tg's
    # fn_owner_key_of_item — the item's DefId via fn_owner_key when the
    # resolver recorded one (def_id_of_item), else the module-path-qualified
    # name key "module::<full path>::<name>". One semantic callable -> one
    # DefId -> one owner key across all three consumers (a divergent key
    # would break parameter-binding and finalize-plan lookups). The fallback
    # is module-qualified because module_path is the item's FULL owner path:
    # threaded from resource_check's Program.modules walk for top-level
    # items (item_idx >= 0) and appended level-by-level by the ItemModule
    # arm below for genuinely nested-module items (item_idx -1, unmerged
    # programs) — so same-named functions in different modules never
    # collide ("module::a::b::helper" vs "module::a::c::helper").
    let fn_key = fn_owner_key_of_item(program, &typed.resolutions, item_idx, module_path, f.name.clone())
    check_function(program, typed, env, ctx, &f, fn_key, item_callable(typed, item_idx), errors, finalize_plan, edges, blocks, &mut item_entry)
  when ItemKind::ItemStruct(s) then
    mut frame = res_frame_new()
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then check_expr(program, typed, env, ctx, &e, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut item_entry, &mut item_defer_chain)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      check_function(program, typed, env, ctx, &s.methods[i], item_owner_key(typed, item_idx, i), item_method_callable(typed, item_idx, i), errors, finalize_plan, edges, blocks, &mut item_entry)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut frame = res_frame_new()
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then check_expr(program, typed, env, ctx, &d, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut item_entry, &mut item_defer_chain)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
 # a trait-default finalizer body is recognized by
    # the TRAIT IDENTITY — the trait's registered TypeDef id vs the
    # LangItems drop_trait id (the builtin Drop trait's declaration identity;
    # a std re-declaration keeps the builtin id). No method-name inspection
    # (m.sig.name == "deinit"/"drop" is gone): the trait's `drop` declaration
    # is the Drop-trait method BY TRAIT IDENTITY, exactly as the checker's
    # impl registration classifies it.
    let trait_is_drop = match env.type_name_index.get(t.name.clone())
    when Option::Some(tn_idx) then
      if tn_idx >= 0 && tn_idx < env.type_list.len() then
        env.type_list[tn_idx].id.id == env.lang_items.drop_trait
      else
        false
      end
    when Option::None then false
    end
    mut i = 0
    while i < t.methods.len() do
      check_trait_method(program, typed, env, ctx, &t.methods[i], "trait::" + t.name.clone() + "::" + i.to_string(), Option::None, trait_is_drop, errors, finalize_plan, edges, blocks, &mut item_entry)
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      check_function(program, typed, env, ctx, &im.methods[i], item_owner_key(typed, item_idx, i), item_method_callable(typed, item_idx, i), errors, finalize_plan, edges, blocks, &mut item_entry)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
 # (verified): the nested-module fallback key ("module::<path>::<name>"
    # produced by fn_owner_key_of_item for item_idx -1) includes the FULL
    # module path. The check_item module_path param threads it: each
    # ItemModule level appends its OWN name to the path it received, so a
    # function two levels deep under module a is keyed
    # "module::a::b::helper" — never "module::a::helper" (one level short)
    # or "module::helper" (path lost). Same-named functions in DIFFERENT
    # nested modules therefore never collide. Item_idx -1 is safe: no
    # ResolvedNames.item_defs entry exists for it, so def_id_of_item
    # returns None and the module-path-qualified fallback is taken.
    var child_path = module_path.clone()
    child_path.push(m.name.clone())
    mut i = 0
    while i < m.items.len() do
      check_item(program, typed, env, ctx, &m.items[i], -1, errors, finalize_plan, edges, blocks, &child_path)
      i = i + 1
    end
  when ItemKind::ItemUse(_) then ()
  when ItemKind::ItemMacro(mac) then
    mut frame = res_frame_new()
    var cl_entry = Vec::new()
    check_block(program, typed, env, ctx, &mac.body, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut cl_entry, &mut item_defer_chain)
  when ItemKind::ItemTypeAlias(_) then ()
  when ItemKind::ItemConst(c) then
    mut frame = res_frame_new()
    check_expr(program, typed, env, ctx, &c.value, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut item_entry, &mut item_defer_chain)
  when ItemKind::ItemStatic(s) then
    mut frame = res_frame_new()
    check_expr(program, typed, env, ctx, &s.value, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut item_entry, &mut item_defer_chain)
  when ItemKind::ItemCapabilityDecl(_) then ()
  when ItemKind::ItemEffectDecl(_) then ()
  when ItemKind::ItemRationaleBlock(_) then ()
  when ItemKind::ItemEditionDecl(_) then ()
  when ItemKind::ItemExternBlock(ext) then
    mut frame = res_frame_new()
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        ()
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  end
end

def check_function(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, f: FunctionDecl, owner_key: String, callable: Option[CallableId], inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int]) -> Unit
  mut frame = res_frame_new()
  # The function's own defer-scope chain: empty at the function boundary, the
  # function body block pushes its key when check_block enters it.
  var defer_chain = Vec::new()
  let entry_ids = bind_params(env, typed, &f.params, &mut frame, owner_key, errors)
  # Contracts are checked at item level (never inside a loop), so their
  # expression checks use a fresh, function-local frontier.
  var fn_entry = Vec::new()
 # the function's CFG records (edges/blocks) are the PRE-BUILT
  # global list (build_typed_cfg recorded them BEFORE the state runs); the
  # state computation below ATTACHES the cleanup actions to the pre-built
  # edges by (kind, source) identity.
  mut i = 0
  while i < f.contracts.len() do
    check_expr(program, typed, env, ctx, &f.contracts[i].expr, &Vec::new(), &mut frame, errors, finalize_plan, edges, blocks, &mut fn_entry, &mut defer_chain)
    i = i + 1
  end
  # ONE destruction protocol: user hook (deinit sink or Drop::drop) may
  # inspect/mutate but never consume self or owned fields; the compiler then
  # destroys still-live owned fields exactly once. The subject is
  # COMPILER-OWNED: mark it DeinitSelf so the hook body cannot consume or
  # re-finalize it (the generated wrapper runs the user hook first, then the
  # structural field cleanup). `drop`'s subject is a non-owning `&mut self`
  # reference — mark_finalizer_self registers it too, so both hooks get
  # IDENTICAL ownership permissions.
 # (— the typed FinalizerKind): finalizer recognition
  # is the TYPED KIND — finalizer_kind_of_callable (the checker's
  # registration record, CallableId identity) — NEVER the source name
  # (f.name == "deinit"/"drop" is gone). A callable the checker never
  # registered as a finalizer answers NotFinalizer and gets no finalizer
  # protection (fail-closed: an unregistered finalizer can never become a
  # plan callable).
  let fk = match callable
  when Option::Some(cid) then finalizer_kind_of_callable(typed, &cid)
  when Option::None then FinalizerKind::NotFinalizer
  end
  if fk != FinalizerKind::NotFinalizer && entry_ids.len() > 0 then
    let self_span = if f.params.len() > 0 then f.params[0].span else Span { file: "", start: 0, end_pos: 0 } end
    let is_self_param = if f.params.len() > 0 then f.params[0].name == "self" else false end
    mark_finalizer_self(&mut frame, &entry_ids[0], self_span, is_self_param)
  end
  check_fn_body(program, typed, env, &mut ctx, &f.body, &mut frame, errors, finalize_plan, edges, blocks, current_loop_entry, &mut defer_chain)
 # the function's edge actions are serialized into the CleanupEdge
  # table ONCE per program (cleanup_edges_serialize at the end of
  # resource_check) — the String-keyed edge_cleanup map is are not part of the model.
  # The authoritative finalize plan is computed from the frame BEFORE
  # exit_scope erases locals that were created inside the function: exit_scope
  # forgets every non-entry local (so a `let r = R{}` body local would
  # disappear before the plan was recorded, leaving nothing to finalize).
  # The finalizer's own sink `self` is excluded (recursive re-finalization).
  # entry_ids are LocalId (frame-key domain); the plan's exclude value is
  # the raw Int the MIR-facing plan uses.
 # the exclusion is the DEINIT kind only (a DeinitMethod's subject is
  # the compiler-owned sink self, finalized by definition; a
  # DropTraitMethod's subject is the non-owning `&mut self` reference,
  # never in the frame's Sink/OwnedLocal set).
  let exclude_id = if fk == FinalizerKind::DeinitMethod && entry_ids.len() > 0 then entry_ids[0].id else -1 end
 # the function's own-scope defers (the body block scope — the
  # outermost defer scope of the function) populate FunctionCleanup.defers;
  # the function-end drops populate FunctionCleanup.drops. Recorded under
  # the SEMANTIC CallableId (Option::None — a no-DefId item — records
  # nothing; the MIR never lowers those).
  let fn_body_scope = match f.body
  when FnBody::FnBlock(b) then block_exit_key(&b)
  when _ then 0
  end
  record_finalize_plan(typed, &frame, callable, finalize_plan, exclude_id, fn_body_scope)
  exit_scope(&mut frame, &entry_ids, typed, errors)
  check_uninitialized_exit(&frame, typed, errors)
end

def check_trait_method(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, m: TraitMethod, owner_key: String, callable: Option[CallableId], trait_is_drop: Bool, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int]) -> Unit
  mut frame = res_frame_new()
  var defer_chain = Vec::new()
  let entry_ids = bind_params(env, typed, &m.sig.params, &mut frame, owner_key, errors)
  # Trait-default finalizer bodies get the SAME DeinitSelf protection as
  # impl/function bodies (one destruction protocol: the subject is
  # compiler-owned, the hook may inspect/mutate but never consume it).
 # (— the typed FinalizerKind): the trait-default
  # recognition is the TRAIT IDENTITY (trait_is_drop — the Drop-trait
  # LangItems id; the trait's drop declaration is the finalizer BY TRAIT
  # IDENTITY, the same classification the checker's impl registration
  # records). A trait default in a NON-Drop trait gets no finalizer
  # protection — a name-only "deinit"-default courtesy is not recognized
  # (identity is the only authority).
  let t_fk = if trait_is_drop then FinalizerKind::DropTraitMethod else FinalizerKind::NotFinalizer end
  if t_fk != FinalizerKind::NotFinalizer && entry_ids.len() > 0 then
    let self_span = if m.sig.params.len() > 0 then m.sig.params[0].span else Span { file: "", start: 0, end_pos: 0 } end
    let is_self_param = if m.sig.params.len() > 0 then m.sig.params[0].name == "self" else false end
    mark_finalizer_self(&mut frame, &entry_ids[0], self_span, is_self_param)
  end
  check_fn_body(program, typed, env, ctx, &m.default_body, &mut frame, errors, finalize_plan, edges, blocks, current_loop_entry, &mut defer_chain)
 # the trait method's edge actions are serialized into the
  # CleanupEdge table once per program (see check_function).
  # Record the plan before exit_scope erases body-owned locals (see
 # check_function). trait-default bodies are never lowered by the
  # MIR and carry no resolver CallableId — no semantic cleanup record is
  # produced (the former "trait::<name>::<i>" String key was never
  # consumed).
 # the DeinitMethod-kind exclusion (the sink-self finalizer) does not
  # apply to trait defaults — the Drop-trait method's subject is the
  # non-owning `&mut self` reference, never a Sink/OwnedLocal frame entry.
  let exclude_id2 = -1
  let trait_body_scope = match m.default_body
  when FnBody::FnBlock(b) then block_exit_key(&b)
  when _ then 0
  end
  record_finalize_plan(typed, &frame, callable, finalize_plan, exclude_id2, trait_body_scope)
  exit_scope(&mut frame, &entry_ids, typed, errors)
  check_uninitialized_exit(&frame, typed, errors)
end

# the authoritative finalize set for a function — locals still Live
# in the final frame whose permission is Sink or OwnedLocal. Let/Inout
# params are caller-owned (never finalized by the callee); the deinit
# method's own sink self is excluded here because a deinit finalizes its
# subject by definition (the MIR side handles that special case when
# emitting the finalizer). The record is the SEMANTIC FunctionCleanup under
# the callable's CallableId (drops: the function-end LocalIds; defers: the
# function's own outermost scope's registered DeferIds — the function body
# block scope, read from the scope table at record time). Option::None
# callable (a no-DefId item) records nothing.
def record_finalize_plan(typed: TypedProgram, frame: ResFrame, callable: Option[CallableId], inout finalize_plan: FunctionCleanupTable, exclude_id: Int, fn_body_scope: Int) -> Unit
  match callable
  when Option::Some(cid) then
    var ids = Vec::new()
    # Frame keys are LocalId; the plan's drops are the SEMANTIC LocalIds the
    # MIR consumes — extracted at this boundary (no raw-Int plan values).
    for (id, ls) in frame.locals do
      if id.id != exclude_id then
        if ls.availability == ResourceState::Live then
          if ls.origin == ParamOrigin::Sink || ls.origin == ParamOrigin::OwnedLocal then
            ids.push(id)
          end
        end
      end
    end
    var defers = Vec::new()
    if fn_body_scope != 0 then
      match finalize_plan.scope_defers.get(ScopeId { id: fn_body_scope })
      when Option::Some(ds) then
        for d in ds do
          defers.push(d)
        end
      when Option::None then ()
      end
    end
    finalize_plan.by_callable.insert(cid, FunctionCleanup { defers: defers, drops: ids })
  when Option::None then ()
  end  end
end

# the closure-body finalize set — the SEMANTIC record under the
# closure expression's NodeId (the "closure::<node id>" String-key protocol). The closure body is a function-like scope; its end-frame drops
# are recorded the same way (the closure env/params are the entry locals).
def record_closure_cleanup(typed: TypedProgram, frame: ResFrame, closure_node_id: Int, inout finalize_plan: FunctionCleanupTable) -> Unit
  var ids = Vec::new()
  for (id, ls) in frame.locals do
    if ls.availability == ResourceState::Live then
      if ls.origin == ParamOrigin::Sink || ls.origin == ParamOrigin::OwnedLocal then
        ids.push(id)
      end
    end
  end
  finalize_plan.closure_cleanup.insert(NodeId { id: closure_node_id }, FunctionCleanup { defers: Vec::new(), drops: ids })
end

# the String-keyed edge serialization — cfg_edge_kind_name,
# edge_action_ids, and record_edge_cleanup_plan (the "edge::<kind>::<source>"
# edge_cleanup map) are REMOVED with the compatibility layer they served.
# The MIR consumes the CleanupEdge table (cleanup_edges_serialize) instead.
# The function-end plan (keyed by the fn owner key) is NOT a CFG edge record
# — it is the cleanup attached to every function exit (each Return edge and
# the implicit-return fallthrough), serialized once per function.

# THE ONE canonical ownership predicate (engine-backed): a local owns state
# / cannot be bit-copied without transfer iff the engine's concrete-type
# bundle says owns_state or is_linear (type_properties_of on the CONCRETE
# type — Wrapper[Int] and Wrapper[File] are distinct cache entries; String
# answers owns_state=true — the resource-checking axis — AND
# requires_drop_glue=true since — the real String destructor).
# This replaces the former parallel walks
# (type_kind_contains_resource / is_owning_smart_pointer /
# is_owning_container / named_viral_owns / checker_type_props_walk): one
# query, one authority — the types.tg engine.
# Everything ownership-sensitive (binding, transfer/move detection, Rc
# payload policy, assignment) uses THIS predicate, never a special case.
# (the generic ownership policy — the DEFERRAL half of the contract): a
# Param-carrying type answers is_deferred=true with the six semantic fields
# non-authoritative, and this predicate answers false ("not DECIDED
# owning") — the checker DELAYS the Param-position ownership decision. The
# delay is sound because the finalize plan (record_finalize_plan) includes
# only Sink/OwnedLocal Live locals and NEVER fabricates a drop for a
# deferred position (the DeinitPlan::Deferred marker fails closed at any
# MIR emission attempt); a fail-closed answer here would REJECT legal
# generic patterns whose concrete move semantics the post-mono verifier
# sanctions (an unconstrained let param returned by move — e.g. std's
# Option::unwrap_or / Result::unwrap_or — the MirMove(MirCopy) move form is
# exempt). The DECISION points never fail open: the MIR Copy verifier
# answers deferred = NOT copyable, and the drop-glue axis answers
# DeinitPlan::Deferred — never Trivial.
def is_owning_typed(inout env: TypeEnv, ty: Type) -> Bool
  let p = type_properties_of(env, ty)
  p.owns_state || p.is_linear
end

# A type that cannot safely sit behind shared ownership: the
# engine's LINEAR answer on the concrete type — resources/capabilities
# (linear by kind) and the move-only owners (Box/UniquePtr). Deliberately
# NARROWER than is_owning_typed: a destructible-but-shareable value such
# as Vec[Int] is coherent as Rc[Vec[Int]] (the last release destroys the
# payload), and Rc/WeakRc/ArcStrong/WeakArc are drop-only, never linear
# (the corrected engine's smart-pointer arm: Box/UniquePtr the only linear
# owners). The Rc-payload policy below still rejects Rc[File] and
# Rc[UniquePtr[..]] through the PAYLOAD's own linear answer.
def is_non_shareable_type(inout env: TypeEnv, ty: Type) -> Bool
  let p = type_properties_of(env, ty)
  p.is_linear
end

# Rc[Resource] is explicitly unsupported: a linear resource cannot be shared
# through reference counting (documented ownership policy). Reject the
# combination at every binding point instead of silently treating the Rc
# wrapper as non-resource and losing the contained resource's state. The
# payload policy uses is_non_shareable_type: Rc[UniquePtr[Int]] is rejected
# (a move-only owner behind shared ownership), while Rc[Vec[Int]] is allowed
# (destructible-but-shareable — the last release destroys the payload).
# (, consumed): the Rc selection keys off the
# LangItems rc id — the snapshot env's lang_items.rc, the ENGINE's own
# identity selection (type_named_props id-selects Rc the same way). The
# former registered-name fallback is are not part of the model: a snapshot missing the
# rc id (-1 — never for the registered builtin) fails CLOSED — no
# name comparison ever selects the Rc ownership policy.
def reject_rc_resource(inout env: TypeEnv, typed: TypedProgram, ty: Type, span: Span, inout errors: Vec[ResourceError]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    let rc_id = env.lang_items.rc
    if rc_id != -1 && tid.id == rc_id && args.len() >= 1 then
      reject_rc_payload(env, typed, &args[0], span, errors)
    end
  when _ then ()
  end  end
end

# phase-2C: the shared Rc-payload rejection (the Adt form of Rc
# dispatches here): the payload must be shareable.
def reject_rc_payload(inout env: TypeEnv, typed: TypedProgram, inner: Type, span: Span, inout errors: Vec[ResourceError]) -> Unit
  if is_non_shareable_type(env, inner) then
    errors.push(ResourceError {
      message: "Rc[Resource] is unsupported: a linear resource cannot be shared through reference counting",
      span: span
    })
  end
end

def bind_params(inout env: TypeEnv, typed: TypedProgram, params: Vec[Param], inout frame: ResFrame, owner_key: String, inout errors: Vec[ResourceError]) -> Vec[tg_compiler::ids::LocalId]
  mut out = Vec::new()
  mut i = 0
  while i < params.len() do
    # The parameter local ids are looked up by (DefId owner key, index) in
    # the typed parameter map — never by a span offset or an arithmetic
    # encoding that could collide with pattern node ids or across files.
    match bind_param(env, typed, &params[i], frame, owner_key, i, errors)
    when Option::Some(id) then out.push(id)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

def param_origin_of(convention: AccessConvention) -> ParamOrigin
  match convention
  when AccessConvention::Let then ParamOrigin::Let
  when AccessConvention::Inout then ParamOrigin::Inout
  when AccessConvention::Sink then ParamOrigin::Sink
  when AccessConvention::Set then ParamOrigin::Set
  when _ then ParamOrigin::Let
  end  end
end

def bind_param(inout env: TypeEnv, typed: TypedProgram, p: Param, inout frame: ResFrame, owner_key: String, index: Int, inout errors: Vec[ResourceError]) -> Option[tg_compiler::ids::LocalId]
  match typed.param_binding_resolutions.get(owner_key)
  when Option::Some(ids) then
    if index < ids.len() then
      match typed.local_bindings.get(ids[index])
      when Option::Some(lb) then
        let id = ids[index]
 # boundary: the typed parameter map is Int-keyed (semantic local
        # ids); the frame is LocalId-keyed. The id crosses into the frame
        # only as a constructed LocalId, so it can never collide with a
        # pattern node id at the frame's key type.
        let lid = tg_compiler::ids::LocalId { id: id }
        # Rc[Resource] is an unsupported combination (a linear resource
        # cannot be shared through reference counting): reject it at the
        # binding point rather than silently treating it as non-resource.
        reject_rc_resource(env, typed, &lb.ty, p.span, errors)
        # EVERY parameter is registered in the frame — including inout (which
        # previously escaped resource-state checking entirely). The permission
        # dimension (origin) is tracked separately from availability so that
        # let/inout params can never be consumed or finalized by the callee,
        # while sink params own their value.
        let origin = param_origin_of(p.convention)
        if is_owning_typed(env, &lb.ty) then
          let init_state = match p.convention
          when AccessConvention::Set then ResourceState::Uninitialized
          when _ then ResourceState::Live
          end
          res_frame_set(frame, lid, init_state)
          res_frame_set_span(frame, &lid, p.span)
          res_frame_set_origin(frame, &lid, origin)
        end
        if type_kind_contains_capability(env, &lb.ty) then
          res_frame_mark_cap(frame, &lid)
        end
        Option::Some(lid)
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when Option::None then Option::None
  end  end
end

def check_fn_body(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, body: FnBody, inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match body
  when FnBody::FnBlock(b) then run_fn_block_worklist(program, typed, env, ctx, &b, &Vec::new(), frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when FnBody::FnExpr(e) then
    check_expr(program, typed, env, ctx, &e, &Vec::new(), frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    transfer_consume(env, typed, &e, &Vec::new(), frame, errors, finalize_plan)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end
  # IMPLICIT-return postconditions: set params must be exactly Live, and
 # live capabilities must have been transferred/consumed.
  let fn_end_span = match body
  when FnBody::FnBlock(b) then if b.stmts.len() > 0 then b.stmts[b.stmts.len() - 1].span else Span { file: "", start: 0, end_pos: 0 } end
  when _ then Span { file: "", start: 0, end_pos: 0 }
  end
  validate_set_postconditions(typed, frame, fn_end_span, errors)
  validate_capability_exit(typed, frame, fn_end_span, errors)
 # the CFG MODEL VALIDATION (structural soundness — valid
  # endpoints, well-formed actions, block/kind consistency, block-frame
  # grounding) runs ONCE per program over the whole pre-built CFG at the
  # end of resource_check (validate_cfg_edges) — the per-function
  # invocation is gone with the per-function edge lists.  end
end

# the FUNCTION-BODY ENTRY through the BLOCK WORKLIST — the
# function-level block flow over the PRE-BUILT CfgBlock records. The
# function's top-level block list is computed from the records the
# structural pass built for this function body (the body's own CfgBlock
# record, id = the body's first-statement node id — the SAME key check_block
# executes the body under); a block whose ENTRY state changed is processed
# (the full per-block machinery: run_cfg_block over the block's statements
# under the block's entry frame — the (entry, exit) block frames recorded
# under the block's id as before, the Normal-edge obligation, the scope
# exit), and its SUCCESSORS' entry states join its exit state. The join is
# merge_frames — the existing branch-join logic REUSED as-is (the
# per-local availability meet: Live ∩ Live = Live, divergent availabilities
# collapse to MaybeLive); res_frame_equal is the change detector, and a
# successor whose entry changed is re-processed.
# The per-statement/per-expression recursion (check_stmt -> check_expr /
# check_if / check_match / check_loop / check_loop_body / check_for) is
# UNCHANGED: it executes every NESTED block (branch blocks, match arms,
# loop bodies, defer bodies) under its own key with the pre-branch entry
# frame. Those records are NOT part of the top-level universe — the
# successor join is guarded to the universe — so the worklist never
# double-executes a nested block (a second run would re-consume its
# resources and duplicate its diagnostics).
# The structural pass records exactly one CfgBlock per lexical block (plus
# the statement-level IF-JOIN records — one per if, synthetic id allocated
# from cfg_synthetic_alloc with the condition's node id as its origin — a
# negative id that is never a top-level block key), so
# the top-level universe is the body record ALONE: the worklist degenerates
# to the single body run — the entry block executes exactly once against
# the function-entry frame, byte-identical to the former check_block path —
# and no successor join fires (the body record's edges leave the universe:
# the True/False splits into the branch records, the Normal/terminator
# edges to the function exit). Pending is seeded with the body key and is
# only ever re-seeded from the join with a universe member — provably the
# body key — so the worklist terminates after one iteration. If the
# structural pass ever split the function body into several top-level
# records, the records would need statement-list access (CfgBlock records
# carry only id + origin + edge indices; the function-level driver holds only the
# body's statements) — that is the integration point that would need the
# structural pass to expose per-record statements.
def run_fn_block_worklist(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, block: Block, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  # The top-level basic-block driver: the function body's statements are
  # partitioned into top-level blocks at the control-flow statements (the
  # SAME partition the structural pass cfg_top_blocks used — the block ids
  # align); each block executes through the per-block machinery
  # (run_cfg_block over the block's statement slice against its ENTRY frame
  # — the join of the predecessor blocks' exits); the top-level blocks
  # SHARE the function's lexical scope (the defer scope push/pop and the
  # scope-exit obligations apply once, at the function level); the
  # continuation edges (the linear Normal edges the structural pass
  # recorded between the top-level blocks) drive the successor joins.
  let (starts, ends) = top_block_ranges(&block.stmts)
  if starts.len() == 0 then
    # empty body: the structural pass recorded no blocks — nothing to drive.
    return
  end
  let blk_key = block_exit_key(block)
  # the function-level lexical scope
  let entry_names = res_frame_names_clone(frame)
  let view_keys_at_entry = slice_views_snapshot_keys(ctx)
  if blk_key != 0 then
    defer_chain.push(blk_key)
  end
  # the worklist state: per-block ENTRY frames (block id -> entry frame).
  # The entry block's entry frame is the function-entry frame.
  var entry_states: Map[Int, ResFrame] = Map::new()
  var pending = Vec::new()
  let first_key = block.stmts[starts[0]].node_id
  entry_states.insert(first_key, res_frame_clone(frame))
  pending.push(first_key)
  while pending.len() > 0 do
    match pending.pop()
    when Option::Some(key) then
      var bi = 0
      var found = false
      while bi < starts.len() do
        if block.stmts[starts[bi]].node_id == key then
          found = true
          break
        end
        bi = bi + 1
      end
      if found then
        match entry_states.get(key)
        when Option::Some(entry_f) then
          frame_assign(frame, &entry_f)
          # the block's statement slice
          var slice = Vec::new()
          var si = starts[bi]
          while si < ends[bi] do
            slice.push(block.stmts[si].clone())
            si = si + 1
          end
          let entry_frame = res_frame_clone(frame)
          let (exit_frame, _) = run_cfg_block(program, typed, env, ctx, &slice, loop_outer, &entry_frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain, key, Option::None)
          frame_assign(frame, &exit_frame)
          # the JOIN: the processed block's successors' entry states join
          # its EXIT state — the successors are the top-level blocks whose
          # ids are the destinations of the block's record's edges (the
          # linear continuation edges the structural pass recorded). The
          # nested records' entries are the statement recursion's domain.
          let exit_state = res_frame_clone(frame)
          var ri = 0
          while ri < blocks.len() do
            if blocks[ri].id == key then
              var ei = 0
              while ei < blocks[ri].edges.len() do
                let eidx = blocks[ri].edges[ei]
                if eidx < edges.len() then
                  let dest = edges[eidx].destination
                  if dest != 0 then
                    var in_universe = false
                    var ui = 0
                    while ui < starts.len() do
                      if block.stmts[starts[ui]].node_id == dest then
                        in_universe = true
                      end
                      ui = ui + 1
                    end
                    if in_universe then
                      match entry_states.get(dest)
                      when Option::Some(cur) then
                        var two = Vec::new()
                        two.push(res_frame_clone(&cur))
                        two.push(res_frame_clone(&exit_state))
                        let joined = merge_frames(&two)
                        if !res_frame_equal(&cur, &joined) then
                          entry_states.insert(dest, joined)
                          pending.push(dest)
                        end
                      when Option::None then
                        entry_states.insert(dest, res_frame_clone(&exit_state))
                        pending.push(dest)
                      end
                    end
                  end
                end
                ei = ei + 1
              end
            end
            ri = ri + 1
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  # the final top-level block's fallthrough obligations (the function's
  # Normal edge — the structural pass recorded it with source = the final
  # block's key; the plan uses the final block's own slice, whose recorded
  # frames are under the final block's key).
  let last_st = starts[starts.len() - 1]
  let last_en = ends[ends.len() - 1]
  let last_key = block.stmts[last_st].node_id
  if !block_ends_with_terminator_range(&block, last_st, last_en) then
    var last_slice = Vec::new()
    var li = last_st
    while li < last_en do
      last_slice.push(block.stmts[li].clone())
      li = li + 1
    end
    let final_block = Block { stmts: last_slice, span: block.span }
    let block_actions = record_block_exit_plan(ctx, typed, frame, &entry_names, &final_block, finalize_plan)
    if blk_key != 0 then
      attach_edge_actions(ctx, edges, CfgEdgeKind::Normal, last_key, block_actions, errors)
    end
  end
  if blk_key != 0 then
    defer_chain.pop()
  end
  exit_scope(frame, &entry_names, typed, errors)
  slice_views_remove_after(ctx, &view_keys_at_entry)
end


# validate_cfg_blocks — the CFG-block structural validation, the home of
# the P0 UNIQUENESS INVARIANT: the number of CfgBlock records == the
# number of unique CfgBlock ids. The block-id universe is disjoint BY
# CONSTRUCTION (the lexical records keep the positive statement node ids;
# the synthetic join/split records are allocated the negative ids from the
# run's cfg_synthetic_alloc counter — never reused), and this validation
# makes the property MACHINE-CHECKED on every resource_check run:
#   (1) the UNIQUENESS INVARIANT — every CfgBlock id is distinct (a
#       duplicate id means two flow segments share one identity — the
#       reviewer's collision class `for x in xs ... end; after()`: the
#       lexical block key and the for-loop's continuation id both derived
#       from the for stmt — which the allocator makes impossible, and
#       which this assertion would flag the moment it reappears);
#   (2) the ALLOCATOR'S DOMAIN DISCIPLINE — every synthetic (negative) id
#       is a join/split record with a non-zero origin, and every join
#       (non-zero origin) carries a synthetic id: the synthetic ids never
#       collide with the statement ids (positive) by construction;
#   (3) every edge DESTINATION != 0 names a CfgBlock record — the join
#       targets (the negative synthetic destinations included) and the
#       block-key targets must all resolve.
def validate_cfg_blocks(blocks: Vec[CfgBlock], edges: Vec[CfgEdge], inout errors: Vec[ResourceError]) -> Unit
  # (1) THE UNIQUENESS INVARIANT — records == unique ids (duplicate
  # detection over the whole CFG; the block_frames map is keyed by these
  # very ids, so a duplicate would silently alias two blocks' states).
  var seen = Set::new()
  var dup_count = 0
  mut bi = 0
  while bi < blocks.len() do
    let bid = blocks[bi].id
    if seen.contains(bid) then
      dup_count = dup_count + 1
      errors.push(ResourceError {
        message: "internal error: duplicate CfgBlock id " + bid.to_string() + " (the block-id universe is not disjoint — two CFG blocks share one identity)",
        span: Span { file: "", start: 0, end_pos: 0 }
      })
    else
      seen.insert(bid)
    end
    bi = bi + 1
  end
  if seen.len() != blocks.len() then
    errors.push(ResourceError {
      message: "internal error: " + blocks.len().to_string() + " CfgBlock records but " + seen.len().to_string() + " unique CfgBlock ids (" + dup_count.to_string() + " duplicates — the uniqueness invariant failed)",
      span: Span { file: "", start: 0, end_pos: 0 }
    })
  end
  # (2) the allocator's domain discipline — the negative synthetic domain
  # is reserved for the joins/splits (origin != 0), the positive
  # statement-id domain for the lexical records (origin == 0).
  mut bi2 = 0
  while bi2 < blocks.len() do
    let b2 = blocks[bi2]
    if b2.id < 0 && b2.origin == 0 then
      errors.push(ResourceError {
        message: "internal error: synthetic CfgBlock id " + b2.id.to_string() + " has no origin — a non-join block was allocated a synthetic id",
        span: Span { file: "", start: 0, end_pos: 0 }
      })
    end
    if b2.origin != 0 && b2.id >= 0 then
      errors.push(ResourceError {
        message: "internal error: join CfgBlock with origin " + b2.origin.to_string() + " was not allocated a synthetic id (id " + b2.id.to_string() + " is in the statement-id domain)",
        span: Span { file: "", start: 0, end_pos: 0 }
      })
    end
    bi2 = bi2 + 1
  end
  # (3) every edge destination != 0 names a CfgBlock record — the
  # branch fallthroughs and the loop's exit edge target the synthetic
  # join ids; the continuation edges and the break/continue/backedge
  # edges target the block keys / loop-body keys.
  var ei = 0
  while ei < edges.len() do
    let dest = edges[ei].destination
    if dest != 0 then
      var named = false
      var ri = 0
      while ri < blocks.len() do
        if blocks[ri].id == dest then
          named = true
        end
        ri = ri + 1
      end
      if !named then
        errors.push(ResourceError {
          message: "internal error: resource-check CFG edge targets block id " + dest.to_string() + " that no CfgBlock record carries",
          span: Span { file: "", start: 0, end_pos: 0 }
        })
      end
    end
    ei = ei + 1
  end
end


def validate_cfg_edges(ctx: AnalysisContext, typed: TypedProgram, finalize_plan: FunctionCleanupTable, edges: Vec[CfgEdge], blocks: Vec[CfgBlock], block_frames: Map[Int, (ResFrame, ResFrame)], inout errors: Vec[ResourceError]) -> Unit
  mut i = 0
  while i < edges.len() do
    let e = edges[i]
    # the edge SOURCES are semantic node ids (statement ids and
    # if/elsif condition ids) — always positive; a negative source is
    # invalid. The edge DESTINATIONS are the block keys / the loop-body
    # keys (positive) or the SYNTHETIC join ids (negative — the allocated
    # continuation targets, e.g. the branch fallthroughs into the if-join
    # or the while's False edge into the while-join); the negative
    # destinations are checked against the CfgBlock records by
    # validate_cfg_blocks (every non-zero destination must name a record).
    if e.source < 0 then
      errors.push(ResourceError {
        message: "internal error: resource-check CFG edge has an invalid source",
        span: Span { file: "", start: 0, end_pos: 0 }
      })
    end
 # every action must be a well-formed cleanup step: Drop with a
    # valid local id (a typed local binding), RunDefer with a registered
    # defer stmt id, EndAccess with a registered access id (the shared
    # ACCESS_REGISTRY — populated by the access checker's CFG walk).
    var ai = 0
    while ai < e.actions.len() do
      let act = e.actions[ai]
      match act
      when CleanupAction::Drop(lid) then
        if !typed.local_bindings.contains_key(lid.id) then
          errors.push(ResourceError {
            message: "internal error: resource-check CFG edge drops a local that is not a typed local binding",
            span: Span { file: "", start: 0, end_pos: 0 }
          })
        end
      when CleanupAction::RunDefer(nid) then
        if !is_registered_defer(finalize_plan, nid.id) then
          errors.push(ResourceError {
            message: "internal error: resource-check CFG edge runs a defer that was never registered",
            span: Span { file: "", start: 0, end_pos: 0 }
          })
        end
      when CleanupAction::EndAccess(aid) then
        if !access_registry_has(ctx, &aid) then
          errors.push(ResourceError {
            message: "internal error: resource-check CFG edge ends an access that was never registered",
            span: Span { file: "", start: 0, end_pos: 0 }
          })
        end
      end
      ai = ai + 1
    end
    match e.kind
    when CfgEdgeKind::Break then
      if e.destination == 0 then
        errors.push(ResourceError {
          message: "internal error: break edge recorded outside a loop context",
          span: Span { file: "", start: 0, end_pos: 0 }
        })
      end
    when CfgEdgeKind::Continue then
      if e.destination == 0 then
        errors.push(ResourceError {
          message: "internal error: continue edge recorded outside a loop context",
          span: Span { file: "", start: 0, end_pos: 0 }
        })
      end
    when CfgEdgeKind::Backedge then
      if e.destination == 0 then
        errors.push(ResourceError {
          message: "internal error: backedge edge recorded outside a loop context",
          span: Span { file: "", start: 0, end_pos: 0 }
        })
      end
    when _ then ()
    end
    i = i + 1
  end
  mut j = 0
  while j < edges.len() do
    if edges[j].kind == CfgEdgeKind::Normal then
      let nsrc = edges[j].source
      mut k = j + 1
      while k < edges.len() do
        if edges[k].kind == CfgEdgeKind::Normal && edges[k].source == nsrc then
          errors.push(ResourceError {
            message: "internal error: a block has more than one Normal CFG successor",
            span: Span { file: "", start: 0, end_pos: 0 }
          })
          break
        end
        k = k + 1
      end
    end
    j = j + 1
  end
 # block-level consistency. Each CfgBlock references its originating
  # edges by index; the referenced edges must exist, and their kinds must be
  # consistent with the block's role (terminal vs fallthrough) and the
  # loop-body origin of its backedges.
  mut bi = 0
  while bi < blocks.len() do
    let b = blocks[bi]
    var has_normal = false
    var has_term = false
    mut ei = 0
    while ei < b.edges.len() do
      let eidx = b.edges[ei]
      if eidx < 0 || eidx >= edges.len() then
        errors.push(ResourceError {
          message: "internal error: resource-check CFG block references an invalid edge index",
          span: Span { file: "", start: 0, end_pos: 0 }
        })
      else
        let be = edges[eidx]
        match be.kind
        when CfgEdgeKind::Normal then
          # A Normal edge is a fallthrough: the block that references it is
          # a fallthrough block — it must not also terminate.
          has_normal = true
        when CfgEdgeKind::Return then
          # A Return edge is terminal: the block that references it ends in
          # the return — it never falls through.
          has_term = true
        when CfgEdgeKind::Break then
          has_term = true
        when CfgEdgeKind::Continue then
          has_term = true
        when CfgEdgeKind::Backedge then
          # A Backedge originates in a loop body: it must name the loop
          # body's block key (destination), never the dynamic target 0.
          if be.destination == 0 then
            errors.push(ResourceError {
              message: "internal error: resource-check CFG block references a backedge recorded outside a loop body",
              span: Span { file: "", start: 0, end_pos: 0 }
            })
          end
        when _ then ()
        end
      end
      ei = ei + 1
    end
    if has_normal && has_term then
      errors.push(ResourceError {
        message: "internal error: resource-check CFG block references both a fallthrough Normal edge and a terminator edge",
        span: Span { file: "", start: 0, end_pos: 0 }
      })
    end
    bi = bi + 1
  end
 # block-exit-frame grounding of the drop actions. For each
  # block-originating edge (kind Normal/Return/Break/Continue), every
  # kind-0 (drop local) action id must be in the block-grounded derivation
  # from its SOURCE block's exit frame — the locals live at the exit the
  # edge exits, per the edge kind's scope-exit frontier
  # (block_grounded_drop_ids — the documented authority; the statement-
  # level recording produces the same sets). A drop of a local not live at
  # the source block's exit is an inconsistency.
  #   - Normal: the edge exits the block's OWN scope — the derivation
  #     excludes the entry frame's keys (the pre-existing locals, exactly
  #     the entry_names record_block_exit_plan filters). Its source block
  #     is the lexical block's flow block 0, whose exit frame is the
  #     lexical end frame the Normal edge's drops were recorded from — the
  #     equivalence is exact.
  #   - Return: the edge exits EVERY scope — no frontier filter.
  #   - Break/Continue: the edge exits the LOOP's scope — the recording
  #     site applied the loop-entry exclude (current_loop_entry, the
  #     locals predating the loop, which survive the edge). That exclude
  #     is a recording-site frontier block_frames cannot recover, so the
  #     check runs the derivation WITHOUT the loop-exclude — a superset of
  #     the recorded actions (the frontier only REMOVES locals), so the
  #     subset check is exactly the direction the recording can violate
  #     (a drop of a local not live at the exit stays a violation).
  # Edges excluded here by kind: GuardElse (the edge exits at the GUARD
  # point, not the block end — later Linear statements can consume the
  # guard-point live set, so the block exit frame is not its frame) and
 # True/False (no obligations of their own). loop-body-originated
  # edges (break/continue/return inside the body) are FULLY covered — the
  # loop body's block record has a recorded (entry, exit) frame (the body
  # executes through the same run_cfg_block traversal), so the grounded
  # check applies to every body-originated edge, exactly like any lexical
  # block's.
  # Defer bodies' OWN locals (is_defer_local) are the documented exception:
  # they drop when the deferred code RUNS, outside the exiting block's
  # frame.
  var no_exclude = Vec::new()
  var gi = 0
  while gi < edges.len() do
    let e = edges[gi]
    var grounded = false
    match e.kind
    when CfgEdgeKind::Normal then grounded = true
    when CfgEdgeKind::Return then grounded = true
    when CfgEdgeKind::Break then grounded = true
    when CfgEdgeKind::Continue then grounded = true
    when _ then ()
    end
    if grounded then
      let src_block = edge_source_block_index(blocks, gi)
      if src_block >= 0 then
        let bid = blocks[src_block].id
        match block_frames.get(&bid)
        when Option::Some(bf_pair) then
          let (frame_entry, frame_exit) = bf_pair
          # Normal edges exit the block's own scope: exclude the entry
          # frame's keys (the pre-existing locals). Return and Break/
          # Continue exit every scope / the loop's scope: no entry filter
          # (the loop-entry exclude of the recording site is documented
          # above; the derivation without it is a superset of the recorded
          # actions, so the subset check below still holds).
          var exclude_entry = false
          match e.kind
          when CfgEdgeKind::Normal then exclude_entry = true
          when _ then ()
          end
          let grounded_drops = block_grounded_drop_ids(&frame_entry, &frame_exit, exclude_entry, &no_exclude)
          var ai2 = 0
          while ai2 < e.actions.len() do
            let act2 = e.actions[ai2]
            match act2
            when CleanupAction::Drop(lid) then
              if !is_defer_local(finalize_plan, lid.id) then
                if !grounded_drops.contains(&lid.id) then
                  errors.push(ResourceError {
                    message: "internal error: resource-check CFG edge drops a local not live at the source block's exit frame",
                    span: Span { file: "", start: 0, end_pos: 0 }
                  })
                end
              end
            when _ then ()
            end
            ai2 = ai2 + 1
          end
        when Option::None then ()
        end
      end
    end
    gi = gi + 1
  end
end

# a defer action's id (a StmtDefer node id) is valid iff some
# ScopeId-keyed scope_defers entry of the SEMANTIC cleanup table registered
# it (register_defer records defer STMT ids as DeferId values under the
# scope's ScopeId; the scope_defer_locals entries carry LOCAL ids and are
# never consulted here). The prefix-parsing defer-key protocol is are not part of the model.
def is_registered_defer(finalize_plan: FunctionCleanupTable, defer_id: Int) -> Bool
  var found = false
  for (_, v) in finalize_plan.scope_defers do
    if !found then
      var vi = 0
      while vi < v.len() do
        if v[vi].id == defer_id then
          found = true
        end
        vi = vi + 1
      end
    end
  end
  found
end

# THE BLOCK-GROUNDED drop obligation of an exiting edge — the
# documented AUTHORITY behind the edge model's drop-local actions. For the
# edge's source block (the CfgBlock record referencing the edge), the
# locals the edge drops are exactly the Live Sink/OwnedLocal locals of the
# block's EXIT frame (the post-statement frame the edge exits), filtered by
# the edge kind's scope-exit frontier:
#   - Normal    — the block's OWN scope: `exclude_entry` excludes the
#                 entry frame's keys — the pre-existing locals (exactly the
#                 entry_names record_block_exit_plan filters) — so only the
#                 locals created in the block drop on the fallthrough;
#   - Return    — EVERY scope: no frontier (exclude_entry false, an empty
#                 loop_exclude) — every live owning local drops on the
#                 function exit;
#   - Break/Continue — the LOOP's scope: `loop_exclude` carries the
#                 recording-site loop-entry exclude (current_loop_entry —
#                 the locals that predate the loop and survive the edge).
# The statement-level recording (record_block_exit_plan /
# record_exit_edge_plan) produces the SAME sets: the recording frame IS the
# block exit frame — a terminator-ending flow block's exit frame is the
# post-terminator frame the terminator's plan was recorded from, and the
# Normal edge's recording frame is the flow's merged tail, which for the
# single-flow-block lexical block is the exit frame recorded for flow
# block 0 — and the same frontier filters apply (the loop-entry exclude of
# the recording site). The block-grounded derivation is therefore THE
# AUTHORITY (the semantic contract of what an edge drops); the statement-
# level recording remains the byte-identical EMISSION path — the
# finalize_plan string-key values still derive from the recorded edge
# actions (edge_action_ids), which this derivation documents as equal to
# what the block frames imply. validate_cfg_edges checks the recorded
# actions against this derivation. Defer bodies' OWN locals (the
# "defer_locals::<scope key>" plans) are a documented exception: they drop
# when the deferred code RUNS, outside the exiting block's frame — the
# derivation covers only the block frame's locals (is_defer_local flags
# the exception in the validation).
# the block frames are now the PRIMARY computation, not an additive
# record: run_cfg_block executes each block against its entry frame
# and captures the (entry, exit) pair; the recording sites
# READ the recorded frames — record_block_exit_plan's Normal derivation
# looks them up via block_frames_get, the terminator recording sites call
# this derivation with the exit frame (identical to the recorded exit at
# the terminator point), and verify_terminator_edge_grounding reconciles
# every block-originating Return/Break/Continue edge against the recorded
# (entry, exit) — the values stay byte-identical.
def block_grounded_drop_ids(entry: ResFrame, exit: ResFrame, exclude_entry: Bool, loop_exclude: Vec[Int]) -> Vec[Int]
  var ids = Vec::new()
  for (id, ls) in exit.locals do
    if ls.availability == ResourceState::Live then
      if ls.origin == ParamOrigin::Sink || ls.origin == ParamOrigin::OwnedLocal then
        if !loop_exclude.contains(&id.id) then
          if exclude_entry then
            if !entry.locals.contains_key(&id) then
              ids.push(id.id)
            end
          else
            ids.push(id.id)
          end
        end
      end
    end
  end
  ids
end

# the index of the CfgBlock record that references the edge — its
# SOURCE block (the flow block whose exit frame the edge exits) — or -1
# when no record references it. the structural pass records a
# CfgBlock for EVERY control-flow decision (flow blocks, expression-split
# blocks for ExprIf, loop-body flow blocks), so a block-originating edge
# (Normal/Return/Break/Continue/GuardElse/Backedge) always has a record;
# -1 remains only as the defensive miss path. attach_block_cfg_record
# attributes each edge to at most one block (the edge's source id is in
# exactly one flow block's originating-ids range — statement ranges are
# disjoint and node ids are globally unique), so the first hit is
# unambiguous.
def edge_source_block_index(blocks: Vec[CfgBlock], edge_index: Int) -> Int
  mut bi = 0
  while bi < blocks.len() do
    if blocks[bi].edges.contains(&edge_index) then
      return bi
    end
    bi = bi + 1
  end
  -1
end

# is the id a DEFER BODY's OWN local — the documented exception to
# the block-exit-frame grounding? register_defer records the defer bodies'
# own binding ids as LocalId values under the scope's ScopeId in
# scope_defer_locals; those locals are finalized when the deferred code
# RUNS (outside the exiting block's frame), so they legitimately drop on
# the scope's exiting edges without ever being in the exiting block's
# frame. The "defer_locals::<scope key>" prefix-parsing protocol is are not part of the model — the table scan is the semantic membership test.
def is_defer_local(finalize_plan: FunctionCleanupTable, local_id: Int) -> Bool
  var found = false
  for (_, v) in finalize_plan.scope_defer_locals do
    if !found then
      var vi = 0
      while vi < v.len() do
        if v[vi].id == local_id then
          found = true
        end
        vi = vi + 1
      end
    end
  end
  found
end

# The PER-BLOCK statement execution — the PRIMARY
# computation of the resource dataflow, running entirely over the
# PRE-BUILT TypedCFG block records (the worklist execution
# worklist collapsed to exactly this: the flatten machinery produced ONE
# flow block per lexical block, so the fixed-point worklist executed the
# block's statements once against its entry frame). One CfgBlock's
# statements execute against the block's ENTRY frame (frame_in) and
# produce the block's EXIT frame as the result — the scope-exit frontier
# the block's originating edges' obligations derive from. The (entry,
# exit) pair is RECORDED under the block record's id (record_block_frame
# — the same id the structural pass gave the CfgBlock record), the
# terminator edges originating in the block are reconciled against the
# recorded frames (verify_terminator_edge_grounding), and the statement-
# level recording (check_stmt / check_terminator_stmt) runs INSIDE this
# execution. Loop bodies and defer bodies execute through the SAME
# machinery (check_loop_body / check_defer_body call this function with
# their own block keys), so EVERY block — loop bodies included — gets a
# recorded exit frame and the grounding checks apply to every block.
# `scan` carries the per-statement loop-body checks (the projected-
# iteration escape guard and the projected-mutation scan) when the block
# is a for-loop body.
struct LoopBodyScan
  iter_binding_ids: Vec[Int]
  iter_reported: Vec[Bool]
  projected_root: Int
  projected_fields: Vec[String]
  reported_stmt_id: Int
end

def run_cfg_block(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, stmts: Vec[Stmt], loop_outer: Vec[Int], frame_in: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int], block_key: Int, scan: Option[LoopBodyScan]) -> (ResFrame, Option[LoopBodyScan])
  mut bf = res_frame_clone(frame_in)
  mut dead = false
  mut carried_scan = scan
  mut ni = 0
  while ni < stmts.len() do
    let node = stmts[ni]
    mut executed = false
    if stmt_is_terminator(&node) then
      if !dead then
        check_terminator_stmt(program, typed, env, ctx, &node, loop_outer, &mut bf, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
        dead = true
        executed = true
      end
    else
      if !dead then
        check_stmt(program, typed, env, ctx, &node, loop_outer, &mut bf, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
        executed = true
      end
    end
    if executed then
      match carried_scan
      when Option::Some(mut sc) then
 # the projected-iteration escape guard (reported once per
        # binding, the first statement after which the binding's state
 # became Consumed) and the projected-mutation scan (the
        # iterated collection cannot be mutated inside the loop body under
        # projected iteration), per loop-body statement — the loop-body
        # walk parity of the pre-CF2 per-statement scan.
        check_iter_binding_escape(typed, &sc.iter_binding_ids, &mut sc.iter_reported, &bf, node.span, errors)
        if sc.projected_root >= 0 && node.node_id != sc.reported_stmt_id then
          if plan_stmt_mutates_place(typed, &node, sc.projected_root, &sc.projected_fields) then
            sc.reported_stmt_id = node.node_id
            errors.push(ResourceError {
              message: "cannot mutate the iterated collection inside the loop body under projected iteration (the for-loop reads its storage by reference)",
              span: node.span
            })
          end
        end
        carried_scan = Option::Some(sc)
      when Option::None then ()
      end
    end
    ni = ni + 1
  end
 # / / capture this block's (entry, exit) frames into
  # the authoritative per-block state map, keyed by the block record's id
  # (the block's first-statement node id — the id the structural pass gave
  # the CfgBlock record). ENTRY is the frame the block was analyzed under;
  # EXIT is the post-statement frame — the scope-exit frontier the block's
  # originating edges' obligations derive from. The recording is the
  # PRIMARY computation: the statement-level sites produce the
  # byte-identical obligations FROM these frames (record_block_exit_plan's
  # recorded-frame lookup; verify_terminator_edge_grounding; the
  # validate_cfg_edges grounded check — which now covers EVERY block,
  # loop-body blocks included).
  if block_key != 0 then
    record_block_frame(ctx, block_key, res_frame_clone(frame_in), res_frame_clone(&bf))
  end
 # the reconciliation — the terminator edges that originate in
  # this block (recorded at the terminator point, whose frame IS the block
  # exit frame) must equal the derivation from the RECORDED (entry, exit)
  # frames above — the block frames are the authority the edge obligations
  # derive from as the PRIMARY computation.
  var orig_ids = Vec::new()
  ni = 0
  while ni < stmts.len() do
    orig_ids.push(stmts[ni].node_id)
    match stmts[ni].kind
    when StmtKind::StmtIf(if_stmt) then
      orig_ids.push(if_stmt.cond.node_id)
      var b = 0
      while b < if_stmt.elsif_branches.len() do
        orig_ids.push(if_stmt.elsif_branches[b].0.node_id)
        b = b + 1
      end
    when _ then ()
    end
    ni = ni + 1
  end
  verify_terminator_edge_grounding(typed, finalize_plan, edges, &orig_ids, frame_in, &bf, current_loop_entry, errors)
  (bf, carried_scan)
end


def check_block(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, block: Block, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  let entry_names = res_frame_names_clone(frame)
 # (channel d): the slice-view liveness snapshot of this lexical
  # block — the views registered DURING the block (including shadowed
  # ones, which are non-owning locals never covered by exit_scope's
  # forget set) are removed at the block's scope exit.
  let view_keys_at_entry = slice_views_snapshot_keys(ctx)
 # this lexical block is a defer scope — its block key (the existing
  # block_exit_key mechanism) is pushed onto the enclosing-scope chain while
  # its statements are checked, so a StmtDefer registers on THIS scope and
  # return/break/continue edges inside it attach the defers of every scope
  # they exit (LIFO, innermost first).
  let blk_key = block_exit_key(block)
  if blk_key != 0 then
    defer_chain.push(blk_key)
  end
 # (one TypedCFG): the block's statements execute through the SAME
  # per-block machinery (run_cfg_block) that runs over the PRE-BUILT
  # CfgBlock records — the block record with id == blk_key (recorded by
  # the structural pass cfg_block) is the block the state computation
  # walks; the (entry, exit) frame pair is recorded under that id, the
  # terminator grounding is verified against it, and the cleanup
  # obligations are ATTACHED to the pre-built edges by (kind, source)
  # identity.
  let entry_frame = res_frame_clone(frame)
  let (exit_frame, _) = run_cfg_block(program, typed, env, ctx, &block.stmts, loop_outer, &entry_frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain, blk_key, Option::None)
  frame_assign(frame, &exit_frame)
  if blk_key != 0 then
    defer_chain.pop()
  end
  # Scope-exit obligations: locals created INSIDE this lexical block that are
  # still Live at block exit with Sink/OwnedLocal permission must be
  # finalized when the block ends. Recorded BEFORE exit_scope erases them
  # (the semantic artifact; MIR materializes it at block-end emission).
  # When the block ENDS with a terminating statement (return/break/
  # continue), the terminating edge's own cleanup already covers every live
  # block-local — recording a Normal obligation too would make MIR wrap the
  # edge chain a second time (drop p -> drop p -> edge). The Normal edge's
  # obligation is only needed for fallthrough exits.
  if !block_ends_with_terminator(block) then
 # record_block_exit_plan returns the fallthrough obligation as
    # CleanupAction edge ACTIONS (the Normal edge's CleanupEdge actions —
    # the string-key serialization is are not part of the model).
 # the drop-local actions derive from the RECORDED block frames
    # (the block record (entry, exit) this run captured — the primary
    # computation); the recording reads the block frames, it does not
    # re-derive them (block_frames_get lookup inside record_block_exit_plan;
    # the byte-identical values: the recording frame was the block exit
    # frame).
    let block_actions = record_block_exit_plan(ctx, typed, frame, &entry_names, block, finalize_plan)
 # NORMAL edge — the block's FALLTHROUGH CFG edge (pre-built by
    # the structural pass). The nested-block terminator rule expressed
    # here: a block whose last statement is a terminator gets NO Normal
    # edge — the terminating return/break/continue edge carries the cleanup
    # (block_ends_with_terminator is the successor rule).
    # Empty blocks (key 0) have no statements, hence no
    # cleanup-bearing fallthrough edge.
    if blk_key != 0 then
      attach_edge_actions(ctx, edges, CfgEdgeKind::Normal, blk_key, block_actions, errors)
    end
  end
 # the block records were built by the structural pass (the state
  # walk does not record blocks — it walks the pre-built ones).
  exit_scope(frame, &entry_names, typed, errors)
 # (channel d): the views bound in this block die with its scope —
  # remove them from the live-view registry.
  slice_views_remove_after(ctx, &view_keys_at_entry)
end

# The block-exit finalize set: locals created in the block (not entry locals)
# still Live at exit with Sink/OwnedLocal permission, keyed by the block's
# node id ("block::<node_id>").
# Blocks have no node id of their own; the block's FIRST STATEMENT node id
# is unique per block (every stmt has a unique id), so it keys the block-exit
# obligations. Empty blocks can have no obligations.
def block_exit_key(block: Block) -> Int
  if block.stmts.len() > 0 then block.stmts[0].node_id else 0 end
end

def record_block_exit_plan(ctx: AnalysisContext, typed: TypedProgram, frame: ResFrame, entry_names: Vec[tg_compiler::ids::LocalId], block: Block, inout finalize_plan: FunctionCleanupTable) -> Vec[CleanupAction]
  let key = block_exit_key(block)
  if key == 0 then return Vec::new() end
  var actions = Vec::new()
 # this function produces the Normal edge's CleanupAction sequence —
  # the block's fallthrough CfgEdge { kind: Normal, source: <key>,
  # destination: 0 }, pre-built by the structural pass and attached in
  # check_block — a block whose last flow node is a terminator records no
  # Normal edge and no actions here (the terminator edge carries the
 # cleanup). The "block::<key>" string-key serialization is are not part of the model.
 # the deferred actions registered in THIS scope run first on the
  # block's fallthrough exit, LIFO (REVERSE registration order — the last
  # defer's locals first, matching the edge convention below), so the defer
  # bodies' own locals are finalized exactly when the deferred code runs.
 # append_defer_actions records the scope's defers as RunDefer
  # actions and their bodies' own locals as Drop actions (the defer STMT
  # ids flow through the actions themselves now — the MIR reads them
  # directly from the CleanupEdge table).
  append_defer_actions(finalize_plan, key, &mut actions)
 # the drop-local actions are derived from the RECORDED BLOCK
  # FRAMES — the PRIMARY computation of the flow analysis. This lexical
  # block's flow block 0 is recorded under the same first-statement id
  # (blk_key), so the statement-level recording READS the block frames
  # (block_frames_get) instead of re-deriving from the live frame: the
  # derivation is block_grounded_drop_ids with the Normal edge's OWN-scope
  # frontier (exclude_entry = true — the entry frame's keys, exactly the
 # entry_names the pre-scan filtered). The values are byte-identical
  # (the recording frame was the block exit frame, and the recorded exit is
  # the same state).
  var no_exclude = Vec::new()
  match block_frames_get(ctx, key)
  when Option::Some(bf_pair) then
    let (frame_entry, frame_exit) = bf_pair
    let drop_ids = block_grounded_drop_ids(&frame_entry, &frame_exit, true, &no_exclude)
    mut di = 0
    while di < drop_ids.len() do
      actions.push(CleanupAction::Drop(tg_compiler::ids::LocalId { id: drop_ids[di] }))
      di = di + 1
    end
  when Option::None then
    # IMPOSSIBLE path (the flow always records block 0 for a non-empty
 # fallthrough block); the pre-inline scan is kept as the fallback
    # so the obligation stays correct even if the frame record is missing.
    for (id, ls) in frame.locals do
      if !entry_names.contains(&id) then
        if ls.availability == ResourceState::Live then
          if ls.origin == ParamOrigin::Sink || ls.origin == ParamOrigin::OwnedLocal then
            actions.push(CleanupAction::Drop(id))
          end
        end
      end
    end
  end
 # the actions are returned so check_block attaches them to the
  # pre-built NORMAL edge record (the edge model's copy of this obligation;
  # the CleanupEdge serialization happens once per program at the end of
  # resource_check).
  actions
end

# the PER-BLOCK statement execution — the PRIMARY computation of the
# flow analysis. One CfgBlock's statements execute against the block's ENTRY
# frame (frame_in — at a join, the merged predecessor-exit frames) and
# produce the block's EXIT frame as the result — the scope-exit frontier the
# block's originating edges' obligations derive from. The statement-level
# recording (check_stmt / check_terminator_stmt: the per-statement frame
# transitions, the string-key plans, the CfgEdge records) runs INSIDE this
# execution and reads the frame transitions; it does NOT drive them — the
# block frame capture (run_cfg_block's record_block_frame, fed from this
# function's result) is the primary output, and the recording sites read the
# block frames (record_block_exit_plan's recorded-frame lookup) or produce
# byte-identical sets from the equivalent exit frame (record_exit_edge_plan,
# verified against the recorded frames by verify_terminator_edge_grounding).
# / the block-exit-frame grounding of the terminator edges —
# the RECONCILIATION that makes the recorded block frames the PRIMARY
# authority behind the edge obligations. For every Return/Break/Continue
# edge that originates in THIS block (source id in the block's originating
# ids — its terminator statements), the recorded Drop local ids (minus the
# defer bodies' OWN locals — the documented is_defer_local exception, which
# drop when the deferred code RUNS, outside the block's frame) must equal,
# in order, the block-grounded derivation from the block's RECORDED (entry,
# exit) frames (block_grounded_drop_ids — the authority). The statement-
# level recording produced the same values (the terminator-point frame IS
# the block exit frame); any divergence is an internal error — the
# recording must read the block frames, not invent its own sets.
# Edges excluded here: Normal (attached in check_block after the run, from
# the recorded frames directly), GuardElse (the edge exits at the GUARD
# point, not the block end), True/False (no obligations of their own).
# loop-body-originated edges are NO LONGER excluded — the loop
# body executes through the same run_cfg_block machinery (check_loop_body),
# its (entry, exit) frames ARE recorded under the body's block record id,
# and this reconciliation covers them like every other block.
def verify_terminator_edge_grounding(typed: TypedProgram, finalize_plan: FunctionCleanupTable, edges: Vec[CfgEdge], orig_ids: Vec[Int], entry: ResFrame, exit: ResFrame, current_loop_entry: Vec[Int], inout errors: Vec[ResourceError]) -> Unit
  mut e = 0
  while e < edges.len() do
    let ed = edges[e]
    var grounded_kind = false
    match ed.kind
    when CfgEdgeKind::Return then grounded_kind = true
    when CfgEdgeKind::Break then grounded_kind = true
    when CfgEdgeKind::Continue then grounded_kind = true
    when _ then ()
    end
    if grounded_kind then
      if orig_ids.contains(&ed.source) then
 # boundary: the loop frontier (current_loop_entry) is the raw-Int
        # loop-context domain; the derivation works in the same domain.
        var loop_exclude = Vec::new()
        match ed.kind
        when CfgEdgeKind::Break then loop_exclude = current_loop_entry.clone()
        when CfgEdgeKind::Continue then loop_exclude = current_loop_entry.clone()
        when _ then ()
        end
        let derived = block_grounded_drop_ids(entry, exit, false, &loop_exclude)
        var recorded = Vec::new()
        var ai = 0
        while ai < ed.actions.len() do
          let act = ed.actions[ai]
          match act
          when CleanupAction::Drop(lid) then
            if !is_defer_local(finalize_plan, lid.id) then
              recorded.push(lid.id)
            end
          when _ then ()
          end
          ai = ai + 1
        end
        var seq_equal = recorded.len() == derived.len()
        if seq_equal then
          mut ri = 0
          while ri < recorded.len() do
            if !(recorded[ri] == derived[ri]) then
              seq_equal = false
            end
            ri = ri + 1
          end
        end
        if !seq_equal then
          errors.push(ResourceError {
            message: "internal error: resource-check terminator edge obligation diverges from the source block's exit frame",
            span: Span { file: "", start: 0, end_pos: 0 }
          })
        end
      end
    end
    e = e + 1
  end
end

# a set parameter's contract is entry Uninitialized, exit EXACTLY
# Live — on every normal return edge it must have been initialized and not
# consumed/left MaybeLive afterwards. A missing/divergent state is an error.
def validate_set_postconditions(typed: TypedProgram, frame: ResFrame, span: Span, inout errors: Vec[ResourceError]) -> Unit
  # Frame keys are LocalId; binding_name is keyed by the raw Int semantic id.
  for (id, ls) in frame.locals do
    if ls.origin == ParamOrigin::Set then
      match ls.availability
      when ResourceState::Live then ()
      when _ then
        errors.push(ResourceError {
          message: "set parameter `" + binding_name(typed, id.id) + "` must be exactly Live on every return edge (entry Uninitialized, exit Live)",
          span: span
        })
      end
    end
  end
end

# a live capability reaching a function exit must have been returned,
# transferred, delegated, or explicitly consumed by a capability operation —
# an automatic deinitializer must NOT satisfy its linearity.
def validate_capability_exit(typed: TypedProgram, frame: ResFrame, span: Span, inout errors: Vec[ResourceError]) -> Unit
  # Frame keys are LocalId; binding_name is keyed by the raw Int semantic id.
  for (cid, ls) in frame.locals do
    if ls.is_capability then
      match ls.availability
      when ResourceState::Live then
        errors.push(ResourceError {
          message: "capability `" + binding_name(typed, cid.id) + "` must be returned, transferred, delegated, or explicitly consumed before function exit (authority cannot be silently discarded)",
          span: span
        })
      when _ then ()
      end
    end
  end
end

def check_return_stmt(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, val_opt: Option[Expr], loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], stmt_node_id: Int, inout defer_chain: Vec[Int]) -> Vec[CleanupAction]
  var return_entry = Vec::new()
  match val_opt
  when Option::Some(val) then
    check_expr(program, typed, env, ctx, &val, loop_outer, frame, errors, finalize_plan, edges, blocks, &mut return_entry, defer_chain)
    transfer_consume(env, typed, &val, loop_outer, frame, errors, finalize_plan)
  when Option::None then ()
  end
 # this function produces the RETURN edge's CleanupAction sequence —
  # the CfgEdge { kind: Return, source: <stmt id>, destination: 0 } the
  # structural pass pre-built, attached at the terminator dispatch
  # (check_terminator_stmt / check_stmt) — and of the GuardElse edge when
  # dispatched from a guard's else-return (same source under the GUARD's
  # stmt id). The guard-else path is a single transfer and gets ONE edge:
  # kind GuardElse. The "return::<stmt id>" string-key serialization is
 # is not part of the model.
  # RETURN-EDGE cleanup obligation: locals still Live at this return point
  # with Sink/OwnedLocal permission must be finalized BEFORE the return
  # (an early return exits before normal block fallthrough; the function-end
  # plan cannot recover locals already forgotten by lexical exit_scope).
  # A return exits EVERY scope, so the excluded set is empty.
  var return_exclude = Vec::new()
  # A return exits every enclosing scope: the defers of the WHOLE chain run
  # (LIFO, innermost first) — stop_at_loop is false.
  let plan_actions = record_exit_edge_plan(typed, frame, &return_exclude, finalize_plan, defer_chain, false)
  # Return-edge POSTCONDITIONS: set params must be exactly Live, and live
  # capabilities must have been transferred/consumed.
  let ret_span = match val_opt
  when Option::Some(val) then val.span
  when Option::None then Span { file: "", start: 0, end_pos: 0 }
  end
  validate_set_postconditions(typed, frame, ret_span, errors)
  validate_capability_exit(typed, frame, ret_span, errors)
  plan_actions
end

# Record the cleanup obligation for a control-flow exit edge: Live locals
# with Sink/OwnedLocal permission. Locals in `exclude` (the innermost loop's
# entry names) predate the exited loop — they must survive the edge, so
# they are not part of the plan.
# the deferred actions registered in the scopes this edge exits also
# run, LIFO — INNERMOST scope first, and within a scope in REVERSE
# registration order — BEFORE the edge's ordinary cleanup.
# `defer_chain` holds the block keys of the enclosing lexical scopes
# (outermost first; loop body scopes are stored NEGATED so break/continue
# edges — which exit only the scopes nested inside the loop — stop the walk
# exactly at the loop body scope, which IS included). Return edges exit
# EVERY scope, so `stop_at_loop` is false and the whole chain applies.
# returns the obligation as CleanupAction edge ACTIONS in execution
# order (the exited scopes' defers as RunDefer actions, LIFO — innermost
# scope first, within a scope reverse registration — then the drop-local
# actions, reverse drop order). The caller attaches them to the
# corresponding pre-built CfgEdge record; the CleanupEdge serialization
# happens once per program at the end of resource_check.
def record_exit_edge_plan(typed: TypedProgram, frame: ResFrame, exclude: Vec[Int], inout finalize_plan: FunctionCleanupTable, defer_chain: Vec[Int], stop_at_loop: Bool) -> Vec[CleanupAction]
  var actions = Vec::new()
  var ci = defer_chain.len()
  while ci > 0 do
    ci = ci - 1
    let sk = defer_chain[ci]
    let scope_key = if sk < 0 then -sk else sk end
 # this scope's defers run (LIFO: last registered first) as
    # RunDefer actions and the defer bodies' own locals drop when the
    # deferred code runs as Drop actions.
    append_defer_actions(finalize_plan, scope_key, &mut actions)
    if stop_at_loop && sk < 0 then
      break
    end
  end
 # the drop-local actions are derived from the EXIT frame via
  # block_grounded_drop_ids — the documented block-grounded authority (the
  # statement-level recording reads the derivation; it does not re-derive).
  # For a flow-block terminator the frame at the recording point IS the
  # source block's exit frame (the terminator is the last executed node of
  # its block), and run_cfg_block's post-block reconciliation verifies the
  # recorded obligations against the RECORDED (entry, exit) frames.
  # exclude_entry is false (Return exits every scope; Break/Continue apply
  # the loop-entry exclude), so the derivation's entry side is not read.
  # Frame keys are LocalId; the loop-context `exclude` vector is the raw Int
  # local-id domain — the derivation extracts `.id` at this boundary.
  let drop_ids = block_grounded_drop_ids(frame, frame, false, exclude)
  mut di = 0
  while di < drop_ids.len() do
    actions.push(CleanupAction::Drop(tg_compiler::ids::LocalId { id: drop_ids[di] }))
    di = di + 1
  end
  actions
end

# the innermost enclosing loop's BODY block key — the loop-context
# identity of a Break/Continue/Backedge edge (its destination). Loop body
# scopes are stored NEGATED on the defer chain (see check_loop_body), so the
# first negated entry scanned from the innermost end names the loop the edge
# exits. 0 when no loop encloses the edge (no negated entry): Break/Continue
# edges may not originate there — validate_cfg_edges flags destination 0.
def enclosing_loop_key(defer_chain: Vec[Int]) -> Int
  var ci = defer_chain.len()
  while ci > 0 do
    ci = ci - 1
    let sk = defer_chain[ci]
    if sk < 0 then
      return -sk
    end
  end
  0
end

def check_break_stmt(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, val_opt: Option[Expr], loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], stmt_node_id: Int, inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Vec[CleanupAction]
  match val_opt
  when Option::Some(val) then
    check_expr(program, typed, env, ctx, &val, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    transfer_consume(env, typed, &val, loop_outer, frame, errors, finalize_plan)
  when Option::None then ()
  end
 # this function produces the BREAK edge's CleanupAction sequence —
  # the CfgEdge { kind: Break, source: <stmt id>, destination: <innermost
  # loop body key> } the structural pass pre-built, attached at the
  # terminator dispatch (check_terminator_stmt / check_stmt) — and of the
  # GuardElse edge when dispatched from a guard's else-break (same source
  # under the GUARD's stmt id). The "break::<stmt id>" string-key
 # serialization is not part of the model.
  # BREAK-EDGE cleanup obligation: locals live at this break leave the loop
  # through a terminator, not normal block fallthrough — they must be
  # finalized on this edge. Locals in the current loop's entry (predating
  # the loop) are excluded: they survive the break.
 # the defers of the scopes nested inside the loop run on the break
  # edge (the chain walk stops at the negated loop-body scope).
  let plan_actions = record_exit_edge_plan(typed, frame, current_loop_entry, finalize_plan, defer_chain, true)
  plan_actions  end
end

def check_terminator_stmt(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, stmt: Stmt, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match stmt.kind
  when StmtKind::StmtReturn(val_opt) then
 # / RETURN edge — the pre-built CfgEdge { kind: Return,
    # source: <stmt id>, destination: 0 } (function exit); the obligation
    # computed by check_return_stmt is ATTACHED to it (the "return::<stmt
    # id>" string-key serialization is are not part of the model).
    let ret_actions = check_return_stmt(program, typed, env, ctx, val_opt, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, defer_chain)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Return, stmt.node_id, ret_actions, errors)
  when StmtKind::StmtBreak(val_opt) then
 # / BREAK edge — the pre-built CfgEdge { kind: Break,
    # source: <stmt id>, destination: <innermost loop body key> }.
    let brk_actions = check_break_stmt(program, typed, env, ctx, val_opt, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Break, stmt.node_id, brk_actions, errors)
  when StmtKind::StmtContinue then
 # / CONTINUE edge — the pre-built CfgEdge { kind:
    # Continue, source: <stmt id>, destination: <innermost loop body key> }.
    # CONTINUE-EDGE cleanup obligation (backedge leaves through a
    # terminator). The plan excludes the current loop's entry locals: they
    # were live before this iteration and must survive into the next one.
 # the scopes nested inside the loop run their defers on this edge.
    let cont_actions = record_exit_edge_plan(typed, frame, current_loop_entry, finalize_plan, defer_chain, true)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Continue, stmt.node_id, cont_actions, errors)
  when _ then ()
  end  end
end

def check_stmt(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, stmt: Stmt, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
 # (channel d): the mutation-while-raw-view-live check runs per
  # statement — a live RAW-view local's backing buffer cannot be
  # mutated/reallocated by this statement (the IterationPlan mutation
  # machinery scans the statement against every live raw view's backing;
  # the shared/pinned forms are never registered — their pinned backing
  # is unaffected by the owner's mutations).
  check_slice_view_backing_mutation(ctx, typed, stmt, errors)
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    check_expr(program, typed, env, ctx, &value, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    transfer_consume(env, typed, &value, loop_outer, frame, errors, finalize_plan)
    bind_pattern(env, typed, &pattern, stmt.span, frame, errors)
 # (channel d): a let-bound RAW view local is registered under
    # its backing place — live until its scope exits (the scope-boundary
    # cleanup protocol removes it).
    register_slice_view_local(ctx, env, typed, &pattern, &value)
  when StmtKind::StmtAssign(target, value) then
 # check_assign_target captures prior_state and validates the
    # target WITHOUT mutating it; the RHS is validated next, then the drop
    # decision (computed from prior_state) is recorded and next_state
    # commits — the store can never look like a replacement of a value that
    # was never there.
    let assign_trans = check_assign_target(program, typed, env, ctx, &target, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &value, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    transfer_consume(env, typed, &value, loop_outer, frame, errors, finalize_plan)
    match assign_trans
    when Option::Some(t) then
 # drops_old derives from the PRIOR state: a Live owning value
      # is dropped before the store ("drop old -> store new"; overwriting
      # would leak); Uninitialized storage (the first store into a set
      # parameter's caller buffer) and Consumed storage (reinitializing a
      # moved-out slot) are dead — no drop. Set params are included in the
      # drop filter ONCE they are Live: the value they hold was written by
      # the callee (a previous assignment), so overwriting it without a
      # drop leaks that value.
      if t.drops_old then
        # (partial moves): the drop-before-store form — the WHOLE-root drop
        # (depth-1) must not share storage with the value's source: the RHS
        # rooting at the SAME local (a direct whole-root or projected move)
        # would destroy the value's source (the drop-before-store and the
        # source move cannot share the storage) — rejected. The NESTED
        # exact-place drop destroys only the target chain's own state, so
        # the same-root chain-move guard applies, but the root's OTHER
        # chains (consumed or live) are untouched — the root_has_moves
        # whole-root guard does not apply to the exact-place form.
        var target_chain = Vec::new()
        let target_is_field = if !expr_is_plain(target) then
          place_projection_keys(typed, &target, &mut target_chain)
        else
          false
        end
        if !expr_is_plain(target) && target_is_field && target_chain.len() > 1 then
          if expr_roots_at(typed, &value, t.lid.id) then
            errors.push(ResourceError {
              message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
              span: value.span
            })
          else
            # The nested exact-place drop: the chain's own state is
            # destroyed before the store (masked to the chain's consumed
            # extensions — the assign_exact_drops plan the MIR's
            # assign-drop chain consumes). the assign-drop chain is NOT a
            # CFG edge — it is the drop-before-store chain inside one
            # statement, with no CfgEdgeKind in the edge model (no
            # transfer originates it). the chain is the SEMANTIC
            # assign_exact_drops table (node id -> the exact-place drop
            # records) — the "assign::<stmt id>" String-key protocol is
            # not part of the model.
            var exact = Vec::new()
            exact.push(AssignExactDrop {
              local: t.lid.id,
              chain: target_chain.clone(),
              paths: assign_exact_drop_paths(typed, env, frame, t.lid, &target_chain)
            })
            let _ = finalize_plan.assign_exact_drops.insert(stmt.node_id, exact)
          end
        elsif !expr_is_plain(target) && root_has_moves(frame, t.lid) then
          errors.push(ResourceError {
            message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
            span: value.span
          })
        elsif !expr_is_plain(target) && expr_roots_at(typed, &value, t.lid.id) then
          errors.push(ResourceError {
            message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
            span: value.span
          })
        else
          # boundary: the assign_drops plan keeps the raw Int semantic id
          # (the MIR's semantic_to_mir bridge maps it).
          var assign_ids = Vec::new()
          assign_ids.push(t.lid.id)
          # the assign-drop chain is NOT a CFG edge — it is the
          # drop-before-store chain inside one statement, with no CfgEdgeKind
          # in the edge model (no transfer originates it). the chain is
          # the SEMANTIC assign_drops table (node id -> local ids) — the
          # "assign::<stmt id>" String-key protocol is not part of the model.
          let _ = finalize_plan.assign_drops.insert(stmt.node_id, assign_ids)
        end
      end
      # The store commits AFTER the drop decision: next_state comes from
      # prior_state, never from a validation-time mutation.
      res_frame_set(frame, t.lid, t.next)
      # (partial moves — the projected-target commit): the chain-level
      # transition — the sibling DIRECT fields die with the whole-root
      # drop chain (marked Consumed, so the scope-exit drop drops only the
      # re-stored target), and the target chain re-lives (clear + Live).
      if !expr_is_plain(target) then
        var chain = Vec::new()
        let field_chain = place_projection_keys(typed, &target, &mut chain)
        if field_chain then
          if t.drops_old then
            # The whole-root drop (the depth-1 owning target) destroys the
            # sibling DIRECT fields — they are marked Consumed so the
            # scope-exit drop skips them. The NESTED exact-place drop
            # destroys only the chain's own state — the siblings stay
            # live, no marking.
            if chain.len() == 1 then
              mark_frame_sibling_fields(typed, frame, t.lid, &chain)
            end
          end
          frame_place_clear(frame, t.lid, &chain)
          frame_place_mark(frame, t.lid, &chain, ResourceState::Live)
        end
      end
    when Option::None then ()
    end
  when StmtKind::StmtCompoundAssign(_, target, value) then
    check_expr(program, typed, env, ctx, &target, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &value, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when StmtKind::StmtIf(if_stmt) then
    check_if(program, typed, env, ctx, &if_stmt, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when StmtKind::StmtMatch(m) then
    check_match(program, typed, env, ctx, &m, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when StmtKind::StmtWhile(cond, body) then
    check_loop(program, typed, env, ctx, Option::Some(&cond), &body, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
  when StmtKind::StmtFor(for_stmt) then
    check_for(program, typed, env, ctx, &for_stmt, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
  when StmtKind::StmtLoop(body) then
    check_loop(program, typed, env, ctx, Option::None, &body, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
  when StmtKind::StmtReturn(val_opt) then
 # / RETURN edge — the pre-built CfgEdge { kind: Return,
    # source: <stmt id>, destination: 0 } (function exit); the obligation
    # computed by check_return_stmt is ATTACHED to it (the "return::<stmt
    # id>" string-key serialization is are not part of the model).
    let ret_actions = check_return_stmt(program, typed, env, ctx, val_opt, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, defer_chain)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Return, stmt.node_id, ret_actions, errors)
  when StmtKind::StmtBreak(val_opt) then
 # / BREAK edge — the pre-built CfgEdge { kind: Break,
    # source: <stmt id>, destination: <innermost loop body key> }.
    let brk_actions = check_break_stmt(program, typed, env, ctx, val_opt, loop_outer, frame, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Break, stmt.node_id, brk_actions, errors)
  when StmtKind::StmtContinue then
 # / CONTINUE edge — the pre-built CfgEdge { kind:
    # Continue, source: <stmt id>, destination: <innermost loop body key> }.
    # CONTINUE-EDGE cleanup obligation (backedge leaves through a
    # terminator). The plan excludes the current loop's entry locals: they
    # were live before this iteration and must survive into the next one.
 # the scopes nested inside the loop run their defers on this edge.
    let cont_actions = record_exit_edge_plan(typed, frame, current_loop_entry, finalize_plan, defer_chain, true)
    attach_edge_actions(ctx, edges, CfgEdgeKind::Continue, stmt.node_id, cont_actions, errors)
  when StmtKind::StmtExpr(e) then
    check_expr(program, typed, env, ctx, &e, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
 # an expression statement whose result is resource-containing and
    # UNCONSUMED drops an owned temporary (e.g. `make_probe()` or
    # `m.insert(k, v)` returning a previous resource value). Per the
    # full-expression-cleanup model the temporary is CLEANED at the end of
    # the statement: record an "expr::<stmt id>" obligation that the MIR
    # materializes against the statement's result temporary. Locals whose
    # root is still Live are an error (a live binding silently dropped).
    match typed.expr_types.get(e.node_id)
    when Option::Some(et) then
      # The CANONICAL ownership predicate: a discarded UniquePtr[Int] or an
      # owning container must be cleaned even though its nominal kind is
      # Value (the old resource-containment test escaped them).
      if is_owning_typed(env, &et) then
        match expr_root_id(typed, &e)
        when Option::Some(root_id) then
 # boundary: the frame is LocalId-keyed; expr_root_id yields the
          # raw Int semantic id.
          match res_frame_get(frame, &tg_compiler::ids::LocalId { id: root_id })
          when Option::Some(ResourceState::Live) then
            errors.push(ResourceError {
              message: "owned resource result must be consumed, bound, returned, or explicitly discarded through a consuming operation",
              span: e.span
            })
          when _ then ()
          end
        when Option::None then
          # A resource-producing expression with no root (e.g. a call result)
          # is an owned full-expression temporary: record cleanup at the end
          # of the statement.
 # "expr::<stmt id>" is NOT a CFG edge — it is a
          # statement-local full-expression temporary cleanup, with no
          # CfgEdgeKind in the edge model (no transfer originates it).
          var expr_plan = Vec::new()
          expr_plan.push(0)
 # the full-expression temporary marker is the SEMANTIC
          # expr_temps table (stmt node id -> markers) — the "expr::<stmt
 # id>" String-key protocol is not part of the model.
          finalize_plan.expr_temps.insert(stmt.node_id, expr_plan)
        end
      end
    when Option::None then ()
    end
  when StmtKind::StmtUnsafe(_, body) then
    check_block(program, typed, env, ctx, &body, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when StmtKind::StmtDefer(body) then
    # `defer {... }` REGISTERS a deferred action on the current
    # lexical scope — it does NOT execute at registration time. The defer
    # body is checked ONCE (its own expressions/locals) on a private clone
    # of the frame, so no effect on enclosing locals (consume/transfer) is
    # applied now; the defer's stmt id is recorded in the scope's defer list
    # (the ScopeId-keyed scope_defers table, registration order) and the defer body's OWN
    # locals are attached to the scope's exiting edges (they are finalized
    # when the deferred code RUNS). The MIR emits the deferred CALLS from the
    # ScopeId-keyed scope_defers table.
    mut defer_frame = res_frame_clone(frame)
    let defer_entry_names = res_frame_names_clone(&defer_frame)
    let defer_local_ids = check_defer_body(program, typed, env, ctx, &body, loop_outer, &mut defer_frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    # Diagnostics parity with a lexical block: the defer body's own locals
    # are subject to the same exit checks (uninitialized / silently
    # discarded capability), reported against the private clone (discarded).
    exit_scope(&mut defer_frame, &defer_entry_names, typed, errors)
    register_defer(stmt.node_id, defer_chain, &defer_local_ids, finalize_plan)
  when StmtKind::StmtGuard(cond, else_action) then
    check_expr(program, typed, env, ctx, &cond, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    # The guard's failing-condition exit is a DIVERGENT path: the else
    # action's value expression may MOVE an owning local out of the frame
    # (`guard ok else return r` transfers r on the else path only). The
    # else path is evaluated on a private clone of the frame, so the
    # transfer/consume applies to the else path's state — the fallthrough
    # (cond-true) frame keeps the local Live. The GuardElse edge's cleanup
    # obligation is recorded from the same clone (identical content at the
    # guard point), so the emitted edge cleanup is unchanged.
    match else_action
    when GuardElse::Return(val_opt) then
 # / GUARD-ELSE edge — the guard's failing-condition
      # exit is ONE pre-built transfer of kind GuardElse (source = the
      # GUARD stmt's id, not an inner return's).
      mut gframe = res_frame_clone(frame)
      let g_actions = check_return_stmt(program, typed, env, ctx, val_opt, loop_outer, &mut gframe, errors, finalize_plan, edges, blocks, stmt.node_id, defer_chain)
      attach_edge_actions(ctx, edges, CfgEdgeKind::GuardElse, stmt.node_id, g_actions, errors)
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
 # / GUARD-ELSE edge (else-break).
      mut gframe2 = res_frame_clone(frame)
      let g_actions = check_break_stmt(program, typed, env, ctx, val_opt, loop_outer, &mut gframe2, errors, finalize_plan, edges, blocks, stmt.node_id, current_loop_entry, defer_chain)
      attach_edge_actions(ctx, edges, CfgEdgeKind::GuardElse, stmt.node_id, g_actions, errors)
    when GuardElse::Continue then
 # / GUARD-ELSE edge (else-continue).
      let g_actions = record_exit_edge_plan(typed, frame, current_loop_entry, finalize_plan, defer_chain, true)
      attach_edge_actions(ctx, edges, CfgEdgeKind::GuardElse, stmt.node_id, g_actions, errors)
    end
  when StmtKind::StmtTry(_, _, _) then
 # REJECTED — exceptions are not supported. The resource CFG has
    # no Throw/Unwind/Handler edges, so a try body's throwing path (body ->
    # catch handler, body -> finally teardown) could bypass Drop/defer/
 # access teardown; the pre-sequential analysis here (catch arms
    # entered from the try body's EXIT frame) was structurally wrong for a
    # mid-body throw — a catch arm could observe locals the body moved or
    # dropped. The type checker rejects this form before the resource
    # checker runs in the compile path; this arm fails CLOSED when the form
    # still reaches the checker (the LSP path runs every pass despite type
    # errors). No frame effect is applied: the construct is never modeled.
    errors.push(ResourceError {
      message: "exceptions are not supported — no throwing path may bypass teardown: try/catch/finally is rejected",
      span: stmt.span
    })
  when StmtKind::StmtWith(_, _, _) then
 # REJECTED — `with` is a teardown-guarding form whose exit paths
    # the resource CFG models nowhere; fail closed, never analyze it
    # sequentially (the type checker rejects it before the resource checker
    # runs in the compile path; this arm covers the LSP path).
    errors.push(ResourceError {
      message: "exceptions are not supported — no throwing path may bypass teardown: with is rejected",
      span: stmt.span
    })
  when StmtKind::StmtHandleWith(expr, handlers) then
    # The effect-handler block (the algebraic-effects row): the handled
    # expression is checked normally; the handler ARMS run in the handler's
    # DISPATCHER function (the MIR synthesizes one per handler) — each
    # arm's body is checked in a PRIVATE frame (the checker's capture gate
    # already rejected owning captures into the handler env, so the arms
    # can only read non-owning enclosing locals; the arm's own locals are
    # checked and their end-frame drops are recorded under the arm's
    # synthetic cleanup key — the SAME key the MIR's dispatcher lowering
    # looks up for the per-arm deinit chain).
    check_expr(program, typed, env, ctx, &expr, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    var h_idx = 0
    while h_idx < handlers.len() do
      var a_idx = 0
      while a_idx < handlers[h_idx].arms.len() do
        let arm_body = handlers[h_idx].arms[a_idx].body
        let arm_entry = res_frame_new()
        var p_idx = 0
        while p_idx < handlers[h_idx].arms[a_idx].params.len() do
          bind_pattern(env, typed, &handlers[h_idx].arms[a_idx].params[p_idx], handlers[h_idx].arms[a_idx].span, &mut arm_entry, errors)
          p_idx = p_idx + 1
        end
        let arm_key = block_exit_key(&arm_body)
        let (arm_exit, _) = run_cfg_block(program, typed, env, ctx, &arm_body.stmts, loop_outer, &arm_entry, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain, arm_key, Option::None)
        record_closure_cleanup(typed, &arm_exit, effect_handler_synth_key(stmt.node_id, h_idx, a_idx), finalize_plan)
        a_idx = a_idx + 1
      end
      h_idx = h_idx + 1
    end
  end
end

# `defer {... }` REGISTERS a deferred action on the current lexical
# scope — the deferred code does NOT execute at registration. This function
# CHECKs the defer body once (its own expressions/locals, for diagnostics)
# on a private clone of the current frame: no effect on ENCLOSING locals
# (consumes/transfers) is applied at registration, because those effects
# happen later, when the deferred code runs at the scope's exit (that part
# is emitted by the MIR side from the ScopeId-keyed scope_defers table — see
# register_defer). Unlike check_block, the defer body's block-exit plan is
# NOT recorded here and its locals are NOT forgotten: they are returned so
# the caller can attach them to the scope's exiting edges (they are
# finalized exactly when the deferred code RUNS, never at registration).
def check_defer_body(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, body: Block, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Vec[Int]
 # (channel d): the defer body is a scope boundary for raw views
  # (its statements are checked once at registration; views bound inside
  # are registration-time artifacts — removed after the check).
  let body_view_keys = slice_views_snapshot_keys(ctx)
 # (one TypedCFG): the defer body's CfgBlock record was recorded by
  # the structural pass (cfg_defer_body — no Normal edge: a defer body
  # records no fallthrough obligation); the state computation executes the
  # body's statements through the SAME per-block machinery (run_cfg_block)
  # and records the body block's (entry, exit) frames under its record id.
  let body_key = block_exit_key(body)
  let body_entry = res_frame_clone(frame)
  let (body_exit, _) = run_cfg_block(program, typed, env, ctx, &body.stmts, loop_outer, &body_entry, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain, body_key, Option::None)
  frame_assign(frame, &body_exit)
  slice_views_remove_after(ctx, &body_view_keys)
  var ids = Vec::new()
  collect_defer_body_locals(typed, body, frame, &mut ids)
  ids
end

# Walk the defer body's TOP-LEVEL let statements for their own binding ids
# and keep the ones still Live (or MaybeLive — consumed on one path only) with
# owning permission in the checked clone: exactly the locals that must be
# finalized when the deferred code runs. A definitely-Consumed defer local
# was moved inside the deferred code — nothing to finalize. (Locals bound in
# NESTED blocks inside the defer body are covered by those nested blocks' own
# plans when the MIR side lowers the deferred code.)
def collect_defer_body_locals(typed: TypedProgram, body: Block, frame: ResFrame, inout out: Vec[Int]) -> Unit
  mut i = 0
  while i < body.stmts.len() do
    match body.stmts[i].kind
    when StmtKind::StmtLet(pattern, _, _, _) then
      var pat_ids = Vec::new()
      collect_pattern_binding_ids(typed, &pattern, &mut pat_ids)
      mut j = 0
      while j < pat_ids.len() do
        let pid = pat_ids[j]
 # boundary: pat_ids are raw Int semantic ids (they are returned
        # to the caller and serialize into the defer_locals plans); the
        # frame is LocalId-keyed.
        match res_frame_get(frame, &tg_compiler::ids::LocalId { id: pid })
        when Option::Some(ResourceState::Live) then
          match res_frame_get_origin(frame, &tg_compiler::ids::LocalId { id: pid })
          when Option::Some(ParamOrigin::OwnedLocal) then out.push(pid)
          when _ then ()
          end
        when Option::Some(ResourceState::MaybeLive) then
          match res_frame_get_origin(frame, &tg_compiler::ids::LocalId { id: pid })
          when Option::Some(ParamOrigin::OwnedLocal) then out.push(pid)
          when _ then ()
          end
        when _ then ()
        end
        j = j + 1
      end
    when _ then ()
    end
    i = i + 1
  end
end

# record the deferred action on the CURRENT lexical scope, keyed by
# the scope's SEMANTIC ScopeId (the existing block_exit_key value wrapped —
# the innermost element of defer_chain; loop body scopes are stored
# negated, see check_loop_body). Two SEMANTIC tables are recorded:
#   scope_defers      — ScopeId -> the defer STMT ids (DeferId), in
#                       registration order. The MIR side reads THIS table
#                       to emit the deferred CALLS (in reverse — LIFO).
#   scope_defer_locals — ScopeId -> the ids of the defer bodies' OWN
#                       locals (LocalId), in registration order. Every
#                       exiting edge of the scope (fallthrough block plan,
#                       return/break/continue edge plans, loop backedges)
#                       appends them REVERSED, so the deferred code's
#                       locals are finalized exactly when the deferred code
#                       runs, LIFO.
# The defer / defer-locals String-key protocols
# are not part of the model: no cleanup semantics depend on parsing a String prefix.
def register_defer(defer_stmt_id: Int, defer_chain: Vec[Int], defer_local_ids: Vec[Int], inout finalize_plan: FunctionCleanupTable) -> Unit
  if defer_chain.len() == 0 then
    return
  end
  let raw_key = defer_chain[defer_chain.len() - 1]
  let scope_key = if raw_key < 0 then -raw_key else raw_key end
  let scope_id = ScopeId { id: scope_key }
  match finalize_plan.scope_defers.get(scope_id)
  when Option::Some(existing) then
    var ext = existing.clone()
    ext.push(DeferId { id: defer_stmt_id })
    finalize_plan.scope_defers.insert(scope_id, ext)
  when Option::None then
    var ids = Vec::new()
    ids.push(DeferId { id: defer_stmt_id })
    finalize_plan.scope_defers.insert(scope_id, ids)
  end
  if defer_local_ids.len() > 0 then
    match finalize_plan.scope_defer_locals.get(scope_id)
    when Option::Some(existing) then
      var ext = existing.clone()
      for lid in defer_local_ids do
        ext.push(tg_compiler::ids::LocalId { id: lid })
      end
      finalize_plan.scope_defer_locals.insert(scope_id, ext)
    when Option::None then
      var lids = Vec::new()
      for lid in defer_local_ids do
        lids.push(tg_compiler::ids::LocalId { id: lid })
      end
      finalize_plan.scope_defer_locals.insert(scope_id, lids)
    end
  end
end

# append_defer_locals — the raw-Int kind-0 defer-local
# contribution to the String-keyed edge plans — is REMOVED with the
# compatibility layer; append_defer_actions emits Drop(LocalId) actions
# from the same scope_defer_locals registry.
# a scope's deferred actions, as edge ACTIONS in execution order: the
# scope's defers (defer STMT ids from the ScopeId-keyed scope_defers table)
# as RunDefer actions in REVERSE registration order (LIFO — the last
# registered defer runs first), followed by the defers' bodies' OWN locals
# (the ScopeId-keyed scope_defer_locals table) as Drop actions in reverse
# registration order — the deferred code's locals are finalized exactly when
# the deferred code runs. The MIR consumes the RunDefer actions directly
# (the defer STMT ids flow through the CleanupEdge actions — no string-key
# channel needed).
def append_defer_actions(finalize_plan: FunctionCleanupTable, scope_key: Int, inout out: Vec[CleanupAction]) -> Unit
  match finalize_plan.scope_defers.get(ScopeId { id: scope_key })
  when Option::Some(defer_ids) then
    var di = defer_ids.len()
    while di > 0 do
      di = di - 1
      out.push(CleanupAction::RunDefer(tg_compiler::ids::NodeId { id: defer_ids[di].id }))
    end
  when Option::None then ()
  end
  match finalize_plan.scope_defer_locals.get(ScopeId { id: scope_key })
  when Option::Some(loc_ids) then
    var li = loc_ids.len()
    while li > 0 do
      li = li - 1
      out.push(CleanupAction::Drop(tg_compiler::ids::LocalId { id: loc_ids[li].id }))
    end
  when Option::None then ()
  end  end
end

def check_if(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, if_stmt: IfStmt, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  check_expr(program, typed, env, ctx, &if_stmt.cond, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
 # the if-split's two branch edges (True: cond -> then arm; False:
  # cond -> the false continuation) were recorded by the STRUCTURAL PASS
  # (cfg_stmt's StmtIf arm — with their empty actions; the state walk does
  # not record structure). They carry no cleanup of their own — the branch
  # cleanups serialize through the branch blocks' own Normal edges and the
  # enclosing scopes' edge plans.
  mut arms = Vec::new()
  mut then_frame = res_frame_clone(frame)
  check_block(program, typed, env, ctx, &if_stmt.then_block, loop_outer, &mut then_frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  arms.push(then_frame)
  mut i = 0
  while i < if_stmt.elsif_branches.len() do
    check_expr(program, typed, env, ctx, &if_stmt.elsif_branches[i].0, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
 # each elsif condition's split edges were recorded by the
    # structural pass too.
    mut arm = res_frame_clone(frame)
    check_block(program, typed, env, ctx, &if_stmt.elsif_branches[i].1, loop_outer, &mut arm, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    arms.push(arm)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then
    mut arm = res_frame_clone(frame)
    check_block(program, typed, env, ctx, &eb, loop_outer, &mut arm, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    arms.push(arm)
  when Option::None then
    arms.push(res_frame_clone(frame))
  end
  let merged = merge_frames(&arms)
  frame_assign(frame, &merged)
  # / THE IF-JOIN — the join block's ENTRY state: the merged
  # branch exits (the same merge; the branch exits ARE the branch
  # blocks' recorded exit frames — check_block's run_cfg_block recorded
  # the (entry, exit) pairs under the branch block ids). The join
  # executes no statements — its exit frame is the entry. Recorded under
  # the join block's ALLOCATED synthetic id — READ from the pre-built
  # record by the join's origin (cfg_join_record_id; the state walk never
  # allocates block ids, so the frame key always equals the CfgBlock
  # record's id) — the single-pass merge (the if region is acyclic: one
  # merge, no re-execution).
  let join_id = cfg_join_record_id(blocks, if_stmt.cond.node_id)
  if join_id != 0 then
    record_block_frame(ctx, join_id, res_frame_clone(&merged), res_frame_clone(&merged))
  end
end

def check_match(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, m: MatchExpr, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  check_expr(program, typed, env, ctx, &m.scrutinee, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  # A resource-containing scrutinee is MOVED into the arm's resource
  # bindings: matching a resource by value transfers ownership out of the
  # scrutinee exactly once (Option[Resource]/Result[Resource,E] destructuring
  # gets a complete linear interpretation this way).
  let scrutinee_ty = match typed.expr_types.get(m.scrutinee.node_id)
  when Option::Some(t) then t.clone()
  when Option::None then Type::Unit
  end
  # The CANONICAL ownership predicate: an Option[UniquePtr[Int]] scrutinee
  # is ownership-bearing even though its nominal kinds are Value — the arm
  # binding must consume the owner, never duplicate it.
  let scrutinee_contains_resource = is_owning_typed(env, &scrutinee_ty)
  if scrutinee_contains_resource then
    match expr_root_id(typed, &m.scrutinee)
    when Option::Some(root) then
 # boundary: the frame is LocalId-keyed; expr_root_id yields the
      # raw Int semantic id.
      if res_frame_has(frame, &tg_compiler::ids::LocalId { id: root }) then
        apply_consume(typed, root, m.scrutinee.span, loop_outer, frame, errors)
      end
    when Option::None then ()
    end
  end
  mut arms = Vec::new()
  mut i = 0
  while i < m.arms.len() do
    # Each arm's pattern bindings and guard are evaluated on a private clone
    # of the pre-match frame; the clone is discarded after the arm, so an
    # effect in one arm's guard cannot leak into another arm or the join.
    mut arm_pre = res_frame_clone(frame)
    check_pattern(program, typed, env, ctx, &m.arms[i].pattern, loop_outer, &mut arm_pre, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    bind_pattern(env, typed, &m.arms[i].pattern, m.arms[i].pattern.span, &mut arm_pre, errors)
    match m.arms[i].guard_expr
    when Option::Some(g) then check_expr(program, typed, env, ctx, &g, loop_outer, &mut arm_pre, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    when Option::None then ()
    end
    mut arm = res_frame_clone(&arm_pre)
    check_block(program, typed, env, ctx, &m.arms[i].body, loop_outer, &mut arm, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    arms.push(arm)
    i = i + 1
  end
  let merged = merge_frames(&arms)
  frame_assign(frame, &merged)
  # / THE MATCH-JOIN — the join block's ENTRY state: the merged
  # arm exits (the arms' recorded exit frames — check_block's
  # run_cfg_block recorded the (entry, exit) pairs under the arm body
  # block ids). The join executes no statements — its exit frame is the
  # entry. Recorded under the join block's ALLOCATED synthetic id — READ
  # from the pre-built record by the join's origin (cfg_join_record_id,
  # the scrutinee's node id; the state walk never allocates block ids) —
  # the single-pass merge (the match region is acyclic: one merge, no
  # re-execution).
  let join_id = cfg_join_record_id(blocks, m.scrutinee.node_id)
  if join_id != 0 then
    record_block_frame(ctx, join_id, res_frame_clone(&merged), res_frame_clone(&merged))
  end
end

def check_loop(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, cond: Option[Expr], body: Block, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], stmt_node_id: Int, inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  let entry = res_frame_clone(frame)
 # boundary: the frame's entry keys are LocalId; the loop-context
  # domains (loop_outer, current_loop_entry) and the backedge plan carry
  # the raw Int semantic ids the MIR consumes — extract `.id` here.
  var entry_names = Vec::new()
  for lid in res_frame_names_clone(&entry) do
    entry_names.push(lid.id)
  end
  match cond
  when Option::Some(c) then
    check_expr(program, typed, env, ctx, c, &entry_names, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when Option::None then ()
  end
  # while/loop have no per-iteration pattern binding: no iteration-escape
  # guard (the FIX 2 projected-iteration guard applies to for-loops only),
  # and no projected-iteration root (no projected access).
  var no_iter_binding = Vec::new()
  var no_projected_fields = Vec::new()
  let cond_source = match cond
  when Option::Some(c2) then c2.node_id
  when Option::None then -1
  end
  let after = check_loop_body(program, typed, env, ctx, body, &entry, &entry_names, &no_iter_binding, -1, &no_projected_fields, errors, finalize_plan, edges, blocks, stmt_node_id, current_loop_entry, defer_chain, cond_source)
  frame_assign(frame, &after)
  # / THE LOOP-JOIN — the loop's continuation block's (entry, exit)
  # frames: the after-frame (the fixed point check_loop_body computed —
  # the loop's exit state) recorded under the join block's ALLOCATED
  # synthetic id — READ from the pre-built record by the join's origin
  # (cfg_join_record_id: the while's cond node id / the cond-less loop's
  # statement node id; the state walk never allocates block ids, so the
  # for/loop continuation's frame key can never collide with the lexical
  # block key of a `for x in xs ... end; after()` top-level block — the
  # P0 collision class). The join executes no statements — its exit
  # frame is the entry.
  let join_origin = match cond
  when Option::Some(c2) then c2.node_id
  when Option::None then stmt_node_id
  end
  let join_id = cfg_join_record_id(blocks, join_origin)
  if join_id != 0 then
    record_block_frame(ctx, join_id, res_frame_clone(&after), res_frame_clone(&after))
  end
end

# ———————————————————————————————————————————————————————————————
# the projected-iteration decision (ported from the MIR).
#
# The MIR's lower_for used to decide by itself whether the projected
# (zero-copy, by-reference) iteration scheme is safe, by scanning the loop
# body for uses of the binding name (for_block_uses_name / for_expr_uses_name
# / for_expr_mentions_name in mir.tg). That semantic decision now belongs
# HERE, before MIR: the plan_* functions below are the faithful port of that
# scan, and for_iteration_plan encodes its outcome in the IterationPlan the
# MIR consumes. The MIR keeps its own copies ONLY as the documented fallback
# for IR-only / synthesized for-stmts that never passed through the checker.
#
# Port fidelity notes (behavior must stay IDENTICAL for the compiler's own
# valid code):
#   - A field access or index whose BASE is the bare binding name is NOT a
#     use (x.field / x[i]): under projected iteration the binding is a
#     reference and lower_place auto-inserts the ProjDeref, so these read
#     correctly through the reference.
#   - An explicit &expr call argument rooted at the binding is a use; for a
#     non-bare root (recv.field) the MIR's scan only counts it when the
#     callee parameter is not a let (read) parameter — plan_ref_param_is_read
#     mirrors that via the typed access_effects (the same map the MIR's
#     builder clones).
#   - Any mention of the name inside a closure body counts as a use (the
#     closure capture would capture the projected binding).
#   - StmtLet / pattern positions are NOT scanned (the binding is shadowed
#     there).
# ———————————————————————————————————————————————————————————————

def for_iter_place_like(iter: Expr) -> Bool
  match iter.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprSelfRef then true
  when ExprKind::ExprFieldAccess(_, _) then true
  when ExprKind::ExprRawDeref(_) then true
  when ExprKind::ExprIndex(_, _) then true
  when _ then false
  end  end
end

# Bare type name: strip any "::" module qualifier (mirror of the MIR's
# mir_bare_type_name), so "std::collections::Vec" classifies as "Vec".
def for_bare_type_name(name: String) -> String
  match name.rfind("::")
  when Option::Some(pos) then name.slice(pos + 2, name.len())
  when Option::None then name.clone()
  end  end
end

# Classify the iterable's TYPE (from the typed program — the same source the
# MIR's mir_infer_expr_type uses) into (source_kind, element_type):
#   0 = array/vec/slice, 1 = map, 2 = set, 3 = range;
#   (-1, Type::Unit) = unclassifiable → NO plan is recorded and the MIR keeps
#   its legacy heuristic fallback (identical behavior for unresolvable
#   iterators).
# STRING ITERATION: String itself is NOT a length-indexed collection for the
# projected path (its runtime value is a bare data pointer with no len header,
# and a String receiver would misread the Vec__len header offset) — the
# kernel iterates strings through the Slice-returning forms
# (s.chars()/s.bytes()/s.split(...), classified as Slice — kind 0 — when the
# iterable is a place) or through Vec[u8] forms (s.as_bytes()); method-call
# iterables get no plan and lower through the MIR's slice-aware fallback
# (MirLen's slice-view path and ProjIndex's slice data-pointer path in
# codegen.tg — verified), so String iteration is covered by the Slice/array
# classes, never by a direct String class.
def for_iter_type_kind(typed: TypedProgram, ty: Type) -> (Int, Type)
  match ty
  when Type::RefInternal(inner, _) then for_iter_type_kind(typed, inner)
  when Type::Adt(tid, args) then
 # the iteration-plan classification selects the builtin container
    # identities by the LangItems TypeIds (the typed program's canonical
    # snapshot — the same table the MIR's container dispatch uses) — never
    # by the registered name. An id missing from the snapshot (-1) fails
    # CLOSED to the unclassifiable class.
    let li = typed.lang_items
    if ((li.vec != -1 && tid.id == li.vec) || (li.array != -1 && tid.id == li.array) || (li.slice != -1 && tid.id == li.slice)) && args.len() > 0 then
      (0, args[0].clone())
    elsif li.map != -1 && tid.id == li.map && args.len() >= 2 then
      (1, args[1].clone())
    elsif li.set != -1 && tid.id == li.set && args.len() > 0 then
      (2, args[0].clone())
    else
      (-1, Type::Unit)
    end
  when _ then (-1, Type::Unit)
  end  end
end

def for_iterable_kind(typed: TypedProgram, iter: Expr) -> (Int, Type)
  match iter.kind
  when ExprKind::ExprRange(_, _, _) then (3, Type::Int)
  when _ then
    # The MIR's projected path only fires for PLACE iterables (Ident, self,
    # field access, raw deref, index); map/set/unknown iterables classify
    # through the type alone. Non-place iterables (e.g. `for x in vec![...]`)
    # get no plan → the MIR falls back to its heuristic, exactly as today.
    if for_iter_place_like(iter) then
      match typed.expr_types.get(iter.node_id)
      when Option::Some(iter_ty) then for_iter_type_kind(typed, &iter_ty)
      when Option::None then (-1, Type::Unit)
      end
    else
      (-1, Type::Unit)
    end
  end  end
end

def plan_expr_is_bare_binding(name: String, expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(n) then n == name
  when _ then false
  end  end
end

def plan_expr_rooted_at_binding(name: String, expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(n) then n == name
  when ExprKind::ExprFieldAccess(base, _) then plan_expr_rooted_at_binding(name, &base)
  when ExprKind::ExprIndex(base, _) then plan_expr_rooted_at_binding(name, &base)
  when _ then false
  end  end
end

def plan_ref_param_is_read(typed: TypedProgram, arg_expr: Expr) -> Bool
  match typed.access_effects.get(arg_expr.node_id)
  when Option::Some(AccessEffect::Read) then true
  when _ then false
  end  end
end

def plan_exprs_uses_binding(typed: TypedProgram, name: String, exprs: Vec[Expr]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < exprs.len() do
    if plan_expr_uses_binding(typed, name, &exprs[e_idx]) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def plan_fields_uses_binding(typed: TypedProgram, name: String, fields: Vec[(String, Expr)]) -> Bool
  var found = false
  var f_idx = 0
  while f_idx < fields.len() do
    if plan_expr_uses_binding(typed, name, &fields[f_idx].1) then found = true end
    f_idx = f_idx + 1
  end
  found
end

def plan_entries_uses_binding(typed: TypedProgram, name: String, entries: Vec[(Expr, Expr)]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < entries.len() do
    if plan_expr_uses_binding(typed, name, &entries[e_idx].0) then found = true end
    if plan_expr_uses_binding(typed, name, &entries[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def plan_opt_expr_uses_binding(typed: TypedProgram, name: String, val_opt: Option[Expr]) -> Bool
  match val_opt
  when Option::Some(val) then plan_expr_uses_binding(typed, name, &val)
  when Option::None then false
  end  end
end

def plan_call_args_uses_binding(typed: TypedProgram, name: String, args: Vec[Expr]) -> Bool
  var found = false
  var a_idx = 0
  while a_idx < args.len() do
    if plan_call_arg_uses_binding(typed, name, &args[a_idx]) then found = true end
    a_idx = a_idx + 1
  end
  found
end

def plan_call_arg_uses_binding(typed: TypedProgram, name: String, arg: Expr) -> Bool
  match arg.kind
  when ExprKind::ExprAccess(inner) then
    if plan_expr_rooted_at_binding(name, &inner) then
      if plan_expr_is_bare_binding(name, &inner) then
        true
      else
        !plan_ref_param_is_read(typed, &inner)
      end
    else
      plan_expr_uses_binding(typed, name, &inner)
    end
  when _ then plan_expr_uses_binding(typed, name, arg)
  end  end
end

def plan_expr_uses_binding(typed: TypedProgram, name: String, expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(n) then n == name
  when ExprKind::ExprIntLit(_) then false
  when ExprKind::ExprFloatLit(_) then false
  when ExprKind::ExprStringLit(_) then false
  when ExprKind::ExprCharLit(_) then false
  when ExprKind::ExprBoolLit(_) then false
  when ExprKind::ExprNilLit then false
  when ExprKind::ExprPath(_) then false
  when ExprKind::ExprSelfRef then false
  when ExprKind::ExprArrayLit(elems) then plan_exprs_uses_binding(typed, name, &elems)
  when ExprKind::ExprTupleLit(elems) then plan_exprs_uses_binding(typed, name, &elems)
  when ExprKind::ExprStructLit(_, fields) then plan_fields_uses_binding(typed, name, &fields)
  when ExprKind::ExprMapLit(entries) then plan_entries_uses_binding(typed, name, &entries)
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    plan_expr_uses_binding(typed, name, &lhs) || plan_expr_uses_binding(typed, name, &rhs)
  when ExprKind::ExprUnaryOp(_, operand) then plan_expr_uses_binding(typed, name, &operand)
  when ExprKind::ExprFieldAccess(base, _) then
    if plan_expr_is_bare_binding(name, &base) then
      false
    else
      plan_expr_uses_binding(typed, name, &base)
    end
  when ExprKind::ExprIndex(base, idx) then
    let base_unsafe = if plan_expr_is_bare_binding(name, &base) then
      false
    else
      plan_expr_uses_binding(typed, name, &base)
    end
    base_unsafe || plan_expr_uses_binding(typed, name, &idx)
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    if plan_expr_rooted_at_binding(name, &receiver) then
      true
    else
      if plan_expr_uses_binding(typed, name, &receiver) then
        true
      else
        plan_exprs_uses_binding(typed, name, &args)
      end
    end
  when ExprKind::ExprCall(callee, args) then
    if plan_expr_rooted_at_binding(name, &callee) then
      true
    else
      if plan_expr_uses_binding(typed, name, &callee) then
        true
      else
        plan_call_args_uses_binding(typed, name, &args)
      end
    end
  when ExprKind::ExprClosure(_, _, body) then plan_expr_mentions_binding(typed, name, &body)
  when ExprKind::ExprAccess(inner) then
    if plan_expr_rooted_at_binding(name, &inner) then
      true
    else
      plan_expr_uses_binding(typed, name, &inner)
    end
  when ExprKind::ExprRawDeref(inner) then
    if plan_expr_rooted_at_binding(name, &inner) then
      true
    else
      plan_expr_uses_binding(typed, name, &inner)
    end
  when ExprKind::ExprIf(if_stmt) then plan_if_uses_binding(typed, name, &if_stmt)
  when ExprKind::ExprMatch(m) then plan_match_uses_binding(typed, name, &m)
  when ExprKind::ExprBlock(block) then plan_block_uses_binding(typed, name, &block)
  when ExprKind::ExprUnsafe(_, block) then plan_block_uses_binding(typed, name, &block)
  when ExprKind::ExprAsync(block) then plan_block_uses_binding(typed, name, &block)
  when ExprKind::ExprAwait(inner) then plan_expr_uses_binding(typed, name, &inner)
  when ExprKind::ExprTry(inner) then plan_expr_uses_binding(typed, name, &inner)
  when ExprKind::ExprRange(lo, hi, _) then
    let lo_unsafe = match lo
    when Option::Some(lo_e) then plan_expr_uses_binding(typed, name, &lo_e)
    when Option::None then false
    end
    let hi_unsafe = match hi
    when Option::Some(hi_e) then plan_expr_uses_binding(typed, name, &hi_e)
    when Option::None then false
    end
    lo_unsafe || hi_unsafe
  when ExprKind::ExprCast(inner, _) then plan_expr_uses_binding(typed, name, &inner)
  when ExprKind::ExprTypeCheck(inner, _) then plan_expr_uses_binding(typed, name, &inner)
  when ExprKind::ExprComptime(block) then plan_block_uses_binding(typed, name, &block)
  when ExprKind::ExprEnumVariant(_, args) then plan_exprs_uses_binding(typed, name, &args)
  when ExprKind::ExprAssign(target, value) then
    if plan_expr_rooted_at_binding(name, &target) then
      true
    else
      plan_expr_uses_binding(typed, name, &target) || plan_expr_uses_binding(typed, name, &value)
    end
  when ExprKind::ExprPipe(lhs, rhs) then
    plan_expr_uses_binding(typed, name, &lhs) || plan_expr_uses_binding(typed, name, &rhs)
  when ExprKind::ExprMacroCall(_, args) then plan_exprs_uses_binding(typed, name, &args)
  when ExprKind::ExprError(_) then false
  when _ then false
  end  end
end

def plan_block_uses_binding(typed: TypedProgram, name: String, block: Block) -> Bool
  var found = false
  var stmt_idx = 0
  while stmt_idx < block.stmts.len() do
    if plan_stmt_uses_binding(typed, name, &block.stmts[stmt_idx]) then
      found = true
    end
    stmt_idx = stmt_idx + 1
  end
  found
end

def plan_if_uses_binding(typed: TypedProgram, name: String, if_stmt: IfStmt) -> Bool
  var found = plan_expr_uses_binding(typed, name, &if_stmt.cond)
  if plan_block_uses_binding(typed, name, &if_stmt.then_block) then found = true end
  var e_idx = 0
  while e_idx < if_stmt.elsif_branches.len() do
    if plan_expr_uses_binding(typed, name, &if_stmt.elsif_branches[e_idx].0) then found = true end
    if plan_block_uses_binding(typed, name, &if_stmt.elsif_branches[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then if plan_block_uses_binding(typed, name, &eb) then found = true end
  when Option::None then ()
  end
  found
end

def plan_match_uses_binding(typed: TypedProgram, name: String, m: MatchExpr) -> Bool
  var found = plan_expr_uses_binding(typed, name, &m.scrutinee)
  var a_idx = 0
  while a_idx < m.arms.len() do
    let arm = m.arms[a_idx]
    match arm.guard_expr
    when Option::Some(guard) then if plan_expr_uses_binding(typed, name, &guard) then found = true end
    when Option::None then ()
    end
    if plan_block_uses_binding(typed, name, &arm.body) then found = true end
    a_idx = a_idx + 1
  end
  found
end

def plan_stmt_uses_binding(typed: TypedProgram, name: String, stmt: Stmt) -> Bool
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then plan_expr_uses_binding(typed, name, &value)
  when StmtKind::StmtAssign(target, value) then
    plan_expr_rooted_at_binding(name, &target) ||
    plan_expr_uses_binding(typed, name, &target) ||
    plan_expr_uses_binding(typed, name, &value)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    plan_expr_rooted_at_binding(name, &target) ||
    plan_expr_uses_binding(typed, name, &target) ||
    plan_expr_uses_binding(typed, name, &value)
  when StmtKind::StmtIf(if_stmt) then plan_if_uses_binding(typed, name, &if_stmt)
  when StmtKind::StmtMatch(m) then plan_match_uses_binding(typed, name, &m)
  when StmtKind::StmtWhile(cond, body) then
    plan_expr_uses_binding(typed, name, &cond) || plan_block_uses_binding(typed, name, &body)
  when StmtKind::StmtFor(for_stmt) then
    plan_expr_rooted_at_binding(name, &for_stmt.iter) ||
    plan_expr_uses_binding(typed, name, &for_stmt.iter) ||
    plan_block_uses_binding(typed, name, &for_stmt.body)
  when StmtKind::StmtLoop(body) then plan_block_uses_binding(typed, name, &body)
  when StmtKind::StmtReturn(val_opt) then plan_opt_expr_uses_binding(typed, name, &val_opt)
  when StmtKind::StmtBreak(val_opt) then plan_opt_expr_uses_binding(typed, name, &val_opt)
  when StmtKind::StmtContinue then false
  when StmtKind::StmtExpr(expr) then plan_expr_uses_binding(typed, name, &expr)
  when StmtKind::StmtUnsafe(_, block) then plan_block_uses_binding(typed, name, &block)
  when StmtKind::StmtDefer(block) then plan_block_uses_binding(typed, name, &block)
  when StmtKind::StmtGuard(cond, else_action) then
    var found = plan_expr_uses_binding(typed, name, &cond)
    match else_action
    when GuardElse::Return(opt) then
      match opt
      when Option::Some(val) then if plan_expr_uses_binding(typed, name, &val) then found = true end
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(opt) then
      match opt
      when Option::Some(val) then if plan_expr_uses_binding(typed, name, &val) then found = true end
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
    found
  when StmtKind::StmtTry(body, catches, finally_block) then
    var found = plan_block_uses_binding(typed, name, &body)
    var c_idx = 0
    while c_idx < catches.len() do
      if plan_block_uses_binding(typed, name, &catches[c_idx].body) then found = true end
      c_idx = c_idx + 1
    end
    match finally_block
    when Option::Some(fb) then if plan_block_uses_binding(typed, name, &fb) then found = true end
    when Option::None then ()
    end
    found
  when StmtKind::StmtWith(expr, _, block) then
    plan_expr_uses_binding(typed, name, &expr) || plan_block_uses_binding(typed, name, &block)
  when StmtKind::StmtHandleWith(expr, handlers) then
    var found = plan_expr_uses_binding(typed, name, &expr)
    var h_idx = 0
    while h_idx < handlers.len() do
      let handler = handlers[h_idx]
      var a_idx = 0
      while a_idx < handler.arms.len() do
        if plan_block_uses_binding(typed, name, &handler.arms[a_idx].body) then found = true end
        a_idx = a_idx + 1
      end
      h_idx = h_idx + 1
    end
    found
  when _ then false
  end  end
end

def plan_exprs_mention_binding(typed: TypedProgram, name: String, exprs: Vec[Expr]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < exprs.len() do
    if plan_expr_mentions_binding(typed, name, &exprs[e_idx]) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def plan_opt_expr_mentions_binding(typed: TypedProgram, name: String, val_opt: Option[Expr]) -> Bool
  match val_opt
  when Option::Some(val) then plan_expr_mentions_binding(typed, name, &val)
  when Option::None then false
  end  end
end

def plan_block_mentions_binding(typed: TypedProgram, name: String, block: Block) -> Bool
  var found = false
  var stmt_idx = 0
  while stmt_idx < block.stmts.len() do
    if plan_stmt_mentions_binding(typed, name, &block.stmts[stmt_idx]) then found = true end
    stmt_idx = stmt_idx + 1
  end
  found
end

def plan_if_mentions_binding(typed: TypedProgram, name: String, if_stmt: IfStmt) -> Bool
  var found = plan_expr_mentions_binding(typed, name, &if_stmt.cond)
  if plan_block_mentions_binding(typed, name, &if_stmt.then_block) then found = true end
  var e_idx = 0
  while e_idx < if_stmt.elsif_branches.len() do
    if plan_expr_mentions_binding(typed, name, &if_stmt.elsif_branches[e_idx].0) then found = true end
    if plan_block_mentions_binding(typed, name, &if_stmt.elsif_branches[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then if plan_block_mentions_binding(typed, name, &eb) then found = true end
  when Option::None then ()
  end
  found
end

def plan_match_mentions_binding(typed: TypedProgram, name: String, m: MatchExpr) -> Bool
  var found = plan_expr_mentions_binding(typed, name, &m.scrutinee)
  var a_idx = 0
  while a_idx < m.arms.len() do
    let arm = m.arms[a_idx]
    match arm.guard_expr
    when Option::Some(guard) then if plan_expr_mentions_binding(typed, name, &guard) then found = true end
    when Option::None then ()
    end
    if plan_block_mentions_binding(typed, name, &arm.body) then found = true end
    a_idx = a_idx + 1
  end
  found
end

def plan_expr_mentions_binding(typed: TypedProgram, name: String, expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(n) then n == name
  when ExprKind::ExprIntLit(_) then false
  when ExprKind::ExprFloatLit(_) then false
  when ExprKind::ExprStringLit(_) then false
  when ExprKind::ExprCharLit(_) then false
  when ExprKind::ExprBoolLit(_) then false
  when ExprKind::ExprNilLit then false
  when ExprKind::ExprPath(_) then false
  when ExprKind::ExprSelfRef then false
  when ExprKind::ExprArrayLit(elems) then plan_exprs_mention_binding(typed, name, &elems)
  when ExprKind::ExprTupleLit(elems) then plan_exprs_mention_binding(typed, name, &elems)
  when ExprKind::ExprStructLit(_, fields) then plan_fields_mentions_binding(typed, name, &fields)
  when ExprKind::ExprMapLit(entries) then plan_entries_mentions_binding(typed, name, &entries)
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    plan_expr_mentions_binding(typed, name, &lhs) || plan_expr_mentions_binding(typed, name, &rhs)
  when ExprKind::ExprUnaryOp(_, operand) then plan_expr_mentions_binding(typed, name, &operand)
  when ExprKind::ExprFieldAccess(base, _) then plan_expr_mentions_binding(typed, name, &base)
  when ExprKind::ExprIndex(base, idx) then
    plan_expr_mentions_binding(typed, name, &base) || plan_expr_mentions_binding(typed, name, &idx)
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    if plan_expr_mentions_binding(typed, name, &receiver) then
      true
    else
      plan_exprs_mention_binding(typed, name, &args)
    end
  when ExprKind::ExprCall(callee, args) then
    if plan_expr_mentions_binding(typed, name, &callee) then
      true
    else
      plan_exprs_mention_binding(typed, name, &args)
    end
  when ExprKind::ExprClosure(_, _, body) then plan_expr_mentions_binding(typed, name, &body)
  when ExprKind::ExprAccess(inner) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprRawDeref(inner) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprIf(if_stmt) then plan_if_mentions_binding(typed, name, &if_stmt)
  when ExprKind::ExprMatch(m) then plan_match_mentions_binding(typed, name, &m)
  when ExprKind::ExprBlock(block) then plan_block_mentions_binding(typed, name, &block)
  when ExprKind::ExprUnsafe(_, block) then plan_block_mentions_binding(typed, name, &block)
  when ExprKind::ExprAsync(block) then plan_block_mentions_binding(typed, name, &block)
  when ExprKind::ExprAwait(inner) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprTry(inner) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprRange(lo, hi, _) then
    let lo_unsafe = match lo
    when Option::Some(lo_e) then plan_expr_mentions_binding(typed, name, &lo_e)
    when Option::None then false
    end
    let hi_unsafe = match hi
    when Option::Some(hi_e) then plan_expr_mentions_binding(typed, name, &hi_e)
    when Option::None then false
    end
    lo_unsafe || hi_unsafe
  when ExprKind::ExprCast(inner, _) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprTypeCheck(inner, _) then plan_expr_mentions_binding(typed, name, &inner)
  when ExprKind::ExprComptime(block) then plan_block_mentions_binding(typed, name, &block)
  when ExprKind::ExprEnumVariant(_, args) then plan_exprs_mention_binding(typed, name, &args)
  when ExprKind::ExprAssign(target, value) then
    plan_expr_mentions_binding(typed, name, &target) || plan_expr_mentions_binding(typed, name, &value)
  when ExprKind::ExprPipe(lhs, rhs) then
    plan_expr_mentions_binding(typed, name, &lhs) || plan_expr_mentions_binding(typed, name, &rhs)
  when ExprKind::ExprMacroCall(_, args) then plan_exprs_mention_binding(typed, name, &args)
  when ExprKind::ExprError(_) then false
  when _ then false
  end  end
end

def plan_fields_mentions_binding(typed: TypedProgram, name: String, fields: Vec[(String, Expr)]) -> Bool
  var found = false
  var f_idx = 0
  while f_idx < fields.len() do
    if plan_expr_mentions_binding(typed, name, &fields[f_idx].1) then found = true end
    f_idx = f_idx + 1
  end
  found
end

def plan_entries_mentions_binding(typed: TypedProgram, name: String, entries: Vec[(Expr, Expr)]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < entries.len() do
    if plan_expr_mentions_binding(typed, name, &entries[e_idx].0) then found = true end
    if plan_expr_mentions_binding(typed, name, &entries[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def plan_stmt_mentions_binding(typed: TypedProgram, name: String, stmt: Stmt) -> Bool
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then plan_expr_mentions_binding(typed, name, &value)
  when StmtKind::StmtAssign(target, value) then
    plan_expr_mentions_binding(typed, name, &target) || plan_expr_mentions_binding(typed, name, &value)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    plan_expr_mentions_binding(typed, name, &target) || plan_expr_mentions_binding(typed, name, &value)
  when StmtKind::StmtIf(if_stmt) then plan_if_mentions_binding(typed, name, &if_stmt)
  when StmtKind::StmtMatch(m) then plan_match_mentions_binding(typed, name, &m)
  when StmtKind::StmtWhile(cond, body) then
    plan_expr_mentions_binding(typed, name, &cond) || plan_block_mentions_binding(typed, name, &body)
  when StmtKind::StmtFor(for_stmt) then
    plan_expr_mentions_binding(typed, name, &for_stmt.iter) || plan_block_mentions_binding(typed, name, &for_stmt.body)
  when StmtKind::StmtLoop(body) then plan_block_mentions_binding(typed, name, &body)
  when StmtKind::StmtReturn(val_opt) then plan_opt_expr_mentions_binding(typed, name, &val_opt)
  when StmtKind::StmtBreak(val_opt) then plan_opt_expr_mentions_binding(typed, name, &val_opt)
  when StmtKind::StmtContinue then false
  when StmtKind::StmtExpr(expr) then plan_expr_mentions_binding(typed, name, &expr)
  when StmtKind::StmtUnsafe(_, block) then plan_block_mentions_binding(typed, name, &block)
  when StmtKind::StmtDefer(block) then plan_block_mentions_binding(typed, name, &block)
  when StmtKind::StmtGuard(cond, else_action) then
    var found = plan_expr_mentions_binding(typed, name, &cond)
    match else_action
    when GuardElse::Return(opt) then
      match opt
      when Option::Some(val) then if plan_expr_mentions_binding(typed, name, &val) then found = true end
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(opt) then
      match opt
      when Option::Some(val) then if plan_expr_mentions_binding(typed, name, &val) then found = true end
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
    found
  when StmtKind::StmtTry(body, catches, finally_block) then
    var found = plan_block_mentions_binding(typed, name, &body)
    var c_idx = 0
    while c_idx < catches.len() do
      if plan_block_mentions_binding(typed, name, &catches[c_idx].body) then found = true end
      c_idx = c_idx + 1
    end
    match finally_block
    when Option::Some(fb) then if plan_block_mentions_binding(typed, name, &fb) then found = true end
    when Option::None then ()
    end
    found
  when StmtKind::StmtWith(expr, _, block) then
    plan_expr_mentions_binding(typed, name, &expr) || plan_block_mentions_binding(typed, name, &block)
  when StmtKind::StmtHandleWith(expr, handlers) then
    var found = plan_expr_mentions_binding(typed, name, &expr)
    var h_idx = 0
    while h_idx < handlers.len() do
      let handler = handlers[h_idx]
      var a_idx = 0
      while a_idx < handler.arms.len() do
        if plan_block_mentions_binding(typed, name, &handler.arms[a_idx].body) then found = true end
        a_idx = a_idx + 1
      end
      h_idx = h_idx + 1
    end
    found
  when _ then false
  end  end
end

# is the projected iteration scheme safe for this loop? The faithful
# port of the MIR's for_body_is_projected_safe (pattern must be a plain
# non-"_" Ident whose name is not used by the body) — the semantic decision
# the MIR used to make for itself.
def plan_body_is_projected_safe(typed: TypedProgram, pat: Pattern, body: Block) -> Bool
  match pat.kind
  when PatternKind::Ident(name, _) then
    if name == "_" then
      false
    else
      !plan_block_uses_binding(typed, name, body)
    end
  when _ then false
  end  end
end

# build the typed iteration plan for a for-stmt. Option::None means
# the iterable could not be classified (unresolvable / non-place iterable):
# no plan is recorded and the MIR's legacy heuristic fallback handles the
# loop exactly as before. For classified iterables the access encodes what
# the MIR's lowering already does:
#   - array/vec/slice (kind 0): projected (Read) when the pattern is a plain
#     Ident whose name the body does not use — OR when the element type is
# NOT Copy (the consuming desugar raw-copies each element out of
#     the collection's storage, which is sound only for Copy elements; a
#     non-Copy element can never be consumed by value, so the loop must be
#     projected — the binding is bound by reference, reads through it are
#     the safe semantics, and the projected-iteration guard rejects moves
#     out of the binding). Snapshot (Consume) only for Copy elements whose
#     binding the body uses.
#   - map/set (kinds 1/2): snapshot (Consume) — the only supported map/set
#     iteration is the materialized-snapshot form (the snapshot is safe
#     against mutation of the live collection).
#   - range (kind 3): Read — the counter loop binds a plain Int value,
#     never a reference into a collection.
# The iterated collection's ROOT local id is recorded for the projected-
# mutation rule (rejecting mutation of the iterated collection inside the
# loop body where the access is projected).
def for_iteration_plan(typed: TypedProgram, env: TypeEnv, for_stmt: ForStmt, iter_binding_ids: Vec[Int]) -> Option[IterationPlan]
  let (kind, elem_ty) = for_iterable_kind(typed, &for_stmt.iter)
  if kind < 0 then
    return Option::None
  end
  let root_id = match expr_root_id(typed, &for_stmt.iter)
  when Option::Some(id) then id
  when Option::None then -1
  end
  let elem_is_copy = is_trivially_copyable(env, &elem_ty)
  let access = if kind == 0 then
 # a plain Ident pattern over a NON-Copy element is ALWAYS
    # projected — the consuming desugar would raw-bit-copy the element out
    # of the collection's storage (duplicating unique ownership, e.g. a
    # String pointer). The projected binding reads through the collection;
    # the escape guard rejects moves out of it. Copy elements keep the
    # legacy decision: projected when the body does not use the binding,
    # snapshot (raw copy — sound for Copy) otherwise.
    if !elem_is_copy then
      match for_stmt.pattern.kind
      when PatternKind::Ident(name, _) then
        if name == "_" then AccessEffect::Consume else AccessEffect::Read end
      when _ then AccessEffect::Consume
      end
    else
      if plan_body_is_projected_safe(typed, &for_stmt.pattern, &for_stmt.body) then
        AccessEffect::Read
      else
        AccessEffect::Consume
      end
    end
  elsif kind == 1 || kind == 2 then
    AccessEffect::Consume
  else
    AccessEffect::Read
  end
  Option::Some(IterationPlan {
    source_kind: kind,
    access: access,
    element_type: elem_ty,
    binding_ids: iter_binding_ids.clone(),
    iter_root_id: root_id
  })
end

# the projected-mutation rule's place identity. The field-name chain
# from the ROOT local (mirroring expr_root_id's recursion; ExprIndex is
# transparent — `coll[i]` and `coll[i].field` are places of `coll`) — the
# same key the loop's projected access reads, so a mutation with an equal
# key is a mutation of the iterated collection's storage.
def collect_place_field_chain(typed: TypedProgram, expr: Expr, inout out: Vec[String]) -> Unit
  match expr.kind
  when ExprKind::ExprFieldAccess(base, name) then
    collect_place_field_chain(typed, &base, out)
    out.push(name.clone())
  when ExprKind::ExprIndex(base, _) then collect_place_field_chain(typed, &base, out)
  when ExprKind::ExprAccess(inner) then collect_place_field_chain(typed, &inner, out)
  when ExprKind::ExprRawDeref(inner) then collect_place_field_chain(typed, &inner, out)
  when ExprKind::ExprCast(inner, _) then collect_place_field_chain(typed, &inner, out)
  when _ then ()
  end  end
end

# Does the expression denote the same place as the projected iterable —
# same root local id AND the same field chain from the root? A method-call
# receiver, a call argument, or an assignment target with this key touches
# the exact storage the projected for-loop reads.
def plan_place_key_matches(typed: TypedProgram, expr: Expr, root: Int, fields: Vec[String]) -> Bool
  match expr_root_id(typed, expr)
  when Option::Some(rid) then
    if rid != root then
      return false
    end
    var chain = Vec::new()
    collect_place_field_chain(typed, expr, &mut chain)
    if chain.len() != fields.len() then
      return false
    end
    var i = 0
    while i < chain.len() do
      if chain[i] != fields[i] then
        return false
      end
      i = i + 1
    end
    true
  when Option::None then false
  end  end
end

# The typed access effect of a receiver/argument node — the type checker's
# recorded convention (never re-derived by name); missing records default to
# Read.
def plan_expr_access_effect(typed: TypedProgram, expr: Expr) -> AccessEffect
  match typed.access_effects.get(expr.node_id)
  when Option::Some(e) then e
  when Option::None then AccessEffect::Read
  end  end
end

# does this expression MUTATE the projected iterable's place — a
# method call whose receiver is the place with a non-Read (Modify/Consume)
# effect, a call argument rooted at the place with a non-Read effect, or an
# assignment target rooted at the place? Reads (bare idents, field/index
# reads, method calls with Read receivers) are fine under projected
# iteration and are not flagged. Recurses through the whole expression
# structure (if/match/closures included).
def plan_expr_mutates_place(typed: TypedProgram, expr: Expr, root: Int, fields: Vec[String]) -> Bool
  match expr.kind
  when ExprKind::ExprIntLit(_) then false
  when ExprKind::ExprFloatLit(_) then false
  when ExprKind::ExprStringLit(_) then false
  when ExprKind::ExprCharLit(_) then false
  when ExprKind::ExprBoolLit(_) then false
  when ExprKind::ExprNilLit then false
  when ExprKind::ExprPath(_) then false
  when ExprKind::ExprSelfRef then false
  when ExprKind::ExprIdent(_) then false
  when ExprKind::ExprArrayLit(elems) then plan_exprs_mutate_place(typed, &elems, root, fields)
  when ExprKind::ExprTupleLit(elems) then plan_exprs_mutate_place(typed, &elems, root, fields)
  when ExprKind::ExprStructLit(_, struct_fields) then
    var found = false
    var f_idx = 0
    while f_idx < struct_fields.len() do
      if plan_expr_mutates_place(typed, &struct_fields[f_idx].1, root, fields) then found = true end
      f_idx = f_idx + 1
    end
    found
  when ExprKind::ExprMapLit(entries) then
    var found = false
    var e_idx = 0
    while e_idx < entries.len() do
      if plan_expr_mutates_place(typed, &entries[e_idx].0, root, fields) then found = true end
      if plan_expr_mutates_place(typed, &entries[e_idx].1, root, fields) then found = true end
      e_idx = e_idx + 1
    end
    found
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    plan_expr_mutates_place(typed, &lhs, root, fields) || plan_expr_mutates_place(typed, &rhs, root, fields)
  when ExprKind::ExprUnaryOp(_, operand) then plan_expr_mutates_place(typed, &operand, root, fields)
  when ExprKind::ExprFieldAccess(base, _) then plan_expr_mutates_place(typed, &base, root, fields)
  when ExprKind::ExprIndex(base, idx) then
    plan_expr_mutates_place(typed, &base, root, fields) || plan_expr_mutates_place(typed, &idx, root, fields)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    let recv_eff = plan_expr_access_effect(typed, &recv)
    var found = recv_eff != AccessEffect::Read && plan_place_key_matches(typed, &recv, root, fields)
    if plan_expr_mutates_place(typed, &recv, root, fields) then found = true end
    if plan_exprs_mutate_place(typed, &args, root, fields) then found = true end
    found
  when ExprKind::ExprCall(callee, args) then
    var found = plan_expr_mutates_place(typed, &callee, root, fields)
    var a_idx = 0
    while a_idx < args.len() do
      let arg_eff = plan_expr_access_effect(typed, &args[a_idx])
      if arg_eff != AccessEffect::Read && plan_place_key_matches(typed, &args[a_idx], root, fields) then
        found = true
      end
      if plan_expr_mutates_place(typed, &args[a_idx], root, fields) then found = true end
      a_idx = a_idx + 1
    end
    found
  when ExprKind::ExprClosure(_, _, body) then plan_expr_mutates_place(typed, &body, root, fields)
  when ExprKind::ExprAccess(inner) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprRawDeref(inner) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprIf(if_stmt) then plan_if_mutates_place(typed, &if_stmt, root, fields)
  when ExprKind::ExprMatch(m) then plan_match_mutates_place(typed, &m, root, fields)
  when ExprKind::ExprBlock(block) then plan_block_mutates_place(typed, &block, root, fields)
  when ExprKind::ExprUnsafe(_, block) then plan_block_mutates_place(typed, &block, root, fields)
  when ExprKind::ExprAsync(block) then plan_block_mutates_place(typed, &block, root, fields)
  when ExprKind::ExprAwait(inner) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprTry(inner) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprRange(lo, hi, _) then
    var found = false
    match lo
    when Option::Some(lo_e) then if plan_expr_mutates_place(typed, &lo_e, root, fields) then found = true end
    when Option::None then ()
    end
    match hi
    when Option::Some(hi_e) then if plan_expr_mutates_place(typed, &hi_e, root, fields) then found = true end
    when Option::None then ()
    end
    found
  when ExprKind::ExprCast(inner, _) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprTypeCheck(inner, _) then plan_expr_mutates_place(typed, &inner, root, fields)
  when ExprKind::ExprComptime(block) then plan_block_mutates_place(typed, &block, root, fields)
  when ExprKind::ExprEnumVariant(_, args) then plan_exprs_mutate_place(typed, &args, root, fields)
  when ExprKind::ExprAssign(target, value) then
    var found = plan_place_key_matches(typed, &target, root, fields)
    if plan_expr_mutates_place(typed, &target, root, fields) then found = true end
    if plan_expr_mutates_place(typed, &value, root, fields) then found = true end
    found
  when ExprKind::ExprPipe(lhs, rhs) then
    plan_expr_mutates_place(typed, &lhs, root, fields) || plan_expr_mutates_place(typed, &rhs, root, fields)
  when ExprKind::ExprMacroCall(_, args) then plan_exprs_mutate_place(typed, &args, root, fields)
  when ExprKind::ExprError(_) then false
  when _ then false
  end  end
end

def plan_exprs_mutate_place(typed: TypedProgram, exprs: Vec[Expr], root: Int, fields: Vec[String]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < exprs.len() do
    if plan_expr_mutates_place(typed, &exprs[e_idx], root, fields) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def plan_block_mutates_place(typed: TypedProgram, block: Block, root: Int, fields: Vec[String]) -> Bool
  var found = false
  var stmt_idx = 0
  while stmt_idx < block.stmts.len() do
    if plan_stmt_mutates_place(typed, &block.stmts[stmt_idx], root, fields) then
      found = true
    end
    stmt_idx = stmt_idx + 1
  end
  found
end

def plan_if_mutates_place(typed: TypedProgram, if_stmt: IfStmt, root: Int, fields: Vec[String]) -> Bool
  var found = plan_expr_mutates_place(typed, &if_stmt.cond, root, fields)
  if plan_block_mutates_place(typed, &if_stmt.then_block, root, fields) then found = true end
  var e_idx = 0
  while e_idx < if_stmt.elsif_branches.len() do
    if plan_expr_mutates_place(typed, &if_stmt.elsif_branches[e_idx].0, root, fields) then found = true end
    if plan_block_mutates_place(typed, &if_stmt.elsif_branches[e_idx].1, root, fields) then found = true end
    e_idx = e_idx + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then if plan_block_mutates_place(typed, &eb, root, fields) then found = true end
  when Option::None then ()
  end
  found
end

def plan_match_mutates_place(typed: TypedProgram, m: MatchExpr, root: Int, fields: Vec[String]) -> Bool
  var found = plan_expr_mutates_place(typed, &m.scrutinee, root, fields)
  var a_idx = 0
  while a_idx < m.arms.len() do
    let arm = m.arms[a_idx]
    match arm.guard_expr
    when Option::Some(guard) then if plan_expr_mutates_place(typed, &guard, root, fields) then found = true end
    when Option::None then ()
    end
    if plan_block_mutates_place(typed, &arm.body, root, fields) then found = true end
    a_idx = a_idx + 1
  end
  found
end

# does this statement MUTATE the projected iterable's place? The
# statement-level shapes: assignment/compound-assignment targets rooted at
# the place, and every expression (calls, method calls, nested control
# flow) — see plan_expr_mutates_place. The loop body's per-statement scan in
# check_loop_body reports a conflict once per statement.
def plan_stmt_mutates_place(typed: TypedProgram, stmt: Stmt, root: Int, fields: Vec[String]) -> Bool
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then plan_expr_mutates_place(typed, &value, root, fields)
  when StmtKind::StmtAssign(target, value) then
    plan_place_key_matches(typed, &target, root, fields) ||
    plan_expr_mutates_place(typed, &target, root, fields) ||
    plan_expr_mutates_place(typed, &value, root, fields)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    plan_place_key_matches(typed, &target, root, fields) ||
    plan_expr_mutates_place(typed, &target, root, fields) ||
    plan_expr_mutates_place(typed, &value, root, fields)
  when StmtKind::StmtIf(if_stmt) then plan_if_mutates_place(typed, &if_stmt, root, fields)
  when StmtKind::StmtMatch(m) then plan_match_mutates_place(typed, &m, root, fields)
  when StmtKind::StmtWhile(cond, body) then
    plan_expr_mutates_place(typed, &cond, root, fields) || plan_block_mutates_place(typed, &body, root, fields)
  when StmtKind::StmtFor(for_stmt) then
    plan_expr_mutates_place(typed, &for_stmt.iter, root, fields) ||
    plan_block_mutates_place(typed, &for_stmt.body, root, fields)
  when StmtKind::StmtLoop(body) then plan_block_mutates_place(typed, &body, root, fields)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then plan_expr_mutates_place(typed, &val, root, fields)
    when Option::None then false
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then plan_expr_mutates_place(typed, &val, root, fields)
    when Option::None then false
    end
  when StmtKind::StmtContinue then false
  when StmtKind::StmtExpr(expr) then plan_expr_mutates_place(typed, &expr, root, fields)
  when StmtKind::StmtUnsafe(_, block) then plan_block_mutates_place(typed, &block, root, fields)
  when StmtKind::StmtDefer(block) then plan_block_mutates_place(typed, &block, root, fields)
  when StmtKind::StmtGuard(cond, else_action) then
    var found = plan_expr_mutates_place(typed, &cond, root, fields)
    match else_action
    when GuardElse::Return(opt) then
      match opt
      when Option::Some(val) then if plan_expr_mutates_place(typed, &val, root, fields) then found = true end
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(opt) then
      match opt
      when Option::Some(val) then if plan_expr_mutates_place(typed, &val, root, fields) then found = true end
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
    found
  when StmtKind::StmtTry(body, catches, finally_block) then
    var found = plan_block_mutates_place(typed, &body, root, fields)
    var c_idx = 0
    while c_idx < catches.len() do
      if plan_block_mutates_place(typed, &catches[c_idx].body, root, fields) then found = true end
      c_idx = c_idx + 1
    end
    match finally_block
    when Option::Some(fb) then if plan_block_mutates_place(typed, &fb, root, fields) then found = true end
    when Option::None then ()
    end
    found
  when StmtKind::StmtWith(expr, _, block) then
    plan_expr_mutates_place(typed, &expr, root, fields) || plan_block_mutates_place(typed, &block, root, fields)
  when StmtKind::StmtHandleWith(expr, handlers) then
    var found = plan_expr_mutates_place(typed, &expr, root, fields)
    var h_idx = 0
    while h_idx < handlers.len() do
      let handler = handlers[h_idx]
      var a_idx = 0
      while a_idx < handler.arms.len() do
        if plan_block_mutates_place(typed, &handler.arms[a_idx].body, root, fields) then found = true end
        a_idx = a_idx + 1
      end
      h_idx = h_idx + 1
    end
    found
  when _ then false
  end  end
end

def check_for(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, for_stmt: ForStmt, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], stmt_node_id: Int, inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  let pre_entry = res_frame_clone(frame)
 # boundary: the frame's entry keys are LocalId; the loop-context
  # domains (loop_outer, current_loop_entry) carry the raw Int semantic ids
  # the MIR consumes — extract `.id` here.
  var pre_entry_names = Vec::new()
  for lid in res_frame_names_clone(&pre_entry) do
    pre_entry_names.push(lid.id)
  end
  check_pattern(program, typed, env, ctx, &for_stmt.pattern, &pre_entry_names, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  bind_pattern(env, typed, &for_stmt.pattern, for_stmt.span, frame, errors)
  check_expr(program, typed, env, ctx, &for_stmt.iter, &pre_entry_names, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
 # record the pattern binding's id(s) — under the current projected
  # iteration the MIR binds elements by REFERENCE (it never consumes them),
  # so the iteration binding must not be movable out of the loop body.
  # VERIFIED: the pattern binding id is NOT collected by the loop-created
  # backedge plan — it is bound BEFORE the entry snapshot below, so it sits
  # in entry_names with Live state and is_loop_created excludes it. That is
  # correct under projected iteration (the MIR binding is a reference: there
  # is nothing to finalize per iteration), and the guard in check_loop_body
  # prevents the only state in which per-iteration cleanup would matter (a
  # move out of the binding), which is exactly the consuming iteration the
  # MIR does not support yet. Mapping the for-pattern id for per-iteration
  # backedge cleanup is a MIR-side prerequisite: lower_for/lower_for_projected
  # add the binding local without record_semantic_pattern_local, so the id
  # has no semantic_to_mir entry today.
  mut iter_binding_ids = Vec::new()
  collect_pattern_binding_ids(typed, &for_stmt.pattern, &mut iter_binding_ids)
 # produce the TYPED iteration plan for this for-stmt — the
  # projected-vs-consuming decision that used to live in the MIR's own
  # name-use scan — and record it keyed by the for-stmt's node id. The MIR
  # consumes it via ResourceCheckResult.iteration_plans; unclassifiable
  # iterables get no plan and the MIR's legacy heuristic remains the
  # documented fallback.
 # the PROJECTED-MUTATION rule — under projected iteration the
  # binding reads the iterated collection's storage by reference, so the
  # checker must reject mutation of that collection inside the loop body
  # (push/pop/insert/remove/clear/set/index-assignment/... — anything that
  # may reallocate or rewrite the storage the projection reads). The rule
  # fires only when the access is projected (Read) and the iterable is a
  # rootable place; snapshot-based iteration (Map/Set, or a materialized
  # entries array) reads its own copy, so mutation of the live collection
  # is fine there. The iterable's place key (root local id + field chain)
  # is threaded into check_loop_body, whose per-statement scan
  # (plan_stmt_mutates_place) reports the conflict.
  var projected_root = -1
  var projected_fields = Vec::new()
  match for_iteration_plan(typed, env, for_stmt, &iter_binding_ids)
  when Option::Some(p) then
    if p.access == AccessEffect::Read && p.source_kind != 3 then
      match expr_root_id(typed, &for_stmt.iter)
      when Option::Some(rid) then
        projected_root = rid
        collect_place_field_chain(typed, &for_stmt.iter, &mut projected_fields)
      when Option::None then ()
      end
    end
    record_iteration_plan(ctx, stmt_node_id, p)
 # (phase 2): the typed iteration record is produced at the SAME
    # site — the typed-HIR serialization the MIR consumes (lower_for /
    # typed_iteration_of).
    record_typed_iteration(ctx, stmt_node_id, p)
  when Option::None then ()
  end
  let entry = res_frame_clone(frame)
 # boundary: same extraction as pre_entry_names above — the loop
  # machinery (check_loop_body's entry_names / current_loop_entry) is in
  # the raw-Int loop-context domain.
  var entry_names = Vec::new()
  for lid in res_frame_names_clone(&entry) do
    entry_names.push(lid.id)
  end
  let after = check_loop_body(program, typed, env, ctx, &for_stmt.body, &entry, &entry_names, &iter_binding_ids, projected_root, &projected_fields, errors, finalize_plan, edges, blocks, stmt_node_id, current_loop_entry, defer_chain, -1)
  frame_assign(frame, &after)
  # / THE FOR-JOIN — the for loop's continuation block's (entry,
  # exit) frames: the after-frame (the fixed point check_loop_body
  # computed) recorded under the join block's ALLOCATED synthetic id —
  # READ from the pre-built record by the join's origin
  # (cfg_join_record_id, the for stmt's node id; the state walk never
  # allocates block ids). The for stmt's node id keeps keying the
  # enclosing top-level block's LEXICAL record when the for opens the
  # block; the continuation's frame key is the disjoint negative
  # synthetic id — the P0 collision class recorded as two distinct
  # block_frames entries.
  let join_id = cfg_join_record_id(blocks, stmt_node_id)
  if join_id != 0 then
    record_block_frame(ctx, join_id, res_frame_clone(&after), res_frame_clone(&after))
  end
end

# under the CURRENT projected iteration the MIR binds each element by
# REFERENCE (it never consumes elements), so the iteration binding must not
# be movable out of the loop body — a transfer (transfer_consume /
# apply_consume on the binding's id) would move out of that reference.
# Called after EVERY loop-body statement: reports once per binding, the
# first statement after which the binding's state became Consumed.
def check_iter_binding_escape(typed: TypedProgram, iter_binding_ids: Vec[Int], inout reported: Vec[Bool], frame: ResFrame, span: Span, inout errors: Vec[ResourceError]) -> Unit
  mut i = 0
  while i < iter_binding_ids.len() do
    if !reported[i] then
 # boundary: iter_binding_ids are raw Int semantic ids (they also
      # serialize into the IterationPlan the MIR consumes); the frame is
      # LocalId-keyed.
      match res_frame_get(frame, &tg_compiler::ids::LocalId { id: iter_binding_ids[i] })
      when Option::Some(ResourceState::Consumed) then
        errors.push(ResourceError {
          message: "cannot move the iteration binding out of the loop body under projected iteration (consuming iteration is not supported yet)",
          span: span
        })
        reported[i] = true
      when _ then ()
      end
    end
    i = i + 1
  end
end

def check_loop_body(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, body: Block, entry: ResFrame, entry_names: Vec[Int], iter_binding_ids: Vec[Int], projected_root: Int, projected_fields: Vec[String], inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], loop_stmt_id: Int, inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int], exit_source: Int) -> ResFrame
 # (single-shot loops): when the body's FIRST DIRECT terminator is a
  # Break or Return (not a Continue), the fallthrough to the backedge is
  # UNREACHABLE — the loop executes at most once. The backedge then
  # contributes nothing to the loop-header join (the fixed point is the
  # pre-loop entry state), an OUTER resource consumed on the single-shot
  # path is consumed exactly once (the loop_outer exclusion is lifted for
  # the body run), the loop-created cleanup attaches to the loop's EXIT
  # edge (the condition's False edge) instead of the backedge, and the
  # after-frame is the body's exit frame (with the forget applied) — the
  # consumption is reflected in the after-state.
  mut single_shot = false
  mut si = 0
  while si < body.stmts.len() do
    if stmt_is_terminator(&body.stmts[si]) then
      match body.stmts[si].kind
      when StmtKind::StmtBreak(_) then single_shot = true
      when StmtKind::StmtReturn(_) then single_shot = true
      when _ then ()
      end
      break
    end
    si = si + 1
  end
  let body_loop_outer = if single_shot then Vec::new() else entry_names.clone()
  mut bf = res_frame_clone(entry)
  # The break/continue scope frontier inside this loop is the loop's entry
  # names: locals that predate the loop are NOT finalized by loop-exit edges.
  let saved_frontier = current_loop_entry.clone()
  *current_loop_entry = entry_names.clone()
 # the loop body is a lexical defer scope. Its key is pushed NEGATED
  # onto the defer chain: break/continue edges exit exactly the scopes nested
  # inside the loop, and the chain walk stops at the loop body scope (which
  # IS included — its defers run on every break/continue out of the body).
  # The body's defers also run per-iteration via the backedge plan (see
  # check_loop_created).
  let body_key = block_exit_key(body)
  if body_key != 0 then
    defer_chain.push(-body_key)
  end
 # (channel d): the loop body is a scope boundary for raw views —
  # a view bound inside the body dies with the iteration; the snapshot
  # removes the body-bound views after the run (the loop body has no
  # exit_scope of its own).
  let body_view_keys = slice_views_snapshot_keys(ctx)
 # (one TypedCFG): the LOOP-BODY WALK MOVES INTO THE CFG TRAVERSAL.
  # The body's CfgBlock record was recorded by the structural pass
  # (cfg_loop_body — id = the body's first statement node id, NO Normal
  # edge); the body's statements execute through the SAME per-block
  # machinery (run_cfg_block) as every lexical block, with the loop-body
  # per-statement checks carried by the LoopBodyScan: the projected-
  # iteration escape guard (once per binding) and the projected-
  # mutation scan (once per statement). The body's (entry, exit)
  # frames are RECORDED under the body block record's id — the documented
  # gap (loop-body blocks with no recorded exit frames) is CLOSED: the
  # terminator grounding reconciliation and the validate_cfg_edges
  # grounding checks now apply to every loop-body-originated edge.
  mut iter_reported = Vec::new()
  mut ri = 0
  while ri < iter_binding_ids.len() do
    iter_reported.push(false)
    ri = ri + 1
  end
  var body_scan = LoopBodyScan {
    iter_binding_ids: iter_binding_ids.clone(),
    iter_reported: iter_reported,
    projected_root: projected_root,
    projected_fields: projected_fields.clone(),
    reported_stmt_id: -1
  }
  let body_entry = res_frame_clone(&bf)
  let (body_exit, _) = run_cfg_block(program, typed, env, ctx, &body.stmts, &body_loop_outer, &body_entry, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain, body_key, Option::Some(body_scan))
  bf = body_exit
  slice_views_remove_after(ctx, &body_view_keys)
  if body_key != 0 then
    defer_chain.pop()
  end
  *current_loop_entry = saved_frontier
  let to_forget = check_loop_created(ctx, entry, entry_names, &bf, typed, errors, finalize_plan, edges, loop_stmt_id, body_key, single_shot, exit_source)
 # the BACKEDGE JOIN — the fixed point of the loop dataflow. The
  # per-iteration frame (bf — the ITERATION-LOCAL state: the loop-created
  # locals) and the loop entry frame (entry — the LOOP-PERSISTENT state:
  # the pre-loop locals, which the loop's entry frame includes) are distinct
  # BY CONSTRUCTION: check_loop_created derives the backedge obligations
  # (the Backedge edge actions) and the forget set (to_forget) from the
  # SAME is_loop_created filter, so the backedge drops exactly the
  # iteration-local locals and never touches a loop-persistent local.
  # Applying the forget set therefore resets the per-iteration frame to the
  # loop-persistent state, and the state that re-enters the header on the
  # next iteration is the loop entry frame itself — the loop dataflow
  # converges on the FIRST backedge join (the header's entry state is
  # invariant across iterations), so the analysis is at its fixed point.
  # The per-iteration frame resets every iteration; loop-created locals
  # never leak into the loop-persistent frame.
  ri = 0
  while ri < to_forget.len() do
    res_frame_forget(&mut bf, &to_forget[ri])
    ri = ri + 1
  end
 # the loop's after-frame is the loop-persistent frame — the fixed
  # point computed above — NOT the discarded per-iteration frame. For a
  # single-shot loop the fixed point is the body's exit frame itself: the
  # backedge never fires, so an outer resource consumed on the single-shot
  # path stays consumed in the after-state.
  if single_shot then
    res_frame_clone(&bf)
  else
    res_frame_clone(entry)
  end
end

def check_loop_created(inout ctx: AnalysisContext, entry: ResFrame, entry_names: Vec[Int], bf: ResFrame, typed: TypedProgram, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], loop_stmt_id: Int, loop_body_key: Int, single_shot: Bool, exit_source: Int) -> Vec[tg_compiler::ids::LocalId]
  mut to_forget = Vec::new()
 # the BACKEDGE edge's CleanupAction sequence — the loop body
  # scope's defers as RunDefer actions (LIFO) and the loop-created owning
  # locals as Drop actions, attached to the pre-built Backedge edge below.
  var backedge_actions = Vec::new()
 # defers registered directly in the loop body scope run LIFO at the
  # end of every iteration, before the backedge re-enters the header — their
  # bodies' locals are finalized by the backedge cleanup.
  if loop_body_key != 0 then
    append_defer_actions(finalize_plan, loop_body_key, &mut backedge_actions)
  end
  # Frame keys are LocalId (the Drop actions carry them); to_forget stays in
  # the frame's LocalId domain (it feeds res_frame_forget).
  for (id, ls) in bf.locals do
    match ls.availability
    when ResourceState::Live then
      if is_loop_created(entry, entry_names, &id) then
        if ls.is_capability then
          # A capability cannot be auto-finalized: it must be consumed.
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id.id) + "` created in loop must be consumed each iteration",
            span: ls.span
          })
        else
          # Owned resources are cleaned by the BACKEDGE: `loop { let p = Probe{}; }`
          # finalizes p at the end of each iteration automatically.
          backedge_actions.push(CleanupAction::Drop(id))
        end
        to_forget.push(id)
      end
    when ResourceState::MaybeLive then
      if is_loop_created(entry, entry_names, &id) then
        if ls.is_capability then
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id.id) + "` created in loop must be consumed each iteration",
            span: ls.span
          })
        else
          # A loop-created resource that is Live on one iteration path and
          # Consumed on another CANNOT be cleaned by the backedge: the
          # backedge cleanup lowers to an UNCONDITIONAL deinit, which would
          # double-finalize the value on the consumed path (deinit on the
          # consume path + deinit at the backedge). Until conditional
          # per-iteration cleanup exists, the mixed state is an error — the
          # consume must happen on every path or on none.
          errors.push(ResourceError {
            message: "resource `" + binding_name(typed, id.id) + "` created in loop may be consumed on one path; per-iteration cleanup cannot be conditional",
            span: ls.span
          })
        end
        to_forget.push(id)
      end
    when _ then ()
    end
  end
 # / the backedge obligation is ATTACHED to the pre-built
  # BACKEDGE edge record (the "backedge::<loop stmt id>" string-key
  # serialization is are not part of the model). An empty obligation means the CleanupEdge's
  # actions stay empty — the edge record still exists (the transfer
  # happens).
  if loop_body_key != 0 then
    if single_shot && exit_source >= 0 then
 # the backedge is unreachable — the loop-created cleanup runs
      # on the loop's EXIT edge (the condition's False edge) instead.
      attach_edge_actions(ctx, edges, CfgEdgeKind::False, exit_source, backedge_actions, errors)
    else
      attach_edge_actions(ctx, edges, CfgEdgeKind::Backedge, loop_stmt_id, backedge_actions, errors)
    end
  end
  to_forget
end

def is_loop_created(entry: ResFrame, entry_names: Vec[Int], id: tg_compiler::ids::LocalId) -> Bool
  # entry_names is the raw-Int loop-context domain; the LocalId is the
  # frame-key domain. A local present in the loop's ENTRY frame is
  # LOOP-PERSISTENT — it predates the loop and survives every iteration —
  # regardless of its entry availability state. (A set parameter may be
  # Uninitialized at entry and initialized inside the loop body: it is
  # still caller-owned memory that the backedge must never finalize, so it
  # is NOT loop-created. The pre-FIX clause treated entry-Uninitialized
  # locals as loop-created, which put a caller-owned set parameter into the
  # "backedge::<loop id>" drop plan — the callee finalizing the caller's
  # buffer.)
  !entry_names.contains(&id.id)
end

def check_pattern(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, pat: Pattern, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(e) then check_expr(program, typed, env, ctx, &e, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, env, ctx, &pats[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, env, ctx, &pats[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      check_pattern(program, typed, env, ctx, &field_pats[i].1, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, env, ctx, &pats[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      check_pattern(program, typed, env, ctx, &alts[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then check_expr(program, typed, env, ctx, &e, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then check_expr(program, typed, env, ctx, &e, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    when Option::None then ()
    end
  end  end
end

# Register a single pattern-bound identifier in the frame (Live availability,
# OwnedLocal permission — pattern bindings own their value).
def bind_pattern_ident(inout env: TypeEnv, typed: TypedProgram, node_id: Int, span: Span, inout frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  match typed.pattern_binding_resolutions.get(node_id)
  when Option::Some(id) then
    match typed.local_bindings.get(id)
    when Option::Some(lb) then
 # boundary: the typed pattern map is Int-keyed (semantic local
      # ids); the frame is LocalId-keyed. The id crosses into the frame
      # only as a constructed LocalId — a pattern NODE id (the node_id
      # param) can never index the frame, and a pattern-binding id can
      # never collide with a parameter id at the key type.
      let lid = tg_compiler::ids::LocalId { id: id }
      reject_rc_resource(env, typed, &lb.ty, span, errors)
      if is_owning_typed(env, &lb.ty) then
        res_frame_set(frame, lid, ResourceState::Live)
        res_frame_set_span(frame, &lid, span)
        res_frame_set_origin(frame, &lid, ParamOrigin::OwnedLocal)
      end
      if type_kind_contains_capability(env, &lb.ty) then
        res_frame_mark_cap(frame, &lid)
      end
    when Option::None then ()
    end
  when Option::None then ()
  end  end
end

# bind_pattern recurses through the WHOLE pattern structure (tuple, array,
# struct, enum-variant, or-patterns) so destructuring binds every inner
# resource ident — previously only a top-level Ident was registered, so
# `let (a, b) = pair` lost ownership of resource components.
def bind_pattern(inout env: TypeEnv, typed: TypedProgram, pat: Pattern, span: Span, inout frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  match pat.kind
  when PatternKind::Ident(_, _) then
    bind_pattern_ident(env, typed, pat.node_id, span, frame, errors)
  when PatternKind::Tuple(pats) then
    for p in pats do
      bind_pattern(env, typed, &p, span, frame, errors)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      bind_pattern(env, typed, &p, span, frame, errors)
    end
  when PatternKind::Struct(_, fields) then
    for f in fields do
      bind_pattern(env, typed, &f.1, span, frame, errors)
    end
  when PatternKind::Variant(_, pats) then
    for p in pats do
      bind_pattern(env, typed, &p, span, frame, errors)
    end
  when PatternKind::Or(alts) then
    for p in alts do
      bind_pattern(env, typed, &p, span, frame, errors)
    end
  when _ then ()
  end  end
end

# Collect the semantic local ids bound by a pattern, mirroring bind_pattern's
# recursion WITHOUT touching a frame. Used by the defer registration (the
# defer body's own locals, attached to the scope's exiting edges) and by the
# for-loop projected-iteration guard (the iteration binding's id(s)).
def collect_pattern_binding_ids(typed: TypedProgram, pat: Pattern, inout out: Vec[Int]) -> Unit
  match pat.kind
  when PatternKind::Ident(_, _) then
    match typed.pattern_binding_resolutions.get(pat.node_id)
    when Option::Some(id) then out.push(id)
    when Option::None then ()
    end
  when PatternKind::Tuple(pats) then
    for p in pats do
      collect_pattern_binding_ids(typed, &p, out)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      collect_pattern_binding_ids(typed, &p, out)
    end
  when PatternKind::Struct(_, fields) then
    for f in fields do
      collect_pattern_binding_ids(typed, &f.1, out)
    end
  when PatternKind::Variant(_, pats) then
    for p in pats do
      collect_pattern_binding_ids(typed, &p, out)
    end
  when PatternKind::Or(alts) then
    for p in alts do
      collect_pattern_binding_ids(typed, &p, out)
    end
  when _ then ()
  end  end
end

# Whether the i-th child of an aggregate literal is an OWNED transfer into
# the aggregate, per the typed ownership-effect record. A MISSING record for
# a typed aggregate is a compiler-internal error — ownership must not be
# re-derived by guessing (the record is mandatory; see the checker's
# aggregate-literal arms).
def aggregate_child_owned(typed: TypedProgram, expr: Expr, i: Int, inout errors: Vec[ResourceError]) -> Bool
  match typed.aggregate_ownership.get(expr.node_id)
  when Option::Some(owned) then
    if i < owned.len() then owned[i] else true end
  when Option::None then
    errors.push(ResourceError {
      message: "internal error: missing aggregate ownership record for expression node " + expr.node_id.to_string(),
      span: expr.span
    })
    true
  end  end
end

def check_expr(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, expr: Expr, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, env, ctx, &elems[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      # Owned children transfer INTO the array per the typed ownership record:
      # `let a = [r]` consumes r (previously r stayed Live and could be used
      # after the move, duplicating ownership).
      if aggregate_child_owned(typed, expr, i, errors) then
        transfer_consume(env, typed, &elems[i], loop_outer, frame, errors, finalize_plan)
      end
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, env, ctx, &elems[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      if aggregate_child_owned(typed, expr, i, errors) then
        transfer_consume(env, typed, &elems[i], loop_outer, frame, errors, finalize_plan)
      end
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      check_expr(program, typed, env, ctx, &fields[i].1, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      if aggregate_child_owned(typed, expr, i, errors) then
        transfer_consume(env, typed, &fields[i].1, loop_outer, frame, errors, finalize_plan)
      end
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      check_expr(program, typed, env, ctx, &entries[i].0, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      # Map literal keys AND values are owned transfers into the map.
      if aggregate_child_owned(typed, expr, i * 2, errors) then
        transfer_consume(env, typed, &entries[i].0, loop_outer, frame, errors, finalize_plan)
      end
      check_expr(program, typed, env, ctx, &entries[i].1, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      if aggregate_child_owned(typed, expr, i * 2 + 1, errors) then
        transfer_consume(env, typed, &entries[i].1, loop_outer, frame, errors, finalize_plan)
      end
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then check_use(typed, l, expr.span, frame, errors)
    when Option::None then ()
    end
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    check_expr(program, typed, env, ctx, &lhs, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &rhs, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprUnaryOp(_, operand) then
    check_expr(program, typed, env, ctx, &operand, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprFieldAccess(base, _) then
    check_expr(program, typed, env, ctx, &base, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    # (partial moves): the field READ is a CHAIN read — the root stays
    # live under a partial move, and a consumed chain is a use-after-move.
    check_place_chain_read(typed, &expr, frame, errors)
  when ExprKind::ExprMethodCall(recv, method, _, args) then
    check_expr_method_call(program, typed, env, ctx, &recv, &method, &args, expr.node_id, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprIndex(base, index) then
    check_expr(program, typed, env, ctx, &base, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &index, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    # (partial moves): the indexed READ is a chain read over the whole
    # value (the elements are the aggregate — the root-level check above
    # is the only per-index granularity the lattice has).
    check_place_chain_read(typed, &expr, frame, errors)
  when ExprKind::ExprCall(callee, args) then
    check_expr_call(program, typed, env, ctx, &callee, &args, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprClosure(params, _, body) then
    mut cframe = res_frame_new()
    let entry_ids = bind_closure_params(env, typed, &params, &mut cframe)
    # Closure capture transfer: the typed closure_captures map (closure node
    # id -> captured local id -> effect) is the SEMANTIC capture record. Each
    # captured resource moves into the closure exactly once: the outer local
    # is consumed and the closure's frame seeds the same local as Live +
    # OwnedLocal so the body can use (and finalize) it. Previously captures
    # were rediscovered independently and never transferred, so `let cl =
    # do |_| consume_r(r)` left r live in the outer scope.
    match typed.closure_captures.get(expr.node_id)
    when Option::Some(caps) then
      for (cap_id, cap_effect) in caps do
        match typed.local_bindings.get(cap_id)
        when Option::Some(lb) then
 # boundary: the typed capture map is Int-keyed (semantic local
          # ids); the frame is LocalId-keyed.
          let cap_lid = tg_compiler::ids::LocalId { id: cap_id }
          if is_owning_typed(env, &lb.ty) then
            # The typed capture EFFECT distinguishes how the closure body
            # USES the capture, but the closure environment is a BY-VALUE
            # struct: every capture of an owning local is a transfer of the
            # value into the closure. The type checker's capture scan
            # records Read for a bare name-read (`let c = || p`) and Modify
            # for an assignment target (`do |_| p.x =... end`); the MIR
            # lowers Consume captures as MirConsume (move) and Read/Modify
            # as MirCopy (copy of the value into the env) — either way the
            # ENV is the sole owner afterwards, so the OUTER local is
            # consumed exactly once and the closure frame owns the value.
            # Rejecting Read/Modify captures (the pre-FIX behavior) wrongly
            # rejected valid by-value captures (`canary_pos_closure_
            # capture_owner`); the duplication concern does not arise
            # because the outer local's state is consumed at the capture.
            match cap_effect
            when AccessEffect::Consume then
              if res_frame_has(frame, &cap_lid) then
                apply_consume(typed, cap_id, expr.span, loop_outer, frame, errors)
              end
              res_frame_set(&mut cframe, cap_lid, ResourceState::Live)
              res_frame_set_span(&mut cframe, &cap_lid, expr.span)
              res_frame_set_origin(&mut cframe, &cap_lid, ParamOrigin::OwnedLocal)
            when AccessEffect::Read then
              if res_frame_has(frame, &cap_lid) then
                apply_consume(typed, cap_id, expr.span, loop_outer, frame, errors)
              end
              res_frame_set(&mut cframe, cap_lid, ResourceState::Live)
              res_frame_set_span(&mut cframe, &cap_lid, expr.span)
              res_frame_set_origin(&mut cframe, &cap_lid, ParamOrigin::OwnedLocal)
            when AccessEffect::Modify then
              if res_frame_has(frame, &cap_lid) then
                apply_consume(typed, cap_id, expr.span, loop_outer, frame, errors)
              end
              res_frame_set(&mut cframe, cap_lid, ResourceState::Live)
              res_frame_set_span(&mut cframe, &cap_lid, expr.span)
              res_frame_set_origin(&mut cframe, &cap_lid, ParamOrigin::OwnedLocal)
            when _ then ()
            end
          end
          if type_kind_contains_capability(env, &lb.ty) then
            res_frame_mark_cap(&mut cframe, &cap_lid)
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
    # The closure body is its own scope nesting: a FRESH defer chain (the
    # closure's blocks push/pop their own keys; enclosing scopes' defers do
    # not apply inside the closure).
    var closure_defer_chain = Vec::new()
 # (channel d): the closure body is a scope boundary for slice
    # views (views bound inside the closure are closure-local — removed
    # after the body check; they must not outlive the closure).
    let closure_view_keys = slice_views_snapshot_keys(ctx)
    check_expr(program, typed, env, ctx, &body, &Vec::new(), &mut cframe, errors, finalize_plan, edges, blocks, current_loop_entry, &mut closure_defer_chain)
    slice_views_remove_after(ctx, &closure_view_keys)
    # Record the closure's authoritative finalize set BEFORE exit_scope
 # erases body-owned locals (see check_function). the SEMANTIC
    # record under the closure expression's NodeId (the "closure::<node id>"
    # String-key protocol is are not part of the model).
    record_closure_cleanup(typed, &cframe, expr.node_id, finalize_plan)
    exit_scope(&mut cframe, &entry_ids, typed, errors)
    check_uninitialized_exit(&cframe, typed, errors)
  when ExprKind::ExprAccess(inner) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprRawDeref(inner) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprIf(if_stmt) then
    check_if(program, typed, env, ctx, &if_stmt, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprMatch(m) then
    check_match(program, typed, env, ctx, &m, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprBlock(block) then
    check_block(program, typed, env, ctx, &block, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprUnsafe(_, block) then
    check_block(program, typed, env, ctx, &block, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprAsync(block) then
    check_block(program, typed, env, ctx, &block, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprAwait(inner) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
 # `expr?` is ERASURE — no throwing path exists for it (no throw
  # expression, no error propagation, no Throw/Unwind CFG edge). The
  # operand is checked as a pure expression, the same treatment the type
  # checker and MIR give it. Only the block exceptional forms are rejected
  # (see check_stmt above); the compiler kernel itself uses `?` and must
  # keep compiling.
  when ExprKind::ExprTry(inner) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then check_expr(program, typed, env, ctx, &s, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then check_expr(program, typed, env, ctx, &e, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprTypeCheck(inner, _) then check_expr(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprComptime(block) then
    check_block(program, typed, env, ctx, &block, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, env, ctx, &args[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      transfer_consume(env, typed, &args[i], loop_outer, frame, errors, finalize_plan)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    # Assignment EXPRESSIONS share the statement-assignment replacement
    # semantics: drop the previous owning value first, store the new one.
 # the transition shape is identical to StmtAssign — prior_state
    # captured by check_assign_target, RHS validated, drop decision from
    # prior_state, next_state committed.
    let assign_trans = check_assign_target(program, typed, env, ctx, &target, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &value, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    transfer_consume(env, typed, &value, loop_outer, frame, errors, finalize_plan)
    match assign_trans
    when Option::Some(t) then
 # drops_old derives from the PRIOR state (see StmtAssign): a
      # Live owning value is dropped before the store; dead storage
      # (Uninitialized — the first store into a set parameter's caller
      # buffer; Consumed — a reinitialized moved-out slot) never drops.
      if t.drops_old then
        # (partial moves): the same-root RHS guard (see StmtAssign). The
        # NESTED exact-place drop destroys only the target chain's own
        # state — the root_has_moves whole-root guard does not apply to the
        # exact-place form.
        var target_chain = Vec::new()
        let target_is_field = if !expr_is_plain(target) then
          place_projection_keys(typed, &target, &mut target_chain)
        else
          false
        end
        if !expr_is_plain(target) && target_is_field && target_chain.len() > 1 then
          if expr_roots_at(typed, &value, t.lid.id) then
            errors.push(ResourceError {
              message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
              span: value.span
            })
          else
            # The nested exact-place drop (see StmtAssign): the chain's own
            # state is destroyed before the store, masked to the chain's
            # consumed extensions. The ExprAssign's MIR lowering keys on
            # the EXPRESSION's node id (unlike StmtAssign which keys on the
            # statement's).
            var exact = Vec::new()
            exact.push(AssignExactDrop {
              local: t.lid.id,
              chain: target_chain.clone(),
              paths: assign_exact_drop_paths(typed, env, frame, t.lid, &target_chain)
            })
            let _ = finalize_plan.assign_exact_drops.insert(expr.node_id, exact)
          end
        elsif !expr_is_plain(target) && root_has_moves(frame, t.lid) then
          errors.push(ResourceError {
            message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
            span: value.span
          })
        elsif !expr_is_plain(target) && expr_roots_at(typed, &value, t.lid.id) then
          errors.push(ResourceError {
            message: "cannot assign over an owning projected place: the value moves out of the same root (the drop-before-store would destroy its source)",
            span: value.span
          })
        else
          var assign_ids = Vec::new()
          assign_ids.push(t.lid.id)
          # The ExprAssign's MIR lowering keys on the EXPRESSION's
          # node id (unlike StmtAssign which keys on the statement's).
          # the assign-drop chain is NOT a CFG edge — it is the
          # drop-before-store chain inside one expression, with no
          # CfgEdgeKind in the edge model (no transfer originates it).
          # the chain is the SEMANTIC assign_drops table (node id ->
          # local ids) — the "assign::<expr id>" String-key protocol is
          # are not part of the model
          let _ = finalize_plan.assign_drops.insert(expr.node_id, assign_ids)
        end
      end
      # The store commits AFTER the drop decision: next_state comes from
      # prior_state, never from a validation-time mutation.
      res_frame_set(frame, t.lid, t.next)
      # (partial moves — the projected-target commit, see StmtAssign).
      if !expr_is_plain(target) then
        var chain = Vec::new()
        let field_chain = place_projection_keys(typed, &target, &mut chain)
        if field_chain then
          if t.drops_old then
            # The whole-root drop (the depth-1 owning target) destroys the
            # sibling DIRECT fields — they are marked Consumed so the
            # scope-exit drop skips them. The NESTED exact-place drop
            # destroys only the chain's own state — the siblings stay
            # live, no marking.
            if chain.len() == 1 then
              mark_frame_sibling_fields(typed, frame, t.lid, &chain)
            end
          end
          frame_place_clear(frame, t.lid, &chain)
          frame_place_mark(frame, t.lid, &chain, ResourceState::Live)
        end
      end
    when Option::None then ()
    end
  when ExprKind::ExprPipe(lhs, rhs) then
    check_expr(program, typed, env, ctx, &lhs, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &rhs, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, env, ctx, &args[i], loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end  end
end

def check_expr_call(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, callee: Expr, args: Vec[Expr], loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  check_expr(program, typed, env, ctx, callee, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  # The receiver/argument effects are the TYPED access effects recorded by
  # the type checker (typed.access_effects on each argument node) — never
  # re-derived from source names (find_function/find_method were unsound:
  # they returned the FIRST function/method with that name regardless of
  # receiver type, misclassifying conventions).
  mut i = 0
  while i < args.len() do
    let eff = match typed.access_effects.get(args[i].node_id)
    when Option::Some(e) then e
    when Option::None then AccessEffect::Read
    end
    apply_arg_effect(program, typed, env, ctx, &args[i], eff, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    i = i + 1
  end
end

def check_expr_method_call(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, receiver: Expr, method: String, args: Vec[Expr], call_node_id: Int, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  # Receiver and argument effects come from the typed access effects recorded
  # by the type checker (the type checker already resolved the method and its
  # receiver convention — re-deriving it by walking impls by NAME was
  # unsound: `A.close(self)` (let) vs `B.close(sink self)` could classify a
  # receiver using the wrong method's convention).
  let recv_effect = match typed.access_effects.get(receiver.node_id)
  when Option::Some(e) then e
  when Option::None then AccessEffect::Read
  end
 # (— the typed FinalizerKind): an EXPLICIT finalizer
  # call consumes the receiver exactly like the automatic destruction path —
  # otherwise `b.drop()` / `b.deinit()` would run the finalizer body while
  # lexical cleanup later finalizes the still-live b a second time. The
  # recognition is the RESOLVED CALLEE IDENTITY: the call node's typed call
  # target (DefId) -> finalizer_kind_of_callable — NEVER the source method
  # name (method == "deinit"/"drop" is gone; a user method named "deinit"
  # that the checker never registered as a finalizer is an ordinary call).
  var is_finalizer_call = false
  match typed.call_targets.get(call_node_id)
  when Option::Some(call_did) then
    if finalizer_kind_of_callable(typed, &CallableId { def: call_did.clone() }) != FinalizerKind::NotFinalizer then
      is_finalizer_call = true
    end
  when Option::None then ()
  end
  if is_finalizer_call then
    # (partial moves — the projected-finalizer-receiver boundary): a
    # finalizer call over a PROJECTED receiver would consume the field
    # chain, but the type checker records the receiver's declared
    # convention (Let — the finalizer's self) — the per-field record the
    # drop sites need is never produced, so the field's drop would run
    # twice. The conservative rule: a finalizer call consumes its WHOLE
    # subject — the projected receiver form is rejected.
    if expr_is_plain(receiver) then
      apply_arg_effect(program, typed, env, ctx, receiver, AccessEffect::Consume, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    else
      errors.push(ResourceError {
        message: "cannot call a finalizer on a projected place: the finalizer consumes its whole subject",
        span: receiver.span
      })
    end
  else
    apply_arg_effect(program, typed, env, ctx, receiver, recv_effect, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  end
  mut i = 0
  while i < args.len() do
    let eff = match typed.access_effects.get(args[i].node_id)
    when Option::Some(e) then e
    when Option::None then AccessEffect::Read
    end
    apply_arg_effect(program, typed, env, ctx, &args[i], eff, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    i = i + 1
  end
end

# walk the NON-ROOT sub-expressions of an assignment target — the index
# expressions of a projected target, whose effects the state walk must see
# (`arr[consume(r)] = v` consumes r; `arr[f()] = v` evaluates f). The root
# chain (ident / field-access spine) is descended without touching the
# root's record — check_assign_target's purity contract (prior_state ->
# drop decision -> caller commit) is preserved, and a first store into an
# Uninitialized set-parameter buffer never looks like a use of the root.
def check_assign_target_subexprs(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, target: Expr, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match target.kind
  when ExprKind::ExprIndex(base, idx) then
    check_assign_target_subexprs(program, typed, env, ctx, &base, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    check_expr(program, typed, env, ctx, &idx, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprFieldAccess(base, _) then
    check_assign_target_subexprs(program, typed, env, ctx, &base, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprAccess(inner) then
    check_assign_target_subexprs(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprRawDeref(inner) then
    check_assign_target_subexprs(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when ExprKind::ExprCast(inner, _) then
    check_assign_target_subexprs(program, typed, env, ctx, &inner, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  when _ then ()
  end  end
end

# validate an assignment target WITHOUT mutating its frame state.
# prior_state is captured before anything else; the returned transition
# carries the drop decision computed from prior_state (a Live owning value
# must be dropped before the store; Uninitialized/Consumed storage is dead
# — no drop) and the next_state the caller commits after the RHS is
# validated and the store happens. The caller commits; this function never
# writes the target's record.
def check_assign_target(program: Program, typed: TypedProgram, inout env: TypeEnv, inout ctx: AnalysisContext, target: Expr, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Option[AssignmentTransition]
  match expr_root_id(typed, target)
  when Option::Some(id) then
 # boundary: the frame is LocalId-keyed; expr_root_id yields the raw
    # Int semantic id (check_use keeps the Int).
    let lid = tg_compiler::ids::LocalId { id: id }
    # The target's NON-ROOT sub-expressions (the index expressions of a
    # projected target) are walked here — their call/consume effects must
    # be visible to the state (`arr[consume(r)] = v` consumes r). The root
    # chain itself is never re-walked and its record is never written: the
    # purity contract of this function (prior_state -> drop decision ->
    # caller commit) is preserved, and a first store into an Uninitialized
    # set-parameter buffer never looks like a use of the root.
    check_assign_target_subexprs(program, typed, env, ctx, target, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    if res_frame_has(frame, &lid) then
 # capture BEFORE any transition — the validation below never
      # writes the target's state, so the drop decision reads the TRUE
      # pre-assignment state (a first assignment to an Uninitialized
      # destination must not look like a replacement of a live value).
      match res_frame_get(frame, &lid)
      when Option::Some(prior_state) then
        if expr_is_plain(target) then
          match prior_state
          when ResourceState::Uninitialized then
            # First store into dead storage: no old value exists, no drop.
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: false })
          when ResourceState::Consumed then
            # Reinitialization of a moved-out slot: the old value is gone,
            # the store re-lives the slot without a drop.
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: false })
          when ResourceState::MaybeLive then
            # The old value is live on one path only; a path-conditional
            # drop cannot be represented — check_use rejects it (the store
            # still commits Live afterwards).
            check_use(typed, id, target.span, frame, errors)
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: false })
          when ResourceState::Live then
            # Replacement of a live value: an OWNING origin's old value must
            # be dropped before the store (the assign-drop chain); a
            # let/inout value is not owned here — no drop.
            match res_frame_get_origin(frame, &lid)
            when Option::Some(origin) then
              if origin == ParamOrigin::Sink || origin == ParamOrigin::OwnedLocal || origin == ParamOrigin::Set then
                Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: true })
              else
                Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: false })
              end
            when Option::None then
              Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: ResourceState::Live, drops_old: false })
            end
          end
        else
          # (partial moves — the projected target): the store is into the
          # root's storage; the root's OWN state does not change (next =
          # prior for the root) but the TARGET CHAIN's prior state decides
          # the drop-before-store and the chain's next state (the
          # AssignmentTransition carries the chain-level transition):
          #   - dead storage (a moved-out chain): the store re-lives the
          #     chain without a drop;
          #   - a Live OWNING chain: the old value's drop-before-store. The
          #     chain-effective-state PREFIX RULE decides the form:
          #     * a DEPTH-1 target — the MIR's assign-drop chain can only
          #       destroy the WHOLE root, so the whole-root drop is
          #       representable only when the root is FULLY live (no
          #       consumed chains — the drop would re-drop them), and the
          #       root's direct-field shape is known (the destroyed sibling
          #       fields must be marked for the scope-exit drop);
          #     * a NESTED target (depth >= 2) whose chain's own state is
          #       Live — the EXACT-PLACE replacement: the drop-before-store
          #       destroys the chain's own state (x.a.b) only, masked to
          #       skip the chain's consumed extensions — the root's other
          #       chains (live or consumed) are untouched;
          #   - a Live non-owning chain: a plain store, no drop;
          #   - an INDEXED target (the whole-value boundary): the MIR's
          #     indexed-assign drop is the old-element drop authority (the
          #     existing container-element semantics) — the checker records
          #     no assign-drop and no chain transition.
          match prior_state
          when ResourceState::Consumed then
            check_use(typed, id, target.span, frame, errors)
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
          when ResourceState::Uninitialized then
            check_use(typed, id, target.span, frame, errors)
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
          when ResourceState::MaybeLive then
            check_use(typed, id, target.span, frame, errors)
            Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
          when ResourceState::Live then
            var chain = Vec::new()
            let field_chain = place_projection_keys(typed, &target, &mut chain)
            if field_chain then
              let eff = chain_effective_state(frame, lid, &chain)
              match eff
              when ResourceState::Consumed then
                # Dead field storage: the store re-lives the field without
                # a drop (the re-assignment of a moved-out field).
                Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
              when ResourceState::MaybeLive then
                errors.push(ResourceError {
                  message: "field `" + chain_display(typed, &chain) + "` of " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
                  span: target.span
                })
                Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
              when ResourceState::Live then
                match res_frame_get_origin(frame, &lid)
                when Option::Some(origin) then
                  if origin == ParamOrigin::Sink || origin == ParamOrigin::OwnedLocal || origin == ParamOrigin::Set then
                    # The old owning value's drop-before-store — the target
                    # FIELD's type must own (a Copy-field store overwrites
                    # without a drop). The representability is decided by
                    # the chain-effective-state PREFIX RULE:
                    #   - a DEPTH-1 target with the fully-live depth-1
                    #     shape (see the note above) is the whole-root drop;
                    #   - a NESTED target (depth >= 2) whose chain's own
                    #     state is Live (the prefix rule — every prefix of
                    #     the chain is live) is the EXACT-PLACE
                    #     replacement: the drop-before-store destroys the
                    #     chain's OWN state (the assign_exact_drops plan —
                    #     the exact place x.a.b, masked to skip the
                    #     chain's consumed extensions). The exact-place
                    #     drop does not touch the root's other chains, so
                    #     the depth-1 whole-root gates (root_has_moves /
                    #     root_direct_shape_known) do not apply.
                    if !expr_type_has_resource(env, typed, target) then
                      Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
                    elsif chain.len() > 1 then
                      Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: true })
                    elsif root_has_moves(frame, lid) then
                      errors.push(ResourceError {
                        message: "cannot assign over an owning projected place: the root is partially moved out (the masked drop-before-store is not representable)",
                        span: target.span
                      })
                      Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
                    elsif !root_direct_shape_known(typed, lid) then
                      errors.push(ResourceError {
                        message: "cannot assign over an owning projected place: the root's field shape is unknown (the sibling fields cannot be masked)",
                        span: target.span
                      })
                      Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
                    else
                      Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: true })
                    end
                  else
                    Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
                  end
                when Option::None then
                  Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
                end
              end
            else
              # The whole-value boundary (an indexed target): the MIR's
              # indexed-assign drop destroys the old element itself (the
              # existing container-element semantics) — no assign-drop
              # record, no chain transition.
              Option::Some(AssignmentTransition { lid: lid, prior: prior_state, next: prior_state, drops_old: false })
            end
          end
        end
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when Option::None then
    check_expr(program, typed, env, ctx, target, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
    Option::None
  end  end
end

def apply_arg_effect(program: Program, typed: TypedProgram, inout env: TypeEnv, ctx: AnalysisContext, arg: Expr, effect: AccessEffect, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable, inout edges: Vec[CfgEdge], inout blocks: Vec[CfgBlock], inout current_loop_entry: Vec[Int], inout defer_chain: Vec[Int]) -> Unit
  match expr_root_id(typed, arg)
  when Option::Some(id) then
 # boundary: the frame is LocalId-keyed; expr_root_id yields the raw
    # Int semantic id (apply_consume/check_use keep the Int).
    let lid = tg_compiler::ids::LocalId { id: id }
    if res_frame_has(frame, &lid) then
      if expr_is_plain(arg) then
        match effect
        when AccessEffect::Consume then apply_consume(typed, id, arg.span, loop_outer, frame, errors)
        when AccessEffect::Initialize then apply_set(typed, frame, lid, arg.span, errors)
        when _ then
          # (partial moves — the whole-value boundary): a whole-value READ
          # of a partially-moved root copies the dead chains' storage — the
          # conservative rule (a whole-value use requires the full Live
          # value, the closure-capture rule extended to every whole read).
          if root_has_moves(frame, lid) then
            errors.push(ResourceError {
              message: "cannot use " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` as a whole: fields of the resource were moved out",
              span: arg.span
            })
          else
            check_use(typed, id, arg.span, frame, errors)
          end
        end
      else
        # A projected argument: the per-field state tracking. MIR lowers
        # the projection as a consuming/initializing place while the ROOT
        # stays live — the per-chain lattice is the state authority. The
        # OWNERSHIP gate stays: a projection whose VALUE type is NOT owning
        # (e.g. m.insert(td.id.id, v) — a Copy read out of an owning root)
        # transfers no ownership — the collection consumes a COPY — so it
        # is a plain read of the root (check_use). Only an owning-typed
        # projection (e.g. m.insert(node.id, node) with a String id field)
        # exercises the per-field consume/initialize paths.
        if effect == AccessEffect::Consume then
          match res_frame_get_origin(frame, &lid)
          when Option::Some(ParamOrigin::DeinitSelf) then
            errors.push(ResourceError {
              message: "cannot consume resource `" + binding_name(typed, id) + "`: a finalizer must not consume its own subject (compiler-owned structural cleanup)",
              span: arg.span
            })
          when _ then
            if expr_type_has_resource(env, typed, arg) then
              var chain = Vec::new()
              let field_chain = place_projection_keys(typed, &arg, &mut chain)
              if field_chain then
                apply_projected_consume(env, typed, id, &chain, arg.span, loop_outer, frame, errors)
              else
                # The whole-value boundary (an indexed/deref place): the
                # aggregate marking (see transfer_consume).
                apply_whole_boundary_consume(env, typed, id, arg.span, loop_outer, frame, errors)
              end
            else
              check_use(typed, id, arg.span, frame, errors)
            end
          end
        elsif effect == AccessEffect::Initialize then
          # A projected set argument (f(set p.a)) writes into the root's
          # storage: the CHAIN's state decides — dead storage (a moved-out
          # field) is re-initialized; a Live field is already initialized
          # (writing over it without destroying the old value would leak)
          # and is rejected; the commit re-lives the chain. A Copy-typed
          # projection is a plain root-usable check.
          if expr_type_has_resource(env, typed, arg) then
            var chain = Vec::new()
            let field_chain = place_projection_keys(typed, &arg, &mut chain)
            if field_chain then
              let eff = chain_effective_state(frame, lid, &chain)
              match eff
              when ResourceState::Live then
                errors.push(ResourceError {
                  message: "cannot initialize already-live storage: field `" + chain_display(typed, &chain) + "` of " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` is already live",
                  span: arg.span
                })
              when ResourceState::MaybeLive then
                errors.push(ResourceError {
                  message: "cannot initialize already-live storage: field `" + chain_display(typed, &chain) + "` of " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` is live on one path",
                  span: arg.span
                })
              when _ then ()
              end
              frame_place_mark(frame, lid, &chain, ResourceState::Live)
            else
              # The whole-value boundary (an indexed place): the container
              # elements are the aggregate — the per-index storage state is
              # not tracked, so an owning-typed indexed set argument stays
              # rejected (conservative).
              errors.push(ResourceError {
                message: "cannot initialize a projected place: element-level state is not tracked (the container's elements are the ownership unit)",
                span: arg.span
              })
            end
          else
            check_use(typed, id, arg.span, frame, errors)
          end
        else
          # A projected READ: the chain's state decides (the root stays
          # live under a partial move; a consumed chain is a
          # use-after-move).
          var chain = Vec::new()
          let field_chain = place_projection_keys(typed, &arg, &mut chain)
          if field_chain then
            let eff = chain_effective_state(frame, lid, &chain)
            match eff
            when ResourceState::Consumed then
              errors.push(ResourceError {
                message: "use of consumed " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` (field `" + chain_display(typed, &chain) + "` was moved out)",
                span: arg.span
              })
            when ResourceState::MaybeLive then
              errors.push(ResourceError {
                message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
                span: arg.span
              })
            when _ then ()
            end
          else
            check_use(typed, id, arg.span, frame, errors)
          end
        end
      end
    end
  when Option::None then
    check_expr(program, typed, env, ctx, arg, loop_outer, frame, errors, finalize_plan, edges, blocks, current_loop_entry, defer_chain)
  end  end
end

# boundary: the id is the raw Int semantic id; the frame is LocalId-keyed.
# The ownership diagnostics distinguish capabilities from resources ("capability
# `c` consumed twice" vs "resource `r` consumed twice") — the capability
# dimension is part of the single per-local record, so the label reads it
# directly. Absent records default to "resource" (an unregistered local cannot
# be a capability: every capability is registered at its binding point).
def ownership_label(frame: ResFrame, id: Int) -> String
  match frame.locals.get(&tg_compiler::ids::LocalId { id: id })
  when Option::Some(ls) then
    if ls.is_capability then "capability" else "resource" end
  when Option::None then "resource"
  end  end
end

def apply_consume(typed: TypedProgram, id: Int, span: Span, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
 # boundary: the id is the raw Int semantic id (loop_outer and
  # binding_name are Int-keyed); the frame is LocalId-keyed.
  let lid = tg_compiler::ids::LocalId { id: id }
  # Permission enforcement: only locals that OWN their value (sink params,
  # owned locals) may be consumed. let params are read-only and inout params
  # may be modified but never consumed/escaped — a sink operation on them is
  # exactly the unsoundness `def inspect(x: R); destroy(x)` exercises.
  match res_frame_get_origin(frame, &lid)
  when Option::Some(origin) then
    if origin == ParamOrigin::DeinitSelf then
      errors.push(ResourceError {
        message: "cannot consume resource `" + binding_name(typed, id) + "`: a finalizer must not consume its own subject (compiler-owned structural cleanup)",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Let then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: let parameter is read-only",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Inout then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: inout parameter may be modified but not consumed",
        span: span
      })
      return
    end
  when Option::None then ()
  end
  # (partial moves — the whole-value boundary): a whole-root consume of a
  # partially-moved root cannot mask the dead chains — the destination (a
  # move, a closure capture, an explicit finalizer call) would re-drop the
  # moved-out fields' storage. The conservative rule: a whole-value consume
  # requires the FULL Live value (the closure-capture rule extends to every
  # whole-root consume).
  if root_has_moves(frame, lid) then
    errors.push(ResourceError {
      message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` as a whole: fields of the resource were moved out",
      span: span
    })
    return
  end
  if loop_outer.contains(&id) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` cannot be consumed inside a repeatable loop",
      span: span
    })
  end
  match res_frame_get(frame, &lid)
  when Option::Some(ResourceState::Consumed) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` consumed twice",
      span: span
    })
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::MaybeLive) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
      span: span
    })
  when _ then ()
  end
  res_frame_set(frame, lid, ResourceState::Consumed)
end

# the set-intrinsic INITIALIZE path (the Initialize effect applied
# to a call's set-argument place): the callee initializes DEAD storage.
# Live storage is already initialized — writing over it without destroying
# the old value would leak — so Initialize REJECTS a Live destination;
# MaybeLive is live on one path (the same conditional hazard) and is
# rejected too. Consumed IS reinitializable: a moved-out slot's storage is
# dead, and the callee's write re-lives it. Replacement is a SEPARATE
# operation that must run the old value's destruction first (the
# assignment machinery's drop-before-store chain); Initialize never
# replaces. The state still commits Live after an error (the analysis
# continues with the store the program asked for), mirroring apply_consume.
def apply_set(typed: TypedProgram, inout frame: ResFrame, id: tg_compiler::ids::LocalId, span: Span, inout errors: Vec[ResourceError]) -> Unit
  # (partial moves — the whole-value boundary): a whole-root Initialize of
  # a partially-moved root would overwrite the live fields without
  # destroying their values (and the dead chains' storage) — conservative
  # rejection.
  if root_has_moves(frame, id) then
    errors.push(ResourceError {
      message: "cannot initialize " + ownership_label(frame, id.id) + " `" + binding_name(typed, id.id) + "` as a whole: fields of the resource were moved out",
      span: span
    })
    return
  end
  match res_frame_get(frame, &id)
  when Option::Some(ResourceState::Live) then
    errors.push(ResourceError {
      message: "cannot initialize already-live storage: " + ownership_label(frame, id.id) + " `" + binding_name(typed, id.id) + "` is already live",
      span: span
    })
  when Option::Some(ResourceState::MaybeLive) then
    errors.push(ResourceError {
      message: "cannot initialize already-live storage: " + ownership_label(frame, id.id) + " `" + binding_name(typed, id.id) + "` is live on one path",
      span: span
    })
  when _ then ()
  end
  res_frame_set(frame, id, ResourceState::Live)
end

def check_use(typed: TypedProgram, id: Int, span: Span, frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  # boundary: check_use keeps the raw Int semantic id (callers derive it
  # from expr_root_id / ident_resolutions); the frame is LocalId-keyed.
  match res_frame_get(frame, &tg_compiler::ids::LocalId { id: id })
  when Option::Some(ResourceState::Consumed) then
    errors.push(ResourceError {
      message: "use of consumed " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`",
      span: span
    })
  when Option::Some(ResourceState::MaybeLive) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
      span: span
    })
  when _ then ()
  end
end

# (partial moves — the chain-aware place read): a field/index READ is a
# read of the CHAIN, not of the root as a whole. The root stays live under
# a partial move (the remaining fields are readable); a consumed chain (or
# a consumed prefix) is a use-after-move. The root's own availability is
# already validated by the base recursion (check_expr on the base).
def check_place_chain_read(typed: TypedProgram, expr: Expr, frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  match expr_root_id(typed, expr)
  when Option::Some(id) then
    let lid = tg_compiler::ids::LocalId { id: id }
    if res_frame_has(frame, &lid) then
      var chain = Vec::new()
      let field_chain = place_projection_keys(typed, expr, &mut chain)
      if field_chain then
        let eff = chain_effective_state(frame, lid, &chain)
        match eff
        when ResourceState::Consumed then
          errors.push(ResourceError {
            message: "use of consumed " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` (field `" + chain_display(typed, &chain) + "` was moved out)",
            span: expr.span
          })
        when ResourceState::MaybeLive then
          errors.push(ResourceError {
            message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
            span: expr.span
          })
        when _ then ()
        end
      end
    end
  when Option::None then ()
  end  end
end

def exit_scope(inout frame: ResFrame, entry_names: Vec[tg_compiler::ids::LocalId], typed: TypedProgram, inout errors: Vec[ResourceError]) -> Unit
  mut to_forget = Vec::new()
  # Frame keys and entry_names are both LocalId (the frame-key domain);
  # binding_name is keyed by the raw Int semantic id.
  for (id, ls) in frame.locals do
    if !entry_names.contains(&id) then
      match ls.availability
      when ResourceState::Live then
        if ls.is_capability then
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id.id) + "` silently discarded",
            span: ls.span
          })
        end
      when ResourceState::MaybeLive then
        if ls.is_capability then
          errors.push(ResourceError {
            message: "capability `" + binding_name(typed, id.id) + "` silently discarded",
            span: ls.span
          })
        else
          # A non-capability OWNING local that is Live on one path and
          # Consumed on another must be finalized only on the live path;
          # the scope's cleanup obligations ("block::<key>" / fn-end plan /
          # exit-edge plans) lower to UNCONDITIONAL deinits, so neither
          # dropping it nor skipping it is sound. Previously the local was
          # silently forgotten here and never recorded in any plan — the
          # live path leaked the value. Reject the mixed state at the scope
          # boundary instead.
          errors.push(ResourceError {
            message: "resource `" + binding_name(typed, id.id) + "` may be consumed on one path; scope-exit cleanup cannot be conditional",
            span: ls.span
          })
        end
      when ResourceState::Uninitialized then
        errors.push(ResourceError {
          message: ownership_label(frame, id.id) + " `" + binding_name(typed, id.id) + "` left uninitialized",
          span: ls.span
        })
      when _ then ()
      end
      to_forget.push(id)
    end
  end
  # (partial moves — the per-chain scope-boundary checks): a chain that is
  # MaybeLive at the scope boundary (consumed on one path only) cannot be
  # masked by the unconditional cleanup — reject, mirroring the root-level
  # rule. The registry-divergence net also fires here: a chain the
  # type-checker recorded Consumed (the serialized registry the drop sites
  # consult) whose frame lattice has NO matching Consumed/MaybeLive chain
  # means the cleanup would skip a live field on some path (the
  # guard-else-return / defer-body fallthrough shape) — the record must be
  # masked on every path or the program is rejected.
  for (id, ls) in frame.locals do
    if !entry_names.contains(&id) then
      match ls.availability
      when ResourceState::Consumed then ()
      when ResourceState::Uninitialized then ()
      when _ then
        match frame.place_moves.get(id)
        when Option::Some(chains) then
          for (pc, st) in chains do
            if st == ResourceState::MaybeLive then
              errors.push(ResourceError {
                message: "resource `" + binding_name(typed, id.id) + "` field `" + chain_display(typed, &pc.keys) + "` may be consumed on one path; scope-exit cleanup cannot be conditional",
                span: ls.span
              })
            end
          end
          match typed.place_move_states.get(id.id)
          when Option::Some(recorded) then
            for (rec_path, rec_st) in recorded do
              if rec_path != "*" && rec_st == PlaceMoveState::Consumed then
                var rec_ok = false
                for (fpc, fst) in chains do
                  if place_move_path_matches_chain(typed, &rec_path, &fpc.keys) then
                    if fst == ResourceState::Consumed || fst == ResourceState::MaybeLive then
                      rec_ok = true
                    end
                  end
                end
                if !rec_ok then
                  errors.push(ResourceError {
                    message: "resource `" + binding_name(typed, id.id) + "` field `" + rec_path + "` was moved out on one path only; scope-exit cleanup cannot be conditional",
                    span: ls.span
                  })
                end
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    end
  end
  mut i = 0
  while i < to_forget.len() do
    res_frame_forget(frame, &to_forget[i])
    i = i + 1
  end
end

def check_uninitialized_exit(frame: ResFrame, typed: TypedProgram, inout errors: Vec[ResourceError]) -> Unit
  # Frame keys are LocalId; binding_name is keyed by the raw Int semantic id.
  for (id, ls) in frame.locals do
    match ls.availability
    when ResourceState::Uninitialized then
      errors.push(ResourceError {
        message: ownership_label(frame, id.id) + " `" + binding_name(typed, id.id) + "` left uninitialized",
        span: ls.span
      })
    when _ then ()
    end
  end
end

def res_frame_new() -> ResFrame
  ResFrame {
    locals: Map::new(),
    place_moves: Map::new()
  }
end

def res_frame_has(frame: ResFrame, id: tg_compiler::ids::LocalId) -> Bool
  frame.locals.contains_key(id)
end

def res_frame_get_origin(frame: ResFrame, id: tg_compiler::ids::LocalId) -> Option[ParamOrigin]
  match frame.locals.get(id)
  when Option::Some(ls) then Option::Some(ls.origin)
  when Option::None then Option::None
  end  end
end

def res_frame_get(frame: ResFrame, id: tg_compiler::ids::LocalId) -> Option[ResourceState]
  match frame.locals.get(id)
  when Option::Some(ls) then Option::Some(ls.availability)
  when Option::None then Option::None
  end  end
end

def res_frame_set(inout frame: ResFrame, id: tg_compiler::ids::LocalId, state: ResourceState) -> Unit
  match frame.locals.get(&id)
  when Option::Some(ls) then
    # State transition only: the local's origin/capability/span are part of
    # the same record and must survive the transition untouched.
    frame.locals.insert(id, LocalState { availability: state, origin: ls.origin, is_capability: ls.is_capability, span: ls.span })
  when Option::None then
    # First registration: create the single per-local record.
    frame.locals.insert(id, LocalState { availability: state, origin: ParamOrigin::Let, is_capability: false, span: Span { file: "", start: 0, end_pos: 0 } })
  end  end
end

def res_frame_set_span(inout frame: ResFrame, id: tg_compiler::ids::LocalId, span: Span) -> Unit
  match frame.locals.get(id)
  when Option::Some(ls) then
    frame.locals.insert(id, LocalState { availability: ls.availability, origin: ls.origin, is_capability: ls.is_capability, span: span })
  when Option::None then ()
  end  end
end

# The permission origin is stored in the single per-local record :
# updating it touches only that record, never a parallel map that a forget
# could leave desynced.
def res_frame_set_origin(inout frame: ResFrame, id: tg_compiler::ids::LocalId, origin: ParamOrigin) -> Unit
  match frame.locals.get(id)
  when Option::Some(ls) then
    frame.locals.insert(id, LocalState { availability: ls.availability, origin: origin, is_capability: ls.is_capability, span: ls.span })
  when Option::None then ()
  end  end
end

# ———————————————————————————————————————————————————————————————
# (partial moves — the frame's per-field lattice)
# ———————————————————————————————————————————————————————————————
# The lattice (ResFrame.place_moves) tracks the per-CHAIN move state of
# every root: a chain recorded Consumed was moved out (extracted) while
# the root stays Live; MaybeLive chains were consumed on one path only
# (rejected at the scope boundaries). An absent chain is Live. The
# EFFECTIVE state of a chain also consults the chain's PREFIXES: a
# consumed prefix (or a consumed/unknown root) makes everything under it
# dead — `take(p.a)` then `take(p.a.b)` is a use of consumed storage.

# The SEMANTIC chain of a place expression: the FieldId/TupleIndex
# projections in access order (typed.field_targets / typed.typed_exprs —
# the typed HIR's strong identities). Returns false when the chain passes
# through a non-field/tuple projection (Index/Deref — the whole-value
# lattice boundary).
# The constant integer index of an expression (the AST integer literal).
def typed_const_index(typed: TypedProgram, expr: Expr) -> Option[Int]
  match expr.kind
  when ExprKind::ExprIntLit(v) then Option::Some(parsed_int_to_host(&v))
  when _ then Option::None
  end  end
end

# The typed type of an expression (the typed HIR's type record).
def typed_expr_ty(typed: TypedProgram, expr: Expr) -> Option[Type]
  match typed.expr_types.get(expr.node_id)
  when Option::Some(ty) then Option::Some(ty.clone())
  when Option::None then Option::None
  end  end
end

def place_projection_keys(typed: TypedProgram, expr: Expr, inout out: Vec[ProjectionKey]) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprFieldAccess(base, _) then
    if !place_projection_keys(typed, &base, out) then
      return false
    end
    match typed.field_targets.get(expr.node_id)
    when Option::Some(fid) then
      out.push(ProjectionKey::Field(fid))
      true
    when Option::None then
      match typed.typed_exprs.get(expr.node_id)
      when Option::Some(te) then
        match te.kind
        when TypedExprKind::TupleIndex { base: _, name: _, index: ti } then
          out.push(ProjectionKey::TupleIndex(ti))
          true
        when _ then false
        end
      when Option::None then false
      end
    end
  when ExprKind::ExprIndex(base, idx) then
    if !place_projection_keys(typed, &base, out) then
      return false
    end
    # The per-index lattice: a CONSTANT index over a FIXED-ARRAY base
    # tracks the element individually (the finite indices); a dynamic
    # index (or a non-fixed-array base) stays the whole-value lattice.
    match typed_const_index(typed, &idx)
    when Option::Some(ci) then
      match typed_expr_ty(typed, &base)
      when Option::Some(bt) then
        match bt
        when Type::FixedArray(_, n) then
          if ci >= 0 && ci < n then
            out.push(ProjectionKey::Index(ci))
            true
          else
            out.push(ProjectionKey::Index(ci))
            false
          end
        when _ then
          out.push(ProjectionKey::Index(ci))
          false
        end
      when Option::None then
        out.push(ProjectionKey::Index(ci))
        false
      end
    when Option::None then
      out.push(ProjectionKey::Index(-1))
      false
    end
  when ExprKind::ExprRawDeref(inner) then
    if !place_projection_keys(typed, &inner, out) then
      return false
    end
    false
  when ExprKind::ExprAccess(inner) then place_projection_keys(typed, &inner, out)
  when ExprKind::ExprCast(inner, _) then place_projection_keys(typed, &inner, out)
  when _ then false
  end  end
end

# The effective state of a chain: the root's own availability decides the
# whole (a Consumed/Uninitialized root makes every chain dead); then the
# chain's prefixes in order — the first recorded Consumed prefix makes the
# rest dead (Consumed), the first MaybeLive prefix makes the rest
# indeterminate. Absent = Live.
def chain_effective_state(frame: ResFrame, lid: tg_compiler::ids::LocalId, chain: Vec[ProjectionKey]) -> ResourceState
  match res_frame_get(frame, &lid)
  when Option::Some(ResourceState::Consumed) then return ResourceState::Consumed
  when Option::Some(ResourceState::Uninitialized) then return ResourceState::Consumed
  when Option::Some(ResourceState::MaybeLive) then return ResourceState::MaybeLive
  when _ then ()
  end
  match frame.place_moves.get(lid)
  when Option::Some(chains) then
    var len_i = 0
    while len_i < chain.len() do
      var prefix = Vec::new()
      var pi = 0
      while pi <= len_i do
        prefix.push(chain[pi].clone())
        pi = pi + 1
      end
      let pc = projection_chain_of(&prefix)
      match chains.get(pc)
      when Option::Some(st) then
        if st == ResourceState::Consumed then
          return ResourceState::Consumed
        end
        if st == ResourceState::MaybeLive then
          return ResourceState::MaybeLive
        end
      when Option::None then ()
      end
      len_i = len_i + 1
    end
  when Option::None then ()
  end
  ResourceState::Live  end
end

# (partial moves — the nested owning projected replacement): the CONSUMED
# EXTENSIONS of the target chain — the serialized relative paths (the
# place_move_path_of key form — the shared key form of the checker's
# ProjectionChain serialization) whose storage the MIR's exact-place
# drop-before-store must SKIP (the masked exact-place drop: the chain's own
# state is dropped, the dead extensions are not re-dropped). A consumed
# chain whose key list strictly extends the target chain contributes its
# relative tail; everything else is untouched by the exact-place drop.
def assign_exact_drop_paths(typed: TypedProgram, env: TypeEnv, frame: ResFrame, lid: tg_compiler::ids::LocalId, chain: Vec[ProjectionKey]) -> Vec[String]
  var out = Vec::new()
  match frame.place_moves.get(lid)
  when Option::Some(chains) then
    for (pc, st) in chains do
      if st == ResourceState::Consumed && pc.keys.len() > chain.len() then
        var is_ext = true
        var ki = 0
        while ki < chain.len() do
          if !projection_key_eq(&pc.keys[ki], &chain[ki]) then
            is_ext = false
          end
          ki = ki + 1
        end
        if is_ext then
          var rel = Vec::new()
          var ri = chain.len()
          while ri < pc.keys.len() do
            rel.push(pc.keys[ri].clone())
            ri = ri + 1
          end
          out.push(place_move_path_of(env, &rel))
        end
      end
    end
  when Option::None then ()
  end
  out
end

# Mark a chain's state in the lattice.
def frame_place_mark(inout frame: ResFrame, lid: tg_compiler::ids::LocalId, chain: Vec[ProjectionKey], state: ResourceState) -> Unit
  let pc = projection_chain_of(chain)
  match frame.place_moves.get(lid)
  when Option::Some(existing) then
    var ext = existing.clone()
    ext.insert(pc, state)
    frame.place_moves.insert(lid, ext)
  when Option::None then
    var fresh = Map::new()
    fresh.insert(pc, state)
    frame.place_moves.insert(lid, fresh)
  end
end

# Remove a chain and every extension of it (a store re-lives the target;
# the nested consumptions under it die with the re-initialization).
def frame_place_clear(inout frame: ResFrame, lid: tg_compiler::ids::LocalId, chain: Vec[ProjectionKey]) -> Unit
  match frame.place_moves.get(lid)
  when Option::Some(existing) then
    var kept = Map::new()
    for (pc, st) in existing do
      if pc.keys.len() < chain.len() then
        kept.insert(ProjectionChain { keys: pc.keys.clone() }, st)
      else
        var is_prefix = true
        var ki = 0
        while ki < chain.len() do
          if !projection_key_eq(&pc.keys[ki], &chain[ki]) then
            is_prefix = false
          end
          ki = ki + 1
        end
        if !is_prefix then
          kept.insert(ProjectionChain { keys: pc.keys.clone() }, st)
        end
      end
    end
    if kept.len() > 0 then
      frame.place_moves.insert(lid, kept)
    else
      frame.place_moves.remove(lid)
    end
  when Option::None then ()
  end  end
end

# Does the root carry ANY recorded chain (a partial move, definite or
# path-conditional)? The whole-value operations (whole-root consume/read/
# assign/capture) consult this: a whole-value move of a partially-moved
# root cannot mask the dead chains.
def root_has_moves(frame: ResFrame, lid: tg_compiler::ids::LocalId) -> Bool
  match frame.place_moves.get(lid)
  when Option::Some(chains) then chains.len() > 0
  when Option::None then false
  end  end
end

# Render a chain for diagnostics: the "."-joined field names (FieldId ->
# the owner's declaration-order name — typed.type_fields), "t<i>" for
# tuple positions.
def chain_display(typed: TypedProgram, chain: Vec[ProjectionKey]) -> String
  var segs = Vec::new()
  for k in chain do
    match k
    when ProjectionKey::Field(fid) then
      var fname = ""
      match typed.type_fields.get(fid.owner.id)
      when Option::Some(fields) then
        if fid.index >= 0 && fid.index < fields.len() then
          fname = fields[fid.index].0.clone()
        end
      when Option::None then ()
      end
      if fname.len() == 0 then
        fname = "f" + fid.index.to_string()
      end
      segs.push(fname)
    when ProjectionKey::Variant(_) then ()
    when ProjectionKey::TupleIndex(ti) then segs.push("t" + ti.to_string())
    when ProjectionKey::Index(ci) then segs.push("i" + ci.to_string())
    end
  end
  segs.join(".")
end

# Does the serialized (recorded) path denote the same chain? The
# declaration-order rendering (chain_display) is the SAME authority the
# type-checker's record sites serialize through (place_move_path_of —
# FieldId -> the owner's declaration-order name), so the registry-divergence
# net can match the recorded strings against the frame's semantic chains.
def place_move_path_matches_chain(typed: TypedProgram, path: String, chain: Vec[ProjectionKey]) -> Bool
  chain_display(typed, chain) == path
end

# The root's direct-field shape (the sibling-masking of the whole-root
# assign-drop case needs the declaration-order field list).
def root_direct_shape_known(typed: TypedProgram, lid: tg_compiler::ids::LocalId) -> Bool
  match typed.local_bindings.get(lid.id)
  when Option::Some(lb) then
    match lb.ty
    when Type::Adt(tid, _) then
      match typed.type_fields.get(tid.id)
      when Option::Some(fields) then fields.len() > 0
      when Option::None then false
      end
    when Type::Tuple(fields) then fields.len() > 0
    when _ then false
    end
  when Option::None then false
  end  end
end

# (partial moves): mark the root's DIRECT fields other than the target
# chain Consumed in the frame lattice — the whole-root assign-drop chain
# destroys them; the scope-exit drop then drops only the re-stored target.
def mark_frame_sibling_fields(typed: TypedProgram, inout frame: ResFrame, lid: tg_compiler::ids::LocalId, target: Vec[ProjectionKey]) -> Unit
  match typed.local_bindings.get(lid.id)
  when Option::Some(lb) then
    match lb.ty
    when Type::Adt(tid, _) then
      match typed.type_fields.get(tid.id)
      when Option::Some(fields) then
        var fi = 0
        while fi < fields.len() do
          let sk = ProjectionKey::Field(FieldId { owner: tid, index: fi })
          if !chain_contains_key(target, &sk) then
            frame_place_mark(frame, lid, &Vec::from([sk]), ResourceState::Consumed)
          end
          fi = fi + 1
        end
      when Option::None then ()
      end
    when Type::Tuple(fields) then
      var ti = 0
      while ti < fields.len() do
        let sk = ProjectionKey::TupleIndex(ti)
        if !chain_contains_key(target, &sk) then
          frame_place_mark(frame, lid, &Vec::from([sk]), ResourceState::Consumed)
        end
        ti = ti + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end  end
end

# Does the expression root at the given semantic local?
def expr_roots_at(typed: TypedProgram, expr: Expr, id: Int) -> Bool
  match expr_root_id(typed, expr)
  when Option::Some(rid) then rid == id
  when Option::None then false
  end  end
end

# ONE destruction protocol: the compiler owns the subject's destruction.
# The user hook (`deinit(sink self)` or `Drop::drop`) may inspect and mutate
# fields but must NEVER move or consume `self` or its owned fields — the hook
# runs first, then the compiler destroys the still-live owned fields exactly
# once. Marking the subject DeinitSelf makes every consuming path
# (apply_consume, apply_arg_effect, transfer_consume) reject the hook's own
# consumption.
# A `drop` subject is a NON-OWNING `&mut Self` reference: bind_param did not
# register it (only owning types enter the frame), so a plain origin override
# would be a silent no-op and the hook could consume projected fields
# unchecked. When `is_self_param` is set (the first parameter is actually
# named `self` — a real finalizer hook, not a free function that happens to
# be called deinit/drop), the local is registered Live + DeinitSelf so the
# drop body is checked with IDENTICAL permissions to a deinit body.
def mark_finalizer_self(inout frame: ResFrame, id: tg_compiler::ids::LocalId, span: Span, is_self_param: Bool) -> Unit
  match frame.locals.get(id)
  when Option::Some(ls) then
    frame.locals.insert(id, LocalState { availability: ls.availability, origin: ParamOrigin::DeinitSelf, is_capability: ls.is_capability, span: ls.span })
  when Option::None then
    if is_self_param then
      frame.locals.insert(id, LocalState { availability: ResourceState::Live, origin: ParamOrigin::DeinitSelf, is_capability: false, span: span })
    end
  end  end
end

def frame_span(frame: ResFrame, id: tg_compiler::ids::LocalId) -> Span
  match frame.locals.get(id)
  when Option::Some(ls) then ls.span
  when Option::None then Span { file: String::new(), start: 0, end_pos: 0 }
  end  end
end

def res_frame_mark_cap(inout frame: ResFrame, id: tg_compiler::ids::LocalId) -> Unit
  match frame.locals.get(id)
  when Option::Some(ls) then
    frame.locals.insert(id, LocalState { availability: ls.availability, origin: ls.origin, is_capability: true, span: ls.span })
  when Option::None then ()
  end  end
end

def res_frame_forget(inout frame: ResFrame, id: tg_compiler::ids::LocalId) -> Unit
  # The whole per-local record is removed at once: availability, origin,
  # capability flag, and span disappear together, so a forgotten local can
  # never leave a stale span/origin behind in a parallel collection.
  frame.locals.remove(id)
  # The per-field lattice entry dies with the local (a forgotten root has
  # no drop site that could consult its chains).
  frame.place_moves.remove(id)
end

def res_frame_names_clone(frame: ResFrame) -> Vec[tg_compiler::ids::LocalId]
  # The frame's keys (semantic LocalIds) are cloned as LocalId; consumers
  # that need the raw Int ids (the loop-context domain, the MIR-facing
  # plans) extract `.id` at their own boundary.
  var out = Vec::new()
  for (id, _) in frame.locals do
    out.push(id)
  end
  out
end

def res_frame_clone(frame: ResFrame) -> ResFrame
  mut out = res_frame_new()
  # The record is copied wholesale: availability, origin, capability flag,
  # and span all travel together.
  for (id, ls) in frame.locals do
    out.locals.insert(id, LocalState { availability: ls.availability, origin: ls.origin, is_capability: ls.is_capability, span: ls.span })
  end
  # The per-field lattice travels with the frame (the branch clones and
  # the worklist's entry snapshots must see the same partial-move state).
  for (rid, chains) in frame.place_moves do
    var ext = Map::new()
    for (ch, st) in chains do
      ext.insert(ProjectionChain { keys: ch.keys.clone() }, st)
    end
    out.place_moves.insert(rid, ext)
  end
  out
end

def res_frame_equal(a: ResFrame, b: ResFrame) -> Bool
  if a.locals.len() != b.locals.len() then return false end
  for (id, ls) in a.locals do
    match b.locals.get(id)
    when Option::Some(lsb) then
      # Availability, capability flag, and permission origin are all part of
      # frame equality: a frame that gained/lost either differs and must be
      # re-merged by the worklist. Spans are NOT compared (they carry no
      # semantic state; only diagnostics).
      if !(ls.availability == lsb.availability) then return false end
      if !(ls.is_capability == lsb.is_capability) then return false end
      if !(ls.origin == lsb.origin) then return false end
    when Option::None then return false
    end
  end
  # The per-field lattice participates in frame equality: a partial-move
  # divergence must re-merge like any other state divergence.
  if a.place_moves.len() != b.place_moves.len() then return false end
  for (rid, chains) in a.place_moves do
    match b.place_moves.get(rid)
    when Option::Some(chains_b) then
      if chains.len() != chains_b.len() then return false end
      for (ch, st) in chains do
        match chains_b.get(ch)
        when Option::Some(st_b) then
          if !(st == st_b) then return false end
        when Option::None then return false
        end
      end
    when Option::None then return false
    end
  end
  true
end

def frame_assign(inout dst: ResFrame, src: ResFrame) -> Unit
  # Replace the whole frame: the previous contents (including any record a
  # stale parallel collection could have kept) vanish with the clear.
  dst.locals.clear()
  for (id, ls) in src.locals do
    dst.locals.insert(id, LocalState { availability: ls.availability, origin: ls.origin, is_capability: ls.is_capability, span: ls.span })
  end
  dst.place_moves.clear()
  for (rid, chains) in src.place_moves do
    var ext = Map::new()
    for (ch, st) in chains do
      ext.insert(ProjectionChain { keys: ch.keys.clone() }, st)
    end
    dst.place_moves.insert(rid, ext)
  end
end

def merge_frames(arms: Vec[ResFrame]) -> ResFrame
  mut out = res_frame_new()
  var union: Vec[tg_compiler::ids::LocalId] = Vec::new()
  mut a = 0
  while a < arms.len() do
    let arm = arms[a]
    for (id, _) in arm.locals do
      var found = false
      var ui = 0
      while ui < union.len() do
        if union[ui].id == id.id then found = true end
        ui = ui + 1
      end
      if !found then
        union.push(id)
      end
    end
    a = a + 1
  end
  mut i = 0
  while i < union.len() do
    let id = union[i]
    let first = res_frame_get(&arms[0], &id)
    match first
    when Option::Some(s0) then
      mut same = true
      mut a = 1
      while a < arms.len() do
        match res_frame_get(&arms[a], &id)
        when Option::Some(sx) then
          if !(s0 == sx) then same = false end
        when Option::None then same = false
        end
        a = a + 1
      end
      if same then
        res_frame_set(&mut out, id, s0)
      else
        res_frame_set(&mut out, id, ResourceState::MaybeLive)
      end
      res_frame_set_span(&mut out, &id, frame_span_any(arms, &id))
      if frame_caps_any(arms, &id) then
        res_frame_mark_cap(&mut out, &id)
      end
      # Origin is immutable per semantic local: every CFG arm for the same
      # local carries the same declared origin, so the first arm's origin is
      # authoritative. Missing/divergent origins are internal errors — the
      # permission must never be lost by merging (that would silently drop
      # let/inout protection).
      match frame_origin_any(arms, &id)
      when Option::Some(origin) then res_frame_set_origin(&mut out, &id, origin)
      when Option::None then ()
      end
    when Option::None then
      mut absent_all = true
      mut a = 1
      while a < arms.len() do
        match res_frame_get(&arms[a], &id)
        when Option::Some(_) then absent_all = false
        when Option::None then ()
        end
        a = a + 1
      end
      if !absent_all then
        res_frame_set(&mut out, id, ResourceState::MaybeLive)
        res_frame_set_span(&mut out, &id, frame_span_any(arms, &id))
        if frame_caps_any(arms, &id) then
          res_frame_mark_cap(&mut out, &id)
        end
        # The record must carry its immutable permission origin from the arm
        # that holds it (identical to the arms[0]-authoritative rule above in
        # every reachable join, where every local predates the split).
        match frame_origin_any(arms, &id)
        when Option::Some(origin) then res_frame_set_origin(&mut out, &id, origin)
        when Option::None then ()
        end
      end
    end
    i = i + 1
  end
  # (partial moves): the per-field lattice join — a chain's merged state is
  # definite only when EVERY arm agrees; a chain Live (absent) in one arm
  # and Consumed in another joins to MaybeLive (the scope-exit rejection
  # mirrors the root-level rule: the cleanup cannot be conditional).
  mut root_union = Vec::new()
  mut a2 = 0
  while a2 < arms.len() do
    let arm2 = arms[a2]
    for (rid, _) in arm2.place_moves do
      if !root_union.contains(&rid) then
        root_union.push(rid)
      end
    end
    a2 = a2 + 1
  end
  var ri = 0
  while ri < root_union.len() do
    let rid = root_union[ri]
    var chain_union = Vec::new()
    mut a3 = 0
    while a3 < arms.len() do
      match arms[a3].place_moves.get(rid)
      when Option::Some(chains) then
        for (ch, _) in chains do
          if !chain_union.contains(&ch) then
            chain_union.push(ch)
          end
        end
      when Option::None then ()
      end
      a3 = a3 + 1
    end
    var merged_chains = Map::new()
    var ci = 0
    while ci < chain_union.len() do
      let ch = chain_union[ci]
      var seen_in: Vec[ResourceState] = Vec::new()
      mut a4 = 0
      while a4 < arms.len() do
        match arms[a4].place_moves.get(rid)
        when Option::Some(chains4) then
          match chains4.get(ch)
          when Option::Some(st4) then seen_in.push(st4)
          when Option::None then ()
          end
        when Option::None then ()
        end
        a4 = a4 + 1
      end
      if seen_in.len() == arms.len() then
        mut same4 = true
        var s0_4 = seen_in[0]
        var si4 = 1
        while si4 < seen_in.len() do
          if !(s0_4 == seen_in[si4]) then same4 = false end
          si4 = si4 + 1
        end
        if same4 then
          merged_chains.insert(ProjectionChain { keys: ch.keys.clone() }, s0_4)
        else
          merged_chains.insert(ProjectionChain { keys: ch.keys.clone() }, ResourceState::MaybeLive)
        end
      else
        # Present in some arms, absent (Live) in others: the join is
        # path-conditional — a chain Consumed on one path and live on
        # another cannot be masked at the cleanup.
        merged_chains.insert(ProjectionChain { keys: ch.keys.clone() }, ResourceState::MaybeLive)
      end
      ci = ci + 1
    end
    if merged_chains.len() > 0 then
      out.place_moves.insert(rid, merged_chains)
    end
    ri = ri + 1
  end
  out
end

def frame_caps_any(arms: Vec[ResFrame], id: tg_compiler::ids::LocalId) -> Bool
  mut a = 0
  while a < arms.len() do
    let arm = arms[a]
    match arm.locals.get(id)
    when Option::Some(ls) then
      if ls.is_capability then
        return true
      end
    when Option::None then ()
    end
    a = a + 1
  end
  false
end

def frame_origin_any(arms: Vec[ResFrame], id: tg_compiler::ids::LocalId) -> Option[ParamOrigin]
  mut a = 0
  while a < arms.len() do
    let arm = arms[a]
    match arm.locals.get(id)
    when Option::Some(ls) then return Option::Some(ls.origin)
    when Option::None then ()
    end
    a = a + 1
  end
  Option::None
end

def frame_span_any(arms: Vec[ResFrame], id: tg_compiler::ids::LocalId) -> Span
  mut a = 0
  while a < arms.len() do
    let arm = arms[a]
    match arm.locals.get(id)
    when Option::Some(ls) then return ls.span
    when Option::None then ()
    end
    a = a + 1
  end
  Span { file: String::new(), start: 0, end_pos: 0 }
end

def bind_closure_params(inout env: TypeEnv, typed: TypedProgram, params: Vec[ClosureParam], inout frame: ResFrame) -> Vec[tg_compiler::ids::LocalId]
  mut out = Vec::new()
  mut i = 0
  while i < params.len() do
    match bind_closure_param(env, typed, &params[i], frame)
    when Option::Some(id) then out.push(id)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

def bind_closure_param(inout env: TypeEnv, typed: TypedProgram, cp: ClosureParam, inout frame: ResFrame) -> Option[tg_compiler::ids::LocalId]
  match cp.pat.kind
  when PatternKind::Ident(_, _) then
    match typed.pattern_binding_resolutions.get(cp.pat.node_id)
    when Option::Some(id) then
      match typed.local_bindings.get(id)
      when Option::Some(lb) then
 # boundary: same as bind_param — the typed pattern map is
        # Int-keyed (semantic local ids); the frame is LocalId-keyed.
        let lid = tg_compiler::ids::LocalId { id: id }
        if is_owning_typed(env, &lb.ty) then
          res_frame_set(frame, lid, ResourceState::Live)
          res_frame_set_span(frame, &lid, cp.span)
          res_frame_set_origin(frame, &lid, ParamOrigin::OwnedLocal)
        end
        if type_kind_contains_capability(env, &lb.ty) then
          res_frame_mark_cap(frame, &lid)
        end
        Option::Some(lid)
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end  end
end

def expr_root_id(typed: TypedProgram, expr: Expr) -> Option[Int]
  match expr.kind
  when ExprKind::ExprIdent(_) then
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then Option::Some(l)
    when Option::None then Option::None
    end
  when ExprKind::ExprFieldAccess(base, _) then expr_root_id(typed, &base)
  when ExprKind::ExprIndex(base, _) then expr_root_id(typed, &base)
  when ExprKind::ExprRawDeref(inner) then expr_root_id(typed, &inner)
  when ExprKind::ExprAccess(inner) then expr_root_id(typed, &inner)
  when ExprKind::ExprCast(inner, _) then expr_root_id(typed, &inner)
  when _ then Option::None
  end  end
end

def expr_is_plain(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprAccess(inner) then expr_is_plain(&inner)
  when ExprKind::ExprCast(inner, _) then expr_is_plain(&inner)
  when _ then false
  end  end
end

def expr_type_has_resource(inout env: TypeEnv, typed: TypedProgram, expr: Expr) -> Bool
  # The MOVE/transfer detection uses the SAME canonical ownership predicate
  # as binding: UniquePtr[Int], Box[Int], Vec[Int], etc. are move-only even
  # though their nominal kinds are Value — `let q = p` for an owner MUST
  # consume p, or both bindings finalize the same allocation.
  match typed.expr_types.get(expr.node_id)
  when Option::Some(t) then is_owning_typed(env, &t)
  when Option::None then false
  end
end

def transfer_consume(inout env: TypeEnv, typed: TypedProgram, expr: Expr, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError], inout finalize_plan: FunctionCleanupTable) -> Unit
  if expr_type_has_resource(env, typed, expr) then
    if !expr_is_plain(expr) then
      # (partial moves — the expression-level move-out): a projected move
      # (e.g. `let a = p.a`) now tracks the FIELD chain in the frame's
      # per-field lattice — the root stays Live, the chain becomes
      # Consumed, and the drop glue's mask excludes it. A finalizer subject
      # (DeinitSelf) keeps the finalizer-specific rejection: the one
      # destruction protocol forbids the hook from moving OWNED FIELDS out
      # of the subject — the compiler's structural cleanup would finalize
      # them a second time (the field-level consume inside a finalizer is
      # rejected by the same rule).
      match expr_root_id(typed, expr)
      when Option::Some(id) then
        # boundary: the frame is LocalId-keyed; expr_root_id yields the
        # raw Int semantic id (binding_name keeps the Int).
        let lid = tg_compiler::ids::LocalId { id: id }
        if res_frame_has(frame, &lid) then
          match res_frame_get_origin(frame, &lid)
          when Option::Some(ParamOrigin::DeinitSelf) then
            errors.push(ResourceError {
              message: "cannot consume resource `" + binding_name(typed, id) + "`: a finalizer must not consume its own subject (compiler-owned structural cleanup)",
              span: expr.span
            })
            return
          when _ then ()
          end
          var chain = Vec::new()
          let field_chain = place_projection_keys(typed, &expr, &mut chain)
          if field_chain then
            apply_projected_consume(env, typed, id, &chain, expr.span, loop_outer, frame, errors)
          else
            # The whole-value boundary (index/deref projections): the
            # per-index tracking is not feasible — the container's elements
            # are treated as the aggregate (the existing container-element
            # semantics: a "*" whole-value record at the type-check sites).
            # The frame marks the ROOT's own state MaybeLive — the
            # elements' state is indeterminate, so every whole use rejects
            # ("may be consumed on one path") and the scope-exit cleanup
            # cannot be conditional — the conservative boundary.
            apply_whole_boundary_consume(env, typed, id, expr.span, loop_outer, frame, errors)
          end
        end
      when Option::None then ()
      end
      return
    end
    match expr_root_id(typed, expr)
    when Option::Some(id) then
      # boundary: same as above — LocalId for the frame lookup.
      if res_frame_has(frame, &tg_compiler::ids::LocalId { id: id }) then
        apply_consume(typed, id, expr.span, loop_outer, frame, errors)
      end
    when Option::None then ()
    end
  end
end

# (partial moves): consume a projected chain — the per-field state
# tracking. The permission rules mirror apply_consume (DeinitSelf / Let /
# Inout / repeatable-loop rejections), applied to the chain's effective
# state (the prefix rule: a consumed prefix makes the rest dead); the
# commit marks the chain Consumed in the frame's lattice.
def apply_projected_consume(inout env: TypeEnv, typed: TypedProgram, id: Int, chain: Vec[ProjectionKey], span: Span, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  let lid = tg_compiler::ids::LocalId { id: id }
  match res_frame_get_origin(frame, &lid)
  when Option::Some(origin) then
    if origin == ParamOrigin::DeinitSelf then
      errors.push(ResourceError {
        message: "cannot consume resource `" + binding_name(typed, id) + "`: a finalizer must not consume its own subject (compiler-owned structural cleanup)",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Let then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: let parameter is read-only",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Inout then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: inout parameter may be modified but not consumed",
        span: span
      })
      return
    end
  when Option::None then ()
  end
  if loop_outer.contains(&id) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` cannot be consumed inside a repeatable loop",
      span: span
    })
  end
  match res_frame_get(frame, &lid)
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`",
      span: span
    })
  when _ then ()
  end
  let eff = chain_effective_state(frame, lid, chain)
  match eff
  when ResourceState::Consumed then
    errors.push(ResourceError {
      message: "field `" + chain_display(typed, chain) + "` of " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` consumed twice",
      span: span
    })
  when ResourceState::MaybeLive then
    errors.push(ResourceError {
      message: "field `" + chain_display(typed, chain) + "` of " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "` may be consumed on one path",
      span: span
    })
  when _ then ()
  end
  frame_place_mark(frame, lid, chain, ResourceState::Consumed)
end

# (partial moves — the whole-value boundary): a consume over a NON-field
# projection (an indexed/deref place). The per-index tracking is not
# feasible: the container's elements are treated as the aggregate (the
# existing container-element semantics — the "*" whole-value registry
# record). The frame marks the ROOT's own state MaybeLive — the elements'
# state is indeterminate ("may be consumed on one path" on every whole
# use; the scope-exit cleanup cannot be conditional) — the conservative
# boundary. The permission rules mirror apply_consume.
def apply_whole_boundary_consume(inout env: TypeEnv, typed: TypedProgram, id: Int, span: Span, loop_outer: Vec[Int], inout frame: ResFrame, inout errors: Vec[ResourceError]) -> Unit
  let lid = tg_compiler::ids::LocalId { id: id }
  match res_frame_get_origin(frame, &lid)
  when Option::Some(origin) then
    if origin == ParamOrigin::DeinitSelf then
      errors.push(ResourceError {
        message: "cannot consume resource `" + binding_name(typed, id) + "`: a finalizer must not consume its own subject (compiler-owned structural cleanup)",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Let then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: let parameter is read-only",
        span: span
      })
      return
    end
    if origin == ParamOrigin::Inout then
      errors.push(ResourceError {
        message: "cannot consume " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`: inout parameter may be modified but not consumed",
        span: span
      })
      return
    end
  when Option::None then ()
  end
  if loop_outer.contains(&id) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` cannot be consumed inside a repeatable loop",
      span: span
    })
  end
  match res_frame_get(frame, &lid)
  when Option::Some(ResourceState::Consumed) then
    errors.push(ResourceError {
      message: ownership_label(frame, id) + " `" + binding_name(typed, id) + "` consumed twice",
      span: span
    })
  when Option::Some(ResourceState::Uninitialized) then
    errors.push(ResourceError {
      message: "use of uninitialized " + ownership_label(frame, id) + " `" + binding_name(typed, id) + "`",
      span: span
    })
  when _ then ()
  end
  res_frame_set(frame, lid, ResourceState::MaybeLive)
end

def convention_effect(c: AccessConvention) -> AccessEffect
  match c
  when AccessConvention::Let then AccessEffect::Read
  when AccessConvention::Inout then AccessEffect::Modify
  when AccessConvention::Sink then AccessEffect::Consume
  when AccessConvention::Set then AccessEffect::Initialize
  end  end
end
