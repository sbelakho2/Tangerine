# Tangerine Compiler — ABI / FFI report (audit §43)
# Self-hosting compiler written in Tangerine
#
# The §43 FFI-report slice: ONE compact FfiReport per exported / extern
# symbol of a SemanticSnapshot, plus abi_diff (the per-symbol ABI diff
# between two reports) and abi_rows_of_snapshot (the snapshot's persisted
# ABI/layout rows, with the coarse §30 reconstruction as the pre-item-18
# fallback). The module reads ONLY SemanticSnapshot rows (semantic_model.tg
# records — never AST / typed / MIR state) and mirrors the
# semantic_index.tg / semantic_delta.tg / replay.tg idioms.
#
# ROW ANCHORS (what a snapshot actually carries): symbol rows keyed by
# the FULL stable key "path::name#signature" (the signature component is
# the semantic_snapshot.tg writer's own canonical render, e.g.
# "fn(let:Int,inout:Widget)->Unit"); mir_functions rows per def-keyed
# lowered function (extern declarations have no def-keyed lowering — the
# shim rows carry synthesized origins instead); abi_surfaces rows (audit
# item 18; extended by third-audit items 42/43) — the PERSISTED canonical
# ABI/layout rows: "fn:<full key>" rows carry the per-param class words
# and the return class PLUS the typed FFI-surface mirror (calling
# convention, external symbol, typed param classes/locations/extensions,
# per-param access conventions, return ownership word, nullability rows,
# variadic flag, platform triple, failure convention, thread-safety /
# taint words, canonical enum-crossing boundary); "type:<full key>" rows
# carry the layout size/alignment, the "name offset size" field rows and
# the platform word; "abi-fail-closed" rows carry their reason only
# (never fabricated values). The §30 CanonExternal frame text still never
# rides the snapshot (abi_hash digests snapshot_abi_text lines —
# "<digest> <key> <canonical text>" / "... generic" / "... abi-fail-closed"
# — but only the digest serializes), so external_signature stays
# unreconstructable from rows alone.
#
# REPORT ANCHORS — what ffi_report_of_symbol derives, field by field
# (third-audit item 43: the builder reads the persisted row VERBATIM —
# there is no signature-text scan left; the item-41 rule that this module
# never spells or parses a class word extends to every convention word):
#   DERIVED FROM SNAPSHOT ROWS:
#     symbol_key          — the row's full stable key text; the lookup
#                           accepts the full key OR the bare registration
#                           key "path::name" (a key-path match).
#     tangerine_signature — the "#signature" component of that key.
#     abi_name            — from the symbol's §30 abi row, when one is
#                           DEFINED (the §30 writer would emit one: pub
#                           Function-kind row WITH a def-keyed lowering —
#                           the mir_functions row presence; generic bases
#                           render the deterministic "generic" marker):
#                           the row's key word (the registration key per
#                           the "<digest> <key> ..." grammar). No abi row
#                           defined -> "internal" (an extern declaration
#                           has no §30 row — no def-keyed lowering — and
#                           the model records no link/export name for it;
#                           never invented).
#     external_signature — the §30 row's payload BEYOND the key when one
#                           is present and is not a writer marker
#                           ("generic" / "abi-fail-closed" never become
#                           signatures). Snapshot-reconstructed rows never
#                           carry the CanonExternal frame text (writer-
#                           side, never serialized), so this stays empty
#                           from a snapshot alone; the parse accepts the
#                           full §30 grammar so a row-bearing artifact
#                           feeds the same builder.
#     nullability         — the row's typed nullability list VERBATIM
#                           ("arg<i> unknown" per Ptr/PtrMut-typed
#                           parameter; "nonnull" once a marker
#                           convention exists). No fn row -> empty.
#     ownership_transfer  — the row's typed ownership words: one
#                           "arg<i> <conv>" line per param whose
#                           AccessConvention transfers ownership at the
#                           boundary ("sink" — callee takes the value;
#                           "set" — callee initializes caller storage),
#                           plus "return owned" when the row's
#                           ownership_out says the returned value owns
#                           state. let / inout are borrows and never
#                           transfer.
#     arg_locations / return_location — from the symbol's abi_surfaces
#                           "fn:" row when present: arg_locations = the
#                           row's arg_classes (one entry per param
#                           position, the canonical class word:
#                           "zero"/"scalar:<w>"/"pair:<w1>:<w2>"/"vector:<w>"/
#                           "by-address:<size>"); return_location = the
#                           row's ret_class ("direct:"/"sret:" + word).
#                           (third-audit item 41): these words are the
#                           report-boundary RENDERS of the typed ABI plan
#                           carriers — layout_engine's
#                           abi_value_class_word / abi_return_text /
#                           abi_location_text are the only renderers, and
#                           the snapshot writer fills the row through
#                           them; this module reads the protocol text
#                           verbatim, so it never spells or parses a
#                           class word.
#                           Reports whose row is absent or fail-closed stay
#                           empty — never invented.
#     layouts / alignments — from the symbol's abi_surfaces "type:" row
#                           when present (type symbols with a persisted
#                           layout row): layouts = "size <n>" plus one
#                           "field <name> offset <n> size <n>" per field
#                           (enum rows carry the tag and variant-qualified
#                           payload entries); alignments = "align <n>".
#                           A function report carries no layout row of its
#                           own, so both stay empty there; fail-closed
#                           rows contribute nothing.
#     calling_convention / external_symbol / variadic / platform /
#     canonical_boundary — from the symbol's abi_surfaces "fn:" row
#                           VERBATIM (third-audit items 42/43): the ABI
#                           classification word ("tangerine" for a
#                           def-keyed function, the extern tag for an
#                           extern declaration), the extern linker symbol,
#                           the variadic marker, the StableTargetId triple
#                           and the enum-crossing boundary word ("n/a"
#                           when the signature mentions no enum). No row
#                           -> "", false, "".
#   CONVENTION WORDS (report only — the row is the authority, absent row =
#   the no-data word, never an inference):
#     thread_safety       — "unknown" (no typed marker; never inferred).
#     taint               — "unmodeled".
#     failure_convention  — "trap" (the repo's panic model, the row's word
#                           for a non-Result return), "result" (the
#                           builtin-Result return) or "unknown"; absent
#                           row -> "unknown".
#
# abi_diff(old, new): the per-symbol ABI diff of TWO FfiReports. Identity:
# the reports' key PATH parts ("module::name") must agree — a signature
# change rewrites only the "#..." component; two different symbols diff
# to NOTHING (created / removed is the §31 delta's report). Row classes
# (sorted output), mapping the audit examples exactly:
#   "layout <sym> <old-entry> -> <new-entry>" — ONE line per POSITIONALLY
#     PAIRED, differing entry of the layouts / alignments lists (<sym> =
#     the report's bare symbol name): entries "size 24" / "size 32" of
#     the Widget report render "layout Widget size 24 -> 32"; entries
#     "field payload offset 8" / "... 16" render "layout Widget field
#     payload offset 8 -> 16".
#   "arg<i> <old-entry> -> <new-entry>" — location diffs from the
#     arg_locations lists (one entry per param position): "GPR" /
#     "indirect" at position 2 render "arg2 GPR -> indirect".
#   "return <old> -> <new>" — the return_location when BOTH sides carry
#     one and they differ (an empty side is "no location data", never a
#     location).
#   "signature <old> -> <new>" / "external-signature <old> -> <new>" —
#     the signature changes, appended; an empty side renders as the
#     empty text (the external side appearing / disappearing IS the §30
#     row membership change).
#   Unpaired list tails (a position present on one side only) are NOT
#   diffed — an entry created/removed is a structural row change (the
#   §31 created/removed domain), never guessed here.
#
# DETERMINISM: pure functions of the snapshot rows; param scans follow
# DECLARATION order, abi_rows_of_snapshot returns SORTED rows, abi_diff
# sorts its output lines. Nothing here parses anything back.

use std::core::{Option}
use std::collections::{Vec}

use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticSymbol, AbiSurfaceRow, semantic_def_kind_text,
  semantic_digest_render, semantic_stable_def_id_digest,
  semantic_abi_surface_row_text
}

# ———————————————————————————————————————————————————————————————
# The §43 record — ONE FfiReport per exported / extern symbol
# ———————————————————————————————————————————————————————————————
# Every Vec / String field is defaulted so sparse reports are
# expressible: an empty report claims nothing. (third-audit item 43) the
# typed FFI-surface fields (calling_convention / external_symbol /
# variadic / platform / canonical_boundary) are read from the symbol's
# persisted AbiSurfaceRow; the record-level defaults ("", false,
# empty-boundary) are the no-row answer. The three convention surfaces
# (thread_safety / taint / failure_convention) default to the no-row
# words ("unknown" / "unmodeled" / "unknown") and the builder overwrites
# them with the row's words verbatim.

struct FfiReport
  symbol_key: String = ""
  abi_name: String = ""
  tangerine_signature: String = ""
  external_signature: String = ""
  arg_locations: Vec[String] = Vec::new()
  return_location: String = ""
  layouts: Vec[String] = Vec::new()
  alignments: Vec[String] = Vec::new()
  nullability: Vec[String] = Vec::new()
  ownership_transfer: Vec[String] = Vec::new()
  calling_convention: String = ""
  external_symbol: String = ""
  variadic: Bool = false
  platform: String = ""
  canonical_boundary: String = ""
  thread_safety: String = "unknown"
  taint: String = "unmodeled"
  failure_convention: String = "unknown"
end

# ———————————————————————————————————————————————————————————————
# Stable-key text helpers (the model's key domain)
# ———————————————————————————————————————————————————————————————

# The index of the first needle occurrence at or after from (-1 if none).
def report_char_index(s: String, needle: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    if s.slice(i, i + 1) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The path/name component of a stable key: everything before the first
# "#signature" (a key without '#' is its own path) — the registration key.
def report_key_path(key: String) -> String
  let i = report_char_index(&key, "#", 0)
  if i < 0 then key.clone() else key.slice(0, i) end
end

# The signature component of a stable key: everything after the first
# '#' ("" when the key carries none — the extern-declaration shape).
def report_key_signature(key: String) -> String
  let i = report_char_index(&key, "#", 0)
  if i < 0 then "".to_string() else key.slice(i + 1, key.len()) end
end

# The bare name of a key: everything after the last "::" — the audit's
# <sym> label.
def report_key_name(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(pos, key.len())
    end
    pos = pos - 1
  end
  key.clone()
end

# Space-split a §30 abi row text into its words (the row grammar has no
# spaces inside any word: digest, keys, frame text and markers).
def report_row_words(row: String) -> Vec[String]
  var words: Vec[String] = Vec::new()
  var start = 0
  var i = 0
  while i < row.len() do
    if row.slice(i, i + 1) == " " then
      if start < i then
        words.push(row.slice(start, i))
      end
      start = i + 1
    end
    i = i + 1
  end
  if start < row.len() then
    words.push(row.slice(start, row.len()))
  end
  words
end

# ———————————————————————————————————————————————————————————————
# The §30 ABI-surface derivation over the model rows
# ———————————————————————————————————————————————————————————————

# Whether the symbol has a def-keyed lowering: a mir_functions row whose
# subject key equals the full stable key (externs never match).
def report_symbol_has_lowering(snapshot: SemanticSnapshot, sym: SemanticSymbol) -> Bool
  for m in snapshot.mir_functions do
    if m.function.key == sym.stable_id.key then
      return true
    end
  end
  false
end

# Whether a §30 abi row is DEFINED: pub Function-kind WITH a def-keyed
# lowering — the exact surface snapshot_abi_text renders. Everything else
# (private defs, methods, statics, types, externs) never gets a row.
def report_abi_row_defined(snapshot: SemanticSnapshot, sym: SemanticSymbol) -> Bool
  if !sym.is_pub then
    return false
  end
  if semantic_def_kind_text(&sym.kind) != "Function" then
    return false
  end
  report_symbol_has_lowering(&snapshot, &sym)
end

# The persisted abi_surfaces row of a symbol (audit item 18): the exact
# full-key match on the row's symbol_key (fn rows carry the function's
# full stable key, type rows the type's full key; the report is always
# looked up by the symbol's own full key). Option::None when the snapshot
# carries no row for the symbol (pre-item-18 artifacts, externs, and
# non-surface defs).
def report_surface_row_of(snapshot: SemanticSnapshot, sym: SemanticSymbol) -> Option[AbiSurfaceRow]
  for row in snapshot.abi_surfaces do
    if row.symbol_key == sym.stable_id.key then
      return Option::Some(row.clone())
    end
  end
  Option::None
end

# The layout entries of a type surface row: "size <n>" plus one
# "field <name> offset <n> size <n>" per "name offset size" field text
# (the row grammar is produced by semantic_snapshot.tg's type row builder;
# a text that does not split into the full triple degrades to the raw
# field text rather than inventing offsets).
def report_layout_entries_of(row: AbiSurfaceRow) -> Vec[String]
  var out: Vec[String] = Vec::new()
  if row.size >= 0 then
    out.push("size " + row.size.to_string())
  end
  for f in row.fields do
    let words = report_row_words(&f)
    if words.len() >= 3 then
      out.push("field " + words[0].clone() + " offset " + words[1].clone() +
        " size " + words[2].clone())
    elsif words.len() >= 2 then
      out.push("field " + words[0].clone() + " offset " + words[1].clone())
    else
      out.push("field " + f.clone())
    end
  end
  out
end

# The §30-grammar row text, reconstructed as far as a snapshot allows:
# "<digest> <registration key>" plus the " generic" marker for generic
# bases. The CanonExternal frame text never rides a snapshot (documented
# gap — the external side stays absent, like §31's reconstruction).
def report_abi_row_text(snapshot: SemanticSnapshot, sym: SemanticSymbol) -> String
  let digest_text = semantic_digest_render(&semantic_stable_def_id_digest(&sym.stable_id))
  var row = digest_text + " " + report_key_path(&sym.stable_id.key)
  if sym.is_generic then
    row = row + " generic"
  end
  row
end

# The §30 row parse: word 1 is the abi name (the row's key word); word 2,
# when present and not a writer marker, is the EXTERNAL side.
def report_parse_abi_row(row: String) -> (String, String)
  let words = report_row_words(&row)
  var name = "internal".to_string()
  var external = "".to_string()
  if words.len() >= 2 then
    name = words[1].clone()
    if words.len() >= 3 then
      let payload = words[2].clone()
      if payload != "generic" && payload != "abi-fail-closed" then
        external = payload
      end
    end
  end
  (name, external)
end

# ———————————————————————————————————————————————————————————————
# Canonical-signature scans: RETIRED (third-audit item 43)
# ———————————————————————————————————————————————————————————————
# The nullability / ownership-transfer / location answers used to be
# heuristic scans over the canonical signature text (the "conv:" prefixes
# and the Ptr spelling). They are RETIRED: the typed FFI-surface fields
# ride the persisted abi_surfaces rows (semantic_snapshot.tg's fn-row
# producer reads the checker's FnSignature, the plan authority and the
# type-properties engine), and this module reads those row fields
# VERBATIM. No signature text is parsed back anywhere below.

# ———————————————————————————————————————————————————————————————
# THE REPORT BUILDER — one FfiReport per exported / extern symbol
# ———————————————————————————————————————————————————————————————
# The symbol row lookup: the full stable key text first, then the bare
# registration key "module::name" (a key whose path part matches). The
# report exists for the FFI surface — pub Function-kind symbol rows
# (regular exported defs AND extern declarations, which register as pub
# Function rows) AND pub TypeName rows for the persisted type-layout
# surfaces (item 18: the type row is the only carrier of layouts /
# alignments, so a type symbol must be reportable for those to be
# diffable). Any other kind, a non-pub row, or no matching row yields
# Option::None.

pub def ffi_report_of_symbol(snapshot: SemanticSnapshot, symbol_key: String) -> Option[FfiReport]
  var found: Option[SemanticSymbol] = Option::None
  for sym in snapshot.symbols do
    if sym.stable_id.key == symbol_key then
      found = Option::Some(sym.clone())
      break
    end
  end
  match found
  when Option::Some(_) then ()
  when Option::None then
    for sym2 in snapshot.symbols do
      if report_key_path(&sym2.stable_id.key) == symbol_key then
        found = Option::Some(sym2.clone())
        break
      end
    end
  end
  var sym = match found
  when Option::Some(s) then s
  when Option::None then return Option::None
  end
  let kind_word = semantic_def_kind_text(&sym.kind)
  let is_fn = kind_word == "Function" && sym.is_pub
  let is_type = kind_word == "TypeName" && sym.is_pub
  if !is_fn && !is_type then
    return Option::None
  end

  let full_key = sym.stable_id.key.clone()
  let sig = report_key_signature(&full_key)
  var abi_name = "internal".to_string()
  var external_sig = "".to_string()
  if is_fn && report_abi_row_defined(&snapshot, &sym) then
    let parsed = report_parse_abi_row(&report_abi_row_text(&snapshot, &sym))
    abi_name = parsed.0
    external_sig = parsed.1
  end

  # The typed FFI-surface fields (third-audit items 42/43): read from the
  # symbol's persisted abi_surfaces row VERBATIM — the row carries the
  # nullability rows, the per-param access conventions, the return
  # ownership word, the variadic flag, the platform triple, the failure /
  # thread-safety / taint words and the canonical enum-crossing boundary.
  # A missing or fail-closed row leaves the no-data words (empty lists /
  # "", "unknown", "unmodeled") — never an inference.
  var nullability: Vec[String] = Vec::new()
  var ownership_transfer: Vec[String] = Vec::new()
  var calling_convention = "".to_string()
  var external_symbol = "".to_string()
  var variadic = false
  var platform = "".to_string()
  var canonical_boundary = "".to_string()
  var thread_safety = "unknown".to_string()
  var taint = "unmodeled".to_string()
  var failure_convention = "unknown".to_string()
  var arg_locations: Vec[String] = Vec::new()
  var return_location = "".to_string()
  var layouts: Vec[String] = Vec::new()
  var alignments: Vec[String] = Vec::new()
  match report_surface_row_of(&snapshot, &sym)
  when Option::Some(row) then
    if row.platform.len() > 0 then
      platform = row.platform.clone()
    end
    if row.kind == "fn" then
      for w in row.arg_classes do
        arg_locations.push(w.clone())
      end
      return_location = row.ret_class.clone()
      nullability = row.nullability.clone()
      var pi = 0
      for conv in row.ownership_in do
        if conv == "sink" || conv == "set" then
          ownership_transfer.push("arg" + pi.to_string() + " " + conv.clone())
        end
        pi = pi + 1
      end
      if row.ownership_out == "owned" then
        ownership_transfer.push("return owned")
      end
      calling_convention = row.calling_convention.clone()
      external_symbol = row.external_symbol.clone()
      variadic = row.variadic
      canonical_boundary = row.canonical_boundary.clone()
      if row.thread_safety.len() > 0 then
        thread_safety = row.thread_safety.clone()
      end
      if row.taint.len() > 0 then
        taint = row.taint.clone()
      end
      if row.failure_convention.len() > 0 then
        failure_convention = row.failure_convention.clone()
      end
    elsif row.kind == "type" then
      layouts = report_layout_entries_of(&row)
      if row.alignment >= 0 then
        alignments.push("align " + row.alignment.to_string())
      end
    end
    # "abi-fail-closed": no layout / class data exists on the row — the
    # lists stay empty and the convention words keep their no-data values
    # (the reason text is available through abi_rows_of_snapshot; nothing
    # is fabricated here).
  when Option::None then ()
  end

  Option::Some(FfiReport {
    symbol_key: full_key,
    abi_name: abi_name,
    tangerine_signature: sig,
    external_signature: external_sig,
    arg_locations: arg_locations,
    return_location: return_location,
    layouts: layouts,
    alignments: alignments,
    nullability: nullability,
    ownership_transfer: ownership_transfer,
    calling_convention: calling_convention,
    external_symbol: external_symbol,
    variadic: variadic,
    platform: platform,
    canonical_boundary: canonical_boundary,
    thread_safety: thread_safety,
    taint: taint,
    failure_convention: failure_convention
  })
end

# ———————————————————————————————————————————————————————————————
# abi_diff — the per-symbol ABI diff of two reports
# ———————————————————————————————————————————————————————————————
# Identity rule: the reports' key PATH parts must agree (a signature
# change only rewrites the "#..." component; two different symbols are
# created/removed territory — the §31 delta's report — and diff to
# nothing). Row classes per the module doc; the output is sorted.
pub def abi_diff(old_report: FfiReport, new_report: FfiReport) -> Vec[String]
  var lines: Vec[String] = Vec::new()
  if report_key_path(&old_report.symbol_key) != report_key_path(&new_report.symbol_key) then
    return lines
  end
  let sym = report_key_name(&old_report.symbol_key)

  # Layout / alignment entries: positional pairs only — one line per
  # differing position ("layout <sym> size 24 -> 32" style). Unpaired
  # tails (a created/removed entry) are structural changes, never
  # guessed here (documented).
  var i = 0
  while i < old_report.layouts.len() && i < new_report.layouts.len() do
    if old_report.layouts[i] != new_report.layouts[i] then
      lines.push("layout " + sym + " " + old_report.layouts[i] + " -> " + new_report.layouts[i])
    end
    i = i + 1
  end
  var j = 0
  while j < old_report.alignments.len() && j < new_report.alignments.len() do
    if old_report.alignments[j] != new_report.alignments[j] then
      lines.push("layout " + sym + " " + old_report.alignments[j] + " -> " + new_report.alignments[j])
    end
    j = j + 1
  end

  # Arg-location entries: positional pairs, one entry per param position
  # ("arg2 GPR -> indirect" style).
  var k = 0
  while k < old_report.arg_locations.len() && k < new_report.arg_locations.len() do
    if old_report.arg_locations[k] != new_report.arg_locations[k] then
      lines.push("arg" + k.to_string() + " " + old_report.arg_locations[k] + " -> " + new_report.arg_locations[k])
    end
    k = k + 1
  end

  # The return location: fires only between two MODELED locations (an
  # empty side is "no location data", never a location).
  if old_report.return_location.len() > 0 && new_report.return_location.len() > 0 &&
    old_report.return_location != new_report.return_location then
    lines.push("return " + old_report.return_location.clone() + " -> " + new_report.return_location.clone())
  end

  # The signature changes, appended. The tangerine signature fires on any
  # difference; the external side fires on any difference where at least
  # one side is present (an empty side renders as the empty text — a
  # present/absent transition IS the §30 row membership change).
  if old_report.tangerine_signature != new_report.tangerine_signature then
    lines.push("signature " + old_report.tangerine_signature.clone() + " -> " + new_report.tangerine_signature.clone())
  end
  if old_report.external_signature != new_report.external_signature &&
    (old_report.external_signature.len() > 0 || new_report.external_signature.len() > 0) then
    lines.push("external-signature " + old_report.external_signature.clone() + " -> " + new_report.external_signature.clone())
  end

  lines.sort_by(|a, b| a < b)
  lines
end

# ———————————————————————————————————————————————————————————————
# The persisted ABI/layout row texts (audit item 18; the fallback below
# serves pre-item-18 artifacts whose abi_surfaces table is empty).
# ———————————————————————————————————————————————————————————————
# When the snapshot carries abi_surfaces rows, the function returns their
# canonical texts (semantic_abi_surface_row_text — the SAME grammar the
# delta's per-surface before/after texts use): one row per pub def-keyed
# fn OR pub extern declaration and per declared nominal type, sorted, with
# classification failures visible as "kind=abi-fail-closed" rows carrying
# reason:<word>. (third-audit items 42/43) the row text now APPENDS the
# typed FFI-surface pairs ("conv=" / "extern=" / "pclasses=" / "plocs=" /
# "ownin=" / "ownout=" / "null=" / "variadic=" / "ext=" / "platform=" /
# "failure=" / "thread=" / "taint=" / "boundary="), so an abi.diff's
# per-surface text explains ownership/convention changes too; the item-18
# prefix order is unchanged for prefix readers.
# When the table is empty (an artifact produced before item 18, or a
# builder that persisted no rows) the coarse §30 fallback renders the rows
# a snapshot alone supports: pub Function-kind symbol rows WITH a
# def-keyed lowering, as "<digest> <registration key>" (plus the
# deterministic " generic" marker for generic bases). The CanonExternal
# frame text of non-generic members never rides a snapshot (documented
# gap), so the fallback rows carry no external signature.
pub def abi_rows_of_snapshot(snapshot: SemanticSnapshot) -> Vec[String]
  if snapshot.abi_surfaces.len() > 0 then
    var surface_rows: Vec[String] = Vec::new()
    for r in snapshot.abi_surfaces do
      surface_rows.push(semantic_abi_surface_row_text(&r))
    end
    surface_rows.sort_by(|a, b| a < b)
    return surface_rows
  end
  var rows: Vec[String] = Vec::new()
  for sym in snapshot.symbols do
    if report_abi_row_defined(&snapshot, &sym) then
      rows.push(report_abi_row_text(&snapshot, &sym))
    end
  end
  rows.sort_by(|a, b| a < b)
  rows
end
