  if off < -1020 || off > 1020 || (off % 4) != 0 then
    panic("t2_vldr_f32: offset must be a 4-aligned -1020..1020")
  end
  let u = (if off >= 0 then 0x800000 else 0 end) as u32
  let imm8 = ((if off < 0 then -off else off end) / 4) as u32
  t2_word(b, 0xED100A00 | u | (((sd as u32) & 1) << 22) | ((rn as u32) << 16) | (((sd as u32) >> 1) << 12) | (imm8 & 0xFF))
end

# VSTR.F32 Sd, [Rn, #off] — word 0xED800A00 | ... for off >= 0 and
