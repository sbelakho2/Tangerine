  let imm8 = ((if off < 0 then -off else off end) / 4) as u32
  t2_word(b, 0xED100A00 | u | (((sd as u32) & 1) << 22) | ((rn as u32) << 16) | (((sd as u32) >> 1) << 12) | (imm8 & 0xFF))
