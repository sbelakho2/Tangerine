# VLDR.F64 Dd, [Rn, #off] — 32-bit VFP load (A7.8), word 0xED900B00 |
# Rn<<16 | (Dd&15)<<12 | imm8 | (Dd>>4)<<22 for off >= 0 and
# 0xED100B00 | ... for off < 0 (bit 23 = U: 1 adds, 0 subtracts); imm8 =
# |off|/4, so off is a 4-aligned -1020..1020 byte offset; Rn = r0-r13
# (SP allowed — the 16-bit LDR has no SP base, so this is the SP-relative
# double load form). Verified: vldr.f64 d0, [r0, #0] = 0xED900B00;
# vldr.f64 d17, [r3, #40] = 0xEDD31B0A; vldr.f64 d17, [r3, #-40] =
# 0xED531B0A; vldr.f64 d9, [r12, #-1020] = 0xED1C9BFF. FLAGLESS.
def t2_vldr_f64(inout b: CodeBuffer, dd: Int, rn: Int, off: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vldr_f64: register must be d0-d31") end
  if rn < 0 || rn > 13 then panic("t2_vldr_f64: base must be r0-r13") end
  if off < -1020 || off > 1020 || (off % 4) != 0 then
    panic("t2_vldr_f64: offset must be a 4-aligned -1020..1020")
  end
  let u = (if off >= 0 then 0x800000 else 0 end) as u32
  let imm8 = ((if off < 0 then -off else off end) / 4) as u32
  t2_word(b, 0xED100B00 | u | (((dd as u32) >> 4) & 1) << 22 | ((rn as u32) << 16) | (((dd as u32) & 15) << 12) | (imm8 & 0xFF))
end

# VSTR.F64 Dd, [Rn, #off] — 32-bit VFP store, word 0xED800B00 | ... for
# off >= 0 and 0xED000B00 | ... for off < 0 (bit 20 = L is 0), fields as
# t2_vldr_f64. Verified: vstr.f64 d0, [r0, #0] = 0xED800B00;
# vstr.f64 d17, [r3, #40] = 0xEDC31B0A; vstr.f64 d17, [r3, #-40] =
# 0xED431B0A; vstr.f64 d17, [r3, #1020] = 0xEDC31BFF. FLAGLESS.
def t2_vstr_f64(inout b: CodeBuffer, dd: Int, rn: Int, off: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vstr_f64: register must be d0-d31") end
  if rn < 0 || rn > 13 then panic("t2_vstr_f64: base must be r0-r13") end
  if off < -1020 || off > 1020 || (off % 4) != 0 then
    panic("t2_vstr_f64: offset must be a 4-aligned -1020..1020")
  end
  let u = (if off >= 0 then 0x800000 else 0 end) as u32
  let imm8 = ((if off < 0 then -off else off end) / 4) as u32
  t2_word(b, 0xED000B00 | u | (((dd as u32) >> 4) & 1) << 22 | ((rn as u32) << 16) | (((dd as u32) & 15) << 12) | (imm8 & 0xFF))
end

# VLDR.F32 Sd, [Rn, #off] — single form, word 0xED900A00 | ... for
# off >= 0 and 0xED100A00 | ... for off < 0 with (Sd>>1)<<12 | (Sd&1)<<22
# (double-slot encoding; imm8/offset/base ranges as t2_vldr_f64).
