# Tangerine Compiler — Cortex-M (Thumb-2) backend over the LIR
# Self-hosting compiler written in Tangerine
#
# AUDIT P1-14, slice 2 — a minimal but REAL Cortex-M backend over the
# P1-7 LIR slice (lir.tg). The LIR's aarch64 slice (MIR -> LIR lowering,
# linear-scan allocation, aarch64 emission in lir_emit_fn) is unchanged;
# this module emits the cortex-m LIR function shapes (lower_mir_fn_to_lir_cm
# / lir_peephole / lir_alloc_registers_cm) as Thumb-2 machine code,
# driven by the data-driven description the route is given — one of the
# four per-CPU ARMv7-M instances of target_desc.tg
# (thumbv7m_cortex_m3 / thumbv7em_cortex_m4 / thumbv7em_cortex_m4f /
# thumbv7em_cortex_m7; the desc carries the canonical register
# classes/ABI data — nothing is re-derived here). AUDIT §16: the
# pre-slice single cortex_m_desc conflated the CPU with an always-
# present VFP unit; the per-CPU split means the float route is now
# GATED on the desc's fpu/float_abi fields — an M3 or a bare M4
# (fpu None, float_abi Soft) must NOT receive a VFP instruction, so
# any function whose allocation carries float content fails closed
# against those descriptors (see the desc-driven FP gate below).
#
# ── What this slice emits, and how ─────────────────────────────────
#   The machine model is AAPCS32 on ARMv7-M (Thumb-2, 32-bit
#   little-endian words, 8-byte stack alignment):
#     - parameters 0..3 arrive in r0..r3; the LIR's parameter bindings
#       (LirMove from fixed vregs 0..3) are the ONLY fixed-vreg traffic
#       this backend accepts (fixed vregs 4..7 are the aarch64 ABI
#       registers x4..x7 — the cortex-m lowering never produces them,
#       see the fail-closed list below);
#     - return value in r0; BX LR epilogue;
#     - AAPCS STACK ARGUMENTS (this slice): every parameter index >= 4
#       arrives on the caller's stack — the caller pushed argument
#       words in order (argument 4 at the LOWEST address, [SP] at the
#       branch), and the LIR's cortex-m lowering (lir.tg,
#       lower_mir_fn_to_lir_cm) binds every parameter index >= 4 with a
#       LirLoadFrame whose payload is the AAPCS-canonical offset
#       [fp + 8 + 4*(i-4)] (fp = incoming SP minus the 8-byte {fp,lr}
#       push of the AAPCS model). The real frame differs from that
#       model by construction — this backend's prologue pushes
#       {r4-r10, lr} (32 bytes) and points r7 at the BOTTOM of the
#       local frame — so the emitter translates each payload to the
#       machine offset [r7 + frame_bytes + 24 + payload] (plus the
#       64-byte VPUSH {d8-d15} bias when the function carries FP
#       content: thumb_stack_param_off; derivation in the LirLoadFrame
#       emitter arm below). Call sites with more than
#       4 arguments push the overflow words themselves (see the caller
#       stack-argument push slice below);
#     - the allocator's fixed precolored vregs 0..3 are r0..r3; its pool
#       ids 9..14 map onto SIX callee-saved registers derived from the
#       desc's reg_callee_saved (r4..r11 minus the frame pointer r7, in
#       desc order: r4, r5, r6, r8, r9, r10). Pool registers are
#       saved/restored in the prologue/epilogue (PUSH/POP {r4-r10, lr}),
#       so the AAPCS callee-saved contract holds for external callers.
#       Parameter vregs 4..7 (the index-4..7 parameters of > 4-parameter
#       functions) are ORDINARY vregs whose only def is the entry
#       LirLoadFrame — the allocator gives them pool registers or
#       spill slots exactly like every other non-precolored vreg;
#     - the LIR allocator still treats pool registers as caller-saved
#       (its store-before-call / reload-after-call records — invariant
#       I2): those stores/reloads are redundant-but-correct for
#       callee-saved registers and keep the machinery target-agnostic;
#     - frame pointer r7 = SP after PUSH + SUB (prologue: PUSH {r4-r10,
#       lr}; sub sp, #frame; mov r7, sp). Spill slot i is the 4-byte
#       word at [r7 + 4*i] (positive offsets only — the 16-bit LDR/STR
#       imm5*4 forms, then LDR.W/STR.W byte-offset imm12 forms, then a
#       movw/add address path; frames up to 65532 bytes of slots);
#     - flags: invariant I1 is preserved — the only flag-writing
#       instructions this emitter produces are the LirCmp's CMP and the
#       cset ITE block's two conditional MOVS (which execute after the
#       Cmp's consumer has read the flags). ALL other arithmetic uses
#       the flagless 32-bit Thumb-2 encodings (ADD.W/SUB.W/AND.W/ORR.W/
#       EOR.W/MUL.W/RSB.W/MVN.W and the LSL/LSR/ASR.W forms); moves and
#       loads/stores are flagless (MOV/MOVW/MOVT 0x4600/0xF240/0xF2C0).
#     - CALLER STACK-ARGUMENT PUSHES (this slice): a call with more
#       than 4 arguments emits one LirPushArg statement per overflow
#       word, in DESCENDING index order (argument n-1 first ... argument
#       4 LAST, so argument 4 sits at the lowest address, [SP], at the
#       BL — the exact layout the callee's entry loads read). Each
#       statement lowers to a 4-byte word push: sub sp, #4 then a
#       word store at [SP]. AAPCS requires the caller's SP to be
#       8-BYTE ALIGNED at the BL, so the lowering pads ODD word counts
#       with one extra word at the TOP of the caller block (the first
#       push — see lir.tg's lir_lower_call for the chosen padding), and
#       every cortex-m LirCall therefore carries an EVEN stack_args
#       (4-byte words, the padding included). The callee ignores the
#       pad; the caller's SP cleanup after the BL (add sp,
#       #4*stack_args) removes the whole block. SP returns to its
#       frame value after every call, so the body never observes a
#       lowered SP between calls.
#     - BL clobbers LR and the caller-saved r0-r3/r12, matching the
#       allocator's caller-saved contract for the values it spills
#       around calls (invariant I2); the pool registers ride the call.
#
# ── THE 32-BIT WORD MODEL (why the LIR's 64-bit words compile) ─────
#   The ARMv7-M descriptions model ILP32 (target_desc.tg's contract:
#   the integer word is exactly pointer_width). This backend therefore
#   treats every
#   LIR word as a 32-bit machine word and FAILS CLOSED on any payload a
#   32-bit word cannot hold faithfully:
#     - integer/constant payloads must fit [-2^31, 2^32) (a 64-bit
#       constant like 2^40 has no 32-bit image and is rejected — the
#       sized-width LIR rules lower on the aarch64 route only);
#     - shift amounts must fit [0, 255]; register-count shifts use the
#       machine's register-form semantics (count = Rm[7:0], saturating:
#       LSL/LSR by >= 32 -> 0, ASR -> sign-fill — identical to the
#       aarch64 64-bit results in the low 32 bits whenever the operand
#       values themselves fit 32 bits).
#
# ── FAIL-CLOSED (each construct names its rule; never a wrong byte) ─
#   - any use of fixed vregs 4..7: those are the aarch64 ABI registers
#     x4..x7. The cortex-m lowering (lower_mir_fn_to_lir_cm) binds
#     parameters/arguments 0..3 onto the fixed r0..r3 vregs and routes
#     every index >= 4 through the AAPCS caller stack (LirLoadFrame /
#     LirPushArg below), so a fixed vreg 4..7 in a statement marks a
#     LIR function lowered with the aarch64 conventions — rejected
#     rather than passed in r4..r7 (breaking AAPCS extern calls).
#   - LirLoadFrame payloads outside the AAPCS stack-parameter geometry
#     (4-aligned, >= 8): the cortex-m lowering emits payload
#     8 + 4*(i-4) for parameter index i >= 4 only, so any other payload
#     marks a foreign lowering — fail-closed. (This is a geometry
#     sanity net, not the aarch64-convention guard: an aarch64-
#     convention LIR function is caught by the fixed-vreg 4..7
#     rejections above, which its parameter binds always trip before
#     any LirLoadFrame can be evaluated.)
#   - 64-bit payloads and shift counts outside the word model above are
#     rejected: the width-aware LIR rules that lower sized widths exist
#     only on the aarch64 route — this route keeps its word-only accept
#     set, and any payload the 32-bit model cannot hold faithfully
#     fails closed.
#   - div/mod: lir.tg's lowering gates Div/Mod to the aarch64 route
#     (div_ok true there); on this route the gate stays closed, so a
#     Div/Mod fails closed at lowering with a rule-naming Err before
#     any LIR reaches this backend. This backend's encoder set has no
#     SDIV/UDIV either — even though EVERY ARMv7-M core this module
#     models (M3/M4/M7 — the descs carry integer_div = Hardware; the
#     audit-corrected fact: ARMv7-M always provides SDIV/UDIV, the old
#     "no divide on M3" comment was wrong; only the ARMv6-M M0/M0+
#     class lacks them, RuntimeHelper there) has the instructions, the
#     slice keeps the lowering gate closed and the SDIV/UDIV encoders
#     are a later slice, so no behavior changes here.
#   - wide (64-bit) multiply results: MUL.W computes the low 32 bits —
#     faithful for 32-bit-faithful operands (the word model above).
#   - whole-program STATICS: the scalar-constant subset IS implemented
#     (the .data emission + the MOVW/MOVT-address static loads — see
#     the statics section below); statics beyond the subset — floats,
#     strings, pointers, aggregate/collection images — and static
#     WRITES (the MirStaticAddr address-of forms) fail closed with
#     their concrete rules in lir.tg's shared gates.
#   - floats: the float slice IS implemented in its REGISTER-RESIDENT
#     (F64 — F32 values are MEMORY-CLASS on this route, see below) and
#     MEMORY-RESIDENT envelopes plus the float ABI CROSSINGS
#     (float locals/statements lower since the float-body slice; the
#     statement arms load spill-slot operands into the d14/d15
#     statement scratches at the width — s28/s30 for F32 — and store
#     memory-resident defs at the width, and since the float-ABI
#     slice the float RETURN crossing — LirRet to the VFP d0/s0 return
#     register —, the float CALL-RESULT capture from d0/s0 after a
#     call, the float STACK-PARAMETER binds (LirLoadFrame at the
#     width) and the call CROSSING of live float values (the width-
#     aware pre-call spill stores and post-call reloads) all lower at
#     the crossings; the float-ABI RESIDUAL slice adds the caller side
#     of the stack stream — a float argument beyond d0..d7 rides the
#     shared 4-byte AAPCS32 word stream and the emitter's LirPushArg
#     arm stores it at its width (VSTR.F32 one word / VSTR.F64 the
#     exact 8-byte double at the even base the lowering aligned, the
#     interspersed alignment pad pushed below the unit) — and the F32
#     int<->float TRANSMUTES (bm-marked VMOV Sd/Rt crossings, bit
#     patterns preserved; an F64 pair fails closed at the 32-bit word
#     model); the cm allocator's width-aware slot geometry
#     (LirAlloc.slot_words — an F64 image's home is TWO 4-byte words
#     at an even base, an F32 image one word) makes the 8-byte F64
#     slot images exact). F32 values are MEMORY-CLASS on this route:
#     the cm allocator entry (lir_alloc_registers_cm) never places an
#     F32 vreg in the FP pool (d8..d13 — the M-profile single aliases
#     are s0..s31 = d0..d15 only and are not re-derived from the pool
#     doubles), so every F32
#     statement lowers load-op-store through the d15/d14 statement
#     scratches. F64 values ride the pool d8..d13 when register-
#     resident (the FP callee-save block below preserves them).
#     FLOAT ADMISSION IS DESC-DRIVEN (audit §16): the VFP
#     emission below is legal ONLY when the route's descriptor has an
#     FPU and the hard-float ABI (fpu FPv4SP/FPv5D16, float_abi Hard —
#     the cortex-m4f/cortex-m7 instances; the M4F crossing rules are
#     the s0..s15/d0..d7 AAPCS32 VFP CPRC the float-ABI slice
#     implemented). Against a cortex-m3/cortex-m4 descriptor (fpu
#     None, float_abi Soft) every function whose allocation carries
#     float content fails closed at the desc-driven FP gate below —
#     never a VFP byte for a core without an FPU. The FPU VARIANT gate
#     adds the F64 split: on FPv4-SP/FPv5-SP (target_desc_f64_data_
#     processing false) the F64 data-processing statements fail closed
#     and the F64 envelope is the load/store/transfer/copy subset; on
#     FPv5D16 (cortex-m7) the full F64 data-processing surface lowers.
#     VARIADIC EXTERN CALLS (audit §16/§26): AAPCS32 says a VARIADIC call
#     is made with the BASE convention — no VFP CPRC at all, floats
#     ride general registers/stack as base-type words — while the
#     shared LIR lowering marshals every call per-class into the VFP
#     registers whenever the float route is open (it has no variadic
#     marker). This backend RE-DERIVES the whole call's base convention
#     at emission: a variadic call block's hard-float marshal
#     statements are skipped and the argument stream is rebuilt as
#     base-type words — an F64 (or the §26-promoted F64 image of an
#     F32 extra, a real F32 -> F64 conversion) rides an aligned even-odd
#     r0..r3 pair via vmov r,r,d, or an 8-byte-aligned caller-stack
#     unit; the GP words continue the same r0..r3 / 4-byte word stream
#     (see the AAPCS32 variadic base-convention marshaller section
#     below). The F32 promotion needs double-precision VFP
#     (vcvt.f64.f32) and therefore fails closed on the
#     FPv4-SP/FPv5-SP cortex-m4f instances, whose F64 envelope is the
#     load/store/transfer subset.
#     Atomics via the ARMv7-M
#     LDREX/STREX exclusives ARE implemented on this route (the
#     ARMv7-M class of every family instance — native_atomic_widths
#     [1, 2, 4]; see the exclusive-access encoder section
#     and the pointer/atomic statement-emission section): the cortex-m
#     lowering entry (lower_mir_fn_to_lir_cm in lir.tg, cm_atomics)
#     opens the pointer/atomic slice at the width class [1, 2, 4] —
#     the width-1/2/4 atomic intrinsics lower to marked
#     LirPtrOp statements, translated here into LDREX/STREX loops with
#     the DMB SY ordering discipline (the per-ordering table is in the
#     pointer/atomic emission section below, mirroring clang's
#     ARMv7-M __atomic emission, verified offline) — while the _u64
#     width fails closed at lowering (ARMv7-M has no 8-byte
#     exclusive/doubleword atomic form) and the width-8 marked forms
#     fail closed in thumb_validate_ptr_stmt.
#     THE INTERRUPT ABI (audit §16 — the NVIC handler slice): the
#     descs model the handler convention as data (interrupt_abi: the
#     NVIC record of target_desc.tg — entry_auto_saved
#     [r0-r3, r12, lr, pc, xpsr], the "bx lr with lr = exc_return"
#     exit rule, reserved [lr]) and this backend now COMPILES
#     @interrupt functions against that record (see the INTERRUPT ABI
#     section below): an @interrupt function (MirFunction.attr_interrupt
#     — stamped by mir.tg's lower_program PASS 2 from the item's
#     attribute list, carried through monomorphization, lowered into
#     LirFunction.attr_interrupt) is emitted with the NVIC handler
#     prologue/epilogue — the EXC_RETURN discipline over LR — and is
#     registered into an .isr_vector section of the ELF object so a
#     board/startup link step can place the handler addresses. The
#     prologue/epilogue reuse the ordinary-function frame discipline
#     (PUSH {r4-r10, lr} / POP {r4-r10, lr}; BX LR): on ARMv7-M the
#     8-word push IS the handler's register-save block — the LR slot
#     holds the hardware's EXC_RETURN image from the first instruction
#     on (before any call can clobber LR), the saved registers r4-r10
#     are exactly the body registers the NVIC did NOT auto-save, and
#     the epilogue restores the saved EXC_RETURN into LR and executes
#     `bx lr` — the desc's exit rule. Entry stacks the hardware frame
#     {r0-r3, r12, lr, pc, xpsr} on the current stack (MSP for handler
#     mode — the stack discipline below), so the handler body may
#     clobber r0-r3/r12 freely. IRQ masking is the NVIC's own priority
#     mechanism — handler code neither masks nor unmasks (the
#     Cortex-M0/M0+ ARMv6-M class is Thumb-1: no 32-bit Thumb-2
#     encodings and no byte/halfword exclusives — its word-only
#     LDREX/STREX pair does not serve this route's widths, and no
#     ARMv6-M instance exists in this module yet, so that class has no
#     interrupt slice of its own and stays fail-closed).
#   - the OS entry capture (argc/argv for "main"/"_start", emitted by
#     codegen.tg's emit_save_argc_argv on aarch64) is NOT emitted here:
#     a cortex-m image has no host argc/argv contract; bare-metal
#     executable/image linking is not in this slice (fail-closed), but
#     the @interrupt vector table IS emitted into the .o as the
#     .isr_vector section (see below); functions named main/_start are
#     compiled as ordinary functions unless they carry @interrupt.
#
# ── THE NVIC HANDLER STACK DISCIPLINE (the @interrupt contract) ────
#   A Cortex-M exception entry stacks the 8-word hardware frame
#   {r0-r3, r12, lr, pc, xpsr} (32 bytes) on the CURRENT stack and
#   switches to Handler mode, which always uses the MAIN stack pointer
#   (MSP): an interrupt that preempted Thread mode with PSP runs on
#   MSP automatically — the vector table needs no mode-switch
#   instruction. This slice therefore assumes the MSP is configured as
#   the handler stack (the startup/board code sets the initial MSP —
#   the .isr_vector word 0 placeholder below — sized for the handler
#   frames plus nesting), and it assumes the ARMv7-M aligned-exception
#   stacking configuration (STKALIGN, CCR bit 9, = 1 — the reset
#   default on the Cortex-M3 r2p0+ / M4 / M7 cores of this module),
#   under which the hardware keeps the stack 8-byte aligned across the
#   exception entry, so every AAPCS call the handler body makes sees
#   an 8-aligned SP. On the hard-float instances (cortex-m4f /
#   cortex-m7) the FPU register file is preserved across the exception
#   transparently by the hardware's automatic (lazy) FP-context save
#   under the default FPCCR (ASPEN/LSPEN = 1) — handler code needs no
#   FPU save sequence.
#
# ── THE .isr_vector EMISSION (the @interrupt vector table) ─────────
#   thumb_compile_object emits a REAL .isr_vector section (PROGBITS,
#   SHF_ALLOC — the flash-resident read-only vector image) into the
#   ELF32 ARM object when the program
#   contains @interrupt functions, with the NVIC layout:
#     word 0 — the initial MSP placeholder (0; the startup/board
#              supplies the value — driver.tg's embedded cortex-m
#              linker script defines _stack_top in RAM, which a
#              startup file may relocate here);
#     word 1 — the reset entry: R_ARM_ABS32 to the program's
#              `_reset_handler` when the program defines one, else the
#              zero placeholder (the startup supplies the reset);
#     words 2.. — the @interrupt handler addresses (R_ARM_ABS32 to
#              their function symbols) IN DECLARATION ORDER.
#   An IRQ NUMBER IS NOT EXPRESSIBLE in the @interrupt attribute (the
#   parser rejects every argument form, and numeric attribute
#   arguments are not captured by the attribute dialect), so the
#   declaration-order mapping IS the compiler's documented vector
#   rule: handler k of the program occupies vector word 2+k. A board
#   whose NVIC layout assigns specific IRQn slots must place the
#   exported handler symbols itself (its own .isr_vector, or a
#   startup file that references the symbols). The linker-script
#   contract that consumes this section is driver.tg's embedded
#   cortex-m script (KEEP(*(.isr_vector)) at the flash base). The
#   R_ARM_ABS32 relocations target STT_FUNC Thumb symbols, so the link
#   step resolves each word to the handler's linked address (the ARM
#   ELF interworking rule supplies the Thumb bit for function
#   symbols).
#
# ── ENCODING VERIFICATION (this is a hand-verified slice) ──────────
#   Every encoding constant below was verified byte-for-byte by
#   assembling the instruction with clang -target thumbv7em-none-eabi
#   (LLVM's ARMv7-M assembler) and disassembling the object; the doc
#   comment on each encoder cites the ARMv7-M ARM (DDI0406C) A6/A7
#   instruction family and the observed bytes. Nothing here is
#   guesswork: 16-bit encodings occupy 0x0000-0xE7FF, 32-bit Thumb-2
#   encodings are pairs of halfwords 0xE800-0xFFFF (emitted low
#   halfword first, little-endian).
#
# ── Route wiring ────────────────────────────────────────────────────
#   The driver's LIR route (driver.tg compile_lir_route) selects this
#   backend from the --target triple's TargetDesc — target_desc.tg's ONE
#   lookup target_desc_of_triple (audit item 39): --target
#   thumbv7m-none-eabi -> cortex-m3, thumbv7em-none-eabi -> cortex-m4,
#   thumbv7em-none-eabihf -> cortex-m4f — or from the LEGACY alias keys
#   TANGERINE_LIR_TARGET=cortex-m3/cortex-m4/cortex-m4f/cortex-m7
#   (cortex-m maps to the cortex-m4f descriptor — the least-breaking
#   mapping, since the float route requires the FPU; default aarch64).
#   The desc is handed unmodified to
#   thumb_compile_object, which lowers every body through lir.tg's
#   AAPCS32 parameter-fetch entry (lower_mir_fn_to_lir_cm), emits the
#   program's static scalar images into a .data section and the bodies
#   into a REAL ELF32 relocatable object (e_machine = 40 EM_ARM,
#   EABI5, Thumb code, R_ARM_THM_CALL relocations for extern calls and
#   R_ARM_THM_MOVW_ABS_NC / R_ARM_THM_MOVT_ABS pairs for static-value
#   loads) — the object an arm-none-eabi linker can link. When the
#   program carries @interrupt functions the object additionally
#   contains the .isr_vector vector-table section (R_ARM_ABS32
#   relocations over the handler symbols — the audit §16 NVIC slice;
#   see the INTERRUPT ABI and .isr_vector paragraphs above).
#   Executable/image linking and the bare-metal startup sequence are
#   NOT in this slice (thumb_compile_executable fails closed — the
#   embedded image contract is the driver.tg embedded route's linker
#   script + startup artifacts, consumed by an arm-none-eabi linker).

use std::core::{Option, Result, panic}
use std::collections::{Vec, Set, Map}

use tg_compiler::mir::{MirProgram, MirStatic}
use tg_compiler::lir::{
  LirFunction, LirAlloc, LirStmt, LirStmtKind, LirTermKind, LirValue,
  LirBinOp, LirUnOp, LirCond, LirFpWidth, LirFpBinOp, LirPtrOp,
  LirBitMoveOp,
  lir_fixed_fp_base, lir_is_fixed_fp_id,
  lower_mir_fn_to_lir_cm, lir_peephole, lir_alloc_registers_cm,
  lir_first_alloc_vreg, lir_seg_at, lir_reload_at,
  lir_block_label, lir_validate_callees,
  lir_static_scalar_ok, lir_static_init_word_value,
  lir_static_unsupported_type_rule,
  LirVerifyRoute, verify_lir, lir_verify_fail_err
}
use tg_compiler::target_desc::{
  TargetDesc, InterruptAbi, Arch, FloatAbi, Fpu,
  AtomicSupport, atomic_support,
  target_desc_f64_data_processing,
  thumbv7m_cortex_m3_desc, thumbv7em_cortex_m4_desc,
  thumbv7em_cortex_m4f_desc, thumbv7em_cortex_m7_desc
}
use tg_compiler::codegen::{build_static_label_table}
use tg_compiler::asm::{
  CodeBuffer, buf_new, emit16_le, emit32_le, def_label, buf_pos,
  AsmSymbol, Section, SymBinding, SymKind
}

# ———————————————————————————————————————————————————————————————
# Cortex-M register model (desc-driven)
# ———————————————————————————————————————————————————————————————
# AAPCS32 register numbers: r0-r12 general, r13 = SP, r14 = LR, r15 = PC.
# Fixed (precolored) LIR vreg ids 0..3 ARE r0..r3 (the desc's arg_regs);
# fixed vregs 4..7 (the aarch64 x4..x7) are never produced by the
# cortex-m lowering and rejected here. Ordinary vregs are allocated onto
# the pool ids 9..14, which map 1:1 to six callee-saved registers picked
# from the desc's reg_callee_saved (r7 is excluded: it is the frame
# pointer). r12 is the reserved instruction temp (the AAPCS
# intra-procedure-call scratch IP), r3 is the second temp (dead between
# the entry binds and the call argument moves, so statements may borrow
# it; fixed vregs never hold a live value at a statement boundary).
# The exclusive-access sequences of the atomic slice additionally
# borrow r0/r1/r2 as statement scratches (see the pointer/atomic
# emission section): fixed vregs 0..3 hold live values ONLY in the
# entry parameter binds and in the LirMove argument moves that sit
# directly before a call terminator, so r0-r3 are dead at every
# statement that is not itself one of those moves — the marked atomic
# statements never are.

def thumb_fp_reg() -> Int = 7
def thumb_ip_reg() -> Int = 12
def thumb_ip2_reg() -> Int = 3
def thumb_lr_reg() -> Int = 14
def thumb_sp_reg() -> Int = 13
def thumb_ret_reg() -> Int = 0

# The register list pushed/popped by every prologue/epilogue:
# {r4..r10, lr} = 8 words — even, so SP stays 8-aligned (AAPCS) through
# the frame (entry SP 8-aligned; 32-byte push + 8-aligned frame).
def thumb_saved_reg_list() -> Int = 0x47F0

# The machine register number of an LIR register id: fixed vregs 0..7 are
# r0..r7 (only 0..3 are reachable after thumb_validate_fn — fixed vregs
# 4..7 mark an aarch64-convention LIR and are rejected before emission),
# pool ids 9..14 are mdl_pool entries. Panics for anything else —
# validation rejects fixed vregs 4..7 before emission, so a reachable
# panic is an internal error.
def thumb_phys_of(mdl_pool: Vec[Int], lir_reg: Int) -> Int
  if lir_reg < lir_first_alloc_vreg() then
    return lir_reg
  end
  let idx = lir_reg - lir_first_alloc_vreg()
  if idx >= 0 && idx < mdl_pool.len() then
    mdl_pool[idx]
  else
    panic("thumb: no cortex-m register for lir register " + lir_reg.to_string())
  end
end

# Parse an AAPCS register name ("r0".."r15") into its number.
def thumb_reg_num(name: String) -> Option[Int]
  if name == "r0" then Option::Some(0)
  elsif name == "r1" then Option::Some(1)
  elsif name == "r2" then Option::Some(2)
  elsif name == "r3" then Option::Some(3)
  elsif name == "r4" then Option::Some(4)
  elsif name == "r5" then Option::Some(5)
  elsif name == "r6" then Option::Some(6)
  elsif name == "r7" then Option::Some(7)
  elsif name == "r8" then Option::Some(8)
  elsif name == "r9" then Option::Some(9)
  elsif name == "r10" then Option::Some(10)
  elsif name == "r11" then Option::Some(11)
  elsif name == "r12" then Option::Some(12)
  elsif name == "r13" then Option::Some(13)
  elsif name == "r14" then Option::Some(14)
  elsif name == "r15" then Option::Some(15)
  else Option::None
  end
end

# Resolve a legacy driver route name to the canonical ARMv7-M
# description of this backend (the audit §16 name set; audit item 39
# makes target_desc.tg's target_desc_of_triple the driver's ONE lookup,
# of which these names are the legacy alias keys — this accessor
# remains for backend consumers, mirroring lir_target_desc). The legacy
# name
# "cortex-m" maps to the cortex-m4f descriptor — the least-breaking
# mapping: the pre-slice single cortex_m instance implied the VFP unit
# (the float route requires it), and every program that compiled under
# the old name compiles under cortex-m4f with identical bytes.
def thumb_desc_of(name: String) -> Result[TargetDesc, String]
  if name == "cortex-m3" then
    Result::Ok(thumbv7m_cortex_m3_desc())
  elsif name == "cortex-m4" then
    Result::Ok(thumbv7em_cortex_m4_desc())
  elsif name == "cortex-m4f" || name == "cortex-m" then
    Result::Ok(thumbv7em_cortex_m4f_desc())
  elsif name == "cortex-m7" then
    Result::Ok(thumbv7em_cortex_m7_desc())
  else
    Result::Err("thumb: `" + name + "` is not a cortex-m description of this backend (the ARMv7-M descriptors are \"cortex-m3\", \"cortex-m4\", \"cortex-m4f\" and \"cortex-m7\"; \"cortex-m\" is the legacy alias of \"cortex-m4f\")")
  end
end

# The default cortex-m description of this backend: the legacy
# cortex-m alias target — the cortex-m4f instance (see thumb_desc_of).
def thumb_target_desc() -> TargetDesc
  thumbv7em_cortex_m4f_desc()
end

# AUDIT §16 — the desc-driven FP admission: VFP instructions may be
# emitted only against a descriptor that has an FPU AND the hard-float
# ABI (the float slice's VFP register crossings and d-register forms
# are the AAPCS32 VFP variant). The no-FPU family instances
# (cortex-m3, cortex-m4) are Soft and admit no VFP byte.
def thumb_desc_has_fp(desc: TargetDesc) -> Bool
  desc.fpu != Fpu::None && desc.float_abi == FloatAbi::Hard
end

# Whether a function's allocation carries float content: lir.tg's
# lir_lower_ctx_new registers exactly TWO unconditional FP scratch
# vregs (the F64 and F32 statement scratches) in LirAlloc.fp_widths
# even for a float-free function, so a float-free allocation has
# EXACTLY two rows. Any float local/parameter/return/lowering
# temporary adds its own row (the map is the class table thumb's
# float arms resolve through), so a count above the two-scratch
# baseline means the emitted body can touch the FP register file (an
# FP operand or the d14/d15 statement scratches): the frame must carry
# the VPUSH/VPOP {d8-d15} callee-save block and the no-FPU descriptor
# gate must fire. The comparison is `> 2`, NOT `> 3`: one FP vreg
# beyond the scratch baseline (e.g. a function whose only float value
# is its return local, or a single F32 constant) already emits VFP
# code through the scratches/pool, so the callee-save and the FPU gate
# must engage.
def thumb_alloc_has_fp_content(alloc: LirAlloc) -> Bool
  alloc.fp_widths.len() > 2
end

# The canonical token of a modeled FPU (diagnostics and the F64 gate
# text). Kept in lockstep with target_desc.tg's Fpu enum.
def thumb_fpu_token(f: Fpu) -> String
  match f
  when Fpu::None then "none"
  when Fpu::FPv4SP then "FPv4SP"
  when Fpu::FPv5D16 then "FPv5D16"
  when Fpu::FPv5SP then "FPv5SP"
  when Fpu::AdvSimdA64 then "AdvSimdA64"
  when Fpu::Sse2 then "Sse2"
  when Fpu::RVF then "RVF"
  when Fpu::RVD then "RVD"
  end
end

# The fail-closed rule text for an F64 DATA-PROCESSING statement on a
# descriptor whose FPU has none (target_desc_f64_data_processing false:
# FPv4-SP on the cortex-m4f instance, FPv5-SP on a single-precision
# M7). The F64 load/store/transfer envelope stays legal; arithmetic,
# compares and conversions fail closed HERE with the desc's actual
# values (the gate reads desc.fpu — never a hard-coded CPU name).
def thumb_f64_dp_rule(desc: TargetDesc, fn_name: String, what: String) -> String
  "thumb: " + fn_name + ": " + what + " does not lower against the `" + desc.name + "` description — its FPU (" + thumb_fpu_token(desc.fpu) + ") has NO double-precision data processing (FPv4-SP / FPv5-SP are single-precision units: the double-register support is the load/store/transfer subset only). The F64 load/store envelope (VLDR/VSTR/VPUSH/VPOP, VMOV core<->D, register copies through the stack) stays legal; use the cortex-m7 description (fpu FPv5D16, isa_features \"vfp-dp\") for F64 data processing (fail-closed)"
end

# The emitter-side mirror of thumb_f64_dp_rule: the statement arms are
# defense in depth AFTER thumb_validate_fn (which carries the desc), so
# this variant reports a validation/emission divergence while still
# never emitting the F64 data-processing byte.
def thumb_f64_dp_rule_emit(te: ThumbEmit, what: String) -> String
  "thumb: " + what + " reached the emitter against `" + te.desc_name + "`, whose FPU has no double-precision data processing (target_desc_f64_data_processing false) — validation must have failed it closed; refusing to emit the F64 data-processing form (internal gate divergence; fail-closed)"
end

# Build the register model from the desc — the desc is the single source
# of the ABI data: the model must be exactly the desc's callee-saved
# registers minus the frame pointer, first six, in desc order. Fail
# closed when the desc shape is not what this slice consumes.
def thumb_mdl_pool(desc: TargetDesc) -> Result[Vec[Int], String]
  if desc.arch != Arch::Armv7M then
    return Result::Err("thumb: internal error: the cortex-m backend was given the `" + desc.name + "` description (expected an Armv7M instance — cortex-m3/cortex-m4/cortex-m4f/cortex-m7)")
  end
  if desc.pointer_width != 4 || desc.stack_alignment != 8 then
    return Result::Err("thumb: the cortex-m description must model 4-byte pointers with 8-byte stack alignment (desc says " + desc.pointer_width.to_string() + "-byte, align " + desc.stack_alignment.to_string() + ")")
  end
  var pool: Vec[Int] = Vec::new()
  var i = 0
  while i < desc.reg_callee_saved.len() do
    let r = desc.reg_callee_saved[i]
    if r != "r7" then
      match thumb_reg_num(r)
      when Option::Some(n) then pool.push(n)
      when Option::None then ()
      end
    end
    i = i + 1
  end
  if pool.len() < 6 then
    return Result::Err("thumb: the cortex-m description's reg_callee_saved must provide at least six registers besides r7 for the allocator pool (desc provides " + pool.len().to_string() + ")")
  end
  var out: Vec[Int] = Vec::new()
  var j = 0
  while j < 6 do
    out.push(pool[j])
    j = j + 1
  end
  Result::Ok(out)
end

# ———————————————————————————————————————————————————————————————
# The interrupt (NVIC handler) ABI — audit §16
# ———————————————————————————————————————————————————————————————
# The @interrupt functions of a program (MirFunction.attr_interrupt,
# lowered into LirFunction.attr_interrupt) are compiled under the
# desc's modeled interrupt ABI (TargetDesc.interrupt_abi — the NVIC
# record armv7m_interrupt_abi of target_desc.tg) with this contract:
#   ENTRY — the hardware has already stacked the 8-word exception
#   frame {r0-r3, r12, lr, pc, xpsr} on the current stack (MSP in
#   handler mode) and runs the handler in handler mode with LR holding
#   the EXC_RETURN value. The prologue therefore must NOT re-save the
#   desc's entry_auto_saved registers (r0-r3/r12 — the handler body
#   may clobber them freely; the hardware restores the preempted
#   context's values from the stacked frame on exception return). It
#   MUST save the callee-saved body registers (the desc's
#   reg_callee_saved the allocator can touch: r4-r10) and the
#   EXC_RETURN image in LR — LR is the desc's RESERVED register: any
#   inner call clobbers it, so the handler saves LR (the EXC_RETURN
#   holder) before the first BL and the epilogue restores it before
#   the exit rule's branch.
#   THE HOLDER — the ARMv7-M handler frame needs no dedicated
#   EXC_RETURN register or slot beyond the ordinary AAPCS frame: the
#   prologue's PUSH {r4-r10, lr} places the entry LR (EXC_RETURN)
#   into the push block's LR slot on the very first instruction,
#   before any call exists. The slot is memory — it survives every
#   inner call that clobbers the LR register — and the epilogue's
#   POP {r4-r10, lr} restores it into LR, after which `bx lr`
#   executes the desc's exit rule ("bx lr with lr = exc_return") and
#   the hardware un-stacks the exception frame. This is exactly the
#   ordinary-function frame discipline of this backend, so an
#   interrupt function's prologue/epilogue emit the SAME instruction
#   sequence as an ordinary function's — the interrupt slice
#   validates the shape against the desc, documents the discipline
#   and registers the function in the .isr_vector table.
#   The stack/FPU assumptions (MSP handler stack, STKALIGN = 1, the
#   default FPCCR lazy FP-context save on the hard-float instances)
#   are documented in the module header's NVIC paragraphs.

# The .isr_vector word layout (the NVIC vector table): word 0 is the
# initial MSP value (placeholder), word 1 the reset entry, words 2..
# the @interrupt handlers in declaration order (the documented
# mapping — an IRQ number is not expressible in the attribute).
def thumb_vector_msp_word() -> Int = 0
def thumb_vector_reset_word() -> Int = 1
def thumb_vector_first_handler_word() -> Int = 2

# R_ARM_ABS32 (ELF for the ARM Architecture, ARM IHI 0044F — the
# absolute 32-bit data relocation the .isr_vector words use).
def thumb_reloc_abs32() -> Int = 2

# The record-level ABI gate: this backend compiles @interrupt functions
# only against an interrupt ABI record that models the NVIC convention
# this slice consumes (name "nvic", the "bx lr" exit rule, LR
# reserved, and the entry_auto_saved registers the hardware stacks —
# the prologue's fixed {r4-r10, lr} save block is exactly the
# callee-saved complement of that list). Every field is read as DATA;
# an ABI record that drifts from the consumed shape fails closed here.
def thumb_interrupt_abi_nvic_check(desc_name: String, abi: InterruptAbi) -> Result[Unit, String]
  if abi.name != "nvic" then
    return Result::Err("thumb: the `" + desc_name + "` description models the interrupt ABI `" + abi.name + "`, which this backend does not consume — the cortex-m interrupt slice implements the `nvic` convention (fail-closed)")
  end
  match abi.exit_rule.index_of("bx lr")
  when Option::None then
    return Result::Err("thumb: the `" + desc_name + "` description's interrupt exit rule (`" + abi.exit_rule + "`) is not the `bx lr` rule this slice emits (fail-closed)")
  when Option::Some(_) then ()
  end
  var has_lr_reserved = false
  for r in abi.reserved do
    if r == "lr" then has_lr_reserved = true end
  end
  if !has_lr_reserved then
    return Result::Err("thumb: the `" + desc_name + "` description's interrupt ABI does not reserve lr (reserved: the EXC_RETURN register the handler frame must save before any call — fail-closed)")
  end
  # The hardware-stacked set the prologue must NOT re-save: r0-r3 and
  # r12 (the AAPCS caller-saved core the NVIC frame covers; the
  # handler's push block starts at r4, so a desc whose auto-saved set
  # omits one of them models a different entry convention).
  var wants: Vec[String] = Vec::from(["r0", "r1", "r2", "r3", "r12"])
  var wi = 0
  while wi < wants.len() do
    var found = false
    for e in abi.entry_auto_saved do
      if e == wants[wi] then found = true end
    end
    if !found then
      return Result::Err("thumb: the `" + desc_name + "` description's interrupt ABI does not list `" + wants[wi] + "` in entry_auto_saved — the hardware-stacked set this slice's prologue assumes (fail-closed)")
    end
    wi = wi + 1
  end
  Result::Ok(())
end

# The desc-driven ABI gate: unwrap the desc's modeled interrupt ABI and
# run the record-level NVIC check. A desc with interrupt_abi None models
# no handler convention — @interrupt functions cannot compile against it
# (the handler convention must be modeled data, never silently assumed).
def thumb_interrupt_abi_check(desc: TargetDesc) -> Result[Unit, String]
  match desc.interrupt_abi
  when Option::None then
    Result::Err("thumb: the `" + desc.name + "` description models no interrupt ABI (interrupt_abi: None) but the compile carries @interrupt functions — the handler convention must be modeled data, never silently assumed (the ARMv7-M instances model the NVIC record; fail-closed)")
  when Option::Some(abi) then
    thumb_interrupt_abi_nvic_check(desc.name, abi)
  end
end

# The per-function shape gate (defense in depth — the program-level
# collector validates the same shape before any body lowers): an
# interrupt function enters from the hardware, not from a call site —
# no parameters can be bound (the NVIC frame carries the PREEMPTED
# context's r0-r3, not arguments), and a return value would be dead
# (the hardware un-stacks the preempted context's registers on
# exception return). Unit and never-returning handlers are the legal
# shapes; everything else fails closed with the rule.
def thumb_validate_interrupt_fn(f: LirFunction, desc: TargetDesc) -> Result[Unit, String]
  match thumb_interrupt_abi_check(desc)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  if f.params.len() != 0 then
    return Result::Err("thumb: interrupt function `" + f.name + "` takes " + f.params.len().to_string() + " parameter(s) — an ISR enters from the hardware with the NVIC frame on the stack, never with AAPCS arguments (an @interrupt function must take no parameters; fail-closed)")
  end
  match f.ret_vreg
  when Option::Some(_) then
    return Result::Err("thumb: interrupt function `" + f.name + "` returns a value — an ISR's return is the hardware's exception return, and the preempted context's registers are restored from the NVIC frame (an @interrupt function must return Unit, or never return; fail-closed)")
  when Option::None then ()
  end
  Result::Ok(())
end

# One vector-table record for the object writer: the total word count
# of the .isr_vector section and the (word index, symbol name) pairs
# whose words carry R_ARM_ABS32 relocations (every other word is the
# zero placeholder the startup/board fills).
struct ThumbVectorInfo
  words: Int
  word_syms: Vec[(Int, String)]
end

# Collect the program's @interrupt handlers into the vector-table
# record (Option::None when the program has none — the object writer
# then emits no .isr_vector section and the output is byte-identical
# to the pre-slice layout). Program order IS the declaration order
# the documented mapping rule uses (handler k of the program occupies
# vector word 2+k). The shape gates run HERE — before any function
# body lowers — so a malformed handler fails the whole compile with
# its rule before any partial emission. A generic @interrupt template
# is rejected: an ISR is an ENTRY POINT — it is never instantiated
# from a call site, so a handler carrying declared generic parameters
# can never become a concrete body (fail-closed, never a silent
# omission from the table).
def thumb_program_interrupt_vector(program: MirProgram, desc: TargetDesc) -> Result[Option[ThumbVectorInfo], String]
  var handlers: Vec[String] = Vec::new()
  var has_reset = false
  for f in program.functions do
    if f.name == "_reset_handler" && !f.is_extern then
      has_reset = true
    end
    if f.attr_interrupt then
      if f.is_extern then
        return Result::Err("thumb: the extern declaration `" + f.name + "` carries @interrupt — an ISR must be a defined function of this program (an extern has no body the vector table could enter; fail-closed)")
      end
      if f.is_async then
        return Result::Err("thumb: the async function `" + f.name + "` carries @interrupt — an ISR is a synchronous hardware entry point and cannot be an async coroutine (fail-closed)")
      end
      if f.generic_params.len() > 0 then
        return Result::Err("thumb: the generic function `" + f.name + "` carries @interrupt — an ISR is a hardware entry point and is never instantiated from a call site, so its body can never become concrete (an @interrupt function must not declare generic parameters; fail-closed)")
      end
      if f.params.len() != 0 then
        return Result::Err("thumb: interrupt function `" + f.name + "` takes " + f.params.len().to_string() + " parameter(s) — an ISR enters from the hardware with the NVIC frame on the stack, never with AAPCS arguments (an @interrupt function must take no parameters; fail-closed)")
      end
      handlers.push(f.name.clone())
    end
  end
  if handlers.is_empty() then
    # No @interrupt functions: no vector table (the object stays
    # byte-identical to the pre-slice layout) — and no desc ABI gate
    # (the interrupt-ABI admission only constrains programs that carry
    # handlers).
    return Result::Ok(Option::None)
  end
  # The desc-driven ABI gate runs only for programs that DO carry
  # handlers: this backend emits the .isr_vector table and the handler
  # prologue/epilogue only against a desc whose interrupt_abi models
  # the NVIC convention this slice consumes.
  match thumb_interrupt_abi_check(desc)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var word_syms: Vec[(Int, String)] = Vec::new()
  if has_reset then
    word_syms.push((thumb_vector_reset_word(), "_reset_handler".to_string()))
  end
  var hi = 0
  while hi < handlers.len() do
    word_syms.push((thumb_vector_first_handler_word() + hi, handlers[hi].clone()))
    hi = hi + 1
  end
  Result::Ok(Option::Some(ThumbVectorInfo {
    words: thumb_vector_first_handler_word() + handlers.len(),
    word_syms: word_syms
  }))
end

# The NVIC handler prologue — see the interrupt-ABI section above and
# the module header's NVIC paragraphs. On ARMv7-M the ordinary AAPCS
# frame sequence IS the handler sequence: the PUSH saves the
# callee-saved body registers AND captures the entry LR — the
# hardware's EXC_RETURN image — into the push block's LR slot (the
# holder) before any BL in the body can clobber LR; the frame is then
# built exactly like an ordinary function's. The epilogue (shared
# thumb_emit_epilogue, emitted at every Ret) releases the frame,
# POPs — restoring the holder's EXC_RETURN into LR — and `bx lr`
# executes the desc's exit rule. Entry SP alignment (8) and the MSP
# handler-stack discipline are the startup/board contract documented
# in the module header.
def thumb_emit_interrupt_prologue(inout te: ThumbEmit, frame_bytes: Int, fp_save: Bool) -> Unit
  t2_push_w(&mut te.buf, thumb_saved_reg_list())
  if fp_save then
    t2_vpush_d(&mut te.buf, 8, 8)
  end
  if frame_bytes > 0 then
    if frame_bytes <= 508 then
      t2_sub_sp_imm7(&mut te.buf, frame_bytes)
    else
      t2_movw(&mut te.buf, thumb_ip_reg(), (frame_bytes & 0xFFFF) as u16)
      t2_sub_sp_w_reg(&mut te.buf, thumb_ip_reg())
    end
  end
  t2_mov_rr(&mut te.buf, thumb_fp_reg(), thumb_sp_reg())
end

# ———————————————————————————————————————————————————————————————
# Frame helpers (spill slots are 4-byte words above the frame pointer)
# ———————————————————————————————————————————————————————————————
# Frame layout (see the module header): prologue PUSH {r4-r10, lr}
# (32 bytes), then sub sp, #frame, then r7 = sp. Slot i lives at
# [r7 + 4*i], i in 0..alloc.slots. frame is 8-aligned.

def thumb_slot_offset(slot: Int) -> Int
  4 * slot
end

def thumb_frame_bytes(slots: Int) -> Int
  let raw = slots * 4
  let rem = raw % 8
  if rem != 0 then
    raw + (8 - rem)
  else
    raw
  end
end

# The machine [r7 + ...] offset of an AAPCS stack-parameter payload at
# the LIR-canonical `off` (the LirLoadFrame statement's payload; see
# the emitter arm's derivation): r7 sits below the {r4-r10, lr} push
# (32 bytes), the local frame (`frame_bytes`) and — for an FP-content
# function (te.fp_save) — the VPUSH {d8-d15} callee-save block (64
# bytes), so the payload [fp + off] (fp = incoming SP - 8) translates
# to off + frame_bytes + 24 + (64 when the FP block is present). The
# LirLoadFrame arm and the structural rows both read THIS helper —
# the 64-byte bias can never drift between them.
def thumb_stack_param_off(off: Int, frame_bytes: Int, fp_save: Bool) -> Int
  off + frame_bytes + 24 + (if fp_save then 64 else 0 end)
end

# ———————————————————————————————————————————————————————————————
# Thumb-2 instruction encoders (hand-verified — see the module header)
# ———————————————————————————————————————————————————————————————
# Each encoder writes into the CodeBuffer like the asm.tg a64_* encoders.
# 16-bit instructions are one little-endian halfword; 32-bit Thumb-2
# instructions are two halfwords (first halfword = bits 31..16, emitted
# first). Encoders panic on out-of-range arguments (asm.tg style); the
# emitter validates everything a LIR function can carry BEFORE emission.

# Emit a 32-bit Thumb-2 instruction as its two halfwords.
def t2_word(inout b: CodeBuffer, word: u32) -> Unit
  emit16_le(b, ((word >> 16) & 0xFFFF) as u16)
  emit16_le(b, (word & 0xFFFF) as u16)
end

# MOVS Rd, #imm8 — 16-bit, 00100 Rd imm8 (0x2000). ARMv7-M A6.7.22.
# Verified: movs r0, #42 = 0x202A; movs r3, #5 = 0x2305. WRITES NZCV
# (only reachable inside the cset ITE block; see the flag discipline).
def t2_movs_imm8(inout b: CodeBuffer, rd: Int, imm: Int) -> Unit
  if rd < 0 || rd > 7 then panic("t2_movs_imm8: destination must be r0-r7") end
  if imm < 0 || imm > 255 then panic("t2_movs_imm8: immediate must be 0..255") end
  emit16_le(b, (0x2000 | ((rd as u32) << 8) | (imm as u32)) as u16)
end

# MOV Rd, Rm — 16-bit "MOV (register)" T2, 01000110 D Rm Rd (0x4600),
# flagless, any registers r0-r14 (SP works; PC has special forms that
# this backend never emits). ARMv7-M A6.7.28. Verified: mov r1, r2 =
# 0x4611; mov r8, r0 = 0x4680; mov r0, r8 = 0x4640; mov r12, r3 =
# 0x469C; mov r3, r12 = 0x4663; mov r7, sp = 0x466F; mov sp, r7 = 0x46BD.
def t2_mov_rr(inout b: CodeBuffer, rd: Int, rm: Int) -> Unit
  if rd < 0 || rd > 14 then panic("t2_mov_rr: destination must be r0-r14") end
  if rm < 0 || rm > 14 then panic("t2_mov_rr: source must be r0-r14") end
  emit16_le(b, (0x4600 | ((((rd as u32) >> 3) & 1) << 7) | ((rm as u32) << 3) | ((rd as u32) & 7)) as u16)
end

# ADDS Rd, Rn, Rm — 16-bit ADD (register) T1, 0001100 Rm Rn Rd (0x1800),
# low registers only. ARMv7-M A6.7.5. Verified: adds r0, r1, r2 = 0x1888.
# WRITES NZCV — the LIR emitter never uses this form (invariant I1);
# provided for completeness alongside the flagless 32-bit form below.
def t2_adds_rrr_lo(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 || rm < 0 || rm > 7 then
    panic("t2_adds_rrr_lo: all registers must be r0-r7")
  end
  emit16_le(b, (0x1800 | ((rm as u32) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# SUBS Rd, Rn, Rm — 16-bit SUB (register) T1, 0001101 Rm Rn Rd (0x1A00),
# low registers only. ARMv7-M A6.7.16. Verified: subs r0, r1, r2 = 0x1A88.
# WRITES NZCV — see the invariant-I1 note on t2_adds_rrr_lo.
def t2_subs_rrr_lo(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 || rm < 0 || rm > 7 then
    panic("t2_subs_rrr_lo: all registers must be r0-r7")
  end
  emit16_le(b, (0x1A00 | ((rm as u32) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# ADD Rd, Rm (Rd = Rd + Rm) — 16-bit ADD (register) T2, 01000100 D Rm Rd
# (0x4400), FLAGLESS, any registers. ARMv7-M A6.7.5. Verified:
# add r4, r5 = 0x442C; add r8, r0 = 0x4480; add r0, r8 = 0x4440;
# add r12, r7 = 0x44BC; add r7, r12 = 0x4467; add r4, r12 = 0x4464;
# add r8, r12 = 0x44E0. (SP as Rm is a special form this backend never
# emits.)
def t2_add_rr(inout b: CodeBuffer, rd: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 then panic("t2_add_rr: destination must be r0-r12") end
  if rm < 0 || rm > 12 then panic("t2_add_rr: source must be r0-r12") end
  emit16_le(b, (0x4400 | ((((rd as u32) >> 3) & 1) << 7) | ((rm as u32) << 3) | ((rd as u32) & 7)) as u16)
end

# CMP Rn, Rm — 16-bit low form T1, 0100001010 Rm Rn (0x4280). ARMv7-M
# A6.7.20. Verified: cmp r0, r1 = 0x4288. Both low registers.
def t2_cmp_rr_lo(inout b: CodeBuffer, rn: Int, rm: Int) -> Unit
  if rn < 0 || rn > 7 || rm < 0 || rm > 7 then
    panic("t2_cmp_rr_lo: both registers must be r0-r7")
  end
  emit16_le(b, (0x4280 | ((rm as u32) << 3) | (rn as u32)) as u16)
end

# CMP Rn, Rm — 16-bit ANY-register form T2, 01000101 Rm Rn (0x4500), with
# Rn's bit 3 in bit 7. ARMv7-M A6.7.20. Verified: cmp r0, r8 = 0x4540;
# cmp r8, r0 = 0x4580; cmp r8, r9 = 0x45C8; cmp r3, r12 = 0x4563;
# cmp r12, r3 = 0x459C.
def t2_cmp_rr_any(inout b: CodeBuffer, rn: Int, rm: Int) -> Unit
  if rn < 0 || rn > 14 || rm < 0 || rm > 14 then
    panic("t2_cmp_rr_any: both registers must be r0-r14")
  end
  emit16_le(b, (0x4500 | ((((rn as u32) >> 3) & 1) << 7) | ((rm as u32) << 3) | ((rn as u32) & 7)) as u16)
end

# CMP Rn, #imm8 — 16-bit, 00101 Rn imm8 (0x2800). ARMv7-M A6.7.21.
# Verified: cmp r0, #7 = 0x2807; cmp r3, #5 = 0x2B05; cmp r0, #255 =
# 0x28FF. Low Rn only.
def t2_cmp_imm8(inout b: CodeBuffer, rn: Int, imm: Int) -> Unit
  if rn < 0 || rn > 7 then panic("t2_cmp_imm8: register must be r0-r7") end
  if imm < 0 || imm > 255 then panic("t2_cmp_imm8: immediate must be 0..255") end
  emit16_le(b, (0x2800 | ((rn as u32) << 8) | (imm as u32)) as u16)
end

# LDR Rd, [Rn, #imm5*4] — 16-bit, 01101 imm5 Rn Rd (0x6800). ARMv7-M
# A6.7.40. Verified: ldr r0, [r1, #4] = 0x6848. Low registers only;
# offset = imm5*4, 0..124, word-aligned. Flagless.
def t2_ldr_imm5(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 then
    panic("t2_ldr_imm5: both registers must be r0-r7")
  end
  if off < 0 || off > 124 || (off % 4) != 0 then
    panic("t2_ldr_imm5: offset must be a word-aligned 0..124")
  end
  emit16_le(b, (0x6800 | ((((off / 4) as u32) & 0x1F) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# STR Rd, [Rn, #imm5*4] — 16-bit, 01100 imm5 Rn Rd (0x6000). ARMv7-M
# A6.7.83. Verified: str r0, [r1, #4] = 0x6048. Flagless.
def t2_str_imm5(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 then
    panic("t2_str_imm5: both registers must be r0-r7")
  end
  if off < 0 || off > 124 || (off % 4) != 0 then
    panic("t2_str_imm5: offset must be a word-aligned 0..124")
  end
  emit16_le(b, (0x6000 | ((((off / 4) as u32) & 0x1F) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# STR Rd, [SP, #imm8*4] — 16-bit SP-relative STR, 1001 0 Rd imm8
# (0x9000), imm8*4 in 0..1020, low Rd only. ARMv7-M A6.7.83 (the STR
# (immediate) T2 encoding with the SP base — the 16-bit imm5 form has
# no SP base, so SP-relative word stores use this encoding). Verified:
# str r0, [sp, #0] = 0x9000; str r4, [sp, #8] = 0x9402; str r7,
# [sp, #0x3FC] = 0x97FF. Flagless. Emitted by the LirPushArg arm (the
# AAPCS caller-word push stores at [SP] after the sub sp, #4).
def t2_str_sp_imm8(inout b: CodeBuffer, rd: Int, off: Int) -> Unit
  if rd < 0 || rd > 7 then
    panic("t2_str_sp_imm8: register must be r0-r7")
  end
  if off < 0 || off > 1020 || (off % 4) != 0 then
    panic("t2_str_sp_imm8: offset must be a word-aligned 0..1020")
  end
  emit16_le(b, (0x9000 | ((rd as u32) << 8) | ((off / 4) as u32)) as u16)
end

# LDRB Rd, [Rn, #imm5] — 16-bit, 01111 imm5 Rn Rd (0x7800). ARMv7-M
# A6.7.44. Verified: ldrb r0, [r1, #3] = 0x78C8. (The cortex-m route is
# word-only — sized memory never lowers here — so this form is unused;
# the encoder exists for the sized-field-memory backlog, which is not
# implemented in any LIR route.)
def t2_ldrb_imm5(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 then
    panic("t2_ldrb_imm5: both registers must be r0-r7")
  end
  if off < 0 || off > 31 then panic("t2_ldrb_imm5: offset must be 0..31") end
  emit16_le(b, (0x7800 | ((off as u32) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# STRB Rd, [Rn, #imm5] — 16-bit, 01110 imm5 Rn Rd (0x7000). ARMv7-M
# A6.7.88. Verified: strb r0, [r1, #3] = 0x70C8.
def t2_strb_imm5(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 7 || rn < 0 || rn > 7 then
    panic("t2_strb_imm5: both registers must be r0-r7")
  end
  if off < 0 || off > 31 then panic("t2_strb_imm5: offset must be 0..31") end
  emit16_le(b, (0x7000 | ((off as u32) << 6) | ((rn as u32) << 3) | (rd as u32)) as u16)
end

# B<cond> rel — 16-bit conditional branch, 1101 cond imm8 (0xD000).
# ARMv7-M A6.7.6. Verified: beq +16 = 0xD008; bne = 0xD1xx; bge = 0xDaxx;
# blt = 0xDbxx; bhi = 0xD8xx; bls = 0xD9xx; beq -6 = 0xD0FD. rel is the
# signed byte distance from PC+4 (rel = target - (insn + 4)), even, in
# [-256, 254]. The condition codes are the ARM 4-bit codes (EQ=0, NE=1,
# CS=2, CC=3, HI=8, LS=9, GE=10, LT=11, GT=12, LE=13 — the same space
# aarch64's a64_cc_* values come from). The inverse of a condition is
# cond XOR 1.
def t2_b_cond16(inout b: CodeBuffer, cond: Int, rel: Int) -> Unit
  if cond < 0 || cond > 14 then panic("t2_b_cond16: bad condition code") end
  if rel < -256 || rel > 254 || (rel % 2) != 0 then
    panic("t2_b_cond16: relative offset must be even and in -256..254")
  end
  emit16_le(b, (0xD000 | ((cond as u32) << 8) | (((rel >> 1) as u32) & 0xFF)) as u16)
end

# B rel — 16-bit unconditional branch, 11100 imm11 (0xE000). ARMv7-M
# A6.7.7. Verified: b +18 = 0xE009; b -2 = 0xE7FF. rel = target -
# (insn + 4), even, in [-2048, 2046].
def t2_b16(inout b: CodeBuffer, rel: Int) -> Unit
  if rel < -2048 || rel > 2046 || (rel % 2) != 0 then
    panic("t2_b16: relative offset must be even and in -2048..2046")
  end
  emit16_le(b, (0xE000 | (((rel >> 1) as u32) & 0x7FF)) as u16)
end

# CBZ Rn, rel — 16-bit compare-and-branch-if-zero, 1011 0op i imm5 Rn
# (CBZ = 0xB100, CBNZ = 0xB900). ARMv7-M A6.7.9. Verified: cbz r0, +4 =
# 0xB110; cbz r3, +2 = 0xB10B; cbz r7, +0 = 0xB107; cbnz r1, +2 =
# 0xB909; cbnz r6, +0 = 0xB906. CRITICAL: the ARMv7-M CBZ/CBNZ branch
# FORWARD ONLY, range 0..62 bytes (the assembler rejects a backward
# target) — unlike aarch64's cbz, the LIR emitter cannot fuse zero-test
# switch arms onto it without knowing the branch direction, so the
# emitter compares and branches instead (cbz fusion where the direction
# and range are provable is not implemented — it sits in the peephole
# backlog); the encoders are provided verified for that backlog.
def t2_cbz(inout b: CodeBuffer, rn: Int, rel: Int) -> Unit
  if rn < 0 || rn > 7 then panic("t2_cbz: register must be r0-r7") end
  if rel < 0 || rel > 62 || (rel % 2) != 0 then
    panic("t2_cbz: offset must be a forward even 0..62")
  end
  emit16_le(b, (0xB100 | (((rel >> 1) as u32) << 3) | (rn as u32)) as u16)
end

def t2_cbnz(inout b: CodeBuffer, rn: Int, rel: Int) -> Unit
  if rn < 0 || rn > 7 then panic("t2_cbnz: register must be r0-r7") end
  if rel < 0 || rel > 62 || (rel % 2) != 0 then
    panic("t2_cbnz: offset must be a forward even 0..62")
  end
  emit16_le(b, (0xB900 | (((rel >> 1) as u32) << 3) | (rn as u32)) as u16)
end

# PUSH {regs}, {lr?} — 16-bit, 1011 010 L list (0xB400); regs = an
# r0..r7 bit mask (bit i = r_i), with_lr adds LR via the L bit.
# ARMv7-M A6.7.66. Verified: push {r0, lr} = 0xB501. (The prologue uses
# the 32-bit STMDB form below — the saved list contains r8..r10, which
# the 16-bit form cannot hold.)
def t2_push_16(inout b: CodeBuffer, regs: Int, with_lr: Bool) -> Unit
  if (regs & 0xFF00) != 0 then
    panic("t2_push_16: the 16-bit form holds r0-r7 plus LR only")
  end
  let l = (if with_lr then 0x100 else 0 end) as u32
  emit16_le(b, (0xB400 | ((regs as u32) & 0xFF) | l) as u16)
end

# POP {regs}, {pc?} — 16-bit, 1011 110 P list (0xBC00); regs = an r0..r7
# bit mask, with_pc adds PC via the P bit. ARMv7-M A6.7.67. Verified:
# pop {r7, pc} = 0xBD80.
def t2_pop_16(inout b: CodeBuffer, regs: Int, with_pc: Bool) -> Unit
  if (regs & 0xFF00) != 0 then
    panic("t2_pop_16: the 16-bit form holds r0-r7 plus PC only")
  end
  let p = (if with_pc then 0x100 else 0 end) as u32
  emit16_le(b, (0xBC00 | ((regs as u32) & 0xFF) | p) as u16)
end

# SUB sp, #imm7*4 — 16-bit, 1011 0 0 imm7 (0xB080). ARMv7-M A6.7.16.
# Verified: sub sp, #64 = 0xB090. Flagless. frame 4-aligned, 0..508.
def t2_sub_sp_imm7(inout b: CodeBuffer, frame: Int) -> Unit
  if frame < 0 || frame > 508 || (frame % 4) != 0 then
    panic("t2_sub_sp_imm7: frame must be a 4-aligned 0..508")
  end
  emit16_le(b, (0xB080 | ((frame / 4) as u32)) as u16)
end

# ADD sp, #imm7*4 — 16-bit, 1011 0 1 imm7 (0xB000). ARMv7-M A6.7.4.
# Verified: add sp, #64 = 0xB010.
def t2_add_sp_imm7(inout b: CodeBuffer, frame: Int) -> Unit
  if frame < 0 || frame > 508 || (frame % 4) != 0 then
    panic("t2_add_sp_imm7: frame must be a 4-aligned 0..508")
  end
  emit16_le(b, (0xB000 | ((frame / 4) as u32)) as u16)
end

# BX LR — 16-bit, 010001 11 0 1110 0000 (0x4770). ARMv7-M A6.7.14.
# Verified: bx lr = 0x4770.
def t2_bx_lr(inout b: CodeBuffer) -> Unit
  emit16_le(b, 0x4770)
end

# UDF #0 — 16-bit permanently-undefined, 1101 1110 imm8 (0xDE00).
# ARMv7-M A6.7.77. Verified: udf #0 = 0xDE00. Emitted for LirTrap (the
# aarch64 route's analogue of a64_udf).
def t2_udf(inout b: CodeBuffer) -> Unit
  emit16_le(b, 0xDE00)
end

# ———————————————————————————————————————————
# 32-bit Thumb-2 encodings (halfword pairs 0xE800-0xFFFF)
# ———————————————————————————————————————————

# STMDB sp!, {list} — the 32-bit PUSH (ARMv7-M A7.7.86 STM): word
# 0xE92D0000 | list (P=1 U=0 S=0 W=1 L=0, Rn = sp), list = r0..r12 bit i,
# lr = bit 14. Verified: push {r4-r10, lr} = 0xE92D47F0 (list 0x47F0).
def t2_push_w(inout b: CodeBuffer, list: Int) -> Unit
  if (list & 0xA000) != 0 then
    panic("t2_push_w: register list must be r0-r12 plus lr (bit 14)")
  end
  t2_word(b, 0xE92D0000 | ((list as u32) & 0x5FFF))
end

# LDMIA sp!, {list} — the 32-bit POP (A7.7.56 LDM): word 0xE8BD0000 |
# list (P=0 U=1 S=0 W=1 L=1, Rn = sp). Verified: pop {r4-r10, lr} =
# 0xE8BD47F0.
def t2_pop_w(inout b: CodeBuffer, list: Int) -> Unit
  if (list & 0xA000) != 0 then
    panic("t2_pop_w: register list must be r0-r12 plus lr (bit 14)")
  end
  t2_word(b, 0xE8BD0000 | ((list as u32) & 0x5FFF))
end

# MOVW Rd, #imm16 — 32-bit MOV (immediate) T3 (A7.7.103): hw1 =
# 11110 i 100100 imm4 (0xF240), hw2 = imm3 Rd imm8; imm16 =
# i:imm4:imm3:imm8 (i = bit 11, imm4 = bits 15..12, imm3 = bits 10..8,
# imm8 = bits 7..0 of the 16-bit value). Verified: movw r0, #0xABCD =
# 0xF64A30CD; movw r5, #0x123 = 0xF2401523; movw r1, #0x800 = 0xF6400100;
# movw r12, #0xFFFF = 0xF64F7CFF. FLAGLESS.
def t2_movw(inout b: CodeBuffer, rd: Int, imm: u16) -> Unit
  if rd < 0 || rd > 12 then panic("t2_movw: destination must be r0-r12") end
  let v = imm as u32
  let imm4 = (v >> 12) & 0xF
  let i = (v >> 11) & 1
  let imm3 = (v >> 8) & 7
  let imm8 = v & 0xFF
  t2_word(b, 0xF2400000 | (i << 26) | (imm4 << 16) | (imm3 << 12) | ((rd as u32) << 8) | imm8)
end

# MOVT Rd, #imm16 — 32-bit MOVT T1 (A7.7.104), prefix 0xF2C0, same
# immediate split. Verified: movt r0, #0x1234 = 0xF2C12034; movt r2,
# #0x800 = 0xF6C00200. FLAGLESS.
def t2_movt(inout b: CodeBuffer, rd: Int, imm: u16) -> Unit
  if rd < 0 || rd > 12 then panic("t2_movt: destination must be r0-r12") end
  let v = imm as u32
  let imm4 = (v >> 12) & 0xF
  let i = (v >> 11) & 1
  let imm3 = (v >> 8) & 7
  let imm8 = v & 0xFF
  t2_word(b, 0xF2C00000 | (i << 26) | (imm4 << 16) | (imm3 << 12) | ((rd as u32) << 8) | imm8)
end

# ADDW Rd, Rn, #imm12 — 32-bit ADD (immediate) T3 (A7.7.3): hw1 =
# 11110 i 010000 0 Rn (0xF200), hw2 = imm3 Rd imm8 with imm12 =
# i:imm3:imm8 (i = bit 11). Verified: addw r0, r1, #0x123 = 0xF2011023;
# addw r5, r6, #0x800 = 0xF6060500; addw r9, r10, #0xFF = 0xF20A09FF.
# FLAGLESS.
def t2_addw(inout b: CodeBuffer, rd: Int, rn: Int, imm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_addw: registers must be r0-r12")
  end
  if imm < 0 || imm > 0xFFF then panic("t2_addw: immediate must be 0..4095") end
  let i = ((imm as u32) >> 11) & 1
  let imm3 = ((imm as u32) >> 8) & 7
  let imm8 = (imm as u32) & 0xFF
  t2_word(b, 0xF2000000 | (i << 26) | ((rn as u32) << 16) | (imm3 << 12) | ((rd as u32) << 8) | imm8)
end

# SUBW Rd, Rn, #imm12 — 32-bit SUB (immediate) T3 (A7.7.22), prefix
# 0xF2A0, same field layout. Verified: subw r3, r4, #0x123 = 0xF2A41323;
# subw r8, r9, #0x800 = 0xF6A90800; subw r2, r3, #0x7FF = 0xF2A372FF.
# FLAGLESS.
def t2_subw(inout b: CodeBuffer, rd: Int, rn: Int, imm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_subw: registers must be r0-r12")
  end
  if imm < 0 || imm > 0xFFF then panic("t2_subw: immediate must be 0..4095") end
  let i = ((imm as u32) >> 11) & 1
  let imm3 = ((imm as u32) >> 8) & 7
  let imm8 = (imm as u32) & 0xFF
  t2_word(b, 0xF2A00000 | (i << 26) | ((rn as u32) << 16) | (imm3 << 12) | ((rd as u32) << 8) | imm8)
end

# ADD.W Rd, Rn, Rm — 32-bit ADD (register) T2 (A7.7.4), word
# 0xEB000000 | Rn<<16 | Rd<<8 | Rm. Verified: add.w r0, r1, r2 =
# 0xEB010002; add.w r8, r9, r10 = 0xEB09080A. FLAGLESS (the LIR emitter
# uses ONLY this form for Add — never the flag-writing 16-bit ADDS).
def t2_add_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_add_w: registers must be r0-r12")
  end
  t2_word(b, 0xEB000000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# SUB.W Rd, Rn, Rm — 32-bit SUB (register) T2 (A7.7.23), word
# 0xEBA00000 | Rn<<16 | Rd<<8 | Rm. Verified: sub.w r0, r1, r2 =
# 0xEBA10002; sub.w r7, r7, r12 = 0xEBA7070C. FLAGLESS.
def t2_sub_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_sub_w: registers must be r0-r12")
  end
  t2_word(b, 0xEBA00000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# AND.W Rd, Rn, Rm — 32-bit AND (register) T2 (A7.7.11), word
# 0xEA000000 | Rn<<16 | Rd<<8 | Rm. Verified: and.w r0, r1, r2 =
# 0xEA010002. FLAGLESS.
def t2_and_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_and_w: registers must be r0-r12")
  end
  t2_word(b, 0xEA000000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# ORR.W Rd, Rn, Rm — 32-bit ORR (register) T2 (A7.7.76), word
# 0xEA400000 | Rn<<16 | Rd<<8 | Rm. Verified: orr.w r0, r1, r2 =
# 0xEA410002. FLAGLESS.
def t2_orr_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_orr_w: registers must be r0-r12")
  end
  t2_word(b, 0xEA400000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# EOR.W Rd, Rn, Rm — 32-bit EOR (register) T2 (A7.7.52), word
# 0xEA800000 | Rn<<16 | Rd<<8 | Rm. Verified: eor.w r0, r1, r2 =
# 0xEA810002; eor.w r8, r8, r9 = 0xEA880809. FLAGLESS.
def t2_eor_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_eor_w: registers must be r0-r12")
  end
  t2_word(b, 0xEA800000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# MUL Rd, Rn, Rm — 32-bit MUL T2 (A7.7.130), word 0xFB00F000 | Rn<<16 |
# Rd<<8 | Rm. Verified: mul r0, r1, r2 = 0xFB01F002. FLAGLESS; computes
# the low 32 bits of the product (the word model).
def t2_mul_w(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_mul_w: registers must be r0-r12")
  end
  t2_word(b, 0xFB00F000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# MVN.W Rd, Rm — 32-bit MVN (register) T2 (A7.7.132), word 0xEA6F0000 |
# Rd<<8 | Rm. Verified: mvn.w r0, r1 = 0xEA6F0001; mvn.w r3, r4 =
# 0xEA6F0304; mvn.w r8, r9 = 0xEA6F0809. FLAGLESS (16-bit MVNS writes
# flags; LirBitNot needs the flagless form).
def t2_mvn_w(inout b: CodeBuffer, rd: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rm < 0 || rm > 12 then
    panic("t2_mvn_w: registers must be r0-r12")
  end
  t2_word(b, 0xEA6F0000 | ((rd as u32) << 8) | (rm as u32))
end

# NEG (RSB.W Rd, Rn, #0) — 32-bit RSB (immediate) T2 with imm12 = 0
# (A7.7.166), word 0xF1C00000 | Rn<<16 | Rd<<8. Verified: rsb.w r0, r1,
# #0 = 0xF1C10000; rsb.w r3, r4, #0 = 0xF1C40300; rsb.w r8, r9, #0 =
# 0xF1C90800. FLAGLESS (16-bit RSBS writes flags; LirNeg needs the
# flagless form).
def t2_neg_w(inout b: CodeBuffer, rd: Int, rn: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_neg_w: registers must be r0-r12")
  end
  t2_word(b, 0xF1C00000 | ((rn as u32) << 16) | ((rd as u32) << 8))
end

# LSL.W Rd, Rm, #s — 32-bit LSL (immediate) T2 (A7.7.67): hw1 = 0xEA4F;
# hw2 = imm3 Rd <s&3><type> Rm with imm3 = s>>2 at bits 14..12, (s&3) at
# bits 7..6, type = 0 at bits 5..4, Rm at bits 3..0. Verified across the
# range: lsl.w r0, r1, #1 = 0xEA4F0041, #2 = 0xEA4F0081, #3 = 0xEA4F00C1,
# #10 = 0xEA4F2081, #16 = 0xEA4F4001, #20 = 0xEA4F5001, #24 = 0xEA4F6001,
# #30 = 0xEA4F7081, #31 = 0xEA4F70C1; lsl.w r3, r4, #5 = 0xEA4F1344;
# lsl.w r8, r9, #31 = 0xEA4F78C9. FLAGLESS (16-bit LSLS writes flags).
def t2_lsl_w_imm(inout b: CodeBuffer, rd: Int, rm: Int, s: Int) -> Unit
  if rd < 0 || rd > 12 || rm < 0 || rm > 12 then
    panic("t2_lsl_w_imm: registers must be r0-r12")
  end
  if s < 0 || s > 31 then panic("t2_lsl_w_imm: shift must be 0..31") end
  t2_word(b, 0xEA4F0000 | (((s >> 2) as u32) << 12) | ((rd as u32) << 8) | (((s & 3) as u32) << 6) | (rm as u32))
end

# LSR.W Rd, Rm, #s — same family with type = 01 (A7.7.135). Verified:
# lsr.w r0, r1, #16 = 0xEA4F4011. FLAGLESS.
def t2_lsr_w_imm(inout b: CodeBuffer, rd: Int, rm: Int, s: Int) -> Unit
  if rd < 0 || rd > 12 || rm < 0 || rm > 12 then
    panic("t2_lsr_w_imm: registers must be r0-r12")
  end
  if s < 0 || s > 31 then panic("t2_lsr_w_imm: shift must be 0..31") end
  t2_word(b, 0xEA4F0000 | (((s >> 2) as u32) << 12) | ((rd as u32) << 8) | (((s & 3) as u32) << 6) | 0x10 | (rm as u32))
end

# ASR.W Rd, Rm, #s — same family with type = 10 (A7.7.14). Verified:
# asr.w r0, r1, #16 = 0xEA4F4021. FLAGLESS.
def t2_asr_w_imm(inout b: CodeBuffer, rd: Int, rm: Int, s: Int) -> Unit
  if rd < 0 || rd > 12 || rm < 0 || rm > 12 then
    panic("t2_asr_w_imm: registers must be r0-r12")
  end
  if s < 0 || s > 31 then panic("t2_asr_w_imm: shift must be 0..31") end
  t2_word(b, 0xEA4F0000 | (((s >> 2) as u32) << 12) | ((rd as u32) << 8) | (((s & 3) as u32) << 6) | 0x20 | (rm as u32))
end

# LSL.W Rd, Rn, Rm — 32-bit LSL (register) T2 (A7.7.68), word
# 0xFA00F000 | Rn<<16 | Rd<<8 | Rm (Rn = the value shifted, Rm = count).
# Verified: lsl.w r0, r1, r2 = 0xFA01F002. FLAGLESS. The count is
# Rm[7:0] with saturation (>= 32: LSL/LSR -> 0, ASR -> sign-fill) — the
# 32-bit word model's variable-shift rule.
def t2_lsl_w_reg(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_lsl_w_reg: registers must be r0-r12")
  end
  t2_word(b, 0xFA00F000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# LSR.W Rd, Rn, Rm — 32-bit LSR (register) T2 (A7.7.136), prefix
# 0xFA20F000. Verified: lsr.w r0, r1, r2 = 0xFA21F002. FLAGLESS.
def t2_lsr_w_reg(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_lsr_w_reg: registers must be r0-r12")
  end
  t2_word(b, 0xFA20F000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# ASR.W Rd, Rn, Rm — 32-bit ASR (register) T2 (A7.7.15), prefix
# 0xFA40F000. Verified: asr.w r0, r1, r2 = 0xFA41F002. FLAGLESS.
def t2_asr_w_reg(inout b: CodeBuffer, rd: Int, rn: Int, rm: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 || rm < 0 || rm > 12 then
    panic("t2_asr_w_reg: registers must be r0-r12")
  end
  t2_word(b, 0xFA40F000 | ((rn as u32) << 16) | ((rd as u32) << 8) | (rm as u32))
end

# LDR.W Rd, [Rn, #imm12] — 32-bit LDR (immediate) T2 (A7.7.40), word
# 0xF8D00000 | Rn<<16 | Rd<<12 | imm12 — imm12 is the RAW BYTE offset
# 0..4095 (NOT scaled, unlike the 16-bit imm5*4 form). Verified:
# ldr.w r0, [r1, #400] = 0xF8D10190; ldr.w r8, [r9, #8] = 0xF8D98008;
# ldr.w r3, [r12] = 0xF8DC3000. FLAGLESS.
def t2_ldr_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_ldr_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_ldr_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8D00000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# STR.W Rd, [Rn, #imm12] — 32-bit STR (immediate) T2 (A7.7.83), prefix
# 0xF8C0. Verified: str.w r0, [r1, #400] = 0xF8C10190; str.w r8,
# [r9, #8] = 0xF8C98008; str.w r0, [sp, #0] = 0xF8CD0000; str.w r12,
# [sp, #0] = 0xF8CDC000. Rn may be SP (13) in this encoding — the
# ARMv7-M STR (immediate) T2 base field takes r0-r13 — and the LirPushArg
# arm uses the SP form for high-register (r8-r10) or temp (r12) values
# the 16-bit t2_str_sp_imm8 cannot hold; Rd stays a data register
# (r0-r12). FLAGLESS.
def t2_str_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 13 then
    panic("t2_str_w_imm12: registers must be r0-r12 with an r0-r13 base")
  end
  if off < 0 || off > 4095 then panic("t2_str_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8C00000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# SUB.W SP, SP, Rm — 32-bit SUB (register) T2 with the SP form (Rn =
# Rd = sp, A7.7.23), word 0xEBAD0D00 | Rm. Verified: sub.w sp, sp, r0 =
# 0xEBAD0D00; sub.w sp, sp, r12 = 0xEBAD0D0C. FLAGLESS. The big-frame
# prologue path (frames > 508 bytes).
def t2_sub_sp_w_reg(inout b: CodeBuffer, rm: Int) -> Unit
  if rm < 0 || rm > 12 then panic("t2_sub_sp_w_reg: register must be r0-r12") end
  t2_word(b, 0xEBAD0D00 | (rm as u32))
end

# ADD.W SP, SP, Rm — 32-bit ADD (register) T2 SP form (A7.7.4), word
# 0xEB0D0D00 | Rm. Verified: add.w sp, sp, r0 = 0xEB0D0D00; add.w sp,
# sp, r12 = 0xEB0D0D0C. FLAGLESS. The big-frame epilogue path.
def t2_add_sp_w_reg(inout b: CodeBuffer, rm: Int) -> Unit
  if rm < 0 || rm > 12 then panic("t2_add_sp_w_reg: register must be r0-r12") end
  t2_word(b, 0xEB0D0D00 | (rm as u32))
end

# B.W rel — 32-bit unconditional branch T4 (A7.7.7): hw1 = 11110 S imm10
# (0xF000), hw2 = 10 J1 1 J2 imm11 (0x9000 base); the 24-bit offset
# rel>>1 = S:imm10:I1:I2:imm11 with J1 = NOT(I1 XOR S), J2 = NOT(I2 XOR
# S). Verified: b.w +4 = 0xF000B802; b.w -4 = 0xF7FFBFFE. rel =
# target - (insn + 4), even, within +/-16 MiB.
def t2_b_w(inout b: CodeBuffer, rel: Int) -> Unit
  if rel < -16777216 || rel > 16777214 || (rel % 2) != 0 then
    panic("t2_b_w: relative offset must be even and within +/-16 MiB")
  end
  t2_word(b, t2_branch24_word(rel, 0x9000))
end

# BL rel — 32-bit BL T1 (A7.7.10): hw2 base 0xF800 (11 J1 1 J2 imm11),
# same offset encoding. Verified: bl +2 = 0xF000F801; bl 0 = 0xF000F800;
# bl -20 = 0xF7FFFFF6. The extern-call placeholder (offset 0) is the
# canonical 0xF000 0xF800 pair an R_ARM_THM_CALL relocation patches.
def t2_bl(inout b: CodeBuffer, rel: Int) -> Unit
  if rel < -16777216 || rel > 16777214 || (rel % 2) != 0 then
    panic("t2_bl: relative offset must be even and within +/-16 MiB")
  end
  t2_word(b, t2_branch24_word(rel, 0xF800))
end

# The shared 24-bit branch-word builder (B.W hw2 base 0x9000, BL 0xF800).
def t2_branch24_word(rel: Int, hw2_base: u32) -> u32
  let imm24 = ((rel >> 1) & 0xFFFFFF) as u32
  let s = (imm24 >> 23) & 1
  let imm10 = (imm24 >> 13) & 0x3FF
  let i1 = (imm24 >> 12) & 1
  let i2 = (imm24 >> 11) & 1
  let imm11 = imm24 & 0x7FF
  let j1 = (if (i1 ^ s) == 0 then 1 else 0 end) as u32
  let j2 = (if (i2 ^ s) == 0 then 1 else 0 end) as u32
  0xF0000000 | (s << 26) | (imm10 << 16) | hw2_base | (j1 << 13) | (j2 << 11) | imm11
end

# ITE <cond> — the IT (if-then) block over the next TWO instructions:
# the first executes on cond, the second on NOT cond (A7.7.59 IT, mask
# pattern of the two-instruction then/else form). Verified bytes:
# ite eq = 0xBF0C, ite ne = 0xBF14, ite hs = 0xBF2C, ite hi = 0xBF8C,
# ite ge = 0xBFAC, ite lt = 0xBFB4 — the mask is 0xC for even condition
# codes and 0x4 for odd codes (the else-condition bit interacts with the
# condition LSB in the mask field). Emitted only for LirCset, whose two
# conditional MOVS execute after the Cmp's flags were consumed.
def t2_ite(inout b: CodeBuffer, cond: Int) -> Unit
  if cond < 0 || cond > 13 then panic("t2_ite: bad condition code") end
  let mask = (if (cond & 1) == 0 then 0xC else 0x4 end) as u32
  emit16_le(b, (0xBF00 | ((cond as u32) << 4) | mask) as u16)
end

# ———————————————————————————————————————————————————————————————
# Exclusive-access / width-form encoders (the cortex-m atomic slice)
# ———————————————————————————————————————————————————————————————
# The ARMv7-M (Thumb-2 — the M3/M4/M4F/M7 class) exclusive-access primitives the
# atomic slice emits: LDREX/STREX (word), LDREXB/STREXB (byte) and
# LDREXH/STREXH (halfword) over the address in Rn, plus the width
# load/store forms (the plain atomic load/store/pointer-deref widths)
# and the DMB/CLREX barriers. EVERY WORD below was verified offline by
# assembling the instruction with clang -target thumbv7em-none-eabi
# and disassembling the object with llvm-objdump (the observed bytes
# are cited per encoder). Field layout (from the observed words):
#   LDREX.W: hw1 = 0xE850 | Rn, hw2 = Rt << 12 | 0xF00
#   LDREXB:  hw1 = 0xE8D0 | Rn, hw2 = Rt << 12 | 0xF4F
#   LDREXH:  hw1 = 0xE8D0 | Rn, hw2 = Rt << 12 | 0xF5F
#   STREX.W: hw1 = 0xE840 | Rn, hw2 = Rt << 12 | Rd << 8
#   STREXB:  hw1 = 0xE8C0 | Rn, hw2 = Rt << 12 | 0xF40 | Rd
#   STREXH:  hw1 = 0xE8C0 | Rn, hw2 = Rt << 12 | 0xF50 | Rd
# The emitter keeps the status register (Rd), the data register (Rt)
# and the address register (Rn) pairwise distinct at every STREX, and
# the data/address registers distinct at every LDREX (the AArch32
# constraints the architecture prose attaches to these forms; the
# register plans in the atomic arms below allocate from the
# statement-scratch pool {r0..r3, r12} so distinctness is always
# achievable). Every encoder is FLAGLESS except the CMP/Bcc pairs the
# atomic arms emit explicitly between the exclusives (invariant I1:
# those flags are consumed inside the statement, where no LirCmp
# consumer can be live).

# LDREX Rt, [Rn] — the word exclusive load (A7.7.103 LDREX T1).
# Verified: ldrex r1, [r0] = 0xE850 0x1F00; ldrex r5, [r4] =
# 0xE854 0x5F00; ldrex r8, [r9] = 0xE859 0x8F00.
def t2_ldrex_w(inout b: CodeBuffer, rt: Int, rn: Int) -> Unit
  if rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrex_w: registers must be r0-r12")
  end
  t2_word(b, 0xE8500000 | ((rn as u32) << 16) | ((rt as u32) << 12) | 0xF00)
end

# LDREXB Rt, [Rn] — the byte exclusive load (A7.7.103 LDREXB T1),
# zero-extending. Verified: ldrexb r1, [r0] = 0xE8D0 0x1F4F;
# ldrexb r6, [r4] = 0xE8D4 0x6F4F; ldrexb r7, [r3] = 0xE8D3 0x7F4F.
def t2_ldrexb(inout b: CodeBuffer, rt: Int, rn: Int) -> Unit
  if rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrexb: registers must be r0-r12")
  end
  t2_word(b, 0xE8D00000 | ((rn as u32) << 16) | ((rt as u32) << 12) | 0xF4F)
end

# LDREXH Rt, [Rn] — the halfword exclusive load (A7.7.103 LDREXH T1),
# zero-extending. Verified: ldrexh r1, [r0] = 0xE8D0 0x1F5F;
# ldrexh r6, [r4] = 0xE8D4 0x6F5F; ldrexh r9, [r10] = 0xE8DA 0x9F5F.
def t2_ldrexh(inout b: CodeBuffer, rt: Int, rn: Int) -> Unit
  if rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrexh: registers must be r0-r12")
  end
  t2_word(b, 0xE8D00000 | ((rn as u32) << 16) | ((rt as u32) << 12) | 0xF5F)
end

# STREX Rd, Rt, [Rn] — the word exclusive store (A7.7.163 STREX T1):
# writes [Rn] = Rt when the monitor grants access and returns the
# status 0 (granted) / 1 (denied) in Rd. Verified: strex r1, r2,
# [r0] = 0xE840 0x2100; strex r6, r2, [r4] = 0xE844 0x2600;
# strex r3, r7, [r9] = 0xE849 0x7300.
def t2_strex_w(inout b: CodeBuffer, rd: Int, rt: Int, rn: Int) -> Unit
  if rd < 0 || rd > 12 || rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_strex_w: registers must be r0-r12")
  end
  t2_word(b, 0xE8400000 | ((rn as u32) << 16) | ((rt as u32) << 12) | ((rd as u32) << 8))
end

# STREXB Rd, Rt, [Rn] — the byte exclusive store (A7.7.163 STREXB T1).
# Verified: strexb r1, r2, [r0] = 0xE8C0 0x2F41; strexb r5, r8, [r3] =
# 0xE8C3 0x8F45.
def t2_strexb(inout b: CodeBuffer, rd: Int, rt: Int, rn: Int) -> Unit
  if rd < 0 || rd > 12 || rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_strexb: registers must be r0-r12")
  end
  t2_word(b, 0xE8C00000 | ((rn as u32) << 16) | ((rt as u32) << 12) | 0xF40 | (rd as u32))
end

# STREXH Rd, Rt, [Rn] — the halfword exclusive store (A7.7.163 STREXH
# T1). Verified: strexh r3, r2, [r0] = 0xE8C0 0x2F53; strexh r8, r5,
# [r7] = 0xE8C7 0x5F58.
def t2_strexh(inout b: CodeBuffer, rd: Int, rt: Int, rn: Int) -> Unit
  if rd < 0 || rd > 12 || rt < 0 || rt > 12 || rn < 0 || rn > 12 then
    panic("t2_strexh: registers must be r0-r12")
  end
  t2_word(b, 0xE8C00000 | ((rn as u32) << 16) | ((rt as u32) << 12) | 0xF50 | (rd as u32))
end

# The LDREX/STREX width dispatch of the atomic arms: the exclusive
# load/store pair at storage width 1/2/4 bytes. The arm's code keeps
# the exclusive load and store at the SAME width (the monitor
# granularity must match between the two).
def t2_ldrex_wd(inout b: CodeBuffer, w: Int, rt: Int, rn: Int) -> Unit
  match w
  when 1 then t2_ldrexb(b, rt, rn)
  when 2 then t2_ldrexh(b, rt, rn)
  when 4 then t2_ldrex_w(b, rt, rn)
  when _ then panic("t2_ldrex_wd: width must be 1/2/4")
  end
end

def t2_strex_wd(inout b: CodeBuffer, w: Int, rd: Int, rt: Int, rn: Int) -> Unit
  match w
  when 1 then t2_strexb(b, rd, rt, rn)
  when 2 then t2_strexh(b, rd, rt, rn)
  when 4 then t2_strex_w(b, rd, rt, rn)
  when _ then panic("t2_strex_wd: width must be 1/2/4")
  end
end

# LDRB.W Rt, [Rn, #imm12] — the zero-extending byte load (A7.7.105
# LDRB (immediate) T2), imm12 in 0..4095, ANY r0-r12 base (the 16-bit
# LDRB form is low-register-only; the atomic/pointer arms may base off
# r8-r12). Verified: ldrb.w r1, [r2, #0] = 0xF892 0x1000; ldrb.w r6,
# [r7, #255] = 0xF897 0x60FF. FLAGLESS.
def t2_ldrb_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrb_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_ldrb_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8900000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# LDRH.W Rt, [Rn, #imm12] — the zero-extending halfword load
# (A7.7.113 LDRH (immediate) T2). Verified: ldrh.w r1, [r2, #0] =
# 0xF8B2 0x1000; ldrh.w r6, [r7, #2] = 0xF8B7 0x6002. FLAGLESS.
def t2_ldrh_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrh_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_ldrh_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8B00000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# STRB.W Rt, [Rn, #imm12] — the byte store (A7.7.183 STRB (immediate)
# T2). Verified: strb.w r1, [r2, #0] = 0xF882 0x1000; strb.w r6,
# [r7, #255] = 0xF887 0x60FF. FLAGLESS.
def t2_strb_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_strb_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_strb_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8800000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# STRH.W Rt, [Rn, #imm12] — the halfword store (A7.7.186 STRH
# (immediate) T2). Verified: strh.w r1, [r2, #0] = 0xF8A2 0x1000;
# strh.w r6, [r7, #2] = 0xF8A7 0x6002. FLAGLESS.
def t2_strh_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_strh_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_strh_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF8A00000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# LDRSB.W Rt, [Rn, #imm12] — the sign-extending byte load (A7.7.111
# LDRSB (immediate) T2). Verified: ldrsb.w r1, [r2, #0] = 0xF992
# 0x1000; ldrsb.w r6, [r7, #255] = 0xF997 0x60FF. FLAGLESS.
def t2_ldrsb_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrsb_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_ldrsb_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF9900000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# LDRSH.W Rt, [Rn, #imm12] — the sign-extending halfword load
# (A7.7.119 LDRSH (immediate) T2). Verified: ldrsh.w r1, [r2, #0] =
# 0xF9B2 0x1000; ldrsh.w r6, [r7, #2] = 0xF9B7 0x6002. FLAGLESS.
def t2_ldrsh_w_imm12(inout b: CodeBuffer, rd: Int, rn: Int, off: Int) -> Unit
  if rd < 0 || rd > 12 || rn < 0 || rn > 12 then
    panic("t2_ldrsh_w_imm12: registers must be r0-r12")
  end
  if off < 0 || off > 4095 then panic("t2_ldrsh_w_imm12: offset must be 0..4095") end
  t2_word(b, 0xF9B00000 | ((rn as u32) << 16) | ((rd as u32) << 12) | (off as u32))
end

# The width load dispatch of the atomic/pointer arms (a zero-extending
# load of 1/2/4 bytes — the atomic data widths are unsigned); `sign`
# selects the sign-extending byte/halfword form (never at width 4).
def t2_ldr_wd(inout b: CodeBuffer, w: Int, sign: Bool, rd: Int, rn: Int, off: Int) -> Unit
  match w
  when 1 then
    if sign then t2_ldrsb_w_imm12(b, rd, rn, off) else t2_ldrb_w_imm12(b, rd, rn, off) end
  when 2 then
    if sign then t2_ldrsh_w_imm12(b, rd, rn, off) else t2_ldrh_w_imm12(b, rd, rn, off) end
  when 4 then t2_ldr_w_imm12(b, rd, rn, off)
  when _ then panic("t2_ldr_wd: width must be 1/2/4")
  end
end

# The width store dispatch of the atomic/pointer arms (the value's low
# 1/2/4 bytes).
def t2_str_wd(inout b: CodeBuffer, w: Int, rd: Int, rn: Int, off: Int) -> Unit
  match w
  when 1 then t2_strb_w_imm12(b, rd, rn, off)
  when 2 then t2_strh_w_imm12(b, rd, rn, off)
  when 4 then t2_str_w_imm12(b, rd, rn, off)
  when _ then panic("t2_str_wd: width must be 1/2/4")
  end
end

# DMB — the data memory barrier, SY option (A7.7.41 DMB; Thumb-2 word
# 0xF3BF 0x8F5F). Verified: dmb sy = 0xF3BF 0x8F5F. ARMv7-M (the
# ARMv7-M family) is a single-core profile with no shareability domains to
# distinguish: the SY (full system) barrier is the architecturally
# clean form for every ordering need on this route (the aarch64
# route's ISHLD/ISH option split has no domain meaning here; the
# observed ecosystem emission for ARMv7-M atomics — clang's
# __atomic_* sequences for thumbv7em — is `dmb sy` on every ordering
# boundary, verified offline). FLAGLESS.
def t2_dmb_sy(inout b: CodeBuffer) -> Unit
  t2_word(b, 0xF3BF8F5F)
end

# CLREX — clear the local exclusive monitor (A7.7.39 CLREX; Thumb-2
# word 0xF3BF 0x8F2F). Verified: clrex = 0xF3BF 0x8F2F. The CAS arms
# emit it on the compare-mismatch exit (the failed compare leaves the
# monitor armed; clang's ARMv7-M CAS sequences clear it there too —
# verified offline). FLAGLESS.
def t2_clrex(inout b: CodeBuffer) -> Unit
  t2_word(b, 0xF3BF8F2F)
end


# ———————————————————————————————————————————
# VFP (coprocessor 10/11) encodings — ARMv7-M A7.8 VFP
# ———————————————————————————————————————————
# Every VFP instruction is a 32-bit Thumb-2 instruction whose encoding is
# the classic A32 VFP word with cond = 1110 (first halfword 0xE8xx-0xEFxx,
# in this backend's region), emitted as its two halfwords by t2_word —
# exactly like the 32-bit forms above. VERIFIED with an offline
# assembler/disassembler (verification aid: clang -target
# armv7-none-eabi -mcpu=cortex-a8 + llvm-objdump, ARM and Thumb-2 state —
# the Thumb-2 disassembly echoes the A32 word split into the two
# halfwords t2_word emits, first halfword = bits 31..16): each Verified
# encoding below is the disassembler echo of the assembled instruction.
# The VFP register fields split each 5-bit register number between a
# 4-bit field and one extension bit (Vd's at insn bit 22, Vn's at insn
# bit 7, Vm's at insn bit 5). The two operand types place the number
# differently (verified: vadd.f64 d16,d0,d0 = 0xEE700B00 but vadd.f32
# s16,s0,s0 = 0xEE308A00):
#   - DOUBLE d0-d31 (Dd/Dn/Dm): field = n & 15, extension = n >> 4.
#     vadd.f64 d17,d18,d19 = 0xEE721BA3 (Vd 1 + D, Vn 2 + N, Vm 3 + M).
#   - SINGLE s0-s31 (Sd/Sn/Sm): the register sits in its double-pair
#     slot: field = n >> 1, extension = parity n & 1.
#     vadd.f32 s17,s18,s19 = 0xEE798A29 (Vd 8 + D, Vn 9, Vm 9 + M);
#     vadd.f32 s0,s1,s2 = 0xEE300A81 (only Vn's parity bit 7 is set).
# Mixed VCVT forms encode the single operand in the same double-slot
# way (vcvt.f64.s32 d17,s17 = 0xEEF81BE8: Vm field 8 + M = s17).
# FLAG note: VFP data processing never touches the core APSR NZCV
# (invariant I1 is untouched); VCMP sets the FPSCR flags, which reach
# APSR only through the VMRS APSR_nzcv encoder below.

# VADD.F64 Dd, Dn, Dm — 32-bit VFP 3-register data processing (A7.8),
# word 0xEE300B00 | (Dn&15)<<16 | (Dd&15)<<12 | (Dm&15) | (Dd>>4)<<22 |
# (Dn>>4)<<7 | (Dm>>4)<<5. Verified: vadd.f64 d0, d0, d0 = 0xEE300B00;
# vadd.f64 d13, d7, d5 = 0xEE37DB05; vadd.f64 d16, d0, d0 = 0xEE700B00;
# vadd.f64 d17, d18, d19 = 0xEE721BA3; vadd.f64 d31, d30, d29 =
# 0xEE7EFBAD.
def t2_vadd_f64(inout b: CodeBuffer, dd: Int, dn: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vadd_f64: destination must be d0-d31") end
  if dn < 0 || dn > 31 then panic("t2_vadd_f64: first source must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vadd_f64: second source must be d0-d31") end
  t2_word(b, 0xEE300B00 | (((dn as u32) & 15) << 16) | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dn as u32) >> 4) & 1) << 7 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VSUB.F64 Dd, Dn, Dm — word 0xEE300B40 | same fields as t2_vadd_f64.
# Verified: vsub.f64 d0, d0, d0 = 0xEE300B40; vsub.f64 d17, d18, d19 =
# 0xEE721BE3; vsub.f64 d0, d0, d16 = 0xEE300B60.
def t2_vsub_f64(inout b: CodeBuffer, dd: Int, dn: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vsub_f64: destination must be d0-d31") end
  if dn < 0 || dn > 31 then panic("t2_vsub_f64: first source must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vsub_f64: second source must be d0-d31") end
  t2_word(b, 0xEE300B40 | (((dn as u32) & 15) << 16) | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dn as u32) >> 4) & 1) << 7 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VMUL.F64 Dd, Dn, Dm — word 0xEE200B00 | same fields. Verified:
# vmul.f64 d0, d0, d0 = 0xEE200B00; vmul.f64 d17, d18, d19 = 0xEE621BA3.
def t2_vmul_f64(inout b: CodeBuffer, dd: Int, dn: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vmul_f64: destination must be d0-d31") end
  if dn < 0 || dn > 31 then panic("t2_vmul_f64: first source must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vmul_f64: second source must be d0-d31") end
  t2_word(b, 0xEE200B00 | (((dn as u32) & 15) << 16) | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dn as u32) >> 4) & 1) << 7 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VDIV.F64 Dd, Dn, Dm — word 0xEE800B00 | same fields. Verified:
# vdiv.f64 d0, d0, d0 = 0xEE800B00; vdiv.f64 d17, d18, d19 = 0xEEC21BA3.
def t2_vdiv_f64(inout b: CodeBuffer, dd: Int, dn: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vdiv_f64: destination must be d0-d31") end
  if dn < 0 || dn > 31 then panic("t2_vdiv_f64: first source must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vdiv_f64: second source must be d0-d31") end
  t2_word(b, 0xEE800B00 | (((dn as u32) & 15) << 16) | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dn as u32) >> 4) & 1) << 7 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VADD.F32 Sd, Sn, Sm — 32-bit VFP 3-register data processing, single
# form (sz = 0: [11:8] = 1010), word 0xEE300A00 | (Sn>>1)<<16 |
# (Sd>>1)<<12 | (Sm>>1) | (Sd&1)<<22 | (Sn&1)<<7 | (Sm&1)<<5 (the
# double-slot encoding, see the banner). Verified: vadd.f32 s0, s0, s0 =
# 0xEE300A00; vadd.f32 s0, s1, s2 = 0xEE300A81; vadd.f32 s13, s7, s5 =
# 0xEE736AA2; vadd.f32 s16, s0, s0 = 0xEE308A00; vadd.f32 s17, s18, s19
# = 0xEE798A29; vadd.f32 s31, s30, s29 = 0xEE7FFA2E.
def t2_vadd_f32(inout b: CodeBuffer, sd: Int, sn: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vadd_f32: destination must be s0-s31") end
  if sn < 0 || sn > 31 then panic("t2_vadd_f32: first source must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vadd_f32: second source must be s0-s31") end
  t2_word(b, 0xEE300A00 | (((sn as u32) >> 1) << 16) | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sn as u32) & 1) << 7) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VSUB.F32 Sd, Sn, Sm — word 0xEE300A40 | same fields as t2_vadd_f32.
# Verified: vsub.f32 s0, s0, s0 = 0xEE300A40; vsub.f32 s17, s18, s19 =
# 0xEE798A69.
def t2_vsub_f32(inout b: CodeBuffer, sd: Int, sn: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vsub_f32: destination must be s0-s31") end
  if sn < 0 || sn > 31 then panic("t2_vsub_f32: first source must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vsub_f32: second source must be s0-s31") end
  t2_word(b, 0xEE300A40 | (((sn as u32) >> 1) << 16) | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sn as u32) & 1) << 7) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VMUL.F32 Sd, Sn, Sm — word 0xEE200A00 | same fields. Verified:
# vmul.f32 s0, s0, s0 = 0xEE200A00; vmul.f32 s17, s18, s19 = 0xEE698A29.
def t2_vmul_f32(inout b: CodeBuffer, sd: Int, sn: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vmul_f32: destination must be s0-s31") end
  if sn < 0 || sn > 31 then panic("t2_vmul_f32: first source must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vmul_f32: second source must be s0-s31") end
  t2_word(b, 0xEE200A00 | (((sn as u32) >> 1) << 16) | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sn as u32) & 1) << 7) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VDIV.F32 Sd, Sn, Sm — word 0xEE800A00 | same fields. Verified:
# vdiv.f32 s0, s0, s0 = 0xEE800A00; vdiv.f32 s17, s18, s19 = 0xEEC98A29.
def t2_vdiv_f32(inout b: CodeBuffer, sd: Int, sn: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vdiv_f32: destination must be s0-s31") end
  if sn < 0 || sn > 31 then panic("t2_vdiv_f32: first source must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vdiv_f32: second source must be s0-s31") end
  t2_word(b, 0xEE800A00 | (((sn as u32) >> 1) << 16) | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sn as u32) & 1) << 7) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VNEG.F64 Dd, Dm — 32-bit VFP 2-register (monadic) data processing,
# word 0xEEB10B40 | (Dd&15)<<12 | (Dm&15) | (Dd>>4)<<22 | (Dm>>4)<<5
# (the [19:16] field holds the opcode 0001, not a register).
# Verified: vneg.f64 d0, d0 = 0xEEB10B40; vneg.f64 d17, d18 = 0xEEF11B62;
# vneg.f64 d0, d17 = 0xEEB10B61; vneg.f64 d8, d9 = 0xEEB18B49.
def t2_vneg_f64(inout b: CodeBuffer, dd: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vneg_f64: destination must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vneg_f64: source must be d0-d31") end
  t2_word(b, 0xEEB10B40 | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VABS.F64 Dd, Dm — monadic, word 0xEEB00BC0 | same fields as
# t2_vneg_f64 (opcode [19:16] = 0000, [7:4] = 1100). Verified:
# vabs.f64 d0, d0 = 0xEEB00BC0; vabs.f64 d17, d18 = 0xEEF01BE2;
# vabs.f64 d0, d17 = 0xEEB00BE1.
def t2_vabs_f64(inout b: CodeBuffer, dd: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vabs_f64: destination must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vabs_f64: source must be d0-d31") end
  t2_word(b, 0xEEB00BC0 | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VMOV.F64 Dd, Dm (VMOV between two VFP double registers; the ARMv7
# register-move form) — monadic, word 0xEEB00B40 | same fields as
# t2_vneg_f64 (opcode [19:16] = 0000, [7:4] = 0100). Verified: vmov.f64
# d0, d0 = 0xEEB00B40; vmov.f64 d0, d1 = 0xEEB00B41; vmov.f64 d17, d9 =
# 0xEEF01B49; vmov.f64 d0, d17 = 0xEEB00B61.
def t2_vmov_f64(inout b: CodeBuffer, dd: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vmov_f64: destination must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vmov_f64: source must be d0-d31") end
  t2_word(b, 0xEEB00B40 | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VMOV.F32 Sd, Sm (VMOV between two VFP single registers) — monadic
# single form, word 0xEEB00A40 | (Sd>>1)<<12 | (Sm>>1) | (Sd&1)<<22 |
# (Sm&1)<<5 (double-slot encoding). Verified: vmov.f32 s0, s0 =
# 0xEEB00A40; vmov.f32 s0, s1 = 0xEEB00A60; vmov.f32 s17, s18 =
# 0xEEF08A49; vmov.f32 s8, s15 = 0xEEB04A67.
def t2_vmov_f32(inout b: CodeBuffer, sd: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vmov_f32: destination must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vmov_f32: source must be s0-s31") end
  t2_word(b, 0xEEB00A40 | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VPUSH {Dfirst, ..., Dfirst+count-1} — the VSTMDB SP! (decrement
# before, writeback) form with the double register list, word
# 0xED2D0B00 | (Dfirst&15)<<12 | (Dfirst>>4)<<22 | 2*count: the
# encoding's low byte counts SINGLE-precision registers (a double
# occupies two), so a count of `count` doubles encodes 2*count. This is
# the M-profile FP callee-save push (the FP mirror of PUSH {r4-r10,
# lr}) AND the 64-bit register-copy primitive for FPv4-SP, whose
# instruction set has NO VMOV.F64 Dd, Dm (a 64-bit copy rides the
# stack: vpush the source, vpop the destination). Verified against the
# fpv4-sp-d16 assembler: vpush {d0} = 0xED2D0B02; vpush {d8} =
# 0xED2D8B02; vpush {d8-d15} = 0xED2D8B10; vpush {d15} = 0xED2DFB02;
# vpush {d0-d7} = 0xED2D0B10 (bytes 2d ed 10 0b). FLAGLESS; SP moves by
# 8*count (always a multiple of 8, so the AAPCS frame alignment holds
# at every statement boundary and around the prologue save block).
def t2_vpush_d(inout b: CodeBuffer, first: Int, count: Int) -> Unit
  if first < 0 || first > 31 then panic("t2_vpush_d: first register must be d0-d31") end
  if count < 1 || count > 16 || first + count > 32 then panic("t2_vpush_d: register count must be 1..16 and stay in d0-d31") end
  t2_word(b, 0xED2D0B00 | (((first as u32) & 15) << 12) | ((((first as u32) >> 4) & 1) << 22) | ((2 * count) as u32))
end

# VPOP {Dfirst, ..., Dfirst+count-1} — the VLDMIA SP! (increment after,
# writeback) double-list form, word 0xECBD0B00 | (Dfirst&15)<<12 |
# (Dfirst>>4)<<22 | 2*count (the VLDMIA counterpart of t2_vpush_d; the
# same single-count low byte). Pops exactly the words a matching
# t2_vpush_d(first, count) pushed. Verified: vpop {d0} = 0xECBD0B02;
# vpop {d1} = 0xECBD1B02; vpop {d8} = 0xECBD8B02; vpop {d8-d15} =
# 0xECBD8B10; vpop {d3-d5} = 0xECBD3B06 (bytes bd ec 06 3b). FLAGLESS.
def t2_vpop_d(inout b: CodeBuffer, first: Int, count: Int) -> Unit
  if first < 0 || first > 31 then panic("t2_vpop_d: first register must be d0-d31") end
  if count < 1 || count > 16 || first + count > 32 then panic("t2_vpop_d: register count must be 1..16 and stay in d0-d31") end
  t2_word(b, 0xECBD0B00 | (((first as u32) & 15) << 12) | ((((first as u32) >> 4) & 1) << 22) | ((2 * count) as u32))
end

# VCMP.F64 Dd, Dm — monadic compare, word 0xEEB40B40 | same fields as
# t2_vneg_f64 (opcode [19:16] = 0100, [7:4] = 0100). Sets the FPSCR
# comparison flags (they reach APSR only via t2_vmrs_apsr_nzcv).
# Verified: vcmp.f64 d0, d0 = 0xEEB40B40; vcmp.f64 d17, d18 =
# 0xEEF41B62.
def t2_vcmp_f64(inout b: CodeBuffer, dd: Int, dm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vcmp_f64: destination must be d0-d31") end
  if dm < 0 || dm > 31 then panic("t2_vcmp_f64: source must be d0-d31") end
  t2_word(b, 0xEEB40B40 | (((dd as u32) & 15) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((dd as u32) >> 4) & 1) << 22 | ((dm as u32) & 15))
end

# VCMP.F64 Dd, #0.0 — monadic compare against +0.0 (the ARM
# "VCMP Dd, #0.0" form), word 0xEEB50B40 | (Dd&15)<<12 | (Dd>>4)<<22
# (opcode [19:16] = 0101 — no Vm register field). Verified:
# vcmp.f64 d0, #0.0 = 0xEEB50B40; vcmp.f64 d17, #0.0 = 0xEEF51B40.
def t2_vcmp_f64_zero(inout b: CodeBuffer, dd: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vcmp_f64_zero: register must be d0-d31") end
  t2_word(b, 0xEEB50B40 | (((dd as u32) & 15) << 12) | (((dd as u32) >> 4) & 1) << 22)
end

# VCVT.F64.S32 Dd, Sm (s32 -> f64) — 32-bit VFP conversion, word
# 0xEEB80BC0 | (Dd&15)<<12 | (Sm>>1) | (Dd>>4)<<22 | (Sm&1)<<5: the
# single source sits in the double Vm slot (banner). Verified:
# vcvt.f64.s32 d0, s0 = 0xEEB80BC0; vcvt.f64.s32 d17, s9 = 0xEEF81BE4;
# vcvt.f64.s32 d17, s17 = 0xEEF81BE8.
def t2_vcvt_f64_s32(inout b: CodeBuffer, dd: Int, sm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vcvt_f64_s32: destination must be d0-d31") end
  if sm < 0 || sm > 31 then panic("t2_vcvt_f64_s32: source must be s0-s31") end
  t2_word(b, 0xEEB80BC0 | (((dd as u32) & 15) << 12) | ((sm as u32) >> 1) | (((dd as u32) >> 4) & 1) << 22 | (((sm as u32) & 1) << 5))
end

# VCVT.S32.F64 Sd, Dm (f64 -> s32) — word 0xEEBD0BC0 | (Sd>>1)<<12 |
# (Dm&15) | (Sd&1)<<22 | (Dm>>4)<<5: the single destination sits in the
# double Vd slot. Verified: vcvt.s32.f64 s0, d0 = 0xEEBD0BC0;
# vcvt.s32.f64 s17, d9 = 0xEEFD8BC9; vcvt.s32.f64 s9, d17 = 0xEEFD4BE1.
def t2_vcvt_s32_f64(inout b: CodeBuffer, sd: Int, dm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vcvt_s32_f64: destination must be s0-s31") end
  if dm < 0 || dm > 31 then panic("t2_vcvt_s32_f64: source must be d0-d31") end
  t2_word(b, 0xEEBD0BC0 | (((sd as u32) >> 1) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((sd as u32) & 1) << 22) | ((dm as u32) & 15))
end

# VCVT.F64.U32 Dd, Sm (u32 -> f64) — word 0xEEB80B40 | same fields as
# t2_vcvt_f64_s32. Verified: vcvt.f64.u32 d0, s0 = 0xEEB80B40;
# vcvt.f64.u32 d17, s17 = 0xEEF81B68.
def t2_vcvt_f64_u32(inout b: CodeBuffer, dd: Int, sm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vcvt_f64_u32: destination must be d0-d31") end
  if sm < 0 || sm > 31 then panic("t2_vcvt_f64_u32: source must be s0-s31") end
  t2_word(b, 0xEEB80B40 | (((dd as u32) & 15) << 12) | ((sm as u32) >> 1) | (((dd as u32) >> 4) & 1) << 22 | (((sm as u32) & 1) << 5))
end

# VCVT.U32.F64 Sd, Dm (f64 -> u32) — word 0xEEBC0BC0 | same fields as
# t2_vcvt_s32_f64. Verified: vcvt.u32.f64 s0, d0 = 0xEEBC0BC0;
# vcvt.u32.f64 s17, d9 = 0xEEFC8BC9.
def t2_vcvt_u32_f64(inout b: CodeBuffer, sd: Int, dm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vcvt_u32_f64: destination must be s0-s31") end
  if dm < 0 || dm > 31 then panic("t2_vcvt_u32_f64: source must be d0-d31") end
  t2_word(b, 0xEEBC0BC0 | (((sd as u32) >> 1) << 12) | (((dm as u32) >> 4) & 1) << 5 | (((sd as u32) & 1) << 22) | ((dm as u32) & 15))
end

# VCVT.F64.F32 Dd, Sm (f32 -> f64) — word 0xEEB70AC0 | same fields as
# t2_vcvt_f64_s32. Verified: vcvt.f64.f32 d0, s0 = 0xEEB70AC0;
# vcvt.f64.f32 d17, s9 = 0xEEF71AE4; vcvt.f64.f32 d9, s17 = 0xEEB79AE8.
def t2_vcvt_f64_f32(inout b: CodeBuffer, dd: Int, sm: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vcvt_f64_f32: destination must be d0-d31") end
  if sm < 0 || sm > 31 then panic("t2_vcvt_f64_f32: source must be s0-s31") end
  t2_word(b, 0xEEB70AC0 | (((dd as u32) & 15) << 12) | ((sm as u32) >> 1) | (((dd as u32) >> 4) & 1) << 22 | (((sm as u32) & 1) << 5))
end

