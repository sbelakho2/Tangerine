# VMRS APSR_nzcv, FPSCR — 32-bit VFP system-register move to the APSR
# flags (Rt = 15, the APSR_nzcv form), word 0xEEF1FA10. Copies the
# FPSCR N/Z/C/V flags into APSR — the ONLY way floating comparisons
# (t2_vcmp_f64) reach the core NZCV flags; WRITES NZCV. Verified:
# vmrs APSR_nzcv, FPSCR = 0xEEF1FA10 (and vmrs r0, FPSCR = 0xEEF10A10,
# vmrs r5, FPSCR = 0xEEF15A10 pin Rt at bits 15..12).
def t2_vmrs_apsr_nzcv(inout b: CodeBuffer) -> Unit
  t2_word(b, 0xEEF1FA10)
end

# VNEG.F32 Sd, Sm — monadic single negation, word 0xEEB10A40 |
# (Sd>>1)<<12 | (Sm>>1) | (Sd&1)<<22 | (Sm&1)<<5: the sz = 0 sibling of
# t2_vneg_f64 ([11:8] = 1010; [19:16] holds the monadic opcode 0001, not
# a register), s-registers in the double-pair slot with the parity bits
# D/M at 22/5 exactly like t2_vadd_f32. Verified: vneg.f32 s0, s0 =
# 0xEEB10A40; vneg.f32 s0, s1 = 0xEEB10A60; vneg.f32 s1, s0 = 0xEEF10A40;
# vneg.f32 s13, s7 = 0xEEF16A63; vneg.f32 s17, s18 = 0xEEF18A49;
# vneg.f32 s31, s30 = 0xEEF1FA4F; vneg.f32 s16, s0 = 0xEEB18A40;
# vneg.f32 s30, s31 = 0xEEB1FA6F; vneg.f32 s15, s8 = 0xEEF17A44.
# FLAGLESS (VFP data processing never writes the core APSR).
def t2_vneg_f32(inout b: CodeBuffer, sd: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vneg_f32: destination must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vneg_f32: source must be s0-s31") end
  t2_word(b, 0xEEB10A40 | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VCMP.F32 Sd, Sm — monadic single compare, word 0xEEB40A40 | same fields
# as t2_vneg_f32 (the f32 sibling of t2_vcmp_f64: opcode [19:16] = 0100,
# [7:4] = 0100). Sets the FPSCR comparison flags (they reach APSR only
# through t2_vmrs_apsr_nzcv). Verified: vcmp.f32 s0, s0 = 0xEEB40A40;
# vcmp.f32 s0, s1 = 0xEEB40A60; vcmp.f32 s1, s0 = 0xEEF40A40;
# vcmp.f32 s17, s18 = 0xEEF48A49; vcmp.f32 s31, s30 = 0xEEF4FA4F;
# vcmp.f32 s13, s7 = 0xEEF46A63; vcmp.f32 s16, s0 = 0xEEB48A40;
# vcmp.f32 s30, s31 = 0xEEB4FA6F.
def t2_vcmp_f32(inout b: CodeBuffer, sd: Int, sm: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vcmp_f32: register must be s0-s31") end
  if sm < 0 || sm > 31 then panic("t2_vcmp_f32: source must be s0-s31") end
  t2_word(b, 0xEEB40A40 | (((sd as u32) >> 1) << 12) | (((sm as u32) & 1) << 5) | (((sd as u32) & 1) << 22) | ((sm as u32) >> 1))
end

# VCMP.F32 Sd, #0.0 — compare against +0.0, word 0xEEB50A40 |
# (Sd>>1)<<12 | (Sd&1)<<22 (opcode [19:16] = 0101; no Vm field), the f32
# sibling of t2_vcmp_f64_zero. Sets the FPSCR comparison flags. Verified:
# vcmp.f32 s0, #0.0 = 0xEEB50A40; vcmp.f32 s17, #0.0 = 0xEEF58A40;
# vcmp.f32 s31, #0.0 = 0xEEF5FA40; vcmp.f32 s16, #0.0 = 0xEEB58A40;
# vcmp.f32 s1, #0.0 = 0xEEF50A40; vcmp.f32 s9, #0.0 = 0xEEF54A40.
def t2_vcmp_f32_zero(inout b: CodeBuffer, sd: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vcmp_f32_zero: register must be s0-s31") end
  t2_word(b, 0xEEB50A40 | (((sd as u32) >> 1) << 12) | (((sd as u32) & 1) << 22))
end

# VMOV Sd, Rt — VFP single register <- ARM core register (the MCR p10,
# L = 0 form of the core<->VFP move), word 0xEE000A10 | (Sd>>1)<<16 |
# (Sd&1)<<7 | Rt<<12. The s-register field is the MCR/MRC CRn form, NOT
# the data-processing double slot: Sd>>1 at bits 19..16 and the parity
# bit at bit 7 (verified against vmov s0, r1 = 0xEE001A10 and
# vmov s1, r0 = 0xEE000A90 — parity at 7, not 22), Rt at bits 15..12.
# Verified: vmov s0, r0 = 0xEE000A10; vmov s17, r3 = 0xEE083A90;
# vmov s31, r12 = 0xEE0FCA90; vmov s13, r2 = 0xEE062A90; vmov s16, r9 =
# 0xEE089A10; vmov s14, r3 = 0xEE073A10; vmov s30, r10 = 0xEE0FAA10.
# Rt = r0-r14 (r15 is excluded: the MCR Rt = 15 form is architecturally
# UNPREDICTABLE — the APSR variant belongs to VMRS). FLAGLESS.
def t2_vmov_gp_to_s(inout b: CodeBuffer, rt: Int, sd: Int) -> Unit
  if rt < 0 || rt > 14 then panic("t2_vmov_gp_to_s: register must be r0-r14") end
  if sd < 0 || sd > 31 then panic("t2_vmov_gp_to_s: register must be s0-s31") end
  t2_word(b, 0xEE000A10 | (((sd as u32) >> 1) << 16) | (((sd as u32) & 1) << 7) | ((rt as u32) << 12))
end

# VMOV Rt, Sd — ARM core register <- VFP single (the MRC p10, L = 1 form;
# the ARM mnemonic is "VMOV <Rt>, <Sd>"), word 0xEE100A10 | same fields
# as t2_vmov_gp_to_s (Sd>>1 at bits 19..16, Sd&1 at bit 7, Rt at bits
# 15..12). Verified: vmov r0, s0 = 0xEE100A10; vmov r0, s1 = 0xEE100A90;
# vmov r3, s17 = 0xEE183A90; vmov r12, s31 = 0xEE1FCA90; vmov r2, s13 =
# 0xEE162A90; vmov r0, s31 = 0xEE1F0A90; vmov r13, s5 = 0xEE12DA90.
# Rt = r0-r14 as above. FLAGLESS.
def t2_vmov_s_to_gp(inout b: CodeBuffer, rt: Int, sd: Int) -> Unit
  if rt < 0 || rt > 14 then panic("t2_vmov_s_to_gp: register must be r0-r14") end
  if sd < 0 || sd > 31 then panic("t2_vmov_s_to_gp: register must be s0-s31") end
  t2_word(b, 0xEE100A10 | (((sd as u32) >> 1) << 16) | (((sd as u32) & 1) << 7) | ((rt as u32) << 12))
end

# VMOV Dd, Rt, Rt2 — VFP double register <- ARM core register pair (the
# MCRR p11, L = 0 form; ARM mnemonic "VMOV <Dd>, <Rt>, <Rt2>"), word
# 0xEC400B10 | Rt2<<16 | Rt<<12 | (Dd>>4)<<5 | (Dd&15). The double
# register splits across bits 3..0 (Dd&15) and the D parity at bit 5
# (NOT 22): verified with vmov d1, r0, r1 = 0xEC410B11 (d1 = bit 0) and
# vmov d16, r0, r1 = 0xEC410B30 (d16 = bit 5). The FIRST core operand of
# the mnemonic sits at bits 15..12 and the SECOND at 19..16 (verified:
# vmov d0, r1, r2 = 0xEC421B10; vmov d2, r1, r3 = 0xEC431B12). Verified:
# vmov d0, r0, r1 = 0xEC410B10; vmov d17, r4, r5 = 0xEC454B31;
# vmov d31, r10, r11 = 0xEC4BAB3F; vmov d13, r7, r8 = 0xEC487B1D;
# vmov d6, r3, r12 = 0xEC4C3B16; vmov d8, r11, r9 = 0xEC49BB18.
# Rt/Rt2 = r0-r14 (r15 is excluded: Rt2 = r15 is UNPREDICTABLE in the
# MCRR form). FLAGLESS.
def t2_vmov_gp_pair_to_d(inout b: CodeBuffer, rt: Int, rt2: Int, dd: Int) -> Unit
  if rt < 0 || rt > 14 then panic("t2_vmov_gp_pair_to_d: register must be r0-r14") end
  if rt2 < 0 || rt2 > 14 then panic("t2_vmov_gp_pair_to_d: second register must be r0-r14") end
  if dd < 0 || dd > 31 then panic("t2_vmov_gp_pair_to_d: register must be d0-d31") end
  t2_word(b, 0xEC400B10 | ((rt2 as u32) << 16) | ((rt as u32) << 12) | ((((dd as u32) >> 4) & 1) << 5) | ((dd as u32) & 15))
end

# VMOV Rt, Rt2, Dd — ARM core register pair <- VFP double (the MRRC p11,
# L = 1 form; ARM mnemonic "VMOV <Rt>, <Rt2>, <Dd>"), word 0xEC500B10 |
# same fields as t2_vmov_gp_pair_to_d. Verified: vmov r0, r1, d0 =
# 0xEC510B10; vmov r1, r2, d1 = 0xEC521B11; vmov r2, r3, d0 = 0xEC532B10;
# vmov r4, r5, d17 = 0xEC554B31; vmov r10, r11, d31 = 0xEC5BAB3F;
# vmov r7, r8, d13 = 0xEC587B1D; vmov r0, r1, d16 = 0xEC510B30;
# vmov r3, r12, d6 = 0xEC5C3B16; vmov r0, r1, d15 = 0xEC510B1F.
# Rt/Rt2 = r0-r14 (Rt2 = r15 is UNPREDICTABLE in the MRRC form). FLAGLESS.
def t2_vmov_d_to_gp_pair(inout b: CodeBuffer, rt: Int, rt2: Int, dd: Int) -> Unit
  if rt < 0 || rt > 14 then panic("t2_vmov_d_to_gp_pair: register must be r0-r14") end
  if rt2 < 0 || rt2 > 14 then panic("t2_vmov_d_to_gp_pair: second register must be r0-r14") end
  if dd < 0 || dd > 31 then panic("t2_vmov_d_to_gp_pair: register must be d0-d31") end
  t2_word(b, 0xEC500B10 | ((rt2 as u32) << 16) | ((rt as u32) << 12) | ((((dd as u32) >> 4) & 1) << 5) | ((dd as u32) & 15))
end

# VMOV.F64 Dd, #imm — VFP modified-immediate load into a double register
# (A7.8 VMOVimmediate; cond 1110, [23:20] = 1011 with D at bit 22, sz =
# 1 ([11:8] = 1011), [7:4] = 0000). The 8-bit immediate imm8 = abcdefgh
# is SPLIT across the instruction: bits a:bcd (imm8's high nibble) at
# bits 19..16 and bits e:fgh (imm8's low nibble) at bits 3..0 — [19:16]
# carries immediate data, NOT an opcode, so the imm-independent base is
# 0xEEB00B00. Word: 0xEEB00B00 | ((imm8 & 0xF0)<<12) | ((Dd&15)<<12) |
# ((Dd>>4)<<22) | (imm8 & 15). Value semantics of imm8 (the VFP
# modified-immediate rule, verified exhaustively — all 256 imm8 values
# round-tripped through BOTH decoders below, 0/256 mismatches each):
#   sign a = imm8 bit 7; fraction f = imm8 bits 3..0; exponent-field
#   bits bcd = imm8 bits 6..4 give the power E = bcd+1 (bcd 0..3, E =
#   1..4) or E = bcd-7 (bcd 4..7, E = -3..0); the value is
#   (-1)^a * (1 + f/16) * 2^E. Equivalently the encodable bit patterns
#   are the normal numbers with unbiased exponent E in [-3, 4] whose
#   fraction is exactly f/16 (see t2_vmov_f64_const). Imm8 encodings of
#   the common constants (each Verified by assembling the literal):
#   #1.0 = 0x70 (vmov.f64 d0, #1.0 = 0xEEB70B00), #-1.0 = 0xF0
#   (0xEEBF0B00), #0.5 = 0x60 (0xEEB60B00), #2.0 = 0x00 (0xEEB00B00),
#   #0.25 = 0x50, #4.0 = 0x10, #8.0 = 0x20, #0.125 = 0x40 (0xEEB40B00),
#   #16.0 = 0x30 (0xEEB30B00), #-0.5 = 0xE0, #-2.0 = 0x80, #0.75 = 0x68,
#   #1.5 = 0x78, #3.0 = 0x08, #3.5 = 0x0C, #15.5 = 0x2F. ZERO IS NOT
#   ENCODABLE: the assembler rejects vmov.f64 d0, #0.0 and #-0.0
#   (modified immediates always carry a leading 1.mantissa), so
#   t2_vmov_f64_const returns false for the 0.0 bit patterns. Register
#   fields (double-slot Dd, D at bit 22) verified: vmov.f64 d17, #1.0 =
#   0xEEF71B00; vmov.f64 d31, #0.5 = 0xEEF6FB00; vmov.f64 d16, #-1.0 =
#   0xEEFF0B00; vmov.f64 d13, #2.0 = 0xEEB0DB00; vmov.f64 d1, #1.0 =
#   0xEEB71B00; vmov.f64 d30, #0.5 = 0xEEF6EB00; vmov.f64 d9, #0.0 is
#   rejected. FLAGLESS. (Verification aid for this encoder family: clang
#   -target thumbv7em-none-eabi -mcpu=cortex-m7 -mfpu=vfpv3 assembling
#   each literal, words echoed by llvm-objdump AND independently decoded
#   by capstone Thumb-2; the imm8 rule above matches all 256 words in
#   both decoders for the f64 AND f32 forms.)
def t2_vmov_f64_imm(inout b: CodeBuffer, dd: Int, imm8: Int) -> Unit
  if dd < 0 || dd > 31 then panic("t2_vmov_f64_imm: register must be d0-d31") end
  if imm8 < 0 || imm8 > 255 then panic("t2_vmov_f64_imm: imm8 must be 0-255") end
  t2_word(b, 0xEEB00B00 | (((imm8 as u32) & 0xF0) << 12) | (((dd as u32) & 15) << 12) | ((((dd as u32) >> 4) & 1) << 22) | ((imm8 as u32) & 15))
end

# VMOV.F32 Sd, #imm — the single-precision form of the modified-immediate
# load: word 0xEEB00A00 | ((imm8 & 0xF0)<<12) | ((Sd>>1)<<12) |
# ((Sd&1)<<22) | (imm8 & 15) (sz = 0, [11:8] = 1010; Sd in the
# double-pair slot). imm8 and its value semantics are IDENTICAL to
# t2_vmov_f64_imm (same 256-value table, verified in both decoders).
# Verified: vmov.f32 s0, #1.0 = 0xEEB70A00; vmov.f32 s0, #-1.0 =
# 0xEEBF0A00; vmov.f32 s0, #0.5 = 0xEEB60A00; vmov.f32 s0, #2.0 =
# 0xEEB00A00; vmov.f32 s17, #1.0 = 0xEEF78A00; vmov.f32 s31, #0.5 =
# 0xEEF6FA00; vmov.f32 s16, #-1.0 = 0xEEBF8A00; vmov.f32 s13, #2.0 =
# 0xEEF06A00; vmov.f32 s1, #1.0 = 0xEEF70A00; vmov.f32 s30, #0.5 =
# 0xEEB6FA00; vmov.f32 s9, #0.0 is rejected (zero is not encodable).
# FLAGLESS.
def t2_vmov_f32_imm(inout b: CodeBuffer, sd: Int, imm8: Int) -> Unit
  if sd < 0 || sd > 31 then panic("t2_vmov_f32_imm: register must be s0-s31") end
  if imm8 < 0 || imm8 > 255 then panic("t2_vmov_f32_imm: imm8 must be 0-255") end
  t2_word(b, 0xEEB00A00 | (((imm8 as u32) & 0xF0) << 12) | (((sd as u32) >> 1) << 12) | (((sd as u32) & 1) << 22) | ((imm8 as u32) & 15))
end

# The exact accept test for t2_vmov_f64_const: an f64 bit pattern has a
# modified-immediate encoding iff it is a normal number whose unbiased
# exponent E = exp_field - 1023 lies in [-3, 4] and whose 52-bit
# fraction is f<<48 for some 4-bit f (the low 48 fraction bits are
# zero) — the value is then (-1)^sign * (1 + f/16) * 2^E, imm8 =
# sign<<7 | ((E-1)&7)<<4 | f. The exponent field maps onto imm8's bcd
# bits as (E-1)&7 = exp_field & 7 (1023 = 1024-1, so E-1 = exp_field -
# 1024 and 1024 is 0 mod 8). Verified: the accept set above agrees with
# the assembler on every boundary and reject probe — #0.125 (E = -3,
# exp 1020) encodes, #0.0625 (E = -4) is rejected, #16.0 (E = 4, exp
# 1027) encodes, #32.0 (E = 5) and #0.0/#-0.0 are rejected, and every
# accepted value's word matches t2_vmov_f64_imm's output. The imm8
# VALUE is returned by t2_vmov_imm8_of_f64_bits (-1 = not encodable):
# the F32 modified-immediate form encodes the SAME 256-value set with
# the SAME imm8, so the F32 constant path reuses this predicate.
def t2_vmov_imm8_of_f64_bits(bits: u64) -> Int
  let e = bits >> 52
  if e < 1020 || e > 1027 then
    return -1
  end
  let m = (bits << 12) >> 12
  let f = m >> 48
  if (f << 48) != m then
    return -1
  end
  ((((bits >> 63) & 1) << 7) | ((e & 7) << 4) | f) as Int
end

# Returns true iff `bits` has an encoding (and emits the VMOV.F64 imm);
# false otherwise.
def t2_vmov_f64_const(inout b: CodeBuffer, dd: Int, bits: u64) -> Bool
  if dd < 0 || dd > 31 then panic("t2_vmov_f64_const: register must be d0-d31") end
  let imm8 = t2_vmov_imm8_of_f64_bits(bits)
  if imm8 < 0 then
    return false
  end
  t2_vmov_f64_imm(b, dd, imm8)
  true
end

# The single-precision sibling of t2_vmov_f64_const: the SAME encodable
# value set, tested on the f32 bit pattern (unbiased exponent E =
# exp_field - 127 in [-3, 4], i.e. exp_field 124..131, fraction exactly
# f<<19). Verified against the assembler on the same probes
# (vmov.f32 s0, #0.5 = 0xEEB60A00 etc.), including the zero rejection.
def t2_vmov_f32_const(inout b: CodeBuffer, sd: Int, bits: u32) -> Bool
  if sd < 0 || sd > 31 then panic("t2_vmov_f32_const: register must be s0-s31") end
  let e = (bits >> 23) & 0xFF
  if e < 124 || e > 131 then
    return false
  end
  let m = bits & 0x7FFFFF
  let f = m >> 19
  if (f << 19) != m then
    return false
  end
  let imm8 = ((((bits >> 31) & 1) << 7) | ((e & 7) << 4) | f) as Int
  t2_vmov_f32_imm(b, sd, imm8)
  true
end

# ———————————————————————————————————————————————————————————————
# Condition codes and the LirCond mapping
# ———————————————————————————————————————————————————————————————
# The ARM 4-bit condition codes (the shared A32/A64 space — aarch64's
# a64_cc_* values are these exact codes): EQ=0, NE=1, CS=2, CC=3, HI=8,
# LS=9, GE=10, LT=11, GT=12, LE=13. The inverse of a condition is
# cond XOR 1.
def thumb_cc(c: LirCond) -> Int
  match c
  when LirCond::LirEq then 0
  when LirCond::LirNe then 1
  when LirCond::LirLt then 11
  when LirCond::LirLe then 13
  when LirCond::LirGt then 12
  when LirCond::LirGe then 10
  when LirCond::LirUlt then 3   # unsigned lower = CC (LO)
  when LirCond::LirUle then 9   # unsigned lower-or-same = LS
  when LirCond::LirUgt then 8   # unsigned higher = HI
  when LirCond::LirUge then 2   # unsigned higher-or-same = CS (HS)
  end
end

# ———————————————————————————————————————————————————————————————
# Emitter state and whole-function validation
# ———————————————————————————————————————————————————————————————
# The emission machinery mirrors lir.tg's emitter (Slice 4): allocation
# decisions come from the precomputed LirAlloc, keyed by the linear
# position of each statement/terminator in the SAME walk the allocator
# used (invariant I3). Unlike the aarch64 emitter, control-flow targets
# inside one function may not exist yet when a branch is emitted
# (forward branches), so unconditional/call branches record deferred
# patches resolved after the whole program is emitted; the block labels
# live in the buffer's label map, exactly like the aarch64 route's.
# Branch policy (relaxation-lite, always correct):
#   - backward unconditional branches whose target is already defined
#     and within the 16-bit range emit the 2-byte B; everything else
#     emits the 4-byte B.W with a deferred patch (B.W covers +/-16 MiB,
#     so no legitimate function can fail the range check);
#   - backward conditional branches within the 2-byte B.cond range emit
#     directly; every other conditional branch emits the invert-and-skip
#     pattern (B<not cond> +2; B.W target) which never needs a range
#     check on the conditional part.

# A deferred branch patch: the 4 bytes at `offset` hold a B.W/BL with an
# imm24 of 0; resolution rewrites them for the final offset.
struct ThumbPatch
  offset: Int
  label: String
  is_bl: Bool
end

# An extern-call site: R_ARM_THM_CALL relocation against `sym` at
# `offset` (the BL placeholder F000 F800 sits there; the linker patches).
# The record's `kind` carries the ELF ARM relocation type — 10
# (R_ARM_THM_CALL) for calls, 47/48 (R_ARM_THM_MOVW_ABS_NC /
# R_ARM_THM_MOVT_ABS) for the MOVW/MOVT absolute-address pairs of
# static references (LirStaticLoad) — the writer serializes each entry
# with its own type.
struct ThumbReloc
  offset: Int
  sym: String
  kind: Int
end

# The ELF ARM relocation types this backend emits (ARM IHI 0044F — ELF
# for the ARM Architecture):
#   R_ARM_THM_CALL      = 10  (BL to a function symbol)
#   R_ARM_THM_MOVW_ABS_NC = 47 (MOVW imm16 <- S + A, no overflow check)
#   R_ARM_THM_MOVT_ABS  = 48  (MOVT imm16 <- (S + A) >> 16)
def thumb_reloc_call() -> Int = 10
def thumb_reloc_movw_abs_nc() -> Int = 47
def thumb_reloc_movt_abs() -> Int = 48

# The whole-program emission state: the text buffer, the deferred branch
# patches, the extern-call relocations and the symbol records (function
# symbols + extern undefined symbols, in program order). `f64dp` is the
# current function's scalar F64 data-processing admission
# (target_desc_f64_data_processing over the route's descriptor — set
# once per function by thumb_emit_fn); `fp_save` records whether the
# current function's frame carries the VPUSH/VPOP {d8-d15} FP
# callee-save block (FP content on an FPU-carrying descriptor — the
# prologue emits it, the epilogue restores it).
struct ThumbEmit
  buf: CodeBuffer
  patches: Vec[ThumbPatch]
  relocs: Vec[ThumbReloc]
  syms: Vec[AsmSymbol]
  f64dp: Bool
  fp_save: Bool
  desc_name: String
end

def thumb_emit_new() -> ThumbEmit
  ThumbEmit {
    buf: buf_new(),
    patches: Vec::new(),
    relocs: Vec::new(),
    syms: Vec::new(),
    f64dp: false,
    fp_save: false,
    desc_name: "".to_string()
  }
end

# Append a machine function symbol (global) at the current buffer
# position. The ELF writer adds the local "$t" mapping symbol beside it.
# (P1-18 @cold): an attr_cold function's symbol is routed into the cold
# section (Section::ColdText — the .text.cold region the writer splits
# from the code stream's cold tail; see thumb_compile_object's deferred
# cold pass).
def thumb_emit_fn_symbol(inout te: ThumbEmit, name: String, is_cold: Bool) -> Unit
  te.syms.push(AsmSymbol {
    name: name,
    section: if is_cold then Section::ColdText else Section::Text end,
    offset: buf_pos(&te.buf),
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
end

# ———————————————————————————————————————————————————————————————
# Whole-function shape validation (fail-closed, before any emission)
# ———————————————————————————————————————————————————————————————
# Mirrors lir.tg's fail-closed lowering contract: every construct this
# backend cannot compile names its rule in the Err. Runs once per
# function before thumb_emit_fn touches the buffer.

# An immediate payload the 32-bit word model accepts: [-2^31, 2^32).
def thumb_imm32_ok(imm: Int) -> Bool
  imm >= -2147483648 && imm <= 4294967295
end

def thumb_fixed_bad(lir_reg: Int) -> Bool
  lir_reg >= 4 && lir_reg < lir_first_alloc_vreg()
end

# A marked NON-ATOMIC pointer statement's width is one of the cortex-m
# machine-access widths (1/2/4 bytes — the ARMv7-M descriptors' entire
# native_atomic_widths class, shared by every family instance; there is
# no emulated class on ARMv7-M). Width 8 (a _u64 deref) is the
# ARMv7-M fail-closed case: M3/M4/M4F/M7 have no 8-byte memory form
# (and even the plain LDRD/STRD pair is not single-copy atomic). The
# ATOMIC forms (LirAtomLoad/LirAtomStore/LirAtomRmw/LirAtomCas) ask THE
# ONE atomic authority instead — thumb_validate_ptr_stmt consults
# target_desc.atomic_support over the route's descriptor (audit item
# 43); this plain-width rule remains the non-atomic deref surface (the
# riscv backend's rv_ptr_width_ok mirror — derefs are not atomics).
def thumb_ptr_width_ok(w: Int) -> Bool
  w >= 1 && w <= 4
end

# Validate one marked LirPtrOp statement against the cortex-m surface
# (fail-closed, before any emission): the ARMv7-M widths (1/2/4 — for
# the ATOMIC forms the ONE atomic authority's answer over `desc`, audit
# item 43; for the plain deref forms the machine-access rule), the
# per-form ordering codes and the vreg/offset geometry of each form.
def thumb_validate_ptr_stmt(fn_name: String, pop: LirPtrOp, desc: TargetDesc) -> Result[Unit, String]
  match pop
  when LirPtrOp::LirPtrLea(dst, off) then
    # dst = r7 + off — the frame-slot address (off = 4*slot on the
    # cortex-m route, 0..0xFFFF under the 16-bit frame model).
    if thumb_fixed_bad(dst) then
      return Result::Err("thumb: " + fn_name + ": pointer LEA into fixed vreg " + dst.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7 — fail-closed)")
    end
    if off < 0 || off > 0xFFFF then
      return Result::Err("thumb: " + fn_name + ": pointer LEA offset " + off.to_string() + " is outside the cortex-m frame-address model 0..65535 (fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirPtrAddr(dst, base, off) then
    if thumb_fixed_bad(dst) || thumb_fixed_bad(base) then
      return Result::Err("thumb: " + fn_name + ": pointer address arithmetic over fixed vregs 4..7 does not lower (fail-closed)")
    end
    if off < 0 || off > 0xFFFF then
      return Result::Err("thumb: " + fn_name + ": pointer address offset " + off.to_string() + " is outside the cortex-m 16-bit address model (fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirPtrLoad(dst, base, off, w, sign) then
    if thumb_fixed_bad(dst) || thumb_fixed_bad(base) then
      return Result::Err("thumb: " + fn_name + ": pointer load over fixed vregs 4..7 does not lower (fail-closed)")
    end
    if !thumb_ptr_width_ok(w) then
      return Result::Err("thumb: " + fn_name + ": pointer deref load width " + w.to_string() + " does not lower on the cortex-m route — only the 1/2/4-byte widths exist on ARMv7-M (an 8-byte deref needs the doubleword memory forms of a wider profile; the ARMv7-M descriptors' native_atomic_widths are [1, 2, 4] — fail-closed)")
    end
    if sign && w == 4 then
      return Result::Err("thumb: " + fn_name + ": pointer deref load with sign extension at the full 4-byte word width does not lower (the lowering never emits it — fail-closed)")
    end
    if off < 0 || off > 0xFFFF then
      return Result::Err("thumb: " + fn_name + ": pointer load offset " + off.to_string() + " is outside the cortex-m 16-bit address model (fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirPtrStore(base, off, src, w) then
    if thumb_fixed_bad(base) || thumb_fixed_bad(src) then
      return Result::Err("thumb: " + fn_name + ": pointer store over fixed vregs 4..7 does not lower (fail-closed)")
    end
    if !thumb_ptr_width_ok(w) then
      return Result::Err("thumb: " + fn_name + ": pointer deref store width " + w.to_string() + " does not lower on the cortex-m route (only the 1/2/4-byte widths exist on ARMv7-M — fail-closed)")
    end
    if off < 0 || off > 0xFFFF then
      return Result::Err("thumb: " + fn_name + ": pointer store offset " + off.to_string() + " is outside the cortex-m 16-bit address model (fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirAtomLoad(form, w, dst, addr) then
    if thumb_fixed_bad(dst) || thumb_fixed_bad(addr) then
      return Result::Err("thumb: " + fn_name + ": atomic load over fixed vregs 4..7 does not lower (fail-closed)")
    end
    # AUDIT ITEM 43 — the width decision is THE ONE atomic authority's
    # answer over the route's descriptor (the strongest order word
    # "seq_cst": the ARMv7-M width classes are order-uniform — an
    # ordering-valid width never changes class per order): only the
    # family's NATIVE class validates — an EMULATED answer is
    # impossible on every ARMv7-M desc of this slice (the emulated
    # class is empty) and would fail closed regardless (this backend
    # has no emulated loop); Unsupported fails closed with the
    # width-8 rule below.
    match atomic_support(desc, w, "load", "seq_cst")
    when AtomicSupport::Native then ()
    when _ then
      return Result::Err("thumb: " + fn_name + ": atomic load width " + w.to_string() + " does not lower on the cortex-m route — ARMv7-M has no LDREXD/STREXD-class 8-byte exclusives and no doubleword atomic form; the ARMv7-M descriptors' native_atomic_widths are [1, 2, 4] (fail-closed)")
    end
    if form != 0 && form != 1 then
      return Result::Err("thumb: " + fn_name + ": atomic load ordering form " + form.to_string() + " does not lower (the cortex-m forms are 0 = relaxed and 1 = acquire — fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirAtomStore(form, w, addr, val) then
    if thumb_fixed_bad(addr) || thumb_fixed_bad(val) then
      return Result::Err("thumb: " + fn_name + ": atomic store over fixed vregs 4..7 does not lower (fail-closed)")
    end
    # AUDIT ITEM 43 — the authority (see the atomic load arm above).
    match atomic_support(desc, w, "store", "seq_cst")
    when AtomicSupport::Native then ()
    when _ then
      return Result::Err("thumb: " + fn_name + ": atomic store width " + w.to_string() + " does not lower on the cortex-m route (ARMv7-M has no 8-byte atomic form; the ARMv7-M descriptors' native_atomic_widths are [1, 2, 4] — fail-closed)")
    end
    if form != 0 && form != 1 then
      return Result::Err("thumb: " + fn_name + ": atomic store ordering form " + form.to_string() + " does not lower (the cortex-m forms are 0 = relaxed and 1 = release — fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirAtomRmw(family, form, w, dst, addr, val) then
    if thumb_fixed_bad(dst) || thumb_fixed_bad(addr) || thumb_fixed_bad(val) then
      return Result::Err("thumb: " + fn_name + ": atomic RMW over fixed vregs 4..7 does not lower (fail-closed)")
    end
    # AUDIT ITEM 43 — the authority (see the atomic load arm above).
    match atomic_support(desc, w, "rmw", "seq_cst")
    when AtomicSupport::Native then ()
    when _ then
      return Result::Err("thumb: " + fn_name + ": atomic RMW width " + w.to_string() + " does not lower on the cortex-m route (ARMv7-M has no 8-byte exclusive form; the ARMv7-M descriptors' native_atomic_widths are [1, 2, 4] — fail-closed)")
    end
    if family < 0 || family > 4 then
      return Result::Err("thumb: " + fn_name + ": atomic RMW family " + family.to_string() + " does not lower (families 0 = add, 1 = and, 2 = or, 3 = xor, 4 = exchange — fail-closed)")
    end
    if form < 0 || form > 3 then
      return Result::Err("thumb: " + fn_name + ": atomic RMW ordering form " + form.to_string() + " does not lower (forms 0..3 — fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirAtomCas(form, w, dst, exp, des, addr) then
    if thumb_fixed_bad(dst) || thumb_fixed_bad(exp) || thumb_fixed_bad(des) || thumb_fixed_bad(addr) then
      return Result::Err("thumb: " + fn_name + ": atomic compare_exchange over fixed vregs 4..7 does not lower (fail-closed)")
    end
    # AUDIT ITEM 43 — the authority (see the atomic load arm above).
    match atomic_support(desc, w, "cas", "seq_cst")
    when AtomicSupport::Native then ()
    when _ then
      return Result::Err("thumb: " + fn_name + ": atomic compare_exchange width " + w.to_string() + " does not lower on the cortex-m route (ARMv7-M has no 8-byte exclusive form; the ARMv7-M descriptors' native_atomic_widths are [1, 2, 4] — fail-closed)")
    end
    if form < 0 || form > 3 then
      return Result::Err("thumb: " + fn_name + ": atomic compare_exchange ordering form " + form.to_string() + " does not lower (forms 0..3 — fail-closed)")
    end
    Result::Ok(())
  when LirPtrOp::LirPtrFence(form) then
    if form != 0 && form != 1 then
      return Result::Err("thumb: " + fn_name + ": fence form " + form.to_string() + " does not lower (forms 0 = acquire and 1 = release — fail-closed)")
    end
    Result::Ok(())
  end
end

def thumb_validate_fn(f: LirFunction, desc: TargetDesc) -> Result[Unit, String]
  var bi = 0
  while bi < f.blocks.len() do
    let block = f.blocks[bi]
    var si = 0
    while si < block.stmts.len() do
      let stmt = block.stmts[si]
      # (cortex-m atomic/pointer slice): a marked LirPtrOp statement
      # (LirStmt.ptr — the pointer/atomic statements the cm lowering
      # produces once the atomic surface is open) validates against the
      # ARMv7-M exclusive/width surface FIRST — its nominal kind's
      # semantics do not apply (the nominal kinds are only arity-
      # nearest carriers). The width-8 forms (the _u64 atomic family
      # and 8-byte pointer derefs) fail closed HERE too, defensively:
      # the lowering already rejects them with the target reason (the
      # atomic forms through THE ONE atomic authority — audit item 43
      # — over `desc`), so a width-8 marked statement reaching this
      # backend marks a lowering/backend divergence.
      match stmt.ptr
      when Option::Some(pop) then
        match thumb_validate_ptr_stmt(f.name, pop, desc)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when Option::None then ()
      end
      match stmt.kind
      when LirStmtKind::LirMove(dst, val) then
        if thumb_fixed_bad(dst) then
          return Result::Err("thumb: " + f.name + ": move into fixed vreg " + dst.to_string() + " (x" + dst.to_string() + ") does not lower — fixed vregs 4..7 are the aarch64 ABI registers x4..x7, and the cortex-m lowering (lower_mir_fn_to_lir_cm) moves register-class arguments into fixed vregs 0..3 only; arguments >= 4 take the AAPCS caller stack (fail-closed)")
        end
        match val
        when LirValue::LirReg(src) then
          if thumb_fixed_bad(src) then
            return Result::Err("thumb: " + f.name + ": move from fixed vreg " + src.to_string() + " (x" + src.to_string() + ") does not lower — fixed vregs 4..7 are the aarch64 ABI registers x4..x7; the cortex-m lowering binds parameters >= 4 from their AAPCS caller-stack words (LirLoadFrame), never from a fixed register (fail-closed)")
          end
        when LirValue::LirImm(imm) then
          if !thumb_imm32_ok(imm) then
            return Result::Err("thumb: " + f.name + ": constant " + imm.to_string() + " does not fit the 32-bit cortex-m word model [-2^31, 2^32) (this route is word-only — fail-closed)")
          end
        end
      when LirStmtKind::LirBinop(op, dst, left, right) then
        match left
        when LirValue::LirReg(_) then ()
        when LirValue::LirImm(_) then
          return Result::Err("thumb: " + f.name + ": binop left operand is an immediate — lowering never produces this (fail-closed)")
        end
        match right
        when LirValue::LirReg(rv) then
          if thumb_fixed_bad(rv) then
            return Result::Err("thumb: " + f.name + ": binop operand from fixed vreg " + rv.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering never emits them — fail-closed)")
          end
        when LirValue::LirImm(imm) then
          match op
          when LirBinOp::LirShl then
            if imm < 0 || imm > 255 then
              return Result::Err("thumb: " + f.name + ": shift count " + imm.to_string() + " is outside the 32-bit cortex-m model 0..255 (this route is word-only — fail-closed)")
            end
          when LirBinOp::LirLsr then
            if imm < 0 || imm > 255 then
              return Result::Err("thumb: " + f.name + ": shift count " + imm.to_string() + " is outside the 32-bit cortex-m model 0..255 (this route is word-only — fail-closed)")
            end
          when LirBinOp::LirAsr then
            if imm < 0 || imm > 255 then
              return Result::Err("thumb: " + f.name + ": shift count " + imm.to_string() + " is outside the 32-bit cortex-m model 0..255 (this route is word-only — fail-closed)")
            end
          when _ then
            if !thumb_imm32_ok(imm) then
              return Result::Err("thumb: " + f.name + ": constant " + imm.to_string() + " does not fit the 32-bit cortex-m word model [-2^31, 2^32) (this route is word-only — fail-closed)")
            end
          end
        end
      when LirStmtKind::LirUnop(_, dst, src) then
        # A bm-marked carrier (LirStmt.bm — the int<->float transmute of
        # the float slice) validates as the register-class bit move it
        # is: the FP side must carry a class record (an ordinary FP
        # vreg — fixed FP ids are ABI edges, never transmute results),
        # the general side must be an ordinary word, and only the F32
        # pair exists at the 32-bit word model (an F64 bit image needs
        # the two-register VMOV pair the single-GP-operand carrier
        # cannot express; the lowering rejects it before this check —
        # defense in depth).
        match stmt.bm
        when Option::Some(bmop) then
          match bmop
          when LirBitMoveOp::LirBitsGpToFp then
            match f.fp_widths.get(dst)
            when Option::Some(w) then
              if w != LirFpWidth::LirF32 then
                return Result::Err("thumb: " + f.name + ": f64 gp-to-fp bit move into vreg " + dst.to_string() + " does not lower on the cortex-m route (the 32-bit word model has no single general register for a 64-bit image — only F32 <-> the 4-byte integer words lower; fail-closed)")
              end
            when Option::None then
              return Result::Err("thumb: " + f.name + ": gp-to-fp bit move destination vreg " + dst.to_string() + " has no FP class record (a fixed/ABI id or a class-table divergence — fail-closed)")
            end
            if thumb_fixed_bad(src) then
              return Result::Err("thumb: " + f.name + ": gp-to-fp bit move source from fixed vreg " + src.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7 — fail-closed)")
            end
          when LirBitMoveOp::LirBitsFpToGp then
            match f.fp_widths.get(src)
            when Option::Some(w) then
              if w != LirFpWidth::LirF32 then
                return Result::Err("thumb: " + f.name + ": f64 fp-to-gp bit move from vreg " + src.to_string() + " does not lower on the cortex-m route (the 32-bit word model has no single general register for a 64-bit image — only F32 <-> the 4-byte integer words lower; fail-closed)")
              end
            when Option::None then
              return Result::Err("thumb: " + f.name + ": fp-to-gp bit move source vreg " + src.to_string() + " has no FP class record (a fixed/ABI id or a class-table divergence — fail-closed)")
            end
            if thumb_fixed_bad(dst) then
              return Result::Err("thumb: " + f.name + ": fp-to-gp bit move destination in fixed vreg " + dst.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7 — fail-closed)")
            end
          end
        when Option::None then
          if thumb_fixed_bad(src) then
            return Result::Err("thumb: " + f.name + ": unop operand from fixed vreg " + src.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering never emits them — fail-closed)")
          end
        end
      when LirStmtKind::LirCmp(left, right) then
        match left
        when LirValue::LirReg(_) then ()
        when LirValue::LirImm(_) then
          return Result::Err("thumb: " + f.name + ": compare left operand is an immediate — lowering never produces this (fail-closed)")
        end
        match right
        when LirValue::LirReg(rv) then
          if thumb_fixed_bad(rv) then
            return Result::Err("thumb: " + f.name + ": compare operand from fixed vreg " + rv.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering never emits them — fail-closed)")
          end
        when LirValue::LirImm(imm) then
          if !thumb_imm32_ok(imm) then
            return Result::Err("thumb: " + f.name + ": compare constant " + imm.to_string() + " does not fit the 32-bit cortex-m word model [-2^31, 2^32) (this route is word-only — fail-closed)")
          end
        end
      when LirStmtKind::LirCset(_, _) then ()
      when LirStmtKind::LirLoadFrame(dst, off) then
        # The cortex-m lowering emits LirLoadFrame only at the top of
        # the entry block to bind stack-class parameters from the shared
        # AAPCS caller-word stream: a general word (or F32) at the
        # canonical payload 8 + 4*k, an F64's 8-byte unit at the EVEN
        # word base 8 + 4*k (the entry walk's width-aware arithmetic —
        # lir.tg's lir_stack_arg_offset). A fixed-vreg destination or a
        # payload outside that geometry (4-aligned, >= 8 — and
        # 8-aligned for an F64 image) marks a foreign lowering; an
        # aarch64-convention function is in any case caught by the
        # fixed-vreg 4..7 rejections (its parameter binds always trip
        # one before any LirLoadFrame is reached).
        if dst < lir_first_alloc_vreg() then
          return Result::Err("thumb: " + f.name + ": stack-parameter load into fixed vreg " + dst.to_string() + " does not lower (the cortex-m lowering loads AAPCS stack parameters into ordinary vregs only — fail-closed)")
        end
        if off < 8 || (off % 4) != 0 then
          return Result::Err("thumb: " + f.name + ": stack-parameter load at canonical offset " + off.to_string() + " does not lower — the AAPCS stack-parameter payloads of the cortex-m lowering are 8 + 4*k (fail-closed)")
        end
        match f.fp_widths.get(dst)
        when Option::Some(w) then
          if w == LirFpWidth::LirF64 && off % 8 != 0 then
            return Result::Err("thumb: " + f.name + ": F64 stack-parameter load at the odd-word offset " + off.to_string() + " does not lower — an 8-byte double image needs an 8-byte-aligned even-word base (the AAPCS32 stream's width-aware arithmetic; fail-closed)")
          end
        when Option::None then ()
        end
      when LirStmtKind::LirPushArg(vreg) then
        if vreg < lir_first_alloc_vreg() then
          return Result::Err("thumb: " + f.name + ": caller stack-argument push of fixed vreg " + vreg.to_string() + " does not lower (the cortex-m lowering pushes ordinary argument vregs only — fail-closed)")
        end
      when LirStmtKind::LirStaticLoad(dst, sym) then
        # A static-value load (a whole-program static reference — the
        # LirStaticLoad of lir.tg's MirStaticRef lowering): the 32-bit
        # word at the static's .data symbol. The destination is an
        # ordinary vreg (the shared lowering materializes loads into
        # fresh vregs or the destination local's vreg — never a fixed
        # ABI register), and the symbol must be the emission name of a
        # program static (recorded by the route's data emission before
        # function lowering).
        if dst < lir_first_alloc_vreg() then
          return Result::Err("thumb: " + f.name + ": static-value load into fixed vreg " + dst.to_string() + " does not lower (static loads define ordinary vregs only — fail-closed)")
        end
        if sym.len() == 0 then
          return Result::Err("thumb: " + f.name + ": static-value load carries an empty symbol name (the shared lowering resolves static references to emission names — a lowering divergence; fail-closed)")
        end
      when LirStmtKind::LirFMove(_, _) then
        # FLOAT statements lower on the cortex-m route in their
        # REGISTER-RESIDENT (F64) and MEMORY-RESIDENT envelopes: every FP
        # operand's register index is resolved at emission through
        # thumb_fp_def_target / thumb_fp_use_reg, which emit the width
        # slot loads/stores of memory-resident operands (spill-slot
        # segments and post-call reload records — invariant I2). An F32
        # operand is always memory-resident here — the cm allocator
        # keeps F32 out of the FP pool (d8..d13 — the M-profile single
        # aliases are s0..s31 = d0..d15 only, and the pool's doubles are
        # not re-derived as singles; F32 is memory-class on this route)
        # — so the register-resident F32 forms the resolution helpers
        # still fail closed on are allocator-invariant checks
        # (unproducible), and validation passes every float statement
        # whose lowering shape is cortex-m-native. A fixed
        # ABI FP id (8..15) in either operand is legal only at the
        # float ABI edges the route produces (parameter binds,
        # argument marshals, returns, result captures) — the emission
        # resolves it to its d-register exactly like an allocated one,
        # and an F64 register-to-register copy on an FPv4-SP FPU lowers
        # as the VPUSH/VPOP pair (no VMOV.F64 Dd, Dm exists there).
        ()
      when LirStmtKind::LirFBinop(_, w, _, _, _) then
        if w == LirFpWidth::LirF64 && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "F64 arithmetic (fadd/fsub/fmul/fdiv)"))
        end
      when LirStmtKind::LirFNeg(w, _, _) then
        if w == LirFpWidth::LirF64 && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "F64 negation"))
        end
      when LirStmtKind::LirFCmp(w, _, _) then
        if w == LirFpWidth::LirF64 && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "an F64 compare"))
        end
      when LirStmtKind::LirFConst(_, _, _) then
        # F64 constants are ADMITTED on every FPU with D registers,
        # including the single-precision FPv4-SP/FPv5-SP units: their
        # materialization is the core<->D TRANSFER path (movw/movt into
        # a GP pair + VMOV Dd, Rt, Rt2 — legal on fpv4-sp-d16), NOT the
        # F64 data-processing VMOV.F64 Dd, #imm. The capability gate for
        # constants is therefore the EMITTER's encoder choice: the
        # F64 arm consults te.f64dp and uses the immediate form only
        # when target_desc_f64_data_processing(desc) is true, so no F64
        # data-processing byte can be emitted against a single-precision
        # unit. The F32-on-an-SP-FPU partial envelope is likewise
        # enforced at emission (imm/zero lower through the transfer and
        # single-immediate forms; the general host-double rounding case
        # fails closed there with its own rule).
        ()
      when LirStmtKind::LirIntToFloat(w, _, src, _) then
        # The integer source rides a general word: a fixed vreg 4..7
        # operand marks an aarch64-convention LIR (the same fingerprint
        # the general statement arms reject).
        if w == LirFpWidth::LirF64 && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "the int -> F64 conversion (vcvt.f64.s32/vcvt.f64.u32)"))
        end
        if thumb_fixed_bad(src) then
          return Result::Err("thumb: " + f.name + ": int-to-float source from fixed vreg " + src.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering never emits them — fail-closed)")
        end
      when LirStmtKind::LirFloatToInt(w, dst, _) then
        # The integer destination rides a general word: a fixed vreg
        # 4..7 destination marks an aarch64-convention LIR.
        if w == LirFpWidth::LirF64 && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "the F64 -> int conversion (vcvt.s32.f64/vcvt.u32.f64)"))
        end
        if thumb_fixed_bad(dst) then
          return Result::Err("thumb: " + f.name + ": float-to-int into fixed vreg " + dst.to_string() + " does not lower (fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering never emits them — fail-closed)")
        end
      when LirStmtKind::LirFcvt(src_w, dst, _) then
        # An F64 side marks the double <-> single conversion class
        # (VCVT.F32.F64 / VCVT.F64.F32), which an FPv4-SP/FPv5-SP unit
        # does not implement (clang lowers these via __aeabi_f2d /
        # __aeabi_d2f on a Cortex-M4F). The destination's class record
        # is the width authority (the emitter reads the same table).
        let dw = match f.fp_widths.get(dst)
        when Option::Some(v) then v
        when Option::None then panic("thumb: LirFcvt into a vreg with no FP class record (lowering invariant)")
        end
        if (src_w == LirFpWidth::LirF64 || dw == LirFpWidth::LirF64) && !target_desc_f64_data_processing(desc) then
          return Result::Err(thumb_f64_dp_rule(desc, f.name, "the F64 <-> F32 conversion (vcvt.f32.f64/vcvt.f64.f32)"))
        end
      end
      si = si + 1
    end
    match block.term.kind
    when LirTermKind::LirCall(target, args, stack_args, _, _) then
      # AAPCS caller-word pushes: stack_args counts the 4-byte words the
      # lowering pushed for the stack-class arguments, INCLUDING the
      # F64 units' two words each and the alignment padding of
      # lir_lower_call — so it is always EVEN (the pad rule keeps the
      # caller's SP 8-byte aligned at the BL). An odd or out-of-range
      # count therefore marks a foreign lowering (a call lowered with
      # the aarch64 conventions would carry an odd 16-byte-slot count
      # whenever its slot count is odd — fail-closed; such functions are
      # in any case caught by the fixed-vreg 4..7 rejections above). The
      # bound is the 32-argument call cap's worst case: 32 two-word F64
      # units plus one interspersed pad each plus the top pad = 96 words.
      if stack_args < 0 || stack_args > 96 || (stack_args % 2) != 0 then
        return Result::Err("thumb: " + f.name + ": call to `" + target + "` carries " + stack_args.to_string() + " caller stack words — the cortex-m lowering pads odd AAPCS word counts to EVEN (lir_lower_call), so an odd or out-of-range count marks a foreign lowering (fail-closed)")
      end
      var ai = 0
      while ai < args.len() do
        if thumb_fixed_bad(args[ai]) then
          return Result::Err("thumb: " + f.name + ": call to `" + target + "` passes fixed vreg " + args[ai].to_string() + " in its argument list — fixed vregs 4..7 are aarch64 x4..x7; the cortex-m lowering pushes arguments >= 4 onto the AAPCS caller stack instead (fail-closed)")
        end
        ai = ai + 1
      end
    when _ then ()
    end
    bi = bi + 1
  end
  Result::Ok(())
end

# AUDIT §16/§26 — the AAPCS32 VARIADIC base-convention marshalling:
# a variadic extern call is made with the BASE convention — NO VFP
# CPRC: every argument (fixed prefix and §26-promoted extras alike)
# rides the general registers / caller stack as its base-type words
# (an F64 as an aligned even-odd r-pair or an 8-byte-aligned stack
# unit; an F32 extra is the promoted double). The shared LIR lowering
# (lir.tg's lir_lower_call walk) has no variadic marker and marshals
# every register-class float argument into the fixed FP vregs d0..d7,
# so the emitter RE-DERIVES the whole call's base-convention layout
# from the call term's argument list and emits the crossings itself
# (thumb_var_call_plan / thumb_emit_var_call_block below) — the
# original fixed-vreg/push marshal statements of a variadic call block
# are skipped at emission. See the planner's doc for the walk and the
# AAPCS32 rules it implements.

# ———————————————————————————————————————————————————————————————
# Emission helpers (mirroring lir.tg's allocator-query helpers)
# ———————————————————————————————————————————————————————————————

# The destination of a def at position `pos`: either the segment's
# register (via the desc-driven pool mapping) or the r12 temp with a
# pending spill-slot store.
struct ThumbDefTarget
  reg: Int
  store_slot: Int   # >= 0: store reg to this slot after the def
end

def thumb_def_target(alloc: LirAlloc, mdl_pool: Vec[Int], vreg: Int, pos: Int) -> ThumbDefTarget
  if vreg < lir_first_alloc_vreg() then
    # Fixed ABI vregs (argument moves): the register IS the target.
    return ThumbDefTarget { reg: vreg, store_slot: -1 }
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        ThumbDefTarget { reg: thumb_phys_of(mdl_pool, s.phys), store_slot: -1 }
      else
        ThumbDefTarget { reg: thumb_ip_reg(), store_slot: s.slot }
      end
    when Option::None then
      panic("thumb: def outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    # Never-occurring vreg (an unused parameter bind still emits).
    ThumbDefTarget { reg: thumb_ip_reg(), store_slot: -1 }
  end
end

# Materialize the value of `vreg` at position `pos` into a register,
# choosing `pref` (normally r12; r3 avoids a collision) when a spill
# load is needed; a reload record at (pos, vreg) loads the slot into the
# segment register first (invariant I2). Returns the register holding
# the value. Fixed vregs (0..3 only — 4..7 are rejected by validation)
# resolve to their register directly.
def thumb_emit_use(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], vreg: Int, pos: Int, pref: Int) -> Int
  if vreg < lir_first_alloc_vreg() then
    return vreg
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        if lir_reload_at(alloc.reloads, pos, vreg) then
          thumb_slot_load(te, mdl_pool, thumb_phys_of(mdl_pool, s.phys), s.slot)
        end
        thumb_phys_of(mdl_pool, s.phys)
      else
        thumb_slot_load(te, mdl_pool, pref, s.slot)
        pref
      end
    when Option::None then
      panic("thumb: use outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    panic("thumb: use of vreg with no intervals: " + vreg.to_string())
  end
end

# Load spill slot `slot` ([r7 + 4*slot]) into `dst` (any r0-r12).
def thumb_slot_load(inout te: ThumbEmit, mdl_pool: Vec[Int], dst: Int, slot: Int) -> Unit
  thumb_slot_access(te, dst, slot, true)
end

# Store `src` (any r0-r12) into spill slot `slot`.
def thumb_slot_store(inout te: ThumbEmit, mdl_pool: Vec[Int], src: Int, slot: Int) -> Unit
  thumb_slot_access(te, src, slot, false)
end

# The shared slot access: the 4-byte word [r7 + 4*slot]. 16-bit LDR/STR
# when both registers are low and the offset fits imm5*4; LDR.W/STR.W
# for byte offsets 0..4095 (any register); beyond that the address is
# built in a temp (movw; add temp, r7 — the flagless 0x4400 form) and
# the word is accessed through it. The store path must not clobber the
# value register: when the value sits in r12 (a memory-def temp), the
# address is built in r3 instead. Frames can therefore reach 65532
# bytes of slots; bigger frames fail closed in thumb_emit_fn.
def thumb_slot_access(inout te: ThumbEmit, reg: Int, slot: Int, is_load: Bool) -> Unit
  let off = thumb_slot_offset(slot)
  let fp = thumb_fp_reg()
  if is_load then
    if reg <= 7 && off <= 124 then
      t2_ldr_imm5(&mut te.buf, reg, fp, off)
    elsif off <= 4095 then
      t2_ldr_w_imm12(&mut te.buf, reg, fp, off)
    else
      t2_movw(&mut te.buf, thumb_ip_reg(), (off & 0xFFFF) as u16)
      t2_add_rr(&mut te.buf, thumb_ip_reg(), fp)
      t2_ldr_w_imm12(&mut te.buf, reg, thumb_ip_reg(), 0)
    end
  else
    let addr = if reg == thumb_ip_reg() then thumb_ip2_reg() else thumb_ip_reg() end
    if reg <= 7 && off <= 124 then
      t2_str_imm5(&mut te.buf, reg, fp, off)
    elsif off <= 4095 then
      t2_str_w_imm12(&mut te.buf, reg, fp, off)
    else
      t2_movw(&mut te.buf, addr, (off & 0xFFFF) as u16)
      t2_add_rr(&mut te.buf, addr, fp)
      t2_str_w_imm12(&mut te.buf, reg, addr, 0)
    end
  end
end

# Materialize an in-model 32-bit immediate into `rd` (MOVW + optional
# MOVT; both flagless).
def thumb_emit_imm32(inout te: ThumbEmit, rd: Int, imm: Int) -> Unit
  let low = imm & 0xFFFFFFFF
  let lo16 = (low & 0xFFFF) as u16
  let hi16 = ((low >> 16) & 0xFFFF) as u16
  t2_movw(&mut te.buf, rd, lo16)
  if hi16 != 0 then
    t2_movt(&mut te.buf, rd, hi16)
  end
end

# Load `imm` into a temp that does NOT collide with `avoid` (a resolved
# operand register): when the operand itself sits in r12 (a spill load),
# the immediate goes into r3 instead — r3 is the second statement-local
# temp, dead at every statement boundary. Returns the temp chosen.
def thumb_imm_temp_avoiding(inout te: ThumbEmit, imm: Int, avoid: Int) -> Int
  let t = if avoid == thumb_ip_reg() then thumb_ip2_reg() else thumb_ip_reg() end
  thumb_emit_imm32(te, t, imm)
  t
end

# Emit the register-register compare of `rn` against `rm` (the LirCmp —
# the ONLY flag-writing instruction outside the cset ITE blocks).
def thumb_emit_cmp_rr(inout te: ThumbEmit, rn: Int, rm: Int) -> Unit
  if rn <= 7 && rm <= 7 then
    t2_cmp_rr_lo(&mut te.buf, rn, rm)
  else
    t2_cmp_rr_any(&mut te.buf, rn, rm)
  end
end

# Compare `rn` against the immediate `imm` (validated in-model). The
# materialized immediate must not clobber `rn` (which may itself be a
# spill-loaded temp).
def thumb_emit_cmp_imm(inout te: ThumbEmit, rn: Int, imm: Int) -> Unit
  if imm >= 0 && imm <= 255 && rn <= 7 then
    t2_cmp_imm8(&mut te.buf, rn, imm)
  else
    let t = thumb_imm_temp_avoiding(te, imm, rn)
    thumb_emit_cmp_rr(te, rn, t)
  end
end

# Emit a register-register binop (all forms flagless — invariant I1).
def thumb_emit_binop_rr(inout te: ThumbEmit, op: LirBinOp, d: Int, n: Int, m: Int) -> Unit
  match op
  when LirBinOp::LirAdd then t2_add_w(&mut te.buf, d, n, m)
  when LirBinOp::LirSub then t2_sub_w(&mut te.buf, d, n, m)
  when LirBinOp::LirMul then t2_mul_w(&mut te.buf, d, n, m)
  when LirBinOp::LirAnd then t2_and_w(&mut te.buf, d, n, m)
  when LirBinOp::LirOr then t2_orr_w(&mut te.buf, d, n, m)
  when LirBinOp::LirXor then t2_eor_w(&mut te.buf, d, n, m)
  when LirBinOp::LirShl then t2_lsl_w_reg(&mut te.buf, d, n, m)
  when LirBinOp::LirAsr then t2_asr_w_reg(&mut te.buf, d, n, m)
  when LirBinOp::LirLsr then t2_lsr_w_reg(&mut te.buf, d, n, m)
  end
end

# Emit a binop with an immediate right operand. Add/Sub use ADDW/SUBW
# for 0..4095 (the flagless 32-bit immediate forms; a negative Add is a
# SUBW of the negated amount, mirroring the aarch64 emitter's strategy);
# everything else materializes the immediate into a temp that avoids the
# resolved left operand (`n`) and uses the register form. Immediate
# shift counts <= 31 use the single flagless LSL/LSR/ASR.W immediate
# encodings; counts 32..255 go through the temp + register form (counts
# >= 32 saturate by the architecture).
def thumb_emit_binop_imm(inout te: ThumbEmit, op: LirBinOp, d: Int, n: Int, imm: Int) -> Unit
  match op
  when LirBinOp::LirAdd then
    if imm >= 0 && imm <= 4095 then
      t2_addw(&mut te.buf, d, n, imm)
    elsif imm < 0 && imm >= -4095 then
      t2_subw(&mut te.buf, d, n, -imm)
    else
      let t = thumb_imm_temp_avoiding(te, imm, n)
      t2_add_w(&mut te.buf, d, n, t)
    end
  when LirBinOp::LirSub then
    if imm >= 0 && imm <= 4095 then
      t2_subw(&mut te.buf, d, n, imm)
    elsif imm < 0 && imm >= -4095 then
      t2_addw(&mut te.buf, d, n, -imm)
    else
      let t = thumb_imm_temp_avoiding(te, imm, n)
      t2_sub_w(&mut te.buf, d, n, t)
    end
  when LirBinOp::LirShl then
    if imm >= 0 && imm <= 31 then
      t2_lsl_w_imm(&mut te.buf, d, n, imm)
    else
      let t = thumb_imm_temp_avoiding(te, imm, n)
      t2_lsl_w_reg(&mut te.buf, d, n, t)
    end
  when LirBinOp::LirLsr then
    if imm >= 0 && imm <= 31 then
      t2_lsr_w_imm(&mut te.buf, d, n, imm)
    else
      let t = thumb_imm_temp_avoiding(te, imm, n)
      t2_lsr_w_reg(&mut te.buf, d, n, t)
    end
  when LirBinOp::LirAsr then
    if imm >= 0 && imm <= 31 then
      t2_asr_w_imm(&mut te.buf, d, n, imm)
    else
      let t = thumb_imm_temp_avoiding(te, imm, n)
      t2_asr_w_reg(&mut te.buf, d, n, t)
    end
  when _ then
    let t = thumb_imm_temp_avoiding(te, imm, n)
    thumb_emit_binop_rr(te, op, d, n, t)
  end
end

# The prefer-register for a second operand given the register the first
# operand landed in (avoid the r12/r3 temp collision).
def thumb_alt_pref(used: Int) -> Int
  if used == thumb_ip_reg() then thumb_ip2_reg() else thumb_ip_reg() end
end

# ———————————————————————————————————————————————————————————————
# Branch emission (relaxation-lite; see the emitter-state note)
# ———————————————————————————————————————————————————————————————

# The target label's offset, when the block has already been emitted
# (backward branches only — resolution handles the rest).
def thumb_label_off(te: ThumbEmit, label: String) -> Option[Int]
  te.buf.labels.get(label)
end

# An unconditional branch to `label`. Backward targets that fit the
# 16-bit B emit directly (2 bytes); everything else emits B.W with a
# deferred patch (4 bytes, +/-16 MiB — no legitimate function overflows).
def thumb_emit_b_uncond(inout te: ThumbEmit, label: String) -> Unit
  let pos = buf_pos(&te.buf)
  match thumb_label_off(te, label)
  when Option::Some(target) then
    let rel = target - (pos + 4)
    if rel >= -2048 && rel <= 2046 then
      t2_b16(&mut te.buf, rel)
    else
      let patch_pos = buf_pos(&te.buf)
      t2_b_w(&mut te.buf, 0)
      te.patches.push(ThumbPatch { offset: patch_pos, label: label, is_bl: false })
    end
  when Option::None then
    let patch_pos = buf_pos(&te.buf)
    t2_b_w(&mut te.buf, 0)
    te.patches.push(ThumbPatch { offset: patch_pos, label: label, is_bl: false })
  end
end

# A conditional branch (cond true) to `label`. Backward targets within
# the 16-bit B.cond range emit directly; everything else emits the
# invert-and-skip pattern: B<not cond> +2 (always in range) followed by
# a patched B.W. The pattern never needs a conditional-range check.
def thumb_emit_b_cond(inout te: ThumbEmit, cond: Int, label: String) -> Unit
  let pos = buf_pos(&te.buf)
  match thumb_label_off(te, label)
  when Option::Some(target) then
    let rel = target - (pos + 4)
    if rel >= -256 && rel <= 254 then
      t2_b_cond16(&mut te.buf, cond, rel)
    else
      thumb_emit_b_cond_far(te, cond, label)
    end
  when Option::None then
    thumb_emit_b_cond_far(te, cond, label)
  end
end

def thumb_emit_b_cond_far(inout te: ThumbEmit, cond: Int, label: String) -> Unit
  t2_b_cond16(&mut te.buf, cond ^ 1, 2)
  let patch_pos = buf_pos(&te.buf)
  t2_b_w(&mut te.buf, 0)
  te.patches.push(ThumbPatch { offset: patch_pos, label: label, is_bl: false })
end

# A direct call to `label`: patched B.W-style BL for program functions,
# a relocation-carrying BL placeholder for externs (the object file's
# R_ARM_THM_CALL record patches the same field).
def thumb_emit_bl(inout te: ThumbEmit, label: String, is_extern: Bool) -> Unit
  let patch_pos = buf_pos(&te.buf)
  if is_extern then
    t2_bl(&mut te.buf, 0)
    te.relocs.push(ThumbReloc { offset: patch_pos, sym: label, kind: thumb_reloc_call() })
  else
    t2_bl(&mut te.buf, 0)
    te.patches.push(ThumbPatch { offset: patch_pos, label: label, is_bl: true })
  end
end

# The epilogue: release the frame, restore the FP callee-save block
# (when the prologue emitted one), restore the general callee-saved
# registers, then return. SP equals the frame pointer's frame top
# (r7 + frame_bytes) at every Ret — the AAPCS caller-word pushes of a
# call site are undone by that call's own SP cleanup right after the
# BL, so no push ever survives to a block boundary.
# (AUDIT §16 — for an @interrupt function this is the NVIC handler
# exit: the POP restores the callee-saved body registers AND the
# pushed entry LR — the EXC_RETURN holder, saved by the prologue
# before any BL could clobber LR — back into LR, and the BX LR then
# executes the desc's exit rule: the hardware un-stacks the exception
# frame and resumes the preempted context. The instruction sequence
# is identical for ordinary functions — their pushed LR holds the
# BL-supplied return address.)
# FP CALLEE-SAVES (the M-profile d8..d15 block): when the prologue
# emitted VPUSH {d8-d15} (te.fp_save — the function carries FP content
# on an FPU-carrying descriptor), the VPOP here restores it AFTER the
# frame release and BEFORE the GP POP, exactly the reverse of the
# prologue order (GP PUSH; VPUSH; frame build) — so SP is back at the
# VPUSH base when the 64-byte pop runs and the GP POP then restores
# the entry SP. The block covers the allocatable pool d8..d13 AND the
# d14/d15 statement scratches, which are callee-saved under AAPCS32.
def thumb_emit_epilogue(inout te: ThumbEmit, frame_bytes: Int) -> Unit
  if frame_bytes > 0 then
    if frame_bytes <= 508 then
      t2_add_sp_imm7(&mut te.buf, frame_bytes)
    else
      t2_movw(&mut te.buf, thumb_ip_reg(), (frame_bytes & 0xFFFF) as u16)
      t2_add_sp_w_reg(&mut te.buf, thumb_ip_reg())
    end
  end
  if te.fp_save then
    t2_vpop_d(&mut te.buf, 8, 8)
  end
  t2_pop_w(&mut te.buf, thumb_saved_reg_list())
  t2_bx_lr(&mut te.buf)
end

# ———————————————————————————————————————————————————————————————
# Statement and terminator emission (mirrors lir_emit_stmt/term)
# ———————————————————————————————————————————————————————————————
# Every arm is explicit; constructs outside the validated subset return
# Err naming the construct (validation already rejected them — the arms
# are defense in depth and never silently emit).

# ———————————————————————————————————————————————————————————————
# Float statement resolution (register- and memory-resident operands)
# ———————————————————————————————————————————————————————————————
# Every float arm below resolves each FP operand through the two
# helpers of this section — thumb_fp_def_target on the def side,
# thumb_fp_use_reg on the use side — over the FULL residency envelope
# (the register-resident-only envelope of the former thumb_fp_d_of is
# gone):
#   - a fixed ABI FP id (8..15 — lir_is_fixed_fp_id) IS its d-register
#     (d-index = id - lir_fixed_fp_base()); an allocated FP vreg's
#     physical id (108..113 — the allocator's cm FP-pool namespace,
#     lir_fp_pool_regs_cm) is d_{phys - 100};
#   - the helpers speak the statement width's REGISTER INDEX SPACE: a
#     d-index under F64, a SINGLE index (s = 2*d — the canonical low
#     single of the d-index) under F32. An F32 value rides the LOW
#     single of its d-index. The FP pool (d8..d13, the encodable
#     callee-saved M-profile doubles) has no
#     single-register alias on the cortex-m register model (s0..s31 —
#     d0..d15 — only), so F32 values are MEMORY-CLASS on this route:
#     the cm allocator (lir_alloc_registers_cm — f32_pool_ok = false)
#     never assigns an F32 vreg a pool register — every F32 segment is
#     phys = -1 with its width-correct one-word slot, and every F32
#     statement lowers load-op-store through the scratch singles
#     below. The register-resident F32 arms that remain fail closed as
#     allocator-invariant checks (their state is now unproducible);
#   - a memory-resident USE (a segment whose physical id is negative)
#     emits its width load through thumb_slot_fp_load into one of the
#     two statement scratches the caller picks (the aarch64 route's
#     V30/V31 first/second-pref pattern — a statement needs the second
#     scratch only when two of its operands are memory-resident at
#     once); a REGISTER-resident segment whose first post-call read
#     carries a reload record at (pos, vreg) (invariant I2) restores
#     its OWN register from the slot at the width — the segment's
#     later reload-free reads ride the register, exactly like the
#     general-register thumb_emit_use;
#   - a memory-resident DEF computes into the def scratch (d15 — its
#     low single s30 under F32 — ThumbFpDefTarget.reg) and the arm
#     stores the image to the def slot at the width (thumb_slot_fp_store)
#     after the statement's op, mirroring the general def target's
#     r12-temp pattern. The cm allocator's width-aware slot geometry
#     (LirAlloc.slot_words: an F64 image's home is TWO 4-byte words at
#     an even — 8-byte-aligned — base; F32/GP images one word) makes
#     the 8-byte F64 load/store exact.
# `role` words an operand for the Err text ("binop destination",
# "compare left operand", ...), exactly as before.

# The FP-file scratch registers of the float statement arms: d15 —
# whose LOW single is s30 (s = 2*d, the canonical single, encodable by
# every single-form VFP encoder) — and d14 — whose LOW single is s28.
# Both are free at every statement position by construction of the
# register model: the fixed ABI FP ids are d0..d7 and the allocator's
# M-profile FP pool is lir_fp_pool_regs_cm() — d8..d13 (physical ids
# 100+8..100+13) — so d14/d15 are deliberately OUTSIDE the pool and
# stay statement-local scratch on this route, exactly like r12/r3 on
# the general side. They are callee-saved under AAPCS32 (s28..s31),
# and the prologue/epilogue of every FP-content function saves and
# restores the WHOLE d8..d15 block with VPUSH/VPOP {d8-d15}
# (te.fp_save), so the scratch use is ABI-transparent. The roles
# mirror the aarch64 route's V30/V31 split (lir.tg's lir_fp_def_temp /
# lir_fp_use_temp): d15 is the DEF scratch — the def temp of a
# memory-resident def, the conversion register of the int<->float
# statements (VCVT reads/writes single registers only) and the
# double-materialization target of the F32 constant path (the fcvt
# s, d rounding source where the F64 data processing is available) —
# and d14 is the SECOND scratch a second memory-resident operand loads
# into.
def thumb_fp_scratch_d() -> Int = 15
def thumb_fp_scratch_s() -> Int = 30
def thumb_fp_scratch2_d() -> Int = 14
def thumb_fp_scratch2_s() -> Int = 28

# The width's def scratch and second load scratch, in the width's
# register index space: d15/s30 and d14/s28 respectively (a d-index
# under F64, a single index under F32).
def thumb_fp_def_scratch(w: LirFpWidth) -> Int
  if w == LirFpWidth::LirF32 then thumb_fp_scratch_s() else thumb_fp_scratch_d() end
end

def thumb_fp_use_scratch(w: LirFpWidth) -> Int
  if w == LirFpWidth::LirF32 then thumb_fp_scratch2_s() else thumb_fp_scratch2_d() end
end

# Copy FP register `src` to `dst` (both in the width's register index
# space: d-indices under F64, s-indices under F32). F32 and the F64
# data-processing-capable FPUs (FPv5-D16 / the a64 / x86 / RVD
# routes) use the register-move form VMOV.F32 / VMOV.F64. On an
# FPv4-SP/FPv5-SP FPU (te.f64dp false) there is NO VMOV.F64 Dd, Dm in
# the instruction set — LLVM's fpv4-sp-d16 feature model rejects it
# and clang lowers double copies through the general registers — so an
# F64 register copy rides the stack with the verified 64-bit
# VPUSH/VPOP pair (t2_vpush_d src; t2_vpop_d dst), a load/store-only
# sequence the single-precision FPU does encode. The pair is
# SP-balanced and 8-byte aligned, so it is safe at every statement
# position including the AAPCS argument-marshaling moves.
def thumb_fp_reg_copy(inout te: ThumbEmit, w: LirFpWidth, dst: Int, src: Int) -> Unit
  if w == LirFpWidth::LirF32 then
    t2_vmov_f32(&mut te.buf, dst, src)
  elsif te.f64dp then
    t2_vmov_f64(&mut te.buf, dst, src)
  else
    t2_vpush_d(&mut te.buf, src, 1)
    t2_vpop_d(&mut te.buf, dst, 1)
  end
end

# The load-scratch choice of a statement (mirrors lir.tg's
# lir_fp_first_pref / lir_fp_second_pref): a statement's FIRST
# memory-resident operand loads into the def scratch when the def
# target does not occupy it, and into the second scratch otherwise; a
# SECOND memory-resident operand loads into the OTHER scratch. Reads
# always precede the def write within the single op, so a load may
# reuse the def scratch exactly as the aarch64 route reuses V30.
def thumb_fp_first_pref(dt_reg: Int, w: LirFpWidth) -> Int
  if dt_reg == thumb_fp_def_scratch(w) then thumb_fp_use_scratch(w) else thumb_fp_def_scratch(w) end
end

def thumb_fp_second_pref(first: Int, w: LirFpWidth) -> Int
  if first == thumb_fp_def_scratch(w) then thumb_fp_use_scratch(w) else thumb_fp_def_scratch(w) end
end

# The width-space register index of a fixed ABI FP id (8..15): the
# d-index id - lir_fixed_fp_base() under F64, its canonical low single
# (s = 2*d-index) under F32.
def thumb_fp_idx_of_fixed(vreg: Int, w: LirFpWidth) -> Int
  let d = vreg - lir_fixed_fp_base()
  if w == LirFpWidth::LirF32 then 2 * d else d end
end

# The d-register index of an allocated FP pool physical id (the
# 100+code namespace), VALIDATED against the cm pool: the cortex-m
# allocator allocates register-resident FP values ONLY from
# lir_fp_pool_regs_cm() — d8..d13, physical ids 108..113 (the
# encodable, AAPCS-callee-saved doubles of the M-profile file; d0..d7
# are the fixed ABI file and d14/d15 the statement scratches). Any
# other physical id must FAIL CLOSED here — the emitter never encodes
# an operand outside the pool no matter what the pool seam hands it
# (the aarch64 d16..d29 namespace the pre-slice cm route wrongly
# reused is the motivating case).
def thumb_fp_pool_d(phys: Int, role: String) -> Result[Int, String]
  let code = phys - 100
  if code < 8 || code > 13 then
    Result::Err("thumb: " + role + " is register-resident in physical " + phys.to_string() + ", outside the cm FP pool (d8..d13 — physical ids 108..113; the M-profile encodable allocatable doubles — the pre-slice route reused the aarch64 d16..d29 pool; fail-closed)")
  else
    Result::Ok(code)
  end
end

# The FP destination target of a def at position `pos` (the float
# counterpart of ThumbDefTarget, in the statement width's register
# index space): a fixed ABI FP id IS its register; an allocated
# register-resident segment is its pool d-register (an F64 d-index —
# an F32 never has one: the cm allocator keeps F32 values out of the
# FP pool — memory-class — so a register-resident F32 here marks an
# allocator-invariant violation and fails closed below); a
# memory-resident segment is the width's def scratch (d15 — its low
# single s30 under F32) with a pending width store to the def slot.
struct ThumbFpDefTarget
  reg: Int
  store_slot: Int   # >= 0: store reg to this slot after the def
end

def thumb_fp_def_target(alloc: LirAlloc, w: LirFpWidth, vreg: Int, pos: Int, role: String) -> Result[ThumbFpDefTarget, String]
  if lir_is_fixed_fp_id(vreg) then
    return Result::Ok(ThumbFpDefTarget { reg: thumb_fp_idx_of_fixed(vreg, w), store_slot: -1 })
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        if w == LirFpWidth::LirF32 then
          return Result::Err("thumb: F32 " + role + " vreg " + vreg.to_string() + " in an allocated FP-pool register (d8..d13) does not lower on the cortex-m route (no single-register alias above d15); the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 marks an allocator-invariant violation (fail-closed)")
        end
        let dd = match thumb_fp_pool_d(s.phys, "the " + role + " vreg " + vreg.to_string())
        when Result::Ok(d) then d
        when Result::Err(e) then return Result::Err(e)
        end
        Result::Ok(ThumbFpDefTarget { reg: dd, store_slot: -1 })
      else
        Result::Ok(ThumbFpDefTarget { reg: thumb_fp_def_scratch(w), store_slot: s.slot })
      end
    when Option::None then
      Result::Err("thumb: float " + role + " vreg " + vreg.to_string() + " has no segment at position " + pos.to_string() + " (fail-closed)")
    end
  when Option::None then
    Result::Err("thumb: float " + role + " vreg " + vreg.to_string() + " has no intervals (fail-closed)")
  end
end

# Resolve the register index of an FP vreg USE at `pos` (width `w`),
# emitting the width load a memory-resident value needs: a spill-slot
# use loads through thumb_slot_fp_load into `pref` (a statement
# scratch chosen by the caller — thumb_fp_first_pref /
# thumb_fp_second_pref); a register-resident segment whose first post-
# call read carries a reload record at (pos, vreg) (invariant I2)
# restores its OWN register from the slot at the width (later reads
# ride the register — the general-register thumb_emit_use pattern).
# Fails closed — never emitting a partial load — for an F32 value
# resident in the FP pool (d8..d13), whose register has no single-
# register alias on the cortex-m register model (s0..s31 = d0..d15
# only); the cm allocator never produces such a segment (F32 is
# memory-class on this route), so the arm doubles as an
# allocator-invariant check.
def thumb_fp_use_reg(inout te: ThumbEmit, alloc: LirAlloc, w: LirFpWidth, vreg: Int, pos: Int, pref: Int, role: String) -> Result[Int, String]
  if lir_is_fixed_fp_id(vreg) then
    return Result::Ok(thumb_fp_idx_of_fixed(vreg, w))
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        if w == LirFpWidth::LirF32 then
          return Result::Err("thumb: F32 " + role + " vreg " + vreg.to_string() + " in an allocated FP-pool register (d8..d13) does not lower on the cortex-m route (no single-register alias above d15); the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 marks an allocator-invariant violation (fail-closed)")
        end
        let dd = match thumb_fp_pool_d(s.phys, "the " + role + " vreg " + vreg.to_string())
        when Result::Ok(d) then d
        when Result::Err(e) then return Result::Err(e)
        end
        if lir_reload_at(alloc.reloads, pos, vreg) then
          thumb_slot_fp_load(te, w, dd, s.slot)
        end
        Result::Ok(dd)
      else
        thumb_slot_fp_load(te, w, pref, s.slot)
        Result::Ok(pref)
      end
    when Option::None then
      Result::Err("thumb: float " + role + " vreg " + vreg.to_string() + " has no segment at position " + pos.to_string() + " (fail-closed)")
    end
  when Option::None then
    Result::Err("thumb: float " + role + " vreg " + vreg.to_string() + " has no intervals (fail-closed)")
  end
end

# ———————————————————————————————————————————————————————————————
# Float ABI crossing memory forms (Ret / call-result / stack-parameter)
# ———————————————————————————————————————————————————————————————
# The float-return, float-call-result and float-stack-parameter arms
# below are the width-aware memory forms of the cm float ABI crossings
# (the aarch64 route's lir_emit_fp_mem8 counterparts): every one loads
# or stores the value at its width — 8 bytes for an F64 (t2_vldr_f64 /
# t2_vstr_f64), 4 bytes for an F32 canonical single (t2_vldr_f32 /
# t2_vstr_f32). The address is [r7 + off] with off a 4-aligned
# non-negative byte offset: a translated AAPCS stack-parameter offset
# (thumb_stack_param_off: off + frame_bytes + 24, plus the 64-byte FP
# callee-save bias when the function carries FP content — the incoming
# caller area sits above the frame and the VPUSH, see the LirLoadFrame
# arm) or a spill-slot offset (4*slot).
# VLDR/VSTR's immediate range is -1020..1020; beyond it the address is
# built in r12 (movw; add r12, r7 — the flagless 0x4400 form, the
# thumb_slot_access address path). A VFP memory operand never collides
# with the core address temp (the value rides the FP file), so r12 is
# safe on both the load and the store path. Every form is FLAGLESS
# (invariant I1).

# The width-dispatched load/store of `reg` — a d-index under F64, an
# s-index under F32 — at the machine offset `off` from the frame
# pointer. `off` must be a 4-aligned 0..0xFFFF byte offset (callers
# fail closed beyond the 16-bit address model, mirroring the GP arm).
def thumb_fp_mem_r7(inout te: ThumbEmit, w: LirFpWidth, reg: Int, off: Int, is_load: Bool) -> Unit
  let fp = thumb_fp_reg()
  if off <= 1020 then
    match w
    when LirFpWidth::LirF32 then
      if is_load then
        t2_vldr_f32(&mut te.buf, reg, fp, off)
      else
        t2_vstr_f32(&mut te.buf, reg, fp, off)
      end
    when LirFpWidth::LirF64 then
      if is_load then
        t2_vldr_f64(&mut te.buf, reg, fp, off)
      else
        t2_vstr_f64(&mut te.buf, reg, fp, off)
      end
    end
  else
    t2_movw(&mut te.buf, thumb_ip_reg(), (off & 0xFFFF) as u16)
    t2_add_rr(&mut te.buf, thumb_ip_reg(), fp)
    match w
    when LirFpWidth::LirF32 then
      if is_load then
        t2_vldr_f32(&mut te.buf, reg, thumb_ip_reg(), 0)
      else
        t2_vstr_f32(&mut te.buf, reg, thumb_ip_reg(), 0)
      end
    when LirFpWidth::LirF64 then
      if is_load then
        t2_vldr_f64(&mut te.buf, reg, thumb_ip_reg(), 0)
      else
        t2_vstr_f64(&mut te.buf, reg, thumb_ip_reg(), 0)
      end
    end
  end
end

# Load the spill slot of `slot` into `reg` at width `w`.
def thumb_slot_fp_load(inout te: ThumbEmit, w: LirFpWidth, reg: Int, slot: Int) -> Unit
  thumb_fp_mem_r7(te, w, reg, thumb_slot_offset(slot), true)
end

# Store `reg` into the spill slot of `slot` at width `w`.
def thumb_slot_fp_store(inout te: ThumbEmit, w: LirFpWidth, reg: Int, slot: Int) -> Unit
  thumb_fp_mem_r7(te, w, reg, thumb_slot_offset(slot), false)
end

# ———————————————————————————————————————————————————————————————
# Register-class bit moves (int <-> float transmutes) — cortex-m
# ———————————————————————————————————————————————————————————————
# A bm-marked statement (LirStmt.bm — the float slice's int<->float
# TRANSMUTE carrier, riding the arity-exact LirUnop shape) lowers on the
# cortex-m route as the VFP core<->FP transfer pair, mirroring the
# aarch64 FMOV bit semantics EXACTLY (the bit pattern crosses untouched:
# no conversion, no rounding):
#   LirBitsGpToFp — VMOV Sd, Rt (t2_vmov_gp_to_s): the general word's
#     32 bits become the F32 canonical single;
#   LirBitsFpToGp — VMOV Rt, Sd (t2_vmov_s_to_gp): the single's 32 bits
#     land in the general word (the word is 32 bits on this route — no
#     zero-extension question exists, unlike the aarch64 W-form).
# The width resolves from the FP side's class record (alloc.fp_widths).
# ONLY F32 pairs exist at this word model: an F64 bit image would need
# the two-register forms (VMOV Dd, Rt, Rt2 / VMOV Rt, Rt2, Dd — both
# encoders exist) but the LIR carrier has ONE general operand and the
# cortex-m machine word is 4 bytes, so a 64-bit pattern has no single
# general-register home; the lowering rejects those pairs with the
# word-model rule before any statement is built, and this arm fails
# closed defensively. The FP def/use rides the ordinary float
# resolution: a def (always a memory-class F32 on this route) computes
# into the def scratch and stores its image at the width; a use loads
# its slot at the width into the second scratch first.
def thumb_emit_bitmove_stmt(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], stmt: LirStmt, bmop: LirBitMoveOp, pos: Int) -> Result[Unit, String]
  match stmt.kind
  when LirStmtKind::LirUnop(_, dst, src) then
    match bmop
    when LirBitMoveOp::LirBitsGpToFp then
      let w = match alloc.fp_widths.get(dst)
      when Option::Some(v) then v
      when Option::None then
        return Result::Err("thumb: gp-to-fp bit move into vreg " + dst.to_string() + " with no FP class record (the class table is the authority — lowering invariant, fail-closed)")
      end
      if w != LirFpWidth::LirF32 then
        return Result::Err("thumb: f64 gp-to-fp bit move does not lower on the cortex-m route — the 32-bit word model has no single general register that can hold an F64 bit image (the two-word VMOV Dd, Rt, Rt2 form has no LIR carrier); only F32 <-> the 4-byte integer words lower (fail-closed)")
      end
      let dt = match thumb_fp_def_target(alloc, w, dst, pos, "bit-move destination")
      when Result::Ok(t) then t
      when Result::Err(e) then return Result::Err(e)
      end
      let sr = thumb_emit_use(te, alloc, mdl_pool, src, pos, thumb_ip_reg())
      t2_vmov_gp_to_s(&mut te.buf, sr, dt.reg)
      if dt.store_slot >= 0 then
        thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
      end
      Result::Ok(())
    when LirBitMoveOp::LirBitsFpToGp then
      let w = match alloc.fp_widths.get(src)
      when Option::Some(v) then v
      when Option::None then
        return Result::Err("thumb: fp-to-gp bit move from vreg " + src.to_string() + " with no FP class record (the class table is the authority — lowering invariant, fail-closed)")
      end
      if w != LirFpWidth::LirF32 then
        return Result::Err("thumb: f64 fp-to-gp bit move does not lower on the cortex-m route — the 32-bit word model has no single general register that can hold an F64 bit image (the two-word VMOV Rt, Rt2, Dd form has no LIR carrier); only F32 <-> the 4-byte integer words lower (fail-closed)")
      end
      let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
      let sm = match thumb_fp_use_reg(te, alloc, w, src, pos, thumb_fp_use_scratch(w), "bit-move source")
      when Result::Ok(r) then r
      when Result::Err(e) then return Result::Err(e)
      end
      t2_vmov_s_to_gp(&mut te.buf, dt.reg, sm)
      if dt.store_slot >= 0 then
        thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
      end
      Result::Ok(())
    end
  when _ then
    return Result::Err("thumb: bit-move marker on a non-LirUnop carrier (the marker rides the arity-exact LirUnop shape — lowering invariant, fail-closed)")
  end
end

# Emit one LIR statement of a cortex-m function. A statement carrying a
# marked LirPtrOp (LirStmt.ptr — the pointer/atomic statements of the
# cortex-m atomic surface) emits through the pointer/atomic arms (the
# ARMv7-M exclusive/barrier/width sequences of thumb_emit_ptr_stmt) —
# NEVER through its nominal kind's semantics (the nominal kinds are
# arity-nearest carriers only; see LirStmt.ptr); a statement carrying a
# marked LirBitMoveOp (LirStmt.bm — the int<->float transmute) emits
# through thumb_emit_bitmove_stmt; every other statement emits through
# the nominal-kind arms of thumb_emit_stmt_kind.
def thumb_emit_stmt(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], frame_bytes: Int, fn_name: String, stmt: LirStmt, pos: Int) -> Result[Unit, String]
  match stmt.ptr
  when Option::Some(pop) then
    thumb_emit_ptr_stmt(te, alloc, mdl_pool, fn_name, stmt, pop, pos)
  when Option::None then
    match stmt.bm
    when Option::Some(bmop) then
      thumb_emit_bitmove_stmt(te, alloc, mdl_pool, stmt, bmop, pos)
    when Option::None then
      thumb_emit_stmt_kind(te, alloc, mdl_pool, frame_bytes, stmt.kind, pos)
    end
  end
end

def thumb_emit_stmt_kind(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], frame_bytes: Int, kind: LirStmtKind, pos: Int) -> Result[Unit, String]
  match kind
  when LirStmtKind::LirMove(dst, val) then
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    match val
    when LirValue::LirImm(imm) then
      thumb_emit_imm32(te, dt.reg, imm)
    when LirValue::LirReg(src) then
      if src < lir_first_alloc_vreg() then
        if dt.reg != src then
          t2_mov_rr(&mut te.buf, dt.reg, src)
        end
      else
        let pref = thumb_alt_pref(dt.reg)
        let sr = thumb_emit_use(te, alloc, mdl_pool, src, pos, pref)
        if dt.reg != sr then
          t2_mov_rr(&mut te.buf, dt.reg, sr)
        end
      end
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirBinop(op, dst, left, right) then
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    let left_pref = thumb_alt_pref(dt.reg)
    let left_reg = match left
    when LirValue::LirReg(lv) then thumb_emit_use(te, alloc, mdl_pool, lv, pos, left_pref)
    when LirValue::LirImm(_) then panic("thumb: binop left operand must be a register (lowering invariant)")
    end
    match right
    when LirValue::LirImm(imm) then
      thumb_emit_binop_imm(te, op, dt.reg, left_reg, imm)
    when LirValue::LirReg(rv) then
      # A register right operand: resolve it with a temp that avoids the
      # left temp (they only collide when both spill-load; a single
      # instruction reads both before writing dt, so a dst-temp reuse is
      # safe by read-before-write).
      let right_pref = thumb_alt_pref(left_reg)
      let right_reg = thumb_emit_use(te, alloc, mdl_pool, rv, pos, right_pref)
      thumb_emit_binop_rr(te, op, dt.reg, left_reg, right_reg)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirUnop(op, dst, src) then
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    let pref = thumb_alt_pref(dt.reg)
    let sr = thumb_emit_use(te, alloc, mdl_pool, src, pos, pref)
    match op
    when LirUnOp::LirNeg then t2_neg_w(&mut te.buf, dt.reg, sr)
    when LirUnOp::LirBitNot then t2_mvn_w(&mut te.buf, dt.reg, sr)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirCmp(left, right) then
    let left_reg = match left
    when LirValue::LirReg(lv) then thumb_emit_use(te, alloc, mdl_pool, lv, pos, thumb_ip_reg())
    when LirValue::LirImm(_) then panic("thumb: cmp left operand must be a register (lowering invariant)")
    end
    match right
    when LirValue::LirImm(imm) then
      thumb_emit_cmp_imm(te, left_reg, imm)
    when LirValue::LirReg(rv) then
      let right_pref = thumb_alt_pref(left_reg)
      let right_reg = thumb_emit_use(te, alloc, mdl_pool, rv, pos, right_pref)
      thumb_emit_cmp_rr(te, left_reg, right_reg)
    end
    Result::Ok(())
  when LirStmtKind::LirCset(cond, dst) then
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    let code = thumb_cc(cond)
    # ITE <cond>: the next two instructions run on cond and NOT cond.
    # The two MOVS are the only flag-writing instructions outside the
    # LirCmp statements (invariant I1): they run AFTER the Cmp's
    # consumer read the flags, and nothing may read flags again before
    # the next LirCmp writes them.
    t2_ite(&mut te.buf, code)
    if dt.reg <= 7 then
      t2_movs_imm8(&mut te.buf, dt.reg, 1)
      t2_movs_imm8(&mut te.buf, dt.reg, 0)
    else
      # High registers have no 16-bit MOVS; the 32-bit MOVW is legal
      # inside an IT block.
      t2_movw(&mut te.buf, dt.reg, 1)
      t2_movw(&mut te.buf, dt.reg, 0)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirLoadFrame(dst, off) then
    # AAPCS stack-parameter load (function entry binds of parameter
    # indexes >= 4): the 4-byte word at the AAPCS-canonical offset
    # [fp + off], fp = incoming SP minus the {fp,lr} 8-byte push — i.e.
    # at incoming-SP + (off - 8). This backend's r7 sits at
    # incoming-SP - 32 (the {r4-r10, lr} push) - frame_bytes (the local
    # frame), so the machine offset from r7 is:
    #     (incoming-SP + off - 8) - r7
    #   = (incoming-SP + off - 8) - (incoming-SP - 32 - frame_bytes)
    #   = off + frame_bytes + 24
    # (checked against the layout: argument i sits at r7 + 32 +
    # frame_bytes + 4*(i-4), and off - 8 = 4*(i-4) — identical). An
    # FP-content function (te.fp_save) inserts VPUSH {d8-d15} (64
    # bytes) between the GP push and the frame, so r7 sits 64 bytes
    # LOWER for the same incoming SP: the translation adds the same
    # 64-byte bias (thumb_stack_param_off) — otherwise every stack
    # parameter of an FP function would read 64 bytes too low (its own
    # saved scratch/pool registers instead of the caller's argument).
    # The load is a plain word load through r7 (flagless, invariant I1);
    # only ever emitted at the top of the entry block, where the
    # prologue has already established r7.
    #
    # Since the cm float-ABI slice (lir.tg's entry-binding walk under
    # the AAPCS32 mode) a FLOAT stack parameter — a float parameter at
    # FP position >= 8, beyond the d0..d7 file — binds through this
    # same statement shape with an FP-class dst (the parameter's
    # ordinary vreg in alloc.fp_widths, the width record): the caller
    # laid the value down at its WIDTH on the shared caller-stack
    # stream (VSTR.F32 = 4 bytes / VSTR.F64 = 8 bytes at the width-
    # aware AAPCS32 float offset, 8 + 4*stk with an F64 unit padded to
    # an even word index — so the translated machine offset is 8-byte
    # aligned exactly when the load is 8 bytes wide), and the load
    # reads that width. The FP-dst guard therefore precedes the
    # general-word arm below and mirrors the aarch64 LirLoadFrame arm
    # (lir.tg), defining the parameter vreg exactly like that arm: a
    # register-resident dst loads straight into its d-register; a
    # memory-resident dst loads at the width through the FP scratch
    # (d15 — its low single s30 under F32 — free at the entry binds:
    # never allocated on any route) and stores the image to its slot.
    # The F32 single of a d-index is its low half (s = 2*d) — the same
    # alias rule every F32 arm guards: the cm allocator keeps F32
    # values OUT of the FP pool (d8..d13 has no re-derived
    # single-register alias — F32 is memory-class on this route), so an
    # F32
    # register-resident destination below marks an allocator-invariant
    # violation and fails closed.
    match alloc.fp_widths.get(dst)
    when Option::Some(w) then
      let foff = thumb_stack_param_off(off, frame_bytes, te.fp_save)
      if foff > 65535 then
        return Result::Err("thumb: stack-parameter load at machine offset [r7 + " + foff.to_string() + "] exceeds the 16-bit frame-address model of the cortex-m backend (fail-closed)")
      end
      match alloc.segs_of.get(dst)
      when Option::Some(segs) then
        match lir_seg_at(segs, pos)
        when Option::Some(s) then
          if s.phys >= 0 then
            match w
            when LirFpWidth::LirF32 then
              return Result::Err("thumb: F32 stack-parameter load into an allocated FP-pool register (d8..d13) does not lower on the cortex-m route (no single-register alias above d15); the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 destination marks an allocator-invariant violation (fail-closed)")
            when LirFpWidth::LirF64 then
              let dd = match thumb_fp_pool_d(s.phys, "the stack-parameter destination vreg " + dst.to_string())
              when Result::Ok(d) then d
              when Result::Err(e) then return Result::Err(e)
              end
              thumb_fp_mem_r7(te, w, dd, foff, true)
            end
          else
            # Memory-resident dst: load at the width into the FP
            # scratch, then store the image to the def slot at the
            # width. An F32's image is the canonical single's 4 bytes —
            # the slot's exact word — so the single-form store is
            # exact. An F64's 8-byte image rides the two-word
            # 8-byte-aligned slot home the cm allocator reserves for
            # F64-class vregs (LirAlloc.slot_words), so the double-form
            # store is exact too.
            match w
            when LirFpWidth::LirF32 then
              thumb_fp_mem_r7(te, w, thumb_fp_scratch_s(), foff, true)
              thumb_slot_fp_store(te, w, thumb_fp_scratch_s(), s.slot)
            when LirFpWidth::LirF64 then
              thumb_fp_mem_r7(te, w, thumb_fp_scratch_d(), foff, true)
              thumb_slot_fp_store(te, w, thumb_fp_scratch_d(), s.slot)
            end
          end
        when Option::None then
          return Result::Err("thumb: stack-parameter load destination vreg " + dst.to_string() + " has no segment at position " + pos.to_string() + " (the cortex-m route emits entry binds with a segment at every def position — fail-closed)")
        end
      when Option::None then
        return Result::Err("thumb: stack-parameter load destination vreg " + dst.to_string() + " has no intervals (fail-closed)")
      end
      Result::Ok(())
    when Option::None then
      let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
      let foff = thumb_stack_param_off(off, frame_bytes, te.fp_save)
      if foff > 65535 then
        return Result::Err("thumb: stack-parameter load at machine offset [r7 + " + foff.to_string() + "] exceeds the 16-bit frame-address model of the cortex-m backend (fail-closed)")
      end
      let fp = thumb_fp_reg()
      if dt.reg <= 7 && foff <= 124 then
        t2_ldr_imm5(&mut te.buf, dt.reg, fp, foff)
      elsif foff <= 4095 then
        t2_ldr_w_imm12(&mut te.buf, dt.reg, fp, foff)
      else
        # Large offset: address = r7 + foff in r12 (the load temp). A
        # memory-resident def target IS r12: the final load reads the
        # address before overwriting the register, so the alias is safe.
        t2_movw(&mut te.buf, thumb_ip_reg(), (foff & 0xFFFF) as u16)
        t2_add_rr(&mut te.buf, thumb_ip_reg(), fp)
        t2_ldr_w_imm12(&mut te.buf, dt.reg, thumb_ip_reg(), 0)
      end
      if dt.store_slot >= 0 then
        thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
      end
      Result::Ok(())
    end
  when LirStmtKind::LirPushArg(vreg) then
    # AAPCS caller-stack push: reserve the pushed unit below SP and store
    # the value at [SP]. Emission order is the LIR statement order —
    # DESCENDING argument index (lir_lower_call), so the LAST push of a
    # call site is the lowest stack position, [SP] at the BL. The
    # lowering pads the total word count to EVEN, so SP is 8-byte
    # aligned at the BL (AAPCS). Spill-slot reads address through r7,
    # never SP, so the lowered SP disturbs nothing between pushes.
    #
    # An FP-class vreg (alloc.fp_widths — the float class table) is a
    # FLOAT stack argument of the AAPCS32 VFP stream: the push reserves
    # the value's WIDTH and stores its FP image at [SP] — VSTR.F32's
    # 4-byte single (one AAPCS word) or VSTR.F64's exact 8-byte double
    # image (a two-word unit at the even base the lowering aligned it
    # to). The value resolves through the float-use machinery (a
    # memory-resident source loads through a statement scratch first; a
    # register-resident F64 keeps its pool register). Every other vreg
    # is a general word (the 4-byte push below).
    match alloc.fp_widths.get(vreg)
    when Option::Some(w) then
      let sr = match thumb_fp_use_reg(te, alloc, w, vreg, pos, thumb_fp_use_scratch(w), "pushed stack argument")
      when Result::Ok(r) then r
      when Result::Err(e) then return Result::Err(e)
      end
      match w
      when LirFpWidth::LirF32 then
        t2_sub_sp_imm7(&mut te.buf, 4)
        t2_vstr_f32(&mut te.buf, sr, thumb_sp_reg(), 0)
      when LirFpWidth::LirF64 then
        t2_sub_sp_imm7(&mut te.buf, 8)
        t2_vstr_f64(&mut te.buf, sr, thumb_sp_reg(), 0)
      end
      Result::Ok(())
    when Option::None then
      let sr = thumb_emit_use(te, alloc, mdl_pool, vreg, pos, thumb_ip_reg())
      t2_sub_sp_imm7(&mut te.buf, 4)
      if sr <= 7 then
        t2_str_sp_imm8(&mut te.buf, sr, 0)
      else
        t2_str_w_imm12(&mut te.buf, sr, 13, 0)
      end
      Result::Ok(())
    end
  when LirStmtKind::LirStaticLoad(dst, sym) then
    # A static-value load (a whole-program static reference — see the
    # statement doc in lir.tg): materialize the static's ABSOLUTE
    # address with the MOVW+MOVT pair (the ELF ARM ABI's absolute-
    # address form, R_ARM_THM_MOVW_ABS_NC + R_ARM_THM_MOVT_ABS — the
    # pair GNU/LLVM emit for every symbol address this backend cannot
    # prove, externs included), then load the 32-bit word at [reg].
    # Both imm16 fields start at 0; the linker resolves each relocation
    # against the static's .data symbol (imm16 <- S for the MOVW, <-
    # S >> 16 for the MOVT). The def temp (r12 for memory-resident
    # defs) is a legal MOVW/MOVT/LDR.W target, and the load reads [reg]
    # only after the address is complete, so the def-target alias is
    # safe. Both encoders are flagless (invariant I1).
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    let movw_pos = buf_pos(&te.buf)
    t2_movw(&mut te.buf, dt.reg, 0)
    te.relocs.push(ThumbReloc { offset: movw_pos, sym: sym.clone(), kind: thumb_reloc_movw_abs_nc() })
    let movt_pos = buf_pos(&te.buf)
    t2_movt(&mut te.buf, dt.reg, 0)
    te.relocs.push(ThumbReloc { offset: movt_pos, sym: sym.clone(), kind: thumb_reloc_movt_abs() })
    if dt.reg <= 7 then
      t2_ldr_imm5(&mut te.buf, dt.reg, dt.reg, 0)
    else
      t2_ldr_w_imm12(&mut te.buf, dt.reg, dt.reg, 0)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirFMove(dst, src) then
    # FP register move dst <- src (same width on both sides) — the
    # cortex-m twin of the aarch64 LirFMove arm in lir.tg's
    # lir_emit_stmt, over the FULL residency envelope (see the float
    # resolution section): a fixed ABI FP id (8..15 — lir_is_fixed_fp_id)
    # IS its d-register (d-index = id - lir_fixed_fp_base()), and an
    # allocated FP vreg's physical id (108..113 — the cm pool
    # namespace, lir_fp_pool_regs_cm) is d_{phys - 100}. A
    # memory-resident source loads its slot STRAIGHT into the
    # destination register (or the def scratch for a memory-resident
    # destination) at the width, and a register source stores STRAIGHT
    # to a memory-resident destination's slot: no scratch copy and no
    # VMOV is emitted for either memory side. A register-to-register
    # copy goes through thumb_fp_reg_copy (VMOV.F64 where the FPU has
    # F64 data processing; the VPUSH/VPOP pair on FPv4-SP/FPv5-SP,
    # whose instruction set has no VMOV.F64 Dd, Dm). The width resolves
    # from the ordinary operand's FP class record (alloc.fp_widths —
    # fixed ids carry no record, and the lowering pairs a fixed id with
    # an ordinary one, never two fixed ids). F32 operands are always
    # memory-resident on this route (the cm allocator's memory-class
    # rule — see the float resolution section), so both sides lower
    # through the scratch singles; the register-resident F32 form the
    # resolution helpers still fail closed on is unproducible
    # (allocator invariant).
    let w = match alloc.fp_widths.get(dst)
    when Option::Some(dw) then dw
    when Option::None then
      match alloc.fp_widths.get(src)
      when Option::Some(sw) then sw
      when Option::None then
        panic("thumb: LirFMove between two fixed FP vregs (lowering invariant)")
      end
    end
    let dt = match thumb_fp_def_target(alloc, w, dst, pos, "move destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    # Resolve the source over the full residency envelope, loading a
    # memory-resident source STRAIGHT into the destination register
    # (dt.reg — the destination is being defined, so no second scratch
    # is needed) and storing a register source STRAIGHT to a
    # memory-resident destination's slot. The old scratch-then-VMOV
    # shape is gone: on an FPv4-SP FPU VMOV.F64 Dd, Dm does not exist,
    # and the AAPCS-edge LirMoves (entry parameter binds, argument
    # marshals, returns) must never borrow a statement scratch that
    # could hold another fixed ABI value (d0..d7) of the same edge.
    # Only a REGISTER-to-REGISTER copy reaches thumb_fp_reg_copy (the
    # VMOV / VPUSH+VPOP primitive). A fixed ABI FP source is its own
    # d-register; a pool source with a reload record restores its own
    # register first (invariant I2), exactly like thumb_fp_use_reg.
    var sr = -1
    var src_is_memory = false
    var src_slot = -1
    if lir_is_fixed_fp_id(src) then
      sr = thumb_fp_idx_of_fixed(src, w)
    else
      match alloc.segs_of.get(src)
      when Option::Some(segs) then
        match lir_seg_at(segs, pos)
        when Option::Some(s) then
          if s.phys >= 0 then
            if w == LirFpWidth::LirF32 then
              return Result::Err("thumb: F32 move source vreg " + src.to_string() + " is resident in an allocated FP-pool register (d8..d13) — its 4-byte image has no single-register alias above d15 on the cortex-m register model; the cm allocator never assigns an F32 a pool register (F32 is memory-class on this route), so a pool-resident F32 marks an allocator-invariant violation (fail-closed)")
            end
            sr = match thumb_fp_pool_d(s.phys, "the float move source vreg " + src.to_string())
            when Result::Ok(d) then d
            when Result::Err(e) then return Result::Err(e)
            end
            if lir_reload_at(alloc.reloads, pos, src) then
              thumb_slot_fp_load(te, w, sr, s.slot)
            end
          else
            src_is_memory = true
            src_slot = s.slot
          end
        when Option::None then
          return Result::Err("thumb: float move source vreg " + src.to_string() + " has no segment at position " + pos.to_string() + " (fail-closed)")
        end
      when Option::None then
        return Result::Err("thumb: float move source vreg " + src.to_string() + " has no intervals (fail-closed)")
      end
    end
    if src_is_memory then
      thumb_slot_fp_load(te, w, dt.reg, src_slot)
      if dt.store_slot >= 0 then
        thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
      end
    elsif dt.store_slot >= 0 then
      thumb_slot_fp_store(te, w, sr, dt.store_slot)
    elsif dt.reg != sr then
      thumb_fp_reg_copy(te, w, dt.reg, sr)
    end
    Result::Ok(())
  when LirStmtKind::LirFBinop(fop, w, dst, left, right) then
    # FP arithmetic dst = left op right (FADD/FSUB/FMUL/FDIV under the
    # statement's width) — the cortex-m twin of the aarch64 LirFBinop
    # arm (VADD/VSUB/VMUL/VDIV .F64 Dd, Dn, Dm / .F32 Sd, Sn, Sm),
    # over the FULL residency envelope (see the float resolution
    # section): each memory-resident operand loads into its statement
    # scratch at the width before the op — two memory-resident
    # operands use the two scratches (the aarch64 route's V30/V31
    # first/second-pref pattern; an in-place op may then read the def
    # scratch it also writes, exactly as the aarch64 route reuses V30)
    # — and a memory-resident destination computes into the def
    # scratch and stores to its slot after the op. F32 operands are
    # always memory-resident on this route (the cm allocator's
    # memory-class rule), so every F32 binop loads its operands
    # through the scratch singles and stores its result from the def
    # scratch; the register-resident F32 form the resolution helpers
    # still fail closed on is unproducible (allocator invariant).
    if w == LirFpWidth::LirF64 && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "F64 arithmetic (fadd/fsub/fmul/fdiv)"))
    end
    let dt = match thumb_fp_def_target(alloc, w, dst, pos, "binop destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    let left_pref = thumb_fp_first_pref(dt.reg, w)
    let ln = match thumb_fp_use_reg(te, alloc, w, left, pos, left_pref, "binop left operand")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    let right_pref = thumb_fp_second_pref(ln, w)
    let rm = match thumb_fp_use_reg(te, alloc, w, right, pos, right_pref, "binop right operand")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    match w
    when LirFpWidth::LirF32 then
      match fop
      when LirFpBinOp::LirFAdd then t2_vadd_f32(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFSub then t2_vsub_f32(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFMul then t2_vmul_f32(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFDiv then t2_vdiv_f32(&mut te.buf, dt.reg, ln, rm)
      end
    when LirFpWidth::LirF64 then
      match fop
      when LirFpBinOp::LirFAdd then t2_vadd_f64(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFSub then t2_vsub_f64(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFMul then t2_vmul_f64(&mut te.buf, dt.reg, ln, rm)
      when LirFpBinOp::LirFDiv then t2_vdiv_f64(&mut te.buf, dt.reg, ln, rm)
      end
    end
    if dt.store_slot >= 0 then
      thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirFNeg(w, dst, src) then
    # FP negation dst = -src (VNEG under the statement's width) — the
    # cortex-m twin of the aarch64 LirFNeg arm, over the FULL residency
    # envelope: a memory-resident source loads into its statement
    # scratch at the width and a memory-resident destination negates
    # into the def scratch (d15 — its low single s30 under F32) and
    # stores the image to its slot. VNEG is a sign-bit flip: NaN
    # payloads and signed zeros are preserved. F64 emits the verified
    # VNEG.F64 (t2_vneg_f64); F32 emits the verified VNEG.F32
    # (t2_vneg_f32) over single indices — an F32 source is always
    # memory-resident on this route (the cm allocator's memory-class
    # rule), so the arm always loads through the scratch single (the
    # register-resident F32 form the resolution helper fails closed on
    # is unproducible — an allocator-invariant check).
    if w == LirFpWidth::LirF64 && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "F64 negation"))
    end
    let dt = match thumb_fp_def_target(alloc, w, dst, pos, "negate destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    let pref = thumb_fp_first_pref(dt.reg, w)
    let sm = match thumb_fp_use_reg(te, alloc, w, src, pos, pref, "negate source")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    match w
    when LirFpWidth::LirF32 then
      t2_vneg_f32(&mut te.buf, dt.reg, sm)
    when LirFpWidth::LirF64 then
      t2_vneg_f64(&mut te.buf, dt.reg, sm)
    end
    if dt.store_slot >= 0 then
      thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirFCmp(w, left, right) then
    # Compare two float registers (VCMP under the statement's width) —
    # the cortex-m twin of the aarch64 LirFCmp arm (a64 FCMP, whose
    # NZCV write is mirrored here by the VCMP-to-FPSCR + VMRS-to-APSR
    # pair: t2_vmrs_apsr_nzcv is the only way a VFP comparison reaches
    # the core NZCV flags). The statement therefore writes NZCV exactly
    # like LirCmp (invariant I1: the allocator inserts only flag-
    # neutral code between it and its LirCset consumer, and the
    # consumer reads the EQ/NE/LT/LE/GT/GE conditions of the shared
    # thumb_cc table over the copied flags). Memory-resident operands
    # load into the two statement scratches at the width (left into
    # the def scratch, right into the other one — a compare has no def
    # to preserve) — every F32 operand is memory-resident on this
    # route (the cm allocator's memory-class rule), so an F32 compare
    # always loads its two singles through the scratches (the
    # register-resident F32 form the resolution helper fails closed on
    # is unproducible — an allocator-invariant check).
    # F64 emits the verified VCMP.F64 (t2_vcmp_f64 — the quiet
    # compare, mirroring the a64 FCMP); F32 emits the verified
    if w == LirFpWidth::LirF64 && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "an F64 compare"))
    end
    let ld = match thumb_fp_use_reg(te, alloc, w, left, pos, thumb_fp_def_scratch(w), "compare left operand")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    let right_pref = thumb_fp_second_pref(ld, w)
    let rd = match thumb_fp_use_reg(te, alloc, w, right, pos, right_pref, "compare right operand")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    match w
    when LirFpWidth::LirF32 then
      t2_vcmp_f32(&mut te.buf, ld, rd)
      t2_vmrs_apsr_nzcv(&mut te.buf)
    when LirFpWidth::LirF64 then
      t2_vcmp_f64(&mut te.buf, ld, rd)
      t2_vmrs_apsr_nzcv(&mut te.buf)
    end
    Result::Ok(())
  when LirStmtKind::LirFConst(w, dst, bits) then
    # Materialize the constant's bits into dst — the cortex-m twin of
    # the aarch64 LirFConst arm, over the FULL residency envelope: a
    # register-resident destination materializes into its register, a
    # memory-resident one into the def scratch (d15 — its low single
    # s30 under F32) and stores the image to its slot at the width.
    # The statement payload is ALWAYS the constant's 64-bit HOST-DOUBLE
    # pattern (MirFloat carries doubles — see the LirFConst statement
    # doc), for F32 destinations exactly as for F64 ones.
    #   F64: when the double's bit pattern is modified-immediate
    #   encodable AND the FPU has F64 data processing
    #   (te.f64dp — VMOV.F64 Dd, #imm is not in the FPv4-SP/FPv5-SP
    #   set), VMOV.F64 Dd, #imm (t2_vmov_f64_const — its verified
    #   accept test returns false for every non-encodable pattern,
    #   including +0.0/-0.0, which the modified-immediate rule cannot
    #   express: zero always carries a leading 1.mantissa). Otherwise
    #   the GP transit: materialize the pattern's LOW word in r0 and
    #   its HIGH word in r1 with the movw/movt pair
    #   (thumb_emit_imm32 — the backend's 32-bit constant machinery),
    #   then VMOV Dd, r0, r1 (t2_vmov_gp_pair_to_d — a core<->FP
    #   transfer the single-precision units DO encode, so this is the
    #   ONLY F64 constant path on FPv4-SP/FPv5-SP). This covers the
    #   zero patterns exactly (r0 = r1 = 0 for +0.0; r1 = 0x80000000
    #   for -0.0). A register-clearing VSUB Dd, Dd, Dd self-subtract is
    #   NOT used: the constant statement DEFINES dst, whose register may
    #   hold anything (a dead vreg's stale bits, possibly a NaN), and
    #   x - x is +0.0 only for non-NaN x — self-subtracting garbage is
    #   not IEEE-safe. r0/r1 are the fixed ABI vregs, dead at every
    #   statement boundary on this route (fixed-vreg traffic is the
    #   entry binds, the call-argument moves and the return moves, all
    #   adjacent to terminators/entry), so the transit is safe.
    #   F32: where the FPU has F64 data processing (M7/FPv5-D16), the
    #   emission materializes the DOUBLE pattern into the FP
    #   scratch d-register (d15 — the same imm8/GP-transit choice) and
    #   rounds it to the canonical single with VCVT.F32.F64 s{dst},
    #   d15 — the exact twin of the aarch64 arm's fmov d{V31}, x16 +
    #   fcvt s, d, and the only rounding an F32 constant receives (the
    #   VFP modified-immediate single form is never used directly: the
    #   payload is a double pattern, not a single one). When the
    #   destination is memory-resident the rounding writes the def
    #   scratch s30 — the LOW single of the source d15 itself: VFP
    #   data processing reads its operands before writing its result
    #   (the canonical vcvt.f32.f64 s0, d0 narrowing), so the
    #   read-after-rounding store sees the exact single image.
    #   On an FPv4-SP/FPv5-SP unit (te.f64dp false) that conversion
    #   does not exist, so the branch materializes the single DIRECTLY:
    #   a modified-immediate value reuses the double pattern's imm8
    #   (the F32 and F64 forms share the 256-value table and the imm8
    #   field), and +/-0.0 goes through the GP transit of its f32 bits
    #   (sign only); any other constant needs the host-side
    #   double->single rounding this slice does not implement and
    #   fails closed with the precise rule (no silent illegal VCVT).
    #   An F32
    #   destination is ALWAYS memory-resident on this route (the cm
    #   allocator's memory-class rule), so the emission always writes
    #   the def scratch s30 and stores the slot; the register-resident
    #   F32 form thumb_fp_def_target still fails closed on is
    #   unproducible (allocator invariant).
    let dt = match thumb_fp_def_target(alloc, w, dst, pos, "constant destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    match w
    when LirFpWidth::LirF32 then
      if te.f64dp then
        if !t2_vmov_f64_const(&mut te.buf, thumb_fp_scratch_d(), bits as u64) then
          thumb_emit_imm32(te, 0, bits & 0xFFFFFFFF)
          thumb_emit_imm32(te, 1, (bits >> 32) & 0xFFFFFFFF)
          t2_vmov_gp_pair_to_d(&mut te.buf, 0, 1, thumb_fp_scratch_d())
        end
        t2_vcvt_f32_f64(&mut te.buf, dt.reg, thumb_fp_scratch_d())
      else
        # No F64->F32 conversion on this FPU (see the LirFcvt gate's
        # rule): materialize the canonical single WITHOUT touching a
        # double. A modified-immediate value has the SAME imm8 in the
        # F32 form (the shared 256-value table), so the double pattern's
        # imm8 drives VMOV.F32 Sd, #imm; exact +/-0.0 (the only
        # non-imm value this path can convert exactly without host
        # rounding) is the GP transit of its f32 bits (sign only);
        # everything else needs the double->single RNE rounding this
        # slice does not implement and fails closed.
        let imm8 = t2_vmov_imm8_of_f64_bits(bits as u64)
        if imm8 >= 0 then
          t2_vmov_f32_imm(&mut te.buf, dt.reg, imm8)
        elsif ((bits as u64) << 1) == 0 then
          thumb_emit_imm32(te, 0, (bits >> 32) & 0xFFFFFFFF)
          t2_vmov_gp_to_s(&mut te.buf, 0, dt.reg)
        else
          return Result::Err("thumb: F32 constant (host-double pattern " + bits.to_string() + ") does not lower against the `" + te.desc_name + "` description — its FPU is single-precision only and has no F64->F32 conversion (VCVT.F32.F64); the constant is neither a modified-immediate value nor an exact zero, and this slice does not implement the host-side double->single rounding the general case needs (fail-closed; compile for cortex-m7 / Fpu FPv5D16 for arbitrary F32 constants)")
        end
      end
    when LirFpWidth::LirF64 then
      # VMOV.F64 Dd, #imm is not in the FPv4-SP/FPv5-SP instruction set:
      # on those FPUs the constant always takes the GP pair transit
      # (VMOV Dd, Rt, Rt2 is a core<->FP transfer the SP unit DOES
      # encode); on an F64-data-processing FPU the modified-immediate
      # form is tried first and the GP transit is the fallback.
      var emitted = false
      if te.f64dp then
        emitted = t2_vmov_f64_const(&mut te.buf, dt.reg, bits as u64)
      end
      if !emitted then
        thumb_emit_imm32(te, 0, bits & 0xFFFFFFFF)
        thumb_emit_imm32(te, 1, (bits >> 32) & 0xFFFFFFFF)
        t2_vmov_gp_pair_to_d(&mut te.buf, 0, 1, dt.reg)
      end
    end
    if dt.store_slot >= 0 then
      thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirIntToFloat(w, dst, src, unsigned) then
    # Signed/unsigned integer word -> float — the cortex-m twin of the
    # aarch64 LirIntToFloat arm (SCVTF/UCVTF under the statement's
    # width). The VFP converters of this backend (t2_vcvt_f64_s32 /
    # t2_vcvt_f64_u32 / t2_vcvt_f32_s32 / t2_vcvt_f32_u32) read their
    # 32-bit integer from an S register of the VFP file, so the integer
    # word first crosses from the ARM core into the FP file: the source
    # word is materialized (thumb_emit_use — a spill load, when the
    # source is memory-resident, lands in r0, the requested pref) and
    # VMOV Sd, Rt (t2_vmov_gp_to_s) carries it into the scratch single
    # s30 (d15's low single — never an allocated register), then the
    # VCVT converts it at the statement's width. VFP's VCVT converts
    # 32-bit integer sources only, which is exactly this route's word
    # model: the cortex-m shape gate admits Int/UInt words whose machine
    # image is the 32-bit cortex-m word ([-2^31, 2^32)), so no 64-bit-
    # integer source can reach a validated function — the aarch64
    # route's 64-bit-int SCVTF/UCVTF conversions (which no VFP VCVT
    # mirrors) are excluded with the aarch64-convention LIR as a whole
    # (the fixed-vreg 4..7 fingerprints and the word-only gates), and
    # no rule-naming Err is reachable for them here. The destination
    # resolves through thumb_fp_def_target: a register-resident
    # destination is its pool d-register (an F64 — an F32 destination
    # is always memory-resident on this route by the cm memory-class
    # rule), a memory-resident one the
    # def scratch (d15 — its low single s30 under F32) with a pending
    # width store to its slot (an in-place VCVT may then read the
    # scratch single it also writes — VFP data processing reads before
    # it writes, and a widening vcvt.f64.s32 d15, s30 is the canonical
    # shape).
    if w == LirFpWidth::LirF64 && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "the int -> F64 conversion (vcvt.f64.s32/vcvt.f64.u32)"))
    end
    let dt = match thumb_fp_def_target(alloc, w, dst, pos, "int-to-float destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    let sr = thumb_emit_use(te, alloc, mdl_pool, src, pos, thumb_ret_reg())
    t2_vmov_gp_to_s(&mut te.buf, sr, thumb_fp_scratch_s())
    match w
    when LirFpWidth::LirF32 then
      if unsigned then
        t2_vcvt_f32_u32(&mut te.buf, dt.reg, thumb_fp_scratch_s())
      else
        t2_vcvt_f32_s32(&mut te.buf, dt.reg, thumb_fp_scratch_s())
      end
    when LirFpWidth::LirF64 then
      if unsigned then
        t2_vcvt_f64_u32(&mut te.buf, dt.reg, thumb_fp_scratch_s())
      else
        t2_vcvt_f64_s32(&mut te.buf, dt.reg, thumb_fp_scratch_s())
      end
    end
    if dt.store_slot >= 0 then
      thumb_slot_fp_store(te, w, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirFloatToInt(w, dst, src) then
    # Float -> signed integer word — the §25 SATURATING language rule
    # (types.tg: NaN -> 0, out-of-range clamps to the range bound,
    # otherwise truncation toward zero) implemented NATIVELY by the
    # ARMv7-M VFP VCVT.S32 saturating converters (NaN -> 0,
    # out-of-range saturates) — the cortex-m twin of the aarch64
    # LirFloatToInt arm, whose FCVTZS does NOT share the VFP rule (the
    # ARMv8 instruction returns the integer-indefinite INT64_MIN for
    # NaN/out-of-range and needs codegen.tg's emit_ftoi_saturate_a64
    # fixup; the ARMv7 VFP VCVT saturates by itself, so this emitter
    # appends nothing). The VFP converters
    # (t2_vcvt_s32_f64 / t2_vcvt_s32_f32) produce their 32-bit integer
    # in an S register, so the word crosses back from the FP file into
    # the ARM core: the VCVT writes the scratch single s30, then VMOV
    # Rt, Sd (t2_vmov_s_to_gp) carries it into the integer destination
    # vreg's def target (thumb_def_target — the pool register of a
    # register-resident def, or the r12 temp with the pending spill-
    # slot store of a memory-resident def, exactly like the general
    # statement arms). A memory-resident float source loads into the
    # SECOND scratch (d14 — its low single s28 under F32) so the
    # conversion result in the def scratch single s30 never shares a
    # d-register with the source image (a register-resident F64 source
    # in the pool converts straight from its d-register; an F32 source
    # is always memory-resident on this route by the cm memory-class
    # rule). A 64-bit
    # integer destination — the aarch64 route's FCVTZS-to-X form — has
    # no VFP mirror and cannot reach a validated function (see the
    # LirIntToFloat arm); no rule-naming Err is reachable for it here.
    if w == LirFpWidth::LirF64 && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "the F64 -> int conversion (vcvt.s32.f64/vcvt.u32.f64)"))
    end
    let dt = thumb_def_target(alloc, mdl_pool, dst, pos)
    let sm = match thumb_fp_use_reg(te, alloc, w, src, pos, thumb_fp_use_scratch(w), "float-to-int source")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    match w
    when LirFpWidth::LirF32 then
      t2_vcvt_s32_f32(&mut te.buf, thumb_fp_scratch_s(), sm)
    when LirFpWidth::LirF64 then
      t2_vcvt_s32_f64(&mut te.buf, thumb_fp_scratch_s(), sm)
    end
    t2_vmov_s_to_gp(&mut te.buf, dt.reg, thumb_fp_scratch_s())
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirStmtKind::LirFcvt(src_w, dst, src) then
    # Float <-> float width cast: fdst = (dw) fsrc — the cortex-m twin
    # of the aarch64 LirFcvt arm (FCVT: single->double exact widening
    # via t2_vcvt_f64_f32, double->single exactly-once RNE rounding via
    # t2_vcvt_f32_f64), over the FULL residency envelope: a
    # memory-resident source loads into the def scratch of its own
    # width at the width before the op, and a memory-resident
    # destination converts into the def scratch of ITS width and
    # stores the image to its slot. When both are memory-resident the
    # widening/narrowing VCVT may read a scratch whose d-register the
    # result also occupies (vcvt.f32.f64 s30, d15 narrows into the low
    # single of its own source; vcvt.f64.f32 d15, s30 widens over its
    # own source single) — VFP data processing reads its operands
    # before writing its result, the same overlap the aarch64 route's
    # fcvt s, d{dV31} / fcvt d, s patterns carry. dw is the dst
    # vreg's class-record width (the encoders implement the two cross-
    # width directions only; a same-width pair is a lowering
    # divergence). The F32 side rides the LOW single of its d-index
    # (s = 2*d); an F32 operand is always memory-resident on this
    # route (the cm allocator's memory-class rule), so both the source
    # load and the destination store of an F32 side go through the
    # scratch singles (the register-resident F32 form the resolution
    # helpers fail closed on is unproducible — allocator invariant).
    let dw = match alloc.fp_widths.get(dst)
    when Option::Some(v) then v
    when Option::None then panic("lir: LirFcvt into a vreg with no FP class record (lowering invariant)")
    end
    if (src_w == LirFpWidth::LirF64 || dw == LirFpWidth::LirF64) && !te.f64dp then
      return Result::Err(thumb_f64_dp_rule_emit(te, "the F64 <-> F32 conversion (vcvt.f32.f64/vcvt.f64.f32)"))
    end
    let dt = match thumb_fp_def_target(alloc, dw, dst, pos, "fcvt destination")
    when Result::Ok(t) then t
    when Result::Err(e) then return Result::Err(e)
    end
    let sm = match thumb_fp_use_reg(te, alloc, src_w, src, pos, thumb_fp_def_scratch(src_w), "fcvt source")
    when Result::Ok(r) then r
    when Result::Err(e) then return Result::Err(e)
    end
    if dw == LirFpWidth::LirF32 && src_w == LirFpWidth::LirF64 then
      t2_vcvt_f32_f64(&mut te.buf, dt.reg, sm)
    elsif dw == LirFpWidth::LirF64 && src_w == LirFpWidth::LirF32 then
      t2_vcvt_f64_f32(&mut te.buf, dt.reg, sm)
    else
      panic("lir: LirFcvt between identical widths (lowering invariant; same-width casts lower as moves)")
    end
    if dt.store_slot >= 0 then
      thumb_slot_fp_store(te, dw, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  end
end

# Emit the pre-call spill stores (register-resident pre-call segments
# whose end precedes the call at `pos` — invariant I2; redundant for the
# callee-saved pool but keeps the allocator target-agnostic). A spill
# record whose vreg is a FLOAT-class vreg (alloc.fp_widths — the cm FP
# pool d8..d13 is callee-saved and saved as a whole block by the
# prologue, but the allocator still treats pool registers as
# caller-saved, so an F64 value live across a call
# always takes this path) stores its slot image at the width through
# the VFP store machinery (thumb_slot_fp_store): an F64's 8-byte image
# rides the width-sized slot home the cm allocator reserves (two
# 4-byte words at an even base — LirAlloc.slot_words), so the
# double-form VSTR is exact. An F32 value never reaches this arm's
# F32 register-resident form — the cm allocator keeps F32 out of the
# pool (memory-class), so an F32 crossing a call is already slot-
# resident; the form below fails closed as an allocator-invariant
# check (an F32 in the pool has no single-register alias on the
# cortex-m register model — s0..s31 = d0..d15 only).
# The crossing's post-call side is the reload record, which the
# float-use resolution (thumb_fp_use_reg) emits at the width.
def thumb_emit_call_spills(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], pos: Int) -> Result[Unit, String]
  var i = 0
  while i < alloc.spills.len() do
    if alloc.spills[i].0 == pos then
      let vreg = alloc.spills[i].1
      match alloc.segs_of.get(vreg)
      when Option::Some(segs) then
        match lir_seg_at(segs, pos - 1)
        when Option::Some(s) then
          if s.phys >= 0 && s.slot >= 0 then
            match alloc.fp_widths.get(vreg)
            when Option::Some(w) then
              if w == LirFpWidth::LirF32 then
                return Result::Err("thumb: F32 value vreg " + vreg.to_string() + " is live across a call in an allocated FP-pool register (d8..d13) and would need a spill store at its call boundary — its 4-byte image has no single-register alias above d15 on the cortex-m register model; the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 marks an allocator-invariant violation (fail-closed)")
              end
              let dd = match thumb_fp_pool_d(s.phys, "the spill-crossing FP value vreg " + vreg.to_string())
              when Result::Ok(d) then d
              when Result::Err(e) then return Result::Err(e)
              end
              thumb_slot_fp_store(te, w, dd, s.slot)
            when Option::None then
              thumb_slot_store(te, mdl_pool, thumb_phys_of(mdl_pool, s.phys), s.slot)
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
    i = i + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Pointer/atomic statement emission (the cortex-m atomic slice)
# ———————————————————————————————————————————————————————————————
# The marked LirPtrOp statements of the pointer/atomic slice emit here
# as ARMv7-M sequences. The atomic primitive of this profile is the
# exclusive monitor (LDREX/STREX word/byte/half) with DMB for
# ordering; there is NO LSE family on ARMv7-M, so every atomic form of
# the LIR slice translates into its LDREX/STREX loop equivalent. The
# per-ordering discipline mirrors memory_model.md §16.8.1's ARMv7
# canonical form (clang/gcc's __atomic lowering for thumbv7em,
# verified offline — the reference emission):
#   loads:  form 0 (Relaxed) = plain width LDR;
#           form 1 (Acquire/SeqCst/out-of-domain) = LDR + DMB SY
#           (the load's acquire side orders every later access after
#           it; SeqCst loads use the same pair — the classic ARMv7
#           LDR;DMB SC-load mapping, and the STLR discipline of the
#           a64 table has no single-instruction counterpart here);
#   stores: form 0 (Relaxed) = plain width STR;
#           form 1 (Release/SeqCst/out-of-domain) = DMB SY; STR; DMB SY
#           — clang's seq_cst store sequence (the trailing DMB is what
#           makes the SC store total under the classic ARMv7 mapping);
#           the LIR form cannot distinguish Release from SeqCst, and
#           serving the stronger form for both is legal;
#   RMW/CAS/exchange (the LirAtomRmw/LirAtomCas families):
#           form 0 (Relaxed) = the bare LDREX/STREX loop;
#           form 1 (Acquire) = loop + DMB SY after the loop (all
#           later accesses stay after the RMW's read);
#           form 2 (Release) = DMB SY before the loop + loop (prior
#           accesses stay before the RMW's write);
#           form 3 (AcqRel/SeqCst/out-of-domain) = DMB SY; loop; DMB SY
#           (the classic full-barrier SC RMW);
#   CAS adds CLREX on the compare-mismatch exit (the failed compare
#   leaves the monitor armed — clang clears it there, verified
#   offline) and its post-loop DMB (forms 1/3) sits on the common
#   exit, so the failed path of an acquire/seq-cst CAS reads with the
#   success order's strength exactly like the a64 CASA/CASAL arm;
#   fences (LirPtrFence): both forms = DMB SY — ARMv7-M is a
#   single-core profile with no shareability-domain distinction, so
#   the a64 route's ISHLD/ISH option split collapses into the full
#   system barrier (the ecosystem reference emits `dmb sy` at every
#   ordering boundary on thumbv7em — verified offline).
# The plain pointer statements (marked loads/stores/LEAs) emit as
# register-indirect width loads/stores and frame-address arithmetic.
#
# REGISTER DISCIPLINE: an exclusive sequence pins its operands in
# registers across the loop and needs the STREX status register and
# the loop's data register besides them. The statement-scratch pool
# {r0, r1, r2, r3, r12} serves every pin: r0-r3 and r12 are dead at
# every statement that is not itself an argument move (fixed vregs
# 0..3 only ever hold values in the entry parameter binds and in the
# LirMove argument moves that sit directly before a call terminator —
# the marked statements never appear in those batches and never read
# or write a fixed vreg — and r12 is the reserved instruction temp,
# never allocated), while the pool registers (r4..r10) hold the
# register-resident operand values. Allocated registers for distinct
# simultaneously-live vregs are distinct by the allocator, so the
# pins never alias pool registers. STREX keeps Rd (status), Rt (data)
# and Rn (address) pairwise distinct, and LDREX keeps Rt distinct
# from Rn (the AArch32 constraints on the exclusive forms), which the
# exclusion set below guarantees. Invariant I1 is preserved: the only
# flag writes inside a sequence are the CMPs that immediately precede
# their own conditional branches; every path through a sequence ends
# flag-neutral, and the LirCmp consumer following a marked CAS arm is
# a real compare statement of its own.

# Pick a statement scratch not in `excl` (the registers already pinned
# by the sequence). Option::None only when all five are pinned — an
# internal planning failure the arms fail closed on.
def thumb_pick_atom_scratch(excl: Set[Int]) -> Option[Int]
  if !excl.contains(&0) then Option::Some(0)
  elsif !excl.contains(&1) then Option::Some(1)
  elsif !excl.contains(&2) then Option::Some(2)
  elsif !excl.contains(&3) then Option::Some(3)
  elsif !excl.contains(&12) then Option::Some(12)
  else Option::None
  end
end

# Pick the STREX STATUS register of a loop: always one of r0..r3, so
# the status test after every STREX is the 2-byte CMP rn, #0 (the
# imm8 form takes rn <= 7) with NO temp materialization — a temp
# would have to borrow a register the loop's pins hold (clobbering a
# pin between a STREX and its retry would corrupt the loop). The arms
# reserve the status FIRST (before any pin), and a loop never needs
# more than four pins besides it, so a low status register always
# exists. Option::None is unreachable (planning failure).
def thumb_pick_atom_status(excl: Set[Int]) -> Option[Int]
  if !excl.contains(&0) then Option::Some(0)
  elsif !excl.contains(&1) then Option::Some(1)
  elsif !excl.contains(&2) then Option::Some(2)
  elsif !excl.contains(&3) then Option::Some(3)
  else Option::None
  end
end

# Reserve the fixed scratch `reg` for a sequence (the caller resolved
# an operand into it).
def thumb_atom_reserve(inout excl: Set[Int], reg: Int) -> Unit
  if reg <= 3 || reg == 12 then
    excl.insert(reg)
  end
end

# Resolve one exclusive-sequence operand into a register: a
# register-resident value keeps its pool register, a spill-resident
# one loads through the preference `pref`; the resulting register is
# reserved in `excl` when it is a statement scratch (a fixed vreg
# 0..3 result is recorded too — never produced for these operands by
# the lowering, kept defensive).
def thumb_atom_use(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], vreg: Int, pos: Int, pref: Int, inout excl: Set[Int]) -> Int
  let r = thumb_emit_use(te, alloc, mdl_pool, vreg, pos, pref)
  thumb_atom_reserve(excl, r)
  r
end

# The preferred spill-load temp of an operand given the registers
# already pinned: any free statement scratch (r12 first — the
# established first temp).
def thumb_atom_pref(excl: Set[Int]) -> Int
  match thumb_pick_atom_scratch(excl)
  when Option::Some(r) then r
  when Option::None then 12
  end
end

# A unique statement-internal label of fn `fn_name` at position `pos`
# with tag `tag` (the label map is whole-program; fn names and
# statement positions are unique).
def thumb_atom_label(fn_name: String, pos: Int, tag: String) -> String
  ".La" + fn_name + "$" + pos.to_string() + "$" + tag
end

# The def target of a pointer/atomic statement's destination vreg.
# Register-resident defs compute straight into the segment register;
# a MEMORY-resident def is computed into a statement scratch and
# stored to its slot by the arm (never through the generic
# r12-def-target convention: the exclusive sequences need r12 as a
# possible status/data scratch, so the arms pick their own final
# register).
def thumb_atom_def(alloc: LirAlloc, mdl_pool: Vec[Int], vreg: Int, pos: Int) -> ThumbDefTarget
  thumb_def_target(alloc, mdl_pool, vreg, pos)
end

# The width memory access [rn + off] at width 1/2/4 of the pointer
# statements (is_load with optional sign extension at 1/2). Direct
# imm12 forms for off <= 4095; beyond that the address is built in a
# scratch that avoids the data register (movw; add — the 0x4400
# flagless form) and the access goes through it, mirroring the frame
# slot-access strategy. `data` is the register the load lands in /
# the store reads from: the built address never aliases it.
def thumb_ptr_mem_access(inout te: ThumbEmit, w: Int, sign: Bool, is_load: Bool, data: Int, rn: Int, off: Int) -> Unit
  if off <= 4095 then
    if is_load then
      t2_ldr_wd(&mut te.buf, w, sign, data, rn, off)
    else
      t2_str_wd(&mut te.buf, w, data, rn, off)
    end
  else
    let addr = if data == thumb_ip_reg() then thumb_ip2_reg() else thumb_ip_reg() end
    if off > 0xFFFF then
      panic("thumb: pointer access offset beyond the 16-bit cortex-m address model (validation must reject it)")
    end
    t2_movw(&mut te.buf, addr, (off & 0xFFFF) as u16)
    t2_add_rr(&mut te.buf, addr, rn)
    if is_load then
      t2_ldr_wd(&mut te.buf, w, sign, data, addr, 0)
    else
      t2_str_wd(&mut te.buf, w, data, addr, 0)
    end
  end
end

# One marked pointer/atomic statement's emission (see the section
# header for the per-form translation table). `stmt` is the carrier
# statement (its nominal kind is NOT emitted — the arms below define
# every def and use the marker payload declares); `pop` its marker.
def thumb_emit_ptr_stmt(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], fn_name: String, stmt: LirStmt, pop: LirPtrOp, pos: Int) -> Result[Unit, String]
  let _ = stmt
  match pop
  when LirPtrOp::LirPtrLea(dst, off) then
    # dst = r7 + off — the address of the fixed frame slot (the cm
    # lowering's LEA payload is the machine byte offset 4*slot).
    let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
    if off <= 4095 then
      t2_addw(&mut te.buf, dt.reg, thumb_fp_reg(), off)
    else
      t2_movw(&mut te.buf, dt.reg, (off & 0xFFFF) as u16)
      t2_add_rr(&mut te.buf, dt.reg, thumb_fp_reg())
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirPtrOp::LirPtrAddr(dst, base, off) then
    # dst = base + off (an address inside a pointed-to image / a deref
    # place's byte offset — the a64 route's base+off form; on the
    # cortex-m slice the offset is 0 for whole-scalar derefs).
    let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
    var excl: Set[Int] = Set::new()
    let br = thumb_atom_use(te, alloc, mdl_pool, base, pos, thumb_atom_pref(excl), excl)
    if off == 0 then
      if dt.reg != br then
        t2_mov_rr(&mut te.buf, dt.reg, br)
      end
    elsif off <= 4095 then
      t2_addw(&mut te.buf, dt.reg, br, off)
    else
      let t = thumb_imm_temp_avoiding(te, off, br)
      t2_add_w(&mut te.buf, dt.reg, br, t)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirPtrOp::LirPtrLoad(dst, base, off, w, sign) then
    # dst = load(base + off) at storage width w (sign-extended at 1/2
    # for the signed pointee kinds).
    let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
    var excl: Set[Int] = Set::new()
    let br = thumb_atom_use(te, alloc, mdl_pool, base, pos, thumb_atom_pref(excl), excl)
    thumb_ptr_mem_access(te, w, sign, true, dt.reg, br, off)
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirPtrOp::LirPtrStore(base, off, src, w) then
    # store(base + off) = src at storage width w (the value's low w
    # bytes).
    var excl: Set[Int] = Set::new()
    let sv = thumb_atom_use(te, alloc, mdl_pool, src, pos, thumb_atom_pref(excl), excl)
    let bv = thumb_atom_use(te, alloc, mdl_pool, base, pos, thumb_alt_pref(sv), excl)
    thumb_ptr_mem_access(te, w, false, false, sv, bv, off)
    Result::Ok(())
  when LirPtrOp::LirAtomLoad(form, w, dst, addr) then
    # dst = load(addr); form 0 = the plain width load, form 1 = the
    # acquire/SeqCst load (LDR + DMB SY).
    let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
    var excl: Set[Int] = Set::new()
    let ar = thumb_atom_use(te, alloc, mdl_pool, addr, pos, thumb_alt_pref(dt.reg), excl)
    thumb_ptr_mem_access(te, w, false, true, dt.reg, ar, 0)
    if form == 1 then
      t2_dmb_sy(&mut te.buf)
    end
    if dt.store_slot >= 0 then
      thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
    end
    Result::Ok(())
  when LirPtrOp::LirAtomStore(form, w, addr, val) then
    # store(addr) = val; form 0 = the plain width store, form 1 = the
    # release/SeqCst store (DMB SY; STR; DMB SY — clang's ARMv7-M
    # seq_cst store; the trailing barrier is what a SeqCst store needs
    # beyond Release, and the form serves both).
    var excl: Set[Int] = Set::new()
    let sv = thumb_atom_use(te, alloc, mdl_pool, val, pos, thumb_atom_pref(excl), excl)
    let ar = thumb_atom_use(te, alloc, mdl_pool, addr, pos, thumb_alt_pref(sv), excl)
    if form == 1 then
      t2_dmb_sy(&mut te.buf)
    end
    thumb_ptr_mem_access(te, w, false, false, sv, ar, 0)
    if form == 1 then
      t2_dmb_sy(&mut te.buf)
    end
    Result::Ok(())
  when LirPtrOp::LirAtomRmw(family, form, w, dst, addr, val) then
    thumb_emit_atom_rmw(te, alloc, mdl_pool, fn_name, family, form, w, dst, addr, val, pos)
  when LirPtrOp::LirAtomCas(form, w, dst, exp, des, addr) then
    thumb_emit_atom_cas(te, alloc, mdl_pool, fn_name, form, w, dst, exp, des, addr, pos)
  when LirPtrOp::LirPtrFence(_) then
    # The per-ordering fence: both the acquire (0) and the
    # release/SeqCst (1) forms are the full DMB SY (see the section
    # header — ARMv7-M has no domain split to serve the a64 ISHLD/ISH
    # distinction).
    t2_dmb_sy(&mut te.buf)
    Result::Ok(())
  end
end

# One LirAtomRmw arm: the LDREX/STREX loop of the RMW/exchange family
# (0 = add — fetch_sub's negation already lowered; 1 = and — the
# fetch_and complement already lowered; 2 = or; 3 = xor; 4 = exchange)
# at the ordering form's barrier placement. dst receives the OLD
# [addr] word (zero-extended at the width by the exclusive load, like
# the a64 LSE forms). When dst IS the value operand (MIR storage
# reuse), the value is copied into a pin first — the loop's data
# register would otherwise clobber it on the first LDREX.
def thumb_emit_atom_rmw(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], fn_name: String, family: Int, form: Int, w: Int, dst: Int, addr: Int, val: Int, pos: Int) -> Result[Unit, String]
  if form == 2 || form == 3 then
    t2_dmb_sy(&mut te.buf)
  end
  var excl: Set[Int] = Set::new()
  # The STREX status register (S) is reserved FIRST from the low
  # scratches (r0..r3 — the status test then needs no temp; see
  # thumb_pick_atom_status).
  let sr = match thumb_pick_atom_status(excl)
  when Option::Some(pp) then pp
  when Option::None then
    return Result::Err("thumb: " + fn_name + ": atomic RMW at position " + pos.to_string() + " has no low status register (internal planning failure — fail-closed)")
  end
  excl.insert(sr)
  # The address pin (A).
  let ar = thumb_atom_use(te, alloc, mdl_pool, addr, pos, thumb_atom_pref(excl), excl)
  # The value pin (V): the exchange (family 4) data register at the
  # STREX or the ALU operand of the other families.
  var vr = 0
  if dst == val then
    # Storage reuse: copy the value into a pin before any def write.
    let r = thumb_atom_use(te, alloc, mdl_pool, val, pos, thumb_atom_pref(excl), excl)
    let p = match thumb_pick_atom_scratch(excl)
    when Option::Some(pp) then pp
    when Option::None then
      return Result::Err("thumb: " + fn_name + ": atomic RMW at position " + pos.to_string() + " exhausted the statement-scratch pool (internal planning failure — fail-closed)")
    end
    t2_mov_rr(&mut te.buf, p, r)
    excl.insert(p)
    vr = p
  else
    vr = thumb_atom_use(te, alloc, mdl_pool, val, pos, thumb_atom_pref(excl), excl)
  end
  # The loop data register (D): the def segment register when the
  # destination is register-resident, else a statement scratch that
  # holds the OLD value at the loop end (the arm stores it to the
  # def slot below).
  let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
  var dr = dt.reg
  if dt.store_slot >= 0 then
    let p = match thumb_pick_atom_scratch(excl)
    when Option::Some(pp) then pp
    when Option::None then
      return Result::Err("thumb: " + fn_name + ": atomic RMW at position " + pos.to_string() + " exhausted the statement-scratch pool (internal planning failure — fail-closed)")
    end
    excl.insert(p)
    dr = p
  else
    thumb_atom_reserve(excl, dr)
  end
  # The exclusive loop. Family 1 (the LDCLR mirror of fetch_and) has
  # its AND-operand COMPLEMENTED in the value pin before the loop: the
  # prepped val_p is ~v (the lowering's BitNot — see
  # lir_atomic_rmw_prep) and the memory op must AND with its
  # complement (old & ~~v == old & v). The pin is the prepped vreg's
  # only reader (a fresh lowering temp; dead after this statement), so
  # the in-place MVN is safe. The other families use the pin as-is.
  let lbl = thumb_atom_label(fn_name, pos, "rmw")
  if family == 1 then
    t2_mvn_w(&mut te.buf, vr, vr)
  end
  def_label(&mut te.buf, lbl)
  t2_ldrex_wd(&mut te.buf, w, dr, ar)
  match family
  when 0 then t2_add_w(&mut te.buf, dr, dr, vr)
  when 1 then t2_and_w(&mut te.buf, dr, dr, vr)
  when 2 then t2_orr_w(&mut te.buf, dr, dr, vr)
  when 3 then t2_eor_w(&mut te.buf, dr, dr, vr)
  when 4 then ()   # exchange: the STREX writes the value pin directly
  when _ then return Result::Err("thumb: " + fn_name + ": atomic RMW family " + family.to_string() + " does not lower (fail-closed)")
  end
  if family == 4 then
    t2_strex_wd(&mut te.buf, w, sr, vr, ar)
  else
    t2_strex_wd(&mut te.buf, w, sr, dr, ar)
  end
  t2_cmp_imm8(&mut te.buf, sr, 0)
  thumb_emit_b_cond(te, thumb_cc(LirCond::LirNe), lbl)
  if form == 1 || form == 3 then
    t2_dmb_sy(&mut te.buf)
  end
  if dt.store_slot >= 0 then
    thumb_slot_store(te, mdl_pool, dr, dt.store_slot)
  end
  Result::Ok(())
end

# One LirAtomCas arm: the LDREX/STREX compare-exchange loop. The
# expected word (exp — the zero-extended word the CAS lowering loaded
# from the expected slot) is compared per iteration; on mismatch the
# loop exits through CLREX (the armed monitor is cleared — clang's
# ARMv7-M CAS shape) with dst holding the current [addr] word; on
# success the STREX grants and dst holds the expected word. The
# post-loop DMB of the acquire/SeqCst forms sits on the COMMON exit,
# so a failed CAS reads with the success order's strength (the a64
# CASA/CASAL mirror; the failure order is covered by the checker's
# failure <= success rule).
def thumb_emit_atom_cas(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], fn_name: String, form: Int, w: Int, dst: Int, exp: Int, des: Int, addr: Int, pos: Int) -> Result[Unit, String]
  if form == 2 || form == 3 then
    t2_dmb_sy(&mut te.buf)
  end
  var excl: Set[Int] = Set::new()
  # The STREX status register (S) is reserved FIRST from the low
  # scratches (r0..r3 — the status test then needs no temp; see
  # thumb_pick_atom_status).
  let sr = match thumb_pick_atom_status(excl)
  when Option::Some(pp) then pp
  when Option::None then
    return Result::Err("thumb: " + fn_name + ": atomic CAS at position " + pos.to_string() + " has no low status register (internal planning failure — fail-closed)")
  end
  excl.insert(sr)
  # The address pin (A) and the expected pin (E — compared every
  # iteration).
  let ar = thumb_atom_use(te, alloc, mdl_pool, addr, pos, thumb_atom_pref(excl), excl)
  let er = thumb_atom_use(te, alloc, mdl_pool, exp, pos, thumb_atom_pref(excl), excl)
  # The loop data register (D): the def segment register when the
  # destination is register-resident, else a statement scratch holding
  # the current word at the loop end.
  let dt = thumb_atom_def(alloc, mdl_pool, dst, pos)
  var dr = dt.reg
  if dt.store_slot >= 0 then
    let p = match thumb_pick_atom_scratch(excl)
    when Option::Some(pp) then pp
    when Option::None then
      return Result::Err("thumb: " + fn_name + ": atomic CAS at position " + pos.to_string() + " exhausted the statement-scratch pool (internal planning failure — fail-closed)")
    end
    excl.insert(p)
    dr = p
  else
    thumb_atom_reserve(excl, dr)
  end
  # The desired pin (T — the STREX data register).
  let tr = thumb_atom_use(te, alloc, mdl_pool, des, pos, thumb_atom_pref(excl), excl)
  # The compare-exchange loop: LDREX; compare; mismatch exits through
  # CLREX to the common tail; STREX failure (the monitor was lost or
  # another agent wrote) retries the whole read-compare-store cycle.
  let lp_lbl = thumb_atom_label(fn_name, pos, "caslp")
  let fail_lbl = thumb_atom_label(fn_name, pos, "casfail")
  def_label(&mut te.buf, lp_lbl)
  t2_ldrex_wd(&mut te.buf, w, dr, ar)
  thumb_emit_cmp_rr(te, dr, er)
  thumb_emit_b_cond(te, thumb_cc(LirCond::LirNe), fail_lbl)
  t2_strex_wd(&mut te.buf, w, sr, tr, ar)
  t2_cmp_imm8(&mut te.buf, sr, 0)
  thumb_emit_b_cond(te, thumb_cc(LirCond::LirNe), lp_lbl)
  def_label(&mut te.buf, fail_lbl)
  t2_clrex(&mut te.buf)
  if form == 1 || form == 3 then
    t2_dmb_sy(&mut te.buf)
  end
  if dt.store_slot >= 0 then
    thumb_slot_store(te, mdl_pool, dr, dt.store_slot)
  end
  Result::Ok(())
end

def thumb_emit_term(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], fn_name: String, frame_bytes: Int, kind: LirTermKind, pos: Int, externs: Set[String], defined: Set[String]) -> Result[Unit, String]
  match kind
  when LirTermKind::LirJump(target) then
    thumb_emit_b_uncond(te, lir_block_label(fn_name, target))
    Result::Ok(())
  when LirTermKind::LirSwitch(vreg, arms, default_target) then
    let operand = thumb_emit_use(te, alloc, mdl_pool, vreg, pos, thumb_ip_reg())
    var ai = 0
    while ai < arms.len() do
      let arm = arms[ai]
      # Compare against the arm value and branch EQ to the arm block.
      # (The aarch64 route fuses value-0 arms onto cbz; the ARMv7-M
      # CBZ/CBNZ branch forward-only with a 62-byte range, so the
      # emitter compares and branches — each compare immediately
      # precedes its branch, and the next arm's compare overwrites the
      # flags, so invariant I1 holds. cbz fusion where the
      # direction and range are provable is not implemented.)
      thumb_emit_cmp_imm(te, operand, arm.value)
      thumb_emit_b_cond(te, thumb_cc(LirCond::LirEq), lir_block_label(fn_name, arm.target))
      ai = ai + 1
    end
    thumb_emit_b_uncond(te, lir_block_label(fn_name, default_target))
    Result::Ok(())
  when LirTermKind::LirRet(rv) then
    match rv
    when Option::Some(vreg) then
      # A float-class return operand — the return local's ordinary FP
      # vreg (alloc.fp_widths is the class table) — is the float-return
      # ABI shape of the cm float-ABI slice: the value crosses in the
      # VFP return register d0 (fixed float vreg 8), its low single s0
      # for an F32 — exactly the aarch64 route's V0 crossing (lir.tg's
      # Ret arm). A fixed FP ABI id (8..15) in the operand marks a
      # foreign lowering: the cortex-m lowering returns float values
      # through the return local's ORDINARY FP vreg only, and a fixed
      # id carries no width record — fail closed, never emit through
      # the general-register load path (whose fixed-vreg resolution
      # would read the id as a core register).
      if lir_is_fixed_fp_id(vreg) then
        return Result::Err("thumb: return of a float value from fixed FP vreg " + vreg.to_string() + " does not lower on the cortex-m route (the cortex-m lowering returns float values through the return local's ordinary FP vreg; a fixed FP id in a Ret marks a foreign lowering — fail-closed)")
      end
      match alloc.fp_widths.get(vreg)
      when Option::Some(w) then
        # Resolve the value at the terminator position: a register-
        # resident segment moves its d-register into the return
        # register at the width (VMOV d0, dd — skipped
        # when the value already rides d0); a memory-resident segment
        # (phys < 0, or a post-call reload record at the Ret —
        # invariant I2) loads its slot at the width straight into
        # d0/s0 (the return register is dead at the terminator, so the
        # direct load needs no temp). An F32 slot image is the
        # canonical single's 4 bytes in the vreg's 4-byte slot — the
        # single-form load is exact; an F64 slot image is the 8-byte
        # double in the two-word, 8-byte-aligned home the cm allocator
        # reserves for F64-class vregs (LirAlloc.slot_words), so the
        # double-form load into d0 is exact too. An F32 return is
        # always memory-resident on this route (the cm allocator's
        # memory-class rule — an F32 in the pool would have no
        # single-register alias above d15), so the register-resident
        # F32 form below marks an allocator-invariant violation and
        # fails closed.
        match alloc.segs_of.get(vreg)
        when Option::Some(segs) then
          match lir_seg_at(segs, pos)
          when Option::Some(s) then
            if s.phys >= 0 && !lir_reload_at(alloc.reloads, pos, vreg) then
              match w
              when LirFpWidth::LirF32 then
                return Result::Err("thumb: F32 return through an allocated FP-pool register (d8..d13) does not lower on the cortex-m route (the pool's doubles have no re-derived single alias in the float arms); the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 return marks an allocator-invariant violation (fail-closed)")
              when LirFpWidth::LirF64 then
                let dd = match thumb_fp_pool_d(s.phys, "the F64 return vreg " + vreg.to_string())
                when Result::Ok(d) then d
                when Result::Err(e) then return Result::Err(e)
                end
                if dd != 0 then
                  thumb_fp_reg_copy(te, w, 0, dd)
                end
              end
            else
              thumb_slot_fp_load(te, w, 0, s.slot)
            end
          when Option::None then
            return Result::Err("thumb: return vreg " + vreg.to_string() + " has no segment at position " + pos.to_string() + " (fail-closed)")
          end
        when Option::None then
          return Result::Err("thumb: return vreg " + vreg.to_string() + " has no intervals (fail-closed)")
        end
      when Option::None then
        let sr = thumb_emit_use(te, alloc, mdl_pool, vreg, pos, thumb_ip_reg())
        if sr != thumb_ret_reg() then
          t2_mov_rr(&mut te.buf, thumb_ret_reg(), sr)
        end
      end
    when Option::None then ()
    end
    thumb_emit_epilogue(te, frame_bytes)
    Result::Ok(())
  when LirTermKind::LirTrap then
    t2_udf(&mut te.buf)
    Result::Ok(())
  when LirTermKind::LirCall(target, args, stack_args, dest, success) then
    # Pre-call spill stores (register-resident values crossing the call).
    match thumb_emit_call_spills(te, alloc, mdl_pool, pos)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    # AAPCS caller-word cleanup: the LirPushArg statements before this
    # terminator lowered stack_args 4-byte words below SP (descending
    # argument order, even count — the lir_lower_call padding rule
    # keeps SP 8-byte aligned at the BL); add them back right after the
    # call so SP returns to the frame top for the success block.
    let is_extern = externs.contains(&target) || !defined.contains(&target)
    thumb_emit_bl(te, target, is_extern)
    if stack_args > 0 then
      let clean = 4 * stack_args
      if clean <= 508 then
        t2_add_sp_imm7(&mut te.buf, clean)
      else
        t2_movw(&mut te.buf, thumb_ip_reg(), (clean & 0xFFFF) as u16)
        t2_add_sp_w_reg(&mut te.buf, thumb_ip_reg())
      end
    end
    # Result capture: r0 -> dest (a fixed or ordinary vreg def at pos).
    # A FLOAT-class dest (the destination local's ordinary FP vreg in
    # alloc.fp_widths) is the float-return-call ABI shape: the callee
    # crossed its value in the VFP return register d0 (fixed float
    # vreg 8; s0 for an F32), and this arm captures it at the width —
    # mirroring lir.tg's aarch64 V0 capture — before the
    # general-register def-target machinery can touch the FP namespace.
    match dest
    when Option::Some(dv) then
      # A fixed FP ABI id (8..15) destination marks a foreign lowering:
      # the cortex-m lowering captures float call results into the
      # destination local's ORDINARY FP vreg only, and a fixed id
      # carries no width record — fail closed.
      if lir_is_fixed_fp_id(dv) then
        return Result::Err("thumb: call to `" + target + "` returns a float into fixed FP vreg " + dv.to_string() + ", which does not lower on the cortex-m route (the cortex-m lowering captures float call results into the destination local's ordinary FP vreg; a fixed FP id destination marks a foreign lowering — fail-closed)")
      end
      match alloc.fp_widths.get(dv)
      when Option::Some(w) then
        # The destination vreg defs at the call position (pos). A
        # register-resident def moves d0 into its d-register at the
        # width (VMOV — skipped when the destination IS d0, the
        # register the callee returned in); a memory-resident def
        # (phys < 0) stores the return register's image to its slot at
        # the width — the single-form VSTR lays the exact 4-byte image
        # of an F32, the double-form VSTR the exact 8-byte image of an
        # F64 (in the two-word, 8-byte-aligned home the cm allocator
        # reserves for F64-class vregs — LirAlloc.slot_words). An F32
        # destination is always memory-resident on this route (the cm
        # allocator's memory-class rule — an F32 in the pool would
        # have no single-register alias above d15), so the
        # register-resident F32 form below marks an allocator-invariant
        # violation and fails closed.
        match alloc.segs_of.get(dv)
        when Option::Some(segs) then
          match lir_seg_at(segs, pos)
          when Option::Some(s) then
            if s.phys >= 0 then
              match w
              when LirFpWidth::LirF32 then
                return Result::Err("thumb: call to `" + target + "` returns an F32 into an allocated FP-pool register (d8..d13), which does not lower on the cortex-m route (the pool's doubles have no re-derived single alias in the float arms); the cm allocator never assigns an F32 a pool register — F32 is memory-class on this route — so a pool-resident F32 result marks an allocator-invariant violation (fail-closed)")
              when LirFpWidth::LirF64 then
                let dd = match thumb_fp_pool_d(s.phys, "the call-result F64 vreg " + dv.to_string())
                when Result::Ok(d) then d
                when Result::Err(e) then return Result::Err(e)
                end
                if dd != 0 then
                  thumb_fp_reg_copy(te, w, dd, 0)
                end
              end
            else
              thumb_slot_fp_store(te, w, 0, s.slot)
            end
          when Option::None then
            return Result::Err("thumb: call result destination vreg " + dv.to_string() + " has no segment at position " + pos.to_string() + " (fail-closed)")
          end
        when Option::None then
          return Result::Err("thumb: call result destination vreg " + dv.to_string() + " has no intervals (fail-closed)")
        end
      when Option::None then
        let dt = thumb_def_target(alloc, mdl_pool, dv, pos)
        if dt.reg != thumb_ret_reg() then
          t2_mov_rr(&mut te.buf, dt.reg, thumb_ret_reg())
        end
        if dt.store_slot >= 0 then
          thumb_slot_store(te, mdl_pool, dt.reg, dt.store_slot)
        end
      end
    when Option::None then ()
    end
    thumb_emit_b_uncond(te, lir_block_label(fn_name, success))
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# Function emission (mirrors lir_emit_fn)
# ———————————————————————————————————————————————————————————————
# Prologue: PUSH {r4-r10, lr} (32 bytes, even word count — SP stays
# 8-aligned); sub sp, #frame (16-bit imm7 for small frames, movw +
# SUB.W sp, sp, r12 beyond); mov r7, sp. Spill slot i is [r7 + 4*i].
# The AAPCS stack parameters of a > 4-parameter function sit ABOVE the
# push block (32 bytes), the frame and — for an FP-content function —
# the VPUSH {d8-d15} block (64 bytes), so their machine offset from r7
# is thumb_stack_param_off(off, frame_bytes, fp_save) for the LIR's
# canonical payload `off` (see the LirLoadFrame arm); frame_bytes
# threads through the statement emitter for that translation.
# Epilogue (at every Ret): add sp, #frame; POP {r4-r10, lr}; BX LR.
# (AUDIT §16 — an @interrupt function, f.attr_interrupt, is emitted
# through the same geometry with the interrupt validation gate and the
# interrupt prologue — see the interrupt-ABI section above. Its
# epilogue is the same instruction sequence at every Ret: the POP
# restores the EXC_RETURN holder (the pushed LR slot) into LR and BX
# LR executes the desc's NVIC exit rule.)
# ———————————————————————————————————————————————————————————————
# AUDIT §16/§26 — the AAPCS32 variadic base-convention marshaller
# ———————————————————————————————————————————————————————————————
# A variadic extern call is made with the BASE convention: every
# argument — the fixed prefix and the §26 extras alike — is passed as
# its base-type words in r0..r3 and the caller's 4-byte word stream.
# An F64 argument (or an F32 extra after the C default promotion to
# the double image) is a double-word-aligned unit: the walk rounds
# NCRN up to an even register number and places the low word in the
# even register and the high word in the odd one, or — when the
# aligned even-odd pair does not fit r0..r3 — rounds NSAA up to an
# even word index and lays the unit's two words (little-endian: the
# low word at the lower address) on the caller stack. The caller's SP
# is padded to an even word count so it is 8-byte aligned at the BL.
#
# The shared LIR lowering has no variadic marker and marshals the call
# with the hard-float per-class walk (F64/F32 into fixed d0..d7, the
# stack stream at each argument's own width). This section re-derives
# the BASE walk from the call term's argument vreg list, maps every
# argument to the original LIR marshal statement that reads its source
# (so the allocator's segment/reload records stay authoritative — a
# source is ALWAYS resolved at its own original position), and emits
# the base crossings; the block's original marshal statements are
# skipped. The re-marshalling never invents a vreg: it only reads the
# call's own argument vregs and writes the fixed ABI registers/r0..r3
# and the caller stack area, exactly the traffic the allocator already
# modeled.

struct ThumbVarArgAction
  kind: Int          # 0 gp word, 1 gp f64 pair, 2 stack word, 3 stack f64
  vreg: Int
  src_pos: Int
  a: Int             # gp register (0/1) or stack word index (2/3)
  b: Int             # the pair's second gp register (kind 1)
  w: LirFpWidth
end

struct ThumbVarArgPlan
  actions: Vec[ThumbVarArgAction]
  stack_words: Int
  skip: Set[Int]
end

# Plan one variadic call block: re-run the LIR's original per-class
# cm walk to map every argument to its source-reading marshal statement
# (register moves in argument order, then the descending push stream
# with its interleaved F64 alignment pads and the even-word top pad),
# then re-run the harness's BASE walk and return the action list, the
# total caller-stack word count and the set of marshal statements the
# caller must skip. Any divergence between the walk and the statements
# fails closed (never a partially re-marshalled call).
def thumb_var_call_plan(f: LirFunction, stmts: Vec[LirStmt], term_pos: Int, args: Vec[Int]) -> Result[ThumbVarArgPlan, String]
  let block_base = term_pos - stmts.len()
  var gp_moves: Vec[Int] = Vec::new()
  var gp_move_pos: Vec[Int] = Vec::new()
  var fp_moves: Vec[Int] = Vec::new()
  var fp_move_pos: Vec[Int] = Vec::new()
  var push_pos: Vec[Int] = Vec::new()
  var si = 0
  while si < stmts.len() do
    let stmt = stmts[si]
    match stmt.kind
    when LirStmtKind::LirMove(dst, val) then
      if dst < lir_first_alloc_vreg() then
        match val
        when LirValue::LirReg(src) then
          gp_moves.push(src)
          gp_move_pos.push(block_base + si)
        when _ then
          return Result::Err("thumb: " + f.name + ": variadic call marshal move into fixed vreg " + dst.to_string() + " is not a register move (lowering/backend divergence — fail-closed)")
        end
      end
    when LirStmtKind::LirFMove(dst, src) then
      if lir_is_fixed_fp_id(dst) then
        fp_moves.push(src)
        fp_move_pos.push(block_base + si)
      end
    when LirStmtKind::LirPushArg(_) then
      push_pos.push(block_base + si)
    when _ then ()
    end
    si = si + 1
  end
  # The original per-class cm walk: register-class general arguments
  # consume the fixed r0..r3 moves in argument order and register-class
  # floats the fixed d0..d7 moves; the overflow of either class joins
  # the shared 4-byte stack stream (an F64 a two-word unit at an even
  # word index with an inserted pad below it).
  var gp_pos = 0
  var fp_pos = 0
  var stk_pos = 0
  var gp_mi = 0
  var fp_mi = 0
  var arg_kind: Vec[Int] = Vec::new()     # 0 gp reg, 1 fp reg, 2 stack
  var arg_aux: Vec[Int] = Vec::new()      # register position or original stack position
  var arg_src_pos: Vec[Int] = Vec::new()
  var pad_words: Set[Int] = Set::new()
  var ai = 0
  while ai < args.len() do
    let vreg = args[ai]
    match f.fp_widths.get(vreg)
    when Option::Some(w) then
      if fp_pos < 8 then
        arg_kind.push(1)
        arg_aux.push(fp_pos)
        if fp_mi >= fp_moves.len() then
          return Result::Err("thumb: " + f.name + ": variadic call FLOAT argument " + ai.to_string() + " (vreg " + vreg.to_string() + ") has no register marshal statement (lowering/backend divergence — fail-closed)")
        end
        if fp_moves[fp_mi] != vreg then
          return Result::Err("thumb: " + f.name + ": variadic call FLOAT argument " + ai.to_string() + " (vreg " + vreg.to_string() + ") does not match its register marshal statement (vreg " + fp_moves[fp_mi].to_string() + ") — lowering/backend divergence (fail-closed)")
        end
        arg_src_pos.push(fp_move_pos[fp_mi])
        fp_mi = fp_mi + 1
      else
        arg_kind.push(2)
        if w == LirFpWidth::LirF64 then
          if stk_pos % 2 != 0 then
            pad_words.insert(stk_pos)
            stk_pos = stk_pos + 1
          end
        end
        arg_aux.push(stk_pos)
        arg_src_pos.push(-1)
        if w == LirFpWidth::LirF64 then
          stk_pos = stk_pos + 2
        else
          stk_pos = stk_pos + 1
        end
      end
      fp_pos = fp_pos + 1
    when Option::None then
      if gp_pos < 4 then
        arg_kind.push(0)
        arg_aux.push(gp_pos)
        if gp_mi >= gp_moves.len() then
          return Result::Err("thumb: " + f.name + ": variadic call INTEGER argument " + ai.to_string() + " (vreg " + vreg.to_string() + ") has no register marshal statement (lowering/backend divergence — fail-closed)")
        end
        if gp_moves[gp_mi] != vreg then
          return Result::Err("thumb: " + f.name + ": variadic call INTEGER argument " + ai.to_string() + " (vreg " + vreg.to_string() + ") does not match its register marshal statement (vreg " + gp_moves[gp_mi].to_string() + ") — lowering/backend divergence (fail-closed)")
        end
        arg_src_pos.push(gp_move_pos[gp_mi])
        gp_mi = gp_mi + 1
      else
        arg_kind.push(2)
        arg_aux.push(stk_pos)
        arg_src_pos.push(-1)
        stk_pos = stk_pos + 1
      end
      gp_pos = gp_pos + 1
    end
    ai = ai + 1
  end
  if gp_mi != gp_moves.len() then
    return Result::Err("thumb: " + f.name + ": variadic call leaves " + (gp_moves.len() - gp_mi).to_string() + " unclaimed INTEGER register marshal statement(s) — lowering/backend divergence (fail-closed)")
  end
  if fp_mi != fp_moves.len() then
    return Result::Err("thumb: " + f.name + ": variadic call leaves " + (fp_moves.len() - fp_mi).to_string() + " unclaimed FLOAT register marshal statement(s) — lowering/backend divergence (fail-closed)")
  end
  # Map each stack-class argument's original stack position to its push
  # statement: the LIR emits the even-word top pad first, then the
  # descending stack-position walk (one push per stack argument, plus
  # one pad push immediately after an F64 unit whose base index was
  # odd).
  var push_idx = 0
  if stk_pos % 2 != 0 then
    push_idx = 1
  end
  var pi = args.len()
  while pi > 0 do
    pi = pi - 1
    if arg_kind[pi] == 2 then
      if push_idx >= push_pos.len() then
        return Result::Err("thumb: " + f.name + ": variadic call stack argument " + pi.to_string() + " has no push marshal statement (lowering/backend divergence — fail-closed)")
      end
      arg_src_pos[pi] = push_pos[push_idx]
      push_idx = push_idx + 1
      if pad_words.contains(&(arg_aux[pi] - 1)) then
        if push_idx >= push_pos.len() then
          return Result::Err("thumb: " + f.name + ": variadic call F64 alignment pad for stack argument " + pi.to_string() + " has no push marshal statement (lowering/backend divergence — fail-closed)")
        end
        push_idx = push_idx + 1
      end
    end
  end
  if push_idx != push_pos.len() then
    return Result::Err("thumb: " + f.name + ": variadic call push stream does not match the LIR walk (" + push_idx.to_string() + " vs " + push_pos.len().to_string() + " statements) — lowering/backend divergence (fail-closed)")
  end
  # The BASE walk: NCRN/NSAA as documented above (the fixed prefix and
  # the extras are one stream, exactly the AAPCS32 rule).
  var actions: Vec[ThumbVarArgAction] = Vec::new()
  var ncrn = 0
  var nsaa = 0
  ai = 0
  while ai < args.len() do
    let vreg = args[ai]
    match f.fp_widths.get(vreg)
    when Option::Some(w) then
      if ncrn % 2 != 0 then
        ncrn = ncrn + 1
      end
      if ncrn <= 2 then
        actions.push(ThumbVarArgAction { kind: 1, vreg: vreg, src_pos: arg_src_pos[ai], a: ncrn, b: ncrn + 1, w: w })
        ncrn = ncrn + 2
      else
        if nsaa % 2 != 0 then
          nsaa = nsaa + 1
        end
        actions.push(ThumbVarArgAction { kind: 3, vreg: vreg, src_pos: arg_src_pos[ai], a: nsaa, b: 0, w: w })
        nsaa = nsaa + 2
      end
    when Option::None then
      if ncrn < 4 then
        actions.push(ThumbVarArgAction { kind: 0, vreg: vreg, src_pos: arg_src_pos[ai], a: ncrn, b: 0, w: LirFpWidth::LirF64 })
        ncrn = ncrn + 1
      else
        actions.push(ThumbVarArgAction { kind: 2, vreg: vreg, src_pos: arg_src_pos[ai], a: nsaa, b: 0, w: LirFpWidth::LirF64 })
        nsaa = nsaa + 1
      end
    end
    ai = ai + 1
  end
  var total = nsaa
  if total % 2 != 0 then
    total = total + 1
  end
  var skip: Set[Int] = Set::new()
  var mi = 0
  while mi < gp_move_pos.len() do
    skip.insert(gp_move_pos[mi])
    mi = mi + 1
  end
  mi = 0
  while mi < fp_move_pos.len() do
    skip.insert(fp_move_pos[mi])
    mi = mi + 1
  end
  mi = 0
  while mi < push_pos.len() do
    skip.insert(push_pos[mi])
    mi = mi + 1
  end
  Result::Ok(ThumbVarArgPlan { actions: actions, stack_words: total, skip: skip })
end

# Resolve a variadic float argument to a D-INDEX holding the double
# image the base convention passes: the F64 source itself, or the §26
# promoted image of an F32 extra. The F32 -> F64 promotion is a real
# VCVT (vcvt.f64.f32) and therefore needs the double-precision VFP
# data-processing unit (cortex-m7 / FPv5-D16); on the FPv4-SP/FPv5-SP
# cortex-m4f instances the promotion does not lower and fails closed
# (the F64 load/store/transfer subset cannot convert).
def thumb_var_f64_use(inout te: ThumbEmit, alloc: LirAlloc, w: LirFpWidth, vreg: Int, pos: Int, role: String) -> Result[Int, String]
  if w == LirFpWidth::LirF64 then
    return thumb_fp_use_reg(te, alloc, LirFpWidth::LirF64, vreg, pos, thumb_fp_use_scratch(LirFpWidth::LirF64), role)
  end
  if !te.f64dp then
    return Result::Err("thumb: variadic float argument (vreg " + vreg.to_string() + ") is an F32 extra of a variadic extern call: the C default argument promotion F32 -> F64 needs vcvt.f64.f32 (double-precision VFP), which the `" + te.desc_name + "` descriptor does not provide — the FPv4-SP/FPv5-SP FPUs carry only the F64 load/store/transfer subset; pass an F64 extra explicitly — fail-closed")
  end
  let ss = match thumb_fp_use_reg(te, alloc, LirFpWidth::LirF32, vreg, pos, thumb_fp_use_scratch(LirFpWidth::LirF32), role)
  when Result::Ok(r) then r
  when Result::Err(e) then return Result::Err(e)
  end
  t2_vcvt_f64_f32(&mut te.buf, thumb_fp_scratch_d(), ss)
  Result::Ok(thumb_fp_scratch_d())
end

# Store the general word in `sr` at the base convention's caller-stack
# word `unit` ([sp + 4*unit] — the whole area was reserved once).
def thumb_var_stack_word(inout te: ThumbEmit, sr: Int, unit: Int) -> Unit
  if unit == 0 then
    if sr <= 7 then
      t2_str_sp_imm8(&mut te.buf, sr, 0)
    else
      t2_str_w_imm12(&mut te.buf, sr, thumb_sp_reg(), 0)
    end
  else
    t2_str_w_imm12(&mut te.buf, sr, thumb_sp_reg(), 4 * unit)
  end
end

# Emit one variadic call block: non-marshal statements normally, then —
# with the caller's stack area reserved in one sub — the base-convention
# crossings re-derived by the plan, then the call itself (spills, BL,
# cleanup for the base word count, result capture, branch). The source
# reads resolve at each argument's ORIGINAL statement position, so the
# allocator's segment/reload records stay exact; only fixed ABI
# registers and the caller stack area are written.
def thumb_emit_var_call_block(inout te: ThumbEmit, alloc: LirAlloc, mdl_pool: Vec[Int], f: LirFunction, stmts: Vec[LirStmt], term: LirTerm, frame_bytes: Int, block_pos: Int, externs: Set[String], defined: Set[String]) -> Result[Unit, String]
  let term_pos = block_pos + stmts.len()
  match term.kind
  when LirTermKind::LirCall(target, args, _orig_stack, dest, success) then
    let plan = match thumb_var_call_plan(f, stmts.clone(), term_pos, args.clone())
    when Result::Ok(p) then p
    when Result::Err(e) then return Result::Err(e)
    end
    var si = 0
    while si < stmts.len() do
      let spos = block_pos + si
      if !plan.skip.contains(&spos) then
        match thumb_emit_stmt(te, alloc, mdl_pool, frame_bytes, f.name.clone(), stmts[si].clone(), spos)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
      si = si + 1
    end
    if plan.stack_words > 0 then
      let bytes = 4 * plan.stack_words
      if bytes <= 508 then
        t2_sub_sp_imm7(&mut te.buf, bytes)
      else
        t2_movw(&mut te.buf, thumb_ip_reg(), (bytes & 0xFFFF) as u16)
        t2_sub_sp_w_reg(&mut te.buf, thumb_ip_reg())
      end
    end
    var ai = 0
    while ai < plan.actions.len() do
      let act = plan.actions[ai]
      match act.kind
      when 0 then
        let sr = thumb_emit_use(te, alloc, mdl_pool, act.vreg, act.src_pos, thumb_ip_reg())
        if act.a != sr then
          t2_mov_rr(&mut te.buf, act.a, sr)
        end
      when 1 then
        let fd = match thumb_var_f64_use(te, alloc, act.w, act.vreg, act.src_pos, "variadic F64 pair extra")
        when Result::Ok(r) then r
        when Result::Err(e) then return Result::Err(e)
        end
        t2_vmov_d_to_gp_pair(&mut te.buf, act.a, act.b, fd)
      when 2 then
        let sr = thumb_emit_use(te, alloc, mdl_pool, act.vreg, act.src_pos, thumb_ip_reg())
        thumb_var_stack_word(te, sr, act.a)
      when 3 then
        let fd = match thumb_var_f64_use(te, alloc, act.w, act.vreg, act.src_pos, "variadic F64 stack extra")
        when Result::Ok(r) then r
        when Result::Err(e) then return Result::Err(e)
        end
        t2_vstr_f64(&mut te.buf, fd, thumb_sp_reg(), 4 * act.a)
      end
      ai = ai + 1
    end
    match thumb_emit_term(te, alloc, mdl_pool, f.name.clone(), frame_bytes, LirTermKind::LirCall(target.clone(), args.clone(), plan.stack_words, dest, success), term_pos, externs, defined)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    Result::Ok(())
  when _ then
    Result::Err("thumb: internal: thumb_emit_var_call_block on a non-call terminator (fail-closed)")
  end
end

def thumb_emit_fn(inout te: ThumbEmit, mdl_pool: Vec[Int], desc: TargetDesc, f: LirFunction, alloc: LirAlloc, externs: Set[String], defined: Set[String], variadic_externs: Set[String]) -> Result[Unit, String]
  match thumb_validate_fn(f, desc)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  # AUDIT §16 — the desc-driven FP gate: VFP instructions may be
  # emitted only against an FPU-carrying hard-float descriptor (the
  # cortex-m4f/cortex-m7 instances). A function whose allocation
  # carries float content (fp_widths beyond the TWO unconditional
  # FP statement scratches — see thumb_alloc_has_fp_content) fails
  # closed against a no-FPU descriptor — never a VFP byte for a core
  # without an FPU. (The float shape checks of thumb_validate_fn stay
  # shape-level; this gate is the desc-driven admission.)
  if !thumb_desc_has_fp(desc) then
    if thumb_alloc_has_fp_content(alloc) then
      return Result::Err("thumb: function " + f.name + " carries float content (VFP registers/images), which does not lower against the `" + desc.name + "` description — fpu None, float_abi Soft: the cortex-m float slice requires an FPU-carrying hard-float descriptor (cortex-m4f or cortex-m7; the M3/M4 cores have no FPU and must not receive VFP instructions — fail-closed)")
    end
  end
  # AUDIT §16/§26 — the variadic call base-convention marshalling is
  # re-derived at emission (see thumb_emit_var_call_block); no
  # float-class variadic rejection remains. A function whose allocation
  # carries FP content still passes the desc-driven FP gate above (a
  # variadic F64/F32 extra is an FP-class vreg, so an FPU-less/M3/M4
  # descriptor fails closed there before any byte is emitted).
  #
  # Frame bound: slot offsets are 4*slot; the frame is 8-aligned and the
  # address path covers offsets up to 0xFFFF (movw) — 16382 slots max
  # (4*16382 = 65528 bytes, the largest 8-aligned frame under 0x10000).
  if alloc.slots > 16382 then
    return Result::Err("thumb: function " + f.name + " needs " + alloc.slots.to_string() + " spill slots — larger than the 32-bit cortex-m frame model supports (fail-closed)")
  end
  let frame_bytes = thumb_frame_bytes(alloc.slots)

  # Symbol + entry label. (P1-18 @cold): the declared hint rides the
  # LIR record (LirFunction.attr_cold — stamped from MirFunction at
  # lowering); the symbol routes into the cold section when set.
  thumb_emit_fn_symbol(te, f.name.clone(), f.attr_cold)
  def_label(&mut te.buf, f.name.clone())

  # AUDIT §16 — the interrupt (NVIC handler) gate: an @interrupt
  # function's shape is validated against the desc's modeled interrupt
  # ABI BEFORE any byte is emitted, and the function is emitted with
  # the interrupt prologue. The instruction sequence is the ordinary
  # frame sequence — on ARMv7-M the PUSH {r4-r10, lr} / POP {r4-r10,
  # lr}; BX LR discipline IS the handler discipline (the LR slot is
  # the EXC_RETURN holder; see the interrupt-ABI section above) — so
  # ordinary functions and handlers share the frame geometry and the
  # epilogue at every Ret.
  var is_interrupt = f.attr_interrupt
  if is_interrupt then
    match thumb_validate_interrupt_fn(f, desc)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
  end
  # Prologue: PUSH {r4-r10, lr}; sub sp, #frame; mov r7, sp. For an
  # @interrupt function this is the NVIC handler prologue (the entry
  # LR — EXC_RETURN — lands in the push block's LR slot before any BL
  # can clobber LR; the body may clobber r0-r3/r12, which the NVIC
  # frame already auto-saved).
  #
  # FP CALLEE-SAVES (the M-profile d8..d15 block): a function whose
  # allocation carries FP content emits VPUSH {d8-d15} (64 bytes,
  # 8-aligned — SP stays AAPCS-aligned) right after the GP push and
  # BEFORE the frame build, so r7 = SP keeps the frame displacement and
  # the epilogue's add-sp/POP order is the exact reverse. The block
  # saves the allocatable F64 pool d8..d13 AND the d14/d15 statement
  # scratches — all callee-saved under AAPCS32 — so external callers'
  # s16..s31 values survive the call, and the PUSH {r4-r10, lr} mirror
  # is complete: the whole allocatable register set this backend can
  # touch is preserved. (@interrupt handlers take the same block: the
  # hardware's lazy FP context save already protects the preempted
  # context's FP registers; the block keeps the handler's own frame
  # discipline uniform with ordinary functions.)
  let fp_save = thumb_desc_has_fp(desc) && thumb_alloc_has_fp_content(alloc)
  te.f64dp = target_desc_f64_data_processing(desc)
  te.fp_save = fp_save
  te.desc_name = desc.name.clone()
  if is_interrupt then
    thumb_emit_interrupt_prologue(te, frame_bytes, fp_save)
  else
    t2_push_w(&mut te.buf, thumb_saved_reg_list())
    if fp_save then
      t2_vpush_d(&mut te.buf, 8, 8)
    end
    if frame_bytes > 0 then
      if frame_bytes <= 508 then
        t2_sub_sp_imm7(&mut te.buf, frame_bytes)
      else
        t2_movw(&mut te.buf, thumb_ip_reg(), (frame_bytes & 0xFFFF) as u16)
        t2_sub_sp_w_reg(&mut te.buf, thumb_ip_reg())
      end
    end
    t2_mov_rr(&mut te.buf, thumb_fp_reg(), thumb_sp_reg())
  end

  # Blocks, in order, with the SAME position walk the allocator used
  # (invariant I3). A block whose terminator is a call to a VARIADIC
  # extern takes the base-convention re-marshalling path
  # (thumb_emit_var_call_block): the original hard-float marshal
  # statements are skipped and the whole call's AAPCS32 base crossings
  # are re-derived, while the position walk (and therefore every
  # segment/reload query) stays identical.
  var pos = 0
  var bi = 0
  while bi < f.blocks.len() do
    let b = f.blocks[bi]
    def_label(&mut te.buf, lir_block_label(f.name.clone(), b.id))
    var is_var_call = false
    match b.term.kind
    when LirTermKind::LirCall(target, _, _, _, _) then
      if variadic_externs.contains(&target) then
        is_var_call = true
      end
    when _ then ()
    end
    if is_var_call then
      match thumb_emit_var_call_block(te, alloc, mdl_pool, f, b.stmts.clone(), b.term.clone(), frame_bytes, pos, externs, defined)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    else
      var si = 0
      while si < b.stmts.len() do
        match thumb_emit_stmt(te, alloc, mdl_pool, frame_bytes, f.name.clone(), b.stmts[si].clone(), pos)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        pos = pos + 1
        si = si + 1
      end
      match thumb_emit_term(te, alloc, mdl_pool, f.name.clone(), frame_bytes, b.term.kind, pos, externs, defined)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
    pos = pos + 1
    bi = bi + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Deferred patch resolution
# ———————————————————————————————————————————————————————————————
# Runs after the whole program is emitted, when every function and block
# label is defined. Every patch is a 32-bit B.W/BL whose imm24 was
# emitted as 0; the final word is recomputed for the actual offset and
# written back over the four bytes. Range overflow is fail-closed (a
# +/-16 MiB branch cannot be reached by any realistic function, but a
# wrong short branch would silently corrupt code).

def thumb_patch_word(inout te: ThumbEmit, offset: Int, word: u32) -> Unit
  let hw1 = (word >> 16) & 0xFFFF
  let hw2 = word & 0xFFFF
  te.buf.bytes[offset] = (hw1 & 0xFF) as u8
  te.buf.bytes[offset + 1] = ((hw1 >> 8) & 0xFF) as u8
  te.buf.bytes[offset + 2] = (hw2 & 0xFF) as u8
  te.buf.bytes[offset + 3] = ((hw2 >> 8) & 0xFF) as u8
end

def thumb_resolve_patches(inout te: ThumbEmit) -> Result[Unit, String]
  var pi = 0
  while pi < te.patches.len() do
    let p = te.patches[pi]
    match te.buf.labels.get(p.label.clone())
    when Option::Some(target) then
      let rel = target - (p.offset + 4)
      if rel < -16777216 || rel > 16777214 || (rel % 2) != 0 then
        return Result::Err("thumb: branch to `" + p.label + "` is out of the +/-16 MiB Thumb-2 branch range (offset " + rel.to_string() + "); fail-closed")
      end
      let base = (if p.is_bl then 0xF800 else 0x9000 end) as u32
      thumb_patch_word(te, p.offset, t2_branch24_word(rel, base))
    when Option::None then
      return Result::Err("thumb: internal error: branch target `" + p.label + "` was never defined (fail-closed)")
    end
    pi = pi + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# ELF32 ARM (EM_ARM = 40) relocatable-object writer
# ———————————————————————————————————————————————————————————————
# Emits the machine code buffer as a REAL elf32-littlearm relocatable
# object, mirroring the layout clang/LLVM produces (verified against
# clang -target thumbv7em-none-eabi output):
#   e_type ET_REL, e_machine EM_ARM (40), e_flags 0x05000000 (EABI5);
#   one shared string table that carries BOTH the section names and the
#   symbol names (e_shstrndx = its index — the clang convention, no
#   separate .shstrtab);
#   .text (PROGBITS, AX, align 4), .data (PROGBITS, AW, align 4 — the
#   static scalar images, present only when the program has statics),
#   .rel.text (SHT_REL — R_ARM_THM_CALL = 10 entries for extern calls
#   and R_ARM_THM_MOVW_ABS_NC = 47 / R_ARM_THM_MOVT_ABS = 48 pairs for
#   the static-value loads, align 4), .symtab (align 4, entsize 16),
#   .strtab;
#   "$t" mapping symbols mark the Thumb code regions so GNU/LLVM
#   disassemblers and linkers see Thumb state;
#   extern call targets are undefined global symbols resolved by the
#   linker through the R_ARM_THM_CALL relocations, and the static
#   images are global STT_OBJECT symbols in .data resolved by the
#   MOVW/MOVT absolute-address relocation pairs.

def thumb_w8(inout out: Vec[u8], v: u32) -> Unit
  out.push((v & 0xFF) as u8)
end

def thumb_w16(inout out: Vec[u8], v: u32) -> Unit
  out.push((v & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
end

def thumb_w32(inout out: Vec[u8], v: u32) -> Unit
  out.push((v & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
  out.push(((v >> 16) & 0xFF) as u8)
  out.push(((v >> 24) & 0xFF) as u8)
end

def thumb_align4(inout out: Vec[u8]) -> Unit
  while (out.len() % 4) != 0 do
    out.push(0)
  end
end

# An ELF32 string table appended to `out`; returns the offset of each
# string so callers can fill sh_name/st_name fields. The first byte is
# the mandatory NUL.
def thumb_strtab_add(inout out: Vec[u8], names: Vec[String]) -> Vec[Int]
  var offsets: Vec[Int] = Vec::new()
  var oi = 0
  while oi < names.len() do
    let off = out.len()
    offsets.push(off)
    let name_bytes = names[oi].bytes()
    var ci = 0
    while ci < name_bytes.len() do
      out.push(name_bytes[ci])
      ci = ci + 1
    end
    out.push(0)
    oi = oi + 1
  end
  offsets
end

# Build the object bytes. `fns` = (name, code offset) pairs in program
# order; `datas` = (name, data offset, size) triples of the emitted
# static images (program order); `exts` = extern names in program
# order; `relocs` = the relocation sites (offset, symbol, ELF ARM type)
# over the whole code buffer; `code` = the code bytes; `data` = the
# .data bytes. `cold_base` = the code offset where the @cold region
# begins (-1 when the program has no @cold functions — see
# thumb_compile_object's deferred cold pass). The code stream is ONE
# buffer; the writer splits it at cold_base into two real executable
# sections — .text (the hot bytes) and .text.cold (the @cold tail,
# PROGBITS AX, the same profile as .text), each with its own section
# name, symbol-table entries (fn values rebased into the cold section)
# and relocation section (.rel.text.cold for the sites inside the
# tail). Objects without @cold code keep the exact pre-@cold layout.
# (AUDIT §16 — the .isr_vector table): `vec_words` is the word count
# of the NVIC vector table (0 = the program has no @interrupt
# functions — no .isr_vector section is emitted and the object layout
# is byte-identical to the pre-slice shape) and `vec_word_syms` the
# (word index, symbol name) pairs whose table words carry R_ARM_ABS32
# relocations against the program's function symbols (see the
# interrupt-ABI section above for the layout: word 0 = the initial-MSP
# placeholder, word 1 = the reset entry — relocated to the program's
# `_reset_handler` when it defines one, else the zero placeholder —
# words 2.. = the @interrupt handlers in declaration order). The words
# are emitted as the zero image (the in-place addend of each
# relocation is 0); every table word without a relocation is a
# startup/board placeholder.
# The section layout (the clang-verified shape with the optional
# sections inserted in index order):
#   0 null, 1 strtab (shared name table, e_shstrndx), 2 .text,
#   3 .text.cold (only when cold_base >= 0), then .data (only when
#   statics emitted), .rel.text (only when hot relocations exist),
#   .rel.text.cold (only when cold relocations exist), then
#   .isr_vector (only when vec_words > 0), .rel.isr_vector (only when
#   vector relocations exist), .symtab LAST.
def thumb_elf32_obj(code: Vec[u8], fns: Vec[(String, Int)], datas: Vec[(String, Int, Int)], exts: Vec[String], relocs: Vec[ThumbReloc], data: Vec[u8], cold_base: Int, vec_words: Int, vec_word_syms: Vec[(Int, String)]) -> Vec[u8]
  let has_cold = cold_base >= 0 && cold_base < code.len()
  let hot_size = if has_cold then cold_base else code.len() end
  let cold_size = code.len() - hot_size
  # Partition the relocations by site: a site in the cold region
  # ([cold_base, len) — an extern call or static reference from an
  # @cold body) belongs to .rel.text.cold with its offset rebased into
  # that section.
  var rel_hot: Vec[ThumbReloc] = Vec::new()
  var rel_cold: Vec[ThumbReloc] = Vec::new()
  var rpi = 0
  while rpi < relocs.len() do
    let r = relocs[rpi]
    if has_cold && r.offset >= cold_base then
      rel_cold.push(ThumbReloc { offset: r.offset - cold_base, sym: r.sym.clone(), kind: r.kind })
    else
      rel_hot.push(ThumbReloc { offset: r.offset, sym: r.sym.clone(), kind: r.kind })
    end
    rpi = rpi + 1
  end
  let has_rel_hot = rel_hot.len() > 0
  let has_rel_cold = rel_cold.len() > 0
  let has_data = data.len() > 0
  let has_vec = vec_words > 0
  # A vector-relocation table exists only when the vector section does
  # (a caller passing words with a zero word count is a contract
  # violation — collapsed defensively so a broken table can never be
  # emitted).
  let has_rel_vec = has_vec && vec_word_syms.len() > 0
  let vec_size = vec_words * 4
  let rel_vec_size = vec_word_syms.len() * 8
  let n_sections = 4 + (if has_cold then 1 else 0 end) + (if has_data then 1 else 0 end) + (if has_rel_hot then 1 else 0 end) + (if has_rel_cold then 1 else 0 end) + (if has_vec then 1 else 0 end) + (if has_rel_vec then 1 else 0 end)
  # Section indexes: 0 null, 1 strtab, 2 .text, 3 .text.cold
  # (optional), then .data (optional), .rel.text (optional),
  # .rel.text.cold (optional), .isr_vector (optional),
  # .rel.isr_vector (optional), .symtab last.
  let text_idx = 2
  let text_cold_idx = if has_cold then 3 else -1 end
  let data_idx = 3 + (if has_cold then 1 else 0 end)
  # .isr_vector's section index: the section opens right after the last
  # pre-vector optional section (.text is index 2; then .text.cold,
  # .data, .rel.text, .rel.text.cold — when present — occupy the
  # indexes 3..; the vector table follows them).
  let vec_idx = 3 + (if has_cold then 1 else 0 end) + (if has_data then 1 else 0 end) + (if has_rel_hot then 1 else 0 end) + (if has_rel_cold then 1 else 0 end)
  let rel_vec_idx = if has_rel_vec then vec_idx + 1 else -1 end
  let symtab_idx = n_sections - 1

  # Symbol plan (ELF ordering: locals first, then globals — sh_info is
  # the first global index): null; one "$t" local per function; the
  # function globals, then the .data static globals, then the extern
  # undefined globals.
  var local_names: Vec[String] = Vec::new()   # "$t" per function
  var global_names: Vec[String] = Vec::new()  # fns then datas then exts
  var fi = 0
  while fi < fns.len() do
    local_names.push("$t".to_string())
    global_names.push(fns[fi].0.clone())
    fi = fi + 1
  end
  var di = 0
  while di < datas.len() do
    global_names.push(datas[di].0.clone())
    di = di + 1
  end
  var ei = 0
  while ei < exts.len() do
    global_names.push(exts[ei].clone())
    ei = ei + 1
  end
  let n_syms = 1 + local_names.len() + global_names.len()
  let first_global = 1 + local_names.len()

  # Section names (in the same string table): the table itself opens
  # with a NUL, then the section names (in section-index order), then
  # every symbol name. The sec_offs positions are captured per section
  # by the append order.
  var strtab: Vec[u8] = Vec::new()
  strtab.push(0)
  var sec_names: Vec[String] = Vec::new()
  sec_names.push(".text".to_string())
  if has_cold then
    sec_names.push(".text.cold".to_string())
  end
  if has_data then
    sec_names.push(".data".to_string())
  end
  if has_rel_hot then
    sec_names.push(".rel.text".to_string())
  end
  if has_rel_cold then
    sec_names.push(".rel.text.cold".to_string())
  end
  if has_vec then
    sec_names.push(".isr_vector".to_string())
  end
  if has_rel_vec then
    sec_names.push(".rel.isr_vector".to_string())
  end
  sec_names.push(".symtab".to_string())
  sec_names.push(".strtab".to_string())
  let sec_offs = thumb_strtab_add(strtab, sec_names)
  let text_name_idx = 0
  let text_cold_name_idx = if has_cold then 1 else -1 end
  let data_name_idx = if has_data then (if has_cold then 2 else 1 end) else -1 end
  let rel_name_idx = if has_rel_hot then (if has_cold then 1 else 0 end) + (if has_data then 1 else 0 end) + 1 else -1 end
  let rel_cold_name_idx = if has_rel_cold then (if has_cold then 1 else 0 end) + (if has_data then 1 else 0 end) + (if has_rel_hot then 1 else 0 end) + 1 else -1 end
  let vec_name_idx = if has_vec then (if has_cold then 1 else 0 end) + (if has_data then 1 else 0 end) + (if has_rel_hot then 1 else 0 end) + (if has_rel_cold then 1 else 0 end) + 1 else -1 end
  let rel_vec_name_idx = if has_rel_vec then vec_name_idx + 1 else -1 end
  let symtab_name_idx = sec_names.len() - 2
  let strtab_name_idx = sec_names.len() - 1
  var sym_names: Vec[String] = Vec::new()
  var si2 = 0
  while si2 < local_names.len() do
    sym_names.push(local_names[si2].clone())
    si2 = si2 + 1
  end
  var gi2 = 0
  while gi2 < global_names.len() do
    sym_names.push(global_names[gi2].clone())
    gi2 = gi2 + 1
  end
  let sym_offs = thumb_strtab_add(strtab, sym_names)
  let strtab_size = strtab.len()

  # File offsets (ehdr 52; sections 4-aligned) — .text, then
  # .text.cold (directly after — the code stream's byte order is
  # preserved in the file), then .data, then .rel.text, then
  # .rel.text.cold, then .isr_vector (the zero word image), then
  # .rel.isr_vector, then .symtab, then the strtab, then the section
  # headers. When no vector sections exist every offset below collapses
  # to the pre-slice value (off_vec/off_rel_vec equal the old off_sym).
  let off_text = 52
  let off_cold = off_text + hot_size
  let off_data = thumb_align_4_of(off_cold + cold_size)
  let data_size = data.len()
  let off_rel = thumb_align_4_of(off_data + data_size)
  let rel_size = rel_hot.len() * 8
  let off_rel_cold = thumb_align_4_of(off_rel + rel_size)
  let rel_cold_size = rel_cold.len() * 8
  let off_vec = thumb_align_4_of(off_rel_cold + rel_cold_size)
  let off_rel_vec = thumb_align_4_of(off_vec + vec_size)
  let off_sym = thumb_align_4_of(off_rel_vec + rel_vec_size)
  let sym_size = n_syms * 16
  let off_str = thumb_align_4_of(off_sym + sym_size)
  let off_sh = thumb_align_4_of(off_str + strtab_size)

  var out: Vec[u8] = Vec::new()
  # ELF header (52 bytes).
  out.push(0x7F); out.push(0x45); out.push(0x4C); out.push(0x46)
  out.push(1)   # ELFCLASS32
  out.push(1)   # ELFDATA2LSB
  out.push(1)   # EV_CURRENT
  var zi = 0
  while zi < 9 do
    out.push(0)
    zi = zi + 1
  end
  thumb_w16(out, 1)          # e_type = ET_REL
  thumb_w16(out, 40)         # e_machine = EM_ARM
  thumb_w32(out, 1)          # e_version
  thumb_w32(out, 0)          # e_entry
  thumb_w32(out, 0)          # e_phoff
  thumb_w32(out, off_sh as u32)  # e_shoff
  thumb_w32(out, 0x05000000) # e_flags = EF_ARM_ABI_VER5 (EABI5)
  thumb_w16(out, 52)         # e_ehsize
  thumb_w16(out, 0)          # e_phentsize
  thumb_w16(out, 0)          # e_phnum
  thumb_w16(out, 40)         # e_shentsize
  thumb_w16(out, n_sections as u32)  # e_shnum
  thumb_w16(out, 1)          # e_shstrndx = the strtab section

  # .text (pad to its offset, then the hot code) followed by .text.cold
  # (the @cold tail — the code stream's bytes are emitted in order).
  while out.len() < off_text do
    out.push(0)
  end
  var ci = 0
  while ci < hot_size do
    out.push(code[ci])
    ci = ci + 1
  end
  if has_cold then
    while ci < code.len() do
      out.push(code[ci])
      ci = ci + 1
    end
  end

  # .data (the static images).
  if has_data then
    while out.len() < off_data do
      out.push(0)
    end
    var di2 = 0
    while di2 < data_size do
      out.push(data[di2])
      di2 = di2 + 1
    end
  end

  # .rel.text (the hot relocations).
  if has_rel_hot then
    while out.len() < off_rel do
      out.push(0)
    end
    var ri = 0
    while ri < rel_hot.len() do
      # The symbol index of the relocation target: the global symbols
      # sit after the leading "$t" locals (fns, then datas, then
      # externs — the order of global_names).
      var sym_idx = 0
      var found = false
      var gj = 0
      while gj < global_names.len() do
        if global_names[gj] == rel_hot[ri].sym then
          sym_idx = first_global + gj
          found = true
          gj = global_names.len() + 1
        else
          gj = gj + 1
        end
      end
      if !found then
        # Defensive: a relocation whose target is not a global symbol
        # of this object (a program function would mean the
        # defined/extern classification drifted — guarded upstream in
        # thumb_emit_bl / the LirStaticLoad arm; emitting a broken
        # section is NOT acceptable) is written against the null symbol
        # so the link errors visibly instead of silently mislinking.
        sym_idx = 0
      end
      thumb_w32(out, rel_hot[ri].offset as u32)
      thumb_w32(out, ((sym_idx as u32) << 8) | (rel_hot[ri].kind as u32))
      ri = ri + 1
    end
  end

  # .rel.text.cold (the @cold bodies' relocation sites — extern calls
  # and static references inside the tail, rebased into .text.cold).
  if has_rel_cold then
    while out.len() < off_rel_cold do
      out.push(0)
    end
    var ri2 = 0
    while ri2 < rel_cold.len() do
      var sym_idx = 0
      var found = false
      var gj = 0
      while gj < global_names.len() do
        if global_names[gj] == rel_cold[ri2].sym then
          sym_idx = first_global + gj
          found = true
          gj = global_names.len() + 1
        else
          gj = gj + 1
        end
      end
      if !found then
        sym_idx = 0
      end
      thumb_w32(out, rel_cold[ri2].offset as u32)
      thumb_w32(out, ((sym_idx as u32) << 8) | (rel_cold[ri2].kind as u32))
      ri2 = ri2 + 1
    end
  end

  # .isr_vector (the NVIC vector-table word image — the zero words the
  # relocations below reference; see the interrupt-ABI section above
  # for the layout and the documented declaration-order mapping).
  if has_vec then
    while out.len() < off_vec do
      out.push(0)
    end
    var wi = 0
    while wi < vec_size do
      out.push(0)
      wi = wi + 1
    end
  end

  # .rel.isr_vector (the R_ARM_ABS32 relocations of the table words —
  # word index -> the handler/reset function symbol; the in-place
  # addend is the word's zero image, so the linked value is exactly the
  # symbol's linked address).
  if has_rel_vec then
    while out.len() < off_rel_vec do
      out.push(0)
    end
    var wri = 0
    while wri < vec_word_syms.len() do
      var sym_idx = 0
      var found = false
      var gj = 0
      while gj < global_names.len() do
        if global_names[gj] == vec_word_syms[wri].1 then
          sym_idx = first_global + gj
          found = true
          gj = global_names.len() + 1
        else
          gj = gj + 1
        end
      end
      if !found then
        # Defensive: a vector word whose symbol is not a global of this
        # object (the collector validated the handler/reset symbols
        # against the program's defined set — guarded upstream) is
        # written against the null symbol so the link errors visibly
        # instead of silently entering a zero handler.
        sym_idx = 0
      end
      thumb_w32(out, (vec_word_syms[wri].0 * 4) as u32)
      thumb_w32(out, ((sym_idx as u32) << 8) | (thumb_reloc_abs32() as u32))
      wri = wri + 1
    end
  end

  # .symtab (16-byte entries).
  while out.len() < off_sym do
    out.push(0)
  end
  # Entry 0: null.
  var si3 = 0
  while si3 < 16 do
    out.push(0)
    si3 = si3 + 1
  end
  var li = 0
  while li < local_names.len() do
    # (P1-18 @cold): a function at a stream offset inside the cold
    # region lives in .text.cold — its value is rebased into the
    # section and its shndx names the cold section (the section's
    # file/VM position restores the stream order).
    let fn_off = fns[li].1
    let in_cold = has_cold && fn_off >= cold_base
    let fn_value = if in_cold then fn_off - cold_base else fn_off end
    let fn_shndx = if in_cold then text_cold_idx else text_idx end
    thumb_w32(out, sym_offs[li] as u32)
    thumb_w32(out, fn_value as u32)   # $t value = function offset within its section
    thumb_w32(out, 0)
    out.push(0x00)   # STB_LOCAL | STT_NOTYPE
    out.push(0)
    thumb_w16(out, fn_shndx as u32)
    li = li + 1
  end
  var gii = 0
  while gii < fns.len() do
    let gfn_off = fns[gii].1
    let g_in_cold = has_cold && gfn_off >= cold_base
    let gfn_value = if g_in_cold then gfn_off - cold_base else gfn_off end
    let gfn_shndx = if g_in_cold then text_cold_idx else text_idx end
    thumb_w32(out, sym_offs[local_names.len() + gii] as u32)
    thumb_w32(out, gfn_value as u32)
    thumb_w32(out, 0)
    out.push(0x12)   # STB_GLOBAL | STT_FUNC
    out.push(0)
    thumb_w16(out, gfn_shndx as u32)
    gii = gii + 1
  end
  if has_data then
    var dd = 0
    while dd < datas.len() do
      thumb_w32(out, sym_offs[local_names.len() + fns.len() + dd] as u32)
      thumb_w32(out, datas[dd].1 as u32)   # value = offset in .data
      thumb_w32(out, datas[dd].2 as u32)   # size = the image size
      out.push(0x11)   # STB_GLOBAL | STT_OBJECT
      out.push(0)
      thumb_w16(out, data_idx as u32)
      dd = dd + 1
    end
  end
  var exi = 0
  while exi < exts.len() do
    thumb_w32(out, sym_offs[local_names.len() + fns.len() + datas.len() + exi] as u32)
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    out.push(0x10)   # STB_GLOBAL | STT_NOTYPE
    out.push(0)
    thumb_w16(out, 0)  # SHN_UNDEF
    exi = exi + 1
  end

  # .strtab.
  while out.len() < off_str do
    out.push(0)
  end
  var sti = 0
  while sti < strtab_size do
    out.push(strtab[sti])
    sti = sti + 1
  end

  # Section headers (40 bytes each).
  while out.len() < off_sh do
    out.push(0)
  end
  # [0] null.
  var zj = 0
  while zj < 40 do
    out.push(0)
    zj = zj + 1
  end
  # [1] strtab (the name table: sh_name points at its own ".strtab").
  thumb_w32(out, sec_offs[strtab_name_idx] as u32)
  thumb_w32(out, 3)           # SHT_STRTAB
  thumb_w32(out, 0)
  thumb_w32(out, 0)
  thumb_w32(out, off_str as u32)
  thumb_w32(out, strtab_size as u32)
  thumb_w32(out, 0)
  thumb_w32(out, 0)
  thumb_w32(out, 1)
  thumb_w32(out, 0)
  # [2] .text (the hot code — size hot_size when a cold region exists,
  # the full code otherwise).
  thumb_w32(out, sec_offs[text_name_idx] as u32)
  thumb_w32(out, 1)           # SHT_PROGBITS
  thumb_w32(out, 0x6)         # SHF_ALLOC | SHF_EXECINSTR
  thumb_w32(out, 0)
  thumb_w32(out, off_text as u32)
  thumb_w32(out, hot_size as u32)
  thumb_w32(out, 0)
  thumb_w32(out, 0)
  thumb_w32(out, 4)
  thumb_w32(out, 0)
  if has_cold then
    # [3] .text.cold (the @cold bodies; Thumb instructions are
    # halfword-aligned, so the section alignment is 2 — the section
    # follows .text directly, preserving the code stream's byte order).
    thumb_w32(out, sec_offs[text_cold_name_idx] as u32)
    thumb_w32(out, 1)           # SHT_PROGBITS
    thumb_w32(out, 0x6)         # SHF_ALLOC | SHF_EXECINSTR
    thumb_w32(out, 0)
    thumb_w32(out, off_cold as u32)
    thumb_w32(out, cold_size as u32)
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, 2)
    thumb_w32(out, 0)
  end
  if has_data then
    # [3/4] .data (the static images; every image is one 4-aligned
    # 32-bit word, so the section alignment is 4).
    thumb_w32(out, sec_offs[data_name_idx] as u32)
    thumb_w32(out, 1)           # SHT_PROGBITS
    thumb_w32(out, 0x3)         # SHF_ALLOC | SHF_WRITE
    thumb_w32(out, 0)
    thumb_w32(out, off_data as u32)
    thumb_w32(out, data_size as u32)
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, 4)
    thumb_w32(out, 0)
  end
  if has_rel_hot then
    thumb_w32(out, sec_offs[rel_name_idx] as u32)
    thumb_w32(out, 9)         # SHT_REL
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, off_rel as u32)
    thumb_w32(out, rel_size as u32)
    thumb_w32(out, symtab_idx as u32)
    thumb_w32(out, text_idx as u32)
    thumb_w32(out, 4)
    thumb_w32(out, 8)
  end
  if has_rel_cold then
    # .rel.text.cold — the relocation table of .text.cold (sh_info =
    # the cold section's index).
    thumb_w32(out, sec_offs[rel_cold_name_idx] as u32)
    thumb_w32(out, 9)         # SHT_REL
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, off_rel_cold as u32)
    thumb_w32(out, rel_cold_size as u32)
    thumb_w32(out, symtab_idx as u32)
    thumb_w32(out, text_cold_idx as u32)
    thumb_w32(out, 4)
    thumb_w32(out, 8)
  end
  if has_vec then
    # .isr_vector — the NVIC vector-table image (PROGBITS; SHF_ALLOC
    # only — the flash-resident read-only table the linker script's
    # KEEP(*(.isr_vector)) places at the flash base; see the
    # interrupt-ABI section above).
    thumb_w32(out, sec_offs[vec_name_idx] as u32)
    thumb_w32(out, 1)         # SHT_PROGBITS
    thumb_w32(out, 0x2)       # SHF_ALLOC
    thumb_w32(out, 0)
    thumb_w32(out, off_vec as u32)
    thumb_w32(out, vec_size as u32)
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, 4)
    thumb_w32(out, 0)
  end
  if has_rel_vec then
    # .rel.isr_vector — the vector words' relocation table (sh_info =
    # the .isr_vector section's index).
    thumb_w32(out, sec_offs[rel_vec_name_idx] as u32)
    thumb_w32(out, 9)         # SHT_REL
    thumb_w32(out, 0)
    thumb_w32(out, 0)
    thumb_w32(out, off_rel_vec as u32)
    thumb_w32(out, rel_vec_size as u32)
    thumb_w32(out, symtab_idx as u32)
    thumb_w32(out, vec_idx as u32)
    thumb_w32(out, 4)
    thumb_w32(out, 8)
  end
  # The last section header is .symtab.
  thumb_w32(out, sec_offs[symtab_name_idx] as u32)
  thumb_w32(out, 2)           # SHT_SYMTAB
  thumb_w32(out, 0)
  thumb_w32(out, 0)
  thumb_w32(out, off_sym as u32)
  thumb_w32(out, sym_size as u32)
  thumb_w32(out, 1)           # sh_link = strtab
  thumb_w32(out, first_global as u32)
  thumb_w32(out, 4)
  thumb_w32(out, 16)

  out
end

def thumb_align_4_of(n: Int) -> Int
  let rem = n % 4
  if rem != 0 then
    n + (4 - rem)
  else
    n
  end
end

# ———————————————————————————————————————————————————————————————
# Whole-program route (mirrors lir_compile_object)
# ———————————————————————————————————————————————————————————————
# The driver's LIR gate (a desc'd --target thumb triple, or the legacy
# TANGERINE_LIR_TARGET=cortex-m alias) routes single
# files here: the program's statics lower through the scalar-constant
# subset into a .data image (see the statics section above), every
# non-extern function goes through the LIR pipeline
# (fail-closed: one unsupported construct fails the whole compile with a
# rule-naming reason), the bodies are emitted into one text buffer with
# the runtime-free conventions above, deferred branches are resolved and
# the buffer is serialized as the ELF32 ARM object. No runtime merge:
# the aarch64 runtime buffers in codegen.tg are aarch64 machine code
# and cannot be mixed into a cortex-m object (a cortex-m runtime is a
# separate slice; externs resolve through the object's undefined
# symbols instead).

# Collect the (name, offset) function symbols in program order from the
# emit state's symbol records. (P1-18 @cold): a ColdText symbol (an
# attr_cold function of the deferred cold pass) is a function of the
# same code buffer — its tuple rides along and the ELF writer assigns
# it to .text.cold by its offset (>= the cold_base it receives).
def thumb_collect_fns(te: ThumbEmit) -> Vec[(String, Int)]
  var fns: Vec[(String, Int)] = Vec::new()
  var i = 0
  while i < te.syms.len() do
    let s = te.syms[i]
    if s.section == Section::Text || s.section == Section::ColdText then
      fns.push((s.name.clone(), s.offset))
    end
    i = i + 1
  end
  fns
end

# Collect the (name, offset, size) .data symbols in program order (the
# static images the route's data emission registered).
def thumb_collect_datas(te: ThumbEmit) -> Vec[(String, Int, Int)]
  var datas: Vec[(String, Int, Int)] = Vec::new()
  var i = 0
  while i < te.syms.len() do
    let s = te.syms[i]
    if s.section == Section::Data then
      datas.push((s.name.clone(), s.offset, s.size))
    end
    i = i + 1
  end
  datas
end

def thumb_collect_exts(te: ThumbEmit) -> Vec[String]
  var exts: Vec[String] = Vec::new()
  var i = 0
  while i < te.syms.len() do
    let s = te.syms[i]
    if s.section == Section::Extern then
      exts.push(s.name.clone())
    end
    i = i + 1
  end
  exts
end

# ———————————————————————————————————————————————————————————————
# Whole-program static data emission (the scalar-constant subset)
# ———————————————————————————————————————————————————————————————
# thumb_compile_object emits the program's statics into a .data image
# instead of failing closed (see lir.tg's statics section for the
# shared admission model — lir_static_scalar_ok with the word-only
# accept set: the 64-bit integer words plus Bool — and the
# lir_static_init_word_value initializer subset). Each admitted static
# becomes ONE 32-bit machine word at a 4-aligned .data offset: the
# initializer's low word (Bool: the 0/1 byte in the low byte, zeros
# above — the full-word load of the reference reads it back as the
# canonical 0/1 or value word). Initializer values must fit the
# route's 32-bit word model (thumb_imm32_ok — the LIR word model's
# [-2^31, 2^32) faithful range). Uninitialized/extern statics emit the
# zero word (semantically the direct route's zero-initialized .bss
# slot; the ELF32 ARM writer of this slice has no .bss section, and a
# zero .data word links identically). The data symbols are GLOBAL
# SymKind::Data records (the reference relocations resolve against
# them); the symbol size is the 4-byte image size.
def thumb_emit_static_data(inout data: CodeBuffer, inout syms: Vec[AsmSymbol], st: MirStatic) -> Result[Unit, String]
  let ty = st.ty.clone()
  if !lir_static_scalar_ok(false, ty) then
    return Result::Err("thumb: " + lir_static_unsupported_type_rule(st.name.clone()))
  end
  let word_o = match lir_static_init_word_value(st)
  when Result::Err(e) then return Result::Err("thumb: " + e)
  when Result::Ok(o) then o
  end
  let off = buf_pos(&data)
  match word_o
  when Option::Some(v) then
    if !thumb_imm32_ok(v) then
      return Result::Err("thumb: static '" + st.name + "' initializer " + v.to_string() + " does not fit the 32-bit cortex-m word model [-2^31, 2^32) — the value has no faithful 32-bit image (fail-closed)")
    end
    emit32_le(&mut data, (v & 0xFFFFFFFF) as u32)
  when Option::None then
    emit32_le(&mut data, 0)
  end
  syms.push(AsmSymbol {
    name: st.name.clone(),
    section: Section::Data,
    offset: off,
    size: 4,
    binding: SymBinding::Global,
    kind: SymKind::Data
  })
  Result::Ok(())
end

# Emit the whole program's statics into the .data buffer and its symbol
# records (the route's mirror of lir_emit_program_statics_a64).
def thumb_emit_program_statics(inout data: CodeBuffer, inout syms: Vec[AsmSymbol], program: MirProgram) -> Result[Unit, String]
  var si = 0
  while si < program.statics.len() do
    match thumb_emit_static_data(&mut data, &mut syms, &program.statics[si])
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    si = si + 1
  end
  Result::Ok(())
end

def thumb_compile_object(program: MirProgram, desc: TargetDesc) -> Result[Vec[u8], String]
  # The whole-program static label table (DefId-render -> emission name
  # — the codegen.tg builder, the same table the direct emitter's
  # codegen_program runs): the MirStaticRef lowering resolves static
  # references through it (passed to the lowering entries below). The
  # statics themselves are emitted into the .data image BEFORE any
  # function body (mirroring codegen_program's ordering), so the
  # symbols the reference relocations target exist up front.
  var static_labels: Map[String, String] = Map::new()
  build_static_label_table(program, &mut static_labels)
  var data = buf_new()
  var te = thumb_emit_new()
  match thumb_emit_program_statics(&mut data, &mut te.syms, program)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  # The route's descriptor is the single source of the ABI data (the
  # driver resolved it from the --target triple through
  # target_desc_of_triple, or from the legacy TANGERINE_LIR_TARGET
  # alias); the pool
  # shape check fails closed on a desc this slice does not consume.
  let mdl_pool = match thumb_mdl_pool(desc)
  when Result::Ok(p) then p
  when Result::Err(e) then return Result::Err(e)
  end
  var externs: Set[String] = Set::new()
  var defined: Set[String] = Set::new()
  # The program's VARIADIC extern names (MirFunction.is_extern_variadic
  # — audit §16: thumb_emit_fn routes a call block to the AAPCS32
  # base-convention marshaller below for these targets).
  var variadic_externs: Set[String] = Set::new()
  var fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      externs.insert(f.name.clone())
      if f.is_extern_variadic then
        variadic_externs.insert(f.name.clone())
      end
    else
      defined.insert(f.name.clone())
    end
    fi = fi + 1
  end
  # AUDIT §16 — the .isr_vector plan: collect the program's @interrupt
  # handlers and validate them against the desc's modeled interrupt ABI
  # and the handler shape HERE — before any function body lowers — so a
  # malformed handler fails the whole compile with its rule before any
  # partial emission (the per-function shape gate also runs inside
  # thumb_emit_fn before each handler's bytes are emitted — defense in
  # depth). The plan is Option::None for programs without @interrupt
  # functions — the writer then emits no vector section and the object
  # is byte-identical to the pre-slice layout.
  let vec_plan = match thumb_program_interrupt_vector(program, desc)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  var vec_words = 0
  var vec_word_syms: Vec[(Int, String)] = Vec::new()
  match vec_plan
  when Option::Some(info) then
    vec_words = info.words
    vec_word_syms = info.word_syms
    # The vector words reference defined function symbols of THIS
    # object: every handler collected from the program's non-extern
    # attr_interrupt functions will be emitted (hot or cold pass), and
    # the `_reset_handler` word is added only when the program defines
    # it — the writer's symbol lookup must always find them (defensive
    # net: a miss there writes the null symbol so the link errors
    # visibly).
    var vi = 0
    while vi < vec_word_syms.len() do
      if !defined.contains(&vec_word_syms[vi].1) then
        return Result::Err("thumb: internal error: the .isr_vector word " + vec_word_syms[vi].0.to_string() + " references `" + vec_word_syms[vi].1 + "`, which is not a defined function of this program (fail-closed)")
      end
      vi = vi + 1
    end
  when Option::None then ()
  end
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      # Extern functions get no body — an undefined symbol entry so the
      # linker resolves them (the direct emitter's extern convention).
      te.syms.push(AsmSymbol {
        name: f.name.clone(),
        section: Section::Extern,
        offset: 0,
        size: 0,
        binding: SymBinding::Global,
        kind: SymKind::Func
      })
    else if !f.attr_cold then
      # (P1-18 @cold — the HOT pass): every non-@cold body lowers and
      # emits here (program order). An attr_cold function is DEFERRED
      # to the cold pass below, which emits the @cold bodies as a
      # contiguous tail of the code buffer — the .text.cold region the
      # symbol registration in thumb_emit_fn_symbol routes them into
      # (Section::ColdText). Programs without @cold functions take the
      # cold pass as a zero-iteration no-op and the buffer is
      # byte-identical to the pre-@cold layout.
      # The cortex-m route lowers through the AAPCS32 parameter-fetch
      # entry (lower_mir_fn_to_lir_cm): params/args 0..3 ride r0..r3,
      # every index >= 4 crosses on the caller's stack in 4-byte words,
      # and the word-only accept set keeps div/mod, sized widths and
      # aggregates fail-closed exactly as before. Allocation runs the
      # cm entry (lir_alloc_registers_cm — the caller-saved-only
      # contract with width-aware 4-byte-word spill slots: an F64
      # vreg's image gets a two-word, 8-byte-aligned home, so the
      # float slice's 8-byte images are geometrically sound). The
      # whole-program
      # static label table rides along, so MirStaticRef reads lower to
      # LirStaticLoad against the .data symbols emitted above.
      let lir_fn = match lower_mir_fn_to_lir_cm(f, static_labels)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(lf) then lf
      end
      match lir_validate_callees(lir_fn, defined, externs)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      let peeped = lir_peephole(lir_fn)
      let alloc = lir_alloc_registers_cm(peeped)
      # Mandatory verification (audit item 26 — verify_lir): the
      # post-allocation, pre-emission gate over the peeped function
      # and its allocation. A non-empty violation list fails the route
      # closed with the first violations named (valid functions behave
      # exactly as before — the gate is read-only).
      let lir_violations = verify_lir(peeped, alloc, LirVerifyRoute::LirVerifyCm)
      if lir_violations.len() > 0 then
        return Result::Err(lir_verify_fail_err(peeped.name.clone(), lir_violations))
      end
      match thumb_emit_fn(&mut te, mdl_pool, desc, peeped, alloc, externs, defined, variadic_externs)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
    fi = fi + 1
  end

  # (P1-18 @cold — the deferred COLD pass): lower and emit the
  # attr_cold function bodies HERE, at the end of the buffer, so they
  # form the contiguous cold tail (the .text.cold region; cold_base
  # records its start for the ELF writer, which splits the buffer and
  # rebases the cold symbols/relocations). The deferred branches the
  # cold bodies create are resolved by thumb_resolve_patches below
  # against the final positions, exactly like the hot pass's. Programs
  # without @cold functions take this pass as a zero-iteration no-op.
  var has_cold_fn = false
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if !f.is_extern && f.attr_cold then
      has_cold_fn = true
    end
    fi = fi + 1
  end
  var cold_base = -1
  if has_cold_fn then
    cold_base = buf_pos(&te.buf)
    fi = 0
    while fi < program.functions.len() do
      let f = program.functions[fi]
      if !f.is_extern && f.attr_cold then
        let lir_fn = match lower_mir_fn_to_lir_cm(f, static_labels)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(lf) then lf
        end
        match lir_validate_callees(lir_fn, defined, externs)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        let peeped = lir_peephole(lir_fn)
        let alloc = lir_alloc_registers_cm(peeped)
        let lir_violations = verify_lir(peeped, alloc, LirVerifyRoute::LirVerifyCm)
        if lir_violations.len() > 0 then
          return Result::Err(lir_verify_fail_err(peeped.name.clone(), lir_violations))
        end
        match thumb_emit_fn(&mut te, mdl_pool, desc, peeped, alloc, externs, defined, variadic_externs)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
      fi = fi + 1
    end
  end
  match thumb_resolve_patches(&mut te)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let fns = thumb_collect_fns(te)
  let datas = thumb_collect_datas(te)
  let exts = thumb_collect_exts(te)
  let rels = te.relocs.clone()
  Result::Ok(thumb_elf32_obj(te.buf.bytes.clone(), fns, datas, exts, rels, data.bytes.clone(), cold_base, vec_words, vec_word_syms))
end

# Executable/image emission for cortex-m is out of this slice: there is
# no internal linker or image writer for the thumb route, and the
# bare-metal image contract (the .isr_vector placement at the flash
# base, the reset/MSP entries) is the embedded route's artifact
# contract — driver.tg's linker script + startup sources consumed by an
# arm-none-eabi linker. Fail closed with the reason and the object-
# level vector contract (the .o this backend DOES emit carries the
# .isr_vector section when the program has @interrupt functions).
def thumb_compile_executable(program: MirProgram, output_path: String) -> Result[Unit, String]
  Result::Err("thumb: the cortex-m LIR route does not link executables in this slice — use --emit=obj and link the ELF32 ARM object with an arm-none-eabi linker (objects with @interrupt functions carry the .isr_vector table — R_ARM_ABS32 entries over the handler symbols; the vector layout and the declaration-order mapping are documented in backend_thumb.tg's interrupt-ABI section, and driver.tg's embedded cortex-m linker script provides the KEEP(*(.isr_vector)) placement at the flash base)")
end
