## tg_compiler::pkg_manager — Package Manager
## Dependency resolution, lockfiles, reproducible builds.
## Spec: §tooling.pkg

module tg_compiler::pkg_manager

use std::core::{Option, Result, Display}
use std::collections::{Map, Set, Array}
use std::semver::{Version, Requirement, Comparator}
use std::fs
use std::io
use std::crypto::{Sha256}

# ─── Package identity ────────────────────────────────────────────────

pub struct PackageId
  pub name: String
  pub version: Version
end

impl Display for PackageId
  def fmt(self: &Self) -> String
    self.name.clone() + "@" + self.version.to_string()
  end
end

pub struct Dependency
  pub name: String
  pub requirement: Requirement
  pub registry: Option[String]
  pub features: Array[String]
  pub optional: Bool
  pub dev_only: Bool
end

pub struct Package
  pub id: PackageId
  pub dependencies: Array[Dependency]
  pub dev_dependencies: Array[Dependency]
  pub features: Map[String, Array[String]]
  pub authors: Array[String]
  pub license: Option[String]
  pub repository: Option[String]
  pub description: Option[String]
  pub keywords: Array[String]
  pub edition: String
  pub source_dir: String
  pub checksum: Option[String]
end

pub struct Lockfile
  pub packages: Array[LockedPackage]
  pub metadata: Map[String, String]
  pub version: Int
end

pub struct LockedPackage
  pub name: String
  pub version: Version
  pub source: PackageSource
  pub checksum: String
  pub dependencies: Array[String]
end

pub enum PackageSource
  Registry(String)   ## registry URL
  Git { url: String, rev: String }
  Path(String)
  Local
end

impl Display for PackageSource
  def fmt(self: &Self) -> String
    match self
    when PackageSource::Registry(url) then "registry+" + url
    when PackageSource::Git { url, rev } then "git+" + url + "#" + rev
    when PackageSource::Path(p) then "path+" + p
    when PackageSource::Local then "local"
    end
  end
end

impl Lockfile
  pub def new() -> Lockfile
    Lockfile { packages: Array::new(), metadata: Map::new(), version: 1 }
  end

  pub def parse(content: &str) -> Result[Lockfile, PkgError]
    lockfile_from_content(content.to_string())
  end

  pub def serialize(self: &Self) -> String
    var out = String::new()
    out = out + "# Tangerine lockfile v" + self.version.to_string() + "\n"
    out = out + "# This file is auto-generated. Do not edit.\n\n"
    for pkg in self.packages.iter() do
      out = out + "[[package]]\n"
      out = out + "name = \"" + pkg.name.clone() + "\"\n"
      out = out + "version = \"" + pkg.version.to_string() + "\"\n"
      out = out + "source = \"" + pkg.source.to_string() + "\"\n"
      out = out + "checksum = \"" + pkg.checksum.clone() + "\"\n"
      if !pkg.dependencies.is_empty() then
        out = out + "dependencies = [\n"
        for dep in pkg.dependencies.iter() do
          out = out + "  \"" + dep.clone() + "\",\n"
        end
        out = out + "]\n"
      end
      out = out + "\n"
    end
    out
  end

  pub def write_to_file(self: &Self, path: &str) -> Result[Unit, PkgError]
    fs::write_string(path.to_string(), self.serialize())
      .map_err(|e| PkgError::IoError(e.to_string()))
  end

  pub def read_from_file(path: &str) -> Result[Lockfile, PkgError]
    let content = match fs::read_to_string(path.to_string())
    when Result::Ok(content) then content
    when Result::Err(e) then
      return Result::Err(PkgError::IoError(e.to_string()))
    end
    lockfile_from_content(content)
  end
end

def lockfile_from_content(content: String) -> Result[Lockfile, PkgError]
  ## Parse TOML lockfile format
  var lockfile = Lockfile::new()
  ## Simplified parsing — real impl uses std::toml
  let lines = content.lines()
  var current_pkg: Option[LockedPackage] = None
  for line in lines do
    let trimmed = line.trim()
    if trimmed.starts_with("[[package]]") then
      if let Some(pkg) = current_pkg.take() then
        lockfile.packages.push(pkg)
      end
      current_pkg = Some(LockedPackage {
        name: String::new(),
        version: Version::new(0, 0, 0),
        source: PackageSource::Local,
        checksum: String::new(),
        dependencies: Array::new(),
      })
    else if trimmed.starts_with("name = ") then
      if let Some(ref mut pkg) = current_pkg then
        pkg.name = _parse_toml_string(trimmed)
      end
    else if trimmed.starts_with("version = ") then
      if let Some(ref mut pkg) = current_pkg then
        let vs = _parse_toml_string(trimmed)
        pkg.version = Version::parse(&vs).unwrap_or(Version::new(0, 0, 0))
      end
    else if trimmed.starts_with("source = ") then
      if let Some(ref mut pkg) = current_pkg then
        pkg.source = PackageSource::Registry(_parse_toml_string(trimmed))
      end
    else if trimmed.starts_with("checksum = ") then
      if let Some(ref mut pkg) = current_pkg then
        pkg.checksum = _parse_toml_string(trimmed)
      end
    else if trimmed.starts_with("dependencies = [") then
      if let Some(ref mut pkg) = current_pkg then
        pkg.dependencies = _parse_string_array(trimmed)
      end
    end
  end
  if let Some(pkg) = current_pkg then
    lockfile.packages.push(pkg)
  end
  Ok(lockfile)
end

# ─── Dependency resolver ─────────────────────────────────────────────

pub struct Resolver
  registry: Box[dyn Registry]
  resolved: Map[String, ResolvedNode]
  visited: Set[String]
end

struct ResolvedNode
  package: Package
  deps: Array[PackageId]
end

pub trait Registry
  def fetch_versions(self: &Self, name: &str) -> Result[Array[Version], PkgError]
  def fetch_package(self: &Self, name: &str, version: &Version) -> Result[Package, PkgError]
  def download_archive(self: &Self, id: &PackageId) -> Result[Array[u8], PkgError]
end

impl Resolver
  pub def new(registry: Box[dyn Registry]) -> Resolver
    Resolver {
      registry: registry,
      resolved: Map::new(),
      visited: Set::new(),
    }
  end

  /// Resolve all dependencies starting from root package.
  /// Uses a SAT-like backtracking solver.
  pub def resolve(
    &mut self,
    root_deps: &[Dependency]
  ) -> Result[Array[LockedPackage], PkgError]
    for dep in root_deps.iter() do
      match self.resolve_dep(dep, 0)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
    self.build_lockfile_entries()
  end

  def resolve_dep(&mut self, dep: &Dependency, depth: Int) -> Result[Unit, PkgError]
    if depth > 256 then
      return Err(PkgError::DependencyCycle(dep.name.clone()))
    end

    let key = dep.name.clone()
    if self.visited.contains(&key) then
      return Ok(())
    end
    self.visited.insert(key.clone())

    ## Fetch available versions
    let versions = match self.registry.fetch_versions(&dep.name)
    when Result::Ok(versions) then versions
    when Result::Err(e) then return Result::Err(e)
    end
    
    ## Find best matching version (highest that satisfies requirement)
    var best: Option[Version] = None
    for v in versions.iter() do
      if dep.requirement.matches(&v) then
        match &best
        when Some(b) then
          if v > *b then best = Some(v) end
        when None then best = Some(v)
        end
      end
    end

    let selected = match best
    when Some(version) then version
    when None then
      return Result::Err(PkgError::NoMatchingVersion {
        name: dep.name.clone(),
        requirement: dep.requirement.to_string(),
      })
    end

    ## Fetch full package info
    let pkg = match self.registry.fetch_package(&dep.name, &selected)
    when Result::Ok(pkg) then pkg
    when Result::Err(e) then return Result::Err(e)
    end

    ## Recursively resolve transitive dependencies
    let transitive_deps = pkg.dependencies.clone()
    let pkg_id = PackageId { name: dep.name.clone(), version: selected }
    self.resolved.insert(key, ResolvedNode {
      package: pkg,
      deps: Array::new(),
    })

    for tdep in transitive_deps.iter() do
      match self.resolve_dep(tdep, depth + 1)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end

    Ok(())
  end

  def build_lockfile_entries(&self) -> Result[Array[LockedPackage], PkgError]
    var entries = Array::new()
    for (name, node) in self.resolved.entries() do
      let mut deps = Array::new()
      for d in node.deps.iter() do
        deps.push(d.to_string())
      end
      entries.push(LockedPackage {
        name: node.package.id.name.clone(),
        version: node.package.id.version.clone(),
        source: PackageSource::Registry("https://registry.tangerine-lang.org".to_string()),
        checksum: node.package.checksum.unwrap_or("".to_string()),
        dependencies: deps,
      })
    end
    Ok(entries)
  end
end

# ─── Build plan ──────────────────────────────────────────────────────

pub struct BuildPlan
  pub steps: Array[BuildStep]
end

pub struct BuildStep
  pub package: PackageId
  pub action: BuildAction
  pub dependencies: Array[PackageId]
end

pub enum BuildAction
  Fetch { source: PackageSource, checksum: String }
  Compile { features: Array[String], mode: BuildMode }
  Link
end

pub enum BuildMode
  Dev     ## Debug info, no optimizations
  Release ## Optimized, stripped
  Test    ## Debug info + test harness
end

impl BuildPlan
  pub def from_lockfile(lockfile: &Lockfile) -> BuildPlan
    var steps = Array::new()
    for pkg in lockfile.packages.iter() do
      let id = PackageId { name: pkg.name.clone(), version: pkg.version.clone() }
      let mut deps = Array::new()
      for d in pkg.dependencies.iter() do
        if let Some(id) = _parse_pkg_id(d) then
          deps.push(id)
        end
      end
      steps.push(BuildStep {
        package: id,
        action: BuildAction::Compile {
          features: Array::new(),
          mode: BuildMode::Release,
        },
        dependencies: deps,
      })
    end
    BuildPlan { steps: steps }
  end
end

# ─── Package commands ────────────────────────────────────────────────

pub struct PkgManager
  project_root: String
  lockfile_path: String
  cache_dir: String
end

impl PkgManager
  pub def new(project_root: &str) -> PkgManager
    PkgManager {
      project_root: project_root.to_string(),
      lockfile_path: project_root.to_string() + "/Tangerine.lock",
      cache_dir: std::env::home_dir().unwrap_or("/tmp".to_string()) + "/.tangerine/cache",
    }
  end

  /// Install all dependencies from lockfile (or resolve + lock first).
  pub def install(&mut self, registry: Box[dyn Registry]) -> Result[Unit, PkgError]
    let lockfile = if fs::path_exists(self.lockfile_path.clone()) then
      match Lockfile::read_from_file(&self.lockfile_path)
      when Result::Ok(lockfile) then lockfile
      when Result::Err(e) then return Result::Err(e)
      end
    else
      ## Read Tangerine.toml and resolve
      let manifest = match self.read_manifest()
      when Result::Ok(manifest) then manifest
      when Result::Err(e) then return Result::Err(e)
      end
      let mut resolver = Resolver::new(registry)
      let locked = match resolver.resolve(&manifest.dependencies)
      when Result::Ok(locked) then locked
      when Result::Err(e) then return Result::Err(e)
      end
      let lf = Lockfile { packages: locked, metadata: Map::new(), version: 1 }
      match lf.write_to_file(&self.lockfile_path)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
      lf
    end

    ## Download and cache packages
    for pkg in lockfile.packages.iter() do
      match self.ensure_cached(pkg)
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(e)
      end
    end
    Ok(())
  end

  /// Add a dependency to Tangerine.toml.
  pub def add(&mut self, name: &str, requirement: &str) -> Result[Unit, PkgError]
    ## Append to Tangerine.toml [dependencies] section
    let toml_path = self.project_root.clone() + "/Tangerine.toml"
    let content = match fs::read_to_string(toml_path.clone())
    when Result::Ok(content) then content
    when Result::Err(e) then return Result::Err(PkgError::IoError(e.to_string()))
    end
    let entry = name.to_string() + " = \"" + requirement.to_string() + "\"\n"
    ## Simple append — real impl would parse TOML properly
    let new_content = content + "\n" + entry
    fs::write_string(toml_path, new_content)
      .map_err(|e| PkgError::IoError(e.to_string()))
  end

  /// Remove a dependency.
  pub def remove(&mut self, name: &str) -> Result[Unit, PkgError]
    ## Filter out the dependency line from Tangerine.toml
    let toml_path = self.project_root.clone() + "/Tangerine.toml"
    let content = match fs::read_to_string(toml_path.clone())
    when Result::Ok(content) then content
    when Result::Err(e) then return Result::Err(PkgError::IoError(e.to_string()))
    end
    let mut filtered_lines = Array::new()
    for line in content.lines() do
      if !line.starts_with(name) then
        filtered_lines.push(line.clone())
      end
    end
    let filtered = filtered_lines.join("\n")
    fs::write_string(toml_path, filtered)
      .map_err(|e| PkgError::IoError(e.to_string()))
  end

  /// Update lockfile to newest compatible versions.
  pub def update(&mut self, registry: Box[dyn Registry]) -> Result[Unit, PkgError]
    ## Delete lockfile and re-resolve
    if fs::path_exists(self.lockfile_path.clone()) then
      match fs::remove_file(self.lockfile_path.clone())
      when Result::Ok(_) then ()
      when Result::Err(e) then return Result::Err(PkgError::IoError(e.to_string()))
      end
    end
    self.install(registry)
  end

  def read_manifest(&self) -> Result[Package, PkgError]
    ## Parse Tangerine.toml into Package struct
    let toml_path = self.project_root.clone() + "/Tangerine.toml"
    let content = match fs::read_to_string(toml_path)
    when Result::Ok(content) then content
    when Result::Err(e) then return Result::Err(PkgError::IoError(e.to_string()))
    end

    ## Parse name, version, edition from [package] section
    let pkg_name = _extract_toml_field(content.clone(), "name".to_string()).unwrap_or("root".to_string())
    let pkg_version_str = _extract_toml_field(content.clone(), "version".to_string()).unwrap_or("0.1.0".to_string())
    let pkg_version = Version::parse(&pkg_version_str).unwrap_or(Version::new(0, 1, 0))
    let pkg_edition = _extract_toml_field(content.clone(), "edition".to_string()).unwrap_or("2024".to_string())
    let pkg_license = _extract_toml_field(content.clone(), "license".to_string())
    let pkg_description = _extract_toml_field(content.clone(), "description".to_string())
    let pkg_repository = _extract_toml_field(content.clone(), "repository".to_string())

    ## Parse [dependencies] section
    let deps = _parse_toml_deps(content.clone(), "[dependencies]".to_string())
    let dev_deps = _parse_toml_deps(content.clone(), "[dev-dependencies]".to_string())

    Ok(Package {
      id: PackageId { name: pkg_name, version: pkg_version },
      dependencies: deps,
      dev_dependencies: dev_deps,
      features: Map::new(),
      authors: Array::new(),
      license: pkg_license,
      repository: pkg_repository,
      description: pkg_description,
      keywords: Array::new(),
      edition: pkg_edition,
      source_dir: "src".to_string(),
      checksum: None,
    })
  end

  def ensure_cached(&self, pkg: &LockedPackage) -> Result[Unit, PkgError]
    let cache_path = self.cache_dir.clone() + "/" + pkg.name.clone() + "-" + pkg.version.to_string()
    if fs::path_exists(cache_path) then return Ok(()) end
    ## In real impl: download from source, verify checksum, extract
    fs::create_dir_all(cache_path)
      .map_err(|e| PkgError::IoError(e.to_string()))
  end
end

# ─── Errors ──────────────────────────────────────────────────────────

pub enum PkgError
  IoError(String)
  ParseError(String)
  NoMatchingVersion { name: String, requirement: String }
  DependencyCycle(String)
  ChecksumMismatch { package: String, expected: String, actual: String }
  InvalidRequirement(String)
  RegistryError(String)
  NetworkError(String)
end

impl Display for PkgError
  def fmt(self: &Self) -> String
    match self
    when IoError(msg) then "pkg I/O error: " + msg
    when ParseError(msg) then "pkg parse error: " + msg
    when NoMatchingVersion { name, requirement } then
      "no matching version for " + name + " " + requirement
    when DependencyCycle(name) then "dependency cycle detected at: " + name
    when ChecksumMismatch { package, expected, actual } then
      "checksum mismatch for " + package + ": expected " + expected + ", got " + actual
    when InvalidRequirement(msg) then "invalid requirement: " + msg
    when RegistryError(msg) then "registry error: " + msg
    when NetworkError(msg) then "network error: " + msg
    end
  end
end

## Extract version string from a TOML inline table like { version = "1.0", features = [...] }
def _extract_inline_table_version(s: &str) -> String
  let key = "version"
  let key_eq = key.to_string() + " = \""
  let key_eq2 = key.to_string() + "=\""
  let search_str = s.to_string()
  # Try "version = \"" first
  match search_str.find(&key_eq)
  when Option::Some(pos) then
    let start = pos + key_eq.len()
    var end_pos = start
    while end_pos < search_str.len() && search_str.char_at(end_pos) != '"' do
      end_pos = end_pos + 1
    end
    search_str.substring(start as Int, end_pos as Int).to_string()
  when Option::None then
    # Try "version=\""
    match search_str.find(&key_eq2)
    when Option::Some(pos) then
      let start = pos + key_eq2.len()
      var end_pos = start
      while end_pos < search_str.len() && search_str.char_at(end_pos) != '"' do
        end_pos = end_pos + 1
      end
      search_str.substring(start as Int, end_pos as Int).to_string()
    when Option::None then
      "*".to_string()
    end
  end
end

def _parse_toml_string(s: &str) -> String
  let trimmed = s.trim()
  if trimmed.starts_with("\"") && trimmed.ends_with("\"") then
    let inner = trimmed.substring(1, (trimmed.len() - 1) as Int)
    ## Handle escape sequences
    var result = String::new()
    var i = 0
    while i < inner.len() do
      if inner.char_at(i) == '\\' && i + 1 < inner.len() then
        let ch = inner.char_at(i + 1)
        if ch == '"' then result.push('"')
        elsif ch == '\\' then result.push('\\')
        elsif ch == 'n' then result.push('\n')
        elsif ch == 't' then result.push('\t')
        elsif ch == 'r' then result.push('\r')
        else
          result.push('\\')
          result.push(ch)
        end
        i = i + 2
      else
        result.push(inner.char_at(i))
        i = i + 1
      end
    end
    result
  else
    trimmed.to_string()
  end
end

def _any_requirement() -> Requirement
  var groups = List[List[Comparator]].new()
  groups.push(List[Comparator].new())
  Requirement { comparators: groups }
end

## Extract a simple key = "value" field from TOML content
def _extract_toml_field(content: String, key: String) -> Option[String]
  let target = key.to_string() + " = "
  let target_nospace = key.to_string() + "= "
  for line in content.lines() do
    let trimmed = line.trim()
    if trimmed.starts_with(&target) || trimmed.starts_with(&target_nospace) then
      let eq_pos = trimmed.find("=")
      match eq_pos
      when Option::Some(pos) then
        let val_part = trimmed.substring((pos + 1) as Int, trimmed.len() as Int).trim()
        return Some(_parse_toml_string(val_part))
      when Option::None then ()
      end
    end
  end
  None
end

## Parse a [dependencies] or [dev-dependencies] section from TOML
def _parse_toml_deps(content: String, section_header: String) -> Array[Dependency]
  mut deps = Array::new()
  mut in_section = false
  for line in content.lines() do
    let trimmed = line.trim()
    if trimmed == section_header then
      in_section = true
      next
    end
    if in_section then
      ## End of section: next [section] header
      if trimmed.starts_with("[") then
        in_section = false
        next
      end
      ## Skip empty lines and comments
      if trimmed.is_empty() || trimmed.starts_with("#") then next end
      ## Parse: name = "version_req" or name = { version = "...", ... }
      let eq_pos = trimmed.find("=")
      match eq_pos
      when Option::Some(pos) then
        let dep_name = trimmed.substring(0, pos as Int).trim().to_string()
        let val_part = trimmed.substring((pos + 1) as Int, trimmed.len() as Int).trim()
        let version_str = if val_part.starts_with("{") then
          # Inline table: { version = "...", features = [...], optional = true }
          _extract_inline_table_version(val_part)
        else
          _parse_toml_string(val_part)
        end
        let is_optional = if val_part.starts_with("{") then
          val_part.contains("optional = true") || val_part.contains("optional=true")
        else
          false
        end
        deps.push(Dependency {
          name: dep_name,
          requirement: _any_requirement(),
          registry: None,
          features: Array::new(),
          optional: is_optional,
          dev_only: section_header == "[dev-dependencies]",
        })
      when Option::None then ()
      end
    end
  end
  deps
end

def _parse_pkg_id(s: &str) -> Option[PackageId]
  let parts = s.split("@")
  if parts.len() == 2 then
    match Version::parse(parts[1])
    when Ok(v) then Some(PackageId { name: parts[0].to_string(), version: v })
    when Err(_) then None
    end
  else
    None
  end
end

pub struct Project
  pub name: String
  pub version: String
  pub dependencies: Array[Dependency]
  pub sources: Array[String]
  pub output_dir: String
end

pub struct ResolvedPkg
  pub id: PackageId
  pub dependencies: Array[PackageId]
  pub source: PackageSource
  pub path: String
end

impl Project
  pub def new(name: String, version: String) -> Project
    Project {
      name: name,
      version: version,
      dependencies: Array::new(),
      sources: Array::new(),
      output_dir: "build".to_string(),
    }
  end

  pub def parse(content: &str) -> Result[Project, String]
    ## High-level project manifest parsing (simplified)
    let name = _extract_toml_field(content.to_string(), "name".to_string()).unwrap_or("untitled".to_string())
    let version = _extract_toml_field(content.to_string(), "version".to_string()).unwrap_or("0.1.0".to_string())
    var project = Project::new(name, version)
    project.dependencies = _parse_toml_deps(content.to_string(), "[dependencies]".to_string())
    ## ... (parsing logic for [sources], etc. — handled by driver.tg load_project for now)
    Ok(project)
  end
end

end ## module tg_compiler::pkg_manager
