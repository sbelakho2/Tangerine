use tg_compiler::codegen::{build_static_label_table}
use tg_compiler::asm::{
  X64, x64_code,
  CodeBuffer, buf_new, emit8, def_label,
  buf_pos, patch32_le, AsmSymbol, Section, SymBinding, SymKind
}
use tg_compiler::target_desc::{
  TargetDesc, Arch, atomic_support, AtomicSupport, x86_64_desc
}

# ———————————————————————————————————————————————————————————————
# x86-64 encoders (the LIR route's self-contained encoding surface)
# ———————————————————————————————————————————————————————————————
# Every encoder returns the instruction's raw bytes (REX-prefixed 64-bit
# forms unless its comment says otherwise), documented with its layout
# and a hand-verified byte pattern. The shared asm.tg module carries an
# equivalent x64_* surface for the DIRECT emitter; the LIR route's
# encoders live HERE so the route's byte surface is one self-contained,
# hand-verified unit (the item-30 instruction).
#
# REX = 0100 WRXB (W = 64-bit operand, R = ModRM.reg extension,
# X = SIB.index extension, B = ModRM.rm/SIB.base/opcode-reg extension).
# ModRM = mm rrr mmm (mm 3 = register, 01 = [base+disp8], 10 =
# [base+disp32]). A [rbp]/[r13] base is NEVER encoded with mm = 00 (that
# form is RIP-relative on x86-64), and a [rsp]/[r12] base always carries
# a SIB byte with index = 100 (none) — both rules are enforced by
# x86_mem below.

def x86_rex_bits(w: Bool, r: Bool, x: Bool, b: Bool) -> u8
  var v = 0x40
  if w then v = v | 0x08 end
  if r then v = v | 0x04 end
  if x then v = v | 0x02 end
  if b then v = v | 0x01 end
  v as u8
end

def x86_modrm(mod_: Int, reg: Int, rm: Int) -> u8
  (((mod_ & 3) << 6) | ((reg & 7) << 3) | (rm & 7)) as u8
end

def x86_sib(scale: Int, index: Int, base: Int) -> u8
  (((scale & 3) << 6) | ((index & 7) << 3) | (base & 7)) as u8
end

# Is `imm` representable as the sign-extended 32-bit immediate of the
# 81 /ext, 69 /r and 6x imm32 instruction forms?
def x86_imm32_ok(imm: Int) -> Bool
  imm >= -2147483648 && imm <= 2147483647
end

# Push the little-endian bytes of a 32-bit / 64-bit payload.
def x86_push_le32(inout out: Vec[u8], v: Int) -> Unit
  out.push((v & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
  out.push(((v >> 16) & 0xFF) as u8)
  out.push(((v >> 24) & 0xFF) as u8)
end

def x86_push_le64(inout out: Vec[u8], v: Int) -> Unit
  x86_push_le32(out, v & 0xFFFFFFFF)
  x86_push_le32(out, (v >> 32) & 0xFFFFFFFF)
end

# The ModRM (+ optional SIB) (+ displacement) bytes of [base + disp].
# `reg` is the /r or /ext field (0..7). mm = 01 when the disp fits a
# signed byte (a zero disp on a non-rbp base takes the shorter mm = 00),
# mm = 10 otherwise. Displacements are frame offsets: anything outside
# the signed 32-bit field is a caller bug and panics here.
def x86_mem(reg: Int, base: X64, disp: Int) -> Vec[u8]
  if !x86_imm32_ok(disp) then
    panic("x86_mem: displacement " + disp.to_string() + " does not fit the signed 32-bit field")
  end
  let b = (x64_code(base) as Int) & 7
  var out: Vec[u8] = Vec::new()
  var mod_ = 0
  if disp == 0 && b != 5 then
    mod_ = 0
  elsif disp >= -128 && disp <= 127 then
    mod_ = 1
  else
    mod_ = 2
  end
  out.push(x86_modrm(mod_, reg, b))
  if b == 4 then
    # rsp / r12: the base field 100 requires a SIB with index = 100 (no
    # index) and base = 100.
    out.push(x86_sib(0, 4, 4))
  end
  if mod_ == 1 then
    out.push((disp & 0xFF) as u8)
  elsif mod_ == 2 then
    x86_push_le32(out, disp)
  end
  out
end

# Append one instruction's bytes to the buffer.
def x86_emit(inout b: CodeBuffer, bytes: Vec[u8]) -> Unit
  var i = 0
  while i < bytes.len() do
    emit8(b, bytes[i])
    i = i + 1
  end
end

# MOV r/m64, r64 — REX.W(+R,+B) 89 /r. Copies src into dst.
# verified-by-hand: mov rcx -> rax = 48 89 C8; mov r9 -> r8 = 4D 89 C8.
def x86_mov_rr(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(src), false, x64_hi(dst)))
  out.push(0x89)
  out.push(x86_modrm(3, x64_code(src) as Int, x64_code(dst) as Int))
  out
end

# MOV r64, imm64 (movabs) — REX.W(+B) B8+rd io. Materializes ANY 64-bit
# payload exactly (no sign extension involved).
# verified-by-hand: movabs rax, 0x1122334455667788 = 48 B8 88 77 66 55
# 44 33 22 11; movabs r10, ... = 49 BA 88 77 66 55 44 33 22 11.
def x86_mov_ri64(dst: X64, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(dst)))
  out.push((0xB8 + ((x64_code(dst) as Int) & 7)) as u8)
  x86_push_le64(out, imm)
  out
end

# MOV r64, [base + disp] — REX.W(+R,+B) 8B /r.
# verified-by-hand: mov rax, [rbp-8] = 48 8B 45 F8; mov r12, [rbp-16] =
# 4C 8B 65 F0.
def x86_mov_rm(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x8B)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# MOV [base + disp], r64 — REX.W(+R,+B) 89 /r.
# verified-by-hand: mov [rbp-8], rax = 48 89 45 F8; mov [rbp-16], r12 =
# 4C 89 65 F0.
def x86_mov_mr(base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(src), false, x64_hi(base)))
  out.push(0x89)
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# Append x86_mem's bytes (factored so each instruction builds its REX +
# opcode first and its operand last).
def x86_append_mem(inout out: Vec[u8], reg: Int, base: X64, disp: Int) -> Unit
  let m = x86_mem(reg, base, disp)
  var i = 0
  while i < m.len() do
    out.push(m[i])
    i = i + 1
  end
end

# ALU r/m64, r64 forms — REX.W(+R,+B) <opcode> /r:
#   add 01, or 09, and 21, sub 29, xor 31, cmp 39, test 85.
# verified-by-hand: add rax, rcx = 48 01 C8; sub = 48 29 C8; and = 48 21
# C8; or = 48 09 C8; xor = 48 31 C8; cmp rax, rcx = 48 39 C8; test = 48
# 85 C8.
def x86_alu_rr(opcode: Int, dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(src), false, x64_hi(dst)))
  out.push(opcode as u8)
  out.push(x86_modrm(3, x64_code(src) as Int, x64_code(dst) as Int))
  out
end

# ALU r64, [base + disp] forms — REX.W(+R,+B) <opcode> /r:
#   add 03, or 0B, and 23, sub 2B, xor 33, cmp 3B, test 85.
# verified-by-hand: add rax, [rbp-8] = 48 03 45 F8; sub = 48 2B 45 F8;
# cmp rax, [rbp-8] = 48 3B 45 F8.
def x86_alu_rm(opcode: Int, dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(opcode as u8)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# ALU r64, imm32 — REX.W(+B) 81 /ext id. The /ext field selects the
# operation: add 0, or 1, and 4, sub 5, xor 6, cmp 7. The 32-bit
# immediate is SIGN-EXTENDED to 64 bits by the machine, so callers use
# this form only when x86_imm32_ok holds.
# verified-by-hand: sub rsp, 100000 = 48 81 EC A0 86 01 00 (the
# accumulator short forms 05/0D/25/2D/35/3D are not emitted).
def x86_alu_ri(ext: Int, dst: X64, imm: Int) -> Vec[u8]
  if !x86_imm32_ok(imm) then
    panic("x86_alu_ri: immediate " + imm.to_string() + " does not fit the sign-extended 32-bit field")
  end
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(dst)))
  out.push(0x81)
  out.push(x86_modrm(3, ext, x64_code(dst) as Int))
  x86_push_le32(out, imm)
  out
end

# IMUL r64, r/m64 — REX.W 0F AF /r.
# verified-by-hand: imul rax, rcx = 48 0F AF C1; imul rax, [rbp-8] =
# 48 0F AF 45 F8.
def x86_imul_rr(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x0F)
  out.push(0xAF)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  out
end

def x86_imul_rm(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x0F)
  out.push(0xAF)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# IMUL r64, r/m64, imm32 — REX.W(+R,+B) 69 /r id (the three-operand
# form: dst = src * sign-extended(imm32)).
# verified-by-hand: imul rax, rax, 0x12345678 = 48 69 C0 78 56 34 12.
def x86_imul_rri(dst: X64, src: X64, imm: Int) -> Vec[u8]
  if !x86_imm32_ok(imm) then
    panic("x86_imul_rri: immediate " + imm.to_string() + " does not fit the sign-extended 32-bit field")
  end
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x69)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  x86_push_le32(out, imm)
  out
end

# CQO — REX.W 99: sign-extend RAX into RDX:RAX (the signed-division
# setup). verified-by-hand: 48 99.
def x86_cqo() -> Vec[u8]
  Vec::from([0x48, 0x99])
end

# IDIV r/m64 — REX.W(+B) F7 /7: RDX:RAX / src -> RAX quotient (signed).
# verified-by-hand: idiv rcx = 48 F7 F9; idiv [rbp-8] = 48 F7 7D F8.
def x86_idiv_r(src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(src)))
  out.push(0xF7)
  out.push(x86_modrm(3, 7, x64_code(src) as Int))
  out
end

def x86_idiv_rm(base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(base)))
  out.push(0xF7)
  x86_append_mem(out, 7, base, disp)
  out
end

# DIV r/m64 — REX.W(+B) F7 /6: RDX:RAX / src -> RAX quotient (unsigned;
# RDX must be zeroed first).
# verified-by-hand: div rcx = 48 F7 F1; div [rbp-8] = 48 F7 75 F8.
def x86_div_r(src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(src)))
  out.push(0xF7)
  out.push(x86_modrm(3, 6, x64_code(src) as Int))
  out
end

def x86_div_rm(base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(base)))
  out.push(0xF7)
  x86_append_mem(out, 6, base, disp)
  out
end

# Shift r/m64, imm8 — REX.W(+B) C1 /ext ib: ext 4 shl, 5 shr, 7 sar.
# The machine uses count & 63 for 64-bit operands, exactly the LIR
# 64-bit shift semantics. verified-by-hand: shl rax, 3 = 48 C1 E0 03;
# shr = 48 C1 E8 03; sar = 48 C1 F8 03.
def x86_shift_imm(ext: Int, dst: X64, count: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(dst)))
  out.push(0xC1)
  out.push(x86_modrm(3, ext, x64_code(dst) as Int))
  out.push((count & 0x3F) as u8)
  out
end

# Shift r/m64, CL — REX.W(+B) D3 /ext: the variable-count form (the
# count register is architecturally CL).
# verified-by-hand: shl rax, cl = 48 D3 E0; shr = 48 D3 E8; sar =
# 48 D3 F8.
def x86_shift_cl(ext: Int, dst: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(dst)))
  out.push(0xD3)
  out.push(x86_modrm(3, ext, x64_code(dst) as Int))
  out
end

# NEG r/m64 — REX.W(+B) F7 /3; NOT r/m64 — /2.
# verified-by-hand: neg rax = 48 F7 D8; not rax = 48 F7 D0.
def x86_neg_r(r: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(r)))
  out.push(0xF7)
  out.push(x86_modrm(3, 3, x64_code(r) as Int))
  out
end

def x86_not_r(r: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(r)))
  out.push(0xF7)
  out.push(x86_modrm(3, 2, x64_code(r) as Int))
  out
end

# SETcc r/m8 — [REX] 0F 90+cc /0. The low byte only: the caller follows
# with x86_movzx_r64_r8 to materialize the canonical 0/1 word (the LIR
# Bool image). REX is required for the low-byte registers spl/bpl/sil/
# dil (codes 4..7) and the extended r8b..r15b (codes >= 8), and is
# emitted without W.
# verified-by-hand: sete al = 0F 94 C0; sete r10b = 41 0F 94 C2.
def x86_setcc(cc: Int, dst: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  let dc = x64_code(dst) as Int
  if dc >= 4 then
    out.push(x86_rex_bits(false, false, false, x64_hi(dst)))
  end
  out.push(0x0F)
  out.push((0x90 + (cc & 0x0F)) as u8)
  out.push(x86_modrm(3, 0, dc))
  out
end

# MOVZX r64, r/m8 — REX.W(+R,+B) 0F B6 /r.
# verified-by-hand: movzx rax, al = 48 0F B6 C0.
def x86_movzx_r64_r8(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x0F)
  out.push(0xB6)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  out
end

def x86_movzx_r64_m8(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x0F)
  out.push(0xB6)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# MOVSX r64, r/m8 — REX.W 0F BE /r (the sxtb form); MOVSX r64, r/m16 —
# REX.W 0F BF /r (the sxth form); MOVSXD r64, r/m32 — REX.W 63 /r (the
# sxtw form).
# verified-by-hand: movsx rax, al = 48 0F BE C0; movsx rax, ax = 48 0F BF
# C0; movsxd rax, eax = 48 63 C0.
def x86_movsx_r64_r8(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x0F)
  out.push(0xBE)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  out
end

def x86_movsx_r64_r16(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x0F)
  out.push(0xBF)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  out
end

def x86_movsx_r64_m8(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x0F)
  out.push(0xBE)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

def x86_movsx_r64_m16(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x0F)
  out.push(0xBF)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

def x86_movsxd_rr(dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(src)))
  out.push(0x63)
  out.push(x86_modrm(3, x64_code(dst) as Int, x64_code(src) as Int))
  out
end

def x86_movsxd_rm(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x63)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# LEA r64, [base + disp] — REX.W(+R,+B) 8D /r (no memory access; the
# frame-slot address form). verified-by-hand: lea rax, [rbp-40] =
# 48 8D 45 D8.
def x86_lea(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x8D)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# MOV r64, [RIP + disp32] — REX.W(+R) 8B /r with mod = 00, rm = 101
# (RIP-relative). The disp32 starts as zero: the caller records an
# R_X86_64_PC32 relocation (addend -4) against the static's symbol, so
# the linker completes S + A - P with P = the disp field's address (the
# CPU's RIP basis is the END of the instruction, field + 4, exactly the
# addend's -4 compensation).
# verified-by-hand: mov rax, [rip+0] = 48 8B 05 00 00 00 00.
def x86_mov_rm_rip(dst: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, false))
  out.push(0x8B)
  out.push(x86_modrm(0, x64_code(dst) as Int, 5))
  x86_push_le32(out, 0)
  out
end

# ALU r/m64, imm8 — REX.W(+B) 83 /ext ib. The /ext field selects the
# operation (add 0, or 1, and 4, sub 5, xor 6, cmp 7); the byte
# immediate is sign-extended by the machine. Used by the unsigned
# int-to-float fixup's in-place `and [slot], 1`.
# verified-by-hand: and qword [rbp-24], 1 = 48 83 65 E8 01.
def x86_alu_rmi8(ext: Int, base: X64, disp: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, false, false, x64_hi(base)))
  out.push(0x83)
  x86_append_mem(out, ext, base, disp)
  out.push((imm & 0xFF) as u8)
  out
end

# ———————————————————————————————————————————————————————————————
# SSE2 (XMM) encoders — the float / vector slice
# ———————————————————————————————————————————————————————————————
# XMM registers are plain Int codes 0..15 (no separate enum): the fixed
# LIR float ABI vregs 8+k are xmm k, the allocatable FP pool phys ids
# 108..114 are xmm 8..14 (x86_fp_phys_of), the FP statement temp is
# xmm15 (code 15, x86_fp_scratch), and the vector arms use xmm0/xmm1
# as transients. The legacy prefix (66/F2/F3) precedes REX, which
# precedes the opcode — the usual x86-64 prefix order.

def x86_sse_rex_needed(d: Int, s: Int) -> Bool
  d >= 8 || s >= 8
end

# The REX byte for a two-register SSE form (W = 0; R extends d, B
# extends s).
def x86_sse_reg_rex(d: Int, s: Int) -> u8
  x86_rex_bits(false, d >= 8, false, s >= 8)
end

# The REX byte for a register/memory SSE form (R extends the ModRM.reg
# field, B the base register).
def x86_sse_mem_rex(r: Int, base: X64) -> u8
  x86_rex_bits(false, r >= 8, false, x64_hi(base))
end

def x86_push_prefix(inout out: Vec[u8], prefix: Int) -> Unit
  if prefix != 0 then
    out.push(prefix as u8)
  end
end

# SSE prefix + opcode + ModRM with both operands XMM (the reg-reg
# form). opcode is the second opcode byte after 0F.
def x86_sse_rr(prefix: Int, opcode: Int, d: Int, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  x86_push_prefix(out, prefix)
  if x86_sse_rex_needed(d, s) then
    out.push(x86_sse_reg_rex(d, s))
  end
  out.push(0x0F)
  out.push(opcode as u8)
  out.push(x86_modrm(3, d, s))
  out
end

# SSE load form: d <- [base + disp] (d is the ModRM.reg field).
def x86_sse_rm(prefix: Int, opcode: Int, d: Int, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  x86_push_prefix(out, prefix)
  if x86_sse_rex_needed(d, x64_code(base) as Int) then
    out.push(x86_sse_mem_rex(d, base))
  end
  out.push(0x0F)
  out.push(opcode as u8)
  x86_append_mem(out, d, base, disp)
  out
end

# SSE store form: [base + disp] <- s (s is the ModRM.reg field).
def x86_sse_mr(prefix: Int, opcode: Int, base: X64, disp: Int, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  x86_push_prefix(out, prefix)
  if x86_sse_rex_needed(s, x64_code(base) as Int) then
    out.push(x86_sse_mem_rex(s, base))
  end
  out.push(0x0F)
  out.push(opcode as u8)
  x86_append_mem(out, s, base, disp)
  out
end

# The three-byte 0F 38 opcode form (pshufb is the only SSE2/SSSE3
# member the slice names).
def x86_sse_rr3(prefix: Int, op1: Int, op2: Int, d: Int, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  x86_push_prefix(out, prefix)
  if x86_sse_rex_needed(d, s) then
    out.push(x86_sse_reg_rex(d, s))
  end
  out.push(0x0F)
  out.push(op1 as u8)
  out.push(op2 as u8)
  out.push(x86_modrm(3, d, s))
  out
end

# MOVSD xmm, xmm / xmm, [mem] / [mem], xmm — F2 0F 10 / 11.
# verified-by-hand: movsd xmm0, xmm0 = F2 0F 10 C0.
def x86_movsd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x10, d, s)
def x86_movsd_load(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF2, 0x10, d, base, disp)
def x86_movsd_store(base: X64, disp: Int, s: Int) -> Vec[u8] = x86_sse_mr(0xF2, 0x11, base, disp, s)

# MOVSS xmm, xmm / xmm, [mem] / [mem], xmm — F3 0F 10 / 11.
# verified-by-hand: movss xmm0, xmm0 = F3 0F 10 C0.
def x86_movss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x10, d, s)
def x86_movss_load(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x10, d, base, disp)
def x86_movss_store(base: X64, disp: Int, s: Int) -> Vec[u8] = x86_sse_mr(0xF3, 0x11, base, disp, s)

# The scalar arithmetic opcodes: add 58, mul 59, sub 5C, div 5E.
def x86_addsd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x58, d, s)
def x86_addsd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF2, 0x58, d, base, disp)
def x86_subsd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x5C, d, s)
def x86_subsd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF2, 0x5C, d, base, disp)
def x86_mulsd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x59, d, s)
def x86_mulsd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF2, 0x59, d, base, disp)
def x86_divsd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x5E, d, s)
def x86_divsd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF2, 0x5E, d, base, disp)
def x86_addss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x58, d, s)
def x86_addss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x58, d, base, disp)
def x86_subss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x5C, d, s)
def x86_subss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x5C, d, base, disp)
def x86_mulss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x59, d, s)
def x86_mulss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x59, d, base, disp)
def x86_divss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x5E, d, s)
def x86_divss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x5E, d, base, disp)

# COMISD / UCOMISD — 66 0F 2F / 2E: the ordered/unordered compares
# that write ZF/PF/CF (the LirFCmp flag source; the right operand may
# be memory). COMISS / UCOMISS — 0F 2F / 2E (no prefix): the F32 twins
# (a single-precision compare must read only the low 32 bits).
# verified-by-hand: ucomisd xmm0, xmm0 = 66 0F 2E C0.
def x86_comisd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x2F, d, s)
def x86_comisd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0x66, 0x2F, d, base, disp)
def x86_ucomisd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x2E, d, s)
def x86_ucomisd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0x66, 0x2E, d, base, disp)
def x86_comiss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x2F, d, s)
def x86_comiss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0, 0x2F, d, base, disp)
def x86_ucomiss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x2E, d, s)
def x86_ucomiss_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0, 0x2E, d, base, disp)

# CVTSI2SD/SS xmm, r/m64 — F2/F3 REX.W(+R,+B) 0F 2A /r (the GP source
# is the rm operand).
# verified-by-hand: cvtsi2sd xmm0, rax = F2 48 0F 2A C0.
def x86_cvtsi2sd_rr(d: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF2)
  out.push(x86_rex_bits(true, d >= 8, false, x64_hi(src)))
  out.push(0x0F)
  out.push(0x2A)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out
end

def x86_cvtsi2ss_rr(d: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF3)
  out.push(x86_rex_bits(true, d >= 8, false, x64_hi(src)))
  out.push(0x0F)
  out.push(0x2A)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out
end

# CVTTSD2SI/SI r64, xmm — F2/F3 REX.W(+R,+B) 0F 2C /r (the XMM source
# is the rm operand; the raw truncation result, integer-indefinite on
# NaN/out-of-range — the caller appends the §25 fixup).
# verified-by-hand: cvttsd2si rax, xmm0 = F2 48 0F 2C C0.
def x86_cvttsd2si_rr(dst: X64, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF2)
  out.push(x86_rex_bits(true, x64_hi(dst), false, s >= 8))
  out.push(0x0F)
  out.push(0x2C)
  out.push(x86_modrm(3, x64_code(dst) as Int, s))
  out
end

def x86_cvttss2si_rr(dst: X64, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF3)
  out.push(x86_rex_bits(true, x64_hi(dst), false, s >= 8))
  out.push(0x0F)
  out.push(0x2C)
  out.push(x86_modrm(3, x64_code(dst) as Int, s))
  out
end

# CVTSD2SS xmm, xmm — F2 0F 5A; CVTSS2SD xmm, xmm — F3 0F 5A.
# verified-by-hand: cvtsd2ss xmm0, xmm0 = F2 0F 5A C0.
def x86_cvtsd2ss_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0x5A, d, s)
def x86_cvtss2sd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF3, 0x5A, d, s)

# MOVQ xmm, r64 — 66 REX.W(+R,+B) 0F 6E /r (reg = xmm, rm = GP).
# MOVQ r64, xmm — 66 REX.W(+R,+B) 0F 7E /r (reg = xmm, rm = GP).
# verified-by-hand: movq xmm0, rax = 66 48 0F 6E C0; movq rax, xmm0 =
# 66 48 0F 7E C0.
def x86_movq_xmm_r64(d: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  out.push(x86_rex_bits(true, d >= 8, false, x64_hi(src)))
  out.push(0x0F)
  out.push(0x6E)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out
end

def x86_movq_r64_xmm(dst: X64, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  out.push(x86_rex_bits(true, s >= 8, false, x64_hi(dst)))
  out.push(0x0F)
  out.push(0x7E)
  out.push(x86_modrm(3, s, x64_code(dst) as Int))
  out
end

# MOVD xmm, r32 — 66 0F 6E /r; MOVD r32, xmm — 66 0F 7E /r (no W:
# both zero-extend the 32-bit payload; the F32 canonical-single
# crossings). REX extends the fields where needed.
def x86_movd_xmm_r32(d: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x86_sse_rex_needed(d, x64_code(src) as Int) then
    out.push(x86_rex_bits(false, d >= 8, false, x64_hi(src)))
  end
  out.push(0x0F)
  out.push(0x6E)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out
end

def x86_movd_r32_xmm(dst: X64, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x86_sse_rex_needed(s, x64_code(dst) as Int) then
    out.push(x86_rex_bits(false, s >= 8, false, x64_hi(dst)))
  end
  out.push(0x0F)
  out.push(0x7E)
  out.push(x86_modrm(3, s, x64_code(dst) as Int))
  out
end

# XORPS xmm, xmm — 0F 57 /r; XORPD — 66 0F 57 /r (the FNeg sign-bit
# flip: the caller materializes the sign mask in a second XMM).
# verified-by-hand: xorps xmm0, xmm1 = 0F 57 C1.
def x86_xorps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x57, d, s)
def x86_xorpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x57, d, s)
def x86_xorps_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0, 0x57, d, base, disp)
def x86_xorpd_rm(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0x66, 0x57, d, base, disp)

# The packed-integer logical ops (all lane classes): PAND 66 0F DB,
# POR 66 0F EB, PXOR 66 0F EF.
def x86_pand_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xDB, d, s)
def x86_por_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xEB, d, s)
def x86_pxor_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xEF, d, s)

# The packed add/sub opcodes: byte FC/F8, word FD/F9, dword FE/FA,
# qword D4/FB (all 66-prefixed); the packed 16-bit multiply D5
# (PMULLW — SSE2's only packed integer multiply).
def x86_paddb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xFC, d, s)
def x86_paddw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xFD, d, s)
def x86_paddd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xFE, d, s)
def x86_paddq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xD4, d, s)
def x86_psubb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF8, d, s)
def x86_psubw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF9, d, s)
def x86_psubd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xFA, d, s)
def x86_psubq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xFB, d, s)
def x86_pmullw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xD5, d, s)

# The packed float opcodes: ADDPS 0F 58, ADDPD 66 0F 58; MULPS 0F 59,
# MULPD 66 0F 59; SUBPS 0F 5C, SUBPD 66 0F 5C. (Single = no prefix,
# double = 66 — the reverse of the scalar F2/F3 forms.)
def x86_addps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x58, d, s)
def x86_addpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x58, d, s)
def x86_mulps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x59, d, s)
def x86_mulpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x59, d, s)
def x86_subps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x5C, d, s)
def x86_subpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x5C, d, s)

# MOVDQU xmm, [mem] — F3 0F 6F /r; MOVDQU [mem], xmm — F3 0F 7F /r
# (the unaligned 128-bit image load/store; the vector class is
# memory-resident at 8-byte-aligned frame slots but the intrinsic
# pointer operand carries no alignment guarantee).
# verified-by-hand: movdqu xmm0, [rax] = F3 0F 6F 00.
def x86_movdqu_load(d: Int, base: X64, disp: Int) -> Vec[u8] = x86_sse_rm(0xF3, 0x6F, d, base, disp)
def x86_movdqu_store(base: X64, disp: Int, s: Int) -> Vec[u8] = x86_sse_mr(0xF3, 0x7F, base, disp, s)

# PSHUFB xmm, xmm — 66 0F 38 00 /r (SSSE3 — emitted only when the
# target description advertises the "ssse3" token; see the vector
# shuffle arm). The TBL-equivalent byte select matches the LIR mask
# semantics exactly.
# verified-by-hand: pshufb xmm0, xmm1 = 66 0F 38 00 C1.
def x86_pshufb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr3(0x66, 0x38, 0x00, d, s)

# ———————————————————————————————————————————————————————————————
# SSE2 lane-class matrix encoders — the remaining lane classes/ops of
# the vector surface (bitwise, integer/float compares, shifts,
# immediate shuffles, lane moves, packed float div/sqrt and the packed
# conversions). Every byte row was hand-derived from the Intel SDM
# opcode maps and cross-checked with the same offline clang/objdump
# methodology as the rows above; the tests pin every row.
# Hand-verified patterns (clang -target x86_64 + objdump -d) for this
# group — one per encoder:
#   pandn xmm0,xmm1 = 66 0F DF C1; pcmpeqb = 66 0F 74 C1;
#   pcmpeqw = 66 0F 75 C1; pcmpeqd = 66 0F 76 C1;
#   pcmpeqq = 66 0F 38 29 C1; pcmpgtb = 66 0F 64 C1;
#   pcmpgtw = 66 0F 65 C1; pcmpgtd = 66 0F 66 C1;
#   pmuludq xmm2,xmm1 = 66 0F F4 D1; pmulld = 66 0F 38 40 C1;
#   punpckldq xmm2,xmm0 = 66 0F 62 D0; punpckhdq = 66 0F 6A D0;
#   pshufd xmm0,xmm0,0xB1 = 66 0F 70 C0 B1;
#   pshuflw xmm0,xmm1,0x1B = F2 0F 70 C1 1B;
#   pshufhw = F3 0F 70 C1 1B;
#   psllw xmm1,3 = 66 0F 71 F1 03; pslld = 66 0F 72 F1 03;
#   psllq = 66 0F 73 F1 03; psrlw = 66 0F 71 D1 03;
#   psrld = 66 0F 72 D1 03; psrlq = 66 0F 73 D1 03;
#   psraw = 66 0F 71 E1 03; psrad = 66 0F 72 E1 03;
#   psllw xmm0,xmm1 = 66 0F F1 C1; pslld = 66 0F F2 C1;
#   psllq = 66 0F F3 C1; psrlw = 66 0F D1 C1; psrld = 66 0F D2 C1;
#   psrlq = 66 0F D3 C1; psraw = 66 0F E1 C1; psrad = 66 0F E2 C1;
#   cmpeqps xmm0,xmm1 = 0F C2 C1 00; cmpltps = 0F C2 C1 01;
#   cmpeqpd = 66 0F C2 C1 00; sqrtps = 0F 51 C1; sqrtpd = 66 0F 51 C1;
#   divps = 0F 5E C1; divpd = 66 0F 5E C1;
#   movmskps eax,xmm0 = 0F 50 C0; movmskps r10d,xmm15 = 45 0F 50 D7;
#   pextrd eax,xmm0,2 = 66 0F 3A 16 C0 02;
#   pinsrd xmm0,eax,2 = 66 0F 3A 22 C0 02;
#   cvtps2pd = 0F 5A C1; cvtpd2ps = 66 0F 5A C1;
#   cvtps2dq = 66 0F 5B C1; cvtdq2ps = 0F 5B C1;
#   cvtpd2dq = F2 0F E6 C1; cvttpd2dq = 66 0F E6 C1.
# (The v256 VEX forms the tests additionally pin: vmovdqu ymm =
# C4 E1 7E 6F/7F, vpmulld ymm = C4 E2 7D 40, vpmullw ymm = C4 E1 7D D5,
# vaddps ymm = C4 E1 7C 58 — the 3-byte VEX the x86_vex_prefix helper
# always emits.)
# ———————————————————————————————————————————————————————————————
# PANDN xmm, xmm — 66 0F DF /r (dst = (~dst) & src; the ANDNOT form the
# aarch64 intrinsic surface spells BIC).
def x86_pandn_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xDF, d, s)

# Packed equality compares (all-ones in a lane on equality): PCMEQB/W/D
# — 66 0F 74/75/76. PCMEQQ — 66 0F 38 29 is SSE4.1; the SSE2 i64x2
# equality sequence (pcmpeqd + pshufd 0xB1 + pand) is
# x86_emit_vec_eq_i64_sse2 below, so the i64x2 lane class is served on
# the baseline without the token.
def x86_pcmpeqb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x74, d, s)
def x86_pcmpeqw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x75, d, s)
def x86_pcmpeqd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x76, d, s)
def x86_pcmpeqq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr3(0x66, 0x38, 0x29, d, s)

# Packed SIGNED greater-than compares: PCMPGTB/W/D — 66 0F 64/65/66
# (less-than is the same encoder with the operands swapped). The
# UNSIGNED byte/word compares need the 0x80-bias trick over a
# materialized constant vector and have no arm on this route.
def x86_pcmpgtb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x64, d, s)
def x86_pcmpgtw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x65, d, s)
def x86_pcmpgtd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x66, d, s)

# The 32x32->64 widening multiply of the even lanes — PMULUDQ
# 66 0F F4 (the SSE2 building block of the full 32-bit lane multiply).
# PMULLD (the full 32-bit lane multiply) — 66 0F 38 40 is SSE4.1.
def x86_pmuludq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF4, d, s)
def x86_pmulld_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr3(0x66, 0x38, 0x40, d, s)

# The dword unpack pair — PUNPCKLDQ 66 0F 62 / PUNPCKHDQ 66 0F 6A (the
# interleave that reassembles the two PMULUDQ half-products; also the
# lane-insert building block).
def x86_punpckldq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x62, d, s)
def x86_punpckhdq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x6A, d, s)

# The byte/word unpack pairs — PUNPCKLBW 66 0F 60 / PUNPCKLWD 66 0F 61
# and the high-half twins 66 0F 68 / 66 0F 69. The explicit widening
# unpack uses PUNPCK{L,H}{BW,WD} with the SAME register as both operands
# (every element duplicated into its pair slot) followed by the
# arithmetic right shift that sign-extends the widened half.
# verified: punpcklbw xmm0,xmm1 = 66 0F 60 C1; punpcklwd = 66 0F 61 C1;
#           punpckhbw = 66 0F 68 C1; punpckhwd = 66 0F 69 C1.
def x86_punpcklbw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x60, d, s)
def x86_punpcklwd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x61, d, s)
def x86_punpckhbw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x68, d, s)
def x86_punpckhwd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x69, d, s)

# The signed saturating pack pair — PACKSSWB 66 0F 63 (word→byte),
# PACKSSDW 66 0F 6B (dword→word): the destination's low half takes the
# first operand's lanes, the high half the second's, saturating to the
# signed narrow range.
# verified: packsswb xmm0,xmm1 = 66 0F 63 C1; packssdw = 66 0F 6B C1.
def x86_packsswb_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x63, d, s)
def x86_packssdw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x6B, d, s)

# PEXTRW r32, xmm, imm8 — 66 0F C5 /r ib (SSE2; reg = the GP
# destination, rm = the XMM source). PINSRW xmm, r32, imm8 —
# 66 0F C4 /r ib (SSE2; reg = the XMM destination, rm = the GP source).
# verified: pextrw eax,xmm1,3 = 66 0F C5 C1 03;
#           pinsrw xmm0,eax,3 = 66 0F C4 C0 03.
def x86_pextrw_r32_xmm(dst: X64, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x64_hi(dst) || s >= 8 then
    out.push(x86_rex_bits(false, x64_hi(dst), false, s >= 8))
  end
  out.push(0x0F)
  out.push(0xC5)
  out.push(x86_modrm(3, x64_code(dst) as Int, s))
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pinsrw_xmm_r32(d: Int, src: X64, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if d >= 8 || x64_hi(src) then
    out.push(x86_rex_bits(false, d >= 8, false, x64_hi(src)))
  end
  out.push(0x0F)
  out.push(0xC4)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

# The SSE4.1 lane moves: PEXTRB r/m8, xmm, imm8 — 66 0F 3A 14 /r ib
# (reg = the XMM source, rm = the GPR destination); PINSRB — 66 0F 3A
# 20 /r ib (reg = the XMM destination, rm = the GPR source); PINSRQ —
# 66 REX.W 0F 3A 22 /r ib (x86-64 only; the qword GP source). The
# desc's sse41 token gates every one (the named refusal rule).
# verified: pextrb eax,xmm1,3 = 66 0F 3A 14 C8 03;
#           pinsrb xmm0,eax,3 = 66 0F 3A 20 C0 03;
#           pinsrq xmm0,rax,1 = 66 48 0F 3A 22 C0 01.
def x86_pextrb_r32_xmm(dst: X64, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x64_hi(dst) || s >= 8 then
    out.push(x86_rex_bits(false, x64_hi(dst), false, s >= 8))
  end
  out.push(0x0F)
  out.push(0x3A)
  out.push(0x14)
  out.push(x86_modrm(3, s, x64_code(dst) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pinsrb_xmm_r32(d: Int, src: X64, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if d >= 8 || x64_hi(src) then
    out.push(x86_rex_bits(false, d >= 8, false, x64_hi(src)))
  end
  out.push(0x0F)
  out.push(0x3A)
  out.push(0x20)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pinsrq_xmm_r64(d: Int, src: X64, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  out.push(x86_rex_bits(true, d >= 8, false, x64_hi(src)))
  out.push(0x0F)
  out.push(0x3A)
  out.push(0x22)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

# The immediate shuffles: PSHUFD — 66 0F 70 /r ib (all four dwords);
# PSHUFLW — F2 0F 70 /r ib (the low four words; the upper 64 bits are
# copied); PSHUFHW — F3 0F 70 /r ib (the high four words). A SPLAT is
# the all-zero imm32 (every output dword selects source dword 0).
def x86_pshufd_rr(d: Int, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x70, d, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pshuflw_rr(d: Int, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0xF2, 0x70, d, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pshufhw_rr(d: Int, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0xF3, 0x70, d, s)
  out.push((imm & 0xFF) as u8)
  out
end

# The counted per-lane shifts by an imm8 (the /ext group forms on
# 66 0F 71/72/73: /6 logical left, /2 logical right, /4 arithmetic
# right — word/dword/qword; there is NO qword arithmetic right shift
# before AVX-512). The variable-count forms take the count from the low
# 64 bits of the second XMM operand: PSLLW/D/Q — 66 0F F1/F2/F3;
# PSRLW/D/Q — 66 0F D1/D2/D3; PSRAW/D — 66 0F E1/E2. There is no SSE2
# byte shift (no PSLLB/PSRLB/PSRAB): a byte-lane shift is a PSLLW/PSRLW
# plus a materialized per-lane mask constant, which this route has no
# vector constant pool for, so the byte lane class gates on that
# capability rather than fabricating a mask.
def x86_psllw_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x71, 6, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pslld_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x72, 6, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psllq_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x73, 6, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psrlw_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x71, 2, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psrld_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x72, 2, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psrlq_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x73, 2, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psraw_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x71, 4, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psrad_imm(s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0x72, 4, s)
  out.push((imm & 0xFF) as u8)
  out
end

def x86_psllw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF1, d, s)
def x86_pslld_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF2, d, s)
def x86_psllq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xF3, d, s)
def x86_psrlw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xD1, d, s)
def x86_psrld_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xD2, d, s)
def x86_psrlq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xD3, d, s)
def x86_psraw_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xE1, d, s)
def x86_psrad_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xE2, d, s)

# Packed float compares with the imm8 predicate — CMPPS 0F C2 /r ib,
# CMPPD 66 0F C2 /r ib. Predicates: 0 EQ, 1 LT, 2 LE, 3 UNORD, 4 NEQ,
# 5 NLT, 6 NLE, 7 ORD; GT is LT with the operands swapped.
def x86_cmpps_rr(d: Int, s: Int, pred: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0, 0xC2, d, s)
  out.push((pred & 0xFF) as u8)
  out
end

def x86_cmppd_rr(d: Int, s: Int, pred: Int) -> Vec[u8]
  var out: Vec[u8] = x86_sse_rr(0x66, 0xC2, d, s)
  out.push((pred & 0xFF) as u8)
  out
end

# Packed float divide and square root: DIVPS 0F 5E / DIVPD 66 0F 5E;
# SQRTPS 0F 51 / SQRTPD 66 0F 51.
def x86_divps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x5E, d, s)
def x86_divpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x5E, d, s)
def x86_sqrtps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x51, d, s)
def x86_sqrtpd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x51, d, s)

# MOVMSKPS r32, xmm — 0F 50 /r: the sign bit of each float lane packed
# into the low four GPR bits (the lane-mask materialization after a
# CMPPS/CMPPD result, whose true lanes are all-ones).
def x86_movmskps_r32_xmm(dst: X64, s: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(dst) || s >= 8 then
    out.push(x86_rex_bits(false, x64_hi(dst), false, s >= 8))
  end
  out.push(0x0F)
  out.push(0x50)
  out.push(x86_modrm(3, x64_code(dst) as Int, s))
  out
end

# The SSE4.1 lane extract/insert: PEXTRD r/m32, xmm, imm8 — 66 0F 3A
# 16 /r ib (reg = the XMM source, rm = the GPR destination); PINSRD
# xmm, r/m32, imm8 — 66 0F 3A 22 /r ib (reg = the XMM destination). On
# SSE2 the extract is PSHUFD (broadcast the lane to lane 0) + MOVD
# (x86_emit_vec_extract_i32_sse2 below); the insert blend needs a
# materialized lane mask (the punpck/shufps sequence), so it stays
# sse41-gated on this route.
def x86_pextrd_r32_xmm(dst: X64, s: Int, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x64_hi(dst) || s >= 8 then
    out.push(x86_rex_bits(false, s >= 8, false, x64_hi(dst)))
  end
  out.push(0x0F)
  out.push(0x3A)
  out.push(0x16)
  out.push(x86_modrm(3, s, x64_code(dst) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

def x86_pinsrd_xmm_r32(d: Int, src: X64, imm: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if d >= 8 || x64_hi(src) then
    out.push(x86_rex_bits(false, d >= 8, false, x64_hi(src)))
  end
  out.push(0x0F)
  out.push(0x3A)
  out.push(0x22)
  out.push(x86_modrm(3, d, x64_code(src) as Int))
  out.push((imm & 0xFF) as u8)
  out
end

# The packed conversions: CVTPS2PD 0F 5A / CVTPD2PS 66 0F 5A;
# CVTPS2DQ 66 0F 5B / CVTDQ2PS 0F 5B; CVTPD2DQ F2 0F E6 /
# CVTTPD2DQ 66 0F E6 (the truncating twin).
def x86_cvtps2pd_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x5A, d, s)
def x86_cvtpd2ps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x5A, d, s)
def x86_cvtps2dq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0x5B, d, s)
def x86_cvtdq2ps_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0, 0x5B, d, s)
def x86_cvtpd2dq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0xF2, 0xE6, d, s)
def x86_cvttpd2dq_rr(d: Int, s: Int) -> Vec[u8] = x86_sse_rr(0x66, 0xE6, d, s)

# ———————————————————————————————————————————————————————————————
# VEX-encoded AVX forms (the v256 vector class — audit item 34 + the
# vector-ABI slice)
# ———————————————————————————————————————————————————————————————
# The 3-byte VEX prefix (always the 3-byte form: one byte longer than
# the 2-byte form but legal for every register combination, and the only
# shape that can carry the B extension a high base register needs).
# Layout (Intel SDM):
#   C4 [R̄ X̄ B̄ mmmmm] [W v̄vvvv L pp]
# mmmmm: 00001 = 0F, 00010 = 0F38, 00011 = 0F3A.
# pp: 00 = none, 01 = 66, 10 = F3, 11 = F2.
# L: 0 = 128-bit, 1 = 256-bit.
# VEX.vvvv is the INVERTED first-source register: the caller passes the
# RAW inverted field value (15 for the no-source/reserved forms,
# (reg ^ 15) & 15 for a source — this backend has no unary ~).
# R/X/B are the inverted extensions of ModRM.reg / SIB.index /
# ModRM.rm-base; the register form uses R only, the memory form R + B.
def x86_vex_prefix(reg_ext: Bool, base_ext: Bool, map: Int, vvvv: Int, l: Bool, pp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  let r_bar = if reg_ext then 0 else 1 end
  let b_bar = if base_ext then 0 else 1 end
  out.push(0xC4)
  out.push(((r_bar << 7) | (1 << 6) | (b_bar << 5) | (map & 0x1F)) as u8)
  let lv = if l then 1 else 0 end
  out.push((((vvvv & 0xF) << 3) | (lv << 2) | (pp & 3)) as u8)
  out
end

# The VEX pp field of a legacy SSE mandatory prefix (the binop table's
# prefix column: 0x66 -> 66, 0xF3 -> F3, 0xF2 -> F2, 0 -> none).
def x86_vex_pp(prefix: Int) -> Int
  if prefix == 0x66 then 1
  elsif prefix == 0xF3 then 2
  elsif prefix == 0xF2 then 3
  else 0
  end
end

# VMOVDQU xmm/ymm, [base + disp] — VEX.F3.0F.WIG 6F /r (AVX; the L bit
# selects the 128/256-bit operand). VEX.vvvv is reserved (raw 1111).
def x86_vmovdqu_load(d: Int, base: X64, disp: Int, is256: Bool) -> Vec[u8]
  var out: Vec[u8] = x86_vex_prefix(d >= 8, x64_hi(base), 1, 15, is256, 2)
  out.push(0x6F)
  x86_append_mem(out, d, base, disp)
  out
end

# VMOVDQU [base + disp], xmm/ymm — VEX.F3.0F.WIG 7F /r.
def x86_vmovdqu_store(base: X64, disp: Int, s: Int, is256: Bool) -> Vec[u8]
  var out: Vec[u8] = x86_vex_prefix(s >= 8, x64_hi(base), 1, 15, is256, 2)
  out.push(0x7F)
  x86_append_mem(out, s, base, disp)
  out
end

# A three-operand VEX register form: d = s1 op s2 (VEX.NDS — VEX.vvvv
# carries the inverted first source, ModRM.reg the destination,
# ModRM.rm the second source).
def x86_vex_rrr(map: Int, pp: Int, opcode: Int, d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  var out: Vec[u8] = x86_vex_prefix(d >= 8, false, map, (s1 ^ 15) & 15, is256, pp)
  out.push(opcode as u8)
  out.push(x86_modrm(3, d, s2))
  out
end

# VPSHUFB xmm/ymm (VEX 66.0F38.00 /r, AVX2 for the 256-bit form): each
# 128-bit lane shuffles within itself — the same per-half TBL semantics
# the aarch64 arm and the mask semantics use.
def x86_vex_pshufb(d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  x86_vex_rrr(2, 1, 0x00, d, s1, s2, is256)
end

# VANDNPS xmm/ymm (VEX.0F 55 /r; AVX1): d = ~s1 & s2 — the 256-bit
# and-not the explicit surface uses as a & ~b with the operands staged
# (s1 = b, s2 = a). Bit-identical for every integer lane class (the
# same AVX1-FP-logical convention the 256-bit AND/OR/XOR arm uses).
# verified: vandnps ymm0,ymm1,ymm2 = C5 F4 55 C2.
def x86_vex_andnps_rrr(d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  x86_vex_rrr(1, 0, 0x55, d, s1, s2, is256)
end

# The AVX2 per-lane variable shifts (VEX.66.0F38 47/45/46 /r):
# VPSLLVD / VPSRLVD / VPSRAVD — d = s1 shifted by the per-lane dword
# counts of s2 (the ONLY per-lane variable shift forms before the
# AVX-512 VPSLLVW/VPSLLVQ). verified, ymm:
#   vpsllvd ymm0,ymm1,ymm2 = C4 E2 75 47 C2;
#   vpsrlvd = C4 E2 75 45 C2; vpsravd = C4 E2 75 46 C2;
#   the xmm form = C4 E2 71 47/45/46 C2 (L=0).
def x86_vex_vpsllvd_rrr(d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  x86_vex_rrr(2, 1, 0x47, d, s1, s2, is256)
end

def x86_vex_vpsrlvd_rrr(d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  x86_vex_rrr(2, 1, 0x45, d, s1, s2, is256)
end

def x86_vex_vpsravd_rrr(d: Int, s1: Int, s2: Int, is256: Bool) -> Vec[u8]
  x86_vex_rrr(2, 1, 0x46, d, s1, s2, is256)
end

# A VEX shift-by-immediate (VEX.66.0F 71/72/73 /ext ib). The VEX form
# is unusual: VEX.vvvv is the DESTINATION and ModRM.rm the source (the
# inverse of the three-same NDS layout), ModRM.reg carries the opcode
# extension (6 = left, 2 = logical right, 4 = arithmetic right) and the
# opcode selects the element (71 = word, 72 = dword, 73 = qword). W is
# WIG for every form. verified: vpsllw ymm0,ymm1,3 = C5 FD 71 F1 03
# (our always-3-byte prefix emits C4 E1 7D 71 F1 03, the same
# instruction); vpsrlw = /2, vpsraw = /4.
def x86_vex_shift_imm(d: Int, s: Int, opcode: Int, ext: Int, is256: Bool, imm: Int) -> Vec[u8]
  var out: Vec[u8] = x86_vex_prefix(d >= 8, false, 1, (d ^ 15) & 15, is256, 1)
  out.push(opcode as u8)
  out.push(x86_modrm(3, ext, s))
  out.push((imm & 0xFF) as u8)
  out
end

# The reserved-vvvv VEX form (VEX.vvvv = 1111): the AVX2 broadcasts
# VPBROADCASTB/W/D/Q (VEX.66.0F38 78/79/58/59 /r) with the GP
# destination reg field and the XMM source rm field (the source is an
# xmm register previously loaded with VMOVD/VMOVQ — the AVX2 baseline
# has no GP-source broadcast form; that is AVX-512's EVEX shape).
# verified, ymm: vpbroadcastd ymm0,xmm0 = C4 E2 7D 58 C0;
# vpbroadcastq = C4 E2 7D 59 C0; vpbroadcastb = C4 E2 7D 78 C0;
# vpbroadcastw = C4 E2 7D 79 C0 (the xmm forms use 79/7D… L=0).
def x86_vex_broadcast(d: Int, s: Int, is256: Bool, opcode: Int) -> Vec[u8]
  var out: Vec[u8] = x86_vex_prefix(d >= 8, false, 2, 15, is256, 1)
  out.push(opcode as u8)
  out.push(x86_modrm(3, d, s))
  out
end

# ———————————————————————————————————————————————————————————————
# Sized ALU / memory / atomic encoders — the pointer/atomic slice
# ———————————————————————————————————————————————————————————————
# The 1/2/4-byte memory forms of the scalar width classes: the LIR
# pointer/atomic statements carry a storage width w in 1/2/4/8, and the
# x86 encodings differ only by operand-size prefix / REX.W and the
# byte-opcode low bit. REX is emitted minimally: W when w == 8, R/B
# for extended fields, plus the mandatory 0x40 byte-prefix whenever a
# byte operand names spl/bpl/sil/dil (codes 4..7).

# ALU r32, r32 — [REX] opcode /r (no W: the 32-bit form, used by the
# F32 sign probe where the sign lives in bit 31 and the writing form
# zero-extends).
def x86_alu_rr32(opcode: Int, dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(src) || x64_hi(dst) then
    out.push(x86_rex_bits(false, x64_hi(src), false, x64_hi(dst)))
  end
  out.push(opcode as u8)
  out.push(x86_modrm(3, x64_code(src) as Int, x64_code(dst) as Int))
  out
end

def x86_alu_rr_w(w: Int, opcode_w: Int, dst: X64, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if w == 2 then
    out.push(0x66)
  end
  var need_rex = false
  if w == 8 then need_rex = true end
  if x64_hi(src) || x64_hi(dst) then need_rex = true end
  if w == 1 && ((x64_code(src) as Int) >= 4 || (x64_code(dst) as Int) >= 4) then need_rex = true end
  if need_rex then
    out.push(x86_rex_bits(w == 8, x64_hi(src), false, x64_hi(dst)))
  end
  if w == 1 then
    out.push((opcode_w - 1) as u8)
  else
    out.push(opcode_w as u8)
  end
  out.push(x86_modrm(3, x64_code(src) as Int, x64_code(dst) as Int))
  out
end

# MOV r/m8, r8 — [REX] 88 /r (the width-1 store).
def x86_mov_m8_r8(base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  var need_rex = false
  if x64_hi(src) || x64_hi(base) then need_rex = true end
  if (x64_code(src) as Int) >= 4 then need_rex = true end
  if need_rex then
    out.push(x86_rex_bits(false, x64_hi(src), false, x64_hi(base)))
  end
  out.push(0x88)
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# MOV r/m16, r16 — 66 [REX] 89 /r (the width-2 store).
def x86_mov_m16_r16(base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0x66)
  if x64_hi(src) || x64_hi(base) then
    out.push(x86_rex_bits(false, x64_hi(src), false, x64_hi(base)))
  end
  out.push(0x89)
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# MOV r/m32, r32 — [REX] 89 /r (the width-4 store; the register form
# zeroes the upper 32 bits, so the stored image is the canonical
# zero-extended word).
def x86_mov_m32_r32(base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(src) || x64_hi(base) then
    out.push(x86_rex_bits(false, x64_hi(src), false, x64_hi(base)))
  end
  out.push(0x89)
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# MOV r32, r/m32 — [REX] 8B /r (the width-4 zero-extending load).
def x86_mov_r32_rm(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(dst) || x64_hi(base) then
    out.push(x86_rex_bits(false, x64_hi(dst), false, x64_hi(base)))
  end
  out.push(0x8B)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# MOVZX r64, r/m16 — REX.W(+R,+B) 0F B7 /r (the width-2 zero-extending
# load). verified-by-hand: movzx rax, word [rdi] = 48 0F B7 07.
def x86_movzx_r64_m16(dst: X64, base: X64, disp: Int) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(x86_rex_bits(true, x64_hi(dst), false, x64_hi(base)))
  out.push(0x0F)
  out.push(0xB7)
  x86_append_mem(out, x64_code(dst) as Int, base, disp)
  out
end

# XCHG r/m8/16/32/64, r — [REX] 86 (byte) / [66] [REX] 87 /r. The
# exchange is implicitly LOCKed: it is the x86-TSO sequentially
# consistent store form (and an atomic swap for the RMW family 4).
def x86_xchg_rm(w: Int, base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if w == 2 then
    out.push(0x66)
  end
  var need_rex = w == 8
  if x64_hi(src) || x64_hi(base) then need_rex = true end
  if w == 1 && (x64_code(src) as Int) >= 4 then need_rex = true end
  if need_rex then
    out.push(x86_rex_bits(w == 8, x64_hi(src), false, x64_hi(base)))
  end
  if w == 1 then
    out.push(0x86)
  else
    out.push(0x87)
  end
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# LOCK XADD r/m8/16/32/64, r — F0 [66] [REX] 0F C0 (byte) / C1 /r.
# The destination register receives the OLD memory value; the memory
# receives old + register.
def x86_lock_xadd(w: Int, base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF0)
  if w == 2 then
    out.push(0x66)
  end
  var need_rex = w == 8
  if x64_hi(src) || x64_hi(base) then need_rex = true end
  if w == 1 && (x64_code(src) as Int) >= 4 then need_rex = true end
  if need_rex then
    out.push(x86_rex_bits(w == 8, x64_hi(src), false, x64_hi(base)))
  end
  out.push(0x0F)
  if w == 1 then
    out.push(0xC0)
  else
    out.push(0xC1)
  end
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# LOCK CMPXCHG r/m8/16/32/64, r — F0 [66] [REX] 0F B0 (byte) / B1 /r.
# The accumulator is architecturally RAX (the expected value); on
# match [mem] <- src, else RAX <- [mem]; RAX always ends with the OLD
# memory value.
def x86_lock_cmpxchg(w: Int, base: X64, disp: Int, src: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  out.push(0xF0)
  if w == 2 then
    out.push(0x66)
  end
  var need_rex = w == 8
  if x64_hi(src) || x64_hi(base) then need_rex = true end
  if w == 1 && (x64_code(src) as Int) >= 4 then need_rex = true end
  if need_rex then
    out.push(x86_rex_bits(w == 8, x64_hi(src), false, x64_hi(base)))
  end
  out.push(0x0F)
  if w == 1 then
    out.push(0xB0)
  else
    out.push(0xB1)
  end
  x86_append_mem(out, x64_code(src) as Int, base, disp)
  out
end

# MFENCE — 0F AE F0 (the x86-TSO full barrier the SeqCst fence arm
# emits; weaker orders need no instruction under TSO).
# verified-by-hand: 0F AE F0.
def x86_mfence() -> Vec[u8]
  Vec::from([0x0F, 0xAE, 0xF0])
end

# PUSH r64 / POP r64 — [REX.B] 50+rd / 58+rd.
# verified-by-hand: push rbp = 55; pop rbp = 5D.
def x86_push_r(r: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(r) then
    out.push(0x41)
  end
  out.push((0x50 + ((x64_code(r) as Int) & 7)) as u8)
  out
end

def x86_pop_r(r: X64) -> Vec[u8]
  var out: Vec[u8] = Vec::new()
  if x64_hi(r) then
    out.push(0x41)
  end
  out.push((0x58 + ((x64_code(r) as Int) & 7)) as u8)
  out
end

# RET / LEAVE (mov rsp, rbp; pop rbp) / NOP / UD2.
# verified-by-hand: ret = C3; leave = C9; nop = 90; ud2 = 0F 0B.
def x86_ret() -> Vec[u8]
  Vec::from([0xC3])
end

def x86_leave() -> Vec[u8]
  Vec::from([0xC9])
end

def x86_nop() -> Vec[u8]
  Vec::from([0x90])
end

def x86_ud2() -> Vec[u8]
  Vec::from([0x0F, 0x0B])
end

# SYSCALL (the LIR syscall marker's x86-64 kernel entry): the classic
# two-byte form 0F 05 (no REX prefix needed). The Linux SysV kernel ABI
# the LIR route's ELF64 object contract names: the number in RAX and
# the arguments in RDI, RSI, RDX, R10, R8, R9; the result comes back in
# RAX with the negative-errno convention (no carry normalization, unlike
# Darwin). verified-by-hand: syscall = 0F 05.
def x86_syscall() -> Vec[u8]
  Vec::from([0x0F, 0x05])
end

# JMP rel32 = E9 id; Jcc rel32 = 0F 80+cc id; CALL rel32 = E8 id. The
# four displacement bytes start as zero and are patched by
# x86_resolve_patches (intra-object targets) or described by an
# R_X86_64_PLT32 relocation (extern calls).
# verified-by-hand: call rel32 = E8 xx xx xx xx.
def x86_jmp_rel32() -> Vec[u8]
  Vec::from([0xE9, 0x00, 0x00, 0x00, 0x00])
end

def x86_jcc_rel32(cc: Int) -> Vec[u8]
  Vec::from([0x0F, (0x80 + (cc & 0x0F)) as u8, 0x00, 0x00, 0x00, 0x00])
end

def x86_call_rel32() -> Vec[u8]
  Vec::from([0xE8, 0x00, 0x00, 0x00, 0x00])
end

# The SHORT forms (2 bytes): JMP rel8 = EB cb; Jcc rel8 = 70+cc cb. The
# stage-1 emitter uses the rel32 forms uniformly (no relaxation), but the
# shorts are provided and pinned here for the later relaxation/peephole
# pass — and because the item-30 instruction list names them.
# verified-by-hand: jmp +2 = EB 02; je +2 = 74 02; jne = 75.
def x86_jmp_rel8(rel: Int) -> Vec[u8]
  if rel < -128 || rel > 127 then
    panic("x86_jmp_rel8: rel " + rel.to_string() + " does not fit the signed 8-bit field")
  end
  Vec::from([0xEB, (rel & 0xFF) as u8])
end

def x86_jcc_rel8(cc: Int, rel: Int) -> Vec[u8]
  if rel < -128 || rel > 127 then
    panic("x86_jcc_rel8: rel " + rel.to_string() + " does not fit the signed 8-bit field")
  end
  Vec::from([(0x70 + (cc & 0x0F)) as u8, (rel & 0xFF) as u8])
end

# The x86 condition-code nibble of a LIR condition (the SETcc/Jcc
# opcode low nibble; the same table the compare and branch arms use):
#   Eq 4 (E/Z), Ne 5 (NE/NZ), Lt C (L), Le E (LE), G F (G), Ge D (GE),
#   Ult 2 (B/C), Ule 6 (BE), Ugt 7 (A), Uge 3 (AE/NC).
def x86_cc_of(cond: LirCond) -> Int
  match cond
  when LirCond::LirEq then 0x4
  when LirCond::LirNe then 0x5
  when LirCond::LirLt then 0xC
  when LirCond::LirLe then 0xE
  when LirCond::LirGt then 0xF
  when LirCond::LirGe then 0xD
  when LirCond::LirUlt then 0x2
  when LirCond::LirUle then 0x6
  when LirCond::LirUgt then 0x7
  when LirCond::LirUge then 0x3
  end
end

# The inverse of a LIR condition (the far-branch / switch helpers):
# the pairs differ only in the low opcode bit, exactly the CC table.
def x86_cc_inv(cond: LirCond) -> LirCond
  match cond
  when LirCond::LirEq then LirCond::LirNe
  when LirCond::LirNe then LirCond::LirEq
  when LirCond::LirLt then LirCond::LirGe
  when LirCond::LirGe then LirCond::LirLt
  when LirCond::LirGt then LirCond::LirLe
  when LirCond::LirLe then LirCond::LirGt
  when LirCond::LirUlt then LirCond::LirUge
  when LirCond::LirUge then LirCond::LirUlt
  when LirCond::LirUgt then LirCond::LirUle
  when LirCond::LirUle then LirCond::LirUgt
  end
end

# A condition's LIR spelling (the named fail-closed errors).
def x86_cond_name(cond: LirCond) -> String
  match cond
  when LirCond::LirEq then "Eq"
  when LirCond::LirNe then "Ne"
  when LirCond::LirLt then "Lt"
  when LirCond::LirLe then "Le"
  when LirCond::LirGt then "Gt"
  when LirCond::LirGe then "Ge"
  when LirCond::LirUlt then "Ult"
  when LirCond::LirUle then "Ule"
  when LirCond::LirUgt then "Ugt"
  when LirCond::LirUge then "Uge"
  end
end

# ———————————————————————————————————————————————————————————————
# Emit state, deferred patches and extern relocations
# ———————————————————————————————————————————————————————————————
# The route emits EVERY function into ONE shared CodeBuffer (the
# backend_rv.tg / backend_thumb.tg whole-program model): block and
# function labels coexist in buf.labels, intra-object branches/calls are
# deferred rel32 patches resolved by x86_resolve_patches once the whole
# program is emitted, and calls to undefined externs emit `call rel32`
# plus an R_X86_64_PLT32 relocation record for the ELF writer.

struct X86Patch
  offset: Int     # byte offset of the rel32 displacement field
  label: String   # target label (a block or function label)
end

struct X86Reloc
  offset: Int     # byte offset of the rel32 displacement field
  sym: String     # the undefined extern symbol
  kind: Int       # ELF x86-64 relocation type
end

# ELF x86-64 relocation types this backend emits (the psABI):
#   R_X86_64_PLT32 = 4 (the PC-relative 32-bit call displacement; the
#   canonical addend is -4 — the relocation field is the 4-byte
#   displacement and the PC basis is the END of the call instruction);
#   R_X86_64_PC32 = 2 (the RIP-relative 32-bit displacement of a
#   static-value load; addend -4, the same PC-basis compensation).
def x86_reloc_plt32() -> Int = 4

def x86_reloc_pc32() -> Int = 2

struct X86Emit
  buf: CodeBuffer
  patches: Vec[X86Patch]
  relocs: Vec[X86Reloc]
  syms: Vec[AsmSymbol]
  # True between a LirCmp/LirFCmp and its adjacent LirCset (invariant
  # I1). The x86 FLAGS cannot represent the four-way ordered/unordered
  # float outcome in the integer cc table, so a LirFCmp materializes a
  # three-bit compare code in RDX instead and the adjacent LirCset
  # decodes it (pending_fcmp true); an integer LirCmp keeps the flags.
  pending_cmp: Bool
  pending_fcmp: Bool
  # Whole-program DATA state (the statics slice): the .data byte image
  # and the .bss zero region size. The statics' symbols ride xe.syms
  # (Section::Data / Section::Bss) exactly like the function symbols,
  # and x86_elf64_obj serializes both sections.
  data: Vec[u8]
  bss_size: Int
  # A monotone counter for the emitter-synthesized local labels (the
  # atomic CAS loops and the saturating-conversion fixups): every label
  # is unique across the whole shared buffer, so the deferred-patch
  # resolver can never confuse two sites.
  label_counter: Int
  # Does the target description advertise the SSSE3 token? The vector
  # shuffle arm is pshufb-only (the TBL-equivalent byte select); the
  # canonical x86_64 description carries no ssse3, so the arm fails
  # closed with the named rule until a desc opts in.
  ssse3_ok: Bool
  # The AVX/AVX2 tokens (the v256 vector arm's gate — audit item 34 +
  # the vector-ABI slice): `avx_ok` admits the 256-bit load/store, the
  # three-operand float/logical VEX forms and the vector ABI crossings
  # in the ymm file; `avx2_ok` additionally admits the 256-bit INTEGER
  # VEX forms (VPADDB/W/D/Q, VPSUB*, VPMULLW, VPSHUFB ymm). The
  # canonical x86_64 description carries neither, so every v256
  # statement fails closed at emission with the desc's name.
  avx_ok: Bool
  avx2_ok: Bool
  # The SSE4.1 token: it upgrades the 32-bit lane multiply to the
  # single-instruction PMULLD (the SSE2 baseline always serves the
  # same lane class through the PMULUDQ-twice sequence) and admits the
  # SSE4.1-only lane extract/insert forms. The canonical x86_64
  # description carries no sse41 token, so the baseline sequences are
  # the default and every SSE4.1-only form names the token.
  sse41_ok: Bool
end

def x86_emit_new() -> X86Emit
  X86Emit {
    buf: buf_new(),
    patches: Vec::new(),
    relocs: Vec::new(),
    syms: Vec::new(),
    pending_cmp: false,
    pending_fcmp: false,
    data: Vec::new(),
    bss_size: 0,
    label_counter: 0,
    ssse3_ok: false,
    avx_ok: false,
    avx2_ok: false,
    sse41_ok: false
  }
end

# A fresh emitter-local label (the atomic loops and the conversion
# fixups): unique across the shared buffer by the monotone counter.
def x86_fresh_label(inout xe: X86Emit, tag: String) -> String
  let n = xe.label_counter
  xe.label_counter = n + 1
  ".Lx86." + tag + "." + n.to_string()
end

# Register a machine function symbol at the current buffer position.
# Stage 1 emits every body into one .text (@cold is not specialized —
# the hint is documented as ignored in the module header). `binding` is
# the ABI-stability boundary's answer: lir_fn_export_binding makes a
# NICHED-enum-crossing function LOCAL — internal to the object, never a
# public ABI export (its ExternC form does not exist) — while every
# other function stays Global exactly as before (a payloaded tagged
# enum's canonical value word crosses stably since fourth-audit P0-20).
def x86_emit_fn_symbol(inout xe: X86Emit, name: String, binding: SymBinding) -> Unit
  xe.syms.push(AsmSymbol {
    name: name,
    section: Section::Text,
    offset: buf_pos(&xe.buf),
    size: 0,
    binding: binding,
    kind: SymKind::Func
  })
end

# JMP/Jcc/CALL to a label of the shared buffer: emit the rel32 form with
# a zero displacement and record the deferred patch.
def x86_emit_jmp_label(inout xe: X86Emit, label: String) -> Unit
  let off = buf_pos(&xe.buf) + 1
  x86_emit(&mut xe.buf, x86_jmp_rel32())
  xe.patches.push(X86Patch { offset: off, label: label })
end

def x86_emit_jcc_label(inout xe: X86Emit, cond: LirCond, label: String) -> Unit
  let off = buf_pos(&xe.buf) + 2
  x86_emit(&mut xe.buf, x86_jcc_rel32(x86_cc_of(cond)))
  xe.patches.push(X86Patch { offset: off, label: label })
end

def x86_emit_call_label(inout xe: X86Emit, label: String) -> Unit
  let off = buf_pos(&xe.buf) + 1
  x86_emit(&mut xe.buf, x86_call_rel32())
  xe.patches.push(X86Patch { offset: off, label: label })
end

# A call to an undefined extern: `call rel32` with a zero displacement
# plus an R_X86_64_PLT32 relocation (the linker computes S + A - P).
def x86_emit_call_remote(inout xe: X86Emit, sym: String) -> Unit
  let off = buf_pos(&xe.buf) + 1
  x86_emit(&mut xe.buf, x86_call_rel32())
  xe.relocs.push(X86Reloc { offset: off, sym: sym, kind: x86_reloc_plt32() })
end

# THE ABORT FUNNEL's call: a remote call to the runtime's whitelisted
# __intrinsic_abort plus the undefined-symbol registration, so the ELF
# writer binds the PLT32 relocation even when the program never declared
# the extern (a bare program linking no std/runtime still carries a
# well-formed undefined symbol instead of a null-indexed relocation).
def x86_emit_abort_call(inout xe: X86Emit) -> Unit
  x86_emit_call_remote(xe, "__intrinsic_abort")
  var found = false
  var i = 0
  while i < xe.syms.len() do
    if xe.syms[i].name == "__intrinsic_abort" then found = true end
    i = i + 1
  end
  if !found then
    xe.syms.push(AsmSymbol {
      name: "__intrinsic_abort".to_string(),
      section: Section::Extern,
      offset: 0,
      size: 0,
      binding: SymBinding::Global,
      kind: SymKind::Func
    })
  end
end

# Resolve every deferred patch — runs once, after every function (and so
# every block label and function label) of the shared buffer is defined.
# rel32 = target - (offset + 4); an unresolved label fails the compile
# closed, never a silently broken branch.
def x86_resolve_patches(inout xe: X86Emit) -> Result[Unit, String]
  var pi = 0
  while pi < xe.patches.len() do
    let p = xe.patches[pi]
    match xe.buf.labels.get(p.label.clone())
    when Option::Some(target) then
      let rel = target - (p.offset + 4)
      patch32_le(&mut xe.buf, p.offset, (rel & 0xFFFF_FFFF) as u32)
    when Option::None then
      return Result::Err("x86_64: internal error: branch target `" + p.label + "` was never defined (fail-closed)")
    end
    pi = pi + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# The SysV register model
# ———————————————————————————————————————————————————————————————

# The physical register of a fixed (precolored) LIR general vreg:
# 0..5 -> rdi, rsi, rdx, rcx, r8, r9 (target_desc.tg x86_64_desc
# arg_regs). Fixed ids 6/7 have no x86-64 slot (SysV passes arguments
# 7+ on the stack): the validator rejects every use before emission, so
# reaching this panic is a backend divergence.
def x86_fixed_phys(id: Int) -> X64
  match id
  when 0 then X64::RDI
  when 1 then X64::RSI
  when 2 then X64::RDX
  when 3 then X64::RCX
  when 4 then X64::R8
  when 5 then X64::R9
  when _ then panic("x86_64: fixed LIR vreg " + id.to_string() + " has no SysV integer register (only 0..5 do; the validator rejects 6..7 and every fixed float id here)")
  end
end

# The XMM code of a fixed (precolored) LIR float ABI vreg 8..15:
# 8+k -> xmm k (the SysV SSE argument registers xmm0..xmm7 and the
# return register xmm0 = fixed id 8).
def x86_fixed_fp_code(id: Int) -> Int
  if !lir_is_fixed_fp_id(id) then
    panic("x86_64: fixed float id " + id.to_string() + " is outside 8..15")
  end
  id - lir_fixed_fp_base()
end

# The allocatable FP pool (the route's FP register file): SysV x86-64
# makes ALL XMM registers caller-saved, so the pool can take xmm8..xmm14
# (phys ids 108..114 in the shared 100+code FP namespace, disjoint from
# every general-register physical id). xmm15 (phys 115) is the FP
# statement temp (x86_fp_scratch — the def temp of a memory-resident
# value and the spill-load temp), never allocated; xmm0..xmm7 are the
# fixed ABI file and also never allocated.
def x86_fp_pool_ids() -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  var code = 8
  while code <= 14 do
    out.push(100 + code)
    code = code + 1
  end
  out
end

# The XMM code of an allocated FP physical id (100 + code).
def x86_fp_phys_of(phys: Int) -> Int
  phys - 100
end

# The FP statement temp (xmm15): the def temp of a memory-resident FP
# value and the spill-load / constant scratch.
def x86_fp_scratch() -> Int = 15

# The XMM code of a FIXED or POOLED float operand: fixed ids 8+k ->
# xmm k; a pool segment's phys -> its code; the def temp for a
# memory-resident segment (with a pending slot store).
struct X86FpDefTarget
  xmm: Int
  store_slot: Int
end

def x86_fp_def_target(alloc: LirAlloc, vreg: Int, pos: Int) -> X86FpDefTarget
  if lir_is_fixed_fp_id(vreg) then
    return X86FpDefTarget { xmm: x86_fixed_fp_code(vreg), store_slot: -1 }
  end
  if vreg < lir_first_alloc_vreg() then
    panic("x86_64: general fixed vreg " + vreg.to_string() + " reached the FP def resolver (lowering invariant)")
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        X86FpDefTarget { xmm: x86_fp_phys_of(s.phys), store_slot: -1 }
      else
        if s.slot < 0 then
          panic("x86_64: memory-resident FP def of vreg " + vreg.to_string() + " has no slot")
        end
        X86FpDefTarget { xmm: x86_fp_scratch(), store_slot: s.slot }
      end
    when Option::None then
      panic("x86_64: FP def outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    X86FpDefTarget { xmm: x86_fp_scratch(), store_slot: -1 }
  end
end

# Materialize an FP operand at `pos` into an XMM register: a fixed ABI
# id directly, a pool segment register (reloading its slot first when a
# reload record exists), or the requested scratch for a memory-resident
# segment.
def x86_fp_emit_use(inout xe: X86Emit, alloc: LirAlloc, vreg: Int, pos: Int, w: LirFpWidth, pref: Int) -> Int
  if lir_is_fixed_fp_id(vreg) then
    return x86_fixed_fp_code(vreg)
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        let xr = x86_fp_phys_of(s.phys)
        if lir_reload_at(alloc.reloads, pos, vreg) then
          if w == LirFpWidth::LirF32 then
            x86_emit(&mut xe.buf, x86_movss_load(xr, X64::RBP, lir_slot_offset(s.slot)))
          else
            x86_emit(&mut xe.buf, x86_movsd_load(xr, X64::RBP, lir_slot_offset(s.slot)))
          end
        end
        xr
      else
        if s.slot < 0 then
          panic("x86_64: memory-resident FP use of vreg " + vreg.to_string() + " has no slot")
        end
        if w == LirFpWidth::LirF32 then
          x86_emit(&mut xe.buf, x86_movss_load(pref, X64::RBP, lir_slot_offset(s.slot)))
        else
          x86_emit(&mut xe.buf, x86_movsd_load(pref, X64::RBP, lir_slot_offset(s.slot)))
        end
        pref
      end
    when Option::None then
      panic("x86_64: FP use outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    panic("x86_64: FP use of vreg with no intervals: " + vreg.to_string())
  end
end

# The spill-slot displacement of a MEMORY-RESIDENT FP operand (the
# memory-operand shortcut: the SSE arithmetic/compare forms accept one
# [rbp+disp] operand). Option::None for fixed/register-resident values.
def x86_fp_mem_disp_of(alloc: LirAlloc, vreg: Int, pos: Int) -> Option[Int]
  if lir_is_fixed_fp_id(vreg) || vreg < lir_first_alloc_vreg() then
    return Option::None
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys < 0 then
        if s.slot < 0 then
          panic("x86_64: memory-resident FP operand " + vreg.to_string() + " has no slot")
        end
        Option::Some(lir_slot_offset(s.slot))
      else
        Option::None
      end
    when Option::None then
      panic("x86_64: FP operand use outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    panic("x86_64: FP operand use of vreg with no intervals: " + vreg.to_string())
  end
end

# Store a register-resident FP def back to its slot at its width.
def x86_fp_store_def(inout xe: X86Emit, dt: X86FpDefTarget, w: LirFpWidth) -> Unit
  if dt.store_slot >= 0 then
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_movss_store(X64::RBP, lir_slot_offset(dt.store_slot), dt.xmm))
    else
      x86_emit(&mut xe.buf, x86_movsd_store(X64::RBP, lir_slot_offset(dt.store_slot), dt.xmm))
    end
  end
end

def x86_fp_mov(inout xe: X86Emit, w: LirFpWidth, d: Int, s: Int) -> Unit
  if d != s then
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_movss_rr(d, s))
    else
      x86_emit(&mut xe.buf, x86_movsd_rr(d, s))
    end
  end
end

# The physical register of an allocated general physical id:
# caller-saved pool 9..14 -> r10, r11, rbx, r12, r13, r14;
# callee-saved id 19 -> r15.
def x86_phys_of(phys: Int) -> X64
  match phys
  when 9 then X64::R10
  when 10 then X64::R11
  when 11 then X64::RBX
  when 12 then X64::R12
  when 13 then X64::R13
  when 14 then X64::R14
  when 19 then X64::R15
  when _ then panic("x86_64: physical id " + phys.to_string() + " is outside the route's general pools (9..14 caller-saved, 19 callee-saved)")
  end
end

def x86_phys_name(phys: Int) -> String
  match phys
  when 9 then "r10"
  when 10 then "r11"
  when 11 then "rbx"
  when 12 then "r12"
  when 13 then "r13"
  when 14 then "r14"
  when 19 then "r15"
  when _ then "phys" + phys.to_string()
  end
end

# The allocator ids this route maps (the emitter's pools).
def x86_pool_ids() -> Vec[Int]
  Vec::from([9, 10, 11, 12, 13, 14])
end

def x86_cc_ids() -> Vec[Int]
  Vec::from([19])
end

# Is the physical id one of the SysV callee-saved registers the pool map
# can assign (rbx/r12/r13/r14 via the caller-saved pool's ids 11..14, and
# r15 via the callee-saved id 19)?
def x86_phys_is_callee_saved(phys: Int) -> Bool
  phys == 11 || phys == 12 || phys == 13 || phys == 14 || phys == 19
end

# The callee-saved registers the function actually uses, ASCENDING by
# machine code (rbx, r12, r13, r14, r15): every pool id whose segments
# were assigned one of rbx/r12/r13/r14, plus the allocator's cc_used
# (id 19 -> r15). The prologue saves exactly this list and the epilogue
# restores it. Deterministic: the segment scan only builds a membership
# set, the emitted order is the fixed ascending probe below.
def x86_saved_regs(alloc: LirAlloc) -> Vec[X64]
  var used: Set[Int] = Set::new()
  let entries = alloc.segs_of.entries()
  var ei = 0
  while ei < entries.len() do
    let segs = entries[ei].1
    var si = 0
    while si < segs.len() do
      let p = segs[si].phys
      if p >= 0 then
        used.insert(p)
      end
      si = si + 1
    end
    ei = ei + 1
  end
  var ci = 0
  while ci < alloc.cc_used.len() do
    used.insert(alloc.cc_used[ci])
    ci = ci + 1
  end
  var out: Vec[X64] = Vec::new()
  if used.contains(11) then out.push(X64::RBX) end
  if used.contains(12) then out.push(X64::R12) end
  if used.contains(13) then out.push(X64::R13) end
  if used.contains(14) then out.push(X64::R14) end
  if used.contains(19) then out.push(X64::R15) end
  out
end

# ———————————————————————————————————————————————————————————————
# Frame model (spill slot i at [rbp - 8 - 8*i] — the LIR uniform model)
# ———————————————————————————————————————————————————————————————
# frame_total = 16-aligned(8*alloc.slots + 8*scratch + 8*save_count)
# where scratch is the ONE emitter scratch slot at index alloc.slots
# ([rbp - 8 - 8*alloc.slots]: the parked 64-bit immediate / divisor / a
# switch operand) and save_count = x86_saved_regs(alloc).len(). Spill
# slot i sits at [rbp - 8 - 8*i]; the saves sit at the frame bottom:
# save k at [rbp - frame_total + 8*k]. The frame pointer is rbp and
# frame_total % 16 == 0 keeps rsp 16-byte aligned at every call site
# (into the function: rsp%16 == 8; push rbp: 0; sub frame_total: 0).

def x86_align16(n: Int) -> Int
  let rem = n % 16
  if rem != 0 then
    n + (16 - rem)
  else
    n
  end
end

def x86_scratch_slot(alloc: LirAlloc) -> Int
  alloc.slots
end

def x86_scratch_disp(alloc: LirAlloc) -> Int
  lir_slot_offset(alloc.slots)
end

def x86_save_disp(frame_total: Int, k: Int) -> Int
  -frame_total + 8 * k
end

def x86_frame_total(alloc: LirAlloc, save_count: Int) -> Int
  x86_align16(8 * alloc.slots + 8 + 8 * save_count)
end

# ———————————————————————————————————————————————————————————————
# The allocation entry
# ———————————————————————————————————————————————————————————————
# The uniform 8-byte slot model (cm_word_slots false), the caller-saved
# pool ids 9..14 mapped to r10/r11/rbx/r12/r13/r14, the callee-saved
# class [19] mapped to r15, no FP pool (stage 1 has no FP surface) and
# the pre-item-33 scan (cost_alloc false — the route keeps the
# byte-identical baseline allocation the emitter's assumptions were
# validated against).
def x86_alloc_registers(f: LirFunction) -> LirAlloc
  lir_alloc_registers_mode(f, x86_cc_ids(), false, true, x86_fp_pool_ids(), false)
end

# ———————————————————————————————————————————————————————————————
# Validation (fail-closed, mirroring backend_rv.tg's rv_validate_fn)
# ———————————————————————————————————————————————————————————————
# verify_lir's LirVerifyX86_64 route is the mandatory post-allocation
# gate; this validator runs BEFORE the allocation (and again inside
# x86_emit_fn) and names the rule for every construct the emitter cannot
# translate. Reaching an unimplemented arm of the emitter after this is
# a backend divergence, never silent emission.

# Does the fixed (precolored) id `id` lack a general register on this
# route? Fixed general ids 0..5 map to the SysV argument registers; ids
# 6..7 (arguments 7..8) are stack-passed. Fixed float ids 8..15 DO have
# registers (xmm0..7) but only in the float-move positions, so the
# general test still rejects them.
def x86_fixed_used_bad(id: Int) -> Bool
  id >= 6 && id < lir_first_alloc_vreg()
end

def x86_validate_vreg(fn_name: String, id: Int, where: String) -> Result[Unit, String]
  if x86_fixed_used_bad(id) then
    return Result::Err("x86_64: " + fn_name + ": " + where + " uses fixed LIR vreg " + id.to_string() + ", which has no x86-64 general register here (fixed 0..5 are rdi/rsi/rdx/rcx/r8/r9; fixed 6/7 are arguments 7/8 — SysV passes them on the stack, and the stack-argument stream is still fail-closed; the fixed float ids 8..15 appear only in LirFMove crossings) — fail-closed")
  end
  Result::Ok(())
end

# A float-position vreg: an ordinary vreg or a fixed float ABI id
# (8..15 = xmm0..7). Fixed GENERAL ids never appear in float positions.
def x86_validate_fp_vreg(fn_name: String, id: Int, where: String) -> Result[Unit, String]
  if id < lir_first_alloc_vreg() && !lir_is_fixed_fp_id(id) then
    return Result::Err("x86_64: " + fn_name + ": " + where + " names fixed general vreg " + id.to_string() + " in a float position (fixed general vregs appear only in entry binds and pre-call argument moves — fail-closed)")
  end
  Result::Ok(())
end

# The non-move statement/terminator payloads must be ORDINARY vregs: the
# fixed general ids 0..5 are ABI-defined at entry and are read/written
# only by the entry binds and the pre-call argument moves (the LIR rule
# the aarch64 rule 7 documents), so a fixed operand in an arithmetic,
# compare, cset, switch, return or call position is a lowering
# divergence — and on this route it would also collide with the shift
# count register (rcx = fixed vreg 3) and the division accumulator.
def x86_validate_ordinary(fn_name: String, id: Int, where: String) -> Result[Unit, String]
  if id < lir_first_alloc_vreg() then
    return Result::Err("x86_64: " + fn_name + ": " + where + " names precolored vreg " + id.to_string() + " — fixed general vregs appear only in entry binds and pre-call argument moves, never in arithmetic/compare/switch/return/call positions (fail-closed)")
  end
  Result::Ok(())
end

# The pointer/atomic marker surface: every payload is an ordinary
# general word; the storage widths and per-ordering form codes are the
# LIR marker's own closed vocabularies; and each atomic width is checked
# against THE ONE ATOMIC AUTHORITY (target_desc.atomic_support) over the
# x86_64 description — native widths 1/2/4/8, no emulated class, so an
# out-of-domain width fails closed here with the target reason (x86's
# lock-prefixed forms are single-address and MMIO-safe like the native
# set the desc advertises).
def x86_validate_ptr_stmt(fn_name: String, pop: LirPtrOp) -> Result[Unit, String]
  match pop
  when LirPtrOp::LirPtrLea(dst, _) then
    x86_validate_ordinary(fn_name, dst, "a frame-address (LirPtrLea) destination")
  when LirPtrOp::LirPtrAddr(dst, base, _) then
    match x86_validate_ordinary(fn_name, dst, "an address-arithmetic (LirPtrAddr) destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, base, "an address-arithmetic (LirPtrAddr) base")
  when LirPtrOp::LirPtrLoad(dst, base, _, w, _) then
    if w != 1 && w != 2 && w != 4 && w != 8 then
      return Result::Err("x86_64: " + fn_name + ": a pointer load names storage width " + w.to_string() + " (only 1/2/4/8 bytes exist — fail-closed)")
    end
    match x86_validate_ordinary(fn_name, dst, "a pointer-load destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, base, "a pointer-load base")
  when LirPtrOp::LirPtrStore(base, _, src, w) then
    if w != 1 && w != 2 && w != 4 && w != 8 then
      return Result::Err("x86_64: " + fn_name + ": a pointer store names storage width " + w.to_string() + " (only 1/2/4/8 bytes exist — fail-closed)")
    end
    match x86_validate_ordinary(fn_name, base, "a pointer-store base")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, src, "a pointer-store source")
  when LirPtrOp::LirAtomLoad(form, w, dst, addr) then
    match x86_validate_atomic_width(fn_name, w, "an atomic load") 
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if form != 0 && form != 1 then
      return Result::Err("x86_64: " + fn_name + ": an atomic load form is " + form.to_string() + " (the marker's forms are 0/1 — fail-closed)")
    end
    match x86_validate_ordinary(fn_name, dst, "an atomic-load destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, addr, "an atomic-load address")
  when LirPtrOp::LirAtomStore(form, w, addr, val) then
    match x86_validate_atomic_width(fn_name, w, "an atomic store")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if form != 0 && form != 1 then
      return Result::Err("x86_64: " + fn_name + ": an atomic store form is " + form.to_string() + " (the marker's forms are 0/1 — fail-closed)")
    end
    match x86_validate_ordinary(fn_name, addr, "an atomic-store address")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, val, "an atomic-store value")
  when LirPtrOp::LirAtomRmw(family, form, w, dst, addr, val) then
    if family < 0 || family > 4 then
      return Result::Err("x86_64: " + fn_name + ": an atomic RMW family code " + family.to_string() + " is outside the marker's 0..4 vocabulary — fail-closed")
    end
    if form < 0 || form > 3 then
      return Result::Err("x86_64: " + fn_name + ": an atomic RMW ordering form " + form.to_string() + " is outside the marker's 0..3 vocabulary — fail-closed")
    end
    match x86_validate_atomic_width(fn_name, w, "an atomic RMW")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "an atomic-RMW destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, addr, "an atomic-RMW address")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, val, "an atomic-RMW value")
  when LirPtrOp::LirAtomCas(form, w, dst, exp, des, addr) then
    if form < 0 || form > 3 then
      return Result::Err("x86_64: " + fn_name + ": an atomic CAS ordering form " + form.to_string() + " is outside the marker's 0..3 vocabulary — fail-closed")
    end
    match x86_validate_atomic_width(fn_name, w, "an atomic compare-exchange")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "an atomic-CAS destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, exp, "an atomic-CAS expected value")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, des, "an atomic-CAS desired value")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, addr, "an atomic-CAS address")
  when LirPtrOp::LirPtrFence(form) then
    if form != 0 && form != 1 then
      return Result::Err("x86_64: " + fn_name + ": a fence form is " + form.to_string() + " (the marker's forms are 0/1 — fail-closed)")
    end
    Result::Ok(())
  end
end

# One atomic width against THE ONE ATOMIC AUTHORITY over x86_64_desc:
# Native is served by the lock-prefixed forms; the emulated class is
# empty on x86; anything else fails closed with the target reason.
def x86_validate_atomic_width(fn_name: String, w: Int, what: String) -> Result[Unit, String]
  match atomic_support(x86_64_desc(), w, "rmw", "seq_cst")
  when AtomicSupport::Native then Result::Ok(())
  when AtomicSupport::Emulated then
    Result::Err("x86_64: " + fn_name + ": " + what + " needs the EMULATED atomic class at width " + w.to_string() + " — the x86_64 description advertises no emulated widths (native 1/2/4/8 only); fail-closed")
  when AtomicSupport::Unsupported then
    Result::Err("x86_64: " + fn_name + ": " + what + " at width " + w.to_string() + " is Unsupported by the x86_64 description (native atomic widths 1/2/4/8, no emulated class) — fail-closed")
  end
end

# The vector marker surface: v128 (SSE2) and v256 (the AVX/AVX2 arm —
# the emitter gates the desc's tokens) envelopes, with a well-formed
# intrinsic-family lane descriptor. The per-lane opcode legality (SSE2
# serves the 16-bit PMULLW and the 32-bit PMULUDQ sequence; the byte
# and qword packed multiplies have no x86 instruction through AVX2 and
# the SSE4.1-only PMULLD is token-gated), the SSSE3 pshufb shuffle rule
# and the v256 token gates are checked at emission with named errors.
def x86_validate_vec_stmt(fn_name: String, vop: LirVecOp) -> Result[Unit, String]
  match vop
  when LirVecOp::LirVecBinop(_, lane, dst, a, b) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector binop destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, a, "a vector binop left operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, b, "a vector binop right operand")
  when LirVecOp::LirVecLoad(lane, dst, ptr) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector load destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, ptr, "a vector load pointer")
  when LirVecOp::LirVecStore(lane, src, ptr) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, src, "a vector store source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, ptr, "a vector store pointer")
  when LirVecOp::LirVecMove(lane, dst, src) then
    # The whole-image slot copy (the whole-vector move/copy slice): a
    # pure byte-image move between two vector-class fixed-slot images,
    # so the width-only lane gate applies (like the ABI moves) and both
    # operands are ordinary (vector-class) vregs.
    match x86_validate_vec_lane_abi(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector move destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, src, "a vector move source")
  when LirVecOp::LirVecShuffle(lane, dst, a, mask) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector shuffle destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, a, "a vector shuffle source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, mask, "a vector shuffle mask")
  when LirVecOp::LirVecAbiBind(lane, dst, _) then
    # The vector parameter entry bind (audit item 34 stage 2): a v128 or
    # v256 image stored from the ABI vector register into the
    # parameter's fixed slot. The index bound is the verifier's rule.
    # The ABI moves are pure byte-image loads/stores, so an
    # unsigned-lane vector parameter (canonical class data with no
    # intrinsic spelling) is legal here — the width is the only gate.
    match x86_validate_vec_lane_abi(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, dst, "a vector ABI bind destination")
  when LirVecOp::LirVecAbiArg(lane, src, _) then
    # The call-argument ABI move: a v128 or v256 image loaded from the
    # source's fixed slot into the ABI vector register (width-only gate).
    match x86_validate_vec_lane_abi(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, src, "a vector ABI argument source")
  when LirVecOp::LirVecShiftImm(lane, form, dst, a, amount) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if !lir_vec_shift_form_ok(form) then
      return Result::Err("x86_64: " + fn_name + ": a vector shift form " + form.to_string() + " is outside the marker's 0=shl/1=lsr/2=asr vocabulary — fail-closed")
    end
    let eb = lir_vector_elem_bits(lane.elem_kind.clone())
    if amount < 0 || amount >= eb then
      return Result::Err("x86_64: " + fn_name + ": a vector shift immediate " + amount.to_string() + " is outside 0.." + (eb - 1).to_string() + " for the " + lir_vector_lane_name(lane) + " lane class — fail-closed")
    end
    match x86_validate_ordinary(fn_name, dst, "a vector shift destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, a, "a vector shift source")
  when LirVecOp::LirVecShiftVec(lane, form, dst, a, counts) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if !lir_vec_shift_form_ok(form) then
      return Result::Err("x86_64: " + fn_name + ": a vector shift form " + form.to_string() + " is outside the marker's 0=shl/1=lsr/2=asr vocabulary — fail-closed")
    end
    match x86_validate_ordinary(fn_name, dst, "a vector shift destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, a, "a vector shift source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, counts, "a vector shift counts operand")
  when LirVecOp::LirVecSplat(lane, dst, src) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector splat destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, src, "a vector splat source")
  when LirVecOp::LirVecExtract(lane, dst, src, index) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if index < 0 || index >= lane.lanes then
      return Result::Err("x86_64: " + fn_name + ": a vector extract lane index " + index.to_string() + " is outside 0.." + (lane.lanes - 1).to_string() + " for the " + lir_vector_lane_name(lane) + " lane class — fail-closed")
    end
    match x86_validate_ordinary(fn_name, dst, "a vector extract destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, src, "a vector extract source")
  when LirVecOp::LirVecInsert(lane, dst, src, elem, index) then
    match x86_validate_vec_lane(fn_name, lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if index < 0 || index >= lane.lanes then
      return Result::Err("x86_64: " + fn_name + ": a vector insert lane index " + index.to_string() + " is outside 0.." + (lane.lanes - 1).to_string() + " for the " + lir_vector_lane_name(lane) + " lane class — fail-closed")
    end
    match x86_validate_ordinary(fn_name, dst, "a vector insert destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, src, "a vector insert base vector")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, elem, "a vector insert element")
  when LirVecOp::LirVecPack(from_lane, to_lane, dst, a, b) then
    match x86_validate_vec_lane(fn_name, from_lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_vec_lane(fn_name, to_lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_vec_narrow_pair(fn_name, from_lane, to_lane, "pack")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, dst, "a vector pack destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_ordinary(fn_name, a, "a vector pack low operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, b, "a vector pack high operand")
  when LirVecOp::LirVecUnpack(from_lane, to_lane, hi, dst, a) then
    match x86_validate_vec_lane(fn_name, from_lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_vec_lane(fn_name, to_lane)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    match x86_validate_vec_widen_pair(fn_name, from_lane, to_lane, "unpack")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    if hi != 0 && hi != 1 then
      return Result::Err("x86_64: " + fn_name + ": an unpack half selector " + hi.to_string() + " is outside the marker's 0=low/1=high vocabulary — fail-closed")
    end
    match x86_validate_ordinary(fn_name, dst, "a vector unpack destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    x86_validate_ordinary(fn_name, a, "a vector unpack source")
  end
end

# The pack lane-pair rule: to_lane must be the half-width signed narrow
# target of from_lane (i32x4→i16x8 / i16x8→i8x16).
def x86_validate_vec_narrow_pair(fn_name: String, from_lane: LirVectorLane, to_lane: LirVectorLane, what: String) -> Result[Unit, String]
  match lir_vector_lane_narrow(from_lane)
  when Option::Some(want) then
    if want.elem_kind != to_lane.elem_kind || want.lanes != to_lane.lanes || want.bits != to_lane.bits then
      Result::Err("x86_64: " + fn_name + ": " + what + " target " + lir_vector_lane_name(to_lane) + " is not the half-width signed narrow target " + lir_vector_lane_name(want) + " of " + lir_vector_lane_name(from_lane) + " — fail-closed")
    else
      Result::Ok(())
    end
  when Option::None then
    Result::Err("x86_64: " + fn_name + ": " + what + " source " + lir_vector_lane_name(from_lane) + " has no half-width signed narrow target (the packed surface is i32x4→i16x8 / i16x8→i8x16) — fail-closed")
  end
end

# The unpack lane-pair rule: to_lane must be the double-width signed
# widen target of from_lane (i16x8→i32x4 / i8x16→i16x8).
def x86_validate_vec_widen_pair(fn_name: String, from_lane: LirVectorLane, to_lane: LirVectorLane, what: String) -> Result[Unit, String]
  match lir_vector_lane_widen(from_lane)
  when Option::Some(want) then
    if want.elem_kind != to_lane.elem_kind || want.lanes != to_lane.lanes || want.bits != to_lane.bits then
      Result::Err("x86_64: " + fn_name + ": " + what + " target " + lir_vector_lane_name(to_lane) + " is not the double-width signed widen target " + lir_vector_lane_name(want) + " of " + lir_vector_lane_name(from_lane) + " — fail-closed")
    else
      Result::Ok(())
    end
  when Option::None then
    Result::Err("x86_64: " + fn_name + ": " + what + " source " + lir_vector_lane_name(from_lane) + " has no double-width signed widen target (the widening surface is i16x8→i32x4 / i8x16→i16x8) — fail-closed")
  end
end

# The ABI-move width gate: 128/256 bits only, no intrinsic-family
# requirement (the bind/argument markers move whole byte images).
def x86_validate_vec_lane_abi(fn_name: String, lane: LirVectorLane) -> Result[Unit, String]
  if lane.bits != 128 && lane.bits != 256 then
    return Result::Err("x86_64: " + fn_name + ": a vector ABI crossing carries a " + lane.bits.to_string() + "-bit lane image (" + lir_vector_lane_name(lane) + "); the x86-64 vector arm crosses v128 (SSE2) and v256 (AVX/AVX2, gated on the desc's tokens) only — fail-closed")
  end
  Result::Ok(())
end

def x86_validate_vec_lane(fn_name: String, lane: LirVectorLane) -> Result[Unit, String]
  match x86_validate_vec_lane_abi(fn_name, lane)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  if lir_simd_lane_of_vector_lane(lane) == Option::None then
    return Result::Err("x86_64: " + fn_name + ": a vector statement carries the lane kind `" + lir_vector_lane_name(lane) + "`, which has no SIMD intrinsic-family encoding on this route — fail-closed")
  end
  Result::Ok(())
end

# The whole-function SysV capacity gate: the general-class parameter
# count (aggregate address words included) must fit rdi..r9 (six
# registers), a float parameter count must fit xmm0..7, and an sret
# function's hidden RDI pointer consumes one general register — so its
# real parameters fit only rsi..r9 (five). The stack-argument stream
# stays fail-closed (LirLoadFrame / LirPushArg rejections below).
def x86_validate_signature(f: LirFunction) -> Result[Unit, String]
  let fn_name = f.name.clone()
  var gp = 0
  var fp = 0
  var stack_float = false
  var pi = 0
  while pi < f.params.len() do
    # The SIMD&FP file is shared by scalar floats and SIMD vectors: both
    # consume a file position (the vector class is identified by the
    # vector class table, the float class by fp_widths — the lowering's
    # class authorities).  A vector beyond xmm0..7 crosses through the
    # vector byte-image stack slots (the vector stack stream); a scalar
    # float beyond the file keeps the fail-closed scalar stack stream.
    if f.vector_widths.contains_key(&f.params[pi]) then
      fp = fp + 1
    elsif f.fp_widths.contains_key(&f.params[pi]) then
      fp = fp + 1
      if fp > 8 then
        stack_float = true
      end
    else
      gp = gp + 1
    end
    pi = pi + 1
  end
  if f.sret_words > 0 then
    if gp > 5 then
      return Result::Err("x86_64: " + fn_name + ": an sret-returning function has " + gp.to_string() + " general-class parameters — the SysV hidden return pointer consumes rdi, so only five general parameters fit rsi/rdx/rcx/r8/r9; the scalar/float stack-argument stream is fail-closed — fail-closed")
    end
  else
    if gp > 6 then
      return Result::Err("x86_64: " + fn_name + ": " + gp.to_string() + " general-class parameters — SysV passes only the first six in registers (rdi/rsi/rdx/rcx/r8/r9); the scalar/float stack stream is fail-closed")
    end
  end
  if stack_float then
    return Result::Err("x86_64: " + fn_name + ": a floating-point parameter beyond xmm0..xmm7 — SysV passes the first eight file positions in registers and the scalar float stack stream is fail-closed (only vector byte images stack)")
  end
  Result::Ok(())
end

def x86_validate_fn(f: LirFunction) -> Result[Unit, String]
  let fn_name = f.name.clone()
  match x86_validate_signature(f)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  var bi = 0
  while bi < f.blocks.len() do
    let block = f.blocks[bi]
    var si = 0
    while si < block.stmts.len() do
      let stmt = block.stmts[si]
      match stmt.ptr
      when Option::Some(pop) then
        match x86_validate_ptr_stmt(fn_name, pop)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when Option::None then ()
      end
      match stmt.bm
      when Option::Some(_) then
        # The register-class bit moves are emitted with the movq/movd
        # crossings; the carrier must be the arity-exact LirUnop shape.
        match stmt.kind
        when LirStmtKind::LirUnop(_, dst, src) then
          if dst < lir_first_alloc_vreg() then
            return Result::Err("x86_64: " + fn_name + ": a bit move defines fixed vreg " + dst.to_string() + " (fail-closed)")
          end
          if src < lir_first_alloc_vreg() then
            return Result::Err("x86_64: " + fn_name + ": a bit move reads fixed vreg " + src.to_string() + " (fail-closed)")
          end
        when _ then
          return Result::Err("x86_64: " + fn_name + ": a bit-move marker rides a non-LirUnop carrier (the marker rides the arity-exact LirUnop shape — fail-closed)")
        end
      when Option::None then ()
      end
      match stmt.vec
      when Option::Some(vop) then
        match x86_validate_vec_stmt(fn_name, vop)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when Option::None then ()
      end
      match stmt.kind
      when LirStmtKind::LirMove(dst, val) then
        if lir_is_fixed_fp_id(dst) then
          return Result::Err("x86_64: " + fn_name + ": a general move into the fixed float ABI vreg " + dst.to_string() + " (float crossings use LirFMove — fail-closed)")
        end
        match x86_validate_vreg(fn_name, dst, "a move destination") 
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match val
        when LirValue::LirReg(src) then
          if lir_is_fixed_fp_id(src) then
            return Result::Err("x86_64: " + fn_name + ": a general move from the fixed float ABI vreg " + src.to_string() + " (float crossings use LirFMove — fail-closed)")
          end
          match x86_validate_vreg(fn_name, src, "a move source")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
        when LirValue::LirImm(_) then ()
        end
      when LirStmtKind::LirBinop(op, dst, left, right) then
        match x86_validate_ordinary(fn_name, dst, "a binop destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match left
        when LirValue::LirReg(lv) then
          match x86_validate_ordinary(fn_name, lv, "a binop left operand")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
        when LirValue::LirImm(_) then
          return Result::Err("x86_64: " + fn_name + ": binop left operand is an immediate — lowering never produces this (fail-closed)")
        end
        match right
        when LirValue::LirReg(rv) then
          match x86_validate_ordinary(fn_name, rv, "a binop right operand")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
        when LirValue::LirImm(_) then ()
        end
      when LirStmtKind::LirUnop(_, dst, src) then
        match x86_validate_ordinary(fn_name, dst, "a unop destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_ordinary(fn_name, src, "a unop source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirCmp(left, right) then
        match left
        when LirValue::LirReg(lv) then
          match x86_validate_ordinary(fn_name, lv, "a compare left operand")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
        when LirValue::LirImm(_) then
          return Result::Err("x86_64: " + fn_name + ": compare left operand is an immediate — lowering never produces this (fail-closed)")
        end
        match right
        when LirValue::LirReg(rv) then
          match x86_validate_ordinary(fn_name, rv, "a compare right operand")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(_) then ()
          end
        when LirValue::LirImm(_) then ()
        end
      when LirStmtKind::LirCset(_, dst) then
        match x86_validate_ordinary(fn_name, dst, "a cset destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirLoadFrame(dst, off) then
        # A vector stack-parameter bind (the stacked-vector slice) is
        # the one served LirLoadFrame: the image crosses BY VALUE at the
        # 16-byte caller-slot geometry; every scalar/float stack bind
        # keeps the named SysV-stream refusal.
        if f.vector_widths.contains_key(&dst) then
          if off < 16 || (off - 16) % 16 != 0 then
            return Result::Err("x86_64: " + fn_name + ": a vector stack-parameter bind at [rbp+" + off.to_string() + "] — the SysV vector caller slots sit at 16 + 16*k (16-byte aligned) — fail-closed")
          end
        else
          return Result::Err("x86_64: " + fn_name + ": scalar/float stack-parameter loads (LirLoadFrame at [rbp+" + off.to_string() + "]) do not lower — the SysV scalar/float stack-argument stream is fail-closed (only vector byte images stack)")
        end
      when LirStmtKind::LirStaticLoad(dst, _) then
        if lir_is_fixed_fp_id(dst) then
          return Result::Err("x86_64: " + fn_name + ": a static load into fixed float vreg " + dst.to_string() + " (fail-closed)")
        end
        match x86_validate_ordinary(fn_name, dst, "a static-load destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirPushArg(vreg) then
        # A stacked vector byte image is served (movdqu/vmovdqu push);
        # every scalar/float/general push keeps the SysV-stream refusal.
        if !f.vector_widths.contains_key(&vreg) then
          return Result::Err("x86_64: " + fn_name + ": caller stack-argument pushes (LirPushArg) do not lower for scalar/float/general values — the SysV stream is fail-closed (only vector byte images stack)")
        end
      when LirStmtKind::LirFMove(dst, src) then
        match x86_validate_fp_vreg(fn_name, dst, "a float move destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, src, "a float move source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFBinop(_, _, dst, left, right) then
        match x86_validate_fp_vreg(fn_name, dst, "a float binop destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, left, "a float binop left operand")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, right, "a float binop right operand")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFNeg(_, dst, src) then
        match x86_validate_fp_vreg(fn_name, dst, "a float negate destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, src, "a float negate source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFCmp(_, left, right) then
        match x86_validate_fp_vreg(fn_name, left, "a float compare left operand")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, right, "a float compare right operand")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFConst(_, dst, _) then
        match x86_validate_fp_vreg(fn_name, dst, "a float constant destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirIntToFloat(_, dst, src, _) then
        match x86_validate_fp_vreg(fn_name, dst, "an int-to-float destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_ordinary(fn_name, src, "an int-to-float source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFloatToInt(_, dst, src) then
        match x86_validate_ordinary(fn_name, dst, "a float-to-int destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, src, "a float-to-int source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when LirStmtKind::LirFcvt(_, dst, src) then
        match x86_validate_fp_vreg(fn_name, dst, "a float-width cast destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        match x86_validate_fp_vreg(fn_name, src, "a float-width cast source")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
      si = si + 1
    end
    match block.term.kind
    when LirTermKind::LirSwitch(vreg, _, _) then
      match x86_validate_ordinary(fn_name, vreg, "a switch operand")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    when LirTermKind::LirRet(opt_v) then
      match opt_v
      when Option::Some(v) then
        match x86_validate_ordinary(fn_name, v, "a return value")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when Option::None then ()
      end
    when LirTermKind::LirCall(target, args, stack_args, dest, _) then
      if stack_args != 0 then
        # Only the vector byte-image stack slots are served: every push
        # in the block must be a vector-class vreg (the emitter restores
        # exactly 16*stack_args bytes).
        var nonvector_push = false
        var pvi = 0
        while pvi < block.stmts.len() do
          match block.stmts[pvi].kind
          when LirStmtKind::LirPushArg(pv) then
            if !f.vector_widths.contains_key(&pv) then nonvector_push = true end
          when _ then ()
          end
          pvi = pvi + 1
        end
        if nonvector_push then
          return Result::Err("x86_64: " + fn_name + ": call to `" + target + "` carries scalar/float/general caller stack slots — only vector byte images stack on this route (the SysV scalar/float stack stream is fail-closed)")
        end
      end
      var ai = 0
      while ai < args.len() do
        match x86_validate_ordinary(fn_name, args[ai], "a call argument")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
        ai = ai + 1
      end
      match dest
      when Option::Some(dv) then
        match x86_validate_ordinary(fn_name, dv, "a call destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      when Option::None then ()
      end
    when LirTermKind::LirJump(_) then ()
    when LirTermKind::LirTrap then ()
    end
    bi = bi + 1
  end
  # The aggregate entry binds must land inside the register file (the
  # prologue reads fixed_phys(slot) / fixed_phys(slot+1) under sret).
  var ap = 0
  while ap < f.agg_params.len() do
    let bind = f.agg_params[ap]
    let want = if f.sret_words > 0 then bind.slot + 1 else bind.slot end
    if want >= 6 then
      return Result::Err("x86_64: " + fn_name + ": an aggregate parameter's image address would arrive in general slot " + want.to_string() + " (only 0..5 are SysV registers; the stack-argument stream is fail-closed)")
    end
    ap = ap + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Value resolution (mirroring backend_rv.tg's rv_def_target/rv_emit_use)
# ———————————————————————————————————————————————————————————————

# The destination of a def at position `pos`: the segment's register
# (through the pool map) or the RAX temp with a pending spill-slot store.
struct X86DefTarget
  reg: X64
  store_slot: Int
end

def x86_def_target(alloc: LirAlloc, vreg: Int, pos: Int) -> X86DefTarget
  if vreg < lir_first_alloc_vreg() then
    return X86DefTarget { reg: x86_fixed_phys(vreg), store_slot: -1 }
  end
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.phys >= 0 then
        X86DefTarget { reg: x86_phys_of(s.phys), store_slot: -1 }
      else
        if s.slot < 0 then
          panic("x86_64: memory-resident def of vreg " + vreg.to_string() + " has no slot (a rematerialized/aggregate home this route does not allocate — x86_alloc_registers passes cost_alloc false) — fail-closed")
        end
        X86DefTarget { reg: X64::RAX, store_slot: s.slot }
      end
    when Option::None then
      panic("x86_64: def outside any interval for vreg " + vreg.to_string())
    end
  when Option::None then
    # Never-occurring vreg (an unused parameter bind still emits).
    X86DefTarget { reg: X64::RAX, store_slot: -1 }
  end
end

# Materialize the value of `val` at position `pos` into a register:
#   - LirImm: x86_mov_ri64 into `pref` (always the full 64-bit movabs —
#     exact for every Int payload, never a truncated sign-extended form);
#   - a fixed vreg: its ABI register directly;
#   - an ordinary vreg: its segment register (reloading the slot first
#     when a reload record exists at (pos, vreg) — invariant I2) or
#     `pref` for a memory-resident segment.
# Internal invariant breaks (a def outside its hull) panic, exactly like
# backend_rv.tg's rv_emit_use; every construct-level rejection happens in
# x86_validate_fn / the statement arms.
def x86_emit_use(inout xe: X86Emit, alloc: LirAlloc, val: LirValue, pos: Int, pref: X64) -> X64
  match val
  when LirValue::LirImm(imm) then
    x86_emit(&mut xe.buf, x86_mov_ri64(pref, imm))
    pref
  when LirValue::LirReg(vreg) then
    if vreg < lir_first_alloc_vreg() then
      return x86_fixed_phys(vreg)
    end
    match alloc.segs_of.get(vreg)
    when Option::Some(segs) then
      match lir_seg_at(segs, pos)
      when Option::Some(s) then
        if s.phys >= 0 then
          let pr = x86_phys_of(s.phys)
          if lir_reload_at(alloc.reloads, pos, vreg) then
            x86_emit(&mut xe.buf, x86_mov_rm(pr, X64::RBP, lir_slot_offset(s.slot)))
          end
          pr
        else
          if s.slot < 0 then
            panic("x86_64: memory-resident use of vreg " + vreg.to_string() + " has no slot (a rematerialized/aggregate home this route does not allocate) — fail-closed")
          end
          x86_emit(&mut xe.buf, x86_mov_rm(pref, X64::RBP, lir_slot_offset(s.slot)))
          pref
        end
      when Option::None then
        panic("x86_64: use outside any interval for vreg " + vreg.to_string())
      end
    when Option::None then
      panic("x86_64: use of vreg with no intervals: " + vreg.to_string())
    end
  end
end

# The spill-slot displacement of a MEMORY-RESIDENT ordinary vreg at
# `pos` (the memory-operand shortcut: x86 ALU/idiv/imul forms read
# [rbp + disp] directly, so the emitter never needs a second temp for a
# spilled right operand). Option::None for fixed/register-resident
# values and immediates.
def x86_mem_disp_of(alloc: LirAlloc, val: LirValue, pos: Int) -> Option[Int]
  match val
  when LirValue::LirReg(vreg) then
    if vreg < lir_first_alloc_vreg() then
      return Option::None
    end
    match alloc.segs_of.get(vreg)
    when Option::Some(segs) then
      match lir_seg_at(segs, pos)
      when Option::Some(s) then
        if s.phys < 0 then
          if s.slot < 0 then
            panic("x86_64: memory-resident operand " + vreg.to_string() + " has no slot (a rematerialized/aggregate home this route does not allocate) — fail-closed")
          end
          Option::Some(lir_slot_offset(s.slot))
        else
          Option::None
        end
      when Option::None then
        panic("x86_64: operand use outside any interval for vreg " + vreg.to_string())
      end
    when Option::None then
      panic("x86_64: operand use of vreg with no intervals: " + vreg.to_string())
    end
  when LirValue::LirImm(_) then
    Option::None
  end
end

# Park `imm` in the emitter scratch slot so a memory operand can read it
# later ([rbp - 8 - 8*alloc.slots]). This CLOBBERS RAX: callers invoke it
# before resolving any left/dividend operand into RAX.
def x86_emit_imm_to_scratch(inout xe: X86Emit, alloc: LirAlloc, imm: Int) -> Unit
  x86_emit(&mut xe.buf, x86_mov_ri64(X64::RAX, imm))
  x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, x86_scratch_disp(alloc), X64::RAX))
end

# Store a register-resident def back to its spill slot.
def x86_store_def(inout xe: X86Emit, dt: X86DefTarget) -> Unit
  if dt.store_slot >= 0 then
    x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, lir_slot_offset(dt.store_slot), dt.reg))
  end
end

# ———————————————————————————————————————————————————————————————
# The statement emitter
# ———————————————————————————————————————————————————————————————
# Every arm mirrors the aarch64 emitter's semantics over the SysV
# register model. The x86 flags carry LirCmp (like the aarch64 NZCV), so
# the Cmp/Cset pair emits cmp at the Cmp position and setcc+movzx at the
# adjacent Cset — the pair is adjacent by invariant I1 and the emitter
# panics if any other statement or terminator interleaves.

def x86_alu_op_rr(op: LirBinOp) -> Int
  match op
  when LirBinOp::LirAdd then 0x01
  when LirBinOp::LirOr then 0x09
  when LirBinOp::LirAnd then 0x21
  when LirBinOp::LirSub then 0x29
  when LirBinOp::LirXor then 0x31
  when _ then panic("x86_64: no two-operand ALU opcode for this binop")
  end
end

def x86_alu_op_rm(op: LirBinOp) -> Int
  match op
  when LirBinOp::LirAdd then 0x03
  when LirBinOp::LirOr then 0x0B
  when LirBinOp::LirAnd then 0x23
  when LirBinOp::LirSub then 0x2B
  when LirBinOp::LirXor then 0x33
  when _ then panic("x86_64: no register-memory ALU opcode for this binop")
  end
end

def x86_alu_ext(op: LirBinOp) -> Int
  match op
  when LirBinOp::LirAdd then 0
  when LirBinOp::LirOr then 1
  when LirBinOp::LirAnd then 4
  when LirBinOp::LirSub then 5
  when LirBinOp::LirXor then 6
  when _ then panic("x86_64: no immediate ALU extension for this binop")
  end
end

def x86_shift_ext(op: LirBinOp) -> Int
  match op
  when LirBinOp::LirShl then 4
  when LirBinOp::LirLsr then 5
  when LirBinOp::LirAsr then 7
  when _ then panic("x86_64: not a shift op")
  end
end

# LirMove: dst <- imm (movabs) / dst <- register.
def x86_emit_move(inout xe: X86Emit, alloc: LirAlloc, dst: Int, val: LirValue, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  match val
  when LirValue::LirImm(imm) then
    x86_emit(&mut xe.buf, x86_mov_ri64(dt.reg, imm))
  when LirValue::LirReg(_) then
    let sr = x86_emit_use(xe, alloc, val, pos, X64::RAX)
    if sr != dt.reg then
      x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, sr))
    end
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# LirBinop: dst = left op right. The left operand resolves into a
# register (`lr`); the destination then receives left (unless it already
# is the resolved register) and the operation runs register-register,
# register-immediate (the sign-extended imm32 forms), or — for a
# 64-bit immediate that does not fit imm32 and for a memory-resident
# right operand — through the parked scratch slot or the [rbp+disp]
# memory-operand forms. RAX is the only statement temp; the scratch
# parking happens BEFORE the left operand is resolved so RAX is free.
def x86_emit_binop(inout xe: X86Emit, alloc: LirAlloc, op: LirBinOp, dst: Int, left: LirValue, right: LirValue, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  var right_parked = false
  match right
  when LirValue::LirImm(imm) then
    if !x86_imm32_ok(imm) then
      x86_emit_imm_to_scratch(xe, alloc, imm)
      right_parked = true
    end
  when _ then ()
  end
  var lr = X64::RAX
  match left
  when LirValue::LirImm(_) then
    return Result::Err("x86_64: binop left operand is an immediate — lowering never produces this (fail-closed)")
  when LirValue::LirReg(lv) then
    match x86_mem_disp_of(alloc, left, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, d))
      lr = X64::RAX
    when Option::None then
      lr = x86_emit_use(xe, alloc, left, pos, X64::RAX)
    end
  end
  if dt.reg != lr then
    x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, lr))
  end
  let dest = dt.reg
  match right
  when LirValue::LirImm(imm) then
    if right_parked then
      if op == LirBinOp::LirMul then
        x86_emit(&mut xe.buf, x86_imul_rm(dest, X64::RBP, x86_scratch_disp(alloc)))
      else
        x86_emit(&mut xe.buf, x86_alu_rm(x86_alu_op_rm(op), dest, X64::RBP, x86_scratch_disp(alloc)))
      end
    else
      if op == LirBinOp::LirMul then
        x86_emit(&mut xe.buf, x86_imul_rri(dest, dest, imm))
      else
        x86_emit(&mut xe.buf, x86_alu_ri(x86_alu_ext(op), dest, imm))
      end
    end
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, right, pos)
    when Option::Some(d) then
      if op == LirBinOp::LirMul then
        x86_emit(&mut xe.buf, x86_imul_rm(dest, X64::RBP, d))
      else
        x86_emit(&mut xe.buf, x86_alu_rm(x86_alu_op_rm(op), dest, X64::RBP, d))
      end
    when Option::None then
      let rr = x86_emit_use(xe, alloc, right, pos, X64::RAX)
      if rr == dest then
        panic("x86_64: allocator divergence: a binop destination and its right operand share one physical register (overlapping segments in one pool)")
      end
      if op == LirBinOp::LirMul then
        x86_emit(&mut xe.buf, x86_imul_rr(dest, rr))
      else
        x86_emit(&mut xe.buf, x86_alu_rr(x86_alu_op_rr(op), dest, rr))
      end
    end
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# LirBinop shifts: the count crosses in the architectural CL register.
# RCX is fixed LIR vreg 3 (the fourth argument register): its only LIR
# live ranges are the entry binds and the pre-call argument moves, and
# neither sequence contains a shift statement, so moving the count into
# rcx at a shift position never destroys a live value.
def x86_emit_shift(inout xe: X86Emit, alloc: LirAlloc, op: LirBinOp, dst: Int, left: LirValue, right: LirValue, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  # Count first (it uses only rcx / its own register).
  match right
  when LirValue::LirImm(_) then ()
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, right, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RCX, X64::RBP, d))
    when Option::None then
      let rr = x86_emit_use(xe, alloc, right, pos, X64::RAX)
      if rr != X64::RCX then
        x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, rr))
      end
    end
  end
  var lr = X64::RAX
  match left
  when LirValue::LirImm(_) then
    return Result::Err("x86_64: shift left operand is an immediate — lowering never produces this (fail-closed)")
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, left, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, d))
      lr = X64::RAX
    when Option::None then
      lr = x86_emit_use(xe, alloc, left, pos, X64::RAX)
    end
  end
  if dt.reg != lr then
    x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, lr))
  end
  match right
  when LirValue::LirImm(imm) then
    x86_emit(&mut xe.buf, x86_shift_imm(x86_shift_ext(op), dt.reg, imm))
  when LirValue::LirReg(_) then
    x86_emit(&mut xe.buf, x86_shift_cl(x86_shift_ext(op), dt.reg))
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# LirUnop: neg / bit-not.
def x86_emit_unop(inout xe: X86Emit, alloc: LirAlloc, op: LirUnOp, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  var sr = X64::RAX
  match x86_mem_disp_of(alloc, LirValue::LirReg(src), pos)
  when Option::Some(d) then
    x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, d))
    sr = X64::RAX
  when Option::None then
    sr = x86_emit_use(xe, alloc, LirValue::LirReg(src), pos, X64::RAX)
  end
  if dt.reg != sr then
    x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, sr))
  end
  match op
  when LirUnOp::LirNeg then
    x86_emit(&mut xe.buf, x86_neg_r(dt.reg))
  when LirUnOp::LirBitNot then
    x86_emit(&mut xe.buf, x86_not_r(dt.reg))
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# LirCmp: emit `cmp left, right`. The flags stay live until the adjacent
# LirCset (invariant I1). A 64-bit immediate that does not fit imm32
# parks in the scratch slot first.
def x86_emit_cmp(inout xe: X86Emit, alloc: LirAlloc, left: LirValue, right: LirValue, pos: Int) -> Result[Unit, String]
  var right_parked = false
  match right
  when LirValue::LirImm(imm) then
    if !x86_imm32_ok(imm) then
      x86_emit_imm_to_scratch(xe, alloc, imm)
      right_parked = true
    end
  when _ then ()
  end
  var lr = X64::RAX
  match left
  when LirValue::LirImm(_) then
    return Result::Err("x86_64: compare left operand is an immediate — lowering never produces this (fail-closed)")
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, left, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, d))
      lr = X64::RAX
    when Option::None then
      lr = x86_emit_use(xe, alloc, left, pos, X64::RAX)
    end
  end
  match right
  when LirValue::LirImm(imm) then
    if right_parked then
      x86_emit(&mut xe.buf, x86_alu_rm(0x3B, lr, X64::RBP, x86_scratch_disp(alloc)))
    else
      x86_emit(&mut xe.buf, x86_alu_ri(7, lr, imm))
    end
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, right, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_alu_rm(0x3B, lr, X64::RBP, d))
    when Option::None then
      let rr = x86_emit_use(xe, alloc, right, pos, X64::RAX)
      x86_emit(&mut xe.buf, x86_alu_rr(0x39, lr, rr))
    end
  end
  if xe.pending_cmp then
    panic("x86_64: nested LirCmp (invariant I1: each LirCmp is consumed by the adjacent LirCset)")
  end
  xe.pending_cmp = true
  xe.pending_fcmp = false
  Result::Ok(())
end

# LirCset: materialize the 0/1 comparison result. An integer LirCmp left
# the x86 FLAGS live (SETcc + MOVZX); an LirFCmp left the three-bit
# ordered-compare code in RDX (see x86_emit_fp_cmp), which the per-
# condition decoder consumes.
def x86_emit_cset(inout xe: X86Emit, alloc: LirAlloc, cond: LirCond, dst: Int, pos: Int) -> Result[Unit, String]
  if !xe.pending_cmp then
    panic("x86_64: LirCset with no preceding LirCmp/LirFCmp in program order (invariant I1)")
  end
  let dt = x86_def_target(alloc, dst, pos)
  if xe.pending_fcmp then
    match x86_emit_fcmp_cset(xe, cond, dt.reg)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
  else
    x86_emit(&mut xe.buf, x86_setcc(x86_cc_of(cond), dt.reg))
  end
  x86_emit(&mut xe.buf, x86_movzx_r64_r8(dt.reg, dt.reg))
  x86_store_def(xe, dt)
  xe.pending_cmp = false
  xe.pending_fcmp = false
  Result::Ok(())
end

# The language division guard (audit item 30): the raw `/` and `%` edges
# TRAP deterministically — the divisor is compared against zero (both
# the signed and unsigned kinds) and, for the SIGNED kind, the
# INT64_MIN/-1 hardware edge is compared before the idiv. The x86
# idiv/div #DE would trap on both edges anyway, but the explicit guard
# routes to the SAME abort the aarch64 emitter's guard uses: a CALL to
# the runtime's whitelisted __intrinsic_abort symbol (the single abort
# funnel — no inline ud2 in a user function, so the trap instruction is
# attributed to the whitelisted abort symbol by the trap-stub gate).
# The remainder's shared quotient edge is covered by the same guard,
# independent of the host's #DE signal mapping. RAX holds the dividend
# when this runs and RDX is free (an RDX-resident divisor was parked in
# the scratch slot by x86_emit_div), so the guard clobbers neither. R11
# is NOT used: the INT64_MIN compare materializes into RDX (the scratch
# slot may already hold the parked divisor).
def x86_emit_div_guard(inout xe: X86Emit, op: LirDivOp, den_is_mem: Bool, den_disp: Int, den_reg: X64) -> Unit
  let lbl_nz = x86_fresh_label(xe, "div_nz")
  if den_is_mem then
    x86_emit(&mut xe.buf, x86_alu_rmi8(7, X64::RBP, den_disp, 0))
  else
    x86_emit(&mut xe.buf, x86_alu_rr(0x85, den_reg, den_reg))
  end
  x86_emit_jcc_label(xe, LirCond::LirNe, lbl_nz)
  x86_emit_abort_call(xe)
  def_label(&mut xe.buf, lbl_nz)
  match op
  when LirDivOp::LirSdiv then
    let lbl_edge = x86_fresh_label(xe, "div_edge")
    if den_is_mem then
      x86_emit(&mut xe.buf, x86_alu_rmi8(7, X64::RBP, den_disp, -1))
    else
      x86_emit(&mut xe.buf, x86_alu_ri(7, den_reg, -1))
    end
    x86_emit_jcc_label(xe, LirCond::LirNe, lbl_edge)
    x86_emit(&mut xe.buf, x86_mov_ri64(X64::RDX, -9223372036854775808 as i64))
    x86_emit(&mut xe.buf, x86_alu_rr(0x39, X64::RAX, X64::RDX))
    x86_emit_jcc_label(xe, LirCond::LirNe, lbl_edge)
    x86_emit_abort_call(xe)
    def_label(&mut xe.buf, lbl_edge)
  when LirDivOp::LirUdiv then ()
  end
end

# LirBinop with the division marker: dst = num / den with the quotient
# in RAX. Signed: cqo + idiv; unsigned: zero RDX + div. The divisor may
# be a register, a memory-resident vreg ([rbp+disp]) or — when it sits
# in RDX, which cqo / the RDX zeroing would destroy — the parked scratch
# slot. The dividend is copied to RAX first, so a dividend in RDX also
# survives the setup. x86_emit_div_guard runs once both operands are
# resolved (see its note).
def x86_emit_div(inout xe: X86Emit, alloc: LirAlloc, dop: LirDivOp, dst: Int, left: LirValue, right: LirValue, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  # Park an immediate divisor (lowering materializes constants — this is
  # the defensive arm) before RAX is used.
  var den_is_mem = false
  var den_disp = 0
  match right
  when LirValue::LirImm(imm) then
    x86_emit_imm_to_scratch(xe, alloc, imm)
    den_is_mem = true
    den_disp = x86_scratch_disp(alloc)
  when LirValue::LirReg(_) then ()
  end
  # Dividend -> RAX (never RAX already: RAX is not an allocatable id).
  match left
  when LirValue::LirImm(_) then
    return Result::Err("x86_64: division dividend is an immediate — lowering never produces this (fail-closed)")
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, left, pos)
    when Option::Some(d) then
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, d))
    when Option::None then
      let nr = x86_emit_use(xe, alloc, left, pos, X64::RAX)
      if nr != X64::RAX then
        x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, nr))
      end
    end
  end
  var den_reg = X64::RAX
  match right
  when LirValue::LirImm(_) then ()
  when LirValue::LirReg(_) then
    match x86_mem_disp_of(alloc, right, pos)
    when Option::Some(d) then
      den_is_mem = true
      den_disp = d
    when Option::None then
      let dr = x86_emit_use(xe, alloc, right, pos, X64::RAX)
      if dr == X64::RDX then
        # cqo / the RDX zeroing would destroy an RDX divisor: park it.
        x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, x86_scratch_disp(alloc), X64::RDX))
        den_is_mem = true
        den_disp = x86_scratch_disp(alloc)
      else
        den_reg = dr
      end
    end
  end
  # The language division-edge guard (audit item 30) — runs with the
  # divisor fully resolved and RAX already holding the dividend.
  x86_emit_div_guard(xe, dop, den_is_mem, den_disp, den_reg)
  match dop
  when LirDivOp::LirUdiv then
    x86_emit(&mut xe.buf, x86_alu_rr(0x31, X64::RDX, X64::RDX))
  when LirDivOp::LirSdiv then
    x86_emit(&mut xe.buf, x86_cqo())
  end
  if den_is_mem then
    match dop
    when LirDivOp::LirUdiv then
      x86_emit(&mut xe.buf, x86_div_rm(X64::RBP, den_disp))
    when LirDivOp::LirSdiv then
      x86_emit(&mut xe.buf, x86_idiv_rm(X64::RBP, den_disp))
    end
  else
    match dop
    when LirDivOp::LirUdiv then
      x86_emit(&mut xe.buf, x86_div_r(den_reg))
    when LirDivOp::LirSdiv then
      x86_emit(&mut xe.buf, x86_idiv_r(den_reg))
    end
  end
  if dt.reg != X64::RAX then
    x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RAX))
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Float statement arms (the SSE2 slice)
# ———————————————————————————————————————————————————————————————
# The register discipline mirrors the aarch64 float emitter over the
# XMM file: fixed ABI ids 8..15 = xmm0..7, the allocatable pool
# xmm8..14 (phys 108..114), the statement scratch xmm15. A GP scratch
# (RAX, and RDX for the conversion fixups) is free at every float
# statement by the fixed-vreg usage invariant (fixed general vregs
# appear only in entry binds and pre-call argument moves, and neither
# sequence contains an FP statement).

def x86_emit_fp_move(inout xe: X86Emit, alloc: LirAlloc, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let w = match lir_alloc_fp_width_of(alloc, dst)
  when Option::Some(dw) then dw
  when Option::None then
    match lir_alloc_fp_width_of(alloc, src)
    when Option::Some(sw) then sw
    when Option::None then
      panic("x86_64: LirFMove between two fixed FP vregs (lowering invariant)")
    end
  end
  let dt = x86_fp_def_target(alloc, dst, pos)
  let pref = if dt.store_slot >= 0 then x86_fp_scratch() else dt.xmm end
  let sr = x86_fp_emit_use(xe, alloc, src, pos, w, pref)
  x86_fp_mov(xe, w, dt.xmm, sr)
  x86_fp_store_def(xe, dt, w)
  Result::Ok(())
end

def x86_emit_fp_binop(inout xe: X86Emit, alloc: LirAlloc, op: LirFpBinOp, w: LirFpWidth, dst: Int, left: Int, right: Int, pos: Int) -> Result[Unit, String]
  let dt = x86_fp_def_target(alloc, dst, pos)
  let lr = x86_fp_emit_use(xe, alloc, left, pos, w, x86_fp_scratch())
  if dt.xmm != lr then
    x86_fp_mov(xe, w, dt.xmm, lr)
  end
  match x86_fp_mem_disp_of(alloc, right, pos)
  when Option::Some(d) then
    match op
    when LirFpBinOp::LirFAdd then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_addss_rm(dt.xmm, X64::RBP, d))
      else
        x86_emit(&mut xe.buf, x86_addsd_rm(dt.xmm, X64::RBP, d))
      end
    when LirFpBinOp::LirFSub then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_subss_rm(dt.xmm, X64::RBP, d))
      else
        x86_emit(&mut xe.buf, x86_subsd_rm(dt.xmm, X64::RBP, d))
      end
    when LirFpBinOp::LirFMul then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_mulss_rm(dt.xmm, X64::RBP, d))
      else
        x86_emit(&mut xe.buf, x86_mulsd_rm(dt.xmm, X64::RBP, d))
      end
    when LirFpBinOp::LirFDiv then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_divss_rm(dt.xmm, X64::RBP, d))
      else
        x86_emit(&mut xe.buf, x86_divsd_rm(dt.xmm, X64::RBP, d))
      end
    end
  when Option::None then
    let rr = x86_fp_emit_use(xe, alloc, right, pos, w, x86_fp_scratch())
    match op
    when LirFpBinOp::LirFAdd then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_addss_rr(dt.xmm, rr))
      else
        x86_emit(&mut xe.buf, x86_addsd_rr(dt.xmm, rr))
      end
    when LirFpBinOp::LirFSub then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_subss_rr(dt.xmm, rr))
      else
        x86_emit(&mut xe.buf, x86_subsd_rr(dt.xmm, rr))
      end
    when LirFpBinOp::LirFMul then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_mulss_rr(dt.xmm, rr))
      else
        x86_emit(&mut xe.buf, x86_mulsd_rr(dt.xmm, rr))
      end
    when LirFpBinOp::LirFDiv then
      if w == LirFpWidth::LirF32 then
        x86_emit(&mut xe.buf, x86_divss_rr(dt.xmm, rr))
      else
        x86_emit(&mut xe.buf, x86_divsd_rr(dt.xmm, rr))
      end
    end
  end
  x86_fp_store_def(xe, dt, w)
  Result::Ok(())
end

# FNeg: flip the sign bit with XORPS/XORPD against a GP-materialized
# mask. The mask lands in a fixed XMM id (0..7) chosen distinct from the
# source when the source is itself fixed (the defensive case): pool
# codes are 8..15, so a fixed mask register can never alias an ordinary
# source, and fixed ABI ids are dead at every non-bind statement.
def x86_emit_fp_neg(inout xe: X86Emit, alloc: LirAlloc, w: LirFpWidth, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let dt = x86_fp_def_target(alloc, dst, pos)
  let sr = x86_fp_emit_use(xe, alloc, src, pos, w, x86_fp_scratch())
  if dt.xmm != sr then
    x86_fp_mov(xe, w, dt.xmm, sr)
  end
  let mask_code = if sr >= 0 && sr <= 7 then (if sr == 7 then 6 else 7 end) else 7 end
  let mask = if w == LirFpWidth::LirF32 then 2147483648 else (-9223372036854775807 - 1) end
  x86_emit(&mut xe.buf, x86_mov_ri64(X64::RDX, mask))
  x86_emit(&mut xe.buf, x86_movq_xmm_r64(mask_code, X64::RDX))
  if w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_xorps_rr(dt.xmm, mask_code))
  else
    x86_emit(&mut xe.buf, x86_xorpd_rr(dt.xmm, mask_code))
  end
  x86_fp_store_def(xe, dt, w)
  Result::Ok(())
end

# LirFCmp: materialize a compare code in RDX —
#   0 = unordered (NaN), 1 = ordered less, 2 = ordered equal,
#   5 = ordered greater (ordered + eq + 4*gt)
# — and let the adjacent LirCset decode it (the SSE flags cannot carry
# the four-way outcome through the integer cc table). The three flag
# reads happen before any flag-clobbering instruction (SETcc and MOVZX
# leave FLAGS alone; the folding arithmetic runs after all captures).
def x86_emit_fp_cmp(inout xe: X86Emit, alloc: LirAlloc, w: LirFpWidth, left: Int, right: Int, pos: Int) -> Result[Unit, String]
  let lr = x86_fp_emit_use(xe, alloc, left, pos, w, x86_fp_scratch())
  match x86_fp_mem_disp_of(alloc, right, pos)
  when Option::Some(d) then
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_ucomiss_rm(lr, X64::RBP, d))
    else
      x86_emit(&mut xe.buf, x86_ucomisd_rm(lr, X64::RBP, d))
    end
  when Option::None then
    let rr = x86_fp_emit_use(xe, alloc, right, pos, w, x86_fp_scratch())
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_ucomiss_rr(lr, rr))
    else
      x86_emit(&mut xe.buf, x86_ucomisd_rr(lr, rr))
    end
  end
  # al = ordered (PF=0); cl = equal; dl = ordered-greater (CF=0,ZF=0).
  x86_emit(&mut xe.buf, x86_setcc(0xA, X64::RAX))
  x86_emit(&mut xe.buf, x86_setcc(0x4, X64::RCX))
  x86_emit(&mut xe.buf, x86_setcc(0x7, X64::RDX))
  # rcx = eq & ordered; rdx = 4*gt + eq + ordered (lt=1, eq=2, gt=5).
  x86_emit(&mut xe.buf, x86_movzx_r64_r8(X64::RAX, X64::RAX))
  x86_emit(&mut xe.buf, x86_movzx_r64_r8(X64::RCX, X64::RCX))
  x86_emit(&mut xe.buf, x86_movzx_r64_r8(X64::RDX, X64::RDX))
  x86_emit(&mut xe.buf, x86_alu_rr(0x21, X64::RCX, X64::RAX))
  x86_emit(&mut xe.buf, x86_shift_imm(4, X64::RDX, 2))
  x86_emit(&mut xe.buf, x86_alu_rr(0x01, X64::RDX, X64::RCX))
  x86_emit(&mut xe.buf, x86_alu_rr(0x01, X64::RDX, X64::RAX))
  if xe.pending_cmp then
    panic("x86_64: nested LirCmp/LirFCmp (invariant I1)")
  end
  xe.pending_cmp = true
  xe.pending_fcmp = true
  Result::Ok(())
end

# The FCmp-code decode of one LIR condition (RDX holds the code; see
# x86_emit_fp_cmp's table). The unsigned LirCond forms never reach an
# FCmp lowering, so they fail closed with the named rule.
def x86_emit_fcmp_cset(inout xe: X86Emit, cond: LirCond, dst: Int) -> Result[Unit, String]
  match cond
  when LirCond::LirEq then
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 2))
    x86_emit(&mut xe.buf, x86_setcc(0x4, dst))
  when LirCond::LirNe then
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 2))
    x86_emit(&mut xe.buf, x86_setcc(0x5, dst))
  when LirCond::LirLt then
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 1))
    x86_emit(&mut xe.buf, x86_setcc(0x4, dst))
  when LirCond::LirLe then
    # less-or-equal: code-1 <= 1 -> the lt (1) and eq (2) codes.
    x86_emit(&mut xe.buf, x86_alu_ri(5, X64::RDX, 1))
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 1))
    x86_emit(&mut xe.buf, x86_setcc(0x6, dst))
  when LirCond::LirGt then
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 5))
    x86_emit(&mut xe.buf, x86_setcc(0x4, dst))
  when LirCond::LirGe then
    # greater-or-equal: the eq (2) and gt (5) codes are >= 2.
    x86_emit(&mut xe.buf, x86_alu_ri(7, X64::RDX, 2))
    x86_emit(&mut xe.buf, x86_setcc(0x3, dst))
  when _ then
    return Result::Err("x86_64: a float compare produced the unsigned condition " + x86_cond_name(cond) + " (the float slice lowers Eq/Ne/Lt/Le/Gt/Ge only — fail-closed)")
  end
  Result::Ok(())
end

# FConst: materialize the 64-bit pattern and move it into the XMM file.
# F32 bits are the HOST DOUBLE pattern of the literal, rounded once to
# the canonical single with CVTSD2SS (RNE — exactly the aarch64
# FCVT s,d emission).
def x86_emit_fp_const(inout xe: X86Emit, alloc: LirAlloc, w: LirFpWidth, dst: Int, bits: Int, pos: Int) -> Result[Unit, String]
  let dt = x86_fp_def_target(alloc, dst, pos)
  x86_emit(&mut xe.buf, x86_mov_ri64(X64::RDX, bits))
  if w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_movq_xmm_r64(x86_fp_scratch(), X64::RDX))
    x86_emit(&mut xe.buf, x86_cvtsd2ss_rr(dt.xmm, x86_fp_scratch()))
  else
    x86_emit(&mut xe.buf, x86_movq_xmm_r64(dt.xmm, X64::RDX))
  end
  x86_fp_store_def(xe, dt, w)
  Result::Ok(())
end

# IntToFloat. The signed form is CVTSI2SD/SS directly; the unsigned
# 64-bit form needs the classic fixup (x86 has no unsigned converter):
# for src >= 2^63 compute h = (src >> 1) | (src & 1), convert, then
# double. The fixup uses only RAX and the scratch slot.
def x86_emit_int_to_float(inout xe: X86Emit, alloc: LirAlloc, w: LirFpWidth, dst: Int, src: Int, unsigned: Bool, pos: Int) -> Result[Unit, String]
  let dt = x86_fp_def_target(alloc, dst, pos)
  let sr = x86_emit_use(xe, alloc, LirValue::LirReg(src), pos, X64::RAX)
  if !unsigned then
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_cvtsi2ss_rr(dt.xmm, sr))
    else
      x86_emit(&mut xe.buf, x86_cvtsi2sd_rr(dt.xmm, sr))
    end
  else
    if sr != X64::RAX then
      x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, sr))
    end
    let lbl_pos = x86_fresh_label(xe, "uitofp_pos")
    let lbl_done = x86_fresh_label(xe, "uitofp_done")
    x86_emit(&mut xe.buf, x86_alu_rr(0x85, X64::RAX, X64::RAX))
    x86_emit_jcc_label(xe, LirCond::LirGe, lbl_pos.clone())
    # src >= 2^63: h = (src >> 1) | (src & 1); float = (float)h * 2.
    x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, x86_scratch_disp(alloc), X64::RAX))
    x86_emit(&mut xe.buf, x86_shift_imm(5, X64::RAX, 1))
    x86_emit(&mut xe.buf, x86_alu_rmi8(4, X64::RBP, x86_scratch_disp(alloc), 1))
    x86_emit(&mut xe.buf, x86_alu_rm(0x0B, X64::RAX, X64::RBP, x86_scratch_disp(alloc)))
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_cvtsi2ss_rr(dt.xmm, X64::RAX))
      x86_emit(&mut xe.buf, x86_addss_rr(dt.xmm, dt.xmm))
    else
      x86_emit(&mut xe.buf, x86_cvtsi2sd_rr(dt.xmm, X64::RAX))
      x86_emit(&mut xe.buf, x86_addsd_rr(dt.xmm, dt.xmm))
    end
    x86_emit_jmp_label(xe, lbl_done.clone())
    def_label(&mut xe.buf, lbl_pos)
    if w == LirFpWidth::LirF32 then
      x86_emit(&mut xe.buf, x86_cvtsi2ss_rr(dt.xmm, X64::RAX))
    else
      x86_emit(&mut xe.buf, x86_cvtsi2sd_rr(dt.xmm, X64::RAX))
    end
    def_label(&mut xe.buf, lbl_done)
  end
  x86_fp_store_def(xe, dt, w)
  Result::Ok(())
end

# FloatToInt: CVTTSD2SI/SS then the §25 SATURATING fixup (types.tg's
# language rule: NaN -> 0, >= 2^63 -> INT64_MAX, < -2^63 -> INT64_MIN,
# else truncation toward zero) — the x86 twin of codegen.tg's
# emit_ftoi_saturate_x64, over the LIR route's own encoders. RDX is the
# fixup scratch (free at an FP statement by the fixed-vreg invariant).
def x86_emit_float_to_int(inout xe: X86Emit, alloc: LirAlloc, w: LirFpWidth, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let dt = x86_def_target(alloc, dst, pos)
  let sr = x86_fp_emit_use(xe, alloc, src, pos, w, x86_fp_scratch())
  if w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_cvttss2si_rr(dt.reg, sr))
  else
    x86_emit(&mut xe.buf, x86_cvttsd2si_rr(dt.reg, sr))
  end
  let lbl_nan = x86_fresh_label(xe, "ftoi_nan")
  let lbl_pos = x86_fresh_label(xe, "ftoi_pos")
  let lbl_done = x86_fresh_label(xe, "ftoi_done")
  x86_emit(&mut xe.buf, x86_mov_ri64(X64::RDX, -9223372036854775807 - 1))
  x86_emit(&mut xe.buf, x86_alu_rr(0x39, dt.reg, X64::RDX))
  x86_emit_jcc_label(xe, LirCond::LirNe, lbl_done.clone())
  # The result is integer-indefinite: NaN | >= 2^63 | < -2^63 | the
  # exact in-range -2^63 (whose indefinite result is its correct value).
  # The sign probe reads the value's own width: MOVD + a 32-bit TEST for
  # F32 (the sign bit is bit 31; MOVD zero-extends so the 64-bit TEST's
  # sign flag would always be clear), MOVQ + the 64-bit TEST for F64.
  if w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_ucomiss_rr(sr, sr))
  else
    x86_emit(&mut xe.buf, x86_ucomisd_rr(sr, sr))
  end
  x86_emit_jcc_label(xe, LirCond::LirUlt, lbl_nan.clone())
  if w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_movd_r32_xmm(X64::RDX, sr))
    x86_emit(&mut xe.buf, x86_alu_rr32(0x85, X64::RDX, X64::RDX))
  else
    x86_emit(&mut xe.buf, x86_movq_r64_xmm(X64::RDX, sr))
    x86_emit(&mut xe.buf, x86_alu_rr(0x85, X64::RDX, X64::RDX))
  end
  x86_emit_jcc_label(xe, LirCond::LirGe, lbl_pos.clone())
  x86_emit_jmp_label(xe, lbl_done.clone())
  def_label(&mut xe.buf, lbl_pos)
  x86_emit(&mut xe.buf, x86_mov_ri64(dt.reg, 9223372036854775807))
  x86_emit_jmp_label(xe, lbl_done.clone())
  def_label(&mut xe.buf, lbl_nan)
  x86_emit(&mut xe.buf, x86_alu_rr(0x31, dt.reg, dt.reg))
  def_label(&mut xe.buf, lbl_done)
  x86_store_def(xe, dt)
  Result::Ok(())
end

def x86_emit_fcvt(inout xe: X86Emit, alloc: LirAlloc, src_w: LirFpWidth, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let dw = match lir_alloc_fp_width_of(alloc, dst)
  when Option::Some(v) then v
  when Option::None then
    panic("x86_64: LirFcvt into a vreg with no FP class record (lowering invariant)")
  end
  let dt = x86_fp_def_target(alloc, dst, pos)
  let sr = x86_fp_emit_use(xe, alloc, src, pos, src_w, x86_fp_scratch())
  if dw == LirFpWidth::LirF32 && src_w == LirFpWidth::LirF64 then
    x86_emit(&mut xe.buf, x86_cvtsd2ss_rr(dt.xmm, sr))
  elsif dw == LirFpWidth::LirF64 && src_w == LirFpWidth::LirF32 then
    x86_emit(&mut xe.buf, x86_cvtss2sd_rr(dt.xmm, sr))
  else
    panic("x86_64: LirFcvt between identical widths (lowering invariant; same-width casts lower as moves)")
  end
  x86_fp_store_def(xe, dt, dw)
  Result::Ok(())
end

# The register-class bit move (LirStmt.bm): MOVD/MOVQ crossings between
# the general and XMM files — the exact-width bit image (F64 = the full
# 64-bit word; F32 = the low 32 bits, zero-extended on the way out).
def x86_emit_bitmove(inout xe: X86Emit, alloc: LirAlloc, stmt: LirStmt, pos: Int) -> Result[Unit, String]
  match stmt.bm
  when Option::Some(bm) then
    match stmt.kind
    when LirStmtKind::LirUnop(_, dst, src) then
      match bm
      when LirBitMoveOp::LirBitsGpToFp then
        let w = match lir_alloc_fp_width_of(alloc, dst)
        when Option::Some(v) then v
        when Option::None then
          panic("x86_64: GP->FP bit move into a vreg with no FP class record (lowering invariant)")
        end
        let sr = x86_emit_use(xe, alloc, LirValue::LirReg(src), pos, X64::RDX)
        let dt = x86_fp_def_target(alloc, dst, pos)
        if w == LirFpWidth::LirF32 then
          x86_emit(&mut xe.buf, x86_movd_xmm_r32(dt.xmm, sr))
        else
          x86_emit(&mut xe.buf, x86_movq_xmm_r64(dt.xmm, sr))
        end
        x86_fp_store_def(xe, dt, w)
      when LirBitMoveOp::LirBitsFpToGp then
        let w = match lir_alloc_fp_width_of(alloc, src)
        when Option::Some(v) then v
        when Option::None then
          panic("x86_64: FP->GP bit move from a vreg with no FP class record (lowering invariant)")
        end
        let sr = x86_fp_emit_use(xe, alloc, src, pos, w, x86_fp_scratch())
        let dt = x86_def_target(alloc, dst, pos)
        if w == LirFpWidth::LirF32 then
          x86_emit(&mut xe.buf, x86_movd_r32_xmm(dt.reg, sr))
        else
          x86_emit(&mut xe.buf, x86_movq_r64_xmm(dt.reg, sr))
        end
        x86_store_def(xe, dt)
      end
    when _ then
      Result::Err("x86_64: bit-move marker on a non-LirUnop carrier (lowering invariant)")
    end
  when Option::None then
    Result::Err("x86_64: bit-move emitter on an unmarked statement (internal error)")
  end
end

# ———————————————————————————————————————————————————————————————
# Static-data load arm (the statics slice)
# ———————————————————————————————————————————————————————————————
# The static's VALUE: one RIP-relative full-word load with an
# R_X86_64_PC32 relocation (addend -4) against the .data/.bss symbol —
# the linker completes S + A - P, exactly the canonical `mov rax,
# [rip+static]` form. F32/F64 statics stay outside the LIR static
# subset (the shared lir_static_scalar_ok gate), so the destination is
# always a general word vreg.
def x86_emit_static_load(inout xe: X86Emit, alloc: LirAlloc, dst: Int, sym: String, pos: Int) -> Result[Unit, String]
  if lir_is_fixed_fp_id(dst) then
    return Result::Err("x86_64: static load into fixed float ABI vreg " + dst.to_string() + " (the LIR static subset is general-word scalars — fail-closed)")
  end
  let dt = x86_def_target(alloc, dst, pos)
  let off = buf_pos(&xe.buf) + 3
  x86_emit(&mut xe.buf, x86_mov_rm_rip(dt.reg))
  xe.relocs.push(X86Reloc { offset: off, sym: sym, kind: x86_reloc_pc32() })
  x86_store_def(xe, dt)
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Pointer/atomic emission (the pointer/atomic slice)
# ———————————————————————————————————————————————————————————————
# The x86-TSO mapping (mirroring the direct emitter's x86 arms):
#   - every load ordering (Relaxed through SeqCst) is a plain sized
#     MOV: x86 loads are acquire by TSO;
#   - the Relaxed store is a plain MOV (TSO gives it release); the
#     Release/SeqCst form (the marker's form 1) is the implicitly
#     LOCKed XCHG — the sequentially consistent store form (stronger
#     than a release store, which is always legal);
#   - RMW/CAS use the LOCKed forms at seq-cst strength: x86 atomic
#     RMWs are inherently locked and no weaker instruction exists, so
#     the marker's ordering form never changes the instruction;
#   - the fence is MFENCE for form 1 (Release/AcqRel/SeqCst — stronger
#     than TSO's automatic release ordering, always legal) and nothing
#     for form 0 (Acquire).
# Register discipline: the fixed general ABI registers are dead at
# every marked statement (they appear only in entry binds and pre-call
# argument moves), so RAX/RDX/RCX/RSI are free statement scratch; the
# allocator keeps the operand vregs in distinct pool registers.

# The sized zero-extending load of an atomic value into `dst`.
def x86_emit_atom_load(inout xe: X86Emit, w: Int, dst: X64, base: X64, disp: Int) -> Unit
  match w
  when 1 then x86_emit(&mut xe.buf, x86_movzx_r64_m8(dst, base, disp))
  when 2 then x86_emit(&mut xe.buf, x86_movzx_r64_m16(dst, base, disp))
  when 4 then x86_emit(&mut xe.buf, x86_mov_r32_rm(dst, base, disp))
  when _ then x86_emit(&mut xe.buf, x86_mov_rm(dst, base, disp))
  end
end

# Zero-extend `r` to its storage width: the destructive-width scratch
# forms (xchg/xadd) write only the low 1/2/4 bytes, so the upper bits
# would otherwise carry the operand's stale/canonical upper bits into
# the old-value result. A width-8 value needs no work (the low byte
# forms' upper bits are the operand's, and the sized canonical word is
# the full register).
def x86_zero_extend_low(inout xe: X86Emit, w: Int, r: X64) -> Unit
  if w == 1 then
    x86_emit(&mut xe.buf, x86_movzx_r64_r8(r, r))
  elsif w == 2 then
    x86_emit(&mut xe.buf, x86_alu_ri(4, r, 65535))
  elsif w == 4 then
    x86_emit(&mut xe.buf, x86_alu_rr32(0x89, r, r))
  end
end

# The sized plain store / LOCK XCHG store / XCHG exchange.
def x86_emit_sized_store(inout xe: X86Emit, w: Int, base: X64, disp: Int, src: X64) -> Unit
  match w
  when 1 then x86_emit(&mut xe.buf, x86_mov_m8_r8(base, disp, src))
  when 2 then x86_emit(&mut xe.buf, x86_mov_m16_r16(base, disp, src))
  when 4 then x86_emit(&mut xe.buf, x86_mov_m32_r32(base, disp, src))
  when _ then x86_emit(&mut xe.buf, x86_mov_mr(base, disp, src))
  end
end

def x86_emit_ptr_stmt(inout xe: X86Emit, alloc: LirAlloc, pop: LirPtrOp, pos: Int) -> Result[Unit, String]
  match pop
  when LirPtrOp::LirPtrLea(dst, off) then
    let dt = x86_def_target(alloc, dst, pos)
    x86_emit(&mut xe.buf, x86_lea(dt.reg, X64::RBP, off))
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirPtrAddr(dst, base, off) then
    let dt = x86_def_target(alloc, dst, pos)
    let pref = if dt.reg == X64::RAX then X64::RDX else X64::RAX end
    let br = x86_emit_use(xe, alloc, LirValue::LirReg(base), pos, pref)
    x86_emit(&mut xe.buf, x86_lea(dt.reg, br, off))
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirPtrLoad(dst, base, off, w, sign) then
    let dt = x86_def_target(alloc, dst, pos)
    let pref = if dt.reg == X64::RAX then X64::RDX else X64::RAX end
    let br = x86_emit_use(xe, alloc, LirValue::LirReg(base), pos, pref)
    match w
    when 1 then
      if sign then
        x86_emit(&mut xe.buf, x86_movsx_r64_m8(dt.reg, br, off))
      else
        x86_emit(&mut xe.buf, x86_movzx_r64_m8(dt.reg, br, off))
      end
    when 2 then
      if sign then
        x86_emit(&mut xe.buf, x86_movsx_r64_m16(dt.reg, br, off))
      else
        x86_emit(&mut xe.buf, x86_movzx_r64_m16(dt.reg, br, off))
      end
    when 4 then
      if sign then
        x86_emit(&mut xe.buf, x86_movsxd_rm(dt.reg, br, off))
      else
        x86_emit(&mut xe.buf, x86_mov_r32_rm(dt.reg, br, off))
      end
    when _ then
      x86_emit(&mut xe.buf, x86_mov_rm(dt.reg, br, off))
    end
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirPtrStore(base, off, src, w) then
    let br = x86_emit_use(xe, alloc, LirValue::LirReg(base), pos, X64::RAX)
    let sr = x86_emit_use(xe, alloc, LirValue::LirReg(src), pos, X64::RDX)
    x86_emit_sized_store(xe, w, br, off, sr)
    Result::Ok(())
  when LirPtrOp::LirAtomLoad(form, w, dst, addr) then
    let dt = x86_def_target(alloc, dst, pos)
    let pref = if dt.reg == X64::RAX then X64::RDX else X64::RAX end
    let ar = x86_emit_use(xe, alloc, LirValue::LirReg(addr), pos, pref)
    # Form 0 (Relaxed) and form 1 (Acquire/SeqCst) are both the plain
    # sized MOV: x86 loads are acquire under TSO.
    x86_emit_atom_load(xe, w, dt.reg, ar, 0)
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirAtomStore(form, w, addr, val) then
    let ar = x86_emit_use(xe, alloc, LirValue::LirReg(addr), pos, X64::RAX)
    let vr = x86_emit_use(xe, alloc, LirValue::LirReg(val), pos, X64::RDX)
    if form == 0 then
      x86_emit_sized_store(xe, w, ar, 0, vr)
    else
      # Release/SeqCst: the implicitly locked xchg store. The old value
      # lands in the value scratch (never a live pool register — the
      # operand is copied into RCX first), masked to the storage width.
      x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, vr))
      x86_zero_extend_low(xe, w, X64::RCX)
      x86_emit(&mut xe.buf, x86_xchg_rm(w, ar, 0, X64::RCX))
    end
    Result::Ok(())
  when LirPtrOp::LirAtomRmw(family, form, w, dst, addr, val) then
    let dt = x86_def_target(alloc, dst, pos)
    let ar = x86_emit_use(xe, alloc, LirValue::LirReg(addr), pos, X64::RDX)
    if family == 0 then
      # fetch_add/sub: the lowering prepared sub as the add of the
      # negated value, so the family is always an add. LOCK XADD leaves
      # the old value in the (copied, width-masked) value scratch RCX.
      let vr = x86_emit_use(xe, alloc, LirValue::LirReg(val), pos, X64::RCX)
      if vr != X64::RCX then
        x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, vr))
      end
      x86_zero_extend_low(xe, w, X64::RCX)
      x86_emit(&mut xe.buf, x86_lock_xadd(w, ar, 0, X64::RCX))
      if dt.reg != X64::RCX then
        x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RCX))
      end
    elsif family == 4 then
      # exchange: the implicitly locked XCHG leaves the old value in
      # the (copied, width-masked) value scratch RCX.
      let vr = x86_emit_use(xe, alloc, LirValue::LirReg(val), pos, X64::RCX)
      if vr != X64::RCX then
        x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, vr))
      end
      x86_zero_extend_low(xe, w, X64::RCX)
      x86_emit(&mut xe.buf, x86_xchg_rm(w, ar, 0, X64::RCX))
      if dt.reg != X64::RCX then
        x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RCX))
      end
    else
      # and/or/xor: the LOCKed CAS retry loop. RAX = old (the cmpxchg
      # accumulator), RCX = the candidate, the value operand stays in
      # RSI / its own pool register (read-only).
      let vr = x86_emit_use(xe, alloc, LirValue::LirReg(val), pos, X64::RSI)
      let lbl_loop = x86_fresh_label(xe, "rmw_loop")
      x86_emit_atom_load(xe, w, X64::RAX, ar, 0)
      def_label(&mut xe.buf, lbl_loop.clone())
      x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, X64::RAX))
      if family == 1 then
        x86_emit(&mut xe.buf, x86_alu_rr_w(w, 0x21, X64::RCX, vr))
      elsif family == 2 then
        x86_emit(&mut xe.buf, x86_alu_rr_w(w, 0x09, X64::RCX, vr))
      else
        x86_emit(&mut xe.buf, x86_alu_rr_w(w, 0x31, X64::RCX, vr))
      end
      x86_emit(&mut xe.buf, x86_lock_cmpxchg(w, ar, 0, X64::RCX))
      x86_emit_jcc_label(xe, LirCond::LirNe, lbl_loop)
      if dt.reg != X64::RAX then
        x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RAX))
      end
    end
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirAtomCas(form, w, dst, exp, des, addr) then
    let dt = x86_def_target(alloc, dst, pos)
    let ar = x86_emit_use(xe, alloc, LirValue::LirReg(addr), pos, X64::RDX)
    let er = x86_emit_use(xe, alloc, LirValue::LirReg(exp), pos, X64::RSI)
    let sr = x86_emit_use(xe, alloc, LirValue::LirReg(des), pos, X64::RCX)
    if er != X64::RAX then
      x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, er))
    end
    x86_emit(&mut xe.buf, x86_lock_cmpxchg(w, ar, 0, sr))
    if dt.reg != X64::RAX then
      x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RAX))
    end
    x86_store_def(xe, dt)
    Result::Ok(())
  when LirPtrOp::LirPtrFence(form) then
    if form == 1 then
      x86_emit(&mut xe.buf, x86_mfence())
    end
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# Vector statement emission (SSE2 baseline, v128; VEX/AVX2 v256)
# ———————————————————————————————————————————————————————————————
# Vector values are memory-resident (fixed slots in the aggregate
# region); the SSE2 ops run on xmm0/xmm1 transients (fixed float ids
# 8/9 — dead at every vector statement by the fixed-vreg invariant),
# and the multi-instruction 32-bit multiply sequence additionally uses
# xmm2, which the same invariant leaves dead (the fixed ABI file
# appears only in entry binds and pre-call argument moves).
# The binop plan covers every lane class the ISA can serve on the
# baseline:
#   and/or/xor: PAND/POR/PXOR (all lanes);
#   add/sub:    PADDB/W/D/Q, PSUBB/W/D/Q, ADDPS/PD, SUBPS/PD;
#   mul:        f32/f64 MULPS/MULPD; PMULLW (16-bit lanes); the full
#               32-bit lane multiply as the SSE2 PMULUDQ-twice +
#               pshufd/punpckldq sequence, upgraded to the single
#               PMULLD when the desc advertises the sse41 token.
# The byte and qword packed multiplies have NO x86 SIMD instruction
# through AVX2 (PMULLW is the 16-bit low product; PMULLB does not
# exist before AVX-512 and VPMULLQ is AVX-512DQ), so those lane
# classes fail closed with the named ISA rule — never silently
# scalarized.
# Shuffle: pshufb is SSSE3; the baseline x86_64 description advertises
# no ssse3 token (and no SSE2 encoding exists for a runtime per-byte
# select), so the arm fails closed until a description opts in.
def x86_vec_slot_disp(alloc: LirAlloc, vreg: Int, pos: Int, what: String) -> Result[Int, String]
  match alloc.segs_of.get(vreg)
  when Option::Some(segs) then
    match lir_seg_at(segs, pos)
    when Option::Some(s) then
      if s.slot < 0 then
        return Result::Err("x86_64: vector " + what + " vreg " + vreg.to_string() + " has no fixed slot (vector values are memory-resident — fail-closed)")
      end
      Result::Ok(lir_slot_offset(s.slot))
    when Option::None then
      Result::Err("x86_64: vector " + what + " vreg " + vreg.to_string() + " is outside any interval (fail-closed)")
    end
  when Option::None then
    Result::Err("x86_64: vector " + what + " vreg " + vreg.to_string() + " has no segments (fail-closed)")
  end
end

# The SSE2 full 32-bit lane multiply sequence (PMULLD is SSE4.1). The
# two PMULUDQ even-lane products (lanes 0/2 and 1/3), their pshufd 0x08
# normalization and the punpckldq interleave rebuild the four modular
# 32-bit lane products: the low 32 bits of each 64-bit product are the
# exact lane product for both the signed and unsigned lane classes.
# xmm2 is the sequence temp; dst is [rbp+da], operands [rbp+aa]/[rbp+ba].
def x86_emit_vec_mul32_sse2(inout xe: X86Emit, da: Int, aa: Int, ba: Int) -> Unit
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
  x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
  x86_emit(&mut xe.buf, x86_movdqu_load(2, X64::RBP, aa))
  x86_emit(&mut xe.buf, x86_pmuludq_rr(2, 1))
  x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0xB1))
  x86_emit(&mut xe.buf, x86_pshufd_rr(1, 1, 0xB1))
  x86_emit(&mut xe.buf, x86_pmuludq_rr(0, 1))
  x86_emit(&mut xe.buf, x86_pshufd_rr(2, 2, 0x08))
  x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0x08))
  x86_emit(&mut xe.buf, x86_punpckldq_rr(2, 0))
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 2))
end

# PMULLD (SSE4.1) — the one-instruction full 32-bit lane multiply used
# when the target description advertises the sse41 token.
def x86_emit_vec_mul32_sse41(inout xe: X86Emit, da: Int, aa: Int, ba: Int) -> Unit
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
  x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
  x86_emit(&mut xe.buf, x86_pmulld_rr(0, 1))
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
end

# The SSE2 i64x2 equality result (all-ones per equal qword): PCMPEQQ is
# SSE4.1, so compare the dword halves (pcmpeqd), fold each qword with
# its pshufd 0xB1-swapped sibling and AND — every dword pair equal iff
# the full qword is equal. The result lands in d (the lane mask of the
# equality the language's compare surface returns); xmm2 is the temp.
def x86_emit_vec_eq_i64_sse2(inout xe: X86Emit, d: Int, s: Int) -> Unit
  x86_emit(&mut xe.buf, x86_pcmpeqd_rr(d, s))
  x86_emit(&mut xe.buf, x86_pshufd_rr(2, d, 0xB1))
  x86_emit(&mut xe.buf, x86_pand_rr(d, 2))
end

# The SSE2 i32 lane extract (PEXTRD is SSE4.1): pshufd broadcasts the
# requested lane into lane 0 (imm = lane * 0x55 repeats the 2-bit lane
# index in all four imm fields) and movd moves it to the GPR.
def x86_emit_vec_extract_i32_sse2(inout xe: X86Emit, dst: X64, v: Int, lane: Int) -> Unit
  x86_emit(&mut xe.buf, x86_pshufd_rr(2, v, lane * 0x55))
  x86_emit(&mut xe.buf, x86_movd_r32_xmm(dst, 2))
end

# A vector binop's emission plan. X86VecSse carries the legacy-SSE
# (mandatory prefix, opcode) pair — the v256 arm VEX-encodes the same
# opcode with the prefix's pp field. The 32-bit integer multiply has no
# single SSE2 instruction: X86VecMul32Sse2 is the two-PMULUDQ +
# shuffle/unpack sequence and X86VecMul32Sse41 is the one-instruction
# PMULLD available when the description advertises the sse41 token.
enum X86VecBinopPlan
  X86VecSse(Int, Int)
  X86VecMul32Sse2
  X86VecMul32Sse41
end

# The vector binop emission plan for one lane class, or the named
# ISA/feature rule that refuses it. `sse41_ok` is the target
# description's SSE4.1 token (xe.sse41_ok): it upgrades the 32-bit
# integer multiply to PMULLD; the SSE2 PMULUDQ sequence is the
# baseline every x86-64 description serves.
def x86_vec_binop_plan(op: LirVecBinOp, elem: String, sse41_ok: Bool) -> Result[X86VecBinopPlan, String]
  let eb = lir_vector_elem_bits(elem)
  let isf = lir_vector_elem_is_float(elem)
  if eb == 0 then
    return Result::Err("x86_64: the `" + elem + "` lane class is not a canonical vector element kind (i8/u8/i16/u16/i32/u32/i64/u64/f32/f64) — fail-closed")
  end
  match op
  when LirVecBinOp::LirVecAnd then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xDB))
  when LirVecBinOp::LirVecOr then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xEB))
  when LirVecBinOp::LirVecXor then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xEF))
  when LirVecBinOp::LirVecAndNot then
    # The and-not plan is stage data only: the emission stages the
    # operands b,a for PANDN (d = ~d & s), so the plan's (prefix,
    # opcode) pair is the SSE2 PANDN row.
    Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xDF))
  when LirVecBinOp::LirVecEq | LirVecBinOp::LirVecLt | LirVecBinOp::LirVecGt | LirVecBinOp::LirVecLe | LirVecBinOp::LirVecGe then
    # The compares have their own planner (x86_vec_cmp_plan — the
    # operand-swap/invert and the SSE2 i64-eq sequence); a compare
    # reaching the arithmetic plan is an internal routing error.
    Result::Err("x86_64: internal error: compare binop `" + lir_vec_binop_name(op) + "` reached the arithmetic plan (x86_vec_cmp_plan owns it) — fail-closed")
  when LirVecBinOp::LirVecAdd then
    if eb == 8 then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xFC))
    elsif eb == 16 then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xFD))
    elsif eb == 32 && !isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xFE))
    elsif eb == 32 && isf then Result::Ok(X86VecBinopPlan::X86VecSse(0, 0x58))
    elsif eb == 64 && !isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xD4))
    elsif eb == 64 && isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0x58))
    else Result::Err("x86_64: no vector add encoding for the " + elem + " lane class — fail-closed")
    end
  when LirVecBinOp::LirVecSub then
    if eb == 8 then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xF8))
    elsif eb == 16 then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xF9))
    elsif eb == 32 && !isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xFA))
    elsif eb == 32 && isf then Result::Ok(X86VecBinopPlan::X86VecSse(0, 0x5C))
    elsif eb == 64 && !isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xFB))
    elsif eb == 64 && isf then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0x5C))
    else Result::Err("x86_64: no vector sub encoding for the " + elem + " lane class — fail-closed")
    end
  when LirVecBinOp::LirVecMul then
    if isf then
      if eb == 32 then Result::Ok(X86VecBinopPlan::X86VecSse(0, 0x59))
      elsif eb == 64 then Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0x59))
      else Result::Err("x86_64: no packed floating multiply for the " + elem + " lane class — fail-closed")
      end
    elsif eb == 16 then
      Result::Ok(X86VecBinopPlan::X86VecSse(0x66, 0xD5))
    elsif eb == 32 then
      if sse41_ok then Result::Ok(X86VecBinopPlan::X86VecMul32Sse41)
      else Result::Ok(X86VecBinopPlan::X86VecMul32Sse2)
      end
    elsif eb == 8 then
      Result::Err("x86_64: SSE2 has no packed 8-bit integer multiply and no x86 SIMD class before AVX-512 defines PMULLB — PMULLW is the 16-bit low product only; fail-closed")
    elsif eb == 64 then
      Result::Err("x86_64: SSE2 has no packed 64-bit integer multiply: PMULUDQ is the widening 32x32->64 even-lane product, not a 64x64 lane multiply, and VPMULLQ is AVX-512DQ; fail-closed")
    else
      Result::Err("x86_64: no packed integer multiply for the " + elem + " lane class — fail-closed")
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The explicit-op extension emission (compare / shift / splat / lane
# moves / and-not / pack-unpack) — the x86 side of the completed
# surface. The base binop/load/store/shuffle arms above are unchanged;
# these helpers carry the same memory-resident slot discipline (xmm0/
# xmm1/xmm2 transients, movdqu/vmovdqu image loads and stores).
# ———————————————————————————————————————————————————————————————

# The compare plan form tokens: 0 = plain (a op b), 1 = swap (b op a),
# 2 = invert (NOT of the plain result), 3 = swap + invert.
enum X86VecCmpPlan
  X86VecCmpInt(Int, Int)
  X86VecCmpEq64Sse2
  X86VecCmpF32(Int)
  X86VecCmpF64(Int)
end

def x86_vec_cmp_int_eq_op(eb: Int) -> Int
  if eb == 8 then 0x74 elsif eb == 16 then 0x75 else 0x76 end
end

def x86_vec_cmp_int_gt_op(eb: Int) -> Int
  if eb == 8 then 0x64 elsif eb == 16 then 0x65 else 0x66 end
end

# The compare emission plan for one op/lane pair: the integer eq/gt
# rows, the SSE2 i64-eq sequence, the float CMPPS/CMPPD predicate rows.
# lt is gt with the operands swapped; le/ge add the all-ones XOR
# inversion. The float gt/ge and the 64-bit ordering compares fail
# closed with the named surface/ISA rules.
def x86_vec_cmp_plan(op: LirVecBinOp, elem: String) -> Result[X86VecCmpPlan, String]
  let eb = lir_vector_elem_bits(elem)
  let isf = lir_vector_elem_is_float(elem)
  if eb == 0 then
    return Result::Err("x86_64: the `" + elem + "` lane class is not a canonical vector element kind (i8/u8/i16/u16/i32/u32/i64/u64/f32/f64) — fail-closed")
  end
  match op
  when LirVecBinOp::LirVecEq then
    if isf then
      if eb == 32 then Result::Ok(X86VecCmpPlan::X86VecCmpF32(0))
      else Result::Ok(X86VecCmpPlan::X86VecCmpF64(0))
      end
    elsif eb == 64 then
      Result::Ok(X86VecCmpPlan::X86VecCmpEq64Sse2)
    else
      Result::Ok(X86VecCmpPlan::X86VecCmpInt(x86_vec_cmp_int_eq_op(eb), 0))
    end
  when LirVecBinOp::LirVecGt then
    if isf then
      Result::Err("x86_64: the explicit float compare surface is eq/lt/le; `gt` on the " + elem + " lane class is not in the surface — fail-closed")
    elsif eb == 64 then
      Result::Err("x86_64: SSE2 has no packed 64-bit signed compare (PCMPGTQ is SSE4.2; the explicit 64-bit integer compare surface is equality only) — fail-closed")
    else
      Result::Ok(X86VecCmpPlan::X86VecCmpInt(x86_vec_cmp_int_gt_op(eb), 0))
    end
  when LirVecBinOp::LirVecLt then
    if isf then
      if eb == 32 then Result::Ok(X86VecCmpPlan::X86VecCmpF32(1))
      else Result::Ok(X86VecCmpPlan::X86VecCmpF64(1))
      end
    elsif eb == 64 then
      Result::Err("x86_64: SSE2 has no packed 64-bit signed compare (PCMPGTQ is SSE4.2; the explicit 64-bit integer compare surface is equality only) — fail-closed")
    else
      Result::Ok(X86VecCmpPlan::X86VecCmpInt(x86_vec_cmp_int_gt_op(eb), 1))
    end
  when LirVecBinOp::LirVecLe then
    if isf then
      if eb == 32 then Result::Ok(X86VecCmpPlan::X86VecCmpF32(2))
      else Result::Ok(X86VecCmpPlan::X86VecCmpF64(2))
      end
    elsif eb == 64 then
      Result::Err("x86_64: SSE2 has no packed 64-bit signed compare (PCMPGTQ is SSE4.2; the explicit 64-bit integer compare surface is equality only) — fail-closed")
    else
      Result::Ok(X86VecCmpPlan::X86VecCmpInt(x86_vec_cmp_int_gt_op(eb), 2))
    end
  when LirVecBinOp::LirVecGe then
    if isf then
      Result::Err("x86_64: the explicit float compare surface is eq/lt/le; `ge` on the " + elem + " lane class is not in the surface — fail-closed")
    elsif eb == 64 then
      Result::Err("x86_64: SSE2 has no packed 64-bit signed compare (PCMPGTQ is SSE4.2; the explicit 64-bit integer compare surface is equality only) — fail-closed")
    else
      Result::Ok(X86VecCmpPlan::X86VecCmpInt(x86_vec_cmp_int_gt_op(eb), 3))
    end
  when _ then
    Result::Err("x86_64: internal error: non-compare binop `" + lir_vec_binop_name(op) + "` reached x86_vec_cmp_plan — fail-closed")
  end
end

# The and-not emission: b is staged into xmm0 (the PANDN destination
# operand, complemented) and a into xmm1 (the source), so PANDN
# computes ~b & a = a & ~b. v256 uses the AVX1 VANDNPS ymm form.
def x86_emit_vec_andnot(inout xe: X86Emit, da: Int, aa: Int, ba: Int, is256: Bool) -> Result[Unit, String]
  if is256 then
    if !xe.avx_ok then
      return Result::Err("x86_64: a 256-bit vector and-not needs the AVX 256-bit envelope (VANDNPS ymm), but the target description's isa_features advertise no avx/avx2 token (the x86_64 baseline is SSE2-only) — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, ba, true))
    x86_emit(&mut xe.buf, x86_vmovdqu_load(1, X64::RBP, aa, true))
    x86_emit(&mut xe.buf, x86_vex_andnps_rrr(0, 0, 1, true))
    x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
    Result::Ok(())
  else
    x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, ba))
    x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, aa))
    x86_emit(&mut xe.buf, x86_pandn_rr(0, 1))
    x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
    Result::Ok(())
  end
end

# The compare emission: stage the operands in xmm0/xmm1, run the plan's
# instruction (with the swap and the all-ones inversion when the form
# asks), and store the mask image. The i64 equality runs the SSE2
# dword sequence.
def x86_emit_vec_cmp(inout xe: X86Emit, op: LirVecBinOp, lane: LirVectorLane, da: Int, aa: Int, ba: Int) -> Result[Unit, String]
  let plan = match x86_vec_cmp_plan(op, lane.elem_kind.clone())
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(pl) then pl
  end
  match plan
  when X86VecCmpPlan::X86VecCmpInt(opcode, form) then
    if form == 1 || form == 3 then
      x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, aa))
      x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, ba))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
      x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
    end
    x86_emit(&mut xe.buf, x86_sse_rr(0x66, opcode, 0, 1))
    if form == 2 || form == 3 then
      x86_emit(&mut xe.buf, x86_pcmpeqd_rr(2, 2))
      x86_emit(&mut xe.buf, x86_pxor_rr(0, 2))
    end
  when X86VecCmpPlan::X86VecCmpEq64Sse2 then
    x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
    x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
    x86_emit_vec_eq_i64_sse2(xe, 0, 1)
  when X86VecCmpPlan::X86VecCmpF32(pred) then
    x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
    x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
    x86_emit(&mut xe.buf, x86_cmpps_rr(0, 1, pred))
  when X86VecCmpPlan::X86VecCmpF64(pred) then
    x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
    x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
    x86_emit(&mut xe.buf, x86_cmppd_rr(0, 1, pred))
  end
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
  Result::Ok(())
end

# The general-register splat: v128 uses the SSE2 shuffle sequences
# (MOVD/MOVQ plus PSHUFLW/PSHUFD; the byte form doubles PUNPCKLBW
# before the pshufd broadcast — no SSSE3 needed); v256 uses VMOVD/VMOVQ
# plus the AVX2 VPBROADCAST forms (gated on the desc's avx2 token).
def x86_emit_vec_splat(inout xe: X86Emit, alloc: LirAlloc, lane: LirVectorLane, dst: Int, src: Int, pos: Int) -> Result[Unit, String]
  let da = match x86_vec_slot_disp(alloc, dst, pos, "splat destination")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(d) then d
  end
  let sb = match alloc.fp_widths.get(src)
  when Option::Some(w) then
    # The FP-class scalar lane (an f32/f64 splat): read its bit image
    # into RAX (MOVD/MOVQ from the XMM holding the scalar) and
    # broadcast the bits. A memory-resident scalar loads straight from
    # its slot image (x86_fp_emit_use handles both cases at the class
    # width).
    let xr = x86_fp_emit_use(xe, alloc, src, pos, w, x86_fp_scratch())
    if w == LirFpWidth::LirF64 then
      x86_emit(&mut xe.buf, x86_movq_r64_xmm(X64::RAX, xr))
    else
      x86_emit(&mut xe.buf, x86_movd_r32_xmm(X64::RAX, xr))
    end
    X64::RAX
  when Option::None then
    x86_emit_use(xe, alloc, LirValue::LirReg(src), pos, X64::RAX)
  end
  let eb = lir_vector_elem_bits(lane.elem_kind.clone())
  if lane.bits == 256 then
    if !xe.avx2_ok then
      return Result::Err("x86_64: a 256-bit vector splat needs the AVX2 broadcast forms (VMOVD/VMOVQ + VPBROADCASTB/W/D/Q ymm), but the target description's isa_features advertise no avx2 token — fail-closed")
    end
    if eb <= 32 then
      x86_emit(&mut xe.buf, x86_movd_xmm_r32(0, sb))
    else
      x86_emit(&mut xe.buf, x86_movq_xmm_r64(0, sb))
    end
    let opcode = if eb == 8 then 0x78 elsif eb == 16 then 0x79 elsif eb == 32 then 0x58 else 0x59 end
    x86_emit(&mut xe.buf, x86_vex_broadcast(0, 0, true, opcode))
    x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
    Result::Ok(())
  else
    if eb == 8 then
      x86_emit(&mut xe.buf, x86_movd_xmm_r32(0, sb))
      x86_emit(&mut xe.buf, x86_punpcklbw_rr(0, 0))
      x86_emit(&mut xe.buf, x86_punpcklbw_rr(0, 0))
      x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0))
    elsif eb == 16 then
      x86_emit(&mut xe.buf, x86_movd_xmm_r32(0, sb))
      x86_emit(&mut xe.buf, x86_pshuflw_rr(0, 0, 0))
      x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0x44))
    elsif eb == 32 then
      x86_emit(&mut xe.buf, x86_movd_xmm_r32(0, sb))
      x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0))
    else
      x86_emit(&mut xe.buf, x86_movq_xmm_r64(0, sb))
      x86_emit(&mut xe.buf, x86_pshufd_rr(0, 0, 0x44))
    end
    x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
    Result::Ok(())
  end
end

# The lane extract: x86 has no general SIMD lane read; the i16 lane is
# PEXTRW (SSE2), the i32 lane the PSHUFD+MOVD sequence (SSE2), the i64
# lane MOVQ or the pshufd 0x0E high-qword select (SSE2), and the i8 lane
# PEXTRB (SSE4.1 — the desc token is the named gate).
def x86_emit_vec_extract(inout xe: X86Emit, alloc: LirAlloc, lane: LirVectorLane, dst: Int, src: Int, index: Int, pos: Int) -> Result[Unit, String]
  let sa = match x86_vec_slot_disp(alloc, src, pos, "extract source")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(d) then d
  end
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sa))
  let dt = x86_def_target(alloc, dst, pos)
  let eb = lir_vector_elem_bits(lane.elem_kind.clone())
  if eb == 8 then
    if !xe.sse41_ok then
      return Result::Err("x86_64: an 8-bit lane extract needs PEXTRB, an SSE4.1 instruction; the target description's isa_features advertise no sse41 token — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_pextrb_r32_xmm(dt.reg, 0, index))
  elsif eb == 16 then
    x86_emit(&mut xe.buf, x86_pextrw_r32_xmm(dt.reg, 0, index))
  elsif eb == 32 then
    x86_emit_vec_extract_i32_sse2(xe, dt.reg, 0, index)
  else
    if index == 0 then
      x86_emit(&mut xe.buf, x86_movq_r64_xmm(dt.reg, 0))
    else
      x86_emit(&mut xe.buf, x86_pshufd_rr(2, 0, 0x0E))
      x86_emit(&mut xe.buf, x86_movq_r64_xmm(dt.reg, 2))
    end
  end
  x86_store_def(xe, dt)
  Result::Ok(())
end

# The lane insert: load the base image, PINSRW (i16, SSE2) or the
# SSE4.1 PINSRB/PINSRD/PINSRQ (the desc token is the named gate), store
# the image back. The other lanes are preserved by the insert forms.
def x86_emit_vec_insert(inout xe: X86Emit, alloc: LirAlloc, lane: LirVectorLane, dst: Int, src: Int, elem: Int, index: Int, pos: Int) -> Result[Unit, String]
  let da = match x86_vec_slot_disp(alloc, dst, pos, "insert destination")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(d) then d
  end
  let sa = match x86_vec_slot_disp(alloc, src, pos, "insert base vector")
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(d) then d
  end
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sa))
  let er = x86_emit_use(xe, alloc, LirValue::LirReg(elem), pos, X64::RAX)
  let eb = lir_vector_elem_bits(lane.elem_kind.clone())
  if eb == 8 then
    if !xe.sse41_ok then
      return Result::Err("x86_64: an 8-bit lane insert needs PINSRB, an SSE4.1 instruction; the target description's isa_features advertise no sse41 token — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_pinsrb_xmm_r32(0, er, index))
  elsif eb == 16 then
    x86_emit(&mut xe.buf, x86_pinsrw_xmm_r32(0, er, index))
  elsif eb == 32 then
    if !xe.sse41_ok then
      return Result::Err("x86_64: a 32-bit lane insert needs PINSRD, an SSE4.1 instruction; the target description's isa_features advertise no sse41 token — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_pinsrd_xmm_r32(0, er, index))
  else
    if !xe.sse41_ok then
      return Result::Err("x86_64: a 64-bit lane insert needs PINSRQ, an SSE4.1 instruction; the target description's isa_features advertise no sse41 token — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_pinsrq_xmm_r64(0, er, index))
  end
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
  Result::Ok(())
end

# The signed saturating pack (PACKSSDW/PACKSSWB): a's lanes fill the low
# half, b's the high half.
def x86_emit_vec_pack(inout xe: X86Emit, from_bits: Int, da: Int, aa: Int, ba: Int) -> Result[Unit, String]
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
  x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
  if from_bits == 32 then
    x86_emit(&mut xe.buf, x86_packssdw_rr(0, 1))
  else
    x86_emit(&mut xe.buf, x86_packsswb_rr(0, 1))
  end
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
  Result::Ok(())
end

# The signed widening unpack: PUNPCK{L,H}{BW,WD} with the same register
# duplicates each half's elements into their pair slots and the
# arithmetic right shift sign-extends the widened half (PSRAW 8 /
# PSRAD 16).
def x86_emit_vec_unpack(inout xe: X86Emit, from_bits: Int, hi: Int, da: Int, aa: Int) -> Result[Unit, String]
  x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
  if from_bits == 16 then
    if hi == 1 then
      x86_emit(&mut xe.buf, x86_punpckhwd_rr(0, 0))
    else
      x86_emit(&mut xe.buf, x86_punpcklwd_rr(0, 0))
    end
    x86_emit(&mut xe.buf, x86_psrad_imm(0, 16))
  else
    if hi == 1 then
      x86_emit(&mut xe.buf, x86_punpckhbw_rr(0, 0))
    else
      x86_emit(&mut xe.buf, x86_punpcklbw_rr(0, 0))
    end
    x86_emit(&mut xe.buf, x86_psraw_imm(0, 8))
  end
  x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
  Result::Ok(())
end

# The per-lane shift by an immediate: PSLLW/D/Q, PSRLW/D/Q, PSRAW/D
# (the SSE2 counted forms). The byte lane class has no SSE2 shift (a
# PSLLW/PSRLW plus a materialized mask constant would be needed and
# this route has no vector constant pool); PSRAQ is AVX-512 — both fail
# closed with the named ISA rule.
def x86_emit_vec_shift_imm(inout xe: X86Emit, form: Int, elem: String, amount: Int, da: Int, aa: Int, is256: Bool) -> Result[Unit, String]
  let eb = lir_vector_elem_bits(elem)
  if eb == 8 then
    return Result::Err("x86_64: SSE2 has no byte-lane shift (no PSLLB/PSRLB/PSRAB): a byte shift needs a PSLLW/PSRLW plus a materialized per-lane mask constant, and this route has no vector constant pool — the i8 lane class fails closed")
  end
  if form == 2 && eb == 64 then
    return Result::Err("x86_64: there is no qword arithmetic right shift before AVX-512 (PSRAQ is AVX-512F); the i64 asr class fails closed")
  end
  let opcode = if eb == 16 then 0x71 elsif eb == 32 then 0x72 else 0x73 end
  let ext = if form == 0 then 6 elsif form == 1 then 2 else 4 end
  if is256 then
    if !xe.avx2_ok then
      return Result::Err("x86_64: a 256-bit vector shift needs the AVX2 256-bit integer shift forms (VPSLLW/VPSLLD/VPSLLQ/VPSRLW/VPSRLD/VPSRLQ/VPSRAW/VPSRAD ymm), but the target description's isa_features advertise no avx2 token — fail-closed")
    end
    x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, aa, true))
    x86_emit(&mut xe.buf, x86_vex_shift_imm(0, 0, opcode, ext, true, amount))
    x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
    Result::Ok(())
  else
    x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
    if eb == 16 then
      if form == 0 then
        x86_emit(&mut xe.buf, x86_psllw_imm(0, amount))
      elsif form == 1 then
        x86_emit(&mut xe.buf, x86_psrlw_imm(0, amount))
      else
        x86_emit(&mut xe.buf, x86_psraw_imm(0, amount))
      end
    elsif eb == 32 then
      if form == 0 then
        x86_emit(&mut xe.buf, x86_pslld_imm(0, amount))
      elsif form == 1 then
        x86_emit(&mut xe.buf, x86_psrld_imm(0, amount))
      else
        x86_emit(&mut xe.buf, x86_psrad_imm(0, amount))
      end
    else
      if form == 0 then
        x86_emit(&mut xe.buf, x86_psllq_imm(0, amount))
      else
        x86_emit(&mut xe.buf, x86_psrlq_imm(0, amount))
      end
    end
    x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
    Result::Ok(())
  end
end

# The per-lane variable shift: the AVX2 VPSLLVD/VPSRLVD/VPSRAVD forms
# are the ONLY per-lane variable shifts before AVX-512 and they exist
# for the dword lanes; every other lane class fails closed with the
# named ISA rule. THE ONE RULE (shared with the aarch64 clamp
# sequence): the count lanes are UNSIGNED and a count >= 32 shifts
# every bit out — zero for VPSLLVD/VPSRLVD, sign fill for VPSRAVD —
# exactly the hardware's dword semantics (the aarch64 side clamps its
# signed-count SSHL/USHL to match).
def x86_emit_vec_shift_vec(inout xe: X86Emit, form: Int, lane: LirVectorLane, da: Int, aa: Int, ca: Int, is256: Bool) -> Result[Unit, String]
  if !xe.avx2_ok then
    return Result::Err("x86_64: a per-lane variable shift needs the AVX2 VPSLLVD/VPSRLVD/VPSRAVD forms, but the target description's isa_features advertise no avx2 token — fail-closed")
  end
  if lane.elem_kind != "i32" && lane.elem_kind != "u32" then
    return Result::Err("x86_64: per-lane variable shifts exist as the AVX2 dword forms (VPSLLVD/VPSRLVD/VPSRAVD) only; VPSLLVW/VPSLLVQ are AVX-512, so the " + lane.elem_kind + " lane class fails closed")
  end
  x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, aa, is256))
  x86_emit(&mut xe.buf, x86_vmovdqu_load(1, X64::RBP, ca, is256))
  if form == 0 then
    x86_emit(&mut xe.buf, x86_vex_vpsllvd_rrr(0, 0, 1, is256))
  elsif form == 1 then
    x86_emit(&mut xe.buf, x86_vex_vpsrlvd_rrr(0, 0, 1, is256))
  else
    x86_emit(&mut xe.buf, x86_vex_vpsravd_rrr(0, 0, 1, is256))
  end
  x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, is256))
  Result::Ok(())
end

def x86_emit_vec_stmt(inout xe: X86Emit, alloc: LirAlloc, vop: LirVecOp, pos: Int) -> Result[Unit, String]
  match vop
  when LirVecOp::LirVecBinop(op, lane, dst, a, b) then
    let is256 = lane.bits == 256
    let da = match x86_vec_slot_disp(alloc, dst, pos, "binop destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "binop left operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let ba = match x86_vec_slot_disp(alloc, b, pos, "binop right operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    if !is256 then
      # The explicit-extension tokens (andnot + the mask compares) route
      # to their own planners; the base tokens keep the arithmetic plan.
      match lir_vec_binop_intrinsic_kind(op)
      when Option::Some(_) then
        let plan = match x86_vec_binop_plan(op, lane.elem_kind, xe.sse41_ok)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(pl) then pl
        end
        match plan
        when X86VecBinopPlan::X86VecSse(pr) then
          x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
          x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ba))
          x86_emit(&mut xe.buf, x86_sse_rr(pr.0, pr.1, 0, 1))
          x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
        when X86VecBinopPlan::X86VecMul32Sse2 then
          x86_emit_vec_mul32_sse2(xe, da, aa, ba)
        when X86VecBinopPlan::X86VecMul32Sse41 then
          x86_emit_vec_mul32_sse41(xe, da, aa, ba)
        end
        Result::Ok(())
      when Option::None then
        if lir_vec_binop_is_compare(op) then
          x86_emit_vec_cmp(xe, op, lane, da, aa, ba)
        else
          x86_emit_vec_andnot(xe, da, aa, ba, false)
        end
      end
    else
      # The AVX/AVX2 256-bit arm (the desc's tokens, mirrored on xe).
      # AND/OR/XOR use the AVX1 FP logical forms on ymm (bit-identical
      # for the integer lane classes); every other binop uses the VEX
      # pp/opcode of the legacy plan and needs AVX2 when its lane class
      # is integer. The 32-bit integer multiply plans map to VPMULLD
      # (VEX.256.66.0F38.40 — AVX2's own 256-bit form, not the SSE4.1
      # PMULLD), so the v256 lane class is served on AVX2 without any
      # SSE4.1 token.
      if lir_vec_binop_is_compare(op) then
        return Result::Err("x86_64: a 256-bit vector compare (`" + lir_vec_binop_name(op) + "` on the " + lane.elem_kind + " lane class) needs the AVX2 VPCMPEQ*/VPCMPGT* ymm forms, which are not in the stage-1 explicit-op envelope (v128 only) — fail-closed")
      end
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector binop on the `" + lane.elem_kind + "` lane class needs the AVX 256-bit envelope, but the target description's isa_features advertise no avx/avx2 token (the x86_64 baseline is SSE2-only) — fail-closed")
      end
      if op == LirVecBinOp::LirVecAndNot then
        # The and-not v256 form is the AVX1 VANDNPS ymm row (bitwise).
        return x86_emit_vec_andnot(xe, da, aa, ba, true)
      end
      var pp = 0
      var map = 1
      var opcode = 0
      var need_avx2 = false
      match op
      when LirVecBinOp::LirVecAnd then opcode = 0x54
      when LirVecBinOp::LirVecOr then opcode = 0x56
      when LirVecBinOp::LirVecXor then opcode = 0x57
      when _ then
        let plan = match x86_vec_binop_plan(op, lane.elem_kind, xe.sse41_ok)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(pl) then pl
        end
        match plan
        when X86VecBinopPlan::X86VecSse(pr) then
          pp = x86_vex_pp(pr.0)
          opcode = pr.1
          need_avx2 = !lir_vector_elem_is_float(lane.elem_kind)
        when X86VecBinopPlan::X86VecMul32Sse2 then
          pp = 1
          map = 2
          opcode = 0x40
          need_avx2 = true
        when X86VecBinopPlan::X86VecMul32Sse41 then
          pp = 1
          map = 2
          opcode = 0x40
          need_avx2 = true
        end
      end
      if need_avx2 && !xe.avx2_ok then
        return Result::Err("x86_64: a 256-bit integer vector binop (" + lane.elem_kind + ") needs the AVX2 256-bit integer forms (VPADD/VPADDQ/VPADDD/VPSUB*/VPMULLW/VPMULLD ymm), but the target description's isa_features advertise no avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, aa, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_load(1, X64::RBP, ba, true))
      x86_emit(&mut xe.buf, x86_vex_rrr(map, pp, opcode, 0, 0, 1, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
      Result::Ok(())
    end
  when LirVecOp::LirVecLoad(lane, dst, ptr) then
    let da = match x86_vec_slot_disp(alloc, dst, pos, "load destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let pr = x86_emit_use(xe, alloc, LirValue::LirReg(ptr), pos, X64::RAX)
    if lane.bits == 256 then
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector load needs the AVX envelope (VMOVDQU ymm), but the target description's isa_features advertise no avx/avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(0, pr, 0, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(0, pr, 0))
      x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
    end
    Result::Ok(())
  when LirVecOp::LirVecStore(lane, src, ptr) then
    let sa = match x86_vec_slot_disp(alloc, src, pos, "store source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let pr = x86_emit_use(xe, alloc, LirValue::LirReg(ptr), pos, X64::RAX)
    if lane.bits == 256 then
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector store needs the AVX envelope (VMOVDQU ymm), but the target description's isa_features advertise no avx/avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, sa, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(pr, 0, 0, true))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sa))
      x86_emit(&mut xe.buf, x86_movdqu_store(pr, 0, 0))
    end
    Result::Ok(())
  when LirVecOp::LirVecMove(lane, dst, src) then
    # The whole-image slot copy (the whole-vector move/copy slice):
    # load the source image from its fixed slot into xmm0 and store it
    # into the destination's slot — movdqu (SSE2) for v128, vmovdqu
    # (AVX) for v256, exactly the load/store arms' encoders.
    let da = match x86_vec_slot_disp(alloc, dst, pos, "move destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let sa = match x86_vec_slot_disp(alloc, src, pos, "move source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    if lane.bits == 256 then
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector move needs the AVX envelope (VMOVDQU ymm), but the target description's isa_features advertise no avx/avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, sa, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sa))
      x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
    end
    Result::Ok(())
  when LirVecOp::LirVecShuffle(lane, dst, a, mask) then
    let is256 = lane.bits == 256
    let da = match x86_vec_slot_disp(alloc, dst, pos, "shuffle destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "shuffle source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let ma = match x86_vec_slot_disp(alloc, mask, pos, "shuffle mask")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    if is256 then
      # VPSHUFB ymm (AVX2): each 128-bit lane shuffles within itself —
      # the same per-half semantics the aarch64 arm implements.
      if !xe.avx2_ok then
        return Result::Err("x86_64: a 256-bit vector shuffle needs VPSHUFB ymm (AVX2), but the target description's isa_features advertise no avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, aa, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_load(1, X64::RBP, ma, true))
      x86_emit(&mut xe.buf, x86_vex_pshufb(0, 0, 1, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
      Result::Ok(())
    else
      if !xe.ssse3_ok then
        return Result::Err("x86_64: vector shuffle (" + lane.elem_kind + " byte mask) needs PSHUFB, an SSSE3 instruction — the target description's isa_features advertise no ssse3 token (the x86_64 baseline is SSE2-only) — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, aa))
      x86_emit(&mut xe.buf, x86_movdqu_load(1, X64::RBP, ma))
      x86_emit(&mut xe.buf, x86_pshufb_rr(0, 1))
      x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
      Result::Ok(())
    end
  when LirVecOp::LirVecAbiBind(lane, dst, index) then
    # The vector parameter entry bind (audit item 34 stage 2): the ABI
    # vector register at the plan's SIMD&FP-file position holds the
    # caller's image; store it into the parameter vreg's fixed slot
    # image.  A 256-bit image uses the ymm file (AVX).
    let da = match x86_vec_slot_disp(alloc, dst, pos, "ABI bind destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    if lane.bits == 256 then
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector ABI bind needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(index, X64::RBP, da, true))
      x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, index, true))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(index, X64::RBP, da))
      x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, index))
    end
    Result::Ok(())
  when LirVecOp::LirVecAbiArg(lane, src, index) then
    # The call-argument ABI move: load the source's fixed slot image into
    # the ABI vector register the plan assigned.
    let sa = match x86_vec_slot_disp(alloc, src, pos, "ABI argument source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    if lane.bits == 256 then
      if !xe.avx_ok then
        return Result::Err("x86_64: a 256-bit vector ABI argument needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
      end
      x86_emit(&mut xe.buf, x86_vmovdqu_load(index, X64::RBP, sa, true))
    else
      x86_emit(&mut xe.buf, x86_movdqu_load(index, X64::RBP, sa))
    end
    Result::Ok(())
  when LirVecOp::LirVecShiftImm(lane, form, dst, a, amount) then
    if lane.bits == 256 && lane.bits != 0 then
      # The v256 shift-immediate envelope is named (the v128 SSE2 forms
      # are the baseline; the VEX.256 shift forms need avx2).
      if !xe.avx2_ok then
        return Result::Err("x86_64: a 256-bit vector shift needs the AVX2 256-bit integer shift forms, but the target description's isa_features advertise no avx2 token — fail-closed")
      end
    end
    let da = match x86_vec_slot_disp(alloc, dst, pos, "shift destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "shift source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    x86_emit_vec_shift_imm(xe, form, lane.elem_kind.clone(), amount, da, aa, lane.bits == 256)
  when LirVecOp::LirVecShiftVec(lane, form, dst, a, counts) then
    let da = match x86_vec_slot_disp(alloc, dst, pos, "shift destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "shift source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let ca = match x86_vec_slot_disp(alloc, counts, pos, "shift counts")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    x86_emit_vec_shift_vec(xe, form, lane, da, aa, ca, lane.bits == 256)
  when LirVecOp::LirVecSplat(lane, dst, src) then
    x86_emit_vec_splat(xe, alloc, lane, dst, src, pos)
  when LirVecOp::LirVecExtract(lane, dst, src, index) then
    if lane.bits == 256 then
      return Result::Err("x86_64: a 256-bit vector lane extract needs the AVX2 VEX lane forms, which are not in the stage-1 explicit-op envelope (v128 only) — fail-closed")
    end
    x86_emit_vec_extract(xe, alloc, lane, dst, src, index, pos)
  when LirVecOp::LirVecInsert(lane, dst, src, elem, index) then
    if lane.bits == 256 then
      return Result::Err("x86_64: a 256-bit vector lane insert needs the AVX2 VEX lane forms, which are not in the stage-1 explicit-op envelope (v128 only) — fail-closed")
    end
    x86_emit_vec_insert(xe, alloc, lane, dst, src, elem, index, pos)
  when LirVecOp::LirVecPack(from_lane, to_lane, dst, a, b) then
    if from_lane.bits == 256 then
      return Result::Err("x86_64: a 256-bit vector pack (`" + lir_vector_lane_name(from_lane) + "`) needs the AVX2 VPACKSS* ymm forms, which are not in the stage-1 explicit-op envelope (v128 only) — fail-closed")
    end
    let da = match x86_vec_slot_disp(alloc, dst, pos, "pack destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "pack low operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let ba = match x86_vec_slot_disp(alloc, b, pos, "pack high operand")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    x86_emit_vec_pack(xe, lir_vector_elem_bits(from_lane.elem_kind.clone()), da, aa, ba)
  when LirVecOp::LirVecUnpack(from_lane, to_lane, hi, dst, a) then
    if from_lane.bits == 256 then
      return Result::Err("x86_64: a 256-bit vector unpack (`" + lir_vector_lane_name(from_lane) + "`) needs the AVX2 VPUNPCK* ymm forms, which are not in the stage-1 explicit-op envelope (v128 only) — fail-closed")
    end
    let da = match x86_vec_slot_disp(alloc, dst, pos, "unpack destination")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    let aa = match x86_vec_slot_disp(alloc, a, pos, "unpack source")
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(d) then d
    end
    x86_emit_vec_unpack(xe, lir_vector_elem_bits(from_lane.elem_kind.clone()), hi, da, aa)
  end
end

# The nominal-kind emitter. Every arm is explicit; the constructs outside
# the surface return Err naming the rule (x86_validate_fn already
# rejected them — the arms are defense in depth and never silently emit).
def x86_emit_kind(inout xe: X86Emit, alloc: LirAlloc, kind: LirStmtKind, pos: Int) -> Result[Unit, String]
  match kind
  when LirStmtKind::LirMove(dst, val) then
    x86_emit_move(xe, alloc, dst, val, pos)
  when LirStmtKind::LirBinop(op, dst, left, right) then
    if op == LirBinOp::LirShl || op == LirBinOp::LirAsr || op == LirBinOp::LirLsr then
      x86_emit_shift(xe, alloc, op, dst, left, right, pos)
    else
      x86_emit_binop(xe, alloc, op, dst, left, right, pos)
    end
  when LirStmtKind::LirUnop(op, dst, src) then
    x86_emit_unop(xe, alloc, op, dst, src, pos)
  when LirStmtKind::LirCmp(left, right) then
    x86_emit_cmp(xe, alloc, left, right, pos)
  when LirStmtKind::LirCset(cond, dst) then
    x86_emit_cset(xe, alloc, cond, dst, pos)
  when LirStmtKind::LirLoadFrame(dst, off) then
    match alloc.vector_widths.get(dst)
    when Option::Some(bits) then
      # A vector stack-parameter bind (the stacked-vector slice): load
      # the 16/32-byte image BY VALUE from the caller slot at
      # [rbp + off] and store it into the parameter vreg's fixed slot
      # image.
      let da = match x86_vec_slot_disp(alloc, dst, pos, "stack-parameter bind destination")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(d) then d
      end
      if bits == 256 then
        if !xe.avx_ok then
          return Result::Err("x86_64: a 256-bit vector stack-parameter bind needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
        end
        x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, off, true))
        x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, da, 0, true))
      else
        x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, off))
        x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, da, 0))
      end
      Result::Ok(())
    when Option::None then
      Result::Err("x86_64: scalar/float LirLoadFrame at [rbp+" + off.to_string() + "] does not lower — the SysV scalar/float stack-argument stream is fail-closed (only vector byte images stack)")
    end
  when LirStmtKind::LirStaticLoad(dst, sym) then
    x86_emit_static_load(xe, alloc, dst, sym, pos)
  when LirStmtKind::LirPushArg(vreg) then
    match alloc.vector_widths.get(vreg)
    when Option::Some(bits) then
      # A stacked vector argument: push the 16/32-byte image BY VALUE
      # (sub rsp, slot; then the movdqu/vmovdqu store at the new [rsp]).
      # The call term adds the units back through stack_args.
      let sa = match x86_vec_slot_disp(alloc, vreg, pos, "stack argument source")
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(d) then d
      end
      if bits == 256 then
        if !xe.avx_ok then
          return Result::Err("x86_64: a 256-bit vector stack argument needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
        end
        x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, sa, true))
        x86_emit(&mut xe.buf, x86_alu_ri(5, X64::RSP, 32))
        x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RSP, 0, 0, true))
      else
        x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sa))
        x86_emit(&mut xe.buf, x86_alu_ri(5, X64::RSP, 16))
        x86_emit(&mut xe.buf, x86_movdqu_store(X64::RSP, 0, 0))
      end
      Result::Ok(())
    when Option::None then
      Result::Err("x86_64: scalar/float/general LirPushArg does not lower — the SysV scalar/float stack-argument stream is fail-closed (only vector byte images stack)")
    end
  when LirStmtKind::LirFMove(dst, src) then
    x86_emit_fp_move(xe, alloc, dst, src, pos)
  when LirStmtKind::LirFBinop(op, w, dst, left, right) then
    x86_emit_fp_binop(xe, alloc, op, w, dst, left, right, pos)
  when LirStmtKind::LirFNeg(w, dst, src) then
    x86_emit_fp_neg(xe, alloc, w, dst, src, pos)
  when LirStmtKind::LirFCmp(w, left, right) then
    x86_emit_fp_cmp(xe, alloc, w, left, right, pos)
  when LirStmtKind::LirFConst(w, dst, bits) then
    x86_emit_fp_const(xe, alloc, w, dst, bits, pos)
  when LirStmtKind::LirIntToFloat(w, dst, src, unsigned) then
    x86_emit_int_to_float(xe, alloc, w, dst, src, unsigned, pos)
  when LirStmtKind::LirFloatToInt(w, dst, src) then
    x86_emit_float_to_int(xe, alloc, w, dst, src, pos)
  when LirStmtKind::LirFcvt(src_w, dst, src) then
    x86_emit_fcvt(xe, alloc, src_w, dst, src, pos)
  end
end

# Emit one LIR statement. Marker dispatch first: pointer/atomic (ptr),
# register-class bit moves (bm) and vector statements (vec) route to
# their own arms; a division-marked statement routes to the idiv/div
# arm. Invariant I1 is checked here: a pending compare must be consumed
# by the very next statement (the adjacent LirCset).
def x86_emit_stmt(inout xe: X86Emit, alloc: LirAlloc, stmt: LirStmt, pos: Int) -> Result[Unit, String]
  match stmt.ptr
  when Option::Some(pop) then
    return x86_emit_ptr_stmt(xe, alloc, pop, pos)
  when Option::None then ()
  end
  match stmt.bm
  when Option::Some(_) then
    return x86_emit_bitmove(xe, alloc, stmt, pos)
  when Option::None then ()
  end
  match stmt.vec
  when Option::Some(vop) then
    return x86_emit_vec_stmt(xe, alloc, vop, pos)
  when Option::None then ()
  end
  match stmt.kind
  when LirStmtKind::LirCset(_, _) then ()
  when _ then
    if xe.pending_cmp then
      panic("x86_64: a statement between LirCmp and LirCset (invariant I1)")
    end
  end
  match stmt.div
  when Option::Some(dop) then
    match stmt.kind
    when LirStmtKind::LirBinop(_, dst, left, right) then
      x86_emit_div(xe, alloc, dop, dst, left, right, pos)
    when _ then
      Result::Err("x86_64: division marker on a non-binop carrier (the marker rides the arity-exact LirBinop Mul shape)")
    end
  when Option::None then
    x86_emit_kind(xe, alloc, stmt.kind, pos)
  end
end

# ———————————————————————————————————————————————————————————————
# Terminators, prologue/epilogue and the function driver
# ———————————————————————————————————————————————————————————————

# Pre-call spill stores (invariant I2): register-resident pre-call
# segments whose end precedes the call at `pos` store to their slots.
# The matching post-call reloads happen at each value's first read
# (x86_emit_use's alloc.reloads lookup). FP-class spills store their
# XMM at the class width; general spills the full word.
def x86_emit_call_spills(inout xe: X86Emit, alloc: LirAlloc, pos: Int) -> Unit
  var i = 0
  while i < alloc.spills.len() do
    if alloc.spills[i].0 == pos then
      let vreg = alloc.spills[i].1
      match alloc.segs_of.get(vreg)
      when Option::Some(segs) then
        match lir_seg_at(segs, pos - 1)
        when Option::Some(s) then
          if s.phys >= 0 && s.slot >= 0 then
            match alloc.fp_widths.get(vreg)
            when Option::Some(w) then
              let xr = x86_fp_phys_of(s.phys)
              if w == LirFpWidth::LirF32 then
                x86_emit(&mut xe.buf, x86_movss_store(X64::RBP, lir_slot_offset(s.slot), xr))
              else
                x86_emit(&mut xe.buf, x86_movsd_store(X64::RBP, lir_slot_offset(s.slot), xr))
              end
            when Option::None then
              x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, lir_slot_offset(s.slot), x86_phys_of(s.phys)))
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
    i = i + 1
  end
end

# The INLINED syscall sequence of a marked terminator (LirTerm.sys —
# the __intrinsic_syscall1..6 family). The pre-call argument moves
# landed the intrinsic's words in the fixed ABI vregs (0 = number,
# 1..5 = user args = rdi/rsi/rdx/rcx/r8/r9), and the Linux SysV kernel
# ABI reads the number in RAX and the args in RDI, RSI, RDX, R10, R8,
# R9. `nargs` is the direct emitter's nargs: the intrinsic's USER
# argument count (the family index — __intrinsic_syscall3 declares the
# number plus THREE user args, so its call passes nargs = 3; the
# number is separate). The shuffle mirrors codegen.tg's x86-64 Linux
# arm for the 1..3 user-argument forms (rax = rdi; rdi = rsi;
# rsi = rdx; rdx = rcx) and completes the 4-user-argument form the
# direct arm leaves untranslated: user arg 4 (SysV r8) moves to the
# kernel's r10; user arg 5 already sits in r9. (__intrinsic_syscall6's
# seven words exceed the route's six fixed argument registers and fail
# closed at the lowering, so nargs = 6 never reaches here.) `syscall`
# returns in RAX under the negative-errno convention (Linux — no carry
# normalization, unlike Darwin). This route's object contract is the
# ELF64 Linux SysV object, so the Linux convention is the route's.
# verified-by-hand: mov rax,rdi = 48 89 F8; mov rdi,rsi = 48 89 F7;
# mov rsi,rdx = 48 89 D6; mov rdx,rcx = 48 89 CA; mov r10,r8 = 4D 89 C2;
# syscall = 0F 05.
def x86_emit_syscall_lir(inout xe: X86Emit, nargs: Int) -> Unit
  x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, X64::RDI))
  x86_emit(&mut xe.buf, x86_mov_rr(X64::RDI, X64::RSI))
  if nargs >= 2 then
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RSI, X64::RDX))
  end
  if nargs >= 3 then
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RDX, X64::RCX))
  end
  if nargs >= 4 then
    x86_emit(&mut xe.buf, x86_mov_rr(X64::R10, X64::R8))
  end
  # nargs >= 5: the last user arg already sits in R9 (fixed vreg 5).
  x86_emit(&mut xe.buf, x86_syscall())
end

# One terminator. `sret_base` is the caller-side sret destination's
# fixed slot when this LirCall returns an aggregate (the
# sret_call_slots record): the SysV hidden pointer is formed in rdi
# after the general argument registers shift up by one, so the real
# arguments land in rsi/rdx/rcx/r8/r9. `agg_args` are this block's
# caller-side aggregate-argument records (addresses formed in their ABI
# slots). `gp_arg_count` is the block's general-class argument count
# (fixed-move destinations and aggregate slots) — the shift width.
# `sys` is the terminator's syscall marker (LirTerm.sys): a marked
# LirCall emits the inlined kernel-call sequence above instead of the
# branch (still under the ordinary call machinery — the pre-call
# spills, the RAX capture and the success jump).
def x86_emit_term(inout xe: X86Emit, alloc: LirAlloc, fn_name: String, kind: LirTermKind, sys: Option[LirSysOp], pos: Int, externs: Set[String], defined: Set[String], sret_base: Option[Int], agg_args: Vec[LirAggCallArg], gp_arg_count: Int, sret_words: Int, sret_base_slot: Int, tail: Bool) -> Result[Unit, String]
  if xe.pending_cmp then
    panic("x86_64: terminator reached with a LirCmp still pending (invariant I1)")
  end
  match kind
  when LirTermKind::LirJump(target) then
    x86_emit_jmp_label(xe, lir_block_label(fn_name, target))
    Result::Ok(())
  when LirTermKind::LirSwitch(vreg, arms, default_target) then
    # The per-arm compare chain: the operand resolves once at the term
    # position, each arm compares against an imm32 / a movabs'd RAX /
    # the parked scratch, and the default is an unconditional jump.
    let operand = x86_emit_use(xe, alloc, LirValue::LirReg(vreg), pos, X64::RAX)
    var ai = 0
    while ai < arms.len() do
      let arm = arms[ai]
      if arm.value == 0 then
        x86_emit(&mut xe.buf, x86_alu_ri(7, operand, 0))
        x86_emit_jcc_label(xe, LirCond::LirEq, lir_block_label(fn_name, arm.target))
      elsif x86_imm32_ok(arm.value) then
        x86_emit(&mut xe.buf, x86_alu_ri(7, operand, arm.value))
        x86_emit_jcc_label(xe, LirCond::LirEq, lir_block_label(fn_name, arm.target))
      elsif operand != X64::RAX then
        x86_emit(&mut xe.buf, x86_mov_ri64(X64::RAX, arm.value))
        x86_emit(&mut xe.buf, x86_alu_rr(0x39, operand, X64::RAX))
        x86_emit_jcc_label(xe, LirCond::LirEq, lir_block_label(fn_name, arm.target))
      else
        x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, x86_scratch_disp(alloc), X64::RAX))
        x86_emit(&mut xe.buf, x86_mov_ri64(X64::RAX, arm.value))
        x86_emit(&mut xe.buf, x86_alu_rm(0x3B, X64::RAX, X64::RBP, x86_scratch_disp(alloc)))
        x86_emit_jcc_label(xe, LirCond::LirEq, lir_block_label(fn_name, arm.target))
      end
      ai = ai + 1
    end
    x86_emit_jmp_label(xe, lir_block_label(fn_name, default_target))
    Result::Ok(())
  when LirTermKind::LirRet(opt_v) then
    if sret_words > 0 then
      # The aggregate return: copy the word group from its fixed frame
      # slots into the caller's buffer (the hidden rdi pointer saved at
      # entry in the sret slot) and leave the pointer in RAX — the SysV
      # convention (rax = the hidden pointer's value).
      match opt_v
      when Option::Some(_) then
        return Result::Err("x86_64: an sret function's LirRet carries a scalar value word (the sret copy-out reads the fixed word group — lowering invariant; fail-closed)")
      when Option::None then ()
      end
      if alloc.sret_slot < 0 then
        return Result::Err("x86_64: an sret function's allocation carries no sret save slot (fail-closed)")
      end
      x86_emit(&mut xe.buf, x86_mov_rm(X64::RAX, X64::RBP, lir_slot_offset(alloc.sret_slot)))
      var wk = 0
      while wk < sret_words do
        x86_emit(&mut xe.buf, x86_mov_rm(X64::R10, X64::RBP, lir_slot_offset(sret_base_slot + wk)))
        x86_emit(&mut xe.buf, x86_mov_mr(X64::RAX, 8 * wk, X64::R10))
        wk = wk + 1
      end
    else
      match opt_v
      when Option::Some(vreg) then
        match alloc.vector_widths.get(vreg)
        when Option::Some(bits) then
          # A VECTOR return (audit item 34 stage 2): load the image from
          # the vreg's fixed slot into the fixed vector return register
          # (xmm0, or ymm0 for a 256-bit image — abi_vector_return_name).
          let sd = match x86_vec_slot_disp(alloc, vreg, pos, "return vector")
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(d) then d
          end
          if bits == 256 then
            if !xe.avx_ok then
              return Result::Err("x86_64: a 256-bit vector return needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
            end
            x86_emit(&mut xe.buf, x86_vmovdqu_load(0, X64::RBP, sd, true))
          else
            x86_emit(&mut xe.buf, x86_movdqu_load(0, X64::RBP, sd))
          end
        when Option::None then
        match alloc.fp_widths.get(vreg)
        when Option::Some(w) then
          # A float result crosses in xmm0 (fixed float id 8).
          let xr = x86_fp_emit_use(xe, alloc, vreg, pos, w, 0)
          if xr != 0 then
            x86_fp_mov(xe, w, 0, xr)
          end
        when Option::None then
          let sr = x86_emit_use(xe, alloc, LirValue::LirReg(vreg), pos, X64::RAX)
          if sr != X64::RAX then
            x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, sr))
          end
        end
        end
      when Option::None then ()
      end
    end
    # The epilogue leaves RAX untouched (the saved registers are
    # rbx/r12..r15), so the return value survives leave/ret.
    x86_emit_epilogue(xe, alloc)
    Result::Ok(())
  when LirTermKind::LirTrap then
    # THE ABORT FUNNEL: a trap terminator (MirUnreachable/MirAbort, the
    # synthetic assert-failure block) terminates through a CALL to the
    # runtime's whitelisted __intrinsic_abort symbol — the same abort the
    # std panic surface and the aarch64 LIR/direct emitters use, never an
    # inline ud2 in the emitting user function.
    x86_emit_abort_call(xe)
    Result::Ok(())
  when LirTermKind::LirCall(target, args, stack_args, dest, success) then
    # stack_args counts 16-byte caller-slot units; only the vector
    # byte-image pushes produce them (a scalar/float/general push is
    # refused by x86_validate_fn), and the cleanup below adds exactly
    # 16*stack_args bytes back to RSP.
    x86_emit_call_spills(xe, alloc, pos)
    # The syscall marker (__intrinsic_syscall1..6 — see LirSysOp): the
    # pre-call argument moves already placed the args in the fixed ABI
    # vregs, and the marked terminator emits the inlined Linux SysV
    # kernel-call sequence instead of a branch. No sret/aggregate
    # machinery exists for it (lowering records none; the verifier
    # enforces their absence).
    var sys_nargs = -1
    match sys
    when Option::Some(sop) then
      match sop
      when LirSysOp::LirSyscall(n) then sys_nargs = n
      end
    when Option::None then ()
    end
    if sys_nargs >= 0 then
      x86_emit_syscall_lir(xe, sys_nargs)
    else
      # The caller-side sret destination slot (-1 = an ordinary call): the
      # hidden pointer consumes rdi, so every general argument shifts up by
      # one register and the aggregate argument slots land at slot+1.
      var sret_k = -1
      match sret_base
      when Option::Some(base) then sret_k = base
      when Option::None then ()
      end
      if sret_k >= 0 then
        match dest
        when Option::Some(_) then
          return Result::Err("x86_64: an sret call carries a scalar destination (the copy-out goes to the caller's frame — lowering invariant; fail-closed)")
        when Option::None then ()
        end
        if gp_arg_count > 5 then
          return Result::Err("x86_64: an sret call carries " + gp_arg_count.to_string() + " general-class arguments — the hidden rdi pointer leaves only rsi/rdx/rcx/r8/r9 (five) for real arguments; the stack-argument stream is fail-closed")
        end
        # Shift the general arguments up by one register (descending order
        # so no source is overwritten before it is read): arg k's value
        # moves from fixed k to fixed k+1.
        var gk = gp_arg_count - 1
        while gk >= 0 do
          x86_emit(&mut xe.buf, x86_mov_rr(x86_fixed_phys(gk + 1), x86_fixed_phys(gk)))
          gk = gk - 1
        end
      end
      # The caller-side aggregate argument addresses: the image's fixed
      # frame address formed in the argument's ABI slot (after the shift,
      # so an sret call's aggregate slots land at slot+1).
      var agi = 0
      while agi < agg_args.len() do
        let aa = agg_args[agi]
        let slot = if sret_k >= 0 then aa.slot + 1 else aa.slot end
        if slot >= 6 then
          return Result::Err("x86_64: aggregate argument " + agi.to_string() + " of the call to `" + target + "` lands in general slot " + slot.to_string() + " (only 0..5 are SysV registers; the stack-argument stream is fail-closed)")
        end
        x86_emit(&mut xe.buf, x86_lea(x86_fixed_phys(slot), X64::RBP, lir_slot_offset(aa.base_slot)))
        agi = agi + 1
      end
      # The hidden sret pointer goes last, into rdi (the register the
      # callee's prologue saves before shifting its arguments down).
      if sret_k >= 0 then
        x86_emit(&mut xe.buf, x86_lea(X64::RDI, X64::RBP, lir_slot_offset(sret_k)))
      end
      # The lowering's register argument moves are ordinary statements
      # into the fixed vregs 0..5 (rdi/rsi/rdx/rcx/r8/r9), so `args`
      # needs no read here. A target that is a defined program function
      # (self-recursion included) defers a rel32 patch; an extern (or a
      # target that is neither defined nor declared extern — the
      # defensive rule backend_rv.tg also keeps) emits a PLT32 relocation.
      if externs.contains(&target) || !defined.contains(&target) then
        x86_emit_call_remote(xe, target)
      else
        # (third-audit item 37) Tail-jump emission — ADVISORY marker; this
        # route re-checks its frame conditions: a locally defined callee
        # (never an extern/PLT), no caller stack slots (stack_args == 0 —
        # `leave` discards them) and no caller-side sret (sret_k < 0 — the
        # copy-out is an epilogue action a tail jump skips). The callee's
        # RAX/rdx result IS the caller's return value; the capture, stack
        # cleanup and success jump are skipped. A syscall terminator takes
        # the `if` arm above (no callee branch exists to jump to).
        if tail && stack_args == 0 && sret_k < 0 then
          x86_emit_tail_leave(xe, alloc)
          x86_emit_jmp_label(xe, target.clone())
          return Result::Ok(())
        end
        x86_emit_call_label(xe, target)
      end
      if stack_args != 0 then
        # The vector byte-image caller slots: add their 16-byte units
        # back to RSP (the LirPushArg vector arms reserved them before
        # the call; a v256 push counted two units).
        x86_emit(&mut xe.buf, x86_alu_ri(0, X64::RSP, 16 * stack_args))
      end
    end
    match dest
    when Option::Some(dv) then
      match alloc.vector_widths.get(dv)
      when Option::Some(bits) then
        # A VECTOR destination captures the fixed vector return register
        # (xmm0 / ymm0) into the destination vreg's fixed slot image
        # (audit item 34 stage 2).
        let sd = match x86_vec_slot_disp(alloc, dv, pos, "vector call destination")
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(d) then d
        end
        if bits == 256 then
          if !xe.avx_ok then
            return Result::Err("x86_64: a 256-bit vector call result needs the AVX ymm envelope, but the target description's isa_features advertise no avx/avx2 token — fail-closed")
          end
          x86_emit(&mut xe.buf, x86_vmovdqu_store(X64::RBP, sd, 0, true))
        else
          x86_emit(&mut xe.buf, x86_movdqu_store(X64::RBP, sd, 0))
        end
      when Option::None then
      match alloc.fp_widths.get(dv)
      when Option::Some(w) then
        let dt = x86_fp_def_target(alloc, dv, pos)
        if dt.xmm != 0 then
          x86_fp_mov(xe, w, dt.xmm, 0)
        end
        x86_fp_store_def(xe, dt, w)
      when Option::None then
        let dt = x86_def_target(alloc, dv, pos)
        if dt.reg != X64::RAX then
          x86_emit(&mut xe.buf, x86_mov_rr(dt.reg, X64::RAX))
        end
        x86_store_def(xe, dt)
      end
      end
    when Option::None then ()
    end
    x86_emit_jmp_label(xe, lir_block_label(fn_name, success))
    Result::Ok(())
  end
end

# Prologue: push rbp; mov rbp, rsp; sub rsp, frame_total; save the used
# callee-saved registers at the frame bottom (save k at
# [rbp - frame_total + 8*k]); then the aggregate-parameter entry copies
# and — for an sret function — the hidden-pointer save and the SysV
# argument-register shift:
#   - an sret function receives the caller's buffer address in rdi
#     (SysV), saved to the sret slot before any parameter bind reads
#     the file; every real argument then arrives one register higher
#     (rsi..r9), so the prologue shifts rsi->rdi, rdx->rsi, rcx->rdx,
#     r8->rcx, r9->r8 AFTER the aggregate copies (which read the
#     original slot+1 registers) and BEFORE the block-0 binds (which
#     read the canonical slots 0..5).
#   - each LirAggParamBind copies shape.words whole words from the
#     slot-carried image address into the parameter aggregate's fixed
#     frame slots (the address register is slot+1 under sret).
# The copy uses RAX (the address) and R10 (the word) — no argument
# register is clobbered.
def x86_emit_prologue(inout xe: X86Emit, frame_total: Int, saved: Vec[X64], lir_fn: LirFunction, alloc: LirAlloc) -> Unit
  x86_emit(&mut xe.buf, x86_push_r(X64::RBP))
  x86_emit(&mut xe.buf, x86_mov_rr(X64::RBP, X64::RSP))
  if frame_total > 0 then
    x86_emit(&mut xe.buf, x86_alu_ri(5, X64::RSP, frame_total))
  end
  var k = 0
  while k < saved.len() do
    x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, x86_save_disp(frame_total, k), saved[k]))
    k = k + 1
  end
  let has_sret = alloc.sret_slot >= 0
  if has_sret then
    x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, lir_slot_offset(alloc.sret_slot), X64::RDI))
  end
  var api = 0
  while api < lir_fn.agg_params.len() do
    let bind = lir_fn.agg_params[api]
    let slot = if has_sret then bind.slot + 1 else bind.slot end
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RAX, x86_fixed_phys(slot)))
    var j = 0
    while j < bind.words do
      x86_emit(&mut xe.buf, x86_mov_rm(X64::R10, X64::RAX, 8 * j))
      x86_emit(&mut xe.buf, x86_mov_mr(X64::RBP, lir_slot_offset(bind.base_slot + j), X64::R10))
      j = j + 1
    end
    api = api + 1
  end
  if has_sret then
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RDI, X64::RSI))
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RSI, X64::RDX))
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RDX, X64::RCX))
    x86_emit(&mut xe.buf, x86_mov_rr(X64::RCX, X64::R8))
    x86_emit(&mut xe.buf, x86_mov_rr(X64::R8, X64::R9))
  end
end

# Epilogue: restore the callee-saved registers, leave (rsp = rbp; pop
# rbp), ret. The return value travels in RAX and is not among the saved
# registers.
def x86_emit_epilogue(inout xe: X86Emit, alloc: LirAlloc) -> Unit
  let saved = x86_saved_regs(alloc)
  let frame_total = x86_frame_total(alloc, saved.len())
  var k = saved.len() - 1
  while k >= 0 do
    x86_emit(&mut xe.buf, x86_mov_rm(saved[k], X64::RBP, x86_save_disp(frame_total, k)))
    k = k - 1
  end
  x86_emit(&mut xe.buf, x86_leave())
  x86_emit(&mut xe.buf, x86_ret())
end

# (third-audit item 37) The tail-jump frame restore: the epilogue's
# callee-saved restore + `leave`, WITHOUT the ret (the LirCall tail arm
# jumps to the callee entry instead; the callee returns to our caller
# through the return address `leave` leaves on the stack). RAX/xmm0 are
# never touched — the callee's result is already the caller's.
def x86_emit_tail_leave(inout xe: X86Emit, alloc: LirAlloc) -> Unit
  let saved = x86_saved_regs(alloc)
  let frame_total = x86_frame_total(alloc, saved.len())
  var k = saved.len() - 1
  while k >= 0 do
    x86_emit(&mut xe.buf, x86_mov_rm(saved[k], X64::RBP, x86_save_disp(frame_total, k)))
    k = k - 1
  end
  x86_emit(&mut xe.buf, x86_leave())
end

# Emit ONE LIR function into the shared program emit state: the function
# symbol + entry label, the prologue, then the blocks with the SAME
# position walk the allocator used (invariant I3). The pending-compare
# record resets at every block boundary (lowering never leaves one
# pending).
def x86_emit_fn(inout xe: X86Emit, lir_fn: LirFunction, alloc: LirAlloc, externs: Set[String], defined: Set[String]) -> Result[Unit, String]
  match x86_validate_fn(lir_fn)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let saved = x86_saved_regs(alloc)
  let frame_total = x86_frame_total(alloc, saved.len())
  if frame_total > 2147483647 then
    return Result::Err("x86_64: function " + lir_fn.name + " needs a " + frame_total.to_string() + "-byte frame — larger than the signed 32-bit sub rsp immediate (fail-closed)")
  end
  # The ABI-stability boundary (third-audit item 42 boundary rule (c)) —
  # the x86 writer's side of the rule.
  x86_emit_fn_symbol(xe, lir_fn.name.clone(), lir_fn_export_binding(lir_fn))
  def_label(&mut xe.buf, lir_fn.name.clone())
  x86_emit_prologue(xe, frame_total, saved, lir_fn, alloc)
  var pos = 0
  var bi = 0
  while bi < lir_fn.blocks.len() do
    let b = lir_fn.blocks[bi]
    xe.pending_cmp = false
    xe.pending_fcmp = false
    def_label(&mut xe.buf, lir_block_label(lir_fn.name.clone(), b.id))
    # This block's call-ABI records (the sret destination slot and the
    # aggregate-argument addresses, keyed by block id), and the
    # block's general-class argument count for the caller-side sret
    # register shift: the fixed-general destinations of the pre-call
    # argument moves plus the aggregate-argument slots (aggregate
    # arguments emit no move — their address is formed at the term).
    let sret_base = match lir_fn.sret_call_slots.get(b.id)
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
    let agg_args = match lir_fn.agg_call_args.get(b.id)
    when Option::Some(v) then v
    when Option::None then Vec::new()
    end
    var gp_arg_count = 0
    var gi = 0
    while gi < b.stmts.len() do
      let gstmt = b.stmts[gi]
      match gstmt.kind
      when LirStmtKind::LirMove(dst, _) then
        if dst >= 0 && dst < lir_first_alloc_vreg() && !lir_is_fixed_fp_id(dst) then
          if dst + 1 > gp_arg_count then
            gp_arg_count = dst + 1
          end
        end
      when _ then ()
      end
      gi = gi + 1
    end
    var gai = 0
    while gai < agg_args.len() do
      if agg_args[gai].slot + 1 > gp_arg_count then
        gp_arg_count = agg_args[gai].slot + 1
      end
      gai = gai + 1
    end
    var si = 0
    while si < b.stmts.len() do
      match x86_emit_stmt(xe, alloc, b.stmts[si], pos)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      pos = pos + 1
      si = si + 1
    end
    match x86_emit_term(xe, alloc, lir_fn.name.clone(), b.term.kind, b.term.sys, pos, externs, defined, sret_base, agg_args, gp_arg_count, lir_fn.sret_words, lir_fn.sret_base_slot, lir_fn.tail_call_blocks.contains(&b.id))
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    pos = pos + 1
    bi = bi + 1
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# ELF64 x86-64 (EM_X86_64 = 62) relocatable-object writer
# ———————————————————————————————————————————————————————————————
# Mirrors backend_rv.tg's rv_elf_obj layout (the null/strtab/text/rela/
# data/bss/symtab shape) at the x86-64 ELF64 widths:
#   e_type ET_REL, e_machine 62, e_flags 0, ELFCLASS64 / ELFDATA2LSB;
#   ONE shared string table carries the section names and the symbol
#   names (e_shstrndx = its index);
#   .text (PROGBITS, AX, align 16), .rela.text (SHT_RELA, present only
#   when relocations exist: R_X86_64_PLT32 = 4 call entries and
#   R_X86_64_PC32 = 2 static-value entries, both with addend -4),
#   .data (PROGBITS, WA, the initialized statics' byte image), .bss
#   (NOBITS, WA, the uninitialized statics), .symtab last (align 8,
#   24-byte entries, sh_info = the first global index = 1);
#   symbols: null + the function globals (STB_GLOBAL|STT_FUNC) + the
#   data globals (STB_GLOBAL|STT_OBJECT in .data/.bss) + the extern
#   undefined globals (STB_GLOBAL|STT_NOTYPE, SHN_UNDEF).
# x86-64 needs no ARM-style "$t" mapping symbols, so there are no local
# symbols and r_info = (sym << 32) | type.

def x86_w16(inout out: Vec[u8], v: Int) -> Unit
  out.push((v & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
end

def x86_w32(inout out: Vec[u8], v: Int) -> Unit
  out.push((v & 0xFF) as u8)
  out.push(((v >> 8) & 0xFF) as u8)
  out.push(((v >> 16) & 0xFF) as u8)
  out.push(((v >> 24) & 0xFF) as u8)
end

def x86_w64(inout out: Vec[u8], v: Int) -> Unit
  x86_w32(out, v & 0xFFFFFFFF)
  x86_w32(out, (v >> 32) & 0xFFFFFFFF)
end

def x86_align_up(n: Int, a: Int) -> Int
  let rem = n % a
  if rem != 0 then
    n + (a - rem)
  else
    n
  end
end

# Append an ELF string table and return each name's offset (the first
# byte is the mandatory NUL).
def x86_strtab_add(inout out: Vec[u8], names: Vec[String]) -> Vec[Int]
  var offsets: Vec[Int] = Vec::new()
  var i = 0
  while i < names.len() do
    let off = out.len()
    offsets.push(off)
    let name_bytes = names[i].bytes()
    var ci = 0
    while ci < name_bytes.len() do
      out.push(name_bytes[ci])
      ci = ci + 1
    end
    out.push(0)
    i = i + 1
  end
  offsets
end

# The (name, code offset) function symbols in program order.
def x86_collect_fns(xe: X86Emit) -> Vec[(String, Int)]
  var fns: Vec[(String, Int)] = Vec::new()
  var i = 0
  while i < xe.syms.len() do
    let s = xe.syms[i]
    if s.section == Section::Text || s.section == Section::ColdText then
      fns.push((s.name.clone(), s.offset))
    end
    i = i + 1
  end
  fns
end

# The extern undefined symbol names in program order.
def x86_collect_exts(xe: X86Emit) -> Vec[String]
  var exts: Vec[String] = Vec::new()
  var i = 0
  while i < xe.syms.len() do
    let s = xe.syms[i]
    if s.section == Section::Extern then
      exts.push(s.name.clone())
    end
    i = i + 1
  end
  exts
end

# ———————————————————————————————————————————————————————————————
# Static-data emission (the statics slice)
# ———————————————————————————————————————————————————————————————
# The shared LIR scalar-static subset (lir_static_scalar_ok over the
# width-open route) with the aarch64 route's exact byte layout: the
# symbol at the 8-byte word alignment, the storage-width value bytes
# (little-endian), zero padding to the layout size and the trailing
# 8-byte word window (every LIR static READ is a full-word RIP-relative
# load, and the window above a narrow static must read zeros). The
# uninitialized form goes to .bss (Section::Bss symbols, the same
# 8-aligned placement).
def x86_emit_static(inout xe: X86Emit, st: MirStatic) -> Result[Unit, String]
  let ty = st.ty.clone()
  if !lir_static_scalar_ok(true, ty) then
    return Result::Err("x86_64: " + lir_static_unsupported_type_rule(st.name.clone()))
  end
  let sz = lir_scalar_word_size(ty)
  if sz <= 0 then
    return Result::Err("x86_64: " + lir_static_unsupported_type_rule(st.name.clone()))
  end
  match st.init
  when Option::Some(_) then
    let word_o = match lir_static_init_word_value(st)
    when Result::Err(e) then return Result::Err("x86_64: " + e)
    when Result::Ok(o) then o
    end
    let word_v = match word_o
    when Option::Some(v) then v
    when Option::None then 0
    end
    while xe.data.len() % 8 != 0 do
      xe.data.push(0)
    end
    xe.syms.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Data,
      offset: xe.data.len(),
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    if lir_is_bool_word(ty) then
      xe.data.push((word_v & 0xFF) as u8)
      var pad_bool = sz - 1
      while pad_bool > 0 do
        xe.data.push(0)
        pad_bool = pad_bool - 1
      end
    else
      var bi = 0
      while bi < sz do
        xe.data.push(((word_v >> (8 * bi)) & 0xFF) as u8)
        bi = bi + 1
      end
    end
    while xe.data.len() % 8 != 0 do
      xe.data.push(0)
    end
  when Option::None then
    while xe.bss_size % 8 != 0 do
      xe.bss_size = xe.bss_size + 1
    end
    xe.syms.push(AsmSymbol {
      name: st.name.clone(),
      section: Section::Bss,
      offset: xe.bss_size,
      size: sz,
      binding: SymBinding::Global,
      kind: SymKind::Data
    })
    xe.bss_size = xe.bss_size + sz
  end
  Result::Ok(())
end

def x86_emit_program_statics(inout xe: X86Emit, program: MirProgram) -> Result[Unit, String]
  var si = 0
  while si < program.statics.len() do
    match x86_emit_static(xe, program.statics[si].clone())
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(_) then ()
    end
    si = si + 1
  end
  # The final .bss 8-byte word window: every LIR static read is a
  # full-word load, and the last symbol's window must stay inside the
  # section (the loader zeroes the whole .bss; an unpadded tail would
  # let the read run into whatever section follows).
  while xe.bss_size % 8 != 0 do
    xe.bss_size = xe.bss_size + 1
  end
  Result::Ok(())
end

# (fourth-audit P0-20) The `tg.abi.enumver` object note is deleted with
# the versioned inline-image representation: both routes cross the
# canonical TaggedPtr value word, so a cached LIR object needs no
# enum-ABI version record.

# The (name, offset, size, section-kind) DATA symbols in program order;
# section-kind 0 = .data, 1 = .bss.
def x86_collect_datas(xe: X86Emit) -> Vec[(String, Int, Int, Int)]
  var out: Vec[(String, Int, Int, Int)] = Vec::new()
  var i = 0
  while i < xe.syms.len() do
    let s = xe.syms[i]
    if s.section == Section::Data then
      out.push((s.name.clone(), s.offset, s.size, 0))
    elsif s.section == Section::Bss then
      out.push((s.name.clone(), s.offset, s.size, 1))
    end
    i = i + 1
  end
  out
end

# Build the ELF64 object bytes. `relocs` are the relocation sites in
# .text (the offset of the 4-byte displacement field, the symbol name,
# the ELF type): extern-call PLT32 entries and static-value PC32
# entries. A relocation whose symbol is not a global of this object is
# written against the null symbol (the rv writer's defensive rule — the
# link errors visibly instead of silently mislinking). `datas` carries
# the .data/.bss symbols; `data` the .data byte image.
def x86_elf64_obj(code: Vec[u8], data: Vec[u8], fns: Vec[(String, Int)], datas: Vec[(String, Int, Int, Int)], bss_size: Int, exts: Vec[String], relocs: Vec[X86Reloc]) -> Vec[u8]
  let ehsize = 64
  let shdr_w = 64
  let sym_w = 24
  let rela_w = 24
  let has_rel = relocs.len() > 0
  let has_data = data.len() > 0
  let has_bss = bss_size > 0
  let text_idx = 2
  var next_idx = 3
  var rel_idx = -1
  if has_rel then
    rel_idx = next_idx
    next_idx = next_idx + 1
  end
  var data_idx = -1
  if has_data then
    data_idx = next_idx
    next_idx = next_idx + 1
  end
  var bss_idx = -1
  if has_bss then
    bss_idx = next_idx
    next_idx = next_idx + 1
  end
  let symtab_idx = next_idx
  let n_sections = symtab_idx + 1
  var global_names: Vec[String] = Vec::new()
  var fi = 0
  while fi < fns.len() do
    global_names.push(fns[fi].0.clone())
    fi = fi + 1
  end
  var di = 0
  while di < datas.len() do
    global_names.push(datas[di].0.clone())
    di = di + 1
  end
  var ei = 0
  while ei < exts.len() do
    global_names.push(exts[ei].clone())
    ei = ei + 1
  end
  let n_syms = 1 + global_names.len()
  let first_global = 1
  # Shared string table: NUL, section names, then every symbol name.
  var strtab: Vec[u8] = Vec::new()
  strtab.push(0)
  var sec_names: Vec[String] = Vec::new()
  sec_names.push(".text".to_string())
  let text_name_idx = 0
  var name_next = 1
  var rel_name_idx = -1
  if has_rel then
    rel_name_idx = name_next
    name_next = name_next + 1
    sec_names.push(".rela.text".to_string())
  end
  var data_name_idx = -1
  if has_data then
    data_name_idx = name_next
    name_next = name_next + 1
    sec_names.push(".data".to_string())
  end
  var bss_name_idx = -1
  if has_bss then
    bss_name_idx = name_next
    name_next = name_next + 1
    sec_names.push(".bss".to_string())
  end
  let symtab_name_idx = name_next
  name_next = name_next + 1
  sec_names.push(".symtab".to_string())
  let strtab_name_idx = name_next
  sec_names.push(".strtab".to_string())
  let sec_offs = x86_strtab_add(strtab, sec_names)
  let sym_offs = x86_strtab_add(strtab, global_names)
  let strtab_size = strtab.len()

  # File offsets.
  let off_text = ehsize
  let off_rel = x86_align_up(off_text + code.len(), 8)
  let rel_size = relocs.len() * rela_w
  let off_data = x86_align_up(off_rel + rel_size, 8)
  let off_sym = x86_align_up(off_data + data.len(), 8)
  let sym_size = n_syms * sym_w
  let off_str = x86_align_up(off_sym + sym_size, 4)
  let off_sh = x86_align_up(off_str + strtab_size, 8)

  var out: Vec[u8] = Vec::new()
  # ELF header.
  out.push(0x7F); out.push(0x45); out.push(0x4C); out.push(0x46)
  out.push(2)    # ELFCLASS64
  out.push(1)    # ELFDATA2LSB
  out.push(1)    # EV_CURRENT
  var zi = 0
  while zi < 9 do
    out.push(0)
    zi = zi + 1
  end
  x86_w16(out, 1)                 # e_type = ET_REL
  x86_w16(out, 62)                # e_machine = EM_X86_64
  x86_w32(out, 1)                 # e_version
  x86_w64(out, 0)                 # e_entry
  x86_w64(out, 0)                 # e_phoff
  x86_w64(out, off_sh)            # e_shoff
  x86_w32(out, 0)                 # e_flags
  x86_w16(out, ehsize)            # e_ehsize
  x86_w16(out, 0)                 # e_phentsize
  x86_w16(out, 0)                 # e_phnum
  x86_w16(out, shdr_w)            # e_shentsize
  x86_w16(out, n_sections)        # e_shnum
  x86_w16(out, 1)                 # e_shstrndx = the shared strtab
  # .text.
  while out.len() < off_text do
    out.push(0)
  end
  var ci = 0
  while ci < code.len() do
    out.push(code[ci])
    ci = ci + 1
  end
  # .rela.text.
  if has_rel then
    while out.len() < off_rel do
      out.push(0)
    end
    var ri = 0
    while ri < relocs.len() do
      var sym_idx = 0
      var found = false
      var gj = 0
      while gj < global_names.len() do
        if global_names[gj] == relocs[ri].sym then
          sym_idx = first_global + gj
          found = true
          gj = global_names.len() + 1
        else
          gj = gj + 1
        end
      end
      if !found then
        sym_idx = 0
      end
      let info_bits = (sym_idx << 32) | relocs[ri].kind
      x86_w64(out, relocs[ri].offset)   # r_offset
      x86_w64(out, info_bits)           # r_info = (sym << 32) | type
      x86_w64(out, -4)                  # r_addend = -4 (PC basis = end of the field-bearing instruction)
      ri = ri + 1
    end
  end
  # .data.
  if has_data then
    while out.len() < off_data do
      out.push(0)
    end
    var dbi = 0
    while dbi < data.len() do
      out.push(data[dbi])
      dbi = dbi + 1
    end
  end
  # .symtab.
  while out.len() < off_sym do
    out.push(0)
  end
  var zs = 0
  while zs < sym_w do
    out.push(0)
    zs = zs + 1
  end
  var fni = 0
  while fni < fns.len() do
    x86_w32(out, sym_offs[fni])     # st_name
    out.push(0x12)                  # STB_GLOBAL | STT_FUNC
    out.push(0)                     # st_other
    x86_w16(out, text_idx)          # st_shndx
    x86_w64(out, fns[fni].1)        # st_value
    x86_w64(out, 0)                 # st_size
    fni = fni + 1
  end
  var dsi = 0
  while dsi < datas.len() do
    x86_w32(out, sym_offs[fns.len() + dsi])   # st_name
    out.push(0x11)                  # STB_GLOBAL | STT_OBJECT
    out.push(0)                     # st_other
    if datas[dsi].3 == 0 then
      x86_w16(out, data_idx)        # st_shndx = .data
    else
      x86_w16(out, bss_idx)         # st_shndx = .bss
    end
    x86_w64(out, datas[dsi].1)      # st_value = the section offset
    x86_w64(out, datas[dsi].2)      # st_size = the declared layout size
    dsi = dsi + 1
  end
  var exi = 0
  while exi < exts.len() do
    x86_w32(out, sym_offs[fns.len() + datas.len() + exi])   # st_name
    out.push(0x10)                  # STB_GLOBAL | STT_NOTYPE
    out.push(0)                     # st_other
    x86_w16(out, 0)                 # st_shndx = SHN_UNDEF
    x86_w64(out, 0)                 # st_value
    x86_w64(out, 0)                 # st_size
    exi = exi + 1
  end
  # .strtab.
  while out.len() < off_str do
    out.push(0)
  end
  var sti = 0
  while sti < strtab_size do
    out.push(strtab[sti])
    sti = sti + 1
  end
  # Section headers.
  while out.len() < off_sh do
    out.push(0)
  end
  # [0] null.
  var zj = 0
  while zj < shdr_w do
    out.push(0)
    zj = zj + 1
  end
  # [1] the shared strtab.
  x86_w32(out, sec_offs[strtab_name_idx])
  x86_w32(out, 3)                   # SHT_STRTAB
  x86_w64(out, 0)                   # sh_flags
  x86_w64(out, 0)                   # sh_addr
  x86_w64(out, off_str)             # sh_offset
  x86_w64(out, strtab_size)         # sh_size
  x86_w32(out, 0)                   # sh_link
  x86_w32(out, 0)                   # sh_info
  x86_w64(out, 1)                   # sh_addralign
  x86_w64(out, 0)                   # sh_entsize
  # [2] .text.
  x86_w32(out, sec_offs[text_name_idx])
  x86_w32(out, 1)                   # SHT_PROGBITS
  x86_w64(out, 0x6)                 # SHF_ALLOC | SHF_EXECINSTR
  x86_w64(out, 0)                   # sh_addr
  x86_w64(out, off_text)            # sh_offset
  x86_w64(out, code.len())          # sh_size
  x86_w32(out, 0)                   # sh_link
  x86_w32(out, 0)                   # sh_info
  x86_w64(out, 16)                  # sh_addralign
  x86_w64(out, 0)                   # sh_entsize
  if has_rel then
    # .rela.text.
    x86_w32(out, sec_offs[rel_name_idx])
    x86_w32(out, 4)                 # SHT_RELA
    x86_w64(out, 0)                 # sh_flags
    x86_w64(out, 0)                 # sh_addr
    x86_w64(out, off_rel)           # sh_offset
    x86_w64(out, rel_size)          # sh_size
    x86_w32(out, symtab_idx)        # sh_link = the symtab
    x86_w32(out, text_idx)          # sh_info = .text
    x86_w64(out, 8)                 # sh_addralign
    x86_w64(out, rela_w)            # sh_entsize
  end
  if has_data then
    # .data.
    x86_w32(out, sec_offs[data_name_idx])
    x86_w32(out, 1)                 # SHT_PROGBITS
    x86_w64(out, 0x3)               # SHF_ALLOC | SHF_WRITE
    x86_w64(out, 0)                 # sh_addr
    x86_w64(out, off_data)          # sh_offset
    x86_w64(out, data.len())        # sh_size
    x86_w32(out, 0)                 # sh_link
    x86_w32(out, 0)                 # sh_info
    x86_w64(out, 8)                 # sh_addralign
    x86_w64(out, 0)                 # sh_entsize
  end
  if has_bss then
    # .bss — SHT_NOBITS: no file bytes, the sh_offset is the logical
    # position (the .symtab start) the loader's zero region begins at.
    x86_w32(out, sec_offs[bss_name_idx])
    x86_w32(out, 8)                 # SHT_NOBITS
    x86_w64(out, 0x3)               # SHF_ALLOC | SHF_WRITE
    x86_w64(out, 0)                 # sh_addr
    x86_w64(out, off_sym)           # sh_offset
    x86_w64(out, bss_size)          # sh_size
    x86_w32(out, 0)                 # sh_link
    x86_w32(out, 0)                 # sh_info
    x86_w64(out, 8)                 # sh_addralign
    x86_w64(out, 0)                 # sh_entsize
  end
  # The last section header is .symtab.
  x86_w32(out, sec_offs[symtab_name_idx])
  x86_w32(out, 2)                   # SHT_SYMTAB
  x86_w64(out, 0)                   # sh_flags
  x86_w64(out, 0)                   # sh_addr
  x86_w64(out, off_sym)             # sh_offset
  x86_w64(out, sym_size)            # sh_size
  x86_w32(out, 1)                   # sh_link = the strtab
  x86_w32(out, first_global)        # sh_info = first global index
  x86_w64(out, 8)                   # sh_addralign
  x86_w64(out, sym_w)               # sh_entsize
  out
end

# ———————————————————————————————————————————————————————————————
# Whole-program route (mirrors backend_rv.tg's rv_compile_object)
# ———————————————————————————————————————————————————————————————
# The driver's LIR gate (the TANGERINE_LIR_TARGET=x86_64 alias, or a
# --target x86_64 host triple, through target_desc_of_triple) routes
# single files here: every non-extern function goes through the LIR
# pipeline (fail-closed: one construct outside the route's surface fails
# the whole compile with a rule-naming reason), the bodies are emitted
# into one shared text buffer, deferred rel32 patches resolve once every
# function label is in the buffer, and the buffer is serialized as the
# ELF64 x86-64 relocatable object through x86_elf64_obj. There is no
# runtime merge: the aarch64 runtime buffers are aarch64 machine code;
# externs resolve through the object's undefined symbols instead.

# The program-level lowering entry (slice 2): the full width model and
# the aggregate/vector admissions over the x86_64 description (see
# lir.tg's lower_mir_fn_to_lir_prog_x86), fed the program's type-def
# table, the whole-program static label table and the SAME deinit
# tables the aarch64 route carries (deinit_plans — the concrete
# MirProgram.deinit_plans; finalizer_names — method_names_by_def;
# glue_names — the generated drop-glue name set; drop_glue_fns — the
# glue identity table): the MirDeinit slice's plan consumer resolves
# destruction terms through them exactly as on aarch64. The legacy
# two-flag wrapper (lower_mir_fn_to_lir_mode) stays available but is
# no longer the route's entry.
def x86_lower_mir_fn(f: MirFunction, type_defs: Map[Int, MirTypeDef], deinit_plans: Map[String, DeinitPlan], finalizer_names: Map[Int, String], glue_names: Set[String], static_labels: Map[String, String], drop_glue_fns: Map[Int, String]) -> Result[LirFunction, String]
  lower_mir_fn_to_lir_prog_x86(f, type_defs, deinit_plans, finalizer_names, glue_names, static_labels, drop_glue_fns)
end

# Compile the whole program to an ELF64 x86-64 relocatable object.
def x86_64_compile_object(program: MirProgram, desc: TargetDesc) -> Result[Vec[u8], String]
  if desc.arch != Arch::X86_64 then
    return Result::Err("x86_64: the route was given the `" + desc.name + "` description (expected the x86_64 System V description — fail-closed)")
  end
  if desc.pointer_width != 8 || desc.stack_alignment != 16 then
    return Result::Err("x86_64: the `" + desc.name + "` description must model 8-byte pointers and 16-byte stack alignment (says " + desc.pointer_width.to_string() + "-byte pointers, stack align " + desc.stack_alignment.to_string() + ")")
  end
  # The whole-program static label table (DefId-render -> emission
  # name): the same table the direct emitter builds; the MirStaticRef
  # lowering resolves through it. Then the .data/.bss emission, so every
  # symbol exists before any function body references it.
  var static_labels: Map[String, String] = Map::new()
  build_static_label_table(program, &mut static_labels)
  var externs: Set[String] = Set::new()
  var defined: Set[String] = Set::new()
  var fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      externs.insert(f.name.clone())
    else
      defined.insert(f.name.clone())
    end
    fi = fi + 1
  end
  var xe = x86_emit_new()
  # The target description's isa_features decide the SSSE3 vector
  # shuffle arm (pshufb), the SSE4.1 optional forms (the one-instruction
  # PMULLD 32-bit lane multiply; the SSE2 sequence serves the baseline)
  # and the AVX/AVX2 v256 arm (the ymm envelope and its 256-bit integer
  # forms); the baseline x86_64 description advertises SSE2 only, so
  # every optional-token arm fails closed with the named rule.
  xe.ssse3_ok = desc.isa_features.contains("ssse3")
  xe.sse41_ok = desc.isa_features.contains("sse41")
  xe.avx_ok = desc.isa_features.contains("avx") || desc.isa_features.contains("avx2")
  xe.avx2_ok = desc.isa_features.contains("avx2")
  match x86_emit_program_statics(xe, program)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  # The program's MirTypeDef table (TypeId.id -> def): the aggregate
  # slice's gate resolves plain-struct/tagged-enum shapes through it.
  var type_defs: Map[Int, MirTypeDef] = Map::new()
  var tdi = 0
  while tdi < program.types.len() do
    type_defs.insert(program.types[tdi].id.id, program.types[tdi].clone())
    tdi = tdi + 1
  end
  # The program's deinit tables — built EXACTLY like the aarch64
  # driver's lir_compile_object_cov (the MirDeinit slice's authority;
  # the plans and the generated glue bodies are target-independent):
  # the CONCRETE deinit plans (mir_type_identity_key -> DeinitPlan — the
  # same table codegen.tg's ctx.deinit_plans consumes), the finalizer
  # identity table (def_id_numeric -> the mangled emission name of every
  # registered finalizer — MirProgram.method_names_by_def), the
  # generated drop-glue name set (the values of MirProgram.drop_glue_fns
  # — the (ptr: Ptr[T], mask: Int) glue bodies the generated drop-glue
  # admission of lir_check_fn_shape admits and lir_resolve_glue_head_bind
  # turns into the machine-level entry bind) and the glue IDENTITY
  # table itself (the plan consumer resolves MirDeinit payload
  # identities through it and decides whether a function being lowered
  # is itself a glue body).
  let deinit_plans = program.deinit_plans.clone()
  let finalizer_names = program.method_names_by_def.clone()
  var glue_names: Set[String] = Set::new()
  for (_, glue_nm) in program.drop_glue_fns do
    glue_names.insert(glue_nm.clone())
  end
  let drop_glue_fns = program.drop_glue_fns.clone()
  # (fourth-audit P0-20) The program-wide enum-ABI version state, the
  # uniformity check and the object-metadata note are deleted: every
  # route crosses the canonical TaggedPtr value word.
  fi = 0
  while fi < program.functions.len() do
    let f = program.functions[fi]
    if f.is_extern then
      # Extern functions get no body — an undefined symbol entry for the
      # linker (the direct emitter's extern convention).
      xe.syms.push(AsmSymbol {
        name: f.name.clone(),
        section: Section::Extern,
        offset: 0,
        size: 0,
        binding: SymBinding::Global,
        kind: SymKind::Func
      })
    else
      # The extern-boundary enum guard (the same whole-program gate the
      # aarch64 route runs): payloaded-enum crossings to extern symbols
      # fail closed.
      match lir_check_extern_enum_calls(f, type_defs, externs)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      let lir_fn = match x86_lower_mir_fn(f, type_defs, deinit_plans, finalizer_names, glue_names, static_labels, drop_glue_fns)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(lf) then lf
      end
      # The required-export gate (the aarch64 route's check, shared):
      # a REQUIRED export must not carry a niched-enum crossing.
      match lir_check_fn_enum_abi_export(lir_fn)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      match lir_validate_callees(lir_fn, defined, externs)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      match x86_validate_fn(lir_fn)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
      let peeped = lir_peephole(lir_fn)
      let alloc = x86_alloc_registers(peeped)
      # Mandatory verification (audit item 26 — verify_lir): the
      # post-allocation, pre-emission gate over the peeped function and
      # its allocation. A non-empty violation list fails the route
      # closed with the violations named.
      let lir_violations = verify_lir(peeped, alloc, LirVerifyRoute::LirVerifyX86_64)
      if lir_violations.len() > 0 then
        return Result::Err(lir_verify_fail_err(peeped.name.clone(), lir_violations))
      end
      match x86_emit_fn(xe, peeped, alloc, externs, defined)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
    fi = fi + 1
  end
  match x86_resolve_patches(xe)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(_) then ()
  end
  let fns = x86_collect_fns(xe)
  let datas = x86_collect_datas(xe)
  let exts = x86_collect_exts(xe)
  let rels = xe.relocs.clone()
  Result::Ok(x86_elf64_obj(xe.buf.bytes.clone(), xe.data.clone(), fns, datas, xe.bss_size, exts, rels))
end

# Executable/image emission is out of this stage: fail closed with the
# reason (mirrors rv_compile_executable).
def x86_64_compile_executable(program: MirProgram, output_path: String) -> Result[Unit, String]
  Result::Err("x86_64: the x86-64 LIR route does not link executables in stage 1 — use --emit=obj and link the ELF64 x86-64 object with the system linker (the host image/startup contract is a separate route)")
end

