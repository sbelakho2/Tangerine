  lir_alloc_fp_width_of, lir_seg_at, lir_reload_at, lir_block_label,
  lir_slot_offset, lir_simd_lane_of_vector_lane, lir_vector_lane_name,
  lir_vector_elem_bits, lir_vector_elem_is_float,
  lir_vector_lane_narrow, lir_vector_lane_widen, lir_vec_shift_form_ok,
  lir_vec_binop_is_compare, lir_vec_binop_name,
  lir_static_scalar_ok,
