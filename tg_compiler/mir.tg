# Tangerine Compiler — MIR (Mid-level Intermediate Representation)
# Self-hosting compiler written in Tangerine
#
# MIR provides:
# - Control flow graph representation
# - SSA-like form for analysis
# - Explicit drops and moves
# - Agentic feature lowering

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::token::{Span, span_dummy}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody,
  Block, Stmt, StmtKind, Expr, ExprKind, BinOp, UnOp, Pattern, PatternKind, AstPath
}
use tg_compiler::types::{Type, TypeId}

# ———————————————————————————————————————————————————————————————
# MIR Types
# ———————————————————————————————————————————————————————————————

struct MirProgram
  functions: Vec[MirFunction]
  statics: Vec[MirStatic]
  types: Vec[MirTypeDef]
end

struct MirFunction
  name: String
  params: Vec[MirLocal]
  ret_type: Type
  locals: Vec[MirLocal]
  blocks: Vec[MirBlock]
  entry_block: BlockId
  is_async: Bool
  is_unsafe: Bool
  is_extern: Bool
  extern_abi: String          # "C", "Ruby", "System", etc.
  contracts: Vec[MirContract]
  span: Span
end

struct MirStatic
  name: String
  ty: Type
  init: Option[MirOperand]
  is_mut: Bool
end

struct MirTypeDef
  id: TypeId
  name: String
  kind: MirTypeDefKind
end

enum MirTypeDefKind
  Struct(Vec[MirFieldDef])
  Enum(Vec[MirVariantDef])
end

struct MirFieldDef
  name: String
  ty: Type
  offset: Int
end

struct MirVariantDef
  name: String
  discriminant: Int
  fields: Vec[Type]
end

# ———————————————————————————————————————————————————————————————
# Locals and Places
# ———————————————————————————————————————————————————————————————

struct LocalId
  id: Int
end

struct MirLocal
  id: LocalId
  name: String
  ty: Type
  is_mut: Bool
  span: Span
end

struct Place
  local: LocalId
  projections: Vec[Projection]
end

enum Projection
  ProjDeref
  ProjField(String, Int)
  ProjIndex(LocalId)
  ProjConstantIndex(Int)
  ProjDowncast(String, Int)  # For enum variants
end

def place_local(id: LocalId) -> Place
  # Clone the LocalId to avoid shared-pointer aliasing.
  Place { local: LocalId { id: id.id }, projections: Vec::new() }
end

def place_field(base: Place, name: String, index: Int) -> Place
  mut p = base
  p.projections.push(Projection::ProjField(name, index))
  p
end

def place_deref(base: Place) -> Place
  mut p = base
  p.projections.push(Projection::ProjDeref)
  p
end

# ———————————————————————————————————————————————————————————————
# Basic Blocks
# ———————————————————————————————————————————————————————————————

struct BlockId
  id: Int
end

struct MirBlock
  id: BlockId
  statements: Vec[MirStatement]
  terminator: MirTerminator
end

struct MirStatement
  kind: MirStatementKind
  span: Span
end

enum MirStatementKind
  MirAssign(Place, MirRvalue)
  MirStorageLive(LocalId)
  MirStorageDead(LocalId)
  MirNop
  
  # Agentic statements
  MirContractCheck(MirContract, MirOperand)  # Pre/post/invariant check
  MirBudgetConsume(String, Int)              # Consume budget resources
  MirEffectRecord(String, MirOperand)        # Record an effect
end

# ———————————————————————————————————————————————————————————————
# Rvalues and Operands
# ———————————————————————————————————————————————————————————————

struct MirOperand
  kind: MirOperandKind
end

enum MirOperandKind
  MirCopy(Place)
  MirMovePlace(Place)
  MirConstant(MirConstant)
end

struct MirConstant
  kind: MirConstantKind
  ty: Type
end

enum MirConstantKind
  MirUnit
  MirBool(Bool)
  MirInt(Int)
  MirFloat(Float)
  MirChar(Char)
  MirString(String)
  MirFnItem(String)    # Named function item — carries the symbol name
  MirZeroSized
end

struct MirRvalue
  kind: MirRvalueKind
end

enum MirRvalueKind
  MirMove(MirOperand)
  
  # References
  MirRef(Place)    # &place
  MirRefMut(Place) # &mut place
  
  # Aggregate construction
  MirAggregate(AggregateKind, Vec[MirOperand])
  
  # Binary/unary operations
  MirBinOp(MirBinOp, MirOperand, MirOperand)
  MirUnOp(MirUnOp, MirOperand)
  
  # Discriminant access
  MirDiscriminant(Place)
  
  # Length of array/slice
  MirLen(Place)
  
  # Cast
  MirCast(CastKind, MirOperand, Type)
  
  # Repeat for array initialization
  MirRepeat(MirOperand, Int)
  
  # SSA Phi node: list of (predecessor_block, value) pairs
  MirPhi(Vec[(BlockId, LocalId)])
end

enum AggregateKind
  MirArray(Type)
  Tuple
  Struct(TypeId, Vec[String])  # Type + field names
  Closure(TypeId)
  Generator(TypeId)
end

enum MirBinOp
  Add
  Sub
  Mul
  Div
  Mod
  BitAnd
  BitOr
  BitXor
  Shl
  Shr
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
end

enum MirUnOp
  Neg
  Not
  BitNot
end

enum CastKind
  IntToInt
  IntToFloat
  FloatToInt
  FloatToFloat
  Pointer
  Transmute
end

# ———————————————————————————————————————————————————————————————
# Terminators
# ———————————————————————————————————————————————————————————————

struct MirTerminator
  kind: MirTerminatorKind
  span: Span
end

enum MirTerminatorKind
  MirGoto(BlockId)
  MirReturn
  MirUnreachable
  MirSwitchInt { op: MirOperand, targets: Vec[SwitchTarget], default_target: BlockId }
  MirCall {
    dest: Place,
    func: MirOperand,
    args: Vec[MirOperand],
    success: BlockId,
    unwind: Option[BlockId]
  }
  MirDrop { place: Place, target: BlockId, unwind: Option[BlockId] }
  MirAssert { cond: MirOperand, expected: Bool, msg: AssertMessage, target: BlockId, unwind: Option[BlockId] }
  MirYield(MirOperand, BlockId)
  MirAbort
end

struct SwitchTarget
  value: Int
  target: BlockId
end

enum AssertMessage
  BoundsCheck(MirOperand, MirOperand)
  Overflow(MirBinOp)
  DivisionByZero
  RemainderByZero
  NullPointer
  ContractViolation(String)
end

# ———————————————————————————————————————————————————————————————
# Agentic Features in MIR
# ———————————————————————————————————————————————————————————————

struct MirContract
  kind: AstContractKind
  condition: MirOperand
  message: String
  span: Span
end

enum AstContractKind
  Pre
  Post
  Invariant
end

struct MirBudget
  resource: String
  limit: Int
  consumed: Int
end

struct MirEffect
  name: String
  arguments: Vec[MirOperand]
end

# ———————————————————————————————————————————————————————————————
# MIR Builder
# ———————————————————————————————————————————————————————————————

struct MirBuilder
  current_fn: Option[MirFunction]
  current_block: Option[BlockId]
  local_counter: Int
  block_counter: Int
  temp_counter: Int
  var_map: Map[String, LocalId]
  blocks: Map[Int, MirBlock]
  pending_closures: Vec[PendingClosure]
  break_target: Option[BlockId]
  continue_target: Option[BlockId]
  enum_variants: Map[String, Vec[String]]
end

struct PendingClosure
  name: String
  params: Vec[ClosureParam]
  captures: Vec[String]
  body: Expr
  ret_type: Type
end

def builder_new() -> MirBuilder
  MirBuilder {
    current_fn: Option::None,
    current_block: Option::None,
    local_counter: 0,
    block_counter: 0,
    temp_counter: 0,
    var_map: Map::new(),
    blocks: Map::new(),
    pending_closures: Vec::new(),
    break_target: Option::None,
    continue_target: Option::None,
    enum_variants: Map::new()
  }
end

def start_function(b: &mut MirBuilder, name: String, ret_type: Type, span: Span) -> Unit
  b.local_counter = 0
  b.block_counter = 0
  b.var_map = Map::new()
  b.blocks = Map::new()
  
  let entry = BlockId { id: 0 }
  b.block_counter = 1
  
  # Create the entry block
  b.blocks.insert(0, MirBlock {
    id: entry,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: span
    }
  })
  
  b.current_fn = Option::Some(MirFunction {
    name: name,
    params: Vec::new(),
    ret_type: ret_type.clone(),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: entry,
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span
  })
  
  b.current_block = Option::Some(entry)

  # Create return place as local 0 (convention: locals[0] is the return place)
  let ret_local = MirLocal {
    id: LocalId { id: b.local_counter },
    name: "_ret".to_string(),
    ty: ret_type,
    is_mut: true,
    span: span
  }
  b.local_counter = b.local_counter + 1
  match b.current_fn
  when Option::Some(f) then
    f.locals.push(ret_local)
  when _ then ()
  end
end

def add_param(b: &mut MirBuilder, name: String, ty: Type, span: Span) -> LocalId
  let id = LocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: false,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    f.params.push(local)
    f.locals.push(local)
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  id
end

def add_local(b: &mut MirBuilder, name: String, ty: Type, is_mut: Bool, span: Span) -> LocalId
  let id = LocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: is_mut,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    f.locals.push(local)
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  id
end

def add_temp(b: &mut MirBuilder, ty: Type, span: Span) -> LocalId
  let name = "_tmp" + b.temp_counter.to_string()
  b.temp_counter = b.temp_counter + 1
  add_local(b, name, ty, false, span)
end

def create_block(b: &mut MirBuilder) -> BlockId
  let id = BlockId { id: b.block_counter }
  b.block_counter = b.block_counter + 1
  
  # Create an empty block with an Unreachable placeholder terminator
  b.blocks.insert(id.id, MirBlock {
    id: id,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: span_dummy()
    }
  })
  id
end

def push_stmt(b: &mut MirBuilder, kind: MirStatementKind, span: Span) -> Unit
  let stmt = MirStatement { kind: kind, span: span }
  match b.current_block
  when Option::Some(blk_id) then
    match b.blocks.get_mut(blk_id.id)
    when Option::Some(block) then
      block.statements.push(stmt)
    when Option::None then ()
    end
  when Option::None then ()
  end
end

def push_assign(b: &mut MirBuilder, place: Place, rvalue: MirRvalue, span: Span) -> Unit
  push_stmt(b, MirStatementKind::MirAssign(place, rvalue), span)
end

def set_terminator(b: &mut MirBuilder, kind: MirTerminatorKind, span: Span) -> Unit
  match b.current_block
  when Option::Some(blk_id) then
    match b.blocks.get_mut(blk_id.id)
    when Option::Some(block) then
      block.terminator = MirTerminator { kind: kind, span: span }
    when Option::None then ()
    end
  when Option::None then ()
  end
end

def block_is_terminated(b: &MirBuilder) -> Bool
  match b.current_block
  when Option::Some(blk_id) then
    match b.blocks.get(blk_id.id)
    when Option::Some(block) then
      match block.terminator.kind
      when MirTerminatorKind::MirUnreachable then false
      when _ then true
      end
    when Option::None then false
    end
  when Option::None then false
  end
end

def switch_to_block(b: &mut MirBuilder, block: BlockId) -> Unit
  b.current_block = Option::Some(block)
end

def finish_function(b: &mut MirBuilder) -> Option[MirFunction]
  match b.current_fn
  when Option::Some(f) then
    # Collect all blocks from the map into the function's block list
    mut collected_blocks = Vec::new()
    mut idx = 0
    while idx < b.block_counter do
      match b.blocks.get(idx)
      when Option::Some(block) then
        collected_blocks.push(block.clone())
      when Option::None then ()
      end
      idx = idx + 1
    end
    f.blocks = collected_blocks
    let result = Option::Some(f)
    b.current_fn = Option::None
    b.current_block = Option::None
    b.blocks = Map::new()
    result
  when Option::None then
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# AST to MIR Lowering
# ———————————————————————————————————————————————————————————————

def lower_program(program: &Program) -> MirProgram
  mut b = builder_new()
  mut functions = Vec::new()
  mut statics = Vec::new()
  mut types = Vec::new()

  # Pre-populate enum variant map so lower_expr can resolve ExprKind::AstPath
  for item in program.items do
    match item.kind
    when ItemKind::Enum(e) then
      mut variant_names = Vec::new()
      for v in e.variants do
        variant_names.push(v.name.clone())
      end
      b.enum_variants.insert(e.name.clone(), variant_names)
    when _ then ()
    end
  end

  for item in program.items do
    match item.kind
    when ItemKind::Function(f) then
      match lower_function(&mut b, &f)
      when Option::Some(mir_fn) then
        functions.push(mir_fn)
      when Option::None then ()
      end
    when ItemKind::Static(s) then
      statics.push(lower_static(&mut b, &s))
    when ItemKind::Struct(s) then
      types.push(lower_struct_def(&s))
    when ItemKind::Enum(e) then
      types.push(lower_enum_def(&e))
    when ItemKind::ExternBlock(ext) then
      # Register extern function declarations.
      # These generate empty MIR functions with is_extern = true
      # so codegen emits proper relocations instead of function bodies.
      for ext_item in ext.items do
        match ext_item
        when ExternItem::Function(ef) then
          let abi_tag = match ext.abi
          when Option::Some(abi) then abi.clone()
          when Option::None then "C"
          end
          let extern_fn = lower_extern_fn(&mut b, &ef, abi_tag)
          functions.push(extern_fn)
        when ExternItem::Static(es) then
          statics.push(lower_extern_static(&es))
        end
      end
    when _ then ()
    end
  end
  
  # Emit any closures that were queued during lowering
  mut result = MirProgram { functions: functions, statics: statics, types: types }
  lower_pending_closures(&mut b, &mut result)

  result
end

def lower_function(b: &mut MirBuilder, f: &FunctionDecl) -> Option[MirFunction]
  # Resolve return type from AST
  let ret_type = match f.ret_type
  when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
  when Option::None then Type::Unit
  end

  start_function(b, f.name, ret_type, f.span)
  
  # Add parameters with resolved types
  for p in f.params do
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
    when Option::None then Type::Unit
    end
    add_param(b, p.name, ty, f.span)
  end
  
  # Lower contracts
  for c in f.contracts do
    lower_contract(b, &c)
  end
  
  # Lower body
  match f.body
  when FnBody::FnBlock(block) then
    if ret_type != Type::Unit && block.stmts.len() > 0 then
      # Lower all statements except the last
      mut i = 0
      while i < block.stmts.len() - 1 do
        lower_stmt(b, &block.stmts[i])
        i = i + 1
      end
      # Last statement: if expression, store to return place (local 0)
      let last_stmt = block.stmts[block.stmts.len() - 1]
      match last_stmt.kind
      when StmtKind::If(if_stmt) then
        # If/else as last statement: assign each branch result to return place (local 0)
        lower_if_to_place(b, &if_stmt, place_local(LocalId { id: 0 }), f.span)
      when StmtKind::Match(m) then
        # Match as last statement: assign each arm result to return place
        lower_match_to_place(b, &m, place_local(LocalId { id: 0 }), f.span)
      when StmtKind::Expr(expr) then
        match expr.kind
        when ExprKind::If(if_expr) then
          lower_if_to_place(b, &if_expr, place_local(LocalId { id: 0 }), f.span)
        when ExprKind::Match(m) then
          lower_match_to_place(b, &m, place_local(LocalId { id: 0 }), f.span)
        when _ then
          let result = lower_expr(b, &expr, f.span)
          push_stmt(b, MirStatementKind::MirAssign(place_local(LocalId { id: 0 }), MirRvalue {
            kind: MirRvalueKind::MirMove(result)
          }), f.span)
        end
      when _ then
        lower_stmt(b, &last_stmt)
      end
    else
      lower_block(b, &block)
    end
    # If no explicit return, add implicit return
    set_terminator(b, MirTerminatorKind::MirReturn, f.span)
  when FnBody::FnExpr(expr) then
    # For if/else expressions as function bodies, assign directly to return place
    if ret_type != Type::Unit then
      match expr.kind
      when ExprKind::If(if_expr) then
        lower_if_to_place(b, &if_expr, place_local(LocalId { id: 0 }), f.span)
      when _ then
        let result = lower_expr(b, &expr, f.span)
        push_stmt(b, MirStatementKind::MirAssign(place_local(LocalId { id: 0 }), MirRvalue {
          kind: MirRvalueKind::MirMove(result)
        }), f.span)
      end
    else
      let result = lower_expr(b, &expr, f.span)
    end
    set_terminator(b, MirTerminatorKind::MirReturn, f.span)
  when _ then
    set_terminator(b, MirTerminatorKind::MirReturn, f.span)
  end
  
  finish_function(b)
end

# Resolve a TypeExpr to a Type during MIR lowering
def resolve_lowering_type(ty_expr: &TypeExpr) -> Type
  match ty_expr.kind
  when TypeExprKind::Named(name, args) then
    if name == "Int" then Type::Int
    elsif name == "I8" then Type::I8
    elsif name == "I16" then Type::I16
    elsif name == "I32" then Type::I32
    elsif name == "I64" then Type::I64
    elsif name == "UInt" then Type::UInt
    elsif name == "U8" then Type::U8
    elsif name == "U16" then Type::U16
    elsif name == "U32" then Type::U32
    elsif name == "U64" then Type::U64
    elsif name == "Float" then Type::Float
    elsif name == "F32" then Type::F32
    elsif name == "F64" then Type::F64
    elsif name == "Bool" then Type::Bool
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "Unit" then Type::Unit
    elsif name == "Never" then Type::Never
    elsif name == "Option" && args.len() == 1 then
      Type::Option(resolve_lowering_type(&args[0]))
    elsif name == "Result" && args.len() == 2 then
      Type::Result(resolve_lowering_type(&args[0]), resolve_lowering_type(&args[1]))
    elsif name == "Vec" && args.len() == 1 then
      Type::Slice(resolve_lowering_type(&args[0]))
    elsif name == "Map" && args.len() == 2 then
      Type::Map(resolve_lowering_type(&args[0]), resolve_lowering_type(&args[1]))
    elsif name == "Set" && args.len() == 1 then
      Type::Set(resolve_lowering_type(&args[0]))
    else
      mut resolved_args = Vec::new()
      for a in args do
        resolved_args.push(resolve_lowering_type(&a))
      end
      Type::Named(TypeId { id: 0 }, resolved_args)
    end
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Tuple(elems) then
    mut types = Vec::new()
    for e in elems do
      types.push(resolve_lowering_type(&e))
    end
    Type::Tuple(types)
  when TypeExprKind::Array(elem, size_opt) then
    let elem_ty = resolve_lowering_type(&elem)
    let size = match size_opt
    when Option::Some(sz) then sz
    when Option::None then 0
    end
    Type::Array(elem_ty, size)
  when TypeExprKind::Slice(elem) then
    Type::Slice(resolve_lowering_type(&elem))
  when TypeExprKind::Ptr(inner) then
    Type::Ptr(resolve_lowering_type(&inner))
  when TypeExprKind::PtrMut(inner) then
    Type::PtrMut(resolve_lowering_type(&inner))
  when TypeExprKind::ExprRef(inner) then
    Type::Ref(resolve_lowering_type(&inner), lifetime_anonymous())
  when TypeExprKind::ExprRefMut(inner) then
    Type::RefMut(resolve_lowering_type(&inner), lifetime_anonymous())
  when TypeExprKind::Fn(params, ret) then
    mut param_types = Vec::new()
    for p in params do
      param_types.push(resolve_lowering_type(&p))
    end
    Type::Function(param_types, resolve_lowering_type(&ret))
  when TypeExprKind::Async(inner) then
    Type::Named(TypeId { id: 0 }, Vec::from([resolve_lowering_type(&inner)]))
  when TypeExprKind::Effect(effect_name, inner) then
    Type::Effect(Vec::from([effect_name]), resolve_lowering_type(&inner))
  when TypeExprKind::Path(path) then
    Type::Named(TypeId { id: 0 }, Vec::new())
  when TypeExprKind::Infer then Type::Unit
  when _ then Type::Unit
  end
end

def lower_static(b: &mut MirBuilder, s: &StaticDecl) -> MirStatic
  let resolved_ty = match s.ty
  when Option::Some(te) then resolve_lowering_type(&te)
  when Option::None then Type::Unit
  end

  let init_val = match s.init
  when Option::Some(expr) then
    let lowered = lower_expr(b, &expr, s.span)
    Option::Some(lowered)
  when Option::None then Option::None
  end

  MirStatic {
    name: s.name,
    ty: resolved_ty,
    init: init_val,
    is_mut: s.is_mut
  }
end

def lower_extern_fn(b: &mut MirBuilder, ef: &ExternFn, abi: String) -> MirFunction
  # Create an extern function declaration.
  # This has no body — codegen will emit a relocation against the symbol name.
  let entry = BlockId { id: 0 }
  
  mut params = Vec::new()
  mut local_id = 0
  for p in ef.params do
    let ty = resolve_lowering_type(&p.ty)
    params.push(MirLocal {
      id: LocalId { id: local_id },
      name: p.name.clone(),
      ty: ty,
      is_mut: false,
      span: ef.span
    })
    local_id = local_id + 1
  end
  
  let ret_type = match ef.ret_type
  when Option::Some(rt) then resolve_lowering_type(&rt)
  when Option::None then Type::Unit
  end
  
  # Mangle the name for Ruby ABI: prefix with _tg_rb_ for the thunk
  let mangled_name = if abi == "Ruby" then
    ef.name.clone()  # Keep original name — linker resolves against libruby
  else
    ef.name.clone()
  end
  
  MirFunction {
    name: mangled_name,
    params: params.clone(),
    ret_type: ret_type,
    locals: params,
    blocks: Vec::new(),    # Empty — no body for extern functions
    entry_block: entry,
    is_async: false,
    is_unsafe: true,       # Extern functions are always unsafe
    is_extern: true,
    extern_abi: abi,
    contracts: Vec::new(),
    span: ef.span
  }
end

def lower_extern_static(es: &ExternStatic) -> MirStatic
  MirStatic {
    name: es.name.clone(),
    ty: Type::Unit,
    init: Option::None,
    is_mut: es.is_mut
  }
end

def lower_struct_def(s: &StructDecl) -> MirTypeDef
  mut fields = Vec::new()
  mut offset = 0
  for f in s.fields do
    # Compute field size based on the declared type.
    # For primitive and pointer-width types, use their natural size.
    # For compound types, use pointer-width (8) as the default.
    let field_size = field_type_size(&f.ty)
    let field_align = field_size
    
    # Align the offset to the field's natural alignment
    if field_align > 0 then
      offset = ((offset + field_align - 1) / field_align) * field_align
    end
    
    fields.push(MirFieldDef {
      name: f.name,
      ty: Type::Unit,
      offset: offset
    })
    offset = offset + field_size
  end
  MirTypeDef {
    id: TypeId { id: 0 },
    name: s.name,
    kind: MirTypeDefKind::Struct(fields)
  }
end

# Compute the size of a field based on its declared type expression
def field_type_size(ty: &Option[TypeExpr]) -> Int
  match ty
  when Option::Some(tex) then
    match tex.kind
    when TypeExprKind::Named(name, args) then
      match name.as_str()
      when "Bool"    then 1
      when "u8"      then 1
      when "i8"      then 1
      when "Char"    then 4
      when "u16"     then 2
      when "i16"     then 2
      when "u32"     then 4
      when "i32"     then 4
      when "Float"   then 8
      when "f32"     then 4
      when "f64"     then 8
      when "Int"     then 8
      when "UInt"    then 8
      when "u64"     then 8
      when "i64"     then 8
      when "String"  then 24   # ptr + len + cap
      when "Vec"     then 24   # ptr + len + cap
      when "Map"     then 48   # buckets_ptr + len + cap + hash_fn + ...
      when "Set"     then 32   # inner_map + len
      when "Option"  then 16   # tag + value
      when "Result"  then 24   # tag + value + error
      when "Box"     then 8    # single pointer
      when "Ptr"     then 8    # raw pointer
      when _ then 8            # User-defined structs: pointer-width default
      end
    when TypeExprKind::ExprRef(_) then 8       # reference = pointer
    when TypeExprKind::ExprRefMut(_) then 8    # mutable reference = pointer
    when TypeExprKind::Tuple(elems) then
      # Sum of element sizes
      mut total = 0
      for elem in elems do
        total = total + 8  # Each tuple element at least pointer-width
      end
      if total == 0 then 0 else total end  # () = 0 bytes
    when TypeExprKind::Array(elem, size) then
      8 * size  # Simplified: each element is pointer-width
    when TypeExprKind::Fn(_, _) then 16   # fn pointer + closure env pointer
    when TypeExprKind::Unit then 0
    when TypeExprKind::Never then 0
    when _ then 8
    end
  when Option::None then 8   # Unknown type defaults to pointer-width
  end
end

def lower_enum_def(e: &EnumDecl) -> MirTypeDef
  mut variants = Vec::new()
  mut disc = 0
  for v in e.variants do
    # Use explicit discriminant from AST if provided (supports negative values)
    match v.discriminant
    when Option::Some(expr) then
      match expr.kind
      when ExprKind::IntLit(n) then disc = n
      when ExprKind::UnaryOp(UnaryOp::Neg, inner) then
        match inner.kind
        when ExprKind::IntLit(n) then disc = 0 - n
        when _ then ()
        end
      when _ then ()
      end
    when Option::None then ()
    end
    # Lower variant payload type expressions to Types
    mut lowered_fields = Vec::new()
    for field_ty_expr in v.fields do
      lowered_fields.push(resolve_lowering_type(&field_ty_expr))
    end
    variants.push(MirVariantDef {
      name: v.name,
      discriminant: disc,
      fields: lowered_fields
    })
    disc = disc + 1
  end
  MirTypeDef {
    id: TypeId { id: 0 },
    name: e.name,
    kind: MirTypeDefKind::Enum(variants)
  }
end

def lower_contract(b: &mut MirBuilder, c: &ContractClause) -> Unit
  # Lower contract condition to a runtime assertion
  let cond_op = lower_expr(b, &c.condition, c.span)
  let cond_place = Place { local: LocalId { id: 0 }, projections: Vec::new() }
  let msg = match c.message
  when Option::Some(m) then m
  when Option::None then
    match c.kind
    when AstContractKind::AstPre then "precondition failed"
    when AstContractKind::AstPost then "postcondition failed"
    when AgContractKind::AgInvariant then "invariant violated"
    end
  end

  match c.kind
  when AstContractKind::AstPre then
    # Pre-conditions: check at function entry
    push_stmt(b, MirStatementKind::MirContractCheck(
      MirContract { kind: AstContractKind::AstPre, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  when AstContractKind::AstPost then
    # Post-conditions are deferred to function exit — record for epilogue
    push_stmt(b, MirStatementKind::MirContractCheck(
      MirContract { kind: AstContractKind::AstPost, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  when AgContractKind::AgInvariant then
    push_stmt(b, MirStatementKind::MirContractCheck(
      MirContract { kind: AgContractKind::AgInvariant, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  end
end

def lower_block(b: &mut MirBuilder, block: &Block) -> Unit
  for stmt in block.stmts do
    lower_stmt(b, &stmt)
  end
end

def mir_infer_expr_type(expr: &Expr) -> Type
  match expr.kind
  when ExprKind::IntLit(_)    then Type::Int
  when ExprKind::FloatLit(_)  then Type::Float
  when ExprKind::BoolLit(_)   then Type::Bool
  when ExprKind::StringLit(_) then Type::String
  when ExprKind::CharLit(_)   then Type::Char
  when ExprKind::NilLit       then Type::Unit
  when ExprKind::BinaryOp(_, lhs, _) then mir_infer_expr_type(lhs)
  when ExprKind::UnaryOp(_, inner)    then mir_infer_expr_type(inner)
  when ExprKind::Cast(_, target_ty) then resolve_lowering_type(&target_ty)
  when ExprKind::ArrayLit(elems) then
    if elems.len() > 0 then
      Type::Array(mir_infer_expr_type(&elems[0]))
    else
      Type::Array(Type::Unit)
    end
  when ExprKind::TupleLit(elems) then
    mut tys = Vec::new()
    for e in elems do
      tys.push(mir_infer_expr_type(&e))
    end
    Type::Tuple(tys)
  when ExprKind::ExprRef(inner)   then Type::Ref(mir_infer_expr_type(inner), lifetime_static())
  when ExprKind::ExprRefMut(inner) then Type::RefMut(mir_infer_expr_type(inner), lifetime_static())
  when ExprKind::ExprDeref(inner) then
    match mir_infer_expr_type(inner)
    when Type::Ref(t, _)    then t
    when Type::RefMut(t, _) then t
    when other              then other
    end
  when ExprKind::If(cond, then_expr, else_opt) then
    mir_infer_expr_type(then_expr)
  when ExprKind::Block(block) then
    if block.stmts.len() > 0 then
      let last = &block.stmts[block.stmts.len() - 1]
      match last.kind
      when StmtKind::Expr(e) then mir_infer_expr_type(&e)
      when _ then Type::Unit
      end
    else
      Type::Unit
    end
  when ExprKind::ExprCall(_, _)              then Type::Unit
  when ExprKind::MethodCall(_, _, _, _)  then Type::Unit
  when ExprKind::Match(scrutinee, arms) then
    if arms.len() > 0 then
      mir_infer_expr_type(&arms[0].body)
    else
      Type::Unit
    end
  when ExprKind::Match(_)                then Type::Unit
  when ExprKind::ExprClosure(_, _, _)        then Type::Unit
  when ExprKind::Ident(_)                then Type::Unit
  when ExprKind::SelfRef                  then Type::Unit
  when ExprKind::Path(_)                  then Type::Unit
  when ExprKind::ExprMove(inner)             then mir_infer_expr_type(inner)
  when ExprKind::ExprCopy(inner)             then mir_infer_expr_type(inner)
  when ExprKind::Await(inner)            then Type::Unit
  when ExprKind::Try(inner)              then mir_infer_expr_type(inner)
  when _                                 then Type::Unit
  end
end

def lower_pattern_assignment(b: &mut MirBuilder, pat: &Pattern, rvalue: MirRvalue, span: Span) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    let ty = Type::Int # TODO: Correct type inference
    let local_id = add_local(b, name.clone(), ty, is_mut, span)
    push_assign(b, place_local(local_id), rvalue, span)
  when PatternKind::Tuple(pats) then
    let temp = add_temp(b, Type::Unit, span) # TODO: Correct type
    push_assign(b, place_local(temp), rvalue, span)
    mut idx = 0
    for p in pats do
      mut projs = Vec::new()
      projs.push(Projection::ProjField(idx))
      let field_place = Place { local: temp, projections: projs }
      lower_pattern_assignment(b, &p, MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirCopy(field_place) }) }, span)
      idx = idx + 1
    end
  when PatternKind::Wildcard then ()
  when _ then ()
  end
end

def lower_stmt(b: &mut MirBuilder, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::Let(pattern, ty_opt, value, is_mut) then
    let rvalue = lower_expr_to_rvalue(b, &value, stmt.span)
    lower_pattern_assignment(b, &pattern, rvalue, stmt.span)
    
  when StmtKind::Assign(target, value) then
    let place = lower_place(b, &target)
    let rvalue = lower_expr_to_rvalue(b, &value, stmt.span)
    push_assign(b, place, rvalue, stmt.span)
    
  when StmtKind::If(if_stmt) then
    lower_if(b, &if_stmt, stmt.span)
    
  when StmtKind::While(cond, body) then
    lower_while(b, &cond, &body, stmt.span)
    
  when StmtKind::For(var, iter, body) then
    lower_for(b, var, &iter, &body, stmt.span)
    
  when StmtKind::Return(val_opt) then
    match val_opt
    when Option::Some(val) then
      let operand = lower_expr(b, &val, stmt.span)
      push_stmt(b, MirStatementKind::MirAssign(place_local(LocalId { id: 0 }), MirRvalue {
        kind: MirRvalueKind::MirMove(operand)
      }), stmt.span)
    when Option::None then ()
    end
    set_terminator(b, MirTerminatorKind::MirReturn, stmt.span)
    
  when StmtKind::Expr(expr) then
    lower_expr(b, &expr, stmt.span)
    
  when StmtKind::Match(m) then
    lower_match(b, &m, stmt.span)
    
  when StmtKind::Break(val_opt) then
    match b.break_target
    when Option::Some(target) then
      set_terminator(b, MirTerminatorKind::MirGoto(target), stmt.span)
    when Option::None then ()
    end
    
  when StmtKind::Continue then
    match b.continue_target
    when Option::Some(target) then
      set_terminator(b, MirTerminatorKind::MirGoto(target), stmt.span)
    when Option::None then ()
    end
    
  when StmtKind::Loop(body) then
    lower_loop(b, &body, stmt.span)
    
  when StmtKind::CompoundAssign(op, target, value) then
    let place = lower_place(b, &target)
    let lhs_operand = lower_expr(b, &target, stmt.span)
    let rhs_operand = lower_expr(b, &value, stmt.span)
    let mir_op = lower_binop(op)
    let rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(mir_op, lhs_operand, rhs_operand) }
    push_assign(b, place, rvalue, stmt.span)
    
  when _ then ()
  end
end

def lower_expr(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirOperand
  let rvalue = lower_expr_to_rvalue(b, expr, span)
  
  # Create temp and assign
  let temp = add_temp(b, mir_infer_expr_type(expr), span)
  push_assign(b, place_local(temp), rvalue, span)
  
  MirOperand { kind: MirOperandKind::MirCopy(place_local(temp)) }
end

def lower_expr_to_rvalue(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirRvalue
  match expr.kind
  when ExprKind::IntLit(n) then
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirInt(n),
        ty: Type::Int
      })
    }) }
  when ExprKind::FloatLit(f) then
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFloat(f),
        ty: Type::Float
      })
    }) }
  when ExprKind::BoolLit(b) then
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirBool(b),
        ty: Type::Bool
      })
    }) }
  when ExprKind::StringLit(s) then
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirString(s),
        ty: Type::String
      })
    }) }
  when ExprKind::Ident(name) then
    match b.var_map.get(name)
    when Option::Some(local_id) then
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(place_local(local_id))
      }) }
    when Option::None then
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirUnit,
          ty: Type::Unit
        })
      }) }
    end
  when ExprKind::BinaryOp(op, left, right) then
    let left_op = lower_expr(b, &left, span)
    let right_op = lower_expr(b, &right, span)
    let mir_op = lower_binop(op)
    MirRvalue { kind: MirRvalueKind::MirBinOp(mir_op, left_op, right_op) }
  when ExprKind::UnaryOp(op, inner) then
    let inner_op = lower_expr(b, &inner, span)
    let mir_op = lower_unop(op)
    MirRvalue { kind: MirRvalueKind::MirUnOp(mir_op, inner_op) }
  when ExprKind::ExprRef(inner) then
    let place = lower_place(b, &inner)
    MirRvalue { kind: MirRvalueKind::MirRef(place) }
  when ExprKind::ExprRefMut(inner) then
    let place = lower_place(b, &inner)
    MirRvalue { kind: MirRvalueKind::MirRefMut(place) }
  when ExprKind::ExprDeref(inner) then
    let inner_op = lower_expr(b, &inner, span)
    # Would project deref
    MirRvalue { kind: MirRvalueKind::MirMove(inner_op) }
  when ExprKind::ArrayLit(elems) then
    mut ops = Vec::new()
    for e in elems do
      ops.push(lower_expr(b, &e, span))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::MirArray(Type::Unit), ops) }
  when ExprKind::TupleLit(elems) then
    mut ops = Vec::new()
    for e in elems do
      ops.push(lower_expr(b, &e, span))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple, ops) }

  when ExprKind::ExprCall(callee_expr, arg_exprs) then
    # Lower callee to a function operand
    let callee_op = lower_call_callee(b, &callee_expr, span)
    
    # Lower arguments
    mut mir_args = Vec::new()
    for a in arg_exprs do
      mir_args.push(lower_expr(b, &a, span))
    end
    
    # Allocate a temp for the return value (must be non-Unit so it gets a register)
    let ret_tmp = add_temp(b, Type::Int, span)
    let dest_place = place_local(ret_tmp)
    
    # Create success continuation block
    let success_blk = create_block(b)
    
    # Emit Call terminator in current block
    set_terminator(b, MirTerminatorKind::MirCall(
      dest_place,
      callee_op,
      mir_args,
      success_blk,
      Option::None
    ), span)
    
    # Switch to the success block
    b.current_block = Option::Some(success_blk)
    
    # The result is the destination local
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(place_local(ret_tmp))
    }) }

  when ExprKind::MethodCall(receiver, method_name, type_args, arg_exprs) then
    # Lower receiver
    let recv_op = lower_expr(b, &receiver, span)
    
    # Build callee as FnItem with receiver_type.method_name
    # For method calls the callee is a synthetic function name
    let callee_op = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem(method_name.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
    
    # Lower arguments: receiver first, then explicit args
    mut mir_args = Vec::new()
    mir_args.push(recv_op)
    for a in arg_exprs do
      mir_args.push(lower_expr(b, &a, span))
    end
    
    # Allocate return temp (must be non-Unit so it gets a register)
    let ret_tmp = add_temp(b, Type::Int, span)
    let dest_place = place_local(ret_tmp)
    
    # Create success block
    let success_blk = create_block(b)
    
    # Emit Call terminator
    set_terminator(b, MirTerminatorKind::MirCall(
      dest_place,
      callee_op,
      mir_args,
      success_blk,
      Option::None
    ), span)
    
    b.current_block = Option::Some(success_blk)
    
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(place_local(ret_tmp))
    }) }

  when ExprKind::FieldAccess(recv, field_name) then
    let base_place = lower_place(b, &recv)
    # Resolve field index — use a simple lookup for common types
    let field_idx = match resolve_field_index(field_name)
    when Option::Some(idx) then idx
    when Option::None then panic("MIR lowering: unknown field access: " + field_name.clone())
    end
    mut new_projections = base_place.projections.clone()
    new_projections.push(Projection::ProjField(field_name, field_idx))
    let projected = Place {
      local: base_place.local,
      projections: new_projections
    }
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(projected)
    }) }

  when ExprKind::Index(base_expr, index_expr) then
    let base_place = lower_place(b, &base_expr)
    let idx_op = lower_expr(b, &index_expr, span)
    # Store index into a temp so we can reference it as a LocalId
    let idx_tmp = add_temp(b, Type::Int, span)
    push_stmt(b, MirStatementKind::MirAssign(place_local(idx_tmp), MirRvalue {
      kind: MirRvalueKind::MirMove(idx_op)
    }), span)
    mut new_projections = base_place.projections.clone()
    new_projections.push(Projection::ProjIndex(idx_tmp))
    let projected = Place {
      local: base_place.local,
      projections: new_projections
    }
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(projected)
    }) }

  when ExprKind::ExprClosure(params, ret_ty, body) then
    # Full closure lowering with capture analysis and environment generation.
    # 
    # 1. Analyze the closure body to find all free variables (captures)
    # 2. Create an environment struct holding captured values
    # 3. Generate a separate function taking the env as first parameter
    # 4. Return a closure aggregate (fn_ptr + env_ptr)
    
    let closure_name = "_closure" + b.temp_counter.to_string()
    b.temp_counter = b.temp_counter + 1
    
    # Step 1: Capture analysis — find free variables in body
    let captures = analyze_captures(&body, &params, &b.var_map)
    
    # Step 2: Build captured operands from the current scope
    mut capture_ops = Vec::new()
    for cap_name in captures do
      match b.var_map.get(cap_name)
      when Option::Some(local_id) then
        capture_ops.push(MirOperand {
          kind: MirOperandKind::MirCopy(place_local(local_id))
        })
      when Option::None then
        # Captured variable not found — use Unit placeholder
        capture_ops.push(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirUnit,
            ty: Type::Unit
          })
        })
      end
    end
    
    # Step 3: Build the closure function's parameter types
    mut param_types = Vec::new()
    for p in params do
      match p.ty
      when Option::Some(ty) then param_types.push(resolve_lowering_type(&ty))
      when Option::None then param_types.push(Type::Unit)
      end
    end
    
    let ret_type = match ret_ty
    when Option::Some(ty) then resolve_lowering_type(&ty)
    when Option::None then Type::Unit
    end
    
    # Step 4: Record the closure body to be lowered as a separate MirFunction
    # (This would be processed after the containing function)
    b.pending_closures.push(PendingClosure {
      name: closure_name.clone(),
      params: params.clone(),
      captures: captures.clone(),
      body: body.clone(),
      ret_type: ret_type.clone()
    })
    
    # Step 5: Create the closure aggregate — (fn_ptr, env)
    let fn_op = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem(closure_name.clone()),
        ty: Type::Function(param_types.clone(), Box::new(ret_type.clone()))
      })
    }
    
    mut agg_ops = Vec::new()
    agg_ops.push(fn_op)
    for cap_op in capture_ops do
      agg_ops.push(cap_op)
    end
    
    let closure_type_id = TypeId { id: b.temp_counter }
    b.temp_counter = b.temp_counter + 1
    
    MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Closure(closure_type_id), agg_ops) }

  when ExprKind::If(if_expr) then
    lower_if_rvalue(b, &if_expr, span)

  when ExprKind::Block(stmts, tail) then
    for s in stmts do
      lower_stmt(b, s)
    end
    match tail
    when Option::Some(expr) then
      lower_expr_to_rvalue(b, &expr, span)
    when Option::None then
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirUnit,
          ty: Type::Unit
        })
      }) }
    end

  when ExprKind::StructLit(path, fields) then
    # Lower struct literal as Aggregate
    mut ops = Vec::new()
    mut field_names = Vec::new()
    for f in fields do
      field_names.push(f.name.clone())
      ops.push(lower_expr(b, &f.value, span))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(TypeId { id: 0 }, field_names), ops) }

  when ExprKind::EnumVariant(path, variant, args) then
    # Lower enum variant as Aggregate with downcast
    mut ops = Vec::new()
    mut field_names = Vec::new()
    for i in 0..args.len() do
      field_names.push(i.to_string())
    end
    for a in args do
      ops.push(lower_expr(b, &a, span))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(TypeId { id: 0 }, field_names), ops) }

  when ExprKind::Cast(inner, target_ty) then
    let inner_op = lower_expr(b, &inner, span)
    let target = resolve_lowering_type(&target_ty)
    # Use Transmute as the generic cast kind - specific casts would require type inference
    MirRvalue { kind: MirRvalueKind::MirCast(CastKind::Transmute, inner_op, target) }

  when ExprKind::Return(inner) then
    let ret_op = lower_expr(b, &inner, span)
    push_stmt(b, MirStatementKind::MirAssign(place_local(LocalId { id: 0 }), MirRvalue {
      kind: MirRvalueKind::MirMove(ret_op)
    }), span)
    set_terminator(b, MirTerminatorKind::MirReturn, span)
    # Unreachable after return — create a dead block
    let dead_blk = create_block(b)
    b.current_block = Option::Some(dead_blk)
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirUnit,
        ty: Type::Never
      })
    }) }

  when ExprKind::Path(path) then
    # Resolve enum variant paths like Operator::None to their discriminant
    if path.segments.len() >= 2 then
      let enum_name = path.segments[path.segments.len() - 2]
      let variant_name = path.segments[path.segments.len() - 1]
      match b.enum_variants.get(enum_name)
      when Option::Some(variants) then
        mut disc = 0
        mut found = false
        for v in variants do
          if v == variant_name then
            found = true
            break
          end
          disc = disc + 1
        end
        if found then
          MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirInt(disc),
              ty: Type::Int
            })
          }) }
        else
          MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirUnit,
              ty: Type::Unit
            })
          }) }
        end
      when Option::None then
        MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirUnit,
            ty: Type::Unit
          })
        }) }
      end
    else
      MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirUnit,
          ty: Type::Unit
        })
      }) }
    end

  when ExprKind::Match(m) then
    # Lower match as expression: assign each arm result to a temp
    let result_tmp = add_temp(b, Type::Int, span)
    lower_match_to_place(b, &m, place_local(result_tmp), span)
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(place_local(result_tmp))
    }) }

  when _ then
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirUnit,
        ty: Type::Unit
      })
    }) }
  end
end

def lower_place(b: &mut MirBuilder, expr: &Expr) -> Place
  match expr.kind
  when ExprKind::Ident(name) then
    match b.var_map.get(name)
    when Option::Some(local_id) then
      place_local(local_id)
    when Option::None then
      place_local(LocalId { id: 0 })
    end
  when ExprKind::FieldAccess(recv, field) then
    let base = lower_place(b, &recv)
    place_field(base, field, 0)
  when ExprKind::ExprDeref(inner) then
    let base = lower_place(b, &inner)
    place_deref(base)
  when ExprKind::Index(recv, index) then
    let base = lower_place(b, &recv)
    # Would add index projection
    base
  when _ then
    place_local(LocalId { id: 0 })
  end
end

# Helper: lower a callee expression to a MirOperand for Call
def lower_call_callee(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirOperand
  match expr.kind
  when ExprKind::Ident(name) then
    # Direct function call by name
    MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem(name.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
  when ExprKind::FieldAccess(recv, field) then
    # Qualified path like Module.func — use the field as function name
    MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem(field.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
  when _ then
    # Indirect call through expression (function pointer / closure)
    lower_expr(b, expr, span)
  end
end

# Helper: resolve struct field name to its index within the struct layout.
# Uses receiver type info from the builder to find the correct field position.
# For well-known built-in types, this returns hardcoded offsets.
# For user-defined types, we look through the lowered type definitions.
def resolve_field_index(name: &String) -> Option[Int]
  # Well-known struct fields with fixed layout:
  
  # Vec[T]: { ptr: 0, len: 1, cap: 2 }
  if name == "ptr" then return Option::Some(0) end
  if name == "len" || name == "length" then return Option::Some(1) end
  if name == "cap" || name == "capacity" then return Option::Some(2) end
  
  # String: { ptr: 0, len: 1, cap: 2 } (same layout as Vec[u8])
  
  # Map[K,V]: { buckets: 0, len: 1, cap: 2, hash_fn: 3= }
  if name == "buckets" then return Option::Some(0) end
  if name == "hash_fn" then return Option::Some(3) end

  # Set[T]: { map: 0, len: 1 }
  if name == "map" then return Option::Some(0) end

  # Option[T]: { tag: 0, value: 1 }
  # Result[T,E]: { tag: 0, value: 1, error: 2 }
  if name == "tag" || name == "discriminant" then return Option::Some(0) end
  if name == "value" || name == "val" then return Option::Some(1) end
  if name == "error" || name == "err" then return Option::Some(2) end
  
  # Common struct fields (conventional ordering)
  if name == "name" then return Option::Some(0) end
  if name == "id" then return Option::Some(0) end
  if name == "kind" then return Option::Some(0) end
  if name == "data" then return Option::Some(0) end
  if name == "ty" || name == "type" then return Option::Some(1) end
  if name == "span" then return Option::Some(2) end
  if name == "is_mut" then return Option::Some(3) end
  
  # File: { fd: 0, path: 1, is_open: 2 }
  if name == "fd" then return Option::Some(0) end
  if name == "path" then return Option::Some(1) end
  if name == "is_open" then return Option::Some(2) end
  
  # RubyValue / Ptr: { raw/address: 0 }
  if name == "raw" then return Option::Some(0) end
  if name == "address" then return Option::Some(0) end
  
  # Unknown field: return None so caller cannot treat it as a valid offset.
  Option::None
end

# Helper: convert a Path to a String (dot-separated components)
def path_to_string(path: &AstPath) -> String
  mut result = ""
  mut first = true
  for seg in path.segments do
    if !first then
      result = result + "::"
    end
    result = result + seg.name
    first = false
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Closure Capture Analysis
# ———————————————————————————————————————————————————————————————

def collect_names_from_pattern(pat: &Pattern, names: &mut Set[String]) -> Unit
  match pat.kind
  when PatternKind::Ident(name, _) then names.insert(name.clone())
  when PatternKind::Tuple(pats) then
    for p in pats do collect_names_from_pattern(&p, names) end
  when PatternKind::Array(pats) then
    for p in pats do collect_names_from_pattern(&p, names) end
  when PatternKind::Struct(_, fields) then
    for field in fields.entries() do collect_names_from_pattern(&field.1, names) end
  when PatternKind::Variant(_, pats) then
    for p in pats do collect_names_from_pattern(&p, names) end
  when PatternKind::Or(pats) then
    for p in pats do collect_names_from_pattern(&p, names) end
  when PatternKind::Ref(inner) then collect_names_from_pattern(&inner, names)
  when PatternKind::RefMut(inner) then collect_names_from_pattern(&inner, names)
  when _ then ()
  end
end

def analyze_captures(body: &Expr, params: &Vec[ClosureParam], scope: &Map[String, LocalId]) -> Vec[String]
  # Find all free variables in the closure body that are:
  #   1. Not closure parameters
  #   2. Available in the enclosing scope (var_map)
  # Returns the list of captured variable names.
  
  mut free_vars = Set::new()
  mut bound_vars = Set::new()
  
  # Closure parameters are bound in the body
  for p in params do
    collect_names_from_pattern(&p.pat, &mut bound_vars)
  end
  
  # Walk the expression tree to find free variable references
  collect_free_vars(body, &mut free_vars, &bound_vars)
  
  # Filter to only those that exist in the enclosing scope
  mut captures = Vec::new()
  for name in free_vars do
    if scope.contains_key(name) then
      captures.push(name.clone())
    end
  end
  
  captures
end

def collect_free_vars(expr: &Expr, free: &mut Set[String], bound: &Set[String]) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    if !bound.contains(name) then
      free.insert(name.clone())
    end
  when ExprKind::BinaryOp(_, left, right) then
    collect_free_vars(&left, free, bound)
    collect_free_vars(&right, free, bound)
  when ExprKind::UnaryOp(_, inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::ExprCall(callee, args) then
    collect_free_vars(&callee, free, bound)
    for a in args do
      collect_free_vars(&a, free, bound)
    end
  when ExprKind::MethodCall(recv, _, _, args) then
    collect_free_vars(&recv, free, bound)
    for a in args do
      collect_free_vars(&a, free, bound)
    end
  when ExprKind::FieldAccess(recv, _) then
    collect_free_vars(&recv, free, bound)
  when ExprKind::Index(base, idx) then
    collect_free_vars(&base, free, bound)
    collect_free_vars(&idx, free, bound)
  when ExprKind::ExprRef(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::ExprRefMut(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::ExprDeref(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::ArrayLit(elems) then
    for e in elems do
      collect_free_vars(&e, free, bound)
    end
  when ExprKind::TupleLit(elems) then
    for e in elems do
      collect_free_vars(&e, free, bound)
    end
  when ExprKind::If(if_expr) then
    collect_free_vars(&if_expr.cond, free, bound)
    for s in if_expr.then_block.stmts do
      collect_free_vars_stmt(&s, free, bound)
    end
    match if_expr.else_block
    when Option::Some(else_body) then
      for s in else_body.stmts do
        collect_free_vars_stmt(&s, free, bound)
      end
    when Option::None then ()
    end
  when ExprKind::ExprClosure(inner_params, _, inner_body) then
    # Nested closure — its parameters shadow in the inner scope
    mut inner_bound = bound.clone()
    for p in inner_params do
      collect_names_from_pattern(&p.pat, &mut inner_bound)
    end
    collect_free_vars(&inner_body, free, &inner_bound)
  when _ then ()
  end
end

def collect_free_vars_stmt(stmt: &Stmt, free: &mut Set[String], bound: &Set[String]) -> Unit
  match stmt.kind
  when StmtKind::Let(_, _, value, _) then
    collect_free_vars(&value, free, bound)
  when StmtKind::Expr(expr) then
    collect_free_vars(&expr, free, bound)
  when StmtKind::Assign(target, value) then
    collect_free_vars(&target, free, bound)
    collect_free_vars(&value, free, bound)
  when StmtKind::Return(expr) then
    match expr
    when Option::Some(e) then collect_free_vars(&e, free, bound)
    when Option::None then ()
    end
  when _ then ()
  end
end

# Lower all pending closures into separate MirFunctions
def lower_pending_closures(b: &mut MirBuilder, program: &mut MirProgram) -> Unit
  let closures = b.pending_closures.clone()
  b.pending_closures = Vec::new()

  for closure in closures do
    # Save current builder state
    let saved_fn = b.current_fn.clone()
    let saved_block = b.current_block.clone()
    let saved_locals = b.local_counter
    let saved_blocks = b.block_counter
    let saved_vars = b.var_map.clone()
    let saved_block_map = b.blocks.clone()

    let closure_span = closure.body.span

    # Start a new function for the closure
    start_function(b, closure.name.clone(), closure.ret_type.clone(), closure_span)

    # Add captured variables as implicit leading parameters
    for cap_name in closure.captures do
      add_param(b, cap_name.clone(), Type::Unit, closure_span)
    end

    # Add explicit closure parameters
    for p in closure.params do
      let ty = match p.ty
      when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
      when Option::None then Type::Unit
      end
      add_param(b, p.name.clone(), ty, p.span)
    end

    # Lower the closure body
    let body_rvalue = lower_expr_to_rvalue(b, &closure.body, closure_span)
    let ret_place = place_local(LocalId { id: 0 })
    push_stmt(b, MirStatementKind::MirAssign(ret_place, body_rvalue), closure_span)
    set_terminator(b, MirTerminatorKind::MirReturn, closure_span)

    # Finish and add to program
    let closure_fn = finish_function(b)
    program.functions.push(closure_fn)

    # Restore builder state
    b.current_fn = saved_fn
    b.current_block = saved_block
    b.local_counter = saved_locals
    b.block_counter = saved_blocks
    b.var_map = saved_vars
    b.blocks = saved_block_map
  end
end

# Helper: lower if expression as rvalue (returns its value)
def lower_if_rvalue(b: &mut MirBuilder, if_expr: &IfStmt, span: Span) -> MirRvalue
  # Create a result temp and use lower_if_to_place to assign into it
  let result_tmp = add_temp(b, Type::Int, span)
  lower_if_to_place(b, if_expr, place_local(result_tmp), span)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(result_tmp))
  }) }
end

# Helper: assign the result of an expression directly into dest.
# For nested if expressions, calls lower_if_to_place directly with dest
# to avoid intermediate temps and a sequential push_stmt after lower_expr.
def lower_expr_assign_to(b: &mut MirBuilder, expr: &Expr, dest: Place, span: Span) -> Unit
  match expr.kind
  when ExprKind::If(nested_if) then
    # Nested if: pass our dest directly — branches assign to dest
    lower_if_to_place(b, &nested_if, dest, span)
  when ExprKind::Match(m) then
    # Nested match: pass our dest directly — arms assign to dest
    lower_match_to_place(b, &m, dest, span)
  when _ then
    # Non-if: lower to rvalue and assign in one step
    let rvalue = lower_expr_to_rvalue(b, expr, span)
    push_assign(b, dest, rvalue, span)
  end
end

# Lower an if/else expression, assigning the result of each branch
# directly into `dest`. After this call, b.current_block is the merge block.
def lower_if_to_place(b: &mut MirBuilder, if_expr: &IfStmt, dest: Place, span: Span) -> Unit
  let cond_op = lower_expr(b, &if_expr.cond, span)
  let then_blk = create_block(b)
  let else_blk = create_block(b)
  let merge_blk = create_block(b)

  # Branch on condition
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: else_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt(cond_op, targets, then_blk), span)

  # Then branch — lower all stmts, last expression value goes to dest
  b.current_block = Option::Some(then_blk)
  let then_stmts = if_expr.then_block.stmts
  if then_stmts.len() > 0 then
    # Lower all but last stmt normally
    mut ti = 0
    while ti < then_stmts.len() - 1 do
      lower_stmt(b, &then_stmts[ti])
      ti = ti + 1
    end
    # Last stmt: evaluate and assign to dest
    let last_then = then_stmts[then_stmts.len() - 1]
    match last_then.kind
    when StmtKind::Expr(expr) then
      lower_expr_assign_to(b, &expr, dest, span)
    when StmtKind::If(nested_if) then
      lower_if_to_place(b, &nested_if, dest, span)
    when _ then
      lower_stmt(b, &last_then)
    end
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  end

  # Else branch — lower all stmts, last expression value goes to dest
  b.current_block = Option::Some(else_blk)
  match if_expr.else_block
  when Option::Some(else_body) then
    let else_stmts = else_body.stmts
    if else_stmts.len() > 0 then
      mut ei = 0
      while ei < else_stmts.len() - 1 do
        lower_stmt(b, &else_stmts[ei])
        ei = ei + 1
      end
      let last_else = else_stmts[else_stmts.len() - 1]
      match last_else.kind
      when StmtKind::Expr(expr) then
        lower_expr_assign_to(b, &expr, dest, span)
      when StmtKind::If(nested_if) then
        lower_if_to_place(b, &nested_if, dest, span)
      when _ then
        lower_stmt(b, &last_else)
      end
    end
  when Option::None then ()
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  end

  # Continue from merge
  b.current_block = Option::Some(merge_blk)
end

# Helper: lower a statement and return its value as MirRvalue
def lower_stmt_rvalue(b: &mut MirBuilder, stmt: &Stmt, span: Span) -> MirRvalue
  match stmt.kind
  when StmtKind::Expr(expr) then
    lower_expr_to_rvalue(b, &expr, span)
  when _ then
    lower_stmt(b, stmt)
    MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirUnit,
        ty: Type::Unit
      })
    }) }
  end
end

def lower_binop(op: BinOp) -> MirBinOp
  match op
  when BinOp::Add then MirBinOp::Add
  when BinOp::Sub then MirBinOp::Sub
  when BinOp::Mul then MirBinOp::Mul
  when BinOp::Div then MirBinOp::Div
  when BinOp::Mod then MirBinOp::Mod
  when BinOp::Eq then MirBinOp::Eq
  when BinOp::Ne then MirBinOp::Ne
  when BinOp::Lt then MirBinOp::Lt
  when BinOp::Le then MirBinOp::Le
  when BinOp::Gt then MirBinOp::Gt
  when BinOp::Ge then MirBinOp::Ge
  when BinOp::BitAnd then MirBinOp::BitAnd
  when BinOp::BitOr then MirBinOp::BitOr
  when BinOp::BitXor then MirBinOp::BitXor
  when BinOp::Shl then MirBinOp::Shl
  when BinOp::Shr then MirBinOp::Shr
  when _ then MirBinOp::Add
  end
end

def lower_unop(op: UnOp) -> MirUnOp
  match op
  when UnOp::Neg then MirUnOp::Neg
  when UnOp::Not then MirUnOp::Not
  when UnOp::BitNot then MirUnOp::BitNot
  end
end

def lower_if(b: &mut MirBuilder, if_stmt: &IfStmt, span: Span) -> Unit
  let then_block = create_block(b)
  let else_block = create_block(b)
  let join_block = create_block(b)
  
  let cond = lower_expr(b, &if_stmt.cond, span)
  
  # Switch on condition
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: else_block })
  set_terminator(b, MirTerminatorKind::MirSwitchInt(cond, targets, then_block), span)
  
  # Then block
  switch_to_block(b, then_block)
  lower_block(b, &if_stmt.then_block)
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
  end
  
  # Else block
  switch_to_block(b, else_block)
  match if_stmt.else_block
  when Option::Some(eb) then lower_block(b, &eb)
  when Option::None then ()
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
  end
  
  switch_to_block(b, join_block)
end

def lower_while(b: &mut MirBuilder, cond: &Expr, body: &Block, span: Span) -> Unit
  let header = create_block(b)
  let body_block = create_block(b)
  let exit_block = create_block(b)
  
  # Save and set break/continue targets
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_block)
  b.continue_target = Option::Some(header)
  
  set_terminator(b, MirTerminatorKind::MirGoto(header), span)

  switch_to_block(b, header)
  let cond_op = lower_expr(b, cond, span)
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_block })
  set_terminator(b, MirTerminatorKind::MirSwitchInt(cond_op, targets, body_block), span)

  switch_to_block(b, body_block)
  lower_block(b, body)
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(header), span)
  end
  
  # Restore break/continue targets
  b.break_target = old_break
  b.continue_target = old_continue
  
  switch_to_block(b, exit_block)
end

def lower_for(b: &mut MirBuilder, pat: Pattern, iter: &Expr, body: &Block, span: Span) -> Unit
  # Desugar for loops:
  #   Range-based: for var in lo..hi → while var < hi { body; var += 1 }
  #   Collection-based: for var in coll → index-based iteration
  match iter.kind
  when ExprKind::Range(lo_box, hi_box, _incl) then
    # Range-based for (only works with simple Ident pattern for now)
    let var_name = match pat.kind
    when PatternKind::Ident(name, _) then name
    when _ then "_for_var"
    end

    mut lo_op = MirOperand { kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int }) }
    match lo_box
    when Option::Some(lo_e) then
      lo_op = lower_expr(b, &lo_e, span)
    when Option::None then ()
    end
    mut hi_op = MirOperand { kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int }) }
    match hi_box
    when Option::Some(hi_e) then
      hi_op = lower_expr(b, &hi_e, span)
    when Option::None then ()
    end

    let hi_counter = b.local_counter
    add_local(b, "_for_hi", Type::Int, false, span)
    push_assign(b, place_local(LocalId { id: hi_counter }), MirRvalue { kind: MirRvalueKind::MirMove(hi_op) }, span)

    let var_counter = b.local_counter
    add_local(b, var_name, Type::Int, true, span)
    push_assign(b, place_local(LocalId { id: var_counter }), MirRvalue { kind: MirRvalueKind::MirMove(lo_op) }, span)

    let header   = create_block(b)
    let body_blk = create_block(b)
    let exit_blk = create_block(b)

    # Save and set break/continue targets
    let old_break = b.break_target
    let old_continue = b.continue_target
    b.break_target = Option::Some(exit_blk)
    b.continue_target = Option::Some(header)

    set_terminator(b, MirTerminatorKind::MirGoto(header), span)

    switch_to_block(b, header)
    let cmp_counter = b.local_counter
    add_temp(b, Type::Bool, span)
    let var_place = place_local(LocalId { id: var_counter })
    let hi_place  = place_local(LocalId { id: hi_counter })
    let cmp_place = place_local(LocalId { id: cmp_counter })
    let var_op_cmp = MirOperand { kind: MirOperandKind::MirCopy(var_place) }
    let hi_op_cmp  = MirOperand { kind: MirOperandKind::MirCopy(hi_place) }
    let cmp_rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Lt, var_op_cmp, hi_op_cmp) }
    push_assign(b, cmp_place, cmp_rvalue, span)
    let cmp_op = MirOperand { kind: MirOperandKind::MirCopy(place_local(LocalId { id: cmp_counter })) }
    mut targets = Vec::new()
    targets.push(SwitchTarget { value: 0, target: exit_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt(cmp_op, targets, body_blk), span)

    switch_to_block(b, body_blk)
    lower_block(b, body)
    if !block_is_terminated(b) then
      let inc_counter = b.local_counter
      add_temp(b, Type::Int, span)
      let var_place2 = place_local(LocalId { id: var_counter })
      let inc_place  = place_local(LocalId { id: inc_counter })
      let var_op_inc = MirOperand { kind: MirOperandKind::MirCopy(var_place2) }
      let one_const  = MirOperand { kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(1), ty: Type::Int }) }
      let inc_rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Add, var_op_inc, one_const) }
      push_assign(b, inc_place, inc_rvalue, span)
      let var_place3 = place_local(LocalId { id: var_counter })
      let inc_result = MirOperand { kind: MirOperandKind::MirCopy(place_local(LocalId { id: inc_counter })) }
      push_assign(b, var_place3, MirRvalue { kind: MirRvalueKind::MirMove(inc_result) }, span)
      set_terminator(b, MirTerminatorKind::MirGoto(header), span)
    end

    b.break_target = old_break
    b.continue_target = old_continue
    switch_to_block(b, exit_blk)

  when _ then
    # Collection-based for: desugar to index-based iteration
    let iter_local = add_temp(b, Type::Unit, span) # Type should be handled better
    let iter_op = lower_expr(b, iter, span)
    push_assign(b, place_local(iter_local), MirRvalue { kind: MirRvalueKind::MirMove(iter_op) }, span)

    let len_local = add_temp(b, Type::Int, span)
    push_assign(b, place_local(len_local), MirRvalue { kind: MirRvalueKind::MirLen(place_local(iter_local)) }, span)

    let idx_local = add_temp(b, Type::Int, span)
    push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(
      MirOperand { kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int }) }
    ) }, span)

    let header   = create_block(b)
    let body_blk = create_block(b)
    let exit_blk = create_block(b)

    let old_break = b.break_target
    let old_continue = b.continue_target
    b.break_target = Option::Some(exit_blk)
    b.continue_target = Option::Some(header)

    set_terminator(b, MirTerminatorKind::MirGoto(header), span)

    switch_to_block(b, header)
    let cmp_tmp = add_temp(b, Type::Bool, span)
    push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::Lt,
      MirOperand { kind: MirOperandKind::MirCopy(place_local(idx_local)) },
      MirOperand { kind: MirOperandKind::MirCopy(place_local(len_local)) }
    ) }, span)
    let cmp_op = MirOperand { kind: MirOperandKind::MirCopy(place_local(cmp_tmp)) }
    mut targets = Vec::new()
    targets.push(SwitchTarget { value: 0, target: exit_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt(cmp_op, targets, body_blk), span)

    switch_to_block(b, body_blk)
    # element = iter[idx]
    mut projs = Vec::new()
    projs.push(Projection::ProjIndex(idx_local))
    let elem_place = Place { local: iter_local, projections: projs }
    let elem_op = MirOperand { kind: MirOperandKind::MirCopy(elem_place) }
    
    # assign element to pattern
    lower_pattern_assignment(b, &pat, MirRvalue { kind: MirRvalueKind::MirMove(elem_op) }, span)

    lower_block(b, body)
    if !block_is_terminated(b) then
      let inc_tmp = add_temp(b, Type::Int, span)
      push_assign(b, place_local(inc_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
        MirBinOp::Add,
        MirOperand { kind: MirOperandKind::MirCopy(place_local(idx_local)) },
        MirOperand { kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(1), ty: Type::Int }) }
      ) }, span)
      push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(
        MirOperand { kind: MirOperandKind::MirCopy(place_local(inc_tmp)) }
      ) }, span)
      set_terminator(b, MirTerminatorKind::MirGoto(header), span)
    end

    b.break_target = old_break
    b.continue_target = old_continue
    switch_to_block(b, exit_blk)
  end
end

def lower_loop(b: &mut MirBuilder, body: &Block, span: Span) -> Unit
  let header = create_block(b)
  let exit_block = create_block(b)
  
  # Save and set break/continue targets
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_block)
  b.continue_target = Option::Some(header)

  set_terminator(b, MirTerminatorKind::MirGoto(header), span)

  switch_to_block(b, header)
  lower_block(b, body)
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(header), span)
  end
  
  # Restore break/continue targets
  b.break_target = old_break
  b.continue_target = old_continue
  
  switch_to_block(b, exit_block)
end

def lower_match(b: &mut MirBuilder, m: &MatchExpr, span: Span) -> Unit
  let scrutinee = lower_expr(b, &m.scrutinee, span)

  # Store the scrutinee value in a local
  let scrut_local = add_temp(b, Type::Int, span)
  push_assign(b, place_local(scrut_local), MirRvalue { kind: MirRvalueKind::MirMove(scrutinee.clone()) }, span)

  # Determine if this is an enum match or literal match
  # by checking first non-wildcard pattern
  mut is_enum_match = false
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Variant(_, _) then
      is_enum_match = true
    when _ then ()
    end
  end

  # For enum matching, extract discriminant; for literal matching, use raw value
  let switch_local = if is_enum_match then
    let discr_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(
      place_local(scrut_local)
    ) }, span)
    discr_tmp
  else
    scrut_local
  end

  let join_block = create_block(b)

  # Create a block for each arm
  mut arm_blocks = Vec::new()
  for arm in m.arms do
    arm_blocks.push(create_block(b))
  end

  # Build switch targets from patterns
  mut switch_targets = Vec::new()
  mut i = 0
  for arm in m.arms do
    mut is_catchall = false
    let disc_val = match arm.pattern.kind
    when PatternKind::Literal(expr) then
      match expr.kind
      when ExprKind::IntLit(n) then n
      when ExprKind::BoolLit(b) then if b then 1 else 0 end
      when _ then i
      end
    when PatternKind::Variant(path, _) then i
    when PatternKind::Wildcard then
      is_catchall = true
      0
    when PatternKind::Ident(_, _) then
      is_catchall = true
      0
    when _ then i
    end

    if !is_catchall then
      switch_targets.push(SwitchTarget { value: disc_val, target: arm_blocks[i] })
    end
    i = i + 1
  end

  # Find default target: last wildcard/ident arm, or join_block
  let real_default = if m.arms.len() > 0 then
    # Look for the last wildcard or ident pattern to use as default
    mut def_target = join_block
    mut j = 0
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Wildcard then
        def_target = arm_blocks[j]
      when PatternKind::Ident(_, _) then
        def_target = arm_blocks[j]
      when _ then ()
      end
      j = j + 1
    end
    def_target
  else
    join_block
  end

  # Emit switch on the appropriate local
  let switch_op = MirOperand { kind: MirOperandKind::MirCopy(place_local(switch_local)) }
  set_terminator(b, MirTerminatorKind::MirSwitchInt(switch_op, switch_targets, real_default), span)

  # Emit each arm body
  i = 0
  for arm in m.arms do
    switch_to_block(b, arm_blocks[i])

    # Bind pattern variables
    match arm.pattern.kind
    when PatternKind::Ident(name, _) then
      let local = add_local(b, name, Type::Unit, false, span)
      push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::MirMove(
        MirOperand { kind: MirOperandKind::MirCopy(place_local(scrut_local)) }
      ) }, span)
    when PatternKind::Variant(path, sub_pats) then
      # For variant patterns with sub-patterns, bind each field
      mut field_idx = 0
      for sp in sub_pats do
        match sp.kind
        when PatternKind::Ident(name, _) then
          let local = add_local(b, name, Type::Unit, false, span)
          let proj_place = place_field(place_local(scrut_local), name, field_idx)
          push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::MirMove(
            MirOperand { kind: MirOperandKind::MirCopy(proj_place) }
          ) }, span)
        when _ then ()
        end
        field_idx = field_idx + 1
      end
    when _ then ()
    end

    # Guard check
    match arm.guard_expr
    when Option::Some(guard_expr_val) then
      let guard_val = lower_expr(b, &guard_expr_val, span)
      let guard_pass = create_block(b)
      let guard_fail = if i + 1 < arm_blocks.len() then arm_blocks[i + 1] else join_block end
      mut gt = Vec::new()
      gt.push(SwitchTarget { value: 0, target: guard_fail })
      set_terminator(b, MirTerminatorKind::MirSwitchInt(guard_val, gt, guard_pass), span)
      switch_to_block(b, guard_pass)
    when Option::None then ()
    end

    lower_block(b, &arm.body)
    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
    end
    i = i + 1
  end

  switch_to_block(b, join_block)
end

def lower_match_to_place(b: &mut MirBuilder, m: &MatchExpr, dest: Place, span: Span) -> Unit
  # Same as lower_match but stores each arm's last expression to dest
  let scrutinee = lower_expr(b, &m.scrutinee, span)

  let scrut_local = add_temp(b, Type::Int, span)
  push_assign(b, place_local(scrut_local), MirRvalue { kind: MirRvalueKind::MirMove(scrutinee.clone()) }, span)

  mut is_enum_match = false
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Variant(_, _) then
      is_enum_match = true
    when _ then ()
    end
  end

  let switch_local = if is_enum_match then
    let discr_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(
      place_local(scrut_local)
    ) }, span)
    discr_tmp
  else
    scrut_local
  end

  let join_block = create_block(b)

  mut arm_blocks = Vec::new()
  for arm in m.arms do
    arm_blocks.push(create_block(b))
  end

  mut switch_targets = Vec::new()
  mut i = 0
  for arm in m.arms do
    mut is_catchall = false
    let disc_val = match arm.pattern.kind
    when PatternKind::Literal(expr) then
      match expr.kind
      when ExprKind::IntLit(n) then n
      when ExprKind::BoolLit(b) then if b then 1 else 0 end
      when _ then i
      end
    when PatternKind::Variant(path, _) then i
    when PatternKind::Wildcard then
      is_catchall = true
      0
    when PatternKind::Ident(_, _) then
      is_catchall = true
      0
    when _ then i
    end

    if !is_catchall then
      switch_targets.push(SwitchTarget { value: disc_val, target: arm_blocks[i] })
    end
    i = i + 1
  end

  let real_default = if m.arms.len() > 0 then
    mut def_target = join_block
    mut j = 0
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Wildcard then def_target = arm_blocks[j]
      when PatternKind::Ident(_, _) then def_target = arm_blocks[j]
      when _ then ()
      end
      j = j + 1
    end
    def_target
  else
    join_block
  end

  let switch_op = MirOperand { kind: MirOperandKind::MirCopy(place_local(switch_local)) }
  set_terminator(b, MirTerminatorKind::MirSwitchInt(switch_op, switch_targets, real_default), span)

  i = 0
  for arm in m.arms do
    switch_to_block(b, arm_blocks[i])

    # Bind pattern variables
    match arm.pattern.kind
    when PatternKind::Ident(name, _) then
      let local = add_local(b, name, Type::Unit, false, span)
      push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::MirMove(
        MirOperand { kind: MirOperandKind::MirCopy(place_local(scrut_local)) }
      ) }, span)
    when PatternKind::Variant(path, sub_pats) then
      mut field_idx = 0
      for sp in sub_pats do
        match sp.kind
        when PatternKind::Ident(name, _) then
          let local = add_local(b, name, Type::Unit, false, span)
          let proj_place = place_field(place_local(scrut_local), name, field_idx)
          push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::MirMove(
            MirOperand { kind: MirOperandKind::MirCopy(proj_place) }
          ) }, span)
        when _ then ()
        end
        field_idx = field_idx + 1
      end
    when _ then ()
    end

    # Guard check
    match arm.guard_expr
    when Option::Some(guard_expr_val) then
      let guard_val = lower_expr(b, &guard_expr_val, span)
      let guard_pass = create_block(b)
      let guard_fail = if i + 1 < arm_blocks.len() then arm_blocks[i + 1] else join_block end
      mut gt = Vec::new()
      gt.push(SwitchTarget { value: 0, target: guard_fail })
      set_terminator(b, MirTerminatorKind::MirSwitchInt(guard_val, gt, guard_pass), span)
      switch_to_block(b, guard_pass)
    when Option::None then ()
    end

    # Lower arm body and store result to dest
    if arm.body.stmts.len() > 0 then
      # Lower all but last statement
      mut si = 0
      while si < arm.body.stmts.len() - 1 do
        lower_stmt(b, &arm.body.stmts[si])
        si = si + 1
      end
      # Last statement: assign its value to dest
      let last = arm.body.stmts[arm.body.stmts.len() - 1]
      match last.kind
      when StmtKind::Expr(expr) then
        lower_expr_assign_to(b, &expr, dest.clone(), span)
      when _ then
        lower_stmt(b, &last)
      end
    end

    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
    end
    i = i + 1
  end

  switch_to_block(b, join_block)
end

# ———————————————————————————————————————————————————————————————
# MIR Pretty Printer
# ———————————————————————————————————————————————————————————————
#
# Human-readable serialization of the entire MIR.  Used by --emit-mir,
# the REPL :mir command, and diagnostics/debugging output.

def pretty_print_mir(program: &MirProgram) -> String
  mut out = ""

  # Type definitions
  if !program.types.is_empty() then
    out = out + "// Type definitions\n"
    for td in program.types do
      out = out + format_mir_typedef(&td) + "\n"
    end
    out = out + "\n"
  end

  # Statics / globals
  if !program.statics.is_empty() then
    out = out + "// Statics\n"
    for s in program.statics do
      let mutability = if s.is_mut then "mut " else "" end
      out = out + "static " + mutability + s.name.clone() + ": " + format_mir_type(&s.ty) + ";\n"
    end
    out = out + "\n"
  end

  # Functions
  for func in program.functions do
    out = out + format_mir_function(&func) + "\n"
  end
  out
end

def format_mir_typedef(td: &MirTypeDef) -> String
  mut out = "type " + td.name.clone()
  match td.kind
  when MirTypeDefKind::Struct(fields) then
    out = out + " = struct {\n"
    for f in fields do
      out = out + "    " + f.name.clone() + ": " + format_mir_type(&f.ty)
      if f.offset >= 0 then
        out = out + "  // offset " + f.offset.to_string()
      end
      out = out + "\n"
    end
    out = out + "}"
  when MirTypeDefKind::Enum(variants) then
    out = out + " = enum {\n"
    for v in variants do
      out = out + "    " + v.name.clone() + " = " + v.discriminant.to_string()
      if !v.fields.is_empty() then
        out = out + "("
        mut first = true
        for f in v.fields do
          if !first then out = out + ", " end
          out = out + format_mir_type(&f)
          first = false
        end
        out = out + ")"
      end
      out = out + "\n"
    end
    out = out + "}"
  end
  out
end

def format_mir_function(func: &MirFunction) -> String
  mut out = ""
  # Annotations
  if func.is_unsafe then out = out + "unsafe " end
  if func.is_async then out = out + "async " end
  if func.is_extern then out = out + "extern \"" + func.extern_abi.clone() + "\" " end

  out = out + "fn " + func.name.clone() + "("
  mut first = true
  for p in func.params do
    if !first then out = out + ", " end
    let mutmark = if p.is_mut then "mut " else "" end
    out = out + mutmark + p.name.clone() + ": " + format_mir_type(&p.ty)
    first = false
  end
  out = out + ") -> " + format_mir_type(&func.ret_type) + " {\n"

  # Local declarations
  for local in func.locals do
    let mutmark = if local.is_mut then "mut " else "" end
    out = out + "    let " + mutmark + "_" + local.id.id.to_string()
    if !local.name.is_empty() then
      out = out + " /* " + local.name.clone() + " */"
    end
    out = out + ": " + format_mir_type(&local.ty) + ";\n"
  end
  if !func.locals.is_empty() then out = out + "\n" end

  # Contracts
  for c in func.contracts do
    let kind_str = match c.kind
    when AstContractKind::AstPre then "pre"
    when AstContractKind::AstPost then "post"
    when AgContractKind::AgInvariant then "invariant"
    end
    out = out + "    @" + kind_str + " " + format_operand(&c.condition) + " \"" + c.message.clone() + "\"\n"
  end

  # Basic blocks
  for block in func.blocks do
    out = out + format_mir_block(&block)
  end

  out = out + "}\n"
  out
end

def format_mir_block(block: &MirBlock) -> String
  mut out = "    bb" + block.id.id.to_string() + ": {\n"
  for stmt in block.statements do
    out = out + "        " + format_mir_statement(&stmt) + ";\n"
  end
  out = out + "        " + format_mir_terminator(&block.terminator) + ";\n"
  out = out + "    }\n"
  out
end

def format_mir_statement(stmt: &MirStatement) -> String
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    format_place(&place) + " = " + format_rvalue(&rvalue)
  when MirStatementKind::MirStorageLive(id) then
    "StorageLive(_" + id.id.to_string() + ")"
  when MirStatementKind::MirStorageDead(id) then
    "StorageDead(_" + id.id.to_string() + ")"
  when MirStatementKind::MirNop then
    "nop"
  when MirStatementKind::MirContractCheck(contract, op) then
    let kind_str = match contract.kind
    when AstContractKind::AstPre then "pre"
    when AstContractKind::AstPost then "post"
    when AgContractKind::AgInvariant then "invariant"
    end
    "contract_check(" + kind_str + ", " + format_operand(&op) + ")"
  when MirStatementKind::MirBudgetConsume(resource, amount) then
    "budget_consume(\"" + resource.clone() + "\", " + amount.to_string() + ")"
  when MirStatementKind::MirEffectRecord(name, op) then
    "effect_record(\"" + name.clone() + "\", " + format_operand(&op) + ")"
  end
end

def format_mir_terminator(term: &MirTerminator) -> String
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    "goto -> bb" + target.id.to_string()
  when MirTerminatorKind::MirSwitchInt { op: discr, targets, default_target: otherwise } then
    mut out = "switchInt(" + format_operand(&discr) + ") -> ["
    for t in targets do
      out = out + t.value.to_string() + ": bb" + t.target.id.to_string() + ", "
    end
    out = out + "otherwise: bb" + otherwise.id.to_string() + "]"
    out
  when MirTerminatorKind::MirReturn then
    "return"
  when MirTerminatorKind::MirUnreachable then
    "unreachable"
  when MirTerminatorKind::MirCall { dest, func: func_op, args, success: succ, unwind } then
    mut out = format_place(&dest) + " = " + format_operand(&func_op) + "("
    mut first = true
    for a in args do
      if !first then out = out + ", " end
      out = out + format_operand(&a)
      first = false
    end
    out = out + ") -> [return: bb" + succ.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirDrop { place, target, unwind } then
    mut out = "drop(" + format_place(&place) + ") -> [bb" + target.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    mut out = "assert(" + format_operand(&cond) + ", "
    out = out + (if expected then "true" else "false" end) + ", "
    out = out + format_assert_message(&msg) + ") -> [success: bb" + target.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirYield(value, resume) then
    "yield(" + format_operand(&value) + ") -> resume: bb" + resume.id.to_string()
  when MirTerminatorKind::MirAbort then
    "abort"
  end
end

def format_assert_message(msg: &AssertMessage) -> String
  match msg
  when AssertMessage::BoundsCheck(idx, len) then
    "\"index out of bounds: \" + index=" + format_operand(&idx) + " len=" + format_operand(&len)
  when AssertMessage::Overflow(op) then
    "\"arithmetic overflow: " + format_binop(op) + "\""
  when AssertMessage::DivisionByZero then "\"division by zero\""
  when AssertMessage::RemainderByZero then "\"remainder by zero\""
  when AssertMessage::NullPointer then "\"null pointer dereference\""
  when AssertMessage::ContractViolation(m) then "\"contract violation: " + m.clone() + "\""
  end
end

def format_place(place: &Place) -> String
  mut out = "_" + place.local.id.to_string()
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then out = "(*" + out + ")"
    when Projection::ProjField(name, idx) then out = out + "." + name.clone()
    when Projection::ProjIndex(id) then out = out + "[_" + id.id.to_string() + "]"
    when Projection::ProjConstantIndex(i) then out = out + "[" + i.to_string() + "]"
    when Projection::ProjDowncast(name, _) then out = "(" + out + " as " + name.clone() + ")"
    end
  end
  out
end

def format_operand(op: &MirOperand) -> String
  match op.kind
  when MirOperandKind::MirCopy(place) then "copy " + format_place(&place)
  when MirOperandKind::MirMovePlace(place) then "move " + format_place(&place)
  when MirOperandKind::MirConstant(c) then format_mir_constant(&c)
  end
end

def format_mir_constant(c: &MirConstant) -> String
  match c.kind
  when MirConstantKind::MirUnit then "()"
  when MirConstantKind::MirBool(b) then if b then "true" else "false" end
  when MirConstantKind::MirInt(n) then n.to_string() + "_" + format_mir_type(&c.ty)
  when MirConstantKind::MirFloat(f) then f.to_string() + "_" + format_mir_type(&c.ty)
  when MirConstantKind::MirChar(ch) then "'" + ch.to_string() + "'"
  when MirConstantKind::MirString(s) then "\"" + s.clone() + "\""
  when MirConstantKind::MirFnItem(name) then name.clone()
  when MirConstantKind::MirZeroSized then "zero_sized"
  end
end

def format_rvalue(rv: &MirRvalue) -> String
  match rv.kind
  when MirRvalueKind::MirMove(op) then format_operand(&op)
  when MirRvalueKind::MirRef(place) then "&" + format_place(&place)
  when MirRvalueKind::MirRefMut(place) then "&mut " + format_place(&place)
  when MirRvalueKind::MirAggregate(kind, ops) then
    mut out = match kind
    when AggregateKind::MirArray(_) then "["
    when AggregateKind::Tuple then "("
    when AggregateKind::Struct(_, fields) then
      if !fields.is_empty() then fields[0].clone() + " { " else "{ " end
    when AggregateKind::Closure(id) then "closure#" + id.id.to_string() + "("
    when AggregateKind::Generator(id) then "generator#" + id.id.to_string() + "("
    end
    mut first = true
    for o in ops do
      if !first then out = out + ", " end
      out = out + format_operand(&o)
      first = false
    end
    out = out + match kind
    when AggregateKind::MirArray(_) then "]"
    when AggregateKind::Tuple then ")"
    when AggregateKind::Struct(_, _) then " }"
    when AggregateKind::Closure(_) then ")"
    when AggregateKind::Generator(_) then ")"
    end
    out
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    format_operand(&lhs) + " " + format_binop(op) + " " + format_operand(&rhs)
  when MirRvalueKind::MirUnOp(op, operand) then
    format_unop(op) + format_operand(&operand)
  when MirRvalueKind::MirDiscriminant(place) then
    "discriminant(" + format_place(&place) + ")"
  when MirRvalueKind::MirLen(place) then
    "len(" + format_place(&place) + ")"
  when MirRvalueKind::MirCast(kind, op, ty) then
    format_operand(&op) + " as " + format_mir_type(&ty) + " (" + format_cast_kind(kind) + ")"
  when MirRvalueKind::MirRepeat(op, count) then
    "[" + format_operand(&op) + "; " + count.to_string() + "]"
  when MirRvalueKind::MirPhi(entries) then
    mut out = "phi("
    mut first = true
    for entry in entries do
      let bid = entry.0
      let lid = entry.1
      if !first then out = out + ", " end
      out = out + "bb" + bid.id.to_string() + ": _" + lid.id.to_string()
      first = false
    end
    out + ")"
  end
end

def format_binop(op: MirBinOp) -> String
  match op
  when MirBinOp::Add then "+"
  when MirBinOp::Sub then "-"
  when MirBinOp::Mul then "*"
  when MirBinOp::Div then "/"
  when MirBinOp::Mod then "%"
  when MirBinOp::BitAnd then "&"
  when MirBinOp::BitOr then "|"
  when MirBinOp::BitXor then "^"
  when MirBinOp::Shl then "<<"
  when MirBinOp::Shr then ">>"
  when MirBinOp::Eq then "=="
  when MirBinOp::Ne then "!="
  when MirBinOp::Lt then "<"
  when MirBinOp::Le then "<="
  when MirBinOp::Gt then ">"
  when MirBinOp::Ge then ">="
  end
end

def format_unop(op: MirUnOp) -> String
  match op
  when MirUnOp::Neg then "-"
  when MirUnOp::Not then "!"
  when MirUnOp::BitNot then "~"
  end
end

def format_cast_kind(kind: CastKind) -> String
  match kind
  when CastKind::IntToInt then "IntToInt"
  when CastKind::IntToFloat then "IntToFloat"
  when CastKind::FloatToInt then "FloatToInt"
  when CastKind::FloatToFloat then "FloatToFloat"
  when CastKind::Pointer then "Pointer"
  when CastKind::Transmute then "Transmute"
  end
end

def format_mir_type(ty: &Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::Never then "!"
  when Type::Error then "<error>"
  when Type::Var(v) then "_T" + v.id.to_string()
  when Type::Param(name) then name.clone()
  when Type::Owned(inner) then "Owned[" + format_mir_type(inner) + "]"
  when Type::Ptr(inner) then "*" + format_mir_type(inner)
  when Type::PtrMut(inner) then "*mut " + format_mir_type(inner)
  when Type::Box(inner) then "Box[" + format_mir_type(inner) + "]"
  when Type::Rc(inner) then "Rc[" + format_mir_type(inner) + "]"
  when Type::Dyn(id) then "dyn T" + id.id.to_string()
  when Type::Effect(effects, inner) then
    "effect[" + effects.join(",") + "] " + format_mir_type(inner)
  when Type::Option(inner) then "Option[" + format_mir_type(inner) + "]"
  when Type::Result(ok, err) then "Result[" + format_mir_type(ok) + ", " + format_mir_type(err) + "]"
  when Type::Map(k, v) then "Map[" + format_mir_type(k) + ", " + format_mir_type(v) + "]"
  when Type::Set(inner) then "Set[" + format_mir_type(inner) + "]"
  when Type::Slice(inner) then "[" + format_mir_type(inner) + "]"
  when Type::Array(inner, n) then "[" + format_mir_type(inner) + "; " + n.to_string() + "]"
  when Type::Ref(inner, _) then "&" + format_mir_type(inner)
  when Type::RefMut(inner, _) then "&mut " + format_mir_type(inner)
  when Type::Tuple(elems) then
    mut out = "("
    mut first = true
    for e in elems do
      if !first then out = out + ", " end
      out = out + format_mir_type(&e)
      first = false
    end
    out + ")"
  when Type::Function(params, ret) then
    mut out = "fn("
    mut first = true
    for p in params do
      if !first then out = out + ", " end
      out = out + format_mir_type(&p)
      first = false
    end
    out + ") -> " + format_mir_type(ret)
  when Type::Named(id, args) then
    mut out = "T" + id.id.to_string()
    if !args.is_empty() then
      out = out + "["
      mut first = true
      for a in args do
        if !first then out = out + ", " end
        out = out + format_mir_type(&a)
        first = false
      end
      out = out + "]"
    end
    out
  end
end

# ———————————————————————————————————————————————————————————————
# MIR Optimizations
# ———————————————————————————————————————————————————————————————

def optimize_mir(program: &mut MirProgram, opt_level: Int) -> Unit
  # At opt_level 0, skip all optimizations (debug builds)
  if opt_level == 0 then return end

  # First pass: inlining (requires full program) — opt_level >= 2
  if opt_level >= 2 then
    inline_functions(program)
  end

  # Second pass: per-function optimizations
  for f in program.functions do
    optimize_function(f, opt_level)
  end

  # Third pass: escape analysis and heap-to-stack promotion — opt_level >= 2
  if opt_level >= 2 then
    for f in program.functions do
      escape_analysis(f)
    end
  end

  # Fourth pass: PGO-guided optimization — opt_level >= 3
  if opt_level >= 3 then
    apply_pgo_optimizations(program)
  end
end

# ———————————————————————————————————————————————————————————————
# Function Inlining
# ———————————————————————————————————————————————————————————————
#
# Inlines small, non-recursive functions at call sites.
# Heuristics:
# - Only inline functions with fewer than INLINE_THRESHOLD statements
# - Don't inline recursive functions
# - Don't inline extern functions
# - Inline #[inline] and #[inline(always)] annotated functions

const INLINE_STMT_THRESHOLD: Int = 30
const INLINE_BLOCK_THRESHOLD: Int = 5

def inline_functions(program: &mut MirProgram) -> Unit
  # Build a map of function name -> function for lookup
  mut func_map: Map[String, &MirFunction] = Map::new()
  for f in program.functions do
    func_map.insert(f.name.clone(), f)
  end
  
  # Compute call graph to detect recursion
  let call_graph = build_call_graph(program)
  let recursive_fns = find_recursive_functions(&call_graph)
  
  # Identify inlinable functions
  mut inlinable: Set[String] = Set::new()
  for f in program.functions do
    if should_inline(f, &recursive_fns) then
      inlinable.insert(f.name.clone())
    end
  end
  
  # Perform inlining (iterate until no more inlining happens)
  mut changed = true
  mut iterations = 0
  while changed && iterations < 5 do
    changed = false
    iterations = iterations + 1
    
    for caller in program.functions do
      if inline_calls_in_function(&mut caller, &func_map, &inlinable) then
        changed = true
      end
    end
  end
end

struct CallGraph
  # function name -> set of called function names
  calls: Map[String, Set[String]]
end

def build_call_graph(program: &MirProgram) -> CallGraph
  mut calls: Map[String, Set[String]] = Map::new()
  
  for f in program.functions do
    mut callees = Set::new()
    for block in f.blocks do
      match block.terminator.kind
      when MirTerminatorKind::MirCall { dest, func: ref func_op, args, success, unwind } then
        match func_op.kind
        when MirOperandKind::MirConstant(c) then
          match c.kind
          when MirConstantKind::MirFnItem(callee) then
            callees.insert(callee.clone())
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    calls.insert(f.name.clone(), callees)
  end
  
  CallGraph { calls: calls }
end

def find_recursive_functions(cg: &CallGraph) -> Set[String]
  # Find functions that are part of a recursive cycle
  mut recursive = Set::new()
  
  for entry in cg.calls do
    let (fn_name, callees) = entry
    if is_reachable_from(cg, fn_name.clone(), fn_name.clone(), Set::new()) then
      recursive.insert(fn_name.clone())
    end
  end
  
  recursive
end

def is_reachable_from(cg: &CallGraph, start: String, target: String, visited: Set[String]) -> Bool
  mut vis = visited.clone()
  vis.insert(start.clone())
  is_reachable_impl(cg, start, target, &mut vis)
end

def is_reachable_impl(cg: &CallGraph, start: String, target: String, visited: &mut Set[String]) -> Bool
  match cg.calls.get(start.clone())
  when Option::Some(callees) then
    for callee in callees do
      if callee == target then
        return true
      end
      if !visited.contains(callee.clone()) then
        visited.insert(callee.clone())
        if is_reachable_impl(cg, callee.clone(), target.clone(), visited) then
          return true
        end
      end
    end
  when Option::None then ()
  end
  false
end

def should_inline(f: &MirFunction, recursive_fns: &Set[String]) -> Bool
  # Don't inline extern functions
  if f.is_extern then
    return false
  end
  
  # Don't inline recursive functions
  if recursive_fns.contains(f.name.clone()) then
    return false
  end
  
  # Count statements
  mut stmt_count = 0
  for block in f.blocks do
    stmt_count = stmt_count + block.statements.len()
  end
  
  # Inline if small enough
  if stmt_count <= INLINE_STMT_THRESHOLD && f.blocks.len() <= INLINE_BLOCK_THRESHOLD then
    return true
  end
  
  false
end

def inline_calls_in_function(caller: &mut MirFunction, func_map: &Map[String, &MirFunction], 
                              inlinable: &Set[String]) -> Bool
  mut changed = false
  mut new_blocks: Vec[MirBlock] = Vec::new()
  mut next_local_id = caller.locals.len() + caller.params.len()
  mut next_block_id = caller.blocks.len()
  
  for block in caller.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest: ref dest, func: ref func_op, args: ref args, success: ref success_block, unwind: ref unwind_block } then
      let maybe_callee_name = match func_op.kind
      when MirOperandKind::MirConstant(c) then
        match c.kind
        when MirConstantKind::MirFnItem(name) then Option::Some(name.clone())
        when _ then Option::None
        end
      when _ then Option::None
      end

      match maybe_callee_name
      when Option::Some(callee_name) then
        if inlinable.contains(callee_name.clone()) then
          match func_map.get(callee_name.clone())
        when Option::Some(callee) then
          # Inline this call
          let inline_res = prepare_inline_body(
            callee, &mut next_local_id, &mut next_block_id, args, dest, Option::Some(*success_block)
          )
          let inlined_blocks = inline_res.blocks
          let local_mapping = inline_res.mapping
          let entry_block = inline_res.entry
          
          # Add inlined locals to caller
          for local in callee.locals do
            match local_mapping.get(local.id.id)
            when Option::Some(new_id) then
              caller.locals.push(MirLocal {
                id: LocalId { id: new_id },
                name: local.name.clone() + "_inlined",
                ty: local.ty.clone(),
                is_mut: local.is_mut,
                span: local.span.clone()
              })
            when Option::None then ()
            end
          end
          
          # Replace call terminator with goto inlined entry
          let new_term = MirTerminator {
            kind: MirTerminatorKind::MirGoto(entry_block),
            span: block.terminator.span.clone()
          }
          new_blocks.push(MirBlock {
            id: block.id.clone(),
            statements: block.statements.clone(),
            terminator: new_term
          })
          
          # Add inlined blocks
          for inlined in inlined_blocks do
            new_blocks.push(inlined)
          end
          
          changed = true
        when Option::None then
          new_blocks.push(block.clone())
        end
        else
          new_blocks.push(block.clone())
        end
      when Option::None then
        new_blocks.push(block.clone())
      end
    when _ then
      new_blocks.push(block.clone())
    end
  end
  
  if changed then
    caller.blocks = new_blocks
  end
  
  changed
end

struct InlineResult
  blocks: Vec[MirBlock]
  mapping: Map[Int, Int]
  entry: BlockId
end

def prepare_inline_body(callee: &MirFunction, next_local_id: &mut Int, next_block_id: &mut Int, args: &Vec[MirOperand], dest: &Option[Place], next_block: &Option[BlockId]) -> InlineResult
  # Create mappings for locals and blocks
  mut local_mapping: Map[Int, Int] = Map::new()
  mut block_mapping: Map[Int, Int] = Map::new()
  
  # Map callee parameters to argument values (by copying arg into new local)
  for i in 0..callee.params.len() do
    let new_id = *next_local_id
    *next_local_id = *next_local_id + 1
    local_mapping.insert(callee.params[i].id.id, new_id)
  end
  
  # Map callee locals
  for local in callee.locals do
    let new_id = *next_local_id
    *next_local_id = *next_local_id + 1
    local_mapping.insert(local.id.id, new_id)
  end
  
  # Map callee blocks
  let entry_block_id = *next_block_id
  for block in callee.blocks do
    let new_id = *next_block_id
    *next_block_id = *next_block_id + 1
    block_mapping.insert(block.id.id, new_id)
  end
  
  # Clone and remap blocks
  mut new_blocks: Vec[MirBlock] = Vec::new()
  
  for block in callee.blocks do
    let block_new_id = block_mapping.get(block.id.id).unwrap_or(block.id.id)
    
    # Remap statements
    mut new_stmts: Vec[MirStatement] = Vec::new()
    
    # First, if this is the entry block, add parameter-to-local assignments
    if block.id.id == callee.entry_block.id then
      for i in 0..callee.params.len() do
        if i < args.len() then
          match local_mapping.get(callee.params[i].id.id)
          when Option::Some(new_local) then
            new_stmts.push(MirStatement {
              kind: MirStatementKind::MirAssign(
                Place { local: LocalId { id: new_local }, projections: Vec::new() },
                MirRvalue { kind: MirRvalueKind::MirMove(args[i].clone()) }
              ),
              span: callee.span.clone()
            })
          when Option::None then ()
          end
        end
      end
    end
    
    for stmt in block.statements do
      new_stmts.push(remap_statement(&stmt, &local_mapping))
    end
    
    # Remap terminator
    let new_term = remap_terminator(&block.terminator, &local_mapping, &block_mapping, dest, next_block)
    
    new_blocks.push(MirBlock {
      id: BlockId { id: block_new_id },
      statements: new_stmts,
      terminator: new_term
    })
  end
  
  InlineResult { blocks: new_blocks, mapping: local_mapping, entry: BlockId { id: entry_block_id } }
end

def remap_statement(stmt: &MirStatement, local_map: &Map[Int, Int]) -> MirStatement
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::MirAssign(
        remap_place(&place, local_map),
        remap_rvalue(&rvalue, local_map)
      ),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirStorageLive(local_id) then
    let new_id = local_map.get(local_id.id).unwrap_or(local_id.id)
    MirStatement {
      kind: MirStatementKind::MirStorageLive(LocalId { id: new_id }),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirStorageDead(local_id) then
    let new_id = local_map.get(local_id.id).unwrap_or(local_id.id)
    MirStatement {
      kind: MirStatementKind::MirStorageDead(LocalId { id: new_id }),
      span: stmt.span.clone()
    }
  when _ then stmt.clone()
  end
end

def remap_place(place: &Place, local_map: &Map[Int, Int]) -> Place
  let new_local = local_map.get(place.local.id).unwrap_or(place.local.id)
  Place {
    local: LocalId { id: new_local },
    projections: place.projections.clone()
  }
end

def remap_rvalue(rv: &MirRvalue, local_map: &Map[Int, Int]) -> MirRvalue
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    MirRvalue { kind: MirRvalueKind::MirMove(remap_operand(&op, local_map)) }
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    MirRvalue { kind: MirRvalueKind::MirBinOp(op.clone(), remap_operand(&lhs, local_map), remap_operand(&rhs, local_map)) }
  when MirRvalueKind::MirUnOp(op, operand) then
    MirRvalue { kind: MirRvalueKind::MirUnOp(op.clone(), remap_operand(&operand, local_map)) }
  when MirRvalueKind::MirRef(place) then
    MirRvalue { kind: MirRvalueKind::MirRef(remap_place(&place, local_map)) }
  when MirRvalueKind::MirRefMut(place) then
    MirRvalue { kind: MirRvalueKind::MirRefMut(remap_place(&place, local_map)) }
  when MirRvalueKind::MirAggregate(kind, fields) then
    let remapped = fields.iter().map(|f| remap_operand(&f, local_map)).collect()
    MirRvalue { kind: MirRvalueKind::MirAggregate(kind.clone(), remapped) }
  when MirRvalueKind::MirDiscriminant(place) then
    MirRvalue { kind: MirRvalueKind::MirDiscriminant(remap_place(&place, local_map)) }
  when MirRvalueKind::MirLen(place) then
    MirRvalue { kind: MirRvalueKind::MirLen(remap_place(&place, local_map)) }
  when MirRvalueKind::MirCast(kind, op, ty) then
    MirRvalue { kind: MirRvalueKind::MirCast(kind.clone(), remap_operand(&op, local_map), ty.clone()) }
  when MirRvalueKind::MirRepeat(op, count) then
    MirRvalue { kind: MirRvalueKind::MirRepeat(remap_operand(&op, local_map), count) }
  when MirRvalueKind::MirPhi(args) then
  let remapped = Vec::new()
  for arg_entry in args do
    let block = arg_entry.0
    let local = arg_entry.1
    let new_id = local_map.get(local.id).unwrap_or(local.id)
    remapped.push((block, LocalId { id: new_id }))
  end
    MirRvalue { kind: MirRvalueKind::MirPhi(remapped) }
  end
end

def remap_operand(op: &MirOperand, local_map: &Map[Int, Int]) -> MirOperand
  match op.kind
  when MirOperandKind::MirCopy(place) then
    MirOperand { kind: MirOperandKind::MirCopy(remap_place(&place, local_map)) }
  when MirOperandKind::MirMovePlace(place) then
    MirOperand { kind: MirOperandKind::MirMovePlace(remap_place(&place, local_map)) }
  when _ then op.clone()
  end
end

def remap_terminator(term: &MirTerminator, local_map: &Map[Int, Int], block_map: &Map[Int, Int],
                     dest: &Option[Place], next_block: &Option[BlockId]) -> MirTerminator
  match term.kind
  when MirTerminatorKind::MirReturn then
    # Replace return with goto next_block (return value is in local 0)
    match next_block
    when Option::Some(nb) then
      MirTerminator { kind: MirTerminatorKind::MirGoto(nb.clone()), span: term.span.clone() }
    when Option::None then
      MirTerminator { kind: MirTerminatorKind::MirReturn, span: term.span.clone() }
    end
  when MirTerminatorKind::MirGoto(target) then
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    MirTerminator { kind: MirTerminatorKind::MirGoto(BlockId { id: new_target }), span: term.span.clone() }
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    let new_fallback = block_map.get(default_target.id).unwrap_or(default_target.id)
    mut new_targets = Vec::new()
    for entry in targets do
      let new_bid = block_map.get(entry.target.id).unwrap_or(entry.target.id)
      new_targets.push(SwitchTarget { value: entry.value, target: BlockId { id: new_bid } })
    end
    MirTerminator {
      kind: MirTerminatorKind::MirSwitchInt { op: remap_operand(&op, local_map), targets: new_targets, default_target: BlockId { id: new_fallback } },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind } then
    mut remapped_args: Vec[MirOperand] = Vec::new()
    for arg in args do
      remapped_args.push(remap_operand(&arg, local_map))
    end
    let new_succ = block_map.get(success.id).unwrap_or(success.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(BlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirCall {
        dest: remap_place(&dest, local_map),
        func: remap_operand(&func, local_map),
        args: remapped_args,
        success: BlockId { id: new_succ },
        unwind: new_unwind
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirDrop { place, target, unwind } then
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(BlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirDrop { place: remap_place(&place, local_map), target: BlockId { id: new_target }, unwind: new_unwind },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    let remapped_msg = match msg
    when AssertMessage::BoundsCheck(index, length) then
      AssertMessage::BoundsCheck(remap_operand(&index, local_map), remap_operand(&length, local_map))
    when AssertMessage::Overflow(binop) then AssertMessage::Overflow(binop)
    when AssertMessage::DivisionByZero then AssertMessage::DivisionByZero
    when AssertMessage::RemainderByZero then AssertMessage::RemainderByZero
    when AssertMessage::NullPointer then AssertMessage::NullPointer
    when AssertMessage::ContractViolation(s) then AssertMessage::ContractViolation(s.clone())
    end
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(BlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirAssert {
        cond: remap_operand(&cond, local_map),
        expected: expected,
        msg: remapped_msg,
        target: BlockId { id: new_target },
        unwind: new_unwind
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirYield(value, resume) then
    let new_resume = block_map.get(resume.id).unwrap_or(resume.id)
    MirTerminator {
      kind: MirTerminatorKind::MirYield(remap_operand(&value, local_map), BlockId { id: new_resume }),
      span: term.span.clone()
    }
  when _ then term.clone()
  end
end

def optimize_function(f: &mut MirFunction, opt_level: Int) -> Unit
  # Level 1+: basic optimizations
  # Dead code elimination
  eliminate_dead_code(f)
  
  # Copy propagation — DISABLED: without SSA, propagating copies of
  # variables that have multiple definitions (e.g. loop variables)
  # causes incorrect rewrites across basic blocks.
  # propagate_copies(f)
  
  # Constant folding
  fold_constants(f)
  
  if opt_level >= 2 then
    # Global Value Numbering — eliminate redundant computations
    global_value_numbering(f)
    
    # Loop-Invariant Code Motion — hoist loop-invariant computations
    loop_invariant_code_motion(f)
    
    # Bounds-check elimination — remove redundant array bounds checks
    eliminate_bounds_checks(f)
  end
  
  # Remove redundant moves
  simplify_moves(f)
  
  # Final dead code elimination after all other passes
  eliminate_dead_code(f)
end

def MAX_COPY_PROPAGATION_ITERATIONS() -> Int = 100

def eliminate_dead_code(f: &mut MirFunction) -> Unit
  # Mark reachable blocks from entry
  mut reachable: Set[Int] = Set::new()
  mut worklist = Vec::new()
  worklist.push(f.entry_block)
  
  while !worklist.is_empty() do
    match worklist.pop()
    when Option::Some(block_id) then
      if !reachable.contains(block_id) then
        reachable.insert(block_id)
        # Add successors to worklist
        match get_block(f, block_id)
        when Option::Some(block) then
          for succ in terminator_successors(&block.terminator) do
            worklist.push(succ)
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  
  # Remove unreachable blocks
  mut new_blocks = Vec::new()
  for block in f.blocks do
    if reachable.contains(block.id) then
      new_blocks.push(block)
    end
  end
  f.blocks = new_blocks
end

def propagate_copies(f: &mut MirFunction) -> Unit
  # Copy propagation: if we have _x = Copy(_y), replace all uses of _x with _y.
  # Build a substitution map from simple copy assignments, then apply it transitively.
  mut copy_map: Map[Int, LocalId] = Map::new()  # local_id -> source_local_id
  
  # Collect simple copy assignments: _dst = Use(Copy(_src))
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::MirMove(operand) then
            match operand.kind
            when MirOperandKind::MirCopy(src_place) then
              if src_place.projections.is_empty() then
                copy_map.insert(place.local.id, src_place.local)
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Resolve transitively: if a -> b -> c, then a -> c
  mut changed = true
  mut iterations = 0
  while changed && iterations < MAX_COPY_PROPAGATION_ITERATIONS() do
    changed = false
    iterations = iterations + 1
    for entry in copy_map.entries() do
      let id = entry.0
      let target = entry.1
      match copy_map.get(target.id)
      when Option::Some(deeper) then
        if deeper.id != target.id then
          copy_map.insert(id, deeper.clone())
          changed = true
        end
      when Option::None then ()
      end
    end
  end

  if changed then
    eprintln("MIR copy propagation reached iteration cap (" + MAX_COPY_PROPAGATION_ITERATIONS().to_string() + "); propagation may be incomplete")
  end
  
  # Apply substitution to all operands
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        substitute_rvalue_copies(&mut rvalue, &copy_map)
      when MirStatementKind::MirContractCheck(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when MirStatementKind::MirEffectRecord(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when _ then ()
      end
    end
    # Also substitute in terminators
    substitute_terminator_copies(&mut block.terminator, &copy_map)
  end
end

def substitute_operand_copies(op: &mut MirOperand, map: &Map[Int, LocalId]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        op.kind = MirOperandKind::MirCopy(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        op.kind = MirOperandKind::MirMovePlace(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def substitute_rvalue_copies(rv: &mut MirRvalue, map: &Map[Int, LocalId]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    substitute_operand_copies(&mut lhs, map)
    substitute_operand_copies(&mut rhs, map)
  when MirRvalueKind::MirUnOp(_, op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirAggregate(_, ops) then
    for o in ops do
      substitute_operand_copies(&mut o, map)
    end
  when MirRvalueKind::MirCast(_, op, _) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirRepeat(op, _) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirRef(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        rv.kind = MirRvalueKind::MirRef(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirRefMut(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        rv.kind = MirRvalueKind::MirRefMut(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirDiscriminant(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        rv.kind = MirRvalueKind::MirDiscriminant(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirLen(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        rv.kind = MirRvalueKind::MirLen(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirPhi(_) then ()  # Phi nodes reference block args, not copy targets
  when _ then ()
  end
end

def substitute_terminator_copies(term: &mut MirTerminator, map: &Map[Int, LocalId]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op: mut discr, targets, default_target } then
    substitute_operand_copies(&mut discr, map)
  when MirTerminatorKind::MirCall { dest, func: mut callee, args: mut args_val, success, unwind } then
    substitute_operand_copies(&mut callee, map)
    for arg_inner in args_val do
      substitute_operand_copies(&mut arg_inner, map)
    end
  when MirTerminatorKind::MirAssert { cond: mut op, expected, msg, target, unwind } then
    substitute_operand_copies(&mut op, map)
  when MirTerminatorKind::MirYield(op_val, target) then
    substitute_operand_copies(&mut op_val, map)
  when _ then ()
  end
end

def fold_constants(f: &mut MirFunction) -> Unit
  # Evaluate binary/unary operations on known integer/bool constants at compile time.
  # Also folds simple branch conditions when the discriminant is constant.
  mut changed = true
  mut iterations = 0
  while changed && iterations < 10 do
    changed = false
    iterations = iterations + 1
    
    for block in f.blocks do
      mut new_stmts = Vec::new()
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          match try_fold_rvalue(&rvalue)
          when Option::Some(folded) then
            new_stmts.push(MirStatement {
              kind: MirStatementKind::MirAssign(place, folded),
              span: stmt.span
            })
            changed = true
          when Option::None then
            new_stmts.push(stmt)
          end
        when _ then new_stmts.push(stmt)
        end
      end
      block.statements = new_stmts
    end
  end
end

def try_fold_rvalue(rv: &MirRvalue) -> Option[MirRvalue]
  match rv.kind
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    try_fold_binop(op, &lhs, &rhs)
  when MirRvalueKind::MirUnOp(op, operand) then
    try_fold_unop(op, &operand)
  when _ then Option::None
  end
end

def try_fold_binop(op: MirBinOp, lhs: &MirOperand, rhs: &MirOperand) -> Option[MirRvalue]
  # Only fold if both operands are integer constants
  let l = extract_int_constant(lhs)
  let r = extract_int_constant(rhs)
  match (l, r)
  when (Option::Some(lv), Option::Some(rv)) then
    let result = match op
    when MirBinOp::Add then Option::Some(lv + rv)
    when MirBinOp::Sub then Option::Some(lv - rv)
    when MirBinOp::Mul then Option::Some(lv * rv)
    when MirBinOp::Div then
      if rv != 0 then Option::Some(lv / rv) else Option::None end
    when MirBinOp::Mod then
      if rv != 0 then Option::Some(lv % rv) else Option::None end
    when MirBinOp::BitAnd then Option::Some(lv & rv)
    when MirBinOp::BitOr then Option::Some(lv | rv)
    when MirBinOp::BitXor then Option::Some(lv ^ rv)
    when MirBinOp::Shl then Option::Some(lv << rv)
    when MirBinOp::Shr then Option::Some(lv >> rv)
    when _ then Option::None
    end
    match result
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  when _ then
    # Try boolean constant folding for comparison operators
    let lb = extract_bool_constant(lhs)
    let rb = extract_bool_constant(rhs)
    match (lb, rb)
    when (Option::Some(lbv), Option::Some(rbv)) then
      let result = match op
      when MirBinOp::Eq then Option::Some(lbv == rbv)
      when MirBinOp::Ne then Option::Some(lbv != rbv)
      when _ then Option::None
      end
      match result
      when Option::Some(val) then
        Option::Some(MirRvalue {
          kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirBool(val),
              ty: Type::Bool
            })
          })
        })
      when Option::None then Option::None
      end
    when _ then Option::None
    end
  end
end

def try_fold_unop(op: MirUnOp, operand: &MirOperand) -> Option[MirRvalue]
  match op
  when MirUnOp::Neg then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(0 - val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::Not then
    match extract_bool_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirBool(!val),
            ty: Type::Bool
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::BitNot then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(~val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  end
end

def extract_int_constant(op: &MirOperand) -> Option[Int]
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirInt(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

def extract_bool_constant(op: &MirOperand) -> Option[Bool]
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirBool(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Bounds-Check Elimination
# ———————————————————————————————————————————————————————————————
#
# Removes redundant bounds checks when we can prove the index is within bounds.
# This optimization uses value range analysis to track known bounds on variables.
#
# Cases handled:
# 1. Index is a constant within 0..len (when len is known)
# 2. Index was already checked earlier (dominates current check)
# 3. Loop induction variable with known range
# 4. Index derived from len (e.g., len-1 is always valid if len > 0)

struct ValueRange
  min: Option[Int]  # Known lower bound (inclusive)
  max: Option[Int]  # Known upper bound (inclusive)
end

def eliminate_bounds_checks(f: &mut MirFunction) -> Unit
  # Track known ranges for each local
  mut ranges: Map[Int, ValueRange] = Map::new()
  
  # Track proven assertions (block_id, local_id) -> proven valid
  mut proven_checks: Set[(Int, Int, String)] = Set::new()  # (block_id, local_id, array_local_id)
  
  # Iterate through blocks in dominator order
  let dom_info = compute_dominators(f)
  let rpo = compute_reverse_postorder(f)
  
  # Initialize ranges for constants we can extract
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match extract_int_constant_from_rvalue(&rvalue)
          when Option::Some(val) then
            ranges.insert(place.local.id, ValueRange {
              min: Option::Some(val),
              max: Option::Some(val)
            })
          when Option::None then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Now eliminate redundant bounds checks
  for block in f.blocks do
    mut new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match extract_int_constant_from_rvalue(&rvalue)
          when Option::Some(val) then
            ranges.insert(place.local.id, ValueRange {
              min: Option::Some(val),
              max: Option::Some(val)
            })
          when Option::None then
            ranges.remove(place.local.id)
          end
        end
        new_stmts.push(stmt.clone())
      when _ then
        new_stmts.push(stmt.clone())
      end
    end
    
    # Check terminator for bounds assertions
    match block.terminator.kind
    when MirTerminatorKind::MirAssert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # Extract local IDs from operands
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match (index_local, len_local)
        when (Option::Some(idx_lid), Option::Some(len_lid)) then
          # Check if we can prove this bounds check
          if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
            # Replace assertion with unconditional goto to success
            block.terminator = MirTerminator {
              kind: MirTerminatorKind::MirGoto(success),
              span: block.terminator.span.clone()
            }
          else
            # Record this check as proven for dominated blocks
            proven_checks.insert((block.id.id, idx_lid.id, len_lid.id.to_string()))
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
    
    block.statements = new_stmts
  end
  
  # Range propagation for loop induction variables
  propagate_loop_ranges(f, &mut ranges)
  
  # Second pass with better range information
  for block in f.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirAssert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match (index_local, len_local)
        when (Option::Some(idx_lid), Option::Some(len_lid)) then
          if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
            block.terminator = MirTerminator {
              kind: MirTerminatorKind::MirGoto(success),
              span: block.terminator.span.clone()
            }
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  end
end

def extract_local_from_operand(op: &MirOperand) -> Option[LocalId]
  match op.kind
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

def extract_int_constant_from_rvalue(rv: &MirRvalue) -> Option[Int]
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    extract_int_constant(&op)
  when _ then Option::None
  end
end

def can_prove_bounds_check(index_local: LocalId, len_local: LocalId, ranges: &Map[Int, ValueRange],
                            block_id: BlockId, proven: &Set[(Int, Int, String)]) -> Bool
  # Check 1: Index is a constant in [0, len)
  match ranges.get(index_local.id)
  when Option::Some(idx_range) then
    match (idx_range.min, idx_range.max)
    when (Option::Some(min_val), Option::Some(max_val)) then
      if min_val >= 0 then
        match ranges.get(len_local.id)
        when Option::Some(len_range) then
          match len_range.min
          when Option::Some(min_len) then
            if max_val < min_len then
              return true
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    when _ then ()
    end
  when Option::None then ()
  end
  
  # Check 2: Already proven in a dominating block
  # (Simplified: check if same index/len pair was checked in an earlier block)
  if proven.contains((block_id.id, index_local.id, len_local.id.to_string())) then
    return true
  end
  
  false
end

def propagate_loop_ranges(f: &MirFunction, ranges: &mut Map[Int, ValueRange]) -> Unit
  # Find loop induction variables and compute their ranges
  let loops = find_natural_loops(f)
  
  for loop_info in loops do
    # Find induction variable patterns:
    # 1. i starts at 0 (or known value)
    # 2. i increments by constant each iteration
    # 3. Loop condition is i < len
    
    mut induction_vars: Vec[(LocalId, Int, Int)] = Vec::new()  # (var, start, step)
    
    # Look for typical induction patterns in loop blocks
    for block_id in loop_info.blocks do
      match get_block(f, BlockId { id: block_id })
      when Option::Some(block) then
        for stmt in block.statements do
          match stmt.kind
          when MirStatementKind::MirAssign(place, rvalue) then
            # Pattern: i = i + 1
            match rvalue.kind
            when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
              match (lhs.kind, extract_int_constant(&rhs))
              when (MirOperandKind::MirCopy(src_place), Option::Some(step)) then
                if src_place.local.id == place.local.id && place.projections.is_empty() then
                  # Found an induction variable
                  let start = ranges.get(place.local.id)
                    .map(|r| r.min.unwrap_or(0))
                    .unwrap_or(0)
                  induction_vars.push((place.local.clone(), start, step))
                end
              when _ then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
        
        # Check loop exit condition
        match block.terminator.kind
        when MirTerminatorKind::MirSwitchInt { op: cond_op, targets, default_target } then
          # If we have i < len as condition, we know i is bounded
          match cond_op.kind
          when MirOperandKind::MirCopy(p) then
            # Track that this variable is bounded by the loop
            if !p.projections.is_empty() then
              ()  # Skip complex projections
            end
          when _ then ()
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
    
    # Update ranges for induction variables
    for iv in induction_vars do
      let (var, start, step) = iv
      if step > 0 then
        # Increasing induction variable: min is start, max depends on loop bound
        ranges.insert(var.id, ValueRange {
          min: Option::Some(start),
          max: Option::None  # Unknown upper bound without more analysis
        })
      end
    end
  end
end

def simplify_moves(f: &mut MirFunction) -> Unit
  # Remove redundant moves: _x = Move(_x) or _x = Copy(_x) where src == dst.
  # Also remove chains like: _tmp = Move(_x); _y = Move(_tmp) → _y = Move(_x)
  # when _tmp has no other uses.
  
  # Pass 1: Remove self-assignments
  for block in f.blocks do
    mut new_stmts = Vec::new()
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if is_self_assignment(&place, &rvalue) then
          # Skip this statement — it's a no-op
          ()
        else
          new_stmts.push(stmt)
        end
      when _ then new_stmts.push(stmt)
      end
    end
    block.statements = new_stmts
  end
  
  # Pass 2: Count uses of each local
  mut use_count: Map[Int, Int] = Map::new()
  for local in f.locals do
    use_count.insert(local.id.id, 0)
  end
  for block in f.blocks do
    for stmt in block.statements do
      count_operand_uses(&stmt, &mut use_count)
    end
    count_terminator_uses(&block.terminator, &mut use_count)
  end
  
  # Pass 3: Eliminate single-use temporaries
  # If _tmp = Move(_x) and _y = Move(_tmp) and _tmp used only once, 
  # rewrite to _y = Move(_x)
  mut temp_source: Map[Int, Place] = Map::new()
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::MirMove(op) then
            match op.kind
            when MirOperandKind::MirMovePlace(src) then
              match use_count.get(place.local.id)
              when Option::Some(count) then
                if count <= 1 then
                  temp_source.insert(place.local.id, src)
                end
              when Option::None then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Apply temp_source substitution
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rvalue) then
        substitute_temp_moves(&mut rvalue, &temp_source)
      when _ then ()
      end
    end
    substitute_temp_moves_terminator(&mut block.terminator, &temp_source)
  end
end

# ———————————————————————————————————————————————————————————————
# Global Value Numbering (GVN)
# ———————————————————————————————————————————————————————————————
#
# Eliminates redundant computations by assigning a "value number" to each
# expression. If two expressions produce the same value number, the second
# one is replaced with a copy of the first result.
#
# Value number key = (operation, operand_value_numbers...)
# E.g., Add(VN(3), VN(5)) has a unique key; if we see it again, we reuse
# the result instead of recomputing.

def global_value_numbering(f: &mut MirFunction) -> Unit
  # Map: rvalue_key -> LocalId that already holds this value
  mut value_table: Map[String, LocalId] = Map::new()
  
  # Map: LocalId.id -> canonical value number (string)
  mut local_vn: Map[Int, String] = Map::new()
  mut vn_counter = 0
  mut unique_counter = 0
  
  # Assign initial value numbers to parameters (each is unique)
  for p in f.params do
    let vn = "p" + vn_counter.to_string()
    vn_counter = vn_counter + 1
    local_vn.insert(p.id.id, vn)
  end
  
  for block in f.blocks do
    mut new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          # Compute the value number key for this rvalue
          let mut rv_key = rvalue_to_vn_key(&rvalue, &local_vn)
          if rv_key == "__unique__" then
            rv_key = "__unique__" + unique_counter.to_string()
            unique_counter = unique_counter + 1
          end
          
          match value_table.get(rv_key.clone())
          when Option::Some(existing_local) then
            # Redundant computation — replace with copy
            let copy_rvalue = MirRvalue {
              kind: MirRvalueKind::MirMove(MirOperand {
                kind: MirOperandKind::MirCopy(place_local(existing_local.clone()))
              })
            }
            new_stmts.push(MirStatement {
              kind: MirStatementKind::MirAssign(place.clone(), copy_rvalue),
              span: stmt.span
            })
            # Inherit the value number
            match local_vn.get(existing_local.id) 
            when Option::Some(vn) then local_vn.insert(place.local.id, vn.clone())
            when Option::None then ()
            end
          when Option::None then
            # New computation — record it
            value_table.insert(rv_key.clone(), place.local.clone())
            local_vn.insert(place.local.id, rv_key)
            new_stmts.push(stmt.clone())
          end
        else
          new_stmts.push(stmt.clone())
        end
      when _ then new_stmts.push(stmt.clone())
      end
    end
    
    block.statements = new_stmts
  end
end

def rvalue_to_vn_key(rv: &MirRvalue, local_vn: &Map[Int, String]) -> String
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    "use(" + operand_to_vn(&op, local_vn) + ")"
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    let op_str = match op
    when MirBinOp::Add then "add"
    when MirBinOp::Sub then "sub"
    when MirBinOp::Mul then "mul"
    when MirBinOp::Div then "div"
    when MirBinOp::Mod then "mod"
    when MirBinOp::Eq then "eq"
    when MirBinOp::Ne then "ne"
    when MirBinOp::Lt then "lt"
    when MirBinOp::Le then "le"
    when MirBinOp::Gt then "gt"
    when MirBinOp::Ge then "ge"
    when MirBinOp::BitAnd then "band"
    when MirBinOp::BitOr then "bor"
    when MirBinOp::BitXor then "bxor"
    when MirBinOp::Shl then "shl"
    when MirBinOp::Shr then "shr"
    when _ then "?"
    end
    op_str + "(" + operand_to_vn(&lhs, local_vn) + "," + operand_to_vn(&rhs, local_vn) + ")"
  when MirRvalueKind::MirUnOp(op, inner) then
    let op_str = match op
    when MirUnOp::Neg then "neg"
    when MirUnOp::Not then "not"
    when MirUnOp::BitNot then "bnot"
    end
    op_str + "(" + operand_to_vn(&inner, local_vn) + ")"
  when MirRvalueKind::MirCast(kind, op, ty) then
    "cast(" + operand_to_vn(&op, local_vn) + ")"
  when _ then
    # Aggregates, refs, etc. — caller must stamp this with a monotonic id.
    "__unique__"
  end
end

def operand_to_vn(op: &MirOperand, local_vn: &Map[Int, String]) -> String
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(n) then "i" + n.to_string()
    when MirConstantKind::MirFloat(f) then "f" + f.to_string()
    when MirConstantKind::MirBool(b) then if b then "true" else "false" end
    when MirConstantKind::MirString(s) then "s\"" + s + "\""
    when MirConstantKind::MirUnit then "unit"
    when MirConstantKind::MirFnItem(name) then "fn:" + name
    when MirConstantKind::MirChar(c) then "c'" + c.to_string() + "'"
    when MirConstantKind::MirZeroSized then "zst"
    end
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Loop-Invariant Code Motion (LICM)
# ———————————————————————————————————————————————————————————————
#
# Identifies computations inside loops that produce the same result in
# every iteration and hoists them to the loop preheader.
#
# A statement is loop-invariant if:
#   - All its operands are defined outside the loop, OR
#   - All its operands are themselves loop-invariant

def loop_invariant_code_motion(f: &mut MirFunction) -> Unit
  # Step 1: Detect natural loops using back edges
  let loops = find_natural_loops(f)
  
  # Step 2: For each loop, find invariant statements and hoist them
  for loop_info in loops do
    hoist_loop_invariants(f, &loop_info)
  end
end

struct NaturalLoop
  header: BlockId
  blocks: Set[Int]     # Block IDs that form the loop body
  preheader: Option[BlockId]
end

def find_natural_loops(f: &MirFunction) -> Vec[NaturalLoop]
  # Find back edges and compute the natural loop for each.
  # A back edge is an edge n -> h where h is an ancestor on the current DFS path.
  # We need to distinguish between "on stack" (current path) and "fully processed".
  
  mut loops = Vec::new()

  mut predecessors: Map[Int, Vec[BlockId]] = Map::new()
  for block in f.blocks do
    predecessors.insert(block.id.id, Vec::new())
  end
  for block in f.blocks do
    for succ in terminator_successors(&block.terminator) do
      match predecessors.get_mut(succ.id)
      when Option::Some(preds) then
        preds.push(block.id)
      when Option::None then
        predecessors.insert(succ.id, Vec::from([block.id]))
      end
    end
  end
  
  # Use two sets: visited (all seen nodes) and on_stack (current DFS path)
  mut visited: Set[Int] = Set::new()
  mut on_stack: Set[Int] = Set::new()
  mut stack = Vec::new()
  
  # DFS with explicit stack - push (block_id, is_entering)
  # is_entering=true: first visit, is_entering=false: backtrack (remove from on_stack)
  stack.push((f.entry_block, true))
  
  mut back_edges: Vec[(BlockId, BlockId)] = Vec::new()
  
  while !stack.is_empty() do
    match stack.pop()
    when Option::Some((block_id, is_entering)) then
      if is_entering then
        if visited.contains(block_id.id) then
          # Already fully processed, skip
          ()
        else
          visited.insert(block_id.id)
          on_stack.insert(block_id.id)
          
          # Push backtrack marker first (will be popped after all successors)
          stack.push((block_id, false))
          
          match get_block(f, block_id)
          when Option::Some(block) then
            for succ in terminator_successors(&block.terminator) do
              if on_stack.contains(succ.id) then
                # Back edge: edge to an ancestor on current path
                back_edges.push((block_id, succ))
              elsif !visited.contains(succ.id) then
                # Tree edge: visit successor
                stack.push((succ, true))
              end
              # else: cross edge to already-processed node, not a back edge
            end
          when Option::None then ()
          end
        end
      else
        # Backtracking: remove from on_stack
        on_stack.remove(block_id.id)
      end
    when Option::None then ()
    end
  end
  
  # For each back edge, compute the natural loop
  for edge in back_edges do
    let (tail, header) = edge
    mut loop_blocks: Set[Int] = Set::new()
    loop_blocks.insert(header.id)
    
    # Flood backwards from tail to header to find loop body
    if tail.id != header.id then
      mut worklist = Vec::new()
      worklist.push(tail)
      loop_blocks.insert(tail.id)
      
      while !worklist.is_empty() do
        match worklist.pop()
        when Option::Some(n) then
          match predecessors.get(n.id)
          when Option::Some(preds) then
            for pred in preds do
              if !loop_blocks.contains(pred.id) then
                loop_blocks.insert(pred.id)
                worklist.push(pred)
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    end
    
    loops.push(NaturalLoop {
      header: header,
      blocks: loop_blocks,
      preheader: Option::None   # Will be created if needed
    })
  end
  
  loops
end

def hoist_loop_invariants(f: &mut MirFunction, loop_info: &NaturalLoop) -> Unit
  # Find definitions inside the loop
  mut loop_defs: Set[Int] = Set::new()
  for block in f.blocks do
    if loop_info.blocks.contains(block.id.id) then
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, _) then
          loop_defs.insert(place.local.id)
        when _ then ()
        end
      end
    end
  end
  
  # Find loop-invariant statements:
  # An assignment is invariant if all its operand locals are defined outside the loop
  mut invariant_stmts: Vec[MirStatement] = Vec::new()
  
  for block in f.blocks do
    if loop_info.blocks.contains(block.id.id) && block.id.id != loop_info.header.id then
      mut remaining_stmts = Vec::new()
      for stmt in block.statements do
        if is_loop_invariant_stmt(&stmt, &loop_defs) then
          invariant_stmts.push(stmt.clone())
        else
          remaining_stmts.push(stmt.clone())
        end
      end
      block.statements = remaining_stmts
    end
  end
  
  # If we found invariant statements, insert them into a preheader block
  # The preheader executes once before the loop, not on every iteration
  if !invariant_stmts.is_empty() then
    mut outside_preds: Vec[BlockId] = Vec::new()
    for pred_block in f.blocks do
      if loop_info.blocks.contains(pred_block.id.id) then
        continue
      end
      for succ in terminator_successors(&pred_block.terminator) do
        if succ.id == loop_info.header.id then
          outside_preds.push(pred_block.id.clone())
          break
        end
      end
    end

    let preheader_id = if outside_preds.len() == 1 then
      outside_preds[0].clone()
    else
      let ph_id = BlockId { id: f.blocks.len() as Int }
      let ph_span = match get_block(f, loop_info.header)
      when Option::Some(header_block) then header_block.terminator.span
      when Option::None then span_dummy()
      end

      f.blocks.push(MirBlock {
        id: ph_id.clone(),
        statements: Vec::new(),
        terminator: MirTerminator {
          kind: MirTerminatorKind::MirGoto(loop_info.header),
          span: ph_span
        }
      })

      for pred_id in outside_preds do
        match get_block_mut(f, pred_id)
        when Option::Some(pred_block) then
          redirect_terminator_edge(&mut pred_block.terminator, loop_info.header.id, ph_id.id)
        when Option::None then ()
        end
      end

      if f.entry_block.id == loop_info.header.id then
        f.entry_block = ph_id.clone()
      end

      ph_id
    end

    match get_block_mut(f, preheader_id)
    when Option::Some(preheader_block) then
      for inv_stmt in invariant_stmts do
        preheader_block.statements.push(inv_stmt)
      end
    when Option::None then ()
    end
  end
end

def redirect_terminator_edge(term: &mut MirTerminator, from_id: Int, to_id: Int) -> Unit
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    if target.id == from_id then
      term.kind = MirTerminatorKind::MirGoto(BlockId { id: to_id })
    end
  when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
    mut new_targets = Vec::new()
    for t in targets do
      if t.target.id == from_id then
        new_targets.push(SwitchTarget { value: t.value, target: BlockId { id: to_id } })
      else
        new_targets.push(t)
      end
    end
    let new_fallback = if default_target.id == from_id then BlockId { id: to_id } else default_target end
    term.kind = MirTerminatorKind::MirSwitchInt(op, new_targets, new_fallback)
  when _ then ()
  end
end

def is_loop_invariant_stmt(stmt: &MirStatement, loop_defs: &Set[Int]) -> Bool
  match stmt.kind
  when MirStatementKind::MirAssign(_, rvalue) then
    is_loop_invariant_rvalue(&rvalue, loop_defs)
  when _ then false
  end
end

def is_loop_invariant_rvalue(rv: &MirRvalue, loop_defs: &Set[Int]) -> Bool
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    is_loop_invariant_operand(&lhs, loop_defs) &&
    is_loop_invariant_operand(&rhs, loop_defs)
  when MirRvalueKind::MirUnOp(_, op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::MirCast(_, op, _) then
    is_loop_invariant_operand(&op, loop_defs)
  when _ then false  # Aggregates, refs — don't move
  end
end

def is_loop_invariant_operand(op: &MirOperand, loop_defs: &Set[Int]) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(_) then true  # Constants are always invariant
  when MirOperandKind::MirCopy(place) then
    !loop_defs.contains(place.local.id)  # Not defined inside loop
  when MirOperandKind::MirMovePlace(place) then
    !loop_defs.contains(place.local.id)
  end
end

def get_block_mut(f: &mut MirFunction, id: BlockId) -> Option[&mut MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(&mut block)
    end
  end
  Option::None
end

def is_self_assignment(place: &Place, rvalue: &MirRvalue) -> Bool
  if !place.projections.is_empty() then
    return false
  end
  match rvalue.kind
  when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirCopy(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when MirOperandKind::MirMovePlace(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when _ then false
    end
  when _ then false
  end
end

def count_operand_uses(stmt: &MirStatement, counts: &mut Map[Int, Int]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(_, rvalue) then
    count_rvalue_uses(&rvalue, counts)
  when MirStatementKind::MirContractCheck(_, op) then
    count_op_uses(&op, counts)
  when MirStatementKind::MirEffectRecord(_, op) then
    count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_op_uses(op: &MirOperand, counts: &mut Map[Int, Int]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when MirOperandKind::MirMovePlace(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when _ then ()
  end
end

def count_rvalue_uses(rv: &MirRvalue, counts: &mut Map[Int, Int]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then count_op_uses(&op, counts)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    count_op_uses(&lhs, counts)
    count_op_uses(&rhs, counts)
  when MirRvalueKind::MirUnOp(_, op) then count_op_uses(&op, counts)
  when MirRvalueKind::MirAggregate(_, ops) then
    for o in ops do count_op_uses(&o, counts) end
  when MirRvalueKind::MirCast(_, op, _) then count_op_uses(&op, counts)
  when MirRvalueKind::MirRepeat(op, _) then count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_terminator_uses(term: &MirTerminator, counts: &mut Map[Int, Int]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then count_op_uses(&op, counts)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind } then
    count_op_uses(&func, counts)
    for a in args do count_op_uses(&a, counts) end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then count_op_uses(&cond, counts)
  when MirTerminatorKind::MirYield(op, target) then count_op_uses(&op, counts)
  when MirTerminatorKind::MirGoto(_) then ()
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirDrop { place, target, unwind } then ()
  when MirTerminatorKind::MirAbort then ()
  end
end

def substitute_temp_moves(rv: &mut MirRvalue, map: &Map[Int, Place]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    substitute_move_operand(&mut lhs, map)
    substitute_move_operand(&mut rhs, map)
  when MirRvalueKind::MirUnOp(_, op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::MirAggregate(_, ops) then
    for o in ops do substitute_move_operand(&mut o, map) end
  when _ then ()
  end
end

def substitute_temp_moves_terminator(term: &mut MirTerminator, map: &Map[Int, Place]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    let mut op2 = op
    substitute_move_operand(&mut op2, map)
    let new_kind = MirTerminatorKind::MirSwitchInt { op: op2, targets: targets, default_target: default_target }
    term.kind = new_kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind } then
    # Note: dest is Place, not MirOperand
    mut dest2 = dest
    match map.get(dest2.local.id)
    when Option::Some(src) then
      if dest2.projections.is_empty() then
        dest2 = src.clone()
      end
    when Option::None then ()
    end
    mut func2 = func
    substitute_move_operand(&mut func2, map)
    mut args2 = args
    for a in args2 do substitute_move_operand(&mut a, map) end
    let new_kind = MirTerminatorKind::MirCall { dest: dest2, func: func2, args: args2, success: success, unwind: unwind }
    term.kind = new_kind
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    mut cond2 = cond
    substitute_move_operand(&mut cond2, map)
    let new_kind = MirTerminatorKind::MirAssert { cond: cond2, expected: expected, msg: msg, target: target, unwind: unwind }
    term.kind = new_kind
  when MirTerminatorKind::MirYield(op, target) then
    mut op2 = op
    substitute_move_operand(&mut op2, map)
    let new_kind = MirTerminatorKind::MirYield(op2, target)
    term.kind = new_kind
  when MirTerminatorKind::MirDrop { place, target, unwind } then
    mut place2 = place
    match map.get(place2.local.id)
    when Option::Some(src) then
      if place2.projections.is_empty() then
        place2 = src.clone()
      end
    when Option::None then ()
    end
    let new_kind = MirTerminatorKind::MirDrop { place: place2, target: target, unwind: unwind }
    term.kind = new_kind
  when _ then ()
  end
end

def substitute_move_operand(op: &mut MirOperand, map: &Map[Int, Place]) -> Unit
  match op.kind
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(src) then
        op.kind = MirOperandKind::MirMovePlace(src.clone())
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def get_block(f: &MirFunction, id: BlockId) -> Option[MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(block)
    end
  end
  Option::None
end

def terminator_successors(term: &MirTerminator) -> Vec[BlockId]
  mut result = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    result.push(target)
  when MirTerminatorKind::MirSwitchInt(_, targets, default_target) then
    for t in targets do
      result.push(t.target)
    end
    result.push(default_target)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind } then
    result.push(success)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::MirDrop { place, target, unwind } then
    result.push(target)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    result.push(target)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::MirYield(op, resume) then
    result.push(resume)
  when _ then ()
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Escape Analysis
# ———————————————————————————————————————————————————————————————
#
# Determines whether heap-allocated values can be promoted to stack storage.
# A local "escapes" if its address is observable outside its defining function:
#   - Passed to a function call (ArgEscape)
#   - Stored into a global or field reachable from a global (GlobalEscape)
#   - Returned from the function (GlobalEscape)
#   - Taken by mutable reference that itself escapes (transitive)
#
# Non-escaping heap allocations (Box/Vec/Map/closures) are rewritten as stack
# allocations, eliminating malloc/free and improving cache locality.

enum EscapeState
  NoEscape
  ArgEscape      # Escapes to a callee argument (may be safe if callee is inlined)
  GlobalEscape   # Escapes globally — cannot promote
end

def escape_analysis(f: &mut MirFunction) -> Unit
  let escape_map = compute_escape_states(f)

  # Collect locals that don't escape — eligible for stack promotion
  mut non_escaping: Set[Int] = Set::new()
  for entry in escape_map.entries() do
    let lid = entry.0
    let state = entry.1
    match state
    when EscapeState::NoEscape then
      non_escaping.insert(lid)
    when _ then ()
    end
  end

  if !non_escaping.is_empty() then
    promote_heap_to_stack(f, &non_escaping)
  end
end

def compute_escape_states(f: &MirFunction) -> Map[Int, EscapeState]
  mut states: Map[Int, EscapeState] = Map::new()

  # Initialize all locals as NoEscape
  for local in f.locals do
    states.insert(local.id.id, EscapeState::NoEscape)
  end
  for param in f.params do
    # Parameters escape by default — caller provides them
    states.insert(param.id.id, EscapeState::ArgEscape)
  end

  # Iterate until stable (simple fixpoint)
  mut changed = true
  while changed do
    changed = false

    for block in f.blocks do
      # Analyze statements
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          let rhs_escape = rvalue_escape_state(&rvalue, &states)
          let dest_id = place.local.id
          # If a reference escapes, the referent escapes too
          match rvalue.kind
          when MirRvalueKind::MirRef(src_place) then
            # Taking a reference — the source escapes if the dest escapes
            let dest_state = lookup_escape(&states, dest_id)
            let src_id = src_place.local.id
            if escalate_escape(&mut states, src_id, dest_state) then
              changed = true
            end
          when MirRvalueKind::MirRefMut(src_place) then
            let dest_state = lookup_escape(&states, dest_id)
            let src_id = src_place.local.id
            if escalate_escape(&mut states, src_id, dest_state) then
              changed = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end

      # Analyze terminators
      match block.terminator.kind
      when MirTerminatorKind::MirCall { dest, func, args, success, unwind } then
        # Arguments passed to calls escape to at least ArgEscape
        for arg in args do
          match arg.kind
          when MirOperandKind::MirMovePlace(p) then
            if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
              changed = true
            end
          when MirOperandKind::MirCopy(p) then
            if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
              changed = true
            end
          when _ then ()
          end
        end
        # Destination also escapes (returned from call)
        if escalate_escape(&mut states, dest.local.id, EscapeState::ArgEscape) then
          changed = true
        end
      when MirTerminatorKind::MirReturn then
        # Return value escapes globally
        # local _0 is the return slot by convention
        if escalate_escape(&mut states, 0, EscapeState::GlobalEscape) then
          changed = true
        end
      when _ then ()
      end
    end
  end

  states
end

def lookup_escape(states: &Map[Int, EscapeState], id: Int) -> EscapeState
  match states.get(&id)
  when Option::Some(s) then s.clone()
  when Option::None then EscapeState::NoEscape
  end
end

def escalate_escape(states: &mut Map[Int, EscapeState], id: Int, new_state: EscapeState) -> Bool
  let current = lookup_escape(states, id)
  let current_rank = escape_rank(current)
  let new_rank = escape_rank(new_state)
  if new_rank > current_rank then
    states.insert(id, new_state)
    true
  else
    false
  end
end

def escape_rank(state: EscapeState) -> Int
  match state
  when EscapeState::NoEscape then 0
  when EscapeState::ArgEscape then 1
  when EscapeState::GlobalEscape then 2
  end
end

def rvalue_escape_state(rv: &MirRvalue, states: &Map[Int, EscapeState]) -> EscapeState
  match rv.kind
  when MirRvalueKind::MirMove(op) then operand_escape_state(&op, states)
  when MirRvalueKind::MirRef(place) then lookup_escape(states, place.local.id)
  when MirRvalueKind::MirRefMut(place) then lookup_escape(states, place.local.id)
  when _ then EscapeState::NoEscape
  end
end

def operand_escape_state(op: &MirOperand, states: &Map[Int, EscapeState]) -> EscapeState
  match op.kind
  when MirOperandKind::MirCopy(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirMovePlace(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirConstant(_) then EscapeState::NoEscape
  end
end

def local_stack_promotion_size_bytes(f: &MirFunction, local_id: Int) -> Int
  for local in f.locals do
    if local.id.id == local_id then
      return estimated_type_size_bytes(&local.ty)
    end
  end
  8192
end

def estimated_type_size_bytes(ty: &Type) -> Int
  match ty
  when Type::Unit then 0
  when Type::Bool then 1
  when Type::Char then 4
  when Type::Int then 8
  when Type::Float then 8
  when Type::String then 24
  when Type::Ref(_, _) then 8
  when Type::RefMut(_, _) then 8
  when Type::Owned(_) then 8
  when Type::Slice(_) then 16
  when Type::Function(_, _) then 8
  when Type::Named(_, _) then 8
  when Type::Tuple(fields) then
    mut total = 0
    for field_ty in fields do
      total = total + estimated_type_size_bytes(field_ty)
    end
    total
  when Type::Array(elem_ty, count) then
    estimated_type_size_bytes(elem_ty) * count
  when _ then 8192
  end
end

def promote_heap_to_stack(f: &mut MirFunction, non_escaping: &Set[Int]) -> Unit
  # Rewrite heap allocation calls (Box::new, alloc::allocate) to stack alloca
  # when the destination local does not escape.
  let MAX_STACK_PROMOTION_BYTES = 4096
  for block in f.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func: callee, args, success: succ, unwind } then
      # Check if this is a heap allocation call to a non-escaping destination
      let is_alloc = match callee.kind
      when MirOperandKind::MirConstant(c) then
        match c.kind
        when MirConstantKind::MirFnItem(name) then
          name == "Box::new" || name == "alloc::allocate" || name == "Vec::new" ||
          name == "Map::new" || name == "Set::new"
        when _ then false
        end
      when _ then false
      end

      let estimated_size = local_stack_promotion_size_bytes(f, dest.local.id)
      if is_alloc && non_escaping.contains(&dest.local.id) && estimated_size <= MAX_STACK_PROMOTION_BYTES then
        # Replace the call with a stack allocation:
        # Instead of: _X = Box::new(val) -> bb_succ
        # Produce:    _X = StackAlloc(val) as a statement; goto bb_succ
        #
        # We rewrite the terminator to a simple Goto and prepend an Assign.
        # For Vec/Map/Set::new (no args), we leave as an inline struct init.
        if !args.is_empty() then
          let val = args[0].clone()
          let assign_stmt = MirStatement {
            kind: MirStatementKind::MirAssign(
              dest.clone(),
              MirRvalue { kind: MirRvalueKind::MirMove(val) }
            ),
            span: block.terminator.span.clone()
          }
          block.statements.push(assign_stmt)
        end
        block.terminator = MirTerminator {
          kind: MirTerminatorKind::MirGoto(succ),
          span: block.terminator.span.clone()
        }
      end
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Profile-Guided Optimization (PGO)
# ———————————————————————————————————————————————————————————————
#
# Two-phase PGO workflow:
#   1. Instrumentation: `tg build --pgo-gen=profile.dat` inserts edge counters
#      at every basic block entry.  Running the instrumented binary writes
#      a profile data file.
#   2. Optimization:    `tg build --pgo-use=profile.dat` reads the profile,
#      attaches branch weights, and feeds them to:
#      - Inlining heuristics (hot callees get larger threshold)
#      - Block layout / branch prediction hints
#      - Loop unrolling decisions

struct PgoProfile
  # Maps (function_name, block_id) -> execution count
  block_counts: Map[String, Vec[PgoBlockCount]]
end

struct PgoBlockCount
  block_id: Int
  count: UInt
end

def load_pgo_profile(path: &String) -> Option[PgoProfile]
  match read_file_string(path)
  when Result::Ok(content) then
    Option::Some(parse_pgo_profile(&content))
  when Result::Err(_) then
    Option::None
  end
end

def parse_pgo_profile(content: &String) -> PgoProfile
  mut profile = PgoProfile { block_counts: Map::new() }
  for line in content.lines() do
    let trimmed = line.trim()
    if trimmed.is_empty() || trimmed.starts_with("#") then next end
    # Format: func_name TAB block_id TAB count
    let parts = trimmed.split("\t")
    if parts.len() >= 3 then
      let func_name = parts[0].clone()
      let block_id = parts[1].parse_int().unwrap_or(0)
      let count = parts[2].parse_uint().unwrap_or(0)
      if !profile.block_counts.contains_key(&func_name) then
        profile.block_counts.insert(func_name.clone(), Vec::new())
      end
      match profile.block_counts.get_mut(&func_name)
      when Option::Some(counts) then
        counts.push(PgoBlockCount { block_id: block_id, count: count })
      when Option::None then ()
      end
    end
  end
  profile
end

def save_pgo_profile(path: &String, profile: &PgoProfile) -> Unit
  mut out = "# Tangerine PGO profile data\n"
  out = out + "# func_name\tblock_id\tcount\n"
  for entry in profile.block_counts.entries() do
    let func_name = entry.0
    let counts = entry.1
    for bc in counts do
      out = out + func_name.clone() + "\t" + bc.block_id.to_string() + "\t" + bc.count.to_string() + "\n"
    end
  end
  write_file_string(path, &out)
end

def instrument_for_pgo(program: &mut MirProgram) -> Unit
  # Insert counter increments at the start of every basic block.
  # At runtime, each counter slot maps to (func_name, block_id).
  # A global counter array is emitted as a static; an atexit handler
  # flushes it to the profile path.
  
  mut counter_id = 0
  for func in program.functions do
    if func.is_extern then next end
    
    for block in func.blocks do
      # Prepend: __pgo_counters[counter_id] += 1
      let increment = MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirInt(1),
          ty: Type::Int
        })
      }
      let counter_stmt = MirStatement {
        kind: MirStatementKind::MirEffectRecord("__pgo_counter_" + counter_id.to_string(), increment),
        span: block.terminator.span
      }
      # Insert at position 0
      mut new_stmts = Vec::new()
      new_stmts.push(counter_stmt)
      for s in block.statements do
        new_stmts.push(s.clone())
      end
      block.statements = new_stmts
      counter_id = counter_id + 1
    end
  end
end

def apply_pgo_optimizations(program: &mut MirProgram) -> Unit
  # Try loading a PGO profile from the default path
  let profile = match load_pgo_profile(&".tg_pgo_profile".to_string())
  when Option::Some(p) then p
  when Option::None then return  # No profile available
  end

  for func in program.functions do
    let func_name = func.name.clone()
    match profile.block_counts.get(&func_name)
    when Option::Some(counts) then
      apply_pgo_to_function(func, counts)
    when Option::None then ()
    end
  end
end

def apply_pgo_to_function(f: &mut MirFunction, counts: &Vec[PgoBlockCount]) -> Unit
  # Build a count map for quick lookup
  mut count_map: Map[Int, UInt] = Map::new()
  for bc in counts do
    count_map.insert(bc.block_id, bc.count)
  end

  # Use profile data to guide optimization:
  # 1. Cold blocks (count == 0): mark as unlikely — branch hints
  # 2. Hot blocks: unroll loops whose header is hot
  # 3. Hot call sites: increase inlining threshold

  # Sort blocks so hot blocks come first (better cache locality)
  mut block_order: Vec[(Int, UInt)] = Vec::new()
  for block in f.blocks do
    let count = match count_map.get(&block.id.id)
    when Option::Some(c) then c
    when Option::None then 0
    end
    block_order.push((block.id.id, count))
  end

  # Loop unrolling for hot loops
  # If a back-edge block has count > 1000 and the loop body is small
  # (< 20 stmts), duplicate the body once
  mut loops_to_unroll: Vec[(Int, Int)] = Vec::new()  # (header_id, back_edge_block)
  
  for block in f.blocks do
    let block_count = match count_map.get(&block.id.id)
    when Option::Some(c) then c
    when Option::None then 0
    end

    if block_count > 1000 then
      match block.terminator.kind
      when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
        # Check for back-edges (target block id < current block id → likely a loop)
        for t in targets do
          if t.target.id < block.id.id then
            # This is a hot back-edge — record for unrolling
            let header_id = t.target.id
            # Check if loop body is small (blocks between header and back-edge)
            let body_size = block.id.id - header_id + 1
            if body_size <= 10 then
              loops_to_unroll.push((header_id, block.id.id))
            end
          end
        end
    when MirTerminatorKind::MirGoto(target) then
      if target.id < block.id.id then
        let header_id = target.id
        let body_size = block.id.id - header_id + 1
        if body_size <= 10 then
          loops_to_unroll.push((header_id, block.id.id))
        end
      end
      when _ then ()
      end
    end
  end
  
  # Perform loop unrolling by duplicating blocks
  for entry in loops_to_unroll do
    let header_id = entry.0
    let back_edge_id = entry.1
    let next_block_id = f.blocks.len() as Int
    
    # Clone the loop body blocks (from header to back-edge, inclusive)
    mut cloned_blocks: Vec[MirBlock] = Vec::new()
    let mut id_offset = next_block_id - header_id
    
    for block in f.blocks do
      if block.id.id >= header_id && block.id.id <= back_edge_id then
        # Clone this block with new ID
        let mut new_block = block.clone()
        new_block.id = BlockId { id: block.id.id + id_offset }
        
        # Update terminator targets
        match new_block.terminator.kind
        when MirTerminatorKind::MirGoto(target) then
          new_block.terminator.kind = MirTerminatorKind::MirGoto(BlockId { id: target.id + id_offset })
        when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
          mut remapped_targets = Vec::new()
          for t in targets do
            remapped_targets.push(SwitchTarget { value: t.value, target: BlockId { id: t.target.id + id_offset } })
          end
          new_block.terminator.kind = MirTerminatorKind::MirSwitchInt { op: op, targets: remapped_targets, default_target: default_target }
        when _ then ()
        end
        
        cloned_blocks.push(new_block)
      end
    end
    
    # Wire the original back-edge to the cloned header
    for block in f.blocks do
      if block.id.id == back_edge_id then
        match block.terminator.kind
        when MirTerminatorKind::MirGoto(target) then
          if target.id == header_id then
            block.terminator.kind = MirTerminatorKind::MirGoto { target: BlockId { id: header_id + id_offset } }
          end
        when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
          mut remapped_targets = Vec::new()
          for t in targets do
            if t.target.id == header_id then
              remapped_targets.push(SwitchTarget { value: t.value, target: BlockId { id: header_id + id_offset } })
            else
              remapped_targets.push(t)
            end
          end
          block.terminator.kind = MirTerminatorKind::MirSwitchInt { op: op, targets: remapped_targets, default_target: default_target }
        when _ then ()
        end
        break
      end
    end
    
    # Add cloned blocks to function
    for cblock in cloned_blocks do
      f.blocks.push(cblock)
    end
  end
end

def read_pgo_profile(path: &String) -> Result[PgoProfile, String]
  match load_pgo_profile(path)
  when Option::Some(profile) then
    Result::Ok(profile)
  when Option::None then
    Result::Err("could not read or parse profile at " + path.clone())
  end
end

def apply_pgo_profile(program: &mut MirProgram, profile: &PgoProfile) -> Unit
  for func in program.functions do
    let func_name = func.name.clone()
    match profile.block_counts.get(&func_name)
    when Option::Some(counts) then
      apply_pgo_to_function(func, counts)
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Async/Await State Machine Transformation
# ———————————————————————————————————————————————————————————————
#
# Transforms async functions into state machines:
#   - Each yield/await point becomes a state
#   - A state discriminant local tracks the current state
#   - The function becomes a poll() method on a generated Future struct
#   - Locals that live across yield points are promoted to struct fields
#
# Generated layout:
#   struct __AsyncFn_<name> {
#     state: Int               // Current state discriminant
#     local_1: T1              // Locals live across yields
#     local_2: T2
#     ...
#   }
#
#   impl Future for __AsyncFn_<name> {
#     fn poll(&mut self, cx: &mut Context) -> Poll<ReturnType>
#   }

struct AsyncStateMachine
  original_name: String
  state_struct_name: String
  states: Vec[AsyncState]
  cross_yield_locals: Set[Int]   # LocalId.id values that live across yields
end

struct AsyncState
  id: Int
  entry_block: BlockId
  exit_kind: AsyncExitKind
end

enum AsyncExitKind
  Yield(BlockId)      # Yields to a resume block
  Return              # Final return
  Continue(BlockId)   # Non-suspending transition
end

def transform_async_functions(program: &mut MirProgram) -> Unit
  # Process all async functions — transform them into state machines
  mut new_functions = Vec::new()
  
  for func in program.functions do
    if func.is_async then
      let transformed = transform_async_function(&func)
      new_functions.push(transformed)
    else
      new_functions.push(func.clone())
    end
  end
  
  program.functions = new_functions
end

def transform_async_function(func: &MirFunction) -> MirFunction
  # Step 1: Find all yield/await points
  let yield_points = find_yield_points(func)
  
  if yield_points.is_empty() then
    # No yields — just make it synchronous
    return func.clone()
  end
  
  # Step 2: Find locals that live across yield points
  let cross_yield = find_cross_yield_locals(func, &yield_points)
  
  # Step 3: Assign state IDs to blocks
  # State 0 = initial entry
  # Each yield point creates a new state for its resume
  mut state_counter = 0
  mut block_to_state: Map[Int, Int] = Map::new()
  
  # Initial state starts at the entry block
  block_to_state.insert(func.entry_block.id, 0)
  state_counter = 1
  
  # Each yield resume point gets a new state
  for yield_block in yield_points do
    match get_block(func, yield_block)
    when Option::Some(block) then
    match block.terminator.kind
    when MirTerminatorKind::MirYield(value, resume) then
      block_to_state.insert(resume.id, state_counter)
      state_counter = state_counter + 1
    when _ then ()
    end
    when Option::None then ()
    end
  end
  
  # Step 4: Transform the function
  # Add a state discriminant local
  mut new_func = func.clone()
  new_func.name = "__poll_" + func.name.clone()
  
  let state_local = MirLocal {
    id: LocalId { id: new_func.locals.len() },
    name: "__state".to_string(),
    ty: Type::Int,
    is_mut: true,
    span: func.span
  }
  new_func.locals.push(state_local.clone())
  
  # Step 5: Rewrite yield terminators as:
  #   1. Save state discriminant
  #   2. Return Poll::Pending
  # And add state dispatch at the entry:
  #   switch(__state) -> [0: bb0, 1: resume1, 2: resume2, ...]
  
  let dispatch_block = MirBlock {
    id: BlockId { id: new_func.blocks.len() },
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,  # Will be replaced
      span: func.span
    }
  }
  
  # Build switch targets for the dispatch
  mut switch_targets = Vec::new()
  for entry in block_to_state do
    switch_targets.push(SwitchTarget {
      value: entry.value,
      target: BlockId { id: entry.key }
    })
  end
  
  # Set dispatch terminator: switch on state local
  let state_operand = MirOperand {
    kind: MirOperandKind::MirCopy(place_local(state_local.id))
  }
  
  let dispatch = MirBlock {
    id: dispatch_block.id,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirSwitchInt(
        state_operand,
        switch_targets,
        func.entry_block   # Default to entry state
      ),
      span: func.span
    }
  }
  new_func.blocks.push(dispatch)
  new_func.entry_block = dispatch.id
  
  # Step 6: Rewrite Yield terminators
  for block in new_func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirYield(value, resume) then
      # Save the resume state
      let resume_state_id = match block_to_state.get(resume.id)
      when Option::Some(s) then s
      when Option::None then 0
      end
      
      # Replace with: assign state = resume_state; return Poll::Pending
      block.statements.push(MirStatement {
        kind: MirStatementKind::MirAssign(
          place_local(state_local.id),
          MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirInt(resume_state_id),
              ty: Type::Int
            })
          }) }
        ),
        span: func.span
      })
      
      # Store the yielded value in return place
      block.statements.push(MirStatement {
        kind: MirStatementKind::MirAssign(
          place_local(LocalId { id: 0 }),
          MirRvalue { kind: MirRvalueKind::MirMove(value.clone()) }
        ),
        span: func.span
      })
      
      block.terminator = MirTerminator {
        kind: MirTerminatorKind::MirReturn,
        span: func.span
      }
    when _ then ()
    end
  end
  
  new_func
end

def find_yield_points(func: &MirFunction) -> Vec[BlockId]
  mut yields = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirYield(_, _) then
      yields.push(block.id)
    when _ then ()
    end
  end
  yields
end

def find_cross_yield_locals(func: &MirFunction, yield_points: &Vec[BlockId]) -> Set[Int]
  # Find locals that are defined before a yield and used after a yield.
  # These need to be stored in the coroutine state struct.
  mut cross: Set[Int] = Set::new()
  if yield_points.is_empty() then
    return cross
  end

  # Build CFG successor and predecessor maps
  mut succs: Map[Int, Vec[Int]] = Map::new()
  mut preds: Map[Int, Vec[Int]] = Map::new()
  for block in func.blocks do
    succs.insert(block.id.id, Vec::new())
    preds.insert(block.id.id, Vec::new())
  end
  for block in func.blocks do
    for succ in terminator_successors(&block.terminator) do
      match succs.get(block.id.id)
      when Option::Some(list) then list.push(succ.id)
      when Option::None then ()
      end
      match preds.get(succ.id)
      when Option::Some(list) then list.push(block.id.id)
      when Option::None then ()
      end
    end
  end

  # Mark blocks that can reach any yield block (defs before yield candidates)
  mut can_reach_yield: Set[Int] = Set::new()
  mut reverse_worklist: Vec[Int] = Vec::new()
  for yp in yield_points do
    can_reach_yield.insert(yp.id)
    reverse_worklist.push(yp.id)
  end
  while !reverse_worklist.is_empty() do
    match reverse_worklist.pop()
    when Option::Some(current) then
      match preds.get(current)
      when Option::Some(ps) then
        for p in ps do
          if !can_reach_yield.contains(p) then
            can_reach_yield.insert(p)
            reverse_worklist.push(*p)
          end
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  end

  # Mark blocks reachable from any yield resume target (uses after yield)
  mut after_yield_blocks: Set[Int] = Set::new()
  mut forward_worklist: Vec[Int] = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirYield(value, resume) then
      if !after_yield_blocks.contains(resume.id) then
        after_yield_blocks.insert(resume.id)
        forward_worklist.push(resume.id)
      end
    when _ then ()
    end
  end
  while !forward_worklist.is_empty() do
    match forward_worklist.pop()
    when Option::Some(current) then
      match succs.get(current)
      when Option::Some(ss) then
        for s in ss do
          if !after_yield_blocks.contains(s) then
            after_yield_blocks.insert(*s)
            forward_worklist.push(*s)
          end
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  
  # Build def/use sets using CFG-aware before/after-yield block sets
  mut defs_before_yield: Set[Int] = Set::new()
  mut uses_after_yield: Set[Int] = Set::new()
  
  for block in func.blocks do
    let defs_matter = can_reach_yield.contains(block.id.id)
    let uses_matter = after_yield_blocks.contains(block.id.id)
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if defs_matter then
          defs_before_yield.insert(place.local.id)
        end
        # Track uses in the rvalue
        match rvalue.kind
        when MirRvalueKind::MirMove(op) then
          match op.kind
          when MirOperandKind::MirCopy(p) then
            if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then
            if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when MirRvalueKind::MirBinOp(_, lhs, rhs) then
          match lhs.kind
          when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
          match rhs.kind
          when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when MirRvalueKind::MirUnOp(_, op) then
          match op.kind
          when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when MirRvalueKind::MirCast(_, op, _) then
          match op.kind
          when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when MirRvalueKind::MirRepeat(op, _) then
          match op.kind
          when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when MirRvalueKind::MirRef(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
        when MirRvalueKind::MirRefMut(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
        when MirRvalueKind::MirLen(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
        when MirRvalueKind::MirDiscriminant(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
        when MirRvalueKind::MirAggregate(_, ops) then
          for op in ops do
            match op.kind
            when MirOperandKind::MirCopy(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
            when MirOperandKind::MirMovePlace(p) then if uses_matter then uses_after_yield.insert(p.local.id) end
            when _ then ()
            end
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  end
  
  # Cross-yield locals are those defined before AND used after a yield
  for local_id in defs_before_yield do
    if uses_after_yield.contains(local_id) then
      cross.insert(local_id)
    end
  end
  
  cross
end

# ———————————————————————————————————————————————————————————————
# SSA Conversion
# ———————————————————————————————————————————————————————————————
#
# Converts MIR to strict SSA form:
# 1. Compute dominance tree and dominance frontiers
# 2. Insert Phi nodes at appropriate join points
# 3. Rename variables with version numbering

struct DomInfo
  idom: Map[Int, Int]         # immediate dominator: block_id -> dominator_id
  dom_frontier: Map[Int, Vec[Int]]  # dominance frontier lists
  dom_tree_children: Map[Int, Vec[Int]]  # dominator tree children
end

def convert_to_ssa(f: &mut MirFunction) -> Unit
  let dom_info = compute_dominators(f)
  insert_phi_nodes(f, &dom_info)
  rename_variables(f, &dom_info)
end

def compute_dominators(f: &MirFunction) -> DomInfo
  # Convert entry block to Int
  let entry = f.entry_block.id
  
  # Map each block ID to index for iteration
  mut block_ids = Vec::new()
  for block in f.blocks do
    block_ids.push(block.id.id)
  end
  
  # Initialize dominators: idom[entry] = entry, others = undefined (-1)
  mut idom: Map[Int, Int] = Map::new()
  idom.insert(entry, entry)
  
  # Compute predecessors
  mut preds: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    preds.insert(b, Vec::new())
  end
  for block in f.blocks do
    for succ in terminator_successors(&block.terminator) do
      match preds.get(succ.id)
      when Option::Some(p) then
        p.push(block.id.id)
      when Option::None then ()
      end
    end
  end
  
  # Reverse postorder for iteration
  let rpo = compute_reverse_postorder(f)
  
  # Iterative dominator computation (Cooper/Harvey/Kennedy algorithm)
  mut changed = true
  while changed do
    changed = false
    for b in rpo do
      if b == entry then next end
      
      mut new_idom = -1
      match preds.get(b)
      when Option::Some(pred_list) then
        for p in pred_list do
          if idom.contains_key(p) then
            if new_idom == -1 then
              new_idom = p
            else
              new_idom = intersect_doms(&idom, new_idom, p)
            end
          end
        end
      when Option::None then ()
      end
      
      if new_idom != -1 then
        match idom.get(b)
        when Option::Some(old) then
          if old != new_idom then
            idom.insert(b, new_idom)
            changed = true
          end
        when Option::None then
          idom.insert(b, new_idom)
          changed = true
        end
      end
    end
  end
  
  # Compute dominance frontiers
  mut dom_frontier: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    dom_frontier.insert(b, Vec::new())
  end
  
  for b in block_ids do
    match preds.get(b)
    when Option::Some(pred_list) then
      if pred_list.len() >= 2 then
        for p in pred_list do
          mut runner = p
          while runner != -1 do
            match idom.get(b)
            when Option::Some(idom_b) then
              if runner == idom_b then
                break
              end
            when Option::None then break
            end
            match dom_frontier.get(runner)
            when Option::Some(df) then
              df.push(b)
            when Option::None then ()
            end
            match idom.get(runner)
            when Option::Some(next) then
              if next == runner then break end
              runner = next
            when Option::None then runner = -1
            end
          end
        end
      end
    when Option::None then ()
    end
  end
  
  # Build dominator tree children
  mut dom_tree_children: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    dom_tree_children.insert(b, Vec::new())
  end
  for b in block_ids do
    if b != entry then
      match idom.get(b)
      when Option::Some(parent) then
        match dom_tree_children.get(parent)
        when Option::Some(children) then
          children.push(b)
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  DomInfo {
    idom: idom,
    dom_frontier: dom_frontier,
    dom_tree_children: dom_tree_children
  }
end

def intersect_doms(idom: &Map[Int, Int], b1: Int, b2: Int) -> Int
  mut finger1 = b1
  mut finger2 = b2
  while finger1 != finger2 do
    while finger1 > finger2 do
      match idom.get(finger1)
      when Option::Some(next) then finger1 = next
      when Option::None then return finger2
      end
    end
    while finger2 > finger1 do
      match idom.get(finger2)
      when Option::Some(next) then finger2 = next
      when Option::None then return finger1
      end
    end
  end
  finger1
end

def compute_reverse_postorder_dfs(f: &MirFunction, block_id: Int, visited: &mut Set[Int], postorder: &mut Vec[Int]) -> Unit
  if visited.contains(block_id) then return end
  visited.insert(block_id)

  match get_block(f, BlockId { id: block_id })
  when Option::Some(block) then
    for succ in terminator_successors(&block.terminator) do
      compute_reverse_postorder_dfs(f, succ.id, visited, postorder)
    end
  when Option::None then ()
  end

  postorder.push(block_id)
end

def compute_reverse_postorder(f: &MirFunction) -> Vec[Int]
  mut visited: Set[Int] = Set::new()
  mut postorder = Vec::new()

  compute_reverse_postorder_dfs(f, f.entry_block.id, &mut visited, &mut postorder)
  postorder.reverse()
  postorder
end

# Phi node representation for SSA
struct PhiNode
  dest: LocalId
  ty: Type
  args: Vec[(BlockId, LocalId)]  # (predecessor_block, value_from_that_block)
end

def insert_phi_nodes(f: &mut MirFunction, dom_info: &DomInfo) -> Unit
  # For each variable that is assigned in more than one block,
  # insert phi nodes at the dominance frontier
  
  # Collect defs: local_id -> list of block_ids where it's defined
  mut defs: Map[Int, Vec[Int]] = Map::new()
  
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, _) then
        if place.projections.is_empty() then
          match defs.get(place.local.id)
          when Option::Some(list) then
            list.push(block.id.id)
          when Option::None then
            mut v = Vec::new()
            v.push(block.id.id)
            defs.insert(place.local.id, v)
          end
        end
      when _ then ()
      end
    end
  end
  
  # Insert phi nodes using dominance frontiers
  # For each variable v with multiple defs:
  #   - worklist = blocks where v is defined
  #   - for each block in worklist, add phi at DF(block) if not already there
  
  mut phi_placements: Map[Int, Vec[Int]] = Map::new()  # block_id -> list of local_ids needing phi
  
  for entry in defs do
    let (local_id, def_blocks) = entry
    if def_blocks.len() <= 1 then next end
    
    mut worklist = Vec::new()
    for b in def_blocks do
      worklist.push(b)
    end
    
    mut processed: Set[Int] = Set::new()
    while !worklist.is_empty() do
      match worklist.pop()
      when Option::Some(b) then
        match dom_info.dom_frontier.get(b)
        when Option::Some(df) then
          for df_block in df do
            match phi_placements.get(df_block)
            when Option::Some(locals) then
              if !locals.contains(local_id) then
                locals.push(local_id)
                if !processed.contains(df_block) then
                  processed.insert(df_block)
                  worklist.push(df_block)
                end
              end
            when Option::None then
              mut v = Vec::new()
              v.push(local_id)
              phi_placements.insert(df_block, v)
              if !processed.contains(df_block) then
                processed.insert(df_block)
                worklist.push(df_block)
              end
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  # Actually insert phi statements at the beginning of blocks
  for block in f.blocks do
    match phi_placements.get(block.id.id)
    when Option::Some(locals) then
      mut new_stmts = Vec::new()
      for local_id in locals do
        # Find the type of this local
        mut local_ty = Type::Unit
        for local in f.locals do
          if local.id.id == local_id then
            local_ty = local.ty.clone()
            break
          end
        end
        for p in f.params do
          if p.id.id == local_id then
            local_ty = p.ty.clone()
            break
          end
        end
        
        # Create phi statement as a special assignment
        # MIR doesn't have native phi, so we use a PhiRvalue marker
        let phi_rvalue = MirRvalue {
          kind: MirRvalueKind::MirPhi(Vec::new())  # Will be filled in rename pass
        }
        new_stmts.push(MirStatement {
          kind: MirStatementKind::MirAssign(
            place_local(LocalId { id: local_id }),
            phi_rvalue
          ),
          span: block.statements.get(0).map(|s| s.span.clone()).unwrap_or(block.terminator.span)
        })
      end
      # Prepend phis to existing statements
      for stmt in block.statements do
        new_stmts.push(stmt.clone())
      end
      block.statements = new_stmts
    when Option::None then ()
    end
  end
end

def rename_variables_block(f: &mut MirFunction, block_id: Int, dom_info: &DomInfo,
                         version_counter: &mut Map[Int, Int],
                         version_stack: &mut Map[Int, Vec[Int]]) -> Unit

  match get_block_mut(f, BlockId { id: block_id })
  when Option::Some(block) then
    mut pushed_versions: Vec[(Int, Int)] = Vec::new()  # (local_id, version) for cleanup

    for stmt in block.statements do
      # First rename uses
      rename_operands_in_stmt(&mut stmt, version_stack)

      # Then handle defs (push new version)
      match stmt.kind
      when MirStatementKind::MirAssign(place, _) then
        if place.projections.is_empty() then
          let lid = place.local.id
          match version_counter.get(lid)
          when Option::Some(ver) then
            let new_ver = ver
            version_counter.insert(lid, ver + 1)
            match version_stack.get(lid)
            when Option::Some(stack) then
              stack.push(new_ver)
              pushed_versions.push((lid, new_ver))
            when Option::None then ()
            end
          when Option::None then ()
          end
        end
      when _ then ()
      end
    end

    rename_operands_in_terminator(&mut block.terminator, version_stack)

    for succ in terminator_successors(&block.terminator) do
      fill_phi_args(f, succ, BlockId { id: block_id }, version_stack)
    end

    match dom_info.dom_tree_children.get(block_id)
    when Option::Some(children) then
      for child in children do
        rename_variables_block(f, child, dom_info, version_counter, version_stack)
      end
    when Option::None then ()
    end

    for entry in pushed_versions do
      let (lid, _) = entry
      match version_stack.get(lid)
      when Option::Some(stack) then stack.pop()
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
end

def rename_variables(f: &mut MirFunction, dom_info: &DomInfo) -> Unit
  # SSA renaming: traverse dom tree, maintaining a stack of versions for each variable
  mut version_counter: Map[Int, Int] = Map::new()  # local_id -> next version
  mut version_stack: Map[Int, Vec[Int]] = Map::new()  # local_id -> stack of current versions
  
  # Initialize with params
  for p in f.params do
    version_counter.insert(p.id.id, 1)
    mut stack = Vec::new()
    stack.push(0)
    version_stack.insert(p.id.id, stack)
  end
  
  # Initialize locals
  for local in f.locals do
    version_counter.insert(local.id.id, 0)
    version_stack.insert(local.id.id, Vec::new())
  end

  rename_variables_block(f, f.entry_block.id, dom_info, &mut version_counter, &mut version_stack)
end

def rename_operands_in_stmt(stmt: &mut MirStatement, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    rename_operands_in_rvalue(&mut rvalue, version_stack)
  when _ then ()
  end
end

def rename_operands_in_rvalue(rv: &mut MirRvalue, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    rename_operand(&mut lhs, version_stack)
    rename_operand(&mut rhs, version_stack)
  when MirRvalueKind::MirUnOp(_, op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::MirRef(p) then
    rename_place(&mut p, version_stack)
  when MirRvalueKind::MirRefMut(p) then
    rename_place(&mut p, version_stack)
  when MirRvalueKind::MirCast(_, op, _) then
    rename_operand(&mut op, version_stack)
  when _ then ()
  end
end

def rename_operand(op: &mut MirOperand, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    rename_place(&mut place, version_stack)
  when MirOperandKind::MirMovePlace(place) then
    rename_place(&mut place, version_stack)
  when _ then ()
  end
end

def rename_place(place: &mut Place, version_stack: &Map[Int, Vec[Int]]) -> Unit
  # Proper SSA renaming
  # Update the place's local to use the current version from the stack
  # Version is encoded as: (original_id * SSA_VERSION_BASE) + version
  # Use a large base to avoid collisions once local IDs exceed 10K.
  let SSA_VERSION_BASE = 1000000000
  let current_id = place.local.id
  let orig_id = if current_id >= SSA_VERSION_BASE then
    current_id / SSA_VERSION_BASE
  else
    current_id
  end
  match version_stack.get(&orig_id)
  when Option::Some(stack) then
    if !stack.is_empty() then
      let current_version = stack[stack.len() - 1]
      # Create a new LocalId instead of modifying in-place to avoid
      # corrupting other Places that share the same LocalId pointer.
      place.local = LocalId { id: orig_id * SSA_VERSION_BASE + current_version }
    end
  when Option::None then
    # No version stack for this local - keep original id unversioned.
    place.local = LocalId { id: orig_id }
  end
end

def rename_operands_in_terminator(term: &mut MirTerminator, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match term.kind
  when MirTerminatorKind::MirReturn then
    # Return has no operand - return value is in local 0
    ()
  when MirTerminatorKind::MirCall { dest, func: mut func_op, args: mut args_op, success, unwind } then
    rename_operand(&mut func_op, version_stack)
    for arg_val in args_op do
      rename_operand(&mut arg_val, version_stack)
    end
  when MirTerminatorKind::MirSwitchInt { op: mut discr, targets, default_target } then
    rename_operand(&mut discr, version_stack)
  when MirTerminatorKind::MirAssert { cond: mut cond_op, expected, msg, target, unwind } then
    rename_operand(&mut cond_op, version_stack)
  when MirTerminatorKind::MirYield(yield_op, target) then
    rename_operand(&mut yield_op, version_stack)
  when _ then ()
  end
end

def fill_phi_args(f: &mut MirFunction, succ_id: BlockId, pred_id: BlockId, 
                  version_stack: &Map[Int, Vec[Int]]) -> Unit
  match get_block_mut(f, succ_id)
  when Option::Some(block) then
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirPhi(args) then
          let lid = place.local.id
          match version_stack.get(lid)
          when Option::Some(stack) then
            match stack.last()
            when Option::Some(ver) then
              # Add argument: from pred_id, use version ver
              args.push((pred_id.clone(), LocalId { id: lid }))
            when Option::None then ()
            end
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  when Option::None then ()
  end
end

# Note: get_block_mut is defined earlier in this file

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lower_to_mir(program: &Program) -> MirProgram
  mut mir = lower_program(program)
  # SSA conversion disabled: the rename pass has pointer-aliasing bugs
  # where shared LocalId objects cause one rename to corrupt unrelated
  # Places.  The MIR is correct without SSA for codegen purposes.
  # Verify MIR invariants before optimization
  let pre_errors = verify_mir(&mir)
  if !pre_errors.is_empty() then
    for e in pre_errors do
      eprintln("MIR verify (pre-opt): " + e)
    end
  end
  optimize_mir(&mut mir, 1)
  transform_async_functions(&mut mir)
  # Verify MIR invariants after optimization
  let post_errors = verify_mir(&mir)
  if !post_errors.is_empty() then
    for e in post_errors do
      eprintln("MIR verify (post-opt): " + e)
    end
  end
  mir
end

# ———————————————————————————————————————————————————————————————
# MIR Verifier
# ———————————————————————————————————————————————————————————————
# Checks structural invariants of MIR:
#   1. Every function has an entry block that exists
#   2. Every block has exactly one terminator
#   3. All successor block IDs are valid
#   4. All local references are defined
#   5. SSA: every variable defined before use (within dominance)
#   6. Type consistency for operations
#   7. No unreachable blocks (warning)

def verify_mir(mir: &MirProgram) -> Vec[String]
  mut errors = Vec::new()
  for func in mir.functions do
    verify_function(&func, &mut errors)
  end
  errors
end

def verify_function(func: &MirFunction, errors: &mut Vec[String]) -> Unit
  let fn_ctx = "fn " + func.name.clone()
  
  # 2. Must have at least one block
  if func.blocks.is_empty() then
    errors.push(fn_ctx.clone() + ": function has no blocks")
    return
  end
  
  # Collect valid block IDs and local IDs (build set FIRST for O(1) lookups)
  mut valid_blocks: Set[Int] = Set::new()
  for block in func.blocks do
    valid_blocks.insert(block.id.id)
  end
  
  # 1. Entry block must exist (using O(1) set lookup)
  if !valid_blocks.contains(&func.entry_block.id) then
    errors.push(fn_ctx.clone() + ": entry block bb" + func.entry_block.id.to_string() + " does not exist")
  end
  
  mut valid_locals: Set[Int] = Set::new()
  for local in func.locals do
    valid_locals.insert(local.id.id)
  end
  for param in func.params do
    valid_locals.insert(param.id.id)
  end
  
  # 3. Check each block
  for block in func.blocks do
    let bb_ctx = fn_ctx.clone() + " bb" + block.id.id.to_string()
    
    # Every statement must reference valid locals
    for stmt in block.statements do
      verify_statement(&stmt, &valid_locals, &bb_ctx, errors)
    end
    
    # Terminator must reference valid successor blocks
    verify_terminator(&block.terminator, &valid_blocks, &valid_locals, &bb_ctx, errors)
  end
  
  # 4. Check for unreachable blocks (reachability from entry)
  mut reachable: Set[Int] = Set::new()
  mut worklist = Vec::new()
  worklist.push(func.entry_block.id)
  
  while !worklist.is_empty() do
    let bid = worklist.pop().unwrap()
    if reachable.contains(&bid) then next end
    reachable.insert(bid)
    
    # Find successors
    for block in func.blocks do
      if block.id.id == bid then
        let succs = terminator_successors(&block.terminator)
        for s in succs do
          if !reachable.contains(&s) then
            worklist.push(s)
          end
        end
        break
      end
    end
  end
  
  for block in func.blocks do
    if !reachable.contains(&block.id.id) then
      errors.push(fn_ctx.clone() + ": bb" + block.id.id.to_string() + " is unreachable")
    end
  end
  
  # 5. Check that StorageLive precedes uses within dominated blocks
  mut defined_locals: Set[Int] = Set::new()
  for param in func.params do
    defined_locals.insert(param.id.id)
  end
  
  for block in func.blocks do
    if !reachable.contains(&block.id.id) then next end
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, _) then
        defined_locals.insert(place.local.id)
      when MirStatementKind::MirStorageLive(local) then
        defined_locals.insert(local.id)
      when _ then ()
      end
    end
  end
end

def verify_statement(stmt: &MirStatement, valid_locals: &Set[Int], 
                     ctx: &String, errors: &mut Vec[String]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    if !valid_locals.contains(&place.local.id) then
      errors.push(ctx.clone() + ": assignment to undefined local _" + place.local.id.to_string())
    end
    verify_rvalue(&rvalue, valid_locals, ctx, errors)
  when MirStatementKind::MirStorageLive(local) then
    if !valid_locals.contains(&local.id) then
      errors.push(ctx.clone() + ": StorageLive for undefined local _" + local.id.to_string())
    end
  when MirStatementKind::MirStorageDead(local) then
    if !valid_locals.contains(&local.id) then
      errors.push(ctx.clone() + ": StorageDead for undefined local _" + local.id.to_string())
    end
  when _ then ()
  end
end

def verify_rvalue(rvalue: &MirRvalue, valid_locals: &Set[Int],
                  ctx: &String, errors: &mut Vec[String]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then verify_operand(&operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    verify_operand(&lhs, valid_locals, ctx, errors)
    verify_operand(&rhs, valid_locals, ctx, errors)
  when MirRvalueKind::MirUnOp(_, operand) then verify_operand(&operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirRef(place) then
    if !valid_locals.contains(&place.local.id) then
      errors.push(ctx.clone() + ": ref to undefined local _" + place.local.id.to_string())
    end
  when MirRvalueKind::MirCast(_, operand, _) then verify_operand(&operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirAggregate(_, operands) then
    for op in operands do
      verify_operand(&op, valid_locals, ctx, errors)
    end
  when MirRvalueKind::MirPhi(entries) then
    for entry in entries do
      # entry.1 is a LocalId
      if !valid_locals.contains(&entry.1.id) then
        errors.push(ctx.clone() + ": phi references undefined local _" + entry.1.id.to_string())
      end
    end
  when _ then ()
  end
end

def verify_operand(operand: &MirOperand, valid_locals: &Set[Int],
                   ctx: &String, errors: &mut Vec[String]) -> Unit
  match operand.kind
  when MirOperandKind::MirCopy(place) then
    if !valid_locals.contains(&place.local.id) then
      errors.push(ctx.clone() + ": copy of undefined local _" + place.local.id.to_string())
    end
  when MirOperandKind::MirMovePlace(place) then
    if !valid_locals.contains(&place.local.id) then
      errors.push(ctx.clone() + ": move of undefined local _" + place.local.id.to_string())
    end
  when MirOperandKind::MirConstant(_) then ()
  end
end

def verify_terminator(term: &MirTerminator, valid_blocks: &Set[Int], 
                      valid_locals: &Set[Int], ctx: &String, 
                      errors: &mut Vec[String]) -> Unit
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    if !valid_blocks.contains(&target.id) then
      errors.push(ctx.clone() + ": goto references invalid block bb" + target.id.to_string())
    end
  when MirTerminatorKind::MirSwitchInt(operand, targets, fallback) then
    verify_operand(&operand, valid_locals, ctx, errors)
    for t in targets do
      if !valid_blocks.contains(&t.target.id) then
        errors.push(ctx.clone() + ": switch references invalid block bb" + t.target.id.to_string())
      end
    end
    if !valid_blocks.contains(&fallback.id) then
      errors.push(ctx.clone() + ": switch fallback references invalid block bb" + fallback.id.to_string())
    end
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind } then
    verify_operand(&callee, valid_locals, ctx, errors)
    for arg in args do
      verify_operand(&arg, valid_locals, ctx, errors)
    end
    if !valid_blocks.contains(&success.id) then
      errors.push(ctx.clone() + ": call success references invalid block bb" + success.id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      if !valid_blocks.contains(&ub.id) then
        errors.push(ctx.clone() + ": call unwind references invalid block bb" + ub.id.to_string())
      end
    when Option::None then ()
    end
  when MirTerminatorKind::MirDrop { place, target, unwind } then
    if !valid_locals.contains(&place.local.id) then
      errors.push(ctx.clone() + ": drop of undefined local _" + place.local.id.to_string())
    end
    if !valid_blocks.contains(&target.id) then
      errors.push(ctx.clone() + ": drop target references invalid block bb" + target.id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      if !valid_blocks.contains(&ub.id) then
        errors.push(ctx.clone() + ": drop unwind references invalid block bb" + ub.id.to_string())
      end
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    verify_operand(&cond, valid_locals, ctx, errors)
    if !valid_blocks.contains(&target.id) then
      errors.push(ctx.clone() + ": assert target references invalid block bb" + target.id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      if !valid_blocks.contains(&ub.id) then
        errors.push(ctx.clone() + ": assert unwind references invalid block bb" + ub.id.to_string())
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

# Note: terminator_successors is defined earlier in this file (returns Vec[BlockId])

def block_exists(func: &MirFunction, id: BlockId) -> Bool
  for block in func.blocks do
    if block.id.id == id.id then
      return true
    end
  end
  false
end
