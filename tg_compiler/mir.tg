  Type, TypeId, AccessEffect, ParamType, FnSignature, LangItems, TypedProgram, LocalBinding,
  TypedExpr, TypedExprKind, TypedCall, TypedCallArg, TypedCallee, TypedField, TypedVariant,
  DeinitPlan, PlaceMoveState, build_deinit_plan, fn_owner_key_of_def,
  module_qualified_fn_key, subst_type_args, deinit_plan_is_trivial,
  TypeEnv, TypeDefKind, type_properties_of,
  FunctionCleanupTable, ScopeId, function_cleanup_table_new,
  TypedBudget, TypedBudgetConstraint,
  budget_metric_resource, budget_metric_enforced, budget_bound_value,
  budget_time_limit_ns, typed_budget_limit, intrinsic_allocates
}
use tg_compiler::ids::{
  FieldId, VariantId, DefId, DefKind, CallableId, InstanceId, ModuleId,
  GenericParamId, GenericParamTable, generic_param_table_new, fresh_synthetic_owner,
  intern_generic_param, generic_param_id_numeric, generic_param_name_of,
  generic_param_name_from, def_id_numeric, LocalId, NodeId, ClosureId, IntrinsicId,
  FinalizerKind, EffectId
}
use tg_compiler::resolver::{module_path_of_item_resolver, def_kind_of, ResolvedNames, stable_id_map_new, module_qualified_key}
use tg_compiler::resource_check::{AnalyzedProgram, IterationPlan, TypedIteration, TypedCFG, CleanupEdge, CleanupAction, CfgEdgeKind, engine_env_empty}

# ———————————————————————————————————————————————————————————————
# MIR Types
# ———————————————————————————————————————————————————————————————

struct MirProgram
  functions: Vec[MirFunction]
  statics: Vec[MirStatic]
  types: Vec[MirTypeDef]
  # The CONCRETE deinit plans (concrete type identity -> DeinitPlan — the
  # (TypeId, substs) key, see mir_type_identity_key), carried to codegen so
  # typed drop glue (the generic drop[T] intrinsic) can destroy concrete
  # values without re-deriving ownership in codegen. A concrete key means
  # Wrapper[Int] and Wrapper[File] are DISTINCT entries (the TypeId-keyed
  # semantic table built with empty args in types.tg cannot represent the
  # substitution — see the concrete-cache note at deinit_plan_for_type).
  deinit_plans: Map[String, DeinitPlan] = Map::new()
  # The map/set Hash/Eq dispatch metadata — mangled impl method
  # name ("MyKey__hash") -> (the resolver's DefId, the DefId's
  # fn_owner_key_of_def instance-base render, the declared parameter
  # count). Populated by the MIR builder; consumed by the monomorphizer's
  # dispatch-call injection and codegen's per-site label resolution.
  dispatch_methods: Map[String, (DefId, String, Int)] = Map::new()
  # The serialized param-name table (numeric GenericParamId ->
  # name) — the monomorphizer renders parameter names for diagnostics from
  # this snapshot (identity is the id everywhere; names are display-only).
  generic_param_names: Map[Int, String] = Map::new()
  # The generated drop-GLUE function tables. For every concrete type
  # with a non-trivial deinit plan, the MIR generates ONE ordinary MirFunction
  # (in functions) that destroys a value of that type at a given address.
  #   drop_glue_instances — concrete type identity key (mir_type_identity_key)
  #     -> the glue function's semantic InstanceId (the glue's synthesized
  #     CallableId, substs = []); the MirDeinit payload at whole-value
  #     destruction sites (cleanup chains, assignment replacement, the
  #     array-set old-element drop) carries this instance;
  #   drop_glue_fns — def_id_numeric(glue CallableId.def) -> the glue
  #     function's emission name; codegen resolves the label through it.
  drop_glue_instances: Map[String, InstanceId] = Map::new()
  drop_glue_fns: Map[Int, String] = Map::new()
  # def_id_numeric(resolver DefId) -> the mangled emission name
  # ("Type__drop" / "Type__deinit") of every registered method. Codegen
  # resolves a FINALIZER instance (MirDeinit inside a glue body) to its
  # emission label through this table — the DefId is the identity, the name
  # is only the symbol-mangling boundary.
  method_names_by_def: Map[Int, String] = Map::new()
  # The engine snapshot TypeEnv (the typed
  # program's serialized engine tables — engine_snapshot_env, built once
  # per lowering and repaired for aliases) carried on the PROGRAM so the
  # MIR Copy verifier queries the canonical TypeProperties answer —
  # type_properties_of(env, ty).is_trivially_copyable on the CONCRETE
  # (TypeId, substs) identity — instead of re-deriving copy legality from
  # the DeinitPlan. The DeinitPlan (deinit_plans above) remains the
  # drop-glue authority (gated on requires_drop_glue); is_trivially_copyable
  # is the copy authority. The monomorphizer mutates MirProgram in place,
  # so the snapshot survives post-mono verification unchanged.
  engine_env: TypeEnv = engine_env_empty()
end

struct MirFunction
  name: String
  params: Vec[MirLocal]
  ret_type: Type
  # The function's declared
  # generic-parameter IDs in DECLARATION ORDER — POPULATED AT LOWERING
  # (lower_function writes the checker's record — the fn owner key -> ids
  # in the merged declaration order, paired positionally with the lowered
  # declaration's merged generic list — or the builder's own synthetic
  # interning for a declaration the checker never recorded).
  # GenericParamIds — the param-name table holds the display names. The
  # monomorphizer consumes this list EXCLUSIVELY (the signature-derived
  # fallback is are not part of the model): a generic template
  # with an empty list is MALFORMED MIR. A specialized instance is
  # concrete and carries none.
  generic_params: Vec[GenericParamId] = Vec::new()
  locals: Vec[MirLocal]
  blocks: Vec[MirBlock]
  entry_block: MirBlockId
  is_async: Bool
  is_unsafe: Bool
  is_extern: Bool
  extern_abi: String          # "C", "Ruby", "System", etc.
  contracts: Vec[MirContract]
  # The function's DECLARED EFFECT SET — the checker's typed
  # FnSignature record (the parsed `effect[...]` annotation names interned
  # through the EffectRegistry, or the std effectful-function seeds),
  # copied at lowering (lower_function reads the typed table — the typed
  # records are the authority). The MIR verifier's effect rule checks the
  # function's calls against this set (a call to an effectful callee in a
  # function without the declared effect is a verifier error — the same
  # rule as the checker's, at the MIR level). IR-synthesized functions
  # (drop glue, closures) carry none.
  declared_effects: Vec[EffectId] = Vec::new()
  # The function's DECLARED BUDGET — the checker's typed FnSignature
  # record (the @budget annotation's metric + limit pairs, spans
  # stripped), copied at lowering (lower_function reads the typed table —
  # the typed records are the authority). The runtime enforcement reads
  # the limits from here (via MirBudgetConsume's amount payload) and the
  # driver's budget analysis enumerates the consumes. IR-synthesized
  # functions carry none.
  declared_budget: Option[TypedBudget] = Option::None
  span: Span
end

struct MirStatic
  name: String
  ty: Type
  init: Option[MirOperand]
  is_mut: Bool
end

struct MirTypeDef
  id: TypeId
  name: String
  kind: MirTypeDefKind
 # the declaration's generic parameter IDs in declaration order
  # (interned by the builder into its shared table) — needed to substitute
  # concrete type args into field/variant types when building CONCRETE
  # deinit plans (the cached per-TypeId plan cannot represent Wrapper[Int]
  # vs Wrapper[File]). The param-name table holds the display names.
  generic_params: Vec[GenericParamId]
end

enum MirTypeDefKind
  Struct(Vec[MirFieldDef])
  Enum(Vec[MirVariantDef])
end

struct MirFieldDef
  name: String
  ty: Type
end

struct MirVariantDef
  name: String
  discriminant: Int
  fields: Vec[Type]
end

# ———————————————————————————————————————————————————————————————
# Locals and Places
# ———————————————————————————————————————————————————————————————

struct MirLocalId
  id: Int
end

struct MirLocal
  id: MirLocalId
  name: String
  ty: Type
  is_mut: Bool
  span: Span
end

struct Place
  local: MirLocalId
  projections: Vec[Projection]
end

enum Projection
  ProjDeref
  # the legacy name/index forms
  # (ProjField(String, Int) / ProjFieldIndex(Int) / ProjDowncast(String,
  # Int)) are is not part of the model. EVERY projection is semantic:
  #   - Field(FieldId)     a struct field — owner TypeId + index, recorded
  #                        by the type checker (typed_field_projection) for
  #                        source accesses AND constructed by the lowering
  #                        for synthesized places (drop glue, pattern
  #                        bindings, payload guards — the lowering knows the
  #                        field because it knows the type at the
  #                        projection point);
  #   - Variant(VariantId) an enum downcast — owner TypeId + variant index
  #                        (declaration order, never the discriminant);
  #   - TupleIndex(Int)    a TUPLE element access (tuples have no FieldId —
  #                        the typed tree's TupleIndex form, mirroring
  #                        TypedPlaceProj::TupleIndex); used by the
  #                        synthesized drain/entries tuple accesses and the
  #                        tuple-pattern bindings.
  Field(FieldId)
  Variant(VariantId)
  TupleIndex(Int)
  ProjIndex(MirLocalId)
  ProjConstantIndex(Int)
end

def place_local(id: MirLocalId) -> Place
  # Clone the MirLocalId to avoid shared-pointer aliasing.
  Place { local: MirLocalId { id: id.id }, projections: Vec::new() }
end

def place_deref(base: Place) -> Place
  var p = base
  p.projections.push(Projection::ProjDeref)
  p
end

# Strip through Ref/RefMut/Owned wrapper types to get the inner type.
def strip_ref_for_keys(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then strip_ref_for_keys(inner)
  when _ then ty
  end
end

# (Type collapse): the LangItems TypeId of a builtin compound type —
# read from the CANONICAL LangItems snapshot (TypedProgram.lang_items — the
# checker's env.lang_items id-indexed table, carried on the builder as
# b.lang_items). The old name-inversion (a type_name_to_id lookup by
# builtin name) is not part of the model: the MIR receives the builtin ids directly from
# the checker's table. Every Adt construction for the builtins reads the
# snapshot field (b.lang_items.option /.slice /...) at the construction
# site; the nine builtin type names are all registered at env
# initialization (type_env_new → build_lang_items), so the ids are valid
# whenever lowering runs.

# Resolve the type of a for-loop iterator expression so that
# codegen can correctly identify heap collections. PHASE-2: the typed
# program's expr_types entry is the ONLY source — the same typed
# expression type the resource checker's IterationPlan element_type was
# classified from (for_iter_type_kind in resource_check.tg), so the MIR
# and the checker agree by construction. The mechanical re-derivation
# arms (scope-based ident lookup, field re-derivation, and the
#.keys()/.values()/.entries() name-guessing placeholders).
# Type::Unit is the documented fallback ONLY for synthesized / node_id 0
# iterators (lower_for's MirLen path handles the Unit iterable via
# ProjDeref); a SOURCE iterator with no typed record is an
# internal error (fail-closed).
def resolve_iter_expr_type(b: MirBuilder, expr: Expr) -> Type
  if expr.node_id != 0 then
    match b.expr_types.get(expr.node_id)
    when Option::Some(typed_ty) then
      # The typed entry is the authority even when it is not concrete
      # (generic-body Param entries): the local types it feeds are equally
      # parametric and the monomorphizer substitutes them — the
      # mechanical arms could only re-derive the same parametric shape or
      # a placeholder.
      return typed_ty
    when Option::None then
      b.errors.push("internal error: missing typed expression type for for-loop iterator node " + expr.node_id.to_string() + " during MIR lowering")
    end
  end
  Type::Unit
end

# ———————————————————————————————————————————————————————————————
# Basic Blocks
# ———————————————————————————————————————————————————————————————

struct MirBlockId
  id: Int
end

struct MirBlock
  id: MirBlockId
  statements: Vec[MirStatement]
  terminator: MirTerminator
end

struct MirStatement
  kind: MirStatementKind
  span: Span
end

enum MirStatementKind
  MirAssign(Place, MirRvalue)
  MirStorageLive(MirLocalId)
  MirStorageDead(MirLocalId)
  MirNop
  
  # Agentic statements
  MirContractCheck(MirContract, MirOperand)  # Pre/post/invariant check
  # Budget ENFORCEMENT: consume ONE unit of the resource (the @budget
  # metric's canonical key — "alloc" for the allocation metric, "time" for
  # the elapsed metric). The Int payload is the annotated function's
  # DECLARED LIMIT for the resource (the typed record's bound): codegen
  # increments THIS INVOCATION's frame-slot counter by one (the allocation
  # metric — the per-frame slot FrameInfo.budget_alloc_offset reserves and
  # the prologue zeroes) or measures the elapsed clock against the frame
  # slot's entry stamp (the time metric) and TRAPS when the limit is
  # exceeded. The counters live in the generated function's STACK FRAME,
  # never in global .data — per-invocation, nesting-safe, race-free.
  MirBudgetConsume(String, Int)              # Consume budget resources
  MirEffectRecord(String, MirOperand)        # Record an effect
end

# ———————————————————————————————————————————————————————————————
# Rvalues and Operands
# ———————————————————————————————————————————————————————————————

struct MirOperand
  kind: MirOperandKind
end

enum MirOperandKind
  MirCopy(Place)
  MirMovePlace(Place)
  MirConstant(MirConstant)
  MirRead(Place)
  MirConsume(Place)
end

enum MirCallValue
  Value(MirOperand)
  Place(Place)
end

struct MirCallArg
  effect: AccessEffect
  value: MirCallValue
end

struct MirConstant
  kind: MirConstantKind
  ty: Type
 # the optional SEMANTIC callee identity carried by MirFnItem
  # constants. The name inside MirFnItem remains the mangled EMISSION key
  # (codegen's resolve_callee_label authority); this InstanceId is the
  # semantic identity — the string stage is the boundary the reviewer's
  # InstanceId payload. Option::None for every non-call constant
  # and for synthesized IR-only callees (the name-only form).
  instance: Option[InstanceId]
end

enum MirConstantKind
  MirUnit
  MirBool(Bool)
  MirInt(Int)
  MirFloat(Float)
  MirChar(Char)
  MirString(String)
  # Named function item — carries the symbol name. The name is the mangled
  # emission key; the DefId/InstanceId (MirConstant.instance) is the
  # semantic identity carried alongside; the string stage is the boundary
  # the InstanceId payload.
  MirFnItem(String)    # Named function item — carries the symbol name
  MirZeroSized
 # static references carry the static's SEMANTIC DefId (the
  # resolver's module_symbols identity — DefKind::Static/Constant); the
  # emission label is derived from the DefId only at backend symbol
  # generation (codegen.tg — the next-wave consumer).
  MirStaticRef(DefId) # Read current value of a global/static variable
  MirStaticAddr(DefId) # Address of a global/static variable (for writes)
end

struct MirRvalue
  kind: MirRvalueKind
end

def operand_copy(place: Place) -> MirOperand
  MirOperand { kind: MirOperandKind::MirCopy(place) }
end

def operand_copy_local(id: MirLocalId) -> MirOperand
  operand_copy(place_local(id))
end

def operand_move_place(place: Place) -> MirOperand
  MirOperand { kind: MirOperandKind::MirMovePlace(place) }
end

def operand_read(place: Place) -> MirOperand
  MirOperand { kind: MirOperandKind::MirRead(place) }
end

def operand_consume(place: Place) -> MirOperand
  MirOperand { kind: MirOperandKind::MirConsume(place) }
end

def operand_constant(constant: MirConstant) -> MirOperand
  MirOperand { kind: MirOperandKind::MirConstant(constant) }
end

def duplicate_place(place: Place) -> Place
  var projections = Vec::new()
  var projection_idx = 0
  while projection_idx < place.projections.len() do
    let projection = place.projections[projection_idx]
    projections.push(duplicate_projection(projection))
    projection_idx = projection_idx + 1
  end
  Place {
    local: MirLocalId { id: place.local.id },
    projections: projections
  }
end

def constant_unit() -> MirConstant
  MirConstant { kind: MirConstantKind::MirUnit, ty: Type::Unit, instance: Option::None }
end

def constant_bool(value: Bool) -> MirConstant
  MirConstant { kind: MirConstantKind::MirBool(value), ty: Type::Bool, instance: Option::None }
end

def constant_int(value: Int) -> MirConstant
  MirConstant { kind: MirConstantKind::MirInt(value), ty: Type::Int, instance: Option::None }
end

def constant_float(value: Float) -> MirConstant
  MirConstant { kind: MirConstantKind::MirFloat(value), ty: Type::Float, instance: Option::None }
end

def constant_string(value: String) -> MirConstant
 # a string CONSTANT is the STATIC STRVIEW form — codegen
  # interns the bytes and emits the shared static label (a raw pointer to
  # the null-terminated static bytes). It is NOT an owned String object:
  # every place that demands an owned String (by-value String params,
  # String destinations, concat, to_string, clone) converts through
  # string_from_static — the owned clone of the static view.
  MirConstant { kind: MirConstantKind::MirString(value), ty: Type::String, instance: Option::None }
end

def constant_char(value: Char) -> MirConstant
  MirConstant { kind: MirConstantKind::MirChar(value), ty: Type::Char, instance: Option::None }
end

def constant_fn_item(name: String, ty: Type) -> MirConstant
  constant_fn_item_with_instance(name, ty, Option::None)
end

# MirFnItem with the optional semantic instance payload (the
# DefId+substs identity recorded from the typed call target). Callers that
# only have the name keep the name-only form via constant_fn_item.
def constant_fn_item_with_instance(name: String, ty: Type, instance: Option[InstanceId]) -> MirConstant
  MirConstant { kind: MirConstantKind::MirFnItem(name), ty: ty, instance: instance }
end

def constant_zero_sized(ty: Type) -> MirConstant
  MirConstant { kind: MirConstantKind::MirZeroSized, ty: ty, instance: Option::None }
end

def operand_unit() -> MirOperand
  operand_constant(constant_unit())
end

def operand_bool(value: Bool) -> MirOperand
  operand_constant(constant_bool(value))
end

def operand_int(value: Int) -> MirOperand
  operand_constant(constant_int(value))
end

def operand_float(value: Float) -> MirOperand
  operand_constant(constant_float(value))
end

def operand_string(value: String) -> MirOperand
  operand_constant(constant_string(value))
end

def duplicate_constant(constant: MirConstant) -> MirConstant
  match constant.kind
  when MirConstantKind::MirUnit then constant_unit()
  when MirConstantKind::MirBool(value) then constant_bool(value)
  when MirConstantKind::MirInt(value) then constant_int(value)
  when MirConstantKind::MirFloat(value) then constant_float(value)
  when MirConstantKind::MirChar(value) then constant_char(value)
  when MirConstantKind::MirString(value) then constant_string(value.clone())
  when MirConstantKind::MirFnItem(name) then
 # the instance payload is part of the constant's identity and
 # must survive duplication (deferred-emission clones, templates).
    MirConstant {
      kind: MirConstantKind::MirFnItem(name.clone()),
      ty: constant.ty.clone(),
      instance: constant.instance.clone()
    }
  when MirConstantKind::MirZeroSized then constant_zero_sized(constant.ty.clone())
  when MirConstantKind::MirStaticRef(did) then
    MirConstant { kind: MirConstantKind::MirStaticRef(DefId { module: ModuleId { id: did.module.id }, index: did.index }), ty: constant.ty.clone(), instance: Option::None }
  when MirConstantKind::MirStaticAddr(did) then
    MirConstant { kind: MirConstantKind::MirStaticAddr(DefId { module: ModuleId { id: did.module.id }, index: did.index }), ty: constant.ty.clone(), instance: Option::None }
  end
end

def duplicate_operand(operand: MirOperand) -> MirOperand
  match operand.kind
  when MirOperandKind::MirCopy(place) then operand_copy(duplicate_place(place))
  when MirOperandKind::MirMovePlace(place) then operand_move_place(duplicate_place(place))
  when MirOperandKind::MirRead(place) then operand_read(duplicate_place(place))
  when MirOperandKind::MirConsume(place) then operand_consume(duplicate_place(place))
  when MirOperandKind::MirConstant(constant) then operand_constant(duplicate_constant(constant))
  end
end

def mir_call_arg_operand(arg: MirCallArg) -> MirOperand
  match arg.value
  when MirCallValue::Value(op) then duplicate_operand(op)
  when MirCallValue::Place(p) then operand_copy(duplicate_place(p))
  end
end

# Materialize an operand into a fresh temp local (used by the array-set
# old-element drop, where the ProjIndex projection needs the index as a
# MirLocalId). A place operand with an EMPTY projection chain keeps its
# local; every other shape (projected places, constants, moves) is copied
# into a temp.
def mir_operand_local_or_temp(inout b: MirBuilder, op: MirOperand, span: Span) -> MirLocalId
  match op.kind
  when MirOperandKind::MirCopy(p) then
    if p.projections.is_empty() then p.local else mir_materialize_operand(b, op, span) end
  when MirOperandKind::MirMovePlace(p) then
    if p.projections.is_empty() then p.local else mir_materialize_operand(b, op, span) end
  when MirOperandKind::MirRead(p) then
    if p.projections.is_empty() then p.local else mir_materialize_operand(b, op, span) end
  when MirOperandKind::MirConsume(p) then
    if p.projections.is_empty() then p.local else mir_materialize_operand(b, op, span) end
  when _ then mir_materialize_operand(b, op, span)
  end
end

def mir_materialize_operand(inout b: MirBuilder, op: MirOperand, span: Span) -> MirLocalId
  let tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(tmp), MirRvalue { kind: MirRvalueKind::MirMove(duplicate_operand(op)) }, span)
  tmp
end

def duplicate_call_arg(arg: MirCallArg) -> MirCallArg
  MirCallArg {
    effect: arg.effect.clone(),
    value: match arg.value
    when MirCallValue::Value(op) then MirCallValue::Value(duplicate_operand(op))
    when MirCallValue::Place(p) then MirCallValue::Place(duplicate_place(p))
    end
  }
end

def move_rvalue(operand: MirOperand) -> MirRvalue
  MirRvalue { kind: MirRvalueKind::MirMove(operand) }
end

def duplicate_function(func: MirFunction) -> MirFunction
  var blocks = Vec::new()
  var block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    blocks.push(duplicate_block(block))
    block_idx = block_idx + 1
  end
  MirFunction {
    name: func.name.clone(),
    params: func.params.clone(),
    ret_type: func.ret_type.clone(),
    generic_params: func.generic_params.clone(),
    locals: func.locals.clone(),
    blocks: blocks,
    entry_block: MirBlockId { id: func.entry_block.id },
    is_async: func.is_async,
    is_unsafe: func.is_unsafe,
    is_extern: func.is_extern,
    extern_abi: func.extern_abi.clone(),
    contracts: func.contracts.clone(),
    declared_effects: func.declared_effects.clone(),
    declared_budget: func.declared_budget.clone(),
    span: func.span.clone()
  }
end

def duplicate_block(block: MirBlock) -> MirBlock
  var statements = Vec::new()
  var stmt_idx = 0
  while stmt_idx < block.statements.len() do
    let stmt = block.statements[stmt_idx]
    statements.push(duplicate_statement(stmt))
    stmt_idx = stmt_idx + 1
  end
  MirBlock {
    id: MirBlockId { id: block.id.id },
    statements: statements,
    terminator: duplicate_terminator(&block.terminator)
  }
end

def duplicate_blocks(blocks: Vec[MirBlock]) -> Vec[MirBlock]
  var duplicated = Vec::new()
  var block_idx = 0
  while block_idx < blocks.len() do
    let block = blocks[block_idx]
    duplicated.push(duplicate_block(block))
    block_idx = block_idx + 1
  end
  duplicated
end

enum MirRvalueKind
  MirMove(MirOperand)
  
  # References
  # MirRef is the ONLY INTERNAL ABI reference form — an INTERNAL ABI
 # temporary representing an inout place (#7 invariant). The retired
  # mutable variant is gone; the mutability of the internal ref is
  # expressed by the place it addresses. WHITELIST of legal uses
  # (everything else is a verifier error):
  #   (a) the rvalue is assigned to a plain temp local (no projections);
  #   (b) the temp is READ (MirCopy) as a direct call argument — at ABI
  #       boundaries the codegen deref-copies the pointee value, so no
  #       reference escapes;
  #   (c) reads through deref projections (place with ProjDeref) are plain
  #       value reads.
  # Forbidden: storing a ref into an aggregate, moving it, using it in
  # binop/unop/cast/repeat operands, or returning it (a function's return
  # type is never RefInternal). The MIR verifier (verify_function_v2)
  # enforces the whitelist.
  MirRef(Place)    # &place (only internal-ABI reference form)
  
  # Aggregate construction
  MirAggregate(AggregateKind, Vec[MirOperand])
  
  # Binary/unary operations
  MirBinOp(MirBinOp, MirOperand, MirOperand)
  MirUnOp(MirUnOp, MirOperand)
  
  # Discriminant access
  MirDiscriminant(Place)
  
  # Length of array/slice
  MirLen(Place)
  
  # Cast
  MirCast(CastKind, MirOperand, Type)
  
  # Repeat for array initialization
  MirRepeat(MirOperand, Int)
  
  # SSA Phi node: list of (predecessor_block, value) pairs
  MirPhi(Vec[(MirBlockId, MirLocalId)])
end

enum AggregateKind
  MirArray(Type)
  Tuple
  Struct(TypeId, Vec[String])  # Type + field names
 # (the closure {code, env} ABI): the aggregate carries the CLOSURE's
  # semantic identity (ClosureId — the closure expression node's id, the
  # SAME identity the checker's Type::Closure uses), NOT a synthetic TypeId
  # outside the registered layout universe. The closure object's layout
  # ({ code: fn ptr @ 0, env: capture-tuple }) is registered by the ClosureId
  # in the layout engine (closure_object_record) and in codegen's concrete
  # layout tables (build_all_layouts registers every Type::Closure instance
  # under its concrete identity key); the aggregate emission resolves the
  # field offsets through that registration — never a missing-layout ICE.
  Closure(ClosureId)
  Generator(TypeId)
end

enum MirBinOp
  Add
  Sub
  Mul
  Div
  Mod
  BitAnd
  BitOr
  BitXor
  Shl
  Shr
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
end

enum MirUnOp
  Neg
  Not
  BitNot
end

enum CastKind
  IntToInt
  IntToFloat
  FloatToInt
  FloatToFloat
  Pointer
  Transmute
end

# ———————————————————————————————————————————————————————————————
# Terminators
# ———————————————————————————————————————————————————————————————

struct MirTerminator
  kind: MirTerminatorKind
  span: Span
end

enum MirTerminatorKind
  MirGoto(MirBlockId)
  MirReturn
  MirUnreachable
  MirSwitchInt { op: MirOperand, targets: Vec[SwitchTarget], default_target: MirBlockId }
  MirCall {
    dest: Place,
    func: MirOperand,
    args: Vec[MirCallArg],
    success: MirBlockId,
    unwind: Option[MirBlockId],
 # (IntrinsicId through MirCall): the SEMANTIC intrinsic
    # classification, STAMPED at lowering for the SOURCE calls (the
    # checker's typed_intrinsics record — the __intrinsic_* names and the
    # classified builtin-container method calls, keyed by the call node
    # id). Codegen's dispatch reads this stamped id FIRST and falls back to
    # the semantic router (classify_intrinsic_call) only for the
    # compiler-SYNTHESIZED calls (drop glue, drain/destroy chains, the
    # projected for-loop length call — Option::None here).
    intrinsic: Option[IntrinsicId],
  }
  MirAssert { cond: MirOperand, expected: Bool, msg: AssertMessage, target: MirBlockId, unwind: Option[MirBlockId] }
  MirAbort
 # the destruction target is the SEMANTIC InstanceId — either the
  # drop-GLUE function's instance (whole-value destruction: the concrete
  # type's generated glue function; codegen resolves its label through
  # MirProgram.drop_glue_fns) or the FINALIZER's instance (a DeinitPlan
  # callable inside a glue body; codegen resolves the finalizer's emission
  # label through MirProgram.method_names_by_def). The field keeps the
  # `deinit_fn` spelling because the pass-through consumers (mono.tg,
  # linker.tg, wasm_target.tg) clone the payload without inspecting it.
  MirDeinit { place: Place, deinit_fn: InstanceId, target: MirBlockId, unwind: Option[MirBlockId] }
end

struct SwitchTarget
  value: Int
  target: MirBlockId
end

enum AssertMessage
  BoundsCheck(MirOperand, MirOperand)
  Overflow(MirBinOp)
  DivisionByZero
  RemainderByZero
  NullPointer
  ContractViolation(String)
end

# ———————————————————————————————————————————————————————————————
# Agentic Features in MIR
# ———————————————————————————————————————————————————————————————

struct MirContract
  kind: MirContractKind
  condition: MirOperand
  message: String
  span: Span
end

enum MirContractKind
  Pre
  Post
  Invariant
end

struct MirBudget
  resource: String
  limit: Int
  consumed: Int
end

struct MirEffect
  name: String
  arguments: Vec[MirOperand]
end

def duplicate_span(span: Span) -> Span
  Span {
    file: span.file.clone(),
    start: span.start,
    end_pos: span.end_pos
  }
end

def duplicate_projection(projection: Projection) -> Projection
  match projection
  when Projection::ProjDeref then Projection::ProjDeref
  when Projection::Field(fid) then Projection::Field(FieldId { owner: TypeId { id: fid.owner.id }, index: fid.index })
  when Projection::Variant(vid) then Projection::Variant(VariantId { owner: TypeId { id: vid.owner.id }, index: vid.index })
  when Projection::TupleIndex(idx) then Projection::TupleIndex(idx)
  when Projection::ProjIndex(id) then Projection::ProjIndex(MirLocalId { id: id.id })
  when Projection::ProjConstantIndex(idx) then Projection::ProjConstantIndex(idx)
  end
end

def duplicate_aggregate_kind(kind: AggregateKind) -> AggregateKind
  match kind
  when AggregateKind::MirArray(elem_ty) then AggregateKind::MirArray(elem_ty.clone())
  when AggregateKind::Tuple then AggregateKind::Tuple
  when AggregateKind::Struct(type_id, field_names) then
    var duplicated_field_names = Vec::new()
    var field_name_idx = 0
    while field_name_idx < field_names.len() do
      let field_name = field_names[field_name_idx]
      duplicated_field_names.push(field_name.clone())
      field_name_idx = field_name_idx + 1
    end
    AggregateKind::Struct(TypeId { id: type_id.id }, duplicated_field_names)
  when AggregateKind::Closure(cid) then AggregateKind::Closure(ClosureId { id: cid.id })
  when AggregateKind::Generator(type_id) then AggregateKind::Generator(TypeId { id: type_id.id })
  end
end

def duplicate_switch_target(target: SwitchTarget) -> SwitchTarget
  SwitchTarget {
    value: target.value,
    target: MirBlockId { id: target.target.id }
  }
end

def duplicate_assert_message(msg: AssertMessage) -> AssertMessage
  match msg
  when AssertMessage::BoundsCheck(index, length) then
    AssertMessage::BoundsCheck(duplicate_operand(index), duplicate_operand(length))
  when AssertMessage::Overflow(binop) then AssertMessage::Overflow(binop.clone())
  when AssertMessage::DivisionByZero then AssertMessage::DivisionByZero
  when AssertMessage::RemainderByZero then AssertMessage::RemainderByZero
  when AssertMessage::NullPointer then AssertMessage::NullPointer
  when AssertMessage::ContractViolation(message) then AssertMessage::ContractViolation(message.clone())
  end
end

def duplicate_contract(contract: MirContract) -> MirContract
  MirContract {
    kind: contract.kind,
    condition: duplicate_operand(&contract.condition),
    message: contract.message.clone(),
    span: duplicate_span(&contract.span)
  }
end

def duplicate_rvalue(rvalue: MirRvalue) -> MirRvalue
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then move_rvalue(duplicate_operand(operand))
  when MirRvalueKind::MirRef(place) then
    MirRvalue { kind: MirRvalueKind::MirRef(duplicate_place(place)) }
  when MirRvalueKind::MirAggregate(kind, fields) then
    var duplicated_fields = Vec::new()
    var field_idx = 0
    while field_idx < fields.len() do
      let field = fields[field_idx]
      duplicated_fields.push(duplicate_operand(field))
      field_idx = field_idx + 1
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(duplicate_aggregate_kind(kind), duplicated_fields) }
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    MirRvalue { kind: MirRvalueKind::MirBinOp(op.clone(), duplicate_operand(lhs), duplicate_operand(rhs)) }
  when MirRvalueKind::MirUnOp(op, operand) then
    MirRvalue { kind: MirRvalueKind::MirUnOp(op.clone(), duplicate_operand(operand)) }
  when MirRvalueKind::MirDiscriminant(place) then
    MirRvalue { kind: MirRvalueKind::MirDiscriminant(duplicate_place(place)) }
  when MirRvalueKind::MirLen(place) then
    MirRvalue { kind: MirRvalueKind::MirLen(duplicate_place(place)) }
  when MirRvalueKind::MirCast(kind, operand, ty) then
    MirRvalue { kind: MirRvalueKind::MirCast(kind.clone(), duplicate_operand(operand), ty.clone()) }
  when MirRvalueKind::MirRepeat(operand, count) then
    MirRvalue { kind: MirRvalueKind::MirRepeat(duplicate_operand(operand), count) }
  when MirRvalueKind::MirPhi(entries) then
    var duplicated_entries = Vec::new()
    var entry_idx = 0
    while entry_idx < entries.len() do
      let entry = entries[entry_idx]
      duplicated_entries.push((MirBlockId { id: entry.0.id }, MirLocalId { id: entry.1.id }))
      entry_idx = entry_idx + 1
    end
    MirRvalue { kind: MirRvalueKind::MirPhi(duplicated_entries) }
  end
end

def duplicate_statement(stmt: MirStatement) -> MirStatement
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::MirAssign(duplicate_place(place), duplicate_rvalue(rvalue)),
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirStorageLive(local_id) then
    MirStatement {
      kind: MirStatementKind::MirStorageLive(MirLocalId { id: local_id.id }),
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirStorageDead(local_id) then
    MirStatement {
      kind: MirStatementKind::MirStorageDead(MirLocalId { id: local_id.id }),
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirNop then
    MirStatement {
      kind: MirStatementKind::MirNop,
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirContractCheck(contract, operand) then
    MirStatement {
      kind: MirStatementKind::MirContractCheck(duplicate_contract(contract), duplicate_operand(operand)),
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirBudgetConsume(resource, amount) then
    MirStatement {
      kind: MirStatementKind::MirBudgetConsume(resource.clone(), amount),
      span: duplicate_span(&stmt.span)
    }
  when MirStatementKind::MirEffectRecord(name, operand) then
    MirStatement {
      kind: MirStatementKind::MirEffectRecord(name.clone(), duplicate_operand(operand)),
      span: duplicate_span(&stmt.span)
    }
  end
end

def mir_terminator_kind_name(kind: MirTerminatorKind) -> String
  match kind
  when MirTerminatorKind::MirGoto(_) then "MirGoto"
  when MirTerminatorKind::MirReturn then "MirReturn"
  when MirTerminatorKind::MirUnreachable then "MirUnreachable"
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then "MirSwitchInt"
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then "MirCall"
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then "MirAssert"
  when MirTerminatorKind::MirAbort then "MirAbort"
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then "MirDeinit"
  end
end

def duplicate_terminator(term: MirTerminator) -> MirTerminator
  let kind_name = mir_terminator_kind_name(&term.kind)

  if kind_name == "MirGoto" then
    match term.kind
    when MirTerminatorKind::MirGoto(target) then
      return MirTerminator {
        kind: MirTerminatorKind::MirGoto(MirBlockId { id: target.id }),
        span: duplicate_span(&term.span)
      }
    when _ then ()
    end
  elsif kind_name == "MirReturn" then
    return MirTerminator {
      kind: MirTerminatorKind::MirReturn,
      span: duplicate_span(&term.span)
    }
  elsif kind_name == "MirUnreachable" then
    return MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: duplicate_span(&term.span)
    }
  elsif kind_name == "MirSwitchInt" then
    match term.kind
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      var duplicated_targets = Vec::new()
      var target_idx = 0
      while target_idx < targets.len() do
        let target = targets[target_idx]
        duplicated_targets.push(duplicate_switch_target(target))
        target_idx = target_idx + 1
      end
      return MirTerminator {
        kind: MirTerminatorKind::MirSwitchInt {
          op: duplicate_operand(op),
          targets: duplicated_targets,
          default_target: MirBlockId { id: default_target.id }
        },
        span: duplicate_span(&term.span)
      }
    when _ then ()
    end
  elsif kind_name == "MirCall" then
    match term.kind
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      var duplicated_args = Vec::new()
      var arg_idx = 0
      while arg_idx < args.len() do
        let arg = args[arg_idx]
        duplicated_args.push(duplicate_call_arg(arg))
        arg_idx = arg_idx + 1
      end
      let duplicated_unwind = match unwind
      when Option::Some(block_id) then Option::Some(MirBlockId { id: block_id.id })
      when Option::None then Option::None
      end
      return MirTerminator {
        kind: MirTerminatorKind::MirCall {
          dest: duplicate_place(dest),
          func: duplicate_operand(func),
          args: duplicated_args,
          success: MirBlockId { id: success.id },
          unwind: duplicated_unwind,
          intrinsic: intrinsic
        },
        span: duplicate_span(&term.span)
      }
    when _ then ()
    end
  elsif kind_name == "MirDeinit" then
    match term.kind
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      let duplicated_unwind = match unwind
      when Option::Some(block_id) then Option::Some(MirBlockId { id: block_id.id })
      when Option::None then Option::None
      end
      return MirTerminator {
        kind: MirTerminatorKind::MirDeinit {
          place: duplicate_place(place),
          deinit_fn: deinit_fn.clone(),
          target: MirBlockId { id: target.id },
          unwind: duplicated_unwind
        },
        span: duplicate_span(&term.span)
      }
    when _ then ()
    end
  elsif kind_name == "MirAssert" then
    match term.kind
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      let duplicated_unwind = match unwind
      when Option::Some(block_id) then Option::Some(MirBlockId { id: block_id.id })
      when Option::None then Option::None
      end
      return MirTerminator {
        kind: MirTerminatorKind::MirAssert {
          cond: duplicate_operand(cond),
          expected: expected,
          msg: duplicate_assert_message(msg),
          target: MirBlockId { id: target.id },
          unwind: duplicated_unwind
        },
        span: duplicate_span(&term.span)
      }
    when _ then ()
    end
  elsif kind_name == "MirAbort" then
    return MirTerminator {
      kind: MirTerminatorKind::MirAbort,
      span: duplicate_span(&term.span)
    }
  end

  MirTerminator {
    kind: MirTerminatorKind::MirUnreachable,
    span: duplicate_span(&term.span)
  }
end

# ———————————————————————————————————————————————————————————————
# MIR Builder
# ———————————————————————————————————————————————————————————————

struct MirBuilder
 # (engine consumption): the snapshot TypeEnv built once per lowering
  # from the typed program's serialized engine tables (resource_check.tg's
  # engine_snapshot_env). The plan generation (deinit_plan_for_type) and
  # every ownership decision in this builder query the types.tg engine
  # through it (type_properties_of — the memoized concrete (TypeId, substs)
  # authority) instead of re-classifying types. See the ENGINE QUERY note at
  # deinit_plan_for_type.
  engine_env: TypeEnv
  errors: Vec[String]
  current_fn: Option[MirFunction]
  current_block: Option[MirBlockId]
  # the CURRENT function's declared budget — the typed FnSignature's
  # record, set at lower_function's budget-state write and cleared by
  # finish_function's current_fn reset (the budget lowering reads the
  # per-function limits from here while lowering the body).
  current_fn_budget: Option[TypedBudget] = Option::None
  local_counter: Int
  block_counter: Int
  temp_counter: Int
  var_map: Map[String, MirLocalId]
  blocks: Vec[MirBlock]
  pending_closures: Vec[PendingClosure]
  break_target: Option[MirBlockId]
  continue_target: Option[MirBlockId]
  enum_variants: Map[String, Vec[String]]
  enum_variant_discriminants: Map[String, Int]
  enum_has_payload: Map[String, Bool]
 # FIX 1: ONE TypeId universe. type_name_to_id is the INVERSE of the
  # typed program's type_names map (semantic TypeId -> name), built once in
  # lower_program from b.typed_type_names. MIR never mints TypeIds: MirTypeDef
  # ids and every Type::Adt constructed during lowering resolve through this
  # map, so the MIR universe is exactly the type checker's universe. There is
  # deliberately NO builder-side id counter in this struct anymore.
  type_name_to_id: Map[String, Int]
  type_defs: Vec[MirTypeDef]
  impl_type_map: Map[String, String]
 # bare method name -> the impl-registered mangled name, for the
  # EXTENSION impls — impls whose for_type is a generic PARAMETER
  # (`impl[T, I: Iterator[T]] I`, lowered as "I__map"/"I__any"/...). The
  # call-site method resolution names a callee from the RECEIVER's type
  # (TypeName__method), which cannot match an extension method; this table
  # maps the bare method name to the extension impl's mangled function so
  # such calls lower to the real callee. Only param-for_type impls register
  # here, so a bare name never collides across extension impls.
  param_impl_methods: Map[String, String]
  # ZERO-INFERENCE: mangled method name ("Type__method") -> the resolver's
  # method DefId, registered at lowering time from item_defs (the same
  # DefId the type checker records in typed_call_targets for source method
  # calls). IR-synthesized calls to a GENERIC method base (the projected
  # for-loop length call to "Vec__len") attach their instance BY
  # CONSTRUCTION from this table — the instance key is then byte-identical
  # to the checker-solved instances of the same method, so the
  # monomorphizer's cache stays single-sourced with ZERO inference.
  method_def_ids: Map[String, DefId]
 # mangled method name ("MyKey__hash") -> the method's DECLARED
  # parameter count (including `self`). Recorded alongside method_def_ids;
  # the map/set Hash/Eq dispatch gates on it: a core-ABI hash declares
  # exactly 1 param (hash(self) -> Int), a core-ABI eq exactly 2
  # (eq(self, other) -> Bool). Hasher-style impls
  # (`def hash[H: Hasher](self, state)`) declare 2 and never dispatch.
  method_param_counts: Map[String, Int]
 # the map/set Hash/Eq dispatch metadata table — mangled method
  # name -> (the resolver's DefId, the DefId's fn_owner_key_of_def
  # instance-base render, the declared parameter count). Populated at the
  # end of lower_program from method_def_ids + method_param_counts;
  # carried on MirProgram for the monomorphizer's dispatch-call injection
  # and codegen's per-site label resolution.
  dispatch_methods: Map[String, (DefId, String, Int)]
  fn_ret_types: Map[String, Type]
 # mangled callee name -> the DECLARED parameter types (the
  # same modifier resolution as the function lowering: Ref/Inout params are
  # RefInternal). Built in the same pre-pass as fn_ret_types. Consumed by
  # lower_call_arg's owned-String demand rule: a string LITERAL argument
  # converts to an OWNED String (string_from_static) exactly when the
  # callee's declared parameter at that position is a BY-VALUE String —
  # a &str (RefInternal) parameter keeps the literal's static StaticStrPtr form.
  fn_param_types: Map[String, Vec[Type]]
  # deinit_targets maps a type id to its registered finalizer CALLABLE —
  # the checker's Drop-impl / deinit-method registration (the resolver's
 # DefId, the same identity typed.deinit_targets carries — identity,
  # never the mangled name; the "Type__method" emission names are derived
  # only at the symbol-mangling boundary, indexed by method_names_by_def).
  # Absence of a finalizer means DeinitPlan::Trivial (resources may be
  # trivially deinitialized — this is the language rule, not an error).
  deinit_targets: Map[Int, CallableId]
 # (— the typed FinalizerKind): TypeId -> the finalizer
  # KIND the checker assigned at registration (typed.finalizer_kinds — the
  # mirror of deinit_targets). The builder's registration walk consumes the
  # KIND, never the source method name (deinit/drop spellings are not
  # recognized here — the checker's declaration-site assignment is the only
  # authority).
  finalizer_kinds: Map[Int, FinalizerKind] = Map::new()
 # the emission-name index of the registered finalizers (the
  # pre-pass's registration records every finalizer's mangled name here).
  # Consumed by the consumed-locals dataflow (block_own_consumed_locals):
  # a call to a REGISTERED finalizer consumes its receiver — the
  # registration is the identity source, never a bare name pattern.
  finalizer_emission_names: Set[String]
 # def_id_numeric(method DefId) -> the mangled emission name of the
  # method, built in the same pre-pass (complete before any function
  # lowering). MirProgram.method_names_by_def carries it to codegen.
  method_names_by_def: Map[Int, String]
 # the drop-glue function registry (see MirProgram.drop_glue_*).
  # Identities are assigned eagerly (mir_glue_instance_for_type — called
  # from plan construction and the whole-value destruction sites, safe
  # inside function lowering); the FUNCTION BODIES are built only at the
  # end of lower_program (mir_build_all_drop_glues — the builder's block
  # state must not be touched mid-lowering).
  drop_glue_counter: Int
  drop_glue_instances: Map[String, InstanceId]
  drop_glue_names: Map[String, String]
  drop_glue_fns: Map[Int, String]
  drop_glue_pending: Set[String]
  drop_glue_types: Vec[Type]
  drop_glue_functions: Vec[MirFunction]
 # the SEMANTIC cleanup tables from the resource checker (see
  # types.tg FunctionCleanupTable) — CallableId -> FunctionCleanup per
  # callable, the ScopeId-keyed defer registrations, the NodeId-keyed
  # closure sets, and the expr/assign statement-local plans. MIR uses this
  # as the PRIMARY cleanup source; the declared-locals analysis below is
  # only a fallback for synthetic functions. Single-sourced ownership:
  # semantic analysis decides, MIR emits. No cleanup semantics depend on
  # parsing a String prefix.
  finalize_plan: FunctionCleanupTable
 # the SEMANTIC identity of the function/method currently being
  # lowered — the resolver DefId wrapped (item_defs[item_idx][0] for free
  # functions, item_defs[item_idx][method_idx] for methods — the SAME
  # derivation the checker's item_callable / item_method_callable use).
  # deinit_candidates looks the function-end plan up by THIS identity.
  # Option::None at the closure/static/IR-only sites.
  current_callable: Option[CallableId]
 # the closure expression's NodeId while a closure body is being
  # lowered — the closure_cleanup table key (the "closure::<node id>"
  # String-key protocol is are not part of the model).
  current_closure_node: Option[NodeId]
 # the ONE Typed CFG of the
  # program — the resource checker's pre-built CfgEdge/CfgBlock records
  # plus the parallel CleanupEdge table (cfg.cleanup[i] is edge i's
  # CleanupEdge; the edge's index IS its CfgEdgeId). Every cleanup-lookup
  # site (lookup_cleanup_edge) reads the CleanupEdge ACTIONS — the
  # RunDefer actions (the exited scopes' defers, LIFO) and the Drop
  # actions (the live owning locals, reverse drop order) in execution
  # order — directly from this table. The String-keyed serializations
  # (the "edge::<kind>::<source>" edge_cleanup map and the
  # "return::<id>"/"break::<id>"/"continue::<id>"/"backedge::<id>"/
 # "block::<id>" finalize_plan keys) are not part of the model; the builder-side defer
  # registrations (defer_scope_defers / defer_stmt_ids_for_scope) remain
  # only as the fallback for synthesized/IR-only edges that never had a
  # checker record. The table reaches the builder through the
  # AnalyzedProgram artifact (lower_program consumes analyzed.cfg).
  cfg: TypedCFG
 # (phase 2): the TYPED iteration records (for-stmt node id
  # -> TypedIteration { plan }) produced by the resource checker's
  # check_for. This is the AUTHORITATIVE projected-vs-consuming decision
  # for for-loops (lower_for / typed_iteration_of): a Read plan means the
  # checker judged projected (by-reference) iteration safe — its escape
  # guard is the authority — so no MIR-side name-use scan is needed; a
  # Consume plan means snapshot iteration. Plans are absent only for
  # IR-only / synthesized for-stmts that never passed through the checker,
  # for which lower_for keeps the heuristic as the documented
  # fallback.
  typed_iterations: Map[Int, TypedIteration]
  # Recursive deinit plans per type id (from the typed program): container
  # types (Option[R], Array[R], Map[K,R], tuples...) get recursive cleanup.
 # NOTE (plan-key contract): this table is the SEMANTIC authority's
  # TypeId-keyed plan set — types.tg builds it in type_check_typed with
  # EMPTY generic args (Adt(tid, []))), so for a generic type the entry is
  # the UNSUBSTITUTED nominal shape (a Wrapper[T] entry cannot distinguish
  # Wrapper[Int] from Wrapper[File]). It is used ONLY as the fallback for
  # types without a MirTypeDef in this builder; the AUTHORITATIVE plans for
  # MIR/codegen are the CONCRETE (TypeId, substs)-keyed plans in
  # concrete_deinit_plans below (deinit_plan_for_type constructs them with
  # the args substituted — the plan-key fix; PENDING, docs/memory_model.md
  # §15.2: types.tg's table itself migrating to the concrete key).
  deinit_plans: Map[Int, DeinitPlan]
 # the CONCRETE deinit-plan cache — keyed by the concrete (TypeId,
  # substs) identity (mir_type_identity_key), populated by
  # deinit_plan_for_type as it constructs plans and completed by
  # mir_populate_concrete_plans at the end of lowering. MirProgram carries
  # this map to codegen; the MIR verifier keys its ownership/copyability
  # checks from it. A Param-carrying key holds the DEFERRED plan (the
  # concrete drop glue after substitution is the authority).
  concrete_deinit_plans: Map[String, DeinitPlan]
  # type id -> type name (needed to resolve Named types when walking plans).
  typed_type_names: Map[Int, String]
 # typed variant identities — semantic TypeId -> (variant name, field
  # types, discriminant) from the typed program's type_variants. This is the
  # AUTHORITATIVE source for enum variant resolution: variant construction
  # looks up the enum's TypeId, then the variant by name, and uses its
  # discriminant. The MIR-side enum-def scans below are only a
  # fallback; a variant absent from BOTH is an internal error, never a silent
  # discriminant 0.
  typed_type_variants: Map[Int, Vec[(String, Vec[Type], Int)]]
  # The owner key (fn_owner_key of the item's DefId, or the positional
  # fallback) of the function currently being lowered — the SAME key the
  # resource checker used for finalize_plan and param bindings.
  current_fn_key: String
  # Resolver item_defs (item index -> DefIds) for owner-key derivation.
  item_defs: Map[Int, Vec[DefId]]
  # Call expression node id -> resolved DefId from the typed program, so MIR
  # carries the semantic callable identity instead of re-resolving by name.
  call_def_ids: Map[Int, DefId]
 # (final): call expr node id -> the type checker's SOLVED generic
  # substitution (the callee's generic args in the callee's parameter
  # order), paired with call_def_ids. The solved substitutions from the
  # type checker are the AUTHORITY; the monomorphizer's inference is the
  # FALLBACK for synthesized/unsolved calls — mir_call_instance fills the
  # instance's substs from this map; absent entries keep empty substs.
  call_instances: Map[Int, Vec[Type]]
 # (IntrinsicId through MirCall): the checker's per-call semantic
  # intrinsic classification (TypedProgram.typed_intrinsics — call expr
  # node id -> IntrinsicId, attached at call-recording time). The lowering
  # reads it at the SOURCE call sites and STAMPS the MirCall (the
  # __intrinsic_* names and the classified builtin-container method calls);
  # codegen's dispatch reads the stamped id first and falls back to the
  # semantic router only for the synthesized calls.
  typed_intrinsics: Map[Int, IntrinsicId]
  # Typed identifier resolutions (expr node id -> local id); the semantic
  # source for lr_ident (name-based scope lookup is the
  # fallback).
  ident_resolutions: Map[Int, Int]
  # MirReturn blocks created by return-EDGE cleanup chains: their locals were
  # already finalized on that edge, so the function-level finalization pass
  # must not re-finalize them (double-deinit of sink params).
  return_edge_blocks: Set[Int]
  # Typed closure captures (closure expr node id -> captured local id ->
  # effect): the SEMANTIC capture record — the ONLY capture source.
  closure_captures: Map[Int, Map[Int, AccessEffect]]
  # Semantic local id (type-checker global counter) -> MIR local id. Semantic
  # locals are allocated globally during type checking; MIR locals are
  # per-function (0 = return place). Finalize-plan ids are SEMANTIC ids and
  # must be mapped through this table before emission — using them directly
  # as MIR ids would finalize the wrong (or nonexistent) local.
  semantic_to_mir: Map[Int, Int]
  # Typed pattern bindings (pat node id -> semantic local id) and parameter
  # bindings (owner key -> semantic ids in order): the semantic identities of
  # the locals MIR creates, used to populate semantic_to_mir.
  pattern_binding_resolutions: Map[Int, Int]
  param_binding_resolutions: Map[String, Vec[Int]]
  field_targets: Map[Int, FieldId]
  expr_types: Map[Int, Type]
 # (, phase 2 — the recursive tree): the Typed-HIR
  # node form — per source expression node id, the typed node the checker
  # recorded (TypedExpr { id, ty, kind }, kinds carrying their TYPED
  # CHILDREN per-variant). This is the PRIMARY lookup for the expression
  # type (TypedExpr.ty), the call identity and effects
  # (TypedExprKind::Call's TypedCall: TypedCallee / receiver_effect /
  # TypedCallArg effects), the field identity (TypedExprKind::Field's
  # TypedField — FieldId), and the variant identity (TypedExprKind::
  # Variant's TypedVariant — VariantId). The flat maps (expr_types /
  # call_def_ids / field_targets / access_effects / ident_resolutions)
  # remain the DERIVED INDEXES — the fallback for the nodes the checker
  # recorded in the flat maps but NOT in the node form (the typed-call
  # assembly failure class — the recording site's ICE).
  typed_exprs: Map[Int, TypedExpr]
  static_names: Set[String]
  static_types: Map[String, Type]
 # static/const name -> the static's SEMANTIC DefId (the resolver's
  # module_symbols identity — DefKind::Static / DefKind::Constant). Built in
  # lower_program's pre-pass from module_qualified_key(owner_path, name) —
  # the SAME qualified key the resolver records the DefId under. The static
  # REFERENCES (MirStaticRef / MirStaticAddr) carry this DefId; a reference
  # whose name never registered a DefId is an internal error at the
  # construction site (fail-closed — the emission label must never be
  # derived from an unverifiable name).
  static_def_ids: Map[String, DefId]
  access_effects: Map[Int, AccessEffect]
  typed_local_bindings: Map[Int, LocalBinding]
  declared_locals: Set[Int]
 # deferred-call emission. defer_blocks maps a StmtDefer's node id to
  # its lowered TEMPLATE block (the deferred body's statements, terminating
  # in a Goto to the block current at registration). At each exiting-edge
  # emission the template is CLONED into that site's chain — one scope's
  # defers can run on several distinct exits (fallthrough, return, break/
  # continue, backedge), and each exit has its own cleanup successor, which
  # a single block cannot express. The checker's ScopeId-keyed defer registration
  # (defer STMT ids in registration order) is the scope association; the
  # builder-side registrations below are the source-level authority when the
  # checker recorded no plan for a scope.
  defer_blocks: Map[Int, MirBlockId]
 # the MIR-side mirror of the checker's defer_chain — the block keys
  # of the enclosing lexical scopes being lowered (outermost first; loop
  # body scopes are stored NEGATED so the break/continue/backedge walks stop
  # exactly at the loop boundary, exactly like check_loop_body).
  defer_scope_chain: Vec[Int]
 # per-scope registration of defer STMT ids (in registration order),
  # maintained at StmtDefer lowering under the current scope key. The
  # fallback source when the semantic scope_defers table is absent.
  defer_scope_defers: Map[Int, Vec[Int]]
 # the typed program's Program — the crate module
  # table (Program.crate.modules) the DefId renders scan — and the resolver
  # snapshot whose def_kinds map carries every DefId's kind metadata
  # (DefId itself carries no kind). fn_owner_key_of_def / crate_module_path_of
  # (types.tg) consume these at the fn-key / emission-name renders; wired in
  # lower_program before any render runs (builder_new holds empty shells).
  program: Program
  resolutions: ResolvedNames
 # the generic-parameter interning table (the shared domain the
  # checker's table serializes into — see TypedProgram.generic_param_ids /
  # generic_param_names). The lowered functions reconstruct their
  # Type::Param ids from the typed record; IR-synthesized declarations
  # (MirTypeDefs, synthesized slice defs, closures without a typed record)
  # intern here — self-consistent within this builder, names recorded for
  # diagnostics.
  generic_param_table: GenericParamTable
 # fn owner key -> the generic parameter ids of that
  # function/method in the MIR's merged declaration order (impl-level
  # params first, then method-level params) — the checker's record, paired
  # positionally with the lowered declaration's merged generic list.
  generic_param_ids: Map[String, Vec[GenericParamId]]
  # The serialized param-name table (numeric GenericParamId ->
  # name) — the MIR's diagnostics render names from this snapshot; carried
  # on MirProgram for the monomorphizer.
  generic_param_names: Map[Int, String]
 # the canonical LangItems snapshot (TypedProgram.lang_items — the
  # checker's env.lang_items id-indexed table). Every synthesized Adt
  # construction for a builtin compound type (Option/Result/Vec/Map/Set/
  # Box/Rc/Array/Slice) reads its id HERE — the name-inversion is are not part of the model.
  lang_items: LangItems
 # the typed declaration records — fn owner key -> the checker's
  # resolved FnSignature (parameter ParamTypes + return type) and
  # module-qualified key -> the checker's resolved static/const/extern-static
  # declared type. The MIR reads EVERY declaration type from these tables
  # (a missing entry is an internal error — fail-closed); TypeExpr is never
  # interpreted after type checking. Copied from the typed program in
  # lower_program.
  typed_fn_signatures: Map[String, FnSignature]
  typed_static_types: Map[String, Type]
 # the typed program's nominal tables read at declaration lowering —
  # semantic TypeId -> struct field shapes (name, type) and TypeId -> the
  # declaration's generic parameter ids (the checker's declaration-order
  # record; the field types' Type::Param forms reference exactly these ids).
  typed_type_fields: Map[Int, Vec[(String, Type)]]
  typed_type_params: Map[Int, Vec[GenericParamId]]
 # (partial moves — place-level state): the SEMANTIC per-place move
  # registry copied from TypedProgram.place_move_states at lower_program —
  # root semantic local id -> joined field path ("a" / "a.b" — struct and
  # tuple indexes as "t<i>") -> PlaceMoveState. A path recorded Consumed
  # means the value at that projected place was moved out (extracted) and
  # the root's drop must skip it: the drop sites (emit_cleanup_chain's Drop
  # actions) consult this table and emit either the whole-value MirDeinit
  # (no record — full drop), the mask-carrying partial-drop chain (some
  # fields consumed — MirCall terminators to the field glues with constant
  # masks), or nothing (the whole root consumed — the checker would have
  # dropped the action). The registry is the MIR-side mirror of the frame's
  # per-field states; nested paths compose by the same mechanism (a nested
  # consumption emits the field's own glue with the field's own mask).
  place_move_states: Map[Int, Map[String, PlaceMoveState]]
end

struct PendingClosure
  name: String
  params: Vec[ClosureParam]
 # the closure's DECLARED parameter types in declaration order — the
  # typed tree's Type::Closure split at the construction site (the
  # checker's resolved types; never TypeExpr). The closure function's MIR
  # parameters are built from this record.
  param_types: Vec[Type]
  captures: Vec[String]
  capture_types: Vec[Type]
  body: Expr
  ret_type: Type
  # The SEMANTIC local ids of the captures, in the same order as `captures`
  # (from the typed capture record) — used to map semantic capture ids to the
  # closure function's MIR capture params.
  capture_ids: Vec[Int]
  # The closure expression's node id — the key of its typed capture record
  # AND its authoritative finalize plan entry ("closure::<node_id>").
  node_id: Int
end

def builder_new() -> MirBuilder
  MirBuilder {
    engine_env: engine_env_empty(),
    errors: Vec::new(),
    current_fn: Option::None,
    current_block: Option::None,
    local_counter: 0,
    block_counter: 0,
    temp_counter: 0,
    var_map: Map::new(),
    blocks: Vec::new(),
    pending_closures: Vec::new(),
    break_target: Option::None,
    continue_target: Option::None,
    enum_variants: Map::new(),
    enum_variant_discriminants: Map::new(),
    enum_has_payload: Map::new(),
    type_name_to_id: Map::new(),
    type_defs: Vec::new(),
    impl_type_map: Map::new(),
    param_impl_methods: Map::new(),
    method_def_ids: Map::new(),
    method_param_counts: Map::new(),
    dispatch_methods: Map::new(),
    fn_ret_types: Map::new(),
    fn_param_types: Map::new(),
    deinit_targets: Map::new(),
    finalizer_emission_names: Set::new(),
    method_names_by_def: Map::new(),
    drop_glue_counter: 0,
    drop_glue_instances: Map::new(),
    drop_glue_names: Map::new(),
    drop_glue_fns: Map::new(),
    drop_glue_pending: Set::new(),
    drop_glue_types: Vec::new(),
    drop_glue_functions: Vec::new(),
    finalize_plan: function_cleanup_table_new(),
    current_callable: Option::None,
    current_closure_node: Option::None,
    cfg: TypedCFG { edges: Vec::new(), blocks: Vec::new(), cleanup: Vec::new() },
    typed_iterations: Map::new(),
    deinit_plans: Map::new(),
    concrete_deinit_plans: Map::new(),
    typed_type_names: Map::new(),
    typed_type_variants: Map::new(),
    current_fn_key: "",
    item_defs: Map::new(),
    call_def_ids: Map::new(),
    call_instances: Map::new(),
    typed_intrinsics: Map::new(),
    ident_resolutions: Map::new(),
    closure_captures: Map::new(),
    return_edge_blocks: Set::new(),
    semantic_to_mir: Map::new(),
    pattern_binding_resolutions: Map::new(),
    param_binding_resolutions: Map::new(),
    field_targets: Map::new(),
    expr_types: Map::new(),
    typed_exprs: Map::new(),
    static_names: Set::new(),
    static_types: Map::new(),
    static_def_ids: Map::new(),
    generic_param_table: generic_param_table_new(),
    generic_param_ids: Map::new(),
    generic_param_names: Map::new(),
    lang_items: LangItems {
      option: -1,
      result: -1,
      vec: -1,
      map: -1,
      set: -1,
      box_: -1,
      rc: -1,
      array: -1,
      slice: -1,
      string: -1,
      str_view: -1,
      unique_ptr: -1,
      arc_strong: -1,
      weak_rc: -1,
      weak_arc: -1,
      ptr: -1,
      ptr_mut: -1,
      drop_trait: -1,
      clone_trait: -1,
      copy_trait: -1,
      eq_trait: -1,
      hash_trait: -1,
      transferable_trait: -1,
      shareable_trait: -1
    },
    typed_fn_signatures: Map::new(),
    typed_static_types: Map::new(),
    typed_type_fields: Map::new(),
    typed_type_params: Map::new(),
    place_move_states: Map::new(),
    access_effects: Map::new(),
    typed_local_bindings: Map::new(),
    declared_locals: Set::new(),
    defer_blocks: Map::new(),
    defer_scope_chain: Vec::new(),
    defer_scope_defers: Map::new(),
    program: Program {
      items: Vec::new(),
      crate: Crate { root: ModuleId { id: 0 }, modules: Map::new() },
      span: span_dummy()
    },
    resolutions: ResolvedNames {
      expr_resolutions: Map::new(),
      type_resolutions: Map::new(),
      pattern_resolutions: Map::new(),
      call_targets: Map::new(),
      type_def_ids: Map::new(),
      intrinsic_ids: Map::new(),
      item_defs: Map::new(),
      module_symbols: Map::new(),
      def_kinds: Map::new(),
      stable_ids: stable_id_map_new()
    }
  }
end

def enum_variant_discriminant_key(enum_name: String, variant_name: String) -> String
  enum_name.clone() + "::" + variant_name.clone()
end

def enum_variant_name_matches(actual_name: String, requested_name: String) -> Bool
  if actual_name == requested_name then
    return true
  end

  actual_name.ends_with(requested_name.clone())
end

def start_function(inout b: MirBuilder, name: String, ret_type: Type, span: Span) -> Unit
  b.local_counter = 0
  b.block_counter = 0
  b.var_map = Map::new()
  b.blocks = Vec::new()
  b.declared_locals = Set::new()
  # Block IDs restart from zero per function; return-edge-block suppression
  # must not leak across functions (a stale ID from function A would
  # suppress normal finalization of an unrelated return block in B).
  b.return_edge_blocks = Set::new()
 # defer state is per-function (block ids restart from zero).
  b.defer_blocks = Map::new()
  b.defer_scope_chain = Vec::new()
  b.defer_scope_defers = Map::new()
  
  let entry = MirBlockId { id: 0 }
  b.block_counter = 1
  
  # Create the entry block
  b.blocks.push(MirBlock {
    id: MirBlockId { id: entry.id },
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: span
    }
  })
  
  b.current_fn = Option::Some(MirFunction {
    name: name,
    params: Vec::new(),
    ret_type: ret_type.clone(),
    generic_params: Vec::new(),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: MirBlockId { id: entry.id },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span
  })
  
  b.current_block = Option::Some(MirBlockId { id: entry.id })
  # Create return place as local 0 (convention: locals[0] is the return place)
  let ret_local = MirLocal {
    id: MirLocalId { id: b.local_counter },
    name: "_ret".to_string(),
    ty: ret_type,
    is_mut: true,
    span: span
  }
  b.local_counter = b.local_counter + 1
  match b.current_fn
  when Option::Some(f) then
    f.locals.push(ret_local)
  when _ then ()
  end
end

# Whether a deinit callable with the given (mangled) name is registered for
# any type — used to detect that the function being lowered IS a finalizer
# (whose own self must never be re-finalized).
#
# (final layer): the owner key of a FREE function item — the SAME key
# the resource checker and the type checker derive (types.tg's
# fn_owner_key_of_item): the item's DefId rendered via fn_owner_key_of_def
# ("<module path>::<index>::<kind>" — the module path from the typed
# program's crate containment scan (crate_module_path_of) and the kind from
# the resolver's DefKind metadata (def_kind_of)) when the resolver recorded
# one, else the module-path-qualified name fallback ("module::<full
# path>::<name>" via module_qualified_fn_key). The identity flow is: the
# SEMANTIC function identity is the module-qualified DefId-derived key (this
# is what the finalize_plan / edge_cleanup / param-binding plans are keyed
# by); the MirFunction/MirFnItem NAME is the symbol-mangling boundary (the
# emission name), which codegen maps to labels. The fallback is only
# reachable for an item the resolver never recorded a DefId for — it must
# produce a key BYTE-IDENTICAL to the checker's, or the plan lookups below
# silently miss.
def mir_fn_owner_key(b: MirBuilder, item_idx: Int, module_path: Vec[String], name: String) -> String
  match b.item_defs.get(item_idx)
  when Option::Some(dids) then
    if dids.len() > 0 then
      let did = dids[0]
      return fn_owner_key_of_def(&b.program, &b.resolutions, &did)
    end
  when Option::None then ()
  end
  module_qualified_fn_key(module_path, name)
end

# the EMISSION name of a top-level function item — the name the
# MirFunction carries and codegen emits as its symbol/label. The identity
# flow is: source name -> DefId (resolver's item_defs, threaded by
# lower_program's module-path walk) -> fn_owner_key_of_def (semantic
# identity, "<module path>::<index>::<kind>" — the module path from the
# crate containment scan, the kind from the resolver's def_kinds metadata)
# -> the emission name (symbol-mangling boundary) -> codegen label. The
# source name survives ONLY as the diagnostics/display name.
#
# The single name-based residual: the OS-ENTRY function (source name "main"
# or "_start"). The linker's entry contract is unchangeable here (linker.tg
# resolves the entry symbol "main"/"_start" literally and injects _start
# calling "main"), so the entry function's emission name stays its source
# name — the linking boundary, exactly like extern symbols. Every
# REFERENCE to the entry keeps the source name too (see
# mir_callee_emission_name).
def mir_fn_emission_name(b: MirBuilder, item_idx: Int, module_path: Vec[String], name: String) -> String
  if name == "main" || name == "_start" then
    return name
  end
  match b.item_defs.get(item_idx)
  when Option::Some(dids) then
    if dids.len() > 0 then
      let did = dids[0]
      return fn_owner_key_of_def(&b.program, &b.resolutions, &did)
    end
  when Option::None then ()
  end
  name
end

# the EMISSION name of a CALL SITE's MirFnItem. When the call carries
# an InstanceId whose DefId is a TOP-LEVEL FUNCTION (DefKind::Function — the
# kind from the resolver's def_kinds metadata via def_kind_of; the DefId is
# inst.def.def, unwrapped from the CallableId), the callee name is the
# instance's fn_owner_key_of_def rendering — the SAME key the callee
# function's own lowering recorded (mir_fn_emission_name over item_defs), so
# the call reference and the emitted function name agree byte-for-byte and
# codegen's resolve_callee_label resolves through the identity entry. The
# fn_ret_types membership check is the structural verification that the
# derived name exists in THIS program; when it misses (a DefId whose module
# rendering diverges — e.g. a module-less target, or a path that
# resolved to a different module than the item's owner), the source name is
# kept: the documented name-based fallback for that exact shape.
#
# Everything else keeps its name, unchanged:
#   - methods (DefKind::Method) keep the "Type__method" mangled names — the
#     finalizer and registered-Drop identities depend on them;
#   - intrinsics/externs keep source names (the linking boundary);
#   - the OS-entry function keeps its source name ("main"/"_start"), and so
#     does every reference to it;
#   - synthesized/IR-only calls carry no instance and keep the name.
def mir_callee_emission_name(b: MirBuilder, base_name: String, instance: Option[InstanceId]) -> String
  if base_name == "main" || base_name == "_start" then
    return base_name
  end
  match instance
  when Option::Some(inst) then
    let did = inst.def.def.clone()
    match def_kind_of(&b.resolutions, &did)
    when Option::Some(kind) then
      if kind == DefKind::Function then
        let derived = fn_owner_key_of_def(&b.program, &b.resolutions, &did)
        match b.fn_ret_types.get(&derived)
        when Option::Some(_) then return derived
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  base_name
end

# The owner key of the item's function/method at (item index, method index):
# the DefId rendered via fn_owner_key_of_def (crate containment scan +
# def_kinds metadata) when the resolver recorded one, else the positional
# fallback — IDENTICAL to the resource checker's derivation
# (item_owner_key), so finalize_plan and param-binding lookups align.
def mir_item_owner_key(b: MirBuilder, item_idx: Int, method_index: Int) -> String
  match b.item_defs.get(item_idx)
  when Option::Some(dids) then
    if method_index < dids.len() then
      let did = dids[method_index]
      return fn_owner_key_of_def(&b.program, &b.resolutions, &did)
    end
  when Option::None then ()
  end
  "item::" + item_idx.to_string() + "::method::" + method_index.to_string()
end

# the SEMANTIC CallableId of the item's free function — the
# resolver DefId (item_defs[item_idx][0]) wrapped, the SAME derivation the
# resource checker's item_callable uses, so the by_callable cleanup-table
# lookups align. Option::None when the resolver recorded none.
def mir_fn_callable(b: MirBuilder, item_idx: Int) -> Option[CallableId]
  match b.item_defs.get(item_idx)
  when Option::Some(dids) then
    if dids.len() > 0 then
      Option::Some(CallableId { def: dids[0].clone() })
    else
      Option::None
    end
  when Option::None then Option::None
  end
end

# the SEMANTIC CallableId of the item's method at (item index,
# method index) — item_defs[item_idx][method_idx] wrapped (the checker's
# item_method_callable mirror). Option::None when the resolver recorded
# none.
def mir_item_callable(b: MirBuilder, item_idx: Int, method_index: Int) -> Option[CallableId]
  match b.item_defs.get(item_idx)
  when Option::Some(dids) then
    if method_index < dids.len() then
      Option::Some(CallableId { def: dids[method_index].clone() })
    else
      Option::None
    end
  when Option::None then Option::None
  end
end

def add_param(inout b: MirBuilder, name: String, ty: Type, span: Span) -> MirLocalId
  let id = MirLocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: false,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    # Both the param list and the local table own the record: the local
    # table receives an explicit copy (the sink push consumes the original).
    f.params.push(local)
    f.locals.push(local.clone())
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  b.declared_locals.insert(id.id)
  id
end

# Whether a local id exists in the current function.
def lookup_local_id(b: MirBuilder, local_id: MirLocalId) -> Option[MirLocal]
  match b.current_fn
  when Option::Some(f) then
    for l in f.locals do
      if l.id.id == local_id.id then
        return Option::Some(l.clone())
      end
    end
    Option::None
  when Option::None then Option::None
  end
end

def lookup_local_type(b: MirBuilder, local_id: MirLocalId) -> Type
  match b.current_fn
  when Option::Some(f) then
    for local in f.locals do
      if local.id.id == local_id.id then
        return local.ty.clone()
      end
    end
    Type::Unit
  when Option::None then Type::Unit
  end
end

def typed_binding_type_by_name(b: MirBuilder, name: String) -> Option[Type]
  var best: Option[Type] = Option::None
  var best_id = -1
  let entries = b.typed_local_bindings.entries()
  mut i = 0
  while i < entries.len() do
    if entries[i].1.name == name then
      if entries[i].0 > best_id then
        best = Option::Some(entries[i].1.ty.clone())
        best_id = entries[i].0
      end
    end
    i = i + 1
  end
  best
end

def builder_local_typed_ty(b: MirBuilder, local_id: MirLocalId) -> Option[Type]
  match b.current_fn
  when Option::Some(f) then
    for local in f.locals do
      if local.id.id == local_id.id then
        return typed_binding_type_by_name(b, &local.name)
      end
    end
    Option::None
  when Option::None then Option::None
  end
end

def builder_local_is_resource(inout b: MirBuilder, local_id: MirLocalId) -> Bool
 # the engine-backed ownership answer — the CONCRETE deinit plan for
  # the local's type (the plan tree is the drop-GLUE shape — the engine's
  # requires_drop_glue axis, NOT the resource-checking axis; see the
  # ENGINE-QUERY note at deinit_plan_for_type). The old nominal-kind
  # walk (type_kinds_contain_resource) missed concrete-args ownership
  # (Wrapper[File], Box[Int]) and classified by the nominal table only;
  # the plan query answers from the concrete (TypeId, substs) identity.
 # (FAIL-CLOSED): a Param-typed local (generic template) answers the
  # DEFERRED plan, and verifier_plan_contains_ownership answers Deferred
  # conservatively TRUE (may own) — the consumed-locals tracking never
  # treats an unsubstituted generic position as destruction-free.
  match builder_local_typed_ty(b, local_id)
  when Option::Some(ty) then
    var vis = Set::new()
    let plan = deinit_plan_for_type(b, &ty, &mut vis)
    verifier_plan_contains_ownership(&plan)
  when Option::None then false
  end
end

def deinit_candidates(inout b: MirBuilder, consumed: Set[Int]) -> Vec[Place]
  var places: Vec[Place] = Vec::new()
  # THE ONLY cleanup source: the authoritative finalize plan computed by the
 # resource checker — the SEMANTIC FunctionCleanupTable: the
  # per-callable FunctionCleanup.drops (Live Sink/OwnedLocal locals at
  # function end, excluding caller-owned let/inout params and the
  # finalizer's own self), or the closure_cleanup record under the closure
  # expression's NodeId while a closure body is lowered. MIR emits exactly
  # what semantic analysis decided — there is NO name-based fallback:
  # re-deriving ownership in MIR would be a second, divergent ownership
 # analysis. The String owner-key lookups are not part of the model.
  var plan_drops: Option[Vec[LocalId]] = Option::None
  match b.current_callable
  when Option::Some(cid) then
    match b.finalize_plan.by_callable.get(cid)
    when Option::Some(fc) then plan_drops = Option::Some(fc.drops.clone())
    when Option::None then ()
    end
  when Option::None then
    match b.current_closure_node
    when Option::Some(cnode) then
      match b.finalize_plan.closure_cleanup.get(cnode)
      when Option::Some(fc) then plan_drops = Option::Some(fc.drops.clone())
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  match plan_drops
  when Option::Some(drops) then
    for pid in drops do
      # Plan ids are SEMANTIC local ids (allocated globally during type
      # checking); map them to per-function MIR locals FIRST. The consumed
      # set holds MIR local ids (recorded from MirMovePlace/MirConsume
      # operands) — testing it with a semantic id would compare across
      # namespaces and could auto-finalize a moved value.
      match b.semantic_to_mir.get(pid.id)
      when Option::Some(mir_id) then
        if !consumed.contains(&mir_id) then
          # No name-based filter here: the emission phase
          # (emit_deinit_chain_at -> deinit_plan_for_type) decides per-place
          # via the recursive typed DeinitPlan, including containers.
          places.push(place_local(MirLocalId { id: mir_id }))
        end
      when Option::None then
          b.errors.push("internal error: finalize plan references semantic local _" + pid.id.to_string() + " with no MIR local in " + b.current_fn_key.clone())
      end
    end
  when Option::None then ()
  end
  places
end


# ———————————————————————————————————————————————————————————————
# (final layer): MIR-side DeinitPlan finalizer-callable
# construction-site verification (identity-based).
#
# INVARIANT (mirror of types.tg): every DeinitPlan::Call /
# DeinitPlan::UserFinalizer payload is the SEMANTIC InstanceId of a
# VERIFIED registered finalizer — a value of the builder's registered
# deinit_targets (the checker's Drop-impl / deinit-method registration:
# the resolver DefId, seeded from typed.deinit_targets and completed by
# the lowering pre-pass — never a name; the "Type__drop" / "Type__deinit"
# emission names are derived only at the symbol-mangling boundary). The MIR
# side has no diagnostic channel — a mismatch is an internal error: panic
# at CONSTRUCTION (the earlier gate than codegen's emission panic), never
# an unverifiable payload.
# ———————————————————————————————————————————————————————————————

# True when `callable` is a registered value of the builder's
# deinit_targets for some type id (DefId identity — never a name).
def mir_deinit_callable_is_registered(b: MirBuilder, callable: CallableId) -> Bool
  for (_, dv) in b.deinit_targets do
    if dv.def.module.id == callable.def.module.id && dv.def.index == callable.def.index then
      return true
    end
  end
  false
end

# Construct DeinitPlan::Call(instance) ONLY from a registered finalizer
# identity; a mismatch panics (fail-closed at construction, the earlier
# gate than codegen's emission panic). The instance's substs are the
# concrete type arguments of the planned type (empty = the nominal
# template form).
def mir_verified_deinit_call(b: MirBuilder, callable: CallableId, args: Vec[Type]) -> DeinitPlan
  if mir_deinit_callable_is_registered(b, callable) then
    DeinitPlan::Call(InstanceId { def: callable.clone(), substs: args.clone() })
  else
    panic("internal error: invalid finalizer identity at MIR plan construction (every DeinitPlan payload is a verified registered drop-glue identity)")
  end
end

# Construct DeinitPlan::UserFinalizer(instance, fields_plan) ONLY from a
# registered finalizer identity (same invariant as Call — the instance is
# the finalizer identity that later emits as a MirDeinit).
def mir_verified_deinit_finalizer(b: MirBuilder, callable: CallableId, args: Vec[Type], fields_plan: DeinitPlan) -> DeinitPlan
  if mir_deinit_callable_is_registered(b, callable) then
    DeinitPlan::UserFinalizer(InstanceId { def: callable.clone(), substs: args.clone() }, fields_plan)
  else
    panic("internal error: invalid finalizer identity at MIR plan construction (every DeinitPlan payload is a verified registered drop-glue identity)")
  end
end

# ———————————————————————————————————————————————————————————————
# the CONCRETE type identity (plan-key fix)
# ———————————————————————————————————————————————————————————————
# The structural identity string of a fully concrete type, INCLUDING its
# generic arguments — the (TypeId, substs) key that makes Wrapper[Int] and
# Wrapper[File] DISTINCT plan entries. This mirrors types.tg's
# type_identity_key_resolved (the engine's memo key for type_properties_of)
# minus the builtin-name special forms (Option/Result/Map/Set/Slice/Array/
# Box/Rc render as plain Named#<id> here — the key only has to be
# consistent between the MIR's plan-cache construction and the verifier/
# codegen lookups, all of which use THIS function).
# ENGINE-QUERY TODO: call types.tg's type_identity_key_resolved (the
# engine's own concrete key) once it is exported; the renderings are
# equivalent.
def mir_type_identity_key(ty: Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::Never then "Never"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::I128 then "I128"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::U128 then "U128"
  when Type::ISize then "ISize"
  when Type::USize then "USize"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::String then "String"
  when Type::Adt(tid, args) then
    var s = "Named#" + tid.id.to_string()
    var i = 0
    while i < args.len() do
      s = s + "[" + mir_type_identity_key(&args[i]) + "]"
      i = i + 1
    end
    s
  when Type::FixedArray(elem, n) then "FixedArray[" + mir_type_identity_key(elem) + ";" + n.to_string() + "]"
  when Type::Tuple(fields) then
    var s = "Tuple("
    var i = 0
    while i < fields.len() do
      if i > 0 then s = s + "," end
      s = s + mir_type_identity_key(&fields[i])
      i = i + 1
    end
    s + ")"
  when Type::FnPtr(params, ret, _) then
    var s2 = "FnPtr("
    var i2 = 0
    while i2 < params.len() do
      if i2 > 0 then s2 = s2 + "," end
      s2 = s2 + mir_type_identity_key(&params[i2].ty)
      i2 = i2 + 1
    end
    s2 + ")->" + mir_type_identity_key(ret)
  when Type::Closure(cid, params, ret, captures, _) then
    var s3 = "Closure(" + cid.id.to_string() + ":"
    var i3 = 0
    while i3 < params.len() do
      if i3 > 0 then s3 = s3 + "," end
      s3 = s3 + mir_type_identity_key(&params[i3].ty)
      i3 = i3 + 1
    end
    s3 + ")->" + mir_type_identity_key(ret) + "|" + mir_type_identity_key(captures)
  when Type::Ptr(inner) then "Ptr[" + mir_type_identity_key(inner) + "]"
  when Type::PtrMut(inner) then "PtrMut[" + mir_type_identity_key(inner) + "]"
  when Type::RefInternal(inner, _) then "Ref[" + mir_type_identity_key(inner) + "]"
  when Type::Effect(_, inner) then "Effect[" + mir_type_identity_key(inner) + "]"
  when Type::Var(id) then "Var#" + id.id.to_string()
  when Type::Param(gpid) then "Param(" + generic_param_id_numeric(&gpid).to_string() + ")"
  when Type::Dyn(id) then "Dyn#" + id.id.to_string()
  when Type::Error then "Error"
  end
end

# Compute (and cache) the deinit plan for every CONCRETE plan-shape carrier
# reachable from a type: Adt/Tuple/FixedArray nodes whose identity contains
# no Param/Var/Error (a Param-carrying node is the generic template's
# deferred state — the concrete drop glue after substitution governs).
# Mirrors the engine's per-concrete-type memoization (type_properties_of /
# type_identity_key_resolved) for the plan table.
def mir_collect_plan_for_type(inout b: MirBuilder, ty: Type) -> Unit
  match ty
  when Type::Adt(tid, args) then
    var concrete = true
    var ai = 0
    while ai < args.len() do
      if mir_type_has_deferred(&args[ai]) then concrete = false end
      ai = ai + 1
    end
    if concrete then
      var vis = Set::new()
      let _plan = deinit_plan_for_type(b, ty, &mut vis)
    end
    ai = 0
    while ai < args.len() do
      mir_collect_plan_for_type(b, &args[ai])
      ai = ai + 1
    end
  when Type::Tuple(fields) then
    var fi = 0
    while fi < fields.len() do
      mir_collect_plan_for_type(b, &fields[fi])
      fi = fi + 1
    end
  when Type::FixedArray(elem, _) then
    mir_collect_plan_for_type(b, elem)
  when Type::String then
 # (real String lifetime): register the String destructor plan (and
    # with it the _tg_string_drop identity in drop_glue_fns) for every
    # String that appears in the lowered MIR — the concrete-plan table and
    # the drop-glue label map are complete before MirProgram construction.
    var vis2 = Set::new()
    let _ = deinit_plan_for_type(b, ty, &mut vis2)
  when Type::FnPtr(params, ret, _) then
    var pi = 0
    while pi < params.len() do
      mir_collect_plan_for_type(b, &params[pi].ty)
      pi = pi + 1
    end
    mir_collect_plan_for_type(b, ret)
  when Type::Ptr(inner) then mir_collect_plan_for_type(b, inner)
  when Type::PtrMut(inner) then mir_collect_plan_for_type(b, inner)
  when Type::RefInternal(inner, _) then mir_collect_plan_for_type(b, inner)
  when Type::Effect(_, inner) then mir_collect_plan_for_type(b, inner)
  when _ then ()
  end
end

# True when a type contains a generic-parameter reference anywhere (its
# plan is deferred to the concrete drop glue after substitution).
def mir_type_has_deferred(ty: Type) -> Bool
  match ty
  when Type::Param(_) then true
  when Type::Var(_) then true
  when Type::Adt(_, args) then
    var ai = 0
    while ai < args.len() do
      if mir_type_has_deferred(&args[ai]) then return true end
      ai = ai + 1
    end
    false
  when Type::Tuple(fields) then
    var fi = 0
    while fi < fields.len() do
      if mir_type_has_deferred(&fields[fi]) then return true end
      fi = fi + 1
    end
    false
  when Type::FixedArray(elem, _) then mir_type_has_deferred(elem)
  when Type::FnPtr(params, ret, _) then
    var pi = 0
    while pi < params.len() do
      if mir_type_has_deferred(&params[pi].ty) then return true end
      pi = pi + 1
    end
    mir_type_has_deferred(ret)
  when Type::Ptr(inner) then mir_type_has_deferred(inner)
  when Type::PtrMut(inner) then mir_type_has_deferred(inner)
  when Type::RefInternal(inner, _) then mir_type_has_deferred(inner)
  when Type::Effect(_, inner) then mir_type_has_deferred(inner)
  when _ then false
  end
end

# Pre-populate the concrete plan cache with every concrete type visible in
# the lowered MIR (function locals incl. temps, ret types, constants,
# statics, type-def fields/variants, call operands). The codegen's drop
# glue (IntrinsicId::Drop / DropInPlace) and the MIR verifier key their
# plan lookups by the concrete identity, so a concrete type that never
# received a deinit chain must still have its plan available. Types that
# appear only as generic-template shapes stay deferred (the monomorphizer
# substitutes the concrete args the drop glue then looks up; those concrete
# args are present in the original MIR's call sites and are covered here).
def mir_populate_concrete_plans(inout b: MirBuilder, mir: MirProgram) -> Unit
  var vi = 0
  while vi < mir.types.len() do
    match mir.types[vi].kind
    when MirTypeDefKind::Struct(fields) then
      var fi = 0
      while fi < fields.len() do
        mir_collect_plan_for_type(b, &fields[fi].ty)
        fi = fi + 1
      end
    when MirTypeDefKind::Enum(variants) then
      var vv = 0
      while vv < variants.len() do
        var vfi = 0
        while vfi < variants[vv].fields.len() do
          mir_collect_plan_for_type(b, &variants[vv].fields[vfi])
          vfi = vfi + 1
        end
        vv = vv + 1
      end
    end
    vi = vi + 1
  end
  var si = 0
  while si < mir.statics.len() do
    mir_collect_plan_for_type(b, &mir.statics[si].ty)
    match mir.statics[si].init
    when Option::Some(op) then mir_collect_operand_plan_types(b, &op)
    when Option::None then ()
    end
    si = si + 1
  end
  var fn_i = 0
  while fn_i < mir.functions.len() do
    let f = mir.functions[fn_i]
    mir_collect_plan_for_type(b, &f.ret_type)
    var li = 0
    while li < f.locals.len() do
      mir_collect_plan_for_type(b, &f.locals[li].ty)
      li = li + 1
    end
    var bi = 0
    while bi < f.blocks.len() do
      let blk = f.blocks[bi]
      var st_i = 0
      while st_i < blk.statements.len() do
        mir_collect_statement_plan_types(b, &blk.statements[st_i])
        st_i = st_i + 1
      end
      mir_collect_terminator_plan_types(b, &blk.terminator)
      bi = bi + 1
    end
    fn_i = fn_i + 1
  end
end

def mir_collect_statement_plan_types(inout b: MirBuilder, stmt: MirStatement) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(_, rvalue) then
    mir_collect_rvalue_plan_types(b, &rvalue)
  when MirStatementKind::MirContractCheck(contract, operand) then
    mir_collect_operand_plan_types(b, &operand)
    mir_collect_operand_plan_types(b, &contract.condition)
  when MirStatementKind::MirEffectRecord(_, operand) then
    mir_collect_operand_plan_types(b, &operand)
  when MirStatementKind::MirStorageLive(_) then ()
  when MirStatementKind::MirStorageDead(_) then ()
  when MirStatementKind::MirNop then ()
  end
end

def mir_collect_rvalue_plan_types(inout b: MirBuilder, rvalue: MirRvalue) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(op) then mir_collect_operand_plan_types(b, &op)
  when MirRvalueKind::MirRef(_) then ()
  when MirRvalueKind::MirAggregate(kind, ops) then
    match kind
    when AggregateKind::MirArray(elem_ty) then mir_collect_plan_for_type(b, &elem_ty)
    when AggregateKind::Struct(tid, _) then
      mir_collect_plan_for_type(b, &Type::Adt(TypeId { id: tid.id }, Vec::new()))
    when AggregateKind::Closure(_) then
 # (ClosureId-keyed aggregate): the closure aggregate's concreteness
      # is carried by its OPERANDS (the closure's type is registered by its
      # ClosureId — never an Adt lookup); the operand walk below checks
      # every operand's embedded types.
      ()
    when AggregateKind::Generator(tid) then
      mir_collect_plan_for_type(b, &Type::Adt(TypeId { id: tid.id }, Vec::new()))
    when AggregateKind::Tuple then ()
    end
    var oi = 0
    while oi < ops.len() do
      mir_collect_operand_plan_types(b, &ops[oi])
      oi = oi + 1
    end
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    mir_collect_operand_plan_types(b, &lhs)
    mir_collect_operand_plan_types(b, &rhs)
  when MirRvalueKind::MirUnOp(_, op) then mir_collect_operand_plan_types(b, &op)
  when MirRvalueKind::MirDiscriminant(_) then ()
  when MirRvalueKind::MirLen(_) then ()
  when MirRvalueKind::MirCast(_, op, ty) then
    mir_collect_operand_plan_types(b, &op)
    mir_collect_plan_for_type(b, &ty)
  when MirRvalueKind::MirRepeat(op, _) then mir_collect_operand_plan_types(b, &op)
  when MirRvalueKind::MirPhi(_) then ()
  end
end

def mir_collect_terminator_plan_types(inout b: MirBuilder, term: MirTerminator) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    mir_collect_operand_plan_types(b, &op)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    mir_collect_operand_plan_types(b, &func)
    var ai = 0
    while ai < args.len() do
      match args[ai].value
      when MirCallValue::Value(op) then mir_collect_operand_plan_types(b, &op)
      when MirCallValue::Place(_) then ()
      end
      ai = ai + 1
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    mir_collect_operand_plan_types(b, &cond)
    match msg
    when AssertMessage::BoundsCheck(lo, hi) then
      mir_collect_operand_plan_types(b, &lo)
      mir_collect_operand_plan_types(b, &hi)
    when _ then ()
    end
  when MirTerminatorKind::MirGoto(_) then ()
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirAbort then ()
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then ()
  end
end

def mir_collect_operand_plan_types(inout b: MirBuilder, op: MirOperand) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(c) then mir_collect_plan_for_type(b, &c.ty)
  when MirOperandKind::MirCopy(_) then ()
  when MirOperandKind::MirMovePlace(_) then ()
  when MirOperandKind::MirRead(_) then ()
  when MirOperandKind::MirConsume(_) then ()
  end
end

# the CONCRETE-type-keyed deinit-plan entry point. The plan for a type
# is built ONCE per concrete (TypeId, substs) identity (mir_type_identity_key)
# and memoized in b.concrete_deinit_plans; MirProgram carries that cache to
# codegen. The engine authority: the plan tree is the concrete drop-GLUE
# shape — the types.tg engine's requires_drop_glue answers in boolean form
# (the needs_drop split: the drop-glue axis, NOT the resource-checking
# axis — String owns state AND requires the real glue since ) — this
# cache is its
# MIR-side memoization (mirror of type_properties_of's env.type_prop_cache,
# keyed like type_identity_key_resolved). The recursion-visit (Set[Int]) is
# threaded through the uncached construction below; a cached hit is a
# fully-computed plan, so it is safe to return early (the visited-dependent
# PlanLimit for an inline cycle is invariant: a fresh walk of the same
# concrete type revisits the same cycle).
def deinit_plan_for_type(inout b: MirBuilder, ty: Type, inout visited: Set[Int]) -> DeinitPlan
  let key = mir_type_identity_key(ty)
  match b.concrete_deinit_plans.get(key)
  when Option::Some(cached) then return cached.clone()
  when Option::None then ()
  end
  let plan = deinit_plan_for_type_uncached(b, ty, visited)
  b.concrete_deinit_plans.insert(key.clone(), plan.clone())
  if !deinit_plan_is_trivial(&plan) && !mir_type_has_deferred(ty) then
 # every CONCRETE non-trivial plan owns a generated drop-glue
    # function; the glue's semantic identity is assigned HERE (the body is
    # built at the end of lowering), so every whole-value destruction site
    # (cleanup chains, assignment replacement, the array-set old element)
    # can emit a MirDeinit carrying the glue instance.
    mir_glue_instance_for_type(b, ty)
  end
  plan
end

def deinit_plan_for_type_uncached(inout b: MirBuilder, ty: Type, inout visited: Set[Int]) -> DeinitPlan
 # (engine consumption — the needs_drop SPLIT): the drop-glue DECISION
  # comes from the types.tg engine on the CONCRETE type — type_properties_of
  # over the builder's snapshot env (b.engine_env, the typed program's
  # serialized engine tables). The gate is the REQUIRES_DROP_GLUE axis (the
  # physical-destructor axis): a type the engine answers not-requiring-glue
  # yields Trivial here (Option[Int], Tuple(Int, Int), FixedArray[Int; N],
  # StaticStrPtr — the borrowed view needs no destructor). String answers
 # requires_drop_glue=true (— real String lifetime: the owned object
  # and its buffer are real-heap allocations, the String drop frees both),
  # so its plan is the real destructor (DeinitPlan::String), never
  # Trivial. The plan table and the checker's finalize decisions answer
  # from the SAME authority, on their own axes. The
  # engine's owns_state axis deliberately does NOT gate the plan alone:
  # the drop-glue axis is the destructor gate. A DEFERRED type
  # (is_deferred — an unsubstituted Type::Param/Var in the graph) is NOT
  # gated: its plan is the generic template's deferred shape, the six
  # semantic fields are non-authoritative, and the concrete drop glue after
  # substitution governs (the Param arm below answers Trivial for the
  # deferred position; the monomorphizer's instances carry their own
  # concrete entries).
  let engine_props = type_properties_of(&mut b.engine_env, ty)
  if !engine_props.is_deferred && !engine_props.requires_drop_glue then
    return DeinitPlan::Trivial
  end
  match ty
  when Type::FixedArray(elem, _) then
    # The fixed array stores its elements INLINE: the drop glue walks the n
    # elements (no heap backing to release).
    DeinitPlan::Array(deinit_plan_for_type(b, &elem, visited))
  when Type::Adt(tid, args) then
 # Adt form of the builtin compound types (storage form).
    # Resolve the registered type name and mirror the canonical arms below;
    # the Adt form of Array is the heap-vector (the named Array[T] — fixed
    # arrays are the distinct Type::FixedArray variant handled above).
    # Anything else keeps the pre-existing Adt handling (def lookup, then
    # the typed deinit-plan fallback).
    let plan_named = match b.typed_type_names.get(tid.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
 # (engine consumption): the builtin SHAPE dispatch selects by the
    # ENGINE's LangItems TypeIds (b.engine_env.lang_items — the same
    # identity table type_named_props id-selects; type_identity_key_resolved
    # keys by the same ids). The registered-name chain below stays as the
    # defensive fallback for a snapshot missing an id (-1 — never for the
    # nine builtins, which register in type_env_new).
    let li = b.engine_env.lang_items
    if li.option != -1 && tid.id == li.option && args.len() >= 1 then
      DeinitPlan::Option(deinit_plan_for_type(b, &args[0], visited))
    elsif li.result != -1 && tid.id == li.result && args.len() >= 2 then
      DeinitPlan::Result(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
    elsif li.slice != -1 && tid.id == li.slice then
      # Slice[T] — the compiler-scoped VIEW { ptr: Ptr[T], len: UInt }:
      # owns=false, drop=none. A Slice local needs NO destruction regardless
      # of the element type (the element's ownership lives in the backing
      # container the view borrows). The view must not outlive its backing
      # buffer — the escape constraint is enforced by the safe access model
      # (the resource checker's IterationPlan projected-access enforcement is
      # the eventual mechanism).
      DeinitPlan::Trivial
    elsif li.array != -1 && tid.id == li.array && args.len() >= 1 then
      DeinitPlan::Array(deinit_plan_for_type(b, &args[0], visited))
    elsif li.map != -1 && tid.id == li.map && args.len() >= 2 then
      DeinitPlan::Map(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
    elsif li.set != -1 && tid.id == li.set && args.len() >= 1 then
      DeinitPlan::Set(deinit_plan_for_type(b, &args[0], visited))
    elsif li.box_ != -1 && tid.id == li.box_ && args.len() >= 1 then
      # Canonical Box[T] delegates to the registered Drop impl (drop_in_place
      # on the pointee + dealloc) — the same release path as the std struct
      # Box. The pointee plan is NOT expanded here: the drop handles it.
 # (final layer): the finalizer identity is the Box type's
      # REGISTERED Drop-impl CallableId (the builder's registration — the
      # checker's table seeded at lower_program, never a "Box__drop" name);
      # a mismatch panics (fail-closed at construction).
      match b.deinit_targets.get(tid.id)
      when Option::Some(box_callable) then mir_verified_deinit_call(b, &box_callable, &args)
      when Option::None then DeinitPlan::PlanLimit
      end
    elsif li.rc != -1 && tid.id == li.rc && args.len() >= 1 then
      # Canonical Rc[T] delegates to its registered Drop impl (strong-count
      # decrement, destroy + dealloc at zero). Rc[Int] needs the release even
      # though Int is not a resource.
 # (final layer): same construction-site gate as Box — the
      # registered Drop-impl CallableId, never a name.
      match b.deinit_targets.get(tid.id)
      when Option::Some(rc_callable) then mir_verified_deinit_call(b, &rc_callable, &args)
      when Option::None then DeinitPlan::PlanLimit
      end
    elsif plan_named == "Option" && args.len() >= 1 then
      DeinitPlan::Option(deinit_plan_for_type(b, &args[0], visited))
    elsif plan_named == "Result" && args.len() >= 2 then
      DeinitPlan::Result(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
    elsif plan_named == "Slice" then
      # Slice[T] — the compiler-scoped VIEW { ptr: Ptr[T], len: UInt }:
      # owns=false, drop=none (the id-selected arm above is the primary
      # path; this is the snapshot-fallback twin).
      DeinitPlan::Trivial
    elsif plan_named == "Array" && args.len() >= 1 then
      DeinitPlan::Array(deinit_plan_for_type(b, &args[0], visited))
    elsif plan_named == "Map" && args.len() >= 2 then
      DeinitPlan::Map(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
    elsif plan_named == "Set" && args.len() >= 1 then
      DeinitPlan::Set(deinit_plan_for_type(b, &args[0], visited))
    elsif plan_named == "Box" && args.len() >= 1 then
      # The Adt Box form mirrors the canonical Box arm — the REGISTERED
      # Drop-impl CallableId of the Box type (never a name).
      match b.deinit_targets.get(tid.id)
      when Option::Some(box_callable2) then mir_verified_deinit_call(b, &box_callable2, &args)
      when Option::None then DeinitPlan::PlanLimit
      end
    elsif plan_named == "Rc" && args.len() >= 1 then
      # The Adt Rc form mirrors the canonical Rc arm — the REGISTERED
      # Drop-impl CallableId of the Rc type (never a name).
      match b.deinit_targets.get(tid.id)
      when Option::Some(rc_callable2) then mir_verified_deinit_call(b, &rc_callable2, &args)
      when Option::None then DeinitPlan::PlanLimit
      end
    else
      # CONCRETE plan construction: resource containment can depend on the
      # generic args (Wrapper[Int] vs Wrapper[File] share a TypeId but need
      # different cleanup). Build from the type definition with the args
      # substituted; the cached per-TypeId plan is only a fallback for types
      # without a definition in this builder.
      var found_def: Option[MirTypeDef] = Option::None
      for td in b.type_defs do
        if td.id.id == tid.id then
          found_def = Option::Some(td.clone())
        end
      end
      match found_def
      when Option::Some(td) then
        # Cycle detection: a recursive owning type (Tree -> Vec[Tree],
        # Json -> Map[String, Json], a Box/Rc-linked list) cannot be
        # expanded into a finite plan tree INLINE — the recursion edge is
        # broken BY SYMBOL: the plan edge becomes a Call to the type's own
        # MEMOIZED drop-glue function (mir_glue_instance_for_type — the
        # identity is assigned eagerly HERE, so the pending glue body built
        # at the end of lowering (mir_build_all_drop_glues) can reference
        # it: the glue's plan walk emits a MirDeinit carrying the glue's
        # OWN InstanceId, which codegen resolves to the glue's label via
        # drop_glue_fns — the recursion terminates at runtime when the
        # container is empty, instead of expanding the plan tree to
        # PlanLimit). The plan for the cycle type is inserted into
        # concrete_deinit_plans when the outer construction completes, so
        # every later query (including the glue-body construction) hits the
        # cache and sees the cycle-broken plan.
        if visited.contains(&tid.id) then
          DeinitPlan::Call(mir_glue_instance_for_type(b, ty))
        else
          visited.insert(tid.id)
 # (engine alignment): the plan SHAPE derives from the concrete
          # definition + the registered deinit identity ONLY — the former
          # nominal-kind gate (b.resource_kinds: Resource/Capability vs
          # Value) is REMOVED (the field itself is are not part of the model: the snapshot
          # carried declared-kind display only and no ownership decision
          # ever read it; the typed.type_kinds consumers for ownership were
          # migrated to the engine). Both arms composed the same
          # deinit_targets + container/structural shape (the resource arm
          # skipped the container check, but every container name is
          # intercepted above by plan_named), so the gate was a re-
          # classification with no decision power. The
          # requires_drop_glue DECISION (whether a local has a physical
          # destructor at all) is the ENGINE's answer (type_properties_of
          # at the top of this function); the plan tree is the drop shape.
 # viral containment through ORDINARY value types too — a
          # plain `struct Wrapper[T] { item: T }` with Wrapper[Probe] must
          # yield a structural plan even though its nominal kind is Value
          # (resource-ness derives from the substituted concrete fields,
          # not the nominal TypeKind). Container names get their canonical
          # plans; everything else gets the structural plan. A type with a
          # registered deinit (impl Drop) runs its drop — e.g. Box[T] { ptr }
          # would otherwise leak the pointee through a structural walk that
          # sees only a Ptr.
          let structural_plan = match b.deinit_targets.get(tid.id)
          when Option::Some(n) then
 # (final layer): construction-site gate — the callable
            # comes from the registered deinit_targets lookup (the
            # checker's Drop-impl / deinit-method registration — the
            # resolver DefId, never a name), but the check is explicit: an
            # unregistered identity panics (fail-closed) instead of
            # constructing an unverifiable payload.
            let container_plan = mir_named_container_plan(b, &td, &args, visited)
            let struct_shape = if deinit_plan_is_trivial(&container_plan) then
              mir_structural_plan(b, &td, &args, visited)
            else
              container_plan
            end
            if deinit_plan_is_trivial(&struct_shape) then
              mir_verified_deinit_call(b, &n, &args)
            else
              mir_verified_deinit_finalizer(b, &n, &args, struct_shape)
            end
          when Option::None then
            let container_plan = mir_named_container_plan(b, &td, &args, visited)
            if deinit_plan_is_trivial(&container_plan) then
              mir_structural_plan(b, &td, &args, visited)
            else
              container_plan
            end
          end
          visited.remove(&tid.id)
          structural_plan
        end
      when Option::None then
 # (plan-key note): this fallback is the SEMANTIC authority's
        # TypeId-keyed plan (types.tg builds it with EMPTY generic args —
        # the UNSUBSTITUTED nominal shape). It fires only for types without
        # a MirTypeDef here; the concrete (TypeId, substs)-keyed cache
        # (b.concrete_deinit_plans) is the authoritative table for MIR and
        # codegen. PENDING (docs/current/memory_model.md §15.2): types.tg's
        # own table still uses the nominal key (build_deinit_plan is already
        # concrete-args aware).
        match b.deinit_plans.get(tid.id)
        when Option::Some(plan) then plan.clone()
        when Option::None then DeinitPlan::Trivial
        end
      end
    end
  when Type::Tuple(fields) then
    var plans = Vec::new()
    for f in fields do
      plans.push(deinit_plan_for_type(b, &f, visited))
    end
    DeinitPlan::Tuple(plans)
  when Type::Param(_) then
 # GENERIC-PARAMETER CONTRACT (— FAIL-CLOSED): a plan for a
    # Type::Param position is the DEFERRED answer — the engine
    # (type_properties_of's Param arm) answers is_deferred=true with the
    # six semantic fields non-authoritative (the requires_drop_glue gate at
    # the top of this function skips deferred types), and the checker
    # records Param-position locals' drop obligations WITHOUT deciding a
    # concrete destructor. DeinitPlan::Deferred carries NO concrete answer:
    # the CONCRETE drop glue after substitution (the monomorphized
    # instance's concrete plan — this cache's concrete-keyed entries) is
    # the authority. The former Trivial answer here was FAIL-OPEN ("no
    # destructor" for a substituted resource instantiation); Deferred fails
    # CLOSED at any emission attempt (emit_plan_deinit panics, mirroring
    # PlanLimit).
    DeinitPlan::Deferred
  when Type::Var(_) then
    # An unresolved inference variable is the same deferred position: no
    # concrete answer may be given (the former Trivial fall-through was
    # fail-open for a Var that survives to planning).
    DeinitPlan::Deferred
  when Type::String then
 # (real String lifetime): the OWNED String's destructor. The engine
    # answers requires_drop_glue=true for String (the object AND its data
    # buffer are real-heap allocations with a real free — the former
    # arena-reclaim Trivial split is gone), so the plan is the String
    # destructor: the drop-glue walk emits the _tg_string_drop runtime
    # call (DeinitPlan::String — see emit_plan_deinit's arm), which
    # releases the buffer and the object.
    DeinitPlan::String
  when _ then DeinitPlan::Trivial
  end
end

# Structural (field/variant) plan for a nominal type def, with the concrete
# args substituted into field types.
def mir_structural_plan(inout b: MirBuilder, td: MirTypeDef, args: Vec[Type], inout visited: Set[Int]) -> DeinitPlan
  match td.kind
  when MirTypeDefKind::Struct(fields) then
    var plans = Vec::new()
    for f in fields do
      let fty = subst_type_args(&f.ty, &td.generic_params, args)
      plans.push(deinit_plan_for_type(b, &fty, visited))
    end
    DeinitPlan::Aggregate(plans)
  when MirTypeDefKind::Enum(variants) then
 # (DeinitPlan::Enum — VariantId): the plan's per-variant payload
    # carries the SEMANTIC VariantId (owner TypeId + DECLARATION index —
    # never a variant name); the drop-glue emission projects the downcast
    # through that id directly (Projection::Variant(vid)), no name
    # resolution.
    var vmap = Map::new()
    var variant_idx = 0
    while variant_idx < variants.len() do
      let v = variants[variant_idx]
      var vplans = Vec::new()
      var vi = 0
      while vi < v.fields.len() do
        let vty = subst_type_args(&v.fields[vi], &td.generic_params, args)
        vplans.push(deinit_plan_for_type(b, &vty, visited))
        vi = vi + 1
      end
      vmap.insert(v.discriminant, (VariantId { owner: td.id, index: variant_idx as UInt }, vplans))
      variant_idx = variant_idx + 1
    end
    DeinitPlan::Enum(vmap)
  end
end

# Named container types (Option/Result/Array/Vec/Map/Set) resolve to
# canonical plans. (engine consumption): the selection keys by the
# ENGINE's LangItems TypeIds (b.engine_env.lang_items — the identity table
# type_named_props id-selects; td.id is the semantic TypeId, FIX 1), with
# the registered name as the defensive fallback for a snapshot missing an
# id (-1).
def mir_named_container_plan(inout b: MirBuilder, td: MirTypeDef, args: Vec[Type], inout visited: Set[Int]) -> DeinitPlan
  let li = b.engine_env.lang_items
  if ((li.option != -1 && td.id.id == li.option) || (li.option == -1 && td.name == "Option")) && args.len() >= 1 then
    DeinitPlan::Option(deinit_plan_for_type(b, &args[0], visited))
  elsif ((li.result != -1 && td.id.id == li.result) || (li.result == -1 && td.name == "Result")) && args.len() >= 2 then
    DeinitPlan::Result(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
  elsif ((li.vec != -1 && td.id.id == li.vec) || (li.array != -1 && td.id.id == li.array)) && args.len() >= 1 then
    DeinitPlan::Array(deinit_plan_for_type(b, &args[0], visited))
  elsif (li.vec == -1 && li.array == -1) && (td.name == "Array" || td.name == "Vec") && args.len() >= 1 then
    DeinitPlan::Array(deinit_plan_for_type(b, &args[0], visited))
  elsif ((li.map != -1 && td.id.id == li.map) || (li.map == -1 && td.name == "Map")) && args.len() >= 2 then
    DeinitPlan::Map(deinit_plan_for_type(b, &args[0], visited), deinit_plan_for_type(b, &args[1], visited))
  elsif ((li.set != -1 && td.id.id == li.set) || (li.set == -1 && td.name == "Set")) && args.len() >= 1 then
    DeinitPlan::Set(deinit_plan_for_type(b, &args[0], visited))
  else
    DeinitPlan::Trivial
  end
end

# ———————————————————————————————————————————————————————————————
# the generated drop-glue FUNCTION.
#
# For every CONCRETE type with a non-trivial deinit plan, the MIR generates
# ONE ordinary MirFunction (MirFunction with MirLocalIds/MirBlocks, pushed
# to MirProgram.functions like every other lowered function) that destroys
# a value of that type at a given address. Backend codegen knows NOTHING
# about "how to destroy a Result" or "how to recursively destroy a Map" —
# it just calls the pre-generated glue function (the label resolved from
# the glue's InstanceId via MirProgram.drop_glue_fns).
#
# GLUE SHAPE (— the initialized-mask parameter): every glue is
#   fn __tg_drop_glue$<concrete-type-key>(ptr: Ptr[T], mask: Int) -> Unit
#     entry:  value = *ptr                 (one copy into an ordinary local)
#             goto chain
#     chain:  the plan walk (emit_plan_deinit) on the value local — the
#             finalizer calls are MirDeinit terminators carrying the
#             FINALIZER's InstanceId; the structural walks (discriminant
#             switches, drains, element loops) are ordinary MIR blocks.
#             MirReturn
# The mask is the initialized-fields bitmask (bit i = field i of the
# concrete type is initialized; all-ones = the full drop). Whole-value
# destruction sites (the MirDeinit terminators — codegen emits the full
# mask into the argument) and the partial-drop sites (MirCall terminators
# with a constant live-field mask) share the ONE memoized glue per concrete
# type; the walk's mask_local mode (emit_plan_deinit) conditions the field
# drops on the mask bits. The RECURSION-BY-SYMBOL edge of a recursive
# owning type is a MirDeinit carrying the glue's OWN InstanceId — the glue
# calls itself (drop_glue_fns resolves the label); the recursion terminates
# at runtime when the container is empty.
#
# NORMATIVE DESTRUCTION ORDER (specified ONCE here, used by EVERY generated
# glue; the walk in emit_plan_deinit below follows it):
#   - structs (Aggregate) and tuples (Tuple): FIELD DECLARATION ORDER —
#     field 0 first, then 1,... (forward walk);
#   - enums (Enum): VARIANT DECLARATION ORDER (the plan's variant map is
#     inserted in declaration order — Map iteration preserves insertion
#     order), and within the active variant the PAYLOAD FIELDS in field
#     declaration order (forward walk);
#   - collections: ELEMENT ORDER — fixed arrays and heap vectors walk
#     index 0..n-1 forward; Map/Set drain their entries in the runtime's
#     iteration order (the drain loop terminates when the drain returns
#     None);
#   - a user finalizer (UserFinalizer) runs FIRST, then the compiler-owned
#     structural field cleanup (the exactly-once rule).
# ———————————————————————————————————————————————————————————————

# The drop-glue function's EMISSION NAME for a concrete type: the
# deterministic "__tg_drop_glue$" + the concrete type identity key. The
# name is the symbol-mangling boundary (codegen resolves it through
# resolve_callee_label like any other emitted function); the SEMANTIC
# identity is the glue's InstanceId (def_id_numeric -> drop_glue_fns). The
# raw identity key is sanitized for the object-symbol domain (labels keep
# only alphanumerics/_/$) and suffixed with an FNV-1a digest of the RAW key
# so two distinct keys can never sanitize to the same name.
def mir_drop_glue_name(ty: Type) -> String
  let raw_key = mir_type_identity_key(ty)
  var safe_chars: Vec[Char] = Vec::new()
  let bytes: Vec[Int] = raw_key.bytes()
  var hash: UInt = 0x811c9dc5
  for c in bytes do
    hash = hash ^ (c as UInt)
    hash = hash * 0x01000193
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
    if ok then
      safe_chars.push(c as Char)
    else
      safe_chars.push('_')
    end
  end
  "__tg_drop_glue$" + String::from_chars(safe_chars) + "$" + hash.to_string()
end

# (real String lifetime): the synthetic identity of the OWNED String
# destructor — the runtime function _tg_string_drop (runtime.tg emits it
# unconditionally in emit_all_runtime; codegen resolves the label through
# the SAME identity authority every destruction identity uses:
# drop_glue_fns — see codegen_deinit_label). A dedicated DefId in the
# synthetic module band (module -2, the same band the drop-glue identities
# use), registered ONCE in drop_glue_instances / drop_glue_fns under the
# runtime emission name; NOT a generated MirFunction (no glue body — the
# runtime emits the destructor, so drop_glue_pending is never touched).
# The MirDeinit verifier accepts the identity because drop_glue_fns
# membership is a legal destruction-callee.
def mir_string_drop_instance(inout b: MirBuilder) -> InstanceId
  match b.drop_glue_instances.get("StringDrop".to_string())
  when Option::Some(existing) then return existing.clone()
  when Option::None then ()
  end
  let sd_def = DefId { module: ModuleId { id: -2 }, index: b.drop_glue_counter as UInt }
  b.drop_glue_counter = b.drop_glue_counter + 1
  let sd_inst = InstanceId { def: CallableId { def: sd_def }, substs: Vec::new() }
  b.drop_glue_instances.insert("StringDrop".to_string(), sd_inst.clone())
  b.drop_glue_fns.insert(def_id_numeric(&sd_def), "_tg_string_drop".to_string())
  sd_inst
end

# Assign (idempotently) the drop-glue function's semantic identity for a
# concrete type: a fresh synthesized CallableId (DefId in the synthetic
# glue module domain — module id -2 with a dedicated counter, never
# colliding with source ModuleIds or the generic-param table's -1
# synthetic owners), recorded in drop_glue_instances / drop_glue_names /
# drop_glue_fns and marked pending for body construction. Safe to call
# during function lowering (no builder block state is touched — the bodies
# are built only in mir_build_all_drop_glues at the end of lowering).
def mir_glue_instance_for_type(inout b: MirBuilder, ty: Type) -> InstanceId
  let key = mir_type_identity_key(ty)
  match b.drop_glue_instances.get(key)
  when Option::Some(existing) then return existing.clone()
  when Option::None then ()
  end
  let glue_def = DefId { module: ModuleId { id: -2 }, index: b.drop_glue_counter as UInt }
  b.drop_glue_counter = b.drop_glue_counter + 1
  let callable = CallableId { def: glue_def }
  let inst = InstanceId { def: callable, substs: Vec::new() }
  let name = mir_drop_glue_name(ty)
  b.drop_glue_instances.insert(key.clone(), inst.clone())
  b.drop_glue_names.insert(key.clone(), name.clone())
  b.drop_glue_fns.insert(def_id_numeric(&glue_def), name.clone())
  b.drop_glue_pending.insert(key)
  b.drop_glue_types.push(ty.clone())
  inst
end

# The glue instance for a type whose whole-value destruction a MirDeinit
# may emit (cleanup chains, assignment replacement, the array-set old
# element): Option::None for DEFERRED types (Param/Var-carrying — the
# concrete drop glue after substitution governs; the checker never
# finalizes Param-position locals) and for trivial plans (nothing to
# destroy). Ensures the identity so the emission never needs the
# not-yet-built body.
def mir_try_glue_instance(inout b: MirBuilder, ty: Type) -> Option[InstanceId]
  if mir_type_has_deferred(ty) then
    return Option::None
  end
  var vis = Set::new()
  let plan = deinit_plan_for_type(b, ty, &mut vis)
  if deinit_plan_is_trivial(&plan) then
    return Option::None
  end
  Option::Some(mir_glue_instance_for_type(b, ty))
end

# Construct the drop-glue function BODY for one concrete type: an ordinary
# MirFunction ((ptr: Ptr[T], mask: Int) params; the value is copied into an
# ordinary local; the plan walk on that local; MirReturn). The walker's
# chains and the value local behave byte-identically to the former inline
# cleanup chains (the value's address is deref'd exactly once, at the copy).
# (partial-drop conditioning): the SECOND parameter is the
# initialized-fields bitmask — bit i of level 0 = field i of the concrete
# type is initialized. Whole-value destruction sites (the MirDeinit
# terminators at cleanup chains / assignment replacement) pass the FULL
# mask (all-ones — codegen emits -1 into the mask argument); the
# partial-drop sites (MirCall terminators to the glue label with a constant
# mask) pass the live-field mask, and the walk (emit_plan_deinit's
# mask_local mode) drops exactly the initialized fields.
def mir_build_drop_glue_for_type(inout b: MirBuilder, ty: Type) -> Unit
  let key = mir_type_identity_key(ty)
  match b.drop_glue_names.get(key)
  when Option::None then ()
  when Option::Some(name) then
    let span = span_dummy()
    var vis = Set::new()
    let plan = deinit_plan_for_type(b, ty, &mut vis)
    start_function(b, name.clone(), Type::Unit, span)
    let ptr_local = add_param(b, "ptr", Type::Ptr(ty.clone()), span)
    let mask_local = add_param(b, "mask", Type::Int, span)
    let value_local = add_local(b, "value", ty.clone(), false, span)
    push_assign(b, place_local(value_local), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(place_deref(place_local(ptr_local)))
    }) }, span)
    let exit_blk = create_block(b)
    switch_to_block(b, exit_blk)
    set_terminator(b, MirTerminatorKind::MirReturn, span)
    let chain_entry = emit_plan_deinit(b, &place_local(value_local), &plan, exit_blk, span, Option::Some(mask_local))
    switch_to_block(b, MirBlockId { id: 0 })
    set_terminator(b, MirTerminatorKind::MirGoto(chain_entry), span)
    match finish_function(b)
    when Option::Some(f) then b.drop_glue_functions.push(f)
    when Option::None then ()
    end
  end
end

# Build every pending drop-glue function body (called at the end of
# lower_program, after all source functions are lowered — the builder's
# per-function block state is free there) and append them to the program.
# The types are taken from drop_glue_types (recorded at identity
# assignment — the identity key string cannot reconstruct the Type).
def mir_build_all_drop_glues(inout b: MirBuilder, inout result: MirProgram) -> Unit
  var ti = 0
  while ti < b.drop_glue_types.len() do
    mir_build_drop_glue_for_type(b, &b.drop_glue_types[ti])
    ti = ti + 1
  end
  var gi = 0
  while gi < b.drop_glue_functions.len() do
    result.functions.push(b.drop_glue_functions[gi].clone())
    gi = gi + 1
  end
end


# ———————————————————————————————————————————————————————————————
# The plan WALK — the destruction of one value, emitted as ordinary MIR
# inside the generated drop-glue function (mir_build_drop_glue_for_type).
# The walk follows the NORMATIVE DESTRUCTION ORDER documented at
# mir_drop_glue_name (field declaration order for structs/tuples; variant
# declaration order then payload field order for enums; element order for
# arrays/maps/sets; the user finalizer first, then structural cleanup).
# Every finalizer call is a MirDeinit terminator carrying the FINALIZER's
# semantic InstanceId (the DeinitPlan payload — resolved at construction
# from the registered Drop-impl / deinit identity); codegen never
# interprets the plan tree — it emits a call to the pre-generated glue
# function whose body this walk produces.
#
# (partial-drop conditioning): the walk's `mask_local` parameter is the
# glue function's initialized-fields bitmask (Option::None = unconditional
# whole-value walk — the mode every pre-existing call site uses).
# When Some(m): the walk's DIRECT children are gated on the mask bits —
#   - Aggregate/Tuple: field i is walked iff bit i of m is set;
#   - Enum: the whole value is walked iff m != 0, and the ACTIVE variant's
#     payload field j is walked iff bit j of m is set;
#   - single-child plans (Call/UserFinalizer/Array/Set/Map/Option/Result):
#     the child is walked iff m != 0.
# The FLAT-MASK contract: a gated child's own sub-walk is UNCONDITIONAL —
# nested partial consumption is expressed by the drop SITE emitting nested
# glue calls (the field's own glue with the field's own mask), never by a
# multi-level mask. Full destruction passes the all-ones mask (every bit
# set — every field walked, byte-identical to the unconditional walk).
# ———————————————————————————————————————————————————————————————

# One initialized-field gate: a block that routes to `live_succ` when the
# mask satisfies the liveness test and to `dead_succ` otherwise. bit > 0
# tests (mask & bit) != 0 — field i's initialized bit; bit == 0 tests the
# WHOLE mask (m != 0) — the single-child liveness convention. Returns the
# gate's entry block.
def emit_mask_gate(inout b: MirBuilder, mask_local: MirLocalId, bit: Int, live_succ: MirBlockId, dead_succ: MirBlockId, span: Span) -> MirBlockId
  let gate_blk = create_block(b)
  switch_to_block(b, gate_blk)
  let gate_tmp = add_temp(b, Type::Int, span)
  if bit > 0 then
    push_assign(b, place_local(gate_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::BitAnd,
      operand_copy_local(mask_local),
      operand_int(bit)
    ) }, span)
  else
    push_assign(b, place_local(gate_tmp), MirRvalue { kind: MirRvalueKind::MirMove(
      MirOperand { kind: MirOperandKind::MirCopy(place_local(mask_local)) }
    ) }, span)
  end
  var gate_targets = Vec::new()
  gate_targets.push(SwitchTarget { value: 0, target: dead_succ })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(gate_tmp), targets: gate_targets, default_target: live_succ }, span)
  gate_blk
end

def emit_plan_deinit(inout b: MirBuilder, place: Place, plan: DeinitPlan, succ: MirBlockId, span: Span, mask_local: Option[MirLocalId]) -> MirBlockId
  match plan
  when DeinitPlan::Trivial then
    succ
  when DeinitPlan::PlanLimit then
    # Fail-fast: a recursive resource type without drop glue cannot be cleaned
    # by a finite expansion. Continuing to build the CFG after reporting the
    # error would construct invalid MIR — stop immediately.
    panic("internal error: recursive resource type cannot be represented by a finite cleanup plan (generated drop glue required)")
  when DeinitPlan::SelfRecursive then
 # FAIL-CLOSED (— the recursion-break marker): a SelfRecursive edge
    # reaching the drop-glue walk means the semantic plan leaked into the
    # walk unrewritten — the MIR's concrete plan construction rewrites the
    # marker into DeinitPlan::Call(glue-instance) (recursion by symbol)
    # before any emission. Reaching this arm is an internal error
    # (mirroring PlanLimit).
    panic("internal error: DeinitPlan::SelfRecursive reached the drop-glue walk (the semantic recursion marker must be rewritten into the concrete glue call)")
  when DeinitPlan::Deferred then
 # FAIL-CLOSED (— the generic ownership policy): a DEFERRED plan
    # reaching the drop-glue walk means an unsubstituted generic-parameter
    # position was scheduled for destruction in a generic template — the
    # template can carry no concrete destructor, and silently skipping would
    # LEAK the substituted resource instantiation. The concrete drop glue
    # after substitution is the only legal destruction path; reaching this
    # arm is an internal error (mirroring PlanLimit).
    panic("internal error: DeinitPlan::Deferred reached the drop-glue walk (an unsubstituted generic position cannot be destroyed in a template — the concrete drop glue after substitution is the only legal path)")
  when DeinitPlan::Box(inner_plan) then
    # Unreachable since the canonical Box plans delegate to the registered
    # Drop impl ("Box__drop" — drop_in_place + dealloc). Reaching this arm
    # is an internal error: fail fast rather than emit partial cleanup.
    panic("internal error: DeinitPlan::Box reached; canonical Box plans delegate to the registered Drop impl")
  when DeinitPlan::Call(instance) then
    match mask_local
    when Option::Some(m) then
 # mask: the called glue is a single child — dropped iff m != 0.
      let mk = create_block(b)
      switch_to_block(b, mk)
      set_terminator(b, MirTerminatorKind::MirDeinit {
        place: place.clone(),
        deinit_fn: instance.clone(),
        target: succ,
        unwind: Option::None
      }, span)
      emit_mask_gate(b, m, 0, mk, succ, span)
    when Option::None then
      let bk = create_block(b)
      switch_to_block(b, bk)
      set_terminator(b, MirTerminatorKind::MirDeinit {
        place: place.clone(),
        deinit_fn: instance.clone(),
        target: succ,
        unwind: Option::None
      }, span)
      bk
    end
  when DeinitPlan::String then
 # (real String lifetime): the OWNED String destructor — the drop
    # releases the OBJECT and its data buffer through the real-heap
    # deallocator (_tg_string_drop; the runtime emits it, the identity is
    # the synthetic mir_string_drop_instance registered in drop_glue_fns —
    # the same identity authority every MirDeinit uses).
 # mask: the String is a single child — dropped iff m != 0.
    let sd_inst = mir_string_drop_instance(b)
    match mask_local
    when Option::Some(m) then
      let sk = create_block(b)
      switch_to_block(b, sk)
      set_terminator(b, MirTerminatorKind::MirDeinit {
        place: place.clone(),
        deinit_fn: sd_inst,
        target: succ,
        unwind: Option::None
      }, span)
      emit_mask_gate(b, m, 0, sk, succ, span)
    when Option::None then
      let bk2 = create_block(b)
      switch_to_block(b, bk2)
      set_terminator(b, MirTerminatorKind::MirDeinit {
        place: place.clone(),
        deinit_fn: sd_inst,
        target: succ,
        unwind: Option::None
      }, span)
      bk2
    end
  when DeinitPlan::UserFinalizer(instance, fields_plan) then
    # Exactly-once rule: the user finalizer runs FIRST, then the
    # compiler-owned structural field cleanup. Build the chain backward so
    # the call executes before the fields: the call's deinit targets the
    # fields chain, which flows into succ.
 # (final layer): the UserFinalizer's payload is the same SEMANTIC
    # InstanceId as Call — the registered finalizer identity; the MirDeinit
    # below carries it directly (no name re-verification needed — the
    # identity was verified at plan construction).
 # mask: the finalizer is a single child (dropped iff m != 0); the
    # fields walk receives the SAME mask so its per-field bits select the
    # initialized fields.
    let fields_entry = emit_plan_deinit(b, place, fields_plan, succ, span, mask_local)
    let call_entry = emit_plan_deinit(b, place, &DeinitPlan::Call(instance.clone()), fields_entry, span, Option::None)
    match mask_local
    when Option::Some(m) then emit_mask_gate(b, m, 0, call_entry, succ, span)
    when Option::None then call_entry
    end
  when DeinitPlan::Tuple(field_plans) then
 # Tuples have no FieldId — the positional TupleIndex form. The
    # chain is built backward so the fields execute in DECLARATION ORDER
    # (the normative order: element 0 first).
 # mask: element i is walked iff bit i of the mask is set; a gated
    # element's own walk is unconditional (the flat-mask contract).
    match mask_local
    when Option::Some(m) then
      var s = succ
      var fi = field_plans.len()
      while fi > 0 do
        fi = fi - 1
        let t_walk = create_block(b)
        switch_to_block(b, t_walk)
        var projs = place.projections.clone()
        projs.push(Projection::TupleIndex(fi))
        let field_place = Place { local: place.local, projections: projs }
        let t_walk_entry = emit_plan_deinit(b, &field_place, &field_plans[fi], s, span, Option::None)
        switch_to_block(b, t_walk)
        set_terminator(b, MirTerminatorKind::MirGoto(t_walk_entry), span)
        s = emit_mask_gate(b, m, 1 << fi, t_walk, s, span)
      end
      s
    when Option::None then
      var s = succ
      var fi = field_plans.len()
      while fi > 0 do
        fi = fi - 1
        var projs = place.projections.clone()
        projs.push(Projection::TupleIndex(fi))
        let field_place = Place { local: place.local, projections: projs }
        s = emit_plan_deinit(b, &field_place, &field_plans[fi], s, span, Option::None)
      end
      s
    end
  when DeinitPlan::Aggregate(field_plans) then
    # Nominal aggregate WITHOUT an explicit deinit (viral containment):
    # each field is deinitialized by its own plan, via the TYPED field
    # identity — Field(FieldId) with the aggregate's TypeId at the
    # projection point and the field's index (the lowering knows the
    # aggregate: the place's existing chain resolves to it).
 # mask: field i is walked iff bit i of the mask is set; a gated
    # field's own walk is unconditional (the flat-mask contract).
    match mask_local
    when Option::Some(m) then
      var s2 = succ
      var fi2 = field_plans.len()
      while fi2 > 0 do
        fi2 = fi2 - 1
        let a_walk = create_block(b)
        switch_to_block(b, a_walk)
        var projs2 = place.projections.clone()
        projs2.push(Projection::Field(mir_synth_field(b, &place, fi2, "aggregate deinit")))
        let field_place2 = Place { local: place.local, projections: projs2 }
        let a_walk_entry = emit_plan_deinit(b, &field_place2, &field_plans[fi2], s2, span, Option::None)
        switch_to_block(b, a_walk)
        set_terminator(b, MirTerminatorKind::MirGoto(a_walk_entry), span)
        s2 = emit_mask_gate(b, m, 1 << fi2, a_walk, s2, span)
      end
      s2
    when Option::None then
      var s2 = succ
      var fi2 = field_plans.len()
      while fi2 > 0 do
        fi2 = fi2 - 1
        var projs2 = place.projections.clone()
        projs2.push(Projection::Field(mir_synth_field(b, &place, fi2, "aggregate deinit")))
        let field_place2 = Place { local: place.local, projections: projs2 }
        s2 = emit_plan_deinit(b, &field_place2, &field_plans[fi2], s2, span, Option::None)
      end
      s2
    end
  when DeinitPlan::Array(elem_plan) then
 # mask: the heap vector (or fixed array) is a single child — the
    # whole collection is walked iff m != 0 (the mask's per-element bits
    # are not part of the bounded lattice; element consumption is
    # whole-value).
    let arr_place_ty = mir_place_type(&place, b)
    let arr_walk = match arr_place_ty
    when Type::FixedArray(_, n) then
      var s3 = succ
      var fi3 = n
      while fi3 > 0 do
        fi3 = fi3 - 1
        var fixed_projs = place.projections.clone()
        fixed_projs.push(Projection::ProjConstantIndex(fi3))
        let fixed_elem_place = Place { local: place.local, projections: fixed_projs }
        s3 = emit_plan_deinit(b, &fixed_elem_place, elem_plan, s3, span, Option::None)
      end
      s3
    when _ then
    # Runtime-length loop in ELEMENT ORDER (the normative order: index 0
    # first, then 1,... n-1): idx = 0.. len-1, deinit elem[idx] each
    # iteration, then release the mmap'ed backing buffer.
    let idx_local = add_local(b, "deinit_idx", Type::Int, false, span)
    let len_tmp = add_temp(b, Type::Int, span)
 # drop glue over a statically-known heap Array. MirLen's offset
    # semantics are representation-dependent; codegen's MirLen emitter
    # (emit_len_ref_derefs + heap-collection header deref) holds that knowledge.
    push_assign(b, place_local(len_tmp), MirRvalue { kind: MirRvalueKind::MirLen(place.clone()) }, span)
    push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int, instance: Option::None })
    }) }, span)
    let header_blk = create_block(b)
    let exit_blk = create_block(b)
    let body_blk = create_block(b)
    switch_to_block(b, header_blk)
    let cmp_tmp = add_temp(b, Type::Bool, span)
    push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::Lt,
      operand_copy_local(idx_local),
      operand_copy_local(len_tmp)
    ) }, span)
    var targets = Vec::new()
    targets.push(SwitchTarget { value: 0, target: exit_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: targets, default_target: body_blk }, span)
    # body block: increment idx (element order), deinit elem[idx], chain
    # flows back to the header.
    switch_to_block(b, body_blk)
    let inc_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(inc_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::Add,
      operand_copy_local(idx_local),
      operand_int(1)
    ) }, span)
    push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirCopy(place_local(inc_tmp))
    }) }, span)
    var projs2 = place.projections.clone()
    projs2.push(Projection::ProjIndex(idx_local))
    let elem_place = Place { local: place.local, projections: projs2 }
    let chain_entry = emit_plan_deinit(b, &elem_place, elem_plan, header_blk, span, Option::None)
    switch_to_block(b, body_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(chain_entry), span)
    # exit block: after the element loop, release the mmap'ed backing
    # buffer (array_destroy); elements were already finalized.
    switch_to_block(b, exit_blk)
    let ad_callee = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem("__intrinsic_array_destroy".to_string()),
        ty: Type::Unit,
        instance: Option::None
      })
    }
    let ad_ret = add_temp(b, Type::Unit, span)
    let ad_succ_blk = create_block(b)
    var ad_args = Vec::new()
    ad_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place.clone()) }) })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(ad_ret),
      func: ad_callee,
      args: ad_args,
      success: ad_succ_blk,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    switch_to_block(b, ad_succ_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(succ), span)
    # entry: goto header
    let entry_blk = create_block(b)
    switch_to_block(b, entry_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(header_blk), span)
    entry_blk
    end
    match mask_local
    when Option::Some(m) then
      let arr_gate = emit_mask_gate(b, m, 0, arr_walk, succ, span)
      arr_gate
    when Option::None then arr_walk
    end
  when DeinitPlan::Set(elem_plan) then
    # DESTRUCTIVE drain cleanup: repeatedly call set_drain_one(s), which
    # destructively transfers the ACTUAL element out of the set (no shared
    # snapshot copy), then deinit the element. The loop terminates when the
    # drain returns None.
    let set_ty = builder_local_typed_ty(b, &place.local)
    let elem_ty = match set_ty
    when Option::Some(st) then
      match st
      when Type::Adt(tid, args) then
 # Adt form of Set/Array mirrors the canonical arms (element
        # via the Adt args).
        let drain_named = match b.typed_type_names.get(tid.id)
        when Option::Some(n) then mir_bare_type_name(&n)
        when Option::None then ""
        end
        if (drain_named == "Set" || drain_named == "Array") && args.len() >= 1 then
          args[0].clone()
        else
          Type::Unit
        end
      when _ then Type::Unit
      end
    when Option::None then Type::Unit
    end
    let sd_callee = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem("__intrinsic_set_drain_one".to_string()),
        ty: Type::Unit,
        instance: Option::None
      })
    }
    let sd_ret = add_temp(b, Type::Adt(TypeId { id: b.lang_items.option }, Vec::from([elem_ty.clone()])), span)
    let sd_call_blk = create_block(b)
    let sd_disc_blk = create_block(b)
    let sd_some_blk = create_block(b)
    let sd_none_blk = create_block(b)
    switch_to_block(b, sd_call_blk)
    var sd_args = Vec::new()
    sd_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place.clone()) }) })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(sd_ret),
      func: sd_callee,
      args: sd_args,
      success: sd_disc_blk,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    switch_to_block(b, sd_disc_blk)
    let sd_disc = add_temp(b, Type::Int, span)
    push_assign(b, place_local(sd_disc), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(sd_ret)) }, span)
    var sd_targets = Vec::new()
    sd_targets.push(SwitchTarget { value: 0, target: sd_some_blk })
    sd_targets.push(SwitchTarget { value: 1, target: sd_none_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(sd_disc), targets: sd_targets, default_target: sd_none_blk }, span)
    switch_to_block(b, sd_none_blk)
    # After all elements drained and finalized, release the set's backing
    # storage (set_destroy — a set is a map with Unit values).
    let sdd_callee = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem("__intrinsic_set_destroy".to_string()),
        ty: Type::Unit,
        instance: Option::None
      })
    }
    let sdd_ret = add_temp(b, Type::Unit, span)
    let sdd_succ_blk = create_block(b)
    var sdd_args = Vec::new()
    sdd_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place.clone()) }) })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(sdd_ret),
      func: sdd_callee,
      args: sdd_args,
      success: sdd_succ_blk,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    switch_to_block(b, sdd_succ_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(succ), span)
    switch_to_block(b, sd_some_blk)
    var sd_projs = place_local(sd_ret).projections.clone()
    sd_projs.push(Projection::Variant(mir_synth_variant(b, &place_local(sd_ret), "Some", "set-drain deinit")))
    let sd_elem_place = Place { local: sd_ret, projections: sd_projs }
    let sd_chain = emit_plan_deinit(b, &sd_elem_place, elem_plan, sd_call_blk, span, Option::None)
    switch_to_block(b, sd_some_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(sd_chain), span)
    let sd_entry = create_block(b)
    switch_to_block(b, sd_entry)
    set_terminator(b, MirTerminatorKind::MirGoto(sd_call_blk), span)
 # mask: the set is a single child — walked iff m != 0.
    match mask_local
    when Option::Some(m) then
      let sd_gate = emit_mask_gate(b, m, 0, sd_entry, succ, span)
      sd_gate
    when Option::None then sd_entry
    end
  when DeinitPlan::Map(key_plan, value_plan) then
    # DESTRUCTIVE drain cleanup: repeatedly call map_drain_one(m), which
    # destructively transfers the ACTUAL (K, V) entry out of the map (no
    # snapshot copy exists — ownership of the real key and value pointers
    # transfers), then deinit the value and the key. The loop terminates
    # when the drain returns None.
    let map_ty = builder_local_typed_ty(b, &place.local)
    let map_kv = match map_ty
    when Option::Some(mt) then
      match mt
      when Type::Adt(tid, args) then
 # Adt form of Map mirrors the canonical Map arm (key / value
        # via the Adt args).
        let drain_named = match b.typed_type_names.get(tid.id)
        when Option::Some(n) then mir_bare_type_name(&n)
        when Option::None then ""
        end
        if drain_named == "Map" && args.len() >= 2 then
          Option::Some((args[0].clone(), args[1].clone()))
        else
          Option::None
        end
      when _ then Option::None
      end
    when Option::None then Option::None
    end
    let key_ty = match map_kv
    when Option::Some((kk, _)) then kk
    when Option::None then Type::Unit
    end
    let val_ty = match map_kv
    when Option::Some((_, vv)) then vv
    when Option::None then Type::Unit
    end
    let dr_callee = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem("__intrinsic_map_drain_one".to_string()),
        ty: Type::Unit,
        instance: Option::None
      })
    }
    let dr_ret = add_temp(b, Type::Adt(TypeId { id: b.lang_items.option }, Vec::from([Type::Tuple(vec![key_ty.clone(), val_ty.clone()])])), span)
    let dr_call_blk = create_block(b)
    let dr_disc_blk = create_block(b)
    let dr_some_blk = create_block(b)
    let dr_none_blk = create_block(b)
    switch_to_block(b, dr_call_blk)
    var dr_args = Vec::new()
    dr_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place.clone()) }) })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(dr_ret),
      func: dr_callee,
      args: dr_args,
      success: dr_disc_blk,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    switch_to_block(b, dr_disc_blk)
    let dr_disc = add_temp(b, Type::Int, span)
    push_assign(b, place_local(dr_disc), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(dr_ret)) }, span)
    var dr_targets = Vec::new()
    dr_targets.push(SwitchTarget { value: 0, target: dr_some_blk })
    dr_targets.push(SwitchTarget { value: 1, target: dr_none_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(dr_disc), targets: dr_targets, default_target: dr_none_blk }, span)
    switch_to_block(b, dr_none_blk)
    # After all entries drained and finalized, release the bucket table and
    # every overflow bucket (map_destroy).
    let md_callee = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem("__intrinsic_map_destroy".to_string()),
        ty: Type::Unit,
        instance: Option::None
      })
    }
    let md_ret = add_temp(b, Type::Unit, span)
    let md_succ_blk = create_block(b)
    var md_args = Vec::new()
    md_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place.clone()) }) })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(md_ret),
      func: md_callee,
      args: md_args,
      success: md_succ_blk,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    switch_to_block(b, md_succ_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(succ), span)
    switch_to_block(b, dr_some_blk)
    let dr_some_vid = mir_synth_variant(b, &place_local(dr_ret), "Some", "map-drain deinit")
    var v_projs = place_local(dr_ret).projections.clone()
    v_projs.push(Projection::Variant(dr_some_vid))
    v_projs.push(Projection::TupleIndex(1))
    let v_place = Place { local: dr_ret, projections: v_projs }
    var k_projs = place_local(dr_ret).projections.clone()
    k_projs.push(Projection::Variant(dr_some_vid))
    k_projs.push(Projection::TupleIndex(0))
    let k_place = Place { local: dr_ret, projections: k_projs }
    let after_v = emit_plan_deinit(b, &v_place, value_plan, dr_call_blk, span, Option::None)
    let after_k = emit_plan_deinit(b, &k_place, key_plan, after_v, span, Option::None)
    switch_to_block(b, dr_some_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(after_k), span)
    let dr_entry = create_block(b)
    switch_to_block(b, dr_entry)
    set_terminator(b, MirTerminatorKind::MirGoto(dr_call_blk), span)
 # mask: the map is a single child — walked iff m != 0.
    match mask_local
    when Option::Some(m) then
      let dr_gate = emit_mask_gate(b, m, 0, dr_entry, succ, span)
      dr_gate
    when Option::None then dr_entry
    end
  when DeinitPlan::Option(inner_plan) then
    # Deinit the payload only when the variant is Some: discriminant block
    # switches to skip_blk (None) or body_blk (Some payload deinit).
 # mask: the Option is a single child — walked iff m != 0.
    let disc_blk = create_block(b)
    let body_blk = create_block(b)
    let skip_blk = create_block(b)
    switch_to_block(b, disc_blk)
    let disc_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(disc_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place.clone()) }, span)
    # Option discriminants: Some = 0, None = 1. Some routes to the payload
    # deinit; None routes to the skip block.
    var targets_o = Vec::new()
    targets_o.push(SwitchTarget { value: 0, target: body_blk })
    targets_o.push(SwitchTarget { value: 1, target: skip_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp), targets: targets_o, default_target: skip_blk }, span)
    switch_to_block(b, skip_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(succ), span)
    switch_to_block(b, body_blk)
    var payload_projs = place.projections.clone()
    payload_projs.push(Projection::Variant(mir_synth_variant(b, &place, "Some", "Option deinit")))
    let payload_place = Place { local: place.local, projections: payload_projs }
    let chain_entry_o = emit_plan_deinit(b, &payload_place, inner_plan, succ, span, Option::None)
    switch_to_block(b, body_blk)
    set_terminator(b, MirTerminatorKind::MirGoto(chain_entry_o), span)
    let entry_o = create_block(b)
    switch_to_block(b, entry_o)
    set_terminator(b, MirTerminatorKind::MirGoto(disc_blk), span)
    match mask_local
    when Option::Some(m) then
      let o_gate = emit_mask_gate(b, m, 0, entry_o, succ, span)
      o_gate
    when Option::None then entry_o
    end
  when DeinitPlan::Result(ok_plan, err_plan) then
    # Deinit the payload of whichever variant is present.
 # mask: the Result is a single child — walked iff m != 0.
    let disc_blk2 = create_block(b)
    let body_blk2 = create_block(b)
    let skip_blk2 = create_block(b)
    switch_to_block(b, disc_blk2)
    let disc_tmp2 = add_temp(b, Type::Int, span)
    push_assign(b, place_local(disc_tmp2), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place.clone()) }, span)
    # Result discriminants: Ok = 0, Err = 1. Ok routes to the Ok payload
    # deinit; Err routes to the Err payload deinit.
    var targets_r = Vec::new()
    targets_r.push(SwitchTarget { value: 0, target: body_blk2 })
    targets_r.push(SwitchTarget { value: 1, target: skip_blk2 })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp2), targets: targets_r, default_target: skip_blk2 }, span)
    # Ok variant (default) deinits the Ok payload; the Err variant (tag 1)
    # deinits the Err payload — both plans are honored.
    switch_to_block(b, skip_blk2)
    var err_projs = place.projections.clone()
    err_projs.push(Projection::Variant(mir_synth_variant(b, &place, "Err", "Result deinit")))
    let err_place = Place { local: place.local, projections: err_projs }
    let chain_entry_e = emit_plan_deinit(b, &err_place, err_plan, succ, span, Option::None)
    switch_to_block(b, skip_blk2)
    set_terminator(b, MirTerminatorKind::MirGoto(chain_entry_e), span)
    switch_to_block(b, body_blk2)
    var payload_projs2 = place.projections.clone()
    payload_projs2.push(Projection::Variant(mir_synth_variant(b, &place, "Ok", "Result deinit")))
    let payload_place2 = Place { local: place.local, projections: payload_projs2 }
    let chain_entry_r = emit_plan_deinit(b, &payload_place2, ok_plan, succ, span, Option::None)
    switch_to_block(b, body_blk2)
    set_terminator(b, MirTerminatorKind::MirGoto(chain_entry_r), span)
    let entry_r = create_block(b)
    switch_to_block(b, entry_r)
    set_terminator(b, MirTerminatorKind::MirGoto(disc_blk2), span)
    match mask_local
    when Option::Some(m) then
      let r_gate = emit_mask_gate(b, m, 0, entry_r, succ, span)
      r_gate
    when Option::None then entry_r
    end
  when DeinitPlan::Enum(variant_plans) then
    # Arbitrary resource-containing enums: switch on the discriminant and
    # deinit the active variant's payload fields by their plans. Each variant
    # is routed to its own chain; the fallthrough (unknown discriminant) is a
    # defensive skip (should not occur for well-typed values).
 # (DeinitPlan::Enum — VariantId): the plan's payload IS the semantic
    # VariantId (owner TypeId + declaration index) — the downcast projection
    # is built DIRECTLY from it (no name-based mir_synth_variant resolution).
    let disc_blk_e = create_block(b)
    let default_blk_e = create_block(b)
    let entry_blk_e = create_block(b)
    switch_to_block(b, disc_blk_e)
    let disc_tmp_e = add_temp(b, Type::Int, span)
    push_assign(b, place_local(disc_tmp_e), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place.clone()) }, span)
    var e_targets = Vec::new()
    # One block per variant: its chain deinits the payload fields, then flows
    # to succ.
 # mask: the ACTIVE variant's payload field j is walked iff bit j of
    # the mask is set (all-ones for the full drop — enum payload extraction
    # is whole-value in the bounded lattice, so partial enum masks never
    # occur in practice).
    var variant_entries = Map::new()
    for (vdisc, vinfo) in variant_plans do
      let vid = vinfo.0
      let vplans = vinfo.1
      var vchain = succ
      var vfi = vplans.len()
      while vfi > 0 do
        vfi = vfi - 1
        var vprojs = place.projections.clone()
        vprojs.push(Projection::Variant(vid))
        vprojs.push(Projection::Field(mir_synth_field(b, &place, vfi, "enum deinit")))
        let vplace = Place { local: place.local, projections: vprojs }
        match mask_local
        when Option::Some(m) then
          let v_walk = create_block(b)
          switch_to_block(b, v_walk)
          let v_walk_entry = emit_plan_deinit(b, &vplace, &vplans[vfi], vchain, span, Option::None)
          switch_to_block(b, v_walk)
          set_terminator(b, MirTerminatorKind::MirGoto(v_walk_entry), span)
          vchain = emit_mask_gate(b, m, 1 << vfi, v_walk, vchain, span)
        when Option::None then
          vchain = emit_plan_deinit(b, &vplace, &vplans[vfi], vchain, span, Option::None)
        end
      end
      variant_entries.insert(vdisc, vchain)
    end
    # Re-walk to emit the per-variant blocks' goto to their chains (the
    # chains were emitted above while current_block is the last chain block).
    for (vdisc2, vinfo2) in variant_plans do
      let vblk = create_block(b)
      switch_to_block(b, vblk)
      match variant_entries.get(vdisc2)
      when Option::Some(vchain2) then
        set_terminator(b, MirTerminatorKind::MirGoto(vchain2), span)
      when Option::None then ()
      end
      e_targets.push(SwitchTarget { value: vdisc2, target: vblk })
    end
    switch_to_block(b, disc_blk_e)
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp_e), targets: e_targets, default_target: default_blk_e }, span)
    switch_to_block(b, default_blk_e)
    set_terminator(b, MirTerminatorKind::MirGoto(succ), span)
    switch_to_block(b, entry_blk_e)
    set_terminator(b, MirTerminatorKind::MirGoto(disc_blk_e), span)
 # mask: the enum is walked iff m != 0 (the payload bits gate the
    # active variant's fields inside).
    match mask_local
    when Option::Some(m) then
      let e_gate = emit_mask_gate(b, m, 0, entry_blk_e, succ, span)
      e_gate
    when Option::None then entry_blk_e
    end
  end
end


def emit_deinit_chain_at(inout b: MirBuilder, block_id: MirBlockId, places: Vec[Place], span: Span) -> Unit
  let saved_block = b.current_block
  b.current_block = Option::Some(block_id)
  let final_blk = create_block(b)
  switch_to_block(b, final_blk)
  set_terminator(b, MirTerminatorKind::MirReturn, span)
 # each place's whole-value destruction is ONE MirDeinit carrying the
  # concrete type's drop-GLUE instance (the generated glue function — an
  # ordinary MirFunction; the plan walk lives inside it, never inline
  # here). The chains are built backward so the drops execute in the
  # checker's order. A DEFERRED type (generic template — the checker
  # delays Param-position ownership decisions, and the CONCRETE drop glue
  # after substitution is the destruction authority; mir_try_glue_instance
  # answers None for the deferred type so the template emits no concrete
  # destructor — the DeinitPlan::Deferred marker fails closed if a deferred
  # position ever reaches the glue walk) or a trivial plan has no glue:
  # nothing is emitted here (a trivial plan is destruction-free).
  var succ = final_blk
  var i = places.len()
  while i > 0 do
    i = i - 1
    let ty = builder_local_typed_ty(b, &places[i].local)
    let glue_inst = match ty
    when Option::Some(t) then mir_try_glue_instance(b, &t)
    when Option::None then Option::None
    end
    match glue_inst
    when Option::Some(inst) then
      let bk = create_block(b)
      switch_to_block(b, bk)
      set_terminator(b, MirTerminatorKind::MirDeinit {
        place: places[i].clone(),
        deinit_fn: inst,
        target: succ,
        unwind: Option::None
      }, span)
      succ = bk
    when Option::None then ()
    end
  end
 # the deferred actions of the exiting scopes (the function body
  # scope at the implicit-return materialization) run before the
  # function-level return-path cleanup — defer code first, then the deinit
  # chain, then the return.
  let exit_scopes = defer_scopes_for_exit(b, false)
  let defer_entry = if scope_has_defers(b, &exit_scopes) then
    emit_defer_chain(b, &exit_scopes, succ, span)
  else
    succ
  end
  # Route the original block to the start of the deferred-call chain.
  switch_to_block(b, block_id)
  set_terminator(b, MirTerminatorKind::MirGoto(defer_entry), span)
  b.current_block = saved_block
end

def block_own_consumed_locals(inout b: MirBuilder, block: MirBlock) -> Set[Int]
  var out: Set[Int] = Set::new()
  match block.terminator.kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    var callee_name = ""
    match func.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirFnItem(name) then callee_name = name.clone()
      when _ then ()
      end
    when _ then ()
    end
    let is_deinit_call = b.finalizer_emission_names.contains(&callee_name)
    var arg_idx = 0
    while arg_idx < args.len() do
      let arg = args[arg_idx]
      let consumes = arg.effect == AccessEffect::Consume || (is_deinit_call && arg_idx == 0)
      if consumes then
        match arg.value
        when MirCallValue::Place(p) then
          if builder_local_is_resource(b, &p.local) then
            out.insert(p.local.id)
          end
        when MirCallValue::Value(op) then
          match op.kind
          when MirOperandKind::MirCopy(p) then
            if builder_local_is_resource(b, &p.local) then
              out.insert(p.local.id)
            end
          when MirOperandKind::MirMovePlace(p) then
            if builder_local_is_resource(b, &p.local) then
              out.insert(p.local.id)
            end
          when MirOperandKind::MirConsume(p) then
            if builder_local_is_resource(b, &p.local) then
              out.insert(p.local.id)
            end
          when _ then ()
          end
        end
      end
      arg_idx = arg_idx + 1
    end
  when _ then ()
  end
  out
end

def compute_definitely_consumed(inout b: MirBuilder, n: Int) -> Map[Int, Set[Int]]
  var block_map: Map[Int, MirBlock] = Map::new()
  var bi = 0
  while bi < n do
    let blk = b.blocks[bi]
    block_map.insert(blk.id.id, blk.clone())
    bi = bi + 1
  end
  var preds: Map[Int, Vec[Int]] = Map::new()
  bi = 0
  while bi < n do
    let blk = b.blocks[bi]
    preds.insert(blk.id.id, Vec::new())
    bi = bi + 1
  end
  bi = 0
  while bi < n do
    let blk = b.blocks[bi]
    let succs = terminator_successor_ids(&blk.terminator)
    var si = 0
    while si < succs.len() do
      let sid = succs[si]
      let existing = match preds.get(sid)
      when Option::Some(list) then list.clone()
      when Option::None then Vec::new()
      end
      existing.push(blk.id.id)
      preds.insert(sid, existing)
      si = si + 1
    end
    bi = bi + 1
  end
  var in_set: Map[Int, Set[Int]] = Map::new()
  var out_set: Map[Int, Set[Int]] = Map::new()
  var worklist = Vec::new()
  worklist.push(0)
  var in_worklist: Set[Int] = Set::new()
  in_worklist.insert(0)
  while !worklist.is_empty() do
    let bid = match worklist.pop()
    when Option::Some(v) then v
    when Option::None then break
    end
    in_worklist.remove(&bid)
    var new_in: Set[Int] = Set::new()
    if bid != 0 then
      let pred_list = match preds.get(bid)
      when Option::Some(l) then l.clone()
      when Option::None then Vec::new()
      end
      var first = true
      var pi = 0
      while pi < pred_list.len() do
        match out_set.get(pred_list[pi])
        when Option::Some(pset) then
          if first then
            new_in = Set::new()
            for v in pset do
              new_in.insert(v.clone())
            end
            first = false
          else
            var keep: Set[Int] = Set::new()
            for v in new_in do
              if pset.contains(v) then
                keep.insert(v.clone())
              end
            end
            new_in = keep
          end
        when Option::None then ()
        end
        pi = pi + 1
      end
    end
    let block = match block_map.get(bid)
    when Option::Some(blk) then blk.clone()
    when Option::None then break
    end
    var out: Set[Int] = Set::new()
    for v in new_in do
      out.insert(v.clone())
    end
    let own = block_own_consumed_locals(b, &block)
    for v in own do
      out.insert(v.clone())
    end
    let old = match in_set.get(bid)
    when Option::Some(s) then s.clone()
    when Option::None then Set::new()
    end
    let had_out = match out_set.get(bid)
    when Option::Some(_) then true
    when Option::None then false
    end
    let changed = !had_out || !verifier_set_equal(&old, &new_in)
    in_set.insert(bid, new_in.clone())
    out_set.insert(bid, out)
    if changed then
      let succs = terminator_successor_ids(&block.terminator)
      var s2 = 0
      while s2 < succs.len() do
        let sid = succs[s2]
        if !in_worklist.contains(&sid) then
          in_worklist.insert(sid)
          worklist.push(sid)
        end
        s2 = s2 + 1
      end
    end
  end
  in_set
end

def emit_cfg_deinit_returns(inout b: MirBuilder) -> Unit
  let n = b.blocks.len()
  if n == 0 then
    return
  end
  let definitely_consumed = compute_definitely_consumed(b, n)
  match b.current_fn
  when Option::Some(f) then
    let fspan = f.span
    var implicit_end: Option[Int] = Option::None
    match b.current_block
    when Option::Some(cur) then
      if cur.id < n then
        let cur_term = b.blocks[cur.id].terminator.clone()
        match cur_term.kind
        when MirTerminatorKind::MirUnreachable then implicit_end = Option::Some(cur.id)
        when _ then ()
        end
      end
    when Option::None then ()
    end
    var return_blocks: Vec[Int] = Vec::new()
    var bi = 0
    while bi < n do
      let blk = b.blocks[bi]
      match blk.terminator.kind
      when MirTerminatorKind::MirReturn then return_blocks.push(bi)
      when _ then ()
      end
      bi = bi + 1
    end
    var ri = 0
    while ri < return_blocks.len() do
      let bid = return_blocks[ri]
      # Return blocks created by return-EDGE cleanup chains already finalized
      # their locals on that edge; the function-level plan must not run again
      # (it would double-deinit sink params).
      if b.return_edge_blocks.contains(&bid) then
        ri = ri + 1
        next
      end
      let ret_span = b.blocks[bid].terminator.span
      let consumed = match definitely_consumed.get(bid)
      when Option::Some(s) then s.clone()
      when Option::None then Set::new()
      end
      let places = deinit_candidates(b, &consumed)
 # the deferred actions of the exiting scopes (the function body
      # scope, pushed by lower_function around this pass) run before this
      # return too — defer code first, then the deinit chain, then the
      # return. Return blocks already carrying a defer chain (created by the
      # return-edge emission when the edge plan was empty) are excluded
      # above via return_edge_blocks, so the defers run exactly once.
      let exit_scopes = defer_scopes_for_exit(b, false)
      if !places.is_empty() then
        emit_deinit_chain_at(b, MirBlockId { id: bid }, &places, ret_span)
      elsif scope_has_defers(b, &exit_scopes) then
        emit_defers_then_return(b, &exit_scopes, MirBlockId { id: bid }, ret_span)
      end
      ri = ri + 1
    end
    match implicit_end
    when Option::Some(block_id) then
      let consumed = match definitely_consumed.get(block_id)
      when Option::Some(s) then s.clone()
      when Option::None then Set::new()
      end
      let places = deinit_candidates(b, &consumed)
      let exit_scopes = defer_scopes_for_exit(b, false)
      if places.is_empty() then
        if scope_has_defers(b, &exit_scopes) then
          emit_defers_then_return(b, &exit_scopes, MirBlockId { id: block_id }, fspan)
        else
          b.blocks[block_id].terminator = MirTerminator {
            kind: MirTerminatorKind::MirReturn,
            span: fspan
          }
        end
      else
        emit_deinit_chain_at(b, MirBlockId { id: block_id }, &places, fspan)
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
end

# Record the semantic id -> MIR id mapping for a pattern-bound local. The
# semantic id comes from the typed pattern_binding_resolutions (pat node id ->
# semantic local id). A missing typed binding for a real pattern local is a
# compiler-internal error (the plan's ids are semantic and must resolve).
def record_semantic_pattern_local(inout b: MirBuilder, pat: Pattern, mir_local: MirLocalId, what: String) -> Unit
  match b.pattern_binding_resolutions.get(pat.node_id)
  when Option::Some(sem_id) then
    b.semantic_to_mir.insert(sem_id, mir_local.id)
  when Option::None then
    b.errors.push("internal error: missing typed pattern binding for " + what + " (pattern node " + pat.node_id.to_string() + ")")
  end
end

def add_local(inout b: MirBuilder, name: String, ty: Type, is_mut: Bool, span: Span) -> MirLocalId
  let id = MirLocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: is_mut,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    f.locals.push(local)
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  b.declared_locals.insert(id.id)
  id
end

def update_local_type(inout b: MirBuilder, local_id: MirLocalId, new_ty: Type) -> Unit
  match b.current_fn
  when Option::Some(f) then
    var updated_locals = Vec::new()
    for local in f.locals do
      if local.id.id == local_id.id then
        updated_locals.push(MirLocal {
          id: MirLocalId { id: local.id.id },
          name: local.name.clone(),
          ty: new_ty.clone(),
          is_mut: local.is_mut,
          span: local.span
        })
      else
        updated_locals.push(local.clone())
      end
    end
    f.locals = updated_locals
  when Option::None then ()
  end
end

def refine_collection_local_type_from_push(inout b: MirBuilder, recv_place: Place, recv_ty: Type, elem_ty: Type) -> Unit
  if !recv_place.projections.is_empty() then
    return
  end

  let refined_ty = match recv_ty
  when Type::Adt(tid, args) then
 # Adt form of Slice/Array mirrors the canonical arms. The Adt
    # form of Array is the heap vector (the named Array[T]); the fixed
    # arrays are the distinct Type::FixedArray variant.
    let push_named = match b.typed_type_names.get(tid.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
    if push_named == "Slice" then
      Option::Some(Type::Adt(TypeId { id: b.lang_items.slice }, Vec::from([elem_ty.clone()])))
    elsif push_named == "Array" then
      Option::Some(Type::Adt(TypeId { id: b.lang_items.array }, Vec::from([elem_ty.clone()])))
    else
      Option::None
    end
  when Type::RefInternal(inner, mutable) then
    match inner
    when Type::Adt(tid, args) then
 # Adt form of Slice/Array inside a reference — same mirror as
      # the outer match.
      let push_inner_named = match b.typed_type_names.get(tid.id)
      when Option::Some(n) then mir_bare_type_name(&n)
      when Option::None then ""
      end
      if push_inner_named == "Slice" then
        Option::Some(Type::RefInternal(Type::Adt(TypeId { id: b.lang_items.slice }, Vec::from([elem_ty.clone()])), mutable))
      elsif push_inner_named == "Array" then
        Option::Some(Type::RefInternal(Type::Adt(TypeId { id: b.lang_items.array }, Vec::from([elem_ty.clone()])), mutable))
      else
        Option::None
      end
    when _ then Option::None
    end
  when _ then Option::None
  end

  match refined_ty
  when Option::Some(ty) then update_local_type(b, recv_place.local, ty)
  when Option::None then ()
  end
end

def merge_assignment_type(b: MirBuilder, current_ty: Type, rhs_ty: Type) -> Type
  match current_ty
  when Type::Adt(tid, cur_args) then
 # Adt form of Option/Result — the canonical arms (are not part of the model in the
 # collapse) were pure duplicates of these twins; the merged type is
    # rebuilt on the CURRENT side's Adt id (the name dispatch below verified
    # it is the builtin).
    let merge_cur_named = match b.typed_type_names.get(tid.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
    if merge_cur_named == "Option" && cur_args.len() >= 1 then
      let current_inner = cur_args[0].clone()
      match rhs_ty
      when Type::Adt(rhs_tid, rhs_args) then
        let merge_rhs_named = match b.typed_type_names.get(rhs_tid.id)
        when Option::Some(n) then mir_bare_type_name(&n)
        when Option::None then ""
        end
        if merge_rhs_named == "Option" && rhs_args.len() >= 1 then
          if current_inner == Type::Unit && rhs_args[0] != Type::Unit then
            Type::Adt(tid.clone(), Vec::from([rhs_args[0].clone()]))
          else
            current_ty.clone()
          end
        else
          current_ty.clone()
        end
      when _ then current_ty.clone()
      end
    elsif merge_cur_named == "Result" && cur_args.len() >= 2 then
      let current_ok = cur_args[0].clone()
      let current_err = cur_args[1].clone()
      match rhs_ty
      when Type::Adt(rhs_tid, rhs_args) then
        let merge_rhs_named = match b.typed_type_names.get(rhs_tid.id)
        when Option::Some(n) then mir_bare_type_name(&n)
        when Option::None then ""
        end
        if merge_rhs_named == "Result" && rhs_args.len() >= 2 then
          let merged_ok = if current_ok == Type::Unit && rhs_args[0] != Type::Unit then rhs_args[0].clone() else current_ok.clone() end
          let merged_err = if current_err == Type::Unit && rhs_args[1] != Type::Unit then rhs_args[1].clone() else current_err.clone() end
          Type::Adt(tid.clone(), Vec::from([merged_ok, merged_err]))
        else
          current_ty.clone()
        end
      when _ then current_ty.clone()
      end
    else
      current_ty.clone()
    end
  when Type::Unit then
    if rhs_ty != Type::Unit then rhs_ty.clone() else current_ty.clone() end
  when _ then current_ty.clone()
  end
end

def refine_assignment_target_type(inout b: MirBuilder, target: Place, rhs_ty: Type) -> Unit
 # the rvalue-shape inference is are not part of the model — the caller already knows
  # the assigned value's type (the typed tree for source nodes, the
  # construction site for synthesized IR) and passes it here.
  refine_assignment_target_type_from_type(b, target, rhs_ty)
end

def refine_assignment_target_type_from_type(inout b: MirBuilder, target: Place, rhs_ty: Type) -> Unit
  if !target.projections.is_empty() then
    return
  end

  let current_ty = lookup_local_type(b, &target.local)
  let merged_ty = merge_assignment_type(b, &current_ty, rhs_ty)
  if merged_ty != current_ty then
    update_local_type(b, target.local, merged_ty)
  end
end

def add_temp(inout b: MirBuilder, ty: Type, span: Span) -> MirLocalId
  let name = "_tmp" + b.temp_counter.to_string()
  b.temp_counter = b.temp_counter + 1
  add_local(b, name, ty, false, span)
end

def create_block(inout b: MirBuilder) -> MirBlockId
  let id = MirBlockId { id: b.block_counter }
  b.block_counter = b.block_counter + 1
  
  # Create an empty block with an Unreachable placeholder terminator
  b.blocks.push(MirBlock {
    id: MirBlockId { id: id.id },
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: span_dummy()
    }
  })
  id
end

def push_stmt(inout b: MirBuilder, kind: MirStatementKind, span: Span) -> Unit
  let stmt = MirStatement { kind: kind, span: span }
  match b.current_block
  when Option::Some(blk_id) then
    if blk_id.id < b.blocks.len() then
      b.blocks[blk_id.id].statements.push(stmt)
    end
  when Option::None then ()
  end
end

def push_assign(inout b: MirBuilder, place: Place, rvalue: MirRvalue, span: Span) -> Unit
  push_stmt(b, MirStatementKind::MirAssign(place, rvalue), span)
end

def set_terminator(inout b: MirBuilder, kind: MirTerminatorKind, span: Span) -> Unit
  match b.current_block
  when Option::Some(blk_id) then
    if blk_id.id < b.blocks.len() then
      b.blocks[blk_id.id].terminator = MirTerminator { kind: kind, span: span }
    end
  when Option::None then ()
  end
end

def block_is_terminated(b: MirBuilder) -> Bool
  match b.current_block
  when Option::Some(blk_id) then
    if blk_id.id < b.blocks.len() then
      let block = b.blocks[blk_id.id]
      match block.terminator.kind
      when MirTerminatorKind::MirUnreachable then false
      when _ then true
      end
    else
      false
    end
  when Option::None then false
  end
end

# The id of the block currently being built (0 when none).
def mir_current_block_id(b: MirBuilder) -> MirBlockId
  match b.current_block
  when Option::Some(blk) then blk.clone()
  when Option::None then MirBlockId { id: 0 }
  end
end

def switch_to_block(inout b: MirBuilder, block: MirBlockId) -> Unit
  b.current_block = Option::Some(block)
end

def finish_function(inout b: MirBuilder) -> Option[MirFunction]
  match b.current_fn
  when Option::Some(f) then
    # Collect all blocks from the map into the function's block list
    var collected_blocks = Vec::new()
    var idx = 0
    while idx < b.blocks.len() do
      let block = b.blocks[idx]
      collected_blocks.push(duplicate_block(block))
      idx = idx + 1
    end
    f.blocks = collected_blocks
    let result = Option::Some(f)
    b.current_fn = Option::None
    b.current_fn_budget = Option::None
    b.current_block = Option::None
    b.blocks = Vec::new()
    result
  when Option::None then
    # Defensive diagnostic: finish_function called without an active function.
    # This indicates a logic error upstream (e.g. double-finish or missing
    # start_function). It is not fatal — None is returned cleanly — but the
    # call site should be investigated if this fires repeatedly.
    eprintln("[lprog] finish_function called but current_fn is None")
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# AST to MIR Lowering
# ———————————————————————————————————————————————————————————————

# (engine snapshot completeness): re-apply the typed program's type-ALIAS
# declarations (TypedProgram.type_aliases — the checker's resolved inner
# types, referencing the checker's GenericParamIds) onto a snapshot TypeEnv
# whose type_list entries for aliases were reconstructed as Opaque
# (engine_snapshot_env, resource_check.tg — it serializes only the
# field/variant tables). The engine's type_named_props / 
# is_named_trivially_copyable then walk the Alias inner exactly like the
# checker's env: an alias of an owning type answers owns_state=true /
# requires_drop_glue=true on both sides of the checker↔MIR seam.
def engine_snapshot_repair_aliases(inout env: TypeEnv, typed: TypedProgram) -> Unit
  for (alias_tid, alias_inner) in typed.type_aliases do
    match env.type_id_index.get(alias_tid)
    when Option::Some(alias_idx) then
      env.type_list[alias_idx].def_kind = TypeDefKind::Alias(alias_inner.clone())
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# (impl-name mangling): the RESOLVED OWNER of an impl's for/self type
# ———————————————————————————————————————————————————————————————
# The impl method EMISSION names ("TypeName__method") are derived from the
# impl's RESOLVED OWNER TypeId — the semantic TypeId the checker registered
# the for/self type under — NOT from the raw TypeExpr syntax. The syntactic
# name is read only as the LOOKUP KEY into the semantic inverse
# (type_name_to_id — built from the checker's type_names); the registered
# name of the resolved TypeId (typed_type_names) is stringified only HERE,
# at the emission-name boundary (with the Array→Vec normalization the
# call-site mangling uses). An impl whose for/self type never registered a
# TypeId (an EXTENSION impl — `impl[T, I: Iterator[T]] I`, whose for_type
# is a generic parameter) keeps the bare syntactic fallback: its methods
# register under the bare mangled names the call-site lowering resolves
# through param_impl_methods.
def mir_impl_owner_type_id(b: MirBuilder, for_type: TypeExpr, self_type: TypeExpr) -> Option[TypeId]
  let raw = match for_type.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when _ then
    match self_type.kind
    when TypeExprKind::Named(name, _) then name.clone()
    when _ then ""
    end
  end
  if raw == "" then
    return Option::None
  end
  match b.type_name_to_id.get(raw)
  when Option::Some(tid) then Option::Some(TypeId { id: tid.id })
  when Option::None then Option::None
  end
end

def mir_impl_owner_type_name(b: MirBuilder, for_type: TypeExpr, self_type: TypeExpr) -> String
  let raw = match for_type.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when _ then
    match self_type.kind
    when TypeExprKind::Named(name, _) then name.clone()
    when _ then ""
    end
  end
  match mir_impl_owner_type_id(b, for_type, self_type)
  when Option::Some(tid) then
    match b.typed_type_names.get(tid.id)
    when Option::Some(reg_name) then
      let bare = mir_bare_type_name(&reg_name)
      if bare == "Array" then "Vec".to_string() else bare end
    when Option::None then
      if raw == "Array" then "Vec".to_string() else raw end
    end
  when Option::None then
    if raw == "Array" then "Vec".to_string() else raw end
  end
end

# Whether the impl's for/self type is a NAME-BEARING type expression — the
# extension-impl registration guard (only a named for/self type can be a
# generic-parameter for_type). The name itself never leaves this boundary.
def mir_impl_has_named_type(b: MirBuilder, for_type: TypeExpr, self_type: TypeExpr) -> Bool
  match for_type.kind
  when TypeExprKind::Named(name, _) then true
  when _ then
    match self_type.kind
    when TypeExprKind::Named(name, _) then true
    when _ then false
    end
  end
end

def lower_program(program: Program, analyzed: AnalyzedProgram) -> Result[MirProgram, String]
  var b = builder_new()
 # (ONE AnalyzedProgram): the semantic analysis artifact reaches this
  # builder WHOLE — the typed iteration records (analyzed.context.
  # typed_iterations), the ONE TypedCFG with its serialized CleanupEdge
  # table (analyzed.cfg — cfg.cleanup[i] is edge i's CleanupEdge; the edge's
  # index IS its CfgEdgeId), the semantic finalize plan (analyzed.
  # finalize_plan), the engine snapshot (analyzed.engine_snapshot), and the
  # typed HIR (analyzed.typed). resource_check is NEVER re-invoked here —
 # the checker's rerun is not part of the model; everything it used to recover
  # (cleanup_edges_serialize's table, the iteration plans, the block frames,
  # the slice-view registry, the access registry) is carried by the
  # artifact.
  b.typed_iterations = analyzed.context.typed_iterations.clone()
  b.access_effects = analyzed.typed.access_effects.clone()
 # (engine consumption): the snapshot TypeEnv built ONCE by the pipeline
  # (compiler_core's analyze_parsed — engine_snapshot_env; the same env the
  # resource checker ran on) — the engine query bridge for the plan
  # generation (deinit_plan_for_type's requires_drop_glue gate and
  # LangItems selection), the Copy verifier's is_trivially_copyable query,
  # and every ownership decision in this builder. The nominal
  # type_kinds snapshot is no longer carried (it is declared-kind display
  # only; ownership never reads it — see the resource_kinds removal note).
  b.engine_env = analyzed.engine_snapshot.clone()
 # (engine snapshot completeness): the snapshot env reconstructs
  # TypeDefKind from the serialized field/variant tables — a type ALIAS
  # (TypeDefKind::Alias — the checker's resolved inner type) has no
  # serialized shape and lands Opaque, which would make the engine answer
  # owns_state=false/requires_drop_glue=false for an alias of an owning
  # type while the checker's own env walks the Alias inner
  # (type_named_props' Alias arm). Re-apply the checker's resolved inner
  # types so the MIR's engine queries (deinit_plan_for_type's
  # type_properties_of gate and the Copy verifier's is_trivially_copyable
  # answer) come from the
  # SAME authority as the checker.
  engine_snapshot_repair_aliases(&mut b.engine_env, &analyzed.typed)
  b.typed_local_bindings = analyzed.typed.local_bindings.clone()
  b.field_targets = analyzed.typed.field_targets.clone()
  b.expr_types = analyzed.typed.expr_types.clone()
  b.typed_exprs = analyzed.typed.typed_exprs.clone()
  # Wire the typed deinit/finalize/call identity data: MIR consumes the
  # semantic plans instead of guessing cleanup or callees from names.
  b.finalize_plan = analyzed.finalize_plan.clone()
 # the CleanupEdge table reaches this builder through the
  # AnalyzedProgram's ONE TypedCFG (analyzed.cfg — the pipeline's pre-built
  # edges/blocks plus the parallel CleanupEdge table, cleanup[i] is edge i's
  # CleanupEdge; the edge's index IS its CfgEdgeId). Every cleanup-lookup
  # site consumes the CleanupEdge ACTIONS directly — the String-keyed
  # serializations (the "edge::..." edge_cleanup map and the
  # "return::<id>"/"break::<id>"/"continue::<id>"/"backedge::<id>"/
 # "block::<id>" finalize_plan keys) are not part of the model; the builder-side defer
  # registrations (defer_scope_defers / defer_stmt_ids_for_scope) remain
  # only as the synthesized/IR-only fallback.
  b.cfg = analyzed.cfg
  b.deinit_plans = analyzed.typed.deinit_plans.clone()
  b.typed_type_names = analyzed.typed.type_names.clone()
  b.typed_type_variants = analyzed.typed.type_variants.clone()
  b.call_def_ids = analyzed.typed.call_targets.clone()
  b.call_instances = analyzed.typed.call_instances.clone()
 # (IntrinsicId through MirCall): the checker's per-call semantic
  # classification (typed_intrinsics) — the stamping source for the SOURCE
  # MirCall sites (lr_call / lr_static_path_call / the method-call arm).
  b.typed_intrinsics = analyzed.typed.typed_intrinsics.clone()
  b.ident_resolutions = analyzed.typed.ident_resolutions.clone()
  b.item_defs = analyzed.typed.resolutions.item_defs.clone()
  b.closure_captures = analyzed.typed.closure_captures.clone()
  b.pattern_binding_resolutions = analyzed.typed.pattern_binding_resolutions.clone()
  b.param_binding_resolutions = analyzed.typed.param_binding_resolutions.clone()
 # the typed program's Program and resolver
  # snapshot — the crate module table (Program.crate.modules) and the
  # def_kinds metadata the DefId renders (fn_owner_key_of_def /
  # def_kind_of) scan. Wired BEFORE any owner-key / emission-name render
  # (the PASS-1 ret-type registration and PASS-2 lowering below).
  b.program = program.clone()
  b.resolutions = analyzed.typed.resolutions.clone()
 # the checker's generic-parameter record — the param-name table
  # snapshot and the per-owner-key id lists the lowered functions
  # reconstruct their Type::Param ids from (the substs-order contract).
  b.generic_param_table = generic_param_table_new()
  b.generic_param_ids = analyzed.typed.generic_param_ids.clone()
  b.generic_param_names = analyzed.typed.generic_param_names.clone()
 # the typed declaration records and the canonical LangItems snapshot —
  # the MIR reads every declaration type from these tables (a missing entry
  # is an internal error, fail-closed) and every builtin Adt id from the
  # LangItems table (the checker's id-indexed env.lang_items serialization).
  b.lang_items = analyzed.typed.lang_items.clone()
  b.typed_fn_signatures = analyzed.typed.typed_fn_signatures.clone()
  b.typed_static_types = analyzed.typed.typed_static_types.clone()
  b.typed_type_fields = analyzed.typed.type_fields.clone()
  b.typed_type_params = analyzed.typed.type_params.clone()
 # (partial moves): the semantic per-place move registry — the frame's
  # per-field states serialized by the checker's pattern-binding sites
  # (types.tg's record_place_moves). The drop sites consult it for the
  # partial-drop masks.
  b.place_move_states = analyzed.typed.place_move_states.clone()
  var functions = Vec::new()
  var statics = Vec::new()
  var types = Vec::new()
  var seen_fns = Set::new()

 # FIX 1: ONE TypeId universe. The type checker's type_names
  # (semantic TypeId -> name) is the ONLY authority. Build the name -> TypeId
  # inverse ONCE here from b.typed_type_names; the old pre-pass minted fresh
  # builder-local ids (b.type_id_counter) that never matched the semantic
  # ids, so MirTypeDef.id and every lowered Type::Adt diverged from the
  # typed program's deinit_plans/type_kinds keys. No id is minted anywhere in
  # this builder anymore — type_id_counter no longer exists on MirBuilder.
  for (sem_tid, sem_name) in b.typed_type_names do
    b.type_name_to_id.insert(sem_name.clone(), sem_tid)
  end

  # Pre-populate enum variant map so lower_expr can resolve ExprKind::AstPath.
  # (No TypeIds are assigned here — struct/enum ids come from the semantic
  # inverse above at lowering time; this pass only records variant shapes.)
 # the loop is INDEXED so each static/const item can derive its
  # resolver DefId (module_qualified_key(owner_path, name) -> module_symbols
  # — the qualified-key identity the resolver registered the DefId under);
  # the static REFERENCES (MirStaticRef / MirStaticAddr) then carry the
  # DefId, never a name.
  var prep_idx = 0
  while prep_idx < program.items.len() do
    let item = program.items[prep_idx]
    match item.kind
    when ItemKind::ItemStruct(_) then
      # Semantic TypeId lookup happens in lower_struct_def via
      # b.type_name_to_id (the typed program's table). Nothing to record here.
      ()
    when ItemKind::ItemEnum(e) then
      var variant_names = Vec::new()
      var has_payload = false
      var disc = 0
      for v in e.variants do
        match v.discriminant
        when Option::Some(expr) then
          match expr.kind
          when ExprKind::ExprIntLit(n) then disc = n
          when ExprKind::ExprUnaryOp(UnOp::Neg, inner) then
            match inner.kind
            when ExprKind::ExprIntLit(n) then disc = 0 - n
            when _ then ()
            end
          when _ then ()
          end
        when Option::None then ()
        end
        variant_names.push(v.name.clone())
        if v.fields.len() > 0 then
          has_payload = true
        end
        b.enum_variant_discriminants.insert(enum_variant_discriminant_key(&e.name, &v.name), disc)
        disc = disc + 1
      end
      b.enum_variants.insert(e.name.clone(), variant_names)
      b.enum_has_payload.insert(e.name.clone(), has_payload)
    when ItemKind::ItemStatic(s) then
      b.static_names.insert(s.name.clone())
      let (prep_path, _prep_module) = module_path_of_item_resolver(program, prep_idx)
      let prep_key = module_qualified_key(&prep_path, &s.name)
 # the static's DECLARED type comes from the typed table (the
      # checker's resolved declaration record — never TypeExpr again); a
      # missing entry is an internal error (fail-closed).
      match b.typed_static_types.get(prep_key.clone())
      when Option::Some(st_ty) then b.static_types.insert(s.name.clone(), st_ty)
      when Option::None then b.errors.push("internal error: missing typed static type for '" + prep_key + "' during MIR lowering")
      end
      match b.resolutions.module_symbols.get(prep_key)
      when Option::Some(sdid) then b.static_def_ids.insert(s.name.clone(), sdid)
      when Option::None then ()
      end
    when ItemKind::ItemConst(c) then
      b.static_names.insert(c.name.clone())
      let (prep_path2, _prep_module2) = module_path_of_item_resolver(program, prep_idx)
      let prep_key2 = module_qualified_key(&prep_path2, &c.name)
 # the const's DECLARED type comes from the typed table (the
      # checker's resolved declaration record — never TypeExpr again); a
      # missing entry is an internal error (fail-closed).
      match b.typed_static_types.get(prep_key2.clone())
      when Option::Some(ct_ty) then b.static_types.insert(c.name.clone(), ct_ty)
      when Option::None then b.errors.push("internal error: missing typed const type for '" + prep_key2 + "' during MIR lowering")
      end
      match b.resolutions.module_symbols.get(prep_key2)
      when Option::Some(cdid) then b.static_def_ids.insert(c.name.clone(), cdid)
      when Option::None then ()
      end
    when _ then ()
    end
    prep_idx = prep_idx + 1
  end

  # Pre-register function return types so call lowering can type local
  # bindings before the target function is lowered.
 # the loop walks items with the SAME module-path walk PASS 2 uses
  # (module_path_of_item_resolver — the containment scan over
  # Program.crate.modules), so each top-level function's DefId-derived
  # EMISSION name (mir_fn_emission_name) is available for the key. A top-level
  # function is registered under BOTH keys:
  #   - the emission name (fn_owner_key_of_def "<module path>::<index>::
  #     <kind>") — the key every lowered call site uses once its MirFnItem
  #     carries the Function-kind instance;
  #   - the source name — the key the remaining NAME-BASED consumers use
  #     (lr_static_path_call / fn-item value references on synthesized
  #     paths and the synthesized-call result typing at the construction
  #     sites), so the registered declared return types stay reachable.
  # The entry function's keys coincide (its emission name IS the source
  # name). Methods ("Type__method"), struct methods, and extern symbols keep
  # their existing single source/mangled keys unchanged.
  #
  # TYPING-ONLY (ZERO-INFERENCE, item 3): these double-keyed fn_ret_types
  # lookups are PURE IR TYPING — they compute the MIR destination local's
  # type for call lowering (the typed-tree read for source nodes; the
  # registered-declared-type read at the synthesized-call construction
  # sites) and never participate in the monomorphizer's decisions: the
  # monomorphizer (mono.tg, re-exported by trait_resolve.tg) reads only
  # the MirFnItem's INSTANCE PAYLOAD and the MIR function signatures.
  # The instance payload is the authority for type arguments; a call whose
  # payload is absent/empty on a generic base fails closed there.
 # (final layer): the checker's finalizer REGISTRATION is the identity
  # source — seed the builder's deinit_targets from the artifact's typed HIR
  # (TypeId -> the resolver DefId of the Drop-impl / deinit method; never a
  # name). The item walk below completes the registration for impls/structs
  # the checker did not record AND builds the identity indexes
  # (method_names_by_def — DefId -> mangled emission name; the reverse of
  # method_def_ids, complete before any function lowering; and
  # finalizer_emission_names — the emission-name index of the registered
  # finalizers, consumed by the consumed-locals dataflow).
  for (reg_tid, reg_callable) in analyzed.typed.deinit_targets do
    b.deinit_targets.insert(reg_tid, reg_callable.clone())
  end
 # the typed FinalizerKind record follows the
  # deinit_targets seeding — the registration walk below reads the KIND
  # from this table (never the source method name).
  b.finalizer_kinds = analyzed.typed.finalizer_kinds.clone()
 # the typed signature lookup — the fn owner key -> the checker's
  # resolved FnSignature record. A declaration missing from the typed table
  # is an internal error (fail-closed); the returned Unit-bearing record is
  # only the defensive value after the ICE is recorded (lowering aborts at
  # the error drain).
  def mir_typed_signature_of(inout b: MirBuilder, owner_key: String, what: String) -> FnSignature
    match b.typed_fn_signatures.get(owner_key.clone())
    when Option::Some(sig) then sig.clone()
    when Option::None then
      b.errors.push("internal error: missing typed signature for " + what + " (key '" + owner_key + "') during MIR lowering")
      FnSignature { params: Vec::new(), ret_type: Type::Unit }
    end
  end

 # the DECLARED parameter types of a function/impl/extern
  # declaration — the BASE types read from the typed signature record (the
  # checker's resolved ParamTypes; never TypeExpr again), wrapped with the
  # same convention as the function lowering (Inout params become
  # RefInternal; the `&` Ref spelling is a parse-time conversion to
  # AccessConvention::Let — the Let convention carries the by-value shape).
  # Consumed by the owned-String demand rule in lower_call_arg (a by-value
  # String param demands the owned conversion of a literal argument).
  def mir_signature_param_types(inout b: MirBuilder, what: String, sig: FnSignature, params: Vec[Param]) -> Vec[Type]
    var tys = Vec::new()
    var pi = 0
    while pi < params.len() do
      let base_ty = if pi < sig.params.len() then sig.params[pi].ty.clone() else
        b.errors.push("internal error: typed signature of " + what + " has fewer parameters than its declaration during MIR lowering")
        Type::Unit
      end
      let convention = if pi < sig.params.len() then sig.params[pi].convention else params[pi].convention end
      var ty = base_ty.clone()
      if convention == AccessConvention::Inout then
        ty = Type::RefInternal(base_ty.clone(), true)
      end
      tys.push(ty)
      pi = pi + 1
    end
    tys
  end

  var ret_idx = 0
  while ret_idx < program.items.len() do
    let (ret_owner_path, _ret_module) = module_path_of_item_resolver(program, ret_idx)
    let item = program.items[ret_idx]
    match item.kind
    when ItemKind::ItemFunction(f) then
 # the declared return/parameter types come from the typed
      # signature record (fn owner key — the same key the checker recorded
      # under in check_function).
      let fn_sig = mir_typed_signature_of(&mut b, mir_item_owner_key(&b, ret_idx, 0), "function '" + f.name + "'")
      let ret_type = fn_sig.ret_type.clone()
      let emission_name = mir_fn_emission_name(&b, ret_idx, &ret_owner_path, f.name.clone())
      b.fn_ret_types.insert(emission_name, ret_type.clone())
      b.fn_ret_types.insert(f.name.clone(), ret_type)
      let f_param_tys = mir_signature_param_types(&mut b, "function '" + f.name + "'", &fn_sig, &f.params)
      b.fn_param_types.insert(emission_name, f_param_tys.clone())
      b.fn_param_types.insert(f.name.clone(), f_param_tys)
    when ItemKind::ItemImpl(impl_decl) then
 # (impl-name mangling): the mangled method emission names derive
      # from the RESOLVED OWNER TypeId's REGISTERED name (typed_type_names
      # — the checker's semantic table), never from the raw TypeExpr syntax.
      # The syntactic name is only the lookup key into the semantic inverse
      # (type_name_to_id); the Array→Vec normalization mirrors the call-site
      # mangling. Stringification happens ONLY here, at the emission-name
      # boundary.
      let impl_type_name = mir_impl_owner_type_name(&b, &impl_decl.for_type, &impl_decl.self_type)
      let impl_dids = match b.item_defs.get(ret_idx)
      when Option::Some(dids) then dids.clone()
      when Option::None then Vec::new()
      end
      var method_idx = 0
      while method_idx < impl_decl.methods.len() do
        let method = impl_decl.methods[method_idx]
 # the method's declared return/parameter types come from the
        # typed signature record (method owner key — the same key the
        # checker recorded under in check_impl).
        let m_sig = mir_typed_signature_of(&mut b, mir_item_owner_key(&b, ret_idx, method_idx), "method '" + method.name + "' of the impl for '" + impl_type_name + "'")
        let ret_type = m_sig.ret_type.clone()
        let mangled_name = if impl_type_name != "" then
          impl_type_name.clone() + "__" + method.name.clone()
        else
          method.name.clone()
        end
        b.fn_ret_types.insert(mangled_name.clone(), ret_type)
        b.fn_param_types.insert(mangled_name.clone(), mir_signature_param_types(&mut b, "method '" + method.name + "' of the impl for '" + impl_type_name + "'", &m_sig, &method.params))
        let method_did = if method_idx < impl_dids.len() then
          Option::Some(impl_dids[method_idx].clone())
        else
          Option::None
        end
 # (final layer): mirror types.tg's registration EXACTLY — a
        # finalizer is recognized by the CHECKER's TYPED FinalizerKind
        # record (b.finalizer_kinds — TypeId -> kind, seeded from
        # analyzed.typed.finalizer_kinds), never by the source method name
        # and never by the trait-name string (the former
        # impl_decl.trait_name == "Drop" check is gone: the checker's
        # Drop-trait-impl classification — the LangItems drop_trait
        # identity — is the only authority). The registered value is the
        # method's RESOLVER DefId (item_defs carries the impl's method
        # DefIds in declaration order — the same identity the checker's
        # registration and the call-site instances use); the mangled
        # "Box__drop" name is only the emission boundary (indexed by
        # method_names_by_def). A method the checker never registered as a
        # finalizer is an ORDINARY method here (fail-closed: an
        # unregistered finalizer can never become a plan callable).
        match mir_impl_owner_type_id(&b, &impl_decl.for_type, &impl_decl.self_type)
        when Option::Some(tid) then
          let fk = match b.finalizer_kinds.get(tid.id)
          when Option::Some(k) then k
          when Option::None then FinalizerKind::NotFinalizer
          end
 # the kind is recorded per TYPE (one registered finalizer per
          # type — the checker's deinit_targets record); the per-METHOD
          # decision is the IDENTITY match — the method whose DefId IS the
          # type's registered finalizer. A sibling method (a helper in the
          # same impl/struct) is an ordinary method even though the type
          # carries a finalizer kind.
          var is_the_finalizer = false
          if fk != FinalizerKind::NotFinalizer then
            match method_did
            when Option::Some(mdid) then
              match b.deinit_targets.get(tid.id)
              when Option::Some(reg_callable) then
                if reg_callable.def.module.id == mdid.module.id && reg_callable.def.index == mdid.index then
                  is_the_finalizer = true
                end
              when Option::None then ()
              end
            when Option::None then ()
            end
          end
          if is_the_finalizer then
            match method_did
            when Option::Some(mdid) then
              let fcallable = CallableId { def: mdid.clone() }
 # (impl-name mangling): the finalizer REGISTRATION keys by
              # the RESOLVED OWNER TypeId of the impl's for/self type (the
              # semantic identity — the same tid the checker's
              # deinit_targets keys by), never by a name-derived lookup.
              b.deinit_targets.insert(tid, fcallable.clone())
              b.method_names_by_def.insert(def_id_numeric(&mdid), mangled_name.clone())
              b.finalizer_emission_names.insert(mangled_name.clone())
            when Option::None then ()
            end
          else
            match method_did
            when Option::Some(mdid2) then b.method_names_by_def.insert(def_id_numeric(&mdid2), mangled_name.clone())
            when Option::None then ()
            end
          end
        when Option::None then
          match method_did
          when Option::Some(mdid3) then b.method_names_by_def.insert(def_id_numeric(&mdid3), mangled_name.clone())
          when Option::None then ()
          end
        end
        method_idx = method_idx + 1
      end
    when ItemKind::ItemStruct(s) then
      let struct_dids = match b.item_defs.get(ret_idx)
      when Option::Some(dids) then dids.clone()
      when Option::None then Vec::new()
      end
      var sm_idx = 0
      while sm_idx < s.methods.len() do
        let method = s.methods[sm_idx]
 # the method's declared return/parameter types come from the
        # typed signature record (method owner key — the same key the
        # checker recorded under in check_impl's struct-method arm).
        let sm_sig = mir_typed_signature_of(&mut b, mir_item_owner_key(&b, ret_idx, sm_idx), "method '" + method.name + "' of struct '" + s.name + "'")
        let ret_type = sm_sig.ret_type.clone()
        let mangled_name = s.name.clone() + "__" + method.name.clone()
        b.fn_ret_types.insert(mangled_name.clone(), ret_type)
        b.fn_param_types.insert(mangled_name.clone(), mir_signature_param_types(&mut b, "method '" + method.name + "' of struct '" + s.name + "'", &sm_sig, &method.params))
        let sm_did = if sm_idx < struct_dids.len() then
          Option::Some(struct_dids[sm_idx].clone())
        else
          Option::None
        end
 # (— the typed FinalizerKind): the struct
        # method registration recognizes the inherent `deinit` by the
        # CHECKER's TYPED kind record (b.finalizer_kinds — TypeId -> kind)
        # PLUS the per-method IDENTITY match (the method whose DefId IS the
        # type's registered finalizer — a sibling helper method is ordinary;
        # never the source method name).
        match b.type_name_to_id.get(s.name.clone())
        when Option::Some(tid) then
          let sfk = match b.finalizer_kinds.get(tid.id)
          when Option::Some(k) then k
          when Option::None then FinalizerKind::NotFinalizer
          end
          var sm_is_finalizer = false
          if sfk != FinalizerKind::NotFinalizer then
            match sm_did
            when Option::Some(smdid) then
              match b.deinit_targets.get(tid.id)
              when Option::Some(sreg_callable) then
                if sreg_callable.def.module.id == smdid.module.id && sreg_callable.def.index == smdid.index then
                  sm_is_finalizer = true
                end
              when Option::None then ()
              end
            when Option::None then ()
            end
          end
          if sm_is_finalizer then
            match sm_did
            when Option::Some(smdid) then
              let scallable = CallableId { def: smdid.clone() }
              b.deinit_targets.insert(tid, scallable.clone())
              b.method_names_by_def.insert(def_id_numeric(&smdid), mangled_name.clone())
              b.finalizer_emission_names.insert(mangled_name.clone())
            when Option::None then ()
            end
          else
            match sm_did
            when Option::Some(smdid2) then b.method_names_by_def.insert(def_id_numeric(&smdid2), mangled_name.clone())
            when Option::None then ()
            end
          end
        when Option::None then
          match sm_did
          when Option::Some(smdid3) then b.method_names_by_def.insert(def_id_numeric(&smdid3), mangled_name.clone())
          when Option::None then ()
          end
        end
        sm_idx = sm_idx + 1
      end
    when ItemKind::ItemExternBlock(ext) then
      for ext_item in ext.items do
        match ext_item
        when ExternItem::Function(ef) then
 # the extern's declared return/parameter types come from the
          # typed signature record (the module-qualified fn key — the same
          # key the checker recorded externs under in pass 3; extern blocks
          # record no item_defs, so the DefId render is unreachable on both
          # sides).
          let ext_sig = mir_typed_signature_of(&mut b, module_qualified_fn_key(&ret_owner_path, ef.name.clone()), "extern function '" + ef.name + "'")
          let ret_type = ext_sig.ret_type.clone()
          b.fn_ret_types.insert(ef.name.clone(), ret_type)
          b.fn_param_types.insert(ef.name.clone(), mir_signature_param_types(&mut b, "extern function '" + ef.name + "'", &ext_sig, &ef.params))
        when _ then ()
        end
      end
    when _ then ()
    end
    ret_idx = ret_idx + 1
  end

  # Diagnostic: count and check items
  var total_items = 0
  var fn_items = 0
  var impl_items = 0
  var has_cmd_compile_ast = false
  var has_cmd_build_ast = false
  var has_args_ast = false
  var has_detect_host = false
  var has_raw_close = false
  var has_collect_fn_refs = false
  var has_emit = false
  var has_lint_file = false
  for item in program.items do
    total_items = total_items + 1
    match item.kind
    when ItemKind::ItemFunction(f) then
      fn_items = fn_items + 1
      if f.name == "cmd_compile" then has_cmd_compile_ast = true end
      if f.name == "cmd_build" then has_cmd_build_ast = true end
      if f.name == "args" then has_args_ast = true end
      if f.name == "detect_host_target" then has_detect_host = true end
      if f.name == "raw_close" then has_raw_close = true end
      if f.name == "collect_fn_refs" then has_collect_fn_refs = true end
      if f.name == "emit" then has_emit = true end
      if f.name == "lint_file" then has_lint_file = true end
    when ItemKind::ItemImpl(_) then impl_items = impl_items + 1
    when _ then ()
    end
  end

  eprintln("[lprog] total_items=" + total_items + " fn_items=" + fn_items + " impl_items=" + impl_items)
  var dbg_skipped = 0
  var dbg_none = 0

  # PASS 1: Lower all struct and enum type definitions first.
  # This ensures b.type_defs is fully populated before any function
  # body is lowered.
  for item in program.items do
    match item.kind
    when ItemKind::ItemStruct(s) then
      types.push(lower_struct_def(&mut b, &s))
    when ItemKind::ItemEnum(e) then
      types.push(lower_enum_def(&mut b, &e))
    when _ then ()
    end
  end

  # PASS 2: Lower functions, statics, impl methods, and extern blocks.
  # NOTE: We do NOT skip functions with duplicate names here because
  # merge_imported_deps flattens items from all dependency files into one
  # Vec. Using simple names for dedup would silently drop functions from
  # different files that happen to share the same name. If duplicates do
  # exist in the merged list (hash collisions in collect_dep_file), the MIR
  # will have duplicates, but no function is silently lost.
  var item_idx2 = 0
 # (final layer): the owner-module-path walk — the SAME walk the
  # resource checker performs (resource_check's module_path_of_item_resolver
  # containment scan over Program.crate.modules). Each item's owner key is
  # derived under its FULL module path, so the no-DefId fallback
  # ("module::<full path>::<name>") is byte-identical to the checker's
  # fn_owner_key_of_item — the plans (finalize_plan, edge_cleanup,
  # param_binding_resolutions) are keyed by the checker's key, and MIR must
  # look them up with the SAME key. The DefId path renders "<module
  # path>::<index>::<kind>"; both formats are the module-qualified identity,
  # never a bare name.
  while item_idx2 < program.items.len() do
    let item = program.items[item_idx2]
    let (owner_path2, _owner_module2) = module_path_of_item_resolver(program, item_idx2)
    match item.kind
    when ItemKind::ItemFunction(f) then
      # Set the SAME owner key the resource checker used (DefId-based), so
      # finalize_plan and param bindings resolve to this function.
      b.current_fn_key = mir_fn_owner_key(b, item_idx2, &owner_path2, f.name.clone())
 # the SEMANTIC callable identity for the function-end cleanup
      # lookup (the checker's item_callable mirror).
      b.current_callable = mir_fn_callable(b, item_idx2)
      b.current_closure_node = Option::None
 # the MirFunction's emission name is the DefId-derived base
      # (fn_owner_key_of_def "<module path>::<index>::<kind>") — the
      # semantic identity
      # the call sites derive from their InstanceId — with the source name
      # reserved for the OS entry (linking boundary) and the no-DefId
      # fallback. Codegen emits this name as the symbol and the fn_alias
      # identity label.
      let emission_name = mir_fn_emission_name(b, item_idx2, &owner_path2, f.name.clone())
      match lower_function(&mut b, &f, emission_name)
      when Option::Some(mir_fn) then
        functions.push(mir_fn)
      when Option::None then dbg_none = dbg_none + 1
      end
      b.current_fn_key = ""
      b.current_callable = Option::None
      b.current_closure_node = Option::None
    when ItemKind::ItemStatic(s) then
      statics.push(lower_static(&mut b, &s))
    when ItemKind::ItemConst(c) then
      statics.push(lower_const(&mut b, &c))
    when ItemKind::ItemImpl(impl_decl) then
 # (impl-name mangling): the mangled method emission names derive
      # from the RESOLVED OWNER TypeId's REGISTERED name (the checker's
      # type_names), never from the raw TypeExpr syntax; the syntactic name
      # is read only inside mir_impl_owner_type_name as the lookup key into
      # the semantic inverse, and stringification happens only here, at the
      # emission-name boundary (with the Array→Vec normalization the
      # call-site mangling uses — method calls on the Array/Vec/Slice Adt
      # forms emit "Vec__method").
      let impl_type_name = mir_impl_owner_type_name(&b, &impl_decl.for_type, &impl_decl.self_type)

      # Extract methods from impl blocks as standalone MIR functions
      # Mangle method names as TypeName__method_name to avoid collisions
      var method_idx = 0
      while method_idx < impl_decl.methods.len() do
        let method = impl_decl.methods[method_idx]
        let mangled_name = if impl_type_name != "" then
          impl_type_name.clone() + "__" + method.name.clone()
        else
          method.name.clone()
        end
        # ZERO-INFERENCE: register the method's resolver DefId under its
        # mangled name (item_defs carries the impl's method DefIds in
        # declaration order — the SAME DefId the checker records in
        # typed_call_targets for source method calls). IR-synthesized calls
        # to this generic method base attach their instance by construction
        # from method_def_ids (see lower_for_projected).
        match b.item_defs.get(item_idx2)
        when Option::Some(dids) then
          if method_idx < dids.len() then
            b.method_def_ids.insert(mangled_name.clone(), dids[method_idx].clone())
          end
        when Option::None then ()
        end
 # record the DECLARED parameter count alongside the DefId
        # (the map/set Hash/Eq dispatch gates on it).
        b.method_param_counts.insert(mangled_name.clone(), method.params.len())
        # NOTE: We do NOT skip impl methods with duplicate mangled names here
        # (same rationale as functions above — silent skipping can drop valid
        # methods from different files with the same name).
        # Rewrite params: give self/&self/&mut self the impl type
        var new_params = Vec::new()
        for p in method.params do
          if p.name == "self" then
            let self_ty = if impl_type_name != "" then
              Option::Some(impl_decl.for_type.clone())
            else
              p.ty.clone()
            end
            new_params.push(Param {
              convention: p.convention,
              name: p.name.clone(),
              ty: self_ty,
              default: p.default.clone(),
              span: p.span
            })
          else
            new_params.push(p.clone())
          end
        end
        # Create a renamed copy of the method with mangled name. The
        # generic parameter list merges the IMPL's generic parameters with
        # the method's own: lower_function resolves type references through
        # this list, and an impl method's signature references the impl
        # parameters (self: Array[T], item: T — and for an extension impl
        # `impl[T, I: Iterator[T]] I`, self: I). Without the merge those
        # references would not resolve to Type::Param and the generic
        # template would lose its parameters.
        var merged_generics = Vec::new()
        var mg = 0
        while mg < impl_decl.generic_params.len() do
          merged_generics.push(impl_decl.generic_params[mg].clone())
          mg = mg + 1
        end
        for mgp in method.generic_params do
          merged_generics.push(mgp.clone())
        end
        let renamed_method = FunctionDecl {
          vis: method.vis.clone(),
          name: mangled_name.clone(),
          generic_params: merged_generics,
          params: new_params,
          ret_type: method.ret_type.clone(),
          where_clause: method.where_clause.clone(),
          body: method.body.clone(),
          is_async: method.is_async,
          is_unsafe: method.is_unsafe,
          is_const: method.is_const,
          is_inline: method.is_inline,
          is_pure: method.is_pure,
          contracts: method.contracts.clone(),
          budget_val: method.budget_val.clone(),
          required_caps: method.required_caps.clone(),
          effects: method.effects.clone(),
          span: method.span
        }
        b.current_fn_key = mir_item_owner_key(b, item_idx2, method_idx)
 # the SEMANTIC callable identity for the function-end cleanup
        # lookup (the checker's item_method_callable mirror).
        b.current_callable = mir_item_callable(b, item_idx2, method_idx)
        b.current_closure_node = Option::None
        match lower_function(&mut b, &renamed_method, renamed_method.name.clone())
        when Option::Some(mir_fn) then
          functions.push(mir_fn)
          # Register with mangled name for fallback resolution
          b.impl_type_map.insert(mangled_name.clone(), impl_type_name.clone())
 # EXTENSION impls — an impl whose for_type is a generic
          # PARAMETER (`impl[T, I: Iterator[T]] I`, whose for_type name "I"
          # is not a registered type) has no receiver TypeId, so its methods
          # cannot be named TypeName__method at the call site; the checker
          # resolves them on any receiver that unifies the parameter, and
          # the call-site lowering needs the impl-registered mangled name
          # (I__map). Register the bare method name -> mangled name here.
 # (impl-name mangling): the detection is the SEMANTIC OWNER
          # TypeId resolution — an impl whose for/self type never registered
          # a TypeId has no owner TypeId; only a NAME-BEARING for/self type
          # can be a generic-parameter for_type.
          match mir_impl_owner_type_id(&b, &impl_decl.for_type, &impl_decl.self_type)
          when Option::None then
            if mir_impl_has_named_type(&b, &impl_decl.for_type, &impl_decl.self_type) then
              b.param_impl_methods.insert(method.name.clone(), mangled_name.clone())
            end
          when Option::Some(_) then ()
          end
        when Option::None then ()
        end
        b.current_fn_key = ""
        b.current_callable = Option::None
        b.current_closure_node = Option::None
        method_idx = method_idx + 1
      end
    when ItemKind::ItemStruct(s) then
      var type_args = Vec::new()
      var sgp_idx = 0
      while sgp_idx < s.generic_params.len() do
        type_args.push(TypeExpr { kind: TypeExprKind::Named(s.generic_params[sgp_idx].name.clone(), Vec::new()), span: s.span })
        sgp_idx = sgp_idx + 1
      end
      let res_for_type = TypeExpr { kind: TypeExprKind::Named(s.name.clone(), type_args), span: s.span }
      var sm_idx = 0
      while sm_idx < s.methods.len() do
        let method = s.methods[sm_idx]
        let mangled_name = s.name.clone() + "__" + method.name.clone()
        # ZERO-INFERENCE: register the struct method's resolver DefId under
        # its mangled name (item_defs carries the struct's method DefIds in
        # declaration order) — the instance-by-construction table for
        # IR-synthesized calls to generic method bases.
        match b.item_defs.get(item_idx2)
        when Option::Some(dids) then
          if sm_idx < dids.len() then
            b.method_def_ids.insert(mangled_name.clone(), dids[sm_idx].clone())
          end
        when Option::None then ()
        end
 # record the DECLARED parameter count alongside the DefId.
        b.method_param_counts.insert(mangled_name.clone(), method.params.len())
        var new_params = Vec::new()
        for p in method.params do
          if p.name == "self" then
            new_params.push(Param {
              convention: p.convention,
              name: p.name.clone(),
              ty: Option::Some(res_for_type.clone()),
              default: p.default.clone(),
              span: p.span
            })
          else
            new_params.push(p.clone())
          end
        end
        # Create a renamed copy of the struct method. Same generic-parameter
        # merge as impl methods: the struct's generic parameters are in
        # scope in the method signatures (self: Box[T], `def get(self: &Box[T]) -> &T`).
        var s_merged_generics = Vec::new()
        var smg = 0
        while smg < s.generic_params.len() do
          s_merged_generics.push(s.generic_params[smg].clone())
          smg = smg + 1
        end
        for smgp in method.generic_params do
          s_merged_generics.push(smgp.clone())
        end
        let renamed_method = FunctionDecl {
          vis: method.vis.clone(),
          name: mangled_name.clone(),
          generic_params: s_merged_generics,
          params: new_params,
          ret_type: method.ret_type.clone(),
          where_clause: method.where_clause.clone(),
          body: method.body.clone(),
          is_async: method.is_async,
          is_unsafe: method.is_unsafe,
          is_const: method.is_const,
          is_inline: method.is_inline,
          is_pure: method.is_pure,
          contracts: method.contracts.clone(),
          budget_val: method.budget_val.clone(),
          required_caps: method.required_caps.clone(),
          effects: method.effects.clone(),
          span: method.span
        }
        b.current_fn_key = mir_item_owner_key(b, item_idx2, sm_idx)
 # the SEMANTIC callable identity for the function-end cleanup
        # lookup (the checker's item_method_callable mirror).
        b.current_callable = mir_item_callable(b, item_idx2, sm_idx)
        b.current_closure_node = Option::None
        match lower_function(&mut b, &renamed_method, renamed_method.name.clone())
        when Option::Some(mir_fn) then
          functions.push(mir_fn)
          b.impl_type_map.insert(mangled_name.clone(), s.name.clone())
        when Option::None then ()
        end
        b.current_fn_key = ""
        b.current_callable = Option::None
        b.current_closure_node = Option::None
        sm_idx = sm_idx + 1
      end
    when ItemKind::ItemExternBlock(ext) then
      # Register extern function declarations.
      # These generate empty MIR functions with is_extern = true
      # so codegen emits proper relocations instead of function bodies.
      for ext_item in ext.items do
        match ext_item
        when ExternItem::Function(ef) then
          let abi_tag = match ext.abi
          when Option::Some(abi) then abi.clone()
          when Option::None then "C"
          end
          let extern_fn = lower_extern_fn(&mut b, &ef, abi_tag)
          functions.push(extern_fn)
        when ExternItem::Static(es) then
 # the extern static's DECLARED type comes from the typed
          # table (the checker's resolved declaration record — never
          # TypeExpr again); a missing entry is an internal error
          # (fail-closed). The read-through registry feeds
          # lower_extern_static below.
          let es_key = module_qualified_key(&owner_path2, &es.name)
          match b.typed_static_types.get(es_key.clone())
          when Option::Some(est_ty) then b.static_types.insert(es.name.clone(), est_ty)
          when Option::None then b.errors.push("internal error: missing typed static type for extern static '" + es_key + "' during MIR lowering")
          end
          statics.push(lower_extern_static(&b, &es))
          b.static_names.insert(es.name.clone())
 # the extern static's DefId (the resolver registered
          # ExternItem::Static under DefKind::Static in module_symbols) —
          # the reference forms carry it.
          match b.resolutions.module_symbols.get(es_key)
          when Option::Some(es_did) then b.static_def_ids.insert(es.name.clone(), es_did)
          when Option::None then ()
          end
        end
      end
    when _ then ()
    end
    item_idx2 = item_idx2 + 1
  end
  
  eprintln("[lprog] lowered_fns=" + functions.len() + " skipped=" + dbg_skipped + " none=" + dbg_none)

  # Emit any closures that were queued during lowering
 # build the map/set dispatch metadata from the method tables —
  # the instance-base render (fn_owner_key_of_def) makes the codegen's
  # label reconstruction byte-identical to the monomorphizer's
  # instance_key for generic impls.
  var dispatch_methods: Map[String, (DefId, String, Int)] = Map::new()
  for dname in b.method_def_ids.keys() do
    match b.method_def_ids.get(&dname)
    when Option::Some(did) then
      let render = fn_owner_key_of_def(&b.program, &b.resolutions, &did)
      let pc = match b.method_param_counts.get(&dname)
      when Option::Some(c) then c
      when Option::None then 0
      end
      dispatch_methods.insert(dname.clone(), (did, render, pc))
    when Option::None then ()
    end
  end
  var result = MirProgram { functions: functions, statics: statics, types: types, deinit_plans: b.deinit_plans.clone(), dispatch_methods: dispatch_methods, generic_param_names: b.generic_param_names.clone(), drop_glue_instances: b.drop_glue_instances.clone(), drop_glue_fns: b.drop_glue_fns.clone(), method_names_by_def: b.method_names_by_def.clone(), engine_env: b.engine_env.clone() }
  lower_pending_closures(&mut b, &mut result)

 # (plan-key fix): pre-populate the CONCRETE (TypeId, substs)-keyed
  # deinit-plan cache (b.concrete_deinit_plans) from the lowered MIR, then
  # carry it on MirProgram as the authoritative plan table (codegen's drop
  # glue and the MIR verifier look up by concrete identity — Wrapper[Int]
  # and Wrapper[File] are distinct entries; the TypeId-keyed semantic table
  # cloned above stays the builder's def-less fallback only).
  mir_populate_concrete_plans(&mut b, &result)
  result.deinit_plans = b.concrete_deinit_plans.clone()
 # build every generated drop-glue function body (ordinary
  # MirFunctions — codegen emits them like any other function and the
  # whole-value destruction sites call them through the MirDeinit
  # InstanceId payloads) and append them to the program.
  mir_build_all_drop_glues(&mut b, &mut result)
 # (real String lifetime): destruction identities registered AFTER the
  # MirProgram construction above (the final concrete-plan population and
  # the glue-body build — most notably the String destructor's synthetic
  # entry in drop_glue_fns) are re-synced: MirProgram's tables are the
  # authority for codegen's label resolution (codegen_deinit_label) and
  # the MIR verifier's MirDeinit callee check.
  result.drop_glue_fns = b.drop_glue_fns.clone()
  result.drop_glue_instances = b.drop_glue_instances.clone()

  # Slice[T] has NO std stub declaration (it is a registered Opaque builtin),
  # so no MirTypeDef for its id reaches the MIR type table — the layout
  # engine and codegen classify the Slice id BY NAME (type_repr's "Slice" arm
  # → the 16-byte two-field view). Synthesize the MirTypeDef so the name
  # tables resolve it; the declared fields mirror the view shape
  # { ptr: Ptr[T] @ 0, len: Int @ 8 } (slice_view_layout). The synthesized
  # def is never walked for ownership (deinit_plan_for_type's "Slice" arm
  # returns Trivial before any def lookup).
  var slice_def_present = false
  var sd_idx = 0
  while sd_idx < result.types.len() do
    if result.types[sd_idx].id.id == b.lang_items.slice then
      slice_def_present = true
    end
    sd_idx = sd_idx + 1
  end
  if !slice_def_present then
    let slice_tid = b.lang_items.slice
    if slice_tid >= 0 then
 # the synthesized Slice[T] def interns its T into the
      # builder's shared table; the field type references the interned id.
      let slice_owner = fresh_synthetic_owner(&mut b.generic_param_table)
      let slice_t_id = intern_generic_param(&mut b.generic_param_table, &slice_owner, "T".to_string())
      var slice_fields = Vec::new()
      slice_fields.push(MirFieldDef {
        name: "ptr",
        ty: Type::Ptr(Type::Param(slice_t_id.clone()))
      })
      slice_fields.push(MirFieldDef {
        name: "len",
        ty: Type::Int
      })
      var slice_generics = Vec::new()
      slice_generics.push(slice_t_id)
      result.types.push(MirTypeDef {
        id: TypeId { id: slice_tid },
        name: "Slice".to_string(),
        kind: MirTypeDefKind::Struct(slice_fields),
        generic_params: slice_generics
      })
    end
  end

  # Search MIR functions for cmd_compile
  var found_mir_cmd_compile = false
  var result_func_idx = 0
  while result_func_idx < result.functions.len() do
    let f = result.functions[result_func_idx]
    if f.name == "cmd_compile" then found_mir_cmd_compile = true end
    result_func_idx = result_func_idx + 1
  end

  if b.errors.len() > 0 then
    return Result::Err(b.errors[0].clone())
  end
  Result::Ok(result)
end

# `emission_name` is the MirFunction's emission name — for a
# top-level function the DefId-derived base (mir_fn_emission_name); for impl
# / struct methods the pre-mangled "Type__method" name of the renamed decl.
def lower_function(inout b: MirBuilder, f: FunctionDecl, emission_name: String) -> Option[MirFunction]
 # the declaration's typed signature — the checker's resolved
  # parameter ParamTypes and return type, read from the typed record under
  # the fn owner key (the typed table is the authority; TypeExpr is never
  # interpreted after checking). A declaration missing from the typed table
  # is an internal error (fail-closed).
  var fn_sig = FnSignature { params: Vec::new(), ret_type: Type::Unit }
  match b.typed_fn_signatures.get(b.current_fn_key.clone())
  when Option::Some(sig) then fn_sig = sig.clone()
  when Option::None then
    b.errors.push("internal error: missing typed signature for '" + b.current_fn_key.clone() + "' during MIR lowering")
  end
 # the generic parameter ids come from the checker's record (the
  # fn owner key -> ids in the merged declaration order, paired positionally
  # with this declaration's generic list); a declaration the checker never
  # recorded (IR-synthesized) interns its own ids into the builder's shared
  # table — self-consistent within the builder, names recorded for
  # diagnostics. The SAME declaration-order ids are written into the
 # MirFunction's generic_params below (the monomorphizer's
  # EXCLUSIVE authority).
  var typed_param_ids = Vec::new()
  match b.generic_param_ids.get(b.current_fn_key.clone())
  when Option::Some(ids) then typed_param_ids = ids.clone()
  when Option::None then ()
  end
  var decl_generic_ids = Vec::new()
  var gi = 0
  while gi < f.generic_params.len() do
    let gp = f.generic_params[gi]
    if gi < typed_param_ids.len() then
      decl_generic_ids.push(typed_param_ids[gi].clone())
    else
      let fallback_owner = fresh_synthetic_owner(&mut b.generic_param_table)
      var fj = gi
      while fj < f.generic_params.len() do
        let fgp = f.generic_params[fj]
        let fid = intern_generic_param(&mut b.generic_param_table, &fallback_owner, fgp.name.clone())
        decl_generic_ids.push(fid.clone())
        fj = fj + 1
      end
      break
    end
    gi = gi + 1
  end

 # the return type is the typed signature's record.
  var ret_type = fn_sig.ret_type.clone()

  start_function(b, emission_name, ret_type.clone(), f.span)

 # (the MirFunction.generic_params WRITE SITE): record the
  # declaration-order generic parameter ids on the lowered function — the
  # monomorphizer's EXCLUSIVE authority (the signature-derived fallback in
  # mono.tg is are not part of the model; a generic template without its declaration-order
  # ids is malformed MIR). The ids are the checker's record (the merged
  # declaration order) when available, else the synthetic interning above;
  # a non-generic function carries an empty list.
  match b.current_fn
  when Option::Some(fn_ref) then
    fn_ref.generic_params = decl_generic_ids
  when Option::None then ()
  end
 # (the MirFunction.declared_effects WRITE SITE): carry the
  # checker's typed DECLARED EFFECT SET onto the lowered function — the
  # typed FnSignature record is the authority (the parsed `effect[...]`
  # annotations interned through the EffectRegistry, or the std
  # effectful-function seeds); the MIR verifier's effect rule checks the
  # function's calls against this set.
  match b.current_fn
  when Option::Some(fn_ref2) then
    fn_ref2.declared_effects = fn_sig.declared_effects.clone()
  when Option::None then ()
  end
 # (the MirFunction.declared_budget WRITE SITE): carry the checker's
  # typed DECLARED BUDGET (the @budget annotation's metric + limit pairs)
  # onto the lowered function — the typed FnSignature record is the
  # authority (typed_budget_of strips the spans); the runtime enforcement
  # reads the limits from here, and the builder tracks the current
  # function's budget for the allocation/time consume lowering below.
  match b.current_fn
  when Option::Some(fn_ref3) then
    fn_ref3.declared_budget = fn_sig.declared_budget.clone()
  when Option::None then ()
  end
  b.current_fn_budget = fn_sig.declared_budget.clone()
 # the TIME metric's ENTRY stamp — the first statement of the entry
  # block (block 0, current at this point — before the contracts and the
  # body lower): MirEffectRecord("__tg_budget_time_start") — codegen
  # stamps THIS INVOCATION's frame time slot (FrameInfo's
  # budget_time_offset — the per-frame entry stamp) with the monotonic
  # clock; the exit checks (emit_budget_time_exit_checks) compare the
  # elapsed clock against the declared limit at every MirReturn.
  if mir_budget_has_resource(b, "time") then
    let unit_op = MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirUnit,
        ty: Type::Unit,
        instance: Option::None
      })
    }
    push_stmt(b, MirStatementKind::MirEffectRecord("__tg_budget_time_start".to_string(), unit_op), f.span)
  end
  
  var param_idx = 0
  while param_idx < f.params.len() do
    let p = f.params[param_idx]
 # the parameter's BASE type is the typed signature's ParamType
    # record (the checker's resolved declaration type — never TypeExpr
    # again); the Inout RefInternal wrapping is the MIR's own
    # parameter-passing shape (the `&` Ref spelling is a parse-time
    # conversion to AccessConvention::Let — the Let convention carries the
    # by-value shape). A typed record with fewer parameters than the
    # declaration is an internal error (fail-closed).
    let base_ty = if param_idx < fn_sig.params.len() then fn_sig.params[param_idx].ty.clone() else
      b.errors.push("internal error: typed signature of '" + b.current_fn_key.clone() + "' has fewer parameters than its declaration during MIR lowering")
      Type::Unit
    end
    let convention = if param_idx < fn_sig.params.len() then fn_sig.params[param_idx].convention else p.convention end
    var ty = base_ty.clone()
    if convention == AccessConvention::Inout then
      ty = Type::RefInternal(base_ty.clone(), true)
    end
    let param_lid = add_param(b, p.name.clone(), ty, f.span)
    # Map the semantic parameter id (from the typed parameter bindings) to
    # this MIR local: the finalize plan refers to semantic ids.
    match b.param_binding_resolutions.get(b.current_fn_key.clone())
    when Option::Some(sem_ids) then
      if param_idx < sem_ids.len() then
        b.semantic_to_mir.insert(sem_ids[param_idx], param_lid.id)
      else
        b.errors.push("internal error: parameter index " + param_idx.to_string() + " exceeds typed parameter bindings")
      end
    when Option::None then
      b.errors.push("internal error: missing typed parameter bindings for " + b.current_fn_key.clone())
    end
    param_idx = param_idx + 1
  end
  
  # Lower contracts
  var contract_idx = 0
  while contract_idx < f.contracts.len() do
    let c = f.contracts[contract_idx]
    lower_contract(b, c)
    contract_idx = contract_idx + 1
  end
  
  # Lower body
  match f.body
  when FnBody::FnBlock(block) then
 # the function body is a lexical defer scope — its key stays on
    # the builder's scope chain for the whole body lowering AND the
    # implicit-return materialization below, so the body's defers run at
    # every return (the checker's check_block pushes the same key). For
    # Unit bodies lower_block pushes/pops it internally; it is re-pushed
    # for emit_cfg_deinit_returns.
    let fn_body_key = if block.stmts.len() > 0 then block.stmts[0].node_id else 0 end
    if ret_type != Type::Unit && block.stmts.len() > 0 then
      if fn_body_key != 0 then
        b.defer_scope_chain.push(fn_body_key)
      end
      # Lower all statements except the last
      var i = 0
      while i < block.stmts.len() - 1 do
        lower_stmt(b, &block.stmts[i])
        i = i + 1
      end
      # Last statement: if expression, store to return place (local 0)
      let last_idx = block.stmts.len() - 1
      lower_final_stmt_to_return_place(b, &block.stmts[last_idx], f.span)
      # If no explicit return, add implicit return
      emit_cfg_deinit_returns(b)
      if fn_body_key != 0 then
        b.defer_scope_chain.pop()
      end
    else
      lower_block(b, &block)
      if fn_body_key != 0 then
        b.defer_scope_chain.push(fn_body_key)
      end
      # If no explicit return, add implicit return
      emit_cfg_deinit_returns(b)
      if fn_body_key != 0 then
        b.defer_scope_chain.pop()
      end
    end
  when FnBody::FnExpr(expr) then
    # For if/else expressions as function bodies, assign directly to return place
    if ret_type != Type::Unit then
      match expr.kind
      when ExprKind::ExprIf(if_expr) then
        lower_if_to_place(b, if_expr, place_local(MirLocalId { id: 0 }), f.span)
      when _ then
 # dest-aware lowering — a literal body of a String
        # function converts through string_from_static into the owned form.
        match lower_expr_rvalue_to_dest(b, expr, &ret_type, f.span)
        when Result::Ok(rv) then
          push_stmt(b, MirStatementKind::MirAssign(place_local(MirLocalId { id: 0 }), rv), f.span)
        when Result::Err(e) then
          b.errors.push(e)
        end
      end
    else
      let result = lower_expr(b, expr, f.span)
    end
    emit_cfg_deinit_returns(b)
  when _ then
    emit_cfg_deinit_returns(b)
  end
  
 # the @budget enforcement tail: the TIME metric's EXIT checks (every
  # MirReturn block gains the elapsed-vs-limit MirBudgetConsume). The
  # ALLOCATION metric's enforcement is PURELY RUNTIME — the per-invocation
  # frame-slot counter (codegen's budget arms) traps when a path's
  # consumed units exceed the declared limit. There is NO static
  # allocation-site rejection: a body with two allocation sites and a
  # limit of one is legal when every path allocates at most once (an `if`
  # with one allocation per branch — the runtime counter decides, never
  # the site count).
  emit_budget_time_exit_checks(b, f.span)
  
  finish_function(b)
end

# Whether the current function's declared budget carries the resource
# (the canonical metric key — "alloc"/"time" — via budget_metric_resource).
def mir_budget_has_resource(b: MirBuilder, resource: String) -> Bool
  match b.current_fn_budget
  when Option::Some(tb) then
    for c in tb.constraints do
      if budget_metric_resource(&c.metric) == resource then return true end
    end
    false
  when Option::None then false
  end
end

# The current function's declared limit for the resource (0 when absent —
# the time metric's bound is unit-scaled to nanoseconds, the allocation
# metric's is the raw count).
def mir_budget_limit_of(b: MirBuilder, resource: String) -> Int
  match b.current_fn_budget
  when Option::Some(tb) then typed_budget_limit(&tb, resource)
  when Option::None then 0
  end
end

# The TIME metric's exit checks: append a MirBudgetConsume("time", limit)
# to every block whose terminator is MirReturn — every exit path of a
# time-budgeted function compares the elapsed clock against the limit
# (codegen traps when the limit is exceeded).
def emit_budget_time_exit_checks(inout b: MirBuilder, span: Span) -> Unit
  if mir_budget_has_resource(b, "time") then
    let limit = mir_budget_limit_of(b, "time")
    var bi = 0
    while bi < b.blocks.len() do
      let blk = b.blocks[bi]
      match blk.terminator.kind
      when MirTerminatorKind::MirReturn then
        b.blocks[bi].statements.push(MirStatement {
          kind: MirStatementKind::MirBudgetConsume("time".to_string(), limit),
          span: span
        })
      when _ then ()
      end
      bi = bi + 1
    end
  end
end

# The ALLOCATION metric's runtime enforcement is the ONLY enforcement: the
# per-invocation frame-slot counter (codegen's MirBudgetConsume arm — the
# slot allocate_locals reserved and the prologue zeroed) counts the units a
# PATH consumes and traps when the path exceeds the declared limit. The
# former STATIC allocation-site rejection is REMOVED — it was
# path-insensitive and invalid: an `if` with one allocation per branch has
# two sites while every path allocates once, and a within-limit loop over a
# single site allocates many times. Both cases are dynamic behavior the
# runtime counter decides; the compile-time surface is only the annotated
# function's enforcement statements.

def lower_final_stmt_to_return_place(inout b: MirBuilder, stmt: Stmt, span: Span) -> Unit
  let last_kind = stmt_kind_name(&stmt.kind)
  if last_kind == "StmtIf" then
    match stmt.kind
    when StmtKind::StmtIf(if_stmt) then
      lower_if_to_place(b, &if_stmt, place_local(MirLocalId { id: 0 }), span)
    when _ then ()
    end
  elsif last_kind == "StmtMatch" then
    match stmt.kind
    when StmtKind::StmtMatch(m) then
      lower_match_to_place(b, &m, place_local(MirLocalId { id: 0 }), span)
    when _ then ()
    end
  elsif last_kind == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(expr) then
      let expr_kind = expr_kind_name(&expr.kind)
      if expr_kind == "ExprIf" then
        match expr.kind
        when ExprKind::ExprIf(if_expr) then
          lower_if_to_place(b, &if_expr, place_local(MirLocalId { id: 0 }), span)
        when _ then ()
        end
      elsif expr_kind == "ExprMatch" then
        match expr.kind
        when ExprKind::ExprMatch(m) then
          lower_match_to_place(b, &m, place_local(MirLocalId { id: 0 }), span)
        when _ then ()
        end
      else
        let ret0_ty = lookup_local_type(b, &MirLocalId { id: 0 })
        match lower_expr_rvalue_to_dest(b, &expr, &ret0_ty, span)
        when Result::Ok(rvalue) then
          push_stmt(b, MirStatementKind::MirAssign(place_local(MirLocalId { id: 0 }), rvalue), span)
        when Result::Err(e) then
          b.errors.push(e)
        end
      end
    when _ then ()
    end
  else
    lower_stmt(b, stmt)
  end
end


def expr_kind_tag(k: ExprKind) -> String
  match k
  when ExprKind::ExprPath(_) then "ExprPath"
  when ExprKind::ExprIntLit(_) then "ExprIntLit"
  when ExprKind::ExprBoolLit(_) then "ExprBoolLit"
  when ExprKind::ExprStringLit(_) then "ExprStringLit"
  when ExprKind::ExprCall(_, _) then "ExprCall"
  when ExprKind::ExprIdent(name) then "ExprIdent(" + name + ")"
  when ExprKind::ExprEnumVariant(_, _) then "ExprEnumVariant"
  when _ then "Other"
  end
end

def lower_static_init_operand(inout b: MirBuilder, value: Expr, resolved_ty: Type) -> Option[MirOperand]
  # Try to produce a direct constant operand for common static init patterns:
  #   - Enum variant paths like Option::None → discriminant integer
  #   - Integer/bool/string literals → direct constant
  #   - Vec::new(), Map::new(), Set::new() → zero (null pointer)
  # Anything else is an unsupported initializer and must fail fast: a static
  # init is a supported constant, a supported runtime init, or an error —
  # never a silently invented zero/None.
  match value.kind
  when ExprKind::ExprPath(path) then
    if path.segments.len() >= 2 then
      match resolve_enum_variant_discriminant(b, &path)
      when Result::Ok(disc) then
        Option::Some(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(disc),
            ty: Type::Int,
            instance: Option::None
          })
        })
      when Result::Err(e) then
 # never silently invent a value for an unknown variant — the
        # internal error is recorded (aborting lowering at the error drain)
        # and a defensive Unit aggregate is produced.
        b.errors.push(e)
        Option::Some(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirUnit,
            ty: Type::Unit,
            instance: Option::None
          })
        })
      end
    else
      Option::Some(MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirUnit,
          ty: Type::Unit,
          instance: Option::None
        })
      })
    end
  when ExprKind::ExprIntLit(n) then
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirInt(n),
        ty: Type::Int,
        instance: Option::None
      })
    })
  when ExprKind::ExprBoolLit(v) then
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirBool(v),
        ty: Type::Bool,
        instance: Option::None
      })
    })
  when ExprKind::ExprFloatLit(v) then
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFloat(v),
        ty: Type::Float,
        instance: Option::None
      })
    })
  when ExprKind::ExprCharLit(v) then
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirChar(v),
        ty: Type::Char,
        instance: Option::None
      })
    })
  when ExprKind::ExprStringLit(s_val) then
 # the literal lowers to the STATIC STRVIEW form (the
    # interned static label). Static initializers of String type convert
    # through string_from_static at the demand site (lower_expr_rvalue_to_dest).
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirString(s_val),
        ty: Type::String,
        instance: Option::None
      })
    })
  when ExprKind::ExprCall(callee, _) then
    # Vec::new(), Map::new(), etc. → zero-init (null pointer)
    Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirInt(0),
        ty: Type::Int,
        instance: Option::None
      })
    })
  when _ then
    panic("internal error: unsupported static initializer (expression kind " + expr_kind_name(&value.kind) + ") for type " + format_mir_type(&b.typed_type_names, &b.generic_param_names, &resolved_ty) + "; a static initializer must be a supported constant or runtime init, never a silent zero")
  end
end

def lower_static(inout b: MirBuilder, s: StaticDecl) -> MirStatic
 # the static's declared type comes from the pre-pass registry, which
  # was populated from the typed table (the checker's resolved declaration
  # type — never TypeExpr again). A missing entry is an internal error
  # (fail-closed).
  let resolved_ty = match b.static_types.get(s.name.clone())
  when Option::Some(ty) then ty
  when Option::None then
    b.errors.push("internal error: missing typed static type for static '" + s.name.clone() + "' during MIR lowering")
    Type::Unit
  end
  let init_val = lower_static_init_operand(b, &s.value, resolved_ty.clone())

  MirStatic {
    name: s.name,
    ty: resolved_ty,
    init: init_val,
    is_mut: s.is_mut
  }
end

def lower_const(inout b: MirBuilder, c: ConstDecl) -> MirStatic
 # the const's declared type comes from the pre-pass registry, which
  # was populated from the typed table (the checker's resolved declaration
  # type — never TypeExpr again). A missing entry is an internal error
  # (fail-closed).
  let resolved_ty = match b.static_types.get(c.name.clone())
  when Option::Some(ty) then ty
  when Option::None then
    b.errors.push("internal error: missing typed const type for const '" + c.name.clone() + "' during MIR lowering")
    Type::Unit
  end
  let init_val = lower_static_init_operand(b, &c.value, resolved_ty.clone())

  MirStatic {
    name: c.name,
    ty: resolved_ty,
    init: init_val,
    is_mut: false
  }
end

def lower_extern_fn(inout b: MirBuilder, ef: ExternFn, abi: String) -> MirFunction
  # Create an extern function declaration.
  # This has no body — codegen will emit a relocation against the symbol name.
 # the extern's declared parameter/return types come from the pre-pass
  # registries, which were populated from the typed signature table (the
  # checker's resolved declaration record — never TypeExpr again); a
  # missing entry is an internal error (fail-closed).
  let entry = MirBlockId { id: 0 }
  
  var params = Vec::new()
  var local_id = 0
  var param_tys = match b.fn_param_types.get(ef.name.clone())
  when Option::Some(tys) then tys.clone()
  when Option::None then
    b.errors.push("internal error: missing typed parameter types for extern function '" + ef.name.clone() + "' during MIR lowering")
    Vec::new()
  end
  for p in ef.params do
    let base_ty = if local_id < param_tys.len() then
      # The registry carries the RefInternal-wrapped shape (the same
      # modifier convention as the function lowering); the MirLocal takes
      # it as-is.
      param_tys[local_id].clone()
    else
      b.errors.push("internal error: typed parameter count mismatch for extern function '" + ef.name.clone() + "' during MIR lowering")
      Type::Unit
    end
    params.push(MirLocal {
      id: MirLocalId { id: local_id },
      name: p.name.clone(),
      ty: base_ty,
      is_mut: false,
      span: ef.span
    })
    local_id = local_id + 1
  end
  
  let ret_type = match b.fn_ret_types.get(ef.name.clone())
  when Option::Some(rt) then rt.clone()
  when Option::None then
    b.errors.push("internal error: missing typed return type for extern function '" + ef.name.clone() + "' during MIR lowering")
    Type::Unit
  end
  
  # Mangle the name for Ruby ABI: prefix with _tg_rb_ for the thunk
  let mangled_name = if abi == "Ruby" then
    ef.name.clone()  # Keep original name — linker resolves against libruby
  else
    ef.name.clone()
  end
  
  MirFunction {
    name: mangled_name,
    params: params.clone(),
    ret_type: ret_type,
    generic_params: Vec::new(),    # Extern declarations carry no generics
    locals: params,
    blocks: Vec::new(),    # Empty — no body for extern functions
    entry_block: MirBlockId { id: entry.id },
    is_async: false,
    is_unsafe: true,       # Extern functions are always unsafe
    is_extern: true,
    extern_abi: abi,
    contracts: Vec::new(),
    span: ef.span
  }
end

def lower_extern_static(b: MirBuilder, es: ExternStatic) -> MirStatic
 # the extern static's declared type comes from the pre-pass registry,
  # which was populated from the typed table (the checker's resolved
  # declaration type — never TypeExpr again). A missing entry is an
  # internal error (fail-closed).
  let st_ty = match b.static_types.get(es.name.clone())
  when Option::Some(ty) then ty
  when Option::None then
    b.errors.push("internal error: missing typed static type for extern static '" + es.name.clone() + "' during MIR lowering")
    Type::Unit
  end
  MirStatic {
    name: es.name.clone(),
    ty: st_ty,
    init: Option::None,
    is_mut: es.is_mut
  }
end

def lower_struct_def(inout b: MirBuilder, s: StructDecl) -> MirTypeDef
 # FIX 1: the SEMANTIC TypeId from the typed program's type tables
  # (b.type_name_to_id is the inverse of typed.type_names, populated in
  # lower_program). No fresh id is ever minted for a source type — a missing
  # semantic id is an internal error, not a license to invent a new number.
  let tid = match b.type_name_to_id.get(s.name)
  when Option::Some(id) then id
  when Option::None then
    b.errors.push("internal error: no semantic TypeId for struct '" + s.name + "' during MIR lowering")
    0
  end

 # the declaration's generic parameter ids come from the typed table
  # (typed_type_params — the checker's declaration-order record; the SAME
  # ids the field types' Type::Param forms reference). No builder-side
  # interning for source types: the MIR universe IS the checker's universe
  # (a Param left unsubstituted fails closed in the layout engine, never a
  # pointer word).
  var s_generics = Vec::new()
  match b.typed_type_params.get(tid)
  when Option::Some(gids) then s_generics = gids.clone()
  when Option::None then b.errors.push("internal error: no typed generic parameters for struct '" + s.name + "' during MIR lowering")
  end

 # the field types come from the typed table (typed_type_fields — the
  # checker's resolved declaration record; TypeExpr is never interpreted
  # after checking). A missing entry is an internal error (fail-closed).
  var fields = Vec::new()
  match b.typed_type_fields.get(tid)
  when Option::Some(typed_fields) then
    for (fname, fty) in typed_fields do
      fields.push(MirFieldDef {
        name: fname.clone(),
        ty: fty.clone()
      })
    end
  when Option::None then b.errors.push("internal error: no typed field table entry for struct '" + s.name + "' during MIR lowering")
  end
  let td = MirTypeDef {
    id: TypeId { id: tid },
    name: s.name,
    kind: MirTypeDefKind::Struct(fields),
    generic_params: s_generics
  }
  b.type_defs.push(td.clone())
  td
end

def lower_enum_def(inout b: MirBuilder, e: EnumDecl) -> MirTypeDef
 # FIX 1: same semantic-TypeId rule as lower_struct_def — the typed
  # program's table is the only id source; a missing entry is an internal
  # error (fail closed), never a freshly minted builder-local id.
  let tid = match b.type_name_to_id.get(e.name)
  when Option::Some(id) then id
  when Option::None then
    b.errors.push("internal error: no semantic TypeId for enum '" + e.name + "' during MIR lowering")
    0
  end

 # the declaration's generic parameter ids come from the typed table
  # (typed_type_params — the checker's declaration-order record; the SAME
  # ids the variant payload types' Type::Param forms reference) — no
  # builder-side interning for source types.
  var e_generics = Vec::new()
  match b.typed_type_params.get(tid)
  when Option::Some(gids) then e_generics = gids.clone()
  when Option::None then b.errors.push("internal error: no typed generic parameters for enum '" + e.name + "' during MIR lowering")
  end

  var variants = Vec::new()
  var disc = 0
  var v_index = 0
  for v in e.variants do
    # Use explicit discriminant from AST if provided (supports negative
    # values — the checker's typed variant table records sequential
    # discriminants only, so the AST declaration remains the discriminant
    # authority; this is a constant, never a type reconstruction).
    match v.discriminant
    when Option::Some(expr) then
      match expr.kind
      when ExprKind::ExprIntLit(n) then disc = n
      when ExprKind::ExprUnaryOp(UnOp::Neg, inner) then
        match inner.kind
        when ExprKind::ExprIntLit(n) then disc = 0 - n
        when _ then ()
        end
      when _ then ()
      end
    when Option::None then ()
    end
 # the variant payload types come from the typed table
    # (typed_type_variants — the checker's resolved declaration record;
    # TypeExpr is never interpreted after checking). A missing entry is an
    # internal error (fail-closed).
    var lowered_fields = Vec::new()
    match b.typed_type_variants.get(tid)
    when Option::Some(typed_variants) then
      if v_index < typed_variants.len() then
        lowered_fields = typed_variants[v_index].1.clone()
      else
        b.errors.push("internal error: enum '" + e.name + "' variant index " + v_index.to_string() + " exceeds the typed variant table during MIR lowering")
      end
    when Option::None then b.errors.push("internal error: no typed variant table entry for enum '" + e.name + "' during MIR lowering")
    end
    variants.push(MirVariantDef {
      name: v.name,
      discriminant: disc,
      fields: lowered_fields
    })
    b.enum_variant_discriminants.insert(enum_variant_discriminant_key(&e.name, &v.name), disc)
    disc = disc + 1
    v_index = v_index + 1
  end
  let td = MirTypeDef {
    id: TypeId { id: tid },
    name: e.name,
    kind: MirTypeDefKind::Enum(variants),
    generic_params: e_generics
  }
  b.type_defs.push(td.clone())
  td
end

def lower_contract(inout b: MirBuilder, c: ContractClause) -> Unit
  # Lower contract condition to a runtime assertion
  let cond_op = lower_expr(b, &c.expr, c.span)
  let msg = match c.message
  when Option::Some(m) then m
  when Option::None then
    match c.kind
    when AstContractKind::AstPre then "precondition failed"
    when AstContractKind::AstPost then "postcondition failed"
    when AstContractKind::AstInvariant then "invariant violated"
    end
  end

  push_stmt(b, MirStatementKind::MirContractCheck(
    MirContract {
      kind: match c.kind
      when AstContractKind::AstPre then MirContractKind::Pre
      when AstContractKind::AstPost then MirContractKind::Post
      when AstContractKind::AstInvariant then MirContractKind::Invariant
      end,
      condition: operand_bool(true),
      message: msg,
      span: c.span
    },
    cond_op
  ), c.span)
end

# Lower the drop-before-store chain for an assignment — the SEMANTIC
# assign_drops table (node id -> local ids; the "assign::<key>" String-key
# protocol is are not part of the model) and the assign_exact_drops table
# (the nested owning projected replacement — the exact-place drop of the
# chain's own state). Returns the continuation block where the STORE must
# happen, or None when no drop is needed (the store happens in the current
# block). `target_place` is the lowered target place of the assignment —
# the exact-place drop destroys the OLD value at that very place before
# the store.
def lower_assign_drop_chain(inout b: MirBuilder, node_id: Int, span: Span, target_place: Place) -> Option[MirBlockId]
  # (partial moves — the nested owning projected replacement): the
  # exact-place drop entries. The drop destroys the CHAIN's own state (the
  # exact target place), NOT the whole root: ONE MirDeinit of the place
  # carrying the concrete type's drop-GLUE instance (never an inline plan
  # walk here) — or, when the checker recorded consumed extensions under
  # the chain (entry.paths — the serialized relative paths in the shared
  # place_move_path_of key form), the MASKED partial-drop chain
  # (mir_emit_partial_drop_chain) that drops exactly the chain's live
  # subfields and skips the dead extensions.
  match b.finalize_plan.assign_exact_drops.get(node_id)
  when Option::Some(exact) then
    if exact.len() > 0 then
      match b.current_block
      when Option::Some(assign_blk) then
        let assign_cont = create_block(b)
        var chain_succ = assign_cont
        var ei = 0
        while ei < exact.len() do
          let entry = exact[ei]
          match b.semantic_to_mir.get(entry.local)
          when Option::Some(amid) then
            if entry.paths.len() > 0 then
              let ety = mir_place_type(&target_place, b)
              chain_succ = mir_emit_partial_drop_chain(b, &target_place, &ety, &entry.paths, chain_succ, span)
            else
              let ety2 = mir_place_type(&target_place, b)
              let glue_inst = mir_try_glue_instance(b, &ety2)
              match glue_inst
              when Option::Some(inst) then
                let bk = create_block(b)
                switch_to_block(b, bk)
                set_terminator(b, MirTerminatorKind::MirDeinit {
                  place: target_place.clone(),
                  deinit_fn: inst,
                  target: chain_succ,
                  unwind: Option::None
                }, span)
                chain_succ = bk
              when Option::None then ()
              end
            end
          when Option::None then
            b.errors.push("internal error: assign exact-drop plan references semantic local _" + entry.local.to_string() + " with no MIR local")
          end
          ei = ei + 1
        end
        switch_to_block(b, assign_blk)
        set_terminator(b, MirTerminatorKind::MirGoto(chain_succ), span)
        Option::Some(assign_cont)
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when Option::None then
  match b.finalize_plan.assign_drops.get(node_id)
  when Option::Some(assign_ids) then
    if assign_ids.len() > 0 then
      match b.current_block
      when Option::Some(assign_blk) then
        let assign_cont = create_block(b)
 # each dropped old value is ONE MirDeinit carrying the
        # concrete type's drop-GLUE instance (the generated glue function —
        # never an inline plan walk here).
        var chain_succ = assign_cont
        var ai = assign_ids.len()
        while ai > 0 do
          ai = ai - 1
          let apid = assign_ids[ai]
          match b.semantic_to_mir.get(apid)
          when Option::Some(amid) then
            let aty = builder_local_typed_ty(b, &MirLocalId { id: amid })
            let glue_inst = match aty
            when Option::Some(t) then mir_try_glue_instance(b, &t)
            when Option::None then Option::None
            end
            match glue_inst
            when Option::Some(inst) then
              let bk = create_block(b)
              switch_to_block(b, bk)
              set_terminator(b, MirTerminatorKind::MirDeinit {
                place: place_local(MirLocalId { id: amid }),
                deinit_fn: inst,
                target: chain_succ,
                unwind: Option::None
              }, span)
              chain_succ = bk
            when Option::None then ()
            end
          when Option::None then
            b.errors.push("internal error: assign-drop plan references semantic local _" + apid.to_string() + " with no MIR local")
          end
        end
        switch_to_block(b, assign_blk)
        set_terminator(b, MirTerminatorKind::MirGoto(chain_succ), span)
        Option::Some(assign_cont)
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when Option::None then Option::None
  end
  end
end

def lower_block(inout b: MirBuilder, block: Block) -> Unit
 # this lexical block is a defer scope while its statements are
  # lowered (the checker's check_block pushes its key onto defer_chain).
  # Loop bodies were already pushed NEGATED by the loop lowering
  # (check_loop_body parity: the body scope appears once, negated, so the
  # break/continue/backedge walks stop exactly at the loop boundary) — the
  # positive push is skipped when the chain top is the negated same key.
  let block_key = if block.stmts.len() > 0 then block.stmts[0].node_id else 0 end
  var scope_pushed = false
  if block_key != 0 then
    let chain_top = if b.defer_scope_chain.len() > 0 then b.defer_scope_chain[b.defer_scope_chain.len() - 1] else 0 end
    if chain_top != 0 - block_key then
      b.defer_scope_chain.push(block_key)
      scope_pushed = true
    end
  end
  for stmt in block.stmts do
    lower_stmt(b, &stmt)
  end
  # Materialize the SEMANTIC block-exit obligations: the NORMAL edge's
  # CleanupEdge actions — this scope's RunDefer actions (LIFO), then the
  # Drop actions for the locals created inside this lexical block that
  # must be finalized when the block ends. The current MIR block's
  # terminator target becomes the end of the cleanup chain; blocks whose
  # terminator is not a plain Goto (e.g. calls with success blocks) defer
 # to the function-level return-path cleanup. the actions come
  # from the CleanupEdge table (lookup_cleanup_edge by (Normal, block key))
 # — the "block::<block key>" string-key serialization is not part of the model;
  # synthesized blocks that never had a checker edge get no emission.
  if block_key != 0 then
    match lookup_cleanup_edge(b, CfgEdgeKind::Normal, block_key)
    when Option::Some(actions) then
      if actions.len() > 0 then
        match b.current_block
        when Option::Some(cur_blk) then
          let old_target = match b.blocks[cur_blk.id].terminator.kind
          when MirTerminatorKind::MirGoto(target) then Option::Some(target)
          when MirTerminatorKind::MirReturn then Option::None
          when _ then Option::None
          end
          match old_target
          when Option::Some(tgt) then
 # THIS scope's deferred actions run first on the block's
            # fallthrough exit (LIFO), then the edge's drops, then the
            # block's continuation — the checker's record_block_exit_plan
            # records the RunDefer actions for this scope, so the defer
            # emission is scoped to the block key.
            let chain_succ = emit_cleanup_chain(b, &actions, tgt, block.span, -1)
            switch_to_block(b, cur_blk)
            set_terminator(b, MirTerminatorKind::MirGoto(chain_succ), block.span)
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  if scope_pushed then
    b.defer_scope_chain.pop()
  end
end

def normalize_method_name(method_name: String) -> String
  if method_name.starts_with(".") && method_name.len() > 1 then
    method_name.slice(1, method_name.len())
  elsif method_name == "." then
    ""
  else
    method_name
  end
end

def lookup_current_local_id_by_name(b: MirBuilder, name: String) -> Option[MirLocalId]
  # `var_map` tracks the binding currently visible in the active lexical
  # scope.  `add_local` inserts/overwrites here on each binding, and
  # `lower_match` snapshots/restores it around every arm so that bindings
  # introduced in one arm do not leak into sibling arms.
  match b.var_map.get(&name)
  when Option::Some(id) then Option::Some(MirLocalId { id: id.id })
  when Option::None then Option::None
  end
end

def lookup_local_type_by_name(b: MirBuilder, name: String) -> Type
  match lookup_current_local_id_by_name(b, name)
  when Option::Some(local_id) then lookup_local_type(b, &local_id)
  when Option::None then Type::Unit
  end
end

def mir_lookup_fn_ret_type(b: MirBuilder, fn_name: String) -> Type
  match b.fn_ret_types.get(&fn_name)
  when Option::Some(ret_type) then ret_type.clone()
  when Option::None then Type::Unit
  end
end

def fn_param_types_of(param_types: Vec[Type]) -> Vec[ParamType]
  var result = Vec::new()
  var param_idx = 0
  while param_idx < param_types.len() do
    result.push(ParamType { ty: param_types[param_idx].clone(), convention: AccessConvention::Let })
    param_idx = param_idx + 1
  end
  result
end

def convention_access_effect(convention: AccessConvention) -> AccessEffect
  match convention
  when AccessConvention::Let then AccessEffect::Read
  when AccessConvention::Inout then AccessEffect::Modify
  when AccessConvention::Sink then AccessEffect::Consume
  when AccessConvention::Set then AccessEffect::Initialize
  end
end

# PHASE-1 (items 57/13) + (phase 2) + the closure-call effects
# batch + the variant-payload batch: the TypedCallArg effects of the call's
# recorded TypedCall (TypedExprKind::Call) are the PRIMARY authority for a
# SOURCE call's argument effects — the TypedCall is the authority for the
# call's identity AND effects; the flat access_effects (node id -> effect,
# the checker's record for EVERY source call argument — the direct-call
# arguments (record_arg_effect), the method receiver and arguments, the
# closure-call arguments (the callee's Type::Closure/FnPtr conventions), the
# capture nodes, and the ExprEnumVariant payload args (the Consume records))
# is the fallback for the nodes the checker did not record in the node form.
# The SOURCE-ARG effects are the typed authority: a missing effect for a
# SOURCE argument is the internal error below — never a re-derived
# convention and never a silent Read, regardless of the callee shape
# (direct callee, static path, or method). The convention/Read derivation
# below is the node_id-0 synthesized-IR carve-out — the checker records no
# effects for synthesized nodes — and it is the ONLY fallback. typed_arg_idx
# indexes the TypedCallArg vector (the EXPLICIT argument position — the
# method receiver is not part of TypedCall.args); pass typed_arg_idx = -1
# for a method receiver, whose effect is TypedCall.receiver_effect.
def call_arg_effect(inout b: MirBuilder, callee: Option[Expr], arg_idx: Int, arg_expr: Expr, call_node_id: Int, typed_arg_idx: Int) -> AccessEffect
  match b.typed_exprs.get(call_node_id)
  when Option::Some(te) then
    match te.kind
    when TypedExprKind::Call(tc) then
      if typed_arg_idx >= 0 then
        if typed_arg_idx < tc.args.len() then
          return tc.args[typed_arg_idx].effect
        end
      else
        match tc.receiver_effect
        when Option::Some(eff) then return eff
        when Option::None then ()
        end
      end
    when _ then ()
    end
  when Option::None then ()
  end
  match b.access_effects.get(arg_expr.node_id)
  when Option::Some(e) then e
  when Option::None then
    # PHASE-1 (item 13) + the closure-call effects batch + the
    # variant-payload batch: the checker records an access effect for
    # EVERY source call argument — the direct-call arguments (the
    # callee's conventions), the method-call receiver and arguments, the
    # closure-call arguments (the callee's Type::Closure/FnPtr conventions),
    # the capture nodes, and the ExprEnumVariant payload args (the
    # Consume records) — so a SOURCE argument with a missing effect is an
    # internal error — never a re-derived convention and never a silent
    # Read, regardless of the callee shape. The source-arg effects are
    # the TYPED AUTHORITY; the node_id-0 synthesized-IR carve-out below
    # (the convention/Read derivation — the checker records no effects
    # for synthesized nodes) is the ONLY fallback.
    if arg_expr.node_id != 0 then
      b.errors.push("internal error: missing typed access effect for argument node " + arg_expr.node_id.to_string() + " during MIR lowering")
    end
    if arg_expr.node_id == 0 then
      match callee
      when Option::Some(c) then
        match b.expr_types.get(c.node_id)
        when Option::Some(t) then
          match t
          when Type::FnPtr(params, _, _) then
            if arg_idx < params.len() then
              convention_access_effect(params[arg_idx].convention)
            else
              AccessEffect::Read
            end
          when Type::Closure(_, params, _, _, _) then
            if arg_idx < params.len() then
              convention_access_effect(params[arg_idx].convention)
            else
              AccessEffect::Read
            end
          when _ then AccessEffect::Read
          end
        when Option::None then AccessEffect::Read
        end
      when Option::None then AccessEffect::Read
      end
    else
      AccessEffect::Read
    end
  end
end

# the owned conversion of a string LITERAL argument — the
# static StaticStrPtr (the interned label) becomes an OWNED String object via
# the string_from_static intrinsic. Emitted as a call into a fresh temp;
# the current block is terminated by the call and the builder resumes in
# the success block, so the caller's arg list continues in the new block.
def lower_string_literal_to_owned(inout b: MirBuilder, arg_expr: Expr, span: Span) -> MirOperand
  let tmp = add_temp(b, Type::String, span)
  let success_blk = create_block(b)
  let callee_op = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("string_from_static".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::String), Vec::new()),
      instance: Option::None
    })
  }
  let lit_op = lower_expr(b, arg_expr, span)
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(tmp),
    func: callee_op,
    args: vec![MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(lit_op) }],
    success: success_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(success_blk)
  MirOperand { kind: MirOperandKind::MirCopy(place_local(tmp)) }
end

# the owned-String demand rule. A string LITERAL argument is the
# static StaticStrPtr (raw label). It converts to an OWNED String object
# (string_from_static — the owned clone) exactly when the callee's declared
# parameter at this position is a BY-VALUE String: the callee's body will
# treat the value as a String object (clone/push/len/...), so the raw label
# must never cross into the object ABI. A &str (RefInternal) parameter keeps
# the literal's raw form. Enumerated consumers: the diagnostics (panic /
# assert / error messages), the format strings (eprintln concat operands),
# the path strings (read_file_to_string_native, cstring_new), and every
# other by-value String parameter.
def mir_call_arg_needs_owned_string(b: MirBuilder, callee_name: Option[String], arg_idx: Int, arg_expr: Expr) -> Bool
  if expr_kind_name(&arg_expr.kind) != "ExprStringLit" then
    return false
  end
  match callee_name
  when Option::Some(cn) then
    match b.fn_param_types.get(&cn)
    when Option::Some(ptys) then
      if arg_idx < ptys.len() && ptys[arg_idx] == Type::String then
        return true
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  false
end

def lower_call_arg(inout b: MirBuilder, callee: Option[Expr], callee_name: Option[String], arg_idx: Int, arg_expr: Expr, span: Span, call_node_id: Int, typed_arg_idx: Int) -> MirCallArg
  let effect = call_arg_effect(b, callee, arg_idx, arg_expr, call_node_id, typed_arg_idx)
  let kind_name = expr_kind_name(&arg_expr.kind)
  var value = MirCallValue::Value(operand_unit())
  if mir_call_arg_needs_owned_string(b, callee_name, arg_idx, arg_expr) then
 # the literal is demanded as an OWNED String — the static
    # StaticStrPtr goes through the owned conversion.
    value = MirCallValue::Value(lower_string_literal_to_owned(b, arg_expr, span))
  elsif kind_name == "ExprAccess" then
    match arg_expr.kind
    when ExprKind::ExprAccess(inner) then value = MirCallValue::Place(lower_place(b, &inner))
    when _ then ()
    end
  elsif effect == AccessEffect::Consume then
    if expr_is_place_like(arg_expr) then
      value = MirCallValue::Place(lower_place(b, arg_expr))
    else
      value = MirCallValue::Value(lower_expr(b, arg_expr, span))
    end
  else
    value = MirCallValue::Value(lower_expr(b, arg_expr, span))
  end
  MirCallArg { effect: effect, value: value }
end

def mir_call_result_temp_type(ret_type: Type) -> Type
  if ret_type == Type::Unit then Type::Int else ret_type end
end

def qualify_field_callee_name(expr: Expr, field_name: String) -> String
  match expr.kind
  when ExprKind::ExprIdent(name) then
    name.clone() + "::" + field_name
  when ExprKind::ExprFieldAccess(base, inner_field) then
    qualify_field_callee_name(&base, inner_field.clone()) + "::" + field_name
  when ExprKind::ExprPath(path) then
    var qualified = ""
    for seg in path.segments do
      if qualified != "" then qualified = qualified + "::" end
      qualified = qualified + seg.clone()
    end
    qualified + "::" + field_name
  else
    field_name
  end
end

# the call-result inference is not part of the model. Source call nodes read their
# result type from the typed tree at the lowering site (mir_source_expr_ty —
# fail-closed on a missing entry); synthesized calls (node_id 0) get the
# callee's REGISTERED declared return type at the construction site
# (mir_lookup_fn_ret_type — the declared type, never a shape re-derivation).
# The name-guessing tables (infer_qualified_ident_result_type /
# infer_static_path_result_type fallbacks) are gone.

def mir_fn_operand(b: MirBuilder, fn_name: String) -> MirOperand
  mir_fn_operand_with_instance(b, fn_name, Option::None)
end

# Build a MirFnItem operand with the optional semantic instance payload
#. `instance` is the call's InstanceId (DefId + substs) when the
# typed call_targets recorded one; Option::None keeps the name-only form
# for synthesized IR-only callees.
# the MirFnItem NAME is the emission name — the instance's
# fn_owner_key_of_def base when the instance carries a top-level-function DefId
# (mir_callee_emission_name), so the call reference matches the callee's
# emitted name; the return type is looked up under the SAME emission name.
def mir_fn_operand_with_instance(b: MirBuilder, fn_name: String, instance: Option[InstanceId]) -> MirOperand
  let emission_name = mir_callee_emission_name(b, fn_name.clone(), instance)
  let ret_type = mir_lookup_fn_ret_type(b, emission_name.clone())
  MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem(emission_name),
      ty: Type::FnPtr(Vec::new(), Box::new(ret_type), Vec::new()),
      instance: instance
    })
  }
end

# (item 61): the TYPED variant identity (ids.tg VariantId) of an
# enum-variant path: owner = the enum's semantic TypeId (via type_name_to_id
# — the typed program's type-names inverse, the ONE TypeId universe), index =
# the variant's position in the typed variant table (typed_type_variants —
# the checker's TypeId -> (name, field types, discriminant) record, in
# declaration order). The VariantId IS the semantic variant identity the
# discriminant resolution and the source-derived downcasts (Projection::
# Variant) must use; the variant NAME is used only to find the index. None
# when the enum/variant is absent from the typed tables (never guessed).
def typed_variant_id(b: MirBuilder, enum_name: String, variant_name: String) -> Option[VariantId]
  match b.type_name_to_id.get(enum_name)
  when Option::Some(type_id) then
    match b.typed_type_variants.get(type_id)
    when Option::Some(variants) then
      var vi = 0
      while vi < variants.len() do
        if enum_variant_name_matches(&variants[vi].0, variant_name) then
          return Option::Some(VariantId { owner: TypeId { id: type_id }, index: vi as UInt })
        end
        vi = vi + 1
      end
      Option::None
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# (item 61): the raw Adt TypeId of a type (peeling only refs/pointers
# — NOT the Box/Rc/Option arg-unwrap of unwrap_to_named_tid): the enum
# identity a VariantId.owner is compared against. Box/Rc/Option REMAIN Adt
# types here: matching `Option::Some(x)` on an Option[Int] scrutinee must see
# the Option Adt's TypeId, not the unwrapped Int.
def mir_enum_owner_tid(b: MirBuilder, ty: Type) -> Option[TypeId]
  match ty
  when Type::Adt(tid, _) then Option::Some(tid)
  when Type::RefInternal(inner, _) then mir_enum_owner_tid(b, inner)
  when Type::Ptr(inner) then mir_enum_owner_tid(b, inner)
  when Type::PtrMut(inner) then mir_enum_owner_tid(b, inner)
  when _ then Option::None
  end
end

def resolve_enum_variant_discriminant(b: MirBuilder, path: AstPath) -> Result[Int, String]
  if path.segments.len() < 2 then
    return Result::Err("internal error: enum variant path needs at least two segments")
  end

  let enum_name = path.segments[path.segments.len() - 2].clone()
  let variant_name = path.segments[path.segments.len() - 1].clone()

 # PRIMARY source is the typed program's type_variants (semantic
  # TypeId -> (variant name, field types, discriminant)) — the variant
  # identity is carried by the typed program, so MIR must not guess it from
  # MIR-side scans. Look up the enum's semantic TypeId, then the variant by
  # name, and use ITS discriminant.
 # (item 61): the lookup is now VARIANTID-FIRST — the typed variant
  # identity (owner TypeId + variant index) is consulted first and the
  # discriminant is read through it (the variant at index vid.index of the
  # typed table), so the discriminant decision keys on the semantic
  # identity, not on a name/discriminant re-scan.
  match typed_variant_id(b, &enum_name, &variant_name)
  when Option::Some(vid) then
    match b.typed_type_variants.get(vid.owner.id)
    when Option::Some(variants) then
      if vid.index as Int < variants.len() then
        return Result::Ok(variants[vid.index as Int].2)
      end
    when Option::None then ()
    end
  when Option::None then ()
  end

  # FALLBACK: MIR-side def scan (AST-derived tables / MirTypeDefs). This
  # ERRORS when the variant is genuinely absent instead
  # of silently producing discriminant 0.
  match b.enum_variant_discriminants.get(enum_variant_discriminant_key(&enum_name, &variant_name))
  when Option::Some(disc) then return Result::Ok(disc)
  when Option::None then ()
  end

  match b.type_name_to_id.get(enum_name.clone())
  when Option::Some(type_id) then
    for td in b.type_defs do
      if td.id.id == type_id then
        match td.kind
        when MirTypeDefKind::Enum(variants) then
          for variant in variants do
            if enum_variant_name_matches(&variant.name, &variant_name) then
              return Result::Ok(variant.discriminant)
            end
          end
        when _ then ()
        end
      end
    end
  when Option::None then ()
  end

  match b.enum_variants.get(enum_name.clone())
  when Option::Some(variants) then
    var disc = 0
    for variant in variants do
      if enum_variant_name_matches(&variant, &variant_name) then
        return Result::Ok(disc)
      end
      disc = disc + 1
    end
  when Option::None then ()
  end

  Result::Err("internal error: unknown enum variant '" + enum_name + "::" + variant_name + "' during MIR lowering")
end

# resolve a variant discriminant, and on genuine absence record the
# internal error and return the given defensive fallback. Never SILENT:
# every fallback value is accompanied by an error that aborts lowering at
# lower_program's error drain, so no unknown variant can compile to a
# guessed discriminant.
def resolve_enum_variant_discriminant_or(inout b: MirBuilder, path: AstPath, fallback: Int) -> Int
  var found = fallback
  match resolve_enum_variant_discriminant(b, path)
  when Result::Ok(d) then found = d
  when Result::Err(e) then
    b.errors.push(e)
  end
  found
end

# ———————————————————————————————————————————————————————————————
# Typed-HIR consumption helpers (— phase 2: the recursive tree)
# ———————————————————————————————————————————————————————————————
#
# The typed node form (b.typed_exprs, the checker's one-TypedExpr-per-source-
# node record) is the PRIMARY consumer interface for the expression type,
# the call identity/effects, the field identity, and the variant identity;
# the flat maps are the DERIVED INDEXES — the fallback for the nodes the
# checker recorded in the flat maps but NOT in the node form (the
# typed-call assembly failure class — the recording site's ICE on a call
# whose TypedCall cannot be assembled). The tree carries the STRONG
# identities directly (TypedCallee::Def(CallableId), TypedField.field
# (FieldId), TypedVariant.variant (VariantId)) — no numeric transitions
# and no decoding.

# The TypedCall recorded for a call node (the TypedExprKind::Call payload).
# Option::None when the node has no TypedExpr or its kind is not Call — the
# flat call_def_ids / access_effects fallback then applies.
def typed_call_of(b: MirBuilder, node_id: Int) -> Option[TypedCall]
  match b.typed_exprs.get(node_id)
  when Option::Some(te) then
    match te.kind
    when TypedExprKind::Call(tc) then Option::Some(tc)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# The expression type from the typed node form (TypedExpr.ty) with the flat
# expr_types as the fallback for the nodes the checker recorded only in the
# flat map. Option::None when BOTH miss — the callers' missing-entry ICEs
# cover that class.
def typed_expr_ty(b: MirBuilder, node_id: Int) -> Option[Type]
  match b.typed_exprs.get(node_id)
  when Option::Some(te) then Option::Some(te.ty)
  when Option::None then
    match b.expr_types.get(node_id)
    when Option::Some(ty) then Option::Some(ty)
    when Option::None then Option::None
    end
  end
end

# The typed iteration record of a for-statement: TypedIteration { plan }
# (resource_check.tg) keyed by the for-stmt node id — the SAME join key the
# typed statement tree carries (TypedStmtKind::For.iteration, types.tg).
# Option::None only for IR-only / synthesized for-stmts that never passed
# through the checker (lower_for's heuristic covers those).
def typed_iteration_of(b: MirBuilder, node_id: Int) -> Option[TypedIteration]
  match b.typed_iterations.get(node_id)
  when Option::Some(ti) then Option::Some(ti)
  when Option::None then Option::None
  end
end

# The FieldId from the typed node form (TypedExprKind::Field's TypedField —
# the strong identity the checker recorded directly). Option::None when the
# node has no TypedExpr or its kind is not Field — the flat field_targets
# fallback then applies (the TupleIndex form is handled by the callers
# that understand the non-FieldId access forms).
def typed_field_id_of(b: MirBuilder, node_id: Int) -> Option[FieldId]
  match b.typed_exprs.get(node_id)
  when Option::Some(te) then
    match te.kind
    when TypedExprKind::Field(tf) then Option::Some(tf.field)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# The VariantId from the typed node form (TypedExprKind::Variant's
# TypedVariant — the strong identity the checker recorded directly; the
# numeric-transition decoding is gone).
def typed_variant_id_of(b: MirBuilder, node_id: Int) -> Option[VariantId]
  match b.typed_exprs.get(node_id)
  when Option::Some(te) then
    match te.kind
    when TypedExprKind::Variant(tv) then Option::Some(tv.variant)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# The semantic local id from the typed node form (TypedExprKind::Local).
# Option::None when the node has no TypedExpr or its kind is not Local
# (global callables and bare variant names are not Local shapes) — the flat
# ident_resolutions fallback then applies.
def typed_local_id_of(b: MirBuilder, node_id: Int) -> Option[Int]
  match b.typed_exprs.get(node_id)
  when Option::Some(te) then
    match te.kind
    when TypedExprKind::Local(lid) then Option::Some(lid)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# A variant construction's discriminant: the TypedExprKind::Variant's
# variant id is the authority for a recorded source construction (the
# discriminant is read THROUGH the VariantId from the typed variant table);
# resolve_enum_variant_discriminant — itself VariantId-first with the
# MIR-side def scans as the documented fallback — covers the unrecorded
# nodes.
def resolve_construction_variant_discriminant(b: MirBuilder, path: AstPath, node_id: Int) -> Result[Int, String]
  match typed_variant_id_of(b, node_id)
  when Option::Some(vid) then
    match b.typed_type_variants.get(vid.owner.id)
    when Option::Some(variants) then
      if vid.index as Int < variants.len() then
        return Result::Ok(variants[vid.index as Int].2)
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  resolve_enum_variant_discriminant(b, path)
end

# A variant construction's enum TypeId: the TypedExprKind::Variant's owner
# is the authority; type_name_to_id (the typed type-names inverse, the ONE
# TypeId universe) is the fallback.
def construction_enum_tid(b: MirBuilder, node_id: Int, enum_name: String) -> Option[TypeId]
  match typed_variant_id_of(b, node_id)
  when Option::Some(vid) then Option::Some(vid.owner)
  when Option::None then
    match b.type_name_to_id.get(enum_name)
    when Option::Some(tid) then Option::Some(TypeId { id: tid })
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Typed-tree reads and place typing (the inference family is are not part of the model)
# ———————————————————————————————————————————————————————————————
#
# The per-shape AST reconstruction (the expression-type inference, the
# call-result / field / container / builtin-aggregate inference, and the
# block-result inference) is not part of the model. Two rules replace it:
#   - SOURCE nodes (node_id != 0) read their type from the typed HIR — the
#     typed node form (b.typed_exprs — the checker's one-TypedExpr-per-node
#     recursive tree), with the flat expr_types as the derived-index fallback
#     for the nodes the checker recorded only in the flat map. A source node
#     with a typed entry in NEITHER is an internal error (fail-closed —
#     mir_source_expr_ty records the error and the lowering aborts at
#     lower_program's error drain).
#   - SYNTHESIZED IR is constructed ALREADY-TYPED: the lowering knows the
#     types of the IR it creates (element types, result types, temp types)
#     and passes them to add_temp/add_local directly — no inference pass
#     runs over synthesized shapes.
#
# The intra-MIR place walk below is NOT semantic reconstruction: it types an
# already-lowered Place (a base MirLocalId + semantic projections) by
# resolving the local's declared type through the projection chain.

# The fail-closed typed-tree read for a SOURCE expression: the typed node
# form (TypedExpr.ty) is the authority, the flat expr_types is the
# derived-index fallback, and a missing entry in BOTH is an internal error.
# Synthesized nodes (node_id == 0) must never reach this read — their types
# are carried by the construction site — so reaching it is itself an
# internal error (fail-closed).
def mir_source_expr_ty(b: MirBuilder, expr: Expr) -> Type
  if expr.node_id == 0 then
    b.errors.push("internal error: synthesized expression node reached the typed-tree read during MIR lowering (synthesized IR must carry its type at the construction site)")
    return Type::Unit
  end
  match b.typed_exprs.get(expr.node_id)
  when Option::Some(te) then
    te.ty.clone()
  when Option::None then
    match b.expr_types.get(expr.node_id)
    when Option::Some(ty) then ty
    when Option::None then
      b.errors.push("internal error: missing typed expression for source node " + expr.node_id.to_string() + " during MIR lowering (the typed tree is the authority)")
      Type::Unit
    end
  end
end

# The type at the end of a place's projection chain: the base local's
# declared type resolved through the (semantic) projections. Mechanical
# intra-MIR typing — the projections were constructed typed; this only
# follows them.
def mir_place_type(place: Place, b: MirBuilder) -> Type
  let base_ty = lookup_local_type(b, &place.local)
  resolve_type_through_projections(b, base_ty, &place.projections)
end

# The nominal TypeId of the Adt a place's EXISTING projection chain ends at
# (before appending more projections): the base local's declared type
# resolved through the chain, peeled ONLY through refs/pointers — the Adt
# at the projection point IS the projection target itself (Box/Rc/Option
# REMAIN their own Adt here: a VariantId.owner is the ENUM's TypeId —
# Option[Int] is the Option Adt, never the unwrapped Int — exactly like
# mir_enum_owner_tid; unwrap_to_named_tid is NOT used). The
# FieldId.owner / VariantId.owner the synthesized projections must carry —
# the lowering knows the field/variant because it knows the type at the
# projection point.
def mir_place_current_tid(b: MirBuilder, place: Place) -> Option[TypeId]
  let base_ty = lookup_local_type(b, &place.local)
  let cur_ty = resolve_type_through_projections(b, base_ty, &place.projections)
  var t = cur_ty
  var done = false
  while !done do
    match t
    when Type::RefInternal(inner, _) then t = inner
    when Type::Ptr(inner) then t = inner
    when Type::PtrMut(inner) then t = inner
    when _ then done = true
    end
  end
  match t
  when Type::Adt(tid, _) then Option::Some(tid)
  when _ then Option::None
  end
end

# The typed VariantId of a variant BY NAME within a nominal type: the typed
# variant table (semantic TypeId -> (name, fields, discriminant) in
# declaration order — the checker's record) is the ONLY index source; the
# variant's index IS its declaration order, never the discriminant. A
# variant absent from the typed table is Option::None — the caller records
# the internal error, never a guessed index.
def mir_variant_id_by_name(b: MirBuilder, owner: TypeId, variant_name: String) -> Option[VariantId]
  match b.typed_type_variants.get(owner.id)
  when Option::Some(variants) then
    var vi = 0
    while vi < variants.len() do
      if enum_variant_name_matches(&variants[vi].0, variant_name) then
        return Option::Some(VariantId { owner: TypeId { id: owner.id }, index: vi as UInt })
      end
      vi = vi + 1
    end
    Option::None
  when Option::None then Option::None
  end
end


# The FieldId of a field of the nominal type at a place's EXISTING
# projection chain — the synthesized drop glue's field projections and the
# match-arm payload guards. Owner = the type at the projection point (the
# lowering knows the aggregate it is projecting into); index = the field's
# index. Fail-closed: a missing nominal identity records an internal error
# (the lowering aborts at the error drain) and returns a defensive id so
# the glue stays shaped — never a silently guessed owner.
def mir_synth_field(b: MirBuilder, place: Place, index: Int, what: String) -> FieldId
  match mir_place_current_tid(b, place)
  when Option::Some(tid) then FieldId { owner: TypeId { id: tid.id }, index: index }
  when Option::None then
    b.errors.push("internal error: cannot resolve the nominal type of a synthesized field place during MIR lowering (" + what + ")")
    FieldId { owner: TypeId { id: -1 }, index: index }
  end
end

# The VariantId of a variant of the type at a place's EXISTING projection
# chain — the synthesized drop glue's downcasts (Option::Some, Result
# Ok/Err, enum variants, the drain payloads). The typed variant table is
# the ONLY index source (declaration order — never the discriminant).
# Fail-closed like mir_synth_field.
def mir_synth_variant(b: MirBuilder, place: Place, variant_name: String, what: String) -> VariantId
  match mir_place_current_tid(b, place)
  when Option::Some(tid) then
    match mir_variant_id_by_name(b, tid, variant_name)
    when Option::Some(vid) then vid
    when Option::None then
      b.errors.push("internal error: variant '" + variant_name.clone() + "' absent from the typed variant table during MIR lowering (" + what + ")")
      VariantId { owner: TypeId { id: tid.id }, index: 0 }
    end
  when Option::None then
    b.errors.push("internal error: cannot resolve the nominal type of a synthesized downcast place during MIR lowering (" + what + ")")
    VariantId { owner: TypeId { id: -1 }, index: 0 }
  end
end

def lower_pattern_place_assignment(inout b: MirBuilder, pat: Pattern, source: Place, span: Span) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    let ty = mir_place_type(&source, b)
    let local_id = add_local(b, name.clone(), ty, is_mut, span)
    record_semantic_pattern_local(b, pat, local_id, "pattern binding")
    push_assign(b, place_local(local_id), move_rvalue(operand_copy(source)), span)
  when PatternKind::Tuple(pats) then
    var idx = 0
    for p in pats do
      var field_place = duplicate_place(&source)
      field_place.projections.push(Projection::TupleIndex(idx))
      lower_pattern_place_assignment(b, &p, field_place, span)
      idx = idx + 1
    end
  when PatternKind::Wildcard then ()
  when _ then ()
  end
end

def lower_pattern_assignment(inout b: MirBuilder, pat: Pattern, rvalue: MirRvalue, rvalue_ty: Type, span: Span) -> Unit
 # the rvalue-shape inference is are not part of the model — the caller carries the
  # rvalue's type (the typed tree for source nodes, the construction site
  # for synthesized rvalues).
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    let local_id = add_local(b, name.clone(), rvalue_ty.clone(), is_mut, span)
    record_semantic_pattern_local(b, pat, local_id, "pattern binding")
    push_assign(b, place_local(local_id), duplicate_rvalue(rvalue), span)
  when PatternKind::Tuple(pats) then
    let temp = add_temp(b, rvalue_ty.clone(), span)
    push_assign(b, place_local(temp), duplicate_rvalue(rvalue), span)
    var idx = 0
    for p in pats do
      var projs = Vec::new()
      projs.push(Projection::TupleIndex(idx))
      let field_place = Place { local: temp, projections: projs }
      let field_rvalue = move_rvalue(operand_copy(field_place))
      # The element's type is the place walk of the JUST-CONSTRUCTED
      # TupleIndex projection (mechanical intra-MIR typing — the tuple's
      # type is the temp's declared type).
      let field_ty = mir_place_type(&field_place, b)
      lower_pattern_assignment(b, &p, &field_rvalue, &field_ty, span)
      idx = idx + 1
    end
  when PatternKind::Wildcard then ()
  when _ then ()
  end
end

def bind_match_arm_pattern_locals(inout b: MirBuilder, scrut_local: MirLocalId, pat: Pattern, span: Span) -> Unit
  let scrut_ty = lookup_local_type(b, &scrut_local)
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    let local = add_local(b, name.clone(), scrut_ty, is_mut, span)
    record_semantic_pattern_local(b, pat, local, "match binding")
    push_assign(b, place_local(local), move_rvalue(operand_copy_local(scrut_local)), span)
  when PatternKind::Variant(path, sub_pats) then
    let variant_name = if path.segments.len() > 0 then
      path.segments[path.segments.len() - 1].clone()
    else
      ""
    end
 # the downcast is ALWAYS the typed VariantId — the scrutinee's
    # enum owner TypeId + the variant's declaration-order index from the
    # typed variant table. A source match arm whose variant the typed
    # tables cannot resolve is an internal error (fail-closed); the
    # name/discriminant fallback (ProjDowncast) is are not part of the model. The payload
    # fields are Field(FieldId) with the scrutinee enum's TypeId.
    let scrut_tid = mir_enum_owner_tid(b, &scrut_ty)
    let path_enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2].clone() else "" end
    var variant_proj = Projection::Variant(VariantId { owner: TypeId { id: -1 }, index: 0 })
    match scrut_tid
    when Option::Some(stid) then
      match typed_variant_id(b, &path_enum_name, &variant_name)
      when Option::Some(vid) then
        if vid.owner.id == stid.id then
          variant_proj = Projection::Variant(vid)
        else
          b.errors.push("internal error: variant '" + variant_name.clone() + "' owner does not match the scrutinee's enum TypeId during MIR lowering")
        end
      when Option::None then
        b.errors.push("internal error: missing typed variant identity for pattern variant '" + variant_name.clone() + "' during MIR lowering")
      end
    when Option::None then
      b.errors.push("internal error: missing typed scrutinee enum identity for pattern variant '" + variant_name.clone() + "' during MIR lowering")
    end

    let payload_fid = match scrut_tid
    when Option::Some(stid2) then FieldId { owner: TypeId { id: stid2.id }, index: 0 }
    when Option::None then FieldId { owner: TypeId { id: -1 }, index: 0 }
    end
    var field_idx = 0
    for sp in sub_pats do
      match sp.kind
      when PatternKind::Ident(name, is_mut) then
        var payload_place = place_local(scrut_local)
        payload_place.projections.push(variant_proj)
        let payload_fid_at = FieldId { owner: TypeId { id: payload_fid.owner.id }, index: field_idx }
        payload_place.projections.push(Projection::Field(payload_fid_at))
        let local_ty = mir_place_type(&payload_place, b)
        let local = add_local(b, name.clone(), local_ty, is_mut, span)
        record_semantic_pattern_local(b, sp, local, "variant match binding")
        push_assign(b, place_local(local), move_rvalue(operand_copy(payload_place)), span)
      when _ then ()
      end
      field_idx = field_idx + 1
    end
  when _ then ()
  end
end

# the ONE CleanupEdge lookup — the edge's cleanup actions by its
# (kind, source) semantic identity. The resource checker's pre-built CFG
# records every transfer; the edge's index in cfg.edges IS its CfgEdgeId,
# and cfg.cleanup[i] is its CleanupEdge (one record per edge, actions in
# execution order: EndAccess actions first — the accesses the transfer
# performed, which the checker's EndAccess actions carry — then RunDefer
# actions (the exited scopes' defers, LIFO), then Drop actions (the live
# owning locals, reverse drop order)). The String-keyed serializations
# (the "edge::..." edge_cleanup map and the "return::<id>"/"break::<id>"/
# "continue::<id>"/"backedge::<id>"/"block::<id>" finalize_plan keys) are
# is not part of the model — a lookup miss means a synthesized/IR-only edge that never had
# a checker record (the builder-side defer registrations are that
# fallback).
def lookup_cleanup_edge(b: MirBuilder, kind: CfgEdgeKind, source: Int) -> Option[Vec[CleanupAction]]
  var i = 0
  while i < b.cfg.edges.len() do
    let e = b.cfg.edges[i]
    if e.kind == kind && e.source == source then
      if i < b.cfg.cleanup.len() then
        return Option::Some(b.cfg.cleanup[i].actions.clone())
      end
      return Option::None
    end
    i = i + 1
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# (partial moves — place-level state): the PARTIAL-DROP CHAIN.
#
# A partially-moved value (the semantic registry — TypedProgram.place_move_
# states, mirrored in b.place_move_states — records the consumed field
# paths of a root local) must be dropped by its LIVE FIELDS ONLY. The
# chain below emits, per DIRECT field of the value's concrete type:
#   - a consumed field (a depth-1 path): NOTHING (its storage is dead);
#   - a live field with no nested paths: ONE whole-value MirCall to the
#     field's concrete drop-glue (ptr, all-ones mask);
#   - a live field with nested consumed paths: the RECURSIVE chain over the
#     field's own shape (nested paths object.a.b follow the same mechanism).
# The chain is emitted at the drop sites (emit_cleanup_chain's Drop
# actions) and REPLACES the whole-value MirDeinit: the drop of the
# partially-moved value drops exactly the live fields. The mask argument
# every glue call carries is all-ones here (the site-driven chain performs
# the conditioning); the glue's mask parameter + the conditional walk
# (emit_plan_deinit's mask_local mode) is the DIRECT-call form of the same
# conditioning.
# ———————————————————————————————————————————————————————————————

# The DIRECT field shape of a value type for the partial-drop chain: the
# field names in declaration order (struct field names; tuple positions as
# "t<i>") and the CONCRETE field types (the Adt's args substituted through
# the declaration's generic params). Unknown shapes (enums, scalars) answer
# empty — enum payload moves are whole-value in the bounded lattice.
def mir_partial_field_shape(b: MirBuilder, ty: Type) -> (Vec[String], Vec[Type], Bool)
  match ty
  when Type::FixedArray(elem, n) then
    # The fixed-array elements as the partial-drop shape: the element
    # names are the numeric indices (the serialized chain segments of
    # ProjectionKey::Index(i)) and the element types are the substituted
    # element — the per-index partial drops flow through the same
    # per-field chain machinery (the synth FieldIds align with the
    # layout's flat element list).
    var names = Vec::new()
    var tys = Vec::new()
    var i = 0
    while i < n do
      names.push(i.to_string())
      tys.push(elem.clone())
      i = i + 1
    end
    (names, tys, false)
  when Type::Tuple(fields) then
    var names = Vec::new()
    var i = 0
    while i < fields.len() do
      names.push("t" + i.to_string())
      i = i + 1
    end
    (names, fields.clone(), true)
  when Type::Adt(tid, args) then
    let def_params = match b.typed_type_params.get(tid.id)
    when Option::Some(ps) then ps.clone()
    when Option::None then Vec::new()
    end
    match b.typed_type_fields.get(tid.id)
    when Option::Some(fields2) then
      var names2 = Vec::new()
      var tys = Vec::new()
      var fi = 0
      while fi < fields2.len() do
        names2.push(fields2[fi].0.clone())
        tys.push(subst_type_args(&fields2[fi].1, &def_params, args))
        fi = fi + 1
      end
      (names2, tys, false)
    when Option::None then (Vec::new(), Vec::new(), false)
    end
  when _ then (Vec::new(), Vec::new(), false)
  end
end

# The partial-drop chain (see the section note): emits the per-live-field
# drop chain for `place` (a value of type `ty`) whose consumed field paths
# are `paths` (relative to the place — each path has >= 1 segment); returns
# the chain entry. The chain flows into `succ`.
def mir_emit_partial_drop_chain(inout b: MirBuilder, place: Place, ty: Type, paths: Vec[String], succ: MirBlockId, span: Span) -> MirBlockId
  let (field_names, field_tys, tuple_form) = mir_partial_field_shape(b, ty)
  # Decompose the paths: the depth-1 consumed set + the per-field nested
  # paths (a live field whose own subfields are consumed).
  var consumed: Set[Int] = Set::new()
  var nested: Map[Int, Vec[String]] = Map::new()
  var pi = 0
  while pi < paths.len() do
    let segs = paths[pi].split(".")
    if segs.len() >= 1 then
      var fidx = -1
      var ni = 0
      while ni < field_names.len() do
        if field_names[ni] == segs[0] then
          fidx = ni
        end
        ni = ni + 1
      end
      if fidx >= 0 then
        if segs.len() == 1 then
          consumed.insert(fidx)
        else
          var rest = Vec::new()
          var ri = 1
          while ri < segs.len() do
            rest.push(segs[ri].clone())
            ri = ri + 1
          end
          match nested.get(fidx)
          when Option::Some(existing) then
            var ext = existing.clone()
            ext.push(rest.join("."))
            nested.insert(fidx, ext)
          when Option::None then
            nested.insert(fidx, rest)
          end
        end
      end
      # An unknown segment (the shape does not contain the path): the
      # whole value is consumed — the chain emits nothing for it.
    end
    pi = pi + 1
  end
  # Emit the chain backward: field i's drop (when live) chains into the
  # next field's drop.
  var chain_succ = succ
  var fi = field_tys.len()
  while fi > 0 do
    fi = fi - 1
    if !consumed.contains(&fi) then
      match nested.get(fi)
      when Option::Some(npaths) then
        # Live field with nested consumption: the RECURSIVE chain over the
        # field's own shape (nested paths follow the same mechanism).
        let fty2 = field_tys[fi].clone()
        var fprojs = place.projections.clone()
        if tuple_form then
          fprojs.push(Projection::TupleIndex(fi))
        else
          fprojs.push(Projection::Field(mir_synth_field(b, place, fi, "partial drop")))
        end
        let fplace = Place { local: place.local, projections: fprojs }
        chain_succ = mir_emit_partial_drop_chain(b, &fplace, &fty2, &npaths, chain_succ, span)
      when Option::None then
        # Live flat field: one whole-value call to the field's drop glue.
        let fty3 = field_tys[fi].clone()
        match mir_try_glue_instance(b, &fty3)
        when Option::Some(_) then
          let fname = mir_drop_glue_name(&fty3)
          let fcallee = MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirFnItem(fname),
              ty: Type::Unit,
              instance: Option::None
            })
          }
          var fprojs2 = place.projections.clone()
          if tuple_form then
            fprojs2.push(Projection::TupleIndex(fi))
          else
            fprojs2.push(Projection::Field(mir_synth_field(b, place, fi, "partial drop")))
          end
          let fplace2 = Place { local: place.local, projections: fprojs2 }
          let fblk = create_block(b)
          switch_to_block(b, fblk)
          let fret = add_temp(b, Type::Unit, span)
          var fargs = Vec::new()
          fargs.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Place(fplace2) })
          fargs.push(MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirInt(-1),
              ty: Type::Int,
              instance: Option::None
            })
          }) })
          set_terminator(b, MirTerminatorKind::MirCall {
            dest: place_local(fret),
            func: fcallee,
            args: fargs,
            success: chain_succ,
            intrinsic: Option::None,
            unwind: Option::None
          }, span)
          chain_succ = fblk
        when Option::None then ()
        end
      end
    end
  end
  chain_succ
end

# materialize a CleanupEdge's actions into a cleanup chain ending at
# `succ`; returns the chain entry the exiting block jumps to. The actions
# are consumed in REVERSE (each step chains FORWARD into the previous one),
# so the execution order is the actions' order: EndAccess (no emission —
# the access registry is checker-side bookkeeping), then RunDefer (clone
# the defer template block registered for the StmtDefer's node id), then
# Drop (deinit the semantic local through semantic_to_mir). `skip_mir_id`
# excludes a MIR local from Drop emission (-1 for no exclusion; the
# finalizer's own self must never be re-finalized).
#
# (partial moves — the drop-site decision): the Drop action's whole-value
# destruction is the MirDeinit path UNLESS the semantic place-level registry
# (b.place_move_states — the frame's per-field states) records consumed
# paths for the local. A "*" record (whole-value consumption — enum payload
# / index projections) emits NO drop; field-path records emit the
# PARTIAL-DROP CHAIN (mir_emit_partial_drop_chain) — the live fields are
# dropped through their own concrete glues, the consumed fields are
# skipped — the drop of the partially-moved value drops exactly the live
# fields.
def emit_cleanup_chain(inout b: MirBuilder, actions: Vec[CleanupAction], succ: MirBlockId, span: Span, skip_mir_id: Int) -> MirBlockId
  var chain_succ = succ
  var ai = actions.len()
  while ai > 0 do
    ai = ai - 1
    match actions[ai]
    when CleanupAction::Drop(lid) then
      match b.semantic_to_mir.get(lid.id)
      when Option::Some(mid) then
        if mid != skip_mir_id then
          let dty = builder_local_typed_ty(b, &MirLocalId { id: mid })
 # the Drop action's whole-value destruction is ONE MirDeinit
          # carrying the concrete type's drop-GLUE instance (the generated
          # glue function — never an inline plan walk here).
          let dglue = match dty
          when Option::Some(t) then mir_try_glue_instance(b, &t)
          when Option::None then Option::None
          end
 # (partial moves): the place-level state for this root — the
          # consumed field paths recorded by the semantic registry.
          let d_partial = match b.place_move_states.get(lid.id)
          when Option::Some(states) then
            if states.len() > 0 then Option::Some(states) else Option::None end
          when Option::None then Option::None
          end
          match d_partial
          when Option::Some(states) then
            # The root has per-field records: emit the partial-drop chain
            # (consumed fields skipped, live fields dropped via their own
            # glues) or NOTHING for a whole-value ("*") consumption.
            var d_paths = Vec::new()
            var d_whole = false
            for (dp, ds) in states do
              if ds == PlaceMoveState::Consumed then
                if dp == "*" then
                  d_whole = true
                else
                  d_paths.push(dp.clone())
                end
              end
            end
            if d_whole then
              ()
            elsif d_paths.len() > 0 then
              match dty
              when Option::Some(t2) then
                chain_succ = mir_emit_partial_drop_chain(b, &place_local(MirLocalId { id: mid }), &t2, &d_paths, chain_succ, span)
              when Option::None then ()
              end
            else
              match dglue
              when Option::Some(dinst) then
                let dk = create_block(b)
                switch_to_block(b, dk)
                set_terminator(b, MirTerminatorKind::MirDeinit {
                  place: place_local(MirLocalId { id: mid }),
                  deinit_fn: dinst,
                  target: chain_succ,
                  unwind: Option::None
                }, span)
                chain_succ = dk
              when Option::None then ()
              end
            end
          when Option::None then
            match dglue
            when Option::Some(dinst) then
              let dk = create_block(b)
              switch_to_block(b, dk)
              set_terminator(b, MirTerminatorKind::MirDeinit {
                place: place_local(MirLocalId { id: mid }),
                deinit_fn: dinst,
                target: chain_succ,
                unwind: Option::None
              }, span)
              chain_succ = dk
            when Option::None then ()
            end
          end
        end
      when Option::None then
        b.errors.push("internal error: cleanup action drops semantic local _" + lid.id.to_string() + " with no MIR local")
      end
    when CleanupAction::RunDefer(nid) then
      match b.defer_blocks.get(nid.id)
      when Option::Some(tmpl) then
        chain_succ = clone_defer_block(b, tmpl, chain_succ, span)
      when Option::None then
        b.errors.push("internal error: cleanup action runs defer stmt _" + nid.id.to_string() + " with no lowered defer block")
      end
    when CleanupAction::EndAccess(_) then
      # No MIR emission: the access registry is checker-side bookkeeping —
      # the borrow was already ended at the transfer.
      ()
    end
  end
  chain_succ
end

# the defer scope keys whose deferred actions run on an exiting edge,
# innermost first — the MIR-side mirror of the checker's
# record_exit_edge_plan chain walk. Loop body scopes are negated entries; a
# break/continue/backedge walk (stop_at_loop=true) stops at the first
# negated entry, which IS included; a return walk (stop_at_loop=false)
# covers the whole chain.
# the scopes this yields are exactly the scopes whose defers the
# EXITING EDGE's kind-1 run-defer actions name (append_defer_actions in
# resource_check.tg records each exited scope's defers as (1, <defer stmt
# id>) actions in the same innermost-first order). The kind-1 ids serialize
# as the ScopeId-keyed scope_defers table; the chain emission below consumes them
# LIFO — the edge's defer actions drive the emission.
def defer_scopes_for_exit(b: MirBuilder, stop_at_loop: Bool) -> Vec[Int]
  var out = Vec::new()
  var ci = b.defer_scope_chain.len()
  while ci > 0 do
    ci = ci - 1
    let sk = b.defer_scope_chain[ci]
    out.push(if sk < 0 then 0 - sk else sk end)
    if stop_at_loop && sk < 0 then
      break
    end
  end
  out
end

# the defer STMT ids for one scope — the SEMANTIC ScopeId-keyed
# scope_defers table when present (checker authority, registration order);
# otherwise the builder-side registration (the source-level authority for
# scopes the checker did not model — e.g. a defer with no owning locals
# whose scope was never recorded). The defer String-key
# protocol is not part of the model.
# the scope_defers table IS the kind-1 RUN-DEFER action
# serialization of CfgEdge.actions (append_defer_actions records the
# scope's defers as (1, <defer stmt id>) actions from exactly this table).
# The defer-block chaining therefore consumes the edge's defer ids — the
# kind-1 half of the CleanupEdge { edge, actions } — LIFO via
# emit_defer_chain. The builder-side registrations remain the documented
# fallback for scopes the checker never recorded.
def defer_stmt_ids_for_scope(b: MirBuilder, scope_key: Int) -> Vec[Int]
  var out = Vec::new()
  match b.finalize_plan.scope_defers.get(ScopeId { id: scope_key })
  when Option::Some(ids) then
    for d in ids do
      out.push(d.id)
    end
  when Option::None then
    match b.defer_scope_defers.get(scope_key)
    when Option::Some(ids) then out = ids.clone()
    when Option::None then ()
    end
  end
  out
end

def scope_has_defers(b: MirBuilder, scopes: Vec[Int]) -> Bool
  var si = 0
  while si < scopes.len() do
    if defer_stmt_ids_for_scope(b, scopes[si]).len() > 0 then
      return true
    end
    si = si + 1
  end
  false
end

# clone a defer template block for one exit site — a fresh block
# carrying the template's statements (the SAME MIR locals: the deferred
# code's own locals are finalized by the site's cleanup chain through the
# defer_locals edge plans) and a Goto(entry) terminator. A defer body that
# terminated itself (return/break/...) keeps its own terminator.
def clone_defer_block(inout b: MirBuilder, template: MirBlockId, entry: MirBlockId, span: Span) -> MirBlockId
  let new_blk = create_block(b)
  if template.id < b.blocks.len() && new_blk.id < b.blocks.len() then
    let src = b.blocks[template.id]
    var stmts = Vec::new()
    var sti = 0
    while sti < src.statements.len() do
      stmts.push(duplicate_statement(src.statements[sti]))
      sti = sti + 1
    end
    b.blocks[new_blk.id].statements = stmts
    match src.terminator.kind
    when MirTerminatorKind::MirGoto(_) then
      b.blocks[new_blk.id].terminator = MirTerminator { kind: MirTerminatorKind::MirGoto(entry), span: span }
    when MirTerminatorKind::MirUnreachable then
      b.blocks[new_blk.id].terminator = MirTerminator { kind: MirTerminatorKind::MirGoto(entry), span: span }
    when _ then
      b.blocks[new_blk.id].terminator = duplicate_terminator(&src.terminator)
    end
  end
  new_blk
end

# emit the deferred-call chain for `scopes` (innermost first) into
# `succ`; returns the chain entry the exiting block jumps to (succ when no
# defers exist). Per scope the defer blocks run LIFO — REVERSE registration
# order (the last registered defer runs first) — and across scopes the
# innermost scope's defers run first: the scopes are processed outermost-
# first so the innermost scope's chain ends up at the entry. Each exit site
# gets its own clone of every defer template (a single block cannot chain
# into several distinct cleanup successors).
# this IS the consumption of the edge's kind-1 run-defer actions:
# the stmt ids come from the ScopeId-keyed scope_defers table (the kind-1 action
# serialization) in the edge's exit order (defer_scopes_for_exit), LIFO.
def emit_defer_chain(inout b: MirBuilder, scopes: Vec[Int], succ: MirBlockId, span: Span) -> MirBlockId
  var chain_entry = succ
  var si = scopes.len()
  while si > 0 do
    si = si - 1
    let scope_key = scopes[si]
    let stmt_ids = defer_stmt_ids_for_scope(b, scope_key)
    var ri = 0
    while ri < stmt_ids.len() do
      let stmt_id = stmt_ids[ri]
      match b.defer_blocks.get(stmt_id)
      when Option::Some(tmpl) then
        chain_entry = clone_defer_block(b, tmpl, chain_entry, span)
      when Option::None then
        b.errors.push("internal error: defer:: plan references defer stmt _" + stmt_id.to_string() + " with no lowered defer block")
      end
      ri = ri + 1
    end
  end
  chain_entry
end

# route an exiting block through the deferred-call chain of `scopes`
# (innermost first) into a fresh MirReturn block. Used at the implicit-
# return materialization when the function body scope has defers.
def emit_defers_then_return(inout b: MirBuilder, scopes: Vec[Int], exit_blk: MirBlockId, span: Span) -> Unit
  let ret_chain = create_block(b)
  switch_to_block(b, ret_chain)
  set_terminator(b, MirTerminatorKind::MirReturn, span)
  let defer_entry = emit_defer_chain(b, scopes, ret_chain, span)
  switch_to_block(b, exit_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(defer_entry), span)
  b.return_edge_blocks.insert(ret_chain.id)
end

# Materialize loop-edge cleanup obligations (break/continue/backedge): the
# edge's CleanupEdge actions (the exited scopes' RunDefer actions LIFO,
# then the Drop actions in reverse drop order) are materialized BEFORE the
# jump to the loop target; when the actions are empty the plain goto is
# emitted. the actions come from the CleanupEdge table
# (lookup_cleanup_edge by the edge's (kind, source) identity) — the
# String-keyed serializations are not part of the model; a lookup miss (a synthesized/
# IR-only edge) falls back to the builder-side defer-chain walk
# (defer_scopes_for_exit + emit_defer_chain).
def emit_loop_edge_cleanup(inout b: MirBuilder, kind: CfgEdgeKind, source: Int, target: Option[MirBlockId], span: Span) -> Unit
  match target
  when Option::Some(tgt) then
    match lookup_cleanup_edge(b, kind, source)
    when Option::Some(actions) then
      if actions.len() > 0 then
        match b.current_block
        when Option::Some(edge_blk) then
          let chain_succ = emit_cleanup_chain(b, &actions, tgt, span, -1)
          switch_to_block(b, edge_blk)
          set_terminator(b, MirTerminatorKind::MirGoto(chain_succ), span)
        when Option::None then ()
        end
      else
        # No obligations: plain goto on the current block (the deferred
        # actions of the exiting scopes, if any, still run first — the
        # builder-side chain is the fallback when the checker recorded
        # none).
        let exit_scopes = defer_scopes_for_exit(b, true)
        let defer_entry2 = emit_defer_chain(b, &exit_scopes, tgt, span)
        set_terminator(b, MirTerminatorKind::MirGoto(defer_entry2), span)
      end
    when Option::None then
      # Synthesized/IR-only edge (no checker record): the builder-side
      # defer-chain fallback.
      let exit_scopes3 = defer_scopes_for_exit(b, true)
      let defer_entry3 = emit_defer_chain(b, &exit_scopes3, tgt, span)
      set_terminator(b, MirTerminatorKind::MirGoto(defer_entry3), span)
    end
  when Option::None then ()
  end
end

def stmt_kind_name(kind: StmtKind) -> String
  match kind
  when StmtKind::StmtLet(_, _, _, _) then "StmtLet"
  when StmtKind::StmtAssign(_, _) then "StmtAssign"
  when StmtKind::StmtCompoundAssign(_, _, _) then "StmtCompoundAssign"
  when StmtKind::StmtIf(_) then "StmtIf"
  when StmtKind::StmtMatch(_) then "StmtMatch"
  when StmtKind::StmtWhile(_, _) then "StmtWhile"
  when StmtKind::StmtFor(_) then "StmtFor"
  when StmtKind::StmtLoop(_) then "StmtLoop"
  when StmtKind::StmtReturn(_) then "StmtReturn"
  when StmtKind::StmtBreak(_) then "StmtBreak"
  when StmtKind::StmtContinue then "StmtContinue"
  when StmtKind::StmtExpr(_) then "StmtExpr"
  when StmtKind::StmtUnsafe(_, _) then "StmtUnsafe"
  when StmtKind::StmtDefer(_) then "StmtDefer"
  when StmtKind::StmtGuard(_, _) then "StmtGuard"
  when StmtKind::StmtTry(_, _, _) then "StmtTry"
  when StmtKind::StmtWith(_, _, _) then "StmtWith"
  when StmtKind::StmtHandleWith(_, _) then "StmtHandleWith"
  when _ then "StmtKind(?)"
  end
end

def expr_kind_name(kind: ExprKind) -> String
  match kind
  when ExprKind::ExprIntLit(_) then "ExprIntLit"
  when ExprKind::ExprFloatLit(_) then "ExprFloatLit"
  when ExprKind::ExprStringLit(_) then "ExprStringLit"
  when ExprKind::ExprCharLit(_) then "ExprCharLit"
  when ExprKind::ExprBoolLit(_) then "ExprBoolLit"
  when ExprKind::ExprNilLit then "ExprNilLit"
  when ExprKind::ExprArrayLit(_) then "ExprArrayLit"
  when ExprKind::ExprTupleLit(_) then "ExprTupleLit"
  when ExprKind::ExprStructLit(_, _) then "ExprStructLit"
  when ExprKind::ExprMapLit(_) then "ExprMapLit"
  when ExprKind::ExprIdent(_) then "ExprIdent"
  when ExprKind::ExprPath(_) then "ExprPath"
  when ExprKind::ExprSelfRef then "ExprSelfRef"
  when ExprKind::ExprBinaryOp(_, _, _) then "ExprBinaryOp"
  when ExprKind::ExprUnaryOp(_, _) then "ExprUnaryOp"
  when ExprKind::ExprFieldAccess(_, _) then "ExprFieldAccess"
  when ExprKind::ExprMethodCall(_, _, _, _) then "ExprMethodCall"
  when ExprKind::ExprIndex(_, _) then "ExprIndex"
  when ExprKind::ExprCall(_, _) then "ExprCall"
  when ExprKind::ExprClosure(_, _, _) then "ExprClosure"
  when ExprKind::ExprAccess(_) then "ExprAccess"
  when ExprKind::ExprRawDeref(_) then "ExprRawDeref"
  when ExprKind::ExprIf(_) then "ExprIf"
  when ExprKind::ExprMatch(_) then "ExprMatch"
  when ExprKind::ExprBlock(_) then "ExprBlock"
  when ExprKind::ExprUnsafe(_, _) then "ExprUnsafe"
  when ExprKind::ExprAsync(_) then "ExprAsync"
  when ExprKind::ExprAwait(_) then "ExprAwait"
  when ExprKind::ExprTry(_) then "ExprTry"
  when ExprKind::ExprRange(_, _, _) then "ExprRange"
  when ExprKind::ExprCast(_, _) then "ExprCast"
  when ExprKind::ExprTypeCheck(_, _) then "ExprTypeCheck"
  when ExprKind::ExprComptime(_) then "ExprComptime"
  when ExprKind::ExprEnumVariant(_, _) then "ExprEnumVariant"
  when ExprKind::ExprAssign(_, _) then "ExprAssign"
  when ExprKind::ExprPipe(_, _) then "ExprPipe"
  when ExprKind::ExprMacroCall(_, _) then "ExprMacroCall"
  when ExprKind::ExprError(_) then "ExprError"
  when _ then "ExprKind(?)"
  end
end

def emit_return_edge_cleanup(inout b: MirBuilder, stmt_node_id: Int, kind: CfgEdgeKind, span: Span) -> Unit
  # RETURN-EDGE cleanup: the edge's CleanupEdge actions (the defers of
  # EVERY enclosing scope LIFO — a return exits every scope — then the
  # live owning locals in reverse drop order) are materialized BEFORE the
  # return — an early return must not skip lexical-scope cleanup. Shared
  # by explicit `return` statements (kind Return) and guard-else return
  # paths (kind GuardElse — the checker records ONE GuardElse edge under
 # the guard stmt's id). the actions come from the CleanupEdge
  # table (lookup_cleanup_edge by (kind, source)) — the String-keyed
 # serializations are not part of the model; a lookup miss (synthesized/IR-only edge)
  # falls back to the builder-side defer-chain walk.
  let exit_scopes = defer_scopes_for_exit(b, false)
  match lookup_cleanup_edge(b, kind, stmt_node_id)
  when Option::Some(actions) then
    if actions.len() > 0 then
      match b.current_block
      when Option::Some(ret_blk) then
        # Build the cleanup chain backward: each action targets the next;
        # the chain's final block performs the return. The original
        # block's terminator is replaced with a goto to the chain entry.
        # A finalizer's own `self` is never re-finalized (recursive
        # re-deinit of the subject).
        let fn_name_here = match b.current_fn
        when Option::Some(cf) then cf.name.clone()
        when Option::None then ""
        end
        var is_deinit_fn_here = false
 # the finalizer REGISTRATION is the identity source — the
        # current function is a finalizer exactly when its resolver DefId is
        # a registered deinit_targets callable (the "Type__drop" /
        # "Type__deinit" emission names are only the symbol-mangling
        # boundary; method_def_ids maps them to the DefIds). Registered
        # BEFORE the function is lowered (the same item pass registers
        # method_def_ids then lowers the method).
        match b.method_def_ids.get(fn_name_here)
        when Option::Some(fn_did) then
          for (_, dv) in b.deinit_targets do
            if dv.def.module.id == fn_did.module.id && dv.def.index == fn_did.index then
              is_deinit_fn_here = true
            end
          end
        when Option::None then ()
        end
        let self_mir_id = if is_deinit_fn_here then
          match b.current_fn
          when Option::Some(cf) then
            if cf.params.len() > 0 then cf.params[0].id.id else -1 end
          when Option::None then -1
          end
        else
          -1
        end
        let ret_chain = create_block(b)
        b.return_edge_blocks.insert(ret_chain.id)
        switch_to_block(b, ret_chain)
        set_terminator(b, MirTerminatorKind::MirReturn, span)
        let chain_succ = emit_cleanup_chain(b, &actions, ret_chain, span, self_mir_id)
        switch_to_block(b, ret_blk)
        set_terminator(b, MirTerminatorKind::MirGoto(chain_succ), span)
      when Option::None then ()
      end
    else
      # No obligations at this return: the block still terminates with the
      # return (an unterminated else-block would fall into the join path).
      # The scopes' deferred actions (if any — the builder-side
      # registrations are the fallback when the checker recorded none)
      # still run before the return.
      match b.current_block
      when Option::Some(ret_blk) then
        if scope_has_defers(b, &exit_scopes) then
          let ret_chain = create_block(b)
          switch_to_block(b, ret_chain)
          set_terminator(b, MirTerminatorKind::MirReturn, span)
          let defer_entry = emit_defer_chain(b, &exit_scopes, ret_chain, span)
          switch_to_block(b, ret_blk)
          set_terminator(b, MirTerminatorKind::MirGoto(defer_entry), span)
          b.return_edge_blocks.insert(ret_chain.id)
        else
          set_terminator(b, MirTerminatorKind::MirReturn, span)
        end
      when Option::None then ()
      end
    end
  when Option::None then
    match b.current_block
    when Option::Some(ret_blk) then
      if scope_has_defers(b, &exit_scopes) then
        let ret_chain = create_block(b)
        switch_to_block(b, ret_chain)
        set_terminator(b, MirTerminatorKind::MirReturn, span)
        let defer_entry = emit_defer_chain(b, &exit_scopes, ret_chain, span)
        switch_to_block(b, ret_blk)
        set_terminator(b, MirTerminatorKind::MirGoto(defer_entry), span)
        b.return_edge_blocks.insert(ret_chain.id)
      else
        set_terminator(b, MirTerminatorKind::MirReturn, span)
      end
    when Option::None then ()
    end
  end
end

# the typed declared type of a `let` binding — the checker's
# local_bindings record (semantic local id -> LocalBinding { name, ty }).
# The pattern's semantic local id comes from the typed
# pattern_binding_resolutions (pat node id -> semantic local id); the
# binding's ty is the checker's resolved var_type (the annotation resolved,
# or the value type when un-annotated — the typed table is the authority;
# TypeExpr is never interpreted after checking). Option::None only for a
# binding the checker never recorded — the caller records the internal
# error (fail-closed).
def typed_let_binding_type(b: MirBuilder, pat: Pattern) -> Option[Type]
  match b.pattern_binding_resolutions.get(pat.node_id)
  when Option::Some(sem_id) then
    match b.typed_local_bindings.get(sem_id)
    when Option::Some(lb) then Option::Some(lb.ty.clone())
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

def lower_stmt(inout b: MirBuilder, stmt: Stmt) -> Unit
  # Stage0 codegen miscompiles big `match` blocks on enums with many
  # variants: bindings (e.g. `value: Expr` inside `StmtLet`) come out
  # NULL-data because the per-arm spill slots collide.  Dispatch first
  # via stmt_kind_name (string) and only then enter a tiny 2-arm
  # `match` to extract the bindings for the chosen variant.  Each
  # per-arm match has at most 1 specific arm + a default arm, which
  # stage0 lowers correctly.
  let kind_name = stmt_kind_name(&stmt.kind)
  println("[lower_stmt] kind=" + kind_name)
  if kind_name == "StmtLet" then
    match stmt.kind
    when StmtKind::StmtLet(pattern, ty_opt, value, is_mut) then
      match pattern.kind
      when PatternKind::Ident(name, pattern_mut) then
        let binding_mut = is_mut || pattern_mut
 # the declared type comes from the typed binding record (a
        # FixedArray annotation drives the dest-aware array-literal lowering
        # below); the typed table is the authority — TypeExpr is never
        # interpreted after checking, and a missing typed binding for an
        # annotated let is an internal error (fail-closed). The initializer
        # rvalue is lowered BEFORE the binding local is allocated (kept
        # ordering).
        let declared_ty = match ty_opt
        when Option::Some(_) then
          match typed_let_binding_type(b, &pattern)
          when Option::Some(t) then Option::Some(t)
          when Option::None then
            b.errors.push("internal error: missing typed local binding for let pattern node " + pattern.node_id.to_string() + " during MIR lowering")
            Option::None
          end
        when Option::None then Option::None
        end
        match declared_ty
        when Option::Some(dty) then
          match lower_expr_rvalue_to_dest(b, &value, &dty, stmt.span)
          when Result::Ok(rvalue) then
            let local_id = add_local(b, name.clone(), dty, binding_mut, stmt.span)
            record_semantic_pattern_local(b, &pattern, local_id, "let binding")
            push_assign(b, place_local(local_id), rvalue, stmt.span)
          when Result::Err(e) then
            b.errors.push(e)
          end
        when Option::None then
          match lower_expr_to_rvalue(b, &value, stmt.span)
          when Result::Ok(rvalue) then
            let inferred_ty = mir_source_expr_ty(b, &value)
            let local_id = add_local(b, name.clone(), inferred_ty, binding_mut, stmt.span)
            record_semantic_pattern_local(b, &pattern, local_id, "let binding")
            push_assign(b, place_local(local_id), rvalue, stmt.span)
          when Result::Err(e) then
            b.errors.push(e)
          end
        end
        return
      when _ then ()
      end

 # the declared type of the annotated let comes from the typed
      # binding record (see the Ident arm above); a missing typed binding is
      # an internal error (fail-closed).
      match ty_opt
      when Option::Some(_) then
        let declared_ty = match typed_let_binding_type(b, &pattern)
        when Option::Some(t) then t
        when Option::None then
          b.errors.push("internal error: missing typed local binding for let pattern node " + pattern.node_id.to_string() + " during MIR lowering")
          Type::Unit
        end
        let typed_tmp = add_temp(b, declared_ty.clone(), stmt.span)
        match lower_expr_rvalue_to_dest(b, &value, &declared_ty, stmt.span)
        when Result::Ok(rvalue) then
          push_assign(b, place_local(typed_tmp), rvalue, stmt.span)
        when Result::Err(e) then
          b.errors.push(e)
        end
        lower_pattern_place_assignment(b, &pattern, place_local(typed_tmp), stmt.span)
      when Option::None then
        match lower_expr_to_rvalue(b, &value, stmt.span)
        when Result::Ok(rvalue) then
          let inferred_ty = mir_source_expr_ty(b, &value)
          let typed_tmp = add_temp(b, inferred_ty, stmt.span)
          push_assign(b, place_local(typed_tmp), rvalue, stmt.span)
          lower_pattern_place_assignment(b, &pattern, place_local(typed_tmp), stmt.span)
        when Result::Err(e) then
          b.errors.push(e)
        end
      end
      return
    when _ then ()
    end
  elsif kind_name == "StmtAssign" then
    match stmt.kind
    when StmtKind::StmtAssign(target, value) then
      let place = lower_place(b, &target)
      let value_ty = mir_source_expr_ty(b, &value)
      let place_ty = lookup_local_type(b, &place.local)
 # assigning over a live owning place drops the previous value
      # first (drop old -> store new). The helper returns the continuation
      # block for the store when a drop chain was needed.
      match lower_assign_drop_chain(b, stmt.node_id, stmt.span, place.clone())
      when Option::Some(cont) then
        switch_to_block(b, cont)
        match lower_expr_rvalue_to_dest(b, &value, &place_ty, stmt.span)
        when Result::Ok(rvalue) then
          push_assign(b, place, rvalue, stmt.span)
          refine_assignment_target_type(b, &place, &value_ty)
          refine_assignment_target_type_from_type(b, &place, &value_ty)
        when Result::Err(e) then
          b.errors.push(e)
        end
      when Option::None then
 # the INDEXED-assignment old element. The checker records
        # no assign-drop plan for projected targets (its machinery is
        # root-local-plain only), yet the store OVERWRITES the element at
        # data + index*stride — an owning element type leaks. The MIR
        # drops the old element through the concrete element glue BEFORE
        # the store (the OrderedMap::insert overwrite is this shape).
        match mir_try_indexed_assign_drop(b, &target, &place)
        when Option::Some(ig) then
          let cont_blk = create_block(b)
          let drop_blk = create_block(b)
          match b.current_block
          when Option::Some(cur_blk) then
            switch_to_block(b, drop_blk)
            set_terminator(b, MirTerminatorKind::MirDeinit {
              place: place.clone(),
              deinit_fn: ig,
              target: cont_blk,
              unwind: Option::None
            }, stmt.span)
            switch_to_block(b, cur_blk)
            set_terminator(b, MirTerminatorKind::MirGoto(drop_blk), stmt.span)
          when Option::None then ()
          end
          switch_to_block(b, cont_blk)
          match lower_expr_rvalue_to_dest(b, &value, &place_ty, stmt.span)
          when Result::Ok(rvalue) then
            push_assign(b, place, rvalue, stmt.span)
            refine_assignment_target_type(b, &place, &value_ty)
            refine_assignment_target_type_from_type(b, &place, &value_ty)
          when Result::Err(e) then
            b.errors.push(e)
          end
        when Option::None then
          match lower_expr_rvalue_to_dest(b, &value, &place_ty, stmt.span)
          when Result::Ok(rvalue) then
            push_assign(b, place, rvalue, stmt.span)
            refine_assignment_target_type(b, &place, &value_ty)
            refine_assignment_target_type_from_type(b, &place, &value_ty)
          when Result::Err(e) then
            b.errors.push(e)
          end
        end
      end
      return
    when _ then ()
    end
  elsif kind_name == "StmtIf" then
    match stmt.kind
    when StmtKind::StmtIf(if_stmt) then
      lower_if(b, &if_stmt, stmt.span)
      return
    when _ then ()
    end
  elsif kind_name == "StmtWhile" then
    match stmt.kind
    when StmtKind::StmtWhile(cond, body) then
      lower_while(b, &cond, &body, stmt.span, stmt.node_id)
      return
    when _ then ()
    end
  elsif kind_name == "StmtFor" then
    match stmt.kind
    when StmtKind::StmtFor(for_stmt) then
      lower_for(b, &for_stmt.pattern, &for_stmt.iter, &for_stmt.body, stmt.span, stmt.node_id)
      return
    when _ then ()
    end
  elsif kind_name == "StmtReturn" then
    match stmt.kind
    when StmtKind::StmtReturn(val_opt) then
      match val_opt
      when Option::Some(val) then
        let ret_ty = lookup_local_type(b, &MirLocalId { id: 0 })
        match lower_expr_rvalue_to_dest(b, &val, &ret_ty, stmt.span)
        when Result::Ok(rvalue) then
          push_stmt(b, MirStatementKind::MirAssign(place_local(MirLocalId { id: 0 }), rvalue), stmt.span)
        when Result::Err(e) then
          b.errors.push(e)
        end
      when Option::None then ()
      end
      emit_return_edge_cleanup(b, stmt.node_id, CfgEdgeKind::Return, stmt.span)
      return
    when _ then ()
    end
  elsif kind_name == "StmtGuard" then
    match stmt.kind
    when StmtKind::StmtGuard(cond, else_action) then
      # guard cond else ACTION: when cond is true execution falls through;
      # when cond is false the else action (return/break/continue/panic)
      # runs on its own block, with the cleanup obligations the checker
      # recorded for the guard's edge keys.
      let cond_op = lower_expr(b, &cond, stmt.span)
      let cont_blk = create_block(b)
      let else_blk = create_block(b)
      var targets = Vec::new()
      targets.push(SwitchTarget { value: 0, target: else_blk })
      set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cond_op, targets: targets, default_target: cont_blk }, stmt.span)
      switch_to_block(b, else_blk)
      match else_action
      when GuardElse::Return(val_opt) then
        match val_opt
        when Option::Some(val) then
          let guard_ret_ty = lookup_local_type(b, &MirLocalId { id: 0 })
          match lower_expr_rvalue_to_dest(b, &val, &guard_ret_ty, stmt.span)
          when Result::Ok(rvalue) then
            push_stmt(b, MirStatementKind::MirAssign(place_local(MirLocalId { id: 0 }), rvalue), stmt.span)
          when Result::Err(e) then
            b.errors.push(e)
          end
        when Option::None then ()
        end
        emit_return_edge_cleanup(b, stmt.node_id, CfgEdgeKind::GuardElse, stmt.span)
      when GuardElse::Panic(_) then
        set_terminator(b, MirTerminatorKind::MirAbort, stmt.span)
      when GuardElse::Break(val_opt) then
        match val_opt
        when Option::Some(val) then
          let _bv = lower_expr(b, &val, stmt.span)
        when Option::None then ()
        end
        emit_loop_edge_cleanup(b, CfgEdgeKind::GuardElse, stmt.node_id, b.break_target, stmt.span)
      when GuardElse::Continue then
        emit_loop_edge_cleanup(b, CfgEdgeKind::GuardElse, stmt.node_id, b.continue_target, stmt.span)
      end
      switch_to_block(b, cont_blk)
      return
    when _ then ()
    end
  elsif kind_name == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(expr) then
      let result_op = lower_expr(b, &expr, stmt.span)
 # Full-expression temporary cleanup: when the checker recorded
      # an expr_temps obligation (the SEMANTIC table keyed by the stmt node
      # id — the "expr::<stmt id>" String-key protocol is are not part of the model), the
      # statement's result temporary is an owned resource that must be
      # finalized at the end of the statement.
      match b.finalize_plan.expr_temps.get(stmt.node_id)
      when Option::Some(_) then
        let tmp_place = match result_op.kind
        when MirOperandKind::MirCopy(p) then Option::Some(p)
        when MirOperandKind::MirMovePlace(p) then Option::Some(p)
        when MirOperandKind::MirConsume(p) then Option::Some(p)
        when _ then Option::None
        end
        match tmp_place
        when Option::Some(p) then
            let tmp_ty = builder_local_typed_ty(b, &p.local)
 # the full-expression temporary's destruction is ONE
            # MirDeinit carrying the concrete type's drop-GLUE instance.
            let tmp_glue = match tmp_ty
            when Option::Some(t) then mir_try_glue_instance(b, &t)
            when Option::None then Option::None
            end
            match tmp_glue
            when Option::Some(tinst) then
              match b.current_block
              when Option::Some(st_blk) then
                let cont_blk = create_block(b)
                let deinit_blk = create_block(b)
                switch_to_block(b, deinit_blk)
                set_terminator(b, MirTerminatorKind::MirDeinit {
                  place: p.clone(),
                  deinit_fn: tinst,
                  target: cont_blk,
                  unwind: Option::None
                }, span)
                switch_to_block(b, st_blk)
                set_terminator(b, MirTerminatorKind::MirGoto(deinit_blk), span)
                switch_to_block(b, cont_blk)
              when Option::None then ()
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
      when Option::None then ()
      end
      return
    when _ then ()
    end
  elsif kind_name == "StmtMatch" then
    match stmt.kind
    when StmtKind::StmtMatch(m) then
      lower_match(b, &m, stmt.span)
      return
    when _ then ()
    end
  elsif kind_name == "StmtBreak" then
    emit_loop_edge_cleanup(b, CfgEdgeKind::Break, stmt.node_id, b.break_target, stmt.span)
    return
  elsif kind_name == "StmtContinue" then
    emit_loop_edge_cleanup(b, CfgEdgeKind::Continue, stmt.node_id, b.continue_target, stmt.span)
    return
  elsif kind_name == "StmtLoop" then
    match stmt.kind
    when StmtKind::StmtLoop(body) then
      lower_loop(b, &body, stmt.span, stmt.node_id)
      return
    when _ then ()
    end
  elsif kind_name == "StmtCompoundAssign" then
    match stmt.kind
    when StmtKind::StmtCompoundAssign(op, target, value) then
      let place = lower_place(b, &target)
      let lhs_operand = lower_expr(b, &target, stmt.span)
      let rhs_operand = lower_expr(b, &value, stmt.span)
      let mir_op = lower_binop(op)
      let rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(mir_op, lhs_operand, rhs_operand) }
      push_assign(b, place, rvalue, stmt.span)
      return
    when _ then ()
    end
  elsif kind_name == "StmtDefer" then
    match stmt.kind
    when StmtKind::StmtDefer(body) then
 # `defer {... }` REGISTERS a deferred action on the current
      # lexical scope — the body does NOT execute at registration. Lower the
      # body's statements into a dedicated deferred-call TEMPLATE block; the
      # exiting-edge emissions clone it into their chains, LIFO (the LAST
      # registered defer runs FIRST — see emit_defer_chain). The body is
      # lowered statement-by-statement (NOT via lower_block): the checker
      # never records a block plan or a scope key for the defer body itself
      # (check_defer_body pushes no key), so its top level must not register
      # a scope here — nested blocks inside the body push their own keys
      # through their own lowering, exactly like the checker's flow run.
      let defer_cont = b.current_block
      let defer_blk = create_block(b)
      switch_to_block(b, defer_blk)
      var dbi = 0
      while dbi < body.stmts.len() do
        lower_stmt(b, &body.stmts[dbi])
        dbi = dbi + 1
      end
      if !block_is_terminated(b) then
        match defer_cont
        when Option::Some(cont) then set_terminator(b, MirTerminatorKind::MirGoto(cont), stmt.span)
        when Option::None then ()
        end
      end
      b.defer_blocks.insert(stmt.node_id, defer_blk)
      # Register under the current scope key (builder-side authority; the
      # checker's ScopeId-keyed defer registration is the scope association at emission).
      if b.defer_scope_chain.len() > 0 then
        let raw_scope_key = b.defer_scope_chain[b.defer_scope_chain.len() - 1]
        let scope_key = if raw_scope_key < 0 then 0 - raw_scope_key else raw_scope_key end
        match b.defer_scope_defers.get(scope_key)
        when Option::Some(existing) then
          var ext = existing.clone()
          ext.push(stmt.node_id)
          b.defer_scope_defers.insert(scope_key, ext)
        when Option::None then
          var ids = Vec::new()
          ids.push(stmt.node_id)
          b.defer_scope_defers.insert(scope_key, ids)
        end
      end
      # Continue lowering the enclosing block from the block where the
      # defer appeared (the template block is only ever reached through the
      # exit chains).
      match defer_cont
      when Option::Some(cont) then switch_to_block(b, cont)
      when Option::None then ()
      end
      return
    when _ then ()
    end
  elsif kind_name == "StmtTry" || kind_name == "StmtWith" || kind_name == "StmtHandleWith" then
 # REJECTED at the type checker — exceptions are not supported
    # (no exception runtime in the backend, no Throw/Unwind/Handler edges
    # in the resource CFG). MIR must fail CLOSED here, never silently skip
 # the statement: the pre-lower_stmt fell through this dispatch
    # and silently ERASED try/with/handle blocks — exactly the class of
    # bypass that could skip Drop/defer teardown on an exceptional path.
    b.errors.push("exceptions are not supported — no throwing path may bypass teardown: " + kind_name + " reached MIR lowering")
  end
end

def lower_expr(inout b: MirBuilder, expr: Expr, span: Span) -> MirOperand
  let inferred_ty = mir_source_expr_ty(b, expr)
  let temp = add_temp(b, inferred_ty, span)
  match lower_expr_to_rvalue(b, expr, span)
  when Result::Ok(rvalue) then
    push_assign(b, place_local(temp), rvalue, span)
  when Result::Err(e) then
 # record the internal error (aborts lowering at the error drain)
    # and produce a defensive Unit aggregate instead of returning a copy of
    # the never-assigned temp.
    b.errors.push(e)
    return operand_unit()
  end
  operand_copy_local(temp)
end

def is_vec_like_from_path(path: AstPath) -> Bool
  if path.segments.len() < 2 then
    return false
  end
  let method = path.segments[path.segments.len() - 1]
  let owner = path.segments[path.segments.len() - 2]
  method == "from" && (owner == "Vec" || owner == "Array")
end

# PHASE-1 (item 56): the vec! / Vec::from([..]) array-from-list lowering no
# longer synthesizes Expr/Stmt/Pattern AST nodes (node_id 0) and sends them
# back through the SOURCE lowering machinery. It builds the call sequence
# directly in MIR:
#   tmp = Vec::new()                  (Array::new — the std impl constructor)
#   Vec::push(&mut tmp, elem)         per element (sink)
#   return tmp
# The callee instances are attached BY CONSTRUCTION (the lower_for_projected
# pattern): the impl method's resolver DefId (method_def_ids) + the element
# type as the substs — zero inference, matching the typed program's solved
# The element type is the semantic authority: the typed tree read
# (mir_source_expr_ty — the checker's TypedExpr record; fail-closed on a
# missing entry). The vector temp is the heap-vector storage Adt
# (the registered Vec builtin id — the Slice id is the view and is NEVER a
# Vec storage form), so the rvalue agrees with the destination local
# type the expression-type authority derives.
def lower_vec_like_from_array_call(inout b: MirBuilder, path: AstPath, elems: Vec[Expr], span: Span) -> Result[MirRvalue, String]
  let elem_ty = if elems.len() > 0 then
    mir_source_expr_ty(b, &elems[0])
  else
    Type::Unit
  end

  let owner = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2].clone() else "Vec" end
  let norm_owner = if owner == "Array" then "Vec" else owner end

  let vec_ty = Type::Adt(TypeId { id: b.lang_items.vec }, Vec::from([elem_ty.clone()]))

  # Vec::new instance by construction (resolver DefId + concrete element
  # type); the name-only form is kept only when the DefId is absent.
  let new_callee = norm_owner.clone() + "__new"
  let new_instance = match b.method_def_ids.get(&new_callee)
  when Option::Some(did) then Option::Some(InstanceId { def: CallableId { def: did.clone() }, substs: vec![elem_ty.clone()] })
  when Option::None then Option::None
  end

  let vec_tmp = add_temp(b, vec_ty.clone(), span)
  let new_success = create_block(b)
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(vec_tmp),
    func: mir_fn_operand_with_instance(b, new_callee, new_instance),
    args: Vec::new(),
    success: new_success,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(new_success)

  # Vec::push receiver: the freshly created vector temp borrowed &mut (the
  # same lowering the method-call path produces for push on a place).
  let recv_ref_tmp = add_temp(b, Type::RefInternal(vec_ty.clone(), false), span)
  push_assign(b, place_local(recv_ref_tmp), MirRvalue { kind: MirRvalueKind::MirRef(place_local(vec_tmp)) }, span)

  let push_callee = norm_owner.clone() + "__push"
  let push_instance = match b.method_def_ids.get(&push_callee)
  when Option::Some(did) then Option::Some(InstanceId { def: CallableId { def: did.clone() }, substs: vec![elem_ty.clone()] })
  when Option::None then Option::None
  end

  var elem_idx = 0
  while elem_idx < elems.len() do
    let push_success = create_block(b)
    var push_args = Vec::new()
    push_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand {
      kind: MirOperandKind::MirCopy(place_local(recv_ref_tmp))
    }) })
    # The element is consumed into the vector (sink semantics, the same
    # effect the checker records for source push calls).
    var elem_value = MirCallValue::Value(lower_expr(b, &elems[elem_idx], span))
    if expr_is_place_like(&elems[elem_idx]) then
      elem_value = MirCallValue::Place(lower_place(b, &elems[elem_idx]))
    else if elem_ty == Type::String && expr_kind_name(&elems[elem_idx].kind) == "ExprStringLit" then
 # a Vec[String] element that is a string LITERAL must be
      # an OWNED String object — the static StaticStrPtr goes through the owned
      # conversion before the sink push.
      elem_value = MirCallValue::Value(lower_string_literal_to_owned(b, &elems[elem_idx], span))
    end
    push_args.push(MirCallArg { effect: AccessEffect::Consume, value: elem_value })
    set_terminator(b, MirTerminatorKind::MirCall {
      dest: place_local(add_temp(b, mir_call_result_temp_type(Type::Unit), span)),
      func: mir_fn_operand_with_instance(b, push_callee.clone(), push_instance.clone()),
      args: push_args,
      success: push_success,
      intrinsic: Option::None,
      unwind: Option::None
    }, span)
    b.current_block = Option::Some(push_success)
    elem_idx = elem_idx + 1
  end

  Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(vec_tmp))
  }) })
end

# Per-arm helpers extracted from lower_expr_to_rvalue.
# stage0_swift's codegen has a bug returning multi-word structs through
# deeply-nested match arms (corrupts caller stack frame on return). Each
# arm here returns directly from a fresh function frame, avoiding that
# pattern.
def lr_self_ref(inout b: MirBuilder) -> MirRvalue
  match lookup_current_local_id_by_name(b, "self")
  when Option::Some(local_id) then
    move_rvalue(operand_copy_local(local_id))
  when Option::None then
    move_rvalue(operand_unit())
  end
end

# Lower an identifier to its place value. The typed ident_resolutions
# (node id -> local id) are authoritative when available; the name-based
# scope lookup is a fallback for synthetic/source-less code.
def lr_ident(inout b: MirBuilder, name: String, node_id: Int) -> MirRvalue
  if node_id != 0 then
 # (phase 2): the typed node form's semantic local id
    # (TypedExprKind::Local — the same data the flat ident_resolutions
    # holds) is the PRIMARY local-resolution source; the flat
    # ident_resolutions is the fallback for the nodes the checker recorded
    # only in the flat map.
    # Semantic local id -> MIR local id: ident_resolutions holds SEMANTIC
    # ids (global counter across type checking), which are NOT MIR local ids
    # (per-function, 0 = return place). Reinterpreting the integer directly
    # happens to work for early locals and then fails once the counters
    # diverge.
    var resolved_lid = -1
    match typed_local_id_of(b, node_id)
    when Option::Some(lid) then resolved_lid = lid
    when Option::None then
      match b.ident_resolutions.get(node_id)
      when Option::Some(lid2) then resolved_lid = lid2
      when Option::None then ()
      end
    end
    if resolved_lid >= 0 then
      match b.semantic_to_mir.get(resolved_lid)
      when Option::Some(mid) then
        return move_rvalue(operand_copy_local(MirLocalId { id: mid }))
      when Option::None then ()
      end
    end
  end
  match lookup_current_local_id_by_name(b, name)
  when Option::Some(local_id) then move_rvalue(operand_copy_local(local_id))
  when Option::None then
    if b.static_names.contains(&name) then
      let st_ty = match b.static_types.get(name)
      when Option::Some(t) then t
      when Option::None then Type::Unit
      end
 # the static reference carries the static's SEMANTIC DefId
      # (static_def_ids — the resolver's module_symbols identity). A
      # registered static whose DefId never resolved is an internal error
      # (fail-closed: the emission label must derive from the DefId at
      # backend symbol generation, never from an unverifiable name).
      var st_did = DefId { module: ModuleId { id: -1 }, index: 0 }
      var st_did_ok = false
      match b.static_def_ids.get(name)
      when Option::Some(did) then
        st_did = did
        st_did_ok = true
      when Option::None then
        b.errors.push("internal error: static '" + name + "' has no resolver DefId during MIR lowering")
      end
      if st_did_ok then
        move_rvalue(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirStaticRef(DefId { module: ModuleId { id: st_did.module.id }, index: st_did.index }),
            ty: st_ty,
            instance: Option::None
          })
        })
      else
        move_rvalue(operand_unit())
      end
    else
      # PHASE-1 (item 13): a SOURCE identifier that resolves to neither a
      # typed local nor a static is an internal error — the typed
      # ident_resolutions is the local-resolution authority; the Unit
      # fallback is kept only for synthesized nodes (node_id 0) and bare
      # enum-variant names (the checker types them as enum values /
      # constructors, not locals).
      if node_id != 0 && !mir_name_is_enum_variant(b, name.clone()) then
        b.errors.push("internal error: missing typed local resolution for identifier '" + name + "' (node " + node_id.to_string() + ") during MIR lowering")
      end
      move_rvalue(operand_unit())
    end
  end
end

# Whether a bare name is a variant of any registered enum (the checker types
# bare variant names in value position as enum values / constructor
# functions, recording no ident_resolution for them).
def mir_name_is_enum_variant(b: MirBuilder, name: String) -> Bool
  let entries = b.enum_variants.entries()
  for (_, variants) in entries do
    for v in variants do
      if v == name then return true end
    end
  end
  false
end

def lr_deref(inout b: MirBuilder, inner: Expr, span: Span) -> MirRvalue
  let inner_op = lower_expr(b, inner, span)
  MirRvalue { kind: MirRvalueKind::MirMove(inner_op) }
end

def lr_binary(inout b: MirBuilder, op: BinOp, left: Expr, right: Expr, span: Span) -> MirRvalue
  let left_op = lower_expr(b, left, span)
  let right_op = lower_expr(b, right, span)
  let mir_op = lower_binop(op)
  MirRvalue { kind: MirRvalueKind::MirBinOp(mir_op, left_op, right_op) }
end

def lr_unary(inout b: MirBuilder, op: UnOp, inner: Expr, span: Span) -> MirRvalue
  let inner_op = lower_expr(b, inner, span)
  let mir_op = lower_unop(op)
  MirRvalue { kind: MirRvalueKind::MirUnOp(mir_op, inner_op) }
end

def lr_array_lit(inout b: MirBuilder, elems: Vec[Expr], span: Span) -> MirRvalue
  var ops = Vec::new()
  var elem_idx = 0
  while elem_idx < elems.len() do
    ops.push(lower_expr(b, &elems[elem_idx], span))
    elem_idx = elem_idx + 1
  end
  MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::MirArray(Type::Unit), ops) }
end

# Fixed-array literal lowering for a FixedArray destination: the aggregate
# carries the FixedArray dest type (the count is IN the type), so codegen
# emits inline element stores at i * stride — no heap allocation. The empty
# (zero-length) literal carries n == 0 and emits nothing.
def lr_array_lit_typed(inout b: MirBuilder, arr_ty: Type, elems: Vec[Expr], span: Span) -> MirRvalue
  var ops = Vec::new()
  var elem_idx = 0
  while elem_idx < elems.len() do
    ops.push(lower_expr(b, &elems[elem_idx], span))
    elem_idx = elem_idx + 1
  end
  MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::MirArray(arr_ty.clone()), ops) }
end

# Dest-aware array-literal rvalue lowering: when the destination's type is
# the distinct Type::FixedArray variant, the literal lowers to the
# FixedArray-typed aggregate (inline storage); every other destination keeps
# the generic (heap-vector) path.
def lower_expr_rvalue_to_dest(inout b: MirBuilder, expr: Expr, dest_ty: Type, span: Span) -> Result[MirRvalue, String]
  match expr.kind
  when ExprKind::ExprArrayLit(elems) then
    match dest_ty
    when Type::FixedArray(_, _) then
      Result::Ok(lr_array_lit_typed(b, dest_ty, &elems, span))
    when _ then lower_expr_to_rvalue(b, expr, span)
    end
  when ExprKind::ExprStringLit(s) then
 # a literal assigned into a BY-VALUE String destination is
    # demanded as an OWNED String — the static StaticStrPtr goes through the
    # owned conversion (string_from_static), never stored raw into the
    # String-typed slot. &str/ref destinations keep the raw static form.
    match dest_ty
    when Type::String then
      let owned = lower_string_literal_to_owned(b, expr, span)
      Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(owned) })
    when _ then lower_expr_to_rvalue(b, expr, span)
    end
  when _ then lower_expr_to_rvalue(b, expr, span)
  end
end

def lr_tuple_lit(inout b: MirBuilder, elems: Vec[Expr], span: Span) -> MirRvalue
  var ops = Vec::new()
  var elem_idx = 0
  while elem_idx < elems.len() do
    ops.push(lower_expr(b, &elems[elem_idx], span))
    elem_idx = elem_idx + 1
  end
  MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple, ops) }
end

# Extract the AstPath from an Expr that is known to be ExprPath.
# Uses a tiny 2-arm match (safe from the large-enum Swift compiler bug).
def path_in_expr(expr: Expr) -> AstPath
  match expr.kind
  when ExprKind::ExprPath(path) then path
  when _ then AstPath { segments: Vec::new(), span: Span { file: "", start: 0, end_pos: 0 } }
  end
end

# Lower a callee expression to a function operand, using string dispatch
# on ExprKind to avoid the large-enum Swift compiler match bug.
# Whether a callee expression is a direct (name/path) callable rather than a
# first-class value — direct callees MUST have a typed call target.
def expr_is_direct_callee(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(_) then true
  when ExprKind::ExprPath(_) then true
  when ExprKind::ExprFieldAccess(_, _) then true
  when _ then false
  end
end

# Whether a callee expression is a first-class closure/function VALUE whose
# call proceeds through the closure aggregate's code/env dispatch (an
# indirect call on the lowered value), NOT a direct (name/path) callable.
# The closure-call shape: an ExprIdent resolving to a local whose type is
# Type::Closure / Type::FnPtr (a closure local, a fn-typed parameter, a function
# pointer) — such a callee has NO DefId target, so its call node has NO
# TypedCall shape (the checker's record_typed_hir cannot assemble one and
# the call is not recorded in the node form). The MIR must not require the
# TypedCall for these calls: the closure-call lowering is the indirect call
# (lower_callee_expr's local arm lowers the callee to the closure aggregate
# operand), and the flat maps (call_def_ids / access_effects / expr_types)
# carry the data — the TypedCall stays OPTIONAL for closure callees.
def callee_is_closure_value(b: MirBuilder, callee_expr: Expr) -> Bool
  match callee_expr.kind
  when ExprKind::ExprIdent(name) then
    match lookup_current_local_id_by_name(b, name)
    when Option::Some(_) then
      match b.expr_types.get(callee_expr.node_id)
      when Option::Some(t) then
        match t
        when Type::FnPtr(_, _, _) then true
        when Type::Closure(_, _, _, _, _) then true
        when _ then false
        end
      when Option::None then false
      end
    when Option::None then false
    end
  when _ then false
  end
end

def lower_callee_expr(inout b: MirBuilder, callee_expr: Expr, span: Span) -> MirOperand
  let ck = expr_kind_name(&callee_expr.kind)
  if ck == "ExprIdent" then
    match callee_expr.kind
    when ExprKind::ExprIdent(name) then
      match lookup_current_local_id_by_name(b, name)
      when Option::Some(_) then return lower_expr(b, &callee_expr, span)
      when Option::None then return mir_fn_operand(b, name.clone())
      end
    when _ then ()
    end
  elsif ck == "ExprFieldAccess" then
    match callee_expr.kind
    when ExprKind::ExprFieldAccess(recv, field) then
      return mir_fn_operand(b, qualify_field_callee_name(&recv, field.clone()))
    when _ then ()
    end
  elsif ck == "ExprEnumVariant" then
    match callee_expr.kind
    when ExprKind::ExprEnumVariant(path, _) then
      return mir_fn_operand(b, resolve_static_path_callee_name(b, &path))
    when _ then ()
    end
  elsif ck == "ExprPath" then
    match callee_expr.kind
    when ExprKind::ExprPath(path) then
      let fn_name = resolve_static_path_callee_name(b, &path)
      return mir_fn_operand(b, fn_name)
    when _ then ()
    end
  end
  # Default fallback
  lower_expr(b, &callee_expr, span)
end

# ———————————————————————————————————————————————————————————————
# IR-SYNTHESIZED MirFnItem CONSTRUCTION ENUMERATION (ZERO-INFERENCE)
# ———————————————————————————————————————————————————————————————
# Every MirFnItem construction that is IR-INTERNAL (carries no AST call
# node and therefore no checker-recorded instance) is enumerated here and
# classified against the monomorphizer's fail-closed rule (a generic base
# with NO instance payload records an error — inference is never
# performed). The complete inventory:
#
#  1. THE DEINIT/DRAIN/DESTROY GLUE (emit_plan_deinit and friends) —
#     five intrinsic calls, all members of the `__intrinsic_*` family
#     (monomorphic per call: the MIR passes the concrete argument types,
#     and none of these names is a generic MIR function):
#       __intrinsic_array_destroy  (Array backing release)
#       __intrinsic_set_drain_one  (destructive Set drain)
#       __intrinsic_set_destroy    (Set backing release)
#       __intrinsic_map_drain_one  (destructive Map drain)
#       __intrinsic_map_destroy    (Map backing release)
#     The recursive drop GLUE CHAINS themselves are MirDeinit terminators
#     carrying the finalizer's SEMANTIC InstanceId (DeinitPlan payloads —
#     see emit_plan_deinit), not MirCall operands — they never enter the
#     monomorphizer's worklist.
#  2. THE STATIC-INITIALIZATION "CALLS" — statics/consts are lowered to
#     constant OPERANDS (lower_static_init_operand: a Vec::new()/Map::new()/
#     Set::new() initializer becomes a zero constant), never to MirCall —
#     no generic call reaches the monomorphizer from this path.
#  3. THE CLOSURE LOWERING (lower_expr's ExprClosure arm) — the closure's
#     fn-item operand is a synthesized name ("closure#N") consumed by the
#     closure AGGREGATE, never a MirCall callee; closures are non-generic
#     synthesized functions.
#  4. THE PROJECTED FOR-LOOP LENGTH CALL (lower_for_projected) — the ONE
#     genuinely-generic IR call: the callee is the generic method base
#     "Vec__len" (self carries Param("T")). It attaches its instance BY
#     CONSTRUCTION from method_def_ids (the resolver's method DefId + the
#     iterable's element type — the MIR passes concrete arg types), so it
#     carries a solved instance like every other generic call.
#  5. All OTHER MirFnItem constructions (mir_fn_operand /
#     mir_fn_operand_with_instance / attach_call_instance / lr_call /
#     lr_static_path_call / the method-call lowering) belong to SOURCE
#     call sites — their instances come from mir_call_instance (the typed
#     call target + the checker's solved substitution). The intrinsic
#     method-call targets (__intrinsic_int_to_string and friends) are
#     `__intrinsic_*` family members and are not generic MIR functions.
#
# A generic base with NO instance payload therefore cannot be produced by
# lowering; if one still reaches the monomorphizer, it FAILS CLOSED there.
#
# ———————————————————————————————————————————————————————————————
# the call site's semantic callee identity. When the typed program
# recorded a call target (DefId) for this call node, wrap it as the
# InstanceId payload of the MirFnItem. The instance's substs are the TYPE
# CHECKER's SOLVED substitution when the typed call_instances carries an
# entry for this call node (the callee's generic args in the callee's
# parameter order): the solved substitutions from the type checker are the
# AUTHORITY. When absent (a synthesized call — IR-only callees carry no
# DefId; a residual unsolved shape stays unrecorded), the substs stay
# EMPTY — ZERO-INFERENCE (fail-closed): the monomorphizer records an error
# for a generic callee with no usable instance instead of inferring.
#
# (final): the monomorphizer consumes this instance payload. The
# instance field survives every substitution/rewrite pass on the way to the
# monomorphizer — substitute_operand in mono.tg (re-exported by
# trait_resolve.tg) carries c.instance
# (and substitutes its substs under the caller's specialization map)
# through specialization, and rewrite_call_sites_in_program carries
# const_val.instance through the call-site rewrite — so a call with a solved
# instance reaches monomorphize_program with NON-EMPTY substs, and the
# monomorphizer uses them DIRECTLY (zero inference; instance_key mangling).
# (final): the checker records a solved instance for EVERY source-call
# shape — impl-registry generic methods, builtin-method generics
# (Option::map / Result::and_then /...), extension-impl methods
# (`impl[T, I: Iterator[T]] I`), and return-type-only parameters solved by
# the caller's annotation context (resolve_pending_call_instances) — so no
# call-site inference remains: the enumeration above covers every
# IR-synthesized shape, and the monomorphizer fails closed on anything
# else.
def mir_call_instance(b: MirBuilder, call_node_id: Int) -> Option[InstanceId]
 # (phase 2): the TypedCall's callee — the strong TypedCallee
  # identity (TypedCallee::Def(CallableId) recorded directly by the
  # checker) — is the PRIMARY semantic callee identity for a recorded
  # source call; the flat call_def_ids is the fallback for the nodes the
  # checker recorded only in the flat map (the typed-call assembly failure
  # class). The closure-call marker (TypedCallee::Closure — a closure VALUE
  # invoked) carries no DefId: the flat map misses for it too, and the
  # call keeps the name-only operand (the closure-call lowering path).
  var did: Option[DefId] = Option::None
  match typed_call_of(b, call_node_id)
  when Option::Some(tc) then
    match tc.callee
    when TypedCallee::Def(cid) then did = Option::Some(cid.def)
    when TypedCallee::Closure then ()
    end
  when Option::None then
    match b.call_def_ids.get(call_node_id)
    when Option::Some(d) then did = Option::Some(d)
    when Option::None then ()
    end
  end
  match did
  when Option::Some(did_v) then
 # the ids.tg InstanceId shape — the def field
    # is the CallableId newtype wrapping the call target's DefId
    # (InstanceId { def: CallableId { def: did }, substs }).
    match b.call_instances.get(call_node_id)
    when Option::Some(substs) then Option::Some(InstanceId { def: CallableId { def: did_v }, substs: substs.clone() })
    when Option::None then Option::Some(InstanceId { def: CallableId { def: did_v }, substs: Vec::new() })
    end
  when Option::None then Option::None
  end
end

# (IntrinsicId through MirCall): the SEMANTIC intrinsic classification
# of a SOURCE call node — the checker's typed_intrinsics record (the
# per-call-node attachment made at call-recording time by
# record_intrinsic_classification: the explicit __intrinsic_* family and
# the classified builtin-container method calls). The lowering stamps the
# MirCall with this id at the SOURCE call sites (lr_call,
# lr_static_path_call, the method-call arm); codegen reads the stamped id
# first and falls back to the semantic router only for the synthesized
# calls (which carry Option::None here). node_id 0 (a synthesized/IR-only
# call) never stamps.
def mir_call_intrinsic_of(b: MirBuilder, call_node_id: Int) -> Option[IntrinsicId]
  if call_node_id == 0 then
    return Option::None
  end
  match b.typed_intrinsics.get(call_node_id)
  when Option::Some(iid) then Option::Some(iid)
  when Option::None then Option::None
  end
end

# Attach the semantic instance to a name-built MirFnItem operand.
# Only MirConstant/MirFnItem operands carry the instance payload; callees
# lowered to values (first-class fn temporaries) and non-call constants are
# returned unchanged — the name-only form for synthesized/IR-only callees
# whose typed call target lookup misses (per the IR-synthesized enumeration
# above, none of those callees is a generic base; a generic base with no
# payload fails closed at the monomorphizer).
# when the instance carries a top-level-function DefId, the MirFnItem
# NAME is rewritten to the instance's fn_owner_key_of_def base (the emission name
# the callee was lowered under) — the call reference and the emitted
# function label then agree, and resolve_callee_label resolves through the
# fn_alias identity entry. Methods/intrinsics/externs/entry keep their names
# (mir_callee_emission_name).
def attach_call_instance(b: MirBuilder, op: MirOperand, instance: Option[InstanceId]) -> MirOperand
  match op.kind
  when MirOperandKind::MirConstant(constant) then
    match constant.kind
    when MirConstantKind::MirFnItem(name) then
      let emission_name = mir_callee_emission_name(b, name.clone(), instance)
      MirOperand {
        kind: MirOperandKind::MirConstant(constant_fn_item_with_instance(emission_name, constant.ty.clone(), instance))
      }
    when _ then duplicate_operand(op)
    end
  when _ then duplicate_operand(op)
  end
end

def lr_call(inout b: MirBuilder, callee_expr: Expr, arg_exprs: Vec[Expr], span: Span, call_node_id: Int) -> MirRvalue
  let callee_kind = expr_kind_name(&callee_expr.kind)
  if callee_kind == "ExprPath" then
    let callee_path = path_in_expr(callee_expr)
    if is_vec_like_from_path(&callee_path) && arg_exprs.len() == 1 then
      let first_arg_kind = expr_kind_name(&arg_exprs[0].kind)
      if first_arg_kind == "ExprArrayLit" then
        match arg_exprs[0].kind
        when ExprKind::ExprArrayLit(elems) then
          match lower_vec_like_from_array_call(b, &callee_path, &elems, span)
          when Result::Ok(rv) then return rv
          when Result::Err(e) then b.errors.push(e)
          end
        when _ then ()
        end
      end
    end
  end

 # the call's DefId identity from the typed call_targets is recorded
  # on the MirFnItem (instance payload) — the call site carries the DefId
  # identity, not just the string. A missing typed target (synthesized
  # callee) keeps the name-only form.
 # attach_call_instance also RENAMES the MirFnItem to the instance's
  # DefId-derived emission name (fn_owner_key_of_def) for top-level-function
  # callees, so the call reference matches the callee's emitted name — the
  # name-based operand is kept only for synthesized/IR-only callees and the
  # linking-boundary names (extern/intrinsic/method/entry).
  var callee_op = lower_callee_expr(b, callee_expr, span)
  callee_op = attach_call_instance(b, &callee_op, mir_call_instance(b, call_node_id))
  # Typed call identity: the TypedCall's callee (the strong TypedCallee —
  # TypedCallee::Def(CallableId) recorded directly in the tree) is the
  # authority for a recorded source call; the resolver/type checker
  # computed call_targets (the flat call_def_ids) for the nodes the
  # checker recorded only in the flat map; MIR must not silently
  # re-resolve by name. When the typed target is missing for a
  # DIRECT callee (name/path) in BOTH maps, that is a compiler internal
  # error — the name-based operand is kept only as the ABI symbol. The
  # closure-call shape is the EXCEPTION: a callee that is a closure/function
  # VALUE (a local whose type is Type::Closure — e.g. `let c = || x;
  # c(0)` or a fn-typed parameter `f(x)`) has no DefId target and no
  # TypedCall shape (the checker-side record limitation); the call proceeds
  # through the closure aggregate's code/env dispatch with the flat maps
  # carrying the data — the TypedCall is OPTIONAL for closure callees, and
  # the missing-target ICE must not fire for them.
  var typed_callee_ok = false
  match typed_call_of(b, call_node_id)
  when Option::Some(_) then typed_callee_ok = true
  when Option::None then ()
  end
  if !typed_callee_ok then
    match b.call_def_ids.get(call_node_id)
    when Option::Some(_) then ()
    when Option::None then
      if expr_is_direct_callee(callee_expr) && !callee_is_closure_value(b, callee_expr) && call_node_id != 0 then
        b.errors.push("internal error: missing typed call target for direct callee")
      end
    end
  end
 # a SOURCE call's result type is the typed tree's record
  # (TypedExpr.ty for the call node — the flat expr_types is the
  # derived-index fallback; missing in BOTH is an internal error,
  # fail-closed). A synthesized call (node_id 0) is typed AT THE
  # CONSTRUCTION SITE: the callee's REGISTERED declared return type
  # (mir_lookup_fn_ret_type — the declared type, never a shape
  # re-derivation); Unit when the callee never registered one.
  var ret_type = Type::Unit
  if call_node_id != 0 then
    match typed_expr_ty(b, call_node_id)
    when Option::Some(typed_ty) then
      ret_type = typed_ty
    when Option::None then
      b.errors.push("internal error: missing typed expression type for call node " + call_node_id.to_string() + " during MIR lowering")
    end
  else
    match callee_expr.kind
    when ExprKind::ExprIdent(name) then
      let local_ty = lookup_local_type_by_name(b, name.clone())
      match local_ty
      when Type::FnPtr(_, _, f_ret) then ret_type = f_ret
      when Type::Closure(_, _, f_ret, _, _) then ret_type = f_ret
      when _ then ret_type = mir_lookup_fn_ret_type(b, name.clone())
      end
    when ExprKind::ExprFieldAccess(recv, field_name) then
      ret_type = mir_lookup_fn_ret_type(b, qualify_field_callee_name(&recv, field_name.clone()))
    when ExprKind::ExprEnumVariant(path, _) then
      ret_type = mir_lookup_fn_ret_type(b, resolve_static_path_callee_name(b, &path))
    when ExprKind::ExprPath(path) then
      ret_type = mir_lookup_fn_ret_type(b, resolve_static_path_callee_name(b, &path))
    when _ then ()
    end
  end

  let ret_tmp = add_temp(b, mir_call_result_temp_type(ret_type), span)
  let dest_place = place_local(ret_tmp)
  let success_blk = create_block(b)

 # the callee NAME for the owned-String demand rule (by-value
  # String params convert literal arguments to owned String objects).
  let fc_name = match callee_expr.kind
  when ExprKind::ExprIdent(name) then Option::Some(name.clone())
  when ExprKind::ExprFieldAccess(_, field_name) then Option::Some(qualify_field_callee_name(&callee_expr, field_name.clone()))
  when ExprKind::ExprEnumVariant(path, _) then Option::Some(resolve_static_path_callee_name(b, &path))
  when ExprKind::ExprPath(path) then Option::Some(resolve_static_path_callee_name(b, &path))
  when _ then Option::None
  end

  var mir_args = Vec::new()
  var arg_idx = 0
  while arg_idx < arg_exprs.len() do
    mir_args.push(lower_call_arg(b, Option::Some(callee_expr), fc_name, arg_idx, &arg_exprs[arg_idx], span, call_node_id, arg_idx))
    arg_idx = arg_idx + 1
  end

  set_terminator(b, MirTerminatorKind::MirCall {
    dest: dest_place,
    func: callee_op,
    args: mir_args,
    success: success_blk,
    intrinsic: mir_call_intrinsic_of(b, call_node_id),
    unwind: Option::None
  }, span)

  b.current_block = Option::Some(success_blk)

 # the @budget ALLOCATION metric's consume: an intrinsic allocation in
  # the annotated function consumes ONE unit (THIS invocation's frame-slot
  # counter — FrameInfo.budget_alloc_offset, zeroed by the prologue —
  # increments; codegen traps when it exceeds the declared limit carried
  # as the statement's amount).
  if mir_budget_has_resource(b, "alloc") then
    match mir_call_intrinsic_of(b, call_node_id)
    when Option::Some(iid) then
      if intrinsic_allocates(&iid) then
        push_stmt(b, MirStatementKind::MirBudgetConsume("alloc".to_string(), mir_budget_limit_of(b, "alloc")), span)
      end
    when Option::None then ()
    end
  end

  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(ret_tmp))
  }) }
end

def is_registered_enum_path(b: MirBuilder, path: AstPath) -> Bool
  let maybe_type = if path.segments.len() >= 2 then
    path.segments[path.segments.len() - 2].clone()
  else
    ""
  end
  match b.enum_variants.get(maybe_type)
  when Option::Some(_) then true
  when Option::None then false
  end
end

def lr_static_path_call(inout b: MirBuilder, path: AstPath, args: Vec[Expr], span: Span, node_id: Int) -> MirRvalue
  if is_vec_like_from_path(path) && args.len() == 1 then
    let args0_kind = expr_kind_name(&args[0].kind)
    if args0_kind == "ExprArrayLit" then
      match args[0].kind
      when ExprKind::ExprArrayLit(elems) then
        match lower_vec_like_from_array_call(b, path, &elems, span)
        when Result::Ok(rv) then return rv
        when Result::Err(e) then b.errors.push(e)
        end
      when _ then ()
      end
    end
  end

  let fn_name = resolve_static_path_callee_name(b, path)
 # when a typed call target exists for this node (the resolver
  # records module-qualified path targets and the checker threads them by
  # node id), the MirFnItem's emission name is the instance's fn_owner_key_of_def
  # base — first-class fn-item VALUES of top-level functions then reference
  # the same derived label the function was emitted under. When the lookup
  # misses (a synthesized/IR-only shape), the callee keeps the name-only
  # form (per the IR-synthesized enumeration, none of those callees is a
  # generic base; a generic base with no payload fails closed at the
  # monomorphizer).
  var callee_op = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem(fn_name.clone()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  callee_op = attach_call_instance(b, &callee_op, mir_call_instance(b, node_id))
  var mir_args = Vec::new()
  var arg_idx = 0
  while arg_idx < args.len() do
    mir_args.push(lower_call_arg(b, Option::None, Option::Some(fn_name.clone()), arg_idx, &args[arg_idx], span, node_id, arg_idx))
    arg_idx = arg_idx + 1
  end
 # a SOURCE static-path call's result type is the typed tree's
  # record (fail-closed on a missing entry). A synthesized call (node_id 0)
  # is typed AT THE CONSTRUCTION SITE: the callee's REGISTERED declared
  # return type, then the static/const declaration's typed type for a
  # static-path VALUE (the declared types — never a shape re-derivation);
  # Unit when neither registered one.
  var ret_type = Type::Unit
  if node_id != 0 then
    match typed_expr_ty(b, node_id)
    when Option::Some(typed_ty) then
      ret_type = typed_ty
    when Option::None then
      b.errors.push("internal error: missing typed expression type for call node " + node_id.to_string() + " during MIR lowering")
    end
  else
    ret_type = mir_lookup_fn_ret_type(b, fn_name)
    if ret_type == Type::Unit && path.segments.len() > 0 then
      match b.static_types.get(path.segments[path.segments.len() - 1].clone())
      when Option::Some(st_ty) then ret_type = st_ty
      when Option::None then ()
      end
    end
  end
  let ret_tmp = add_temp(b, mir_call_result_temp_type(ret_type), span)
  let dest_place = place_local(ret_tmp)
  let success_blk = create_block(b)
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: dest_place,
    func: callee_op,
    args: mir_args,
    success: success_blk,
    intrinsic: mir_call_intrinsic_of(b, node_id),
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(success_blk)
 # the @budget ALLOCATION metric's consume (see lr_call — an intrinsic
  # allocation in the annotated function consumes one unit).
  if mir_budget_has_resource(b, "alloc") then
    match mir_call_intrinsic_of(b, node_id)
    when Option::Some(iid) then
      if intrinsic_allocates(&iid) then
        push_stmt(b, MirStatementKind::MirBudgetConsume("alloc".to_string(), mir_budget_limit_of(b, "alloc")), span)
      end
    when Option::None then ()
    end
  end
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(ret_tmp))
  }) }
end

def lr_enum_construct(inout b: MirBuilder, path: AstPath, args: Vec[Expr], span: Span, node_id: Int) -> Result[MirRvalue, String]
  var ops = Vec::new()
  var field_names = Vec::new()
  let enum_name = if path.segments.len() >= 2 then
    path.segments[path.segments.len() - 2].clone()
  else
    path_to_string(path)
  end
 # (phase 2): the TypedExprKind::Variant's variant id (the strong
  # TypedVariant identity — VariantId recorded directly by the checker) is
  # the authority for a recorded source variant construction — the
  # discriminant is read THROUGH the VariantId from the typed variant
  # table, and the aggregate's enum TypeId is the VariantId's owner. The
  # flat resolution (typed_variant_id / type_name_to_id — themselves the
  # typed tables) covers the unrecorded nodes.
  let disc = match resolve_construction_variant_discriminant(b, path, node_id)
  when Result::Ok(found) then found
  when Result::Err(e) then return Result::Err(e)
  end
  field_names.push("_tag")
  ops.push(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirInt(disc),
      ty: Type::Int,
      instance: Option::None
    })
  })
  for i in 0..args.len() do
    field_names.push(i.to_string())
  end
  var arg_idx = 0
  while arg_idx < args.len() do
    ops.push(lower_expr(b, &args[arg_idx], span))
    arg_idx = arg_idx + 1
  end
  let enum_tid = match construction_enum_tid(b, node_id, &enum_name)
  when Option::Some(tid) then tid
  when Option::None then
    return Result::Err("cannot lower enum variant: unknown enum type '" + enum_name + "'")
  end
  Result::Ok(MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(enum_tid, field_names), ops) })
end

def lr_enum_record_construct(inout b: MirBuilder, path: AstPath, fields: Vec[(String, Expr)], span: Span, node_id: Int) -> Result[MirRvalue, String]
  var ops = Vec::new()
  var field_names = Vec::new()
  let enum_name = if path.segments.len() >= 2 then
    path.segments[path.segments.len() - 2].clone()
  else
    path_to_string(path)
  end
 # (phase 2): the TypedExprKind::Variant's variant id (the strong
  # TypedVariant identity) is the authority for a recorded source
  # record-variant construction (the discriminant through the VariantId,
  # the aggregate TypeId from its owner); the flat typed-table resolution
  # covers the unrecorded nodes.
  let disc = match resolve_construction_variant_discriminant(b, path, node_id)
  when Result::Ok(found) then found
  when Result::Err(e) then return Result::Err(e)
  end
  field_names.push("_tag")
  ops.push(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirInt(disc),
      ty: Type::Int,
      instance: Option::None
    })
  })
  var field_idx = 0
  while field_idx < fields.len() do
    let field = fields[field_idx]
    field_names.push(field.0.clone())
    ops.push(lower_expr(b, &field.1, span))
    field_idx = field_idx + 1
  end
  let enum_tid = match construction_enum_tid(b, node_id, &enum_name)
  when Option::Some(tid) then tid
  when Option::None then
    return Result::Err("cannot lower enum record: unknown enum type '" + enum_name + "'")
  end
  Result::Ok(MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(enum_tid, field_names), ops) })
end

def lr_enum_variant(inout b: MirBuilder, path: AstPath, args: Vec[Expr], span: Span, node_id: Int) -> Result[MirRvalue, String]
  if is_registered_enum_path(b, path) then
    return lr_enum_construct(b, path, args, span, node_id)
  end
  Result::Ok(lr_static_path_call(b, path, args, span, node_id))
end

# Lower a method-call receiver expression to a Place, using string dispatch
# on ExprKind to avoid the large-enum Swift compiler match bug.
def lower_receiver_place(inout b: MirBuilder, receiver: Expr, span: Span) -> Place
  let rk = expr_kind_name(&receiver.kind)
  var recv_place = place_local(MirLocalId { id: 0 })
  if rk == "ExprIdent" then
    match receiver.kind
    when ExprKind::ExprIdent(_) then recv_place = lower_place(b, &receiver)
    when _ then ()
    end
  elsif rk == "ExprSelfRef" then
    match receiver.kind
    when ExprKind::ExprSelfRef then recv_place = lower_place(b, &receiver)
    when _ then ()
    end
  elsif rk == "ExprFieldAccess" then
    match receiver.kind
    when ExprKind::ExprFieldAccess(_, _) then recv_place = lower_place(b, &receiver)
    when _ then ()
    end
  elsif rk == "ExprRawDeref" then
    match receiver.kind
    when ExprKind::ExprRawDeref(_) then recv_place = lower_place(b, &receiver)
    when _ then ()
    end
  elsif rk == "ExprIndex" then
    match receiver.kind
    when ExprKind::ExprIndex(_, _) then recv_place = lower_place(b, &receiver)
    when _ then ()
    end
  else
    let recv_tmp = add_temp(b, mir_source_expr_ty(b, &receiver), span)
    match lower_expr_to_rvalue(b, &receiver, span)
    when Result::Ok(rv) then
      push_assign(b, place_local(recv_tmp), rv, span)
    when Result::Err(e) then
      b.errors.push(e)
    end
    recv_place = place_local(recv_tmp)
  end
  recv_place
end

# ———————————————————————————————————————————————————————————————
# MIR-visible collection ownership operations
# ———————————————————————————————————————————————————————————————
# The collection ownership operations are lowered HERE, at the concrete
# METHOD-CALL sites, as ordinary MIR:
#   - the element-replacement drops (the array-set old element, the
#     indexed-assignment old element) — MirDeinit terminators carrying the
#     concrete element glue at data + index*stride, BEFORE the store;
#   - the stored-KEY drop on Map::remove and the stored-ELEMENT drop on
#     Set::remove — the runtime copies the value/element out and unlinks
#     the record; the MIR drops the returned key/element address through
#     the concrete glue;
#   - the sink-KEY teardown on Map::insert and the old-element drop on
#     Set::insert (the replacement contract) — the runtime preserves the
#     stored key / rewrites the stored element; the MIR destroys the
#     incoming key / the replaced old element when the key was found;
#   - the ownership CLEARS — per-element drop loops for arrays, drain-and-
#     drop loops for maps/sets — while trivial (no needs_drop) element
#     types keep the fast intrinsic.
# The runtime never knows about ownership: transfer_store / _tg_array_set
# just write the image; the remove/drain helpers transfer bytes and unlink
# records. A DEFERRED receiver (a generic body's Param/Var element types)
# cannot resolve the concrete glue at lowering and keeps the plain wrapper
# call — the monomorphized std wrappers are the documented residual
# boundary (the same boundary the array-set insertion has).
# ———————————————————————————————————————————————————————————————

# The bare collection name of a receiver type ("" when not a collection).
def mir_collection_bare_name(b: MirBuilder, ty: Type) -> String
  match ty
  when Type::Adt(tid, _) then
    match b.typed_type_names.get(tid.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
  when _ then ""
  end
end

# The receiver operand for a synthesized intrinsic call: a borrowed
# receiver place (its type at the place is a reference/pointer) crosses
# as its reference value — the codegen's intrinsic dispatch derefs it
# once to the collection header; an owned receiver crosses through a
# synthetic re-borrow temp (mirroring the method-call lowering's
# recv_op construction).
def mir_recv_operand(inout b: MirBuilder, recv_place: Place, recv_place_type: Type, recv_type: Type, span: Span) -> MirOperand
  match recv_place_type
  when Type::RefInternal(_, _) then MirOperand { kind: MirOperandKind::MirCopy(recv_place.clone()) }
  when Type::Ptr(_) then MirOperand { kind: MirOperandKind::MirCopy(recv_place.clone()) }
  when Type::PtrMut(_) then MirOperand { kind: MirOperandKind::MirCopy(recv_place.clone()) }
  when _ then
    let recv_ref_tmp = add_temp(b, Type::RefInternal(recv_type.clone(), false), span)
    push_stmt(b, MirStatementKind::MirAssign(place_local(recv_ref_tmp), MirRvalue {
      kind: MirRvalueKind::MirRef(recv_place.clone())
    }), span)
    MirOperand { kind: MirOperandKind::MirCopy(place_local(recv_ref_tmp)) }
  end
end

# The Option[V] type of a synthesized ownership-call destination.
def mir_option_type(b: MirBuilder, inner: Type) -> Type
  Type::Adt(TypeId { id: b.lang_items.option }, Vec::from([inner.clone()]))
end

# The discriminant of a std Option variant, fail-closed on absence.
def mir_option_discriminant(inout b: MirBuilder, variant_name: String, fallback: Int) -> Int
  resolve_enum_variant_discriminant_or(b, AstPath {
    segments: Vec::from(["Option".to_string(), variant_name.clone()]),
    span: span_dummy()
  }, fallback)
end

# The indexed-assignment old-element drop: when the assignment target is
# an ExprIndex (or FixedArray constant index) whose element type owns
# resources, the concrete element glue instance is returned so the caller
# can emit the old element's MirDeinit BEFORE the store overwrites the
# slot (the checker records no assign-drop plan for projected targets —
# its machinery is root-local-plain only — so the MIR is the sole drop
# authority here). Option::None for trivial elements, non-index targets,
# and deferred (generic-body) element types — the monomorphized std
# wrappers are the documented residual boundary.
def mir_try_indexed_assign_drop(inout b: MirBuilder, target: Expr, place: Place) -> Option[InstanceId]
  let tkind = expr_kind_name(&target.kind)
  if tkind != "ExprIndex" && tkind != "ExprAccess" then
    return Option::None
  end
  let last_proj = if place.projections.len() > 0 then Option::Some(place.projections[place.projections.len() - 1]) else Option::None end
  match last_proj
  when Option::Some(Projection::ProjIndex(_)) then ()
  when Option::Some(Projection::ProjConstantIndex(_)) then ()
  when _ then return Option::None
  end
  let elem_ty = mir_place_type(place, b)
  mir_try_glue_instance(b, &elem_ty)
end

# Map::remove over an owning K: the runtime _tg_map_remove_key copies the
# removed VALUE image into the caller's v_tmp slot and returns the removed
# record's KEY ADDRESS (0 when absent — the record is already unlinked);
# the MIR drops the stored key through the concrete K glue on the returned
# address, then re-encodes the V slot as the Option[V] value (the
# codegen's option_wrap — the same layout decisions the map ops use).
def mir_emit_map_remove_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  k_glue: InstanceId,
  v_ty: Type,
  arg_exprs: Vec[Expr],
  span: Span,
  call_node_id: Int,
  fc_name: String
) -> MirRvalue
  let v_tmp = add_temp(b, v_ty.clone(), span)
  let v_addr_tmp = add_temp(b, Type::Ptr(Type::Unit), span)
  push_assign(b, place_local(v_addr_tmp), MirRvalue { kind: MirRvalueKind::MirRef(place_local(v_tmp)) }, span)
  let key_arg = lower_call_arg(b, Option::None, Option::Some(fc_name.clone()), 1, &arg_exprs[0], span, call_node_id, 0)
  let key_addr_tmp = add_temp(b, Type::Ptr(Type::Unit), span)
  let rm_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_map_remove_key".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  switch_to_block(b, call_blk)
  var rm_args = Vec::new()
  rm_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  rm_args.push(key_arg)
  rm_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place_local(v_addr_tmp)) }) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(key_addr_tmp),
    func: rm_callee,
    args: rm_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  # Found (address != 0): drop the stored key at the returned address;
  # absent (0): skip the drop — both merge into the Option wrap.
  switch_to_block(b, disc_blk)
  let drop_blk = create_block(b)
  let wrap_blk = create_block(b)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: wrap_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: MirOperand { kind: MirOperandKind::MirCopy(place_local(key_addr_tmp)) }, targets: targets, default_target: drop_blk }, span)
  switch_to_block(b, drop_blk)
  set_terminator(b, MirTerminatorKind::MirDeinit {
    place: place_deref(place_local(key_addr_tmp)),
    deinit_fn: k_glue,
    target: wrap_blk,
    unwind: Option::None
  }, span)
  # The Option[V] re-encode: option_wrap(v_addr) — the codegen reads the
  # V image from the slot (V <= 8: the value word; V > 8: the address).
  switch_to_block(b, wrap_blk)
  let wrap_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_option_wrap".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let opt_tmp = add_temp(b, mir_option_type(b, v_ty), span)
  let wrap_succ = create_block(b)
  var wrap_args = Vec::new()
  wrap_args.push(MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(place_local(v_addr_tmp)) }) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(opt_tmp),
    func: wrap_callee,
    args: wrap_args,
    success: wrap_succ,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(wrap_succ)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(opt_tmp))
  }) }
end

# Set::remove over an owning T: the runtime returns the removed element's
# ADDRESS (the record's key slot — 0 when absent); the MIR drops the
# stored element through the concrete T glue and turns the address test
# into the Bool result.
def mir_emit_set_remove_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  t_glue: InstanceId,
  arg_exprs: Vec[Expr],
  span: Span,
  call_node_id: Int,
  fc_name: String
) -> MirRvalue
  let item_arg = lower_call_arg(b, Option::None, Option::Some(fc_name.clone()), 1, &arg_exprs[0], span, call_node_id, 0)
  let elem_addr_tmp = add_temp(b, Type::Ptr(Type::Unit), span)
  let rm_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_set_remove_key".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  switch_to_block(b, call_blk)
  var rm_args = Vec::new()
  rm_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  rm_args.push(item_arg)
  rm_args.push(MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(operand_int(0)) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(elem_addr_tmp),
    func: rm_callee,
    args: rm_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  # Found: drop the stored element; absent: false.
  switch_to_block(b, disc_blk)
  let drop_blk = create_block(b)
  let true_blk = create_block(b)
  let false_blk = create_block(b)
  let merge_blk = create_block(b)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: false_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: MirOperand { kind: MirOperandKind::MirCopy(place_local(elem_addr_tmp)) }, targets: targets, default_target: drop_blk }, span)
  switch_to_block(b, drop_blk)
  set_terminator(b, MirTerminatorKind::MirDeinit {
    place: place_deref(place_local(elem_addr_tmp)),
    deinit_fn: t_glue,
    target: true_blk,
    unwind: Option::None
  }, span)
  let res_tmp = add_temp(b, Type::Bool, span)
  switch_to_block(b, true_blk)
  push_assign(b, place_local(res_tmp), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirBool(true), ty: Type::Bool, instance: Option::None })
  }) }, span)
  set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  switch_to_block(b, false_blk)
  push_assign(b, place_local(res_tmp), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirBool(false), ty: Type::Bool, instance: Option::None })
  }) }, span)
  set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  b.current_block = Option::Some(merge_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(res_tmp))
  }) }
end

# Map::insert over an owning K — the SINK-KEY TEARDOWN: the runtime
# preserves the stored key on the found path (the replacement contract —
# the old VALUE is extracted and returned as the Option[V]); the incoming
# key's image was moved into the call but is NOT consumed by the runtime,
# so the MIR drops it through the concrete K glue at the caller's key slot
# exactly when the returned Option is Some.
def mir_emit_map_insert_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  key_slot: Place,
  k_glue: InstanceId,
  v_ty: Type,
  arg_exprs: Vec[Expr],
  span: Span,
  call_node_id: Int,
  fc_name: String
) -> MirRvalue
  let key_arg = lower_call_arg(b, Option::None, Option::Some(fc_name.clone()), 1, &arg_exprs[0], span, call_node_id, 0)
  let val_arg = lower_call_arg(b, Option::None, Option::Some(fc_name.clone()), 2, &arg_exprs[1], span, call_node_id, 1)
  let opt_tmp = add_temp(b, mir_option_type(b, v_ty), span)
  let ins_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_map_insert".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  switch_to_block(b, call_blk)
  var ins_args = Vec::new()
  ins_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  ins_args.push(key_arg)
  ins_args.push(val_arg)
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(opt_tmp),
    func: ins_callee,
    args: ins_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  # The Option discriminant decides the incoming key's fate: Some (found)
  # -> the incoming key image at the caller's slot is destroyed; None
  # (fresh slot) -> the image was moved into the map, nothing to drop.
  switch_to_block(b, disc_blk)
  let disc_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(disc_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(opt_tmp)) }, span)
  let some_disc = mir_option_discriminant(b, &"Some".to_string(), 0)
  let none_disc = mir_option_discriminant(b, &"None".to_string(), 1)
  let drop_blk = create_block(b)
  let merge_blk = create_block(b)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: some_disc, target: drop_blk })
  targets.push(SwitchTarget { value: none_disc, target: merge_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp), targets: targets, default_target: merge_blk }, span)
  switch_to_block(b, drop_blk)
  set_terminator(b, MirTerminatorKind::MirDeinit {
    place: key_slot,
    deinit_fn: k_glue,
    target: merge_blk,
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(merge_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(opt_tmp))
  }) }
end

# Set::insert over an owning T — the REPLACEMENT drop: the runtime's
# found path rewrites the stored element with the incoming image and
# returns the fresh allocation holding the OLD element (extract-then-
# write, symmetric with the map value replacement); the MIR drops the old
# element through the concrete T glue when the result is nonzero, and the
# address test is the Bool result (false = a fresh slot was created).
def mir_emit_set_insert_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  t_glue: InstanceId,
  arg_exprs: Vec[Expr],
  span: Span,
  call_node_id: Int,
  fc_name: String
) -> MirRvalue
  let item_arg = lower_call_arg(b, Option::None, Option::Some(fc_name.clone()), 1, &arg_exprs[0], span, call_node_id, 0)
  let old_addr_tmp = add_temp(b, Type::Ptr(Type::Unit), span)
  let ins_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_set_insert".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  switch_to_block(b, call_blk)
  var ins_args = Vec::new()
  ins_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  ins_args.push(item_arg)
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(old_addr_tmp),
    func: ins_callee,
    args: ins_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  switch_to_block(b, disc_blk)
  let drop_blk = create_block(b)
  let true_blk = create_block(b)
  let false_blk = create_block(b)
  let merge_blk = create_block(b)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: false_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: MirOperand { kind: MirOperandKind::MirCopy(place_local(old_addr_tmp)) }, targets: targets, default_target: drop_blk }, span)
  switch_to_block(b, drop_blk)
  set_terminator(b, MirTerminatorKind::MirDeinit {
    place: place_deref(place_local(old_addr_tmp)),
    deinit_fn: t_glue,
    target: true_blk,
    unwind: Option::None
  }, span)
  let res_tmp = add_temp(b, Type::Bool, span)
  switch_to_block(b, true_blk)
  push_assign(b, place_local(res_tmp), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirBool(true), ty: Type::Bool, instance: Option::None })
  }) }, span)
  set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  switch_to_block(b, false_blk)
  push_assign(b, place_local(res_tmp), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirBool(false), ty: Type::Bool, instance: Option::None })
  }) }, span)
  set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  b.current_block = Option::Some(merge_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(res_tmp))
  }) }
end

# Array/Vec::clear over an owning T: the per-element drop loop (the
# concrete element glue at data + i*stride for i in 0..len) runs first,
# then the fast intrinsic sets len = 0 (capacity retained). Trivial
# element types keep the plain intrinsic call.
def mir_emit_array_clear_owned(
  inout b: MirBuilder,
  recv_place: Place,
  recv_op: MirOperand,
  elem_glue: InstanceId,
  span: Span
) -> MirRvalue
  let idx_local = add_local(b, "clear_idx", Type::Int, false, span)
  let len_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(len_tmp), MirRvalue { kind: MirRvalueKind::MirLen(recv_place.clone()) }, span)
  push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int, instance: Option::None })
  }) }, span)
  let header_blk = create_block(b)
  let body_blk = create_block(b)
  let inc_blk = create_block(b)
  let exit_blk = create_block(b)
  switch_to_block(b, header_blk)
  let cmp_tmp = add_temp(b, Type::Bool, span)
  push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
    MirBinOp::Lt,
    operand_copy_local(idx_local),
    operand_copy_local(len_tmp)
  ) }, span)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: targets, default_target: body_blk }, span)
  # body: drop the element at data + i*stride (the concrete glue), then
  # increment — the element order is 0..len-1, always in bounds.
  switch_to_block(b, body_blk)
  var elem_projs = recv_place.projections.clone()
  elem_projs.push(Projection::ProjIndex(idx_local))
  let elem_place = Place { local: recv_place.local, projections: elem_projs }
  set_terminator(b, MirTerminatorKind::MirDeinit {
    place: elem_place,
    deinit_fn: elem_glue,
    target: inc_blk,
    unwind: Option::None
  }, span)
  switch_to_block(b, inc_blk)
  let inc_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(inc_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
    MirBinOp::Add,
    operand_copy_local(idx_local),
    operand_int(1)
  ) }, span)
  push_assign(b, place_local(idx_local), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(inc_tmp))
  }) }, span)
  set_terminator(b, MirTerminatorKind::MirGoto(header_blk), span)
  # len = 0 (the fast intrinsic — capacity retained).
  switch_to_block(b, exit_blk)
  let cl_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_array_clear".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let cl_ret = add_temp(b, Type::Int, span)
  let cl_succ_blk = create_block(b)
  var cl_args = Vec::new()
  cl_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(cl_ret),
    func: cl_callee,
    args: cl_args,
    success: cl_succ_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  b.current_block = Option::Some(cl_succ_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirUnit, ty: Type::Unit, instance: Option::None })
  }) }
end

# Map::clear over owning K/V: the DRAIN-AND-DROP loop — the runtime
# unlinks each live entry and returns its image (__intrinsic_map_drain_one
# — "the drain's own cleanup"), the MIR drops the key and the value
# through their concrete glues, until the drain returns None. The buckets
# arena and capacity are retained (no destroy). Trivial K and V keep the
# fast intrinsic (_tg_map_clear).
def mir_emit_map_clear_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  k_ty: Type,
  v_ty: Type,
  k_glue: Option[InstanceId],
  v_glue: Option[InstanceId],
  span: Span
) -> MirRvalue
  let dr_ret = add_temp(b, mir_option_type(b, &Type::Tuple(vec![k_ty.clone(), v_ty.clone()])), span)
  let dr_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_map_drain_one".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  let some_blk = create_block(b)
  let none_blk = create_block(b)
  let succ_blk = create_block(b)
  switch_to_block(b, call_blk)
  var dr_args = Vec::new()
  dr_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(dr_ret),
    func: dr_callee,
    args: dr_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  switch_to_block(b, disc_blk)
  let disc_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(disc_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(dr_ret)) }, span)
  let some_disc = mir_option_discriminant(b, &"Some".to_string(), 0)
  let none_disc = mir_option_discriminant(b, &"None".to_string(), 1)
  var dr_targets = Vec::new()
  dr_targets.push(SwitchTarget { value: some_disc, target: some_blk })
  dr_targets.push(SwitchTarget { value: none_disc, target: none_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp), targets: dr_targets, default_target: none_blk }, span)
  # Some: drop the value and the key of the drained entry (the concrete
  # glues at the Option[Some] payload projections), then drain again.
  switch_to_block(b, some_blk)
  let some_vid = mir_synth_variant(b, &place_local(dr_ret), &"Some".to_string(), "map-clear drain")
  var v_projs = place_local(dr_ret).projections.clone()
  v_projs.push(Projection::Variant(some_vid))
  v_projs.push(Projection::TupleIndex(1))
  let v_place = Place { local: dr_ret, projections: v_projs }
  var k_projs = place_local(dr_ret).projections.clone()
  k_projs.push(Projection::Variant(some_vid))
  k_projs.push(Projection::TupleIndex(0))
  let k_place = Place { local: dr_ret, projections: k_projs }
  var chain_target = call_blk
  match k_glue
  when Option::Some(kg) then
    let k_blk = create_block(b)
    switch_to_block(b, k_blk)
    set_terminator(b, MirTerminatorKind::MirDeinit { place: k_place, deinit_fn: kg, target: chain_target, unwind: Option::None }, span)
    chain_target = k_blk
  when Option::None then ()
  end
  match v_glue
  when Option::Some(vg) then
    let v_blk = create_block(b)
    switch_to_block(b, v_blk)
    set_terminator(b, MirTerminatorKind::MirDeinit { place: v_place, deinit_fn: vg, target: chain_target, unwind: Option::None }, span)
    chain_target = v_blk
  when Option::None then ()
  end
  switch_to_block(b, some_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(chain_target), span)
  # None: drained — the map is empty, capacity retained.
  switch_to_block(b, none_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(succ_blk), span)
  let entry_blk = create_block(b)
  switch_to_block(b, entry_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(call_blk), span)
  b.current_block = Option::Some(succ_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirUnit, ty: Type::Unit, instance: Option::None })
  }) }
end

# Set::clear over an owning T: the drain-and-drop loop (set_drain_one
# unlinks + returns each element image; the MIR drops it through the
# concrete T glue) until None. Trivial T keeps the fast intrinsic.
def mir_emit_set_clear_owned(
  inout b: MirBuilder,
  recv_op: MirOperand,
  t_ty: Type,
  t_glue: InstanceId,
  span: Span
) -> MirRvalue
  let sd_ret = add_temp(b, mir_option_type(b, t_ty), span)
  let sd_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem("__intrinsic_set_drain_one".to_string()),
      ty: Type::FnPtr(Vec::new(), Box::new(Type::Unit), Vec::new()),
      instance: Option::None
    })
  }
  let call_blk = create_block(b)
  let disc_blk = create_block(b)
  let some_blk = create_block(b)
  let none_blk = create_block(b)
  let succ_blk = create_block(b)
  switch_to_block(b, call_blk)
  var sd_args = Vec::new()
  sd_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(recv_op) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(sd_ret),
    func: sd_callee,
    args: sd_args,
    success: disc_blk,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  switch_to_block(b, disc_blk)
  let disc_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(disc_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(sd_ret)) }, span)
  let some_disc = mir_option_discriminant(b, &"Some".to_string(), 0)
  let none_disc = mir_option_discriminant(b, &"None".to_string(), 1)
  var sd_targets = Vec::new()
  sd_targets.push(SwitchTarget { value: some_disc, target: some_blk })
  sd_targets.push(SwitchTarget { value: none_disc, target: none_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp), targets: sd_targets, default_target: none_blk }, span)
  switch_to_block(b, some_blk)
  let some_vid = mir_synth_variant(b, &place_local(sd_ret), &"Some".to_string(), "set-clear drain")
  var elem_projs = place_local(sd_ret).projections.clone()
  elem_projs.push(Projection::Variant(some_vid))
  let elem_place = Place { local: sd_ret, projections: elem_projs }
  let elem_drop_blk = create_block(b)
  switch_to_block(b, elem_drop_blk)
  set_terminator(b, MirTerminatorKind::MirDeinit { place: elem_place, deinit_fn: t_glue, target: call_blk, unwind: Option::None }, span)
  switch_to_block(b, some_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(elem_drop_blk), span)
  switch_to_block(b, none_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(succ_blk), span)
  let entry_blk = create_block(b)
  switch_to_block(b, entry_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(call_blk), span)
  b.current_block = Option::Some(succ_blk)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant { kind: MirConstantKind::MirUnit, ty: Type::Unit, instance: Option::None })
  }) }
end

# The ownership interception: the concrete method-call site entry.
# Returns Some(lowered rvalue) when the ownership sequence replaced the
# plain wrapper call; None keeps the pre-existing path.
def mir_try_collection_ownership_lowering(
  inout b: MirBuilder,
  method_name: String,
  recv_place: Place,
  recv_type: Type,
  arg_exprs: Vec[Expr],
  span: Span,
  call_node_id: Int
) -> Option[MirRvalue]
  let recv_named = mir_collection_bare_name(b, recv_type)
  if recv_named == "" then
    return Option::None
  end
  let fc_name = recv_named.clone() + "__" + method_name.clone()
  let recv_place_ty = mir_place_type(recv_place, b)
  let recv_op = mir_recv_operand(b, recv_place, &recv_place_ty, recv_type, span)
  match recv_type
  when Type::Adt(_, rargs) then
    if method_name == "remove" && arg_exprs.len() >= 1 then
      if recv_named == "Map" && rargs.len() >= 2 then
        let k_ty = rargs[0].clone()
        let v_ty = rargs[1].clone()
        match mir_try_glue_instance(b, &k_ty)
        when Option::Some(k_glue) then
          return Option::Some(mir_emit_map_remove_owned(b, recv_op, k_glue, &v_ty, arg_exprs, span, call_node_id, &fc_name))
        when Option::None then ()
        end
      elsif recv_named == "Set" && rargs.len() >= 1 then
        let t_ty = rargs[0].clone()
        match mir_try_glue_instance(b, &t_ty)
        when Option::Some(t_glue) then
          return Option::Some(mir_emit_set_remove_owned(b, recv_op, t_glue, arg_exprs, span, call_node_id, &fc_name))
        when Option::None then ()
        end
      end
    elsif method_name == "insert" then
      if recv_named == "Map" && rargs.len() >= 2 && arg_exprs.len() >= 2 then
        let k_ty = rargs[0].clone()
        let v_ty = rargs[1].clone()
        match mir_try_glue_instance(b, &k_ty)
        when Option::Some(k_glue) then
          # The incoming key slot must be a recoverable place (the caller's
          # frame slot holding the consumed key image).
          let key_slot = match arg_exprs[0].kind
          when ExprKind::ExprAccess(inner) then
            if expr_is_place_like(&inner) then Option::Some(lower_place(b, &inner)) else Option::None end
          when _ then
            if expr_is_place_like(&arg_exprs[0]) then Option::Some(lower_place(b, &arg_exprs[0])) else Option::None end
          end
          match key_slot
          when Option::Some(ks) then
            return Option::Some(mir_emit_map_insert_owned(b, recv_op, ks, k_glue, &v_ty, arg_exprs, span, call_node_id, &fc_name))
          when Option::None then ()
          end
        when Option::None then ()
        end
      elsif recv_named == "Set" && rargs.len() >= 1 && arg_exprs.len() >= 1 then
        let t_ty = rargs[0].clone()
        match mir_try_glue_instance(b, &t_ty)
        when Option::Some(t_glue) then
          let item_slot = match arg_exprs[0].kind
          when ExprKind::ExprAccess(inner) then
            if expr_is_place_like(&inner) then Option::Some(lower_place(b, &inner)) else Option::None end
          when _ then
            if expr_is_place_like(&arg_exprs[0]) then Option::Some(lower_place(b, &arg_exprs[0])) else Option::None end
          end
          match item_slot
          when Option::Some(_) then
            return Option::Some(mir_emit_set_insert_owned(b, recv_op, t_glue, arg_exprs, span, call_node_id, &fc_name))
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    elsif method_name == "clear" && arg_exprs.len() == 0 then
      if recv_named == "Map" && rargs.len() >= 2 then
        let k_ty = rargs[0].clone()
        let v_ty = rargs[1].clone()
        let k_glue = mir_try_glue_instance(b, &k_ty)
        let v_glue = mir_try_glue_instance(b, &v_ty)
        match k_glue
        when Option::Some(_) then
          return Option::Some(mir_emit_map_clear_owned(b, recv_op, &k_ty, &v_ty, k_glue, v_glue, span))
        when Option::None then
          match v_glue
          when Option::Some(_) then
            return Option::Some(mir_emit_map_clear_owned(b, recv_op, &k_ty, &v_ty, k_glue, v_glue, span))
          when Option::None then ()
          end
        end
      elsif recv_named == "Set" && rargs.len() >= 1 then
        let t_ty = rargs[0].clone()
        match mir_try_glue_instance(b, &t_ty)
        when Option::Some(t_glue) then
          return Option::Some(mir_emit_set_clear_owned(b, recv_op, &t_ty, t_glue, span))
        when Option::None then ()
        end
      elsif (recv_named == "Array" || recv_named == "Vec") && rargs.len() >= 1 then
        let elem_ty = rargs[0].clone()
        match mir_try_glue_instance(b, &elem_ty)
        when Option::Some(elem_glue) then
          return Option::Some(mir_emit_array_clear_owned(b, recv_place, recv_op, elem_glue, span))
        when Option::None then ()
        end
      end
    end
  when _ then ()
  end
  Option::None
end

def lower_expr_to_rvalue(inout b: MirBuilder, expr: Expr, span: Span) -> Result[MirRvalue, String]
  
  # Use string-based dispatch via expr_kind_name() to avoid Stage0 Swift
  # compiler bug with value matches on large (41-variant) enums like ExprKind.
  # expr_kind_name() matches on &ExprKind (reference) which works correctly.
  # Each arm below uses a tiny 2-arm match (1 specific + 1 default) which
  # the Swift compiler's if-else chain generation handles correctly.
  let kind_name = expr_kind_name(&expr.kind)
  
  if kind_name == "ExprIntLit" then
    match expr.kind
    when ExprKind::ExprIntLit(n) then return Result::Ok(move_rvalue(operand_int(n)))
    when _ then ()
    end
    
  elsif kind_name == "ExprFloatLit" then
    match expr.kind
    when ExprKind::ExprFloatLit(f) then return Result::Ok(move_rvalue(operand_float(f)))
    when _ then ()
    end
    
  elsif kind_name == "ExprBoolLit" then
    match expr.kind
    when ExprKind::ExprBoolLit(bool_lit) then return Result::Ok(move_rvalue(operand_bool(bool_lit)))
    when _ then ()
    end
    
  elsif kind_name == "ExprCharLit" then
    match expr.kind
    when ExprKind::ExprCharLit(c) then return Result::Ok(move_rvalue(operand_constant(constant_char(c))))
    when _ then ()
    end
    
  elsif kind_name == "ExprStringLit" then
    match expr.kind
    when ExprKind::ExprStringLit(s) then
 # the literal is the STATIC STRVIEW form (raw label);
      # owned-String demand sites convert via string_from_static
      # (lower_expr_rvalue_to_dest / lower_call_arg).
      return Result::Ok(move_rvalue(operand_string(s)))
    when _ then ()
    end
    
  elsif kind_name == "ExprNilLit" then
    return Result::Ok(move_rvalue(operand_unit()))
    
  elsif kind_name == "ExprIdent" then
    match expr.kind
    when ExprKind::ExprIdent(name) then return Result::Ok(lr_ident(b, name, expr.node_id))
    when _ then ()
    end
    
  elsif kind_name == "ExprSelfRef" then
    return Result::Ok(lr_self_ref(b))
    
  elsif kind_name == "ExprBinaryOp" then
    match expr.kind
    when ExprKind::ExprBinaryOp(op, left, right) then return Result::Ok(lr_binary(b, op, &left, &right, span))
    when _ then ()
    end
    
  elsif kind_name == "ExprUnaryOp" then
    match expr.kind
    when ExprKind::ExprUnaryOp(op, inner) then return Result::Ok(lr_unary(b, op, &inner, span))
    when _ then ()
    end
    
  elsif kind_name == "ExprRawDeref" then
    match expr.kind
    when ExprKind::ExprRawDeref(inner) then return Result::Ok(lr_deref(b, &inner, span))
    when _ then ()
    end

  elsif kind_name == "ExprArrayLit" then
    match expr.kind
    when ExprKind::ExprArrayLit(elems) then return Result::Ok(lr_array_lit(b, &elems, span))
    when _ then ()
    end

  elsif kind_name == "ExprTupleLit" then
    match expr.kind
    when ExprKind::ExprTupleLit(elems) then return Result::Ok(lr_tuple_lit(b, &elems, span))
    when _ then ()
    end

  elsif kind_name == "ExprCall" then
    match expr.kind
    when ExprKind::ExprCall(callee_expr, arg_exprs) then
      return Result::Ok(lr_call(b, &callee_expr, &arg_exprs, span, expr.node_id))
    when _ then ()
    end

  elsif kind_name == "ExprMethodCall" then
    match expr.kind
    when ExprKind::ExprMethodCall(receiver, method_name, type_args, arg_exprs) then
      let normalized_method_name = normalize_method_name(method_name.clone())
      # Lower receiver as a reference (address-of) for method calls.
      # If the receiver is not already place-like (for example a chained call
      # like vec.len().to_string()), first spill it into a temp local so we can
      # borrow that temp instead of falling back to local 0.
      var recv_place = lower_receiver_place(b, &receiver, span)
  
      # Try to resolve the receiver type for method name mangling.
      # For field access chains (e.g.  lex.tokens.push(x)), the AST-level
      # inference returns Unit for identifiers and field accesses.  We fall
      # back to the MIR local's declared type and then walk the field
      # projections so that  Lexer →.tokens → Vec[Token]  is resolved
      # correctly, producing Vec__push rather than Lexer__push.
      var recv_place_type = mir_place_type(&recv_place, b)
      if recv_place_type == Type::Unit then
        recv_place_type = mir_source_expr_ty(b, &receiver)
      end

      match recv_place_type
      when Type::Unit then
        match b.current_fn
        when Option::Some(func) then
          for local in func.locals do
            if local.id.id == recv_place.local.id then
              recv_place_type = local.ty.clone()
            end
          end
        when Option::None then ()
        end
      when _ then ()
      end

      var recv_type = recv_place_type.clone()

        # Distinguish between a receiver expression that is already a borrowed
        # value (e.g. `s: &String`, `lex: &Lexer`, `loaded: &Vec[Int]`) and a
        # place reached through a borrowed base (e.g. `self.loaded_paths`).
        # Only the former should bypass the synthetic re-borrow; otherwise we
        # accidentally turn `&T` receivers into `&&T` at runtime.
        var recv_is_borrowed = false
        match recv_place_type
        when Type::RefInternal(_, _) then recv_is_borrowed = true
        when Type::Ptr(_) then recv_is_borrowed = true
        when Type::PtrMut(_) then recv_is_borrowed = true
        when _ then ()
        end

        # Strip references/pointers so method resolution sees the underlying type.
        # mir_source_expr_ty may return Type::RefInternal(Adt(...), true) for `f: &mut Formatter`
        # which would not match the Type::Adt branch below without stripping.
        match recv_place_type
        when Type::RefInternal(inner, _) then recv_type = inner
        when Type::Ptr(inner) then recv_type = inner
        when Type::PtrMut(inner) then recv_type = inner
        when _ then ()
        end

 # the collection ownership operations (the stored-key /
        # stored-element drops on remove, the sink-key teardown on insert,
        # the ownership clears) lower HERE, at the concrete method-call
        # site, replacing the plain wrapper call when the receiver's
        # element types are concrete and own resources. The runtime never
        # knows about ownership — every drop is this MIR.
        match mir_try_collection_ownership_lowering(b, &normalized_method_name, &recv_place, &recv_type, &arg_exprs, span, expr.node_id)
        when Option::Some(own_rv) then
          return Result::Ok(own_rv)
        when Option::None then ()
        end

      var recv_op = MirOperand { kind: MirOperandKind::MirCopy(recv_place) }
      if recv_is_borrowed then
        ()
      else
        let recv_ref_tmp = add_temp(b, Type::RefInternal(recv_type.clone(), false), span)
        push_stmt(b, MirStatementKind::MirAssign(place_local(recv_ref_tmp), MirRvalue {
          kind: MirRvalueKind::MirRef(recv_place)
        }), span)
        recv_op = MirOperand {
          kind: MirOperandKind::MirCopy(place_local(recv_ref_tmp))
        }
      end

      var resolved_method = normalized_method_name.clone()
      match recv_type
      when Type::Int then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_int_to_string"
        end
      when Type::Float then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_float_to_string"
        end
      when Type::F32 then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_float_to_string"
        end
      when Type::F64 then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_float_to_string"
        end
      when Type::Bool then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_bool_to_string"
        end
      when Type::Char then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "__intrinsic_char_to_string"
        end
      when Type::Adt(tid, args) then
 # Adt form of the builtin compound collections mirrors the
        # canonical arms below (method-name mangling by container);
        # everything else keeps the pre-existing name-based resolution.
        let method_named = match b.typed_type_names.get(tid.id)
        when Option::Some(n) then mir_bare_type_name(&n)
        when Option::None then ""
        end
        if method_named == "Slice" || method_named == "Array" then
          resolved_method = "Vec__" + normalized_method_name.clone()
        elsif method_named == "Option" then
          resolved_method = "Option__" + normalized_method_name.clone()
        elsif method_named == "Result" then
          resolved_method = "Result__" + normalized_method_name.clone()
        elsif method_named == "Map" then
          resolved_method = "Map__" + normalized_method_name.clone()
        elsif method_named == "Set" then
          resolved_method = "Set__" + normalized_method_name.clone()
        else
          # Find the type name for this TypeId
          var type_name = ""
          for td in b.type_defs do
            if td.id.id == tid.id then
              type_name = td.name.clone()
            end
          end
          if type_name != "" then
            if normalized_method_name == "clone" then
 # the shared reference-counted handles (Rc AND the
              # std-declared WeakRc/ArcStrong/WeakArc) clone through their
              # RETAIN method ("Type__clone" — the retained duplication);
              # every other type clones through the bare intrinsic
              # "clone". The selection is the LangItems TypeId — never the
              # registered name. A snapshot missing a std-declared id (-1)
              # fails CLOSED to the intrinsic path (a missed retain would
              # duplicate a shared handle's count state — the ids are
              # always resolved for the prelude-carrying program).
              let li_clone = b.lang_items
              let is_shared_handle = (li_clone.rc != -1 && tid.id == li_clone.rc) ||
                (li_clone.weak_rc != -1 && tid.id == li_clone.weak_rc) ||
                (li_clone.arc_strong != -1 && tid.id == li_clone.arc_strong) ||
                (li_clone.weak_arc != -1 && tid.id == li_clone.weak_arc)
              if is_shared_handle then
                resolved_method = type_name + "__clone"
              else
                resolved_method = "clone"
              end
            else
              resolved_method = type_name + "__" + normalized_method_name.clone()
            end
 # EXTENSION-impl methods — an impl whose for_type is a
            # generic PARAMETER (`impl[T, I: Iterator[T]] I`) has no
            # receiver-type name; its methods lower as the impl-registered
            # mangled functions ("I__map", "I__any", "I__collect",...).
            # The receiver-type-based name (TypeName__method) is only valid
            # when that mangled function is actually registered in the
            # program (fn_ret_types); when it is not, the checker must have
            # resolved the call on an extension impl — fall back to the
            # bare method name registered for the param-for_type impls.
            if !b.fn_ret_types.contains_key(&resolved_method) then
              match b.param_impl_methods.get(normalized_method_name)
              when Option::Some(ext_mangled) then resolved_method = ext_mangled.clone()
              when Option::None then ()
              end
            end
          else
            if normalized_method_name == "clone" then
              resolved_method = "clone"
            else
              match b.impl_type_map.get(normalized_method_name)
              when Option::Some(tn) then resolved_method = tn + "__" + normalized_method_name.clone()
              when Option::None then ()
              end
 # unknown receiver type — the extension-impl fallback
              # (the receiver-type-based name above cannot apply at all).
              if !b.fn_ret_types.contains_key(&resolved_method) then
                match b.param_impl_methods.get(normalized_method_name)
                when Option::Some(ext_mangled2) then resolved_method = ext_mangled2.clone()
                when Option::None then ()
                end
              end
            end
          end
        end
      when Type::FixedArray(_, n) then
        # Fixed arrays: len/is_empty are compile-time constants — the count
        # is carried in the type. MirLen on the fixed-array place emits the
        # constant (no heap header read); is_empty is the count == 0 test.
        if normalized_method_name == "len" then
          let fixed_len_tmp = add_temp(b, Type::Int, span)
          push_assign(b, place_local(fixed_len_tmp), MirRvalue { kind: MirRvalueKind::MirLen(recv_place) }, span)
          return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirCopy(place_local(fixed_len_tmp))
          }) })
        elsif normalized_method_name == "is_empty" then
          return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirBool(n == 0),
              ty: Type::Bool,
              instance: Option::None
            })
          }) })
        end
      when Type::String then
        if normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          resolved_method = "clone"
        else
          resolved_method = "String__" + normalized_method_name.clone()
        end
      when _ then
        if normalized_method_name == "clone" then
          resolved_method = "clone"
        else
          match b.impl_type_map.get(normalized_method_name)
          when Option::Some(type_name) then resolved_method = type_name + "__" + normalized_method_name.clone()
          when Option::None then ()
          end
 # non-Named receiver — the extension-impl fallback (the
          # receiver-type-based name cannot apply at all; the checker
          # resolved the call on a param-for_type impl by unifying the
          # receiver with the head parameter).
          if !b.fn_ret_types.contains_key(&resolved_method) then
            match b.param_impl_methods.get(normalized_method_name)
            when Option::Some(ext_mangled3) then resolved_method = ext_mangled3.clone()
            when Option::None then ()
            end
          end
        end
      end

 # collection length operations are NOT lowered to the generic
      # MirLen rvalue here. `len`/`is_empty`/`capacity` resolve to the mangled
      # std impl methods (Vec__len / Map__len / Set__len /...), whose bodies
      # call the runtime length intrinsics (__intrinsic_array_len /
      # __intrinsic_map_len / __intrinsic_set_len / __intrinsic_array_capacity).
      # The byte offset of the length field in the collection header is
      # therefore decided by the intrinsic's implementation (codegen's `len`
      # handler → codegen_array_len), never by a generic MIR instruction.
 # the typed program records METHOD-call targets too (expr node id
      # -> DefId); the callee's MirFnItem records the instance when present,
      # and keeps the name-only form when the lookup misses.
 # the instance's DefId kind is Method, so the "Type__method"
      # mangled name stays UNCHANGED (mir_callee_emission_name renames only
      # DefKind::Function) — the finalizer and registered-Drop identities
      # depend on the method names; only top-level function names migrate to
      # DefId-derived emission names.
      let callee_op = mir_fn_operand_with_instance(b, resolved_method.clone(), mir_call_instance(b, expr.node_id))

      # Lower arguments: receiver first, then explicit args. The receiver's
      # effect is the TypedCall's receiver_effect (typed_arg_idx = -1); the
      # explicit args' effects are the TypedCallArg effects (the flat
      # access_effects / convention fallback covers the unrecorded nodes).
      let recv_effect = call_arg_effect(b, Option::None, 0, &receiver, expr.node_id, -1)
      var mir_args = Vec::new()
      mir_args.push(MirCallArg { effect: recv_effect, value: MirCallValue::Value(recv_op) })
      var arg_idx = 0
      while arg_idx < arg_exprs.len() do
 # the resolved method name feeds the owned-String demand
        # rule (by-value String params convert literal arguments).
        mir_args.push(lower_call_arg(b, Option::None, Option::Some(resolved_method.clone()), arg_idx + 1, &arg_exprs[arg_idx], span, expr.node_id, arg_idx))
        arg_idx = arg_idx + 1
      end

      if normalized_method_name == "push" && arg_exprs.len() > 0 then
        let pushed_ty = mir_source_expr_ty(b, &arg_exprs[0])
        refine_collection_local_type_from_push(b, &recv_place, &recv_place_type, &pushed_ty)
      end

 # (array-set old element): the runtime _tg_array_set OVERWRITES
      # the element at `index` without destroying the old one — an OWNING
      # element type leaks. The MIR lowering emits the old element's drop
      # (a MirDeinit carrying the ELEMENT type's generated drop-glue
      # instance — the glue function takes the element address, and the
      # element address = data + index*stride is expressed by the
      # ProjIndex projection on the receiver place) BEFORE the intrinsic
      # call. This covers both `arr.set(i, v)` (Vec__set / Array__set) and
      # the OrderedMap::insert pattern, whose entries-array overwrite is
      # the same Vec__set shape. Trivial/deferred element types get no drop
      # (nothing to destroy / the concrete glue after substitution).
      var set_drop_glue: Option[InstanceId] = Option::None
      var set_drop_index = MirLocalId { id: -1 }
      if normalized_method_name == "set" && mir_args.len() >= 2 then
        match recv_type
        when Type::Adt(rtid, rargs) then
          let recv_named = match b.typed_type_names.get(rtid.id)
          when Option::Some(n) then mir_bare_type_name(&n)
          when Option::None then ""
          end
          if (recv_named == "Array" || recv_named == "Vec") && rargs.len() >= 1 then
            let elem_ty2 = rargs[0].clone()
            match mir_try_glue_instance(b, &elem_ty2)
            when Option::Some(gi) then
              let idx_op = mir_call_arg_operand(&mir_args[1])
              let idx_local2 = mir_operand_local_or_temp(b, &idx_op, span)
              set_drop_glue = Option::Some(gi)
              set_drop_index = idx_local2
            when Option::None then ()
            end
          end
        when _ then ()
        end
      end

 # a SOURCE method call's result type is the typed tree's
      # record for the METHOD-CALL node (fail-closed on a missing entry).
      # A synthesized method call (node_id 0) is typed AT THE CONSTRUCTION
      # SITE: the checker-resolved method's REGISTERED declared return type
      # (mir_lookup_fn_ret_type — the declared type), then the known
      # receiver-shape result rules (clone -> receiver type; len/capacity
      # -> Int; the predicate set -> Bool; to_string/fmt -> String) — the
      # same knowledge the lowering has when it synthesizes the call.
      var ret_type = Type::Unit
      if expr.node_id != 0 then
        match typed_expr_ty(b, expr.node_id)
        when Option::Some(typed_ty) then ret_type = typed_ty
        when Option::None then
          b.errors.push("internal error: missing typed expression type for method call node " + expr.node_id.to_string() + " during MIR lowering")
        end
      else
        let resolved_ret_type = mir_lookup_fn_ret_type(b, resolved_method.clone())
        if resolved_ret_type != Type::Unit then
          ret_type = resolved_ret_type
        elsif normalized_method_name == "clone" then
          ret_type = recv_type.clone()
        elsif normalized_method_name == "len" || normalized_method_name == "capacity" then
          ret_type = Type::Int
        elsif normalized_method_name == "is_empty" || normalized_method_name == "contains" ||
              normalized_method_name == "contains_key" || normalized_method_name == "is_some" ||
              normalized_method_name == "is_none" || normalized_method_name == "is_ok" ||
              normalized_method_name == "is_err" || normalized_method_name == "starts_with" ||
              normalized_method_name == "ends_with" then
          ret_type = Type::Bool
        elsif normalized_method_name == "to_string" || normalized_method_name == "fmt" then
          ret_type = Type::String
        end
      end
      let ret_tmp = add_temp(b, mir_call_result_temp_type(ret_type), span)
      let dest_place = place_local(ret_tmp)
      
      # Create success block
      let success_blk = create_block(b)

      # The MirCall terminator always lands in a FRESH block; the block
      # holding the argument-lowering statements is routed to it (through
      # the old-element drop when the array-set fix applies — see above).
      let arg_blk = match b.current_block
      when Option::Some(ab) then ab
      when Option::None then MirBlockId { id: 0 }
      end
      let call_blk2 = create_block(b)
      switch_to_block(b, call_blk2)
      # Emit Call terminator
      set_terminator(b, MirTerminatorKind::MirCall {
        dest: dest_place,
        func: callee_op,
        args: mir_args,
        success: success_blk,
        intrinsic: mir_call_intrinsic_of(b, expr.node_id),
        unwind: Option::None
      }, span)
      switch_to_block(b, arg_blk)
      match set_drop_glue
      when Option::Some(sgi) then
        # The old element's drop (the element type's generated glue — the
        # element address = data + index*stride via ProjIndex) runs BEFORE
        # the intrinsic overwrite.
        var drop_projs = recv_place.projections.clone()
        drop_projs.push(Projection::ProjIndex(set_drop_index))
        let drop_place = Place { local: recv_place.local, projections: drop_projs }
        set_terminator(b, MirTerminatorKind::MirDeinit {
          place: drop_place,
          deinit_fn: sgi,
          target: call_blk2,
          unwind: Option::None
        }, span)
      when Option::None then
        set_terminator(b, MirTerminatorKind::MirGoto(call_blk2), span)
      end
      
      b.current_block = Option::Some(success_blk)
      
 # the @budget ALLOCATION metric's consume (see lr_call — an
      # intrinsic allocation in the annotated function consumes one unit;
      # the classified builtin-container methods — push/insert/extend/
      # reserve/... — and the __intrinsic_* allocators are the sites).
      if mir_budget_has_resource(b, "alloc") then
        match mir_call_intrinsic_of(b, expr.node_id)
        when Option::Some(iid) then
          if intrinsic_allocates(&iid) then
            push_stmt(b, MirStatementKind::MirBudgetConsume("alloc".to_string(), mir_budget_limit_of(b, "alloc")), span)
          end
        when Option::None then ()
        end
      end
      
 # a MANUAL deinit() call runs only the user finalizer. The
      # compiler-owned structural field cleanup must also run (exactly once):
      # chain the receiver's structural plan (the fields part of a
      # UserFinalizer plan, or a plain structural plan) into the success
      # block, so manually-deinitialized resources do not leak their fields.
 # the finalizer REGISTRATION is the identity source — a manual
      # call to a REGISTERED finalizer (finalizer_emission_names — the
      # emission-name index of the registered Drop/deinit callables), never
      # a bare name pattern.
      if b.finalizer_emission_names.contains(&resolved_method) then
        let recv_ty = mir_source_expr_ty(b, &receiver)
        var vis2 = Set::new()
        let recv_plan = deinit_plan_for_type(b, &recv_ty, &mut vis2)
        let fields_plan = match recv_plan
        when DeinitPlan::UserFinalizer(_, fields) then fields
        when _ then recv_plan
        end
        if !deinit_plan_is_trivial(&fields_plan) then
          let after_deinit = emit_plan_deinit(b, &recv_place, &fields_plan, success_blk, span, Option::None)
          switch_to_block(b, success_blk)
          set_terminator(b, MirTerminatorKind::MirGoto(after_deinit), span)
        end
      end
      
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(place_local(ret_tmp))
      }) })
    when _ then ()
    end

  elsif kind_name == "ExprFieldAccess" then
    match expr.kind
    when ExprKind::ExprFieldAccess(recv, field_name) then
      let base_place = lower_place(b, &recv)
      # If the base local has a reference type, auto-insert a ProjDeref
      let base_ty = lookup_local_type(b, &base_place.local)
      let needs_deref = match base_ty
      when Type::RefInternal(_, _) then true
      when _ then false
      end
      # Resolve field projection — typed field index first, name fallback
      let field_proj = typed_field_projection(b, expr.node_id, &field_name, &base_place)
      var new_projections = base_place.projections.clone()
      if needs_deref && base_place.projections.is_empty() then
        new_projections.push(Projection::ProjDeref)
      end
      new_projections.push(field_proj)
      let projected = Place {
        local: base_place.local,
        projections: new_projections
      }
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(projected)
      }) })
    when _ then ()
    end

  elsif kind_name == "ExprIndex" then
    match expr.kind
    when ExprKind::ExprIndex(base_expr, index_expr) then
      let base_place = lower_place(b, &base_expr)
      let idx_op = lower_expr(b, &index_expr, span)
      # Store index into a temp so we can reference it as a MirLocalId
      let idx_tmp = add_temp(b, Type::Int, span)
      push_stmt(b, MirStatementKind::MirAssign(place_local(idx_tmp), MirRvalue {
        kind: MirRvalueKind::MirMove(idx_op)
      }), span)
      var new_projections = base_place.projections.clone()
      # Only add ProjDeref when the base local is a reference type and no
      # projections have been applied yet (same logic as ExprFieldAccess).
      # ProjIndex already handles heap-collection header derefs, so an
      # unconditional ProjDeref here causes a double-dereference crash.
      let base_idx_ty = lookup_local_type(b, &base_place.local)
      let idx_needs_deref = match base_idx_ty
      when Type::RefInternal(_, _) then true
      when _ then false
      end
      if idx_needs_deref && base_place.projections.is_empty() then
        new_projections.push(Projection::ProjDeref)
      end
      new_projections.push(Projection::ProjIndex(idx_tmp))
      let projected = Place {
        local: base_place.local,
        projections: new_projections
      }
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(projected)
      }) })
    when _ then ()
    end

  elsif kind_name == "ExprClosure" then
    match expr.kind
    when ExprKind::ExprClosure(params, ret_ty, body) then
      # Full closure lowering with capture analysis and environment generation.
      #
      # 1. Analyze the closure body to find all free variables (captures)
      # 2. Create an environment struct holding captured values
      # 3. Generate a separate function taking the env as first parameter
      # 4. Return a closure aggregate (fn_ptr + env_ptr)
      
      let closure_name = "_closure" + b.temp_counter.to_string()
      b.temp_counter = b.temp_counter + 1
      
      # Step 1+2: THE SEMANTIC CAPTURE RECORD is the only capture source.
      # typed.closure_captures (closure node id -> captured local id ->
      # effect) was produced by the type checker and consumed by the
      # resource checker (ownership transfer into the closure); MIR builds
      # the closure env and the closure function's implicit capture
      # parameters from exactly that record. There is NO free-variable scan:
      # re-deriving captures in MIR would be a second, divergent analysis.
      var captures = Vec::new()
      var capture_ops = Vec::new()
      var capture_types = Vec::new()
      var capture_ids = Vec::new()
      match b.closure_captures.get(expr.node_id)
      when Option::Some(typed_caps) then
 # (the closure {code, env} ABI): the capture ORDER is the typed
        # capture tuple's order — the semantic local ids SORTED (the
        # checker's Type::Closure capture tuple is sorted by local id at
        # construction). The aggregate fields, the closure function's
        # capture params and the closure type's capture tuple must align
        # positionally — the registered {code, env} layout and the dispatch
        # depend on it. Collect the (id, effect) pairs first, sort, then
        # resolve.
        var cap_pairs: Vec[(Int, AccessEffect)] = Vec::new()
        for (cap_id, cap_effect) in typed_caps do
          cap_pairs.push((cap_id, cap_effect))
        end
        var csi = 1
        while csi < cap_pairs.len() do
          var csj = csi
          while csj > 0 && cap_pairs[csj].0 < cap_pairs[csj - 1].0 do
            let tmp = cap_pairs[csj]
            cap_pairs[csj] = cap_pairs[csj - 1]
            cap_pairs[csj - 1] = tmp
            csj = csj - 1
          end
          csi = csi + 1
        end
        for (cap_id, cap_effect) in cap_pairs do
          # cap_id is a SEMANTIC local id; the capture operand reads the
          # OUTER function's MIR local — map through semantic_to_mir (the
          # counters diverge as soon as any earlier function allocated
          # semantic locals).
          match b.semantic_to_mir.get(cap_id)
          when Option::Some(mid) then
            match lookup_local_id(b, MirLocalId { id: mid })
            when Option::Some(ml) then
              captures.push(ml.name.clone())
              capture_types.push(ml.ty.clone())
              capture_ids.push(cap_id)
              # A Consume capture MOVES the source local into the closure
              # (MirConsume); everything else copies. The MIR itself now
              # represents the ownership transfer — the semantic layer's
              # consumption fact is no longer the only carrier.
              match cap_effect
              when AccessEffect::Consume then
                capture_ops.push(MirOperand {
                  kind: MirOperandKind::MirConsume(place_local(MirLocalId { id: mid }))
                })
              when _ then
                capture_ops.push(MirOperand {
                  kind: MirOperandKind::MirCopy(place_local(MirLocalId { id: mid }))
                })
              end
            when Option::None then
              b.errors.push("internal error: closure capture MIR local _" + mid.to_string() + " missing")
            end
          when Option::None then
            b.errors.push("internal error: closure capture semantic local _" + cap_id.to_string() + " has no MIR local")
          end
        end
      when Option::None then ()
      end
      
      # Step 3: Build the closure function's parameter/return types — from
      # the closure's TYPED tree record (the checker's resolved
      # Type::Closure — the typed table is the authority; TypeExpr is
      # never interpreted after checking). A source closure without a typed
      # record is an internal error (fail-closed).
      var closure_fn_ty = Type::Unit
      match b.typed_exprs.get(expr.node_id)
      when Option::Some(cte) then closure_fn_ty = cte.ty.clone()
      when Option::None then
        b.errors.push("internal error: missing typed expression for closure node " + expr.node_id.to_string() + " during MIR lowering")
      end
      var param_types = Vec::new()
      var ret_type = Type::Unit
      match closure_fn_ty
 # (FnPtr/Closure split): the checker types the closure EXPRESSION
      # as the Closure form — ClosureId + signature + the capture tuple. The
      # signature split feeds the pending closure record (the conflation
      # form is are not part of the model).
      when Type::Closure(_, sig_params, sig_ret, _, _) then
        for sp in sig_params do
          param_types.push(sp.ty.clone())
        end
        ret_type = sig_ret.clone()
      when _ then
        b.errors.push("internal error: typed type of closure node " + expr.node_id.to_string() + " is not a closure type during MIR lowering")
      end
      
      # Step 4: Record the closure body to be lowered as a separate MirFunction
      # (This would be processed after the containing function)
      b.pending_closures.push(PendingClosure {
        name: closure_name.clone(),
        params: params.clone(),
        param_types: param_types.clone(),
        captures: captures.clone(),
        capture_types: capture_types.clone(),
        capture_ids: capture_ids.clone(),
        body: body.clone(),
        ret_type: ret_type.clone(),
        node_id: expr.node_id
      })
      
      # Step 5: Create the closure aggregate — (fn_ptr, env). The closure
      # function item is a synthesized IR-only callee: name-only form.
      let fn_op = MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirFnItem(closure_name.clone()),
          ty: Type::FnPtr(fn_param_types_of(&param_types), Box::new(ret_type.clone()), Vec::new()),
          instance: Option::None
        })
      }
      
      var agg_ops = Vec::new()
      agg_ops.push(fn_op)
      # Shared iteration is projected: clone each captured operand for the
      # move into the aggregate (consuming iteration is not supported yet).
      for cap_op in capture_ops do
        agg_ops.push(cap_op.clone())
      end
      
 # (the closure {code, env} ABI): the closure aggregate carries the
      # closure's SEMANTIC identity — ClosureId (the closure expression
      # node's id, the SAME identity the checker's Type::Closure uses — the
      # registered closure-object layout is keyed by it). The synthetic
 # temp-counter TypeId is not part of the model: no id is minted outside the
      # registered layout universe anymore.
      let closure_id = ClosureId { id: expr.node_id }
      
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Closure(closure_id), agg_ops) })
    when _ then ()
    end

  elsif kind_name == "ExprIf" then
    match expr.kind
    when ExprKind::ExprIf(if_expr) then
      let if_result_ty = mir_source_expr_ty(b, expr)
      return Result::Ok(lower_if_rvalue(b, &if_expr, span, if_result_ty))
    when _ then ()
    end

  elsif kind_name == "ExprBlock" then
    match expr.kind
    when ExprKind::ExprBlock(block) then
      if block.stmts.is_empty() then
        return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirUnit,
            ty: Type::Unit,
            instance: Option::None
          })
        }) })
      end
      let last_idx = block.stmts.len() - 1
      var i = 0
      while i < last_idx do
        lower_stmt(b, &block.stmts[i])
        if block_is_terminated(b) then
          return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirUnit,
              ty: Type::Unit,
              instance: Option::None
            })
          }) })
        end
        i = i + 1
      end

      return lower_final_block_stmt_to_rvalue(b, &block.stmts[last_idx])
    when _ then ()
    end

  elsif kind_name == "ExprStructLit" then
    match expr.kind
    when ExprKind::ExprStructLit(path, fields) then
      if is_registered_enum_path(b, &path) then
        return lr_enum_record_construct(b, &path, &fields, span, expr.node_id)
      end
      var ops = Vec::new()
      var field_names = Vec::new()
      for (field_name, field_value) in fields do
        field_names.push(field_name.clone())
        ops.push(lower_expr(b, &field_value, span))
      end
      # Resolve the struct's TypeId from the path
      let struct_name = path_to_string(&path)
      let struct_tid = match b.type_name_to_id.get(struct_name)
      when Option::Some(tid) then TypeId { id: tid }
      when Option::None then
        return Result::Err("cannot lower struct literal: unknown struct type '" + struct_name + "'")
      end
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(struct_tid, field_names), ops) })
    when _ then ()
    end

  elsif kind_name == "ExprEnumVariant" then
    match expr.kind
    when ExprKind::ExprEnumVariant(path, args) then
      return lr_enum_variant(b, &path, &args, span, expr.node_id)
    when _ then ()
    end

  elsif kind_name == "ExprCast" then
    match expr.kind
    when ExprKind::ExprCast(inner, target_ty) then
      let inner_op = lower_expr(b, &inner, span)
 # the cast's TARGET type is the cast expression's typed-tree
      # record (the checker's resolved cast result type — the typed table
      # is the authority; TypeExpr is never interpreted after checking).
      let target = mir_source_expr_ty(b, expr)
      # Use Transmute as the generic cast kind - specific casts would require type inference
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirCast(CastKind::Transmute, inner_op, target) })
    when _ then ()
    end

  elsif kind_name == "ExprPath" then
    match expr.kind
    when ExprKind::ExprPath(path) then
      # Resolve enum variant paths like Operator::None to their discriminant
      if path.segments.len() >= 2 then
        let enum_name = path.segments[path.segments.len() - 2]
        match resolve_enum_variant_discriminant(b, &path)
        when Result::Ok(disc) then
          # Check if this enum has any payload variants
          # Default to true for unknown enums (e.g. Option, Result from std)
          let has_payload = match b.enum_has_payload.get(enum_name)
          when Option::Some(hp) then hp
          when Option::None then true
          end
          if has_payload then
            # Mixed enum: heap-allocate with just the tag so representation is consistent
            let enum_tid = match b.type_name_to_id.get(enum_name)
            when Option::Some(tid) then TypeId { id: tid }
            when Option::None then
              return Result::Err("cannot lower enum variant: unknown enum type '" + enum_name + "'")
            end
            var ops = Vec::new()
            var fnames = Vec::new()
            fnames.push("_tag")
            ops.push(MirOperand {
              kind: MirOperandKind::MirConstant(MirConstant {
                kind: MirConstantKind::MirInt(disc),
                ty: Type::Int,
                instance: Option::None
              })
            })
            return Result::Ok(MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Struct(enum_tid, fnames), ops) })
          else
            # Simple enum (all no-payload): just the integer discriminant
            return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
              kind: MirOperandKind::MirConstant(MirConstant {
                kind: MirConstantKind::MirInt(disc),
                ty: Type::Int,
                instance: Option::None
              })
            }) })
          end
        when Result::Err(_) then
          # Not an enum variant path (e.g. a non-enum qualified path): keep
          # the historical MirString fallback. No discriminant is guessed.
          return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirString(path_to_string(&path)),
              ty: Type::String,
              instance: Option::None
            })
          }) })
        end
      else
        return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirString(path_to_string(&path)),
            ty: Type::String,
            instance: Option::None
          })
        }) })
      end
    when _ then ()
    end

  elsif kind_name == "ExprMatch" then
    match expr.kind
    when ExprKind::ExprMatch(m) then
      let result_ty = mir_source_expr_ty(b, expr)
      let result_tmp = add_temp(b, result_ty, span)
      lower_match_to_place(b, &m, place_local(result_tmp), span)
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(place_local(result_tmp))
      }) })
    when _ then ()
    end

  elsif kind_name == "ExprMacroCall" then
    match expr.kind
    when ExprKind::ExprMacroCall(name, args) then
      if name == "vec" then
        let vec_path = AstPath {
          segments: Vec::from(["Vec".to_string(), "from".to_string()]),
          span: span.clone()
        }
        return lower_vec_like_from_array_call(b, &vec_path, &args, span)
      else
        return Result::Err("unhandled macro invocation in lowering: " + name)
      end
    when _ then ()
    end

  elsif kind_name == "ExprAssign" then
    match expr.kind
    when ExprKind::ExprAssign(target, value) then
      # Assignment EXPRESSIONS share the statement-assignment replacement
      # semantics (drop old -> store new), keyed on the EXPRESSION's node id
      # ("assign::<expr id>" — the checker records the same key).
      let place = lower_place(b, &target)
      let value_ty = mir_source_expr_ty(b, &value)
      match lower_assign_drop_chain(b, expr.node_id, span, place.clone())
      when Option::Some(cont) then
        switch_to_block(b, cont)
        match lower_expr_to_rvalue(b, &value, span)
        when Result::Ok(rvalue) then
          push_assign(b, place, rvalue, span)
          refine_assignment_target_type(b, &place, &value_ty)
          refine_assignment_target_type_from_type(b, &place, &value_ty)
        when Result::Err(e) then
          b.errors.push(e)
        end
      when Option::None then
 # the indexed-assignment old element (same as the
        # statement form — the store overwrites data + index*stride, so an
        # owning element type is dropped through its concrete glue first).
        match mir_try_indexed_assign_drop(b, &target, &place)
        when Option::Some(ig) then
          let cont_blk = create_block(b)
          let drop_blk = create_block(b)
          match b.current_block
          when Option::Some(cur_blk) then
            switch_to_block(b, drop_blk)
            set_terminator(b, MirTerminatorKind::MirDeinit {
              place: place.clone(),
              deinit_fn: ig,
              target: cont_blk,
              unwind: Option::None
            }, span)
            switch_to_block(b, cur_blk)
            set_terminator(b, MirTerminatorKind::MirGoto(drop_blk), span)
          when Option::None then ()
          end
          switch_to_block(b, cont_blk)
          match lower_expr_to_rvalue(b, &value, span)
          when Result::Ok(rvalue) then
            push_assign(b, place, rvalue, span)
            refine_assignment_target_type(b, &place, &value_ty)
            refine_assignment_target_type_from_type(b, &place, &value_ty)
          when Result::Err(e) then
            b.errors.push(e)
          end
        when Option::None then
          match lower_expr_to_rvalue(b, &value, span)
          when Result::Ok(rvalue) then
            push_assign(b, place, rvalue, span)
            refine_assignment_target_type(b, &place, &value_ty)
            refine_assignment_target_type_from_type(b, &place, &value_ty)
          when Result::Err(e) then
            b.errors.push(e)
          end
        end
      end
      # The expression's VALUE is the newly stored value.
      let result_tmp = add_temp(b, value_ty, span)
      push_assign(b, place_local(result_tmp), MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(place.clone())
      }) }, span)
      return Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
        kind: MirOperandKind::MirCopy(place_local(result_tmp))
      }) })
    when _ then ()
    end

  elsif kind_name == "ExprTry" then
    match expr.kind
    when ExprKind::ExprTry(inner) then
 # `expr?` is ERASURE — the operand's value. There is no
      # throwing path: no throw/raise expression exists in the language,
      # the type checker types it as the operand's value (an unconstrained
      # fresh variable), the resource checker treats it as a pure
      # expression with no CFG edge, and the backend has no exception
      # runtime. Erasure matches the stage0 lowering and keeps the
      # compiler kernel — which uses `?` throughout (e.g.
      # `parse_toml(s)?`) — compiling through MIR.
      return lower_expr_to_rvalue(b, &inner, span)
    when _ then ()
    end

  else
    # Default fallback for unhandled variants: fail instead of silently
    # producing a Unit rvalue, so unsupported expression kinds surface as
    # lowering errors rather than corrupting generated code.
    return Result::Err("unhandled expression kind in lowering: " + kind_name)
  end
end

def lower_final_block_stmt_to_rvalue(inout b: MirBuilder, stmt: Stmt) -> Result[MirRvalue, String]
  let last_kind = stmt_kind_name(&stmt.kind)
  if last_kind == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(last_expr) then
      return lower_expr_to_rvalue(b, &last_expr, stmt.span)
    when _ then ()
    end
  end

  lower_stmt(b, stmt)
  Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirUnit,
      ty: Type::Unit,
      instance: Option::None
    })
  }) })
end

# Whether an expression is place-like (its address can be taken): the
# canonical predicate lives in ast.tg (expr_is_place_like — imported
# above; the single source of truth for the typed-HIR consumers).


def lower_place(inout b: MirBuilder, expr: Expr) -> Place
  let kind_name = expr_kind_name(&expr.kind)
  if kind_name == "ExprIdent" then
    match expr.kind
    when ExprKind::ExprIdent(name) then
    match lookup_current_local_id_by_name(b, name.clone())
    when Option::Some(local_id) then
      return place_local(local_id)
    when Option::None then
      # Check if this is a static/global variable
      if b.static_names.contains(name) then
 # the static's DefId (static_def_ids — the resolver's
        # module_symbols identity) is the reference payload; the emission
        # label derives from the DefId at backend symbol generation. A
        # registered static whose DefId never resolved is an internal
        # error (fail-closed), never a name-derived address.
        var st_did2 = DefId { module: ModuleId { id: -1 }, index: 0 }
        var st_did_ok2 = false
        match b.static_def_ids.get(name)
        when Option::Some(did2) then
          st_did2 = did2
          st_did_ok2 = true
        when Option::None then
          b.errors.push("internal error: static '" + name + "' has no resolver DefId during MIR lowering")
        end
        if st_did_ok2 then
          # Create a temp that holds the ADDRESS of the static
          let addr_tmp = add_temp(b, Type::Ptr(Type::Unit), Span { file: "", start: 0, end_pos: 0 })
          push_assign(b, place_local(addr_tmp), MirRvalue {
            kind: MirRvalueKind::MirMove(MirOperand {
              kind: MirOperandKind::MirConstant(MirConstant {
                kind: MirConstantKind::MirStaticAddr(DefId { module: ModuleId { id: st_did2.module.id }, index: st_did2.index }),
                ty: Type::Ptr(Type::Unit),
                instance: Option::None
              })
            })
          }, Span { file: "", start: 0, end_pos: 0 })
          # Return a place that derefs through the address pointer
          return place_deref(place_local(addr_tmp))
        end
      else
        return place_local(MirLocalId { id: 0 })
      end
    end
    when _ then ()
    end
  elsif kind_name == "ExprSelfRef" then
    match expr.kind
    when ExprKind::ExprSelfRef then
    match lookup_current_local_id_by_name(b, "self")
    when Option::Some(local_id) then
      return place_local(local_id)
    when Option::None then
      return place_local(MirLocalId { id: 0 })
    end
    when _ then ()
    end
  elsif kind_name == "ExprFieldAccess" then
    match expr.kind
    when ExprKind::ExprFieldAccess(recv, field) then
    # If recv is not place-like (e.g. a chained method call like
    # self.ptr.as_mut()), evaluate it into a temp local first and use
    # that as the place base.  Falling through to lower_place's catch-all
    # would otherwise yield place_local(MirLocalId{id:0}) and silently
    # compute the field address off local 0, corrupting unrelated memory.
    let base = if expr_is_place_like(recv) then
      lower_place(b, recv)
    else
      let recv_tmp_span = Span { file: "", start: 0, end_pos: 0 }
      let recv_tmp = add_temp(b, mir_source_expr_ty(b, recv), recv_tmp_span)
      match lower_expr_to_rvalue(b, recv, recv_tmp_span)
      when Result::Ok(rv) then
        push_assign(b, place_local(recv_tmp), rv, recv_tmp_span)
      when Result::Err(e) then
        b.errors.push(e)
      end
      place_local(recv_tmp)
    end
    # Auto-insert ProjDeref when base local is a reference and we haven't
    # already added projections (i.e., this is the first field access on
    # a &/&mut parameter).  Without this, emit_place_address would lose
    # one level of indirection for chained field accesses through refs.
    let base_ty = lookup_local_type(b, &base.local)
    let needs_deref = match base_ty
    when Type::RefInternal(_, _) then true
    when _ then false
    end
    let field_proj = typed_field_projection(b, expr.node_id, field, &base)
    var new_projections = base.projections.clone()
    if needs_deref && base.projections.is_empty() then
      new_projections.push(Projection::ProjDeref)
    end
    new_projections.push(field_proj)
    return Place { local: base.local, projections: new_projections }
    when _ then ()
    end
  elsif kind_name == "ExprRawDeref" then
    match expr.kind
    when ExprKind::ExprRawDeref(inner) then
    let base = if expr_is_place_like(inner) then
      lower_place(b, inner)
    else
      let tmp_span = Span { file: "", start: 0, end_pos: 0 }
      let tmp = add_temp(b, mir_source_expr_ty(b, inner), tmp_span)
      match lower_expr_to_rvalue(b, inner, tmp_span)
      when Result::Ok(rv) then
        push_assign(b, place_local(tmp), rv, tmp_span)
      when Result::Err(e) then
        b.errors.push(e)
      end
      place_local(tmp)
    end
    return place_deref(base)
    when _ then ()
    end
  elsif kind_name == "ExprIndex" then
    match expr.kind
    when ExprKind::ExprIndex(recv, index) then
    # Same spill-non-place-receivers rule as ExprFieldAccess.
    let base = if expr_is_place_like(recv) then
      lower_place(b, recv)
    else
      let recv_tmp_span = Span { file: "", start: 0, end_pos: 0 }
      let recv_tmp = add_temp(b, mir_source_expr_ty(b, recv), recv_tmp_span)
      match lower_expr_to_rvalue(b, recv, recv_tmp_span)
      when Result::Ok(rv) then
        push_assign(b, place_local(recv_tmp), rv, recv_tmp_span)
      when Result::Err(e) then
        b.errors.push(e)
      end
      place_local(recv_tmp)
    end
    # Evaluate the index expression and store in a temp
    let idx_op = lower_expr(b, index, Span { file: "", start: 0, end_pos: 0 })
    let idx_tmp = add_temp(b, Type::Int, Span { file: "", start: 0, end_pos: 0 })
    push_stmt(b, MirStatementKind::MirAssign(place_local(idx_tmp), MirRvalue {
      kind: MirRvalueKind::MirMove(idx_op)
    }), Span { file: "", start: 0, end_pos: 0 })
    # Only deref when the base local is a bare reference (same guard as
    # ExprFieldAccess).  ProjIndex handles heap-collection headers itself.
    let base_place_ty = lookup_local_type(b, &base.local)
    let place_needs_deref = match base_place_ty
    when Type::RefInternal(_, _) then true
    when _ then false
    end
    var projs = base.projections.clone()
    if place_needs_deref && base.projections.is_empty() then
      projs.push(Projection::ProjDeref)
    end
    projs.push(Projection::ProjIndex(idx_tmp))
    return Place { local: base.local, projections: projs }
    when _ then ()
    end
  end
  place_local(MirLocalId { id: 0 })
end

# Helper: lower a callee expression to a MirOperand for Call
def resolve_static_path_callee_name(b: MirBuilder, path: AstPath) -> String
  if path.segments.len() >= 2 then
    let maybe_type = path.segments[path.segments.len() - 2].clone()
    let maybe_method = path.segments[path.segments.len() - 1].clone()
    let is_enum = match b.enum_variants.get(maybe_type)
    when Option::Some(_) then true
    when Option::None then false
    end
    let norm_type = if maybe_type == "Array" then "Vec" else maybe_type end
    if norm_type == "String" && maybe_method == "from_bytes" then
      return "__intrinsic_string_from_bytes"
    end
    var has_registered_type = false
    match b.type_name_to_id.get(norm_type)
    when Option::Some(_) then has_registered_type = true
    when Option::None then ()
    end
    let is_known_type =
      norm_type == "Vec" || norm_type == "Map" || norm_type == "Set" ||
      norm_type == "String" || norm_type == "Formatter" || has_registered_type
    if !is_enum && is_known_type then
      return norm_type + "__" + maybe_method
    end
  end
  if path.segments.len() > 0 then
    path.segments[path.segments.len() - 1].clone()
  else
    "unknown"
  end
end


def lower_call_callee(inout b: MirBuilder, expr: Expr, span: Span) -> MirOperand
  match expr.kind
  when ExprKind::ExprIdent(name) then
    # Resolve bare identifier callees against the current function locals
    # without depending on Map.get(String) during bootstrap lowering.
    match lookup_current_local_id_by_name(b, name)
    when Option::Some(_) then
      # Indirect call through a local variable holding a function pointer
      lower_expr(b, expr, span)
    when Option::None then
      # Direct function call by name
      mir_fn_operand(b, name.clone())
    end
  when ExprKind::ExprFieldAccess(recv, field) then
    # Preserve qualified static calls such as Module::func or Type::new.
    mir_fn_operand(b, qualify_field_callee_name(&recv, field.clone()))
  when ExprKind::ExprEnumVariant(path, _) then
    mir_fn_operand(b, resolve_static_path_callee_name(b, &path))
  when ExprKind::ExprPath(path) then
    # Preserve type-qualified static calls (Vec::new, Map::new, etc.) when
    # they appear in callee position, while still allowing module-qualified
    # free functions to resolve by their bare name.
    let fn_name = resolve_static_path_callee_name(b, &path)
    mir_fn_operand(b, fn_name)
  when _ then
    # Indirect call through expression (function pointer / closure)
    lower_expr(b, expr, span)
  end
end

# Resolve a type through a chain of Place projections.
#
# Given a starting type (the base local's declared type) and a list of
# projections, follow the SEMANTIC projections to the type of the final
# element. Every projection is semantic :
#   - ProjDeref            strips one layer of Ref/RefMut/Ptr;
#   - Field(FieldId)       resolves BY ID — owner TypeId + field index —
#     against the struct def at the current point; a FieldId following a
#     Variant downcast (a variant-payload field) resolves by index against
#     the downcast's TUPLE of payload fields (tuples have no FieldId, so
#     the owner is not checked there — the downcast already established
#     the enum identity);
#   - Variant(VariantId)   the downcast — the typed variant table read
#     through the VariantId (owner + declaration-order index) yields the
#     variant's payload as Type::Tuple(fields);
#   - TupleIndex(idx)      a tuple element (the typed tuple form — tuples
#     have no FieldId);
#   - ProjIndex / ProjConstantIndex — the element type of the current
#     collection (mir_project_index_type).
# There are NO name-scan / numeric-index / discriminant fallbacks: a
# projection that does not resolve against the current type stops the walk
# and returns the current type (the verifier reports the mismatch).
def resolve_type_through_projections(b: MirBuilder, start_type: Type, projections: Vec[Projection]) -> Type
  var current = start_type
  var proj_idx = 0
  while proj_idx < projections.len() do
    let proj = projections[proj_idx]
    match proj
    when Projection::ProjDeref then
      current = match current
      when Type::RefInternal(inner, _) then inner
      when Type::Ptr(inner) then inner
      when Type::PtrMut(inner) then inner
      when other then other
      end
    when Projection::Variant(vid) then
      # The typed variant identity: the VariantId's owner must be the
      # projected type's Adt TypeId; the payload is the variant's fields as
      # a TUPLE (the typed variant table — declaration order).
      let vid_named_tid = match current
      when Type::RefInternal(inner, _) then
        match inner
        when Type::Adt(tid, _) then Option::Some(tid.id)
        when _ then Option::None
        end
      when Type::Adt(tid, _) then Option::Some(tid.id)
      when _ then Option::None
      end
      var resolved_payload: Option[Type] = Option::None
      match vid_named_tid
      when Option::Some(cur_tid) then
        if cur_tid == vid.owner.id then
          match b.typed_type_variants.get(vid.owner.id)
          when Option::Some(variants) then
            if vid.index as Int < variants.len() then
              resolved_payload = Option::Some(Type::Tuple(variants[vid.index as Int].1.clone()))
            end
          when Option::None then ()
          end
        end
      when Option::None then ()
      end
      match resolved_payload
      when Option::Some(p) then current = p
      when Option::None then return current
      end
    when Projection::Field(fid) then
      # The typed field identity — resolved BY ID (owner TypeId + index)
      # with NO name-scan / numeric-index fallbacks. After a downcast the
      # current type is the payload TUPLE; a FieldId there resolves by
      # index (the owner was established by the preceding VariantId).
      var field_ty_at: Option[Type] = Option::None
      match current
      when Type::Tuple(elems) then
        if fid.index >= 0 && fid.index < elems.len() then
          field_ty_at = Option::Some(elems[fid.index].clone())
        end
      when _ then
        let cur_tid_opt = match current
        when Type::RefInternal(inner, _) then
          match inner
          when Type::Adt(tid, _) then Option::Some(tid.id)
          when _ then Option::None
          end
        when Type::Adt(tid, _) then Option::Some(tid.id)
        when _ then Option::None
        end
        match cur_tid_opt
        when Option::Some(cur_tid) then
          if cur_tid == fid.owner.id then
            var td_idx_f = 0
            while td_idx_f < b.type_defs.len() do
              let td = b.type_defs[td_idx_f]
              if td.id.id == cur_tid then
                match td.kind
                when MirTypeDefKind::Struct(fields) then
                  if fid.index >= 0 && fid.index < fields.len() then
                    field_ty_at = Option::Some(fields[fid.index].ty.clone())
                  end
                when _ then ()
                end
              end
              td_idx_f = td_idx_f + 1
            end
          end
        when Option::None then ()
        end
      end
      match field_ty_at
      when Option::Some(ft) then current = ft
      when Option::None then return current
      end
    when Projection::TupleIndex(idx) then
      match current
      when Type::Tuple(elems) then
        if idx >= 0 && idx < elems.len() then
          current = elems[idx].clone()
        else
          return current
        end
      when _ then return current
      end
    when Projection::ProjIndex(_) then
      current = mir_project_index_type(b, &current)
    when Projection::ProjConstantIndex(_) then
      current = mir_project_index_type(b, &current)
    when _ then
      return current
    end
    proj_idx = proj_idx + 1
  end
  current
end

def mir_bare_type_name(name: String) -> String
  match name.rfind("::")
  when Option::Some(pos) then
    name.slice(pos + 2, name.len())
  when Option::None then
    name.clone()
  end
end

def mir_project_index_type(b: MirBuilder, ty: Type) -> Type
  match ty
  when Type::String then Type::Char
  when Type::FixedArray(elem, _) then elem.clone()
  when Type::Adt(tid, args) then
 # Adt form of Slice/Box/Rc mirrors the canonical arms (element
 # via the Adt args / unwrap recurse).: the builtin container /
    # smart-pointer selection is the LangItems TypeId — never the
    # registered name (the former Vec/Array/Map/Set/HashMap/HashSet name
    # chain is gone; HashMap/HashSet are not registered types — a user
    # type with those names must NOT project as the builtin hash map).
    let li = b.lang_items
    if (li.slice != -1 && tid.id == li.slice) && !args.is_empty() then
      args[0].clone()
    elsif (li.box_ != -1 && tid.id == li.box_) && !args.is_empty() then
      mir_project_index_type(b, &args[0])
    elsif (li.rc != -1 && tid.id == li.rc) && !args.is_empty() then
      mir_project_index_type(b, &args[0])
    elsif ((li.vec != -1 && tid.id == li.vec) || (li.array != -1 && tid.id == li.array)) && !args.is_empty() then
      args[0].clone()
    elsif (li.map != -1 && tid.id == li.map) && args.len() >= 2 then
      args[1].clone()
    elsif (li.set != -1 && tid.id == li.set) && !args.is_empty() then
      args[0].clone()
    else
      ty.clone()
    end
  when Type::RefInternal(inner, _) then mir_project_index_type(b, inner)
  when Type::Ptr(inner) then inner.clone()
  when Type::PtrMut(inner) then inner.clone()
  when _ then ty.clone()
  end
end

def unwrap_to_named_tid(b: MirBuilder, ty: Type) -> Option[TypeId]
  match ty
  when Type::Adt(tid, args) then
 # Adt form of Box/Rc/Option mirrors the canonical unwrap arms
    # (recurse through the Adt args); other Adt types return the id.
 # the unwrap selection is the LangItems TypeId — never the
    # registered name.
    let li2 = b.lang_items
    if ((li2.box_ != -1 && tid.id == li2.box_) || (li2.rc != -1 && tid.id == li2.rc) || (li2.option != -1 && tid.id == li2.option)) && !args.is_empty() then
      unwrap_to_named_tid(b, &args[0])
    else
      Option::Some(tid)
    end
  when Type::RefInternal(inner, _) then unwrap_to_named_tid(b, inner)
  when Type::Ptr(inner) then unwrap_to_named_tid(b, inner)
  when Type::PtrMut(inner) then unwrap_to_named_tid(b, inner)
  when _ then Option::None
  end
end

# Resolve the type at the END of a place's projection chain.
# Starts from the base local's type and walks through each projection
# to find the resulting type (e.g., for ctx.target.arch, walks from
# CodegenCtx → Target → Arch).
def resolve_projected_type_id(b: MirBuilder, place: Place) -> Option[TypeId]
  let base_ty = lookup_local_type(b, &place.local)
  let projected_ty = resolve_type_through_projections(b, base_ty, &place.projections)
  unwrap_to_named_tid(b, &projected_ty)
end

# Emit the field projection for a field access: the typed node form
# (from typed.typed_exprs — the recursive tree) is the ONLY authority —
# the checker records the FieldId for every struct field access it
# accepts. A missing typed FieldId is an ICE: re-deriving the index from
# the field name here would silently diverge from the typed program.
# (item 59): the projection carries the FULL FieldId — FieldId.owner
# (the field's owner TypeId) must flow through, not just the numeric
# index — so the MIR resolves the field BY ID and the verifier can check
# FieldId.owner == the projected type's TypeId mechanically.
# (phase 2) + the tree's TupleIndex form (the non-FieldId
# access forms — tuple indices) lowers to the TYPED TupleIndex projection
# (the same semantic tuple form the synthesized tuple-pattern bindings and
# the drain/entries glue use); the named len/cap forms (index = -1) have no
# projection identity and stay an ICE (the std uses the.len() methods).
def typed_field_projection(b: MirBuilder, node_id: Int, fallback_name: String, place: Place) -> Projection
 # (phase 2): the typed node form's FieldId (TypedExprKind::Field's
  # TypedField — the same data the flat field_targets holds, recorded in
  # the tree) is the PRIMARY source; the flat field_targets is the
  # fallback for the nodes the checker recorded only in the flat map. A
  # missing FieldId in BOTH is an ICE: re-deriving the index from the field
  # name here would silently diverge from the typed program.
  match typed_field_id_of(b, node_id)
  when Option::Some(fid) then Projection::Field(fid)
  when Option::None then
    match b.typed_exprs.get(node_id)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::TupleIndex(ti) then
        if ti.index >= 0 then
          return Projection::TupleIndex(ti.index)
        end
      when _ then ()
      end
    when Option::None then ()
    end
    match b.field_targets.get(node_id)
    when Option::Some(fid2) then Projection::Field(fid2)
    when Option::None then
      panic("internal error: missing typed field target for field '" + fallback_name.clone() + "' during MIR lowering; field identity must come from the typed program, not name-based fallback")
    end
  end
end

# Helper: convert a Path to a String (dot-separated components)
def path_to_string(path: AstPath) -> String
  var result = ""
  var first = true
  for seg in path.segments do
    if !first then
      result = result + "::"
    end
    result = result + seg.clone()
    first = false
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Closure Capture Analysis
# ———————————————————————————————————————————————————————————————

def collect_names_from_pattern(pat: Pattern) -> Set[String]
  var names: Set[String] = Set::new()
  match pat.kind
  when PatternKind::Ident(name, _) then
    names.insert(name.clone())
  when PatternKind::Tuple(pats) then
    for p in pats do
      let nested_names = collect_names_from_pattern(&p)
      for nested in nested_names do
        names.insert(nested.clone())
      end
    end
  when PatternKind::Array(pats) then
    for p in pats do
      let nested_names = collect_names_from_pattern(&p)
      for nested in nested_names do
        names.insert(nested.clone())
      end
    end
  when PatternKind::Struct(_, fields) then
    for entry in fields.entries() do
      let field_pattern = entry.1
      let nested_names = collect_names_from_pattern(&field_pattern)
      for nested in nested_names do
        names.insert(nested.clone())
      end
    end
  when PatternKind::Variant(_, pats) then
    for p in pats do
      let nested_names = collect_names_from_pattern(&p)
      for nested in nested_names do
        names.insert(nested.clone())
      end
    end
  when PatternKind::Or(pats) then
    for p in pats do
      let nested_names = collect_names_from_pattern(&p)
      for nested in nested_names do
        names.insert(nested.clone())
      end
    end
  when _ then ()
  end
  names
end

def mir_collect_free_vars(expr: Expr, bound: Set[String]) -> Set[String]
  var free: Set[String] = Set::new()
  match expr.kind
  when ExprKind::ExprIdent(name) then
    if !bound.contains(&name) then
      free.insert(name.clone())
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    let left_free = mir_collect_free_vars(&left, bound)
    for name in left_free do
      free.insert(name.clone())
    end
    let right_free = mir_collect_free_vars(&right, bound)
    for name in right_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprUnaryOp(_, inner) then
    let inner_free = mir_collect_free_vars(&inner, bound)
    for name in inner_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprCall(callee, args) then
    let callee_free = mir_collect_free_vars(&callee, bound)
    for name in callee_free do
      free.insert(name.clone())
    end
    var arg_idx = 0
    while arg_idx < args.len() do
      let arg_free = mir_collect_free_vars(&args[arg_idx], bound)
      for name in arg_free do
        free.insert(name.clone())
      end
      arg_idx = arg_idx + 1
    end
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    let recv_free = mir_collect_free_vars(&recv, bound)
    for name in recv_free do
      free.insert(name.clone())
    end
    var arg_idx = 0
    while arg_idx < args.len() do
      let arg_free = mir_collect_free_vars(&args[arg_idx], bound)
      for name in arg_free do
        free.insert(name.clone())
      end
      arg_idx = arg_idx + 1
    end
  when ExprKind::ExprFieldAccess(recv, _) then
    let recv_free = mir_collect_free_vars(&recv, bound)
    for name in recv_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprIndex(base, idx) then
    let base_free = mir_collect_free_vars(&base, bound)
    for name in base_free do
      free.insert(name.clone())
    end
    let index_free = mir_collect_free_vars(&idx, bound)
    for name in index_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprAccess(inner) then
    let inner_free = mir_collect_free_vars(&inner, bound)
    for name in inner_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprRawDeref(inner) then
    let inner_free = mir_collect_free_vars(&inner, bound)
    for name in inner_free do
      free.insert(name.clone())
    end
  when ExprKind::ExprArrayLit(elems) then
    var elem_idx = 0
    while elem_idx < elems.len() do
      let elem_free = mir_collect_free_vars(&elems[elem_idx], bound)
      for name in elem_free do
        free.insert(name.clone())
      end
      elem_idx = elem_idx + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    var elem_idx = 0
    while elem_idx < elems.len() do
      let elem_free = mir_collect_free_vars(&elems[elem_idx], bound)
      for name in elem_free do
        free.insert(name.clone())
      end
      elem_idx = elem_idx + 1
    end
  when ExprKind::ExprIf(if_expr) then
    let cond_free = mir_collect_free_vars(&if_expr.cond, bound)
    for name in cond_free do
      free.insert(name.clone())
    end
    var then_idx = 0
    while then_idx < if_expr.then_block.stmts.len() do
      let stmt_free = collect_free_vars_stmt(&if_expr.then_block.stmts[then_idx], bound)
      for name in stmt_free do
        free.insert(name.clone())
      end
      then_idx = then_idx + 1
    end
    match if_expr.else_block
    when Option::Some(else_body) then
      var else_idx = 0
      while else_idx < else_body.stmts.len() do
        let stmt_free = collect_free_vars_stmt(&else_body.stmts[else_idx], bound)
        for name in stmt_free do
          free.insert(name.clone())
        end
        else_idx = else_idx + 1
      end
    when Option::None then ()
    end
  when ExprKind::ExprClosure(inner_params, _, inner_body) then
    # Nested closure — its parameters shadow in the inner scope
    var inner_bound = bound.clone()
    for p in inner_params do
      let pattern_names = collect_names_from_pattern(&p.pat)
      for name in pattern_names do
        inner_bound.insert(name.clone())
      end
    end
    let inner_free = mir_collect_free_vars(&inner_body, &inner_bound)
    for name in inner_free do
      free.insert(name.clone())
    end
  when _ then ()
  end
  free
end

def collect_free_vars_stmt(stmt: Stmt, bound: Set[String]) -> Set[String]
  var free: Set[String] = Set::new()
  match stmt.kind
  when StmtKind::StmtLet(_, _, value, _) then
    let value_free = mir_collect_free_vars(&value, bound)
    for name in value_free do
      free.insert(name.clone())
    end
  when StmtKind::StmtExpr(expr) then
    let expr_free = mir_collect_free_vars(&expr, bound)
    for name in expr_free do
      free.insert(name.clone())
    end
  when StmtKind::StmtAssign(target, value) then
    let target_free = mir_collect_free_vars(&target, bound)
    for name in target_free do
      free.insert(name.clone())
    end
    let value_free = mir_collect_free_vars(&value, bound)
    for name in value_free do
      free.insert(name.clone())
    end
  when StmtKind::StmtReturn(expr) then
    match expr
    when Option::Some(e) then
      let expr_free = mir_collect_free_vars(&e, bound)
      for name in expr_free do
        free.insert(name.clone())
      end
    when Option::None then ()
    end
  when _ then ()
  end
  free
end

# Lower all pending closures into separate MirFunctions
def lower_pending_closures(inout b: MirBuilder, inout program: MirProgram) -> Unit
  # Loop until no more closures are pending — nested closures may queue
  # additional closures that must also be processed.
  while b.pending_closures.len() > 0 do
  let closures = b.pending_closures.clone()
  b.pending_closures = Vec::new()

  for closure in closures do
    # Save current builder state
    let saved_fn = b.current_fn.clone()
    let saved_block = b.current_block.clone()
    let saved_locals = b.local_counter
    let saved_blocks = b.block_counter
    let saved_vars = b.var_map.clone()
    let saved_block_map = duplicate_blocks(&b.blocks)

    let closure_span = closure.body.span

    # Start a new function for the closure
    start_function(b, closure.name.clone(), closure.ret_type.clone(), closure_span)
 # the closure's authoritative finalize set is the SEMANTIC
    # closure_cleanup record keyed by the closure expression's NodeId (the
    # "closure::<node_id>" String-key protocol is are not part of the model) — deinit_candidates
    # looks it up through current_closure_node.
    b.current_fn_key = "closure::" + closure.node_id.to_string()
    b.current_callable = Option::None
    b.current_closure_node = Option::Some(NodeId { id: closure.node_id })

    # Add captured variables as implicit leading parameters with resolved types
    var cap_idx = 0
    for cap_name in closure.captures do
      let cap_ty = if cap_idx < closure.capture_types.len() then
        closure.capture_types[cap_idx].clone()
      else
        Type::Unit
      end
      let cap_param = add_param(b, cap_name.clone(), cap_ty, closure_span)
      # Map the SEMANTIC capture id to this MIR capture param (the closure's
      # finalize plan refers to semantic ids).
      if cap_idx < closure.capture_ids.len() then
        b.semantic_to_mir.insert(closure.capture_ids[cap_idx], cap_param.id)
      else
        b.errors.push("internal error: closure capture index " + cap_idx.to_string() + " has no semantic id")
      end
      cap_idx = cap_idx + 1
    end

    # Add explicit closure parameters — their types come from the pending
    # closure's typed param_types record (the checker's resolved types
    # split from the typed tree at the construction site; never TypeExpr).
    # A count mismatch is an internal error (fail-closed).
    var closure_param_index = 0
    for p in closure.params do
      let ty = if closure_param_index < closure.param_types.len() then
        closure.param_types[closure_param_index].clone()
      else
        b.errors.push("internal error: closure node " + closure.node_id.to_string() + " typed parameter count mismatch during MIR lowering")
        Type::Unit
      end
      match p.pat.kind
      when PatternKind::Ident(name, _) then
        add_param(b, name.clone(), ty, p.span)
      when _ then
        let param_name = "__closure_param_" + closure_param_index.to_string()
        let param_local = add_param(b, param_name, ty, p.span)
        let param_rvalue = move_rvalue(operand_copy_local(param_local))
        lower_pattern_assignment(b, &p.pat, &param_rvalue, &ty, p.span)
      end
      closure_param_index = closure_param_index + 1
    end

    # Lower the closure body
    match lower_expr_to_rvalue(b, &closure.body, closure_span)
    when Result::Ok(body_rvalue) then
      let ret_place = place_local(MirLocalId { id: 0 })
      push_stmt(b, MirStatementKind::MirAssign(ret_place, body_rvalue), closure_span)
    when Result::Err(e) then
      b.errors.push(e)
    end
    emit_cfg_deinit_returns(b)

    # Finish and add to program
    let closure_fn = finish_function(b)
    match closure_fn
    when Option::Some(f) then program.functions.push(f)
    when Option::None then ()
    end

    # Restore builder state
    b.current_fn = saved_fn
    b.current_block = saved_block
    b.local_counter = saved_locals
    b.block_counter = saved_blocks
    b.var_map = saved_vars
    b.blocks = saved_block_map
  end
  end  # while pending_closures
end

# Helper: lower if expression as rvalue (returns its value). the
# result type is the EXPRESSION's typed-tree record, passed by the caller —
# no block-shape inference.
def lower_if_rvalue(inout b: MirBuilder, if_expr: IfStmt, span: Span, result_ty: Type) -> MirRvalue
  # Create a result temp and use lower_if_to_place to assign into it
  let result_tmp = add_temp(b, result_ty, span)
  lower_if_to_place(b, if_expr, place_local(result_tmp), span)
  MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
    kind: MirOperandKind::MirCopy(place_local(result_tmp))
  }) }
end

# Helper: assign the result of an expression directly into dest.
# For nested if expressions, calls lower_if_to_place directly with dest
# to avoid intermediate temps and a sequential push_stmt after lower_expr.
def lower_expr_assign_to(inout b: MirBuilder, expr: Expr, dest: Place, span: Span) -> Unit
  match expr.kind
  when ExprKind::ExprIf(nested_if) then
    # Nested if: pass our dest directly — branches assign to dest
    lower_if_to_place(b, &nested_if, dest, span)
  when ExprKind::ExprMatch(m) then
    # Nested match: pass our dest directly — arms assign to dest
    lower_match_to_place(b, &m, dest, span)
  when _ then
    # Non-if: lower to rvalue and assign in one step. A FixedArray-typed
    # destination drives the dest-aware array-literal lowering (inline
    # storage; the count is in the type).
    let dest_ty = lookup_local_type(b, &dest.local)
    match lower_expr_rvalue_to_dest(b, expr, &dest_ty, span)
    when Result::Ok(rvalue) then
      push_assign(b, dest, rvalue, span)
    when Result::Err(e) then
      b.errors.push(e)
    end
  end
end

# Lower an if/else expression, assigning the result of each branch
# directly into `dest`. After this call, b.current_block is the merge block.
def lower_if_to_place(inout b: MirBuilder, if_expr: IfStmt, dest: Place, span: Span) -> Unit
  let cond_op = lower_expr(b, &if_expr.cond, span)
  let then_blk = create_block(b)
  var current_else = create_block(b)
  let merge_blk = create_block(b)

  # Branch on condition
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: current_else })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cond_op, targets: targets, default_target: then_blk }, span)

  # Then branch — lower all stmts, last expression value goes to dest
  b.current_block = Option::Some(then_blk)
  let then_stmts = if_expr.then_block.stmts
  if then_stmts.len() > 0 then
    # Lower all but last stmt normally
    var ti = 0
    while ti < then_stmts.len() - 1 do
      lower_stmt(b, &then_stmts[ti])
      ti = ti + 1
    end
    # Last stmt: evaluate and assign to dest
    let last_then = then_stmts[then_stmts.len() - 1]
    match last_then.kind
    when StmtKind::StmtExpr(expr) then
      lower_expr_assign_to(b, &expr, dest, span)
    when StmtKind::StmtIf(nested_if) then
      lower_if_to_place(b, &nested_if, dest, span)
    when _ then
      lower_stmt(b, &last_then)
    end
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  end

  # Elsif branches — each branch tests condition and assigns to dest
  let branches = if_expr.elsif_branches
  var bi = 0
  while bi < branches.len() do
    b.current_block = Option::Some(current_else)
    let branch = branches[bi]
    let branch_cond = lower_expr(b, &branch.0, span)
    let branch_then = create_block(b)
    let next_else = create_block(b)
    var bt = Vec::new()
    bt.push(SwitchTarget { value: 0, target: next_else })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: branch_cond, targets: bt, default_target: branch_then }, span)
    b.current_block = Option::Some(branch_then)
    let br_stmts = branch.1.stmts
    if br_stmts.len() > 0 then
      var bsi = 0
      while bsi < br_stmts.len() - 1 do
        lower_stmt(b, &br_stmts[bsi])
        bsi = bsi + 1
      end
      let last_br = br_stmts[br_stmts.len() - 1]
      match last_br.kind
      when StmtKind::StmtExpr(expr) then
        lower_expr_assign_to(b, &expr, dest, span)
      when StmtKind::StmtIf(nested_if) then
        lower_if_to_place(b, &nested_if, dest, span)
      when _ then
        lower_stmt(b, &last_br)
      end
    end
    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
    end
    current_else = next_else
    bi = bi + 1
  end

  # Final else branch — lower all stmts, last expression value goes to dest
  b.current_block = Option::Some(current_else)
  match if_expr.else_block
  when Option::Some(else_body) then
    let else_stmts = else_body.stmts
    if else_stmts.len() > 0 then
      var ei = 0
      while ei < else_stmts.len() - 1 do
        lower_stmt(b, &else_stmts[ei])
        ei = ei + 1
      end
      let last_else = else_stmts[else_stmts.len() - 1]
      match last_else.kind
      when StmtKind::StmtExpr(expr) then
        lower_expr_assign_to(b, &expr, dest, span)
      when StmtKind::StmtIf(nested_if) then
        lower_if_to_place(b, &nested_if, dest, span)
      when _ then
        lower_stmt(b, &last_else)
      end
    end
  when Option::None then ()
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(merge_blk), span)
  end

  # Continue from merge
  b.current_block = Option::Some(merge_blk)
end

# Helper: lower a statement and return its value as MirRvalue
def lower_stmt_rvalue(inout b: MirBuilder, stmt: Stmt, span: Span) -> Result[MirRvalue, String]
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    lower_expr_to_rvalue(b, &expr, span)
  when _ then
    lower_stmt(b, stmt)
    Result::Ok(MirRvalue { kind: MirRvalueKind::MirMove(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirUnit,
        ty: Type::Unit,
        instance: Option::None
      })
    }) })
  end
end

def lower_binop(op: BinOp) -> MirBinOp
  match op
  when BinOp::Add then MirBinOp::Add
  when BinOp::Sub then MirBinOp::Sub
  when BinOp::Mul then MirBinOp::Mul
  when BinOp::Div then MirBinOp::Div
  when BinOp::Mod then MirBinOp::Mod
  when BinOp::Eq then MirBinOp::Eq
  when BinOp::Ne then MirBinOp::Ne
  when BinOp::Lt then MirBinOp::Lt
  when BinOp::Le then MirBinOp::Le
  when BinOp::Gt then MirBinOp::Gt
  when BinOp::Ge then MirBinOp::Ge
  when BinOp::And then MirBinOp::BitAnd
  when BinOp::Or then MirBinOp::BitOr
  when BinOp::BitAnd then MirBinOp::BitAnd
  when BinOp::BitOr then MirBinOp::BitOr
  when BinOp::BitXor then MirBinOp::BitXor
  when BinOp::Shl then MirBinOp::Shl
  when BinOp::Shr then MirBinOp::Shr
  when _ then MirBinOp::Add
  end
end

def lower_unop(op: UnOp) -> MirUnOp
  match op
  when UnOp::Neg then MirUnOp::Neg
  when UnOp::Not then MirUnOp::Not
  when UnOp::BitNot then MirUnOp::BitNot
  end
end

def lower_if(inout b: MirBuilder, if_stmt: IfStmt, span: Span) -> Unit
  let then_block = create_block(b)
  var current_else = create_block(b)
  let join_block = create_block(b)
  
  let cond = lower_expr(b, &if_stmt.cond, span)
  
  # Switch on condition
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: current_else })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cond, targets: targets, default_target: then_block }, span)
  
  # Then block
  switch_to_block(b, then_block)
  lower_block(b, &if_stmt.then_block)
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
  end
  
  # Elsif branches
  let branches = if_stmt.elsif_branches
  var bi = 0
  while bi < branches.len() do
    switch_to_block(b, current_else)
    let branch = branches[bi]
    let branch_cond = lower_expr(b, &branch.0, span)
    let branch_then = create_block(b)
    let next_else = create_block(b)
    var bt = Vec::new()
    bt.push(SwitchTarget { value: 0, target: next_else })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: branch_cond, targets: bt, default_target: branch_then }, span)
    switch_to_block(b, branch_then)
    lower_block(b, &branch.1)
    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
    end
    current_else = next_else
    bi = bi + 1
  end
  
  # Final else block
  switch_to_block(b, current_else)
  match if_stmt.else_block
  when Option::Some(eb) then lower_block(b, &eb)
  when Option::None then ()
  end
  if !block_is_terminated(b) then
    set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
  end
  
  switch_to_block(b, join_block)
end

def lower_while(inout b: MirBuilder, cond: Expr, body: Block, span: Span, loop_id: Int) -> Unit
  let header = create_block(b)
  let body_block = create_block(b)
  let exit_block = create_block(b)
  
  # Save and set break/continue targets
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_block)
  b.continue_target = Option::Some(header)
  
  set_terminator(b, MirTerminatorKind::MirGoto(header), span)

  switch_to_block(b, header)
  let cond_op = lower_expr(b, cond, span)
  var targets = Vec::new()
  # The condition-false exit performs NO cleanup of its own: the body's
  # fallthrough already ran the backedge cleanup ("backedge::<loop id>")
  # for the previous iteration's resources BEFORE the header re-check, so
  # reusing that plan on the exit edge would double-finalize them (and the
  # zero-iteration exit would finalize locals that were never initialized).
  targets.push(SwitchTarget { value: 0, target: exit_block })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cond_op, targets: targets, default_target: body_block }, span)

  switch_to_block(b, body_block)
 # the loop body is a lexical defer scope, pushed NEGATED (checker's
  # check_loop_body parity): break/continue/backedge walks stop exactly at
  # the loop boundary.
  let while_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
  if while_body_key != 0 then
    b.defer_scope_chain.push(0 - while_body_key)
  end
  lower_block(b, body)
  if while_body_key != 0 then
    b.defer_scope_chain.pop()
  end
  if !block_is_terminated(b) then
 # the BACKEDGE cleanup comes from the edge map first
    # ("edge::Backedge::<loop id>"); "backedge::<loop id>" is the fallback.
    emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
  end
  
  # Restore break/continue targets
  b.break_target = old_break
  b.continue_target = old_continue
  
  switch_to_block(b, exit_block)
end

# LEGACY FALLBACK ONLY — the projected-safety heuristic (and the
# for_*_uses_name / for_*_mentions_name name-use scan below) is no longer the
# primary decision path for for-loops: the resource checker's typed
# IterationPlan (lower_for's plan lookup above) is the authority for
# checker-covered for-stmts. This heuristic is kept solely as the documented
# fallback for the plan-absent path. Its decision (plain non-"_" Ident
# pattern whose name is not used by the body) is the exact predicate the
# checker now encodes in the plan (see plan_body_is_projected_safe in
# resource_check.tg, the faithful port).
def for_body_is_projected_safe(inout b: MirBuilder, pat: Pattern, body: Block) -> Bool
  match pat.kind
  when PatternKind::Ident(name, _) then
    if name == "_" then
      false
    else
      !for_block_uses_name(b, name, body)
    end
  when _ then false
  end
end

def for_block_uses_name(b: MirBuilder, name: String, block: Block) -> Bool
  var found = false
  var stmt_idx = 0
  while stmt_idx < block.stmts.len() do
    if for_stmt_uses_name(b, name, &block.stmts[stmt_idx]) then
      found = true
    end
    stmt_idx = stmt_idx + 1
  end
  found
end

def for_stmt_uses_name(b: MirBuilder, name: String, stmt: Stmt) -> Bool
  let kind_name = stmt_kind_name(&stmt.kind)
  if kind_name == "StmtLet" then
    match stmt.kind
    when StmtKind::StmtLet(_, _, value, _) then for_expr_uses_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtAssign" then
    match stmt.kind
    when StmtKind::StmtAssign(target, value) then
      for_expr_rooted_at_name(name, &target) ||
      for_expr_uses_name(b, name, &target) ||
      for_expr_uses_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtCompoundAssign" then
    match stmt.kind
    when StmtKind::StmtCompoundAssign(_, target, value) then
      for_expr_rooted_at_name(name, &target) ||
      for_expr_uses_name(b, name, &target) ||
      for_expr_uses_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtIf" then
    match stmt.kind
    when StmtKind::StmtIf(if_stmt) then for_if_uses_name(b, name, &if_stmt)
    when _ then false
    end
  elsif kind_name == "StmtMatch" then
    match stmt.kind
    when StmtKind::StmtMatch(m) then for_match_uses_name(b, name, &m)
    when _ then false
    end
  elsif kind_name == "StmtWhile" then
    match stmt.kind
    when StmtKind::StmtWhile(cond, body) then
      for_expr_uses_name(b, name, &cond) || for_block_uses_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "StmtFor" then
    match stmt.kind
    when StmtKind::StmtFor(for_stmt) then
      for_expr_rooted_at_name(name, &for_stmt.iter) ||
      for_expr_uses_name(b, name, &for_stmt.iter) ||
      for_block_uses_name(b, name, &for_stmt.body)
    when _ then false
    end
  elsif kind_name == "StmtLoop" then
    match stmt.kind
    when StmtKind::StmtLoop(body) then for_block_uses_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "StmtReturn" then
    match stmt.kind
    when StmtKind::StmtReturn(val_opt) then
      match val_opt
      when Option::Some(val) then for_expr_uses_name(b, name, &val)
      when Option::None then false
      end
    when _ then false
    end
  elsif kind_name == "StmtBreak" then
    match stmt.kind
    when StmtKind::StmtBreak(val_opt) then
      match val_opt
      when Option::Some(val) then for_expr_uses_name(b, name, &val)
      when Option::None then false
      end
    when _ then false
    end
  elsif kind_name == "StmtContinue" then
    false
  elsif kind_name == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(expr) then for_expr_uses_name(b, name, &expr)
    when _ then false
    end
  elsif kind_name == "StmtUnsafe" then
    match stmt.kind
    when StmtKind::StmtUnsafe(_, block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtDefer" then
    match stmt.kind
    when StmtKind::StmtDefer(block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtGuard" then
    match stmt.kind
    when StmtKind::StmtGuard(cond, else_action) then
      var found = for_expr_uses_name(b, name, &cond)
      match else_action
      when GuardElse::Return(opt) then
        match opt
        when Option::Some(val) then if for_expr_uses_name(b, name, &val) then found = true end
        when Option::None then ()
        end
      when GuardElse::Panic(_) then ()
      when GuardElse::Break(opt) then
        match opt
        when Option::Some(val) then if for_expr_uses_name(b, name, &val) then found = true end
        when Option::None then ()
        end
      when GuardElse::Continue then ()
      end
      found
    when _ then false
    end
  elsif kind_name == "StmtTry" then
    match stmt.kind
    when StmtKind::StmtTry(body, catches, finally_block) then
      var found = for_block_uses_name(b, name, &body)
      var c_idx = 0
      while c_idx < catches.len() do
        if for_block_uses_name(b, name, &catches[c_idx].body) then found = true end
        c_idx = c_idx + 1
      end
      match finally_block
      when Option::Some(fb) then if for_block_uses_name(b, name, &fb) then found = true end
      when Option::None then ()
      end
      found
    when _ then false
    end
  elsif kind_name == "StmtWith" then
    match stmt.kind
    when StmtKind::StmtWith(expr, _, block) then
      for_expr_uses_name(b, name, &expr) || for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtHandleWith" then
    match stmt.kind
    when StmtKind::StmtHandleWith(expr, handlers) then
      var found = for_expr_uses_name(b, name, &expr)
      var h_idx = 0
      while h_idx < handlers.len() do
        let handler = handlers[h_idx]
        var a_idx = 0
        while a_idx < handler.arms.len() do
          if for_block_uses_name(b, name, &handler.arms[a_idx].body) then found = true end
          a_idx = a_idx + 1
        end
        h_idx = h_idx + 1
      end
      found
    when _ then false
    end
  else
    false
  end
end

def for_if_uses_name(b: MirBuilder, name: String, if_stmt: IfStmt) -> Bool
  var found = for_expr_uses_name(b, name, &if_stmt.cond)
  if for_block_uses_name(b, name, &if_stmt.then_block) then found = true end
  var e_idx = 0
  while e_idx < if_stmt.elsif_branches.len() do
    if for_expr_uses_name(b, name, &if_stmt.elsif_branches[e_idx].0) then found = true end
    if for_block_uses_name(b, name, &if_stmt.elsif_branches[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then if for_block_uses_name(b, name, &eb) then found = true end
  when Option::None then ()
  end
  found
end

def for_match_uses_name(b: MirBuilder, name: String, m: MatchExpr) -> Bool
  var found = for_expr_uses_name(b, name, &m.scrutinee)
  var a_idx = 0
  while a_idx < m.arms.len() do
    let arm = m.arms[a_idx]
    match arm.guard_expr
    when Option::Some(guard) then if for_expr_uses_name(b, name, &guard) then found = true end
    when Option::None then ()
    end
    if for_block_uses_name(b, name, &arm.body) then found = true end
    a_idx = a_idx + 1
  end
  found
end

def for_exprs_uses_name(b: MirBuilder, name: String, exprs: Vec[Expr]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < exprs.len() do
    if for_expr_uses_name(b, name, &exprs[e_idx]) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def for_expr_is_bare_name(name: String, expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprIdent(n) then n == name
  when _ then false
  end
end

def for_expr_rooted_at_name(name: String, expr: Expr) -> Bool
  let kind_name = expr_kind_name(&expr.kind)
  if kind_name == "ExprIdent" then
    match expr.kind
    when ExprKind::ExprIdent(n) then n == name
    when _ then false
    end
  elsif kind_name == "ExprFieldAccess" then
    match expr.kind
    when ExprKind::ExprFieldAccess(base, _) then for_expr_rooted_at_name(name, &base)
    when _ then false
    end
  elsif kind_name == "ExprIndex" then
    match expr.kind
    when ExprKind::ExprIndex(base, _) then for_expr_rooted_at_name(name, &base)
    when _ then false
    end
  else
    false
  end
end

def for_expr_uses_name(b: MirBuilder, name: String, expr: Expr) -> Bool
  let kind_name = expr_kind_name(&expr.kind)
  if kind_name == "ExprIdent" then
    match expr.kind
    when ExprKind::ExprIdent(n) then n == name
    when _ then false
    end
  elsif kind_name == "ExprIntLit" then false
  elsif kind_name == "ExprFloatLit" then false
  elsif kind_name == "ExprStringLit" then false
  elsif kind_name == "ExprCharLit" then false
  elsif kind_name == "ExprBoolLit" then false
  elsif kind_name == "ExprNilLit" then false
  elsif kind_name == "ExprPath" then false
  elsif kind_name == "ExprSelfRef" then false
  elsif kind_name == "ExprArrayLit" then
    match expr.kind
    when ExprKind::ExprArrayLit(elems) then for_exprs_uses_name(b, name, &elems)
    when _ then false
    end
  elsif kind_name == "ExprTupleLit" then
    match expr.kind
    when ExprKind::ExprTupleLit(elems) then for_exprs_uses_name(b, name, &elems)
    when _ then false
    end
  elsif kind_name == "ExprStructLit" then
    match expr.kind
    when ExprKind::ExprStructLit(_, fields) then
      var found = false
      var f_idx = 0
      while f_idx < fields.len() do
        if for_expr_uses_name(b, name, &fields[f_idx].1) then found = true end
        f_idx = f_idx + 1
      end
      found
    when _ then false
    end
  elsif kind_name == "ExprMapLit" then
    match expr.kind
    when ExprKind::ExprMapLit(entries) then
      var found = false
      var e_idx = 0
      while e_idx < entries.len() do
        if for_expr_uses_name(b, name, &entries[e_idx].0) then found = true end
        if for_expr_uses_name(b, name, &entries[e_idx].1) then found = true end
        e_idx = e_idx + 1
      end
      found
    when _ then false
    end
  elsif kind_name == "ExprBinaryOp" then
    match expr.kind
    when ExprKind::ExprBinaryOp(_, lhs, rhs) then
      for_expr_uses_name(b, name, &lhs) || for_expr_uses_name(b, name, &rhs)
    when _ then false
    end
  elsif kind_name == "ExprUnaryOp" then
    match expr.kind
    when ExprKind::ExprUnaryOp(_, operand) then for_expr_uses_name(b, name, &operand)
    when _ then false
    end
  elsif kind_name == "ExprFieldAccess" then
    match expr.kind
    when ExprKind::ExprFieldAccess(base, _) then
      if for_expr_is_bare_name(name, &base) then
        false
      else
        for_expr_uses_name(b, name, &base)
      end
    when _ then false
    end
  elsif kind_name == "ExprIndex" then
    match expr.kind
    when ExprKind::ExprIndex(base, idx) then
      let base_unsafe = if for_expr_is_bare_name(name, &base) then
        false
      else
        for_expr_uses_name(b, name, &base)
      end
      base_unsafe || for_expr_uses_name(b, name, &idx)
    when _ then false
    end
  elsif kind_name == "ExprMethodCall" then
    match expr.kind
    when ExprKind::ExprMethodCall(receiver, _, _, args) then
      if for_expr_rooted_at_name(name, &receiver) then
        true
      else
        if for_expr_uses_name(b, name, &receiver) then
          true
        else
          for_exprs_uses_name(b, name, &args)
        end
      end
    when _ then false
    end
  elsif kind_name == "ExprCall" then
    match expr.kind
    when ExprKind::ExprCall(callee, args) then
      if for_expr_rooted_at_name(name, &callee) then
        true
      else
        if for_expr_uses_name(b, name, &callee) then
          true
        else
          for_call_args_uses_name(b, name, &args)
        end
      end
    when _ then false
    end
  elsif kind_name == "ExprClosure" then
    match expr.kind
    when ExprKind::ExprClosure(_, _, body) then for_expr_mentions_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "ExprAccess" then
    match expr.kind
    when ExprKind::ExprAccess(inner) then
      if for_expr_rooted_at_name(name, &inner) then
        true
      else
        for_expr_uses_name(b, name, &inner)
      end
    when _ then false
    end
  elsif kind_name == "ExprRawDeref" then
    match expr.kind
    when ExprKind::ExprRawDeref(inner) then
      if for_expr_rooted_at_name(name, &inner) then
        true
      else
        for_expr_uses_name(b, name, &inner)
      end
    when _ then false
    end
  elsif kind_name == "ExprIf" then
    match expr.kind
    when ExprKind::ExprIf(if_stmt) then for_if_uses_name(b, name, &if_stmt)
    when _ then false
    end
  elsif kind_name == "ExprMatch" then
    match expr.kind
    when ExprKind::ExprMatch(m) then for_match_uses_name(b, name, &m)
    when _ then false
    end
  elsif kind_name == "ExprBlock" then
    match expr.kind
    when ExprKind::ExprBlock(block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprUnsafe" then
    match expr.kind
    when ExprKind::ExprUnsafe(_, block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprAsync" then
    match expr.kind
    when ExprKind::ExprAsync(block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprAwait" then
    match expr.kind
    when ExprKind::ExprAwait(inner) then for_expr_uses_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprTry" then
    match expr.kind
    when ExprKind::ExprTry(inner) then for_expr_uses_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprRange" then
    match expr.kind
    when ExprKind::ExprRange(lo, hi, _) then
      let lo_unsafe = match lo
      when Option::Some(lo_e) then for_expr_uses_name(b, name, &lo_e)
      when Option::None then false
      end
      let hi_unsafe = match hi
      when Option::Some(hi_e) then for_expr_uses_name(b, name, &hi_e)
      when Option::None then false
      end
      lo_unsafe || hi_unsafe
    when _ then false
    end
  elsif kind_name == "ExprCast" then
    match expr.kind
    when ExprKind::ExprCast(inner, _) then for_expr_uses_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprTypeCheck" then
    match expr.kind
    when ExprKind::ExprTypeCheck(inner, _) then for_expr_uses_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprComptime" then
    match expr.kind
    when ExprKind::ExprComptime(block) then for_block_uses_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprEnumVariant" then
    match expr.kind
    when ExprKind::ExprEnumVariant(_, args) then for_exprs_uses_name(b, name, &args)
    when _ then false
    end
  elsif kind_name == "ExprAssign" then
    match expr.kind
    when ExprKind::ExprAssign(target, value) then
      if for_expr_rooted_at_name(name, &target) then
        true
      else
        for_expr_uses_name(b, name, &target) || for_expr_uses_name(b, name, &value)
      end
    when _ then false
    end
  elsif kind_name == "ExprPipe" then
    match expr.kind
    when ExprKind::ExprPipe(lhs, rhs) then
      for_expr_uses_name(b, name, &lhs) || for_expr_uses_name(b, name, &rhs)
    when _ then false
    end
  elsif kind_name == "ExprMacroCall" then
    match expr.kind
    when ExprKind::ExprMacroCall(_, args) then for_exprs_uses_name(b, name, &args)
    when _ then false
    end
  elsif kind_name == "ExprError" then false
  else false
  end
end

def for_call_args_uses_name(b: MirBuilder, name: String, args: Vec[Expr]) -> Bool
  var found = false
  var a_idx = 0
  while a_idx < args.len() do
    if for_call_arg_uses_name(b, name, &args[a_idx]) then found = true end
    a_idx = a_idx + 1
  end
  found
end

def for_call_arg_uses_name(b: MirBuilder, name: String, arg: Expr) -> Bool
  let kind_name = expr_kind_name(&arg.kind)
  if kind_name == "ExprAccess" then
    match arg.kind
    when ExprKind::ExprAccess(inner) then
      if for_expr_rooted_at_name(name, &inner) then
        if for_expr_is_bare_name(name, &inner) then
          true
        else
          !for_ref_param_is_let(b, &inner)
        end
      else
        for_expr_uses_name(b, name, &inner)
      end
    when _ then true
    end
  else
    for_expr_uses_name(b, name, arg)
  end
end

def for_ref_param_is_let(b: MirBuilder, arg_expr: Expr) -> Bool
  match b.access_effects.get(arg_expr.node_id)
  when Option::Some(AccessEffect::Read) then true
  when _ then false
  end
end

def for_expr_mentions_name(b: MirBuilder, name: String, expr: Expr) -> Bool
  let kind_name = expr_kind_name(&expr.kind)
  if kind_name == "ExprIdent" then
    match expr.kind
    when ExprKind::ExprIdent(n) then n == name
    when _ then false
    end
  elsif kind_name == "ExprIntLit" then false
  elsif kind_name == "ExprFloatLit" then false
  elsif kind_name == "ExprStringLit" then false
  elsif kind_name == "ExprCharLit" then false
  elsif kind_name == "ExprBoolLit" then false
  elsif kind_name == "ExprNilLit" then false
  elsif kind_name == "ExprPath" then false
  elsif kind_name == "ExprSelfRef" then false
  elsif kind_name == "ExprArrayLit" then
    match expr.kind
    when ExprKind::ExprArrayLit(elems) then for_exprs_mention_name(b, name, &elems)
    when _ then false
    end
  elsif kind_name == "ExprTupleLit" then
    match expr.kind
    when ExprKind::ExprTupleLit(elems) then for_exprs_mention_name(b, name, &elems)
    when _ then false
    end
  elsif kind_name == "ExprStructLit" then
    match expr.kind
    when ExprKind::ExprStructLit(_, fields) then
      var found = false
      var f_idx = 0
      while f_idx < fields.len() do
        if for_expr_mentions_name(b, name, &fields[f_idx].1) then found = true end
        f_idx = f_idx + 1
      end
      found
    when _ then false
    end
  elsif kind_name == "ExprMapLit" then
    match expr.kind
    when ExprKind::ExprMapLit(entries) then
      var found = false
      var e_idx = 0
      while e_idx < entries.len() do
        if for_expr_mentions_name(b, name, &entries[e_idx].0) then found = true end
        if for_expr_mentions_name(b, name, &entries[e_idx].1) then found = true end
        e_idx = e_idx + 1
      end
      found
    when _ then false
    end
  elsif kind_name == "ExprBinaryOp" then
    match expr.kind
    when ExprKind::ExprBinaryOp(_, lhs, rhs) then
      for_expr_mentions_name(b, name, &lhs) || for_expr_mentions_name(b, name, &rhs)
    when _ then false
    end
  elsif kind_name == "ExprUnaryOp" then
    match expr.kind
    when ExprKind::ExprUnaryOp(_, operand) then for_expr_mentions_name(b, name, &operand)
    when _ then false
    end
  elsif kind_name == "ExprFieldAccess" then
    match expr.kind
    when ExprKind::ExprFieldAccess(base, _) then for_expr_mentions_name(b, name, &base)
    when _ then false
    end
  elsif kind_name == "ExprIndex" then
    match expr.kind
    when ExprKind::ExprIndex(base, idx) then
      for_expr_mentions_name(b, name, &base) || for_expr_mentions_name(b, name, &idx)
    when _ then false
    end
  elsif kind_name == "ExprMethodCall" then
    match expr.kind
    when ExprKind::ExprMethodCall(receiver, _, _, args) then
      if for_expr_mentions_name(b, name, &receiver) then
        true
      else
        for_exprs_mention_name(b, name, &args)
      end
    when _ then false
    end
  elsif kind_name == "ExprCall" then
    match expr.kind
    when ExprKind::ExprCall(callee, args) then
      if for_expr_mentions_name(b, name, &callee) then
        true
      else
        for_exprs_mention_name(b, name, &args)
      end
    when _ then false
    end
  elsif kind_name == "ExprClosure" then
    match expr.kind
    when ExprKind::ExprClosure(_, _, body) then for_expr_mentions_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "ExprAccess" then
    match expr.kind
    when ExprKind::ExprAccess(inner) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprRawDeref" then
    match expr.kind
    when ExprKind::ExprRawDeref(inner) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprIf" then
    match expr.kind
    when ExprKind::ExprIf(if_stmt) then for_if_mentions_name(b, name, &if_stmt)
    when _ then false
    end
  elsif kind_name == "ExprMatch" then
    match expr.kind
    when ExprKind::ExprMatch(m) then for_match_mentions_name(b, name, &m)
    when _ then false
    end
  elsif kind_name == "ExprBlock" then
    match expr.kind
    when ExprKind::ExprBlock(block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprUnsafe" then
    match expr.kind
    when ExprKind::ExprUnsafe(_, block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprAsync" then
    match expr.kind
    when ExprKind::ExprAsync(block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprAwait" then
    match expr.kind
    when ExprKind::ExprAwait(inner) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprTry" then
    match expr.kind
    when ExprKind::ExprTry(inner) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprRange" then
    match expr.kind
    when ExprKind::ExprRange(lo, hi, _) then
      let lo_unsafe = match lo
      when Option::Some(lo_e) then for_expr_mentions_name(b, name, &lo_e)
      when Option::None then false
      end
      let hi_unsafe = match hi
      when Option::Some(hi_e) then for_expr_mentions_name(b, name, &hi_e)
      when Option::None then false
      end
      lo_unsafe || hi_unsafe
    when _ then false
    end
  elsif kind_name == "ExprCast" then
    match expr.kind
    when ExprKind::ExprCast(inner, _) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprTypeCheck" then
    match expr.kind
    when ExprKind::ExprTypeCheck(inner, _) then for_expr_mentions_name(b, name, &inner)
    when _ then false
    end
  elsif kind_name == "ExprComptime" then
    match expr.kind
    when ExprKind::ExprComptime(block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "ExprEnumVariant" then
    match expr.kind
    when ExprKind::ExprEnumVariant(_, args) then for_exprs_mention_name(b, name, &args)
    when _ then false
    end
  elsif kind_name == "ExprAssign" then
    match expr.kind
    when ExprKind::ExprAssign(target, value) then
      for_expr_mentions_name(b, name, &target) || for_expr_mentions_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "ExprPipe" then
    match expr.kind
    when ExprKind::ExprPipe(lhs, rhs) then
      for_expr_mentions_name(b, name, &lhs) || for_expr_mentions_name(b, name, &rhs)
    when _ then false
    end
  elsif kind_name == "ExprMacroCall" then
    match expr.kind
    when ExprKind::ExprMacroCall(_, args) then for_exprs_mention_name(b, name, &args)
    when _ then false
    end
  elsif kind_name == "ExprError" then false
  else false
  end
end

def for_exprs_mention_name(b: MirBuilder, name: String, exprs: Vec[Expr]) -> Bool
  var found = false
  var e_idx = 0
  while e_idx < exprs.len() do
    if for_expr_mentions_name(b, name, &exprs[e_idx]) then found = true end
    e_idx = e_idx + 1
  end
  found
end

def for_block_mentions_name(b: MirBuilder, name: String, block: Block) -> Bool
  var found = false
  var stmt_idx = 0
  while stmt_idx < block.stmts.len() do
    if for_stmt_mentions_name(b, name, &block.stmts[stmt_idx]) then found = true end
    stmt_idx = stmt_idx + 1
  end
  found
end

def for_stmt_mentions_name(b: MirBuilder, name: String, stmt: Stmt) -> Bool
  let kind_name = stmt_kind_name(&stmt.kind)
  if kind_name == "StmtLet" then
    match stmt.kind
    when StmtKind::StmtLet(_, _, value, _) then for_expr_mentions_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtAssign" then
    match stmt.kind
    when StmtKind::StmtAssign(target, value) then
      for_expr_mentions_name(b, name, &target) || for_expr_mentions_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtCompoundAssign" then
    match stmt.kind
    when StmtKind::StmtCompoundAssign(_, target, value) then
      for_expr_mentions_name(b, name, &target) || for_expr_mentions_name(b, name, &value)
    when _ then false
    end
  elsif kind_name == "StmtIf" then
    match stmt.kind
    when StmtKind::StmtIf(if_stmt) then for_if_mentions_name(b, name, &if_stmt)
    when _ then false
    end
  elsif kind_name == "StmtMatch" then
    match stmt.kind
    when StmtKind::StmtMatch(m) then for_match_mentions_name(b, name, &m)
    when _ then false
    end
  elsif kind_name == "StmtWhile" then
    match stmt.kind
    when StmtKind::StmtWhile(cond, body) then
      for_expr_mentions_name(b, name, &cond) || for_block_mentions_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "StmtFor" then
    match stmt.kind
    when StmtKind::StmtFor(for_stmt) then
      for_expr_mentions_name(b, name, &for_stmt.iter) || for_block_mentions_name(b, name, &for_stmt.body)
    when _ then false
    end
  elsif kind_name == "StmtLoop" then
    match stmt.kind
    when StmtKind::StmtLoop(body) then for_block_mentions_name(b, name, &body)
    when _ then false
    end
  elsif kind_name == "StmtReturn" then
    match stmt.kind
    when StmtKind::StmtReturn(val_opt) then
      match val_opt
      when Option::Some(val) then for_expr_mentions_name(b, name, &val)
      when Option::None then false
      end
    when _ then false
    end
  elsif kind_name == "StmtBreak" then
    match stmt.kind
    when StmtKind::StmtBreak(val_opt) then
      match val_opt
      when Option::Some(val) then for_expr_mentions_name(b, name, &val)
      when Option::None then false
      end
    when _ then false
    end
  elsif kind_name == "StmtContinue" then
    false
  elsif kind_name == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(expr) then for_expr_mentions_name(b, name, &expr)
    when _ then false
    end
  elsif kind_name == "StmtUnsafe" then
    match stmt.kind
    when StmtKind::StmtUnsafe(_, block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtDefer" then
    match stmt.kind
    when StmtKind::StmtDefer(block) then for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtGuard" then
    match stmt.kind
    when StmtKind::StmtGuard(cond, else_action) then
      var found = for_expr_mentions_name(b, name, &cond)
      match else_action
      when GuardElse::Return(opt) then
        match opt
        when Option::Some(val) then if for_expr_mentions_name(b, name, &val) then found = true end
        when Option::None then ()
        end
      when GuardElse::Panic(_) then ()
      when GuardElse::Break(opt) then
        match opt
        when Option::Some(val) then if for_expr_mentions_name(b, name, &val) then found = true end
        when Option::None then ()
        end
      when GuardElse::Continue then ()
      end
      found
    when _ then false
    end
  elsif kind_name == "StmtTry" then
    match stmt.kind
    when StmtKind::StmtTry(body, catches, finally_block) then
      var found = for_block_mentions_name(b, name, &body)
      var c_idx = 0
      while c_idx < catches.len() do
        if for_block_mentions_name(b, name, &catches[c_idx].body) then found = true end
        c_idx = c_idx + 1
      end
      match finally_block
      when Option::Some(fb) then if for_block_mentions_name(b, name, &fb) then found = true end
      when Option::None then ()
      end
      found
    when _ then false
    end
  elsif kind_name == "StmtWith" then
    match stmt.kind
    when StmtKind::StmtWith(expr, _, block) then
      for_expr_mentions_name(b, name, &expr) || for_block_mentions_name(b, name, &block)
    when _ then false
    end
  elsif kind_name == "StmtHandleWith" then
    match stmt.kind
    when StmtKind::StmtHandleWith(expr, handlers) then
      var found = for_expr_mentions_name(b, name, &expr)
      var h_idx = 0
      while h_idx < handlers.len() do
        let handler = handlers[h_idx]
        var a_idx = 0
        while a_idx < handler.arms.len() do
          if for_block_mentions_name(b, name, &handler.arms[a_idx].body) then found = true end
          a_idx = a_idx + 1
        end
        h_idx = h_idx + 1
      end
      found
    when _ then false
    end
  else
    false
  end
end

def for_if_mentions_name(b: MirBuilder, name: String, if_stmt: IfStmt) -> Bool
  var found = for_expr_mentions_name(b, name, &if_stmt.cond)
  if for_block_mentions_name(b, name, &if_stmt.then_block) then found = true end
  var e_idx = 0
  while e_idx < if_stmt.elsif_branches.len() do
    if for_expr_mentions_name(b, name, &if_stmt.elsif_branches[e_idx].0) then found = true end
    if for_block_mentions_name(b, name, &if_stmt.elsif_branches[e_idx].1) then found = true end
    e_idx = e_idx + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then if for_block_mentions_name(b, name, &eb) then found = true end
  when Option::None then ()
  end
  found
end

def for_match_mentions_name(b: MirBuilder, name: String, m: MatchExpr) -> Bool
  var found = for_expr_mentions_name(b, name, &m.scrutinee)
  var a_idx = 0
  while a_idx < m.arms.len() do
    let arm = m.arms[a_idx]
    match arm.guard_expr
    when Option::Some(guard) then if for_expr_mentions_name(b, name, &guard) then found = true end
    when Option::None then ()
    end
    if for_block_mentions_name(b, name, &arm.body) then found = true end
    a_idx = a_idx + 1
  end
  found
end

# the plan-absent element type — the TYPED iter type's element for
# the array/vec/slice class (the ONLY class the projected path is entered
# for), extracted mechanically from the typed record (refs peeled, the Adt
# args of the Slice/Vec/Array storage forms). Anything else is Type::Unit —
# the collection (MirLen) fallback in lower_for handles it. This is
# construction-site typing of the synthesized loop IR, never a semantic
# re-derivation: the type it reads is the typed record of the iterable.
def mir_iter_elem_type(b: MirBuilder, ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then mir_iter_elem_type(b, inner)
  when Type::Adt(tid, args) then
    let iet_named = match b.typed_type_names.get(tid.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
    if (iet_named == "Slice" || iet_named == "Vec" || iet_named == "Array") && !args.is_empty() then
      args[0].clone()
    else
      Type::Unit
    end
  when _ then Type::Unit
  end
end

def lower_for_projected(inout b: MirBuilder, pat: Pattern, iter: Expr, body: Block, span: Span, elem_ty: Type, len_callee: String, loop_id: Int) -> Unit
  let var_name = match pat.kind
  when PatternKind::Ident(name, _) then name.clone()
  when _ then "_for_var"
  end
  let iter_expr_ty = mir_source_expr_ty(b, iter)
  let iter_place = lower_place(b, iter)
  let recv_is_borrowed = match iter_expr_ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end
  let recv_ref_tmp = add_temp(b, Type::RefInternal(strip_ref_for_keys(iter_expr_ty.clone()), false), span)
  let recv_op = if recv_is_borrowed then
    operand_copy(iter_place)
  else
    push_assign(b, place_local(recv_ref_tmp), MirRvalue { kind: MirRvalueKind::MirRef(iter_place) }, span)
    operand_copy_local(recv_ref_tmp)
  end
  # PHASE-2: the projected length call stays the runtime Vec__len call, and
  # its selection is decided UPSTREAM by the IterationPlan's source kind
  # (the array/vec class, 0, is the ONLY class the projected path is entered
  # for); the plan-absent fallback passes the constant "Vec__len" (the
  # array/vec class callee). Anything else reaching this path fails
  # closed — the projected lowering assumes a length-indexed collection.
  if len_callee == "" then
    panic("internal error: projected for-loop requires the array/vec len callee (the IterationPlan's source kind must be the array/vec class)")
  end
  # ZERO-INFERENCE: the projected for-loop's length call is IR-SYNTHESIZED
  # (no AST node, no checker instance), and its callee — "Vec__len" — is a
  # GENERIC method base (the self param carries Param("T")). The instance
  # is therefore attached BY CONSTRUCTION: the element type the MIR derived
  # from the iterable (the MIR passes concrete arg types) becomes the
  # substs, and the resolver's method DefId (method_def_ids — the same
  # DefId the checker records for source len() calls) makes the instance
  # key byte-identical to the checker-solved instances, so the
  # monomorphizer cache stays single-sourced. A callee with no registered
  # DefId keeps the name-only form (a non-generic or missing target — the
  # monomorphizer's fail-closed check then reports it).
  let len_instance = match b.method_def_ids.get(&len_callee)
  when Option::Some(did) then
    Option::Some(InstanceId { def: CallableId { def: did.clone() }, substs: vec![elem_ty.clone()] })
  when Option::None then Option::None
  end
  let len_ret = add_temp(b, Type::Int, span)
  let len_success = create_block(b)
  var len_args = Vec::new()
  len_args.push(MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(recv_op) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(len_ret),
    func: mir_fn_operand_with_instance(b, len_callee.clone(), len_instance),
    args: len_args,
    success: len_success,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  switch_to_block(b, len_success)
  let hi_local = add_temp(b, Type::Int, span)
  push_assign(b, place_local(hi_local), move_rvalue(operand_copy_local(len_ret)), span)
  let idx_local = add_temp(b, Type::Int, span)
  push_assign(b, place_local(idx_local), move_rvalue(operand_int(0)), span)
  let header = create_block(b)
  let body_blk = create_block(b)
  let exit_blk = create_block(b)
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_blk)
  b.continue_target = Option::Some(header)
  set_terminator(b, MirTerminatorKind::MirGoto(header), span)
  switch_to_block(b, header)
  let cmp_tmp = add_temp(b, Type::Bool, span)
  push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
    MirBinOp::Lt,
    operand_copy_local(idx_local),
    operand_copy_local(hi_local)
  ) }, span)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: targets, default_target: body_blk }, span)
  switch_to_block(b, body_blk)
  let idx_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(idx_tmp), move_rvalue(operand_copy_local(idx_local)), span)
  let base_ty = lookup_local_type(b, &iter_place.local)
  let place_needs_deref = match base_ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end
  var elem_projs = iter_place.projections.clone()
  if place_needs_deref && iter_place.projections.is_empty() then
    elem_projs.push(Projection::ProjDeref)
  end
  elem_projs.push(Projection::ProjIndex(idx_tmp))
  let elem_place = Place { local: iter_place.local, projections: elem_projs }
  let pattern_mut = match pat.kind
  when PatternKind::Ident(_, is_mut) then is_mut
  when _ then false
  end
  let x_local = add_local(b, var_name.clone(), elem_ty.clone(), pattern_mut, span)
 # record the for-pattern binding's semantic local (the same
  # mechanism the let/match pattern bindings use — record_semantic_pattern_
  # local): the checker may include the pattern binding in the loop's
  # backedge plan, and emit_loop_edge_cleanup must be able to resolve it
  # through semantic_to_mir instead of raising "no MIR local". Synthesized
  # patterns (node id 0) have no typed binding and are skipped.
  if pat.node_id != 0 then
    record_semantic_pattern_local(b, pat, x_local, "for binding")
  end
  push_assign(b, place_local(x_local), move_rvalue(operand_copy(elem_place)), span)
 # the loop body is a lexical defer scope, pushed NEGATED (checker's
  # check_loop_body parity): break/continue/backedge walks stop exactly at
  # the loop boundary.
  let proj_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
  if proj_body_key != 0 then
    b.defer_scope_chain.push(0 - proj_body_key)
  end
  lower_block(b, body)
  if proj_body_key != 0 then
    b.defer_scope_chain.pop()
  end
  if !block_is_terminated(b) then
    let inc_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(inc_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::Add,
      operand_copy_local(idx_local),
      operand_int(1)
    ) }, span)
    push_assign(b, place_local(idx_local), move_rvalue(operand_copy_local(inc_tmp)), span)
    # Per-iteration cleanup: loop-created resources are finalized at the end
 # of each iteration, before the backedge re-enters the header. the
    # edge map is consulted first; the string key is the fallback.
    emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
  end
  b.break_target = old_break
  b.continue_target = old_continue
  switch_to_block(b, exit_blk)
end

# ———————————————————————————————————————————————————————————————
# (consuming iteration): the CONSUME-MODE loop lowering.
#
# The resource checker's IterationPlan access kind for an OWNED heap
# container is Consume (snapshot iteration today). The consume mode below
# lowers that plan as the ownership-aware iterator: each iteration MOVES
# the element OUT of the container exactly once —
#   - Vec/Array (source_kind 0): __intrinsic_array_pop — the last element
#     is moved out and the container's len shrinks;
#   - Map (source_kind 1): __intrinsic_map_drain_one — the first live
#     entry is moved out (sret Option[(K, V)]), the slot becomes dead;
#   - Set (source_kind 2): __intrinsic_set_drain_one — the first live
#     element is moved out (sret Option[T]).
# The loop condition is the container's LIVE LENGTH (MirLen) — the
# container's len shrinks per iteration, so the header re-check is the
# per-iteration consume; the loop backedge / early-exit cleanup is part of
# the CFG (emit_loop_edge_cleanup on the backedge, the break/continue
# targets on the exit block — the same edge machinery as the projected and
# index loop forms). The binding is the drained payload MOVED out of the
# Option (never a raw copy); after the loop the container is empty and its
# own drop is the no-op drain.
# ———————————————————————————————————————————————————————————————

# Whether a for-loop's iterable can lower through the consume mode: a
# ROOTABLE PLACE (the same place-kind set as the collection-based lowering)
# whose type is NOT a borrow (a RefInternal iterable cannot be drained —
# the consumption would mutate the borrow's referent) and not unresolved.
def for_consume_capable(b: MirBuilder, iter: Expr) -> Bool
  let kind_name = expr_kind_name(&iter.kind)
  if kind_name != "ExprIdent" && kind_name != "ExprSelfRef" && kind_name != "ExprFieldAccess" && kind_name != "ExprRawDeref" && kind_name != "ExprIndex" then
    return false
  end
  match mir_source_expr_ty(b, iter)
  when Type::RefInternal(_, _) then false
  when Type::Unit then false
  when _ then true
  end
end

# The consume-mode loop body (see the section note): drains the container
# per iteration and binds the moved-out element. `plan` is the checker's
# IterationPlan (the access must be Consume; the element_type and the
# source kind select the drain callee and the payload shape).
def lower_for_consume(inout b: MirBuilder, pat: Pattern, iter: Expr, body: Block, span: Span, loop_id: Int, plan: IterationPlan) -> Unit
  let var_name = match pat.kind
  when PatternKind::Ident(name, _) then name.clone()
  when _ then "_for_var"
  end
  let elem_ty = plan.element_type.clone()
  let iter_place = lower_place(b, iter)
  # The drain callee + the payload type per the plan's source kind (0 =
  # array/vec, 1 = map, 2 = set — the same classification the checker's
  # for_iterable_kind produced).
  let (drain_name, payload_ty) = match plan.source_kind
  when 1 then ("__intrinsic_map_drain_one".to_string(), elem_ty.clone())
  when 2 then ("__intrinsic_set_drain_one".to_string(), elem_ty.clone())
  when _ then ("__intrinsic_array_pop".to_string(), elem_ty.clone())
  end
  let opt_ty = Type::Adt(TypeId { id: b.lang_items.option }, Vec::from([payload_ty]))
  let ret_local = add_temp(b, opt_ty, span)

  let header = create_block(b)
  let body_blk = create_block(b)
  let exit_blk = create_block(b)
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_blk)
  b.continue_target = Option::Some(header)
  set_terminator(b, MirTerminatorKind::MirGoto(header), span)

  # Header: the container's LIVE length — the per-iteration consume check
  # (each drain shrinks the len, so the header re-check is the consume).
  switch_to_block(b, header)
  let len_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(len_tmp), MirRvalue { kind: MirRvalueKind::MirLen(iter_place) }, span)
  let cmp_tmp = add_temp(b, Type::Bool, span)
  push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
    MirBinOp::Gt,
    operand_copy_local(len_tmp),
    operand_int(0)
  ) }, span)
  var targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: targets, default_target: body_blk }, span)

  # Body: drain one element (moved out of the container — the slot becomes
  # dead / the len shrinks).
  switch_to_block(b, body_blk)
  let drain_callee = MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem(drain_name),
      ty: Type::Unit,
      instance: Option::None
    })
  }
  let drain_succ = create_block(b)
  var drain_args = Vec::new()
  drain_args.push(MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(iter_place) }) })
  set_terminator(b, MirTerminatorKind::MirCall {
    dest: place_local(ret_local),
    func: drain_callee,
    args: drain_args,
    success: drain_succ,
    intrinsic: Option::None,
    unwind: Option::None
  }, span)
  switch_to_block(b, drain_succ)
  let disc_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(disc_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(ret_local)) }, span)
  let some_blk = create_block(b)
  let none_blk = create_block(b)
  var d_targets = Vec::new()
  d_targets.push(SwitchTarget { value: 0, target: some_blk })
  d_targets.push(SwitchTarget { value: 1, target: none_blk })
  set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(disc_tmp), targets: d_targets, default_target: none_blk }, span)
  switch_to_block(b, none_blk)
  set_terminator(b, MirTerminatorKind::MirGoto(exit_blk), span)
  switch_to_block(b, some_blk)
  # The element binding: the drained payload MOVED out of the Option.
  var some_projs = place_local(ret_local).projections.clone()
  some_projs.push(Projection::Variant(mir_synth_variant(b, &place_local(ret_local), "Some", "consume iteration")))
  let payload_place = Place { local: ret_local, projections: some_projs }
  let elem_rvalue = MirRvalue { kind: MirRvalueKind::MirMove(MirOperand { kind: MirOperandKind::MirCopy(payload_place) }) }
  match pat.kind
  when PatternKind::Ident(_, pattern_mut) then
    let elem_local = add_local(b, var_name.clone(), elem_ty, pattern_mut, span)
 # record the for-pattern binding's semantic local (the same
    # mechanism the let/match pattern bindings use): the checker may
    # include the pattern binding in the loop's backedge plan, and
    # emit_loop_edge_cleanup must resolve it through semantic_to_mir.
    if pat.node_id != 0 then
      record_semantic_pattern_local(b, pat, elem_local, "for binding")
    end
    push_assign(b, place_local(elem_local), elem_rvalue, span)
  when _ then
    lower_pattern_assignment(b, pat, &elem_rvalue, &elem_ty, span)
  end
 # the loop body is a lexical defer scope, pushed NEGATED (checker's
  # check_loop_body parity): break/continue/backedge walks stop exactly at
  # the loop boundary.
  let consume_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
  if consume_body_key != 0 then
    b.defer_scope_chain.push(0 - consume_body_key)
  end
  lower_block(b, body)
  if consume_body_key != 0 then
    b.defer_scope_chain.pop()
  end
  if !block_is_terminated(b) then
    # Per-iteration cleanup of loop-created resources before the backedge.
 # the edge map is consulted first; the string key is the fallback.
    emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
  end
  b.break_target = old_break
  b.continue_target = old_continue
  switch_to_block(b, exit_blk)
end

def lower_for(inout b: MirBuilder, pat: Pattern, iter: Expr, body: Block, span: Span, loop_id: Int) -> Unit
 # (phase 2): the projected-vs-consuming decision comes from
  # the TYPED iteration record — TypedIteration { plan } (the resource
  # checker's check_for, keyed by the for-stmt node id — lower_for's
  # loop_id IS stmt.node_id; the typed statement record
  # (TypedStmtKind::For.iteration, types.tg) carries the same join key).
  # A Read plan means the checker judged projected (by-reference)
  # iteration safe and its projected-iteration guard
  # (check_iter_binding_escape) is the authority that the binding cannot
  # escape the loop body — the MIR therefore needs no name-use scan of its
  # own for that decision. The plan also carries the element type (the
  # checker classifies the iterable from the same typed expr_types the MIR
  # uses) and the pattern's binding ids.
  # Fallback: a plan is absent only for for-stmts the checker never
  # processed. A SOURCE for-stmt without a plan is a checker/MIR gap —
  # fail-closed (internal error; the lowering aborts at the error drain).
  # The plan-absent path below (the projected-safety heuristic,
  # including the name-use scan) stays only as the documented synthesized
  # fallback, and its types come from the TYPED iter type — the element is
  # the index projection of resolve_iter_expr_type's typed record
  # (mir_project_index_type), and the projected len callee is the constant
  # "Vec__len" (the array/vec class — the only class the projected path is
  # entered for).
  match typed_iteration_of(b, loop_id)
  when Option::Some(ti) then
    let plan = ti.plan
    if plan.source_kind == 0 && plan.access == AccessEffect::Read then
      # The element type AND the length-callee selection come from the
      # TYPED plan — the element_type the checker classified from the
      # typed expr_types, and the source kind (0 = array/vec, the only
      # class the projected path is entered for) selecting the runtime
      # Vec__len call. No MIR-side type scan participates.
      lower_for_projected(b, pat, iter, body, span, &plan.element_type, if plan.source_kind == 0 then "Vec__len" else "" end, loop_id)
      return
    end
 # (consuming iteration): a Consume plan over an OWNED rootable
    # container lowers as the consume-mode loop — each iteration MOVES the
    # element out of the container exactly once (the drain/pop intrinsic;
    # the container's len shrinks or the slot becomes dead; the backedge /
    # early-exit cleanup is part of the CFG). The checker's plan access is
    # the authority for the mode; the consume capability gate (an owned
    # place, not a borrow) is the MIR-side soundness check.
    if plan.access == AccessEffect::Consume && for_consume_capable(b, iter) then
      lower_for_consume(b, pat, iter, body, span, loop_id, &plan)
      return
    end
  when Option::None then
    if loop_id != 0 then
      b.errors.push("internal error: missing typed iteration record for for-stmt node " + loop_id.to_string() + " during MIR lowering")
    end
    let iter_ty_fb = resolve_iter_expr_type(b, iter)
    let for_safe_elem = mir_iter_elem_type(b, &iter_ty_fb)
    if for_safe_elem != Type::Unit && for_body_is_projected_safe(b, pat, body) then
      lower_for_projected(b, pat, iter, body, span, &for_safe_elem, "Vec__len", loop_id)
      return
    end
  end
  # Desugar for loops:
  #   Range-based: for var in lo..hi → while var < hi { body; var += 1 }
  #   Collection-based: for var in coll → index-based iteration
  let lower_for_iter_kind = expr_kind_name(&iter.kind)
  if lower_for_iter_kind == "ExprRange" then
    match iter.kind
    when ExprKind::ExprRange(lo_box, hi_box, _incl) then
    # Range-based for (only works with simple Ident pattern for now)
    let var_name = match pat.kind
    when PatternKind::Ident(name, _) then name.clone()
    when _ then "_for_var"
    end

    var lo_op = operand_int(0)
    match lo_box
    when Option::Some(lo_e) then
      lo_op = lower_expr(b, &lo_e, span)
    when Option::None then ()
    end
    var hi_op = operand_int(0)
    match hi_box
    when Option::Some(hi_e) then
      hi_op = lower_expr(b, &hi_e, span)
    when Option::None then ()
    end

    let hi_counter = b.local_counter
    add_local(b, "_for_hi", Type::Int, false, span)
    push_assign(b, place_local(MirLocalId { id: hi_counter }), MirRvalue { kind: MirRvalueKind::MirMove(hi_op) }, span)

    let var_counter = b.local_counter
    let range_var_local = add_local(b, var_name, Type::Int, true, span)
 # record the for-pattern binding's semantic local (the same
    # mechanism the let/match pattern bindings use): the checker may include
    # the pattern binding in the loop's backedge plan, and
    # emit_loop_edge_cleanup must resolve it through semantic_to_mir.
    if pat.node_id != 0 then
      record_semantic_pattern_local(b, pat, range_var_local, "for binding")
    end
    push_assign(b, place_local(MirLocalId { id: var_counter }), MirRvalue { kind: MirRvalueKind::MirMove(lo_op) }, span)

    let header   = create_block(b)
    let body_blk = create_block(b)
    let exit_blk = create_block(b)

    # Save and set break/continue targets
    let old_break = b.break_target
    let old_continue = b.continue_target
    b.break_target = Option::Some(exit_blk)
    b.continue_target = Option::Some(header)

    set_terminator(b, MirTerminatorKind::MirGoto(header), span)

    switch_to_block(b, header)
    let cmp_counter = b.local_counter
    add_temp(b, Type::Bool, span)
    let var_place = place_local(MirLocalId { id: var_counter })
    let hi_place  = place_local(MirLocalId { id: hi_counter })
    let cmp_place = place_local(MirLocalId { id: cmp_counter })
    let var_op_cmp = operand_copy(var_place)
    let hi_op_cmp  = operand_copy(hi_place)
    let cmp_rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Lt, var_op_cmp, hi_op_cmp) }
    push_assign(b, cmp_place, cmp_rvalue, span)
    let cmp_op = operand_copy_local(MirLocalId { id: cmp_counter })
    var targets = Vec::new()
    # The condition-false exit performs NO cleanup: the backedge cleanup
    # already ran for the last completed iteration before the header re-check.
    targets.push(SwitchTarget { value: 0, target: exit_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cmp_op, targets: targets, default_target: body_blk }, span)

    switch_to_block(b, body_blk)
 # the loop body is a lexical defer scope, pushed NEGATED (checker's
    # check_loop_body parity): break/continue/backedge walks stop exactly at
    # the loop boundary.
    let range_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
    if range_body_key != 0 then
      b.defer_scope_chain.push(0 - range_body_key)
    end
    lower_block(b, body)
    if range_body_key != 0 then
      b.defer_scope_chain.pop()
    end
    if !block_is_terminated(b) then
      let inc_counter = b.local_counter
      add_temp(b, Type::Int, span)
      let var_place2 = place_local(MirLocalId { id: var_counter })
      let inc_place  = place_local(MirLocalId { id: inc_counter })
      let var_op_inc = operand_copy(var_place2)
      let one_const  = operand_int(1)
      let inc_rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Add, var_op_inc, one_const) }
      push_assign(b, inc_place, inc_rvalue, span)
      let var_place3 = place_local(MirLocalId { id: var_counter })
      let inc_result = operand_copy_local(MirLocalId { id: inc_counter })
      push_assign(b, var_place3, move_rvalue(inc_result), span)
      # Per-iteration cleanup of loop-created resources before the backedge.
 # the edge map is consulted first; the string key is the fallback.
      emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
    end

    b.break_target = old_break
    b.continue_target = old_continue
    switch_to_block(b, exit_blk)
    when _ then ()
    end
  else
    # Collection-based for: desugar to index-based iteration.
    # Resolve the iterator type from the expression so that codegen's
    # ProjIndex handler can correctly identify heap collections and load
    # the data pointer from the collection header.
    let iter_kind_name = expr_kind_name(&iter.kind)
    let iter_is_place =
      iter_kind_name == "ExprIdent" || iter_kind_name == "ExprSelfRef" ||
      iter_kind_name == "ExprFieldAccess" || iter_kind_name == "ExprRawDeref" ||
      iter_kind_name == "ExprIndex"
    var iter_place = place_local(MirLocalId { id: 0 })
    let iter_expr_ty = if iter_is_place then
      let resolved_iter_ty = resolve_iter_expr_type(b, iter)
      iter_place = lower_place(b, iter)
      resolved_iter_ty
    else
      resolve_iter_expr_type(b, iter)
    end
    let iter_local_ty = if iter_is_place then
      Type::RefInternal(iter_expr_ty.clone(), false)
    else
      iter_expr_ty.clone()
    end
    let iter_local = add_temp(b, iter_local_ty, span)
    if iter_is_place then
      push_assign(b, place_local(iter_local), MirRvalue { kind: MirRvalueKind::MirRef(iter_place) }, span)
    else
      let iter_op = lower_expr(b, iter, span)
      push_assign(b, place_local(iter_local), MirRvalue { kind: MirRvalueKind::MirMove(iter_op) }, span)
    end

    let iter_ty = lookup_local_type(b, &iter_local)
    let iter_needs_deref = match iter_ty
    when Type::RefInternal(_, _) then true
    when Type::Unit then true
    when _ then false
    end

    var len_projs = Vec::new()
    if iter_needs_deref then
      len_projs.push(Projection::ProjDeref)
    end
    let len_place = Place { local: iter_local, projections: len_projs }

 # this MirLen is the loop path's length read over the iterated
    # collection. It is NOT a generic offset-8 assumption: the loop lowering
    # cannot always know the collection kind (unresolved iterator types fall
    # back to Type::Unit here, and the iterator local may be a reference that
    # must be ProjDeref'd), so it cannot statically select the runtime length
    # intrinsic (__intrinsic_{array,map,set}_len) the way the method-call path
    # does. MirLen's offset semantics are representation-dependent and are
    # resolved by the codegen's representation knowledge: the MirLen emitter in
    # codegen.tg applies emit_len_ref_derefs and dereferences the heap-
    # collection header via is_heap_collection_type, so the offset-8 knowledge
    # lives in that one codegen place, not in the MIR instruction's semantics.
    let len_local = add_temp(b, Type::Int, span)
    push_assign(b, place_local(len_local), MirRvalue { kind: MirRvalueKind::MirLen(len_place) }, span)

    let idx_local = add_temp(b, Type::Int, span)
    push_assign(b, place_local(idx_local), move_rvalue(operand_int(0)), span)

    let header   = create_block(b)
    let body_blk = create_block(b)
    let exit_blk = create_block(b)

    let old_break = b.break_target
    let old_continue = b.continue_target
    b.break_target = Option::Some(exit_blk)
    b.continue_target = Option::Some(header)

    set_terminator(b, MirTerminatorKind::MirGoto(header), span)

    switch_to_block(b, header)
    let cmp_tmp = add_temp(b, Type::Bool, span)
    push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
      MirBinOp::Lt,
      operand_copy_local(idx_local),
      operand_copy_local(len_local)
    ) }, span)
    let cmp_op = operand_copy_local(cmp_tmp)
    var targets = Vec::new()
    # The condition-false exit performs NO cleanup: the backedge cleanup
    # already ran for the last completed iteration before the header re-check.
    targets.push(SwitchTarget { value: 0, target: exit_blk })
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: cmp_op, targets: targets, default_target: body_blk }, span)

    switch_to_block(b, body_blk)
    # element = iter[idx]
    # When the iterator type is a known heap collection (Vec, Array, etc.),
    # codegen's ProjIndex handler loads the data pointer from the header
    # automatically when it can identify the type as a heap collection.
    # When the type could not be resolved (Unit fallback), insert a
    # ProjDeref to ensure the data pointer gets loaded before indexing.
    # References always need a ProjDeref to unwrap the pointer indirection.
    var projs = Vec::new()
    if iter_needs_deref then
      projs.push(Projection::ProjDeref)
    end
    projs.push(Projection::ProjIndex(idx_local))
    let elem_place = Place { local: iter_local, projections: projs }
    let elem_op = operand_copy(elem_place)
    
    # assign element to pattern
    let elem_rvalue = MirRvalue { kind: MirRvalueKind::MirMove(elem_op) }
    match pat.kind
    when PatternKind::Ident(name, pattern_mut) then
      let elem_ty = mir_project_index_type(b, &iter_ty)
      let elem_local = add_local(b, name.clone(), elem_ty, pattern_mut, span)
 # record the for-pattern binding's semantic local (the same
      # mechanism the let/match pattern bindings use): the checker may
      # include the pattern binding in the loop's backedge plan, and
      # emit_loop_edge_cleanup must resolve it through semantic_to_mir.
      if pat.node_id != 0 then
        record_semantic_pattern_local(b, pat, elem_local, "for binding")
      end
      push_assign(b, place_local(elem_local), elem_rvalue, span)
    when _ then
      let elem_ty_for_pat = mir_project_index_type(b, &iter_ty)
      lower_pattern_assignment(b, pat, &elem_rvalue, &elem_ty_for_pat, span)
    end

 # the loop body is a lexical defer scope, pushed NEGATED (checker's
    # check_loop_body parity): break/continue/backedge walks stop exactly at
    # the loop boundary.
    let coll_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
    if coll_body_key != 0 then
      b.defer_scope_chain.push(0 - coll_body_key)
    end
    lower_block(b, body)
    if coll_body_key != 0 then
      b.defer_scope_chain.pop()
    end
    if !block_is_terminated(b) then
      let inc_tmp = add_temp(b, Type::Int, span)
      push_assign(b, place_local(inc_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
        MirBinOp::Add,
        operand_copy_local(idx_local),
        operand_int(1)
      ) }, span)
      push_assign(b, place_local(idx_local), move_rvalue(operand_copy_local(inc_tmp)), span)
      set_terminator(b, MirTerminatorKind::MirGoto(header), span)
      # Per-iteration cleanup of loop-created resources before the backedge.
 # the edge map is consulted first; the string key is the fallback.
      emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
    end

    b.break_target = old_break
    b.continue_target = old_continue
    switch_to_block(b, exit_blk)
  end
end

def lower_loop(inout b: MirBuilder, body: Block, span: Span, loop_id: Int) -> Unit
  let header = create_block(b)
  let exit_block = create_block(b)
  
  # Save and set break/continue targets
  let old_break = b.break_target
  let old_continue = b.continue_target
  b.break_target = Option::Some(exit_block)
  b.continue_target = Option::Some(header)

  set_terminator(b, MirTerminatorKind::MirGoto(header), span)

  switch_to_block(b, header)
 # the loop body is a lexical defer scope, pushed NEGATED (checker's
  # check_loop_body parity): break/continue/backedge walks stop exactly at
  # the loop boundary.
  let loop_body_key = if body.stmts.len() > 0 then body.stmts[0].node_id else 0 end
  if loop_body_key != 0 then
    b.defer_scope_chain.push(0 - loop_body_key)
  end
  lower_block(b, body)
  if loop_body_key != 0 then
    b.defer_scope_chain.pop()
  end
  if !block_is_terminated(b) then
 # the BACKEDGE cleanup comes from the edge map first
    # ("edge::Backedge::<loop id>"); "backedge::<loop id>" is the fallback.
    emit_loop_edge_cleanup(b, CfgEdgeKind::Backedge, loop_id, Option::Some(header), span)
  end
  
  # Restore break/continue targets
  b.break_target = old_break
  b.continue_target = old_continue
  
  switch_to_block(b, exit_block)
end

def lower_match(inout b: MirBuilder, m: MatchExpr, span: Span) -> Unit
  let scrutinee = lower_expr(b, &m.scrutinee, span)
  let scrutinee_ty = mir_source_expr_ty(b, &m.scrutinee)

  # Store the scrutinee value in a local
  let scrut_raw = add_temp(b, scrutinee_ty, span)
  push_assign(b, place_local(scrut_raw), MirRvalue { kind: MirRvalueKind::MirMove(scrutinee) }, span)

  # Auto-dereference if the scrutinee's type is a reference. Using the type
  # (rather than enumerating expression kinds) covers `match x.kind` and
  # `match term.kind` as well as plain reference identifiers — otherwise the
  # discriminant would be read from the pointer itself, producing a garbage
  # tag.
  var scrut_is_ref = false
  match scrutinee_ty
  when Type::RefInternal(_, _) then scrut_is_ref = true
  when _ then ()
  end
  let scrut_local = if scrut_is_ref then
    let dt = add_temp(b, Type::Int, span)
    var dp = place_local(scrut_raw)
    dp.projections.push(Projection::ProjDeref)
    push_assign(b, place_local(dt), move_rvalue(operand_copy(dp)), span)
    dt
  else
    scrut_raw
  end

  # Determine if this is an enum match or literal match
  # by checking first non-wildcard pattern
  var is_enum_match = false
  var match_enum_name = ""
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Variant(path, _) then
      is_enum_match = true
      if path.segments.len() >= 2 then
        match_enum_name = path.segments[path.segments.len() - 2].clone()
      end
    when _ then ()
    end
  end

  # Check if the enum has payload variants (heap-allocated) or is simple (integer tag)
  # Default to true for unknown enums (e.g. Option, Result from std) since they have payloads
  let needs_discriminant = if is_enum_match then
    match b.enum_has_payload.get(match_enum_name)
    when Option::Some(hp) then
      hp
    when Option::None then
      true
    end
  else
    false
  end

  # For enum matching, extract discriminant; for literal matching, use raw value
  let switch_local = if needs_discriminant then
    let discr_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(
      place_local(scrut_local)
    ) }, span)
    discr_tmp
  else
    scrut_local
  end

  let join_block = create_block(b)

  # Create a block for each arm
  var arm_blocks = Vec::new()
  for arm in m.arms do
    arm_blocks.push(create_block(b))
  end

  # Find default target: last wildcard/ident arm, or join_block
  let real_default = if m.arms.len() > 0 then
    var def_target = join_block
    var j = 0
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Wildcard then
        def_target = arm_blocks[j]
      when PatternKind::Ident(_, _) then
        def_target = arm_blocks[j]
      when _ then ()
      end
      j = j + 1
    end
    def_target
  else
    join_block
  end

  # Check if any arm has string literal patterns
  var has_string_patterns = false
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Literal(expr) then
      match expr.kind
      when ExprKind::ExprStringLit(_) then has_string_patterns = true
      when _ then ()
      end
    when _ then ()
    end
  end

  var i = 0

  if has_string_patterns then
    # String patterns cannot use SwitchInt (integer comparison).
    # Emit an if-else chain of string equality comparisons instead.
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Literal(expr) then
        match expr.kind
        when ExprKind::ExprStringLit(s_val) then
          let cmp_tmp = add_temp(b, Type::Bool, span)
          push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
            MirBinOp::Eq, operand_copy_local(scrut_local), operand_constant(constant_string(s_val))
          ) }, span)
          let next_check = create_block(b)
          var st = Vec::new()
          st.push(SwitchTarget { value: 1, target: arm_blocks[i] })
          set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: st, default_target: next_check }, span)
          switch_to_block(b, next_check)
        when _ then ()
        end
      when _ then ()
      end
      i = i + 1
    end
    # After all string checks, fall through to default
    set_terminator(b, MirTerminatorKind::MirGoto(real_default), span)
  else
    # Build switch targets from patterns (non-string)
    var switch_targets = Vec::new()
    for arm in m.arms do
      var is_catchall = false
      let disc_val = match arm.pattern.kind
      when PatternKind::Literal(expr) then
        match expr.kind
        when ExprKind::ExprIntLit(n) then n
        when ExprKind::ExprBoolLit(bool_lit) then if bool_lit then 1 else 0 end
        when ExprKind::ExprCharLit(c) then c as Int
        when _ then i
        end
      when PatternKind::Variant(path, _) then
        resolve_enum_variant_discriminant_or(b, &path, i)
      when PatternKind::Wildcard then
        is_catchall = true
        0
      when PatternKind::Ident(_, _) then
        is_catchall = true
        0
      when _ then i
      end

      if !is_catchall then
        switch_targets.push(SwitchTarget { value: disc_val, target: arm_blocks[i] })
      end
      i = i + 1
    end

    # Emit switch on the appropriate local
    let switch_op = operand_copy_local(switch_local)
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: switch_op, targets: switch_targets, default_target: real_default }, span)
  end

  # Emit each arm body
  i = 0
  for arm in m.arms do
    switch_to_block(b, arm_blocks[i])

    # Payload guard for variant with literal sub-patterns
    match arm.pattern.kind
    when PatternKind::Variant(path, sub_pats) then
      if sub_pats.len() > 0 then
        var has_lit = false
        var lit_val = 0
        match sub_pats[0].kind
        when PatternKind::Literal(lit_expr) then
          has_lit = true
          lit_val = match lit_expr.kind
          when ExprKind::ExprIntLit(n) then n
          when ExprKind::ExprBoolLit(bv) then if bv then 1 else 0 end
          when ExprKind::ExprCharLit(c) then c as Int
          when _ then 0
          end
        when _ then ()
        end
        if has_lit then
          let vn = if path.segments.len() > 0 then
            path.segments[path.segments.len() - 1].clone()
          else "" end
          let vd = resolve_enum_variant_discriminant_or(b, &path, 0)
 # the payload-guard downcast is ALWAYS the typed VariantId
          # (the scrutinee's enum owner TypeId + the variant's
          # declaration-order index); a source arm the typed tables cannot
          # resolve is an internal error (fail-closed). The payload field
          # is Field(FieldId) with the scrutinee enum's TypeId.
          let vproj_path_enum = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2].clone() else "" end
          var vproj = Projection::Variant(VariantId { owner: TypeId { id: -1 }, index: 0 })
          var vproj_enum_tid = TypeId { id: -1 }
          match mir_enum_owner_tid(b, &scrutinee_ty)
          when Option::Some(stid) then
            vproj_enum_tid = stid
            match typed_variant_id(b, &vproj_path_enum, &vn)
            when Option::Some(vid) then
              if vid.owner.id == stid.id then vproj = Projection::Variant(vid)
              else
                b.errors.push("internal error: variant '" + vn.clone() + "' owner does not match the scrutinee's enum TypeId during MIR lowering")
              end
            when Option::None then
              b.errors.push("internal error: missing typed variant identity for payload-guard variant '" + vn.clone() + "' during MIR lowering")
            end
          when Option::None then
            b.errors.push("internal error: missing typed scrutinee enum identity for payload-guard variant '" + vn.clone() + "' during MIR lowering")
          end
          var ppl = place_local(scrut_local)
          ppl.projections.push(vproj)
          ppl.projections.push(Projection::Field(FieldId { owner: TypeId { id: vproj_enum_tid.id }, index: 0 }))
          let pty = mir_place_type(&ppl, b)
          let ptmp = add_temp(b, pty, span)
          push_assign(b, place_local(ptmp), move_rvalue(operand_copy(ppl)), span)
          var ft = real_default
          var k = i + 1
          while k < m.arms.len() do
            match m.arms[k].pattern.kind
            when PatternKind::Variant(p2, _) then
              match resolve_enum_variant_discriminant(b, &p2)
              when Result::Ok(d2) then
                if d2 == vd then
                  ft = arm_blocks[k]
                  k = m.arms.len()
                end
              when Result::Err(e) then
                b.errors.push(e)
              end
            when PatternKind::Wildcard then
              ft = arm_blocks[k]
              k = m.arms.len()
            when PatternKind::Ident(_, _) then
              ft = arm_blocks[k]
              k = m.arms.len()
            when _ then ()
            end
            k = k + 1
          end
          let bdy = create_block(b)
          var pt = Vec::new()
          pt.push(SwitchTarget { value: lit_val, target: bdy })
          set_terminator(b, MirTerminatorKind::MirSwitchInt {
            op: operand_copy_local(ptmp),
            targets: pt,
            default_target: ft
          }, span)
          switch_to_block(b, bdy)
        end
      end
    when _ then ()
    end

    # Bind pattern variables
    bind_match_arm_pattern_locals(b, scrut_local, &arm.pattern, span)

    # Guard check
    match arm.guard_expr
    when Option::Some(guard_expr_val) then
      let guard_val = lower_expr(b, &guard_expr_val, span)
      let guard_pass = create_block(b)
      let guard_fail = if i + 1 < arm_blocks.len() then arm_blocks[i + 1] else join_block end
      var gt = Vec::new()
      gt.push(SwitchTarget { value: 0, target: guard_fail })
      set_terminator(b, MirTerminatorKind::MirSwitchInt { op: guard_val, targets: gt, default_target: guard_pass }, span)
      switch_to_block(b, guard_pass)
    when Option::None then ()
    end

    lower_block(b, &arm.body)
    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
    end

    i = i + 1
  end

  switch_to_block(b, join_block)
end

def lower_match_to_place(inout b: MirBuilder, m: MatchExpr, dest: Place, span: Span) -> Unit
  # Same as lower_match but stores each arm's last expression to dest
  let scrutinee = lower_expr(b, &m.scrutinee, span)
  let scrutinee_ty = mir_source_expr_ty(b, &m.scrutinee)

  let scrut_raw = add_temp(b, scrutinee_ty, span)
  push_assign(b, place_local(scrut_raw), MirRvalue { kind: MirRvalueKind::MirMove(scrutinee) }, span)

  # Auto-dereference if scrutinee is a reference type
  var scrut_is_ref2 = false
  match m.scrutinee.kind
  when ExprKind::ExprSelfRef then
    let sty2 = lookup_local_type_by_name(b, "self")
    match sty2
    when Type::RefInternal(_, _) then scrut_is_ref2 = true
    when _ then ()
    end
  when ExprKind::ExprIdent(name2) then
    let vty2 = lookup_local_type_by_name(b, name2.clone())
    match vty2
    when Type::RefInternal(_, _) then scrut_is_ref2 = true
    when _ then ()
    end
  when _ then ()
  end
  let scrut_local = if scrut_is_ref2 then
    let dt2 = add_temp(b, Type::Int, span)
    var dp2 = place_local(scrut_raw)
    dp2.projections.push(Projection::ProjDeref)
    push_assign(b, place_local(dt2), move_rvalue(operand_copy(dp2)), span)
    dt2
  else
    scrut_raw
  end

  var is_enum_match = false
  var match_enum_name = ""
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Variant(path, _) then
      is_enum_match = true
      if path.segments.len() >= 2 then
        match_enum_name = path.segments[path.segments.len() - 2].clone()
      end
    when _ then ()
    end
  end

  # Default to true for unknown enums (e.g. Option, Result from std) since they have payloads
  let needs_discriminant = if is_enum_match then
    match b.enum_has_payload.get(match_enum_name)
    when Option::Some(hp) then
      hp
    when Option::None then
      true
    end
  else
    false
  end

  let switch_local = if needs_discriminant then
    let discr_tmp = add_temp(b, Type::Int, span)
    push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::MirDiscriminant(
      place_local(scrut_local)
    ) }, span)
    discr_tmp
  else
    scrut_local
  end

  let join_block = create_block(b)

  var arm_blocks = Vec::new()
  for arm in m.arms do
    arm_blocks.push(create_block(b))
  end

  let real_default = if m.arms.len() > 0 then
    var def_target = join_block
    var j = 0
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Wildcard then def_target = arm_blocks[j]
      when PatternKind::Ident(_, _) then def_target = arm_blocks[j]
      when _ then ()
      end
      j = j + 1
    end
    def_target
  else
    join_block
  end

  # Check if any arm has string literal patterns
  var has_string_patterns = false
  for arm in m.arms do
    match arm.pattern.kind
    when PatternKind::Literal(expr) then
      match expr.kind
      when ExprKind::ExprStringLit(_) then has_string_patterns = true
      when _ then ()
      end
    when _ then ()
    end
  end

  var i = 0

  if has_string_patterns then
    # String patterns cannot use SwitchInt (integer comparison).
    # Emit an if-else chain of string equality comparisons instead.
    for arm in m.arms do
      match arm.pattern.kind
      when PatternKind::Literal(expr) then
        match expr.kind
        when ExprKind::ExprStringLit(s_val) then
          let cmp_tmp = add_temp(b, Type::Bool, span)
          push_assign(b, place_local(cmp_tmp), MirRvalue { kind: MirRvalueKind::MirBinOp(
            MirBinOp::Eq, operand_copy_local(scrut_local), operand_constant(constant_string(s_val))
          ) }, span)
          let next_check = create_block(b)
          var st = Vec::new()
          st.push(SwitchTarget { value: 1, target: arm_blocks[i] })
          set_terminator(b, MirTerminatorKind::MirSwitchInt { op: operand_copy_local(cmp_tmp), targets: st, default_target: next_check }, span)
          switch_to_block(b, next_check)
        when _ then ()
        end
      when _ then ()
      end
      i = i + 1
    end
    # After all string checks, fall through to default
    set_terminator(b, MirTerminatorKind::MirGoto(real_default), span)
  else
    # Build switch targets from patterns (non-string)
    var switch_targets = Vec::new()
    for arm in m.arms do
      var is_catchall = false
      let disc_val = match arm.pattern.kind
      when PatternKind::Literal(expr) then
        match expr.kind
        when ExprKind::ExprIntLit(n) then n
        when ExprKind::ExprBoolLit(bool_lit) then if bool_lit then 1 else 0 end
        when ExprKind::ExprCharLit(c) then c as Int
        when _ then i
        end
      when PatternKind::Variant(path, _) then
        resolve_enum_variant_discriminant_or(b, &path, i)
      when PatternKind::Wildcard then
        is_catchall = true
        0
      when PatternKind::Ident(_, _) then
        is_catchall = true
        0
      when _ then i
      end

      if !is_catchall then
        switch_targets.push(SwitchTarget { value: disc_val, target: arm_blocks[i] })
      end
      i = i + 1
    end

    # Emit switch on the appropriate local
    let switch_op = operand_copy_local(switch_local)
    set_terminator(b, MirTerminatorKind::MirSwitchInt { op: switch_op, targets: switch_targets, default_target: real_default }, span)
  end

  i = 0
  for arm in m.arms do
    switch_to_block(b, arm_blocks[i])

    # Payload guard for variant with literal sub-patterns
    match arm.pattern.kind
    when PatternKind::Variant(path, sub_pats) then
      if sub_pats.len() > 0 then
        var has_lit = false
        var lit_val = 0
        match sub_pats[0].kind
        when PatternKind::Literal(lit_expr) then
          has_lit = true
          lit_val = match lit_expr.kind
          when ExprKind::ExprIntLit(n) then n
          when ExprKind::ExprBoolLit(bv) then if bv then 1 else 0 end
          when ExprKind::ExprCharLit(c) then c as Int
          when _ then 0
          end
        when _ then ()
        end
        if has_lit then
          let vn = if path.segments.len() > 0 then
            path.segments[path.segments.len() - 1].clone()
          else "" end
          let vd = resolve_enum_variant_discriminant_or(b, &path, 0)
 # the payload-guard downcast is ALWAYS the typed VariantId
          # (the scrutinee's enum owner TypeId + the variant's
          # declaration-order index); a source arm the typed tables cannot
          # resolve is an internal error (fail-closed). The payload field
          # is Field(FieldId) with the scrutinee enum's TypeId.
          let vproj_path_enum = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2].clone() else "" end
          var vproj = Projection::Variant(VariantId { owner: TypeId { id: -1 }, index: 0 })
          var vproj_enum_tid = TypeId { id: -1 }
          match mir_enum_owner_tid(b, &scrutinee_ty)
          when Option::Some(stid) then
            vproj_enum_tid = stid
            match typed_variant_id(b, &vproj_path_enum, &vn)
            when Option::Some(vid) then
              if vid.owner.id == stid.id then vproj = Projection::Variant(vid)
              else
                b.errors.push("internal error: variant '" + vn.clone() + "' owner does not match the scrutinee's enum TypeId during MIR lowering")
              end
            when Option::None then
              b.errors.push("internal error: missing typed variant identity for payload-guard variant '" + vn.clone() + "' during MIR lowering")
            end
          when Option::None then
            b.errors.push("internal error: missing typed scrutinee enum identity for payload-guard variant '" + vn.clone() + "' during MIR lowering")
          end
          var ppl = place_local(scrut_local)
          ppl.projections.push(vproj)
          ppl.projections.push(Projection::Field(FieldId { owner: TypeId { id: vproj_enum_tid.id }, index: 0 }))
          let pty = mir_place_type(&ppl, b)
          let ptmp = add_temp(b, pty, span)
          push_assign(b, place_local(ptmp), move_rvalue(operand_copy(ppl)), span)
          var ft = real_default
          var k = i + 1
          while k < m.arms.len() do
            match m.arms[k].pattern.kind
            when PatternKind::Variant(p2, _) then
              match resolve_enum_variant_discriminant(b, &p2)
              when Result::Ok(d2) then
                if d2 == vd then
                  ft = arm_blocks[k]
                  k = m.arms.len()
                end
              when Result::Err(e) then
                b.errors.push(e)
              end
            when PatternKind::Wildcard then
              ft = arm_blocks[k]
              k = m.arms.len()
            when PatternKind::Ident(_, _) then
              ft = arm_blocks[k]
              k = m.arms.len()
            when _ then ()
            end
            k = k + 1
          end
          let bdy = create_block(b)
          var pt = Vec::new()
          pt.push(SwitchTarget { value: lit_val, target: bdy })
          set_terminator(b, MirTerminatorKind::MirSwitchInt {
            op: operand_copy_local(ptmp),
            targets: pt,
            default_target: ft
          }, span)
          switch_to_block(b, bdy)
        end
      end
    when _ then ()
    end

    # Bind pattern variables
    bind_match_arm_pattern_locals(b, scrut_local, &arm.pattern, span)

    # Guard check
    match arm.guard_expr
    when Option::Some(guard_expr_val) then
      let guard_val = lower_expr(b, &guard_expr_val, span)
      let guard_pass = create_block(b)
      let guard_fail = if i + 1 < arm_blocks.len() then arm_blocks[i + 1] else join_block end
      var gt = Vec::new()
      gt.push(SwitchTarget { value: 0, target: guard_fail })
      set_terminator(b, MirTerminatorKind::MirSwitchInt { op: guard_val, targets: gt, default_target: guard_pass }, span)
      switch_to_block(b, guard_pass)
    when Option::None then ()
    end

    # Lower arm body and store result to dest
    if arm.body.stmts.len() > 0 then
      # Lower all but last statement
      var si = 0
      while si < arm.body.stmts.len() - 1 do
        lower_stmt(b, &arm.body.stmts[si])
        si = si + 1
      end
      # Last statement: assign its value to dest
      let last_idx = arm.body.stmts.len() - 1
      lower_final_match_arm_stmt_to_place(b, &arm.body.stmts[last_idx], &dest, span)
    end

    if !block_is_terminated(b) then
      set_terminator(b, MirTerminatorKind::MirGoto(join_block), span)
    end

    i = i + 1
  end

  switch_to_block(b, join_block)
end

def lower_final_match_arm_stmt_to_place(inout b: MirBuilder, stmt: Stmt, dest: Place, span: Span) -> Unit
  let last_kind = stmt_kind_name(&stmt.kind)
  if last_kind == "StmtExpr" then
    match stmt.kind
    when StmtKind::StmtExpr(expr) then
      lower_expr_assign_to(b, &expr, duplicate_place(dest), span)
    when _ then ()
    end
  elsif last_kind == "StmtIf" then
    match stmt.kind
    when StmtKind::StmtIf(nested_if) then
      lower_if_to_place(b, &nested_if, duplicate_place(dest), span)
    when _ then ()
    end
  elsif last_kind == "StmtMatch" then
    match stmt.kind
    when StmtKind::StmtMatch(nested_m) then
      lower_match_to_place(b, &nested_m, duplicate_place(dest), span)
    when _ then ()
    end
  else
    lower_stmt(b, stmt)
  end
end

# ———————————————————————————————————————————————————————————————
# MIR Pretty Printer
# ———————————————————————————————————————————————————————————————
#
# Human-readable serialization of the entire MIR.  Used by --emit-mir,
# the REPL :mir command, and diagnostics/debugging output.

def pretty_print_mir(program: MirProgram) -> String
  var out = ""
 # the type-id -> name table for the canonical Named-type display
  # (the builtin compounds render like their canonical variants).
  var names: Map[Int, String] = Map::new()
  for td in program.types do
    names.insert(td.id.id, td.name.clone())
  end
 # the param-name table (numeric GenericParamId -> name) — the
  # pretty printer renders Type::Param names from this snapshot.
  var pnames = program.generic_param_names.clone()

  # Type definitions
  if !program.types.is_empty() then
    out = out + "// Type definitions\n"
    for td in program.types do
      out = out + format_mir_typedef(&names, &pnames, &td) + "\n"
    end
    out = out + "\n"
  end

  # Statics / globals
  if !program.statics.is_empty() then
    out = out + "// Statics\n"
    for s in program.statics do
      let mutability = if s.is_mut then "mut " else "" end
      out = out + "static " + mutability + s.name.clone() + ": " + format_mir_type(&names, &pnames, &s.ty) + ";\n"
    end
    out = out + "\n"
  end

  # Functions
  for func in program.functions do
    out = out + format_mir_function(&names, &pnames, &func) + "\n"
  end
  out
end

def format_mir_typedef(names: Map[Int, String], param_names: Map[Int, String], td: MirTypeDef) -> String
  var out = "type " + td.name.clone()
  match td.kind
  when MirTypeDefKind::Struct(fields) then
    out = out + " = struct {\n"
    for f in fields do
      out = out + "    " + f.name.clone() + ": " + format_mir_type(names, param_names, &f.ty)
      out = out + "\n"
    end
    out = out + "}"
  when MirTypeDefKind::Enum(variants) then
    out = out + " = enum {\n"
    for v in variants do
      out = out + "    " + v.name.clone() + " = " + v.discriminant.to_string()
      if !v.fields.is_empty() then
        out = out + "("
        var first = true
        for f in v.fields do
          if !first then out = out + ", " end
          out = out + format_mir_type(names, param_names, &f)
          first = false
        end
        out = out + ")"
      end
      out = out + "\n"
    end
    out = out + "}"
  end
  out
end

def format_mir_function(names: Map[Int, String], param_names: Map[Int, String], func: MirFunction) -> String
  var out = ""
  # Annotations
  if func.is_unsafe then out = out + "unsafe " end
  if func.is_async then out = out + "async " end
  if func.is_extern then out = out + "extern \"" + func.extern_abi.clone() + "\" " end

  out = out + "fn " + func.name.clone() + "("
  var first = true
  for p in func.params do
    if !first then out = out + ", " end
    let mutmark = if p.is_mut then "mut " else "" end
    out = out + mutmark + p.name.clone() + ": " + format_mir_type(names, &p.ty)
    first = false
  end
  out = out + ") -> " + format_mir_type(names, &func.ret_type) + " {\n"

  # Local declarations
  for local in func.locals do
    let mutmark = if local.is_mut then "mut " else "" end
    out = out + "    let " + mutmark + "_" + local.id.id.to_string()
    if !local.name.is_empty() then
      out = out + " /* " + local.name.clone() + " */"
    end
    out = out + ": " + format_mir_type(names, &local.ty) + ";\n"
  end
  if !func.locals.is_empty() then out = out + "\n" end

  # Contracts
  for c in func.contracts do
    let kind_str = match c.kind
    when MirContractKind::Pre then "pre"
    when MirContractKind::Post then "post"
    when MirContractKind::Invariant then "invariant"
    end
    out = out + "    @" + kind_str + " " + format_operand(names, param_names, &c.condition) + " \"" + c.message.clone() + "\"\n"
  end

  # Basic blocks
  for block in func.blocks do
    out = out + format_mir_block(names, param_names, &block)
  end

  out = out + "}\n"
  out
end

def format_mir_block(names: Map[Int, String], param_names: Map[Int, String], block: MirBlock) -> String
  var out = "    bb" + block.id.id.to_string() + ": {\n"
  for stmt in block.statements do
    out = out + "        " + format_mir_statement(names, param_names, &stmt) + ";\n"
  end
  out = out + "        " + format_mir_terminator(names, param_names, &block.terminator) + ";\n"
  out = out + "    }\n"
  out
end

def format_mir_statement(names: Map[Int, String], param_names: Map[Int, String], stmt: MirStatement) -> String
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    format_place(&place) + " = " + format_rvalue(names, param_names, &rvalue)
  when MirStatementKind::MirStorageLive(id) then
    "StorageLive(_" + id.id.to_string() + ")"
  when MirStatementKind::MirStorageDead(id) then
    "StorageDead(_" + id.id.to_string() + ")"
  when MirStatementKind::MirNop then
    "nop"
  when MirStatementKind::MirContractCheck(contract, op) then
    let kind_str = match contract.kind
    when MirContractKind::Pre then "pre"
    when MirContractKind::Post then "post"
    when MirContractKind::Invariant then "invariant"
    end
    "contract_check(" + kind_str + ", " + format_operand(names, param_names, &op) + ")"
  when MirStatementKind::MirBudgetConsume(resource, amount) then
    "budget_consume(\"" + resource.clone() + "\", " + amount.to_string() + ")"
  when MirStatementKind::MirEffectRecord(name, op) then
    "effect_record(\"" + name.clone() + "\", " + format_operand(names, param_names, &op) + ")"
  end
end

def format_mir_terminator(names: Map[Int, String], param_names: Map[Int, String], term: MirTerminator) -> String
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    "goto -> bb" + target.id.to_string()
  when MirTerminatorKind::MirSwitchInt { op: discr, targets, default_target: otherwise } then
    var out = "switchInt(" + format_operand(names, param_names, &discr) + ") -> ["
    for t in targets do
      out = out + t.value.to_string() + ": bb" + t.target.id.to_string() + ", "
    end
    out = out + "otherwise: bb" + otherwise.id.to_string() + "]"
    out
  when MirTerminatorKind::MirReturn then
    "return"
  when MirTerminatorKind::MirUnreachable then
    "unreachable"
  when MirTerminatorKind::MirCall { dest, func: func_op, args, success: succ, unwind, intrinsic } then
    var out = format_place(&dest) + " = " + format_operand(names, param_names, &func_op) + "("
    var first = true
    for a in args do
      if !first then out = out + ", " end
      let effect_str = match a.effect
      when AccessEffect::Read then "read"
      when AccessEffect::Modify then "modify"
      when AccessEffect::Consume then "consume"
      when AccessEffect::Initialize then "init"
      end
      let value_str = match a.value
      when MirCallValue::Value(op) then format_operand(names, param_names, &op)
      when MirCallValue::Place(p) then format_place(&p)
      end
      out = out + effect_str + ":" + value_str
      first = false
    end
    out = out + ") -> [return: bb" + succ.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    var out = "deinit(" + format_place(&place) + " via inst#" + def_id_numeric(&deinit_fn.def.def).to_string() + ") -> [bb" + target.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    var out = "assert(" + format_operand(names, param_names, &cond) + ", "
    out = out + (if expected then "true" else "false" end) + ", "
    out = out + format_assert_message(names, param_names, &msg) + ") -> [success: bb" + target.id.to_string()
    match unwind
    when Option::Some(ub) then out = out + ", unwind: bb" + ub.id.to_string()
    when Option::None then ()
    end
    out = out + "]"
    out
  when MirTerminatorKind::MirAbort then
    "abort"
  end
end

def format_assert_message(names: Map[Int, String], param_names: Map[Int, String], msg: AssertMessage) -> String
  match msg
  when AssertMessage::BoundsCheck(idx, len) then
    "\"index out of bounds: \" + index=" + format_operand(names, param_names, &idx) + " len=" + format_operand(names, param_names, &len)
  when AssertMessage::Overflow(op) then
    "\"arithmetic overflow: " + format_binop(op) + "\""
  when AssertMessage::DivisionByZero then "\"division by zero\""
  when AssertMessage::RemainderByZero then "\"remainder by zero\""
  when AssertMessage::NullPointer then "\"null pointer dereference\""
  when AssertMessage::ContractViolation(m) then "\"contract violation: " + m.clone() + "\""
  end
end

def format_place(place: Place) -> String
  var out = "_" + place.local.id.to_string()
  for proj in place.projections do
    match proj
    when Projection::ProjDeref then out = "(*" + out + ")"
    when Projection::Field(fid) then out = out + ".field" + fid.index.to_string() + "(owner " + fid.owner.id.to_string() + ")"
    when Projection::Variant(vid) then out = "(" + out + " as variant" + vid.index.to_string() + "(owner " + vid.owner.id.to_string() + "))"
    when Projection::TupleIndex(idx) then out = out + ".[" + idx.to_string() + "]"
    when Projection::ProjIndex(id) then out = out + "[_" + id.id.to_string() + "]"
    when Projection::ProjConstantIndex(i) then out = out + "[" + i.to_string() + "]"
    end
  end
  out
end

def format_operand(names: Map[Int, String], param_names: Map[Int, String], op: MirOperand) -> String
  match op.kind
  when MirOperandKind::MirCopy(place) then "copy " + format_place(&place)
  when MirOperandKind::MirMovePlace(place) then "move " + format_place(&place)
  when MirOperandKind::MirRead(place) then "read " + format_place(&place)
  when MirOperandKind::MirConsume(place) then "consume " + format_place(&place)
  when MirOperandKind::MirConstant(c) then format_mir_constant(names, param_names, &c)
  end
end

def format_mir_constant(names: Map[Int, String], param_names: Map[Int, String], c: MirConstant) -> String
  match c.kind
  when MirConstantKind::MirUnit then "()"
  when MirConstantKind::MirBool(b) then if b then "true" else "false" end
  when MirConstantKind::MirInt(n) then n.to_string() + "_" + format_mir_type(names, param_names, &c.ty)
  when MirConstantKind::MirFloat(f) then f.to_string() + "_" + format_mir_type(names, param_names, &c.ty)
  when MirConstantKind::MirChar(ch) then "'" + ch.to_string() + "'"
  when MirConstantKind::MirString(s) then "\"" + s.clone() + "\""
  when MirConstantKind::MirFnItem(name) then name.clone()
  when MirConstantKind::MirZeroSized then "zero_sized"
  end
end

def format_rvalue(names: Map[Int, String], param_names: Map[Int, String], rv: MirRvalue) -> String
  match rv.kind
  when MirRvalueKind::MirMove(op) then format_operand(names, param_names, &op)
  when MirRvalueKind::MirRef(place) then "&" + format_place(&place)
  when MirRvalueKind::MirAggregate(kind, ops) then
    var out = match kind
    when AggregateKind::MirArray(_) then "["
    when AggregateKind::Tuple then "("
    when AggregateKind::Struct(_, fields) then
      if !fields.is_empty() then fields[0].clone() + " { " else "{ " end
    when AggregateKind::Closure(id) then "closure#" + id.id.to_string() + "("
    when AggregateKind::Generator(id) then "generator#" + id.id.to_string() + "("
    end
    var first = true
    for o in ops do
      if !first then out = out + ", " end
      out = out + format_operand(names, param_names, &o)
      first = false
    end
    out = out + match kind
    when AggregateKind::MirArray(_) then "]"
    when AggregateKind::Tuple then ")"
    when AggregateKind::Struct(_, _) then " }"
    when AggregateKind::Closure(_) then ")"
    when AggregateKind::Generator(_) then ")"
    end
    out
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    format_operand(names, param_names, &lhs) + " " + format_binop(op) + " " + format_operand(names, param_names, &rhs)
  when MirRvalueKind::MirUnOp(op, operand) then
    format_unop(op) + format_operand(names, param_names, &operand)
  when MirRvalueKind::MirDiscriminant(place) then
    "discriminant(" + format_place(&place) + ")"
  when MirRvalueKind::MirLen(place) then
    "len(" + format_place(&place) + ")"
  when MirRvalueKind::MirCast(kind, op, ty) then
    format_operand(names, param_names, &op) + " as " + format_mir_type(names, param_names, &ty) + " (" + format_cast_kind(kind) + ")"
  when MirRvalueKind::MirRepeat(op, count) then
    "[" + format_operand(names, param_names, &op) + "; " + count.to_string() + "]"
  when MirRvalueKind::MirPhi(entries) then
    var out = "phi("
    var first = true
    for entry in entries do
      let bid = entry.0
      let lid = entry.1
      if !first then out = out + ", " end
      out = out + "bb" + bid.id.to_string() + ": _" + lid.id.to_string()
      first = false
    end
    out + ")"
  end
end

def format_binop(op: MirBinOp) -> String
  match op
  when MirBinOp::Add then "+"
  when MirBinOp::Sub then "-"
  when MirBinOp::Mul then "*"
  when MirBinOp::Div then "/"
  when MirBinOp::Mod then "%"
  when MirBinOp::BitAnd then "&"
  when MirBinOp::BitOr then "|"
  when MirBinOp::BitXor then "^"
  when MirBinOp::Shl then "<<"
  when MirBinOp::Shr then ">>"
  when MirBinOp::Eq then "=="
  when MirBinOp::Ne then "!="
  when MirBinOp::Lt then "<"
  when MirBinOp::Le then "<="
  when MirBinOp::Gt then ">"
  when MirBinOp::Ge then ">="
  end
end

def format_unop(op: MirUnOp) -> String
  match op
  when MirUnOp::Neg then "-"
  when MirUnOp::Not then "!"
  when MirUnOp::BitNot then "~"
  end
end

def format_cast_kind(kind: CastKind) -> String
  match kind
  when CastKind::IntToInt then "IntToInt"
  when CastKind::IntToFloat then "IntToFloat"
  when CastKind::FloatToInt then "FloatToInt"
  when CastKind::FloatToFloat then "FloatToFloat"
  when CastKind::Pointer then "Pointer"
  when CastKind::Transmute then "Transmute"
  end
end

# the registered builtin compounds (Option/Result/Box/Rc/Map/Set/
# Slice/Array/Vec) display like their canonical variants — the Adt form
# renders the builtin syntax via the registered name. The name comes from
# the program's type table (type id -> name, built from MirProgram.types /
# the builder's typed_type_names); unknown ids keep the id-based rendering.
# `param_names` is the param-name table (numeric GenericParamId ->
# name) — a Type::Param renders its registered name, never an identity
# comparison.
def format_mir_type(names: Map[Int, String], param_names: Map[Int, String], ty: Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::Never then "!"
  when Type::Error then "<error>"
  when Type::Var(v) then "_T" + v.id.to_string()
  when Type::Param(gpid) then generic_param_name_from(param_names, &gpid)
  when Type::Ptr(inner) then "*" + format_mir_type(names, param_names, inner)
  when Type::PtrMut(inner) then "*mut " + format_mir_type(names, param_names, inner)
  when Type::Dyn(id) then "dyn T" + id.id.to_string()
  when Type::Effect(effects, inner) then
    "effect[" + effects.join(",") + "] " + format_mir_type(names, param_names, inner)
  when Type::RefInternal(inner, mutable) then
    if mutable then "&mut " + format_mir_type(names, param_names, inner) else "&" + format_mir_type(names, param_names, inner) end
  when Type::Tuple(elems) then
    var out = "("
    var first = true
    for e in elems do
      if !first then out = out + ", " end
      out = out + format_mir_type(names, param_names, &e)
      first = false
    end
    out + ")"
  when Type::FixedArray(elem, n) then
    "[" + format_mir_type(names, param_names, &elem) + "; " + n.to_string() + "]"
  when Type::FnPtr(params, ret, _) then
    var out2 = "fnptr("
    var first2 = true
    for p2 in params do
      if !first2 then out2 = out2 + ", " end
      out2 = out2 + format_mir_type(names, param_names, &p2.ty)
      first2 = false
    end
    out2 + ") -> " + format_mir_type(names, param_names, ret)
  when Type::Closure(cid, params, ret, captures, _) then
    "closure<" + cid.id.to_string() + ">(" + format_mir_type(names, param_names, captures) + ") -> " + format_mir_type(names, param_names, ret)
  when Type::Adt(id, args) then
    let nname = match names.get(id.id)
    when Option::Some(n) then mir_bare_type_name(&n)
    when Option::None then ""
    end
    if nname == "Option" && args.len() >= 1 then
      "Option[" + format_mir_type(names, param_names, &args[0]) + "]"
    elsif nname == "Result" && args.len() >= 2 then
      "Result[" + format_mir_type(names, param_names, &args[0]) + ", " + format_mir_type(names, param_names, &args[1]) + "]"
    elsif nname == "Box" && args.len() >= 1 then
      "Box[" + format_mir_type(names, param_names, &args[0]) + "]"
    elsif nname == "Rc" && args.len() >= 1 then
      "Rc[" + format_mir_type(names, param_names, &args[0]) + "]"
    elsif nname == "Map" && args.len() >= 2 then
      "Map[" + format_mir_type(names, param_names, &args[0]) + ", " + format_mir_type(names, param_names, &args[1]) + "]"
    elsif nname == "Set" && args.len() >= 1 then
      "Set[" + format_mir_type(names, param_names, &args[0]) + "]"
    elsif nname == "Slice" && args.len() >= 1 then
      "[" + format_mir_type(names, param_names, &args[0]) + "]"
    elsif (nname == "Array" || nname == "Vec") && args.len() >= 1 then
      # The heap-vector Adt form carries no count (the fixed-array size
      # lives in the distinct Type::FixedArray variant); render as the
      # element container.
      "[" + format_mir_type(names, param_names, &args[0]) + "]"
    else
      var out = "T" + id.id.to_string()
      if !args.is_empty() then
        out = out + "["
        var first = true
        for a in args do
          if !first then out = out + ", " end
          out = out + format_mir_type(names, param_names, &a)
          first = false
        end
        out = out + "]"
      end
      out
    end
  end
end

# ———————————————————————————————————————————————————————————————
# MIR Optimizations
# ———————————————————————————————————————————————————————————————

def optimize_mir(inout program: MirProgram, opt_level: Int) -> Unit
  # At opt_level 0, skip all optimizations (debug builds)
  if opt_level == 0 then return end

  # First pass: inlining (requires full program) — opt_level >= 2
  if opt_level >= 2 then
    inline_functions(program)
  end

  # Second pass: per-function optimizations
  for f in program.functions do
    optimize_function(f, opt_level)
  end

  # Third pass: escape analysis and heap-to-stack promotion — opt_level >= 2
  if opt_level >= 2 then
    for f in program.functions do
      escape_analysis(f)
    end
  end

  # Fourth pass: PGO-guided optimization — opt_level >= 3
  if opt_level >= 3 then
    apply_pgo_optimizations(program)
  end
end

# ———————————————————————————————————————————————————————————————
# Function Inlining
# ———————————————————————————————————————————————————————————————
#
# Inlines small, non-recursive functions at call sites.
# Heuristics:
# - Only inline functions with fewer than INLINE_THRESHOLD statements
# - Don't inline recursive functions
# - Don't inline extern functions
# - Inline #[inline] and #[inline(always)] annotated functions

const INLINE_STMT_THRESHOLD: Int = 30
const INLINE_BLOCK_THRESHOLD: Int = 5

def inline_functions(inout program: MirProgram) -> Unit
  # Build a map of function name -> function for lookup
  var func_map: Map[String, &MirFunction] = Map::new()
  for f in program.functions do
    func_map.insert(f.name.clone(), f)
  end
  
  # Compute call graph to detect recursion
  let call_graph = mir_build_call_graph(program)
  let recursive_fns = find_recursive_functions(&call_graph)
  
  # Identify inlinable functions
  var inlinable: Set[String] = Set::new()
  for f in program.functions do
    if should_inline(f, &recursive_fns) then
      inlinable.insert(f.name.clone())
    end
  end
  
  # Perform inlining (iterate until no more inlining happens)
  var changed = true
  var iterations = 0
  while changed && iterations < 5 do
    changed = false
    iterations = iterations + 1
    
    for caller in program.functions do
      if inline_calls_in_function(&mut caller, &func_map, &inlinable) then
        changed = true
      end
    end
  end
end

struct CallGraph
  # function name -> set of called function names
  calls: Map[String, Set[String]]
end

def mir_build_call_graph(program: MirProgram) -> CallGraph
  var calls: Map[String, Set[String]] = Map::new()
  
  for f in program.functions do
    var callees = Set::new()
    for block in f.blocks do
      match block.terminator.kind
      when MirTerminatorKind::MirCall { dest, func: func_op, args, success, unwind, intrinsic } then
        match func_op.kind
        when MirOperandKind::MirConstant(c) then
          match c.kind
          when MirConstantKind::MirFnItem(callee) then
            callees.insert(callee.clone())
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    calls.insert(f.name.clone(), callees)
  end
  
  CallGraph { calls: calls }
end

def find_recursive_functions(cg: CallGraph) -> Set[String]
  # Find functions that are part of a recursive cycle
  var recursive = Set::new()
  
  for entry in cg.calls do
    let fn_name = entry.0
    if is_reachable_from(cg, fn_name.clone(), fn_name.clone(), Set::new()) then
      recursive.insert(fn_name.clone())
    end
  end
  
  recursive
end

def is_reachable_from(cg: CallGraph, start: String, target: String, visited: Set[String]) -> Bool
  var vis = visited.clone()
  vis.insert(start.clone())
  is_reachable_impl(cg, start, target, &mut vis)
end

def is_reachable_impl(cg: CallGraph, start: String, target: String, inout visited: Set[String]) -> Bool
  match cg.calls.get(start.clone())
  when Option::Some(callees) then
    for callee in callees do
      if callee == target then
        return true
      end
      let callee_name = callee.clone()
      if !visited.contains(&callee_name) then
        visited.insert(callee_name.clone())
        if is_reachable_impl(cg, callee_name, target.clone(), visited) then
          return true
        end
      end
    end
  when Option::None then ()
  end
  false
end

def should_inline(f: MirFunction, recursive_fns: Set[String]) -> Bool
  # Don't inline extern functions
  if f.is_extern then
    return false
  end
  
  # Don't inline recursive functions
  let fn_name = f.name.clone()
  if recursive_fns.contains(&fn_name) then
    return false
  end
  
  # Count statements
  var stmt_count = 0
  for block in f.blocks do
    stmt_count = stmt_count + block.statements.len()
  end
  
  # Inline if small enough
  if stmt_count <= INLINE_STMT_THRESHOLD && f.blocks.len() <= INLINE_BLOCK_THRESHOLD then
    return true
  end
  
  false
end

# Inlining safety guard: never inline a call that passes a place by
# a non-Read AccessEffect. prepare_inline_body lowers a Place argument to an
# immutable MirRef of the callee parameter regardless of the argument's
# effect, so a Consume/Modify/Initialize place would silently become an
# ordinary borrowed/copied parameter inside the inlined body. Skip inlining
# for such calls and fall back to the normal (non-inlined) call. Read-place
# and pure value arguments keep the existing inlining path.
def call_has_non_read_place_arg(args: Vec[MirCallArg]) -> Bool
  for arg in args do
    if arg.effect != AccessEffect::Read then
      match arg.value
      when MirCallValue::Place(_) then
        return true
      when MirCallValue::Value(op) then
        match op.kind
        when MirOperandKind::MirCopy(_) then return true
        when MirOperandKind::MirMovePlace(_) then return true
        when MirOperandKind::MirRead(_) then return true
        when MirOperandKind::MirConsume(_) then return true
        when _ then ()
        end
      end
    end
  end
  false
end

def inline_calls_in_function(inout caller: MirFunction, func_map: Map[String, &MirFunction], 
                              inlinable: Set[String]) -> Bool
  var changed = false
  var new_blocks: Vec[MirBlock] = Vec::new()
  var next_local_id = caller.locals.len()
  var next_block_id = caller.blocks.len()
  
  for block in caller.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest: dest, func: func_op, args: args, success: success_block, unwind: unwind_block, intrinsic: intrinsic } then
      let maybe_callee_name = match func_op.kind
      when MirOperandKind::MirConstant(c) then
        match c.kind
        when MirConstantKind::MirFnItem(name) then Option::Some(name.clone())
        when _ then Option::None
        end
      when _ then Option::None
      end

      match maybe_callee_name
      when Option::Some(callee_name) then
        # Entry decision: only inline when the callee is inlinable AND no
        # argument carries a place by a non-Read effect (see
        # call_has_non_read_place_arg — such calls fall back to a real call).
        if inlinable.contains(&callee_name) && !call_has_non_read_place_arg(args) then
          match func_map.get(callee_name.clone())
        when Option::Some(callee) then
          # Inline this call
          let dest_opt = Option::Some(dest.clone())
          let inline_res = prepare_inline_body(
            callee, next_local_id, next_block_id, args, &dest_opt, Option::Some(success_block)
          )
          let inlined_blocks = inline_res.blocks
          let local_mapping = inline_res.mapping
          let entry_block = inline_res.entry
          next_local_id = next_local_id + callee.locals.len()
          next_block_id = next_block_id + callee.blocks.len()
          
          # Add inlined locals to caller
          for local in callee.locals do
            match local_mapping.get(local.id.id)
            when Option::Some(new_id) then
              caller.locals.push(MirLocal {
                id: MirLocalId { id: new_id },
                name: local.name.clone() + "_inlined",
                ty: local.ty.clone(),
                is_mut: local.is_mut,
                span: local.span.clone()
              })
            when Option::None then ()
            end
          end
          
          # Replace call terminator with goto inlined entry
          let new_term = MirTerminator {
            kind: MirTerminatorKind::MirGoto(entry_block),
            span: block.terminator.span.clone()
          }
          new_blocks.push(MirBlock {
            id: block.id.clone(),
            statements: block.statements.clone(),
            terminator: new_term
          })
          
          # Add inlined blocks (shared iteration is projected: clone).
          for inlined in inlined_blocks do
            new_blocks.push(inlined.clone())
          end
          
          changed = true
        when Option::None then
          new_blocks.push(block.clone())
        end
        else
          new_blocks.push(block.clone())
        end
      when Option::None then
        new_blocks.push(block.clone())
      end
    when _ then
      new_blocks.push(block.clone())
    end
  end
  
  if changed then
    caller.blocks = new_blocks
  end
  
  changed
end

struct InlineResult
  blocks: Vec[MirBlock]
  mapping: Map[Int, Int]
  entry: MirBlockId
end

def prepare_inline_body(callee: MirFunction, start_local_id: Int, start_block_id: Int, args: Vec[MirCallArg], dest: Option[Place], next_block: Option[MirBlockId]) -> InlineResult
  # Create mappings for locals and blocks
  var local_mapping: Map[Int, Int] = Map::new()
  var block_mapping: Map[Int, Int] = Map::new()
  var next_local_id = start_local_id
  var next_block_id = start_block_id
  
  # Map callee locals once. Parameters are already part of callee.locals.
  for local in callee.locals do
    let new_id = next_local_id
    next_local_id = next_local_id + 1
    let _ = local_mapping.insert(local.id.id, new_id)
  end
  
  # Map callee blocks
  for block in callee.blocks do
    let new_id = next_block_id
    next_block_id = next_block_id + 1
    let _ = block_mapping.insert(block.id.id, new_id)
  end
  let entry_block_id = block_mapping.get(callee.entry_block.id).unwrap_or(callee.entry_block.id)
  
  # Clone and remap blocks
  var new_blocks: Vec[MirBlock] = Vec::new()
  
  for block in callee.blocks do
    let block_new_id = block_mapping.get(block.id.id).unwrap_or(block.id.id)
    
    # Remap statements
    var new_stmts: Vec[MirStatement] = Vec::new()
    
    # First, if this is the entry block, add parameter-to-local assignments
    if block.id.id == callee.entry_block.id then
      for i in 0..callee.params.len() do
        if i < args.len() then
          match local_mapping.get(callee.params[i].id.id)
          when Option::Some(new_local) then
            var param_place = place_local(callee.params[i].id.clone())
            param_place.local.id = new_local
            match args[i].value
            when MirCallValue::Place(p) then
              new_stmts.push(MirStatement {
                kind: MirStatementKind::MirAssign(
                  param_place,
                  MirRvalue { kind: MirRvalueKind::MirRef(duplicate_place(p)) }
                ),
                span: callee.span.clone()
              })
            when MirCallValue::Value(_) then
              new_stmts.push(MirStatement {
                kind: MirStatementKind::MirAssign(
                  param_place,
                  move_rvalue(mir_call_arg_operand(&args[i]))
                ),
                span: callee.span.clone()
              })
            end
          when Option::None then ()
          end
        end
      end
    end
    
    for stmt in block.statements do
      new_stmts.push(remap_statement(&stmt, &local_mapping))
    end

    # Preserve the callee return slot by copying it into the original call destination.
    match block.terminator.kind
    when MirTerminatorKind::MirReturn then
      match dest
      when Option::Some(dest_place) then
        let ret_local_id = local_mapping.get(0).unwrap_or(0)
        new_stmts.push(MirStatement {
          kind: MirStatementKind::MirAssign(
            remap_place(&dest_place, &local_mapping),
            MirRvalue {
              kind: MirRvalueKind::MirMove(MirOperand {
                kind: MirOperandKind::MirCopy(place_local(MirLocalId { id: ret_local_id }))
              })
            }
          ),
          span: block.terminator.span.clone()
        })
      when Option::None then ()
      end
    when _ then ()
    end
    
    # Remap terminator
    let new_term = remap_terminator(&block.terminator, &local_mapping, &block_mapping, dest, next_block)
    
    new_blocks.push(MirBlock {
      id: MirBlockId { id: block_new_id },
      statements: new_stmts,
      terminator: new_term
    })
  end
  
  InlineResult { blocks: new_blocks, mapping: local_mapping, entry: MirBlockId { id: entry_block_id } }
end

def remap_statement(stmt: MirStatement, local_map: Map[Int, Int]) -> MirStatement
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::MirAssign(
        remap_place(&place, local_map),
        remap_rvalue(&rvalue, local_map)
      ),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirStorageLive(local_id) then
    let new_id = local_map.get(local_id.id).unwrap_or(local_id.id)
    var remapped_local = local_id.clone()
    remapped_local.id = new_id
    MirStatement {
      kind: MirStatementKind::MirStorageLive(remapped_local),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirStorageDead(local_id) then
    let new_id = local_map.get(local_id.id).unwrap_or(local_id.id)
    var remapped_local = local_id.clone()
    remapped_local.id = new_id
    MirStatement {
      kind: MirStatementKind::MirStorageDead(remapped_local),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirNop then
    MirStatement {
      kind: MirStatementKind::MirNop,
      span: stmt.span.clone()
    }
  when MirStatementKind::MirContractCheck(contract, operand) then
    MirStatement {
      kind: MirStatementKind::MirContractCheck(
        remap_contract(&contract, local_map),
        remap_operand(&operand, local_map)
      ),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirBudgetConsume(resource, amount) then
    MirStatement {
      kind: MirStatementKind::MirBudgetConsume(resource.clone(), amount),
      span: stmt.span.clone()
    }
  when MirStatementKind::MirEffectRecord(name, operand) then
    MirStatement {
      kind: MirStatementKind::MirEffectRecord(name.clone(), remap_operand(&operand, local_map)),
      span: stmt.span.clone()
    }
  end
end

def remap_contract(contract: MirContract, local_map: Map[Int, Int]) -> MirContract
  MirContract {
    kind: contract.kind,
    condition: remap_operand(&contract.condition, local_map),
    message: contract.message.clone(),
    span: contract.span.clone()
  }
end

def remap_place(place: Place, local_map: Map[Int, Int]) -> Place
  let new_local = local_map.get(place.local.id).unwrap_or(place.local.id)
  var remapped = duplicate_place(place)
  remapped.local.id = new_local
  remapped
end

def remap_rvalue(rv: MirRvalue, local_map: Map[Int, Int]) -> MirRvalue
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    MirRvalue { kind: MirRvalueKind::MirMove(remap_operand(&op, local_map)) }
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    MirRvalue { kind: MirRvalueKind::MirBinOp(op.clone(), remap_operand(&lhs, local_map), remap_operand(&rhs, local_map)) }
  when MirRvalueKind::MirUnOp(op, operand) then
    MirRvalue { kind: MirRvalueKind::MirUnOp(op.clone(), remap_operand(&operand, local_map)) }
  when MirRvalueKind::MirRef(place) then
    MirRvalue { kind: MirRvalueKind::MirRef(remap_place(&place, local_map)) }
  when MirRvalueKind::MirAggregate(kind, fields) then
    var remapped = Vec::new()
    for field in fields do
      remapped.push(remap_operand(&field, local_map))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(kind.clone(), remapped) }
  when MirRvalueKind::MirDiscriminant(place) then
    MirRvalue { kind: MirRvalueKind::MirDiscriminant(remap_place(&place, local_map)) }
  when MirRvalueKind::MirLen(place) then
    MirRvalue { kind: MirRvalueKind::MirLen(remap_place(&place, local_map)) }
  when MirRvalueKind::MirCast(kind, op, ty) then
    MirRvalue { kind: MirRvalueKind::MirCast(kind.clone(), remap_operand(&op, local_map), ty.clone()) }
  when MirRvalueKind::MirRepeat(op, count) then
    MirRvalue { kind: MirRvalueKind::MirRepeat(remap_operand(&op, local_map), count) }
  when MirRvalueKind::MirPhi(args) then
    let remapped = Vec::new()
    for arg_entry in args do
      let block = arg_entry.0
      let local = arg_entry.1
      let new_id = local_map.get(local.id).unwrap_or(local.id)
      var remapped_local = local.clone()
      remapped_local.id = new_id
      remapped.push((block, remapped_local))
    end
    MirRvalue { kind: MirRvalueKind::MirPhi(remapped) }
  end
end

def remap_operand(op: MirOperand, local_map: Map[Int, Int]) -> MirOperand
  match op.kind
  when MirOperandKind::MirCopy(place) then
    operand_copy(remap_place(&place, local_map))
  when MirOperandKind::MirMovePlace(place) then
    operand_move_place(remap_place(&place, local_map))
  when MirOperandKind::MirRead(place) then
    operand_read(remap_place(&place, local_map))
  when MirOperandKind::MirConsume(place) then
    operand_consume(remap_place(&place, local_map))
  when MirOperandKind::MirConstant(constant) then
    operand_constant(duplicate_constant(&constant))
  end
end

def remap_call_arg(arg: MirCallArg, local_map: Map[Int, Int]) -> MirCallArg
  MirCallArg {
    effect: arg.effect.clone(),
    value: match arg.value
    when MirCallValue::Value(op) then MirCallValue::Value(remap_operand(&op, local_map))
    when MirCallValue::Place(p) then MirCallValue::Place(remap_place(&p, local_map))
    end
  }
end

def remap_terminator(term: MirTerminator, local_map: Map[Int, Int], block_map: Map[Int, Int],
                     dest: Option[Place], next_block: Option[MirBlockId]) -> MirTerminator
  match term.kind
  when MirTerminatorKind::MirReturn then
    # Replace return with goto next_block (return value is in local 0)
    match next_block
    when Option::Some(nb) then
      MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: nb.id }), span: term.span.clone() }
    when Option::None then
      MirTerminator { kind: MirTerminatorKind::MirReturn, span: term.span.clone() }
    end
  when MirTerminatorKind::MirGoto(target) then
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: new_target }), span: term.span.clone() }
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    let new_fallback = block_map.get(default_target.id).unwrap_or(default_target.id)
    var new_targets = Vec::new()
    for entry in targets do
      let new_bid = block_map.get(entry.target.id).unwrap_or(entry.target.id)
      new_targets.push(SwitchTarget { value: entry.value, target: MirBlockId { id: new_bid } })
    end
    MirTerminator {
      kind: MirTerminatorKind::MirSwitchInt {
        op: remap_operand(&op, local_map),
        targets: new_targets,
        default_target: MirBlockId { id: new_fallback }
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    var remapped_args: Vec[MirCallArg] = Vec::new()
    for arg in args do
      remapped_args.push(remap_call_arg(&arg, local_map))
    end
    let new_succ = block_map.get(success.id).unwrap_or(success.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(MirBlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirCall {
        dest: remap_place(&dest, local_map),
        func: remap_operand(&func, local_map),
        args: remapped_args,
        success: MirBlockId { id: new_succ },
        unwind: new_unwind,
        intrinsic: intrinsic
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(MirBlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirDeinit {
        place: remap_place(&place, local_map),
        deinit_fn: deinit_fn.clone(),
        target: MirBlockId { id: new_target },
        unwind: new_unwind
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    let remapped_msg = match msg
    when AssertMessage::BoundsCheck(index, length) then
      AssertMessage::BoundsCheck(remap_operand(&index, local_map), remap_operand(&length, local_map))
    when AssertMessage::Overflow(binop) then AssertMessage::Overflow(binop)
    when AssertMessage::DivisionByZero then AssertMessage::DivisionByZero
    when AssertMessage::RemainderByZero then AssertMessage::RemainderByZero
    when AssertMessage::NullPointer then AssertMessage::NullPointer
    when AssertMessage::ContractViolation(s) then AssertMessage::ContractViolation(s.clone())
    end
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    let new_unwind = match unwind
    when Option::Some(block_id) then
      let mapped = block_map.get(block_id.id).unwrap_or(block_id.id)
      Option::Some(MirBlockId { id: mapped })
    when Option::None then Option::None
    end
    MirTerminator {
      kind: MirTerminatorKind::MirAssert {
        cond: remap_operand(&cond, local_map),
        expected: expected,
        msg: remapped_msg,
        target: MirBlockId { id: new_target },
        unwind: new_unwind
      },
      span: term.span.clone()
    }
  when MirTerminatorKind::MirUnreachable then
    MirTerminator {
      kind: MirTerminatorKind::MirUnreachable,
      span: term.span.clone()
    }
  when MirTerminatorKind::MirAbort then
    MirTerminator {
      kind: MirTerminatorKind::MirAbort,
      span: term.span.clone()
    }
  end
end

# ———————————————————————————————————————————————————————————————
# strong side-effect model for the optimizer
# ———————————————————————————————————————————————————————————————
#
# The optimizer transformations below (DCE, GVN/CSE, LICM) must never erase
# or duplicate side-effecting operations in REACHABLE code:
#   - MirConsume operands — a consume invalidates the source place;
#   - MirDeinit terminators — destruction must run exactly once;
#   - calls with Modify/Consume/Initialize argument effects (covers
#     capability operations, which are ordinary calls to capability
#     functions, and destructive drain-style defer cleanup);
#   - defer cleanup — materialized as MirDeinit edge-cleanup chains
#     (the MirDeinit rule above);
#   - agentic statements (contract checks, budget consumption, effect
#     recording) — observable state that must not be dropped.
#
# (DCE rule): "do not remove side effects" applies ONLY to
# transformations of REACHABLE code. Truly unreachable code has NO
# observable effects — it cannot execute, so nothing it contains (a call,
# a deinit, a consume) can ever run. Unreachable blocks are removed
# REGARDLESS of their contents (see eliminate_dead_code below); the
# side-effect predicates here exist for the reachable-code passes only.

def rvalue_has_side_effect(rv: MirRvalue) -> Bool
  match rv.kind
  when MirRvalueKind::MirMove(op) then operand_has_consume(&op)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    operand_has_consume(&lhs) || operand_has_consume(&rhs)
  when MirRvalueKind::MirUnOp(_, op) then operand_has_consume(&op)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op in ops do
      if operand_has_consume(&op) then
        return true
      end
    end
    false
  when MirRvalueKind::MirCast(_, op, _) then operand_has_consume(&op)
  when MirRvalueKind::MirRepeat(op, _) then operand_has_consume(&op)
  when _ then false
  end
end

def operand_has_consume(op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirConsume(_) then true
  when _ then false
  end
end

def optimize_function(inout f: MirFunction, opt_level: Int) -> Unit
  # Level 1+: basic optimizations
  # Dead code elimination
  eliminate_dead_code(f)
  
  # Copy propagation — now safe with SSA conversion enabled.
  propagate_copies(f)
  
  # Constant folding
  fold_constants(f)
  
  if opt_level >= 2 then
    # Global Value Numbering — eliminate redundant computations
    global_value_numbering(f)
    
    # Loop-Invariant Code Motion — hoist loop-invariant computations
    loop_invariant_code_motion(f)
    
    # Bounds-check elimination — remove redundant array bounds checks
    eliminate_bounds_checks(f)
  end
  
  # Remove redundant moves
  simplify_moves(f)
  
  # Final dead code elimination after all other passes
  eliminate_dead_code(f)
end

def MAX_COPY_PROPAGATION_ITERATIONS() -> Int = 100

def eliminate_dead_code(inout f: MirFunction) -> Unit
  # Mark reachable blocks from entry
  var reachable: Set[Int] = Set::new()
  var worklist = Vec::new()
  worklist.push(f.entry_block)
  
  while !worklist.is_empty() do
    match worklist.pop()
    when Option::Some(block_id) then
      let block_id_value = block_id.id
      if !reachable.contains(&block_id_value) then
        reachable.insert(block_id_value)
        # Add successors to worklist
        match get_block(f, block_id)
        when Option::Some(block) then
          for succ_id in terminator_successor_ids(&block.terminator) do
            worklist.push(MirBlockId { id: succ_id })
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  
 # (DCE rule): remove EVERY unreachable block, regardless of contents.
  # The reachability set above is computed from the entry block through the
  # terminator successor edges, so a block is unreachable only when no
  # executing path can reach it. Truly unreachable code has no observable
  # effects: it cannot run, so nothing it contains (a MirConsume rvalue, a
  # MirDeinit terminator, a side-effecting call, an agentic statement) can
  # ever execute. "Do not remove side effects" governs transformations of
 # REACHABLE code only (see the model above) — retaining an
  # unreachable block because of its contents is backwards: the block is
  # erased unconditionally.
  var new_blocks = Vec::new()
  # Shared iteration is projected: clone the kept blocks (consuming
  # iteration is not supported yet).
  for block in f.blocks do
    let block_id_value = block.id.id
    if reachable.contains(&block_id_value) then
      new_blocks.push(block.clone())
    end
  end
  f.blocks = new_blocks
end

def propagate_copies(inout f: MirFunction) -> Unit
  # Copy propagation: if we have _x = Copy(_y), replace all uses of _x with _y.
  # Build a substitution map from simple copy assignments, then apply it transitively.
  var copy_map: Map[Int, MirLocalId] = Map::new()  # local_id -> source_local_id
  
  # Collect simple copy assignments: _dst = Use(Copy(_src))
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::MirMove(operand) then
            match operand.kind
            when MirOperandKind::MirCopy(src_place) then
              if src_place.projections.is_empty() then
                copy_map.insert(place.local.id, src_place.local)
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Resolve transitively: if a -> b -> c, then a -> c
  var changed = true
  var iterations = 0
  while changed && iterations < MAX_COPY_PROPAGATION_ITERATIONS() do
    changed = false
    iterations = iterations + 1
    for entry in copy_map.entries() do
      let id = entry.0
      let target = entry.1
      match copy_map.get(target.id)
      when Option::Some(deeper) then
        if deeper.id != target.id then
          copy_map.insert(id, deeper.clone())
          changed = true
        end
      when Option::None then ()
      end
    end
  end

  if changed then
  end
  
  # Apply substitution to all operands
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        substitute_rvalue_copies(&mut rvalue, &copy_map)
      when MirStatementKind::MirContractCheck(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when MirStatementKind::MirEffectRecord(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when _ then ()
      end
    end
    # Also substitute in terminators
    substitute_terminator_copies(&mut block.terminator, &copy_map)
  end
end

def substitute_operand_copies(inout op: MirOperand, map: Map[Int, MirLocalId]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        op.kind = MirOperandKind::MirCopy(new_place)
      when Option::None then ()
      end
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        op.kind = MirOperandKind::MirMovePlace(new_place)
      when Option::None then ()
      end
    end
  when MirOperandKind::MirRead(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        op.kind = MirOperandKind::MirRead(new_place)
      when Option::None then ()
      end
    end
  when MirOperandKind::MirConsume(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        op.kind = MirOperandKind::MirConsume(new_place)
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def substitute_rvalue_copies(inout rv: MirRvalue, map: Map[Int, MirLocalId]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    substitute_operand_copies(&mut lhs, map)
    substitute_operand_copies(&mut rhs, map)
  when MirRvalueKind::MirUnOp(_, op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirAggregate(_, ops) then
    for o in ops do
      substitute_operand_copies(&mut o, map)
    end
  when MirRvalueKind::MirCast(_, op, _) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirRepeat(op, _) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::MirRef(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        rv.kind = MirRvalueKind::MirRef(new_place)
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirDiscriminant(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        rv.kind = MirRvalueKind::MirDiscriminant(new_place)
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirLen(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        var new_place = duplicate_place(&place)
        new_place.local = new_local
        rv.kind = MirRvalueKind::MirLen(new_place)
      when Option::None then ()
      end
    end
  when MirRvalueKind::MirPhi(_) then ()  # Phi nodes reference block args, not copy targets
  when _ then ()
  end
end

def substitute_terminator_copies(inout term: MirTerminator, map: Map[Int, MirLocalId]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op: var discr, targets, default_target } then
    substitute_operand_copies(&mut discr, map)
  when MirTerminatorKind::MirCall { dest, func: var callee, args: var args_val, success, unwind, intrinsic } then
    substitute_operand_copies(&mut callee, map)
    for arg_inner in args_val do
      match arg_inner.value
      when MirCallValue::Value(op) then substitute_operand_copies(&mut op, map)
      when MirCallValue::Place(_) then ()
      end
    end
  when MirTerminatorKind::MirAssert { cond: var op, expected, msg, target, unwind } then
    substitute_operand_copies(&mut op, map)
  when _ then ()
  end
end

def fold_constants(inout f: MirFunction) -> Unit
  # Evaluate binary/unary operations on known integer/bool constants at compile time.
  # Also folds simple branch conditions when the discriminant is constant.
  var changed = true
  var iterations = 0
  while changed && iterations < 10 do
    changed = false
    iterations = iterations + 1
    
    for block in f.blocks do
      var new_stmts = Vec::new()
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          match try_fold_rvalue(&rvalue)
          when Option::Some(folded) then
            new_stmts.push(MirStatement {
              kind: MirStatementKind::MirAssign(place, folded),
              span: stmt.span
            })
            changed = true
          when Option::None then
            new_stmts.push(stmt.clone())
          end
        when _ then new_stmts.push(stmt.clone())
        end
      end
      block.statements = new_stmts
    end
  end
end

def try_fold_rvalue(rv: MirRvalue) -> Option[MirRvalue]
  match rv.kind
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    try_fold_binop(op, &lhs, &rhs)
  when MirRvalueKind::MirUnOp(op, operand) then
    try_fold_unop(op, &operand)
  when _ then Option::None
  end
end

def try_fold_binop(op: MirBinOp, lhs: MirOperand, rhs: MirOperand) -> Option[MirRvalue]
  # Only fold if both operands are integer constants
  let l = extract_int_constant(lhs)
  let r = extract_int_constant(rhs)
  match l
  when Option::Some(lv) then
    match r
    when Option::Some(rv) then
      let result = match op
      when MirBinOp::Add then Option::Some(lv + rv)
      when MirBinOp::Sub then Option::Some(lv - rv)
      when MirBinOp::Mul then Option::Some(lv * rv)
      when MirBinOp::Div then
        if rv != 0 then Option::Some(lv / rv) else return Option::None end
      when MirBinOp::Mod then
        if rv != 0 then Option::Some(lv % rv) else return Option::None end
      when MirBinOp::BitAnd then Option::Some(lv & rv)
      when MirBinOp::BitOr then Option::Some(lv | rv)
      when MirBinOp::BitXor then Option::Some(lv ^ rv)
      when MirBinOp::Shl then Option::Some(lv << rv)
      when MirBinOp::Shr then Option::Some(lv >> rv)
      when _ then Option::None
      end
      match result
      when Option::Some(val) then
        Option::Some(MirRvalue {
          kind: MirRvalueKind::MirMove(MirOperand {
            kind: MirOperandKind::MirConstant(MirConstant {
              kind: MirConstantKind::MirInt(val),
              ty: Type::Int,
              instance: Option::None
            })
          })
        })
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when Option::None then
    # Try boolean constant folding for comparison operators.
    let lb = extract_bool_constant(lhs)
    let rb = extract_bool_constant(rhs)
    match lb
    when Option::Some(lbv) then
      match rb
      when Option::Some(rbv) then
        let result = match op
        when MirBinOp::Eq then Option::Some(lbv == rbv)
        when MirBinOp::Ne then Option::Some(lbv != rbv)
        when _ then Option::None
        end
        match result
        when Option::Some(val) then
          Option::Some(MirRvalue {
            kind: MirRvalueKind::MirMove(MirOperand {
              kind: MirOperandKind::MirConstant(MirConstant {
                kind: MirConstantKind::MirBool(val),
                ty: Type::Bool,
                instance: Option::None
              })
            })
          })
        when Option::None then Option::None
        end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  end
end

def try_fold_unop(op: MirUnOp, operand: MirOperand) -> Option[MirRvalue]
  match op
  when MirUnOp::Neg then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(0 - val),
            ty: Type::Int,
            instance: Option::None
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::Not then
    match extract_bool_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirBool(!val),
            ty: Type::Bool,
            instance: Option::None
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::BitNot then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::MirMove(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(~val),
            ty: Type::Int,
            instance: Option::None
          })
        })
      })
    when Option::None then Option::None
    end
  end
end

def extract_int_constant(op: MirOperand) -> Option[Int]
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirInt(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

def extract_bool_constant(op: MirOperand) -> Option[Bool]
  match op.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirBool(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Bounds-Check Elimination
# ———————————————————————————————————————————————————————————————
#
# Removes redundant bounds checks when we can prove the index is within bounds.
# This optimization uses value range analysis to track known bounds on variables.
#
# Cases handled:
# 1. Index is a constant within 0..len (when len is known)
# 2. Index was already checked earlier (dominates current check)
# 3. Loop induction variable with known range
# 4. Index derived from len (e.g., len-1 is always valid if len > 0)

struct ValueRange
  min: Option[Int]  # Known lower bound (inclusive)
  max: Option[Int]  # Known upper bound (inclusive)
end

def eliminate_bounds_checks(inout f: MirFunction) -> Unit
  # Track known ranges for each local
  var ranges: Map[Int, ValueRange] = Map::new()
  
  # Track proven assertions (block_id, local_id) -> proven valid
  var proven_checks: Set[(Int, Int, String)] = Set::new()  # (block_id, local_id, array_local_id)
  
  # Iterate through blocks in dominator order
  let dom_info = compute_dominators(f)
  let rpo = compute_reverse_postorder(f)
  
  # Initialize ranges for constants we can extract
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match extract_int_constant_from_rvalue(&rvalue)
          when Option::Some(val) then
            ranges.insert(place.local.id, ValueRange {
              min: Option::Some(val),
              max: Option::Some(val)
            })
          when Option::None then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Now eliminate redundant bounds checks
  for block in f.blocks do
    var new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match extract_int_constant_from_rvalue(&rvalue)
          when Option::Some(val) then
            ranges.insert(place.local.id, ValueRange {
              min: Option::Some(val),
              max: Option::Some(val)
            })
          when Option::None then
            ranges.remove(place.local.id)
          end
        end
        new_stmts.push(stmt.clone())
      when _ then
        new_stmts.push(stmt.clone())
      end
    end
    
    # Check terminator for bounds assertions
    match block.terminator.kind
    when MirTerminatorKind::MirAssert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # Extract local IDs from operands
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match index_local
        when Option::Some(idx_lid) then
          match len_local
          when Option::Some(len_lid) then
            # Check if we can prove this bounds check
            if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
              # Replace assertion with unconditional goto to success
              block.terminator = MirTerminator {
                kind: MirTerminatorKind::MirGoto(success),
                span: block.terminator.span.clone()
              }
            else
              # Record this check as proven for dominated blocks
              let _ = proven_checks.insert((block.id.id, idx_lid.id, len_lid.id.to_string()))
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      when _ then ()
      end
    when _ then ()
    end
    
    block.statements = new_stmts
  end
  
  # Range propagation for loop induction variables
  propagate_loop_ranges(f, &mut ranges)
  
  # Second pass with better range information
  for block in f.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirAssert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match index_local
        when Option::Some(idx_lid) then
          match len_local
          when Option::Some(len_lid) then
            if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
              block.terminator = MirTerminator {
                kind: MirTerminatorKind::MirGoto(success),
                span: block.terminator.span.clone()
              }
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  end
end

def extract_local_from_operand(op: MirOperand) -> Option[MirLocalId]
  match op.kind
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

def extract_int_constant_from_rvalue(rv: MirRvalue) -> Option[Int]
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    extract_int_constant(&op)
  when _ then Option::None
  end
end

def can_prove_bounds_check(index_local: MirLocalId, len_local: MirLocalId, ranges: Map[Int, ValueRange],
                            block_id: MirBlockId, proven: Set[(Int, Int, String)]) -> Bool
  # Check 1: Index is a constant in [0, len)
  match ranges.get(index_local.id)
  when Option::Some(idx_range) then
    match idx_range.min
    when Option::Some(min_val) then
      match idx_range.max
      when Option::Some(max_val) then
        if min_val >= 0 then
          match ranges.get(len_local.id)
          when Option::Some(len_range) then
            match len_range.min
            when Option::Some(min_len) then
              if max_val < min_len then
                return true
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  
  # Check 2: Already proven in a dominating block
  # (Simplified: check if same index/len pair was checked in an earlier block)
  let proven_key = (block_id.id, index_local.id, len_local.id.to_string())
  if proven.contains(&proven_key) then
    return true
  end
  
  false
end

def propagate_loop_ranges(f: MirFunction, inout ranges: Map[Int, ValueRange]) -> Unit
  # Find loop induction variables and compute their ranges
  let loops = find_natural_loops(f)
  
  for loop_info in loops do
    # Find induction variable patterns:
    # 1. i starts at 0 (or known value)
    # 2. i increments by constant each iteration
    # 3. Loop condition is i < len
    
    # Look for typical induction patterns in loop blocks
    for block_id in loop_info.blocks do
      match get_block(f, MirBlockId { id: block_id })
      when Option::Some(block) then
        for stmt in block.statements do
          match stmt.kind
          when MirStatementKind::MirAssign(place, rvalue) then
            # Pattern: i = i + 1
            match rvalue.kind
            when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
              match lhs.kind
              when MirOperandKind::MirCopy(src_place) then
                match extract_int_constant(&rhs)
                when Option::Some(step) then
                  if src_place.local.id == place.local.id && place.projections.is_empty() then
                    # Found an induction variable
                    let start = match ranges.get(place.local.id)
                    when Option::Some(range) then
                      match range.min
                      when Option::Some(min_val) then min_val
                      when Option::None then 0
                      end
                    when Option::None then 0
                    end
                    if step > 0 then
                      let _ = ranges.insert(place.local.id, ValueRange {
                        min: Option::Some(start),
                        max: Option::None  # Unknown upper bound without more analysis
                      })
                    end
                  end
                when Option::None then ()
                end
              when _ then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
        
        # Check loop exit condition
        match block.terminator.kind
        when MirTerminatorKind::MirSwitchInt { op: cond_op, targets, default_target } then
          # If we have i < len as condition, we know i is bounded
          match cond_op.kind
          when MirOperandKind::MirCopy(p) then
            # Track that this variable is bounded by the loop
            if !p.projections.is_empty() then
              ()  # Skip complex projections
            end
          when _ then ()
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
  end
end

def simplify_moves(inout f: MirFunction) -> Unit
  # Remove redundant moves: _x = Move(_x) or _x = Copy(_x) where src == dst.
  # Also remove chains like: _tmp = Move(_x); _y = Move(_tmp) → _y = Move(_x)
  # when _tmp has no other uses.
  
  # Pass 1: Remove self-assignments
  for block in f.blocks do
    var new_stmts = Vec::new()
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if is_self_assignment(&place, &rvalue) then
          # Skip this statement — it's a no-op
          ()
        else
          new_stmts.push(stmt.clone())
        end
      when _ then new_stmts.push(stmt.clone())
      end
    end
    block.statements = new_stmts
  end
  
  # Pass 2: Count uses of each local
  var use_count: Map[Int, Int] = Map::new()
  for local in f.locals do
    use_count.insert(local.id.id, 0)
  end
  for block in f.blocks do
    for stmt in block.statements do
      count_operand_uses(&stmt, &mut use_count)
    end
    count_terminator_uses(&block.terminator, &mut use_count)
  end
  
  # Pass 3: Eliminate single-use temporaries
  # If _tmp = Move(_x) and _y = Move(_tmp) and _tmp used only once, 
  # rewrite to _y = Move(_x)
  var temp_source: Map[Int, Place] = Map::new()
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::MirMove(op) then
            match op.kind
            when MirOperandKind::MirMovePlace(src) then
              match use_count.get(place.local.id)
              when Option::Some(count) then
                if count <= 1 then
                  temp_source.insert(place.local.id, src)
                end
              when Option::None then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Apply temp_source substitution
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rvalue) then
        substitute_temp_moves(&mut rvalue, &temp_source)
      when _ then ()
      end
    end
    substitute_temp_moves_terminator(&mut block.terminator, &temp_source)
  end
end

# ———————————————————————————————————————————————————————————————
# Global Value Numbering (GVN)
# ———————————————————————————————————————————————————————————————
#
# Eliminates redundant computations by assigning a "value number" to each
# expression. If two expressions produce the same value number, the second
# one is replaced with a copy of the first result.
#
# Value number key = (operation, operand_value_numbers...)
# E.g., Add(VN(3), VN(5)) has a unique key; if we see it again, we reuse
# the result instead of recomputing.

def global_value_numbering(inout f: MirFunction) -> Unit
  # Map: rvalue_key -> MirLocalId that already holds this value
  var value_table: Map[String, MirLocalId] = Map::new()
  
  # Map: MirLocalId.id -> canonical value number (string)
  var local_vn: Map[Int, String] = Map::new()
  var vn_counter = 0
  var unique_counter = 0
  
  # Assign initial value numbers to parameters (each is unique)
  for p in f.params do
    let vn = "p" + vn_counter.to_string()
    vn_counter = vn_counter + 1
    local_vn.insert(p.id.id, vn)
  end
  
  for block in f.blocks do
    var new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
 # never CSE a side-effecting rvalue. A consume invalidates
        # its source, so deduplicating such a statement (or serving as a
        # dedup target for a later one) would erase or duplicate the
        # invalidation. Side-effecting statements are kept in place and
        # are never recorded in the value table.
        if place.projections.is_empty() && !rvalue_has_side_effect(&rvalue) then
          # Compute the value number key for this rvalue
          var rv_key = rvalue_to_vn_key(&rvalue, &local_vn)
          if rv_key == "__unique__" then
            rv_key = "__unique__" + unique_counter.to_string()
            unique_counter = unique_counter + 1
          end
          
          match value_table.get(rv_key.clone())
          when Option::Some(existing_local) then
            # Redundant computation — replace with copy
            let copy_rvalue = MirRvalue {
              kind: MirRvalueKind::MirMove(MirOperand {
                kind: MirOperandKind::MirCopy(place_local(existing_local.clone()))
              })
            }
            new_stmts.push(MirStatement {
              kind: MirStatementKind::MirAssign(place.clone(), copy_rvalue),
              span: stmt.span
            })
            # Inherit the value number
            match local_vn.get(existing_local.id) 
            when Option::Some(vn) then local_vn.insert(place.local.id, vn.clone())
            when Option::None then ()
            end
          when Option::None then
            # New computation — record it
            value_table.insert(rv_key.clone(), place.local.clone())
            local_vn.insert(place.local.id, rv_key)
            new_stmts.push(stmt.clone())
          end
        else
          new_stmts.push(stmt.clone())
        end
      when _ then new_stmts.push(stmt.clone())
      end
    end
    
    block.statements = new_stmts
  end
end

def rvalue_to_vn_key(rv: MirRvalue, local_vn: Map[Int, String]) -> String
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    "use(" + operand_to_vn(&op, local_vn) + ")"
  when MirRvalueKind::MirBinOp(op, lhs, rhs) then
    let op_str = match op
    when MirBinOp::Add then "add"
    when MirBinOp::Sub then "sub"
    when MirBinOp::Mul then "mul"
    when MirBinOp::Div then "div"
    when MirBinOp::Mod then "mod"
    when MirBinOp::Eq then "eq"
    when MirBinOp::Ne then "ne"
    when MirBinOp::Lt then "lt"
    when MirBinOp::Le then "le"
    when MirBinOp::Gt then "gt"
    when MirBinOp::Ge then "ge"
    when MirBinOp::BitAnd then "band"
    when MirBinOp::BitOr then "bor"
    when MirBinOp::BitXor then "bxor"
    when MirBinOp::Shl then "shl"
    when MirBinOp::Shr then "shr"
    when _ then "?"
    end
    op_str + "(" + operand_to_vn(&lhs, local_vn) + "," + operand_to_vn(&rhs, local_vn) + ")"
  when MirRvalueKind::MirUnOp(op, inner) then
    let op_str = match op
    when MirUnOp::Neg then "neg"
    when MirUnOp::Not then "not"
    when MirUnOp::BitNot then "bnot"
    end
    op_str + "(" + operand_to_vn(&inner, local_vn) + ")"
  when MirRvalueKind::MirCast(kind, op, ty) then
    "cast(" + operand_to_vn(&op, local_vn) + ")"
  when _ then
    # Aggregates, refs, etc. — caller must stamp this with a monotonic id.
    "__unique__"
  end
end

def operand_to_vn(op: MirOperand, local_vn: Map[Int, String]) -> String
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirInt(n) then "i" + n.to_string()
    when MirConstantKind::MirFloat(f) then "f" + f.to_string()
    when MirConstantKind::MirBool(b) then if b then "true" else "false" end
    when MirConstantKind::MirString(s) then "s\"" + s + "\""
    when MirConstantKind::MirUnit then "unit"
    when MirConstantKind::MirFnItem(name) then "fn:" + name
    when MirConstantKind::MirChar(c) then "c'" + c.to_string() + "'"
    when MirConstantKind::MirZeroSized then "zst"
    end
  when MirOperandKind::MirCopy(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  when MirOperandKind::MirRead(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  when MirOperandKind::MirConsume(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Loop-Invariant Code Motion (LICM)
# ———————————————————————————————————————————————————————————————
#
# Identifies computations inside loops that produce the same result in
# every iteration and hoists them to the loop preheader.
#
# A statement is loop-invariant if:
#   - All its operands are defined outside the loop, OR
#   - All its operands are themselves loop-invariant

def loop_invariant_code_motion(inout f: MirFunction) -> Unit
  # Step 1: Detect natural loops using back edges
  let loops = find_natural_loops(f)
  
  # Step 2: For each loop, find invariant statements and hoist them
  for loop_info in loops do
    hoist_loop_invariants(f, &loop_info)
  end
end

struct NaturalLoop
  header: MirBlockId
  blocks: Vec[Int]     # Block IDs that form the loop body
  preheader: Option[MirBlockId]
end

struct LoopDfsFrame
  frame_block: MirBlockId
  frame_entering: Bool
end

struct LoopBackEdge
  edge_tail: MirBlockId
  edge_header: MirBlockId
end

def loop_contains_block(loop_info: NaturalLoop, block_id: Int) -> Bool
  for existing_id in loop_info.blocks do
    if existing_id == block_id then
      return true
    end
  end

  false
end

def find_natural_loops(f: MirFunction) -> Vec[NaturalLoop]
  # Find back edges and compute the natural loop for each.
  # A back edge is an edge n -> h where h is an ancestor on the current DFS path.
  # We need to distinguish between "on stack" (current path) and "fully processed".
  
  var loops = Vec::new()

  var predecessors: Map[Int, Vec[Int]] = Map::new()
  for block in f.blocks do
    predecessors.insert(block.id.id, Vec::new())
  end
  for block in f.blocks do
    let pred_id = block.id.id
    for succ_id in terminator_successor_ids(&block.terminator) do
      match predecessors.get(succ_id)
      when Option::Some(preds) then
        var new_preds = preds
        new_preds.push(pred_id)
        predecessors.insert(succ_id, new_preds)
      when Option::None then
        predecessors.insert(succ_id, Vec::from([pred_id]))
      end
    end
  end
  
  # Use two sets: visited (all seen nodes) and on_stack (current DFS path)
  var visited: Set[Int] = Set::new()
  var on_stack: Set[Int] = Set::new()
  var stack: Vec[LoopDfsFrame] = Vec::new()
  
  # DFS with explicit stack - push (block_id, is_entering)
  # is_entering=true: first visit, is_entering=false: backtrack (remove from on_stack)
  stack.push(LoopDfsFrame { frame_block: f.entry_block, frame_entering: true })
  
  var back_edges: Vec[LoopBackEdge] = Vec::new()
  
  while !stack.is_empty() do
    match stack.pop()
    when Option::Some(frame) then
      let block_id = frame.frame_block
      let block_id_value = block_id.id
      if frame.frame_entering then
        if visited.contains(&block_id_value) then
          # Already fully processed, skip
          ()
        else
          visited.insert(block_id_value)
          on_stack.insert(block_id_value)
          
          # Push backtrack marker first (will be popped after all successors)
          stack.push(LoopDfsFrame { frame_block: block_id, frame_entering: false })
          
          match get_block(f, block_id)
          when Option::Some(block) then
            for succ_id in terminator_successor_ids(&block.terminator) do
              if on_stack.contains(&succ_id) then
                # Back edge: edge to an ancestor on current path
                back_edges.push(LoopBackEdge { edge_tail: block_id, edge_header: MirBlockId { id: succ_id } })
              elsif !visited.contains(&succ_id) then
                # Tree edge: visit successor
                stack.push(LoopDfsFrame { frame_block: MirBlockId { id: succ_id }, frame_entering: true })
              end
              # else: cross edge to already-processed node, not a back edge
            end
          when Option::None then ()
          end
        end
      else
        # Backtracking: remove from on_stack
        on_stack.remove(&block_id_value)
      end
    when Option::None then ()
    end
  end
  
  # For each back edge, compute the natural loop
  for edge in back_edges do
    let tail = edge.edge_tail
    let header = edge.edge_header
    var loop_blocks: Set[Int] = Set::new()
    loop_blocks.insert(header.id)
    
    # Flood backwards from tail to header to find loop body
    if tail.id != header.id then
      var worklist = Vec::new()
      worklist.push(tail)
      loop_blocks.insert(tail.id)
      
      while !worklist.is_empty() do
        match worklist.pop()
        when Option::Some(n) then
          match predecessors.get(n.id)
          when Option::Some(preds) then
            for pred_id_ref in preds do
              let pred_id = pred_id_ref
              if !loop_blocks.contains(&pred_id) then
                loop_blocks.insert(pred_id)
                worklist.push(MirBlockId { id: pred_id })
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    end
    
    var loop_block_list = Vec::new()
    for block_id in loop_blocks do
      loop_block_list.push(block_id)
    end

    loops.push(NaturalLoop {
      header: header,
      blocks: loop_block_list,
      preheader: Option::None   # Will be created if needed
    })
  end
  
  loops
end

def hoist_loop_invariants(inout f: MirFunction, loop_info: NaturalLoop) -> Unit
  # Find definitions inside the loop
  var loop_defs: Set[Int] = Set::new()
  for block in f.blocks do
    if loop_contains_block(loop_info, block.id.id) then
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, _) then
          loop_defs.insert(place.local.id)
        when _ then ()
        end
      end
    end
  end
  
  # Find loop-invariant statements:
  # An assignment is invariant if all its operand locals are defined outside the loop
  var invariant_stmts: Vec[MirStatement] = Vec::new()
  
  for block in f.blocks do
    if loop_contains_block(loop_info, block.id.id) && block.id.id != loop_info.header.id then
      var remaining_stmts = Vec::new()
      for stmt in block.statements do
        if is_loop_invariant_stmt(&stmt, &loop_defs) then
          invariant_stmts.push(stmt.clone())
        else
          remaining_stmts.push(stmt.clone())
        end
      end
      block.statements = remaining_stmts
    end
  end
  
  # If we found invariant statements, insert them into a preheader block
  # The preheader executes once before the loop, not on every iteration
  if !invariant_stmts.is_empty() then
    var outside_preds: Vec[MirBlockId] = Vec::new()
    for pred_block in f.blocks do
      if loop_contains_block(loop_info, pred_block.id.id) then
        continue
      end
      let header_id = loop_info.header.id
      for succ_id in terminator_successor_ids(&pred_block.terminator) do
        if succ_id == header_id then
          outside_preds.push(pred_block.id.clone())
          break
        end
      end
    end

    let preheader_id = if outside_preds.len() == 1 then
      outside_preds[0].clone()
    else
      let ph_id = MirBlockId { id: f.blocks.len() as Int }
      let ph_span = match get_block(f, loop_info.header)
      when Option::Some(header_block) then header_block.terminator.span
      when Option::None then span_dummy()
      end

      f.blocks.push(MirBlock {
        id: ph_id.clone(),
        statements: Vec::new(),
        terminator: MirTerminator {
          kind: MirTerminatorKind::MirGoto(loop_info.header),
          span: ph_span
        }
      })

      for pred_id in outside_preds do
        match get_block_index(f, pred_id)
        when Option::Some(pred_idx) then
          redirect_terminator_edge(&mut f.blocks[pred_idx].terminator, loop_info.header.id, ph_id.id)
        when Option::None then ()
        end
      end

      if f.entry_block.id == loop_info.header.id then
        f.entry_block = ph_id.clone()
      end

      ph_id
    end

    match get_block_index(f, preheader_id)
    when Option::Some(preheader_idx) then
      # Shared iteration is projected: clone the hoisted invariants
      # (consuming iteration is not supported yet).
      for inv_stmt in invariant_stmts do
        f.blocks[preheader_idx].statements.push(inv_stmt.clone())
      end
    when Option::None then ()
    end
  end
end

def redirect_terminator_edge(inout term: MirTerminator, from_id: Int, to_id: Int) -> Unit
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    if target.id == from_id then
      term.kind = MirTerminatorKind::MirGoto(MirBlockId { id: to_id })
    end
  when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
    var new_targets = Vec::new()
    for t in targets do
      if t.target.id == from_id then
        new_targets.push(SwitchTarget { value: t.value, target: MirBlockId { id: to_id } })
      else
        new_targets.push(t)
      end
    end
    let new_fallback = if default_target.id == from_id then MirBlockId { id: to_id } else default_target end
    term.kind = MirTerminatorKind::MirSwitchInt { op: op, targets: new_targets, default_target: new_fallback }
  when _ then ()
  end
end

def is_loop_invariant_stmt(stmt: MirStatement, loop_defs: Set[Int]) -> Bool
  match stmt.kind
  when MirStatementKind::MirAssign(_, rvalue) then
 # never hoist a side-effecting rvalue out of a loop. A consume
    # must run once per iteration; hoisting it to the preheader would
    # erase the per-iteration invalidation.
    !rvalue_has_side_effect(&rvalue) && is_loop_invariant_rvalue(&rvalue, loop_defs)
  when _ then false
  end
end

def is_loop_invariant_rvalue(rv: MirRvalue, loop_defs: Set[Int]) -> Bool
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    is_loop_invariant_operand(&lhs, loop_defs) &&
    is_loop_invariant_operand(&rhs, loop_defs)
  when MirRvalueKind::MirUnOp(_, op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::MirCast(_, op, _) then
    is_loop_invariant_operand(&op, loop_defs)
  when _ then false  # Aggregates, refs — don't move
  end
end

def is_loop_invariant_operand(op: MirOperand, loop_defs: Set[Int]) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(_) then true  # Constants are always invariant
  when MirOperandKind::MirCopy(place) then
    let local_id = place.local.id
    !loop_defs.contains(&local_id)  # Not defined inside loop
  when MirOperandKind::MirMovePlace(place) then
    let local_id = place.local.id
    !loop_defs.contains(&local_id)
  when MirOperandKind::MirRead(place) then
    let local_id = place.local.id
    !loop_defs.contains(&local_id)
  when MirOperandKind::MirConsume(place) then
    let local_id = place.local.id
    !loop_defs.contains(&local_id)
  end
end

def get_block_index(f: MirFunction, id: MirBlockId) -> Option[Int]
  for idx in 0..f.blocks.len() do
    if f.blocks[idx].id.id == id.id then
      return Option::Some(idx)
    end
  end
  Option::None
end

def is_self_assignment(place: Place, rvalue: MirRvalue) -> Bool
  if !place.projections.is_empty() then
    return false
  end
  match rvalue.kind
  when MirRvalueKind::MirMove(op) then
    match op.kind
    when MirOperandKind::MirCopy(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when MirOperandKind::MirMovePlace(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when _ then false
    end
  when _ then false
  end
end

def count_operand_uses(stmt: MirStatement, inout counts: Map[Int, Int]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(_, rvalue) then
    count_rvalue_uses(&rvalue, counts)
  when MirStatementKind::MirContractCheck(_, op) then
    count_op_uses(&op, counts)
  when MirStatementKind::MirEffectRecord(_, op) then
    count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_op_uses(op: MirOperand, inout counts: Map[Int, Int]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when MirOperandKind::MirMovePlace(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when MirOperandKind::MirRead(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when MirOperandKind::MirConsume(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when _ then ()
  end
end

def count_call_arg_op_uses(arg: MirCallArg, inout counts: Map[Int, Int]) -> Unit
  match arg.value
  when MirCallValue::Value(op) then count_op_uses(&op, counts)
  when MirCallValue::Place(_) then ()
  end
end

def count_rvalue_uses(rv: MirRvalue, inout counts: Map[Int, Int]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then count_op_uses(&op, counts)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    count_op_uses(&lhs, counts)
    count_op_uses(&rhs, counts)
  when MirRvalueKind::MirUnOp(_, op) then count_op_uses(&op, counts)
  when MirRvalueKind::MirAggregate(_, ops) then
    for o in ops do
      count_op_uses(&o, counts)
    end
  when MirRvalueKind::MirCast(_, op, _) then count_op_uses(&op, counts)
  when MirRvalueKind::MirRepeat(op, _) then count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_terminator_uses(term: MirTerminator, inout counts: Map[Int, Int]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then count_op_uses(&op, counts)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    count_op_uses(&func, counts)
    for a in args do
      count_call_arg_op_uses(&a, counts)
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then count_op_uses(&cond, counts)
  when MirTerminatorKind::MirGoto(_) then ()
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirAbort then ()
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then ()
  end
end

def substitute_temp_moves(inout rv: MirRvalue, map: Map[Int, Place]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    substitute_move_operand(&mut lhs, map)
    substitute_move_operand(&mut rhs, map)
  when MirRvalueKind::MirUnOp(_, op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::MirAggregate(_, ops) then
    var oi = 0
    while oi < ops.len() do
      substitute_move_operand(&mut ops[oi], map)
      oi = oi + 1
    end
  when _ then ()
  end
end

def substitute_temp_moves_terminator(inout term: MirTerminator, map: Map[Int, Place]) -> Unit
  match term.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    var op2 = op
    substitute_move_operand(&mut op2, map)
    let new_kind = MirTerminatorKind::MirSwitchInt { op: op2, targets: targets, default_target: default_target }
    term.kind = new_kind
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    # Note: dest is Place, not MirOperand
    var dest2 = dest
    match map.get(dest2.local.id)
    when Option::Some(src) then
      if dest2.projections.is_empty() then
        dest2 = src.clone()
      end
    when Option::None then ()
    end
    var func2 = func
    substitute_move_operand(&mut func2, map)
    var args2 = args
    var ai = 0
    while ai < args2.len() do
      substitute_move_operand_in_call_arg(&mut args2[ai], map)
      ai = ai + 1
    end
    let new_kind = MirTerminatorKind::MirCall {
      dest: dest2,
      func: func2,
      args: args2,
      success: success,
      unwind: unwind,
      intrinsic: intrinsic,
    }
    term.kind = new_kind
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    var cond2 = cond
    substitute_move_operand(&mut cond2, map)
    let new_kind = MirTerminatorKind::MirAssert { cond: cond2, expected: expected, msg: msg, target: target, unwind: unwind }
    term.kind = new_kind
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    var place2 = place
    match map.get(place2.local.id)
    when Option::Some(src) then
      if place2.projections.is_empty() then
        place2 = src.clone()
      end
    when Option::None then ()
    end
    let new_kind = MirTerminatorKind::MirDeinit { place: place2, deinit_fn: deinit_fn, target: target, unwind: unwind }
    term.kind = new_kind
  when _ then ()
  end
end

def substitute_move_operand(inout op: MirOperand, map: Map[Int, Place]) -> Unit
  match op.kind
  when MirOperandKind::MirMovePlace(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(src) then
        op.kind = MirOperandKind::MirMovePlace(src.clone())
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def substitute_move_operand_in_call_arg(arg: MirCallArg, map: Map[Int, Place]) -> Unit
  match arg.value
  when MirCallValue::Value(op) then substitute_move_operand(&mut op, map)
  when MirCallValue::Place(_) then ()
  end
end

def get_block(f: MirFunction, id: MirBlockId) -> Option[MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(block)
    end
  end
  Option::None
end

def terminator_successors(term: MirTerminator) -> Vec[MirBlockId]
  var result = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    result.push(target)
  when MirTerminatorKind::MirSwitchInt(_, targets, default_target) then
    for t in targets do
      result.push(t.target)
    end
    result.push(default_target)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    result.push(success)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    result.push(target)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    result.push(target)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when _ then ()
  end
  result
end

def terminator_successor_ids(term: MirTerminator) -> Vec[Int]
  var result = Vec::new()
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    result.push(target.id)
  when MirTerminatorKind::MirSwitchInt(_, targets, default_target) then
    for t in targets do
      result.push(t.target.id)
    end
    result.push(default_target.id)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    result.push(success.id)
    match unwind
    when Option::Some(uw) then result.push(uw.id)
    when Option::None then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    result.push(target.id)
    match unwind
    when Option::Some(uw) then result.push(uw.id)
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    result.push(target.id)
    match unwind
    when Option::Some(uw) then result.push(uw.id)
    when Option::None then ()
    end
  when _ then ()
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Escape Analysis
# ———————————————————————————————————————————————————————————————
#
# Determines whether heap-allocated values can be promoted to stack storage.
# A local "escapes" if its address is observable outside its defining function:
#   - Passed to a function call (ArgEscape)
#   - Stored into a global or field reachable from a global (GlobalEscape)
#   - Returned from the function (GlobalEscape)
#   - Taken by mutable reference that itself escapes (transitive)
#
# Non-escaping heap allocations (Box/Vec/Map/closures) are rewritten as stack
# allocations, eliminating malloc/free and improving cache locality.

enum EscapeState
  NoEscape
  ArgEscape      # Escapes to a callee argument (may be safe if callee is inlined)
  GlobalEscape   # Escapes globally — cannot promote
end

def escape_analysis(inout f: MirFunction) -> Unit
  let escape_map = compute_escape_states(f)

  # Collect locals that don't escape — eligible for stack promotion
  var non_escaping: Set[Int] = Set::new()
  for entry in escape_map.entries() do
    let lid = entry.0
    let state = entry.1
    match state
    when EscapeState::NoEscape then
      non_escaping.insert(lid)
    when _ then ()
    end
  end

  if !non_escaping.is_empty() then
    promote_heap_to_stack(f, &non_escaping)
  end
end

def compute_escape_states(f: MirFunction) -> Map[Int, EscapeState]
  var states: Map[Int, EscapeState] = Map::new()

  # Initialize all locals as NoEscape
  for local in f.locals do
    states.insert(local.id.id, EscapeState::NoEscape)
  end
  for param in f.params do
    # Parameters escape by default — caller provides them
    states.insert(param.id.id, EscapeState::ArgEscape)
  end

  # Iterate until stable (simple fixpoint)
  var changed = true
  while changed do
    changed = false

    for block in f.blocks do
      # Analyze statements
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::MirAssign(place, rvalue) then
          let rhs_escape = rvalue_escape_state(&rvalue, &states)
          let dest_id = place.local.id
          # If a reference escapes, the referent escapes too
          match rvalue.kind
          when MirRvalueKind::MirRef(src_place) then
            # Taking a reference — the source escapes if the dest escapes
            let dest_state = lookup_escape(&states, dest_id)
            let src_id = src_place.local.id
            if escalate_escape(&mut states, src_id, dest_state) then
              changed = true
            end
          when _ then ()
          end
        when _ then ()
        end
      end

      # Analyze terminators
      match block.terminator.kind
      when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
        # Arguments passed to calls escape to at least ArgEscape
        for arg in args do
          match arg.value
          when MirCallValue::Value(op) then
            match op.kind
            when MirOperandKind::MirMovePlace(p) then
              if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
                changed = true
              end
            when MirOperandKind::MirCopy(p) then
              if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
                changed = true
              end
            when MirOperandKind::MirRead(p) then
              if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
                changed = true
              end
            when MirOperandKind::MirConsume(p) then
              if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
                changed = true
              end
            when _ then ()
            end
          when MirCallValue::Place(p) then
            if escalate_escape(&mut states, p.local.id, EscapeState::ArgEscape) then
              changed = true
            end
          end
        end
        # Destination also escapes (returned from call)
        if escalate_escape(&mut states, dest.local.id, EscapeState::ArgEscape) then
          changed = true
        end
      when MirTerminatorKind::MirReturn then
        # Return value escapes globally
        # local _0 is the return slot by convention
        if escalate_escape(&mut states, 0, EscapeState::GlobalEscape) then
          changed = true
        end
      when _ then ()
      end
    end
  end

  states
end

def lookup_escape(states: Map[Int, EscapeState], id: Int) -> EscapeState
  match states.get(&id)
  when Option::Some(s) then s.clone()
  when Option::None then EscapeState::NoEscape
  end
end

def escalate_escape(inout states: Map[Int, EscapeState], id: Int, new_state: EscapeState) -> Bool
  let current = lookup_escape(states, id)
  let current_rank = escape_rank(current)
  let new_rank = escape_rank(new_state)
  if new_rank > current_rank then
    states.insert(id, new_state)
    true
  else
    false
  end
end

def escape_rank(state: EscapeState) -> Int
  match state
  when EscapeState::NoEscape then 0
  when EscapeState::ArgEscape then 1
  when EscapeState::GlobalEscape then 2
  end
end

def rvalue_escape_state(rv: MirRvalue, states: Map[Int, EscapeState]) -> EscapeState
  match rv.kind
  when MirRvalueKind::MirMove(op) then operand_escape_state(&op, states)
  when MirRvalueKind::MirRef(place) then lookup_escape(states, place.local.id)
  when _ then EscapeState::NoEscape
  end
end

def operand_escape_state(op: MirOperand, states: Map[Int, EscapeState]) -> EscapeState
  match op.kind
  when MirOperandKind::MirCopy(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirMovePlace(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirRead(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirConsume(place) then lookup_escape(states, place.local.id)
  when MirOperandKind::MirConstant(_) then EscapeState::NoEscape
  end
end

def local_stack_promotion_size_bytes(f: MirFunction, local_id: Int) -> Int
  for local in f.locals do
    if local.id.id == local_id then
      return estimated_type_size_bytes(&local.ty)
    end
  end
  8192
end

def estimated_type_size_bytes(ty: Type) -> Int
  match ty
  when Type::Unit then 0
  when Type::Bool then 1
  when Type::Char then 4
  when Type::Int then 8
  when Type::Float then 8
  when Type::String then 8
  when Type::RefInternal(_, _) then 8
  when Type::Adt(_, _) then 8
  when Type::Tuple(fields) then
    var total = 0
    for field_ty in fields do
      total = total + estimated_type_size_bytes(field_ty)
    end
    total
  when _ then 8192
  end
end

def promote_heap_to_stack(inout f: MirFunction, non_escaping: Set[Int]) -> Unit
  # Rewrite heap allocation calls (Box::new, alloc::allocate) to stack alloca
  # when the destination local does not escape.
  let max_stack_promotion_bytes = 4096
  for block in f.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func: callee, args, success: succ, unwind, intrinsic } then
      # Check if this is a heap allocation call to a non-escaping destination
      let is_alloc = match callee.kind
      when MirOperandKind::MirConstant(c) then
        match c.kind
        when MirConstantKind::MirFnItem(name) then
          name == "Box::new" || name == "alloc::allocate" || name == "Vec::new" ||
          name == "Map::new" || name == "Set::new"
        when _ then false
        end
      when _ then false
      end

      let dest_id = dest.local.id
      let estimated_size = local_stack_promotion_size_bytes(f, dest_id)
      if is_alloc && non_escaping.contains(&dest_id) && estimated_size <= max_stack_promotion_bytes then
        # Replace the call with a stack allocation:
        # Instead of: _X = Box::new(val) -> bb_succ
        # Produce:    _X = StackAlloc(val) as a statement; goto bb_succ
        #
        # We rewrite the terminator to a simple Goto and prepend an Assign.
        # For Vec/Map/Set::new (no args), we leave as an inline struct init.
        if !args.is_empty() then
          let val = duplicate_operand(&args[0])
          let assign_stmt = MirStatement {
            kind: MirStatementKind::MirAssign(
              duplicate_place(&dest),
              MirRvalue { kind: MirRvalueKind::MirMove(val) }
            ),
            span: block.terminator.span.clone()
          }
          block.statements.push(assign_stmt)
        end
        block.terminator = MirTerminator {
          kind: MirTerminatorKind::MirGoto(succ),
          span: block.terminator.span.clone()
        }
      end
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Profile-Guided Optimization (PGO)
# ———————————————————————————————————————————————————————————————
#
# Two-phase PGO workflow:
#   1. Instrumentation: `tg build --pgo-gen=profile.dat` inserts edge counters
#      at every basic block entry.  Running the instrumented binary writes
#      a profile data file.
#   2. Optimization:    `tg build --pgo-use=profile.dat` reads the profile,
#      attaches branch weights, and feeds them to:
#      - Inlining heuristics (hot callees get larger threshold)
#      - Block layout / branch prediction hints
#      - Loop unrolling decisions

struct PgoProfile
  # Maps (function_name, block_id) -> execution count
  block_counts: Map[String, Vec[PgoBlockCount]]
end

struct PgoBlockCount
  block_id: Int
  count: UInt
end

def load_pgo_profile(path: String) -> Option[PgoProfile]
  match read_file(path)
  when Result::Ok(content) then
    Option::Some(parse_pgo_profile(&content))
  when Result::Err(_) then
    Option::None
  end
end

def parse_pgo_profile(content: String) -> PgoProfile
  var profile = PgoProfile { block_counts: Map::new() }
  for line in content.lines() do
    let trimmed = line.trim()
    if trimmed.is_empty() || trimmed.starts_with("#") then next end
    # Format: func_name TAB block_id TAB count
    let parts = trimmed.split("\t")
    if parts.len() >= 3 then
      let func_name = parts[0].clone()
      let block_id = parts[1].parse_int().unwrap_or(0)
      let count = parts[2].parse_uint().unwrap_or(0)
      if !profile.block_counts.contains_key(&func_name) then
        profile.block_counts.insert(func_name.clone(), Vec::new())
      end
      match profile.block_counts.get(&func_name)
      when Option::Some(counts) then
        var new_counts = counts
        new_counts.push(PgoBlockCount { block_id: block_id, count: count })
        profile.block_counts.insert(func_name.clone(), new_counts)
      when Option::None then ()
      end
    end
  end
  profile
end

def save_pgo_profile(path: String, profile: PgoProfile) -> Unit
  var out = "# Tangerine PGO profile data\n"
  out = out + "# func_name\tblock_id\tcount\n"
  for entry in profile.block_counts.entries() do
    let func_name = entry.0
    let counts = entry.1
    for bc in counts do
      out = out + func_name.clone() + "\t" + bc.block_id.to_string() + "\t" + bc.count.to_string() + "\n"
    end
  end
  let _ = write_file_string(path.clone(), &out)
end

def instrument_for_pgo(inout program: MirProgram) -> Unit
  # Insert counter increments at the start of every basic block.
  # At runtime, each counter slot maps to (func_name, block_id).
  # A global counter array is emitted as a static; an atexit handler
  # flushes it to the profile path.
  
  var counter_id = 0
  for func in program.functions do
    if func.is_extern then next end
    
    for block in func.blocks do
      # Prepend: __pgo_counters[counter_id] += 1
      let increment = MirOperand {
        kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirInt(1),
          ty: Type::Int,
          instance: Option::None
        })
      }
      let counter_stmt = MirStatement {
        kind: MirStatementKind::MirEffectRecord("__pgo_counter_" + counter_id.to_string(), increment),
        span: block.terminator.span
      }
      # Insert at position 0
      var new_stmts = Vec::new()
      new_stmts.push(counter_stmt)
      for s in block.statements do
        new_stmts.push(s.clone())
      end
      block.statements = new_stmts
      counter_id = counter_id + 1
    end
  end
end

def apply_pgo_optimizations(inout program: MirProgram) -> Unit
  # Try loading a PGO profile from the default path
  let profile = match load_pgo_profile(&".tg_pgo_profile".to_string())
  when Option::Some(p) then p
  when Option::None then return  # No profile available
  end

  for func in program.functions do
    let func_name = func.name.clone()
    match profile.block_counts.get(&func_name)
    when Option::Some(counts) then
      apply_pgo_to_function(func, counts)
    when Option::None then ()
    end
  end
end

def apply_pgo_to_function(inout f: MirFunction, counts: Vec[PgoBlockCount]) -> Unit
  # Build a count map for quick lookup
  var count_map: Map[Int, UInt] = Map::new()
  for bc in counts do
    count_map.insert(bc.block_id, bc.count)
  end

  # Use profile data to guide optimization:
  # 1. Cold blocks (count == 0): mark as unlikely — branch hints
  # 2. Hot blocks: unroll loops whose header is hot
  # 3. Hot call sites: increase inlining threshold

  # Sort blocks so hot blocks come first (better cache locality)
  var block_order: Vec[(Int, UInt)] = Vec::new()
  for block in f.blocks do
    let count = match count_map.get(&block.id.id)
    when Option::Some(c) then c
    when Option::None then 0
    end
    block_order.push((block.id.id, count))
  end

  # Loop unrolling for hot loops
  # If a back-edge block has count > 1000 and the loop body is small
  # (< 20 stmts), duplicate the body once
  var loops_to_unroll: Vec[(Int, Int)] = Vec::new()  # (header_id, back_edge_block)
  
  for block in f.blocks do
    let block_count = match count_map.get(&block.id.id)
    when Option::Some(c) then c
    when Option::None then 0
    end

    if block_count > 1000 then
      match block.terminator.kind
      when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
        # Check for back-edges (target block id < current block id → likely a loop)
        for t in targets do
          if t.target.id < block.id.id then
            # This is a hot back-edge — record for unrolling
            let header_id = t.target.id
            # Check if loop body is small (blocks between header and back-edge)
            let body_size = block.id.id - header_id + 1
            if body_size <= 10 then
              loops_to_unroll.push((header_id, block.id.id))
            end
          end
        end
    when MirTerminatorKind::MirGoto(target) then
      if target.id < block.id.id then
        let header_id = target.id
        let body_size = block.id.id - header_id + 1
        if body_size <= 10 then
          loops_to_unroll.push((header_id, block.id.id))
        end
      end
      when _ then ()
      end
    end
  end
  
  # Perform loop unrolling by duplicating blocks
  for entry in loops_to_unroll do
    let header_id = entry.0
    let back_edge_id = entry.1
    let next_block_id = f.blocks.len() as Int
    
    # Clone the loop body blocks (from header to back-edge, inclusive)
    var cloned_blocks: Vec[MirBlock] = Vec::new()
    var id_offset = next_block_id - header_id
    
    for block in f.blocks do
      if block.id.id >= header_id && block.id.id <= back_edge_id then
        # Clone this block with new ID
        var new_block = block.clone()
        new_block.id = MirBlockId { id: block.id.id + id_offset }
        
        # Update terminator targets
        match new_block.terminator.kind
        when MirTerminatorKind::MirGoto(target) then
          new_block.terminator.kind = MirTerminatorKind::MirGoto(MirBlockId { id: target.id + id_offset })
        when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
          var remapped_targets = Vec::new()
          for t in targets do
            remapped_targets.push(SwitchTarget { value: t.value, target: MirBlockId { id: t.target.id + id_offset } })
          end
          new_block.terminator.kind = MirTerminatorKind::MirSwitchInt { op: op, targets: remapped_targets, default_target: default_target }
        when _ then ()
        end
        
        cloned_blocks.push(new_block)
      end
    end
    
    # Wire the original back-edge to the cloned header
    for block in f.blocks do
      if block.id.id == back_edge_id then
        match block.terminator.kind
        when MirTerminatorKind::MirGoto(target) then
          if target.id == header_id then
            block.terminator.kind = MirTerminatorKind::MirGoto(MirBlockId { id: header_id + id_offset })
          end
        when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
          var remapped_targets = Vec::new()
          for t in targets do
            if t.target.id == header_id then
              remapped_targets.push(SwitchTarget { value: t.value, target: MirBlockId { id: header_id + id_offset } })
            else
              remapped_targets.push(t)
            end
          end
          block.terminator.kind = MirTerminatorKind::MirSwitchInt { op: op, targets: remapped_targets, default_target: default_target }
        when _ then ()
        end
        break
      end
    end
    
    # Add cloned blocks to function (shared iteration is projected: clone).
    for cblock in cloned_blocks do
      f.blocks.push(cblock.clone())
    end
  end
end

def read_pgo_profile(path: String) -> Result[PgoProfile, String]
  match load_pgo_profile(path)
  when Option::Some(profile) then
    Result::Ok(profile)
  when Option::None then
    Result::Err("could not read or parse profile at " + path.clone())
  end
end

def apply_pgo_profile(inout program: MirProgram, profile: PgoProfile) -> Unit
  for func in program.functions do
    let func_name = func.name.clone()
    match profile.block_counts.get(&func_name)
    when Option::Some(counts) then
      apply_pgo_to_function(func, counts)
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# SSA Conversion
# ———————————————————————————————————————————————————————————————
#
# Converts MIR to strict SSA form:
# 1. Compute dominance tree and dominance frontiers
# 2. Insert Phi nodes at appropriate join points
# 3. Rename variables with version numbering

struct DomInfo
  idom: Map[Int, Int]         # immediate dominator: block_id -> dominator_id
  dom_frontier: Map[Int, Vec[Int]]  # dominance frontier lists
  dom_tree_children: Map[Int, Vec[Int]]  # dominator tree children
end

def convert_to_ssa(inout f: MirFunction) -> Unit
  let dom_info = compute_dominators(f)
  insert_phi_nodes(f, &dom_info)
  rename_variables(f, &dom_info)
end

def compute_dominators(f: MirFunction) -> DomInfo
  # Convert entry block to Int
  let entry = f.entry_block.id
  
  # Map each block ID to index for iteration
  var block_ids = Vec::new()
  for block in f.blocks do
    block_ids.push(block.id.id)
  end
  
  # Initialize dominators: idom[entry] = entry, others = undefined (-1)
  var idom: Map[Int, Int] = Map::new()
  idom.insert(entry, entry)
  
  # Compute predecessors
  var preds: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    preds.insert(b, Vec::new())
  end
  for block in f.blocks do
    let block_id = block.id.id
    for succ_id in terminator_successor_ids(&block.terminator) do
      match preds.get(succ_id)
      when Option::Some(p) then
        p.push(block_id)
      when Option::None then ()
      end
    end
  end
  
  # Reverse postorder for iteration
  let rpo = compute_reverse_postorder(f)
  
  # Iterative dominator computation (Cooper/Harvey/Kennedy algorithm)
  var changed = true
  while changed do
    changed = false
    for b in rpo do
      if b == entry then next end
      
      var new_idom = -1
      match preds.get(b)
      when Option::Some(pred_list) then
        for p in pred_list do
          if idom.contains_key(p) then
            if new_idom == -1 then
              new_idom = p
            else
              new_idom = intersect_doms(&idom, new_idom, p)
            end
          end
        end
      when Option::None then ()
      end
      
      if new_idom != -1 then
        match idom.get(b)
        when Option::Some(old) then
          if old != new_idom then
            idom.insert(b, new_idom)
            changed = true
          end
        when Option::None then
          idom.insert(b, new_idom)
          changed = true
        end
      end
    end
  end
  
  # Compute dominance frontiers
  var dom_frontier: Map[Int, Vec[Int]] = Map::new()
  var dom_frontier_seen: Map[Int, Set[Int]] = Map::new()
  for b in block_ids do
    dom_frontier.insert(b, Vec::new())
    dom_frontier_seen.insert(b, Set::new())
  end
  
  for b in block_ids do
    match preds.get(b)
    when Option::Some(pred_list) then
      if pred_list.len() >= 2 then
        for p in pred_list do
          var runner = p
          while runner != -1 do
            match idom.get(b)
            when Option::Some(idom_b) then
              if runner == idom_b then
                break
              end
            when Option::None then break
            end
            match dom_frontier_seen.get(runner)
            when Option::Some(df_seen) then
              if !df_seen.contains(&b) then
                df_seen.insert(b)
                match dom_frontier.get(runner)
                when Option::Some(df) then
                  df.push(b)
                when Option::None then ()
                end
              end
            when Option::None then ()
            end
            match idom.get(runner)
            when Option::Some(next) then
              if next == runner then break end
              runner = next
            when Option::None then runner = -1
            end
          end
        end
      end
    when Option::None then ()
    end
  end
  
  # Build dominator tree children
  var dom_tree_children: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    dom_tree_children.insert(b, Vec::new())
  end
  for b in block_ids do
    if b != entry then
      match idom.get(b)
      when Option::Some(parent) then
        match dom_tree_children.get(parent)
        when Option::Some(children) then
          children.push(b)
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  DomInfo {
    idom: idom,
    dom_frontier: dom_frontier,
    dom_tree_children: dom_tree_children
  }
end

def intersect_doms(idom: Map[Int, Int], b1: Int, b2: Int) -> Int
  var finger1 = b1
  var finger2 = b2
  while finger1 != finger2 do
    while finger1 > finger2 do
      match idom.get(finger1)
      when Option::Some(next) then finger1 = next
      when Option::None then return finger2
      end
    end
    while finger2 > finger1 do
      match idom.get(finger2)
      when Option::Some(next) then finger2 = next
      when Option::None then return finger1
      end
    end
  end
  finger1
end

def compute_reverse_postorder_dfs(f: MirFunction, block_id: Int, inout visited: Set[Int], inout postorder: Vec[Int]) -> Unit
  if visited.contains(&block_id) then return end
  visited.insert(block_id)

  match get_block(f, MirBlockId { id: block_id })
  when Option::Some(block) then
    for succ_id in terminator_successor_ids(&block.terminator) do
      compute_reverse_postorder_dfs(f, succ_id, visited, postorder)
    end
  when Option::None then ()
  end

  postorder.push(block_id)
end

def compute_reverse_postorder(f: MirFunction) -> Vec[Int]
  var visited: Set[Int] = Set::new()
  var postorder = Vec::new()

  compute_reverse_postorder_dfs(f, f.entry_block.id, &mut visited, &mut postorder)
  postorder.reverse()
  postorder
end

# Phi node representation for SSA
struct PhiNode
  dest: MirLocalId
  ty: Type
  args: Vec[(MirBlockId, MirLocalId)]  # (predecessor_block, value_from_that_block)
end

def insert_phi_nodes(inout f: MirFunction, dom_info: DomInfo) -> Unit
  # For each variable that is assigned in more than one block,
  # insert phi nodes at the dominance frontier
  
  # Collect defs: local_id -> list of block_ids where it's defined
  var defs: Map[Int, Vec[Int]] = Map::new()
  
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, _) then
        if place.projections.is_empty() then
          match defs.get(place.local.id)
          when Option::Some(list) then
            list.push(block.id.id)
          when Option::None then
            var v = Vec::new()
            v.push(block.id.id)
            defs.insert(place.local.id, v)
          end
        end
      when _ then ()
      end
    end
  end
  
  # Insert phi nodes using dominance frontiers
  # For each variable v with multiple defs:
  #   - worklist = blocks where v is defined
  #   - for each block in worklist, add phi at DF(block) if not already there
  
  var phi_placements: Map[Int, Vec[Int]] = Map::new()  # block_id -> list of local_ids needing phi
  var phi_placement_seen: Map[Int, Set[Int]] = Map::new()
  
  for entry in defs do
    let local_id = entry.0
    let def_blocks = entry.1
    if def_blocks.len() <= 1 then next end
    
    var worklist = Vec::new()
    for b in def_blocks do
      worklist.push(b)
    end
    
    var processed: Set[Int] = Set::new()
    while !worklist.is_empty() do
      match worklist.pop()
      when Option::Some(b) then
        match dom_info.dom_frontier.get(b)
        when Option::Some(df) then
          for df_block in df do
            var added_phi = false
            match phi_placement_seen.get(df_block)
            when Option::Some(local_set) then
              if !local_set.contains(&local_id) then
                local_set.insert(local_id)
                added_phi = true
              end
            when Option::None then
              var local_set = Set::new()
              local_set.insert(local_id)
              phi_placement_seen.insert(df_block, local_set)
              added_phi = true
            end

            if added_phi then
              match phi_placements.get(df_block)
              when Option::Some(locals) then
                locals.push(local_id)
              when Option::None then
                var v = Vec::new()
                v.push(local_id)
                phi_placements.insert(df_block, v)
              end
              if !processed.contains(df_block) then
                processed.insert(df_block)
                worklist.push(df_block)
              end
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  # Actually insert phi statements at the beginning of blocks
  for block in f.blocks do
    match phi_placements.get(block.id.id)
    when Option::Some(locals) then
      var new_stmts = Vec::new()
      for local_id in locals do
        # Find the type of this local
        var local_ty = Type::Unit
        for local in f.locals do
          if local.id.id == local_id then
            local_ty = local.ty.clone()
            break
          end
        end
        for p in f.params do
          if p.id.id == local_id then
            local_ty = p.ty.clone()
            break
          end
        end
        
        # Create phi statement as a special assignment
        # MIR doesn't have native phi, so we use a PhiRvalue marker
        let phi_rvalue = MirRvalue {
          kind: MirRvalueKind::MirPhi(Vec::new())  # Will be filled in rename pass
        }
        new_stmts.push(MirStatement {
          kind: MirStatementKind::MirAssign(
            place_local(MirLocalId { id: local_id }),
            phi_rvalue
          ),
          span: match block.statements.get(0)
          when Option::Some(stmt) then stmt.span.clone()
          when Option::None then block.terminator.span
          end
        })
      end
      # Prepend phis to existing statements
      for stmt in block.statements do
        new_stmts.push(stmt.clone())
      end
      block.statements = new_stmts
    when Option::None then ()
    end
  end
end

def rename_variables_block(inout f: MirFunction, block_id: Int, dom_info: DomInfo,
                         inout version_counter: Map[Int, Int],
                         inout version_stack: Map[Int, Vec[Int]]) -> Unit

  match get_block_index(f, MirBlockId { id: block_id })
  when Option::Some(block_idx) then
    var pushed_versions: Vec[(Int, Int)] = Vec::new()  # (local_id, version) for cleanup

    for stmt in f.blocks[block_idx].statements do
      # Capture the def's original local ID BEFORE renaming uses,
      # to avoid aliasing bugs where renaming an rvalue operand that
      # shares the same MirLocalId object corrupts the LHS place.
      var def_local_id = -1
      match stmt.kind
      when MirStatementKind::MirAssign(place, _) then
        if place.projections.is_empty() then
          def_local_id = place.local.id
        end
      when _ then ()
      end

      # Rename uses (rvalue operands)
      rename_operands_in_stmt(&mut stmt, version_stack)

      # Handle def: push new version using the saved original ID
      if def_local_id >= 0 then
        let ssa_version_base = 1000000000
        let orig_id = if def_local_id >= ssa_version_base then
          def_local_id / ssa_version_base
        else
          def_local_id
        end
        match version_counter.get(orig_id)
        when Option::Some(ver) then
          let new_ver = ver
          version_counter.insert(orig_id, ver + 1)
          match version_stack.get(orig_id)
          when Option::Some(stack) then
            stack.push(new_ver)
            pushed_versions.push((orig_id, new_ver))
          when Option::None then ()
          end
          # Rename the LHS place to the new versioned ID
          match stmt.kind
          when MirStatementKind::MirAssign(place, _) then
            if place.projections.is_empty() then
              place.local = MirLocalId { id: orig_id * ssa_version_base + new_ver }
            end
          when _ then ()
          end
        when Option::None then ()
        end
      end
    end

    rename_operands_in_terminator(&mut f.blocks[block_idx].terminator, version_stack)

    let successors = terminator_successor_ids(&f.blocks[block_idx].terminator)
    for succ_id in successors do
      fill_phi_args(f, MirBlockId { id: succ_id }, MirBlockId { id: block_id }, version_stack)
    end

    match dom_info.dom_tree_children.get(block_id)
    when Option::Some(children) then
      for child in children do
        rename_variables_block(f, child, dom_info, version_counter, version_stack)
      end
    when Option::None then ()
    end

    for entry in pushed_versions do
      let lid = entry.0
      match version_stack.get(lid)
      when Option::Some(stack) then stack.pop()
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
end

def rename_variables(inout f: MirFunction, dom_info: DomInfo) -> Unit
  # SSA renaming: traverse dom tree, maintaining a stack of versions for each variable
  var version_counter: Map[Int, Int] = Map::new()  # local_id -> next version
  var version_stack: Map[Int, Vec[Int]] = Map::new()  # local_id -> stack of current versions
  
  # Initialize with params
  for p in f.params do
    version_counter.insert(p.id.id, 1)
    var stack = Vec::new()
    stack.push(0)
    version_stack.insert(p.id.id, stack)
  end
  
  # Initialize locals
  for local in f.locals do
    version_counter.insert(local.id.id, 0)
    version_stack.insert(local.id.id, Vec::new())
  end

  rename_variables_block(f, f.entry_block.id, dom_info, &mut version_counter, &mut version_stack)
end

def rename_operands_in_stmt(inout stmt: MirStatement, version_stack: Map[Int, Vec[Int]]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    rename_operands_in_rvalue(&mut rvalue, version_stack)
  when _ then ()
  end
end

def rename_operands_in_rvalue(inout rv: MirRvalue, version_stack: Map[Int, Vec[Int]]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    rename_operand(&mut lhs, version_stack)
    rename_operand(&mut rhs, version_stack)
  when MirRvalueKind::MirUnOp(_, op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::MirRef(p) then
    rename_place(&mut p, version_stack)
  when MirRvalueKind::MirCast(_, op, _) then
    rename_operand(&mut op, version_stack)
  when _ then ()
  end
end

def rename_operand(inout op: MirOperand, version_stack: Map[Int, Vec[Int]]) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(place) then
    rename_place(&mut place, version_stack)
  when MirOperandKind::MirMovePlace(place) then
    rename_place(&mut place, version_stack)
  when MirOperandKind::MirRead(place) then
    rename_place(&mut place, version_stack)
  when MirOperandKind::MirConsume(place) then
    rename_place(&mut place, version_stack)
  when _ then ()
  end
end

def rename_place(inout place: Place, version_stack: Map[Int, Vec[Int]]) -> Unit
  # Proper SSA renaming
  # Update the place's local to use the current version from the stack
  # Version is encoded as: (original_id * ssa_version_base) + version
  # Use a large base to avoid collisions once local IDs exceed 10K.
  let ssa_version_base = 1000000000
  let current_id = place.local.id
  let orig_id = if current_id >= ssa_version_base then
    current_id / ssa_version_base
  else
    current_id
  end
  match version_stack.get(&orig_id)
  when Option::Some(stack) then
    match stack.last()
    when Option::Some(current_version) then
      # Create a new MirLocalId instead of modifying in-place to avoid
      # corrupting other Places that share the same MirLocalId pointer.
      var new_local = place.local.clone()
      new_local.id = orig_id * ssa_version_base + current_version
      place.local = new_local
    when Option::None then ()
    end
  when Option::None then
    # No version stack for this local - keep original id unversioned.
    var new_local = place.local.clone()
    new_local.id = orig_id
    place.local = new_local
  end
end

def rename_operands_in_terminator(inout term: MirTerminator, version_stack: Map[Int, Vec[Int]]) -> Unit
  match term.kind
  when MirTerminatorKind::MirReturn then
    # Return has no operand - return value is in local 0
    ()
  when MirTerminatorKind::MirCall { dest, func: var func_op, args: var args_op, success, unwind, intrinsic } then
    rename_operand(&mut func_op, version_stack)
    for arg_val in args_op do
      match arg_val.value
      when MirCallValue::Value(op) then rename_operand(&mut op, version_stack)
      when MirCallValue::Place(_) then ()
      end
    end
  when MirTerminatorKind::MirSwitchInt { op: var discr, targets, default_target } then
    rename_operand(&mut discr, version_stack)
  when MirTerminatorKind::MirAssert { cond: var cond_op, expected, msg, target, unwind } then
    rename_operand(&mut cond_op, version_stack)
  when _ then ()
  end
end

def fill_phi_args(inout f: MirFunction, succ_id: MirBlockId, pred_id: MirBlockId, 
                  version_stack: Map[Int, Vec[Int]]) -> Unit
  match get_block_index(f, succ_id)
  when Option::Some(block_idx) then
    for stmt in f.blocks[block_idx].statements do
      match stmt.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirPhi(args) then
          let lid = place.local.id
          match version_stack.get(lid)
          when Option::Some(stack) then
            match stack.last()
            when Option::Some(ver) then
              # Add argument: from pred_id, use version ver
              let ssa_version_base = 1000000000
              var arg_local = place.local.clone()
              arg_local.id = lid * ssa_version_base + ver
              args.push((pred_id.clone(), arg_local))
            when Option::None then ()
            end
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  when Option::None then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lower_to_mir(program: Program, analyzed: AnalyzedProgram) -> Result[MirProgram, String]
  lower_program(program, analyzed)
end

# ———————————————————————————————————————————————————————————————
# MIR Verifier
# ———————————————————————————————————————————————————————————————
# Checks structural invariants of MIR:
#   1. Every function has an entry block that exists
#   2. Every block has exactly one terminator
#   3. All successor block IDs are valid
#   4. All local references are defined
#   5. SSA: every variable defined before use (within dominance)
#   6. Type consistency for operations
#   7. No unreachable blocks (warning)

def verify_mir(mir: MirProgram) -> Vec[String]
  var errors = Vec::new()
  # Build a type index (type_id -> MirTypeDef) used for projection and rvalue
  # type-checking across all functions.
  var type_index: Map[Int, MirTypeDef] = Map::new()
  for td in mir.types do
    type_index.insert(td.id.id, td.clone())
  end
  # The CONCRETE deinit plans (concrete type identity -> DeinitPlan, see
  # mir_type_identity_key) carried on MirProgram: the DROP-GLUE authority
 # — every Named type in concrete MIR must key a plan (by its
  # concrete identity) or a MirTypeDef. Copy legality is NOT derived from
  # the plans: the verifier queries the engine snapshot below
  # (type_properties_of on MirProgram.engine_env — the is_trivially_copyable
  # axis, the COPY authority).
  var plans = mir.deinit_plans.clone()
 # (the needs_drop split): the engine snapshot env carried on the
  # program — the Copy verifier's canonical TypeProperties queries
  # (type_properties_of over the snapshot, memoized per concrete identity).
  # The snapshot is taken by value once here and threaded as &mut through
  # the per-function verification (its type_prop_cache warms across the
  # whole program).
  var engine_env = mir.engine_env.clone()
  # Function table for the callee-resolution invariant: every MirFnItem
  # callee must name a lowered function or a known intrinsic.
  var fn_names: Set[String] = Set::new()
  for f in mir.functions do
    fn_names.insert(f.name.clone())
  end
 # the declared-effect table for the effect rule: MirFunction emission
  # name -> the function's DECLARED EFFECT SET (the typed FnSignature
  # records carried at lowering). The verifier checks every MirCall's
  # callee against this table — a call to an effectful callee in a
  # function without the declared effect is a verifier error (the same
  # rule as the checker's, at the MIR level). A callee missing from the
  # table (an intrinsic, a synthesized callee) carries no declared
  # effects and never fires.
  var fn_effects: Map[String, Vec[EffectId]] = Map::new()
  for f in mir.functions do
    if f.declared_effects.len() > 0 then
      fn_effects.insert(f.name.clone(), f.declared_effects.clone())
    end
  end
 # every MirTypeDef must be concrete — no Type::Param / Type::Var in
  # field or variant types (generic struct fields resolve to the Named(0)
  # placeholder, which is checked separately), and every Named type inside a
  # type definition must carry a canonical TypeId.
  let pnames = mir.generic_param_names.clone()
  for td in mir.types do
    let td_what = "type " + td.name.clone()
    match td.kind
    when MirTypeDefKind::Struct(fields) then
      for f in fields do
        verifier_check_type_concreteness(&plans, &type_index, &pnames, &td_what, &f.ty, false, &mut errors)
      end
    when MirTypeDefKind::Enum(variants) then
      for v in variants do
        var vfi = 0
        while vfi < v.fields.len() do
          verifier_check_type_concreteness(&plans, &type_index, &pnames, &td_what, &v.fields[vfi], false, &mut errors)
          vfi = vfi + 1
        end
      end
    end
  end
 # (concrete-MIR statics): every MirStatic's type must be concrete — a
  # static initializer runs at load time and its value is program-visible, so
  # no Type::Param / Type::Var / Type::Error may reach it (allow_param=false:
  # a static is never a generic template). The init operand's embedded types
  # (constant types, InstanceId substitutions) are checked under the same
  # rule.
  for st in mir.statics do
    let st_what = "static " + st.name.clone()
    verifier_check_type_concreteness(&plans, &type_index, &pnames, &st_what, &st.ty, false, &mut errors)
    match st.init
    when Option::Some(op) then
      verifier_check_static_embedded_types(&plans, &type_index, &pnames, &st_what, &op, &mut errors)
    when Option::None then ()
    end
  end
 # (deinit instances): the legal deinit identities — every finalizer
  # InstanceId the program's concrete deinit plans may emit (DeinitPlan::Call
  # / DeinitPlan::UserFinalizer, recursively) plus every generated drop-glue
  # function's identity (drop_glue_fns). A MirDeinit terminator may only
  # carry one of these (see verifier_check_callees).
  var deinit_instances: Set[Int] = Set::new()
  for (_, dp) in plans do
    collect_deinit_plan_instances(&dp, &mut deinit_instances)
  end
  var func_idx = 0
  while func_idx < mir.functions.len() do
    let func = mir.functions[func_idx]
    verify_function_v2(&type_index, &plans, &fn_names, &deinit_instances, &mir.drop_glue_fns, &pnames, func, &fn_effects, &mut engine_env, &mut errors)
    func_idx = func_idx + 1
  end
  errors
end

# (deinit instances): collect every finalizer identity a DeinitPlan tree
# references (the Call/UserFinalizer InstanceId defs, transitively through
# all structural plan shapes).
def collect_deinit_plan_instances(plan: DeinitPlan, inout out: Set[Int]) -> Unit
  match plan
  when DeinitPlan::Call(instance) then out.insert(def_id_numeric(&instance.def.def))
  when DeinitPlan::UserFinalizer(instance, inner) then
    out.insert(def_id_numeric(&instance.def.def))
    collect_deinit_plan_instances(inner, out)
  when DeinitPlan::Aggregate(plans) then
    for p in plans do collect_deinit_plan_instances(p, out) end
  when DeinitPlan::Enum(vmap) then
    for (_, entry) in vmap do
      for p in entry.1 do collect_deinit_plan_instances(p, out) end
    end
  when DeinitPlan::Array(p) then collect_deinit_plan_instances(p, out)
  when DeinitPlan::Set(p) then collect_deinit_plan_instances(p, out)
  when DeinitPlan::Box(p) then collect_deinit_plan_instances(p, out)
  when DeinitPlan::Map(kplan, vplan) then
    collect_deinit_plan_instances(kplan, out)
    collect_deinit_plan_instances(vplan, out)
  when DeinitPlan::Tuple(plans) then
    for p in plans do collect_deinit_plan_instances(p, out) end
  when DeinitPlan::Option(p) then collect_deinit_plan_instances(p, out)
  when DeinitPlan::Result(ok_plan, err_plan) then
    collect_deinit_plan_instances(ok_plan, out)
    collect_deinit_plan_instances(err_plan, out)
  when _ then ()
  end
end

# Whether a named struct type declares a field with the given name.
def struct_has_field(types: Vec[MirTypeDef], type_id: Int, field_name: String) -> Bool
  var t_idx = 0
  while t_idx < types.len() do
    let td = types[t_idx]
    if td.id.id == type_id then
      match td.kind
      when MirTypeDefKind::Struct(fields) then
        var f_idx = 0
        while f_idx < fields.len() do
          if fields[f_idx].name == field_name then
            return true
          end
          f_idx = f_idx + 1
        end
      when _ then ()
      end
      return false
    end
    t_idx = t_idx + 1
  end
  false
end

def verify_function(func: MirFunction, types: Vec[MirTypeDef], inout errors: Vec[String]) -> Unit
  # Extern declarations have no bodies; nothing to verify.
  if func.is_extern then return end
  let fn_ctx = "fn " + func.name.clone()
  
  # 2. Must have at least one block
  if func.blocks.is_empty() then
    errors.push(fn_ctx.clone() + ": function has no blocks")
    return
  end
  
  # Collect valid block IDs and local IDs (build set FIRST for O(1) lookups)
  var valid_blocks: Set[Int] = Set::new()
  var block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    valid_blocks.insert(block.id.id)
    block_idx = block_idx + 1
  end
  
  # 1. Entry block must exist (using O(1) set lookup)
  let entry_id = func.entry_block.id
  if !valid_blocks.contains(&entry_id) then
    errors.push(fn_ctx.clone() + ": entry block bb" + entry_id.to_string() + " does not exist")
  end
  
  var valid_locals: Set[Int] = Set::new()
  var local_idx = 0
  while local_idx < func.locals.len() do
    let local = func.locals[local_idx]
    valid_locals.insert(local.id.id)
    local_idx = local_idx + 1
  end
  var param_idx = 0
  while param_idx < func.params.len() do
    let param = func.params[param_idx]
    valid_locals.insert(param.id.id)
    param_idx = param_idx + 1
  end
  
  # 3. Check each block
  block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    let bb_ctx = fn_ctx.clone() + " bb" + block.id.id.to_string()
    
    # Every statement must reference valid locals
    var stmt_idx = 0
    while stmt_idx < block.statements.len() do
      let stmt = block.statements[stmt_idx]
      verify_statement(stmt, &valid_locals, types, &bb_ctx, errors)
      stmt_idx = stmt_idx + 1
    end
    
    # Terminator must reference valid successor blocks
    verify_terminator(&block.terminator, &valid_blocks, &valid_locals, &bb_ctx, errors)
    block_idx = block_idx + 1
  end
  
  # 4. Check for unreachable blocks (reachability from entry)
  var reachable: Set[Int] = Set::new()
  var worklist = Vec::new()
  worklist.push(func.entry_block.id)
  
  while !worklist.is_empty() do
    match worklist.pop()
    when Option::Some(bid) then
      if reachable.contains(&bid) then next end
      reachable.insert(bid)

      # Find successors
      block_idx = 0
      while block_idx < func.blocks.len() do
        let block = func.blocks[block_idx]
        if block.id.id == bid then
          match block.terminator.kind
          when MirTerminatorKind::MirGoto(target) then
            let succ_id = target.id
            if !reachable.contains(&succ_id) then worklist.push(succ_id) end
          when MirTerminatorKind::MirSwitchInt(_, targets, default_target) then
            var target_idx = 0
            while target_idx < targets.len() do
              let target = targets[target_idx]
              let succ_id = target.target.id
              if !reachable.contains(&succ_id) then worklist.push(succ_id) end
              target_idx = target_idx + 1
            end
            let default_id = default_target.id
            if !reachable.contains(&default_id) then worklist.push(default_id) end
          when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
            let succ_id = success.id
            if !reachable.contains(&succ_id) then worklist.push(succ_id) end
            match unwind
            when Option::Some(uw) then
              let unwind_id = uw.id
              if !reachable.contains(&unwind_id) then worklist.push(unwind_id) end
            when Option::None then ()
            end
          when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
            let succ_id = target.id
            if !reachable.contains(&succ_id) then worklist.push(succ_id) end
            match unwind
            when Option::Some(uw) then
              let unwind_id = uw.id
              if !reachable.contains(&unwind_id) then worklist.push(unwind_id) end
            when Option::None then ()
            end
          when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
            let succ_id = target.id
            if !reachable.contains(&succ_id) then worklist.push(succ_id) end
            match unwind
            when Option::Some(uw) then
              let unwind_id = uw.id
              if !reachable.contains(&unwind_id) then worklist.push(unwind_id) end
            when Option::None then ()
            end
          when _ then ()
          end
          break
        end
        block_idx = block_idx + 1
      end
    when Option::None then ()
    end
  end
  
  block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    let block_id = block.id.id
    if !reachable.contains(&block_id) then
      # Per canonical IR spec, unreachable blocks are warnings only, not errors.
      # Optimizations (DCE) may leave them; verifier flags them for review but
      # does not reject the program.
      ()
    end
    block_idx = block_idx + 1
  end

  # 5. Check that StorageLive precedes uses within dominated blocks
  var defined_locals: Set[Int] = Set::new()
  param_idx = 0
  while param_idx < func.params.len() do
    let param = func.params[param_idx]
    defined_locals.insert(param.id.id)
    param_idx = param_idx + 1
  end

  block_idx = 0
  while block_idx < func.blocks.len() do
    let block = func.blocks[block_idx]
    let block_id = block.id.id
    if reachable.contains(&block_id) then
      var stmt_idx = 0
      while stmt_idx < block.statements.len() do
        let stmt = block.statements[stmt_idx]
        match stmt.kind
        when MirStatementKind::MirAssign(place, _) then
          defined_locals.insert(place.local.id)
        when MirStatementKind::MirStorageLive(local) then
          defined_locals.insert(local.id)
        when _ then ()
        end
        stmt_idx = stmt_idx + 1
      end
    end
    block_idx = block_idx + 1
  end
end

def verify_statement(stmt: MirStatement, valid_locals: Set[Int], types: Vec[MirTypeDef],
                     ctx: String, inout errors: Vec[String]) -> Unit
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": assignment to undefined local _" + local_id.to_string())
    end
    verify_rvalue(rvalue, valid_locals, types, ctx, errors)
  when MirStatementKind::MirStorageLive(local) then
    let local_id = local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": StorageLive for undefined local _" + local_id.to_string())
    end
  when MirStatementKind::MirStorageDead(local) then
    let local_id = local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": StorageDead for undefined local _" + local_id.to_string())
    end
  when _ then ()
  end
end

def verify_rvalue(rvalue: MirRvalue, valid_locals: Set[Int], types: Vec[MirTypeDef],
                  ctx: String, inout errors: Vec[String]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then verify_operand(operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    verify_operand(lhs, valid_locals, ctx, errors)
    verify_operand(rhs, valid_locals, ctx, errors)
  when MirRvalueKind::MirUnOp(_, operand) then verify_operand(operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirRef(place) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": to undefined local _" + local_id.to_string())
    end
  when MirRvalueKind::MirCast(_, operand, _) then verify_operand(operand, valid_locals, ctx, errors)
  when MirRvalueKind::MirAggregate(AggregateKind::Struct(tid, field_names), operands) then
    var op_idx = 0
    while op_idx < operands.len() do
      let op = operands[op_idx]
      verify_operand(op, valid_locals, ctx, errors)
      op_idx = op_idx + 1
    end
    # Every struct aggregate must carry exactly one field name per operand, and
    # each name must correspond to a field declared by the struct type. This
    # catches literal/declaration order mismatches before codegen (which relies
    # on the names to place fields at their DECLARED offsets).
    if operands.len() != field_names.len() then
      errors.push(ctx.clone() + ": struct aggregate has " + operands.len().to_string() +
                  " operands but " + field_names.len().to_string() + " field names")
    end
    var fi = 0
    while fi < field_names.len() do
      if !struct_has_field(types, tid.id, &field_names[fi]) then
        errors.push(ctx.clone() + ": struct aggregate references unknown field \"" +
                    field_names[fi].clone() + "\" (type id " + tid.id.to_string() + ")")
      end
      fi = fi + 1
    end
  when MirRvalueKind::MirAggregate(_, operands) then
    var op_idx = 0
    while op_idx < operands.len() do
      let op = operands[op_idx]
      verify_operand(op, valid_locals, ctx, errors)
      op_idx = op_idx + 1
    end
  when MirRvalueKind::MirPhi(entries) then
    var entry_idx = 0
    while entry_idx < entries.len() do
      let entry = entries[entry_idx]
      # entry.1 is a MirLocalId
      let local_id = entry.1.id
      if !valid_locals.contains(&local_id) then
        errors.push(ctx.clone() + ": phi references undefined local _" + local_id.to_string())
      end
      entry_idx = entry_idx + 1
    end
  when _ then ()
  end
end

def verify_operand(operand: MirOperand, valid_locals: Set[Int],
                   ctx: String, inout errors: Vec[String]) -> Unit
  match operand.kind
  when MirOperandKind::MirCopy(place) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": copy of undefined local _" + local_id.to_string())
    end
  when MirOperandKind::MirMovePlace(place) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": move of undefined local _" + local_id.to_string())
    end
  when MirOperandKind::MirRead(place) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": read of undefined local _" + local_id.to_string())
    end
  when MirOperandKind::MirConsume(place) then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": consume of undefined local _" + local_id.to_string())
    end
  when MirOperandKind::MirConstant(_) then ()
  end
end

def verify_terminator(term: MirTerminator, valid_blocks: Set[Int], 
                      valid_locals: Set[Int], ctx: String, 
                      inout errors: Vec[String]) -> Unit
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    let target_id = target.id
    if !valid_blocks.contains(&target_id) then
      errors.push(ctx.clone() + ": goto references invalid block bb" + target_id.to_string())
    end
  when MirTerminatorKind::MirSwitchInt(operand, targets, fallback) then
    verify_operand(operand, valid_locals, ctx, errors)
    var target_idx = 0
    while target_idx < targets.len() do
      let t = targets[target_idx]
      let target_id = t.target.id
      if !valid_blocks.contains(&target_id) then
        errors.push(ctx.clone() + ": switch references invalid block bb" + target_id.to_string())
      end
      target_idx = target_idx + 1
    end
    let fallback_id = fallback.id
    if !valid_blocks.contains(&fallback_id) then
      errors.push(ctx.clone() + ": switch fallback references invalid block bb" + fallback_id.to_string())
    end
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
    verify_operand(callee, valid_locals, ctx, errors)
    var arg_idx = 0
    while arg_idx < args.len() do
      let arg = args[arg_idx]
      let arg_op = mir_call_arg_operand(arg)
      verify_operand(&arg_op, valid_locals, ctx, errors)
      arg_idx = arg_idx + 1
    end
    let success_id = success.id
    if !valid_blocks.contains(&success_id) then
      errors.push(ctx.clone() + ": call success references invalid block bb" + success_id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      let unwind_id = ub.id
      if !valid_blocks.contains(&unwind_id) then
        errors.push(ctx.clone() + ": call unwind references invalid block bb" + unwind_id.to_string())
      end
    when Option::None then ()
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    let local_id = place.local.id
    if !valid_locals.contains(&local_id) then
      errors.push(ctx.clone() + ": deinit of undefined local _" + local_id.to_string())
    end
    let target_id = target.id
    if !valid_blocks.contains(&target_id) then
      errors.push(ctx.clone() + ": deinit target references invalid block bb" + target_id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      let unwind_id = ub.id
      if !valid_blocks.contains(&unwind_id) then
        errors.push(ctx.clone() + ": deinit unwind references invalid block bb" + unwind_id.to_string())
      end
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    verify_operand(cond, valid_locals, ctx, errors)
    let target_id = target.id
    if !valid_blocks.contains(&target_id) then
      errors.push(ctx.clone() + ": assert target references invalid block bb" + target_id.to_string())
    end
    match unwind
    when Option::Some(ub) then
      let unwind_id = ub.id
      if !valid_blocks.contains(&unwind_id) then
        errors.push(ctx.clone() + ": assert unwind references invalid block bb" + unwind_id.to_string())
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

# Note: terminator_successors is defined earlier in this file (returns Vec[MirBlockId])

def block_exists(func: MirFunction, id: MirBlockId) -> Bool
  for block in func.blocks do
    if block.id.id == id.id then
      return true
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Upgrade: Real CFG/dataflow MIR verifier
# ———————————————————————————————————————————————————————————————
#
# The verifier below replaces the earlier ad-hoc checks with a real
# analysis:
#   * CFG well-formedness (entry exists, terminator successor blocks exist)
#   * Definite-initialization dataflow (forward, meet = intersection of
#     predecessors) — flags uses of possibly-uninitialized locals
#   * Storage-lifetime dataflow (StorageLive/StorageDead respected)
#   * Projection typing — validates each projection step against the
#     resolved type (deref of pointers, field of structs/tuples, downcast
#     of enum variants, index of arrays/slices)
#   * Rvalue typing — operands are well-typed and defined
#   * Call invariants — callee is function-typed, arg arity/type match,
#     destination type matches the return type
#
# The type index (Map[Int, MirTypeDef]) is threaded through so that
# projection and call checking resolve user-defined structs/enums.

# ———————————————————————————————————————————————————————————————
# Type-system helpers
# ———————————————————————————————————————————————————————————————

# structural identity key for the verifier's type compatibility
# checks. The Named storage forms of the registered builtin compounds key
# IDENTICALLY to their canonical variants (the name comes from the program's
# type table — MirTypeDef id -> name), so the verifier treats the Named and
# canonical forms as the same type; user-defined Named types keep the
# id-based key.
def verifier_type_key(type_index: Map[Int, MirTypeDef], ty: Type) -> String
  match ty
  when Type::Unit then "unit"
  when Type::Bool then "bool"
  when Type::Int then "int"
  when Type::UInt then "uint"
  when Type::Float then "float"
  when Type::Char then "char"
  when Type::String then "string"
  when Type::Never then "never"
  when Type::I8 then "i8"
  when Type::I16 then "i16"
  when Type::I32 then "i32"
  when Type::I64 then "i64"
  when Type::I128 then "i128"
  when Type::U8 then "u8"
  when Type::U16 then "u16"
  when Type::U32 then "u32"
  when Type::U64 then "u64"
  when Type::U128 then "u128"
  when Type::ISize then "isize"
  when Type::USize then "usize"
  when Type::F32 then "f32"
  when Type::F64 then "f64"
  when Type::Adt(tid, args) then
    let nname = match type_index.get(tid.id)
    when Option::Some(td) then mir_bare_type_name(&td.name)
    when Option::None then ""
    end
    if nname == "Option" && args.len() >= 1 then
      "option:" + verifier_type_key(type_index, &args[0])
    elsif nname == "Result" && args.len() >= 2 then
      "result:" + verifier_type_key(type_index, &args[0]) + ":" + verifier_type_key(type_index, &args[1])
    elsif nname == "Box" && args.len() >= 1 then
      "box:" + verifier_type_key(type_index, &args[0])
    elsif nname == "Rc" && args.len() >= 1 then
      "rc:" + verifier_type_key(type_index, &args[0])
    elsif nname == "Map" && args.len() >= 2 then
      "map:" + verifier_type_key(type_index, &args[0]) + ":" + verifier_type_key(type_index, &args[1])
    elsif nname == "Set" && args.len() >= 1 then
      "set:" + verifier_type_key(type_index, &args[0])
    elsif nname == "Slice" && args.len() >= 1 then
      "slice:" + verifier_type_key(type_index, &args[0])
    elsif (nname == "Array" || nname == "Vec") && args.len() >= 1 then
      # The heap-vector Adt form carries no count (the size lives in the
      # distinct FixedArray variant); key by the element alone.
      "array(" + verifier_type_key(type_index, &args[0]) + ")"
    else
      "named:" + tid.id.to_string()
    end
  when Type::FixedArray(elem, n) then
    "fixedarray(" + verifier_type_key(type_index, &elem) + ":" + n.to_string() + ")"
  when Type::FnPtr(_, _, _) then "fnptr"
  when Type::Closure(cid, _, _, _, _) then "closure<" + cid.id.to_string() + ">"
  when Type::RefInternal(inner, mutable) then
    if mutable then "&mut " + verifier_type_key(type_index, &inner) else "&" + verifier_type_key(type_index, &inner) end
  when Type::Ptr(inner) then "*" + verifier_type_key(type_index, &inner)
  when Type::PtrMut(inner) then "*mut " + verifier_type_key(type_index, &inner)
  when Type::Dyn(_) then "dyn"
  when Type::Effect(_, inner) then verifier_type_key(type_index, &inner)
  when Type::Tuple(fields) then
    var s = "tuple("
    var i = 0
    while i < fields.len() do
      s = s + verifier_type_key(type_index, &fields[i])
      if i < fields.len() - 1 then s = s + "," end
      i = i + 1
    end
    s + ")"
  when Type::Var(_) then "var"
  when Type::Param(gpid) then "param:" + generic_param_id_numeric(&gpid).to_string()
  when Type::Error then "error"
  when _ then "unknown"
  end
end

def verifier_types_compatible(type_index: Map[Int, MirTypeDef], expected: Type, actual: Type) -> Bool
  let ek = verifier_type_key(type_index, expected)
  let ak = verifier_type_key(type_index, actual)
  if ek == ak then return true end
  # Unit/Never are interchangeable at value level.
  if (ek == "unit" && ak == "never") || (ek == "never" && ak == "unit") then return true end
  false
end

def verifier_local_type(func: MirFunction, lid: Int) -> Option[Type]
  for p in func.params do
    if p.id.id == lid then return Option::Some(p.ty.clone()) end
  end
  for l in func.locals do
    if l.id.id == lid then return Option::Some(l.ty.clone()) end
  end
  Option::None
end

def verifier_local_exists(func: MirFunction, lid: Int) -> Bool
  for p in func.params do
    if p.id.id == lid then return true end
  end
  for l in func.locals do
    if l.id.id == lid then return true end
  end
  false
end

def verifier_block_exists(func: MirFunction, bid: Int) -> Bool
  for b in func.blocks do
    if b.id.id == bid then return true end
  end
  false
end

def verifier_type_def(type_index: Map[Int, MirTypeDef], tid: Int) -> Option[MirTypeDef]
  match type_index.get(tid)
  when Option::Some(td) then Option::Some(td.clone())
  when Option::None then Option::None
  end
end

# (Type collapse): resolve a builtin compound's LangItems TypeId from
# the verifier's type_index (id -> MirTypeDef, name-carrying) by name scan.
# Only the std-DECLARED builtins (Option/Result/Vec/Map/Set/Box/Rc) are
# present; the checker-registered Opaque builtins (Array/Slice) are not
# declared anywhere, so the scan returns -1 for them.
def verifier_lang_item_id(type_index: Map[Int, MirTypeDef], name: String) -> Int
  for (tid, td) in type_index do
    if mir_bare_type_name(&td.name) == name then return tid end
  end
  -1
end

def verifier_strip_pointee(type_index: Map[Int, MirTypeDef], ty: Type) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then Option::Some(inner.clone())
  when Type::Ptr(inner) then Option::Some(inner.clone())
  when Type::PtrMut(inner) then Option::Some(inner.clone())
  when Type::Adt(tid, args) then
 # (Type collapse): the canonical Box/Rc arms are gone — the Adt
    # form of Box/Rc is selected by the registered name (the verifier's
    # type_index is the id -> MirTypeDef name table).
    let nname = match type_index.get(tid.id)
    when Option::Some(td) then mir_bare_type_name(&td.name)
    when Option::None then ""
    end
    if (nname == "Box" || nname == "Rc") && !args.is_empty() then
      Option::Some(args[0].clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Projection typing
# ———————————————————————————————————————————————————————————————

def verifier_field_type(type_index: Map[Int, MirTypeDef], ty: Type, index: Int) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then verifier_field_type(type_index, &inner, index)
  when Type::Tuple(fields) then
    if index >= 0 && index < fields.len() then Option::Some(fields[index].clone()) else Option::None end
  when Type::Adt(tid, args) then
    match verifier_type_def(type_index, tid.id)
    when Option::Some(td) then
      match td.kind
      when MirTypeDefKind::Struct(fields) then
        # The field's DECLARED type is substituted under the concrete Adt
        # args (subst_type_args — the same substituted-field computation
        # layout_engine's substitute_mir_fields performs), so a generic
        # field that becomes String after substitution types as the
        # CONCRETE String here.
        if index >= 0 && index < fields.len() then
          Option::Some(subst_type_args(&fields[index].ty, &td.generic_params, args))
        else
          Option::None
        end
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def verifier_downcast_type(type_index: Map[Int, MirTypeDef], ty: Type, disc: Int) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then verifier_downcast_type(type_index, &inner, disc)
  when Type::Adt(tid, _) then
    match verifier_type_def(type_index, tid.id)
    when Option::Some(td) then
      match td.kind
      when MirTypeDefKind::Enum(variants) then
        var vi = 0
        while vi < variants.len() do
          if variants[vi].discriminant == disc then
            return Option::Some(Type::Tuple(variants[vi].fields.clone()))
          end
          vi = vi + 1
        end
        Option::None
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def verifier_elem_type(type_index: Map[Int, MirTypeDef], ty: Type) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then verifier_elem_type(type_index, &inner)
  when Type::FixedArray(elem, _) then Option::Some(elem.clone())
  when Type::Adt(tid, args) then
 # (Type collapse): the canonical Array/Slice arms are gone — the
    # Adt form of Array/Slice is selected by the registered name (the
    # verifier's type_index is the id -> MirTypeDef name table).
    let nname = match type_index.get(tid.id)
    when Option::Some(td) then mir_bare_type_name(&td.name)
    when Option::None then ""
    end
    if (nname == "Array" || nname == "Slice" || nname == "Vec") && !args.is_empty() then
      Option::Some(args[0].clone())
    else
      Option::None
    end
  when Type::String then Option::Some(Type::U8)
  when _ then Option::None
  end
end

# (items 58/60): the NAMED TypeId a FieldId.owner is compared
# against — mirrors the MIR-side unwrap_to_named_tid (peels refs/pointers;
# the Adt forms of Box/Rc/Option recurse into args[0], so a field access on
# Box[T] — whose FieldId.owner is the INNER struct's TypeId, exactly as the
# type checker's field_target_of records it — matches the projected type).
def verifier_named_tid(type_index: Map[Int, MirTypeDef], ty: Type) -> Option[Int]
  match ty
  when Type::RefInternal(inner, _) then verifier_named_tid(type_index, inner)
  when Type::Ptr(inner) then verifier_named_tid(type_index, inner)
  when Type::PtrMut(inner) then verifier_named_tid(type_index, inner)
  when Type::Adt(tid, args) then
    let vn_name = match type_index.get(tid.id)
    when Option::Some(td) then mir_bare_type_name(&td.name)
    when Option::None then ""
    end
    if (vn_name == "Box" || vn_name == "Rc" || vn_name == "Option") && !args.is_empty() then
      verifier_named_tid(type_index, &args[0])
    else
      Option::Some(tid.id)
    end
  when _ then Option::None
  end
end

# (item 61) +: the raw Adt TypeId a VariantId.owner
# is compared against — the verifier-side mirror of the builder's
# mir_enum_owner_tid: peels ONLY refs/pointers, NEVER the Box/Rc/Option
# arg-unwrap of verifier_named_tid. A Variant projection's owner is the
# ENUM's TypeId itself (matching `Option::Some(x)` on an Option[Int]
# scrutinee must see the Option Adt's TypeId, not the unwrapped Int).
def verifier_enum_owner_tid(type_index: Map[Int, MirTypeDef], ty: Type) -> Option[Int]
  match ty
  when Type::RefInternal(inner, _) then verifier_enum_owner_tid(type_index, inner)
  when Type::Ptr(inner) then verifier_enum_owner_tid(type_index, inner)
  when Type::PtrMut(inner) then verifier_enum_owner_tid(type_index, inner)
  when Type::Adt(tid, _) then Option::Some(tid.id)
  when _ then Option::None
  end
end

# (item 60): resolve a field's type BY ITS FieldId (owner TypeId +
# index) — the ID-based counterpart of verifier_field_type. The owner must
# equal the projected type's Adt TypeId; anything else (wrong owner, index
# out of range, non-struct def) is unresolvable (Option::None → the caller
# reports the invalid projection chain / owner mismatch).
def verifier_field_type_at(type_index: Map[Int, MirTypeDef], ty: Type, owner_id: Int, index: Int) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then verifier_field_type_at(type_index, inner, owner_id, index)
  when Type::Tuple(fields) then
    if index >= 0 && index < fields.len() then Option::Some(fields[index].clone()) else Option::None end
  when Type::Adt(tid, args) then
    if tid.id == owner_id then
      match verifier_type_def(type_index, tid.id)
      when Option::Some(td) then
        match td.kind
        when MirTypeDefKind::Struct(fields) then
          # The field's DECLARED type is substituted under the concrete Adt
          # args (subst_type_args — the same substituted-field computation
          # layout_engine's substitute_mir_fields performs), so a generic
          # field that becomes String after substitution types as the
          # CONCRETE String here.
          if index >= 0 && index < fields.len() then
            Option::Some(subst_type_args(&fields[index].ty, &td.generic_params, args))
          else
            Option::None
          end
        when _ then Option::None
        end
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when _ then Option::None
  end
end

# (item 61): resolve a variant payload BY ITS VariantId (owner TypeId
# + variant index) — the ID-based counterpart of verifier_downcast_type.
# The owner must equal the projected type's Adt TypeId and the index must
# name a declared variant of that enum.
def verifier_downcast_type_at(type_index: Map[Int, MirTypeDef], ty: Type, vid: VariantId) -> Option[Type]
  match ty
  when Type::RefInternal(inner, _) then verifier_downcast_type_at(type_index, inner, vid)
  when Type::Adt(tid, args) then
    if tid.id == vid.owner.id then
      match verifier_type_def(type_index, tid.id)
      when Option::Some(td) then
        match td.kind
        when MirTypeDefKind::Enum(variants) then
          if vid.index as Int < variants.len() then
            # The variant's DECLARED payload is substituted under the
            # concrete Adt args (subst_type_args — the same substituted-
            # variant computation layout_engine's substitute_mir_variants
            # performs), so a generic payload that becomes String after
            # substitution types as the CONCRETE String here.
            var payload = Vec::new()
            var fvi = 0
            while fvi < variants[vid.index as Int].fields.len() do
              payload.push(subst_type_args(&variants[vid.index as Int].fields[fvi], &td.generic_params, args))
              fvi = fvi + 1
            end
            Option::Some(Type::Tuple(payload))
          else
            Option::None
          end
        when _ then Option::None
        end
      when Option::None then Option::None
      end
    else
      Option::None
    end
  when _ then Option::None
  end
end

def verifier_project_type(type_index: Map[Int, MirTypeDef], cur: Type, proj: Projection) -> Option[Type]
  match proj
  when Projection::ProjDeref then
    match verifier_strip_pointee(type_index, cur)
    when Option::Some(inner) then Option::Some(inner)
    when Option::None then Option::None
    end
 # EVERY projection is semantic — the typed forms resolve by their
  # IDs (Field(FieldId) by owner/index — with the post-downcast TUPLE
  # payload indexed positionally, since tuples have no FieldId — and
  # Variant(VariantId) by the typed variant table); TupleIndex indexes a
  # tuple. An owner that does not match the projected type yields
  # Option::None here (the chain-level error), and verifier_check_place
  # additionally reports the owner mismatch explicitly.
  when Projection::Field(fid) then verifier_field_type_at(type_index, cur, fid.owner.id, fid.index)
  when Projection::Variant(vid) then verifier_downcast_type_at(type_index, cur, vid)
  when Projection::TupleIndex(index) then verifier_field_type(type_index, cur, index)
  when Projection::ProjIndex(_) then verifier_elem_type(type_index, cur)
  when Projection::ProjConstantIndex(_) then verifier_elem_type(type_index, cur)
  end
end

def verifier_place_type(type_index: Map[Int, MirTypeDef], base: Type, projections: Vec[Projection]) -> Option[Type]
  var cur = base.clone()
  var pidx = 0
  while pidx < projections.len() do
    let next_opt = verifier_project_type(type_index, &cur, projections[pidx].clone())
    match next_opt
    when Option::Some(t) then cur = t
    when Option::None then return Option::None
    end
    pidx = pidx + 1
  end
  Option::Some(cur)
end

# ———————————————————————————————————————————————————————————————
# Operand / rvalue / constant typing
# ———————————————————————————————————————————————————————————————

def verifier_constant_type(cst: MirConstant) -> Option[Type]
  match cst.kind
  when MirConstantKind::MirUnit then Option::Some(Type::Unit)
  when MirConstantKind::MirBool(_) then Option::Some(Type::Bool)
  when MirConstantKind::MirInt(_) then Option::Some(Type::Int)
  when MirConstantKind::MirFloat(_) then Option::Some(Type::Float)
  when MirConstantKind::MirChar(_) then Option::Some(Type::Char)
  when MirConstantKind::MirString(_) then Option::Some(Type::String)
  when MirConstantKind::MirFnItem(_) then Option::Some(Type::Unit)
  when MirConstantKind::MirZeroSized then Option::Some(Type::Unit)
  when MirConstantKind::MirStaticRef(_) then Option::Some(Type::Unit)
  when MirConstantKind::MirStaticAddr(_) then Option::Some(Type::Unit)
  when _ then Option::None
  end
end

# THE single place-type routine for all MIR verification: the type of a
# place IS the type of its projected value. The root local's type is only
# the START — every projection substitutes the next type (Field(FieldId) ->
# the owner def's field type under the concrete args, Variant(VariantId) ->
# the variant's payload tuple, TupleIndex -> the tuple element, ProjIndex /
# ProjConstantIndex -> the fixed-array / Vec element, ProjDeref -> the
# pointee). The copy-safety backstop (verifier_check_operand_ownership) and
# every operand-type consumer decide on THIS walked type — a MirCopy of
# `container.field[index].owned_member` is judged by the owned_member type,
# never by the container's. An unresolvable chain yields Option::None (the
# chain-level error is reported by verifier_check_place).
def verifier_place_result_type_opt(type_index: Map[Int, MirTypeDef], func: MirFunction, place: Place) -> Option[Type]
  match verifier_local_type(func, place.local.id)
  when Option::Some(base) then
    if place.projections.len() > 0 then
      verifier_place_type(type_index, &base, &place.projections)
    else
      Option::Some(base)
    end
  when Option::None then Option::None
  end
end

def verifier_check_place(type_index: Map[Int, MirTypeDef], func: MirFunction, place: Place, running: Set[Int], ctx: String, inout errors: Vec[String]) -> Unit
  let pid = place.local.id
  let base_ty = match verifier_local_type(func, pid)
  when Option::Some(t) then t
  when Option::None then
    errors.push(ctx.clone() + ": place references undefined local _" + pid.to_string())
    return
  end
  if !running.contains(&pid) then
    errors.push(ctx.clone() + ": use of possibly-uninitialized local _" + pid.to_string())
  end
  # Validate the projection chain is well-typed.
  if place.projections.len() > 0 then
    match verifier_place_type(type_index, &base_ty, &place.projections)
    when Option::Some(_) then ()
    when Option::None then
      errors.push(ctx.clone() + ": invalid projection chain on local _" + pid.to_string())
    end
  end
 # (items 58/60) +: every Field
  # projection's FieldId.owner must match the projected type's TypeId, and
  # every Variant projection's VariantId.owner must match the projected
  # type's TypeId — the mechanical owner checks that make the semantic
  # projection chains verifiable. A FieldId landing on a TUPLE is a
  # post-downcast payload field: its owner is the ENUM (already checked
  # through the preceding VariantId), so the owner check is skipped for
  # tuples and the chain walk validates the index positionally. The
  # name/discriminant forms (ProjField / ProjFieldIndex / ProjDowncast) are
 # is not part of the model — every projection in the IR is semantic by construction.
  var cur_ty = base_ty
  var pidx_v = 0
  while pidx_v < place.projections.len() do
    match place.projections[pidx_v]
    when Projection::Field(fid) then
      match cur_ty
      when Type::Tuple(_) then ()
      when _ then
        match verifier_named_tid(type_index, &cur_ty)
        when Option::Some(cur_tid) then
          if cur_tid != fid.owner.id then
            errors.push(ctx.clone() + ": FieldId.owner " + fid.owner.id.to_string() + " does not match the projected type's TypeId " + cur_tid.to_string() + " on local _" + pid.to_string())
          end
        when Option::None then
          errors.push(ctx.clone() + ": FieldId projection on a non-nominal type on local _" + pid.to_string())
        end
      end
    when Projection::Variant(vid) then
      # The VariantId.owner is the ENUM's TypeId itself (no Box/Rc/Option
      # arg-unwrap — verifier_enum_owner_tid peels only refs/pointers).
      match verifier_enum_owner_tid(type_index, &cur_ty)
      when Option::Some(cur_tid) then
        if cur_tid != vid.owner.id then
          errors.push(ctx.clone() + ": VariantId.owner " + vid.owner.id.to_string() + " does not match the projected type's TypeId " + cur_tid.to_string() + " on local _" + pid.to_string())
        end
      when Option::None then
        errors.push(ctx.clone() + ": VariantId projection on a non-nominal type on local _" + pid.to_string())
      end
    when _ then ()
    end
    # Advance the current type through this projection so chained
    # projections check against the type each step produces.
    match verifier_project_type(type_index, &cur_ty, place.projections[pidx_v].clone())
    when Option::Some(t) then cur_ty = t
    when Option::None then ()
    end
    pidx_v = pidx_v + 1
  end
end

# Extract the place from a place-shaped operand (MirCopy/MirMovePlace);
# constants and other kinds yield an empty placeholder.
def operand_place(op: MirOperand) -> Place
  match op.kind
  when MirOperandKind::MirCopy(place) then place.clone()
  when MirOperandKind::MirMovePlace(place) then place.clone()
  when _ then Place { local: MirLocalId { id: -1 }, projections: Vec::new() }
  end
end

# Ref-ABI invariant (#7): flag a RefInternal-typed local used in a context
# where the reference would escape (stored into an aggregate or participating
# in an operation). Only BARE ref locals are flagged: an operand with
# projections (e.g. p.pos = a deref'd field read through the ref) is a
# legitimate value read, and plain call-argument reads are not flagged either
# (at ABI boundaries the codegen deref-copies the pointee value, so a ref
# argument does not escape).
def verifier_check_ref_operand(func: MirFunction, place: Place, what: String, ctx: String, inout errors: Vec[String]) -> Unit
  if place.local.id < 0 then return end
  if !place.projections.is_empty() then return end
  match verifier_local_type(func, place.local.id)
  when Option::Some(lt) then
    match lt
    when Type::RefInternal(_, _) then
      errors.push(ctx.clone() + ": value used as " + what.clone() + " (refs are internal ABI temporaries and must not escape into aggregates or operations)")
    when _ then ()
    end
  when Option::None then ()
  end
end

def verifier_check_operand(type_index: Map[Int, MirTypeDef], func: MirFunction, operand: MirOperand, running: Set[Int], inout moved: Map[Int, Set[String]], ctx: String, inout errors: Vec[String]) -> Option[Type]
  match operand.kind
  when MirOperandKind::MirCopy(place) then
 # (the BITCOPY form): a MirCopy is a bitwise copy — its LEGALITY
    # (the copy-permission sites — value operands, Read call args) is
    # checked separately by verifier_check_operand_ownership against the
    # engine's is_trivially_copyable axis. The moved-state check is the
    # projection-aware place-key rule: a copy of a moved place (exact,
    # prefix, whole-root, or whole-value boundary) is a use-after-move.
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    let _ = verifier_place_result_type_opt(type_index, func, &place)
    let ckey = verifier_place_key(type_index, &place)
    if verifier_key_moved(moved, place.local.id, &ckey) then
      errors.push(ctx.clone() + ": copy of previously moved place " + verifier_moved_place_desc(&place, &ckey))
    end
  when MirOperandKind::MirMovePlace(place) then
 # (the TRANSFER form): MirMovePlace moves the value out of the
    # source place — legal for ANY type (owning or not); the moved-tracking
    # below enforces single use, so no copy-legality check applies.
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    let _ = verifier_place_result_type_opt(type_index, func, &place)
    # A moved value transitions out of initialized into moved; moving a value
    # that was already moved is a use-after-move. The moved-state is the
    # projection-aware place-key lattice: a move of x.a marks (x, "a")
    # moved (x.b and the whole root stay the checker's live-partial rules),
    # a move of the whole root x shadows every chain.
    let base = place.local.id
    let mkey = verifier_place_key(type_index, &place)
    if verifier_key_moved(moved, base, &mkey) then
      errors.push(ctx.clone() + ": use-after-move of local _" + base.to_string() + verifier_moved_key_desc(&mkey))
    else
      verifier_key_insert(&mut moved, base, &mkey)
    end
  when MirOperandKind::MirRead(place) then
 # (the READ form): a read accesses the place WITHOUT transferring
    # ownership and WITHOUT forming a bitcopy permission — the sharing
    # semantics are the checker's safe-access model; the verifier enforces
    # definiteness and consumed-place tracking (reads of consumed places
    # are errors), never copy legality. The consumed check is the
    # projection-aware place-key rule: a read of x.b after x.a was moved is
    # legal; a read of the whole root after a partial move is an error.
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    let rbase = place.local.id
    let rkey = verifier_place_key(type_index, &place)
    if verifier_key_moved(moved, rbase, &rkey) then
      errors.push(ctx.clone() + ": read of previously consumed local _" + rbase.to_string() + verifier_moved_key_desc(&rkey))
    end
    let _ = verifier_place_result_type_opt(type_index, func, &place)
  when MirOperandKind::MirConsume(place) then
 # (the TRANSFER form): MirConsume transfers ownership exactly like
    # MirMovePlace (closure Consume captures, sink glue) — legal for ANY
    # type; the consumed-tracking below enforces single use, no copy-
    # legality check applies. MirConsume sources cannot be previously
    # consumed. The source place transitions out of initialized into
    # consumed, and any LATER use of the same place-key (or a chain it
    # shadows — the projection-aware lattice below) in this block (or in
    # blocks reached through the may-moved dataflow) is an error.
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    let _ = verifier_place_result_type_opt(type_index, func, &place)
    let cbase = place.local.id
    let ckey2 = verifier_place_key(type_index, &place)
    if verifier_key_moved(moved, cbase, &ckey2) then
      errors.push(ctx.clone() + ": consume of previously consumed local _" + cbase.to_string() + verifier_moved_key_desc(&ckey2))
    else
      verifier_key_insert(&mut moved, cbase, &ckey2)
    end
  when MirOperandKind::MirConstant(cst) then
    verifier_constant_type(&cst)
  end
end

# The place description for the moved-state diagnostics: the serialized
# key (whole root / whole-value boundary / the field path).
def verifier_moved_key_desc(key: String) -> String
  if key == "" then return " (whole value)" end
  if key == "*" then return " (whole-value place)" end
  " (field \"" + key + "\")"
end

def verifier_moved_place_desc(place: Place, key: String) -> String
  "local _" + place.local.id.to_string() + verifier_moved_key_desc(key)
end

# ———————————————————————————————————————————————————————————————
# ownership / consumed / concreteness / callee invariants
# ———————————————————————————————————————————————————————————————
# Whether an operand's kind carries a place (vs a pure constant value) —
# used by the MirCallArg-effect form checks below.
def verifier_operand_carries_place(op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirCopy(_) then true
  when MirOperandKind::MirMovePlace(_) then true
  when MirOperandKind::MirRead(_) then true
  when MirOperandKind::MirConsume(_) then true
  when MirOperandKind::MirConstant(_) then false
  end
end

# Whether a deinit plan contains real cleanup (registered finalizers,
# allocation releases) or fails closed (PlanLimit). Structural containers
# (Aggregate/Tuple/Enum/Option/Result/Array/Set/Map) contain cleanup exactly
# when a CHILD plan does — this is the plan-tree containment test for the
# drop-GLUE axis (builder_local_is_resource's consumed-local tracking).
# It is NOT a copy-legality rule: the Copy verifier queries the engine's
# is_trivially_copyable instead (a Trivial plan says nothing about
# bit-copy safety — String's destructor plan (DeinitPlan::String) is real
# cleanup yet String is not trivially copyable).
def verifier_plan_contains_ownership(plan: DeinitPlan) -> Bool
  match plan
  when DeinitPlan::Trivial then false
  when DeinitPlan::Call(_) then true
  when DeinitPlan::UserFinalizer(_, _) then true
  when DeinitPlan::Box(_) then true
  when DeinitPlan::PlanLimit then true
 # (the recursion-break marker): a SelfRecursive edge OWNS — the
  # position's destruction delegates to the concrete type's own drop glue.
  when DeinitPlan::SelfRecursive then true
 # (FAIL-CLOSED): a Deferred position MAY own (the unsubstituted
  # generic is conservatively ownership-sensitive) — the containment test
  # answers true so a deferred-position local is never treated as
  # destruction-free.
  when DeinitPlan::Deferred then true
  when DeinitPlan::Aggregate(plans) then
    var ai = 0
    while ai < plans.len() do
      if verifier_plan_contains_ownership(&plans[ai]) then return true end
      ai = ai + 1
    end
    false
  when DeinitPlan::Enum(vmap) then
    for (_, vinfo) in vmap do
      let vplans = vinfo.1
      var vi = 0
      while vi < vplans.len() do
        if verifier_plan_contains_ownership(&vplans[vi]) then return true end
        vi = vi + 1
      end
    end
    false
  when DeinitPlan::Array(inner) then verifier_plan_contains_ownership(inner)
  when DeinitPlan::Set(inner) then verifier_plan_contains_ownership(inner)
  when DeinitPlan::Map(k, v) then verifier_plan_contains_ownership(k) || verifier_plan_contains_ownership(v)
  when DeinitPlan::Tuple(plans) then
    var ti = 0
    while ti < plans.len() do
      if verifier_plan_contains_ownership(&plans[ti]) then return true end
      ti = ti + 1
    end
    false
  when DeinitPlan::Option(inner) then verifier_plan_contains_ownership(inner)
  when DeinitPlan::Result(a, b) then verifier_plan_contains_ownership(a) || verifier_plan_contains_ownership(b)
 # (real String lifetime): the String destructor owns both the object
  # and its buffer — the plan contains ownership.
  when DeinitPlan::String then true
  end
end

# (THE COPY AUTHORITY): the Copy-legality rule is the ENGINE's
# canonical is_trivially_copyable answer — type_properties_of over the MIR's
# engine snapshot env (MirProgram.engine_env — the typed program's
# serialized engine tables, the same snapshot deinit_plan_for_type queries),
# on the CONCRETE (TypeId, substs) identity (the engine memoizes per
# type_identity_key_resolved, so Wrapper[String] and Wrapper[Int] are
# distinct entries). The DeinitPlan is NEVER consulted for copyability: a
# type can require no physical destructor AND not be safely bit-copyable.
# Type::String is the canonical case — its drop plan is the real String
# destructor (DeinitPlan::String; requires_drop_glue=true) yet it owns a
# unique buffer and is
# Clone, NOT Copy: is_trivially_copyable(String)=false, and a bitwise copy
# of String (or a String-containing aggregate, or an aggregate containing
# such fields recursively — the engine walks the substituted fields) is a
# verifier error. Box/Rc, the heap containers, resources/capabilities and
# registered-drop types are never trivially copyable either, per the same
# engine answer.
# (the generic ownership policy — FAIL-CLOSED): a DEFERRED type
# (is_deferred — an unsubstituted Type::Param/Var in the graph) carries NO
# concrete answer, and the verifier answers NOT-copyable: unconstrained T
# is conservatively non-Copy ("T: Copy proves raw duplication" — only a
# proven Copy instantiation is bit-copyable). The pre-mono verifier thus
# rejects value copies of Param positions; the POST-MONO verifier
# re-validates is_trivially_copyable on the substituted concrete instances,
# where the definitive answer lives. The former fail-open (deferred
# answers copyable) is gone — a deferred answer NEVER degrades to
# "copyable".
def verifier_type_trivially_copyable(inout engine_env: TypeEnv, ty: Type) -> Bool
  let props = type_properties_of(engine_env, ty)
  if props.is_deferred then false else props.is_trivially_copyable end
end

# MirCopy of a non-trivially-copyable type in a VALUE position is a
# verifier error. Value positions are where a bitwise copy would alias
# owning state WITHOUT transferring ownership: binary/unary/cast/repeat
# operands, switch/assert operands, and Read-effect call-argument values.
# EXEMPT (documented):
#   - MirMove(MirCopy(p)) — the lowering's MOVE representation (ownership
#     transfer; the source is dead, and the moved-tracking below enforces
#     single use). Exempting it is REQUIRED: the compiler's own MIR moves
#     Vec/Box/String values through this form.
#   - MirCallArg values with Modify/Initialize/Consume effects — the ABI
#     inout/sink forms (the compiler's own deinit glue passes owning
#     containers as Modify + Value(MirCopy(place))).
#   - MirAggregate operands — aggregate construction (array literals,
#     struct/variant construction, closure captures) is the sanctioned
#     ownership-transfer point: the operand's MirCopy form is the
#     by-value temp/capture transfer (the source temp was move-initialized
#     and the CHECKER consumed the semantic source — the frame-level
#     consumption tracking is the duplication guard), so the copies inside
#     an aggregate are transfers, never duplicate ownership.
# This scope is the conservative approximation that keeps the verifier from
# rejecting the compiler's own (valid) MIR while still flagging genuine
# bitwise copies of non-copyable values. The copy-acceptance test is
# verifier_type_trivially_copyable (— MirCopy only for
# Copy): the ENGINE's is_trivially_copyable axis — never the DeinitPlan.
def verifier_check_operand_ownership(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, operand: MirOperand, what: String, ctx: String, inout errors: Vec[String]) -> Unit
  match operand.kind
  when MirOperandKind::MirCopy(place) then
    match verifier_place_result_type_opt(type_index, func, &place)
    when Option::Some(pty) then
      if !verifier_type_trivially_copyable(engine_env, &pty) then
        errors.push(ctx.clone() + ": MirCopy of non-trivially-copyable type " + verifier_type_key(type_index, &pty) + " used as " + what.clone() + " (a bitwise copy of an owning type — String, a String-containing aggregate, or an aggregate containing such fields recursively — must be moved, consumed, or passed by place, never bit-copied)")
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

# MirCallArg.effect must agree with the operand form.
#   - Modify/Initialize args must be places (MirCallValue::Place or a
#     value operand carrying a place) — an inout/initialize slot, never a
#     constant.
#   - Consume args must be place operands (ownership transfer).
#   - Read args must NOT be MirCallValue::Place — they are value operands
#     (constants or place-carrying value copies are both legal at the ABI
#     boundary; the ownership rule above governs owning-value copies).
def verifier_check_call_arg_forms(args: Vec[MirCallArg], ctx: String, inout errors: Vec[String]) -> Unit
  var ai = 0
  while ai < args.len() do
    let arg = args[ai]
    match arg.value
    when MirCallValue::Place(_) then
      match arg.effect
      when AccessEffect::Read then
        errors.push(ctx.clone() + ": call arg " + ai.to_string() + " has Read effect but is a MirCallValue::Place (Read args must be value operands)")
      when _ then ()
      end
    when MirCallValue::Value(op) then
      match arg.effect
      when AccessEffect::Modify then
        if !verifier_operand_carries_place(&op) then
          errors.push(ctx.clone() + ": call arg " + ai.to_string() + " has Modify effect but is a constant value operand (Modify args must be places)")
        end
      when AccessEffect::Initialize then
        if !verifier_operand_carries_place(&op) then
          errors.push(ctx.clone() + ": call arg " + ai.to_string() + " has Initialize effect but is a constant value operand (Initialize args must be places)")
        end
      when AccessEffect::Consume then
        if !verifier_operand_carries_place(&op) then
          errors.push(ctx.clone() + ": call arg " + ai.to_string() + " has Consume effect but is a constant value operand (Consume args must be place operands)")
        end
      when AccessEffect::Read then ()
      end
    end
    ai = ai + 1
  end
end

# Type::Var must never reach concrete MIR, and Type::Param must not
# leak into CONCRETE (non-generic) functions. allow_param is true only when
# the enclosing function signature is itself generic (params/ret carry
# Type::Param), in which case Param in locals is the generic template's
# normal state. Type::Error must NEVER reach MIR (the type checker records
# Error only for already-rejected programs; verify_codegen_readiness
# rejects Error entries before lowering — an Error type here is the exact
# bug class the concreteness walk exists for). Every Named type must carry
# a canonical TypeId: id 0 is the documented generic-struct-field
# placeholder; any other id must key either the semantic deinit-plan table
# or a MirTypeDef (cross-universe ids are the exact bug class FIX 1
# removes).
def verifier_check_type_concreteness(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], what: String, ty: Type, allow_param: Bool, inout errors: Vec[String]) -> Unit
  match ty
  when Type::Var(_) then
    errors.push(what.clone() + ": Type::Var reaches concrete MIR")
  when Type::Param(gpid) then
    if !allow_param then
 # the parameter name comes from the param-name table (the
      # identity is the id; the name is display-only).
      let pname = generic_param_name_from(param_names, &gpid)
      errors.push(what.clone() + ": Type::Param(\"" + pname + "\") reaches concrete MIR (generic parameter leaked into a non-generic function)")
    end
  when Type::Error then
    errors.push(what.clone() + ": Type::Error reaches MIR (an error type must never lower — the compilation already rejected it)")
  when Type::Adt(tid, args) then
    if tid.id != 0 then
 # (plan-key fix): the plan-existence check keys by the CONCRETE
      # (TypeId, substs) identity (mir_type_identity_key) — the concrete
      # cache holds an entry for every concrete type in the MIR (the
      # pre-population walk) and a DEFERRED entry for Param-carrying shapes.
      let has_plan = match plans.get(mir_type_identity_key(ty))
      when Option::Some(_) then true
      when Option::None then false
      end
      let has_def = match type_index.get(tid.id)
      when Option::Some(_) then true
      when Option::None then false
      end
      if !has_plan && !has_def then
        errors.push(what.clone() + ": Named type with non-canonical TypeId " + tid.id.to_string() + " (id is in neither the semantic deinit-plan table nor the MIR type definitions)")
      end
    end
    var ai = 0
    while ai < args.len() do
      verifier_check_type_concreteness(plans, type_index, param_names, what, &args[ai], allow_param, errors)
      ai = ai + 1
    end
  when Type::FnPtr(params, ret, _) then
    var pi2 = 0
    while pi2 < params.len() do
      verifier_check_type_concreteness(plans, type_index, param_names, what, &params[pi2].ty, allow_param, errors)
      pi2 = pi2 + 1
    end
    verifier_check_type_concreteness(plans, type_index, param_names, what, &ret, allow_param, errors)
  when Type::Closure(_, params, ret, captures, _) then
    var pi3 = 0
    while pi3 < params.len() do
      verifier_check_type_concreteness(plans, type_index, param_names, what, &params[pi3].ty, allow_param, errors)
      pi3 = pi3 + 1
    end
    verifier_check_type_concreteness(plans, type_index, param_names, what, &ret, allow_param, errors)
    verifier_check_type_concreteness(plans, type_index, param_names, what, &captures, allow_param, errors)
  when Type::RefInternal(inner, _) then verifier_check_type_concreteness(plans, type_index, param_names, what, &inner, allow_param, errors)
  when Type::Ptr(inner) then verifier_check_type_concreteness(plans, type_index, param_names, what, &inner, allow_param, errors)
  when Type::PtrMut(inner) then verifier_check_type_concreteness(plans, type_index, param_names, what, &inner, allow_param, errors)
  when Type::Dyn(_) then ()
  when Type::Effect(_, inner) then verifier_check_type_concreteness(plans, type_index, param_names, what, &inner, allow_param, errors)
  when Type::Tuple(fields) then
    var ti = 0
    while ti < fields.len() do
      verifier_check_type_concreteness(plans, type_index, param_names, what, &fields[ti], allow_param, errors)
      ti = ti + 1
    end
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Embedded-types verification (+ extension)
# ———————————————————————————————————————————————————————————————
# The specialization/concreteness walk over the function's SIGNATURE
# (params/ret) and locals is extended here to every type EMBEDDED in the
# function body:
#   - every operand's constant type (MirConstant.ty — including the
#     MirFnItem callee signature types),
#   - every MirFnItem InstanceId substitution (the call signatures / the
#     deinit/drop instance payloads),
#   - the cast targets (MirCast's carried type),
#   - the aggregate element types (AggregateKind::MirArray's carried type,
#     the struct/closure/generator-aggregate TypeIds),
#   - the call arguments' constant types (via the operand walk),
#   - the projection OWNERS of every place in the body (FieldId.owner /
#     VariantId.owner must be canonical TypeIds), including the
#     MirDeinit terminator's destroyed place and the MirCall dest,
#   - the deinit instances (MirDeinit terminators): the destroyed place is
#     checked like every other place; the drop-glue NAME is a callable
#     identity checked by verifier_check_callees.
# No Type::Param / Type::Var / Type::Error may remain in ANY of them: a
# specialized instance is concrete and carries none (allow_param mirrors
# the signature concreteness — a generic template's body may legitimately
# carry its own Params, which monomorphization substitutes out).
def verifier_check_embedded_types(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], func: MirFunction, allow_param: Bool, inout errors: Vec[String]) -> Unit
  let fn_ctx = "fn " + func.name.clone()
  var bi = 0
  while bi < func.blocks.len() do
    let block = func.blocks[bi]
    let bb_ctx = fn_ctx.clone() + " bb" + block.id.id.to_string()
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        verifier_check_place_embedded_types(plans, type_index, param_names, &bb_ctx, &place, allow_param, errors)
        verifier_check_rvalue_embedded_types(plans, type_index, param_names, func, &bb_ctx, rvalue, allow_param, errors)
      when _ then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
      verifier_check_place_embedded_types(plans, type_index, param_names, &bb_ctx, &dest, allow_param, errors)
      verifier_check_operand_embedded_types(plans, type_index, param_names, func, &bb_ctx, callee, allow_param, errors)
      for arg in args do
        match arg.value
        when MirCallValue::Value(op) then verifier_check_operand_embedded_types(plans, type_index, param_names, func, &bb_ctx, &op, allow_param, errors)
        when MirCallValue::Place(pl) then verifier_check_place_embedded_types(plans, type_index, param_names, &bb_ctx, &pl, allow_param, errors)
        end
      end
    when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
      verifier_check_operand_embedded_types(plans, type_index, param_names, func, &bb_ctx, &op, allow_param, errors)
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      verifier_check_operand_embedded_types(plans, type_index, param_names, func, &bb_ctx, &cond, allow_param, errors)
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
 # (deinit instances): the destroyed place's projection owners are
      # checked like every other place (the local's own type is covered by
      # the signature/locals walk); the deinit INSTANCE is a semantic
      # identity checked by verifier_check_callees (it must be a registered
      # finalizer identity or a generated drop-glue function).
      verifier_check_place_embedded_types(plans, type_index, param_names, &bb_ctx, &place, allow_param, errors)
    when _ then ()
    end
    bi = bi + 1
  end
end

# (projection owners): every FieldId.owner / VariantId.owner in a place's
# projection chain must be a canonical TypeId — the same documented rule the
# Adt concreteness check applies to type occurrences (id 0 is the documented
# generic-struct-field placeholder; any other id must key the semantic
# deinit-plan table or a MirTypeDef).
def verifier_check_place_embedded_types(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], ctx: String, place: Place, allow_param: Bool, inout errors: Vec[String]) -> Unit
  for proj in place.projections do
    match proj
    when Projection::Field(fid) then
      let owner_what = ctx.clone() + " FieldId projection owner TypeId " + fid.owner.id.to_string()
      verifier_check_type_concreteness(plans, type_index, param_names, &owner_what, &Type::Adt(fid.owner.clone(), Vec::new()), allow_param, errors)
    when Projection::Variant(vid) then
      let owner_what = ctx.clone() + " VariantId projection owner TypeId " + vid.owner.id.to_string()
      verifier_check_type_concreteness(plans, type_index, param_names, &owner_what, &Type::Adt(vid.owner.clone(), Vec::new()), allow_param, errors)
    when _ then ()
    end
  end
end

def verifier_check_rvalue_embedded_types(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], func: MirFunction, ctx: String, rvalue: MirRvalue, allow_param: Bool, inout errors: Vec[String]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &operand, allow_param, errors)
  when MirRvalueKind::MirRef(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirRvalueKind::MirDiscriminant(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirRvalueKind::MirLen(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &lhs, allow_param, errors)
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &rhs, allow_param, errors)
  when MirRvalueKind::MirUnOp(_, operand) then
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &operand, allow_param, errors)
  when MirRvalueKind::MirCast(_, operand, ty) then
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &operand, allow_param, errors)
    let cast_what = ctx.clone() + " cast target"
    verifier_check_type_concreteness(plans, type_index, param_names, &cast_what, &ty, allow_param, errors)
  when MirRvalueKind::MirRepeat(operand, _) then
    verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &operand, allow_param, errors)
  when MirRvalueKind::MirAggregate(kind, operands) then
    match kind
    when AggregateKind::MirArray(arr_ty) then
      let arr_what = ctx.clone() + " array aggregate element type"
      verifier_check_type_concreteness(plans, type_index, param_names, &arr_what, &arr_ty, allow_param, errors)
    when AggregateKind::Struct(tid, _) then
      let st_what = ctx.clone() + " struct aggregate type"
      verifier_check_type_concreteness(plans, type_index, param_names, &st_what, &Type::Adt(tid.clone(), Vec::new()), allow_param, errors)
    when AggregateKind::Closure(_) then
 # (ClosureId-keyed aggregate): the closure aggregate's type is
      # registered by its ClosureId — there is no Adt def to check; the
      # operands' embedded types are checked by the walk below.
      ()
    when AggregateKind::Generator(gid) then
      let gen_what = ctx.clone() + " generator aggregate type"
      verifier_check_type_concreteness(plans, type_index, param_names, &gen_what, &Type::Adt(gid.clone(), Vec::new()), allow_param, errors)
    when AggregateKind::Tuple then ()
    end
    for op in operands do
      verifier_check_operand_embedded_types(plans, type_index, param_names, func, ctx, &op, allow_param, errors)
    end
  when _ then ()
  end
end

def verifier_check_operand_embedded_types(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], func: MirFunction, ctx: String, op: MirOperand, allow_param: Bool, inout errors: Vec[String]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    # Every MirConstant carries its type: the MirFnItem signature types
    # (Type::Closure/FnPtr), the value types of the primitive constants.
    let cst_what = ctx.clone() + " constant type"
    verifier_check_type_concreteness(plans, type_index, param_names, &cst_what, &cst.ty, allow_param, errors)
    # The InstanceId substitutions of a MirFnItem — the call signatures and
    # the deinit/drop instance payloads: every substitution must be
    # concrete.
    match cst.instance
    when Option::Some(inst) then
      var si = 0
      while si < inst.substs.len() do
        let subst_what = ctx.clone() + " instance substitution " + si.to_string()
        verifier_check_type_concreteness(plans, type_index, param_names, &subst_what, &inst.substs[si], allow_param, errors)
        si = si + 1
      end
    when Option::None then ()
    end
  when MirOperandKind::MirCopy(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirOperandKind::MirMovePlace(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirOperandKind::MirRead(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  when MirOperandKind::MirConsume(place) then
    verifier_check_place_embedded_types(plans, type_index, param_names, ctx, &place, allow_param, errors)
  end
end

# (concrete-MIR statics): the embedded-types walk for a static initializer
# operand — constant types and InstanceId substitutions, under the same
# documented concreteness rule (a static is never a generic template, so
# allow_param is always false).
def verifier_check_static_embedded_types(plans: Map[String, DeinitPlan], type_index: Map[Int, MirTypeDef], param_names: Map[Int, String], ctx: String, op: MirOperand, inout errors: Vec[String]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    let cst_what = ctx.clone() + " static init constant type"
    verifier_check_type_concreteness(plans, type_index, param_names, &cst_what, &cst.ty, false, errors)
    match cst.instance
    when Option::Some(inst) then
      var si = 0
      while si < inst.substs.len() do
        let subst_what = ctx.clone() + " static init instance substitution " + si.to_string()
        verifier_check_type_concreteness(plans, type_index, param_names, &subst_what, &inst.substs[si], false, errors)
        si = si + 1
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

# callee resolution: a MirFnItem name must name a lowered function or
# a known intrinsic. The intrinsic set mirrors codegen's: the
# __intrinsic_ prefix, the _intrinsic suffix, and the bare names codegen
# inlines (clone/len/to_string/array_*/map_*/set_*/string_*/str_* and the
# bare collection methods). This list is the documented approximation of
# codegen's is_intrinsic/prefer_intrinsic sets.
#
# (the clone-aware record traversal): the __intrinsic_map_visit_* /
# __intrinsic_set_visit_* family (the NON-DESTRUCTIVE live-record walk
# behind entries_cloned / the set algebra / the snapshot iterators) is
# covered by the __intrinsic_ prefix rule below — the walk's returns are
# the projected key/value ADDRESSES (Option[&K] / &V words), never owned
# images, and the consumer clones through them with the concrete Clone
# instances (the read-then-clone shape: a projected READ followed by
# Clone; the lowering never emits a MirCopy or MirMovePlace of a map/set
# record slot — see the clone-call receiver construction at the method-
# call lowering, MirRef of the receiver place into the RefInternal temp).
def verifier_is_intrinsic_name(name: String) -> Bool
  if name.len() >= 12 && name.slice(0, 12) == "__intrinsic_" then return true end
  if name.len() >= 10 && name.slice(name.len() - 10, name.len()) == "_intrinsic" then return true end
  if name == "clone" || name == "to_string" || name == "len" || name == "drop" ||
     name == "str_concat" || name == "str_len" || name == "str_cmp" || name == "str_copy" ||
     name == "str_slice" || name == "str_find" || name == "str_to_int" || name == "str_to_float" ||
     name == "int_to_str" || name == "float_to_str" ||
     name == "int_to_string" || name == "uint_to_string" || name == "float_to_string" ||
     name == "bool_to_string" || name == "char_to_string" || name == "str_to_string" ||
     name == "string_from_bytes" || name == "string_new" || name == "string_clone" ||
     name == "read_file_to_string_native" || name == "cstring_new" || name == "cstring_as_ptr" ||
 # the owned String-object intrinsics (the String ABI —
     # string_* names dispatch to the String runtime, never the Array ABI)
     name == "string_push" || name == "string_push_str" || name == "string_reserve" ||
     name == "string_len" || name == "string_as_ptr" || name == "string_as_str" ||
     name == "string_from_static" ||
     name == "as_ptr" || name == "as_mut_ptr" || name == "as_str" || name == "as_bytes" || name == "bytes" ||
     name == "is_some" || name == "is_none" || name == "is_ok" || name == "is_err" ||
     name == "unwrap" || name == "unwrap_or" ||
     name == "starts_with" || name == "ends_with" || name == "contains" ||
     name == "push" || name == "pop" || name == "get" || name == "set" || name == "cap" ||
     name == "is_empty" || name == "first" || name == "last" || name == "insert" ||
     name == "remove" || name == "clear" || name == "reverse" || name == "sort" ||
     name == "extend" || name == "truncate" || name == "resize" || name == "keys" ||
     name == "values" || name == "entries" || name == "contains_key" || name == "get_mut" ||
     name == "join" || name == "collect" || name == "map" || name == "cmp" ||
     name == "chars" || name == "char_at" || name == "index_of" || name == "last_index_of" ||
     name == "find" || name == "rfind" || name == "split" || name == "lines" || name == "trim" ||
     name == "replace" || name == "slice" || name == "to_bits" || name == "from_bits" ||
     name == "parse_int" || name == "parse_float" || name == "to_lowercase" || name == "to_uppercase" ||
     name == "trim_matches" || name == "split_once" || name == "to_wide_string" ||
     name == "syscall1" || name == "syscall2" || name == "syscall3" || name == "syscall4" ||
     name == "syscall5" || name == "syscall6" ||
     name == "mem_alloc" || name == "mem_free" || name == "mem_copy" || name == "mem_set" || name == "mem_zero" ||
     name == "hash_int" || name == "hash_str" || name == "hash_combine" ||
     name == "emit" || name == "space" || name == "indent" || name == "dedent" ||
     name == "emit_newline" || name == "emit_blank_line" || name == "would_overflow" ||
     name == "status" || name == "output" || name == "stdout_string" || name == "stderr_string" ||
     name == "lint_file" || name == "to_int" || name == "eval" ||
     name == "array_new" || name == "array_push" || name == "array_pop" || name == "array_get" ||
     name == "array_set" || name == "array_len" || name == "array_cap" || name == "array_remove" ||
     name == "array_insert" || name == "array_clear" || name == "array_contains" ||
     name == "array_last" || name == "array_first" || name == "array_is_empty" ||
     name == "array_reverse" || name == "array_sort" || name == "array_extend" ||
     name == "array_truncate" || name == "array_resize" || name == "array_slice" ||
     name == "array_from_list" || name == "array_with_capacity" || name == "array_capacity" ||
     name == "array_as_ptr_address" || name == "array_as_str" || name == "array_replace" ||
     name == "array_clone" || name == "as_ptr_address" ||
     name == "map_new" || name == "map_insert" || name == "map_get" || name == "map_remove" ||
     name == "map_contains" || name == "map_len" || name == "map_clone" || name == "map_clear" ||
     name == "map_keys" || name == "map_values" || name == "map_entries" ||
     name == "map_contains_key" || name == "map_get_mut" || name == "map_push" ||
     name == "set_new" || name == "set_insert" || name == "set_contains" || name == "set_remove" ||
     name == "set_len" || name == "set_clone" || name == "set_clear" || name == "set_entries" ||
     name == "set_is_empty" ||
     name == "Vec__clone" || name == "Array__clone" || name == "Vec__to_string" ||
     name == "Array__to_string" || name == "Vec__read" || name == "Array__read" ||
     name == "Vec__join" || name == "Array__join" || name == "Vec__as_ptr" ||
     name == "Vec__as_mut_ptr" || name == "Vec__starts_with" || name == "Vec__ends_with" ||
     name == "String__clone" || name == "PanicInfo__clone" || name == "TypeExpr__clone" || name == "Span__clone" then
    return true
  end
  false
end

# callee check: every MirFnItem constant reachable from this function's
# statements and terminators must resolve to a lowered function or a known
# intrinsic. Extern functions are exempt (their bodies are empty by
# construction and their callees are external symbols). (deinit
# instances): a MirDeinit terminator's payload is a SEMANTIC InstanceId and
# must be a registered finalizer identity (collect_deinit_plan_instances)
# or a generated drop-glue function (drop_glue_fns membership).
def verifier_check_callees(func: MirFunction, fn_names: Set[String], deinit_instances: Set[Int], drop_glue_fns: Map[Int, String], ctx: String, inout errors: Vec[String]) -> Unit
  var bi = 0
  while bi < func.blocks.len() do
    let block = func.blocks[bi]
    let bb_ctx = ctx.clone() + " bb" + block.id.id.to_string()
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(_, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirMove(operand) then
          verifier_check_fnitem_operand(&operand, fn_names, &bb_ctx, errors)
        when MirRvalueKind::MirBinOp(_, lhs, rhs) then
          verifier_check_fnitem_operand(&lhs, fn_names, &bb_ctx, errors)
          verifier_check_fnitem_operand(&rhs, fn_names, &bb_ctx, errors)
        when MirRvalueKind::MirUnOp(_, operand) then
          verifier_check_fnitem_operand(&operand, fn_names, &bb_ctx, errors)
        when MirRvalueKind::MirCast(_, operand, _) then
          verifier_check_fnitem_operand(&operand, fn_names, &bb_ctx, errors)
        when MirRvalueKind::MirRepeat(operand, _) then
          verifier_check_fnitem_operand(&operand, fn_names, &bb_ctx, errors)
        when MirRvalueKind::MirAggregate(_, operands) then
          for op in operands do
            verifier_check_fnitem_operand(&op, fn_names, &bb_ctx, errors)
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
      verifier_check_fnitem_operand(&callee, fn_names, &bb_ctx, errors)
      for arg in args do
        match arg.value
        when MirCallValue::Value(op) then verifier_check_fnitem_operand(&op, fn_names, &bb_ctx, errors)
        when MirCallValue::Place(_) then ()
        end
      end
    when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
      verifier_check_fnitem_operand(&op, fn_names, &bb_ctx, errors)
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      verifier_check_fnitem_operand(&cond, fn_names, &bb_ctx, errors)
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
 # (deinit instances): the MirDeinit's payload must be a legal
      # destruction identity — a registered finalizer instance (the
      # deinit-plan identities) or a generated drop-glue function's
      # instance (drop_glue_fns) — a dangling identity would emit an
      # unresolvable cleanup call.
      let inst_key = def_id_numeric(&deinit_fn.def.def)
      if !deinit_instances.contains(&inst_key) && !drop_glue_fns.contains_key(&inst_key) then
        errors.push(bb_ctx.clone() + ": deinit instance is not a registered finalizer identity and not a generated drop-glue function")
      end
    when _ then ()
    end
    bi = bi + 1
  end
end

def verifier_check_fnitem_operand(operand: MirOperand, fn_names: Set[String], ctx: String, inout errors: Vec[String]) -> Unit
  match operand.kind
  when MirOperandKind::MirConstant(cst) then
    match cst.kind
    when MirConstantKind::MirFnItem(name) then
      if !fn_names.contains(&name) && !verifier_is_intrinsic_name(&name) then
        errors.push(ctx.clone() + ": callee '" + name.clone() + "' is not a lowered function and not a known intrinsic")
      end
    when _ then ()
    end
  when _ then ()
  end
end

def verifier_rvalue_type(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, rvalue: MirRvalue, running: Set[Int], inout moved: Map[Int, Set[String]], ctx: String, inout errors: Vec[String]) -> Option[Type]
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then
 # (assignment lowering / return-by-value): MirMove is the
    # ownership-TRANSFER form — the operand (MirCopy(p) — the lowering's
    # move representation — or MirMovePlace/MirConsume) flows INTO fresh
    # storage (a local, the return place, an aggregate slot) and the
    # source is dead; the moved/consumed tracking enforces single use. No
    # copy-legality check applies: a move of a non-trivially-copyable
    # value (String, Vec[..],...) is exactly the sanctioned transfer.
    verifier_check_operand(type_index, func, &operand, running, &mut moved, ctx, errors)
  when MirRvalueKind::MirRef(place) then
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    Option::None
  when MirRvalueKind::MirAggregate(kind, operands) then
 # (aggregate construction — the MirArray literal / struct /
    # variant / closure-env copies): aggregate operands are the sanctioned
    # ownership-transfer point (EXEMPT from the copy-legality check, per
    # the documented scope in verifier_check_operand_ownership): the
    # MirCopy operand form here is the by-value temp/capture transfer (the
    # operand temp was move-initialized; the CHECKER consumed the semantic
    # source — frame-level consumption tracking is the duplication guard).
    # MirMovePlace/MirConsume operands are explicit transfers.
    var ai = 0
    while ai < operands.len() do
      let _ = verifier_check_operand(type_index, func, &operands[ai], running, &mut moved, ctx, errors)
 # Ref-ABI invariant (#7): a RefInternal value must never be stored
      # INTO an aggregate (struct field / array element / tuple) — that is
      # the one way a reference can genuinely escape as a stored value.
      match operands[ai].kind
      when MirOperandKind::MirCopy(place) then
        verifier_check_ref_operand(func, &place, "aggregate operand", ctx, errors)
      when MirOperandKind::MirMovePlace(place) then
        verifier_check_ref_operand(func, &place, "aggregate operand", ctx, errors)
      when _ then ()
      end
      ai = ai + 1
    end
    verifier_aggregate_result_type(type_index, func, kind, &operands, ctx, errors)
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    let lty = verifier_check_operand(type_index, func, &lhs, running, &mut moved, ctx, errors)
    let _ = verifier_check_operand(type_index, func, &rhs, running, &mut moved, ctx, errors)
    verifier_check_ref_operand(func, &operand_place(&lhs), "binary op operand", ctx, errors)
    verifier_check_ref_operand(func, &operand_place(&rhs), "binary op operand", ctx, errors)
 # value computation must never bitwise-copy a non-trivially-
    # copyable value (the engine's is_trivially_copyable axis).
    let binop_what = "binary op operand"
    verifier_check_operand_ownership(engine_env, type_index, func, &lhs, &binop_what, ctx, errors)
    verifier_check_operand_ownership(engine_env, type_index, func, &rhs, &binop_what, ctx, errors)
    match lty
    when Option::Some(t) then Option::Some(t)
    when Option::None then Option::None
    end
  when MirRvalueKind::MirUnOp(_, operand) then
    verifier_check_operand(type_index, func, &operand, running, &mut moved, ctx, errors)
    verifier_check_ref_operand(func, &operand_place(&operand), "unary op operand", ctx, errors)
 # value computation must never bitwise-copy a non-trivially-
    # copyable value (the engine's is_trivially_copyable axis).
    let unop_what = "unary op operand"
    verifier_check_operand_ownership(engine_env, type_index, func, &operand, &unop_what, ctx, errors)
  when MirRvalueKind::MirDiscriminant(place) then
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    Option::Some(Type::Int)
  when MirRvalueKind::MirLen(place) then
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    Option::Some(Type::Int)
  when MirRvalueKind::MirCast(_, operand, ty) then
    let _ = verifier_check_operand(type_index, func, &operand, running, &mut moved, ctx, errors)
    verifier_check_ref_operand(func, &operand_place(&operand), "cast operand", ctx, errors)
 # value computation must never bitwise-copy a non-trivially-
    # copyable value (the engine's is_trivially_copyable axis).
    let cast_what = "cast operand"
    verifier_check_operand_ownership(engine_env, type_index, func, &operand, &cast_what, ctx, errors)
    Option::Some(ty)
  when MirRvalueKind::MirRepeat(operand, _) then
    let _ = verifier_check_operand(type_index, func, &operand, running, &mut moved, ctx, errors)
    verifier_check_ref_operand(func, &operand_place(&operand), "repeat operand", ctx, errors)
 # value computation must never bitwise-copy a non-trivially-
    # copyable value (the engine's is_trivially_copyable axis).
    let repeat_what = "repeat operand"
    verifier_check_operand_ownership(engine_env, type_index, func, &operand, &repeat_what, ctx, errors)
    Option::None
  when MirRvalueKind::MirPhi(entries) then
    var ei = 0
    var seen_preds: Set[Int] = Set::new()
    var phi_ty: Option[Type] = Option::None
    while ei < entries.len() do
      let pred_id = entries[ei].0.id
      let lid = entries[ei].1.id
      if seen_preds.contains(&pred_id) then
        errors.push(ctx.clone() + ": phi has duplicate predecessor bb" + pred_id.to_string())
      else
        seen_preds.insert(pred_id)
      end
      if !verifier_local_exists(func, lid) then
        errors.push(ctx.clone() + ": phi references undefined local _" + lid.to_string())
      else
        # All incoming values must have the same type; the destination type is
        # checked by the surrounding MirAssign via the returned phi type.
        match verifier_local_type(func, lid)
        when Option::Some(ity) then
          match phi_ty
          when Option::Some(pt) then
            if !verifier_types_compatible(type_index, &pt, &ity) then
              errors.push(ctx.clone() + ": phi incoming value type mismatch: " + verifier_type_key(type_index, &pt) + " vs " + verifier_type_key(type_index, &ity))
            end
          when Option::None then phi_ty = Option::Some(ity)
          end
        when Option::None then ()
        end
      end
      ei = ei + 1
    end
    phi_ty
  when _ then Option::None
  end
end

def verifier_operand_static_type(type_index: Map[Int, MirTypeDef], func: MirFunction, op: MirOperand) -> Option[Type]
  match op.kind
  when MirOperandKind::MirCopy(place) then verifier_place_result_type_opt(type_index, func, &place)
  when MirOperandKind::MirMovePlace(place) then verifier_place_result_type_opt(type_index, func, &place)
  when MirOperandKind::MirRead(place) then verifier_place_result_type_opt(type_index, func, &place)
  when MirOperandKind::MirConsume(place) then verifier_place_result_type_opt(type_index, func, &place)
  when MirOperandKind::MirConstant(cst) then verifier_constant_type(&cst)
  end
end

def verifier_operand_types(type_index: Map[Int, MirTypeDef], func: MirFunction, operands: Vec[MirOperand]) -> Vec[Type]
  var tys = Vec::new()
  var oi = 0
  while oi < operands.len() do
    match verifier_operand_static_type(type_index, func, &operands[oi])
    when Option::Some(t) then tys.push(t)
    when Option::None then tys.push(Type::Unit)
    end
    oi = oi + 1
  end
  tys
end

def verifier_aggregate_result_type(type_index: Map[Int, MirTypeDef], func: MirFunction, kind: AggregateKind, operands: Vec[MirOperand], ctx: String, inout errors: Vec[String]) -> Option[Type]
  match kind
  when AggregateKind::MirArray(arr_ty) then
    # The FixedArray-typed aggregate (the dest-aware array-literal path)
    # carries the FULL fixed-array type: the element-type check applies
    # against the element for EVERY operand (place operands included — the
 # aggregate layout invariant,: every aggregate operand
    # must match the concrete layout), the operand count must equal the
    # carried count, and the aggregate result IS the carried type.
    match arr_ty
    when Type::FixedArray(elem, n) then
      var ai = 0
      while ai < operands.len() do
        match verifier_operand_static_type(type_index, func, &operands[ai])
        when Option::Some(ot) then
          if !verifier_types_compatible(type_index, &elem, &ot) then
            errors.push(ctx.clone() + ": aggregate element type mismatch: expected " + verifier_type_key(type_index, &elem) + " got " + verifier_type_key(type_index, &ot))
          end
        when Option::None then ()
        end
        ai = ai + 1
      end
      if operands.len() != n then
        errors.push(ctx.clone() + ": fixed-array aggregate count mismatch: expected " + n.to_string() + " got " + operands.len().to_string())
      end
      Option::Some(arr_ty.clone())
    when _ then
      # The heap-vector aggregate (payload Unit — the generic array-literal
      # path): the aggregate's array type is the Adt form (the heap vector —
      # the fixed-array literals carry the full Type::FixedArray payload
      # above). The Array builtin has NO MirTypeDef (it is a
      # checker-registered Opaque builtin, never declared in the std), so
      # type_index cannot resolve its
      # LangItems id; when the scan misses, the assign-type check is SKIPPED
      # (Option::None) rather than emitting a bogus TypeId. Every operand
      # still must match the carried ELEMENT type (arr_ty is the element
      # type on this path — the aggregate layout invariant).
      var ai2 = 0
      while ai2 < operands.len() do
        match verifier_operand_static_type(type_index, func, &operands[ai2])
        when Option::Some(ot2) then
          if !verifier_types_compatible(type_index, &arr_ty, &ot2) then
            errors.push(ctx.clone() + ": aggregate element type mismatch: expected " + verifier_type_key(type_index, &arr_ty) + " got " + verifier_type_key(type_index, &ot2))
          end
        when Option::None then ()
        end
        ai2 = ai2 + 1
      end
      let arr_id = verifier_lang_item_id(type_index, "Array")
      if arr_id != -1 then
        Option::Some(Type::Adt(TypeId { id: arr_id }, Vec::from([arr_ty.clone()])))
      else
        Option::None
      end
    end
  when AggregateKind::Tuple then
    Option::Some(Type::Tuple(verifier_operand_types(type_index, func, operands)))
  when AggregateKind::Struct(tid, field_names) then
    match verifier_type_def(type_index, tid.id)
    when Option::Some(td) then
      # Validate the field-name vector against the declared struct layout:
      # every operand must name an existing field, names must be unique, the
      # count must match, and each operand's type must equal the field type.
      match td.kind
      when MirTypeDefKind::Struct(decl_fields) then
        if field_names.len() != operands.len() then
          errors.push(ctx.clone() + ": struct aggregate field count mismatch: names=" + field_names.len().to_string() + " operands=" + operands.len().to_string())
        end
        var seen: Set[String] = Set::new()
        var fi = 0
        while fi < field_names.len() do
          let fname = field_names[fi]
          if seen.contains(fname) then
            errors.push(ctx.clone() + ": struct aggregate duplicate field name '" + fname + "'")
          else
            seen.insert(fname.clone())
          end
          var declared: Option[Type] = Option::None
          var dj = 0
          while dj < decl_fields.len() do
            if decl_fields[dj].name == fname then
              declared = Option::Some(decl_fields[dj].field_type.clone())
            end
            dj = dj + 1
          end
          match declared
          when Option::Some(dty) then
            match verifier_operand_static_type(type_index, func, &operands[fi])
            when Option::Some(oty) then
              if !verifier_types_compatible(type_index, &dty, &oty) then
                errors.push(ctx.clone() + ": struct aggregate field '" + fname + "' type mismatch: expected " + verifier_type_key(type_index, &dty) + " got " + verifier_type_key(type_index, &oty))
              end
            when Option::None then ()
            end
          when Option::None then
            errors.push(ctx.clone() + ": struct aggregate unknown field '" + fname + "' for type " + tid.id.to_string())
          end
          fi = fi + 1
        end
      when _ then ()
      end
      Option::Some(Type::Adt(tid.clone(), Vec::new()))
    when Option::None then Option::None
    end
  when AggregateKind::Closure(_) then
    # Item 114 (closure carve-out): the closure aggregate's result type IS
    # the Type::FnPtr carried by its MirFnItem head operand (the lowering
    # always places the fn-item constant first) — matching the checker's
    # typed Closure entry that the destination local carries, so the
    # assign-type check agrees. Option::None (missing/non-fnitem head)
    # skips the assign-type check defensively.
    if operands.len() > 0 then
      match operands[0].kind
      when MirOperandKind::MirConstant(cst) then
        match cst.kind
        when MirConstantKind::MirFnItem(_) then Option::Some(cst.ty.clone())
        when _ then Option::None
        end
      when _ then Option::None
      end
    else
      Option::None
    end
  when AggregateKind::Generator(_) then Option::Some(Type::Unit)
  end
end

# ———————————————————————————————————————————————————————————————
# Call invariants
# ———————————————————————————————————————————————————————————————

def verifier_check_call(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, dest: Place, callee: MirOperand, args: Vec[MirCallArg], running: Set[Int], inout moved: Map[Int, Set[String]], ctx: String, inout errors: Vec[String]) -> Unit
  let callee_ty = verifier_check_operand(type_index, func, callee, running, &mut moved, ctx, errors)
  verifier_check_place(type_index, func, dest, running, ctx, errors)
 # the effect/operand-form agreement is checked on the RAW call args
  # (mir_call_arg_operand collapses Place to a copy operand and would hide
  # the distinction the invariant is about).
  verifier_check_call_arg_forms(args, ctx, errors)
  var arg_types = Vec::new()
  var ai = 0
  while ai < args.len() do
    let arg_op = mir_call_arg_operand(&args[ai])
    let at = verifier_check_operand(type_index, func, &arg_op, running, &mut moved, ctx, errors)
    match at
    when Option::Some(t) then arg_types.push(t)
    when Option::None then ()
    end
 # a Read-effect argument passed as a bitwise copy of a
    # non-trivially-copyable value is a verifier error (the callee does not
    # own the value; copying its bits would alias owning state).
    # Modify/Initialize/Consume args are exempt: they are the ABI
    # inout/sink forms the deinit glue itself uses.
    match args[ai].effect
    when AccessEffect::Read then
      match args[ai].value
      when MirCallValue::Value(op) then
        let arg_what = "call arg " + ai.to_string()
        verifier_check_operand_ownership(engine_env, type_index, func, &op, &arg_what, ctx, errors)
      when MirCallValue::Place(_) then ()
      end
    when _ then ()
    end
    ai = ai + 1
  end
  match callee_ty
  when Option::Some(cty) then
    match cty
    when Type::FnPtr(param_tys, _, _) then
      if param_tys.len() != args.len() then
        errors.push(ctx.clone() + ": call arg count mismatch: expected " + param_tys.len().to_string() + " got " + args.len().to_string())
      end
    when Type::Closure(_, param_tys, _, _, _) then
      if param_tys.len() != args.len() then
        errors.push(ctx.clone() + ": call arg count mismatch: expected " + param_tys.len().to_string() + " got " + args.len().to_string())
      end
      var i = 0
      while i < args.len() && i < param_tys.len() do
        if i < arg_types.len() then
          var expected_ty = param_tys[i].ty.clone()
          match args[i].value
          when MirCallValue::Place(_) then
            match verifier_strip_pointee(type_index, &expected_ty)
            when Option::Some(stripped) then expected_ty = stripped
            when Option::None then ()
            end
          when MirCallValue::Value(_) then ()
          end
          if !verifier_types_compatible(type_index, &expected_ty, &arg_types[i]) then
            errors.push(ctx.clone() + ": call arg " + i.to_string() + " type mismatch: expected " + verifier_type_key(type_index, &expected_ty) + " got " + verifier_type_key(type_index, &arg_types[i]))
          end
        end
        i = i + 1
      end
      match verifier_place_result_type_opt(type_index, func, dest)
      when Option::Some(dty) then
        if !verifier_types_compatible(type_index, &ret_ty, &dty) then
          errors.push(ctx.clone() + ": call dest type mismatch: expected " + verifier_type_key(type_index, &ret_ty) + " got " + verifier_type_key(type_index, &dty))
        end
      when Option::None then ()
      end
    when Type::Unit then ()
    when _ then
      # A concrete, resolved callee that is neither a function nor unit is a
      # non-callable callee — a verifier error, never silently accepted.
      errors.push(ctx.clone() + ": call to non-callable callee of type " + verifier_type_key(type_index, &cty))
    end
  when Option::None then ()
  end
end

def verifier_check_terminator(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, term: MirTerminator, running: Set[Int], inout moved: Map[Int, Set[String]], fn_effects: Map[String, Vec[EffectId]], ctx: String, inout errors: Vec[String]) -> Unit
  match term.kind
  when MirTerminatorKind::MirGoto(target) then
    if !verifier_block_exists(func, target.id) then
      errors.push(ctx.clone() + ": goto references invalid block bb" + target.id.to_string())
    end
  when MirTerminatorKind::MirReturn then ()
  when MirTerminatorKind::MirUnreachable then ()
  when MirTerminatorKind::MirAbort then ()
  when MirTerminatorKind::MirSwitchInt(op, targets, default_target) then
    let _ = verifier_check_operand(type_index, func, &op, running, &mut moved, ctx, errors)
 # switch discriminants are value computations — no non-copyable
    # copies.
    let switch_what = "switch discriminant"
    verifier_check_operand_ownership(engine_env, type_index, func, &op, &switch_what, ctx, errors)
    var ti = 0
    while ti < targets.len() do
      if !verifier_block_exists(func, targets[ti].target.id) then
        errors.push(ctx.clone() + ": switch references invalid block bb" + targets[ti].target.id.to_string())
      end
      ti = ti + 1
    end
    if !verifier_block_exists(func, default_target.id) then
      errors.push(ctx.clone() + ": switch fallback references invalid block bb" + default_target.id.to_string())
    end
  when MirTerminatorKind::MirCall { dest, func: callee, args, success, unwind, intrinsic } then
    verifier_check_call(engine_env, type_index, func, &dest, &callee, &args, running, &mut moved, ctx, errors)
    if !verifier_block_exists(func, success.id) then
      errors.push(ctx.clone() + ": call success references invalid block bb" + success.id.to_string())
    end
    match unwind
    when Option::Some(uw) then
      if !verifier_block_exists(func, uw.id) then
        errors.push(ctx.clone() + ": call unwind references invalid block bb" + uw.id.to_string())
      end
    when Option::None then ()
    end
    # (effect rule): a call to an effectful callee in a function without
    # the declared effect is a verifier error — the same rule as the
    # checker's, at the MIR level. The callee's declared effects come from
    # the callee's own MirFunction record (the lowering copied them from
    # the typed FnSignature records); an unknown callee (an intrinsic, a
    # closure value, a synthesized callee) carries none and never fires.
    var callee_name = ""
    match callee.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirFnItem(name) then callee_name = name.clone()
      when _ then ()
      end
    when _ then ()
    end
    if callee_name != "" then
      match fn_effects.get(callee_name.clone())
      when Option::Some(effs) then
        var ei = 0
        while ei < effs.len() do
          let eff = effs[ei]
          var declared_has = false
          var di2 = 0
          while di2 < func.declared_effects.len() do
            if func.declared_effects[di2].id == eff.id then declared_has = true end
            di2 = di2 + 1
          end
          if !declared_has then
            errors.push(ctx.clone() + ": call to effectful function " + callee_name.clone() + " requires a declared effect (the function declares none)")
          end
          ei = ei + 1
        end
      when Option::None then ()
      end
    end
  when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
    verifier_check_place(type_index, func, &place, running, ctx, errors)
    if !verifier_block_exists(func, target.id) then
      errors.push(ctx.clone() + ": deinit target references invalid block bb" + target.id.to_string())
    end
    match unwind
    when Option::Some(uw) then
      if !verifier_block_exists(func, uw.id) then
        errors.push(ctx.clone() + ": deinit unwind references invalid block bb" + uw.id.to_string())
      end
    when Option::None then ()
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    let _ = verifier_check_operand(type_index, func, &cond, running, &mut moved, ctx, errors)
 # assert conditions are value computations — no non-copyable
    # copies.
    let assert_what = "assert condition"
    verifier_check_operand_ownership(engine_env, type_index, func, &cond, &assert_what, ctx, errors)
    if !verifier_block_exists(func, target.id) then
      errors.push(ctx.clone() + ": assert target references invalid block bb" + target.id.to_string())
    end
    match unwind
    when Option::Some(uw) then
      if !verifier_block_exists(func, uw.id) then
        errors.push(ctx.clone() + ": assert unwind references invalid block bb" + uw.id.to_string())
      end
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Definite-initialization + storage-lifetime dataflow
# ———————————————————————————————————————————————————————————————

def verifier_set_equal(a: Set[Int], b: Set[Int]) -> Bool
  if a.len() != b.len() then return false end
  for v in a do
    if !b.contains(v) then return false end
  end
  true
end

def verifier_string_set_equal(a: Set[String], b: Set[String]) -> Bool
  if a.len() != b.len() then return false end
  for v in a do
    if !b.contains(v) then return false end
  end
  true
end

# ———————————————————————————————————————————————————————————————
# (partial moves — the projection-aware moved-state lattice)
# ———————————————————————————————————————————————————————————————
# The verifier's consumed/moved state is Map[Int, Set[String]] — root MIR
# local id -> the moved PLACE KEYS. A key is the SERIALIZED projection
# chain of a place: the checker's ProjectionChain serialization
# (place_move_path_of in types.tg — the shared key form) — the "."-joined
# declaration-order field names ("a.b"), tuple positions as "t<i>", the
# fixed-array constant indices as "<i>" (the checker's per-index
# ProjectionKey::Index lattice); the whole root is the empty key ""; a
# whole-value-boundary chain (a place whose chain contains a deref or a
# DYNAMIC index projection — the checker's bounded lattice) is the "*"
# key. The verifier's MIR-side place chains derive the same keys
# (verifier_place_key walks the MirProjection Field/Variant/TupleIndex/
# ProjConstantIndex forms exactly like the checker's ProjectionKey walk;
# Variant contributes no segment — the checker's place_move_path_of skips
# it).
#
# The overlap/prefix rules (a moved place shadows its prefixes and its
# extensions):
#   - a MirMovePlace(x.a) marks (x, "a") moved; a read of (x, "a") after
#     is the use-after-move error; a read of (x, "b") is legal (x.a !=
#     x.b while both overlap x); a read of (x, "a.b") (an extension) is an
#     error — the storage moved out with x.a; a read of (x, "") (the whole
#     root) after ANY partial move is an error — the partial root is not
#     fully live;
#   - a MirMovePlace(x) (the whole root) shadows ALL the chains: the ""
#     key is moved and every later read of any chain of x errors;
#   - a "*" move (a whole-value-boundary consume) shadows every read (the
#     checker's root-MaybeLive boundary — the per-index state is
#     indeterminate) but a "*" read is only an error when the root itself
#     or the boundary was moved (a sibling field move does not poison an
#     indexed read — the container elements are the checker's ownership
#     unit);
#   - a store into a place re-lives the place's chain and every extension
#     of it (verifier_key_clear), and a store into a FIELD chain of a
#     wholly-moved root ("" moved) is an error (the checker's Consumed-root
#     projected-assign rejection); the whole-root store itself re-lives
#     the whole root (the checker's reinitialization of a moved-out slot).

# Whether the chain `key` of the root is moved (the use-after-move /
# overlap rule above).
def verifier_key_moved(moved: Map[Int, Set[String]], root: Int, key: String) -> Bool
  match moved.get(root)
  when Option::Some(set) then
    if set.len() == 0 then return false end
    if key == "" then
      # The whole root: any moved chain under the root makes the whole
      # value use an error (the partial root is not fully live).
      return true
    end
    if key == "*" then
      # The whole-value boundary: only a whole-root move or a prior
      # whole-boundary move shadows it (the checker's check_use fallback —
      # the container elements are the ownership unit; a sibling
      # field/per-index move does not poison a boundary read).
      for m in set do
        if m == "" || m == "*" then return true end
      end
      return false
    end
    for m in set do
      if m == "" then return true end
      if m == "*" then return true end
      if m == key then return true end
      # A moved strict prefix shadows the extension (x.a moved makes the
      # x.a.b storage dead).
      if key.starts_with(m + ".") then return true end
    end
    false
  when Option::None then false
  end
end

# Insert a moved chain under the root (after the use-after-move check):
# the whole-root / whole-boundary move subsumes every prior chain; a field
# move subsumes its extensions (they are dead with it — the prefix rule
# keeps the lattice canonical).
def verifier_key_insert(inout moved: Map[Int, Set[String]], root: Int, key: String) -> Unit
  var set = match moved.get(root)
  when Option::Some(s) then s.clone()
  when Option::None then Set::new()
  end
  if key == "" || key == "*" then
    set = Set::new()
  else
    var keep = Set::new()
    for m in set do
      if !m.starts_with(key + ".") then
        keep.insert(m.clone())
      end
    end
    set = keep
  end
  set.insert(key)
  moved.insert(root, set)
end

# Clear a chain and every extension of it (a store into the place re-lives
# the chain; the whole-root / whole-boundary store clears the root's whole
# moved state).
def verifier_key_clear(inout moved: Map[Int, Set[String]], root: Int, key: String) -> Unit
  match moved.get(root)
  when Option::Some(set) then
    var keep = Set::new()
    if key == "" || key == "*" then
      if key == "" then
        # The whole-root store re-lives every chain.
        moved.remove(&root)
        return
      end
      for m in set do
        if m != "*" then
          keep.insert(m.clone())
        end
      end
    else
      for m in set do
        if m != key && !m.starts_with(key + ".") then
          keep.insert(m.clone())
        end
      end
    end
    if keep.len() > 0 then
      moved.insert(root, keep)
    else
      moved.remove(&root)
    end
  when Option::None then ()
  end
end

# Whether the root has ANY moved chain (the whole-root use rule — the
# partial root is not fully live).
def verifier_root_has_moves(moved: Map[Int, Set[String]], root: Int) -> Bool
  match moved.get(root)
  when Option::Some(set) then set.len() > 0
  when Option::None then false
  end
end

# The serialized PLACE KEY of a MIR place — the shared key form of the
# checker's ProjectionChain serialization (place_move_path_of). Field ->
# the FieldId's owner declaration-order field name (the MirTypeDef's
# Struct decl — the same declaration-order authority), TupleIndex -> "t<i>",
# Variant -> no segment (the checker's place_move_path_of skips variants),
# ProjConstantIndex -> "<i>" (the checker's per-index ProjectionKey::Index
# serialization — the fixed-array per-index lattice); a chain containing a
# deref or a DYNAMIC index projection is the whole-value-boundary key "*"
# (the checker's bounded lattice).
def verifier_place_key(type_index: Map[Int, MirTypeDef], place: Place) -> String
  if place.projections.len() == 0 then return "" end
  var segs = Vec::new()
  for proj in place.projections do
    match proj
    when Projection::Field(fid) then
      var fname = ""
      match verifier_type_def(type_index, fid.owner.id)
      when Option::Some(td) then
        match td.kind
        when MirTypeDefKind::Struct(fields) then
          if fid.index >= 0 && fid.index < fields.len() then
            fname = fields[fid.index].name.clone()
          end
        when _ then ()
        end
      when Option::None then ()
      end
      if fname.len() == 0 then
        fname = "f" + fid.index.to_string()
      end
      segs.push(fname)
    when Projection::Variant(_) then ()
    when Projection::TupleIndex(ti) then segs.push("t" + ti.to_string())
    when Projection::ProjConstantIndex(ci) then segs.push(ci.to_string())
    when _ then return "*"
    end
  end
  if segs.len() == 0 then return "*" end
  segs.join(".")
end

def block_map_lookup(func: MirFunction, bid: Int) -> Option[MirBlock]
  for b in func.blocks do
    if b.id.id == bid then return Option::Some(b.clone()) end
  end
  Option::None
end

def verifier_reachable_blocks(func: MirFunction) -> Set[Int]
  var reachable: Set[Int] = Set::new()
  var worklist = Vec::new()
  worklist.push(func.entry_block.id)
  while !worklist.is_empty() do
    let bid = match worklist.pop()
    when Option::Some(v) then v
    when Option::None then break
    end
    if reachable.contains(&bid) then next end
    reachable.insert(bid)
    match block_map_lookup(func, bid)
    when Option::Some(b) then
      let succs = terminator_successor_ids(&b.terminator)
      var si = 0
      while si < succs.len() do
        let sid = succs[si]
        if !reachable.contains(&sid) then worklist.push(sid) end
        si = si + 1
      end
    when Option::None then ()
    end
  end
  reachable
end

# Forward dataflow computing the definitely-initialized / storage-live locals
# on entry to every block, then a per-block linear pass that checks uses of
# possibly-uninitialized locals, projection typing, rvalue typing, and call
# invariants in program order.
def verifier_dataflow_init(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, fn_effects: Map[String, Vec[EffectId]], inout errors: Vec[String]) -> Unit
  let fn_ctx = "fn " + func.name.clone()
  let entry_id = func.entry_block.id

  var block_map: Map[Int, MirBlock] = Map::new()
  for b in func.blocks do
    block_map.insert(b.id.id, b.clone())
  end

  var all_local_ids = Vec::new()
  for p in func.params do
    all_local_ids.push(p.id.id)
  end
  for l in func.locals do
    all_local_ids.push(l.id.id)
  end

  var entry_init: Set[Int] = Set::new()
  for p in func.params do
    entry_init.insert(p.id.id)
  end

  var preds: Map[Int, Vec[Int]] = Map::new()
  for b in func.blocks do
    preds.insert(b.id.id, Vec::new())
  end
  for b in func.blocks do
    let succs = terminator_successor_ids(&b.terminator)
    var si = 0
    while si < succs.len() do
      let existing = match preds.get(succs[si])
      when Option::Some(list) then list.clone()
      when Option::None then Vec::new()
      end
      existing.push(b.id.id)
      preds.insert(succs[si], existing)
      si = si + 1
    end
  end

  var in_set: Map[Int, Set[Int]] = Map::new()
  var out_set: Map[Int, Set[Int]] = Map::new()
  in_set.insert(entry_id, entry_init.clone())

  var worklist = Vec::new()
  worklist.push(entry_id)
  var in_worklist: Set[Int] = Set::new()
  in_worklist.insert(entry_id)

  while !worklist.is_empty() do
    let bid = match worklist.pop()
    when Option::Some(v) then v
    when Option::None then break
    end
    in_worklist.remove(&bid)

    var new_in: Set[Int] = Set::new()
    if bid == entry_id then
      for p in entry_init do new_in.insert(p.clone()) end
    else
      let pred_list = match preds.get(bid)
      when Option::Some(l) then l.clone()
      when Option::None then Vec::new()
      end
      var first = true
      var pi = 0
      while pi < pred_list.len() do
        match out_set.get(pred_list[pi])
        when Option::Some(pset) then
          if first then
            new_in = Set::new()
            for v in pset do
              new_in.insert(v.clone())
            end
            first = false
          else
            var keep: Set[Int] = Set::new()
            for v in new_in do
              if pset.contains(v) then keep.insert(v.clone()) end
            end
            new_in = keep
          end
        when Option::None then ()
        end
        pi = pi + 1
      end
    end

    let block = match block_map.get(bid)
    when Option::Some(b) then b.clone()
    when Option::None then break
    end

    var out: Set[Int] = Set::new()
    for v in new_in do out.insert(v.clone()) end
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(place, _) then out.insert(place.local.id)
      when MirStatementKind::MirStorageLive(local) then out.insert(local.id)
      when MirStatementKind::MirStorageDead(local) then out.remove(&local.id)
      when _ then ()
      end
    end

    let old = match in_set.get(bid)
    when Option::Some(s) then s.clone()
    when Option::None then Set::new()
    end
    let had_out = match out_set.get(bid)
    when Option::Some(_) then true
    when Option::None then false
    end
    let changed = !had_out || !verifier_set_equal(&old, &new_in)
    in_set.insert(bid, new_in.clone())
    out_set.insert(bid, out)

    if changed then
      let succs2 = terminator_successor_ids(&block.terminator)
      var s2 = 0
      while s2 < succs2.len() do
        let sid = succs2[s2]
        if !in_worklist.contains(&sid) then
          in_worklist.insert(sid)
          worklist.push(sid)
        end
        s2 = s2 + 1
      end
    end
  end

  # Per-block linear pass.  Unreachable blocks (left by optimizations) are
  # checked structurally with all locals treated as initialized to avoid
  # spurious definite-init errors; reachable blocks use the computed in-set.
  let reachable = verifier_reachable_blocks(func)
  # Cross-block moved-state dataflow (may-moved per block IN set — the
  # projection-aware Map[Int, Set[String]] place-key lattice).
  let moved_in_map = verifier_compute_moved_dataflow(&type_index, func, &block_map, &preds, entry_id)

  # Phi edge validation: each Phi must have exactly one incoming value per CFG
  # predecessor (no duplicate/foreign predecessor ids), and the incoming local
  # must be definitely initialized at that predecessor's OUT set.
  var bi2 = 0
  while bi2 < func.blocks.len() do
    let b2 = func.blocks[bi2]
    let bid2 = b2.id.id
    let bb_ctx2 = fn_ctx.clone() + " bb" + bid2.to_string()
    let pred_list2 = match preds.get(bid2)
    when Option::Some(l) then l.clone()
    when Option::None then Vec::new()
    end
    for st2 in b2.statements do
      match st2.kind
      when MirStatementKind::MirAssign(_, rvalue2) then
        match rvalue2.kind
        when MirRvalueKind::MirPhi(entries2) then
          if entries2.len() != pred_list2.len() then
            errors.push(bb_ctx2.clone() + ": phi has " + entries2.len().to_string() + " entries but " + pred_list2.len().to_string() + " predecessors")
          end
          var pi2 = 0
          while pi2 < entries2.len() do
            let epred = entries2[pi2].0.id
            let elocal = entries2[pi2].1.id
            var is_pred = false
            var qi = 0
            while qi < pred_list2.len() do
              if pred_list2[qi] == epred then is_pred = true end
              qi = qi + 1
            end
            if !is_pred then
              errors.push(bb_ctx2.clone() + ": phi entry references non-predecessor bb" + epred.to_string())
            else
              # The incoming local must be initialized at that predecessor's OUT.
              match out_set.get(epred)
              when Option::Some(pset2) then
                if !pset2.contains(&elocal) then
                  errors.push(bb_ctx2.clone() + ": phi incoming local _" + elocal.to_string() + " not initialized on bb" + epred.to_string())
                end
              when Option::None then ()
              end
            end
            pi2 = pi2 + 1
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    bi2 = bi2 + 1
  end

  var bi = 0
  while bi < func.blocks.len() do
    let b = func.blocks[bi]
    let bid = b.id.id
    let bb_ctx = fn_ctx.clone() + " bb" + bid.to_string()
    let bin = if reachable.contains(&bid) then
      match in_set.get(bid)
      when Option::Some(s) then s.clone()
      when Option::None then Set::new()
      end
    else
      var t: Set[Int] = Set::new()
      for lid in all_local_ids do t.insert(lid.clone()) end
      t
    end
    let bmoved = match moved_in_map.get(bid)
    when Option::Some(s) then s.clone()
    when Option::None then Map::new()
    end
    verifier_check_block_stmts(engine_env, type_index, func, b, &bin, &bmoved, &fn_effects, &bb_ctx, errors)
    bi = bi + 1
  end
end

# Collect the place KEYS moved (consumed by value) by an rvalue's operands —
# the projection-aware form: a MirMovePlace/MirConsume of (x, [a]) records
# the key "a" under the root x (sibling chains stay live).
def verifier_operand_moved_target(type_index: Map[Int, MirTypeDef], op: MirOperand, inout out: Map[Int, Set[String]]) -> Unit
  match op.kind
  when MirOperandKind::MirMovePlace(place) then
    let key = verifier_place_key(type_index, &place)
    var set = match out.get(place.local.id)
    when Option::Some(s) then s.clone()
    when Option::None then Set::new()
    end
    set.insert(key)
    out.insert(place.local.id, set)
 # MirConsume transfers ownership exactly like MirMovePlace — a
  # consumed place must be tracked by the same may-moved dataflow so later
  # uses (in this block or a successor) are reported as consumed uses.
  when MirOperandKind::MirConsume(place) then
    let key2 = verifier_place_key(type_index, &place)
    var set2 = match out.get(place.local.id)
    when Option::Some(s) then s.clone()
    when Option::None then Set::new()
    end
    set2.insert(key2)
    out.insert(place.local.id, set2)
  when _ then ()
  end
end

def verifier_rvalue_moved_targets(type_index: Map[Int, MirTypeDef], rvalue: MirRvalue, inout out: Map[Int, Set[String]]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(operand) then verifier_operand_moved_target(type_index, &operand, out)
  when MirRvalueKind::MirAggregate(_, operands) then
    for op in operands do
      verifier_operand_moved_target(type_index, &op, out)
    end
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    verifier_operand_moved_target(type_index, &lhs, out)
    verifier_operand_moved_target(type_index, &rhs, out)
  when MirRvalueKind::MirUnOp(_, operand) then verifier_operand_moved_target(type_index, &operand, out)
  when MirRvalueKind::MirCast(_, operand, _) then verifier_operand_moved_target(type_index, &operand, out)
  when MirRvalueKind::MirRepeat(operand, _) then verifier_operand_moved_target(type_index, &operand, out)
  when _ then ()
  end
end

# Forward may-moved dataflow: a place key is "moved-in" to a block if ANY
# predecessor moved it and the block did not reinitialize it. This catches
# cross-block use-after-move (move in pred; use in successor). The state is
# the projection-aware Map[Int, Set[String]] lattice (root local -> moved
# place keys — the overlap/prefix rules of the lattice section above).
def verifier_compute_moved_dataflow(type_index: Map[Int, MirTypeDef], func: MirFunction, block_map: Map[Int, MirBlock], preds: Map[Int, Vec[Int]], entry_id: Int) -> Map[Int, Set[String]]
  var moved_in: Map[Int, Set[String]] = Map::new()
  var moved_out: Map[Int, Set[String]] = Map::new()
  var entry_set: Set[String] = Set::new()
  moved_in.insert(entry_id, entry_set.clone())

  var worklist = Vec::new()
  worklist.push(entry_id)
  var in_worklist: Set[Int] = Set::new()
  in_worklist.insert(entry_id)

  while !worklist.is_empty() do
    let bid = match worklist.pop()
    when Option::Some(v) then v
    when Option::None then break
    end
    in_worklist.remove(&bid)

    var new_in: Map[Int, Set[String]] = Map::new()
    if bid != entry_id then
      let pred_list = match preds.get(bid)
      when Option::Some(l) then l.clone()
      when Option::None then Vec::new()
      end
      var pi = 0
      while pi < pred_list.len() do
        match moved_out.get(pred_list[pi])
        when Option::Some(pm) then
          for (pid, pset) in pm do
            var set = match new_in.get(pid)
            when Option::Some(s) then s.clone()
            when Option::None then Set::new()
            end
            for k in pset do
              set.insert(k.clone())
            end
            new_in.insert(pid, set)
          end
        when Option::None then ()
        end
        pi = pi + 1
      end
    end

    let block = match block_map.get(bid)
    when Option::Some(b) then b.clone()
    when Option::None then break
    end

    var out: Map[Int, Set[String]] = Map::new()
    for (pid, pset) in new_in do
      var set2 = Set::new()
      for k in pset do
        set2.insert(k.clone())
      end
      out.insert(pid, set2)
    end
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(place, rvalue) then
        verifier_rvalue_moved_targets(type_index, &rvalue, &mut out)
        # The store into the place re-lives the chain and its extensions.
        verifier_key_clear(&mut out, place.local.id, verifier_place_key(type_index, &place))
      when _ then ()
      end
    end

    let had = match moved_in.get(bid)
    when Option::Some(_) then true
    when Option::None then false
    end
    let old_in = match moved_in.get(bid)
    when Option::Some(s) then s.clone()
    when Option::None then Map::new()
    end
    let changed = !had || !verifier_moved_state_equal(&old_in, &new_in)
    moved_in.insert(bid, new_in.clone())
    moved_out.insert(bid, out)

    if changed then
      let succs2 = terminator_successor_ids(&block.terminator)
      var s2 = 0
      while s2 < succs2.len() do
        let sid = succs2[s2]
        if !in_worklist.contains(&sid) then
          in_worklist.insert(sid)
          worklist.push(sid)
        end
        s2 = s2 + 1
      end
    end
  end
  moved_in
end

# Map-level equality of the moved-state lattice (per-root set equality).
def verifier_moved_state_equal(a: Map[Int, Set[String]], b: Map[Int, Set[String]]) -> Bool
  if a.len() != b.len() then return false end
  for (root, aset) in a do
    match b.get(root)
    when Option::Some(bset) then
      if !verifier_string_set_equal(&aset, &bset) then return false end
    when Option::None then return false
    end
  end
  true
end

def verifier_check_block_stmts(inout engine_env: TypeEnv, type_index: Map[Int, MirTypeDef], func: MirFunction, block: MirBlock, block_in: Set[Int], moved_in: Map[Int, Set[String]], fn_effects: Map[String, Vec[EffectId]], ctx: String, inout errors: Vec[String]) -> Unit
  # `running` = values definitely initialized in this block so far.
  # `live` = storage that exists (StorageLive'd or parameters). These are
  # deliberately separate: storage existing does NOT imply a valid value.
  var running: Set[Int] = Set::new()
  for v in block_in do
    running.insert(v.clone())
  end
  var live: Set[Int] = Set::new()
  for v in block_in do
    live.insert(v.clone())
  end
  # `moved` = the projection-aware moved-state lattice (root local ->
  # moved place keys; see the lattice section above).
  var moved: Map[Int, Set[String]] = Map::new()
  for (root, mset) in moved_in do
    var set = Set::new()
    for k in mset do
      set.insert(k.clone())
    end
    moved.insert(root, set)
  end

  for st in block.statements do
    match st.kind
    when MirStatementKind::MirAssign(place, rvalue) then
      let pid = place.local.id
 # Ref-ABI invariant (#7): MirRef values are internal ABI
      # temporaries representing an inout place. They must ONLY ever be
      # assigned to a plain temp local (no projections) — storing a ref into
      # an aggregate (struct field / array element / map) would let a
      # reference escape as an arbitrary safe reference and break the
      # write-back model.
      match rvalue.kind
      when MirRvalueKind::MirRef(_) then
        if !place.projections.is_empty() then
          errors.push(ctx.clone() + ": value stored into aggregate (refs must only be assigned to plain temps)")
        end
      when _ then ()
      end
      verifier_check_place(type_index, func, &place, &running, ctx, errors)
      match verifier_place_result_type_opt(type_index, func, &place)
      when Option::Some(dst_ty) then
        let rv_ty = verifier_rvalue_type(engine_env, type_index, func, &rvalue, &running, &mut moved, ctx, errors)
        match rv_ty
        when Option::Some(t) then
          if !verifier_types_compatible(type_index, &dst_ty, &t) then
            errors.push(ctx.clone() + ": assign type mismatch: " + verifier_type_key(type_index, &t) + " into " + verifier_type_key(type_index, &dst_ty))
          end
        when Option::None then ()
        end
        if !live.contains(&pid) then
          errors.push(ctx.clone() + ": assign to local _" + pid.to_string() + " whose storage is not live")
        end
        running.insert(pid)
        # (partial moves — the place-result check): the store into the
        # place re-lives the place's chain and every extension of it; a
        # store into a FIELD chain of a wholly-moved root is the
        # checker's Consumed-root projected-assign rejection (the store
        # would re-live a field of a root whose value was moved out). The
        # whole-root store itself re-lives the root (the checker's
        # reinitialization of a moved-out slot).
        let akey = verifier_place_key(type_index, &place)
        if !place.projections.is_empty() && akey != "*" && verifier_key_moved(moved, pid, "") then
          errors.push(ctx.clone() + ": assign into a field of consumed local _" + pid.to_string() + " (the whole root was moved out)")
        end
        verifier_key_clear(&mut moved, pid, &akey)
      when Option::None then
        errors.push(ctx.clone() + ": assignment to undefined local _" + pid.to_string())
      end
    when MirStatementKind::MirStorageLive(local) then
      let lid = local.id
      if !verifier_local_exists(func, lid) then
        errors.push(ctx.clone() + ": StorageLive for undefined local _" + lid.to_string())
      end
      # StorageLive makes the storage exist but does NOT initialize a value.
      live.insert(lid)
      running.remove(&lid)
      moved.remove(&lid)
    when MirStatementKind::MirStorageDead(local) then
      let lid = local.id
      if !verifier_local_exists(func, lid) then
        errors.push(ctx.clone() + ": StorageDead for undefined local _" + lid.to_string())
      end
      live.remove(&lid)
      running.remove(&lid)
      moved.remove(&lid)
    when _ then ()
    end
  end

  verifier_check_terminator(engine_env, type_index, func, &block.terminator, &running, &mut moved, &fn_effects, ctx, errors)
end

# Top-level per-function verification driver.
def verify_function_v2(type_index: Map[Int, MirTypeDef], plans: Map[String, DeinitPlan], fn_names: Set[String], deinit_instances: Set[Int], drop_glue_fns: Map[Int, String], param_names: Map[Int, String], func: MirFunction, fn_effects: Map[String, Vec[EffectId]], inout engine_env: TypeEnv, inout errors: Vec[String]) -> Unit
  let fn_ctx = "fn " + func.name.clone()

 # (ABI classifications): the extern-ABI tag is part of the function's
  # contract — a non-extern function must carry the empty tag and an extern
  # function must carry one of the known ABI classifications the backend
  # understands ("C", "System", "Ruby", "Tangerine"; matched
  # case-insensitively — "c"/"system"/"tangerine" appear in the std). An
  # unknown tag is a structural error: the backend cannot classify the
  # calling convention of a tag it does not know. (Checked BEFORE the extern
  # early-return below — the ABI tag is exactly the contract extern
  # functions do carry.)
  if func.is_extern then
    let abi_lower = func.extern_abi.to_lowercase()
    if abi_lower != "c" && abi_lower != "system" &&
       abi_lower != "ruby" && abi_lower != "tangerine" then
      errors.push(fn_ctx.clone() + ": extern function carries unknown ABI classification \"" + func.extern_abi.clone() + "\" (known: C, System, Ruby, Tangerine)")
    end
  else
    if func.extern_abi != "" then
      errors.push(fn_ctx.clone() + ": non-extern function carries ABI classification \"" + func.extern_abi.clone() + "\" (only extern functions classify)")
    end
  end

  if func.is_extern then return end

 # Ref-ABI invariant (#7): refs are internal inout-place temporaries and
  # must never escape through a return value (a returned ref would outlive
  # its write-back tracking and expose user-visible reference semantics).
  match func.ret_type
  when Type::RefInternal(_, _) then
    errors.push(fn_ctx.clone() + ": function returns a ref value (refs are internal ABI and must not escape)")
  when _ then ()
  end

  if func.blocks.is_empty() then
    errors.push(fn_ctx.clone() + ": function has no blocks")
    return
  end

  if !verifier_block_exists(func, func.entry_block.id) then
    errors.push(fn_ctx.clone() + ": entry block bb" + func.entry_block.id.to_string() + " does not exist")
  end

 # no Type::Param / Type::Var in concrete MIR, and every Named type
  # must carry a canonical TypeId. A function whose SIGNATURE (params +
  # ret_type) carries Type::Param is a generic template (monomorphization
  # consumes it); its locals may legitimately reference the template params.
  # Concrete functions (signature free of Param) must have Param-free locals.
  var sig_has_param = false
  var cpi = 0
  while cpi < func.params.len() do
    let p = func.params[cpi]
    let p_ty = p.ty.clone()
    if verifier_type_has_param(&p_ty) then sig_has_param = true end
    let p_what = fn_ctx.clone() + " param _" + p.id.id.to_string()
    verifier_check_type_concreteness(plans, type_index, param_names, &p_what, &p_ty, true, errors)
    cpi = cpi + 1
  end
  let ret_ty = func.ret_type.clone()
  if verifier_type_has_param(&ret_ty) then sig_has_param = true end
  let ret_what = fn_ctx.clone() + " return type"
  verifier_check_type_concreteness(plans, type_index, param_names, &ret_what, &ret_ty, true, errors)
  var li = 0
  while li < func.locals.len() do
    let local = func.locals[li]
    let local_what = fn_ctx.clone() + " local _" + local.id.id.to_string()
    verifier_check_type_concreteness(plans, type_index, param_names, &local_what, &local.ty, sig_has_param, errors)
    li = li + 1
  end

 # P0-CF2: the embedded-types walk — every type embedded in
  # the body (operand constant types, InstanceId substitutions, cast targets,
  # aggregate element types including closure/generator payloads, call
  # signatures, deinit/drop instance payloads, projection owners) must be
  # free of Param/Var/Error under the same signature concreteness rule.
  verifier_check_embedded_types(plans, type_index, param_names, func, sig_has_param, errors)

 # every callee must resolve to a lowered function or a known
 # intrinsic;: every MirDeinit instance must be a registered finalizer
  # identity or a generated drop-glue function.
  verifier_check_callees(func, fn_names, deinit_instances, drop_glue_fns, &fn_ctx, errors)

  verifier_dataflow_init(engine_env, type_index, func, &fn_effects, errors)
end

# Whether a Type contains Type::Param anywhere (used to classify a function
# as a generic template).
def verifier_type_has_param(ty: Type) -> Bool
  match ty
  when Type::Param(_) then true
  when Type::Adt(_, args) then
    var ai = 0
    while ai < args.len() do
      if verifier_type_has_param(&args[ai]) then return true end
      ai = ai + 1
    end
    false
  when Type::FnPtr(params, ret, _) then
    var pi2 = 0
    while pi2 < params.len() do
      if verifier_type_has_param(&params[pi2].ty) then return true end
      pi2 = pi2 + 1
    end
    verifier_type_has_param(&ret)
  when Type::Closure(_, params, ret, captures, _) then
    var pi3 = 0
    while pi3 < params.len() do
      if verifier_type_has_param(&params[pi3].ty) then return true end
      pi3 = pi3 + 1
    end
    if verifier_type_has_param(&ret) then return true end
    verifier_type_has_param(&captures)
  when Type::RefInternal(inner, _) then verifier_type_has_param(&inner)
  when Type::Ptr(inner) then verifier_type_has_param(&inner)
  when Type::PtrMut(inner) then verifier_type_has_param(&inner)
  when Type::Effect(_, inner) then verifier_type_has_param(&inner)
  when Type::Tuple(fields) then
    var ti = 0
    while ti < fields.len() do
      if verifier_type_has_param(&fields[ti]) then return true end
      ti = ti + 1
    end
    false
  when _ then false
  end
end
