# Tangerine Compiler — MIR (Mid-level Intermediate Representation)
# Self-hosting compiler written in Tangerine
#
# MIR provides:
# - Control flow graph representation
# - SSA-like form for analysis
# - Explicit drops and moves
# - Agentic feature lowering

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{write_file_string}
use tg_compiler::token::{Span, span_dummy}
use tg_compiler::ast::{
  Program, Crate, Item, ItemKind, FunctionDecl, FnBody, ConstDecl,
  Block, Stmt, StmtKind, Expr, ExprKind, BinOp, UnOp, Pattern, PatternKind, AstPath,
  Param, AccessConvention, expr_is_place_like, TypeExpr, TypeExprKind
}
