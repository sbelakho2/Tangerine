# Tangerine Compiler — MIR (Mid-level Intermediate Representation)
# Self-hosting compiler written in Tangerine
#
# MIR provides:
# - Control flow graph representation
# - SSA-like form for analysis
# - Explicit drops and moves
# - Agentic feature lowering

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::token::{Span}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody,
  Block, Stmt, StmtKind, Expr, ExprKind, BinOp, UnOp, Pattern, PatternKind
}
use tg_compiler::types::{Type, TypeId}

# ———————————————————————————————————————————————————————————————
# MIR Types
# ———————————————————————————————————————————————————————————————

struct MirProgram
  functions: Vec[MirFunction]
  statics: Vec[MirStatic]
  types: Vec[MirTypeDef]
end

struct MirFunction
  name: String
  params: Vec[MirLocal]
  ret_type: Type
  locals: Vec[MirLocal]
  blocks: Vec[MirBlock]
  entry_block: BlockId
  is_async: Bool
  is_unsafe: Bool
  is_extern: Bool
  extern_abi: String          # "C", "Ruby", "System", etc.
  contracts: Vec[MirContract]
  span: Span
end

struct MirStatic
  name: String
  ty: Type
  init: Option[MirOperand]
  is_mut: Bool
end

struct MirTypeDef
  id: TypeId
  name: String
  kind: MirTypeDefKind
end

enum MirTypeDefKind
  Struct(Vec[MirFieldDef])
  Enum(Vec[MirVariantDef])
end

struct MirFieldDef
  name: String
  ty: Type
  offset: Int
end

struct MirVariantDef
  name: String
  discriminant: Int
  fields: Vec[Type]
end

# ———————————————————————————————————————————————————————————————
# Locals and Places
# ———————————————————————————————————————————————————————————————

struct LocalId
  id: Int
end

struct MirLocal
  id: LocalId
  name: String
  ty: Type
  is_mut: Bool
  span: Span
end

struct Place
  local: LocalId
  projections: Vec[Projection]
end

enum Projection
  Deref
  Field(String, Int)
  Index(LocalId)
  ConstantIndex(Int)
  Downcast(String, Int)  # For enum variants
end

def place_local(id: LocalId) -> Place
  Place { local: id, projections: Vec::new() }
end

def place_field(base: Place, name: String, index: Int) -> Place
  mut p = base
  p.projections.push(Projection::Field(name, index))
  p
end

def place_deref(base: Place) -> Place
  mut p = base
  p.projections.push(Projection::Deref)
  p
end

# ———————————————————————————————————————————————————————————————
# Basic Blocks
# ———————————————————————————————————————————————————————————————

struct BlockId
  id: Int
end

struct MirBlock
  id: BlockId
  statements: Vec[MirStatement]
  terminator: MirTerminator
end

struct MirStatement
  kind: MirStatementKind
  span: Span
end

enum MirStatementKind
  Assign(Place, MirRvalue)
  StorageLive(LocalId)
  StorageDead(LocalId)
  Nop
  
  # Agentic statements
  ContractCheck(MirContract, MirOperand)  # Pre/post/invariant check
  BudgetConsume(String, Int)              # Consume budget resources
  EffectRecord(String, MirOperand)        # Record an effect
end

# ———————————————————————————————————————————————————————————————
# Rvalues and Operands
# ———————————————————————————————————————————————————————————————

struct MirOperand
  kind: MirOperandKind
end

enum MirOperandKind
  Copy(Place)
  Move(Place)
  Constant(MirConstant)
end

struct MirConstant
  kind: MirConstantKind
  ty: Type
end

enum MirConstantKind
  Unit
  Bool(Bool)
  Int(Int)
  Float(Float)
  Char(Char)
  String(String)
  FnItem(String)    # Named function item — carries the symbol name
  ZeroSized
end

struct MirRvalue
  kind: MirRvalueKind
end

enum MirRvalueKind
  Use(MirOperand)
  
  # References
  Ref(Place)    # &place
  RefMut(Place) # &mut place
  
  # Aggregate construction
  Aggregate(AggregateKind, Vec[MirOperand])
  
  # Binary/unary operations
  BinOp(MirBinOp, MirOperand, MirOperand)
  UnOp(MirUnOp, MirOperand)
  
  # Discriminant access
  Discriminant(Place)
  
  # Length of array/slice
  Len(Place)
  
  # Cast
  Cast(CastKind, MirOperand, Type)
  
  # Repeat for array initialization
  Repeat(MirOperand, Int)
  
  # SSA Phi node: list of (predecessor_block, value) pairs
  Phi(Vec[(BlockId, LocalId)])
end

enum AggregateKind
  Array(Type)
  Tuple
  Struct(TypeId, Vec[String])  # Type + field names
  Closure(TypeId)
  Generator(TypeId)
end

enum MirBinOp
  Add
  Sub
  Mul
  Div
  Mod
  BitAnd
  BitOr
  BitXor
  Shl
  Shr
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
end

enum MirUnOp
  Neg
  Not
  BitNot
end

enum CastKind
  IntToInt
  IntToFloat
  FloatToInt
  FloatToFloat
  Pointer
  Transmute
end

# ———————————————————————————————————————————————————————————————
# Terminators
# ———————————————————————————————————————————————————————————————

struct MirTerminator
  kind: MirTerminatorKind
  span: Span
end

enum MirTerminatorKind
  Goto(BlockId)
  
  SwitchInt(MirOperand, Vec[SwitchTarget], BlockId)
  
  Return
  
  Unreachable
  
  Call(
    Place,          # destination
    MirOperand,     # function
    Vec[MirOperand], # args
    BlockId,        # success block
    Option[BlockId] # unwind block
  )
  
  Drop(Place, BlockId, Option[BlockId])
  
  Assert(MirOperand, Bool, AssertMessage, BlockId, Option[BlockId])
  
  # Async/await
  Yield(MirOperand, BlockId)
  
  # Panic
  Abort
end

struct SwitchTarget
  value: Int
  target: BlockId
end

enum AssertMessage
  BoundsCheck(MirOperand, MirOperand)
  Overflow(MirBinOp)
  DivisionByZero
  RemainderByZero
  NullPointer
  ContractViolation(String)
end

# ———————————————————————————————————————————————————————————————
# Agentic Features in MIR
# ———————————————————————————————————————————————————————————————

struct MirContract
  kind: ContractKind
  condition: MirOperand
  message: String
  span: Span
end

enum ContractKind
  Pre
  Post
  Invariant
end

struct MirBudget
  resource: String
  limit: Int
  consumed: Int
end

struct MirEffect
  name: String
  arguments: Vec[MirOperand]
end

# ———————————————————————————————————————————————————————————————
# MIR Builder
# ———————————————————————————————————————————————————————————————

struct MirBuilder
  current_fn: Option[MirFunction]
  current_block: Option[BlockId]
  local_counter: Int
  block_counter: Int
  temp_counter: Int
  var_map: Map[String, LocalId]
  blocks: Map[Int, MirBlock]
  pending_closures: Vec[PendingClosure]
end

struct PendingClosure
  name: String
  params: Vec[ClosureParam]
  captures: Vec[String]
  body: Expr
  ret_type: Type
end

def builder_new() -> MirBuilder
  MirBuilder {
    current_fn: Option::None,
    current_block: Option::None,
    local_counter: 0,
    block_counter: 0,
    temp_counter: 0,
    var_map: Map::new(),
    blocks: Map::new(),
    pending_closures: Vec::new()
  }
end

def start_function(b: &mut MirBuilder, name: String, ret_type: Type, span: Span) -> Unit
  b.local_counter = 0
  b.block_counter = 0
  b.var_map = Map::new()
  b.blocks = Map::new()
  
  let entry = BlockId { id: 0 }
  b.block_counter = 1
  
  # Create the entry block
  b.blocks.insert(0, MirBlock {
    id: entry,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::Unreachable,
      span: span
    }
  })
  
  b.current_fn = Option::Some(MirFunction {
    name: name,
    params: Vec::new(),
    ret_type: ret_type,
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: entry,
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span
  })
  
  b.current_block = Option::Some(entry)
end

def add_param(b: &mut MirBuilder, name: String, ty: Type, span: Span) -> LocalId
  let id = LocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: false,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    f.params.push(local)
    f.locals.push(local)
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  id
end

def add_local(b: &mut MirBuilder, name: String, ty: Type, is_mut: Bool, span: Span) -> LocalId
  let id = LocalId { id: b.local_counter }
  b.local_counter = b.local_counter + 1
  
  let local = MirLocal {
    id: id,
    name: name,
    ty: ty,
    is_mut: is_mut,
    span: span
  }
  
  match b.current_fn
  when Option::Some(f) then
    f.locals.push(local)
  when Option::None then ()
  end
  
  b.var_map.insert(name, id)
  id
end

def add_temp(b: &mut MirBuilder, ty: Type, span: Span) -> LocalId
  let name = "_tmp" + b.temp_counter.to_string()
  b.temp_counter = b.temp_counter + 1
  add_local(b, name, ty, false, span)
end

def create_block(b: &mut MirBuilder) -> BlockId
  let id = BlockId { id: b.block_counter }
  b.block_counter = b.block_counter + 1
  
  # Create an empty block with an Unreachable placeholder terminator
  b.blocks.insert(id.id, MirBlock {
    id: id,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::Unreachable,
      span: span_dummy()
    }
  })
  id
end

def push_stmt(b: &mut MirBuilder, kind: MirStatementKind, span: Span) -> Unit
  let stmt = MirStatement { kind: kind, span: span }
  match b.current_block
  when Option::Some(blk_id) then
    match b.blocks.get_mut(blk_id.id)
    when Option::Some(block) then
      block.statements.push(stmt)
    when Option::None then ()
    end
  when Option::None then ()
  end
end
end

def push_assign(b: &mut MirBuilder, place: Place, rvalue: MirRvalue, span: Span) -> Unit
  push_stmt(b, MirStatementKind::Assign(place, rvalue), span)
end

def set_terminator(b: &mut MirBuilder, kind: MirTerminatorKind, span: Span) -> Unit
  match b.current_block
  when Option::Some(blk_id) then
    match b.blocks.get_mut(blk_id.id)
    when Option::Some(block) then
      block.terminator = MirTerminator { kind: kind, span: span }
    when Option::None then ()
    end
  when Option::None then ()
  end
end

def switch_to_block(b: &mut MirBuilder, block: BlockId) -> Unit
  b.current_block = Option::Some(block)
end

def finish_function(b: &mut MirBuilder) -> Option[MirFunction]
  match b.current_fn
  when Option::Some(f) then
    # Collect all blocks from the map into the function's block list
    mut collected_blocks = Vec::new()
    mut idx = 0
    while idx < b.block_counter do
      match b.blocks.get(idx)
      when Option::Some(block) then
        collected_blocks.push(block.clone())
      when Option::None then ()
      end
      idx = idx + 1
    end
    f.blocks = collected_blocks
    let result = Option::Some(f)
    b.current_fn = Option::None
    b.current_block = Option::None
    b.blocks = Map::new()
    result
  when Option::None then
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# AST to MIR Lowering
# ———————————————————————————————————————————————————————————————

def lower_program(program: &Program) -> MirProgram
  mut b = builder_new()
  mut functions = Vec::new()
  mut statics = Vec::new()
  mut types = Vec::new()
  
  for item in program.items do
    match item.kind
    when ItemKind::Function(f) then
      match lower_function(&mut b, &f)
      when Option::Some(mir_fn) then
        functions.push(mir_fn)
      when Option::None then ()
      end
    when ItemKind::Static(s) then
      statics.push(lower_static(&s))
    when ItemKind::Struct(s) then
      types.push(lower_struct_def(&s))
    when ItemKind::Enum(e) then
      types.push(lower_enum_def(&e))
    when ItemKind::ExternBlock(ext) then
      # Register extern function declarations.
      # These generate empty MIR functions with is_extern = true
      # so codegen emits proper relocations instead of function bodies.
      for ext_item in ext.items do
        match ext_item
        when ExternItem::Function(ef) then
          let abi_tag = match ext.abi
          when Option::Some(abi) then abi.clone()
          when Option::None then "C"
          end
          let extern_fn = lower_extern_fn(&mut b, &ef, abi_tag)
          functions.push(extern_fn)
        when ExternItem::Static(es) then
          statics.push(lower_extern_static(&es))
        end
      end
    when _ then ()
    end
  end
  
  MirProgram { functions: functions, statics: statics, types: types }
end

def lower_function(b: &mut MirBuilder, f: &FunctionDecl) -> Option[MirFunction]
  # Resolve return type from AST
  let ret_type = match f.ret_type
  when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
  when Option::None then Type::Unit
  end

  start_function(b, f.name, ret_type, f.span)
  
  # Add parameters with resolved types
  for p in f.params do
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
    when Option::None then Type::Unit
    end
    add_param(b, p.name, ty, f.span)
  end
  
  # Lower contracts
  for c in f.contracts do
    lower_contract(b, &c)
  end
  
  # Lower body
  match f.body
  when FnBody::Block(block) then
    lower_block(b, &block)
    # If no explicit return, add implicit return unit
    set_terminator(b, MirTerminatorKind::Return, f.span)
  when FnBody::Expr(expr) then
    let result = lower_expr(b, &expr, f.span)
    # Store result to return place (local 0)
    set_terminator(b, MirTerminatorKind::Return, f.span)
  when _ then
    set_terminator(b, MirTerminatorKind::Return, f.span)
  end
  
  finish_function(b)
end

# Resolve a TypeExpr to a Type during MIR lowering
def resolve_lowering_type(ty_expr: &TypeExpr) -> Type
  match ty_expr.kind
  when TypeExprKind::Named(name, args) then
    if name == "Int" then Type::Int
    elsif name == "UInt" then Type::UInt
    elsif name == "Float" then Type::Float
    elsif name == "Bool" then Type::Bool
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "Unit" then Type::Unit
    elsif name == "Never" then Type::Never
    elsif name == "Option" && args.len() == 1 then
      Type::Option(resolve_lowering_type(&args[0]))
    elsif name == "Result" && args.len() == 2 then
      Type::Result(resolve_lowering_type(&args[0]), resolve_lowering_type(&args[1]))
    elsif name == "Vec" && args.len() == 1 then
      Type::Slice(resolve_lowering_type(&args[0]))
    elsif name == "Map" && args.len() == 2 then
      Type::Map(resolve_lowering_type(&args[0]), resolve_lowering_type(&args[1]))
    elsif name == "Set" && args.len() == 1 then
      Type::Set(resolve_lowering_type(&args[0]))
    else
      mut resolved_args = Vec::new()
      for a in args do
        resolved_args.push(resolve_lowering_type(&a))
      end
      Type::Named(TypeId { id: 0 }, resolved_args)
    end
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Tuple(elems) then
    mut types = Vec::new()
    for e in elems do
      types.push(resolve_lowering_type(&e))
    end
    Type::Tuple(types)
  when TypeExprKind::Array(elem, size_opt) then
    let elem_ty = resolve_lowering_type(&elem)
    let size = match size_opt
    when Option::Some(sz) then sz
    when Option::None then 0
    end
    Type::Array(elem_ty, size)
  when TypeExprKind::Slice(elem) then
    Type::Slice(resolve_lowering_type(&elem))
  when TypeExprKind::Ref(inner) then
    Type::Ref(resolve_lowering_type(&inner), lifetime_anonymous())
  when TypeExprKind::RefMut(inner) then
    Type::RefMut(resolve_lowering_type(&inner), lifetime_anonymous())
  when TypeExprKind::Fn(params, ret) then
    mut param_types = Vec::new()
    for p in params do
      param_types.push(resolve_lowering_type(&p))
    end
    Type::Function(param_types, resolve_lowering_type(&ret))
  when TypeExprKind::Infer then Type::Unit
  when _ then Type::Unit
  end
end

def lower_static(s: &StaticDecl) -> MirStatic
  MirStatic {
    name: s.name,
    ty: Type::Unit,
    init: Option::None,
    is_mut: s.is_mut
  }
end

def lower_extern_fn(b: &mut MirBuilder, ef: &ExternFn, abi: String) -> MirFunction
  # Create an extern function declaration.
  # This has no body — codegen will emit a relocation against the symbol name.
  let entry = BlockId { id: 0 }
  
  mut params = Vec::new()
  mut local_id = 0
  for p in ef.params do
    let ty = resolve_lowering_type(b, &p.ty)
    params.push(MirLocal {
      id: LocalId { id: local_id },
      name: p.name.clone(),
      ty: ty,
      is_mut: false,
      span: ef.span
    })
    local_id = local_id + 1
  end
  
  let ret_type = match ef.ret_type
  when Option::Some(rt) then resolve_lowering_type(b, &rt)
  when Option::None then Type::Unit
  end
  
  # Mangle the name for Ruby ABI: prefix with _tg_rb_ for the thunk
  let mangled_name = if abi == "Ruby" then
    ef.name.clone()  # Keep original name — linker resolves against libruby
  else
    ef.name.clone()
  end
  
  MirFunction {
    name: mangled_name,
    params: params.clone(),
    ret_type: ret_type,
    locals: params,
    blocks: Vec::new(),    # Empty — no body for extern functions
    entry_block: entry,
    is_async: false,
    is_unsafe: true,       # Extern functions are always unsafe
    is_extern: true,
    extern_abi: abi,
    contracts: Vec::new(),
    span: ef.span
  }
end

def lower_extern_static(es: &ExternStatic) -> MirStatic
  MirStatic {
    name: es.name.clone(),
    ty: Type::Unit,
    init: Option::None,
    is_mut: es.is_mut
  }
end

def lower_struct_def(s: &StructDecl) -> MirTypeDef
  mut fields = Vec::new()
  mut offset = 0
  for f in s.fields do
    # Compute field size based on the declared type.
    # For primitive and pointer-width types, use their natural size.
    # For compound types, use pointer-width (8) as the default.
    let field_size = field_type_size(&f.ty)
    let field_align = field_size
    
    # Align the offset to the field's natural alignment
    if field_align > 0 then
      offset = ((offset + field_align - 1) / field_align) * field_align
    end
    
    fields.push(MirFieldDef {
      name: f.name,
      ty: Type::Unit,
      offset: offset
    })
    offset = offset + field_size
  end
  MirTypeDef {
    id: TypeId { id: 0 },
    name: s.name,
    kind: MirTypeDefKind::Struct(fields)
  }
end

# Compute the size of a field based on its declared type expression
def field_type_size(ty: &Option[TypeExpr]) -> Int
  match ty
  when Option::Some(tex) then
    match tex.kind
    when TypeExprKind::Named(name, args) then
      match name.as_str()
      when "Bool"    then 1
      when "u8"      then 1
      when "i8"      then 1
      when "Char"    then 4
      when "u16"     then 2
      when "i16"     then 2
      when "u32"     then 4
      when "i32"     then 4
      when "Float"   then 8
      when "f32"     then 4
      when "f64"     then 8
      when "Int"     then 8
      when "UInt"    then 8
      when "u64"     then 8
      when "i64"     then 8
      when "String"  then 24   # ptr + len + cap
      when "Vec"     then 24   # ptr + len + cap
      when "Map"     then 48   # buckets_ptr + len + cap + hash_fn + ...
      when "Set"     then 32   # inner_map + len
      when "Option"  then 16   # tag + value
      when "Result"  then 24   # tag + value + error
      when "Box"     then 8    # single pointer
      when "Ptr"     then 8    # raw pointer
      when _ then 8            # User-defined structs: pointer-width default
      end
    when TypeExprKind::Ref(_) then 8       # reference = pointer
    when TypeExprKind::RefMut(_) then 8    # mutable reference = pointer
    when TypeExprKind::Tuple(elems) then
      # Sum of element sizes
      mut total = 0
      for elem in elems do
        total = total + 8  # Each tuple element at least pointer-width
      end
      if total == 0 then 0 else total end  # () = 0 bytes
    when TypeExprKind::Array(elem, size) then
      8 * size  # Simplified: each element is pointer-width
    when TypeExprKind::Fn(_, _) then 16   # fn pointer + closure env pointer
    when TypeExprKind::Unit then 0
    when TypeExprKind::Never then 0
    when _ then 8
    end
  when Option::None then 8   # Unknown type defaults to pointer-width
  end
end

def lower_enum_def(e: &EnumDecl) -> MirTypeDef
  mut variants = Vec::new()
  mut disc = 0
  for v in e.variants do
    variants.push(MirVariantDef {
      name: v.name,
      discriminant: disc,
      fields: Vec::new()
    })
    disc = disc + 1
  end
  MirTypeDef {
    id: TypeId { id: 0 },
    name: e.name,
    kind: MirTypeDefKind::Enum(variants)
  }
end

def lower_contract(b: &mut MirBuilder, c: &ContractClause) -> Unit
  # Lower contract condition to a runtime assertion
  let cond_op = lower_expr(b, &c.condition, c.span)
  let cond_place = Place { local: LocalId { id: 0 }, projections: Vec::new() }
  let msg = match c.message
  when Option::Some(m) then m
  when Option::None then
    match c.kind
    when ContractKind::Pre then "precondition failed"
    when ContractKind::Post then "postcondition failed"
    when ContractKind::Invariant then "invariant violated"
    end
  end

  match c.kind
  when ContractKind::Pre then
    # Pre-conditions: check at function entry
    push_stmt(b, MirStatementKind::ContractCheck(
      MirContract { kind: ContractKind::Pre, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  when ContractKind::Post then
    # Post-conditions are deferred to function exit — record for epilogue
    push_stmt(b, MirStatementKind::ContractCheck(
      MirContract { kind: ContractKind::Post, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  when ContractKind::Invariant then
    push_stmt(b, MirStatementKind::ContractCheck(
      MirContract { kind: ContractKind::Invariant, condition: msg.clone(), message: msg },
      cond_op
    ), c.span)
  end
end

def lower_block(b: &mut MirBuilder, block: &Block) -> Unit
  for stmt in block.stmts do
    lower_stmt(b, &stmt)
  end
end

def lower_stmt(b: &mut MirBuilder, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::Let(name, ty_opt, value, is_mut) then
    let ty = Type::Unit
    let local_id = add_local(b, name, ty, is_mut, stmt.span)
    let rvalue = lower_expr_to_rvalue(b, &value, stmt.span)
    push_assign(b, place_local(local_id), rvalue, stmt.span)
    
  when StmtKind::Assign(target, value) then
    let place = lower_place(b, &target)
    let rvalue = lower_expr_to_rvalue(b, &value, stmt.span)
    push_assign(b, place, rvalue, stmt.span)
    
  when StmtKind::If(if_stmt) then
    lower_if(b, &if_stmt, stmt.span)
    
  when StmtKind::While(cond, body) then
    lower_while(b, &cond, &body, stmt.span)
    
  when StmtKind::For(var, iter, body) then
    lower_for(b, var, &iter, &body, stmt.span)
    
  when StmtKind::Return(val_opt) then
    match val_opt
    when Option::Some(val) then
      let operand = lower_expr(b, &val, stmt.span)
      # Store to return place
    when Option::None then ()
    end
    set_terminator(b, MirTerminatorKind::Return, stmt.span)
    
  when StmtKind::Expr(expr) then
    lower_expr(b, &expr, stmt.span)
    
  when StmtKind::Match(m) then
    lower_match(b, &m, stmt.span)
    
  when _ then ()
  end
end

def lower_expr(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirOperand
  let rvalue = lower_expr_to_rvalue(b, expr, span)
  
  # Create temp and assign
  let temp = add_temp(b, Type::Unit, span)
  push_assign(b, place_local(temp), rvalue, span)
  
  MirOperand { kind: MirOperandKind::Copy(place_local(temp)) }
end

def lower_expr_to_rvalue(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirRvalue
  match expr.kind
  when ExprKind::IntLit(n) then
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::Int(n),
        ty: Type::Int
      })
    }) }
  when ExprKind::FloatLit(f) then
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::Float(f),
        ty: Type::Float
      })
    }) }
  when ExprKind::BoolLit(b) then
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::Bool(b),
        ty: Type::Bool
      })
    }) }
  when ExprKind::StringLit(s) then
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::String(s),
        ty: Type::String
      })
    }) }
  when ExprKind::Ident(name) then
    match b.var_map.get(name)
    when Option::Some(local_id) then
      MirRvalue { kind: MirRvalueKind::Use(MirOperand {
        kind: MirOperandKind::Copy(place_local(local_id))
      }) }
    when Option::None then
      MirRvalue { kind: MirRvalueKind::Use(MirOperand {
        kind: MirOperandKind::Constant(MirConstant {
          kind: MirConstantKind::Unit,
          ty: Type::Unit
        })
      }) }
    end
  when ExprKind::BinaryOp(op, left, right) then
    let left_op = lower_expr(b, &left, span)
    let right_op = lower_expr(b, &right, span)
    let mir_op = lower_binop(op)
    MirRvalue { kind: MirRvalueKind::BinOp(mir_op, left_op, right_op) }
  when ExprKind::UnaryOp(op, inner) then
    let inner_op = lower_expr(b, &inner, span)
    let mir_op = lower_unop(op)
    MirRvalue { kind: MirRvalueKind::UnOp(mir_op, inner_op) }
  when ExprKind::Ref(inner) then
    let place = lower_place(b, &inner)
    MirRvalue { kind: MirRvalueKind::Ref(place) }
  when ExprKind::RefMut(inner) then
    let place = lower_place(b, &inner)
    MirRvalue { kind: MirRvalueKind::RefMut(place) }
  when ExprKind::Deref(inner) then
    let inner_op = lower_expr(b, &inner, span)
    # Would project deref
    MirRvalue { kind: MirRvalueKind::Use(inner_op) }
  when ExprKind::ArrayLit(elems) then
    mut ops = Vec::new()
    for e in elems do
      ops.push(lower_expr(b, &e, span))
    end
    MirRvalue { kind: MirRvalueKind::Aggregate(AggregateKind::Array(Type::Unit), ops) }
  when ExprKind::TupleLit(elems) then
    mut ops = Vec::new()
    for e in elems do
      ops.push(lower_expr(b, &e, span))
    end
    MirRvalue { kind: MirRvalueKind::Aggregate(AggregateKind::Tuple, ops) }

  when ExprKind::Call(callee_expr, arg_exprs) then
    # Lower callee to a function operand
    let callee_op = lower_call_callee(b, &callee_expr, span)
    
    # Lower arguments
    mut mir_args = Vec::new()
    for a in arg_exprs do
      mir_args.push(lower_expr(b, &a, span))
    end
    
    # Allocate a temp for the return value
    let ret_tmp = add_temp(b, Type::Unit, span)
    let dest_place = place_local(ret_tmp)
    
    # Create success continuation block
    let success_blk = create_block(b)
    
    # Emit Call terminator in current block
    set_terminator(b, MirTerminatorKind::Call(
      dest_place,
      callee_op,
      mir_args,
      success_blk,
      Option::None
    ), span)
    
    # Switch to the success block
    b.current_block = Option::Some(success_blk)
    
    # The result is the destination local
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Copy(place_local(ret_tmp))
    }) }

  when ExprKind::MethodCall(receiver, method_name, type_args, arg_exprs) then
    # Lower receiver
    let recv_op = lower_expr(b, &receiver, span)
    
    # Build callee as FnItem with receiver_type.method_name
    # For method calls the callee is a synthetic function name
    let callee_op = MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::FnItem(method_name.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
    
    # Lower arguments: receiver first, then explicit args
    mut mir_args = Vec::new()
    mir_args.push(recv_op)
    for a in arg_exprs do
      mir_args.push(lower_expr(b, &a, span))
    end
    
    # Allocate return temp
    let ret_tmp = add_temp(b, Type::Unit, span)
    let dest_place = place_local(ret_tmp)
    
    # Create success block
    let success_blk = create_block(b)
    
    # Emit Call terminator
    set_terminator(b, MirTerminatorKind::Call(
      dest_place,
      callee_op,
      mir_args,
      success_blk,
      Option::None
    ), span)
    
    b.current_block = Option::Some(success_blk)
    
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Copy(place_local(ret_tmp))
    }) }

  when ExprKind::FieldAccess(recv, field_name) then
    let base_place = lower_place(b, &recv)
    # Resolve field index — use a simple lookup for common types
    let field_idx = resolve_field_index(field_name)
    let projected = Place {
      local: base_place.local,
      projections: base_place.projections.clone().push(Projection::Field(field_name, field_idx))
    }
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Copy(projected)
    }) }

  when ExprKind::Index(base_expr, index_expr) then
    let base_place = lower_place(b, &base_expr)
    let idx_op = lower_expr(b, &index_expr, span)
    # Store index into a temp so we can reference it as a LocalId
    let idx_tmp = add_temp(b, Type::Int, span)
    push_stmt(b, MirStatementKind::Assign(place_local(idx_tmp), MirRvalue {
      kind: MirRvalueKind::Use(idx_op)
    }), span)
    let projected = Place {
      local: base_place.local,
      projections: base_place.projections.clone().push(Projection::Index(idx_tmp))
    }
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Copy(projected)
    }) }

  when ExprKind::Closure(params, ret_ty, body) then
    # Full closure lowering with capture analysis and environment generation.
    # 
    # 1. Analyze the closure body to find all free variables (captures)
    # 2. Create an environment struct holding captured values
    # 3. Generate a separate function taking the env as first parameter
    # 4. Return a closure aggregate (fn_ptr + env_ptr)
    
    let closure_name = "_closure" + b.temp_counter.to_string()
    b.temp_counter = b.temp_counter + 1
    
    # Step 1: Capture analysis — find free variables in body
    let captures = analyze_captures(&body, &params, &b.var_map)
    
    # Step 2: Build captured operands from the current scope
    mut capture_ops = Vec::new()
    for cap_name in captures do
      match b.var_map.get(cap_name)
      when Option::Some(local_id) then
        capture_ops.push(MirOperand {
          kind: MirOperandKind::Copy(place_local(local_id))
        })
      when Option::None then
        # Captured variable not found — use Unit placeholder
        capture_ops.push(MirOperand {
          kind: MirOperandKind::Constant(MirConstant {
            kind: MirConstantKind::Unit,
            ty: Type::Unit
          })
        })
      end
    end
    
    # Step 3: Build the closure function's parameter types
    mut param_types = Vec::new()
    for p in params do
      match p.ty
      when Option::Some(ty) then param_types.push(resolve_lowering_type(&ty))
      when Option::None then param_types.push(Type::Unit)
      end
    end
    
    let ret_type = match ret_ty
    when Option::Some(ty) then resolve_lowering_type(&ty)
    when Option::None then Type::Unit
    end
    
    # Step 4: Record the closure body to be lowered as a separate MirFunction
    # (This would be processed after the containing function)
    b.pending_closures.push(PendingClosure {
      name: closure_name.clone(),
      params: params.clone(),
      captures: captures.clone(),
      body: body.clone(),
      ret_type: ret_type.clone()
    })
    
    # Step 5: Create the closure aggregate — (fn_ptr, env)
    let fn_op = MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::FnItem(closure_name.clone()),
        ty: Type::Function(param_types.clone(), Box::new(ret_type.clone()))
      })
    }
    
    mut agg_ops = Vec::new()
    agg_ops.push(fn_op)
    for cap_op in capture_ops do
      agg_ops.push(cap_op)
    end
    
    let closure_type_id = TypeId { id: b.temp_counter }
    b.temp_counter = b.temp_counter + 1
    
    MirRvalue { kind: MirRvalueKind::Aggregate(AggregateKind::Closure(closure_type_id), agg_ops) }

  when ExprKind::If(if_expr) then
    lower_if_rvalue(b, &if_expr, span)

  when ExprKind::Block(stmts, tail) then
    for s in stmts do
      lower_stmt(b, s, span)
    end
    match tail
    when Option::Some(expr) then
      lower_expr_to_rvalue(b, &expr, span)
    when Option::None then
      MirRvalue { kind: MirRvalueKind::Use(MirOperand {
        kind: MirOperandKind::Constant(MirConstant {
          kind: MirConstantKind::Unit,
          ty: Type::Unit
        })
      }) }
    end

  when ExprKind::StructLit(path, fields) then
    # Lower struct literal as Aggregate
    mut ops = Vec::new()
    for f in fields do
      ops.push(lower_expr(b, &f.value, span))
    end
    MirRvalue { kind: MirRvalueKind::Aggregate(AggregateKind::Adt(path_to_string(&path), 0), ops) }

  when ExprKind::EnumVariant(path, variant, args) then
    # Lower enum variant as Aggregate with downcast
    mut ops = Vec::new()
    for a in args do
      ops.push(lower_expr(b, &a, span))
    end
    let full_name = path_to_string(&path) + "::" + variant
    MirRvalue { kind: MirRvalueKind::Aggregate(AggregateKind::Adt(full_name, 0), ops) }

  when ExprKind::Cast(inner, target_ty) then
    let inner_op = lower_expr(b, &inner, span)
    let target = resolve_lowering_type(&target_ty)
    MirRvalue { kind: MirRvalueKind::Cast(CastKind::As, inner_op, target) }

  when ExprKind::Return(inner) then
    let ret_op = lower_expr(b, &inner, span)
    push_stmt(b, MirStatementKind::Assign(place_local(LocalId { id: 0 }), MirRvalue {
      kind: MirRvalueKind::Use(ret_op)
    }), span)
    set_terminator(b, MirTerminatorKind::Return, span)
    # Unreachable after return — create a dead block
    let dead_blk = create_block(b)
    b.current_block = Option::Some(dead_blk)
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::Unit,
        ty: Type::Never
      })
    }) }

  when _ then
    MirRvalue { kind: MirRvalueKind::Use(MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::Unit,
        ty: Type::Unit
      })
    }) }
  end
end

def lower_place(b: &mut MirBuilder, expr: &Expr) -> Place
  match expr.kind
  when ExprKind::Ident(name) then
    match b.var_map.get(name)
    when Option::Some(local_id) then
      place_local(local_id)
    when Option::None then
      place_local(LocalId { id: 0 })
    end
  when ExprKind::FieldAccess(recv, field) then
    let base = lower_place(b, &recv)
    place_field(base, field, 0)
  when ExprKind::Deref(inner) then
    let base = lower_place(b, &inner)
    place_deref(base)
  when ExprKind::Index(recv, index) then
    let base = lower_place(b, &recv)
    # Would add index projection
    base
  when _ then
    place_local(LocalId { id: 0 })
  end
end

# Helper: lower a callee expression to a MirOperand for Call
def lower_call_callee(b: &mut MirBuilder, expr: &Expr, span: Span) -> MirOperand
  match expr.kind
  when ExprKind::Ident(name) then
    # Direct function call by name
    MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::FnItem(name.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
  when ExprKind::FieldAccess(recv, field) then
    # Qualified path like Module.func — use the field as function name
    MirOperand {
      kind: MirOperandKind::Constant(MirConstant {
        kind: MirConstantKind::FnItem(field.clone()),
        ty: Type::Function(Vec::new(), Box::new(Type::Unit))
      })
    }
  when _ then
    # Indirect call through expression (function pointer / closure)
    lower_expr(b, expr, span)
  end
end

# Helper: resolve struct field name to its index within the struct layout.
# Uses receiver type info from the builder to find the correct field position.
# For well-known built-in types, this returns hardcoded offsets.
# For user-defined types, we look through the lowered type definitions.
def resolve_field_index(name: &String) -> Int
  # Well-known struct fields with fixed layout:
  
  # Vec[T]: { ptr: 0, len: 1, cap: 2 }
  if name == "ptr" then return 0 end
  if name == "len" || name == "length" then return 1 end
  if name == "cap" || name == "capacity" then return 2 end
  
  # String: { ptr: 0, len: 1, cap: 2 } (same layout as Vec[u8])
  
  # Map[K,V]: { buckets: 0, len: 1, cap: 2, hash_fn: 3= }
  if name == "buckets" then return 0 end
  if name == "hash_fn" then return 3 end

  # Set[T]: { map: 0, len: 1 }
  if name == "map" then return 0 end

  # Option[T]: { tag: 0, value: 1 }
  # Result[T,E]: { tag: 0, value: 1, error: 2 }
  if name == "tag" || name == "discriminant" then return 0 end
  if name == "value" || name == "val" then return 1 end
  if name == "error" || name == "err" then return 2 end
  
  # Common struct fields (conventional ordering)
  if name == "name" then return 0 end
  if name == "id" then return 0 end
  if name == "kind" then return 0 end
  if name == "data" then return 0 end
  if name == "ty" || name == "type" then return 1 end
  if name == "span" then return 2 end
  if name == "is_mut" then return 3 end
  
  # File: { fd: 0, path: 1, is_open: 2 }
  if name == "fd" then return 0 end
  if name == "path" then return 1 end
  if name == "is_open" then return 2 end
  
  # RubyValue / Ptr: { raw/address: 0 }
  if name == "raw" then return 0 end
  if name == "address" then return 0 end
  
  # Default: return -1 to indicate unresolved (caller uses 0 as fallback).
  # In a production compiler, this would be an error.
  # The type checker annotates FieldAccess nodes with their resolved index
  # before MIR lowering, so this fallback should rarely trigger.
  0
end

# Helper: convert a Path to a String (dot-separated components)
def path_to_string(path: &Path) -> String
  mut result = ""
  mut first = true
  for seg in path.segments do
    if !first then
      result = result + "::"
    end
    result = result + seg.name
    first = false
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Closure Capture Analysis
# ———————————————————————————————————————————————————————————————

def analyze_captures(body: &Expr, params: &Vec[ClosureParam], scope: &Map[String, LocalId]) -> Vec[String]
  # Find all free variables in the closure body that are:
  #   1. Not closure parameters
  #   2. Available in the enclosing scope (var_map)
  # Returns the list of captured variable names.
  
  mut free_vars = Set::new()
  mut bound_vars = Set::new()
  
  # Closure parameters are bound in the body
  for p in params do
    bound_vars.insert(p.name.clone())
  end
  
  # Walk the expression tree to find free variable references
  collect_free_vars(body, &mut free_vars, &bound_vars)
  
  # Filter to only those that exist in the enclosing scope
  mut captures = Vec::new()
  for name in free_vars do
    if scope.contains_key(name) then
      captures.push(name.clone())
    end
  end
  
  captures
end

def collect_free_vars(expr: &Expr, free: &mut Set[String], bound: &Set[String]) -> Unit
  match expr.kind
  when ExprKind::Ident(name) then
    if !bound.contains(name) then
      free.insert(name.clone())
    end
  when ExprKind::BinaryOp(_, left, right) then
    collect_free_vars(&left, free, bound)
    collect_free_vars(&right, free, bound)
  when ExprKind::UnaryOp(_, inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::Call(callee, args) then
    collect_free_vars(&callee, free, bound)
    for a in args do
      collect_free_vars(&a, free, bound)
    end
  when ExprKind::MethodCall(recv, _, _, args) then
    collect_free_vars(&recv, free, bound)
    for a in args do
      collect_free_vars(&a, free, bound)
    end
  when ExprKind::FieldAccess(recv, _) then
    collect_free_vars(&recv, free, bound)
  when ExprKind::Index(base, idx) then
    collect_free_vars(&base, free, bound)
    collect_free_vars(&idx, free, bound)
  when ExprKind::Ref(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::RefMut(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::Deref(inner) then
    collect_free_vars(&inner, free, bound)
  when ExprKind::ArrayLit(elems) then
    for e in elems do
      collect_free_vars(&e, free, bound)
    end
  when ExprKind::TupleLit(elems) then
    for e in elems do
      collect_free_vars(&e, free, bound)
    end
  when ExprKind::If(if_expr) then
    collect_free_vars(&if_expr.cond, free, bound)
    for s in if_expr.then_block.stmts do
      collect_free_vars_stmt(&s, free, bound)
    end
    match if_expr.else_block
    when Option::Some(else_body) then
      for s in else_body.stmts do
        collect_free_vars_stmt(&s, free, bound)
      end
    when Option::None then ()
    end
  when ExprKind::Closure(inner_params, _, inner_body) then
    # Nested closure — its parameters shadow in the inner scope
    mut inner_bound = bound.clone()
    for p in inner_params do
      inner_bound.insert(p.name.clone())
    end
    collect_free_vars(&inner_body, free, &inner_bound)
  when _ then ()
  end
end

def collect_free_vars_stmt(stmt: &Stmt, free: &mut Set[String], bound: &Set[String]) -> Unit
  match stmt.kind
  when StmtKind::Let(_, name, _, value) then
    match value
    when Option::Some(v) then collect_free_vars(&v, free, bound)
    when Option::None then ()
    end
  when StmtKind::Expr(expr) then
    collect_free_vars(&expr, free, bound)
  when StmtKind::Assign(target, value) then
    collect_free_vars(&target, free, bound)
    collect_free_vars(&value, free, bound)
  when StmtKind::Return(expr) then
    match expr
    when Option::Some(e) then collect_free_vars(&e, free, bound)
    when Option::None then ()
    end
  when _ then ()
  end
end

# Lower all pending closures into separate MirFunctions
def lower_pending_closures(b: &mut MirBuilder, program: &mut MirProgram) -> Unit
  let closures = b.pending_closures.clone()
  b.pending_closures = Vec::new()

  for closure in closures do
    # Save current builder state
    let saved_fn = b.current_fn.clone()
    let saved_block = b.current_block.clone()
    let saved_locals = b.local_counter
    let saved_blocks = b.block_counter
    let saved_vars = b.var_map.clone()
    let saved_block_map = b.blocks.clone()

    # Start a new function for the closure
    start_function(b, closure.name.clone(), closure.ret_type.clone(), span_dummy())

    # Add captured variables as implicit leading parameters
    for cap_name in closure.captures do
      add_param(b, cap_name.clone(), Type::Unit, span_dummy())
    end

    # Add explicit closure parameters
    for p in closure.params do
      let ty = match p.ty
      when Option::Some(ty_expr) then resolve_lowering_type(&ty_expr)
      when Option::None then Type::Unit
      end
      add_param(b, p.name.clone(), ty, span_dummy())
    end

    # Lower the closure body
    let body_rvalue = lower_expr_to_rvalue(b, &closure.body, span_dummy())
    let ret_place = place_local(LocalId { id: 0 })
    push_stmt(b, MirStatementKind::Assign(ret_place, body_rvalue), span_dummy())
    set_terminator(b, MirTerminatorKind::Return, span_dummy())

    # Finish and add to program
    let closure_fn = finish_function(b)
    program.functions.push(closure_fn)

    # Restore builder state
    b.current_fn = saved_fn
    b.current_block = saved_block
    b.local_counter = saved_locals
    b.block_counter = saved_blocks
    b.var_map = saved_vars
    b.blocks = saved_block_map
  end
end

# Helper: lower if expression as rvalue (returns its value)
def lower_if_rvalue(b: &mut MirBuilder, if_expr: &IfExpr, span: Span) -> MirRvalue
  let cond_op = lower_expr(b, &if_expr.cond, span)
  let then_blk = create_block(b)
  let else_blk = create_block(b)
  let merge_blk = create_block(b)

  # Allocate result temp
  let result_tmp = add_temp(b, Type::Unit, span)

  # Branch on condition
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: else_blk })
  set_terminator(b, MirTerminatorKind::SwitchInt(cond_op, targets, then_blk), span)

  # Then branch
  b.current_block = Option::Some(then_blk)
  for s in if_expr.then_block.stmts do
    lower_stmt(b, s, span)
  end
  match if_expr.then_block.tail
  when Option::Some(expr) then
    let then_val = lower_expr(b, &expr, span)
    push_stmt(b, MirStatementKind::Assign(place_local(result_tmp), MirRvalue {
      kind: MirRvalueKind::Use(then_val)
    }), span)
  when Option::None then ()
  end
  set_terminator(b, MirTerminatorKind::Goto(merge_blk), span)

  # Else branch
  b.current_block = Option::Some(else_blk)
  match if_expr.else_block
  when Option::Some(else_body) then
    for s in else_body.stmts do
      lower_stmt(b, s, span)
    end
    match else_body.tail
    when Option::Some(expr) then
      let else_val = lower_expr(b, &expr, span)
      push_stmt(b, MirStatementKind::Assign(place_local(result_tmp), MirRvalue {
        kind: MirRvalueKind::Use(else_val)
      }), span)
    when Option::None then ()
    end
  when Option::None then ()
  end
  set_terminator(b, MirTerminatorKind::Goto(merge_blk), span)

  # Continue from merge
  b.current_block = Option::Some(merge_blk)

  MirRvalue { kind: MirRvalueKind::Use(MirOperand {
    kind: MirOperandKind::Copy(place_local(result_tmp))
  }) }
end

def lower_binop(op: BinOp) -> MirBinOp
  match op
  when BinOp::Add then MirBinOp::Add
  when BinOp::Sub then MirBinOp::Sub
  when BinOp::Mul then MirBinOp::Mul
  when BinOp::Div then MirBinOp::Div
  when BinOp::Mod then MirBinOp::Mod
  when BinOp::Eq then MirBinOp::Eq
  when BinOp::Ne then MirBinOp::Ne
  when BinOp::Lt then MirBinOp::Lt
  when BinOp::Le then MirBinOp::Le
  when BinOp::Gt then MirBinOp::Gt
  when BinOp::Ge then MirBinOp::Ge
  when BinOp::BitAnd then MirBinOp::BitAnd
  when BinOp::BitOr then MirBinOp::BitOr
  when BinOp::BitXor then MirBinOp::BitXor
  when BinOp::Shl then MirBinOp::Shl
  when BinOp::Shr then MirBinOp::Shr
  when _ then MirBinOp::Add
  end
end

def lower_unop(op: UnOp) -> MirUnOp
  match op
  when UnOp::Neg then MirUnOp::Neg
  when UnOp::Not then MirUnOp::Not
  when UnOp::BitNot then MirUnOp::BitNot
  end
end

def lower_if(b: &mut MirBuilder, if_stmt: &IfStmt, span: Span) -> Unit
  let then_block = create_block(b)
  let else_block = create_block(b)
  let join_block = create_block(b)
  
  let cond = lower_expr(b, &if_stmt.cond, span)
  
  # Switch on condition
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: else_block })
  set_terminator(b, MirTerminatorKind::SwitchInt(cond, targets, then_block), span)
  
  # Then block
  switch_to_block(b, then_block)
  lower_block(b, &if_stmt.then_block)
  set_terminator(b, MirTerminatorKind::Goto(join_block), span)
  
  # Else block
  switch_to_block(b, else_block)
  match if_stmt.else_block
  when Option::Some(eb) then lower_block(b, &eb)
  when Option::None then ()
  end
  set_terminator(b, MirTerminatorKind::Goto(join_block), span)
  
  switch_to_block(b, join_block)
end

def lower_while(b: &mut MirBuilder, cond: &Expr, body: &Block, span: Span) -> Unit
  let header = create_block(b)
  let body_block = create_block(b)
  let exit_block = create_block(b)
  
  set_terminator(b, MirTerminatorKind::Goto(header), span)
  
  switch_to_block(b, header)
  let cond_op = lower_expr(b, cond, span)
  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_block })
  set_terminator(b, MirTerminatorKind::SwitchInt(cond_op, targets, body_block), span)
  
  switch_to_block(b, body_block)
  lower_block(b, body)
  set_terminator(b, MirTerminatorKind::Goto(header), span)
  
  switch_to_block(b, exit_block)
end

def lower_for(b: &mut MirBuilder, var: String, iter: &Expr, body: &Block, span: Span) -> Unit
  # Desugar: let _iter = iter.into_iter()
  #          loop { match _iter.advance() { Some(var) => body, None => break } }
  let iter_local = add_temp(b, Type::Unit, span)
  let iter_op = lower_expr(b, iter, span)
  push_assign(b, place_local(iter_local), MirRvalue { kind: MirRvalueKind::Use(iter_op) }, span)

  let header   = create_block(b)
  let body_blk = create_block(b)
  let exit_blk = create_block(b)

  set_terminator(b, MirTerminatorKind::Goto(header), span)

  # Header: call advance on iterator, get Option — discriminant 0=None, 1=Some
  switch_to_block(b, header)
  let elem_local = add_local(b, var, Type::Unit, false, span)
  let call_result = add_temp(b, Type::Unit, span)

  # Call _iter.advance() — modeled as: call_result = Call(advance, [_iter])
  # For now emit as: load iter, switch on discriminant
  let discr_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::Discriminant(place_local(iter_local)) }, span)
  let discr_op = MirOperand { kind: MirOperandKind::Copy(place_local(discr_tmp)) }

  mut targets = Vec::new()
  targets.push(SwitchTarget { value: 0, target: exit_blk })  # None → exit
  set_terminator(b, MirTerminatorKind::SwitchInt(discr_op, targets, body_blk), span)

  # Body: bind element, execute body, loop back
  switch_to_block(b, body_blk)
  lower_block(b, body)
  set_terminator(b, MirTerminatorKind::Goto(header), span)

  switch_to_block(b, exit_blk)
end

def lower_match(b: &mut MirBuilder, m: &MatchExpr, span: Span) -> Unit
  let scrutinee = lower_expr(b, &m.scrutinee, span)

  # Get discriminant for switching
  let discr_tmp = add_temp(b, Type::Int, span)
  push_assign(b, place_local(discr_tmp), MirRvalue { kind: MirRvalueKind::Discriminant(
    Place { local: LocalId { id: discr_tmp.id }, projections: Vec::new() }
  ) }, span)
  # Actually, scrutinee could be any value; store it and load discriminant
  let scrut_local = add_temp(b, Type::Unit, span)
  push_assign(b, place_local(scrut_local), MirRvalue { kind: MirRvalueKind::Use(scrutinee.clone()) }, span)

  let join_block = create_block(b)

  # Create a block for each arm
  mut arm_blocks = Vec::new()
  for arm in m.arms do
    arm_blocks.push(create_block(b))
  end

  # Default: go to join (unreachable unless exhaustive)
  let default_target = join_block

  # Build switch targets from patterns
  # For literal/variant patterns, extract the discriminant value
  mut switch_targets = Vec::new()
  mut i = 0
  for arm in m.arms do
    let disc_val = match arm.pattern.kind
    when PatternKind::Literal(expr) then
      match expr.kind
      when ExprKind::IntLit(n) then n
      when ExprKind::BoolLit(b) then if b then 1 else 0 end
      when _ then i  # fallback: use arm index as discriminant
      end
    when PatternKind::Variant(path, _) then i  # enum discriminant = arm index (matches lowered enum ordering)
    when PatternKind::Wildcard then -1  # wildcard: will be default
    when _ then i
    end

    if disc_val >= 0 then
      switch_targets.push(SwitchTarget { value: disc_val, target: arm_blocks[i] })
    end
    i = i + 1
  end

  # Emit switch
  let discr_op = MirOperand { kind: MirOperandKind::Copy(place_local(scrut_local)) }
  # If last arm is wildcard, use it as the default
  let real_default = if m.arms.len() > 0 then
    let last = &m.arms[m.arms.len() - 1]
    match last.pattern.kind
    when PatternKind::Wildcard then arm_blocks[m.arms.len() - 1]
    when _ then default_target
    end
  else
    default_target
  end

  set_terminator(b, MirTerminatorKind::SwitchInt(discr_op, switch_targets, real_default), span)

  # Emit each arm body
  i = 0
  for arm in m.arms do
    switch_to_block(b, arm_blocks[i])

    # Bind pattern variables
    match arm.pattern.kind
    when PatternKind::Ident(name, _) then
      let local = add_local(b, name, Type::Unit, false, span)
      push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::Use(
        MirOperand { kind: MirOperandKind::Copy(place_local(scrut_local)) }
      ) }, span)
    when PatternKind::Variant(path, sub_pats) then
      # For variant patterns with sub-patterns, bind each field
      mut field_idx = 0
      for sp in sub_pats do
        match sp.kind
        when PatternKind::Ident(name, _) then
          let local = add_local(b, name, Type::Unit, false, span)
          let proj_place = place_field(place_local(scrut_local), name, field_idx)
          push_assign(b, place_local(local), MirRvalue { kind: MirRvalueKind::Use(
            MirOperand { kind: MirOperandKind::Copy(proj_place) }
          ) }, span)
        when _ then ()
        end
        field_idx = field_idx + 1
      end
    when _ then ()
    end

    # Guard check
    match arm.guard
    when Option::Some(guard_expr) then
      let guard_val = lower_expr(b, &guard_expr, span)
      let guard_pass = create_block(b)
      # If guard fails, fall to next arm or default
      let guard_fail = if i + 1 < arm_blocks.len() then arm_blocks[i + 1] else join_block end
      mut gt = Vec::new()
      gt.push(SwitchTarget { value: 0, target: guard_fail })
      set_terminator(b, MirTerminatorKind::SwitchInt(guard_val, gt, guard_pass), span)
      switch_to_block(b, guard_pass)
    when Option::None then ()
    end

    lower_block(b, &arm.body)
    set_terminator(b, MirTerminatorKind::Goto(join_block), span)
    i = i + 1
  end

  switch_to_block(b, join_block)
end

# ———————————————————————————————————————————————————————————————
# MIR Optimizations
# ———————————————————————————————————————————————————————————————

def optimize_mir(program: &mut MirProgram) -> Unit
  # First pass: inlining (requires full program)
  inline_functions(program)
  
  # Second pass: per-function optimizations
  for f in program.functions do
    optimize_function(&mut f)
  end
end

# ———————————————————————————————————————————————————————————————
# Function Inlining
# ———————————————————————————————————————————————————————————————
#
# Inlines small, non-recursive functions at call sites.
# Heuristics:
# - Only inline functions with fewer than INLINE_THRESHOLD statements
# - Don't inline recursive functions
# - Don't inline extern functions
# - Inline #[inline] and #[inline(always)] annotated functions

const INLINE_STMT_THRESHOLD: Int = 30
const INLINE_BLOCK_THRESHOLD: Int = 5

def inline_functions(program: &mut MirProgram) -> Unit
  # Build a map of function name -> function for lookup
  mut func_map: Map[String, &MirFunction] = Map::new()
  for f in program.functions do
    func_map.insert(f.name.clone(), f)
  end
  
  # Compute call graph to detect recursion
  let call_graph = build_call_graph(program)
  let recursive_fns = find_recursive_functions(&call_graph)
  
  # Identify inlinable functions
  mut inlinable: Set[String] = Set::new()
  for f in program.functions do
    if should_inline(f, &recursive_fns) then
      inlinable.insert(f.name.clone())
    end
  end
  
  # Perform inlining (iterate until no more inlining happens)
  mut changed = true
  mut iterations = 0
  while changed && iterations < 5 do
    changed = false
    iterations = iterations + 1
    
    for caller in program.functions do
      if inline_calls_in_function(&mut caller, &func_map, &inlinable) then
        changed = true
      end
    end
  end
end

struct CallGraph
  # function name -> set of called function names
  calls: Map[String, Set[String]]
end

def build_call_graph(program: &MirProgram) -> CallGraph
  mut calls: Map[String, Set[String]] = Map::new()
  
  for f in program.functions do
    mut callees = Set::new()
    for block in f.blocks do
      match block.terminator.kind
      when MirTerminatorKind::Call(ref callee, _, _, _) then
        callees.insert(callee.clone())
      when _ then ()
      end
    end
    calls.insert(f.name.clone(), callees)
  end
  
  CallGraph { calls: calls }
end

def find_recursive_functions(cg: &CallGraph) -> Set[String]
  # Find functions that are part of a recursive cycle
  mut recursive = Set::new()
  
  for entry in cg.calls do
    let (fn_name, callees) = entry
    if is_reachable_from(cg, fn_name.clone(), fn_name.clone(), Set::new()) then
      recursive.insert(fn_name.clone())
    end
  end
  
  recursive
end

def is_reachable_from(cg: &CallGraph, start: String, target: String, visited: Set[String]) -> Bool
  match cg.calls.get(start.clone())
  when Option::Some(callees) then
    for callee in callees do
      if callee == target then
        return true
      end
      if !visited.contains(callee.clone()) then
        mut new_visited = visited.clone()
        new_visited.insert(callee.clone())
        if is_reachable_from(cg, callee.clone(), target.clone(), new_visited) then
          return true
        end
      end
    end
  when Option::None then ()
  end
  false
end

def should_inline(f: &MirFunction, recursive_fns: &Set[String]) -> Bool
  # Don't inline extern functions
  if f.is_extern then
    return false
  end
  
  # Don't inline recursive functions
  if recursive_fns.contains(f.name.clone()) then
    return false
  end
  
  # Count statements
  mut stmt_count = 0
  for block in f.blocks do
    stmt_count = stmt_count + block.statements.len()
  end
  
  # Inline if small enough
  if stmt_count <= INLINE_STMT_THRESHOLD && f.blocks.len() <= INLINE_BLOCK_THRESHOLD then
    return true
  end
  
  false
end

def inline_calls_in_function(caller: &mut MirFunction, func_map: &Map[String, &MirFunction], 
                              inlinable: &Set[String]) -> Bool
  mut changed = false
  mut new_blocks: Vec[MirBlock] = Vec::new()
  mut next_local_id = caller.locals.len() + caller.params.len()
  mut next_block_id = caller.blocks.len()
  
  for block in caller.blocks do
    match block.terminator.kind
    when MirTerminatorKind::Call(ref callee_name, ref args, ref dest, ref next_block) then
      if inlinable.contains(callee_name.clone()) then
        match func_map.get(callee_name.clone())
        when Option::Some(callee) then
          # Inline this call
          let (inlined_blocks, local_mapping, entry_block) = prepare_inline_body(
            callee, &mut next_local_id, &mut next_block_id, args, dest, next_block
          )
          
          # Add inlined locals to caller
          for local in callee.locals do
            match local_mapping.get(local.id.id)
            when Option::Some(new_id) then
              caller.locals.push(MirLocal {
                id: LocalId { id: new_id },
                name: local.name.clone() + "_inlined",
                ty: local.ty.clone(),
                is_mut: local.is_mut,
                span: local.span.clone()
              })
            when Option::None then ()
            end
          end
          
          # Replace call terminator with goto inlined entry
          let new_term = MirTerminator {
            kind: MirTerminatorKind::Goto(entry_block),
            span: block.terminator.span.clone()
          }
          new_blocks.push(MirBlock {
            id: block.id.clone(),
            statements: block.statements.clone(),
            terminator: new_term
          })
          
          # Add inlined blocks
          for inlined in inlined_blocks do
            new_blocks.push(inlined)
          end
          
          changed = true
        when Option::None then
          new_blocks.push(block.clone())
        end
      else
        new_blocks.push(block.clone())
      end
    when _ then
      new_blocks.push(block.clone())
    end
  end
  
  if changed then
    caller.blocks = new_blocks
  end
  
  changed
end

def prepare_inline_body(callee: &MirFunction, next_local_id: &mut Int, next_block_id: &mut Int,
                        args: &Vec[MirOperand], dest: &Option[Place], next_block: &Option[BlockId]) 
                        -> (Vec[MirBlock], Map[Int, Int], BlockId)
  # Create mappings for locals and blocks
  mut local_mapping: Map[Int, Int] = Map::new()
  mut block_mapping: Map[Int, Int] = Map::new()
  
  # Map callee parameters to argument values (by copying arg into new local)
  for i in 0..callee.params.len() do
    let new_id = *next_local_id
    *next_local_id = *next_local_id + 1
    local_mapping.insert(callee.params[i].id.id, new_id)
  end
  
  # Map callee locals
  for local in callee.locals do
    let new_id = *next_local_id
    *next_local_id = *next_local_id + 1
    local_mapping.insert(local.id.id, new_id)
  end
  
  # Map callee blocks
  let entry_block_id = *next_block_id
  for block in callee.blocks do
    let new_id = *next_block_id
    *next_block_id = *next_block_id + 1
    block_mapping.insert(block.id.id, new_id)
  end
  
  # Clone and remap blocks
  mut new_blocks: Vec[MirBlock] = Vec::new()
  
  for block in callee.blocks do
    let block_new_id = block_mapping.get(block.id.id).unwrap_or(block.id.id)
    
    # Remap statements
    mut new_stmts: Vec[MirStatement] = Vec::new()
    
    # First, if this is the entry block, add parameter-to-local assignments
    if block.id.id == callee.entry_block.id then
      for i in 0..callee.params.len() do
        if i < args.len() then
          match local_mapping.get(callee.params[i].id.id)
          when Option::Some(new_local) then
            new_stmts.push(MirStatement {
              kind: MirStatementKind::Assign(
                Place { local: LocalId { id: new_local }, projections: Vec::new() },
                MirRvalue { kind: MirRvalueKind::Use(args[i].clone()) }
              ),
              span: callee.span.clone()
            })
          when Option::None then ()
          end
        end
      end
    end
    
    for stmt in block.statements do
      new_stmts.push(remap_statement(&stmt, &local_mapping))
    end
    
    # Remap terminator
    let new_term = remap_terminator(&block.terminator, &local_mapping, &block_mapping, dest, next_block)
    
    new_blocks.push(MirBlock {
      id: BlockId { id: block_new_id },
      statements: new_stmts,
      terminator: new_term
    })
  end
  
  (new_blocks, local_mapping, BlockId { id: entry_block_id })
end

def remap_statement(stmt: &MirStatement, local_map: &Map[Int, Int]) -> MirStatement
  match stmt.kind
  when MirStatementKind::Assign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::Assign(
        remap_place(&place, local_map),
        remap_rvalue(&rvalue, local_map)
      ),
      span: stmt.span.clone()
    }
  when MirStatementKind::Drop(place) then
    MirStatement {
      kind: MirStatementKind::Drop(remap_place(&place, local_map)),
      span: stmt.span.clone()
    }
  when _ then stmt.clone()
  end
end

def remap_place(place: &Place, local_map: &Map[Int, Int]) -> Place
  let new_local = local_map.get(place.local.id).unwrap_or(place.local.id)
  Place {
    local: LocalId { id: new_local },
    projections: place.projections.clone()
  }
end

def remap_rvalue(rv: &MirRvalue, local_map: &Map[Int, Int]) -> MirRvalue
  match rv.kind
  when MirRvalueKind::Use(op) then
    MirRvalue { kind: MirRvalueKind::Use(remap_operand(&op, local_map)) }
  when MirRvalueKind::BinOp(op, lhs, rhs) then
    MirRvalue { kind: MirRvalueKind::BinOp(op.clone(), remap_operand(&lhs, local_map), remap_operand(&rhs, local_map)) }
  when MirRvalueKind::UnOp(op, operand) then
    MirRvalue { kind: MirRvalueKind::UnOp(op.clone(), remap_operand(&operand, local_map)) }
  when MirRvalueKind::Ref(place) then
    MirRvalue { kind: MirRvalueKind::Ref(remap_place(&place, local_map)) }
  when MirRvalueKind::RefMut(place) then
    MirRvalue { kind: MirRvalueKind::RefMut(remap_place(&place, local_map)) }
  when _ then rv.clone()
  end
end

def remap_operand(op: &MirOperand, local_map: &Map[Int, Int]) -> MirOperand
  match op.kind
  when MirOperandKind::Copy(place) then
    MirOperand { kind: MirOperandKind::Copy(remap_place(&place, local_map)) }
  when MirOperandKind::Move(place) then
    MirOperand { kind: MirOperandKind::Move(remap_place(&place, local_map)) }
  when _ then op.clone()
  end
end

def remap_terminator(term: &MirTerminator, local_map: &Map[Int, Int], block_map: &Map[Int, Int],
                     dest: &Option[Place], next_block: &Option[BlockId]) -> MirTerminator
  match term.kind
  when MirTerminatorKind::Return(op) then
    # Replace return with assignment to dest and goto next_block
    match dest
    when Option::Some(dest_place) then
      match op
      when Option::Some(ret_op) then
        # We need to create an assignment, but we can't modify the calling block
        # Instead, replace Return with Goto to next_block (assignment happens elsewhere)
        match next_block
        when Option::Some(nb) then
          MirTerminator { kind: MirTerminatorKind::Goto(nb.clone()), span: term.span.clone() }
        when Option::None then
          MirTerminator { kind: MirTerminatorKind::Return(Option::None), span: term.span.clone() }
        end
      when Option::None then
        match next_block
        when Option::Some(nb) then
          MirTerminator { kind: MirTerminatorKind::Goto(nb.clone()), span: term.span.clone() }
        when Option::None then
          MirTerminator { kind: MirTerminatorKind::Return(Option::None), span: term.span.clone() }
        end
      end
    when Option::None then
      match next_block
      when Option::Some(nb) then
        MirTerminator { kind: MirTerminatorKind::Goto(nb.clone()), span: term.span.clone() }
      when Option::None then
        term.clone()
      end
    end
  when MirTerminatorKind::Goto(target) then
    let new_target = block_map.get(target.id).unwrap_or(target.id)
    MirTerminator { kind: MirTerminatorKind::Goto(BlockId { id: new_target }), span: term.span.clone() }
  when MirTerminatorKind::SwitchInt(op, targets, fallback) then
    mut new_targets: Vec[(Int, BlockId)] = Vec::new()
    for entry in targets do
      let (val, bid) = entry
      let new_bid = block_map.get(bid.id).unwrap_or(bid.id)
      new_targets.push((val, BlockId { id: new_bid }))
    end
    let new_fb = block_map.get(fallback.id).unwrap_or(fallback.id)
    MirTerminator {
      kind: MirTerminatorKind::SwitchInt(remap_operand(&op, local_map), new_targets, BlockId { id: new_fb }),
      span: term.span.clone()
    }
  when _ then term.clone()
  end
end

def optimize_function(f: &mut MirFunction) -> Unit
  # Dead code elimination
  eliminate_dead_code(f)
  
  # Copy propagation
  propagate_copies(f)
  
  # Constant folding
  fold_constants(f)
  
  # Global Value Numbering — eliminate redundant computations
  global_value_numbering(f)
  
  # Loop-Invariant Code Motion — hoist loop-invariant computations
  loop_invariant_code_motion(f)
  
  # Bounds-check elimination — remove redundant array bounds checks
  eliminate_bounds_checks(f)
  
  # Remove redundant moves
  simplify_moves(f)
  
  # Final dead code elimination after all other passes
  eliminate_dead_code(f)
end

def eliminate_dead_code(f: &mut MirFunction) -> Unit
  # Mark reachable blocks from entry
  mut reachable = Set::new()
  mut worklist = Vec::new()
  worklist.push(f.entry_block)
  
  while !worklist.is_empty() do
    match worklist.pop()
    when Option::Some(block_id) then
      if !reachable.contains(block_id) then
        reachable.insert(block_id)
        # Add successors to worklist
        match get_block(f, block_id)
        when Option::Some(block) then
          for succ in terminator_successors(&block.terminator) do
            worklist.push(succ)
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  
  # Remove unreachable blocks
  mut new_blocks = Vec::new()
  for block in f.blocks do
    if reachable.contains(block.id) then
      new_blocks.push(block)
    end
  end
  f.blocks = new_blocks
end

def propagate_copies(f: &mut MirFunction) -> Unit
  # Copy propagation: if we have _x = Copy(_y), replace all uses of _x with _y.
  # Build a substitution map from simple copy assignments, then apply it transitively.
  mut copy_map: Map[Int, LocalId] = Map::new()  # local_id -> source_local_id
  
  # Collect simple copy assignments: _dst = Use(Copy(_src))
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::Use(operand) then
            match operand.kind
            when MirOperandKind::Copy(src_place) then
              if src_place.projections.is_empty() then
                copy_map.insert(place.local.id, src_place.local)
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Resolve transitively: if a -> b -> c, then a -> c
  mut changed = true
  mut iterations = 0
  while changed && iterations < 100 do
    changed = false
    iterations = iterations + 1
    for (id, target) in copy_map do
      match copy_map.get(target.id)
      when Option::Some(deeper) then
        if deeper.id != target.id then
          copy_map.insert(id, deeper.clone())
          changed = true
        end
      when Option::None then ()
      end
    end
  end
  
  # Apply substitution to all operands
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        substitute_rvalue_copies(&mut rvalue, &copy_map)
      when MirStatementKind::ContractCheck(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when MirStatementKind::EffectRecord(_, operand) then
        substitute_operand_copies(&mut operand, &copy_map)
      when _ then ()
      end
    end
    # Also substitute in terminators
    substitute_terminator_copies(&mut block.terminator, &copy_map)
  end
end

def substitute_operand_copies(op: &mut MirOperand, map: &Map[Int, LocalId]) -> Unit
  match op.kind
  when MirOperandKind::Copy(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        op.kind = MirOperandKind::Copy(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when MirOperandKind::Move(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(new_local) then
        op.kind = MirOperandKind::Move(place_local(new_local.clone()))
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def substitute_rvalue_copies(rv: &mut MirRvalue, map: &Map[Int, LocalId]) -> Unit
  match rv.kind
  when MirRvalueKind::Use(op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::BinOp(_, lhs, rhs) then
    substitute_operand_copies(&mut lhs, map)
    substitute_operand_copies(&mut rhs, map)
  when MirRvalueKind::UnOp(_, op) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::Aggregate(_, ops) then
    for o in ops do
      substitute_operand_copies(&mut o, map)
    end
  when MirRvalueKind::Cast(_, op, _) then substitute_operand_copies(&mut op, map)
  when MirRvalueKind::Repeat(op, _) then substitute_operand_copies(&mut op, map)
  when _ then ()
  end
end

def substitute_terminator_copies(term: &mut MirTerminator, map: &Map[Int, LocalId]) -> Unit
  match term.kind
  when MirTerminatorKind::SwitchInt(op, _, _) then
    substitute_operand_copies(&mut op, map)
  when MirTerminatorKind::Call(_, _, args, _, _) then
    for arg in args do
      substitute_operand_copies(&mut arg, map)
    end
  when MirTerminatorKind::Assert(op, _, _, _, _) then
    substitute_operand_copies(&mut op, map)
  when MirTerminatorKind::Yield(op, _) then
    substitute_operand_copies(&mut op, map)
  when _ then ()
  end
end

def fold_constants(f: &mut MirFunction) -> Unit
  # Evaluate binary/unary operations on known integer/bool constants at compile time.
  # Also folds simple branch conditions when the discriminant is constant.
  mut changed = true
  mut iterations = 0
  while changed && iterations < 10 do
    changed = false
    iterations = iterations + 1
    
    for block in f.blocks do
      mut new_stmts = Vec::new()
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::Assign(place, rvalue) then
          match try_fold_rvalue(&rvalue)
          when Option::Some(folded) then
            new_stmts.push(MirStatement {
              kind: MirStatementKind::Assign(place, folded),
              span: stmt.span
            })
            changed = true
          when Option::None then
            new_stmts.push(stmt)
          end
        when _ then new_stmts.push(stmt)
        end
      end
      block.statements = new_stmts
    end
  end
end

def try_fold_rvalue(rv: &MirRvalue) -> Option[MirRvalue]
  match rv.kind
  when MirRvalueKind::BinOp(op, lhs, rhs) then
    try_fold_binop(op, &lhs, &rhs)
  when MirRvalueKind::UnOp(op, operand) then
    try_fold_unop(op, &operand)
  when _ then Option::None
  end
end

def try_fold_binop(op: MirBinOp, lhs: &MirOperand, rhs: &MirOperand) -> Option[MirRvalue]
  # Only fold if both operands are integer constants
  let l = extract_int_constant(lhs)
  let r = extract_int_constant(rhs)
  match (l, r)
  when (Option::Some(lv), Option::Some(rv)) then
    let result = match op
    when MirBinOp::Add then Option::Some(lv + rv)
    when MirBinOp::Sub then Option::Some(lv - rv)
    when MirBinOp::Mul then Option::Some(lv * rv)
    when MirBinOp::Div then
      if rv != 0 then Option::Some(lv / rv) else Option::None end
    when MirBinOp::Mod then
      if rv != 0 then Option::Some(lv % rv) else Option::None end
    when MirBinOp::BitAnd then Option::Some(lv & rv)
    when MirBinOp::BitOr then Option::Some(lv | rv)
    when MirBinOp::BitXor then Option::Some(lv ^ rv)
    when MirBinOp::Shl then Option::Some(lv << rv)
    when MirBinOp::Shr then Option::Some(lv >> rv)
    when _ then Option::None
    end
    match result
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::Use(MirOperand {
          kind: MirOperandKind::Constant(MirConstant {
            kind: MirConstantKind::Int(val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  when _ then
    # Try boolean constant folding for comparison operators
    let lb = extract_bool_constant(lhs)
    let rb = extract_bool_constant(rhs)
    match (lb, rb)
    when (Option::Some(lbv), Option::Some(rbv)) then
      let result = match op
      when MirBinOp::Eq then Option::Some(lbv == rbv)
      when MirBinOp::Ne then Option::Some(lbv != rbv)
      when _ then Option::None
      end
      match result
      when Option::Some(val) then
        Option::Some(MirRvalue {
          kind: MirRvalueKind::Use(MirOperand {
            kind: MirOperandKind::Constant(MirConstant {
              kind: MirConstantKind::Bool(val),
              ty: Type::Bool
            })
          })
        })
      when Option::None then Option::None
      end
    when _ then Option::None
    end
  end
end

def try_fold_unop(op: MirUnOp, operand: &MirOperand) -> Option[MirRvalue]
  match op
  when MirUnOp::Neg then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::Use(MirOperand {
          kind: MirOperandKind::Constant(MirConstant {
            kind: MirConstantKind::Int(0 - val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::Not then
    match extract_bool_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::Use(MirOperand {
          kind: MirOperandKind::Constant(MirConstant {
            kind: MirConstantKind::Bool(!val),
            ty: Type::Bool
          })
        })
      })
    when Option::None then Option::None
    end
  when MirUnOp::BitNot then
    match extract_int_constant(operand)
    when Option::Some(val) then
      Option::Some(MirRvalue {
        kind: MirRvalueKind::Use(MirOperand {
          kind: MirOperandKind::Constant(MirConstant {
            kind: MirConstantKind::Int(~val),
            ty: Type::Int
          })
        })
      })
    when Option::None then Option::None
    end
  end
end

def extract_int_constant(op: &MirOperand) -> Option[Int]
  match op.kind
  when MirOperandKind::Constant(c) then
    match c.kind
    when MirConstantKind::Int(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

def extract_bool_constant(op: &MirOperand) -> Option[Bool]
  match op.kind
  when MirOperandKind::Constant(c) then
    match c.kind
    when MirConstantKind::Bool(v) then Option::Some(v)
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Bounds-Check Elimination
# ———————————————————————————————————————————————————————————————
#
# Removes redundant bounds checks when we can prove the index is within bounds.
# This optimization uses value range analysis to track known bounds on variables.
#
# Cases handled:
# 1. Index is a constant within 0..len (when len is known)
# 2. Index was already checked earlier (dominates current check)
# 3. Loop induction variable with known range
# 4. Index derived from len (e.g., len-1 is always valid if len > 0)

struct ValueRange
  min: Option[Int]  # Known lower bound (inclusive)
  max: Option[Int]  # Known upper bound (inclusive)
end

def eliminate_bounds_checks(f: &mut MirFunction) -> Unit
  # Track known ranges for each local
  mut ranges: Map[Int, ValueRange] = Map::new()
  
  # Track proven assertions (block_id, local_id) -> proven valid
  mut proven_checks: Set[(Int, Int, String)] = Set::new()  # (block_id, local_id, array_local_id)
  
  # Iterate through blocks in dominator order
  let dom_info = compute_dominators(f)
  let rpo = compute_reverse_postorder(f)
  
  # Initialize ranges for constants we can extract
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if place.projections.is_empty() then
          match extract_int_constant_from_rvalue(&rvalue)
          when Option::Some(val) then
            ranges.insert(place.local.id, ValueRange {
              min: Option::Some(val),
              max: Option::Some(val)
            })
          when Option::None then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Now eliminate redundant bounds checks
  for block in f.blocks do
    mut new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Nop then
        new_stmts.push(stmt.clone())
      when _ then
        new_stmts.push(stmt.clone())
      end
    end
    
    # Check terminator for bounds assertions
    match block.terminator.kind
    when MirTerminatorKind::Assert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # Extract local IDs from operands
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match (index_local, len_local)
        when (Option::Some(idx_lid), Option::Some(len_lid)) then
          # Check if we can prove this bounds check
          if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
            # Replace assertion with unconditional goto to success
            block.terminator = MirTerminator {
              kind: MirTerminatorKind::Goto(success),
              span: block.terminator.span.clone()
            }
          else
            # Record this check as proven for dominated blocks
            proven_checks.insert((block.id.id, idx_lid.id, len_lid.id.to_string()))
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
    
    block.statements = new_stmts
  end
  
  # Range propagation for loop induction variables
  propagate_loop_ranges(f, &mut ranges)
  
  # Second pass with better range information
  for block in f.blocks do
    match block.terminator.kind
    when MirTerminatorKind::Assert(op, expected, msg, success, cleanup) then
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        let index_local = extract_local_from_operand(&index_op)
        let len_local = extract_local_from_operand(&len_op)
        match (index_local, len_local)
        when (Option::Some(idx_lid), Option::Some(len_lid)) then
          if can_prove_bounds_check(idx_lid, len_lid, &ranges, block.id, &proven_checks) then
            block.terminator = MirTerminator {
              kind: MirTerminatorKind::Goto(success),
              span: block.terminator.span.clone()
            }
          end
        when _ then ()
        end
      when _ then ()
      end
    when _ then ()
    end
  end
end

def extract_local_from_operand(op: &MirOperand) -> Option[LocalId]
  match op.kind
  when MirOperandKind::Copy(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when MirOperandKind::Move(place) then
    if place.projections.is_empty() then
      Option::Some(place.local.clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

def extract_int_constant_from_rvalue(rv: &MirRvalue) -> Option[Int]
  match rv.kind
  when MirRvalueKind::Use(op) then
    extract_int_constant(&op)
  when _ then Option::None
  end
end

def can_prove_bounds_check(index_local: LocalId, len_local: LocalId, ranges: &Map[Int, ValueRange],
                            block_id: BlockId, proven: &Set[(Int, Int, String)]) -> Bool
  # Check 1: Index is a constant in [0, len)
  match ranges.get(index_local.id)
  when Option::Some(idx_range) then
    match (idx_range.min, idx_range.max)
    when (Option::Some(min_val), Option::Some(max_val)) then
      if min_val >= 0 then
        match ranges.get(len_local.id)
        when Option::Some(len_range) then
          match len_range.min
          when Option::Some(min_len) then
            if max_val < min_len then
              return true
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    when _ then ()
    end
  when Option::None then ()
  end
  
  # Check 2: Already proven in a dominating block
  # (Simplified: check if same index/len pair was checked in an earlier block)
  if proven.contains((block_id.id, index_local.id, len_local.id.to_string())) then
    return true
  end
  
  false
end

def propagate_loop_ranges(f: &MirFunction, ranges: &mut Map[Int, ValueRange]) -> Unit
  # Find loop induction variables and compute their ranges
  let loops = find_natural_loops(f)
  
  for loop_info in loops do
    # Find induction variable patterns:
    # 1. i starts at 0 (or known value)
    # 2. i increments by constant each iteration
    # 3. Loop condition is i < len
    
    mut induction_vars: Vec[(LocalId, Int, Int)] = Vec::new()  # (var, start, step)
    
    # Look for typical induction patterns in loop blocks
    for block_id in loop_info.blocks do
      match get_block(f, BlockId { id: block_id })
      when Option::Some(block) then
        for stmt in block.statements do
          match stmt.kind
          when MirStatementKind::Assign(place, rvalue) then
            # Pattern: i = i + 1
            match rvalue.kind
            when MirRvalueKind::BinOp(MirBinOp::Add, lhs, rhs) then
              match (lhs.kind, extract_int_constant(&rhs))
              when (MirOperandKind::Copy(src_place), Option::Some(step)) then
                if src_place.local.id == place.local.id && place.projections.is_empty() then
                  # Found an induction variable
                  let start = ranges.get(place.local.id)
                    .map(|r| r.min.unwrap_or(0))
                    .unwrap_or(0)
                  induction_vars.push((place.local.clone(), start, step))
                end
              when _ then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
        
        # Check loop exit condition
        match block.terminator.kind
        when MirTerminatorKind::SwitchInt(op, _, _) then
          # If we have i < len as condition, we know i is bounded
          match op.kind
          when MirOperandKind::Copy(p) then
            # Track that this variable is bounded by the loop
            if !p.projections.is_empty() then
              ()  # Skip complex projections
            end
          when _ then ()
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
    
    # Update ranges for induction variables
    for iv in induction_vars do
      let (var, start, step) = iv
      if step > 0 then
        # Increasing induction variable: min is start, max depends on loop bound
        ranges.insert(var.id, ValueRange {
          min: Option::Some(start),
          max: Option::None  # Unknown upper bound without more analysis
        })
      end
    end
  end
end

def simplify_moves(f: &mut MirFunction) -> Unit
  # Remove redundant moves: _x = Move(_x) or _x = Copy(_x) where src == dst.
  # Also remove chains like: _tmp = Move(_x); _y = Move(_tmp) → _y = Move(_x)
  # when _tmp has no other uses.
  
  # Pass 1: Remove self-assignments
  for block in f.blocks do
    mut new_stmts = Vec::new()
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if is_self_assignment(&place, &rvalue) then
          # Skip this statement — it's a no-op
          ()
        else
          new_stmts.push(stmt)
        end
      when _ then new_stmts.push(stmt)
      end
    end
    block.statements = new_stmts
  end
  
  # Pass 2: Count uses of each local
  mut use_count: Map[Int, Int] = Map::new()
  for local in f.locals do
    use_count.insert(local.id.id, 0)
  end
  for block in f.blocks do
    for stmt in block.statements do
      count_operand_uses(&stmt, &mut use_count)
    end
    count_terminator_uses(&block.terminator, &mut use_count)
  end
  
  # Pass 3: Eliminate single-use temporaries
  # If _tmp = Move(_x) and _y = Move(_tmp) and _tmp used only once, 
  # rewrite to _y = Move(_x)
  mut temp_source: Map[Int, Place] = Map::new()
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if place.projections.is_empty() then
          match rvalue.kind
          when MirRvalueKind::Use(op) then
            match op.kind
            when MirOperandKind::Move(src) then
              match use_count.get(place.local.id)
              when Option::Some(count) then
                if count <= 1 then
                  temp_source.insert(place.local.id, src)
                end
              when Option::None then ()
              end
            when _ then ()
            end
          when _ then ()
          end
        end
      when _ then ()
      end
    end
  end
  
  # Apply temp_source substitution
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(_, rvalue) then
        substitute_temp_moves(&mut rvalue, &temp_source)
      when _ then ()
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Global Value Numbering (GVN)
# ———————————————————————————————————————————————————————————————
#
# Eliminates redundant computations by assigning a "value number" to each
# expression. If two expressions produce the same value number, the second
# one is replaced with a copy of the first result.
#
# Value number key = (operation, operand_value_numbers...)
# E.g., Add(VN(3), VN(5)) has a unique key; if we see it again, we reuse
# the result instead of recomputing.

def global_value_numbering(f: &mut MirFunction) -> Unit
  # Map: rvalue_key -> LocalId that already holds this value
  mut value_table: Map[String, LocalId] = Map::new()
  
  # Map: LocalId.id -> canonical value number (string)
  mut local_vn: Map[Int, String] = Map::new()
  mut vn_counter = 0
  
  # Assign initial value numbers to parameters (each is unique)
  for p in f.params do
    let vn = "p" + vn_counter.to_string()
    vn_counter = vn_counter + 1
    local_vn.insert(p.id.id, vn)
  end
  
  for block in f.blocks do
    mut new_stmts = Vec::new()
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if place.projections.is_empty() then
          # Compute the value number key for this rvalue
          let rv_key = rvalue_to_vn_key(&rvalue, &local_vn)
          
          match value_table.get(rv_key.clone())
          when Option::Some(existing_local) then
            # Redundant computation — replace with copy
            let copy_rvalue = MirRvalue {
              kind: MirRvalueKind::Use(MirOperand {
                kind: MirOperandKind::Copy(place_local(existing_local.clone()))
              })
            }
            new_stmts.push(MirStatement {
              kind: MirStatementKind::Assign(place.clone(), copy_rvalue),
              span: stmt.span
            })
            # Inherit the value number
            match local_vn.get(existing_local.id) 
            when Option::Some(vn) then local_vn.insert(place.local.id, vn.clone())
            when Option::None then ()
            end
          when Option::None then
            # New computation — record it
            value_table.insert(rv_key.clone(), place.local.clone())
            local_vn.insert(place.local.id, rv_key)
            new_stmts.push(stmt.clone())
          end
        else
          new_stmts.push(stmt.clone())
        end
      when _ then new_stmts.push(stmt.clone())
      end
    end
    
    block.statements = new_stmts
  end
end

def rvalue_to_vn_key(rv: &MirRvalue, local_vn: &Map[Int, String]) -> String
  match rv.kind
  when MirRvalueKind::Use(op) then
    "use(" + operand_to_vn(&op, local_vn) + ")"
  when MirRvalueKind::BinOp(op, lhs, rhs) then
    let op_str = match op
    when MirBinOp::Add then "add"
    when MirBinOp::Sub then "sub"
    when MirBinOp::Mul then "mul"
    when MirBinOp::Div then "div"
    when MirBinOp::Mod then "mod"
    when MirBinOp::Eq then "eq"
    when MirBinOp::Ne then "ne"
    when MirBinOp::Lt then "lt"
    when MirBinOp::Le then "le"
    when MirBinOp::Gt then "gt"
    when MirBinOp::Ge then "ge"
    when MirBinOp::BitAnd then "band"
    when MirBinOp::BitOr then "bor"
    when MirBinOp::BitXor then "bxor"
    when MirBinOp::Shl then "shl"
    when MirBinOp::Shr then "shr"
    when _ then "?"
    end
    op_str + "(" + operand_to_vn(&lhs, local_vn) + "," + operand_to_vn(&rhs, local_vn) + ")"
  when MirRvalueKind::UnOp(op, inner) then
    let op_str = match op
    when MirUnOp::Neg then "neg"
    when MirUnOp::Not then "not"
    when MirUnOp::BitNot then "bnot"
    end
    op_str + "(" + operand_to_vn(&inner, local_vn) + ")"
  when MirRvalueKind::Cast(kind, op, ty) then
    "cast(" + operand_to_vn(&op, local_vn) + ")"
  when _ then
    # Aggregates, refs, etc. — assign unique key (don't deduplicate)
    "unique_" + local_vn.len().to_string()
  end
end

def operand_to_vn(op: &MirOperand, local_vn: &Map[Int, String]) -> String
  match op.kind
  when MirOperandKind::Constant(cst) then
    match cst.kind
    when MirConstantKind::Int(n) then "i" + n.to_string()
    when MirConstantKind::Float(f) then "f" + f.to_string()
    when MirConstantKind::Bool(b) then if b then "true" else "false" end
    when MirConstantKind::String(s) then "s\"" + s + "\""
    when MirConstantKind::Unit then "unit"
    when MirConstantKind::FnItem(name) then "fn:" + name
    when MirConstantKind::Char(c) then "c'" + c.to_string() + "'"
    when MirConstantKind::ZeroSized then "zst"
    end
  when MirOperandKind::Copy(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  when MirOperandKind::Move(place) then
    if place.projections.is_empty() then
      match local_vn.get(place.local.id)
      when Option::Some(vn) then vn.clone()
      when Option::None then "l" + place.local.id.to_string()
      end
    else
      "proj_" + place.local.id.to_string()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Loop-Invariant Code Motion (LICM)
# ———————————————————————————————————————————————————————————————
#
# Identifies computations inside loops that produce the same result in
# every iteration and hoists them to the loop preheader.
#
# A statement is loop-invariant if:
#   - All its operands are defined outside the loop, OR
#   - All its operands are themselves loop-invariant

def loop_invariant_code_motion(f: &mut MirFunction) -> Unit
  # Step 1: Detect natural loops using back edges
  let loops = find_natural_loops(f)
  
  # Step 2: For each loop, find invariant statements and hoist them
  for loop_info in loops do
    hoist_loop_invariants(f, &loop_info)
  end
end

struct NaturalLoop
  header: BlockId
  blocks: Set[Int]     # Block IDs that form the loop body
  preheader: Option[BlockId]
end

def find_natural_loops(f: &MirFunction) -> Vec[NaturalLoop]
  # Find back edges and compute the natural loop for each.
  # A back edge is an edge n -> h where h dominates n.
  
  # Simplified dominator computation: BFS from entry, build a dominator tree
  # For correctness, we use a simple "reachable before" heuristic:
  # h dominates n if h appears in every path from entry to n.
  
  mut loops = Vec::new()
  
  # Find back edges: an edge to a block that we've already visited in DFS
  mut visited = Set::new()
  mut stack = Vec::new()
  stack.push(f.entry_block)
  
  mut back_edges: Vec[(BlockId, BlockId)] = Vec::new()
  
  while !stack.is_empty() do
    match stack.pop()
    when Option::Some(block_id) then
      if !visited.contains(block_id.id) then
        visited.insert(block_id.id)
        match get_block(f, block_id)
        when Option::Some(block) then
          for succ in terminator_successors(&block.terminator) do
            if visited.contains(succ.id) then
              # Back edge: block_id -> succ (succ is the loop header)
              back_edges.push((block_id, succ))
            else
              stack.push(succ)
            end
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  
  # For each back edge, compute the natural loop
  for edge in back_edges do
    let (tail, header) = edge
    mut loop_blocks = Set::new()
    loop_blocks.insert(header.id)
    
    # Flood backwards from tail to header to find loop body
    if tail.id != header.id then
      mut worklist = Vec::new()
      worklist.push(tail)
      loop_blocks.insert(tail.id)
      
      while !worklist.is_empty() do
        match worklist.pop()
        when Option::Some(n) then
          # Add predecessors
          for block in f.blocks do
            for succ in terminator_successors(&block.terminator) do
              if succ.id == n.id && !loop_blocks.contains(block.id.id) then
                loop_blocks.insert(block.id.id)
                worklist.push(block.id)
              end
            end
          end
        when Option::None then ()
        end
      end
    end
    
    loops.push(NaturalLoop {
      header: header,
      blocks: loop_blocks,
      preheader: Option::None   # Will be created if needed
    })
  end
  
  loops
end

def hoist_loop_invariants(f: &mut MirFunction, loop_info: &NaturalLoop) -> Unit
  # Find definitions inside the loop
  mut loop_defs: Set[Int] = Set::new()
  for block in f.blocks do
    if loop_info.blocks.contains(block.id.id) then
      for stmt in block.statements do
        match stmt.kind
        when MirStatementKind::Assign(place, _) then
          loop_defs.insert(place.local.id)
        when _ then ()
        end
      end
    end
  end
  
  # Find loop-invariant statements:
  # An assignment is invariant if all its operand locals are defined outside the loop
  mut invariant_stmts: Vec[MirStatement] = Vec::new()
  
  for block in f.blocks do
    if loop_info.blocks.contains(block.id.id) && block.id.id != loop_info.header.id then
      mut remaining_stmts = Vec::new()
      for stmt in block.statements do
        if is_loop_invariant_stmt(&stmt, &loop_defs) then
          invariant_stmts.push(stmt.clone())
        else
          remaining_stmts.push(stmt.clone())
        end
      end
      block.statements = remaining_stmts
    end
  end
  
  # If we found invariant statements, prepend them to the loop header
  if !invariant_stmts.is_empty() then
    match get_block_mut(f, loop_info.header)
    when Option::Some(header_block) then
      mut hoisted = invariant_stmts.clone()
      for s in header_block.statements do
        hoisted.push(s)
      end
      header_block.statements = hoisted
    when Option::None then ()
    end
  end
end

def is_loop_invariant_stmt(stmt: &MirStatement, loop_defs: &Set[Int]) -> Bool
  match stmt.kind
  when MirStatementKind::Assign(_, rvalue) then
    is_loop_invariant_rvalue(&rvalue, loop_defs)
  when _ then false
  end
end

def is_loop_invariant_rvalue(rv: &MirRvalue, loop_defs: &Set[Int]) -> Bool
  match rv.kind
  when MirRvalueKind::Use(op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::BinOp(_, lhs, rhs) then
    is_loop_invariant_operand(&lhs, loop_defs) &&
    is_loop_invariant_operand(&rhs, loop_defs)
  when MirRvalueKind::UnOp(_, op) then
    is_loop_invariant_operand(&op, loop_defs)
  when MirRvalueKind::Cast(_, op, _) then
    is_loop_invariant_operand(&op, loop_defs)
  when _ then false  # Aggregates, refs — don't move
  end
end

def is_loop_invariant_operand(op: &MirOperand, loop_defs: &Set[Int]) -> Bool
  match op.kind
  when MirOperandKind::Constant(_) then true  # Constants are always invariant
  when MirOperandKind::Copy(place) then
    !loop_defs.contains(place.local.id)  # Not defined inside loop
  when MirOperandKind::Move(place) then
    !loop_defs.contains(place.local.id)
  end
end

def get_block_mut(f: &mut MirFunction, id: BlockId) -> Option[&mut MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(&mut block)
    end
  end
  Option::None
end

def is_self_assignment(place: &Place, rvalue: &MirRvalue) -> Bool
  if !place.projections.is_empty() then
    return false
  end
  match rvalue.kind
  when MirRvalueKind::Use(op) then
    match op.kind
    when MirOperandKind::Copy(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when MirOperandKind::Move(src) then
      src.projections.is_empty() && src.local.id == place.local.id
    when _ then false
    end
  when _ then false
  end
end

def count_operand_uses(stmt: &MirStatement, counts: &mut Map[Int, Int]) -> Unit
  match stmt.kind
  when MirStatementKind::Assign(_, rvalue) then
    count_rvalue_uses(&rvalue, counts)
  when MirStatementKind::ContractCheck(_, op) then
    count_op_uses(&op, counts)
  when MirStatementKind::EffectRecord(_, op) then
    count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_op_uses(op: &MirOperand, counts: &mut Map[Int, Int]) -> Unit
  match op.kind
  when MirOperandKind::Copy(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when MirOperandKind::Move(place) then
    match counts.get(place.local.id)
    when Option::Some(n) then counts.insert(place.local.id, n + 1)
    when Option::None then counts.insert(place.local.id, 1)
    end
  when _ then ()
  end
end

def count_rvalue_uses(rv: &MirRvalue, counts: &mut Map[Int, Int]) -> Unit
  match rv.kind
  when MirRvalueKind::Use(op) then count_op_uses(&op, counts)
  when MirRvalueKind::BinOp(_, lhs, rhs) then
    count_op_uses(&lhs, counts)
    count_op_uses(&rhs, counts)
  when MirRvalueKind::UnOp(_, op) then count_op_uses(&op, counts)
  when MirRvalueKind::Aggregate(_, ops) then
    for o in ops do count_op_uses(&o, counts) end
  when MirRvalueKind::Cast(_, op, _) then count_op_uses(&op, counts)
  when MirRvalueKind::Repeat(op, _) then count_op_uses(&op, counts)
  when _ then ()
  end
end

def count_terminator_uses(term: &MirTerminator, counts: &mut Map[Int, Int]) -> Unit
  match term.kind
  when MirTerminatorKind::SwitchInt(op, _, _) then count_op_uses(&op, counts)
  when MirTerminatorKind::Call(_, _, args, _, _) then
    for a in args do count_op_uses(&a, counts) end
  when MirTerminatorKind::Assert(op, _, _, _, _) then count_op_uses(&op, counts)
  when MirTerminatorKind::Yield(op, _) then count_op_uses(&op, counts)
  when _ then ()
  end
end

def substitute_temp_moves(rv: &mut MirRvalue, map: &Map[Int, Place]) -> Unit
  match rv.kind
  when MirRvalueKind::Use(op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::BinOp(_, lhs, rhs) then
    substitute_move_operand(&mut lhs, map)
    substitute_move_operand(&mut rhs, map)
  when MirRvalueKind::UnOp(_, op) then substitute_move_operand(&mut op, map)
  when MirRvalueKind::Aggregate(_, ops) then
    for o in ops do substitute_move_operand(&mut o, map) end
  when _ then ()
  end
end

def substitute_move_operand(op: &mut MirOperand, map: &Map[Int, Place]) -> Unit
  match op.kind
  when MirOperandKind::Move(place) then
    if place.projections.is_empty() then
      match map.get(place.local.id)
      when Option::Some(src) then
        op.kind = MirOperandKind::Move(src.clone())
      when Option::None then ()
      end
    end
  when _ then ()
  end
end

def get_block(f: &MirFunction, id: BlockId) -> Option[MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(block)
    end
  end
  Option::None
end

def terminator_successors(term: &MirTerminator) -> Vec[BlockId]
  mut result = Vec::new()
  match term.kind
  when MirTerminatorKind::Goto(target) then
    result.push(target)
  when MirTerminatorKind::SwitchInt(_, targets, default) then
    for t in targets do
      result.push(t.target)
    end
    result.push(default)
  when MirTerminatorKind::Call(_, _, _, success, unwind) then
    result.push(success)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::Drop(_, next, unwind) then
    result.push(next)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::Assert(_, _, _, success, unwind) then
    result.push(success)
    match unwind
    when Option::Some(uw) then result.push(uw)
    when Option::None then ()
    end
  when MirTerminatorKind::Yield(_, resume) then
    result.push(resume)
  when _ then ()
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Async/Await State Machine Transformation
# ———————————————————————————————————————————————————————————————
#
# Transforms async functions into state machines:
#   - Each yield/await point becomes a state
#   - A state discriminant local tracks the current state
#   - The function becomes a poll() method on a generated Future struct
#   - Locals that live across yield points are promoted to struct fields
#
# Generated layout:
#   struct __AsyncFn_<name> {
#     state: Int               // Current state discriminant
#     local_1: T1              // Locals live across yields
#     local_2: T2
#     ...
#   }
#
#   impl Future for __AsyncFn_<name> {
#     fn poll(&mut self, cx: &mut Context) -> Poll<ReturnType>
#   }

struct AsyncStateMachine
  original_name: String
  state_struct_name: String
  states: Vec[AsyncState]
  cross_yield_locals: Set[Int]   # LocalId.id values that live across yields
end

struct AsyncState
  id: Int
  entry_block: BlockId
  exit_kind: AsyncExitKind
end

enum AsyncExitKind
  Yield(BlockId)      # Yields to a resume block
  Return              # Final return
  Continue(BlockId)   # Non-suspending transition
end

def transform_async_functions(program: &mut MirProgram) -> Unit
  # Process all async functions — transform them into state machines
  mut new_functions = Vec::new()
  
  for func in program.functions do
    if func.is_async then
      let transformed = transform_async_function(&func)
      new_functions.push(transformed)
    else
      new_functions.push(func.clone())
    end
  end
  
  program.functions = new_functions
end

def transform_async_function(func: &MirFunction) -> MirFunction
  # Step 1: Find all yield/await points
  let yield_points = find_yield_points(func)
  
  if yield_points.is_empty() then
    # No yields — just make it synchronous
    return func.clone()
  end
  
  # Step 2: Find locals that live across yield points
  let cross_yield = find_cross_yield_locals(func, &yield_points)
  
  # Step 3: Assign state IDs to blocks
  # State 0 = initial entry
  # Each yield point creates a new state for its resume
  mut state_counter = 0
  mut block_to_state: Map[Int, Int] = Map::new()
  
  # Initial state starts at the entry block
  block_to_state.insert(func.entry_block.id, 0)
  state_counter = 1
  
  # Each yield resume point gets a new state
  for yield_block in yield_points do
    match get_block(func, yield_block)
    when Option::Some(block) then
      match block.terminator.kind
      when MirTerminatorKind::Yield(_, resume) then
        block_to_state.insert(resume.id, state_counter)
        state_counter = state_counter + 1
      when _ then ()
      end
    when Option::None then ()
    end
  end
  
  # Step 4: Transform the function
  # Add a state discriminant local
  mut new_func = func.clone()
  new_func.name = "__poll_" + func.name.clone()
  
  let state_local = MirLocal {
    id: LocalId { id: new_func.locals.len() },
    name: "__state".to_string(),
    ty: Type::Int,
    is_mut: true,
    span: func.span
  }
  new_func.locals.push(state_local.clone())
  
  # Step 5: Rewrite yield terminators as:
  #   1. Save state discriminant
  #   2. Return Poll::Pending
  # And add state dispatch at the entry:
  #   switch(__state) -> [0: bb0, 1: resume1, 2: resume2, ...]
  
  let dispatch_block = MirBlock {
    id: BlockId { id: new_func.blocks.len() },
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::Unreachable,  # Will be replaced
      span: func.span
    }
  }
  
  # Build switch targets for the dispatch
  mut switch_targets = Vec::new()
  for entry in block_to_state do
    switch_targets.push(SwitchTarget {
      value: entry.value,
      target: BlockId { id: entry.key }
    })
  end
  
  # Set dispatch terminator: switch on state local
  let state_operand = MirOperand {
    kind: MirOperandKind::Copy(place_local(state_local.id))
  }
  
  let dispatch = MirBlock {
    id: dispatch_block.id,
    statements: Vec::new(),
    terminator: MirTerminator {
      kind: MirTerminatorKind::SwitchInt(
        state_operand,
        switch_targets,
        func.entry_block   # Default to entry state
      ),
      span: func.span
    }
  }
  new_func.blocks.push(dispatch)
  new_func.entry_block = dispatch.id
  
  # Step 6: Rewrite Yield terminators
  for block in new_func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::Yield(value, resume) then
      # Save the resume state
      let resume_state_id = match block_to_state.get(resume.id)
      when Option::Some(s) then s
      when Option::None then 0
      end
      
      # Replace with: assign state = resume_state; return Poll::Pending
      block.statements.push(MirStatement {
        kind: MirStatementKind::Assign(
          place_local(state_local.id),
          MirRvalue { kind: MirRvalueKind::Use(MirOperand {
            kind: MirOperandKind::Constant(MirConstant {
              kind: MirConstantKind::Int(resume_state_id),
              ty: Type::Int
            })
          }) }
        ),
        span: func.span
      })
      
      # Store the yielded value in return place
      block.statements.push(MirStatement {
        kind: MirStatementKind::Assign(
          place_local(LocalId { id: 0 }),
          MirRvalue { kind: MirRvalueKind::Use(value.clone()) }
        ),
        span: func.span
      })
      
      block.terminator = MirTerminator {
        kind: MirTerminatorKind::Return,
        span: func.span
      }
    when _ then ()
    end
  end
  
  new_func
end

def find_yield_points(func: &MirFunction) -> Vec[BlockId]
  mut yields = Vec::new()
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::Yield(_, _) then
      yields.push(block.id)
    when _ then ()
    end
  end
  yields
end

def find_cross_yield_locals(func: &MirFunction, yield_points: &Vec[BlockId]) -> Set[Int]
  # Find locals that are defined before a yield and used after a yield.
  # These need to be stored in the coroutine state struct.
  mut cross = Set::new()
  
  # Build def/use sets for each block
  mut defs_before_yield: Set[Int] = Set::new()
  mut uses_after_yield: Set[Int] = Set::new()
  mut past_yield = false
  
  for block in func.blocks do
    let is_yield = yield_points.iter().any(|yp| yp.id == block.id.id)
    
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        if !past_yield then
          defs_before_yield.insert(place.local.id)
        end
        # Track uses in the rvalue
        match rvalue.kind
        when MirRvalueKind::Use(op) then
          match op.kind
          when MirOperandKind::Copy(p) then
            if past_yield then uses_after_yield.insert(p.local.id) end
          when MirOperandKind::Move(p) then
            if past_yield then uses_after_yield.insert(p.local.id) end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
    
    if is_yield then
      past_yield = true
    end
  end
  
  # Cross-yield locals are those defined before AND used after a yield
  for local_id in defs_before_yield do
    if uses_after_yield.contains(local_id) then
      cross.insert(local_id)
    end
  end
  
  cross
end

# ———————————————————————————————————————————————————————————————
# SSA Conversion
# ———————————————————————————————————————————————————————————————
#
# Converts MIR to strict SSA form:
# 1. Compute dominance tree and dominance frontiers
# 2. Insert Phi nodes at appropriate join points
# 3. Rename variables with version numbering

struct DomInfo
  idom: Map[Int, Int]         # immediate dominator: block_id -> dominator_id
  dom_frontier: Map[Int, Set[Int]]  # dominance frontier sets
  dom_tree_children: Map[Int, Vec[Int]]  # dominator tree children
end

def convert_to_ssa(f: &mut MirFunction) -> Unit
  let dom_info = compute_dominators(f)
  insert_phi_nodes(f, &dom_info)
  rename_variables(f, &dom_info)
end

def compute_dominators(f: &MirFunction) -> DomInfo
  # Convert entry block to Int
  let entry = f.entry_block.id
  
  # Map each block ID to index for iteration
  mut block_ids = Vec::new()
  for block in f.blocks do
    block_ids.push(block.id.id)
  end
  
  # Initialize dominators: idom[entry] = entry, others = undefined (-1)
  mut idom: Map[Int, Int] = Map::new()
  idom.insert(entry, entry)
  
  # Compute predecessors
  mut preds: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    preds.insert(b, Vec::new())
  end
  for block in f.blocks do
    for succ in terminator_successors(&block.terminator) do
      match preds.get(succ.id)
      when Option::Some(p) then
        p.push(block.id.id)
      when Option::None then ()
      end
    end
  end
  
  # Reverse postorder for iteration
  let rpo = compute_reverse_postorder(f)
  
  # Iterative dominator computation (Cooper/Harvey/Kennedy algorithm)
  mut changed = true
  while changed do
    changed = false
    for b in rpo do
      if b == entry then next end
      
      mut new_idom = -1
      match preds.get(b)
      when Option::Some(pred_list) then
        for p in pred_list do
          if idom.contains_key(p) then
            if new_idom == -1 then
              new_idom = p
            else
              new_idom = intersect_doms(&idom, new_idom, p)
            end
          end
        end
      when Option::None then ()
      end
      
      if new_idom != -1 then
        match idom.get(b)
        when Option::Some(old) then
          if old != new_idom then
            idom.insert(b, new_idom)
            changed = true
          end
        when Option::None then
          idom.insert(b, new_idom)
          changed = true
        end
      end
    end
  end
  
  # Compute dominance frontiers
  mut dom_frontier: Map[Int, Set[Int]] = Map::new()
  for b in block_ids do
    dom_frontier.insert(b, Set::new())
  end
  
  for b in block_ids do
    match preds.get(b)
    when Option::Some(pred_list) then
      if pred_list.len() >= 2 then
        for p in pred_list do
          mut runner = p
          while runner != -1 do
            match idom.get(b)
            when Option::Some(idom_b) then
              if runner == idom_b then
                break
              end
            when Option::None then break
            end
            match dom_frontier.get(runner)
            when Option::Some(df) then
              df.insert(b)
            when Option::None then ()
            end
            match idom.get(runner)
            when Option::Some(next) then
              if next == runner then break end
              runner = next
            when Option::None then runner = -1
            end
          end
        end
      end
    when Option::None then ()
    end
  end
  
  # Build dominator tree children
  mut dom_tree_children: Map[Int, Vec[Int]] = Map::new()
  for b in block_ids do
    dom_tree_children.insert(b, Vec::new())
  end
  for b in block_ids do
    if b != entry then
      match idom.get(b)
      when Option::Some(parent) then
        match dom_tree_children.get(parent)
        when Option::Some(children) then
          children.push(b)
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  DomInfo {
    idom: idom,
    dom_frontier: dom_frontier,
    dom_tree_children: dom_tree_children
  }
end

def intersect_doms(idom: &Map[Int, Int], b1: Int, b2: Int) -> Int
  mut finger1 = b1
  mut finger2 = b2
  while finger1 != finger2 do
    while finger1 > finger2 do
      match idom.get(finger1)
      when Option::Some(next) then finger1 = next
      when Option::None then return finger2
      end
    end
    while finger2 > finger1 do
      match idom.get(finger2)
      when Option::Some(next) then finger2 = next
      when Option::None then return finger1
      end
    end
  end
  finger1
end

def compute_reverse_postorder(f: &MirFunction) -> Vec[Int]
  mut visited = Set::new()
  mut postorder = Vec::new()
  
  def dfs(f: &MirFunction, block_id: Int, visited: &mut Set[Int], postorder: &mut Vec[Int]) -> Unit
    if visited.contains(block_id) then return end
    visited.insert(block_id)
    
    match get_block(f, BlockId { id: block_id })
    when Option::Some(block) then
      for succ in terminator_successors(&block.terminator) do
        dfs(f, succ.id, visited, postorder)
      end
    when Option::None then ()
    end
    
    postorder.push(block_id)
  end
  
  dfs(f, f.entry_block.id, &mut visited, &mut postorder)
  postorder.reverse()
  postorder
end

# Phi node representation for SSA
struct PhiNode
  dest: LocalId
  ty: Type
  args: Vec[(BlockId, LocalId)]  # (predecessor_block, value_from_that_block)
end

def insert_phi_nodes(f: &mut MirFunction, dom_info: &DomInfo) -> Unit
  # For each variable that is assigned in more than one block,
  # insert phi nodes at the dominance frontier
  
  # Collect defs: local_id -> set of block_ids where it's defined
  mut defs: Map[Int, Set[Int]] = Map::new()
  
  for block in f.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, _) then
        if place.projections.is_empty() then
          match defs.get(place.local.id)
          when Option::Some(set) then
            set.insert(block.id.id)
          when Option::None then
            mut s = Set::new()
            s.insert(block.id.id)
            defs.insert(place.local.id, s)
          end
        end
      when _ then ()
      end
    end
  end
  
  # Insert phi nodes using dominance frontiers
  # For each variable v with multiple defs:
  #   - worklist = blocks where v is defined
  #   - for each block in worklist, add phi at DF(block) if not already there
  
  mut phi_placements: Map[Int, Set[Int]] = Map::new()  # block_id -> set of local_ids needing phi
  
  for entry in defs do
    let (local_id, def_blocks) = entry
    if def_blocks.len() <= 1 then next end
    
    mut worklist = Vec::new()
    for b in def_blocks do
      worklist.push(b)
    end
    
    mut processed = Set::new()
    while !worklist.is_empty() do
      match worklist.pop()
      when Option::Some(b) then
        match dom_info.dom_frontier.get(b)
        when Option::Some(df) then
          for df_block in df do
            match phi_placements.get(df_block)
            when Option::Some(locals) then
              if !locals.contains(local_id) then
                locals.insert(local_id)
                if !processed.contains(df_block) then
                  processed.insert(df_block)
                  worklist.push(df_block)
                end
              end
            when Option::None then
              mut s = Set::new()
              s.insert(local_id)
              phi_placements.insert(df_block, s)
              if !processed.contains(df_block) then
                processed.insert(df_block)
                worklist.push(df_block)
              end
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  
  # Actually insert phi statements at the beginning of blocks
  for block in f.blocks do
    match phi_placements.get(block.id.id)
    when Option::Some(locals) then
      mut new_stmts = Vec::new()
      for local_id in locals do
        # Find the type of this local
        mut local_ty = Type::Unit
        for local in f.locals do
          if local.id.id == local_id then
            local_ty = local.ty.clone()
            break
          end
        end
        for p in f.params do
          if p.id.id == local_id then
            local_ty = p.ty.clone()
            break
          end
        end
        
        # Create phi statement as a special assignment
        # MIR doesn't have native phi, so we use a PhiRvalue marker
        let phi_rvalue = MirRvalue {
          kind: MirRvalueKind::Phi(Vec::new())  # Will be filled in rename pass
        }
        new_stmts.push(MirStatement {
          kind: MirStatementKind::Assign(
            place_local(LocalId { id: local_id }),
            phi_rvalue
          ),
          span: block.statements.get(0).map(|s| s.span.clone()).unwrap_or(Span::dummy())
        })
      end
      # Prepend phis to existing statements
      for stmt in block.statements do
        new_stmts.push(stmt.clone())
      end
      block.statements = new_stmts
    when Option::None then ()
    end
  end
end

def rename_variables(f: &mut MirFunction, dom_info: &DomInfo) -> Unit
  # SSA renaming: traverse dom tree, maintaining a stack of versions for each variable
  mut version_counter: Map[Int, Int] = Map::new()  # local_id -> next version
  mut version_stack: Map[Int, Vec[Int]] = Map::new()  # local_id -> stack of current versions
  
  # Initialize with params
  for p in f.params do
    version_counter.insert(p.id.id, 1)
    mut stack = Vec::new()
    stack.push(0)
    version_stack.insert(p.id.id, stack)
  end
  
  # Initialize locals
  for local in f.locals do
    version_counter.insert(local.id.id, 0)
    version_stack.insert(local.id.id, Vec::new())
  end
  
  def rename_block(f: &mut MirFunction, block_id: Int, dom_info: &DomInfo,
                   version_counter: &mut Map[Int, Int], 
                   version_stack: &mut Map[Int, Vec[Int]]) -> Unit
    
    match get_block_mut(f, BlockId { id: block_id })
    when Option::Some(block) then
      mut pushed_versions: Vec[(Int, Int)] = Vec::new()  # (local_id, version) for cleanup
      
      for stmt in block.statements do
        # First rename uses
        rename_operands_in_stmt(&mut stmt, version_stack)
        
        # Then handle defs (push new version)
        match stmt.kind
        when MirStatementKind::Assign(place, _) then
          if place.projections.is_empty() then
            let lid = place.local.id
            match version_counter.get(lid)
            when Option::Some(ver) then
              let new_ver = ver
              version_counter.insert(lid, ver + 1)
              match version_stack.get(lid)
              when Option::Some(stack) then
                stack.push(new_ver)
                pushed_versions.push((lid, new_ver))
              when Option::None then ()
              end
              # Update the local id with versioned name (conceptually)
              # In practice we just track versions for analysis
            when Option::None then ()
            end
          end
        when _ then ()
        end
      end
      
      # Rename in terminator
      rename_operands_in_terminator(&mut block.terminator, version_stack)
      
      # Fill in phi arguments in successors
      for succ in terminator_successors(&block.terminator) do
        fill_phi_args(f, succ, BlockId { id: block_id }, version_stack)
      end
      
      # Recurse into dominator tree children
      match dom_info.dom_tree_children.get(block_id)
      when Option::Some(children) then
        for child in children do
          rename_block(f, child, dom_info, version_counter, version_stack)
        end
      when Option::None then ()
      end
      
      # Pop versions pushed in this block
      for entry in pushed_versions do
        let (lid, _) = entry
        match version_stack.get(lid)
        when Option::Some(stack) then stack.pop()
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  
  rename_block(f, f.entry_block.id, dom_info, &mut version_counter, &mut version_stack)
end

def rename_operands_in_stmt(stmt: &mut MirStatement, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match stmt.kind
  when MirStatementKind::Assign(place, rvalue) then
    rename_operands_in_rvalue(&mut rvalue, version_stack)
  when _ then ()
  end
end

def rename_operands_in_rvalue(rv: &mut MirRvalue, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match rv.kind
  when MirRvalueKind::Use(op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::BinOp(_, lhs, rhs) then
    rename_operand(&mut lhs, version_stack)
    rename_operand(&mut rhs, version_stack)
  when MirRvalueKind::UnOp(_, op) then
    rename_operand(&mut op, version_stack)
  when MirRvalueKind::Ref(_, p) then
    rename_place(&mut p, version_stack)
  when MirRvalueKind::Cast(op, _) then
    rename_operand(&mut op, version_stack)
  when _ then ()
  end
end

def rename_operand(op: &mut MirOperand, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match op.kind
  when MirOperandKind::Copy(place) then
    rename_place(&mut place, version_stack)
  when MirOperandKind::Move(place) then
    rename_place(&mut place, version_stack)
  when _ then ()
  end
end

def rename_place(place: &mut Place, version_stack: &Map[Int, Vec[Int]]) -> Unit
  # Get current version from stack (conceptual - actual renaming tracked in analysis)
  match version_stack.get(place.local.id)
  when Option::Some(stack) then
    if !stack.is_empty() then
      # Version is available - SSA semantics maintained
      ()
    end
  when Option::None then ()
  end
end

def rename_operands_in_terminator(term: &mut MirTerminator, version_stack: &Map[Int, Vec[Int]]) -> Unit
  match term.kind
  when MirTerminatorKind::Return(op) then
    match op
    when Option::Some(operand) then
      rename_operand(&mut operand, version_stack)
    when Option::None then ()
    end
  when MirTerminatorKind::Call(_, args, _, _) then
    for arg in args do
      rename_operand(&mut arg, version_stack)
    end
  when MirTerminatorKind::SwitchInt(op, _, _) then
    rename_operand(&mut op, version_stack)
  when MirTerminatorKind::Assert(op, _, _, _, _) then
    rename_operand(&mut op, version_stack)
  when _ then ()
  end
end

def fill_phi_args(f: &mut MirFunction, succ_id: BlockId, pred_id: BlockId, 
                  version_stack: &Map[Int, Vec[Int]]) -> Unit
  match get_block_mut(f, succ_id)
  when Option::Some(block) then
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::Assign(place, rvalue) then
        match rvalue.kind
        when MirRvalueKind::Phi(args) then
          let lid = place.local.id
          match version_stack.get(lid)
          when Option::Some(stack) then
            match stack.last()
            when Option::Some(ver) then
              # Add argument: from pred_id, use version ver
              args.push((pred_id.clone(), LocalId { id: lid }))
            when Option::None then ()
            end
          when Option::None then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  when Option::None then ()
  end
end

def get_block_mut(f: &mut MirFunction, id: BlockId) -> Option[&mut MirBlock]
  for block in f.blocks do
    if block.id.id == id.id then
      return Option::Some(block)
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lower_to_mir(program: &Program) -> MirProgram
  mut mir = lower_program(program)
  # Convert to SSA form before optimization
  for func in mir.functions do
    convert_to_ssa(&mut func)
  end
  optimize_mir(&mut mir)
  transform_async_functions(&mut mir)
  mir
end
