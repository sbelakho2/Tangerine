def snapshot_parse_unsafe_fact_row(fields: Vec[SnapshotField], line_no: Int) -> Result[UnsafeFact, String]
  let tag = "unsafe-fact".to_string()
  let digest = match snapshot_digest_field(fields.clone(), "i".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let function_key = match snapshot_string_field(fields.clone(), "f".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind_word = match snapshot_string_field(fields.clone(), "ukind".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind = match snapshot_unsafe_kind_of_word(kind_word.clone())
  when Result::Err(e) then return Result::Err(snapshot_line_error(line_no, tag.clone(), e))
  when Result::Ok(v) then v
  end
  let site = match snapshot_string_field(fields.clone(), "site".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  # (fourth-audit P0-19) re-derive the typed site member the writer's
  # fields determine (the row grammar carries no separate site id).
  let site_id = stable_unsafe_site_id_of(&function_key, semantic_unsafe_kind_text(&kind), site.clone())
  Result::Ok(UnsafeFact {
    function: function_key,
    kind: kind,
    site: site,
    digest_hi: digest.hi,
    digest_lo: digest.lo,
    site_id: Option::Some(site_id)
  })
end

# (fourth-audit P0-17) ONE drop-plan fact row -> the model record; the
# ';;'-joined path list and the kind word are required fields.
def snapshot_parse_drop_plan_row(fields: Vec[SnapshotField], line_no: Int) -> Result[DropPlanFact, String]
  let tag = "drop-plan".to_string()
  let function_key = match snapshot_string_field(fields.clone(), "f".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let place = match snapshot_string_field(fields.clone(), "place".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let drop_site = match snapshot_string_field(fields.clone(), "site".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let paths_text = match snapshot_string_field(fields.clone(), "paths".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind = match snapshot_string_field(fields.clone(), "kind".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  Result::Ok(DropPlanFact {
    function: function_key,
    place: place,
    drop_site: drop_site,
    conditional_paths: snapshot_split_double_semicolons(paths_text),
    kind: kind
  })
end

# (fourth-audit P1-3/P1-5) The new row parsers — the exact inverse of the
# snapshot_*_line renderers above.
def snapshot_access_convention_of_word(word: String) -> Result[AccessConvention, String]
  if word == "let" then
    return Result::Ok(AccessConvention::Let)
  end
  if word == "inout" then
    return Result::Ok(AccessConvention::Inout)
  end
  if word == "sink" then
    return Result::Ok(AccessConvention::Sink)
  end
  if word == "set" then
    return Result::Ok(AccessConvention::Set)
  end
  Result::Err("unknown access convention word '" + word.clone() + "'")
end

def snapshot_allocation_size_kind_of_word(word: String) -> Result[SemanticAllocationSizeKind, String]
  if word == "Exact" then
    return Result::Ok(SemanticAllocationSizeKind::Exact)
  end
  if word == "UpperBound" then
    return Result::Ok(SemanticAllocationSizeKind::UpperBound)
  end
  if word == "Unbounded" then
    return Result::Ok(SemanticAllocationSizeKind::Unbounded)
  end
  if word == "Unknown" then
    return Result::Ok(SemanticAllocationSizeKind::Unknown)
  end
  Result::Err("unknown allocation size kind word '" + word.clone() + "'")
end

# One "conv|name|ty" row of a ";;"-joined param list. A malformed row fails
# closed with the line/tag (the row grammar is fixed: exactly two '|').
def snapshot_param_decoded(text: String, tag: String, line_no: Int) -> Result[SemanticParam, String]
  var first = -1
  var last = -1
  var i = 0
  while i < text.len() do
    if text.slice(i, i + 1) == "|" then
      if first < 0 then
        first = i
      else
        last = i
      end
    end
    i = i + 1
  end
  if first < 0 || last < 0 || first >= last then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "malformed param row '" + text.clone() + "'"))
  end
  let conv = match snapshot_access_convention_of_word(text.slice(0, first))
  when Result::Err(e) then return Result::Err(snapshot_line_error(line_no, tag.clone(), e))
  when Result::Ok(v) then v
  end
  Result::Ok(SemanticParam {
    convention: conv,
    name: text.slice(first + 1, last),
    ty: text.slice(last + 1, text.len())
  })
end

def snapshot_params_decoded(text: String, tag: String, line_no: Int) -> Result[Vec[SemanticParam], String]
  var out: Vec[SemanticParam] = Vec::new()
  for part in snapshot_split_double_semicolons(text) do
    let p = match snapshot_param_decoded(part, tag.clone(), line_no)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    out.push(p)
  end
  Result::Ok(out)
end

