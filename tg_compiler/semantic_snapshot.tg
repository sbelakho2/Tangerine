# ———— key hydration (the protocol-carrier rule above) ————

def snapshot_hydrate_def_id(inout sid: StableDefId, inout keys: Map[String, String]) -> Unit
  if sid.key.len() > 0 then
    return
  end
  let rendered = semantic_digest_render(&semantic_stable_def_id_digest(&sid))
  match keys.get(rendered.clone())
  when Option::Some(k) then
    sid.key = k.clone()
    sid.path = stable_key_name_part(&k)
  when Option::None then
    sid.key = "digest::" + rendered
    sid.path = "".to_string()
  end
  ()
end

def snapshot_hydrate_def_keys(inout snapshot: SemanticSnapshot) -> Unit
  var keys: Map[String, String] = Map::new()
  for s in snapshot.symbols.clone() do
    let rendered = semantic_digest_render(&semantic_stable_def_id_digest(&s.stable_id))
    if !keys.contains_key(&rendered) then
      keys.insert(rendered.clone(), s.stable_id.key.clone())
    end
  end
  for t in snapshot.types.clone() do
    let rendered = semantic_digest_render(&semantic_stable_def_id_digest(&t.stable_id))
    if !keys.contains_key(&rendered) then
      keys.insert(rendered.clone(), t.stable_id.key.clone())
    end
  end
  var i = 0
  while i < snapshot.calls.len() do
    snapshot_hydrate_def_id(&mut snapshot.calls[i].caller, &mut keys)
    snapshot_hydrate_def_id(&mut snapshot.calls[i].callee, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.effects.len() do
    snapshot_hydrate_def_id(&mut snapshot.effects[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.capabilities.len() do
    snapshot_hydrate_def_id(&mut snapshot.capabilities[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.ownership.len() do
    snapshot_hydrate_def_id(&mut snapshot.ownership[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.contracts.len() do
    snapshot_hydrate_def_id(&mut snapshot.contracts[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.tests.len() do
    snapshot_hydrate_def_id(&mut snapshot.tests[i].test, &mut keys)
    snapshot_hydrate_def_id(&mut snapshot.tests[i].target, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.coverage.len() do
    snapshot_hydrate_def_id(&mut snapshot.coverage[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.mir_functions.len() do
    snapshot_hydrate_def_id(&mut snapshot.mir_functions[i].function, &mut keys)
    i = i + 1
  end
  # (fourth-audit P1-3) the typed member/signature table owners.
  i = 0
  while i < snapshot.fields.len() do
    snapshot_hydrate_def_id(&mut snapshot.fields[i].owner, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.variants.len() do
    snapshot_hydrate_def_id(&mut snapshot.variants[i].owner, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.callable_signatures.len() do
    snapshot_hydrate_def_id(&mut snapshot.callable_signatures[i].function, &mut keys)
    i = i + 1
  end
  i = 0
  while i < snapshot.trait_methods.len() do
    snapshot_hydrate_def_id(&mut snapshot.trait_methods[i].owner, &mut keys)
    i = i + 1
  end
  # The contract row key is a composite of the (now hydrated) function key:
  # rebuild it so the delta/index consumers read the same StableContractId
  # stable_key the builder wrote. Digest words stay the stored ones.
  i = 0
  while i < snapshot.contracts.len() do
    if snapshot.contracts[i].id.stable_key.len() == 0 then
      let kind_word = snapshot_contract_kind_text(&snapshot.contracts[i].kind)
      let ckey = stable_contract_row_key(
        snapshot.contracts[i].function.key.clone(),
        kind_word,
        semantic_contract_expr_text(&snapshot.contracts[i].canonical_expression))
      snapshot.contracts[i].id.stable_key = ckey
    end
    i = i + 1
  end
  ()
end

# ———— the public entry: one artifact text -> SemanticSnapshot ————

pub def semantic_snapshot_parse(text: String) -> Result[SemanticSnapshot, String]
  var header_seen = false
  var revision = semantic_digest_zero()
  var compiler_version = "".to_string()
  var target = StableTargetId {
    triple: "".to_string(),
    arch: "".to_string(),
    cpu: "".to_string(),
    pointer_width: 0,
    endian: "".to_string(),
    abi: "".to_string(),
    float_abi: "".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new(),
    digest_hi: 0,
    digest_lo: 0
  }
  var public_api_hash = semantic_digest_zero()
  var abi_hash = semantic_digest_zero()
  var unsafe_hash = semantic_digest_zero()
  var symbols: Vec[SemanticSymbol] = Vec::new()
  var types: Vec[SemanticType] = Vec::new()
  var calls: Vec[CallEdge] = Vec::new()
  var indirect_calls: Vec[IndirectCallEdge] = Vec::new()
  var effects: Vec[EffectEdge] = Vec::new()
  var capabilities: Vec[CapabilityEdge] = Vec::new()
  var ownership: Vec[OwnershipFact] = Vec::new()
  var contracts: Vec[ContractFact] = Vec::new()
  var tests: Vec[TestRelationship] = Vec::new()
  var coverage: Vec[CoverageRelationship] = Vec::new()
  var mir_functions: Vec[MirSemanticSummary] = Vec::new()
  var unsafe_facts: Vec[UnsafeFact] = Vec::new()
  var drop_plans: Vec[DropPlanFact] = Vec::new()
  var abi_surfaces: Vec[AbiSurfaceRow] = Vec::new()
  var dependencies = SemanticDependencyGraph {}
  # (fourth-audit P1-3/P1-5) the typed member/signature tables, the
  # concrete-type and allocation-site tables and the header payload. The
  # row-table locals carry a _rows suffix: the parse loop's scanned JSON
  # field list shadows the plain `fields` name.
  var field_rows: Vec[SemanticField] = Vec::new()
  var variant_rows: Vec[SemanticVariant] = Vec::new()
  var signature_rows: Vec[SemanticCallableSignature] = Vec::new()
  var trait_method_rows: Vec[SemanticTraitMethod] = Vec::new()
  var concrete_type_rows: Vec[SemanticConcreteType] = Vec::new()
  var allocation_site_rows: Vec[SemanticAllocationSite] = Vec::new()
  var feature_set: Vec[String] = Vec::new()
  var semantic_options: Vec[String] = Vec::new()
  var domain_digests = SemanticDomainDigests {}
  var line_no = 0
  for raw in text.split("\n") do
    line_no = line_no + 1
    var line = raw.clone()
    if line.ends_with("\r") then
      line = line.slice(0, line.len() - 1)
    end
    if line.len() == 0 then
      continue
    end
    let fields = match snapshot_scan_object(line.clone(), line_no)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    let tag = match snapshot_string_field(fields.clone(), "s".to_string(), "row".to_string(), line_no)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(v) then v
    end
    if tag == "header" then
      if header_seen then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "duplicate header row"))
      end
      let h = match snapshot_parse_header_row(fields.clone(), line_no)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(v) then v
      end
      revision = h.revision
      compiler_version = h.compiler_version
      target = h.target
      public_api_hash = h.public_api_hash
      abi_hash = h.abi_hash
      unsafe_hash = h.unsafe_hash
      feature_set = h.feature_set
      semantic_options = h.semantic_options
      domain_digests = h.domain_digests
      header_seen = true
    else
      if !header_seen then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "row appears before the header row"))
      end
      if tag == "symbol" then
        let row = match snapshot_parse_symbol_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        symbols.push(row)
      elsif tag == "type" then
        let row = match snapshot_parse_type_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        types.push(row)
      elsif tag == "call" then
        let row = match snapshot_parse_call_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        calls.push(row)
      elsif tag == "indirect" then
        let row = match snapshot_parse_indirect_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        indirect_calls.push(row)
      elsif tag == "effect" then
        let row = match snapshot_parse_effect_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        effects.push(row)
      elsif tag == "capability" then
        let row = match snapshot_parse_capability_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        capabilities.push(row)
      elsif tag == "ownership" then
        let row = match snapshot_parse_ownership_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        ownership.push(row)
      elsif tag == "contract" then
        let row = match snapshot_parse_contract_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        contracts.push(row)
      elsif tag == "test" then
        let row = match snapshot_parse_test_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        tests.push(row)
      elsif tag == "coverage" then
        let row = match snapshot_parse_coverage_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        coverage.push(row)
      elsif tag == "mir" then
        let row = match snapshot_parse_mir_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        mir_functions.push(row)
      elsif tag == "unsafe-fact" then
        let row = match snapshot_parse_unsafe_fact_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        unsafe_facts.push(row)
      elsif tag == "drop-plan" then
        let row = match snapshot_parse_drop_plan_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        drop_plans.push(row)
      elsif tag == "concrete-type" then
        let row = match snapshot_parse_concrete_type_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        concrete_type_rows.push(row)
      elsif tag == "alloc-site" then
        let row = match snapshot_parse_allocation_site_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        allocation_site_rows.push(row)
      elsif tag == "field" then
        let row = match snapshot_parse_field_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        field_rows.push(row)
      elsif tag == "variant" then
        let row = match snapshot_parse_variant_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        variant_rows.push(row)
      elsif tag == "signature" then
        let row = match snapshot_parse_signature_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        signature_rows.push(row)
      elsif tag == "trait-method" then
        let row = match snapshot_parse_trait_method_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        trait_method_rows.push(row)
      elsif tag == "abi-surface" then
        let row = match snapshot_parse_abi_surface_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        abi_surfaces.push(row)
      elsif tag == "dep-type-use" then
        let row = match snapshot_parse_type_use_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.type_uses.push(row)
      elsif tag == "dep-trait-impl" then
        let row = match snapshot_parse_trait_impl_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.trait_impls.push(row)
      elsif tag == "dep-trait-select" then
        let row = match snapshot_parse_trait_selection_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.trait_selections.push(row)
      elsif tag == "dep-generic-inst" then
        let row = match snapshot_parse_generic_instantiation_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.generic_instantiations.push(row)
      elsif tag == "dep-layout" then
        let row = match snapshot_parse_layout_dependency_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.layout_dependencies.push(row)
      elsif tag == "dep-const-eval" then
        let row = match snapshot_parse_const_eval_dependency_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.const_eval_dependencies.push(row)
      elsif tag == "dep-derived-body" then
        let row = match snapshot_parse_derived_body_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.derived_bodies.push(row)
      elsif tag == "dep-contract-ref" then
        let row = match snapshot_parse_contract_reference_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.contract_references.push(row)
      elsif tag == "dep-abi" then
        let row = match snapshot_parse_abi_dependency_row(fields.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        dependencies.abi_dependencies.push(row)
      elsif tag == "dep-completeness" then
        let family = match snapshot_string_field(fields.clone(), "family".to_string(), tag.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        let status = match snapshot_string_field(fields.clone(), "status".to_string(), tag.clone(), line_no)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(v) then v
        end
        if status != "complete" && status != "partial" && status != "unavailable" then
          return Result::Err(snapshot_line_error(line_no, tag.clone(),
            "invalid completeness status '" + status.clone() + "'"))
        end
        dependencies.dependency_completeness.insert(family, status)
      else
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "unknown row tag"))
      end
    end
  end
  if !header_seen then
    return Result::Err("semantic snapshot parse error: missing header row (empty or headerless artifact)")
  end
  var snapshot = SemanticSnapshot {
    revision: revision,
    compiler_version: compiler_version,
    target: target,
    feature_set: feature_set,
    semantic_options: semantic_options,
    symbols: symbols,
    types: types,
    fields: field_rows,
    variants: variant_rows,
    callable_signatures: signature_rows,
    trait_methods: trait_method_rows,
    calls: calls,
    indirect_calls: indirect_calls,
    effects: effects,
    capabilities: capabilities,
    ownership: ownership,
    contracts: contracts,
    tests: tests,
    coverage: coverage,
    mir_functions: mir_functions,
    unsafe_facts: unsafe_facts,
    concrete_types: concrete_type_rows,
    allocation_sites: allocation_site_rows,
    drop_plans: drop_plans,
    abi_surfaces: abi_surfaces,
    dependencies: dependencies,
    domain_digests: domain_digests,
    public_api_hash: public_api_hash,
    abi_hash: abi_hash,
    unsafe_hash: unsafe_hash
  }
  snapshot_hydrate_def_keys(&mut snapshot)
  Result::Ok(snapshot)
end

# ———————————————————————————————————————————————————————————————
# The parser lane — a hand-built FULL snapshot round-trips byte-exactly
# ———————————————————————————————————————————————————————————————
# Every family above is non-empty and carries its adversarial content:
# quotes / backslashes / newlines in string values, a canonical clause
# text with nested parens and commas, comma/semicolon-carrying list
# elements, full-range UInt digest words, negative Int fields and
# Some/None optionals. The lane asserts serialize(parse(serialize(s))) ==
# serialize(s) (the strongest exact-inverse property), the per-family row
# counts and the key-hydration reconstruction; mismatch rows name the
# broken invariant.

def snapshot_parse_lane_def(key: String) -> StableDefId
  stable_def_id_digested(key.clone(), stable_key_name_part(&key))
end

pub def snapshot_parse_lane_snapshot() -> SemanticSnapshot
  let f = snapshot_parse_lane_def("lane::f#fn(i64)->i64")
  let g = snapshot_parse_lane_def("lane::g#fn(i64)->i64")
  let thing = snapshot_parse_lane_def("lane::Thing")
  let show = snapshot_parse_lane_def("lane::Show")
  let weird_key = "lane::w\"e\\ir#fn()->unit"
  let weird = snapshot_parse_lane_def(weird_key.clone())
  var caps: Set[CapabilityId] = Set::new()
  caps.insert(CapabilityId { id: 1 })
  caps.insert(CapabilityId { id: 2 })
  let summary = EffectSummary {
    may_allocate: true,
    may_block: false,
    may_io: true,
    may_spawn: false,
    may_sleep: true,
    may_panic: false,
    may_unsafe: true,
    capabilities: caps
  }
  var graph = SemanticDependencyGraph {}
  graph.type_uses.push(TypeUseEdge { user: f.key.clone(), used_type: thing.key.clone() })
  graph.trait_impls.push(TraitImplEdge {
    impl_key: "impl::lane::Thing|as|lane::Show".to_string(),
    trait_key: show.key.clone(),
    self_type: thing.key.clone()
  })
  graph.trait_selections.push(TraitSelectionEdge {
    function: f.key.clone(),
    trait_key: show.key.clone(),
    impl_key: "impl::lane::Thing|as|lane::Show".to_string()
  })
  graph.generic_instantiations.push(GenericInstantiationEdge {
    instance_key: "instance::lane::f$i64".to_string(),
    template: f.key.clone()
  })
  graph.layout_dependencies.push(LayoutDependencyEdge {
    dependent_type: thing.key.clone(),
    source_type: f.key.clone()
  })
  graph.const_eval_dependencies.push(ConstEvalDependencyEdge {
    dependent: "instance::lane::f$i64".to_string(),
    referenced_const: "lane::K#const".to_string()
  })
  graph.derived_bodies.push(DerivedBodyEdge {
    derived_key: "derived::effect-dispatcher::lane".to_string(),
    source_type: thing.key.clone()
  })
  graph.contract_references.push(ContractReferenceEdge {
    contract_id: "lane::f#fn(i64)->i64|Pre|gt(x,0)".to_string(),
    referenced_symbol: g.key.clone()
  })
  graph.abi_dependencies.push(AbiDependencyEdge {
    surface_id: "fn:" + f.key.clone(),
    type_key: thing.key.clone()
  })
  # The per-family producer-status table (fourth-audit P0-9): all three
  # status words ride the round trip.
  graph.dependency_completeness.insert("LayoutDependency".to_string(), "complete".to_string())
  graph.dependency_completeness.insert("ConstEvalDependency".to_string(), "partial".to_string())
  graph.dependency_completeness.insert("TraitSelection".to_string(), "unavailable".to_string())
  SemanticSnapshot {
    revision: StableDigest { hi: 0xffffffffffffffff, lo: 0x8000000000000000 },
    compiler_version: "lane-1.0".to_string(),
    # (fourth-audit P1-5a) the header feature/option payload: a comma-carrying
    # path rides the ";;" join exactly.
    feature_set: Vec::from(["budgets".to_string(), "target-feature:neon".to_string()]),
    semantic_options: Vec::from(["opt-level:2".to_string(), "pgo-use:/tmp/a,b/c".to_string()]),
    target: StableTargetId {
      triple: "lane-arch-lane-os".to_string(),
      arch: "lane".to_string(),
      cpu: "lane-cpu".to_string(),
      pointer_width: 8,
      endian: "little".to_string(),
      abi: "lp64".to_string(),
      float_abi: "hard".to_string(),
      isa_features: Vec::from(["neon".to_string(), "sve".to_string()]),
      native_atomic_widths: Vec::from([8, 16]),
      digest_hi: 0x123456789abcdef0,
      digest_lo: 0xfedcba9876543210
    },
    symbols: Vec::from([
      SemanticSymbol { stable_id: f.clone(), kind: DefKind::Function, name: "f".to_string(), module_path: "lane".to_string(), is_pub: true, is_generic: false },
      SemanticSymbol { stable_id: g.clone(), kind: DefKind::Function, name: "g".to_string(), module_path: "lane".to_string(), is_pub: false, is_generic: false },
      SemanticSymbol { stable_id: thing.clone(), kind: DefKind::TypeName, name: "Thing".to_string(), module_path: "lane".to_string(), is_pub: true, is_generic: false },
      SemanticSymbol { stable_id: show.clone(), kind: DefKind::Trait, name: "Show".to_string(), module_path: "lane".to_string(), is_pub: true, is_generic: true },
      SemanticSymbol { stable_id: weird.clone(), kind: DefKind::Other, name: "w\"e\\ir".to_string(), module_path: "lane".to_string(), is_pub: false, is_generic: false }
    ]),
    types: Vec::from([
      SemanticType { stable_id: thing.clone(), kind: SemanticTypeKind::Struct, name: "Thing".to_string(), module_path: "lane".to_string(), generic_arity: 0, is_pub: true },
      SemanticType { stable_id: show.clone(), kind: SemanticTypeKind::Trait, name: "Show".to_string(), module_path: "lane".to_string(), generic_arity: 1, is_pub: true }
    ]),
    # (fourth-audit P1-3) the typed member/signature rows: a delimiter-
    # carrying field name, a payload shape, typed params/conventions/
    # effects and trait methods.
    fields: Vec::from([
      SemanticField {
        owner: thing.clone(),
        name: "f\"x\\y,z(w)".to_string(),
        index: 0,
        ty: "T[lane::Box[int]]".to_string(),
        member_id: "member::thing|field|f".to_string(),
        is_pub: true
      }
    ]),
    variants: Vec::from([
      SemanticVariant {
        owner: thing.clone(),
        name: "A,b(c)".to_string(),
        index: 0,
        payload: Vec::from([
          SemanticParam { convention: AccessConvention::Let, ty: "int".to_string(), name: "a,b(c)" },
          SemanticParam { convention: AccessConvention::Let, ty: "T[lane::Box[int]]".to_string(), name: "".to_string() }
        ]),
        member_id: "member::thing|variant|A".to_string()
      }
    ]),
    callable_signatures: Vec::from([
      SemanticCallableSignature {
        function: f.clone(),
        params: Vec::from([
          SemanticParam { convention: AccessConvention::Inout, ty: "int".to_string(), name: "n,0" },
          SemanticParam { convention: AccessConvention::Let, ty: "bool".to_string(), name: "".to_string() }
        ]),
        ret_type: "i64".to_string(),
        declared_effects: Vec::from(["e1".to_string(), "e2".to_string()]),
        variadic: true
      }
    ]),
    trait_methods: Vec::from([
      SemanticTraitMethod {
        owner: show.clone(),
        name: "run,now".to_string(),
        index: 0,
        params: Vec::from([
          SemanticParam { convention: AccessConvention::Let, ty: "int".to_string(), name: "".to_string() }
        ]),
        ret_type: "unit".to_string(),
        member_id: "member::show|method|run".to_string()
      }
    ]),
    # (fourth-audit P1-5b/c) the concrete-type and allocation-site rows.
    concrete_types: Vec::from([
      SemanticConcreteType {
        instance_key: "lane::Box<T[int]>".to_string(),
        template: "lane::Box".to_string(),
        args: Vec::from(["T[int]".to_string()]),
        size: 8,
        alignment: 8,
        fields: Vec::from(["value 0 8".to_string()]),
        layout_status: "ok".to_string()
      }
    ]),
    allocation_sites: Vec::from([
      SemanticAllocationSite {
        function: f.key.clone(),
        site: f.key.clone() + "#B0#S1",
        size_kind: SemanticAllocationSizeKind::Exact,
        size: 64
      },
      SemanticAllocationSite {
        function: f.key.clone(),
        site: f.key.clone() + "#B0#T",
        size_kind: SemanticAllocationSizeKind::Unbounded,
        size: -1
      }
    ]),
    calls: Vec::from([
      CallEdge { caller: f.clone(), callee: g.clone(), kind: CallEdgeKind::Direct },
      CallEdge { caller: f.clone(), callee: snapshot_parse_lane_def("intrinsic::memcpy#op"), kind: CallEdgeKind::Intrinsic }
    ]),
    indirect_calls: Vec::from([
      IndirectCallEdge {
        caller: f.key.clone(),
        site: f.key.clone() + "#B0#T",
        signature: "fn(i64)->i64".to_string(),
        candidates: Vec::from([g.key.clone(), "lane::a,b".to_string()]),
        completeness: "Unknown".to_string()
      }
    ]),
    effects: Vec::from([
      EffectEdge {
        function: f.clone(),
        summary: summary.clone(),
        purity_status: "ProvenPure".to_string(),
        purity_evidence: Vec::from(["alloc@1".to_string(), "io@2;;x".to_string()])
      }
    ]),
    capabilities: Vec::from([
      CapabilityEdge { function: f.clone(), capability: CapabilityId { id: 1 }, kind: CapabilityEdgeKind::Requires },
      CapabilityEdge { function: g.clone(), capability: CapabilityId { id: 2 }, kind: CapabilityEdgeKind::Provides }
    ]),
    ownership: Vec::from([
      OwnershipFact { function: f.clone(), place_key: "self.field[0]".to_string(), convention: AccessConvention::Inout }
    ]),
    contracts: Vec::from([
      ContractFact {
        id: StableContractId { dense_id: -1, stable_key: "".to_string(), digest_hi: 0xaa, digest_lo: 0xbb },
        function: f.clone(),
        kind: AstContractKind::AstPre,
        expression_fingerprint: StableDigest { hi: 0xcc, lo: 0xdd },
        canonical_expression: ContractExprIR {
          op: "gt".to_string(),
          args: Vec::from(["call(a,b)".to_string(), "0".to_string()]),
          resolved_refs: Vec::from([g.key.clone()])
        },
        message: Option::Some("must hold, always".to_string())
      }
    ]),
    tests: Vec::from([
      TestRelationship { test: g.clone(), target: f.clone() }
    ]),
    coverage: Vec::from([
      CoverageRelationship {
        function: f.clone(),
        branch_id: f.key.clone() + "#B0".to_string(),
        arm_id: Option::Some("arm,0".to_string()),
        kind: "IfExpr".to_string(),
        test_id: g.key.clone()
      }
    ]),
    mir_functions: Vec::from([
      MirSemanticSummary {
        function: g.clone(),
        block_count: 3,
        statement_count: 5,
        local_count: 2,
        reachable: true,
        calls_unsafe: false,
        calls_unknown: false,
        effect_summary: summary.clone(),
        purity_status: "Unknown".to_string(),
        purity_evidence: Vec::new()
      }
    ]),
    unsafe_facts: Vec::from([
      UnsafeFact {
        function: f.key.clone(),
        kind: UnsafeKind::ExternBoundary,
        site: "memcpy".to_string(),
        digest_hi: 0x11,
        digest_lo: 0x22,
        site_id: Option::Some(stable_unsafe_site_id_of(&f.key, "extern-call".to_string(), "memcpy".to_string()))
      }
    ]),
    drop_plans: Vec::from([
      DropPlanFact {
        function: f.key.clone(),
        place: "x[0].field".to_string(),
        drop_site: "edge:normal:B7".to_string(),
        conditional_paths: Vec::from(["branch:false".to_string(), "mask:a.b".to_string()]),
        kind: "branch-cleanup".to_string()
      }
    ]),
    abi_surfaces: Vec::from([
      AbiSurfaceRow {
        surface_id: "fn:" + f.key.clone(),
        symbol_key: f.key.clone(),
        kind: "fn".to_string(),
        size: -1,
        alignment: -1,
        arg_classes: Vec::from(["scalar:8".to_string()]),
        ret_class: "direct:scalar:8".to_string(),
        fields: Vec::new(),
        calling_convention: "tangerine".to_string(),
        external_symbol: "".to_string(),
        param_classes: Vec::from(["scalar:8".to_string()]),
        param_locations: Vec::from(["x0".to_string()]),
        ownership_in: Vec::from(["let".to_string()]),
        ownership_out: "borrowed".to_string(),
        nullability: Vec::from(["arg0 unknown".to_string()]),
        variadic: false,
        extension: Vec::from(["none".to_string()]),
        platform: "lane-arch-lane-os".to_string(),
        failure_convention: "trap".to_string(),
        thread_safety: "unknown".to_string(),
        taint: "unmodeled".to_string(),
        canonical_boundary: "n/a".to_string()
      }
    ]),
    dependencies: graph,
    # (fourth-audit P1-5c) the per-domain digest record rides the header row
    # and the round trip.
    domain_digests: SemanticDomainDigests {
      public_api: StableDigest { hi: 0x7777777777777777, lo: 0x8888888888888888 },
      abi: StableDigest { hi: 0x9999999999999999, lo: 0xaaaaaaaaaaaaaaaa },
      unsafe_: StableDigest { hi: 0xbbbbbbbbbbbbbbbb, lo: 0xcccccccccccccccc },
      concrete_types: StableDigest { hi: 0xdddddddddddddddd, lo: 0xeeeeeeeeeeeeeeee },
      drop_plans: StableDigest { hi: 0x0101010101010101, lo: 0x0202020202020202 },
      allocation_sites: StableDigest { hi: 0x0303030303030303, lo: 0x0404040404040404 },
      features: StableDigest { hi: 0x0505050505050505, lo: 0x0606060606060606 }
    },
    public_api_hash: StableDigest { hi: 0x1111111111111111, lo: 0x2222222222222222 },
    abi_hash: StableDigest { hi: 0x3333333333333333, lo: 0x4444444444444444 },
    unsafe_hash: StableDigest { hi: 0x5555555555555555, lo: 0x6666666666666666 }
  }
end

def snapshot_parse_lane_row(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name)
  end
  ()
end

pub def semantic_snapshot_parse_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  var original = snapshot_parse_lane_snapshot()
  let text = semantic_snapshot_serialize(&mut original)
  let parsed = match semantic_snapshot_parse(text.clone())
  when Result::Err(e) then
    out.push("parse-failed:" + e.clone())
    return out
  when Result::Ok(v) then v
  end
  var round = parsed.clone()
  let text2 = semantic_snapshot_serialize(&mut round)
  snapshot_parse_lane_row(&mut out, "round-trip-byte-identity", text == text2)
  snapshot_parse_lane_row(&mut out, "symbols-count", parsed.symbols.len() == original.symbols.len())
  snapshot_parse_lane_row(&mut out, "types-count", parsed.types.len() == original.types.len())
  snapshot_parse_lane_row(&mut out, "calls-count", parsed.calls.len() == original.calls.len())
  snapshot_parse_lane_row(&mut out, "indirect-count", parsed.indirect_calls.len() == original.indirect_calls.len())
  snapshot_parse_lane_row(&mut out, "effects-count", parsed.effects.len() == original.effects.len())
  snapshot_parse_lane_row(&mut out, "capabilities-count", parsed.capabilities.len() == original.capabilities.len())
  snapshot_parse_lane_row(&mut out, "ownership-count", parsed.ownership.len() == original.ownership.len())
  snapshot_parse_lane_row(&mut out, "contracts-count", parsed.contracts.len() == original.contracts.len())
  snapshot_parse_lane_row(&mut out, "tests-count", parsed.tests.len() == original.tests.len())
  snapshot_parse_lane_row(&mut out, "coverage-count", parsed.coverage.len() == original.coverage.len())
  snapshot_parse_lane_row(&mut out, "mir-count", parsed.mir_functions.len() == original.mir_functions.len())
  snapshot_parse_lane_row(&mut out, "unsafe-facts-count", parsed.unsafe_facts.len() == original.unsafe_facts.len())
  snapshot_parse_lane_row(&mut out, "abi-surfaces-count", parsed.abi_surfaces.len() == original.abi_surfaces.len())
  snapshot_parse_lane_row(&mut out, "dep-type-uses-count", parsed.dependencies.type_uses.len() == original.dependencies.type_uses.len())
  snapshot_parse_lane_row(&mut out, "dep-trait-impls-count", parsed.dependencies.trait_impls.len() == original.dependencies.trait_impls.len())
  snapshot_parse_lane_row(&mut out, "dep-trait-selections-count", parsed.dependencies.trait_selections.len() == original.dependencies.trait_selections.len())
  snapshot_parse_lane_row(&mut out, "dep-generic-count", parsed.dependencies.generic_instantiations.len() == original.dependencies.generic_instantiations.len())
  snapshot_parse_lane_row(&mut out, "dep-layout-count", parsed.dependencies.layout_dependencies.len() == original.dependencies.layout_dependencies.len())
  snapshot_parse_lane_row(&mut out, "dep-const-eval-count", parsed.dependencies.const_eval_dependencies.len() == original.dependencies.const_eval_dependencies.len())
  snapshot_parse_lane_row(&mut out, "dep-derived-count", parsed.dependencies.derived_bodies.len() == original.dependencies.derived_bodies.len())
  snapshot_parse_lane_row(&mut out, "dep-contract-refs-count", parsed.dependencies.contract_references.len() == original.dependencies.contract_references.len())
  snapshot_parse_lane_row(&mut out, "dep-abi-count", parsed.dependencies.abi_dependencies.len() == original.dependencies.abi_dependencies.len())
  snapshot_parse_lane_row(&mut out, "dep-completeness-count",
    parsed.dependencies.dependency_completeness.len() == original.dependencies.dependency_completeness.len() &&
    parsed.dependencies.dependency_completeness.len() == 3)
  var compl_partial_ok = false
  match parsed.dependencies.dependency_completeness.get("ConstEvalDependency".to_string())
  when Option::Some(s) then compl_partial_ok = s == "partial"
  when Option::None then ()
  end
  var compl_unavailable_ok = false
  match parsed.dependencies.dependency_completeness.get("TraitSelection".to_string())
  when Option::Some(s2) then compl_unavailable_ok = s2 == "unavailable"
  when Option::None then ()
  end
  snapshot_parse_lane_row(&mut out, "dep-completeness-statuses", compl_partial_ok && compl_unavailable_ok)
  snapshot_parse_lane_row(&mut out, "revision-words",
    parsed.revision.hi == original.revision.hi && parsed.revision.lo == original.revision.lo)
  snapshot_parse_lane_row(&mut out, "compiler-version", parsed.compiler_version == original.compiler_version)
  snapshot_parse_lane_row(&mut out, "target-words",
    parsed.target.digest_hi == original.target.digest_hi && parsed.target.digest_lo == original.target.digest_lo)
  snapshot_parse_lane_row(&mut out, "target-features", parsed.target.isa_features.len() == 2)
  snapshot_parse_lane_row(&mut out, "public-api-hash",
    parsed.public_api_hash.hi == original.public_api_hash.hi && parsed.public_api_hash.lo == original.public_api_hash.lo)
  snapshot_parse_lane_row(&mut out, "abi-hash",
    parsed.abi_hash.hi == original.abi_hash.hi && parsed.abi_hash.lo == original.abi_hash.lo)
  snapshot_parse_lane_row(&mut out, "unsafe-hash",
    parsed.unsafe_hash.hi == original.unsafe_hash.hi && parsed.unsafe_hash.lo == original.unsafe_hash.lo)
  # The lane's canonical definition ids (used by the new table checks and
  # the call-key hydration check at the end).
  let f = snapshot_parse_lane_def("lane::f#fn(i64)->i64")
  let g = snapshot_parse_lane_def("lane::g#fn(i64)->i64")
  let thing = snapshot_parse_lane_def("lane::Thing")
  let show = snapshot_parse_lane_def("lane::Show")
  # (fourth-audit P1-5) the header feature/option payload and the
  # per-domain digest record round-trip exactly.
  snapshot_parse_lane_row(&mut out, "feature-set-roundtrip",
    parsed.feature_set.len() == 2 && parsed.feature_set[0] == "budgets" &&
    parsed.feature_set[1] == "target-feature:neon")
  snapshot_parse_lane_row(&mut out, "semantic-options-roundtrip",
    parsed.semantic_options.len() == 2 && parsed.semantic_options[0] == "opt-level:2" &&
    parsed.semantic_options[1] == "pgo-use:/tmp/a,b/c")
  snapshot_parse_lane_row(&mut out, "domain-digests-roundtrip",
    parsed.domain_digests.concrete_types.hi == 0xdddddddddddddddd &&
    parsed.domain_digests.concrete_types.lo == 0xeeeeeeeeeeeeeeee &&
    parsed.domain_digests.drop_plans.hi == 0x0101010101010101 &&
    parsed.domain_digests.allocation_sites.lo == 0x0404040404040404 &&
    parsed.domain_digests.features.hi == 0x0505050505050505)
  # A feature-set-only edit moves the snapshot digest (the header joins the
  # preimage).
  var dg_a = original.clone()
  var dg_b = original.clone()
  dg_b.semantic_options = Vec::from(["opt-level:3".to_string(), "pgo-use:/tmp/a,b/c".to_string()])
  let dg_a_words = semantic_snapshot_digest(&dg_a)
  let dg_b_words = semantic_snapshot_digest(&dg_b)
  snapshot_parse_lane_row(&mut out, "semantic-options-join-digest",
    dg_a_words.hi != dg_b_words.hi || dg_a_words.lo != dg_b_words.lo)
  # (fourth-audit P1-3) the typed member/signature rows round-trip with
  # their delimiter-carrying names.
  snapshot_parse_lane_row(&mut out, "fields-roundtrip",
    parsed.fields.len() == 1 && parsed.fields[0].name == "f\"x\\y,z(w)" &&
    parsed.fields[0].ty == "T[lane::Box[int]]" && parsed.fields[0].is_pub &&
    parsed.fields[0].owner.key == thing.key)
  snapshot_parse_lane_row(&mut out, "variants-roundtrip",
    parsed.variants.len() == 1 && parsed.variants[0].name == "A,b(c)" &&
    parsed.variants[0].payload.len() == 2 && parsed.variants[0].payload[0].name == "a,b(c)" &&
    parsed.variants[0].payload[1].ty == "T[lane::Box[int]]")
  snapshot_parse_lane_row(&mut out, "signatures-roundtrip",
    parsed.callable_signatures.len() == 1 &&
    parsed.callable_signatures[0].function.key == f.key &&
    parsed.callable_signatures[0].params.len() == 2 &&
    parsed.callable_signatures[0].params[0].convention == AccessConvention::Inout &&
    parsed.callable_signatures[0].params[0].name == "n,0" &&
    parsed.callable_signatures[0].declared_effects.len() == 2 &&
    parsed.callable_signatures[0].variadic)
  snapshot_parse_lane_row(&mut out, "trait-methods-roundtrip",
    parsed.trait_methods.len() == 1 && parsed.trait_methods[0].name == "run,now" &&
    parsed.trait_methods[0].owner.key == show.key)
  snapshot_parse_lane_row(&mut out, "concrete-types-roundtrip",
    parsed.concrete_types.len() == 1 && parsed.concrete_types[0].instance_key == "lane::Box<T[int]>" &&
    parsed.concrete_types[0].size == 8 && parsed.concrete_types[0].layout_status == "ok")
  snapshot_parse_lane_row(&mut out, "allocation-sites-roundtrip",
    parsed.allocation_sites.len() == 2 &&
    parsed.allocation_sites[0].size_kind == SemanticAllocationSizeKind::Exact &&
    parsed.allocation_sites[0].size == 64 &&
    parsed.allocation_sites[1].size_kind == SemanticAllocationSizeKind::Unbounded)
  snapshot_parse_lane_row(&mut out, "effect-flags",
    parsed.effects.len() > 0 && parsed.effects[0].summary.may_allocate &&
    parsed.effects[0].summary.may_io && parsed.effects[0].summary.may_sleep &&
    parsed.effects[0].summary.may_unsafe && !parsed.effects[0].summary.may_block &&
    !parsed.effects[0].summary.may_spawn && !parsed.effects[0].summary.may_panic)
  snapshot_parse_lane_row(&mut out, "effect-purity",
    parsed.effects.len() > 0 && parsed.effects[0].purity_status == "ProvenPure")
  snapshot_parse_lane_row(&mut out, "ownership-convention",
    parsed.ownership.len() > 0 && semantic_access_convention_numeric(&parsed.ownership[0].convention) == 1)
  snapshot_parse_lane_row(&mut out, "contract-message",
    parsed.contracts.len() > 0 && parsed.contracts[0].message.is_some())
  snapshot_parse_lane_row(&mut out, "coverage-arm",
    parsed.coverage.len() > 0 && parsed.coverage[0].arm_id.is_some())
  snapshot_parse_lane_row(&mut out, "mir-counts",
    parsed.mir_functions.len() > 0 && parsed.mir_functions[0].block_count == 3 &&
    parsed.mir_functions[0].statement_count == 5 && parsed.mir_functions[0].local_count == 2)
  snapshot_parse_lane_row(&mut out, "unsafe-digest-words",
    parsed.unsafe_facts.len() > 0 && parsed.unsafe_facts[0].digest_hi == 0x11 &&
    parsed.unsafe_facts[0].digest_lo == 0x22)
  snapshot_parse_lane_row(&mut out, "drop-plan-roundtrip",
    parsed.drop_plans.len() > 0 && parsed.drop_plans[0].place == "x[0].field" &&
    parsed.drop_plans[0].drop_site == "edge:normal:B7" &&
    parsed.drop_plans[0].conditional_paths.len() == 2 &&
    parsed.drop_plans[0].conditional_paths[0] == "branch:false" &&
    parsed.drop_plans[0].kind == "branch-cleanup")
  snapshot_parse_lane_row(&mut out, "abi-negative-size",
    parsed.abi_surfaces.len() > 0 && parsed.abi_surfaces[0].size == -1 &&
    parsed.abi_surfaces[0].alignment == -1)
  var canonical_call = false
  for c in parsed.calls do
    if c.caller.key == f.key && c.callee.key == g.key then
      canonical_call = true
    end
  end
  snapshot_parse_lane_row(&mut out, "call-key-hydration", canonical_call)
  snapshot_parse_lane_row(&mut out, "contract-key-hydration",
    parsed.contracts.len() > 0 && parsed.contracts[0].id.stable_key.len() > 0)
  out
end

# ———————————————————————————————————————————————————————————————
# The persistent declaration-lineage lane (third-audit item 11;
# fourth-audit P0-1/P0-2/P0-3)
# ———————————————————————————————————————————————————————————————
# ONE DeclLineageStore threaded across builds of the def walk's stamping
# stage (snapshot_stamp_decls — the builder's own store seam). The lane
# pins the fourth-audit behaviors:
#   * MOVE-STABLE IDENTITY (P0-1): a declaration moved from a::foo to
#     b::foo keeps its StableDeclId (the identity digests package, lineage
#     and kind only; the module path is revision metadata);
#   * RENAME via an EXPLICIT DeclContinuation ALWAYS keeps the id — even
#     when the signature changed — because continuations take precedence
#     over every heuristic (P0-3a);
#   * RENAME HEURISTIC (P0-3b) keeps the id only with the strong evidence:
#     unique same-package/same-kind/same-signature candidate seen in the
#     immediately preceding revision and gone from this build;
#   * NO REBIND without that evidence: a delete observed in one revision
#     followed by an unrelated same-signature creation in a LATER revision
#     is removed+created (the removed entry is tombstoned, the new one gets
#     a fresh lineage). A same-revision disappearance+appearance with an
#     identical kind/signature is observationally a rename and the
#     heuristic treats it as one — that is exactly why the immediately-
#     preceding-revision evidence exists;
#   * the unique-match and signature guards stay (ambiguous or
#     different-signature matches bootstrap fresh);
#   * RESTART PERSISTENCE (P0-2): the v2 store persists the signature
#     digest words/fingerprint/revision clock, so save -> load -> rename
#     rebinds exactly as in-process; a v1 legacy body converts with zero
#     sig digests and re-signs on the next build;
#   * reformatting (identical canonical signature text) and a signature
#     EDIT (same location, changed fingerprint) both keep the id.
# Returns mismatch rows (empty = the whole lane verifies) — the sibling
# lane-check convention (semantic_edit_lane_check /
# affected_closure_lane_check). The lane drives the builder's stamping
# stage with hand-built declaration seeds: the full finalized-state
# pipeline is not constructible from a test lane, and the stage under test
# IS the store seam the def walk uses.

def snapshot_lineage_seed(module_path: String, kind: String, name: String, sig: String) -> SnapshotDeclSeed
  let d = stable_digest_of(&sig)
  SnapshotDeclSeed {
    package_key: "".to_string(),
    module_path: module_path,
    kind: kind,
    name: name,
    sig_digest_hi: d.hi,
    sig_digest_lo: d.lo,
    sig_text: sig
  }
end

def snapshot_lineage_row(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name)
  end
  ()
end

def snapshot_lineage_same(a: StableDeclId, b: StableDeclId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

pub def snapshot_lineage_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— (1) the continuity lane: an unrelated insertion and a rename ————
  var store = stable_lineage_store_new()
  let d1 = snapshot_stamp_decls(&mut store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "a".to_string(), "fn()->unit".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "b".to_string(), "fn(int)->int".to_string())
  ]))

  # build 2: an unrelated declaration x inserted before b.
  let d2 = snapshot_stamp_decls(&mut store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "a".to_string(), "fn()->unit".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "x".to_string(), "fn()->bool".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "b".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "insertion-a-keeps-lineage", snapshot_lineage_same(d1[0], d2[0]))
  snapshot_lineage_row(&mut out, "insertion-b-keeps-lineage", snapshot_lineage_same(d1[1], d2[2]))
  snapshot_lineage_row(&mut out, "insertion-x-is-fresh",
    !snapshot_lineage_same(d2[1], d1[0]) && !snapshot_lineage_same(d2[1], d1[1]))

  # build 3: b renamed to c (same kind, same signature, immediately
  # preceding revision evidence).
  let d3 = snapshot_stamp_decls(&mut store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "a".to_string(), "fn()->unit".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "x".to_string(), "fn()->bool".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "c".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "rename-c-keeps-b-lineage", snapshot_lineage_same(d3[2], d1[1]))
  snapshot_lineage_row(&mut out, "rename-a-keeps-lineage", snapshot_lineage_same(d3[0], d1[0]))
  snapshot_lineage_row(&mut out, "rename-x-keeps-lineage", snapshot_lineage_same(d3[1], d2[1]))
  snapshot_lineage_row(&mut out, "rename-c-is-not-fresh",
    !snapshot_lineage_same(d3[2], d3[0]) && !snapshot_lineage_same(d3[2], d3[1]))

  # The row identity constructor carries the DNA: stable_def_id_of_decl's
  # digest words ARE the declaration's.
  let c_decl = d3[2]
  let c_sid = stable_def_id_of_decl(&c_decl, "m::c#fn(int)->int".to_string(), "m::c".to_string())
  snapshot_lineage_row(&mut out, "def-id-roots-on-lineage",
    c_sid.digest_hi == c_decl.digest_hi && c_sid.digest_lo == c_decl.digest_lo)

  # ———— (2) MOVE a::foo -> b::foo keeps the id (P0-1) ————
  var move_store = stable_lineage_store_new()
  let m1 = snapshot_stamp_decls(&mut move_store, Vec::from([
    snapshot_lineage_seed("a".to_string(), "Function".to_string(), "foo".to_string(), "fn(int)->int".to_string())
  ]))
  let m2 = snapshot_stamp_decls(&mut move_store, Vec::from([
    snapshot_lineage_seed("b".to_string(), "Function".to_string(), "foo".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "move-keeps-lineage", snapshot_lineage_same(m1[0], m2[0]))
  snapshot_lineage_row(&mut out, "move-updates-location-metadata", m2[0].module.path == "b")

  # ———— (3) an EXPLICIT continuation always keeps the id — even when the
  # signature changed (P0-3a: heuristics would reject this match) ————
  var cont_store = stable_lineage_store_new()
  let e1 = snapshot_stamp_decls(&mut cont_store, Vec::from([
    snapshot_lineage_seed("a".to_string(), "Function".to_string(), "foo".to_string(), "fn(int)->int".to_string())
  ]))
  let cont_old = stable_lineage_scope_key("".to_string(), "a".to_string(), "Function".to_string(), "foo".to_string())
  let cont_new = stable_lineage_scope_key("".to_string(), "b".to_string(), "Function".to_string(), "renamed".to_string())
  let cont_lineage = stable_lineage_store_lineage_of(cont_store.clone(), "".to_string(), "a".to_string(), "Function".to_string(), "foo".to_string())
  snapshot_lineage_row(&mut out, "lineage-lookup-of-structural-key", cont_lineage == e1[0].lineage)
  stable_lineage_store_add_continuation(&mut cont_store, cont_lineage, cont_old, cont_new, "rename".to_string())
  let e2 = snapshot_stamp_decls(&mut cont_store, Vec::from([
    snapshot_lineage_seed("b".to_string(), "Function".to_string(), "renamed".to_string(), "fn(int,int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "explicit-continuation-keeps-lineage", snapshot_lineage_same(e1[0], e2[0]))
  snapshot_lineage_row(&mut out, "explicit-continuation-refreshes-fingerprint",
    e2[0].module.path == "b" && cont_store.entries[0].sig_fingerprint == "fn(int,int)->int")

  # ———— (4) the heuristic rename WITH the prev-revision evidence ————
  var heur_store = stable_lineage_store_new()
  let h1 = snapshot_stamp_decls(&mut heur_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "foo".to_string(), "fn(int)->int".to_string())
  ]))
  let h2 = snapshot_stamp_decls(&mut heur_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "bar".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "heuristic-rename-with-evidence-keeps", snapshot_lineage_same(h1[0], h2[0]))

  # ———— (5) NO rebind without the evidence: the delete is observed in one
  # revision, the unrelated same-signature creation in a LATER revision
  # -> removed + created, never guessed (P0-1 delete+unrelated-add) ————
  var stale_store = stable_lineage_store_new()
  let s1 = snapshot_stamp_decls(&mut stale_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "old".to_string(), "fn(int)->int".to_string())
  ]))
  let empty_seeds: Vec[SnapshotDeclSeed] = Vec::new()
  let _ = snapshot_stamp_decls(&mut stale_store, empty_seeds)
  snapshot_lineage_row(&mut out, "stale-delete-tombstones", stale_store.entries[0].tombstone)
  let s3 = snapshot_stamp_decls(&mut stale_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "new".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "delete-add-unrelated-different-ids", !snapshot_lineage_same(s1[0], s3[0]))
  snapshot_lineage_row(&mut out, "delete-add-unrelated-old-retired", stale_store.entries[0].tombstone)

  # ———— (6) RESTART PERSISTENCE (v2): the sig digest words, the
  # fingerprint and the revision clock survive save -> load, so a rename
  # after a restart rebinds exactly as in-process (NO re-sign build) ————
  var save_store = stable_lineage_store_new()
  let r1 = snapshot_stamp_decls(&mut save_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "a".to_string(), "fn()->unit".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "b".to_string(), "fn(int)->int".to_string())
  ]))
  let saved_text = stable_lineage_store_save(save_store.clone())
  snapshot_lineage_row(&mut out, "restart-v2-header-present", saved_text.starts_with("tg-lineage-store v2|"))
  var loaded = stable_lineage_store_load(saved_text.clone())
  let b_sig = "fn(int)->int".to_string()
  let b_digest = stable_digest_of(&b_sig)
  snapshot_lineage_row(&mut out, "restart-v2-persists-sig-digest",
    loaded.entries[1].sig_digest_hi == b_digest.hi && loaded.entries[1].sig_digest_lo == b_digest.lo)
  snapshot_lineage_row(&mut out, "restart-v2-persists-fingerprint",
    loaded.entries[1].sig_fingerprint == "fn(int)->int")
  snapshot_lineage_row(&mut out, "restart-v2-header-roundtrip",
    loaded.revision == save_store.revision && stable_lineage_store_save(loaded.clone()) == saved_text)
  let r2 = snapshot_stamp_decls(&mut loaded, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "a".to_string(), "fn()->unit".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "c".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "restart-v2-rename-keeps-lineage", snapshot_lineage_same(r2[1], r1[1]))

  # ———— (7) v1 LEGACY conversion: the numbers survive, the sig digests
  # convert to 0/0 and the next build re-signs; a rename afterwards
  # rebinds ————
  var legacy = stable_lineage_store_load("|m|Function|legacy|7\n".to_string())
  snapshot_lineage_row(&mut out, "legacy-v1-lineage-preserved", legacy.entries[0].lineage == 7)
  snapshot_lineage_row(&mut out, "legacy-v1-next-preserved", legacy.next == 8)
  snapshot_lineage_row(&mut out, "legacy-v1-sig-unknown",
    legacy.entries[0].sig_digest_hi == 0 && legacy.entries[0].sig_digest_lo == 0)
  let l1 = snapshot_stamp_decls(&mut legacy, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "legacy".to_string(), "fn()->unit".to_string())
  ]))
  let l2 = snapshot_stamp_decls(&mut legacy, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "renamed".to_string(), "fn()->unit".to_string())
  ]))
  snapshot_lineage_row(&mut out, "legacy-v1-resign-enables-rebind", snapshot_lineage_same(l1[0], l2[0]))

  # ———— (8) reformatting (identical canonical signature text) and a
  # signature EDIT (same location, changed fingerprint) keep the id ————
  var fmt_store = stable_lineage_store_new()
  let f1 = snapshot_stamp_decls(&mut fmt_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "fmt".to_string(), "fn(int)->int".to_string())
  ]))
  let f2 = snapshot_stamp_decls(&mut fmt_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "fmt".to_string(), "fn(int)->int".to_string())
  ]))
  let f3 = snapshot_stamp_decls(&mut fmt_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "fmt".to_string(), "fn(int,int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "reformat-keeps-lineage", snapshot_lineage_same(f1[0], f2[0]))
  snapshot_lineage_row(&mut out, "signature-edit-keeps-lineage", snapshot_lineage_same(f1[0], f3[0]))

  # ———— (9) the unique-match guard: two same-kind/same-signature
  # disappeared candidates leave a new name without a rebind ————
  var store2 = stable_lineage_store_new()
  let d4 = snapshot_stamp_decls(&mut store2, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "p".to_string(), "fn(int)->int".to_string()),
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "q".to_string(), "fn(int)->int".to_string())
  ]))
  let d5 = snapshot_stamp_decls(&mut store2, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "r".to_string(), "fn(int)->int".to_string())
  ]))
  snapshot_lineage_row(&mut out, "ambiguous-rename-is-fresh",
    !snapshot_lineage_same(d5[0], d4[0]) && !snapshot_lineage_same(d5[0], d4[1]))

  # ———— (10) the signature guard: a same-kind disappeared entry with a
  # DIFFERENT signature is not a rename candidate ————
  var store3 = stable_lineage_store_new()
  let d6 = snapshot_stamp_decls(&mut store3, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "s".to_string(), "fn(int)->int".to_string())
  ]))
  let d7 = snapshot_stamp_decls(&mut store3, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "t".to_string(), "fn(bool)->bool".to_string())
  ]))
  snapshot_lineage_row(&mut out, "signature-mismatch-is-fresh", !snapshot_lineage_same(d7[0], d6[0]))

  # ———— (11) explicit continuations PERSIST (v2 "c|" lines, escaped
  # locations) and still take precedence after a restart ————
  var cont2_store = stable_lineage_store_new()
  let p1 = snapshot_stamp_decls(&mut cont2_store, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "orig".to_string(), "fn(int)->int".to_string())
  ]))
  let c_old = stable_lineage_scope_key("".to_string(), "m".to_string(), "Function".to_string(), "orig".to_string())
  let c_new = stable_lineage_scope_key("".to_string(), "m".to_string(), "Function".to_string(), "moved".to_string())
  stable_lineage_store_add_continuation(&mut cont2_store, cont2_store.entries[0].lineage, c_old, c_new, "move".to_string())
  let cont2_text = stable_lineage_store_save(cont2_store.clone())
  var cont2_loaded = stable_lineage_store_load(cont2_text)
  snapshot_lineage_row(&mut out, "restart-v2-continuation-persisted", cont2_loaded.continuations.len() == 1)
  let p2 = snapshot_stamp_decls(&mut cont2_loaded, Vec::from([
    snapshot_lineage_seed("m".to_string(), "Function".to_string(), "moved".to_string(), "fn(bool)->bool".to_string())
  ]))
  snapshot_lineage_row(&mut out, "restart-v2-continuation-still-wins", snapshot_lineage_same(p1[0], p2[0]))

  out
end
