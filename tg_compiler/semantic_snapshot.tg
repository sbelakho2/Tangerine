  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let template = match snapshot_string_field(fields.clone(), "template".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let args_text = match snapshot_string_field(fields.clone(), "args".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let size = match snapshot_int_field(fields.clone(), "size".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let alignment = match snapshot_int_field(fields.clone(), "align".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let status = match snapshot_string_field(fields.clone(), "status".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let fields_text = match snapshot_string_field(fields.clone(), "fields".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  Result::Ok(SemanticConcreteType {
    instance_key: instance_key,
    template: template,
    args: snapshot_split_double_semicolons(args_text),
    size: size,
    alignment: alignment,
    fields: snapshot_split_double_semicolons(fields_text),
    layout_status: status
  })
end

def snapshot_parse_allocation_site_row(fields: Vec[SnapshotField], line_no: Int) -> Result[SemanticAllocationSite, String]
  let tag = "alloc-site".to_string()
  let function_key = match snapshot_string_field(fields.clone(), "f".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let site = match snapshot_string_field(fields.clone(), "site".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind_word = match snapshot_string_field(fields.clone(), "kind".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let size_kind = match snapshot_allocation_size_kind_of_word(kind_word.clone())
  when Result::Err(e) then return Result::Err(snapshot_line_error(line_no, tag.clone(), e))
  when Result::Ok(v) then v
  end
  let size = match snapshot_int_field(fields.clone(), "size".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  Result::Ok(SemanticAllocationSite {
    function: function_key,
    site: site,
    size_kind: size_kind,
    size: size
  })
end

def snapshot_parse_field_row(fields: Vec[SnapshotField], line_no: Int) -> Result[SemanticField, String]
  let tag = "field".to_string()
  let owner_digest = match snapshot_digest_field(fields.clone(), "o".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let name = match snapshot_string_field(fields.clone(), "name".to_string(), tag.clone(), line_no)
