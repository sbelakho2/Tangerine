# ———————————————————————————————————————————————————————————————
# Snapshot errors — the hard-failure vocabulary (audit item 8)
# ———————————————————————————————————————————————————————————————
# The snapshot builder is Result-typed: every internal renderer that could
# degrade a semantic identity to a per-compilation id (a "Named#<TypeId>"
# fallback, a positional field/variant name with an unresolvable owner, an
# out-of-range local, a def whose registration key cannot be recovered)
# FAILS the snapshot instead. The variants the file's chains produce today
# are UnstableTypeIdentity / UnstableFieldIdentity /
# UnstableVariantIdentity / UnstableLocalIdentity / UnstableDefIdentity
# (each Err site documents its exact condition); the remaining variants
# (UnstableClosureIdentity — a closure-carried type whose identity render
# is not recoverable; UnstableBlockIdentity — a block-site keying
# invariant; UnstableInstanceDisplay — an instance whose emission key text
# cannot be derived; UnstableTarget — a target-record render/digest
# failure) are reserved for the corresponding builder chains, which
# currently have no fallback path to replace — they exist so the enum is
# the ONE error vocabulary of this module and later chains never invent
# ad-hoc failures.
enum SnapshotError
  UnstableTypeIdentity(tid: String)
  UnstableDefIdentity
  UnstableFieldIdentity
  UnstableVariantIdentity
  UnstableLocalIdentity
  UnstableClosureIdentity
  UnstableBlockIdentity
  UnstableInstanceDisplay
  UnstableTarget
end

# ———————————————————————————————————————————————————————————————
# Target identity
# ———————————————————————————————————————————————————————————————

# The TargetId of the compiler's ONE AsmTarget (the codegen target the
# snapshot hook receives): the deterministic "<arch>-<os>" text of the
# canonical target pair (TargetDesc.name-style names; pointer width and
# the ABI-relevant policies are target-desc data that never ride the
# snapshot tables — the target text rides the header). This asm-level
# render stays for the pre-desc consumers; the snapshot record itself
# carries the full StableTargetId built by stable_target_id_of below.
pub def semantic_target_id_of(target: AsmTarget) -> TargetId
  var arch = match target.arch
  when Arch::X86_64 then "x86_64"
  when Arch::AArch64 then "aarch64"
  end
  var os = match target.os
  when OsAbi::Linux then "linux"
  when OsAbi::MacOS then "darwin"
  when OsAbi::Windows then "windows"
  end
  TargetId { name: arch + "-" + os }
end

# ———————————————————————————————————————————————————————————————
# The full target identity — the canonical TargetDesc word renders
# ———————————————————————————————————————————————————————————————
# The StableTargetId fields are canonical words of the REAL TargetDesc
# record (target_desc.tg). Word vocabulary below; every list that is a
# SET (isa_features, the atomic width classes) is sorted before it rides
# the record; the register-class / memory-space lists are ORDERED ABI data
# and ride the digest text verbatim in declaration order. The digest words
# digest the COMPLETE record rendered canonically (snapshot_target_desc_text)
# — an M4 desc and an M4F desc differ in name/cpu/fpu/float_abi (and
# therefore in the digest), so M4 vs M4F snapshots can never agree.

def snapshot_target_arch_text(arch: tg_compiler::target_desc::Arch) -> String
  match arch
  when Arch::Armv6M then "armv6m"
  when Arch::Armv7M then "armv7m"
  when Arch::AArch64 then "aarch64"
  when Arch::X86_64 then "x86_64"
  when Arch::RiscV32 then "riscv32"
  when Arch::RiscV64 then "riscv64"
  end
end

def snapshot_target_cpu_text(cpu: Cpu) -> String
  match cpu
  when Cpu::CortexM0 then "cortex-m0"
  when Cpu::CortexM0Plus then "cortex-m0+"
  when Cpu::CortexM3 then "cortex-m3"
  when Cpu::CortexM4 then "cortex-m4"
  when Cpu::CortexM4F then "cortex-m4f"
  when Cpu::CortexM7 then "cortex-m7"
  when Cpu::GenericAArch64 then "generic-aarch64"
  when Cpu::GenericX86_64 then "generic-x86_64"
  when Cpu::GenericRiscV32 then "generic-riscv32"
  when Cpu::GenericRiscV64 then "generic-riscv64"
  end
end

def snapshot_target_endian_text(e: Endianness) -> String
  match e
  when Endianness::Little then "little"
  when Endianness::Big then "big"
  end
end

def snapshot_target_float_abi_text(f: FloatAbi) -> String
  match f
  when FloatAbi::Soft then "soft"
  when FloatAbi::SoftFp then "softfp"
  when FloatAbi::Hard then "hard"
  end
end

def snapshot_target_fpu_text(f: Fpu) -> String
  match f
  when Fpu::None then "none"
  when Fpu::FPv4SP then "fpv4sp"
  when Fpu::FPv5D16 then "fpv5d16"
  when Fpu::FPv5SP then "fpv5sp"
  when Fpu::AdvSimdA64 then "advsimd-a64"
  when Fpu::Sse2 then "sse2"
  when Fpu::RVF then "rvf"
  when Fpu::RVD then "rvd"
  end
end

def snapshot_target_div_text(d: IntegerDiv) -> String
  match d
  when IntegerDiv::None then "none"
  when IntegerDiv::RuntimeHelper then "runtime-helper"
  when IntegerDiv::Hardware then "hardware"
  end
end

def snapshot_target_unaligned_text(u: UnalignedPolicy) -> String
  match u
  when UnalignedPolicy::Allowed then "allowed"
  when UnalignedPolicy::Faulting then "faulting"
  end
end

def snapshot_target_int_list_text(ws: Vec[Int]) -> String
  var vals = ws.clone()
  vals.sort()
  var parts = Vec::new()
  for v in vals do
    parts.push(v.to_string())
  end
  parts.join(",")
end

def snapshot_target_str_list_text(ws: Vec[String]) -> String
  var vals = ws.clone()
  vals.sort()
  vals.join(",")
end

def snapshot_target_str_list_ordered_text(ws: Vec[String]) -> String
  ws.join(",")
end

def snapshot_target_int_opt_text(c: Option[Int]) -> String
  match c
  when Option::Some(v) then v.to_string()
  when Option::None then "-"
  end
end

def snapshot_target_interrupt_text(abi: Option[InterruptAbi]) -> String
  match abi
  when Option::Some(a) then
    a.name.clone() + "|" + a.entry_auto_saved.join(",") + "|" +
      a.exit_rule.clone() + "|" + a.reserved.join(",")
  when Option::None then "-"
  end
end

# The COMPLETE canonical record text of a TargetDesc — every field
# participates in the identity digest (a change to any ABI/feature/register
# datum moves the snapshot's target digest). List fields: isa_features and
# the three atomic width classes are SETS and are canonicalized (sorted);
# reg_caller_saved / reg_callee_saved / arg_regs / memory_spaces and the
# interrupt record are ORDERED ABI data and render verbatim in declaration
# order. Enumerated words are the snapshot_target_*_text vocabulary above.
def snapshot_target_desc_text(desc: TargetDesc) -> String
  var lines: Vec[String] = Vec::new()
  lines.push("name=" + desc.name.clone())
  lines.push("pointer_width=" + desc.pointer_width.to_string())
  lines.push("endianness=" + snapshot_target_endian_text(&desc.endianness))
  lines.push("stack_alignment=" + desc.stack_alignment.to_string())
  lines.push("arch=" + snapshot_target_arch_text(&desc.arch))
  lines.push("cpu=" + snapshot_target_cpu_text(&desc.cpu))
  lines.push("isa=" + desc.isa.clone())
  lines.push("isa_features=" + snapshot_target_str_list_text(&desc.isa_features))
  lines.push("float_abi=" + snapshot_target_float_abi_text(&desc.float_abi))
  lines.push("fpu=" + snapshot_target_fpu_text(&desc.fpu))
  lines.push("fpu_register_width=" + desc.fpu_register_width.to_string())
  lines.push("integer_div=" + snapshot_target_div_text(&desc.integer_div))
  lines.push("native_atomic_widths=" + snapshot_target_int_list_text(&desc.native_atomic_widths))
  lines.push("emulated_atomic_widths=" + snapshot_target_int_list_text(&desc.emulated_atomic_widths))
  lines.push("mmio_atomic_widths=" + snapshot_target_int_list_text(&desc.mmio_atomic_widths))
  lines.push("unaligned_policy=" + snapshot_target_unaligned_text(&desc.unaligned_policy))
  lines.push("cache_line_size=" + snapshot_target_int_opt_text(&desc.cache_line_size))
  lines.push("red_zone=" + desc.red_zone.to_string())
  lines.push("tls_model=" + desc.tls_model.clone())
  lines.push("interrupt_abi=" + snapshot_target_interrupt_text(&desc.interrupt_abi))
  lines.push("reg_caller_saved=" + snapshot_target_str_list_ordered_text(&desc.reg_caller_saved))
  lines.push("reg_callee_saved=" + snapshot_target_str_list_ordered_text(&desc.reg_callee_saved))
  lines.push("arg_regs=" + snapshot_target_str_list_ordered_text(&desc.arg_regs))
  lines.push("memory_spaces=" + snapshot_target_str_list_ordered_text(&desc.memory_spaces))
  lines.sort_by(|a, b| a < b)
  var text = ""
  for l in lines do
    text = text + l + "\n"
  end
  text
end

# The StableTargetId of the compilation's REAL TargetDesc record: the
# canonical words of the header fields, the canonicalized (sorted) feature
# and width lists, and the 128-bit digest of the COMPLETE record text
# (snapshot_target_desc_text). The "abi" word is the integer-model word of
# target_desc.tg's documented rule (pointer_width 8 -> lp64, 4 -> ilp32).
def stable_target_id_of(desc: TargetDesc) -> StableTargetId
  var isa_features = desc.isa_features.clone()
  isa_features.sort()
  var widths = desc.native_atomic_widths.clone()
  widths.sort()
  let d = stable_digest_of(&snapshot_target_desc_text(&desc))
  var abi_word = "ilp32".to_string()
  if desc.pointer_width == 8 then
    abi_word = "lp64"
  end
  StableTargetId {
    triple: desc.name.clone(),
    arch: snapshot_target_arch_text(&desc.arch),
    cpu: snapshot_target_cpu_text(&desc.cpu),
    pointer_width: desc.pointer_width,
    endian: snapshot_target_endian_text(&desc.endianness),
    abi: abi_word,
    float_abi: snapshot_target_float_abi_text(&desc.float_abi),
    isa_features: isa_features,
    native_atomic_widths: widths,
    digest_hi: d.hi,
    digest_lo: d.lo
  }
end

# ———————————————————————————————————————————————————————————————
# The header feature set / semantic options (fourth-audit P1-5a)
# ———————————————————————————————————————————————————————————————
# The SEMANTICALLY RELEVANT projection of the compile options and target
# features the compile actually ran with. The derivation reads the REAL
# CompilerOptions record (the option authority — every field below is the
# same value the passes consumed) plus the TargetDesc's isa_features; the
# results are canonical words, sorted, and ride the snapshot header row and
# the digest preimage. COSMETIC options (color, verbosity, warnings, JSON
# diagnostics, output paths, input files, check-only) never appear: they
# cannot change a semantic table. The exact grammar:
#   feature_set:
#     contracts | no-contracts            (opts.enable_contracts)
#     capabilities | no-capabilities      (opts.enable_capabilities)
#     effects | no-effects                (opts.enable_effects)
#     budgets | no-budgets                (opts.enable_budgets)
#     strict-resolution                   (opts.strict_resolution)
#     coverage                            (opts.coverage)
#     verify-everything                   (opts.verify_everything)
#     target-feature:<f>                  (one per desc.isa_features entry)
#   semantic_options:
#     opt-level:<n>                       (opts.opt_level)
#     codegen:<direct|lir>                (opts.codegen)
#     emit:<executable|object|assembly|mir> (opts.emit)
#     mode:<dev|strict|production|hardened> (opts.mode)
#     stop-after:<parse|semantic|mir|object|link> (opts.stop_after)
#     pgo-gen:<path> / pgo-use:<path>     (when the option carries one)

def snapshot_emit_mode_word(m: EmitMode) -> String
  match m
  when EmitMode::Executable then "executable"
  when EmitMode::Object then "object"
  when EmitMode::Assembly then "assembly"
  when EmitMode::MIR then "mir"
  end
end

def snapshot_stop_after_word(s: StopAfter) -> String
  match s
  when StopAfter::Parse then "parse"
  when StopAfter::Semantic then "semantic"
  when StopAfter::Mir then "mir"
  when StopAfter::Object then "object"
  when StopAfter::Link then "link"
  end
end

def snapshot_mode_word(m: Mode) -> String
  match m
  when Mode::Dev then "dev"
  when Mode::Strict then "strict"
  when Mode::Production then "production"
  when Mode::Hardened then "hardened"
  end
end

def snapshot_codegen_route_word(r: CodegenRoute) -> String
  match r
  when CodegenRoute::Direct then "direct"
  when CodegenRoute::Lir then "lir"
  end
end

pub def snapshot_feature_set_of(opts: CompilerOptions, desc: TargetDesc) -> Vec[String]
  var out: Vec[String] = Vec::new()
  if opts.enable_contracts then out.push("contracts".to_string()) else out.push("no-contracts".to_string()) end
  if opts.enable_capabilities then out.push("capabilities".to_string()) else out.push("no-capabilities".to_string()) end
  if opts.enable_effects then out.push("effects".to_string()) else out.push("no-effects".to_string()) end
  if opts.enable_budgets then out.push("budgets".to_string()) else out.push("no-budgets".to_string()) end
  if opts.strict_resolution then out.push("strict-resolution".to_string()) end
  if opts.coverage then out.push("coverage".to_string()) end
  if opts.verify_everything then out.push("verify-everything".to_string()) end
  var feats = desc.isa_features.clone()
  feats.sort()
  for f in feats do
    out.push("target-feature:" + f.clone())
  end
  out.sort()
  out
end

pub def snapshot_semantic_options_of(opts: CompilerOptions, desc: TargetDesc) -> Vec[String]
  var out: Vec[String] = Vec::new()
  out.push("opt-level:" + opts.opt_level.to_string())
  out.push("codegen:" + snapshot_codegen_route_word(&opts.codegen))
  out.push("emit:" + snapshot_emit_mode_word(&opts.emit))
  out.push("mode:" + snapshot_mode_word(&opts.mode))
  out.push("stop-after:" + snapshot_stop_after_word(&opts.stop_after))
  match opts.pgo_gen.clone()
  when Option::Some(p) then out.push("pgo-gen:" + p)
  when Option::None then ()
  end
  match opts.pgo_use.clone()
  when Option::Some(p2) then out.push("pgo-use:" + p2)
  when Option::None then ()
  end
  out.sort()
  out
end


struct SnapshotBuildCtx
  env: TypeEnv
  typed: TypedProgram
  mir: MirProgram
  # ModuleId.id -> module path text ("a::b"; "" for the root).
  module_paths: Map[Int, String]
  # numeric DefId (def_id_numeric) -> module_symbols registration key.
  key_of_def: Map[Int, String]
  # module_symbols key -> numeric DefId.
  numeric_of_key: Map[String, Int]
  # module_symbols key -> TypeId.id (the type-to-declaration association).
  type_id_of_key: Map[String, Int]
  # TypeId.id -> TypeEnv.type_list index.
  type_list_index: Map[Int, Int]
  # TypeId.id -> MirProgram.types index (field/variant names).
  mir_type_index: Map[Int, Int]
  # CALLABLE-ID index (audit item 10 — the ONLY callable->lowering
  # resolution authority; no bare-name function scan exists anywhere in
  # this module): numeric DefId of the callable (def_id_numeric of the
  # CallableId.def) -> index of its MirFunction in mir.functions. Def-keyed
  # functions register under their stamped callable (callable = Some);
  # EXTERN functions (callable = None — the lowering never stamps them)
  # register under the numeric of the module_symbols registration whose
  # key's name-part equals the extern's bare emission name (first-wins in
  # registration order; documented deterministic join — an extern declared
  # in several modules lowers ONE emission symbol per name).
  mir_fn_by_callable: Map[Int, Int]
  # Emission name -> numeric DefId of the def-keyed lowering that owns it
  # (callable = Some, first-wins) — the name-only MirFnItem resolution
  # index (the old -3 sentinel path; membership doubles as the
  # "is a def-keyed emission name" test).
  def_emission_numeric: Map[String, Int]
  # Emission name -> index of an extern lowering (is_extern; first-wins) —
  # the extern-call classification authority.
  extern_fn_by_name: Map[String, Int]
  # Emission names of the lowered functions WITH a body (blocks > 0) — the
  # deinit-known test authority (a name whose glue/finalizer body exists).
  body_names: Set[String]
  # Drop-glue emission name -> the concrete drop-glue type identity key
  # text the glue was registered under (the MirProgram.drop_glue_instances
  # key of the glue's InstanceId — the reverse of drop_glue_fns; the
  # item-12 MirOrigin::DropGlue row key source).
  glue_type_key_of_name: Map[String, String]
end

def snapshot_def_of_numeric(ctx: SnapshotBuildCtx, numeric: Int) -> DefId
  # def_id_numeric packs (module.id << 32) + index (ids.tg); unpacked here
  # ONLY for the def_kinds / typed-signature lookups — the numeric keys are
  # unique per (module, index), so the recovered DefId is the resolver's.
  let module_id = numeric >> 32
  let index = (numeric - (module_id << 32)) as UInt
  DefId { module: ModuleId { id: module_id }, index: index }
end

def snapshot_build_ctx(env: TypeEnv, typed: TypedProgram, mir: MirProgram) -> SnapshotBuildCtx
  var module_paths: Map[Int, String] = Map::new()
  for entry in typed.ast.crate.modules.entries() do
    module_paths.insert(entry.0.id, entry.1.path.join("::"))
  end
  var key_of_def: Map[Int, String] = Map::new()
  var numeric_of_key: Map[String, Int] = Map::new()
  for entry in typed.resolutions.module_symbols.entries() do
    let numeric = def_id_numeric(&entry.1)
    key_of_def.insert(numeric, entry.0.clone())
    numeric_of_key.insert(entry.0.clone(), numeric)
  end
  var type_id_of_key: Map[String, Int] = Map::new()
  for entry in typed.resolutions.type_def_ids.entries() do
    match key_of_def.get(def_id_numeric(&entry.1))
    when Option::Some(k) then type_id_of_key.insert(k.clone(), entry.0)
    when Option::None then ()
    end
  end
  var type_list_index: Map[Int, Int] = Map::new()
  for entry in env.type_id_index.entries() do
    type_list_index.insert(entry.0, entry.1)
  end
  var mir_type_index: Map[Int, Int] = Map::new()
  var ti = 0
  while ti < mir.types.len() do
    mir_type_index.insert(mir.types[ti].id.id, ti)
    ti = ti + 1
  end
  # The callable-index maps (item 10): one construction-time pass over the
  # lowered program builds every resolution index this module consults —
  # NO per-row/per-call function scan ever runs again.
  var mir_fn_by_callable: Map[Int, Int] = Map::new()
  var def_emission_numeric: Map[String, Int] = Map::new()
  var extern_fn_by_name: Map[String, Int] = Map::new()
  var body_names: Set[String] = Set::new()
  var fi = 0
  while fi < mir.functions.len() do
    let f = mir.functions[fi]
    if f.blocks.len() > 0 then
      body_names.insert(f.name.clone())
    end
    if f.is_extern then
      if !extern_fn_by_name.contains_key(&f.name) then
        extern_fn_by_name.insert(f.name.clone(), fi)
      end
    end
    match f.callable.clone()
    when Option::Some(cid) then
      let num = def_id_numeric(&cid.def)
      if !mir_fn_by_callable.contains_key(&num) then
        mir_fn_by_callable.insert(num, fi)
      end
      if !def_emission_numeric.contains_key(&f.name) then
        def_emission_numeric.insert(f.name.clone(), num)
      end
    when Option::None then ()
    end
    fi = fi + 1
  end
  # The extern callable join: every extern lowering's bare emission name is
  # matched to the FIRST module_symbols registration whose key's name-part
  # equals it and whose def-kind recovery is Function (deterministic,
  # registration order — the resolver registers externs as Function defs).
  # A numeric already claimed by a def-keyed lowering is never re-bound.
  for entry in numeric_of_key.entries() do
    let key = entry.0.clone()
    let numeric = entry.1
    if mir_fn_by_callable.contains_key(&numeric) then
      next
    end
    if !extern_fn_by_name.contains_key(&snapshot_key_name(&key)) then
      next
    end
    let module_id = numeric >> 32
    let index = (numeric - (module_id << 32)) as UInt
    let did = DefId { module: ModuleId { id: module_id }, index: index }
    match def_id_kind_of_recovery(&typed.resolutions, &did)
    when DefKind::Function then
      if !mir_fn_by_callable.contains_key(&numeric) then
        match extern_fn_by_name.get(snapshot_key_name(&key))
        when Option::Some(idx) then mir_fn_by_callable.insert(numeric, idx)
        when Option::None then ()
        end
      end
    when _ then ()
    end
  end
  # The drop-glue reverse index: concrete type identity key -> glue name
  # (MirProgram.drop_glue_instances value's def numeric looked up through
  # drop_glue_fns) — then name -> type key.
  var glue_type_key_of_name: Map[String, String] = Map::new()
  for entry in mir.drop_glue_instances.entries() do
    let type_key = entry.0.clone()
    let inst = entry.1
    let glue_numeric = def_id_numeric(&inst.def.def)
    match mir.drop_glue_fns.get(glue_numeric)
    when Option::Some(name) then
      if !glue_type_key_of_name.contains_key(&name) then
        glue_type_key_of_name.insert(name.clone(), type_key.clone())
      end
    when Option::None then ()
    end
  end
  SnapshotBuildCtx {
    env: env,
    typed: typed,
    mir: mir,
    module_paths: module_paths,
    key_of_def: key_of_def,
    numeric_of_key: numeric_of_key,
    type_id_of_key: type_id_of_key,
    type_list_index: type_list_index,
    mir_type_index: mir_type_index,
    mir_fn_by_callable: mir_fn_by_callable,
    def_emission_numeric: def_emission_numeric,
    extern_fn_by_name: extern_fn_by_name,
    body_names: body_names,
    glue_type_key_of_name: glue_type_key_of_name
  }
end

def snapshot_module_path_of(ctx: SnapshotBuildCtx, did: DefId) -> String
  match ctx.module_paths.get(did.module.id)
  when Option::Some(p) then p.clone()
  when Option::None then ""
  end
end

# The registered module-qualified name of a type ("path::Name").
# Result-typed (item 8): a TypeId that is NOT registered in the env's
# canonical type tables has no stable name — the historical "Named#" +
# TypeId fallback is a HARD FAILURE (UnstableTypeIdentity) now.
def snapshot_type_qualified_name(ctx: SnapshotBuildCtx, tid: TypeId) -> Result[String, SnapshotError]
  var ti_idx = -1
  match ctx.type_list_index.get(tid.id)
  when Option::Some(i) then ti_idx = i
  when Option::None then ()
  end
  if ti_idx >= 0 && ti_idx < ctx.env.type_list.len() then
    let td = ctx.env.type_list[ti_idx]
    var qname = td.name.clone()
    match td.def
    when Option::Some(did) then
      let path = snapshot_module_path_of(ctx, &did)
      if path.len() > 0 then
        qname = path + "::" + td.name
      end
    when Option::None then ()
    end
    return Result::Ok(qname)
  end
  Result::Err(SnapshotError::UnstableTypeIdentity(tid.id.to_string()))
end

# ———————————————————————————————————————————————————————————————
# Canonical type text — the snapshot's deterministic type rendering
# ———————————————————————————————————————————————————————————————
# One deterministic text per Type variant (the canonical-key signature
# component). Nominal Adts render by their module-qualified registered
# name; generic parameters by their semantic GenericParamId (the ids.tg
# identity); effects by their interned ids (sorted). Renderings never
# embed a per-compilation TypeId / ClosureId / span, and composites are
# bracket-delimited (unambiguous under concatenation).

def snapshot_conv_text(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

def snapshot_effect_ids_sorted(effects: Vec[EffectId]) -> Vec[Int]
  var ids: Vec[Int] = Vec::new()
  for e in effects do
    ids.push(e.id)
  end
  ids.sort()
  ids
end

def snapshot_effect_ids_text(effects: Vec[EffectId]) -> String
  var ids = snapshot_effect_ids_sorted(&effects)
  if ids.len() == 0 then return "" end
  var s = "effects("
  var i = 0
  while i < ids.len() do
    if i > 0 then s = s + "," end
    s = s + "e" + ids[i].to_string()
    i = i + 1
  end
  s + ")"
end

def snapshot_effect_ids_joined(effects: Vec[EffectId]) -> String
  var ids = snapshot_effect_ids_sorted(&effects)
  var s = ""
  var i = 0
  while i < ids.len() do
    if i > 0 then s = s + "," end
    s = s + "e" + ids[i].to_string()
    i = i + 1
  end
  s
end

# One deterministic text per Type variant, Result-typed (item 8): the
# nominal render resolves through the REGISTERED name (snapshot_type_
# qualified_name) — an unregistered TypeId is a hard failure, never a
# "Named#<id>" render. Composite recursion threads the Result.
def snapshot_type_text(ctx: SnapshotBuildCtx, ty: Type) -> Result[String, SnapshotError]
  match ty
  when Type::Unit then Result::Ok("unit")
  when Type::Bool then Result::Ok("bool")
  when Type::Int then Result::Ok("int")
  when Type::UInt then Result::Ok("uint")
  when Type::Float then Result::Ok("float")
  when Type::Char then Result::Ok("char")
  when Type::String then Result::Ok("str")
  when Type::StaticStrPtr then Result::Ok("staticstrptr")
  when Type::Never then Result::Ok("never")
  when Type::I8 then Result::Ok("i8")
  when Type::I16 then Result::Ok("i16")
  when Type::I32 then Result::Ok("i32")
  when Type::I64 then Result::Ok("i64")
  when Type::I128 then Result::Ok("i128")
  when Type::U8 then Result::Ok("u8")
  when Type::U16 then Result::Ok("u16")
  when Type::U32 then Result::Ok("u32")
  when Type::U64 then Result::Ok("u64")
  when Type::U128 then Result::Ok("u128")
  when Type::ISize then Result::Ok("isize")
  when Type::USize then Result::Ok("usize")
  when Type::F32 then Result::Ok("f32")
  when Type::F64 then Result::Ok("f64")
  when Type::IntLiteral(v) then Result::Ok("intlit(" + v.to_string() + ")")
  when Type::Adt(tid, args) then
    match snapshot_type_qualified_name(ctx, &tid)
    when Result::Ok(qname) then
      var s = "T[" + qname
      for a in args do
        match snapshot_type_text(ctx, &a)
        when Result::Ok(at) then s = s + "[" + at + "]"
        when Result::Err(e) then return Result::Err(e)
        end
      end
      Result::Ok(s + "]")
    when Result::Err(e2) then Result::Err(e2)
    end
  when Type::FixedArray(elem, n) then
    match snapshot_type_text(ctx, &elem)
    when Result::Ok(et) then Result::Ok("A[" + et + ";" + n.to_string() + "]")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::FixedArraySym(elem, gpid) then
    match snapshot_type_text(ctx, &elem)
    when Result::Ok(et) then Result::Ok("AS[" + et + ";c" + gpid.index.to_string() + "]")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::FnPtr(params, ret, effects) then
    match snapshot_type_text(ctx, &ret)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok(rt) then
      var parts = Vec::new()
      var perr: Option[SnapshotError] = Option::None
      for p in params do
        match snapshot_type_text(ctx, &p.ty)
        when Result::Ok(pt) then parts.push(snapshot_conv_text(&p.convention) + ":" + pt)
        when Result::Err(pe) then perr = Option::Some(pe)
        end
      end
      match perr
      when Option::Some(pe) then Result::Err(pe)
      when Option::None then Result::Ok("F(" + parts.join(",") + ")->" + rt + snapshot_effect_ids_text(&effects))
      end
    end
  when Type::Closure(_, params, ret, captures, effects) then
    match snapshot_type_text(ctx, &ret)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok(rt) then
      match snapshot_type_text(ctx, &captures)
      when Result::Err(e2) then Result::Err(e2)
      when Result::Ok(ct) then
        var parts2 = Vec::new()
        var perr2: Option[SnapshotError] = Option::None
        for p2 in params do
          match snapshot_type_text(ctx, &p2.ty)
          when Result::Ok(pt2) then parts2.push(snapshot_conv_text(&p2.convention) + ":" + pt2)
          when Result::Err(pe2) then perr2 = Option::Some(pe2)
          end
        end
        match perr2
        when Option::Some(pe2) then Result::Err(pe2)
        when Option::None then Result::Ok("C(" + parts2.join(",") + ")->" + rt + "{" + ct + "}" + snapshot_effect_ids_text(&effects))
        end
      end
    end
  when Type::RefInternal(inner, mutable) then
    match snapshot_type_text(ctx, &inner)
    when Result::Ok(it) then
      if mutable then
        Result::Ok("Rmut[" + it + "]")
      else
        Result::Ok("Rref[" + it + "]")
      end
    when Result::Err(e) then Result::Err(e)
    end
  when Type::Ptr(inner) then
    match snapshot_type_text(ctx, &inner)
    when Result::Ok(it2) then Result::Ok("P[" + it2 + "]")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::PtrMut(inner) then
    match snapshot_type_text(ctx, &inner)
    when Result::Ok(it3) then Result::Ok("Q[" + it3 + "]")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::Dyn(tid2) then
    match snapshot_type_qualified_name(ctx, &tid2)
    when Result::Ok(qn2) then Result::Ok("D[" + qn2 + "]")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::Effect(effects2, inner2) then
    match snapshot_type_text(ctx, &inner2)
    when Result::Ok(it4) then Result::Ok("E{" + snapshot_effect_ids_joined(&effects2) + "|" + it4 + "}")
    when Result::Err(e) then Result::Err(e)
    end
  when Type::Tuple(fields) then
    var parts3 = Vec::new()
    var perr3: Option[SnapshotError] = Option::None
    for f in fields do
      match snapshot_type_text(ctx, &f)
      when Result::Ok(ft) then parts3.push(ft)
      when Result::Err(fe) then perr3 = Option::Some(fe)
      end
    end
    match perr3
    when Option::Some(fe2) then Result::Err(fe2)
    when Option::None then Result::Ok("(" + parts3.join(",") + ")")
    end
  when Type::Var(_) then Result::Ok("var")
  when Type::Param(gpid) then Result::Ok("P" + gpid.index.to_string() + "o" + def_id_numeric(&gpid.owner).to_string())
  when Type::Const(v) then Result::Ok("const(" + v.to_string() + ")")
  when Type::ConstParam(gpid2) then Result::Ok("CP" + gpid2.index.to_string())
  when Type::ConstSym(_) then Result::Ok("constsym")
  when Type::Error then Result::Ok("err")
  end
end

# ———————————————————————————————————————————————————————————————
# Per-def canonical signature texts
# ———————————————————————————————————————————————————————————————

# The typed FnSignature of a def (the checker's typed def table keyed by
# the DefId's fn-owner key — the same key the MIR reads).
def snapshot_typed_fn_signature(ctx: SnapshotBuildCtx, did: DefId) -> Option[FnSignature]
  let key = fn_owner_key_of_def(&ctx.typed.ast, &ctx.typed.resolutions, &did)
  match ctx.typed.typed_fn_signatures.get(key)
  when Option::Some(sig) then Option::Some(sig.clone())
  when Option::None then Option::None
  end
end

def snapshot_fn_sig_text(ctx: SnapshotBuildCtx, sig: FnSignature) -> Result[String, SnapshotError]
  var parts = Vec::new()
  var perr: Option[SnapshotError] = Option::None
  for p in sig.params do
    match snapshot_type_text(ctx, &p.ty)
    when Result::Ok(pt) then parts.push(snapshot_conv_text(&p.convention) + ":" + pt)
    when Result::Err(pe) then perr = Option::Some(pe)
    end
  end
  match perr
  when Option::Some(pe) then return Result::Err(pe)
  when Option::None then ()
  end
  match snapshot_type_text(ctx, &sig.ret_type)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(rt) then
    Result::Ok("fn(" + parts.join(",") + ")->" + rt + snapshot_effect_ids_text(&sig.declared_effects))
  end
end

# The canonical signature text of a lowered def-keyed MirFunction (the
# typed-record fallback): parameter conventions recovered from the
# RefInternal wrap exactly like the mono ABI signature recovery.
def snapshot_mir_fn_sig_text(ctx: SnapshotBuildCtx, f: MirFunction) -> Result[String, SnapshotError]
  var parts = Vec::new()
  var perr: Option[SnapshotError] = Option::None
  for p in f.params do
    match p.ty
    when Type::RefInternal(inner, mutable) then
      match snapshot_type_text(ctx, &inner)
      when Result::Err(pe) then perr = Option::Some(pe)
      when Result::Ok(pt) then
        if mutable then
          parts.push("inout:" + pt)
        else
          parts.push("let:" + pt)
        end
      end
    when _ then
      match snapshot_type_text(ctx, &p.ty)
      when Result::Err(pe2) then perr = Option::Some(pe2)
      when Result::Ok(pt2) then parts.push("let:" + pt2)
      end
    end
  end
  match perr
  when Option::Some(pe3) then return Result::Err(pe3)
  when Option::None then ()
  end
  match snapshot_type_text(ctx, &f.ret_type)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(rt) then
    Result::Ok("fn(" + parts.join(",") + ")->" + rt + snapshot_effect_ids_text(&f.declared_effects))
  end
end

# The signature text of a Function/Method def: the typed record first, the
# callable-id-keyed MIR lowering second (item 10 — the ctx.mir_fn_by_
# callable index, never a function scan), "" otherwise. Deterministic
# markers ("" for a def with no record at all) stay Ok — they are
# canonical content, never per-compilation ids.
def snapshot_callable_sig_text(ctx: SnapshotBuildCtx, numeric: Int) -> Result[String, SnapshotError]
  let did = snapshot_def_of_numeric(ctx, numeric)
  match snapshot_typed_fn_signature(ctx, &did)
  when Option::Some(sig) then snapshot_fn_sig_text(ctx, sig)
  when Option::None then
    match ctx.mir_fn_by_callable.get(numeric)
    when Option::Some(idx) then
      if idx >= 0 && idx < ctx.mir.functions.len() then
        snapshot_mir_fn_sig_text(ctx, &ctx.mir.functions[idx])
      else
        Result::Ok("")
      end
    when Option::None then Result::Ok("")
    end
  end
end

# The typed declared-type signature text of a static/const def (the typed
# static/const table keyed by the module-qualified key). "" stays a
# deterministic marker for a def with no typed record.
def snapshot_declared_type_sig_text(ctx: SnapshotBuildCtx, key: String) -> Result[String, SnapshotError]
  match ctx.typed.typed_static_types.get(key)
  when Option::Some(ty) then snapshot_type_text(ctx, &ty)
  when Option::None then Result::Ok("")
  end
end

# The signature text of a registered nominal type declaration (the env
# canonical type tables): struct field shapes / enum variant shapes /
# trait method shapes — the declaration's CONTENT, never its TypeId. The
# "type"/"trait" markers for a declaration the env tables do not carry are
# deterministic canonical content (kept Ok); only the field/variant/param
# TYPE renders can fail (item 8).
def snapshot_type_sig_text(ctx: SnapshotBuildCtx, tid: Int) -> Result[String, SnapshotError]
  if tid < 0 then return Result::Ok("type") end
  match ctx.type_list_index.get(tid)
  when Option::Some(idx) then
    if idx >= 0 && idx < ctx.env.type_list.len() then
      let td = ctx.env.type_list[idx]
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        var parts = Vec::new()
        var perr: Option[SnapshotError] = Option::None
        for fl in fields do
          match snapshot_type_text(ctx, &fl.ty)
          when Result::Ok(ft) then parts.push(fl.name.clone() + ":" + ft)
          when Result::Err(fe) then perr = Option::Some(fe)
          end
        end
        match perr
        when Option::Some(fe2) then Result::Err(fe2)
        when Option::None then Result::Ok("struct{" + parts.join(",") + "}")
        end
      when TypeDefKind::Enum(variants) then
        var parts2 = Vec::new()
        var perr2: Option[SnapshotError] = Option::None
        for vr in variants do
          var vparts = Vec::new()
          for vt in vr.fields do
            match snapshot_type_text(ctx, &vt)
            when Result::Ok(vtt) then vparts.push(vtt)
            when Result::Err(vte) then perr2 = Option::Some(vte)
            end
          end
          match perr2
          when Option::Some(_) then ()
          when Option::None then parts2.push(vr.name.clone() + "(" + vparts.join(",") + ")")
          end
        end
        match perr2
        when Option::Some(ve2) then Result::Err(ve2)
        when Option::None then Result::Ok("enum{" + parts2.join(",") + "}")
        end
      when TypeDefKind::Trait(methods) then
        var parts3 = Vec::new()
        var perr3: Option[SnapshotError] = Option::None
        for ms in methods do
          var mparts = Vec::new()
          for p in ms.params do
            match snapshot_type_text(ctx, &p.ty)
            when Result::Ok(pt) then mparts.push(snapshot_conv_text(&p.convention) + ":" + pt)
            when Result::Err(pe3) then perr3 = Option::Some(pe3)
            end
          end
          match perr3
          when Option::Some(_) then ()
          when Option::None then
            match snapshot_type_text(ctx, &ms.ret_type)
            when Result::Err(re3) then perr3 = Option::Some(re3)
            when Result::Ok(rt3) then parts3.push(ms.name.clone() + "(" + mparts.join(",") + ")->" + rt3)
            end
          end
        end
        match perr3
        when Option::Some(me2) then Result::Err(me2)
        when Option::None then Result::Ok("trait{" + parts3.join(",") + "}")
        end
      when TypeDefKind::Alias(inner) then
        match snapshot_type_text(ctx, &inner)
        when Result::Err(ae) then Result::Err(ae)
        when Result::Ok(at) then Result::Ok("alias(" + at + ")")
        end
      when _ then Result::Ok("type")
      end
    else
      Result::Ok("type")
    end
  when Option::None then Result::Ok("type")
  end
end

def snapshot_type_kind_of(ctx: SnapshotBuildCtx, tid: Int) -> Option[SemanticTypeKind]
  if tid < 0 then return Option::None end
  match ctx.type_list_index.get(tid)
  when Option::Some(idx) then
    if idx >= 0 && idx < ctx.env.type_list.len() then
      match ctx.env.type_list[idx].def_kind
      when TypeDefKind::Struct(_) then Option::Some(SemanticTypeKind::Struct)
      when TypeDefKind::Enum(_) then Option::Some(SemanticTypeKind::Enum)
      when TypeDefKind::Trait(_) then Option::Some(SemanticTypeKind::Trait)
      when _ then Option::None
      end
    else
      Option::None
    end
  when Option::None then Option::None
  end
end

def snapshot_type_generic_arity(ctx: SnapshotBuildCtx, tid: Int) -> Int
  if tid < 0 then return 0 end
  match ctx.type_list_index.get(tid)
  when Option::Some(idx) then
    if idx >= 0 && idx < ctx.env.type_list.len() then
      ctx.env.type_list[idx].generic_params.len()
    else
      0
    end
  when Option::None then 0
  end
end

# The signature text of an extern function — resolved through the
# CALLABLE-ID index (item 10): the registration key's numeric looks up the
# typed record first, the lowered bodyless extern MirFunction (joined into
# ctx.mir_fn_by_callable at context construction) second, "" otherwise.
# No bare-name function scan exists here.
def snapshot_extern_fn_sig_text(ctx: SnapshotBuildCtx, key: String) -> Result[String, SnapshotError]
  match ctx.numeric_of_key.get(key.clone())
  when Option::Some(numeric) then snapshot_callable_sig_text(ctx, numeric)
  when Option::None then Result::Ok("")
  end
end

def snapshot_key_name(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(pos, key.len())
    end
    pos = pos - 1
  end
  key.clone()
end

def snapshot_key_module(key: String) -> String
  var pos = key.len()
  while pos >= 2 do
    if key.slice(pos - 2, pos) == "::" then
      return key.slice(0, pos - 2)
    end
    pos = pos - 1
  end
  "".to_string()
end

# ———————————————————————————————————————————————————————————————
# Canonical contract expressions (audit item 11)
# ———————————————————————————————————————————————————————————————
# The canonical clause form lowers the DECLARED ContractClause.expr (the
# parser's AST Expr — the checker's contract-clause AST; the clause
# carries kind/expr/message, spans excluded) to ContractExprIR: op words
# classify operators by KIND, literals render by VALUE (the host value of
# the parsed literal — spelling, radix, separators and suffixes never
# participate), symbols render by their written path text (the checker's
# AST carries no resolved stable key for a bare global reference — the
# name text is the canonical identity), type positions render through the
# canonical type-expression words below. Whitespace, comments, parens and
# spans are NOT part of the AST and never reach the canonical form. Every
# render is infallible and total over the accepted expression grammar.
#
# The canonical row text of one clause is
# semantic_contract_expr_text(snapshot_expr_ir(clause.expr)) — the text
# the StableContractId row key, the expression_fingerprint digest and the
# serialized rows all ride, so message-only edits and re-formatting never
# move a row.
#
# The contract rows of a DEF key by <decl key> — snapshot model keeps the
# clause's ir; messages ride ContractFact.message.

struct SnapshotDeclClause
  kind: AstContractKind
  message: Option[String]
  ir: ContractExprIR
end

def snapshot_contract_kind_word(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

def snapshot_binop_word(op: BinOp) -> String
  match op
  when BinOp::Add then "add"
  when BinOp::Sub then "sub"
  when BinOp::Mul then "mul"
  when BinOp::Div then "div"
  when BinOp::Mod then "mod"
  when BinOp::Pow then "pow"
  when BinOp::Eq then "eq"
  when BinOp::Ne then "ne"
  when BinOp::Lt then "lt"
  when BinOp::Le then "le"
  when BinOp::Gt then "gt"
  when BinOp::Ge then "ge"
  when BinOp::And then "and"
  when BinOp::Or then "or"
  when BinOp::BitAnd then "bitand"
  when BinOp::BitOr then "bitor"
  when BinOp::BitXor then "bitxor"
  when BinOp::Shl then "shl"
  when BinOp::Shr then "shr"
  end
end

def snapshot_unop_word(op: UnOp) -> String
  match op
  when UnOp::Neg then "neg"
  when UnOp::Not then "not"
  when UnOp::BitNot then "bitnot"
  end
end

def snapshot_mut_word(m: Bool) -> String
  if m then "mut" else "let" end
end

# The canonical text of a Pattern (contract-visible patterns: match arms,
# closure parameters, binding patterns).
def snapshot_pattern_text(p: Pattern) -> String
  match p.kind
  when PatternKind::Wildcard then "pwild()"
  when PatternKind::Ident(name, is_mut) then
    "pident(" + name.clone() + "," + snapshot_mut_word(is_mut) + ")"
  when PatternKind::Literal(e) then "plit(" + snapshot_expr_text(&e) + ")"
  when PatternKind::Tuple(ps) then
    var parts = Vec::new()
    for x in ps do
      parts.push(snapshot_pattern_text(&x))
    end
    "ptuple(" + parts.join(",") + ")"
  when PatternKind::Array(ps2) then
    var parts2 = Vec::new()
    for x2 in ps2 do
      parts2.push(snapshot_pattern_text(&x2))
    end
    "parray(" + parts2.join(",") + ")"
  when PatternKind::Struct(path, fields) then
    var parts3 = Vec::new()
    parts3.push(path.segments.join("::"))
    for f in fields do
      parts3.push(f.0.clone() + "=" + snapshot_pattern_text(&f.1))
    end
    "pstruct(" + parts3.join(",") + ")"
  when PatternKind::Variant(path2, args) then
    var parts4 = Vec::new()
    parts4.push(path2.segments.join("::"))
    for a in args do
      parts4.push(snapshot_pattern_text(&a))
    end
    "pvariant(" + parts4.join(",") + ")"
  when PatternKind::Or(ps3) then
    var parts5 = Vec::new()
    for x3 in ps3 do
      parts5.push(snapshot_pattern_text(&x3))
    end
    "por(" + parts5.join(",") + ")"
  when PatternKind::Range(start, end_, inclusive) then
    var parts6 = Vec::new()
    match start
    when Option::Some(se) then parts6.push(snapshot_expr_text(&se))
    when Option::None then parts6.push("-".to_string())
    end
    match end_
    when Option::Some(ee) then parts6.push(snapshot_expr_text(&ee))
    when Option::None then parts6.push("-".to_string())
    end
    parts6.push(snapshot_bool_text(inclusive))
    "prange(" + parts6.join(",") + ")"
  end
end

# The canonical text of a TypeExpr (a written type position inside an
# expression — a cast target): kind words + written names/args. The AST
# type is not resolved here (resolution is a checker artifact; the SAME
# written type text is the canonical surface).
def snapshot_type_expr_text(te: TypeExpr) -> String
  match te.kind
  when TypeExprKind::Named(name, args) then
    var parts = Vec::new()
    parts.push(name.clone())
    for a in args do
      parts.push(snapshot_type_expr_text(&a))
    end
    "tyn(" + parts.join(",") + ")"
  when TypeExprKind::ConstArg(v) then "tyconst(" + v.to_string() + ")"
  when TypeExprKind::ConstExpr(e) then "tyconstexpr(" + snapshot_expr_text(&e) + ")"
  when TypeExprKind::Unit then "tyunit()"
  when TypeExprKind::Never then "tynever()"
  when TypeExprKind::Tuple(fs) then
    var parts2 = Vec::new()
    for f in fs do
      parts2.push(snapshot_type_expr_text(&f))
    end
    "tytuple(" + parts2.join(",") + ")"
  when TypeExprKind::Array(elem, count) then
    match count
    when Option::Some(ce) then "tyarray(" + snapshot_type_expr_text(&elem) + "," + snapshot_expr_text(&ce) + ")"
    when Option::None then "tyarray(" + snapshot_type_expr_text(&elem) + ")"
    end
  when TypeExprKind::Slice(elem2) then "tyslice(" + snapshot_type_expr_text(&elem2) + ")"
  when TypeExprKind::Ptr(inner) then "typtr(" + snapshot_type_expr_text(&inner) + ")"
  when TypeExprKind::PtrMut(inner2) then "typtrmut(" + snapshot_type_expr_text(&inner2) + ")"
  when TypeExprKind::Ref(inner3, mutable) then
    "tyref(" + snapshot_type_expr_text(&inner3) + "," + snapshot_bool_text(mutable) + ")"
  when TypeExprKind::Fn(pparams, ret) then
    var parts3 = Vec::new()
    for pp in pparams do
      parts3.push(snapshot_conv_text(&pp.convention) + ":" + snapshot_type_expr_text(&pp.ty))
    end
    "tyfn(" + parts3.join(",") + ")->" + snapshot_type_expr_text(&ret)
  when TypeExprKind::Async(inner4) then "tyasync(" + snapshot_type_expr_text(&inner4) + ")"
  when TypeExprKind::Effect(name, inner5) then "tyeffect(" + name.clone() + "," + snapshot_type_expr_text(&inner5) + ")"
  when TypeExprKind::Path(p) then "typath(" + p.segments.join("::") + ")"
  when TypeExprKind::Infer then "tyinfer()"
  end
end

def snapshot_block_text(b: Block) -> String
  var parts = Vec::new()
  for st in b.stmts do
    parts.push(snapshot_stmt_text(&st))
  end
  "block(" + parts.join(",") + ")"
end

def snapshot_guard_else_text(g: GuardElse) -> String
  match g
  when GuardElse::Return(e) then
    match e
    when Option::Some(ev) then "guardreturn(" + snapshot_expr_text(&ev) + ")"
    when Option::None then "guardreturn()"
    end
  when GuardElse::Panic(msg) then "guardpanic(" + msg.clone() + ")"
  when GuardElse::Break(e2) then
    match e2
    when Option::Some(ev2) then "guardbreak(" + snapshot_expr_text(&ev2) + ")"
    when Option::None then "guardbreak()"
    end
  when GuardElse::Continue then "guardcontinue()"
  end
end

def snapshot_if_text(i: IfStmt) -> String
  var parts = Vec::new()
  parts.push(snapshot_expr_text(&i.cond))
  parts.push(snapshot_block_text(&i.then_block))
  for eb in i.elsif_branches do
    parts.push(snapshot_expr_text(&eb.0))
    parts.push(snapshot_block_text(&eb.1))
  end
  match i.else_block
  when Option::Some(b) then parts.push(snapshot_block_text(&b))
  when Option::None then parts.push("-".to_string())
  end
  "if(" + parts.join(",") + ")"
end

def snapshot_match_text(m: MatchExpr) -> String
  var parts = Vec::new()
  parts.push(snapshot_expr_text(&m.scrutinee))
  for arm in m.arms do
    var aparts = Vec::new()
    aparts.push(snapshot_pattern_text(&arm.pattern))
    match arm.guard_expr
    when Option::Some(ge) then aparts.push(snapshot_expr_text(&ge))
    when Option::None then aparts.push("-".to_string())
    end
    aparts.push(snapshot_block_text(&arm.body))
    parts.push("arm(" + aparts.join(",") + ")")
  end
  "match(" + parts.join(",") + ")"
end

# The canonical text of ONE statement (statements only appear inside the
# blocks of the expression-level if/match/block/closure forms a contract
# clause may carry).
def snapshot_stmt_text(st: Stmt) -> String
  match st.kind
  when StmtKind::StmtLet(pat, ty, value, is_mut) then
    var parts = Vec::new()
    parts.push(snapshot_pattern_text(&pat))
    match ty
    when Option::Some(t) then parts.push(snapshot_type_expr_text(&t))
    when Option::None then parts.push("-".to_string())
    end
    parts.push(snapshot_expr_text(&value))
    parts.push(snapshot_bool_text(is_mut))
    "slet(" + parts.join(",") + ")"
  when StmtKind::StmtAssign(target, value2) then
    "sassign(" + snapshot_expr_text(&target) + "," + snapshot_expr_text(&value2) + ")"
  when StmtKind::StmtCompoundAssign(op, target2, value3) then
    "scompound(" + snapshot_binop_word(op) + "," + snapshot_expr_text(&target2) + "," + snapshot_expr_text(&value3) + ")"
  when StmtKind::StmtIf(i) then "s" + snapshot_if_text(&i)
  when StmtKind::StmtMatch(m2) then "s" + snapshot_match_text(&m2)
  when StmtKind::StmtWhile(cond, body) then
    "swhile(" + snapshot_expr_text(&cond) + "," + snapshot_block_text(&body) + ")"
  when StmtKind::StmtFor(fs) then
    "sfor(" + snapshot_pattern_text(&fs.pattern) + "," + snapshot_expr_text(&fs.iter) + "," +
      snapshot_block_text(&fs.body) + ")"
  when StmtKind::StmtLoop(b2) then "sloop(" + snapshot_block_text(&b2) + ")"
  when StmtKind::StmtReturn(e) then
    match e
    when Option::Some(ev) then "sreturn(" + snapshot_expr_text(&ev) + ")"
    when Option::None then "sreturn()"
    end
  when StmtKind::StmtBreak(e2) then
    match e2
    when Option::Some(ev2) then "sbreak(" + snapshot_expr_text(&ev2) + ")"
    when Option::None then "sbreak()"
    end
  when StmtKind::StmtContinue then "scontinue()"
  when StmtKind::StmtExpr(e3) then "sexpr(" + snapshot_expr_text(&e3) + ")"
  when StmtKind::StmtUnsafe(reason, b3) then
    match reason
    when Option::Some(r) then "sunsafe(" + r.clone() + "," + snapshot_block_text(&b3) + ")"
    when Option::None then "sunsafe(-," + snapshot_block_text(&b3) + ")"
    end
  when StmtKind::StmtDefer(b4) then "sdefer(" + snapshot_block_text(&b4) + ")"
  when StmtKind::StmtGuard(cond2, else_) then
    "sguard(" + snapshot_expr_text(&cond2) + "," + snapshot_guard_else_text(&else_) + ")"
  when StmtKind::StmtTry(b5, catches, fin) then
    var parts2 = Vec::new()
    parts2.push(snapshot_block_text(&b5))
    for ca in catches do
      parts2.push("catch(" + snapshot_pattern_text(&ca.pattern) + "," + snapshot_block_text(&ca.body) + ")")
    end
    match fin
    when Option::Some(fb) then parts2.push(snapshot_block_text(&fb))
    when Option::None then parts2.push("-".to_string())
    end
    "stry(" + parts2.join(",") + ")"
  when StmtKind::StmtWith(expr, pat2, body2) then
    "swith(" + snapshot_expr_text(&expr) + "," + snapshot_pattern_text(&pat2) + "," +
      snapshot_block_text(&body2) + ")"
  when StmtKind::StmtHandleWith(expr2, handlers) then
    var parts3 = Vec::new()
    parts3.push(snapshot_expr_text(&expr2))
    for h in handlers do
      var hparts = Vec::new()
      hparts.push(h.effect_name.clone())
      for ha in h.arms do
        var aparts2 = Vec::new()
        aparts2.push(ha.operation.clone())
        for hp in ha.params do
          aparts2.push(snapshot_pattern_text(&hp))
        end
        aparts2.push(snapshot_block_text(&ha.body))
        hparts.push("hnd(" + aparts2.join(",") + ")")
      end
      parts3.push("hnds(" + hparts.join(",") + ")")
    end
    "shandle(" + parts3.join(",") + ")"
  end
end

# The canonical ContractExprIR of one AST expression: op = the kind word
# below; args = the payload/canonical child texts in fixed order.
def snapshot_expr_ir(e: Expr) -> ContractExprIR
  match e.kind
  when ExprKind::ExprIntLit(n) then
    ContractExprIR { op: "int", args: Vec::from([parsed_int_to_host(&n).to_string()]) }
  when ExprKind::ExprFloatLit(n2) then
    match n2.value
    when Option::Some(v) then ContractExprIR { op: "float", args: Vec::from([v.to_string()]) }
    when Option::None then
      ContractExprIR { op: "float", args: Vec::from([n2.significand.clone()]) }
    end
  when ExprKind::ExprStringLit(s) then
    ContractExprIR { op: "str", args: Vec::from([s.clone()]) }
  when ExprKind::ExprCharLit(c) then
    ContractExprIR { op: "char", args: Vec::from([(c as Int).to_string()]) }
  when ExprKind::ExprBoolLit(b) then
    ContractExprIR { op: "bool", args: Vec::from([snapshot_bool_text(b)]) }
  when ExprKind::ExprNilLit then
    ContractExprIR { op: "nil", args: Vec::new() }
  when ExprKind::ExprIdent(name) then
    ContractExprIR { op: "ident", args: Vec::from([name.clone()]) }
  when ExprKind::ExprPath(p) then
    ContractExprIR { op: "path", args: Vec::from([p.segments.join("::")]) }
  when ExprKind::ExprSelfRef then
    ContractExprIR { op: "self", args: Vec::new() }
  when ExprKind::ExprBinaryOp(op, left, right) then
    ContractExprIR { op: "bin" + snapshot_binop_word(op), args: Vec::from([
      snapshot_expr_text(&left), snapshot_expr_text(&right)
    ]) }
  when ExprKind::ExprUnaryOp(op2, inner) then
    ContractExprIR { op: "un" + snapshot_unop_word(op2), args: Vec::from([snapshot_expr_text(&inner)]) }
  when ExprKind::ExprFieldAccess(base, field) then
    ContractExprIR { op: "field", args: Vec::from([snapshot_expr_text(&base), field.clone()]) }
  when ExprKind::ExprMethodCall(base2, mname, targs, margs) then
    var parts = Vec::new()
    parts.push(snapshot_expr_text(&base2))
    parts.push(mname.clone())
    for ta in targs do
      parts.push(snapshot_type_expr_text(&ta))
    end
    for ma in margs do
      parts.push(snapshot_expr_text(&ma))
    end
    ContractExprIR { op: "method", args: parts }
  when ExprKind::ExprIndex(b3, idx) then
    ContractExprIR { op: "index", args: Vec::from([snapshot_expr_text(&b3), snapshot_expr_text(&idx)]) }
  when ExprKind::ExprCall(callee, cargs) then
    var parts2 = Vec::new()
    parts2.push(snapshot_expr_text(&callee))
    for ca in cargs do
      parts2.push(snapshot_expr_text(&ca))
    end
    ContractExprIR { op: "call", args: parts2 }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    var parts3 = Vec::new()
    for cp in params do
      var cparts = Vec::new()
      cparts.push(snapshot_pattern_text(&cp.pat))
      match cp.ty
      when Option::Some(ct) then cparts.push(snapshot_type_expr_text(&ct))
      when Option::None then cparts.push("-".to_string())
      end
      parts3.push("cparam(" + cparts.join(",") + ")")
    end
    match ret_ty
    when Option::Some(rt) then parts3.push(snapshot_type_expr_text(&rt))
    when Option::None then parts3.push("-".to_string())
    end
    parts3.push(snapshot_expr_text(&body))
    ContractExprIR { op: "closure", args: parts3 }
  when ExprKind::ExprAccess(inner2) then
    ContractExprIR { op: "access", args: Vec::from([snapshot_expr_text(&inner2)]) }
  when ExprKind::ExprRawDeref(inner3) then
    ContractExprIR { op: "deref", args: Vec::from([snapshot_expr_text(&inner3)]) }
  when ExprKind::ExprIf(i2) then
    ContractExprIR { op: "if", args: Vec::from([snapshot_if_text(&i2)]) }
  when ExprKind::ExprMatch(m3) then
    ContractExprIR { op: "match", args: Vec::from([snapshot_match_text(&m3)]) }
  when ExprKind::ExprBlock(b6) then
    ContractExprIR { op: "exprblock", args: Vec::from([snapshot_block_text(&b6)]) }
  when ExprKind::ExprUnsafe(reason2, b7) then
    match reason2
    when Option::Some(r2) then
      ContractExprIR { op: "unsafe", args: Vec::from([r2.clone(), snapshot_block_text(&b7)]) }
    when Option::None then
      ContractExprIR { op: "unsafe", args: Vec::from(["-".to_string(), snapshot_block_text(&b7)]) }
    end
  when ExprKind::ExprAsync(b8) then
    ContractExprIR { op: "async", args: Vec::from([snapshot_block_text(&b8)]) }
  when ExprKind::ExprAwait(inner4) then
    ContractExprIR { op: "await", args: Vec::from([snapshot_expr_text(&inner4)]) }
  when ExprKind::ExprTry(inner5) then
    ContractExprIR { op: "try", args: Vec::from([snapshot_expr_text(&inner5)]) }
  when ExprKind::ExprRange(start, end_, inclusive) then
    var parts4 = Vec::new()
    match start
    when Option::Some(se) then parts4.push(snapshot_expr_text(&se))
    when Option::None then parts4.push("-".to_string())
    end
    match end_
    when Option::Some(ee) then parts4.push(snapshot_expr_text(&ee))
    when Option::None then parts4.push("-".to_string())
    end
    parts4.push(snapshot_bool_text(inclusive))
    ContractExprIR { op: "range", args: parts4 }
  when ExprKind::ExprCast(inner6, te) then
    ContractExprIR { op: "cast", args: Vec::from([snapshot_expr_text(&inner6), snapshot_type_expr_text(&te)]) }
  when ExprKind::ExprTypeCheck(inner7, te2) then
    ContractExprIR { op: "typecheck", args: Vec::from([snapshot_expr_text(&inner7), snapshot_type_expr_text(&te2)]) }
  when ExprKind::ExprComptime(b9) then
    ContractExprIR { op: "comptime", args: Vec::from([snapshot_block_text(&b9)]) }
  when ExprKind::ExprEnumVariant(path3, targs2, vargs) then
    var parts5 = Vec::new()
    parts5.push(path3.segments.join("::"))
    for ta2 in targs2 do
      parts5.push(snapshot_type_expr_text(&ta2))
    end
    for va in vargs do
      parts5.push(snapshot_expr_text(&va))
    end
    ContractExprIR { op: "variant", args: parts5 }
  when ExprKind::ExprAssign(target3, value4) then
    ContractExprIR { op: "assign", args: Vec::from([snapshot_expr_text(&target3), snapshot_expr_text(&value4)]) }
  when ExprKind::ExprPipe(lhs, rhs) then
    ContractExprIR { op: "pipe", args: Vec::from([snapshot_expr_text(&lhs), snapshot_expr_text(&rhs)]) }
  when ExprKind::ExprMacroCall(mname, margs2) then
    var parts6 = Vec::new()
    parts6.push(mname.clone())
    for ma2 in margs2 do
      parts6.push(snapshot_expr_text(&ma2))
    end
    ContractExprIR { op: "macro", args: parts6 }
  when ExprKind::ExprArrayLit(elems) then
    var parts7 = Vec::new()
    for el in elems do
      parts7.push(snapshot_expr_text(&el))
    end
    ContractExprIR { op: "array", args: parts7 }
  when ExprKind::ExprArrayRepeat(el2, count2) then
    ContractExprIR { op: "arrayrepeat", args: Vec::from([snapshot_expr_text(&el2), snapshot_expr_text(&count2)]) }
  when ExprKind::ExprTupleLit(elems2) then
    var parts8 = Vec::new()
    for el2 in elems2 do
      parts8.push(snapshot_expr_text(&el2))
    end
    ContractExprIR { op: "tuple", args: parts8 }
  when ExprKind::ExprStructLit(path4, fields2) then
    var parts9 = Vec::new()
    parts9.push(path4.segments.join("::"))
    for f2 in fields2 do
      parts9.push(f2.0.clone() + "=" + snapshot_expr_text(&f2.1))
    end
    ContractExprIR { op: "struct", args: parts9 }
  when ExprKind::ExprMapLit(pairs) then
    var parts10 = Vec::new()
    for pr in pairs do
      parts10.push(snapshot_expr_text(&pr.0) + "=" + snapshot_expr_text(&pr.1))
    end
    ContractExprIR { op: "map", args: parts10 }
  when ExprKind::ExprHole then
    # (audit item 54) a source `???` hole in a contract clause renders its
    # own canonical op word. Compilation rejects a hole before the snapshot
    # is built (non-hole mode); the row is the honest render for a hole-mode
    # artifact.
    ContractExprIR { op: "hole", args: Vec::new() }
  when ExprKind::ExprError(msg) then
    ContractExprIR { op: "err", args: Vec::from([msg.clone()]) }
  end
end

# The canonical flat text of an expression (semantic_contract_expr_text of
# its one-level IR — nested children ride as texts inside the args).
def snapshot_expr_text(e: Expr) -> String
  semantic_contract_expr_text(&snapshot_expr_ir(&e))
end

# ———————————————————————————————————————————————————————————————
# The contract clause resolved-reference collector (third-audit item 18)
# ———————————————————————————————————————————————————————————————
# The canonical clause IR carries the expression's canonical TEXT (args);
# the ContractReferences edge class must NOT re-parse that text. This
# structural walk collects the resolved path references of the clause
# expression: every ExprPath node's module-qualified spelling (the
# checker's own resolved-path form — the same spelling the canonical
# "path(...)" op renders, but read as a field, never token-scanned).
# The builder then resolves each spelling against the def universe and
# stores the stable keys in ContractExprIR.resolved_refs.
#
# SCOPE (documented): only ExprPath references are collected — the form a
# resolved module-qualified def reference takes. Bare idents, enum-variant
# constructors and type-expression references stay outside the set, exactly
# like the canonical-op token scan this replaces (which matched only the
# "path(" op). Duplicates are elided; source-walk order is irrelevant (the
# builder sorts the resolved key set before storing).

def snapshot_path_ref_push(inout out: Vec[String], ref_text: String) -> Unit
  if ref_text.len() > 0 && !out.contains(&ref_text) then
    out.push(ref_text)
  end
  ()
end

def snapshot_option_expr_path_refs(e: Option[Expr], inout out: Vec[String]) -> Unit
  match e
  when Option::Some(ev) then snapshot_expr_path_refs(&ev, &mut out)
  when Option::None then ()
  end
  ()
end

def snapshot_pattern_path_refs(p: Pattern, inout out: Vec[String]) -> Unit
  match p.kind
  when PatternKind::Literal(e) then snapshot_expr_path_refs(&e, &mut out)
  when PatternKind::Tuple(parts) then
    for part in parts do snapshot_pattern_path_refs(&part, &mut out) end
  when PatternKind::Array(parts2) then
    for part2 in parts2 do snapshot_pattern_path_refs(&part2, &mut out) end
  when PatternKind::Struct(_, fields) then
    for f in fields do snapshot_pattern_path_refs(&f.1, &mut out) end
  when PatternKind::Variant(_, parts3) then
    for part3 in parts3 do snapshot_pattern_path_refs(&part3, &mut out) end
  when PatternKind::Or(parts4) then
    for part4 in parts4 do snapshot_pattern_path_refs(&part4, &mut out) end
  when PatternKind::Range(start, end_, _) then
    snapshot_option_expr_path_refs(start, &mut out)
    snapshot_option_expr_path_refs(end_, &mut out)
  when _ then ()
  end
  ()
end

def snapshot_block_path_refs(b: Block, inout out: Vec[String]) -> Unit
  for st in b.stmts do
    snapshot_stmt_path_refs(&st, &mut out)
  end
  ()
end

def snapshot_if_path_refs(i: IfStmt, inout out: Vec[String]) -> Unit
  snapshot_expr_path_refs(&i.cond, &mut out)
  snapshot_block_path_refs(i.then_block, &mut out)
  for branch in i.elsif_branches do
    snapshot_expr_path_refs(&branch.0, &mut out)
    snapshot_block_path_refs(branch.1, &mut out)
  end
  match i.else_block
  when Option::Some(eb) then snapshot_block_path_refs(eb, &mut out)
  when Option::None then ()
  end
  ()
end

def snapshot_match_path_refs(m: MatchExpr, inout out: Vec[String]) -> Unit
  snapshot_expr_path_refs(&m.scrutinee, &mut out)
  for arm in m.arms do
    snapshot_pattern_path_refs(&arm.pattern, &mut out)
    snapshot_option_expr_path_refs(arm.guard_expr, &mut out)
    snapshot_block_path_refs(arm.body, &mut out)
  end
  ()
end

def snapshot_guard_else_path_refs(g: GuardElse, inout out: Vec[String]) -> Unit
  match g
  when GuardElse::Return(e) then snapshot_option_expr_path_refs(e, &mut out)
  when GuardElse::Break(e2) then snapshot_option_expr_path_refs(e2, &mut out)
  when GuardElse::Panic(_) then ()
  when GuardElse::Continue then ()
  end
  ()
end

def snapshot_stmt_path_refs(st: Stmt, inout out: Vec[String]) -> Unit
  match st.kind
  when StmtKind::StmtLet(pat, _, value, _) then
    snapshot_pattern_path_refs(&pat, &mut out)
    snapshot_expr_path_refs(&value, &mut out)
  when StmtKind::StmtAssign(target, value2) then
    snapshot_expr_path_refs(&target, &mut out)
    snapshot_expr_path_refs(&value2, &mut out)
  when StmtKind::StmtCompoundAssign(_, target2, value3) then
    snapshot_expr_path_refs(&target2, &mut out)
    snapshot_expr_path_refs(&value3, &mut out)
  when StmtKind::StmtIf(i) then snapshot_if_path_refs(i, &mut out)
  when StmtKind::StmtMatch(m) then snapshot_match_path_refs(m, &mut out)
  when StmtKind::StmtWhile(cond, body) then
    snapshot_expr_path_refs(&cond, &mut out)
    snapshot_block_path_refs(body, &mut out)
  when StmtKind::StmtFor(fs) then
    snapshot_pattern_path_refs(&fs.pattern, &mut out)
    snapshot_expr_path_refs(&fs.iter, &mut out)
    snapshot_block_path_refs(fs.body, &mut out)
  when StmtKind::StmtLoop(b) then snapshot_block_path_refs(b, &mut out)
  when StmtKind::StmtReturn(e) then snapshot_option_expr_path_refs(e, &mut out)
  when StmtKind::StmtBreak(e2) then snapshot_option_expr_path_refs(e2, &mut out)
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtExpr(e3) then snapshot_expr_path_refs(&e3, &mut out)
  when StmtKind::StmtUnsafe(_, b2) then snapshot_block_path_refs(b2, &mut out)
  when StmtKind::StmtDefer(b3) then snapshot_block_path_refs(b3, &mut out)
  when StmtKind::StmtGuard(cond2, else_) then
    snapshot_expr_path_refs(&cond2, &mut out)
    snapshot_guard_else_path_refs(else_, &mut out)
  when StmtKind::StmtTry(b4, catches, fin) then
    snapshot_block_path_refs(b4, &mut out)
    for ca in catches do
      snapshot_pattern_path_refs(&ca.pattern, &mut out)
      snapshot_block_path_refs(ca.body, &mut out)
    end
    match fin
    when Option::Some(fb) then snapshot_block_path_refs(fb, &mut out)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat2, body2) then
    snapshot_expr_path_refs(&expr, &mut out)
    snapshot_pattern_path_refs(&pat2, &mut out)
    snapshot_block_path_refs(body2, &mut out)
  when StmtKind::StmtHandleWith(expr2, handlers) then
    snapshot_expr_path_refs(&expr2, &mut out)
    for h in handlers do
      for ha in h.arms do
        for hp in ha.params do
          snapshot_pattern_path_refs(&hp, &mut out)
        end
        snapshot_block_path_refs(ha.body, &mut out)
      end
    end
  end
  ()
end

def snapshot_expr_path_refs(e: Expr, inout out: Vec[String]) -> Unit
  match e.kind
  when ExprKind::ExprPath(p) then
    snapshot_path_ref_push(&mut out, p.segments.join("::"))
  when ExprKind::ExprArrayLit(elems) then
    for el in elems do snapshot_expr_path_refs(&el, &mut out) end
  when ExprKind::ExprArrayRepeat(el2, count2) then
    snapshot_expr_path_refs(&el2, &mut out)
    snapshot_expr_path_refs(&count2, &mut out)
  when ExprKind::ExprTupleLit(elems2) then
    for el3 in elems2 do snapshot_expr_path_refs(&el3, &mut out) end
  when ExprKind::ExprStructLit(_, fields) then
    for f in fields do snapshot_expr_path_refs(&f.1, &mut out) end
  when ExprKind::ExprMapLit(pairs) then
    for pr in pairs do
      snapshot_expr_path_refs(&pr.0, &mut out)
      snapshot_expr_path_refs(&pr.1, &mut out)
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    snapshot_expr_path_refs(&left, &mut out)
    snapshot_expr_path_refs(&right, &mut out)
  when ExprKind::ExprUnaryOp(_, inner) then
    snapshot_expr_path_refs(&inner, &mut out)
  when ExprKind::ExprFieldAccess(base, _) then
    snapshot_expr_path_refs(&base, &mut out)
  when ExprKind::ExprMethodCall(base2, _, _, margs) then
    snapshot_expr_path_refs(&base2, &mut out)
    for ma in margs do snapshot_expr_path_refs(&ma, &mut out) end
  when ExprKind::ExprIndex(b3, idx) then
    snapshot_expr_path_refs(&b3, &mut out)
    snapshot_expr_path_refs(&idx, &mut out)
  when ExprKind::ExprCall(callee, cargs) then
    snapshot_expr_path_refs(&callee, &mut out)
    for ca in cargs do snapshot_expr_path_refs(&ca, &mut out) end
  when ExprKind::ExprClosure(cparams, _, body) then
    for cp in cparams do snapshot_pattern_path_refs(&cp.pat, &mut out) end
    snapshot_expr_path_refs(&body, &mut out)
  when ExprKind::ExprAccess(inner2) then snapshot_expr_path_refs(&inner2, &mut out)
  when ExprKind::ExprRawDeref(inner3) then snapshot_expr_path_refs(&inner3, &mut out)
  when ExprKind::ExprIf(i) then snapshot_if_path_refs(i, &mut out)
  when ExprKind::ExprMatch(m) then snapshot_match_path_refs(m, &mut out)
  when ExprKind::ExprBlock(b4) then snapshot_block_path_refs(b4, &mut out)
  when ExprKind::ExprUnsafe(_, b5) then snapshot_block_path_refs(b5, &mut out)
  when ExprKind::ExprAsync(b6) then snapshot_block_path_refs(b6, &mut out)
  when ExprKind::ExprAwait(inner4) then snapshot_expr_path_refs(&inner4, &mut out)
  when ExprKind::ExprTry(inner5) then snapshot_expr_path_refs(&inner5, &mut out)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(se) then snapshot_expr_path_refs(&se, &mut out)
    when Option::None then ()
    end
    match end_
    when Option::Some(ee) then snapshot_expr_path_refs(&ee, &mut out)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner6, _) then snapshot_expr_path_refs(&inner6, &mut out)
  when ExprKind::ExprTypeCheck(inner7, _) then snapshot_expr_path_refs(&inner7, &mut out)
  when ExprKind::ExprComptime(b7) then snapshot_block_path_refs(b7, &mut out)
  when ExprKind::ExprEnumVariant(_, _, vargs) then
    for va in vargs do snapshot_expr_path_refs(&va, &mut out) end
  when ExprKind::ExprAssign(target3, value4) then
    snapshot_expr_path_refs(&target3, &mut out)
    snapshot_expr_path_refs(&value4, &mut out)
  when ExprKind::ExprPipe(lhs, rhs) then
    snapshot_expr_path_refs(&lhs, &mut out)
    snapshot_expr_path_refs(&rhs, &mut out)
  when ExprKind::ExprMacroCall(_, margs2) then
    for ma2 in margs2 do snapshot_expr_path_refs(&ma2, &mut out) end
  when _ then ()
  end
  ()
end

# The declared clauses of a fn/method declaration in canonical form: the
# canonical IR plus the clause's resolved-reference set (third-audit item
# 18 — read as a field by the ContractReferenceEdge producer, never
# re-parsed from the canonical text).
def snapshot_decl_contracts(clauses: Vec[ContractClause]) -> Vec[SnapshotDeclClause]
  var out: Vec[SnapshotDeclClause] = Vec::new()
  for c in clauses do
    var ir = snapshot_expr_ir(&c.expr)
    var refs: Vec[String] = Vec::new()
    snapshot_expr_path_refs(&c.expr, &mut refs)
    ir.resolved_refs = refs
    out.push(SnapshotDeclClause {
      kind: c.kind,
      message: c.message.clone(),
      ir: ir
    })
  end
  out
end

# ———————————————————————————————————————————————————————————————
# The deterministic item walk — the def metadata (pub / generic / clauses)
# ———————————————————————————————————————————————————————————————
# Mirrors the resolver's registration walk shape (top-level items in
# Program.items order, inline-module recursion appending the module
# segment); FIRST-WINS like the resolver. Only keys that actually
# registered in module_symbols are recorded, so the metadata always lands
# on the registered identity.

struct SnapshotItemMeta
  is_pub: Bool
  is_generic: Bool
  # Whether the registered def's ITEM carries the test attribute
  # (@test — the driver's test marker; audit item 19 discovery). Functions
  # only, and only through the item's own attribute list: the parser's
  # `test "name" do` sugar attaches no attribute, so a sugar-parsed def
  # never records is_test here (mirrors the driver's discovery exactly).
  is_test: Bool
end

# The @test test-attribute test — attr.name == "test" on the item's
# attribute list, the SAME marker driver.tg's run_test_files discovery
# reads (and the file-level select_test_sources source scan recognizes).
def snapshot_item_has_test_attr(item: Item) -> Bool
  for attr in item.attrs do
    if attr.name == "test" then
      return true
    end
  end
  false
end

# Record the item-derived metadata of one registration attempt.
def snapshot_record_meta(
  inout metas: Map[String, SnapshotItemMeta],
  inout clauses: Map[String, Vec[SnapshotDeclClause]],
  ctx: SnapshotBuildCtx,
  key: String,
  is_pub: Bool,
  is_generic: Bool,
  is_test: Bool,
  decl_contracts: Vec[SnapshotDeclClause]
) -> Unit
  if metas.contains_key(&key) then return end
  if ctx.numeric_of_key.contains_key(&key) then
    metas.insert(key.clone(), SnapshotItemMeta { is_pub: is_pub, is_generic: is_generic, is_test: is_test })
    if decl_contracts.len() > 0 then
      clauses.insert(key.clone(), decl_contracts)
    end
  end
end

def snapshot_qualified_key(path: Vec[String], name: String) -> String
  let joined = path.join("::")
  if joined.is_empty() then name.clone() else joined + "::" + name.clone() end
end

def snapshot_item_owner_path(ctx: SnapshotBuildCtx, item_idx: Int) -> Vec[String]
  var owner = ctx.typed.ast.items[item_idx].owner_module
  var segs: Vec[String] = Vec::new()
  match ctx.typed.ast.crate.modules.get(owner)
  when Option::Some(info) then
    for s in info.path do
      segs.push(s.clone())
    end
  when Option::None then ()
  end
  segs
end

def snapshot_walk_metas(ctx: SnapshotBuildCtx) -> (Map[String, SnapshotItemMeta], Map[String, Vec[SnapshotDeclClause]])
  var metas: Map[String, SnapshotItemMeta] = Map::new()
  var clauses: Map[String, Vec[SnapshotDeclClause]] = Map::new()
  var item_idx = 0
  while item_idx < ctx.typed.ast.items.len() do
    let path = snapshot_item_owner_path(ctx, item_idx)
    snapshot_walk_decl_meta(ctx, &mut metas, &mut clauses, &ctx.typed.ast.items[item_idx], &path)
    match ctx.typed.ast.items[item_idx].kind
    when ItemKind::ItemModule(m) then
      snapshot_walk_module_tree_meta(ctx, &mut metas, &mut clauses, m, &path)
    when _ then ()
    end
    item_idx = item_idx + 1
  end
  (metas, clauses)
end

def snapshot_walk_module_tree_meta(
  ctx: SnapshotBuildCtx,
  inout metas: Map[String, SnapshotItemMeta],
  inout clauses: Map[String, Vec[SnapshotDeclClause]],
  m: ModuleDecl,
  path: Vec[String]
) -> Unit
  var nested: Vec[String] = Vec::new()
  for p in path do
    nested.push(p.clone())
  end
  nested.push(m.name.clone())
  for item in m.items do
    snapshot_walk_decl_meta(ctx, &mut metas, &mut clauses, &item, &nested)
    match item.kind
    when ItemKind::ItemModule(m2) then
      snapshot_walk_module_tree_meta(ctx, &mut metas, &mut clauses, m2, &nested)
    when _ then ()
    end
  end
end

def snapshot_walk_decl_meta(
  ctx: SnapshotBuildCtx,
  inout metas: Map[String, SnapshotItemMeta],
  inout clauses: Map[String, Vec[SnapshotDeclClause]],
  item: Item,
  path: Vec[String]
) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    let key = snapshot_qualified_key(&path, f.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, key, item.is_pub,
      f.generic_params.len() > 0, snapshot_item_has_test_attr(item),
      snapshot_decl_contracts(&f.contracts))
  when ItemKind::ItemStruct(s) then
    let skey = snapshot_qualified_key(&path, s.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, skey, item.is_pub,
      s.generic_params.len() > 0, false, Vec::new())
    for m in s.methods do
      let mkey = snapshot_qualified_key(&path, s.name.clone() + "::" + m.name.clone())
      snapshot_record_meta(&mut metas, &mut clauses, ctx, mkey, m.vis == Visibility::Public,
        m.generic_params.len() > 0, false, snapshot_decl_contracts(&m.contracts))
    end
  when ItemKind::ItemEnum(e) then
    let ekey = snapshot_qualified_key(&path, e.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, ekey, item.is_pub,
      e.generic_params.len() > 0, false, Vec::new())
    for v in e.variants do
      let vkey = snapshot_qualified_key(&path, v.name.clone())
      snapshot_record_meta(&mut metas, &mut clauses, ctx, vkey, item.is_pub, false, false, Vec::new())
    end
  when ItemKind::ItemTrait(t) then
    let tkey = snapshot_qualified_key(&path, t.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, tkey, item.is_pub,
      t.generic_params.len() > 0, false, Vec::new())
  when ItemKind::ItemImpl(_) then
    # Impl-method metadata is recovered by DefId identity (the item_defs
    # pairing) in the second pass below — the registration key of an impl
    # method is the type-EXPRESSION text of the impl, which this module
    # never re-renders.
    ()
  when ItemKind::ItemConst(c) then
    let ckey = snapshot_qualified_key(&path, c.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, ckey, item.is_pub, false, false, Vec::new())
  when ItemKind::ItemStatic(s2) then
    let stkey = snapshot_qualified_key(&path, s2.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, stkey, item.is_pub, false, false, Vec::new())
  when ItemKind::ItemTypeAlias(a) then
    let akey = snapshot_qualified_key(&path, a.name.clone())
    snapshot_record_meta(&mut metas, &mut clauses, ctx, akey, item.is_pub,
      a.generic_params.len() > 0, false, Vec::new())
  when ItemKind::ItemExternBlock(ext) then
    for ext_item in ext.items do
      match ext_item
      when ExternItem::Function(ef) then
        let efkey = snapshot_qualified_key(&path, ef.name.clone())
        snapshot_record_meta(&mut metas, &mut clauses, ctx, efkey, true, false, false, Vec::new())
      when ExternItem::Static(es) then
        let eskey = snapshot_qualified_key(&path, es.name.clone())
        snapshot_record_meta(&mut metas, &mut clauses, ctx, eskey, true, false, false, Vec::new())
      end
    end
  when _ then ()
  end
end

# The second metadata pass: impl methods pair with the item_defs Vec[DefId]
# (the resolver records impl-method DefIds in declaration order); their
# registration keys are recovered from the DefId -> key table. Struct
# methods are already covered textually (first pass). Only TOP-LEVEL impls
# have item_defs entries (the resolver's loop is over Program.items).
def snapshot_resolve_impl_metas(ctx: SnapshotBuildCtx, inout metas: Map[String, SnapshotItemMeta], inout clauses: Map[String, Vec[SnapshotDeclClause]]) -> Unit
  var item_idx = 0
  while item_idx < ctx.typed.ast.items.len() do
    match ctx.typed.ast.items[item_idx].kind
    when ItemKind::ItemImpl(imp) then
      match ctx.typed.resolutions.item_defs.get(item_idx)
      when Option::Some(dids) then
        var mi = 0
        while mi < dids.len() && mi < imp.methods.len() do
          let numeric = def_id_numeric(&dids[mi])
          match ctx.key_of_def.get(numeric)
          when Option::Some(key) then
            snapshot_record_meta(&mut metas, &mut clauses, ctx, key.clone(),
              imp.methods[mi].vis == Visibility::Public,
              imp.generic_params.len() > 0 || imp.methods[mi].generic_params.len() > 0,
              false, snapshot_decl_contracts(&imp.methods[mi].contracts))
          when Option::None then ()
          end
          mi = mi + 1
        end
      when Option::None then ()
      end
    when _ then ()
    end
    item_idx = item_idx + 1
  end
end

# ———————————————————————————————————————————————————————————————
# The def universe — the module_symbols registry rows
# ———————————————————————————————————————————————————————————————

struct SnapshotDef
  sid: StableDefId
  # The PERSISTENT declaration identity the def walk stamped (third-audit
  # item 11): the store-assigned lineage record. `sid`'s digest words are
  # this declaration's words (stable_def_id_of_decl); the record itself
  # rides along as the typed declaration cargo (package / module / lineage /
  # kind — diagnostics and the future digest-word consumers).
  decl: StableDeclId
  kind: DefKind
  key: String              # the registration key "path::name"
  name: String
  module_path: String
  is_pub: Bool
  is_generic: Bool
  # The @test marker of the def's item (the driver's test-attribute
  # discovery — audit item 19): true only for defs whose first-wins item
  # carries the test attribute. Only meaningful for Function defs.
  is_test: Bool
  # The declared contracts of the def (fn/method declarations only), in
  # their canonical clause form (kind/message/ir — item 11).
  contracts: Vec[SnapshotDeclClause]
end

# The canonical signature text of a def (the "#" component of its stable
# key) by DefKind:
#   Function/Method — typed FnSignature render / callable-id MIR render / ""
#   Static/Constant — typed declared-type render / ""
#   TypeName/Trait  — env canonical type-table shape render
#   EnumVariant     — "variant"
# Deterministic markers ("", "type", "trait", "variant", "decl") stay Ok —
# they are canonical content; the Result threads the typed/MIR/type-table
# render failures (item 8).
def snapshot_def_sig_text(ctx: SnapshotBuildCtx, key: String, kind: DefKind) -> Result[String, SnapshotError]
  match kind
  when DefKind::Function then
    match ctx.numeric_of_key.get(key.clone())
    when Option::Some(numeric) then snapshot_callable_sig_text(ctx, numeric)
    when Option::None then Result::Ok("")
    end
  when DefKind::Method then
    match ctx.numeric_of_key.get(key.clone())
    when Option::Some(numeric) then snapshot_callable_sig_text(ctx, numeric)
    when Option::None then Result::Ok("")
    end
  when DefKind::Static then snapshot_declared_type_sig_text(ctx, &key)
  when DefKind::Constant then snapshot_declared_type_sig_text(ctx, &key)
  when DefKind::TypeName then
    match ctx.type_id_of_key.get(key.clone())
    when Option::Some(tid) then snapshot_type_sig_text(ctx, tid)
    when Option::None then Result::Ok("type")
    end
  when DefKind::Trait then
    match ctx.type_id_of_key.get(key.clone())
    when Option::Some(tid) then snapshot_type_sig_text(ctx, tid)
    when Option::None then Result::Ok("trait")
    end
  when DefKind::EnumVariant then Result::Ok("variant")
  when _ then Result::Ok("decl")
  end
end

# ONE declaration seed of a build's def walk (third-audit item 11;
# fourth-audit P0-2): the structural key pieces the DeclLineageStore
# matches on, plus the canonical signature TEXT and its digest words
# stable_decl_stamp records for the conservative rename/move rule (the
# digest is the matching authority; the text is the persisted structural
# fingerprint). Seeds ride the walk's sorted-key order, so the stamping is
# deterministic.
struct SnapshotDeclSeed
  package_key: String
  module_path: String
  kind: String
  name: String
  sig_digest_hi: UInt
  sig_digest_lo: UInt
  sig_text: String
end

# ONE build-visible declaration BEFORE the persistent lineage is stamped:
# everything the def row and the stamping stage need, in sorted-key order.
struct SnapshotPendingDef
  kind: DefKind
  key: String
  name: String
  module_path: String
  is_pub: Bool
  is_generic: Bool
  is_test: Bool
  contracts: Vec[SnapshotDeclClause]
  sig: String
end

# The build's live structural scope keys — the rename rule's
# NOT-disappeared set (one stable_lineage_scope_key render per seed).
def snapshot_live_scope_keys(seeds: Vec[SnapshotDeclSeed]) -> Vec[String]
  var live: Vec[String] = Vec::new()
  for s in seeds do
    live.push(stable_lineage_scope_key(s.package_key.clone(), s.module_path.clone(), s.kind.clone(), s.name.clone()))
  end
  live
end

# THE STORE SEAM of the snapshot builder: stamp every declaration of this
# build through the shared DeclLineageStore, in seed order. The call opens
# a store revision (fourth-audit P0-2/P0-3 — the conservative rebinding
# rule reads "last seen in the immediately preceding revision" off the
# store's own provenance clock) and closes it after the walk, tombstoning
# every entry not seen in this build. An already-bound structural key keeps
# its persistent number (stable_decl_stamp re-signs it); an explicit
# DeclContinuation recorded for a location wins before any heuristic; a
# first sight with the STRONG rebind evidence (unique same-package/
# same-kind/same-signature candidate seen in the immediately preceding
# revision, not live in this build) takes that lineage; anything else
# bootstraps fresh (removed+created, never guessed). One call per build;
# the caller threads the same store across builds so numbers survive.
# Deterministic: the returned vector aligns with the seed vector.
pub def snapshot_stamp_decls(inout store: DeclLineageStore, seeds: Vec[SnapshotDeclSeed]) -> Vec[StableDeclId]
  stable_lineage_store_begin_revision(store)
  let live = snapshot_live_scope_keys(&seeds)
  var out: Vec[StableDeclId] = Vec::new()
  for s in seeds do
    out.push(stable_decl_stamp_or_rebind(store, s.package_key.clone(), s.module_path.clone(), s.kind.clone(),
      s.name.clone(), s.sig_digest_hi, s.sig_digest_lo, s.sig_text.clone(), live.clone()))
  end
  stable_lineage_store_finish_revision(store)
  out
end

def snapshot_walk_defs(ctx: SnapshotBuildCtx, inout store: DeclLineageStore) -> Result[Vec[SnapshotDef], SnapshotError]
  let metas_pair = snapshot_walk_metas(&ctx)
  var metas = metas_pair.0
  var clauses = metas_pair.1
  snapshot_resolve_impl_metas(&ctx, &mut metas, &mut clauses)

  # The registry keys, sorted — the ONLY Map iteration that reaches text.
  var keys: Vec[String] = Vec::new()
  for entry in ctx.typed.resolutions.module_symbols.entries() do
    keys.push(entry.0.clone())
  end
  keys.sort_by(|a, b| a < b)

  # Pass 1 — the build-visible declarations: kind, canonical signature text,
  # item metadata and clauses, in sorted registration-key order.
  var pending: Vec[SnapshotPendingDef] = Vec::new()
  for key in keys do
    match ctx.numeric_of_key.get(key.clone())
    when Option::Some(numeric) then
      let kind = def_id_kind_of_recovery(&ctx.typed.resolutions, &snapshot_def_of_numeric(&ctx, numeric))
      match snapshot_def_sig_text(&ctx, &key, &kind)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(sig) then
        var is_pub = false
        var is_generic = false
        var is_test = false
        match metas.get(key.clone())
        when Option::Some(meta) then
          is_pub = meta.is_pub
          is_generic = meta.is_generic
          is_test = meta.is_test
        when Option::None then ()
        end
        var cons: Vec[SnapshotDeclClause] = Vec::new()
        match clauses.get(key.clone())
        when Option::Some(cs) then cons = cs.clone()
        when Option::None then ()
        end
        pending.push(SnapshotPendingDef {
          kind: kind,
          key: key.clone(),
          name: snapshot_key_name(&key),
          module_path: snapshot_key_module(&key),
          is_pub: is_pub,
          is_generic: is_generic,
          is_test: is_test,
          contracts: cons,
          sig: sig
        })
      end
    when Option::None then ()
    end
  end

  # Pass 2 — the persistent declaration identity: one seed per declaration,
  # stamped through the shared store. The signature digest the conservative
  # rename/move rule matches on is the canonical signature TEXT's digest;
  # the TEXT itself is the persisted structural fingerprint (P0-2).
  var seeds: Vec[SnapshotDeclSeed] = Vec::new()
  for p in pending do
    let sd = stable_digest_of(&p.sig)
    seeds.push(SnapshotDeclSeed {
      package_key: "".to_string(),
      module_path: p.module_path.clone(),
      kind: semantic_def_kind_text(&p.kind),
      name: p.name.clone(),
      sig_digest_hi: sd.hi,
      sig_digest_lo: sd.lo,
      sig_text: p.sig.clone()
    })
  end
  let decls = snapshot_stamp_decls(store, &seeds)

  # Pass 3 — the rows, rooted on the stamped declaration: the StableDefId
  # digest words ARE the StableDeclId's (stable_def_id_of_decl), so a
  # rename, a move or a nearby insertion leaves the row identity
  # byte-identical while the key text carries the current spelling.
  var defs: Vec[SnapshotDef] = Vec::new()
  var pi = 0
  while pi < pending.len() do
    let p = pending[pi]
    let pd = decls[pi]
    defs.push(SnapshotDef {
      sid: stable_def_id_of_decl(&pd, p.key.clone() + "#" + p.sig.clone(), p.key.clone()),
      decl: pd.clone(),
      kind: p.kind,
      key: p.key.clone(),
      name: p.name.clone(),
      module_path: p.module_path.clone(),
      is_pub: p.is_pub,
      is_generic: p.is_generic,
      is_test: p.is_test,
      contracts: p.contracts.clone()
    })
    pi = pi + 1
  end
  Result::Ok(defs)
end

def snapshot_numeric_of_def(ctx: SnapshotBuildCtx, d: SnapshotDef) -> Int
  match ctx.numeric_of_key.get(d.key.clone())
  when Option::Some(numeric) then numeric
  when Option::None then -1
  end
end

# ———————————————————————————————————————————————————————————————
# The MIR walks
# ———————————————————————————————————————————————————————————————
# Every scan below walks the verified MIR ONCE and indexes the results by
# emission name; the resolution of a lowered function's identity NEVER
# scans the program again — the context maps (item 10) are the only
# callable/emission/extern/body authorities.

struct SnapshotCallSite
  caller_numeric: Int      # the caller's def numeric; -1 = synthesized caller
  callee_numeric: Int      # resolved def numeric; -2 = intrinsic-name
  callee_name: String
  kind: CallEdgeKind
  # (third-audit item 18) The TYPED instantiation record of the solved
  # callee InstanceId when the call carried one: the instance's MIR
  # emission name (the mono instance-key render the lowered program itself
  # computes) and the instance's substitution count. A site whose callee
  # has no InstanceId payload, or a non-generic callee (empty
  # substitution), carries "" / 0 and emits no instantiation edge.
  callee_instance: String
  callee_instance_args: Int
end

struct SnapshotIndirectCall
  caller_name: String
  caller_numeric: Int      # -1 = a synthesized (non-def-keyed) caller
  block_id: Int            # the terminator's block id (the §33 site grammar)
  signature: String        # the canonical callee-surface type text
end

struct SnapshotOwnership
  function_key: String
  place_key: String
  convention: AccessConvention
end

struct SnapshotScan
  statement_count: Int
  direct_unsafe: Bool
  direct_unknown: Bool
  unsafe_ops: Vec[String]  # the unsafe-surface markers
end

# The canonical text of one MIR local: the declared local NAME when the
# slot has one, otherwise the slot's ordinal ("l<id>" — the DENSE locator
# the lowered program itself owns; explicitly dense by design (documented
# in the module doc): unnamed MIR temporaries have no source name, and the
# ordinal is the byte-reproducible identity of the slot. An OUT-OF-RANGE
# slot id is a hard failure (item 8 — UnstableLocalIdentity), never an
# "l<id>" fallback.
def snapshot_local_name(ctx: SnapshotBuildCtx, f: MirFunction, id: Int) -> Result[String, SnapshotError]
  if id >= 0 && id < f.locals.len() then
    let lname = f.locals[id].name.clone()
    if lname.len() > 0 then
      Result::Ok(lname)
    else
      Result::Ok("l" + id.to_string())
    end
  else
    Result::Err(SnapshotError::UnstableLocalIdentity)
  end
end

# The canonical place-key text of a MIR place within a function
# ("local.field[idx]..." — field/variant names from the finalized MIR type
# table). Result-typed (item 8): a field/variant whose owner is absent
# from the MIR type table (or whose index is out of range) is a hard
# failure — the historical "f<index>"/"v<index>" fallbacks are gone.
def snapshot_place_key(ctx: SnapshotBuildCtx, f: MirFunction, p: Place) -> Result[String, SnapshotError]
  match snapshot_local_name(ctx, f, &p.local.id)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(base) then
    var text = base
    for proj in p.projections do
      match proj
      when Projection::ProjDeref then text = text + "*"
      when Projection::Field(fid) then
        match snapshot_field_name(ctx, &fid.owner, fid.index)
        when Result::Err(fe) then return Result::Err(fe)
        when Result::Ok(fn) then text = text + "." + fn
        end
      when Projection::Variant(vid) then
        match snapshot_variant_name(ctx, &vid.owner, vid.index as Int)
        when Result::Err(ve) then return Result::Err(ve)
        when Result::Ok(vn) then text = text + "." + vn
        end
      when Projection::TupleIndex(idx) then text = text + "." + idx.to_string()
      when Projection::ProjIndex(local_id) then
        match snapshot_local_name(ctx, f, &local_id.id)
        when Result::Err(le) then return Result::Err(le)
        when Result::Ok(ln) then text = text + "[" + ln + "]"
        end
      when Projection::ProjConstantIndex(idx2) then text = text + "[" + idx2.to_string() + "]"
      end
    end
    Result::Ok(text)
  end
end

# The canonical name of a MIR struct FIELD of an owner type. The field
# NAME comes from the finalized MIR type table (declaration order — the
# field's identity IS its declaration name); an owner the MIR table does
# not carry, or an out-of-range index, is a hard failure (item 8 —
# UnstableFieldIdentity), never an "f<index>" render.
def snapshot_field_name(ctx: SnapshotBuildCtx, owner: TypeId, index: Int) -> Result[String, SnapshotError]
  match ctx.mir_type_index.get(owner.id)
  when Option::Some(ti) then
    if ti >= 0 && ti < ctx.mir.types.len() then
      match ctx.mir.types[ti].kind
      when MirTypeDefKind::Struct(fields) then
        if index >= 0 && index < fields.len() then
          return Result::Ok(fields[index].name.clone())
        end
        return Result::Err(SnapshotError::UnstableFieldIdentity)
      when _ then return Result::Err(SnapshotError::UnstableFieldIdentity)
      end
    end
    Result::Err(SnapshotError::UnstableFieldIdentity)
  when Option::None then Result::Err(SnapshotError::UnstableFieldIdentity)
  end
end

# The canonical name of a MIR enum VARIANT of an owner type (the variant's
# declaration name; declaration order, never the discriminant). An owner
# the MIR table does not carry, or an out-of-range index, is a hard
# failure (item 8 — UnstableVariantIdentity), never a "v<index>" render.
def snapshot_variant_name(ctx: SnapshotBuildCtx, owner: TypeId, index: Int) -> Result[String, SnapshotError]
  match ctx.mir_type_index.get(owner.id)
  when Option::Some(ti) then
    if ti >= 0 && ti < ctx.mir.types.len() then
      match ctx.mir.types[ti].kind
      when MirTypeDefKind::Enum(variants) then
        if index >= 0 && index < variants.len() then
          return Result::Ok(variants[index].name.clone())
        end
        return Result::Err(SnapshotError::UnstableVariantIdentity)
      when _ then return Result::Err(SnapshotError::UnstableVariantIdentity)
      end
    end
    Result::Err(SnapshotError::UnstableVariantIdentity)
  when Option::None then Result::Err(SnapshotError::UnstableVariantIdentity)
  end
end

# The owning-place key of a move/consume operand ("" for non-place ops —
# the empty marker is canonical content: the operand has no place).
def snapshot_move_place_key(ctx: SnapshotBuildCtx, f: MirFunction, op: MirOperand) -> Result[String, SnapshotError]
  match op.kind
  when MirOperandKind::MirMovePlace(p) then snapshot_place_key(ctx, f, &p)
  when MirOperandKind::MirConsume(p) then snapshot_place_key(ctx, f, &p)
  when _ then Result::Ok("")
  end
end

# The canonical callee-surface TYPE text of a call site whose callee is a
# VALUE (item 13): the operand's best-resolved type — a MirConstant's own
# ty for the non-FnItem constants; a place operand's base/local type
# walked through its projections for the value-call shapes. The walk is
# bounded: a projection whose owner shape the MIR tables cannot recover
# leaves the current type (a deterministic render of what IS known — the
# site is still classified Indirect with completeness "Unknown"). An
# out-of-range local is a hard failure (item 8 — UnstableLocalIdentity).
def snapshot_indirect_callee_type(ctx: SnapshotBuildCtx, f: MirFunction, op: MirOperand) -> Result[Type, SnapshotError]
  match op.kind
  when MirOperandKind::MirConstant(cv) then Result::Ok(cv.ty.clone())
  when MirOperandKind::MirCopy(pl) then snapshot_place_type(ctx, f, &pl)
  when MirOperandKind::MirMovePlace(pl2) then snapshot_place_type(ctx, f, &pl2)
  when MirOperandKind::MirRead(pl3) then snapshot_place_type(ctx, f, &pl3)
  when MirOperandKind::MirConsume(pl4) then snapshot_place_type(ctx, f, &pl4)
  end
end

# The bounded place-type walk (see snapshot_indirect_callee_type).
def snapshot_place_type(ctx: SnapshotBuildCtx, f: MirFunction, p: Place) -> Result[Type, SnapshotError]
  var cur: Type = Type::Unit
  if p.local.id >= 0 && p.local.id < f.locals.len() then
    cur = f.locals[p.local.id].ty.clone()
  else
    return Result::Err(SnapshotError::UnstableLocalIdentity)
  end
  for proj in p.projections do
    match proj
    when Projection::ProjDeref then
      match cur
      when Type::RefInternal(inner, _) then cur = inner.clone()
      when Type::Ptr(inner2) then cur = inner2.clone()
      when Type::PtrMut(inner3) then cur = inner3.clone()
      when _ then ()
      end
    when Projection::Field(fid) then
      match ctx.mir_type_index.get(fid.owner.id)
      when Option::Some(ti) then
        if ti >= 0 && ti < ctx.mir.types.len() then
          match ctx.mir.types[ti].kind
          when MirTypeDefKind::Struct(fields) then
            if fid.index >= 0 && fid.index < fields.len() then
              cur = fields[fid.index].ty.clone()
            end
          when _ then ()
          end
        end
      when Option::None then ()
      end
    when Projection::Variant(vid) then
      match ctx.mir_type_index.get(vid.owner.id)
      when Option::Some(ti2) then
        if ti2 >= 0 && ti2 < ctx.mir.types.len() then
          match ctx.mir.types[ti2].kind
          when MirTypeDefKind::Enum(variants) then
            let vi = vid.index as Int
            if vi >= 0 && vi < variants.len() then
              if variants[vi].fields.len() == 1 then
                cur = variants[vi].fields[0].clone()
              end
            end
          when _ then ()
          end
        end
      when Option::None then ()
      end
    when Projection::TupleIndex(idx) then
      match cur
      when Type::Tuple(fields2) then
        if idx >= 0 && idx < fields2.len() then
          cur = fields2[idx].clone()
        end
      when _ then ()
      end
    when Projection::ProjIndex(_) then
      match cur
      when Type::FixedArray(elem, _) then cur = elem.clone()
      when _ then ()
      end
    when Projection::ProjConstantIndex(_) then
      match cur
      when Type::FixedArray(elem2, _) then cur = elem2.clone()
      when _ then ()
      end
    end
  end
  Result::Ok(cur)
end

def snapshot_bodyless_intrinsic_name(name: String) -> Bool
  if name.starts_with("__intrinsic_") then return true end
  if name.starts_with("string_from_static") then return true end
  false
end

def snapshot_intrinsic_is_unsafe(intrinsic: Option[IntrinsicId]) -> Bool
  match intrinsic
  when Option::Some(iid) then effect_summary_of_intrinsic(iid).may_unsafe
  when Option::None then false
  end
end

def snapshot_call_kind_of(intrinsic: Option[IntrinsicId], name: String) -> CallEdgeKind
  if intrinsic.is_some() then
    CallEdgeKind::Intrinsic
  elsif name.starts_with("__intrinsic_") then
    CallEdgeKind::Intrinsic
  else
    CallEdgeKind::Direct
  end
end

# One MIR function's statement/terminator walk: the direct unsafe/unknown
# markers, the statement count, the unsafe-surface markers and the
# call/ownership/indirect-call sites. Result-typed (item 8 — every
# canonical text it builds can fail).
def snapshot_scan_function(
  ctx: SnapshotBuildCtx,
  f: MirFunction,
  caller_numeric: Int,
  inout calls: Vec[SnapshotCallSite],
  inout indirect: Vec[SnapshotIndirectCall],
  inout ownership: Vec[SnapshotOwnership],
  inout scans: Map[String, SnapshotScan]
) -> Result[Unit, SnapshotError]
  var stmt_count = 0
  var d_unsafe = f.is_unsafe
  var d_unknown = false
  var unsafe_ops: Vec[String] = Vec::new()
  if f.is_unsafe then
    unsafe_ops.push("unsafe-fn".to_string())
  end
  var block_i = 0
  while block_i < f.blocks.len() do
    let block = f.blocks[block_i]
    for st in block.statements do
      stmt_count = stmt_count + 1
      match st.kind
      when MirStatementKind::MirAssign(dest, rvalue) then
        match rvalue.kind
        when MirRvalueKind::MirMove(op) then
          match snapshot_ownership_of_dest(ctx, f, &dest, &mut ownership)
          when Result::Err(e) then return Result::Err(e)
          when Result::Ok(()) then ()
          end
          match snapshot_move_place_key(ctx, f, &op)
          when Result::Err(e2) then return Result::Err(e2)
          when Result::Ok(place) then
            if place.len() > 0 then
              ownership.push(SnapshotOwnership {
                function_key: f.name.clone(),
                place_key: place,
                convention: AccessConvention::Sink
              })
            end
          end
        when MirRvalueKind::MirConsume(op2) then
          match snapshot_ownership_of_dest(ctx, f, &dest, &mut ownership)
          when Result::Err(e3) then return Result::Err(e3)
          when Result::Ok(()) then ()
          end
          match snapshot_move_place_key(ctx, f, &op2)
          when Result::Err(e4) then return Result::Err(e4)
          when Result::Ok(place2) then
            if place2.len() > 0 then
              ownership.push(SnapshotOwnership {
                function_key: f.name.clone(),
                place_key: place2,
                convention: AccessConvention::Sink
              })
            end
          end
        when MirRvalueKind::MirRef(place) then
          match snapshot_place_key(ctx, f, &place)
          when Result::Err(e5) then return Result::Err(e5)
          when Result::Ok(pk) then
            ownership.push(SnapshotOwnership {
              function_key: f.name.clone(),
              place_key: pk,
              convention: AccessConvention::Inout
            })
          end
        when MirRvalueKind::MirCast(CastKind::Transmute, _, _) then
          d_unsafe = true
          unsafe_ops.push("transmute".to_string())
        when _ then ()
        end
      when MirStatementKind::MirEffectPerform(_, _, _, _, _) then
        d_unknown = true
      when _ then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      match snapshot_scan_call(ctx, f, caller_numeric, &func, intrinsic, block.id.id,
        &mut calls, &mut indirect, &mut d_unsafe, &mut d_unknown, &mut unsafe_ops)
      when Result::Err(e6) then return Result::Err(e6)
      when Result::Ok(()) then ()
      end
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      match snapshot_place_key(ctx, f, &place)
      when Result::Err(e7) then return Result::Err(e7)
      when Result::Ok(pk2) then
        ownership.push(SnapshotOwnership {
          function_key: f.name.clone(),
          place_key: pk2,
          convention: AccessConvention::Sink
        })
      end
      if !snapshot_deinit_known(ctx, &deinit_fn) then
        d_unknown = true
      end
    when _ then ()
    end
    block_i = block_i + 1
  end
  scans.insert(f.name.clone(), SnapshotScan {
    statement_count: stmt_count,
    direct_unsafe: d_unsafe,
    direct_unknown: d_unknown,
    unsafe_ops: unsafe_ops
  })
  Result::Ok(())
end

def snapshot_ownership_of_dest(
  ctx: SnapshotBuildCtx,
  f: MirFunction,
  dest: Place,
  inout ownership: Vec[SnapshotOwnership]
) -> Result[Unit, SnapshotError]
  match snapshot_place_key(ctx, f, dest)
  when Result::Err(e) then Result::Err(e)
  when Result::Ok(pk) then
    ownership.push(SnapshotOwnership {
      function_key: f.name.clone(),
      place_key: pk,
      convention: AccessConvention::Set
    })
    Result::Ok(())
  end
end

# Whether a MirDeinit payload resolves to in-program glue/finalizer — the
# def-numeric-keyed MIR tables resolve the payload's name first, and the
# construction-time body_names index answers whether that name has a body
# (NO function scan — item 10).
def snapshot_deinit_known(ctx: SnapshotBuildCtx, deinit_fn: InstanceId) -> Bool
  let num = def_id_numeric(&deinit_fn.def.def)
  var name = "".to_string()
  match ctx.mir.drop_glue_fns.get(num)
  when Option::Some(n) then name = n.clone()
  when Option::None then ()
  end
  if name.len() == 0 then
    match ctx.mir.method_names_by_def.get(num)
    when Option::Some(n2) then name = n2.clone()
    when Option::None then ()
    end
  end
  if name.len() == 0 then return false end
  ctx.body_names.contains(&name)
end

# One MirCall terminator: the callee resolution and the unsafe/unknown
# classification (item 10 — every lookup rides a construction-time index;
# NO function scan, NO bare-name fallback). The callee of a SOURCE call is
# the MirFnItem constant's INSTANCE payload (the solved InstanceId — its
# DefId); a name-only constant resolves through the def-emission-name
# index, the synthesized intrinsic-name family classifies as an Intrinsic
# edge, and an in-program extern marks the site unsafe. An indirect VALUE
# call (or a non-FnItem callee constant) has no statically-known
# declaration: it fails closed (unknown) and is recorded as an explicit
# indirect row (item 13 — completeness "Unknown": the call builder has no
# points-to information, so the candidate set is never filled here).
def snapshot_scan_call(
  ctx: SnapshotBuildCtx,
  f: MirFunction,
  caller_numeric: Int,
  func: MirOperand,
  intrinsic: Option[IntrinsicId],
  block_id: Int,
  inout calls: Vec[SnapshotCallSite],
  inout indirect: Vec[SnapshotIndirectCall],
  inout d_unsafe: Bool,
  inout d_unknown: Bool,
  inout unsafe_ops: Vec[String]
) -> Result[Unit, SnapshotError]
  match func.kind
  when MirOperandKind::MirConstant(cv) then
    match cv.kind
    when MirConstantKind::MirFnItem(name) then
      match cv.instance.clone()
      when Option::Some(inst) then
        calls.push(SnapshotCallSite {
          caller_numeric: caller_numeric,
          callee_numeric: def_id_numeric(&inst.def.def),
          callee_name: name.clone(),
          kind: snapshot_call_kind_of(intrinsic, &name),
          callee_instance: name.clone(),
          callee_instance_args: inst.substs.len()
        })
        if ctx.extern_fn_by_name.contains_key(&name) then
          d_unsafe = true
          unsafe_ops.push("extern-call:" + name.clone())
        elsif snapshot_intrinsic_is_unsafe(intrinsic) then
          d_unsafe = true
        end
      when Option::None then
        match ctx.def_emission_numeric.get(name.clone())
        when Option::Some(numeric) then
          calls.push(SnapshotCallSite {
            caller_numeric: caller_numeric,
            callee_numeric: numeric,
            callee_name: name.clone(),
            kind: snapshot_call_kind_of(intrinsic, &name),
            callee_instance: "".to_string(),
            callee_instance_args: 0
          })
        when Option::None then
          if snapshot_bodyless_intrinsic_name(&name) then
            calls.push(SnapshotCallSite {
              caller_numeric: caller_numeric,
              callee_numeric: -2,
              callee_name: name.clone(),
              kind: CallEdgeKind::Intrinsic,
              callee_instance: "".to_string(),
              callee_instance_args: 0
            })
          elsif ctx.extern_fn_by_name.contains_key(&name) then
            d_unsafe = true
            unsafe_ops.push("extern-call:" + name.clone())
          else
            # A truly unknown bodyless callee — fail closed (the §11 rule).
            d_unknown = true
            d_unsafe = true
            unsafe_ops.push("unknown-call:" + name.clone())
          end
        end
      end
    when _ then
      # A call through a NON-FnItem constant (e.g. a static fn-pointer
      # value): no statically-known declaration — indirect (item 13).
      d_unknown = true
      match snapshot_indirect_callee_type(ctx, f, &func)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(ct) then
        match snapshot_type_text(ctx, &ct)
        when Result::Err(e2) then return Result::Err(e2)
        when Result::Ok(sig) then
          indirect.push(SnapshotIndirectCall {
            caller_name: f.name.clone(),
            caller_numeric: caller_numeric,
            block_id: block_id,
            signature: sig
          })
        end
      end
    end
    Result::Ok(())
  when _ then
    # A call through a closure or function-pointer VALUE: no
    # statically-known declaration — it fails closed (unknown) and is
    # recorded as an explicit indirect row (item 13).
    d_unknown = true
    match snapshot_indirect_callee_type(ctx, f, &func)
    when Result::Err(e3) then return Result::Err(e3)
    when Result::Ok(ct2) then
      match snapshot_type_text(ctx, &ct2)
      when Result::Err(e4) then return Result::Err(e4)
      when Result::Ok(sig2) then
        indirect.push(SnapshotIndirectCall {
          caller_name: f.name.clone(),
          caller_numeric: caller_numeric,
          block_id: block_id,
          signature: sig2
        })
      end
    end
    Result::Ok(())
  end
end
# ———————————————————————————————————————————————————————————————
# The transitive §11 effect fixed point
# ———————————————————————————————————————————————————————————————
# Runs the mir.tg §11 direct scan over every lowered function, then
# propagates the summaries (may_* flags + capability sets) and the
# unsafe/unknown markers to a fixed point over the whole call graph
# (monotone joins — order-insensitive by construction).

struct SnapshotEffectFinal
  summary: EffectSummary
  unsafe_: Bool
  unknown: Bool
end

# (third-audit item 25) The §11 fixed point's TWO result tables produced
# by ONE scan: the effect finals per scanned function, plus the
# compiler-verified purity finals (emission name -> PurityStatus) for
# every body-bearing lowered function. The snapshot writer persists the
# purity projection on both the effect rows (def-keyed lowerings) and the
# mir_functions rows (every lowered body).
struct SnapshotEffectFinals
  effects: Map[String, SnapshotEffectFinal]
  purity: Map[String, PurityStatus]
end

def snapshot_effect_caps_equal(a: EffectSummary, b: EffectSummary) -> Bool
  for ca in a.capabilities do
    if !b.capabilities.contains(&ca) then return false end
  end
  for cb in b.capabilities do
    if !a.capabilities.contains(&cb) then return false end
  end
  true
end

def snapshot_effect_same(a: EffectSummary, b: EffectSummary) -> Bool
  if a.may_allocate != b.may_allocate then return false end
  if a.may_block != b.may_block then return false end
  if a.may_io != b.may_io then return false end
  if a.may_spawn != b.may_spawn then return false end
  if a.may_sleep != b.may_sleep then return false end
  if a.may_panic != b.may_panic then return false end
  if a.may_unsafe != b.may_unsafe then return false end
  snapshot_effect_caps_equal(a, b)
end

def snapshot_effect_finals(ctx: SnapshotBuildCtx, scans: Map[String, SnapshotScan]) -> SnapshotEffectFinals
  var fn_index: Map[String, Int] = Map::new()
  var fi = 0
  while fi < ctx.mir.functions.len() do
    let fname = ctx.mir.functions[fi].name.clone()
    if !fn_index.contains_key(&fname) then
      fn_index.insert(fname, fi)
    end
    fi = fi + 1
  end
  var type_index: Map[Int, String] = Map::new()
  for td in ctx.mir.types do
    type_index.insert(td.id.id, td.name.clone())
  end

  var state = MirEffectState {}
  for f in ctx.mir.functions do
    mir_effect_scan_function(&ctx.mir, &mut state, &type_index, &fn_index, &f)
  end

  var final_sum: Map[String, EffectSummary] = Map::new()
  for entry in state.direct.entries() do
    final_sum.insert(entry.0.clone(), entry.1.clone())
  end
  var final_unsafe: Map[String, Bool] = Map::new()
  var final_unknown: Map[String, Bool] = Map::new()
  for entry in scans.entries() do
    final_unsafe.insert(entry.0.clone(), entry.1.direct_unsafe)
    final_unknown.insert(entry.0.clone(), entry.1.direct_unknown)
  end

  var changed = true
  while changed do
    changed = false
    for caller_entry in state.edges.entries() do
      let caller = caller_entry.0.clone()
      var cur_sum = EffectSummary {}
      match final_sum.get(caller.clone())
      when Option::Some(cs) then cur_sum = cs.clone()
      when Option::None then ()
      end
      var cur_unsafe = false
      match final_unsafe.get(caller.clone())
      when Option::Some(u) then cur_unsafe = u
      when Option::None then ()
      end
      var cur_unknown = false
      match final_unknown.get(caller.clone())
      when Option::Some(k2) then cur_unknown = k2
      when Option::None then ()
      end
      for callee in caller_entry.1 do
        var cal_sum = EffectSummary {}
        match final_sum.get(callee.clone())
        when Option::Some(cs2) then cal_sum = cs2.clone()
        when Option::None then ()
        end
        let merged = effect_summary_merge(&cur_sum, &cal_sum)
        var cal_unsafe = false
        match final_unsafe.get(callee.clone())
        when Option::Some(u2) then cal_unsafe = u2
        when Option::None then ()
        end
        var cal_unknown = false
        match final_unknown.get(callee.clone())
        when Option::Some(k3) then cal_unknown = k3
        when Option::None then ()
        end
        if !snapshot_effect_same(&cur_sum, &merged) then
          final_sum.insert(caller.clone(), merged.clone())
          changed = true
        end
        if !cur_unsafe && cal_unsafe then
          final_unsafe.insert(caller.clone(), true)
          changed = true
        end
        if !cur_unknown && cal_unknown then
          final_unknown.insert(caller.clone(), true)
          changed = true
        end
      end
    end
  end

  var out: Map[String, SnapshotEffectFinal] = Map::new()
  for entry in state.direct.entries() do
    var s = EffectSummary {}
    match final_sum.get(entry.0.clone())
    when Option::Some(fs) then s = fs.clone()
    when Option::None then ()
    end
    var fu = false
    match final_unsafe.get(entry.0.clone())
    when Option::Some(u3) then fu = u3
    when Option::None then ()
    end
    var fk = false
    match final_unknown.get(entry.0.clone())
    when Option::Some(k4) then fk = k4
    when Option::None then ()
    end
    out.insert(entry.0.clone(), SnapshotEffectFinal { summary: s, unsafe_: fu, unknown: fk })
  end

  # (third-audit item 25): the full-program purity fixed point reuses the
  # SAME scan context and edge table — every body-bearing lowered function
  # is seeded with its DIRECT purity status (the §11 records plus the
  # store/call classification of purity_direct_status), then the call
  # graph joins callee statuses to convergence. The result persists per
  # function on the snapshot rows.
  var direct_purity: Map[String, PurityStatus] = Map::new()
  for f in ctx.mir.functions do
    if f.blocks.len() > 0 then
      direct_purity.insert(f.name.clone(), purity_direct_status(&ctx.mir, &fn_index, &type_index, &f))
    end
  end
  let purity_finals = mir_purity_join_fixed_point(&ctx.mir.functions, &direct_purity, &state.edges)
  SnapshotEffectFinals { effects: out, purity: purity_finals }
end

# ———————————————————————————————————————————————————————————————
# MIR body origins — the row-key grammar of every lowered body (item 12)
# ———————————————————————————————————————————————————————————————
# Every lowered MirFunction of the verified program gets a mir_functions
# row, keyed by the canonical text of its ORIGIN:
#   Decl(def digest key)      — a def-keyed lowering (callable = Some);
#                               the row key IS the def digest key text
#                               "path::name#signature" (the same text the
#                               def's own rows carry — byte-identical, so
#                               later delta/index consumers join on it
#                               directly).
#   Instance(instance key)    — a monomorphized body (callable = None,
#                               emission name = the mangled instance key —
#                               the fn-owner-key base + "$"-joined renders,
#                               the stable_ids instance-key grammar); the
#                               canonical text is the emission name.
#   Closure(closure key)      — a lowered closure body; the canonical text
#                               is its emission name ("_closure<counter>" —
#                               the name-only MirFnItem constants call it
#                               by; the counter is a per-snapshot dense
#                               locator of the lowering, documented).
#   DropGlue(type key)        — a generated drop-glue body
#                               ("__tg_drop_glue$..."); the canonical text
#                               is the CONCRETE TYPE IDENTITY KEY text the
#                               body's InstanceId registered under in
#                               MirProgram.drop_glue_instances (the
#                               mir_type_identity_key grammar of the
#                               verified program — the same text every
#                               MIR-side consumer reads).
#   Derived(kind, key)        — a synthesized derived body; today the
#                               effect-handler dispatchers
#                               ("_effect_dispatcher<counter>"): kind
#                               "effect-dispatcher", key = the emission
#                               name.
#   Shim(surface key)         — a bodyless extern declaration (is_extern;
#                               callable = None): the extern surface name
#                               (its bare emission symbol).
# Row KEY TEXTS add the origin word as a prefix ("instance::<key>", ...)
# except Decl (whose text is already the def digest key) — the prefixes
# keep the families disjoint forever (a user extern named "_closure7" can
# never collide with the closure "_closure7").
enum MirOrigin
  Decl(String)
  Instance(String)
  Closure(String)
  DropGlue(String)
  Derived(String, String)
  Shim(String)
end

def snapshot_origin_key_text(o: MirOrigin) -> String
  match o
  when MirOrigin::Decl(k) then k
  when MirOrigin::Instance(k) then "instance::" + k
  when MirOrigin::Closure(k) then "closure::" + k
  when MirOrigin::DropGlue(k) then "drop-glue::" + k
  when MirOrigin::Derived(kind, k) then "derived::" + kind + "::" + k
  when MirOrigin::Shim(k) then "shim::" + k
  end
end

# The origin of ONE lowered function (exhaustive over the verified
# program's emission families — classified by the program's own markers:
# the stamped callable, the extern flag and the emission-name prefixes the
# lowering itself produces). Result-typed: a def-keyed body whose def has
# no registration key (or whose canonical signature cannot render) is a
# hard failure (item 8 — UnstableDefIdentity / the type-render errors).
def snapshot_mir_origin_of(
  ctx: SnapshotBuildCtx,
  f: MirFunction,
  defs: Vec[SnapshotDef],
  def_row_of_numeric: Map[Int, Int]
) -> Result[MirOrigin, SnapshotError]
  match f.callable.clone()
  when Option::Some(cid) then
    let numeric = def_id_numeric(&cid.def)
    match def_row_of_numeric.get(numeric)
    when Option::Some(row_idx) then
      if row_idx >= 0 && row_idx < defs.len() then
        return Result::Ok(MirOrigin::Decl(defs[row_idx].sid.key.clone()))
      end
    when Option::None then ()
    end
    # A def-keyed lowering whose def row is missing is impossible for a
    # registered program — fail closed rather than degrade the identity.
    match ctx.key_of_def.get(numeric)
    when Option::None then Result::Err(SnapshotError::UnstableDefIdentity)
    when Option::Some(key) then
      let did = snapshot_def_of_numeric(ctx, numeric)
      let kind = def_id_kind_of_recovery(&ctx.typed.resolutions, &did)
      match snapshot_def_sig_text(ctx, &key, &kind)
      when Result::Err(e) then Result::Err(e)
      when Result::Ok(sig) then Result::Ok(MirOrigin::Decl(key.clone() + "#" + sig))
      end
    end
  when Option::None then
    if f.is_extern then
      Result::Ok(MirOrigin::Shim(f.name.clone()))
    elsif f.name.starts_with("__tg_drop_glue$") then
      # The drop-glue type identity key text of the body (the reverse of
      # the glue registration tables). A glue body absent from the
      # registration maps cannot exist in a verified program; the emission
      # name fallback below is defensive and unreachable — it keeps the
      # row total without ever degrading a REGISTERED glue.
      match ctx.glue_type_key_of_name.get(f.name.clone())
      when Option::Some(tk) then Result::Ok(MirOrigin::DropGlue(tk.clone()))
      when Option::None then Result::Ok(MirOrigin::DropGlue(f.name.clone()))
      end
    elsif f.name.starts_with("_effect_dispatcher") then
      Result::Ok(MirOrigin::Derived("effect-dispatcher".to_string(), f.name.clone()))
    elsif f.name.starts_with("_closure") then
      Result::Ok(MirOrigin::Closure(f.name.clone()))
    else
      # A monomorphized instance (callable = None, emission name = the
      # mangled instance key — the only remaining program family).
      Result::Ok(MirOrigin::Instance(f.name.clone()))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The persisted ABI surface rows (audit item 18)
# ———————————————————————————————————————————————————————————————
# The abi_hash domain stays the §30 CanonExternal text digest
# (snapshot_abi_text below); THIS section persists the canonical rows
# behind the ABI surface so abi.diff can explain exact layout/class
# changes. The rows are computed from the SAME finalized state the rest of
# the builder reads (the MIR type table + the def-keyed lowerings) and the
# layout engine is the SINGLE classification authority:
#
#   fn rows   — every pub Function def whose def-keyed lowering is
#               stamped (the snapshot_abi_text domain) PLUS every pub
#               EXTERN declaration's lowering (third-audit item 43 — the
#               FFI boundary surface itself; callable = None): the
#               signature's param types and return type classified through
#               layout_engine.tg's ONE plan authority (classify_call_plan;
#               InternalValue for a def-keyed function, ExternC for an
#               extern declaration) with the layout engine's
#               classify_value_category as the per-position fail reason.
#               The class words are the canonical renders of the typed
#               AbiValueClass ("zero" / "scalar:<w>" / "pair:<w1>:<w2>" /
#               "vector:<w>" / "by-address:<size>") produced by
#               layout_engine's abi_value_class_word (third-audit item 41);
#               the return word is abi_return_text's DELIVERY render
#               ("direct:" | "sret:"). Each fn row ALSO carries the typed
#               FFI-surface mirror (third-audit items 42/43): the declared
#               access conventions (the checker's typed FnSignature),
#               the owning/Copy return word (the type-properties
#               authority), the nullability rows of the Ptr-typed
#               parameters, the variadic marker, the per-param
#               extensions/locations, the platform triple, the failure
#               convention (the builtin-Result lang item vs the panic
#               model) and the canonical enum-crossing boundary word
#               (classify_enum_crossing). Nothing is parsed back out of a
#               rendered signature string.
#   type rows — every declared nominal type of the def walk (the types
#               table): layout size/alignment and the "name offset size"
#               field rows from layout_of_concrete (struct fields in
#               declaration order; enums additionally carry the "tag
#               <offset> <size>" row and variant-qualified
#               "<Variant>#<index>" payload field rows from the rich
#               EnumLayout + the MirTypeDef variant names). A generic base
#               has no single nominal layout — its instances do — so it
#               fails closed exactly like snapshot_abi_text's "generic"
#               marker. Type rows carry the platform word only.
#
# FAIL CLOSED (item 8 policy): a type/signature the classifier rejects, a
# generic base, a trait, an unregistered/missing MirTypeDef, a plan the
# FFI-safety gates reject and any unclassifiable shape emit an
# "abi-fail-closed" row whose fields carry "reason:<word>" (the layout
# failure class word, "generic-base", "trait-no-layout",
# "unregistered-type", "no-mir-type-def", "enum-layout-missing",
# "no-abi-signature", "arg<i>:<word>", "ret:<word>", "plan:<word>"). No
# size/offset/class/convention is ever fabricated.

# The layout-engine target descriptor of a snapshot TargetDesc. The two
# direct-emitter hosts have canonical engine descriptors (aarch64_target /
# x86_64_target) and take them verbatim. Every other desc takes a
# descriptor DERIVED FIELD BY FIELD from the desc (pointer width/alignment,
# the integer model = pointer width per the LP64/ILP32 rule, the closure
# {code,env} pointer pair, endianness, stack alignment) with the
# compiler-wide constants the canonical descriptors share — the snapshot
# route itself only runs on the two hosts, so this arm is the defensive
# path and never claims a canonical descriptor it is not.
def snapshot_abi_layout_target(target: TargetDesc) -> TargetDescriptor
  match target.arch
  when Arch::X86_64 then x86_64_target()
  when Arch::AArch64 then aarch64_target()
  when _ then
    TargetDescriptor {
      arch_name: snapshot_target_arch_text(target.arch),
      pointer_size: target.pointer_width,
      pointer_align: target.pointer_width,
      max_align: if target.pointer_width >= 8 then 16 else 8 end,
      int_size: target.pointer_width,
      bool_size: 1,
      char_size: 4,
      fn_ptr_size: target.pointer_width * 2,
      float_size: 8,
      double_size: 8,
      endianness: snapshot_target_endian_text(target.endianness),
      stack_align: target.stack_alignment
    }
  end
end

# The layout engine of the snapshot's finalized MIR: the program's
# MirTypeDef table registered on the target bridge above, with every
# non-generic nominal layout precomputed (the codegen construction shape).
def snapshot_abi_layout_engine(mir: MirProgram, target: TargetDesc) -> LayoutEngine
  var engine = layout_engine_new(snapshot_abi_layout_target(&target))
  layout_engine_register_types(&mut engine, mir.types)
  compute_all_layouts(&mut engine)
  engine
end

# ———————————————————————————————————————————————————————————————
# The typed FFI-surface fields of a fn row (third-audit items 42/43)
# ———————————————————————————————————————————————————————————————
# Every field below is derived from TYPED finalized state — the plan
# authority (classify_call_plan), the checker's FnSignature record (the
# access conventions and the variadic flag), the type-properties engine
# (owning vs Copy), the builtin-Result lang item, the enum-crossing
# authority (classify_enum_crossing) and the StableTargetId triple — never
# from a rendered signature string. The word helpers are pub so the abi
# lane drives the SAME seams the producer uses.

# The ownership word of a surface's return: "none" for the Unit return,
# "owned" when the type-properties authority marks the returned value as
# ownership-carrying (owns_state, a registered destructor, or linear
# resource/capability state), "borrowed" for every other concrete value
# (a Copy value or a non-owning view). The rule is the authority's
# ownership axes; it is never inferred from the type's name or layout.
pub def snapshot_abi_ownership_word(is_owning: Bool, is_unit: Bool) -> String
  if is_unit then
    "none"
  elsif is_owning then
    "owned"
  else
    "borrowed"
  end
end

# The failure-convention word of a surface: "result" when the declared
# return type is the builtin Result, "trap" for every other CONCRETE
# return (the repo's panic model: a non-Result failure aborts/traps), and
# "unknown" when the return type is undecidable (an unresolved
# Var/Param/ConstParam/ConstSym/Error form — no convention is claimed).
pub def snapshot_abi_failure_word(is_result: Bool, decidable: Bool) -> String
  if !decidable then
    "unknown"
  elsif is_result then
    "result"
  else
    "trap"
  end
end

# The nullability word of ONE declared parameter: the model carries NO
# nullability marker vocabulary today (the canonical type render spells
# Ptr/PtrMut as "P[...]"/"Q[...]" with no marker), so a pointer parameter
# answers the explicit "unknown" — never omitted. The single seam: a
# declared marker adds its arm here.
pub def snapshot_abi_nullability_word(is_ptr: Bool) -> String
  if is_ptr then "unknown" else "" end
end

# The canonical-boundary word of one classification (third-audit item 42 —
# the enum-crossing authority): the AbiEnumCrossing result render. The
# authority is layout_engine.tg's classify_enum_crossing; this is only its
# persistence render.
pub def snapshot_abi_enum_crossing_word(c: AbiEnumCrossing) -> String
  match c
  when AbiEnumCrossing::ValueWord then "value-word"
  when AbiEnumCrossing::InlineScalar then "inline-scalar"
  end
end

# The effect wrapper is transparent for the ownership/failure questions
# (the value crossing the boundary is the inner type).
def snapshot_unwrap_effect_type(ty: Type) -> Type
  match ty
  when Type::Effect(_, inner) then inner.clone()
  when _ then ty.clone()
  end
end

# Whether a return type is the builtin Result (the lang-item identity —
# never a name comparison).
def snapshot_type_is_result(ctx: SnapshotBuildCtx, ty: Type) -> Bool
  match snapshot_unwrap_effect_type(&ty)
  when Type::Adt(tid, _) then tid.id == ctx.env.lang_items.result
  when _ then false
  end
end

# Whether a return type is DECIDABLE for the failure convention: an
# unresolved inference/generic/error form claims nothing.
def snapshot_return_failure_decidable(ty: Type) -> Bool
  match snapshot_unwrap_effect_type(&ty)
  when Type::Var(_) then false
  when Type::Param(_) then false
  when Type::ConstParam(_) then false
  when Type::ConstSym(_) then false
  when Type::Error then false
  when _ then true
  end
end

# Whether a type is a REGISTERED enum under the layout engine (the
# classify_enum_crossing domain). Non-Adt and non-enum types contribute no
# boundary word.
def snapshot_type_is_registered_enum(inout engine: LayoutEngine, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, _) then is_enum_type_def(engine, tid.id)
  when _ then false
  end
end

# The canonical_boundary word of one surface signature (third-audit item
# 42): the enum-crossing authority's answer over every enum-typed
# parameter and the return, in declaration order (return last), deduped,
# "|"-joined; "n/a" when the signature mentions no enum. The flavor is the
# surface's own convention (InternalValue for a def-keyed function,
# ExternC for an extern declaration), so the answer is exactly the
# crossing the plan uses. A crossing the authority refuses records its
# fail-closed marker — the plan gate normally rejects the row first, so
# this is the defensive arm.
#
# (fourth-audit P0-20): this report is the ONE crossing both routes use —
# layout_engine.classify_enum_crossing's answer (the canonical TaggedPtr
# value word for a registered enum; InlineScalar for the legacy
# one-word InlineTagged image). The former LIR-private `inline-image-v1`
# representation, its per-function version markers and the
# `tg.abi.enumver` object note were DELETED: the LIR route now
# constructs/reads/moves/drops the same value word and consumes the same
# call plan, so a row here describes the LIR object's crossing too.
def snapshot_abi_canonical_boundary(
  inout engine: LayoutEngine,
  target: TargetDesc,
  flavor: AbiFlavor,
  param_tys: Vec[Type],
  ret_ty: Type
) -> String
  var tys: Vec[Type] = Vec::new()
  for p in param_tys do
    tys.push(p.clone())
  end
  tys.push(ret_ty.clone())
  var words: Vec[String] = Vec::new()
  for ty in tys do
    if snapshot_type_is_registered_enum(&mut engine, ty.clone()) then
      match classify_enum_crossing(&mut engine, target.clone(), flavor, ty.clone())
      when Result::Ok(c) then
        let word = snapshot_abi_enum_crossing_word(c)
        if !words.contains(&word) then
          words.push(word)
        end
      when Result::Err(e) then
        let word2 = "fail-closed:" + snapshot_abi_layout_failure_word(&e.class)
        if !words.contains(&word2) then
          words.push(word2)
        end
      end
    end
  end
  if words.len() == 0 then "n/a" else words.join("|") end
end

# The checker's typed FnSignature of a surface def: the def-owner key for
# a def-keyed declaration (snapshot_typed_fn_signature), the
# module-qualified "module::<path>::<name>" key for an EXTERN declaration
# (types.tg's pass-3 registration — extern blocks record no item_defs, so
# the module-qualified key is their only typed entry). Option::None when
# the record is absent.
def snapshot_abi_typed_signature(ctx: SnapshotBuildCtx, d: SnapshotDef, mf: MirFunction) -> Option[FnSignature]
  if mf.is_extern then
    var key = "module::"
    if d.module_path.len() > 0 then
      key = key + d.module_path.clone() + "::"
    end
    key = key + d.name.clone()
    match ctx.typed.typed_fn_signatures.get(key)
    when Option::Some(sig) then Option::Some(sig.clone())
    when Option::None then Option::None
    end
  else
    snapshot_typed_fn_signature(ctx, &snapshot_def_of_numeric(ctx, snapshot_numeric_of_def(ctx, d)))
  end
end

# The declared parameter list of a surface: the checker's typed record
# first (conventions and resolved types), the MIR-recovered shape
# (mir_fn_abi_signature — the inout RefInternal wrap recovered) when no
# typed record exists.
def snapshot_abi_declared_params(ctx: SnapshotBuildCtx, d: SnapshotDef, mf: MirFunction) -> Vec[ParamType]
  match snapshot_abi_typed_signature(ctx, &d, &mf)
  when Option::Some(sig) then sig.params
  when Option::None then
    match mir_fn_abi_signature(&mf)
    when Type::FnPtr(params, _, _) then params
    when _ then Vec::new()
    end
  end
end

# The access-convention word of every declared parameter, in declaration
# order — the ast.tg AccessConvention vocabulary (let/inout/sink/set).
def snapshot_abi_ownership_in_words(params: Vec[ParamType]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for p in params do
    out.push(snapshot_conv_text(&p.convention))
  end
  out
end

# The nullability rows of the Ptr/PtrMut-typed declared parameters
# ("arg<i> <word>", declaration order; non-pointer parameters contribute
# nothing).
def snapshot_abi_nullability_rows(params: Vec[ParamType]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  var i = 0
  for p in params do
    match p.ty
    when Type::Ptr(_) then out.push("arg" + i.to_string() + " " + snapshot_abi_nullability_word(true))
    when Type::PtrMut(_) then out.push("arg" + i.to_string() + " " + snapshot_abi_nullability_word(true))
    when _ then ()
    end
    i = i + 1
  end
  out
end

# The failure-class word of a layout error (the fail-closed reason text).
def snapshot_abi_layout_failure_word(c: LayoutFailureClass) -> String
  match c
  when LayoutFailureClass::LAYOUT_COMPUTATION_BUG then "layout-computation-bug"
  when LayoutFailureClass::LAYOUT_CONSUMER_BUG then "layout-consumer-bug"
  when LayoutFailureClass::HEADER_MODEL_BUG then "header-model-bug"
  when LayoutFailureClass::ABI_BOUNDARY_BUG then "abi-boundary-bug"
  when LayoutFailureClass::TARGET_DESCRIPTOR_BUG then "target-descriptor-bug"
  when LayoutFailureClass::UNRESOLVED_TYPE then "unresolved-type"
  when LayoutFailureClass::UNSUPPORTED_TYPE then "unsupported-type"
  end
end

# A fail-closed row: no fabricated size/alignment/classes — the reason
# text is the row's content (the snapshot_abi_text marker convention).
def snapshot_abi_fail_row(surface_id: String, symbol_key: String, reason: String) -> AbiSurfaceRow
  var fs: Vec[String] = Vec::new()
  fs.push("reason:" + reason)
  AbiSurfaceRow {
    surface_id: surface_id,
    symbol_key: symbol_key,
    kind: "abi-fail-closed",
    size: -1,
    alignment: -1,
    fields: fs
  }
end

# The registration-key path of a full stable key (everything before the
# first '#'; a key without one is its own path).
def snapshot_key_path(key: String) -> String
  var i = 0
  while i < key.len() do
    if key.slice(i, i + 1) == "#" then
      return key.slice(0, i)
    end
    i = i + 1
  end
  key.clone()
end

# The ABI surface row of one pub fn surface: a Function with a def-keyed
# lowering whose callable is stamped, OR (third-audit item 43) an extern
# declaration's lowering (callable = None — the FFI boundary surface
# itself). The class/location/extension fields come from the ONE plan
# authority (classify_call_plan — InternalValue for a def-keyed function,
# ExternC for an extern declaration); the conventions, variadic flag,
# owning/Copy return word, nullability rows, platform, failure convention
# and enum-crossing boundary come from the typed records (see the helper
# section above). A failure preserves the item-18 reason grammar
# ("arg<i>:<word>" / "ret:<word>") and adds the plan's own gate reason
# ("plan:<word>").
def snapshot_abi_fn_row(
  ctx: SnapshotBuildCtx,
  inout engine: LayoutEngine,
  inout prop_env: TypeEnv,
  target: TargetDesc,
  platform: String,
  d: SnapshotDef,
  fn_idx: Int
) -> AbiSurfaceRow
  let surface_id = "fn:" + d.sid.key.clone()
  if d.is_generic then
    return snapshot_abi_fail_row(surface_id, d.sid.key.clone(), "generic-base")
  end
  let mf = ctx.mir.functions[fn_idx]
  if mf.generic_params.len() > 0 then
    return snapshot_abi_fail_row(surface_id, d.sid.key.clone(), "generic-base")
  end
  let flavor = if mf.is_extern then AbiFlavor::ExternC else AbiFlavor::InternalValue end
  let typed_sig = snapshot_abi_typed_signature(ctx, &d, &mf)
  let declared_params = snapshot_abi_declared_params(ctx, &d, &mf)
  let variadic = match typed_sig.clone()
  when Option::Some(sig) then sig.variadic
  when Option::None then mf.is_extern_variadic
  end
  match mir_fn_abi_signature(&mf)
  when Type::FnPtr(params, ret, _) then
    # The legacy per-position classification: the original fail reasons
    # ("arg<i>:<word>" / "ret:<word>") stay byte-identical; the plan below
    # is the class/location authority.
    var ai = 0
    for p in params do
      match classify_value_category(&mut engine, &p.ty)
      when Result::Err(e) then
        return snapshot_abi_fail_row(surface_id, d.sid.key.clone(),
          "arg" + ai.to_string() + ":" + snapshot_abi_layout_failure_word(&e.class))
      when Result::Ok(_) then ()
      end
      ai = ai + 1
    end
    match classify_value_category(&mut engine, &ret)
    when Result::Err(e2) then
      return snapshot_abi_fail_row(surface_id, d.sid.key.clone(),
        "ret:" + snapshot_abi_layout_failure_word(&e2.class))
    when Result::Ok(_) then ()
    end
    var param_tys: Vec[Type] = Vec::new()
    for p2 in params do
      param_tys.push(p2.ty.clone())
    end
    let plan = match classify_call_plan(&mut engine, target.clone(), flavor, param_tys.clone(), ret.clone(), variadic)
    when Result::Err(pe) then
      return snapshot_abi_fail_row(surface_id, d.sid.key.clone(),
        "plan:" + snapshot_abi_layout_failure_word(&pe.class))
    when Result::Ok(pl) then pl
    end
    var arg_classes: Vec[String] = Vec::new()
    var param_classes: Vec[String] = Vec::new()
    var param_locations: Vec[String] = Vec::new()
    var extensions: Vec[String] = Vec::new()
    for a in plan.args do
      let cls = abi_value_class_word(a.value_class)
      arg_classes.push(cls.clone())
      param_classes.push(cls)
      param_locations.push(abi_location_text(a.location))
      extensions.push(abi_extension_word(a.extension))
    end
    let declared_ret = match typed_sig.clone()
    when Option::Some(sig2) then sig2.ret_type
    when Option::None then ret.clone()
    end
    let props_ty = snapshot_unwrap_effect_type(&declared_ret)
    let is_unit = match props_ty
    when Type::Unit then true
    when _ then false
    end
    var is_owning = false
    if !is_unit then
      let props = type_properties_of(&mut prop_env, props_ty.clone())
      is_owning = props.owns_state || props.requires_drop_glue || props.is_linear
    end
    AbiSurfaceRow {
      surface_id: surface_id,
      symbol_key: d.sid.key.clone(),
      kind: "fn",
      size: -1,
      alignment: -1,
      arg_classes: arg_classes,
      ret_class: abi_return_text(plan.ret.clone()),
      calling_convention: if mf.is_extern then mf.extern_abi.clone() else "tangerine".to_string() end,
      external_symbol: if mf.is_extern then mf.name.clone() else "".to_string() end,
      param_classes: param_classes,
      param_locations: param_locations,
      ownership_in: snapshot_abi_ownership_in_words(declared_params.clone()),
      ownership_out: snapshot_abi_ownership_word(is_owning, is_unit),
      nullability: snapshot_abi_nullability_rows(declared_params.clone()),
      variadic: variadic,
      extension: extensions,
      platform: platform,
      failure_convention: snapshot_abi_failure_word(
        snapshot_type_is_result(ctx, declared_ret.clone()),
        snapshot_return_failure_decidable(&declared_ret)),
      thread_safety: "unknown".to_string(),
      taint: "unmodeled".to_string(),
      canonical_boundary: snapshot_abi_canonical_boundary(&mut engine, target, flavor, param_tys, ret)
    }
  when _ then
    snapshot_abi_fail_row(surface_id, d.sid.key.clone(), "no-abi-signature")
  end
end

# The ABI surface row of one declared nominal type: layout size/alignment
# and the field rows. Generic bases, traits and types with no registered
# MirTypeDef fail closed (mirroring snapshot_abi_text's generic marker).
# Type rows carry the platform word (third-audit item 43) and leave every
# fn-only typed field at its default.
def snapshot_abi_type_row(
  ctx: SnapshotBuildCtx,
  inout engine: LayoutEngine,
  platform: String,
  t: SemanticType
) -> AbiSurfaceRow
  let surface_id = "type:" + t.stable_id.key.clone()
  let symbol = t.stable_id.key.clone()
  if t.generic_arity > 0 then
    return snapshot_abi_fail_row(surface_id, symbol, "generic-base")
  end
  match t.kind
  when SemanticTypeKind::Trait then
    return snapshot_abi_fail_row(surface_id, symbol, "trait-no-layout")
  when _ then ()
  end
  var tid = -1
  match ctx.type_id_of_key.get(snapshot_key_path(&symbol))
  when Option::Some(x) then tid = x
  when Option::None then
    return snapshot_abi_fail_row(surface_id, symbol, "unregistered-type")
  end
  if !ctx.mir_type_index.contains_key(&tid) then
    return snapshot_abi_fail_row(surface_id, symbol, "no-mir-type-def")
  end
  let cty = Type::Adt(TypeId { id: tid }, Vec::new())
  match layout_of_concrete(&mut engine, &cty)
  when Result::Err(e) then
    snapshot_abi_fail_row(surface_id, symbol, snapshot_abi_layout_failure_word(&e.class))
  when Result::Ok(layout) then
    let lsize = layout.size
    let lalign = layout.align
    var fields: Vec[String] = Vec::new()
    match t.kind
    when SemanticTypeKind::Enum then
      match enum_layout_for_type(&mut engine, &cty)
      when Option::Some(el) then
        fields.push("tag " + el.tag_layout.offset.to_string() + " " + el.tag_layout.size.to_string())
        match ctx.mir_type_index.get(tid)
        when Option::Some(ti) then
          if ti >= 0 && ti < ctx.mir.types.len() then
            match ctx.mir.types[ti].kind
            when MirTypeDefKind::Enum(variants) then
              var vi = 0
              for v in variants do
                if vi < el.variant_layouts.len() then
                  let vl = el.variant_layouts[vi]
                  var fi = 0
                  for fl in vl.fields do
                    fields.push(v.name.clone() + "#" + fi.to_string() + " " +
                      fl.offset.to_string() + " " + fl.size.to_string())
                    fi = fi + 1
                  end
                end
                vi = vi + 1
              end
            when _ then ()
            end
          end
        when Option::None then ()
        end
      when Option::None then
        return snapshot_abi_fail_row(surface_id, symbol, "enum-layout-missing")
      end
    when _ then
      for f in layout.fields do
        fields.push(f.name.clone() + " " + f.offset.to_string() + " " + f.size.to_string())
      end
    end
    AbiSurfaceRow {
      surface_id: surface_id,
      symbol_key: symbol,
      kind: "type",
      size: lsize,
      alignment: lalign,
      fields: fields,
      platform: platform
    }
  end
end

# All persisted ABI surface rows of the finalized state, canonically sorted
# (semantic_abi_surfaces_sort). The layout engine is built ONCE here; the
# type-properties engine is the checker's own env cloned once (its memoized
# ownership answers are shared across the rows) and the platform word is
# the StableTargetId triple.
def snapshot_abi_surface_rows(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  types: Vec[SemanticType],
  target: TargetDesc
) -> Vec[AbiSurfaceRow]
  var rows: Vec[AbiSurfaceRow] = Vec::new()
  var engine = snapshot_abi_layout_engine(&ctx.mir, &target)
  var prop_env = ctx.env.clone()
  let target_id = stable_target_id_of(&target)
  let platform = target_id.triple
  for d in defs do
    var is_fn = false
    match d.kind
    when DefKind::Function then is_fn = true
    when _ then ()
    end
    if is_fn && d.is_pub then
      match ctx.mir_fn_by_callable.get(snapshot_numeric_of_def(&ctx, &d))
      when Option::Some(fn_idx) then
        if fn_idx >= 0 && fn_idx < ctx.mir.functions.len() then
          let mf = ctx.mir.functions[fn_idx]
          # The surface set (third-audit item 43): a def-keyed lowering
          # (callable stamped) or an EXTERN declaration's lowering
          # (callable = None — the FFI boundary surface itself).
          var is_surface = false
          match mf.callable.clone()
          when Option::Some(_) then is_surface = true
          when Option::None then
            if mf.is_extern then is_surface = true end
          end
          if is_surface then
            rows.push(snapshot_abi_fn_row(&ctx, &mut engine, &mut prop_env, &target, platform.clone(), &d, fn_idx))
          end
        end
      when Option::None then ()
      end
    end
  end
  for t in types do
    rows.push(snapshot_abi_type_row(&ctx, &mut engine, platform.clone(), &t))
  end
  semantic_abi_surfaces_sort(&mut rows)
  rows
end

# ———————————————————————————————————————————————————————————————
# The typed dependency-graph producers (third-audit items 18/19)
# ———————————————————————————————————————————————————————————————
# Every edge below is emitted from TYPED finalized state — resolved
# signatures, typed field shapes, ImplInfo records, solved InstanceId
# constants, MirStaticRef operands, derived-body lowerings and the typed
# ABI-surface construction — never from a rendered canonical string. The
# rows are deduped per family and sorted through semantic_model.tg's
# semantic_dependency_graph_sort by the writer. PER-FAMILY ANCHORS:
#   TypeUse          — each def's typed signature types (FnSignature /
#                      typed_static_types / the MIR lowering fallback) and
#                      each nominal type's typed field/variant/method
#                      shapes (env.type_list FieldInfo / VariantInfo /
#                      MethodSig).
#   TraitImpl        — env.impls (ImplInfo: trait_id + for_type). Only
#                      concrete Adt self types get a self key; extension
#                      impls (for_type = Param) have no stable self
#                      identity and are omitted (documented).
#   TraitSelection   — the impl methods' def keys recovered through the
#                      checker's OWN resolution (types.tg method_def_for:
#                      the qualified "path::Type::method" registration plus
#                      the 0/1 qualified scan) over the impl's typed
#                      for_type; a method the registration cannot resolve or
#                      disambiguate is omitted (documented). No per-call
#                      selection record exists in the checker, so the
#                      impl-method def is the semantically known selection
#                      anchor.
#   GenericInstantiation — the MirFnItem InstanceId payloads of the call
#                      scan: instance_key = "instance::<emission>" (the
#                      mir_functions ORIGIN key domain of the instance
#                      body), template = the def's stable key. A callee
#                      with no InstanceId payload or an empty substitution
#                      (a non-generic call) produces no edge.
#   LayoutDependency — the typed field/variant shapes of each nominal type
#                      (a type argument reference is included — a
#                      conservative over-approximation for pointer-like
#                      containers; the safe direction). Indirections
#                      (Ptr/PtrMut/RefInternal/Dyn/FnPtr) contribute no
#                      edge.
#   ConstEvalDependency — MirStaticRef / MirStaticAddr operands (the MIR's
#                      semantic DefId record for a module const/static
#                      read) over every lowered body; dependent = the
#                      body's mir origin key. RESIDUAL (precise): a const
#                      reference that exists only inside a TYPE-LEVEL
#                      const-argument expression (a `[T; N]` size, a const
#                      generic argument) is FOLDED at check time by
#                      eval_const_arg_expr and leaves no MIR operand — the
#                      checker records no const-use row, so those
#                      references are not represented here (this family is
#                      stamped PARTIAL and the closure reports the family;
#                      the recording hook is the documented residual).
#   DerivedBody      — the MirOrigin::Derived rows (the effect-dispatcher
#                      family): the derived body's mir origin key -> every
#                      nominal type its typed lowering references
#                      (params / return / locals: captures, payload tuples,
#                      result slots), so a source-type change invalidates
#                      the derived body.
#   ContractReference — each ContractFact clause's typed
#                      ContractExprIR.resolved_refs (resolved against the
#                      def universe at clause lowering), so the edge never
#                      re-parses the canonical clause text.
#   AbiDependency    — each AbiSurfaceRow's typed signature/layout type
#                      references (fn rows: the def's typed signature;
#                      type rows: the type's typed shapes). Fail-closed
#                      surface rows carry no typed references and emit no
#                      edge (documented).
# Effect/Capability propagation, Call, TestReferences and Coverage keep
# their existing row sources (call rows / test rows; coverage rows are not
# produced by the compiler — the execution-side ingest owns them).
#
# COMPLETENESS (fourth-audit P0-9): snapshot_dependency_completeness below
# stamps each RELATION FAMILY with the producer-status word the closure
# reads (SemanticDependencyGraph.dependency_completeness). The statuses
# follow THIS section's documented coverage: every producer whose note
# records an omitted emit (extension impls, unresolvable selections,
# type-level const folds, fail-closed ABI surfaces) contributes "partial";
# the producers with no documented residual stamp "complete" (rows-or-
# known-empty); Call and TestReferences ride the always-present call/test
# tables and are "complete". "unavailable" is a builder-flag state: the
# builder itself never lacks a data source for these families, so only a
# hand-built/foreign snapshot sets it — the closure still honors it.

# TypeId.id -> the def's registered key ("path::name" — the def walk's
# registration key domain). Built from the context's type_id_of_key once
# per producer.
def snapshot_type_key_reverse(ctx: SnapshotBuildCtx) -> Map[Int, String]
  var m: Map[Int, String] = Map::new()
  for entry in ctx.type_id_of_key.entries() do
    m.insert(entry.1, entry.0.clone())
  end
  m
end

# Def registration key -> the def's full stable key text.
def snapshot_def_stable_key_map(defs: Vec[SnapshotDef]) -> Map[String, String]
  var m: Map[String, String] = Map::new()
  for d in defs do
    m.insert(d.key.clone(), d.sid.key.clone())
  end
  m
end

# The stable key of a TypeId ("", when the TypeId has no registered def —
# a primitive/builtin type is never a change key of this snapshot).
def snapshot_resolve_type_key(
  key_of_type_id: Map[Int, String],
  stable_of_reg: Map[String, String],
  tid: Int
) -> String
  match key_of_type_id.get(tid)
  when Option::Some(reg) then
    match stable_of_reg.get(reg.clone())
    when Option::Some(k) then k.clone()
    when Option::None then ""
    end
  when Option::None then ""
  end
end

# The registered nominal TypeIds a Type references, recursively (via type
# arguments and by-value composites). Deduped; order is first-seen.
def snapshot_collect_nominal_refs(ty: Type, inout out: Vec[Int]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    if !out.contains(&tid.id) then out.push(tid.id) end
    for a in args do snapshot_collect_nominal_refs(&a, &mut out) end
  when Type::FixedArray(elem, _) then snapshot_collect_nominal_refs(&elem, &mut out)
  when Type::FixedArraySym(elem2, _) then snapshot_collect_nominal_refs(&elem2, &mut out)
  when Type::FnPtr(params, ret, _) then
    for p in params do snapshot_collect_nominal_refs(&p.ty, &mut out) end
    snapshot_collect_nominal_refs(&ret, &mut out)
  when Type::Closure(_, params2, ret2, captures, _) then
    for p2 in params2 do snapshot_collect_nominal_refs(&p2.ty, &mut out) end
    snapshot_collect_nominal_refs(&ret2, &mut out)
    snapshot_collect_nominal_refs(&captures, &mut out)
  when Type::RefInternal(inner, _) then snapshot_collect_nominal_refs(&inner, &mut out)
  when Type::Ptr(inner2) then snapshot_collect_nominal_refs(&inner2, &mut out)
  when Type::PtrMut(inner3) then snapshot_collect_nominal_refs(&inner3, &mut out)
  when Type::Effect(_, inner4) then snapshot_collect_nominal_refs(&inner4, &mut out)
  when Type::Dyn(tid2) then
    if !out.contains(&tid2.id) then out.push(tid2.id) end
  when Type::Tuple(elems) then
    for e in elems do snapshot_collect_nominal_refs(&e, &mut out) end
  when _ then ()
  end
  ()
end

# The typed types a registered nominal type USES: struct fields, enum
# variant fields, trait method signature types and alias inner type.
def snapshot_type_id_use_types(ctx: SnapshotBuildCtx, tid: Int) -> Vec[Type]
  var out: Vec[Type] = Vec::new()
  match ctx.type_list_index.get(tid)
  when Option::Some(idx) then
    if idx >= 0 && idx < ctx.env.type_list.len() then
      match ctx.env.type_list[idx].def_kind
      when TypeDefKind::Struct(fields) then
        for f in fields do out.push(f.ty.clone()) end
      when TypeDefKind::Enum(variants) then
        for v in variants do
          for f2 in v.fields do out.push(f2.clone()) end
        end
      when TypeDefKind::Trait(methods) then
        for m in methods do
          for p in m.params do out.push(p.ty.clone()) end
          out.push(m.ret_type.clone())
        end
      when TypeDefKind::Alias(inner) then out.push(inner.clone())
      when _ then ()
      end
    end
  when Option::None then ()
  end
  out
end

# The typed types a def USES: its signature types for Function/Method
# (typed FnSignature first, the def-keyed MIR lowering second), its
# declared type for Static/Constant, and its typed shapes for
# TypeName/Trait.
def snapshot_def_use_types(ctx: SnapshotBuildCtx, d: SnapshotDef) -> Vec[Type]
  var out: Vec[Type] = Vec::new()
  match d.kind
  when DefKind::Function then
    let numeric = snapshot_numeric_of_def(ctx, &d)
    let did = snapshot_def_of_numeric(ctx, numeric)
    match snapshot_typed_fn_signature(ctx, &did)
    when Option::Some(sig) then
      for p in sig.params do out.push(p.ty.clone()) end
      out.push(sig.ret_type.clone())
    when Option::None then
      match ctx.mir_fn_by_callable.get(numeric)
      when Option::Some(idx) then
        if idx >= 0 && idx < ctx.mir.functions.len() then
          let mf = ctx.mir.functions[idx]
          for p2 in mf.params do out.push(p2.ty.clone()) end
          out.push(mf.ret_type.clone())
        end
      when Option::None then ()
      end
    end
  when DefKind::Method then
    let numeric2 = snapshot_numeric_of_def(ctx, &d)
    let did2 = snapshot_def_of_numeric(ctx, numeric2)
    match snapshot_typed_fn_signature(ctx, &did2)
    when Option::Some(sig2) then
      for p3 in sig2.params do out.push(p3.ty.clone()) end
      out.push(sig2.ret_type.clone())
    when Option::None then
      match ctx.mir_fn_by_callable.get(numeric2)
      when Option::Some(idx2) then
        if idx2 >= 0 && idx2 < ctx.mir.functions.len() then
          let mf2 = ctx.mir.functions[idx2]
          for p4 in mf2.params do out.push(p4.ty.clone()) end
          out.push(mf2.ret_type.clone())
        end
      when Option::None then ()
      end
    end
  when DefKind::Static then
    match ctx.typed.typed_static_types.get(d.key.clone())
    when Option::Some(ty) then out.push(ty.clone())
    when Option::None then ()
    end
  when DefKind::Constant then
    match ctx.typed.typed_static_types.get(d.key.clone())
    when Option::Some(ty2) then out.push(ty2.clone())
    when Option::None then ()
    end
  when DefKind::TypeName then
    match ctx.type_id_of_key.get(d.key.clone())
    when Option::Some(tid) then
      for ty3 in snapshot_type_id_use_types(ctx, tid) do out.push(ty3) end
    when Option::None then ()
    end
  when DefKind::Trait then
    match ctx.type_id_of_key.get(d.key.clone())
    when Option::Some(tid2) then
      for ty4 in snapshot_type_id_use_types(ctx, tid2) do out.push(ty4) end
    when Option::None then ()
    end
  when _ then ()
  end
  out
end

# ———— TypeUse ————
def snapshot_type_use_edges(ctx: SnapshotBuildCtx, defs: Vec[SnapshotDef]) -> Vec[TypeUseEdge]
  var out: Vec[TypeUseEdge] = Vec::new()
  let key_of_type_id = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(&defs)
  var seen: Set[String] = Set::new()
  for d in defs do
    let user = d.sid.key.clone()
    for ty in snapshot_def_use_types(&ctx, &d) do
      var tids: Vec[Int] = Vec::new()
      snapshot_collect_nominal_refs(&ty, &mut tids)
      for tid in tids do
        let used = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, tid)
        if used.len() > 0 then
          let dedupe = user.clone() + "|" + used.clone()
          if !seen.contains(&dedupe) then
            seen.insert(dedupe.clone())
            out.push(TypeUseEdge { user: user.clone(), used_type: used })
          end
        end
      end
    end
  end
  out
end

# ———— ContainsType / LayoutDependent ————
# The nominal refs a BY-VALUE position contributes to a layout: Adt and its
# inline composites (fixed arrays, tuples, closure captures) recurse; an
# indirection (Ptr/PtrMut/RefInternal/Dyn/FnPtr) terminates the walk — a
# pointee never changes the pointer's layout. A type ARGUMENT of an Adt
# field is included (a conservative over-approximation for pointer-like
# containers such as Vec — the safe direction, documented).
def snapshot_collect_layout_refs(ty: Type, inout out: Vec[Int]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    if !out.contains(&tid.id) then out.push(tid.id) end
    for a in args do snapshot_collect_layout_refs(&a, &mut out) end
  when Type::FixedArray(elem, _) then snapshot_collect_layout_refs(&elem, &mut out)
  when Type::FixedArraySym(elem2, _) then snapshot_collect_layout_refs(&elem2, &mut out)
  when Type::Tuple(elems) then
    for e in elems do snapshot_collect_layout_refs(&e, &mut out) end
  when Type::Closure(_, _, _, captures, _) then
    snapshot_collect_layout_refs(&captures, &mut out)
  when _ then ()
  end
  ()
end

# The typed containment edges: a nominal type's field/variant shapes'
# by-value nominal references. dependent_type = the container's stable key,
# source_type = the contained type's stable key.
def snapshot_layout_dependency_edges(ctx: SnapshotBuildCtx, defs: Vec[SnapshotDef]) -> Vec[LayoutDependencyEdge]
  var out: Vec[LayoutDependencyEdge] = Vec::new()
  let key_of_type_id = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(&defs)
  var seen: Set[String] = Set::new()
  for d in defs do
    var is_nominal = false
    match d.kind
    when DefKind::TypeName then is_nominal = true
    when DefKind::Trait then is_nominal = true
    when _ then ()
    end
    if !is_nominal then next end
    let dependent = d.sid.key.clone()
    for ty in snapshot_def_use_types(&ctx, &d) do
      var tids: Vec[Int] = Vec::new()
      snapshot_collect_layout_refs(&ty, &mut tids)
      for tid in tids do
        let source = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, tid)
        if source.len() > 0 then
          let dedupe = dependent.clone() + "|" + source.clone()
          if !seen.contains(&dedupe) then
            seen.insert(dedupe.clone())
            out.push(LayoutDependencyEdge { dependent_type: dependent.clone(), source_type: source })
          end
        end
      end
    end
  end
  out
end

# ———— TraitImpl / TraitSelection ————
def snapshot_trait_impl_edges(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  def_row_of_numeric: Map[Int, Int]
) -> (Vec[TraitImplEdge], Vec[TraitSelectionEdge])
  var impls: Vec[TraitImplEdge] = Vec::new()
  var sels: Vec[TraitSelectionEdge] = Vec::new()
  let key_of_type_id = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(&defs)
  var seen_impls: Set[String] = Set::new()
  var seen_sels: Set[String] = Set::new()
  for imp in ctx.env.impls do
    if imp.trait_id.id < 0 then next end
    let trait_key = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, imp.trait_id.id)
    if trait_key.len() == 0 then next end
    var self_tid = -1
    match imp.for_type
    when Type::Adt(tid, _) then self_tid = tid.id
    when _ then ()
    end
    if self_tid < 0 then next end
    let self_key = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, self_tid)
    if self_key.len() == 0 then next end
    let impl_key = "impl::" + self_key.clone() + "|as|" + trait_key.clone()
    if !seen_impls.contains(&impl_key) then
      seen_impls.insert(impl_key.clone())
      impls.push(TraitImplEdge { impl_key: impl_key.clone(), trait_key: trait_key.clone(), self_type: self_key.clone() })
    end
    # The impl method's def key: the checker's OWN method resolution
    # (types.tg method_def_for — the qualified "path::Type::method"
    # registration plus the 0/1 qualified scan) over the impl's typed
    # for_type, then the def row's stable key. A method the registration
    # cannot disambiguate (0 or >1 candidates — the resolver's explicit
    # rule) is omitted: no selection edge is invented (documented).
    for m in imp.methods do
      match method_def_for(&ctx.env, imp.for_type.clone(), m.name.clone())
      when Option::Some(mdid) then
        match def_row_of_numeric.get(def_id_numeric(&mdid))
        when Option::Some(mrow) then
          if mrow >= 0 && mrow < defs.len() then
            let mkey = defs[mrow].sid.key.clone()
            let dedupe = mkey.clone() + "|" + trait_key.clone() + "|" + impl_key.clone()
            if !seen_sels.contains(&dedupe) then
              seen_sels.insert(dedupe.clone())
              sels.push(TraitSelectionEdge { function: mkey.clone(), trait_key: trait_key.clone(), impl_key: impl_key.clone() })
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  end
  (impls, sels)
end

# ———— GenericInstantiation ————
def snapshot_generic_instantiation_edges(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  def_row_of_numeric: Map[Int, Int],
  calls: Vec[SnapshotCallSite]
) -> Vec[GenericInstantiationEdge]
  var out: Vec[GenericInstantiationEdge] = Vec::new()
  var seen: Set[String] = Set::new()
  for cs in calls do
    if cs.callee_instance.len() == 0 then next end
    if cs.callee_instance_args == 0 then next end
    match def_row_of_numeric.get(cs.callee_numeric)
    when Option::Some(row) then
      if row >= 0 && row < defs.len() then
        let inst = "instance::" + cs.callee_instance.clone()
        let template = defs[row].sid.key.clone()
        let dedupe = inst.clone() + "|" + template.clone()
        if !seen.contains(&dedupe) then
          seen.insert(dedupe.clone())
          out.push(GenericInstantiationEdge { instance_key: inst, template: template })
        end
      end
    when Option::None then ()
    end
  end
  out
end

# ———— ConstEvalDependency ————
def snapshot_const_ref_operand(op: MirOperand, inout out: Vec[Int]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cv) then
    match cv.kind
    when MirConstantKind::MirStaticRef(did) then
      let n = def_id_numeric(&did)
      if !out.contains(&n) then out.push(n) end
    when MirConstantKind::MirStaticAddr(did2) then
      let n2 = def_id_numeric(&did2)
      if !out.contains(&n2) then out.push(n2) end
    when _ then ()
    end
  when _ then ()
  end
  ()
end

def snapshot_const_ref_rvalue(rv: MirRvalue, inout out: Vec[Int]) -> Unit
  match rv.kind
  when MirRvalueKind::MirMove(op) then snapshot_const_ref_operand(&op, &mut out)
  when MirRvalueKind::MirAggregate(_, ops) then
    for op2 in ops do snapshot_const_ref_operand(&op2, &mut out) end
  when MirRvalueKind::MirBinOp(_, a, b) then
    snapshot_const_ref_operand(&a, &mut out)
    snapshot_const_ref_operand(&b, &mut out)
  when MirRvalueKind::MirUnOp(_, a2) then snapshot_const_ref_operand(&a2, &mut out)
  when MirRvalueKind::MirCast(_, op3, _) then snapshot_const_ref_operand(&op3, &mut out)
  when _ then ()
  end
  ()
end

def snapshot_const_ref_terminator(t: MirTerminator, inout out: Vec[Int]) -> Unit
  match t.kind
  when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
    snapshot_const_ref_operand(&op, &mut out)
  when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
    snapshot_const_ref_operand(&func, &mut out)
    for arg in args do
      match arg.value
      when MirCallValue::Value(v) then snapshot_const_ref_operand(&v, &mut out)
      when MirCallValue::Place(_) then ()
      end
    end
  when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
    snapshot_const_ref_operand(&cond, &mut out)
    match msg
    when AssertMessage::BoundsCheck(a, b) then
      snapshot_const_ref_operand(&a, &mut out)
      snapshot_const_ref_operand(&b, &mut out)
    when _ then ()
    end
  when _ then ()
  end
  ()
end

# dependent (the lowering's mir origin key) -> referenced const def key.
def snapshot_const_eval_edges(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  def_row_of_numeric: Map[Int, Int],
  mir_program: MirProgram,
  origin_key_of_name: Map[String, String]
) -> Vec[ConstEvalDependencyEdge]
  var out: Vec[ConstEvalDependencyEdge] = Vec::new()
  var seen: Set[String] = Set::new()
  for f in mir_program.functions do
    var refs: Vec[Int] = Vec::new()
    for block in f.blocks do
      for st in block.statements do
        match st.kind
        when MirStatementKind::MirAssign(_, rv) then snapshot_const_ref_rvalue(&rv, &mut refs)
        when MirStatementKind::MirContractCheck(_, cop) then snapshot_const_ref_operand(&cop, &mut refs)
        when MirStatementKind::MirEffectRecord(_, eop) then snapshot_const_ref_operand(&eop, &mut refs)
        when MirStatementKind::MirEffectPerform(_, _, _, pop, rop) then
          snapshot_const_ref_operand(&pop, &mut refs)
          snapshot_const_ref_operand(&rop, &mut refs)
        when MirStatementKind::MirEffectFrameEnter(_, _, _, _, envop) then
          snapshot_const_ref_operand(&envop, &mut refs)
        when _ then ()
        end
      end
      snapshot_const_ref_terminator(&block.terminator, &mut refs)
    end
    if refs.len() == 0 then next end
    var dependent = "".to_string()
    match origin_key_of_name.get(f.name.clone())
    when Option::Some(ok) then dependent = ok.clone()
    when Option::None then ()
    end
    if dependent.len() == 0 then next end
    for n in refs do
      match def_row_of_numeric.get(n)
      when Option::Some(row) then
        if row >= 0 && row < defs.len() then
          let referenced = defs[row].sid.key.clone()
          let dedupe = dependent.clone() + "|" + referenced.clone()
          if !seen.contains(&dedupe) then
            seen.insert(dedupe.clone())
            out.push(ConstEvalDependencyEdge { dependent: dependent.clone(), referenced_const: referenced })
          end
        end
      when Option::None then ()
      end
    end
  end
  out
end

# ———— DerivedBody ————
def snapshot_derived_body_edges(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  def_row_of_numeric: Map[Int, Int],
  mir_program: MirProgram
) -> Vec[DerivedBodyEdge]
  var out: Vec[DerivedBodyEdge] = Vec::new()
  let key_of_type_id = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(&defs)
  var seen: Set[String] = Set::new()
  for f in mir_program.functions do
    match snapshot_mir_origin_of(&ctx, &f, &defs, &def_row_of_numeric)
    when Result::Err(_) then ()
    when Result::Ok(origin) then
      match origin
      when MirOrigin::Derived(_, _) then
        let derived_key = snapshot_origin_key_text(&origin)
        var tids: Vec[Int] = Vec::new()
        for p in f.params do snapshot_collect_nominal_refs(&p.ty, &mut tids) end
        snapshot_collect_nominal_refs(&f.ret_type, &mut tids)
        for l in f.locals do snapshot_collect_nominal_refs(&l.ty, &mut tids) end
        for tid in tids do
          let source = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, tid)
          if source.len() > 0 then
            let dedupe = derived_key.clone() + "|" + source.clone()
            if !seen.contains(&dedupe) then
              seen.insert(dedupe.clone())
              out.push(DerivedBodyEdge { derived_key: derived_key.clone(), source_type: source })
            end
          end
        end
      when _ then ()
      end
    end
  end
  out
end

# ———— ContractReference ————
def snapshot_contract_reference_edges(rows: Vec[ContractFact]) -> Vec[ContractReferenceEdge]
  var out: Vec[ContractReferenceEdge] = Vec::new()
  var seen: Set[String] = Set::new()
  for cr in rows do
    for ref_key in cr.canonical_expression.resolved_refs do
      let dedupe = cr.id.stable_key.clone() + "|" + ref_key.clone()
      if !seen.contains(&dedupe) then
        seen.insert(dedupe.clone())
        out.push(ContractReferenceEdge { contract_id: cr.id.stable_key.clone(), referenced_symbol: ref_key.clone() })
      end
    end
  end
  out
end

# ———— AbiDependency ————
def snapshot_abi_dependency_edges(
  ctx: SnapshotBuildCtx,
  surfaces: Vec[AbiSurfaceRow],
  defs: Vec[SnapshotDef]
) -> Vec[AbiDependencyEdge]
  var out: Vec[AbiDependencyEdge] = Vec::new()
  let key_of_type_id = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(&defs)
  var def_row_of_key: Map[String, Int] = Map::new()
  var di = 0
  while di < defs.len() do
    def_row_of_key.insert(defs[di].sid.key.clone(), di)
    di = di + 1
  end
  var seen: Set[String] = Set::new()
  for s in surfaces do
    var tids: Vec[Int] = Vec::new()
    match s.kind
    when "fn" then
      match def_row_of_key.get(s.symbol_key.clone())
      when Option::Some(row) then
        for ty in snapshot_def_use_types(&ctx, &defs[row]) do
          snapshot_collect_nominal_refs(&ty, &mut tids)
        end
      when Option::None then ()
      end
    when "type" then
      match ctx.type_id_of_key.get(snapshot_key_path(&s.symbol_key))
      when Option::Some(tid) then
        for ty2 in snapshot_type_id_use_types(&ctx, tid) do
          snapshot_collect_nominal_refs(&ty2, &mut tids)
        end
      when Option::None then ()
      end
    when _ then ()
    end
    for tid2 in tids do
      let type_key = snapshot_resolve_type_key(&key_of_type_id, &stable_of_reg, tid2)
      if type_key.len() > 0 then
        let dedupe = s.surface_id.clone() + "|" + type_key.clone()
        if !seen.contains(&dedupe) then
          seen.insert(dedupe.clone())
          out.push(AbiDependencyEdge { surface_id: s.surface_id.clone(), type_key: type_key })
        end
      end
    end
  end
  out
end

# ———— the per-family producer-status table (fourth-audit P0-9) ————
# The completeness record the builder persists with the dependency graph:
# one entry per relation family. Anchors (the producer notes above):
#   Call             — the call rows (item 10 call-site resolution) are
#                      always emitted from the resolved call sites: rows
#                      may be empty only when the program has no calls.
#   TestReferences   — the test rows (item 19) are always emitted from the
#                      same resolution; a test with no lowered body has no
#                      call site and therefore no target (the model's
#                      target-mandatory record — documented at the test-row
#                      builder), which is known-empty, not unknown.
#   TypeUse          — resolved signatures / MIR fallback: rows-or-known-
#                      empty for every def the walk sees.
#   TraitImpl        — extension impls (for_type = Param) have no stable
#                      self identity and are omitted (documented at the
#                      producer): PARTIAL.
#   TraitSelection   — a method the checker's registration cannot resolve
#                      or disambiguate is omitted (documented at the
#                      producer): PARTIAL.
#   GenericInstantiation — solved InstanceId payloads: known-empty for a
#                      non-generic call.
#   LayoutDependency — typed field/variant shapes: known-empty (an
#                      indirection is not a layout edge by definition).
#   ConstEvalDependency — MIR MirStaticRef operands are complete, but a
#                      type-level const-argument expression is folded at
#                      check time and leaves no MIR operand (the
#                      documented RESIDUAL): PARTIAL.
#   DerivedBody      — MirOrigin::Derived lowerings: known-empty.
#   ContractReference — clause resolved_refs: known-empty.
#   AbiDependency    — typed surface references; a fail-closed surface row
#                      carries no typed references (documented at the
#                      producer), so its type consumers are unknown:
#                      PARTIAL.
def snapshot_dependency_completeness() -> Map[String, String]
  var m: Map[String, String] = Map::new()
  m.insert("Call".to_string(), "complete".to_string())
  m.insert("TestReferences".to_string(), "complete".to_string())
  m.insert("TypeUse".to_string(), "complete".to_string())
  m.insert("TraitImpl".to_string(), "partial".to_string())
  m.insert("TraitSelection".to_string(), "partial".to_string())
  m.insert("GenericInstantiation".to_string(), "complete".to_string())
  m.insert("LayoutDependency".to_string(), "complete".to_string())
  m.insert("ConstEvalDependency".to_string(), "partial".to_string())
  m.insert("DerivedBody".to_string(), "complete".to_string())
  m.insert("ContractReference".to_string(), "complete".to_string())
  m.insert("AbiDependency".to_string(), "partial".to_string())
  m
end

# ———————————————————————————————————————————————————————————————
# The builder
# ———————————————————————————————————————————————————————————————

# ———— (fourth-audit P1-3) the typed member/signature table producers ————
# Every row below is read from TYPED finalized state — env.type_list's
# def_kind records (FieldInfo / VariantInfo / MethodSig) and the checker's
# typed FnSignature table — never from a canonical key render. member_id
# is the durable member-lineage identity text (the documented name-derived
# synthetic lineage: the persistent store-backed member stamping is the
# next source; see stable_ids.tg stable_member_*).
def snapshot_member_identity_text(owner: StableDefId, member_kind: String, name: String) -> String
  let decl = stable_decl_of_key(&owner.key)
  let lineage = stable_member_synthetic_lineage(decl.clone(), member_kind.clone(), name)
  stable_member_lineage_identity_text(decl, member_kind.clone(), lineage)
end

def snapshot_param_of_typed(p: ParamType, ctx: SnapshotBuildCtx) -> Option[SemanticParam]
  match snapshot_type_text(ctx, &p.ty)
  when Result::Err(_) then Option::None
  when Result::Ok(t) then Option::Some(SemanticParam {
    convention: p.convention,
    ty: t,
    name: ""
  })
  end
end

# The typed member rows of ONE nominal type declaration (the def loop
# calls this for every Struct / Enum / Trait row). A field/variant/method
# whose type text cannot be rendered through the registered-name authority
# is OMITTED (the documented hard-failure boundary of this data-only
# table; the type's canonical key still fails closed at its own render).
def snapshot_typed_member_rows(
  ctx: SnapshotBuildCtx,
  owner_sid: StableDefId,
  tid: Int,
  inout fields: Vec[SemanticField],
  inout variants: Vec[SemanticVariant],
  inout trait_methods: Vec[SemanticTraitMethod]
) -> Unit
  if tid < 0 then return end
  var idx = -1
  match ctx.type_list_index.get(tid)
  when Option::Some(i) then idx = i
  when Option::None then ()
  end
  if idx < 0 || idx >= ctx.env.type_list.len() then return end
  let td = ctx.env.type_list[idx]
  match td.def_kind
  when TypeDefKind::Struct(fs) then
    var fi = 0
    for f in fs do
      match snapshot_type_text(ctx, &f.ty)
      when Result::Ok(ft) then
        fields.push(SemanticField {
          owner: owner_sid.clone(),
          name: f.name.clone(),
          index: fi,
          ty: ft,
          member_id: snapshot_member_identity_text(owner_sid.clone(), "field".to_string(), f.name.clone()),
          is_pub: f.is_public
        })
      when Result::Err(_) then ()
      end
      fi = fi + 1
    end
  when TypeDefKind::Enum(vs) then
    var vi = 0
    for v in vs do
      var payload: Vec[SemanticParam] = Vec::new()
      for fty in v.fields do
        match snapshot_type_text(ctx, &fty)
        when Result::Ok(ft2) then payload.push(SemanticParam { convention: AccessConvention::Let, ty: ft2, name: "" })
        when Result::Err(_) then ()
        end
      end
      variants.push(SemanticVariant {
        owner: owner_sid.clone(),
        name: v.name.clone(),
        index: vi,
        payload: payload,
        member_id: snapshot_member_identity_text(owner_sid.clone(), "variant".to_string(), v.name.clone())
      })
      vi = vi + 1
    end
  when TypeDefKind::Trait(ms) then
    var mi = 0
    for m in ms do
      var params: Vec[SemanticParam] = Vec::new()
      for p in m.params do
        match snapshot_param_of_typed(p, &ctx)
        when Option::Some(sp) then params.push(sp)
        when Option::None then ()
        end
      end
      var ret = "".to_string()
      match snapshot_type_text(ctx, &m.ret_type)
      when Result::Ok(rt) then ret = rt
      when Result::Err(_) then ()
      end
      trait_methods.push(SemanticTraitMethod {
        owner: owner_sid.clone(),
        name: m.name.clone(),
        index: mi,
        params: params,
        ret_type: ret,
        member_id: snapshot_member_identity_text(owner_sid.clone(), "method".to_string(), m.name.clone())
      })
      mi = mi + 1
    end
  when _ then ()
  end
end

# The typed callable-signature rows: one per Function / Method def whose
# checker-recorded FnSignature exists. The declared effect-id set is the
# typed FnSignature.declared_effects (rendered as the canonical "e<id>"
# texts, sorted) — the typed content behind the key's "effects(...)"
# suffix; a def with no typed record emits no row (documented residual,
# never a render re-parse).
def snapshot_typed_signature_rows(ctx: SnapshotBuildCtx, defs: Vec[SnapshotDef]) -> Vec[SemanticCallableSignature]
  var out: Vec[SemanticCallableSignature] = Vec::new()
  for d in defs do
    var is_callable = false
    match d.kind
    when DefKind::Function then is_callable = true
    when DefKind::Method then is_callable = true
    when _ then ()
    end
    if is_callable then
      let numeric = snapshot_numeric_of_def(&ctx, &d)
      let did = snapshot_def_of_numeric(&ctx, numeric)
      match snapshot_typed_fn_signature(&ctx, &did)
      when Option::Some(sig) then
        var params: Vec[SemanticParam] = Vec::new()
        var resolvable = true
        for p in sig.params do
          match snapshot_param_of_typed(p, &ctx)
          when Option::Some(sp) then params.push(sp)
          when Option::None then resolvable = false
          end
        end
        match snapshot_type_text(&ctx, &sig.ret_type)
        when Result::Err(_) then resolvable = false
        when Result::Ok(rt) then
          if resolvable then
            var effects: Vec[String] = Vec::new()
            for eid in snapshot_effect_ids_sorted(&sig.declared_effects) do
              effects.push("e" + eid.to_string())
            end
            out.push(SemanticCallableSignature {
              function: d.sid,
              params: params,
              ret_type: rt,
              declared_effects: effects,
              variadic: sig.variadic
            })
          end
        end
      when Option::None then ()
      end
    end
  end
  out
end

# ———— (fourth-audit P1-5b) the concrete type-instance table ————
# One row per concrete substitution-bearing Type::Adt(tid, args) the
# builder's canonical instance sources reach (typed expression types, the
# solved call substitutions, the MIR function/static/type shapes). The
# mono cache's own concrete tables (MonoCache.instances /
# drop_glue_types) are NOT on the builder's inputs; the layout engine's
# per-ConcreteTypeKey records are per-compilation (TypeId-keyed) and
# cannot be re-keyed here — the exact future source is threading either
# the MirBuilder's drop_glue_types Vec[Type] onto MirProgram or a
# `Vec[Type]` concrete-instance table beside it. Until then the
# reachability boundary is the row's layout_status ("unavailable" keeps
# the identity without fabricating a layout).
def snapshot_collect_concrete_adts(ty: Type, inout out: Vec[Type]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    if args.len() > 0 then
      out.push(Type::Adt(tid.clone(), args.clone()))
    end
    for a in args do
      snapshot_collect_concrete_adts(a.clone(), &mut out)
    end
  when Type::FixedArray(elem, _) then snapshot_collect_concrete_adts(elem.clone(), &mut out)
  when Type::FixedArraySym(elem, _) then snapshot_collect_concrete_adts(elem.clone(), &mut out)
  when Type::FnPtr(params, ret, _) then
    for p in params do
      snapshot_collect_concrete_adts(p.ty.clone(), &mut out)
    end
    snapshot_collect_concrete_adts(ret.clone(), &mut out)
  when Type::Closure(_, params, ret, captures, _) then
    for p in params do
      snapshot_collect_concrete_adts(p.ty.clone(), &mut out)
    end
    snapshot_collect_concrete_adts(ret.clone(), &mut out)
    snapshot_collect_concrete_adts(captures.clone(), &mut out)
  when Type::RefInternal(inner, _) then snapshot_collect_concrete_adts(inner.clone(), &mut out)
  when Type::Ptr(inner) then snapshot_collect_concrete_adts(inner.clone(), &mut out)
  when Type::PtrMut(inner) then snapshot_collect_concrete_adts(inner.clone(), &mut out)
  when Type::Effect(_, inner) then snapshot_collect_concrete_adts(inner.clone(), &mut out)
  when Type::Tuple(elems) then
    for e in elems do
      snapshot_collect_concrete_adts(e.clone(), &mut out)
    end
  when _ then ()
  end
end

pub def snapshot_concrete_type_rows(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  target: TargetDesc
) -> Vec[SemanticConcreteType]
  var found: Vec[Type] = Vec::new()
  # Source 1: the typed expression table (the checker's resolved types).
  for entry in ctx.typed.expr_types.entries() do
    snapshot_collect_concrete_adts(entry.1.clone(), &mut found)
  end
  # Source 2: the solved call substitutions.
  for entry2 in ctx.typed.call_instances.entries() do
    for t in entry2.1 do
      snapshot_collect_concrete_adts(t.clone(), &mut found)
    end
  end
  # Source 3: the MIR shapes (function params/returns/locals, statics,
  # declared type defs).
  for f in ctx.mir.functions do
    snapshot_collect_concrete_adts(f.ret_type.clone(), &mut found)
    for p in f.params do
      snapshot_collect_concrete_adts(p.ty.clone(), &mut found)
    end
    for l in f.locals do
      snapshot_collect_concrete_adts(l.ty.clone(), &mut found)
    end
  end
  for s in ctx.mir.statics do
    snapshot_collect_concrete_adts(s.ty.clone(), &mut found)
  end
  for td in ctx.mir.types do
    match td.kind
    when MirTypeDefKind::Struct(fs) then
      for f2 in fs do
        snapshot_collect_concrete_adts(f2.ty.clone(), &mut found)
      end
    when MirTypeDefKind::Enum(vs) then
      for v in vs do
        for fty in v.fields do
          snapshot_collect_concrete_adts(fty.clone(), &mut found)
        end
      end
    end
  end
  # The type registration key -> full stable key join.
  let key_of_type = snapshot_type_key_reverse(&ctx)
  let stable_of_reg = snapshot_def_stable_key_map(defs)
  var engine = snapshot_abi_layout_engine(&ctx.mir, &target)
  var out: Vec[SemanticConcreteType] = Vec::new()
  var seen: Set[String] = Set::new()
  for ty in found do
    match ty
    when Type::Adt(tid, args) then
      var reg = "".to_string()
      match key_of_type.get(tid.id)
      when Option::Some(r) then reg = r
      when Option::None then ()
      end
      if reg.len() > 0 then
        var template = "".to_string()
        match stable_of_reg.get(reg.clone())
        when Option::Some(full) then template = full
        when Option::None then ()
        end
        if template.len() > 0 then
          var arg_texts: Vec[String] = Vec::new()
          var args_ok = true
          for a in args do
            match snapshot_type_text(&ctx, &a)
            when Result::Ok(at) then arg_texts.push(at)
            when Result::Err(_) then args_ok = false
            end
          end
          if args_ok then
            let instance_key = template.clone() + "<" + arg_texts.join(",") + ">"
            if !seen.contains(&instance_key) then
              seen.insert(instance_key.clone())
              let cty = Type::Adt(tid.clone(), args.clone())
              var size = -1
              var align = -1
              var field_rows: Vec[String] = Vec::new()
              var status = "unavailable".to_string()
              match layout_of_concrete(&mut engine, &cty)
              when Result::Ok(layout) then
                size = layout.size
                align = layout.align
                for lf in layout.fields do
                  field_rows.push(lf.name.clone() + " " + lf.offset.to_string() + " " + lf.size.to_string())
                end
                status = "ok"
              when Result::Err(e) then
                status = "layout-fail:" + snapshot_abi_layout_failure_word(&e.class)
              end
              out.push(SemanticConcreteType {
                instance_key: instance_key,
                template: template,
                args: arg_texts,
                size: size,
                alignment: align,
                fields: field_rows,
                layout_status: status
              })
            end
          end
        end
      end
    when _ then ()
    end
  end
  semantic_concrete_types_sort(&mut out)
  out
end

# ———— (fourth-audit P1-5c) the allocation-site table ————
# One row per allocating MIR node, mirroring the @budget static
# allocation-site analysis's direct-site walk (mir.tg
# mir_budget_alloc_sites_of) and its classification vocabulary:
#   * string-concat MirAssign and MirEffectPerform statements -> Unbounded;
#   * an allocating call whose classification edge is IN-PROGRAM (the
#     callee's own sites are counted there) -> no direct row;
#   * an allocating intrinsic / seeded-extern / bodyless site -> UpperBound
#     charged BUDGET_ALLOC_SITE_BYTES, except ArrayWithCapacity with a
#     constant capacity literal -> Exact(n);
#   * a fail-closed unknown/indirect site -> Unknown.
# The owner text is the body's mir row key (origin_key_of_name), so the
# rows join the mir_functions/effect tables.
def snapshot_alloc_is_constant_capacity(args: Vec[MirCallArg]) -> Option[Int]
  if args.len() == 0 then
    return Option::None
  end
  match args[0].value
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirConstant(c) then
      match c.kind
      when MirConstantKind::MirInt(n) then Option::Some(n)
      when _ then Option::None
      end
    when _ then Option::None
    end
  when MirCallValue::Place(_) then Option::None
  end
end

pub def snapshot_allocation_sites(
  ctx: SnapshotBuildCtx,
  origin_key_of_name: Map[String, String],
  mir: MirProgram
) -> Vec[SemanticAllocationSite]
  var out: Vec[SemanticAllocationSite] = Vec::new()
  var fn_index: Map[String, Int] = Map::new()
  var fi = 0
  while fi < mir.functions.len() do
    let fname = mir.functions[fi].name.clone()
    if !fn_index.contains_key(&fname) then
      fn_index.insert(fname, fi)
    end
    fi = fi + 1
  end
  var type_index: Map[Int, String] = Map::new()
  for td in mir.types do
    type_index.insert(td.id.id, td.name.clone())
  end
  for f in mir.functions do
    var owner = "".to_string()
    match origin_key_of_name.get(f.name.clone())
    when Option::Some(k) then owner = k
    when Option::None then ()
    end
    if owner.len() > 0 then
      var bi = 0
      while bi < f.blocks.len() do
        let block = f.blocks[bi]
        var si = 0
        while si < block.statements.len() do
          let st = block.statements[si]
          var alloc_stmt = false
          match st.kind
          when MirStatementKind::MirAssign(dest, rvalue) then
            match rvalue.kind
            when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
              let dest_str = mir_effect_type_is_string_like(&mir_effect_place_type(&f, &dest))
              let lhs_str = mir_effect_operand_is_string(&f, &lhs)
              let rhs_str = mir_effect_operand_is_string(&f, &rhs)
              if dest_str || lhs_str || rhs_str then alloc_stmt = true end
            when _ then ()
            end
          when MirStatementKind::MirEffectPerform(_, _, _, _, _) then
            alloc_stmt = true
          when _ then ()
          end
          if alloc_stmt then
            out.push(SemanticAllocationSite {
              function: owner.clone(),
              site: owner.clone() + "#B" + block.id.id.to_string() + "#S" + si.to_string(),
              size_kind: SemanticAllocationSizeKind::Unbounded,
              size: -1
            })
          end
          si = si + 1
        end
        match block.terminator.kind
        when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
          let cc = mir_effect_classify_call(&mir, &f, &type_index, &fn_index, &func, &args, intrinsic.clone())
          if cc.summary.may_allocate && cc.callee.len() == 0 then
            var kind = SemanticAllocationSizeKind::UpperBound
            var size = BUDGET_ALLOC_SITE_BYTES
            match intrinsic.clone()
            when Option::Some(iid) then
              if iid == IntrinsicId::ArrayWithCapacity then
                match snapshot_alloc_is_constant_capacity(args.clone())
                when Option::Some(n) then
                  kind = SemanticAllocationSizeKind::Exact
                  size = n
                when Option::None then ()
                end
              end
            when Option::None then
              var known_callee = false
              match func.kind
              when MirOperandKind::MirConstant(c) then
                match c.kind
                when MirConstantKind::MirFnItem(_) then known_callee = true
                when _ then ()
                end
              when _ then ()
              end
              if !known_callee then
                kind = SemanticAllocationSizeKind::Unknown
                size = -1
              end
            end
            out.push(SemanticAllocationSite {
              function: owner.clone(),
              site: owner.clone() + "#B" + block.id.id.to_string() + "#T",
              size_kind: kind,
              size: size
            })
          end
        when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
          let cc2 = mir_effect_classify_deinit(&mir, &fn_index, &deinit_fn)
          if cc2.summary.may_allocate && cc2.callee.len() == 0 then
            out.push(SemanticAllocationSite {
              function: owner.clone(),
              site: owner.clone() + "#B" + block.id.id.to_string() + "#T",
              size_kind: SemanticAllocationSizeKind::Unknown,
              size: -1
            })
          end
        when _ then ()
        end
        bi = bi + 1
      end
    end
  end
  semantic_allocation_sites_sort(&mut out)
  out
end

# The per-domain digest record (fourth-audit P1-5c): the three existing
# surface hashes mirrored plus one digest per new table's canonical sorted
# row text and the header feature/option carrier.
pub def semantic_snapshot_domain_digests(snapshot: SemanticSnapshot) -> SemanticDomainDigests
  var concrete_text = ""
  var concrete_rows = snapshot.concrete_types.clone()
  semantic_concrete_types_sort(&mut concrete_rows)
  for c in concrete_rows do
    concrete_text = concrete_text + semantic_concrete_type_text(&c) + "\n"
  end
  var alloc_text = ""
  var alloc_rows = snapshot.allocation_sites.clone()
  semantic_allocation_sites_sort(&mut alloc_rows)
  for a in alloc_rows do
    alloc_text = alloc_text + semantic_allocation_site_text(&a) + "\n"
  end
  var drop_text = ""
  var drop_rows = snapshot.drop_plans.clone()
  semantic_drop_plans_sort(&mut drop_rows)
  for d in drop_rows do
    drop_text = drop_text + semantic_drop_plan_fact_text(&d) + "\n"
  end
  let feature_text = semantic_snapshot_header_features_text(&semantic_snapshot_header(&snapshot))
  SemanticDomainDigests {
    public_api: snapshot.public_api_hash,
    abi: snapshot.abi_hash,
    unsafe_: snapshot.unsafe_hash,
    concrete_types: stable_digest_of(&concrete_text),
    drop_plans: stable_digest_of(&drop_text),
    allocation_sites: stable_digest_of(&alloc_text),
    features: stable_digest_of(&feature_text)
  }
end


# The one entry point: build the SemanticSnapshot of a finalized
# compilation. compiler_version is the producing compiler's version.tg
# VERSION text; target is the compilation's REAL TargetDesc record (its
# StableTargetId is built and digested here — item 9). revision is stored
# as given (pass semantic_digest_zero() and run semantic_snapshot_finalize
# to self-address the artifact); the three surface hashes are always
# computed. Result-typed (item 8): any renderer that would degrade a
# semantic identity to a per-compilation id fails the snapshot with the
# SnapshotError variants.
#
# lineage_store (third-audit item 11) is the caller's persistent
# declaration-lineage store: the def walk stamps every declaration through
# it (an existing entry keeps its number, a unique rename rebind transfers
# one) and the caller persists the MUTATED store beside the artifact. The
# driver loads it from "<snapshot>.lineages" when present and passes a
# fresh empty store otherwise, so repeated route runs accumulate lineage
# history.
# (fourth-audit P0-17) The builder-boundary mapper: the resource checker's
# kernel-side facts -> the persisted SemanticSnapshot rows. Field-identical
# by construction; the sort is the model's canonical drop-plan order.
pub def snapshot_drop_plan_facts(resource_facts: Vec[ResourceDropPlanFact]) -> Vec[DropPlanFact]
  var out: Vec[DropPlanFact] = Vec::new()
  for f in resource_facts do
    out.push(DropPlanFact {
      function: f.function.clone(),
      place: f.place.clone(),
      drop_site: f.drop_site.clone(),
      conditional_paths: f.conditional_paths.clone(),
      kind: f.kind.clone()
    })
  end
  semantic_drop_plans_sort(&mut out)
  out
end

pub def semantic_snapshot_of_final_state(
  env: TypeEnv,
  typed: TypedProgram,
  mir_program: MirProgram,
  target: TargetDesc,
  compiler_version: String,
  revision: StableDigest,
  inout lineage_store: DeclLineageStore,
  # (fourth-audit P0-17) the resource checker's emitted drop-plan facts
  # (AnalyzedProgram.drop_plan_facts); defaulted empty so a caller that
  # has no resource run persists an empty drop-plan table.
  resource_drop_facts: Vec[ResourceDropPlanFact] = Vec::new(),
  # (fourth-audit P1-5a) the semantically relevant features/options in
  # effect (snapshot_feature_set_of / snapshot_semantic_options_of over
  # the REAL options record + target desc); defaulted empty so a caller
  # without an options record still builds (the header then carries no
  # feature rows — the parser reads them back as empty).
  feature_set: Vec[String] = Vec::new(),
  semantic_options: Vec[String] = Vec::new()
) -> Result[SemanticSnapshot, SnapshotError]
  let ctx = snapshot_build_ctx(env, typed, mir_program)
  let target_id = stable_target_id_of(&target)

  # 1. The def universe (stamped through the threaded lineage store).
  let defs = match snapshot_walk_defs(&ctx, lineage_store)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(d) then d
  end
  var def_row_of_numeric: Map[Int, Int] = Map::new()
  var di = 0
  while di < defs.len() do
    match ctx.numeric_of_key.get(defs[di].key.clone())
    when Option::Some(numeric) then def_row_of_numeric.insert(numeric, di)
    when Option::None then ()
    end
    di = di + 1
  end

  # (fourth-audit P1-3) The TYPED member/signature tables from the
  # finalized typed state (env.type_list def_kinds + typed FnSignatures).
  var typed_fields: Vec[SemanticField] = Vec::new()
  var typed_variants: Vec[SemanticVariant] = Vec::new()
  var typed_trait_methods: Vec[SemanticTraitMethod] = Vec::new()
  var def_i = 0
  while def_i < defs.len() do
    let d = defs[def_i]
    var is_nominal_kind = false
    match d.kind
    when DefKind::TypeName then is_nominal_kind = true
    when DefKind::Trait then is_nominal_kind = true
    when _ then ()
    end
    if is_nominal_kind then
      match ctx.type_id_of_key.get(d.key.clone())
      when Option::Some(tid) then
        snapshot_typed_member_rows(&ctx, d.sid, tid, &mut typed_fields, &mut typed_variants, &mut typed_trait_methods)
      when Option::None then ()
      end
    end
    def_i = def_i + 1
  end
  var typed_signatures = snapshot_typed_signature_rows(&ctx, &defs)

  # (fourth-audit P1-5b) The concrete type-instance table from the
  # canonical instance sources the builder reaches.
  var concrete_type_rows = snapshot_concrete_type_rows(&ctx, &defs, &target)

  # 2. The MIR walks (every lowered function — def-keyed and synthesized).
  var calls: Vec[SnapshotCallSite] = Vec::new()
  var indirect: Vec[SnapshotIndirectCall] = Vec::new()
  var ownership: Vec[SnapshotOwnership] = Vec::new()
  var scans: Map[String, SnapshotScan] = Map::new()
  var fn_i = 0
  while fn_i < mir_program.functions.len() do
    let f = mir_program.functions[fn_i]
    var caller_numeric = -1
    match f.callable.clone()
    when Option::Some(cid) then caller_numeric = def_id_numeric(&cid.def)
    when Option::None then ()
    end
    match snapshot_scan_function(&ctx, &f, caller_numeric, &mut calls, &mut indirect,
      &mut ownership, &mut scans)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(()) then ()
    end
    fn_i = fn_i + 1
  end
  let finals = snapshot_effect_finals(&ctx, &scans)

  # 3. The semantic tables.
  var symbols: Vec[SemanticSymbol] = Vec::new()
  var types: Vec[SemanticType] = Vec::new()
  var effect_rows: Vec[EffectEdge] = Vec::new()
  var capability_rows: Vec[CapabilityEdge] = Vec::new()
  var ownership_rows: Vec[OwnershipFact] = Vec::new()
  var contract_rows: Vec[ContractFact] = Vec::new()
  var mir_rows: Vec[MirSemanticSummary] = Vec::new()
  var indirect_rows: Vec[IndirectCallEdge] = Vec::new()
  var seen_contract_keys: Set[String] = Set::new()

  var di2 = 0
  while di2 < defs.len() do
    let d = defs[di2]
    let sid = d.sid
    symbols.push(SemanticSymbol {
      stable_id: sid,
      kind: d.kind,
      name: d.name.clone(),
      module_path: d.module_path.clone(),
      is_pub: d.is_pub,
      is_generic: d.is_generic
    })
    # The SemanticType rows: nominal Struct/Enum/Trait declarations only.
    var is_nominal_kind = false
    match d.kind
    when DefKind::TypeName then is_nominal_kind = true
    when DefKind::Trait then is_nominal_kind = true
    when _ then ()
    end
    if is_nominal_kind then
      match ctx.type_id_of_key.get(d.key.clone())
      when Option::Some(tid) then
        match snapshot_type_kind_of(&ctx, tid)
        when Option::Some(tk) then
          types.push(SemanticType {
            stable_id: sid,
            kind: tk,
            name: d.name.clone(),
            module_path: d.module_path.clone(),
            generic_arity: snapshot_type_generic_arity(&ctx, tid),
            is_pub: d.is_pub
          })
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
    # Contract facts (item 11): the def-table clauses in canonical form —
    # each row's identity is its StableContractId over
    # "<fn key>|Pre|Post|Invariant|<canonical clause text>"; the
    # expression fingerprint digests the canonical text; the message rides
    # as row content. Two clauses with the same canonical expression are
    # the SAME row whatever their messages or formatting.
    for c in d.contracts do
      let text = semantic_contract_expr_text(&c.ir)
      let ckey = stable_contract_row_key(d.sid.key.clone(), snapshot_contract_kind_word(&c.kind), text.clone())
      if !seen_contract_keys.contains(&ckey) then
        seen_contract_keys.insert(ckey.clone())
        let fp = stable_digest_of(&text)
        let idw = stable_digest_of(&ckey)
        # (third-audit item 18) resolve the clause's structurally collected
        # path references against the def universe ONCE, at row lowering:
        # the ContractReferenceEdge producer reads these resolved stable
        # keys, never the canonical clause text. A path that resolves to no
        # registered def cannot be a change key and stays out of the row
        # (documented).
        var resolved_refs: Vec[String] = Vec::new()
        for ref_text in c.ir.resolved_refs do
          match ctx.numeric_of_key.get(ref_text.clone())
          when Option::Some(ref_numeric) then
            match def_row_of_numeric.get(ref_numeric)
            when Option::Some(ref_row) then
              if ref_row >= 0 && ref_row < defs.len() then
                let ref_key = defs[ref_row].sid.key.clone()
                if !resolved_refs.contains(&ref_key) then
                  resolved_refs.push(ref_key)
                end
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
        end
        resolved_refs.sort_by(|x, y| x < y)
        var clause_ir = c.ir.clone()
        clause_ir.resolved_refs = resolved_refs
        contract_rows.push(ContractFact {
          id: StableContractId { dense_id: -1, stable_key: ckey.clone(), digest_hi: idw.hi, digest_lo: idw.lo },
          function: sid,
          kind: c.kind,
          expression_fingerprint: fp,
          canonical_expression: clause_ir,
          message: c.message.clone()
        })
      end
    end
    # The effect/capability rows of the def-keyed lowering (the mirror of
    # the fn row — def-keyed only; synthesized bodies' summaries ride their
    # mir_functions rows).
    match ctx.mir_fn_by_callable.get(snapshot_numeric_of_def(&ctx, &d))
    when Option::Some(fn_idx) then
      if fn_idx >= 0 && fn_idx < mir_program.functions.len() then
        let mf = mir_program.functions[fn_idx]
        match mf.callable.clone()
        when Option::Some(_) then
          var fin = SnapshotEffectFinal { summary: EffectSummary {}, unsafe_: false, unknown: false }
          match finals.effects.get(mf.name.clone())
          when Option::Some(fv) then
            fin = SnapshotEffectFinal { summary: fv.summary.clone(), unsafe_: fv.unsafe_, unknown: fv.unknown }
          when Option::None then ()
          end
          # (third-audit item 25): the def-keyed purity projection — the
          # status word + evidence rows the purity pass persisted for this
          # function ("" when the function is outside every analyzed
          # purity domain).
          var purity_word_row = "".to_string()
          var purity_ev_rows: Vec[String] = Vec::new()
          match finals.purity.get(mf.name.clone())
          when Option::Some(ps) then
            purity_word_row = purity_status_word(&ps)
            purity_ev_rows = purity_status_evidence(&ps)
          when Option::None then ()
          end
          effect_rows.push(EffectEdge {
            function: sid,
            summary: fin.summary.clone(),
            purity_status: purity_word_row.clone(),
            purity_evidence: purity_ev_rows.clone()
          })
          for cap in fin.summary.capabilities do
            capability_rows.push(CapabilityEdge {
              function: sid,
              capability: cap,
              kind: CapabilityEdgeKind::Requires
            })
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
    di2 = di2 + 1
  end

  # The mir_functions rows: ONE row per lowered body (item 12), keyed by
  # the body's ORIGIN text (snapshot_mir_origin_of) — def-keyed bodies keep
  # their def digest keys, every synthesized body (instances, closures,
  # drop glue, effect dispatchers, extern shims) gets a row of its own.
  # The per-name summary lookups mirror the scan/fixed-point name-keyed
  # tables (last-wins), so every row reads the SAME data the def-keyed
  # rows always read.
  var seen_mir_keys: Set[String] = Set::new()
  var origin_key_of_name: Map[String, String] = Map::new()
  # Def-keyed origin key -> the declaration row's lineage-rooted identity:
  # a def-keyed mir row carries the SAME persistent declaration identity as
  # its symbol row (a rename leaves the mir row's digest words unchanged
  # too). Synthesized origins keep the text-derived synthesized identity.
  var def_sid_of_origin: Map[String, StableDefId] = Map::new()
  for d in defs do
    def_sid_of_origin.insert(d.sid.key.clone(), d.sid)
  end
  var mi = 0
  while mi < mir_program.functions.len() do
    let mf = mir_program.functions[mi]
    let origin = match snapshot_mir_origin_of(&ctx, &mf, &defs, &def_row_of_numeric)
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(o) then o
    end
    let okey = snapshot_origin_key_text(&origin)
    origin_key_of_name.insert(mf.name.clone(), okey.clone())
    if !seen_mir_keys.contains(&okey) then
      seen_mir_keys.insert(okey.clone())
      var fin2 = SnapshotEffectFinal { summary: EffectSummary {}, unsafe_: false, unknown: false }
      match finals.effects.get(mf.name.clone())
      when Option::Some(fv2) then
        fin2 = SnapshotEffectFinal { summary: fv2.summary.clone(), unsafe_: fv2.unsafe_, unknown: fv2.unknown }
      when Option::None then ()
      end
      var scan2 = SnapshotScan { statement_count: 0, direct_unsafe: false, direct_unknown: false, unsafe_ops: Vec::new() }
      match scans.get(mf.name.clone())
      when Option::Some(sv2) then
        scan2 = SnapshotScan { statement_count: sv2.statement_count, direct_unsafe: sv2.direct_unsafe, direct_unknown: sv2.direct_unknown, unsafe_ops: sv2.unsafe_ops.clone() }
      when Option::None then ()
      end
      # (third-audit item 25): the mir row carries the SAME purity
      # projection as the def-keyed effect row.
      var purity_word_row2 = "".to_string()
      var purity_ev_rows2: Vec[String] = Vec::new()
      match finals.purity.get(mf.name.clone())
      when Option::Some(ps2) then
        purity_word_row2 = purity_status_word(&ps2)
        purity_ev_rows2 = purity_status_evidence(&ps2)
      when Option::None then ()
      end
      var mir_sid = stable_def_id_digested(okey.clone(), okey.clone())
      match def_sid_of_origin.get(okey.clone())
      when Option::Some(dsid) then mir_sid = dsid
      when Option::None then ()
      end
      mir_rows.push(MirSemanticSummary {
        function: mir_sid,
        block_count: mf.blocks.len(),
        statement_count: scan2.statement_count,
        local_count: mf.locals.len(),
        reachable: mf.blocks.len() > 0,
        calls_unsafe: fin2.unsafe_,
        calls_unknown: fin2.unknown,
        effect_summary: fin2.summary,
        purity_status: purity_word_row2.clone(),
        purity_evidence: purity_ev_rows2.clone()
      })
    end
    mi = mi + 1
  end

  # The call rows (item 10 — the site's caller/callee numerics were
  # resolved at scan time through the context indexes; NO name scans).
  # Def-keyed callers only (documented anchor).
  var seen_calls: Set[String] = Set::new()
  var call_i = 0
  while call_i < calls.len() do
    let cs = calls[call_i]
    var caller_row = -1
    match def_row_of_numeric.get(cs.caller_numeric)
    when Option::Some(cr) then caller_row = cr
    when Option::None then ()
    end
    if caller_row >= 0 then
      var callee_sid: Option[StableDefId] = Option::None
      if cs.callee_numeric == -2 then
        let skey = "intrinsic::" + cs.callee_name.clone()
        callee_sid = Option::Some(stable_def_id_digested(skey.clone() + "#op", skey.clone()))
      else
        match def_row_of_numeric.get(cs.callee_numeric)
        when Option::Some(cal_row) then callee_sid = Option::Some(defs[cal_row].sid)
        when Option::None then ()
        end
      end
      match callee_sid
      when Option::Some(csid) then
        let dedupe = defs[caller_row].sid.key.clone() + "|" + cs.callee_name.clone() + "|" +
          semantic_call_edge_kind_numeric(&cs.kind).to_string()
        if !seen_calls.contains(&dedupe) then
          seen_calls.insert(dedupe.clone())
          call_rows.push(CallEdge {
            caller: defs[caller_row].sid,
            callee: csid,
            kind: cs.kind
          })
        end
      when Option::None then ()
      end
    end
    call_i = call_i + 1
  end

  # The test rows (audit item 19 — the DISCOVERY side): the test-attr
  # function defs of the def universe (is_test — the item-walk's
  # attribute discovery; the driver's own @test marker). Targets come
  # from the SAME item-10 call-site resolution the call rows above ride:
  # ONE pass over the pre-materialized call sites — a site whose caller
  # def row is a discovered test contributes its def-keyed callee row's
  # StableDefId. Intrinsic-name sites (callee numeric -2) have no def key
  # and stay out; a callee whose def row is missing (no registered
  # identity) stays out — exactly the call-row builder's resolution; a
  # synthesized caller (-1) has no def row and can never match. Rows are
  # deduped per (test, target); span stays None (never serialized). A
  # test with no lowered body has no call sites and therefore NO rows:
  # the record's target is mandatory, so an "empty target list" test
  # cannot materialize under the current model record (documented in the
  # module header — a target-optional row would be a semantic_model.tg
  # change).
  var test_rows: Vec[TestRelationship] = Vec::new()
  var seen_test_targets: Set[String] = Set::new()
  var tcj = 0
  while tcj < calls.len() do
    let tcs = calls[tcj]
    match def_row_of_numeric.get(tcs.caller_numeric)
    when Option::Some(trow) then
      if trow >= 0 && trow < defs.len() then
        let trow_def = defs[trow]
        if trow_def.is_test then
          if tcs.callee_numeric != -2 then
            match def_row_of_numeric.get(tcs.callee_numeric)
            when Option::Some(cal_row) then
              if cal_row >= 0 && cal_row < defs.len() then
                let test_key = trow_def.sid.key.clone()
                let target_key = defs[cal_row].sid.key.clone()
                let test_target_key = test_key + "|" + target_key
                if !seen_test_targets.contains(&test_target_key) then
                  seen_test_targets.insert(test_target_key.clone())
                  let test_sid = trow_def.sid
                  let target_sid = defs[cal_row].sid
                  test_rows.push(TestRelationship {
                    test: test_sid,
                    target: target_sid,
                    span: Option::None
                  })
                end
              end
            when Option::None then ()
            end
          end
        end
      end
    when Option::None then ()
    end
    tcj = tcj + 1
  end

  # The indirect call rows (item 13 — the explicit replacement of the
  # silent omission): one row per indirect site of ANY caller (def-keyed
  # or synthesized), caller = the caller's mir row key text, site = the
  # §33 "<caller key>#B<block id>#T" grammar, signature = the canonical
  # callee-surface text, candidates EMPTY and completeness "Unknown" (the
  # snapshot's call builder has no points-to information — the audit's
  # conservative default; change.affected must treat such callers as
  # reachable from any callee).
  var seen_indirect: Set[String] = Set::new()
  var ic_i = 0
  while ic_i < indirect.len() do
    let ic = indirect[ic_i]
    match origin_key_of_name.get(ic.caller_name.clone())
    when Option::Some(caller_text) then
      let site = caller_text.clone() + "#B" + ic.block_id.to_string() + "#T"
      let dedupe3 = caller_text.clone() + "|" + site.clone() + "|" + ic.signature.clone()
      if !seen_indirect.contains(&dedupe3) then
        seen_indirect.insert(dedupe3.clone())
        indirect_rows.push(IndirectCallEdge {
          caller: caller_text.clone(),
          site: site,
          signature: ic.signature.clone(),
          candidates: Vec::new(),
          completeness: "Unknown".to_string()
        })
      end
    when Option::None then ()
    end
    ic_i = ic_i + 1
  end

  # The ownership rows: def-keyed owners, resolved through the
  # def-emission-name index (item 10 — no function scan); deduped per
  # (function, place, convention).
  var seen_ownership: Set[String] = Set::new()
  var own_i = 0
  while own_i < ownership.len() do
    let ow = ownership[own_i]
    var owner_numeric = -1
    match ctx.def_emission_numeric.get(ow.function_key.clone())
    when Option::Some(num2) then owner_numeric = num2
    when Option::None then ()
    end
    match def_row_of_numeric.get(owner_numeric)
    when Option::Some(fn_row) then
      let d2 = defs[fn_row]
      let dedupe2 = d2.key.clone() + "|" + ow.place_key.clone() + "|" +
        semantic_access_convention_numeric(&ow.convention).to_string()
      if !seen_ownership.contains(&dedupe2) then
        seen_ownership.insert(dedupe2.clone())
        ownership_rows.push(OwnershipFact {
          function: d2.sid,
          place_key: ow.place_key.clone(),
          convention: ow.convention
        })
      end
    when Option::None then ()
    end
    own_i = own_i + 1
  end

  # 4. Sort every table (the semantic_model sorts — stable-digest order),
  #    compute the surface hashes over the sorted tables, and emit.
  semantic_symbols_sort(&mut symbols)
  semantic_types_sort(&mut types)
  semantic_call_edges_sort(&mut call_rows)
  semantic_indirect_call_edges_sort(&mut indirect_rows)
  semantic_effect_edges_sort(&mut effect_rows)
  semantic_capability_edges_sort(&mut capability_rows)
  semantic_ownership_facts_sort(&mut ownership_rows)
  semantic_contract_facts_sort(&mut contract_rows)
  semantic_test_relationships_sort(&mut test_rows)
  semantic_mir_summaries_sort(&mut mir_rows)

  # The unsafe-facts table (audit item 16) — derived from the same
  # scan-marker domain the unsafe_hash text renders (snapshot_unsafe_facts_of).
  var unsafe_facts = snapshot_unsafe_facts_of(&ctx, &defs, &scans)
  semantic_unsafe_facts_sort(&mut unsafe_facts)

  var snapshot = SemanticSnapshot {
    revision: revision,
    compiler_version: compiler_version,
    # (fourth-audit P1-5a) the header's semantically relevant
    # features/options (the driver derives them from CompilerOptions +
    # TargetDesc; defaulted empty for options-less callers).
    feature_set: feature_set,
    semantic_options: semantic_options,
    target: target_id,
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
  snapshot.symbols = symbols
  snapshot.types = types
  snapshot.calls = call_rows
  snapshot.indirect_calls = indirect_rows
  snapshot.effects = effect_rows
  snapshot.capabilities = capability_rows
  snapshot.ownership = ownership_rows
  snapshot.contracts = contract_rows
  snapshot.tests = test_rows
  # Coverage rows stay EMPTY in the BUILD snapshot: the third-audit item-34
  # ingest (coverage_graph.tg's coverage_ingest, tg.cov.trace.v1) is the
  # ONLY writer of this table — a compile never invents runtime evidence
  # (documented in the module header).
  snapshot.coverage = Vec::new()
  snapshot.mir_functions = mir_rows
  snapshot.unsafe_facts = unsafe_facts
  # (fourth-audit P1-3) the typed member/signature tables (sorted through
  # the model's table orders; the writer re-sorts defensively).
  semantic_fields_sort(&mut typed_fields)
  semantic_variants_sort(&mut typed_variants)
  semantic_callable_signatures_sort(&mut typed_signatures)
  semantic_trait_methods_sort(&mut typed_trait_methods)
  snapshot.fields = typed_fields
  snapshot.variants = typed_variants
  snapshot.callable_signatures = typed_signatures
  snapshot.trait_methods = typed_trait_methods
  # (fourth-audit P1-5b) the concrete type-instance rows (already sorted).
  snapshot.concrete_types = concrete_type_rows
  # (fourth-audit P0-17) the persisted typed drop-plan facts (the resource
  # checker's emitted rows, mapped + sorted; empty when no resource run).
  snapshot.drop_plans = snapshot_drop_plan_facts(resource_drop_facts)
  # The persisted ABI/layout rows (item 18) — the explanatory payload
  # behind abi_hash (which stays the §30 CanonExternal text digest).
  var abi_rows = snapshot_abi_surface_rows(&ctx, &defs, &snapshot.types, &target)
  snapshot.abi_surfaces = abi_rows
  # The typed dependency graph (third-audit items 18/19): every family is
  # emitted from TYPED finalized state (see the producer section anchors —
  # resolved signatures, typed field shapes, impl records, solved
  # InstanceId constants, MirStaticRef operands, derived-body lowerings,
  # typed ABI-surface references) and sorted through the model's graph
  # sort. The writer emits the rows into the digest preimage.
  let trait_edges = snapshot_trait_impl_edges(&ctx, &defs, &def_row_of_numeric)
  var dependencies = SemanticDependencyGraph {
    type_uses: snapshot_type_use_edges(&ctx, &defs),
    trait_impls: trait_edges.0,
    trait_selections: trait_edges.1,
    generic_instantiations: snapshot_generic_instantiation_edges(&ctx, &defs, &def_row_of_numeric, &calls),
    layout_dependencies: snapshot_layout_dependency_edges(&ctx, &defs),
    const_eval_dependencies: snapshot_const_eval_edges(&ctx, &defs, &def_row_of_numeric, &mir_program, &origin_key_of_name),
    derived_bodies: snapshot_derived_body_edges(&ctx, &defs, &def_row_of_numeric, &mir_program),
    contract_references: snapshot_contract_reference_edges(&contract_rows),
    abi_dependencies: snapshot_abi_dependency_edges(&ctx, &abi_rows, &defs)
  }
  semantic_dependency_graph_sort(&mut dependencies)
  dependencies.dependency_completeness = snapshot_dependency_completeness()
  snapshot.dependencies = dependencies
  # (fourth-audit P1-5c) the allocation-site table: the owner text is the
  # body's mir row key (origin_key_of_name — the SAME domain the
  # mir_functions/effect rows carry), so the rows join.
  snapshot.allocation_sites = snapshot_allocation_sites(&ctx, &origin_key_of_name, &mir_program)
  snapshot.public_api_hash = stable_digest_of(&snapshot_public_api_text(&snapshot))
  match snapshot_abi_text(&ctx, &defs)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(at) then snapshot.abi_hash = stable_digest_of(&at)
  end
  snapshot.unsafe_hash = stable_digest_of(&snapshot_unsafe_text(&ctx, &defs, &finals.effects, &scans))
  Result::Ok(snapshot)
end

# ———————————————————————————————————————————————————————————————
# The surface-hash domains (deterministic text over sorted tables)
# ———————————————————————————————————————————————————————————————

# public_api: every pub row's canonical key with its DefKind text.
def snapshot_public_api_text(snapshot: SemanticSnapshot) -> String
  var lines: Vec[String] = Vec::new()
  for sym in snapshot.symbols do
    if sym.is_pub then
      lines.push(semantic_digest_render(&semantic_stable_def_id_digest(&sym.stable_id)) + " " +
        semantic_def_kind_text(&sym.kind) + " " + sym.stable_id.key.clone())
    end
  end
  for ty in snapshot.types do
    if ty.is_pub then
      lines.push(semantic_digest_render(&semantic_stable_def_id_digest(&ty.stable_id)) + " " +
        "type " + ty.stable_id.key.clone())
    end
  end
  lines.sort_by(|a, b| a < b)
  var text = ""
  for l in lines do
    text = text + l + "\n"
  end
  text
end

# abi: the exported-function ABI rows — pub top-level non-generic Function
# defs with a def-keyed lowering in the verified program, rendered through
# the mono ABI classifier's canonical frame (CanonExternal + the
# stable-path map — the type encoding the TANGERINE_ABI mangling digests).
# A generic base has no single ABI surface (its instances do): the row
# renders a deterministic marker. A signature the External frame rejects
# renders the fail-closed marker. Pointer widths are target-desc data and
# ride the header. Extern shim defs (callable = None — joined into the
# callable index for the signature fallbacks) are NOT ABI rows: the extern
# boundary has no compiler-chosen frame.
def snapshot_abi_text(ctx: SnapshotBuildCtx, defs: Vec[SnapshotDef]) -> String
  # The stable-path map of the ABI frame: TypeId -> "module::name".
  var stable_paths: Map[Int, String] = Map::new()
  for entry in ctx.typed.resolutions.type_def_ids.entries() do
    match ctx.key_of_def.get(def_id_numeric(&entry.1))
    when Option::Some(k) then stable_paths.insert(entry.0, k.clone())
    when Option::None then ()
    end
  end
  var lines: Vec[String] = Vec::new()
  for d in defs do
    var is_fn = false
    match d.kind
    when DefKind::Function then is_fn = true
    when _ then ()
    end
    if d.is_pub && is_fn then
      match ctx.mir_fn_by_callable.get(snapshot_numeric_of_def(ctx, &d))
      when Option::Some(fn_idx) then
        if fn_idx >= 0 && fn_idx < ctx.mir.functions.len() then
          match ctx.mir.functions[fn_idx].callable.clone()
          when Option::Some(_) then
            let mf = ctx.mir.functions[fn_idx]
            let digest_text = semantic_digest_render(&semantic_stable_def_id_digest(&d.sid))
            if mf.generic_params.len() > 0 then
              lines.push(digest_text + " " + d.key.clone() + " generic")
            else
              let sig = mir_fn_abi_signature(mf)
              let ctx2 = TypeCanonCtx {
                frame: TypeCanonFrame::CanonExternal,
                type_names: stable_paths.clone(),
                param_names: ctx.typed.generic_param_names.clone(),
                lang_option: ctx.env.lang_items.option,
                lang_result: ctx.env.lang_items.result,
                lang_map: ctx.env.lang_items.map,
                lang_set: ctx.env.lang_items.set,
                lang_slice: ctx.env.lang_items.slice,
                lang_array: ctx.env.lang_items.array,
                lang_box: ctx.env.lang_items.box_,
                lang_rc: ctx.env.lang_items.rc,
                effects: ctx.env.effects
              }
              match type_canon_render(&ctx2, &sig)
              when Result::Ok(text) then
                lines.push(digest_text + " " + d.key.clone() + " " + text.clone())
              when Result::Err(_) then
                lines.push(digest_text + " " + d.key.clone() + " abi-fail-closed")
              end
            end
          when Option::None then ()
          end
        end
      when Option::None then ()
      end
    end
  end
  lines.sort_by(|a, b| a < b)
  var out = ""
  for l in lines do
    out = out + l + "\n"
  end
  out
end

# unsafe: per def-keyed lowered function, its unsafe-surface markers
# (unsafe-fn / extern-call / transmute / unknown-call + the transitive
# may_unsafe class). Extern shim defs carry no def-keyed lowering and get
# no rows (their is_unsafe marker is an extern-boundary constant, not a
# body behavior).
def snapshot_unsafe_text(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  finals: Map[String, SnapshotEffectFinal],
  scans: Map[String, SnapshotScan]
) -> String
  var lines: Vec[String] = Vec::new()
  for d in defs do
    match ctx.mir_fn_by_callable.get(snapshot_numeric_of_def(ctx, &d))
    when Option::Some(fn_idx) then
      if fn_idx >= 0 && fn_idx < ctx.mir.functions.len() then
        match ctx.mir.functions[fn_idx].callable.clone()
        when Option::Some(_) then
          let fname = ctx.mir.functions[fn_idx].name.clone()
          let digest_text = semantic_digest_render(&semantic_stable_def_id_digest(&d.sid))
          var ops: Vec[String] = Vec::new()
          match scans.get(fname.clone())
          when Option::Some(sv) then
            for op in sv.unsafe_ops do
              ops.push(op.clone())
            end
          when Option::None then ()
          end
          var may_unsafe = false
          match finals.get(fname.clone())
          when Option::Some(fv) then may_unsafe = fv.summary.may_unsafe
          when Option::None then ()
          end
          ops.sort_by(|a, b| a < b)
          for op2 in ops do
            lines.push(digest_text.clone() + " " + op2)
          end
          if may_unsafe then
            lines.push(digest_text + " transitive-unsafe")
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  lines.sort_by(|a, b| a < b)
  var out = ""
  for l in lines do
    out = out + l + "\n"
  end
  out
end

# The unsafe-facts TABLE rows (audit item 16): one UnsafeFact per unsafe
# marker the scan recorded on a DEF-KEYED lowering — the same def walk
# and the same marker vocabulary as snapshot_unsafe_text above
# (synthesized bodies and the transitive-unsafe class word stay out by
# design — the hash domain's documented anchors). Each marker maps onto
# its (kind, site): "unsafe-fn" -> UnsafeFunction with an empty site;
# "extern-call:<name>" -> ExternBoundary with the callee name as the
# site; "transmute" -> Transmute; "unknown-call:<name>" ->
# UnknownUnsafeCall with the callee name as the site. A marker word
# outside the four scan families (none exists today) is skipped — the
# table never invents a kind for an unknown marker. Rows are deduped per
# (function, kind, site); the digest words are the stable digest of the
# fact's canonical text (semantic_model's semantic_unsafe_fact_text
# grammar "<function>|<kind-word>|<site>").
def snapshot_unsafe_facts_of(
  ctx: SnapshotBuildCtx,
  defs: Vec[SnapshotDef],
  scans: Map[String, SnapshotScan]
) -> Vec[UnsafeFact]
  var out: Vec[UnsafeFact] = Vec::new()
  var seen: Set[String] = Set::new()
  for d in defs do
    match ctx.mir_fn_by_callable.get(snapshot_numeric_of_def(ctx, &d))
    when Option::Some(fn_idx) then
      if fn_idx >= 0 && fn_idx < ctx.mir.functions.len() then
        match ctx.mir.functions[fn_idx].callable.clone()
        when Option::Some(_) then
          let fname = ctx.mir.functions[fn_idx].name.clone()
          match scans.get(fname.clone())
          when Option::Some(sv) then
            for op in sv.unsafe_ops do
              var kind: Option[UnsafeKind] = Option::None
              var site = "".to_string()
              if op == "unsafe-fn" then
                kind = Option::Some(UnsafeKind::UnsafeFunction)
              elsif op == "transmute" then
                kind = Option::Some(UnsafeKind::Transmute)
              elsif op.starts_with("extern-call:") then
                kind = Option::Some(UnsafeKind::ExternBoundary)
                site = op.slice(12, op.len())
              elsif op.starts_with("unknown-call:") then
                kind = Option::Some(UnsafeKind::UnknownUnsafeCall)
                site = op.slice(13, op.len())
              else
                ()
              end
              match kind
              when Option::Some(k) then
                var fact = UnsafeFact {
                  function: d.sid.key.clone(),
                  kind: k,
                  site: site.clone(),
                  digest_hi: 0,
                  digest_lo: 0,
                  # (fourth-audit P0-19) the typed unsafe-site member the
                  # budget's allowed_unsafe set keys on.
                  site_id: Option::Some(stable_unsafe_site_id_of(
                    &d.sid.key,
                    semantic_unsafe_kind_text(&k),
                    site.clone()))
                }
                let ctext = semantic_unsafe_fact_text(&fact)
                if !seen.contains(&ctext) then
                  seen.insert(ctext.clone())
                  let fw = stable_digest_of(&ctext)
                  fact.digest_hi = fw.hi
                  fact.digest_lo = fw.lo
                  out.push(fact)
                end
              when Option::None then ()
              end
            end
          when Option::None then ()
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
  end
  out
end

# ———————————————————————————————————————————————————————————————
# Serialization + the content-addressed revision
# ———————————————————————————————————————————————————————————————
# The canonical text form is line-oriented JSON records (the coverage.tg
# tgcov JSONL precedent) in the protocol's fixed table order; every table
# is sorted through the semantic_model sorts before rendering (the
# serializers re-sort defensively — idempotent on sorted input). Span
# fields NEVER serialize: they are provenance metadata, and a
# whitespace/comment-only edit must not move a byte of the canonical
# text.
#
# semantic_snapshot_digest hashes the canonical text with the revision
# header field rendered as 0-0: revision is the content-addressed
# self-digest of the artifact — the digest never depends on the stored
# revision words, so two compilations with identical semantic content
# produce identical artifacts and identical digests.

def snapshot_bool_text(b: Bool) -> String
  if b then "true" else "false" end
end

def snapshot_caps_text(s: EffectSummary) -> String
  var ids: Vec[Int] = Vec::new()
  for c in s.capabilities do
    ids.push(c.id)
  end
  ids.sort()
  var t = ""
  var i = 0
  while i < ids.len() do
    if i > 0 then t = t + ";" end
    t = t + ids[i].to_string()
    i = i + 1
  end
  t
end

# The header's target carrier: "tident" is the integrity digest of the
# target fields text (the one-way check semantic_snapshot_parse re-runs),
# while "tdigest" carries the Stored StableTargetId digest words THEMSELVES
# (semantic_digest_render of the record's digest_hi/lo). The words are
# protocol content — snapshot_target_fields_text digests them, so without
# the explicit tdigest field the serializer's output could not be inverted
# byte-for-byte (a digest has no computed inverse). tdigest completes the
# header carrier; a pre-tdigest artifact fails parse closed on the missing
# field rather than reconstructing fabricated identity words.
# (fourth-audit P1-5) The header also carries the semantically relevant
# feature_set / semantic_options (";;"-joined; the join keeps a path
# option carrying a comma exact) and the four new per-domain digests
# ("d_concrete_types" / "d_drop_plans" / "d_allocation_sites" /
# "d_features"). All of them ride the digest preimage, so two builds
# differing in a semantically relevant feature produce different
# revisions.
def snapshot_header_line(snapshot: SemanticSnapshot, zero_revision: Bool) -> String
  let rev = if zero_revision then semantic_digest_zero() else snapshot.revision end
  let tdigest = StableDigest { hi: snapshot.target.digest_hi, lo: snapshot.target.digest_lo }
  "{\"s\":\"header\",\"v\":1,\"format\":\"tg-semantic-snapshot/v1\"," +
    "\"compiler_version\":\"" + semantic_json_escape(&snapshot.compiler_version) + "\"," +
    "\"features\":\"" + semantic_json_escape(&snapshot.feature_set.join(";;")) + "\"," +
    "\"options\":\"" + semantic_json_escape(&snapshot.semantic_options.join(";;")) + "\"," +
    "\"target\":\"" + semantic_json_escape(&snapshot.target.triple) + "\"," +
    "\"tarch\":\"" + semantic_json_escape(&snapshot.target.arch) + "\"," +
    "\"tcpu\":\"" + semantic_json_escape(&snapshot.target.cpu) + "\"," +
    "\"tptr\":" + snapshot.target.pointer_width.to_string() + "," +
    "\"tendian\":\"" + semantic_json_escape(&snapshot.target.endian) + "\"," +
    "\"tabi\":\"" + semantic_json_escape(&snapshot.target.abi) + "\"," +
    "\"tfloat\":\"" + semantic_json_escape(&snapshot.target.float_abi) + "\"," +
    "\"tisa\":\"" + semantic_json_escape(&snapshot.target.isa_features.join(",")) + "\"," +
    "\"tnative\":\"" + semantic_json_escape(&snapshot_target_int_list_text(&snapshot.target.native_atomic_widths)) + "\"," +
    "\"tident\":\"" + semantic_digest_render(&stable_digest_of(&snapshot_target_fields_text(&snapshot.target))) + "\"," +
    "\"tdigest\":\"" + semantic_digest_render(&tdigest) + "\"," +
    "\"d_concrete_types\":\"" + semantic_digest_render(&snapshot.domain_digests.concrete_types) + "\"," +
    "\"d_drop_plans\":\"" + semantic_digest_render(&snapshot.domain_digests.drop_plans) + "\"," +
    "\"d_allocation_sites\":\"" + semantic_digest_render(&snapshot.domain_digests.allocation_sites) + "\"," +
    "\"d_features\":\"" + semantic_digest_render(&snapshot.domain_digests.features) + "\"," +
    "\"revision\":\"" + semantic_digest_render(&rev) + "\"," +
    "\"public_api_hash\":\"" + semantic_digest_render(&snapshot.public_api_hash) + "\"," +
    "\"abi_hash\":\"" + semantic_digest_render(&snapshot.abi_hash) + "\"," +
    "\"unsafe_hash\":\"" + semantic_digest_render(&snapshot.unsafe_hash) + "\"}"
end

# The canonical identity text of a stored StableTargetId record (the
# header's "tident" digest — the digest of the full record fields, NOT of
# the original TargetDesc: every desc change moves stable_target_id_of's
# digest_hi/lo words, and those words ride this text too, so the two
# digest layers are joined).
def snapshot_target_fields_text(t: StableTargetId) -> String
  t.triple.clone() + "|" + t.arch.clone() + "|" + t.cpu.clone() + "|" +
    t.pointer_width.to_string() + "|" + t.endian.clone() + "|" + t.abi.clone() + "|" +
    t.float_abi.clone() + "|" + t.isa_features.join(",") + "|" +
    snapshot_target_int_list_text(&t.native_atomic_widths) + "|" +
    t.digest_hi.to_string() + "|" + t.digest_lo.to_string()
end

def snapshot_symbol_line(s: SemanticSymbol) -> String
  "{\"s\":\"symbol\",\"i\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&s.stable_id)) + "\"," +
    "\"key\":\"" + semantic_json_escape(&s.stable_id.key) + "\"," +
    "\"kind\":\"" + semantic_def_kind_text(&s.kind) + "\"," +
    "\"name\":\"" + semantic_json_escape(&s.name) + "\"," +
    "\"module\":\"" + semantic_json_escape(&s.module_path) + "\"," +
    "\"pub\":" + snapshot_bool_text(s.is_pub) + "," +
    "\"generic\":" + snapshot_bool_text(s.is_generic) + "}"
end

def snapshot_type_kind_text(k: SemanticTypeKind) -> String
  match k
  when SemanticTypeKind::Struct then "Struct"
  when SemanticTypeKind::Enum then "Enum"
  when SemanticTypeKind::Trait then "Trait"
  end
end

def snapshot_type_line(t: SemanticType) -> String
  "{\"s\":\"type\",\"i\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&t.stable_id)) + "\"," +
    "\"key\":\"" + semantic_json_escape(&t.stable_id.key) + "\"," +
    "\"tkind\":\"" + snapshot_type_kind_text(&t.kind) + "\"," +
    "\"name\":\"" + semantic_json_escape(&t.name) + "\"," +
    "\"module\":\"" + semantic_json_escape(&t.module_path) + "\"," +
    "\"generic_arity\":" + t.generic_arity.to_string() + "," +
    "\"pub\":" + snapshot_bool_text(t.is_pub) + "}"
end

def snapshot_call_kind_text(k: CallEdgeKind) -> String
  match k
  when CallEdgeKind::Direct then "Direct"
  when CallEdgeKind::Indirect then "Indirect"
  when CallEdgeKind::Intrinsic then "Intrinsic"
  end
end

def snapshot_call_line(c: CallEdge) -> String
  "{\"s\":\"call\",\"from\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&c.caller)) + "\"," +
    "\"to\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&c.callee)) + "\"," +
    "\"ekind\":\"" + snapshot_call_kind_text(&c.kind) + "\"}"
end

def snapshot_effect_line(e: EffectEdge) -> String
  "{\"s\":\"effect\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&e.function)) + "\"," +
    "\"flags\":" + semantic_summary_dirty_word(&e.summary).to_string() + "," +
    "\"caps\":\"" + snapshot_caps_text(&e.summary) + "\"," +
    "\"purity\":\"" + semantic_json_escape(&e.purity_status) + "\"," +
    "\"pevidence\":\"" + semantic_json_escape(&e.purity_evidence.join(";;")) + "\"}"
end

def snapshot_capability_kind_text(k: CapabilityEdgeKind) -> String
  match k
  when CapabilityEdgeKind::Requires then "Requires"
  when CapabilityEdgeKind::Provides then "Provides"
  end
end

def snapshot_capability_line(c: CapabilityEdge) -> String
  "{\"s\":\"capability\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&c.function)) + "\"," +
    "\"cap\":" + c.capability.id.to_string() + "," +
    "\"dir\":\"" + snapshot_capability_kind_text(&c.kind) + "\"}"
end

def snapshot_ownership_line(o: OwnershipFact) -> String
  "{\"s\":\"ownership\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&o.function)) + "\"," +
    "\"place\":\"" + semantic_json_escape(&o.place_key) + "\"," +
    "\"conv\":" + semantic_access_convention_numeric(&o.convention).to_string() + "}"
end

def snapshot_contract_kind_text(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

def snapshot_contract_line(c: ContractFact) -> String
  var msg = "".to_string()
  match c.message
  when Option::Some(m) then msg = m.clone()
  when Option::None then ()
  end
  var idw = StableDigest { hi: c.id.digest_hi, lo: c.id.digest_lo }
  "{\"s\":\"contract\",\"i\":\"" + semantic_digest_render(&idw) + "\"," +
    "\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&c.function)) + "\"," +
    "\"ckind\":\"" + snapshot_contract_kind_text(&c.kind) + "\"," +
    "\"text\":\"" + semantic_json_escape(&semantic_contract_expr_text(&c.canonical_expression)) + "\"," +
    "\"fp\":\"" + semantic_digest_render(&c.expression_fingerprint) + "\"," +
    "\"msg\":\"" + semantic_json_escape(&msg) + "\"}"
end

# The test-discovery rows (audit item 19): the test def's digest and the
# exercised def's digest. The span field NEVER serializes (provenance
# metadata — the canonical text is span-free by policy).
def snapshot_test_line(t: TestRelationship) -> String
  "{\"s\":\"test\",\"test\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&t.test)) + "\"," +
    "\"target\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&t.target)) + "\"}"
end

# The ingested coverage rows (coverage_graph.tg's coverage_ingest — the
# builder emits none): the covered def's digest, the tg.cov.v1 point-id
# text, the arm-id text ("" when the fact is not arm-granular), the
# point-kind word ("Block" | "Edge" | "Contract" | "EffectSite") and the
# exercising test's stable key text (test_id — the item-19 test endpoint;
# "" when unbound). Span NEVER serializes.
def snapshot_coverage_line(c: CoverageRelationship) -> String
  var arm = "".to_string()
  match c.arm_id
  when Option::Some(a) then arm = a.clone()
  when Option::None then ()
  end
  "{\"s\":\"coverage\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&c.function)) + "\"," +
    "\"branch\":\"" + semantic_json_escape(&c.branch_id) + "\"," +
    "\"arm\":\"" + semantic_json_escape(&arm) + "\"," +
    "\"kind\":\"" + semantic_json_escape(&c.kind) + "\"," +
    "\"test\":\"" + semantic_json_escape(&c.test_id) + "\"}"
end

def snapshot_indirect_line(ic: IndirectCallEdge) -> String
  "{\"s\":\"indirect\",\"caller\":\"" + semantic_json_escape(&ic.caller) + "\"," +
    "\"site\":\"" + semantic_json_escape(&ic.site) + "\"," +
    "\"sig\":\"" + semantic_json_escape(&ic.signature) + "\"," +
    "\"candidates\":\"" + semantic_json_escape(&ic.candidates.join(",")) + "\"," +
    "\"completeness\":\"" + semantic_json_escape(&ic.completeness) + "\"}"
end

def snapshot_mir_line(m: MirSemanticSummary) -> String
  "{\"s\":\"mir\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&m.function)) + "\"," +
    "\"blocks\":" + m.block_count.to_string() + "," +
    "\"statements\":" + m.statement_count.to_string() + "," +
    "\"locals\":" + m.local_count.to_string() + "," +
    "\"reachable\":" + snapshot_bool_text(m.reachable) + "," +
    "\"unsafe\":" + snapshot_bool_text(m.calls_unsafe) + "," +
    "\"unknown\":" + snapshot_bool_text(m.calls_unknown) + "," +
    "\"flags\":" + semantic_summary_dirty_word(&m.effect_summary).to_string() + "," +
    "\"caps\":\"" + snapshot_caps_text(&m.effect_summary) + "\"," +
    "\"purity\":\"" + semantic_json_escape(&m.purity_status) + "\"," +
    "\"pevidence\":\"" + semantic_json_escape(&m.purity_evidence.join(";;")) + "\"}"
end

def snapshot_unsafe_fact_line(f: UnsafeFact) -> String
  var idw = StableDigest { hi: f.digest_hi, lo: f.digest_lo }
  "{\"s\":\"unsafe-fact\",\"i\":\"" + semantic_digest_render(&idw) + "\"," +
    "\"f\":\"" + semantic_json_escape(&f.function) + "\"," +
    "\"ukind\":\"" + semantic_unsafe_kind_text(&f.kind) + "\"," +
    "\"site\":\"" + semantic_json_escape(&f.site) + "\"}"
end

# (fourth-audit P0-17) ONE drop-plan fact row: the function key, the place
# text, the drop-site identity, the ';;'-joined conditional path rows and
# the kind word. Every value escaped; the ';;' join keeps an empty list
# unambiguous (empty string) and lets a path row carry ':'.
def snapshot_drop_plan_line(f: DropPlanFact) -> String
  "{\"s\":\"drop-plan\",\"f\":\"" + semantic_json_escape(&f.function) + "\"," +
    "\"place\":\"" + semantic_json_escape(&f.place) + "\"," +
    "\"site\":\"" + semantic_json_escape(&f.drop_site) + "\"," +
    "\"paths\":\"" + semantic_json_escape(&f.conditional_paths.join(";;")) + "\"," +
    "\"kind\":\"" + semantic_json_escape(&f.kind) + "\"}"
end

# ———— (fourth-audit P1-5/P1-3) the new table row renderers ————
# One concrete-type row: identity, template key, canonical args, layout
# summary. Vectors join with ';;' (an arg render carries no ';;').
def snapshot_concrete_type_line(c: SemanticConcreteType) -> String
  "{\"s\":\"concrete-type\",\"i\":\"" + semantic_json_escape(&c.instance_key) + "\"," +
    "\"template\":\"" + semantic_json_escape(&c.template) + "\"," +
    "\"args\":\"" + semantic_json_escape(&c.args.join(";;")) + "\"," +
    "\"size\":" + c.size.to_string() + "," +
    "\"align\":" + c.alignment.to_string() + "," +
    "\"status\":\"" + semantic_json_escape(&c.layout_status) + "\"," +
    "\"fields\":\"" + semantic_json_escape(&c.fields.join(";;")) + "\"}"
end

# One allocation-site row: owner key, §33 node site key, size kind word and
# the size (when the kind carries one; -1 otherwise).
def snapshot_allocation_site_line(a: SemanticAllocationSite) -> String
  "{\"s\":\"alloc-site\",\"f\":\"" + semantic_json_escape(&a.function) + "\"," +
    "\"site\":\"" + semantic_json_escape(&a.site) + "\"," +
    "\"kind\":\"" + semantic_allocation_size_kind_text(&a.size_kind) + "\"," +
    "\"size\":" + a.size.to_string() + "}"
end

# One typed parameter's row encoding "conv|name|ty" (the ';;' separator
# joins rows; the member/param texts carry no '|' or ';;').
def snapshot_param_encoded(p: SemanticParam) -> String
  var conv = "let".to_string()
  match p.convention
  when AccessConvention::Let then conv = "let".to_string()
  when AccessConvention::Inout then conv = "inout".to_string()
  when AccessConvention::Sink then conv = "sink".to_string()
  when AccessConvention::Set then conv = "set".to_string()
  end
  conv + "|" + p.name.clone() + "|" + p.ty.clone()
end

def snapshot_params_encoded(params: Vec[SemanticParam]) -> String
  var parts: Vec[String] = Vec::new()
  for p in params do
    parts.push(snapshot_param_encoded(&p))
  end
  parts.join(";;")
end

# One declared field row (owner digest-only; the key hydrates like every
# def-keyed row).
def snapshot_field_line(f: SemanticField) -> String
  "{\"s\":\"field\",\"o\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&f.owner)) + "\"," +
    "\"name\":\"" + semantic_json_escape(&f.name) + "\"," +
    "\"index\":" + f.index.to_string() + "," +
    "\"ty\":\"" + semantic_json_escape(&f.ty) + "\"," +
    "\"member\":\"" + semantic_json_escape(&f.member_id) + "\"," +
    "\"pub\":" + snapshot_bool_text(f.is_pub) + "}"
end

# One enum variant row with its payload shape.
def snapshot_variant_line(v: SemanticVariant) -> String
  "{\"s\":\"variant\",\"o\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&v.owner)) + "\"," +
    "\"name\":\"" + semantic_json_escape(&v.name) + "\"," +
    "\"index\":" + v.index.to_string() + "," +
    "\"payload\":\"" + semantic_json_escape(&snapshot_params_encoded(v.payload.clone())) + "\"," +
    "\"member\":\"" + semantic_json_escape(&v.member_id) + "\"}"
end

# One callable-signature row (function digest-only; params encoded; the
# declared effect-id texts ';;'-joined).
def snapshot_signature_line(s: SemanticCallableSignature) -> String
  "{\"s\":\"signature\",\"f\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&s.function)) + "\"," +
    "\"params\":\"" + semantic_json_escape(&snapshot_params_encoded(s.params.clone())) + "\"," +
    "\"ret\":\"" + semantic_json_escape(&s.ret_type) + "\"," +
    "\"effects\":\"" + semantic_json_escape(&s.declared_effects.join(";;")) + "\"," +
    "\"variadic\":" + snapshot_bool_text(s.variadic) + "}"
end

# One trait-method row.
def snapshot_trait_method_line(m: SemanticTraitMethod) -> String
  "{\"s\":\"trait-method\",\"o\":\"" + semantic_digest_render(&semantic_stable_def_id_digest(&m.owner)) + "\"," +
    "\"name\":\"" + semantic_json_escape(&m.name) + "\"," +
    "\"index\":" + m.index.to_string() + "," +
    "\"params\":\"" + semantic_json_escape(&snapshot_params_encoded(m.params.clone())) + "\"," +
    "\"ret\":\"" + semantic_json_escape(&m.ret_type) + "\"," +
    "\"member\":\"" + semantic_json_escape(&m.member_id) + "\"}"
end

# The persisted ABI/layout rows (audit item 18; third-audit items 42/43):
# the surface id, the underlying symbol key, the family word, the layout
# size/alignment (-1 on fn / fail-closed rows), the per-param class words
# and return class (';'-joined; empty runs on type rows), the field/reason
# texts (';'-joined), plus the typed FFI-surface mirror (the calling
# convention / external symbol / typed param classes and locations /
# access conventions / return ownership / nullability rows / variadic flag
# / extensions / platform / failure convention / thread-safety / taint /
# canonical enum-crossing boundary). Vector fields are joined with ';'
# because field texts contain spaces ("name offset size") and class /
# location words may contain ','; the JSON string escaping keeps every
# value unambiguous.
def snapshot_abi_surface_line(r: AbiSurfaceRow) -> String
  "{\"s\":\"abi-surface\",\"surface\":\"" + semantic_json_escape(&r.surface_id) + "\"," +
    "\"symbol\":\"" + semantic_json_escape(&r.symbol_key) + "\"," +
    "\"kind\":\"" + semantic_json_escape(&r.kind) + "\"," +
    "\"size\":" + r.size.to_string() + "," +
    "\"align\":" + r.alignment.to_string() + "," +
    "\"args\":\"" + semantic_json_escape(&r.arg_classes.join(";")) + "\"," +
    "\"ret\":\"" + semantic_json_escape(&r.ret_class) + "\"," +
    "\"fields\":\"" + semantic_json_escape(&r.fields.join(";")) + "\"," +
    "\"conv\":\"" + semantic_json_escape(&r.calling_convention) + "\"," +
    "\"extern\":\"" + semantic_json_escape(&r.external_symbol) + "\"," +
    "\"pclasses\":\"" + semantic_json_escape(&r.param_classes.join(";")) + "\"," +
    "\"plocs\":\"" + semantic_json_escape(&r.param_locations.join(";")) + "\"," +
    "\"ownin\":\"" + semantic_json_escape(&r.ownership_in.join(";")) + "\"," +
    "\"ownout\":\"" + semantic_json_escape(&r.ownership_out) + "\"," +
    "\"null\":\"" + semantic_json_escape(&r.nullability.join(";")) + "\"," +
    "\"variadic\":" + snapshot_bool_text(r.variadic) + "," +
    "\"ext\":\"" + semantic_json_escape(&r.extension.join(";")) + "\"," +
    "\"platform\":\"" + semantic_json_escape(&r.platform) + "\"," +
    "\"failure\":\"" + semantic_json_escape(&r.failure_convention) + "\"," +
    "\"thread\":\"" + semantic_json_escape(&r.thread_safety) + "\"," +
    "\"taint\":\"" + semantic_json_escape(&r.taint) + "\"," +
    "\"boundary\":\"" + semantic_json_escape(&r.canonical_boundary) + "\"}"
end

# The typed dependency-graph row lines (third-audit item 18): one fixed
# grammar per family, every field escaped. The writer sorts each family
# through semantic_dependency_graph_sort first, so the renders are
# byte-deterministic.
def snapshot_type_use_line(e: TypeUseEdge) -> String
  "{\"s\":\"dep-type-use\",\"user\":\"" + semantic_json_escape(&e.user) +
    "\",\"used\":\"" + semantic_json_escape(&e.used_type) + "\"}"
end

def snapshot_trait_impl_line(e: TraitImplEdge) -> String
  "{\"s\":\"dep-trait-impl\",\"impl\":\"" + semantic_json_escape(&e.impl_key) +
    "\",\"trait\":\"" + semantic_json_escape(&e.trait_key) +
    "\",\"self\":\"" + semantic_json_escape(&e.self_type) + "\"}"
end

def snapshot_trait_selection_line(e: TraitSelectionEdge) -> String
  "{\"s\":\"dep-trait-select\",\"fn\":\"" + semantic_json_escape(&e.function) +
    "\",\"trait\":\"" + semantic_json_escape(&e.trait_key) +
    "\",\"impl\":\"" + semantic_json_escape(&e.impl_key) + "\"}"
end

def snapshot_generic_instantiation_line(e: GenericInstantiationEdge) -> String
  "{\"s\":\"dep-generic-inst\",\"instance\":\"" + semantic_json_escape(&e.instance_key) +
    "\",\"template\":\"" + semantic_json_escape(&e.template) + "\"}"
end

def snapshot_layout_dependency_line(e: LayoutDependencyEdge) -> String
  "{\"s\":\"dep-layout\",\"dependent\":\"" + semantic_json_escape(&e.dependent_type) +
    "\",\"source\":\"" + semantic_json_escape(&e.source_type) + "\"}"
end

def snapshot_const_eval_dependency_line(e: ConstEvalDependencyEdge) -> String
  "{\"s\":\"dep-const-eval\",\"dependent\":\"" + semantic_json_escape(&e.dependent) +
    "\",\"const\":\"" + semantic_json_escape(&e.referenced_const) + "\"}"
end

def snapshot_derived_body_line(e: DerivedBodyEdge) -> String
  "{\"s\":\"dep-derived-body\",\"derived\":\"" + semantic_json_escape(&e.derived_key) +
    "\",\"source\":\"" + semantic_json_escape(&e.source_type) + "\"}"
end

def snapshot_contract_reference_line(e: ContractReferenceEdge) -> String
  "{\"s\":\"dep-contract-ref\",\"contract\":\"" + semantic_json_escape(&e.contract_id) +
    "\",\"symbol\":\"" + semantic_json_escape(&e.referenced_symbol) + "\"}"
end

def snapshot_abi_dependency_line(e: AbiDependencyEdge) -> String
  "{\"s\":\"dep-abi\",\"surface\":\"" + semantic_json_escape(&e.surface_id) +
    "\",\"type\":\"" + semantic_json_escape(&e.type_key) + "\"}"
end

# One per-relation-family completeness row (fourth-audit P0-9): the family
# word and its producer status ("complete" / "partial" / "unavailable").
def snapshot_dependency_completeness_line(family: String, status: String) -> String
  "{\"s\":\"dep-completeness\",\"family\":\"" + semantic_json_escape(&family) +
    "\",\"status\":\"" + semantic_json_escape(&status) + "\"}"
end

# The completeness rows in canonical (family-name sorted) order — a Map has
# no serialization order, so the writer renders the entries sorted; the
# statuses are the persisted producer record the closure reads.
def snapshot_dependency_completeness_lines(m: Map[String, String]) -> Vec[String]
  var rows: Vec[(String, String)] = m.entries()
  rows.sort_by(|a, b| a.0 < b.0)
  var out: Vec[String] = Vec::new()
  for row in rows do
    out.push(snapshot_dependency_completeness_line(row.0.clone(), row.1.clone()))
  end
  out
end

# The canonical text form (the tables are sorted before rendering; the
# serializer sorts in place — idempotent on already-sorted input). The
# emission loops follow the protocol's fixed table order (tests between
# contracts and coverage, coverage between tests and mir_functions — the
# SemanticSnapshot record order); the coverage loop renders nothing until
# the execution-side ingest fills the table, and the typed dependency
# graph families render after the ABI-surface rows in their fixed family
# order followed by the family-name-sorted completeness rows
# (module-header contract).
def semantic_snapshot_serialize(inout snapshot: SemanticSnapshot) -> String
  semantic_symbols_sort(&mut snapshot.symbols)
  semantic_types_sort(&mut snapshot.types)
  semantic_call_edges_sort(&mut snapshot.calls)
  semantic_indirect_call_edges_sort(&mut snapshot.indirect_calls)
  semantic_effect_edges_sort(&mut snapshot.effects)
  semantic_capability_edges_sort(&mut snapshot.capabilities)
  semantic_ownership_facts_sort(&mut snapshot.ownership)
  semantic_contract_facts_sort(&mut snapshot.contracts)
  semantic_test_relationships_sort(&mut snapshot.tests)
  semantic_coverage_relationships_sort(&mut snapshot.coverage)
  semantic_mir_summaries_sort(&mut snapshot.mir_functions)
  semantic_unsafe_facts_sort(&mut snapshot.unsafe_facts)
  semantic_drop_plans_sort(&mut snapshot.drop_plans)
  semantic_abi_surfaces_sort(&mut snapshot.abi_surfaces)
  semantic_dependency_graph_sort(&mut snapshot.dependencies)
  # (fourth-audit P1-3/P1-5) the new typed tables, sorted through their
  # model orders.
  semantic_fields_sort(&mut snapshot.fields)
  semantic_variants_sort(&mut snapshot.variants)
  semantic_callable_signatures_sort(&mut snapshot.callable_signatures)
  semantic_trait_methods_sort(&mut snapshot.trait_methods)
  semantic_concrete_types_sort(&mut snapshot.concrete_types)
  semantic_allocation_sites_sort(&mut snapshot.allocation_sites)

  var text = snapshot_header_line(&snapshot, false) + "\n"
  for s in snapshot.symbols do
    text = text + snapshot_symbol_line(&s) + "\n"
  end
  for t in snapshot.types do
    text = text + snapshot_type_line(&t) + "\n"
  end
  # (fourth-audit P1-3) the typed member/signature rows.
  for tf in snapshot.fields do
    text = text + snapshot_field_line(&tf) + "\n"
  end
  for tv in snapshot.variants do
    text = text + snapshot_variant_line(&tv) + "\n"
  end
  for tsig in snapshot.callable_signatures do
    text = text + snapshot_signature_line(&tsig) + "\n"
  end
  for tm in snapshot.trait_methods do
    text = text + snapshot_trait_method_line(&tm) + "\n"
  end
  # (fourth-audit P1-5b) the concrete type-instance rows.
  for ct in snapshot.concrete_types do
    text = text + snapshot_concrete_type_line(&ct) + "\n"
  end
  for c in snapshot.calls do
    text = text + snapshot_call_line(&c) + "\n"
  end
  for ic in snapshot.indirect_calls do
    text = text + snapshot_indirect_line(&ic) + "\n"
  end
  for e in snapshot.effects do
    text = text + snapshot_effect_line(&e) + "\n"
  end
  for c2 in snapshot.capabilities do
    text = text + snapshot_capability_line(&c2) + "\n"
  end
  for o in snapshot.ownership do
    text = text + snapshot_ownership_line(&o) + "\n"
  end
  for c3 in snapshot.contracts do
    text = text + snapshot_contract_line(&c3) + "\n"
  end
  for tr in snapshot.tests do
    text = text + snapshot_test_line(&tr) + "\n"
  end
  for cr in snapshot.coverage do
    text = text + snapshot_coverage_line(&cr) + "\n"
  end
  for m in snapshot.mir_functions do
    text = text + snapshot_mir_line(&m) + "\n"
  end
  for uf in snapshot.unsafe_facts do
    text = text + snapshot_unsafe_fact_line(&uf) + "\n"
  end
  for dp in snapshot.drop_plans do
    text = text + snapshot_drop_plan_line(&dp) + "\n"
  end
  # (fourth-audit P1-5c) the allocation-site rows.
  for asite in snapshot.allocation_sites do
    text = text + snapshot_allocation_site_line(&asite) + "\n"
  end
  for ar in snapshot.abi_surfaces do
    text = text + snapshot_abi_surface_line(&ar) + "\n"
  end
  for e in snapshot.dependencies.type_uses do
    text = text + snapshot_type_use_line(&e) + "\n"
  end
  for e2 in snapshot.dependencies.trait_impls do
    text = text + snapshot_trait_impl_line(&e2) + "\n"
  end
  for e3 in snapshot.dependencies.trait_selections do
    text = text + snapshot_trait_selection_line(&e3) + "\n"
  end
  for e4 in snapshot.dependencies.generic_instantiations do
    text = text + snapshot_generic_instantiation_line(&e4) + "\n"
  end
  for e5 in snapshot.dependencies.layout_dependencies do
    text = text + snapshot_layout_dependency_line(&e5) + "\n"
  end
  for e6 in snapshot.dependencies.const_eval_dependencies do
    text = text + snapshot_const_eval_dependency_line(&e6) + "\n"
  end
  for e7 in snapshot.dependencies.derived_bodies do
    text = text + snapshot_derived_body_line(&e7) + "\n"
  end
  for e8 in snapshot.dependencies.contract_references do
    text = text + snapshot_contract_reference_line(&e8) + "\n"
  end
  for e9 in snapshot.dependencies.abi_dependencies do
    text = text + snapshot_abi_dependency_line(&e9) + "\n"
  end
  for line in snapshot_dependency_completeness_lines(snapshot.dependencies.dependency_completeness.clone()) do
    text = text + line + "\n"
  end
  text
end

# The canonical text form with the revision header field zeroed — the
# digest preimage (a pure function of the snapshot's semantic content).
# (fourth-audit P1-5a) The preimage is the CLONE of the snapshot with only
# the revision zeroed, so EVERY field — the header's feature_set /
# semantic_options included — joins the digest by construction; a new
# table cannot be forgotten here.
def semantic_snapshot_digest_text(snapshot: SemanticSnapshot) -> String
  var snap2 = snapshot.clone()
  snap2.revision = semantic_digest_zero()
  semantic_snapshot_serialize(&mut snap2)
end

# The content-addressed digest: stable_digest_of the canonical text with
# the revision field zeroed.
def semantic_snapshot_digest(snapshot: SemanticSnapshot) -> StableDigest
  stable_digest_of(&semantic_snapshot_digest_text(&snapshot))
end

# Set the snapshot's revision to its content-addressed digest (the stored
# words then ride the artifact's header). (fourth-audit P1-5c) The
# per-domain digest record is recomputed FIRST (a pure function of the
# tables + header features), so the revision commits to it as well.
def semantic_snapshot_finalize(inout snapshot: SemanticSnapshot) -> Unit
  snapshot.domain_digests = semantic_snapshot_domain_digests(&snapshot)
  snapshot.revision = semantic_snapshot_digest(&snapshot)
  ()
end

# An empty snapshot seed (all digest words zero, no tables).
def semantic_snapshot_empty() -> SemanticSnapshot
  SemanticSnapshot {
    revision: semantic_digest_zero(),
    compiler_version: "".to_string(),
    target: StableTargetId {
      triple: "".to_string(),
      arch: "".to_string(),
      cpu: "".to_string(),
      pointer_width: 0,
      endian: "".to_string(),
      abi: "".to_string(),
      float_abi: "".to_string(),
      isa_features: Vec::new(),
      native_atomic_widths: Vec::new(),
      digest_hi: 0,
      digest_lo: 0
    },
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
end

# ———————————————————————————————————————————————————————————————
# Snapshot deserialization — the offline-artifact parser
# ———————————————————————————————————————————————————————————————
# semantic_snapshot_parse is the EXACT inverse of
# semantic_snapshot_serialize: one line per canonical row, every row family
# parsed back into the semantic_model.tg record it was rendered from, so
# `tg server --snapshot-only --snapshot=<path>` boots a session from a
# serialized artifact instead of a live compile.
#
# ROW GRAMMAR (the serializer's documented field set — see snapshot_*_line
# above; every row is ONE JSON object on ONE line):
#   header        — s, v, format, compiler_version, features, options, target,
#                   tarch, tcpu, tptr, tendian, tabi, tfloat, tisa, tnative,
#                   tident, tdigest, d_concrete_types, d_drop_plans,
#                   d_allocation_sites, d_features, revision, public_api_hash,
#                   abi_hash, unsafe_hash
#   symbol        — s, i, key, kind, name, module, pub, generic
#   type          — s, i, key, tkind, name, module, generic_arity, pub
#   field         — s, o, name, index, ty, member, pub
#   variant       — s, o, name, index, payload, member
#   signature     — s, f, params, ret, effects, variadic
#   trait-method  — s, o, name, index, params, ret, member
#   concrete-type — s, i, template, args, size, align, status, fields
#   alloc-site    — s, f, site, kind, size
#   call          — s, from, to, ekind
#   indirect      — s, caller, site, sig, candidates, completeness
#   effect        — s, f, flags, caps, purity, pevidence
#   capability    — s, f, cap, dir
#   ownership     — s, f, place, conv
#   contract      — s, i, f, ckind, text, fp, msg
#   test          — s, test, target
#   coverage      — s, f, branch, arm, kind, test
#   mir           — s, f, blocks, statements, locals, reachable, unsafe,
#                   unknown, flags, caps, purity, pevidence
#   unsafe-fact   — s, i, f, ukind, site
#   drop-plan     — s, f, place, site, paths, kind
#   abi-surface   — s, surface, symbol, kind, size, align, args, ret, fields,
#                   conv, extern, pclasses, plocs, ownin, ownout, null,
#                   variadic, ext, platform, failure, thread, taint, boundary
#   dep-type-use  — s, user, used
#   dep-trait-impl— s, impl, trait, self
#   dep-trait-sel — s, fn, trait, impl
#   dep-generic   — s, instance, template
#   dep-layout    — s, dependent, source
#   dep-const     — s, dependent, const
#   dep-derived   — s, derived, source
#   dep-contract  — s, contract, symbol
#   dep-abi        — s, surface, type
#
# FIELD POLICY: every documented field is REQUIRED — a missing field, a
# duplicate field, an unquoted string / quoted scalar type mismatch, an
# unknown row tag, a malformed digest, an unsupported header version or a
# row before the header all fail closed with the line number, the row tag
# and the offending field name. The P1-5 header additions (features,
# options, d_concrete_types, d_drop_plans, d_allocation_sites, d_features)
# are the documented exception: they are OPTIONAL ON READ with empty/zero
# defaults so an artifact written before P1-5 still loads (the writer
# always emits them). Unknown EXTRA fields are tolerated (skipped) so a
# future writer can append fields without breaking this reader; the
# round-trip lane covers the serializer's own (exact) field set. The
# parser materializes rows in file order (the serializer already sorted
# every table); re-serialization sorts again (idempotent) and is
# byte-identical for a serializer-produced text.
#
# DIGEST-ONLY ROWS AND KEY HYDRATION (the protocol-carrier rule): several
# families (call / effect / capability / ownership / contract / test /
# coverage / mir) carry their def endpoint as the 128-bit digest render
# ONLY — the serializer writes no key text in those rows. After the rows
# are parsed, snapshot_hydrate_def_keys rebuilds each empty key from the
# symbol/type tables (the rows that DO carry key text) by digest join,
# exactly as the builder built them; a digest with no registered
# declaration (a synthesized instance / closure / drop-glue / dispatcher /
# shim or an intrinsic callee) gets the deterministic "digest::<hi-lo>"
# carrier text so every row keeps a distinct, stable key. The carrier
# never collides with a real canonical key text — it is the documented
# fidelity boundary of a digest-only row, never a fabricated declaration
# key.
#
# HEADER TARGET DIGEST: the header's "tident" is a ONE-WAY digest of the
# target fields text and cannot be inverted, so the artifact carries the
# stored StableTargetId digest words verbatim in "tdigest" and the parser
# verifies tident against the recomputed fields digest. The parser is
# deterministic: identical text yields identical records.

struct SnapshotField
  key: String
  text: String
  quoted: Bool
end

# (fourth-audit P1-5) The parsed header carrier. The model's SnapshotHeader
# record (semantic_model.tg) is the four-field identity projection; this
# local record additionally carries the digest words the parser must
# round-trip. The feature_set / semantic_options / domain-digest fields are
# OPTIONAL on read (a pre-P1-5 artifact lacks them and parses with empty/
# zero defaults) but are REQUIRED on write — the serializer always emits
# them, so the round-trip lane is exact.
struct SnapshotParsedHeader
  revision: StableDigest
  compiler_version: String
  target: StableTargetId
  feature_set: Vec[String]
  semantic_options: Vec[String]
  domain_digests: SemanticDomainDigests
  public_api_hash: StableDigest
  abi_hash: StableDigest
  unsafe_hash: StableDigest
end

def snapshot_line_error(line_no: Int, tag: String, detail: String) -> String
  "semantic snapshot parse error (line " + line_no.to_string() + ", row '" + tag.clone() + "'): " + detail
end

def snapshot_split_commas(text: String) -> Vec[String]
  if text.len() == 0 then
    return Vec::new()
  end
  text.split(",")
end

def snapshot_split_semicolons(text: String) -> Vec[String]
  if text.len() == 0 then
    return Vec::new()
  end
  text.split(";")
end

def snapshot_split_double_semicolons(text: String) -> Vec[String]
  if text.len() == 0 then
    return Vec::new()
  end
  text.split(";;")
end

# The full 64-bit unsigned decimal parser ("hi-lo" digest words span the
# whole UInt range — String.parse_int is signed and would fail closed on
# the top half, so the parser accumulates in UInt, whose arithmetic wraps
# by the language's unsigned rule; a non-digit fails closed).
def snapshot_parse_uint(text: String) -> Result[UInt, String]
  if text.len() == 0 then
    return Result::Err("empty unsigned integer")
  end
  var value: UInt = 0
  for c in text.chars() do
    if (c as Int) < 48 || (c as Int) > 57 then
      return Result::Err("non-digit in unsigned integer '" + text.clone() + "'")
    end
    value = value * 10 + ((c as UInt) - 48)
  end
  Result::Ok(value)
end

def snapshot_parse_digest(text: String, tag: String, key: String, line_no: Int) -> Result[StableDigest, String]
  var at = -1
  var i = 0
  while i < text.len() do
    if text.slice(i, i + 1) == "-" then
      at = i
      break
    end
    i = i + 1
  end
  if at < 0 then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' is not a 'hi-lo' digest: '" + text.clone() + "'"))
  end
  let hi = match snapshot_parse_uint(text.slice(0, at))
  when Result::Err(_) then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' has a malformed digest high word: '" + text.clone() + "'"))
  when Result::Ok(v) then v
  end
  let lo = match snapshot_parse_uint(text.slice(at + 1, text.len()))
  when Result::Err(_) then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' has a malformed digest low word: '" + text.clone() + "'"))
  when Result::Ok(v) then v
  end
  Result::Ok(StableDigest { hi: hi, lo: lo })
end

# One JSON string starting at char index `at` of the line (the opening
# quote): returns the UNESCAPED text and the index just past the closing
# quote. The serializer emits exactly the \" \\ \n \r \t escapes
# (semantic_json_escape), so any other escape fails closed rather than
# guessing.
def snapshot_scan_string(line: String, at: Int, line_no: Int, tag: String) -> Result[(String, Int), String]
  let cs = line.chars()
  var out = String::new()
  var i = at + 1
  while i < cs.len() do
    let c = cs[i]
    if c == '"' then
      return Result::Ok((out, i + 1))
    end
    if c == '\\' then
      if i + 1 >= cs.len() then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "unterminated escape sequence"))
      end
      let e = cs[i + 1]
      if e == '"' then
        out.push('"')
      elsif e == '\\' then
        out.push('\\')
      elsif e == 'n' then
        out.push('\n')
      elsif e == 'r' then
        out.push('\r')
      elsif e == 't' then
        out.push('\t')
      else
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "unknown escape sequence in a string field"))
      end
      i = i + 2
    else
      out.push(c)
      i = i + 1
    end
  end
  Result::Err(snapshot_line_error(line_no, tag.clone(), "unterminated string field"))
end

# One row line -> its ordered field list. The object must be exactly one
# {...} object; keys must be quoted, values quoted-or-raw, fields
# comma-separated with no duplicates and no trailing comma; a value or
# string that crosses the object's closing brace fails closed.
def snapshot_scan_object(line: String, line_no: Int) -> Result[Vec[SnapshotField], String]
  let cs = line.chars()
  let tag = "row".to_string()
  if cs.len() < 2 then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "not a JSON object"))
  end
  if cs[0] != '{' || cs[cs.len() - 1] != '}' then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "a row must be one JSON object"))
  end
  var fields: Vec[SnapshotField] = Vec::new()
  var i = 1
  let stop = cs.len() - 1
  while i < stop do
    if cs[i] != '"' then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "expected a quoted field name"))
    end
    let key_pair = match snapshot_scan_string(line.clone(), i, line_no, tag.clone())
    when Result::Err(e) then return Result::Err(e)
    when Result::Ok(p) then p
    end
    let key = key_pair.0.clone()
    i = key_pair.1
    if i > stop || cs[i] != ':' then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "expected ':' after field '" + key.clone() + "'"))
    end
    i = i + 1
    var value_text = ""
    var quoted = false
    if i < cs.len() && cs[i] == '"' then
      let string_pair = match snapshot_scan_string(line.clone(), i, line_no, tag.clone())
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(p) then p
      end
      if string_pair.1 > stop then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "string field '" + key.clone() + "' crosses the row boundary"))
      end
      value_text = string_pair.0.clone()
      i = string_pair.1
      quoted = true
    else
      var raw = String::new()
      while i < stop && cs[i] != ',' do
        raw.push(cs[i])
        i = i + 1
      end
      value_text = raw
    end
    var duplicate = false
    for f in fields do
      if f.key == key then
        duplicate = true
      end
    end
    if duplicate then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "duplicate field '" + key.clone() + "'"))
    end
    fields.push(SnapshotField { key: key.clone(), text: value_text.clone(), quoted: quoted })
    if i < stop then
      if cs[i] != ',' then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "expected ',' between fields"))
      end
      i = i + 1
      if i >= stop then
        return Result::Err(snapshot_line_error(line_no, tag.clone(), "trailing ',' in row"))
      end
    end
  end
  Result::Ok(fields)
end

def snapshot_field_lookup(fields: Vec[SnapshotField], key: String) -> Option[SnapshotField]
  for f in fields do
    if f.key == key then
      return Option::Some(f)
    end
  end
  Option::None
end

def snapshot_require_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[SnapshotField, String]
  match snapshot_field_lookup(fields.clone(), key.clone())
  when Option::Some(f) then Result::Ok(f)
  when Option::None then Result::Err(snapshot_line_error(line_no, tag.clone(), "missing field '" + key.clone() + "'"))
  end
end

def snapshot_string_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[String, String]
  let f = match snapshot_require_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  if !f.quoted then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' must be a quoted string"))
  end
  Result::Ok(f.text.clone())
end

def snapshot_raw_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[String, String]
  let f = match snapshot_require_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  if f.quoted then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' must be an unquoted scalar"))
  end
  Result::Ok(f.text.clone())
end

def snapshot_int_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[Int, String]
  let raw = match snapshot_raw_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  match raw.parse_int()
  when Result::Ok(v) then Result::Ok(v)
  when Result::Err(_) then
    Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' is not an integer: '" + raw.clone() + "'"))
  end
end

def snapshot_bool_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[Bool, String]
  let raw = match snapshot_raw_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  if raw == "true" then
    return Result::Ok(true)
  end
  if raw == "false" then
    return Result::Ok(false)
  end
  Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' is not a boolean: '" + raw.clone() + "'"))
end

def snapshot_digest_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[StableDigest, String]
  let raw = match snapshot_string_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  snapshot_parse_digest(raw, tag, key, line_no)
end

def snapshot_int_list_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[Vec[Int], String]
  let raw = match snapshot_string_field(fields.clone(), key.clone(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  var out: Vec[Int] = Vec::new()
  for part in snapshot_split_commas(raw.clone()) do
    match part.parse_int()
    when Result::Err(_) then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' is not a comma-joined int list: '" + raw.clone() + "'"))
    when Result::Ok(v) then
      out.push(v)
    end
  end
  Result::Ok(out)
end

def snapshot_def_id_raw(key: String, digest: StableDigest) -> StableDefId
  StableDefId {
    hash: digest.lo,
    key: key.clone(),
    path: stable_key_name_part(&key),
    id: digest.lo,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

def snapshot_def_kind_of_word(word: String) -> Result[DefKind, String]
  if word == "Function" then
    return Result::Ok(DefKind::Function)
  end
  if word == "Method" then
    return Result::Ok(DefKind::Method)
  end
  if word == "Static" then
    return Result::Ok(DefKind::Static)
  end
  if word == "Constant" then
    return Result::Ok(DefKind::Constant)
  end
  if word == "EnumVariant" then
    return Result::Ok(DefKind::EnumVariant)
  end
  if word == "StructField" then
    return Result::Ok(DefKind::StructField)
  end
  if word == "Intrinsic" then
    return Result::Ok(DefKind::Intrinsic)
  end
  if word == "TypeName" then
    return Result::Ok(DefKind::TypeName)
  end
  if word == "Trait" then
    return Result::Ok(DefKind::Trait)
  end
  if word == "Other" then
    return Result::Ok(DefKind::Other)
  end
  Result::Err("unknown def kind word '" + word.clone() + "'")
end

def snapshot_type_kind_of_word(word: String) -> Result[SemanticTypeKind, String]
  if word == "Struct" then
    return Result::Ok(SemanticTypeKind::Struct)
  end
  if word == "Enum" then
    return Result::Ok(SemanticTypeKind::Enum)
  end
  if word == "Trait" then
    return Result::Ok(SemanticTypeKind::Trait)
  end
  Result::Err("unknown type kind word '" + word.clone() + "'")
end

def snapshot_call_kind_of_word(word: String) -> Result[CallEdgeKind, String]
  if word == "Direct" then
    return Result::Ok(CallEdgeKind::Direct)
  end
  if word == "Indirect" then
    return Result::Ok(CallEdgeKind::Indirect)
  end
  if word == "Intrinsic" then
    return Result::Ok(CallEdgeKind::Intrinsic)
  end
  Result::Err("unknown call kind word '" + word.clone() + "'")
end

def snapshot_capability_kind_of_word(word: String) -> Result[CapabilityEdgeKind, String]
  if word == "Requires" then
    return Result::Ok(CapabilityEdgeKind::Requires)
  end
  if word == "Provides" then
    return Result::Ok(CapabilityEdgeKind::Provides)
  end
  Result::Err("unknown capability direction word '" + word.clone() + "'")
end

def snapshot_contract_kind_of_word(word: String) -> Result[AstContractKind, String]
  if word == "Pre" then
    return Result::Ok(AstContractKind::AstPre)
  end
  if word == "Post" then
    return Result::Ok(AstContractKind::AstPost)
  end
  if word == "Invariant" then
    return Result::Ok(AstContractKind::AstInvariant)
  end
  Result::Err("unknown contract kind word '" + word.clone() + "'")
end

def snapshot_access_convention_of_number(n: Int) -> Result[AccessConvention, String]
  if n == 0 then
    return Result::Ok(AccessConvention::Let)
  end
  if n == 1 then
    return Result::Ok(AccessConvention::Inout)
  end
  if n == 2 then
    return Result::Ok(AccessConvention::Sink)
  end
  if n == 3 then
    return Result::Ok(AccessConvention::Set)
  end
  Result::Err("unknown access convention number " + n.to_string())
end

def snapshot_unsafe_kind_of_word(word: String) -> Result[UnsafeKind, String]
  if word == "unsafe-block" then
    return Result::Ok(UnsafeKind::UnsafeBlock)
  end
  if word == "unsafe-fn" then
    return Result::Ok(UnsafeKind::UnsafeFunction)
  end
  if word == "raw-deref" then
    return Result::Ok(UnsafeKind::RawDeref)
  end
  if word == "raw-pointer-cast" then
    return Result::Ok(UnsafeKind::RawPointerCast)
  end
  if word == "transmute" then
    return Result::Ok(UnsafeKind::Transmute)
  end
  if word == "unchecked-index" then
    return Result::Ok(UnsafeKind::UncheckedIndex)
  end
  if word == "extern-call" then
    return Result::Ok(UnsafeKind::ExternBoundary)
  end
  if word == "inline-asm" then
    return Result::Ok(UnsafeKind::InlineAsm)
  end
  if word == "volatile-raw-access" then
    return Result::Ok(UnsafeKind::VolatileRawAccess)
  end
  if word == "unsafe-trait-impl" then
    return Result::Ok(UnsafeKind::UnsafeTraitImpl)
  end
  if word == "unknown-call" then
    return Result::Ok(UnsafeKind::UnknownUnsafeCall)
  end
  Result::Err("unknown unsafe kind word '" + word.clone() + "'")
end

# The inverse of snapshot_caps_text + semantic_summary_dirty_word: the
# 7-bit dirty word expands in declaration order, the ';'-joined capability
# ids rebuild the Set (empty run = empty set).
def snapshot_effect_summary_of(flags: Int, caps_text: String, line_no: Int, tag: String, key: String) -> Result[EffectSummary, String]
  if flags < 0 || flags > 127 then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' is not a 7-bit dirty word: " + flags.to_string()))
  end
  var w = flags
  let may_allocate = w % 2 == 1
  w = w / 2
  let may_block = w % 2 == 1
  w = w / 2
  let may_io = w % 2 == 1
  w = w / 2
  let may_spawn = w % 2 == 1
  w = w / 2
  let may_sleep = w % 2 == 1
  w = w / 2
  let may_panic = w % 2 == 1
  w = w / 2
  let may_unsafe = w % 2 == 1
  var caps: Set[CapabilityId] = Set::new()
  for part in snapshot_split_semicolons(caps_text.clone()) do
    match part.parse_int()
    when Result::Err(_) then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' carries a malformed capability id: '" + part.clone() + "'"))
    when Result::Ok(id) then
      caps.insert(CapabilityId { id: id })
    end
  end
  Result::Ok(EffectSummary {
    may_allocate: may_allocate,
    may_block: may_block,
    may_io: may_io,
    may_spawn: may_spawn,
    may_sleep: may_sleep,
    may_panic: may_panic,
    may_unsafe: may_unsafe,
    capabilities: caps
  })
end

# The inverse of semantic_contract_expr_text: everything before the first
# '(' is the op, the run between the first '(' and the final ')' splits
# into args. Splitting the payload on ',' is lossy for an arg that itself
# contains ',' or ')' — but the re-joined render is byte-identical for
# EVERY split of the inner run, which is exactly the exact-inverse
# property (the snapshot stores the canonical render, not the parse tree).
def snapshot_contract_ir_of_text(text: String, line_no: Int, tag: String) -> Result[ContractExprIR, String]
  var open_at = -1
  var i = 0
  while i < text.len() do
    if text.slice(i, i + 1) == "(" then
      open_at = i
      break
    end
    i = i + 1
  end
  if open_at < 0 then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field 'text' is not a canonical 'op(args)' clause: '" + text.clone() + "'"))
  end
  if text.slice(text.len() - 1, text.len()) != ")" then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field 'text' does not end with ')': '" + text.clone() + "'"))
  end
  Result::Ok(ContractExprIR {
    op: text.slice(0, open_at),
    args: snapshot_split_commas(text.slice(open_at + 1, text.len() - 1)),
    resolved_refs: Vec::new()
  })
end

# One OPTIONAL ";;"-joined string-list field (the P1-5 header additions):
# absent -> empty (a pre-P1-5 artifact loads with no feature rows); present
# -> the ";;" split (an empty string is the empty list).
def snapshot_opt_string_list_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[Vec[String], String]
  match snapshot_field_lookup(fields.clone(), key.clone())
  when Option::None then Result::Ok(Vec::new())
  when Option::Some(f) then
    if !f.quoted then
      return Result::Err(snapshot_line_error(line_no, tag.clone(), "field '" + key.clone() + "' must be a quoted string"))
    end
    Result::Ok(snapshot_split_double_semicolons(f.text.clone()))
  end
end

# One OPTIONAL digest field: absent -> zero (a pre-P1-5 artifact carries no
# per-domain digests; the table digests are recomputed by finalize).
def snapshot_opt_digest_field(fields: Vec[SnapshotField], key: String, tag: String, line_no: Int) -> Result[StableDigest, String]
  match snapshot_field_lookup(fields.clone(), key.clone())
  when Option::None then Result::Ok(semantic_digest_zero())
  when Option::Some(_) then snapshot_digest_field(fields.clone(), key.clone(), tag.clone(), line_no)
  end
end

def snapshot_parse_header_row(fields: Vec[SnapshotField], line_no: Int) -> Result[SnapshotParsedHeader, String]
  let tag = "header".to_string()
  let version = match snapshot_int_field(fields.clone(), "v".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  if version != 1 then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "unsupported snapshot version " + version.to_string() + " (expected 1)"))
  end
  let format = match snapshot_string_field(fields.clone(), "format".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  if format != "tg-semantic-snapshot/v1" then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "unsupported snapshot format '" + format.clone() + "'"))
  end
  let compiler_version = match snapshot_string_field(fields.clone(), "compiler_version".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  # (fourth-audit P1-5a) the feature/option header payload.
  let feature_set = match snapshot_opt_string_list_field(fields.clone(), "features".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let semantic_options = match snapshot_opt_string_list_field(fields.clone(), "options".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let triple = match snapshot_string_field(fields.clone(), "target".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let arch = match snapshot_string_field(fields.clone(), "tarch".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let cpu = match snapshot_string_field(fields.clone(), "tcpu".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let pointer_width = match snapshot_int_field(fields.clone(), "tptr".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let endian = match snapshot_string_field(fields.clone(), "tendian".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let abi = match snapshot_string_field(fields.clone(), "tabi".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let float_abi = match snapshot_string_field(fields.clone(), "tfloat".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let isa_text = match snapshot_string_field(fields.clone(), "tisa".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let native_atomic_widths = match snapshot_int_list_field(fields.clone(), "tnative".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let tident_text = match snapshot_string_field(fields.clone(), "tident".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let tident = match snapshot_parse_digest(tident_text, tag.clone(), "tident".to_string(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let tdigest = match snapshot_digest_field(fields.clone(), "tdigest".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let target = StableTargetId {
    triple: triple,
    arch: arch,
    cpu: cpu,
    pointer_width: pointer_width,
    endian: endian,
    abi: abi,
    float_abi: float_abi,
    isa_features: snapshot_split_commas(isa_text),
    native_atomic_widths: native_atomic_widths,
    digest_hi: tdigest.hi,
    digest_lo: tdigest.lo
  }
  let recomputed = stable_digest_of(&snapshot_target_fields_text(&target))
  if recomputed.hi != tident.hi || recomputed.lo != tident.lo then
    return Result::Err(snapshot_line_error(line_no, tag.clone(), "field 'tident' does not match the target fields (stale or corrupted header)"))
  end
  let revision = match snapshot_digest_field(fields.clone(), "revision".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let public_api_hash = match snapshot_digest_field(fields.clone(), "public_api_hash".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let abi_hash = match snapshot_digest_field(fields.clone(), "abi_hash".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let unsafe_hash = match snapshot_digest_field(fields.clone(), "unsafe_hash".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  # (fourth-audit P1-5c) the per-domain digest rows (optional on read).
  let d_concrete_types = match snapshot_opt_digest_field(fields.clone(), "d_concrete_types".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let d_drop_plans = match snapshot_opt_digest_field(fields.clone(), "d_drop_plans".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let d_allocation_sites = match snapshot_opt_digest_field(fields.clone(), "d_allocation_sites".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let d_features = match snapshot_opt_digest_field(fields.clone(), "d_features".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let domain_digests = SemanticDomainDigests {
    public_api: public_api_hash.clone(),
    abi: abi_hash.clone(),
    unsafe_: unsafe_hash.clone(),
    concrete_types: d_concrete_types,
    drop_plans: d_drop_plans,
    allocation_sites: d_allocation_sites,
    features: d_features
  }
  Result::Ok(SnapshotParsedHeader {
    revision: revision,
    compiler_version: compiler_version,
    target: target,
    feature_set: feature_set,
    semantic_options: semantic_options,
    domain_digests: domain_digests,
    public_api_hash: public_api_hash,
    abi_hash: abi_hash,
    unsafe_hash: unsafe_hash
  })
end

def snapshot_parse_symbol_row(fields: Vec[SnapshotField], line_no: Int) -> Result[SemanticSymbol, String]
  let tag = "symbol".to_string()
  let digest = match snapshot_digest_field(fields.clone(), "i".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let key = match snapshot_string_field(fields.clone(), "key".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind_word = match snapshot_string_field(fields.clone(), "kind".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind = match snapshot_def_kind_of_word(kind_word.clone())
  when Result::Err(e) then return Result::Err(snapshot_line_error(line_no, tag.clone(), e))
  when Result::Ok(v) then v
  end
  let name = match snapshot_string_field(fields.clone(), "name".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let module_path = match snapshot_string_field(fields.clone(), "module".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let is_pub = match snapshot_bool_field(fields.clone(), "pub".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let is_generic = match snapshot_bool_field(fields.clone(), "generic".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  Result::Ok(SemanticSymbol {
    stable_id: snapshot_def_id_raw(key, digest),
    kind: kind,
    name: name,
    module_path: module_path,
    is_pub: is_pub,
    is_generic: is_generic
  })
end

