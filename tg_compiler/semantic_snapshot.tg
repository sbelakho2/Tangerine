  when Result::Ok(v) then v
  end
  let index = match snapshot_int_field(fields.clone(), "index".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let ty = match snapshot_string_field(fields.clone(), "ty".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let member_id = match snapshot_string_field(fields.clone(), "member".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let is_pub = match snapshot_bool_field(fields.clone(), "pub".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  Result::Ok(SemanticField {
    owner: snapshot_def_id_raw("".to_string(), owner_digest),
    name: name,
    index: index,
    ty: ty,
    member_id: member_id,
    is_pub: is_pub
  })
end

