  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let function_digest = match snapshot_digest_field(fields.clone(), "f".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind_word = match snapshot_string_field(fields.clone(), "ckind".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let kind = match snapshot_contract_kind_of_word(kind_word.clone())
  when Result::Err(e) then return Result::Err(snapshot_line_error(line_no, tag.clone(), e))
  when Result::Ok(v) then v
  end
  let text = match snapshot_string_field(fields.clone(), "text".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let canonical_expression = match snapshot_contract_ir_of_text(text, line_no, tag.clone())
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let fingerprint = match snapshot_digest_field(fields.clone(), "fp".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  let message_text = match snapshot_string_field(fields.clone(), "msg".to_string(), tag.clone(), line_no)
  when Result::Err(e) then return Result::Err(e)
  when Result::Ok(v) then v
  end
  var message: Option[String] = Option::None
  if message_text.len() > 0 then
    message = Option::Some(message_text)
  end
  Result::Ok(ContractFact {
    id: StableContractId { dense_id: -1, stable_key: "".to_string(), digest_hi: digest.hi, digest_lo: digest.lo },
    function: snapshot_def_id_raw("".to_string(), function_digest),
    kind: kind,
    expression_fingerprint: fingerprint,
    canonical_expression: canonical_expression,
    message: message
  })
end

