use std::core::{Option, panic}
use std::collections::{Vec}
use tg_compiler::token::{Span}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody, TraitMethod, ExternItem,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind, Param,
  GuardElse, MatchExpr, IfStmt, ForStmt, AstPath
}
use tg_compiler::types::{AccessEffect, TypedProgram, Type, ParamType, TypedExprKind}
use tg_compiler::ids::{FieldId, AccessId, AccessRoot, LocalId, DefId}
use tg_compiler::resource_check::{
  TypedCFG, CfgEdgeKind, stmt_is_terminator, AnalysisContext,
  access_registry_fresh_id, access_registry_register
}

enum AccessProjection
  Field(FieldId, String)
  Index
  # Raw-pointer dereference: provenance is unknown, so a path containing
  # this projection must never be assumed disjoint from other paths.
  RawDeref
end

# the TYPED PLACE of an access — the semantic root (AccessRoot:
# Local(LocalId)/SelfValue/Static(DefId)/RawUnknown — ids.tg) plus the
# projection chain. This replaces the former integer-root AccessPath
# (the "local integer or magic self/raw value" sentinels — root: Int
# with -1 for `self` and unresolved fallbacks — are GONE). Roots compare
# structurally, never by a naked integer or by name.
struct TypedPlace
  root: AccessRoot
  projections: Vec[AccessProjection]
end

struct ActiveAccess
  path: TypedPlace
  effect: AccessEffect
end

struct AccessError
  message: String
  span: Span
end

# the access checker consumes THE SAME TYPED CFG as the resource
# checker (the ONE TypedCFG — built ONCE by the pipeline's build_typed_cfg
# — the shared structural pass that records every control-flow decision as
# CfgEdge/CfgBlock records BEFORE any analysis state runs; the pipeline
# passes the instance in). The recursive source-tree analysis is replaced by
# a CFG-DRIVEN walk: each statement/condition is visited through the CFG's
# blocks, and every access path is attached to the CFG edge its call site
# originates (registered in the shared AnalysisContext access
# registry keyed by the CfgEdgeId — the exact set of successor edges of the
# site's source node; the resource checker's CleanupAction::EndAccess names
# the registered AccessIds when the edge's cleanup runs). The overlap
# analysis (paths_overlap) operates on the semantic AccessRoot paths.
# the registry and the fresh-id counter live in the AnalysisContext —
# fresh per compilation (analysis_context_new), so no reset protocol exists
# here (the former access_registry_reset protocol). The pipeline runs
# access_check BEFORE resource_check for the same program and threads the
# SAME context through both.
pub def access_check(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext) -> Vec[AccessError]
  mut errors = Vec::new()
  mut i = 0
  while i < program.items.len() do
    check_item_cfg(program, typed, cfg, ctx, &program.items[i], &mut errors)
    i = i + 1
  end
  errors
end

# the item-level CFG walk (the check_item mirror — same coverage,
# CFG-driven).
def check_item_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, item: Item, inout errors: Vec[AccessError]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    check_function_cfg(program, typed, cfg, ctx, &f, errors)
  when ItemKind::ItemStruct(s) then
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then check_expr_cfg(program, typed, cfg, ctx, &e, e.node_id, errors)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      check_function_cfg(program, typed, cfg, ctx, &s.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then check_expr_cfg(program, typed, cfg, ctx, &d, d.node_id, errors)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      check_trait_method_cfg(program, typed, cfg, ctx, &t.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      check_function_cfg(program, typed, cfg, ctx, &im.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      check_item_cfg(program, typed, cfg, ctx, &m.items[i], errors)
      i = i + 1
    end
  when ItemKind::ItemUse(_) then ()
  when ItemKind::ItemMacro(mac) then
    check_block_cfg(program, typed, cfg, ctx, &mac.body, errors)
  when ItemKind::ItemTypeAlias(_) then ()
  when ItemKind::ItemConst(c) then
    check_expr_cfg(program, typed, cfg, ctx, &c.value, c.value.node_id, errors)
  when ItemKind::ItemStatic(s) then
    check_expr_cfg(program, typed, cfg, ctx, &s.value, s.value.node_id, errors)
  when ItemKind::ItemCapabilityDecl(_) then ()
  when ItemKind::ItemEffectDecl(_) then ()
  when ItemKind::ItemRationaleBlock(_) then ()
  when ItemKind::ItemEditionDecl(_) then ()
  when ItemKind::ItemExternBlock(ext) then
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        check_params_defaults_cfg(program, typed, cfg, ctx, &ef.params, errors)
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  end
end

def check_function_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, f: FunctionDecl, inout errors: Vec[AccessError]) -> Unit
  check_params_defaults_cfg(program, typed, cfg, ctx, &f.params, errors)
  mut i = 0
  while i < f.contracts.len() do
    check_expr_cfg(program, typed, cfg, ctx, &f.contracts[i].expr, f.contracts[i].expr.node_id, errors)
    i = i + 1
  end
  check_fn_body_cfg(program, typed, cfg, ctx, &f.body, errors)
end

def check_trait_method_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, m: TraitMethod, inout errors: Vec[AccessError]) -> Unit
  check_params_defaults_cfg(program, typed, cfg, ctx, &m.sig.params, errors)
  check_fn_body_cfg(program, typed, cfg, ctx, &m.default_body, errors)
end

def check_params_defaults_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, params: Vec[Param], inout errors: Vec[AccessError]) -> Unit
  mut i = 0
  while i < params.len() do
    match params[i].default
    when Option::Some(e) then check_expr_cfg(program, typed, cfg, ctx, &e, e.node_id, errors)
    when Option::None then ()
    end
    i = i + 1
  end
end

def check_fn_body_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, body: FnBody, inout errors: Vec[AccessError]) -> Unit
  match body
  when FnBody::FnBlock(b) then check_block_cfg(program, typed, cfg, ctx, &b, errors)
  when FnBody::FnExpr(e) then check_expr_cfg(program, typed, cfg, ctx, &e, e.node_id, errors)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end
end

# / THE CFG WALK of one lexical block — the statements are
# visited through the SAME pre-built block model the resource checker walks
# (the TypedCFG records ONE CfgBlock per lexical block, id = the block's
# first-statement node id; the per-block flow reconstruction is
# gone — the flat statement list IS the block, with the terminator
# classification as the only node distinction). Each statement's accesses
# are attached to the CFG edge the statement originates:
#   - a terminator statement (return/break/continue) attaches to its
#     terminator edge (Return/Break/Continue — the edge's source IS the
#     statement's node id);
#   - a Linear statement attaches to the block's Normal edge (the
#     fallthrough — the edge's source is the block's first-statement id).
# If/elsif conditions attach to their True/False split edges and guard
# conditions to the GuardElse edge (their sources are the respective node
# ids) — the check_stmt_cfg dispatch below.
def check_block_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, block: Block, inout errors: Vec[AccessError]) -> Unit
  let blk_key = if block.stmts.len() > 0 then block.stmts[0].node_id else 0 end
  mut i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    let edge_source = if stmt_is_terminator(&stmt) then stmt.node_id else blk_key end
    check_stmt_cfg(program, typed, cfg, ctx, &stmt, edge_source, errors)
    i = i + 1
  end
end

# the terminator classification is the resource checker's shared
# predicate (the statement-flattening Linear/Terminator split —
# return/break/continue are the only flow terminators).

# the statement-level CFG walk — the check_stmt mirror with the
# access paths attached to the statement's CFG edge (`edge_source` — the
# edge's source node id, the ACCESS_REGISTRY key). Nested blocks recurse
# into their own flow walks; conditions attach to their own split/guard
# edges.
def check_stmt_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, stmt: Stmt, edge_source: Int, inout errors: Vec[AccessError]) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    check_pattern_cfg(program, typed, cfg, ctx, &pattern, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &value, edge_source, errors)
  when StmtKind::StmtAssign(target, value) then
    check_expr_cfg(program, typed, cfg, ctx, &target, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &value, edge_source, errors)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    check_expr_cfg(program, typed, cfg, ctx, &target, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &value, edge_source, errors)
  when StmtKind::StmtIf(if_stmt) then
    # The condition's accesses attach to the True/False split edges (the
    # condition's node id is their source).
    check_expr_cfg(program, typed, cfg, ctx, &if_stmt.cond, if_stmt.cond.node_id, errors)
    check_block_cfg(program, typed, cfg, ctx, &if_stmt.then_block, errors)
    mut i = 0
    while i < if_stmt.elsif_branches.len() do
      check_expr_cfg(program, typed, cfg, ctx, &if_stmt.elsif_branches[i].0, if_stmt.elsif_branches[i].0.node_id, errors)
      check_block_cfg(program, typed, cfg, ctx, &if_stmt.elsif_branches[i].1, errors)
      i = i + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then check_block_cfg(program, typed, cfg, ctx, &eb, errors)
    when Option::None then ()
    end
  when StmtKind::StmtMatch(m) then
    check_match_cfg(program, typed, cfg, ctx, &m, edge_source, errors)
  when StmtKind::StmtWhile(cond, body) then
    # The condition's accesses attach to the loop's Backedge edge (the
    # loop statement's node id is its source).
    check_expr_cfg(program, typed, cfg, ctx, &cond, stmt.node_id, errors)
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
  when StmtKind::StmtFor(for_stmt) then
    check_pattern_cfg(program, typed, cfg, ctx, &for_stmt.pattern, stmt.node_id, errors)
    check_expr_cfg(program, typed, cfg, ctx, &for_stmt.iter, stmt.node_id, errors)
    check_block_cfg(program, typed, cfg, ctx, &for_stmt.body, errors)
  when StmtKind::StmtLoop(body) then
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr_cfg(program, typed, cfg, ctx, &val, edge_source, errors)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr_cfg(program, typed, cfg, ctx, &val, edge_source, errors)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtExpr(e) then
    check_expr_cfg(program, typed, cfg, ctx, &e, edge_source, errors)
  when StmtKind::StmtUnsafe(_, body) then
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
  when StmtKind::StmtDefer(body) then
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
  when StmtKind::StmtGuard(cond, else_action) then
    # The guard's condition and else-action accesses attach to the
    # GuardElse edge (the guard statement's node id is its source).
    check_expr_cfg(program, typed, cfg, ctx, &cond, stmt.node_id, errors)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then check_expr_cfg(program, typed, cfg, ctx, &val, stmt.node_id, errors)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then check_expr_cfg(program, typed, cfg, ctx, &val, stmt.node_id, errors)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
    mut i = 0
    while i < catches.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &catches[i].pattern, edge_source, errors)
      check_block_cfg(program, typed, cfg, ctx, &catches[i].body, errors)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then check_block_cfg(program, typed, cfg, ctx, &fb, errors)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, _, body) then
    check_expr_cfg(program, typed, cfg, ctx, &expr, edge_source, errors)
    check_block_cfg(program, typed, cfg, ctx, &body, errors)
  when StmtKind::StmtHandleWith(expr, handlers) then
    check_expr_cfg(program, typed, cfg, ctx, &expr, edge_source, errors)
    mut i = 0
    while i < handlers.len() do
      mut j = 0
      while j < handlers[i].arms.len() do
        check_block_cfg(program, typed, cfg, ctx, &handlers[i].arms[j].body, errors)
        j = j + 1
      end
      i = i + 1
    end
  end
end

def check_match_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, m: MatchExpr, edge_source: Int, inout errors: Vec[AccessError]) -> Unit
  check_expr_cfg(program, typed, cfg, ctx, &m.scrutinee, edge_source, errors)
  mut i = 0
  while i < m.arms.len() do
    check_pattern_cfg(program, typed, cfg, ctx, &m.arms[i].pattern, edge_source, errors)
    match m.arms[i].guard_expr
    when Option::Some(g) then check_expr_cfg(program, typed, cfg, ctx, &g, edge_source, errors)
    when Option::None then ()
    end
    check_block_cfg(program, typed, cfg, ctx, &m.arms[i].body, errors)
    i = i + 1
  end
end

def check_pattern_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, pat: Pattern, edge_source: Int, inout errors: Vec[AccessError]) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(e) then check_expr_cfg(program, typed, cfg, ctx, &e, edge_source, errors)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &pats[i], edge_source, errors)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &pats[i], edge_source, errors)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &field_pats[i].1, edge_source, errors)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &pats[i], edge_source, errors)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &alts[i], edge_source, errors)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then check_expr_cfg(program, typed, cfg, ctx, &e, edge_source, errors)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then check_expr_cfg(program, typed, cfg, ctx, &e, edge_source, errors)
    when Option::None then ()
    end
  end
end

def check_expr_cfg(program: Program, typed: TypedProgram, cfg: TypedCFG, inout ctx: AnalysisContext, expr: Expr, edge_source: Int, inout errors: Vec[AccessError]) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr_cfg(program, typed, cfg, ctx, &elems[i], edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr_cfg(program, typed, cfg, ctx, &elems[i], edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      check_expr_cfg(program, typed, cfg, ctx, &fields[i].1, edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      check_expr_cfg(program, typed, cfg, ctx, &entries[i].0, edge_source, errors)
      check_expr_cfg(program, typed, cfg, ctx, &entries[i].1, edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then ()
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    check_expr_cfg(program, typed, cfg, ctx, &lhs, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &rhs, edge_source, errors)
  when ExprKind::ExprUnaryOp(_, operand) then
    check_expr_cfg(program, typed, cfg, ctx, &operand, edge_source, errors)
  when ExprKind::ExprFieldAccess(base, _) then
    check_expr_cfg(program, typed, cfg, ctx, &base, edge_source, errors)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    check_expr_cfg(program, typed, cfg, ctx, &recv, edge_source, errors)
    mut mi = 0
    while mi < args.len() do
      check_expr_cfg(program, typed, cfg, ctx, &args[mi], edge_source, errors)
      mi = mi + 1
    end
    check_expr_method_call_cfg(typed, &recv, &args, expr.node_id, errors, edge_source, cfg, ctx)
  when ExprKind::ExprIndex(base, index) then
    check_expr_cfg(program, typed, cfg, ctx, &base, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &index, edge_source, errors)
  when ExprKind::ExprCall(callee, args) then
    check_expr_cfg(program, typed, cfg, ctx, &callee, edge_source, errors)
    mut ci = 0
    while ci < args.len() do
      check_expr_cfg(program, typed, cfg, ctx, &args[ci], edge_source, errors)
      ci = ci + 1
    end
    check_expr_call_cfg(typed, &callee, &args, expr.node_id, errors, edge_source, cfg, ctx)
  when ExprKind::ExprClosure(params, _, body) then
    mut i = 0
    while i < params.len() do
      check_pattern_cfg(program, typed, cfg, ctx, &params[i].pat, edge_source, errors)
      i = i + 1
    end
    check_expr_cfg(program, typed, cfg, ctx, &body, expr.node_id, errors)
  when ExprKind::ExprAccess(inner) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprRawDeref(inner) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprIf(if_stmt) then
    # The condition's accesses attach to the expression-split True/False
    # edges (the condition's node id is their source).
    check_expr_cfg(program, typed, cfg, ctx, &if_stmt.cond, if_stmt.cond.node_id, errors)
    check_block_cfg(program, typed, cfg, ctx, &if_stmt.then_block, errors)
    mut i = 0
    while i < if_stmt.elsif_branches.len() do
      check_expr_cfg(program, typed, cfg, ctx, &if_stmt.elsif_branches[i].0, if_stmt.elsif_branches[i].0.node_id, errors)
      check_block_cfg(program, typed, cfg, ctx, &if_stmt.elsif_branches[i].1, errors)
      i = i + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then check_block_cfg(program, typed, cfg, ctx, &eb, errors)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    check_match_cfg(program, typed, cfg, ctx, &m, edge_source, errors)
  when ExprKind::ExprBlock(block) then
    check_block_cfg(program, typed, cfg, ctx, &block, errors)
  when ExprKind::ExprUnsafe(_, block) then
    check_block_cfg(program, typed, cfg, ctx, &block, errors)
  when ExprKind::ExprAsync(block) then
    check_block_cfg(program, typed, cfg, ctx, &block, errors)
  when ExprKind::ExprAwait(inner) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprTry(inner) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then check_expr_cfg(program, typed, cfg, ctx, &s, edge_source, errors)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then check_expr_cfg(program, typed, cfg, ctx, &e, edge_source, errors)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprTypeCheck(inner, _) then check_expr_cfg(program, typed, cfg, ctx, &inner, edge_source, errors)
  when ExprKind::ExprComptime(block) then check_block_cfg(program, typed, cfg, ctx, &block, errors)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr_cfg(program, typed, cfg, ctx, &args[i], edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    check_expr_cfg(program, typed, cfg, ctx, &target, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &value, edge_source, errors)
  when ExprKind::ExprPipe(lhs, rhs) then
    check_expr_cfg(program, typed, cfg, ctx, &lhs, edge_source, errors)
    check_expr_cfg(program, typed, cfg, ctx, &rhs, edge_source, errors)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr_cfg(program, typed, cfg, ctx, &args[i], edge_source, errors)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end
end

def check_expr_call_cfg(typed: TypedProgram, callee: Expr, args: Vec[Expr], call_node_id: Int, inout errors: Vec[AccessError], edge_source: Int, cfg: TypedCFG, inout ctx: AnalysisContext) -> Unit
  let effects = call_arg_effects(typed, call_node_id, Option::Some(callee), args)
  check_call_site_cfg(Option::None, AccessEffect::Read, &effects, args, typed, errors, edge_source, cfg, ctx)
end

def check_expr_method_call_cfg(typed: TypedProgram, receiver: Expr, args: Vec[Expr], call_node_id: Int, inout errors: Vec[AccessError], edge_source: Int, cfg: TypedCFG, inout ctx: AnalysisContext) -> Unit
  let recv_effect = method_receiver_effect(typed, &receiver, call_node_id)
  let effects = call_arg_effects(typed, call_node_id, Option::None, args)
  check_call_site_cfg(Option::Some(receiver), recv_effect, &effects, args, typed, errors, edge_source, cfg, ctx)
end

def check_call_site_cfg(receiver: Option[Expr], receiver_effect: AccessEffect, arg_effects: Vec[AccessEffect], args: Vec[Expr], typed: TypedProgram, inout errors: Vec[AccessError], edge_source: Int, cfg: TypedCFG, inout ctx: AnalysisContext) -> Unit
  mut actives = Vec::new()
  mut spans = Vec::new()
  match receiver
  when Option::Some(r) then
    record_access(typed, r, receiver_effect, &mut actives, &mut spans, errors, edge_source, cfg, ctx)
  when Option::None then ()
  end
  mut i = 0
  while i < args.len() do
    # call_arg_effects pushes exactly one effect per argument, so a shorter
    # vector is a compiler-internal error — never a silent Read.
    if i >= arg_effects.len() then
      panic("internal error: missing access effect vector entry for argument node " + args[i].node_id.to_string())
    end
    let eff = arg_effects[i]
    record_access(typed, &args[i], eff, &mut actives, &mut spans, errors, edge_source, cfg, ctx)
    i = i + 1
  end
  check_overlaps(typed, &actives, &spans, errors)
end

# the CfgEdgeId set of every successor edge of a site's source node —
# all edges whose source is that node id (node ids are globally unique, so
# the set is exactly the site's outgoing CFG edges: a condition node's
# True/False splits, a guard's GuardElse, a loop condition's Backedge, a
# statement's Normal/terminator edge). record_access registers each access
# on EVERY id in this set — the access lifetime is stored against the exact
# edges the transfer performs, and the source node id never serves as a
# registry key (diagnostic metadata only).
def successor_edge_ids(cfg: TypedCFG, edge_source: Int) -> Vec[Int]
  var out = Vec::new()
  mut i = 0
  while i < cfg.edges.len() do
    if cfg.edges[i].source == edge_source then
      out.push(i)
    end
    i = i + 1
  end
  out
end

# record one access on the CFG edge(s) of its site (`edge_source` —
# the site's source node id, DIAGNOSTIC METADATA ONLY; the registry
# is keyed by CfgEdgeId): the path is a TYPED PLACE with a semantic
# AccessRoot, and the access gets a fresh AccessId registered on the EXACT
# SET of successor edges of the source node (successor_edge_ids — a
# condition node with two outgoing CFG edges carries the access on BOTH) —
# the resource checker's CleanupAction::EndAccess names it when an edge's
# cleanup runs.
# ZERO-SUCCESSOR REGISTRATION (documented decision, NOT an ICE): an
# item-level expression walk (struct field defaults, enum discriminants,
# const/static initializers, contract expressions) records accesses under a
# source node the CFG intentionally has no edges for (cfg_expr is a pure
# structural recursion — no edge records), so successor_edge_ids returns
# the empty set and the registration is a silent no-op there. This is
# sound: the access is still pushed into `actives` (the borrow/overlap
# analysis of the expression walk itself), and the EndAccess-cleanup
# contract only governs edges that exist. Function-body sites always have
# at least one successor edge (the block's Normal/terminator edge), and an
# EndAccess naming an access never registered is an ICE at the
# validate_cfg_edges reconciliation (resource_check.tg) — so a zero-
# successor registration inside a function body would fail loudly there,
# never silently.
def record_access(typed: TypedProgram, expr: Expr, effect: AccessEffect, inout actives: Vec[ActiveAccess], inout spans: Vec[Span], inout errors: Vec[AccessError], edge_source: Int, cfg: TypedCFG, inout ctx: AnalysisContext) -> Unit
  match derive_access_path(typed, expr, errors)
  when Option::Some(path) then
    actives.push(ActiveAccess { path: path, effect: effect })
    spans.push(expr.span)
    let aid = access_registry_fresh_id(ctx)
    let edge_ids = successor_edge_ids(cfg, edge_source)
    for eid in edge_ids do
      access_registry_register(ctx, eid, aid)
    end
  when Option::None then ()
  end
end

def check_overlaps(typed: TypedProgram, actives: Vec[ActiveAccess], spans: Vec[Span], inout errors: Vec[AccessError]) -> Unit
  mut i = 0
  while i < actives.len() do
    mut j = i + 1
    while j < actives.len() do
      if accesses_conflict(&actives[i], &actives[j]) then
        errors.push(AccessError {
          message: "conflicting accesses to `" + path_to_string(typed, &actives[j].path) + "` (" + effect_name(actives[i].effect) + " vs " + effect_name(actives[j].effect) + ")",
          span: spans[j]
        })
      end
      j = j + 1
    end
    i = i + 1
  end
end

def accesses_conflict(a: ActiveAccess, b: ActiveAccess) -> Bool
  if a.effect == AccessEffect::Read && b.effect == AccessEffect::Read then
    return false
  end
  paths_overlap(&a.path, &b.path)
end

# the overlap analysis operates on the SEMANTIC ROOTS
# (AccessRoot::Local(LocalId)/SelfValue/Static(DefId)/RawUnknown) — the
# former integer-root comparison (real local ids vs the magic -1 self
# sentinel) is GONE.
def paths_overlap(a: TypedPlace, b: TypedPlace) -> Bool
  # Raw-pointer dereferences have unknown provenance: two dereferences of
  # DIFFERENT pointer variables may address the same memory, and a raw
  # deref may alias any other storage, so every path containing a raw
  # deref is classified UnknownAlias — potentially overlapping with every
  # other path. This runs BEFORE root comparison: a raw deref must never
  # be proved disjoint by the variables holding the addresses.
  mut ri = 0
  while ri < a.projections.len() do
    match a.projections[ri]
    when AccessProjection::RawDeref then return true
    when _ then ()
    end
    ri = ri + 1
  end
  mut rj = 0
  while rj < b.projections.len() do
    match b.projections[rj]
    when AccessProjection::RawDeref then return true
    when _ then ()
    end
    rj = rj + 1
  end
  # Roots are semantic AccessRoots: Local ids compare by identity,
  # SelfValue/Static compare structurally, RawUnknown is never provably
  # disjoint (its provenance is unknown).
  if !access_roots_overlap(&a.root, &b.root) then
    return false
  end
  mut i = 0
  while i < a.projections.len() && i < b.projections.len() do
    let pa = a.projections[i]
    let pb = b.projections[i]
    match pa
    when AccessProjection::Field(fa, na) then
      match pb
      when AccessProjection::Field(fb, nb) then
        # Field identities are typed (FieldId), never synthesized sentinels;
        # compare owner type id + index.
        if fa.owner.id != fb.owner.id || fa.index != fb.index then
          return false
        end
      when AccessProjection::Index then
        return true
      when AccessProjection::RawDeref then
        return true
      end
    when AccessProjection::Index then
      match pb
      when AccessProjection::Field(_, _) then
        return true
      when AccessProjection::Index then
        ()
      when AccessProjection::RawDeref then
        return true
      end
    when AccessProjection::RawDeref then
      return true
    end
    i = i + 1
  end
  true
end

# do two semantic roots denote the same storage class? Local ids
# compare by identity; SelfValue compares with itself; Static DefIds
# compare by (module id, index); RawUnknown overlaps EVERYTHING (unknown
# provenance is never provably disjoint).
def access_roots_overlap(a: AccessRoot, b: AccessRoot) -> Bool
  match a
  when AccessRoot::RawUnknown then true
  when AccessRoot::Local(la) then
    match b
    when AccessRoot::RawUnknown then true
    when AccessRoot::Local(lb) then la.id == lb.id
    when _ then false
    end
  when AccessRoot::SelfValue then
    match b
    when AccessRoot::RawUnknown then true
    when AccessRoot::SelfValue then true
    when _ then false
    end
  when AccessRoot::Static(sa) then
    match b
    when AccessRoot::RawUnknown then true
    when AccessRoot::Static(sb) then sa.module.id == sb.module.id && sa.index == sb.index
    when _ then false
    end
  end
end

def call_arg_effects(typed: TypedProgram, call_node_id: Int, callee: Option[Expr], args: Vec[Expr]) -> Vec[AccessEffect]
  let fn_params = match callee
  when Option::Some(c) then
    match typed.expr_types.get(c.node_id)
    when Option::Some(t) then
      match t
      when Type::FnPtr(params, _, _) then params.clone()
      when Type::Closure(_, params, _, _, _) then params.clone()
      when _ then Vec::new()
      end
    when Option::None then Vec::new()
    end
  when Option::None then Vec::new()
  end
  mut effects = Vec::new()
  mut i = 0
  while i < args.len() do
    effects.push(arg_effect(typed, call_node_id, &fn_params, i, &args[i]))
    i = i + 1
  end
  effects
end

# (phase 2): the recursive tree is the PRIMARY authority for a
# recorded source call's argument effects — the call node's TypedCall
# (TypedExprKind::Call) carries the TypedCallArg effects with their typed
# values; the flat access_effects is the fallback for the nodes the
# checker recorded only in the flat map (the typed-call assembly failure
# class) and for synthesized nodes.
def arg_effect(typed: TypedProgram, call_node_id: Int, fn_params: Vec[ParamType], arg_index: Int, arg: Expr) -> AccessEffect
  if call_node_id != 0 then
    match typed.typed_exprs.get(call_node_id)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Call(tc) then
        if arg_index < tc.args.len() then
          return tc.args[arg_index].effect
        end
      when _ then ()
      end
    when Option::None then ()
    end
  end
  match typed.access_effects.get(arg.node_id)
  when Option::Some(e) then e
  when Option::None then
    # The semantic layer records an effect for every argument whose index
    # is within the callee's declared parameter list (types.tg records
    # args[0.. params.len()) unconditionally), so a missing entry there
    # is a compiler-internal error, NOT a reason to assume Read.
    if arg_index < fn_params.len() then
      panic("internal error: missing access effect for argument node " + arg.node_id.to_string())
    else
      # Genuinely optional: an argument beyond the declared parameter list
      # only exists when the type checker has already rejected the call
      # (wrong-number-of-arguments), and the semantic layer intentionally
      # records no effect for it. Error-recovery Read; the program fails
      # compilation regardless. Method-call arguments (fn_params empty)
      # land here too: their effects are always recorded on well-formed
      # calls, so a missing one implies a call error already reported.
      AccessEffect::Read
    end
  end
end

# (phase 2): the recursive tree is the PRIMARY authority for a
# recorded source method call's receiver effect — the call node's
# TypedCall.receiver_effect; the flat access_effects is the fallback for
# the nodes the checker recorded only in the flat map.
def method_receiver_effect(typed: TypedProgram, receiver: Expr, call_node_id: Int) -> AccessEffect
  if call_node_id != 0 then
    match typed.typed_exprs.get(call_node_id)
    when Option::Some(te) then
      match te.kind
      when TypedExprKind::Call(tc) then
        match tc.receiver_effect
        when Option::Some(eff) then return eff
        when Option::None then ()
        end
      when _ then ()
      end
    when Option::None then ()
    end
  end
  # The semantic layer records a receiver effect on every method call
  # (types.tg records the receiver for every mparams outcome), so a
  # missing entry is a compiler-internal error — never fall back to Read
  # or re-derive the effect from parameter conventions.
  match typed.access_effects.get(receiver.node_id)
  when Option::Some(e) then e
  when Option::None then
    panic("internal error: missing access effect for method receiver node " + receiver.node_id.to_string())
  end
end

# derive the TYPED PLACE of an access expression — the semantic
# AccessRoot (Local(LocalId) for identifiers, SelfValue for `self`,
# Static(DefId) for static/const paths, RawUnknown for unknown-provenance
# roots) plus the projection chain. The former integer-root sentinels
# (the raw local id, the magic -1 `self` root) are GONE.
def derive_access_path(typed: TypedProgram, expr: Expr, inout errors: Vec[AccessError]) -> Option[TypedPlace]
  match expr.kind
  when ExprKind::ExprIdent(name) then
    # The typed pipeline must have resolved every identifier; a missing
    # resolution here is a compiler-internal error — the path degrades to
    # a RawUnknown root (never a sentinel integer: a fabricated local id
    # would corrupt overlap analysis).
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then
      Option::Some(TypedPlace { root: AccessRoot::Local(LocalId { id: l }), projections: Vec::new() })
    when Option::None then
      errors.push(AccessError {
        message: "internal error: missing typed resolution for identifier `" + name + "`",
        span: expr.span
      })
      Option::Some(TypedPlace { root: AccessRoot::RawUnknown, projections: Vec::new() })
    end
  when ExprKind::ExprSelfRef then
 # the semantic SelfValue root — the former negative integer
    # root (-1) is GONE.
    Option::Some(TypedPlace { root: AccessRoot::SelfValue, projections: Vec::new() })
  when ExprKind::ExprPath(path) then
 # a static/const reference is a Static(DefId) root when the
    # resolver recorded the module-qualified def; unresolvable paths are
    # RawUnknown (never provably disjoint).
    match static_def_of(typed, &path)
    when Option::Some(did) then
      Option::Some(TypedPlace { root: AccessRoot::Static(did), projections: Vec::new() })
    when Option::None then
      Option::Some(TypedPlace { root: AccessRoot::RawUnknown, projections: Vec::new() })
    end
  when ExprKind::ExprFieldAccess(base, field) then
    match derive_access_path(typed, &base, errors)
    when Option::Some(mut p) then
 # (phase 2): the recursive tree is the PRIMARY authority for
      # the field identity — the node's TypedExprKind::Field (the strong
      # TypedField FieldId) or the TupleIndex form (the non-FieldId tuple
      # index access — an Index projection, conservatively aliasing the
      # whole aggregate); the flat field_targets is the fallback for the
      # nodes the checker recorded only in the flat map.
      match typed.typed_exprs.get(expr.node_id)
      when Option::Some(te) then
        match te.kind
        when TypedExprKind::Field(tf) then
          p.projections.push(AccessProjection::Field(tf.field, field.clone()))
          return Option::Some(p)
        when TypedExprKind::TupleIndex(_) then
          p.projections.push(AccessProjection::Index)
          return Option::Some(p)
        when _ then ()
        end
      when Option::None then ()
      end
      match typed.field_targets.get(expr.node_id)
      when Option::Some(f) then
        p.projections.push(AccessProjection::Field(f, field.clone()))
        Option::Some(p)
      when Option::None then
        errors.push(AccessError {
          message: "internal error: missing typed field target for field `" + field + "`",
          span: expr.span
        })
        Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprIndex(base, _) then
    match derive_access_path(typed, &base, errors)
    when Option::Some(mut p) then
      p.projections.push(AccessProjection::Index)
      Option::Some(p)
    when Option::None then Option::None
    end
  when ExprKind::ExprRawDeref(inner) then
    match derive_access_path(typed, &inner, errors)
    when Option::Some(mut p) then
      p.projections.push(AccessProjection::RawDeref)
      Option::Some(p)
    when Option::None then Option::None
    end
  when ExprKind::ExprAccess(inner) then derive_access_path(typed, &inner, errors)
  when _ then Option::None
  end
end

# resolve a static/const path to its DefId — the resolver's
# module_symbols snapshot ("path::name" -> DefId); a miss (or a
# type-position path) yields Option::None (the caller degrades to
# RawUnknown).
def static_def_of(typed: TypedProgram, path: AstPath) -> Option[DefId]
  var key = ""
  var first = true
  for seg in path.segments do
    if !first then key = key + "::" end
    first = false
    key = key + seg
  end
  match typed.resolutions.module_symbols.get(&key)
  when Option::Some(did) then Option::Some(did)
  when Option::None then Option::None
  end
end

def effect_name(e: AccessEffect) -> String
  match e
  when AccessEffect::Read then "read"
  when AccessEffect::Modify then "modify"
  when AccessEffect::Consume then "consume"
  when AccessEffect::Initialize then "initialize"
  end
end

# the diagnostic render of a TypedPlace — the root renders from the
# semantic AccessRoot (the local's registered name for Local roots, "self"
# for SelfValue, the def for Static, "unknown" for RawUnknown), then the
# projection chain.
def path_to_string(typed: TypedProgram, p: TypedPlace) -> String
  var s = root_name(typed, &p.root)
  mut i = 0
  while i < p.projections.len() do
    match p.projections[i]
    when AccessProjection::Field(_, f) then s = s + "." + f
    when AccessProjection::Index then s = s + "[]"
    when AccessProjection::RawDeref then s = s + "(*)"
    end
    i = i + 1
  end
  s
end

def root_name(typed: TypedProgram, root: AccessRoot) -> String
  match root
  when AccessRoot::Local(lid) then
    match typed.local_bindings.get(lid.id)
    when Option::Some(lb) then lb.name.clone()
    when Option::None then "<local#" + lid.id.to_string() + ">"
    end
  when AccessRoot::SelfValue then "self"
  when AccessRoot::Static(did) then "static<" + did.module.id.to_string() + "::" + did.index.to_string() + ">"
  when AccessRoot::RawUnknown then "unknown"
  end
end
