use std::core::{Option}
use std::collections::{Vec}
use tg_compiler::token::{Span}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, FnBody, TraitMethod, ExternItem,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind, Param,
  GuardElse, MatchExpr
}
use tg_compiler::types::{AccessEffect, TypedProgram, Type, ParamType, TypeId}
use tg_compiler::ids::{FieldId}

enum AccessProjection
  Field(FieldId, String)
  Index
  # Raw-pointer dereference: provenance is unknown, so a path containing
  # this projection must never be assumed disjoint from other paths.
  RawDeref
end

struct AccessPath
  root: Int
  root_name: String
  projections: Vec[AccessProjection]
end

struct ActiveAccess
  path: AccessPath
  effect: AccessEffect
end

struct AccessError
  message: String
  span: Span
end

pub def access_check(program: &Program, typed: &TypedProgram) -> Vec[AccessError]
  mut errors = Vec::new()
  mut i = 0
  while i < program.items.len() do
    check_item(program, typed, &program.items[i], &mut errors)
    i = i + 1
  end
  errors
end

def check_item(program: &Program, typed: &TypedProgram, item: &Item, errors: &mut Vec[AccessError]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    check_function(program, typed, &f, errors)
  when ItemKind::ItemStruct(s) then
    mut i = 0
    while i < s.fields.len() do
      match s.fields[i].default
      when Option::Some(e) then check_expr(program, typed, &e, errors)
      when Option::None then ()
      end
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      check_function(program, typed, &s.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut i = 0
    while i < e.variants.len() do
      match e.variants[i].discriminant
      when Option::Some(d) then check_expr(program, typed, &d, errors)
      when Option::None then ()
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      check_trait_method(program, typed, &t.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    mut i = 0
    while i < im.methods.len() do
      check_function(program, typed, &im.methods[i], errors)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      check_item(program, typed, &m.items[i], errors)
      i = i + 1
    end
  when ItemKind::ItemUse(_) then ()
  when ItemKind::ItemMacro(mac) then
    check_block(program, typed, &mac.body, errors)
  when ItemKind::ItemTypeAlias(_) then ()
  when ItemKind::ItemConst(c) then
    check_expr(program, typed, &c.value, errors)
  when ItemKind::ItemStatic(s) then
    check_expr(program, typed, &s.value, errors)
  when ItemKind::ItemCapabilityDecl(_) then ()
  when ItemKind::ItemEffectDecl(_) then ()
  when ItemKind::ItemRationaleBlock(_) then ()
  when ItemKind::ItemEditionDecl(_) then ()
  when ItemKind::ItemExternBlock(ext) then
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        check_params_defaults(program, typed, &ef.params, errors)
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  end
end

def check_function(program: &Program, typed: &TypedProgram, f: &FunctionDecl, errors: &mut Vec[AccessError]) -> Unit
  check_params_defaults(program, typed, &f.params, errors)
  mut i = 0
  while i < f.contracts.len() do
    check_expr(program, typed, &f.contracts[i].expr, errors)
    i = i + 1
  end
  check_fn_body(program, typed, &f.body, errors)
end

def check_trait_method(program: &Program, typed: &TypedProgram, m: &TraitMethod, errors: &mut Vec[AccessError]) -> Unit
  check_params_defaults(program, typed, &m.sig.params, errors)
  check_fn_body(program, typed, &m.default_body, errors)
end

def check_params_defaults(program: &Program, typed: &TypedProgram, params: &Vec[Param], errors: &mut Vec[AccessError]) -> Unit
  mut i = 0
  while i < params.len() do
    match params[i].default
    when Option::Some(e) then check_expr(program, typed, &e, errors)
    when Option::None then ()
    end
    i = i + 1
  end
end

def check_fn_body(program: &Program, typed: &TypedProgram, body: &FnBody, errors: &mut Vec[AccessError]) -> Unit
  match body
  when FnBody::FnBlock(b) then check_block(program, typed, &b, errors)
  when FnBody::FnExpr(e) then check_expr(program, typed, &e, errors)
  when FnBody::FnExtern(_) then ()
  when FnBody::FnNone then ()
  end
end

def check_block(program: &Program, typed: &TypedProgram, block: &Block, errors: &mut Vec[AccessError]) -> Unit
  mut i = 0
  while i < block.stmts.len() do
    check_stmt(program, typed, &block.stmts[i], errors)
    i = i + 1
  end
end

def check_stmt(program: &Program, typed: &TypedProgram, stmt: &Stmt, errors: &mut Vec[AccessError]) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    check_pattern(program, typed, &pattern, errors)
    check_expr(program, typed, &value, errors)
  when StmtKind::StmtAssign(target, value) then
    check_expr(program, typed, &target, errors)
    check_expr(program, typed, &value, errors)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    check_expr(program, typed, &target, errors)
    check_expr(program, typed, &value, errors)
  when StmtKind::StmtIf(if_stmt) then
    check_expr(program, typed, &if_stmt.cond, errors)
    check_block(program, typed, &if_stmt.then_block, errors)
    mut i = 0
    while i < if_stmt.elsif_branches.len() do
      check_expr(program, typed, &if_stmt.elsif_branches[i].0, errors)
      check_block(program, typed, &if_stmt.elsif_branches[i].1, errors)
      i = i + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then check_block(program, typed, &eb, errors)
    when Option::None then ()
    end
  when StmtKind::StmtMatch(m) then
    check_match(program, typed, &m, errors)
  when StmtKind::StmtWhile(cond, body) then
    check_expr(program, typed, &cond, errors)
    check_block(program, typed, &body, errors)
  when StmtKind::StmtFor(for_stmt) then
    check_pattern(program, typed, &for_stmt.pattern, errors)
    check_expr(program, typed, &for_stmt.iter, errors)
    check_block(program, typed, &for_stmt.body, errors)
  when StmtKind::StmtLoop(body) then
    check_block(program, typed, &body, errors)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(program, typed, &val, errors)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(program, typed, &val, errors)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtYield(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(program, typed, &val, errors)
    when Option::None then ()
    end
  when StmtKind::StmtExpr(e) then
    check_expr(program, typed, &e, errors)
  when StmtKind::StmtUnsafe(_, body) then
    check_block(program, typed, &body, errors)
  when StmtKind::StmtDefer(body) then
    check_block(program, typed, &body, errors)
  when StmtKind::StmtGuard(cond, else_action) then
    check_expr(program, typed, &cond, errors)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then check_expr(program, typed, &val, errors)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then check_expr(program, typed, &val, errors)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    check_block(program, typed, &body, errors)
    mut i = 0
    while i < catches.len() do
      check_pattern(program, typed, &catches[i].pattern, errors)
      check_block(program, typed, &catches[i].body, errors)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then check_block(program, typed, &fb, errors)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, _, body) then
    check_expr(program, typed, &expr, errors)
    check_block(program, typed, &body, errors)
  when StmtKind::StmtHandleWith(expr, handlers) then
    check_expr(program, typed, &expr, errors)
    mut i = 0
    while i < handlers.len() do
      mut j = 0
      while j < handlers[i].arms.len() do
        check_block(program, typed, &handlers[i].arms[j].body, errors)
        j = j + 1
      end
      i = i + 1
    end
  end
end

def check_match(program: &Program, typed: &TypedProgram, m: &MatchExpr, errors: &mut Vec[AccessError]) -> Unit
  check_expr(program, typed, &m.scrutinee, errors)
  mut i = 0
  while i < m.arms.len() do
    check_pattern(program, typed, &m.arms[i].pattern, errors)
    match m.arms[i].guard_expr
    when Option::Some(g) then check_expr(program, typed, &g, errors)
    when Option::None then ()
    end
    check_block(program, typed, &m.arms[i].body, errors)
    i = i + 1
  end
end

def check_pattern(program: &Program, typed: &TypedProgram, pat: &Pattern, errors: &mut Vec[AccessError]) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(e) then check_expr(program, typed, &e, errors)
  when PatternKind::Tuple(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], errors)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], errors)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    mut i = 0
    while i < field_pats.len() do
      check_pattern(program, typed, &field_pats[i].1, errors)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    mut i = 0
    while i < pats.len() do
      check_pattern(program, typed, &pats[i], errors)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    mut i = 0
    while i < alts.len() do
      check_pattern(program, typed, &alts[i], errors)
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then check_expr(program, typed, &e, errors)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then check_expr(program, typed, &e, errors)
    when Option::None then ()
    end
  end
end

def check_expr(program: &Program, typed: &TypedProgram, expr: &Expr, errors: &mut Vec[AccessError]) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, &elems[i], errors)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      check_expr(program, typed, &elems[i], errors)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      check_expr(program, typed, &fields[i].1, errors)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      check_expr(program, typed, &entries[i].0, errors)
      check_expr(program, typed, &entries[i].1, errors)
      i = i + 1
    end
  when ExprKind::ExprIdent(_) then ()
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprSelfRef then ()
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    check_expr(program, typed, &lhs, errors)
    check_expr(program, typed, &rhs, errors)
  when ExprKind::ExprUnaryOp(_, operand) then
    check_expr(program, typed, &operand, errors)
  when ExprKind::ExprFieldAccess(base, _) then
    check_expr(program, typed, &base, errors)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    check_expr(program, typed, &recv, errors)
    mut mi = 0
    while mi < args.len() do
      check_expr(program, typed, &args[mi], errors)
      mi = mi + 1
    end
    check_expr_method_call(typed, &recv, &args, errors)
  when ExprKind::ExprIndex(base, index) then
    check_expr(program, typed, &base, errors)
    check_expr(program, typed, &index, errors)
  when ExprKind::ExprCall(callee, args) then
    check_expr(program, typed, &callee, errors)
    mut ci = 0
    while ci < args.len() do
      check_expr(program, typed, &args[ci], errors)
      ci = ci + 1
    end
    check_expr_call(typed, &callee, &args, errors)
  when ExprKind::ExprClosure(params, _, body) then
    mut i = 0
    while i < params.len() do
      check_pattern(program, typed, &params[i].pat, errors)
      i = i + 1
    end
    check_expr(program, typed, &body, errors)
  when ExprKind::ExprAccess(inner) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprRawDeref(inner) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprIf(if_stmt) then
    check_expr(program, typed, &if_stmt.cond, errors)
    check_block(program, typed, &if_stmt.then_block, errors)
    mut i = 0
    while i < if_stmt.elsif_branches.len() do
      check_expr(program, typed, &if_stmt.elsif_branches[i].0, errors)
      check_block(program, typed, &if_stmt.elsif_branches[i].1, errors)
      i = i + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then check_block(program, typed, &eb, errors)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    check_match(program, typed, &m, errors)
  when ExprKind::ExprBlock(block) then
    check_block(program, typed, &block, errors)
  when ExprKind::ExprUnsafe(_, block) then
    check_block(program, typed, &block, errors)
  when ExprKind::ExprAsync(block) then
    check_block(program, typed, &block, errors)
  when ExprKind::ExprAwait(inner) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprTry(inner) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then check_expr(program, typed, &s, errors)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then check_expr(program, typed, &e, errors)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprTypeCheck(inner, _) then check_expr(program, typed, &inner, errors)
  when ExprKind::ExprComptime(block) then check_block(program, typed, &block, errors)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, &args[i], errors)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    check_expr(program, typed, &target, errors)
    check_expr(program, typed, &value, errors)
  when ExprKind::ExprPipe(lhs, rhs) then
    check_expr(program, typed, &lhs, errors)
    check_expr(program, typed, &rhs, errors)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      check_expr(program, typed, &args[i], errors)
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end
end

def check_expr_call(typed: &TypedProgram, callee: &Expr, args: &Vec[Expr], errors: &mut Vec[AccessError]) -> Unit
  let effects = call_arg_effects(typed, Option::Some(callee), args)
  check_call_site(Option::None, AccessEffect::Read, &effects, args, typed, errors)
end

def check_expr_method_call(typed: &TypedProgram, receiver: &Expr, args: &Vec[Expr], errors: &mut Vec[AccessError]) -> Unit
  let recv_effect = method_receiver_effect(typed, &receiver)
  let effects = call_arg_effects(typed, Option::None, args)
  check_call_site(Option::Some(receiver), recv_effect, &effects, args, typed, errors)
end

def check_call_site(receiver: Option[&Expr], receiver_effect: AccessEffect, arg_effects: &Vec[AccessEffect], args: &Vec[Expr], typed: &TypedProgram, errors: &mut Vec[AccessError]) -> Unit
  mut actives = Vec::new()
  mut spans = Vec::new()
  match receiver
  when Option::Some(r) then
    record_access(typed, r, receiver_effect, &mut actives, &mut spans, errors)
  when Option::None then ()
  end
  mut i = 0
  while i < args.len() do
    # call_arg_effects pushes exactly one effect per argument, so a shorter
    # vector is a compiler-internal error — never a silent Read.
    if i >= arg_effects.len() then
      panic("internal error: missing access effect vector entry for argument node " + args[i].node_id.to_string())
    end
    let eff = arg_effects[i]
    record_access(typed, &args[i], eff, &mut actives, &mut spans, errors)
    i = i + 1
  end
  check_overlaps(&actives, &spans, errors)
end

def record_access(typed: &TypedProgram, expr: &Expr, effect: AccessEffect, actives: &mut Vec[ActiveAccess], spans: &mut Vec[Span], errors: &mut Vec[AccessError]) -> Unit
  match derive_access_path(typed, expr, errors)
  when Option::Some(path) then
    actives.push(ActiveAccess { path: path, effect: effect })
    spans.push(expr.span)
  when Option::None then ()
  end
end

def check_overlaps(actives: &Vec[ActiveAccess], spans: &Vec[Span], errors: &mut Vec[AccessError]) -> Unit
  mut i = 0
  while i < actives.len() do
    mut j = i + 1
    while j < actives.len() do
      if accesses_conflict(&actives[i], &actives[j]) then
        errors.push(AccessError {
          message: "conflicting accesses to `" + path_to_string(&actives[j].path) + "` (" + effect_name(actives[i].effect) + " vs " + effect_name(actives[j].effect) + ")",
          span: spans[j]
        })
      end
      j = j + 1
    end
    i = i + 1
  end
end

def accesses_conflict(a: &ActiveAccess, b: &ActiveAccess) -> Bool
  if a.effect == AccessEffect::Read && b.effect == AccessEffect::Read then
    return false
  end
  paths_overlap(&a.path, &b.path)
end

def paths_overlap(a: &AccessPath, b: &AccessPath) -> Bool
  # Raw-pointer dereferences have unknown provenance: two dereferences of
  # DIFFERENT pointer variables may address the same memory, and a raw
  # deref may alias any other storage, so every path containing a raw
  # deref is classified UnknownAlias — potentially overlapping with every
  # other path. This runs BEFORE root comparison: a raw deref must never
  # be proved disjoint by the variables holding the addresses.
  mut ri = 0
  while ri < a.projections.len() do
    match a.projections[ri]
    when AccessProjection::RawDeref then return true
    when _ then ()
    end
    ri = ri + 1
  end
  mut rj = 0
  while rj < b.projections.len() do
    match b.projections[rj]
    when AccessProjection::RawDeref then return true
    when _ then ()
    end
    rj = rj + 1
  end
  # Roots are now always semantic: real local ids (>= 0) or the negative
  # `self` root (-1). There is no "unresolved" sentinel (missing typed
  # resolutions are internal errors reported during path derivation), so
  # roots compare structurally, never by name.
  let same_root = if a.root < 0 || b.root < 0 then
    a.root == b.root && a.root_name == b.root_name
  else
    a.root == b.root
  end
  if !same_root then
    return false
  end
  mut i = 0
  while i < a.projections.len() && i < b.projections.len() do
    let pa = a.projections[i]
    let pb = b.projections[i]
    match pa
    when AccessProjection::Field(fa, na) then
      match pb
      when AccessProjection::Field(fb, nb) then
        # Field identities are typed (FieldId), never synthesized sentinels;
        # compare owner type id + index.
        if fa.owner.id != fb.owner.id || fa.index != fb.index then
          return false
        end
      when AccessProjection::Index then
        return true
      when AccessProjection::RawDeref then
        return true
      end
    when AccessProjection::Index then
      match pb
      when AccessProjection::Field(_, _) then
        return true
      when AccessProjection::Index then
        ()
      when AccessProjection::RawDeref then
        return true
      end
    when AccessProjection::RawDeref then
      return true
    end
    i = i + 1
  end
  true
end

def call_arg_effects(typed: &TypedProgram, callee: Option[&Expr], args: &Vec[Expr]) -> Vec[AccessEffect]
  let fn_params = match callee
  when Option::Some(c) then
    match typed.expr_types.get(c.node_id)
    when Option::Some(t) then
      match t
      when Type::Function(params, _) then params.clone()
      when _ then Vec::new()
      end
    when Option::None then Vec::new()
    end
  when Option::None then Vec::new()
  end
  mut effects = Vec::new()
  mut i = 0
  while i < args.len() do
    effects.push(arg_effect(typed, &fn_params, i, &args[i]))
    i = i + 1
  end
  effects
end

def arg_effect(typed: &TypedProgram, fn_params: &Vec[ParamType], arg_index: Int, arg: &Expr) -> AccessEffect
  match typed.access_effects.get(arg.node_id)
  when Option::Some(e) then e
  when Option::None then
    # The semantic layer records an effect for every argument whose index
    # is within the callee's declared parameter list (types.tg records
    # args[0 .. params.len()) unconditionally), so a missing entry there
    # is a compiler-internal error, NOT a reason to assume Read.
    if arg_index < fn_params.len() then
      panic("internal error: missing access effect for argument node " + arg.node_id.to_string())
    else
      # Genuinely optional: an argument beyond the declared parameter list
      # only exists when the type checker has already rejected the call
      # (wrong-number-of-arguments), and the semantic layer intentionally
      # records no effect for it. Error-recovery Read; the program fails
      # compilation regardless. Method-call arguments (fn_params empty)
      # land here too: their effects are always recorded on well-formed
      # calls, so a missing one implies a call error already reported.
      AccessEffect::Read
    end
  end
end

def method_receiver_effect(typed: &TypedProgram, receiver: &Expr) -> AccessEffect
  # The semantic layer records a receiver effect on every method call
  # (types.tg records the receiver for every mparams outcome), so a
  # missing entry is a compiler-internal error — never fall back to Read
  # or re-derive the effect from parameter conventions.
  match typed.access_effects.get(receiver.node_id)
  when Option::Some(e) then e
  when Option::None then
    panic("internal error: missing access effect for method receiver node " + receiver.node_id.to_string())
  end
end

def derive_access_path(typed: &TypedProgram, expr: &Expr, errors: &mut Vec[AccessError]) -> Option[AccessPath]
  match expr.kind
  when ExprKind::ExprIdent(name) then
    # The typed pipeline must have resolved every identifier; a missing
    # resolution here is a compiler-internal error, NOT a reason to fall
    # back to a sentinel root (local id 0 is a real, valid local id and
    # using it as "unresolved" corrupts overlap analysis).
    match typed.ident_resolutions.get(expr.node_id)
    when Option::Some(l) then
      Option::Some(AccessPath { root: l, root_name: name.clone(), projections: Vec::new() })
    when Option::None then
      errors.push(AccessError {
        message: "internal error: missing typed resolution for identifier `" + name + "`",
        span: expr.span
      })
      Option::None
    end
  when ExprKind::ExprSelfRef then
    # Use a NEGATIVE root for `self`: local ids are always >= 0, so this
    # can never collide with a real local id (previously root 0 was used,
    # which is also the first local id and made overlap analysis ambiguous).
    Option::Some(AccessPath { root: -1, root_name: "self", projections: Vec::new() })
  when ExprKind::ExprFieldAccess(base, field) then
    match derive_access_path(typed, &base, errors)
    when Option::Some(mut p) then
      match typed.field_targets.get(expr.node_id)
      when Option::Some(f) then
        p.projections.push(AccessProjection::Field(f, field.clone()))
        Option::Some(p)
      when Option::None then
        errors.push(AccessError {
          message: "internal error: missing typed field target for field `" + field + "`",
          span: expr.span
        })
        Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprIndex(base, _) then
    match derive_access_path(typed, &base, errors)
    when Option::Some(mut p) then
      p.projections.push(AccessProjection::Index)
      Option::Some(p)
    when Option::None then Option::None
    end
  when ExprKind::ExprRawDeref(inner) then
    match derive_access_path(typed, &inner, errors)
    when Option::Some(mut p) then
      p.projections.push(AccessProjection::RawDeref)
      Option::Some(p)
    when Option::None then Option::None
    end
  when ExprKind::ExprAccess(inner) then derive_access_path(typed, &inner, errors)
  when _ then Option::None
  end
end

def effect_name(e: AccessEffect) -> String
  match e
  when AccessEffect::Read then "read"
  when AccessEffect::Modify then "modify"
  when AccessEffect::Consume then "consume"
  when AccessEffect::Initialize then "initialize"
  end
end

def path_to_string(p: &AccessPath) -> String
  mut s = p.root_name.clone()
  mut i = 0
  while i < p.projections.len() do
    match p.projections[i]
    when AccessProjection::Field(_, f) then s = s + "." + f
    when AccessProjection::Index then s = s + "[]"
    when AccessProjection::RawDeref then s = s + "(*)"
    end
    i = i + 1
  end
  s
end
