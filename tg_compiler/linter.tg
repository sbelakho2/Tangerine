# Tangerine Compiler — Linter
#
# Static analysis and style enforcement for Tangerine source code.
# Provides configurable lint rules that check AST and type information.
#
# Architecture:
# - LintPass trait: each lint rule implements this trait
# - LintRunner: discovers and executes lint passes
# - Supports #[allow(lint_name)], #[deny(lint_name)], #[warn(lint_name)]

use std::core::{Option, Result, Vec, String, Bool, UInt}
use std::collections::{Map, Set}
use std::fs::{read_file}
use std::io::{eprintln}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{Program, Item, ItemKind, Expr, ExprKind, Stmt, StmtKind,
                        FunctionDecl, FunctionSig, FnBody, Param, TypeExpr, TypeExprKind, Pattern,
                        PatternKind, Block, Visibility, Annotation, AnnotationArg,
                        StructDecl, EnumDecl, TraitDecl, ImplDecl, UseDecl, ConstDecl,
                        StaticDecl, TypeAliasDecl, ModuleDecl, ExternBlock, ExternItem,
                        MacroDecl, MatchExpr, IfStmt, ForStmt, CatchArm, GuardElse}
use tg_compiler::token::{Token, TokenKind, Span}
# (semantic lints): the typed-program payload — the analyzed program
# (resolutions: call_targets / expr_resolutions / type_def_ids / item_defs)
# the DefId-reachability passes consume. The source-string heuristics are
# removed; the AST reference sets are the fallback when the full analysis
# cannot run on a file.
use tg_compiler::compiler_core::{default_options, analyze_source}
use tg_compiler::resolver::{ResolvedNames, ResolvedExprKind}
use tg_compiler::ids::{def_id_numeric}

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

# (semantic lints): the AST reference walkers below REPLACE the former
# source-text occurrence counters (count_name_occurrences /
# count_occurrences — the source-string heuristics that matched comments
# and string payloads). The reference sets are derived from the PROGRAM
# structure: expression identifiers, path segments, method names, type
# names, and pattern identifiers.

def collect_program_references(program: Program, inout refs: Set[String]) -> Unit
  for item in program.items do
    collect_item_references(&item, refs)
  end
end

def collect_item_references(item: Item, inout refs: Set[String]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(func) then
    collect_fn_references(func, refs)
  when ItemKind::ItemStruct(s) then
    for fld in s.fields do
      collect_type_refs(&fld.ty, refs)
      match fld.default
      when Option::Some(d) then collect_expr_refs(&d, refs)
      when Option::None then ()
      end
    end
    for m in s.methods do
      collect_fn_references(m, refs)
    end
  when ItemKind::ItemEnum(e) then
    for v in e.variants do
      for fty in v.fields do
        collect_type_refs(&fty, refs)
      end
      match v.discriminant
      when Option::Some(d) then collect_expr_refs(&d, refs)
      when Option::None then ()
      end
    end
  when ItemKind::ItemTrait(t) then
    for st in t.super_traits do
      collect_type_refs(&st, refs)
    end
    for m in t.methods do
      collect_fn_sig_refs(&m.sig, refs)
      match m.default_body
      when FnBody::FnBlock(block) then collect_block_refs(&block, refs)
      when FnBody::FnExpr(expr) then collect_expr_refs(&expr, refs)
      when _ then ()
      end
    end
  when ItemKind::ItemImpl(imp) then
    collect_type_refs(&imp.for_type, refs)
    collect_type_refs(&imp.self_type, refs)
    for ta in imp.trait_type_args do
      collect_type_refs(&ta, refs)
    end
    match imp.trait_name
    when Option::Some(tn) then refs.insert(tn)
    when Option::None then ()
    end
    for m in imp.methods do
      collect_fn_references(m, refs)
    end
  when ItemKind::ItemModule(m) then
    for inner in m.items do
      collect_item_references(&inner, refs)
    end
  when ItemKind::ItemConst(c) then
    match c.ty
    when Option::Some(ty) then collect_type_refs(&ty, refs)
    when Option::None then ()
    end
    collect_expr_refs(&c.value, refs)
  when ItemKind::ItemStatic(s) then
    collect_type_refs(&s.ty, refs)
    collect_expr_refs(&s.value, refs)
  when ItemKind::ItemTypeAlias(ta) then
    collect_type_refs(&ta.ty, refs)
  when ItemKind::ItemExternBlock(ext) then
    for item2 in ext.items do
      match item2
      when ExternItem::Function(efn) then
        for p in efn.params do
          match p.ty
          when Option::Some(ty) then collect_type_refs(&ty, refs)
          when Option::None then ()
          end
        end
        match efn.ret_type
        when Option::Some(ty) then collect_type_refs(&ty, refs)
        when Option::None then ()
        end
      when ExternItem::Static(es) then
        collect_type_refs(&es.ty, refs)
      end
    end
  when ItemKind::ItemMacro(mac) then
    collect_block_refs(&mac.body, refs)
  when _ then ()
  end
end

def collect_fn_references(func: FunctionDecl, inout refs: Set[String]) -> Unit
  for param in func.params do
    match param.ty
    when Option::Some(ty) then collect_type_refs(&ty, refs)
    when Option::None then ()
    end
    match param.default
    when Option::Some(d) then collect_expr_refs(&d, refs)
    when Option::None then ()
    end
  end
  match func.ret_type
  when Option::Some(ty) then collect_type_refs(&ty, refs)
  when Option::None then ()
  end
  for clause in func.where_clause do
    collect_type_refs(&clause.ty, refs)
    for bound in clause.bounds do
      collect_type_refs(&bound, refs)
    end
  end
  match func.body
  when FnBody::FnBlock(block) then collect_block_refs(&block, refs)
  when FnBody::FnExpr(expr) then collect_expr_refs(&expr, refs)
  when _ then ()
  end
end

def collect_fn_sig_refs(sig: FunctionSig, inout refs: Set[String]) -> Unit
  for param in sig.params do
    match param.ty
    when Option::Some(ty) then collect_type_refs(&ty, refs)
    when Option::None then ()
    end
  end
  match sig.ret_type
  when Option::Some(ty) then collect_type_refs(&ty, refs)
  when Option::None then ()
  end
end

def collect_block_refs(block: Block, inout refs: Set[String]) -> Unit
  for stmt in block.stmts do
    collect_stmt_refs(stmt, refs)
  end
end

def collect_stmt_refs(stmt: Stmt, inout refs: Set[String]) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then collect_expr_refs(&expr, refs)
  when StmtKind::StmtLet(pattern, ty_opt, init, _) then
    collect_pattern_refs(&pattern, refs)
    match ty_opt
    when Option::Some(ty) then collect_type_refs(&ty, refs)
    when Option::None then ()
    end
    collect_expr_refs(&init, refs)
  when StmtKind::StmtAssign(target, value) then
    collect_expr_refs(&target, refs)
    collect_expr_refs(&value, refs)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    collect_expr_refs(&target, refs)
    collect_expr_refs(&value, refs)
  when StmtKind::StmtIf(if_stmt) then collect_if_refs(&if_stmt, refs)
  when StmtKind::StmtMatch(m) then collect_match_refs(&m, refs)
  when StmtKind::StmtWhile(cond, body) then
    collect_expr_refs(&cond, refs)
    collect_block_refs(&body, refs)
  when StmtKind::StmtFor(for_stmt) then
    collect_pattern_refs(&for_stmt.pattern, refs)
    collect_expr_refs(&for_stmt.iter, refs)
    collect_block_refs(&for_stmt.body, refs)
  when StmtKind::StmtLoop(body) then collect_block_refs(&body, refs)
  when StmtKind::StmtReturn(val) then
    match val
    when Option::Some(v) then collect_expr_refs(&v, refs)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val) then
    match val
    when Option::Some(v) then collect_expr_refs(&v, refs)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtUnsafe(_, body) then collect_block_refs(&body, refs)
  when StmtKind::StmtDefer(body) then collect_block_refs(&body, refs)
  when StmtKind::StmtGuard(cond, else_action) then
    collect_expr_refs(&cond, refs)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(v) then collect_expr_refs(&v, refs)
      when Option::None then ()
      end
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(v) then collect_expr_refs(&v, refs)
      when Option::None then ()
      end
    when _ then ()
    end
  when StmtKind::StmtTry(body, catches, finally_opt) then
    collect_block_refs(&body, refs)
    for catch_arm in catches do
      collect_pattern_refs(&catch_arm.pattern, refs)
      collect_block_refs(&catch_arm.body, refs)
    end
    match finally_opt
    when Option::Some(fin) then collect_block_refs(&fin, refs)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat, body) then
    collect_expr_refs(&expr, refs)
    collect_pattern_refs(&pat, refs)
    collect_block_refs(&body, refs)
  when StmtKind::StmtHandleWith(expr, handlers) then
    collect_expr_refs(&expr, refs)
    for handler in handlers do
      for arm in handler.arms do
        for p in arm.params do
          collect_pattern_refs(&p, refs)
        end
        collect_block_refs(&arm.body, refs)
      end
    end
  end
end

def collect_if_refs(if_stmt: IfStmt, inout refs: Set[String]) -> Unit
  collect_expr_refs(&if_stmt.cond, refs)
  collect_block_refs(&if_stmt.then_block, refs)
  for (econd, ebody) in if_stmt.elsif_branches do
    collect_expr_refs(&econd, refs)
    collect_block_refs(&ebody, refs)
  end
  match if_stmt.else_block
  when Option::Some(e) then collect_block_refs(&e, refs)
  when Option::None then ()
  end
end

def collect_match_refs(m: MatchExpr, inout refs: Set[String]) -> Unit
  collect_expr_refs(&m.scrutinee, refs)
  for arm in m.arms do
    collect_pattern_refs(&arm.pattern, refs)
    match arm.guard_expr
    when Option::Some(g) then collect_expr_refs(&g, refs)
    when Option::None then ()
    end
    collect_block_refs(&arm.body, refs)
  end
end

def collect_pattern_refs(pattern: Pattern, inout refs: Set[String]) -> Unit
  match pattern.kind
  when PatternKind::Ident(name, _) then refs.insert(name)
  when PatternKind::Literal(lit) then collect_expr_refs(&lit, refs)
  when PatternKind::Tuple(pats) then
    for p in pats do
      collect_pattern_refs(&p, refs)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      collect_pattern_refs(&p, refs)
    end
  when PatternKind::Struct(path, fields) then
    for seg in path.segments do
      refs.insert(seg)
    end
    for (_, field_pat) in fields do
      collect_pattern_refs(&field_pat, refs)
    end
  when PatternKind::Variant(path, pats) then
    for seg in path.segments do
      refs.insert(seg)
    end
    for p in pats do
      collect_pattern_refs(&p, refs)
    end
  when PatternKind::Or(pats) then
    for p in pats do
      collect_pattern_refs(&p, refs)
    end
  when PatternKind::Range(start, end_val, _) then
    match start
    when Option::Some(s) then collect_expr_refs(&s, refs)
    when Option::None then ()
    end
    match end_val
    when Option::Some(e) then collect_expr_refs(&e, refs)
    when Option::None then ()
    end
  when _ then ()
  end
end

def collect_type_refs(ty: TypeExpr, inout refs: Set[String]) -> Unit
  match ty.kind
  when TypeExprKind::Named(name, args) then
    refs.insert(name)
    for a in args do
      collect_type_refs(&a, refs)
    end
  when TypeExprKind::Tuple(elems) then
    for e in elems do
      collect_type_refs(&e, refs)
    end
  when TypeExprKind::Array(elem, size) then
    collect_type_refs(&elem, refs)
    match size
    when Option::Some(size_expr) then collect_expr_refs(&size_expr, refs)
    when Option::None then ()
    end
  when TypeExprKind::Slice(elem) then collect_type_refs(&elem, refs)
  when TypeExprKind::Ptr(inner) then collect_type_refs(&inner, refs)
  when TypeExprKind::PtrMut(inner) then collect_type_refs(&inner, refs)
  when TypeExprKind::Ref(inner, _) then collect_type_refs(&inner, refs)
  when TypeExprKind::Fn(params, ret) then
    for p in params do
      collect_type_refs(&p.ty, refs)
    end
    collect_type_refs(&ret, refs)
  when TypeExprKind::Async(inner) then collect_type_refs(&inner, refs)
  when TypeExprKind::Effect(_, inner) then collect_type_refs(&inner, refs)
  when TypeExprKind::Path(path) then
    for seg in path.segments do
      refs.insert(seg)
    end
  when _ then ()
  end
end

def collect_expr_refs(expr: Expr, inout refs: Set[String]) -> Unit
  match expr.kind
  when ExprKind::ExprIdent(name) then refs.insert(name)
  when ExprKind::ExprPath(path) then
    for seg in path.segments do
      refs.insert(seg)
    end
  when ExprKind::ExprArrayLit(elems) then
    for e in elems do
      collect_expr_refs(&e, refs)
    end
  when ExprKind::ExprTupleLit(elems) then
    for e in elems do
      collect_expr_refs(&e, refs)
    end
  when ExprKind::ExprStructLit(path, fields) then
    for seg in path.segments do
      refs.insert(seg)
    end
    for (_, field_value) in fields do
      collect_expr_refs(&field_value, refs)
    end
  when ExprKind::ExprMapLit(entries) then
    for (key, value) in entries do
      collect_expr_refs(&key, refs)
      collect_expr_refs(&value, refs)
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    collect_expr_refs(left, refs)
    collect_expr_refs(right, refs)
  when ExprKind::ExprUnaryOp(_, operand) then
    collect_expr_refs(operand, refs)
  when ExprKind::ExprFieldAccess(obj, _) then
    collect_expr_refs(obj, refs)
  when ExprKind::ExprMethodCall(receiver, method, type_args, args) then
    collect_expr_refs(receiver, refs)
    refs.insert(method)
    for ta in type_args do
      collect_type_refs(&ta, refs)
    end
    for a in args do
      collect_expr_refs(&a, refs)
    end
  when ExprKind::ExprIndex(arr, idx) then
    collect_expr_refs(arr, refs)
    collect_expr_refs(idx, refs)
  when ExprKind::ExprCall(callee, args) then
    collect_expr_refs(callee, refs)
    for a in args do
      collect_expr_refs(&a, refs)
    end
  when ExprKind::ExprClosure(params, ret_ty, body) then
    for param in params do
      collect_pattern_refs(&param.pat, refs)
      match param.ty
      when Option::Some(param_ty) then collect_type_refs(&param_ty, refs)
      when Option::None then ()
      end
    end
    match ret_ty
    when Option::Some(ret_type) then collect_type_refs(&ret_type, refs)
    when Option::None then ()
    end
    collect_expr_refs(body, refs)
  when ExprKind::ExprAccess(inner) then
    collect_expr_refs(inner, refs)
  when ExprKind::ExprRawDeref(inner) then
    collect_expr_refs(inner, refs)
  when ExprKind::ExprIf(if_stmt) then collect_if_refs(&if_stmt, refs)
  when ExprKind::ExprMatch(m) then collect_match_refs(&m, refs)
  when ExprKind::ExprBlock(block) then collect_block_refs(&block, refs)
  when ExprKind::ExprUnsafe(_, block) then collect_block_refs(&block, refs)
  when ExprKind::ExprAsync(block) then collect_block_refs(&block, refs)
  when ExprKind::ExprAwait(inner) then collect_expr_refs(inner, refs)
  when ExprKind::ExprTry(inner) then collect_expr_refs(inner, refs)
  when ExprKind::ExprRange(start_opt, end_opt, _) then
    match start_opt
    when Option::Some(s) then collect_expr_refs(&s, refs)
    when Option::None then ()
    end
    match end_opt
    when Option::Some(e) then collect_expr_refs(&e, refs)
    when Option::None then ()
    end
  when ExprKind::ExprCast(val, ty) then
    collect_expr_refs(val, refs)
    collect_type_refs(&ty, refs)
  when ExprKind::ExprTypeCheck(val, ty) then
    collect_expr_refs(val, refs)
    collect_type_refs(&ty, refs)
  when ExprKind::ExprComptime(block) then collect_block_refs(&block, refs)
  when ExprKind::ExprEnumVariant(path, args) then
    for seg in path.segments do
      refs.insert(seg)
    end
    for a in args do
      collect_expr_refs(&a, refs)
    end
  when ExprKind::ExprAssign(target, value) then
    collect_expr_refs(target, refs)
    collect_expr_refs(value, refs)
  when ExprKind::ExprPipe(left, right) then
    collect_expr_refs(left, refs)
    collect_expr_refs(right, refs)
  when ExprKind::ExprMacroCall(_, args) then
    for a in args do
      collect_expr_refs(&a, refs)
    end
  when _ then ()
  end
end

# (semantic lints): the typed-program DefId reachability — every call
# target, DefId-carrying expression resolution and type definition
# recorded by the resolver/type checker. An item whose DefId appears in
# this set is referenced. The resolutions snapshot is cloned once per file
# (ResolvedNames: Clone — compiler_core clones it when building the
# AnalyzedProgram); the analyzed program itself is never held by the
# linter.
def collect_referenced_defs(resolutions: ResolvedNames, inout refs: Set[Int]) -> Unit
  for (_, did) in resolutions.call_targets.entries() do
    refs.insert(def_id_numeric(did))
  end
  for (_, resolved) in resolutions.expr_resolutions.entries() do
    match resolved.kind
    when ResolvedExprKind::Function(did) then refs.insert(def_id_numeric(did))
    when ResolvedExprKind::Method(did) then refs.insert(def_id_numeric(did))
    when ResolvedExprKind::Constant(did) then refs.insert(def_id_numeric(did))
    when ResolvedExprKind::Static(did) then refs.insert(def_id_numeric(did))
    when _ then ()
    end
  end
  for (_, did) in resolutions.type_def_ids.entries() do
    refs.insert(def_id_numeric(did))
  end
end

# An item is referenced: on the typed path, one of the item's DefIds
# (resolutions.item_defs — the item-index keyed table) appears in the
# resolver's reference tables; on the AST path, its name appears in the
# program-wide reference set.
def lint_item_referenced(inout ctx: LintContext, item_index: Int, name: String) -> Bool
  match ctx.item_def_numerics.get(item_index)
  when Option::Some(defs) then
    for n in defs do
      if ctx.referenced_defs.contains(n) then
        return true
      end
    end
    false
  when Option::None then
    ctx.referenced_names.contains(name)
  end
end

# ———————————————————————————————————————————————————————————————
# Lint Levels and Configuration
# ———————————————————————————————————————————————————————————————

enum LintLevel
  Error
  Warning
  Info
end

struct LintDiagnostic
  lint_name: String
  level: LintLevel
  message: String
  file: String
  line: UInt
  column: UInt
  span: Option[Span]
  suggestion: Option[String]
end

struct LintConfig
  denied: Vec[String]       # Lint names to treat as errors
  warned: Vec[String]       # Lint names to treat as warnings
  allowed: Vec[String]      # Lint names to suppress
  json_output: Bool
end

def default_lint_config() -> LintConfig
  LintConfig {
    denied: Vec::new(),
    warned: Vec::new(),
    allowed: Vec::new(),
    json_output: false
  }
end

def duplicate_lint_config(config: LintConfig) -> LintConfig
  LintConfig {
    denied: config.denied.clone(),
    warned: config.warned.clone(),
    allowed: config.allowed.clone(),
    json_output: config.json_output
  }
end

# ———————————————————————————————————————————————————————————————
# Lint Pass Trait
# ———————————————————————————————————————————————————————————————

trait LintPass
  def name(self) -> String
  def description(self) -> String
  def default_level(self) -> LintLevel
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
end

struct LintContext
  file: String
  source: String
  diagnostics: Vec[LintDiagnostic]
  config: LintConfig
  suppressed: Set[String]          # Currently active #[allow] overrides
  # (semantic lints): the typed-program-DERIVED data — the source-string
  # heuristics are removed. When the full analysis (resolve + type-check +
  # access + resource) runs on the file, `referenced_defs` holds the
  # resolver's DefId reachability (call targets, DefId-carrying expression
  # resolutions, type definitions) and `item_def_numerics` maps each item
  # index to its DefId numerics (the item_defs table) — the dead_code
  # pass's typed path. When the analysis cannot run (e.g. a fragment that
  # fails the access/resource checks) the AST reference sets are the
  # fallback; the linter still reports on the file.
  referenced_names: Set[String]
  referenced_defs: Set[Int]
  item_def_numerics: Map[Int, Vec[Int]]
  current_item_index: Int
end

def lint_context_new(file: String, source: String, config: LintConfig) -> LintContext
  LintContext {
    file: file,
    source: source,
    diagnostics: Vec::new(),
    config: config,
    suppressed: Set::new(),
    referenced_names: Set::new(),
    referenced_defs: Set::new(),
    item_def_numerics: Map::new(),
    current_item_index: 0
  }
end

impl LintContext
  def emit(inout self, lint_name: String, level: LintLevel, message: String, span: Span) -> Unit
    # Check #[allow] suppression
    let lint_key = lint_name.clone()
    if self.suppressed.contains(&lint_key) then return end
    if self.config.allowed.contains(&lint_key) then return end
    
    # Override level from config
    let effective_level = if self.config.denied.contains(&lint_key) then
      LintLevel::Error
    elsif self.config.warned.contains(&lint_key) then
      LintLevel::Warning
    else
      level
    end
    
    let (line, col) = offset_to_line_col(&self.source, span.start)
    
    self.diagnostics.push(LintDiagnostic {
      lint_name: lint_name,
      level: effective_level,
      message: message,
      file: self.file.clone(),
      line: line,
      column: col,
      span: Option::Some(span),
      suggestion: Option::None
    })
  end
  
  def emit_with_suggestion(inout self, lint_name: String, level: LintLevel,
                           message: String, span: Span, suggestion: String) -> Unit
    let lint_key = lint_name.clone()
    if self.suppressed.contains(&lint_key) then return end
    if self.config.allowed.contains(&lint_key) then return end
    
    let effective_level = if self.config.denied.contains(&lint_key) then
      LintLevel::Error
    elsif self.config.warned.contains(&lint_key) then
      LintLevel::Warning
    else
      level
    end
    
    let (line, col) = offset_to_line_col(&self.source, span.start)
    
    self.diagnostics.push(LintDiagnostic {
      lint_name: lint_name,
      level: effective_level,
      message: message,
      file: self.file.clone(),
      line: line,
      column: col,
      span: Option::Some(span),
      suggestion: Option::Some(suggestion)
    })
  end
  
  def push_allow(inout self, sink lint_name: String) -> Unit
    self.suppressed.insert(lint_name)
  end
  
  def pop_allow(inout self, lint_name: String) -> Unit
    self.suppressed.remove(lint_name)
  end
end

def offset_to_line_col(source: String, offset: UInt) -> (UInt, UInt)
  var line: UInt = 1
  var col: UInt = 1
  var i: UInt = 0
  while i < offset && i < source.len() do
    if source.char_at(i) == '\n' then
      line = line + 1
      col = 1
    else
      col = col + 1
    end
    i = i + 1
  end
  (line, col)
end

# ———————————————————————————————————————————————————————————————
# Built-in Lint Passes
# ———————————————————————————————————————————————————————————————

# ---- unused_variables ----
struct UnusedVariablesLint end

impl LintPass for UnusedVariablesLint
  def name(self) -> String
    "unused_variables".to_string()
  end

  def description(self) -> String
    "Detects variables that are declared but never used".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end
  
  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    # Collect all declared variables
    var declared = Map::new()  # name -> (span, is_used)
    
    match func.body
    when FnBody::FnBlock(block) then
      collect_declarations(&block, &mut declared)
      
      # Walk the body to mark used variables
      mark_used_in_block(&block, &mut declared)
      
      # Report unused
      for entry in declared do
        if !entry.value.1 && !entry.key.starts_with("_") then
          ctx.emit_with_suggestion(
            "unused_variables".to_string(),
            LintLevel::Warning,
            "unused variable `" + entry.key + "`",
            entry.value.0,
            "prefix with underscore: _" + entry.key
          )
        end
      end
    when _ then ()
    end
  end
end

def collect_declarations(block: Block, inout declared: Map[String, (Span, Bool)]) -> Unit
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtLet(pattern, _, _, _) then
      lint_collect_pattern_names(&pattern, declared, stmt.span)
    when _ then ()
    end
  end
end

def lint_collect_pattern_names(pattern: Pattern, inout declared: Map[String, (Span, Bool)], span: Span) -> Unit
  match pattern.kind
  when PatternKind::Ident(name, _) then
    declared.insert(name.clone(), (span, false))
  when PatternKind::Tuple(pats) then
    for p in pats do
      lint_collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Struct(_, fields) then
    for (_, p) in fields do
      lint_collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Variant(_, pats) then
    for p in pats do
      lint_collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      lint_collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Or(pats) then
    for p in pats do
      lint_collect_pattern_names(&p, declared, span)
    end
  when _ then ()
  end
end

def mark_used_in_block(block: Block, inout declared: Map[String, (Span, Bool)]) -> Unit
  for stmt in block.stmts do
    mark_used_in_stmt(stmt, declared)
  end
end

def mark_used_in_stmt(stmt: Stmt, inout declared: Map[String, (Span, Bool)]) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then mark_used_in_expr(expr, declared)
  when StmtKind::StmtLet(_, _, init, _) then
    mark_used_in_expr(init, declared)
  when StmtKind::StmtFor(for_stmt) then
    mark_used_in_expr(for_stmt.iter, declared)
    mark_used_in_block(for_stmt.body, declared)
  when StmtKind::StmtWhile(cond, body) then
    mark_used_in_expr(cond, declared)
    mark_used_in_block(body, declared)
  when StmtKind::StmtLoop(body) then
    mark_used_in_block(body, declared)
  when StmtKind::StmtReturn(val) then
    match val
    when Option::Some(v) then mark_used_in_expr(v, declared)
    when Option::None then ()
    end
  when _ then ()
  end
end

def mark_used_in_expr(expr: Expr, inout declared: Map[String, (Span, Bool)]) -> Unit
  match expr.kind
  when ExprKind::ExprIdent(name) then
    match declared.get(name)
    when Option::Some(entry) then
      var new_entry = entry
      new_entry.1 = true
      declared.insert(name.clone(), new_entry)
    when Option::None then ()
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    mark_used_in_expr(left, declared)
    mark_used_in_expr(right, declared)
  when ExprKind::ExprUnaryOp(_, operand) then
    mark_used_in_expr(operand, declared)
  when ExprKind::ExprCall(callee, args) then
    mark_used_in_expr(callee, declared)
    for arg in args do mark_used_in_expr(arg, declared) end
  when ExprKind::ExprMethodCall(receiver, method_name, type_args, args) then
    mark_used_in_expr(receiver, declared)
    for arg in args do mark_used_in_expr(arg, declared) end
  when ExprKind::ExprFieldAccess(obj, _) then
    mark_used_in_expr(obj, declared)
  when ExprKind::ExprIndex(arr, idx) then
    mark_used_in_expr(arr, declared)
    mark_used_in_expr(idx, declared)
  when ExprKind::ExprIf(if_stmt) then
    mark_used_in_expr(&if_stmt.cond, declared)
    mark_used_in_block(&if_stmt.then_block, declared)
    for elsif_branch in if_stmt.elsif_branches do
      let (econd, ebody) = elsif_branch
      mark_used_in_expr(&econd, declared)
      mark_used_in_block(&ebody, declared)
    end
    match if_stmt.else_block
    when Option::Some(e) then mark_used_in_block(e, declared)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    mark_used_in_expr(&m.scrutinee, declared)
    for arm in m.arms do
      mark_used_in_block(&arm.body, declared)
    end
  when ExprKind::ExprBlock(block) then
    for s in block.stmts do mark_used_in_stmt(s, declared) end
  when ExprKind::ExprClosure(params, _ret_ty, body) then
    mark_used_in_expr(body, declared)
  when ExprKind::ExprAssign(target, value) then
    mark_used_in_expr(target, declared)
    mark_used_in_expr(value, declared)
  when _ then ()
  end
end

# ---- unused_imports ----
struct UnusedImportsLint end

impl LintPass for UnusedImportsLint
  def name(self) -> String
    "unused_imports".to_string()
  end

  def description(self) -> String
    "Detects imported names that are not used in the file".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    match item.kind
    when ItemKind::ItemUse(u) then
      match u.names
      when Option::Some(names) then
        for imported_name in names do
          # SEMANTIC check: the imported name is used iff the program's AST
          # references it (an expression identifier, a path segment, a
          # method name, a type name, a pattern identifier). The former
          # source-text occurrence count is GONE — it matched comments,
          # string payloads and unrelated identifiers.
          if !ctx.referenced_names.contains(imported_name) then
            # Import name appears only in the use statement itself — unused
            ctx.emit(
              "unused_imports".to_string(),
              LintLevel::Warning,
              "unused import: `" + imported_name + "`",
              item.span
            )
          end
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end

  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    ()
  end
end

# ---- dead_code ----
struct DeadCodeLint end

impl LintPass for DeadCodeLint
  def name(self) -> String
    "dead_code".to_string()
  end

  def description(self) -> String
    "Detects functions and types that are never referenced".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    match item.kind
    when ItemKind::ItemFunction(func) then
      if func.vis != Visibility::Public && func.name != "main" then
        # SEMANTIC reachability: on the typed path, the item's DefId
        # appears in the resolver's reference tables (call targets,
        # DefId-carrying expression resolutions, type definitions); on the
        # AST path, the name appears in the program-wide reference set.
        # The former source-text occurrence count is GONE — it matched
        # comments, string payloads and unrelated identifiers.
        if !lint_item_referenced(ctx, ctx.current_item_index, func.name.clone()) then
          ctx.emit(
            "dead_code".to_string(),
            LintLevel::Warning,
            "function `" + func.name + "` is never used",
            item.span
          )
        end
      end
    when ItemKind::ItemStruct(s) then
      if s.vis != Visibility::Public then
        if !lint_item_referenced(ctx, ctx.current_item_index, s.name.clone()) then
          ctx.emit(
            "dead_code".to_string(),
            LintLevel::Warning,
            "struct `" + s.name + "` is never used",
            item.span
          )
        end
      end
    when _ then ()
    end
  end
  
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end

  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    ()
  end
end

# ---- needless_mut ----
struct NeedlessMutLint end

impl LintPass for NeedlessMutLint
  def name(self) -> String
    "needless_mut".to_string()
  end

  def description(self) -> String
    "Detects `mut` variables that are never mutated".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end
  
  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    # Find all `mut` bindings and check if they're ever assigned to
    match func.body
    when FnBody::FnBlock(block) then
      var mut_vars = Map::new()  # name -> span
      
      for stmt in block.stmts do
        match stmt.kind
        when StmtKind::StmtLet(pattern, _, _, is_mut) then
          if is_mut then
            match pattern.kind
            when PatternKind::Ident(name) then
              mut_vars.insert(name.clone(), stmt.span)
            when _ then ()
            end
          end
        when _ then ()
        end
      end
      
      # Check if any mut var is actually assigned
      let assigned = find_assignments_in_block(&block)
      
      for entry in mut_vars do
        let var_name = entry.key.clone()
        if !assigned.contains(&var_name) then
          ctx.emit_with_suggestion(
            "needless_mut".to_string(),
            LintLevel::Warning,
            "variable `" + entry.key + "` is declared `mut` but never mutated",
            entry.value,
            "remove `mut`: let " + entry.key
          )
        end
      end
    when _ then ()
    end
  end
end

def find_assignments_in_block(block: Block) -> Set[String]
  var assigned = Set::new()
  for stmt in block.stmts do
    find_assignments_in_stmt(stmt, &mut assigned)
  end
  assigned
end

def find_assignments_in_stmt(stmt: Stmt, inout assigned: Set[String]) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then find_assignments_in_expr(expr, assigned)
  when StmtKind::StmtFor(for_stmt) then
    find_assignments_in_expr(for_stmt.iter, assigned)
    for s in for_stmt.body.stmts do find_assignments_in_stmt(s, assigned) end
  when StmtKind::StmtWhile(cond, body) then
    find_assignments_in_expr(cond, assigned)
    for s in body.stmts do find_assignments_in_stmt(s, assigned) end
  when StmtKind::StmtLoop(body) then
    for s in body.stmts do find_assignments_in_stmt(s, assigned) end
  when _ then ()
  end
end

def find_assignments_in_expr(expr: Expr, inout assigned: Set[String]) -> Unit
  match expr.kind
  when ExprKind::ExprAssign(target, value) then
    match target.kind
    when ExprKind::ExprIdent(name) then assigned.insert(name.clone())
    when _ then ()
    end
    find_assignments_in_expr(value, assigned)
  when ExprKind::ExprMethodCall(receiver, method, type_args, call_args) then
    # Methods on &mut self count as mutation
    match receiver.kind
    when ExprKind::ExprIdent(name) then assigned.insert(name.clone())
    when _ then ()
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    find_assignments_in_expr(left, assigned)
    find_assignments_in_expr(right, assigned)
  when ExprKind::ExprCall(callee, args) then
    find_assignments_in_expr(callee, assigned)
    for arg in args do find_assignments_in_expr(arg, assigned) end
  when ExprKind::ExprIf(if_stmt) then
    find_assignments_in_expr(&if_stmt.cond, assigned)
    for s in if_stmt.then_block.stmts do find_assignments_in_stmt(s, assigned) end
    match if_stmt.else_block
    when Option::Some(e) then
      for s in e.stmts do find_assignments_in_stmt(s, assigned) end
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    find_assignments_in_expr(&m.scrutinee, assigned)
    for arm in m.arms do
      for s in arm.body.stmts do find_assignments_in_stmt(s, assigned) end
    end
  when ExprKind::ExprBlock(block) then
    for s in block.stmts do find_assignments_in_stmt(s, assigned) end
  when ExprKind::ExprUnaryOp(_, inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprCast(inner, _) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprRawDeref(inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprFieldAccess(recv, _) then
    find_assignments_in_expr(recv, assigned)
  when ExprKind::ExprIndex(recv, idx) then
    find_assignments_in_expr(recv, assigned)
    find_assignments_in_expr(idx, assigned)
  when ExprKind::ExprAccess(inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprTupleLit(elems) then
    for e in elems do find_assignments_in_expr(e, assigned) end
  when ExprKind::ExprArrayLit(elems) then
    for e in elems do find_assignments_in_expr(e, assigned) end
  when _ then ()
  end
end

# ---- naming_conventions ----
struct NamingConventionsLint end

impl LintPass for NamingConventionsLint
  def name(self) -> String
    "naming_conventions".to_string()
  end

  def description(self) -> String
    "Enforces Tangerine naming conventions".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    match item.kind
    when ItemKind::ItemFunction(func) then
      if !is_snake_case(func.name.clone()) && !func.name.starts_with("_") then
        ctx.emit_with_suggestion(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "function `" + func.name + "` should be snake_case",
          item.span,
          "rename to: " + to_snake_case(func.name.clone())
        )
      end
    when ItemKind::ItemStruct(s) then
      if !is_pascal_case(s.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "struct `" + s.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemEnum(e) then
      if !is_pascal_case(e.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "enum `" + e.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemTrait(t) then
      if !is_pascal_case(t.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "trait `" + t.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemConst(c) then
      if !is_screaming_snake_case(c.name.clone()) && !is_snake_case(c.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "constant `" + c.name + "` should be SCREAMING_SNAKE_CASE or snake_case",
          item.span
        )
      end
    when _ then ()
    end
  end
  
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end

  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    ()
  end
end

# ---- unsafe_usage ----
struct UnsafeUsageLint end

impl LintPass for UnsafeUsageLint
  def name(self) -> String
    "unsafe_usage".to_string()
  end

  def description(self) -> String
    "Flags all uses of unsafe blocks for audit".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Info
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end

  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    ()
  end
  
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    match expr.kind
    when ExprKind::ExprUnsafe(_, _) then
      ctx.emit(
        "unsafe_usage".to_string(),
        LintLevel::Info,
        "unsafe block usage — requires audit",
        expr.span
      )
    when _ then ()
    end
  end
end

# ---- large_function ----
struct LargeFunctionLint
  max_lines: UInt
end

impl LintPass for LargeFunctionLint
  def name(self) -> String
    "large_function".to_string()
  end

  def description(self) -> String
    "Warns about functions that are too long".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end
  
  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    # EXACT line count over the function's source span — the former
    # span/40 estimate is GONE (it misclassified long single-line
    # functions and short dense ones).
    let source_len = ctx.source.len()
    let end_pos = if func.span.end_pos <= source_len then func.span.end_pos else source_len end
    var lines: UInt = 1
    var i = func.span.start
    while i < end_pos do
      if ctx.source.char_at(i) == '\n' then
        lines = lines + 1
      end
      i = i + 1
    end
    
    if lines > self.max_lines then
      ctx.emit(
        "large_function".to_string(),
        LintLevel::Warning,
        "function `" + func.name + "` is too long (" + lines.to_string() + " lines, max " + self.max_lines.to_string() + ")",
        func.span
      )
    end
  end
end

# ---- redundant_return ----
struct RedundantReturnLint end

impl LintPass for RedundantReturnLint
  def name(self) -> String
    "redundant_return".to_string()
  end

  def description(self) -> String
    "Detects `return` at the end of a function body".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end
  
  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    match func.body
    when FnBody::FnBlock(block) then
      if block.stmts.is_empty() then return end
      
      let last_stmt = block.stmts.last()
      match last_stmt
      when Option::Some(stmt) then
        match stmt.kind
        when StmtKind::StmtReturn(val) then
          match val
          when Option::Some(_) then
            ctx.emit_with_suggestion(
              "redundant_return".to_string(),
              LintLevel::Warning,
              "redundant `return` at end of function body",
              stmt.span,
              "remove `return` keyword — last expression is returned implicitly"
            )
          when Option::None then ()
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
end

# ---- empty_block ----
struct EmptyBlockLint end

impl LintPass for EmptyBlockLint
  def name(self) -> String
    "empty_block".to_string()
  end

  def description(self) -> String
    "Warns about empty blocks that may be accidentally empty".to_string()
  end

  def default_level(self) -> LintLevel
    LintLevel::Warning
  end

  def check_item(self, inout ctx: LintContext, item: Item) -> Unit
    ()
  end

  def check_stmt(self, inout ctx: LintContext, stmt: Stmt) -> Unit
    ()
  end

  def check_function(self, inout ctx: LintContext, func: FunctionDecl) -> Unit
    ()
  end
  
  def check_expr(self, inout ctx: LintContext, expr: Expr) -> Unit
    match expr.kind
    when ExprKind::ExprIf(if_stmt) then
      if if_stmt.then_block.stmts.is_empty() then
        ctx.emit(
          "empty_block".to_string(),
          LintLevel::Warning,
          "empty `then` block",
          expr.span
        )
      end
    when ExprKind::ExprBlock(stmts) then
      if stmts.is_empty() then
        ctx.emit(
          "empty_block".to_string(),
          LintLevel::Warning,
          "empty block",
          expr.span
        )
      end
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Naming Convention Helpers
# ———————————————————————————————————————————————————————————————

def is_snake_case(name: String) -> Bool
  if name.is_empty() then return true end
  for c in name.chars() do
    if c.is_uppercase() then return false end
    if c != '_' && !c.is_alphanumeric() then return false end
  end
  true
end

def is_pascal_case(name: String) -> Bool
  if name.is_empty() then return false end
  let first = name.char_at(0)
  if !first.is_uppercase() then return false end
  # Should not contain underscores
  !name.contains("_")
end

def is_screaming_snake_case(name: String) -> Bool
  if name.is_empty() then return false end
  for c in name.chars() do
    if c.is_lowercase() then return false end
    if c != '_' && !c.is_alphanumeric() then return false end
  end
  true
end

def to_snake_case(name: String) -> String
  var result = ""
  
  for i in 0..name.len() do
    let c = name.char_at(i)
    if c.is_uppercase() then
      if !result.is_empty() then
        # Insert underscore if prev was lowercase, or if this uppercase
        # is followed by lowercase (end of acronym like HTMLParser → html_parser)
        let prev = name.char_at(i - 1)
        if prev.is_lowercase() then
          result = result + "_"
        elsif i + 1 < name.len() && name.char_at(i + 1).is_lowercase() then
          result = result + "_"
        end
      end
      result = result + c.to_lowercase().to_string()
    else
      result = result + c.to_string()
    end
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Lint Runner
# ———————————————————————————————————————————————————————————————

struct LintRunner
  passes: Vec[Box[dyn LintPass]]
end

def lint_runner_new() -> LintRunner
  var passes: Vec[Box[dyn LintPass]] = Vec::new()
  
  # Register all built-in lint passes
  passes.push(Box::new(UnusedVariablesLint {}))
  passes.push(Box::new(UnusedImportsLint {}))
  passes.push(Box::new(DeadCodeLint {}))
  passes.push(Box::new(NeedlessMutLint {}))
  passes.push(Box::new(NamingConventionsLint {}))
  passes.push(Box::new(UnsafeUsageLint {}))
  passes.push(Box::new(LargeFunctionLint { max_lines: 100 }))
  passes.push(Box::new(RedundantReturnLint {}))
  passes.push(Box::new(EmptyBlockLint {}))
  
  LintRunner { passes: passes }
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lint_file(path: String, config: LintConfig) -> Result[Vec[LintDiagnostic], String]
  match read_file(path.clone())
  when Result::Err(e) then Result::Err("Cannot read: " + e)
  when Result::Ok(source) then
    lint_source(path, source, config)
  end
end

def lint_source(file: String, source: String, config: LintConfig) -> Result[Vec[LintDiagnostic], String]
  let tokens = tokenize(source.clone(), file.clone())
  let parse_out = parse(tokens)
  if diag_has_errors(&parse_out.diagnostics) then
    Result::Err("Parse error: " + parse_out.diagnostics[0].message)
  else
    var ctx = lint_context_new(file, source, duplicate_lint_config(config))
    # (semantic lints): the program-wide AST reference set — the passes
    # consult it instead of source-text occurrence counts. The typed
    # semantic data (the resolver's DefId reachability + the item-index ->
    # DefId table) is attached when the full analysis runs (a file that
    # fails the access/resource checks keeps the AST fallback — the
    # linter still reports on it).
    collect_program_references(&parse_out.program, &mut ctx.referenced_names)
    match analyze_source(ctx.source.clone(), ctx.file.clone(), default_options())
    when Result::Ok(analyzed) then
      let resolutions_snapshot = analyzed.resolutions.clone()
      collect_referenced_defs(resolutions_snapshot.clone(), &mut ctx.referenced_defs)
      for (idx, defs) in resolutions_snapshot.item_defs.entries() do
        var nums: Vec[Int] = Vec::new()
        for did in defs do
          nums.push(def_id_numeric(did))
        end
        ctx.item_def_numerics.insert(idx, nums)
      end
    when Result::Err(_) then ()
    end
    let runner = lint_runner_new()
    run_lint_runner(&runner, &parse_out.program, &mut ctx)
    Result::Ok(ctx.diagnostics)
  end
end

def list_lints() -> Vec[(String, String, LintLevel)]
  let runner = lint_runner_new()
  var lints = Vec::new()
  for pass in runner.passes do
    lints.push((pass.name(), pass.description(), pass.default_level()))
  end
  lints
end

def run_lint_runner(runner: LintRunner, ast: Program, inout ctx: LintContext) -> Unit
  var item_index = 0
  for item in ast.items do
    # (semantic lints): the current item's position in the parsed program
    # — the key the resolver's item_defs table records the item's DefIds
    # under (the analyzed program's item order matches the parsed
    # program's: analyze_source analyzes the same single file).
    ctx.current_item_index = item_index

    # Check for #[allow] annotations
    for attr in item.attrs do
      if attr.name == "allow" then
        if !attr.args.is_empty() then
          let lint_name = attr.args[0].clone()
          ctx.push_allow(lint_name)
        end
      end
    end

    # Run item-level checks
    for pass in runner.passes do
      pass.check_item(ctx, item)
    end

    # Run function-level checks
    match item.kind
    when ItemKind::ItemFunction(func) then
      for pass in runner.passes do
        pass.check_function(ctx, func)
      end

      match func.body
      when FnBody::FnBlock(block) then
        walk_lint_block(runner, ctx, &block)
      when _ then ()
      end
    when ItemKind::ItemImpl(imp) then
      for method in imp.methods do
        for pass in runner.passes do
          pass.check_function(ctx, method)
        end
        match method.body
        when FnBody::FnBlock(block) then
          walk_lint_block(runner, ctx, &block)
        when _ then ()
        end
      end
    when _ then ()
    end

    # Pop #[allow] overrides
    for attr in item.attrs do
      if attr.name == "allow" then
        if !attr.args.is_empty() then
          let lint_name = attr.args[0].clone()
          ctx.pop_allow(lint_name)
        end
      end
    end
    item_index = item_index + 1
  end
end

def walk_lint_block(runner: LintRunner, inout ctx: LintContext, block: Block) -> Unit
  for stmt in block.stmts do
    for pass in runner.passes do
      pass.check_stmt(ctx, stmt)
    end
    walk_lint_stmt_exprs(runner, ctx, stmt)
  end
end

def walk_lint_stmt_exprs(runner: LintRunner, inout ctx: LintContext, stmt: Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then walk_lint_expr(runner, ctx, expr)
  when StmtKind::StmtLet(_, _, init, _) then
    walk_lint_expr(runner, ctx, init)
  when StmtKind::StmtFor(for_stmt) then
    walk_lint_expr(runner, ctx, for_stmt.iter)
    walk_lint_block(runner, ctx, for_stmt.body)
  when StmtKind::StmtWhile(cond, body) then
    walk_lint_expr(runner, ctx, cond)
    walk_lint_block(runner, ctx, body)
  when StmtKind::StmtLoop(body) then
    walk_lint_block(runner, ctx, body)
  when StmtKind::StmtReturn(val) then
    match val
    when Option::Some(v) then walk_lint_expr(runner, ctx, v)
    when Option::None then ()
    end
  when _ then ()
  end
end

def walk_lint_expr(runner: LintRunner, inout ctx: LintContext, expr: Expr) -> Unit
  for pass in runner.passes do
    pass.check_expr(ctx, expr)
  end

  match expr.kind
  when ExprKind::ExprBinaryOp(_, left, right) then
    walk_lint_expr(runner, ctx, left)
    walk_lint_expr(runner, ctx, right)
  when ExprKind::ExprUnaryOp(_, operand) then
    walk_lint_expr(runner, ctx, operand)
  when ExprKind::ExprCall(callee, args) then
    walk_lint_expr(runner, ctx, callee)
    for arg in args do
      walk_lint_expr(runner, ctx, arg)
    end
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    walk_lint_expr(runner, ctx, receiver)
    for arg in args do
      walk_lint_expr(runner, ctx, arg)
    end
  when ExprKind::ExprFieldAccess(obj, _) then
    walk_lint_expr(runner, ctx, obj)
  when ExprKind::ExprIndex(arr, idx) then
    walk_lint_expr(runner, ctx, arr)
    walk_lint_expr(runner, ctx, idx)
  when ExprKind::ExprIf(if_stmt) then
    walk_lint_expr(runner, ctx, &if_stmt.cond)
    walk_lint_block(runner, ctx, &if_stmt.then_block)
    match if_stmt.else_block
    when Option::Some(e) then
      walk_lint_block(runner, ctx, &e)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    walk_lint_expr(runner, ctx, &m.scrutinee)
    for arm in m.arms do
      walk_lint_block(runner, ctx, &arm.body)
    end
  when ExprKind::ExprClosure(_, _, body) then
    walk_lint_expr(runner, ctx, body)
  when ExprKind::ExprAssign(target, value) then
    walk_lint_expr(runner, ctx, target)
    walk_lint_expr(runner, ctx, value)
  when _ then ()
  end
end
