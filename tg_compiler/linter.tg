# Tangerine Compiler — Linter
#
# Static analysis and style enforcement for Tangerine source code.
# Provides configurable lint rules that check AST and type information.
#
# Architecture:
# - LintPass trait: each lint rule implements this trait
# - LintRunner: discovers and executes lint passes
# - Supports #[allow(lint_name)], #[deny(lint_name)], #[warn(lint_name)]

use std::core::{Option, Result, Vec, String, Bool, UInt}
use std::collections::{Map, Set}
use std::fs::{read_file}
use std::io::{eprintln}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{Program, Item, ItemKind, Expr, ExprKind, Stmt, StmtKind,
                        FunctionDecl, FnBody, Param, ParamModifier, TypeExpr, Pattern,
                        Block, Visibility, Annotation, AnnotationArg,
                        StructDecl, EnumDecl, TraitDecl, ImplDecl}
use tg_compiler::token::{Token, TokenKind, Span}

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

# Count occurrences of a name identifier within source text
def count_name_occurrences(source: &String, name: &String) -> Int
  mut count = 0
  mut pos = 0
  let name_len = name.len()
  while pos + name_len <= source.len() do
    if source.slice(pos, pos + name_len) == name.clone() then
      # Check word boundaries (not part of larger identifier)
      let before_ok = pos == 0 || !is_ident_char(source.char_at(pos - 1))
      let after_ok = pos + name_len >= source.len() || !is_ident_char(source.char_at(pos + name_len))
      if before_ok && after_ok then
        count = count + 1
      end
      pos = pos + name_len
    else
      pos = pos + 1
    end
  end
  count
end

def is_ident_char(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
end

# ———————————————————————————————————————————————————————————————
# Lint Levels and Configuration
# ———————————————————————————————————————————————————————————————

enum LintLevel
  Error
  Warning
  Info
end

struct LintDiagnostic
  lint_name: String
  level: LintLevel
  message: String
  file: String
  line: UInt
  column: UInt
  span: Option[Span]
  suggestion: Option[String]
end

struct LintConfig
  denied: Vec[String]       # Lint names to treat as errors
  warned: Vec[String]       # Lint names to treat as warnings
  allowed: Vec[String]      # Lint names to suppress
  json_output: Bool
end

def default_lint_config() -> LintConfig
  LintConfig {
    denied: Vec::new(),
    warned: Vec::new(),
    allowed: Vec::new(),
    json_output: false
  }
end

def duplicate_lint_config(config: &LintConfig) -> LintConfig
  LintConfig {
    denied: config.denied.clone(),
    warned: config.warned.clone(),
    allowed: config.allowed.clone(),
    json_output: config.json_output
  }
end

# ———————————————————————————————————————————————————————————————
# Lint Pass Trait
# ———————————————————————————————————————————————————————————————

trait LintPass
  def name(&self) -> String
  def description(&self) -> String
  def default_level(&self) -> LintLevel
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
end

struct LintContext
  file: String
  source: String
  diagnostics: Vec[LintDiagnostic]
  config: LintConfig
  suppressed: Set[String]          # Currently active #[allow] overrides
end

def lint_context_new(file: String, source: String, config: LintConfig) -> LintContext
  LintContext {
    file: file,
    source: source,
    diagnostics: Vec::new(),
    config: config,
    suppressed: Set::new()
  }
end

impl LintContext
  def emit(&mut self, lint_name: String, level: LintLevel, message: String, span: Span) -> Unit
    # Check #[allow] suppression
    let lint_key = lint_name.clone()
    if self.suppressed.contains(&lint_key) then return end
    if self.config.allowed.contains(&lint_key) then return end
    
    # Override level from config
    let effective_level = if self.config.denied.contains(&lint_key) then
      LintLevel::Error
    elsif self.config.warned.contains(&lint_key) then
      LintLevel::Warning
    else
      level
    end
    
    let (line, col) = offset_to_line_col(&self.source, span.start)
    
    self.diagnostics.push(LintDiagnostic {
      lint_name: lint_name,
      level: effective_level,
      message: message,
      file: self.file.clone(),
      line: line,
      column: col,
      span: Option::Some(span),
      suggestion: Option::None
    })
  end
  
  def emit_with_suggestion(&mut self, lint_name: String, level: LintLevel,
                           message: String, span: Span, suggestion: String) -> Unit
    let lint_key = lint_name.clone()
    if self.suppressed.contains(&lint_key) then return end
    if self.config.allowed.contains(&lint_key) then return end
    
    let effective_level = if self.config.denied.contains(&lint_key) then
      LintLevel::Error
    elsif self.config.warned.contains(&lint_key) then
      LintLevel::Warning
    else
      level
    end
    
    let (line, col) = offset_to_line_col(&self.source, span.start)
    
    self.diagnostics.push(LintDiagnostic {
      lint_name: lint_name,
      level: effective_level,
      message: message,
      file: self.file.clone(),
      line: line,
      column: col,
      span: Option::Some(span),
      suggestion: Option::Some(suggestion)
    })
  end
  
  def push_allow(&mut self, lint_name: String) -> Unit
    self.suppressed.insert(lint_name)
  end
  
  def pop_allow(&mut self, lint_name: String) -> Unit
    self.suppressed.remove(lint_name)
  end
end

def offset_to_line_col(source: &String, offset: UInt) -> (UInt, UInt)
  mut line: UInt = 1
  mut col: UInt = 1
  mut i: UInt = 0
  while i < offset && i < source.len() do
    if source.char_at(i) == '\n' then
      line = line + 1
      col = 1
    else
      col = col + 1
    end
    i = i + 1
  end
  (line, col)
end

# ———————————————————————————————————————————————————————————————
# Built-in Lint Passes
# ———————————————————————————————————————————————————————————————

# ---- unused_variables ----
struct UnusedVariablesLint end

impl LintPass for UnusedVariablesLint
  def name(&self) -> String
    "unused_variables".to_string()
  end

  def description(&self) -> String
    "Detects variables that are declared but never used".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end
  
  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    # Collect all declared variables
    mut declared = Map::new()  # name -> (span, is_used)
    
    match func.body
    when FnBody::FnBlock(block) then
      collect_declarations(&block, &mut declared)
      
      # Walk the body to mark used variables
      mark_used_in_block(&block, &mut declared)
      
      # Report unused
      for entry in declared do
        if !entry.value.1 && !entry.key.starts_with("_") then
          ctx.emit_with_suggestion(
            "unused_variables".to_string(),
            LintLevel::Warning,
            "unused variable `" + entry.key + "`",
            entry.value.0,
            "prefix with underscore: _" + entry.key
          )
        end
      end
    when _ then ()
    end
  end
end

def collect_declarations(block: &Block, declared: &mut Map[String, (Span, Bool)]) -> Unit
  for stmt in block.stmts do
    match stmt.kind
    when StmtKind::StmtLet(pattern, _, _, _) then
      collect_pattern_names(&pattern, declared, stmt.span)
    when _ then ()
    end
  end
end

def collect_pattern_names(pattern: &Pattern, declared: &mut Map[String, (Span, Bool)], span: Span) -> Unit
  match pattern.kind
  when PatternKind::Ident(name, _) then
    declared.insert(name.clone(), (span, false))
  when PatternKind::Tuple(pats) then
    for p in pats do
      collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Struct(_, fields) then
    for (_, p) in fields do
      collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Variant(_, pats) then
    for p in pats do
      collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Array(pats) then
    for p in pats do
      collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Or(pats) then
    for p in pats do
      collect_pattern_names(&p, declared, span)
    end
  when PatternKind::Ref(inner) then
    collect_pattern_names(&inner, declared, span)
  when PatternKind::RefMut(inner) then
    collect_pattern_names(&inner, declared, span)
  when _ then ()
  end
end

def mark_used_in_block(block: &Block, declared: &mut Map[String, (Span, Bool)]) -> Unit
  for stmt in block.stmts do
    mark_used_in_stmt(stmt, declared)
  end
end

def mark_used_in_stmt(stmt: &Stmt, declared: &mut Map[String, (Span, Bool)]) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then mark_used_in_expr(expr, declared)
  when StmtKind::StmtLet(_, _, init, _) then
    mark_used_in_expr(init, declared)
  when StmtKind::StmtFor(for_stmt) then
    mark_used_in_expr(for_stmt.iter, declared)
    mark_used_in_block(for_stmt.body, declared)
  when StmtKind::StmtWhile(cond, body) then
    mark_used_in_expr(cond, declared)
    mark_used_in_block(body, declared)
  when StmtKind::StmtLoop(body) then
    mark_used_in_block(body, declared)
  when StmtKind::StmtReturn(val) then
    match val
    when Option::Some(v) then mark_used_in_expr(v, declared)
    when Option::None then ()
    end
  when _ then ()
  end
end

def mark_used_in_expr(expr: &Expr, declared: &mut Map[String, (Span, Bool)]) -> Unit
  match expr.kind
  when ExprKind::ExprIdent(name) then
    match declared.get_mut(name)
    when Option::Some(entry) then entry.1 = true
    when Option::None then ()
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    mark_used_in_expr(left, declared)
    mark_used_in_expr(right, declared)
  when ExprKind::ExprUnaryOp(_, operand) then
    mark_used_in_expr(operand, declared)
  when ExprKind::ExprCall(callee, args) then
    mark_used_in_expr(callee, declared)
    for arg in args do mark_used_in_expr(arg, declared) end
  when ExprKind::ExprMethodCall(receiver, method_name, type_args, args) then
    mark_used_in_expr(receiver, declared)
    for arg in args do mark_used_in_expr(arg, declared) end
  when ExprKind::ExprFieldAccess(obj, _) then
    mark_used_in_expr(obj, declared)
  when ExprKind::ExprIndex(arr, idx) then
    mark_used_in_expr(arr, declared)
    mark_used_in_expr(idx, declared)
  when ExprKind::ExprIf(if_stmt) then
    mark_used_in_expr(&if_stmt.cond, declared)
    mark_used_in_block(&if_stmt.then_block, declared)
    for elsif_branch in if_stmt.elsif_branches do
      let (econd, ebody) = elsif_branch
      mark_used_in_expr(&econd, declared)
      mark_used_in_block(&ebody, declared)
    end
    match &if_stmt.else_block
    when Option::Some(e) then mark_used_in_block(e, declared)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    mark_used_in_expr(&m.scrutinee, declared)
    for arm in m.arms do
      mark_used_in_block(&arm.body, declared)
    end
  when ExprKind::ExprBlock(block) then
    for s in block.stmts do mark_used_in_stmt(s, declared) end
  when ExprKind::ExprClosure(params, _ret_ty, body) then
    mark_used_in_expr(body, declared)
  when ExprKind::ExprAssign(target, value) then
    mark_used_in_expr(target, declared)
    mark_used_in_expr(value, declared)
  when _ then ()
  end
end

# ---- unused_imports ----
struct UnusedImportsLint end

impl LintPass for UnusedImportsLint
  def name(&self) -> String
    "unused_imports".to_string()
  end

  def description(&self) -> String
    "Detects imported names that are not used in the file".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    match item.kind
    when ItemKind::ItemUse(u) then
      match u.names
      when Option::Some(names) then
        for imported_name in names do
          # Count occurrences of the imported name in source
          let count = count_name_occurrences(&ctx.source, &imported_name)
          if count <= 1 then
            # Import name appears only once (in the use statement itself) — unused
            ctx.emit(
              "unused_imports".to_string(),
              LintLevel::Warning,
              "unused import: `" + imported_name + "`",
              item.span
            )
          end
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end

  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    ()
  end
end

# ---- dead_code ----
struct DeadCodeLint end

impl LintPass for DeadCodeLint
  def name(&self) -> String
    "dead_code".to_string()
  end

  def description(&self) -> String
    "Detects functions and types that are never referenced".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    match item.kind
    when ItemKind::ItemFunction(func) then
      if func.vis != Visibility::Public && func.name != "main" then
        # Check if function name appears elsewhere in the source
        let count = count_occurrences(&ctx.source, func.name.clone())
        if count <= 1 then
          ctx.emit(
            "dead_code".to_string(),
            LintLevel::Warning,
            "function `" + func.name + "` is never used",
            item.span
          )
        end
      end
    when ItemKind::ItemStruct(s) then
      if s.vis != Visibility::Public then
        let count = count_occurrences(&ctx.source, s.name.clone())
        if count <= 1 then
          ctx.emit(
            "dead_code".to_string(),
            LintLevel::Warning,
            "struct `" + s.name + "` is never used",
            item.span
          )
        end
      end
    when _ then ()
    end
  end
  
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end

  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    ()
  end
end

# ---- needless_mut ----
struct NeedlessMutLint end

impl LintPass for NeedlessMutLint
  def name(&self) -> String
    "needless_mut".to_string()
  end

  def description(&self) -> String
    "Detects `mut` variables that are never mutated".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end
  
  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    # Find all `mut` bindings and check if they're ever assigned to
    match func.body
    when FnBody::FnBlock(block) then
      mut mut_vars = Map::new()  # name -> span
      
      for stmt in block.stmts do
        match stmt.kind
        when StmtKind::StmtLet(pattern, _, _, is_mut) then
          if is_mut then
            match pattern.kind
            when PatternKind::Ident(name) then
              mut_vars.insert(name.clone(), stmt.span)
            when _ then ()
            end
          end
        when _ then ()
        end
      end
      
      # Check if any mut var is actually assigned
      let assigned = find_assignments_in_block(&block)
      
      for entry in mut_vars do
        let var_name = entry.key.clone()
        if !assigned.contains(&var_name) then
          ctx.emit_with_suggestion(
            "needless_mut".to_string(),
            LintLevel::Warning,
            "variable `" + entry.key + "` is declared `mut` but never mutated",
            entry.value,
            "remove `mut`: let " + entry.key
          )
        end
      end
    when _ then ()
    end
  end
end

def find_assignments_in_block(block: &Block) -> Set[String]
  mut assigned = Set::new()
  for stmt in block.stmts do
    find_assignments_in_stmt(stmt, &mut assigned)
  end
  assigned
end

def find_assignments_in_stmt(stmt: &Stmt, assigned: &mut Set[String]) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then find_assignments_in_expr(expr, assigned)
  when StmtKind::StmtFor(for_stmt) then
    find_assignments_in_expr(for_stmt.iter, assigned)
    for s in for_stmt.body.stmts do find_assignments_in_stmt(s, assigned) end
  when StmtKind::StmtWhile(cond, body) then
    find_assignments_in_expr(cond, assigned)
    for s in body.stmts do find_assignments_in_stmt(s, assigned) end
  when StmtKind::StmtLoop(body) then
    for s in body.stmts do find_assignments_in_stmt(s, assigned) end
  when _ then ()
  end
end

def find_assignments_in_expr(expr: &Expr, assigned: &mut Set[String]) -> Unit
  match expr.kind
  when ExprKind::ExprAssign(target, value) then
    match target.kind
    when ExprKind::ExprIdent(name) then assigned.insert(name.clone())
    when _ then ()
    end
    find_assignments_in_expr(value, assigned)
  when ExprKind::ExprMethodCall(receiver, method, type_args, call_args) then
    # Methods on &mut self count as mutation
    match receiver.kind
    when ExprKind::ExprIdent(name) then assigned.insert(name.clone())
    when _ then ()
    end
  when ExprKind::ExprBinaryOp(_, left, right) then
    find_assignments_in_expr(left, assigned)
    find_assignments_in_expr(right, assigned)
  when ExprKind::ExprCall(callee, args) then
    find_assignments_in_expr(callee, assigned)
    for arg in args do find_assignments_in_expr(arg, assigned) end
  when ExprKind::ExprIf(if_stmt) then
    find_assignments_in_expr(&if_stmt.cond, assigned)
    for s in if_stmt.then_block.stmts do find_assignments_in_stmt(s, assigned) end
    match if_stmt.else_block
    when Option::Some(e) then
      for s in e.stmts do find_assignments_in_stmt(s, assigned) end
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    find_assignments_in_expr(&m.scrutinee, assigned)
    for arm in m.arms do
      for s in arm.body.stmts do find_assignments_in_stmt(s, assigned) end
    end
  when ExprKind::ExprBlock(block) then
    for s in block.stmts do find_assignments_in_stmt(s, assigned) end
  when ExprKind::ExprUnaryOp(_, inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprCast(inner, _) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprDeref(inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprFieldAccess(recv, _) then
    find_assignments_in_expr(recv, assigned)
  when ExprKind::ExprIndex(recv, idx) then
    find_assignments_in_expr(recv, assigned)
    find_assignments_in_expr(idx, assigned)
  when ExprKind::ExprRef(inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprRefMut(inner) then
    find_assignments_in_expr(inner, assigned)
  when ExprKind::ExprTupleLit(elems) then
    for e in elems do find_assignments_in_expr(e, assigned) end
  when ExprKind::ExprArrayLit(elems) then
    for e in elems do find_assignments_in_expr(e, assigned) end
  when _ then ()
  end
end

# ---- naming_conventions ----
struct NamingConventionsLint end

impl LintPass for NamingConventionsLint
  def name(&self) -> String
    "naming_conventions".to_string()
  end

  def description(&self) -> String
    "Enforces Tangerine naming conventions".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    match item.kind
    when ItemKind::ItemFunction(func) then
      if !is_snake_case(func.name.clone()) && !func.name.starts_with("_") then
        ctx.emit_with_suggestion(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "function `" + func.name + "` should be snake_case",
          item.span,
          "rename to: " + to_snake_case(func.name.clone())
        )
      end
    when ItemKind::ItemStruct(s) then
      if !is_pascal_case(s.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "struct `" + s.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemEnum(e) then
      if !is_pascal_case(e.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "enum `" + e.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemTrait(t) then
      if !is_pascal_case(t.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "trait `" + t.name + "` should be PascalCase",
          item.span
        )
      end
    when ItemKind::ItemConst(c) then
      if !is_screaming_snake_case(c.name.clone()) && !is_snake_case(c.name.clone()) then
        ctx.emit(
          "naming_conventions".to_string(),
          LintLevel::Warning,
          "constant `" + c.name + "` should be SCREAMING_SNAKE_CASE or snake_case",
          item.span
        )
      end
    when _ then ()
    end
  end
  
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end

  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    ()
  end
end

# ---- unsafe_usage ----
struct UnsafeUsageLint end

impl LintPass for UnsafeUsageLint
  def name(&self) -> String
    "unsafe_usage".to_string()
  end

  def description(&self) -> String
    "Flags all uses of unsafe blocks for audit".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Info
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end

  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    ()
  end
  
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    match expr.kind
    when ExprKind::ExprUnsafe(_, _) then
      ctx.emit(
        "unsafe_usage".to_string(),
        LintLevel::Info,
        "unsafe block usage — requires audit",
        expr.span
      )
    when _ then ()
    end
  end
end

# ---- large_function ----
struct LargeFunctionLint
  max_lines: UInt
end

impl LintPass for LargeFunctionLint
  def name(&self) -> String
    "large_function".to_string()
  end

  def description(&self) -> String
    "Warns about functions that are too long".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end
  
  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    # Use function span for size estimation since body_span not available
    let span_size = func.span.end_pos - func.span.start
    # Estimate lines from span size (rough: 40 chars per line average)
    let estimated_lines = span_size / 40
    
    if estimated_lines > self.max_lines then
      ctx.emit(
        "large_function".to_string(),
        LintLevel::Warning,
        "function `" + func.name + "` is too long (~" + estimated_lines.to_string() + " lines, max " + self.max_lines.to_string() + ")",
        func.span
      )
    end
  end
end

# ---- redundant_return ----
struct RedundantReturnLint end

impl LintPass for RedundantReturnLint
  def name(&self) -> String
    "redundant_return".to_string()
  end

  def description(&self) -> String
    "Detects `return` at the end of a function body".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end
  
  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end
  
  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    match func.body
    when FnBody::FnBlock(block) then
      if block.stmts.is_empty() then return end
      
      let last_stmt = block.stmts.last()
      match last_stmt
      when Option::Some(stmt) then
        match stmt.kind
        when StmtKind::StmtReturn(val) then
          match val
          when Option::Some(_) then
            ctx.emit_with_suggestion(
              "redundant_return".to_string(),
              LintLevel::Warning,
              "redundant `return` at end of function body",
              stmt.span,
              "remove `return` keyword — last expression is returned implicitly"
            )
          when Option::None then ()
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
end

# ---- empty_block ----
struct EmptyBlockLint end

impl LintPass for EmptyBlockLint
  def name(&self) -> String
    "empty_block".to_string()
  end

  def description(&self) -> String
    "Warns about empty blocks that may be accidentally empty".to_string()
  end

  def default_level(&self) -> LintLevel
    LintLevel::Warning
  end

  def check_item(&self, ctx: &mut LintContext, item: &Item) -> Unit
    ()
  end

  def check_stmt(&self, ctx: &mut LintContext, stmt: &Stmt) -> Unit
    ()
  end

  def check_function(&self, ctx: &mut LintContext, func: &FunctionDecl) -> Unit
    ()
  end
  
  def check_expr(&self, ctx: &mut LintContext, expr: &Expr) -> Unit
    match expr.kind
    when ExprKind::ExprIf(if_stmt) then
      if if_stmt.then_block.stmts.is_empty() then
        ctx.emit(
          "empty_block".to_string(),
          LintLevel::Warning,
          "empty `then` block",
          expr.span
        )
      end
    when ExprKind::ExprBlock(stmts) then
      if stmts.is_empty() then
        ctx.emit(
          "empty_block".to_string(),
          LintLevel::Warning,
          "empty block",
          expr.span
        )
      end
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Naming Convention Helpers
# ———————————————————————————————————————————————————————————————

def is_snake_case(name: String) -> Bool
  if name.is_empty() then return true end
  for c in name.chars() do
    if c.is_uppercase() then return false end
    if c != '_' && !c.is_alphanumeric() then return false end
  end
  true
end

def is_pascal_case(name: String) -> Bool
  if name.is_empty() then return false end
  let first = name.char_at(0)
  if !first.is_uppercase() then return false end
  # Should not contain underscores
  !name.contains("_")
end

def is_screaming_snake_case(name: String) -> Bool
  if name.is_empty() then return false end
  for c in name.chars() do
    if c.is_lowercase() then return false end
    if c != '_' && !c.is_alphanumeric() then return false end
  end
  true
end

def to_snake_case(name: String) -> String
  mut result = ""
  
  for i in 0..name.len() do
    let c = name.char_at(i)
    if c.is_uppercase() then
      if !result.is_empty() then
        # Insert underscore if prev was lowercase, or if this uppercase
        # is followed by lowercase (end of acronym like HTMLParser → html_parser)
        let prev = name.char_at(i - 1)
        if prev.is_lowercase() then
          result = result + "_"
        elsif i + 1 < name.len() && name.char_at(i + 1).is_lowercase() then
          result = result + "_"
        end
      end
      result = result + c.to_lowercase().to_string()
    else
      result = result + c.to_string()
    end
  end
  
  result
end

def count_occurrences(source: &String, name: String) -> UInt
  mut count: UInt = 0
  mut pos: UInt = 0
  
  while pos < source.len() do
    match source.index_of_from(name.clone(), pos)
    when Option::Some(idx) then
      # Check it's a word boundary (not part of a larger identifier)
      let before_ok = idx == 0 || !source.char_at(idx - 1).is_alphanumeric()
      let after_pos = idx + name.len()
      let after_ok = after_pos >= source.len() || !source.char_at(after_pos).is_alphanumeric()
      
      if before_ok && after_ok then
        count = count + 1
      end
      
      pos = idx + 1
    when Option::None then break
    end
  end
  
  count
end

# ———————————————————————————————————————————————————————————————
# Lint Runner
# ———————————————————————————————————————————————————————————————

struct LintRunner
  passes: Vec[Box[dyn LintPass]]
end

def lint_runner_new() -> LintRunner
  mut passes: Vec[Box[dyn LintPass]] = Vec::new()
  
  # Register all built-in lint passes
  passes.push(Box::new(UnusedVariablesLint {}))
  passes.push(Box::new(UnusedImportsLint {}))
  passes.push(Box::new(DeadCodeLint {}))
  passes.push(Box::new(NeedlessMutLint {}))
  passes.push(Box::new(NamingConventionsLint {}))
  passes.push(Box::new(UnsafeUsageLint {}))
  passes.push(Box::new(LargeFunctionLint { max_lines: 100 }))
  passes.push(Box::new(RedundantReturnLint {}))
  passes.push(Box::new(EmptyBlockLint {}))
  
  LintRunner { passes: passes }
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def lint_file(path: String, config: &LintConfig) -> Result[Vec[LintDiagnostic], String]
  match read_file(path.clone())
  when Result::Err(e) then Result::Err("Cannot read: " + e)
  when Result::Ok(source) then
    lint_source(path, source, config)
  end
end

def lint_source(file: String, source: String, config: &LintConfig) -> Result[Vec[LintDiagnostic], String]
  let tokens = tokenize(source.clone())
  let parse_out = parse(tokens)
  if diag_has_errors(&parse_out.diagnostics) then
    Result::Err("Parse error: " + parse_out.diagnostics[0].message)
  else
    mut ctx = lint_context_new(file, source, duplicate_lint_config(config))
    let runner = lint_runner_new()
    run_lint_runner(&runner, &parse_out.program, &mut ctx)
    Result::Ok(ctx.diagnostics)
  end
end

def list_lints() -> Vec[(String, String, LintLevel)]
  let runner = lint_runner_new()
  mut lints = Vec::new()
  for pass in runner.passes do
    lints.push((pass.name(), pass.description(), pass.default_level()))
  end
  lints
end

def run_lint_runner(runner: &LintRunner, ast: &Program, ctx: &mut LintContext) -> Unit
  for item in ast.items do
    # Check for #[allow] annotations
    for attr in item.attrs do
      if attr.name == "allow" then
        if !attr.args.is_empty() then
          let lint_name = attr.args[0].clone()
          ctx.push_allow(lint_name)
        end
      end
    end

    # Run item-level checks
    for pass in runner.passes do
      pass.check_item(ctx, item)
    end

    # Run function-level checks
    match item.kind
    when ItemKind::ItemFunction(func) then
      for pass in runner.passes do
        pass.check_function(ctx, func)
      end

      match func.body
      when FnBody::FnBlock(block) then
        walk_lint_block(runner, ctx, &block)
      when _ then ()
      end
    when ItemKind::ItemImpl(imp) then
      for method in imp.methods do
        for pass in runner.passes do
          pass.check_function(ctx, method)
        end
        match method.body
        when FnBody::FnBlock(block) then
          walk_lint_block(runner, ctx, &block)
        when _ then ()
        end
      end
    when _ then ()
    end

    # Pop #[allow] overrides
    for attr in item.attrs do
      if attr.name == "allow" then
        if !attr.args.is_empty() then
          let lint_name = attr.args[0].clone()
          ctx.pop_allow(lint_name)
        end
      end
    end
  end
end

def walk_lint_block(runner: &LintRunner, ctx: &mut LintContext, block: &Block) -> Unit
  for stmt in block.stmts do
    for pass in runner.passes do
      pass.check_stmt(ctx, stmt)
    end
    walk_lint_stmt_exprs(runner, ctx, stmt)
  end
end

def walk_lint_stmt_exprs(runner: &LintRunner, ctx: &mut LintContext, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then walk_lint_expr(runner, ctx, expr)
  when StmtKind::StmtLet(_, _, init, _) then
    walk_lint_expr(runner, ctx, init)
  when StmtKind::StmtFor(for_stmt) then
    walk_lint_expr(runner, ctx, for_stmt.iter)
    walk_lint_block(runner, ctx, for_stmt.body)
  when StmtKind::StmtWhile(cond, body) then
    walk_lint_expr(runner, ctx, cond)
    walk_lint_block(runner, ctx, body)
  when StmtKind::StmtLoop(body) then
    walk_lint_block(runner, ctx, body)
  when StmtKind::StmtReturn(val) then
    match val
    when Option::Some(v) then walk_lint_expr(runner, ctx, v)
    when Option::None then ()
    end
  when _ then ()
  end
end

def walk_lint_expr(runner: &LintRunner, ctx: &mut LintContext, expr: &Expr) -> Unit
  for pass in runner.passes do
    pass.check_expr(ctx, expr)
  end

  match expr.kind
  when ExprKind::ExprBinaryOp(_, left, right) then
    walk_lint_expr(runner, ctx, left)
    walk_lint_expr(runner, ctx, right)
  when ExprKind::ExprUnaryOp(_, operand) then
    walk_lint_expr(runner, ctx, operand)
  when ExprKind::ExprCall(callee, args) then
    walk_lint_expr(runner, ctx, callee)
    for arg in args do
      walk_lint_expr(runner, ctx, arg)
    end
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    walk_lint_expr(runner, ctx, receiver)
    for arg in args do
      walk_lint_expr(runner, ctx, arg)
    end
  when ExprKind::ExprFieldAccess(obj, _) then
    walk_lint_expr(runner, ctx, obj)
  when ExprKind::ExprIndex(arr, idx) then
    walk_lint_expr(runner, ctx, arr)
    walk_lint_expr(runner, ctx, idx)
  when ExprKind::ExprIf(if_stmt) then
    walk_lint_expr(runner, ctx, &if_stmt.cond)
    walk_lint_block(runner, ctx, &if_stmt.then_block)
    match if_stmt.else_block
    when Option::Some(e) then
      walk_lint_block(runner, ctx, &e)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(m) then
    walk_lint_expr(runner, ctx, &m.scrutinee)
    for arm in m.arms do
      walk_lint_block(runner, ctx, &arm.body)
    end
  when ExprKind::ExprClosure(_, _, body) then
    walk_lint_expr(runner, ctx, body)
  when ExprKind::ExprAssign(target, value) then
    walk_lint_expr(runner, ctx, target)
    walk_lint_expr(runner, ctx, value)
  when _ then ()
  end
end
