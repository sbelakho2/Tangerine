# Tangerine Compiler — Type System
# Self-hosting compiler written in Tangerine
#
# Complete type system with:
# - Type inference (Hindley-Milner style)
# - Generic types with bounds
# - Effect types

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{read_file}
use tg_compiler::token::{Span}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::resolver::{ResolvedNames, def_id_of_item, def_kind_of, module_qualified_key, lookup_module_callable}
use tg_compiler::ids::{
  DefId, DefKind, FieldId, ModuleId, TypeId, TraitId, GenericParamId, GenericParamTable,
  CallableId, InstanceId, VariantId, LocalId, AccessRoot,
  generic_param_table_new, generic_param_id_numeric, generic_param_id_eq,
  fresh_synthetic_owner, intern_generic_param, generic_param_name_of
}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, StructDecl, EnumDecl, TraitDecl, ImplDecl,
  UseDecl, AstPath, ExternItem, NominalKind, AccessConvention,
  TypeExpr, TypeExprKind, Param, GenericParam,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind
}

# ———————————————————————————————————————————————————————————————
# Type Representation
# ———————————————————————————————————————————————————————————————

enum Type
  # Primitive types
  Unit
  Bool
  Int
  UInt
  Float
  Char
  String
  Never
  
  # Sized integer types for FFI parity
  I8
  I16
  I32
  I64
    I128
  U8
  U16
  U32
  U64
    U128
    ISize
    USize
  F32
  F64
  
  # The nominal Adt form: the resolved TypeId of the type definition plus
  # its concrete type arguments (the FINAL Type representation — the dual
  # canonical variants are gone; the LangItems ids select the builtin
  # compound behaviors: option/result/vec/map/set/box_/rc/array/slice).
  # The named Array[T] syntax (the heap vector) is this Adt form; the
  # [T; N] annotation is the distinct FixedArray variant below.
  Adt(TypeId, Vec[Type])
  
  # Fixed inline array: the element type plus the constant count (the
  # reviewer's FixedArray[T, N]). The count is carried IN THE TYPE — the
  # [T; N] annotation constructs this variant (never the Adt); the count 0
  # is a legal zero-length fixed array, distinct from the heap-vector
  # Array[T] Adt.
  FixedArray(Type, Int)
  
  # Function type
  Function(Vec[ParamType], Type)
  
  # Internal reference (MIR-only: parameter re-wrap and MirRef typing)
  RefInternal(Type, Bool)
  
  # Raw pointer types (Box/Rc are Adt forms of the registered Box/Rc ids)
  Ptr(Type)     # Raw pointer *T
  PtrMut(Type)  # Mutable raw pointer *mut T
  
  # Trait object types
  Dyn(TypeId)   # Dynamic trait object dyn Trait
  
  # Effect types
  Effect(Vec[String], Type)  # Effect type: effect[Io, Net] T
  
  # Tuple
  Tuple(Vec[Type])
  
  # Type variables (for inference)
  Var(TypeVarId)
  
  # Generic parameter: the GenericParamId identity from the central ID
  # universe (ids.tg). The id's index IS the parameter's declaration order
  # within its owner (the interning table — the param-name table keyed by
  # GenericParamId — stores the NAME separately for diagnostics; identity
  # is the id, never the name). Substitution matches by id; equality is id
  # equality.
  Param(GenericParamId)
  
  # Error type (for error recovery)
  Error
end

struct ParamType
  ty: Type
  convention: AccessConvention
end

# Plain type name of a TypeExpr, mirroring mir.tg's impl_type_name
# computation (Array is aliased to Vec) so deinit mangling matches MIR.
def type_expr_name_of(ty: &TypeExpr) -> String
  let raw = match ty.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then ""
  end
  if raw == "Array" then "Vec".to_string() else raw end
end

# Render a DefId into a canonical String key for binding/finalize maps.
# The module path (recovered from the typed program's crate — never from
# the DefId, which carries a ModuleId into Program.crate) makes the key
# unique across ALL files merged into one compilation (two functions at
# the same byte offset in different files produce different keys — unlike
# span.start-based keys). The DefKind is metadata (the resolver's
# def_kinds snapshot — see def_kind_of / def_id_kind_of), not a DefId
# field.
pub def fn_owner_key(module: String, index: UInt, kind: DefKind) -> String
  let kind_name = match kind
  when DefKind::Function then "fn"
  when DefKind::Method then "method"
  when DefKind::Static then "static"
  when DefKind::Constant then "const"
  when DefKind::EnumVariant then "variant"
  when DefKind::StructField then "field"
  when DefKind::Intrinsic then "intrinsic"
  when DefKind::TypeName then "type"
  when DefKind::Trait then "trait"
  when DefKind::Other then "other"
  end
  module + "::" + index.to_string() + "::" + kind_name
end

# P0-AM (module graph consumption): the owner module path of a ModuleId,
# from the typed program's crate — a containment scan over
# Program.crate.modules (the resolver's module_path_of_item_resolver
# authority). The root module (id 0 — the crate's fallback when no Module
# covers an item) yields the empty path.
pub def crate_module_path_of(program: &Program, mid: &ModuleId) -> Vec[String]
  for entry in program.crate.modules.entries() do
    if entry.0.id == mid.id then
      var owner_path = Vec::new()
      for seg in entry.1.path do
        owner_path.push(seg.clone())
      end
      return owner_path
    end
  end
  Vec::new()
end

# The DefKind of a resolver-produced DefId, from the ResolvedNames def_kinds
# metadata snapshot (def_kind_of — the kind is METADATA, never a DefId
# field); DefKind::Other for a DefId the snapshot never recorded (mirrors
# lookup_module_callable's fallback).
def def_id_kind_of(res: &ResolvedNames, did: &DefId) -> DefKind
  match def_kind_of(res, did)
  when Option::Some(k) then k
  when Option::None then DefKind::Other
  end
end

# P0-AM: render a DefId as its fn_owner_key — "<module path>::<index>::
# <kind>" — with the module path from the crate containment scan
# (crate_module_path_of) and the kind from the resolver's def_kinds
# metadata (def_id_kind_of). DefId carries neither: module is a ModuleId
# into Program.crate and the kind is metadata.
pub def fn_owner_key_of_def(program: &Program, res: &ResolvedNames, did: &DefId) -> String
  let module_path = crate_module_path_of(program, &did.module)
  fn_owner_key(module_path.join("::"), did.index, def_id_kind_of(res, did))
end

# P0-C: the module-path-qualified name-based owner key — the SHARED no-DefId
# fallback ("module::<full path>::<name>"), used by fn_owner_key_of_item
# below and by check_item's free-function arm, so the type checker's
# parameter-binding key and the resource checker's finalize-plan key agree
# even when no DefId was recorded. Unique per module-qualified function
# because the path is the item's FULL owner module path (threaded from
# Program.crate for top-level items and appended level-by-level for
# genuinely nested modules); a DefId-derived key can never collide with it —
# DefId keys render "<module path>::<index>::<kind>", so the "module::"
# prefix is unreachable from fn_owner_key.
def module_qualified_fn_key(module_path: &Vec[String], name: String) -> String
  var mod_key = "module::"
  for seg in module_path do
    mod_key = mod_key + seg + "::"
  end
  mod_key + name
end

# P0-C: the ownership-layer owner key of an item's free function — the
# per-function finalize-plan key AND the parameter-binding key. DefId-derived
# when the resolver recorded one (def_id_of_item): the deterministic render
# of the DefId's owner ModuleId + index + kind via fn_owner_key_of_def
# (crate_module_path_of + def_kind_of) — unique per module-qualified
# function, because the DefId's module is the item's FULL owner module
# (record_item_def threads the owner ModuleId from Program.crate) and the
# index is the module's symbol counter, which record_item_def guarantees
# exists for EVERY top-level function. Name-based fallback for the no-DefId
# cases: the module-path-qualified key via module_qualified_fn_key — the
# same scheme the resource checker's genuinely-nested-module items use
# (item_idx -1, which MIR never lowers), so every consumer derives
# byte-identical keys for the same semantic callable.
def fn_owner_key_of_item(program: &Program, res: &ResolvedNames, item_idx: Int, module_path: &Vec[String], name: String) -> String
  match def_id_of_item(res, item_idx)
  when Option::Some(did) then
    fn_owner_key_of_def(program, res, &did)
  when Option::None then
    module_qualified_fn_key(module_path, name)
  end
end

# ———————————————————————————————————————————————————————————————
# Deinitialization plans
#
# The authoritative, recursive cleanup description for a type, computed at
# type-check time (typed.deinit_plans) and consumed by MIR lowering. A type
# without a registered deinit is Trivial (resources may be trivially
# deinitialized — absence of a deinit method is NOT an error). Containers
# recurse so Option[R], Array[R], Map[K,R], tuples etc. get real cleanup.
#
# CALLABLE IDENTITIES (P0-D): the finalizer payloads are SEMANTIC identities
# — InstanceId { def: CallableId, substs } — NEVER strings. The chosen
# finalizer is attached to its type by the checker's Drop-impl / deinit
# registration (typed.deinit_targets: TypeId -> CallableId — the resolver's
# DefId, the same identity the MIR records for the mangled "Type__drop" /
# "Type__deinit" emission names). The substs carry the CONCRETE type
# arguments (Box[Int]'s plan references the Box finalizer instantiated with
# [Int]); a nominal/template plan built with empty args carries the
# CallableId with empty substs. No finalizer is ever identified by its name
# (drop/deinit/"Type__drop") anywhere downstream of this registration: the
# registration is the identity source, the emission name is derived only at
# the symbol-mangling boundary (MIR's MirDeinit payload and codegen's label
# resolution key by the DefId/InstanceId).
# ———————————————————————————————————————————————————————————————
enum DeinitPlan
  Trivial
  # The finalizer's semantic identity (InstanceId — CallableId + the
  # concrete type-argument substitutions; empty substs = the nominal
  # template form). The MIR's drop glue emits the MirDeinit carrying this
  # instance; codegen resolves the finalizer's emission label from the
  # DefId. Constructed ONLY from the registered deinit_targets entry of the
  # type being planned (verified_* below — fail-closed).
  Call(InstanceId)
  # Explicit user finalizer PLUS compiler-owned structural field cleanup
  # (exactly-once rule: user finalizer runs first, then field cleanup). The
  # finalizer payload is the same semantic InstanceId as Call.
  UserFinalizer(InstanceId, DeinitPlan)
  Aggregate(Vec[DeinitPlan])
  # variant discriminant -> (variant name, per-field plans); names are needed
  # for ProjDowncast emission.
  Enum(Map[Int, (String, Vec[DeinitPlan])])
  Array(DeinitPlan)
  Set(DeinitPlan)                  # hash-set element plan (NOT array storage)
  # Box[T]: an OWNING pointer/allocation, not an inline aggregate. Lowering
  # dereferences the box, finalizes the pointee, and releases the allocation
  # (exactly once).
  Box(DeinitPlan)
  # Fail-closed marker: the cleanup plan could not be constructed finitely
  # (recursive resource type without drop glue). The emitter reports an
  # internal error instead of silently dropping cleanup.
  PlanLimit
  Map(DeinitPlan, DeinitPlan)      # key plan, value plan
  Tuple(Vec[DeinitPlan])
  Option(DeinitPlan)
  Result(DeinitPlan, DeinitPlan)
end

pub def deinit_plan_is_trivial(plan: &DeinitPlan) -> Bool
  match plan
  when DeinitPlan::Trivial then true
  when _ then false
  end
end

# ———————————————————————————————————————————————————————————————
# P0-D (final layer): DeinitPlan finalizer-callable construction-site
# verification (identity-based).
#
# INVARIANT: every DeinitPlan::Call / DeinitPlan::UserFinalizer payload is
# the SEMANTIC InstanceId of a VERIFIED registered finalizer — the value of
# typed.deinit_targets for the type being planned (the checker's Drop-impl /
# deinit-method registration — the resolver DefId, never a name). The
# construction sites below take the CallableId directly from that
# registration lookup; an identity that is NOT a registered finalizer
# records a TypeError and fails CLOSED with PlanLimit — an invalid finalizer
# cannot even be constructed. There is no name verification (drop/deinit/
# "Type__drop" spellings never identify a finalizer); the registration is
# the identity source.
# ———————————————————————————————————————————————————————————————

# True when `callable` is a registered deinit_targets value for some type id
# (identity comparison — the DefId, never a name).
def deinit_callable_is_registered(typed: &TypedProgram, callable: &CallableId) -> Bool
  for (_, dv) in typed.deinit_targets do
    if dv.def.module.id == callable.def.module.id && dv.def.index == callable.def.index then
      return true
    end
  end
  false
end

# Construct DeinitPlan::Call(instance) ONLY from a registered finalizer
# identity; an unregistered identity records a TypeError and fails CLOSED
# with PlanLimit instead of an unverifiable Call. The instance's substs are
# the concrete type arguments of the planned type (empty for the nominal
# template form).
def verified_deinit_call(typed: &TypedProgram, callable: &CallableId, args: &Vec[Type], errors: &mut Vec[TypeError]) -> DeinitPlan
  if deinit_callable_is_registered(typed, callable) then
    DeinitPlan::Call(InstanceId { def: callable.clone(), substs: args.clone() })
  else
    errors.push(TypeError {
      message: "invalid finalizer identity (not a registered Drop/deinit callable)",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    DeinitPlan::PlanLimit
  end
end

# Construct DeinitPlan::UserFinalizer(instance, fields_plan) ONLY from a
# registered finalizer identity (the same invariant as Call: the instance
# is the finalizer identity that later emits as a MirDeinit); an
# unregistered identity records a TypeError and fails CLOSED with PlanLimit.
def verified_deinit_finalizer(typed: &TypedProgram, callable: &CallableId, args: &Vec[Type], fields_plan: DeinitPlan, errors: &mut Vec[TypeError]) -> DeinitPlan
  if deinit_callable_is_registered(typed, callable) then
    DeinitPlan::UserFinalizer(InstanceId { def: callable.clone(), substs: args.clone() }, fields_plan)
  else
    errors.push(TypeError {
      message: "invalid finalizer identity (not a registered Drop/deinit callable)",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    DeinitPlan::PlanLimit
  end
end

# Canonical plans for the named container types (Option/Result/Array/Vec/
# Map/Set), keyed by type NAME. Slice is deliberately NOT here as an owning
# container: Slice[T] is the {ptr,len} view (owns=false, drop=none) and its
# plan is Trivial. Returns Trivial for anything else; the caller falls back
# to the structural walk.
def nominal_container_plan(typed: &TypedProgram, tid: &TypeId, type_name: &String, args: &Vec[Type], depth: Int, visited: &mut Set[Int], errors: &mut Vec[TypeError]) -> DeinitPlan
  if type_name == "Option" && args.len() >= 1 then
    DeinitPlan::Option(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif type_name == "Result" && args.len() >= 2 then
    DeinitPlan::Result(build_deinit_plan(typed, &args[0], depth + 1, visited, errors), build_deinit_plan(typed, &args[1], depth + 1, visited, errors))
  elsif type_name == "Slice" then
    # Slice[T] — the compiler-scoped VIEW { ptr: Ptr[T], len: UInt }:
    # owns=false, drop=none. A Slice local needs NO destruction regardless
    # of the element type (the element's ownership lives in the backing
    # container the view borrows). The view must not outlive its backing
    # buffer — the escape constraint is enforced by the safe access model
    # (the resource checker's IterationPlan projected-access enforcement is
    # the eventual mechanism).
    DeinitPlan::Trivial
  elsif (type_name == "Array" || type_name == "Vec") && args.len() >= 1 then
    DeinitPlan::Array(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif type_name == "Map" && args.len() >= 2 then
    DeinitPlan::Map(build_deinit_plan(typed, &args[0], depth + 1, visited, errors), build_deinit_plan(typed, &args[1], depth + 1, visited, errors))
  elsif type_name == "Set" && args.len() >= 1 then
    DeinitPlan::Set(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif type_name == "Box" && args.len() >= 1 then
    # The Adt Box form's plan mirrors the dropped canonical Type::Box arm —
    # the registered Drop-impl identity for the Box type is the finalizer
    # source (the checker's registration — never the "Box__drop" name).
    # Fail-closed: a Box without a registered Drop identity cannot be
    # destroyed — PlanLimit + TypeError.
    match typed.deinit_targets.get(tid.id)
    when Option::Some(box_callable) then verified_deinit_call(typed, &box_callable, args, errors)
    when Option::None then
      errors.push(TypeError {
        message: "Box type `" + type_name + "` has no registered Drop impl (cannot construct a deinit plan)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      DeinitPlan::PlanLimit
    end
  elsif type_name == "Rc" && args.len() >= 1 then
    # The Adt Rc form's plan mirrors the dropped canonical Type::Rc arm —
    # the registered Drop-impl identity for the Rc type (never a name).
    match typed.deinit_targets.get(tid.id)
    when Option::Some(rc_callable) then verified_deinit_call(typed, &rc_callable, args, errors)
    when Option::None then
      errors.push(TypeError {
        message: "Rc type `" + type_name + "` has no registered Drop impl (cannot construct a deinit plan)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      DeinitPlan::PlanLimit
    end
  else
    DeinitPlan::Trivial
  end
end

# Build the deinit plan for a type from the typed program's type kinds and
# registered deinit targets. Mirrors the type checker's viral containment
# rules: containers of resource types get recursive plans; a direct resource
# type without a deinit method is Trivial (per the language rule).
pub def build_deinit_plan(typed: &TypedProgram, ty: &Type, depth: Int, visited: &mut Set[Int], errors: &mut Vec[TypeError]) -> DeinitPlan
  # Cycle-aware recursion: recursive type graphs (e.g. Box-like self
  # references) legitimately revisit a type id; the revisit edge is Trivial.
  # A depth beyond the safety bound is NOT silently Trivial — it is a
  # compiler-internal error (cleanup analysis that "got too deep" must never
  # become "nothing to clean").
  if depth > 128 then
    errors.push(TypeError {
      message: "internal error: deinit plan recursion exceeded depth 128 for type",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    return DeinitPlan::PlanLimit
  end
  match ty
  when Type::Tuple(fields) then
    var plans = Vec::new()
    for f in fields do
      plans.push(build_deinit_plan(typed, &f, depth + 1, visited, errors))
    end
    DeinitPlan::Tuple(plans)
  when Type::Adt(tid, args) then
    let type_name = match typed.type_names.get(tid.id)
    when Option::Some(n) then n.clone()
    when Option::None then ""
    end
    match typed.type_kinds.get(tid.id)
    when Option::Some(k) then
      if k == TypeKind::Resource || k == TypeKind::Capability then
        match typed.deinit_targets.get(tid.id)
        when Option::Some(callable) then
          # Explicit finalizer: the USER finalizer runs first, then the
          # compiler-owned structural field cleanup (exactly-once rule).
          # A custom finalizer alone would leak resource fields; composing
          # both guarantees each field is cleaned exactly once.
          # P0-D (final layer): the callable comes from the registered
          # deinit_targets lookup (the checker's Drop-impl / deinit-method
          # registration — the resolver DefId, never a name), but the gate
          # is explicit: an unregistered identity records a TypeError and
          # fails CLOSED with PlanLimit instead of an unverifiable Call.
          if visited.contains(&tid.id) then
            verified_deinit_call(typed, &callable, &args, errors)
          else
            visited.insert(tid.id)
            let fields_plan = nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
            visited.remove(&tid.id)
            if deinit_plan_is_trivial(&fields_plan) then
              verified_deinit_call(typed, &callable, &args, errors)
            else
              verified_deinit_finalizer(typed, &callable, &args, fields_plan, errors)
            end
          end
        when Option::None then
          # No explicit deinit: VIRAL containment applies. A resource whose
          # fields/variants contain resources still needs recursive cleanup —
          # build an Aggregate/Enum plan over the nominal shape (a bare
          # Trivial would silently leak field resources).
          if visited.contains(&tid.id) then
            # Recursive ownership (e.g. Node { next: Option[Box[Node]] })
            # needs generated drop glue, not finite plan-tree expansion.
            # PlanLimit is the fail-closed stand-in: refusing to compile is
            # safer than silently dropping the recursive edge. Report a
            # NORMAL source diagnostic so the user sees the restriction
            # instead of an internal error.
            errors.push(TypeError {
              message: "recursive owning type `" + type_name + "` requires generated drop glue (not yet supported): break the ownership cycle or add an explicit finalizer",
              span: Span { file: "", start: 0, end_pos: 0 },
              code: Option::None
            })
            DeinitPlan::PlanLimit
          else
            visited.insert(tid.id)
            let result = nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
            visited.remove(&tid.id)
            result
          end
        end
      else
        # Builtin container types (Option/Result/Array/Map/Set) resolve to
        # their container plans via the LangItems name + generic args (the
        # Adt form's TypeId + args; the canonical variants are gone).
        let container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
        if deinit_plan_is_trivial(&container_plan) then
          # Ordinary nominal Value types: cleanup is structural. A struct
          # Wrapper[T] { item: T } instantiated with a resource must clean
          # its fields — the semantic layer and MIR must agree, so the
          # semantic plan walks the nominal shape rather than returning
          # Trivial for anything that is not a recognized container.
          # A Value-kind type with a registered deinit (an `impl Drop for
          # T`) runs its drop: the plan references the callable so the
          # allocation/state release actually executes (a plain structural
          # walk of e.g. Box[T] { ptr } would see only a non-owning Ptr and
          # leak the pointee). Ordering matches the MIR: the registered
          # drop wins over the container/structural shape.
          let deinit_shape = match typed.deinit_targets.get(tid.id)
          when Option::Some(callable2) then
            # P0-D (final layer): construction-site verification — same
            # invariant as the resource-with-finalizer path: every payload
            # is the SEMANTIC InstanceId of a verified registered finalizer
            # (the registration is the identity source — never a name); an
            # unregistered identity fails CLOSED with PlanLimit + TypeError.
            if visited.contains(&tid.id) then
              verified_deinit_call(typed, &callable2, &args, errors)
            else
              visited.insert(tid.id)
              let inner_container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
              let struct_shape = if deinit_plan_is_trivial(&inner_container_plan) then
                nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
              else
                inner_container_plan
              end
              visited.remove(&tid.id)
              if deinit_plan_is_trivial(&struct_shape) then
                verified_deinit_call(typed, &callable2, &args, errors)
              else
                verified_deinit_finalizer(typed, &callable2, &args, struct_shape, errors)
              end
            end
          when Option::None then
            if visited.contains(&tid.id) then
              errors.push(TypeError {
                message: "recursive owning type `" + type_name + "` requires generated drop glue (not yet supported): break the ownership cycle or add an explicit finalizer",
                span: Span { file: "", start: 0, end_pos: 0 },
                code: Option::None
              })
              DeinitPlan::PlanLimit
            else
              visited.insert(tid.id)
              let inner_container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
              let result = if deinit_plan_is_trivial(&inner_container_plan) then
                nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
              else
                inner_container_plan
              end
              visited.remove(&tid.id)
              result
            end
          end
          deinit_shape
        end
      end
    when Option::None then DeinitPlan::Trivial
    end
  when Type::FixedArray(elem, _) then
    # The fixed array stores its elements INLINE: the drop glue walks the n
    # elements (no heap backing to release).
    DeinitPlan::Array(build_deinit_plan(typed, &elem, depth + 1, visited, errors))
  when _ then DeinitPlan::Trivial
  end
end

# Build the containment plan for a nominal resource/capability WITHOUT an
# explicit deinit: struct fields become Aggregate plans, enum variants become
# Enum plans. Fields with Param types are substituted with the concrete args.
def nominal_containment_plan(typed: &TypedProgram, tid: &TypeId, args: &Vec[Type], depth: Int, visited: &mut Set[Int], errors: &mut Vec[TypeError]) -> DeinitPlan
  # FIX 2 (P1): fetch the type's generic-parameter names ONCE per call —
  # the per-field/per-variant refetch was a repeated lookup of the same
  # TypeDef shape in the hottest deinit-plan construction loops.
  let def_params = match typed.type_params.get(tid.id)
  when Option::Some(ps) then ps.clone()
  when Option::None then Vec::new()
  end
  match typed.type_fields.get(tid.id)
  when Option::Some(fields) then
    var plans = Vec::new()
    var fi = 0
    while fi < fields.len() do
      let fld = fields[fi]
      # Substitute generic params with the concrete args (Param("T") -> args[i]
      # positionally).
      let fld_ty = subst_type_args(&fld.1, &def_params, args)
      plans.push(build_deinit_plan(typed, &fld_ty, depth + 1, visited, errors))
      fi = fi + 1
    end
    DeinitPlan::Aggregate(plans)
  when Option::None then
    match typed.type_variants.get(tid.id)
    when Option::Some(variants) then
      var vmap = Map::new()
      for v in variants do
        var vplans = Vec::new()
        var vi = 0
        while vi < v.1.len() do
          let vty = subst_type_args(&v.1[vi], &def_params, args)
          vplans.push(build_deinit_plan(typed, &vty, depth + 1, visited, errors))
          vi = vi + 1
        end
        vmap.insert(v.2, (v.0.clone(), vplans))
      end
      DeinitPlan::Enum(vmap)
    when Option::None then DeinitPlan::Trivial
    end
  end
end

struct TypeVarId
  id: Int
end

# ———————————————————————————————————————————————————————————————
# Type Definitions
# ———————————————————————————————————————————————————————————————

enum TypeKind
  Value
  Resource
  Capability
end

struct TypeDef
  id: TypeId
  name: String
  def_kind: TypeDefKind
  # P0-GPI: the declaration's generic parameters as GenericParamIds in
  # declaration order (interned at registration — the id index IS the
  # declaration position). Substitution is positional and id-keyed; names
  # live in the param-name table (diagnostics only).
  generic_params: Vec[GenericParamId]
  kind: TypeKind
end

enum TypeDefKind
  Struct(Vec[FieldInfo])
  Enum(Vec[VariantInfo])
  Trait(Vec[MethodSig])
  Alias(Type)
  Primitive
  Opaque  # Built-in types with special semantics (Ptr, Box, Rc, etc.)
end

struct FieldInfo
  name: String
  ty: Type
  is_public: Bool
end

struct VariantInfo
  name: String
  fields: Vec[Type]
  discriminant: Int
end

struct MethodSig
  name: String
  params: Vec[ParamType]
  ret_type: Type
  is_method: Bool
end

# ———————————————————————————————————————————————————————————————
# Type-Property engine support (P0-I)
# ———————————————————————————————————————————————————————————————
#
# The graph-algorithm visit states and the memoized property bundle for the
# type-property engine (type_properties_of, defined with the solver below).
# The declarations live here (before TypeEnv) because TypeEnv carries the
# engine's memoization cache.

# DFS visit states for the type-property graph walk. A key that is Visiting
# when the walk reaches it again is a recursion through INLINE storage —
# an infinitely sized recursive type, diagnosed by the engine instead of the
# layout engine's panic. Indirections (Ptr/Box/Rc) terminate the walk, so
# legal recursive types (e.g. Node { next: Option[Box[Node]] }) never cycle.
enum TypePropVisitState
  Unvisited
  Visiting
  Resolved
end

# The per-type property bundle computed by type_properties_of:
#   needs_drop          — a value of this type requires cleanup at scope end
#   is_linear           — move-only: must be consumed, never duplicated
#   is_capability       — TypeKind::Capability (scoped, linear)
#   is_trivially_copyable — raw bit-copy is valid, no retain/clone (P0-H)
#   is_deferred         — the type graph contains an unsubstituted generic
#                         parameter (Type::Param) or an unresolved inference
#                         variable (Type::Var): the four semantic fields are
#                         NOT authoritative — "unknown/deferred", never a
#                         concrete semantic answer. A generic local may
#                         require CONDITIONAL drop after substitution, so a
#                         consumer must check is_deferred FIRST: while
#                         deferred, a false needs_drop/is_linear/
#                         is_capability/is_trivially_copyable means "not
#                         proven true", NOT "definitely false". The concrete
#                         answers appear only after substitution (the
#                         MIR/mono consumer wave substitutes the Param and
#                         re-queries the engine on the concrete
#                         instantiation). Container layers that decide a
#                         property unconditionally (Vec[T]/Map[..]/Box[T]
#                         needs_drop, Slice[T] bit-copyability, ...) keep
#                         those fields concrete — the flag marks the
#                         properties that depend on the unsubstituted
#                         parameter (e.g. Vec[T].is_linear = T.is_linear).
struct TypeProperties
  needs_drop: Bool
  is_linear: Bool
  is_capability: Bool
  is_trivially_copyable: Bool
  is_deferred: Bool
end

# ———————————————————————————————————————————————————————————————
# LangItems (reviewer item 15): the well-known intrinsic type/trait ids
# ———————————————————————————————————————————————————————————————
#
# The compiler-recognized intrinsic names and their semantic ids, so
# consumers stop string-selecting builtins (the trait lookups, the Rc
# policy, resource_check's is_non_shareable_type — the next batch's
# migration target). The type fields carry TypeId values; the trait fields
# carry TraitId values (the new TraitId domain — for the transition both
# are Int). Populated ONCE at env initialization, after the builtin
# registrations (build_lang_items — the ids from the type_name_index /
# trait_registry lookups). -1 marks a name with NO registration at init:
# Transferable/Shareable are std-declared traits whose TraitIds arrive
# when the std's trait declarations register (pass 1/2 — the
# module-qualified declaration identity). ALL NINE type names are
# registered builtins (the Adt form's special-behavior selector).
struct LangItems
  option: Int
  result: Int
  vec: Int
  map: Int
  set: Int
  box_: Int
  rc: Int
  array: Int
  slice: Int
  drop_trait: Int
  clone_trait: Int
  copy_trait: Int
  eq_trait: Int
  hash_trait: Int
  transferable_trait: Int
  shareable_trait: Int
end

# ———————————————————————————————————————————————————————————————
# Type Environment
# ———————————————————————————————————————————————————————————————

struct TypeEnv
  type_list: Vec[TypeDef]              # Single source of truth, insertion order
  type_name_index: Map[String, Int]    # name -> index into type_list
  # P0-A (next layer — module-qualified type identity): "path::name" ->
  # type_list index for every type registered from a module path (the
  # resolver's module_symbols DefKind::TypeName entries; see
  # record_module_type_name). Bare first-wins resolution stays in
  # type_name_index; this map is the qualified complement that lets
  # path-qualified references (a::Config) and local-module shadowing
  # resolve to the right TypeId when the same bare name exists in
  # multiple modules. Purely additive for the bootstrap (no cross-module
  # same-name collisions — qualified keys map to the same indices).
  module_type_names: Map[String, Int]
  # P0-A (final layer — module-qualified CALLABLE identity): "path::name" ->
  # the Type the checker bound for that qualified function/const/static
  # definition, mirrored at pass-3 registration guarded by the resolver's
  # module_symbols DefKind entry (see record_module_callable), plus the
  # bare-name FIRST registration's Type as the recoverable first-wins
  # fallback for ambiguous bare callable references (mirrors the resolver's
  # bare-name first-wins tables). Purely additive for the bootstrap: the
  # kernel's module_symbols holds at most one qualified entry per bare
  # callable name, so the >= 2 DISTINCT definition ambiguity check never
  # fires (see resolve_bare_callable).
  module_callable_types: Map[String, Type]
  callable_first_wins: Map[String, Type]
  type_id_index: Map[Int, Int]         # TypeId.id -> index into type_list
  type_id_counter: Int
  
  # Type variable substitution
  subst: Map[TypeVarId, Type]
  var_counter: Int
  
  # Scoped bindings
  scopes: Vec[Map[String, Type]]
  
  check_ctx: String
  # P0-A (next layer): the module path of the item currently being
  # processed (owner Module path from Program.crate, threaded per
  # item in type_check_program_env — see module_path_of_item). Consumed by
  # resolve_bare_type_name for local-module shadowing and ambiguity
  # verification; empty for the root module and for permissive recovery
  # (type_check / type_check_strict run without resolutions, in which case
  # module_type_names stays empty and behavior is unchanged).
  current_module_path: Vec[String]
  # P1 (recovery separation): strict vs permissive resolution. Compilation —
  # any entry that produces a TypedProgram for MIR/codegen — ALWAYS forces
  # this true (type_check_typed sets it unconditionally, as do the
  # compiler_core.tg invocation sites). The permissive mode exists only for
  # editor recovery through type_check / type_check_strict, which return
  # errors alone and never produce a codegenable TypedProgram. If a real
  # compilation ever runs with strict_resolution = false, that is an
  # internal error: the compilation path forces it on, so the permissive
  # behavior is unreachable from compilation.
  strict_resolution: Bool
  # P0-M: the declared return type of the function/method whose body is being
  # checked. `return` statements unify against it unconditionally (set in
  # check_function/check_impl around the body check, cleared afterwards).
  expected_return: Option[Type]
  
  # P0-Q: per pattern node id — the BindingPlans collected while checking the
  # pattern (each plan describes one bound identifier's action on its source
  # place). Consumed by the block/match/for checking paths.
  binding_plans: Map[Int, Vec[BindingPlan]]
  # P0-Q: per pattern node id — the resolved variant identity (owner TypeId
  # id, variant index) for enum-variant patterns, threaded from the pattern
  # checker so downstream consumers resolve variants by identity, not name.
  pattern_variant_resolutions: Map[Int, (Int, Int)]
  
  # Trait implementations
  impls: Vec[ImplInfo]
  method_lookup: Map[Int, Map[String, Vec[Int]]]  # receiver TypeId -> method name -> impl indices

  # P0-TM (module-semantic trait identity): the bare-name trait registry —
  # trait name -> TraitId — NO LONGER the semantic authority. The TraitId
  # of a trait is its DECLARATION identity: the resolver registers every
  # trait declaration with DefKind::Trait under its module-qualified
  # "path::name" key (module_symbols), the checker mirrors those entries
  # into the module-qualified map (module_type_names — traits participate
  # in record_module_type_name), and the TraitId is the trait TypeDef's id
  # (the declaration identity — the TraitId reuses the trait declaration's
  # TypeId value for the transition). trait_id_for resolves a name through
  # the module-qualified map FIRST (the current module's own declaration
  # shadows; >= 2 DISTINCT foreign declarations are ambiguous), with this
  # bare first-wins registry as the compatibility FALLBACK (builtin traits
  # register here at env initialization — they have no resolver
  # declaration — and the first source declaration of each name keeps the
  # entry; a std re-declaration of a builtin trait re-registers the
  # builtin id). Display/diagnostics only beyond that.
  trait_registry: Map[String, Int]
  # P0-BT (reviewer item 15): the well-known intrinsic type/trait ids —
  # built once at env initialization after the builtin registrations
  # (build_lang_items; -1 marks a name unregistered at init).
  lang_items: LangItems

  # P0-AL: indices into env.impls whose for_type is a Type::Param — the
  # EXTENSION impls (`impl[T, I: Iterator[T]] I`). They have no receiver
  # TypeId, so method_lookup cannot index them; method resolution searches
  # them by method name after the direct lookup misses, unifying the impl's
  # head parameter with the concrete receiver.
  param_for_type_impls: Vec[Int]
  # P0-AP: per generic-parameter trait bounds — param numeric GenericParamId
  # -> the bound trait's id and resolved type arguments. Registered when a
  # generic function's/impl's parameters enter scope (inline
  # generic-parameter bounds plus the enclosing where-clause); consulted by
  # resolve_method_type for bare Type::Param receivers inside generic bodies
  # (`self.inner.advance()` on inner: I with `I: Iterator[T]` resolves
  # through this bound). Keyed by the param's identity (numeric
  # GenericParamId) — two same-named parameters of different declarations
  # never collide. Entries persist for the whole check — they are only
  # consulted for Param receivers, which exist only inside the generic body
  # whose registration is current.
  param_bounds: Map[Int, Vec[ParamTraitBound]]
  # P0-AL: call expr node id -> (the callee's generic-parameter ids in the
  # MIR signature-walk order, the corresponding inference variables, the
  # call's span for diagnostics). A generic call whose substitution is
  # not fully solved AT the call site (e.g. a return-type-only parameter
  # solved only by the caller's annotation, which unifies AFTER the call is
  # checked) is parked here and re-resolved after the whole program is
  # checked, when the caller-context unifications have landed
  # (resolve_pending_call_instances in type_check_typed).
  # ZERO-INFERENCE: a call a context never solves is a hard error at the
  # end of checking ("cannot infer type parameter `T`: add an annotation")
  # — the monomorphizer performs no call-site inference (fail-closed).
  # P0-GPI: the id list carries GenericParamIds (the param-name table
  # renders the diagnostics).
  pending_call_instances: Map[Int, (Vec[GenericParamId], Vec[Type], Span)]
  
  # P0-BG: DOCUMENTATION MIRROR of the std's concurrency exclusions
  # ("Rc" for Transferable; "Rc"/"Cell"/"RefCell"/"UnsafeCell" for
  # Shareable). The classification (is_send / is_sync) consults the
  # OBLIGATION SOLVER (the std's `trait Transferable` / `trait Shareable`
  # impls) and falls back to a structural field walk — these sets are NO
  # LONGER READ in the decision path; they exist to document the std's
  # exclusions and to keep the registration site a single source of truth
  # for the names.
  non_send_types: Set[String]
  non_sync_types: Set[String]
  
  # Diagnostics
  errors: Vec[TypeError]
  warnings: Vec[TypeError]
  typed_expr_types: Map[Int, Type]
  local_id_counter: Int
  local_ids: Vec[Map[String, Int]]
  resolutions: Option[ResolvedNames]
  typed_call_targets: Map[Int, DefId]
  # P0-AK (final): call expr node id -> the type checker's SOLVED generic
  # substitution for a generic call (the callee's generic args in the
  # callee's parameter order). Populated at the generic-call sites ONLY
  # when the callee is generic and EVERY generic parameter is solved; an
  # unsolved parameter (e.g. a return-type-only parameter the caller
  # context never constrained) leaves the call unrecorded and is reported
  # by resolve_pending_call_instances. The solved substitutions from the
  # type checker are the AUTHORITY — ZERO-INFERENCE: the monomorphizer
  # performs no call-site inference (fail-closed). MIR pairs this with
  # typed_call_targets to fill the call instance's substs.
  typed_call_instances: Map[Int, Vec[Type]]
  typed_field_targets: Map[Int, FieldId]
  typed_local_bindings: Map[Int, LocalBinding]
  typed_ident_resolutions: Map[Int, Int]
  # Two SEPARATE binding-resolution maps: parameters and pattern bindings are
  # keyed in entirely different domains (owner DefId + positional index vs
  # pattern node id). Keeping them in one map allowed a parameter key to
  # numerically collide with a pattern node id, letting a later pattern
  # overwrite a parameter's mapping and corrupting resource/access analysis
  # of the wrong local. The parameter owner key is the function/method's
  # DefId rendered by fn_owner_key — NOT a span offset, which would collide
  # across files merged into one compilation.
  param_binding_resolutions: Map[String, Vec[Int]]
  pattern_binding_resolutions: Map[Int, Int]
  typed_access_effects: Map[Int, AccessEffect]
  # P0-TH (reviewer item 16, phase 2): per expression node id — the typed
  # HIR node recorded by the checker ALONGSIDE the flat maps above (the
  # maps remain the DERIVED INDEXES over the tree for the consumers that
  # have not migrated to the tree; the node and the maps are recorded in
  # lockstep and can never diverge). The node forms are RECURSIVE: every
  # kind carries its typed children (per-variant), so the MIR reads the
  # call target, the receiver/argument effects, the field identity and the
  # variant identity from the tree.
  typed_exprs: Map[Int, TypedExpr]
  # P0-TH (phase 2): per statement node id — the typed statement record
  # (TypedStmt), assembled at check_stmt's tail from the recorded children
  # (the tree's composite expression kinds carry their blocks' TypedStmt
  # children). The record is the checker-side statement tree; the MIR
  # consumes the expression tree and lowers statements from the AST (the
  # per-statement record is the tree's statement spine).
  typed_stmts: Map[Int, TypedStmt]
  # P0-TH (phase 2): per pattern node id — the typed pattern record
  # (TypedPattern), assembled at check_pattern's tail (the Closure /
  # Match / Let tree forms carry these records).
  typed_patterns: Map[Int, TypedPattern]
  typed_aggregate_ownership: Map[Int, Vec[Bool]]
  closure_captures: Map[Int, Map[Int, AccessEffect]]
  access_marker_depth: Int
  # P0-GPI: the generic-parameter interning table — the declaration-order
  # authority (the GenericParamId index IS the declaration position) and
  # the param-name table (diagnostics look up names by id). Every
  # declaration interns its generic parameters in declaration order at
  # registration (pass 2 for type declarations, pass 3 for functions and
  # extern functions, check_impl for impl-level and method-level
  # parameters); body-checking passes reconstruct the same ids from the
  # owner DefId + declaration index and never re-intern.
  generic_param_table: GenericParamTable
  # P0-GPI: fn owner key (the same key as param_binding_resolutions — the
  # function's DefId render or the positional fallback) -> the generic
  # parameter ids of that function/method in the MIR's merged declaration
  # order (impl-level params first, then method-level params — the order
  # the MIR builder pairs with the renamed declaration's merged generic
  # list). The MIR reconstruction of Type::Param ids reads this record.
  generic_param_ids: Map[String, Vec[GenericParamId]]
  # Type-property engine (P0-I) memoization: canonical structural type key
  # (see type_identity_key_resolved — includes concrete generic args, so
  # Wrapper[Int] and Wrapper[File] are distinct entries) -> computed
  # properties. Populated lazily by type_properties_of.
  type_prop_cache: Map[String, TypeProperties]
end

# P0-TM (module-semantic trait identity): the TraitId domain — the semantic
# identity of a trait DECLARATION (the nominal identity is the declaration,
# mirroring the TypeDefId = DefId model of the type side). TraitId itself
# lives in ids.tg (the central semantic-identity domains); for the
# transition the TraitId reuses the trait declaration's TypeId value (the
# trait's TypeDef in type_list carries the same id — the declaration
# identity). The TraitId of a source trait is anchored by the resolver's
# declaration table: the DefKind::Trait module_symbols entry for the
# (module path, name) pair the checker mirrors into module_type_names at
# trait-registration time (record_module_type_name's Trait guard), so a
# distinct declaration in a DIFFERENT module gets its own module-local
# TypeId — and therefore its own TraitId — exactly like structs/enums.
# TraitId(-1) is the sentinel for "no registered trait under this name" (a
# not-yet-registered or unknown trait: obligations carrying it can never
# match a registered impl).

# A normalized generic obligation: the impl generic parameter `subject` — a
# Type::Param whose GenericParamId is the binding where the obligation
# ORIGINATES (there is no positional param_index into a separately
# reconstructed vector) — must satisfy the trait identified by `trait_id`
# for the impl to apply to a concrete instantiation. `args` carries the
# bound trait's RESOLVED type arguments (Type::Param forms of the impl's
# generic scope, e.g. the T of `I: Iterator[T]` in `impl[T, U, I:
# Iterator[T]] ...`). Registered from the AST ImplDecl once; the solver
# instantiates the subject and the args with the candidate's substitution
# and solves the resulting concrete obligation — it never jumps back to
# the AST. `trait_name` is retained ONLY for diagnostics (the solver
# matches by id).
struct GenericObligation
  subject: Type         # Type::Param(GenericParamId) — the substituted subject
  trait_id: TraitId
  trait_name: String    # diagnostics only
  args: Vec[Type]       # the bound trait's resolved arguments
end

# P0-AP: one trait bound of a generic parameter (an inline generic-parameter
# bound or a where-clause predicate, e.g. the `Iterator[T]` of
# `impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]`): the bound
# trait's name and its RESOLVED type arguments (the T of `I: Iterator[T]`
# resolves to Type::Param("T") of the enclosing generic scope — the
# substitution target for trait-impl head unification on a bare Param
# receiver).
struct ParamTraitBound
  trait_id: TraitId
  trait_name: String   # diagnostics only
  args: Vec[Type]
end

# The full trait reference an obligation is stated against: the trait
# identity, the self type, and the trait-level type arguments (e.g. the T
# of `Iterator[T]`). The FULL TraitRef participates in the solver's
# cycle-detection key AND in candidate matching: a candidate impl must
# unify its own trait arguments against the obligation's `args` — two
# impls with the same self type but different trait arguments (`From[A]`
# vs `From[B]`, `Into[Out]`, `Iterator[Item = X]` vs
# `Iterator[Item = Y]`) are distinguished. `trait_name` on the enclosing
# Obligation is retained ONLY for diagnostics (the solver matches by id).
struct TraitRef
  trait_id: TraitId
  self_ty: Type
  args: Vec[Type]
end

# A concrete obligation to be solved: the substituted subject
# `trait_ref.self_ty` must implement the trait identified by
# `trait_ref.trait_id` with the trait-level arguments `trait_ref.args`.
struct Obligation
  trait_ref: TraitRef
  trait_name: String   # diagnostics only
end

struct ImplInfo
  trait_id: TraitId    # TraitId(-1) for inherent impls (no trait)
  trait_name: String   # diagnostics only ("" / "_" for inherent impls)
  for_type: Type
  obligations: Vec[GenericObligation]
  methods: Vec[MethodInfo]
  # P0-AL: the impl's FULL generic-parameter ids in declaration order —
  # including parameters that never appear in the for_type (e.g. the T of
  # `impl[T, I: Iterator[T]] I`, whose for_type mentions only I). The
  # extension-impl solver instantiates every one of them.
  # P0-GPI: GenericParamIds (declaration order == id index); names are in
  # the param-name table (diagnostics only).
  generic_params: Vec[GenericParamId]
  # P0-AL: method name -> the DefId the resolver registered for it under
  # the impl's for_type key (e.g. "I[...]::map" for the extension impl's
  # map). A call site cannot derive that key from the concrete receiver, so
  # method_def_for falls back to this table after the receiver-based lookup
  # misses.
  method_defs: Map[String, DefId]
end

struct MethodInfo
  name: String
  ret_type: Type
  params: Vec[ParamType]
  # P0-GPI: method-level generic parameter ids in declaration order (e.g.,
  # ["U"] for cast[U] — the ids, not the names; the param-name table holds
  # the display names).
  generic_params: Vec[GenericParamId]
end

struct TypeError
  message: String
  span: Span
  code: Option[String]
end

enum AccessEffect
  Read
  Modify
  Consume
  Initialize
end

# ———————————————————————————————————————————————————————————————
# Control-Flow Result (P0-M)
# ———————————————————————————————————————————————————————————————
#
# The flow summary of a checked block/statement: the type of the value it
# produces when it FALLS THROUGH normally (Never when it provably cannot
# fall through), plus which divergence edges are reachable. Threaded through
# statement/block checking so loops, value-if's and matches can distinguish
# "may terminate" from "diverges", and so unreachable tails stop
# contributing to a block's value/flow.
struct FlowResult
  normal: Type
  may_return: Bool
  may_break: Bool
  may_continue: Bool
  may_throw: Bool
end

# A construct that always falls through normally (no divergence edge).
def flow_normal(ty: Type) -> FlowResult
  FlowResult {
    normal: ty,
    may_return: false,
    may_break: false,
    may_continue: false,
    may_throw: false
  }
end

# A construct that never falls through normally (a terminator): the normal
# type is Never and the flags say which divergence edges are reachable.
def flow_terminator(may_return: Bool, may_break: Bool, may_continue: Bool, may_throw: Bool) -> FlowResult
  FlowResult {
    normal: Type::Never,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

struct LocalBinding
  name: String
  ty: Type
end

# ———————————————————————————————————————————————————————————————
# Pattern Binding Plans (P0-Q)
# ———————————————————————————————————————————————————————————————
#
# Pattern typing is an OWNERSHIP operation: every identifier a pattern binds
# reads or moves its value out of the source place. For every pattern
# binding the checker records a BindingPlan: the bound local id, the
# SEMANTIC source place, and the binding action (Read for a plain
# binding of a copyable value, Consume for a binding that MOVES an owning
# value out of its source). check_pattern collects the entries; the
# block/match/for checking paths consume them so the resource checker's
# existing projected-move rules (whole-aggregate consumption for match
# scrutinees, projected-place rejection for let-initializers) have the
# per-binding action data.
# P0-Q (defect fix): source_place is a proper TypedPlace — the semantic
# AccessRoot domain (ids.tg) + typed projections — NEVER a description
# string. The checker's call sites derive the place from the source
# expression's typed place (binding_source_place; the RawUnknown fallback
# keeps the description only as the diagnostics root_name). The resource
# checker's binding machinery (resource_check.tg — bind_pattern /
# bind_pattern_ident and the projected-move rules that will consume the
# per-binding actions) is the next-wave consumer of the semantic place.
struct BindingPlan
  local: Int             # semantic local id of the bound identifier
  source_place: TypedPlace  # the semantic source place of the binding
  action: AccessEffect   # Read (plain binding) or Consume (moving binding)
end

# ———————————————————————————————————————————————————————————————
# Typed HIR (reviewer item 16 — phase 2: the recursive forms)
# ———————————————————————————————————————————————————————————————
#
# The TypedProgram's typed HIR is now a RECURSIVELY TYPED syntax tree: one
# TypedExpr per source expression node, recorded by the type checker in
# LOCKSTEP with the flat maps (typed_expr_types / typed_call_targets /
# typed_field_targets / typed_access_effects), which remain the DERIVED
# INDEXES over the tree for the consumers that have not migrated to the
# tree (the MIR's flat fallbacks, the resource checker, the access
# checker). Every TypedExpr carries the expression's node id, its RESOLVED
# type, and a kind built from the recorded semantic metadata — never
# re-derived from the AST shape. The kinds carry their TYPED CHILDREN
# (per-variant):
#   - Call carries the TypedCall — the strong callee identity
#     (TypedCallee::Def(CallableId) or the closure-call marker), the
#     receiver effect, the typed receiver node (method calls), and the
#     typed argument nodes with their recorded effects;
#   - Field carries the TypedField — the strong FieldId and the typed base;
#   - Variant carries the TypedVariant — the strong VariantId and the typed
#     payload arguments;
#   - every operator / aggregate / composite kind carries its typed
#     operands; the composite statement kinds (If / Match / Block / Unsafe
#     / Async / Comptime) carry the TypedStmt children of their blocks;
#   - Closure carries the typed parameter patterns and the typed body.
# There is NO TypedExprKind::Unsupported: a source construct the checker
# accepts has a typed shape (the full enumeration below); a construct the
# compiler does not support is REJECTED at check time with a diagnostic
# (type_add_error) before MIR — never an Unsupported node.
#
# The strong identities are recorded directly (no numeric transitions):
# TypedCallee::Def(CallableId), TypedField.field (FieldId),
# TypedVariant.variant (VariantId), TypedExprKind::Local (the semantic
# LocalId — the typed_ident_resolutions value).
#
# The missing-metadata rule (reviewer item 13): every child reference the
# tree carries is a recorded TypedExpr (the checker records one per visited
# source node); a missing entry is an ICE-class TypeError — the construction
# never silently defaults.

# A call's callee identity: the resolved CallableId (ids.tg — the
# callable's DefId) or the closure-call marker — a closure VALUE invoked (a
# local or a parenthesized closure whose type is Type::Function) with no
# DefId target.
enum TypedCallee
  Def(CallableId)
  Closure
end

# The typed call node: the callee identity, the receiver's recorded access
# effect and typed receiver node (method calls; None for plain ExprCall),
# and the EXPLICIT arguments in source order with their recorded effects
# and typed values (the method receiver is NOT part of args).
struct TypedCall
  callee: TypedCallee
  receiver_effect: Option[AccessEffect]
  receiver: Option[TypedExpr]
  args: Vec[TypedCallArg]
end

# A call argument's typed form: the recorded access effect and the typed
# argument node (the TYPED CHILD — the MIR reads the effect from the tree).
struct TypedCallArg
  effect: AccessEffect
  value: TypedExpr
end

# A typed field access: the strong FieldId (ids.tg — the owner TypeId and
# the field index recorded in field_targets) and the typed receiver node.
struct TypedField
  field: FieldId
  base: TypedExpr
end

# A typed enum-variant construction: the strong VariantId (owner TypeId +
# variant index) and the typed payload arguments in source order.
struct TypedVariant
  variant: VariantId
  args: Vec[TypedExpr]
end

# The typed pattern record (assembled at check_pattern's tail from the
# recorded children; the tree's Closure / Match / Let forms carry these).
# The bound identifier's semantic local id (pattern_binding_resolutions)
# and the resolved variant identity (pattern_variant_resolutions) are
# recorded in the record.
struct TypedPattern
  id: Int            # NodeId — the pattern's AST node id
  kind: TypedPatternKind
end

enum TypedPatternKind
  Wildcard
  Ident { name: String, is_mut: Bool, local: Int }
  Literal(Box[TypedExpr])
  Tuple(Vec[TypedPattern])
  Array(Vec[TypedPattern])
  Struct { path: String, fields: Vec[(String, TypedPattern)] }
  Variant { variant: VariantId, args: Vec[TypedPattern] }
  Or(Vec[TypedPattern])
  Range { start: Option[Box[TypedExpr]], end_: Option[Box[TypedExpr]], inclusive: Bool }
end

# The typed statement record (assembled at check_stmt's tail from the
# recorded children; the tree's composite expression kinds carry the
# TypedStmt children of their blocks). The For record carries the for-stmt
# node id (iteration) — the join key of the resource checker's
# TypedIteration (resource_check.tg): the iteration plan is computed by
# check_for AFTER type checking, so the typed statement tree carries the
# plan identity and the MIR joins it with the resource-check channel
# (mir.tg lower_program / typed_iteration_of).
struct TypedStmt
  id: Int            # NodeId — the statement's AST node id
  kind: TypedStmtKind
end

enum TypedStmtKind
  Let { pattern: TypedPattern, value: TypedExpr, is_mut: Bool }
  Assign { target: TypedExpr, value: TypedExpr }
  CompoundAssign { op: BinOp, target: TypedExpr, value: TypedExpr }
  If { cond: TypedExpr, then_block: Vec[TypedStmt], elsif_branches: Vec[(TypedExpr, Vec[TypedStmt])], else_block: Option[Vec[TypedStmt]] }
  Match { scrutinee: TypedExpr, arms: Vec[TypedMatchArm] }
  While { cond: TypedExpr, body: Vec[TypedStmt] }
  For { iteration: Int, pattern: TypedPattern, iter: TypedExpr, body: Vec[TypedStmt] }
  Loop(Vec[TypedStmt])
  Return(Option[TypedExpr])
  Break(Option[TypedExpr])
  Continue
  Expr(TypedExpr)
  Unsafe { reason: Option[String], body: Vec[TypedStmt] }
  Defer(Vec[TypedStmt])
  Guard { cond: TypedExpr, else_action: TypedGuardElse }
  Try { body: Vec[TypedStmt], catches: Vec[TypedCatchArm], finally: Option[Vec[TypedStmt]] }
  With { expr: TypedExpr, pattern: TypedPattern, body: Vec[TypedStmt] }
  HandleWith { expr: TypedExpr, handlers: Vec[TypedHandler] }
end

struct TypedMatchArm
  pattern: TypedPattern
  guard_expr: Option[TypedExpr]
  body: Vec[TypedStmt]
end

struct TypedCatchArm
  pattern: TypedPattern
  body: Vec[TypedStmt]
end

# The typed guard-else action (the mirror of ast.tg GuardElse with typed
# value expressions).
enum TypedGuardElse
  Return(Option[TypedExpr])
  Panic(String)
  Break(Option[TypedExpr])
  Continue
end

struct TypedHandler
  arms: Vec[TypedHandlerArm]
end

struct TypedHandlerArm
  params: Vec[TypedPattern]
  body: Vec[TypedStmt]
end

# The typed place record — a place path (the semantic AccessRoot (ids.tg:
# Local(LocalId)/SelfValue/Static(DefId)/RawUnknown — the SAME root domain
# the access checker's TypedPlace uses) + typed projections): the DERIVED
# INDEX form over the recursive tree (typed_place_of) — never rebuilt from
# the AST shape. The root NAME is retained for diagnostics only.
struct TypedPlace
  root: AccessRoot
  root_name: String
  projections: Vec[TypedPlaceProj]
end

enum TypedPlaceProj
  Field(FieldId, String)   # the strong field identity + the name (diagnostics)
  TupleIndex(Int)          # a tuple-index access (no FieldId exists)
  Index                    # an index projection
  Deref                    # a raw-pointer dereference
  Variant(VariantId)       # an enum downcast (match-arm projection)
end

# ———————————————————————————————————————————————————————————————
# The typed expression tree
# ———————————————————————————————————————————————————————————————

struct TypedExpr
  id: Int            # NodeId (ids.tg) — the expression's AST node id
  ty: Type           # the checker-resolved type of the expression
  kind: TypedExprKind
end

enum TypedExprKind
  # ——— leaves ———
  Local(Int)         # the semantic LocalId (the typed_ident_resolutions
                     # value): an ident that resolves to a local. No typed
                     # children.
  Global(String)     # a source ident that is NOT a local: a global
                     # callable, a static, or a bare variant name in value
                     # position (the checker types them as function values /
                     # enum values / constructors). The node's type (ty) is
                     # the resolved authority; the name is display/
                     # diagnostic only. No typed children.
  SelfRef            # ExprSelfRef — `self` in value position (its semantic
                     # place root is -1). No typed children.
  Literal(Int)       # the literal's source node id (the value is read back
                     # from the AST by node id). No typed children.
  Path(String)       # ExprPath: a qualified path VALUE — an enum variant
                     # value (Option::None) or a static/const reference.
                     # ty is the authority; the path renders diagnostics.
                     # No typed children.

  # ——— operators ———
  BinaryOp { op: BinOp, left: Box[TypedExpr], right: Box[TypedExpr] }
  UnaryOp { op: UnOp, operand: Box[TypedExpr] }
  Index { base: Box[TypedExpr], index: Box[TypedExpr] }
  Cast { value: Box[TypedExpr], target: Type }
  TypeCheck { value: Box[TypedExpr], target: Type }
  RawDeref(Box[TypedExpr])
  Access(Box[TypedExpr])
  Range { start: Option[Box[TypedExpr]], end_: Option[Box[TypedExpr]], inclusive: Bool }
  Await(Box[TypedExpr])
  Try(Box[TypedExpr])
  Pipe { lhs: Box[TypedExpr], rhs: Box[TypedExpr] }
  Assign { target: Box[TypedExpr], value: Box[TypedExpr] }

  # ——— aggregates ———
  ArrayLit(Vec[TypedExpr])
  TupleLit(Vec[TypedExpr])
  StructLit { path: String, fields: Vec[(String, TypedExpr)] }
  MapLit(Vec[(TypedExpr, TypedExpr)])

  # ——— calls / members / constructions ———
  Call(TypedCall)
  Field(TypedField)
  TupleIndex { base: Box[TypedExpr], name: String, index: Int }   # the
                     # non-FieldId access forms: tuple indices (.0, .1 —
                     # index = the parsed index) and the String/Slice/Array
                     # len/cap field reads (index = -1: no projection
                     # identity exists; the std uses the .len() methods).
                     # The typed base is the child.
  Variant(TypedVariant)
  StaticPathCall { path: String, args: Vec[TypedExpr] }   # the
                     # ExprEnumVariant-shaped STATIC-PATH call whose
                     # "variant" is not a registered enum variant
                     # (vec! / Vec::from([..]) desugarings): the MIR
                     # resolves the callee by the qualified path
                     # (resolve_static_path_callee_name) and lowers the
                     # call directly — the typed form carries the same
                     # information (the path + the typed args).
  MacroCall { name: String, args: Vec[TypedExpr] }

  # ——— composites ———
  Closure { params: Vec[TypedPattern], body: Box[TypedExpr] }
  If { cond: Box[TypedExpr], then_block: Vec[TypedStmt], elsif_branches: Vec[(TypedExpr, Vec[TypedStmt])], else_block: Option[Vec[TypedStmt]] }
  Match { scrutinee: Box[TypedExpr], arms: Vec[TypedMatchArm] }
  Block(Vec[TypedStmt])
  Unsafe { reason: Option[String], body: Vec[TypedStmt] }
  Async(Vec[TypedStmt])
  Comptime(Vec[TypedStmt])
end

# ———————————————————————————————————————————————————————————————
# Typed-HIR construction helpers
# ———————————————————————————————————————————————————————————————
#
# The tree is assembled from the recorded per-node maps: the checker
# records one TypedExpr per visited source node (check_expr's tail) and
# one TypedStmt / TypedPattern per visited statement / pattern node, so a
# child reference is a map read. Children are recorded BEFORE their
# parents (the checker's recursion checks children first), so the parent's
# record can always look its children up.

# The typed node of a child expression. Option::None only for synthesized
# nodes (node_id 0) and the missing-metadata failure class (the caller
# records the ICE — the construction never silently defaults).
def typed_child_of(env: &TypeEnv, child: &Expr) -> Option[TypedExpr]
  if child.node_id == 0 then return Option::None end
  match env.typed_exprs.get(child.node_id)
  when Option::Some(te) then Option::Some(te)
  when Option::None then Option::None
  end
end

# The typed nodes of a child expression vector (source order).
def typed_children_of(env: &TypeEnv, elems: &Vec[Expr]) -> Option[Vec[TypedExpr]]
  var out = Vec::new()
  var i = 0
  while i < elems.len() do
    match typed_child_of(env, &elems[i])
    when Option::Some(te) then out.push(te)
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(out)
end

# The typed nodes of a two-child expression (in order).
def typed_children_2(env: &TypeEnv, a: &Expr, b: &Expr) -> Option[(TypedExpr, TypedExpr)]
  match typed_child_of(env, a)
  when Option::Some(ta) then
    match typed_child_of(env, b)
    when Option::Some(tb) then Option::Some((ta, tb))
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# The typed statement children of a block (each statement's record was
# assembled at its check_stmt tail — children are checked before their
# parents — so the lookup is a map read per statement; a statement without
# a record (synthesized node id 0) contributes nothing).
def typed_stmts_of(env: &TypeEnv, block: &Block) -> Vec[TypedStmt]
  var out = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    match env.typed_stmts.get(stmt.node_id)
    when Option::Some(ts) then out.push(ts)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

# The typed pattern record of a pattern node (assembled at check_pattern's
# tail; children are recorded before the parent).
def typed_pattern_of(env: &TypeEnv, pat: &Pattern) -> Option[TypedPattern]
  if pat.node_id == 0 then return Option::None end
  match env.typed_patterns.get(pat.node_id)
  when Option::Some(tp) then Option::Some(tp)
  when Option::None then Option::None
  end
end

# Assemble the typed pattern record of a pattern node from its shape and
# the recorded semantic metadata (the bound local id from
# pattern_binding_resolutions, the resolved variant identity from
# pattern_variant_resolutions, the recorded child patterns and literal
# expressions). Option::None when a required piece is missing — the
# checker records every binding and variant resolution, so this only fires
# for the missing-metadata failure class; the caller skips the record.
def typed_pattern_for(env: &TypeEnv, pat: &Pattern) -> Option[TypedPattern]
  var kind: Option[TypedPatternKind] = Option::None
  match pat.kind
  when PatternKind::Wildcard then
    kind = Option::Some(TypedPatternKind::Wildcard)
  when PatternKind::Ident(name, is_mut) then
    match env.pattern_binding_resolutions.get(pat.node_id)
    when Option::Some(lid) then kind = Option::Some(TypedPatternKind::Ident { name: name.clone(), is_mut: is_mut, local: lid })
    when Option::None then ()
    end
  when PatternKind::Literal(e) then
    match typed_child_of(env, &e)
    when Option::Some(lt) then kind = Option::Some(TypedPatternKind::Literal(Box::new(lt)))
    when Option::None then ()
    end
  when PatternKind::Tuple(pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Tuple(items))
    when Option::None then ()
    end
  when PatternKind::Array(pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Array(items))
    when Option::None then ()
    end
  when PatternKind::Struct(path, field_pats) then
    var fields_typed = Vec::new()
    var fi = 0
    var fields_ok = true
    while fi < field_pats.len() do
      match typed_pattern_of(env, &field_pats[fi].1)
      when Option::Some(tp) then
        fields_typed.push((field_pats[fi].0.clone(), tp))
        fi = fi + 1
      when Option::None then
        fields_ok = false
        fi = fi + 1
      end
    end
    if fields_ok then
      kind = Option::Some(TypedPatternKind::Struct { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, fields: fields_typed })
    end
  when PatternKind::Variant(_, pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then
      match env.pattern_variant_resolutions.get(pat.node_id)
      when Option::Some((tid, vidx)) then
        kind = Option::Some(TypedPatternKind::Variant { variant: VariantId { owner: TypeId { id: tid }, index: vidx as UInt }, args: items })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when PatternKind::Or(alts) then
    match typed_patterns_of(env, &alts)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Or(items))
    when Option::None then ()
    end
  when PatternKind::Range(lo, hi, inclusive) then
    let lo_typed = match lo
    when Option::Some(lo_expr) then
      match typed_child_of(env, &lo_expr)
      when Option::Some(lt) then Option::Some(Box::new(lt))
      when Option::None then return Option::None
      end
    when Option::None then Option::None
    end
    let hi_typed = match hi
    when Option::Some(hi_expr) then
      match typed_child_of(env, &hi_expr)
      when Option::Some(ht) then Option::Some(Box::new(ht))
      when Option::None then return Option::None
      end
    when Option::None then Option::None
    end
    kind = Option::Some(TypedPatternKind::Range { start: lo_typed, end_: hi_typed, inclusive: inclusive })
  end
  match kind
  when Option::Some(k) then Option::Some(TypedPattern { id: pat.node_id, kind: k })
  when Option::None then Option::None
  end
end

# The typed pattern records of a pattern vector (source order).
def typed_patterns_of(env: &TypeEnv, pats: &Vec[Pattern]) -> Option[Vec[TypedPattern]]
  var out = Vec::new()
  var i = 0
  while i < pats.len() do
    match typed_pattern_of(env, &pats[i])
    when Option::Some(tp) then out.push(tp)
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(out)
end

# The missing-metadata ICE: a required typed child is absent on a source
# node. The construction never silently defaults; the caller skips the
# node's record (the flat maps remain the fallback for the failure class,
# exactly like the typed-call assembly failure).
def missing_typed_hir_child(env: &mut TypeEnv, expr: &Expr) -> Option[TypedExprKind]
  add_error_with_code(env, "internal error: missing typed HIR child for node " + expr.node_id.to_string(), expr.span, "ICE")
  Option::None
end

# Assemble the TypedCall for a call node from the recorded semantic
# metadata — the call target (typed_call_targets DefId -> the strong
# CallableId), the receiver's access effect and typed node (method calls;
# None for plain calls), and the per-argument typed nodes with their
# recorded access effects. Returns Option::None when a required piece is
# missing (a call with no recorded target, or an argument without a
# recorded access effect or typed node) — the missing-metadata rule
# (reviewer item 13): the construction never silently defaults the callee
# or an argument effect; the caller records an ICE-class TypeError.
def typed_call_for(env: &TypeEnv, expr: &Expr, args: &Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  var callee = TypedCallee::Closure
  var has_target = false
  match env.typed_call_targets.get(expr.node_id)
  when Option::Some(did) then
    callee = TypedCallee::Def(CallableId { def: did })
    has_target = true
  when Option::None then ()
  end
  if !has_target then
    match receiver_node
    when Option::Some(_) then ()
    when Option::None then
      # A plain call with no recorded target is not a call shape at all —
      # the closure-call fallback in the recording site decides (the
      # TypedCall is assembled there, via typed_closure_call_for, only
      # when the callee is a Type::Function value).
      return Option::None
    end
  end
  var receiver_effect: Option[AccessEffect] = Option::None
  var receiver_te: Option[TypedExpr] = Option::None
  match receiver_node
  when Option::Some(rn) then
    match env.typed_access_effects.get(rn.node_id)
    when Option::Some(eff) then receiver_effect = Option::Some(eff)
    when Option::None then return Option::None
    end
    match typed_child_of(env, &rn)
    when Option::Some(rt) then receiver_te = Option::Some(rt)
    when Option::None then return Option::None
    end
  when Option::None then ()
  end
  var typed_args = Vec::new()
  var i = 0
  while i < args.len() do
    match env.typed_access_effects.get(args[i].node_id)
    when Option::Some(eff) then
      match typed_child_of(env, &args[i])
      when Option::Some(at) then
        typed_args.push(TypedCallArg { effect: eff, value: at })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(TypedCall { callee: callee, receiver_effect: receiver_effect, receiver: receiver_te, args: typed_args })
end

# The closure-call shape (the recording site's Type::Function-callee
# fallback): a closure VALUE invoked — the callee is a local or a
# parenthesized closure (Type::Function) with no DefId target. The TypedCall
# carries the closure-call marker (TypedCallee::Closure) and the args'
# recorded access effects and typed values (the closure call consumes the
# same per-arg effect records as a DefId call). Option::None when a
# required effect or typed child is missing — the missing-metadata rule
# (reviewer item 13): the construction never silently defaults an argument
# effect; the caller records an ICE-class TypeError.
def typed_closure_call_for(env: &TypeEnv, args: &Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  var receiver_effect: Option[AccessEffect] = Option::None
  var receiver_te: Option[TypedExpr] = Option::None
  match receiver_node
  when Option::Some(rn) then
    match env.typed_access_effects.get(rn.node_id)
    when Option::Some(eff) then receiver_effect = Option::Some(eff)
    when Option::None then return Option::None
    end
    match typed_child_of(env, &rn)
    when Option::Some(rt) then receiver_te = Option::Some(rt)
    when Option::None then return Option::None
    end
  when Option::None then ()
  end
  var typed_args = Vec::new()
  var i = 0
  while i < args.len() do
    match env.typed_access_effects.get(args[i].node_id)
    when Option::Some(eff) then
      match typed_child_of(env, &args[i])
      when Option::Some(at) then
        typed_args.push(TypedCallArg { effect: eff, value: at })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(TypedCall { callee: TypedCallee::Closure, receiver_effect: receiver_effect, receiver: receiver_te, args: typed_args })
end

# The closure-call shape gate: a callee (or method-call receiver) whose
# recorded type is Type::Function — a closure VALUE — takes the
# closure-call path instead of the missing-target ICE.
def closure_call_shape(env: &TypeEnv, callee: &Expr, args: &Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  match env.typed_expr_types.get(callee.node_id)
  when Option::Some(callee_ty) then
    match callee_ty
    when Type::Function(_, _) then typed_closure_call_for(env, args, receiver_node)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# The typed statement record of a statement (assembled at check_stmt's
# tail from the recorded children). Option::None when a required child is
# missing — the checker records every visited node, so this only fires for
# the missing-metadata failure class; the caller skips the record.
def typed_stmt_for(env: &TypeEnv, stmt: &Stmt) -> Option[TypedStmt]
  var kind: Option[TypedStmtKind] = Option::None
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, is_mut) then
    match typed_pattern_of(env, &pattern)
    when Option::Some(tp) then
      match typed_child_of(env, &value)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Let { pattern: tp, value: vt, is_mut: is_mut })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtAssign(target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then kind = Option::Some(TypedStmtKind::Assign { target: tt, value: vt })
    when Option::None then ()
    end
  when StmtKind::StmtCompoundAssign(op, target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then kind = Option::Some(TypedStmtKind::CompoundAssign { op: op, target: tt, value: vt })
    when Option::None then ()
    end
  when StmtKind::StmtIf(if_stmt) then
    match typed_child_of(env, &if_stmt.cond)
    when Option::Some(ct) then
      var elsif_typed = Vec::new()
      var ei = 0
      while ei < if_stmt.elsif_branches.len() do
        match typed_child_of(env, &if_stmt.elsif_branches[ei].0)
        when Option::Some(et) then
          elsif_typed.push((et, typed_stmts_of(env, &if_stmt.elsif_branches[ei].1)))
          ei = ei + 1
        when Option::None then ()
        end
      end
      let else_typed = match if_stmt.else_block
      when Option::Some(eb) then Option::Some(typed_stmts_of(env, &eb))
      when Option::None then Option::None
      end
      kind = Option::Some(TypedStmtKind::If { cond: ct, then_block: typed_stmts_of(env, &if_stmt.then_block), elsif_branches: elsif_typed, else_block: else_typed })
    when Option::None then ()
    end
  when StmtKind::StmtMatch(m) then
    match typed_child_of(env, &m.scrutinee)
    when Option::Some(st) then
      var arms_typed = Vec::new()
      var ai = 0
      while ai < m.arms.len() do
        let arm = m.arms[ai]
        let guard_typed = match arm.guard_expr
        when Option::Some(g) then typed_child_of(env, &g)
        when Option::None then Option::None
        end
        match typed_pattern_of(env, &arm.pattern)
        when Option::Some(apt) then
          arms_typed.push(TypedMatchArm { pattern: apt, guard_expr: guard_typed, body: typed_stmts_of(env, &arm.body) })
          ai = ai + 1
        when Option::None then ()
        end
      end
      kind = Option::Some(TypedStmtKind::Match { scrutinee: st, arms: arms_typed })
    when Option::None then ()
    end
  when StmtKind::StmtWhile(cond, body) then
    match typed_child_of(env, &cond)
    when Option::Some(ct) then kind = Option::Some(TypedStmtKind::While { cond: ct, body: typed_stmts_of(env, &body) })
    when Option::None then ()
    end
  when StmtKind::StmtFor(for_stmt) then
    match typed_pattern_of(env, &for_stmt.pattern)
    when Option::Some(tp) then
      match typed_child_of(env, &for_stmt.iter)
      when Option::Some(it) then kind = Option::Some(TypedStmtKind::For { iteration: stmt.node_id, pattern: tp, iter: it, body: typed_stmts_of(env, &for_stmt.body) })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtLoop(body) then
    kind = Option::Some(TypedStmtKind::Loop(typed_stmts_of(env, &body)))
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then
      match typed_child_of(env, &val)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Return(Option::Some(vt)))
      when Option::None then ()
      end
    when Option::None then kind = Option::Some(TypedStmtKind::Return(Option::None))
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then
      match typed_child_of(env, &val)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Break(Option::Some(vt)))
      when Option::None then ()
      end
    when Option::None then kind = Option::Some(TypedStmtKind::Break(Option::None))
    end
  when StmtKind::StmtContinue then
    kind = Option::Some(TypedStmtKind::Continue)
  when StmtKind::StmtExpr(e) then
    match typed_child_of(env, &e)
    when Option::Some(et) then kind = Option::Some(TypedStmtKind::Expr(et))
    when Option::None then ()
    end
  when StmtKind::StmtUnsafe(reason, body) then
    kind = Option::Some(TypedStmtKind::Unsafe { reason: reason, body: typed_stmts_of(env, &body) })
  when StmtKind::StmtDefer(body) then
    kind = Option::Some(TypedStmtKind::Defer(typed_stmts_of(env, &body)))
  when StmtKind::StmtGuard(cond, else_action) then
    match typed_child_of(env, &cond)
    when Option::Some(ct) then
      let else_typed = match else_action
      when GuardElse::Return(ret_opt) then
        match ret_opt
        when Option::Some(ret_e) then
          match typed_child_of(env, &ret_e)
          when Option::Some(rt) then TypedGuardElse::Return(Option::Some(rt))
          when Option::None then return Option::None
          end
        when Option::None then TypedGuardElse::Return(Option::None)
        end
      when GuardElse::Panic(msg) then TypedGuardElse::Panic(msg)
      when GuardElse::Break(br_opt) then
        match br_opt
        when Option::Some(br_e) then
          match typed_child_of(env, &br_e)
          when Option::Some(bt) then TypedGuardElse::Break(Option::Some(bt))
          when Option::None then return Option::None
          end
        when Option::None then TypedGuardElse::Break(Option::None)
        end
      when GuardElse::Continue then TypedGuardElse::Continue
      end
      kind = Option::Some(TypedStmtKind::Guard { cond: ct, else_action: else_typed })
    when Option::None then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    var catches_typed = Vec::new()
    var ci = 0
    var catches_ok = true
    while ci < catches.len() do
      match typed_pattern_of(env, &catches[ci].pattern)
      when Option::Some(cp) then
        catches_typed.push(TypedCatchArm { pattern: cp, body: typed_stmts_of(env, &catches[ci].body) })
        ci = ci + 1
      when Option::None then
        catches_ok = false
        ci = ci + 1
      end
    end
    if catches_ok then
      let finally_typed = match finally_block
      when Option::Some(fb) then Option::Some(typed_stmts_of(env, &fb))
      when Option::None then Option::None
      end
      kind = Option::Some(TypedStmtKind::Try { body: typed_stmts_of(env, &body), catches: catches_typed, finally: finally_typed })
    end
  when StmtKind::StmtWith(expr, pat, body) then
    match typed_child_of(env, &expr)
    when Option::Some(et) then
      match typed_pattern_of(env, &pat)
      when Option::Some(tp) then kind = Option::Some(TypedStmtKind::With { expr: et, pattern: tp, body: typed_stmts_of(env, &body) })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtHandleWith(expr, handlers) then
    match typed_child_of(env, &expr)
    when Option::Some(et) then
      var handlers_typed = Vec::new()
      var hi = 0
      var handlers_ok = true
      while hi < handlers.len() do
        var arms_typed = Vec::new()
        var hj = 0
        var arms_ok = true
        while hj < handlers[hi].arms.len() do
          var params_typed = Vec::new()
          var pk = 0
          var params_ok = true
          while pk < handlers[hi].arms[hj].params.len() do
            match typed_pattern_of(env, &handlers[hi].arms[hj].params[pk])
            when Option::Some(hp) then
              params_typed.push(hp)
              pk = pk + 1
            when Option::None then
              params_ok = false
              pk = pk + 1
            end
          end
          if params_ok then
            arms_typed.push(TypedHandlerArm { params: params_typed, body: typed_stmts_of(env, &handlers[hi].arms[hj].body) })
            hj = hj + 1
          else
            arms_ok = false
            hj = hj + 1
          end
        end
        if arms_ok then
          handlers_typed.push(TypedHandler { arms: arms_typed })
          hi = hi + 1
        else
          handlers_ok = false
          hi = hi + 1
        end
      end
      if handlers_ok then
        kind = Option::Some(TypedStmtKind::HandleWith { expr: et, handlers: handlers_typed })
      end
    when Option::None then ()
    end
  end
  match kind
  when Option::Some(k) then Option::Some(TypedStmt { id: stmt.node_id, kind: k })
  when Option::None then Option::None
  end
end

# The typed place of a place-like expression — the DERIVED INDEX form over
# the recursive tree. Option::None for non-place expressions and for nodes
# the tree does not record (the access checker falls back to its own
# shape walk for those).
def typed_place_of(env: &TypeEnv, expr: &Expr) -> Option[TypedPlace]
  match expr.kind
  when ExprKind::ExprIdent(name) then
    match env.typed_ident_resolutions.get(expr.node_id)
    when Option::Some(lid) then
      if lid >= 0 then
        Option::Some(TypedPlace { root: AccessRoot::Local(LocalId { id: lid }), root_name: name.clone(), projections: Vec::new() })
      else
        Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprSelfRef then
    Option::Some(TypedPlace { root: AccessRoot::SelfValue, root_name: "self".to_string(), projections: Vec::new() })
  when ExprKind::ExprFieldAccess(base, field) then
    match typed_place_of(env, &base)
    when Option::Some(tp) then
      match env.typed_exprs.get(expr.node_id)
      when Option::Some(te) then
        match te.kind
        when TypedExprKind::Field(tf) then
          var projs = tp.projections.clone()
          projs.push(TypedPlaceProj::Field(tf.field, field.clone()))
          Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs })
        when TypedExprKind::TupleIndex(ti) then
          var projs2 = tp.projections.clone()
          projs2.push(TypedPlaceProj::TupleIndex(ti.index))
          Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs2 })
        when _ then Option::None
        end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprIndex(base, _) then
    match typed_place_of(env, &base)
    when Option::Some(tp) then
      var projs3 = tp.projections.clone()
      projs3.push(TypedPlaceProj::Index)
      Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs3 })
    when Option::None then Option::None
    end
  when ExprKind::ExprRawDeref(inner) then
    match typed_place_of(env, &inner)
    when Option::Some(tp) then
      var projs4 = tp.projections.clone()
      projs4.push(TypedPlaceProj::Deref)
      Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs4 })
    when Option::None then Option::None
    end
  when ExprKind::ExprAccess(inner) then typed_place_of(env, &inner)
  when _ then Option::None
  end
end

# The recording site (check_expr's tail): after the expression's type is
# resolved, build the TypedExpr from the expression shape and the recorded
# semantic metadata, and record it into typed_exprs. The flat maps remain
# the derived indexes; this node record is the recursive Typed-HIR tree.
# There is NO Unsupported kind — every accepted construct has a typed
# shape; the unsupported constructs are rejected at check time with a
# diagnostic before MIR. The missing-metadata rule (reviewer item 13): a
# call whose TypedCall cannot be assembled (no recorded call target, or an
# argument without a recorded access effect or typed child) records an
# ICE-class TypeError and the node is NOT recorded — the construction never
# silently defaults. A REJECTED node (the checker's Type::Error result — an
# illegal access marker, a map literal, an unknown symbol, ...) is not
# recorded either: the program is already rejected, and the missing-child
# ICEs must not fire for the rejected construct's children.
def record_typed_hir(env: &mut TypeEnv, expr: &Expr, result: &Type) -> Unit
  match result
  when Type::Error then ()
  when _ then
    match typed_kind_for(env, expr)
    when Option::Some(kind) then
      env.typed_exprs.insert(expr.node_id, TypedExpr { id: expr.node_id, ty: result.clone(), kind: kind })
    when Option::None then ()
    end
  end
end

# Build the typed kind of an expression node from its shape and the
# recorded semantic metadata (the per-variant typed children are looked up
# from the recorded tree — children are recorded before their parents).
# Option::None = the missing-metadata failure class (the ICE was recorded)
# or a rejected construct (ExprError — the parser already diagnosed it).
def typed_kind_for(env: &mut TypeEnv, expr: &Expr) -> Option[TypedExprKind]
  match expr.kind
  when ExprKind::ExprIntLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprFloatLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprStringLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprCharLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprBoolLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprNilLit then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprSelfRef then Option::Some(TypedExprKind::SelfRef)
  when ExprKind::ExprIdent(_) then
    # Local only when the ident resolves to a semantic local (the
    # typed_ident_resolutions value >= 0); a global callable, a static or a
    # bare variant name in value position is the Global shape (typed via
    # the node's type — the name is display/diagnostic only).
    match env.typed_ident_resolutions.get(expr.node_id)
    when Option::Some(lid) then
      if lid >= 0 then
        Option::Some(TypedExprKind::Local(lid))
      else
        Option::Some(TypedExprKind::Global(typed_ident_name_of(expr)))
      end
    when Option::None then Option::Some(TypedExprKind::Global(typed_ident_name_of(expr)))
    end
  when ExprKind::ExprPath(path) then
    Option::Some(TypedExprKind::Path(if path.segments.len() > 0 then path.segments.join("::") else "" end))
  when ExprKind::ExprBinaryOp(op, left, right) then
    match typed_children_2(env, &left, &right)
    when Option::Some((lt, rt)) then Option::Some(TypedExprKind::BinaryOp { op: op, left: Box::new(lt), right: Box::new(rt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprUnaryOp(op, inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::UnaryOp { op: op, operand: Box::new(it) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprIndex(base, index) then
    match typed_children_2(env, &base, &index)
    when Option::Some((bt, it)) then Option::Some(TypedExprKind::Index { base: Box::new(bt), index: Box::new(it) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprCast(inner, ty_expr) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Cast { value: Box::new(it), target: resolve_type_expr(env, &ty_expr) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTypeCheck(inner, ty_expr) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::TypeCheck { value: Box::new(it), target: resolve_type_expr(env, &ty_expr) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprRawDeref(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::RawDeref(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprAccess(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Access(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprRange(start, end_, inclusive) then
    let start_typed = match start
    when Option::Some(s) then
      match typed_child_of(env, &s)
      when Option::Some(st) then Option::Some(Box::new(st))
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    when Option::None then Option::None
    end
    let end_typed = match end_
    when Option::Some(e) then
      match typed_child_of(env, &e)
      when Option::Some(et) then Option::Some(Box::new(et))
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    when Option::None then Option::None
    end
    Option::Some(TypedExprKind::Range { start: start_typed, end_: end_typed, inclusive: inclusive })
  when ExprKind::ExprAwait(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Await(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTry(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Try(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprPipe(lhs, rhs) then
    match typed_children_2(env, &lhs, &rhs)
    when Option::Some((lt, rt)) then Option::Some(TypedExprKind::Pipe { lhs: Box::new(lt), rhs: Box::new(rt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprAssign(target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then Option::Some(TypedExprKind::Assign { target: Box::new(tt), value: Box::new(vt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprArrayLit(elems) then
    match typed_children_of(env, &elems)
    when Option::Some(items) then Option::Some(TypedExprKind::ArrayLit(items))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTupleLit(elems) then
    match typed_children_of(env, &elems)
    when Option::Some(items) then Option::Some(TypedExprKind::TupleLit(items))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprStructLit(path, fields) then
    var fields_typed = Vec::new()
    var fi = 0
    while fi < fields.len() do
      match typed_child_of(env, &fields[fi].1)
      when Option::Some(ft) then
        fields_typed.push((fields[fi].0.clone(), ft))
        fi = fi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    Option::Some(TypedExprKind::StructLit { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, fields: fields_typed })
  when ExprKind::ExprMapLit(entries) then
    var entries_typed = Vec::new()
    var mi = 0
    while mi < entries.len() do
      match typed_children_2(env, &entries[mi].0, &entries[mi].1)
      when Option::Some((kt, vt)) then
        entries_typed.push((kt, vt))
        mi = mi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    Option::Some(TypedExprKind::MapLit(entries_typed))
  when ExprKind::ExprCall(func, args) then
    match typed_call_for(env, expr, &args, Option::None)
    when Option::Some(tc) then Option::Some(TypedExprKind::Call(tc))
    when Option::None then
      # The closure-call shape: the callee is a closure VALUE (a local or a
      # parenthesized closure) whose type is Type::Function — no DefId
      # target — recorded with the closure-call marker and the args'
      # effects instead of the ICE. Only a Type::Function callee takes this
      # path; an unresolvable non-closure callee stays an ICE (the
      # missing-metadata rule: never silently default the callee).
      match closure_call_shape(env, &func, &args, Option::None)
      when Option::Some(tc2) then Option::Some(TypedExprKind::Call(tc2))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed HIR call node (node " + expr.node_id.to_string() + "): missing typed call target or argument access effect", expr.span, "ICE")
        Option::None
      end
    end
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    match typed_call_for(env, expr, &args, Option::Some(recv))
    when Option::Some(tc) then Option::Some(TypedExprKind::Call(tc))
    when Option::None then
      # The closure-call shape for a method call: the target has no DefId
      # and the RECEIVER is a closure value (Type::Function) — recorded
      # with the closure-call marker, the receiver's effect and the args'
      # effects instead of the ICE.
      match closure_call_shape(env, &recv, &args, Option::Some(recv))
      when Option::Some(tc2) then Option::Some(TypedExprKind::Call(tc2))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed HIR call node (node " + expr.node_id.to_string() + "): missing typed call target or argument access effect", expr.span, "ICE")
        Option::None
      end
    end
  when ExprKind::ExprFieldAccess(recv, field) then
    match typed_child_of(env, &recv)
    when Option::Some(rt) then
      # Field only when field_targets recorded a FieldId (a struct field);
      # the non-id access forms (tuple indices, String/Slice/Array
      # len/cap) are the TupleIndex shape (index = the parsed tuple index,
      # -1 for the named len/cap forms).
      match env.typed_field_targets.get(expr.node_id)
      when Option::Some(fid) then Option::Some(TypedExprKind::Field(TypedField { field: fid, base: rt }))
      when Option::None then
        let tidx = match field.parse_int()
        when Result::Ok(n) then n
        when Result::Err(_) then -1
        end
        Option::Some(TypedExprKind::TupleIndex { base: Box::new(rt), name: field.clone(), index: tidx })
      end
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprEnumVariant(path, args) then
    match typed_children_of(env, &args)
    when Option::Some(args_typed) then
      # The resolved variant identity: find_enum_variant_indexed is the
      # checker's owner + index resolution (the same lookup the check arm
      # used). An unresolvable "variant" (the Vec::from static-path call
      # fallback) is the StaticPathCall shape — the MIR resolves the callee
      # by the qualified path.
      let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
      match find_enum_variant_indexed(env, variant_name.clone())
      when Option::Some((enum_td, _, vidx)) then
        Option::Some(TypedExprKind::Variant(TypedVariant { variant: VariantId { owner: TypeId { id: enum_td.id.id }, index: vidx as UInt }, args: args_typed }))
      when Option::None then
        Option::Some(TypedExprKind::StaticPathCall { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, args: args_typed })
      end
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprMacroCall(name, args) then
    match typed_children_of(env, &args)
    when Option::Some(args_typed) then Option::Some(TypedExprKind::MacroCall { name: name, args: args_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprClosure(params, _, body) then
    # The typed parameter patterns (recorded by check_pattern) and the
    # typed body node (recorded by the body check).
    var typed_params = Vec::new()
    var pi = 0
    while pi < params.len() do
      match typed_pattern_of(env, &params[pi].pat)
      when Option::Some(tp) then
        typed_params.push(tp)
        pi = pi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    match typed_child_of(env, &body)
    when Option::Some(bt) then Option::Some(TypedExprKind::Closure { params: typed_params, body: Box::new(bt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprIf(if_stmt) then
    match typed_child_of(env, &if_stmt.cond)
    when Option::Some(ct) then
      var elsif_typed = Vec::new()
      var ei = 0
      while ei < if_stmt.elsif_branches.len() do
        match typed_child_of(env, &if_stmt.elsif_branches[ei].0)
        when Option::Some(et) then
          elsif_typed.push((et, typed_stmts_of(env, &if_stmt.elsif_branches[ei].1)))
          ei = ei + 1
        when Option::None then return missing_typed_hir_child(env, expr)
        end
      end
      let else_typed = match if_stmt.else_block
      when Option::Some(eb) then Option::Some(typed_stmts_of(env, &eb))
      when Option::None then Option::None
      end
      Option::Some(TypedExprKind::If { cond: Box::new(ct), then_block: typed_stmts_of(env, &if_stmt.then_block), elsif_branches: elsif_typed, else_block: else_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprMatch(m) then
    match typed_child_of(env, &m.scrutinee)
    when Option::Some(st) then
      var arms_typed = Vec::new()
      var ai = 0
      while ai < m.arms.len() do
        let arm = m.arms[ai]
        let guard_typed = match arm.guard_expr
        when Option::Some(g) then
          match typed_child_of(env, &g)
          when Option::Some(gt) then Option::Some(gt)
          when Option::None then return missing_typed_hir_child(env, expr)
          end
        when Option::None then Option::None
        end
        match typed_pattern_of(env, &arm.pattern)
        when Option::Some(apt) then
          arms_typed.push(TypedMatchArm { pattern: apt, guard_expr: guard_typed, body: typed_stmts_of(env, &arm.body) })
          ai = ai + 1
        when Option::None then return missing_typed_hir_child(env, expr)
        end
      end
      Option::Some(TypedExprKind::Match { scrutinee: Box::new(st), arms: arms_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprBlock(block) then
    Option::Some(TypedExprKind::Block(typed_stmts_of(env, &block)))
  when ExprKind::ExprUnsafe(reason, block) then
    Option::Some(TypedExprKind::Unsafe { reason: reason, body: typed_stmts_of(env, &block) })
  when ExprKind::ExprAsync(block) then
    Option::Some(TypedExprKind::Async(typed_stmts_of(env, &block)))
  when ExprKind::ExprComptime(block) then
    Option::Some(TypedExprKind::Comptime(typed_stmts_of(env, &block)))
  when ExprKind::ExprError(_) then Option::None
  when _ then
    # Defensive: every checker-accepted construct has an arm above; a new
    # ExprKind variant reaching this arm is a compiler gap — an explicit
    # diagnostic, never an Unsupported node.
    type_add_error(env, "internal error: unhandled expression kind in typed HIR construction (node " + expr.node_id.to_string() + ")", expr.span)
    Option::None
  end
end

# The display name of a non-local ident (the Global shape): the source
# name of the ExprIdent node.
def typed_ident_name_of(expr: &Expr) -> String
  match expr.kind
  when ExprKind::ExprIdent(name) then name.clone()
  when _ then ""
  end
end

# The semantic authority: every downstream phase (resource checker, access
# checker, MIR, codegen) consumes THESE tables instead of re-deriving
# semantics. One TypeId universe: type_kinds/type_names/type_fields/
# type_variants/type_params/deinit_plans are keyed by the SAME semantic
# TypeIds the type checker assigned.
struct TypedProgram
  ast: Program
  resolutions: ResolvedNames
  expr_types: Map[Int, Type]
  call_targets: Map[Int, DefId]
  # P0-AK (final): call expr node id -> the type checker's SOLVED generic
  # substitution for that call (the callee's generic args in the callee's
  # parameter order). Populated at the generic-call sites ONLY when the
  # callee is generic and EVERY generic parameter is solved; absent for
  # synthesized/unsolved calls (a call a context never solves is reported
  # by resolve_pending_call_instances). The solved substitutions from the
  # type checker are the AUTHORITY — ZERO-INFERENCE: the monomorphizer
  # performs no call-site inference (fail-closed). MIR pairs this with
  # call_targets to fill the call instance's substs.
  call_instances: Map[Int, Vec[Type]]
  field_targets: Map[Int, FieldId]
  access_effects: Map[Int, AccessEffect]
  # P0-TH (reviewer item 16, phase 2): the Typed HIR — per expression node
  # id, the typed node the checker recorded (kind + resolved type). The
  # node forms are RECURSIVE: every kind carries its typed children
  # (per-variant), so the MIR reads the call target, the receiver/argument
  # effects, the field identity and the variant identity from the tree.
  # The flat maps above remain the DERIVED INDEXES over the tree for the
  # consumers that have not migrated to the tree (the MIR's flat
  # fallbacks, the resource checker, the access checker).
  typed_exprs: Map[Int, TypedExpr]
  closure_captures: Map[Int, Map[Int, AccessEffect]]
  local_bindings: Map[Int, LocalBinding]
  ident_resolutions: Map[Int, Int]
  # Parameter bindings are keyed by owner (function/method DefId via
  # fn_owner_key) with a positional Vec; pattern bindings are keyed by
  # pattern node id. The two domains never collide.
  param_binding_resolutions: Map[String, Vec[Int]]
  pattern_binding_resolutions: Map[Int, Int]
  # Authoritative deinitialization plan per type id (DeinitPlan). Computed in
  # type_check_typed; MIR consumes it for recursive cleanup emission instead
  # of guessing per-type finalization from names.
  deinit_plans: Map[Int, DeinitPlan]
  # Per aggregate-literal expression node id: whether each child value is
  # OWNED (transferred into the aggregate). Consumed by the resource checker
  # for uniform aggregate ownership transfer.
  aggregate_ownership: Map[Int, Vec[Bool]]
  # Authoritative per-function finalize set: fn owner key -> local ids to
  # finalize at function end (computed by the resource checker from its final
  # per-function frames). MIR consumes this instead of re-deriving cleanup
  # from declared locals.
  finalize_plan: Map[String, Vec[Int]]
  # P0-C: per-edge cleanup obligations keyed by the STABLE SEMANTIC edge
  # identity "edge::<CfgEdgeKind>::<source node id>" (e.g. "edge::Return::42",
  # "edge::Backedge::7", "edge::Normal::12"). KEY SCHEME (deterministic,
  # documented in resource_check.tg at ResourceCheckResult and
  # record_edge_cleanup_plan): one entry per CfgEdge record with a non-empty
  # cleanup obligation; <CfgEdgeKind> is the canonical kind render (Normal,
  # True, False, Break, Continue, Return, Backedge, GuardElse); <source node
  # id> is the edge's source semantic node id, globally unique, so the key is
  # unambiguous program-wide — the same uniqueness the finalize_plan string
  # keys rely on. The values are the local ids in reverse drop order,
  # byte-identical to the values of the compatibility-layer string keys
  # ("return::<id>"/"break::<id>"/"continue::<id>"/"backedge::<id>"/
  # "block::<id>"). Populated by the resource checker (migrated from its
  # result into this field by compiler_core); the MIR consults the edge map
  # FIRST at every cleanup-lookup site and falls back to the string keys only
  # for synthesized/IR-only nodes that never had a checker edge.
  edge_cleanup: Map[String, Vec[Int]]
  # Type id -> type name and type id -> registered finalizer callable, used
  # by build_deinit_plan to construct the recursive DeinitPlan per type.
  # P0-D: deinit_targets is the CHECKER's FINALIZER REGISTRATION — TypeId ->
  # the Drop-impl / deinit method's resolver DefId (CallableId), never a
  # mangled name. The registration is the identity source for every
  # DeinitPlan::Call / UserFinalizer payload; the mangled emission names
  # ("Type__drop" / "Type__deinit") are derived by the MIR only at the
  # symbol-mangling boundary.
  type_names: Map[Int, String]
  deinit_targets: Map[Int, CallableId]
  # Type id -> struct field shapes (name, type) and enum variant shapes
  # (name, field types, discriminant): the nominal information DeinitPlan
  # construction needs to walk struct fields and enum variants when a
  # resource has no explicit deinit (viral containment).
  type_fields: Map[Int, Vec[(String, Type)]]
  type_variants: Map[Int, Vec[(String, Vec[Type], Int)]]
  # Type id -> generic parameter ids (for substituting concrete args into
  # field/variant types when building containment plans). P0-GPI: the ids in
  # declaration order; the param-name table below holds the display names.
  type_params: Map[Int, Vec[GenericParamId]]
  type_kinds: Map[Int, TypeKind]
  # P0 (engine snapshot completeness): type id -> the RESOLVED inner type of
  # a type alias (TypeDefKind::Alias — the checker's registered alias
  # declaration). The engine snapshot (engine_snapshot_env, resource_check.tg)
  # reconstructs TypeDefKind from the serialized field/variant tables and
  # cannot see aliases (they land Opaque — the engine would answer
  # needs_drop=false for an alias of an owning type, diverging from the
  # checker's env, which walks the Alias inner). The MIR re-applies these
  # entries onto the snapshot env so both sides of the seam answer from the
  # same authority.
  type_aliases: Map[Int, Type]
  # P0-GPI: fn owner key -> the generic parameter ids of that function/
  # method in the MIR's merged declaration order (the MIR builder's
  # Type::Param reconstruction record) and the serialized param-name table
  # (numeric GenericParamId -> name — diagnostics only; the MIR and the
  # monomorphizer render names from this snapshot).
  generic_param_ids: Map[String, Vec[GenericParamId]]
  generic_param_names: Map[Int, String]
end

struct TypeCheckResult
  errors: Vec[TypeError]
  program: TypedProgram
end


def type_env_new() -> TypeEnv
  var env = TypeEnv {
    type_list: Vec::new(),
    type_name_index: Map::new(),
    module_type_names: Map::new(),
    module_callable_types: Map::new(),
    callable_first_wins: Map::new(),
    type_id_index: Map::new(),
    type_id_counter: 100,
    subst: Map::new(),
    var_counter: 0,
    scopes: Vec::new(),
    check_ctx: "",
    current_module_path: Vec::new(),
    strict_resolution: false,
    expected_return: Option::None,
    binding_plans: Map::new(),
    pattern_variant_resolutions: Map::new(),
    impls: Vec::new(),
    method_lookup: Map::new(),
    trait_registry: Map::new(),
    # P0-BT: placeholder — rebuilt from the registered builtins at the end
    # of this function (build_lang_items must run AFTER every builtin
    # registration; -1 = "not registered at init").
    lang_items: LangItems {
      option: -1,
      result: -1,
      vec: -1,
      map: -1,
      set: -1,
      box_: -1,
      rc: -1,
      array: -1,
      slice: -1,
      drop_trait: -1,
      clone_trait: -1,
      copy_trait: -1,
      eq_trait: -1,
      hash_trait: -1,
      transferable_trait: -1,
      shareable_trait: -1
    },
    param_for_type_impls: Vec::new(),
    param_bounds: Map::new(),
    pending_call_instances: Map::new(),
    non_send_types: Set::new(),
    non_sync_types: Set::new(),
    errors: Vec::new(),
    warnings: Vec::new(),
    typed_expr_types: Map::new(),
    local_id_counter: 0,
    local_ids: Vec::new(),
    resolutions: Option::None,
    typed_call_targets: Map::new(),
    typed_call_instances: Map::new(),
    typed_field_targets: Map::new(),
    typed_local_bindings: Map::new(),
    typed_ident_resolutions: Map::new(),
    param_binding_resolutions: Map::new(),
    pattern_binding_resolutions: Map::new(),
    typed_access_effects: Map::new(),
    typed_exprs: Map::new(),
    typed_stmts: Map::new(),
    typed_patterns: Map::new(),
    typed_aggregate_ownership: Map::new(),
    closure_captures: Map::new(),
    access_marker_depth: 0,
    generic_param_table: generic_param_table_new(),
    generic_param_ids: Map::new(),
    type_prop_cache: Map::new()
  }
  
  # P0-BG: documentation mirror of the std's concurrency exclusions —
  # kept populated as documentation; the is_send / is_sync checks consult
  # the obligation solver (trait Transferable / Shareable), not these sets.
  env.non_send_types.insert("Rc".to_string())
  env.non_sync_types.insert("Rc".to_string())
  env.non_sync_types.insert("Cell".to_string())
  env.non_sync_types.insert("RefCell".to_string())
  env.non_sync_types.insert("UnsafeCell".to_string())
  
  # Register primitive types
  register_primitive(&mut env, "Unit")
  register_primitive(&mut env, "Bool")
  register_primitive(&mut env, "Int")
  register_primitive(&mut env, "UInt")
  register_primitive(&mut env, "Float")
  register_primitive(&mut env, "Char")
  register_primitive(&mut env, "String")
  register_primitive(&mut env, "Never")
  
  # Register sized integer types
  register_primitive(&mut env, "i8")
  register_primitive(&mut env, "i16")
  register_primitive(&mut env, "i32")
  register_primitive(&mut env, "i64")
    register_primitive(&mut env, "i128")
  register_primitive(&mut env, "u8")
  register_primitive(&mut env, "u16")
  register_primitive(&mut env, "u32")
  register_primitive(&mut env, "u64")
    register_primitive(&mut env, "u128")
    register_primitive(&mut env, "isize")
    register_primitive(&mut env, "usize")
  register_primitive(&mut env, "f32")
  register_primitive(&mut env, "f64")
  
  # Register smart pointer types (P0-BT: explicit parameter names — the
  # arity-derived T/V/E helper is gone; every builtin declares its
  # GenericParamIds explicitly, reviewer item 111). P0-GPI: each builtin
  # interns its parameters first (begin_builtin_generic — a fresh synthetic
  # owner, declaration order == id index), then the kind is constructed
  # with the interned ids.
  let ptr_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Ptr", ptr_ids, TypeDefKind::Opaque)
  let ptrmut_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "PtrMut", ptrmut_ids, TypeDefKind::Opaque)
  let box_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Box", box_ids, TypeDefKind::Opaque)
  let rc_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Rc", rc_ids, TypeDefKind::Opaque)
  
  # Register built-in generic types (Rust parity)
  let option_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Option", option_ids.clone(),
    TypeDefKind::Enum([
      VariantInfo { name: "Some", fields: [Type::Param(option_ids[0].clone())], discriminant: 0 },
      VariantInfo { name: "None", fields: Vec::new(), discriminant: 1 }
    ]))
  let result_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string(), "E".to_string()]))
  register_builtin_generic_named(&mut env, "Result", result_ids.clone(),
    TypeDefKind::Enum([
      VariantInfo { name: "Ok", fields: [Type::Param(result_ids[0].clone())], discriminant: 0 },
      VariantInfo { name: "Err", fields: [Type::Param(result_ids[1].clone())], discriminant: 1 }
    ]))
  let vec_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Vec", vec_ids.clone(),
    TypeDefKind::Struct([
      # The actual storage: ptr is a POINTER to the element buffer, not the
      # element itself (a bare T field would poison field typing, containment,
      # destruction, and generic substitution).
      FieldInfo { name: "ptr", ty: Type::Ptr(Type::Param(vec_ids[0].clone())), is_public: false },
      FieldInfo { name: "len", ty: Type::Int, is_public: true },
      FieldInfo { name: "cap", ty: Type::Int, is_public: false }
    ]))
  # Type representation collapse (P0-K): Map/Set/Array/Slice ARE registered
  # as builtin Opaque generic types — the Adt form needs their TypeIds.
  # Their LangItems ids (map/set/array/slice) are the special-behavior
  # selector of the Adt form (Type::Adt(tid, args)); the canonical variants
  # (Type::Map/Type::Set/Type::Array/Type::Slice) no longer exist. The std's
  # empty `struct Map[K: Hash + Eq, V]` / `struct Set[T: Hash + Eq]` stubs
  # are no-op re-registrations of these builtins (store_type_def's
  # empty-stub / builtin-Opaque paths keep the intrinsic TypeId), and the
  # Array/Slice names are special-cased before any name lookup.
  let array_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Array", array_ids, TypeDefKind::Opaque)
  let slice_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Slice", slice_ids, TypeDefKind::Opaque)
  let map_ids = begin_builtin_generic(&mut env, Vec::from(["K".to_string(), "V".to_string()]))
  register_builtin_generic_named(&mut env, "Map", map_ids, TypeDefKind::Opaque)
  let set_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Set", set_ids, TypeDefKind::Opaque)
  # Register Any as a built-in opaque type (resolved to a fresh type var in
  # type position; the registration keeps name lookups such as trait impl
  # resolution on `dyn Any` working).
  register_builtin_generic_named(&mut env, "Any", Vec::new(), TypeDefKind::Opaque)
  
  # Register built-in traits (Rust parity). P0-GPI: each trait interns its
  # implicit parameters under its own synthetic owner, then the method
  # signatures are constructed with the interned ids.
  register_builtin_trait(&mut env, "Copy", Vec::new())
  register_builtin_trait(&mut env, "Drop", [
    MethodSig { name: "drop", params: Vec::new(), ret_type: Type::Unit, is_method: true }
  ])
  let clone_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Clone", [
    MethodSig { name: "clone", params: Vec::new(), ret_type: Type::Param(clone_ids[0].clone()), is_method: true }
  ])
  register_builtin_trait(&mut env, "Display", [
    MethodSig { name: "to_string", params: Vec::new(), ret_type: Type::String, is_method: true }
  ])
  register_builtin_trait(&mut env, "Debug", [
    MethodSig { name: "debug_string", params: Vec::new(), ret_type: Type::String, is_method: true }
  ])
  let iterator_ids = begin_builtin_generic(&mut env, Vec::from(["Item".to_string()]))
  register_builtin_trait(&mut env, "Iterator", [
    # The builtin compound result is the Adt form (Option is a registered
    # builtin; builtin_adt resolves its LangItems TypeId).
    MethodSig { name: "next", params: Vec::new(), ret_type: builtin_adt(&env, "Option".to_string(), [Type::Param(iterator_ids[0].clone())]), is_method: true }
  ])
  register_builtin_trait(&mut env, "Send", Vec::new())
  register_builtin_trait(&mut env, "Sync", Vec::new())
  let eq_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Eq", [
    MethodSig { name: "eq", params: [ParamType { ty: Type::Param(eq_ids[0].clone()), convention: AccessConvention::Let }], ret_type: Type::Bool, is_method: true }
  ])
  let ord_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Ord", [
    MethodSig { name: "cmp", params: [ParamType { ty: Type::Param(ord_ids[0].clone()), convention: AccessConvention::Let }], ret_type: Type::Int, is_method: true }
  ])
  register_builtin_trait(&mut env, "Hash", [
    MethodSig { name: "hash", params: Vec::new(), ret_type: Type::Int, is_method: true }
  ])
  let default_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Default", [
    MethodSig { name: "default", params: Vec::new(), ret_type: Type::Param(default_ids[0].clone()), is_method: false }
  ])
  let into_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_trait(&mut env, "Into", [
    MethodSig { name: "into", params: Vec::new(), ret_type: Type::Param(into_ids[0].clone()), is_method: true }
  ])
  let from_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string(), "T".to_string()]))
  register_builtin_trait(&mut env, "From", [
    MethodSig { name: "from", params: [ParamType { ty: Type::Param(from_ids[1].clone()), convention: AccessConvention::Let }], ret_type: Type::Param(from_ids[0].clone()), is_method: false }
  ])

  # P0-BT (reviewer item 15): the LangItems bundle is built AFTER every
  # builtin registration so the type_name_index / trait_registry lookups
  # resolve the intrinsic ids; uniqueness is asserted inside build_lang_items.
  env.lang_items = build_lang_items(&env)

  env
end

def register_primitive(env: &mut TypeEnv, name: String) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: TypeDefKind::Primitive,
    generic_params: Vec::new(),
    kind: TypeKind::Value
  }
  env.type_name_index.insert(name, env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
end

# Generic parameters are ALWAYS explicit — the old arity-derived T/V/E
# helper is gone (reviewer item 111: "No arity-derived parameter names"):
# Result needs [T, E], Map needs [K, V], and the mechanical names would
# disagree with the variants' Param references. Every builtin declares its
# GenericParamIds explicitly via register_builtin_generic_named.

# P0-GPI: begin a builtin registration's generic-parameter interning — a
# fresh synthetic owner DefId (the builtins have no resolver DefId) with
# the declared parameters interned in declaration order. Returns the ids;
# the call site constructs the registration's kind with
# Type::Param(ids[i]) — the names land in the param-name table here.
def begin_builtin_generic(env: &mut TypeEnv, names: Vec[String]) -> Vec[GenericParamId]
  let owner = fresh_synthetic_owner(&mut env.generic_param_table)
  var ids = Vec::new()
  var i = 0
  while i < names.len() do
    ids.push(intern_generic_param(&mut env.generic_param_table, &owner, names[i].clone()))
    i = i + 1
  end
  ids
end

# P0-GPI: a builtin type registration. The generic parameters were already
# interned (begin_builtin_generic — declaration order == id index); the
# kind's Param payloads already carry the ids.
def register_builtin_generic_named(env: &mut TypeEnv, name: String, gen_params: Vec[GenericParamId], kind: TypeDefKind) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: kind,
    generic_params: gen_params,
    kind: TypeKind::Value
  }
  env.type_name_index.insert(name, env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
end

# P0-GPI: a builtin trait registration. Each builtin trait interns its
# implicit generic parameters (the trait's "Self", plus any trait-level
# parameter like Iterator's "Item" or Into/From's "T") under its OWN fresh
# synthetic owner (begin_builtin_generic), so no two traits' implicit
# parameters ever collide. The MethodSig payloads carry the ids.
def register_builtin_trait(env: &mut TypeEnv, sink name: String, sink methods: Vec[MethodSig]) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: TypeDefKind::Trait(methods),
    generic_params: Vec::new(),
    kind: TypeKind::Value
  }
  env.type_name_index.insert(name.clone(), env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
  # P0-TM: the builtin trait declarations register their TraitId (reusing
  # the TypeId value — the declaration is the identity) in the bare-name
  # registry. Builtins have NO resolver declaration (they are prelude
  # intrinsics registered before any module context exists), so the bare
  # entry is their identity and the module-qualified map records nothing
  # for them (no resolutions at env init); a std re-declaration of a
  # builtin trait re-registers the SAME builtin id (store_type_def's
  # identical-acceptance) under the std module's qualified key.
  env.trait_registry.insert(name, id_num)
end

# P0-BT (reviewer item 15): the LangItems build helpers. TypeId by name for
# the LangItems type fields; -1 when the name is not registered (only the
# std-declared traits at init — Transferable/Shareable; the nine type
# names are all registered builtins).
def lang_item_type_id(env: &TypeEnv, name: String) -> Int
  match get_type_id_by_name(env, name)
  when Option::Some(tid) then tid.id
  when Option::None then -1
  end
end

# P0-TM: TraitId by name for the LangItems trait fields; -1 when the trait
# has no registry entry at the time of the lookup (Transferable/Shareable
# are std-declared — their TraitIds arrive via the source-trait
# registrations in pass 1/2). The LangItems bundle is built ONCE at env
# init, so this reads the BARE registry (the builtins — the only traits
# registered at init); the module-qualified map does not exist yet.
def lang_item_trait_id(env: &TypeEnv, name: String) -> Int
  match env.trait_registry.get(name)
  when Option::Some(tid) then tid
  when Option::None then -1
  end
end

# Uniqueness invariant of the LangItems build (asserted structurally): every
# RESOLVED id must be distinct — the builtin registrations draw from one
# monotonic counter (type_id_counter), so a duplicate would be an internal
# error. A -1 sentinel (unregistered name) is skipped.
def lang_items_check_unique(seen: &mut Set[Int], id: Int, what: String) -> Unit
  if id != -1 then
    if seen.contains(&id) then
      panic("ICE: LangItems builtin ids are not distinct (duplicate " + what + " = " + id.to_string() + ")")
    end
    seen.insert(id)
  end
end

# Build the LangItems bundle from the registered builtins. MUST run after
# every builtin registration (end of type_env_new) so the type_name_index /
# trait_registry lookups see the intrinsic ids.
def build_lang_items(env: &TypeEnv) -> LangItems
  let items = LangItems {
    option: lang_item_type_id(env, "Option"),
    result: lang_item_type_id(env, "Result"),
    vec: lang_item_type_id(env, "Vec"),
    map: lang_item_type_id(env, "Map"),
    set: lang_item_type_id(env, "Set"),
    box_: lang_item_type_id(env, "Box"),
    rc: lang_item_type_id(env, "Rc"),
    array: lang_item_type_id(env, "Array"),
    slice: lang_item_type_id(env, "Slice"),
    drop_trait: lang_item_trait_id(env, "Drop"),
    clone_trait: lang_item_trait_id(env, "Clone"),
    copy_trait: lang_item_trait_id(env, "Copy"),
    eq_trait: lang_item_trait_id(env, "Eq"),
    hash_trait: lang_item_trait_id(env, "Hash"),
    transferable_trait: lang_item_trait_id(env, "Transferable"),
    shareable_trait: lang_item_trait_id(env, "Shareable")
  }
  var seen: Set[Int] = Set::new()
  lang_items_check_unique(&mut seen, items.option, "option")
  lang_items_check_unique(&mut seen, items.result, "result")
  lang_items_check_unique(&mut seen, items.vec, "vec")
  lang_items_check_unique(&mut seen, items.map, "map")
  lang_items_check_unique(&mut seen, items.set, "set")
  lang_items_check_unique(&mut seen, items.box_, "box")
  lang_items_check_unique(&mut seen, items.rc, "rc")
  lang_items_check_unique(&mut seen, items.array, "array")
  lang_items_check_unique(&mut seen, items.slice, "slice")
  lang_items_check_unique(&mut seen, items.drop_trait, "drop_trait")
  lang_items_check_unique(&mut seen, items.clone_trait, "clone_trait")
  lang_items_check_unique(&mut seen, items.copy_trait, "copy_trait")
  lang_items_check_unique(&mut seen, items.eq_trait, "eq_trait")
  lang_items_check_unique(&mut seen, items.hash_trait, "hash_trait")
  lang_items_check_unique(&mut seen, items.transferable_trait, "transferable_trait")
  lang_items_check_unique(&mut seen, items.shareable_trait, "shareable_trait")
  items
end

# Helper to get type definition by TypeId
def get_type_by_id(env: &TypeEnv, tid: &TypeId) -> Option[TypeDef]
  match env.type_id_index.get(tid.id)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx])
  when Option::None then
    Option::None
  end
end

# FIX 2 (P1): reference-returning variants of the HOT lookups. The
# type-properties engine (type_named_props / is_named_trivially_copyable)
# and the concurrency classification fetch the same TypeDef repeatedly;
# returning a reference avoids the per-lookup TypeDef copy (the reviewer's
# performance finding — copying in a self-hosted compiler). The by-value
# versions above stay for the remaining callers.
#
# FIX 1 (P1, complete): every CONSUMER of the by-value lookups inside this
# module now goes through the reference-returning forms (get_type_by_id_ref
# / get_type_by_name_ref) — the two by-value definitions above are retained
# only as the exported copy-returning API for non-kernel modules
# (trait_resolve.tg) and must not be used for read-only lookups here.
def get_type_by_id_ref(env: &TypeEnv, tid: &TypeId) -> Option[TypeDef]
  match env.type_id_index.get(tid.id)
  when Option::Some(idx) then
    Option::Some(&env.type_list[idx])
  when Option::None then
    Option::None
  end
end

def get_type_id_by_name(env: &TypeEnv, name: String) -> Option[TypeId]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].id)
  when Option::None then
    Option::None
  end
end

def get_type_def_by_name(env: &TypeEnv, name: String) -> Option[TypeDef]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx])
  when Option::None then
    Option::None
  end
end

# FIX 2 (P1): reference-returning name lookup (companion of
# get_type_by_id_ref); by-name hot paths avoid the TypeDef copy.
def get_type_by_name_ref(env: &TypeEnv, name: String) -> Option[TypeDef]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(&env.type_list[idx])
  when Option::None then
    Option::None
  end
end

def type_kind_map(env: &TypeEnv) -> Map[String, TypeKind]
  var m = Map::new()
  var i = 0
  while i < env.type_list.len() do
    m.insert(env.type_list[i].name.clone(), env.type_list[i].kind)
    i = i + 1
  end
  m
end

# Concrete ownership belongs to the TypeProperties engine
# (type_properties_of — keyed by the concrete type identity, TypeId plus
# substitutions), NOT to mutation of the nominal declaration's global
# TypeKind (the legacy kind-propagation pass is deleted; TypeDef.kind is the
# DECLARED kind only). A concrete type is resource-bearing for access
# purposes when its instantiation requires destruction, is linear, or is a
# capability. A type whose graph still contains an unsubstituted generic
# parameter (is_deferred) is treated as resource-bearing — FAIL-CLOSED: a
# generic local may require conditional drop after substitution, so an
# unknown answer must never degrade to "not owning" (the concrete answer
# appears after the MIR/mono substitution wave).
def type_has_resource_kind(env: &mut TypeEnv, ty: &Type) -> Bool
  let p = type_properties_of(env, ty)
  p.is_deferred || p.needs_drop || p.is_linear || p.is_capability
end

pub def type_kinds_contain_resource(kinds: &Map[Int, TypeKind], ty: &Type) -> Bool
  match ty
  when Type::Adt(id, args) then
    match kinds.get(id.id)
    when Option::Some(k) then
      if k == TypeKind::Resource then
        true
      elsif k == TypeKind::Capability then
        true
      else
        type_args_contain_resource(kinds, &args)
      end
    when Option::None then type_args_contain_resource(kinds, &args)
    end
  when Type::Tuple(fields) then
    type_fields_contain_resource(kinds, &fields)
  when Type::FixedArray(elem, _) then type_kinds_contain_resource(kinds, &elem)
  when Type::Function(_, _) then false
  when Type::RefInternal(inner, _) then type_kinds_contain_resource(kinds, &inner)
  when _ then false
  end
end

def type_args_contain_resource(kinds: &Map[Int, TypeKind], args: &Vec[Type]) -> Bool
  mut i = 0
  while i < args.len() do
    if type_kinds_contain_resource(kinds, &args[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_fields_contain_resource(kinds: &Map[Int, TypeKind], fields: &Vec[Type]) -> Bool
  mut i = 0
  while i < fields.len() do
    if type_kinds_contain_resource(kinds, &fields[i]) then
      return true
    end
    i = i + 1
  end
  false
end

# NOTE: the legacy kind-propagation pass and its type-params helper are
# DELETED. Concrete ownership is computed by the TypeProperties engine
# (type_properties_of, keyed by the concrete type identity (TypeId,
# substitutions)) — never by mutating the nominal declaration's global
# TypeKind. The type_kinds map snapshot (type_kind_map / TypedProgram.
# type_kinds) carries the DECLARED kinds only; the ownership consumers
# (resource_check.tg, mir.tg) query the engine through the snapshot env
# (engine_snapshot_env), and the declared-kind table is read only for the
# declared Capability marker (resource_check.tg's capability-containment
# gap — PENDING, docs/memory_model.md §15.2).

def type_def_is_filled(td: &TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() > 0
  when TypeDefKind::Enum(variants) then variants.len() > 0
  when TypeDefKind::Trait(methods) then methods.len() > 0
  when TypeDefKind::Primitive then true
  when TypeDefKind::Alias(ty) then true
  when TypeDefKind::Opaque then true
  when _ then false
  end
end

# A pre-registered placeholder from pre_register_type_name (pass 1): an
# EMPTY Struct/Enum/Trait or an Alias(Unit) — the two-pass registration
# pattern, NOT a duplicate. The first real definition replaces it.
def type_def_is_forward_declaration(td: &TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() == 0
  when TypeDefKind::Enum(variants) then variants.len() == 0
  when TypeDefKind::Trait(methods) then methods.len() == 0
  when TypeDefKind::Alias(ty) then
    match ty
    when Type::Unit then true
    when _ then false
    end
  when _ then false
  end
end

# An EMPTY source-level declaration (e.g. `struct Vec[T]` / `struct Map[K, V]`
# stubs in std/collections.tg for compiler intrinsics). It declares no fields
# or variants of its own, so it is a no-op re-registration of the SAME type,
# never a distinct definition.
def type_def_is_empty_stub(td: &TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() == 0
  when TypeDefKind::Enum(variants) then variants.len() == 0
  when TypeDefKind::Trait(methods) then methods.len() == 0
  when _ then false
  end
end

# P0-TM: is this definition a TRAIT declaration? The trait-name resolution
# (trait_id_for) filters the module-qualified map to Trait-typed entries —
# a same-named struct in another module is a different namespace and never
# counts toward trait ambiguity.
def type_def_is_trait(td: &TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Trait(_) then true
  when _ then false
  end
end

# Whether two type definitions are structurally IDENTICAL — a re-registration
# of the same type (permitted), as opposed to two genuinely different types
# that happen to share a name (a duplicate — TypeError). Compared on the
# canonical identity keys so generic params and field/variant shapes decide.
def type_defs_identical(env: &TypeEnv, a: &TypeDef, b: &TypeDef) -> Bool
  if a.generic_params.len() != b.generic_params.len() then return false end
  var gi = 0
  while gi < a.generic_params.len() do
    # P0-GPI: generic-parameter identity is the GenericParamId (a
    # re-registration interns its own ids — the DECLARED ORDER and the
    # param-name table renderings decide the identity comparison; the ids
    # of two registrations of the same declaration need not match).
    let a_name = generic_param_name_of(&env.generic_param_table, &a.generic_params[gi])
    let b_name = generic_param_name_of(&env.generic_param_table, &b.generic_params[gi])
    if a_name != b_name then return false end
    gi = gi + 1
  end
  match a.def_kind
  when TypeDefKind::Struct(fa) then
    match b.def_kind
    when TypeDefKind::Struct(fb) then
      if fa.len() != fb.len() then return false end
      var i = 0
      while i < fa.len() do
        if fa[i].name != fb[i].name then return false end
        if type_identity_key(env, &fa[i].ty) != type_identity_key(env, &fb[i].ty) then return false end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Enum(va) then
    match b.def_kind
    when TypeDefKind::Enum(vb) then
      if va.len() != vb.len() then return false end
      var i = 0
      while i < va.len() do
        if va[i].name != vb[i].name then return false end
        if va[i].discriminant != vb[i].discriminant then return false end
        if va[i].fields.len() != vb[i].fields.len() then return false end
        var j = 0
        while j < va[i].fields.len() do
          if type_identity_key(env, &va[i].fields[j]) != type_identity_key(env, &vb[i].fields[j]) then return false end
          j = j + 1
        end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Trait(ma) then
    match b.def_kind
    when TypeDefKind::Trait(mb) then
      if ma.len() != mb.len() then return false end
      var i = 0
      while i < ma.len() do
        if ma[i].name != mb[i].name then return false end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Alias(ta) then
    match b.def_kind
    when TypeDefKind::Alias(tb) then type_identity_key(env, &ta) == type_identity_key(env, &tb)
    when _ then false
    end
  when TypeDefKind::Primitive then
    match b.def_kind
    when TypeDefKind::Primitive then true
    when _ then false
    end
  when TypeDefKind::Opaque then
    match b.def_kind
    when TypeDefKind::Opaque then true
    when _ then false
    end
  end
end

# P0-A (next layer): record the module-qualified type-name entry
# "path::name" -> type_list index for a type registered from module_path.
# The key is recorded only when the resolver's module_symbols snapshot
# holds a DefKind::TypeName or DefKind::Trait entry for exactly this
# (path, name) pair (structs/enums/aliases carry TypeName entries; TRAITS
# carry Trait entries — P0-TM: the trait's TypeDef participates in the
# module-qualified map so a DISTINCT declaration in a different module
# gets its own module-local TypeId, the declaration identity the TraitId
# mirrors). Capabilities, builtins and legitimate re-registrations record
# nothing. The bare first-wins entry in type_name_index is untouched.
# Idempotent: pass-1 placeholders and pass-2 fills record the same index.
def record_module_type_name(env: &mut TypeEnv, name: String, idx: Int, module_path: &Vec[String]) -> Unit
  match env.resolutions
  when Option::Some(res) then
    let key = module_qualified_key(module_path, &name)
    match res.module_symbols.get(&key)
    when Option::Some(did) then
      # P0-AM: the DefKind is metadata — the resolver's def_kinds snapshot.
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::TypeName || k == DefKind::Trait then
          env.module_type_names.insert(key, idx)
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
end

# P0-A (final layer): at callable registration (pass 3), mirror the
# resolver's module-qualified entry "path::name" -> Type, guarded by the
# resolver's module_symbols DefKind entry for exactly this (path, name,
# kind) triple (lookup_module_callable — so a type name and a function name
# never collide through this path), and record the bare-name FIRST
# registration's Type as the recoverable first-wins fallback for ambiguous
# bare callable references (the first registration in program order, matching
# the resolver's bare-name first-wins tables). Idempotent: one callable
# registration happens per item in pass 3.
def record_module_callable(env: &mut TypeEnv, name: String, ty: Type, module_path: &Vec[String], kind: DefKind) -> Unit
  match env.resolutions
  when Option::Some(res) then
    match lookup_module_callable(&res, module_path, name.clone(), kind)
    when Option::Some(_) then
      env.module_callable_types.insert(module_qualified_key(module_path, &name), ty.clone())
    when Option::None then ()
    end
    if !env.callable_first_wins.contains_key(&name) then
      env.callable_first_wins.insert(name, ty.clone())
    end
  when Option::None then ()
  end
end

# P0-A (next layer): is the bare first-wins definition of `name` the one
# registered from `module_path`? True when the module-qualified entry for
# this (path, name) pair points at the same type_list index as the bare
# first-wins entry — i.e. this module IS the first-wins module, so a
# second registration of the same name here is a same-module duplicate.
def module_is_first_wins_owner(env: &TypeEnv, name: &String, module_path: &Vec[String]) -> Bool
  let key = module_qualified_key(module_path, name)
  match env.type_name_index.get(name.clone())
  when Option::Some(bare_idx) then
    match env.module_type_names.get(key)
    when Option::Some(q_idx) then q_idx == bare_idx
    when Option::None then false
    end
  when Option::None then false
  end
end

# P0-A (next layer): does the type checker's module-qualified map hold any
# entry for this bare name? False for builtin first-wins entries
# (primitives, Option/Result/Vec, opaques, builtin traits), whose FIRST
# source-level re-registration (e.g. std re-declaring the builtin
# Option/Result) keeps today's intrinsic-stub/identical semantics — the
# intrinsic keeps its TypeId and the re-registration records its qualified
# entry; any FURTHER module's definition of such a name is a module-local
# type (P0-BT, reviewer item 3: every declaration is its own type).
def has_qualified_type_entry(env: &TypeEnv, name: &String) -> Bool
  for (key, _) in env.module_type_names.entries() do
    if key == name.clone() then
      return true
    end
    let suffix = "::" + name.clone()
    if key.ends_with(suffix) then
      return true
    end
  end
  false
end

# P0-A (next layer): resolve a type name to its TypeId, preferring the
# current module's own module-qualified identity over the bare first-wins
# entry. Falls back to the bare entry when no qualified entry exists
# (builtins, traits, aliases, capabilities — compatibility behavior).
def get_type_id_by_qualified_name(env: &TypeEnv, name: String, module_path: &Vec[String]) -> Option[TypeId]
  let key = module_qualified_key(module_path, &name)
  match env.module_type_names.get(key)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].id)
  when Option::None then
    match env.type_name_index.get(name)
    when Option::Some(idx) then
      Option::Some(env.type_list[idx].id)
    when Option::None then
      Option::None
    end
  end
end

# P0-A (next layer): resolve a bare type name to a type_list index. When
# the same bare name is registered from multiple module paths, the current
# module's own definition shadows the others (local-module preference);
# with no local definition and >= 2 DISTINCT foreign types under the name
# the reference is genuinely ambiguous — the ambiguity TypeError fires and
# the first-wins entry is returned as the recoverable fallback
# (compatibility behavior). P0-BT (reviewer item 3): every declaration is
# its own type — two IDENTICAL declarations in different modules are still
# two DISTINCT types (a::Point and b::Point), so they DO count toward the
# ambiguity, never as one shared type. With no qualified entries at all
# (builtin first-wins, permissive recovery without resolutions), the
# first-wins bare entry resolves unchanged. Conservative: never errors on a
# single definition.
def resolve_bare_type_name(env: &mut TypeEnv, name: String, span: Span) -> Option[Int]
  var own_idx = Option::None
  var foreign_distinct = 0
  var foreign_seen = Map::new()
  let own_key = module_qualified_key(&env.current_module_path, &name)
  let entry_vec = env.module_type_names.entries()
  for (key, idx) in entry_vec do
    var matches = false
    if key == name.clone() then
      matches = true
    else
      let suffix = "::" + name.clone()
      if key.ends_with(suffix) then
        matches = true
      end
    end
    if matches then
      if key == own_key then
        own_idx = Option::Some(idx)
      elsif !foreign_seen.contains_key(&idx) then
        foreign_seen.insert(idx, true)
        foreign_distinct = foreign_distinct + 1
      end
    end
  end
  match own_idx
  when Option::Some(idx) then
    Option::Some(idx)
  when Option::None then
    if foreign_distinct >= 2 then
      type_add_error(env, "ambiguous type name `" + name + "`: defined in multiple modules; qualify the path", span)
    end
    match env.type_name_index.get(name)
    when Option::Some(idx) then Option::Some(idx)
    when Option::None then Option::None
    end
  end
end

# P0-A (final layer): is `name` resolved from the pass-3 program-level
# callable bindings (scope 0)? Locals/parameters/loop bindings live in inner
# scopes (>= 1) and shadow program-level callables — they must bypass the
# module-qualified identity check. Scope 0 holds ONLY the pass-3
# function/const/static bindings (every pass-4 body scope is pushed and
# popped), so a name whose outermost binding is scope 0 is a callable
# reference.
def var_is_global_callable(env: &TypeEnv, name: &String) -> Bool
  if env.scopes.len() == 0 then return false end
  if !env.scopes[0].contains_key(name) then return false end
  var i = env.scopes.len()
  while i > 1 do
    i = i - 1
    if env.scopes[i].contains_key(name) then return false end
  end
  true
end

# P0-A (final layer): resolve a bare callable name (function/constant/static
# in expression position) to its Type. When the resolver's module_symbols
# holds >= 2 DISTINCT qualified definitions of the bare name (counted by
# DefId across the Function/Constant/Static kinds — the kind filter keeps a
# type name and a function name from colliding through this path), the
# CURRENT module's own definition shadows the others (local-module
# preference); with no own definition the reference is genuinely ambiguous —
# the TypeError fires and the FIRST-wins Type is the recoverable fallback
# (compatibility behavior, matching the resolver's bare-name first-wins
# tables). Fewer than 2 distinct qualified definitions — the bootstrap's
# module_symbols holds at most one per bare callable name — resolve
# unchanged. Conservative: never errors on a single definition.
def resolve_bare_callable(env: &mut TypeEnv, name: String, span: Span, fallback: Type) -> Type
  match env.resolutions
  when Option::Some(res) then
    var own_ty = Option::None
    let own_key = module_qualified_key(&env.current_module_path, &name)
    match env.module_callable_types.get(own_key)
    when Option::Some(ty) then own_ty = Option::Some(ty.clone())
    when Option::None then ()
    end
    var foreign_distinct = 0
    var foreign_seen = Map::new()
    let suffix = "::" + name.clone()
    let entry_vec = res.module_symbols.entries()
    for (key, did) in entry_vec do
      # P0-AM: the DefKind is metadata — the resolver's def_kinds snapshot.
      let did_kind = match def_kind_of(&res, &did)
      when Option::Some(k) then k
      when Option::None then DefKind::Other
      end
      if did_kind == DefKind::Function || did_kind == DefKind::Constant || did_kind == DefKind::Static then
        var matches = false
        if key == name.clone() then
          matches = true
        elsif key.ends_with(suffix) then
          matches = true
        end
        if matches && key != own_key then
          # P0-AM: the dedup key renders the DefId's module path (recovered
          # from this entry's module-qualified key — the resolver's
          # module_path_of logic; the keys are built from Program.crate
          # module paths) + index + kind from the def_kinds snapshot.
          let did_path = match key.rfind("::")
          when Option::Some(pos) then key.slice(0, pos).split("::")
          when Option::None then Vec::new()
          end
          let dkey = fn_owner_key(did_path.join("::"), did.index, did_kind)
          if !foreign_seen.contains_key(&dkey) then
            foreign_seen.insert(dkey, true)
            foreign_distinct = foreign_distinct + 1
          end
        end
      end
    end
    match own_ty
    when Option::Some(ty) then
      ty
    when Option::None then
      if foreign_distinct >= 2 then
        type_add_error(env, "ambiguous name `" + name + "`: defined in multiple modules; qualify the path", span)
        match env.callable_first_wins.get(name.clone())
        when Option::Some(ty) then ty.clone()
        when Option::None then fallback
        end
      else
        fallback
      end
    end
  when Option::None then
    fallback
  end
end

# P0-AM (module graph consumption): resolve the owner module path of a flat
# item index by a containment scan over Program.crate.modules — the same
# scan the resolver's module_path_of_item_resolver performs (each Module's
# contiguous [start, end) item range; a missing table falls back to the
# root module, id 0, empty path). Returns the owner path and the owner
# ModuleId.id. The caller threads the returned id (the old pointer position
# is gone — the crate is a Map, so the scan is direct, not a pointer
# advance).
def module_path_of_item(program: &Program, module_ptr: Int, item_idx: Int) -> (Vec[String], Int)
  # P1: the item's OWNER ModuleId is stamped at assembly — the module table
  # read replaces the [start, end) item-range containment scan (Crate
  # modules now carry their items: Module.items: Vec[ItemId]).
  if item_idx < program.items.len() then
    let owner = program.items[item_idx].owner_module
    match program.crate.modules.get(owner)
    when Option::Some(info) then
      var owner_path = Vec::new()
      for seg in info.path do
        owner_path.push(seg.clone())
      end
      return (owner_path, owner.id)
    when Option::None then
      return (Vec::new(), 0)
    end
  end
  (Vec::new(), 0)
end

# P0-BT (reviewer item 3): store a collected type definition, REJECTING
# duplicate definitions instead of merging same-named distinct types. The
# NOMINAL identity of a type is its DECLARATION: two declarations with the
# same name in DIFFERENT modules are DISTINCT types, each with its own
# TypeId — there is NO cross-module structural merging (a::Point and
# b::Point are never the same type, even when structurally identical; the
# qualified-name entries module_type_names give each module's name its own
# TypeId). Legitimate re-registrations of the SAME declaration are: a
# forward-declaration placeholder being filled (pass 1 -> pass 2), an EMPTY
# source-level stub of an already-registered type (std's intrinsic struct
# stubs), a builtin Opaque placeholder (Box/Rc/Ptr...) receiving its
# source-level shape, and a structurally IDENTICAL definition registered
# within the SAME module (re-registration of the same declaration — e.g.
# std/core.tg re-declaring the builtin Option/Result, which keeps the
# intrinsic TypeId, and std's intrinsic stub re-declarations). Anything
# else is a "duplicate type definition" TypeError — fields/variants are
# NEVER merged across distinct declarations.
#
# P0-A (module-qualified type identity): every registration also records
# the module-qualified entry "path::name" (module_type_names). A genuinely
# DISTINCT definition — or an IDENTICAL definition — registered from a
# DIFFERENT module path is a separate module-local type: it is accepted
# with its OWN fresh TypeId under its qualified key, while the bare
# first-wins entry stays untouched. Same-module redefinition remains the
# duplicate TypeError (the identical-acceptance applies ONLY within the
# same module).
def store_type_def(env: &mut TypeEnv, td: TypeDef, span: Span, module_path: &Vec[String]) -> Unit
  match get_type_by_name_ref(env, td.name.clone())
  when Option::Some(existing) then
    if type_def_is_forward_declaration(existing) then
      # A pass-1 placeholder being filled (pass 2): fall through to the
      # replace path below — the ONLY path that reaches it.
      ()
    else
      # A filled existing definition: allow only legitimate re-registrations.
      if type_def_is_empty_stub(&td) then
        # Source-level stub of the same type (intrinsic struct stubs) — no-op.
        return
      end
      if type_defs_identical(env, existing, &td) then
        # P0-BT (reviewer item 3): re-registration of the SAME declaration —
        # the identical-acceptance applies ONLY within the same module (this
        # module IS the first-wins owner) or when the existing entry has no
        # module ownership at all (no qualified entries: a builtin/intrinsic
        # first-wins such as the std re-declaring the builtin Option/Result —
        # the intrinsic TypeId is kept — and permissive recovery without
        # resolutions, where no module identity exists). An IDENTICAL
        # declaration registered from a DIFFERENT module is a DISTINCT type:
        # nominal identity is the declaration, so it gets its OWN fresh
        # TypeId under its module-qualified key (a::Point and b::Point are
        # never the same type) — it falls through to the module-local-type
        # block below.
        if module_is_first_wins_owner(env, &td.name, module_path) || !has_qualified_type_entry(env, &td.name) then
          match env.type_name_index.get(td.name)
          when Option::Some(bare_idx) then
            record_module_type_name(env, td.name.clone(), bare_idx, module_path)
          when Option::None then ()
          end
          return
        end
      else
        match existing.def_kind
        when TypeDefKind::Opaque then
          # A builtin Opaque placeholder (Box/Rc/Ptr/PtrMut/Array/Slice/Any)
          # keeps its intrinsic semantics; the source-level shape of the SAME
          # compiler intrinsic is a re-registration, not a distinct type.
          return
        when _ then ()
        end
      end
      # A genuinely DISTINCT definition or an identical definition from a
      # DIFFERENT module: if the first-wins definition belongs to a DIFFERENT
      # module (a qualified entry exists for the name and none of them is
      # this module's own first-wins entry), this is a separate module-local
      # type — accept it under its module-qualified key with a fresh TypeId
      # (the collect path reused the bare first-wins id, which must not leak
      # into a second type). Otherwise it is a same-module duplicate.
      if has_qualified_type_entry(env, &td.name) && !module_is_first_wins_owner(env, &td.name, module_path) then
        let fresh_id = TypeId { id: env.type_id_counter }
        env.type_id_counter = env.type_id_counter + 1
        let own_td = TypeDef {
          id: fresh_id,
          name: td.name.clone(),
          def_kind: td.def_kind,
          generic_params: td.generic_params.clone(),
          kind: td.kind
        }
        let new_idx = env.type_list.len()
        env.type_id_index.insert(fresh_id.id, new_idx)
        env.type_list.push(own_td)
        record_module_type_name(env, td.name.clone(), new_idx, module_path)
        return
      end
      type_add_error(env, "duplicate type definition `" + td.name + "`", span)
      return
    end
  when Option::None then ()
  end
  match env.type_name_index.get(td.name)
  when Option::Some(idx3) then
    env.type_list.set(idx3, td)
    env.type_name_index.insert(td.name.clone(), idx3)
    env.type_id_index.insert(td.id.id, idx3)
    record_module_type_name(env, td.name.clone(), idx3, module_path)
    return
  when Option::None then
    env.type_name_index.insert(td.name.clone(), env.type_list.len())
    env.type_id_index.insert(td.id.id, env.type_list.len())
    env.type_list.push(td)
    record_module_type_name(env, td.name.clone(), env.type_list.len() - 1, module_path)
  end
end

# ———————————————————————————————————————————————————————————————
# Scope Management
# ———————————————————————————————————————————————————————————————

def push_scope(env: &mut TypeEnv) -> Unit
  let m: Map[String, Type] = Map::new()
  env.scopes.push(m)
  let lm: Map[String, Int] = Map::new()
  env.local_ids.push(lm)
end

def pop_scope(env: &mut TypeEnv) -> Unit
  env.scopes.pop()
  env.local_ids.pop()
  ()
end

def bind_var(env: &mut TypeEnv, name: String, ty: Type) -> Unit
  if !env.scopes.is_empty() then
    let idx = env.scopes.len() - 1
    env.scopes[idx].insert(name.clone(), ty.clone())
    env.local_ids[idx].insert(name.clone(), env.local_id_counter)
    env.typed_local_bindings.insert(env.local_id_counter, LocalBinding { name: name.clone(), ty: ty })
    env.local_id_counter = env.local_id_counter + 1
  end
end

def lookup_var(env: &TypeEnv, name: String) -> Option[Type]
  var i = env.scopes.len()
  while i > 0 do
    i = i - 1
    match env.scopes[i].get(&name)
    when Option::Some(ty) then return Option::Some(ty)
    when Option::None then ()
    end
  end
  Option::None
end

# Sentinel for "no local": local ids are always >= 0, so a NEGATIVE sentinel
# can never collide with a real local (previously 0 was used — 0 is also the
# first real local id, making capture/scan checks ambiguous).
const NO_LOCAL_ID: Int = -1

def local_id_of(env: &TypeEnv, name: String) -> Int
  var i = env.local_ids.len()
  while i > 0 do
    i = i - 1
    match env.local_ids[i].get(&name)
    when Option::Some(id) then return id
    when Option::None then ()
    end
  end
  NO_LOCAL_ID
end

# ———————————————————————————————————————————————————————————————
# Type Variable Operations
# ———————————————————————————————————————————————————————————————

def fresh_type_var(env: &mut TypeEnv) -> Type
  let id = TypeVarId { id: env.var_counter }
  env.var_counter = env.var_counter + 1
  Type::Var(id)
end

# Create fresh type variables for each generic parameter of a type definition.
# This ensures Type::Adt is always created with the correct number of type args.
def fresh_type_args_for(env: &mut TypeEnv, td: &TypeDef) -> Vec[Type]
  var args = Vec::new()
  var i = 0
  while i < td.generic_params.len() do
    args.push(fresh_type_var(env))
    i = i + 1
  end
  args
end

# Convert a TypeDef to its Type representation.
# For primitives (Int, String, etc.) this returns the canonical Type variant.
# For user-defined types (structs, enums) and every builtin compound
# (Option/Slice/Array/Map/Set/Box/Rc/Vec — all registered), this returns
# the Adt form Type::Adt(<builtin TypeId>, args) with fresh type args; the
# canonical compound variants no longer exist (type representation
# collapse).
def type_def_to_canonical(env: &mut TypeEnv, td: &TypeDef) -> Type
  let name = td.name
  if name == "Unit" then Type::Unit
  elsif name == "Bool" then Type::Bool
  elsif name == "Int" then Type::Int
  elsif name == "UInt" then Type::UInt
  elsif name == "Float" then Type::Float
  elsif name == "Char" then Type::Char
  elsif name == "String" then Type::String
  elsif name == "Never" then Type::Never
  elsif name == "I8" then Type::I8
  elsif name == "I16" then Type::I16
  elsif name == "I32" then Type::I32
  elsif name == "I64" then Type::I64
  elsif name == "I128" then Type::I128
  elsif name == "U8" then Type::U8
  elsif name == "U16" then Type::U16
  elsif name == "U32" then Type::U32
  elsif name == "U64" then Type::U64
  elsif name == "U128" then Type::U128
  elsif name == "ISize" then Type::ISize
  elsif name == "USize" then Type::USize
  elsif name == "F32" then Type::F32
  elsif name == "F64" then Type::F64
  elsif name == "Option" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Option".to_string(), args)
    else builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Result" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 2 then builtin_adt(env, "Result".to_string(), args)
    else builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
    end
  elsif name == "Slice" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Slice".to_string(), args)
    else builtin_adt(env, "Slice".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Array" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Array".to_string(), args)
    else builtin_adt(env, "Array".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Map" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 2 then builtin_adt(env, "Map".to_string(), args)
    else builtin_adt(env, "Map".to_string(), [fresh_type_var(env), fresh_type_var(env)])
    end
  elsif name == "Set" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Set".to_string(), args)
    else builtin_adt(env, "Set".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Ptr" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then Type::Ptr(args[0])
    else Type::Ptr(fresh_type_var(env))
    end
  elsif name == "PtrMut" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then Type::PtrMut(args[0])
    else Type::PtrMut(fresh_type_var(env))
    end
  elsif name == "Box" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Box".to_string(), args)
    else builtin_adt(env, "Box".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Rc" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Rc".to_string(), args)
    else builtin_adt(env, "Rc".to_string(), [fresh_type_var(env)])
    end
  else
    Type::Adt(td.id, fresh_type_args_for(env, td))
  end
end

# ———————————————————————————————————————————————————————————————
# Type representation collapse (P0-K): the DUAL representation is gone.
#
# The canonical Type variants (Type::Option, Type::Result, Type::Map,
# Type::Set, Type::Box, Type::Rc, Type::Array, Type::Slice) were REMOVED
# from the Type enum. The Adt form Type::Adt(TypeId, Vec[Type]) is the ONE
# representation of every nominal type, builtin or user-defined; the
# LangItems ids (option/result/vec/map/set/box_/rc/array/slice) select the
# builtin special behaviors. builtin_adt below is the single construction
# helper (it resolves the registered LangItems TypeId by name and
# constructs Type::Adt directly — the canonical-variant fallback is gone).
# normalize_adt_for_unify retains only the NON-canonical normalizations at
# unify's entry (aliases, primitive spellings, Ref/RefMut/Ptr unwrapping,
# the Rc-of-resource policy, the id-0 placeholder guard) — the Adt forms
# pass through unchanged. NOTE: the heap-vector Array Adt carries no size
# (its identity is the element); the fixed-array size lives in the DISTINCT
# Type::FixedArray(elem, n) variant built from the [T; N] annotation.
# ———————————————————————————————————————————————————————————————

# The Adt form for a builtin compound type:
# Type::Adt(<the registered LangItems TypeId for `name`>, args).
# Registration verification is part of the contract: the id must exist via
# type_name_index. All nine names (Option/Result/Vec/Map/Set/Box/Rc/Array/
# Slice) are registered builtins (init_type_env), so the lookup succeeds;
# an unverifiable name fails CLOSED with Type::Error — a Type::Adt with an
# unverifiable id is never produced. The resolved id is exactly the
# LangItems id (build_lang_items reads the same type_name_index).
def builtin_adt(env: &TypeEnv, name: String, args: Vec[Type]) -> Type
  match get_type_id_by_name(env, name.clone())
  when Option::Some(tid) then
    Type::Adt(tid, args)
  when Option::None then
    Type::Error
  end
end

# Normalize an Adt before unification: resolve type ALIASES to their
# underlying type, map the Named primitive spellings (c-FFI aliases,
# capitalizations) to the canonical primitive variants, unwrap the
# Ref/RefMut alias names to their payload, map Ptr/PtrMut names to the
# pointer variants, enforce the Rc-of-resource policy, and guard the
# bogus id-0 placeholder. The builtin compound names are NOT normalized
# (their Adt form IS the representation — the canonical variants no
# longer exist); they pass through unchanged.
def normalize_adt_for_unify(env: &mut TypeEnv, ty: Type) -> Type
  # Check if ty is an Adt and find its TypeDef by scanning type_list
  # (inlined to avoid &mut -> & reborrow issues)
  var adt_id: Option[TypeId] = Option::None
  var adt_args: Vec[Type] = Vec::new()
  match ty
  when Type::Adt(id, args) then
    adt_id = Option::Some(id)
    # Copy args for later use (args is borrowed from ty)
    var i = 0
    while i < args.len() do
      adt_args.push(args[i].clone())
      i = i + 1
    end
  when _ then
    return ty
  end
  # Only reach here if ty is Type::Adt
  let id = match adt_id when Option::Some(i) then i when Option::None then return ty end
  # Look up the TypeDef via the O(1) id index
  match env.type_id_index.get(id.id)
  when Option::Some(idx) then
    let td = env.type_list[idx]
    let name = td.name
      # Type aliases resolve to their underlying type: typealias Signal = Int.
      match td.def_kind
      when TypeDefKind::Alias(inner) then
        return subst_type_args(&inner, &td.generic_params, &adt_args)
      when _ then ()
      end
      if name == "Unit" || name == "Nil" then return Type::Unit
      elsif name == "Bool" then return Type::Bool
      elsif name == "Int" || name == "c_int" then return Type::Int
      elsif name == "UInt" || name == "c_uint" then return Type::UInt
      elsif name == "Float" then return Type::Float
      elsif name == "Char" then return Type::Char
      elsif name == "String" || name == "str" then return Type::String
      elsif name == "Never" then return Type::Never
      elsif name == "I8" || name == "Int8" || name == "i8" then return Type::I8
      elsif name == "I16" || name == "Int16" || name == "i16" then return Type::I16
      elsif name == "I32" || name == "Int32" || name == "i32" then return Type::I32
      elsif name == "I64" || name == "Int64" || name == "i64" || name == "c_long" then return Type::I64
      elsif name == "I128" || name == "Int128" || name == "i128" then return Type::I128
      elsif name == "U8" || name == "UInt8" || name == "u8" || name == "c_char" then return Type::U8
      elsif name == "U16" || name == "UInt16" || name == "u16" then return Type::U16
      elsif name == "U32" || name == "UInt32" || name == "u32" then return Type::U32
      elsif name == "U64" || name == "UInt64" || name == "u64" || name == "c_ulong" then return Type::U64
      elsif name == "U128" || name == "UInt128" || name == "u128" then return Type::U128
      elsif name == "ISize" || name == "isize" then return Type::ISize
      elsif name == "USize" || name == "usize" then return Type::USize
      elsif name == "F32" || name == "f32" || name == "c_float" then return Type::F32
      elsif name == "F64" || name == "f64" || name == "c_double" then return Type::F64
      elsif name == "Ref" then
        if adt_args.len() >= 1 then return adt_args[0].clone()
        else return fresh_type_var(env)
        end
      elsif name == "RefMut" then
        if adt_args.len() >= 1 then return adt_args[0].clone()
        else return fresh_type_var(env)
        end
      elsif name == "Ptr" then
        if adt_args.len() >= 1 then return Type::Ptr(adt_args[0].clone())
        else return Type::Ptr(fresh_type_var(env))
        end
      elsif name == "PtrMut" then
        if adt_args.len() >= 1 then return Type::PtrMut(adt_args[0].clone())
        else return Type::PtrMut(fresh_type_var(env))
        end
      elsif name == "Rc" then
        # Rc[Resource] is an unsupported combination (documented ownership
        # policy): a linear resource cannot become shared ownership through
        # reference counting. Reject at the type annotation so the policy is
        # enforced, not just documented (the resource checker re-rejects any
        # bound Rc-of-resource at bind time). NOTE: this function has no span
        # parameter — use a zero span for the diagnostic.
        if adt_args.len() >= 1 then
          if type_has_resource_kind(env, &adt_args[0]) then
            type_add_error(env, "Rc[Resource] is unsupported: a linear resource cannot be shared through reference counting", Span { file: "", start: 0, end_pos: 0 })
          end
        end
        ty
      else
        # Check for common aliases that behave like canonical types
        if name == "c_void" then return Type::Unit
        else
          return ty  # Keep as Adt for user-defined types and builtin compounds
        end
      end
  when Option::None then
    # An Adt whose TypeId could not be resolved to a real TypeDef is a
    # bogus/placeholder type (e.g. TypeId{id:0}). Returning it as-is
    # propagates that unsound placeholder into unification and can make
    # unrelated types compare equal. Convert it to the Error type so it is
    # rejected loudly rather than silently accepted. Genuinely user-defined
    # Adt types that simply are not in type_list yet keep their identity.
    if id.id == 0 then
      Type::Error
    else
      ty
    end
  end
end

# Substitute generic type parameters with concrete type arguments in a type.
# For example, if generic_params=[id(T)] and type_args=[Type::Int],
# then Type::Param(id(T)) becomes Type::Int in the given type. P0-GPI:
# the parameters are GenericParamIds — the substitution matches by id
# (generic_param_id_numeric), positionally aligned with the declaration
# order of the callee's parameter list.
def subst_type_args(ty: &Type, generic_params: &Vec[GenericParamId], type_args: &Vec[Type]) -> Type
  match ty
  when Type::Param(gpid) then
    var i = 0
    while i < generic_params.len() do
      if generic_param_id_eq(&generic_params[i], &gpid) then
        return type_args[i].clone()
      end
      i = i + 1
    end
    ty.clone()
  when Type::Adt(tid, args) then
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(subst_type_args(&args[i], generic_params, type_args))
      i = i + 1
    end
    Type::Adt(tid, new_args)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(subst_type_args(inner, generic_params, type_args), mutable)
  when Type::Ptr(inner) then Type::Ptr(subst_type_args(inner, generic_params, type_args))
  when Type::PtrMut(inner) then Type::PtrMut(subst_type_args(inner, generic_params, type_args))
  when Type::Tuple(fields) then
    var new_fields = Vec::new()
    var i = 0
    while i < fields.len() do
      new_fields.push(subst_type_args(&fields[i], generic_params, type_args))
      i = i + 1
    end
    Type::Tuple(new_fields)
  when Type::FixedArray(elem, n) then Type::FixedArray(subst_type_args(&elem, generic_params, type_args), n)
  when Type::Function(params, ret) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: subst_type_args(&pt.ty, generic_params, type_args), convention: pt.convention })
      i = i + 1
    end
    Type::Function(new_params, subst_type_args(ret, generic_params, type_args))
  when Type::Effect(_, inner) then Type::Effect(Vec::new(), subst_type_args(inner, generic_params, type_args))
  when _ then ty.clone()
  end
end

def resolve_type_var(env: &TypeEnv, ty: Type) -> Type
  match ty
  when Type::Var(id) then
    match env.subst.get(id)
    when Option::Some(resolved) then
      resolve_type_var(env, resolved)
    when Option::None then ty
    end
  # Recurse into compound types for full resolution
  when Type::RefInternal(inner, mutable) then Type::RefInternal(resolve_type_var(env, inner), mutable)
  when Type::Tuple(fields) then
    # P0-IT: the by-value array iterator (ArrayIterator / .iter()) is
    # Copy-only and explicitly unsafe; the projected for-loop is the primary
    # collection iteration. Resolve each field through the loop and collect
    # the resolved fields.
    var resolved_fields = Vec::new()
    for f in fields do
      resolved_fields.push(resolve_type_var(env, f))
    end
    Type::Tuple(resolved_fields)
  when Type::Function(params, ret) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: resolve_type_var(env, pt.ty), convention: pt.convention })
      i = i + 1
    end
    Type::Function(new_params, resolve_type_var(env, ret))
  when Type::Adt(tid, args) then
    # P0-IT: the by-value array iterator is Copy-only and explicitly unsafe;
    # the projected for-loop is the primary collection iteration. Resolve
    # each type argument through the loop and collect the resolved list.
    var resolved_args = Vec::new()
    for a in args do
      resolved_args.push(resolve_type_var(env, a))
    end
    Type::Adt(tid, resolved_args)
  when Type::FixedArray(elem, n) then Type::FixedArray(resolve_type_var(env, elem), n)
  when _ then ty
  end
end

# Chase only the root type variable (no recursive compound reconstruction).
# Path-compresses the substitution chain so repeated lookups are O(1).
def prune_var(env: &mut TypeEnv, ty: Type) -> Type
  match ty
  when Type::Var(id) then
    match env.subst.get(id)
    when Option::Some(resolved) then
      let root = prune_var(env, resolved)
      env.subst.insert(id, root.clone())
      root
    when Option::None then ty
    end
  when _ then ty
  end
end

# ———————————————————————————————————————————————————————————————
# Unification
# ———————————————————————————————————————————————————————————————

def type_tag(env: &TypeEnv, t: &Type) -> String
  match t
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::Never then "Never"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::I128 then "I128"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::U128 then "U128"
  when Type::ISize then "ISize"
  when Type::USize then "USize"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::Adt(id, args) then
    # The Adt form of a builtin compound type tags as the builtin name (the
    # LangItems TypeId selects the builtin identity); user-defined and
    # non-builtin Adt types keep the id-based tag.
    if id.id == env.lang_items.option && args.len() >= 1 then "Option"
    elsif id.id == env.lang_items.result && args.len() >= 2 then "Result"
    elsif id.id == env.lang_items.map && args.len() >= 2 then "Map"
    elsif id.id == env.lang_items.set && args.len() >= 1 then "Set"
    elsif id.id == env.lang_items.slice && args.len() >= 1 then "Slice"
    elsif id.id == env.lang_items.array && args.len() >= 1 then "Array"
    elsif id.id == env.lang_items.box_ && args.len() >= 1 then "Box"
    elsif id.id == env.lang_items.rc && args.len() >= 1 then "Rc"
    else "Named#" + id.id.to_string()
    end
  when Type::FixedArray(elem, n) then "FixedArray[" + type_tag(env, &elem) + ";" + n.to_string() + "]"
  when Type::Function(_, _) then "Function"
  when Type::RefInternal(_, _) then "RefInternal"
  when Type::Ptr(_) then "Ptr"
  when Type::PtrMut(_) then "PtrMut"
  when Type::Dyn(_) then "Dyn"
  when Type::Effect(_, _) then "Effect"
  when Type::Tuple(_) then "Tuple"
  when Type::Var(_) then "Var"
  when Type::Param(gpid) then "Param(" + generic_param_name_of(&env.generic_param_table, &gpid) + ")"
  when Type::Error then "Error"
  end
end

# True for the `Int` type that integer literals produce.
def is_int_literal_type(ty: &Type) -> Bool
  match ty
  when Type::Int then true
  when _ then false
  end
end

# True for any concrete integer type.
def is_integer_type(ty: &Type) -> Bool
  match ty
  when Type::Int then true
  when Type::UInt then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when _ then false
  end
end

# True for the Box type (the Adt form of the registered Box id).
def is_box_type(env: &TypeEnv, ty: &Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then true else false end
  when _ then false
  end
end

def box_inner_type(env: &TypeEnv, ty: &Type) -> Type
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else ty.clone() end
  when _ then ty.clone()
  end
end

# True for the String type.
def is_string_type(ty: &Type) -> Bool
  match ty
  when Type::String then true
  when _ then false
  end
end

# True for the Never (bottom) type.
def is_never_type(ty: &Type) -> Bool
  match ty
  when Type::Never then true
  when _ then false
  end
end

# True for a generic parameter reference (e.g. T in `def f[T](x: T)`).
def is_param_type(ty: &Type) -> Bool
  match ty
  when Type::Param(_) then true
  when _ then false
  end
end

# True for an empty tuple (the `()` type).
def is_empty_tuple(ty: &Type) -> Bool
  match ty
  when Type::Tuple(fields) then fields.is_empty()
  when _ then false
  end
end

# True for the Unit type.
def is_unit_type(ty: &Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end
end

# True for Slice/Vec/Array (element containers interchangeable in the checker).
# The Adt forms of the slice-like builtins (LangItems slice/array/vec ids)
# are slice-like; Vec is a registered Adt type matched by LangItems id.
def is_slice_like(env: &TypeEnv, ty: &Type) -> Bool
  match ty
  when Type::Adt(tid, _) then
    if tid.id == env.lang_items.vec || tid.id == env.lang_items.slice || tid.id == env.lang_items.array then true else false end
  when _ then false
  end
end

def slice_inner(env: &TypeEnv, ty: &Type) -> Type
  match ty
  when Type::Adt(tid, args) then
    # Only the slice-like builtin ids (and Vec) yield their element; the
    # Option/Result/Map/Set/Box/Rc Adt forms keep their identity. Other Adt
    # types keep the pre-existing arg-based fallback.
    if tid.id == env.lang_items.slice || tid.id == env.lang_items.array || tid.id == env.lang_items.vec then
      if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
    elsif tid.id == env.lang_items.option || tid.id == env.lang_items.result || tid.id == env.lang_items.map || tid.id == env.lang_items.set || tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc then
      ty.clone()
    else
      if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
    end
  when _ then ty.clone()
  end
end

# True for raw pointer types.
def is_ptr_type(ty: &Type) -> Bool
  match ty
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end
end

def ptr_inner(ty: &Type) -> Type
  match ty
  when Type::Ptr(e) then e
  when Type::PtrMut(e) then e
  when _ then ty.clone()
  end
end

def is_ref_type(ty: &Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end
end

def ref_inner_type(ty: &Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner
  when _ then ty.clone()
  end
end

def unify(env: &mut TypeEnv, t1: Type, t2: Type, span: Span) -> Bool
  let a_raw = prune_var(env, t1)
  let b_raw = prune_var(env, t2)
  # Normalize Adt forms before matching (aliases, primitive spellings,
  # Ref/RefMut/Ptr unwrapping, the Rc-of-resource policy, the id-0 guard).
  # The builtin compounds pass through unchanged — the Adt form IS the
  # representation (the canonical variants no longer exist).
  let a = normalize_adt_for_unify(env, a_raw)
  let b = normalize_adt_for_unify(env, b_raw)

  # Integer literal coercion: a Type::Int (from an integer literal) is compatible
  # with any concrete integer type (UInt, i8..u128, isize/usize). Without this,
  # `align: UInt - 1` fails because the literal is Int. Same-type integers still
  # fall through to the exact-match arms below.
  if (is_int_literal_type(&a) && is_integer_type(&b)) ||
     (is_int_literal_type(&b) && is_integer_type(&a)) then
    true
  elsif is_never_type(&a) || is_never_type(&b) then
    # Never is the bottom type: it unifies with any type.
    true
  elsif (is_empty_tuple(&a) && is_unit_type(&b)) || (is_empty_tuple(&b) && is_unit_type(&a)) then
    # An empty tuple `()` is the Unit type.
    true
  else
    match a
  when Type::Var(id1) then
    match b
    when Type::Var(id2) then
      if id1.id == id2.id then
        true
      else
        # Already-bound vars must re-unify with their binding rather than be
        # overwritten: the binding carries the resolved structure.
        match env.subst.get(id1)
        when Option::Some(bound) then unify(env, bound, b, span)
        when Option::None then
          match env.subst.get(id2)
          when Option::Some(bound2) then unify(env, a, bound2, span)
          when Option::None then
            env.subst.insert(id1, b)
            true
          end
        end
      end
    when _ then
      match env.subst.get(id1)
      when Option::Some(bound) then unify(env, bound, b, span)
      when Option::None then
        if occurs_check(env, id1, b, span.clone()) then
          type_add_error(env, "infinite type", span)
          false
        else
          env.subst.insert(id1, b)
          true
        end
      end
    end
  when _ then
    match b
    when Type::Var(id2) then
      match env.subst.get(id2)
      when Option::Some(bound2) then unify(env, a, bound2, span)
      when Option::None then
        if occurs_check(env, id2, a, span.clone()) then
          type_add_error(env, "infinite type", span)
          false
        else
          env.subst.insert(id2, a)
          true
        end
      end
    when _ then
      match a
      when Type::Unit then match b when Type::Unit then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Bool then match b when Type::Bool then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Int then match b when Type::Int then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::UInt then match b when Type::UInt then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Float then match b when Type::Float then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Char then match b when Type::Char then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::String then match b when Type::String then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I8 then match b when Type::I8 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I16 then match b when Type::I16 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I32 then match b when Type::I32 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I64 then match b when Type::I64 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I128 then match b when Type::I128 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U8 then match b when Type::U8 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U16 then match b when Type::U16 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U32 then match b when Type::U32 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U64 then match b when Type::U64 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U128 then match b when Type::U128 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::ISize then match b when Type::ISize then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::USize then match b when Type::USize then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Never then true
      when Type::Adt(id1, args1) then
        match b
        when Type::Adt(id2, args2) then
          if id1.id != id2.id then
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          elsif args1.len() != args2.len() then
            # Permissive: unify common args, skip mismatch error
            var ok = true
            var i = 0
            let min_len = if args1.len() < args2.len() then args1.len() else args2.len() end
            while i < min_len do
              if !unify(env, args1[i], args2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          else
            var ok = true
            var i = 0
            while i < args1.len() do
              if !unify(env, args1[i], args2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        # Handle Adt(tid, args) unified with primitive types (Int, U64, String, etc.)
        # Occurs when resolve_type_expr or other code creates Adt types for primitives.
        when Type::Unit then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Unit" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Bool then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Bool" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Int then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "Int" || td.name == "c_int") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::UInt then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "UInt" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Float then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Float" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Char then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Char" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::String then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "String" || td.name == "str") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Never then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Never" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::FixedArray(elem2, n2) then
          # Literal-bridge: the heap-vector Adt Array form (the array
          # literal's own type) unifies with a FixedArray annotation by
          # element; the count is enforced at the literal's MIR destination.
          if id1.id == env.lang_items.array && args1.len() >= 1 then
            unify(env, args1[0], elem2, span)
          else
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          end
        when Type::I8 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I8" || td.name == "Int8" || td.name == "i8") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I16 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I16" || td.name == "Int16" || td.name == "i16") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I32" || td.name == "Int32" || td.name == "i32") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I64" || td.name == "Int64" || td.name == "i64" || td.name == "c_long") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I128 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I128" || td.name == "Int128" || td.name == "i128") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U8 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U8" || td.name == "UInt8" || td.name == "u8" || td.name == "c_char") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U16 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U16" || td.name == "UInt16" || td.name == "u16") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U32" || td.name == "UInt32" || td.name == "u32") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U64" || td.name == "UInt64" || td.name == "u64" || td.name == "c_ulong") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U128 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U128" || td.name == "UInt128" || td.name == "u128") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::ISize then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "ISize" || td.name == "isize") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::USize then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "USize" || td.name == "usize") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::F32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "F32" || td.name == "f32" || td.name == "c_float") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::F64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "F64" || td.name == "f64" || td.name == "c_double") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        # Handle Named(tid, args) unified with Function type.
        when Type::Function(params2, ret2) then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Fn" then
              # Fn types in Named form have args matching the function params + ret.
              # The last type arg is the return type, so the parameter arity is
              # args1.len() - 1, and it must match the function type's arity
              # exactly (see the Function-vs-Function arm above).
              if args1.len() == 0 then true
              elsif args1.len() - 1 != params2.len() then
                type_add_error(env, "function arity mismatch: cannot unify Fn type with " +
                  (args1.len() - 1).to_string() + " parameters and function type with " +
                  params2.len().to_string() + " parameters", span)
                false
              else
                var ok = true
                var i = 0
                while i < params2.len() do
                  if !unify(env, args1[i], params2[i].ty, span) then
                    ok = false
                  end
                  i = i + 1
                end
                if ok then
                  let ret_idx = args1.len() - 1
                  unify(env, args1[ret_idx], ret2, span)
                else
                  false
                end
              end
            else
              type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
              false
            end
          when Option::None then
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          end
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Function(params1, ret1) then
        match b
        when Type::Function(params2, ret2) then
          # Arity must match EXACTLY: a callable with a different parameter
          # count is a different type. Function types carry ownership
          # conventions per parameter, and higher-order calls bind arguments
          # positionally, so unifying only the common prefix would let a
          # fn(Int) -> Int unify with fn(Int, String) -> Int and produce
          # unsound callable substitution (too many / too few arguments
          # silently accepted at the call site).
          if params1.len() != params2.len() then
            type_add_error(env, "function arity mismatch: cannot unify " +
              params1.len().to_string() + "-parameter and " +
              params2.len().to_string() + "-parameter function types", span)
            false
          else
            var ok = true
            var i = 0
            while i < params1.len() do
              if !(params1[i].convention == params2[i].convention) then
                ok = false
              end
              if !unify(env, params1[i].ty, params2[i].ty, span) then
                ok = false
              end
              i = i + 1
            end
            if ok then unify(env, ret1, ret2, span) else false end
          end
        when Type::Error then true
        when Type::Param(_) then
          type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
          false
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Tuple(elems1) then
        match b
        when Type::Tuple(elems2) then
          if elems1.len() != elems2.len() then
            type_add_error(env, "tuple length mismatch", span)
            false
          else
            var ok = true
            var i = 0
            while i < elems1.len() do
              if !unify(env, elems1[i], elems2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::RefInternal(t_inner1, mut1) then
        match b
        when Type::RefInternal(t_inner2, mut2) then
          if !(mut1 == mut2) then
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          else
            unify(env, t_inner1, t_inner2, span)
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Ptr(t_inner1) then
        match b
        when Type::Ptr(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::PtrMut(t_inner1) then
        match b
        when Type::PtrMut(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Dyn(id1) then
        match b
        when Type::Dyn(id2) then
          if id1.id == id2.id then true
          else
            type_add_error(env, "trait object type mismatch", span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Effect(effs1, t_inner1) then
        match b
        when Type::Effect(effs2, t_inner2) then
          if effs1.len() != effs2.len() then
            type_add_error(env, "effect set mismatch", span)
            false
          else
            var effects_match = true
            var i = 0
            while i < effs1.len() do
              if effs1[i] != effs2[i] then
                effects_match = false
              end
              i = i + 1
            end
            if !effects_match then
              type_add_error(env, "effect set mismatch", span)
              false
            else
              unify(env, t_inner1, t_inner2, span)
            end
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Param(gpid1) then
        match b
        when Type::Param(gpid2) then
          if generic_param_id_eq(&gpid1, &gpid2) then
            true
          else
            let n1 = generic_param_name_of(&env.generic_param_table, &gpid1)
            let n2 = generic_param_name_of(&env.generic_param_table, &gpid2)
            type_add_error(env, "type parameter mismatch: " + n1 + " vs " + n2, span)
            false
          end
        when Type::Error then true
        when Type::Var(id2) then
          # A generic parameter unifies with an inference variable only by
          # binding the variable to the parameter (the parameter's own
          # instantiated InferVar): the two denote the same unresolved
          # entity. An already-bound variable must re-unify with its
          # binding, which under strict rules only accepts the same
          # parameter.
          match env.subst.get(id2)
          when Option::Some(bound2) then unify(env, a, bound2, span)
          when Option::None then
            if occurs_check(env, id2, a, span.clone()) then
              type_add_error(env, "infinite type", span)
              false
            else
              env.subst.insert(id2, a)
              true
            end
          end
        when _ then
          # STRICT: a generic parameter never matches an arbitrary concrete
          # type — each occurrence of T must resolve to the SAME instantiated
          # type, decided at the generic call site, never here.
          let n1 = generic_param_name_of(&env.generic_param_table, &gpid1)
          type_add_error(env, "type parameter `" + n1 + "` cannot unify with " + type_tag(env, &b), span)
          false
        end
      when Type::FixedArray(elem1, n1) then
        match b
        when Type::FixedArray(elem2, n2) then
          # The count is part of the fixed-array type identity: lengths must
          # match exactly, then the elements unify.
          if n1 != n2 then
            type_add_error(env, "fixed array length mismatch: " + n1.to_string() + " vs " + n2.to_string(), span)
            false
          else
            unify(env, elem1, elem2, span)
          end
        when Type::Adt(array_id, args) then
          # Literal-bridge: an array literal (the heap-vector Adt form) may
          # initialize a FixedArray annotation; the count is enforced at the
          # literal's MIR destination.
          if array_id.id == env.lang_items.array && args.len() >= 1 then
            unify(env, elem1, args[0], span)
          else
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Error then true
      end
    end
  end
  end
end

def occurs_check(env: &mut TypeEnv, id: TypeVarId, ty: Type, span: Span) -> Bool
  # Use depth limit to prevent stack overflow on deeply recursive types
  occurs_check_with_depth(env, id, ty, 0, span)
end

# Maximum recursion depth for type checking (prevents stack overflow)
def MAX_TYPE_DEPTH() -> Int = 100

def occurs_check_with_depth(env: &mut TypeEnv, id: TypeVarId, ty: Type, depth: Int, span: Span) -> Bool
  # Guard against infinite recursion
  if depth > MAX_TYPE_DEPTH() then
    type_add_error(env, "type recursion depth exceeded in occurs check", span)
    return true
  end
  
  match ty
  when Type::Var(other_id) then
    if id.id == other_id.id then
      true
    else
      # Chase bound variables without reconstructing the type tree.
      match env.subst.get(other_id)
      when Option::Some(bound) then occurs_check_with_depth(env, id, bound, depth + 1, span)
      when Option::None then false
      end
    end
  when Type::Adt(_, args) then
    var found = false
    for arg in args do
      if occurs_check_with_depth(env, id, arg, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::Function(params, ret) then
    var found = false
    for p in params do
      if occurs_check_with_depth(env, id, p.ty, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    if !found then
      found = occurs_check_with_depth(env, id, ret, depth + 1, span)
    end
    found
  when Type::RefInternal(inner, _) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if occurs_check_with_depth(env, id, e, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::FixedArray(elem, _) then occurs_check_with_depth(env, id, elem, depth + 1, span)
  when _ then false
  end
end


def type_add_error(env: &mut TypeEnv, msg: String, span: Span) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::None })












end

def add_warning(env: &mut TypeEnv, msg: String, span: Span) -> Unit
  env.warnings.push(TypeError { message: msg, span: span, code: Option::None })
end

def add_error_with_code(env: &mut TypeEnv, msg: String, span: Span, code: String) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::Some(code) })
end

# Stable error codes for type checking:
#   E0200 — Type mismatch
#   E0201 — Cannot unify types (occurs check failed)
#   E0202 — Expected type, found expression
#   E0203 — Undefined type
#   E0204 — Undefined variable
#   E0205 — Undefined function
#   E0206 — Argument count mismatch
#   E0207 — Cannot call non-function
#   E0208 — Cannot index non-array
#   E0209 — Cannot access field on non-struct
#   E0210 — Undefined field
#   E0211 — Pattern type mismatch
#   E0212 — Cannot infer type
#   E0213 — Generic argument count mismatch
#   E0214 — Conflicting implementations
#   E0215 — Trait not implemented
#   E0216 — Ambiguous method call
#   E0217 — Return type mismatch
#   E0218 — Condition must be Bool
#   E0219 — Loop condition must be Bool
#   E0277 — Trait bound not satisfied (Send/Sync)

# ———————————————————————————————————————————————————————————————
# Type Checking
# ———————————————————————————————————————————————————————————————

def type_check_program_env(env: &mut TypeEnv, program: &Program) -> Unit
  push_scope(env)

  # P0-A (next layer): each item is processed under its owner module path
  # (Program.crate — see module_path_of_item), threaded into type
  # registration and into the current-module context used by the
  # bare-name ambiguity verification and local-module shadowing.
  env.check_ctx = "pass1-pre-register"
  var module_ptr = 0
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    pre_register_type_name(env, item, &owner_path)
    i = i + 1
  end
  env.check_ctx = "pass2-collect"
  module_ptr = 0
  i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    collect_type_def(env, item, &owner_path)
    i = i + 1
  end
  # Concrete ownership is NOT propagated into the nominal TypeKind: the
  # TypeProperties engine (type_properties_of, keyed by (TypeId,
  # substitutions)) computes per-instantiation needs_drop/linearity on
  # demand. TypeDef.kind remains the DECLARED kind (Resource/Capability
  # markers only).

  env.check_ctx = "pass3-register"
  module_ptr = 0
  i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    match item.kind
    when ItemKind::ItemFunction(f) then
      # Register generic type parameters in scope for function signature
      # resolution. P0-GPI: the function interns its generic parameters in
      # declaration order under its item DefId (item_owner_def) — the
      # GenericParamId order IS the declaration order (the substs-order
      # contract); pass 4's check_function reconstructs the same ids from
      # (owner, index) and never re-interns.
      push_scope(env)
      let f_owner = item_owner_def(env, i)
      let f_param_ids = intern_generic_params(env, &f_owner, &f.generic_params)
      var gp_idx = 0
      while gp_idx < f.generic_params.len() do
        bind_var(env, f.generic_params[gp_idx].name.clone(), Type::Param(f_param_ids[gp_idx].clone()))
        gp_idx = gp_idx + 1
      end
      var param_types = Vec::new()
      var j = 0
      while j < f.params.len() do
        let p = f.params[j]
        let resolved_ty = match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
        param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
        j = j + 1
      end
      let ret_ty = match f.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      pop_scope(env)
      let fn_ty = Type::Function(param_types, ret_ty)
      bind_var(env, f.name.clone(), fn_ty.clone())
      record_module_callable(env, f.name.clone(), fn_ty, &owner_path, DefKind::Function)
    when ItemKind::ItemExternBlock(ext) then
      var j = 0
      while j < ext.items.len() do
        let ext_item = ext.items[j]
        match ext_item
        when ExternItem::Function(ef) then
          # Register generic type parameters in scope for extern function
          # signature resolution. P0-GPI: extern functions have no resolver
          # DefId (item_owner_def's module -2 fallback — deterministic per
          # item); the interning happens ONCE here (pass 3 — externs are
          # signature-only and never pass-4 checked).
          push_scope(env)
          let ef_owner = item_owner_def(env, i)
          let ef_param_ids = intern_generic_params(env, &ef_owner, &ef.generic_params)
          var gp_idx = 0
          while gp_idx < ef.generic_params.len() do
            bind_var(env, ef.generic_params[gp_idx].name.clone(), Type::Param(ef_param_ids[gp_idx].clone()))
            gp_idx = gp_idx + 1
          end
          var param_types = Vec::new()
          var k = 0
          while k < ef.params.len() do
            let p = ef.params[k]
            let resolved_ty = match p.ty
            when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
            when Option::None then fresh_type_var(env)
            end
            param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
            k = k + 1
          end
          let ret_ty = match ef.ret_type
          when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
          when Option::None then Type::Unit
          end
          pop_scope(env)
          let ext_fn_ty = Type::Function(param_types, ret_ty)
          bind_var(env, ef.name.clone(), ext_fn_ty.clone())
          record_module_callable(env, ef.name.clone(), ext_fn_ty, &owner_path, DefKind::Function)
        when _ then ()
        end
        j = j + 1
      end
    when ItemKind::ItemConst(c) then
      # Register const names as variables so they can be looked up by ExprIdent
      let const_ty = match c.ty
      when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
      when Option::None then fresh_type_var(env)
      end
      bind_var(env, c.name.clone(), const_ty.clone())
      record_module_callable(env, c.name.clone(), const_ty, &owner_path, DefKind::Constant)
    when ItemKind::ItemStatic(s) then
      # Register static (and mut) variable names so they can be looked up by ExprIdent
      let static_ty = resolve_type_expr(env, &s.ty)
      bind_var(env, s.name.clone(), static_ty.clone())
      record_module_callable(env, s.name.clone(), static_ty, &owner_path, DefKind::Static)
    when _ then ()
    end
    i = i + 1
  end
  i = 0
  env.check_ctx = "pass4-check"
  module_ptr = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    # P0-A (final layer): thread the current module path into body checking
    # too (the previous layer threaded passes 1-3) so the bare-name callable
    # identity check during pass 4 resolves the CURRENT module's own
    # definition (the stale path left by pass 3 would break local-module
    # shadowing for body references).
    env.current_module_path = owner_path.clone()
    check_item(env, program, item, i)
    i = i + 1
  end
  
  pop_scope(env)
end

def pre_register_type_name(env: &mut TypeEnv, item: &Item, module_path: &Vec[String]) -> Unit
  match item.kind
  when ItemKind::ItemStruct(s) then
    if !env.type_name_index.contains_key(s.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: s.name,
        def_kind: TypeDefKind::Struct(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
      }
      env.type_name_index.insert(s.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
      # P0-A (next layer): record the module-qualified entry alongside the
      # bare first-wins placeholder so pass-1 forward references to
      # "path::name" resolve before pass 2. Second-module definitions of an
      # already-registered bare name are resolved entirely in pass 2 by
      # store_type_def (P0-BT: every declaration is its own type — an
      # identical re-declaration in a different module gets its own fresh
      # TypeId under its qualified key; only same-module re-registration
      # shares the first-wins TypeId).
      record_module_type_name(env, s.name.clone(), env.type_list.len() - 1, module_path)
    end
  when ItemKind::ItemEnum(e) then
    if !env.type_name_index.contains_key(e.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: e.name,
        def_kind: TypeDefKind::Enum(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
      }
      env.type_name_index.insert(e.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
      # P0-A (next layer): module-qualified entry for the first-wins enum.
      record_module_type_name(env, e.name.clone(), env.type_list.len() - 1, module_path)
    end
  when ItemKind::ItemTrait(t) then
    if !env.type_name_index.contains_key(t.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: t.name,
        def_kind: TypeDefKind::Trait(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
      }
      env.type_name_index.insert(t.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
      # P0-TM (module-semantic trait identity): the trait declaration
      # registers its module-qualified entry alongside the bare first-wins
      # placeholder (the DefKind::Trait module_symbols entry the resolver
      # recorded for this declaration), so pass-1 forward references to
      # "path::name" traits and the pass-2 declaration identity resolve
      # module-qualified. The bare registry entry is FIRST-WINS — an
      # existing builtin/std entry is never overwritten by a later
      # declaration.
      record_module_type_name(env, t.name.clone(), env.type_list.len() - 1, module_path)
      if !env.trait_registry.contains_key(&t.name) then
        env.trait_registry.insert(t.name.clone(), id.id)
      end
    end
  when ItemKind::ItemTypeAlias(a) then
    if !env.type_name_index.contains_key(a.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: a.name,
        def_kind: TypeDefKind::Alias(Type::Unit),
        generic_params: Vec::new(),
        kind: TypeKind::Value
      }
      env.type_name_index.insert(a.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
    end
  when ItemKind::ItemCapabilityDecl(c) then
    if !env.type_name_index.contains_key(c.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: c.name,
        def_kind: TypeDefKind::Opaque,
        generic_params: Vec::new(),
        kind: TypeKind::Capability
      }
      env.type_name_index.insert(c.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
    end
  when _ then ()
  end
end

def collect_enum_type_def(env: &mut TypeEnv, e: &EnumDecl, module_path: &Vec[String]) -> Unit
  push_scope(env)
  # P0-GPI: the enum interns its generic parameters in declaration order
  # under its DefKind::TypeName DefId (type_decl_owner_def); the variant
  # payload types reference the interned ids.
  let owner = type_decl_owner_def(env, &e.name, module_path)
  let param_ids = intern_generic_params(env, &owner, &e.generic_params)
  var gp_idx = 0
  while gp_idx < e.generic_params.len() do
    bind_var(env, e.generic_params[gp_idx].name.clone(), Type::Param(param_ids[gp_idx].clone()))
    gp_idx = gp_idx + 1
  end

  let id = match get_type_id_by_qualified_name(env, e.name.clone(), module_path)
  when Option::Some(existing_id) then existing_id
  when Option::None then
    let new_id = TypeId { id: env.type_id_counter }
    env.type_id_counter = env.type_id_counter + 1
    new_id
  end
  var variants = Vec::new()
  var disc = 0
  var i = 0
  while i < e.variants.len() do
    var ftypes = Vec::new()
    var j = 0
    while j < e.variants[i].fields.len() do
      ftypes.push(resolve_type_expr(env, &e.variants[i].fields[j]))
      j = j + 1
    end
    variants.push(VariantInfo { name: e.variants[i].name, fields: ftypes, discriminant: disc })
    disc = disc + 1
    i = i + 1
  end
  var gen_params = Vec::new()
  i = 0
  while i < e.generic_params.len() do
    gen_params.push(param_ids[i].clone())
    i = i + 1
  end

  pop_scope(env)

  # The nominal TypeKind of a declaration is the DECLARED kind only: no
  # field/variant-derived mutation here (concrete ownership is computed by
  # the TypeProperties engine keyed by (TypeId, substitutions) — see
  # type_properties_of / type_named_props).

  let td = TypeDef {
    id: id,
    name: e.name.clone(),
    def_kind: TypeDefKind::Enum(variants),
    generic_params: gen_params,
    kind: TypeKind::Value
  }
  store_type_def(env, td, e.span, module_path)
end

def collect_type_def(env: &mut TypeEnv, item: &Item, module_path: &Vec[String]) -> Unit
  let _scope_before_ctd = env.scopes.len()
  match item.kind
  when ItemKind::ItemStruct(s) then
    # INLINE push_scope to avoid &mut parameter passing bug
    let _m: Map[String, Type] = Map::new()
    env.scopes.push(_m)
    let _lm: Map[String, Int] = Map::new()
    env.local_ids.push(_lm)
    # P0-GPI: the struct interns its generic parameters in declaration
    # order under its DefKind::TypeName DefId (type_decl_owner_def); the
    # field types reference the interned ids.
    let s_owner = type_decl_owner_def(env, &s.name, module_path)
    let s_param_ids = intern_generic_params(env, &s_owner, &s.generic_params)
    var gp_idx = 0
    while gp_idx < s.generic_params.len() do
      bind_var(env, s.generic_params[gp_idx].name.clone(), Type::Param(s_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    # Reuse pre-registered ID if available
    let id = match get_type_id_by_qualified_name(env, s.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    var fields = Vec::new()
    var i = 0
    while i < s.fields.len() do
      # Indexed access avoids stage0 codegen bug where copying a FieldDecl
      # out of the Vec produces a corrupted TypeExpr payload.
      let ty = resolve_type_expr(env, &s.fields[i].ty)
      fields.push(FieldInfo { name: s.fields[i].name, ty: ty, is_public: true })
      i = i + 1
    end
    var struct_kind = match s.kind
    when NominalKind::Resource then TypeKind::Resource
    when NominalKind::Value then TypeKind::Value
    end
    # NO field-derived kind mutation: the nominal TypeKind is the DECLARED
    # kind only. A struct's ownership/linearity for a concrete instantiation
    # is computed by the TypeProperties engine (type_properties_of walks the
    # fields/variants with the concrete args substituted).
    var gen_params = Vec::new()
    i = 0
    while i < s.generic_params.len() do
      gen_params.push(s_param_ids[i].clone())
      i = i + 1
    end

    # INLINE pop_scope
    env.scopes.pop()
    env.local_ids.pop()

    let td = TypeDef {
      id: id,
      name: s.name.clone(),
      def_kind: TypeDefKind::Struct(fields),
      generic_params: gen_params,
      kind: struct_kind
    }
    store_type_def(env, td, s.span, module_path)
  when ItemKind::ItemEnum(e) then
    # store_type_def rejects duplicate definitions; same-named DISTINCT types
    # across modules are no longer merged (P0-A).
    collect_enum_type_def(env, e, module_path)
  when ItemKind::ItemTrait(t) then
    # Register trait-level generic type parameters in scope so resolve_type_expr
    # can find them when processing method signatures (e.g., T in Into[T]).
    # P0-GPI: the trait interns its generic parameters in declaration order
    # under its DefKind::TypeName DefId.
    push_scope(env)
    let t_owner = type_decl_owner_def(env, &t.name, module_path)
    let t_param_ids = intern_generic_params(env, &t_owner, &t.generic_params)
    var gp_idx = 0
    while gp_idx < t.generic_params.len() do
      bind_var(env, t.generic_params[gp_idx].name.clone(), Type::Param(t_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    let id = match get_type_id_by_qualified_name(env, t.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    var methods = Vec::new()
    var i = 0
    while i < t.methods.len() do
      var param_types = Vec::new()
      var j = 0
      while j < t.methods[i].sig.params.len() do
        let p = t.methods[i].sig.params[j]
        let resolved_ty = match p.ty
        when Option::Some(ty_expr) then
          resolve_type_expr(env, &ty_expr)
        when Option::None then
          fresh_type_var(env)
        end
        param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
        j = j + 1
      end
      let ret_ty = match t.methods[i].sig.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      methods.push(MethodSig {
        name: t.methods[i].sig.name,
        params: param_types,
        ret_type: ret_ty,
        is_method: true
      })
      i = i + 1
    end

    pop_scope(env)

    var gen_params = Vec::new()
    var gi = 0
    while gi < t.generic_params.len() do
      gen_params.push(t_param_ids[gi].clone())
      gi = gi + 1
    end

    let td = TypeDef {
      id: id,
      name: t.name.clone(),
      def_kind: TypeDefKind::Trait(methods),
      generic_params: gen_params,
      kind: TypeKind::Value
    }
    store_type_def(env, td, t.span, module_path)
    # P0-TM (module-semantic trait identity): the trait's TraitId is its
    # DECLARATION identity — the TypeId the module-qualified registration
    # resolved for exactly this (module_path, name) declaration. The
    # pre-store provisional id is NEVER the registry value: store_type_def
    # may have given a DISTINCT declaration in a different module its own
    # fresh module-local TypeId (traits participate in the module-qualified
    # map — record_module_type_name's Trait guard — so the type side's
    # every-declaration-is-its-own-type rule applies to traits), and this
    # qualified re-resolve reads THAT final identity. The bare registry
    # entry is FIRST-WINS: a builtin/std re-declaration re-registers the
    # SAME id and never overwrites the first declaration's entry.
    let decl_tid = match get_type_id_by_qualified_name(env, t.name.clone(), module_path)
    when Option::Some(tid) then tid
    when Option::None then id
    end
    if !env.trait_registry.contains_key(&t.name) then
      env.trait_registry.insert(t.name.clone(), decl_tid.id)
    end
  when ItemKind::ItemTypeAlias(ta) then
    # Register type alias generic params in scope so resolve_type_expr
    # can find them (e.g., T in a generic alias like type Box2[T] = Box[T]).
    # P0-GPI: the alias interns its generic parameters in declaration order
    # under its DefKind::TypeName DefId.
    push_scope(env)
    let ta_owner = type_decl_owner_def(env, &ta.name, module_path)
    let ta_param_ids = intern_generic_params(env, &ta_owner, &ta.generic_params)
    var gp_idx = 0
    while gp_idx < ta.generic_params.len() do
      bind_var(env, ta.generic_params[gp_idx].name.clone(), Type::Param(ta_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    let id = match get_type_id_by_qualified_name(env, ta.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    let aliased_type = resolve_type_expr(env, &ta.ty)

    pop_scope(env)

    var gen_params = Vec::new()
    var gi = 0
    while gi < ta.generic_params.len() do
      gen_params.push(ta_param_ids[gi].clone())
      gi = gi + 1
    end

    let td = TypeDef {
      id: id,
      name: ta.name.clone(),
      def_kind: TypeDefKind::Alias(aliased_type),
      generic_params: gen_params,
      kind: TypeKind::Value
    }
    store_type_def(env, td, ta.span, module_path)
  when _ then ()
  end
end

def check_item(env: &mut TypeEnv, program: &Program, item: &Item, item_idx: Int) -> Unit
  # Derive the owner keys for this item's functions/methods from the
  # resolver's item_defs (DefId-based; unique across merged files). Methods
  # without a recorded DefId (struct-inherent methods) fall back to a
  # per-item positional key "item::<item_idx>::method::<mi>" that is still
  # collision-free across files (item_idx is unique in the merged program).
  var fn_keys = Vec::new()
  match env.resolutions
  when Option::Some(res) then
    match res.item_defs.get(item_idx)
    when Option::Some(dids) then
      for did in dids do
        fn_keys.push(fn_owner_key_of_def(program, &res, &did))
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  match item.kind
  when ItemKind::ItemFunction(f) then
    # P0-C: the owner key is the item's DefId rendered via fn_owner_key_of_def
    # (fn_keys[0]), or — for the no-DefId cases — the module-path-qualified
    # name fallback (module_qualified_fn_key, the SAME scheme the resource
    # checker's fn_owner_key_of_item uses, with the current module's full
    # path), so parameter-binding lookups align across the consumers.
    let owner_key = if fn_keys.len() > 0 then fn_keys[0].clone() else
      module_qualified_fn_key(&env.current_module_path, f.name.clone())
    end
    # P0-GPI: the owner DefId the generic parameters were interned under in
    # pass 3 (item_owner_def) — check_function reconstructs the same ids
    # from (owner, declaration index).
    let f_owner = item_owner_def(env, item_idx)
    check_function(env, f, owner_key, &f_owner)
  when ItemKind::ItemImpl(i) then
    if fn_keys.len() == i.methods.len() then
      check_impl(env, i, &fn_keys)
    else
      var keys = Vec::new()
      var mi = 0
      while mi < i.methods.len() do
        keys.push("item::" + item_idx.to_string() + "::method::" + mi.to_string())
        mi = mi + 1
      end
      check_impl(env, i, &keys)
    end
  when ItemKind::ItemStruct(s) then
    if s.methods.len() > 0 then
      var type_args = Vec::new()
      var sgp_idx = 0
      while sgp_idx < s.generic_params.len() do
        type_args.push(TypeExpr { kind: TypeExprKind::Named(s.generic_params[sgp_idx].name.clone(), Vec::new()), span: s.span })
        sgp_idx = sgp_idx + 1
      end
      let res_for_type = TypeExpr { kind: TypeExprKind::Named(s.name.clone(), type_args), span: s.span }
      var s_keys = Vec::new()
      if fn_keys.len() == s.methods.len() then
        s_keys = fn_keys
      else
        var smi = 0
        while smi < s.methods.len() do
          s_keys.push("item::" + item_idx.to_string() + "::method::" + smi.to_string())
          smi = smi + 1
        end
      end
      check_impl(env, &ImplDecl {
        vis: s.vis,
        generic_params: s.generic_params.clone(),
        trait_name: Option::None,
        for_type: res_for_type.clone(),
        self_type: res_for_type,
        where_clause: Vec::new(),
        methods: s.methods.clone(),
        assoc_types: Vec::new(),
        span: s.span
      }, &s_keys)
    end
  when ItemKind::ItemConst(c) then
    env.check_ctx = "const:" + c.name
      push_scope(env)
    let const_ty = match c.ty
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then fresh_type_var(env)
    end
    let value_ty = check_expr(env, &c.value)
    unify(env, value_ty, const_ty, c.span)
    pop_scope(env)
  when ItemKind::ItemStatic(s) then
    # Check static variable initializer (already registered in pass 3)
    env.check_ctx = "static:" + s.name
    push_scope(env)
    let static_ty = resolve_type_expr(env, &s.ty)
    let value_ty = check_expr(env, &s.value)
    unify(env, value_ty, static_ty, s.span)
    pop_scope(env)
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Generic-parameter interning (P0-GPI)
# ———————————————————————————————————————————————————————————————
#
# Every declaration interns its generic parameters in declaration order at
# registration (the GenericParamId index IS the declaration position):
#   - type declarations (pass 2): under the type's DefKind::TypeName DefId
#     from the resolver's module_symbols (see type_decl_owner_def);
#   - functions / extern functions (pass 3): under the item's DefId
#     (item_owner_def — def_id_of_item, or the deterministic module -2
#     fallback);
#   - impl-level and method-level parameters (check_impl): impls under a
#     fresh synthetic owner; methods under their resolver method_defs DefId
#     (or the deterministic module -3 fallback, impl_method_owner_def).
# The body-checking passes RECONSTRUCT the same ids from the owner DefId +
# declaration index (generic_param_id_at) and never re-intern.

# The owner DefId of an item's function declarations — the resolver's
# item_defs first entry (def_id_of_item) when recorded, else the
# deterministic synthetic fallback (module id -2 + the item index — the
# SAME owner every pass derives for the same item, so the pass-3 interning
# and the pass-4 id reconstruction agree).
def item_owner_def(env: &TypeEnv, item_idx: Int) -> DefId
  match env.resolutions
  when Option::Some(res) then
    match def_id_of_item(res, item_idx)
    when Option::Some(did) then did
    when Option::None then DefId { module: ModuleId { id: -2 }, index: item_idx as UInt }
    end
  when Option::None then DefId { module: ModuleId { id: -2 }, index: item_idx as UInt }
  end
end

# The GenericParamId of the i-th declared generic parameter of `owner` —
# the reconstruction used by the body-checking passes (the interning ran
# at registration; the ids are (owner, declaration index) by construction).
def generic_param_id_at(owner: &DefId, index: Int) -> GenericParamId
  GenericParamId { owner: owner.clone(), index: index as UInt }
end

# The owner DefId of a type declaration's generic parameters: the
# resolver's module_symbols DefKind::TypeName entry for exactly this
# (module path, name) pair when recorded; else a fresh synthetic owner.
def type_decl_owner_def(env: &mut TypeEnv, name: &String, module_path: &Vec[String]) -> DefId
  match env.resolutions
  when Option::Some(res) then
    let key = module_qualified_key(module_path, name)
    match res.module_symbols.get(&key)
    when Option::Some(did) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::TypeName then
          did
        else
          fresh_synthetic_owner(&mut env.generic_param_table)
        end
      when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
      end
    when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
    end
  when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
  end
end

# The owner DefId of an impl method's generic parameters: the resolver's
# method_defs entry under the impl's for_type key ("Type::method") when
# recorded; else the deterministic synthetic fallback (module id -3:
# impl index in the high bits + method index) — computed identically in
# the signature pass and the body pass of check_impl, so the interning
# and the id reconstruction agree.
def impl_method_owner_def(env: &TypeEnv, for_type: &TypeExpr, method: &FunctionDecl, impl_idx: Int, method_idx: Int) -> DefId
  match env.resolutions
  when Option::Some(res) then
    let mkey = impl_registry_method_key(for_type, &method.name)
    match res.method_defs.get(mkey)
    when Option::Some(did) then did
    when Option::None then DefId { module: ModuleId { id: -3 }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
    end
  when Option::None then DefId { module: ModuleId { id: -3 }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
  end
end

# Intern a declaration's generic parameters in declaration order under
# `owner`; returns the ids. The GenericParamId order IS the declaration
# order (the interning allocates indices as the owner's running count).
def intern_generic_params(env: &mut TypeEnv, owner: &DefId, names: &Vec[GenericParam]) -> Vec[GenericParamId]
  var ids = Vec::new()
  var i = 0
  while i < names.len() do
    ids.push(intern_generic_param(&mut env.generic_param_table, owner, names[i].name.clone()))
    i = i + 1
  end
  ids
end

# ———————————————————————————————————————————————————————————————
# Generic-parameter trait bounds (P0-AP)
# ———————————————————————————————————————————————————————————————
#
# A bare Type::Param receiver inside a generic body (`self.inner.advance()`
# on inner: I with `I: Iterator[T]`) resolves through the parameter's trait
# bounds. The bounds are registered HERE when the generic function's/impl's
# parameters enter scope, and consumed by resolve_method_type's
# Param-receiver section. P0-GPI: the bounds are keyed by the parameter's
# IDENTITY (numeric GenericParamId) — two same-named parameters of
# different declarations never collide.

# Resolve one trait-argument TypeExpr in the current generic scope: a bare
# reference to an in-scope generic parameter (e.g. the T of `I: Iterator[T]`)
# resolves through the scope binding to Type::Param — resolve_type_expr alone
# would treat it as an unknown Named type.
def resolve_param_bound_arg(env: &mut TypeEnv, te: &TypeExpr) -> Type
  match te.kind
  when TypeExprKind::Named(name, _) then
    match lookup_var(env, name.clone())
    when Option::Some(t) then t.clone()
    when Option::None then resolve_type_expr(env, te)
    end
  when _ then resolve_type_expr(env, te)
  end
end

# P0-TM (module-semantic trait identity): resolve a trait name to its
# TraitId through the module-qualified declaration map — the resolver's
# DefKind::Trait module_symbols entries mirrored at trait-registration time
# (record_module_type_name). The TraitId is the declaration's TypeId value
# (the declaration identity — never a bare-name authority):
#   1. the CURRENT module's OWN qualified declaration ("path::name" of
#      env.current_module_path) shadows all others;
#   2. a bare name with no own declaration falls back to the bare
#      first-wins registry entry — the compatibility fallback (builtin
#      traits and the first source declaration of each name), mirroring
#      resolve_bare_type_name's recoverable-fallback behavior when >= 2
#      DISTINCT foreign trait declarations exist (the qualified entries
#      keep those declarations apart; only Trait-typed entries count — a
#      same-named struct in another module is a different namespace);
#   3. TraitId(-1) when the name is not a registered trait (a
#      not-yet-registered or unknown trait never matches a registered
#      impl).
def trait_id_for(env: &TypeEnv, name: &String) -> TraitId
  let own_key = module_qualified_key(&env.current_module_path, name)
  var own_tid = Option::None
  match env.module_type_names.get(own_key.clone())
  when Option::Some(idx) then
    let td = env.type_list[idx]
    if type_def_is_trait(&td) then
      own_tid = Option::Some(TraitId { id: td.id.id })
    end
  when Option::None then ()
  end
  match own_tid
  when Option::Some(tid) then
    tid
  when Option::None then
    var foreign_distinct = 0
    var foreign_seen = Map::new()
    let suffix = "::" + name.clone()
    let entry_vec = env.module_type_names.entries()
    for (key, idx) in entry_vec do
      let ftd = env.type_list[idx]
      if type_def_is_trait(&ftd) then
        var matches = false
        if key == name.clone() then
          matches = true
        else
          if key.ends_with(suffix) then
            matches = true
          end
        end
        if matches && key != own_key then
          if !foreign_seen.contains_key(&ftd.id.id) then
            foreign_seen.insert(ftd.id.id, true)
            foreign_distinct = foreign_distinct + 1
          end
        end
      end
    end
    if foreign_distinct >= 2 then
      # Genuinely ambiguous bare trait name (>= 2 DISTINCT trait
      # declarations in other modules): the first-wins registry entry is
      # the recoverable fallback (mirrors resolve_bare_type_name).
      ()
    end
    match env.trait_registry.get(name.clone())
    when Option::Some(tid) then TraitId { id: tid }
    when Option::None then TraitId { id: -1 }
    end
  end
end

# Record one trait bound (id + resolved type arguments) for a generic
# parameter. Appends to the parameter's existing bounds. P0-GPI: keyed by
# the parameter's numeric GenericParamId; the name is diagnostics-only.
def record_param_trait_bound(env: &mut TypeEnv, gpid: &GenericParamId, bound_ty: &TypeExpr) -> Unit
  let trait_name = type_expr_name_of(bound_ty)
  if trait_name != "" then
    var args = Vec::new()
    match bound_ty.kind
    when TypeExprKind::Named(_, tys) then
      var i = 0
      while i < tys.len() do
        args.push(resolve_param_bound_arg(env, &tys[i]))
        i = i + 1
      end
    when _ then ()
    end
    let pkey = generic_param_id_numeric(gpid)
    var cur = match env.param_bounds.get(pkey)
    when Option::Some(v) then v.clone()
    when Option::None then Vec::new()
    end
    cur.push(ParamTraitBound {
      trait_id: trait_id_for(env, &trait_name),
      trait_name: trait_name,
      args: args
    })
    env.param_bounds.insert(pkey, cur)
  end
end

# Register the trait bounds of a generic-parameter list (the inline
# `T: Trait[Arg]` bounds). The ids pair positionally with the AST
# parameters (both are the declaration order). P0-GPI: bounds are keyed by
# the parameter's identity — a same-named parameter of an inner
# declaration re-registers its own entry, and an unconstrained shadow
# ERASES only its own — the outer scope's bound can never leak onto a
# shadowing parameter.
def record_param_bounds(env: &mut TypeEnv, generic_params: &Vec[GenericParam], param_ids: &Vec[GenericParamId]) -> Unit
  var i = 0
  while i < generic_params.len() do
    let gp = generic_params[i]
    if i < param_ids.len() then
      let pkey = generic_param_id_numeric(&param_ids[i])
      env.param_bounds.remove(&pkey)
      for b in gp.bounds do
        record_param_trait_bound(env, &param_ids[i], &b)
      end
    end
    i = i + 1
  end
end

# Register the trait bounds of a where-clause (`where T: Trait[Arg]`). Only
# predicates over a generic parameter are recorded (the predicate subject
# resolves through the scope to Type::Param — keyed by the parameter's
# identity); concrete subjects are ignored.
def record_where_predicate_bounds(env: &mut TypeEnv, where_clause: &Vec[WherePredicate]) -> Unit
  var i = 0
  while i < where_clause.len() do
    let pred = where_clause[i]
    match pred.ty.kind
    when TypeExprKind::Named(pname, _) then
      match lookup_var(env, pname.clone())
      when Option::Some(t) then
        match t
        when Type::Param(gpid) then
          let pkey = generic_param_id_numeric(&gpid)
          env.param_bounds.remove(&pkey)
          for b in pred.bounds do
            record_param_trait_bound(env, &gpid, &b)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
end

def check_function(env: &mut TypeEnv, f: &FunctionDecl, owner_key: String, f_owner: &DefId) -> Unit
  push_scope(env)
  env.check_ctx = "fn:" + f.name
  
  # Register generic type parameters in scope. P0-GPI: the ids were
  # interned in pass 3 under f_owner (item_owner_def — the item's DefId or
  # the deterministic module -2 fallback); this pass reconstructs the same
  # ids from (owner, declaration index) — never re-interns, so the
  # declaration-order indices stay stable.
  var gp_idx = 0
  while gp_idx < f.generic_params.len() do
    bind_var(env, f.generic_params[gp_idx].name.clone(), Type::Param(generic_param_id_at(f_owner, gp_idx)))
    gp_idx = gp_idx + 1
  end
  var fn_param_ids = Vec::new()
  gp_idx = 0
  while gp_idx < f.generic_params.len() do
    fn_param_ids.push(generic_param_id_at(f_owner, gp_idx))
    gp_idx = gp_idx + 1
  end

  # P0-AP: record the generic parameters' trait bounds (inline bounds +
  # where-clause) so bare Param receivers in the body resolve through them.
  record_param_bounds(env, &f.generic_params, &fn_param_ids)
  record_where_predicate_bounds(env, &f.where_clause)

  # Bind parameters
  # Parameter bindings are recorded per-owner (keyed by the function's DefId
  # via fn_owner_key — never a span offset, which would collide across merged
  # files) in declaration order, in the dedicated param_binding_resolutions
  # map. This keeps parameter keys in a domain that can never collide with
  # pattern node ids (see the TypeEnv field comment).
  var param_local_ids = Vec::new()
  var i = 0
  while i < f.params.len() do
    let p = f.params[i]
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then fresh_type_var(env)
    end
    bind_var(env, p.name, ty)
    param_local_ids.push(env.local_id_counter - 1)
    i = i + 1
  end
  env.param_binding_resolutions.insert(owner_key, param_local_ids)
  # P0-GPI: record the function's generic parameter ids under the SAME
  # owner key (the MIR builder reconstructs the lowered Type::Param ids
  # from this record, paired positionally with the lowered declaration's
  # generic list — the substs-order contract).
  env.generic_param_ids.insert(owner_key, fn_param_ids)
  
  # Get expected return type
  let ret_type = match f.ret_type
  when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
  when Option::None then Type::Unit
  end
  
  # P0-M: every `return expr` in the body unifies immediately with the
  # declared return type (unconditional — not dependent on the last
  # statement). Cleared after the body check.
  env.expected_return = Option::Some(ret_type.clone())
  # Check body
  match f.body
  when FnBody::FnBlock(block) then
    let body_flow = check_block(env, &block, true)
    if is_unit_type(&ret_type) then
      # A Unit-returning function discards its trailing statement's value
      # (e.g. `if c then advance(p) end` where advance returns Token).
      ()
    else
      unify(env, body_flow.normal, ret_type, f.span)
    end
  when FnBody::FnExpr(expr) then
    let expr_type = check_expr(env, &expr)
    unify(env, expr_type, ret_type, expr.span)
  when _ then ()
  end
  env.expected_return = Option::None
  
  pop_scope(env)
end

def check_impl(env: &mut TypeEnv, i: &ImplDecl, method_keys: &Vec[String]) -> Unit
  # Register impl-level generic type parameters FIRST so they are in scope
  # when resolving i.for_type (e.g., Vec[T] needs T in scope).
  # P0-GPI: the impl interns its generic parameters in declaration order
  # under a fresh synthetic owner DefId (impls have no resolver DefId) —
  # the GenericParamId order IS the declaration order. The impl index
  # (env.impls.len() at entry) is captured ONCE: the fallback method
  # owners (impl_method_owner_def) derive from it, and both the signature
  # pass and the body pass of this function must agree on it.
  push_scope(env)
  let impl_idx = env.impls.len()
  let imp_owner = fresh_synthetic_owner(&mut env.generic_param_table)
  let impl_param_ids = intern_generic_params(env, &imp_owner, &i.generic_params)
  var gp_idx = 0
  while gp_idx < i.generic_params.len() do
    bind_var(env, i.generic_params[gp_idx].name.clone(), Type::Param(impl_param_ids[gp_idx].clone()))
    gp_idx = gp_idx + 1
  end

  # P0-AP: record the impl's generic-parameter trait bounds (inline bounds +
  # where-clause) so bare Param receivers in the method bodies resolve
  # through them (`self.inner.advance()` with inner: I in
  # `impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]`).
  record_param_bounds(env, &i.generic_params, &impl_param_ids)
  record_where_predicate_bounds(env, &i.where_clause)

  let self_type = resolve_type_expr(env, &i.for_type)

  # Determine trait name (empty string for inherent impls)
  let trait_name = match i.trait_name
  when Option::Some(tn) then tn.clone()
  when Option::None then ""
  end
  # P0-BT (reviewer item 7): the impl's trait identity is its TraitId
  # (TraitId(-1) for inherent impls — no registered trait under the name).
  let trait_id = trait_id_for(env, &trait_name)

  # FIRST PASS: Resolve all method signatures and register in env.impls
  # This is done before checking bodies so methods can call each other
  var impl_methods = Vec::new()
  var method_index = 0
  while method_index < i.methods.len() do
    let m = i.methods[method_index]
    push_scope(env)

    # Register method-level generic type parameters in scope
    # (impl-level params are already visible from the outer scope).
    # P0-GPI: each method interns its generic parameters in declaration
    # order under its own owner (impl_method_owner_def — the resolver's
    # method_defs DefId or the deterministic module -3 fallback); the
    # body pass reconstructs the same ids from (owner, index).
    let m_owner = impl_method_owner_def(env, &i.for_type, &m, impl_idx, method_index)
    let method_param_ids = intern_generic_params(env, &m_owner, &m.generic_params)
    var mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      bind_var(env, m.generic_params[mgp_idx].name.clone(), Type::Param(method_param_ids[mgp_idx].clone()))
      mgp_idx = mgp_idx + 1
    end

    # Resolve parameter types
    var param_types = Vec::new()
    var param_index = 0
    while param_index < m.params.len() do
      let p = m.params[param_index]
      let ty = if p.name == "self" then
        self_type
      else
        match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
      end
      param_types.push(ParamType { ty: ty, convention: p.convention })
      param_index = param_index + 1
    end

    # Resolve return type
    let ret_type = match m.ret_type
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then Type::Unit
    end

    pop_scope(env)

    # Collect method-level generic parameter ids for later substitution
    # (P0-GPI: the ids in declaration order — the param-name table holds
    # the display names).
    var method_gp_ids = Vec::new()
    var m_gp_idx = 0
    while m_gp_idx < m.generic_params.len() do
      method_gp_ids.push(method_param_ids[m_gp_idx].clone())
      m_gp_idx = m_gp_idx + 1
    end

    # Register method info for env.impls
    impl_methods.push(MethodInfo {
      name: m.name.clone(),
      ret_type: ret_type.clone(),
      params: param_types.clone(),
      generic_params: method_gp_ids
    })

    method_index = method_index + 1
  end

  # Normalize the impl's generic bounds into obligations ONCE, from the AST
  # ImplDecl. Each obligation records its SUBSTITUTED SUBJECT — the
  # Type::Param of the impl generic parameter it bounds (the GenericParamId
  # binding is where the obligation originates; there is no positional
  # param_index) — plus the bound trait's RESOLVED type arguments
  # (Type::Param forms of the impl's generic scope, resolved through
  # resolve_param_bound_arg — e.g. the T of `I: Iterator[T]` in `impl[T, U,
  # I: Iterator[T]] ...`). The solver instantiates the subject and the args
  # with the candidate's substitution and solves the resulting concrete
  # obligation; it never jumps back to the AST.
  var impl_obligations = Vec::new()
  var ob_idx = 0
  while ob_idx < i.generic_params.len() do
    let ob_gp = i.generic_params[ob_idx]
    for ob_bound in ob_gp.bounds do
      let ob_name = type_expr_name_of(&ob_bound)
      var ob_args = Vec::new()
      match ob_bound.kind
      when TypeExprKind::Named(_, tys) then
        var ob_ai = 0
        while ob_ai < tys.len() do
          ob_args.push(resolve_param_bound_arg(env, &tys[ob_ai]))
          ob_ai = ob_ai + 1
        end
      when _ then ()
      end
      impl_obligations.push(GenericObligation {
        subject: Type::Param(impl_param_ids[ob_idx].clone()),
        trait_id: trait_id_for(env, &ob_name),
        trait_name: ob_name,
        args: ob_args
      })
    end
    ob_idx = ob_idx + 1
  end

  # P0-AL: the impl's FULL generic-parameter ids in declaration order —
  # the extension-impl solver instantiates every one of them (including
  # parameters absent from the for_type, like the T of `impl[T, I:
  # Iterator[T]] I`). P0-GPI: ids, not names (the param-name table holds
  # the display names).
  var imp_gp_ids = Vec::new()
  var igp = 0
  while igp < i.generic_params.len() do
    imp_gp_ids.push(impl_param_ids[igp].clone())
    igp = igp + 1
  end

  # P0-AL: the method DefIds the resolver registered under the impl's
  # for_type key. For an extension impl (`impl[T, I: Iterator[T]] I`) that
  # key ("I[...]::map") is NOT derivable from a concrete receiver at the
  # call site, so the resolution records it here and method_def_for falls
  # back to it after the receiver-based lookup misses.
  var imp_method_defs = Map::new()
  match env.resolutions
  when Option::Some(res) then
    var mdi = 0
    while mdi < i.methods.len() do
      let mkey = impl_registry_method_key(&i.for_type, &i.methods[mdi].name)
      match res.method_defs.get(mkey)
      when Option::Some(did) then imp_method_defs.insert(i.methods[mdi].name.clone(), did)
      when Option::None then ()
      end
      mdi = mdi + 1
    end
  when Option::None then ()
  end

  # E0214 coherence: reject a duplicate impl of the same trait for the same
  # self type. Two candidates silently break every obligation (the solver
  # treats 2+ candidates as ambiguous and returns false) and method dispatch
  # silently picks the first candidate. Structural comparison via unify on
  # the resolved for_type (Params compare by name — copy-paste duplicates,
  # the common case, are caught).
  # P0-1: the trait ARGUMENTS must agree too — `impl From[A] for T` and
  # `impl From[B] for T` are NOT conflicting implementations (the impl's
  # trait arguments are its generic arguments; the parser derives the
  # impl's generic parameters from the trait's type arguments, so their
  # only surviving identity is the parameter NAME, compared pairwise in
  # declaration order through the parameter-name table).
  # P0-T: the probe is TRANSACTIONAL — it runs the ordinary global
  # unifier, and a probe must leave no substitution residue and no
  # diagnostics whether it matches or not.
  if trait_id.id != -1 then
    var ci = 0
    while ci < env.impls.len() do
      let existing = env.impls[ci]
      if existing.trait_id.id == trait_id.id then
        let snap = subst_snapshot(env)
        let errs_before = env.errors.len()
        let head_dup = unify(env, existing.for_type.clone(), self_type.clone(), i.span)
        var args_agree = existing.generic_params.len() == imp_gp_ids.len()
        var tgci = 0
        while args_agree && tgci < existing.generic_params.len() do
          let ename = generic_param_name_of(&env.generic_param_table, &existing.generic_params[tgci])
          let iname = generic_param_name_of(&env.generic_param_table, &imp_gp_ids[tgci])
          if ename != iname then args_agree = false end
          tgci = tgci + 1
        end
        subst_restore(env, &snap)
        errors_truncate(env, errs_before)
        if head_dup && args_agree then
          add_error_with_code(env, "conflicting implementations of trait `" + trait_name + "` for the same type", i.span, "E0214")
          break
        end
      end
      ci = ci + 1
    end
  end

  # Register the impl in env.impls so resolve_method_type can find methods
  env.impls.push(ImplInfo {
    trait_id: trait_id,
    trait_name: trait_name,
    for_type: self_type.clone(),
    obligations: impl_obligations,
    methods: impl_methods,
    generic_params: imp_gp_ids,
    method_defs: imp_method_defs
  })

  # Index impl methods for O(1) resolution: receiver TypeId -> method name -> impl indices.
  # Candidates are inserted in source order so first-hit selection stays deterministic.
  let registered_idx = env.impls.len() - 1
  match self_type
  when Type::Adt(rtid, _) then
    var rm = 0
    while rm < env.impls[registered_idx].methods.len() do
      let mname = env.impls[registered_idx].methods[rm].name.clone()
      var mmap = match env.method_lookup.get(rtid.id)
      when Option::Some(mm) then mm.clone()
      when Option::None then Map::new()
      end
      var cands = match mmap.get(mname)
      when Option::Some(cv) then cv.clone()
      when Option::None then Vec::new()
      end
      cands.push(registered_idx)
      mmap.insert(mname, cands)
      env.method_lookup.insert(rtid.id, mmap)
      rm = rm + 1
    end
  when _ then ()
  end

  # P0-AL: an impl whose for_type is a generic PARAMETER (`impl[T, I:
  # Iterator[T]] I`) has no receiver TypeId and cannot be indexed into
  # method_lookup; it is registered here and searched by method name at
  # resolution time, when the receiver's concrete type unifies the head
  # parameter (I) and the impl's other parameters (T) are solved from the
  # method signature.
  match self_type
  when Type::Param(_) then
    env.param_for_type_impls.push(registered_idx)
  when _ then ()
  end

  # SECOND PASS: Check method bodies (with signatures already visible)
  method_index = 0
  while method_index < i.methods.len() do
    let m = i.methods[method_index]
    # The owner key for this method's parameter bindings: its DefId rendered
    # via fn_owner_key (from the resolver's item_defs), or a per-item
    # positional fallback for methods without DefIds. Never a span offset.
    let m_owner_key = if method_index < method_keys.len() then method_keys[method_index].clone() else
      "item::fallback::" + method_index.to_string()
    end
    push_scope(env)

    # Register method-level generic type parameters in scope. P0-GPI: the
    # ids were interned in the signature pass under the same owner
    # (impl_method_owner_def — the same impl_idx captured at entry); this
    # pass reconstructs them from (owner, declaration index).
    let m_owner = impl_method_owner_def(env, &i.for_type, &m, impl_idx, method_index)
    var mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      bind_var(env, m.generic_params[mgp_idx].name.clone(), Type::Param(generic_param_id_at(&m_owner, mgp_idx)))
      mgp_idx = mgp_idx + 1
    end

    # Bind parameters — use self_type for any param named "self"
    # Recorded per-owner in declaration order in the dedicated parameter map
    # (see the TypeEnv field comment about key-domain separation).
    var method_param_ids = Vec::new()
    var param_index = 0
    while param_index < m.params.len() do
      let p = m.params[param_index]
      let ty = if p.name == "self" then
        self_type
      else
        match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
      end
      bind_var(env, p.name, ty)
      method_param_ids.push(env.local_id_counter - 1)
      param_index = param_index + 1
    end
    env.param_binding_resolutions.insert(m_owner_key, method_param_ids)
    # P0-GPI: record the method's generic parameter ids in the MIR's
    # MERGED declaration order (impl-level params first, then the method's
    # own) under the SAME owner key — the MIR builder pairs this record
    # positionally with the renamed declaration's merged generic list
    # (the substs-order contract).
    var merged_ids = impl_param_ids.clone()
    mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      merged_ids.push(generic_param_id_at(&m_owner, mgp_idx))
      mgp_idx = mgp_idx + 1
    end
    env.generic_param_ids.insert(m_owner_key, merged_ids)

    # Expected return type
    let ret_type = match m.ret_type
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then Type::Unit
    end

    # P0-M: every `return expr` in the body unifies immediately with the
    # declared return type (see check_function).
    env.expected_return = Option::Some(ret_type.clone())
    # Check body
    match m.body
    when FnBody::FnBlock(block) then
      env.check_ctx = "method:" + m.name
      let body_flow = check_block(env, &block, true)
      if is_unit_type(&ret_type) then
        ()
      else
        unify(env, body_flow.normal, ret_type, m.span)
      end
    when FnBody::FnExpr(expr) then
      let expr_type = check_expr(env, &expr)
      unify(env, expr_type, ret_type, expr.span)
    when _ then ()
    end
    env.expected_return = Option::None

    pop_scope(env)
    method_index = method_index + 1
  end

  pop_scope(env)
end

# ———————————————————————————————————————————————————————————————
# Block and Statement Type Checking
# ———————————————————————————————————————————————————————————————

def check_block(env: &mut TypeEnv, block: &Block, is_value: Bool) -> FlowResult
  push_scope(env)
  
  # P0-M: the block's flow summary. `normal` is the value the block produces
  # when it falls through; the flags say which divergence edges the block may
  # take. A statement block (is_value=false) discards its value — normal is
  # Unit when it may fall through (Never when it provably cannot).
  var normal = Type::Unit
  var may_return = false
  var may_break = false
  var may_continue = false
  var may_throw = false
  # P0-M (d): once a terminator (a statement that never falls through
  # normally — return/break/continue/panic/divergent if-match-loop) has been
  # seen, the remainder of the block is still checked for diagnostics but
  # contributes NOTHING to the block's value or flow.
  var unreachable = false
  var i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    let flow = check_stmt(env, &stmt)
    if !unreachable then
      normal = flow.normal
      if flow.may_return then may_return = true end
      if flow.may_break then may_break = true end
      if flow.may_continue then may_continue = true end
      if flow.may_throw then may_throw = true end
      if is_never_type(&flow.normal) then unreachable = true end
    end
    i = i + 1
  end
  
  pop_scope(env)
  # A statement block (if-then, while body, ...) discards its value; only a
  # value block (function body, match arm, expression block) yields the last
  # contributing statement's type. Otherwise `if c then advance(p) end`
  # (advance returning Token) would leak Token into a Unit function body.
  let falls_through = !is_never_type(&normal)
  let block_normal = if is_value then normal elsif falls_through then Type::Unit else Type::Never end
  FlowResult {
    normal: block_normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

def check_stmt(env: &mut TypeEnv, stmt: &Stmt) -> FlowResult
  let result = match stmt.kind
  when StmtKind::StmtLet(pattern, ty_opt, value, is_mut) then
    let value_type = check_expr(env, &value)
    let var_type = match ty_opt
    when Option::Some(ty_expr) then
      let declared = resolve_type_expr(env, &ty_expr)
      unify(env, value_type, declared, stmt.span)
      declared
    when Option::None then
      value_type
    end
    # P0-Q: the pattern's binding plan (per-binding Read/Move actions) is
    # collected here; the block/match/for checking paths consume the plans.
    # The pattern's variant identity is resolved ONCE by
    # resolve_pattern_variants (the checker's pattern-resolution junction —
    # the caller knows the expected type's enum identity, so the junction
    # records the (owner TypeId, variant index) resolution and check_pattern
    # reads the record instead of re-resolving from source spelling). The
    # source place of the let's bindings is the initializer's typed place.
    resolve_pattern_variants(env, &pattern, var_type)
    check_pattern(env, &pattern, var_type, binding_source_place(env, &value, "let initializer"))
    consume_binding_plans(env, &pattern)
    flow_normal(Type::Unit)
  when StmtKind::StmtAssign(target, value) then
    let target_type = check_expr(env, &target)
    let value_type = check_expr(env, &value)
    unify(env, target_type, value_type, stmt.span)
    flow_normal(Type::Unit)
  when StmtKind::StmtIf(if_stmt) then
    check_if_stmt(env, &if_stmt, true)
  when StmtKind::StmtWhile(cond, body) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    let body_flow = check_block(env, &body, false)
    # P0-M (c): a normal while may execute zero times, so its type is Unit,
    # not Never. Only a while whose body has NO reachable break/return path
    # can never terminate — only that loop may be Never.
    let loop_type = if body_flow.may_break || body_flow.may_return then Type::Unit else Type::Never end
    FlowResult {
      normal: loop_type,
      # A return inside the loop body exits the enclosing function; breaks
      # and continues are consumed by the loop itself.
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtFor(for_stmt) then
    push_scope(env)
    let iter_type = check_expr(env, &for_stmt.iter)
    # The element type comes from the collection being iterated, so `for f in
    # program.functions` binds f to MirFunction (not a fresh var that poisons
    # every use of f with inference variables).
    # The range form is classified by the ITER SHAPE first: a range's type
    # is Int (the ExprRange arm of check_expr), and the iteration element of
    # `for i in lo..hi` is Int — a bare Int-typed ITERABLE stays rejected
    # below (iterating an integer is not a range).
    # Iterating a collection the checker cannot handle is an ERROR, not a
    # fresh inference variable: no equation remains to solve it, and the
    # loop variable would silently poison every use in the body (P0-N).
    # Unconstrained Var/Param receivers are kept fresh — their element type
    # is a genuine pending equation resolved when the receiver's type lands.
    let elem_type = match for_stmt.iter.kind
    when ExprKind::ExprRange(_, _, _) then Type::Int
    when _ then
      match iter_type
      when Type::String then Type::Char
      when Type::Adt(tid, args) then
        # Vec is an Adt type (Vec[T]); its element is the first type arg.
        # Map is an Adt type (Map[K, V]); iterating it yields (K, V) pairs.
        # Slice/Array Adt forms are slice-like too (LangItems ids).
        if tid.id == env.lang_items.vec && args.len() >= 1 then args[0].clone()
        elsif tid.id == env.lang_items.map && args.len() >= 2 then Type::Tuple([args[0].clone(), args[1].clone()])
        elsif (tid.id == env.lang_items.slice || tid.id == env.lang_items.array) && args.len() >= 1 then args[0].clone()
        else
          match get_type_by_id_ref(env, tid)
          when Option::Some(td) then
            type_add_error(env, "cannot iterate `" + td.name + "`: for loops require Slice, Array, String, Vec or Map", for_stmt.span)
          when Option::None then
            type_add_error(env, "cannot iterate unresolved container type", for_stmt.span)
          end
          Type::Error
        end
      when Type::Var(_) then fresh_type_var(env)
      when Type::Param(_) then fresh_type_var(env)
      when _ then
        type_add_error(env, "cannot iterate value of type `" + type_tag(env, &iter_type) + "`", for_stmt.span)
        Type::Error
      end
    end
    # P0-Q: the iteration pattern's binding plan is collected and consumed
    # here (the for-loop's element source). The variant identity is
    # resolved by the junction before check_pattern reads the record.
    resolve_pattern_variants(env, &for_stmt.pattern, elem_type)
    check_pattern(env, &for_stmt.pattern, elem_type, binding_source_place(env, &for_stmt.iter, "for iterator element"))
    consume_binding_plans(env, &for_stmt.pattern)
    let body_flow = check_block(env, &for_stmt.body, false)
    pop_scope(env)
    FlowResult {
      normal: Type::Unit,
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtReturn(val_opt) then
    let val_type = match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    # P0-M (b): every `return expr` unifies immediately with the declared
    # return type — unconditional, never dependent on the last statement.
    match env.expected_return
    when Option::Some(rt) then
      unify(env, val_type, rt, stmt.span)
    when Option::None then ()
    end
    flow_terminator(true, false, false, false)
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    flow_terminator(false, true, false, false)
  when StmtKind::StmtContinue then
    flow_terminator(false, false, true, false)
  when StmtKind::StmtExpr(expr) then
    flow_normal(check_expr(env, &expr))
  when StmtKind::StmtMatch(m) then
    check_match(env, &m, true)
  when StmtKind::StmtUnsafe(_, body) then
    check_block(env, &body, true)
  when StmtKind::StmtDefer(body) then
    check_block(env, &body, false)
    flow_normal(Type::Unit)
  when StmtKind::StmtTry(_, _, _) then
    # P0-EX: exceptions are not supported — no exception runtime exists in
    # the backend and the resource CFG has no Throw/Unwind/Handler edges.
    # A throwing path (try body -> catch handler / finally teardown) could
    # bypass Drop/defer/access teardown, so the form is REJECTED here, at
    # the type checker, before the resource checker or MIR ever see it.
    # The parser still accepts it (the AST keeps the form); compilation
    # stops on this diagnostic (type errors gate every later phase).
    type_add_error(env, "exceptions are not supported — no throwing path may bypass teardown: try/catch/finally is rejected", stmt.span)
    flow_normal(Type::Error)
  when StmtKind::StmtLoop(body) then
    let body_flow = check_block(env, &body, false)
    # P0-M (c): a `loop` with a reachable break/return path may terminate —
    # its type is Unit; only a loop without such a path never falls through
    # and may be Never.
    let loop_type = if body_flow.may_break || body_flow.may_return then Type::Unit else Type::Never end
    FlowResult {
      normal: loop_type,
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtGuard(cond, else_action) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    var g_may_return = false
    var g_may_break = false
    var g_may_continue = false
    match else_action
    when GuardElse::Return(ret_opt) then
      g_may_return = true
      match ret_opt
      when Option::Some(ret_expr) then
        let ret_ty = check_expr(env, &ret_expr)
        match env.expected_return
        when Option::Some(er) then unify(env, ret_ty, er, stmt.span)
        when Option::None then ()
        end
      when Option::None then
        # A bare `guard ... else return` returns Unit — check it against the
        # declared return type like a bare `return`.
        match env.expected_return
        when Option::Some(er) then unify(env, Type::Unit, er, stmt.span)
        when Option::None then ()
        end
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(br_opt) then
      g_may_break = true
      match br_opt
      when Option::Some(br_expr) then
        check_expr(env, &br_expr)
      when Option::None then ()
      end
    when GuardElse::Continue then g_may_continue = true
    end
    FlowResult {
      normal: Type::Unit,
      may_return: g_may_return,
      may_break: g_may_break,
      may_continue: g_may_continue,
      may_throw: false
    }
  when StmtKind::StmtHandleWith(_, _) then
    # P0-EX: effect-handler blocks (`handle ... with ...`) are an
    # exceptional control-flow form — a handler edge with cleanup. No
    # exception runtime exists in the backend and the resource CFG has no
    # Handler edges, so the form is REJECTED here, at the type checker,
    # before the resource checker or MIR ever see it.
    type_add_error(env, "exceptions are not supported — no throwing path may bypass teardown: handle/with is rejected", stmt.span)
    flow_normal(Type::Error)
  when StmtKind::StmtWith(_, _, _) then
    # P0-M (g): unsupported feature — an explicit diagnostic, never a silent
    # Unit fallback (MIR has no with lowering).
    # P0-EX: `with` is a teardown-guarding form (context manager) whose exit
    # paths are exceptional in shape and the resource CFG models none of
    # them — rejected here, at the type checker, before the resource
    # checker or MIR ever see it.
    type_add_error(env, "exceptions are not supported — no throwing path may bypass teardown: with is rejected", stmt.span)
    flow_normal(Type::Error)
  when _ then
    # P0-M (g): every remaining statement kind is an explicit diagnostic —
    # there is no silent `Type::Unit` fallback for unhandled statements.
    type_add_error(env, "unsupported statement kind", stmt.span)
    flow_normal(Type::Error)
  end
  if stmt.node_id != 0 then
    env.typed_expr_types.insert(stmt.node_id, result.normal.clone())
    # P0-TH (phase 2): the typed statement record — assembled from the
    # recorded children (the composite expression kinds of the tree carry
    # their blocks' TypedStmt children). A missing child (the
    # missing-metadata failure class) skips the record; the statement's
    # flat type entry remains.
    match typed_stmt_for(env, &stmt)
    when Option::Some(ts) then env.typed_stmts.insert(stmt.node_id, ts)
    when Option::None then ()
    end
  end
  result
end

def check_if_stmt(env: &mut TypeEnv, if_stmt: &IfStmt, is_stmt: Bool) -> FlowResult
  let cond_type = check_expr(env, &if_stmt.cond)
  unify(env, cond_type, Type::Bool, if_stmt.cond.span)
  
  let then_flow = check_block(env, &if_stmt.then_block, true)
  
  var result_type = then_flow.normal
  var may_return = then_flow.may_return
  var may_break = then_flow.may_break
  var may_continue = then_flow.may_continue
  var may_throw = then_flow.may_throw
  var falls_through = !is_never_type(&then_flow.normal)
  
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    let (econd, ebody) = if_stmt.elsif_branches[i]
    let ec_type = check_expr(env, &econd)
    unify(env, ec_type, Type::Bool, econd.span)
    let eb_flow = check_block(env, &ebody, true)
    if !is_never_type(&eb_flow.normal) then falls_through = true end
    if eb_flow.may_return then may_return = true end
    if eb_flow.may_break then may_break = true end
    if eb_flow.may_continue then may_continue = true end
    if eb_flow.may_throw then may_throw = true end
    # Branch values are discarded for statement ifs; only value-position ifs
    # require the branches to agree.
    if !is_stmt then
      unify(env, result_type, eb_flow.normal, ebody.span)
    elsif is_never_type(&result_type) && !is_never_type(&eb_flow.normal) then
      # Statement-if completion value: keep the first completing branch's
      # type, but a branch that completes replaces an all-diverge prefix.
      result_type = eb_flow.normal
    end
    i = i + 1
  end
  
  match if_stmt.else_block
  when Option::Some(else_block) then
    let else_flow = check_block(env, &else_block, true)
    if !is_never_type(&else_flow.normal) then falls_through = true end
    if else_flow.may_return then may_return = true end
    if else_flow.may_break then may_break = true end
    if else_flow.may_continue then may_continue = true end
    if else_flow.may_throw then may_throw = true end
    if !is_stmt then
      unify(env, result_type, else_flow.normal, else_block.span)
    elsif is_never_type(&result_type) && !is_never_type(&else_flow.normal) then
      result_type = else_flow.normal
    end
  when Option::None then
    # An `if` without `else` used as a statement does not force its branch type
    # to Unit — forcing it rejects valid code like `if c then fetch_and_add() end`
    # whose branch returns a value that is discarded.
    # P0-M (e): an `if` USED AS A VALUE without an else contributes Unit on
    # the false path — every reachable branch must have compatible values.
    if !is_stmt then
      unify(env, result_type, Type::Unit, if_stmt.span)
    end
    falls_through = true
  end
  
  # P0-M: an if whose every branch diverges never falls through (normal is
  # Never). A statement if WITHOUT an else completes without a value on the
  # false path, so its normal is Unit — a non-Unit function whose body ends
  # with such an if can no longer silently fall off the end.
  let normal = if falls_through then
    if !is_stmt then result_type
    elsif has_else_branch(&if_stmt) then result_type
    else Type::Unit
    end
  else
    Type::Never
  end
  FlowResult {
    normal: normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

# Whether an if/elsif chain ends in an else (all paths produce a value).
def has_else_branch(if_stmt: &IfStmt) -> Bool
  match if_stmt.else_block
  when Option::Some(_) then true
  when Option::None then false
  end
end

def guard_is_trivially_true(env: &TypeEnv, guard: &Expr) -> Bool
  match guard.kind
  when ExprKind::ExprBoolLit(v) then v
  when _ then false
  end
end

def check_match(env: &mut TypeEnv, m: &MatchExpr, is_stmt: Bool) -> FlowResult
  let scrutinee_type = check_expr(env, &m.scrutinee)
  
  var result_type = fresh_type_var(env)
  var has_wildcard = false
  # P0-Q (defect fix): the covered-variant set holds VariantIds — the
  # scrutinee enum's TypeId (from the resolved scrutinee type) combined
  # with each pattern's variant-resolution record index. Coverage is
  # compared by identity; the variant NAMES survive only in the
  # missing-variants diagnostic.
  var covered_variants: Set[VariantId] = Set::new()
  var may_return = false
  var may_break = false
  var may_continue = false
  var may_throw = false
  var falls_through = false
  
  var i = 0
  while i < m.arms.len() do
    let arm = m.arms[i]
    push_scope(env)
    # P0-Q: the arm pattern's binding plan is collected here; its per-binding
    # actions (Read vs Move) are the ownership data the resource checker's
    # existing rules consume (a Move binding out of an owning aggregate is
    # only valid when the whole scrutinee aggregate is consumed — the
    # resource checker's check_match consumes the scrutinee root once).
    # The variant identity of every variant pattern in the arm is resolved
    # by the junction FIRST (against the scrutinee's enum identity — the
    # checker's typed resolution of the scrutinee expression), so the
    # coverage collection below reads the pattern's variant resolution
    # record — never a re-resolution from the source spelling.
    resolve_pattern_variants(env, &arm.pattern, scrutinee_type)
    check_pattern(env, &arm.pattern, scrutinee_type, binding_source_place(env, &m.scrutinee, "match scrutinee"))
    consume_binding_plans(env, &arm.pattern)

    # P0-Q (defect fix): the guard is checked BEFORE the arm's coverage is
    # recorded — a guarded arm matches only when its (runtime) condition
    # holds, so it can never prove unconditional coverage of the pattern.
    # Only an unguarded arm (or one whose guard is provably trivially true)
    # contributes to the exhaustiveness set.
    var arm_has_guard = false
    match arm.guard_expr
    when Option::Some(guard_expr) then
      let guard_type = check_expr(env, &guard_expr)
      unify(env, guard_type, Type::Bool, guard_expr.span)
      if !guard_is_trivially_true(env, &guard_expr) then
        arm_has_guard = true
      end
    when Option::None then ()
    end

    if !arm_has_guard then
      match arm.pattern.kind
      when PatternKind::Wildcard then
        has_wildcard = true
      when PatternKind::Ident(_, _) then
        # An identifier pattern is a catch-all: it matches ANY value, so it
        # exhaustively covers a closed enum.
        has_wildcard = true
      when PatternKind::Variant(_, _) then
        # The covered variant is the pattern's RESOLVED identity — the
        # (owner TypeId, variant index) record — never a name comparison.
        match env.pattern_variant_resolutions.get(arm.pattern.node_id)
        when Option::Some((tid, vidx)) then
          covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
        when Option::None then ()
        end
      when PatternKind::Or(alts) then
        var j = 0
        while j < alts.len() do
          match alts[j].kind
          when PatternKind::Wildcard then
            has_wildcard = true
          when PatternKind::Ident(_, _) then
            has_wildcard = true
          when PatternKind::Variant(_, _) then
            match env.pattern_variant_resolutions.get(alts[j].node_id)
            when Option::Some((tid, vidx)) then
              covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
            when Option::None then ()
            end
          when PatternKind::Struct(_, _) then
            # A struct-style enum-variant pattern (Enum::Variant { .. })
            # carries its variant resolution record too — it covers the
            # variant by identity; a plain struct destructure has no record.
            match env.pattern_variant_resolutions.get(alts[j].node_id)
            when Option::Some((tid, vidx)) then
              covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
            when Option::None then ()
            end
          when PatternKind::Literal(_) then ()
          when PatternKind::Tuple(_) then ()
          when PatternKind::Array(_) then ()
          when PatternKind::Range(_, _, _) then ()
          end
          j = j + 1
        end
      when PatternKind::Struct(_, _) then
        # A struct-style enum-variant pattern (Enum::Variant { .. }) covers
        # its variant by identity (the resolution record); a plain struct
        # destructure contributes nothing.
        match env.pattern_variant_resolutions.get(arm.pattern.node_id)
        when Option::Some((tid, vidx)) then
          covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
        when Option::None then ()
        end
      when PatternKind::Literal(_) then ()
      when PatternKind::Tuple(_) then ()
      when PatternKind::Array(_) then ()
      when PatternKind::Range(_, _, _) then ()
      end
    end
    
    let arm_flow = check_block(env, &arm.body, true)
    if !is_never_type(&arm_flow.normal) then falls_through = true end
    if arm_flow.may_return then may_return = true end
    if arm_flow.may_break then may_break = true end
    if arm_flow.may_continue then may_continue = true end
    if arm_flow.may_throw then may_throw = true end
    # A match used as a STATEMENT discards its value, so heterogeneous arm
    # types (e.g. an arm ending in `set.insert(...)` returning Bool next to a
    # Unit arm) are not errors. Value-position matches still unify strictly.
    if !is_stmt then
      unify(env, result_type, arm_flow.normal, arm.span)
    end
    pop_scope(env)
    i = i + 1
  end
  
  # P0-M (f) + P1 (FIX 3): a match over a closed enum must be exhaustive in
  # BOTH value and statement position.  A non-exhaustive value match has no
  # value on the uncovered path; a non-exhaustive statement match is an
  # incomplete case analysis all the same — both are semantic errors.  The
  # error applies only to closed-enum scrutinees (Type::Adt resolving to
  # an enum definition); matches over open or non-enum scrutinees are
  # unaffected (a `when _`/ident arm or a trailing `else` catch-all is the
  # explicit way to keep an intentionally partial statement match).
  # Coverage is compared BY IDENTITY: the covered set holds the VariantId
  # (owner = the scrutinee enum's TypeId from the resolved scrutinee type,
  # index = the pattern's variant resolution record) of every covered
  # variant; a scrutinee variant is uncovered exactly when its own
  # VariantId is absent from the set. A guarded arm never contributes an
  # entry (see the arm loop above).
  if !has_wildcard then
    match scrutinee_type
    when Type::Adt(tid, _) then
      match get_type_by_id_ref(env, &tid)
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Enum(variants) then
          let missing = Vec::new()
          var j = 0
          while j < variants.len() do
            let variant = variants[j]
            let variant_id = VariantId { owner: TypeId { id: tid.id }, index: j as UInt }
            if !covered_variants.contains(&variant_id) then
              missing.push(variant.name.clone())
            end
            j = j + 1
          end
          if !missing.is_empty() then
            type_add_error(env, "non-exhaustive match: missing variants " +
              missing.join(", ") + " (add a wildcard `_` arm or cover every variant)", m.span)
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Type::Unit then ()
    when Type::Bool then ()
    when Type::Int then ()
    when Type::UInt then ()
    when Type::Float then ()
    when Type::Char then ()
    when Type::String then ()
    when Type::Never then ()
    when Type::I8 then ()
    when Type::I16 then ()
    when Type::I32 then ()
    when Type::I64 then ()
    when Type::I128 then ()
    when Type::U8 then ()
    when Type::U16 then ()
    when Type::U32 then ()
    when Type::U64 then ()
    when Type::U128 then ()
    when Type::ISize then ()
    when Type::USize then ()
    when Type::F32 then ()
    when Type::F64 then ()
    when Type::Ptr(_) then ()
    when Type::PtrMut(_) then ()
    when Type::Function(_, _) then ()
    when Type::Dyn(_) then ()
    when Type::Effect(_, _) then ()
    when Type::Tuple(_) then ()
    when Type::Var(_) then ()
    when Type::Param(_) then ()
    when Type::Error then ()
    when Type::RefInternal(_, _) then ()
    when Type::FixedArray(_, _) then ()
    end
  end
  
  let normal = if falls_through then result_type else Type::Never end
  FlowResult {
    normal: normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

# ———————————————————————————————————————————————————————————————
# Enum Variant Resolution — scan all type defs to find which enum
# contains a variant with the given name. Used by both expression
# and pattern type checking to resolve bare variant names like
# `Some`, `None`, `Ok`, `Err` without requiring `Option::` / `Result::`.
# The INDEXED form also returns the variant's position in the owner
# enum's variant list — the resolved variant IDENTITY that pattern
# typing threads through (see check_pattern / pattern_variant_resolutions)
# so downstream consumers resolve variants by identity, not by name.
# ———————————————————————————————————————————————————————————————

def find_enum_variant(env: &TypeEnv, name: String) -> Option[(TypeDef, VariantInfo)]
  match find_enum_variant_indexed(env, name)
  when Option::Some((td, v, _)) then Option::Some((td, v))
  when Option::None then Option::None
  end
end

def find_enum_variant_indexed(env: &TypeEnv, name: String) -> Option[(TypeDef, VariantInfo, Int)]
  var i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    match td.def_kind
    when TypeDefKind::Enum(variants) then
      var j = 0
      while j < variants.len() do
        if variants[j].name == name then
          return Option::Some((td, variants[j], j))
        end
        j = j + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Pattern Type Checking (P0-Q)
#
# Pattern typing is an OWNERSHIP operation: besides unifying the pattern
# against the expected type, check_pattern records — per bound identifier —
# a BindingPlan { local, source_place, action } where action is Read for a
# plain binding of a copyable value and Consume for a binding that MOVES an
# owning value out of its source place. The plan is additive: binding
# behavior for existing code is unchanged. Enum-variant patterns resolve by
# variant IDENTITY (owner TypeId + variant index) and the resolved identity
# is recorded in pattern_variant_resolutions keyed by the pattern node id,
# so downstream consumers never re-scan variant names.
#
# P0-Q (defect fix — the pattern-resolution junction): the variant identity
# of a variant pattern is resolved ONCE, by resolve_pattern_variants — the
# junction invoked by the match/let/for/closure checking paths BEFORE
# check_pattern — against the CHECKER's typed resolution of the scrutinee/
# initializer (the expected type's enum — the resolver-provided TypeId),
# then recorded. check_pattern READS the record (pattern_variant_
# resolutions) and never re-resolves semantic identity from the source
# spelling: the path segments survive only in diagnostics. The
# spelling-driven lookups (the within-enum name scan for the variant INDEX,
# the module-qualified owner lookup, and the global variant-name scan as
# the last-resort fallback for genuinely context-less bare variants) live
# in the junction — the single place where spelling meets identity.
# ———————————————————————————————————————————————————————————————

# The pattern-resolution junction: walk a pattern tree and record the
# resolved (owner TypeId id, variant index) identity of every
# variant-style node (PatternKind::Variant and the struct-style
# Enum::Variant { .. } form) in pattern_variant_resolutions, keyed by the
# pattern node id. The OWNER enum identity comes from the expected type
# (the checker's typed resolution of the scrutinee/initializer — Type::Adt
# carrying the resolver-provided TypeId) or, for qualified paths, from the
# checker's module-qualified identity tables; only the variant INDEX within
# that enum — and the last-resort global scan for context-less bare
# variants — consult the source spelling, and they live HERE, never in
# check_pattern.
def resolve_pattern_variants(env: &mut TypeEnv, pat: &Pattern, expected: Type) -> Unit
  let expected_base = match expected
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else expected.clone() end
  when _ then expected
  end
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Tuple(pats) then
    match expected_base
    when Type::Tuple(types) then
      if pats.len() == types.len() then
        var i = 0
        while i < pats.len() do
          resolve_pattern_variants(env, &pats[i], types[i].clone())
          i = i + 1
        end
      else
        var i = 0
        while i < pats.len() do
          resolve_pattern_variants(env, &pats[i], expected_base.clone())
          i = i + 1
        end
      end
    when _ then
      var i = 0
      while i < pats.len() do
        resolve_pattern_variants(env, &pats[i], expected_base.clone())
        i = i + 1
      end
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      resolve_pattern_variants(env, &pats[i], expected_base.clone())
      i = i + 1
    end
  when PatternKind::Struct(path, field_pats) then
    # The struct-style enum-variant form (Enum::Variant { .. }) is a
    # variant node: resolve and record its identity; the sub-patterns
    # resolve against the same context. Struct-style nodes never use the
    # global variant-name scan (a plain struct destructure whose name
    # resolves to a type must not be hijacked by an unrelated enum's
    # variant of the same name).
    resolve_pattern_variant_node(env, pat, &path, &expected_base, true)
    var i = 0
    while i < field_pats.len() do
      resolve_pattern_variants(env, &field_pats[i].1, expected_base.clone())
      i = i + 1
    end
  when PatternKind::Variant(path, pats) then
    resolve_pattern_variant_node(env, pat, &path, &expected_base, false)
    var i = 0
    while i < pats.len() do
      resolve_pattern_variants(env, &pats[i], expected_base.clone())
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      resolve_pattern_variants(env, &alts[i], expected.clone())
      i = i + 1
    end
  when PatternKind::Range(_, _, _) then ()
  end
end

# Resolve and record the (owner TypeId id, variant index) identity of ONE
# variant-style pattern node (PatternKind::Variant / the struct-style
# Enum::Variant { .. } form). Identity order:
#   1. the expected type's enum (the typed resolution of the value being
#      matched — resolver-provided TypeId) — the variant index is the
#      within-enum scan;
#   2. a qualified path's owner enum via the module-qualified identity
#      tables (get_type_id_by_qualified_name — the resolver-anchored
#      declaration identity, bare first-wins as the compatibility
#      fallback); a named owner wins over the context (the check_pattern
#      unification flags a mismatch — exactly like the pre-junction
#      behavior);
#   3. a bare PatternKind::Variant with no enum context — the global
#      variant-name scan (find_enum_variant_indexed), the compatibility
#      fallback (struct-style nodes skip it: a plain struct destructure
#      must never be hijacked by an unrelated enum's variant of the same
#      name).
# The spelling-driven lookups exist so the junction can emit the variant
# diagnostics ("unknown variant X in enum Y", "Y is not an enum"); the
# identity they produce is recorded and check_pattern reads ONLY the
# record.
def resolve_pattern_variant_node(env: &mut TypeEnv, pat: &Pattern, path: &AstPath, expected_base: &Type, struct_style: Bool) -> Unit
  match env.pattern_variant_resolutions.get(pat.node_id)
  when Option::Some(_) then return
  when Option::None then ()
  end
  let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
  let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
  # 1. the context enum (the expected type's identity — never a name).
  var context_owner: Option[TypeDef] = Option::None
  match expected_base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then context_owner = Option::Some(td)
    when Option::None then ()
    end
  when _ then ()
  end
  # 2. the qualified path's owner (module-qualified identity tables).
  var named_owner: Option[TypeDef] = Option::None
  if enum_name != "" then
    match get_type_id_by_qualified_name(env, enum_name.clone(), &env.current_module_path)
    when Option::Some(owner_tid) then
      match get_type_by_id_ref(env, &owner_tid)
      when Option::Some(td) then named_owner = Option::Some(td)
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  var chosen: Option[TypeDef] = Option::None
  var named_chosen = false
  match named_owner
  when Option::Some(td) then
    chosen = Option::Some(td)
    named_chosen = true
  when Option::None then
    match context_owner
    when Option::Some(td) then chosen = Option::Some(td)
    when Option::None then ()
    end
  end
  var resolved: Option[(Int, Int)] = Option::None
  match chosen
  when Option::Some(td) then
    match td.def_kind
    when TypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].name == variant_name then
          resolved = Option::Some((td.id.id, vi))
        end
        vi = vi + 1
      end
      if named_chosen then
        match resolved
        when Option::Some(_) then ()
        when Option::None then
          type_add_error(env, "unknown variant " + variant_name + " in enum " + enum_name, pat.span)
        end
      end
    when TypeDefKind::Struct(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Trait(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Alias(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Primitive then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Opaque then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    end
  when Option::None then ()
  end
  # 3. last resort: a bare Variant with no enum context — the global
  # variant-name scan (the compatibility fallback for genuinely
  # context-less patterns, e.g. a generic scrutinee still under
  # inference). Struct-style nodes never take this path.
  match resolved
  when Option::Some(_) then ()
  when Option::None then
    if !struct_style then
      match find_enum_variant_indexed(env, variant_name)
      when Option::Some((enum_td, _, vidx)) then
        resolved = Option::Some((enum_td.id.id, vidx))
      when Option::None then ()
      end
    end
  end
  match resolved
  when Option::Some((tid, vidx)) then
    env.pattern_variant_resolutions.insert(pat.node_id, (tid, vidx))
  when Option::None then ()
  end
end

# The semantic source place of a pattern's bindings: the typed place of
# the source expression (the checker's typed_place_of — the AccessRoot
# domain) when it denotes a place; the RawUnknown root with the given
# diagnostic name for value expressions and synthesized sources.
def binding_source_place(env: &TypeEnv, expr: &Expr, fallback_name: String) -> TypedPlace
  match typed_place_of(env, expr)
  when Option::Some(tp) then tp
  when Option::None then TypedPlace { root: AccessRoot::RawUnknown, root_name: fallback_name, projections: Vec::new() }
  end
end

# Consume the BindingPlans recorded for every binding under a pattern (the
# block/match/for checking paths call this after check_pattern). The plans
# are the per-binding Read/Move actions the ownership layer's existing rules
# consume; reading them here is the type layer's consumption point.
def consume_binding_plans(env: &TypeEnv, pat: &Pattern) -> Unit
  let _plans = match env.binding_plans.get(pat.node_id)
  when Option::Some(plans) then plans
  when Option::None then Vec::new()
  end
  match pat.kind
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Wildcard then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      consume_binding_plans(env, &field_pats[i].1)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      consume_binding_plans(env, &alts[i])
      i = i + 1
    end
  when PatternKind::Range(_, _, _) then ()
  end
end

def check_pattern(env: &mut TypeEnv, pat: &Pattern, expected: Type, source_place: TypedPlace) -> Unit
  # Patterns match through references (e.g. `let (a, b) = &pair` where the
  # scrutinee is a reference to a tuple).
  let expected_base = match expected
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else expected.clone() end
  when _ then expected
  end
  match pat.kind
  when PatternKind::Wildcard then
    ()
  when PatternKind::Ident(name, is_mut) then
    let before = env.local_id_counter
    bind_var(env, name, expected_base)
    if env.local_id_counter > before then
      env.pattern_binding_resolutions.insert(pat.node_id, before)
      # P0-Q: record the binding action — a plain binding READS its source;
      # a binding of an owning type MOVES the value out of the source place
      # (the resource checker's projected-move rules consume this data).
      # Binding through a reference/box (`let (a, b) = &pair`) is a READ —
      # no ownership transfers out of the source.
      let bind_is_ref = match expected
      when Type::RefInternal(_, _) then true
      when Type::Adt(tid, args) then
        if tid.id == env.lang_items.box_ && args.len() >= 1 then true else false end
      when _ then false
      end
      let action = if !bind_is_ref && type_has_resource_kind(env, &expected_base) then AccessEffect::Consume else AccessEffect::Read end
      var plans = match env.binding_plans.get(pat.node_id)
      when Option::Some(p) then p.clone()
      when Option::None then Vec::new()
      end
      plans.push(BindingPlan { local: before, source_place: source_place.clone(), action: action })
      env.binding_plans.insert(pat.node_id, plans)
    end
  when PatternKind::Literal(expr) then
    let lit_type = check_expr(env, &expr)
    unify(env, lit_type, expected_base, pat.span)
    ()
  when PatternKind::Tuple(pats) then
    match expected_base
    when Type::Tuple(types) then
      if pats.len() == types.len() then
        var i = 0
        while i < pats.len() do
          check_pattern(env, &pats[i], types[i].clone(), source_place.clone())
          i = i + 1
        end
      else
        type_add_error(env, "tuple pattern length mismatch", pat.span)
      end
    when Type::Var(_) then
      var types = Vec::new()
      var i = 0
      while i < pats.len() do
        let t = fresh_type_var(env)
        check_pattern(env, &pats[i], t, source_place.clone())
        types.push(t)
        i = i + 1
      end
      unify(env, expected_base, Type::Tuple(types), pat.span)
      ()
    when Type::Param(_) then
      # Generic parameter standing in for a tuple (e.g. Option::Some's payload)
      var types = Vec::new()
      var i = 0
      while i < pats.len() do
        let t = fresh_type_var(env)
        check_pattern(env, &pats[i], t, source_place.clone())
        types.push(t)
        i = i + 1
      end
      unify(env, expected_base, Type::Tuple(types), pat.span)
      ()
    when _ then
      type_add_error(env, "expected tuple type", pat.span)
    end
  when PatternKind::Array(pats) then
    let elem_type = fresh_type_var(env)
    var i = 0
    while i < pats.len() do
      check_pattern(env, &pats[i], elem_type, source_place.clone())
      i = i + 1
    end
  when PatternKind::Variant(path, pats) then
    # P0-Q (defect fix): the semantic identity (owner TypeId, variant
    # index) of this variant pattern is READ from the resolution record —
    # recorded by the pattern-resolution junction (resolve_pattern_variants
    # — invoked by the match/let/for/closure checking paths before
    # check_pattern) — never re-derived from the source spelling. The path
    # segments survive only for diagnostics.
    let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    match env.pattern_variant_resolutions.get(pat.node_id)
    when Option::Some((tid, vidx)) then
      match get_type_by_id_ref(env, &TypeId { id: tid })
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Enum(variants) then
          if vidx < variants.len() then
            let v = variants[vidx]
            # Check sub-pattern count doesn't exceed variant field count
            # Allow fewer sub-patterns than fields (discriminant-only matching)
            if pats.len() > v.fields.len() then
              type_add_error(env, "variant " + variant_name + " expects " + v.fields.len().to_string() + " fields, got " + pats.len().to_string(), pat.span)
            end
            # Unify expected with the enum type
            let enum_type_args = fresh_type_args_for(env, td)
            unify(env, expected, Type::Adt(td.id, enum_type_args), pat.span)
            # Check each sub-pattern against the variant's field types
            var fi = 0
            while fi < pats.len() && fi < v.fields.len() do
              let field_ty = subst_type_args(&v.fields[fi], &td.generic_params, &enum_type_args)
              check_pattern(env, &pats[fi], field_ty, source_place.clone())
              fi = fi + 1
            end
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Option::None then
      # No resolution record (permissive recovery — the junction records
      # every variant node on the compilation path): accept the pattern
      # structurally, checking the sub-patterns against fresh variables.
      var fi = 0
      while fi < pats.len() do
        check_pattern(env, &pats[fi], fresh_type_var(env), source_place.clone())
        fi = fi + 1
      end
    end
  when PatternKind::Struct(path, field_pats) then
    # A struct-style pattern is a struct destructure (Foo { x: p }) or a
    # struct-style enum-variant pattern (Enum::Variant { x: p }). The
    # enum-variant form's identity comes from the resolution record (the
    # junction records struct-style variant nodes); a plain struct
    # destructure resolves the struct through the checker's identity
    # tables (module-qualified first — the resolver-anchored TypeId — the
    # bare first-wins index as the compatibility fallback).
    match env.pattern_variant_resolutions.get(pat.node_id)
    when Option::Some((tid, vidx)) then
      match get_type_by_id_ref(env, &TypeId { id: tid })
      when Option::Some(enum_td) then
        match enum_td.def_kind
        when TypeDefKind::Enum(variants) then
          if vidx < variants.len() then
            let variant = variants[vidx]
            let enum_type_args = fresh_type_args_for(env, enum_td)
            unify(env, expected, Type::Adt(enum_td.id, enum_type_args), pat.span)
            var fi = 0
            while fi < field_pats.len() && fi < variant.fields.len() do
              let field_ty = subst_type_args(&variant.fields[fi], &enum_td.generic_params, &enum_type_args)
              check_pattern(env, &field_pats[fi].1, field_ty, source_place.clone())
              fi = fi + 1
            end
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Option::None then
      # Plain struct destructuring pattern: Foo { x, y: p }
      let struct_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
      match get_type_id_by_qualified_name(env, struct_name.clone(), &env.current_module_path)
      when Option::Some(struct_tid) then
        match get_type_by_id_ref(env, &struct_tid)
        when Option::Some(td) then
          let struct_type_args = fresh_type_args_for(env, td)
          unify(env, expected, Type::Adt(td.id, struct_type_args), pat.span)
          match td.def_kind
          when TypeDefKind::Struct(fields) then
            var i = 0
            while i < field_pats.len() do
              let field_pat = field_pats[i]
              var field_found = false
              var j = 0
              while j < fields.len() do
                let f = fields[j]
                if f.name == field_pat.0 then
                  field_found = true
                  # Substitute generic type parameters when checking pattern field types
                  let field_ty = subst_type_args(&f.ty, &td.generic_params, &struct_type_args)
                  check_pattern(env, &field_pat.1, field_ty, source_place.clone())
                end
                j = j + 1
              end
              if !field_found then
                type_add_error(env, "no field `" + field_pat.0 + "` on struct " + struct_name, pat.span)
              end
              i = i + 1
            end
          when TypeDefKind::Enum(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Trait(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Alias(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Primitive then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Opaque then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          end
        when Option::None then ()
        end
      when Option::None then
        type_add_error(env, "unknown type " + struct_name, pat.span)
      end
    end
  when PatternKind::Range(lo, hi, _) then
    # Range pattern: 1..=10,  'a'..='z'
    match lo
    when Option::Some(lo_expr) then
      let lo_ty = check_expr(env, &lo_expr)
      unify(env, lo_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
    match hi
    when Option::Some(hi_expr) then
      let hi_ty = check_expr(env, &hi_expr)
      unify(env, hi_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
  when PatternKind::Or(alts) then
    # Or-pattern: p1 | p2 | p3
    var i = 0
    while i < alts.len() do
      check_pattern(env, &alts[i], expected, source_place.clone())
      i = i + 1
    end
    # P0-Q (defect fix): every alternative must introduce EXACTLY the same
    # bindings — same names, same types, same mutability, same ownership
    # action — because the alternatives merge into ONE binding set. The
    # equivalence is enforced AFTER the alternatives are typed (the
    # binding records — pattern_binding_resolutions, typed_local_bindings,
    # binding_plans — are recorded by then) and BEFORE the merged set is
    # consumed; a mismatch is rejected with a diagnostic.
    check_or_alternatives_bindings(env, &alts, pat.span)
  when _ then
    # P0-Q (defect fix): every PatternKind is matched explicitly above — a
    # catch-all would silently omit a future pattern kind (the silent
    # semantic omission class).
    panic("internal error: unhandled pattern kind in check_pattern")
  end
  # P0-TH (phase 2): the typed pattern record — assembled from the
  # recorded children (the bound local ids from
  # pattern_binding_resolutions, the resolved variant identity from
  # pattern_variant_resolutions). The tree's Closure / Match / Let forms
  # carry these records. A missing child (the missing-metadata failure
  # class) skips the record.
  if pat.node_id != 0 then
    match typed_pattern_for(env, pat)
    when Option::Some(tp) then env.typed_patterns.insert(pat.node_id, tp)
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Or-pattern binding equivalence (P0-Q)
# ———————————————————————————————————————————————————————————————
#
# An or-pattern merges its alternatives into ONE binding set, so every
# alternative must introduce EXACTLY the same bindings: the same names
# with the same types, the same mutability and the same ownership action.
# The equivalence is checked after the alternatives are typed (the
# checker's binding records are populated by then) and before the merged
# scope is consumed; a mismatch is a semantic error (the merged set would
# be ambiguous).

# One binding of an or-pattern alternative: the bound name, its
# mutability, its semantic local id (the typed binding's type is read back
# from typed_local_bindings) and the binding's ownership action (the
# BindingPlan action — Read vs Consume).
struct OrBindingInfo
  name: String
  is_mut: Bool
  local: Int
  action: AccessEffect
end

# Collect the OrBindingInfo of every identifier bound under a pattern.
def collect_or_bindings(env: &TypeEnv, pat: &Pattern, out: &mut Vec[OrBindingInfo]) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    match env.pattern_binding_resolutions.get(pat.node_id)
    when Option::Some(local) then
      let action = match env.binding_plans.get(pat.node_id)
      when Option::Some(plans) then
        if plans.len() > 0 then plans[0].action else AccessEffect::Read end
      when Option::None then AccessEffect::Read
      end
      out.push(OrBindingInfo { name: name.clone(), is_mut: is_mut, local: local, action: action })
    when Option::None then ()
    end
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      collect_or_bindings(env, &field_pats[i].1, out)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      collect_or_bindings(env, &alts[i], out)
      i = i + 1
    end
  when PatternKind::Wildcard then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Range(_, _, _) then ()
  end
end

# Whether two alternatives' binding sets are equivalent: the same number of
# bindings and, per binding, a partner with the same name, mutability and
# ownership action whose TYPES unify (the type probe is transactional —
# substitution residue and diagnostics are rolled back).
def or_binding_sets_equivalent(env: &mut TypeEnv, a: &Vec[OrBindingInfo], b: &Vec[OrBindingInfo]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    var matched = false
    var j = 0
    while j < b.len() do
      let bj = b[j]
      if a[i].name == bj.name && a[i].is_mut == bj.is_mut && a[i].action == bj.action then
        let ty_a = match env.typed_local_bindings.get(a[i].local)
        when Option::Some(lb) then lb.ty.clone()
        when Option::None then Type::Error
        end
        let ty_b = match env.typed_local_bindings.get(bj.local)
        when Option::Some(lb) then lb.ty.clone()
        when Option::None then Type::Error
        end
        let snap = subst_snapshot(env)
        let errs_before = env.errors.len()
        let ok = unify(env, ty_a, ty_b, Span { file: "", start: 0, end_pos: 0 })
        if !ok then
          while env.errors.len() > errs_before do
            env.errors.pop()
          end
        end
        subst_restore(env, &snap)
        if ok then
          matched = true
        end
      end
      j = j + 1
    end
    if !matched then return false end
    i = i + 1
  end
  true
end

# Enforce the or-pattern binding equivalence over all alternatives of an
# or-pattern; emit a diagnostic on the first mismatch.
def check_or_alternatives_bindings(env: &mut TypeEnv, alts: &Vec[Pattern], span: Span) -> Unit
  if alts.len() <= 1 then return end
  var baseline: Vec[OrBindingInfo] = Vec::new()
  collect_or_bindings(env, &alts[0], &mut baseline)
  var i = 1
  while i < alts.len() do
    var cur: Vec[OrBindingInfo] = Vec::new()
    collect_or_bindings(env, &alts[i], &mut cur)
    if !or_binding_sets_equivalent(env, &baseline, &cur) then
      type_add_error(env, "or-pattern alternatives must bind the same names with the same types, mutability and ownership action", span)
      return
    end
    i = i + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Expression Type Checking
# ———————————————————————————————————————————————————————————————

def convention_to_effect(c: AccessConvention) -> AccessEffect
  match c
  when AccessConvention::Let then AccessEffect::Read
  when AccessConvention::Inout then AccessEffect::Modify
  when AccessConvention::Sink then AccessEffect::Consume
  when AccessConvention::Set then AccessEffect::Initialize
  end
end

def record_arg_effect(env: &mut TypeEnv, arg: &Expr, c: AccessConvention) -> Unit
  let effect = convention_to_effect(c)
  env.typed_access_effects.insert(arg.node_id, effect)
  match arg.kind
  when ExprKind::ExprAccess(inner) then env.typed_access_effects.insert(inner.node_id, effect)
  when _ then ()
  end
end

def resolved_receiver_base(env: &TypeEnv, recv_type: &Type) -> Type
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then inner.clone()
      when _ then base.clone()
      end
    when Option::None then base.clone()
    end
  when _ then base.clone()
  end
end

def resolver_method_key(env: &TypeEnv, recv_type: &Type, method: String) -> String
  let base = resolved_receiver_base(env, recv_type)
  var name = "".to_string()
  var generic = false
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      name = td.name.clone()
      generic = td.generic_params.len() > 0
    when Option::None then ()
    end
  when Type::String then name = "String"
  when Type::Int then name = "Int"
  when Type::UInt then name = "UInt"
  when Type::Float then name = "Float"
  when Type::Bool then name = "Bool"
  when Type::Char then name = "Char"
  when Type::Ptr(_) then name = "Ptr"; generic = true
  when Type::PtrMut(_) then name = "PtrMut"; generic = true
  when _ then ()
  end
  if name == "" then return "".to_string() end
  var key = if generic then name + "[...]" else name end
  key + "::" + method
end

def method_def_for(env: &TypeEnv, recv_type: &Type, method: String) -> Option[DefId]
  let key = resolver_method_key(env, recv_type, method)
  if key != "" then
    match env.resolutions
    when Option::Some(res) then
      match res.method_defs.get(key)
      when Option::Some(did) then return Option::Some(did)
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  # P0-AL: extension-impl methods — the receiver-based key cannot match an
  # impl whose for_type is a generic parameter (the resolver registered the
  # method under the parameter's own key, e.g. "I[...]::map"). Fall back to
  # the DefIds recorded at check_impl time for the param-for_type impls.
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, _)) then
    let pimp = env.impls[pimp_idx]
    match pimp.method_defs.get(method)
    when Option::Some(did) then Option::Some(did)
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Trivial copyability (P0-H)
# ———————————————————————————————————————————————————————————————
#
# THREE distinct copy/move notions, decided once here:
#   1. BIT-COPY (trivial copy): copying the value's bits is valid and
#      requires NO retain/clone. The DECIDED set: primitives (Int/UInt/
#      Float/Char/Bool and the fixed-width ints/floats), raw Ptr/PtrMut,
#      Unit/Never, and composites (tuples, structs whose fields are all
#      trivially copyable, enums whose payloads are all trivially copyable,
#      Option/Result with trivially-copyable payloads). NOT in the set:
#      String (heap-backed), Vec/Array/Map/Set (heap-backed), Box/Rc/
#      UniquePtr/WeakRc/ArcStrong/WeakArc (owning), resources, capabilities,
#      closures/functions with environments. Slice IS in the set: Slice[T] is
#      the non-owning {ptr,len} view (owns=false, drop=none) — bit-copyable
#      exactly like the std's StrView.
#   2. CLONE (explicit, may allocate): `clone()`. The `Copy` trait is the
#      source-level marker on the raw-read APIs; a Copy obligation is
#      satisfied by an explicit `impl Copy for T` in the registry OR by
#      bit-copyability — the solver checks the registry first, then falls
#      back to the structural property below (see solve_obligation_depth).
#   3. MOVE/SINK (transfer): transferring ownership does not copy; the
#      resource checker's linearity rules govern moves.
#
# The memoized type-property engine (P0-I, type_properties_of) computes a
# superset of this analysis over the whole type graph.

pub def is_trivially_copyable(env: &TypeEnv, ty: &Type) -> Bool
  var visited = Set::new()
  is_trivially_copyable_walk(env, ty, &mut visited)
end

# Structural walk over the env's type tables (get_type_by_id + TypeDef
# fields/variants; the built-in names decide directly — canonical Type
# variants are the fast path). The visited set is keyed by the canonical
# structural identity (type_identity_key_resolved — concrete args included),
# so recursion through INLINE storage (structs, enums, ALIASES — including
# alias cycles) terminates by failing closed: a Visiting identity means the
# type is infinitely sized — never bit-copyable. There is NO depth-based
# semantic shortcut: a deep-but-finite chain is walked to its concrete
# leaves and classified by them (the memoized type-property engine P0-I
# supersedes the old defensive depth bound with this real cycle detection).
def is_trivially_copyable_walk(env: &TypeEnv, ty: &Type, visited: &mut Set[String]) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::Never then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      if !is_trivially_copyable_walk(env, &fields[i], visited) then
        return false
      end
      i = i + 1
    end
    true
  when Type::FixedArray(elem, _) then
    # Fixed arrays are inline element storage: bit-copyable exactly when the
    # element is (the count 0 array is trivially bit-copyable).
    is_trivially_copyable_walk(env, &elem, visited)
  when Type::Adt(tid, args) then
    is_named_trivially_copyable(env, tid, args, visited)
  # Heap-backed storage is never bit-copyable: a bit-copy would duplicate
  # the buffer/ownership state without the retain/clone it requires
  # (the Adt forms of the builtin compounds are classified in
  # is_named_trivially_copyable by their LangItems ids).
  when Type::String then false
  # Closures/functions with environments carry state; refs are borrows with
  # checker-managed semantics, not bit-copy values.
  when Type::Function(_, _) then false
  when Type::Dyn(_) then false
  when Type::Effect(_, _) then false
  when Type::RefInternal(_, _) then false
  when Type::Var(_) then false
  when Type::Param(_) then false
  when Type::Error then false
  end
end

def is_named_trivially_copyable(env: &TypeEnv, tid: &TypeId, args: &Vec[Type], visited: &mut Set[String]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    # Resources and capabilities are linear: never bit-copyable.
    if td.kind == TypeKind::Resource || td.kind == TypeKind::Capability then
      return false
    end
    # A registered `impl Drop for T` requires destruction: a raw bit-copy
    # would duplicate the state the drop glue releases (e.g. File's fd —
    # the drop closes it; a bit-copy would double-close). The Drop identity
    # is the LangItems TraitId — never the name.
    if type_has_registered_drop(env, tid) then
      return false
    end
    # Named owning smart pointers are NEVER bit-copyable: a bit-copy would
    # duplicate unique ownership or reference-count state. This mirrors the
    # ResourceChecker's is_owning_smart_pointer classification. Box/Rc are
    # selected by LangItems TypeId; UniquePtr/WeakRc/ArcStrong/WeakArc have
    # no LangItems entries and stay name-selected.
    if tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc || td.name == "UniquePtr" ||
       td.name == "WeakRc" || td.name == "ArcStrong" || td.name == "WeakArc" then
      return false
    end
    # Heap-backed containers (including the registered Vec shape { ptr, len,
    # cap } — the Ptr field must NOT be walked): never bit-copyable. The
    # LangItems TypeIds select the builtin containers. Slice is NOT in this
    # class: Slice[T] is the two-field VIEW { ptr: Ptr[T], len: UInt } with
    # owns=false (no drop, no allocation) — bit-copyable regardless of T.
    if tid.id == env.lang_items.vec || tid.id == env.lang_items.array || tid.id == env.lang_items.map ||
       tid.id == env.lang_items.set then
      return false
    end
    # Slice[T] — compiler-scoped view (reviewer's no-general-borrow model):
    # { ptr: Ptr[T], len: UInt }, owns=false, drop=none. Bit-copy is
    # structurally possible: the view holds a raw pointer (bit-copyable) and
    # a length; the element type's ownership lives in the owning container
    # the view borrows, never in the view. (Mirror of the std's StrView.)
    if tid.id == env.lang_items.slice then
      return true
    end
    if td.name == "String" || td.name == "str" then
      return false
    end
    # Raw pointers are bit-copyable regardless of pointee.
    if td.name == "Ptr" || td.name == "PtrMut" then
      return true
    end
    # Primitive spellings (canonical plus c-FFI aliases) decide directly.
    if td.name == "Unit" || td.name == "Nil" || td.name == "Bool" ||
       td.name == "Int" || td.name == "c_int" || td.name == "UInt" ||
       td.name == "c_uint" || td.name == "Float" || td.name == "Char" ||
       td.name == "Never" ||
       td.name == "I8" || td.name == "Int8" || td.name == "i8" ||
       td.name == "I16" || td.name == "Int16" || td.name == "i16" ||
       td.name == "I32" || td.name == "Int32" || td.name == "i32" ||
       td.name == "I64" || td.name == "Int64" || td.name == "i64" ||
       td.name == "c_long" ||
       td.name == "I128" || td.name == "Int128" || td.name == "i128" ||
       td.name == "U8" || td.name == "UInt8" || td.name == "u8" ||
       td.name == "c_char" ||
       td.name == "U16" || td.name == "UInt16" || td.name == "u16" ||
       td.name == "U32" || td.name == "UInt32" || td.name == "u32" ||
       td.name == "U64" || td.name == "UInt64" || td.name == "u64" ||
       td.name == "c_ulong" ||
       td.name == "U128" || td.name == "UInt128" || td.name == "u128" ||
       td.name == "ISize" || td.name == "isize" ||
       td.name == "USize" || td.name == "usize" ||
       td.name == "F32" || td.name == "f32" || td.name == "c_float" ||
       td.name == "F64" || td.name == "f64" || td.name == "c_double" then
      return true
    end
    # Option/Result Adt forms recurse into their concrete args (LangItems
    # TypeIds select the builtin enums).
    if tid.id == env.lang_items.option then
      if args.len() < 1 then return false end
      return is_trivially_copyable_walk(env, &args[0], visited)
    end
    if tid.id == env.lang_items.result then
      if args.len() < 2 then return false end
      return is_trivially_copyable_walk(env, &args[0], visited) &&
        is_trivially_copyable_walk(env, &args[1], visited)
    end
    # User aggregates: structs whose fields are all trivially copyable,
    # enums whose payloads are all trivially copyable, aliases whose inner
    # type is trivially copyable. The visited set — keyed by the canonical
    # structural identity (type_identity_key_resolved, concrete args
    # included, so Wrapper[Int] and Wrapper[String] are distinct keys) —
    # makes recursion through INLINE storage fail closed (a Visiting key
    # means the type is infinitely sized — never bit-copyable). The key is
    # removed after each subtree so distinct sibling fields do not collide.
    match td.def_kind
    when TypeDefKind::Alias(inner) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      let inner_ty = subst_type_args(&inner, &td.generic_params, args)
      let ok = is_trivially_copyable_walk(env, &inner_ty, visited)
      visited.remove(&id_key)
      ok
    when TypeDefKind::Struct(fields) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      var i = 0
      while i < fields.len() do
        let f_ty = subst_type_args(&fields[i].ty, &td.generic_params, args)
        if !is_trivially_copyable_walk(env, &f_ty, visited) then
          visited.remove(&id_key)
          return false
        end
        i = i + 1
      end
      visited.remove(&id_key)
      true
    when TypeDefKind::Enum(variants) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      var vi = 0
      while vi < variants.len() do
        var fi = 0
        while fi < variants[vi].fields.len() do
          let v_ty = subst_type_args(&variants[vi].fields[fi], &td.generic_params, args)
          if !is_trivially_copyable_walk(env, &v_ty, visited) then
            visited.remove(&id_key)
            return false
          end
          fi = fi + 1
        end
        vi = vi + 1
      end
      visited.remove(&id_key)
      true
    when _ then false
    end
  when Option::None then false
  end
end

# ———————————————————————————————————————————————————————————————
# Trait/Obligation Solver (P0-G)
# ———————————————————————————————————————————————————————————————
#
# ONE general obligation solver drives impl applicability for every trait
# (Copy, Clone, Eq, Hash, Iterator, Display, Drop, user traits). It uses
# the same impl registry as method lookup (env.impls, populated by
# check_impl / register_builtin_trait): an obligation is stated as a FULL
# TraitRef (trait T, self S, trait args) and solved iff exactly one
# candidate impl whose for_type HEAD unifies with S — AND whose trait
# arguments unify with the obligation's args, when the obligation carries
# any — also solves all of its own where-clause obligations under the
# substitution obtained from THAT unification — never from generic-
# parameter index, never from the receiver's positional arguments. The
# impl's generic instantiation keys off ImplInfo.generic_params
# (declaration order) exclusively, and every candidate attempt is a
# TRANSACTIONAL probe (subst_snapshot / subst_restore): a rejected
# candidate leaves no substitution residue in the global inference state.
# Recursion is cycle-guarded by a visited set of full (trait, self, args)
# TraitRef keys; a solved set larger than one candidate is ambiguous and
# fails.

# Collect the GenericParamIds that occur in a type, in traversal order —
# the signature-parameter collector for the monomorphizer's
# positional-substitution record (NOT the impl-instantiation authority:
# impl fresh-variable creation, head instantiation and substitution order
# key off ImplInfo.generic_params exclusively). P0-GPI: identity is the
# GenericParamId (dedupe by generic_param_id_numeric — two same-named
# parameters of different declarations are distinct ids and both collect).
def collect_param_names_from_type(env: &TypeEnv, ty: &Type, out: &mut Vec[GenericParamId]) -> Unit
  match ty
  when Type::Param(gpid) then
    var found = false
    var i = 0
    while i < out.len() do
      if generic_param_id_numeric(&out[i]) == generic_param_id_numeric(&gpid) then found = true end
      i = i + 1
    end
    if !found then out.push(gpid.clone()) end
  when Type::Adt(_, args) then
    var i = 0
    while i < args.len() do
      collect_param_names_from_type(env, &args[i], out)
      i = i + 1
    end
  when Type::RefInternal(inner, _) then collect_param_names_from_type(env, inner, out)
  when Type::Ptr(inner) then collect_param_names_from_type(env, inner, out)
  when Type::PtrMut(inner) then collect_param_names_from_type(env, inner, out)
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      collect_param_names_from_type(env, &fields[i], out)
      i = i + 1
    end
  when Type::Function(params, ret) then
    var i = 0
    while i < params.len() do
      collect_param_names_from_type(env, &params[i].ty, out)
      i = i + 1
    end
    collect_param_names_from_type(env, ret, out)
  when Type::Effect(_, inner) then collect_param_names_from_type(env, inner, out)
  when _ then ()
  end
end

# P0-T (transactional candidate probing): snapshot the unifier's subst
# state before attempting a candidate impl. Candidate probing runs the
# ORDINARY global unifier (try_head_unify); on rejection the attempt rolls
# the subst map back so a failed candidate leaves NO residue in the global
# inference state, and on acceptance the candidate's substitutions commit.
# The subst map is the ONLY inference state the unifier mutates (bindings
# plus path compression); diagnostics are handled separately by truncating
# env.errors to the attempt's pre-count.
def subst_snapshot(env: &TypeEnv) -> Map[TypeVarId, Type]
  env.subst.clone()
end

def subst_restore(env: &mut TypeEnv, snap: &Map[TypeVarId, Type]) -> Unit
  env.subst = snap.clone()
end

def errors_truncate(env: &mut TypeEnv, len: Int) -> Unit
  while env.errors.len() > len do
    env.errors.pop()
  end
end

# Unify two types WITHOUT recording diagnostics: used by the obligation
# solver to test candidate impl heads. A failed head match is an ordinary
# non-match (e.g. `impl Hash for u8` vs an obligation on String), not an
# error — the mismatch diagnostics emitted by unify are discarded. The
# variable bindings made by a failed attempt are rolled back by the
# caller's transactional wrapper (subst_snapshot / subst_restore — see
# solve_obligation_depth): candidate probing never leaves residue in the
# global inference state.
def try_head_unify(env: &mut TypeEnv, t1: Type, t2: Type) -> Bool
  let errors_before = env.errors.len()
  let ok = unify(env, t1, t2, Span { file: "", start: 0, end_pos: 0 })
  if !ok then
    while env.errors.len() > errors_before do
      env.errors.pop()
    end
  end
  ok
end

# A structural identity string for a (fully resolved) type, used as the
# (trait, type) key in the obligation solver's cycle set. Unlike type_tag,
# it recurses into type arguments, so `Hash` for `Vec[Int]` and `Hash` for
# `Vec[String]` are distinct obligations.
def type_identity_key(env: &TypeEnv, ty: &Type) -> String
  type_identity_key_resolved(env, &resolve_type_var(env, ty.clone()))
end

# The canonical identity tag of a parameter access convention. Function
# type identity must distinguish fn(let T) / fn(inout T) / fn(sink T) /
# fn(set T): the conventions are different callable types with different
# ownership contracts, so their canonical keys must differ.
def convention_identity_tag(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

# The canonical render of an effect set for type identity: the effect names
# sorted (a set's canonical order — two syntactically different orders of
# the same effect names are the same set) and joined.
def canonical_effect_set(names: &Vec[String]) -> String
  var sorted = Vec::new()
  var i = 0
  while i < names.len() do
    let name = names[i].clone()
    var pos = 0
    while pos < sorted.len() do
      if name < sorted[pos] then
        break
      end
      pos = pos + 1
    end
    sorted.insert(pos, name)
    i = i + 1
  end
  var s = "{"
  var j = 0
  while j < sorted.len() do
    if j > 0 then s = s + "," end
    s = s + sorted[j]
    j = j + 1
  end
  s + "}"
end

def type_identity_key_resolved(env: &TypeEnv, ty: &Type) -> String
  match ty
  when Type::Adt(tid, args) then
    # The Adt form of a builtin compound keys by its LangItems TypeId;
    # user-defined and non-builtin Adt types keep the id-based key.
    var s = "Named#" + tid.id.to_string()
    var i = 0
    while i < args.len() do
      s = s + "[" + type_identity_key_resolved(env, &args[i]) + "]"
      i = i + 1
    end
    # The Adt form of a builtin compound keys by its LangItems TypeId; the
    # identity is id-selected, never name-selected (a module-local type with
    # a builtin's name must not key as the builtin).
    if tid.id == env.lang_items.option && args.len() >= 1 then
      "Option[" + type_identity_key_resolved(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.result && args.len() >= 2 then
      "Result[" + type_identity_key_resolved(env, &args[0]) + "," + type_identity_key_resolved(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.map && args.len() >= 2 then
      "Map[" + type_identity_key_resolved(env, &args[0]) + "," + type_identity_key_resolved(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.set && args.len() >= 1 then
      "Set[" + type_identity_key_resolved(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.slice && args.len() >= 1 then
      "Slice[" + type_identity_key_resolved(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.array && args.len() >= 1 then
      # The heap-vector Adt form carries no count (the size lives in the
      # distinct FixedArray variant); key by the element alone.
      "Array[" + type_identity_key_resolved(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.box_ && args.len() >= 1 then
      "Box[" + type_identity_key_resolved(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.rc && args.len() >= 1 then
      "Rc[" + type_identity_key_resolved(env, &args[0]) + "]"
    else
      s
    end
  when Type::FixedArray(elem, n) then "FixedArray[" + type_identity_key_resolved(env, &elem) + ";" + n.to_string() + "]"
  when Type::Tuple(fields) then
    var s = "Tuple("
    var i = 0
    while i < fields.len() do
      if i > 0 then s = s + "," end
      s = s + type_identity_key_resolved(env, &fields[i])
      i = i + 1
    end
    s + ")"
  when Type::Function(params, ret) then
    # P0-Q (defect fix): the identity carries EVERY parameter's access
    # convention — fn(let T) / fn(inout T) / fn(sink T) / fn(set T) are
    # distinct callable types whose canonical keys must differ (the
    # conventions describe the callable's ownership contract).
    var s = "Fn("
    var i = 0
    while i < params.len() do
      if i > 0 then s = s + "," end
      s = s + convention_identity_tag(params[i].convention) + ":" + type_identity_key_resolved(env, &params[i].ty)
      i = i + 1
    end
    s + ")->" + type_identity_key_resolved(env, ret)
  when Type::Ptr(inner) then "Ptr[" + type_identity_key_resolved(env, inner) + "]"
  when Type::PtrMut(inner) then "PtrMut[" + type_identity_key_resolved(env, inner) + "]"
  when Type::RefInternal(inner, _) then "Ref[" + type_identity_key_resolved(env, inner) + "]"
  when Type::Effect(effects, inner) then
    # P0-Q (defect fix): the identity includes the ACTUAL effect set — the
    # canonical ordered render of the effect names — never just the inner
    # type (effect[Io] T and effect[Net] T are different types).
    "Effect[" + canonical_effect_set(&effects) + ";" + type_identity_key_resolved(env, inner) + "]"
  when Type::Var(id) then "Var#" + id.id.to_string()
  when Type::Param(gpid) then "Param(" + generic_param_name_of(&env.generic_param_table, &gpid) + ")"
  when Type::Dyn(id) then "Dyn#" + id.id.to_string()
  when _ then type_tag(env, ty)
  end
end

def solve_obligation(env: &mut TypeEnv, obligation: &Obligation) -> Bool
  var visited: Set[String] = Set::new()
  solve_obligation_depth(env, obligation, &mut visited, 0)
end

def solve_obligation_depth(env: &mut TypeEnv, obligation: &Obligation, visited: &mut Set[String], depth: Int) -> Bool
  if depth > MAX_TYPE_DEPTH() then
    return false
  end
  let self_resolved = resolve_type_var(env, obligation.trait_ref.self_ty)
  # An obligation whose self type is still an unbound inference variable is
  # undecidable at this point: solving it would bind the variable to an
  # arbitrary candidate impl head (e.g. `let v = Vec::new(); v.hash()`
  # pinning the element type to the first Hash impl). Reject the obligation
  # instead — the impl is not applicable until the receiver is resolved.
  match self_resolved
  when Type::Var(_) then return false
  when _ then ()
  end
  # P0-BT (reviewer item 7) / P0-1 (trait arguments): the cycle key is the
  # FULL TraitRef — (trait_id, canonical self type, canonical trait args) —
  # so `Iterator[Item = X]` and `Iterator[Item = Y]` obligations are
  # distinct, exactly like `Hash` for `Vec[Int]` and `Hash` for
  # `Vec[String]`. Trait identity is the TraitId, never the name; the name
  # survives only in Obligation.trait_name for diagnostics.
  var args_key = ""
  let ob_args = obligation.trait_ref.args.clone()
  for a in ob_args do
    args_key = args_key + type_identity_key(env, &a) + ","
  end
  let key = obligation.trait_ref.trait_id.id.to_string() + "::" + type_identity_key(env, &self_resolved) + "::" + args_key
  if visited.contains(&key) then
    # Cycle: this (trait, type) obligation is already being solved on the
    # current path (e.g. `impl[T: Hash] Hash for Vec[T]` recursively solving
    # Hash for Vec[Vec[...]]). A cyclic obligation has no well-founded
    # solution.
    return false
  end
  visited.insert(key.clone())
  var solved_candidates = 0
  var i = 0
  while i < env.impls.len() do
    let imp = env.impls[i]
    if imp.trait_id.id == obligation.trait_ref.trait_id.id then
      # P0-T (transactional probing): snapshot the subst state before the
      # candidate attempt. On rejection the attempt is rolled back — a
      # failed candidate must leave NO substitution residue in the global
      # inference state (try_head_unify alone only discards diagnostics).
      # On acceptance the candidate's substitutions commit.
      let snap = subst_snapshot(env)
      let errs_before = env.errors.len()
      # P0-GPI (impl generic instantiation): one fresh inference variable
      # per impl generic parameter, in DECLARATION ORDER — ImplInfo.
      # generic_params is the EXCLUSIVE authority (never a head-derived
      # scan, which misses legal parameters that occur only in trait
      # arguments, where clauses, associated values or phantom positions).
      # The head instantiation and the positional substitution order key
      # off the same vector.
      var vars = Vec::new()
      var j = 0
      while j < imp.generic_params.len() do
        vars.push(fresh_type_var(env))
        j = j + 1
      end
      let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &vars)
      var cand_ok = try_head_unify(env, head_inst, self_resolved.clone())
      if cand_ok then
        # P0-1 (trait-argument matching): the impl's trait arguments — the
        # impl declaration's generic arguments (the parser derives the
        # impl's generic parameters from the trait's type arguments in the
        # `impl Iterator[T] for Type` form; in the leading-generics form
        # they are the impl's generic parameters in declaration order) —
        # instantiate to exactly this fresh-variable vector, positionally.
        # A candidate must unify them against the obligation's args: two
        # impls with the same self type but different trait arguments
        # (From[A] vs From[B], Into[Out], Iterator[Item = X] vs
        # Iterator[Item = Y]) are distinguished here. An args-less
        # obligation (e.g. satisfies_trait by bare name) imposes no
        # argument constraint.
        if ob_args.len() > 0 then
          # Arity-equal obligations enforce the trait arguments positionally.
          # An arity-MISMATCHED pair degrades to head-only matching: the
          # impl declaration's trait arguments are the impl's generic
          # arguments in declaration order, and the parser-derived vector
          # can be arity-incoherent for the leading-generics form (e.g.
          # `impl[K, V] Iterator[(K, V)] for MapIterator[K, V]` carries the
          # tuple arg only in the trait reference the AST drops) — the
          # impl still matches by head, exactly as before.
          if ob_args.len() == imp.generic_params.len() then
            var ai = 0
            while ai < ob_args.len() do
              let resolved_arg = resolve_type_var(env, ob_args[ai].clone())
              if !try_head_unify(env, vars[ai].clone(), resolved_arg) then
                cand_ok = false
              end
              ai = ai + 1
            end
          end
        end
      end
      if cand_ok then
        var all_ok = true
        for wob in imp.obligations do
          # P0-GPI (obligation subject): the registered obligation carries
          # its SUBSTITUTED subject — the Type::Param of the impl generic
          # parameter it bounds. Substituting it with the candidate's fresh
          # variables and resolving after head + argument unification yields
          # the concrete subject; there is no param_index into a separately
          # reconstructed vector. The bound trait's arguments are
          # substituted and resolved the same way.
          let wob_self = resolve_type_var(env, subst_type_args(&wob.subject, &imp.generic_params, &vars))
          var wob_args = Vec::new()
          for wob_arg in wob.args do
            wob_args.push(resolve_type_var(env, subst_type_args(&wob_arg, &imp.generic_params, &vars)))
          end
          let wob_ob = Obligation { trait_ref: TraitRef { trait_id: wob.trait_id, self_ty: wob_self, args: wob_args }, trait_name: wob.trait_name }
          if !solve_obligation_depth(env, &wob_ob, visited, depth + 1) then
            all_ok = false
          end
        end
        if all_ok then
          # Commit: the candidate's substitutions stay in the subst state.
          solved_candidates = solved_candidates + 1
        else
          # Reject: roll the subst state back — no residue.
          subst_restore(env, &snap)
          errors_truncate(env, errs_before)
        end
      else
        # The head or the trait arguments did not match: roll back.
        subst_restore(env, &snap)
        errors_truncate(env, errs_before)
      end
    end
    i = i + 1
  end
  visited.remove(&key)
  if solved_candidates == 1 then
    # Exactly one fully-solving candidate: no candidate fails, and multiple
    # candidates would be ambiguous.
    true
  elsif solved_candidates == 0 then
    # FINAL Copy model: the `Copy` trait is the semantic guarantee that raw
    # duplication is valid. When no explicit impl candidate applies, the
    # structural property decides: a raw bit-copy is valid and requires no
    # retain/clone (is_trivially_copyable). This separates Copy (bit-copy
    # semantics) from Clone (explicit, may allocate) and from move/sink
    # (transfer). The transitional Copyable trait is removed — the std's
    # `Copy` trait identity is the LangItems TraitId (the builtin Copy
    # declaration's id — captured at env init from the builtin
    # registration; never a name-keyed lookup at solve time).
    obligation.trait_ref.trait_id.id == env.lang_items.copy_trait && is_trivially_copyable(env, &self_resolved)
  else
    false
  end
end

# Gate an impl's applicability for a concrete receiver by solving its
# where-clause obligations with the real obligation solver. The self type of
# each obligation is the receiver position bound by impl-HEAD unification —
# never the receiver's positional argument at the obligation's index.
def impl_bounds_satisfied(env: &mut TypeEnv, info: &ImplInfo, recv_type: &Type) -> Bool
  if info.obligations.is_empty() then
    return true
  end
  # P0-T: the whole gate is a TRANSACTIONAL probe — the head unification
  # and the nested obligation solving must leave no substitution residue
  # and no diagnostics on failure.
  let snap = subst_snapshot(env)
  let errs_before = env.errors.len()
  # P0-GPI: one fresh inference variable per impl generic parameter, in
  # DECLARATION ORDER — ImplInfo.generic_params is the EXCLUSIVE authority
  # (never a head-derived scan). The self type of each obligation is the
  # receiver position bound by impl-HEAD unification — never the receiver's
  # positional argument at the obligation's index.
  var vars = Vec::new()
  var i = 0
  while i < info.generic_params.len() do
    vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&info.for_type, &info.generic_params, &vars)
  var all_ok = try_head_unify(env, head_inst, recv_type.clone())
  if all_ok then
    for obligation in info.obligations do
      # P0-GPI: the obligation's subject is its SUBSTITUTED subject (the
      # Type::Param of the impl generic parameter it bounds), substituted
      # with the candidate's fresh variables and resolved — never the Nth
      # variable of a separately reconstructed vector. The bound trait's
      # arguments are substituted and resolved the same way.
      let self_ty = resolve_type_var(env, subst_type_args(&obligation.subject, &info.generic_params, &vars))
      var ob_args = Vec::new()
      for ob_arg in obligation.args do
        ob_args.push(resolve_type_var(env, subst_type_args(&ob_arg, &info.generic_params, &vars)))
      end
      let ob = Obligation { trait_ref: TraitRef { trait_id: obligation.trait_id, self_ty: self_ty, args: ob_args }, trait_name: obligation.trait_name }
      if !solve_obligation(env, &ob) then
        all_ok = false
      end
    end
  end
  if !all_ok then
    subst_restore(env, &snap)
    errors_truncate(env, errs_before)
  end
  all_ok
end

# ———————————————————————————————————————————————————————————————
# Type-Property Engine (P0-I) — the ownership/linearity AUTHORITY
# ———————————————————————————————————————————————————————————————
#
# Memoized per-type property computation over the full concrete type graph.
# type_properties_of walks a type structurally (fields/variants/args),
# memoized in env.type_prop_cache by a canonical structural string key
# (type_identity_key_resolved — it includes the concrete generic args, so
# Wrapper[Int] and Wrapper[File] are distinct cache entries). The walk uses
# the graph algorithm:
#
#   Unvisited -> mark Visiting -> compute from children -> mark Resolved
#
# A Visiting revisit is a recursion through INLINE storage — the layout
# engine panics on such types; this engine reports a TypeError diagnostic
# ("infinitely sized recursive type") instead and treats the revisit as
# NON-owning-but-unsafe: needs_drop=false and is_trivially_copyable=false.
# Indirections (Ptr/Box/Rc) terminate the walk: their properties are decided
# by the pointer layer, not the pointee.
#
# THERE IS NO DEPTH-BASED SEMANTIC SHORTCUT: the Visiting/Resolved graph
# algorithm is the complete cycle solution, so a deep-but-finite chain
# (Wrapper[Wrapper[...File...]]) is walked to its concrete leaves and
# classified by them — it can never be "too deep to know" and fall back to
# needs_drop=false/is_linear=false. Any compiler resource limit that is ever
# reintroduced must be a compilation diagnostic (an error), never a semantic
# answer.
#
# CONCRETE OWNERSHIP vs NOMINAL TypeKind: this engine computes ownership for
# the concrete type identity (TypeId, substitutions). The nominal
# TypeDef.kind carries the DECLARED kind only (Resource/Capability markers);
# the legacy kind-propagation pass is DELETED — no ownership is ever folded
# back into the declaration.
#
# GENERIC OWNERSHIP POLYMORPHISM (the deferred contract): a Type::Param (or
# an unresolved Type::Var) in the type graph yields is_deferred=true — the
# answer is "unknown/deferred", NEVER a concrete semantic answer. A generic
# local may require CONDITIONAL drop after substitution, so while deferred
# the four semantic fields are non-authoritative (false = "not proven
# true"). The concrete answers appear only after substitution: the MIR/mono
# consumer wave substitutes the Param and re-queries this engine on the
# concrete instantiation. Container layers that decide a property
# unconditionally keep it concrete (e.g. Vec[T] needs_drop=true regardless
# of T; Slice[T] is a non-owning view regardless of T).
#
# STRING CONTRACT: String owns a UNIQUE heap buffer (the FROZEN StringPtr
# ABI — one 8-byte pointer to null-terminated UTF-8), so needs_drop=true is
# its ownership contract (moves transfer the buffer; it is never
# bit-copyable). The runtime reclaims buffers with its arena (no per-string
# deallocation path — std/core.tg "String ownership contract"); arena
# reclaim is a RUNTIME DETAIL, not a per-value Drop, so the MIR drop plan
# for String is Trivial. PENDING: generated drop glue for recursive owning
# types (docs/memory_model.md §15.2).
#
# This engine is THE ownership authority: the resource checker and MIR
# consume it on the concrete type identity (engine_snapshot_env /
# deinit_plan_for_type); within this file, type_has_resource_kind routes
# through it.

# Entry point: memoized properties for a fully resolved concrete type.
pub def type_properties_of(env: &mut TypeEnv, ty: &Type) -> TypeProperties
  var visiting: Map[String, TypePropVisitState] = Map::new()
  let resolved = resolve_type_var(env, ty.clone())
  type_props_walk(env, &resolved, &mut visiting)
end

# The per-call visiting set is LOCAL (a fresh top-level call must not see a
# stale Visiting state); the memo cache is persistent in the env, and entries
# are only inserted once a key is fully Resolved — never while Visiting.
def type_props_walk(env: &mut TypeEnv, ty: &Type, visiting: &mut Map[String, TypePropVisitState]) -> TypeProperties
  let key = type_identity_key_resolved(env, ty)
  match env.type_prop_cache.get(key)
  when Option::Some(cached) then
    return cached.clone()
  when Option::None then ()
  end
  match visiting.get(key)
  when Option::Some(state) then
    if state == TypePropVisitState::Visiting then
      # Recursion through INLINE storage: infinitely sized recursive type.
      # The layout engine panics on such types; the property engine reports
      # the diagnostic instead. The revisit is NON-owning-but-unsafe:
      # needs_drop=false (no ownership claimed) and is_trivially_copyable
      # =false (an infinitely sized value can never be copied). The
      # diagnostic (an error) is the semantic answer — never a silent
      # fail-open value.
      env.errors.push(TypeError {
        message: "infinitely sized recursive type: inline storage cycle (use a pointer or Box to break the cycle)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      return TypeProperties { needs_drop: false, is_linear: false, is_capability: false, is_trivially_copyable: false, is_deferred: false }
    end
  when Option::None then ()
  end
  visiting.insert(key.clone(), TypePropVisitState::Visiting)
  var props = TypeProperties { needs_drop: false, is_linear: false, is_capability: false, is_trivially_copyable: false, is_deferred: false }
  match ty
  # Plain data: no drop, not linear, not a capability, bit-copyable.
  when Type::Unit then ()
  when Type::Bool then ()
  when Type::Int then ()
  when Type::UInt then ()
  when Type::Float then ()
  when Type::Char then ()
  when Type::Never then ()
  when Type::I8 then ()
  when Type::I16 then ()
  when Type::I32 then ()
  when Type::I64 then ()
  when Type::I128 then ()
  when Type::U8 then ()
  when Type::U16 then ()
  when Type::U32 then ()
  when Type::U64 then ()
  when Type::U128 then ()
  when Type::ISize then ()
  when Type::USize then ()
  when Type::F32 then ()
  when Type::F64 then ()
  # String owns a unique heap buffer (FROZEN StringPtr ABI): needs_drop=true
  # is the ownership contract; never bit-copyable (clone() is the explicit
  # allocation). Arena reclaim is a runtime detail — see the STRING CONTRACT
  # note in the engine header.
  when Type::String then
    props.needs_drop = true
  # Raw pointers terminate the walk: no ownership, no drop, bit-copyable.
  when Type::Ptr(_) then ()
  when Type::PtrMut(_) then ()
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      let fp = type_props_walk(env, &fields[i], visiting)
      if fp.needs_drop then props.needs_drop = true end
      if fp.is_linear then props.is_linear = true end
      if fp.is_deferred then props.is_deferred = true end
      i = i + 1
    end
  # The builtin compound Adt forms (Box/Rc/Option/Result/Slice/Array/Map/
  # Set) are classified in type_named_props by their LangItems TypeIds.
  when Type::Adt(tid, args) then
    type_named_props(env, tid, args, visiting, &mut props)
  # Fixed arrays are inline element storage: the element's ownership
  # propagates (needs_drop / linearity walk the element).
  when Type::FixedArray(elem, _) then
    let fp = type_props_walk(env, &elem, visiting)
    if fp.needs_drop then props.needs_drop = true end
    if fp.is_linear then props.is_linear = true end
    if fp.is_deferred then props.is_deferred = true end
  # Closures/functions with environments and dyn/effect/ref forms carry
  # checker-managed state: nothing here owns or copies.
  when Type::Function(_, _) then ()
  when Type::Dyn(_) then ()
  when Type::Effect(_, _) then ()
  when Type::RefInternal(_, _) then ()
  when Type::Var(_) then
    # An unresolved inference variable is DEFERRED (fail-closed):
    # resolve_type_var resolves at the entry point; a Var that survives has
    # no decided binding, so no concrete semantic answer may be given.
    props.is_deferred = true
  when Type::Param(_) then
    # Generic ownership polymorphism: an unsubstituted generic parameter is
    # UNKNOWN/DEFERRED, never a concrete semantic answer — a generic local
    # may require conditional drop after substitution. The four semantic
    # fields stay false but are NON-authoritative (is_deferred is set);
    # concrete answers appear only after substitution (the MIR/mono wave).
    props.is_deferred = true
  when Type::Error then ()
  end
  # is_trivially_copyable comes from FIX 1 (P0-H): the decided bit-copy set.
  # A deferred type carries NO concrete answer here — the field stays false
  # (non-authoritative; the is_deferred flag is set) until substitution.
  if !props.is_deferred then
    props.is_trivially_copyable = is_trivially_copyable(env, ty)
  end
  visiting.insert(key.clone(), TypePropVisitState::Resolved)
  env.type_prop_cache.insert(key, props.clone())
  props
end

# True when the type has a registered `impl Drop for T` in the impl registry
# — the TypeEnv-side proxy for a "registered deinit target" (the authoritative
# deinit targets/plans live in TypedProgram; this engine runs on the TypeEnv).
def type_has_registered_drop(env: &TypeEnv, tid: &TypeId) -> Bool
  var i = 0
  while i < env.impls.len() do
    let imp = env.impls[i]
    # P0-BT: the Drop identity is the LangItems TraitId — never the name.
    if imp.trait_id.id == env.lang_items.drop_trait then
      match imp.for_type
      when Type::Adt(imp_tid, _) then
        if imp_tid.id == tid.id then
          return true
        end
      when _ then ()
      end
    end
    i = i + 1
  end
  false
end

# Named-type property computation: built-in names decide directly (their
# registered shapes must NOT be walked — Vec's shape is { ptr: Ptr[T], ... }
# and would look non-owning and bit-copyable); user aggregates walk their
# fields/variants with the concrete args substituted.
#
# THE CONTAINER LAYER IS THE OWNERSHIP AUTHORITY (per its real contract):
#   Vec[T] / Array[T]  — heap-vector HANDLE owning its buffer:
#                        needs_drop = true REGARDLESS of T; is_linear = the
#                        chosen move model of T (T.is_linear)
#   Map[K,V] / Set[T]  — heap map/set handle: needs_drop = true regardless
#                        of K/V; element linearity stays viral
#   Option[T]          — inline tagged storage: needs_drop = T.needs_drop
#   Result[T,E]        — inline tagged storage: needs_drop = T || E
#   FixedArray[T,N]    — inline element storage (the Type::FixedArray arm):
#                        element propagation only
#   String             — owns a unique buffer: needs_drop = true (see the
#                        STRING CONTRACT note in the engine header)
#   Slice[T]           — non-owning {ptr,len} view: owns nothing
#
# SMART-POINTER LINEARITY (the shared handles are NOT linear — their clone
# is the retain/increment, the normal duplication operation; only the unique
# owners are move-only):
#   Box / UniquePtr    — needs_drop = true, is_linear = true
#   Rc / ArcStrong / WeakRc / WeakArc — needs_drop = true, is_linear = false
def type_named_props(env: &mut TypeEnv, tid: &TypeId, args: &Vec[Type], visiting: &mut Map[String, TypePropVisitState], props: &mut TypeProperties) -> Unit
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    if td.kind == TypeKind::Resource || td.kind == TypeKind::Capability then
      # Resources/capabilities are linear by kind; is_capability is the
      # TypeKind::Capability marker.
      props.is_linear = true
      if td.kind == TypeKind::Capability then
        props.is_capability = true
      end
    end
    if type_has_registered_drop(env, tid) then
      props.needs_drop = true
    end
    # Named owning smart pointers: owns an allocation or reference-count
    # state. The UNIQUE owners (Box, UniquePtr) are linear — a bitwise copy
    # would duplicate unique ownership. The SHARED reference-counted handles
    # (Rc, ArcStrong, WeakRc, WeakArc) are NOT linear: clone() is the
    # retain/increment. Box/Rc are selected by LangItems TypeId;
    # UniquePtr/WeakRc/ArcStrong/WeakArc have no LangItems entries and stay
    # name-selected.
    if tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc || td.name == "UniquePtr" ||
       td.name == "WeakRc" || td.name == "ArcStrong" || td.name == "WeakArc" then
      props.needs_drop = true
      if tid.id == env.lang_items.box_ || td.name == "UniquePtr" then
        props.is_linear = true
      end
    elsif tid.id == env.lang_items.vec || tid.id == env.lang_items.array || tid.id == env.lang_items.map ||
          tid.id == env.lang_items.set then
      # Heap-backed container HANDLES OWN their allocation: needs_drop is
      # TRUE regardless of the element types (Vec[Int] still frees its
      # buffer; Map[Int,Int] still frees its bucket arena). Element
      # linearity is viral over the concrete args (the chosen move model of
      # T); element deferral propagates (Vec[T] with T unsubstituted has an
      # undecided is_linear — is_deferred).
      props.needs_drop = true
      var i = 0
      while i < args.len() do
        let ap = type_props_walk(env, &args[i], visiting)
        if ap.is_linear then props.is_linear = true end
        if ap.is_deferred then props.is_deferred = true end
        i = i + 1
      end
    elsif tid.id == env.lang_items.option then
      # Option[T] is inline tagged storage: element propagation only (a
      # None carries nothing, a Some carries T — T's ownership decides).
      if args.len() >= 1 then
        let ap = type_props_walk(env, &args[0], visiting)
        if ap.needs_drop then props.needs_drop = true end
        if ap.is_linear then props.is_linear = true end
        if ap.is_deferred then props.is_deferred = true end
      end
    elsif tid.id == env.lang_items.result then
      # Result[T,E] is inline tagged storage: element propagation only.
      if args.len() >= 2 then
        let tp = type_props_walk(env, &args[0], visiting)
        let ep = type_props_walk(env, &args[1], visiting)
        if tp.needs_drop || ep.needs_drop then props.needs_drop = true end
        if tp.is_linear || ep.is_linear then props.is_linear = true end
        if tp.is_deferred || ep.is_deferred then props.is_deferred = true end
      end
    elsif tid.id == env.lang_items.slice then
      # Slice[T] — the compiler-scoped VIEW { ptr: Ptr[T], len: UInt }:
      # owns=false, drop=none, not linear. The element type's ownership
      # lives in the backing container, never in the view; nothing here
      # walks the args (mirror of the Ptr/StrView classification).
      ()
    elsif td.name == "Ptr" || td.name == "PtrMut" then
      # Raw pointers: no ownership; the pointer layer decides.
      ()
    elsif td.name == "String" then
      # String owns a unique heap buffer (StringPtr ABI): needs_drop=true
      # per the real ownership contract; the arena-reclaim runtime contract
      # (no per-string deallocation path) is documented in std/core.tg and
      # the engine header.
      props.needs_drop = true
    elsif td.name == "str" then
      # `str` is the non-owning borrowed UTF-8 view: owns nothing.
      ()
    else
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        var i = 0
        while i < fields.len() do
          let f_ty = subst_type_args(&fields[i].ty, &td.generic_params, args)
          let fp = type_props_walk(env, &f_ty, visiting)
          if fp.needs_drop then props.needs_drop = true end
          if fp.is_linear then props.is_linear = true end
          if fp.is_deferred then props.is_deferred = true end
          i = i + 1
        end
      when TypeDefKind::Enum(variants) then
        var vi = 0
        while vi < variants.len() do
          var fi = 0
          while fi < variants[vi].fields.len() do
            let v_ty = subst_type_args(&variants[vi].fields[fi], &td.generic_params, args)
            let vp = type_props_walk(env, &v_ty, visiting)
            if vp.needs_drop then props.needs_drop = true end
            if vp.is_linear then props.is_linear = true end
            if vp.is_deferred then props.is_deferred = true end
            fi = fi + 1
          end
          vi = vi + 1
        end
      when TypeDefKind::Alias(inner) then
        let inner_ty = subst_type_args(&inner, &td.generic_params, args)
        let ip = type_props_walk(env, &inner_ty, visiting)
        if ip.needs_drop then props.needs_drop = true end
        if ip.is_linear then props.is_linear = true end
        if ip.is_capability then props.is_capability = true end
        if ip.is_deferred then props.is_deferred = true end
      when _ then ()
      end
    end
  when Option::None then ()
  end
end

def find_method_params(env: &mut TypeEnv, recv_type: &Type, method: String) -> Option[Vec[ParamType]]
  let resolved_base = resolved_receiver_base(env, recv_type)
  match resolved_base
  when Type::Error then return Option::None
  when _ then ()
  end
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let info = env.impls[cands[ci]]
          if impl_for_type_matches(&info.for_type, &resolved_base) then
            # Generic obligation gate: a bounded impl is only applicable when
            # the concrete receiver satisfies its where-clause obligations
            # (solved by the real obligation solver, driven by impl-HEAD
            # unification). This makes `impl[T: Copy] Array[T]` a REAL
            # constraint — a resource element cannot select methods from it,
            # and Eq/Hash gate exactly as the std's impls say.
            if impl_bounds_satisfied(env, &info, &resolved_base) then
              var mi = 0
              while mi < info.methods.len() do
                let m = info.methods[mi]
                if m.name == method then
                  return Option::Some(m.params.clone())
                end
                mi = mi + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
  # P0-AL: extension-impl methods — the receiver has no registered method
  # of this name (or the impl's head is a generic parameter); fall back to
  # the param-for_type impls, whose method signature supplies the
  # conventions the call-site effect/arity logic consumes.
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp2 = env.impls[pimp_idx]
    Option::Some(pimp2.methods[pmid_idx].params.clone())
  when Option::None then Option::None
  end
end

# Extract the element type of a container (Array/Vec, Map, Option-like)
# from a receiver type, in both canonical and Named forms. Used by the
# resource-extraction rule below: a shared read of a resource element would
# duplicate ownership out of a container that stays live.
def container_element_type(env: &TypeEnv, ty: &Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    # The Adt form of the element-bearing builtin containers (LangItems
    # ids): Map yields its value, Array/Vec/Slice their element.
    if tid.id == env.lang_items.map && args.len() >= 2 then Option::Some(args[1].clone())
    elsif (tid.id == env.lang_items.array || tid.id == env.lang_items.vec || tid.id == env.lang_items.slice) && args.len() >= 1 then Option::Some(args[0].clone())
    else Option::None
    end
  when Type::FixedArray(elem, _) then Option::Some(elem.clone())
  when _ then Option::None
  end
end

# Expected explicit-argument count for a method call: the declared params
# with `self` (if present) excluded. Self-less "static-style" methods
# (e.g. Array::from, Map::new called with method syntax) have no receiver
# parameter, so the count is the full param list length.
def find_method_expected_args(env: &mut TypeEnv, recv_type: &Type, method: String) -> Option[Int]
  let resolved_base = resolved_receiver_base(env, recv_type)
  match resolved_base
  when Type::Error then return Option::None
  when _ then ()
  end
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let info2 = env.impls[cands[ci]]
          if impl_for_type_matches(&info2.for_type, &resolved_base) then
            if impl_bounds_satisfied(env, &info2, &resolved_base) then
              var mi = 0
              while mi < info2.methods.len() do
                let m = info2.methods[mi]
                if m.name == method then
                  if m.params.len() >= 1 && m.params[0].name == "self" then
                    return Option::Some(m.params.len() - 1)
                  end
                  return Option::Some(m.params.len())
                end
                mi = mi + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
  # P0-AL: extension-impl methods — same fallback as find_method_params:
  # the param-for_type impls are not indexed by receiver TypeId.
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp3 = env.impls[pimp_idx]
    let m3 = pimp3.methods[pmid_idx]
    if m3.params.len() >= 1 && m3.params[0].name == "self" then
      Option::Some(m3.params.len() - 1)
    else
      Option::Some(m3.params.len())
    end
  when Option::None then Option::None
  end
end

def field_target_of(env: &TypeEnv, recv_type: &Type, field: String) -> Option[FieldId]
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        var i = 0
        while i < fields.len() do
          if fields[i].name == field then
            return Option::Some(FieldId { owner: tid, index: i })
          end
          i = i + 1
        end
        Option::None
      when TypeDefKind::Alias(inner) then field_target_of(env, &inner, field)
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

# Resolve a struct field's TYPE from its FieldId (owner TypeId + index) —
# the ID-based counterpart of field_target_of. The FieldId is the semantic
# field identity (the same id recorded in typed_field_targets / field_targets);
# the field NAME is used only for diagnostics.
def field_type_by_id(env: &mut TypeEnv, recv_type: &Type, owner: TypeId, index: Int, field: String, span: Span) -> Type
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then
        # field_target_of resolved the alias chain, so the FieldId's owner is
        # the FINAL struct; recurse with the alias target so the generic
        # substitution below uses the struct's concrete instantiation args
        # (e.g. `typealias Duration = Timespec`), not the alias's own.
        return field_type_by_id(env, &inner, owner, index, field, span)
      when _ then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
  match base
  when Type::Adt(_, type_args) then
    match get_type_by_id_ref(env, &owner)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        if index >= 0 && index < fields.len() then
          # Substitute generic type parameters with the receiver's concrete
          # type arguments (e.g. Vec[Int].ptr is Ptr[Int], not Ptr[Param("T")]).
          subst_type_args(&fields[index].ty, &td.generic_params, &type_args)
        else
          type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
          Type::Error
        end
      when _ then
        type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
        Type::Error
      end
    when Option::None then
      type_add_error(env, "no field `" + field + "`", span)
      Type::Error
    end
  when _ then
    type_add_error(env, "no field `" + field + "`", span)
    Type::Error
  end
end

# The node the resolver keyed a call target under, given the callee
# expression: the resolver's call_targets are keyed by the CALLEE
# expression's AST node id (resolve_ident_expr / resolve_path record the
# ident/path node — the P0-AM node-id keying), never by the call node. An
# ident or a path callee is its own node; an access wrapper (ExprAccess)
# and an explicit-generic `f[T](...)` callee (ExprIndex — the base ident is
# the resolved callable, e.g. `size_of[T]()`) resolve through their inner
# node — the node the resolver actually keyed. -1 for callee shapes that
# carry no resolver key (a local closure value, a function-pointer field
# access, a computed callee) — the closure-call fallback in
# record_typed_hir applies for those.
def typed_callee_target_node(callee: &Expr) -> Int
  match callee.kind
  when ExprKind::ExprIdent(_) then callee.node_id
  when ExprKind::ExprPath(_) then callee.node_id
  when ExprKind::ExprAccess(inner) then typed_callee_target_node(&inner)
  when ExprKind::ExprIndex(base, _) then typed_callee_target_node(&base)
  when _ then -1
  end
end

# Bridge the resolver's callee-node keying into the typed call-target map's
# CALL-node keying: read the resolver's DefId under the callee's recorded
# node (typed_callee_target_node) and record it under the CALL node's id —
# the key typed_call_for and the MIR's call_def_ids consume. A callee with
# no resolver entry (a closure value, a function-pointer field access)
# records nothing — the missing-metadata rule: the construction never
# silently defaults the callee.
def record_typed_call_target(env: &mut TypeEnv, callee: &Expr, node_id: Int) -> Unit
  let target_node = typed_callee_target_node(callee)
  if target_node < 0 then return end
  var did_opt: Option[DefId] = Option::None
  match env.resolutions
  when Option::Some(res) then
    # P0-AM: the resolver's call_targets are keyed by AST node id — never
    # by span.
    match res.call_targets.get(target_node)
    when Option::Some(did) then did_opt = Option::Some(did)
    when Option::None then ()
    end
  when Option::None then ()
  end
  match did_opt
  when Option::Some(did) then env.typed_call_targets.insert(node_id, did)
  when Option::None then ()
  end
end

struct CaptureScan
  bound: Vec[Int]
  uses: Map[Int, AccessEffect]
  # Per capture-NODE effects (expression node id -> effect): the same
  # capture record keyed by the referencing node instead of the captured
  # local id — the source for the closure arm's typed_access_effects
  # entries (the missing-metadata rule: after the closure is typed, every
  # capture node's effect is recorded).
  nodes: Map[Int, AccessEffect]
end

def capture_effect_strength(e: AccessEffect) -> Int
  match e
  when AccessEffect::Consume then 3
  when AccessEffect::Modify then 2
  when AccessEffect::Initialize then 2
  when _ then 1
  end
end

def scan_capture_record(env: &TypeEnv, scan: &mut CaptureScan, node_id: Int, name: String, effect: AccessEffect) -> Unit
  let lid = local_id_of(env, name.clone())
  if lid >= 0 then
    if !scan.bound.contains(&lid) then
      match scan.uses.get(&lid)
      when Option::Some(cur) then
        if capture_effect_strength(effect) > capture_effect_strength(cur) then
          scan.uses.insert(lid, effect)
        end
      when Option::None then
        scan.uses.insert(lid, effect)
      end
      # The node-level record follows the same capture gate (unbound local)
      # and the same strength rule — a node that is BOTH a consuming call
      # argument and a plain ident read (scan_operand then scan_expr visit
      # it twice) keeps the stronger effect.
      if node_id != 0 then
        match scan.nodes.get(node_id)
        when Option::Some(cur) then
          if capture_effect_strength(effect) > capture_effect_strength(cur) then
            scan.nodes.insert(node_id, effect)
          end
        when Option::None then
          scan.nodes.insert(node_id, effect)
        end
      end
    end
  end
end

def scan_root_ident(expr: &Expr) -> Option[String]
  match expr.kind
  when ExprKind::ExprIdent(n) then Option::Some(n.clone())
  when ExprKind::ExprAccess(inner) then scan_root_ident(&inner)
  when ExprKind::ExprFieldAccess(base, _) then scan_root_ident(&base)
  when ExprKind::ExprIndex(base, _) then scan_root_ident(&base)
  when ExprKind::ExprRawDeref(inner) then scan_root_ident(&inner)
  when ExprKind::ExprCast(inner, _) then scan_root_ident(&inner)
  when _ then Option::None
  end
end

def scan_operand(env: &TypeEnv, scan: &mut CaptureScan, operand: &Expr) -> Unit
  match env.typed_access_effects.get(operand.node_id)
  when Option::Some(eff) then
    if eff == AccessEffect::Modify || eff == AccessEffect::Consume || eff == AccessEffect::Initialize then
      match scan_root_ident(operand)
      when Option::Some(name) then scan_capture_record(env, scan, operand.node_id, name, eff)
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
  scan_expr(env, scan, operand)
end

def scan_pattern_bind(env: &TypeEnv, scan: &mut CaptureScan, pat: &Pattern) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(name, _) then
    let lid = local_id_of(env, name.clone())
    if lid >= 0 then scan.bound.push(lid) end
  when PatternKind::Literal(e) then scan_expr(env, scan, &e)
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      scan_pattern_bind(env, scan, &field_pats[i].1)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      scan_pattern_bind(env, scan, &alts[i])
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
  end
end

def scan_block(env: &TypeEnv, scan: &mut CaptureScan, block: &Block) -> Unit
  var i = 0
  while i < block.stmts.len() do
    scan_stmt(env, scan, &block.stmts[i])
    i = i + 1
  end
end

def scan_if_stmt(env: &TypeEnv, scan: &mut CaptureScan, if_stmt: &IfStmt) -> Unit
  scan_expr(env, scan, &if_stmt.cond)
  scan_block(env, scan, &if_stmt.then_block)
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    scan_expr(env, scan, &if_stmt.elsif_branches[i].0)
    scan_block(env, scan, &if_stmt.elsif_branches[i].1)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then scan_block(env, scan, &eb)
  when Option::None then ()
  end
end

def scan_match_expr(env: &TypeEnv, scan: &mut CaptureScan, m: &MatchExpr) -> Unit
  scan_expr(env, scan, &m.scrutinee)
  var i = 0
  while i < m.arms.len() do
    scan_pattern_bind(env, scan, &m.arms[i].pattern)
    match m.arms[i].guard_expr
    when Option::Some(g) then scan_expr(env, scan, &g)
    when Option::None then ()
    end
    scan_block(env, scan, &m.arms[i].body)
    i = i + 1
  end
end

def scan_stmt(env: &TypeEnv, scan: &mut CaptureScan, stmt: &Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    scan_expr(env, scan, &value)
    scan_pattern_bind(env, scan, &pattern)
  when StmtKind::StmtAssign(target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, stmt.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, stmt.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when StmtKind::StmtIf(if_stmt) then scan_if_stmt(env, scan, &if_stmt)
  when StmtKind::StmtMatch(m) then scan_match_expr(env, scan, &m)
  when StmtKind::StmtWhile(cond, body) then
    scan_expr(env, scan, &cond)
    scan_block(env, scan, &body)
  when StmtKind::StmtFor(for_stmt) then
    scan_expr(env, scan, &for_stmt.iter)
    scan_pattern_bind(env, scan, &for_stmt.pattern)
    scan_block(env, scan, &for_stmt.body)
  when StmtKind::StmtLoop(body) then scan_block(env, scan, &body)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then
      match scan_root_ident(&val)
      when Option::Some(name) then scan_capture_record(env, scan, val.node_id, name, AccessEffect::Consume)
      when Option::None then ()
      end
      scan_expr(env, scan, &val)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then scan_expr(env, scan, &val)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtExpr(e) then scan_expr(env, scan, &e)
  when StmtKind::StmtUnsafe(_, body) then scan_block(env, scan, &body)
  when StmtKind::StmtDefer(body) then scan_block(env, scan, &body)
  when StmtKind::StmtGuard(cond, else_action) then
    scan_expr(env, scan, &cond)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then
        match scan_root_ident(&val)
        when Option::Some(name) then scan_capture_record(env, scan, val.node_id, name, AccessEffect::Consume)
        when Option::None then ()
        end
        scan_expr(env, scan, &val)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then scan_expr(env, scan, &val)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    scan_block(env, scan, &body)
    var i = 0
    while i < catches.len() do
      scan_pattern_bind(env, scan, &catches[i].pattern)
      scan_block(env, scan, &catches[i].body)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then scan_block(env, scan, &fb)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat, body) then
    scan_expr(env, scan, &expr)
    scan_pattern_bind(env, scan, &pat)
    scan_block(env, scan, &body)
  when StmtKind::StmtHandleWith(expr, handlers) then
    scan_expr(env, scan, &expr)
    var i = 0
    while i < handlers.len() do
      var j = 0
      while j < handlers[i].arms.len() do
        var k = 0
        while k < handlers[i].arms[j].params.len() do
          scan_pattern_bind(env, scan, &handlers[i].arms[j].params[k])
          k = k + 1
        end
        scan_block(env, scan, &handlers[i].arms[j].body)
        j = j + 1
      end
      i = i + 1
    end
  end
end

def scan_expr(env: &TypeEnv, scan: &mut CaptureScan, expr: &Expr) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprIdent(name) then scan_capture_record(env, scan, expr.node_id, name, AccessEffect::Read)
  when ExprKind::ExprSelfRef then scan_capture_record(env, scan, expr.node_id, "self".to_string(), AccessEffect::Read)
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprArrayLit(elems) then
    var i = 0
    while i < elems.len() do
      scan_expr(env, scan, &elems[i])
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    var i = 0
    while i < elems.len() do
      scan_expr(env, scan, &elems[i])
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    var i = 0
    while i < fields.len() do
      scan_expr(env, scan, &fields[i].1)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    # Record aggregate ownership (map literal keys AND values are owned
    # transfers) so the resource checker's aggregate_child_owned lookup is
    # always satisfied for typed aggregates.
    var map_owned = Vec::new()
    var mi0 = 0
    while mi0 < entries.len() * 2 do
      map_owned.push(true)
      mi0 = mi0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, map_owned)
    end
    var i = 0
    while i < entries.len() do
      scan_expr(env, scan, &entries[i].0)
      scan_expr(env, scan, &entries[i].1)
      i = i + 1
    end
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    scan_expr(env, scan, &lhs)
    scan_expr(env, scan, &rhs)
  when ExprKind::ExprUnaryOp(_, operand) then scan_expr(env, scan, &operand)
  when ExprKind::ExprFieldAccess(base, _) then scan_expr(env, scan, &base)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    scan_operand(env, scan, &recv)
    var i = 0
    while i < args.len() do
      scan_operand(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprIndex(base, index) then
    scan_expr(env, scan, &base)
    scan_expr(env, scan, &index)
  when ExprKind::ExprCall(func, args) then
    scan_expr(env, scan, &func)
    var i = 0
    while i < args.len() do
      scan_operand(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprClosure(params, _, body) then
    var i = 0
    while i < params.len() do
      scan_pattern_bind(env, scan, &params[i].pat)
      i = i + 1
    end
    scan_expr(env, scan, &body)
  when ExprKind::ExprAccess(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprRawDeref(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprIf(if_stmt) then scan_if_stmt(env, scan, &if_stmt)
  when ExprKind::ExprMatch(m) then scan_match_expr(env, scan, &m)
  when ExprKind::ExprBlock(block) then scan_block(env, scan, &block)
  when ExprKind::ExprUnsafe(_, block) then scan_block(env, scan, &block)
  when ExprKind::ExprAsync(block) then scan_block(env, scan, &block)
  when ExprKind::ExprAwait(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprTry(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then scan_expr(env, scan, &s)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then scan_expr(env, scan, &inner)
  when ExprKind::ExprTypeCheck(inner, _) then scan_expr(env, scan, &inner)
  when ExprKind::ExprComptime(block) then scan_block(env, scan, &block)
  when ExprKind::ExprEnumVariant(_, args) then
    var i = 0
    while i < args.len() do
      scan_expr(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, expr.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when ExprKind::ExprPipe(lhs, rhs) then
    scan_expr(env, scan, &lhs)
    scan_expr(env, scan, &rhs)
  when ExprKind::ExprMacroCall(_, args) then
    var i = 0
    while i < args.len() do
      scan_expr(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end
end

def scan_closure_captures(env: &TypeEnv, params: &Vec[ClosureParam], body: &Expr) -> CaptureScan
  var scan = CaptureScan { bound: Vec::new(), uses: Map::new(), nodes: Map::new() }
  var i = 0
  while i < params.len() do
    scan_pattern_bind(env, &mut scan, &params[i].pat)
    i = i + 1
  end
  scan_expr(env, &mut scan, body)
  scan
end

def captures_have_inout(caps: &Map[Int, AccessEffect]) -> Bool
  let entries = caps.entries()
  var i = 0
  while i < entries.len() do
    match entries[i].1
    when AccessEffect::Modify then return true
    when _ then ()
    end
    i = i + 1
  end
  false
end

def closure_has_inout_capture(env: &TypeEnv, node_id: Int) -> Bool
  match env.closure_captures.get(node_id)
  when Option::Some(caps) then captures_have_inout(&caps)
  when Option::None then false
  end
end

def callee_ident_name(expr: &Expr) -> Option[String]
  match expr.kind
  when ExprKind::ExprIdent(n) then Option::Some(n.clone())
  when ExprKind::ExprPath(p) then
    if p.segments.len() > 0 then
      Option::Some(p.segments[p.segments.len() - 1].clone())
    else
      Option::None
    end
  when _ then Option::None
  end
end

def is_async_marker(name: &String) -> Bool
  if name == "async" then return true end
  if name.starts_with("spawn") then return true end
  if name.starts_with("schedule") then return true end
  if name.starts_with("poll") then return true end
  false
end

def check_expr(env: &mut TypeEnv, expr: &Expr) -> Type
  let result = match expr.kind
  when ExprKind::ExprIntLit(_) then Type::Int
  when ExprKind::ExprFloatLit(_) then Type::Float
  when ExprKind::ExprStringLit(_) then Type::String
  when ExprKind::ExprCharLit(_) then Type::Char
  when ExprKind::ExprBoolLit(_) then Type::Bool
  when ExprKind::ExprNilLit then builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
  when ExprKind::ExprIdent(name) then
    match lookup_var(env, name)
    when Option::Some(ty) then
      let lid = local_id_of(env, name)
      env.typed_ident_resolutions.insert(expr.node_id, lid)
      # P0-A (final layer): a bare name resolved from the pass-3
      # program-level callable bindings (scope 0) goes through the
      # module-qualified identity check — the current module's own
      # definition wins when several modules define the name; otherwise an
      # ambiguous bare name is diagnosed and the first-wins entry is the
      # fallback (see resolve_bare_callable).
      if var_is_global_callable(env, &name) then
        resolve_bare_callable(env, name.clone(), expr.span, ty.clone())
      else
        ty
      end
    when Option::None then
      # Check if the name refers to a registered type (e.g., Vec in Vec::new(),
      # u8 in u8::MAX, etc.) — when a type name appears in expression position
      # as the receiver of a method call or path, treat it as a type reference.
      match get_type_by_name_ref(env, name)
      when Option::Some(type_def) then
        # Use canonical Type representation for primitives and compound types
        # (Int, String, Option, Slice, etc.) so unification with literal types
        # (e.g., Type::Int from ExprIntLit) works correctly instead of producing
        # "Named#XXX vs Int" errors.
        type_def_to_canonical(env, type_def)
      when Option::None then
        # Check if the name refers to an enum variant (e.g., Some, None, Ok, Err)
        # in expression position — treat bare variant names as constructor functions.
        match find_enum_variant(env, name)
        when Option::Some((enum_td, variant)) then
          # Construct a function type: (variant_field_types...) -> enum_type
          let enum_type_args = fresh_type_args_for(env, &enum_td)
          let enum_type = Type::Adt(enum_td.id, enum_type_args)
          var field_types = Vec::new()
          var fi = 0
          while fi < variant.fields.len() do
            field_types.push(subst_type_args(&variant.fields[fi], &enum_td.generic_params, &enum_type_args))
            fi = fi + 1
          end
          # A bare field-less variant in value position (e.g. `x: None`) is the
          # enum value itself; variants with fields yield constructor functions.
          if variant.fields.len() == 0 then
            enum_type
          else
            var fn_params = Vec::new()
            var fi2 = 0
            while fi2 < field_types.len() do
              fn_params.push(ParamType { ty: field_types[fi2], convention: AccessConvention::Let })
              fi2 = fi2 + 1
            end
            Type::Function(fn_params, enum_type)
          end
        when Option::None then
          # Unknown identifier: a name that survives type-name, enum-variant
          # and scope lookup is unresolvable. A fresh type variable here has
          # no equation to solve it and would let the construct silently
          # type-check (P0-N). Record a TypeError and produce Type::Error so
          # compilation aborts before codegen.
          type_add_error(env, "unknown symbol `" + name + "`", expr.span)
          Type::Error
        end
      end
    end
  when ExprKind::ExprSelfRef then
    match lookup_var(env, "self")
    when Option::Some(ty) then ty
    when Option::None then Type::Error
    end
  when ExprKind::ExprBinaryOp(op, left, right) then
    check_binary_op(env, op, &left, &right, expr.span)
  when ExprKind::ExprUnaryOp(op, inner) then
    check_unary_op(env, op, &inner, expr.span)
  when ExprKind::ExprCall(func, args) then
    let func_type = check_expr(env, &func)
    env.access_marker_depth = env.access_marker_depth + 1
    var arg_types = Vec::new()
    var i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    env.access_marker_depth = env.access_marker_depth - 1
    let ret_type = fresh_type_var(env)
    var call_was_generic = false
    match func_type
    when Type::Function(params, ret) then
      # FIX 1 (P0-F): explicit generic instantiation. Each generic parameter
      # of the callee is instantiated ONCE for the whole call to a fresh
      # inference variable (shared between parameters and return type), the
      # arguments unify against the instantiated signature, and the result
      # type is resolved through the solved substitution.
      var gvar_map: Map[Int, Type] = Map::new()
      # P0-AK (final): the callee's generic parameters in callee-signature
      # order — first occurrence across the parameter signature, then the
      # return type — the SAME walk order the monomorphizer's
      # infer_type_param_names uses, so the recorded substitution lines up
      # positionally with the instance's substs. P0-GPI: the collected
      # parameters are GenericParamIds (dedupe by id).
      var sig_param_names = Vec::new()
      var inst_params = Vec::new()
      var pi0 = 0
      while pi0 < params.len() do
        let pt = params[pi0]
        collect_param_names_from_type(env, &pt.ty, &mut sig_param_names)
        inst_params.push(ParamType { ty: instantiate_generic_type(env, &pt.ty, &mut gvar_map), convention: pt.convention })
        pi0 = pi0 + 1
      end
      # Snapshot the generic parameters that appear in the callee's argument
      # signature: only these must be solved by argument unification.
      # Parameters appearing only in the return type are solved by the
      # caller's context (`let v: Vec[Int] = Vec::new()` inference) — the
      # std's `__intrinsic_array_new[T]() -> Array[T]` calls rely on this.
      var arg_param_names = Vec::new()
      let snapshot_entries = gvar_map.entries()
      var sei = 0
      while sei < snapshot_entries.len() do
        arg_param_names.push(snapshot_entries[sei].0)
        sei = sei + 1
      end
      let inst_ret = instantiate_generic_type(env, &ret, &mut gvar_map)
      collect_param_names_from_type(env, &ret, &mut sig_param_names)
      # Enforce exact arity for non-variadic callables: every declared
      # parameter must have a supplied argument and every argument must
      # map to a declared parameter. Silently accepting extra arguments
      # (or missing ones) makes callable types unsound — a value of type
      # fn(Int) -> Int could be invoked with two arguments and vice versa.
      # (Default arguments are deprecated/unused in this codebase — no call
      # site omits a defaulted parameter — so exact equality is correct.)
      if args.len() != inst_params.len() then
        type_add_error(env, "wrong number of arguments: expected " +
          inst_params.len().to_string() + ", found " + args.len().to_string(), expr.span)
      end
      var pi = 0
      while pi < args.len() && pi < inst_params.len() do
        let pt = inst_params[pi]
        unify(env, arg_types[pi], pt.ty, args[pi].span)
        record_arg_effect(env, &args[pi], pt.convention)
        pi = pi + 1
      end
      unify(env, ret_type, inst_ret, expr.span)
      # FIX 1 verification: every generic parameter of the callee that
      # appears in the call's argument signature must be SOLVED after the
      # argument unification; an unsolved parameter (e.g. one that cannot be
      # inferred from the arguments) is a hard error.
      var gi = 0
      while gi < arg_param_names.len() do
        match gvar_map.get(arg_param_names[gi])
        when Option::Some(v) then
          match resolve_type_var(env, v)
          when Type::Var(_) then
            # P0-GPI: the parameter name comes from the param-name table
            # (numeric GenericParamId -> name), never from an identity
            # comparison.
            let gname = match env.generic_param_table.names.get(arg_param_names[gi])
            when Option::Some(n) then n.clone()
            when Option::None then "<param#" + arg_param_names[gi].to_string() + ">"
            end
            type_add_error(env, "cannot infer type parameter `" + gname + "`", expr.span)
          when _ then ()
          end
        when Option::None then ()
        end
        gi = gi + 1
      end
      if !gvar_map.is_empty() then
        call_was_generic = true
      end
      # P0-AK (final) / P0-AL: the SOLVED substitution is the AUTHORITY —
      # record it for this call node in the callee's generic-parameter
      # order. When EVERY generic parameter of the callee is solved at the
      # call site the instance is recorded immediately; a parameter solved
      # only by the CALLER's context (e.g. a return-type-only parameter
      # unified with the let-binding annotation AFTER the call) is parked
      # in pending_call_instances and re-resolved after the whole program
      # is checked (resolve_pending_call_instances), when the annotation
      # unifications have landed. ZERO-INFERENCE: a parameter no context
      # ever solves is reported by resolve_pending_call_instances
      # ("cannot infer type parameter `T`: add an annotation") — the
      # monomorphizer performs no call-site inference (fail-closed).
      # P0-AL ORDER (substs-order contract): the recorded substitution is
      # positionally aligned with the monomorphizer's
      # function_generic_param_names — MirFunction.generic_params, which
      # lower_function populated from the checker's generic_param_ids
      # record in DECLARATION order. The signature-appearance order (the
      # deleted infer_type_param_names walk) would swap a parameter whose
      # declaration order differs from its first-appearance order (e.g.
      # `def f[T, U](x: U)`) — the decl order is enumerated here from the
      # generic-param table's per-owner interned counts (the ids are
      # (owner, index) with index == declaration position); a parameter
      # that never appears in the signature gets a fresh variable and is
      # parked (reported unsolvable — fail-closed, never silently
      # dropped).
      if call_was_generic then
        var decl_names: Vec[GenericParamId] = Vec::new()
        var dsi = 0
        while dsi < sig_param_names.len() do
          let sp = sig_param_names[dsi]
          var owner_present = false
          var opi = 0
          while opi < decl_names.len() do
            if def_id_numeric(&decl_names[opi].owner) == def_id_numeric(&sp.owner) then owner_present = true end
            opi = opi + 1
          end
          if !owner_present then
            let owner_key = def_id_numeric(&sp.owner)
            let owner_count = match env.generic_param_table.counts.get(owner_key)
            when Option::Some(c) then c as Int
            when Option::None then 0
            end
            var oci = 0
            while oci < owner_count do
              decl_names.push(GenericParamId { owner: sp.owner.clone(), index: oci as UInt })
              oci = oci + 1
            end
          end
          dsi = dsi + 1
        end
        var all_solved = true
        var solved_args = Vec::new()
        var decl_vars = Vec::new()
        var dvi = 0
        while dvi < decl_names.len() do
          var var_found = false
          match gvar_map.get(generic_param_id_numeric(&decl_names[dvi]))
          when Option::Some(v) then
            var_found = true
            decl_vars.push(v.clone())
            let solved = resolve_type_var(env, v.clone())
            match solved
            when Type::Var(_) then all_solved = false
            when _ then solved_args.push(solved)
            end
          when Option::None then ()
          end
          if !var_found then
            # A declared parameter that never appears in the signature is
            # genuinely unconstrained: a fresh variable parks the call and
            # resolve_pending_call_instances reports it (fail-closed).
            decl_vars.push(fresh_type_var(env))
            all_solved = false
          end
          dvi = dvi + 1
        end
        if all_solved then
          env.typed_call_instances.insert(expr.node_id, solved_args)
        elsif decl_names.len() > 0 then
          env.pending_call_instances.insert(expr.node_id, (decl_names.clone(), decl_vars, expr.span))
        end
      end
      # Shared intrinsic reads (__intrinsic_array_get / __intrinsic_map_get)
      # return OWNED elements from a SHARED container — the same
      # resource-duplication hole as the get() methods. Reject them for
      # resource-containing element types (the intrinsic's first argument is
      # the container, so its element type decides).
      match callee_ident_name(&func)
      when Option::Some(cname) then
        # Copy-producing intrinsics are compiler-internal building blocks; a
        # DIRECT call on resource-containing element types is rejected here
        # (the std wrappers carry the same restriction via their `T: Copy`
        # bounds).
        # Operation-specific contracts: map_get copies V; map_entries copies
        # K AND V; map_keys would copy K; array_get/slice copy T.
        if cname == "__intrinsic_array_get" || cname == "__intrinsic_array_slice" ||
           cname == "__intrinsic_map_get" || cname == "__intrinsic_set_entries" then
          if args.len() >= 1 then
            match container_element_type(env, &arg_types[0])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        elsif cname == "__intrinsic_array_from_list" then
          # array_from_list copies OUT of a SHARED &[T] into a fresh
          # owning Array[T] — intrinsically copy-producing. The library
          # wrapper's `T: Copy` bound does not protect a direct user call.
          if args.len() >= 1 then
            match container_element_type(env, &arg_types[0])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        elsif cname == "__intrinsic_map_entries" then
          # map_entries materializes (K, V) pairs: a resource KEY is just as
          # duplicating as a resource value.
          if args.len() >= 1 then
            match arg_types[0]
            when Type::Adt(tid, args) then
              if tid.id == env.lang_items.map && args.len() >= 2 then
                if type_has_resource_kind(env, &args[0]) || type_has_resource_kind(env, &args[1]) then
                  type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
                end
              end
            when _ then ()
            end
          end
        elsif cname == "__intrinsic_array_extend" then
          # array_extend copies elements OUT of the SHARED source (args[1],
          # the second argument — the first is the inout target): the
          # duplication hole is the source's element type, exactly like
          # the slice()/clone() guards.
          if args.len() >= 2 then
            match container_element_type(env, &arg_types[1])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        end
      when Option::None then ()
      end
    when _ then
      var ri = 0
      while ri < args.len() do
        record_arg_effect(env, &args[ri], AccessConvention::Let)
        ri = ri + 1
      end
    end
    record_typed_call_target(env, &func, expr.node_id)
    match callee_ident_name(&func)
    when Option::Some(cname) then
      if is_async_marker(&cname) then
        var ai = 0
        while ai < args.len() do
          if closure_has_inout_capture(env, args[ai].node_id) then
            type_add_error(env, "inout capture cannot cross await", args[ai].span)
          end
          ai = ai + 1
        end
      end
    when Option::None then ()
    end
    if call_was_generic then
      # The result type uses the solved substitution: the fresh ret variable
      # is bound to the instantiated return type, so resolving it yields the
      # concrete instantiation.
      resolve_type_var(env, ret_type)
    else
      ret_type
    end
  when ExprKind::ExprMethodCall(recv, method, type_args, args) then
    env.access_marker_depth = env.access_marker_depth + 1
    let recv_type = check_expr(env, &recv)
    var arg_types = Vec::new()
    var i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    env.access_marker_depth = env.access_marker_depth - 1
    # Resolve explicit type arguments (e.g., cast[U] → resolve U)
    var method_type_args = Vec::new()
    var tai = 0
    while tai < type_args.len() do
      method_type_args.push(resolve_type_expr(env, &type_args[tai]))
      tai = tai + 1
    end
    # Look up method on receiver type with type args (P0-AK: the call's
    # node id threads the solved-substitution record into the generic
    # instantiation, see instantiate_method_type).
    let ret = resolve_method_type(env, &recv_type, method, &arg_types, &method_type_args, expr.node_id, expr.span)
    let mdid = method_def_for(env, &recv_type, method)
    match mdid
    when Option::Some(did) then env.typed_call_targets.insert(expr.node_id, did)
    when Option::None then ()
    end
    let mparams = find_method_params(env, &recv_type, method)
    match mparams
    when Option::Some(params) then
      if params.len() >= 1 then
        record_arg_effect(env, &recv, params[0].convention)
      else
        record_arg_effect(env, &recv, AccessConvention::Let)
      end
      # Enforce exact arity for method calls: the expected argument count is
      # the declared params minus the receiver (self), or the full param list
      # for self-less static-style methods. Accepting extra arguments (or
      # silently tolerating missing ones) makes method signatures unsound —
      # the same hole as plain ExprCall above.
      match find_method_expected_args(env, &recv_type, method)
      when Option::Some(expected) then
        if args.len() != expected then
          type_add_error(env, "wrong number of arguments: expected " +
            expected.to_string() + ", found " + args.len().to_string(), expr.span)
        end
      when Option::None then ()
      end
      # Shared extraction of resource elements is prohibited: methods like
      # get/iter/into_iter return owned elements (or iterators over them)
      # from a SHARED container, duplicating ownership of a linear resource
      # while the container stays live. Resource elements must be extracted
      # via inout/consuming access (pop/remove/take and inout iterators).
      if params.len() >= 1 && params[0].convention != AccessConvention::Inout then
        match container_element_type(env, &recv_type)
        when Option::Some(elem_ty) then
          if type_has_resource_kind(env, &elem_ty) &&
             (method == "get" || method == "iter" || method == "into_iter") then
            type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
          end
        when Option::None then ()
        end
      end
      var ai = 0
      while ai < args.len() && ai + 1 < params.len() do
        record_arg_effect(env, &args[ai], params[ai + 1].convention)
        ai = ai + 1
      end
    when Option::None then
      record_arg_effect(env, &recv, AccessConvention::Let)
      var ai2 = 0
      while ai2 < args.len() do
        record_arg_effect(env, &args[ai2], AccessConvention::Let)
        ai2 = ai2 + 1
      end
    end
    if is_async_marker(&method) then
      if closure_has_inout_capture(env, recv.node_id) then
        type_add_error(env, "inout capture cannot cross await", recv.span)
      end
      var mai = 0
      while mai < args.len() do
        if closure_has_inout_capture(env, args[mai].node_id) then
          type_add_error(env, "inout capture cannot cross await", args[mai].span)
        end
        mai = mai + 1
      end
    end
    ret
  when ExprKind::ExprFieldAccess(recv, field) then
    let recv_type = check_expr(env, &recv)
    let fdid = field_target_of(env, &recv_type, field)
    # The FieldId (owner TypeId + index) is the semantic field identity: it is
    # recorded in typed_field_targets (Map[Int, FieldId]) and the field's type
    # is resolved BY ID from it. The name-based resolve_field_type remains
    # only for access forms that carry no FieldId (tuple indices,
    # String/Slice/Array len/cap) and for diagnostics.
    match fdid
    when Option::Some(fid) then
      env.typed_field_targets.insert(expr.node_id, fid.clone())
      field_type_by_id(env, &recv_type, fid.owner.clone(), fid.index, field, expr.span)
    when Option::None then
      resolve_field_type(env, &recv_type, field, expr.span)
    end
  when ExprKind::ExprIndex(recv, index) then
    let recv_type = check_expr(env, &recv)
    let index_type = check_expr(env, &index)
    # Indexing is an inherently SHARED read that returns the element by
    # value; extracting a resource element this way would create a second
    # owned resource while the container remains live. Resource elements
    # must be extracted through inout/consuming access (e.g. pop/remove/
    # take).
    match recv_type
    when Type::String then
      unify(env, index_type, Type::Int, index.span)
      Type::Char
    when Type::FixedArray(elem, _) then
      # Fixed-array indexing: Int index, element result (the count lives in
      # the type; the MIR/codegen index the inline base + idx * stride).
      if type_has_resource_kind(env, &elem) then
        type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
      end
      unify(env, index_type, Type::Int, index.span)
      elem.clone()
    when Type::Adt(tid, args) then
      # Map[K, V] indexing: key type K, result V. Array/Slice index like
      # their element containers (element result, Int index); Set membership
      # returns Bool. The LangItems TypeIds select the builtins.
      if tid.id == env.lang_items.map && args.len() >= 2 then
        if type_has_resource_kind(env, &args[1]) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
        end
        unify(env, index_type, args[0].clone(), index.span)
        args[1].clone()
      elsif (tid.id == env.lang_items.array || tid.id == env.lang_items.slice) && args.len() >= 1 then
        if type_has_resource_kind(env, &args[0]) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
        end
        unify(env, index_type, Type::Int, index.span)
        args[0].clone()
      elsif tid.id == env.lang_items.set && args.len() >= 1 then
        unify(env, index_type, args[0].clone(), index.span)
        Type::Bool
      else
        unify(env, index_type, Type::Int, index.span)
        fresh_type_var(env)
      end
    when _ then
      unify(env, index_type, Type::Int, index.span)
      fresh_type_var(env)
    end
  when ExprKind::ExprAccess(inner) then
    if env.access_marker_depth == 0 then
      type_add_error(env, "access marker '&' is only valid as a call argument", expr.span)
      Type::Error
    else
      check_expr(env, &inner)
    end
  when ExprKind::ExprRawDeref(inner) then
    let inner_type = check_expr(env, &inner)
    match inner.kind
    when ExprKind::ExprIdent(_) then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if td.name == "Ptr" && args.len() >= 1 then
            args[0].clone()
          else
            type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
            inner_type
          end
        when Option::None then
          type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
          inner_type
        end
      when _ then
        type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
        inner_type
      end
    when ExprKind::ExprSelfRef then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if td.name == "Ptr" && args.len() >= 1 then
            args[0].clone()
          else
            type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
            inner_type
          end
        when Option::None then
          type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
          inner_type
        end
      when _ then
        type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
        inner_type
      end
    when _ then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if td.name == "Ptr" && args.len() >= 1 then args[0].clone() else inner_type end
        when Option::None then inner_type
        end
      when _ then inner_type
      end
    end
  when ExprKind::ExprArrayLit(elems) then
    # Record aggregate ownership: every element is an owned transfer into the
    # array (consumed by the resource checker via typed.aggregate_ownership).
    var arr_owned = Vec::new()
    var ai0 = 0
    while ai0 < elems.len() do
      arr_owned.push(true)
      ai0 = ai0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, arr_owned)
    end
    if elems.is_empty() then
      # The empty array literal is the Adt form of the registered Array
      # builtin (LangItems id); the element is a fresh inference variable.
      Type::Adt(TypeId { id: env.lang_items.array }, [fresh_type_var(env)])
    else
      let elem_type = check_expr(env, &elems[0])
      var i = 1
      while i < elems.len() do
        let t = check_expr(env, &elems[i])
        unify(env, elem_type, t, elems[i].span)
        i = i + 1
      end
      # The generic array literal is the heap-vector Adt form (the named
      # Array[T]); a FixedArray-typed literal is produced when the literal
      # unifies with a [T; N] annotation (the distinct Type::FixedArray
      # variant).
      Type::Adt(TypeId { id: env.lang_items.array }, [elem_type])
    end
  when ExprKind::ExprTupleLit(elems) then
    var tup_owned = Vec::new()
    var ti0 = 0
    while ti0 < elems.len() do
      tup_owned.push(true)
      ti0 = ti0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, tup_owned)
    end
    var types = Vec::new()
    var i = 0
    while i < elems.len() do
      types.push(check_expr(env, &elems[i]))
      i = i + 1
    end
    Type::Tuple(types)
  when ExprKind::ExprStructLit(path, fields) then
    # Record aggregate ownership: struct literal field values are owned
    # transfers into the struct (consumed by the resource checker via
    # typed.aggregate_ownership).
    var st_owned = Vec::new()
    var so0 = 0
    while so0 < fields.len() do
      st_owned.push(true)
      so0 = so0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, st_owned)
    end
    let type_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    match get_type_by_name_ref(env, type_name)
    when Option::Some(type_def) then
      # Use fresh type vars for generic params so unification works correctly
      let type_args = fresh_type_args_for(env, type_def)
      # Check struct literal field values against struct field types
      match type_def.def_kind
      when TypeDefKind::Struct(struct_fields) then
        # Track which declared fields have been initialized in the literal
        var seen = Vec::new()
        var si0 = 0
        while si0 < struct_fields.len() do
          seen.push(false)
          si0 = si0 + 1
        end
        var fi = 0
        while fi < fields.len() do
          let lit_field = fields[fi]
          var found = false
          var sj = 0
          while sj < struct_fields.len() do
            let sf = struct_fields[sj]
            if sf.name == lit_field.0 then
              if seen[sj] then
                type_add_error(env, "duplicate field `" + lit_field.0 + "` in struct literal", lit_field.1.span)
              end
              seen.set(sj, true)
              found = true
              let field_ty = subst_type_args(&sf.ty, &type_def.generic_params, &type_args)
              let field_val_ty = check_expr(env, &lit_field.1)
              unify(env, field_val_ty, field_ty, lit_field.1.span)
            end
            sj = sj + 1
          end
          if !found then
            type_add_error(env, "unknown field `" + lit_field.0 + "` on `" + type_name + "`", lit_field.1.span)
          end
          fi = fi + 1
        end
        # Every declared field must appear exactly once in the literal
        var mi = 0
        while mi < struct_fields.len() do
          if !seen[mi] then
            type_add_error(env, "missing required field `" + struct_fields[mi].name + "` on `" + type_name + "`", path.span)
          end
          mi = mi + 1
        end
      when _ then ()
      end
      Type::Adt(type_def.id, type_args)
    when Option::None then
      # Struct-style enum variant construction: Enum::Variant { field: value }.
      let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
      match get_type_by_name_ref(env, enum_name)
      when Option::Some(enum_def) then
        let enum_type_args = fresh_type_args_for(env, enum_def)
        var found_variant = false
        match enum_def.def_kind
        when TypeDefKind::Enum(variants) then
          var vi = 0
          while vi < variants.len() do
            let variant = variants[vi]
            if variant.name == type_name then
              found_variant = true
              var fi2 = 0
              while fi2 < fields.len() do
                let lit_field2 = fields[fi2]
                # Variant fields are checked positionally; the checker's
                # VariantInfo does not retain struct-variant field names.
                if fi2 < variant.fields.len() then
                  let field_ty2 = subst_type_args(&variant.fields[fi2], &enum_def.generic_params, &enum_type_args)
                  let field_val_ty2 = check_expr(env, &lit_field2.1)
                  unify(env, field_val_ty2, field_ty2, lit_field2.1.span)
                else
                  type_add_error(env, "too many fields for variant `" + type_name + "`", lit_field2.1.span)
                end
                fi2 = fi2 + 1
              end
            end
            vi = vi + 1
          end
        when _ then ()
        end
        if !found_variant then
          type_add_error(env, "unknown variant `" + type_name + "` in enum `" + enum_name + "`", expr.span)
        end
        Type::Adt(enum_def.id, enum_type_args)
      when Option::None then
        type_add_error(env, "undefined type: " + type_name, expr.span)
        Type::Error
      end
    end
  when ExprKind::ExprClosure(params, ret_ty, body) then
    push_scope(env)
    var param_types = Vec::new()
    var i = 0
    while i < params.len() do
      let p = params[i]
      let ty = match p.ty
      when Option::Some(te) then resolve_type_expr(env, &te)
      when Option::None then fresh_type_var(env)
      end
      # P0-Q: the closure parameter pattern's variant identity is resolved
      # by the junction; the binding's source place is the call-site
      # argument (unknown at the closure definition — RawUnknown).
      resolve_pattern_variants(env, &p.pat, ty)
      check_pattern(env, &p.pat, ty, TypedPlace { root: AccessRoot::RawUnknown, root_name: "closure parameter", projections: Vec::new() })
      param_types.push(ParamType { ty: ty, convention: AccessConvention::Let })
      i = i + 1
    end
    # The closure body is checked as a FUNCTION body (the closure lowers to
    # its own MirFunction): the declared return type (ret_ty) is resolved
    # and every `return` in the body unifies against it — the same
    # expected_return discipline as check_function. Without an annotation,
    # the closure's return type is a fresh inference variable that the
    # body's returns and its tail unify against, so they must agree. The
    # enclosing function's expected_return is restored afterwards (closures
    # nest inside function bodies).
    let saved_expected_return = env.expected_return.clone()
    let decl_ret = match ret_ty
    when Option::Some(te) then Option::Some(resolve_type_expr(env, &te))
    when Option::None then Option::None
    end
    let closure_ret = match decl_ret
    when Option::Some(dr) then dr
    when Option::None then fresh_type_var(env)
    end
    env.expected_return = Option::Some(closure_ret.clone())
    let body_type = check_expr(env, &body)
    unify(env, body_type, closure_ret.clone(), body.span)
    env.expected_return = saved_expected_return
    # The capture scan runs AFTER the body check, so the body's recorded
    # call-argument effects (typed_access_effects) feed the Consume/Modify
    # capture records (scan_operand). uses = captured local id -> effect
    # (the closure_captures record); nodes = capture-node id -> effect.
    let scan = scan_closure_captures(env, &params, &body)
    env.closure_captures.insert(expr.node_id, scan.uses)
    # Missing-metadata rule: every capture node's effect is recorded in
    # typed_access_effects (insert-only — a node that is ALSO a call
    # argument keeps its recorded argument effect).
    let node_entries = scan.nodes.entries()
    var ni = 0
    while ni < node_entries.len() do
      match env.typed_access_effects.get(node_entries[ni].0)
      when Option::Some(_) then ()
      when Option::None then env.typed_access_effects.insert(node_entries[ni].0, node_entries[ni].1)
      end
      ni = ni + 1
    end
    pop_scope(env)
    Type::Function(param_types, closure_ret)
  when ExprKind::ExprIf(if_stmt) then
    # P0-M: an if used as a value contributes its flow's normal type (with
    # the Unit false-path rule for a missing else enforced inside).
    check_if_stmt(env, &if_stmt, false).normal
  when ExprKind::ExprMatch(m) then
    # P0-M: a value-producing match contributes its flow's normal type.
    # P1 (FIX 3): non-exhaustive matches over closed enums are errors in
    # statement position too (see check_match).
    check_match(env, &m, false).normal
  when ExprKind::ExprBlock(block) then
    check_block(env, &block, true).normal
  when ExprKind::ExprUnsafe(_, block) then
    check_block(env, &block, true).normal
  when ExprKind::ExprAsync(block) then
    let inner = check_block(env, &block, true).normal
    inner  # In full impl, would wrap in Future/Async
  when ExprKind::ExprAwait(inner) then
    let inner_type = check_expr(env, &inner)
    if closure_has_inout_capture(env, inner.node_id) then
      type_add_error(env, "inout capture cannot cross await", inner.span)
    else
      match inner.kind
      when ExprKind::ExprAccess(inner2) then
        if closure_has_inout_capture(env, inner2.node_id) then
          type_add_error(env, "inout capture cannot cross await", inner2.span)
        end
      when _ then ()
      end
    end
    fresh_type_var(env)
  when ExprKind::ExprTry(inner) then
    # P0-EX: the postfix `?` operator is NOT an exceptional construct in
    # this language: no throw/raise expression exists, no error propagation
    # is modeled at any level, and the resource CFG has no Throw/Unwind
    # edges for it. Its semantics are ERASURE — the operand's value, typed
    # here as an unconstrained fresh variable (the value's use sites
    # constrain it; MIR infers the operand type and lowers it as the
    # operand). The block exceptional forms (try/catch/finally,
    # handle/with, with) are REJECTED in check_stmt above; `?` must keep
    # type-checking because the compiler kernel itself uses it (e.g.
    # `parse_toml(s)?`).
    let inner_type = check_expr(env, &inner)
    fresh_type_var(env)
  when ExprKind::ExprCast(inner, ty) then
    check_expr(env, &inner)
    resolve_type_expr(env, &ty)
  when ExprKind::ExprTypeCheck(inner, ty) then
    check_expr(env, &inner)
    Type::Bool
  when ExprKind::ExprPipe(left, right) then
    check_expr(env, &left)
    check_expr(env, &right)
  when ExprKind::ExprRange(start, end_, _) then
    # The range expression (the `for i in lo..hi` iterable and value-range
    # positions): an Int-typed value; the bounds are checked and unified
    # with Int. The MIR lowers ranges structurally (the for-loop
    # desugaring reads the bounds directly), and the resource checker's
    # IterationPlan classifies the range form (source kind 3).
    match start
    when Option::Some(s) then
      let st = check_expr(env, &s)
      unify(env, st, Type::Int, s.span)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then
      let et = check_expr(env, &e)
      unify(env, et, Type::Int, e.span)
    when Option::None then ()
    end
    Type::Int
  when ExprKind::ExprMapLit(entries) then
    # Map literal — REJECTED at check time with an explicit diagnostic:
    # the MIR has no map-literal lowering, so an accepted literal would
    # fail only at lowering. The entries are still visited for error
    # recovery, then the construct is rejected before MIR (never an
    # Unsupported node).
    var i = 0
    while i < entries.len() do
      check_expr(env, &entries[i].0)
      check_expr(env, &entries[i].1)
      i = i + 1
    end
    type_add_error(env, "map literals are not supported: use Map::new() and insert", expr.span)
    Type::Error
  when ExprKind::ExprAssign(target, value) then
    # Assignment EXPRESSIONS share the statement-assignment semantics
    # (drop old -> store new; the MIR keys the drop chain on the
    # expression's node id); the expression's value is the stored value.
    let target_type = check_expr(env, &target)
    let value_type = check_expr(env, &value)
    unify(env, target_type, value_type, value.span)
    value_type
  when ExprKind::ExprMacroCall(name, args) then
    if name == "vec" then
      # vec![...] — the heap-vector Adt (the same result the MIR's vec
      # lowering produces); the payload elements are consumed into the
      # vector (the Consume records mirror the ExprEnumVariant payload
      # rule, so the MIR's argument-effect lookups are always satisfied).
      if args.len() > 0 then
        let elem_ty = check_expr(env, &args[0])
        var i = 1
        while i < args.len() do
          let t = check_expr(env, &args[i])
          unify(env, elem_ty, t, args[i].span)
          i = i + 1
        end
        var ai = 0
        while ai < args.len() do
          env.typed_access_effects.insert(args[ai].node_id, AccessEffect::Consume)
          ai = ai + 1
        end
        Type::Adt(TypeId { id: env.lang_items.vec }, [elem_ty])
      else
        Type::Adt(TypeId { id: env.lang_items.vec }, [fresh_type_var(env)])
      end
    else
      type_add_error(env, "unsupported macro invocation `" + name + "`", expr.span)
      Type::Error
    end
  when ExprKind::ExprPath(path) then
    match lookup_var(env, path.segments[0])
    when Option::Some(ty) then
      # P0-A (final layer): a path whose first segment is a program-level
      # callable (scope 0) goes through the module-qualified identity check,
      # same as bare ExprIdent (see resolve_bare_callable).
      if var_is_global_callable(env, &path.segments[0]) then
        resolve_bare_callable(env, path.segments[0].clone(), expr.span, ty.clone())
      else
        ty
      end
    when Option::None then
      # Enum variant paths in value position (e.g. `Option::None`): type the
      # expression from the OWNER enum's TypeId. The variant name is only the
      # join key into the checker's tables; the semantic result is id-based
      # (Type::Adt(enum_td.id, ...); the builtin Option/Result enums resolve
      # their LangItems ids via builtin_adt).
      if path.segments.len() >= 2 then
        let variant_name = path.segments[path.segments.len() - 1]
        let enum_name = path.segments[path.segments.len() - 2]
        match find_enum_variant(env, variant_name.clone())
        when Option::Some((enum_td, _)) then
          if enum_td.name == enum_name then
            let enum_type_args = fresh_type_args_for(env, &enum_td)
            if enum_td.name == "Result" then
              builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            elsif enum_td.name == "Option" then
              builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
            else
              Type::Adt(enum_td.id, enum_type_args)
            end
          else
            fresh_type_var(env)
          end
        when Option::None then fresh_type_var(env)
        end
      else
        fresh_type_var(env)
      end
    end
  when ExprKind::ExprEnumVariant(path, args) then
    # ID-based variant typing: find_enum_variant locates the OWNER enum by
    # variant name (the only join key between the source text and the
    # checker's type tables), and the semantic result type is built from the
    # owner's TypeId — Type::Adt(td.id, ...) for user enums; the builtin
    # Option/Result enums resolve their LangItems ids via builtin_adt. The
    # variant name never decides the result type.
    let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
    match find_enum_variant(env, variant_name.clone())
    when Option::Some((enum_td, variant)) then
      # Exact-arity rule for enum variant construction: the number of
      # supplied payload arguments must equal the variant's declared field
      # count (the same soundness requirement as function calls).
      if args.len() != variant.fields.len() then
        type_add_error(env, "wrong number of arguments: variant `" + variant_name + "` expects " +
          variant.fields.len().to_string() + " field(s), found " + args.len().to_string(), expr.span)
      end
      let enum_type_args = fresh_type_args_for(env, &enum_td)
      # P0-ARGS (PHASE-2, item 5): every payload argument is visited and
      # typed on the standard expression path, so each arg's type is
      # recorded in typed_expr_types — the vec![..] / Vec::from([..])
      # element nodes and enum-variant payload args are the entries the MIR
      # lowering consumes. The expected arg type is the variant's field type
      # with the enum's generic parameters substituted by the construction's
      # concrete args (the same substitution the ExprIdent constructor path
      # performs), so the construction's type args are solved from the
      # payload.
      var ai = 0
      while ai < args.len() do
        let arg_ty = check_expr(env, &args[ai])
        # The payload args of a variant construction are consumed INTO the
        # variant (the construction owns them): every payload arg node
        # records AccessEffect::Consume — the record_arg_effect mirror —
        # so the MIR's call_arg_effect source-arg fallback is deletable.
        env.typed_access_effects.insert(args[ai].node_id, AccessEffect::Consume)
        if ai < variant.fields.len() then
          let field_ty = subst_type_args(&variant.fields[ai], &enum_td.generic_params, &enum_type_args)
          unify(env, arg_ty, field_ty, args[ai].span)
        end
        ai = ai + 1
      end
      if enum_td.name == "Result" then
        builtin_adt(env, "Result".to_string(), enum_type_args)
      elsif enum_td.name == "Option" then
        builtin_adt(env, "Option".to_string(), enum_type_args)
      else
        Type::Adt(enum_td.id, enum_type_args)
      end
    when Option::None then
      # The variant is not registered in any checker-known enum: fall back
      # to the builtin Adt forms by name (diagnostic-grade fallback only;
      # builtin_adt resolves the LangItems ids). The arguments are still
      # visited and typed on the standard expression path so their
      # typed_expr_types entries exist — the vec! / Vec::from([..])
      # array-literal (and through it every element) node goes through this
      # fallback, since Vec is a struct and `from` is no registered variant.
      var arg_tys = Vec::new()
      var ai2 = 0
      while ai2 < args.len() do
        arg_tys.push(check_expr(env, &args[ai2]))
        # The unregistered-form fallback (vec![..] / Vec::from([..]) — the
        # array-literal payload arg) consumes the payload the same way: the
        # arg node records AccessEffect::Consume into the construction (the
        # literal's elements are consumed into the array by the
        # array-literal aggregate-ownership record).
        env.typed_access_effects.insert(args[ai2].node_id, AccessEffect::Consume)
        ai2 = ai2 + 1
      end
      # P0-AL (static-path call shape): an ExprEnumVariant whose "variant"
      # is not a registered enum variant is an ASSOCIATED-METHOD call
      # (Vec::new() / Map::new() / ...). Resolve the method through the
      # impl registry by the OWNER TYPE's TypeId (the method_lookup index —
      # the same O(1) candidate source the receiver-style method calls use;
      # "Vec" retries as the registered "Array" — the std's heap-vector
      # impl is `impl[T] Array[T]`), instantiate the signature (impl +
      # method params in the merged declaration order), unify the payload
      # args transactionally, and record the call TARGET (the method's
      # resolver DefId — the identity the MIR's method_def_ids carries) and
      # the SOLVED substitution in the merged declaration order (the
      # monomorphizer's positional contract); a parameter solved only by
      # the caller's context is parked (resolve_pending_call_instances). A
      # head mismatch (e.g. Vec::from's `&[T]` param vs a literal payload —
      # the MIR's vec-like lowering owns that shape) falls through to the
      # unregistered-form fallback below — never an error here.
      var static_ret: Option[Type] = Option::None
      if path.segments.len() >= 2 then
        let owner_type_name = path.segments[path.segments.len() - 2].clone()
        var owner_candidates = Vec::new()
        owner_candidates.push(owner_type_name.clone())
        if owner_type_name == "Vec" then
          owner_candidates.push("Array".to_string())
        end
        var oc = 0
        while oc < owner_candidates.len() && !static_ret.is_some() do
          match get_type_id_by_name(env, owner_candidates[oc].clone())
          when Option::Some(owner_tid) then
            match env.method_lookup.get(owner_tid.id)
            when Option::Some(mmap) then
              match mmap.get(variant_name.clone())
              when Option::Some(cands) then
                var cj = 0
                while cj < cands.len() && !static_ret.is_some() do
                  let imp = env.impls[cands[cj]]
                  var mj = 0
                  while mj < imp.methods.len() && !static_ret.is_some() do
                    let m = imp.methods[mj]
                    if m.name == variant_name then
                      # One fresh inference variable per declared generic
                      # parameter, in the merged declaration order (impl
                      # decl ++ method decl).
                      var sp_impl_vars = Vec::new()
                      var siv = 0
                      while siv < imp.generic_params.len() do
                        sp_impl_vars.push(fresh_type_var(env))
                        siv = siv + 1
                      end
                      var sp_met_vars = Vec::new()
                      var smv = 0
                      while smv < m.generic_params.len() do
                        sp_met_vars.push(fresh_type_var(env))
                        smv = smv + 1
                      end
                      var sp_names: Vec[GenericParamId] = Vec::new()
                      var sp_vars = Vec::new()
                      var sk = 0
                      while sk < imp.generic_params.len() do
                        sp_names.push(imp.generic_params[sk].clone())
                        sp_vars.push(sp_impl_vars[sk].clone())
                        sk = sk + 1
                      end
                      var sk2 = 0
                      while sk2 < m.generic_params.len() do
                        sp_names.push(m.generic_params[sk2].clone())
                        sp_vars.push(sp_met_vars[sk2].clone())
                        sk2 = sk2 + 1
                      end
                      var sp_inst_params = Vec::new()
                      var spi = 0
                      while spi < m.params.len() do
                        sp_inst_params.push(ParamType { ty: subst_type_args(&m.params[spi].ty, &sp_names, &sp_vars), convention: m.params[spi].convention })
                        spi = spi + 1
                      end
                      let sp_inst_ret = subst_type_args(&m.ret_type, &sp_names, &sp_vars)
                      # Transactional payload unification: a head mismatch
                      # rolls the whole attempt back and falls through.
                      var sp_arg_ok = true
                      var sai = 0
                      while sai < args.len() do
                        if sai < sp_inst_params.len() then
                          let sp_snap = subst_snapshot(env)
                          let sp_errs = env.errors.len()
                          let sp_uok = try_head_unify(env, arg_tys[sai].clone(), sp_inst_params[sai].ty.clone())
                          if sp_uok then
                            ()
                          else
                            subst_restore(env, &sp_snap)
                            errors_truncate(env, sp_errs)
                            sp_arg_ok = false
                            break
                          end
                        end
                        sai = sai + 1
                      end
                      if sp_arg_ok then
                        # The call target: the method's resolver DefId (the
                        # identity the MIR's method_def_ids / call-site
                        # instances carry).
                        match imp.method_defs.get(variant_name.clone())
                        when Option::Some(sp_mdid) then
                          env.typed_call_targets.insert(expr.node_id, sp_mdid.clone())
                        when Option::None then ()
                        end
                        # The solved substitution in the merged declaration
                        # order; an unsolved parameter (a return-type-only
                        # one solved by the caller's annotation context)
                        # parks the call.
                        var sp_all_solved = true
                        var sp_solved = Vec::new()
                        var sp_svi = 0
                        while sp_svi < sp_vars.len() do
                          let sp_rv = resolve_type_var(env, sp_vars[sp_svi].clone())
                          match sp_rv
                          when Type::Var(_) then sp_all_solved = false
                          when _ then sp_solved.push(sp_rv)
                          end
                          sp_svi = sp_svi + 1
                        end
                        if sp_all_solved then
                          env.typed_call_instances.insert(expr.node_id, sp_solved)
                        elsif sp_names.len() > 0 then
                          env.pending_call_instances.insert(expr.node_id, (sp_names.clone(), sp_vars, expr.span))
                        end
                        static_ret = Option::Some(resolve_type_var(env, sp_inst_ret))
                      end
                    end
                    mj = mj + 1
                  end
                  cj = cj + 1
                end
              when Option::None then ()
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
          oc = oc + 1
        end
      end
      match static_ret
      when Option::Some(rt) then rt
      when Option::None then
        let v1 = fresh_type_var(env)
        if variant_name == "Ok" || variant_name == "Err" then
          builtin_adt(env, "Result".to_string(), [v1, fresh_type_var(env)])
        elsif variant_name == "Some" || variant_name == "None" then
          builtin_adt(env, "Option".to_string(), [v1])
        else
          fresh_type_var(env)
        end
      end
    end
  when ExprKind::ExprComptime(block) then
    # Rejected at check time with an explicit diagnostic: the MIR has no
    # comptime lowering, so an accepted block would fail only at lowering.
    # The block is still visited for error recovery, then the construct is
    # rejected before MIR (never an Unsupported node).
    check_block(env, &block, true)
    type_add_error(env, "comptime blocks are not supported", expr.span)
    Type::Error
  when _ then Type::Error
  end
  if expr.node_id != 0 then
    env.typed_expr_types.insert(expr.node_id, result.clone())
    record_typed_hir(env, expr, &result)
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Field and Method Resolution
# ———————————————————————————————————————————————————————————————

def resolve_field_type(env: &mut TypeEnv, recv_type: &Type, field: String, span: Span) -> Type
  # Guard: if receiver is Error type, propagate silently
  match recv_type
  when Type::Error then return Type::Error
  when _ then ()
  end

  # Auto-deref through references
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end

  # Guard: if base after deref is Error, return Error
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  match base
  when Type::Adt(tid, type_args) then
    # Direct lookup by TypeId via type_list vec
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      # The Slice/Array Adt field surface mirrors the dropped canonical
      # Type::Slice/Type::Array arms, selected by LangItems TypeId. Slice is
      # the two-field VIEW { ptr: Ptr[T], len: UInt } — len is its only
      # accessor field (there is NO capacity on a view).
      if tid.id == env.lang_items.slice then
        if field == "len" then Type::Int
        else fresh_type_var(env)
        end
      elsif tid.id == env.lang_items.array then
        if field == "len" then Type::Int
        else fresh_type_var(env)
        end
      else
        match td.def_kind
      when TypeDefKind::Struct(fields) then
        for f in fields do
          if f.name == field then
            # Substitute generic type parameters with concrete type arguments.
            # e.g., for Vec[T], field "ptr" has stored type Param("T"), but if
            # accessed on Vec[Int], should return Int, not Param("T").
            return subst_type_args(&f.ty, &td.generic_params, &type_args)
          end
        end
        type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
        Type::Error
      when TypeDefKind::Alias(inner) then
        # Resolve type alias and retry field lookup on the aliased type.
        # e.g., Duration is a typealias for Timespec (a struct with fields).
        resolve_field_type(env, &inner, field, span)
      when TypeDefKind::Trait(_) then
        # Trait types don't have fields directly - return fresh type var
        # (e.g., Iterator[T] used in for-loop desugaring)
        fresh_type_var(env)
      when TypeDefKind::Enum(_) then
        # Enum types don't have fields directly - return fresh type var
        fresh_type_var(env)
      when _ then
        # Primitive, Opaque, etc. - return fresh type var
        fresh_type_var(env)
      end
      end
    when Option::None then fresh_type_var(env)
    end
  when Type::Tuple(fields) then
    # Tuple field access by numeric index (e.g., .0, .1); map entries also
    # support .key/.value as aliases for .0/.1.
    let field_idx = if field == "key" then "0" else field end
    let field_idx2 = if field == "value" then "1" else field_idx end
    match field_idx2.parse_int()
    when Result::Ok(idx) then
      if idx >= 0 && idx < fields.len() then
        fields[idx].clone()
      else
        type_add_error(env, "tuple index out of bounds: " + field, span)
        Type::Error
      end
    when Result::Err(_) then
      type_add_error(env, "tuple fields must be accessed by index", span)
      Type::Error
    end
  when Type::String then
    # String built-in fields
    if field == "len" then Type::Int
    else
      type_add_error(env, "no field `" + field + "` on String", span)
      Type::Error
    end
  when Type::Var(_) then fresh_type_var(env)
  when Type::Function(_, _) then fresh_type_var(env)
  when Type::Bool then Type::Bool
  when Type::Int then Type::Int
  when Type::U8 then Type::U8
  when Type::U16 then Type::U16
  when Type::U32 then Type::U32
  when Type::U64 then Type::U64
  when Type::I8 then Type::I8
  when Type::I16 then Type::I16
  when Type::I32 then Type::I32
  when Type::I64 then Type::I64
  when Type::F32 then Type::F32
  when Type::F64 then Type::F64
  when Type::Char then Type::Char
  when Type::Never then Type::Never
  when Type::Error then Type::Error
  when _ then
    fresh_type_var(env)
  end
end

# Helper: check whether an impl's for_type matches a receiver type.
# Both are expected to be Type::Adt; we compare the TypeId (ignoring type args,
# since the impl's for_type may have generic params like Param("T") while the
# receiver has concrete args like Type::U8).
def impl_for_type_matches(impl_for_type: &Type, recv_named: &Type) -> Bool
  match impl_for_type
  when Type::Adt(tid1, _) then
    match recv_named
    when Type::Adt(tid2, _) then tid1.id == tid2.id
    when _ then false
    end
  when _ then false
  end
end

# P0-AL: the resolver's registered method-DefId key for an impl method —
# a faithful replica of resolver.tg's type_expr_to_string rendering of the
# impl's for_type plus "::" + the method name ("Array[...]::push",
# "I[...]::map" for an extension impl whose for_type is the parameter I).
def impl_registry_method_key(for_type: &TypeExpr, method: &String) -> String
  let type_key = match for_type.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then name.clone() else name.clone() + "[...]" end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Unit then "Unit".to_string()
  when TypeExprKind::Never then "Never".to_string()
  when _ then "<type>".to_string()
  end
  type_key + "::" + method
end

# P0-AL: search the EXTENSION impls (for_type is a Type::Param) for a
# method name. Returns (impl index, method index) of the first match, in
# source order. The impls are registered in param_for_type_impls by
# check_impl; they are NOT indexed into method_lookup because they have no
# receiver TypeId.
def find_param_for_type_method(env: &TypeEnv, method: String) -> Option[(Int, Int)]
  var pi = 0
  while pi < env.param_for_type_impls.len() do
    let imp_idx = env.param_for_type_impls[pi]
    let imp = env.impls[imp_idx]
    var mi = 0
    while mi < imp.methods.len() do
      if imp.methods[mi].name == method then
        return Option::Some((imp_idx, mi))
      end
      mi = mi + 1
    end
    pi = pi + 1
  end
  Option::None
end

# P0-AL: instantiate a method of an EXTENSION impl — an impl whose for_type
# is a generic parameter (`impl[T, I: Iterator[T]] I`). The receiver's
# concrete type unifies the impl's head parameter (I); the impl's OTHER
# parameters (T) and the method-level parameters (U) are solved by unifying
# the instantiated method signature against the call's arguments — the same
# one-variable-per-parameter discipline as instantiate_method_type. The
# solved substitution is recorded in typed_call_instances (call node id ->
# the callee's generic args in the MIR signature-walk order — params first,
# then the return type, positionally aligned with the monomorphizer's
# infer_type_param_names); a substitution a parameter of which only the
# caller's context can solve is parked in pending_call_instances and
# re-resolved after the whole program is checked. Returns Option::None when
# the impl does not apply (head unification fails), otherwise the resolved
# return type.
def instantiate_param_for_type_method(
  env: &mut TypeEnv,
  imp: &ImplInfo,
  m: &MethodInfo,
  recv_type: &Type,
  arg_types: &Vec[Type],
  method_type_args: &Vec[Type],
  call_node_id: Int,
  span: Span
) -> Option[Type]
  # One fresh inference variable per impl-level generic parameter, in the
  # impl's declaration order — including parameters that never appear in
  # the for_type.
  var impl_vars = Vec::new()
  var i = 0
  while i < imp.generic_params.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  # Head: the for_type (a Type::Param) substituted with its variable and
  # unified with the concrete receiver — this solves the head parameter.
  let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &impl_vars)
  let head_ok = try_head_unify(env, head_inst, recv_type.clone())
  if !head_ok then
    return Option::None
  end
  # Method-level parameters: explicit type arguments or fresh variables.
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
  # P0-GPI: identity is the GenericParamId — a method param shadowing an
  # impl param is a DIFFERENT id, so both substitute independently (no
  # name-keyed collision can exist); the shadow test below is retained for
  # the record-order machinery's dedupe (two ids can only collide by
  # identity, which the interning forbids across declarations).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < imp.generic_params.len() do
    all_names.push(imp.generic_params[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < imp.generic_params.len() do
      if generic_param_id_eq(&imp.generic_params[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables — one
  # inference variable per generic parameter for the whole call.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded) — this solves the impl's other parameters (T)
  # and the method-level parameters (U) that appear in argument positions.
  let self_offset = if m.params.len() > 0 && m.params[0].name == "self" then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
  # P0-AL (final, substs-order contract): the recorded substitution is
  # positionally aligned with the monomorphizer's
  # function_generic_param_names — MirFunction.generic_params, populated by
  # the MIR from the checker's generic_param_ids record in the MERGED
  # DECLARATION order (impl decl ++ method decl). The signature-appearance
  # order would scramble the common extension shape (`impl[T, I:
  # Iterator[T]] I` — the head param I appears in self BEFORE the impl's T):
  # the record is taken from all_names (the merged decl order), one entry
  # per declared parameter; a parameter that never appears in the signature
  # gets a fresh variable and is parked (reported unsolvable — fail-closed,
  # never silently dropped).
  var all_solved = true
  var solved_args = Vec::new()
  var svi = 0
  while svi < all_names.len() do
    let rv = resolve_type_var(env, all_vars[svi].clone())
    match rv
    when Type::Var(_) then all_solved = false
    when _ then solved_args.push(rv)
    end
    svi = svi + 1
  end
  if all_solved then
    env.typed_call_instances.insert(call_node_id, solved_args)
  elsif all_names.len() > 0 then
    env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
  end
  resolve_type_var(env, inst_ret)
end

# P0-AP: instantiate a TRAIT-impl method for a bare Param receiver inside a
# generic body (see resolve_method_type section 5). The Param is an opaque
# instance of its bound trait: the impl head is accepted by the PARAM BINDING
# (strict unify rejects Param-vs-Named — the head shape matches and its
# argument variables are bound to the bound trait's type arguments
# positionally, the common shape where the trait's element argument is the
# head's corresponding argument, e.g. Iterator[T] for ArrayIterator[T]), the
# method-level parameters solve from the call arguments, and the solved
# substitution is recorded in typed_call_instances exactly like the
# impl-registry path; a substitution a parameter of which only the generic
# BODY's later unifications can solve (e.g. the trait impl's element variable
# unified through the match-arm payload) is parked in pending_call_instances
# and re-resolved after the whole program is checked
# (resolve_pending_call_instances). Returns Option::None when the receiver is
# not a Param.
def instantiate_param_bound_method(
  env: &mut TypeEnv,
  imp: &ImplInfo,
  m: &MethodInfo,
  recv_type: &Type,
  bound_args: &Vec[Type],
  arg_types: &Vec[Type],
  method_type_args: &Vec[Type],
  call_node_id: Int,
  span: Span
) -> Option[Type]
  match recv_type
  when Type::Param(_) then ()
  when _ then return Option::None
  end
  # One fresh inference variable per impl-level generic parameter, in the
  # impl's declaration order (same discipline as the extension-impl solver).
  var impl_vars = Vec::new()
  var i = 0
  while i < imp.generic_params.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &impl_vars)
  # The param binding: the Param is an opaque instance of the bound trait, so
  # the instantiated head matches by shape. Strict unify rejects
  # Param-vs-Named (its diagnostic is discarded); the head's argument
  # variables are then bound to the bound trait's type arguments
  # positionally, which solves the method signature at the call site for the
  # common shape.
  let errors_before = env.errors.len()
  let head_ok = unify(env, head_inst.clone(), recv_type.clone(), Span { file: "", start: 0, end_pos: 0 })
  if !head_ok then
    while env.errors.len() > errors_before do
      env.errors.pop()
    end
    match head_inst
    when Type::Adt(_, head_args) then
      var hi = 0
      while hi < head_args.len() do
        if hi < bound_args.len() then
          match head_args[hi]
          when Type::Var(_) then unify(env, head_args[hi].clone(), bound_args[hi].clone(), span)
          when _ then ()
          end
        end
        hi = hi + 1
      end
    when _ then ()
    end
  end
  # Method-level parameters: explicit type arguments or fresh variables.
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
  # P0-GPI: identity is the GenericParamId (see the extension-impl
  # solver's note — shadowing same-named parameters are distinct ids).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < imp.generic_params.len() do
    all_names.push(imp.generic_params[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < imp.generic_params.len() do
      if generic_param_id_eq(&imp.generic_params[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded).
  let self_offset = if m.params.len() > 0 && m.params[0].name == "self" then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
  # P0-AL (final, substs-order contract): record the substitution in the
  # MERGED DECLARATION order (all_names — impl decl ++ method decl), the
  # order the monomorphizer pairs positionally against
  # function_generic_param_names (MirFunction.generic_params, populated
  # from the checker's generic_param_ids record); the signature-appearance
  # order would swap the head param against the impl's earlier params.
  # A parameter that never appears in the signature gets a fresh variable
  # and is parked (reported unsolvable — fail-closed).
  var all_solved = true
  var solved_args = Vec::new()
  var svi = 0
  while svi < all_names.len() do
    let rv = resolve_type_var(env, all_vars[svi].clone())
    match rv
    when Type::Var(_) then all_solved = false
    when _ then solved_args.push(rv)
    end
    svi = svi + 1
  end
  if all_solved then
    env.typed_call_instances.insert(call_node_id, solved_args)
  elsif all_names.len() > 0 then
    env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
  end
  Option::Some(resolve_type_var(env, inst_ret))
end

# FIX 1 (P0-F): instantiate a generic signature ONCE per call. Every
# Type::Param occurrence becomes the SAME fresh inference variable for the
# whole call (parameters and return type share it), eliminating the
# wildcard behavior where each occurrence of T could independently match
# anything. `var_map` carries param numeric GenericParamId -> inference
# variable across the parameters and the return type of one call (P0-GPI:
# keyed by identity — two same-named parameters of different declarations
# are distinct variables).
def instantiate_generic_type(env: &mut TypeEnv, ty: &Type, var_map: &mut Map[Int, Type]) -> Type
  match ty
  when Type::Param(gpid) then
    let pkey = generic_param_id_numeric(&gpid)
    match var_map.get(pkey)
    when Option::Some(v) then v.clone()
    when Option::None then
      let v = fresh_type_var(env)
      var_map.insert(pkey, v.clone())
      v
    end
  when Type::Adt(tid, args) then
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(instantiate_generic_type(env, &args[i], var_map))
      i = i + 1
    end
    Type::Adt(tid, new_args)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(instantiate_generic_type(env, inner, var_map), mutable)
  when Type::Ptr(inner) then Type::Ptr(instantiate_generic_type(env, inner, var_map))
  when Type::PtrMut(inner) then Type::PtrMut(instantiate_generic_type(env, inner, var_map))
  when Type::Tuple(fields) then
    var new_fields = Vec::new()
    var i = 0
    while i < fields.len() do
      new_fields.push(instantiate_generic_type(env, &fields[i], var_map))
      i = i + 1
    end
    Type::Tuple(new_fields)
  when Type::Function(params, ret) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: instantiate_generic_type(env, &pt.ty, var_map), convention: pt.convention })
      i = i + 1
    end
    Type::Function(new_params, instantiate_generic_type(env, ret, var_map))
  when Type::Effect(_, inner) then Type::Effect(Vec::new(), instantiate_generic_type(env, inner, var_map))
  when _ then ty.clone()
  end
end

# FIX 1 (P0-F): instantiate an impl method's generic parameters ONCE per
# call. Impl-level parameters are solved by unifying the instantiated impl
# HEAD with the concrete receiver; method-level parameters by explicit type
# arguments or by unifying the arguments against the instantiated signature.
# The substitution always comes from head unification, never from
# generic-parameter index. After solving, every generic parameter of the
# callee must be bound; an unsolved one is reported as
# "cannot infer type parameter `T`".
def instantiate_method_type(env: &mut TypeEnv, imp: &ImplInfo, m: &MethodInfo, recv_type: &Type, arg_types: &Vec[Type], method_type_args: &Vec[Type], call_node_id: Int, span: Span) -> Type
  # P0-GPI: the impl's generic parameters come from ImplInfo.generic_params
  # (declaration order) EXCLUSIVELY — never a head-derived scan, so a
  # parameter that appears only in the trait arguments / method signature
  # (e.g. the A of `impl From[A] for T`'s `from(x: A)`) still gets its
  # fresh inference variable and substitutes positionally.
  let names = imp.generic_params.clone()
  var impl_vars = Vec::new()
  var i = 0
  while i < names.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&imp.for_type, &names, &impl_vars)
  let head_ok = try_head_unify(env, head_inst, recv_type.clone())
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
  # P0-GPI: identity is the GenericParamId (same-named shadowing
  # parameters are distinct ids and both substitute independently).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < names.len() do
    all_names.push(names[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < names.len() do
      if generic_param_id_eq(&names[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables used for the
  # head: one inference variable per generic parameter for the whole call.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded). This is what solves method-level inference
  # variables such as U in `map[U]`.
  let self_offset = if m.params.len() > 0 && m.params[0].name == "self" then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
  if head_ok then
    # FIX 1 verification: every generic parameter of the callee must be
    # SOLVED. Impl-level params are solved by the receiver (head)
    # unification; method-level params (when not given explicitly) by the
    # arguments. A method-level param appearing only in the return type is
    # solved by the caller's context and is not reported here (same rule as
    # plain ExprCall).
    var method_param_names: Vec[GenericParamId] = Vec::new()
    var mpi = 0
    while mpi < m.params.len() do
      collect_param_names_from_type(env, &m.params[mpi].ty, &mut method_param_names)
      mpi = mpi + 1
    end
    var vi = 0
    while vi < impl_vars.len() do
      match resolve_type_var(env, impl_vars[vi].clone())
      when Type::Var(_) then
        type_add_error(env, "cannot infer type parameter `" + generic_param_name_of(&env.generic_param_table, &names[vi]) + "`", span)
      when _ then ()
      end
      vi = vi + 1
    end
    if !explicit then
      var vj = 0
      while vj < method_vars.len() do
        if !method_shadowed[vj] then
          var in_params = false
          var mp2 = 0
          while mp2 < method_param_names.len() do
            if generic_param_id_eq(&method_param_names[mp2], &m.generic_params[vj]) then in_params = true end
            mp2 = mp2 + 1
          end
          if in_params then
            match resolve_type_var(env, method_vars[vj].clone())
            when Type::Var(_) then
              type_add_error(env, "cannot infer type parameter `" + generic_param_name_of(&env.generic_param_table, &m.generic_params[vj]) + "`", span)
            when _ then ()
            end
          end
        end
        vj = vj + 1
      end
    end
    # P0-AK (final) / P0-AL: the SOLVED substitution is the AUTHORITY —
    # record it for this call node in the callee's generic-parameter order
    # (impl-level params first, then method-level params — positionally
    # aligned with the monomorphizer's function_generic_param_names, which
    # lower_function populated from the checker's generic_param_ids record
    # in the MERGED DECLARATION order: impl decl ++ method decl). When
    # EVERY generic parameter of the callee is solved at the call site the
    # instance is recorded immediately; a parameter solved only by the
    # CALLER's context (e.g. a return-type-only method parameter unified
    # with the let-binding annotation AFTER the call) is parked in
    # pending_call_instances and re-resolved after the whole program is
    # checked. ZERO-INFERENCE: a parameter no context ever solves is
    # reported by resolve_pending_call_instances ("cannot infer type
    # parameter `T`: add an annotation") — the monomorphizer performs no
    # call-site inference (fail-closed). A parameter that never appears in
    # the signature (a phantom) gets a fresh variable and is parked
    # (reported unsolvable — never silently dropped, which would shift the
    # positional pairing).
    var all_solved = true
    var solved_args = Vec::new()
    var rvi = 0
    while rvi < all_names.len() do
      let rv = resolve_type_var(env, all_vars[rvi].clone())
      match rv
      when Type::Var(_) then all_solved = false
      when _ then solved_args.push(rv)
      end
      rvi = rvi + 1
    end
    if all_solved then
      env.typed_call_instances.insert(call_node_id, solved_args)
    elsif all_names.len() > 0 then
      env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
    end
    resolve_type_var(env, inst_ret)
  else
    # The impl head does not unify with this receiver instantiation (e.g. a
    # concrete-head impl selected by TypeId for a different instantiation);
    # fall back to the declared return type.
    m.ret_type
  end
end

# P0-AL (residual): explicit instantiation for the builtin-method table
# (resolve_method_type's Adt arms for the builtin compounds). The
# method-level generic U is a fresh InferVar (or the explicit method type
# argument), unified with the argument that carries it —
# the fn argument's return type — exactly like the impl-registry path in
# instantiate_method_type. The SOLVED U is returned AND recorded in
# typed_call_instances (call node id -> [receiver args] ++ [U] — the
# merged declaration order of the would-be `impl[K, V] T[K, V] { fn
# m[U](...) }` callee, positionally aligned with the monomorphizer's
# function_generic_param_names) when every generic parameter solves; when
# the fn argument is unresolved (or absent) U remains an InferVar and the
# recording is skipped — a U no context ever solves is a genuinely
# unconstrained shape and is reported (the end-of-check pending
# resolution, or the monomorphizer's fail-closed error for a call that
# never parked); inference is not performed on the program's call graph.
#
# mode selects the fn-return -> U extraction:
#   "ret"  — U = the fn return type itself         (map / map_or / map_err / fold)
#   "opt"  — U = the Option inner of the fn return (and_then)
#   "rerr" — U = the Result error of the fn return (or_else)
def solve_builtin_method_u(env: &mut TypeEnv, recv_args: &Vec[Type], arg_types: &Vec[Type], fn_idx: Int, mode: String, method_type_args: &Vec[Type], call_node_id: Int, span: Span) -> Type
  let u = if method_type_args.len() > 0 then method_type_args[0].clone() else fresh_type_var(env) end
  if fn_idx < arg_types.len() then
    let arg_ty = resolve_type_var(env, arg_types[fn_idx].clone())
    match arg_ty
    when Type::Function(_, ret) then
      if mode == "opt" then
        match builtin_option_inner(env, &ret)
        when Option::Some(inner) then unify(env, u.clone(), inner, span)
        when Option::None then ()
        end
      elsif mode == "rerr" then
        match builtin_result_err(env, &ret)
        when Option::Some(ierr) then unify(env, u.clone(), ierr, span)
        when Option::None then ()
        end
      else
        unify(env, u.clone(), ret, span)
      end
    when _ then ()
    end
  end
  let solved = resolve_type_var(env, u.clone())
  match solved
  when Type::Var(_) then ()
  when _ then
    # The recorded substitution is the receiver's container args (the
    # impl's declared params, in order) followed by the solved method
    # parameter — the merged declaration order of the callee's generic
    # list. A receiver arg still unresolved (a fresh receiver shape) skips
    # the recording — the monomorphizer never sees a partial payload.
    var substs = Vec::new()
    var ok = true
    var rai = 0
    while rai < recv_args.len() do
      let ra = resolve_type_var(env, recv_args[rai].clone())
      match ra
      when Type::Var(_) then ok = false
      when _ then substs.push(ra)
      end
      rai = rai + 1
    end
    if ok then
      substs.push(solved)
      env.typed_call_instances.insert(call_node_id, substs)
    end
  end
  solved
end

# Extract the payload inner of an Option-typed Adt value (the LangItems
# option id) — the U of `and_then` is the fn argument's return Option inner.
def builtin_option_inner(env: &TypeEnv, ty: &Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.option && args.len() >= 1 then Option::Some(args[0].clone()) else Option::None end
  when _ then Option::None
  end
end

# Extract the error component of a Result-typed Adt value (the LangItems
# result id) — the F of `or_else` is the fn argument's return Result error.
def builtin_result_err(env: &TypeEnv, ty: &Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.result && args.len() >= 2 then Option::Some(args[1].clone()) else Option::None end
  when _ then Option::None
  end
end

def resolve_method_type(env: &mut TypeEnv, recv_type: &Type, method: String, arg_types: &Vec[Type], method_type_args: &Vec[Type], call_node_id: Int, span: Span) -> Type
  # Auto-deref through references
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end

  # Guard: error type propagation
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  # Resolve the base type, following through type aliases
  # (e.g., Duration is a typealias for Timespec)
  let resolved_base = match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then inner.clone()
      when _ then base.clone()
      end
    when Option::None then base.clone()
    end
  when _ then base.clone()
  end

  # 1. Check inherent methods on the type (filtering by for_type TypeId),
  # via the O(1) receiver -> method -> candidate index.
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let imp = env.impls[cands[ci]]
          if imp.trait_name == "" || imp.trait_name == "_" then
            # Only consider impls whose for_type matches the receiver type
            if impl_for_type_matches(&imp.for_type, &resolved_base) then
              var mi2 = 0
              while mi2 < imp.methods.len() do
                let m = imp.methods[mi2]
                if m.name == method then
                  # FIX 1 (P0-F): explicit generic instantiation — one
                  # inference variable per generic parameter for the whole
                  # call, solved by impl-HEAD unification with the receiver
                  # and by argument unification; the return type is the
                  # solved substitution.
                  if imp.generic_params.len() > 0 || m.generic_params.len() > 0 then
                    return instantiate_method_type(env, &imp, &m, &resolved_base, arg_types, method_type_args, call_node_id, span)
                  else
                    return m.ret_type
                  end
                end
                mi2 = mi2 + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end

  # 2. Built-in methods on common types. These take priority over a blind
  # trait-method-by-name search so that e.g. String.clone resolves to String
  # rather than the first `clone` defined in any trait impl.
  match base
  when Type::String then
    if method == "len" then return Type::Int end
    if method == "to_string" then return Type::String end
    if method == "contains" then return Type::Bool end
    if method == "starts_with" then return Type::Bool end
    if method == "ends_with" then return Type::Bool end
    if method == "slice" then return Type::String end
    if method == "trim" then return Type::String end
    # The split/chars/bytes results are the Adt form of the registered
    # Slice builtin (LangItems id).
    if method == "split" then return builtin_adt(env, "Slice".to_string(), [Type::String]) end
    if method == "chars" then return builtin_adt(env, "Slice".to_string(), [Type::Char]) end
    if method == "bytes" then return builtin_adt(env, "Slice".to_string(), [Type::Int]) end
    if method == "push" then return Type::Unit end
    if method == "clone" then return Type::String end
  when Type::Int then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Int end
    if method == "pow" then return Type::Int end
    if method == "min" then return Type::Int end
    if method == "max" then return Type::Int end
    if method == "clamp" then return Type::Int end
  when Type::Float then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Float end
    if method == "sqrt" then return Type::Float end
    if method == "floor" then return Type::Int end
    if method == "ceil" then return Type::Int end
    if method == "round" then return Type::Int end
  when Type::Bool then
    if method == "to_string" then return Type::String end
  when Type::Adt(tid, args) then
    # Smart pointers and Vec are Adt types; handle their common methods by
    # the resolved builtin name so `.clone()`/`.as_ref()` don't fall into
    # the trait-by-name search. The builtin compounds' method tables are the
    # Adt twins of the dropped canonical arms (Slice/Option/Result/Map/Set/
    # Box/Rc), selected by the builtin's name (Arc/UniquePtr etc. have no
    # LangItems entries and stay name-selected). Method RESULTS are produced
    # in the Adt form via builtin_adt (the LangItems ids).
    let _nn = match get_type_by_id_ref(env, tid)
    when Option::Some(td) then td.name.clone()
    when Option::None then ""
    end
    if _nn == "Box" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "as_ref" then return inner end
      if method == "as_mut" then return inner end
      if method == "clone" then return builtin_adt(env, "Box".to_string(), [inner]) end
      if method == "deref" then return inner end
      if method == "is_null" then return Type::Bool end
    elsif _nn == "Rc" || _nn == "Arc" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "as_ref" then return inner end
      if method == "clone" then return Type::Adt(tid.clone(), args.clone()) end
      if method == "strong_count" then return Type::UInt end
    elsif _nn == "Vec" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "push" then return Type::Unit end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "pop" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "get" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "clone" then return Type::Adt(tid.clone(), args.clone()) end
      if method == "iter" then return builtin_adt(env, "Slice".to_string(), [inner]) end
    elsif _nn == "Slice" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "get" || method == "iter" || method == "clone" || method == "slice" || method == "extend" then
        if type_has_resource_kind(env, &inner) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "push" then return Type::Unit end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "pop" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "get" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "contains" then return Type::Bool end
      if method == "iter" then return builtin_adt(env, "Slice".to_string(), [inner]) end
      # P0-AL (residual): Slice map/fold — U solved from the fn
      # argument's return and recorded (the iterator-adapter map); filter
      # returns Slice(inner) with no method-level generic.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Slice".to_string(), [u])
      end
      if method == "filter" then return builtin_adt(env, "Slice".to_string(), [inner]) end
      if method == "fold" then
        let u = solve_builtin_method_u(env, &args, arg_types, 1, "ret", method_type_args, call_node_id, span)
        return u
      end
      if method == "clone" then return builtin_adt(env, "Slice".to_string(), [inner]) end
      if method == "sort" then return Type::Unit end
      if method == "reverse" then return Type::Unit end
      if method == "first" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "last" then return builtin_adt(env, "Option".to_string(), [inner]) end
    elsif _nn == "Option" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "unwrap" then return inner end
      if method == "is_some" then return Type::Bool end
      if method == "is_none" then return Type::Bool end
      # P0-AL (residual): Option map/and_then — U solved from the fn
      # argument's return (and_then from its Option inner) and recorded.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
      if method == "and_then" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
      # P0-AL (residual): Option or_else — U solved from the fn
      # argument's return Option inner and recorded.
      if method == "or_else" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
      if method == "unwrap_or" then return inner end
      # P0-AL (residual): Option map_or — U solved from the fn
      # argument's return (the default argument carries the same U).
      if method == "map_or" then
        let u = solve_builtin_method_u(env, &args, arg_types, 1, "ret", method_type_args, call_node_id, span)
        return u
      end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "clone" then return builtin_adt(env, "Option".to_string(), [inner]) end
    elsif _nn == "Result" then
      let ok = if args.len() >= 2 then args[0].clone() else fresh_type_var(env) end
      let err = if args.len() >= 2 then args[1].clone() else fresh_type_var(env) end
      if method == "unwrap" then return ok end
      if method == "is_ok" then return Type::Bool end
      if method == "is_err" then return Type::Bool end
      # P0-AL (residual): Result map/map_err/and_then — U/F solved from
      # the fn argument's return (and_then from its Option inner) and
      # recorded.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [u, err])
      end
      if method == "map_err" then
        let f = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [ok, f])
      end
      if method == "and_then" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [u, err])
      end
      if method == "unwrap_or" then return ok end
      # P0-AL (residual): Result or_else — F solved from the fn
      # argument's return Result error component.
      if method == "or_else" then
        let f = solve_builtin_method_u(env, &args, arg_types, 0, "rerr", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [ok, f])
      end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "ok" then return builtin_adt(env, "Option".to_string(), [ok]) end
      if method == "err" then return builtin_adt(env, "Option".to_string(), [err]) end
      if method == "clone" then return builtin_adt(env, "Result".to_string(), [ok, err]) end
    elsif _nn == "Map" then
      let k = if args.len() >= 2 then args[0].clone() else fresh_type_var(env) end
      let v = if args.len() >= 2 then args[1].clone() else fresh_type_var(env) end
      if method == "get" || method == "keys" || method == "values" || method == "entries" || method == "clone" then
        if type_has_resource_kind(env, &v) || type_has_resource_kind(env, &k) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "get" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "insert" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "contains_key" then return Type::Bool end
      if method == "remove" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "keys" then return builtin_adt(env, "Slice".to_string(), [k]) end
      if method == "values" then return builtin_adt(env, "Slice".to_string(), [v]) end
      if method == "clone" then return builtin_adt(env, "Map".to_string(), [k, v]) end
    elsif _nn == "Set" then
      let elem = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "iter" || method == "clone" then
        if type_has_resource_kind(env, &elem) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      if method == "contains" then return Type::Bool end
      if method == "insert" then return Type::Bool end
      if method == "remove" then return Type::Bool end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "clone" then return builtin_adt(env, "Set".to_string(), [elem]) end
    end
  when Type::FixedArray(elem, n) then
    # Fixed arrays: len/is_empty are compile-time constants (the count is
    # carried in the type; codegen emits the constant, never a header read).
    if method == "len" then return Type::Int end
    if method == "is_empty" then return Type::Bool end
  when Type::Ptr(inner) then
    if method == "is_null" then return Type::Bool end
    if method == "as_ref" then return inner end
    if method == "as_mut" then return inner end
    if method == "offset" then return Type::Ptr(inner) end
    if method == "add" then return Type::Ptr(inner) end
    # Typed destruction glue: the codegen lowers drop_in_place to the
    # pointee's semantic deinit plan (never an empty library shim).
    if method == "drop_in_place" then return Type::Unit end
  when Type::PtrMut(inner) then
    if method == "is_null" then return Type::Bool end
    if method == "as_ref" then return inner end
    if method == "as_mut" then return inner end
    if method == "offset" then return Type::PtrMut(inner) end
    if method == "add" then return Type::PtrMut(inner) end
    if method == "drop_in_place" then return Type::Unit end
  when _ then ()
  end

  # 3. Check trait impls (by method name only — full trait resolution is TODO).
  # Runs after built-in methods so a built-in (e.g. String.clone) wins over an
  # unrelated trait impl that happens to define the same method name.
  # The impl's for_type must match the receiver so `TaintSource.clone()` never
  # picks up `Clone for PanicInfo`'s clone.
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci2 = 0
        while ci2 < cands.len() do
          let imp = env.impls[cands[ci2]]
          if imp.trait_name != "" && imp.trait_name != "_" then
            if impl_for_type_matches(&imp.for_type, &resolved_base) then
              var mi3 = 0
              while mi3 < imp.methods.len() do
                let m = imp.methods[mi3]
                if m.name == method then
                  # FIX 1 (P0-F): explicit generic instantiation (see
                  # section 1) — same inference-variable discipline for
                  # trait-impl methods.
                  if imp.generic_params.len() > 0 || m.generic_params.len() > 0 then
                    return instantiate_method_type(env, &imp, &m, &resolved_base, arg_types, method_type_args, call_node_id, span)
                  else
                    return m.ret_type
                  end
                end
                mi3 = mi3 + 1
              end
            end
          end
          ci2 = ci2 + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end

  # 4. P0-AL: EXTENSION-impl methods — an impl whose for_type is a generic
  # PARAMETER (`impl[T, I: Iterator[T]] I`) is not indexed into
  # method_lookup (it has no receiver TypeId), so the direct lookup above
  # cannot find it. Search those impls by method name; the receiver's
  # concrete type unifies the head parameter (I), the impl's other
  # parameters (T) are solved from the method signature, the method is
  # instantiated, and the solved instance is recorded
  # (typed_call_instances / pending_call_instances).
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp = env.impls[pimp_idx]
    match instantiate_param_for_type_method(env, &pimp, &pimp.methods[pmid_idx], &resolved_base, arg_types, method_type_args, call_node_id, span)
    when Option::Some(ret_ty) then return ret_ty
    when Option::None then ()
    end
  when Option::None then ()
  end

  # 5. P0-AP: TRAIT-BOUND method resolution on bare Param receivers. Inside a
  # generic body a method call on a receiver of type Type::Param(name) (e.g.
  # `self.inner.advance()` with inner: I inside `impl[T, U, I: Iterator[T]]
  # Iterator[U] for MapIter[T, U, I]`) resolves through the parameter's
  # where-clause bound (recorded in env.param_bounds when the generic
  # parameters entered scope): the bound trait's impls are the candidates,
  # the impl head unifies with the Param by the PARAM BINDING (the Param is
  # an opaque instance of the bound trait, so Param-vs-Named head
  # unification is a match), the method is instantiated with fresh inference
  # variables, the head's argument variables are bound to the bound trait's
  # type arguments positionally, and the solved instance is recorded exactly
  # like the impl-registry path (typed_call_instances / pending_call_instances).
  match resolved_base
  when Type::Param(gpid) then
    # P0-GPI: the receiver's bounds are keyed by the parameter's numeric
    # GenericParamId — identity, never the name.
    match env.param_bounds.get(generic_param_id_numeric(&gpid))
    when Option::Some(pbounds) then
      var pbi = 0
      while pbi < pbounds.len() do
        let pbound = pbounds[pbi]
        var pii = 0
        while pii < env.impls.len() do
          let pimp = env.impls[pii]
          # P0-BT: the bound trait identity is the TraitId (the names are
          # retained only for diagnostics).
          if pimp.trait_id.id == pbound.trait_id.id then
            var pmi = 0
            while pmi < pimp.methods.len() do
              let pm = pimp.methods[pmi]
              if pm.name == method then
                match instantiate_param_bound_method(env, &pimp, &pm, &resolved_base, &pbound.args, arg_types, method_type_args, call_node_id, span)
                when Option::Some(ret_ty) then return ret_ty
                when Option::None then ()
                end
              end
              pmi = pmi + 1
            end
          end
          pii = pii + 1
        end
        pbi = pbi + 1
      end
    when Option::None then ()
    end
  when _ then ()
  end

  # Method on user-defined type or trait — permissively infer.
  # In strict resolution mode an unresolved method is a hard error.
  if env.strict_resolution then
    type_add_error(env, "no method `" + method + "` on receiver type", span)
    Type::Error
  else
    fresh_type_var(env)
  end
end

# Strip a trailing borrow layer so a `&str`/`&T` operand participates as its
# pointee in binary operations (string concatenation, arithmetic on references).
def deref_borrow_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then deref_borrow_type(inner)
  when _ then ty
  end
end

def check_binary_op(env: &mut TypeEnv, op: BinOp, left: &Expr, right: &Expr, span: Span) -> Type
  let left_type = deref_borrow_type(check_expr(env, left))
  let right_type = deref_borrow_type(check_expr(env, right))

  # Propagate errors without crashing
  match left_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  match right_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when BinOp::Add then
    # String concatenation coerces any operand to String: "x" + 42 is valid.
    if is_string_type(&left_type) || is_string_type(&right_type) then
      Type::String
    else
      unify(env, left_type, right_type, span)
      left_type
    end
  when BinOp::Sub then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mul then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Div then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mod then
    unify(env, left_type, Type::Int, span)
    unify(env, right_type, Type::Int, span)
    Type::Int
  when BinOp::Pow then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Eq then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ne then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Lt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Le then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Gt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ge then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::And then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when BinOp::Or then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when _ then left_type
  end
end

def check_unary_op(env: &mut TypeEnv, op: UnOp, inner: &Expr, span: Span) -> Type
  let inner_type = check_expr(env, inner)

  match inner_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when UnOp::Neg then
    inner_type
  when UnOp::Not then
    unify(env, inner_type, Type::Bool, span)
    Type::Bool
  when UnOp::BitNot then
    unify(env, inner_type, Type::Int, span)
    Type::Int
  end
end

# ———————————————————————————————————————————————————————————————
# Type Expression Resolution
# ———————————————————————————————————————————————————————————————

# Extract path segments from a TypeExpr in a separate function frame.
# Going through a helper appears to give stage0 cleaner codegen for single-
# struct enum payloads (Path(AstPath)) than a direct destructure in-place.
def extract_type_path_segments(te: &TypeExpr) -> Vec[String]
  var out = Vec::new()
  match te.kind
  when TypeExprKind::Path(p) then
    var i = 0
    while i < p.segments.len() do
      out.push(p.segments[i].clone())
      i = i + 1
    end
  when _ then ()
  end
  out
end

def resolve_type_expr(env: &mut TypeEnv, te: &TypeExpr) -> Type
  match te.kind
  when TypeExprKind::Named(name, args) then
    # Use if-chains for string matching (match name.as_str() generates broken C)
    # Preserve sized integer types for FFI parity - critical for correct ABI
    if name == "Unit" then Type::Unit
    elsif name == "Nil" then Type::Unit
    elsif name == "Bool" then Type::Bool
    elsif name == "Int" then Type::Int
    elsif name == "i8" then Type::I8
    elsif name == "i16" then Type::I16
    elsif name == "i32" then Type::I32
    elsif name == "i64" then Type::I64
    elsif name == "i128" then Type::I128
    elsif name == "UInt" then Type::UInt
    elsif name == "u8" then Type::U8
    elsif name == "u16" then Type::U16
    elsif name == "u32" then Type::U32
    elsif name == "u64" then Type::U64
    elsif name == "u128" then Type::U128
    elsif name == "isize" then Type::ISize
    elsif name == "usize" then Type::USize
    elsif name == "Float" then Type::Float
    elsif name == "f32" then Type::F32
    elsif name == "f64" then Type::F64
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "str" then Type::String
    elsif name == "Never" then Type::Never
    elsif name == "Self" then
      # Self refers to the current impl type; treat as a type variable
      fresh_type_var(env)
    elsif name == "Fn" then
      # Fn types like Fn(Args) -> Ret
      var param_types = Vec::new()
      var i = 0
      while i < args.len() do
        param_types.push(ParamType { ty: resolve_type_expr(env, &args[i]), convention: AccessConvention::Let })
        i = i + 1
      end
      Type::Function(param_types, Type::Unit)
    elsif name == "Array" then
      # Handle Array[T] named syntax — the heap vector. The result is the
      # Adt form of the registered Array builtin (LangItems id); the fixed
      # arrays are the distinct Type::FixedArray variant built from the
      # [T; N] annotation (TypeExprKind::Array), never this named form.
      if args.len() >= 1 then
        let elem_type = resolve_type_expr(env, &args[0])
        builtin_adt(env, "Array".to_string(), [elem_type])
      else
        builtin_adt(env, "Array".to_string(), [fresh_type_var(env)])
      end
    elsif name == "Slice" then
      # Handle Slice[T] named syntax — the Adt form of the registered
      # Slice builtin (LangItems id).
      if args.len() >= 1 then
        builtin_adt(env, "Slice".to_string(), [resolve_type_expr(env, &args[0])])
      else
        builtin_adt(env, "Slice".to_string(), [fresh_type_var(env)])
      end
    elsif name == "Any" then
      # Any is a top type — use a fresh type variable that unifies with everything
      fresh_type_var(env)
    # Type aliases: capitalized forms used by stdlib (Int8 → I8, UInt8 → U8, etc.)
    elsif name == "Int8" then Type::I8
    elsif name == "Int16" then Type::I16
    elsif name == "Int32" then Type::I32
    elsif name == "Int64" then Type::I64
    elsif name == "Int128" then Type::I128
    elsif name == "UInt8" then Type::U8
    elsif name == "UInt16" then Type::U16
    elsif name == "UInt32" then Type::U32
    elsif name == "UInt64" then Type::U64
    elsif name == "UInt128" then Type::U128
    elsif name == "ISize" then Type::ISize
    elsif name == "USize" then Type::USize
    elsif name == "F32" then Type::F32
    elsif name == "F64" then Type::F64
    elsif name == "Bool" then Type::Bool
    elsif name == "c_int" then Type::Int
    elsif name == "c_uint" then Type::UInt
    elsif name == "c_char" then Type::U8
    elsif name == "c_long" then Type::I64
    elsif name == "c_ulong" then Type::U64
    elsif name == "c_void" then Type::Unit
    elsif name == "c_double" then Type::F64
    elsif name == "c_float" then Type::F32
    else
      # Check if this name is a generic parameter in scope (e.g., T, E, K, V)
      match lookup_var(env, name.clone())
      when Option::Some(ty) then ty
      when Option::None then
        # P0-A (next layer): bare-name resolution — local-module shadowing
        # and cross-module ambiguity verification live here (see
        # resolve_bare_type_name); the first-wins entry is the fallback.
        match resolve_bare_type_name(env, name.clone(), te.span)
        when Option::Some(idx) then
          let type_def = env.type_list[idx]
          var resolved_args = Vec::new()
          var i = 0
          while i < args.len() do
            resolved_args.push(resolve_type_expr(env, &args[i]))
            i = i + 1
          end
          # Every builtin compound name resolves to its Adt form with the
          # LangItems id (builtin_adt); user types get Type::Adt(<their
          # TypeId>, args).
          if type_def.name == "Option" then
            if resolved_args.len() >= 1 then builtin_adt(env, "Option".to_string(), resolved_args)
            else builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
            end
          elsif type_def.name == "Result" then
            if resolved_args.len() >= 2 then builtin_adt(env, "Result".to_string(), resolved_args)
            else builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            end
          elsif type_def.name == "Map" then
            if resolved_args.len() >= 2 then builtin_adt(env, "Map".to_string(), resolved_args)
            else builtin_adt(env, "Map".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            end
          elsif type_def.name == "Set" then
            if resolved_args.len() >= 1 then builtin_adt(env, "Set".to_string(), resolved_args)
            else builtin_adt(env, "Set".to_string(), [fresh_type_var(env)])
            end
          else
            Type::Adt(type_def.id, resolved_args)
          end
        when Option::None then
          # Auto-register unknown types as opaque to prevent cascading errors.
          # This ensures all references to the same unknown type name resolve
          # to the same TypeId, preventing spurious "type mismatch" errors.
          # In strict resolution mode an unknown type is a hard error.
          if env.strict_resolution then
            type_add_error(env, "unknown type `" + name + "`", te.span)
            return Type::Error
          end
          let id_num = env.type_id_counter
          let opaque_id = TypeId { id: id_num }
          env.type_id_counter = env.type_id_counter + 1
          let opaque_td = TypeDef {
            id: opaque_id,
            name: name.clone(),
            def_kind: TypeDefKind::Opaque,
            generic_params: Vec::new(),
            kind: TypeKind::Value
          }
          env.type_name_index.insert(name.clone(), env.type_list.len())
          env.type_id_index.insert(id_num, env.type_list.len())
          env.type_list.push(opaque_td)
          var resolved_args = Vec::new()
          var i = 0
          while i < args.len() do
            resolved_args.push(resolve_type_expr(env, &args[i]))
            i = i + 1
          end
          Type::Adt(opaque_id, resolved_args)
        end
      end
    end
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Tuple(elems) then
    var types = Vec::new()
    var i = 0
    while i < elems.len() do
      types.push(resolve_type_expr(env, &elems[i]))
      i = i + 1
    end
    Type::Tuple(types)
  when TypeExprKind::Array(elem, size_opt) then
    # The [T; N] annotation constructs the DISTINCT fixed-array variant
    # Type::FixedArray(elem, n) — the element type plus the constant count
    # (0 is a legal zero-length fixed array). The count is carried in the
    # TYPE; the named Array[T] syntax (the heap vector) is the Adt form.
    # The size expression must evaluate to a constant; a non-constant size
    # is a TypeError (the fixed array size is part of the type identity).
    let elem_type = resolve_type_expr(env, &elem)
    let size_n = match size_opt
    when Option::Some(size_expr) then
      match size_expr.kind
      when ExprKind::ExprIntLit(n) then n
      when _ then
        type_add_error(env, "fixed array size must be a constant", size_expr.span)
        0
      end
    when Option::None then
      type_add_error(env, "fixed array size must be a constant", te.span)
      0
    end
    Type::FixedArray(elem_type, size_n)
  when TypeExprKind::Slice(elem) then
    let elem_type = resolve_type_expr(env, &elem)
    builtin_adt(env, "Slice".to_string(), [elem_type])
  when TypeExprKind::Fn(params, ret) then
    var param_types = Vec::new()
    var i = 0
    while i < params.len() do
      param_types.push(ParamType { ty: resolve_type_expr(env, &params[i].ty), convention: params[i].convention })
      i = i + 1
    end
    let ret_type = resolve_type_expr(env, &ret)
    Type::Function(param_types, ret_type)
  when TypeExprKind::Infer then
    fresh_type_var(env)
  when TypeExprKind::Ptr(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Ptr(inner_type)
  when TypeExprKind::PtrMut(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::PtrMut(inner_type)
  when TypeExprKind::Async(inner) then
    # Async types resolve to their inner type for now
    resolve_type_expr(env, &inner)
  when TypeExprKind::Effect(name, inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Effect(Vec::from([name.clone()]), inner_type)
  when TypeExprKind::Path(path) then
    # Qualified path like module::Type — resolve the last segment.
    # Extract segments via a helper to dodge a stage0 codegen quirk where
    # the AstPath payload of `TypeExprKind::Path` read in-place yields
    # corrupt `String` headers inside `segments`.
    let segs = extract_type_path_segments(te)
    if segs.len() > 0 then
      # Manual concat to bypass any potential stage0 codegen issue in Array[String].join
      var full_name = String::new()
      var jk = 0
      while jk < segs.len() do
        if jk > 0 then full_name = full_name + "::" end
        full_name = full_name + segs[jk].clone()
        jk = jk + 1
      end
      # P0-A (next layer): a path-qualified type reference resolves through
      # the module-qualified type-name map first (module_type_names — the
      # qualified identity recorded at type-registration time), then the
      # existing flat full-name fallback (auto-registered opaque full
      # names), then the bare-name fallback with ambiguity verification.
      match env.module_type_names.get(full_name.clone())
      when Option::Some(idx) then
        let type_def = env.type_list[idx]
        # Use canonical Type representation so unification works correctly
        type_def_to_canonical(env, &type_def)
      when Option::None then
        match get_type_by_name_ref(env, full_name.clone())
        when Option::Some(type_def) then
          # Use canonical Type representation so unification works correctly
          type_def_to_canonical(env, type_def)
        when Option::None then
          # Try the last segment alone
          let last = segs[segs.len() - 1].clone()
          match resolve_bare_type_name(env, last, te.span)
          when Option::Some(idx) then
            let type_def = env.type_list[idx]
            # Use canonical Type representation so unification works correctly
            type_def_to_canonical(env, &type_def)
          when Option::None then
            # Auto-register unknown qualified type paths as opaque to prevent
            # cascading errors. This mirrors the opaque fallback in the Named
            # handler above and ensures all references to the same unknown
            # qualified type resolve to the same TypeId.
            let id_num = env.type_id_counter
            let opaque_id = TypeId { id: id_num }
            env.type_id_counter = env.type_id_counter + 1
            let opaque_td = TypeDef {
              id: opaque_id,
              name: full_name.clone(),
              def_kind: TypeDefKind::Opaque,
              generic_params: Vec::new(),
              kind: TypeKind::Value
            }
            env.type_name_index.insert(full_name.clone(), env.type_list.len())
            env.type_id_index.insert(id_num, env.type_list.len())
            env.type_list.push(opaque_td)
            Type::Adt(opaque_id, Vec::new())
          end
        end
      end
    else
      Type::Error
    end
  when _ then Type::Error
  end
end

# ———————————————————————————————————————————————————————————————
# Import Resolution — loads and parses referenced stdlib files
# ———————————————————————————————————————————————————————————————

# Map a use-declaration path to a filesystem path.
# e.g. ["std", "app"] -> "std/app.tg"
# e.g. ["std", "gfx_errors"] -> "std/gfx_errors.tg"
# e.g. ["tg_compiler", "ast"] -> "tg_compiler/ast.tg"
# Returns Option::None for paths that don't map to loadable files (e.g. builtins).
def use_path_to_file(segments: &Vec[String]) -> Option[String]
  if segments.len() < 2 then
    return Option::None
  end
  let root = segments[0]
  if root == "std" then
    # std::X -> std/X.tg   (handles std::core, std::app, std::gfx, etc.)
    var path = "std/"
    var i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  elsif root == "tg_compiler" then
    # tg_compiler::X -> tg_compiler/X.tg
    var path = "tg_compiler/"
    var i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  else
    Option::None
  end
end

# Extract use declarations from a program's items and return the referenced file paths.
def extract_import_paths(program: &Program) -> Vec[String]
  var paths = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    match item.kind
    when ItemKind::ItemUse(u) then
      match use_path_to_file(&u.path.segments)
      when Option::Some(p) then paths.push(p)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  paths
end

# Recursively resolve imports: read, tokenize, parse each referenced file,
# collect type definitions from it, and recurse into its own use declarations.
# The `loaded` set prevents loading the same file twice (cycle protection).
def resolve_imports(env: &mut TypeEnv, program: &Program, loaded: &mut Set[String]) -> Unit
  let paths = extract_import_paths(program)
  for path in paths do
    let import_path = path.clone()
    if loaded.contains(&import_path) then
      ()
    else
      loaded.insert(path.clone())
      match std::fs::read_file(path.clone())
      when Result::Ok(source) then
        let tokens = tokenize(source)
        let dep_parse = parse(tokens)
        let dep_ast = dep_parse.program
        # Recurse: resolve this file's own imports first
        resolve_imports(env, &dep_ast, loaded)
        # Pass 1: Pre-register all type names (enables forward references)
        # Use indexed borrow (&items[i]) to avoid stage0 codegen bug that
        # corrupts enum payloads when an Item is copied out of a Vec.
        # P0-A (next layer): this legacy permissive path runs without
        # resolutions (module_type_names stays empty), so the root module
        # path is passed — qualified registration is a no-op here.
        var i = 0
        let root_path: Vec[String] = Vec::new()
        while i < dep_ast.items.len() do
          pre_register_type_name(env, &dep_ast.items[i], &root_path)
          i = i + 1
        end
        # Pass 2: Collect full type definitions (field types, variant types, etc.)
        i = 0
        while i < dep_ast.items.len() do
          collect_type_def(env, &dep_ast.items[i], &root_path)
          i = i + 1
        end
      when Result::Err(_) then
        # File not found or unreadable — skip silently.
        ()
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# P1 (recovery separation): post-check verification
# ———————————————————————————————————————————————————————————————
#
# The semantic pass must guarantee that a codegenable TypedProgram carries no
# unresolved semantic state. This walk runs after the type check succeeds and
# rejects:
#   - Type::Error anywhere in expr_types (MIR's own P0-AN verifier does NOT
#     check Type::Error, so the semantic pass is the enforcement point), and
#   - Type::Var that the final substitution cannot resolve (a var with no
#     substitution entry would reach MIR/codegen unresolved). Vars that the
#     substitution DOES solve are genuinely pending inference that became
#     concrete — acceptable.
# Type::Param is ALLOWED: it is the bound generic parameter of a generic
# template, the template's normal state which MIR lowers as a generic
# function and codegen resolves at monomorphization. The MIR P0-AN verifier
# already rejects Param leaking into non-generic functions.
def verify_codegen_readiness(env: &mut TypeEnv) -> Unit
  let entries = env.typed_expr_types.entries()
  var i = 0
  while i < entries.len() do
    let node_id = entries[i].0
    let ty = entries[i].1
    var has_error = false
    var has_var = false
    scan_codegen_type(env, &ty, &mut has_error, &mut has_var)
    if has_error then
      type_add_error(env, "unresolved Type::Error in the type of expression node " + node_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if has_var then
      type_add_error(env, "unresolved inference variable (Type::Var) in the type of expression node " + node_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    i = i + 1
  end
end

def scan_codegen_type(env: &TypeEnv, ty: &Type, has_error: &mut Bool, has_var: &mut Bool) -> Unit
  match ty
  when Type::Error then
    has_error = true
  when Type::Var(id) then
    # A var with a substitution entry is pending inference that resolved to
    # concrete state; chase it. A var with NO entry would stay unresolved in
    # the codegenable program — rejected.
    match env.subst.get(id)
    when Option::Some(resolved) then
      scan_codegen_type(env, &resolved, has_error, has_var)
    when Option::None then
      has_var = true
    end
  when Type::Adt(_, args) then
    var i = 0
    while i < args.len() do
      scan_codegen_type(env, &args[i], has_error, has_var)
      i = i + 1
    end
  when Type::Function(params, ret) then
    var i = 0
    while i < params.len() do
      scan_codegen_type(env, &params[i].ty, has_error, has_var)
      i = i + 1
    end
    scan_codegen_type(env, &ret, has_error, has_var)
  when Type::RefInternal(inner, _) then scan_codegen_type(env, &inner, has_error, has_var)
  when Type::Ptr(inner) then scan_codegen_type(env, &inner, has_error, has_var)
  when Type::PtrMut(inner) then scan_codegen_type(env, &inner, has_error, has_var)
  when Type::Effect(_, inner) then scan_codegen_type(env, &inner, has_error, has_var)
  when Type::Tuple(elems) then
    var i = 0
    while i < elems.len() do
      scan_codegen_type(env, &elems[i], has_error, has_var)
      i = i + 1
    end
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def type_check(program: &Program) -> Vec[TypeError]
  type_check_strict(program, false)
end

def type_check_strict(program: &Program, strict: Bool) -> Vec[TypeError]
  var env = type_env_new()
  env.strict_resolution = strict
  type_check_program_env(&mut env, program)
  env.errors
end

# P0-AL (final): resolve the parked generic-call instances
# (pending_call_instances) after the WHOLE program is checked. A generic
# parameter that only the caller's context constrains (a return-type-only
# parameter, e.g. the T of `Vec::new()` unified with the
# `let v: Vec[String] = Vec::new()` annotation) is still an unbound
# inference variable at the call site; the caller-context unifications land
# during the rest of the check, and this pass re-resolves each parked
# call's variables.
#
# ZERO-INFERENCE (the end-of-check resolution):
#   1. each parked variable is resolved (chasing env.subst);
#   2. a call still incomplete is SOLVED FROM THE DEST — the call's
#      recorded result type (typed_expr_types; the source of the MIR
#      destination local's type for method calls) is chased to its final
#      form, and when the chased dest is fully concrete the recorded entry
#      is unified against it, binding every parked variable the call's
#      result type contains to its dest position;
#   3. a variable no context ever solves is a GENUINELY UNCONSTRAINED
#      shape: it records "cannot infer type parameter `<name>`: add an
#      annotation" — the monomorphizer performs no call-site inference
#      (fail-closed; a call a context never solves never reaches it).
def resolve_pending_call_instances(env: &mut TypeEnv) -> Unit
  let entries = env.pending_call_instances.entries()
  var i = 0
  while i < entries.len() do
    let (node_id, rec_triple) = entries[i]
    let rec_names = rec_triple.0
    let rec_vars = rec_triple.1
    let rec_span = rec_triple.2
    var all_solved = true
    var solved_args = Vec::new()
    var vi = 0
    while vi < rec_vars.len() do
      let resolved = resolve_type_var(env, rec_vars[vi].clone())
      match resolved
      when Type::Var(_) then all_solved = false
      when _ then solved_args.push(resolved)
      end
      vi = vi + 1
    end
    if !all_solved then
      # ZERO-INFERENCE (dest rule): the parked variables are the call's own
      # instantiated-signature variables, so the recorded call-result type
      # SHARES them; chasing the entry and unifying it against the chased
      # (fully-resolved) dest solves every variable the call's result type
      # contains from the caller's dest context.
      match env.typed_expr_types.get(node_id)
      when Option::Some(entry_ty) then
        let chased = resolve_type_var(env, entry_ty.clone())
        var chased_has_error = false
        var chased_has_var = false
        scan_codegen_type(env, &chased, &mut chased_has_error, &mut chased_has_var)
        if !chased_has_error && !chased_has_var then
          unify(env, entry_ty.clone(), chased, rec_span)
          all_solved = true
          solved_args = Vec::new()
          var vi2 = 0
          while vi2 < rec_vars.len() do
            let resolved2 = resolve_type_var(env, rec_vars[vi2].clone())
            match resolved2
            when Type::Var(_) then all_solved = false
            when _ then solved_args.push(resolved2)
            end
            vi2 = vi2 + 1
          end
        end
      when Option::None then ()
      end
    end
    if all_solved then
      env.typed_call_instances.insert(node_id, solved_args)
    else
      # Genuinely unconstrained: no context (arguments, annotation, dest)
      # ever solved the parameter — record the annotation error per
      # parameter (P0-GPI: the name comes from the param-name table).
      var ni = 0
      while ni < rec_names.len() do
        match resolve_type_var(env, rec_vars[ni].clone())
        when Type::Var(_) then
          let pname = generic_param_name_of(&env.generic_param_table, &rec_names[ni])
          type_add_error(env, "cannot infer type parameter `" + pname + "`: add an annotation", rec_span)
        when _ then ()
        end
        ni = ni + 1
      end
    end
    i = i + 1
  end
  env.pending_call_instances.clear()
end

def type_check_typed(env: &mut TypeEnv, program: &Program, resolutions: &ResolvedNames) -> TypeCheckResult
  env.local_id_counter = 0
  env.local_ids.clear()
  env.typed_call_targets.clear()
  env.typed_call_instances.clear()
  env.typed_field_targets.clear()
  env.typed_local_bindings.clear()
  env.typed_ident_resolutions.clear()
  env.param_binding_resolutions.clear()
  env.pattern_binding_resolutions.clear()
  env.typed_access_effects.clear()
  env.typed_exprs.clear()
  env.typed_stmts.clear()
  env.typed_patterns.clear()
  env.typed_aggregate_ownership.clear()
  env.closure_captures.clear()
  env.binding_plans.clear()
  env.pattern_variant_resolutions.clear()
  env.resolutions = Option::Some(resolutions.clone())
  # P1 (recovery separation): type_check_typed is the only entry that
  # produces a TypedProgram — the semantic authority MIR and codegen
  # consume. Compilation semantics here are therefore ALWAYS strict. Guard:
  # a real compilation running with strict_resolution = false is an internal
  # error; the flag is forced on unconditionally so the permissive
  # (editor-recovery) mode can never reach MIR/codegen — it is served only
  # by type_check / type_check_strict, which return errors alone and never
  # produce a codegenable TypedProgram.
  env.strict_resolution = true
  type_check_program_env(env, program)
  # P0-AL: after the whole program is checked, re-resolve the parked
  # generic-call instances (return-type-only parameters solved by the
  # caller's context) and record the now-solved substitutions — the
  # monomorphizer consumes them with zero inference.
  resolve_pending_call_instances(env)
  # P1 (recovery separation): post-check verification — the semantic pass
  # must guarantee that no Type::Error and no unresolved inference variable
  # survives in a codegenable TypedProgram. Each finding records a TypeError
  # so compilation aborts before MIR lowering.
  verify_codegen_readiness(env)
  var kinds = Map::new()
  var type_names = Map::new()
  var deinit_targets = Map::new()
  var type_fields = Map::new()
  var type_variants = Map::new()
  var type_params = Map::new()
  var type_aliases = Map::new()
  var ki = 0
  while ki < env.type_list.len() do
    let td = env.type_list[ki]
    kinds.insert(td.id.id, td.kind)
    type_names.insert(td.id.id, td.name.clone())
    type_params.insert(td.id.id, td.generic_params.clone())
    # Record the nominal shapes (struct fields / enum variants) so the
    # deinit-plan builder can walk them for viral containment.
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      var shape = Vec::new()
      for f in fields do
        shape.push((f.name.clone(), f.ty.clone()))
      end
      type_fields.insert(td.id.id, shape)
    when TypeDefKind::Enum(variants) then
      var vshape = Vec::new()
      for v in variants do
        vshape.push((v.name.clone(), v.fields.clone(), v.discriminant))
      end
      type_variants.insert(td.id.id, vshape)
    when TypeDefKind::Alias(inner) then
      # The resolved inner type (the checker's env walks it for the
      # ownership answers; the engine snapshot re-applies it — see
      # TypedProgram.type_aliases).
      type_aliases.insert(td.id.id, inner.clone())
    when _ then ()
    end
    ki = ki + 1
  end
  # P0-D: the finalizer registration's TYPE lookup uses the SAME
  # name -> TypeId inverse the MIR builds (both iterate the same type_names
  # map), so a duplicate bare name resolves to the same TypeId on both sides
  # of the seam (first-wins over env.type_list would diverge from the MIR's
  # map-inverse).
  var tid_by_name = Map::new()
  for (tn_tid, tn_name) in type_names do
    tid_by_name.insert(tn_name.clone(), tn_tid)
  end
  # Collect registered deinit methods (type -> the finalizer's SEMANTIC
  # CallableId) so the per-type DeinitPlan can reference them; a resource
  # WITHOUT a deinit is trivially deinitialized (no entry here is fine).
  # P0-D (final layer): the registration value is the RESOLVER's DefId
  # (resolutions.method_defs — keyed "Type::method") — the SAME identity
  # the MIR records for the mangled emission names ("Type__drop" /
  # "Type__deinit"). A finalizer the resolver never registered a DefId for
  # is a registration failure: a TypeError is recorded and the type gets NO
  # entry (its plans fail closed at the verified_* construction sites) —
  # a name-only finalizer can never become a plan callable.
  var dmi = 0
  while dmi < program.items.len() do
    let item = program.items[dmi]
    match item.kind
    when ItemKind::ItemImpl(imp) then
      var mj = 0
      while mj < imp.methods.len() do
        let m = imp.methods[mj]
        # The registered cleanup callables are the impl's Drop::drop methods
        # AND resources' own deinit methods. MIR lowers impl methods as
        # TypeName__method, so the Drop impls register as "Box__drop" etc.
        # A method named "drop" is a destructor ONLY inside the Drop trait
        # impl (spelling alone must not make an inherent method the
        # compiler's automatic destructor). "deinit" is the canonical
        # Tangerine finalizer everywhere.
        # P0-BT: the Drop impl identity is the LangItems TraitId — never
        # the name. The AST impl carries only the trait name; the
        # checker-side trait registry maps it to the SAME TraitId
        # build_lang_items captured for drop_trait.
        let is_drop_impl = match imp.trait_name
        when Option::Some(tn) then trait_id_for(env, &tn).id == env.lang_items.drop_trait
        when Option::None then false
        end
        if m.name == "deinit" || (m.name == "drop" && is_drop_impl) then
          # P0-D (registration-key fix): the method_defs lookup key is the
          # RESOLVER's rendering (impl_registry_method_key — "Box[...]::drop"
          # for a generic for_type, matching resolver.tg's type_expr_to_string
          # keys), never a bare-name key ("Box::drop" — which misses every
          # generic Drop impl). The TYPE lookup is the tid_by_name inverse
          # above (the same inverse the MIR builds).
          let type_key = type_expr_name_of(&imp.for_type)
          let method_key = impl_registry_method_key(&imp.for_type, &m.name)
          match tid_by_name.get(type_key)
          when Option::Some(reg_tid) then
            match resolutions.method_defs.get(method_key)
            when Option::Some(mdid) then
              deinit_targets.insert(reg_tid, CallableId { def: mdid.clone() })
            when Option::None then
              env.errors.push(TypeError {
                message: "internal error: finalizer `" + method_key + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                span: m.span,
                code: Option::None
              })
            end
          when Option::None then ()
          end
        end
        mj = mj + 1
      end
    when ItemKind::ItemStruct(s) then
      var mj2 = 0
      while mj2 < s.methods.len() do
        let m2 = s.methods[mj2]
        if m2.name == "deinit" then
          let method_key2 = s.name.clone() + "::" + m2.name.clone()
          match tid_by_name.get(s.name.clone())
          when Option::Some(reg_tid2) then
            match resolutions.method_defs.get(method_key2)
            when Option::Some(mdid2) then
              deinit_targets.insert(reg_tid2, CallableId { def: mdid2.clone() })
            when Option::None then
              env.errors.push(TypeError {
                message: "internal error: finalizer `" + method_key2 + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                span: m2.span,
                code: Option::None
              })
            end
          when Option::None then ()
          end
        end
        mj2 = mj2 + 1
      end
    when _ then ()
    end
    dmi = dmi + 1
  end
  # Build the recursive deinit plan for every type id (consumed by MIR).
  var deinit_plans = Map::new()
  var plan_typed = TypedProgram {
    ast: program.clone(),
    resolutions: resolutions.clone(),
    expr_types: env.typed_expr_types.clone(),
    call_targets: env.typed_call_targets.clone(),
    call_instances: env.typed_call_instances.clone(),
    field_targets: env.typed_field_targets.clone(),
    access_effects: env.typed_access_effects.clone(),
    typed_exprs: env.typed_exprs.clone(),
    closure_captures: env.closure_captures.clone(),
    local_bindings: env.typed_local_bindings.clone(),
    ident_resolutions: env.typed_ident_resolutions.clone(),
    param_binding_resolutions: env.param_binding_resolutions.clone(),
    pattern_binding_resolutions: env.pattern_binding_resolutions.clone(),
    deinit_plans: Map::new(),
    aggregate_ownership: Map::new(),
    finalize_plan: Map::new(),
    edge_cleanup: Map::new(),
    type_names: type_names.clone(),
    deinit_targets: deinit_targets.clone(),
    type_fields: type_fields.clone(),
    type_variants: type_variants.clone(),
    type_params: type_params.clone(),
    type_kinds: kinds.clone(),
    type_aliases: type_aliases.clone(),
    generic_param_ids: env.generic_param_ids.clone(),
    generic_param_names: env.generic_param_table.names.clone()
  }
  var pi = 0
  while pi < env.type_list.len() do
    let td = env.type_list[pi]
    let self_ty = Type::Adt(td.id, Vec::new())
    var plan_visited = Set::new()
    let plan = build_deinit_plan(&plan_typed, &self_ty, 0, &mut plan_visited, &mut env.errors)
    deinit_plans.insert(td.id.id, plan)
    pi = pi + 1
  end
  let typed = TypedProgram {
    ast: program.clone(),
    resolutions: resolutions.clone(),
    expr_types: env.typed_expr_types.clone(),
    call_targets: env.typed_call_targets.clone(),
    call_instances: env.typed_call_instances.clone(),
    field_targets: env.typed_field_targets.clone(),
    access_effects: env.typed_access_effects.clone(),
    typed_exprs: env.typed_exprs.clone(),
    closure_captures: env.closure_captures.clone(),
    local_bindings: env.typed_local_bindings.clone(),
    ident_resolutions: env.typed_ident_resolutions.clone(),
    param_binding_resolutions: env.param_binding_resolutions.clone(),
    pattern_binding_resolutions: env.pattern_binding_resolutions.clone(),
    deinit_plans: deinit_plans,
    aggregate_ownership: env.typed_aggregate_ownership.clone(),
    finalize_plan: Map::new(),
    edge_cleanup: Map::new(),
    type_names: type_names,
    deinit_targets: deinit_targets,
    type_fields: type_fields,
    type_variants: type_variants,
    type_params: type_params,
    type_kinds: kinds,
    type_aliases: type_aliases,
    generic_param_ids: env.generic_param_ids.clone(),
    generic_param_names: env.generic_param_table.names.clone()
  }
  env.resolutions = Option::None
  TypeCheckResult {
    errors: env.errors.clone(),
    program: typed
  }
end

# ———————————————————————————————————————————————————————————————
# Transferable (Send) / Shareable (Sync) classification (P0-BG)
# ———————————————————————————————————————————————————————————————

# SINGLE RULE (P1, DECIDED — auto traits, ONE authority): Transferable and
# Shareable are AUTO TRAITS whose STRUCTURAL DERIVATION IS the canonical
# solver rule. `T: Transferable` holds iff the structural derivation below
# proves it — T's fields/variants/contents are all Transferable — and the
# obligation-solver query inside the derivation is the impl-registry
# materialization of the SAME rule (the std's bounded impls encode exactly
# the structural derivation: primitives, containers, the GATED raw-pointer
# impls), NOT an independent authority. There is no "solver failed → second
# unrelated algorithm" fallback: the structural walk is the derivation
# itself, so the registry path and the direct path cannot disagree by
# construction. The old string-name exclusion sets (non_send_types /
# non_sync_types) are NO LONGER READ in the decision path — they remain as
# a documentation mirror only. Rc has no Transferable/Shareable impl (the
# std agent excluded it), so both materializations reject it; the interior
# mutability types have no Shareable impl. A type is rejected only when it
# is provably non-transferable; undecidable leaves fail OPEN (true).
#
# Raw pointers (P1, DECIDED): Ptr[T] / PtrMut[T] are Transferable /
# Shareable ONLY when the pointee T explicitly implements the opt-in gate
# marker (std::core UnsafeTransferable / UnsafeShareable) — pointer
# thread-safety is never inferred from T: Transferable (bit-copyability
# says nothing about whether the address stays meaningful and race-safe on
# another thread). The gate query below and the std's gated bounded impls
# are the same rule.
def is_send(env: &mut TypeEnv, ty: &Type) -> Bool
  var visited = Set::new()
  derive_transferable(env, ty, &mut visited)
end

# The single Transferable derivation (auto-trait rule): first the
# obligation solver proves the trait from the impl registry (the
# registry-backed materialization of the SAME structural rule — primitives,
# containers, gated pointers); for types the registry cannot decide, the
# derivation continues structurally over the type's shape. The visited set
# makes recursion through legal indirections (Box/Rc/pointers) terminate; a
# revisit cannot prove non-transferability, so it fails open. There is NO
# depth-based semantic shortcut: a deep-but-finite chain is walked to its
# concrete leaves (a depth limit would be a diagnostic, never a semantic
# answer).
def derive_transferable(env: &mut TypeEnv, ty: &Type, visited: &mut Set[Int]) -> Bool
  # P0-BT: the Transferable trait identity is its TraitId (the std declares
  # the trait; TraitId(-1) when it has not registered, which solves nothing
  # and continues the structural derivation — same as a name match failing).
  let transferable_name = "Transferable"
  let ob = Obligation { trait_ref: TraitRef { trait_id: trait_id_for(env, &transferable_name), self_ty: ty.clone(), args: Vec::new() }, trait_name: transferable_name }
  if solve_obligation(env, &ob) then
    return true
  end
  # The structural derivation — THE rule (see the section header).
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Adt(tid, args) then
    is_named_transferable(env, tid, args, visited)
  when Type::RefInternal(inner, _) then
    derive_transferable(env, inner, visited)
  when Type::Tuple(elems) then
    for e in elems do
      if !derive_transferable(env, &e, visited) then return false end
    end
    true
  when Type::Function(_, _) then true  # Function pointers are Transferable
  when Type::Ptr(inner) then pointer_gate_holds(env, &inner, "UnsafeTransferable")  # GATED: never inferred from T: Transferable
  when Type::PtrMut(inner) then pointer_gate_holds(env, &inner, "UnsafeTransferable")  # GATED: never inferred from T: Transferable
  when Type::Dyn(_) then false  # Trait objects: conservative !Transferable
  when Type::Effect(_, inner) then derive_transferable(env, &inner, visited)
  when Type::Param(_) then true  # Assume generic params are Transferable (checked at instantiation)
  when Type::Var(_) then true  # Type variables: assume Transferable
  when Type::Never then true
  when Type::Error then true
  end
end

# P1 (raw-pointer thread-safety gate): Ptr[T] / PtrMut[T] are
# Transferable / Shareable only when the POINTEE explicitly implements the
# opt-in marker trait (`impl UnsafeTransferable for T` /
# `impl UnsafeShareable for T` in std::core). The gate is a solver query on
# the marker trait — the same rule the std's gated bounded impls
# materialize — and never consults T's own Transferable/Shareable
# derivation.
def pointer_gate_holds(env: &mut TypeEnv, pointee: &Type, gate_trait: String) -> Bool
  let ob = Obligation { trait_ref: TraitRef { trait_id: trait_id_for(env, &gate_trait), self_ty: pointee.clone(), args: Vec::new() }, trait_name: gate_trait.clone() }
  solve_obligation(env, &ob)
end

# Named-type structural derivation (Transferable): walk fields/variants with
# the concrete generic args substituted (the same walk the type-properties
# engine performs for needs_drop/linearity) plus the concrete args. Rc is
# the only provable inherent exclusion (mirror of the non_send_types
# documentation set).
def is_named_transferable(env: &mut TypeEnv, tid: &TypeId, args: &Vec[Type], visited: &mut Set[Int]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    # P0-BT: the Rc exclusion is the LangItems TypeId — never the name.
    if tid.id == env.lang_items.rc then
      return false
    end
    if visited.contains(&tid.id) then
      return true
    end
    visited.insert(tid.id)
    var ok = true
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      for field in fields do
        let f_ty = subst_type_args(&field.ty, &td.generic_params, args)
        if !derive_transferable(env, &f_ty, visited) then ok = false end
      end
    when TypeDefKind::Enum(variants) then
      for variant in variants do
        for f in variant.fields do
          let v_ty = subst_type_args(&f, &td.generic_params, args)
          if !derive_transferable(env, &v_ty, visited) then ok = false end
        end
      end
    when _ then ()
    end
    for arg in args do
      if !derive_transferable(env, &arg, visited) then ok = false end
    end
    visited.remove(&tid.id)
    ok
  when Option::None then true
  end
end

# A type is Shareable (Sync — safe to share references across threads) iff
# the SINGLE auto-trait rule (see the section header above) derives it: the
# obligation solver proves `Shareable for T` from the impl registry (the
# registry-backed materialization of the same structural rule; interior
# mutability types Cell/RefCell/UnsafeCell and Rc are deliberately granted
# NO impl by the std agent, so both materializations reject them), and the
# structural derivation continues for types the registry cannot decide.
def is_sync(env: &mut TypeEnv, ty: &Type) -> Bool
  var visited = Set::new()
  derive_syncable(env, ty, &mut visited)
end

# The single Shareable derivation (auto-trait rule) — see derive_transferable
# for the rule structure. The visited set terminates legal-indirection
# recursion; there is NO depth-based semantic shortcut (a depth limit would
# be a diagnostic, never a semantic answer).
def derive_syncable(env: &mut TypeEnv, ty: &Type, visited: &mut Set[Int]) -> Bool
  # P0-BT: the Shareable trait identity is its TraitId (std-declared; see
  # derive_transferable for the TraitId(-1) fall-through semantics).
  let shareable_name = "Shareable"
  let ob = Obligation { trait_ref: TraitRef { trait_id: trait_id_for(env, &shareable_name), self_ty: ty.clone(), args: Vec::new() }, trait_name: shareable_name }
  if solve_obligation(env, &ob) then
    return true
  end
  # The structural derivation — THE rule (see the section header).
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Adt(tid, args) then
    is_named_syncable(env, tid, args, visited)
  when Type::RefInternal(inner, _) then derive_syncable(env, inner, visited)
  when Type::Tuple(elems) then
    for e in elems do
      if !derive_syncable(env, &e, visited) then return false end
    end
    true
  when Type::Function(_, _) then true
  when Type::Ptr(inner) then pointer_gate_holds(env, &inner, "UnsafeShareable")  # GATED: never automatic
  when Type::PtrMut(inner) then pointer_gate_holds(env, &inner, "UnsafeShareable")  # GATED: never automatic
  when Type::Dyn(_) then false  # Trait objects: conservative !Shareable
  when Type::Effect(_, inner) then derive_syncable(env, &inner, visited)
  when Type::Param(_) then true
  when Type::Var(_) then true
  when Type::Never then true
  when Type::Error then true
  end
end

# Named-type structural derivation (Shareable): fields/variants/args walk
# (as above). Provable inherent exclusions — Rc (LangItems TypeId) and the
# interior mutability types (Cell/RefCell/UnsafeCell, name-selected — no
# LangItems entries) — mirror the non_sync_types documentation set; the
# std grants none of them a Shareable impl.
def is_named_syncable(env: &mut TypeEnv, tid: &TypeId, args: &Vec[Type], visited: &mut Set[Int]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    if tid.id == env.lang_items.rc || td.name == "Cell" || td.name == "RefCell" || td.name == "UnsafeCell" then
      return false
    end
    if visited.contains(&tid.id) then
      return true
    end
    visited.insert(tid.id)
    var ok = true
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      for field in fields do
        let f_ty = subst_type_args(&field.ty, &td.generic_params, args)
        if !derive_syncable(env, &f_ty, visited) then ok = false end
      end
    when TypeDefKind::Enum(variants) then
      for variant in variants do
        for f in variant.fields do
          let v_ty = subst_type_args(&f, &td.generic_params, args)
          if !derive_syncable(env, &v_ty, visited) then ok = false end
        end
      end
    when _ then ()
    end
    for arg in args do
      if !derive_syncable(env, &arg, visited) then ok = false end
    end
    visited.remove(&tid.id)
    ok
  when Option::None then true
  end
end

# Check that a type satisfies Send bound at a usage site (e.g., thread::spawn)
def check_send_bound(env: &mut TypeEnv, ty: &Type, span: Span, context: String) -> Unit
  if !is_send(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(env, ty) + "` does not satisfy `Send` bound — " +
               "cannot be safely transferred across thread boundaries",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

# Check that a type satisfies Sync bound (e.g., shared references across threads)
def check_sync_bound(env: &mut TypeEnv, ty: &Type, span: Span, context: String) -> Unit
  if !is_sync(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(env, ty) + "` does not satisfy `Sync` bound — " +
               "cannot be safely shared across thread boundaries",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

def type_display(env: &TypeEnv, ty: &Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::I8 then "i8"
  when Type::I16 then "i16"
  when Type::I32 then "i32"
  when Type::I64 then "i64"
  when Type::I128 then "i128"
  when Type::U8 then "u8"
  when Type::U16 then "u16"
  when Type::U32 then "u32"
  when Type::U64 then "u64"
  when Type::U128 then "u128"
  when Type::ISize then "isize"
  when Type::USize then "usize"
  when Type::F32 then "f32"
  when Type::F64 then "f64"
  when Type::Never then "Never"
  when Type::Adt(tid, args) then
    # The Adt form of a builtin compound displays as its builtin name (the
    # LangItems TypeId selects the identity); user-defined Adt types display
    # the id.
    var s = "Type#" + tid.id.to_string()
    if !args.is_empty() then
      s = s + "["
      var first = true
      for a in args do
        if !first then s = s + ", " end
        s = s + type_display(env, a)
        first = false
      end
      s = s + "]"
    end
    if tid.id == env.lang_items.option && args.len() >= 1 then "Option[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.result && args.len() >= 2 then "Result[" + type_display(env, &args[0]) + ", " + type_display(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.map && args.len() >= 2 then "Map[" + type_display(env, &args[0]) + ", " + type_display(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.set && args.len() >= 1 then "Set[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.slice && args.len() >= 1 then "[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.array && args.len() >= 1 then
      # The heap-vector Adt form carries no count (the size lives in the
      # distinct FixedArray variant); display as the element container.
      "[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.box_ && args.len() >= 1 then "Box[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.rc && args.len() >= 1 then "Rc[" + type_display(env, &args[0]) + "]"
    else s
    end
  when Type::FixedArray(elem, n) then "[" + type_display(env, &elem) + "; " + n.to_string() + "]"
  when Type::Ptr(inner) then "Ptr[" + type_display(env, inner) + "]"
  when Type::PtrMut(inner) then "PtrMut[" + type_display(env, inner) + "]"
  when Type::Dyn(did) then "dyn Type#" + did.id.to_string()
  when Type::Effect(effs, inner) then "Effect[" + effs.join(", ") + "] " + type_display(env, inner)
  when Type::Function(params, ret) then
    var s = "("
    var first = true
    for p in params do
      if !first then s = s + ", " end
      s = s + type_display(env, &p.ty)
      first = false
    end
    s = s + ") -> " + type_display(env, ret)
    s
  when Type::RefInternal(inner, mutable) then
    if mutable then "&mut " + type_display(env, inner) else "&" + type_display(env, inner) end
  when Type::Tuple(elems) then
    var s = "("
    var first = true
    for e in elems do
      if !first then s = s + ", " end
      s = s + type_display(env, e)
      first = false
    end
    s + ")"
  when Type::Var(vid) then "?T" + vid.id.to_string()
  when Type::Param(gpid) then generic_param_name_of(&env.generic_param_table, &gpid)
  when Type::Error then "<error>"
  end
end
